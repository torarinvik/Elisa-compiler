extend Semantic:
    private:
        # Stage1 semantic layer — name resolution (internal helpers, module-private).
        #
        # Walks each function body's VALUE expressions and resolves every identifier reference
        # against the names in scope: the function's parameters, its local bindings (var-decls,
        # for-loop variables, match-arm pattern bindings, `is` refinements, comprehension
        # variables, prefix-clause bindings), and the file's global symbol table. References
        # that resolve to none of these are counted as unresolved. Type-position expressions
        # (param/return/var-decl annotations) are deliberately NOT walked, so built-in type
        # names don't register as unresolved.


        # A name is in scope if it is a parameter/local (bound) or a global declaration. The
        # global half is an O(1) index probe (`name_indexed`) rather than a scan of every
        # symbol; `bound` (a function's locals) stays a linear scan since it is small.
        def name_known(table: SymbolTable&, bound: darray[sview]&, name: sview) -> bool:
            can Abort.Panic:
                return (any b in bound where b == name) or name_indexed(table, name)


        # Collect the names a match-arm pattern binds: a bare `Binding`, the binder of a
        # category arm (`Type s`), and any binding subpatterns nested inside variant,
        # struct, tuple, or or-pattern fields. Wildcards/literals/paths bind nothing.
        def gather_pattern(p: Ast::Pattern, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match p:
                    Pattern.Binding(name):
                        bound.push(name)
                    Pattern.TypeBind(type, binder):
                        bound.push(binder)
                    Pattern.Variant(path, fields):
                        for f in fields:
                            gather_pattern(f, bound)
                    Pattern.Struct(path, fields):
                        for f in fields:
                            gather_pattern(f, bound)
                    Pattern.Tuple(elems):
                        for e in elems:
                            gather_pattern(e, bound)
                    Pattern.Or(options):
                        for o in options:
                            gather_pattern(o, bound)
                    _:
                        pass


        # A refinement test `EXPR is TARGET` introduces bindings on its right side: a bare
        # name (`x is mod`) binds that name; a variant form (`x is Variant(a, b)`) binds each
        # field name. A qualified constant test (`x is Enum.Const`) binds nothing.
        def gather_is_target(e: Ast::Expr, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match e:
                    Expr.Ident(name, line):
                        bound.push(name)
                    Expr.Call(func, args, arg_names, line):
                        for a in args:
                            gather_is_target(a, bound)
                    _:
                        pass


        # Walk an expression collecting the bindings introduced by any `is` refinement test or
        # comprehension inside it, so later uses of those names resolve. (`as` casts bind nothing.)
        def gather_expr_bindings(e: Ast::Expr, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match e:
                    Expr.Binary(left, op, right, line):
                        gather_expr_bindings(left, bound)
                        if op == TokenKind.Is:
                            gather_is_target(right, bound)
                        else:
                            gather_expr_bindings(right, bound)
                    Expr.Call(func, args, arg_names, line):
                        gather_expr_bindings(func, bound)
                        for a in args:
                            gather_expr_bindings(a, bound)
                    Expr.Field(obj, field, line):
                        gather_expr_bindings(obj, bound)
                    Expr.Scope(base, name, line):
                        gather_expr_bindings(base, bound)
                    Expr.Index(obj, index, line):
                        gather_expr_bindings(obj, bound)
                        gather_expr_bindings(index, bound)
                    Expr.Unary(op, operand, line):
                        gather_expr_bindings(operand, bound)
                    Expr.Paren(inner, line):
                        gather_expr_bindings(inner, bound)
                    Expr.Array(elements, line):
                        for el in elements:
                            gather_expr_bindings(el, bound)
                    Expr.Tuple(elems, line):
                        for el in elems:
                            gather_expr_bindings(el, bound)
                    Expr.Slice(obj, lo, hi, line):
                        gather_expr_bindings(obj, bound)
                        gather_expr_bindings(lo, bound)
                        gather_expr_bindings(hi, bound)
                    Expr.IndexN(obj, args, line):
                        gather_expr_bindings(obj, bound)
                        for a in args:
                            gather_expr_bindings(a, bound)
                    Expr.SetLit(elements, line):
                        for el in elements:
                            gather_expr_bindings(el, bound)
                    Expr.DictLit(entries, line):
                        for entry in entries:
                            gather_expr_bindings(entry.key, bound)
                            gather_expr_bindings(entry.value, bound)
                    Expr.Construct(type, fields, line):
                        for f in fields:
                            gather_expr_bindings(f.value, bound)
                    Expr.RecordUpdate(base, fields, line):
                        gather_expr_bindings(base, bound)
                        for f in fields:
                            gather_expr_bindings(f.value, bound)
                    Expr.If(cond, then_expr, else_expr, line):
                        gather_expr_bindings(cond, bound)
                        gather_expr_bindings(then_expr, bound)
                        gather_expr_bindings(else_expr, bound)
                    Expr.Comprehension(var, iter, cond, body, line):
                        bound.push(var)
                        gather_expr_bindings(iter, bound)
                        gather_expr_bindings(cond, bound)
                        gather_expr_bindings(body, bound)
                    Expr.Lambda(params, body, line):
                        # The lambda's params scope its body; add them to `bound` plus
                        # any locals the body introduces (mirrors Comprehension's var —
                        # over-permissive to the outer scope, but never a false unresolved).
                        for p in params:
                            bound.push(p)
                        gather_locals(body, bound)
                    Expr.Match(scrutinee, arms, line):
                        # Match in expression position introduces its arms' pattern bindings
                        # and any bindings inside arm bodies (mirrors Stmt.Match in gather_locals).
                        gather_expr_bindings(scrutinee, bound)
                        for arm in arms:
                            gather_pattern(arm.pattern, bound)
                            gather_locals(arm.body, bound)
                    # Leaves and references bind nothing. Listed explicitly (no wildcard) so a
                    # new Expr variant is a compile error rather than a silently-missed binding.
                    Expr.Invalid:
                        pass
                    Expr.IntLit(value):
                        pass
                    Expr.FloatLit(text):
                        pass
                    Expr.StringLit(text):
                        pass
                    Expr.CharLit(text):
                        pass
                    Expr.BoolLit(value):
                        pass
                    Expr.Ident(name, line):
                        pass
                    Expr.ShorthandMember(parts, line):
                        pass


        # Gather the names a function binds: var-decl names, for-loop variables, match-arm
        # pattern bindings, `is`/comprehension bindings, and prefix-clause bindings across the
        # body (block scoping is flattened — a first pass accepts forward references).
        def gather_locals(stmts: darray[Ast::Stmt], bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for stmt in stmts:
                    match stmt:
                        Stmt.Expr(expr, line):
                            gather_expr_bindings(expr, bound)
                        Stmt.VarDecl(name, type_expr, value, line):
                            bound.push(name)
                            gather_expr_bindings(value, bound)
                        Stmt.Assign(target, op, value, line):
                            # Multi-target unpack `a, b = …` (target is an Array literal)
                            # introduces its bare-ident targets as new locals; a single
                            # bare-ident `x = …` DEFINES a local too (incl. the `_`
                            # discard). `<-` targets are already-declared names, so
                            # registering them again is harmless.
                            if target is Expr.Array(elements, aline):
                                for el in elements:
                                    if el is Expr.Ident(nm, iline):
                                        bound.push(nm)
                            if target is Expr.Ident(single_nm, sline):
                                bound.push(single_nm)
                            gather_expr_bindings(target, bound)
                            gather_expr_bindings(value, bound)
                        Stmt.For(bind, vars, iter, body, line):
                            bound.extend(vars)
                            gather_expr_bindings(iter, bound)
                            gather_locals(body, bound)
                        Stmt.If(cond, then_body, else_body, line):
                            gather_expr_bindings(cond, bound)
                            gather_locals(then_body, bound)
                            gather_locals(else_body, bound)
                        Stmt.While(cond, body, line):
                            gather_expr_bindings(cond, bound)
                            gather_locals(body, bound)
                        Stmt.Return(value, line):
                            if value is v:
                                gather_expr_bindings(v, bound)
                        Stmt.Block(kind, clause, binding, body, line):
                            if binding != "":
                                bound.push(binding)
                            gather_locals(body, bound)
                        Stmt.Match(scrutinee, arms, line):
                            gather_expr_bindings(scrutinee, bound)
                            for arm in arms:
                                gather_pattern(arm.pattern, bound)
                                gather_locals(arm.body, bound)
                        Stmt.Contract(kind, expr, line):
                            # An `ensure` predicate may reference the function's `result`.
                            if kind == "ensure" or kind == "ensures":
                                bound.push("result")
                            gather_expr_bindings(expr, bound)
                        # These introduce no bindings. Explicit (no wildcard) so a new Stmt
                        # variant forces a decision here.
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Check a direct call `name(args...)` against the declared arity of `name`'s
        # Func symbol(s). Conservative by design -- flags ONLY when the callee name is
        # known, every symbol with that name is a Func, and the argument count fits
        # none of their [required, total] ranges. Any shadowing local, non-Func symbol
        # (extern/const/struct/builtin), labeled argument, or unknown name skips the
        # check, so an unmodeled call shape can never produce a false positive.
        def check_call_arity(table: mutable SymbolTable&, fname: sview, argc: usize, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                found_func: mutable bool = false
                fits: mutable bool = false
                for s in table.symbols:
                    if s.name == fname:
                        if s.kind == SymbolKind.Func:
                            found_func <- true
                            if argc.u32() >= s.arity_min and argc.u32() <= s.arity_max:
                                fits <- true
                        else:
                            # A non-Func symbol shares the name (constructor, extern,
                            # builtin, ...) -- callable shapes we don't model; skip.
                            fits <- true
                if found_func and not fits:
                    table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: fname, line: line})


        # Resolve every identifier in a value expression, recursing into children. Field names
        # (`obj.field`) are member selectors, not references, so only the object is walked.
        def walk_expr(e: Ast::Expr, table: mutable SymbolTable&, bound: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match e:
                    Expr.Ident(name, line):
                        if not name_known(table, bound, name):
                            table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UndefinedName, name: name, line: line})
                    Expr.Call(func, args, arg_names, line):
                        # `arg_names` are field/parameter labels (selectors), not value
                        # references — walk only the argument values.
                        walk_expr(func, table, bound)
                        for arg in args:
                            walk_expr(arg, table, bound)
                        # Arity check for a direct unshadowed call: `f(a, b)` with a bare
                        # callee name that is not a local/param. UFCS (`recv.f(a)`),
                        # qualified (`Mod::f(...)`), specialized (`f[T](...)`), and
                        # labeled-argument calls are skipped (shapes not modeled).
                        if func is Expr.Ident(fname, fline):
                            labeled: bool = any n in arg_names where n != ""
                            shadowed: bool = any b in bound where b == fname
                            if not labeled and not shadowed:
                                check_call_arity(table, fname, args.count, line)
                        # Enum-constructor arity: `Enum.Variant(v1, …)` must supply
                        # exactly the declared payload count (labels allowed — the
                        # count is positional either way).
                        if func is Expr.Field(cobj, cfield, cline):
                            if cobj is Expr.Ident(cename, celine):
                                cshadowed: bool = any b in bound where b == cename
                                if not cshadowed and is_enum_name(table, cename):
                                    cvi: int = enum_variant_index(table, cename, cfield)
                                    if cvi >= 0 and args.count.u32() != table.enum_variant_arity[cvi.usize()]:
                                        table.diagnostics.push(Diagnostic{kind: DiagnosticKind.VariantArity, name: cfield, line: line})
                    Expr.Field(obj, field, line):
                        walk_expr(obj, table, bound)
                        # `Enum.Variant` in value position: when the object is a bare
                        # unshadowed enum-type name, the member must be a variant.
                        if obj is Expr.Ident(ename, eline):
                            shadowed: bool = any b in bound where b == ename
                            if not shadowed and is_enum_name(table, ename):
                                if not enum_has_variant(table, ename, field):
                                    table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownVariant, name: field, line: line})
                    Expr.Scope(base, name, line):
                        # `base::name` is a namespace/type path; the leading name is
                        # resolved like any reference, `::name` is a selector.
                        walk_expr(base, table, bound)
                    Expr.Index(obj, index, line):
                        walk_expr(obj, table, bound)
                        walk_expr(index, table, bound)
                    Expr.Binary(left, op, right, line):
                        walk_expr(left, table, bound)
                        # The right operand of `is` (a refinement target/binding) and `as`
                        # (a type) is not a value reference, so it isn't resolved here.
                        if op != TokenKind.Is and op != TokenKind.As:
                            walk_expr(right, table, bound)
                    Expr.Unary(op, operand, line):
                        walk_expr(operand, table, bound)
                    Expr.Paren(inner, line):
                        walk_expr(inner, table, bound)
                    Expr.Array(elements, line):
                        for el in elements:
                            walk_expr(el, table, bound)
                    Expr.Tuple(elems, line):
                        for el in elems:
                            walk_expr(el, table, bound)
                    Expr.Slice(obj, lo, hi, line):
                        walk_expr(obj, table, bound)
                        walk_expr(lo, table, bound)
                        walk_expr(hi, table, bound)
                    Expr.IndexN(obj, args, line):
                        walk_expr(obj, table, bound)
                        for a in args:
                            walk_expr(a, table, bound)
                    Expr.SetLit(elements, line):
                        for el in elements:
                            walk_expr(el, table, bound)
                    Expr.DictLit(entries, line):
                        for entry in entries:
                            walk_expr(entry.key, table, bound)
                            walk_expr(entry.value, table, bound)
                    Expr.Construct(type, fields, line):
                        # The type is the constructor (resolves as a type/global); each
                        # field's value is a reference, but the field label is not.
                        walk_expr(type, table, bound)
                        for f in fields:
                            walk_expr(f.value, table, bound)
                    Expr.RecordUpdate(base, fields, line):
                        # `base` is a value reference; each override value is a reference,
                        # the field label is a selector.
                        walk_expr(base, table, bound)
                        for f in fields:
                            walk_expr(f.value, table, bound)
                    Expr.If(cond, then_expr, else_expr, line):
                        walk_expr(cond, table, bound)
                        walk_expr(then_expr, table, bound)
                        walk_expr(else_expr, table, bound)
                    Expr.Comprehension(var, iter, cond, body, line):
                        # The iterable is resolved in the OUTER scope (the loop variable
                        # is not visible there); cond/body see `var` via an extended copy.
                        walk_expr(iter, table, bound)
                        comp_scope: mutable darray[sview] = []
                        for b in bound:
                            comp_scope.push(b)
                        comp_scope.push(var)
                        walk_expr(cond, table, comp_scope)
                        walk_expr(body, table, comp_scope)
                    Expr.Lambda(params, body, line):
                        # The lambda's params + its body's own locals scope the body
                        # (flattened INSIDE the lambda — bodies are small).
                        lam_scope: mutable darray[sview] = []
                        for b in bound:
                            lam_scope.push(b)
                        for lp in params:
                            lam_scope.push(lp)
                        gather_locals(body, lam_scope)
                        walk_stmts(body, table, lam_scope)
                    Expr.Match(scrutinee, arms, line):
                        # Match in expression position: each arm's pattern bindings (and
                        # the arm body's own locals, flattened) scope that arm only.
                        walk_expr(scrutinee, table, bound)
                        for arm in arms:
                            check_pattern_variants(arm.pattern, table, line)
                            arm_scope: mutable darray[sview] = []
                            for b in bound:
                                arm_scope.push(b)
                            gather_pattern(arm.pattern, arm_scope)
                            gather_locals(arm.body, arm_scope)
                            walk_stmts(arm.body, table, arm_scope)
                    # Literal/invalid leaves reference nothing. Listed explicitly (no
                    # wildcard) so a new Expr variant is a compile error here, not a silent
                    # resolution gap.
                    Expr.Invalid:
                        pass
                    Expr.IntLit(value):
                        pass
                    Expr.FloatLit(text):
                        pass
                    Expr.StringLit(text):
                        pass
                    Expr.CharLit(text):
                        pass
                    Expr.BoolLit(value):
                        pass
                    Expr.ShorthandMember(parts, line):
                        # `.Variant` parts are enum selectors inferred from context, not
                        # value references — nothing to resolve.
                        pass


        # ORDERED, SCOPED resolution over a function body: statements are walked in
        # source order, a binding becomes visible only AFTER the statement that
        # introduces it (its initializer resolves against the names before it —
        # stage0 errors on local use-before-declaration), and a nested block's
        # bindings vanish at the block's end (truncate back to the scope mark;
        # stage0 block scoping is real, see the DuplicateLocal probes). Refinement
        # bindings gathered from a condition scope the guarded body only. `result`
        # (from an `ensure` contract) persists for the whole function.
        def resolve_body(stmts: darray[Ast::Stmt], table: mutable SymbolTable&, bound: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for stmt in stmts:
                    match stmt:
                        Stmt.Expr(expr, line):
                            walk_expr(expr, table, bound)
                            # An `is` refinement in a bare expression statement (e.g.
                            # `assert x is n`) keeps its binding for later statements —
                            # over-permissive, never a false unresolved.
                            gather_expr_bindings(expr, bound)
                        Stmt.VarDecl(name, type_expr, value, line):
                            # The initializer resolves BEFORE the name binds (`x: T = x`
                            # is use-before-declaration, as in stage0).
                            walk_expr(value, table, bound)
                            gather_expr_bindings(value, bound)
                            bound.push(name)
                        Stmt.Assign(target, op, value, line):
                            walk_expr(value, table, bound)
                            gather_expr_bindings(value, bound)
                            if target is Expr.Array(elements, aline):
                                # Multi-target: `=` defines fresh idents; `<-`/compound
                                # targets are references that must already resolve.
                                for el in elements:
                                    if el is Expr.Ident(nm, iline):
                                        if op == TokenKind.Assign:
                                            bound.push(nm)
                                        else:
                                            walk_expr(el, table, bound)
                                    else:
                                        walk_expr(el, table, bound)
                            elif target is Expr.Ident(nm2, iline2):
                                if op == TokenKind.Assign:
                                    bound.push(nm2)
                                else:
                                    walk_expr(target, table, bound)
                            else:
                                walk_expr(target, table, bound)
                        Stmt.If(cond, then_body, else_body, line):
                            walk_expr(cond, table, bound)
                            mark: usize = bound.count
                            gather_expr_bindings(cond, bound)
                            resolve_body(then_body, table, bound)
                            bound.truncate(mark)
                            resolve_body(else_body, table, bound)
                            bound.truncate(mark)
                        Stmt.While(cond, body, line):
                            walk_expr(cond, table, bound)
                            wmark: usize = bound.count
                            gather_expr_bindings(cond, bound)
                            resolve_body(body, table, bound)
                            bound.truncate(wmark)
                        Stmt.For(bind, vars, iter, body, line):
                            walk_expr(iter, table, bound)
                            fmark: usize = bound.count
                            for v in vars:
                                bound.push(v)
                            resolve_body(body, table, bound)
                            bound.truncate(fmark)
                        Stmt.Block(kind, clause, binding, body, line):
                            # Prefix blocks are NOT value scopes: a `static if/elif/else`
                            # branch is compile-time INCLUSION (exactly one branch's
                            # locals continue into the surrounding scope — see
                            # arena.elisa's per-backend `r:` declarations), and
                            # `can`/`trusted`/… are effect-grant wrappers. Bindings flow
                            # through un-truncated.
                            if binding != "":
                                bound.push(binding)
                            resolve_body(body, table, bound)
                        Stmt.Match(scrutinee, arms, line):
                            walk_expr(scrutinee, table, bound)
                            for arm in arms:
                                check_pattern_variants(arm.pattern, table, line)
                                amark: usize = bound.count
                                gather_pattern(arm.pattern, bound)
                                resolve_body(arm.body, table, bound)
                                bound.truncate(amark)
                        Stmt.Return(value, line):
                            if value is v:
                                walk_expr(v, table, bound)
                        Stmt.Contract(kind, expr, line):
                            if kind == "ensure" or kind == "ensures":
                                bound.push("result")
                            walk_expr(expr, table, bound)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Resolve identifiers in the VALUE positions of each statement (type annotations are
        # skipped). Recurses nested blocks and match arms. FLATTENED variant — used for
        # lambda bodies and expression-position match arms (small, pre-gathered scopes);
        # function bodies use the ordered `resolve_body` above.
        def walk_stmts(stmts: darray[Ast::Stmt], table: mutable SymbolTable&, bound: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for stmt in stmts:
                    match stmt:
                        Stmt.Expr(expr, line):
                            walk_expr(expr, table, bound)
                        Stmt.VarDecl(name, type_expr, value, line):
                            walk_expr(value, table, bound)
                        Stmt.Assign(target, op, value, line):
                            walk_expr(target, table, bound)
                            walk_expr(value, table, bound)
                        Stmt.If(cond, then_body, else_body, line):
                            walk_expr(cond, table, bound)
                            walk_stmts(then_body, table, bound)
                            walk_stmts(else_body, table, bound)
                        Stmt.While(cond, body, line):
                            walk_expr(cond, table, bound)
                            walk_stmts(body, table, bound)
                        Stmt.For(bind, vars, iter, body, line):
                            walk_expr(iter, table, bound)
                            walk_stmts(body, table, bound)
                        Stmt.Return(value, line):
                            if value is v:
                                walk_expr(v, table, bound)
                        Stmt.Block(kind, clause, binding, body, line):
                            walk_stmts(body, table, bound)
                        Stmt.Match(scrutinee, arms, line):
                            walk_expr(scrutinee, table, bound)
                            for arm in arms:
                                walk_stmts(arm.body, table, bound)
                        Stmt.Contract(kind, expr, line):
                            walk_expr(expr, table, bound)
                        # No value references to resolve. Explicit (no wildcard) so a new Stmt
                        # variant forces a decision here.
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Resolve references in every function declaration in `decls` (recursing modules).
        # Whether a declared type spells mutability: the canonical `x: mutable T`/
        # `p: mutable T&` form parses as a leading Unary(Mutable, ...) on the type expr.
        def type_is_mutable(e: Ast::Expr) -> bool:
            can Abort.Panic:
                if e is Expr.Unary(op, operand, line):
                    return op == TokenKind.Mutable
                return false


        # Record a function-body binding's mutability. Params feed this with their own
        # flag; var-decls derive it from the declared type. Any OTHER binding form
        # (for-loop vars, pattern bindings, block bindings, multi-assign targets, ...)
        # goes to `skip` -- mutability of those isn't modeled yet, and a skipped name is
        # never flagged (no false positives from unmodeled forms).
        def note_binding(name: sview, is_mut: bool, immut: mutable darray[sview]&, mut_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if is_mut:
                    mut_names.push(name)
                else:
                    immut.push(name)


        # Gather binding mutability across a body (flattened, mirrors gather_locals).
        def gather_mutability(stmts: darray[Ast::Stmt], immut: mutable darray[sview]&, mut_names: mutable darray[sview]&, skip: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for stmt in stmts:
                    match stmt:
                        Stmt.VarDecl(name, type_expr, value, line):
                            note_binding(name, type_is_mutable(type_expr), immut, mut_names)
                        Stmt.Assign(target, op, value, line):
                            # Multi-target unpack introduces fresh locals -- unmodeled.
                            if target is Expr.Array(elements, aline):
                                for el in elements:
                                    if el is Expr.Ident(nm, iline):
                                        skip.push(nm)
                        Stmt.For(bind, vars, iter, body, line):
                            for v in vars:
                                skip.push(v)
                            gather_mutability(body, immut, mut_names, skip)
                        Stmt.If(cond, then_body, else_body, line):
                            gather_mutability(then_body, immut, mut_names, skip)
                            gather_mutability(else_body, immut, mut_names, skip)
                        Stmt.While(cond, body, line):
                            gather_mutability(body, immut, mut_names, skip)
                        Stmt.Block(kind, clause, binding, body, line):
                            if binding != "":
                                skip.push(binding)
                            gather_mutability(body, immut, mut_names, skip)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                gather_pattern(arm.pattern, skip)
                                gather_mutability(arm.body, immut, mut_names, skip)
                        Stmt.Expr(expr, line):
                            pass
                        Stmt.Return(value, line):
                            pass
                        Stmt.Contract(kind, expr, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Flag mutations (`<-` / compound assigns -- NOT `=`, which defines a new local)
        # whose bare-ident target is a binding known to be immutable. A name that is
        # skipped or ever declared mutable (e.g. a shadowing redeclaration) is not
        # flagged -- unmodeled forms must never produce a false positive.
        def check_assigns(stmts: darray[Ast::Stmt], table: mutable SymbolTable&, immut: darray[sview]&, mut_names: darray[sview]&, skip: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for stmt in stmts:
                    match stmt:
                        Stmt.Assign(target, op, value, line):
                            if op != TokenKind.Assign:
                                if target is Expr.Ident(name, iline):
                                    flagged: bool = (any i in immut where i == name) and not (any m in mut_names where m == name) and not (any s in skip where s == name)
                                    if flagged:
                                        table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AssignImmutable, name: name, line: line})
                        Stmt.If(cond, then_body, else_body, line):
                            check_assigns(then_body, table, immut, mut_names, skip)
                            check_assigns(else_body, table, immut, mut_names, skip)
                        Stmt.While(cond, body, line):
                            check_assigns(body, table, immut, mut_names, skip)
                        Stmt.For(bind, vars, iter, body, line):
                            check_assigns(body, table, immut, mut_names, skip)
                        Stmt.Block(kind, clause, binding, body, line):
                            check_assigns(body, table, immut, mut_names, skip)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                check_assigns(arm.body, table, immut, mut_names, skip)
                        Stmt.Expr(expr, line):
                            pass
                        Stmt.VarDecl(name, type_expr, value, line):
                            pass
                        Stmt.Return(value, line):
                            pass
                        Stmt.Contract(kind, expr, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Flag same-list local redefinitions: a repeated `x: T = v` declaration or an
        # `x = v` binding definition over an existing same-list local/param. Nested
        # blocks start a FRESH list -- shadowing an outer name there is legal (stage0
        # semantics), so only the current statement list's names are consulted.
        def check_dup_locals(stmts: darray[Ast::Stmt], here: mutable darray[sview]&, table: mutable SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for stmt in stmts:
                    match stmt:
                        Stmt.VarDecl(name, type_expr, value, line):
                            if any h in here where h == name:
                                table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateLocal, name: name, line: line})
                            else:
                                here.push(name)
                        Stmt.Assign(target, op, value, line):
                            # `=` DEFINES a local; a bare-ident `=` target over an
                            # existing same-list name is a redefinition. `<-`/compound
                            # mutate (checked elsewhere); multi-target arrays unmodeled.
                            # `_` is the discard sink — `_ = a` then `_ = b` in one list
                            # is idiomatic and never a redefinition.
                            if op == TokenKind.Assign:
                                if target is Expr.Ident(name, iline):
                                    if name != "_":
                                        if any h in here where h == name:
                                            table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateLocal, name: name, line: line})
                                        else:
                                            here.push(name)
                        Stmt.If(cond, then_body, else_body, line):
                            then_scope: mutable darray[sview] = []
                            check_dup_locals(then_body, then_scope, table)
                            else_scope: mutable darray[sview] = []
                            check_dup_locals(else_body, else_scope, table)
                        Stmt.While(cond, body, line):
                            while_scope: mutable darray[sview] = []
                            check_dup_locals(body, while_scope, table)
                        Stmt.For(bind, vars, iter, body, line):
                            for_scope: mutable darray[sview] = []
                            check_dup_locals(body, for_scope, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            block_scope: mutable darray[sview] = []
                            check_dup_locals(body, block_scope, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                arm_scope: mutable darray[sview] = []
                                check_dup_locals(arm.body, arm_scope, table)
                        Stmt.Expr(expr, line):
                            pass
                        Stmt.Return(value, line):
                            pass
                        Stmt.Contract(kind, expr, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Collect every value-position identifier REFERENCE in an expression into
        # `used` (the inverse of walk_expr's resolution: names, not diagnostics).
        # Selector positions (field names, labels, `::` members, `is` targets) are
        # not references and are skipped, mirroring walk_expr exactly.
        def collect_expr_uses(e: Ast::Expr, used: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match e:
                    Expr.Ident(name, line):
                        used.push(name)
                    Expr.Call(func, args, arg_names, line):
                        collect_expr_uses(func, used)
                        for a in args:
                            collect_expr_uses(a, used)
                    Expr.Field(obj, field, line):
                        collect_expr_uses(obj, used)
                    Expr.Scope(base, name, line):
                        collect_expr_uses(base, used)
                    Expr.Index(obj, index, line):
                        collect_expr_uses(obj, used)
                        collect_expr_uses(index, used)
                    Expr.Binary(left, op, right, line):
                        collect_expr_uses(left, used)
                        collect_expr_uses(right, used)
                    Expr.Unary(op, operand, line):
                        collect_expr_uses(operand, used)
                    Expr.Paren(inner, line):
                        collect_expr_uses(inner, used)
                    Expr.Array(elements, line):
                        for el in elements:
                            collect_expr_uses(el, used)
                    Expr.Tuple(elems, line):
                        for el in elems:
                            collect_expr_uses(el, used)
                    Expr.Slice(obj, lo, hi, line):
                        collect_expr_uses(obj, used)
                        collect_expr_uses(lo, used)
                        collect_expr_uses(hi, used)
                    Expr.IndexN(obj, args, line):
                        collect_expr_uses(obj, used)
                        for a in args:
                            collect_expr_uses(a, used)
                    Expr.SetLit(elements, line):
                        for el in elements:
                            collect_expr_uses(el, used)
                    Expr.DictLit(entries, line):
                        for entry in entries:
                            collect_expr_uses(entry.key, used)
                            collect_expr_uses(entry.value, used)
                    Expr.Construct(type, fields, line):
                        collect_expr_uses(type, used)
                        for f in fields:
                            collect_expr_uses(f.value, used)
                    Expr.RecordUpdate(base, fields, line):
                        collect_expr_uses(base, used)
                        for f in fields:
                            collect_expr_uses(f.value, used)
                    Expr.If(cond, then_expr, else_expr, line):
                        collect_expr_uses(cond, used)
                        collect_expr_uses(then_expr, used)
                        collect_expr_uses(else_expr, used)
                    Expr.Comprehension(var, iter, cond, body, line):
                        collect_expr_uses(iter, used)
                        collect_expr_uses(cond, used)
                        collect_expr_uses(body, used)
                    Expr.Lambda(params, body, line):
                        collect_stmt_uses(body, used)
                    Expr.Match(scrutinee, arms, line):
                        collect_expr_uses(scrutinee, used)
                        for arm in arms:
                            collect_stmt_uses(arm.body, used)
                    Expr.Invalid:
                        pass
                    Expr.IntLit(value):
                        pass
                    Expr.FloatLit(text):
                        pass
                    Expr.StringLit(text):
                        pass
                    Expr.CharLit(text):
                        pass
                    Expr.BoolLit(value):
                        pass
                    Expr.ShorthandMember(parts, line):
                        pass


        # Collect uses across statements (recursing every nested body). Assignment
        # TARGETS count as uses too — a write keeps a binding "used" for hint
        # purposes (write-only locals are a different, later analysis).
        def collect_stmt_uses(stmts: darray[Ast::Stmt], used: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for stmt in stmts:
                    match stmt:
                        Stmt.Expr(expr, line):
                            collect_expr_uses(expr, used)
                        Stmt.VarDecl(name, type_expr, value, line):
                            collect_expr_uses(value, used)
                        Stmt.Assign(target, op, value, line):
                            collect_expr_uses(target, used)
                            collect_expr_uses(value, used)
                        Stmt.If(cond, then_body, else_body, line):
                            collect_expr_uses(cond, used)
                            collect_stmt_uses(then_body, used)
                            collect_stmt_uses(else_body, used)
                        Stmt.While(cond, body, line):
                            collect_expr_uses(cond, used)
                            collect_stmt_uses(body, used)
                        Stmt.For(bind, vars, iter, body, line):
                            collect_expr_uses(iter, used)
                            collect_stmt_uses(body, used)
                        Stmt.Block(kind, clause, binding, body, line):
                            # Prefix-clause names (`in owner:`, `region r:`, `lock m as g:`)
                            # are region/mutex selectors — they USE the named binding.
                            for c in clause:
                                used.push(c)
                            collect_stmt_uses(body, used)
                        Stmt.Match(scrutinee, arms, line):
                            collect_expr_uses(scrutinee, used)
                            for arm in arms:
                                collect_stmt_uses(arm.body, used)
                        Stmt.Return(value, line):
                            if value is v:
                                collect_expr_uses(v, used)
                        Stmt.Contract(kind, expr, line):
                            collect_expr_uses(expr, used)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Discard-convention name: `_` or `_`-prefixed. Uses the seeded sview
        # builtins (NOT stdlib helpers) so the frontend stays self-resolving
        # without the standard library in scope.
        def is_discard_name(name: sview) -> bool:
            can Abort.Panic:
                return sview_len(name) > 0 and sview_at(name, 0) == '_'


        # Whether a parameter's declared type names `Arena` (through mutable/&/?
        # wrappers). Arena params are the region-threading ABI — load-bearing for
        # codegen even when never referenced in the body — so they are exempt
        # from unused-parameter hints.
        def type_mentions_arena(e: Ast::Expr) -> bool:
            can Abort.Panic:
                if e is Expr.Unary(op, operand, line):
                    return type_mentions_arena(operand)
                if e is Expr.Ident(name, iline):
                    return name == "Arena"
                return false


        # Flag never-referenced params and `x: T = v` locals (hints — stage0 is
        # silent here). `_` and `_`-prefixed names are the discard convention and
        # exempt, as are `Arena`-typed params (region ABI). Set-based: any use
        # anywhere in the body counts (shadowing conflates same-name bindings —
        # acceptable at hint severity).
        def check_unused(params: darray[Ast::ParamDecl], body: darray[Ast::Stmt], table: mutable SymbolTable&, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                used: mutable darray[sview] = []
                collect_stmt_uses(body, used)
                # Stub bodies (a single statement — `return`, `pass`, `= CONST`) are
                # interface/ABI placeholders; their params are intentionally unused.
                if body.count > 1:
                    for p in params:
                        if not is_discard_name(p.name) and not type_mentions_arena(p.type_expr):
                            if not (any u in used where u == p.name):
                                table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnusedParam, name: p.name, line: line})
                check_unused_locals(body, table, used)


        # Recurse the body flagging unused `x: T = v` locals at their own lines.
        def check_unused_locals(stmts: darray[Ast::Stmt], table: mutable SymbolTable&, used: darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for stmt in stmts:
                    match stmt:
                        Stmt.VarDecl(name, type_expr, value, line):
                            if not is_discard_name(name):
                                if not (any u in used where u == name):
                                    table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnusedLocal, name: name, line: line})
                        Stmt.If(cond, then_body, else_body, line):
                            check_unused_locals(then_body, table, used)
                            check_unused_locals(else_body, table, used)
                        Stmt.While(cond, body, line):
                            check_unused_locals(body, table, used)
                        Stmt.For(bind, vars, iter, body, line):
                            check_unused_locals(body, table, used)
                        Stmt.Block(kind, clause, binding, body, line):
                            check_unused_locals(body, table, used)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                check_unused_locals(arm.body, table, used)
                        Stmt.Expr(expr, line):
                            pass
                        Stmt.Assign(target, op, value, line):
                            pass
                        Stmt.Return(value, line):
                            pass
                        Stmt.Contract(kind, expr, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Whether a declared return type is void: absent (`def f():`) or the
        # literal `void` name. Anything else (incl. `T?`, tuples, refs) requires a
        # return value.
        def return_type_is_void(return_type: Ast::Expr?) -> bool:
            can Abort.Panic:
                if return_type is rt:
                    if rt is Expr.Ident(name, line):
                        return name == "void"
                    return false
                return true


        # Check every `return` against the declared return type: a value returned
        # from a void function, or a bare `return` where a value is required.
        # Recurses nested statement bodies but NOT expressions (a lambda's returns
        # belong to the lambda's own signature).
        def check_returns(stmts: darray[Ast::Stmt], is_void: bool, fname: sview, table: mutable SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for stmt in stmts:
                    match stmt:
                        Stmt.Return(value, line):
                            if value is v:
                                if is_void:
                                    table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ReturnValueInVoid, name: fname, line: line})
                            else:
                                if not is_void:
                                    table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MissingReturnValue, name: fname, line: line})
                        Stmt.If(cond, then_body, else_body, line):
                            check_returns(then_body, is_void, fname, table)
                            check_returns(else_body, is_void, fname, table)
                        Stmt.While(cond, body, line):
                            check_returns(body, is_void, fname, table)
                        Stmt.For(bind, vars, iter, body, line):
                            check_returns(body, is_void, fname, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            check_returns(body, is_void, fname, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                check_returns(arm.body, is_void, fname, table)
                        Stmt.Expr(expr, line):
                            pass
                        Stmt.VarDecl(name, type_expr, value, line):
                            pass
                        Stmt.Assign(target, op, value, line):
                            pass
                        Stmt.Contract(kind, expr, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Whether `name` is a declared enum type in the table.
        def is_enum_name(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                return any s in table.symbols where s.name == name and s.kind == SymbolKind.Enum


        # Registry index of `owner`'s variant `vname`, or -1 if not declared.
        def enum_variant_index(table: SymbolTable&, owner: sview, vname: sview) -> int:
            can Abort.Panic:
                i: mutable usize = 0
                while i < table.enum_variant_owner.count:
                    if table.enum_variant_owner[i] == owner and table.enum_variant_name[i] == vname:
                        return i.int()
                    i <- i + 1
                return -1


        # Whether enum `owner` declares variant `vname`.
        def enum_has_variant(table: SymbolTable&, owner: sview, vname: sview) -> bool:
            can Abort.Panic:
                return enum_variant_index(table, owner, vname) >= 0


        # Check a match-arm pattern's variant paths against the enum registry. A
        # Variant pattern's `path` is raw dotted text (`Color.Purple`); it is
        # matched against each known enum by prefix (enum name + `.`) with the
        # remainder compared to that enum's variants — no substring allocation.
        # Qualified (`Mod::Enum.V`) and non-enum-headed paths are skipped.
        def check_pattern_variants(pat: Ast::Pattern, table: mutable SymbolTable&, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                match pat:
                    Pattern.Variant(path, fields):
                        check_variant_path(path, fields.count, table, line)
                        for f in fields:
                            check_pattern_variants(f, table, line)
                    Pattern.Struct(spath, sfields):
                        for sf in sfields:
                            check_pattern_variants(sf, table, line)
                    Pattern.Tuple(elems):
                        for el in elems:
                            check_pattern_variants(el, table, line)
                    Pattern.Or(options):
                        for o in options:
                            check_pattern_variants(o, table, line)
                    Pattern.Wildcard:
                        pass
                    Pattern.Literal(text):
                        pass
                    Pattern.Binding(bname):
                        pass
                    Pattern.TypeBind(ttype, binder):
                        pass
                    Pattern.Other(text):
                        pass


        # Match `path` (raw `Enum.Variant` text) against the registry; flag when the
        # head names a declared enum but the tail is not one of its variants, or
        # when the pattern destructures a payload count differing from the
        # declaration. `argc` = supplied subpattern count; 0 means a bare tag-only
        # pattern (`Enum.Variant:`), which is legal for any arity and never flagged.
        def check_variant_path(path: sview, argc: usize, table: mutable SymbolTable&, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                plen: usize = sview_len(path)
                for sym in table.symbols:
                    if sym.kind == SymbolKind.Enum:
                        elen: usize = sview_len(sym.name)
                        if plen > elen + 1 and sview_at(path, elen) == '.':
                            prefix_ok: mutable bool = true
                            i: mutable usize = 0
                            while i < elen:
                                if sview_at(path, i) != sview_at(sym.name, i):
                                    prefix_ok <- false
                                    break
                                i <- i + 1
                            if prefix_ok:
                                # Compare the tail (after `Enum.`) to each variant.
                                tail_len: usize = plen - elen - 1
                                found: mutable bool = false
                                vi: mutable usize = 0
                                while vi < table.enum_variant_owner.count:
                                    if table.enum_variant_owner[vi] == sym.name:
                                        vname: sview = table.enum_variant_name[vi]
                                        if sview_len(vname) == tail_len:
                                            eq: mutable bool = true
                                            j: mutable usize = 0
                                            while j < tail_len:
                                                if sview_at(path, elen + 1 + j) != sview_at(vname, j):
                                                    eq <- false
                                                    break
                                                j <- j + 1
                                            if eq:
                                                found <- true
                                                if argc > 0 and argc.u32() != table.enum_variant_arity[vi]:
                                                    table.diagnostics.push(Diagnostic{kind: DiagnosticKind.VariantArity, name: path, line: line})
                                                break
                                    vi <- vi + 1
                                if not found:
                                    table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownVariant, name: path, line: line})
                                return


        # Primitive-name families for the literal-initializer check.
        def is_integer_type_name(n: sview) -> bool:
            can Abort.Panic:
                if n == "i8" or n == "i16" or n == "i32" or n == "i64" or n == "int" or n == "isize":
                    return true
                return n == "u8" or n == "u16" or n == "u32" or n == "u64" or n == "usize" or n == "uintptr"


        def is_float_type_name(n: sview) -> bool:
            can Abort.Panic:
                return n == "f32" or n == "f64"


        def is_string_type_name(n: sview) -> bool:
            can Abort.Panic:
                return n == "cstr" or n == "dstr" or n == "sview"


        # The declared head-type name when the annotation is a bare (possibly
        # `mutable`-wrapped) primitive name; "" otherwise (refs, optionals,
        # generics, user types — all skipped).
        def bare_type_name(e: Ast::Expr) -> sview:
            can Abort.Panic:
                if e is Expr.Unary(op, operand, uline):
                    if op == TokenKind.Mutable:
                        return bare_type_name(operand)
                    return ""
                if e is Expr.Ident(name, iline):
                    return name
                return ""


        # Whether a literal of `lit_kind` ("int"/"float"/"string"/"char"/"bool")
        # can NEVER initialize a variable of primitive type `tname` — the
        # oracle-verified impossible-pair matrix (see /tmp/m1,m2 probes; adaptive
        # pairs like int->char, char->int, int->float, float->int are LEGAL).
        def literal_never_fits(lit_kind: sview, tname: sview) -> bool:
            can Abort.Panic:
                if lit_kind == "string":
                    return is_integer_type_name(tname) or is_float_type_name(tname) or tname == "bool" or tname == "char"
                if lit_kind == "int":
                    return is_string_type_name(tname) or tname == "bool"
                if lit_kind == "bool":
                    return is_integer_type_name(tname) or is_float_type_name(tname) or is_string_type_name(tname) or tname == "char"
                if lit_kind == "char":
                    return tname == "cstr" or tname == "dstr"
                if lit_kind == "float":
                    return tname == "bool"
                return false


        # The literal kind of a direct literal expression ("" for anything else).
        def literal_kind_of(value: Ast::Expr) -> sview:
            can Abort.Panic:
                if value is Expr.IntLit(iv):
                    return "int"
                if value is Expr.FloatLit(ft):
                    return "float"
                if value is Expr.StringLit(st):
                    return "string"
                if value is Expr.CharLit(ct):
                    return "char"
                if value is Expr.BoolLit(bv):
                    return "bool"
                return ""


        # Record a binding's bare primitive type name ("" = unknown). A repeated
        # name with a DIFFERENT recorded type degrades to "" (shadowing across
        # blocks is conflated by this flat table — conservative, never flags).
        def note_local_type(names: mutable darray[sview]&, types: mutable darray[sview]&, name: sview, tname: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                i: mutable usize = 0
                while i < names.count:
                    if names[i] == name:
                        if types[i] != tname:
                            types[i] <- ""
                        return
                    i <- i + 1
                names.push(name)
                types.push(tname)


        # Recorded type of `name`, "" if unknown.
        def local_type_of(names: darray[sview]&, types: darray[sview]&, name: sview) -> sview:
            can Abort.Panic:
                i: mutable usize = 0
                while i < names.count:
                    if names[i] == name:
                        return types[i]
                    i <- i + 1
                return ""


        # Literal-vs-declared-type checks across a body: `x: PRIM = LITERAL`
        # declarations, `x <- LITERAL` mutations (via the flat local-type table),
        # and `return LITERAL` against the declared return type. Recurses nested
        # bodies; only the oracle-verified impossible pairs are flagged.
        def check_var_inits(stmts: darray[Ast::Stmt], ret_tname: sview, names: mutable darray[sview]&, types: mutable darray[sview]&, table: mutable SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for stmt in stmts:
                    match stmt:
                        Stmt.VarDecl(name, type_expr, value, line):
                            tname: sview = bare_type_name(type_expr)
                            note_local_type(names, types, name, tname)
                            if tname != "":
                                lit: sview = literal_kind_of(value)
                                if lit != "" and literal_never_fits(lit, tname):
                                    table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: name, line: line})
                        Stmt.Assign(target, op, value, line):
                            if target is Expr.Ident(aname, aline):
                                if op == TokenKind.Assign:
                                    # `x = v` defines a fresh, unannotated local.
                                    note_local_type(names, types, aname, "")
                                elif op == TokenKind.LArrow:
                                    atype: sview = local_type_of(names, types, aname)
                                    if atype != "":
                                        alit: sview = literal_kind_of(value)
                                        if alit != "" and literal_never_fits(alit, atype):
                                            table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: aname, line: line})
                        Stmt.Return(value, line):
                            if ret_tname != "":
                                if value is rv:
                                    rlit: sview = literal_kind_of(rv)
                                    if rlit != "" and literal_never_fits(rlit, ret_tname):
                                        table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: ret_tname, line: line})
                        Stmt.If(cond, then_body, else_body, line):
                            check_var_inits(then_body, ret_tname, names, types, table)
                            check_var_inits(else_body, ret_tname, names, types, table)
                        Stmt.While(cond, body, line):
                            check_var_inits(body, ret_tname, names, types, table)
                        Stmt.For(bind, vars, iter, body, line):
                            for v in vars:
                                note_local_type(names, types, v, "")
                            check_var_inits(body, ret_tname, names, types, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            if binding != "":
                                note_local_type(names, types, binding, "")
                            check_var_inits(body, ret_tname, names, types, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms:
                                check_var_inits(arm.body, ret_tname, names, types, table)
                        Stmt.Expr(expr, line):
                            pass
                        Stmt.Contract(kind, expr, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Signature + mutability checks for one function: duplicate parameter names,
        # then assignment-to-immutable over the body.
        def check_func(params: darray[Ast::ParamDecl], body: darray[Ast::Stmt], table: mutable SymbolTable&, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                seen: mutable darray[sview] = []
                for p in params:
                    if any s in seen where s == p.name:
                        table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateParam, name: p.name, line: line})
                    else:
                        seen.push(p.name)

                immut: mutable darray[sview] = []
                mut_names: mutable darray[sview] = []
                skip: mutable darray[sview] = []
                for p in params:
                    note_binding(p.name, p.is_mutable or type_is_mutable(p.type_expr), immut, mut_names)
                gather_mutability(body, immut, mut_names, skip)
                check_assigns(body, table, immut, mut_names, skip)

                fn_scope: mutable darray[sview] = []
                for p in params:
                    fn_scope.push(p.name)
                check_dup_locals(body, fn_scope, table)

                check_unused(params, body, table, line)


        # Resolve references in every function declaration in `decls` (recursing modules).
        def resolve_decls(decls: darray[Ast::Decl], table: mutable SymbolTable&) -> void:
            can Memory.Allocate, Abort.Panic:
                for decl in decls:
                    match decl:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Explicit push loop, not a comprehension: this list feeds
                            # growers (see the arena-assert stage0 bug, task_00a7fdf3).
                            bound: mutable darray[sview] = []
                            for p in params:
                                bound.push(p.name)
                            resolve_body(body, table, bound)
                            check_func(params, body, table, line)
                            check_returns(body, return_type_is_void(return_type), name, table)
                            lt_names: mutable darray[sview] = []
                            lt_types: mutable darray[sview] = []
                            for p2 in params:
                                lt_names.push(p2.name)
                                lt_types.push(bare_type_name(p2.type_expr))
                            ret_tname: mutable sview = ""
                            if return_type is rt2:
                                ret_tname <- bare_type_name(rt2)
                            if ret_tname == "void":
                                ret_tname <- ""
                            check_var_inits(body, ret_tname, lt_names, lt_types, table)
                        Decl.Module(name, body, line):
                            resolve_decls(body, table)
                        _:
                            pass
