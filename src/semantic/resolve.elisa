extend Semantic:
    private:
        # Signature + mutability checks for one function: duplicate parameter names,
        # then assignment-to-immutable over the body.
        def check_func(params: darray[Ast::ParamDecl], body: darray[Ast::Stmt], table: lmut SymbolTable, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                seen: mutable darray[sview] = []
                for p in params |table, seen| -> table:
                    if any s in seen where s == p.name:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateParam, name: p.name, line: line, expected: "", actual: ""})
                        table
                    else:
                        seen.push(p.name)
                        table

                immut: mutable darray[sview] = []
                mut_names: mutable darray[sview] = []
                skip: mutable darray[sview] = []
                for p in params |immut, mut_names|:
                    note_binding(p.name, p.is_mutable or type_is_mutable(p.type_expr), immut, mut_names)
                gather_mutability(body, immut, mut_names, skip)
                table <- check_assigns(body, table, immut, mut_names, skip)

                fn_scope: mutable darray[sview] = [p.name for p in params]
                table <- check_dup_locals(body, fn_scope, table)

                table <- check_unused(params, body, table, line)


        # Resolve references in every function declaration in `decls` (recursing modules).
        def resolve_decls(decls: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for decl in decls |table|:
                    match decl:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            bound: mutable darray[sview] = [p.name for p in params]
                            # Params occupy the first `params.count` entries of
                            # `bound`; log their declarations (on the `def` line)
                            # and mark the boundary for use-site classification.
                            table.current_param_count <- params.count
                            table.current_loop_depth <- 0
                            for p in params |table| -> table:
                                table <- record_ref(table, line, p.name, true)
                            table <- resolve_body(body, table, bound)
                            table <- check_func(params, body, table, line)
                            table <- check_returns(body, return_type_is_void(return_type), name, table)
                            table <- check_missing_return(body, return_type_is_void(return_type), name, table, line)
                            lt_names: mutable darray[sview] = []
                            lt_types: mutable darray[sview] = []
                            for p2 in params |lt_names, lt_types|:
                                lt_names.push(p2.name)
                                lt_types.push(bare_type_name(p2.type_expr))
                            ret_tname: mutable sview = ""
                            if return_type is rt2:
                                ret_tname <- bare_type_name(rt2)
                            if ret_tname == "void":
                                ret_tname <- ""
                            table <- check_var_inits(body, ret_tname, lt_names, lt_types, table)
                        Decl.Module(name, body, line):
                            table <- resolve_decls(body, table)
                        Decl.Scoped(body, line):
                            table <- resolve_decls(body, table)
                        _:
                            pass
