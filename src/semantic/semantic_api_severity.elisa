# Stage1 semantic — diagnostic severity and parse-error wrapping (`extend Semantic:
# public+private:`). `diagnostic_severity` maps every kind onto the canonical LSP
# severity, kept as one flat match so a new kind must decide its severity here; the
# private helpers wrap the parser's own errors as diagnostics. Split out of
# semantic_api.elisa to keep each part file under 600 lines.

extend Semantic:
    public:
        # Canonical LSP DiagnosticSeverity for a diagnostic (1 = Error, 2 = Warning,
        # 3 = Information, 4 = Hint). Kept beside the wording so a new `DiagnosticKind`
        # must decide its severity here too. Both current kinds are errors.
        def diagnostic_severity(diagnostic: Diagnostic) -> u8:
            can Abort.Panic:
                return match diagnostic.kind:
                    DiagnosticKind.UndefinedName:            1
                    DiagnosticKind.CStrPointerCompare:       2
                    DiagnosticKind.DuplicateDecl:            1
                    DiagnosticKind.DuplicateType:            1
                    DiagnosticKind.AssignImmutable:          1
                    DiagnosticKind.DuplicateParam:           1
                    DiagnosticKind.DuplicateField:           1
                    DiagnosticKind.DuplicateVariant:         1
                    DiagnosticKind.NonExhaustiveMatch:       1
                    DiagnosticKind.NonExhaustiveScalarMatch: 1
                    DiagnosticKind.InvalidTopLevelScalarMatchArm: 1
                    DiagnosticKind.InvalidExportBoundary: 1
                    DiagnosticKind.BlockLambdaMissingContext: 1
                    DiagnosticKind.LegacyErrorSyntax: 1
                    DiagnosticKind.NullableWithoutProof: 1
                    DiagnosticKind.AggregateStateArity: 1
                    DiagnosticKind.FunctionParameterVariance: 1
                    DiagnosticKind.NonExhaustiveCatch: 1
                    DiagnosticKind.OrdinaryEnumTailPayload: 1
                    DiagnosticKind.FloatDictRuntimeKey: 1
                    DiagnosticKind.TryRequiresFallible: 1
                    DiagnosticKind.ConstFloatCastRange: 1
                    DiagnosticKind.ContainerShapeReturn: 1
                    DiagnosticKind.InternalRuntimeCarrier: 1
                    DiagnosticKind.UngrantedParallelFor: 2
                    DiagnosticKind.ParallelOuterMutation: 1
                    DiagnosticKind.UnknownPermissionMember: 1
                    DiagnosticKind.PermissionParamMemberAccess: 1
                    DiagnosticKind.TruthyOrBindingMismatch: 1
                    DiagnosticKind.RaiseDestinationMismatch: 1
                    DiagnosticKind.LambdaRaiseMismatch: 1
                    DiagnosticKind.GhostInitImpure: 1
                    DiagnosticKind.GhostFieldRead: 1
                    DiagnosticKind.ConstDictNoKey: 1
                    DiagnosticKind.ErrorsetParamShadow: 2
                    DiagnosticKind.PrivateMemberAccess: 1
                    DiagnosticKind.StaticIndirectRecursion: 1
                    DiagnosticKind.StaticPartialRecursion: 1
                    DiagnosticKind.StaticSignedBaseCase:   1
                    DiagnosticKind.PreservesViolation: 1
                    DiagnosticKind.AmbiguousErrorVariant: 1
                    DiagnosticKind.GhostFnImpure: 1
                    DiagnosticKind.GhostFnRuntimeCall: 1
                    DiagnosticKind.RaiseVariantNotAllowed: 1
                    DiagnosticKind.TryPropagationMismatch: 1
                    DiagnosticKind.ReadonlyRefMutation: 1
                    DiagnosticKind.ReadonlyRefArgument: 1
                    DiagnosticKind.DestroyedRegionUse: 1
                    DiagnosticKind.StorageDependencyInvalidated: 1
                    DiagnosticKind.MachineTagCoverage: 1
