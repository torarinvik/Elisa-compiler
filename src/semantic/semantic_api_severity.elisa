# Stage1 semantic — diagnostic severity and parse-error wrapping (`extend Semantic:
# public+private:`). `diagnostic_severity` maps a diagnostic kind onto the canonical LSP
# severity, and the private helpers wrap the parser's own errors as diagnostics. Split out
# of semantic_api.elisa.
#
# ERROR (1) IS THE DEFAULT: only the kinds that are NOT a plain error are listed — the
# warnings (2), the hints (4), and the notes (0) the driver's gate deliberately does not
# reject on — together with any error whose severity was a MEASURED decision worth keeping.
# Every other kind falls to the `_` arm. (This table used to name all 541 kinds so that the
# exhaustiveness check forced a new kind to decide; that spelling no longer fits in one
# file, and Error is the safe default for a kind nobody has classified.)

const module SemanticDiagnosticSeverity:
    NOTE: u8 = 0
    ERROR: u8 = 1
    WARNING: u8 = 2
    HINT: u8 = 4

extend Semantic:
    public:
        # Canonical LSP DiagnosticSeverity for a diagnostic (1 = Error, 2 = Warning,
        # 3 = Information, 4 = Hint), plus 0 for a note the driver's gate ignores. Only the
        # kinds that are not a plain error are named; see the file header.
        def diagnostic_severity(diagnostic: Diagnostic) -> u8:
            can Abort.Panic:
                # Only `Arena`/`ArenaMark` are warning-level carriers; `StringView`, `DynArray`,
                # `DynArrayView` and `DynDict` are stage0 ERRORS.
                SemanticDiagnosticSeverity::ERROR return if diagnostic.kind == DiagnosticKind.UngrantedEffectCall and diagnostic.detail == "canonical-unsafe"
                SemanticDiagnosticSeverity::ERROR return if diagnostic.kind == DiagnosticKind.InternalRuntimeCarrier and not internal_runtime_carrier_is_warning(diagnostic.name)
                # Raw-pointer-to-cstr casts manufacture the NUL-termination invariant. This
                # one cast family is a hard error in every mode; ordinary pointer-cast
                # diagnostics below remain warnings unless a separate strict gate is enabled.
                SemanticDiagnosticSeverity::ERROR return if diagnostic.kind == DiagnosticKind.UngrantedPointerCast and diagnostic.detail == "cstr"
                # Forging a reference from a number / upgrading a read-only reference to
                # mutable: hard errors in every mode (stage0 errorOnMissingLocalGrant).
                hard_pointer_cast_detail: bool = when diagnostic.detail:
                    "forge" | "upgrade" -> true
                    _ -> false
                SemanticDiagnosticSeverity::ERROR return if diagnostic.kind == DiagnosticKind.UngrantedPointerCast and hard_pointer_cast_detail
                return match diagnostic.kind:
                    DiagnosticKind.CStrPointerCompare:       SemanticDiagnosticSeverity::WARNING
                    # stage0 emits the internal-runtime-carrier finding as a WARNING and compiles
                    # on; with no entry here it fell to the error default, so stage1 REJECTED a
                    # by-value `Arena` local (and an Arena param) that stage0 accepts -- a
                    # reject-gap on the deprecated `in <arena>:` surface, unseen only because no
                    # fixture had touched it. Measured: stage0 prints `warning: internal runtime
                    # carrier type "Arena" …` and continues to lowering.
                    DiagnosticKind.InternalRuntimeCarrier:   SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.UngrantedParallelFor: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.ErrorsetParamShadow: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.UnusedParam:              SemanticDiagnosticSeverity::HINT
                    DiagnosticKind.UnusedLocal:              SemanticDiagnosticSeverity::HINT
                    DiagnosticKind.UnreachableCode:          SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.SelfAssignment:           SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.SelfComparison:           SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.UnusedExpression:         SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.ConstantCondition:        SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.RedundantBoolCompare:     SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.DuplicateImport:          SemanticDiagnosticSeverity::WARNING
                    # MEASURED against stage0's ACCEPT/REJECT (not its wording): stage0
                    # exits 1 on test/fixtures/diagnostics/duplicate_match_arm.pos.elisa.
                    # A scalar duplicate arm is dead code that silently changes behaviour,
                    # and the driver's gate only rejects on severity 1.
                    DiagnosticKind.DuplicateMatchArm:        SemanticDiagnosticSeverity::ERROR
                    # stage0 does NOT diagnose these at all — it compiles every one of
                    # test/fixtures/diagnostics/{division_by_zero,modulo_by_zero,
                    # oversized_shift,negative_shift}.pos.elisa and exits 0. They are a
                    # stage1 ENHANCEMENT, so they stay as WARNINGS: the finding is still
                    # reported and still held by diagnostics_smoke, but the driver's gate
                    # (severity 1 only) no longer REJECTS a program stage0 accepts.
                    DiagnosticKind.DivisionByZero:           SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.DuplicateDictKey:         SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.DuplicateSetElement:      SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.SelfArithmetic:           SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.DoubleNegation:           SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.InfiniteLoopNoExit:       SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.RedundantArithmetic:      SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.EmptyRange:               SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.AssignToLoopVar:          SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.ConstantComparison:       SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.DuplicateCondition:       SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.DiscardedCallResult:      SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.OversizedShift:           SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.NegativeShift:            SemanticDiagnosticSeverity::WARNING
                    # LiteralComparisonImpossible is NOT listed: stage0 makes it an ERROR
                    # ("integer literal 300 does not fit in u8" for `x: u8` compared to 300),
                    # measured across ==, !=, <, negative literals and u8/u16/i8/i32. As a
                    # severity-2 warning stage1 computed the finding and then discarded it —
                    # the driver reports warnings only under `-emit interpret` — so stage1
                    # exited 0 on source stage0 rejects. Falling through to the `_` arm makes
                    # it Error(1), the file's default.
                    DiagnosticKind.IdenticalLogicalOperands: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.IdenticalBranches:        SemanticDiagnosticSeverity::WARNING
                    # `for x in []:` — stage0 exits 1 ("empty list literal requires an
                    # expected array or darray type"). stage1's analyzer reported the same
                    # text all along at severity 2, so the driver ignored it; the BARE
                    # fixture still failed to compile, but only because the function got
                    # DECLINED, which is agreement by accident. Visible only once the
                    # diagnostics corpus was replayed with the std in scope.
                    DiagnosticKind.EmptyIterable:            SemanticDiagnosticSeverity::ERROR
                    DiagnosticKind.UnusedImport:             SemanticDiagnosticSeverity::WARNING
                    # HINT, not warning (2026-09-16): stage0 has no float-equality diagnostic at
                    # all, and `-emit interpret` prints every warning before the result line as
                    # stage0 does, so at severity 2 this stage1-only lint broke interpret parity
                    # on any program comparing floats (test/repro/qualified_firm_argument_collision).
                    # The message is still produced (diagnostics_smoke pins it); porting the lint
                    # to stage0 is the owner's call.
                    DiagnosticKind.FloatEquality:            SemanticDiagnosticSeverity::HINT
                    DiagnosticKind.SentinelIndex:            SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.UntypedEmptyBuilder:      SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.ImmediateOverwrite:       SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.ModuloByZero:             SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.ShiftByZero:              SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.LogicalConstantOperand:   SemanticDiagnosticSeverity::WARNING
                    # stage0 exits 1 on duplicate_decorator.pos.elisa.
                    DiagnosticKind.DuplicateDecorator:       SemanticDiagnosticSeverity::ERROR
                    DiagnosticKind.RedundantContinue:        SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.NegatedComparison:        SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.RedundantCast:            SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.UngrantedPanic:           SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.UngrantedEffectCall:      SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.UnusedDecreases:          SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.UngrantedPointerCast: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.UngrantedBufferReinterpret: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.FlowFlagStateMachine:     SemanticDiagnosticSeverity::WARNING
                    # Closes a real PERMISSIVE gap: stage1 accepted `+`/`-`/etc. on a
                    # completely unbound generic type parameter that stage0 rejects at
                    # declaration -- see generic-operator-bound-checking-gap.md. Landed
                    # gating (severity 1) only after an empirical audit, not by
                    # inspection: staged at severity 0 first, then a full
                    # self_host_gen2.sh run (the compiler's own ~118k-line source AND all
                    # of elisacore_std it depends on) came back with ZERO new
                    # diagnostics. One real false positive WAS found and fixed during
                    # that staging -- `items: T&` (a C-buffer pointer parameter) is
                    # POINTER ARITHMETIC on `items + index`, unrelated to whatever T's own
                    # bound provides, and the first version of this check conflated a
                    # bare-VALUE parameter with a bare-REF one.
                    DiagnosticKind.GenericOperatorNoBound: SemanticDiagnosticSeverity::ERROR
                    DiagnosticKind.CountingFillUnreserved: SemanticDiagnosticSeverity::NOTE
                    DiagnosticKind.AssertProofHole: SemanticDiagnosticSeverity::NOTE
                    DiagnosticKind.AssertExplicitHole: SemanticDiagnosticSeverity::NOTE
                    # stage0 exits 1 on both ensure_constant_violated.pos.elisa (provably
                    # violated) and contract_ensure_result_void.neg.elisa (unproven).
                    DiagnosticKind.EnsureNotProven: SemanticDiagnosticSeverity::ERROR
                    DiagnosticKind.RefinementReturnNotProven: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.RefinementArgNotProven: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.LoopInvariantNotPreserved: SemanticDiagnosticSeverity::NOTE
                    DiagnosticKind.QuantifiedRefinementUnproven: SemanticDiagnosticSeverity::NOTE
                    DiagnosticKind.DecreasesLoopNotDecreasing: SemanticDiagnosticSeverity::NOTE
                    DiagnosticKind.LocalRefinementUnproven: SemanticDiagnosticSeverity::NOTE
                    DiagnosticKind.UnboundedStringErasure: SemanticDiagnosticSeverity::NOTE
                    DiagnosticKind.DecreasesRuntimeUnmodelable: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.ProgressNoEvidence: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.ProgressRecursiveCycle: SemanticDiagnosticSeverity::WARNING
                    # DEPRECATIONS ARE NOT ERRORS. stage0 raises all three through
                    # `deprecatedf`, which records a deprecation and lets the compile
                    # SUCCEED; stage1 had them at severity 1, so `new[auto]`, `in auto:`
                    # and a call to an `@deprecated` function each FAILED the build where
                    # stage0 exits 0. Measured one fixture per kind, all three diverged.
                    #
                    # Severity 2 (warning) is the closest stage1 has: it reports the same
                    # advice without refusing the program, which is the accept/reject
                    # decision every parity gate compares.
                    DiagnosticKind.DeprecatedFunctionUse: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.InAutoDeprecated: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.NewAutoDeprecated: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.ContradictoryRequires: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.PermissionReservedName: SemanticDiagnosticSeverity::NOTE
                    DiagnosticKind.RedundantInlineGrant: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.HotArgument: SemanticDiagnosticSeverity::NOTE
                    DiagnosticKind.HotVectorize: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.IntrinsicNamePrefix: SemanticDiagnosticSeverity::NOTE
                    DiagnosticKind.TrustedExternReason: SemanticDiagnosticSeverity::NOTE
                    DiagnosticKind.ExternLinkNameConflict: SemanticDiagnosticSeverity::NOTE
                    DiagnosticKind.LmutFalseClaim: SemanticDiagnosticSeverity::NOTE
                    DiagnosticKind.HotKernelNotDisjoint: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.InteriorPointerWiden: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.CastConstantTruncated: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.ConstEnumValueOverflow: SemanticDiagnosticSeverity::NOTE
                    # A DECLARATION INITIALIZER that overflows its type (`a: u8 = 300`).
                    # stage0 exits 1 on it. The sibling `check_literal_assign_out_of_range`
                    # covers only the ASSIGNMENT spelling (`a <- 300`) and was already
                    # severity 1, so the corpus — whose .pos fixture uses the assignment —
                    # never exercised this one. Fixture: literal_init_out_of_range.pos.
                    DiagnosticKind.IntegerLiteralOverflow: SemanticDiagnosticSeverity::ERROR
                    DiagnosticKind.FuncShadowsBuiltinType: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.PushLoopExtendable: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.CharClassifierGuard: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.RedundantEffectGrant: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.FlowElifLadder: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.FlowCursorDoubleAdvance: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.FlowNestingDepth: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.FlowRetestLadder: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.FlowStateFlag: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.FlowSingleMutation: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.FlowExitBudget: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.FlowProgress: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.RegionGrowthRealloc: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.ContractArgTypeMismatch: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.UsesPreconditionViolated: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.UncheckedIndexUngranted: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.MutableAliasUngranted: SemanticDiagnosticSeverity::WARNING
                    # PositionalConstruction is DELIBERATELY not listed: it is an ERROR in
                    # stage0 and blocks emission there. It sat at 2 and was therefore
                    # invisible -- the driver's gate only counts and prints severity 1.
                    DiagnosticKind.EmptyListNeedsType: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.ZipMapSourceNotReadonly: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.FlowStrictBlockIf: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.NumericLiteralSuffix: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.ByValueGrownContainer: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.PreconditionUnproven: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.LoopInvariantNotEstablished: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.FunctionInvariantUnproven: SemanticDiagnosticSeverity::WARNING
                    DiagnosticKind.StructPadding: SemanticDiagnosticSeverity::WARNING
                    _:                                       SemanticDiagnosticSeverity::ERROR


extend Semantic:

    private:
        # Fold the parser's syntax findings (`Ast::File.errors`) into the diagnostic stream
        # so the one `SymbolTable.diagnostics` list carries both syntax and semantic
        # findings — a consumer iterating it sees everything the frontend found. `context`
        # (the offending token text) becomes the diagnostic's `name`.
        def append_parse_errors(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for parse_error in file.errors |table| -> table:
                    # stage0's syntax sentences NAME the two token kinds, so carry them:
                    # `expected` is the wanted kind, `actual` the found one (the two spellings
                    # differ for NEWLINE alone, which is why the found side passes `true`).
                    # `expected_count` is `has_expected`; `actual_count` marks a found kind
                    # whose TEXT stage0 appends as `KIND("text")`. Both names are LITERALS from
                    # the shared table, so nothing here views a local buffer — a Diagnostic may
                    # only carry source or literal sviews.
                    table.diagnostics <- table.diagnostics.push(Diagnostic{name: parse_error.context, line: parse_error.line, kind: parse_error_kind(parse_error.kind), expected: parse_error_token_kind_name(parse_error.expected_kind, false), actual: parse_error_token_kind_name(parse_error.got_kind, true), expected_count: 1 if parse_error.has_expected else 0, actual_count: 1 if parse_error_kind_quotes_text(parse_error.got_kind) else 0})
                    table


        # A token kind spelled for a message, through the one shared table. `found` picks
        # stage0's FOUND-position spelling, which differs from the expected-position one for
        # exactly one kind: a found newline is `NEWLINE`, an expected one the lower-case
        # `newline` that its only sentence hard-codes.
        def parse_error_token_kind_name(kind: TokenKind, found: bool) -> sview:
            can Abort.Panic, Memory.Allocate:
                return "newline" if kind == TokenKind.Newline and not found
                return token_kind_display_name(emit_tokens_kind_code(kind) - 1)

        # stage0 appends the token's TEXT (`IDENT("x")`) for the kinds whose spelling does not
        # already name it: `Text != "" && Text != name` in its own renderer.
        def parse_error_kind_quotes_text(kind: TokenKind) -> bool:
            return kind == TokenKind.Ident or kind == TokenKind.IntLit or kind == TokenKind.FloatLit or kind == TokenKind.HexLit or kind == TokenKind.StringLit or kind == TokenKind.CharLit

        # Map a parser `ParseErrorKind` onto the unified `DiagnosticKind`.
        def parse_error_kind(error_kind: Ast::ParseErrorKind) -> DiagnosticKind:
            can Abort.Panic:
                return match error_kind:
                    Ast::ParseErrorKind.ExpectedToken:       DiagnosticKind.SyntaxExpectedToken
                    Ast::ParseErrorKind.UnexpectedToken:     DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.UnexpectedInExpression: DiagnosticKind.SyntaxUnexpectedInExpression
                    Ast::ParseErrorKind.TypestateUnknownState: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.ProtocolMethodContractOnly: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.ExpectedDeclaration: DiagnosticKind.SyntaxExpectedDeclaration
                    Ast::ParseErrorKind.ExpectedExpression:  DiagnosticKind.SyntaxExpectedExpression
                    Ast::ParseErrorKind.MismatchedWithBindings: DiagnosticKind.SyntaxMismatchedWithBindings
                    Ast::ParseErrorKind.SubmitOutsidePool: DiagnosticKind.SubmitOutsidePool
                    Ast::ParseErrorKind.Removed:             DiagnosticKind.SyntaxRemoved
                    # The name-bearing sentences: their text is composed by the driver's
                    # renderer, so the semantic view classifies them as syntax findings.
                    Ast::ParseErrorKind.RemovedRegionParamSpelling: DiagnosticKind.SyntaxRemoved
                    Ast::ParseErrorKind.DuplicateGenericParam: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.StructStateMarkerList: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.EnsuresReturnNeedsBoolLiteral: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.WhenArmOverlap: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.WhenDuplicateDefaultRow: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.WhenColumnCount: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.ModulePathDotSeparator: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.VisibilitySectionAtTopLevel: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.RebindWithCapture: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.LoopHeaderCaptureTwice: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.LoopHeaderDeclAndCapture: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.GuestOverlayFieldNeedsOffset: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.ThreadSlotNotAParameter: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.ThreadSlotNotLmut: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.ThreadReturnTupleArity: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.ThreadReturnSlotExpr: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.ForHeaderTrailingTokens: DiagnosticKind.SyntaxUnexpectedToken
                    # The machine laws (docs/123 / docs/125). Every one is a parser-level
                    # refusal, so they classify as syntax findings like the rest.
                    Ast::ParseErrorKind.MachineLaw: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineStateDeclaredTwice: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineStateRepeatsField: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineStartUndeclaredState: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineStartArity: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineArmNoDecision: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineTransitionUndeclaredState: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineTransitionArity: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineStateNoArms: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineArmUnreachable: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineArmRepeatsInput: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineStateNotTotal: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineArmAssignsPayloadField: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineArmForeignState: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineFromEnumMismatch: DiagnosticKind.SyntaxUnexpectedToken
