# Stage1 semantic — diagnostic severity and parse-error wrapping (`extend Semantic:
# public+private:`). `diagnostic_severity` maps a diagnostic kind onto the canonical LSP
# severity, and the private helpers wrap the parser's own errors as diagnostics. Split out
# of semantic_api.elisa.
#
# ERROR (1) IS THE DEFAULT: only the kinds that are NOT a plain error are listed — the
# warnings (2), the hints (4), and the notes (0) the driver's gate deliberately does not
# reject on — together with any error whose severity was a MEASURED decision worth keeping.
# Every other kind falls to the `_` arm. (This table used to name all 541 kinds so that the
# exhaustiveness check forced a new kind to decide; that spelling no longer fits in one
# file, and Error is the safe default for a kind nobody has classified.)

extend Semantic:
    public:
        # Canonical LSP DiagnosticSeverity for a diagnostic (1 = Error, 2 = Warning,
        # 3 = Information, 4 = Hint), plus 0 for a note the driver's gate ignores. Only the
        # kinds that are not a plain error are named; see the file header.
        def diagnostic_severity(diagnostic: Diagnostic) -> u8:
            can Abort.Panic:
                return match diagnostic.kind:
                    DiagnosticKind.CStrPointerCompare:       2
                    # stage0 emits the internal-runtime-carrier finding as a WARNING and compiles
                    # on; with no entry here it fell to the error default, so stage1 REJECTED a
                    # by-value `Arena` local (and an Arena param) that stage0 accepts -- a
                    # reject-gap on the deprecated `in <arena>:` surface, unseen only because no
                    # fixture had touched it. Measured: stage0 prints `warning: internal runtime
                    # carrier type "Arena" …` and continues to lowering.
                    DiagnosticKind.InternalRuntimeCarrier:   2
                    DiagnosticKind.UngrantedParallelFor: 2
                    DiagnosticKind.ErrorsetParamShadow: 2
                    DiagnosticKind.UnusedParam:              4
                    DiagnosticKind.UnusedLocal:              4
                    DiagnosticKind.UnreachableCode:          2
                    DiagnosticKind.SelfAssignment:           2
                    DiagnosticKind.SelfComparison:           2
                    DiagnosticKind.UnusedExpression:         2
                    DiagnosticKind.ConstantCondition:        2
                    DiagnosticKind.RedundantBoolCompare:     2
                    DiagnosticKind.DuplicateImport:          2
                    # MEASURED against stage0's ACCEPT/REJECT (not its wording): stage0
                    # exits 1 on test/fixtures/diagnostics/duplicate_match_arm.pos.elisa.
                    # A scalar duplicate arm is dead code that silently changes behaviour,
                    # and the driver's gate only rejects on severity 1.
                    DiagnosticKind.DuplicateMatchArm:        1
                    # stage0 does NOT diagnose these at all — it compiles every one of
                    # test/fixtures/diagnostics/{division_by_zero,modulo_by_zero,
                    # oversized_shift,negative_shift}.pos.elisa and exits 0. They are a
                    # stage1 ENHANCEMENT, so they stay as WARNINGS: the finding is still
                    # reported and still held by diagnostics_smoke, but the driver's gate
                    # (severity 1 only) no longer REJECTS a program stage0 accepts.
                    DiagnosticKind.DivisionByZero:           2
                    DiagnosticKind.DuplicateDictKey:         2
                    DiagnosticKind.DuplicateSetElement:      2
                    DiagnosticKind.SelfArithmetic:           2
                    DiagnosticKind.DoubleNegation:           2
                    DiagnosticKind.InfiniteLoopNoExit:       2
                    DiagnosticKind.RedundantArithmetic:      2
                    DiagnosticKind.EmptyRange:               2
                    DiagnosticKind.AssignToLoopVar:          2
                    DiagnosticKind.ConstantComparison:       2
                    DiagnosticKind.DuplicateCondition:       2
                    DiagnosticKind.DiscardedCallResult:      2
                    DiagnosticKind.OversizedShift:           2
                    DiagnosticKind.NegativeShift:            2
                    # LiteralComparisonImpossible is NOT listed: stage0 makes it an ERROR
                    # ("integer literal 300 does not fit in u8" for `x: u8` compared to 300),
                    # measured across ==, !=, <, negative literals and u8/u16/i8/i32. As a
                    # severity-2 warning stage1 computed the finding and then discarded it —
                    # the driver reports warnings only under `-emit interpret` — so stage1
                    # exited 0 on source stage0 rejects. Falling through to the `_` arm makes
                    # it Error(1), the file's default.
                    DiagnosticKind.IdenticalLogicalOperands: 2
                    DiagnosticKind.IdenticalBranches:        2
                    # `for x in []:` — stage0 exits 1 ("empty list literal requires an
                    # expected array or darray type"). stage1's analyzer reported the same
                    # text all along at severity 2, so the driver ignored it; the BARE
                    # fixture still failed to compile, but only because the function got
                    # DECLINED, which is agreement by accident. Visible only once the
                    # diagnostics corpus was replayed with the std in scope.
                    DiagnosticKind.EmptyIterable:            1
                    DiagnosticKind.UnusedImport:             2
                    # HINT, not warning (2026-09-16): stage0 has no float-equality diagnostic at
                    # all, and `-emit interpret` prints every warning before the result line as
                    # stage0 does, so at severity 2 this stage1-only lint broke interpret parity
                    # on any program comparing floats (test/repro/qualified_firm_argument_collision).
                    # The message is still produced (diagnostics_smoke pins it); porting the lint
                    # to stage0 is the owner's call.
                    DiagnosticKind.FloatEquality:            4
                    DiagnosticKind.SentinelIndex:            2
                    DiagnosticKind.UntypedEmptyBuilder:      2
                    DiagnosticKind.ImmediateOverwrite:       2
                    DiagnosticKind.ModuloByZero:             2
                    DiagnosticKind.ShiftByZero:              2
                    DiagnosticKind.LogicalConstantOperand:   2
                    # stage0 exits 1 on duplicate_decorator.pos.elisa.
                    DiagnosticKind.DuplicateDecorator:       1
                    DiagnosticKind.RedundantContinue:        2
                    DiagnosticKind.NegatedComparison:        2
                    DiagnosticKind.RedundantCast:            2
                    DiagnosticKind.UngrantedPanic:           2
                    DiagnosticKind.UngrantedEffectCall:      2
                    DiagnosticKind.UnusedDecreases:          2
                    DiagnosticKind.UngrantedPointerCast: 2
                    DiagnosticKind.UngrantedBufferReinterpret: 2
                    DiagnosticKind.FlowFlagStateMachine:     2
                    # Closes a real PERMISSIVE gap: stage1 accepted `+`/`-`/etc. on a
                    # completely unbound generic type parameter that stage0 rejects at
                    # declaration -- see generic-operator-bound-checking-gap.md. Landed
                    # gating (severity 1) only after an empirical audit, not by
                    # inspection: staged at severity 0 first, then a full
                    # self_host_gen2.sh run (the compiler's own ~118k-line source AND all
                    # of elisacore_std it depends on) came back with ZERO new
                    # diagnostics. One real false positive WAS found and fixed during
                    # that staging -- `items: T&` (a C-buffer pointer parameter) is
                    # POINTER ARITHMETIC on `items + index`, unrelated to whatever T's own
                    # bound provides, and the first version of this check conflated a
                    # bare-VALUE parameter with a bare-REF one.
                    DiagnosticKind.GenericOperatorNoBound: 1
                    DiagnosticKind.CountingFillUnreserved: 0
                    DiagnosticKind.AssertProofHole: 0
                    DiagnosticKind.AssertExplicitHole: 0
                    # stage0 exits 1 on both ensure_constant_violated.pos.elisa (provably
                    # violated) and contract_ensure_result_void.neg.elisa (unproven).
                    DiagnosticKind.EnsureNotProven: 1
                    DiagnosticKind.RefinementReturnNotProven: 2
                    DiagnosticKind.RefinementArgNotProven: 2
                    DiagnosticKind.LoopInvariantNotPreserved: 0
                    DiagnosticKind.QuantifiedRefinementUnproven: 0
                    DiagnosticKind.DecreasesLoopNotDecreasing: 0
                    DiagnosticKind.LocalRefinementUnproven: 0
                    DiagnosticKind.UnboundedStringErasure: 0
                    DiagnosticKind.DecreasesRuntimeUnmodelable: 2
                    DiagnosticKind.ProgressNoEvidence: 2
                    DiagnosticKind.ProgressRecursiveCycle: 2
                    # DEPRECATIONS ARE NOT ERRORS. stage0 raises all three through
                    # `deprecatedf`, which records a deprecation and lets the compile
                    # SUCCEED; stage1 had them at severity 1, so `new[auto]`, `in auto:`
                    # and a call to an `@deprecated` function each FAILED the build where
                    # stage0 exits 0. Measured one fixture per kind, all three diverged.
                    #
                    # Severity 2 (warning) is the closest stage1 has: it reports the same
                    # advice without refusing the program, which is the accept/reject
                    # decision every parity gate compares.
                    DiagnosticKind.DeprecatedFunctionUse: 2
                    DiagnosticKind.InAutoDeprecated: 2
                    DiagnosticKind.NewAutoDeprecated: 2
                    DiagnosticKind.ContradictoryRequires: 2
                    DiagnosticKind.PermissionReservedName: 0
                    DiagnosticKind.RedundantInlineGrant: 2
                    DiagnosticKind.HotArgument: 0
                    DiagnosticKind.HotVectorize: 2
                    DiagnosticKind.IntrinsicNamePrefix: 0
                    DiagnosticKind.TrustedExternReason: 0
                    DiagnosticKind.ExternLinkNameConflict: 0
                    DiagnosticKind.LmutFalseClaim: 0
                    DiagnosticKind.HotKernelNotDisjoint: 2
                    DiagnosticKind.InteriorPointerWiden: 2
                    DiagnosticKind.CastConstantTruncated: 2
                    DiagnosticKind.ConstEnumValueOverflow: 0
                    # A DECLARATION INITIALIZER that overflows its type (`a: u8 = 300`).
                    # stage0 exits 1 on it. The sibling `check_literal_assign_out_of_range`
                    # covers only the ASSIGNMENT spelling (`a <- 300`) and was already
                    # severity 1, so the corpus — whose .pos fixture uses the assignment —
                    # never exercised this one. Fixture: literal_init_out_of_range.pos.
                    DiagnosticKind.IntegerLiteralOverflow: 1
                    DiagnosticKind.FuncShadowsBuiltinType: 2
                    DiagnosticKind.PushLoopExtendable: 2
                    DiagnosticKind.CharClassifierGuard: 2
                    DiagnosticKind.RedundantEffectGrant: 2
                    DiagnosticKind.FlowElifLadder: 2
                    DiagnosticKind.FlowCursorDoubleAdvance: 2
                    DiagnosticKind.FlowNestingDepth: 2
                    DiagnosticKind.FlowRetestLadder: 2
                    DiagnosticKind.FlowStateFlag: 2
                    DiagnosticKind.FlowSingleMutation: 2
                    DiagnosticKind.FlowExitBudget: 2
                    DiagnosticKind.FlowProgress: 2
                    DiagnosticKind.RegionGrowthRealloc: 2
                    DiagnosticKind.ContractArgTypeMismatch: 2
                    DiagnosticKind.UsesPreconditionViolated: 2
                    DiagnosticKind.UncheckedIndexUngranted: 2
                    DiagnosticKind.MutableAliasUngranted: 2
                    DiagnosticKind.PositionalConstruction: 2
                    DiagnosticKind.EmptyListNeedsType: 2
                    DiagnosticKind.ZipMapSourceNotReadonly: 2
                    DiagnosticKind.FlowStrictBlockIf: 2
                    DiagnosticKind.NumericLiteralSuffix: 2
                    DiagnosticKind.ByValueGrownContainer: 2
                    DiagnosticKind.PreconditionUnproven: 2
                    DiagnosticKind.LoopInvariantNotEstablished: 2
                    DiagnosticKind.FunctionInvariantUnproven: 2
                    DiagnosticKind.StructPadding: 2
                    _:                                       1


extend Semantic:

    private:
        # Fold the parser's syntax findings (`Ast::File.errors`) into the diagnostic stream
        # so the one `SymbolTable.diagnostics` list carries both syntax and semantic
        # findings — a consumer iterating it sees everything the frontend found. `context`
        # (the offending token text) becomes the diagnostic's `name`.
        def append_parse_errors(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for parse_error in file.errors |table| -> table:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{name: parse_error.context, line: parse_error.line, kind: parse_error_kind(parse_error.kind), expected: "", actual: ""})
                    table


        # Map a parser `ParseErrorKind` onto the unified `DiagnosticKind`.
        def parse_error_kind(error_kind: Ast::ParseErrorKind) -> DiagnosticKind:
            can Abort.Panic:
                return match error_kind:
                    Ast::ParseErrorKind.ExpectedToken:       DiagnosticKind.SyntaxExpectedToken
                    Ast::ParseErrorKind.UnexpectedToken:     DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.TypestateUnknownState: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.ProtocolMethodContractOnly: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.ExpectedDeclaration: DiagnosticKind.SyntaxExpectedDeclaration
                    Ast::ParseErrorKind.ExpectedExpression:  DiagnosticKind.SyntaxExpectedExpression
                    Ast::ParseErrorKind.MismatchedWithBindings: DiagnosticKind.SyntaxMismatchedWithBindings
                    Ast::ParseErrorKind.SubmitOutsidePool: DiagnosticKind.SubmitOutsidePool
                    Ast::ParseErrorKind.Removed:             DiagnosticKind.SyntaxRemoved
                    # The name-bearing sentences: their text is composed by the driver's
                    # renderer, so the semantic view classifies them as syntax findings.
                    Ast::ParseErrorKind.RemovedRegionParamSpelling: DiagnosticKind.SyntaxRemoved
                    Ast::ParseErrorKind.DuplicateGenericParam: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.StructStateMarkerList: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.EnsuresReturnNeedsBoolLiteral: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.WhenArmOverlap: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.WhenDuplicateDefaultRow: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.WhenColumnCount: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.ModulePathDotSeparator: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.VisibilitySectionAtTopLevel: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.RebindWithCapture: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.LoopHeaderCaptureTwice: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.LoopHeaderDeclAndCapture: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.GuestOverlayFieldNeedsOffset: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.ThreadSlotNotAParameter: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.ThreadSlotNotLmut: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.ThreadReturnTupleArity: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.ThreadReturnSlotExpr: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.ForHeaderTrailingTokens: DiagnosticKind.SyntaxUnexpectedToken
                    # The machine laws (docs/123 / docs/125). Every one is a parser-level
                    # refusal, so they classify as syntax findings like the rest.
                    Ast::ParseErrorKind.MachineLaw: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineStateDeclaredTwice: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineStateRepeatsField: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineStartUndeclaredState: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineStartArity: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineArmNoDecision: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineTransitionUndeclaredState: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineTransitionArity: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineStateNoArms: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineArmUnreachable: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineArmRepeatsInput: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineStateNotTotal: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineArmAssignsPayloadField: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineArmForeignState: DiagnosticKind.SyntaxUnexpectedToken
                    Ast::ParseErrorKind.MachineFromEnumMismatch: DiagnosticKind.SyntaxUnexpectedToken
