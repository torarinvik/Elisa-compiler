# Canonical named-state identity, separate from borrow capabilities and move authority.
extend Semantic:
    private:
        def unknown_binding_state_identity() -> BindingStateIdentity:
            BindingStateIdentity{known: false, family_id: DeclId{value: 4294967295}, state_index: 4294967295, protocol: false}

        def resolve_binding_state_identity(expression: Ast::Expr, scope: sview, visited: mutable darray[u32]&, table: lmut SymbolTable, depth: u32 = 0) -> BindingStateIdentity:
            can Memory.Allocate, Abort.Panic:
                # No named-state identity can exist without a resolved family.
                # Avoid a second nominal/import traversal for every ordinary binding.
                return unknown_binding_state_identity() if table.resolved_state_families.count == 0
                return unknown_binding_state_identity() if depth >= 128
                match expression:
                    Expr.Paren(inner, _) | Expr.Refinement(inner, _, _):
                        rebind result: BindingStateIdentity, table = resolve_binding_state_identity(inner, scope, visited, table, depth + 1)
                        return result
                    Expr.Unary(operator, inner, _):
                        return unknown_binding_state_identity() if operator != TokenKind.Mutable and operator != TokenKind.Ampersand and operator != TokenKind.Lmut
                        rebind result: BindingStateIdentity, table = resolve_binding_state_identity(inner, scope, visited, table, depth + 1)
                        return result
                    Expr.Index(base, argument, _):
                        state: mutable sview = ""
                        match argument:
                            Expr.Ident(name, _):
                                state <- name
                            _:
                                return unknown_binding_state_identity()
                        row: u32 = binding_nominal_declaration(base, scope, table)
                        return unknown_binding_state_identity() if row == SYMBOL_INDEX_ROW_NONE
                        symbol: Symbol = table.symbols[row.usize()]
                        return unknown_binding_state_identity() if symbol.kind != SymbolKind.Struct
                        for resolved in table.resolved_state_families:
                            continue if resolved.declaration_id.value != symbol.id.value
                            family: Ast::StateFamily = table.state_family_declarations[resolved.source_index.usize()]
                            found: mutable u32 = 4294967295
                            for index in 0..<family.states.count |found|:
                                if family.states[index] == state:
                                    return unknown_binding_state_identity() if found != 4294967295
                                    found <- index.u32()
                            return unknown_binding_state_identity() if found == 4294967295
                            return BindingStateIdentity{known: true, family_id: symbol.id, state_index: found, protocol: not family.has_derive}
                        return unknown_binding_state_identity()
                    _:
                        pass
                row: u32 = binding_nominal_declaration(expression, scope, table)
                return unknown_binding_state_identity() if row == SYMBOL_INDEX_ROW_NONE
                symbol: Symbol = table.symbols[row.usize()]
                return unknown_binding_state_identity() if symbol.kind != SymbolKind.Alias or any previous in visited where previous == symbol.id.value
                visited.push(symbol.id.value)
                alias_count: usize = table.type_alias_declarations.count
                for index in 0..<alias_count |table, visited|:
                    alias: TypeAliasDeclaration = table.type_alias_declarations[index]
                    if alias.declaration_id.value == symbol.id.value:
                        rebind result: BindingStateIdentity, table = resolve_binding_state_identity(alias.target, alias.module_owner, visited, table, depth + 1)
                        return result
                return unknown_binding_state_identity()
