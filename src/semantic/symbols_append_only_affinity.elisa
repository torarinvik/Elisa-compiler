# Stage1 semantic layer — APPEND-ONLY AFFINITY. Twin of stage0
# analyzer_append_only_affinity.go. An `@append_only` store, and every struct that holds one by
# value anywhere inside it, is affine: two header copies of a store would append into the same
# spare capacity, so one copy overwrites bytes behind the other's live views (a silent wrong
# answer). Like a declared `__drop__`, holding a store INDUCES affinity, so the holder is a
# borrowable owner (`Pool&` is fine) while by-value copies, assignment and record updates hit
# the ordinary affine move-site checks. Continues symbols.elisa.

extend Semantic:
    private:
        # Whether a field type holds one of `holders` by value. A reference borrows, so it holds
        # none.
        def ao_affinity_type_holds(holders: darray[sview]&, type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Ident(name, _):
                        return any holder in holders where holder == name
                    Expr.Scope(_, name, _):
                        return any holder in holders where holder == name
                    Expr.Unary(operator, operand, _):
                        false return if operator == TokenKind.Ampersand
                        return ao_affinity_type_holds(holders, operand)
                    Expr.Paren(inner, _):
                        return ao_affinity_type_holds(holders, inner)
                    Expr.Refinement(base, _, _):
                        return ao_affinity_type_holds(holders, base)
                    Expr.Index(object, index, _):
                        return ao_affinity_type_holds(holders, object) or ao_affinity_type_holds(holders, index)
                    Expr.IndexN(object, arguments, _):
                        true return if ao_affinity_type_holds(holders, object)
                        return any argument in arguments where ao_affinity_type_holds(holders, argument)
                    Expr.Tuple(elements, _):
                        return any element in elements where ao_affinity_type_holds(holders, element)
                    _:
                        return false

        # One pass over `declarations` (through modules and scoped bodies): adds every store and
        # every struct with a field that holds a known holder.
        def ao_affinity_pass(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Struct(name, members, _, _, _, _, _):
                            if not any holder in table.append_only_holders where holder == name:
                                is_store: bool = any annotation in annotations where annotation.owner == name and annotation.name == "append_only"
                                if is_store or any member in members where ao_affinity_type_holds(table.append_only_holders, member.type_expression):
                                    table.append_only_holders <- table.append_only_holders.push(name)
                        Decl.Module(_, body, _):
                            table <- ao_affinity_pass(body, annotations, table)
                        Decl.Scoped(body, _):
                            table <- ao_affinity_pass(body, annotations, table)
                        _:
                            pass

        # Stores and their transitive holders into `table.append_only_holders`, to a fixpoint,
        # so declaration order is irrelevant.
        def collect_append_only_holders(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table.append_only_holders <- []
                known: mutable usize = 0
                table <- ao_affinity_pass(declarations, annotations, table)
                while table.append_only_holders.count > known |known, table|:
                    known <- table.append_only_holders.count
                    table <- ao_affinity_pass(declarations, annotations, table)
