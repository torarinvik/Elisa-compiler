# Affine-use flow analysis.
extend Semantic:
    private:
        def affine_call_nominal_identity_in_module(name: sview @source, module: sview @source, table: SymbolTable&) -> (found: bool, module: sview @source, owner: sview @source):
            can Abort.Panic:
                selected_kind: mutable SymbolKind = SymbolKind.Func
                selected: mutable bool = false
                for symbol in table.symbols |module, name, selected_kind, selected, table|:
                    type_symbol: bool = symbol.kind == SymbolKind.Struct or symbol.kind == SymbolKind.Enum or symbol.kind == SymbolKind.Alias or (symbol.kind == SymbolKind.Extern and symbol.opaque_extern_type)
                    continue if not type_symbol or symbol.name != name or symbol.module_owner != module
                    return (false, "", "") if selected and selected_kind != symbol.kind
                    selected_kind <- symbol.kind
                    selected <- true
                return (true, module, name) if selected
                variant_found: mutable bool = false
                variant_row: mutable usize = 0.usize()
                for row in 0..<table.enum_variant_name.count |module, name, variant_found, variant_row, table|:
                    continue if table.enum_variant_name[row] != name or table.enum_variant_module[row] != module
                    return (false, "", "") if variant_found and table.enum_variant_owner[variant_row] != table.enum_variant_owner[row]
                    variant_row <- row
                    variant_found <- true
                return (true, module, table.enum_variant_owner[variant_row]) if variant_found
                return (false, "", "")

        def affine_call_nominal_identity(name: sview @source, module: sview @source, table: SymbolTable&) -> (found: bool, module: sview @source, owner: sview @source):
            can Abort.Panic:
                path_separator: mutable usize = name.len
                scan: mutable usize = 0
                while scan + 1.usize() < name.len |scan, path_separator, name|:
                    if name[scan] == 58 and name[scan + 1.usize()] == 58:
                        path_separator <- scan
                    scan <- scan + 1.usize()
                if path_separator < name.len:
                    qualified_module: sview = string_view_slice(name, 0, path_separator.i64())
                    qualified_name: sview = string_view_slice(name, (path_separator + 2.usize()).i64(), name.len.i64())
                    return affine_call_nominal_identity_in_module(qualified_name, qualified_module, table)
                module_scope: mutable sview = module
                while true |module_scope, name, table|:
                    identity: (found: bool, module: sview @source, owner: sview @source) = affine_call_nominal_identity_in_module(name, module_scope, table)
                    return identity if identity.found
                    break if module_scope == ""
                    module_scope <- try_noncall_module_parent(module_scope)
                return (false, "", "")

        def affine_call_type_id_has_unique_nominal_names(type_id: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if type_id == 0
                kind: SemTypeKind = interned_kind(type_id, table)
                type_name: sview = interned_name(type_id, table)
                nominal_head: bool = kind == SemTypeKind.Named or (kind == SemTypeKind.Container and type_name != "array" and type_name != "darray" and type_name != "dict" and type_name != "set" and type_name != "view")
                if nominal_head:
                    if not affine_call_type_path_is_bare(type_name):
                        return affine_call_nominal_identity(type_name, "", table).found
                    return affine_call_unique_nominal_owner(type_name, table) or (kind == SemTypeKind.Named and affine_call_unique_enum_variant_name(type_name, table))
                for element_position in 0..<interned_elem_count(type_id, table) |type_id, table|:
                    return false if not affine_call_type_id_has_unique_nominal_names(interned_elem(type_id, element_position.u32(), table), table)
                return true

        def affine_call_unique_enum_variant_name(name: sview @source, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if table.enum_variant_name.count != table.enum_variant_owner.count or table.enum_variant_name.count != table.enum_variant_module.count
                selected_owner: mutable sview = ""
                selected_module: mutable sview = ""
                found: mutable bool = false
                for row in 0..<table.enum_variant_name.count |selected_owner, selected_module, found, name, table|:
                    continue if table.enum_variant_name[row] != name
                    return false if found and (table.enum_variant_owner[row] != selected_owner or table.enum_variant_module[row] != selected_module)
                    selected_owner <- table.enum_variant_owner[row]
                    selected_module <- table.enum_variant_module[row]
                    found <- true
                return found

        def affine_call_unique_field_type_id(owner: sview @source, field_name: sview @source, table: SymbolTable&) -> u32:
            can Abort.Panic:
                return 0 if not affine_call_unique_nominal_owner(owner, table)
                return 0 if table.struct_field_owner.count != table.struct_field_name.count or table.struct_field_owner.count != table.struct_field_type_id.count
                found_id: mutable u32 = 0
                found: mutable bool = false
                for row in 0..<table.struct_field_owner.count |found_id, found, table, owner, field_name|:
                    continue if table.struct_field_owner[row] != owner or table.struct_field_name[row] != field_name
                    candidate_id: u32 = table.struct_field_type_id[row]
                    return 0 if candidate_id == 0 or not affine_call_type_id_has_unique_nominal_names(candidate_id, table) or (found and found_id != candidate_id)
                    found_id <- candidate_id
                    found <- true
                return found_id if found
                return 0

        def affine_call_field_type_id(object: Ast::Expr, owner: sview @source, field_name: sview @source, current_module: sview @source, table: SymbolTable&) -> u32:
            can Abort.Panic:
                if affine_call_projection_has_call(object):
                    return affine_call_unique_field_type_id(owner, field_name, table)
                return field_type_id_of_in_module(table, owner, field_name, current_module)

        # A local's TypeId during the affine pass must come from this function's live lexical
        # bindings. `table.local_type_ids` is a resolve-types scratch channel and holds only
        # the last function visited by that earlier pass; consulting structural_type_id_of
        # here can borrow a same-named local's row from an unrelated function.
        def affine_call_loop_iterable_type_id(iterable: Ast::Expr, current_module: sview @source, function_line: Ast::Pos, annotations: darray[Ast::EnumAnnotation]&, names: darray[sview]&, local_type_ids: darray[u32]&, table: mutable SymbolTable&) -> u32:
            can Memory.Allocate, Abort.Panic:
                match iterable:
                    Expr.Ident(iterable_name, _):
                        while name_index > 0 |name_index: usize = names.count, iterable_name, local_type_ids|:
                            name_index <- name_index - 1
                            if names[name_index] == iterable_name:
                                return 0 if name_index < local_type_ids.count and type_id_contains_function_generic(local_type_ids[name_index], function_line.line, function_line.offset, table)
                                return local_type_ids[name_index] if name_index < local_type_ids.count
                                return 0
                        return global_type_id_of(iterable_name, table)
                    Expr.Paren(inner, _):
                        return affine_call_loop_iterable_type_id(inner, current_module, function_line, annotations, names, local_type_ids, table)
                    Expr.Unary(operator, inner, _) if operator == TokenKind.Ampersand or operator == TokenKind.Mutable or operator == TokenKind.Lmut:
                        return affine_call_loop_iterable_type_id(inner, current_module, function_line, annotations, names, local_type_ids, table)
                    Expr.Call(callee, _, _, _):
                        match callee:
                            Expr.Ident(function_name, _):
                                return 0 if any local_name in names where local_name == function_name
                                return affine_call_unqualified_return_type_id(function_name, current_module, annotations, table)
                            Expr.Scope(qualifier, qualified_function_name, _):
                                return affine_call_qualified_return_type_id(qualifier, qualified_function_name, current_module, annotations, table)
                            _:
                                return 0
                    Expr.Index(object, _, _):
                        return indexed_element_type_id(affine_call_loop_iterable_type_id(object, current_module, function_line, annotations, names, local_type_ids, table), table)
                    Expr.IndexN(object, arguments, _):
                        selected_id: mutable u32 = affine_call_loop_iterable_type_id(object, current_module, function_line, annotations, names, local_type_ids, table)
                        for _ in arguments |selected_id|:
                            selected_id <- indexed_element_type_id(selected_id, table)
                        return selected_id
                    Expr.Field(object, field_name, _):
                        object_id: mutable u32 = affine_call_loop_iterable_type_id(object, current_module, function_line, annotations, names, local_type_ids, table)
                        while interned_kind(object_id, table) == SemTypeKind.Ref:
                            object_id <- interned_elem(object_id, 0, table)
                        return affine_call_field_type_id(object, interned_name(object_id, table), field_name, current_module, table) if interned_kind(object_id, table) == SemTypeKind.Named
                        return 0
                    _:
                        return 0


        # The element TypeIds for simple sequence/dict loop bindings, when the iterable has a
        # structural type. Direct locals use the affine walk's per-function binding stack;
        # unknown and destructured shapes stay conservative.
        def affine_call_loop_variable_type_ids(iterable: Ast::Expr, current_module: sview @source, function_line: Ast::Pos, annotations: darray[Ast::EnumAnnotation]&, variable_count: usize, names: darray[sview]&, local_type_ids: darray[u32]&, table: mutable SymbolTable&) -> darray[u32]:
            can Memory.Allocate, Abort.Panic:
                result: mutable darray[u32] = []
                iterable_id: mutable u32 = affine_call_loop_iterable_type_id(iterable, current_module, function_line, annotations, names, local_type_ids, table)
                while interned_kind(iterable_id, table) == SemTypeKind.Ref:
                    iterable_id <- interned_elem(iterable_id, 0, table)
                head: sview = interned_name(iterable_id, table) if interned_kind(iterable_id, table) == SemTypeKind.Container else ""
                for variable_index in 0..<variable_count |result, variable_index, iterable_id, head, table|:
                    element_id: mutable u32 = 0
                    if variable_count == 1 and (head == "darray" or head == "array" or head == "set" or head == "view"):
                        element_id <- indexed_element_type_id(iterable_id, table)
                    if variable_count == 2 and head == "dict":
                        element_id <- interned_elem(iterable_id, variable_index.u32(), table)
                    result.push(element_id)
                return result


        # The general inference walk can consult table.local_type_ids after its lexical
        # spelling lookup, but that table is only the final function's resolve-types scratch
        # frame during this late pass. Keep call-owner viability on the affine walk's live
        # bindings: an unknown shadow stays Unknown, while annotated local containers use
        # their own TypeId for index and field projections.
        def affine_call_argument_infer_type(expression: Ast::Expr, current_module: sview @source, function_line: Ast::Pos, annotations: darray[Ast::EnumAnnotation]&, local_names: darray[sview]&, local_types: darray[sview @source]&, local_type_ids: darray[u32]&, table: mutable SymbolTable&) -> InferType:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.IntLit(_, _):
                        return primitive_type(SemTypeKind.Int)
                    Expr.FloatLit(_, _):
                        return primitive_type(SemTypeKind.Float)
                    Expr.StringLit(_, _):
                        return primitive_type(SemTypeKind.String)
                    Expr.CharLit(_, _):
                        return primitive_type(SemTypeKind.Char)
                    Expr.BoolLit(_, _):
                        return primitive_type(SemTypeKind.Bool)
                    Expr.Tuple(_, _):
                        return InferType{kind: SemTypeKind.Tuple, name: "tuple"}
                    Expr.Ident(name, _):
                        while local_index > 0 |local_index: usize = local_names.count, local_types, local_type_ids, name, table|:
                            local_index <- local_index - 1
                            if local_names[local_index] == name:
                                spelling: sview = local_types[local_index] if local_index < local_types.count else "__firm_scope_binder__"
                                local_id: u32 = local_type_ids[local_index] if local_index < local_type_ids.count else 0
                                return primitive_type(SemTypeKind.Unknown) if spelling == "__firm_scope_binder__"
                                flat: InferType = type_of_name(spelling) if spelling != "" and spelling != "__firm_scope_binder__" else primitive_type(SemTypeKind.Unknown)
                                return flat if flat.kind != SemTypeKind.Unknown
                                local_kind: SemTypeKind = interned_kind(local_id, table)
                                return InferType{kind: local_kind, name: interned_name(local_id, table)} if local_kind == SemTypeKind.Container or local_kind == SemTypeKind.Optional
                                return flat
                        return infer_from_type_id(global_type_id_of(name, table), table)
                    Expr.Paren(inner, _) | Expr.Move(inner, _) | Expr.Refinement(inner, _, _):
                        return affine_call_argument_infer_type(inner, current_module, function_line, annotations, local_names, local_types, local_type_ids, table)
                    Expr.Unary(operator, operand, _):
                        return primitive_type(SemTypeKind.Bool) if operator == TokenKind.Not
                        return affine_call_argument_infer_type(operand, current_module, function_line, annotations, local_names, local_types, local_type_ids, table) if operator == TokenKind.Bang or operator == TokenKind.Minus or operator == TokenKind.Plus or operator == TokenKind.Tilde
                        return primitive_type(SemTypeKind.Unknown)
                    Expr.Call(_, _, _, _):
                        return infer_from_type_id(affine_call_loop_iterable_type_id(expression, current_module, function_line, annotations, local_names, local_type_ids, table), table)
                    Expr.Index(object, _, _):
                        receiver_id: u32 = affine_call_loop_iterable_type_id(object, current_module, function_line, annotations, local_names, local_type_ids, table)
                        element_type: InferType = infer_from_type_id(indexed_element_type_id(receiver_id, table), table)
                        return element_type if element_type.kind != SemTypeKind.Unknown
                        receiver_type: InferType = affine_call_argument_infer_type(object, current_module, function_line, annotations, local_names, local_types, local_type_ids, table)
                        return primitive_type(SemTypeKind.Char) if receiver_type.kind == SemTypeKind.String
                        return primitive_type(SemTypeKind.Unknown)
                    Expr.IndexN(object, arguments, _):
                        receiver_id: u32 = affine_call_loop_iterable_type_id(object, current_module, function_line, annotations, local_names, local_type_ids, table)
                        selected_id: mutable u32 = receiver_id
                        for _ in arguments |selected_id, table|:
                            selected_id <- indexed_element_type_id(selected_id, table)
                        selected_type: InferType = infer_from_type_id(selected_id, table)
                        return selected_type if selected_type.kind != SemTypeKind.Unknown
                        receiver_type: InferType = affine_call_argument_infer_type(object, current_module, function_line, annotations, local_names, local_types, local_type_ids, table)
                        return primitive_type(SemTypeKind.Char) if receiver_type.kind == SemTypeKind.String
                        return primitive_type(SemTypeKind.Unknown)
                    Expr.Field(object, field_name, _):
                        object_id: mutable u32 = affine_call_loop_iterable_type_id(object, current_module, function_line, annotations, local_names, local_type_ids, table)
                        while interned_kind(object_id, table) == SemTypeKind.Ref:
                            object_id <- interned_elem(object_id, 0, table)
                        return infer_from_type_id(affine_call_field_type_id(object, interned_name(object_id, table), field_name, current_module, table), table) if interned_kind(object_id, table) == SemTypeKind.Named
                        return primitive_type(SemTypeKind.Unknown)
                    Expr.Binary(left, operator, right, _):
                        return primitive_type(SemTypeKind.Bool) if operator in {TokenKind.EqEq, TokenKind.BangEq, TokenKind.Lt, TokenKind.Gt, TokenKind.LtEq, TokenKind.GtEq, TokenKind.In, TokenKind.Is, TokenKind.And, TokenKind.Or}
                        if operator in {TokenKind.Plus, TokenKind.Minus, TokenKind.Star, TokenKind.Slash, TokenKind.Percent, TokenKind.LShift, TokenKind.RShift, TokenKind.Pipe, TokenKind.Caret, TokenKind.Ampersand}:
                            left_type: InferType = affine_call_argument_infer_type(left, current_module, function_line, annotations, local_names, local_types, local_type_ids, table)
                            right_type: InferType = affine_call_argument_infer_type(right, current_module, function_line, annotations, local_names, local_types, local_type_ids, table)
                            pointer_step: bool = operator == TokenKind.Plus or operator == TokenKind.Minus
                            return primitive_type(SemTypeKind.Unknown) if:
                                pointer_step and left_type.kind == SemTypeKind.Unknown and right_type.kind == SemTypeKind.Int
                                operator == TokenKind.Plus and left_type.kind == SemTypeKind.Int and right_type.kind == SemTypeKind.Unknown
                            return left_type if left_type.kind != SemTypeKind.Unknown
                            return right_type
                        return primitive_type(SemTypeKind.Unknown)
                    Expr.GetElse(guarded, _, _):
                        guarded_type: InferType = affine_call_argument_infer_type(guarded, current_module, function_line, annotations, local_names, local_types, local_type_ids, table)
                        if guarded_type.kind == SemTypeKind.Optional:
                            guarded_id: u32 = affine_call_loop_iterable_type_id(guarded, current_module, function_line, annotations, local_names, local_type_ids, table)
                            return infer_from_type_id(interned_elem(guarded_id, 0, table), table)
                        return guarded_type
                    Expr.Slice(object, _, _, _):
                        object_type: InferType = affine_call_argument_infer_type(object, current_module, function_line, annotations, local_names, local_types, local_type_ids, table)
                        return InferType{kind: SemTypeKind.Container, name: "sview"} if object_type.kind == SemTypeKind.String
                        return InferType{kind: SemTypeKind.Container, name: "view"} if object_type.kind == SemTypeKind.Container and object_type.name in {"array", "darray", "view"}
                        return primitive_type(SemTypeKind.Unknown)
                    _:
                        return primitive_type(SemTypeKind.Unknown)

        def affine_call_argument_map(parameters: darray[Ast::ParamDecl]&, function_line: Ast::Pos, declaration_module: sview @source, current_module: sview @source, call_pos: Ast::Pos, caller_line: Ast::Pos, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, wanted_position: usize, local_names: darray[sview]&, local_types: darray[sview @source]&, local_type_ids: darray[u32]&, table: mutable SymbolTable&) -> (accepted: bool, argument_index: usize, exact: bool):
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                return (false, arguments.count, false) if argument_names.count != arguments.count
                variadic: bool = any annotation in annotations where annotation.owner == "__variadic" and annotation.line == function_line.line and annotation.offset == function_line.offset
                parameter_arguments: mutable darray[usize] = []
                for _ in 0..<parameters.count |parameter_arguments|:
                    parameter_arguments.push(arguments.count)
                next_positional: mutable usize = 0
                exact: mutable bool = true
                generic_names: mutable darray[sview @source] = []
                generic_actuals: mutable darray[u32] = []
                region_formals: mutable darray[u32] = []
                region_actuals: mutable darray[u32] = []
                for argument_index in 0..<arguments.count |parameter_arguments, next_positional, generic_names, generic_actuals, region_formals, region_actuals, arguments, argument_names, parameters, caller_line, table|:
                    slot: mutable usize = parameters.count
                    if argument_names[argument_index] != "":
                        match_count: mutable usize = 0
                        for parameter_index in 0..<parameters.count |slot, match_count, parameters, argument_names, argument_index|:
                            if parameters[parameter_index].name == argument_names[argument_index]:
                                slot <- parameter_index
                                match_count <- match_count + 1
                        return (false, arguments.count, false) if match_count != 1
                    else:
                        while next_positional < parameters.count and parameter_arguments[next_positional] < arguments.count |next_positional, parameter_arguments|:
                            next_positional <- next_positional + 1
                        if next_positional >= parameters.count:
                            return (false, arguments.count, false) if not variadic
                            continue
                        slot <- next_positional
                        next_positional <- next_positional + 1
                    return (false, arguments.count, false) if parameter_arguments[slot] < arguments.count
                    return (false, arguments.count, false) if not affine_call_argument_can_match(arguments[argument_index], parameters[slot].type_expression, declaration_module, function_line, current_module, caller_line, call_pos, generic_names, generic_actuals, region_formals, region_actuals, annotations, local_names, local_types, local_type_ids, table)
                    exact <- false if not affine_call_argument_is_exact(arguments[argument_index], parameters[slot].type_expression, declaration_module, function_line, current_module, caller_line, call_pos, annotations, local_names, local_types, local_type_ids, table)
                    parameter_arguments[slot] <- argument_index
                for parameter_index in 0..<parameters.count |parameter_arguments, parameters|:
                    return (false, arguments.count, false) if parameter_arguments[parameter_index] == arguments.count and not parameters[parameter_index].has_default
                selected_argument: usize = parameter_arguments[wanted_position] if wanted_position < parameters.count else arguments.count
                return (true, selected_argument, exact)

        def affine_extern_call_argument_map(param_start: u32, arity: u32, variadic: bool, function_line: Ast::Pos, declaration_module: sview @source, current_module: sview @source, caller_line: Ast::Pos, annotations: darray[Ast::EnumAnnotation]&, parameters: darray[Ast::ExternParam]&, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, wanted_position: usize, local_names: darray[sview]&, local_types: darray[sview @source]&, local_type_ids: darray[u32]&, table: mutable SymbolTable&) -> (accepted: bool, argument_index: usize, exact: bool):
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                parameter_count: usize = arity.usize()
                return (false, arguments.count, false) if argument_names.count != arguments.count
                parameter_arguments: mutable darray[usize] = []
                for _ in 0..<parameter_count |parameter_arguments|:
                    parameter_arguments.push(arguments.count)
                next_positional: mutable usize = 0
                exact: mutable bool = true
                for argument_index in 0..<arguments.count |parameter_arguments, next_positional, arguments, argument_names, parameters, param_start, parameter_count, variadic, caller_line, current_module, annotations, local_names, local_types, local_type_ids, table|:
                    slot: mutable usize = parameter_count
                    if argument_names[argument_index] != "":
                        match_count: mutable usize = 0
                        for parameter_index in 0..<parameter_count |slot, match_count, parameters, param_start, argument_names, argument_index|:
                            parameter_slot: usize = param_start.usize() + parameter_index
                            if parameter_slot < parameters.count and parameters[parameter_slot].name == argument_names[argument_index]:
                                slot <- parameter_index
                                match_count <- match_count + 1
                        return (false, arguments.count, false) if match_count != 1
                    else:
                        while next_positional < parameter_count and parameter_arguments[next_positional] < arguments.count |next_positional, parameter_arguments|:
                            next_positional <- next_positional + 1
                        if next_positional >= parameter_count:
                            return (false, arguments.count, false) if not variadic
                            continue
                        slot <- next_positional
                        next_positional <- next_positional + 1
                    return (false, arguments.count, false) if parameter_arguments[slot] < arguments.count
                    actual_id: u32 = affine_call_argument_type_id(arguments[argument_index], current_module, caller_line, annotations, local_names, local_types, local_type_ids, table)
                    return (false, arguments.count, false) if type_id_contains_function_generic(actual_id, caller_line.line, caller_line.offset, table)
                    parameter_slot: usize = param_start.usize() + slot
                    return (false, arguments.count, false) if parameter_slot < parameters.count and parameters[parameter_slot].type_name != "" and not affine_call_argument_can_match_name(arguments[argument_index], parameters[parameter_slot].type_name, declaration_module, function_line, current_module, caller_line, annotations, local_names, local_types, local_type_ids, table)
                    exact <- false if parameter_slot >= parameters.count or not affine_call_argument_is_exact_name(arguments[argument_index], parameters[parameter_slot].type_name, declaration_module, function_line, current_module, caller_line, annotations, local_names, local_types, local_type_ids, table)
                    parameter_arguments[slot] <- argument_index
                return (false, arguments.count, false) if arguments.count < parameter_count
                selected_argument: usize = parameter_arguments[wanted_position] if wanted_position < parameter_count else arguments.count
                return (true, selected_argument, exact)

        def affine_call_declaration_is_generic(line: u32, offset: u32, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return true if table.generic_param_lines.count != table.generic_param_names.count or table.generic_param_lines.count != table.generic_param_owner_offsets.count
                for row in 0..<table.generic_param_lines.count |line, offset, table|:
                    continue if table.generic_param_lines[row] >= 2147483648
                    return true if table.generic_param_lines[row] == line and table.generic_param_owner_offsets[row] == offset
                return true if any annotation in annotations where annotation.owner == "__errorset_param" and annotation.line == line and annotation.offset == offset
                return false

        def affine_callable_symbol_visible(table: SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, name: sview @source, candidate_module: sview @source, declaration_line: u32, declaration_offset: u32, lexical_module: sview @source, wanted_kind: SymbolKind) -> bool:
            can Abort.Panic:
                for symbol in table.symbols |table, annotations, name, candidate_module, declaration_line, declaration_offset, lexical_module, wanted_kind|:
                    continue if symbol.kind != wanted_kind or symbol.name != name or symbol.module_owner != candidate_module or symbol.line != declaration_line or symbol.offset != declaration_offset
                    return callable_function_declaration_visible(table.visibility_annotations, name, candidate_module, declaration_line, declaration_offset, lexical_module)
                return false

        def affine_call_lookup_module(table: mutable SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, function_name: sview @source, lexical_module: sview @source, selected_module: mutable sview& @source) -> bool:
            can Abort.Panic:
                module_scope: mutable sview = lexical_module
                while true |module_scope, table, annotations, function_name, selected_module|:
                    cursor: mutable u32 = symbol_chain_head(table, function_name)
                    while cursor != 4294967295 |cursor, module_scope, table, annotations, function_name, selected_module, lexical_module|:
                        symbol: Symbol = table.symbols[cursor.usize()]
                        if symbol.name == function_name and symbol.module_owner == module_scope and symbol.kind == SymbolKind.Func and callable_function_declaration_visible(table.visibility_annotations, function_name, module_scope, symbol.line, symbol.offset, lexical_module):
                            selected_module <- module_scope
                            return true
                        cursor <- table.symbol_name_next[cursor.usize()]
                    break if module_scope == ""
                    module_scope <- try_noncall_module_parent(module_scope)
                return affine_call_lookup_imported_module(table, annotations, function_name, lexical_module, selected_module)

        def affine_call_lookup_imported_module(table: mutable SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, function_name: sview @source, lexical_module: sview @source, selected_module: mutable sview& @source) -> bool:
            can Memory.Allocate, Abort.Panic:
                candidate_modules: mutable darray[sview @source] = []
                cursor: mutable u32 = symbol_chain_head(table, function_name)
                while cursor != 4294967295 |candidate_modules, cursor, table, annotations, function_name, lexical_module|:
                    symbol: Symbol = table.symbols[cursor.usize()]
                    if symbol.kind == SymbolKind.Func and symbol.name == function_name and callable_function_declaration_visible(table.visibility_annotations, function_name, symbol.module_owner, symbol.line, symbol.offset, lexical_module):
                        wildcard: (found: bool, matches: bool) = callable_first_wildcard_imported_row(annotations, table, function_name, symbol.module_owner, lexical_module)
                        import_visible: bool = wildcard.matches if wildcard.found else callable_program_selective_import_row_visible(annotations, function_name, symbol.module_owner, lexical_module)
                        if import_visible and not (any candidate_module in candidate_modules where candidate_module == symbol.module_owner):
                            module_owner_bytes: mutable darray[u8] = []
                            module_owner_bytes.reserve(symbol.module_owner.len)
                            for byte_position in 0..<symbol.module_owner.len |module_owner_bytes, symbol|:
                                module_owner_bytes.push(symbol.module_owner[byte_position])
                            interned_module_owner: sview @source = intern_joined_text(module_owner_bytes, table)
                            candidate_modules.push(interned_module_owner)
                    cursor <- table.symbol_name_next[cursor.usize()]
                return false if candidate_modules.count != 1
                selected_module <- candidate_modules[0]
                return true

        def affine_call_qualifier_path(expression: Ast::Expr, table: mutable SymbolTable&) -> sview @source:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        return name
                    Expr.Scope(base, name, _):
                        prefix: sview = affine_call_qualifier_path(base, table)
                        return "" if prefix == ""
                        bytes: mutable darray[u8] = []
                        bytes.reserve(prefix.len + 2.usize() + name.len)
                        for offset in 0..<prefix.len |bytes, prefix|:
                            bytes.push(prefix[offset])
                        bytes.push(58)
                        bytes.push(58)
                        for offset in 0..<name.len |bytes, name|:
                            bytes.push(name[offset])
                        return intern_joined_text(bytes, table)
                    Expr.Paren(inner, _):
                        return affine_call_qualifier_path(inner, table)
                    _:
                        return ""

        def affine_call_lookup_qualified_module(table: mutable SymbolTable&, annotations: darray[Ast::EnumAnnotation]&, function_name: sview @source, qualifier: Ast::Expr, lexical_module: sview @source, selected_module: mutable sview& @source) -> bool:
            can Memory.Allocate, Abort.Panic:
                qualifier_path: sview = affine_call_qualifier_path(qualifier, table)
                return false if qualifier_path == ""
                cursor: mutable u32 = symbol_chain_head(table, function_name)
                while cursor != 4294967295 |cursor, table, annotations, function_name, qualifier_path, lexical_module, selected_module|:
                    symbol: Symbol = table.symbols[cursor.usize()]
                    if symbol.kind == SymbolKind.Func and symbol.name == function_name and callable_function_declaration_visible(table.visibility_annotations, function_name, symbol.module_owner, symbol.line, symbol.offset, lexical_module) and callable_qualified_module_matches_candidate(annotations, symbol.module_owner, lexical_module, qualifier_path, function_name, table):
                        selected_module <- symbol.module_owner
                        return true
                    cursor <- table.symbol_name_next[cursor.usize()]
                return false

        # Resolve a qualified call's return TypeId only when the qualifier selects one
        # visible module and that module has one declaration for the leaf name. Same-leaf
        # functions in other modules do not make this call ambiguous; same-module overloads
        # do, because this structural inference path does not have enough information to
        # choose their declaration safely.
        def affine_call_qualified_return_type_id(qualifier: Ast::Expr, function_name: sview @source, lexical_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&) -> u32:
            can Memory.Allocate, Abort.Panic:
                selected_module: mutable sview @source = ""
                return 0 if not affine_call_lookup_qualified_module(table, annotations, function_name, qualifier, lexical_module, selected_module)
                selected_return_id: mutable u32 = 0
                declarations: mutable usize = 0
                cursor: mutable u32 = symbol_chain_head(table, function_name)
                while cursor != 4294967295 |cursor, selected_module, selected_return_id, declarations, annotations, function_name, lexical_module, table|:
                    symbol: Symbol = table.symbols[cursor.usize()]
                    if symbol.kind == SymbolKind.Func and symbol.name == function_name and symbol.module_owner == selected_module and callable_function_declaration_visible(table.visibility_annotations, function_name, symbol.module_owner, symbol.line, symbol.offset, lexical_module):
                        declarations <- declarations + 1
                        return 0 if declarations > 1
                        selected_return_id <- symbol.return_type_id
                        return 0 if type_id_contains_function_generic(selected_return_id, symbol.line, symbol.offset, table) or type_id_contains_region(selected_return_id, table)
                    cursor <- table.symbol_name_next[cursor.usize()]
                return selected_return_id if declarations == 1
                return 0

        # Bare calls also need a scope-aware declaration choice. A global leaf-name
        # lookup turns a unique lexical/imported function into Unknown whenever an
        # unrelated module declares the same leaf, which can hide a firm argument type
        # from affine overload/postcondition selection.
        def affine_call_unqualified_return_type_id(function_name: sview @source, lexical_module: sview @source, annotations: darray[Ast::EnumAnnotation]&, table: mutable SymbolTable&) -> u32:
            can Memory.Allocate, Abort.Panic:
                selected_module: mutable sview @source = ""
                return 0 if not affine_call_lookup_module(table, annotations, function_name, lexical_module, selected_module)
                selected_return_id: mutable u32 = 0
                declarations: mutable usize = 0
                cursor: mutable u32 = symbol_chain_head(table, function_name)
                while cursor != 4294967295 |cursor, selected_module, selected_return_id, declarations, annotations, function_name, lexical_module, table|:
                    symbol: Symbol = table.symbols[cursor.usize()]
                    if symbol.kind == SymbolKind.Func and symbol.name == function_name and symbol.module_owner == selected_module and callable_function_declaration_visible(table.visibility_annotations, function_name, symbol.module_owner, symbol.line, symbol.offset, lexical_module):
                        declarations <- declarations + 1
                        return 0 if declarations > 1
                        selected_return_id <- symbol.return_type_id
                        return 0 if type_id_contains_function_generic(selected_return_id, symbol.line, symbol.offset, table) or type_id_contains_region(selected_return_id, table)
                    cursor <- table.symbol_name_next[cursor.usize()]
                return selected_return_id if declarations == 1
                return 0

        def affine_call_function_name(callee: Ast::Expr) -> sview:
            can Abort.Panic:
                match callee:
                    Expr.Ident(name, _):
                        return name
                    Expr.Scope(_, name, _):
                        return name
                    Expr.Paren(inner, _):
                        return affine_call_function_name(inner)
                    _:
                        return ""

        # Candidate declarations are matched to exact Symbol rows, then restricted to the
        # nearest visible lexical module. Unrelated modules and unresolved imports cannot make a
        # selected local call ambiguous. A selected declaration's `(line, offset)` is retained
        # for the final postcondition join.
        def affine_call_candidate_count(declarations: darray[Ast::Decl], declaration_module: sview @source, selected_module: sview @source, function_name: sview @source, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, extern_params: darray[Ast::ExternParam]&, wanted_position: usize, current_module: sview @source, call_pos: Ast::Pos, caller_line: Ast::Pos, local_names: darray[sview]&, local_types: darray[sview @source]&, local_type_ids: darray[u32]&, exact_only: bool, selected_line: mutable u32&, selected_offset: mutable u32&, selected_argument_index: mutable usize&, table: mutable SymbolTable&) -> usize:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                count: mutable usize = 0
                for declaration in declarations |count, declaration_module, selected_line, selected_offset, selected_argument_index, caller_line, table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            mapped: (accepted: bool, argument_index: usize, exact: bool) = affine_call_argument_map(params, line, declaration_module, current_module, call_pos, caller_line, arguments, argument_names, annotations, wanted_position, local_names, local_types, local_type_ids, table) if name == function_name and declaration_module == selected_module else (false, arguments.count, false)
                            if mapped.accepted and (not exact_only or (mapped.exact and not affine_call_declaration_is_generic(line.line, line.offset, annotations, table))) and affine_callable_symbol_visible(table, annotations, name, declaration_module, line.line, line.offset, selected_module, SymbolKind.Func):
                                count <- count + 1
                                selected_line <- line.line
                                selected_offset <- line.offset
                                selected_argument_index <- mapped.argument_index
                        Decl.Extern(name, param_start, arity, variadic, callable, _, _, line):
                            mapped: (accepted: bool, argument_index: usize, exact: bool) = affine_extern_call_argument_map(param_start, arity, variadic, line, declaration_module, current_module, caller_line, annotations, extern_params, arguments, argument_names, wanted_position, local_names, local_types, local_type_ids, table) if name == function_name and declaration_module == selected_module and callable else (false, arguments.count, false)
                            if mapped.accepted and (not exact_only or (mapped.exact and not affine_call_declaration_is_generic(line.line, line.offset, annotations, table))) and affine_callable_symbol_visible(table, annotations, name, declaration_module, line.line, line.offset, selected_module, SymbolKind.Func):
                                count <- count + 1
                                selected_line <- line.line
                                selected_offset <- line.offset
                                selected_argument_index <- mapped.argument_index
                        Decl.Scoped(body, line):
                            count <- count + affine_call_candidate_count(body, declaration_module, selected_module, function_name, arguments, argument_names, annotations, extern_params, wanted_position, current_module, call_pos, caller_line, local_names, local_types, local_type_ids, exact_only, selected_line, selected_offset, selected_argument_index, table)
                        Decl.Module(module_name, body, line):
                            count <- count + affine_call_candidate_count(body, module_name, selected_module, function_name, arguments, argument_names, annotations, extern_params, wanted_position, current_module, call_pos, caller_line, local_names, local_types, local_type_ids, exact_only, selected_line, selected_offset, selected_argument_index, table)
                        _:
                            pass
                return count

        def affine_call_postcondition_argument_index(current_module: sview @source, file: Ast::File&, callee: Ast::Expr, call_line: Ast::Pos, caller_line: Ast::Pos, names: darray[sview]&, local_types: darray[sview @source]&, local_type_ids: darray[u32]&, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, position: usize, table: mutable SymbolTable&) -> usize:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                function_name: sview = affine_call_function_name(callee)
                return arguments.count if function_name == "" or argument_names.count != arguments.count
                return arguments.count if any marker in file.enum_annotations where marker.offset == call_line.offset and (marker.owner == "__arg_forward" or marker.owner == "__try_callee_argument_forward")
                selected_module: mutable sview @source = ""
                found_module: mutable bool = false
                match callee:
                    Expr.Ident(_, _):
                        return arguments.count if any local_name in names where local_name == function_name
                        found_module <- affine_call_lookup_module(table, file.enum_annotations, function_name, current_module, selected_module)
                    Expr.Scope(qualifier, _, _):
                        found_module <- affine_call_lookup_qualified_module(table, file.enum_annotations, function_name, qualifier, current_module, selected_module)
                    Expr.Paren(inner, _):
                        return affine_call_postcondition_argument_index(current_module, file, inner, call_line, caller_line, names, local_types, local_type_ids, arguments, argument_names, position, table)
                    _:
                        return arguments.count
                return arguments.count if not found_module
                selected_line: mutable u32 = 0
                selected_offset: mutable u32 = 0
                selected_argument_index: mutable usize = arguments.count
                candidates: mutable usize = affine_call_candidate_count(file.top_decls, "", selected_module, function_name, arguments, argument_names, file.enum_annotations, file.extern_params, position, current_module, call_line, caller_line, names, local_types, local_type_ids, true, selected_line, selected_offset, selected_argument_index, table)
                if candidates == 0:
                    selected_line <- 0
                    selected_offset <- 0
                    selected_argument_index <- arguments.count
                    candidates <- affine_call_candidate_count(file.top_decls, "", selected_module, function_name, arguments, argument_names, file.enum_annotations, file.extern_params, position, current_module, call_line, caller_line, names, local_types, local_type_ids, false, selected_line, selected_offset, selected_argument_index, table)
                return arguments.count if candidates != 1
                return arguments.count if not (any postcondition in file.typestate_postconditions where postcondition.function_name == function_name and postcondition.line == selected_line and postcondition.function_offset == selected_offset and postcondition.position.usize() == position)
                return selected_argument_index
