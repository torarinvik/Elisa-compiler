# Bulk copies into a darray whose element holds a linear handle. stage0
# (analyzer_expr_builtin_collections) refuses both spellings, because a bulk copy
# duplicates every handle in the source:
#
#   ys.extend(xs)      "darray extend does not support affine element type T; ..."
#   ys.push(xs)        "bulk darray push does not support affine element type T; ..."
#   ys.push([move h])
#   [...xs]            "spread darray literal does not support affine element type T; ..."
#
# A push is BULK when its argument is not assignable to the element but is a container
# of it. stage1 decides that syntactically: a list literal, unless the element is itself
# a container (`t.push([])` on `darray[darray[Handle]]` pushes one empty element), or a
# local/param whose darray or fixed-array element is spelled the same as the receiver's.
# Receivers and sources are the function's locals and params, or a field chain rooted at
# one (`b.items.extend(xs)`, `[...self.bag.items]`): each field's declared type comes from
# the struct rows, so a non-generic struct field resolves like a local.
extend Semantic:
    private:
        # Every struct field's declared type as parallel (struct, field, type) rows.
        struct BulkFieldRows:
            structs: mutable darray[sview]
            fields: mutable darray[sview]
            types: mutable darray[Ast::Expr]

        # The element type of a `darray[E]` (`mutable`-wrapped ok) or a fixed array `E[N]`.
        def bulk_container_element(type_expression: Ast::Expr) -> Ast::Expr?:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(head, argument, index_line):
                        if ident_name_of(head) == "darray":
                            return argument
                        match argument:
                            Expr.IntLit(extent, extent_line):
                                return head
                            _:
                                return null
                    Expr.IndexN(head, arguments, index_n_line):
                        if ident_name_of(head) == "darray" and arguments.count > 0:
                            return arguments[0]
                        return null
                    Expr.Unary(operator, operand, unary_line):
                        if operator == TokenKind.Mutable:
                            return bulk_container_element(operand)
                        return null
                    Expr.Paren(inner, paren_line):
                        return bulk_container_element(inner)
                    _:
                        return null

        # Whether a type is a container a list literal could initialise (`darray[...]`, `E[N]`).
        def bulk_type_is_container(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                element_opt: Ast::Expr? = bulk_container_element(type_expression)
                if element_opt is element:
                    return true
                return false

        # Stage0's spelling of a type into OUT, or false when it cannot be spelled.
        def bulk_spelling(type_expression: Ast::Expr, out: mutable darray[u8]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return affine_type_render(type_expression, out)

        def bulk_same_spelling(left: Ast::Expr, right: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                left_bytes: mutable darray[u8] = []
                right_bytes: mutable darray[u8] = []
                false return if not bulk_spelling(left, &left_bytes)
                false return if not bulk_spelling(right, &right_bytes)
                false return if left_bytes.count != right_bytes.count
                for offset in 0..<left_bytes.count |left_bytes, right_bytes|:
                    false return if left_bytes[offset] != right_bytes[offset]
                return true

        def bulk_collect_locals(statements: darray[Ast::Stmt], out_names: mutable darray[sview]&, out_types: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out_names, out_types|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            out_names.push(name)
                            out_types.push(type_expression)
                        Stmt.If(condition, then_body, else_body, line):
                            bulk_collect_locals(then_body, out_names, out_types)
                            bulk_collect_locals(else_body, out_names, out_types)
                        Stmt.While(condition, while_body, while_line):
                            bulk_collect_locals(while_body, out_names, out_types)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            bulk_collect_locals(for_body, out_names, out_types)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            bulk_collect_locals(body, out_names, out_types)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |out_names, out_types|:
                                bulk_collect_locals(arm.body, out_names, out_types)
                        _:
                            pass

        # The declared type of NAME among the collected containers (the last declaration wins).
        def bulk_type_of(names: darray[sview]&, types: darray[Ast::Expr]&, name: sview) -> Ast::Expr?:
            can Abort.Panic:
                found: mutable Ast::Expr? = null
                for probe in 0..<names.count |found|:
                    found <- types[probe] if names[probe] == name
                return found

        # The local a bulk argument names: `xs`, `move xs` or `(xs)`; "" otherwise.
        def bulk_argument_local(argument: Ast::Expr) -> sview:
            can Abort.Panic:
                return match argument:
                    Expr.Ident(argument_name, argument_line): argument_name
                    Expr.Move(moved, moved_line): bulk_argument_local(moved)
                    Expr.Paren(inner, paren_line): bulk_argument_local(inner)
                    Expr.Field(object, field, field_line): field
                    _: ""

        # The struct a declared type names through `mutable`/`&`/`lmut` wrappers; "" otherwise
        # (generic structs are not resolved).
        def bulk_struct_owner(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        bulk_struct_owner(operand) return if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut
                        return ""
                    Expr.Paren(inner, paren_line):
                        return bulk_struct_owner(inner)
                    Expr.Ident(type_name, ident_line):
                        return type_name
                    _:
                        return ""

        # The declared type of a bulk operand: a local/param (`xs`, `move xs`, `(xs)`) or a
        # field chain rooted at one (`b.items`, `self.bag.items`), via the struct field rows.
        def bulk_operand_type(operand: Ast::Expr, names: darray[sview]&, types: darray[Ast::Expr]&, rows: BulkFieldRows&) -> Ast::Expr?:
            can Memory.Allocate, Abort.Panic:
                match operand:
                    Expr.Ident(operand_name, ident_line):
                        return bulk_type_of(names, types, operand_name)
                    Expr.Move(moved, moved_line):
                        return bulk_operand_type(moved, names, types, rows)
                    Expr.Paren(inner, paren_line):
                        return bulk_operand_type(inner, names, types, rows)
                    Expr.Field(object, field, field_line):
                        object_type_opt: Ast::Expr? = bulk_operand_type(object, names, types, rows)
                        if object_type_opt is object_type:
                            owner: sview = bulk_struct_owner(object_type)
                            if owner != "":
                                found: Ast::Expr = struct_law_field_type_of(owner, field, rows.structs, rows.fields, rows.types)
                                null return if found is Ast::Expr.Absent
                                return found
                        return null
                    _:
                        return null

        # Whether a push ARGUMENT is a whole container of ELEMENT rather than one element.
        def bulk_push_argument(argument: Ast::Expr, element: Ast::Expr, names: darray[sview]&, types: darray[Ast::Expr]&, rows: BulkFieldRows&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Array(elements, array_line):
                        return not bulk_type_is_container(element)
                    _:
                        source_type_opt: Ast::Expr? = bulk_operand_type(argument, names, types, rows)
                        if source_type_opt is source_type:
                            if bulk_container_element(source_type) is source_element:
                                return bulk_same_spelling(source_element, element)
                        return false

        # Report a bulk copy in one statement expression: `recv.extend(a)` / bulk `recv.push(a)`.
        def bulk_check_call(expression: Ast::Expr, names: darray[sview]&, types: darray[Ast::Expr]&, rows: BulkFieldRows&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Paren(inner, paren_line):
                        table <- bulk_check_call(inner, names, types, rows, table) can Global{Read,Write}
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match callee:
                            Expr.Field(receiver, method, field_line):
                                receiver_name: sview = bulk_argument_local(receiver)
                                tracked: bool = receiver_name != "" and arguments.count == 1 and (method == "extend" or method == "push")
                                receiver_type_opt: Ast::Expr? = bulk_operand_type(receiver, names, types, rows) if tracked else null
                                if receiver_type_opt is receiver_type:
                                    if darray_holds_linear(receiver_type, table):
                                        if bulk_container_element(receiver_type) is element:
                                            if method == "extend" or bulk_push_argument(arguments[0], element, names, types, rows):
                                                spelling: mutable darray[u8] = []
                                                rendered: bool = bulk_spelling(element, &spelling)
                                                # A Diagnostic outlives the table's text_storage buffer (it rendered as other text,
                                                # e.g. 'got set ele'), so the spelling goes to permanent storage.
                                                text: sview = Parser::persist_name_bytes(&spelling, 0) can Global{Read,Write} if rendered and spelling.count > 0 else receiver_name
                                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineBulkCopy, name: receiver_name, pos: field_line, line: call_line.line, expected: method, actual: text})
                            _:
                                pass
                    _:
                        pass

        # Report every spread `[...xs]` / `[...move xs]` inside EXPRESSION whose source is a
        # tracked container of linear-holding elements. A spread is a bulk copy exactly like
        # `extend` (stage0 checks it with the same compatibility rule), so it duplicates every
        # handle in the source. stage0's list-literal analysis rejects it with the same
        # containsAffineHandleValues test it applies to `extend`.
        def bulk_check_spreads(expression: Ast::Expr, names: darray[sview]&, types: darray[Ast::Expr]&, rows: BulkFieldRows&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Array(elements, array_line):
                        # Each report's spelling goes to permanent storage: a Diagnostic outlives
                        # the table's text_storage buffer.
                        report_names: mutable darray[sview] = []
                        report_positions: mutable darray[Ast::Pos] = []
                        report_texts: mutable darray[sview] = []
                        for element in elements |table, report_names, report_positions, report_texts| -> table:
                            match element:
                                Expr.Unary(operator, operand, unary_line):
                                    if operator == TokenKind.Ellipsis:
                                        source: sview = bulk_argument_local(operand)
                                        source_type_opt: Ast::Expr? = bulk_operand_type(operand, names, types, rows)
                                        if source_type_opt is source_type:
                                            if darray_holds_linear(source_type, table) or bulk_fixed_holds_linear(source_type, table):
                                                if bulk_container_element(source_type) is source_element:
                                                    spelling: mutable darray[u8] = []
                                                    rendered: bool = bulk_spelling(source_element, &spelling)
                                                    report_names.push(source)
                                                    report_positions.push(Ast::expr_pos(operand))
                                                    report_texts.push((Parser::persist_name_bytes(&spelling, 0) can Global{Read,Write}) if rendered and spelling.count > 0 else source)
                                    table <- bulk_check_spreads(operand, names, types, rows, table) can Global{Read,Write}
                                _:
                                    table <- bulk_check_spreads(element, names, types, rows, table) can Global{Read,Write}
                        for report in 0..<report_names.count |table, report_names, report_positions, report_texts| -> table:
                            spread_pos: Ast::Pos = report_positions[report]
                            text: sview = report_texts[report]
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineBulkCopy, name: report_names[report], pos: spread_pos, line: spread_pos.line, expected: "spread", actual: text})
                    Expr.Call(callee, arguments, argument_names, call_line):
                        table <- bulk_check_spreads(callee, names, types, rows, table) can Global{Read,Write}
                        for argument in arguments |table| -> table:
                            table <- bulk_check_spreads(argument, names, types, rows, table) can Global{Read,Write}
                    Expr.Field(object, field, field_line):
                        table <- bulk_check_spreads(object, names, types, rows, table) can Global{Read,Write}
                    Expr.Paren(inner, paren_line):
                        table <- bulk_check_spreads(inner, names, types, rows, table) can Global{Read,Write}
                    Expr.Move(inner, move_line):
                        table <- bulk_check_spreads(inner, names, types, rows, table) can Global{Read,Write}
                    Expr.Unary(operator, inner, unary_line):
                        table <- bulk_check_spreads(inner, names, types, rows, table) can Global{Read,Write}
                    Expr.Binary(left, operator, right, binary_line):
                        table <- bulk_check_spreads(left, names, types, rows, table) can Global{Read,Write}
                        table <- bulk_check_spreads(right, names, types, rows, table) can Global{Read,Write}
                    Expr.Tuple(elements, tuple_line):
                        for element in elements |table| -> table:
                            table <- bulk_check_spreads(element, names, types, rows, table) can Global{Read,Write}
                    Expr.Construct(type_expression, fields, construct_line):
                        for field in fields |table| -> table:
                            table <- bulk_check_spreads(field.value, names, types, rows, table) can Global{Read,Write}
                    Expr.If(condition, then_value, else_value, if_line):
                        table <- bulk_check_spreads(then_value, names, types, rows, table) can Global{Read,Write}
                        table <- bulk_check_spreads(else_value, names, types, rows, table) can Global{Read,Write}
                    _:
                        pass

        # Whether a fixed array type `E[N]` holds linear handles (darray_holds_linear covers darray).
        def bulk_fixed_holds_linear(type_expression: Ast::Expr, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(head, argument, index_line):
                        match argument:
                            Expr.IntLit(extent, extent_line):
                                return affine_type_contains_handles(head, table)
                            _:
                                return false
                    Expr.Unary(operator, operand, unary_line):
                        false return if operator == TokenKind.Ampersand
                        return bulk_fixed_holds_linear(operand, table)
                    Expr.Paren(inner, paren_line):
                        return bulk_fixed_holds_linear(inner, table)
                    _:
                        return false

        def bulk_walk(statements: darray[Ast::Stmt], names: darray[sview]&, types: darray[Ast::Expr]&, rows: BulkFieldRows&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- bulk_check_call(expression, names, types, rows, table) can Global{Read,Write}
                            table <- bulk_check_spreads(expression, names, types, rows, table) can Global{Read,Write}
                        Stmt.VarDecl(declared_name, declared_type, declared_value, declared_line):
                            table <- bulk_check_spreads(declared_value, names, types, rows, table) can Global{Read,Write}
                        Stmt.Assign(assign_target, assign_operator, assign_value, assign_line):
                            table <- bulk_check_spreads(assign_value, names, types, rows, table) can Global{Read,Write}
                        Stmt.Return(returned_opt, return_line):
                            if returned_opt is returned:
                                table <- bulk_check_spreads(returned, names, types, rows, table) can Global{Read,Write}
                        Stmt.If(condition, then_body, else_body, line):
                            table <- bulk_walk(then_body, names, types, rows, table) can Global{Read,Write}
                            table <- bulk_walk(else_body, names, types, rows, table) can Global{Read,Write}
                        Stmt.While(condition, while_body, while_line):
                            table <- bulk_walk(while_body, names, types, rows, table) can Global{Read,Write}
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- bulk_walk(for_body, names, types, rows, table) can Global{Read,Write}
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- bulk_walk(body, names, types, rows, table) can Global{Read,Write}
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |table| -> table:
                                table <- bulk_walk(arm.body, names, types, rows, table) can Global{Read,Write}
                        _:
                            pass

        def bulk_copy_funcs(declarations: darray[Ast::Decl], rows: BulkFieldRows&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            names: mutable darray[sview] = []
                            types: mutable darray[Ast::Expr] = []
                            for param in params |names, types|:
                                names.push(param.name)
                                types.push(param.type_expression)
                            bulk_collect_locals(body, names, types)
                            table <- bulk_walk(body, names, types, rows, table) can Global{Read,Write}
                        Decl.Module(module_name, module_body, module_line):
                            table <- bulk_copy_funcs(module_body, rows, table) can Global{Read,Write}
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- bulk_copy_funcs(scoped_body, rows, table) can Global{Read,Write}
                        _:
                            pass
