# A refined local initialised from a struct FIELD whose declared type carries no matching
# refinement cannot be proven: `y: i64 is Nat = s.x` where `s`'s struct field `x` is a bare
# `i64` (no `is Nat`) leaves the law unestablished. Complements check_local_refinement_unproven,
# whose is-Law path decides only bare-ident (parameter) sources and skips field accesses.
#
# SOUND SUBSET: the source must be `BASE.FIELD` where BASE is a local of a KNOWN struct type
# (declared annotation, or inferred from a call returning that struct), the field must exist,
# and its type must carry NO refinement naming the law. Any unknown — an unresolved base
# type, a missing field, or a refined field — leaves it silent (a sound miss).
extend Semantic:
    private:
        def fsr_struct_names(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, line):
                            out.push(name)
                        Decl.Module(module_name, module_body, module_line):
                            fsr_struct_names(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            fsr_struct_names(scoped_body, out)
                        _:
                            pass

        # Flat (owning struct, field name, field type) triples for every struct field.
        def fsr_collect_fields(declarations: darray[Ast::Decl], f_struct: mutable darray[sview]&, f_name: mutable darray[sview]&, f_type: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |f_struct, f_name, f_type|:
                    match declaration:
                        Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, line):
                            for member in members |f_struct, f_name, f_type, name|:
                                f_struct.push(name)
                                f_name.push(member.name)
                                f_type.push(member.type_expression)
                        Decl.Module(module_name, module_body, module_line):
                            fsr_collect_fields(module_body, f_struct, f_name, f_type)
                        Decl.Scoped(scoped_body, scoped_line):
                            fsr_collect_fields(scoped_body, f_struct, f_name, f_type)
                        _:
                            pass

        # Flat (owning struct, invariant expr) pairs for every struct invariant.
        def fsr_collect_invariants(declarations: darray[Ast::Decl], inv_struct: mutable darray[sview]&, inv_expr: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |inv_struct, inv_expr|:
                    match declaration:
                        Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, line):
                            for invariant in invariants |inv_struct, inv_expr, name|:
                                inv_struct.push(name)
                                inv_expr.push(invariant)
                        Decl.Module(module_name, module_body, module_line):
                            fsr_collect_invariants(module_body, inv_struct, inv_expr)
                        Decl.Scoped(scoped_body, scoped_line):
                            fsr_collect_invariants(scoped_body, inv_struct, inv_expr)
                        _:
                            pass

        # fn name -> the bare name of its return type, when that is a known struct.
        def fsr_collect_fn_returns(declarations: darray[Ast::Decl], struct_names: darray[sview]&, r_fn: mutable darray[sview]&, r_struct: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |struct_names, r_fn, r_struct|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            if return_type is present_return:
                                return_name: sview = bare_type_name(present_return)
                                if any s in struct_names where s == return_name:
                                    r_fn.push(name)
                                    r_struct.push(return_name)
                        Decl.Module(module_name, module_body, module_line):
                            fsr_collect_fn_returns(module_body, struct_names, r_fn, r_struct)
                        Decl.Scoped(scoped_body, scoped_line):
                            fsr_collect_fn_returns(scoped_body, struct_names, r_fn, r_struct)
                        _:
                            pass

        # The struct type a VALUE evaluates to: a construction `S{...}`, or a call to a
        # struct-returning function. "" when unknown.
        def fsr_value_struct(value: Ast::Expr, struct_names: darray[sview]&, r_fn: darray[sview]&, r_struct: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Call(callee, arguments, argument_names, line):
                        callee_name: sview = ident_name_of(callee)
                        probe: mutable usize = 0
                        while probe < r_fn.count |probe, callee_name, r_fn, r_struct|:
                            r_struct[probe] return if r_fn[probe] == callee_name
                            probe <- probe + 1
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        # Whether EXPRESSION references `self.FIELD` anywhere.
        def fsr_mentions_self_field(expression: Ast::Expr, field: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Field(object, member, field_line):
                        true return if ident_name_of(object) == "self" and member == field
                        return fsr_mentions_self_field(object, field)
                    Expr.Binary(left, operator, right, line):
                        return fsr_mentions_self_field(left, field) or fsr_mentions_self_field(right, field)
                    Expr.Unary(operator, operand, line):
                        return fsr_mentions_self_field(operand, field)
                    Expr.Paren(inner, line):
                        return fsr_mentions_self_field(inner, field)
                    _:
                        return false

        # Whether STRUCT_NAME declares an invariant constraining `self.FIELD` — conservatively
        # treated as possibly establishing the field's law (so a refined local from it is not
        # flagged; a sound over-exclusion).
        def fsr_field_has_invariant(struct_name: sview, field: sview, inv_struct: darray[sview]&, inv_expr: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                probe: mutable usize = 0
                while probe < inv_struct.count |probe, struct_name, field, inv_struct, inv_expr|:
                    true return if inv_struct[probe] == struct_name and fsr_mentions_self_field(inv_expr[probe], field)
                    probe <- probe + 1
                return false

        # Whether the field FIELD of struct STRUCT_NAME carries a refinement naming LAW.
        def fsr_field_establishes(struct_name: sview, field: sview, law: sview, f_struct: darray[sview]&, f_name: darray[sview]&, f_type: darray[Ast::Expr]&) -> (found: bool, establishes: bool):
            can Memory.Allocate, Abort.Panic:
                probe: mutable usize = 0
                while probe < f_struct.count |probe, struct_name, field, law, f_struct, f_name, f_type|:
                    (true, local_refinement_law_name(f_type[probe]) == law) return if f_struct[probe] == struct_name and f_name[probe] == field
                    probe <- probe + 1
                return (false, false)

        def fsr_check_statements(statements: darray[Ast::Stmt], local_names: mutable darray[sview]&, local_structs: mutable darray[sview]&, struct_names: darray[sview]&, r_fn: darray[sview]&, r_struct: darray[sview]&, f_struct: darray[sview]&, f_name: darray[sview]&, f_type: darray[Ast::Expr]&, inv_struct: darray[sview]&, inv_expr: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |local_names, local_structs, table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            law: sview = local_refinement_law_name(type_expression)
                            # A refined local from a `base.field` source.
                            if law != "" and value is Expr.Field(object, field, field_line):
                                base: sview = ident_name_of(object)
                                base_struct: mutable sview = ""
                                lookup: mutable usize = 0
                                while lookup < local_names.count |lookup, base, base_struct, local_names, local_structs|:
                                    base_struct <- local_structs[lookup] if local_names[lookup] == base
                                    lookup <- lookup + 1
                                if base_struct != "":
                                    verdict: (found: bool, establishes: bool) = fsr_field_establishes(base_struct, field, law, f_struct, f_name, f_type)
                                    invariant_covers: bool = fsr_field_has_invariant(base_struct, field, inv_struct, inv_expr)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LocalRefinementUnproven, name: law, line: line, expected: "", actual: name}) if verdict.found and not verdict.establishes and not invariant_covers
                            # Track this local's struct type (declared annotation or inferred).
                            declared_struct: sview = bare_type_name(type_expression)
                            if any s in struct_names where s == declared_struct:
                                local_names.push(name)
                                local_structs.push(declared_struct)
                            else:
                                inferred: sview = fsr_value_struct(value, struct_names, r_fn, r_struct)
                                if inferred != "":
                                    local_names.push(name)
                                    local_structs.push(inferred)
                        Stmt.Assign(target, operator, value, line):
                            # An untyped `s = make_any()` DECLARES s (stage1 grammar) — track
                            # its inferred struct type for a later field-source refinement.
                            assigned: sview = ident_name_of(target)
                            if assigned != "" and operator == TokenKind.Assign:
                                inferred_assign: sview = fsr_value_struct(value, struct_names, r_fn, r_struct)
                                if inferred_assign != "" and not (any n in local_names where n == assigned):
                                    local_names.push(assigned)
                                    local_structs.push(inferred_assign)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- fsr_check_statements(then_body, local_names, local_structs, struct_names, r_fn, r_struct, f_struct, f_name, f_type, inv_struct, inv_expr, table)
                            table <- fsr_check_statements(else_body, local_names, local_structs, struct_names, r_fn, r_struct, f_struct, f_name, f_type, inv_struct, inv_expr, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- fsr_check_statements(body, local_names, local_structs, struct_names, r_fn, r_struct, f_struct, f_name, f_type, inv_struct, inv_expr, table)
                        _:
                            pass

        def fsr_check_declarations(declarations: darray[Ast::Decl], struct_names: darray[sview]&, r_fn: darray[sview]&, r_struct: darray[sview]&, f_struct: darray[sview]&, f_name: darray[sview]&, f_type: darray[Ast::Expr]&, inv_struct: darray[sview]&, inv_expr: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            local_names: mutable darray[sview] = []
                            local_structs: mutable darray[sview] = []
                            for parameter in parameters |local_names, local_structs, struct_names|:
                                param_struct: sview = bare_type_name_through_ref(parameter.type_expression)
                                if any s in struct_names where s == param_struct:
                                    local_names.push(parameter.name)
                                    local_structs.push(param_struct)
                            table <- fsr_check_statements(body, local_names, local_structs, struct_names, r_fn, r_struct, f_struct, f_name, f_type, inv_struct, inv_expr, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- fsr_check_declarations(module_body, struct_names, r_fn, r_struct, f_struct, f_name, f_type, inv_struct, inv_expr, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- fsr_check_declarations(scoped_body, struct_names, r_fn, r_struct, f_struct, f_name, f_type, inv_struct, inv_expr, table)
                        _:
                            pass

        def check_field_source_refinement(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                struct_names: mutable darray[sview] = []
                fsr_struct_names(file.top_decls, struct_names)
                return if struct_names.count == 0
                f_struct: mutable darray[sview] = []
                f_name: mutable darray[sview] = []
                f_type: mutable darray[Ast::Expr] = []
                fsr_collect_fields(file.top_decls, f_struct, f_name, f_type)
                r_fn: mutable darray[sview] = []
                r_struct: mutable darray[sview] = []
                fsr_collect_fn_returns(file.top_decls, struct_names, r_fn, r_struct)
                inv_struct: mutable darray[sview] = []
                inv_expr: mutable darray[Ast::Expr] = []
                fsr_collect_invariants(file.top_decls, inv_struct, inv_expr)
                table <- fsr_check_declarations(file.top_decls, struct_names, r_fn, r_struct, f_struct, f_name, f_type, inv_struct, inv_expr, table)
