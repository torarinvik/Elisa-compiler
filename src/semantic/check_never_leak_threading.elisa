# never-leak lint (-Wnever-leak), category VALUE_THREAD: a statement that changes a value in
# place through a call and drops the call's result,
#
#     xs.push(seed)                 # instead of   xs <- xs.push(seed)
#
# where the value-threading spelling (STYLE_GUIDE.md section 6) says at the start of the line
# which value changes. The finding is a suggestion, never forced:
#
#   - REWRITABLE (both modes): an owned local `darray`/`dict` changed by a builtin method whose
#     value form compiles to the same machine code (`push`, `clear`, `put`; the builtin pairs in
#     test/fixtures/value_threading_pairs/). The driver prints the paste-ready rebinding.
#   - CANDIDATE (-Wnever-leak=strict only), with the reason no rewrite applies: the receiver is a
#     borrow, a field or element of a borrow, a global, or a local of a `region`/`in` block's
#     arena; or the call is a user function that takes an owned local as `mutable T&` and returns
#     nothing (side-effect-only: the rewrite needs a value form of that function first). The
#     driver adds NEVER_LEAK_VT_SHAPE when the statement spans several lines.
#
# A finding uses the shared NeverLeakFinding: `name` is the changed place as written (`s.items`),
# `bind_name` its root, `other_name` the method or function, `decl_line`/`last_use_line` the
# statement, `other_decl_line` the root's declaration (0 for a parameter or a global),
# `acc_reason` the reason, and names[acc_first ..< acc_first + 3] three texts: the root's
# declared type (or the `region NAME`/`in NAME` block of an arena local), the call with the
# `&` argument passed by value (side-effect-only), and the function's parameter name.
extend Semantic:
    public:
        const NEVER_LEAK_VALUE_THREAD: u8 = 7
        const NEVER_LEAK_VT_OK: u8 = 0
        const NEVER_LEAK_VT_BORROW: u8 = 1
        const NEVER_LEAK_VT_BORROWED_FIELD: u8 = 2
        const NEVER_LEAK_VT_GLOBAL: u8 = 3
        const NEVER_LEAK_VT_ARENA: u8 = 4
        const NEVER_LEAK_VT_EFFECT_ONLY: u8 = 5
        const NEVER_LEAK_VT_SHAPE: u8 = 6

    private:
        # The bindings one function's statements see so far, in declaration order (a later
        # declaration of the same name wins). kinds: 0 owned local, 1 borrow, 2 by-value
        # parameter.
        struct NlVtScope:
            names: mutable darray[sview]
            lines: mutable darray[u32]
            types: mutable darray[Ast::Expr]
            values: mutable darray[Ast::Expr]
            arenas: mutable darray[sview]
            kinds: mutable darray[u8]
            global_names: darray[sview]
            global_types: darray[Ast::Expr]
            function_name: sview

        def nl_vt_collect_globals(declarations: darray[Ast::Decl], names: mutable darray[sview]&, types: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, types|:
                    match declaration:
                        Decl.Const(const_name, const_type, _, const_mutable, _):
                            if const_mutable:
                                names.push(const_name)
                                types.push(const_type)
                        Decl.Module(_, module_body, _):
                            nl_vt_collect_globals(module_body, names, types)
                        Decl.Scoped(scoped_body, _):
                            nl_vt_collect_globals(scoped_body, names, types)
                        _:
                            pass

        def nl_vt_slot(bindings: NlVtScope&, name: sview) -> i64:
            can Abort.Panic:
                found: mutable i64 = -1
                for slot in 0..<bindings.names.count |found|:
                    found <- slot.i64() if bindings.names[slot] == name
                return found

        # A builtin method whose value form compiles to the in-place form's machine code.
        def nl_vt_builtin(method: sview, argument_count: usize) -> bool:
            return (method == "push" and argument_count == 1) or (method == "clear" and argument_count == 0) or (method == "put" and argument_count == 2)

        def nl_vt_owned_container(bindings: NlVtScope&, slot: usize) -> bool:
            can Abort.Panic:
                return true if vtc_container_type(bindings.types[slot])
                return bindings.types[slot] is Expr.Absent and bindings.values[slot] is Expr.Array(_, _)

        def nl_vt_push_texts(names: mutable darray[sview]&, name_lines: mutable darray[u32]&, first: sview, second: sview, third: sview) -> u32:
            can Memory.Allocate, Abort.Panic:
                at: u32 = names.count.u32()
                names.push(first)
                names.push(second)
                names.push(third)
                for _row in 0..<9 |name_lines|:
                    name_lines.push(0)
                return at

        def nl_vt_type_text(type_expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                bytes: mutable darray[u8] = []
                vtc_render_type(type_expression, &bytes)
                return Parser::persist_name_bytes(&bytes, 0)

        def nl_vt_report(bindings: NlVtScope&, place: Ast::Expr, root: sview, callee_name: sview, line: u32, reason: u8, decl_line: u32, texts: u32, findings: mutable darray[NeverLeakFinding]&) -> void:
            can Memory.Allocate, Abort.Panic:
                findings.push(NeverLeakFinding{name: vtc_text(place), category: NEVER_LEAK_VALUE_THREAD, function_name: bindings.function_name, decl_line: line, last_use_line: line, raw_last_use_line: line, bind_name: root, other_name: callee_name, other_decl_line: decl_line, acc_first: texts, acc_count: 3, acc_reason: reason})

        # `receiver.method(..)` as a statement.
        def nl_vt_method(bindings: NlVtScope&, receiver: Ast::Expr, method: sview, argument_count: usize, line: u32, findings: mutable darray[NeverLeakFinding]&, names: mutable darray[sview]&, name_lines: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if not nl_vt_builtin(method, argument_count)
                root: sview = Ast::value_thread_place_root(receiver)
                return if root == ""
                bare: bool = receiver is Expr.Ident(_, _)
                slot: i64 = nl_vt_slot(bindings, root)
                if slot >= 0:
                    index: usize = slot.usize()
                    if bindings.kinds[index] == 1:
                        return if bare and not vtc_container_type(bindings.types[index])
                        texts: u32 = nl_vt_push_texts(names, name_lines, nl_vt_type_text(bindings.types[index]), "", "")
                        nl_vt_report(bindings, receiver, root, method, line, NEVER_LEAK_VT_BORROW if bare else NEVER_LEAK_VT_BORROWED_FIELD, bindings.lines[index], texts, findings)
                        return
                    # A field of an owned struct is not reported: its value form is not one of
                    # the pairs the codegen smoke holds.
                    return if not bare or not nl_vt_owned_container(bindings, index)
                    reason: u8 = NEVER_LEAK_VT_ARENA if bindings.arenas[index] != "" else NEVER_LEAK_VT_OK
                    texts: u32 = nl_vt_push_texts(names, name_lines, bindings.arenas[index], "", "")
                    nl_vt_report(bindings, receiver, root, method, line, reason, bindings.lines[index], texts, findings)
                    return
                for global_index in 0..<bindings.global_names.count |findings, names, name_lines|:
                    if bindings.global_names[global_index] == root and bare and vtc_container_type(bindings.global_types[global_index]):
                        texts: u32 = nl_vt_push_texts(names, name_lines, nl_vt_type_text(bindings.global_types[global_index]), "", "")
                        nl_vt_report(bindings, receiver, root, method, line, NEVER_LEAK_VT_GLOBAL, 0, texts, findings)
                        return
