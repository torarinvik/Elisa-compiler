# Stage1 abstract-effect validation — the DECLARATION TABLES an effect row is checked against: is
# this family declared, is it a builtin permission family or a permission-set alias, does the
# named member exist, and is any operation declared twice. Continues check_abstract_effects.elisa.

extend Semantic:
    private:

        def ae_effect_declared(annotations: darray[Ast::EnumAnnotation]&, effect_name: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.owner == "__effect_decl" and annotation.name == effect_name



        def ae_effect_decl_line(annotations: darray[Ast::EnumAnnotation]&, effect_name: sview) -> u32:
            can Abort.Panic:
                for annotation in annotations:
                    return annotation.line if annotation.owner == "__effect_decl" and annotation.name == effect_name
                return 0



        def ae_builtin_permission_family(family: sview) -> bool:
            can Abort.Panic:
                return family in {"Progress", "Memory", "Abort", "Unsafe", "Sync", "Atomics", "Console", "Blocking", "Segment", "IO", "Time", "Panic", "Alloc", "Scalar", "ComplexFlow", "Global", "Thread", "Pool", "Parallel", "any"}



        def ae_permission_family_known(annotations: darray[Ast::EnumAnnotation]&, family: sview) -> bool:
            can Abort.Panic:
                return true if ae_builtin_permission_family(family)
                return any annotation in annotations where (annotation.owner == "__permission_decl" or annotation.owner == "__permission_param_decl" or annotation.owner == "__permission_alias") and annotation.name == family



        # Whether every member head of `alias NAME = A.x, B.y` (side-table rows with sentinel
        # line 3900000041, owner = alias, name = head family) names a known permission family
        # or a permission alias accepted earlier in the file. Such an alias is a legal effect
        # row on its own (`can FileIO:`, `extern f() can[IO]`), which stage0 accepts and which
        # stage1 refused as an unknown family — four cases in the internal suite
        # (`alias IO = Cap.Read, Cap.Write`; `alias FileIO = IO, Cap.Seek`).
        def ae_alias_is_permission_set(alias_name: sview, annotations: darray[Ast::EnumAnnotation]&, accepted: darray[Ast::EnumAnnotation]&) -> bool:
            can Abort.Panic:
                heads: mutable usize = 0
                for annotation in annotations |heads, alias_name, accepted|:
                    continue if annotation.line != 3900000041 or annotation.owner != alias_name
                    heads <- heads + 1
                    false return if not ae_permission_family_known(accepted, annotation.name)
                return heads > 0




        # A dotted effect row whose leading segment names a MODULE is a namespace access
        # written with the wrong separator, not an unknown permission or interface. Effect
        # rows legitimately use `.` for a concrete permission path (`Console.Write`), so the
        # spelling alone cannot decide it; only a head that actually names a module can. The
        # expression-position checks already teach this rule, and rows said nothing.
        def ae_effect_ref_head_is_module(family: sview, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                no_bindings: darray[sview] = []
                return family != "" and name_is_module(table, no_bindings, family)



        def ae_effect_ref_member(effect_ref: sview) -> sview:
            can Abort.Panic:
                dot: mutable usize = 0
                depth: mutable int = 0
                while dot < sview_len(effect_ref) |dot, depth|:
                    byte: u8 = sview_at(effect_ref, dot)
                    return effect_ref[dot + 1.usize():sview_len(effect_ref)] if byte == 46 and depth == 0
                    depth <- depth + 1 if byte == 91 or byte == 40 or byte == 123
                    depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41 or byte == 125)
                    dot <- dot + 1.usize()
                return ""



        def ae_permission_member_known(annotations: darray[Ast::EnumAnnotation]&, family: sview, member: sview) -> bool:
            can Abort.Panic:
                return true if member == ""
                # The compiler's builtin Console surface is intentionally closed. Other
                # builtin families retain their historical open-member behavior here; their
                # detailed member tables are owned by the existing Unsafe/Sync checks.
                return member == "Format" or member == "Write" if family == "Console"
                return true if ae_builtin_permission_family(family)
                return any annotation in annotations where annotation.owner == family and annotation.line == 3900000093 and annotation.name == member



        def ae_has_concrete_diagnostic(table: SymbolTable&, kind: DiagnosticKind, name: sview, expected: sview, actual: sview) -> bool:
            can Abort.Panic:
                for diagnostic in table.diagnostics:
                    return true if diagnostic.kind == kind and diagnostic.name == name and diagnostic.expected == expected and diagnostic.actual == actual
                return false



        # Validate one source effect row. A `via` row has two independent namespaces: its
        # left side must be a declared abstract family and its right side must be a known
        # concrete permission. Keeping these checks separate prevents a known permission from
        # accidentally making an undeclared abstract family look valid.
        def ae_validate_effect_ref(effect_ref: sview, line: u32, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                abstract: sview = effect_ref_abstract(effect_ref)
                abstract_family: sview = effect_ref_family(abstract)
                concrete: mutable sview = effect_ref_via(effect_ref)
                has_via: bool = concrete != ""
                concrete <- effect_ref if concrete == ""
                family: sview = effect_ref_family(concrete)
                if has_via:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectUnknown, name: abstract_family, line: line, expected: "effect", actual: ""}) if abstract_family != "" and not ae_effect_declared(annotations, abstract_family) and not ae_has_concrete_diagnostic(table, DiagnosticKind.AbstractEffectUnknown, abstract_family, "effect", "")
                    if ae_effect_declared(annotations, abstract_family):
                        abstract_member_via: sview = ae_effect_ref_member(abstract)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectOperationRow, name: abstract_member_via, line: line, expected: abstract_family, actual: effect_ref}) if abstract_member_via != "" and ae_operation_declared(annotations, abstract_family, abstract_member_via)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectOperationMissing, name: abstract_member_via, line: line, expected: abstract_family, actual: "operation"}) if abstract_member_via != "" and not ae_operation_declared(annotations, abstract_family, abstract_member_via) and not ae_has_concrete_diagnostic(table, DiagnosticKind.AbstractEffectOperationMissing, abstract_member_via, abstract_family, "operation")
                if not has_via and ae_effect_declared(annotations, family):
                    abstract_member: sview = ae_effect_ref_member(effect_ref)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectOperationRow, name: abstract_member, line: line, expected: family, actual: effect_ref}) if abstract_member != "" and ae_operation_declared(annotations, family, abstract_member)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AbstractEffectOperationMissing, name: abstract_member, line: line, expected: family, actual: "operation"}) if abstract_member != "" and not ae_operation_declared(annotations, family, abstract_member) and not ae_has_concrete_diagnostic(table, DiagnosticKind.AbstractEffectOperationMissing, abstract_member, family, "operation")
                    return
                return if concrete == "" or family == "" or (not has_via and ae_effect_declared(annotations, family))
                if not ae_permission_family_known(annotations, family):
                    concrete_member: sview = ae_effect_ref_member(concrete)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NamespaceUsedAsValue, name: family, line: line, expected: concrete_member, actual: ""}) if ae_effect_ref_head_is_module(family, table) and not ae_has_concrete_diagnostic(table, DiagnosticKind.NamespaceUsedAsValue, family, concrete_member, "")
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ConcreteEffectPermissionUnknown, name: concrete, line: line, expected: family, actual: concrete_member}) if not ae_has_concrete_diagnostic(table, DiagnosticKind.ConcreteEffectPermissionUnknown, concrete, family, concrete_member)
                    return
                member: sview = ae_effect_ref_member(concrete)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownPermissionMember, name: family, line: line, expected: "", actual: member}) if member != "" and not ae_permission_member_known(annotations, family, member) and not ae_has_concrete_diagnostic(table, DiagnosticKind.UnknownPermissionMember, family, "", member)



        def ae_validate_effect_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, declaration_pos):
                            for effect_ref in effects |table|:
                                table <- ae_validate_effect_ref(effect_ref, declaration_pos.line, annotations, table)
                        Decl.Module(name, body, declaration_pos):
                            table <- ae_validate_effect_declarations(body, annotations, table)
                        Decl.Scoped(body, declaration_pos):
                            table <- ae_validate_effect_declarations(body, annotations, table)
                        _:
                            pass



        def ae_validate_effect_blocks(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, statement_pos):
                            if kind == "can" or kind == "trusted":
                                for effect_ref in clause |table|:
                                    table <- ae_validate_effect_ref(effect_ref, statement_pos.line, annotations, table)
                            table <- ae_validate_effect_blocks(body, annotations, table)
                        Stmt.If(condition, then_body, else_body, statement_pos):
                            table <- ae_validate_effect_blocks(then_body, annotations, table)
                            table <- ae_validate_effect_blocks(else_body, annotations, table)
                        Stmt.While(condition, body, statement_pos):
                            table <- ae_validate_effect_blocks(body, annotations, table)
                        Stmt.For(bind, variables, iterable, body, statement_pos):
                            table <- ae_validate_effect_blocks(body, annotations, table)
                        Stmt.Match(scrutinee, arms, statement_pos):
                            for arm in arms |table|:
                                table <- ae_validate_effect_blocks(arm.body, annotations, table)
                        _:
                            pass



        def ae_validate_effect_blocks_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, declaration_pos):
                            table <- ae_validate_effect_blocks(body, annotations, table)
                        Decl.Module(name, body, declaration_pos):
                            table <- ae_validate_effect_blocks_declarations(body, annotations, table)
                        Decl.Scoped(body, declaration_pos):
                            table <- ae_validate_effect_blocks_declarations(body, annotations, table)
                        _:
                            pass



        def ae_operation_declared(annotations: darray[Ast::EnumAnnotation]&, effect_name: sview, operation: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.line == 3900000081 and annotation.owner == effect_name and annotation.name == operation



        def ae_duplicate_operation_declared(annotations: darray[Ast::EnumAnnotation]&, effect_name: sview, operation: sview) -> bool:
            can Abort.Panic:
                seen: mutable bool = false
                seen_identity_id: mutable u32 = 0
                for annotation in annotations |seen|:
                    if annotation.line == 3900000081 and annotation.owner == effect_name and annotation.name == operation:
                        if seen:
                            return true if annotation.identity_id == 0 or seen_identity_id == 0 or annotation.identity_id == seen_identity_id
                        seen <- true
                        seen_identity_id <- annotation.identity_id
                return false



        def ae_duplicate_handler_operation_declared(annotations: darray[Ast::EnumAnnotation]&, handler_name: sview, operation: sview) -> bool:
            can Abort.Panic:
                seen: mutable bool = false
                seen_identity_id: mutable u32 = 0
                for annotation in annotations |seen|:
                    if annotation.line == 3900000083 and annotation.owner == handler_name and annotation.name == operation:
                        if seen:
                            return true if annotation.identity_id == 0 or seen_identity_id == 0 or annotation.identity_id == seen_identity_id
                        seen <- true
                        seen_identity_id <- annotation.identity_id
                return false
