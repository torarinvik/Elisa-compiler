extend Semantic:
    private:
        # Wrapper to compare sview values by collecting into arrays
        def sview_equal_branches(a: sview, b: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                a_bytes: darray[u8] = [c for c in a]
                b_bytes: darray[u8] = [c for c in b]
                if a_bytes.count != b_bytes.count:
                    return false
                i: mutable usize = 0
                while i < a_bytes.count:
                    if a_bytes[i] != b_bytes[i]:
                        return false
                    i <- i + 1
                return true


        # Compare two expressions for structural equality, including Calls.
        # Returns false for Parens and complex expressions to be conservative.
        def expressions_equal(a: Ast::Expr, b: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                # Unwrap Paren nodes from both sides first
                a_unwrapped: mutable Ast::Expr = a
                b_unwrapped: mutable Ast::Expr = b
                if a is Expr.Paren(inner_a, _):
                    a_unwrapped <- inner_a
                if b is Expr.Paren(inner_b, _):
                    b_unwrapped <- inner_b

                # Match on a and check if b matches its structure
                match a_unwrapped:
                    Expr.Ident(a_name, _):
                        if b_unwrapped is Expr.Ident(b_name, _):
                            return sview_equal_branches(a_name, b_name)
                        return false
                    Expr.IntLit(a_value):
                        if b_unwrapped is Expr.IntLit(b_value):
                            return a_value == b_value
                        return false
                    Expr.FloatLit(a_text):
                        if b_unwrapped is Expr.FloatLit(b_text):
                            return sview_equal_branches(a_text, b_text)
                        return false
                    Expr.BoolLit(a_value):
                        if b_unwrapped is Expr.BoolLit(b_value):
                            return a_value == b_value
                        return false
                    Expr.StringLit(a_text):
                        if b_unwrapped is Expr.StringLit(b_text):
                            return sview_equal_branches(a_text, b_text)
                        return false
                    Expr.CharLit(a_text):
                        if b_unwrapped is Expr.CharLit(b_text):
                            return sview_equal_branches(a_text, b_text)
                        return false
                    Expr.Field(a_obj, a_field, _):
                        if b_unwrapped is Expr.Field(b_obj, b_field, _):
                            # Fields equal if names match and objects match
                            if not sview_equal_branches(a_field, b_field):
                                return false
                            return expressions_equal(a_obj, b_obj)
                        return false
                    Expr.Scope(a_base, a_name, _):
                        if b_unwrapped is Expr.Scope(b_base, b_name, _):
                            if not sview_equal_branches(a_name, b_name):
                                return false
                            return expressions_equal(a_base, b_base)
                        return false
                    Expr.Binary(a_left, a_op, a_right, _):
                        if b_unwrapped is Expr.Binary(b_left, b_op, b_right, _):
                            return a_op == b_op and expressions_equal(a_left, b_left) and expressions_equal(a_right, b_right)
                        return false
                    Expr.Unary(a_op, a_operand, _):
                        if b_unwrapped is Expr.Unary(b_op, b_operand, _):
                            return a_op == b_op and expressions_equal(a_operand, b_operand)
                        return false
                    Expr.Call(a_callee, a_args, a_arg_names, _):
                        if b_unwrapped is Expr.Call(b_callee, b_args, b_arg_names, _):
                            # Callees must match
                            if not expressions_equal(a_callee, b_callee):
                                return false
                            # Argument counts must match
                            if a_args.count != b_args.count:
                                return false
                            # Argument names must match
                            if a_arg_names.count != b_arg_names.count:
                                return false
                            i: mutable usize = 0
                            while i < a_arg_names.count:
                                if not sview_equal_branches(a_arg_names[i], b_arg_names[i]):
                                    return false
                                i <- i + 1
                            # Arguments must match recursively
                            j: mutable usize = 0
                            while j < a_args.count:
                                if not expressions_equal(a_args[j], b_args[j]):
                                    return false
                                j <- j + 1
                            return true
                        return false
                    Expr.Index(a_obj, a_idx, _):
                        if b_unwrapped is Expr.Index(b_obj, b_idx, _):
                            return expressions_equal(a_obj, b_obj) and expressions_equal(a_idx, b_idx)
                        return false
                    Expr.Slice(a_obj, a_lo, a_hi, _):
                        if b_unwrapped is Expr.Slice(b_obj, b_lo, b_hi, _):
                            return expressions_equal(a_obj, b_obj) and expressions_equal(a_lo, b_lo) and expressions_equal(a_hi, b_hi)
                        return false
                    Expr.IndexN(a_obj, a_args, _):
                        if b_unwrapped is Expr.IndexN(b_obj, b_args, _):
                            if not expressions_equal(a_obj, b_obj):
                                return false
                            if a_args.count != b_args.count:
                                return false
                            k: mutable usize = 0
                            while k < a_args.count:
                                if not expressions_equal(a_args[k], b_args[k]):
                                    return false
                                k <- k + 1
                            return true
                        return false
                    Expr.Paren(a_inner, _):
                        # Recursively compare the inner expression (handles nested parens)
                        return expressions_equal(a_inner, b)
                    Expr.Array(a_elems, _):
                        if b_unwrapped is Expr.Array(b_elems, _):
                            if a_elems.count != b_elems.count:
                                return false
                            m: mutable usize = 0
                            while m < a_elems.count:
                                if not expressions_equal(a_elems[m], b_elems[m]):
                                    return false
                                m <- m + 1
                            return true
                        return false
                    Expr.Tuple(a_elems, _):
                        if b_unwrapped is Expr.Tuple(b_elems, _):
                            if a_elems.count != b_elems.count:
                                return false
                            n: mutable usize = 0
                            while n < a_elems.count:
                                if not expressions_equal(a_elems[n], b_elems[n]):
                                    return false
                                n <- n + 1
                            return true
                        return false
                    _:
                        # Bail on other complex expressions (SetLit, DictLit, If, Match, Lambda, Block, Construct, RecordUpdate, Comprehension, etc.)
                        return false


        # Compare two statements for structural equality, handling only Return, Assign, and Expr.
        def statements_equal(a: Ast::Stmt, b: Ast::Stmt) -> bool:
            can Memory.Allocate, Abort.Panic:
                match a:
                    Stmt.Return(a_value, _):
                        if b is Stmt.Return(b_value, _):
                            # Both are None or both are Some, and values must match
                            if a_value is a_val:
                                if b_value is b_val:
                                    return expressions_equal(a_val, b_val)
                                return false
                            else:
                                # a_value is None; b_value must also be None
                                return not (b_value is b_val)
                        return false
                    Stmt.Assign(a_target, a_op, a_value, _):
                        if b is Stmt.Assign(b_target, b_op, b_value, _):
                            return a_op == b_op and expressions_equal(a_target, b_target) and expressions_equal(a_value, b_value)
                        return false
                    Stmt.Expr(a_expr, _):
                        if b is Stmt.Expr(b_expr, _):
                            return expressions_equal(a_expr, b_expr)
                        return false
                    _:
                        return false


        # Check for identical branches in if statements and value-form if expressions.
        def check_identical_branches_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.If(condition, then_body, else_body, line):
                            # Check if both then_body and else_body have exactly one statement
                            if then_body.count == 1 and else_body.count == 1:
                                # Check if the single statements are NOT an elif chain
                                # (elif is: else_body contains exactly one If)
                                if not (else_body[0] is Stmt.If(_, _, _, _)):
                                    # Compare the single statements
                                    if statements_equal(then_body[0], else_body[0]):
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IdenticalBranches, name: "", line: line, expected: "", actual: ""})
                            # Recurse into the branches regardless
                            table <- check_identical_branches_statements(then_body, table)
                            # Don't recurse into else_body if it's an elif (a single If)
                            if else_body.count == 1:
                                if else_body[0] is Stmt.If(_, _, _, _):
                                    # It's an elif; let the recursion on the main statement handle it
                                    pass
                                else:
                                    table <- check_identical_branches_statements(else_body, table)
                            else:
                                table <- check_identical_branches_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- check_identical_branches_statements(body, table)
                            # Walk the condition for value-form If expressions
                            table <- walk_identical_branches_expression(condition, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_identical_branches_statements(body, table)
                            table <- walk_identical_branches_expression(iterable, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_identical_branches_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_identical_branches_expression(scrutinee, table)
                            for arm in arms |table|:
                                table <- walk_identical_branches_expression(arm.guard, table)
                                table <- check_identical_branches_statements(arm.body, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- walk_identical_branches_expression(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_identical_branches_expression(target, table)
                            table <- walk_identical_branches_expression(value, table)
                        Stmt.Expr(expression, line):
                            table <- walk_identical_branches_expression(expression, table)
                        Stmt.Return(value, line):
                            if value is ret_val:
                                table <- walk_identical_branches_expression(ret_val, table)
                        Stmt.Contract(kind, expression, line):
                            table <- walk_identical_branches_expression(expression, table)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Walk expressions looking for value-form if expressions with identical branches.
        def walk_identical_branches_expression(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.If(condition, then_expr, else_expr, line):
                        # Check if both branches are structurally identical
                        if expressions_equal(then_expr, else_expr):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.IdenticalBranches, name: "", line: line, expected: "", actual: ""})
                        # Recurse into branches
                        table <- walk_identical_branches_expression(condition, table)
                        table <- walk_identical_branches_expression(then_expr, table)
                        table <- walk_identical_branches_expression(else_expr, table)
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_identical_branches_expression(callee, table)
                        for argument in arguments |table|:
                            table <- walk_identical_branches_expression(argument, table)
                    Expr.Field(object, field, line):
                        table <- walk_identical_branches_expression(object, table)
                    Expr.Scope(base, name, line):
                        table <- walk_identical_branches_expression(base, table)
                    Expr.Index(object, index, line):
                        table <- walk_identical_branches_expression(object, table)
                        table <- walk_identical_branches_expression(index, table)
                    Expr.Slice(object, low, high, line):
                        table <- walk_identical_branches_expression(object, table)
                        table <- walk_identical_branches_expression(low, table)
                        table <- walk_identical_branches_expression(high, table)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_identical_branches_expression(object, table)
                        for argument in arguments |table|:
                            table <- walk_identical_branches_expression(argument, table)
                    Expr.Binary(left, operator, right, line):
                        table <- walk_identical_branches_expression(left, table)
                        table <- walk_identical_branches_expression(right, table)
                    Expr.Unary(operator, operand, line):
                        table <- walk_identical_branches_expression(operand, table)
                    Expr.Paren(inner, line):
                        table <- walk_identical_branches_expression(inner, table)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_identical_branches_expression(element, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_identical_branches_expression(element, table)
                    Expr.Block(statements, value, captures, line):
                        table <- check_identical_branches_statements(statements, table)
                        table <- walk_identical_branches_expression(value, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_identical_branches_expression(scrutinee, table)
                        for arm in arms |table|:
                            table <- walk_identical_branches_expression(arm.guard, table)
                            table <- check_identical_branches_statements(arm.body, table)
                    Expr.Invalid:
                        pass
                    Expr.Absent:
                        pass
                        pass
                    Expr.IntLit(value):
                        pass
                    Expr.FloatLit(text):
                        pass
                    Expr.StringLit(text):
                        pass
                    Expr.CharLit(text):
                        pass
                    Expr.BoolLit(value):
                        pass
                    Expr.Ident(name, line):
                        pass
                    Expr.ShorthandMember(parts, line):
                        pass
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_identical_branches_expression(element, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_identical_branches_expression(entry.key, table)
                            table <- walk_identical_branches_expression(entry.value, table)
                    Expr.Lambda(params, body, line):
                        table <- check_identical_branches_statements(body, table)
                    Expr.Construct(type_expr, fields, line):
                        table <- walk_identical_branches_expression(type_expr, table)
                        for field in fields |table|:
                            table <- walk_identical_branches_expression(field.value, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_identical_branches_expression(base, table)
                        for field in fields |table|:
                            table <- walk_identical_branches_expression(field.value, table)
                    Expr.Comprehension(var, iterable, condition, body, line):
                        table <- walk_identical_branches_expression(iterable, table)
                        table <- walk_identical_branches_expression(condition, table)
                        table <- walk_identical_branches_expression(body, table)


        # Check all declarations for identical branches.
        def check_identical_branches(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            table <- check_identical_branches_statements(body, table)
                        Decl.Module(name, body, line):
                            table <- check_identical_branches(body, table)
                        Decl.Scoped(body, line):
                            table <- check_identical_branches(body, table)
                        _:
                            pass
