# Closed builtin spellings and capitalization rule for postfix cast names.
module GlobalAuthorityPostfixCastName:
    public:
        const GA_ASCII_UPPER_A: u8 = 65
        const GA_ASCII_UPPER_Z: u8 = 90

        def is_postfix_cast_name(name: sview) -> bool can[Abort.Panic]:
            ensure result == (
                when name:
                    "void" | "bool" | "char" | "int" | "i8" | "i16" | "i32" | "i64" | "isize" | "s8" | "s16" | "s32" | "s64" | "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" | "f32" | "f64" | "sview" | "cstr" -> true
                    _ -> sview_len(name) > 0 and sview_at(name, 0) >= GA_ASCII_UPPER_A and sview_at(name, 0) <= GA_ASCII_UPPER_Z
            )
            can Abort.Panic:
                return when name:
                    "void" | "bool" | "char" | "int" | "i8" | "i16" | "i32" | "i64" | "isize" | "s8" | "s16" | "s32" | "s64" | "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" | "f32" | "f64" | "sview" | "cstr" -> true
                    _ -> sview_len(name) > 0 and sview_at(name, 0) >= GA_ASCII_UPPER_A and sview_at(name, 0) <= GA_ASCII_UPPER_Z
