# Check for a VOID-typed argument passed to a function call. A value that infers
# to TypeKind.Void (e.g. the result of a uniquely-named `-> void` function call)
# can never be a valid argument to ANY function, regardless of the callee or the
# declared parameter type. Disjoint from FirmArgTypeMismatch (family walls never
# see Void: family_of_kind(Void) == "") and from VoidValueUse (which covers
# `x = g()` / return of a void value, not call-arguments).

extend Semantic:
    private:
        # Walk through expressions, checking for void-typed call arguments.
        def walk_expression_for_void_argument(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        callee_name: mutable sview = ""
                        callee_name <- fn_name if callee is Expr.Ident(fn_name, _)
                        for argument in arguments |table|:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.VoidArgument, name: callee_name, line: line, expected: "", actual: "void"}) if infer_expression_type(argument, var_types, type_names, table).kind == TypeKind.Void
                        # Recursively walk callee and every argument
                        table <- walk_expression_for_void_argument(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_void_argument(argument, table, var_types, type_names)
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_void_argument(left, table, var_types, type_names)
                        table <- walk_expression_for_void_argument(right, table, var_types, type_names) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_void_argument(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_void_argument(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        table <- walk_expression_for_void_argument(object, table, var_types, type_names)
                        table <- walk_expression_for_void_argument(index, table, var_types, type_names) if not index_receiver_is_type_application(object)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_void_argument(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_void_argument(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_void_argument(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_void_argument(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_void_argument(object, table, var_types, type_names)
                        table <- walk_expression_for_void_argument(low, table, var_types, type_names)
                        table <- walk_expression_for_void_argument(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_void_argument(object, table, var_types, type_names)
                        if not index_receiver_is_type_application(object):
                            for argument in arguments |table|:
                                table <- walk_expression_for_void_argument(argument, table, var_types, type_names)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_void_argument(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_void_argument(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_void_argument(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_void_argument(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_void_argument(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_void_argument(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_void_argument(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_void_argument(condition, table, var_types, type_names)
                        table <- walk_expression_for_void_argument(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_void_argument(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_void_argument(iterable, table, var_types, type_names)
                        table <- walk_expression_for_void_argument(condition, table, var_types, type_names)
                        table <- walk_expression_for_void_argument(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_void_argument(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_void_argument(statements, table, var_types, type_names)
                        table <- walk_expression_for_void_argument(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_void_argument(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_void_argument(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking for void arguments.
        def walk_statements_for_void_argument(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_void_argument(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record the type for this variable
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_void_argument(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_void_argument(target, table, var_types, type_names)
                            table <- walk_expression_for_void_argument(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_void_argument(condition, table, var_types, type_names)
                            table <- walk_statements_for_void_argument(then_body, table, var_types, type_names)
                            table <- walk_statements_for_void_argument(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_void_argument(condition, table, var_types, type_names)
                            table <- walk_statements_for_void_argument(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_void_argument(iterable, table, var_types, type_names)
                            table <- walk_statements_for_void_argument(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_void_argument(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_void_argument(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_void_argument(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_void_argument(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            table <- walk_expression_for_void_argument(return_value, table, var_types, type_names) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_void_argument(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_void_argument_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Create fresh type tracking for this function
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            # Record parameter types
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            # Walk the function body
                            table <- walk_statements_for_void_argument(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_void_argument_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_void_argument_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_void_argument(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_void_argument_declarations(declarations, table)
