extend Semantic:
    public:
        def ownership_binding_id_valid(id: BindingId) -> bool:
            ensure result == (id.owner.value != INVALID_DECL_ID_VALUE)
            return id.owner.value != INVALID_DECL_ID_VALUE

        def ownership_binding_ids_equal(left: BindingId, right: BindingId) -> bool:
            ensure result == (left.owner.value == right.owner.value and left.serial == right.serial)
            return left.owner.value == right.owner.value and left.serial == right.serial

        def ownership_binding_join_inputs_match(id: BindingId, left: OwnershipBindingFact, right: OwnershipBindingFact) -> bool:
            ensure result == (ownership_binding_id_valid(id) and ownership_binding_ids_equal(id, left.binding_id) and ownership_binding_ids_equal(id, right.binding_id))
            return ownership_binding_id_valid(id) and ownership_binding_ids_equal(id, left.binding_id) and ownership_binding_ids_equal(id, right.binding_id)

        # The caller supplies the binding whose frontier is being joined. Even
        # an unreachable row cannot smuggle a different binding into that slot.
        def ownership_binding_join(id: BindingId, left: OwnershipBindingFact, right: OwnershipBindingFact) -> OwnershipBindingFact:
            ensure result.binding_id.owner.value == id.owner.value
            ensure result.binding_id.serial == id.serial
            ensure result.reachable == (left.reachable or right.reachable)
            ensure result.known == (ownership_binding_join_inputs_match(id, left, right) and OwnershipFlow::join_reachable_known(left.reachable, left.known, right.reachable, right.known))
            ensure result.may_live == ((ownership_binding_join_inputs_match(id, left, right) and OwnershipFlow::join_reachable_possible(left.reachable, left.may_live, right.reachable, right.may_live)) or (not ownership_binding_join_inputs_match(id, left, right) and result.reachable))
            ensure result.may_consumed == ((ownership_binding_join_inputs_match(id, left, right) and OwnershipFlow::join_reachable_possible(left.reachable, left.may_consumed, right.reachable, right.may_consumed)) or (not ownership_binding_join_inputs_match(id, left, right) and result.reachable))
            reachable: bool = left.reachable or right.reachable
            if not ownership_binding_join_inputs_match(id, left, right):
                return OwnershipBindingFact{binding_id: id, reachable: reachable, known: false, may_live: reachable, may_consumed: reachable}
            return OwnershipBindingFact{binding_id: id, reachable: reachable,
                known: OwnershipFlow::join_reachable_known(left.reachable, left.known, right.reachable, right.known),
                may_live: OwnershipFlow::join_reachable_possible(left.reachable, left.may_live, right.reachable, right.may_live),
                may_consumed: OwnershipFlow::join_reachable_possible(left.reachable, left.may_consumed, right.reachable, right.may_consumed)}

        def ownership_binding_can_consume(fact: OwnershipBindingFact) -> bool:
            ensure result == (ownership_binding_id_valid(fact.binding_id) and fact.reachable and OwnershipFlow::can_move(fact.known, fact.may_live, fact.may_consumed))
            return ownership_binding_id_valid(fact.binding_id) and fact.reachable and OwnershipFlow::can_move(fact.known, fact.may_live, fact.may_consumed)

        # A failed consume preserves all facts. The caller must diagnose it,
        # never revive the binding or interpret this operation as a legality check.
        def ownership_binding_consume(fact: OwnershipBindingFact) -> (accepted: bool, next: OwnershipBindingFact):
            ensure result.accepted == ownership_binding_can_consume(fact)
            ensure result.next.binding_id.owner.value == fact.binding_id.owner.value
            ensure result.next.binding_id.serial == fact.binding_id.serial
            ensure result.next.reachable == fact.reachable
            ensure result.next.known == fact.known
            ensure result.next.may_live == (fact.may_live and not result.accepted)
            ensure result.next.may_consumed == (fact.may_consumed or result.accepted)
            if not ownership_binding_can_consume(fact):
                return (false, fact)
            return (true, OwnershipBindingFact{binding_id: fact.binding_id, reachable: true, known: true, may_live: false, may_consumed: true})
