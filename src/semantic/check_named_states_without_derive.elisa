# Typestate-family diagnostic (structural). A struct that declares named states in its
# header (`struct X[state A | B]:`) but carries no `derive state:` block in its body can
# never assign those states, so the declaration is ill-formed — stage0 rejects it. Reads
# the `has_named_states`/`has_derive` flags now captured on `Decl.Struct`; a pure per-decl
# presence check, no inference or dataflow, so it is trivially free of false positives.
extend Semantic:
    private:
        def check_named_states_without_derive(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, line):
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NamedStatesWithoutDerive, name: name, line: line.line, expected: "", actual: ""}) if has_named_states and not has_derive
                        Decl.Module(module_name, body, module_line):
                            table <- check_named_states_without_derive(body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_named_states_without_derive(scoped_body, table)
                        _:
                            pass
