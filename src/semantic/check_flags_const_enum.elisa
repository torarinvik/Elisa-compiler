# `Flags[T]` requires T to be a const enum (its variants name the bit positions). A `Flags[i64]`
# (primitive) or `Flags[E]` where E is a VALUE enum is rejected: "Flags[T] expects a const enum
# type argument, got X". SOUND subset: fire when the argument is a primitive type or a known value
# (non-const) enum — both are definitely-not-const-enum. A const enum is valid; an unknown/generic
# name is a conservative miss. Scans every type position (param, return, field, local).
extend Semantic:
    private:
        def flags_value_enum_names(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Enum(name, variants, is_const, storage_type, enum_line):
                            out.push(name) if not is_const
                        Decl.Module(module_name, module_body, module_line):
                            flags_value_enum_names(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            flags_value_enum_names(scoped_body, out)
                        _:
                            pass

        def flags_name_present(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return any name in names where name == wanted

        def flags_is_primitive(name: sview) -> bool:
            can Abort.Panic:
                return is_integer_type_name(name) or is_float_type_name(name) or name == "bool" or name == "char" or name == "cstr" or name == "dstr" or name == "void" or name == "sview"

        # Given a `Flags[...]` argument spelling, the "definitely not a const enum" reason (its own
        # spelling to render), else "".
        def flags_bad_argument(argument: Ast::Expr, value_enums: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                name: sview = ident_name_of(argument)
                return name if name != "" and (flags_is_primitive(name) or flags_name_present(value_enums, name)) else sview("", 0, 0)

        # Descend a type expression, flagging any `Flags[E]` whose argument is not a const enum.
        def flags_scan_type(type_expression: Ast::Expr, value_enums: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Index(head, argument, index_line):
                        bad: sview = flags_bad_argument(argument, value_enums) if ident_name_of(head) == "Flags" else sview("", 0, 0)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FlagsConstEnumArg, name: "", line: index_line, expected: "", actual: bad}) if bad != ""
                        table <- flags_scan_type(head, value_enums, table)
                        table <- flags_scan_type(argument, value_enums, table)
                    Expr.IndexN(head, arguments, index_n_line):
                        first: sview = ident_name_of(arguments[0]) if arguments.count > 0 else sview("", 0, 0)
                        bad_n: sview = flags_bad_argument(arguments[0], value_enums) if ident_name_of(head) == "Flags" and arguments.count > 0 else sview("", 0, 0)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FlagsConstEnumArg, name: "", line: index_n_line, expected: "", actual: bad_n}) if bad_n != ""
                        table <- flags_scan_type(head, value_enums, table)
                        for argument in arguments |table| -> table:
                            table <- flags_scan_type(argument, value_enums, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- flags_scan_type(operand, value_enums, table)
                    Expr.Paren(inner, paren_line):
                        table <- flags_scan_type(inner, value_enums, table)
                    _:
                        pass

        def flags_scan_statements(statements: darray[Ast::Stmt], value_enums: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- flags_scan_type(type_expression, value_enums, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- flags_scan_statements(then_body, value_enums, table)
                            table <- flags_scan_statements(else_body, value_enums, table)
                        Stmt.While(condition, body, line):
                            table <- flags_scan_statements(body, value_enums, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- flags_scan_statements(body, value_enums, table)
                        Stmt.Block(block_kind, clause, binding, body, line):
                            table <- flags_scan_statements(body, value_enums, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- flags_scan_statements(arm.body, value_enums, table)
                        _:
                            pass

        def check_flags_const_enum_decls(declarations: darray[Ast::Decl], value_enums: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            for parameter in params |table| -> table:
                                table <- flags_scan_type(parameter.type_expression, value_enums, table)
                            if return_type is declared_return:
                                table <- flags_scan_type(declared_return, value_enums, table)
                            table <- flags_scan_statements(body, value_enums, table)
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            for member in members |table| -> table:
                                table <- flags_scan_type(member.type_expression, value_enums, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_flags_const_enum_decls(module_body, value_enums, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_flags_const_enum_decls(scoped_body, value_enums, table)
                        _:
                            pass

    public:
        def check_flags_const_enum(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                value_enums: mutable darray[sview] = []
                flags_value_enum_names(declarations, value_enums)
                table <- check_flags_const_enum_decls(declarations, value_enums, table)
