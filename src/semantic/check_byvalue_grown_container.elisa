# By-value grown-container footgun (registry-level, no dataflow). A function that GROWS
# (push/extend/insert/reserve/resize/append/put/add) a growable container PARAMETER passed
# BY VALUE — `def fill(out: mutable darray[u8]): out.push(...)`, no `&` — warns: a by-value
# param copies the caller's header, so the reallocated buffer never reaches the caller.
#
# Ports stage0's analyzer_byvalue_grown_container_lint.go EXACTLY, including its two
# false-positive suppressions:
#   - build-and-return (`return param` bare): growth reaches the caller via the result.
#   - `&` reference param (growth IS visible) — excluded by the type-shape test.
# Purely a type-shape + syntactic-body scan; sound without any move/region dataflow. Any
# case not recognized (region-qualified `@r` types, growth buried in a sub-expression) simply
# does not fire — a false negative, never a false positive.
extend Semantic:
    private:
        # The surface name of a growable container parameter passed BY VALUE, or "" when the
        # parameter is not one. `mutable` is peeled; a `&` reference (or any other unary
        # wrapper: lmut/owned/optional) yields "" so only a plain by-value container remains.
        def byvalue_grown_container_name(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, unary_line):
                        byvalue_grown_container_name(operand) return if operator == TokenKind.Mutable
                        return sview("", 0, 0)
                    Expr.Ident(ident_name, ident_line):
                        return ident_name if ident_name == "dstr" else sview("", 0, 0)
                    Expr.Index(object, index, index_line):
                        head: sview = bare_type_name(object)
                        return head if head == "darray" or head == "dict" or head == "set" else sview("", 0, 0)
                    Expr.IndexN(object_n, arguments_n, indexn_line):
                        head_n: sview = bare_type_name(object_n)
                        return head_n if head_n == "darray" or head_n == "dict" or head_n == "set" else sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        def is_container_growth_method(method: sview) -> bool:
            can Abort.Panic:
                return method == "push" or method == "extend" or method == "insert" or method == "resize" or method == "reserve" or method == "append" or method == "put" or method == "add"

        # Whether `expression` is directly `param.grower(...)`.
        def expression_grows_param(expression: Ast::Expr, param: sview) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match callee:
                            Expr.Field(Expr.Ident(receiver_name, receiver_line), method_name, field_line):
                                return is_container_growth_method(method_name) and receiver_name == param
                            _:
                                return false
                    _:
                        return false

        def statements_grow_param(statements: darray[Ast::Stmt], param: sview) -> bool:
            can Abort.Panic:
                found: mutable bool = false
                for statement in statements |found, param|:
                    continue if found
                    found <- true if statement_grows_param(statement, param)
                return found

        def statement_grows_param(statement: Ast::Stmt, param: sview) -> bool:
            can Abort.Panic:
                match statement:
                    Stmt.Expr(expression, line):
                        return expression_grows_param(expression, param)
                    Stmt.Assign(target, operator, value, line):
                        return expression_grows_param(value, param)
                    Stmt.VarDecl(name, type_expression, value, line):
                        return expression_grows_param(value, param)
                    Stmt.Block(kind, clause, binding, body, line):
                        return statements_grow_param(body, param)
                    Stmt.If(condition, then_body, else_body, line):
                        return statements_grow_param(then_body, param) or statements_grow_param(else_body, param)
                    Stmt.While(condition, body, line):
                        return statements_grow_param(body, param)
                    Stmt.For(bind, variables, iterable, body, line):
                        return statements_grow_param(body, param)
                    Stmt.Match(scrutinee, arms, line):
                        any_arm: mutable bool = false
                        for arm in arms |any_arm, param|:
                            any_arm <- true if statements_grow_param(arm.body, param)
                        return any_arm
                    _:
                        return false

        # Whether some `return param` (bare identifier) returns the parameter — the
        # build-and-return idiom that makes by-value growth observable to the caller.
        def statements_return_param_bare(statements: darray[Ast::Stmt], param: sview) -> bool:
            can Abort.Panic:
                found: mutable bool = false
                for statement in statements |found, param|:
                    continue if found
                    found <- true if statement_returns_param_bare(statement, param)
                return found

        def statement_returns_param_bare(statement: Ast::Stmt, param: sview) -> bool:
            can Abort.Panic:
                match statement:
                    Stmt.Return(return_value, line):
                        if return_value is present_return:
                            if present_return is Expr.Ident(returned_name, returned_line):
                                return returned_name == param
                            return false
                        return false
                    Stmt.Block(kind, clause, binding, body, line):
                        return statements_return_param_bare(body, param)
                    Stmt.If(condition, then_body, else_body, line):
                        return statements_return_param_bare(then_body, param) or statements_return_param_bare(else_body, param)
                    Stmt.While(condition, body, line):
                        return statements_return_param_bare(body, param)
                    Stmt.For(bind, variables, iterable, body, line):
                        return statements_return_param_bare(body, param)
                    Stmt.Match(scrutinee, arms, line):
                        any_arm: mutable bool = false
                        for arm in arms |any_arm, param|:
                            any_arm <- true if statements_return_param_bare(arm.body, param)
                        return any_arm
                    _:
                        return false

        def check_byvalue_grown_container(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            continue if body.count == 0
                            for parameter in parameters |table, body, line|:
                                container_name: sview = byvalue_grown_container_name(parameter.type_expression)
                                continue if container_name == ""
                                continue if not statements_grow_param(body, parameter.name)
                                continue if statements_return_param_bare(body, parameter.name)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ByValueGrownContainer, name: container_name, line: line, expected: parameter.name, actual: ""})
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_byvalue_grown_container(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_byvalue_grown_container(scoped_body, table)
                        _:
                            pass
