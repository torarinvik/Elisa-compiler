# Narrow diagnostic policy for canonical IEEE self-comparison predicates.
# Only typed float parameters in bodies without bindings or complex scopes qualify.
# Unknown lexical/type context keeps the existing diagnostics.
extend Semantic:
    private:
        def ieee_nan_plain_expression(expression: Ast::Expr) -> bool can[Abort.Panic]:
            match expression:
                Expr.Ident(_, _) | Expr.IntLit(_, _) | Expr.FloatLit(_, _) | Expr.BoolLit(_, _):
                    true
                Expr.Unary(_, inner, _) | Expr.Paren(inner, _):
                    ieee_nan_plain_expression(inner)
                Expr.Binary(left, _, right, _):
                    ieee_nan_plain_expression(left) and ieee_nan_plain_expression(right)
                Expr.If(condition, yes, no, _):
                    ieee_nan_plain_expression(condition) and ieee_nan_plain_expression(yes) and ieee_nan_plain_expression(no)
                _:
                    false

        def ieee_nan_plain_body(body: darray[Ast::Stmt]) -> bool can[Abort.Panic]:
            for statement in body:
                match statement:
                    Stmt.Contract(_, expression, _) | Stmt.Expr(expression, _):
                        return false if not ieee_nan_plain_expression(expression)
                    Stmt.Return(value, _):
                        if value is expression:
                            return false if not ieee_nan_plain_expression(expression)
                    Stmt.If(condition, yes, no, _):
                        return false if not ieee_nan_plain_expression(condition) or not ieee_nan_plain_body(yes) or not ieee_nan_plain_body(no)
                    _:
                        return false
            true

        def ieee_nan_parameter_names(params: darray[Ast::ParamDecl], body: darray[Ast::Stmt], table: SymbolTable&) -> darray[sview] can[Abort.Panic, Memory.Allocate]:
            names: mutable darray[sview] = []
            return names if not ieee_nan_plain_body(body)
            # Spelling alone cannot authenticate a primitive if source declarations
            # reuse its name. Conservatively retain diagnostics across modules too.
            for symbol in table.symbols:
                return names if symbol.line != 0 and (symbol.name == "f32" or symbol.name == "f64")
            for param in params |names|:
                if param.type_expression is Ast::Expr.Ident(kind, _):
                    if kind == "f32" or kind == "f64":
                        names <- names.push(param.name)
            names

        def ieee_nan_self_comparison(left: Ast::Expr, right: Ast::Expr, names: darray[sview]&) -> bool can[Abort.Panic]:
            if left is Expr.Ident(left_name, _):
                if right is Expr.Ident(right_name, _):
                    return false if left_name != right_name
                    for name in names:
                        return true if name == left_name
            false
