extend Semantic:
    private:
        def hce_walk(body: darray[Ast::Stmt], params: darray[sview]&, locals: mutable darray[sview]&, views: mutable darray[sview]&, owners: mutable darray[sview]&, byte_owners: mutable darray[sview]&, tainted: mutable darray[sview @source]&, elements: mutable darray[sview]&, direct_views: mutable darray[sview]&, interior: mutable darray[sview]&, f_struct: darray[sview]&, f_name: darray[sview]&, f_type: darray[Ast::Expr]&, fns: darray[Ast::Decl]&, fn_index: HceMap&, annotations: darray[Ast::LocalRegionAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in body |locals, views, owners, byte_owners, tainted, elements, direct_views, interior, table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, pos):
                            hce_record_fill(value, views, owners, byte_owners, interior, tainted, fns, fn_index, annotations) can Global{Read,Write}
                            hce_record_push(value, views, owners, params, tainted, elements)
                            table <- hce_check_push(value, pos.line, params, locals, tainted, elements, owners, direct_views, interior, table)
                            # A redeclaration starts clean (shadowing is legal).
                            hce_forget(tainted, name)
                            hce_forget(elements, name)
                            hce_forget(direct_views, name)
                            direct_views.push(name) if hce_direct_view(value, owners)
                            derived: bool = hce_derived_tainted(value, views, owners, params, tainted, elements)
                            value_tainted: bool = hce_is_tainted(value, tainted, elements, owners)
                            locals.push(name)
                            # Only annotations on this line can match: scan their line window.
                            annotated: mutable bool = false
                            for annotation_index in (region_annotation_window_start(annotations, pos.line) can Global{Read,Write})..<(region_annotation_window_end(annotations, pos.line) can Global{Read,Write}) |annotated, annotations, name, pos|:
                                annotation: Ast::LocalRegionAnnotation = annotations[annotation_index]
                                annotated <- true if annotation.name == name and annotation.line == pos.line and annotation.region != "" and not sview_starts_with(annotation.region, "__")
                            stripped: Ast::Expr = oe_strip(type_expression)
                            head: sview = bare_type_name(stripped)
                            if not annotated:
                                element_type: Ast::Expr = oe_element_type(stripped)
                                hce_forget(interior, name)
                                element_interior: bool = annotation_is_container(stripped) and hce_element_has_container(element_type, f_struct, f_name, f_type)
                                interior.push(name) if element_interior
                                if annotation_is_container(stripped) and (element_interior or hce_element_holds_view(element_type, f_struct, f_name, f_type)):
                                    views.push(name)
                                    tainted.push(name) if derived
                                elif not annotation_is_container(stripped) and value_tainted and (head == "sview" or hce_element_holds_view(stripped, f_struct, f_name, f_type)):
                                    elements.push(name)
                                owning_darray: bool = annotation_is_container(stripped) and ident_name_of(element_type) != "sview" and (ident_name_of(element_type) == "u8" or not annotation_is_scalar_darray(stripped))
                                owners.push(name) if owning_darray or head == "dstr"
                                byte_owners.push(name) if head == "dstr" or (annotation_is_container(stripped) and ident_name_of(element_type) == "u8")
                        Stmt.Expr(expression, pos):
                            hce_record_fill(expression, views, owners, byte_owners, interior, tainted, fns, fn_index, annotations) can Global{Read,Write}
                            hce_record_push(expression, views, owners, params, tainted, elements)
                            table <- hce_check_push(expression, pos.line, params, locals, tainted, elements, owners, direct_views, interior, table)
                        Stmt.Assign(target, operator, value, pos):
                            hce_record_fill(value, views, owners, byte_owners, interior, tainted, fns, fn_index, annotations) can Global{Read,Write}
                            hce_record_push(value, views, owners, params, tainted, elements)
                            table <- hce_check_push(value, pos.line, params, locals, tainted, elements, owners, direct_views, interior, table)
                            assigned: sview = ident_name_of(target)
                            if operator == TokenKind.LArrow and assigned != "" and hce_contains(locals, assigned) and not hce_contains(params, assigned):
                                if hce_contains(views, assigned):
                                    tainted.push(assigned) if not hce_contains(tainted, assigned) and not hce_self_narrowing(value, assigned) and hce_derived_tainted(value, views, owners, params, tainted, elements)
                                elif not hce_contains(elements, assigned) and hce_is_tainted(value, tainted, elements, owners):
                                    elements.push(assigned)
                            if operator == TokenKind.LArrow:
                                root: sview = auto_escape_place_root(target)
                                element_pos: Ast::Pos = hce_store_element_pos(value, tainted, elements, owners, direct_views) if hce_is_param_index(target, params) else hce_tainted_element(value, tainted, elements)
                                # An indexed store straight into a container parameter (`P[i] <- v`)
                                # runs push's element checks (stage0 checkIndexedElementStoreEscape),
                                # so a literal's fields count there; deeper places still check the
                                # literal, not its fields.
                                direct_indexed: bool = hce_is_param_index(target, params)
                                if (direct_indexed or not hce_is_construct(value)) and ident_name_of(target) == "" and hce_contains(params, root) and not hce_contains(locals, root) and (element_pos.end_column != 0 or element_pos.line != 0):
                                    table <- hce_report(pos.line, element_pos, root, direct_indexed and hce_construct_direct(value, owners, direct_views), table)
                        Stmt.For(bind, variables, iterable, for_body, pos):
                            loop_var: sview = variables[0] if variables.count == 1 else (bind if variables.count == 0 else "")
                            elements.push(loop_var) if loop_var != "" and hce_contains(tainted, ident_name_of(iterable))
                            interior.push(loop_var) if loop_var != "" and hce_contains(tainted, ident_name_of(iterable)) and hce_contains(interior, ident_name_of(iterable))
                            for_before: usize = tainted.count
                            table <- hce_walk(for_body, params, locals, views, owners, byte_owners, tainted, elements, direct_views, interior, f_struct, f_name, f_type, fns, fn_index, annotations, table) can Global{Read,Write}
                            table <- hce_check_loop_widening(for_body, tainted, for_before, table) can Global{Read,Write}
                        Stmt.Block(kind, clause, binding, block_body, pos):
                            table <- hce_walk(block_body, params, locals, views, owners, byte_owners, tainted, elements, direct_views, interior, f_struct, f_name, f_type, fns, fn_index, annotations, table) can Global{Read,Write}
                        Stmt.If(condition, then_body, else_body, pos):
                            table <- hce_walk(then_body, params, locals, views, owners, byte_owners, tainted, elements, direct_views, interior, f_struct, f_name, f_type, fns, fn_index, annotations, table) can Global{Read,Write}
                            table <- hce_walk(else_body, params, locals, views, owners, byte_owners, tainted, elements, direct_views, interior, f_struct, f_name, f_type, fns, fn_index, annotations, table) can Global{Read,Write}
                        Stmt.While(condition, while_body, pos):
                            while_before: usize = tainted.count
                            table <- hce_walk(while_body, params, locals, views, owners, byte_owners, tainted, elements, direct_views, interior, f_struct, f_name, f_type, fns, fn_index, annotations, table) can Global{Read,Write}
                            table <- hce_check_loop_widening(while_body, tainted, while_before, table) can Global{Read,Write}
                        Stmt.Match(scrutinee, arms, pos):
                            for arm in arms |locals, views, owners, byte_owners, tainted, elements, direct_views, interior, table| -> table:
                                table <- hce_walk(arm.body, params, locals, views, owners, byte_owners, tainted, elements, direct_views, interior, f_struct, f_name, f_type, fns, fn_index, annotations, table) can Global{Read,Write}
                        _:
                            pass

        def hce_check_declarations(declarations: darray[Ast::Decl], f_struct: darray[sview]&, f_name: darray[sview]&, f_type: darray[Ast::Expr]&, fns: darray[Ast::Decl]&, fn_index: HceMap&, annotations: darray[Ast::LocalRegionAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            params: mutable darray[sview] = []
                            for parameter in parameters |params|:
                                params.push(parameter.name)
                            continue if params.count == 0
                            locals: mutable darray[sview] = []
                            views: mutable darray[sview] = []
                            owners: mutable darray[sview] = []
                            byte_owners: mutable darray[sview] = []
                            tainted: mutable darray[sview @source] = []
                            elements: mutable darray[sview] = []
                            direct_views: mutable darray[sview] = []
                            interior: mutable darray[sview] = []
                            table <- hce_walk(body, params, locals, views, owners, byte_owners, tainted, elements, direct_views, interior, f_struct, f_name, f_type, fns, fn_index, annotations, table) can Global{Read,Write}
                        Decl.Module(module_name, module_body, module_line):
                            table <- hce_check_declarations(module_body, f_struct, f_name, f_type, fns, fn_index, annotations, table) can Global{Read,Write}
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- hce_check_declarations(scoped_body, f_struct, f_name, f_type, fns, fn_index, annotations, table) can Global{Read,Write}
                        _:
                            pass

    public:
        def check_handler_capture_escape(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # A previous file may have left a sortedness memo for a freed annotation
                # buffer. Its address, count, and endpoint lines can all be reused here.
                region_annotations_forget_sorted() can Global.Write
                f_struct: mutable darray[sview] = []
                f_name: mutable darray[sview] = []
                f_type: mutable darray[Ast::Expr] = []
                oe_collect_fields(file.top_decls, f_struct, f_name, f_type)
                fns: mutable darray[Ast::Decl] = []
                fn_index: mutable HceMap = HceMap{rows: {}}
                hce_collect_functions(file.top_decls, fns, fn_index) can Global{Read,Write}
                table <- hce_check_declarations(file.top_decls, f_struct, f_name, f_type, fns, fn_index, file.local_region_annotations, table) can Global{Read,Write}
