# Static-branch imports have two visibility states. The ordinary imported_* arrays
# record only imports proven active; unresolved rows live in possible_import_annotations
# and are consulted here only to avoid choosing a definite result that may change.
extend Semantic:
    private:
        def semantic_is_synthetic_unknown_import_marker(annotation: Ast::EnumAnnotation) -> bool:
            can Abort.Panic:
                return annotation.owner == "__pma_unknown_static_import" and annotation.detail_name != ""


        def semantic_import_scope_visible(import_scope: sview, current_scope: sview) -> bool:
            can Abort.Panic:
                return import_scope == "" or import_scope == current_scope or (
                    current_scope.len >= import_scope.len + 2.usize() and
                    current_scope[import_scope.len] == 58 and current_scope[import_scope.len + 1.usize()] == 58 and
                    (forall index in 0..<import_scope.len:
                        import_scope[index] == current_scope[index]
                    )
                )


        # Match an imported module spelling against a canonical owner without allocating
        # a joined name. Relative targets are checked at the import scope and each ancestor.
        def semantic_import_module_path_matches(candidate_owner: sview, target: sview, import_scope: sview) -> bool:
            can Abort.Panic:
                return false if candidate_owner == "" or target == ""
                return true if candidate_owner == target
                prefix_length: mutable usize = import_scope.len
                while prefix_length > 0 |prefix_length, candidate_owner, target, import_scope|:
                    at_scope_boundary: bool = prefix_length == import_scope.len or (prefix_length + 1.usize() < import_scope.len and import_scope[prefix_length] == 58 and import_scope[prefix_length + 1.usize()] == 58)
                    expected_length: usize = prefix_length + 2.usize() + target.len
                    if at_scope_boundary and candidate_owner.len == expected_length:
                        matches_prefix: mutable bool = true
                        for index in 0..<prefix_length |matches_prefix, candidate_owner, import_scope|:
                            matches_prefix <- false if candidate_owner[index] != import_scope[index]
                        if matches_prefix and candidate_owner[prefix_length] == 58 and candidate_owner[prefix_length + 1.usize()] == 58:
                            matches_target: mutable bool = true
                            for index in 0..<target.len |matches_target, candidate_owner, target, prefix_length|:
                                matches_target <- false if candidate_owner[prefix_length + 2.usize() + index] != target[index]
                            return true if matches_target
                    prefix_length <- prefix_length - 1.usize()
                return false


        def semantic_import_module_path_with_suffix_matches(candidate_owner: sview, target: sview, suffix: sview, import_scope: sview) -> bool:
            can Abort.Panic:
                return semantic_import_module_path_matches(candidate_owner, target, import_scope) if suffix == ""
                tail_length: usize = target.len + 2.usize() + suffix.len
                if candidate_owner.len == tail_length:
                    matches_target: mutable bool = true
                    for index in 0..<target.len |matches_target, candidate_owner, target|:
                        matches_target <- false if candidate_owner[index] != target[index]
                    matches_separator: bool = candidate_owner[target.len] == 58 and candidate_owner[target.len + 1.usize()] == 58
                    matches_suffix: mutable bool = matches_target and matches_separator
                    for index in 0..<suffix.len |matches_suffix, candidate_owner, suffix, target|:
                        matches_suffix <- false if candidate_owner[target.len + 2.usize() + index] != suffix[index]
                    return true if matches_suffix
                prefix_length: mutable usize = import_scope.len
                while prefix_length > 0 |prefix_length, candidate_owner, target, suffix, import_scope, tail_length|:
                    at_scope_boundary: bool = prefix_length == import_scope.len or (prefix_length + 1.usize() < import_scope.len and import_scope[prefix_length] == 58 and import_scope[prefix_length + 1.usize()] == 58)
                    expected_length: usize = prefix_length + 2.usize() + tail_length
                    if at_scope_boundary and candidate_owner.len == expected_length:
                        matches_prefix: mutable bool = true
                        for index in 0..<prefix_length |matches_prefix, candidate_owner, import_scope|:
                            matches_prefix <- false if candidate_owner[index] != import_scope[index]
                        if matches_prefix and candidate_owner[prefix_length] == 58 and candidate_owner[prefix_length + 1.usize()] == 58:
                            matches_target: mutable bool = true
                            for index in 0..<target.len |matches_target, candidate_owner, target, prefix_length|:
                                matches_target <- false if candidate_owner[prefix_length + 2.usize() + index] != target[index]
                            target_end: usize = prefix_length + 2.usize() + target.len
                            matches_suffix_separator: bool = candidate_owner[target_end] == 58 and candidate_owner[target_end + 1.usize()] == 58
                            matches_suffix: mutable bool = matches_target and matches_suffix_separator
                            for index in 0..<suffix.len |matches_suffix, candidate_owner, suffix, target_end|:
                                matches_suffix <- false if candidate_owner[target_end + 2.usize() + index] != suffix[index]
                            return true if matches_suffix
                    prefix_length <- prefix_length - 1.usize()
                return false


        def semantic_import_path_piece_prefix_matches(candidate_owner: sview, start: usize, piece: sview) -> (matches: bool, end: usize):
            can Abort.Panic:
                return (false, start) if start > candidate_owner.len or piece.len > candidate_owner.len - start
                for index in 0..<piece.len |candidate_owner, start, piece|:
                    return (false, start) if candidate_owner[start + index] != piece[index]
                return (true, start + piece.len)


        # Match an ordinary module path as a prefix of a canonical owner. Relative paths
        # resolve at the declaration scope and each ancestor, just like the exact matcher.
        def semantic_import_module_path_prefix_matches(candidate_owner: sview, target: sview, import_scope: sview) -> (matches: bool, end: usize):
            can Abort.Panic:
                direct: (matches: bool, end: usize) = semantic_import_path_piece_prefix_matches(candidate_owner, 0, target)
                return direct if direct.matches
                prefix_length: mutable usize = import_scope.len
                while prefix_length > 0 |prefix_length, candidate_owner, target, import_scope|:
                    at_scope_boundary: bool = prefix_length == import_scope.len or (prefix_length + 1.usize() < import_scope.len and import_scope[prefix_length] == 58 and import_scope[prefix_length + 1.usize()] == 58)
                    if at_scope_boundary:
                        scope_prefix: sview = string_view_slice(import_scope, 0, prefix_length.i64())
                        scope_match: (matches: bool, end: usize) = semantic_import_path_piece_prefix_matches(candidate_owner, 0, scope_prefix)
                        if scope_match.matches and scope_match.end + 1.usize() < candidate_owner.len and candidate_owner[scope_match.end] == 58 and candidate_owner[scope_match.end + 1.usize()] == 58:
                            target_match: (matches: bool, end: usize) = semantic_import_path_piece_prefix_matches(candidate_owner, scope_match.end + 2.usize(), target)
                            return target_match if target_match.matches
                    prefix_length <- prefix_length - 1.usize()
                return (false, 0)


        def semantic_import_path_append_prefix_matches(candidate_owner: sview, start: usize, suffix: sview) -> (matches: bool, end: usize):
            can Abort.Panic:
                return (true, start) if suffix == ""
                return (false, start) if start + 1.usize() >= candidate_owner.len or candidate_owner[start] != 58 or candidate_owner[start + 1.usize()] != 58
                return semantic_import_path_piece_prefix_matches(candidate_owner, start + 2.usize(), suffix)


        # Select the first analyzer-wide alias registered before this alias declaration.
        # Core pre-registers direct aliases in an ancestor scope before descending into
        # children, so raw source offsets alone are not a valid cutoff.
        def semantic_possible_import_alias_head_target(name: sview, import_scope: sview, before_offset: u32, table: SymbolTable&) -> (known: bool, found: bool, target: sview, raw_target: sview, scope: sview, offset: u32):
            can Abort.Panic:
                selected_target: mutable sview = ""
                selected_raw_target: mutable sview = ""
                selected_scope: mutable sview = ""
                selected_offset: mutable u32 = 0
                selected_line: mutable u32 = 0
                selected_found: mutable bool = false
                found_prior: mutable bool = false
                for alias in table.definite_import_annotations |selected_target, selected_raw_target, selected_scope, selected_offset, selected_line, selected_found, found_prior, name, import_scope, before_offset, table|:
                    continue if alias.name != "__using_alias" or alias.owner != name
                    before_requester: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes_position(alias, import_scope, before_offset, table)
                    continue if not before_requester.known or not before_requester.precedes
                    found_prior <- true
                    candidate_wins: mutable bool = true
                    for other in table.definite_import_annotations |candidate_wins, alias, name, import_scope, before_offset, table|:
                        continue if other.name != "__using_alias" or other.owner != name
                        continue if other.module == alias.module and other.line == alias.line and other.offset == alias.offset
                        other_before_requester: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes_position(other, import_scope, before_offset, table)
                        continue if other_before_requester.known and not other_before_requester.precedes
                        order: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes(other, alias, table)
                        candidate_wins <- false if not order.known or order.precedes
                    if candidate_wins:
                        return (false, false, "", "", "", 0) if selected_found
                        selected_scope <- alias.module
                        selected_offset <- alias.offset
                        selected_line <- alias.line
                        selected_found <- true
                return (false, false, "", "", "", 0) if found_prior and not selected_found
                selected_alias: Ast::EnumAnnotation = Ast::EnumAnnotation{owner: name, name: "__using_alias", module: selected_scope, line: selected_line, offset: selected_offset}
                # Recheck every definite contender against the final winner. Unordered
                # cutoffs visited before a later winner are not sticky uncertainty.
                for alias in table.definite_import_annotations |selected_found, selected_scope, selected_line, selected_offset, name, import_scope, before_offset, selected_alias, table|:
                    continue if alias.name != "__using_alias" or alias.owner != name
                    continue if alias.module == selected_scope and alias.line == selected_line and alias.offset == selected_offset
                    before_requester: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes_position(alias, import_scope, before_offset, table)
                    continue if before_requester.known and not before_requester.precedes
                    return (false, false, "", "", "", 0) if not selected_found
                    order: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes(alias, selected_alias, table)
                    return (false, false, "", "", "", 0) if not order.known or order.precedes
                # Possible rows are harmless only when the definite winner is known to
                # precede them. Defer their cutoff uncertainty until that winner exists.
                for alias in table.possible_import_annotations |selected_found, selected_scope, selected_line, selected_offset, name, import_scope, before_offset, selected_alias, table|:
                    continue if alias.name != "__using_alias" or alias.owner != name
                    before_requester: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes_position(alias, import_scope, before_offset, table)
                    continue if before_requester.known and not before_requester.precedes
                    return (false, false, "", "", "", 0) if not selected_found
                    order: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes(alias, selected_alias, table)
                    return (false, false, "", "", "", 0) if not order.known or order.precedes
                if selected_found:
                    raw_target_count: mutable usize = 0
                    for target_row in table.definite_import_annotations |selected_raw_target, raw_target_count, selected_scope, selected_line, selected_offset|:
                        if target_row.name == "__using_alias_target" and target_row.module == selected_scope and target_row.line == selected_line and target_row.offset == selected_offset:
                            selected_raw_target <- target_row.owner
                            raw_target_count <- raw_target_count + 1.usize()
                    canonical_target_count: mutable usize = 0
                    for target_row in table.binding_import_annotations |selected_target, canonical_target_count, selected_scope, selected_line, selected_offset|:
                        if target_row.name == "__using_alias_target" and target_row.module == selected_scope and target_row.line == selected_line and target_row.offset == selected_offset:
                            selected_target <- target_row.owner
                            canonical_target_count <- canonical_target_count + 1.usize()
                    return (false, false, "", "", "", 0) if raw_target_count != 1.usize() or canonical_target_count != 1.usize() or selected_target == ""
                return (true, selected_found, selected_target, selected_raw_target, selected_scope, selected_offset)


        # Resolve only the first path segment as a module alias, then append the remaining
        # literal segments. Alias targets recurse at their own declaration scope, with a hard
        # depth bound for malformed cycles. This preserves chains such as `First::Nested`.
        def semantic_possible_import_alias_target_prefix(candidate_owner: sview, target_path: sview, import_scope: sview, before_offset: u32, table: SymbolTable&, depth: u32 = 0) -> (known: bool, matches: bool, end: usize):
            can Abort.Panic:
                return (false, false, 0) if depth >= 64
                head_length: mutable usize = target_path.len
                for index in 0..<target_path.len:
                    if index + 1.usize() < target_path.len and target_path[index] == 58 and target_path[index + 1.usize()] == 58:
                        head_length <- index
                        break
                alias_name: sview = string_view_slice(target_path, 0, head_length.i64())
                suffix: sview = string_view_slice(target_path, (head_length + 2.usize()).i64(), target_path.len.i64()) if head_length < target_path.len else ""
                alias: (known: bool, found: bool, target: sview, raw_target: sview, scope: sview, offset: u32) = semantic_possible_import_alias_head_target(alias_name, import_scope, before_offset, table)
                return (false, false, 0) if not alias.known
                if alias.found:
                    # Binding metadata is the authoritative canonical destination. Also
                    # walk its source spelling with the bounded resolver so chains such as
                    # `First::Nested` expand their alias head without trusting a stale or
                    # ambiguous canonical fallback. The two paths must identify the same
                    # prefix before the remaining literal suffix is appended.
                    canonical_prefix: (matches: bool, end: usize) = semantic_import_module_path_prefix_matches(candidate_owner, alias.target, alias.scope)
                    source_prefix: (known: bool, matches: bool, end: usize) = semantic_possible_import_alias_target_prefix(candidate_owner, alias.raw_target, alias.scope, alias.offset, table, depth + 1.u32())
                    return (false, false, 0) if not source_prefix.known
                    return (false, false, 0) if source_prefix.matches != canonical_prefix.matches
                    return (false, false, 0) if source_prefix.matches and source_prefix.end != canonical_prefix.end
                    return (true, false, 0) if not canonical_prefix.matches
                    appended: (matches: bool, end: usize) = semantic_import_path_append_prefix_matches(candidate_owner, canonical_prefix.end, suffix)
                    return (true, appended.matches, appended.end)
                direct: (matches: bool, end: usize) = semantic_import_module_path_prefix_matches(candidate_owner, target_path, import_scope)
                return (true, direct.matches, direct.end)


        def semantic_possible_import_alias_target_matches(candidate_owner: sview, target_path: sview, suffix: sview, import_scope: sview, before_offset: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                target_prefix: (known: bool, matches: bool, end: usize) = semantic_possible_import_alias_target_prefix(candidate_owner, target_path, import_scope, before_offset, table)
                return true if not target_prefix.known
                return false if not target_prefix.matches
                appended: (matches: bool, end: usize) = semantic_import_path_append_prefix_matches(candidate_owner, target_prefix.end, suffix)
                return appended.matches and appended.end == candidate_owner.len


        def semantic_possible_import_alias_target_head_status(target_path: sview, import_scope: sview, before_offset: u32, table: SymbolTable&) -> (known: bool, found: bool):
            can Abort.Panic:
                head_length: mutable usize = target_path.len
                for index in 0..<target_path.len:
                    if index + 1.usize() < target_path.len and target_path[index] == 58 and target_path[index + 1.usize()] == 58:
                        head_length <- index
                        break
                alias_name: sview = string_view_slice(target_path, 0, head_length.i64())
                return (true, false) if alias_name == ""
                alias: (known: bool, found: bool, target: sview, raw_target: sview, scope: sview, offset: u32) = semantic_possible_import_alias_head_target(alias_name, import_scope, before_offset, table)
                return (alias.known, alias.found)


        # This matcher accepts only the selected alias route. An unknown alias head is
        # conservatively possible; a known absent head is left for raw-path fallback.
        def semantic_possible_import_alias_target_alias_matches(candidate_owner: sview, target_path: sview, import_scope: sview, before_offset: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                head: (known: bool, found: bool) = semantic_possible_import_alias_target_head_status(target_path, import_scope, before_offset, table)
                return true if not head.known
                return false if not head.found
                return semantic_possible_import_alias_target_matches(candidate_owner, target_path, "", import_scope, before_offset, table)


        def semantic_import_alias_is_static_branch(alias: Ast::EnumAnnotation, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return any marker in table.protocol_annotations where marker.owner == "__static_if_branch" and marker.name == "__using_alias_static_branch" and marker.detail_name == alias.owner and marker.module == alias.module and marker.line == alias.line and marker.offset == alias.offset


        def semantic_possible_import_alias_branch_marker_at(alias: Ast::EnumAnnotation, ordinal: usize, table: SymbolTable&) -> (found: bool, identity: u32):
            can Abort.Panic:
                seen: mutable usize = 0
                for marker in table.protocol_annotations |seen, alias, ordinal|:
                    continue if marker.owner != "__static_if_branch" or marker.name != "__using_alias_static_branch" or marker.detail_name != alias.owner or marker.module != alias.module or marker.line != alias.line or marker.offset != alias.offset
                    return (false, marker.identity_id) if marker.identity_id == 4294967295
                    if seen == ordinal:
                        return (true, marker.identity_id)
                    seen <- seen + 1.usize()
                return (false, 0)


        def semantic_possible_import_alias_branch_marker_count(alias: Ast::EnumAnnotation, table: SymbolTable&) -> (known: bool, count: usize):
            can Abort.Panic:
                count: mutable usize = 0
                for marker in table.protocol_annotations |count, alias|:
                    continue if marker.owner != "__static_if_branch" or marker.name != "__using_alias_static_branch" or marker.detail_name != alias.owner or marker.module != alias.module or marker.line != alias.line or marker.offset != alias.offset
                    return (false, 0) if marker.identity_id == 4294967295
                    count <- count + 1.usize()
                return (true, count)


        def semantic_possible_import_alias_branch_stack_relation(left: Ast::EnumAnnotation, right: Ast::EnumAnnotation, table: SymbolTable&) -> (known: bool, shared_prefix: bool, identical: bool, left_count: usize, right_count: usize):
            can Abort.Panic:
                left_stack: (known: bool, count: usize) = semantic_possible_import_alias_branch_marker_count(left, table)
                right_stack: (known: bool, count: usize) = semantic_possible_import_alias_branch_marker_count(right, table)
                return (false, false, false, 0, 0) if not left_stack.known or not right_stack.known
                shared_prefix: mutable bool = true
                shared_count: usize = left_stack.count if left_stack.count < right_stack.count else right_stack.count
                for ordinal in 0..<shared_count |shared_prefix, left, right, table|:
                    left_marker: (found: bool, identity: u32) = semantic_possible_import_alias_branch_marker_at(left, ordinal, table)
                    right_marker: (found: bool, identity: u32) = semantic_possible_import_alias_branch_marker_at(right, ordinal, table)
                    shared_prefix <- false if not left_marker.found or not right_marker.found or left_marker.identity != right_marker.identity
                return (true, shared_prefix, shared_prefix and left_stack.count == right_stack.count, left_stack.count, right_stack.count)


        def semantic_possible_import_alias_is_definite(alias: Ast::EnumAnnotation, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return any row in table.definite_import_annotations where row.name == alias.name and row.owner == alias.owner and row.module == alias.module and row.line == alias.line and row.offset == alias.offset


        # Stage0 stores module aliases in one analyzer-wide map. Direct aliases in an
        # ancestor block register before aliases encountered while descending into its
        # children. Branch ancestry orders aliases that share an enclosing branch. Separate
        # branch roots may use source order only when both aliases survived into the definite
        # import view; a possible row remains unordered because it may be another arm.
        def semantic_possible_import_alias_precedes(left: Ast::EnumAnnotation, right: Ast::EnumAnnotation, table: SymbolTable&) -> (known: bool, precedes: bool):
            can Abort.Panic:
                return (true, false) if left.module == right.module and left.line == right.line and left.offset == right.offset
                left_is_branch: bool = semantic_import_alias_is_static_branch(left, table)
                right_is_branch: bool = semantic_import_alias_is_static_branch(right, table)
                branch_relation: mutable (known: bool, shared_prefix: bool, identical: bool, left_count: usize, right_count: usize) = (true, false, false, 0, 0)
                branch_relation <- semantic_possible_import_alias_branch_stack_relation(left, right, table) if left_is_branch and right_is_branch
                return (false, false) if left_is_branch and right_is_branch and not branch_relation.known
                both_definite: bool = left_is_branch and right_is_branch and semantic_possible_import_alias_is_definite(left, table) and semantic_possible_import_alias_is_definite(right, table)
                if left.module == right.module:
                    return (true, not left_is_branch) if left_is_branch != right_is_branch
                    if left_is_branch:
                        if branch_relation.shared_prefix:
                            return (true, branch_relation.left_count < branch_relation.right_count) if not branch_relation.identical
                        return (false, false) if not both_definite or left.offset == right.offset
                        return (true, left.offset < right.offset)
                    return (false, false) if left.offset == right.offset
                    return (true, left.offset < right.offset)
                if named_type_owner_is_lexical(left.module, right.module):
                    return (true, true) if not left_is_branch
                    if not right_is_branch:
                        return (false, false) if left.offset == right.offset
                        return (true, left.offset < right.offset)
                    if right_is_branch and branch_relation.shared_prefix:
                        return (true, true) if branch_relation.left_count <= branch_relation.right_count
                    return (false, false)
                if named_type_owner_is_lexical(right.module, left.module):
                    return (true, false) if not right_is_branch
                    if not left_is_branch:
                        return (false, false) if left.offset == right.offset
                        return (true, left.offset < right.offset)
                    if left_is_branch and branch_relation.shared_prefix:
                        return (true, false) if branch_relation.right_count <= branch_relation.left_count
                    return (false, false)
                if left_is_branch and right_is_branch and not branch_relation.shared_prefix:
                    return (false, false) if not both_definite or left.offset == right.offset
                return (false, false) if left.offset == right.offset
                return (true, left.offset < right.offset)


        # Symbol-table projections must expose only the alias Core kept in its
        # analyzer-wide first-registration map. Any earlier definite row, or any
        # possible row whose order is not proven later, prevents this declaration
        # from supplying a definite module symbol/member projection.
        def semantic_import_alias_pair_target(alias: Ast::EnumAnnotation, table: SymbolTable&) -> (known: bool, target: sview):
            can Abort.Panic:
                return (false, "") if alias.name != "__using_alias"
                alias_count: mutable usize = 0.usize()
                definite_alias_count: mutable usize = 0.usize()
                for candidate in table.definite_import_annotations |alias_count, definite_alias_count, alias|:
                    if candidate.name == "__using_alias" and candidate.module == alias.module and candidate.line == alias.line and candidate.offset == alias.offset:
                        alias_count <- alias_count + 1.usize()
                        definite_alias_count <- definite_alias_count + 1.usize()
                for candidate in table.possible_import_annotations |alias_count, alias|:
                    alias_count <- alias_count + 1.usize() if candidate.name == "__using_alias" and candidate.module == alias.module and candidate.line == alias.line and candidate.offset == alias.offset
                return (false, "") if alias_count != 1.usize() or definite_alias_count != 1.usize()
                target_owner: mutable sview = ""
                target_count: mutable usize = 0.usize()
                definite_target_count: mutable usize = 0.usize()
                for target in table.definite_import_annotations |target_owner, target_count, definite_target_count, alias|:
                    if target.name == "__using_alias_target" and target.module == alias.module and target.line == alias.line and target.offset == alias.offset:
                        target_owner <- target.owner
                        target_count <- target_count + 1.usize()
                        definite_target_count <- definite_target_count + 1.usize()
                for target in table.possible_import_annotations |target_owner, target_count, alias|:
                    if target.name == "__using_alias_target" and target.module == alias.module and target.line == alias.line and target.offset == alias.offset:
                        target_owner <- target.owner
                        target_count <- target_count + 1.usize()
                return (false, "") if target_count != 1.usize() or definite_target_count != 1.usize() or target_owner == ""
                return (true, target_owner)


        def semantic_import_alias_is_global_winner(alias: Ast::EnumAnnotation, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if alias.name != "__using_alias"
                return false if not semantic_possible_import_alias_is_definite(alias, table)
                pair: (known: bool, target: sview) = semantic_import_alias_pair_target(alias, table)
                return false if not pair.known
                for candidate in table.definite_import_annotations |alias, table|:
                    continue if candidate.name != "__using_alias" or candidate.owner != alias.owner
                    continue if candidate.module == alias.module and candidate.line == alias.line and candidate.offset == alias.offset
                    order: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes(candidate, alias, table)
                    return false if not order.known or order.precedes
                for candidate in table.possible_import_annotations |alias, table|:
                    continue if candidate.name != "__using_alias" or candidate.owner != alias.owner
                    continue if candidate.module == alias.module and candidate.line == alias.line and candidate.offset == alias.offset
                    order: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes(candidate, alias, table)
                    return false if not order.known or order.precedes
                return true


        # Alias targets are paired by module, line, and offset. A malformed or split
        # pair must not create a Module symbol, imported-module cache entry, or mirrored
        # target member; callers keep the original rows in the raw annotation tables.
        def semantic_import_alias_target_is_global_winner(target: Ast::EnumAnnotation, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if target.name != "__using_alias_target"
                alias_name: mutable sview = ""
                alias_count: mutable usize = 0.usize()
                definite_alias_count: mutable usize = 0.usize()
                for alias in table.definite_import_annotations |alias_name, alias_count, definite_alias_count, target|:
                    if alias.name == "__using_alias" and alias.module == target.module and alias.line == target.line and alias.offset == target.offset:
                        alias_name <- alias.owner
                        alias_count <- alias_count + 1.usize()
                        definite_alias_count <- definite_alias_count + 1.usize()
                for alias in table.possible_import_annotations |alias_name, alias_count, target|:
                    if alias.name == "__using_alias" and alias.module == target.module and alias.line == target.line and alias.offset == target.offset:
                        alias_name <- alias.owner
                        alias_count <- alias_count + 1.usize()
                return false if alias_count != 1.usize() or definite_alias_count != 1.usize()
                alias: Ast::EnumAnnotation = Ast::EnumAnnotation{owner: alias_name, name: "__using_alias", module: target.module, line: target.line, offset: target.offset}
                pair: (known: bool, target: sview) = semantic_import_alias_pair_target(alias, table)
                return false if not pair.known or pair.target != target.owner
                return semantic_import_alias_is_global_winner(alias, table)


        # The imported-module and member projections need the canonical owner produced by
        # binding alias resolution, not the raw spelling (which may name an alias chain).
        def semantic_import_alias_target_canonical_owner(target: Ast::EnumAnnotation, table: SymbolTable&) -> sview:
            can Abort.Panic:
                return "" if not semantic_import_alias_target_is_global_winner(target, table)
                canonical_owner: mutable sview = ""
                canonical_count: mutable usize = 0.usize()
                for binding_target in table.binding_import_annotations |canonical_owner, canonical_count, target|:
                    if binding_target.name == "__using_alias_target" and binding_target.module == target.module and binding_target.line == target.line and binding_target.offset == target.offset:
                        canonical_owner <- binding_target.owner
                        canonical_count <- canonical_count + 1.usize()
                return "" if canonical_count != 1.usize() or canonical_owner == ""
                return canonical_owner


        # Alias syntax emits a legacy `__using` row at the target token as well as the
        # `__using_alias` pair at the alias token. Keep that raw row in both import views,
        # but do not project it as an ordinary imported module: the canonical alias target
        # row is the winner-checked projection. The next same-scope `__using` row bounds
        # comma-separated items on one logical line.
        def semantic_import_using_row_has_alias_pair(using_row: Ast::EnumAnnotation, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if using_row.name != "__using"
                next_using_offset: mutable u32 = 4294967295
                for candidate in table.definite_import_annotations |next_using_offset, using_row|:
                    continue if candidate.name != "__using" or candidate.module != using_row.module or candidate.line != using_row.line or candidate.offset <= using_row.offset
                    next_using_offset <- candidate.offset if candidate.offset < next_using_offset
                for candidate in table.possible_import_annotations |next_using_offset, using_row|:
                    continue if candidate.name != "__using" or candidate.module != using_row.module or candidate.line != using_row.line or candidate.offset <= using_row.offset
                    next_using_offset <- candidate.offset if candidate.offset < next_using_offset
                for target_row in table.definite_import_annotations |using_row, next_using_offset, table|:
                    continue if target_row.name != "__using_alias_target" or target_row.owner != using_row.owner or target_row.module != using_row.module or target_row.line != using_row.line or target_row.offset <= using_row.offset or target_row.offset >= next_using_offset
                    for alias_row in table.definite_import_annotations:
                        return true if alias_row.name == "__using_alias" and alias_row.module == target_row.module and alias_row.line == target_row.line and alias_row.offset == target_row.offset
                    for alias_row in table.possible_import_annotations:
                        return true if alias_row.name == "__using_alias" and alias_row.module == target_row.module and alias_row.line == target_row.line and alias_row.offset == target_row.offset
                for target_row in table.possible_import_annotations |using_row, next_using_offset, table|:
                    continue if target_row.name != "__using_alias_target" or target_row.owner != using_row.owner or target_row.module != using_row.module or target_row.line != using_row.line or target_row.offset <= using_row.offset or target_row.offset >= next_using_offset
                    for alias_row in table.definite_import_annotations:
                        return true if alias_row.name == "__using_alias" and alias_row.module == target_row.module and alias_row.line == target_row.line and alias_row.offset == target_row.offset
                    for alias_row in table.possible_import_annotations:
                        return true if alias_row.name == "__using_alias" and alias_row.module == target_row.module and alias_row.line == target_row.line and alias_row.offset == target_row.offset
                return false


        # Possible alias targets are eligible only when their unique alias row is
        # still able to win the global map at the lookup site. The target spelling is
        # resolved separately at its declaration offset, so aliases used inside that
        # target cannot see later registrations.
        def semantic_possible_import_alias_target_row_can_win(target_row: Ast::EnumAnnotation, current_scope: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if target_row.name != "__using_alias_target"
                alias: mutable Ast::EnumAnnotation = Ast::EnumAnnotation{owner: "", name: "__using_alias", module: target_row.module, line: target_row.line, offset: target_row.offset}
                alias_count: mutable usize = 0.usize()
                target_count: mutable usize = 0.usize()
                paired_target_owner: mutable sview = ""
                for candidate in table.definite_import_annotations |alias, alias_count, target_count, paired_target_owner, target_row|:
                    if candidate.name == "__using_alias" and candidate.module == target_row.module and candidate.line == target_row.line and candidate.offset == target_row.offset:
                        alias <- candidate
                        alias_count <- alias_count + 1.usize()
                    if candidate.name == "__using_alias_target" and candidate.module == target_row.module and candidate.line == target_row.line and candidate.offset == target_row.offset:
                        paired_target_owner <- candidate.owner
                        target_count <- target_count + 1.usize()
                for candidate in table.possible_import_annotations |alias, alias_count, target_count, paired_target_owner, target_row|:
                    if candidate.name == "__using_alias" and candidate.module == target_row.module and candidate.line == target_row.line and candidate.offset == target_row.offset:
                        alias <- candidate
                        alias_count <- alias_count + 1.usize()
                    if candidate.name == "__using_alias_target" and candidate.module == target_row.module and candidate.line == target_row.line and candidate.offset == target_row.offset:
                        paired_target_owner <- candidate.owner
                        target_count <- target_count + 1.usize()
                return false if alias_count != 1.usize() or target_count != 1.usize() or alias.owner == "" or paired_target_owner == "" or paired_target_owner != target_row.owner
                return semantic_possible_import_alias_can_win(alias, current_scope, 4294967295, table)


        # Compare an alias with a declaration cutoff. Alias-to-alias cutoffs use the
        # registration comparator above, including ancestor pre-registration. Other
        # declaration cutoffs use global source order, with the same direct-ancestor
        # prepass rule. The max offset is the post-registration lookup used by bodies.
        def semantic_possible_import_alias_precedes_position(alias: Ast::EnumAnnotation, scope: sview, before_offset: u32, table: SymbolTable&) -> (known: bool, precedes: bool):
            can Abort.Panic:
                return (true, true) if before_offset == 4294967295
                for requester in table.definite_import_annotations:
                    if requester.name == "__using_alias" and requester.module == scope and requester.offset == before_offset:
                        return semantic_possible_import_alias_precedes(alias, requester, table)
                for requester in table.possible_import_annotations:
                    if requester.name == "__using_alias" and requester.module == scope and requester.offset == before_offset:
                        return semantic_possible_import_alias_precedes(alias, requester, table)
                alias_is_branch: bool = semantic_import_alias_is_static_branch(alias, table)
                if alias.module == scope:
                    return (true, alias.offset < before_offset) if alias_is_branch
                    return (true, true)
                if named_type_owner_is_lexical(alias.module, scope):
                    return (false, false) if alias_is_branch
                    return (true, true)
                return (false, false) if alias.offset == before_offset
                return (true, alias.offset < before_offset)


        # An unresolved branch alias matters only if it can still win the global alias
        # map at this declaration. A definite alias registered earlier always shadows it.
        def semantic_possible_import_alias_can_win(alias: Ast::EnumAnnotation, import_scope: sview, before_offset: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                candidate_before: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes_position(alias, import_scope, before_offset, table)
                return false if candidate_before.known and not candidate_before.precedes
                selected_found: mutable bool = false
                found_prior: mutable bool = false
                winner_ambiguous: mutable bool = false
                selected: mutable Ast::EnumAnnotation = alias
                for candidate in table.definite_import_annotations |selected_found, selected, alias, import_scope, before_offset, table|:
                    continue if candidate.name != "__using_alias" or candidate.owner != alias.owner
                    before_position: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes_position(candidate, import_scope, before_offset, table)
                    continue if not before_position.known or not before_position.precedes
                    found_prior <- true
                    candidate_wins: mutable bool = true
                    for other in table.definite_import_annotations |candidate_wins, candidate, alias, import_scope, before_offset, table|:
                        continue if other.name != "__using_alias" or other.owner != alias.owner
                        continue if other.module == candidate.module and other.line == candidate.line and other.offset == candidate.offset
                        other_before_position: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes_position(other, import_scope, before_offset, table)
                        continue if other_before_position.known and not other_before_position.precedes
                        order: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes(other, candidate, table)
                        candidate_wins <- false if not order.known or order.precedes
                    if candidate_wins:
                        winner_ambiguous <- true if selected_found
                        selected <- candidate
                        selected_found <- true
                return true if found_prior and (not selected_found or winner_ambiguous)
                if selected_found:
                    for candidate in table.definite_import_annotations |selected, alias, import_scope, before_offset, table|:
                        continue if candidate.name != "__using_alias" or candidate.owner != alias.owner
                        continue if candidate.module == selected.module and candidate.line == selected.line and candidate.offset == selected.offset
                        before_position: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes_position(candidate, import_scope, before_offset, table)
                        continue if before_position.known and not before_position.precedes
                        order: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes(candidate, selected, table)
                        return true if not order.known or order.precedes
                    order: (known: bool, precedes: bool) = semantic_possible_import_alias_precedes(alias, selected, table)
                    return true if not order.known or order.precedes
                    return false
                return not candidate_before.known or candidate_before.precedes


        # Binding metadata may store an empty/canonical fallback when a prior alias
        # head is branch-unknown. Consult the source target before trusting that fallback.
        def semantic_possible_import_alias_dependency_exists(target_path: sview, import_scope: sview, before_offset: u32, table: SymbolTable&, depth: u32 = 0) -> bool:
            can Abort.Panic:
                return true if depth >= 64
                head_length: mutable usize = target_path.len
                for index in 0..<target_path.len:
                    if index + 1.usize() < target_path.len and target_path[index] == 58 and target_path[index + 1.usize()] == 58:
                        head_length <- index
                        break
                alias_name: sview = string_view_slice(target_path, 0, head_length.i64())
                alias: (known: bool, found: bool, target: sview, raw_target: sview, scope: sview, offset: u32) = semantic_possible_import_alias_head_target(alias_name, import_scope, before_offset, table)
                return true if not alias.known
                return false if not alias.found
                return semantic_possible_import_alias_dependency_exists(alias.raw_target, alias.scope, alias.offset, table, depth + 1.u32())


        def semantic_possible_import_alias_module_path_matches(candidate_owner: sview, target: sview, import_scope: sview, before_offset: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                head_length: mutable usize = target.len
                for index in 0..<target.len:
                    if index + 1.usize() < target.len and target[index] == 58 and target[index + 1.usize()] == 58:
                        head_length <- index
                        break
                alias_name: sview = string_view_slice(target, 0, head_length.i64())
                suffix: sview = string_view_slice(target, (head_length + 2.usize()).i64(), target.len.i64()) if head_length < target.len else ""
                for alias in table.possible_import_annotations |candidate_owner, alias_name, suffix, import_scope, before_offset, table|:
                    continue if alias.name != "__using_alias" or alias.owner != alias_name
                    continue if not semantic_possible_import_alias_can_win(alias, import_scope, before_offset, table)
                    for target_row in table.possible_import_annotations:
                        continue if target_row.name != "__using_alias_target" or target_row.module != alias.module or target_row.line != alias.line or target_row.offset != alias.offset
                        return true if semantic_possible_import_alias_target_matches(candidate_owner, target_row.owner, suffix, target_row.module, target_row.offset, table)
                for alias in table.binding_import_annotations |candidate_owner, alias_name, suffix, import_scope, before_offset, table|:
                    continue if alias.name != "__using_alias" or alias.owner != alias_name
                    continue if not semantic_possible_import_alias_can_win(alias, import_scope, before_offset, table)
                    for raw_target_row in table.definite_import_annotations:
                        continue if raw_target_row.name != "__using_alias_target" or raw_target_row.module != alias.module or raw_target_row.line != alias.line or raw_target_row.offset != alias.offset
                        return true if semantic_possible_import_alias_dependency_exists(raw_target_row.owner, alias.module, alias.offset, table)
                        return true if semantic_possible_import_alias_target_matches(candidate_owner, raw_target_row.owner, suffix, raw_target_row.module, raw_target_row.offset, table)
                return false


        def semantic_possible_import_module_visible(table: SymbolTable&, owner: sview, current_scope: sview) -> bool:
            can Abort.Panic:
                for annotation in table.possible_import_annotations |owner, current_scope, table|:
                    continue if not semantic_import_scope_visible(annotation.module, current_scope)
                    if annotation.name == "__using_alias_target":
                        continue if not semantic_possible_import_alias_target_row_can_win(annotation, current_scope, table)
                        return true if semantic_possible_import_module_path_module_candidate_matches(table, owner, annotation.owner, annotation.module, annotation.offset)
                    elif annotation.name == "__using":
                        continue if semantic_import_using_row_has_alias_pair(annotation, table)
                        return true if semantic_possible_import_module_path_module_candidate_matches(table, owner, annotation.owner, annotation.module, annotation.offset)
                    elif annotation.name == "__binding_wildcard_import":
                        return true if semantic_possible_import_module_path_module_candidate_matches(table, owner, annotation.owner, annotation.module, annotation.offset)
                return false


        def semantic_possible_import_member_visible(table: SymbolTable&, name: sview, current_scope: sview) -> bool:
            can Abort.Panic:
                return any annotation in table.possible_import_annotations where annotation.owner == "__from_member" and annotation.name == name and semantic_import_scope_visible(annotation.module, current_scope)


        def semantic_possible_import_module_alias(table: SymbolTable&, alias_name: sview, current_scope: sview) -> bool:
            can Abort.Panic:
                return any annotation in table.possible_import_annotations where annotation.name == "__using_alias" and annotation.owner == alias_name and semantic_possible_import_alias_can_win(annotation, current_scope, 4294967295, table)


        def semantic_possible_import_member_owner_visible(table: SymbolTable&, owner: sview, name: sview, current_scope: sview) -> bool:
            can Abort.Panic:
                for annotation in table.possible_import_annotations |owner, name, current_scope, table|:
                    continue if annotation.owner != "__from_member" or annotation.name != name or not semantic_import_scope_visible(annotation.module, current_scope)
                    for source in table.possible_import_annotations:
                        continue if source.owner != "__from_src" or source.module != annotation.module or source.line != annotation.line or source.offset != annotation.offset
                        return true if semantic_possible_import_module_path_candidate_matches(table, owner, source.name, name, source.module, source.offset)
                return false


        # Match a module's member with Core's candidate-level fallback: use the alias
        # target when it supplies this queried member, then try the written raw path only
        # when no matching member exists under the selected alias target.
        def semantic_possible_import_module_path_alias_member_visible(table: SymbolTable&, target_path: sview, name: sview, import_scope: sview, before_offset: u32) -> bool:
            can Abort.Panic:
                return true if any symbol in table.symbols where symbol.name == name and symbol.kind != SymbolKind.Module and semantic_possible_import_alias_target_alias_matches(symbol.module_owner, target_path, import_scope, before_offset, table)
                member_row: mutable u32 = member_chain_head(table, name)
                while member_row != SYMBOL_INDEX_ROW_NONE |member_row, target_path, name, import_scope, before_offset, table|:
                    member_index: usize = member_row.usize()
                    return true if table.module_member_name[member_index] == name and semantic_possible_import_alias_target_alias_matches(table.module_member_owner[member_index], target_path, import_scope, before_offset, table)
                    member_row <- table.member_name_next[member_index]
                return false


        def semantic_possible_import_module_path_member_visible(table: SymbolTable&, target_path: sview, name: sview, import_scope: sview, before_offset: u32) -> bool:
            can Abort.Panic:
                alias_head: (known: bool, found: bool) = semantic_possible_import_alias_target_head_status(target_path, import_scope, before_offset, table)
                return true if not alias_head.known
                if alias_head.found:
                    return true if semantic_possible_import_module_path_alias_member_visible(table, target_path, name, import_scope, before_offset)
                return true if any symbol in table.symbols where symbol.name == name and symbol.kind != SymbolKind.Module and semantic_import_module_path_matches(symbol.module_owner, target_path, import_scope)
                member_row: mutable u32 = member_chain_head(table, name)
                while member_row != SYMBOL_INDEX_ROW_NONE |member_row, target_path, name, import_scope, before_offset|:
                    member_index: usize = member_row.usize()
                    return true if table.module_member_name[member_index] == name and semantic_import_module_path_matches(table.module_member_owner[member_index], target_path, import_scope)
                    member_row <- table.member_name_next[member_index]
                return false


        # For one candidate, first ask whether Core would find any same-name candidate
        # under the selected alias target. Only if that search is empty can the raw path
        # select this candidate. Unknown alias resolution stays possible for this candidate.
        def semantic_possible_import_module_path_candidate_matches(table: SymbolTable&, candidate_owner: sview, target_path: sview, name: sview, import_scope: sview, before_offset: u32) -> bool:
            can Abort.Panic:
                alias_head: (known: bool, found: bool) = semantic_possible_import_alias_target_head_status(target_path, import_scope, before_offset, table)
                return true if not alias_head.known
                if alias_head.found and semantic_possible_import_module_path_alias_member_visible(table, target_path, name, import_scope, before_offset):
                    return semantic_possible_import_alias_target_alias_matches(candidate_owner, target_path, import_scope, before_offset, table)
                return semantic_import_module_path_matches(candidate_owner, target_path, import_scope)


        def semantic_possible_import_module_symbol_is_using_alias(symbol: Symbol, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return any alias in table.definite_import_annotations where alias.name == "__using_alias" and alias.owner == symbol.name and alias.line == symbol.line and alias.offset == symbol.offset


        def semantic_possible_import_module_path_alias_module_visible(table: SymbolTable&, target_path: sview, import_scope: sview, before_offset: u32) -> bool:
            can Abort.Panic:
                for module_row in table.module_symbol_rows:
                    symbol: Symbol = table.symbols[module_row.usize()]
                    continue if semantic_possible_import_module_symbol_is_using_alias(symbol, table)
                    return true if semantic_possible_import_alias_target_alias_matches(symbol.name, target_path, import_scope, before_offset, table)
                return false


        def semantic_possible_import_module_path_module_candidate_matches(table: SymbolTable&, candidate_owner: sview, target_path: sview, import_scope: sview, before_offset: u32) -> bool:
            can Abort.Panic:
                alias_head: (known: bool, found: bool) = semantic_possible_import_alias_target_head_status(target_path, import_scope, before_offset, table)
                return true if not alias_head.known
                if alias_head.found and semantic_possible_import_module_path_alias_module_visible(table, target_path, import_scope, before_offset):
                    return semantic_possible_import_alias_target_alias_matches(candidate_owner, target_path, import_scope, before_offset, table)
                return semantic_import_module_path_matches(candidate_owner, target_path, import_scope)


        def semantic_possible_import_type_path_candidate_matches(table: SymbolTable&, candidate_owner: sview, target_path: sview, name: sview, kind: SymbolKind, include_constants: bool, import_scope: sview, before_offset: u32) -> bool:
            can Abort.Panic:
                alias_head: (known: bool, found: bool) = semantic_possible_import_alias_target_head_status(target_path, import_scope, before_offset, table)
                return true if not alias_head.known
                if alias_head.found:
                    alias_candidate_exists: bool = any symbol in table.symbols where symbol.name == name and (symbol.kind == kind or include_constants and symbol.kind == SymbolKind.Const) and semantic_possible_import_alias_target_alias_matches(symbol.module_owner, target_path, import_scope, before_offset, table)
                    if alias_candidate_exists:
