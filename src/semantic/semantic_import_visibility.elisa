# Static-branch imports have two visibility states. The ordinary imported_* arrays
# record only imports proven active; unresolved rows live in possible_import_annotations
# and are consulted here only to avoid choosing a definite result that may change.
extend Semantic:
    private:
        def semantic_is_synthetic_unknown_import_marker(annotation: Ast::EnumAnnotation) -> bool:
            can Abort.Panic:
                return annotation.owner == "__pma_unknown_static_import" and annotation.detail_name != ""


        def semantic_import_scope_visible(import_scope: sview, current_scope: sview) -> bool:
            can Abort.Panic:
                return import_scope == "" or import_scope == current_scope or (
                    current_scope.len >= import_scope.len + 2.usize() and
                    current_scope[import_scope.len] == 58 and current_scope[import_scope.len + 1.usize()] == 58 and
                    (forall index in 0..<import_scope.len:
                        import_scope[index] == current_scope[index]
                    )
                )


        # Match an imported module spelling against a canonical owner without allocating
        # a joined name. Relative targets are checked at the import scope and each ancestor.
        def semantic_import_module_path_matches(candidate_owner: sview, target: sview, import_scope: sview) -> bool:
            can Abort.Panic:
                return false if candidate_owner == "" or target == ""
                return true if candidate_owner == target
                prefix_length: mutable usize = import_scope.len
                while prefix_length > 0 |prefix_length, candidate_owner, target, import_scope|:
                    at_scope_boundary: bool = prefix_length == import_scope.len or (prefix_length + 1.usize() < import_scope.len and import_scope[prefix_length] == 58 and import_scope[prefix_length + 1.usize()] == 58)
                    expected_length: usize = prefix_length + 2.usize() + target.len
                    if at_scope_boundary and candidate_owner.len == expected_length:
                        matches_prefix: mutable bool = true
                        for index in 0..<prefix_length |matches_prefix, candidate_owner, import_scope|:
                            matches_prefix <- false if candidate_owner[index] != import_scope[index]
                        if matches_prefix and candidate_owner[prefix_length] == 58 and candidate_owner[prefix_length + 1.usize()] == 58:
                            matches_target: mutable bool = true
                            for index in 0..<target.len |matches_target, candidate_owner, target, prefix_length|:
                                matches_target <- false if candidate_owner[prefix_length + 2.usize() + index] != target[index]
                            return true if matches_target
                    prefix_length <- prefix_length - 1.usize()
                return false


        def semantic_import_module_path_with_suffix_matches(candidate_owner: sview, target: sview, suffix: sview, import_scope: sview) -> bool:
            can Abort.Panic:
                return semantic_import_module_path_matches(candidate_owner, target, import_scope) if suffix == ""
                tail_length: usize = target.len + 2.usize() + suffix.len
                if candidate_owner.len == tail_length:
                    matches_target: mutable bool = true
                    for index in 0..<target.len |matches_target, candidate_owner, target|:
                        matches_target <- false if candidate_owner[index] != target[index]
                    matches_separator: bool = candidate_owner[target.len] == 58 and candidate_owner[target.len + 1.usize()] == 58
                    matches_suffix: mutable bool = matches_target and matches_separator
                    for index in 0..<suffix.len |matches_suffix, candidate_owner, suffix, target|:
                        matches_suffix <- false if candidate_owner[target.len + 2.usize() + index] != suffix[index]
                    return true if matches_suffix
                prefix_length: mutable usize = import_scope.len
                while prefix_length > 0 |prefix_length, candidate_owner, target, suffix, import_scope, tail_length|:
                    at_scope_boundary: bool = prefix_length == import_scope.len or (prefix_length + 1.usize() < import_scope.len and import_scope[prefix_length] == 58 and import_scope[prefix_length + 1.usize()] == 58)
                    expected_length: usize = prefix_length + 2.usize() + tail_length
                    if at_scope_boundary and candidate_owner.len == expected_length:
                        matches_prefix: mutable bool = true
                        for index in 0..<prefix_length |matches_prefix, candidate_owner, import_scope|:
                            matches_prefix <- false if candidate_owner[index] != import_scope[index]
                        if matches_prefix and candidate_owner[prefix_length] == 58 and candidate_owner[prefix_length + 1.usize()] == 58:
                            matches_target: mutable bool = true
                            for index in 0..<target.len |matches_target, candidate_owner, target, prefix_length|:
                                matches_target <- false if candidate_owner[prefix_length + 2.usize() + index] != target[index]
                            target_end: usize = prefix_length + 2.usize() + target.len
                            matches_suffix_separator: bool = candidate_owner[target_end] == 58 and candidate_owner[target_end + 1.usize()] == 58
                            matches_suffix: mutable bool = matches_target and matches_suffix_separator
                            for index in 0..<suffix.len |matches_suffix, candidate_owner, suffix, target_end|:
                                matches_suffix <- false if candidate_owner[target_end + 2.usize() + index] != suffix[index]
                            return true if matches_suffix
                    prefix_length <- prefix_length - 1.usize()
                return false


        def semantic_possible_import_alias_module_path_matches(candidate_owner: sview, target: sview, import_scope: sview, before_offset: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                head_length: mutable usize = target.len
                for index in 0..<target.len:
                    if index + 1.usize() < target.len and target[index] == 58 and target[index + 1.usize()] == 58:
                        head_length <- index
                        break
                alias_name: sview = string_view_slice(target, 0, head_length.i64())
                suffix: sview = string_view_slice(target, (head_length + 2.usize()).i64(), target.len.i64()) if head_length < target.len else ""
                for alias in table.possible_import_annotations |candidate_owner, alias_name, suffix, import_scope, before_offset, table|:
                    continue if alias.name != "__using_alias" or alias.owner != alias_name or alias.offset >= before_offset or not semantic_import_scope_visible(alias.module, import_scope)
                    for target_row in table.possible_import_annotations:
                        continue if target_row.name != "__using_alias_target" or target_row.module != alias.module or target_row.line != alias.line or target_row.offset != alias.offset
                        return true if semantic_import_module_path_with_suffix_matches(candidate_owner, target_row.owner, suffix, target_row.module)
                for alias in table.binding_import_annotations |candidate_owner, alias_name, suffix, import_scope, before_offset, table|:
                    continue if alias.name != "__using_alias" or alias.owner != alias_name or alias.offset >= before_offset or not semantic_import_scope_visible(alias.module, import_scope)
                    for target_row in table.binding_import_annotations:
                        continue if target_row.name != "__using_alias_target" or target_row.module != alias.module or target_row.line != alias.line or target_row.offset != alias.offset
                        return true if semantic_import_module_path_with_suffix_matches(candidate_owner, target_row.owner, suffix, target_row.module)
                return false


        def semantic_possible_import_module_visible(table: SymbolTable&, owner: sview, current_scope: sview) -> bool:
            can Abort.Panic:
                for annotation in table.possible_import_annotations |owner, current_scope, table|:
                    continue if not semantic_import_scope_visible(annotation.module, current_scope)
                    module_import: bool = annotation.name == "__using" or annotation.name == "__using_alias_target" or annotation.name == "__binding_wildcard_import"
                    continue if not module_import
                    return true if semantic_import_module_path_matches(owner, annotation.owner, annotation.module) or semantic_possible_import_alias_module_path_matches(owner, annotation.owner, annotation.module, annotation.offset, table)
                return false


        def semantic_possible_import_member_visible(table: SymbolTable&, name: sview, current_scope: sview) -> bool:
            can Abort.Panic:
                return any annotation in table.possible_import_annotations where annotation.owner == "__from_member" and annotation.name == name and semantic_import_scope_visible(annotation.module, current_scope)


        def semantic_possible_import_module_alias(table: SymbolTable&, alias_name: sview, current_scope: sview) -> bool:
            can Abort.Panic:
                return any annotation in table.possible_import_annotations where annotation.name == "__using_alias" and annotation.owner == alias_name and semantic_import_scope_visible(annotation.module, current_scope)


        def semantic_possible_import_member_owner_visible(table: SymbolTable&, owner: sview, name: sview, current_scope: sview) -> bool:
            can Abort.Panic:
                for annotation in table.possible_import_annotations |owner, name, current_scope, table|:
                    continue if annotation.owner != "__from_member" or annotation.name != name or not semantic_import_scope_visible(annotation.module, current_scope)
                    for source in table.possible_import_annotations:
                        continue if source.owner != "__from_src" or source.module != annotation.module or source.line != annotation.line or source.offset != annotation.offset
                        return true if semantic_import_module_path_matches(owner, source.name, source.module) or semantic_possible_import_alias_module_path_matches(owner, source.name, source.module, source.offset, table)
                return false


        def semantic_possible_import_module_member_visible(table: SymbolTable&, owner: sview, name: sview, current_scope: sview) -> bool:
            can Abort.Panic:
                if semantic_possible_import_module_visible(table, owner, current_scope):
                    return true if any symbol in table.symbols where symbol.name == name and symbol.kind != SymbolKind.Module and (semantic_import_module_path_matches(symbol.module_owner, owner, current_scope) or semantic_possible_import_alias_module_path_matches(symbol.module_owner, owner, current_scope, 4294967295, table))
                    member_row: mutable u32 = member_chain_head(table, name)
                    while member_row != SYMBOL_INDEX_ROW_NONE |member_row, owner, name, table|:
                        member_index: usize = member_row.usize()
                        return true if table.module_member_name[member_index] == name and (semantic_import_module_path_matches(table.module_member_owner[member_index], owner, current_scope) or semantic_possible_import_alias_module_path_matches(table.module_member_owner[member_index], owner, current_scope, 4294967295, table))
                        member_row <- table.member_name_next[member_index]
                for alias in table.possible_import_annotations |owner, name, current_scope, table|:
                    continue if alias.name != "__using_alias" or alias.owner != owner or not semantic_import_scope_visible(alias.module, current_scope)
                    for target in table.possible_import_annotations:
                        continue if target.name != "__using_alias_target" or target.module != alias.module or target.line != alias.line or target.offset != alias.offset
                        target_owner: sview = target.owner
                        member_row <- member_chain_head(table, name)
                        while member_row != SYMBOL_INDEX_ROW_NONE |member_row, target_owner, name, table|:
                            member_index: usize = member_row.usize()
                            return true if table.module_member_name[member_index] == name and (semantic_import_module_path_matches(table.module_member_owner[member_index], target_owner, target.module) or semantic_possible_import_alias_module_path_matches(table.module_member_owner[member_index], target_owner, target.module, target.offset, table))
                            member_row <- table.member_name_next[member_index]
                return false


        # A possible import makes the bare name unresolved in the semantic sense: it may
        # become visible, but it cannot establish module-only classification or an owner.
        def semantic_possible_import_name_visible(table: SymbolTable&, name: sview, current_scope: sview) -> bool:
            can Abort.Panic:
                return true if semantic_possible_import_member_visible(table, name, current_scope)
                return true if semantic_possible_import_module_alias(table, name, current_scope)
                for annotation in table.possible_import_annotations:
                    module_import: bool = annotation.name == "__using" or annotation.name == "__using_alias_target" or annotation.name == "__binding_wildcard_import"
                    if module_import and semantic_import_scope_visible(annotation.module, current_scope):
                        return true if semantic_possible_import_module_member_visible(table, annotation.owner, name, current_scope)
                return false


        # Used by exact nominal-owner selectors: if a possible import names a candidate
        # declaration, callers must decline instead of selecting that owner as definite.
        def semantic_possible_import_may_select_type(table: SymbolTable&, name: sview, kind: SymbolKind, current_scope: sview, include_constants: bool = false) -> bool:
            can Abort.Panic:
                for annotation in table.possible_import_annotations |name, kind, current_scope, include_constants, table|:
                    continue if not semantic_import_scope_visible(annotation.module, current_scope)
                    if annotation.owner == "__from_member" and annotation.name == name:
                        for source in table.possible_import_annotations:
                            continue if source.owner != "__from_src" or source.module != annotation.module or source.line != annotation.line or source.offset != annotation.offset
                            return true if any symbol in table.symbols where symbol.name == name and (semantic_import_module_path_matches(symbol.module_owner, source.name, source.module) or semantic_possible_import_alias_module_path_matches(symbol.module_owner, source.name, source.module, source.offset, table)) and (symbol.kind == kind or include_constants and symbol.kind == SymbolKind.Const)
                    module_import: bool = annotation.name == "__using" or annotation.name == "__using_alias_target" or annotation.name == "__binding_wildcard_import"
                    if module_import:
                        return true if any symbol in table.symbols where symbol.name == name and (semantic_import_module_path_matches(symbol.module_owner, annotation.owner, annotation.module) or semantic_possible_import_alias_module_path_matches(symbol.module_owner, annotation.owner, annotation.module, annotation.offset, table)) and (symbol.kind == kind or include_constants and symbol.kind == SymbolKind.Const)
                return false
