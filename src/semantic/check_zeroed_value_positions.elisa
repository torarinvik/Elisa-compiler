# `zeroed` reaching a typed VALUE position other than a whole local/global initializer
# (stage0 analyzeValueExpr): a call argument, or a branch of a conditional value that
# initializes a binding or a return. A declaration may stage its initialization (the
# uninitialized-read check tracks that); these positions cannot, because the zero bit
# pattern IS the value the callee or binding receives. Every representation that forbids
# zero — non-null references, `sview`, `cstr`, handles, and aggregates carrying one — is
# rejected at the `zeroed` itself, sharing the declaration check's representation walk.
# Callees resolve lexically (the innermost owner declaring a function of that name);
# `recv.f(...)` considers every function or method named `f`, and a candidate that forbids
# zero rejects. `using M as A` expands `A::f`; a function-typed local or parameter shadows
# functions and checks its `fn(...)` parameter types (an untyped function value stays
# unchecked). Array literal elements, element places (`a[i] <- v`), record-update fields,
# and generic struct literals typed by their declaration are value positions too.
extend Semantic:
    private:
        # Whether VALUE is `zeroed` or a conditional/parenthesized value one of whose
        # results is; FOUND receives that `zeroed` node for the diagnostic span.
        def zeroed_value_reach(value: Ast::Expr, found: mutable Ast::Expr&) -> bool:
            can Abort.Panic:
                match value:
                    Expr.Ident(name, _):
                        false return if name != "zeroed"
                        found <- value
                        return true
                    Expr.Paren(inner, _):
                        return zeroed_value_reach(inner, found)
                    Expr.If(condition, then_expr, else_expr, _):
                        true return if zeroed_value_reach(then_expr, found)
                        return zeroed_value_reach(else_expr, found)
                    _:
                        return false

        # The zero-forbidding family of TYPE_EXPRESSION, or "" when zero is a valid value.
        # Inside an Unsafe.PointerCast grant only the unconditional view invariant applies.
        def zeroed_value_family(type_expression: Ast::Expr, generic_names: darray[sview]&, generic_values: darray[Ast::Expr]&, generic_owners: darray[sview]&, function_line: u32, owner: sview, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], allow_invalid: bool, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                view_visited: mutable darray[sview] = []
                view_field: mutable sview = ""
                "sview with valid backing" return if zeroed_type_expr_contains_nonnull_ref(type_expression, alias_names, alias_values, view_visited, view_field, table, declarations, alias_declarations, owner, generic_names, generic_values, generic_owners, function_line, 0, true)
                "" return if allow_invalid
                reference_visited: mutable darray[sview] = []
                reference_field: mutable sview = ""
                "non-null reference" return if zeroed_type_expr_contains_nonnull_ref(type_expression, alias_names, alias_values, reference_visited, reference_field, table, declarations, alias_declarations, owner, generic_names, generic_values, generic_owners, function_line, 0, false)
                substituted: mutable Ast::Expr = type_expression
                if type_expression is Expr.Ident(parameter_name, _):
                    for mapping_index in 0..<generic_names.count |substituted|:
                        substituted <- generic_values[mapping_index] if generic_names[mapping_index] == parameter_name
                "C string or handle" return if zeroed_invalid_type_via_alias(substituted, alias_names, alias_values, declarations, alias_declarations, owner, table)
                return ""

        # An extern parameter keeps only its compact ABI shape.
        def zeroed_extern_param_family(param: Ast::ExternParam&, allow_invalid: bool) -> sview:
            can Abort.Panic:
                "" return if param.optional
                "sview with valid backing" return if param.type_name == "sview" and not param.is_ref
                "" return if allow_invalid
                "non-null reference" return if param.is_ref
                "C string or handle" return if param.type_name == "cstr"
                return ""

        def zeroed_push_value_diagnostic(name: sview, family: sview, found: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                position: Ast::Pos = Ast::expr_pos(found)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidZeroedValue, name: name, pos: position, line: position.line, expected: family, actual: "zeroed"})

        # The byte length of CURRENT_MODULE's parent owner prefix (`A::B` -> `A`, `A` -> "").
        def zeroed_parent_prefix(current_module: sview, prefix_length: usize) -> usize:
            can Abort.Panic:
                search_offset: mutable usize = prefix_length
                while search_offset >= 2.usize() |search_offset|:
                    return search_offset - 2.usize() if sview_at(current_module, search_offset - 2.usize()) == ':' and sview_at(current_module, search_offset - 1.usize()) == ':'
                    search_offset <- search_offset - 1.usize()
                return 0

        # Functions and externs named NAME. Mode 0: declared directly in WANTED_OWNER;
        # mode 1: in any owner; mode 2: in the owner MODULE_PATH names relative to the first
        # PREFIX_LENGTH bytes of CURRENT_MODULE.
        def zeroed_collect_callees(declarations: darray[Ast::Decl], walk_owner: sview, name: sview, mode: u8, wanted_owner: sview, current_module: sview, prefix_length: usize, module_path: darray[sview]&, callees: mutable darray[Ast::Decl]&, callee_owners: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |callees, callee_owners|:
                    match declaration:
                        Decl.Func(function_name, _, _, _, _, _, _):
                            if function_name == name and zeroed_callee_owner_matches(walk_owner, mode, wanted_owner, current_module, prefix_length, module_path):
                                callees.push(declaration)
                                callee_owners.push(walk_owner)
                        Decl.Extern(extern_name, _, _, _, _, _, _, _):
                            if extern_name == name and zeroed_callee_owner_matches(walk_owner, mode, wanted_owner, current_module, prefix_length, module_path):
                                callees.push(declaration)
                                callee_owners.push(walk_owner)
                        Decl.Module(module_name, module_body, _):
                            zeroed_collect_callees(module_body, module_name, name, mode, wanted_owner, current_module, prefix_length, module_path, callees, callee_owners)
                        Decl.Scoped(scoped_body, _):
                            zeroed_collect_callees(scoped_body, walk_owner, name, mode, wanted_owner, current_module, prefix_length, module_path, callees, callee_owners)
                        _:
                            pass

        def zeroed_callee_owner_matches(walk_owner: sview, mode: u8, wanted_owner: sview, current_module: sview, prefix_length: usize, module_path: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                true return if mode == 1
                return walk_owner == wanted_owner if mode == 0
                false return if walk_owner == ""
                return zeroed_qualified_module_name_matches_relative_path(walk_owner, current_module, prefix_length, module_path)

        def zeroed_resolve_callees(callee: Ast::Expr, current_module: sview, alias_declarations: darray[Ast::Decl], table: SymbolTable&, callees: mutable darray[Ast::Decl]&, callee_owners: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                no_path: darray[sview] = []
                match callee:
                    Expr.Ident(name, _):
                        prefix_length: mutable usize = sview_len(current_module)
                        while callees.count == 0 |prefix_length, callees, callee_owners|:
                            owner: sview = string_view_slice(current_module, 0, prefix_length.i64()) if prefix_length > 0 else ""
                            zeroed_collect_callees(alias_declarations, "", name, 0, owner, current_module, 0, no_path, callees, callee_owners)
                            break if prefix_length == 0
                            prefix_length <- zeroed_parent_prefix(current_module, prefix_length)
                    Expr.Field(_, name, _):
                        zeroed_collect_callees(alias_declarations, "", name, 1, "", current_module, 0, no_path, callees, callee_owners)
                    Expr.Scope(base, name, _):
                        module_path: mutable darray[sview] = []
                        return if not zeroed_collect_qualified_type_path(base, module_path)
                        # `using M as A`: `A::f` names `M::f`, relative to the alias's owner.
                        path_owner: mutable sview = current_module
                        path_invalid: mutable bool = false
                        path_owner <- zeroed_expand_using_module_path(module_path, path_owner, table, path_invalid)
                        return if path_invalid
                        prefix_length: mutable usize = sview_len(path_owner)
                        while callees.count == 0 |prefix_length, callees, callee_owners, path_owner|:
                            zeroed_collect_callees(alias_declarations, "", name, 2, "", path_owner, prefix_length, module_path, callees, callee_owners)
                            break if prefix_length == 0
                            prefix_length <- zeroed_parent_prefix(path_owner, prefix_length)
                    _:
                        pass

        # The parameter a positional or labelled argument binds, or PARAM_COUNT when none.
        def zeroed_bound_param_index(position: usize, label: sview, param_count: usize, param_names: darray[sview]&) -> usize:
            can Abort.Panic:
                return position if label == ""
                for candidate_index in 0..<param_names.count:
                    candidate_index return if param_names[candidate_index] == label
                return param_count

        def zeroed_check_call(callee: Ast::Expr, arguments: darray[Ast::Expr], argument_names: darray[sview], function_line: u32, current_module: sview, local_names: darray[sview]&, local_types: darray[Ast::Expr]&, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam]&, allow_invalid: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                any_zeroed: mutable bool = false
                probe: mutable Ast::Expr = callee
                for argument in arguments |any_zeroed, probe|:
                    any_zeroed <- true if zeroed_value_reach(argument, probe)
                return if not any_zeroed
                # `f[T](...)`: explicit type arguments substitute the callee's generics.
                target: mutable Ast::Expr = callee
                type_arguments: mutable darray[Ast::Expr] = []
                match callee:
                    Expr.Index(head, type_argument, _):
                        target <- head
                        type_arguments.push(type_argument)
                    Expr.IndexN(head, head_arguments, _):
                        target <- head
                        type_arguments.extend(head_arguments)
                    _:
                        pass
                receiver_shift: mutable usize = 0
                if target is Expr.Field(_, _, _):
                    receiver_shift <- 1
                callees: mutable darray[Ast::Decl] = []
                callee_owners: mutable darray[sview] = []
                # A local or parameter of the callee's name shadows every function: a
                # function-typed binding checks its signature's parameter types, any other
                # binding (an untyped function value) stays unchecked.
                callee_name: sview = ident_name_of(target) if target is Expr.Ident(_, _) else ""
                if callee_name != "" and any local_name in local_names where local_name == callee_name:
                    table <- zeroed_check_function_value_call(callee_name, arguments, argument_names, function_line, current_module, local_names, local_types, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                    return
                zeroed_resolve_callees(target, current_module, alias_declarations, table, callees, callee_owners)
                return if callees.count == 0
                for argument_index in 0..<arguments.count |table|:
                    found: mutable Ast::Expr = arguments[argument_index]
                    continue if not zeroed_value_reach(arguments[argument_index], found)
                    label: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                    reported: mutable bool = false
                    for callee_index in 0..<callees.count |table, reported|:
                        continue if reported
                        match callees[callee_index]:
                            Decl.Func(function_name, params, _, _, _, _, function_pos):
                                param_names: mutable darray[sview] = []
                                param_names.extend([param.name for param in params])
                                param_index: usize = zeroed_bound_param_index(argument_index + receiver_shift, label, params.count, param_names)
                                if param_index < params.count:
                                    generic_names: mutable darray[sview] = []
                                    generic_values: mutable darray[Ast::Expr] = []
                                    generic_owners: mutable darray[sview] = []
                                    for generic_index in 0..<table.generic_param_lines.count |generic_names, generic_values, generic_owners|:
                                        if table.generic_param_lines[generic_index] == function_pos.line and generic_names.count < type_arguments.count:
                                            generic_values.push(type_arguments[generic_names.count])
                                            generic_names.push(table.generic_param_names[generic_index])
                                            generic_owners.push(current_module)
                                    argument_type: mutable Ast::Expr = params[param_index].type_expression
                                    for generic_index in 0..<generic_names.count |argument_type, generic_names, generic_values|:
                                        argument_type <- generic_values[generic_index] if argument_type is Expr.Ident(parameter_name, _) and parameter_name == generic_names[generic_index]
                                    table <- zeroed_protocol_check_nested_type(argument_type, callee_owners[callee_index], current_module, Ast::expr_pos(found), alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table)
                                    family: sview = zeroed_value_family(params[param_index].type_expression, generic_names, generic_values, generic_owners, function_pos.line, callee_owners[callee_index], alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                                    if family != "":
                                        table <- zeroed_push_value_diagnostic(params[param_index].name, family, found, table)
                                        reported <- true
                            Decl.Extern(extern_name, param_start, arity, _, _, _, _, _):
                                param_names: mutable darray[sview] = []
                                for param_offset in 0..<arity.usize() |param_names|:
                                    param_names.push(extern_params[param_start.usize() + param_offset].name)
                                param_index: usize = zeroed_bound_param_index(argument_index + receiver_shift, label, arity.usize(), param_names)
                                if param_index < arity.usize():
                                    param: Ast::ExternParam& = &extern_params[param_start.usize() + param_index]
                                    family: sview = zeroed_extern_param_family(param, allow_invalid)
                                    if family != "":
                                        table <- zeroed_push_value_diagnostic(param.name, family, found, table)
                                        reported <- true
                            _:
                                pass

        # The type a `<-` through a binding of TYPE_EXPRESSION writes: a reference binding
        # writes its referent, anything else the binding itself.
        def zeroed_referent_type(type_expression: Ast::Expr) -> Ast::Expr:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, _):
                        return zeroed_referent_type(operand) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                        return operand if operator == TokenKind.Ampersand
                        return type_expression
                    Expr.Paren(inner, _):
                        return zeroed_referent_type(inner)
                    _:
                        return type_expression

        # Whether a local of TYPE_EXPRESSION is a `mutable` (rebindable) binding.
        def zeroed_binding_is_rebindable(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, _):
                        true return if operator == TokenKind.Mutable
                        return zeroed_binding_is_rebindable(operand) if operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                        return false
                    Expr.Paren(inner, _):
                        return zeroed_binding_is_rebindable(inner)
                    _:
                        return false

        # Every statement-level local of a function body with the type a `<-` to it writes:
        # a rebindable (`mutable`) binding is replaced whole; a plain reference local
        # writes through to its referent (stage0 rejects `r: mutable T& ...; r <- zeroed`
        # but checks `r: T&; r <- v` against T). Unannotated locals and loop variables
        # record Absent, which keeps an assignment to that name unchecked.
        def zeroed_collect_assignable_locals(statements: darray[Ast::Stmt], names: mutable darray[sview]&, types: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, types|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, _, _):
                            names.push(name)
                            if zeroed_binding_is_rebindable(type_expression):
                                types.push(type_expression)
                            else:
                                types.push(zeroed_referent_type(type_expression))
                        Stmt.If(_, then_body, else_body, _):
                            zeroed_collect_assignable_locals(then_body, names, types)
                            zeroed_collect_assignable_locals(else_body, names, types)
                        Stmt.While(_, body, _):
                            zeroed_collect_assignable_locals(body, names, types)
                        Stmt.For(_, variables, _, body, _):
                            for variable in variables |names, types|:
                                names.push(variable)
                                types.push(Expr.Absent)
                            zeroed_collect_assignable_locals(body, names, types)
                        Stmt.Match(_, arms, _):
                            for arm in arms |names, types|:
                                zeroed_collect_assignable_locals(arm.body, names, types)
                        Stmt.Block(_, _, binding, body, _):
                            if binding != "":
                                names.push(binding)
                                types.push(Expr.Absent)
                            zeroed_collect_assignable_locals(body, names, types)
                        _:
                            pass

        # The declared type of field FIELD_NAME of the struct STRUCT_TYPE (written in
        # STRUCT_OWNER) names. The struct's generic parameters bind to STRUCT_TYPE's explicit
        # arguments, appended to the GENERIC_* mapping. False when the struct, the field, or
        # an argument for every generic parameter cannot be established uniquely.
        def zeroed_struct_field_type(struct_type: Ast::Expr, struct_owner: sview, field_name: sview, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], table: SymbolTable&, field_type: mutable Ast::Expr&, field_owner: mutable sview&, generic_names: mutable darray[sview]&, generic_values: mutable darray[Ast::Expr]&, generic_owners: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                current: mutable Ast::Expr = struct_type
                current_owner: mutable sview = struct_owner
                # A field typed by an enclosing generic parameter names its argument.
                substitutions: mutable usize = 0
                while substitutions <= generic_names.count |current, current_owner, substitutions, generic_names, generic_values, generic_owners|:
                    substituted: mutable bool = false
                    if current is Expr.Ident(parameter_name, _):
                        mapping_index: mutable usize = generic_names.count
                        while mapping_index > 0 |mapping_index, parameter_name, current, current_owner, substituted, generic_names, generic_values, generic_owners|:
                            mapping_index <- mapping_index - 1.usize()
                            if generic_names[mapping_index] == parameter_name:
                                current <- generic_values[mapping_index]
                                current_owner <- generic_owners[mapping_index]
                                substituted <- true
                                break
                    break if not substituted
                    substitutions <- substitutions + 1.usize()
                resolved: mutable Ast::Expr = current
                resolved_owner: mutable sview = current_owner
                invalid: mutable bool = false
                zeroed_resolve_type_alias_chain(current, alias_names, alias_values, declarations, alias_declarations, current_owner, table, resolved, resolved_owner, invalid)
                false return if invalid
                head: mutable Ast::Expr = resolved
                arguments: mutable darray[Ast::Expr] = []
                match resolved:
                    Expr.Index(index_head, argument, _):
                        false return if argument is Expr.IntLit(_, _)
                        head <- index_head
                        arguments.push(argument)
                    Expr.IndexN(index_head, index_arguments, _):
                        for argument in index_arguments:
                            false return if argument is Expr.IntLit(_, _)
                        head <- index_head
                        arguments.extend(index_arguments)
                    _:
                        pass
                head_owner: mutable sview = resolved_owner
                if arguments.count > 0:
                    resolved_head: mutable Ast::Expr = head
                    invalid_head: mutable bool = false
                    zeroed_resolve_type_alias_chain(head, alias_names, alias_values, declarations, alias_declarations, resolved_owner, table, resolved_head, head_owner, invalid_head)
                    false return if invalid_head
                    head <- resolved_head
                head_name: sview = ident_name_of(head)
                false return if head_name == ""
                struct_line: mutable u32 = 0
                struct_matches: mutable usize = 0
                zeroed_find_nominal_in_owner(alias_declarations, head_owner, head_name, struct_line, struct_matches)
                false return if struct_matches != 1.usize() or struct_line == 0
                struct_generic_names: mutable darray[sview] = []
                for table_index in 0..<table.generic_param_lines.count |struct_generic_names, table, struct_line|:
                    struct_generic_names.push(table.generic_param_names[table_index]) if table.generic_param_lines[table_index] == struct_line
                false return if arguments.count != struct_generic_names.count
                for field_index in 0..<table.struct_field_owner.count |table, head_name, head_owner, field_name, field_type, field_owner, generic_names, generic_values, generic_owners, struct_generic_names, arguments, resolved_owner|:
                    if table.struct_field_owner[field_index] == head_name and field_index < table.struct_field_module.count and table.struct_field_module[field_index] == head_owner and field_index < table.struct_field_name.count and table.struct_field_name[field_index] == field_name and field_index < table.private_field_types.count:
                        for generic_index in 0..<struct_generic_names.count |generic_names, generic_values, generic_owners, struct_generic_names, arguments, resolved_owner|:
                            generic_names.push(struct_generic_names[generic_index])
                            generic_values.push(arguments[generic_index])
                            generic_owners.push(resolved_owner)
                        field_type <- table.private_field_types[field_index]
                        field_owner <- head_owner
                        return true
                return false

        def zeroed_protocol_substitute_generic(type_expression: Ast::Expr, type_owner: sview, generic_names: darray[sview]&, generic_values: darray[Ast::Expr]&, generic_owners: darray[sview]&, resolved_type: mutable Ast::Expr&, resolved_owner: mutable sview&) -> void:
            can Abort.Panic:
                resolved_type <- type_expression
                resolved_owner <- type_owner
                if type_expression is Expr.Ident(parameter_name, _):
                    mapping_index: mutable usize = generic_names.count
                    while mapping_index > 0 |mapping_index, generic_names, generic_values, generic_owners, resolved_type, resolved_owner, parameter_name|:
                        mapping_index <- mapping_index - 1.usize()
                        if generic_names[mapping_index] == parameter_name and mapping_index < generic_values.count and mapping_index < generic_owners.count:
                            resolved_type <- generic_values[mapping_index]
                            resolved_owner <- generic_owners[mapping_index]
                            return

        def zeroed_protocol_check_nominal_contents(head: Ast::Expr, head_owner: sview, type_arguments: darray[Ast::Expr], type_argument_owner: sview, construction_scope: sview, position: Ast::Pos, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], generic_names: darray[sview]&, generic_values: darray[Ast::Expr]&, generic_owners: darray[sview]&, table: lmut SymbolTable, depth: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                type_name: sview = ident_name_of(head)
                return if type_name == ""
                nominal_line: mutable u32 = 0
                nominal_matches: mutable usize = 0
                zeroed_find_nominal_in_owner(alias_declarations, head_owner, type_name, nominal_line, nominal_matches)
                return if nominal_matches != 1.usize() or nominal_line == 0
                nominal_generics: mutable darray[sview] = []
                for table_index in 0..<table.generic_param_lines.count |table_index, nominal_line, nominal_generics, table|:
                    nominal_generics.push(table.generic_param_names[table_index]) if table.generic_param_lines[table_index] == nominal_line
                return if type_arguments.count < nominal_generics.count
                nested_names: mutable darray[sview] = []
                nested_values: mutable darray[Ast::Expr] = []
                nested_owners: mutable darray[sview] = []
                nested_names.extend(generic_names)
                nested_values.extend(generic_values)
                nested_owners.extend(generic_owners)
                for generic_index in 0..<nominal_generics.count |generic_index, nominal_generics, type_arguments, nested_names, nested_values, nested_owners, generic_names, generic_values, generic_owners, head_owner|:
                    parameter_name: sview = nominal_generics[generic_index]
                    argument: mutable Ast::Expr = type_arguments[generic_index]
                    argument_owner: mutable sview = type_argument_owner
                    zeroed_protocol_substitute_generic(argument, type_argument_owner, generic_names, generic_values, generic_owners, argument, argument_owner)
                    identity: mutable bool = false
                    if argument is Expr.Ident(argument_name, _):
                        identity <- argument_name == parameter_name
                    if not identity:
                        nested_names.push(parameter_name)
                        nested_values.push(argument)
                        nested_owners.push(argument_owner)
                row: u32 = binding_nominal_declaration(head, head_owner, table)
                return if row == SYMBOL_INDEX_ROW_NONE or row.usize() >= table.symbols.count
                symbol: Symbol = table.symbols[row.usize()]
                if symbol.kind == SymbolKind.Struct:
                    for field_index in 0..<table.struct_field_owner.count |field_index, type_name, head_owner, nested_names, nested_values, nested_owners, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, table, depth|:
                        if table.struct_field_owner[field_index] == type_name and field_index < table.struct_field_module.count and table.struct_field_module[field_index] == head_owner and field_index < table.private_field_types.count:
                            field_type: Ast::Expr = table.private_field_types[field_index]
                            table <- zeroed_protocol_check_nested_type(field_type, head_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, nested_names, nested_values, nested_owners, table, depth + 1)
                elif symbol.kind == SymbolKind.Enum:
                    active_fields: mutable darray[Ast::Expr] = []
                    zeroed_collect_active_enum_fields(alias_declarations, head_owner, type_name, active_fields)
                    for payload_type in active_fields |payload_type, nested_names, nested_values, nested_owners, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, table, depth|:
                        table <- zeroed_protocol_check_nested_type(payload_type, head_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, nested_names, nested_values, nested_owners, table, depth + 1)

        def zeroed_protocol_check_nested_type(type_expression: Ast::Expr, type_owner: sview, construction_scope: sview, position: Ast::Pos, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], generic_names: darray[sview]&, generic_values: darray[Ast::Expr]&, generic_owners: darray[sview]&, table: lmut SymbolTable, depth: u32 = 0) -> void:
            can Memory.Allocate, Abort.Panic:
                return if depth >= 128
                substituted: mutable Ast::Expr = type_expression
                substituted_owner: mutable sview = type_owner
                zeroed_protocol_substitute_generic(type_expression, type_owner, generic_names, generic_values, generic_owners, substituted, substituted_owner)
                match substituted:
                    Expr.Unary(operator, operand, _):
                        if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                            table <- zeroed_protocol_check_nested_type(operand, substituted_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, depth + 1)
                        return
                    Expr.Paren(inner, _) | Expr.Refinement(inner, _, _):
                        table <- zeroed_protocol_check_nested_type(inner, substituted_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, depth + 1)
                        return
                    _:
                        pass
                resolved: mutable Ast::Expr = substituted
                resolved_owner: mutable sview = substituted_owner
                invalid: mutable bool = false
                zeroed_resolve_type_alias_chain(substituted, alias_names, alias_values, declarations, alias_declarations, substituted_owner, table, resolved, resolved_owner, invalid)
                return if invalid
                match resolved:
                    Expr.Unary(operator, operand, _):
                        if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                            table <- zeroed_protocol_check_nested_type(operand, resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, depth + 1)
                        return
                    Expr.Paren(inner, _) | Expr.Refinement(inner, _, _):
                        table <- zeroed_protocol_check_nested_type(inner, resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, depth + 1)
                        return
                    Expr.Tuple(elements, _):
                        for element in elements |element, resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, depth|:
                            table <- zeroed_protocol_check_nested_type(element, resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, depth + 1)
                        return
                    Expr.Index(head, argument, _):
                        if argument is Expr.IntLit(_, _):
                            table <- zeroed_protocol_check_nested_type(head, resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, depth + 1)
                            return
                        resolved_head: mutable Ast::Expr = head
                        head_owner: mutable sview = resolved_owner
                        invalid_head: mutable bool = false
                        zeroed_resolve_type_alias_chain(head, alias_names, alias_values, declarations, alias_declarations, resolved_owner, table, resolved_head, head_owner, invalid_head)
                        return if invalid_head
                        head_name: sview = ident_name_of(resolved_head)
                        if head_name == "array":
                            table <- zeroed_protocol_check_nested_type(argument, resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, depth + 1)
                            return
                        return if head_name == "darray" or head_name == "dict" or head_name == "set"
                        args: darray[Ast::Expr] = [argument]
                        table <- check_protocol_zeroed_state_construction(resolved, position, resolved_owner, construction_scope, table)
                        table <- zeroed_protocol_check_nominal_contents(resolved_head, head_owner, args, resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, depth + 1)
                    Expr.IndexN(head, arguments, _):
                        resolved_head: mutable Ast::Expr = head
                        head_owner: mutable sview = resolved_owner
                        invalid_head: mutable bool = false
                        zeroed_resolve_type_alias_chain(head, alias_names, alias_values, declarations, alias_declarations, resolved_owner, table, resolved_head, head_owner, invalid_head)
                        return if invalid_head
                        head_name: sview = ident_name_of(resolved_head)
                        if head_name == "array" and arguments.count > 0:
                            table <- zeroed_protocol_check_nested_type(arguments[0], resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, depth + 1)
                            return
                        has_extent: mutable bool = false
                        for argument in arguments |has_extent|:
                            has_extent <- true if argument is Expr.IntLit(_, _)
                        if has_extent:
                            table <- zeroed_protocol_check_nested_type(head, resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, depth + 1)
                            return
                        return if head_name == "darray" or head_name == "dict" or head_name == "set"
                        table <- check_protocol_zeroed_state_construction(resolved, position, resolved_owner, construction_scope, table)
                        table <- zeroed_protocol_check_nominal_contents(resolved_head, head_owner, arguments, resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, depth + 1)
                    Expr.Ident(name, _):
                        table <- check_protocol_zeroed_state_construction(resolved, position, resolved_owner, construction_scope, table)
                        table <- zeroed_protocol_check_nominal_contents(resolved, resolved_owner, [], resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, depth + 1)
                    _:
                        table <- check_protocol_zeroed_state_construction(resolved, position, resolved_owner, construction_scope, table)

        # `S{f: zeroed}`: each field whose value can be `zeroed` must admit the zero
        # representation of its declared type.
        def zeroed_check_construct(struct_type: Ast::Expr, fields: darray[Ast::FieldInit], function_line: u32, current_module: sview, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], allow_invalid: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for field in fields |table|:
                    found: mutable Ast::Expr = field.value
                    continue if not zeroed_value_reach(field.value, found)
                    field_type: mutable Ast::Expr = field.value
                    field_owner: mutable sview = current_module
                    generic_names: mutable darray[sview] = []
                    generic_values: mutable darray[Ast::Expr] = []
                    generic_owners: mutable darray[sview] = []
                    continue if not zeroed_struct_field_type(struct_type, current_module, field.name, alias_names, alias_values, declarations, alias_declarations, table, field_type, field_owner, generic_names, generic_values, generic_owners)
                    table <- zeroed_protocol_check_nested_type(field_type, field_owner, current_module, Ast::expr_pos(found), alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table)
                    family: sview = zeroed_value_family(field_type, generic_names, generic_values, generic_owners, function_line, field_owner, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                    table <- zeroed_push_value_diagnostic(field.name, family, found, table) if family != ""

        # Resolve the type of the place TARGET from ROOT_TYPE. Field accesses see through
        # references; an indexed place resolves to its element type.
        def zeroed_resolve_place_type(target: Ast::Expr, root_type: Ast::Expr, current_module: sview, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], table: SymbolTable&, result_type: mutable Ast::Expr&, result_owner: mutable sview&, generic_names: mutable darray[sview]&, generic_values: mutable darray[Ast::Expr]&, generic_owners: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                path: mutable darray[sview] = []
                cursor: mutable Ast::Expr = target
                while true |cursor, path|:
                    match cursor:
                        Expr.Field(object, name, _):
                            path.push(name)
                            cursor <- object
                        Expr.Index(object, _, _):
                            # An element place; `[]` is never a field name.
                            path.push("[]")
                            cursor <- object
                        Expr.Paren(inner, _):
                            cursor <- inner
                        _:
                            break
                false return if not (cursor is Expr.Ident(_, _))
                false return if (root_type is Expr.Absent) or (root_type is Expr.Invalid)
                place_type: mutable Ast::Expr = root_type
                place_owner: mutable sview = current_module
                path_index: mutable usize = path.count
                while path_index > 0 |path_index, path, place_type, place_owner, generic_names, generic_values, generic_owners, alias_names, alias_values, declarations, alias_declarations, table|:
                    path_index <- path_index - 1.usize()
                    object_type: mutable Ast::Expr = place_type
                    object_owner: mutable sview = place_owner
                    # Field access sees through at most a few layers of reference.
                    for reference_step in 0..<4 |object_type, object_owner, alias_names, alias_values, declarations, alias_declarations, table|:
                        resolved: mutable Ast::Expr = object_type
                        resolved_owner: mutable sview = object_owner
                        invalid: mutable bool = false
                        zeroed_resolve_type_alias_chain(object_type, alias_names, alias_values, declarations, alias_declarations, object_owner, table, resolved, resolved_owner, invalid)
                        false return if invalid
                        if resolved is Expr.Unary(operator, operand, _) and operator == TokenKind.Ampersand:
                            object_type <- operand
                            object_owner <- resolved_owner
                        else:
                            break
                    if path[path_index] == "[]":
                        element_type: mutable Ast::Expr = object_type
                        element_owner: mutable sview = object_owner
                        false return if not zeroed_element_type(object_type, object_owner, alias_names, alias_values, declarations, alias_declarations, table, element_type, element_owner)
                        place_type <- element_type
                        place_owner <- element_owner
                        continue
                    false return if not zeroed_struct_field_type(object_type, object_owner, path[path_index], alias_names, alias_values, declarations, alias_declarations, table, place_type, place_owner, generic_names, generic_values, generic_owners)
                result_type <- place_type
                result_owner <- place_owner
                return true

        # `place <- value` where VALUE can be `zeroed`. Every local or parameter of the
        # root's name must forbid zero at the place, so a shadowed name never rejects on
        # the wrong binding's type. Globals, indexed places, and binders this walk does
        # not type stay unchecked.
        def zeroed_check_assignment(target: Ast::Expr, value: Ast::Expr, function_line: u32, current_module: sview, local_names: darray[sview]&, local_types: darray[Ast::Expr]&, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], allow_invalid: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                found: mutable Ast::Expr = value
                return if not zeroed_value_reach(value, found)
                root: mutable Ast::Expr = target
                while true |root|:
                    match root:
                        Expr.Field(object, _, _):
                            root <- object
                        Expr.Index(object, _, _):
                            root <- object
                        Expr.Paren(inner, _):
                            root <- inner
                        _:
                            break
                root_name: sview = ident_name_of(root)
                return if root_name == ""
                name: mutable sview = root_name
                if target is Expr.Field(_, field_name, _):
                    name <- field_name
                family: mutable sview = ""
                candidates: mutable usize = 0
                for local_index in 0..<local_names.count |local_names, local_types, root_name, target, family, candidates, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table|:
                    continue if local_names[local_index] != root_name
                    place_type: mutable Ast::Expr = Expr.Absent
                    place_owner: mutable sview = current_module
                    generic_names: mutable darray[sview] = []
                    generic_values: mutable darray[Ast::Expr] = []
                    generic_owners: mutable darray[sview] = []
                    return if not zeroed_resolve_place_type(target, local_types[local_index], current_module, alias_names, alias_values, declarations, alias_declarations, table, place_type, place_owner, generic_names, generic_values, generic_owners)
                    table <- zeroed_protocol_check_nested_type(place_type, place_owner, current_module, Ast::expr_pos(found), alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table)
                    candidate_family: sview = zeroed_value_family(place_type, generic_names, generic_values, generic_owners, function_line, place_owner, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                    return if candidate_family == ""
                    family <- candidate_family if candidates == 0
                    candidates <- candidates + 1.usize()
                return if candidates == 0
                table <- zeroed_push_value_diagnostic(name, family, found, table)

        # TYPE_EXPRESSION without binding modifiers (`mutable`, `lmut`, storage) or parens.
        def zeroed_strip_binding_modifiers(type_expression: Ast::Expr) -> Ast::Expr:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, _):
                        return zeroed_strip_binding_modifiers(operand) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                        return type_expression
                    Expr.Paren(inner, _):
                        return zeroed_strip_binding_modifiers(inner)
                    _:
                        return type_expression

        # The parameter types of a `fn(...) -> R` type (a function-typed binding is
        # normalized to the `fn(...)` call shape when its locals are collected).
        def zeroed_function_type_params(type_expression: Ast::Expr, parameter_types: mutable darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                match zeroed_strip_binding_modifiers(type_expression):
                    Expr.Binary(signature, operator, _, _):
                        false return if operator != TokenKind.Arrow
                        return zeroed_function_type_params(signature, parameter_types)
                    Expr.Call(callee, arguments, _, _):
                        false return if ident_name_of(callee) != "fn"
                        parameter_types.extend(arguments)
                        return true
                    _:
                        return false

        # A function-typed binding's `fn(...)` type parses as a Lambda that keeps only
        # parameter names; its parameter types live in the line-keyed side table. Rewrite
        # it to the `fn(T, ...)` call shape, or Absent when the rows are ambiguous.
        def zeroed_normalize_function_type(type_expression: Ast::Expr, fn_type_param_lines: darray[u32]&, fn_type_param_exprs: darray[Ast::Expr]&) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                match zeroed_strip_binding_modifiers(type_expression):
                    Expr.Lambda(lambda_params, _, lambda_pos):
                        parameter_types: mutable darray[Ast::Expr] = []
                        for row in 0..<fn_type_param_lines.count |parameter_types|:
                            parameter_types.push(fn_type_param_exprs[row]) if fn_type_param_lines[row] == lambda_pos.line and row < fn_type_param_exprs.count
                        return Expr.Absent if parameter_types.count != lambda_params.count
                        no_names: darray[sview] = []
                        return Expr.Call(Expr.Ident("fn", lambda_pos), parameter_types, no_names, lambda_pos)
                    _:
                        return type_expression

        # `f(...)` through a local or parameter named NAME: every binding of that name must
        # be a function type whose positional parameter forbids zero.
        def zeroed_check_function_value_call(name: sview, arguments: darray[Ast::Expr], argument_names: darray[sview], function_line: u32, current_module: sview, local_names: darray[sview]&, local_types: darray[Ast::Expr]&, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], allow_invalid: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                no_generic_names: darray[sview] = []
                no_generic_values: darray[Ast::Expr] = []
                no_generic_owners: darray[sview] = []
                for argument_index in 0..<arguments.count |table|:
                    found: mutable Ast::Expr = arguments[argument_index]
                    continue if not zeroed_value_reach(arguments[argument_index], found)
                    continue if argument_index < argument_names.count and argument_names[argument_index] != ""
                    family: mutable sview = ""
                    all_forbid: mutable bool = true
                    for local_index in 0..<local_names.count |table, family, all_forbid|:
                        continue if local_names[local_index] != name
                        parameter_types: mutable darray[Ast::Expr] = []
                        if not zeroed_function_type_params(local_types[local_index], parameter_types) or argument_index >= parameter_types.count:
                            all_forbid <- false
                            break
                        table <- zeroed_protocol_check_nested_type(parameter_types[argument_index], current_module, current_module, Ast::expr_pos(found), alias_names, alias_values, declarations, alias_declarations, no_generic_names, no_generic_values, no_generic_owners, table)
                        candidate: sview = zeroed_value_family(parameter_types[argument_index], no_generic_names, no_generic_values, no_generic_owners, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                        if candidate == "":
                            all_forbid <- false
                            break
                        family <- candidate if family == ""
                    table <- zeroed_push_value_diagnostic(name, family, found, table) if all_forbid and family != ""

        # The element type of an array or darray type (after aliases), or false.
        def zeroed_element_type(type_expression: Ast::Expr, owner: sview, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], table: SymbolTable&, element_type: mutable Ast::Expr&, element_owner: mutable sview&) -> bool:
            can Memory.Allocate, Abort.Panic:
                resolved: mutable Ast::Expr = type_expression
                resolved_owner: mutable sview = owner
                invalid: mutable bool = false
                zeroed_resolve_type_alias_chain(type_expression, alias_names, alias_values, declarations, alias_declarations, owner, table, resolved, resolved_owner, invalid)
                false return if invalid
                match resolved:
                    Expr.Index(head, argument, _):
                        if argument is Expr.IntLit(_, _):
                            element_type <- head
                            element_owner <- resolved_owner
                            return true
                        if ident_name_of(head) == "darray" or ident_name_of(head) == "set" or ident_name_of(head) == "array":
                            element_type <- argument
                            element_owner <- resolved_owner
                            return true
                        return false
                    _:
                        return false

        # A value of declared TYPE_EXPRESSION: array literal elements take the element
        # type, and a generic struct literal written without type arguments takes the
        # declared instantiation. A WHOLE `zeroed` (or conditional) VALUE belongs to the
        # declaration checks when WHOLE_CHECKED.
        def zeroed_check_typed_value(name: sview, type_expression: Ast::Expr, type_owner: sview, construction_scope: sview, value: Ast::Expr, whole_checked: bool, function_line: u32, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], allow_invalid: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if (type_expression is Expr.Absent) or (type_expression is Expr.Invalid)
                match value:
                    Expr.Array(elements, _):
                        element_type: mutable Ast::Expr = type_expression
                        element_owner: mutable sview = type_owner
                        return if not zeroed_element_type(type_expression, type_owner, alias_names, alias_values, declarations, alias_declarations, table, element_type, element_owner)
                        for element in elements |table, element_type, element_owner|:
                            table <- zeroed_check_typed_value(name, element_type, element_owner, construction_scope, element, false, function_line, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                    Expr.SetLit(elements, _):
                        element_type: mutable Ast::Expr = type_expression
                        element_owner: mutable sview = type_owner
                        return if not zeroed_element_type(type_expression, type_owner, alias_names, alias_values, declarations, alias_declarations, table, element_type, element_owner)
                        for element in elements |table, element_type, element_owner|:
                            table <- zeroed_check_typed_value(name, element_type, element_owner, construction_scope, element, false, function_line, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                    Expr.Tuple(elements, _):
                        tuple_type: mutable Ast::Expr = type_expression
                        tuple_owner: mutable sview = type_owner
                        tuple_invalid: mutable bool = false
                        zeroed_resolve_type_alias_chain(type_expression, alias_names, alias_values, declarations, alias_declarations, type_owner, table, tuple_type, tuple_owner, tuple_invalid)
                        return if tuple_invalid
                        match zeroed_strip_binding_modifiers(tuple_type):
                            Expr.Tuple(element_types, _):
                                return if elements.count != element_types.count
                                for element_index in 0..<elements.count |element_index, table, elements, element_types, tuple_owner, construction_scope|:
                                    table <- zeroed_check_typed_value(name, element_types[element_index], tuple_owner, construction_scope, elements[element_index], false, function_line, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                            _:
                                pass
                    Expr.DictLit(entries, _):
                        resolved: mutable Ast::Expr = type_expression
                        resolved_owner: mutable sview = type_owner
                        invalid: mutable bool = false
                        zeroed_resolve_type_alias_chain(type_expression, alias_names, alias_values, declarations, alias_declarations, type_owner, table, resolved, resolved_owner, invalid)
                        return if invalid
                        match resolved:
                            Expr.IndexN(head, type_arguments, _):
                                return if ident_name_of(head) != "dict" or type_arguments.count != 2
                                for entry in entries |table, type_arguments, resolved_owner, construction_scope|:
                                    table <- zeroed_check_typed_value(name, type_arguments[0], resolved_owner, construction_scope, entry.key, false, function_line, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                                    table <- zeroed_check_typed_value(name, type_arguments[1], resolved_owner, construction_scope, entry.value, false, function_line, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                            _:
                                pass
                    Expr.If(_, then_value, else_value, _):
                        table <- zeroed_check_typed_value(name, type_expression, type_owner, construction_scope, then_value, false, function_line, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                        table <- zeroed_check_typed_value(name, type_expression, type_owner, construction_scope, else_value, false, function_line, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                    Expr.Paren(inner, _):
                        table <- zeroed_check_typed_value(name, type_expression, type_owner, construction_scope, inner, false, function_line, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                    Expr.Construct(struct_type, fields, _):
                        return if not (struct_type is Expr.Ident(_, _))
                        declared: Ast::Expr = zeroed_strip_binding_modifiers(type_expression)
                        declared_head: mutable Ast::Expr = declared
                        match declared:
                            Expr.Index(head, _, _):
                                declared_head <- head
                            Expr.IndexN(head, _, _):
                                declared_head <- head
                            _:
                                return
                        return if ident_name_of(declared_head) != ident_name_of(struct_type)
                        table <- zeroed_check_construct(declared, fields, function_line, type_owner, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                    _:
                        found: mutable Ast::Expr = value
                        return if not zeroed_value_reach(value, found)
                        protocol_generic_names: darray[sview] = []
                        protocol_generic_values: darray[Ast::Expr] = []
                        protocol_generic_owners: darray[sview] = []
                        table <- zeroed_protocol_check_nested_type(type_expression, type_owner, construction_scope, Ast::expr_pos(found), alias_names, alias_values, declarations, alias_declarations, protocol_generic_names, protocol_generic_values, protocol_generic_owners, table)
                        return if whole_checked
                        no_generic_names: darray[sview] = []
                        no_generic_values: darray[Ast::Expr] = []
                        no_generic_owners: darray[sview] = []
                        family: sview = zeroed_value_family(type_expression, no_generic_names, no_generic_values, no_generic_owners, function_line, type_owner, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                        table <- zeroed_push_value_diagnostic(name, family, found, table) if family != ""

        # A declared local, global, or return whose value is a conditional with a `zeroed`
        # result. A WHOLE `zeroed` initializer belongs to the declaration checks.
        def zeroed_value_conditional(name: sview, type_expression: Ast::Expr, value: Ast::Expr, function_line: u32, current_module: sview, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], allow_invalid: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if zeroed_value_is_zeroed(value)
                return if (type_expression is Expr.Absent) or (type_expression is Expr.Invalid)
                found: mutable Ast::Expr = value
                return if not zeroed_value_reach(value, found)
                protocol_generic_names: darray[sview] = []
                protocol_generic_values: darray[Ast::Expr] = []
                protocol_generic_owners: darray[sview] = []
                table <- zeroed_protocol_check_nested_type(type_expression, current_module, current_module, Ast::expr_pos(found), alias_names, alias_values, declarations, alias_declarations, protocol_generic_names, protocol_generic_values, protocol_generic_owners, table)
                no_generic_names: darray[sview] = []
                no_generic_values: darray[Ast::Expr] = []
                no_generic_owners: darray[sview] = []
                family: sview = zeroed_value_family(type_expression, no_generic_names, no_generic_values, no_generic_owners, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                table <- zeroed_push_value_diagnostic(name, family, found, table) if family != ""

        def zeroed_value_arms(arms: darray[Ast::MatchArm], return_type: Ast::Expr?, function_line: u32, current_module: sview, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam]&, local_names: darray[sview]&, local_types: darray[Ast::Expr]&, allow_invalid: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for arm in arms |table|:
                    table <- zeroed_value_expression(arm.guard, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                    table <- zeroed_value_statements(arm.body, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)

        def zeroed_value_expressions(expressions: darray[Ast::Expr], return_type: Ast::Expr?, function_line: u32, current_module: sview, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam]&, local_names: darray[sview]&, local_types: darray[Ast::Expr]&, allow_invalid: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for expression in expressions |table|:
                    table <- zeroed_value_expression(expression, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)

        def zeroed_value_expression(expression: Ast::Expr, return_type: Ast::Expr?, function_line: u32, current_module: sview, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam]&, local_names: darray[sview]&, local_types: darray[Ast::Expr]&, allow_invalid: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, _):
                        table <- zeroed_check_call(callee, arguments, argument_names, function_line, current_module, local_names, local_types, alias_names, alias_values, declarations, alias_declarations, extern_params, allow_invalid, table)
                        table <- zeroed_value_expression(callee, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        table <- zeroed_value_expressions(arguments, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                    Expr.StaticEffectCall(_, _, _, arguments, _, _):
                        table <- zeroed_value_expressions(arguments, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                    Expr.Field(object, _, _):
                        table <- zeroed_value_expression(object, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                    Expr.Index(object, index, _):
                        table <- zeroed_value_expression(object, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        table <- zeroed_value_expression(index, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                    Expr.Slice(object, low, high, _):
                        table <- zeroed_value_expression(object, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        table <- zeroed_value_expression(low, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        table <- zeroed_value_expression(high, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                    Expr.IndexN(object, arguments, _):
                        table <- zeroed_value_expression(object, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        table <- zeroed_value_expressions(arguments, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                    Expr.Binary(left, _, right, _):
                        table <- zeroed_value_expression(left, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        table <- zeroed_value_expression(right, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                    Expr.Unary(_, operand, _) | Expr.Move(operand, _) | Expr.Paren(operand, _):
                        table <- zeroed_value_expression(operand, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                    Expr.RegionNew(operand, _, _):
                        table <- zeroed_value_expression(operand, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        table <- zeroed_value_expressions(elements, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                    Expr.DictLit(entries, _):
                        for entry in entries |table|:
                            table <- zeroed_value_expression(entry.key, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                            table <- zeroed_value_expression(entry.value, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                    Expr.Construct(struct_type, fields, _):
                        table <- zeroed_check_construct(struct_type, fields, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                        for field in fields |table|:
                            table <- zeroed_value_expression(field.value, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                    Expr.RecordUpdate(base, fields, update_pos):
                        # `base{f = v}` replaces field `f` whole, like `base.f <- v`.
                        for field in fields |table|:
                            table <- zeroed_check_assignment(Expr.Field(base, field.name, update_pos), field.value, function_line, current_module, local_names, local_types, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                        table <- zeroed_value_expression(base, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        for field in fields |table|:
                            table <- zeroed_value_expression(field.value, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                    Expr.If(condition, then_expr, else_expr, _):
                        table <- zeroed_value_expression(condition, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        table <- zeroed_value_expression(then_expr, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        table <- zeroed_value_expression(else_expr, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        table <- zeroed_value_expression(scrutinee, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        table <- zeroed_value_arms(arms, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                    Expr.Comprehension(_, iterable, condition, body, _):
                        table <- zeroed_value_expression(iterable, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        table <- zeroed_value_expression(condition, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        table <- zeroed_value_expression(body, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                    Expr.GetElse(guarded, recovery, _):
                        table <- zeroed_value_expression(guarded, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        table <- zeroed_value_statements(recovery, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                    Expr.Lambda(_, body, _):
                        # A lambda's `return` answers the lambda, whose result type is not declared here.
                        lambda_return: Ast::Expr? = null
                        table <- zeroed_value_statements(body, lambda_return, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                    Expr.Block(statements, value, _, _):
                        table <- zeroed_value_statements(statements, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        table <- zeroed_value_expression(value, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                    _:
                        pass

        def zeroed_value_statements(statements: darray[Ast::Stmt], return_type: Ast::Expr?, function_line: u32, current_module: sview, alias_names: darray[sview]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam]&, local_names: darray[sview]&, local_types: darray[Ast::Expr]&, allow_invalid: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, _):
                            table <- zeroed_value_expression(expression, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        Stmt.VarDecl(name, type_expression, value, _):
                            table <- zeroed_value_conditional(name, type_expression, value, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                            table <- zeroed_check_typed_value(name, type_expression, current_module, current_module, value, true, function_line, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                            table <- zeroed_value_expression(value, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        Stmt.Assign(target, operator, value, _):
                            table <- zeroed_check_assignment(target, value, function_line, current_module, local_names, local_types, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table) if operator == TokenKind.LArrow
                            table <- zeroed_value_expression(target, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                            table <- zeroed_value_expression(value, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        Stmt.If(condition, then_body, else_body, _):
                            table <- zeroed_value_expression(condition, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                            table <- zeroed_value_statements(then_body, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                            table <- zeroed_value_statements(else_body, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        Stmt.While(condition, body, _):
                            table <- zeroed_value_expression(condition, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                            table <- zeroed_value_statements(body, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        Stmt.For(_, _, iterable, body, _):
                            table <- zeroed_value_expression(iterable, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                            table <- zeroed_value_statements(body, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        Stmt.Return(value, _):
                            if value is returned_value:
                                if return_type is expected_return:
                                    table <- zeroed_value_conditional("return", expected_return, returned_value, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                                    table <- zeroed_check_typed_value("return", expected_return, current_module, current_module, returned_value, true, function_line, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                                table <- zeroed_value_expression(returned_value, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        Stmt.Match(scrutinee, arms, _):
                            table <- zeroed_value_expression(scrutinee, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                            table <- zeroed_value_arms(arms, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        Stmt.Block(kind, clause, _, body, _):
                            grants_raw_zeroed: bool = (kind == "trusted" or kind == "can") and any grant in clause where grant == "Unsafe.PointerCast"
                            table <- zeroed_value_statements(body, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid or grants_raw_zeroed, table)
                        Stmt.Contract(_, expression, _):
                            table <- zeroed_value_expression(expression, return_type, function_line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, allow_invalid, table)
                        _:
                            pass

        def check_zeroed_value_positions(declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview, inherited_alias_names: darray[sview]&, inherited_alias_values: darray[Ast::Expr]&, extern_params: darray[Ast::ExternParam]&, fn_type_param_lines: darray[u32]&, fn_type_param_exprs: darray[Ast::Expr]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                alias_names: mutable darray[sview] = []
                alias_values: mutable darray[Ast::Expr] = []
                alias_names.extend(inherited_alias_names)
                alias_values.extend(inherited_alias_values)
                zeroed_collect_type_aliases(declarations, alias_names, alias_values)
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(_, params, return_type, body, _, _, line):
                            local_names: mutable darray[sview] = []
                            local_types: mutable darray[Ast::Expr] = []
                            for param in params |local_names, local_types|:
                                local_names.push(param.name)
                                local_types.push(zeroed_referent_type(param.type_expression))
                                table <- zeroed_check_typed_value(param.name, param.type_expression, current_module, current_module, param.default_value, true, line.line, alias_names, alias_values, declarations, alias_declarations, false, table) if param.has_default
                            zeroed_collect_assignable_locals(body, local_names, local_types)
                            for local_index in 0..<local_types.count |local_types|:
                                local_types[local_index] <- zeroed_normalize_function_type(local_types[local_index], fn_type_param_lines, fn_type_param_exprs)
                            table <- zeroed_value_statements(body, return_type, line.line, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, local_names, local_types, false, table)
                        Decl.Module(module_name, module_body, _):
                            table <- check_zeroed_value_positions(module_body, alias_declarations, module_name, alias_names, alias_values, extern_params, fn_type_param_lines, fn_type_param_exprs, table)
                        Decl.Scoped(scoped_body, _):
                            table <- check_zeroed_value_positions(scoped_body, alias_declarations, current_module, alias_names, alias_values, extern_params, fn_type_param_lines, fn_type_param_exprs, table)
                        Decl.Const(name, type_expression, value, _, _):
                            table <- zeroed_value_conditional(name, type_expression, value, 0, current_module, alias_names, alias_values, declarations, alias_declarations, false, table)
                            table <- zeroed_check_typed_value(name, type_expression, current_module, current_module, value, true, 0, alias_names, alias_values, declarations, alias_declarations, false, table)
                            no_return: Ast::Expr? = null
                            no_local_names: darray[sview] = []
                            no_local_types: darray[Ast::Expr] = []
                            table <- zeroed_value_expression(value, no_return, 0, current_module, alias_names, alias_values, declarations, alias_declarations, extern_params, no_local_names, no_local_types, false, table)
                        Decl.Struct(_, members, _, _, _, _, _):
                            for member in members |table|:
                                if member.has_default:
                                    table <- zeroed_check_typed_value(member.name, member.type_expression, current_module, current_module, member.default_value, true, 0, alias_names, alias_values, declarations, alias_declarations, false, table)
                        _:
                            pass
