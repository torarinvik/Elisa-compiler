# `zeroed` reaching a typed VALUE position other than a whole local/global initializer
# (stage0 analyzeValueExpr): a call argument, or a branch of a conditional value that
# initializes a binding or a return. A declaration may stage its initialization (the
# uninitialized-read check tracks that); these positions cannot, because the zero bit
# pattern IS the value the callee or binding receives. Every representation that forbids
# zero — non-null references, `sview`, `cstr`, handles, and aggregates carrying one — is
# rejected at the `zeroed` itself, sharing the declaration check's representation walk.
# Callees resolve lexically (the innermost owner declaring a function of that name);
# `recv.f(...)` considers every function or method named `f`, and a candidate that forbids
# zero rejects. `using M as A` expands `A::f`; a function-typed local or parameter shadows
# functions and checks its `fn(...)` parameter types (an untyped function value stays
# unchecked). Array literal elements, element places (`a[i] <- v`), record-update fields,
# and generic struct literals typed by their declaration are value positions too.
extend Semantic:
    private:
        # Whether VALUE is `zeroed` or a conditional/parenthesized value one of whose
        # results is; FOUND receives that `zeroed` node for the diagnostic span.
        def zeroed_value_reach(value: Ast::Expr, found: mutable Ast::Expr&) -> bool:
            can Abort.Panic:
                match value:
                    Expr.Ident(name, _):
                        return false if name != "zeroed"
                        found <- value
                        return true
                    Expr.Paren(inner, _):
                        return zeroed_value_reach(inner, found)
                    Expr.If(condition, then_expr, else_expr, _):
                        return true if zeroed_value_reach(then_expr, found)
                        return zeroed_value_reach(else_expr, found)
                    _:
                        return false

        # The zero-forbidding family of TYPE_EXPRESSION, or "" when zero is a valid value.
        # Inside an Unsafe.PointerCast grant only the unconditional view invariant applies.
        def zeroed_value_family(type_expression: Ast::Expr, generic_names: darray[sview]&, generic_values: darray[Ast::Expr]&, generic_owners: darray[sview @source]&, function_line: u32, owner: sview @source, alias_names: darray[sview @source]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], allow_invalid: bool, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                active_enum_index: mutable ZeroedActiveEnumIndex = ZeroedActiveEnumIndex{built: false, heads: {}, tails: {}, counts: {}, next: [], row_hashes: [], owners: [], names: [], payloads: []}
                view_visited: mutable darray[sview] = []
                view_field: mutable sview = ""
                return "sview with valid backing" if zeroed_type_expr_contains_nonnull_ref(type_expression, alias_names, alias_values, view_visited, view_field, table, declarations, alias_declarations, active_enum_index, owner, generic_names, generic_values, generic_owners, function_line, 0, true)
                return "" if allow_invalid
                reference_visited: mutable darray[sview] = []
                reference_field: mutable sview = ""
                return "non-null reference" if zeroed_type_expr_contains_nonnull_ref(type_expression, alias_names, alias_values, reference_visited, reference_field, table, declarations, alias_declarations, active_enum_index, owner, generic_names, generic_values, generic_owners, function_line, 0, false)
                substituted: mutable Ast::Expr = type_expression
                if type_expression is Expr.Ident(parameter_name, _):
                    for mapping_index in 0..<generic_names.count |substituted|:
                        substituted <- generic_values[mapping_index] if generic_names[mapping_index] == parameter_name
                return "C string or handle" if zeroed_invalid_type_via_alias(substituted, alias_names, alias_values, declarations, alias_declarations, owner, table)
                return ""

        # An extern parameter keeps only its compact ABI shape.
        def zeroed_extern_param_family(param: Ast::ExternParam&, allow_invalid: bool) -> sview:
            can Abort.Panic:
                return "" if param.optional
                return "sview with valid backing" if param.type_name == "sview" and not param.is_ref
                return "" if allow_invalid
                return "non-null reference" if param.is_ref
                return "C string or handle" if param.type_name == "cstr"
                return ""

        def zeroed_push_value_diagnostic(name: sview @source, family: sview @source, found: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                position: Ast::Pos = Ast::expr_pos(found)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidZeroedValue, name: name, pos: position, line: position.line, expected: family, actual: "zeroed"})

        # The byte length of CURRENT_MODULE's parent owner prefix (`A::B` -> `A`, `A` -> "").
        def zeroed_parent_prefix(current_module: sview, prefix_length: usize) -> usize:
            can Abort.Panic:
                search_offset: mutable usize = prefix_length
                while search_offset >= 2.usize() |search_offset|:
                    return search_offset - 2.usize() if current_module[search_offset - 2.usize()] == ':' and current_module[search_offset - 1.usize()] == ':'
                    search_offset <- search_offset - 1.usize()
                return 0

        # Functions and externs named NAME. Mode 0: declared directly in WANTED_OWNER;
        # mode 1: in any owner; mode 2: in the owner MODULE_PATH names relative to the first
        # PREFIX_LENGTH bytes of CURRENT_MODULE.
        def zeroed_collect_callees(declarations: darray[Ast::Decl], walk_owner: sview @source, name: sview, mode: u8, wanted_owner: sview, current_module: sview @source, prefix_length: usize, module_path: darray[sview]&, callees: mutable darray[Ast::Decl]&, callee_owners: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |callees, callee_owners|:
                    match declaration:
                        Decl.Func(name: function_name, _):
                            if function_name == name and zeroed_callee_owner_matches(walk_owner, mode, wanted_owner, current_module, prefix_length, module_path):
                                callees.push(declaration)
                                callee_owners.push(walk_owner)
                        Decl.Extern(name: extern_name, _):
                            if extern_name == name and zeroed_callee_owner_matches(walk_owner, mode, wanted_owner, current_module, prefix_length, module_path):
                                callees.push(declaration)
                                callee_owners.push(walk_owner)
                        Decl.Module(module_name, module_body, _):
                            zeroed_collect_callees(module_body, module_name, name, mode, wanted_owner, current_module, prefix_length, module_path, callees, callee_owners)
                        Decl.Scoped(scoped_body, _):
                            zeroed_collect_callees(scoped_body, walk_owner, name, mode, wanted_owner, current_module, prefix_length, module_path, callees, callee_owners)
                        _:
                            pass

        def zeroed_callee_owner_matches(walk_owner: sview @source, mode: u8, wanted_owner: sview, current_module: sview @source, prefix_length: usize, module_path: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return true if mode == 1
                return walk_owner == wanted_owner if mode == 0
                return false if walk_owner == ""
                return zeroed_qualified_module_name_matches_relative_path(walk_owner, current_module, prefix_length, module_path)

        def zeroed_resolve_callees(callee: Ast::Expr, current_module: sview @source, alias_declarations: darray[Ast::Decl], table: SymbolTable&, callees: mutable darray[Ast::Decl]&, callee_owners: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                no_path: darray[sview] = []
                match callee:
                    Expr.Ident(name, _):
                        prefix_length: mutable usize = current_module.len
                        while callees.count == 0 |prefix_length, callees, callee_owners|:
                            owner: sview = string_view_slice(current_module, 0, prefix_length.i64()) if prefix_length > 0 else ""
                            zeroed_collect_callees(alias_declarations, "", name, 0, owner, current_module, 0, no_path, callees, callee_owners)
                            break if prefix_length == 0
                            prefix_length <- zeroed_parent_prefix(current_module, prefix_length)
                    Expr.Field(_, name, _):
                        zeroed_collect_callees(alias_declarations, "", name, 1, "", current_module, 0, no_path, callees, callee_owners)
                    Expr.Scope(base, name, _):
                        module_path: mutable darray[sview] = []
                        return if not zeroed_collect_qualified_type_path(base, module_path)
                        # `using M as A`: `A::f` names `M::f`, relative to the alias's owner.
                        path_owner: mutable sview = current_module
                        path_invalid: mutable bool = false
                        path_owner <- zeroed_expand_using_module_path(module_path, path_owner, table, path_invalid)
                        return if path_invalid
                        prefix_length: mutable usize = path_owner.len
                        while callees.count == 0 |prefix_length, callees, callee_owners, path_owner|:
                            zeroed_collect_callees(alias_declarations, "", name, 2, "", path_owner, prefix_length, module_path, callees, callee_owners)
                            break if prefix_length == 0
                            prefix_length <- zeroed_parent_prefix(path_owner, prefix_length)
                    _:
                        pass

        # The parameter a positional or labelled argument binds, or PARAM_COUNT when none.
        def zeroed_bound_param_index(position: usize, label: sview, param_count: usize, param_names: darray[sview]&) -> usize:
            can Abort.Panic:
                return position if label == ""
                for candidate_index in 0..<param_names.count:
                    return candidate_index if param_names[candidate_index] == label
                return param_count

        def zeroed_check_call(callee: Ast::Expr, arguments: darray[Ast::Expr], argument_names: darray[sview], function_line: u32, current_module: sview @source, local_names: darray[sview]&, local_types: darray[Ast::Expr]&, alias_names: darray[sview @source]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], extern_params: darray[Ast::ExternParam]&, allow_invalid: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                any_zeroed: mutable bool = false
                probe: mutable Ast::Expr = callee
                for argument in arguments |any_zeroed, probe|:
                    any_zeroed <- true if zeroed_value_reach(argument, probe)
                return if not any_zeroed
                # `f[T](...)`: explicit type arguments substitute the callee's generics.
                target: mutable Ast::Expr = callee
                type_arguments: mutable darray[Ast::Expr] = []
                match callee:
                    Expr.Index(head, type_argument, _):
                        target <- head
                        type_arguments.push(type_argument)
                    Expr.IndexN(head, head_arguments, _):
                        target <- head
                        type_arguments.extend(head_arguments)
                    _:
                        pass
                receiver_shift: mutable usize = 0
                if target is Expr.Field(_, _, _):
                    receiver_shift <- 1
                callees: mutable darray[Ast::Decl] = []
                callee_owners: mutable darray[sview @source] = []
                # A local or parameter of the callee's name shadows every function: a
                # function-typed binding checks its signature's parameter types, any other
                # binding (an untyped function value) stays unchecked.
                callee_name: sview = ident_name_of(target) if target is Expr.Ident(_, _) else ""
                if callee_name != "" and any local_name in local_names where local_name == callee_name:
                    table <- zeroed_check_function_value_call(callee_name, arguments, argument_names, function_line, current_module, local_names, local_types, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                    return
                zeroed_resolve_callees(target, current_module, alias_declarations, table, callees, callee_owners)
                return if callees.count == 0
                for argument_index in 0..<arguments.count |table|:
                    found: mutable Ast::Expr = arguments[argument_index]
                    continue if not zeroed_value_reach(arguments[argument_index], found)
                    label: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                    reported: mutable bool = false
                    for callee_index in 0..<callees.count |table, reported|:
                        continue if reported
                        match callees[callee_index]:
                            Decl.Func(name: function_name, params: params, pos: function_pos, _):
                                param_names: mutable darray[sview] = []
                                param_names.extend([param.name for param in params])
                                param_index: usize = zeroed_bound_param_index(argument_index + receiver_shift, label, params.count, param_names)
                                if param_index < params.count:
                                    generic_names: mutable darray[sview] = []
                                    generic_values: mutable darray[Ast::Expr] = []
                                    generic_owners: mutable darray[sview @source] = []
                                    for generic_index in 0..<table.generic_param_lines.count |generic_names, generic_values, generic_owners|:
                                        if table.generic_param_lines[generic_index] == function_pos.line and generic_names.count < type_arguments.count:
                                            generic_values.push(type_arguments[generic_names.count])
                                            generic_names.push(table.generic_param_names[generic_index])
                                            generic_owners.push(current_module)
                                    argument_type: mutable Ast::Expr = params[param_index].type_expression
                                    for generic_index in 0..<generic_names.count |argument_type, generic_names, generic_values|:
                                        argument_type <- generic_values[generic_index] if argument_type is Expr.Ident(parameter_name, _) and parameter_name == generic_names[generic_index]
                                    table <- zeroed_protocol_check_nested_type(argument_type, callee_owners[callee_index], current_module, Ast::expr_pos(found), alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table)
                                    family: sview = zeroed_value_family(params[param_index].type_expression, generic_names, generic_values, generic_owners, function_pos.line, callee_owners[callee_index], alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                                    if family != "":
                                        table <- zeroed_push_value_diagnostic(params[param_index].name, family, found, table)
                                        reported <- true
                            Decl.Extern(name: extern_name, param_start: param_start, arity: arity, _):
                                param_names: mutable darray[sview] = []
                                for param_offset in 0..<arity.usize() |param_names|:
                                    param_names.push(extern_params[param_start.usize() + param_offset].name)
                                param_index: usize = zeroed_bound_param_index(argument_index + receiver_shift, label, arity.usize(), param_names)
                                if param_index < arity.usize():
                                    param: Ast::ExternParam& = &extern_params[param_start.usize() + param_index]
                                    family: sview = zeroed_extern_param_family(param, allow_invalid)
                                    if family != "":
                                        table <- zeroed_push_value_diagnostic(param.name, family, found, table)
                                        reported <- true
                            _:
                                pass

        # The type a `<-` through a binding of TYPE_EXPRESSION writes: a reference binding
        # writes its referent, anything else the binding itself.
        def zeroed_referent_type(type_expression: Ast::Expr) -> Ast::Expr:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, _):
                        return zeroed_referent_type(operand) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                        return operand if operator == TokenKind.Ampersand
                        return type_expression
                    Expr.Paren(inner, _):
                        return zeroed_referent_type(inner)
                    _:
                        return type_expression

        # Whether a local of TYPE_EXPRESSION is a `mutable` (rebindable) binding.
        def zeroed_binding_is_rebindable(type_expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, _):
                        return true if operator == TokenKind.Mutable
                        return zeroed_binding_is_rebindable(operand) if operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                        return false
                    Expr.Paren(inner, _):
                        return zeroed_binding_is_rebindable(inner)
                    _:
                        return false

        # Every statement-level local of a function body with the type a `<-` to it writes:
        # a rebindable (`mutable`) binding is replaced whole; a plain reference local
        # writes through to its referent (stage0 rejects `r: mutable T& ...; r <- zeroed`
        # but checks `r: T&; r <- v` against T). Unannotated locals and loop variables
        # record Absent, which keeps an assignment to that name unchecked.
        def zeroed_collect_assignable_locals(statements: darray[Ast::Stmt], names: mutable darray[sview]&, types: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, types|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, _, _):
                            names.push(name)
                            if zeroed_binding_is_rebindable(type_expression):
                                types.push(type_expression)
                            else:
                                types.push(zeroed_referent_type(type_expression))
                        Stmt.If(_, then_body, else_body, _):
                            zeroed_collect_assignable_locals(then_body, names, types)
                            zeroed_collect_assignable_locals(else_body, names, types)
                        Stmt.While(_, body, _):
                            zeroed_collect_assignable_locals(body, names, types)
                        Stmt.For(variables: variables, body: body, _):
                            for variable in variables |names, types|:
                                names.push(variable)
                                types.push(Expr.Absent)
                            zeroed_collect_assignable_locals(body, names, types)
                        Stmt.Match(_, arms, _):
                            for arm in arms |names, types|:
                                zeroed_collect_assignable_locals(arm.body, names, types)
                        Stmt.Block(binding: binding, body: body, _):
                            if binding != "":
                                names.push(binding)
                                types.push(Expr.Absent)
                            zeroed_collect_assignable_locals(body, names, types)
                        _:
                            pass

        # The declared type of field FIELD_NAME of the struct STRUCT_TYPE (written in
        # STRUCT_OWNER) names. The struct's generic parameters bind to STRUCT_TYPE's explicit
        # arguments, appended to the GENERIC_* mapping. False when the struct, the field, or
        # an argument for every generic parameter cannot be established uniquely.
        def zeroed_struct_field_type(struct_type: Ast::Expr, struct_owner: sview @source, field_name: sview, alias_names: darray[sview @source]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], table: SymbolTable&, field_type: mutable Ast::Expr&, field_owner: mutable sview&, generic_names: mutable darray[sview]&, generic_values: mutable darray[Ast::Expr]&, generic_owners: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                current: mutable Ast::Expr = struct_type
                current_owner: mutable sview = struct_owner
                # A field typed by an enclosing generic parameter names its argument.
                substitutions: mutable usize = 0
                while substitutions <= generic_names.count |current, current_owner, substitutions, generic_names, generic_values, generic_owners|:
                    substituted: mutable bool = false
                    if current is Expr.Ident(parameter_name, _):
                        mapping_index: mutable usize = generic_names.count
                        while mapping_index > 0 |mapping_index, parameter_name, current, current_owner, substituted, generic_names, generic_values, generic_owners|:
                            mapping_index <- mapping_index - 1.usize()
                            if generic_names[mapping_index] == parameter_name:
                                current <- generic_values[mapping_index]
                                current_owner <- generic_owners[mapping_index]
                                substituted <- true
                                break
                    break if not substituted
                    substitutions <- substitutions + 1.usize()
                resolved: mutable Ast::Expr = current
                resolved_owner: mutable sview = current_owner
                invalid: mutable bool = false
                zeroed_resolve_type_alias_chain(current, alias_names, alias_values, declarations, alias_declarations, current_owner, table, resolved, resolved_owner, invalid)
                return false if invalid
                head: mutable Ast::Expr = resolved
                arguments: mutable darray[Ast::Expr] = []
                match resolved:
                    Expr.Index(index_head, argument, _):
                        return false if argument is Expr.IntLit(_, _)
                        head <- index_head
                        arguments.push(argument)
                    Expr.IndexN(index_head, index_arguments, _):
                        for argument in index_arguments:
                            return false if argument is Expr.IntLit(_, _)
                        head <- index_head
                        arguments.extend(index_arguments)
                    _:
                        pass
                head_owner: mutable sview = resolved_owner
                if arguments.count > 0:
                    resolved_head: mutable Ast::Expr = head
                    invalid_head: mutable bool = false
                    zeroed_resolve_type_alias_chain(head, alias_names, alias_values, declarations, alias_declarations, resolved_owner, table, resolved_head, head_owner, invalid_head)
                    return false if invalid_head
                    head <- resolved_head
                head_name: sview = ident_name_of(head)
                return false if head_name == ""
                struct_line: mutable u32 = 0
                struct_matches: mutable usize = 0
                zeroed_find_nominal_in_owner(alias_declarations, head_owner, head_name, struct_line, struct_matches)
                return false if struct_matches != 1.usize() or struct_line == 0
                struct_generic_names: mutable darray[sview] = []
                for table_index in 0..<table.generic_param_lines.count |struct_generic_names, table, struct_line|:
                    struct_generic_names.push(table.generic_param_names[table_index]) if table.generic_param_lines[table_index] == struct_line
                return false if arguments.count != struct_generic_names.count
                for field_index in 0..<table.struct_field_owner.count |table, head_name, head_owner, field_name, field_type, field_owner, generic_names, generic_values, generic_owners, struct_generic_names, arguments, resolved_owner|:
                    if table.struct_field_owner[field_index] == head_name and field_index < table.struct_field_module.count and table.struct_field_module[field_index] == head_owner and field_index < table.struct_field_name.count and table.struct_field_name[field_index] == field_name and field_index < table.private_field_types.count:
                        for generic_index in 0..<struct_generic_names.count |generic_names, generic_values, generic_owners, struct_generic_names, arguments, resolved_owner|:
                            generic_names.push(struct_generic_names[generic_index])
                            generic_values.push(arguments[generic_index])
                            generic_owners.push(resolved_owner)
                        field_type <- table.private_field_types[field_index]
                        field_owner <- head_owner
                        return true
                return false

        def zeroed_protocol_substitute_generic(type_expression: Ast::Expr, type_owner: sview, generic_names: darray[sview]&, generic_values: darray[Ast::Expr]&, generic_owners: darray[sview]&, resolved_type: mutable Ast::Expr&, resolved_owner: mutable sview&) -> void:
            can Abort.Panic:
                resolved_type <- type_expression
                resolved_owner <- type_owner
                if type_expression is Expr.Ident(parameter_name, _):
                    mapping_index: mutable usize = generic_names.count
                    while mapping_index > 0 |mapping_index, generic_names, generic_values, generic_owners, resolved_type, resolved_owner, parameter_name|:
                        mapping_index <- mapping_index - 1.usize()
                        if generic_names[mapping_index] == parameter_name and mapping_index < generic_values.count and mapping_index < generic_owners.count:
                            resolved_type <- generic_values[mapping_index]
                            resolved_owner <- generic_owners[mapping_index]
                            return

        # Return the active (tag-zero) payloads for one exact enum owner/name. The
        # declaration tree is indexed lazily once per root type walk; recursive aggregate
        # checks then follow only the bucket chain, including exact checks for hash collisions.
        def zeroed_collect_active_enum_fields(alias_declarations: darray[Ast::Decl], owner: sview, enum_name: sview, fields: mutable darray[Ast::Expr]&, index: mutable ZeroedActiveEnumIndex&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                if not index.built:
                    zeroed_build_active_enum_index(alias_declarations, "", index)
                    index.built <- true
                return if index.next.count != index.payloads.count or index.row_hashes.count != index.payloads.count or index.owners.count != index.payloads.count or index.names.count != index.payloads.count
                hash: u64 = zeroed_active_enum_key(owner, enum_name)
                expected_count: mutable usize = 0.usize()
                if index.counts.get(hash) is bucket_count:
                    expected_count <- bucket_count.usize()
                else:
                    return
                return if expected_count == 0.usize() or expected_count > index.payloads.count
                head: mutable u32 = ZEROED_ENUM_ROW_NONE
                indexed_tail: mutable u32 = ZEROED_ENUM_ROW_NONE
                if index.heads.get(hash) is bucket_head:
                    head <- bucket_head
                else:
                    return
                if index.tails.get(hash) is bucket_tail:
                    indexed_tail <- bucket_tail
                else:
                    return
                return if head.usize() >= index.payloads.count or indexed_tail.usize() >= index.payloads.count
                row: mutable u32 = head
                previous: mutable u32 = ZEROED_ENUM_ROW_NONE
                last: mutable u32 = ZEROED_ENUM_ROW_NONE
                probes: mutable usize = 0.usize()
                while row != ZEROED_ENUM_ROW_NONE |row, previous, last, probes, expected_count, hash, index|:
                    return if:
                        probes >= expected_count or row.usize() >= index.payloads.count
                        previous != ZEROED_ENUM_ROW_NONE and row <= previous
                    row_index: usize = row.usize()
                    return if index.row_hashes[row_index] != hash
                    last <- row
                    previous <- row
                    row <- index.next[row_index]
                    probes <- probes + 1.usize()
                return if probes != expected_count or last != indexed_tail
                row <- head
                probes <- 0.usize()
                while row != ZEROED_ENUM_ROW_NONE |row, probes, expected_count, owner, enum_name, fields, index|:
                    return if probes >= expected_count or row.usize() >= index.payloads.count
                    row_index: usize = row.usize()
                    if index.owners[row_index] == owner and index.names[row_index] == enum_name:
                        fields.push(index.payloads[row_index])
                    row <- index.next[row_index]
                    probes <- probes + 1.usize()

        def zeroed_protocol_check_nominal_contents(head: Ast::Expr, head_owner: sview @source, type_arguments: darray[Ast::Expr], type_argument_owner: sview, construction_scope: sview @source, position: Ast::Pos, alias_names: darray[sview @source]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], generic_names: darray[sview]&, generic_values: darray[Ast::Expr]&, generic_owners: darray[sview]&, table: lmut SymbolTable, active_enum_index: mutable ZeroedActiveEnumIndex&, depth: u32) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                type_name: sview = ident_name_of(head)
                return if type_name == ""
                nominal_line: mutable u32 = 0
                nominal_matches: mutable usize = 0
                zeroed_find_nominal_in_owner(alias_declarations, head_owner, type_name, nominal_line, nominal_matches)
                return if nominal_matches != 1.usize() or nominal_line == 0
                nominal_generics: mutable darray[sview] = []
                for table_index in 0..<table.generic_param_lines.count |table_index, nominal_line, nominal_generics, table|:
                    nominal_generics.push(table.generic_param_names[table_index]) if table.generic_param_lines[table_index] == nominal_line
                return if type_arguments.count < nominal_generics.count
                nested_names: mutable darray[sview] = []
                nested_values: mutable darray[Ast::Expr] = []
                nested_owners: mutable darray[sview] = []
                nested_names.extend(generic_names)
                nested_values.extend(generic_values)
                nested_owners.extend(generic_owners)
                for generic_index in 0..<nominal_generics.count |generic_index, nominal_generics, type_arguments, nested_names, nested_values, nested_owners, generic_names, generic_values, generic_owners, head_owner|:
                    parameter_name: sview = nominal_generics[generic_index]
                    argument: mutable Ast::Expr = type_arguments[generic_index]
                    argument_owner: mutable sview = type_argument_owner
                    zeroed_protocol_substitute_generic(argument, type_argument_owner, generic_names, generic_values, generic_owners, argument, argument_owner)
                    identity: mutable bool = false
                    if argument is Expr.Ident(argument_name, _):
                        identity <- argument_name == parameter_name
                    if not identity:
                        nested_names.push(parameter_name)
                        nested_values.push(argument)
                        nested_owners.push(argument_owner)
                row: u32 = binding_nominal_declaration(head, head_owner, table)
                return if row == SYMBOL_INDEX_ROW_NONE or row.usize() >= table.symbols.count
                symbol: Symbol = table.symbols[row.usize()]
                if symbol.kind == SymbolKind.Struct:
                    for field_index in 0..<table.struct_field_owner.count |field_index, type_name, head_owner, nested_names, nested_values, nested_owners, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, table, depth|:
                        if table.struct_field_owner[field_index] == type_name and field_index < table.struct_field_module.count and table.struct_field_module[field_index] == head_owner and field_index < table.private_field_types.count:
                            field_type: Ast::Expr = table.private_field_types[field_index]
                            table <- zeroed_protocol_check_nested_type_walk(field_type, head_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, nested_names, nested_values, nested_owners, table, active_enum_index, depth + 1)
                elif symbol.kind == SymbolKind.Enum:
                    active_fields: mutable darray[Ast::Expr] = []
                    zeroed_collect_active_enum_fields(alias_declarations, head_owner, type_name, active_fields, active_enum_index)
                    for payload_type in active_fields |payload_type, nested_names, nested_values, nested_owners, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, table, depth|:
                        table <- zeroed_protocol_check_nested_type_walk(payload_type, head_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, nested_names, nested_values, nested_owners, table, active_enum_index, depth + 1)

        def zeroed_protocol_check_nested_type_walk(type_expression: Ast::Expr, type_owner: sview @source, construction_scope: sview @source, position: Ast::Pos, alias_names: darray[sview @source]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], generic_names: darray[sview]&, generic_values: darray[Ast::Expr]&, generic_owners: darray[sview]&, table: lmut SymbolTable, active_enum_index: mutable ZeroedActiveEnumIndex&, depth: u32) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                return if depth >= 128
                substituted: mutable Ast::Expr = type_expression
                substituted_owner: mutable sview = type_owner
                zeroed_protocol_substitute_generic(type_expression, type_owner, generic_names, generic_values, generic_owners, substituted, substituted_owner)
                match substituted:
                    Expr.Unary(operator, operand, _):
                        if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                            table <- zeroed_protocol_check_nested_type_walk(operand, substituted_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, active_enum_index, depth + 1)
                        return
                    Expr.Paren(inner, _) | Expr.Refinement(inner, _, _):
                        table <- zeroed_protocol_check_nested_type_walk(inner, substituted_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, active_enum_index, depth + 1)
                        return
                    _:
                        pass
                resolved: mutable Ast::Expr = substituted
                resolved_owner: mutable sview = substituted_owner
                invalid: mutable bool = false
                zeroed_resolve_type_alias_chain(substituted, alias_names, alias_values, declarations, alias_declarations, substituted_owner, table, resolved, resolved_owner, invalid)
                return if invalid
                match resolved:
                    Expr.Unary(operator, operand, _):
                        if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                            table <- zeroed_protocol_check_nested_type_walk(operand, resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, active_enum_index, depth + 1)
                        return
                    Expr.Paren(inner, _) | Expr.Refinement(inner, _, _):
                        table <- zeroed_protocol_check_nested_type_walk(inner, resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, active_enum_index, depth + 1)
                        return
                    Expr.Tuple(elements, _):
                        for element in elements |element, resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, depth|:
                            table <- zeroed_protocol_check_nested_type_walk(element, resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, active_enum_index, depth + 1)
                        return
                    Expr.Index(head, argument, _):
                        if argument is Expr.IntLit(_, _):
                            table <- zeroed_protocol_check_nested_type_walk(head, resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, active_enum_index, depth + 1)
                            return
                        resolved_head: mutable Ast::Expr = head
                        head_owner: mutable sview = resolved_owner
                        invalid_head: mutable bool = false
                        zeroed_resolve_type_alias_chain(head, alias_names, alias_values, declarations, alias_declarations, resolved_owner, table, resolved_head, head_owner, invalid_head)
                        return if invalid_head
                        head_name: sview = ident_name_of(resolved_head)
                        if head_name == "array":
                            table <- zeroed_protocol_check_nested_type_walk(argument, resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, active_enum_index, depth + 1)
                            return
                        return if head_name == "darray" or head_name == "dict" or head_name == "set"
                        args: darray[Ast::Expr] = [argument]
                        table <- check_protocol_zeroed_state_construction(resolved, position, resolved_owner, construction_scope, table)
                        table <- zeroed_protocol_check_nominal_contents(resolved_head, head_owner, args, resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, active_enum_index, depth + 1)
                    Expr.IndexN(head, arguments, _):
                        resolved_head: mutable Ast::Expr = head
                        head_owner: mutable sview = resolved_owner
                        invalid_head: mutable bool = false
                        zeroed_resolve_type_alias_chain(head, alias_names, alias_values, declarations, alias_declarations, resolved_owner, table, resolved_head, head_owner, invalid_head)
                        return if invalid_head
                        head_name: sview = ident_name_of(resolved_head)
                        if head_name == "array" and arguments.count > 0:
                            table <- zeroed_protocol_check_nested_type_walk(arguments[0], resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, active_enum_index, depth + 1)
                            return
                        has_extent: mutable bool = false
                        for argument in arguments |has_extent|:
                            has_extent <- true if argument is Expr.IntLit(_, _)
                        if has_extent:
                            table <- zeroed_protocol_check_nested_type_walk(head, resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, active_enum_index, depth + 1)
                            return
                        return if head_name == "darray" or head_name == "dict" or head_name == "set"
                        table <- check_protocol_zeroed_state_construction(resolved, position, resolved_owner, construction_scope, table)
                        table <- zeroed_protocol_check_nominal_contents(resolved_head, head_owner, arguments, resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, active_enum_index, depth + 1)
                    Expr.Ident(name, _):
                        table <- check_protocol_zeroed_state_construction(resolved, position, resolved_owner, construction_scope, table)
                        table <- zeroed_protocol_check_nominal_contents(resolved, resolved_owner, [], resolved_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, active_enum_index, depth + 1)
                    _:
                        table <- check_protocol_zeroed_state_construction(resolved, position, resolved_owner, construction_scope, table)

        # Keep the public-to-this-file call shape small while sharing one active-enum index
        # through all recursive nominal payload checks for this root type.
        def zeroed_protocol_check_nested_type(type_expression: Ast::Expr, type_owner: sview @source, construction_scope: sview @source, position: Ast::Pos, alias_names: darray[sview @source]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], generic_names: darray[sview]&, generic_values: darray[Ast::Expr]&, generic_owners: darray[sview]&, table: lmut SymbolTable, depth: u32 = 0) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                active_enum_index: mutable ZeroedActiveEnumIndex = ZeroedActiveEnumIndex{built: false, heads: {}, tails: {}, counts: {}, next: [], row_hashes: [], owners: [], names: [], payloads: []}
                table <- zeroed_protocol_check_nested_type_walk(type_expression, type_owner, construction_scope, position, alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table, active_enum_index, depth)

        # `S{f: zeroed}`: each field whose value can be `zeroed` must admit the zero
        # representation of its declared type.
        def zeroed_check_construct(struct_type: Ast::Expr, fields: darray[Ast::FieldInit], function_line: u32, current_module: sview @source, alias_names: darray[sview @source]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], allow_invalid: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                for field in fields |table|:
                    found: mutable Ast::Expr = field.value
                    continue if not zeroed_value_reach(field.value, found)
                    field_type: mutable Ast::Expr = field.value
                    field_owner: mutable sview = current_module
                    generic_names: mutable darray[sview] = []
                    generic_values: mutable darray[Ast::Expr] = []
                    generic_owners: mutable darray[sview @source] = []
                    continue if not zeroed_struct_field_type(struct_type, current_module, field.name, alias_names, alias_values, declarations, alias_declarations, table, field_type, field_owner, generic_names, generic_values, generic_owners)
                    table <- zeroed_protocol_check_nested_type(field_type, field_owner, current_module, Ast::expr_pos(found), alias_names, alias_values, declarations, alias_declarations, generic_names, generic_values, generic_owners, table)
                    family: sview = zeroed_value_family(field_type, generic_names, generic_values, generic_owners, function_line, field_owner, alias_names, alias_values, declarations, alias_declarations, allow_invalid, table)
                    table <- zeroed_push_value_diagnostic(field.name, family, found, table) if family != ""
