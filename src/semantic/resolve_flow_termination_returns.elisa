extend Semantic:
    private:
        # Whether a statement list necessarily terminates. The first reachable statement
        # that unconditionally terminates makes every later statement unreachable.
        def statements_terminate(statements: darray[Ast::Stmt], table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                for statement in statements:
                    return true if statement_terminates(statement, table)
                return false




        # True when an uncovered-case diagnostic was already reported at `line` — any flavour,
        # since each one means the same thing for flow: this statement can fall through because
        # a case is unhandled, which is the defect already on screen.
        def line_has_non_exhaustive_diagnostic(table: SymbolTable&, line: u32) -> bool:
            can Abort.Panic:
                for diagnostic in table.diagnostics:
                    continue if diagnostic.line != line
                    uncovered: bool = match diagnostic.kind:
                        DiagnosticKind.NonExhaustiveMatch:          true
                        DiagnosticKind.NonExhaustiveOptionalMatch:  true
                        DiagnosticKind.NonExhaustiveScalarMatch:    true
                        DiagnosticKind.NonExhaustiveOpenExternEnum: true
                        _:                                          false
                    return true if uncovered
                return false

        # Check that a non-void function body guarantees a return on all paths.
        # If the body can fall through without returning, report MissingReturnValue
        # on the last statement (or the function line if body is empty).
        def check_missing_return(body: darray[Ast::Stmt], is_void: bool, function_name: sview @source, table: lmut SymbolTable, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                if is_void or body.count == 0:
                    # Void functions never need a return, and empty bodies are handled elsewhere
                    return if is_void
                    # Empty non-void body is missing a return
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MissingReturnValue, name: function_name, line: line, expected: "", actual: "", detail: "noloc"})
                    return
                if not statements_terminate(body, table):
                    # Body doesn't guarantee a return; flag the last statement
                    last_line: mutable u32 = statement_line(body[body.count - 1])
                    last_line <- line if last_line == 0
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MissingReturnValue, name: function_name, line: last_line, expected: "", actual: "", detail: "noloc"})
