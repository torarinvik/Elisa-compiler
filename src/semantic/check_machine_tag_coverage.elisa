# docs/125 §9 Tier-2 machine tag-coverage. The parser records, for every `machine over` whose
# input is a free-function (classifier) call, one MachineCoverageRow per arm-atom (a spelled
# variant tag, or a wildcard/bind marker). Only here — with the symbol table — can we learn the
# classifier's return type; when it is a CLOSED const enum ("classified dispatch"), every state
# must spell all the enum's variants as explicit tags (the add-a-variant safety net) and a `_`
# wildcard is REJECTED (on a closed domain a wildcard is exactly what erases that net). Mirrors
# stage0's checkMachineCoverage (analyzer_machine_coverage.go). Rows sharing a `line` (the
# machine head token) belong to one machine; rows grouped by (line, state_name) reconstruct a
# state's tag set + wildcard flag.
extend Semantic:
    private:
        # Whether the (line, state_name) group of the row at `index` is first seen here — so each
        # state is enforced exactly once even though its arm-atoms are several rows.
        def machine_coverage_group_head(rows: darray[Ast::MachineCoverageRow], index: usize) -> bool:
            can Abort.Panic:
                row: Ast::MachineCoverageRow = rows[index]
                earlier: mutable usize = 0
                while earlier < index:
                    false return if rows[earlier].line == row.line and rows[earlier].state_name == row.state_name
                    earlier <- earlier + 1
                return true

        # Whether the (line, state_name) group has a wildcard/bind arm.
        def machine_group_has_wildcard(rows: darray[Ast::MachineCoverageRow], row_line: u32, state_name: sview) -> bool:
            can Abort.Panic:
                index: mutable usize = 0
                while index < rows.count:
                    true return if rows[index].line == row_line and rows[index].state_name == state_name and rows[index].has_wildcard
                    index <- index + 1
                return false

        # Whether the (line, state_name) group spells `variant` as an explicit tag.
        def machine_group_spells(rows: darray[Ast::MachineCoverageRow], row_line: u32, state_name: sview, variant: sview) -> bool:
            can Abort.Panic:
                index: mutable usize = 0
                while index < rows.count:
                    true return if rows[index].line == row_line and rows[index].state_name == state_name and rows[index].tag == variant
                    index <- index + 1
                return false

        # The declared return-type name of a top-level function `fn_name`, or "".
        def machine_classifier_return_type(table: SymbolTable&, fn_name: sview) -> sview:
            can Abort.Panic:
                if find_symbol(table, fn_name) is sym:
                    sym.return_type return if sym.kind == SymbolKind.Func
                return ""

        # Enforce Tier-2 on one (row_line, state_name) group against a CLOSED enum's variants: a
        # wildcard is rejected; otherwise every variant must be spelled.
        def enforce_machine_tag_coverage_state(rows: darray[Ast::MachineCoverageRow], row_line: u32, state_name: sview, enum_name: sview, variants: darray[Ast::EnumVariant], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                wildcard: bool = machine_group_has_wildcard(rows, row_line, state_name)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MachineTagCoverage, name: state_name, line: row_line, expected: enum_name, actual: "_"}) if wildcard
                for variant in variants |table|:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.MachineTagCoverage, name: state_name, line: row_line, expected: enum_name, actual: variant.name}) if not wildcard and not machine_group_spells(rows, row_line, state_name, variant.name)

        # Find the CLOSED const enum named `enum_name` in the declaration tree (recursing into
        # modules/scopes); when found, enforce Tier-2 on the group. A non-const-enum return type
        # matches nothing — that machine is open-domain (the parser already checked its `_`).
        def enforce_machine_tag_coverage(declarations: darray[Ast::Decl], rows: darray[Ast::MachineCoverageRow], row_line: u32, state_name: sview, enum_name: sview, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Enum(name, variants, is_const, storage_type, enum_line):
                            table <- enforce_machine_tag_coverage_state(rows, row_line, state_name, enum_name, variants, table) if is_const and name == enum_name
                        Decl.Module(module_name, body, module_line):
                            table <- enforce_machine_tag_coverage(body, rows, row_line, state_name, enum_name, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- enforce_machine_tag_coverage(scoped_body, rows, row_line, state_name, enum_name, table)
                        _:
                            pass

        # Entry: for each machine-state group, resolve the classifier's return type and, if it is
        # a closed const enum, enforce Tier-2 (docs/125 §9).
        def check_machine_tag_coverage(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                index: mutable usize = 0
                while index < file.machine_coverage.count |table, index|:
                    row: Ast::MachineCoverageRow = file.machine_coverage[index]
                    enum_name: sview = machine_classifier_return_type(table, row.input_callee)
                    table <- enforce_machine_tag_coverage(file.top_decls, file.machine_coverage, row.line, row.state_name, enum_name, table) if enum_name != "" and machine_coverage_group_head(file.machine_coverage, index)
                    index <- index + 1
