# Same-call argument exclusivity: a `mutable T&` parameter must not alias another reference
# argument of the same call.
#
# The backend stamps `noalias` on scalar `mutable T&` parameters under `-fnoalias`, so
# `f(&x, &x)` with `def f(a: mutable i64&, b: mutable i64&)` was a SILENT MISCOMPILE in
# both compilers: `a <- 1; b <- 2; return a` folded to `ret 1`. Without the flag it is still
# a memory-safety hole: `g(&v, &v[0])` hands the callee an element reference that a push
# through `v` leaves dangling.
#
# The rule is deliberately syntactic and conservative. Two arguments conflict when they are
# both `&PLACE` (or both bare places) with the same root binding and overlapping paths, and at
# least one of them lands in a `mutable T&` parameter while the other lands in any reference
# parameter. Paths overlap when one is a prefix of the other, step by step, unless some step
# pair is provably disjoint: two different field names, or two different integer-literal
# indices. A non-literal index may overlap (`swap(&v[i], &v[j])` is rejected: i == j is
# allowed at runtime). A `can Unsafe.Alias:` / `trusted Unsafe.Alias:` block (or a broad
# `Unsafe` grant) opts its body out, as stage0's strict mode allows.
# A VIEW argument (`buf.as_sview()`, `buf.as_cstr()`, `buf.view()`, `buf[a:b]`, or a local bound
# to one) bound to a by-value view parameter (sview, cstr, view[T]) borrows the viewed storage
# like `&buf[..]`: `use(&buf, buf.as_sview())` lets the callee grow buf and then read a dangling
# view (fuzz F3). It is checked as `&PLACE[..]`, so the container equal-place exemption never
# applies to it. Only calls that resolve by name to exactly one declared function (or to a
# local or parameter of function type, whose reference parameters are all taken as mutable)
# are checked; builtin methods, externs and overloaded names are left alone.
#
# What an argument borrows is computed by check_call_argument_exclusivity_refs.elisa: ref
# locals (including `r = id(&x)`, `r = &x if c else &y` and `&r.field`), references returned
# by calls, and borrows stored in struct/array/dict values. A call lending a global to a
# callee that touches it by name is check_call_argument_exclusivity_globals.elisa.
extend Semantic:
    private:
        # The literal value of an index expression, when it is an integer literal.
        def exclusivity_index_literal(index: Ast::Expr) -> (known: bool, value: i64):
            can Memory.Allocate, Abort.Panic:
                match index:
                    Expr.IntLit(value, position):
                        return (true, value)
                    Expr.Paren(inner, position):
                        return exclusivity_index_literal(inner)
                    _:
                        return (false, 0)

        # The root binding of a place expression, appending its steps (root outward) to the
        # step tables: kind 0 = field NAME, 1 = literal index VALUE, 2 = unknown index/slice.
        # Returns "" when EXPRESSION is not a place.
        def exclusivity_place(expression: Ast::Expr, kinds: mutable darray[u8]&, names: mutable darray[sview]&, values: mutable darray[i64]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, position):
                        return name
                    Expr.Paren(inner, position):
                        return exclusivity_place(inner, kinds, names, values)
                    Expr.Field(object, field, position):
                        field_root: sview = exclusivity_place(object, kinds, names, values)
                        if field_root != "":
                            kinds.push(0)
                            names.push(field)
                            values.push(0)
                        return field_root
                    Expr.Index(object, index, position):
                        index_root: sview = exclusivity_place(object, kinds, names, values)
                        if index_root != "":
                            literal: (known: bool, value: i64) = exclusivity_index_literal(index)
                            kinds.push(1 if literal.known else 2)
                            names.push("")
                            values.push(literal.value)
                        return index_root
                    Expr.Slice(object, low, high, position):
                        slice_root: sview = exclusivity_place(object, kinds, names, values)
                        if slice_root != "":
                            kinds.push(2)
                            names.push("")
                            values.push(0)
                        return slice_root
                    _:
                        return ""

        # Whether the step paths [a_start, a_start+a_count) and [b_start, b_start+b_count)
        # may name overlapping memory: no step pair on the common prefix is provably disjoint.
        def exclusivity_paths_overlap(kinds: darray[u8]&, names: darray[sview]&, values: darray[i64]&, a_start: usize, a_count: usize, b_start: usize, b_count: usize) -> bool:
            can Abort.Panic:
                step: mutable usize = 0
                while step < a_count and step < b_count:
                    a_kind: u8 = kinds[a_start + step]
                    b_kind: u8 = kinds[b_start + step]
                    false return if a_kind == 0 and b_kind == 0 and names[a_start + step] != names[b_start + step]
                    false return if a_kind == 1 and b_kind == 1 and values[a_start + step] != values[b_start + step]
                    step <- step + 1
                return true

        # Whether PARAMETER's type is a reference of any mutability.
        def exclusivity_param_is_ref(parameter: Ast::ParamDecl) -> bool:
            can Memory.Allocate, Abort.Panic:
                return type_marker_present_here(parameter.type_expression, TokenKind.Ampersand)

        # Whether PARAMETER is a by-value view: `sview`, `cstr` or `view[T]` (any mutability).
        def exclusivity_param_is_view(parameter: Ast::ParamDecl) -> bool:
            can Memory.Allocate, Abort.Panic:
                return exclusivity_type_is_view(parameter.type_expression)

        def exclusivity_type_is_view(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Ident(type_name, _):
                        return type_name == "sview" or type_name == "cstr"
                    Expr.Index(Expr.Ident(head_name, _), _, _):
                        return head_name == "view"
                    Expr.Unary(operator, operand, _):
                        return operator != TokenKind.Ampersand and exclusivity_type_is_view(operand)
                    Expr.Paren(inner, _):
                        return exclusivity_type_is_view(inner)
                    _:
                        return false

        # The storage a view-producing ARGUMENT points into, as an `&PLACE[..]` borrow:
        # `x.as_sview()` / `x.as_cstr()` / `x.view()` -> (true, x[..]), `x[a:b]` -> (true, x[a:b]),
        # when `x` is a container local or parameter (a row of the ref-local tables whose place is
        # Absent:
        # a darray/dstr/set/dict that owns the buffer the view points into; slicing an sview views
        # ITS bytes instead). Anything else is returned unchanged.
        def exclusivity_view_borrow(argument: Ast::Expr, refs: ExclusivityRefs&) -> (address: bool, place: Ast::Expr):
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Paren(inner, _):
                        return exclusivity_view_borrow(inner, refs)
                    Expr.Call(Expr.Field(receiver, method, method_pos), call_arguments, _, _):
                        if call_arguments.count == 0 and (method == "as_sview" or method == "as_cstr" or method == "view") and exclusivity_is_container_name(exclusivity_ident_name(receiver), refs):
                            return (true, Ast::Expr.Slice(receiver, Ast::Expr.Absent, Ast::Expr.Absent, method_pos))
                        return (false, argument)
                    Expr.Slice(slice_object, _, _, _):
                        return (true, argument) if exclusivity_is_container_name(exclusivity_ident_name(slice_object), refs)
                        return (false, argument)
                    _:
                        return (false, argument)

        def exclusivity_is_container_name(name: sview, refs: ExclusivityRefs&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if name == ""
                index: mutable usize = 0
                while index < refs.names.count |index|:
                    return true if refs.names[index] == name and (refs.places[index] is Expr.Absent)
                    index <- index + 1
                return false

        # Whether the referent of TYPE_EXPRESSION is a generic container instantiation
        # (`darray[T]`, `dict[K, V]`, ...). The backend never stamps `noalias` on those, and a
        # second reference to the same container header cannot dangle, so stage0 accepts an
        # equal-place pair of them in every mode (its disjointness proof gates the attribute).
        def exclusivity_pointee_is_container(type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, line):
                        return exclusivity_pointee_is_container(operand)
                    Expr.Paren(inner, line):
                        return exclusivity_pointee_is_container(inner)
                    Expr.Index(object, index, line):
                        return true
                    Expr.IndexN(object, arguments, line):
                        return true
                    _:
                        return false

        # The declared functions of the file, flattened (all modules): NAME, its parameters at
        # [start, start+count) of PARAMS, whether it returns a reference, and the direct global
        # facts the global half reads (check_call_argument_exclusivity_globals.elisa).
        struct ExclusivityFns:
            names: darray[sview]
            lookup: dict[u64, usize]
            starts: darray[usize]
            counts: darray[usize]
            params: darray[Ast::ParamDecl]
            returns_ref: darray[bool]
            fn_type_lines: darray[u32]
            fn_type_exprs: darray[Ast::Expr]
            globals: darray[sview]
            fact_starts: darray[usize]
            fact_counts: darray[usize]
            fact_names: darray[sview]
            fact_write: darray[bool]
            callee_starts: darray[usize]
            callee_counts: darray[usize]
            callee_names: darray[sview]

        def exclusivity_collect_declared(declarations: darray[Ast::Decl], globals: darray[sview]&, function_names: mutable darray[sview]&, starts: mutable darray[usize]&, counts: mutable darray[usize]&, params: mutable darray[Ast::ParamDecl]&, returns_ref: mutable darray[bool]&, fact_starts: mutable darray[usize]&, fact_counts: mutable darray[usize]&, fact_names: mutable darray[sview]&, fact_write: mutable darray[bool]&, callee_starts: mutable darray[usize]&, callee_counts: mutable darray[usize]&, callee_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |function_names, starts, counts, params, returns_ref, fact_starts, fact_counts, fact_names, fact_write, callee_starts, callee_counts, callee_names|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, position):
                            function_names.push(name)
                            starts.push(params.count)
                            counts.push(parameters.count)
                            params.extend(parameters)
                            reference_result: mutable bool = false
                            if return_type is declared_return:
                                reference_result <- type_marker_present_here(declared_return, TokenKind.Ampersand)
                            returns_ref.push(reference_result)
                            exclusivity_collect_global_facts(parameters, body, globals, fact_starts, fact_counts, fact_names, fact_write, callee_starts, callee_counts, callee_names)
                        Decl.Module(module_name, module_body, module_position):
                            exclusivity_collect_declared(module_body, globals, function_names, starts, counts, params, returns_ref, fact_starts, fact_counts, fact_names, fact_write, callee_starts, callee_counts, callee_names)
                        Decl.Scoped(scoped_body, scoped_position):
                            exclusivity_collect_declared(scoped_body, globals, function_names, starts, counts, params, returns_ref, fact_starts, fact_counts, fact_names, fact_write, callee_starts, callee_counts, callee_names)
                        _:
                            pass

        # Sentinel lookup value: two declared names share this hash slot (an overload or a
        # hash collision), so the slot cannot answer by itself and the list is scanned.
        const EXCLUSIVITY_LOOKUP_SCAN: usize = 18446744073709551615

        # name_hash -> the one function_names index with that hash, or EXCLUSIVITY_LOOKUP_SCAN.
        def exclusivity_function_lookup(function_names: darray[sview]&) -> dict[u64, usize]:
            can Memory.Allocate, Abort.Panic:
                lookup: mutable dict[u64, usize] = {}
                for index in 0..<function_names.count |lookup, function_names|:
                    hash: u64 = name_hash(function_names[index])
                    if lookup.get(hash) is existing:
                        lookup <- lookup.put(hash, EXCLUSIVITY_LOOKUP_SCAN) can Global{Read,Write}
                    else:
                        lookup <- lookup.put(hash, index) can Global{Read,Write}
                return lookup

        # The one declared function named NAME, or fns.names.count when there is none or the
        # name is ambiguous.
        def exclusivity_unique_declared(fns: ExclusivityFns&, name: sview) -> usize:
            can Memory.Allocate, Abort.Panic:
                candidates: mutable darray[usize] = []
                exclusivity_functions_named(fns, name, candidates)
                return candidates[0] if candidates.count == 1
                return fns.names.count

        # The parameter slot argument ARGUMENT_INDEX binds to: its label when named, else its
        # position. The parameter count when it binds to none.
        def exclusivity_argument_slot(argument_names: darray[sview]&, argument_index: usize, params: darray[Ast::ParamDecl]&) -> usize:
            can Abort.Panic:
                label: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                return argument_index if label == "" else exclusivity_label_slot(label, params)

        def exclusivity_label_slot(label: sview, params: darray[Ast::ParamDecl]&) -> usize:
            can Abort.Panic:
                slot: mutable usize = 0
                while slot < params.count:
                    return slot if params[slot].name == label
                    slot <- slot + 1
                return params.count

        def exclusivity_name_listed(list: darray[sview]&, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if name == ""
                index: mutable usize = 0
                while index < list.count |index|:
                    return true if list[index] == name
                    index <- index + 1
                return false

        def exclusivity_note_binder(name: sview, binders: mutable darray[sview]&, repeated: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                if exclusivity_name_listed(binders, name):
                    repeated.push(name)
                else:
                    binders.push(name)

        def exclusivity_ident_name(expression: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, position):
                        return name
                    Expr.Paren(inner, position):
                        return exclusivity_ident_name(inner)
                    _:
                        return ""

        def exclusivity_ref_slot(ref_names: darray[sview]&, name: sview) -> usize:
            can Memory.Allocate, Abort.Panic:
                return ref_names.count if name == ""
                index: mutable usize = 0
                while index < ref_names.count |index|:
                    return index if ref_names[index] == name
                    index <- index + 1
                return ref_names.count

        # Whether NAME owns a reference row (it stands for a borrow of some place).
        def exclusivity_is_ref_local(refs: ExclusivityRefs&, name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if name == ""
                index: mutable usize = 0
                while index < refs.names.count |index|:
                    if refs.names[index] == name:
                        match refs.places[index]:
                            Expr.Absent:
                                pass
                            Expr.Move(_, _):
                                pass
                            _:
                                return true
                    index <- index + 1
                return false

        def exclusivity_index_listed(list: darray[usize]&, value: usize) -> bool:
            can Abort.Panic:
                index: mutable usize = 0
                while index < list.count |index|:
                    return true if list[index] == value
                    index <- index + 1
                return false

        def exclusivity_check_call(callee_name: sview, arguments: darray[Ast::Expr], argument_names: darray[sview], fns: ExclusivityFns&, refs: ExclusivityRefs&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # A single argument cannot alias another: answer before the function lookup
                # unless the file has a global the argument might lend.
                return if arguments.count < 2 and fns.globals.count == 0
                params: mutable darray[Ast::ParamDecl] = []
                fn_value: bool = exclusivity_name_listed(refs.fn_names, callee_name)
                if fn_value:
                    # A call through a function value: its type's parameters, every reference
                    # among them taken as mutable (the value may be any matching function).
                    exclusivity_fn_value_params(refs.fn_types[exclusivity_ref_slot(refs.fn_names, callee_name)], fns, params)
                else:
                    function_index: usize = exclusivity_unique_declared(fns, callee_name)
                    return if function_index == fns.names.count
                    offset: mutable usize = 0
                    while offset < fns.counts[function_index] |offset, params|:
                        params.push(fns.params[fns.starts[function_index] + offset])
                        offset <- offset + 1
                return if params.count == 0
                entries: mutable ExclusivityEntries = exclusivity_no_entries()
                entry_arguments: mutable darray[usize] = []
                entry_slots: mutable darray[usize] = []
                argument_index: mutable usize = 0
                for argument in arguments |argument_index, entries, entry_arguments, entry_slots|:
                    slot: usize = exclusivity_argument_slot(argument_names, argument_index, params)
                    start: usize = entries.places.count
                    exclusivity_argument_borrows(argument, fns, refs, entries)
                    if slot < params.count and exclusivity_param_is_view(params[slot]) and entries.places.count == start + 1 and not entries.addressed[start]:
                        viewed: (address: bool, place: Ast::Expr) = exclusivity_view_borrow(argument, refs)
                        if viewed.address:
                            entries.places[start] <- viewed.place
                            entries.addressed[start] <- true
                    while entry_arguments.count < entries.places.count |entry_arguments, entry_slots|:
                        entry_arguments.push(argument_index)
                        entry_slots.push(slot)
                    argument_index <- argument_index + 1
                roots: mutable darray[sview] = []
                step_starts: mutable darray[usize] = []
                step_counts: mutable darray[usize] = []
                kinds: mutable darray[u8] = []
                names: mutable darray[sview] = []
                values: mutable darray[i64] = []
                entry: mutable usize = 0
                while entry < entries.places.count |entry, roots, step_starts, step_counts, kinds, names, values|:
                    first_step: usize = kinds.count
                    roots.push(exclusivity_place(entries.places[entry], kinds, names, values))
                    step_starts.push(first_step)
                    step_counts.push(kinds.count - first_step)
                    entry <- entry + 1
                if fns.globals.count > 0 and not fn_value:
                    table <- exclusivity_check_global_lends(callee_name, arguments, params, entries, entry_arguments, entry_slots, roots, fns, refs, table)
                return if arguments.count < 2
                reported: mutable darray[usize] = []
                later: mutable usize = 1
                while later < entries.places.count |later, reported, table| -> table:
                    earlier: mutable usize = 0
                    while earlier < later |earlier, reported, table| -> table:
                        later_slot: usize = entry_slots[later]
                        earlier_slot: usize = entry_slots[earlier]
                        same_kind: bool = entries.addressed[later] == entries.addressed[earlier] or exclusivity_formal_pair(entries, later, earlier, step_counts, refs)
                        same_place_kind: bool = entry_arguments[later] != entry_arguments[earlier] and roots[later] != "" and roots[later] == roots[earlier] and same_kind and later_slot < params.count and earlier_slot < params.count and later_slot != earlier_slot
                        if same_place_kind:
                            later_param: Ast::ParamDecl = params[later_slot]
                            earlier_param: Ast::ParamDecl = params[earlier_slot]
                            # A held entry is a borrow stored in a value: it is lent whatever the
                            # parameter's type, and taken as a shared borrow.
                            later_mutable: bool = not entries.held[later] and (param_is_mutable_ref(later_param) or (fn_value and exclusivity_param_is_ref(later_param)))
                            earlier_mutable: bool = not entries.held[earlier] and (param_is_mutable_ref(earlier_param) or (fn_value and exclusivity_param_is_ref(earlier_param)))
                            later_borrows: bool = entries.held[later] or exclusivity_param_is_ref(later_param) or exclusivity_param_is_view(later_param)
                            earlier_borrows: bool = entries.held[earlier] or exclusivity_param_is_ref(earlier_param) or exclusivity_param_is_view(earlier_param)
                            conflicting_params: bool = (later_mutable and earlier_borrows) or (earlier_mutable and later_borrows)
                            # A bare place names the reference it holds, so only an EQUAL path is
                            # the same referent; `&PLACE` paths conflict on any prefix overlap.
                            path_conflict: bool = exclusivity_paths_overlap(kinds, names, values, step_starts[earlier], step_counts[earlier], step_starts[later], step_counts[later]) and (entries.addressed[later] or step_counts[later] == step_counts[earlier])
                            # An EQUAL place under container-typed mutable params is a shared
                            # header, not a noalias violation or a dangling element; a prefix
                            # (`&v` with `&v[0]`) still dangles after growth and stays rejected.
                            equal_path: bool = step_counts[later] == step_counts[earlier]
                            container_only: bool = (not later_mutable or exclusivity_pointee_is_container(later_param.type_expression)) and (not earlier_mutable or exclusivity_pointee_is_container(earlier_param.type_expression))
                            pair_key: usize = entry_arguments[later] * arguments.count + entry_arguments[earlier]
                            if conflicting_params and path_conflict and not (equal_path and container_only) and not exclusivity_index_listed(reported, pair_key):
                                reported.push(pair_key)
                                # The sentence names PARAMETERS ("passes x to mutable reference
                                # parameter b while argument for a ...").
                                mutable_param: sview = later_param.name if later_mutable else earlier_param.name
                                other_param: sview = earlier_param.name if later_mutable else later_param.name
                                # The route named is the borrowing side's, else the mutable side's.
                                other_entry: usize = earlier if later_mutable else later
                                mutable_entry: usize = later if later_mutable else earlier
                                via_entry: usize = other_entry if entries.via_kind[other_entry] != "" else mutable_entry
                                via_kind: mutable sview = entries.via_kind[via_entry]
                                via_name: mutable sview = entries.via_name[via_entry]
                                if via_kind == "" and fn_value:
                                    via_kind <- "fnvalue"
                                    via_name <- callee_name
                                at: Ast::Pos = Ast::expr_pos(arguments[entry_arguments[later]])
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CallArgumentAlias, name: roots[later], pos: at, line: at.line, expected: mutable_param, actual: callee_name, detail: other_param, detail2: via_kind, detail3: via_name})
                        earlier <- earlier + 1
                    later <- later + 1

        # A call lending a global (`f(&g)`, `f(&gv[0])`, `f(r)` with `r = &g`) to a callee that
        # writes it by name, or reads it while the borrow is a `mutable T&`.
        def exclusivity_check_global_lends(callee_name: sview, arguments: darray[Ast::Expr], params: darray[Ast::ParamDecl]&, entries: ExclusivityEntries&, entry_arguments: darray[usize]&, entry_slots: darray[usize]&, roots: darray[sview]&, fns: ExclusivityFns&, refs: ExclusivityRefs&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                reported: mutable darray[usize] = []
                entry: mutable usize = 0
                while entry < entries.places.count |entry, reported, table| -> table:
                    root: sview = roots[entry]
                    lent: bool = entries.addressed[entry] and exclusivity_is_global(root, fns.globals, refs.locals) and not exclusivity_index_listed(reported, entry_arguments[entry])
                    if lent:
                        mutable_borrow: bool = not entries.held[entry] and entry_slots[entry] < params.count and param_is_mutable_ref(params[entry_slots[entry]])
                        writes: bool = exclusivity_callee_touches_global(fns, callee_name, root, true)
                        reads: bool = not writes and mutable_borrow and exclusivity_callee_touches_global(fns, callee_name, root, false)
                        if writes or reads:
                            reported.push(entry_arguments[entry])
                            at: Ast::Pos = Ast::expr_pos(arguments[entry_arguments[entry]])
                            touch: sview = "writes" if writes else "reads"
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CallLendsGlobal, name: root, pos: at, line: at.line, expected: touch, actual: callee_name})
                    entry <- entry + 1

        # `recv.f(args)` calling a declared free function `f` (uniform call syntax) passes
        # the receiver as `f`'s first argument, auto-borrowed when that parameter is a
        # reference: `c.poke(&c.v)` was the same -fnoalias miscompile as `poke(&c, &c.v)`.
        # Only an exact arity match with a reference first parameter is treated this way,
        # so builtin methods (`v.push`) and callable fields are left alone.
        def exclusivity_check_method_call(callee: Ast::Expr, arguments: darray[Ast::Expr], argument_names: darray[sview], fns: ExclusivityFns&, refs: ExclusivityRefs&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Field(object, field, field_position):
                        return if exclusivity_name_listed(refs.fn_names, field)
                        function_index: usize = exclusivity_unique_declared(fns, field)
                        return if function_index == fns.names.count or fns.counts[function_index] != arguments.count + 1
                        return if not exclusivity_param_is_ref(fns.params[fns.starts[function_index]])
                        # A resolved ref local already names its referent; anything else is
                        # borrowed in place.
                        receiver: Ast::Expr = object if exclusivity_is_ref_local(refs, exclusivity_ident_name(object)) else Ast::Expr.Unary(TokenKind.Ampersand, object, field_position)
                        with_receiver: mutable darray[Ast::Expr] = [receiver]
                        for argument in arguments |with_receiver|:
                            with_receiver.push(argument)
                        labels: mutable darray[sview] = []
                        if argument_names.count > 0:
                            labels.push("")
                            for label in argument_names |labels|:
                                labels.push(label)
                        table <- exclusivity_check_call(field, with_receiver, labels, fns, refs, table)
                    _:
                        pass

        def exclusivity_walk_expression(expression: Ast::Expr, fns: ExclusivityFns&, refs: ExclusivityRefs&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, position):
                        callee_name: sview = exclusivity_callee_name(callee)
                        table <- exclusivity_check_call(callee_name, arguments, argument_names, fns, refs, table) if callee_name != ""
                        table <- exclusivity_check_method_call(callee, arguments, argument_names, fns, refs, table)
                        table <- exclusivity_walk_expression(callee, fns, refs, table)
                        for argument in arguments |table| -> table:
                            table <- exclusivity_walk_expression(argument, fns, refs, table)
                    Expr.Binary(left, operator, right, position):
                        table <- exclusivity_walk_expression(left, fns, refs, table)
                        table <- exclusivity_walk_expression(right, fns, refs, table)
                    Expr.Unary(operator, operand, position):
                        table <- exclusivity_walk_expression(operand, fns, refs, table)
                    Expr.Move(operand, position):
                        table <- exclusivity_walk_expression(operand, fns, refs, table)
                    Expr.RegionNew(operand, region, position):
                        table <- exclusivity_walk_expression(operand, fns, refs, table)
                    Expr.Paren(inner, position):
                        table <- exclusivity_walk_expression(inner, fns, refs, table)
                    Expr.Field(object, field, position):
                        table <- exclusivity_walk_expression(object, fns, refs, table)
                    Expr.Index(object, index, position):
                        table <- exclusivity_walk_expression(object, fns, refs, table)
                        table <- exclusivity_walk_expression(index, fns, refs, table)
                    Expr.Slice(object, low, high, position):
                        table <- exclusivity_walk_expression(object, fns, refs, table)
                        table <- exclusivity_walk_expression(low, fns, refs, table)
                        table <- exclusivity_walk_expression(high, fns, refs, table)
                    Expr.IndexN(object, arguments, position):
                        table <- exclusivity_walk_expression(object, fns, refs, table)
                        for argument in arguments |table| -> table:
                            table <- exclusivity_walk_expression(argument, fns, refs, table)
                    Expr.Array(elements, position):
                        for element in elements |table| -> table:
                            table <- exclusivity_walk_expression(element, fns, refs, table)
                    Expr.Tuple(elements, position):
                        for element in elements |table| -> table:
                            table <- exclusivity_walk_expression(element, fns, refs, table)
                    Expr.SetLit(elements, position):
                        for element in elements |table| -> table:
                            table <- exclusivity_walk_expression(element, fns, refs, table)
                    Expr.DictLit(entries, position):
                        for entry in entries |table| -> table:
                            table <- exclusivity_walk_expression(entry.key, fns, refs, table)
                            table <- exclusivity_walk_expression(entry.value, fns, refs, table)
                    Expr.Construct(type_expression, fields, position):
                        for field in fields |table| -> table:
                            table <- exclusivity_walk_expression(field.value, fns, refs, table)
                    Expr.RecordUpdate(base, fields, position):
                        table <- exclusivity_walk_expression(base, fns, refs, table)
                        for field in fields |table| -> table:
                            table <- exclusivity_walk_expression(field.value, fns, refs, table)
                    Expr.If(condition, then_expression, else_expression, position):
                        table <- exclusivity_walk_expression(condition, fns, refs, table)
                        table <- exclusivity_walk_expression(then_expression, fns, refs, table)
                        table <- exclusivity_walk_expression(else_expression, fns, refs, table)
                    Expr.Comprehension(variable, iterable, condition, body, position):
                        table <- exclusivity_walk_expression(iterable, fns, refs, table)
                        table <- exclusivity_walk_expression(condition, fns, refs, table)
                        table <- exclusivity_walk_expression(body, fns, refs, table)
                    Expr.Lambda(lambda_params, body, position):
                        table <- exclusivity_walk_statements(body, fns, refs, table)
                    Expr.Block(statements, value, captures, position):
                        table <- exclusivity_walk_statements(statements, fns, refs, table)
                        table <- exclusivity_walk_expression(value, fns, refs, table)
                    Expr.Match(scrutinee, arms, position):
                        table <- exclusivity_walk_expression(scrutinee, fns, refs, table)
                        for arm in arms |table| -> table:
                            table <- exclusivity_walk_expression(arm.guard, fns, refs, table)
                            table <- exclusivity_walk_statements(arm.body, fns, refs, table)
                    _:
                        pass

        # A free-function callee's name: `f` or `Mod::f`. "" for anything else.
        def exclusivity_callee_name(callee: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Ident(name, position):
                        return name
                    Expr.Scope(base, name, position):
                        return name
                    _:
                        return ""

        def exclusivity_walk_statements(statements: darray[Ast::Stmt], fns: ExclusivityFns&, refs: ExclusivityRefs&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, position):
                            table <- exclusivity_walk_expression(expression, fns, refs, table)
                        Stmt.VarDecl(name, type_expression, value, position):
                            table <- exclusivity_walk_expression(value, fns, refs, table)
                        Stmt.Assign(target, operator, value, position):
                            table <- exclusivity_walk_expression(target, fns, refs, table)
                            table <- exclusivity_walk_expression(value, fns, refs, table)
                        Stmt.If(condition, then_body, else_body, position):
                            table <- exclusivity_walk_expression(condition, fns, refs, table)
                            table <- exclusivity_walk_statements(then_body, fns, refs, table)
                            table <- exclusivity_walk_statements(else_body, fns, refs, table)
                        Stmt.While(condition, body, position):
                            table <- exclusivity_walk_expression(condition, fns, refs, table)
                            table <- exclusivity_walk_statements(body, fns, refs, table)
                        Stmt.For(binding, variables, iterable, body, position):
                            table <- exclusivity_walk_expression(iterable, fns, refs, table)
                            table <- exclusivity_walk_statements(body, fns, refs, table)
                        Stmt.Block(kind, clause, binding, body, position):
                            # `can Unsafe.Alias:` / `trusted Unsafe.Alias:` (or a broad `Unsafe`)
                            # is the explicit opt-out stage0's strict mode names in its message.
                            granted: bool = (kind == "can" or kind == "trusted") and strict_unsafe_grant_covers(clause, "Unsafe.Alias")
                            table <- exclusivity_walk_statements(body, fns, refs, table) if not granted
                        Stmt.Match(scrutinee, arms, position):
                            table <- exclusivity_walk_expression(scrutinee, fns, refs, table)
                            for arm in arms |table| -> table:
                                table <- exclusivity_walk_expression(arm.guard, fns, refs, table)
                                table <- exclusivity_walk_statements(arm.body, fns, refs, table)
                        Stmt.Return(value, position):
                            table <- exclusivity_walk_expression(return_value, fns, refs, table) if value is return_value
                        _:
                            pass

        def exclusivity_walk_declarations(declarations: darray[Ast::Decl], fns: ExclusivityFns&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, position):
                            refs: mutable ExclusivityRefs = exclusivity_no_refs()
                            exclusivity_collect_refs(parameters, body, fns, refs)
                            table <- exclusivity_walk_statements(body, fns, refs, table)
                        Decl.Module(module_name, module_body, module_position):
                            table <- exclusivity_walk_declarations(module_body, fns, table)
                        Decl.Scoped(scoped_body, scoped_position):
                            table <- exclusivity_walk_declarations(scoped_body, fns, table)
                        _:
                            pass

    public:
        def check_call_argument_exclusivity(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                globals: mutable darray[sview] = []
                collect_mutable_globals(file.top_decls, globals)
                function_names: mutable darray[sview] = []
                starts: mutable darray[usize] = []
                counts: mutable darray[usize] = []
                params: mutable darray[Ast::ParamDecl] = []
                returns_ref: mutable darray[bool] = []
                fact_starts: mutable darray[usize] = []
                fact_counts: mutable darray[usize] = []
                fact_names: mutable darray[sview] = []
                fact_write: mutable darray[bool] = []
                callee_starts: mutable darray[usize] = []
                callee_counts: mutable darray[usize] = []
                callee_names: mutable darray[sview] = []
                exclusivity_collect_declared(file.top_decls, globals, function_names, starts, counts, params, returns_ref, fact_starts, fact_counts, fact_names, fact_write, callee_starts, callee_counts, callee_names)
                function_lookup: dict[u64, usize] = exclusivity_function_lookup(function_names) can Global{Read,Write}
                fns: ExclusivityFns = ExclusivityFns{names: function_names, lookup: function_lookup, starts: starts, counts: counts, params: params, returns_ref: returns_ref, fn_type_lines: file.fn_type_param_lines, fn_type_exprs: file.fn_type_param_exprs, globals: globals, fact_starts: fact_starts, fact_counts: fact_counts, fact_names: fact_names, fact_write: fact_write, callee_starts: callee_starts, callee_counts: callee_counts, callee_names: callee_names}
                table <- exclusivity_walk_declarations(file.top_decls, fns, table)
