# Stage1 semantic layer — the SymbolTable's HASH INDEX. Every lookup the collector performs is a
# name probe, so names, symbols, function parameters and module members each carry an FNV-1a
# index: a primary slot plus a chain of overflow entries. Continues symbols.elisa.

extend Semantic:
    private:
        const SEMANTIC_HASH_OFFSET: u64 = 14695981039346656037
        const SEMANTIC_HASH_PRIME: u64 = 1099511628211
        const SYMBOL_INDEX_ROW_NONE: u32 = 4294967295

        # FNV-1a hash of a name's bytes — the key into the SymbolTable name index. u64
        # multiplication wraps (unsigned), which is the intended hashing behavior.
        def name_hash(name: sview) -> u64:
            hash: u64 =
                for byte in name |hash: u64 = SEMANTIC_HASH_OFFSET| -> hash:
                    hash <- (hash ^ byte.u64()) * SEMANTIC_HASH_PRIME
            return hash

        # Composite hash for an exact binding identity. Callers still compare all original
        # fields after following the chain, so this is only an index, never identity evidence.
        def local_binding_exact_hash(name: sview, line: u32, offset: u32) -> u64:
            can Abort.Panic:
                return (((name_hash(name) ^ line.u64()) * SEMANTIC_HASH_PRIME) ^ offset.u64()) * SEMANTIC_HASH_PRIME

        # (name, line) key for the offset-free binding chains; an index only, like the above.
        def local_binding_line_hash(name: sview, line: u32) -> u64:
            can Abort.Panic:
                return (name_hash(name) ^ line.u64()) * SEMANTIC_HASH_PRIME

        def local_binding_line_head(table: SymbolTable&, hash: u64) -> u32:
            can Abort.Panic:
                return head if table.local_binding_line_heads.get(hash) is head else SYMBOL_INDEX_ROW_NONE

        def binding_annotation_line_head(table: SymbolTable&, hash: u64) -> u32:
            can Abort.Panic:
                return head if table.binding_annotation_line_heads.get(hash) is head else SYMBOL_INDEX_ROW_NONE

        def local_binding_exact_head(table: SymbolTable&, hash: u64) -> u32:
            can Abort.Panic:
                return head if table.local_binding_exact_heads.get(hash) is head else SYMBOL_INDEX_ROW_NONE

        def index_local_binding_exact(table: lmut SymbolTable, name: sview, line: u32, offset: u32, row: usize) -> void:
            can Memory.Allocate, Abort.Panic:
                hash: u64 = local_binding_exact_hash(name, line, offset)
                previous: u32 = local_binding_exact_head(table, hash)
                table.local_binding_exact_next <- table.local_binding_exact_next.push(previous)
                table.local_binding_exact_heads <- table.local_binding_exact_heads.put(hash, row.u32())
                line_hash: u64 = local_binding_line_hash(name, line)
                previous_line: u32 = local_binding_line_head(table, line_hash)
                table.local_binding_line_next <- table.local_binding_line_next.push(previous_line)
                table.local_binding_line_heads <- table.local_binding_line_heads.put(line_hash, row.u32())

        def binding_annotation_exact_head(table: SymbolTable&, hash: u64) -> u32:
            can Abort.Panic:
                return head if table.binding_annotation_exact_heads.get(hash) is head else SYMBOL_INDEX_ROW_NONE

        def index_binding_annotation_exact(table: lmut SymbolTable, annotation: Ast::EnumAnnotation, row: usize) -> void:
            can Memory.Allocate, Abort.Panic:
                hash: u64 = local_binding_exact_hash(annotation.owner, annotation.line, annotation.offset)
                previous: u32 = binding_annotation_exact_head(table, hash)
                table.binding_annotation_exact_next <- table.binding_annotation_exact_next.push(previous)
                table.binding_annotation_exact_heads <- table.binding_annotation_exact_heads.put(hash, row.u32())
                line_hash: u64 = local_binding_line_hash(annotation.owner, annotation.line)
                previous_line: u32 = binding_annotation_line_head(table, line_hash)
                table.binding_annotation_line_next <- table.binding_annotation_line_next.push(previous_line)
                table.binding_annotation_line_heads <- table.binding_annotation_line_heads.put(line_hash, row.u32())

        def struct_field_pair_hash(owner: sview, field_name: sview) -> u64:
            can Abort.Panic:
                return (name_hash(owner) * SEMANTIC_HASH_PRIME) ^ name_hash(field_name)

        def struct_field_pair_head(table: SymbolTable&, hash: u64) -> u32:
            can Abort.Panic:
                return head if table.struct_field_pair_heads.get(hash) is head else SYMBOL_INDEX_ROW_NONE

        def struct_field_pair_tail(table: SymbolTable&, hash: u64) -> u32:
            can Abort.Panic:
                return tail_row if table.struct_field_pair_tails.get(hash) is tail_row else SYMBOL_INDEX_ROW_NONE

        # Append ROW (about to be pushed onto struct_field_owner/name) to the chain of its
        # struct_field_pair_hash HASH.
        def index_struct_field(table: lmut SymbolTable, hash: u64, row: usize) -> void:
            can Memory.Allocate, Abort.Panic:
                table.struct_field_pair_next <- table.struct_field_pair_next.push(SYMBOL_INDEX_ROW_NONE)
                tail_row: u32 = struct_field_pair_tail(table, hash)
                if tail_row != SYMBOL_INDEX_ROW_NONE:
                    table.struct_field_pair_next[tail_row.usize()] <- row.u32()
                else:
                    table.struct_field_pair_heads <- table.struct_field_pair_heads.put(hash, row.u32())
                table.struct_field_pair_tails <- table.struct_field_pair_tails.put(hash, row.u32())

        def struct_field_owner_head(table: SymbolTable&, owner: sview) -> u32:
            can Abort.Panic:
                return head if table.struct_field_owner_heads.get(name_hash(owner)) is head else SYMBOL_INDEX_ROW_NONE

        # Append ROW (about to be pushed onto struct_field_owner) to its owner's chain, in
        # row order. Called once per struct_field_owner push, next to index_struct_field.
        def index_struct_field_owner(table: lmut SymbolTable, owner: sview, row: usize) -> void:
            can Memory.Allocate, Abort.Panic:
                hash: u64 = name_hash(owner)
                table.struct_field_owner_next <- table.struct_field_owner_next.push(SYMBOL_INDEX_ROW_NONE)
                if table.struct_field_owner_tails.get(hash) is tail_row:
                    table.struct_field_owner_next[tail_row.usize()] <- row.u32()
                else:
                    table.struct_field_owner_heads <- table.struct_field_owner_heads.put(hash, row.u32())
                table.struct_field_owner_tails <- table.struct_field_owner_tails.put(hash, row.u32())

        # Whether any struct_field_owner row names `owner` (an `any owner in
        # table.struct_field_owner where owner == name` over the owner chain).
        def struct_declares_fields(table: SymbolTable&, owner: sview) -> bool:
            can Abort.Panic:
                row: mutable u32 = struct_field_owner_head(table, owner)
                while row != SYMBOL_INDEX_ROW_NONE |row, table, owner|:
                    return true if table.struct_field_owner[row.usize()] == owner
                    row <- table.struct_field_owner_next[row.usize()]
                return false

        # Append ROW (about to be pushed onto const_int_names) to its name chain.
        def index_const_int_name(table: lmut SymbolTable, name: sview, row: usize) -> void:
            can Memory.Allocate, Abort.Panic:
                hash: u64 = name_hash(name)
                previous: mutable u32 = SYMBOL_INDEX_ROW_NONE
                if table.const_int_name_heads.get(hash) is head:
                    previous <- head
                table.const_int_name_next <- table.const_int_name_next.push(previous)
                table.const_int_name_heads <- table.const_int_name_heads.put(hash, row.u32())

        def lmut_param_head(table: SymbolTable&, hash: u64) -> u32:
            can Abort.Panic:
                return head if table.lmut_param_heads.get(hash) is head else SYMBOL_INDEX_ROW_NONE

        def lmut_param_tail(table: SymbolTable&, hash: u64) -> u32:
            can Abort.Panic:
                return tail_row if table.lmut_param_tails.get(hash) is tail_row else SYMBOL_INDEX_ROW_NONE

        # Append ROW (about to be pushed onto lmut_param_owner/pos) to the chain of its
        # owner's name_hash HASH.
        def index_lmut_param(table: lmut SymbolTable, hash: u64, row: usize) -> void:
            can Memory.Allocate, Abort.Panic:
                table.lmut_param_next <- table.lmut_param_next.push(SYMBOL_INDEX_ROW_NONE)
                tail_row: u32 = lmut_param_tail(table, hash)
                if tail_row != SYMBOL_INDEX_ROW_NONE:
                    table.lmut_param_next[tail_row.usize()] <- row.u32()
                else:
                    table.lmut_param_heads <- table.lmut_param_heads.put(hash, row.u32())
                table.lmut_param_tails <- table.lmut_param_tails.put(hash, row.u32())

        def binder_annotation_head(table: SymbolTable&, hash: u64) -> u32:
            can Abort.Panic:
                return head if table.binder_annotation_heads.get(hash) is head else SYMBOL_INDEX_ROW_NONE

        # Project the span-bearing loop/pattern binder rows out of `annotations` (the stream
        # assigned to `protocol_annotations`) and hash them by (name, line). Chains run newest
        # row first; source_binder_position restores stream order from the row numbers.
        def index_binder_annotations(table: lmut SymbolTable, annotations: darray[Ast::EnumAnnotation]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in annotations |table|:
                    if (annotation.owner == "__pattern_binder" or annotation.owner == "__for_binder") and annotation.pos.end_offset > annotation.pos.offset:
                        row: usize = table.binder_annotations.count
                        hash: u64 = local_binding_exact_hash(annotation.name, annotation.line, 0)
                        previous: u32 = binder_annotation_head(table, hash)
                        table.binder_annotation_next <- table.binder_annotation_next.push(previous)
                        table.binder_annotation_heads <- table.binder_annotation_heads.put(hash, row.u32())
                        table.binder_annotations <- table.binder_annotations.push(annotation)
                table.binder_annotations_indexed <- true




        # Whether `name` is already in the table's name index — O(1) expected (one hash probe
        # plus a scan of the tiny collision overflow), replacing an O(n) scan of `symbols`.
        def name_indexed(table: SymbolTable&, name: sview) -> bool:
            can Abort.Panic:
                true return if table.name_primary.get(name_hash(name)) is primary and primary == name
                # Primary slot empty or holding a different name (a hash collision) — the
                # queried name, if present, is in the overflow list. Must run in BOTH cases,
                # so this is deliberately outside the `if` (no `else`).
                return any overflow_name in table.name_overflow where overflow_name == name




        # Whether a name is already stored at hash `hash` in the primary slot. Read through a
        # const `table` so `dict.get` yields a const (not mutable) interior ref — a mutable
        # `.get` would surface an Unsafe.PointerCast the safe read does not need.
        def hash_occupied(table: SymbolTable&, hash: u64) -> bool:
            can Abort.Panic:
                return true if table.name_primary.get(hash) is occupant else false


                    
        # Record `name` in the index (idempotent). The first name at a given hash lands in
        # `name_primary`; a colliding different name goes to `name_overflow`.
        def index_name(table: lmut SymbolTable, name: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                return if name_indexed(table, name)
                hash: u64 = name_hash(name)
                # `name` is known-absent (guard above), so an occupied slot here is a different
                # name sharing the hash — a collision that goes to the overflow list.
                table.name_overflow <- table.name_overflow.push(name) if hash_occupied(table, hash)
                table.name_primary <- table.name_primary.put(hash, name) if not hash_occupied(table, hash)




        # The index of the FIRST function_param_owner entry whose owner hashes to `name`'s
        # hash, else SYMBOL_INDEX_ROW_NONE ("no such chain"). A reader walks forward via
        # function_param_name_next from this starting point, checking the owner name at each
        # step (a hash COLLISION between two different names is possible in principle, so
        # every step still compares the real name — this index narrows the candidate set, it
        # does not skip the check). See the SymbolTable field comment for the chain shape.
        def function_param_chain_head(table: SymbolTable&, name: sview) -> u32:
            can Abort.Panic:
                return head if table.function_param_name_head.get(name_hash(name)) is head else SYMBOL_INDEX_ROW_NONE




        # The recorded tail index for `hash`, else SYMBOL_INDEX_ROW_NONE. Read through a
        # const `table` (mirrors hash_occupied's note above it) so `dict.get` yields a const
        # interior ref — a mutable `.get` (calling this straight from `lmut` table) surfaces
        # an avoidable Unsafe.PointerCast warning.
        def function_param_tail_at(table: SymbolTable&, hash: u64) -> u32:
            can Abort.Panic:
                return tail_row if table.function_param_name_tail.get(hash) is tail_row else SYMBOL_INDEX_ROW_NONE




        # Append function_param_owner[index] (whose owner is `name`) onto its hash chain —
        # O(1): extend the same hash's existing chain by one link, or start a new one. Must be
        # called exactly once per function_param_owner push, in push order (collect_range's
        # per-parameter loop), so the chain visits a function's parameters in declaration
        # order and multiple overloads/declarations of the same name concatenate in the order
        # they were declared — matching what the O(n) scans this replaces used to visit.
        def index_function_param(table: lmut SymbolTable, name: sview, index: usize) -> void:
            can Memory.Allocate, Abort.Panic:
                table.function_param_name_next <- table.function_param_name_next.push(SYMBOL_INDEX_ROW_NONE)
                hash: u64 = name_hash(name)
                tail_row: u32 = function_param_tail_at(table, hash)
                if tail_row != SYMBOL_INDEX_ROW_NONE:
                    table.function_param_name_next[tail_row.usize()] <- index.u32()
                else:
                    table.function_param_name_head <- table.function_param_name_head.put(hash, index.u32())
                table.function_param_name_tail <- table.function_param_name_tail.put(hash, index.u32())




        # The `symbols` analogue of function_param_chain_head above — the index of the FIRST
        # `symbols` row whose name hashes to `name`'s hash, else SYMBOL_INDEX_ROW_NONE. See that
        # function's comment for the hash-collision handling (every reader still compares the
        # real name at each step).
        def symbol_chain_head(table: SymbolTable&, name: sview) -> u32:
            can Abort.Panic:
                return head if table.symbol_name_head.get(name_hash(name)) is head else SYMBOL_INDEX_ROW_NONE




        # The `symbols` analogue of function_param_tail_at above.
        def symbol_tail_at(table: SymbolTable&, hash: u64) -> u32:
            can Abort.Panic:
                return tail_row if table.symbol_name_tail.get(hash) is tail_row else SYMBOL_INDEX_ROW_NONE




        # The `symbols` analogue of index_function_param above — append symbols[index] (whose
        # name is `name`) onto its hash chain. Must be called exactly once per `symbols` push,
        # in push order, so the chain visits same-named declarations (overloads) in the order
        # they were declared, matching what the O(n) scans this replaces used to visit.
        def index_symbol(table: lmut SymbolTable, name: sview, index: usize) -> void:
            can Memory.Allocate, Abort.Panic:
                table.symbol_name_next <- table.symbol_name_next.push(SYMBOL_INDEX_ROW_NONE)
                hash: u64 = name_hash(name)
                tail_row: u32 = symbol_tail_at(table, hash)
                if tail_row != SYMBOL_INDEX_ROW_NONE:
                    table.symbol_name_next[tail_row.usize()] <- index.u32()
                else:
                    table.symbol_name_head <- table.symbol_name_head.put(hash, index.u32())
                table.symbol_name_tail <- table.symbol_name_tail.put(hash, index.u32())




        # The module_member analogues of the three functions above, same shape, same
        # push-order contract. name_known walks these instead of every member row.
        def member_chain_head(table: SymbolTable&, name: sview) -> u32:
            can Abort.Panic:
                return head if table.member_name_head.get(name_hash(name)) is head else SYMBOL_INDEX_ROW_NONE




        def member_tail_at(table: SymbolTable&, hash: u64) -> u32:
            can Abort.Panic:
                return tail_row if table.member_name_tail.get(hash) is tail_row else SYMBOL_INDEX_ROW_NONE




        def index_member(table: lmut SymbolTable, name: sview, index: usize) -> void:
            can Memory.Allocate, Abort.Panic:
                table.member_name_next <- table.member_name_next.push(SYMBOL_INDEX_ROW_NONE)
                hash: u64 = name_hash(name)
                tail_row: u32 = member_tail_at(table, hash)
                if tail_row != SYMBOL_INDEX_ROW_NONE:
                    table.member_name_next[tail_row.usize()] <- index.u32()
                else:
                    table.member_name_head <- table.member_name_head.put(hash, index.u32())
                table.member_name_tail <- table.member_name_tail.put(hash, index.u32())
