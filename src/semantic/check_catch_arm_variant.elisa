# Catch arm naming no declared error variant. A catch arm `Family.Variant` (optionally
# module-qualified, `Module::Family.Variant`) must name a variant some `error`/`enum`
# declaration actually has -- in that module when one is written. Otherwise the arm can
# never match: stage1's backend used to decline the whole unit with the opaque
# "backend could not produce a linkable unit ... (control expression)" (stage0 compiled
# the arm as dead code). A stale family name after a rename (`GlbDocument::GlbError.X`
# once the family became `GlbDocumentError`) is the usual cause, so it is reported here,
# at the catch, as an arm outside the caught call's error set.
extend Semantic:
    private:
        # source[start..end) equals candidate, byte for byte.
        def cav_range_equals(source: sview, start: usize, end: usize, candidate: sview) -> bool:
            can Abort.Panic:
                return false if end < start or end - start != candidate.len
                for offset in 0..<candidate.len |source, candidate, start|:
                    return false if source[start + offset] != candidate[offset]
                return true

        # Stage0 normalizes `::` to `.` in the arm name, then MatchErrorTag compares the
        # suffix after the first dot. Compare that suffix with the candidate tag's suffix
        # without allocating a normalized string.
        def cav_path_matches_tag_short(path: sview, family: sview, variant: sview, module: sview) -> bool:
            can Abort.Panic:
                short_start: mutable usize = path.len
                for index in 0..<path.len |short_start, path|:
                    if path[index] == 58 and index + 1.usize() < path.len and path[index + 1.usize()] == 58:
                        short_start <- index + 2.usize()
                        break
                    if path[index] == 46:
                        short_start <- index + 1.usize()
                        break
                cursor: mutable usize = short_start
                if module == "":
                    return cav_range_equals(path, cursor, path.len, variant)
                module_separator: mutable usize = module.len
                for index in 0..<module.len |module_separator, module|:
                    if module[index] == 58 and index + 1.usize() < module.len and module[index + 1.usize()] == 58:
                        module_separator <- index
                        break
                if module_separator < module.len:
                    module_tail: sview = module[module_separator + 2.usize():module.len]
                    return false if path.len - cursor < module_tail.len + 2.usize()
                    for index in 0..<module_tail.len |path, module_tail, cursor|:
                        return false if path[cursor + index] != module_tail[index]
                    cursor <- cursor + module_tail.len
                    return false if path[cursor] != 58 or path[cursor + 1.usize()] != 58
                    cursor <- cursor + 2.usize()
                return false if path.len - cursor < family.len + 1.usize() + variant.len
                for index in 0..<family.len |path, family, cursor|:
                    return false if path[cursor + index] != family[index]
                cursor <- cursor + family.len
                return false if path[cursor] != 46
                cursor <- cursor + 1.usize()
                return cav_range_equals(path, cursor, path.len, variant)

        # Whether `path` names a declared variant. Paths without a `.` (bare variants) and the
        # `error` pseudo-family are left to the other catch checks.
        def cav_path_is_known(path: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                length: usize = path.len
                dot: mutable usize = length
                for probe in 0..<length |dot, path|:
                    dot <- probe if path[probe] == 46
                return true if dot == length or dot == 0
                family_start: mutable usize = 0
                for probe in 0..<dot |family_start, path|:
                    family_start <- probe + 1 if path[probe] == 58 or path[probe] == 46
                return true if:
                    family_start == dot
                    cav_range_equals(path, family_start, dot, "error")
                qualified: bool = family_start >= 2 and path[family_start - 1] == 58 and path[family_start - 2] == 58
                module_end: usize = family_start - 2 if qualified else 0
                index: mutable usize = 0
                matching_tag_count: mutable usize = 0.usize()
                exact_module_match: mutable bool = false
                while index < table.enum_variant_owner.count |index, matching_tag_count, exact_module_match, table, path, family_start, dot, length, qualified, module_end|:
                    variant_ok: bool = cav_range_equals(path, dot + 1, length, table.enum_variant_name[index])
                    owner_ok: bool = cav_range_equals(path, family_start, dot, table.enum_variant_owner[index])
                    family_variant_ok: bool = owner_ok and variant_ok
                    if family_variant_ok:
                        candidate_module: sview = table.enum_variant_module[index] if index < table.enum_variant_module.count else ""
                        matching_tag_count <- matching_tag_count + 1.usize() if cav_path_matches_tag_short(path, table.enum_variant_owner[index], table.enum_variant_name[index], candidate_module)
                        # Keep the whole path prefix. For Parent::Child::Fault.Bad, the family
                        # begins after the last `::`, but the enum owner is Parent::Child; taking
                        # only the last prefix segment (Child) rejects a valid nested-module arm.
                        exact_module_match <- true if qualified and index < table.enum_variant_module.count and cav_range_equals(path, 0, module_end, table.enum_variant_module[index])
                    index <- index + 1
                # Stage0 falls back to the suffix after its first normalized dot. A wrong
                # module prefix can therefore match the same Family.Variant suffix, while a
                # different family segment cannot. This check only confirms that the spelling
                # exists somewhere; ambiguity is specific to the caught union and belongs to
                # the Catch checker.
                return true if exact_module_match
                return true if matching_tag_count > 0.usize()
                return false

        def cav_check_arm(pattern: Ast::Pattern, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Ast::Pattern.Variant(path, fields):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CatchArmOutOfSet, name: path, line: line, expected: "", actual: ""}) if not cav_path_is_known(path, table)
                    Ast::Pattern.Or(options) | Ast::Pattern.As(_, options):
                        for option in options |table|:
                            table <- cav_check_arm(option, line, table)
                    _:
                        pass

        # Walk all statements in a function body, checking catch arms.
        def cav_walk_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- cav_walk_expression(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- cav_walk_expression(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- cav_walk_expression(target, table)
                            table <- cav_walk_expression(value, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- cav_walk_expression(condition, table)
                            table <- cav_walk_statements(then_body, table)
                            table <- cav_walk_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- cav_walk_expression(condition, table)
                            table <- cav_walk_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- cav_walk_expression(iterable, table)
                            table <- cav_walk_statements(body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- cav_walk_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- cav_walk_expression(scrutinee, table)
                            is_catch: bool = any catch_line in table.catch_match_lines where catch_line == line.line
                            for arm in arms |table|:
                                table <- cav_check_arm(arm.pattern, line.line, table) if is_catch
                                table <- cav_walk_expression(arm.guard, table)
                                table <- cav_walk_statements(arm.body, table)
                        Stmt.Return(value, line):
                            table <- cav_walk_expression(return_value, table) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- cav_walk_expression(expression, table)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Walk all expressions, checking the arms of every catch.
        def cav_walk_expression(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Invalid:
                        pass
                    Expr.Absent:
                        pass
                        pass
                    Expr.IntLit(value, _):
                        pass
                    Expr.FloatLit(text, _):
                        pass
                    Expr.StringLit(text, _):
                        pass
                    Expr.CharLit(text, _):
                        pass
                    Expr.BoolLit(value, _):
                        pass
                    Expr.Ident(name, line):
                        pass
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        for child in Ast::effect_runtime_children(candidates, arguments) |table|:
                            table <- cav_walk_expression(child, table)
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- cav_walk_expression(callee, table)
                        for argument in arguments |table|:
                            table <- cav_walk_expression(argument, table)
                    Expr.Field(object, field, line):
                        table <- cav_walk_expression(object, table)
                    Expr.Scope(base, name, line):
                        table <- cav_walk_expression(base, table)
                    Expr.ShorthandMember(parts, line):
                        pass
                    Expr.Index(object, index, line):
                        table <- cav_walk_expression(object, table)
                        table <- cav_walk_expression(index, table)
                    Expr.Slice(object, low, high, line):
                        table <- cav_walk_expression(object, table)
                        table <- cav_walk_expression(low, table)
                        table <- cav_walk_expression(high, table)
                    Expr.IndexN(object, arguments, line):
                        table <- cav_walk_expression(object, table)
                        for argument in arguments |table|:
                            table <- cav_walk_expression(argument, table)
                    Expr.Binary(left, operator, right, line):
                        table <- cav_walk_expression(left, table)
                        table <- cav_walk_expression(right, table)
                    Expr.Unary(operator, operand, line):
                        table <- cav_walk_expression(operand, table)
                    Expr.Move(operand, line):
                        table <- cav_walk_expression(operand, table)
                    Expr.RegionNew(operand, region, line):
                        table <- cav_walk_expression(operand, table)
                    Expr.Refinement(base, predicate, line):
                        table <- cav_walk_expression(base, table)
                        table <- cav_walk_expression(predicate, table)
                    # `get EXPR else return …` — walk the GUARDED expression; the recovery is a
                    # statement list, which this expression walker does not descend into.
                    Expr.GetElse(guarded, recovery, line):
                        table <- cav_walk_expression(guarded, table)
                    Expr.Paren(inner, line):
                        table <- cav_walk_expression(inner, table)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- cav_walk_expression(element, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- cav_walk_expression(element, table)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- cav_walk_expression(element, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- cav_walk_expression(entry.key, table)
                            table <- cav_walk_expression(entry.value, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- cav_walk_expression(type_expression, table)
                        for field in fields |table|:
                            table <- cav_walk_expression(field.value, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- cav_walk_expression(base, table)
                        for field in fields |table|:
                            table <- cav_walk_expression(field.value, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- cav_walk_expression(condition, table)
                        table <- cav_walk_expression(then_expr, table)
                        table <- cav_walk_expression(else_expr, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- cav_walk_expression(scrutinee, table)
                        for arm in arms |table|:
                            table <- cav_walk_expression(arm.guard, table)
                            table <- cav_walk_statements(arm.body, table)
                    # `catch EXPR:` — positionally identical to Match (guarded, arms, line);
                    # the guarded call is the scrutinee and the arms walk the same way.
                    Expr.Catch(scrutinee, arms, line):
                        table <- cav_walk_expression(scrutinee, table)
                        for arm in arms |table|:
                            table <- cav_check_arm(arm.pattern, line.line, table)
                            table <- cav_walk_expression(arm.guard, table)
                            table <- cav_walk_statements(arm.body, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line, _):
                        table <- cav_walk_expression(iterable, table)
                        table <- cav_walk_expression(condition, table)
                        table <- cav_walk_expression(body, table)
                    Expr.Lambda(parameters, body, line):
                        table <- cav_walk_statements(body, table)
                    Expr.Block(statements, value, captures, line):
                        table <- cav_walk_statements(statements, table)
                        table <- cav_walk_expression(value, table)


        def cav_walk_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- cav_walk_statements(body, table)
                        Decl.Module(name, body, line):
                            table <- cav_walk_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- cav_walk_declarations(body, table)
                        _:
                            pass


    public:
        def check_catch_arm_variant(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- cav_walk_declarations(declarations, table)
