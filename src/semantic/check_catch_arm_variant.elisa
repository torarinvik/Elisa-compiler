# Catch arm naming no declared error variant. A catch arm `Family.Variant` (optionally
# module-qualified, `Module::Family.Variant`) must name a variant some `error`/`enum`
# declaration actually has -- in that module when one is written. Otherwise the arm can
# never match: stage1's backend used to decline the whole unit with the opaque
# "backend could not produce a linkable unit ... (control expression)" (stage0 compiled
# the arm as dead code). A stale family name after a rename (`GlbDocument::GlbError.X`
# once the family became `GlbDocumentError`) is the usual cause, so it is reported here,
# at the catch, as an arm outside the caught call's error set.
extend Semantic:
    private:
        # source[start..end) equals candidate, byte for byte.
        def cav_range_equals(source: sview, start: usize, end: usize, candidate: sview) -> bool:
            can Abort.Panic:
                return false if end < start or end - start != candidate.len
                for offset in 0..<candidate.len |source, candidate, start|:
                    return false if source[start + offset] != candidate[offset]
                return true

        # Stage0 normalizes `::` to `.` in the arm name, then MatchErrorTag compares the
        # suffix after the first dot. Compare that suffix with the candidate tag's suffix
        # without allocating a normalized string.
        def cav_path_matches_tag_short(path: sview, family: sview, variant: sview, module: sview) -> bool:
            can Abort.Panic:
                short_start: mutable usize = path.len
                for index in 0..<path.len |short_start, path|:
                    if path[index] == 58 and index + 1.usize() < path.len and path[index + 1.usize()] == 58:
                        short_start <- index + 2.usize()
                        break
                    if path[index] == 46:
                        short_start <- index + 1.usize()
                        break
                cursor: mutable usize = short_start
                if module == "":
                    return cav_range_equals(path, cursor, path.len, variant)
                module_separator: mutable usize = module.len
                for index in 0..<module.len |module_separator, module|:
                    if module[index] == 58 and index + 1.usize() < module.len and module[index + 1.usize()] == 58:
                        module_separator <- index
                        break
                if module_separator < module.len:
                    module_tail: sview = module[module_separator + 2.usize():module.len]
                    return false if path.len - cursor < module_tail.len + 2.usize()
                    for index in 0..<module_tail.len |path, module_tail, cursor|:
                        return false if path[cursor + index] != module_tail[index]
                    cursor <- cursor + module_tail.len
                    return false if path[cursor] != 58 or path[cursor + 1.usize()] != 58
                    cursor <- cursor + 2.usize()
                return false if path.len - cursor < family.len + 1.usize() + variant.len
                for index in 0..<family.len |path, family, cursor|:
                    return false if path[cursor + index] != family[index]
                cursor <- cursor + family.len
                return false if path[cursor] != 46
                cursor <- cursor + 1.usize()
                return cav_range_equals(path, cursor, path.len, variant)

        # Whether `path` names a declared variant. Paths without a `.` (bare variants) and the
        # `error` pseudo-family are left to the other catch checks.
        def cav_path_is_known(path: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                length: usize = path.len
                dot: mutable usize = length
                for probe in 0..<length |dot, path|:
                    dot <- probe if path[probe] == 46
                return true if dot == length or dot == 0
                family_start: mutable usize = 0
                for probe in 0..<dot |family_start, path|:
                    family_start <- probe + 1 if path[probe] == 58 or path[probe] == 46
                return true if:
                    family_start == dot
                    cav_range_equals(path, family_start, dot, "error")
                qualified: bool = family_start >= 2 and path[family_start - 1] == 58 and path[family_start - 2] == 58
                module_end: usize = family_start - 2 if qualified else 0
                index: mutable usize = 0
                matching_tag_count: mutable usize = 0.usize()
                exact_module_match: mutable bool = false
                while index < table.enum_variant_owner.count |index, matching_tag_count, exact_module_match, table, path, family_start, dot, length, qualified, module_end|:
                    variant_ok: bool = cav_range_equals(path, dot + 1, length, table.enum_variant_name[index])
                    owner_ok: bool = cav_range_equals(path, family_start, dot, table.enum_variant_owner[index])
                    family_variant_ok: bool = owner_ok and variant_ok
                    if family_variant_ok:
                        candidate_module: sview = table.enum_variant_module[index] if index < table.enum_variant_module.count else ""
                        matching_tag_count <- matching_tag_count + 1.usize() if cav_path_matches_tag_short(path, table.enum_variant_owner[index], table.enum_variant_name[index], candidate_module)
                        # Keep the whole path prefix. For Parent::Child::Fault.Bad, the family
                        # begins after the last `::`, but the enum owner is Parent::Child; taking
                        # only the last prefix segment (Child) rejects a valid nested-module arm.
                        exact_module_match <- true if qualified and index < table.enum_variant_module.count and cav_range_equals(path, 0, module_end, table.enum_variant_module[index])
                    index <- index + 1
                # Stage0 falls back to the suffix after its first normalized dot. A wrong
                # module prefix can therefore match the same Family.Variant suffix, while a
                # different family segment cannot. This check only confirms that the spelling
                # exists somewhere; ambiguity is specific to the caught union and belongs to
                # the Catch checker.
                return true if exact_module_match
                return true if matching_tag_count > 0.usize()
                return false

        def cav_check_arm(pattern: Ast::Pattern, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Ast::Pattern.Variant(path, fields):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CatchArmOutOfSet, name: path, line: line, expected: "", actual: ""}) if not cav_path_is_known(path, table)
                    Ast::Pattern.Or(options) | Ast::Pattern.As(_, options):
                        for option in options |table|:
                            table <- cav_check_arm(option, line, table)
                    _:
                        pass

        # Static-if branches remain in the parser AST. Use the exact branch-head
        # position and shared evaluator; unresolved branches stay visible to this pass.
        def cav_static_if_branch_selection(file: Ast::File&, line: u32, offset: u32, lexical_module: sview, table: SymbolTable&) -> (known: bool, selected: bool):
            can Abort.Panic:
                found_row: mutable usize = file.static_if_lines.count
                found_count: mutable usize = 0.usize()
                paired: usize = file.static_if_lines.count if file.static_if_lines.count < file.static_if_offsets.count else file.static_if_offsets.count
                for row in 0..<paired |found_row, found_count, file, line, offset|:
                    continue if file.static_if_lines[row] != line or file.static_if_offsets[row] != offset
                    found_row <- row
                    found_count <- found_count + 1.usize()
                return (false, false) if found_count > 1.usize()
                return ewr_static_if_row_selection(file, found_row, lexical_module, table) if found_count == 1.usize()
                return (true, true)

        # Walk all statements in a function body, checking catch arms.
        def cav_walk_statements(lexical_module: sview, statements: darray[Ast::Stmt], file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, file|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- cav_walk_expression(lexical_module, expression, file, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- cav_walk_expression(lexical_module, value, file, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- cav_walk_expression(lexical_module, target, file, table)
                            table <- cav_walk_expression(lexical_module, value, file, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- cav_walk_expression(lexical_module, condition, file, table)
                            table <- cav_walk_statements(lexical_module, then_body, file, table)
                            table <- cav_walk_statements(lexical_module, else_body, file, table)
                        Stmt.While(condition, body, line):
                            table <- cav_walk_expression(lexical_module, condition, file, table)
                            table <- cav_walk_statements(lexical_module, body, file, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- cav_walk_expression(lexical_module, iterable, file, table)
                            table <- cav_walk_statements(lexical_module, body, file, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            branch: (known: bool, selected: bool) = cav_static_if_branch_selection(file, line.line, line.offset, lexical_module, table)
                            table <- cav_walk_statements(lexical_module, body, file, table) if not branch.known or branch.selected
                        Stmt.Match(scrutinee, arms, line):
                            table <- cav_walk_expression(lexical_module, scrutinee, file, table)
                            catch_markers: darray[Ast::EnumAnnotation] = table.scoped_catch_annotations if table.scoped_catch_annotations_active else table.protocol_annotations
                            is_catch: bool = any marker in catch_markers where marker.line == line.line and marker.offset == line.offset and marker.owner == "__catch_match" and marker.name == "__catch_match" and marker.module == lexical_module
                            for arm in arms |table, file|:
                                table <- cav_check_arm(arm.pattern, line.line, table) if is_catch
                                table <- cav_walk_expression(lexical_module, arm.guard, file, table)
                                table <- cav_walk_statements(lexical_module, arm.body, file, table)
                        Stmt.Return(value, line):
                            table <- cav_walk_expression(lexical_module, return_value, file, table) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- cav_walk_expression(lexical_module, expression, file, table)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Walk all expressions, checking the arms of every catch.
        def cav_walk_expression(lexical_module: sview, expression: Ast::Expr, file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Invalid:
                        pass
                    Expr.Absent:
                        pass
                        pass
                    Expr.IntLit(value, _):
                        pass
                    Expr.FloatLit(text, _):
                        pass
                    Expr.StringLit(text, _):
                        pass
                    Expr.CharLit(text, _):
                        pass
                    Expr.BoolLit(value, _):
                        pass
                    Expr.Ident(name, line):
                        pass
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        for child in Ast::effect_runtime_children(candidates, arguments) |table, file|:
                            table <- cav_walk_expression(lexical_module, child, file, table)
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- cav_walk_expression(lexical_module, callee, file, table)
                        for argument in arguments |table, file|:
                            table <- cav_walk_expression(lexical_module, argument, file, table)
                    Expr.Field(object, field, line):
                        table <- cav_walk_expression(lexical_module, object, file, table)
                    Expr.Scope(base, name, line):
                        table <- cav_walk_expression(lexical_module, base, file, table)
                    Expr.ShorthandMember(parts, line):
                        pass
                    Expr.Index(object, index, line):
                        table <- cav_walk_expression(lexical_module, object, file, table)
                        table <- cav_walk_expression(lexical_module, index, file, table)
                    Expr.Slice(object, low, high, line):
                        table <- cav_walk_expression(lexical_module, object, file, table)
                        table <- cav_walk_expression(lexical_module, low, file, table)
                        table <- cav_walk_expression(lexical_module, high, file, table)
                    Expr.IndexN(object, arguments, line):
                        table <- cav_walk_expression(lexical_module, object, file, table)
                        for argument in arguments |table, file|:
                            table <- cav_walk_expression(lexical_module, argument, file, table)
                    Expr.Binary(left, operator, right, line):
                        table <- cav_walk_expression(lexical_module, left, file, table)
                        table <- cav_walk_expression(lexical_module, right, file, table)
                    Expr.Unary(operator, operand, line):
                        table <- cav_walk_expression(lexical_module, operand, file, table)
                    Expr.Move(operand, line):
                        table <- cav_walk_expression(lexical_module, operand, file, table)
                    Expr.RegionNew(operand, region, line):
                        table <- cav_walk_expression(lexical_module, operand, file, table)
                    Expr.Refinement(base, predicate, line):
                        table <- cav_walk_expression(lexical_module, base, file, table)
                        table <- cav_walk_expression(lexical_module, predicate, file, table)
                    # `get EXPR else return …` — walk the GUARDED expression; the recovery is a
                    # statement list, which this expression walker does not descend into.
                    Expr.GetElse(guarded, recovery, line):
                        table <- cav_walk_expression(lexical_module, guarded, file, table)
                    Expr.Paren(inner, line):
                        table <- cav_walk_expression(lexical_module, inner, file, table)
                    Expr.Array(elements, line):
                        for element in elements |table, file|:
                            table <- cav_walk_expression(lexical_module, element, file, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table, file|:
                            table <- cav_walk_expression(lexical_module, element, file, table)
                    Expr.SetLit(elements, line):
                        for element in elements |table, file|:
                            table <- cav_walk_expression(lexical_module, element, file, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table, file|:
                            table <- cav_walk_expression(lexical_module, entry.key, file, table)
                            table <- cav_walk_expression(lexical_module, entry.value, file, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- cav_walk_expression(lexical_module, type_expression, file, table)
                        for field in fields |table, file|:
                            table <- cav_walk_expression(lexical_module, field.value, file, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- cav_walk_expression(lexical_module, base, file, table)
                        for field in fields |table, file|:
                            table <- cav_walk_expression(lexical_module, field.value, file, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- cav_walk_expression(lexical_module, condition, file, table)
                        table <- cav_walk_expression(lexical_module, then_expr, file, table)
                        table <- cav_walk_expression(lexical_module, else_expr, file, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- cav_walk_expression(lexical_module, scrutinee, file, table)
                        for arm in arms |table, file|:
                            table <- cav_walk_expression(lexical_module, arm.guard, file, table)
                            table <- cav_walk_statements(lexical_module, arm.body, file, table)
                    # `catch EXPR:` — positionally identical to Match (guarded, arms, line);
                    # the guarded call is the scrutinee and the arms walk the same way.
                    Expr.Catch(scrutinee, arms, line):
                        table <- cav_walk_expression(lexical_module, scrutinee, file, table)
                        for arm in arms |table, file|:
                            table <- cav_check_arm(arm.pattern, line.line, table)
                            table <- cav_walk_expression(lexical_module, arm.guard, file, table)
                            table <- cav_walk_statements(lexical_module, arm.body, file, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line, _):
                        table <- cav_walk_expression(lexical_module, iterable, file, table)
                        table <- cav_walk_expression(lexical_module, condition, file, table)
                        table <- cav_walk_expression(lexical_module, body, file, table)
                    Expr.Lambda(parameters, body, line):
                        table <- cav_walk_statements(lexical_module, body, file, table)
                    Expr.Block(statements, value, captures, line):
                        table <- cav_walk_statements(lexical_module, statements, file, table)
                        table <- cav_walk_expression(lexical_module, value, file, table)


        def cav_walk_declarations(lexical_module: sview, declarations: darray[Ast::Decl], file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table, file|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- cav_walk_statements(lexical_module, body, file, table)
                        Decl.Module(name, body, line):
                            table <- cav_walk_declarations(name, body, file, table)
                        Decl.Scoped(body, line):
                            branch: (known: bool, selected: bool) = cav_static_if_branch_selection(file, line.line, line.offset, lexical_module, table)
                            table <- cav_walk_declarations(lexical_module, body, file, table) if not branch.known or branch.selected
                        _:
                            pass


    public:
        def check_catch_arm_variant(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- cav_walk_declarations("", file.top_decls, file, table)
