# Stage1 semantic layer — MATCH EXHAUSTIVENESS. A match provably covers its scrutinee when the
# arms name every variant of a flat enum, or every variant of every child in a sealed hierarchy
# subtree. Mirrors stage0's rules, including the category arms that cover a leaf's owner.
# Continues resolve_flow.elisa.

extend Semantic:
    private:


        # Whether `arms` provably covers every value the scrutinee can take, mirroring
        # stage0's codegen-level exhaustiveness test (docs/122): an unguarded catch-all
        # (`_`/bare binding, or an all-wildcard tuple row) makes any match total; failing
        # that, an enum/hierarchy match is total only when every variant is individually
        # named across the (unguarded) arms. SOUND SUBSET, same philosophy as
        # `check_match_exhaustive`: any arm that is not a pure variant/or-of-variants cover
        # (a literal, struct, range, …) makes the whole match unprovable, so it's treated
        # as non-exhaustive — never a false claim of totality. Stage0 never treats literal
        # coverage (e.g. both `true:`/`false:` of a bool, or every value of a small int) as
        # exhaustive, so this deliberately does not attempt that either.
        def match_arms_exhaustive(arms: darray[Ast::MatchArm], table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                true return if match_has_catch_all(arms)
                # A struct scrutinee has exactly one shape, so an unguarded struct-destructure
                # arm (`Row{...}:`) is irrefutable — stage0's emitStructMatch treats it as
                # exhaustive with no `_` arm needed (oracle: TestAnalyzeBraceStructErgonomics).
                true return if any arm in arms where match_arm_is_unguarded_struct(arm)
                covered: mutable darray[sview] = []
                # docs/77 §2 CATEGORY ARMS, kept beside the variant paths rather than
                # expanded into them: `InputEvent input:` covers that category's whole
                # leaf subtree, and naming the leaves would mean synthesizing
                # `Owner.Variant` strings with nowhere stable to store them.
                categories: mutable darray[sview] = []
                for arm in arms:
                    guarded: bool = match arm.guard:
                        Expr.Invalid: false
                        Expr.Absent:  false
                        _:            true
                    continue if guarded
                    if arm.pattern is Pattern.TypeBind(category_type, category_binder):
                        # Only a hierarchy member is a category. Anything else here (`error e:`
                        # in a catch, a bind against a plain type) is not a cover, and saying
                        # so keeps this from ever claiming a totality it cannot prove.
                        false return if not enum_is_hierarchy_member(category_type, table)
                        categories.push(category_type)
                        continue
                    false return if not collect_arm_variant_paths(arm.pattern, covered)
                false return if covered.count == 0 and categories.count == 0
                anchor_owner: sview = enum_owner_of_path(covered[0], table) if covered.count > 0 else categories[0]
                false return if anchor_owner == ""
                # Judge the arms against their own LEAST UPPER BOUND in the hierarchy, not
                # blindly against the first arm's PARENT. A match on a mid-tier category
                # (`match c:` over a `Control` refined by `Button`) names Control and Button;
                # jumping to Control's parent demanded coverage of every OTHER branch of the
                # tree, so a genuinely exhaustive function read as falling through and was
                # reported "must return a value". The compiler's own AST never exposed this:
                # every Ast refinement is a DIRECT child of Node, where the parent hop and
                # the least upper bound are the same node.
                anchor_node: sview = covering_hierarchy_node(anchor_owner, covered, categories, table)
                if enum_is_hierarchy_member(anchor_node, table):
                    return hierarchy_subtree_all_covered(anchor_node, covered, categories, table)
                return flat_enum_variants_all_covered(anchor_node, covered, table)




        # The lowest hierarchy node whose subtree contains every enum the arms name. Walks
        # the anchor up until each arm's owner is the anchor itself or one of its
        # descendants. A flat enum has no edges, so the anchor returns unchanged.
        def covering_hierarchy_node(start: sview, covered: darray[sview]&, categories: darray[sview]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                anchor: mutable sview = start
                # A category arm names a NODE, not a leaf, so it widens the anchor the same
                # way a variant path does: `match e:` with only `InputEvent i:` and
                # `Event.Quit:` has to settle on Event, not on InputEvent.
                owners: mutable darray[sview] = []
                for path in covered |owners, table|:
                    owners.push(enum_owner_of_path(path, table))
                owners.extend(categories)
                for owner in owners |anchor|:
                    continue if owner == ""
                    steps: mutable usize = 0
                    while steps < table.enum_hierarchy_child.count |anchor, steps|:
                        break if owner == anchor or enum_in_hierarchy(owner, anchor, table)
                        parent: sview = enum_hierarchy_root_of(anchor, table)
                        break if parent == ""
                        anchor <- parent
                        steps <- steps + 1
                return anchor




        # Whether `enum_name` participates in a sealed hierarchy at all — it refines another
        # enum, or something refines it.
        def enum_is_hierarchy_member(enum_name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                false return if enum_name == ""
                for edge_index in 0..<table.enum_hierarchy_child.count:
                    true return if table.enum_hierarchy_child[edge_index] == enum_name
                    true return if table.enum_hierarchy_parent[edge_index] == enum_name
                return false




        # Every variant of `node` AND of all its refinements is named among `covered`
        # (leaves flow up, docs/77 §1) — exactly the case-set a match on `node` must cover.
        def hierarchy_subtree_all_covered(node: sview, covered: darray[sview]&, categories: darray[sview]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for variant_index in 0..<table.enum_variant_owner.count:
                    owner: sview = table.enum_variant_owner[variant_index]
                    if owner == node or enum_in_hierarchy(owner, node, table):
                        continue if category_covers_owner(categories, owner, table)
                        false return if not paths_cover_variant(covered, table.enum_variant_name[variant_index])
                return true




        # Whether some CATEGORY arm covers the enum that declares a leaf: the category
        # itself, or any ancestor of it (docs/77 §2 -- a category arm discharges its whole
        # subtree, so a leaf of `MouseEvent` is covered by an `InputEvent` arm).
        def category_covers_owner(categories: darray[sview]&, owner: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for category in categories:
                    true return if owner == category or enum_in_hierarchy(owner, category, table)
                return false




        # Whether ARM is an unguarded struct-destructure pattern (`Row{...}:`).
        def match_arm_is_unguarded_struct(arm: Ast::MatchArm) -> bool:
            can Abort.Panic:
                guarded: bool = match arm.guard:
                    Expr.Invalid: false
                    Expr.Absent:  false
                    _:            true
                false return if guarded
                return match arm.pattern:
                    Pattern.Struct(struct_path, struct_fields): true
                    _:                                          false




        # The enum name that owns the qualified variant path (`"TokenKind.IntLit"` ->
        # `"TokenKind"`), or "" when `path` isn't qualified by any known enum (e.g. the
        # `.Ready` leading-dot shorthand, which stores an unqualified path).
        def enum_owner_of_path(path: sview, table: SymbolTable&) -> sview:
            can Abort.Panic:
                for owner_index in 0..<table.enum_variant_owner.count:
                    candidate: sview = table.enum_variant_owner[owner_index]
                    candidate return if path_names_enum_qualified(path, candidate)
                return ""




        # Whether `path` is `<enum>.<variant>` under any module qualifier: enum owners are
        # registered BARE, but a pattern keeps its source spelling, so `Ui::Container.Box`
        # and `Ui.Container.Box` must both resolve to `Container`. The enum name has to be
        # the segment right before the final `.`, and start the path or follow a `.`/`::`.
        def path_names_enum_qualified(path: sview, enum_name: sview) -> bool:
            can Abort.Panic:
                true return if path_names_enum(path, enum_name)
                path_length: usize = sview_len(path)
                enum_length: usize = sview_len(enum_name)
                false return if enum_length == 0 or path_length <= enum_length + 1
                last_dot: isize =
                    for char_index in 0..<path_length |last_dot_index: isize = -1| -> last_dot_index:
                        last_dot_index <- char_index.isize() if sview_at(path, char_index) == '.' else last_dot_index
                false return if last_dot < enum_length.isize()
                start: usize = last_dot.usize() - enum_length
                false return if start == 0
                before: u8 = sview_at(path, start - 1)
                false return if before != '.' and before != ':'
                for offset in 0..<enum_length:
                    false return if sview_at(path, start + offset) != sview_at(enum_name, offset)
                return true




        # The hierarchy root that `enum_name` is a registered child of, or "" when
        # `enum_name` isn't a hierarchy child (a plain flat enum).
        def enum_hierarchy_root_of(enum_name: sview, table: SymbolTable&) -> sview:
            can Abort.Panic:
                for child_index in 0..<table.enum_hierarchy_child.count:
                    table.enum_hierarchy_parent[child_index] return if table.enum_hierarchy_child[child_index] == enum_name
                return ""




        # Whether every variant of every child enum in the hierarchy rooted at `root` is
        # named among `covered` (mirrors `check_hierarchy_exhaustive`'s coverage test).
        def hierarchy_variants_all_covered(root: sview, covered: darray[sview]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for variant_index in 0..<table.enum_variant_owner.count:
                    child: sview = table.enum_variant_owner[variant_index]
                    if enum_in_hierarchy(child, root, table):
                        false return if not paths_cover_variant(covered, table.enum_variant_name[variant_index])
                return true




        # Whether every declared variant of the flat enum `enum_name` is named among
        # `covered` (mirrors `check_match_exhaustive`'s coverage test).
        def flat_enum_variants_all_covered(enum_name: sview, covered: darray[sview]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                false return if not enum_is_known(enum_name, table)
                for variant_index in 0..<table.enum_variant_owner.count:
                    if table.enum_variant_owner[variant_index] == enum_name:
                        false return if not paths_cover_variant(covered, table.enum_variant_name[variant_index])
                return true
