# Checked signed arithmetic used by semantic constant folding.
# Kept isolated so its i64 boundaries are directly source-linked in proofs.
extend Semantic:
    private:
        def linear_i64_max() -> i64:
            ensure result == 9223372036854775807
            return 9223372036854775807

        def linear_i64_min() -> i64:
            ensure result == (0 - 9223372036854775807 - 1)
            return 0 - 9223372036854775807 - 1

        def linear_add_safe(left: i64, right: i64) -> (known: bool, value: i64):
            ensure result.known == (right == 0 or (right > 0 and left <= linear_i64_max() - right) or (right < 0 and left >= linear_i64_min() - right))
            ensure result.known implies result.value == left + right
            ensure not result.known implies result.value == 0
            return (false, 0) if right > 0 and left > linear_i64_max() - right
            return (false, 0) if right < 0 and left < linear_i64_min() - right
            return (true, left + right)

        def linear_sub_safe(left: i64, right: i64) -> (known: bool, value: i64):
            ensure result.known == (right == 0 or (right > 0 and left >= linear_i64_min() + right) or (right < 0 and left <= linear_i64_max() + right))
            ensure result.known implies result.value == left - right
            ensure not result.known implies result.value == 0
            return (false, 0) if right > 0 and left < linear_i64_min() + right
            return (false, 0) if right < 0 and left > linear_i64_max() + right
            return (true, left - right)

        def linear_mul_safe(left: i64, right: i64) -> (known: bool, value: i64):
            ensure result.known == (
                left == 0 or right == 0 or left == 1 or right == 1
                or (left == -1 and right != linear_i64_min())
                or (right == -1 and left != linear_i64_min())
                or (left > 0 and right > 0 and left <= linear_i64_max() / right)
                or (left > 0 and right < 0 and right >= linear_i64_min() / left)
                or (left < 0 and right > 0 and left >= linear_i64_min() / right)
                or (left < 0 and right < 0 and left >= linear_i64_max() / right)
            )
            ensure result.known implies result.value == left * right
            ensure not result.known implies result.value == 0
            return (true, 0) if left == 0 or right == 0
            return (true, right) if left == 1
            return (true, left) if right == 1
            if left == -1:
                return (false, 0) if right == linear_i64_min()
                return (true, 0 - right)
            if right == -1:
                return (false, 0) if left == linear_i64_min()
                return (true, 0 - left)
            if left > 0:
                return (false, 0) if right > 0 and left > linear_i64_max() / right
                return (false, 0) if right < 0 and right < linear_i64_min() / left
            else:
                return (false, 0) if right > 0 and left < linear_i64_min() / right
                return (false, 0) if right < 0 and left < linear_i64_max() / right
            return (true, left * right)

        # Unary minus has exactly one non-foldable signed input: i64 minimum.
        def linear_neg_safe(operand: i64) -> (known: bool, value: i64):
            ensure result.known == (operand != linear_i64_min())
            ensure result.known implies result.value == 0 - operand
            ensure not result.known implies result.value == 0
            return linear_sub_safe(0, operand)

        # Arithmetic expressions in strict linearization support only +, -, and *. Keep
        # the operator dispatch here so the same source-linked contract covers every caller.
        def linear_arith_safe(left: i64, operator: TokenKind, right: i64) -> (known: bool, value: i64):
            ensure (operator == TokenKind.Plus) implies (result.known == linear_add_safe(left, right).known and result.value == linear_add_safe(left, right).value)
            ensure (operator == TokenKind.Minus) implies (result.known == linear_sub_safe(left, right).known and result.value == linear_sub_safe(left, right).value)
            ensure (operator == TokenKind.Star) implies (result.known == linear_mul_safe(left, right).known and result.value == linear_mul_safe(left, right).value)
            ensure (operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Star) implies (not result.known and result.value == 0)
            return linear_add_safe(left, right) if operator == TokenKind.Plus
            return linear_sub_safe(left, right) if operator == TokenKind.Minus
            return linear_mul_safe(left, right) if operator == TokenKind.Star
            return (false, 0)
