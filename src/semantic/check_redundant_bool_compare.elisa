extend Semantic:
    private:
        # Check for redundant comparisons to boolean literals (e.g. x == true, y != false).
        # Walks all statements and expressions in a function body, detecting Binary expressions
        # where the operator is == or != and one operand is a boolean literal.
        def check_redundant_bool_compare(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Ast::Decl.Func(func_name, func_params, func_return_type, func_body, func_effects, func_decorators, func_line):
                            table <- check_redundant_bool_compare_statements(func_body, table)
                        Ast::Decl.Module(module_name, module_body, module_line):
                            table <- check_redundant_bool_compare(module_body, table)
                        Ast::Decl.Scoped(scoped_body, scoped_line):
                            table <- check_redundant_bool_compare(scoped_body, table)
                        _:
                            pass


        # Walk all statements, recursing into nested bodies and match arms.
        def check_redundant_bool_compare_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Ast::Stmt.Expr(expression, line):
                            table <- check_redundant_bool_compare_expression(expression, table)
                        Ast::Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_redundant_bool_compare_expression(value, table)
                        Ast::Stmt.Assign(target, operator, value, line):
                            table <- check_redundant_bool_compare_expression(target, table)
                            table <- check_redundant_bool_compare_expression(value, table)
                        Ast::Stmt.If(condition, then_body, else_body, line):
                            table <- check_redundant_bool_compare_expression(condition, table)
                            table <- check_redundant_bool_compare_statements(then_body, table)
                            table <- check_redundant_bool_compare_statements(else_body, table)
                        Ast::Stmt.While(condition, body, line):
                            table <- check_redundant_bool_compare_expression(condition, table)
                            table <- check_redundant_bool_compare_statements(body, table)
                        Ast::Stmt.For(bind, variables, iterable, body, line):
                            table <- check_redundant_bool_compare_expression(iterable, table)
                            table <- check_redundant_bool_compare_statements(body, table)
                        Ast::Stmt.Block(kind, clause, binding, body, line):
                            table <- check_redundant_bool_compare_statements(body, table)
                        Ast::Stmt.Match(scrutinee, arms, line):
                            table <- check_redundant_bool_compare_expression(scrutinee, table)
                            for arm in arms |table| -> table:
                                table <- check_redundant_bool_compare_expression(arm.guard, table)
                                table <- check_redundant_bool_compare_statements(arm.body, table)
                        Ast::Stmt.Return(value, line):
                            if value is return_value:
                                table <- check_redundant_bool_compare_expression(return_value, table)
                        Ast::Stmt.Contract(kind, expression, line):
                            # Contract goals spell comparisons explicitly for the prover
                            # (`ensure result == false`); stage0 does not lint them.
                            pass
                        # Other statements have no expressions to check.
                        Ast::Stmt.Invalid:
                            pass
                        Ast::Stmt.Break(label, line):
                            pass
                        Ast::Stmt.Continue(label, line):
                            pass


        # Recursively walk all expressions, checking each Binary for redundant bool comparisons.
        def check_redundant_bool_compare_expression(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Ast::Expr.Binary(left, operator, right, line):
                        # Check if this is an equality/inequality comparison with a boolean literal
                        is_eq_or_neq: bool = operator == TokenKind.EqEq or operator == TokenKind.BangEq
                        left_is_bool: bool = match left:
                            Ast::Expr.BoolLit(lb): true
                            _: false
                        right_is_bool: bool = match right:
                            Ast::Expr.BoolLit(rb): true
                            _: false
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.RedundantBoolCompare, name: "", line: line, expected: "", actual: ""}) if is_eq_or_neq and (left_is_bool or right_is_bool)
                        # Recurse into operands
                        table <- check_redundant_bool_compare_expression(left, table)
                        table <- check_redundant_bool_compare_expression(right, table)
                    Ast::Expr.Call(callee, arguments, argument_names, line):
                        table <- check_redundant_bool_compare_expression(callee, table)
                        for argument in arguments |table| -> table:
                            table <- check_redundant_bool_compare_expression(argument, table)
                    Ast::Expr.Field(object, field, line):
                        table <- check_redundant_bool_compare_expression(object, table)
                    Ast::Expr.Scope(base, name, line):
                        table <- check_redundant_bool_compare_expression(base, table)
                    Ast::Expr.Index(object, index, line):
                        table <- check_redundant_bool_compare_expression(object, table)
                        table <- check_redundant_bool_compare_expression(index, table)
                    Ast::Expr.Slice(object, low, high, line):
                        table <- check_redundant_bool_compare_expression(object, table)
                        table <- check_redundant_bool_compare_expression(low, table)
                        table <- check_redundant_bool_compare_expression(high, table)
                    Ast::Expr.IndexN(object, arguments, line):
                        table <- check_redundant_bool_compare_expression(object, table)
                        for argument in arguments |table| -> table:
                            table <- check_redundant_bool_compare_expression(argument, table)
                    Ast::Expr.Unary(operator, operand, line):
                        table <- check_redundant_bool_compare_expression(operand, table)
                    Ast::Expr.Move(operand, line):
                        table <- check_redundant_bool_compare_expression(operand, table)
                    Ast::Expr.Refinement(base, predicate, line):
                        table <- check_redundant_bool_compare_expression(base, table)
                        table <- check_redundant_bool_compare_expression(predicate, table)
                    Ast::Expr.Paren(inner, line):
                        table <- check_redundant_bool_compare_expression(inner, table)
                    Ast::Expr.Array(elements, line):
                        for element in elements |table| -> table:
                            table <- check_redundant_bool_compare_expression(element, table)
                    Ast::Expr.Tuple(elements, line):
                        for element in elements |table| -> table:
                            table <- check_redundant_bool_compare_expression(element, table)
                    Ast::Expr.SetLit(elements, line):
                        for element in elements |table| -> table:
                            table <- check_redundant_bool_compare_expression(element, table)
                    Ast::Expr.DictLit(entries, line):
                        for entry in entries |table| -> table:
                            table <- check_redundant_bool_compare_expression(entry.key, table)
                            table <- check_redundant_bool_compare_expression(entry.value, table)
                    Ast::Expr.Construct(type_expression, fields, line):
                        table <- check_redundant_bool_compare_expression(type_expression, table)
                        for field in fields |table| -> table:
                            table <- check_redundant_bool_compare_expression(field.value, table)
                    Ast::Expr.RecordUpdate(base, fields, line):
                        table <- check_redundant_bool_compare_expression(base, table)
                        for field in fields |table| -> table:
                            table <- check_redundant_bool_compare_expression(field.value, table)
                    Ast::Expr.If(condition, then_expr, else_expr, line):
                        table <- check_redundant_bool_compare_expression(condition, table)
                        table <- check_redundant_bool_compare_expression(then_expr, table)
                        table <- check_redundant_bool_compare_expression(else_expr, table)
                    Ast::Expr.Match(scrutinee, arms, line):
                        table <- check_redundant_bool_compare_expression(scrutinee, table)
                        for arm in arms |table| -> table:
                            table <- check_redundant_bool_compare_expression(arm.guard, table)
                            table <- check_redundant_bool_compare_statements(arm.body, table)
                    # `catch EXPR:` — positionally identical to Match (guarded, arms, line);
                    # the guarded call is the scrutinee and the arms walk the same way.
                    Ast::Expr.Catch(scrutinee, arms, line):
                        table <- check_redundant_bool_compare_expression(scrutinee, table)
                        for arm in arms |table| -> table:
                            table <- check_redundant_bool_compare_expression(arm.guard, table)
                            table <- check_redundant_bool_compare_statements(arm.body, table)
                    Ast::Expr.Comprehension(var, iterable, condition, body, line):
                        table <- check_redundant_bool_compare_expression(iterable, table)
                        table <- check_redundant_bool_compare_expression(condition, table)
                        table <- check_redundant_bool_compare_expression(body, table)
                    Ast::Expr.Lambda(parameters, body, line):
                        table <- check_redundant_bool_compare_statements(body, table)
                    Ast::Expr.Block(statements, value, captures, line):
                        table <- check_redundant_bool_compare_statements(statements, table)
                        table <- check_redundant_bool_compare_expression(value, table)
                    # Literals and invalid expressions have nothing to recurse into
                    Ast::Expr.Invalid:
                        pass
                    Ast::Expr.Absent:
                        pass
                        pass
                    Ast::Expr.IntLit(value):
                        pass
                    Ast::Expr.FloatLit(text):
                        pass
                    Ast::Expr.StringLit(text):
                        pass
                    Ast::Expr.CharLit(text):
                        pass
                    Ast::Expr.BoolLit(value):
                        pass
                    Ast::Expr.Ident(name, line):
                        pass
                    Ast::Expr.ShorthandMember(parts, line):
                        pass
