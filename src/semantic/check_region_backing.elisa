extend Semantic:
    private:
        def region_backing_known(name: sview) -> bool:
            can Abort.Panic:
                return name == "malloc" or name == "reserve_commit" or name == "fixed" or name == "chained" or name == "scratch"


        # A region clause carries the optional `using STRATEGY` name AND, for the statement
        # form `region r(1024)`, the captured CAPACITY. Only the strategy is a backing name;
        # a capacity is digits and must not be validated as one.
        def region_clause_is_capacity(word: sview) -> bool:
            can Abort.Panic:
                word_length: usize = sview_len(word)
                false return if word_length == 0.usize()
                for index in 0..<word_length:
                    false return if sview_at(word, index) < 48 or sview_at(word, index) > 57
                return true


        def check_region_backing_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            # STATEMENT form only (`binding != ""` — the name is in the
                            # binding slot). Its clause holds the optional `using STRATEGY`
                            # name and the optional captured CAPACITY, so EVERY non-numeric
                            # entry is a strategy to validate. Indexing clause[0] under a
                            # `count == 1` guard silently stopped checking once the capacity
                            # was preserved: `region r(1024) using bogus` yields two entries.
                            if kind == "region" and binding != "":
                                for clause_word in clause |table|:
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownRegionBacking, name: clause_word, line: line, expected: "", actual: ""}) if not region_clause_is_capacity(clause_word) and not region_backing_known(clause_word)
                            table <- check_region_backing_statements(body, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_region_backing_statements(then_body, table)
                            table <- check_region_backing_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- check_region_backing_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_region_backing_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table|:
                                table <- check_region_backing_statements(arm.body, table)
                        _:
                            pass


        def check_region_backing_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- check_region_backing_statements(body, table)
                        Decl.Module(name, body, line):
                            table <- check_region_backing_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_region_backing_declarations(body, table)
                        _:
                            pass

    public:
        def check_region_backing(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_region_backing_declarations(declarations, table)
