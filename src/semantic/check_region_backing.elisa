extend Semantic:
    private:
        def region_backing_known(name: sview) -> bool:
            can Abort.Panic:
                return name == "malloc" or name == "reserve_commit" or name == "fixed" or name == "chained" or name == "scratch"


        # The `using STRATEGY` names the parser recorded, which is the ONLY thing this
        # check validates.
        #
        # It used to scan the region clause and tell strategy from capacity LEXICALLY —
        # "all digits means capacity". A capacity is an arbitrary expression, so every
        # non-literal size was validated as a backing name: `def make(n: usize)` with
        # `region r(n)` reported `unknown region backing "n"` for a program stage0
        # compiles. The parser knows exactly which token was the strategy; it now says so
        # rather than leaving the checker to guess.
        def region_strategy_unknown_at(annotations: darray[Ast::EnumAnnotation]&, line: u32, found: mutable sview&) -> bool:
            can Abort.Panic:
                for annotation in annotations |line, found|:
                    if annotation.name == "__region_strategy" and annotation.line == line and not region_backing_known(annotation.owner):
                        found <- annotation.owner
                        return true
                return false


        def check_region_backing_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            # STATEMENT form only (`binding != ""` — the name is in the
                            # binding slot). Its clause holds the optional `using STRATEGY`
                            # name and the optional captured CAPACITY, so EVERY non-numeric
                            # entry is a strategy to validate. Indexing clause[0] under a
                            # `count == 1` guard silently stopped checking once the capacity
                            # was preserved: `region r(1024) using bogus` yields two entries.
                            if kind == "region" and binding != "":
                                unknown_strategy: mutable sview = ""
                                if region_strategy_unknown_at(annotations, line, &unknown_strategy):
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownRegionBacking, name: unknown_strategy, line: line, expected: "", actual: ""})
                            table <- check_region_backing_statements(body, annotations, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_region_backing_statements(then_body, annotations, table)
                            table <- check_region_backing_statements(else_body, annotations, table)
                        Stmt.While(condition, body, line):
                            table <- check_region_backing_statements(body, annotations, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_region_backing_statements(body, annotations, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table|:
                                table <- check_region_backing_statements(arm.body, annotations, table)
                        _:
                            pass


        def check_region_backing_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- check_region_backing_statements(body, annotations, table)
                        Decl.Module(name, body, line):
                            table <- check_region_backing_declarations(body, annotations, table)
                        Decl.Scoped(body, line):
                            table <- check_region_backing_declarations(body, annotations, table)
                        _:
                            pass

    public:
        def check_region_backing(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_region_backing_declarations(declarations, annotations, table)
