# Stage1 semantic layer — the passes semantic_parallel.elisa may run concurrently, by id.
# GENERATED by scripts/semantic_parallel_gen.py --write from the sequential pipeline in
# semantic_api.elisa (check_full_into); `--check` proves every pass below append-only.
# Ids follow pipeline order, which is the order par_pass_run splices diagnostics in.
#
# Continues semantic_api.elisa.

extend Semantic:
    private:
        # check_full_into's flags, for the passes' arguments and conditions.
        struct ParPassFlags:
            enforce_unsafe_permissions: bool
            flow_strict: bool
            runtime_std: bool
            flow_warn: bool
            enable_smt: bool
            warn_discarded: bool
            enforce_progress: bool
            enforce_extern_contracts: bool
            enforce_raw_unsafe: bool
            emit_proof_hole: bool
            region_stack_cap: i64
            enforce_global_permissions: bool
            carrier_surface: bool

        def par_pass_call(pass_id: u32, file: Ast::File&, loop_view: Ast::File&, flags: ParPassFlags, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if pass_id == 0:
                    table <- check_unused_expression(loop_view.top_decls, table) if flags.warn_discarded
                elif pass_id == 1:
                    table <- check_constant_condition(loop_view.top_decls, table) if flags.flow_warn or flags.flow_strict
                elif pass_id == 2:
                    table <- check_redundant_bool_compare(loop_view.top_decls, table)
