extend Semantic:
    private:
        # Walk all statements in a function body, checking for negated comparison expressions.
        def walk_negated_comparison_statements(statements: darray[Ast::Stmt], ieee_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_negated_comparison_expression(expression, ieee_names, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- walk_negated_comparison_expression(value, ieee_names, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_negated_comparison_expression(target, ieee_names, table)
                            table <- walk_negated_comparison_expression(value, ieee_names, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_negated_comparison_expression(condition, ieee_names, table)
                            table <- walk_negated_comparison_statements(then_body, ieee_names, table)
                            table <- walk_negated_comparison_statements(else_body, ieee_names, table)
                        Stmt.While(condition, body, line):
                            table <- walk_negated_comparison_expression(condition, ieee_names, table)
                            table <- walk_negated_comparison_statements(body, ieee_names, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_negated_comparison_expression(iterable, ieee_names, table)
                            table <- walk_negated_comparison_statements(body, ieee_names, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_negated_comparison_statements(body, ieee_names, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_negated_comparison_expression(scrutinee, ieee_names, table)
                            for arm in arms |table|:
                                table <- walk_negated_comparison_expression(arm.guard, ieee_names, table)
                                table <- walk_negated_comparison_statements(arm.body, ieee_names, table)
                        Stmt.Return(value, line):
                            table <- walk_negated_comparison_expression(return_value, ieee_names, table) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- walk_negated_comparison_expression(expression, ieee_names, table)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Walk all expressions, checking for negated equality comparisons (not (a == b) or not (a != b)).
        def walk_negated_comparison_expression(expression: Ast::Expr, ieee_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Invalid:
                        pass
                    Expr.Absent:
                        pass
                        pass
                    Expr.IntLit(value, _):
                        pass
                    Expr.FloatLit(text, _):
                        pass
                    Expr.StringLit(text, _):
                        pass
                    Expr.CharLit(text, _):
                        pass
                    Expr.BoolLit(value, _):
                        pass
                    Expr.Ident(name, line):
                        pass
                    Expr.StaticEffectCall(effect_type, operation, candidates, arguments, argument_names, line):
                        for child in Ast::effect_runtime_children(candidates, arguments) |table|:
                            table <- walk_negated_comparison_expression(child, ieee_names, table)
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_negated_comparison_expression(callee, ieee_names, table)
                        for argument in arguments |table|:
                            table <- walk_negated_comparison_expression(argument, ieee_names, table)
                    Expr.Field(object, field, line):
                        table <- walk_negated_comparison_expression(object, ieee_names, table)
                    Expr.Scope(base, name, line):
                        table <- walk_negated_comparison_expression(base, ieee_names, table)
                    Expr.ShorthandMember(parts, line):
                        pass
                    Expr.Index(object, index, line):
                        table <- walk_negated_comparison_expression(object, ieee_names, table)
                        table <- walk_negated_comparison_expression(index, ieee_names, table)
                    Expr.Slice(object, low, high, line):
                        table <- walk_negated_comparison_expression(object, ieee_names, table)
                        table <- walk_negated_comparison_expression(low, ieee_names, table)
                        table <- walk_negated_comparison_expression(high, ieee_names, table)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_negated_comparison_expression(object, ieee_names, table)
                        for argument in arguments |table|:
                            table <- walk_negated_comparison_expression(argument, ieee_names, table)
                    Expr.Binary(left, operator, right, line):
                        table <- walk_negated_comparison_expression(left, ieee_names, table)
                        table <- walk_negated_comparison_expression(right, ieee_names, table)
                    Expr.Unary(operator, operand, line):
                        # Check for negated equality comparison: outer unary is NOT or BANG
                        is_negation_op: bool = operator == TokenKind.Not or operator == TokenKind.Bang
                        # Check the operand, which might be wrapped in Paren
                        # First try as direct binary (not wrapped in Paren)
                        if is_negation_op:
                            match operand:
                                Expr.Binary(left, binary_op, right, binary_line):
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NegatedComparison, name: "", line: line.line, expected: "", actual: ""}) if (binary_op == TokenKind.EqEq or binary_op == TokenKind.BangEq) and not ieee_nan_self_comparison(left, right, ieee_names)
                                _:
                                    pass
                        # Also check if operand is Paren wrapping a binary
                        if is_negation_op:
                            match operand:
                                Expr.Paren(paren_inner, paren_line):
                                    match paren_inner:
                                        Expr.Binary(left, binary_op, right, binary_line):
                                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NegatedComparison, name: "", line: line.line, expected: "", actual: ""}) if (binary_op == TokenKind.EqEq or binary_op == TokenKind.BangEq) and not ieee_nan_self_comparison(left, right, ieee_names)
                                        _:
                                            pass
                                _:
                                    pass
                        table <- walk_negated_comparison_expression(operand, ieee_names, table)
                    Expr.Move(operand, line):
                        table <- walk_negated_comparison_expression(operand, ieee_names, table)
                    Expr.RegionNew(operand, region, line):
                        table <- walk_negated_comparison_expression(operand, ieee_names, table)
                    Expr.Refinement(base, predicate, line):
                        table <- walk_negated_comparison_expression(base, ieee_names, table)
                        table <- walk_negated_comparison_expression(predicate, ieee_names, table)
                    # `get EXPR else return …` — walk the GUARDED expression; the recovery is a
                    # statement list, which this expression walker does not descend into.
                    Expr.GetElse(guarded, recovery, line):
                        table <- walk_negated_comparison_expression(guarded, ieee_names, table)
                    Expr.Paren(inner, line):
                        table <- walk_negated_comparison_expression(inner, ieee_names, table)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_negated_comparison_expression(element, ieee_names, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_negated_comparison_expression(element, ieee_names, table)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_negated_comparison_expression(element, ieee_names, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_negated_comparison_expression(entry.key, ieee_names, table)
                            table <- walk_negated_comparison_expression(entry.value, ieee_names, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_negated_comparison_expression(type_expression, ieee_names, table)
                        for field in fields |table|:
                            table <- walk_negated_comparison_expression(field.value, ieee_names, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_negated_comparison_expression(base, ieee_names, table)
                        for field in fields |table|:
                            table <- walk_negated_comparison_expression(field.value, ieee_names, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_negated_comparison_expression(condition, ieee_names, table)
                        table <- walk_negated_comparison_expression(then_expr, ieee_names, table)
                        table <- walk_negated_comparison_expression(else_expr, ieee_names, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_negated_comparison_expression(scrutinee, ieee_names, table)
                        for arm in arms |table|:
                            table <- walk_negated_comparison_expression(arm.guard, ieee_names, table)
                            table <- walk_negated_comparison_statements(arm.body, ieee_names, table)
                    # `catch EXPR:` — positionally identical to Match (guarded, arms, line);
                    # the guarded call is the scrutinee and the arms walk the same way.
                    Expr.Catch(scrutinee, arms, line):
                        table <- walk_negated_comparison_expression(scrutinee, ieee_names, table)
                        for arm in arms |table|:
                            table <- walk_negated_comparison_expression(arm.guard, ieee_names, table)
                            table <- walk_negated_comparison_statements(arm.body, ieee_names, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_negated_comparison_expression(iterable, ieee_names, table)
                        table <- walk_negated_comparison_expression(condition, ieee_names, table)
                        table <- walk_negated_comparison_expression(body, ieee_names, table)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_negated_comparison_statements(body, ieee_names, table)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_negated_comparison_statements(statements, ieee_names, table)
                        table <- walk_negated_comparison_expression(value, ieee_names, table)


        # Entry point: check all declarations for negated comparison expressions.
        def check_declarations_for_negated_comparison(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            ieee_names: darray[sview] = ieee_nan_parameter_names(params, body)
                            table <- walk_negated_comparison_statements(body, ieee_names, table)
                        Decl.Module(name, body, line):
                            table <- check_declarations_for_negated_comparison(body, table)
                        Decl.Scoped(body, line):
                            table <- check_declarations_for_negated_comparison(body, table)
                        _:
                            pass


    public:
        # Public check function that can be called from semantic_api.
        def check_negated_comparison(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_declarations_for_negated_comparison(declarations, table)
