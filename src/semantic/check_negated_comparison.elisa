extend Semantic:
    private:
        # Walk all statements in a function body, checking for negated comparison expressions.
        def walk_negated_comparison_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_negated_comparison_expression(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- walk_negated_comparison_expression(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_negated_comparison_expression(target, table)
                            table <- walk_negated_comparison_expression(value, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_negated_comparison_expression(condition, table)
                            table <- walk_negated_comparison_statements(then_body, table)
                            table <- walk_negated_comparison_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- walk_negated_comparison_expression(condition, table)
                            table <- walk_negated_comparison_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_negated_comparison_expression(iterable, table)
                            table <- walk_negated_comparison_statements(body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_negated_comparison_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_negated_comparison_expression(scrutinee, table)
                            for arm in arms |table|:
                                table <- walk_negated_comparison_expression(arm.guard, table)
                                table <- walk_negated_comparison_statements(arm.body, table)
                        Stmt.Return(value, line):
                            if value is return_value:
                                table <- walk_negated_comparison_expression(return_value, table)
                        Stmt.Contract(kind, expression, line):
                            table <- walk_negated_comparison_expression(expression, table)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Walk all expressions, checking for negated equality comparisons (not (a == b) or not (a != b)).
        def walk_negated_comparison_expression(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Invalid:
                        pass
                    Expr.IntLit(value):
                        pass
                    Expr.FloatLit(text):
                        pass
                    Expr.StringLit(text):
                        pass
                    Expr.CharLit(text):
                        pass
                    Expr.BoolLit(value):
                        pass
                    Expr.Ident(name, line):
                        pass
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_negated_comparison_expression(callee, table)
                        for argument in arguments |table|:
                            table <- walk_negated_comparison_expression(argument, table)
                    Expr.Field(object, field, line):
                        table <- walk_negated_comparison_expression(object, table)
                    Expr.Scope(base, name, line):
                        table <- walk_negated_comparison_expression(base, table)
                    Expr.ShorthandMember(parts, line):
                        pass
                    Expr.Index(object, index, line):
                        table <- walk_negated_comparison_expression(object, table)
                        table <- walk_negated_comparison_expression(index, table)
                    Expr.Slice(object, low, high, line):
                        table <- walk_negated_comparison_expression(object, table)
                        table <- walk_negated_comparison_expression(low, table)
                        table <- walk_negated_comparison_expression(high, table)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_negated_comparison_expression(object, table)
                        for argument in arguments |table|:
                            table <- walk_negated_comparison_expression(argument, table)
                    Expr.Binary(left, operator, right, line):
                        table <- walk_negated_comparison_expression(left, table)
                        table <- walk_negated_comparison_expression(right, table)
                    Expr.Unary(operator, operand, line):
                        # Check for negated equality comparison: outer unary is NOT or BANG
                        is_negation_op: bool = operator == TokenKind.Not or operator == TokenKind.Bang
                        if is_negation_op:
                            # Check the operand, which might be wrapped in Paren
                            # First try as direct binary (not wrapped in Paren)
                            if operand is Expr.Binary(left, binary_op, right, binary_line):
                                is_equality_op: bool = binary_op == TokenKind.EqEq or binary_op == TokenKind.BangEq
                                if is_equality_op:
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NegatedComparison, name: "", line: line, expected: "", actual: ""})
                            # Also check if operand is Paren wrapping a binary
                            elif operand is Expr.Paren(paren_inner, paren_line):
                                if paren_inner is Expr.Binary(left, binary_op, right, binary_line):
                                    is_equality_op: bool = binary_op == TokenKind.EqEq or binary_op == TokenKind.BangEq
                                    if is_equality_op:
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NegatedComparison, name: "", line: line, expected: "", actual: ""})
                        table <- walk_negated_comparison_expression(operand, table)
                    Expr.Paren(inner, line):
                        table <- walk_negated_comparison_expression(inner, table)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_negated_comparison_expression(element, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_negated_comparison_expression(element, table)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_negated_comparison_expression(element, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_negated_comparison_expression(entry.key, table)
                            table <- walk_negated_comparison_expression(entry.value, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_negated_comparison_expression(type_expression, table)
                        for field in fields |table|:
                            table <- walk_negated_comparison_expression(field.value, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_negated_comparison_expression(base, table)
                        for field in fields |table|:
                            table <- walk_negated_comparison_expression(field.value, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_negated_comparison_expression(condition, table)
                        table <- walk_negated_comparison_expression(then_expr, table)
                        table <- walk_negated_comparison_expression(else_expr, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_negated_comparison_expression(scrutinee, table)
                        for arm in arms |table|:
                            table <- walk_negated_comparison_expression(arm.guard, table)
                            table <- walk_negated_comparison_statements(arm.body, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_negated_comparison_expression(iterable, table)
                        table <- walk_negated_comparison_expression(condition, table)
                        table <- walk_negated_comparison_expression(body, table)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_negated_comparison_statements(body, table)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_negated_comparison_statements(statements, table)
                        table <- walk_negated_comparison_expression(value, table)


        # Entry point: check all declarations for negated comparison expressions.
        def check_declarations_for_negated_comparison(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- walk_negated_comparison_statements(body, table)
                        Decl.Module(name, body, line):
                            table <- check_declarations_for_negated_comparison(body, table)
                        Decl.Scoped(body, line):
                            table <- check_declarations_for_negated_comparison(body, table)
                        _:
                            pass


    public:
        # Public check function that can be called from semantic_api.
        def check_negated_comparison(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_declarations_for_negated_comparison(declarations, table)
