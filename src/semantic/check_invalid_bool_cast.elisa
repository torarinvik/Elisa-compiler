# Check for `.cast[T]` that crosses the bool boundary: `.cast` is reinterpret-only, and
# `bool` cannot be reinterpret-cast to/from any other primitive (cstr, i64, char, f64, ...).
# Disjoint from InvalidCast (numeric<->numeric value conversion) and from the allowed
# string<->numeric pointer cast: this check fires only when EXACTLY ONE side is "bool"
# and the OTHER side is a recognized non-bool primitive.

extend Semantic:
    private:
        # Whether a type name is a recognized non-bool primitive family (integer/float/string/char).
        def is_known_nonbool_primitive(name: sview) -> bool:
            can Abort.Panic:
                return is_integer_type_name(name) or is_float_type_name(name) or is_string_type_name(name) or name == "char"

        # Walk through expressions, checking for bool-boundary-crossing `.cast[T]`.
        def walk_expression_for_invalid_bool_cast(expression: Ast::Expr, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Binary(left, operator, right, line):
                        table <- walk_expression_for_invalid_bool_cast(left, table, var_types, type_names)
                        if operator != TokenKind.Is and operator != TokenKind.As:
                            table <- walk_expression_for_invalid_bool_cast(right, table, var_types, type_names)
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_expression_for_invalid_bool_cast(callee, table, var_types, type_names)
                        for argument in arguments |table|:
                            table <- walk_expression_for_invalid_bool_cast(argument, table, var_types, type_names)
                    Expr.Field(object, field, line):
                        table <- walk_expression_for_invalid_bool_cast(object, table, var_types, type_names)
                    Expr.Scope(base, name, line):
                        table <- walk_expression_for_invalid_bool_cast(base, table, var_types, type_names)
                    Expr.Index(object, index, line):
                        is_cast: mutable bool = false
                        if object is Expr.Field(receiver, cast_field, cast_field_line):
                            if cast_field == "cast":
                                is_cast <- true
                                if receiver is Expr.Ident(receiver_name, receiver_name_line):
                                    if index is Expr.Ident(target_type_name, target_type_line):
                                        receiver_type_name: sview = local_type_of(var_types, type_names, receiver_name)
                                        if receiver_type_name != "":
                                            receiver_is_bool: bool = receiver_type_name == "bool"
                                            target_is_bool: bool = target_type_name == "bool"
                                            if receiver_is_bool and not target_is_bool and is_known_nonbool_primitive(target_type_name):
                                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidBoolCast, name: "", line: line, expected: receiver_type_name, actual: target_type_name})
                                            elif target_is_bool and not receiver_is_bool and is_known_nonbool_primitive(receiver_type_name):
                                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidBoolCast, name: "", line: line, expected: receiver_type_name, actual: target_type_name})
                        table <- walk_expression_for_invalid_bool_cast(object, table, var_types, type_names)
                        if not is_cast:
                            table <- walk_expression_for_invalid_bool_cast(index, table, var_types, type_names)
                    Expr.Unary(operator, operand, line):
                        table <- walk_expression_for_invalid_bool_cast(operand, table, var_types, type_names)
                    Expr.Paren(inner, line):
                        table <- walk_expression_for_invalid_bool_cast(inner, table, var_types, type_names)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_invalid_bool_cast(element, table, var_types, type_names)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_invalid_bool_cast(element, table, var_types, type_names)
                    Expr.Slice(object, low, high, line):
                        table <- walk_expression_for_invalid_bool_cast(object, table, var_types, type_names)
                        table <- walk_expression_for_invalid_bool_cast(low, table, var_types, type_names)
                        table <- walk_expression_for_invalid_bool_cast(high, table, var_types, type_names)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_expression_for_invalid_bool_cast(object, table, var_types, type_names)
                        if not index_receiver_is_type_application(object):
                            for argument in arguments |table|:
                                table <- walk_expression_for_invalid_bool_cast(argument, table, var_types, type_names)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_expression_for_invalid_bool_cast(element, table, var_types, type_names)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- walk_expression_for_invalid_bool_cast(entry.key, table, var_types, type_names)
                            table <- walk_expression_for_invalid_bool_cast(entry.value, table, var_types, type_names)
                    Expr.Construct(type_expression, fields, line):
                        table <- walk_expression_for_invalid_bool_cast(type_expression, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_invalid_bool_cast(field.value, table, var_types, type_names)
                    Expr.RecordUpdate(base, fields, line):
                        table <- walk_expression_for_invalid_bool_cast(base, table, var_types, type_names)
                        for field in fields |table|:
                            table <- walk_expression_for_invalid_bool_cast(field.value, table, var_types, type_names)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- walk_expression_for_invalid_bool_cast(condition, table, var_types, type_names)
                        table <- walk_expression_for_invalid_bool_cast(then_expr, table, var_types, type_names)
                        table <- walk_expression_for_invalid_bool_cast(else_expr, table, var_types, type_names)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- walk_expression_for_invalid_bool_cast(iterable, table, var_types, type_names)
                        table <- walk_expression_for_invalid_bool_cast(condition, table, var_types, type_names)
                        table <- walk_expression_for_invalid_bool_cast(body, table, var_types, type_names)
                    Expr.Lambda(parameters, body, line):
                        table <- walk_statements_for_invalid_bool_cast(body, table, var_types, type_names)
                    Expr.Block(statements, value, captures, line):
                        table <- walk_statements_for_invalid_bool_cast(statements, table, var_types, type_names)
                        table <- walk_expression_for_invalid_bool_cast(value, table, var_types, type_names)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_expression_for_invalid_bool_cast(scrutinee, table, var_types, type_names)
                        for arm in arms |table|:
                            table <- walk_statements_for_invalid_bool_cast(arm.body, table, var_types, type_names)
                    # Literals and other expressions don't contain relevant sub-expressions
                    _:
                        pass

        # Walk through statements, tracking variable types and checking for invalid bool casts.
        def walk_statements_for_invalid_bool_cast(statements: darray[Ast::Stmt], table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- walk_expression_for_invalid_bool_cast(expression, table, var_types, type_names)
                        Stmt.VarDecl(name, type_expression, value, line):
                            # Record the type for this variable
                            type_name: sview = bare_type_name(type_expression)
                            note_local_type(var_types, type_names, name, type_name)
                            table <- walk_expression_for_invalid_bool_cast(value, table, var_types, type_names)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_expression_for_invalid_bool_cast(target, table, var_types, type_names)
                            table <- walk_expression_for_invalid_bool_cast(value, table, var_types, type_names)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_expression_for_invalid_bool_cast(condition, table, var_types, type_names)
                            table <- walk_statements_for_invalid_bool_cast(then_body, table, var_types, type_names)
                            table <- walk_statements_for_invalid_bool_cast(else_body, table, var_types, type_names)
                        Stmt.While(condition, body, line):
                            table <- walk_expression_for_invalid_bool_cast(condition, table, var_types, type_names)
                            table <- walk_statements_for_invalid_bool_cast(body, table, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_expression_for_invalid_bool_cast(iterable, table, var_types, type_names)
                            table <- walk_statements_for_invalid_bool_cast(body, table, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_statements_for_invalid_bool_cast(body, table, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_expression_for_invalid_bool_cast(scrutinee, table, var_types, type_names)
                            for arm in arms |table|:
                                table <- walk_expression_for_invalid_bool_cast(arm.guard, table, var_types, type_names)
                                table <- walk_statements_for_invalid_bool_cast(arm.body, table, var_types, type_names)
                        Stmt.Return(value, line):
                            if value is return_value:
                                table <- walk_expression_for_invalid_bool_cast(return_value, table, var_types, type_names)
                        Stmt.Contract(kind, expression, line):
                            table <- walk_expression_for_invalid_bool_cast(expression, table, var_types, type_names)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations.
        def check_invalid_bool_cast_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            # Create fresh type tracking for this function
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            # Record parameter types
                            for param in params |table|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            # Walk the function body
                            table <- walk_statements_for_invalid_bool_cast(body, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_invalid_bool_cast_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_invalid_bool_cast_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_invalid_bool_cast(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_invalid_bool_cast_declarations(declarations, table)
