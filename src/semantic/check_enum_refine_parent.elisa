# An enum may only refine ANOTHER ENUM with `is` (`enum Sub is Base:` for enum-hierarchy
# narrowing). Refining a struct (`enum Bad is Plain` where Plain is a struct) is malformed. The
# parser records the enum's `is` parent under sentinel 3900000008 (owner=enum, name=parent);
# flag when that parent resolves to a struct. Unknown parents are left to the unknown-type check.
extend Semantic:
    public:
        def check_enum_refine_parent(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table| -> table:
                    if annotation.line == 3900000008 and annotation.name != "" and annotation.owner != "":
                        if find_symbol(table, annotation.name) is parent_symbol:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.EnumRefinesNonEnum, name: annotation.owner, line: 0, expected: "", actual: annotation.name}) if parent_symbol.kind == SymbolKind.Struct
