# A view bound from a slice of a NON-mutable source (`if xs[0:3] is s:` where `xs: darray[i32]&`
# is a shared, read-only ref) is read-only, so writing through its index (`s[1] <- 25`) is
# rejected. SOUND subset: the binding must come from `SLICE is NAME` in an `if` condition where
# the slice base is a param/local whose declared type carries no `mutable` marker; the write must
# target `NAME[i]` directly. A mutable-source slice keeps its writability.
extend Semantic:
    private:
        # Whether NAME is a mutable-typed param/local (its declared type carries a `mutable` marker).
        def rov_is_mutable_source(mutable_names: darray[sview]&, name: sview) -> bool:
            can Abort.Panic:
                return any mutable_name in mutable_names where mutable_name == name

        # If CONDITION is `SLICE is NAME` binding a read-only view, its bound NAME ("" otherwise).
        def rov_readonly_binding(condition: Ast::Expr, mutable_names: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Binary(left, operator, right, line):
                        if operator == TokenKind.Is and right is Expr.Ident(bind_name, ident_line):
                            if left is Expr.Slice(slice_object, low, high, slice_line):
                                source_name: sview = ident_name_of(slice_object)
                                if source_name != "" and not rov_is_mutable_source(mutable_names, source_name):
                                    return bind_name
                        return sview("", 0, 0)
                    _:
                        return sview("", 0, 0)

        def rov_check_statements(statements: darray[Ast::Stmt], mutable_names: darray[sview]&, readonly_views: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Assign(target, operator, value, line):
                            if target is Expr.Index(index_object, subscript, index_line):
                                target_view: sview = ident_name_of(index_object)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ReadOnlyViewAssign, name: "", line: line, expected: "", actual: ""}) if target_view != "" and (any view in readonly_views where view == target_view)
                        Stmt.If(condition, then_body, else_body, line):
                            bound_view: sview = rov_readonly_binding(condition, mutable_names)
                            then_views: mutable darray[sview] = [existing for existing in readonly_views]
                            then_views.push(bound_view) if bound_view != ""
                            table <- rov_check_statements(then_body, mutable_names, then_views, table)
                            table <- rov_check_statements(else_body, mutable_names, readonly_views, table)
                        Stmt.While(condition, while_body, line):
                            table <- rov_check_statements(while_body, mutable_names, readonly_views, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- rov_check_statements(for_body, mutable_names, readonly_views, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- rov_check_statements(body, mutable_names, readonly_views, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- rov_check_statements(arm.body, mutable_names, readonly_views, table)
                        _:
                            pass

        def rov_walk(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            mutable_names: mutable darray[sview] = []
                            for parameter in parameters |mutable_names|:
                                mutable_names.push(parameter.name) if type_is_mutable(parameter.type_expression)
                            no_views: darray[sview] = []
                            table <- rov_check_statements(body, mutable_names, no_views, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- rov_walk(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- rov_walk(scoped_body, table)
                        _:
                            pass

    public:
        def check_readonly_view_assign(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- rov_walk(file.top_decls, table)
