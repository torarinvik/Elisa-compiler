# `copy[TARGET](src)` is a value copy into a fixed-size stack array. Validate its shape (stage0
# parity), SOUND subset over param/local source types:
#   - TARGET must be `array[T, N]` (a compile-time-sized array), else the target is scalar.
#   - the source must have a statically known size: a `darray[T]` source has a runtime length.
#   - a fixed-array source's extent must equal TARGET's extent.
extend Semantic:
    private:
        # (is_array, element, extent, base_name) for a `copy` TARGET type argument.
        def copy_target_info(target: Ast::Expr) -> (is_array: bool, element: sview, extent: i64):
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.IndexN(object_n, arguments_n, line_n):
                        if ident_name_of(object_n) == "array" and arguments_n.count == 2:
                            extent: (found: bool, value: i64) = fold_const_int(arguments_n[1])
                            return (true, ident_name_of(arguments_n[0]), extent.value if extent.found else -1)
                        return (false, sview("", 0, 0), -1)
                    _:
                        return (false, sview("", 0, 0), -1)

        # (kind, element, extent) for an array/darray annotation: kind "array"/"darray"/"".
        def copy_source_info(type_expression: Ast::Expr) -> (kind: sview, element: sview, extent: i64):
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.IndexN(object_n, arguments_n, line_n):
                        head: sview = ident_name_of(object_n)
                        if head == "array" and arguments_n.count == 2:
                            extent: (found: bool, value: i64) = fold_const_int(arguments_n[1])
                            return ("array", ident_name_of(arguments_n[0]), extent.value if extent.found else -1)
                        ("darray", ident_name_of(arguments_n[0]), -1) return if head == "darray" and arguments_n.count == 1
                        return (sview("", 0, 0), sview("", 0, 0), -1)
                    Expr.Index(object, index, line):
                        head: sview = ident_name_of(object)
                        ("darray", ident_name_of(index), -1) return if head == "darray"
                        return (sview("", 0, 0), sview("", 0, 0), -1)
                    Expr.Unary(operator, operand, unary_line):
                        return copy_source_info(operand)
                    Expr.Paren(inner, paren_line):
                        return copy_source_info(inner)
                    _:
                        return (sview("", 0, 0), sview("", 0, 0), -1)

        def copy_check_call(callee: Ast::Expr, arguments: darray[Ast::Expr], line: u32, names: darray[sview]&, kinds: darray[sview]&, elements: darray[sview]&, extents: darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                if callee is Expr.Index(callee_object, type_argument, index_line):
                    if ident_name_of(callee_object) == "copy" and arguments.count == 1:
                        target: (is_array: bool, element: sview, extent: i64) = copy_target_info(type_argument)
                        if not target.is_array:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CopyScalarTarget, name: "", line: line, expected: "", actual: ident_name_of(type_argument)})
                        else:
                            source_name: sview = ident_name_of(arguments[0])
                            source_index: mutable i64 = -1
                            probe: mutable usize = 0
                            while probe < names.count |source_index, probe, source_name, names|:
                                source_index <- probe.i64() if names[probe] == source_name and source_index < 0
                                probe <- probe + 1
                            if source_index >= 0:
                                slot: usize = source_index.usize()
                                if kinds[slot] == "darray":
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CopyRuntimeLength, name: "", line: line, expected: "", actual: elements[slot]})
                                elif kinds[slot] == "array" and extents[slot] >= 0 and target.extent >= 0 and extents[slot] != target.extent:
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CopySizeMismatch, name: "", line: line, expected: "", actual: elements[slot], expected_count: extents[slot].u32(), actual_count: target.extent.u32()})

        def copy_check_expression(expression: Ast::Expr, names: darray[sview]&, kinds: darray[sview]&, elements: darray[sview]&, extents: darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- copy_check_call(callee, arguments, line.line, names, kinds, elements, extents, table)
                        for argument in arguments |table| -> table:
                            table <- copy_check_expression(argument, names, kinds, elements, extents, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- copy_check_expression(left, names, kinds, elements, extents, table)
                        table <- copy_check_expression(right, names, kinds, elements, extents, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- copy_check_expression(operand, names, kinds, elements, extents, table)
                    Expr.Paren(inner, paren_line):
                        table <- copy_check_expression(inner, names, kinds, elements, extents, table)
                    _:
                        pass

        def copy_check_statements(statements: darray[Ast::Stmt], names: darray[sview]&, kinds: darray[sview]&, elements: darray[sview]&, extents: darray[i64]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- copy_check_expression(expression, names, kinds, elements, extents, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- copy_check_expression(value, names, kinds, elements, extents, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- copy_check_expression(value, names, kinds, elements, extents, table)
                        Stmt.Return(value, line):
                            table <- copy_check_expression(returned, names, kinds, elements, extents, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- copy_check_expression(condition, names, kinds, elements, extents, table)
                            table <- copy_check_statements(then_body, names, kinds, elements, extents, table)
                            table <- copy_check_statements(else_body, names, kinds, elements, extents, table)
                        Stmt.While(condition, while_body, line):
                            table <- copy_check_statements(while_body, names, kinds, elements, extents, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- copy_check_statements(for_body, names, kinds, elements, extents, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- copy_check_statements(body, names, kinds, elements, extents, table)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table| -> table:
                                table <- copy_check_statements(arm.body, names, kinds, elements, extents, table)
                        _:
                            pass

        def copy_walk(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            names: mutable darray[sview] = []
                            kinds: mutable darray[sview] = []
                            elements: mutable darray[sview] = []
                            extents: mutable darray[i64] = []
                            for parameter in parameters |names, kinds, elements, extents|:
                                info: (kind: sview, element: sview, extent: i64) = copy_source_info(parameter.type_expression)
                                if info.kind != "":
                                    names.push(parameter.name)
                                    kinds.push(info.kind)
                                    elements.push(info.element)
                                    extents.push(info.extent)
                            table <- copy_check_statements(body, names, kinds, elements, extents, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- copy_walk(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- copy_walk(scoped_body, table)
                        _:
                            pass

    public:
        def check_copy_builtin(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- copy_walk(file.top_decls, table)
