extend Semantic:
    private:
        def bam_statements(statements: darray[Ast::Stmt], owners: darray[sview @source]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, binders: BorrowBinders&, borrow_names: mutable darray[sview @source]&, borrow_fields: mutable darray[sview @source]&, borrow_owners: mutable darray[sview @source]&, kinds: mutable darray[u32]&, details: mutable darray[sview @source]&, flow: mutable darray[bool]&, loop_exits: mutable BorrowLoopExitState&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |borrow_names, borrow_fields, borrow_owners, kinds, details, flow, loop_exits, table| -> table:
                    # Everything after a return/break/continue is unreachable.
                    continue if flow[0]
                    match statement:
                        Stmt.Expr(statement_expression, statement_pos):
                            table <- bam_expression(statement_expression, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                        Stmt.VarDecl(declared_name, declared_type, declared_value, declared_pos):
                            declared_move: sview = bam_moved_owner(declared_value, owners)
                            table <- bam_expression(declared_value, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table) if declared_move == ""
                            bam_set_consumed(owners, kinds, details, declared_move, 2, declared_name)
                            bam_bind(declared_name, rvc_is_absent(declared_type) or affine_annotation_is_ref(declared_type), declared_value, false, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table)
                            bam_append_scope_local(loop_exits.active_locals, declared_name)
                        Stmt.Assign(assign_target, assign_operator, assign_value, assign_pos):
                            assign_name: sview = ident_name_of(assign_target)
                            rhs_borrow_names: mutable darray[sview @source] = []
                            rhs_borrow_fields: mutable darray[sview @source] = []
                            rhs_borrow_owners: mutable darray[sview @source] = []
                            rhs_borrow_names.extend(borrow_names) if assign_operator == TokenKind.LArrow
                            rhs_borrow_fields.extend(borrow_fields) if assign_operator == TokenKind.LArrow
                            rhs_borrow_owners.extend(borrow_owners) if assign_operator == TokenKind.LArrow
                            if assign_operator == TokenKind.LArrow:
                                table <- bam_expression_place_target(assign_target, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                            else:
                                table <- bam_expression(assign_target, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table) if assign_name == ""
                            assign_move: sview = bam_moved_owner(assign_value, owners)
                            if assign_operator == TokenKind.LArrow:
                                table <- bam_expression_larrow_rhs(assign_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, kinds, details, flow, loop_exits, table)
                            else:
                                table <- bam_expression(assign_value, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table) if assign_move == ""
                            if assign_operator == TokenKind.LArrow:
                                # Direct and aggregate RHS move leaves were consumed in source
                                # order by bam_expression_larrow_rhs.
                                if not flow[0]:
                                    # The staging helper handles both one destination and
                                    # positional arrays, so apply every destination through the
                                    # same path. Stage from the pre-RHS snapshot to preserve
                                    # self-rebinding and aggregate field provenance.
                                    staged_entries: mutable darray[BorrowLarrowEntry] @source = []
                                    staged_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                                    table <- bam_stage_larrow_pair(assign_target, assign_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, rhs_borrow_names, rhs_borrow_fields, rhs_borrow_owners, staged_entries, staged_flow, table)
                                    for entry in staged_entries |owners, binders, borrow_names, borrow_fields, borrow_owners, kinds, details, staged_flow, table|:
                                        break if not staged_flow.normal_seen
                                        entry_effect: u32 = bam_larrow_effect_for_target(entry.target, table)
                                        table <- bam_apply_larrow_target(entry.target, entry.owners, entry_effect, owners, binders, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                                        target_name: sview = ident_name_of(entry.target)
                                        bam_clear_borrow_nested_fields(target_name, borrow_names, borrow_fields, borrow_owners) if target_name != "" and binders_bound_once(binders, target_name) and entry_effect == RBM_ASSIGN_EFFECT_WRITE_THROUGH
                                        if target_name != "" and binders_bound_once(binders, target_name):
                                            for field_index in 0..<entry.field_fields.count |entry, target_name, borrow_names, borrow_fields, borrow_owners, field_index|:
                                                field_name: mutable sview = entry.field_names[field_index] if field_index < entry.field_names.count else ""
                                                field_name <- target_name if field_name == ""
                                                field_path: sview = entry.field_fields[field_index]
                                                field_owner: sview = entry.field_owners[field_index] if field_index < entry.field_owners.count else ""
                                                if field_owner == "":
                                                    bam_force_reset_borrow_field(borrow_names, borrow_fields, borrow_owners, field_name, field_path)
                                                else:
                                                    bam_push_borrow(borrow_names, borrow_fields, borrow_owners, field_name, field_path, field_owner)
                                        bam_set_consumed(owners, kinds, details, target_name, 0, "") if target_name != "" and target_name != entry.move_owner
                                    # `o <- value` re-initialises the owner: its borrows are live again.
                                    bam_set_consumed(owners, kinds, details, assign_name, 0, "") if assign_name != assign_move
                            else:
                                bam_set_consumed(owners, kinds, details, assign_move, 2, assign_name)
                                bam_bind(assign_name, true, assign_value, false, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table) if assign_operator == TokenKind.Assign
                                bam_append_scope_local(loop_exits.active_locals, assign_name) if assign_operator == TokenKind.Assign
                        Stmt.Return(returned_option, returned_pos):
                            if returned_option is returned_expression:
                                table <- bam_expression(returned_expression, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table) if bam_moved_owner(returned_expression, owners) == ""
                            flow[0] <- true
                        Stmt.Break(break_label, break_pos):
                            bam_capture_loop_exit(loop_exits, borrow_names, borrow_fields, borrow_owners, kinds, details)
                            flow[0] <- true
                        Stmt.Continue(continue_label, continue_pos):
                            bam_capture_continue(loop_exits, borrow_names, borrow_fields, borrow_owners, kinds, details)
                            flow[0] <- true
                        Stmt.If(branch_condition, branch_then, branch_else, branch_pos):
                            table <- bam_expression(branch_condition, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                            branch_base_names: mutable darray[sview @source] = []
                            branch_base_fields: mutable darray[sview @source] = []
                            branch_base_owners: mutable darray[sview @source] = []
                            then_kinds: mutable darray[u32] = []
                            then_details: mutable darray[sview @source] = []
                            then_flow: mutable darray[bool] = [false]
                            then_exits: mutable BorrowLoopExitState = BorrowLoopExitState{}
                            then_borrow_names: mutable darray[sview @source] = []
                            then_borrow_fields: mutable darray[sview @source] = []
                            then_borrow_owners: mutable darray[sview @source] = []
                            else_kinds: mutable darray[u32] = []
                            else_details: mutable darray[sview @source] = []
                            else_flow: mutable darray[bool] = [false]
                            else_exits: mutable BorrowLoopExitState = BorrowLoopExitState{}
                            else_borrow_names: mutable darray[sview @source] = []
                            else_borrow_fields: mutable darray[sview @source] = []
                            else_borrow_owners: mutable darray[sview @source] = []
                            then_kinds.extend(kinds)
                            then_details.extend(details)
                            branch_base_names.extend(borrow_names)
                            branch_base_fields.extend(borrow_fields)
                            branch_base_owners.extend(borrow_owners)
                            then_borrow_names.extend(branch_base_names)
                            then_borrow_fields.extend(branch_base_fields)
                            then_borrow_owners.extend(branch_base_owners)
                            else_kinds.extend(kinds)
                            else_details.extend(details)
                            else_borrow_names.extend(branch_base_names)
                            else_borrow_fields.extend(branch_base_fields)
                            else_borrow_owners.extend(branch_base_owners)
                            table <- bam_statements(branch_then, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, then_borrow_names, then_borrow_fields, then_borrow_owners, then_kinds, then_details, then_flow, then_exits, table)
                            table <- bam_statements(branch_else, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, else_borrow_names, else_borrow_fields, else_borrow_owners, else_kinds, else_details, else_flow, else_exits, table)
                            no_extra_locals_15: darray[sview @source] = []
                            bam_filter_borrow_state_locals(then_exits.active_locals, no_extra_locals_15, then_borrow_names, then_borrow_fields, then_borrow_owners, branch_base_names, branch_base_fields, branch_base_owners)
                            no_extra_locals_16: darray[sview @source] = []
                            bam_filter_borrow_state_locals(else_exits.active_locals, no_extra_locals_16, else_borrow_names, else_borrow_fields, else_borrow_owners, branch_base_names, branch_base_fields, branch_base_owners)
                            no_extra_locals_17: darray[sview @source] = []
                            bam_filter_loop_exit_paths(then_exits, no_extra_locals_17, branch_base_names, branch_base_fields, branch_base_owners)
                            no_extra_locals_18: darray[sview @source] = []
                            bam_filter_loop_exit_paths(else_exits, no_extra_locals_18, branch_base_names, branch_base_fields, branch_base_owners)
                            bam_merge_loop_exit_states(loop_exits, then_exits)
                            bam_merge_loop_exit_states(loop_exits, else_exits)
                            bam_merge(kinds, details, then_kinds, then_details) if not then_flow[0]
                            bam_merge(kinds, details, else_kinds, else_details) if not else_flow[0]
                            if not then_flow[0] and not else_flow[0]:
                                bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, then_borrow_names, then_borrow_fields, then_borrow_owners)
                                bam_merge_borrow_state(borrow_names, borrow_fields, borrow_owners, else_borrow_names, else_borrow_fields, else_borrow_owners)
                            elif not then_flow[0]:
                                bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, then_borrow_names, then_borrow_fields, then_borrow_owners)
                            elif not else_flow[0]:
                                bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, else_borrow_names, else_borrow_fields, else_borrow_owners)
                            flow[0] <- true if then_flow[0] and else_flow[0] and branch_else.count > 0
                        Stmt.While(loop_condition, loop_body, loop_pos):
                            loop_kinds: mutable darray[u32] = []
                            loop_details: mutable darray[sview @source] = []
                            loop_borrow_names: mutable darray[sview @source] = []
                            loop_borrow_fields: mutable darray[sview @source] = []
                            loop_borrow_owners: mutable darray[sview @source] = []
                            condition_kinds: mutable darray[u32] = []
                            condition_details: mutable darray[sview @source] = []
                            condition_borrow_names: mutable darray[sview @source] = []
                            condition_borrow_fields: mutable darray[sview @source] = []
                            condition_borrow_owners: mutable darray[sview @source] = []
                            body_kinds: mutable darray[u32] = []
                            body_details: mutable darray[sview @source] = []
                            body_flow: mutable darray[bool] = [false]
                            body_borrow_names: mutable darray[sview @source] = []
                            body_borrow_fields: mutable darray[sview @source] = []
                            body_borrow_owners: mutable darray[sview @source] = []
                            body_exits: mutable BorrowLoopExitState = BorrowLoopExitState{}
                            loop_diagnostic_mark: usize = table.diagnostics.count
                            loop_grew: mutable bool = true
                            loop_kinds.extend(kinds)
                            loop_details.extend(details)
                            loop_borrow_names.extend(borrow_names)
                            loop_borrow_fields.extend(borrow_fields)
                            loop_borrow_owners.extend(borrow_owners)
                            # Feed normal and continue backedges into the loop head until
                            # provenance and consumed-owner facts stop growing.
                            while loop_grew |loop_grew, loop_kinds, loop_details, loop_borrow_names, loop_borrow_fields, loop_borrow_owners, condition_kinds, condition_details, condition_borrow_names, condition_borrow_fields, condition_borrow_owners, body_kinds, body_details, body_flow, body_borrow_names, body_borrow_fields, body_borrow_owners, body_exits, table, loop_condition, loop_body, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, loop_diagnostic_mark|:
                                body_kinds.truncate(0)
                                body_details.truncate(0)
                                body_borrow_names.truncate(0)
                                body_borrow_fields.truncate(0)
                                body_borrow_owners.truncate(0)
                                body_kinds.extend(loop_kinds)
                                body_details.extend(loop_details)
                                body_borrow_names.extend(loop_borrow_names)
                                body_borrow_fields.extend(loop_borrow_fields)
                                body_borrow_owners.extend(loop_borrow_owners)
                                body_flow[0] <- false
                                bam_reset_loop_exits(body_exits)
                                table <- bam_expression(loop_condition, owners, body_borrow_names, body_borrow_fields, body_borrow_owners, body_kinds, body_details, table)
                                condition_kinds.truncate(0)
                                condition_details.truncate(0)
                                condition_borrow_names.truncate(0)
                                condition_borrow_fields.truncate(0)
                                condition_borrow_owners.truncate(0)
                                condition_kinds.extend(body_kinds)
                                condition_details.extend(body_details)
                                condition_borrow_names.extend(body_borrow_names)
                                condition_borrow_fields.extend(body_borrow_fields)
                                condition_borrow_owners.extend(body_borrow_owners)
                                table <- bam_statements(loop_body, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, body_borrow_names, body_borrow_fields, body_borrow_owners, body_kinds, body_details, body_flow, body_exits, table)
                                no_extra_locals_19: darray[sview @source] = []
                                bam_filter_borrow_state_locals(body_exits.active_locals, no_extra_locals_19, body_borrow_names, body_borrow_fields, body_borrow_owners, condition_borrow_names, condition_borrow_fields, condition_borrow_owners)
                                no_extra_locals_20: darray[sview @source] = []
                                bam_filter_loop_exit_paths(body_exits, no_extra_locals_20, condition_borrow_names, condition_borrow_fields, condition_borrow_owners)
                                next_kinds: mutable darray[u32] = []
                                next_details: mutable darray[sview @source] = []
                                next_borrow_names: mutable darray[sview @source] = []
                                next_borrow_fields: mutable darray[sview @source] = []
                                next_borrow_owners: mutable darray[sview @source] = []
                                next_kinds.extend(loop_kinds)
                                next_details.extend(loop_details)
                                next_borrow_names.extend(loop_borrow_names)
                                next_borrow_fields.extend(loop_borrow_fields)
                                next_borrow_owners.extend(loop_borrow_owners)
                                bam_merge(next_kinds, next_details, body_kinds, body_details) if not body_flow[0]
                                bam_merge_borrow_state(next_borrow_names, next_borrow_fields, next_borrow_owners, body_borrow_names, body_borrow_fields, body_borrow_owners) if not body_flow[0]
                                bam_merge(next_kinds, next_details, body_exits.continue_kinds, body_exits.continue_details) if body_exits.continue_seen
                                bam_merge_borrow_state(next_borrow_names, next_borrow_fields, next_borrow_owners, body_exits.continue_names, body_exits.continue_fields, body_exits.continue_owners) if body_exits.continue_seen
                                loop_grew <- not bam_consumed_state_equal(loop_kinds, loop_details, next_kinds, next_details) or not bam_borrow_state_equal(loop_borrow_names, loop_borrow_fields, loop_borrow_owners, next_borrow_names, next_borrow_fields, next_borrow_owners)
                                if loop_grew:
                                    loop_kinds.truncate(0)
                                    loop_details.truncate(0)
                                    loop_borrow_names.truncate(0)
                                    loop_borrow_fields.truncate(0)
                                    loop_borrow_owners.truncate(0)
                                    loop_kinds.extend(next_kinds)
                                    loop_details.extend(next_details)
                                    loop_borrow_names.extend(next_borrow_names)
                                    loop_borrow_fields.extend(next_borrow_fields)
                                    loop_borrow_owners.extend(next_borrow_owners)
                                    table.diagnostics <- table.diagnostics.truncate(loop_diagnostic_mark)
                            bam_merge(kinds, details, condition_kinds, condition_details)
                            bam_merge_borrow_state(borrow_names, borrow_fields, borrow_owners, condition_borrow_names, condition_borrow_fields, condition_borrow_owners)
                            bam_merge(kinds, details, body_exits.kinds, body_exits.details) if body_exits.seen
                            bam_merge_borrow_state(borrow_names, borrow_fields, borrow_owners, body_exits.names, body_exits.fields, body_exits.owners) if body_exits.seen
                        Stmt.For(for_bind, for_variables, for_iterable, for_body, for_pos):
                            table <- bam_expression(for_iterable, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                            each_kinds: mutable darray[u32] = []
                            each_details: mutable darray[sview @source] = []
                            each_borrow_names: mutable darray[sview @source] = []
                            each_borrow_fields: mutable darray[sview @source] = []
                            each_borrow_owners: mutable darray[sview @source] = []
                            body_kinds: mutable darray[u32] = []
                            body_details: mutable darray[sview @source] = []
                            body_flow: mutable darray[bool] = [false]
                            body_borrow_names: mutable darray[sview @source] = []
                            body_borrow_fields: mutable darray[sview @source] = []
                            body_borrow_owners: mutable darray[sview @source] = []
                            each_exits: mutable BorrowLoopExitState = BorrowLoopExitState{}
                            loop_diagnostic_mark: usize = table.diagnostics.count
                            loop_grew: mutable bool = true
                            each_kinds.extend(kinds)
                            each_details.extend(details)
                            each_borrow_names.extend(borrow_names)
                            each_borrow_fields.extend(borrow_fields)
                            each_borrow_owners.extend(borrow_owners)
                            # Each item may update the state seen by the next item, so
                            # iterate the body over the joined backedge facts as well.
                            while loop_grew |loop_grew, each_kinds, each_details, each_borrow_names, each_borrow_fields, each_borrow_owners, body_kinds, body_details, body_flow, body_borrow_names, body_borrow_fields, body_borrow_owners, each_exits, table, for_body, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, loop_diagnostic_mark|:
                                body_kinds.truncate(0)
                                body_details.truncate(0)
                                body_borrow_names.truncate(0)
                                body_borrow_fields.truncate(0)
                                body_borrow_owners.truncate(0)
                                body_kinds.extend(each_kinds)
                                body_details.extend(each_details)
                                body_borrow_names.extend(each_borrow_names)
                                body_borrow_fields.extend(each_borrow_fields)
                                body_borrow_owners.extend(each_borrow_owners)
                                bam_bind_loop_literal(for_variables[0], bam_unwrap_replay_literal_iterable(for_iterable), owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, body_borrow_names, body_borrow_fields, body_borrow_owners, table) if for_variables.count == 1
                                body_flow[0] <- false
                                bam_reset_loop_exits(each_exits)
                                table <- bam_statements(for_body, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, body_borrow_names, body_borrow_fields, body_borrow_owners, body_kinds, body_details, body_flow, each_exits, table)
                                bam_filter_borrow_state_locals(each_exits.active_locals, for_variables, body_borrow_names, body_borrow_fields, body_borrow_owners, each_borrow_names, each_borrow_fields, each_borrow_owners)
                                bam_filter_loop_exit_paths(each_exits, for_variables, each_borrow_names, each_borrow_fields, each_borrow_owners)
                                next_kinds: mutable darray[u32] = []
                                next_details: mutable darray[sview @source] = []
                                next_borrow_names: mutable darray[sview @source] = []
                                next_borrow_fields: mutable darray[sview @source] = []
                                next_borrow_owners: mutable darray[sview @source] = []
                                next_kinds.extend(each_kinds)
                                next_details.extend(each_details)
                                next_borrow_names.extend(each_borrow_names)
                                next_borrow_fields.extend(each_borrow_fields)
                                next_borrow_owners.extend(each_borrow_owners)
                                bam_merge(next_kinds, next_details, body_kinds, body_details) if not body_flow[0]
                                bam_merge_borrow_state(next_borrow_names, next_borrow_fields, next_borrow_owners, body_borrow_names, body_borrow_fields, body_borrow_owners) if not body_flow[0]
                                bam_merge(next_kinds, next_details, each_exits.continue_kinds, each_exits.continue_details) if each_exits.continue_seen
                                bam_merge_borrow_state(next_borrow_names, next_borrow_fields, next_borrow_owners, each_exits.continue_names, each_exits.continue_fields, each_exits.continue_owners) if each_exits.continue_seen
                                loop_grew <- not bam_consumed_state_equal(each_kinds, each_details, next_kinds, next_details) or not bam_borrow_state_equal(each_borrow_names, each_borrow_fields, each_borrow_owners, next_borrow_names, next_borrow_fields, next_borrow_owners)
                                if loop_grew:
                                    each_kinds.truncate(0)
                                    each_details.truncate(0)
                                    each_borrow_names.truncate(0)
                                    each_borrow_fields.truncate(0)
                                    each_borrow_owners.truncate(0)
                                    each_kinds.extend(next_kinds)
                                    each_details.extend(next_details)
                                    each_borrow_names.extend(next_borrow_names)
                                    each_borrow_fields.extend(next_borrow_fields)
                                    each_borrow_owners.extend(next_borrow_owners)
                                    table.diagnostics <- table.diagnostics.truncate(loop_diagnostic_mark)
                            bam_merge(kinds, details, each_exits.kinds, each_exits.details) if each_exits.seen
                            bam_merge_borrow_state(borrow_names, borrow_fields, borrow_owners, each_exits.names, each_exits.fields, each_exits.owners) if each_exits.seen
                            bam_merge(kinds, details, each_kinds, each_details)
                            bam_merge_borrow_state(borrow_names, borrow_fields, borrow_owners, each_borrow_names, each_borrow_fields, each_borrow_owners)
                        Stmt.Match(match_scrutinee, match_arms, match_pos):
                            pattern_base_names: mutable darray[sview @source] = []
                            pattern_base_fields: mutable darray[sview @source] = []
                            pattern_base_owners: mutable darray[sview @source] = []
                            pattern_base_names.extend(borrow_names)
                            pattern_base_fields.extend(borrow_fields)
                            pattern_base_owners.extend(borrow_owners)
                            table <- bam_expression_larrow_rhs(match_scrutinee, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, kinds, details, flow, loop_exits, table)
                            pattern_owners: mutable darray[sview @source] = []
                            match_scrutinee_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            pattern_names: mutable darray[sview @source] = []
                            pattern_fields: mutable darray[sview @source] = []
                            pattern_owners_state: mutable darray[sview @source] = []
                            pattern_names.extend(pattern_base_names)
                            pattern_fields.extend(pattern_base_fields)
                            pattern_owners_state.extend(pattern_base_owners)
                            table <- bam_nested_value_owners_scoped(match_scrutinee, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, pattern_names, pattern_fields, pattern_owners_state, pattern_owners, match_scrutinee_flow, table)
                            pre_kinds: mutable darray[u32] = []
                            pre_details: mutable darray[sview @source] = []
                            pre_borrow_names: mutable darray[sview @source] = []
                            pre_borrow_fields: mutable darray[sview @source] = []
                            pre_borrow_owners: mutable darray[sview @source] = []
                            residual_kinds: mutable darray[u32] = []
                            residual_details: mutable darray[sview @source] = []
                            residual_borrow_names: mutable darray[sview @source] = []
                            residual_borrow_fields: mutable darray[sview @source] = []
                            residual_borrow_owners: mutable darray[sview @source] = []
                            merged_kinds: mutable darray[u32] = []
                            merged_details: mutable darray[sview @source] = []
                            merged_borrow_names: mutable darray[sview @source] = []
                            merged_borrow_fields: mutable darray[sview @source] = []
                            merged_borrow_owners: mutable darray[sview @source] = []
                            residual_possible: mutable bool = true
                            has_normal_arm: mutable bool = false
                            pre_kinds.extend(kinds)
                            pre_details.extend(details)
                            pre_borrow_names.extend(borrow_names)
                            pre_borrow_fields.extend(borrow_fields)
                            pre_borrow_owners.extend(borrow_owners)
                            residual_kinds.extend(pre_kinds)
                            residual_details.extend(pre_details)
                            residual_borrow_names.extend(pre_borrow_names)
                            residual_borrow_fields.extend(pre_borrow_fields)
                            residual_borrow_owners.extend(pre_borrow_owners)
                            residual_possible <- false if flow[0]
                            merged_kinds.extend(pre_kinds)
                            merged_details.extend(pre_details)
                            for match_arm in match_arms |borrow_names, borrow_fields, borrow_owners, kinds, details, pre_borrow_names, pre_borrow_fields, pre_borrow_owners, residual_kinds, residual_details, residual_borrow_names, residual_borrow_fields, residual_borrow_owners, merged_kinds, merged_details, merged_borrow_names, merged_borrow_fields, merged_borrow_owners, residual_possible, has_normal_arm, loop_exits, table| -> table:
                                break if flow[0] or not residual_possible
                                arm_kinds: mutable darray[u32] = []
                                arm_details: mutable darray[sview @source] = []
                                arm_flow: mutable darray[bool] = [false]
                                arm_exits: mutable BorrowLoopExitState = BorrowLoopExitState{}
                                guard_exits: mutable BorrowLoopExitState = BorrowLoopExitState{}
                                arm_borrow_names: mutable darray[sview @source] = []
                                arm_borrow_fields: mutable darray[sview @source] = []
                                arm_borrow_owners: mutable darray[sview @source] = []
                                arm_base_names: mutable darray[sview @source] = []
                                arm_base_fields: mutable darray[sview @source] = []
                                arm_base_owners: mutable darray[sview @source] = []
                                arm_kinds.extend(residual_kinds)
                                arm_details.extend(residual_details)
                                arm_borrow_names.extend(residual_borrow_names)
                                arm_borrow_fields.extend(residual_borrow_fields)
                                arm_borrow_owners.extend(residual_borrow_owners)
                                arm_base_names.extend(residual_borrow_names)
                                arm_base_fields.extend(residual_borrow_fields)
                                arm_base_owners.extend(residual_borrow_owners)
                                table <- bam_seed_pattern_borrow_state(match_arm.pattern, match_scrutinee, pattern_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, arm_borrow_names, arm_borrow_fields, arm_borrow_owners, table)
                                arm_local_names: mutable darray[sview @source] = []
                                bam_collect_rhs_pattern_locals(match_arm.pattern, arm_local_names)
                                has_guard: bool = match match_arm.guard:
                                    Expr.Invalid | Expr.Absent: false
                                    _: true
                                pattern_catches_all: bool = bam_match_pattern_catches_all(match_arm.pattern, table)
                                if has_guard:
                                    guard_exits.active_locals.extend(arm_local_names)
                                    table <- bam_expression_larrow_rhs(match_arm.guard, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, arm_borrow_names, arm_borrow_fields, arm_borrow_owners, arm_kinds, arm_details, arm_flow, guard_exits, table)
                                    bam_filter_loop_exit_paths(guard_exits, arm_local_names, arm_base_names, arm_base_fields, arm_base_owners)
                                    bam_restore_pattern_borrow_state(match_arm.pattern, guard_exits.continue_names, guard_exits.continue_fields, guard_exits.continue_owners, arm_base_names, arm_base_fields, arm_base_owners) if guard_exits.continue_seen
                                    bam_restore_pattern_borrow_state(match_arm.pattern, guard_exits.names, guard_exits.fields, guard_exits.owners, arm_base_names, arm_base_fields, arm_base_owners) if guard_exits.seen
                                    if not arm_flow[0]:
                                        failed_names: mutable darray[sview @source] = []
                                        failed_fields: mutable darray[sview @source] = []
                                        failed_owners: mutable darray[sview @source] = []
                                        failed_names.extend(arm_borrow_names)
                                        failed_fields.extend(arm_borrow_fields)
                                        failed_owners.extend(arm_borrow_owners)
                                        bam_restore_pattern_borrow_state(match_arm.pattern, failed_names, failed_fields, failed_owners, arm_base_names, arm_base_fields, arm_base_owners)
                                        if pattern_catches_all:
                                            residual_kinds.truncate(0)
                                            residual_details.truncate(0)
                                            residual_borrow_names.truncate(0)
                                            residual_borrow_fields.truncate(0)
                                            residual_borrow_owners.truncate(0)
                                            residual_kinds.extend(arm_kinds)
                                            residual_details.extend(arm_details)
                                            residual_borrow_names.extend(failed_names)
                                            residual_borrow_fields.extend(failed_fields)
                                            residual_borrow_owners.extend(failed_owners)
                                        else:
                                            bam_merge(residual_kinds, residual_details, arm_kinds, arm_details)
                                            bam_merge_borrow_state(residual_borrow_names, residual_borrow_fields, residual_borrow_owners, failed_names, failed_fields, failed_owners)
                                    elif pattern_catches_all:
                                        residual_possible <- false
                                elif pattern_catches_all:
                                    residual_possible <- false
                                table <- bam_statements(match_arm.body, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, arm_borrow_names, arm_borrow_fields, arm_borrow_owners, arm_kinds, arm_details, arm_flow, arm_exits, table) if not arm_flow[0]
                                bam_filter_borrow_state_locals(arm_exits.active_locals, arm_local_names, arm_borrow_names, arm_borrow_fields, arm_borrow_owners, arm_base_names, arm_base_fields, arm_base_owners)
                                bam_restore_pattern_borrow_state(match_arm.pattern, arm_borrow_names, arm_borrow_fields, arm_borrow_owners, arm_base_names, arm_base_fields, arm_base_owners)
                                bam_filter_loop_exit_paths(arm_exits, arm_local_names, arm_base_names, arm_base_fields, arm_base_owners)
                                bam_restore_pattern_borrow_state(match_arm.pattern, arm_exits.continue_names, arm_exits.continue_fields, arm_exits.continue_owners, arm_base_names, arm_base_fields, arm_base_owners) if arm_exits.continue_seen
                                bam_restore_pattern_borrow_state(match_arm.pattern, arm_exits.names, arm_exits.fields, arm_exits.owners, arm_base_names, arm_base_fields, arm_base_owners) if arm_exits.seen
                                bam_merge_loop_exit_states(loop_exits, guard_exits)
                                bam_merge_loop_exit_states(loop_exits, arm_exits)
                                if not arm_flow[0]:
                                    bam_merge(merged_kinds, merged_details, arm_kinds, arm_details)
                                    if not has_normal_arm:
                                        bam_replace_borrow_state(merged_borrow_names, merged_borrow_fields, merged_borrow_owners, arm_borrow_names, arm_borrow_fields, arm_borrow_owners)
                                        has_normal_arm <- true
                                    else:
                                        bam_merge_borrow_state(merged_borrow_names, merged_borrow_fields, merged_borrow_owners, arm_borrow_names, arm_borrow_fields, arm_borrow_owners)
                            residual_possible <- false if match_arms_exhaustive(match_arms, table)
                            if has_normal_arm:
                                bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, merged_borrow_names, merged_borrow_fields, merged_borrow_owners)
                                kinds.truncate(0)
                                kinds.extend(merged_kinds)
                                details.truncate(0)
                                details.extend(merged_details)
                                if residual_possible:
                                    bam_merge(kinds, details, residual_kinds, residual_details)
                                    bam_merge_borrow_state(borrow_names, borrow_fields, borrow_owners, residual_borrow_names, residual_borrow_fields, residual_borrow_owners)
                            elif residual_possible:
                                bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, residual_borrow_names, residual_borrow_fields, residual_borrow_owners)
                                bam_merge(kinds, details, residual_kinds, residual_details)
                            else:
                                flow[0] <- true if match_arms.count > 0
                        # `can`/`trusted`/`region`/`in`/`nursery`/... bodies run inline, in
                        # order, on this path's own state. Any other block (`try`, `catch`, ...)
                        # may not run, so it is walked on a copy and merged like a branch.
                        # Without this arm stage1 accepted every borrow used after its owner
                        # moved inside one of these blocks (stage0 rejects).
                        Stmt.Block(block_kind, block_clause, block_binding, block_body, block_pos):
                            block_inline: bool = block_kind == "can" or block_kind == "trusted" or block_kind == "region" or block_kind == "in" or block_kind == "with" or block_kind == "lock" or block_kind == "nursery" or block_kind == "pool" or block_kind == "scope" or block_kind == "static"
                            block_scoped: bool = block_body.count > 0 and SemanticBlockKindScope::block_kind_is_scope(block_kind)
                            block_locals: mutable darray[sview @source] = []
                            block_locals.push(block_binding) if block_binding != ""
                            block_base_names: mutable darray[sview @source] = []
                            block_base_fields: mutable darray[sview @source] = []
                            block_base_owners: mutable darray[sview @source] = []
                            block_base_names.extend(borrow_names)
                            block_base_fields.extend(borrow_fields)
                            block_base_owners.extend(borrow_owners)
                            block_exits: mutable BorrowLoopExitState = BorrowLoopExitState{}
                            if block_inline and not block_scoped:
                                # Static inline blocks share the surrounding statement scope, so
                                # declarations and exits must update the current active-local set.
                                if block_binding != "":
                                    bam_clear_borrow_fields(block_binding, borrow_names, borrow_fields, borrow_owners)
                                    bam_append_scope_local(loop_exits.active_locals, block_binding)
                                table <- bam_statements(block_body, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, kinds, details, flow, loop_exits, table)
                            elif block_inline:
                                bam_clear_borrow_fields(block_binding, borrow_names, borrow_fields, borrow_owners) if block_scoped and block_binding != ""
                                table <- bam_statements(block_body, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, kinds, details, flow, block_exits, table)
                                bam_filter_borrow_state_locals(block_exits.active_locals, block_locals, borrow_names, borrow_fields, borrow_owners, block_base_names, block_base_fields, block_base_owners) if block_scoped
                                bam_filter_loop_exit_paths(block_exits, block_locals, block_base_names, block_base_fields, block_base_owners) if block_scoped
                                bam_merge_loop_exit_states(loop_exits, block_exits)
                            else:
                                block_kinds: mutable darray[u32] = []
                                block_details: mutable darray[sview @source] = []
                                block_flow: mutable darray[bool] = [false]
                                block_borrow_names: mutable darray[sview @source] = []
                                block_borrow_fields: mutable darray[sview @source] = []
                                block_borrow_owners: mutable darray[sview @source] = []
                                block_kinds.extend(kinds)
                                block_details.extend(details)
                                block_borrow_names.extend(borrow_names)
                                block_borrow_fields.extend(borrow_fields)
                                block_borrow_owners.extend(borrow_owners)
                                if block_binding != "":
                                    bam_clear_borrow_fields(block_binding, block_borrow_names, block_borrow_fields, block_borrow_owners)
                                    bam_append_scope_local(block_exits.active_locals, block_binding) if not block_scoped
                                table <- bam_statements(block_body, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, block_borrow_names, block_borrow_fields, block_borrow_owners, block_kinds, block_details, block_flow, block_exits, table)
                                bam_filter_borrow_state_locals(block_exits.active_locals, block_locals, block_borrow_names, block_borrow_fields, block_borrow_owners, block_base_names, block_base_fields, block_base_owners) if block_scoped
                                bam_filter_loop_exit_paths(block_exits, block_locals, block_base_names, block_base_fields, block_base_owners) if block_scoped
                                if block_scoped:
                                    bam_merge_loop_exit_states(loop_exits, block_exits)
                                else:
                                    bam_merge_unscoped_loop_exit_paths(loop_exits, block_exits)
                                if not block_flow[0]:
                                    bam_merge(kinds, details, block_kinds, block_details)
                                    bam_merge_borrow_state(borrow_names, borrow_fields, borrow_owners, block_borrow_names, block_borrow_fields, block_borrow_owners)
                                    if not block_scoped:
                                        for local in block_exits.active_locals |loop_exits|:
                                            bam_append_scope_local(loop_exits.active_locals, local)
                                        bam_append_scope_local(loop_exits.active_locals, block_binding)
                        _:
                            pass

        # A by-value binding of a borrowable owner: `o: K`, `o: mutable K`, or a parameter.
        def bam_owner_type_name(annotation: Ast::Expr, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                named: sview = affine_type_head(rvc_value_type(annotation), table)
                return named if struct_is_borrowable_owner(table, named)
                return ""

        # An untyped `o = K{...}` binds an owner too.
        def bam_construct_owner_type(value: Ast::Expr, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Construct(construct_head, construct_fields, construct_pos):
                        constructed: sview = ident_name_of(construct_head)
                        return constructed if struct_is_borrowable_owner(table, constructed)
                        return ""
                    _:
                        return ""

        def bam_collect_owners(statements: darray[Ast::Stmt], binders: BorrowBinders&, table: SymbolTable&, out: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.VarDecl(declared_name, declared_type, declared_value, declared_pos):
                            declared_owner: bool = bam_owner_type_name(declared_type, table) != "" or (rvc_is_absent(declared_type) and bam_construct_owner_type(declared_value, table) != "")
                            out.push(declared_name) if declared_owner and binders_bound_once(binders, declared_name)
                        Stmt.Assign(assign_target, assign_operator, assign_value, assign_pos):
                            assign_name: sview = ident_name_of(assign_target)
                            binds_owner: bool = assign_operator != TokenKind.LArrow and bam_construct_owner_type(assign_value, table) != ""
                            out.push(assign_name) if binds_owner and binders_bound_once(binders, assign_name)
                        Stmt.If(branch_condition, branch_then, branch_else, branch_pos):
                            bam_collect_owners(branch_then, binders, table, out)
                            bam_collect_owners(branch_else, binders, table, out)
                        Stmt.While(loop_condition, loop_body, loop_pos):
                            bam_collect_owners(loop_body, binders, table, out)
                        Stmt.For(for_bind, for_variables, for_iterable, for_body, for_pos):
                            bam_collect_owners(for_body, binders, table, out)
                        Stmt.Block(block_kind, block_clause, block_binding, block_body, block_pos):
                            bam_collect_owners(block_body, binders, table, out)
                        Stmt.Match(match_scrutinee, match_arms, match_pos):
                            for match_arm in match_arms |out|:
                                bam_collect_owners(match_arm.body, binders, table, out)
                        _:
                            pass

        # `return &x` / `return &x.field` where `x` is a local: the frame dies at the return.
        # stage0's checkBorrowEscapesLocal; a parameter's storage belongs to the caller, so only
        # locals are reported.
        def bam_place_root(place: Ast::Expr) -> sview:
            can Memory.Allocate, Abort.Panic:
                match place:
                    Expr.Ident(rooted_name, rooted_pos):
                        return rooted_name
                    Expr.Field(rooted_object, rooted_field, rooted_field_pos):
                        return bam_place_root(rooted_object)
                    Expr.Paren(rooted_inner, rooted_paren_pos):
                        return bam_place_root(rooted_inner)
                    # `xs[i]` is interior storage of `xs`, so a borrow of it is a borrow of
                    # the container -- stage0 reports `return &xs[0]` on a local array.
                    Expr.Index(rooted_indexed, _, _) | Expr.IndexN(rooted_indexed, _, _):
                        return bam_place_root(rooted_indexed)
                    _:
                        return ""

        # Preserve the identifier occurrence along with its spelling. Callable/global
        # effect summaries must distinguish a file global from a same-named local in
        # another lexical scope.
        def bam_place_root_position(place: Ast::Expr) -> (known: bool, position: Ast::Pos):
            can Abort.Panic:
                match place:
                    Expr.Ident(_, rooted_pos):
                        return (true, rooted_pos)
                    Expr.Field(rooted_object, _, _) | Expr.Paren(rooted_object, _) | Expr.Index(rooted_object, _, _) | Expr.IndexN(rooted_object, _, _):
                        return bam_place_root_position(rooted_object)
                    _:
                        return (false, Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0})

        def bam_collect_local_pattern(pattern: Ast::Pattern, binders: BorrowBinders&, out: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(name) | Pattern.TypeBind(_, name):
                        out.push(name) if binders_bound_once(binders, name)
                    Pattern.Rest(name):
                        out.push(name) if name != "" and binders_bound_once(binders, name)
                    Pattern.As(name, inner):
                        out.push(name) if binders_bound_once(binders, name)
                        for child in inner:
                            bam_collect_local_pattern(child, binders, out)
                    Pattern.Variant(_, children) | Pattern.Struct(_, children) | Pattern.Field(_, children) | Pattern.Tuple(children) | Pattern.Or(children):
                        for child in children:
                            bam_collect_local_pattern(child, binders, out)
                    # Pins reference an existing name; they introduce no local binding.
                    _:
                        pass
