extend Semantic:
    private:
        def bam_expression_larrow_rhs(value: Ast::Expr, owners: darray[sview @source]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, binders: BorrowBinders&, borrow_names: mutable darray[sview @source]&, borrow_fields: mutable darray[sview @source]&, borrow_owners: mutable darray[sview @source]&, kinds: mutable darray[u32]&, details: mutable darray[sview @source]&, flow: mutable darray[bool]&, loop_exits: mutable BorrowLoopExitState&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                source_value: mutable Ast::Expr = value
                while source_value is Expr.Paren(inner_value, _) |source_value|:
                    source_value <- inner_value
                match source_value:
                    Expr.Array(elements, _) | Expr.Tuple(elements, _):
                        for element in elements |owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, kinds, details, flow, loop_exits, table|:
                            continue if flow[0]
                            move_owner: sview = bam_moved_owner(element, owners)
                            if move_owner != "":
                                bam_set_consumed(owners, kinds, details, move_owner, 3, "")
                            else:
                                table <- bam_expression_larrow_rhs(element, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, kinds, details, flow, loop_exits, table)
                    Expr.If(condition, then_value, else_value, _):
                        table <- bam_expression_larrow_rhs(condition, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, kinds, details, flow, loop_exits, table)
                        if not flow[0]:
                            then_kinds: mutable darray[u32] = []
                            then_details: mutable darray[sview @source] = []
                            then_names: mutable darray[sview @source] = []
                            then_fields: mutable darray[sview @source] = []
                            then_owners: mutable darray[sview @source] = []
                            else_kinds: mutable darray[u32] = []
                            else_details: mutable darray[sview @source] = []
                            else_names: mutable darray[sview @source] = []
                            else_fields: mutable darray[sview @source] = []
                            else_owners: mutable darray[sview @source] = []
                            then_kinds.extend(kinds)
                            then_details.extend(details)
                            then_names.extend(borrow_names)
                            then_fields.extend(borrow_fields)
                            then_owners.extend(borrow_owners)
                            else_kinds.extend(kinds)
                            else_details.extend(details)
                            else_names.extend(borrow_names)
                            else_fields.extend(borrow_fields)
                            else_owners.extend(borrow_owners)
                            then_flow: mutable darray[bool] = [false]
                            else_flow: mutable darray[bool] = [false]
                            then_exits: mutable BorrowLoopExitState = BorrowLoopExitState{}
                            else_exits: mutable BorrowLoopExitState = BorrowLoopExitState{}
                            table <- bam_expression_larrow_rhs(then_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, then_names, then_fields, then_owners, then_kinds, then_details, then_flow, then_exits, table)
                            table <- bam_expression_larrow_rhs(else_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, else_names, else_fields, else_owners, else_kinds, else_details, else_flow, else_exits, table)
                            bam_merge_loop_exit_states(loop_exits, then_exits)
                            bam_merge_loop_exit_states(loop_exits, else_exits)
                            bam_merge(kinds, details, then_kinds, then_details) if not then_flow[0]
                            bam_merge(kinds, details, else_kinds, else_details) if not else_flow[0]
                            if not then_flow[0] and not else_flow[0]:
                                bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, then_names, then_fields, then_owners)
                                bam_merge_borrow_state(borrow_names, borrow_fields, borrow_owners, else_names, else_fields, else_owners)
                            elif not then_flow[0]:
                                bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, then_names, then_fields, then_owners)
                            elif not else_flow[0]:
                                bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, else_names, else_fields, else_owners)
                            flow[0] <- true if then_flow[0] and else_flow[0]
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        pattern_base_names: mutable darray[sview @source] = []
                        pattern_base_fields: mutable darray[sview @source] = []
                        pattern_base_owners: mutable darray[sview @source] = []
                        pattern_base_names.extend(borrow_names)
                        pattern_base_fields.extend(borrow_fields)
                        pattern_base_owners.extend(borrow_owners)
                        table <- bam_expression_larrow_rhs(scrutinee, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, kinds, details, flow, loop_exits, table)
                        if not flow[0]:
                            merged_kinds: mutable darray[u32] = []
                            merged_details: mutable darray[sview @source] = []
                            merged_names: mutable darray[sview @source] = []
                            merged_fields: mutable darray[sview @source] = []
                            merged_owners: mutable darray[sview @source] = []
                            merged_kinds.extend(kinds)
                            merged_details.extend(details)
                            merged_names.extend(borrow_names)
                            merged_fields.extend(borrow_fields)
                            merged_owners.extend(borrow_owners)
                            residual_kinds: mutable darray[u32] = []
                            residual_details: mutable darray[sview @source] = []
                            residual_names: mutable darray[sview @source] = []
                            residual_fields: mutable darray[sview @source] = []
                            residual_owners: mutable darray[sview @source] = []
                            residual_kinds.extend(kinds)
                            residual_details.extend(details)
                            residual_names.extend(borrow_names)
                            residual_fields.extend(borrow_fields)
                            residual_owners.extend(borrow_owners)
                            residual_possible: mutable bool = true
                            pattern_owners: mutable darray[sview @source] = []
                            pattern_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            pattern_names: mutable darray[sview @source] = []
                            pattern_fields: mutable darray[sview @source] = []
                            pattern_owners_state: mutable darray[sview @source] = []
                            pattern_names.extend(pattern_base_names)
                            pattern_fields.extend(pattern_base_fields)
                            pattern_owners_state.extend(pattern_base_owners)
                            table <- bam_nested_value_owners_scoped(scrutinee, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, pattern_names, pattern_fields, pattern_owners_state, pattern_owners, pattern_flow, table)
                            has_normal_arm: mutable bool = false
                            for arm in arms |owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, kinds, details, flow, loop_exits, merged_kinds, merged_details, merged_names, merged_fields, merged_owners, residual_kinds, residual_details, residual_names, residual_fields, residual_owners, residual_possible, has_normal_arm, table|:
                                break if not residual_possible
                                arm_kinds: mutable darray[u32] = []
                                arm_details: mutable darray[sview @source] = []
                                arm_names: mutable darray[sview @source] = []
                                arm_fields: mutable darray[sview @source] = []
                                arm_owners: mutable darray[sview @source] = []
                                arm_base_names: mutable darray[sview @source] = []
                                arm_base_fields: mutable darray[sview @source] = []
                                arm_base_owners: mutable darray[sview @source] = []
                                arm_flow: mutable darray[bool] = [false]
                                arm_exits: mutable BorrowLoopExitState = BorrowLoopExitState{}
                                guard_exits: mutable BorrowLoopExitState = BorrowLoopExitState{}
                                arm_kinds.extend(residual_kinds)
                                arm_details.extend(residual_details)
                                arm_names.extend(residual_names)
                                arm_fields.extend(residual_fields)
                                arm_owners.extend(residual_owners)
                                arm_base_names.extend(residual_names)
                                arm_base_fields.extend(residual_fields)
                                arm_base_owners.extend(residual_owners)
                                table <- bam_seed_pattern_borrow_state(arm.pattern, scrutinee, pattern_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, arm_names, arm_fields, arm_owners, table)
                                has_guard: bool = match arm.guard:
                                    Expr.Invalid | Expr.Absent: false
                                    _: true
                                arm_catches_all: bool = bam_match_pattern_catches_all(arm.pattern, table)
                                arm_local_names: mutable darray[sview @source] = []
                                bam_collect_rhs_pattern_locals(arm.pattern, arm_local_names)
                                if has_guard:
                                    guard_exits.active_locals.extend(arm_local_names)
                                    table <- bam_expression_larrow_rhs(arm.guard, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, arm_names, arm_fields, arm_owners, arm_kinds, arm_details, arm_flow, guard_exits, table)
                                    bam_filter_loop_exit_paths(guard_exits, arm_local_names, arm_base_names, arm_base_fields, arm_base_owners)
                                    bam_restore_pattern_borrow_state(arm.pattern, guard_exits.continue_names, guard_exits.continue_fields, guard_exits.continue_owners, arm_base_names, arm_base_fields, arm_base_owners) if guard_exits.continue_seen
                                    bam_restore_pattern_borrow_state(arm.pattern, guard_exits.names, guard_exits.fields, guard_exits.owners, arm_base_names, arm_base_fields, arm_base_owners) if guard_exits.seen
                                if has_guard and not arm_flow[0]:
                                    failed_names: mutable darray[sview @source] = []
                                    failed_fields: mutable darray[sview @source] = []
                                    failed_owners: mutable darray[sview @source] = []
                                    failed_names.extend(arm_names)
                                    failed_fields.extend(arm_fields)
                                    failed_owners.extend(arm_owners)
                                    bam_restore_pattern_borrow_state(arm.pattern, failed_names, failed_fields, failed_owners, arm_base_names, arm_base_fields, arm_base_owners)
                                    if arm_catches_all:
                                        residual_kinds.truncate(0)
                                        residual_details.truncate(0)
                                        residual_names.truncate(0)
                                        residual_fields.truncate(0)
                                        residual_owners.truncate(0)
                                        residual_kinds.extend(arm_kinds)
                                        residual_details.extend(arm_details)
                                        residual_names.extend(failed_names)
                                        residual_fields.extend(failed_fields)
                                        residual_owners.extend(failed_owners)
                                    else:
                                        bam_merge(residual_kinds, residual_details, arm_kinds, arm_details)
                                        bam_merge_borrow_state(residual_names, residual_fields, residual_owners, failed_names, failed_fields, failed_owners)
                                elif arm_catches_all:
                                    residual_possible <- false
                                tail_count: mutable usize = arm.body.count
                                tail_value: mutable Ast::Expr = Ast::Expr.Invalid
                                tail_return: mutable bool = false
                                if arm.body.count > 0:
                                    match arm.body[arm.body.count - 1]:
                                        Stmt.Expr(arm_value, _):
                                            tail_count <- tail_count - 1
                                            tail_value <- arm_value
                                        Stmt.Return(arm_return_option, _):
                                            if arm_return_option is arm_return_value:
                                                tail_count <- tail_count - 1
                                                tail_value <- arm_return_value
                                                tail_return <- true
                                        _:
                                            pass
                                arm_body: darray[Ast::Stmt] = arm.body
                                arm_prefix: mutable darray[Ast::Stmt] = []
                                for prefix_index in 0..<tail_count |prefix_index, arm_body, arm_prefix|:
                                    arm_prefix.push(arm_body[prefix_index])
                                table <- bam_statements(arm_prefix, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, arm_names, arm_fields, arm_owners, arm_kinds, arm_details, arm_flow, arm_exits, table) if not arm_flow[0]
                                table <- bam_expression_larrow_rhs(tail_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, arm_names, arm_fields, arm_owners, arm_kinds, arm_details, arm_flow, arm_exits, table) if not arm_flow[0] and not (tail_value is Expr.Invalid)
                                arm_flow[0] <- true if tail_return and not arm_flow[0]
                                bam_filter_borrow_state_locals(arm_exits.active_locals, arm_local_names, arm_names, arm_fields, arm_owners, arm_base_names, arm_base_fields, arm_base_owners)
                                bam_filter_loop_exit_paths(arm_exits, arm_local_names, arm_base_names, arm_base_fields, arm_base_owners)
                                bam_merge_loop_exit_states(loop_exits, guard_exits)
                                bam_merge_loop_exit_states(loop_exits, arm_exits)
                                if not arm_flow[0]:
                                    bam_merge(merged_kinds, merged_details, arm_kinds, arm_details)
                                    if not has_normal_arm:
                                        bam_replace_borrow_state(merged_names, merged_fields, merged_owners, arm_names, arm_fields, arm_owners)
                                        has_normal_arm <- true
                                    else:
                                        bam_merge_borrow_state(merged_names, merged_fields, merged_owners, arm_names, arm_fields, arm_owners)
                            residual_possible <- false if match_arms_exhaustive(arms, table)
                            if has_normal_arm:
                                bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, merged_names, merged_fields, merged_owners)
                                kinds.truncate(0)
                                kinds.extend(merged_kinds)
                                details.truncate(0)
                                details.extend(merged_details)
                                if residual_possible:
                                    bam_merge(kinds, details, residual_kinds, residual_details)
                                    bam_merge_borrow_state(borrow_names, borrow_fields, borrow_owners, residual_names, residual_fields, residual_owners)
                            elif residual_possible:
                                bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, residual_names, residual_fields, residual_owners)
                                bam_merge(kinds, details, residual_kinds, residual_details)
                            else:
                                flow[0] <- true if arms.count > 0
                    Expr.GetElse(guarded, recovery, _):
                        guarded_kinds: mutable darray[u32] = []
                        guarded_details: mutable darray[sview @source] = []
                        guarded_names: mutable darray[sview @source] = []
                        guarded_fields: mutable darray[sview @source] = []
                        guarded_owners: mutable darray[sview @source] = []
                        recovery_kinds: mutable darray[u32] = []
                        recovery_details: mutable darray[sview @source] = []
                        recovery_names: mutable darray[sview @source] = []
                        recovery_fields: mutable darray[sview @source] = []
                        recovery_owners: mutable darray[sview @source] = []
                        guarded_flow: mutable darray[bool] = [false]
                        recovery_flow: mutable darray[bool] = [false]
                        guarded_exits: mutable BorrowLoopExitState = BorrowLoopExitState{}
                        recovery_exits: mutable BorrowLoopExitState = BorrowLoopExitState{}
                        guarded_kinds.extend(kinds)
                        guarded_details.extend(details)
                        guarded_names.extend(borrow_names)
                        guarded_fields.extend(borrow_fields)
                        guarded_owners.extend(borrow_owners)
                        table <- bam_expression_larrow_rhs(guarded, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, guarded_names, guarded_fields, guarded_owners, guarded_kinds, guarded_details, guarded_flow, guarded_exits, table)
                        recovery_kinds.extend(guarded_kinds)
                        recovery_details.extend(guarded_details)
                        recovery_names.extend(guarded_names)
                        recovery_fields.extend(guarded_fields)
                        recovery_owners.extend(guarded_owners)
                        recovery_count: mutable usize = recovery.count
                        recovery_value: mutable Ast::Expr = Ast::Expr.Invalid
                        recovery_return: mutable bool = false
                        if recovery.count > 0:
                            match recovery[recovery.count - 1]:
                                Stmt.Expr(recovery_tail, _):
                                    recovery_count <- recovery_count - 1
                                    recovery_value <- recovery_tail
                                Stmt.Return(recovery_option, _):
                                    if recovery_option is recovery_return_value:
                                        recovery_count <- recovery_count - 1
                                        recovery_value <- recovery_return_value
                                        recovery_return <- true
                                _:
                                    pass
                        recovery_prefix: mutable darray[Ast::Stmt] = []
                        for prefix_index in 0..<recovery_count |prefix_index, recovery, recovery_prefix|:
                            recovery_prefix.push(recovery[prefix_index])
                        table <- bam_statements(recovery_prefix, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, recovery_names, recovery_fields, recovery_owners, recovery_kinds, recovery_details, recovery_flow, recovery_exits, table) if not guarded_flow[0]
                        table <- bam_expression_larrow_rhs(recovery_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, recovery_names, recovery_fields, recovery_owners, recovery_kinds, recovery_details, recovery_flow, recovery_exits, table) if not guarded_flow[0] and not recovery_flow[0] and not (recovery_value is Expr.Invalid)
                        recovery_flow[0] <- true if not guarded_flow[0] and recovery_return and not recovery_flow[0]
                        no_extra_locals_1: darray[sview @source] = []
                        bam_filter_borrow_state_locals(recovery_exits.active_locals, no_extra_locals_1, recovery_names, recovery_fields, recovery_owners, guarded_names, guarded_fields, guarded_owners) if not guarded_flow[0]
                        no_extra_locals_2: darray[sview @source] = []
                        bam_filter_loop_exit_paths(recovery_exits, no_extra_locals_2, guarded_names, guarded_fields, guarded_owners) if not guarded_flow[0]
                        bam_merge_loop_exit_states(loop_exits, guarded_exits)
                        bam_merge_loop_exit_states(loop_exits, recovery_exits) if not guarded_flow[0]
                        if not guarded_flow[0] and not recovery_flow[0]:
                            bam_merge(kinds, details, guarded_kinds, guarded_details)
                            bam_merge(kinds, details, recovery_kinds, recovery_details)
                            bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, guarded_names, guarded_fields, guarded_owners)
                            bam_merge_borrow_state(borrow_names, borrow_fields, borrow_owners, recovery_names, recovery_fields, recovery_owners)
                        elif not guarded_flow[0]:
                            bam_merge(kinds, details, guarded_kinds, guarded_details)
                            bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, guarded_names, guarded_fields, guarded_owners)
                        elif not recovery_flow[0]:
                            bam_merge(kinds, details, recovery_kinds, recovery_details)
                            bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, recovery_names, recovery_fields, recovery_owners)
                        flow[0] <- true if guarded_flow[0] and recovery_flow[0]
                    Expr.Block(block_statements, block_value, _, _):
                        # Evaluate block statements once with the full move/use checker. Keep
                        # borrow aliases scoped for the yielded expression; staged provenance
                        # replay later uses bam_scope_borrow_statements and does not consume
                        # moves or emit diagnostics a second time.
                        scoped_names: mutable darray[sview @source] = []
                        scoped_fields: mutable darray[sview @source] = []
                        scoped_owners: mutable darray[sview @source] = []
                        block_base_names: mutable darray[sview @source] = []
                        block_base_fields: mutable darray[sview @source] = []
                        block_base_owners: mutable darray[sview @source] = []
                        block_exits: mutable BorrowLoopExitState = BorrowLoopExitState{}
                        block_base_names.extend(borrow_names)
                        block_base_fields.extend(borrow_fields)
                        block_base_owners.extend(borrow_owners)
                        scoped_names.extend(borrow_names)
                        scoped_fields.extend(borrow_fields)
                        scoped_owners.extend(borrow_owners)
                        table <- bam_statements(block_statements, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, scoped_names, scoped_fields, scoped_owners, kinds, details, flow, block_exits, table)
                        table <- bam_expression_larrow_rhs(block_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, scoped_names, scoped_fields, scoped_owners, kinds, details, flow, block_exits, table) if not flow[0]
                        no_extra_locals_3: darray[sview @source] = []
                        bam_filter_loop_exit_paths(block_exits, no_extra_locals_3, block_base_names, block_base_fields, block_base_owners)
                        if not flow[0]:
                            no_extra_locals_4: darray[sview @source] = []
                            bam_filter_borrow_state_locals(block_exits.active_locals, no_extra_locals_4, scoped_names, scoped_fields, scoped_owners, block_base_names, block_base_fields, block_base_owners)
                            bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, scoped_names, scoped_fields, scoped_owners)
                        bam_merge_loop_exit_states(loop_exits, block_exits)
                    _:
                        move_owner: sview = bam_moved_owner(source_value, owners)
                        if move_owner != "":
                            bam_set_consumed(owners, kinds, details, move_owner, 3, "")
                        else:
                            table <- bam_expression(source_value, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)

        def bam_stage_larrow_pair(target: Ast::Expr, value: Ast::Expr, owners: darray[sview @source]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, binders: BorrowBinders&, borrow_names: mutable darray[sview @source]&, borrow_fields: mutable darray[sview @source]&, borrow_owners: mutable darray[sview @source]&, entries: mutable darray[BorrowLarrowEntry] @source, flow: mutable BorrowReplayFlow&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                bam_replay_flow_reset(flow)
                source_value: mutable Ast::Expr = value
                while source_value is Expr.Paren(inner_value, _) |source_value|:
                    source_value <- inner_value
                match source_value:
                    Expr.Block(block_statements, block_value, _, _):
                        base_names: mutable darray[sview @source] = []
                        base_fields: mutable darray[sview @source] = []
                        base_owners: mutable darray[sview @source] = []
                        scoped_names: mutable darray[sview @source] = []
                        scoped_fields: mutable darray[sview @source] = []
                        scoped_owners: mutable darray[sview @source] = []
                        base_names.extend(borrow_names)
                        base_fields.extend(borrow_fields)
                        base_owners.extend(borrow_owners)
                        scoped_names.extend(borrow_names)
                        scoped_fields.extend(borrow_fields)
                        scoped_owners.extend(borrow_owners)
                        block_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                        table <- bam_scope_borrow_statements(block_statements, block_statements.count, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, scoped_names, scoped_fields, scoped_owners, block_flow, table)
                        block_locals: mutable darray[sview @source] = []
                        bam_collect_rhs_scope_stmt_locals(block_statements, binders, block_locals)
                        bam_replay_flow_merge_exits(flow, block_flow)
                        if block_flow.normal_seen:
                            value_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            table <- bam_stage_larrow_pair(target, block_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, scoped_names, scoped_fields, scoped_owners, entries, value_flow, table)
                            bam_replay_flow_filter_exits_scope(value_flow, [], block_locals, binders, base_names, base_fields, base_owners)
                            bam_replay_flow_merge_exits(flow, value_flow)
                            if value_flow.normal_seen:
                                no_extra_locals_5: darray[sview @source] = []
                                bam_filter_rhs_scope_borrow_state(block_statements, no_extra_locals_5, binders, scoped_names, scoped_fields, scoped_owners, base_names, base_fields, base_owners)
                                bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, scoped_names, scoped_fields, scoped_owners)
                                bam_replay_flow_set_normal(flow, borrow_names, borrow_fields, borrow_owners)
                        no_extra_locals_6: darray[sview @source] = []
                        bam_replay_flow_filter_normal_scope(flow, block_statements, no_extra_locals_6, binders, base_names, base_fields, base_owners)
                        return
                    _:
                        pass
                match target:
                    Expr.Paren(inner_target, _):
                        table <- bam_stage_larrow_pair(inner_target, source_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, entries, flow, table)
                    Expr.Array(targets, _):
                        matched_values: mutable darray[Ast::Expr] = []
                        match source_value:
                            Expr.Array(values, _) | Expr.Tuple(values, _):
                                if values.count == targets.count:
                                    matched_values.extend(values)
                            _:
                                pass
                        if matched_values.count == targets.count:
                            reachable: mutable bool = true
                            aggregate_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            for index in 0..<targets.count |index, reachable, targets, matched_values, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, entries, aggregate_flow, table|:
                                continue if not reachable
                                item_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                                table <- bam_stage_larrow_pair(targets[index], matched_values[index], owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, entries, item_flow, table)
                                bam_replay_flow_merge_exits(aggregate_flow, item_flow)
                                reachable <- item_flow.normal_seen
                            bam_replay_flow_reset(flow)
                            bam_replay_flow_merge_exits(flow, aggregate_flow)
                            bam_replay_flow_set_normal(flow, borrow_names, borrow_fields, borrow_owners) if reachable
                        else:
                            fallback_owners: mutable darray[sview @source] = []
                            table <- bam_nested_value_owners_scoped(source_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, fallback_owners, flow, table)
                            if flow.normal_seen:
                                for target_item in targets |fallback_owners, entries, table|:
                                    table <- bam_stage_larrow_fallback(target_item, fallback_owners, entries, table)
                    _:
                        entry: mutable BorrowLarrowEntry = BorrowLarrowEntry{target: target, value: source_value}
                        table <- bam_nested_value_owners_scoped(source_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, entry.owners, flow, table)
                        if flow.normal_seen:
                            if not bam_expr_has_scoped_flow(source_value):
                                table <- bam_bind_value_fields(ident_name_of(target), "", source_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, borrow_names, borrow_fields, borrow_owners, entry.field_names, entry.field_fields, entry.field_owners, table) if target is Expr.Ident(_, _)
                            else:
                                destination_name: sview = ident_name_of(target)
                                if destination_name != "":
                                    for owner in entry.owners |entry, destination_name|:
                                        entry.field_names.push(destination_name)
                                        entry.field_fields.push("*")
                                        entry.field_owners.push(owner)
                            entry.move_owner <- bam_moved_owner(source_value, owners)
                            entries.push(entry)

        # A shape mismatch has no trustworthy positional mapping. Apply its aggregate owner
        # union to each leaf, while retaining independent per-leaf assignment effect lookups.
        def bam_stage_larrow_fallback(target: Ast::Expr, rebound_owners: darray[sview @source]&, entries: mutable darray[BorrowLarrowEntry] @source, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match target:
                    Expr.Paren(inner_target, _):
                        table <- bam_stage_larrow_fallback(inner_target, rebound_owners, entries, table)
                    Expr.Array(targets, _):
                        for target_item in targets |rebound_owners, entries, table|:
                            table <- bam_stage_larrow_fallback(target_item, rebound_owners, entries, table)
                    _:
                        entry: mutable BorrowLarrowEntry = BorrowLarrowEntry{target: target, value: Ast::Expr.Invalid}
                        entry.owners.extend(rebound_owners)
                        match target:
                            Expr.Ident(target_name, _):
                                for rebound_owner in rebound_owners |entry, target_name|:
                                    entry.field_names.push(target_name)
                                    entry.field_fields.push("*")
                                    entry.field_owners.push(rebound_owner)
                            _:
                                pass
                        entries.push(entry)

        # The owner a `move o` names, else "".
        def bam_moved_owner(value: Ast::Expr, owners: darray[sview @source]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Move(moved_operand, moved_pos):
                        moved_name: sview = ident_name_of(moved_operand)
                        return moved_name if bam_is_owner(owners, moved_name)
                        return ""
                    _:
                        return ""

        # `r = lend(&o)`: source summaries identify which reference arguments may flow into a
        # returned reference-bearing value; an extern uses its explicit borrow-return contract.
        def bam_definition_target(pos: Ast::Pos, index: BorrowResolvedCallTargets&) -> DeclId:
            can Abort.Panic:
                return DeclId{value: 4294967295} if index.slots.count == 0
                hash: u64 = bam_definition_reference_hash(pos)
                capacity: usize = index.slots.count
                slot: mutable usize = hash.usize() & (capacity - 1)
                while index.slots[slot] != 0 |slot, index, pos, capacity|:
                    row: usize = (index.slots[slot] - 1).usize()
                    reference_pos: Ast::Pos = index.positions[row]
                    if reference_pos.offset == pos.offset and reference_pos.end_offset == pos.end_offset:
                        return DeclId{value: 4294967295} if index.ambiguous[row]
                        return index.declaration_ids[row]
                    slot <- (slot + 1) & (capacity - 1)
                return DeclId{value: 4294967295}

        def bam_direct_callee_target(callee: Ast::Expr, index: BorrowResolvedCallTargets&) -> DeclId:
            can Abort.Panic:
                match callee:
                    Expr.Ident(_, callee_pos):
                        return bam_definition_target(callee_pos, index)
                    _:
                        return DeclId{value: 4294967295}

        # Map the annotated extern formal to exactly one call argument. Named arguments use
        # the formal spelling; positional arguments use the formal slot. Malformed or duplicate
        # mappings are left unknown, so invalid calls cannot redirect a borrow to another owner.
        def bam_lender_argument_index(argument_count: usize, argument_names: darray[sview]&, formal_position: usize, formal_name: sview) -> i64:
            can Abort.Panic:
                matched: mutable i64 = -1
                positional_position: mutable usize = 0
                saw_named: mutable bool = false
                argument_index: mutable usize = 0
                while argument_index < argument_count |matched, positional_position, saw_named, argument_index|:
                    argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                    if argument_name != "":
                        saw_named <- true
                        if argument_name == formal_name:
                            return -1 if matched >= 0
                            matched <- argument_index.i64()
                    else:
                        return -1 if saw_named
                        if positional_position == formal_position:
                            return -1 if matched >= 0
                            matched <- argument_index.i64()
                        positional_position <- positional_position + 1
                    argument_index <- argument_index + 1
                return matched

        def bam_extern_lend_owners(value: Ast::Expr, owners: darray[sview @source]&, borrow_names: darray[sview @source]&, borrow_fields: darray[sview @source]&, borrow_owners: darray[sview @source]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, out: mutable darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Call(callee, arguments, argument_names, _):
                        target: DeclId = bam_direct_callee_target(callee, call_targets)
                        return if target.value == 4294967295
                        lender_slot: mutable usize = extern_lend_ids.count
                        for index in 0..<extern_lend_ids.count |lender_slot, target, extern_lend_ids|:
                            if extern_lend_ids[index].value == target.value:
                                return if lender_slot < extern_lend_ids.count
                                lender_slot <- index
                        return if lender_slot >= extern_lend_ids.count or lender_slot >= extern_lend_positions.count or lender_slot >= extern_lend_names.count
                        argument_index: i64 = bam_lender_argument_index(arguments.count, argument_names, extern_lend_positions[lender_slot], extern_lend_names[lender_slot])
                        return if argument_index < 0 or argument_index.usize() >= arguments.count
                        table <- bam_value_owners(arguments[argument_index.usize()], owners, borrow_names, borrow_fields, borrow_owners, out, table)
                    _:
                        pass

        def bam_lend_owners(value: Ast::Expr, owners: darray[sview @source]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, borrow_names: darray[sview @source]&, borrow_fields: darray[sview @source]&, borrow_owners: darray[sview @source]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, out: mutable darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Call(Expr.Ident(callee_name, callee_pos), lend_arguments, lend_labels, _):
                        target: DeclId = bam_definition_target(callee_pos, call_targets)
                        found_source_summary: mutable bool = false
                        if target.value != 4294967295:
                            for slot in 0..<lend_names.count |found_source_summary, target, callee_name, lend_names, lend_positions, lend_parameter_names, out|:
                                continue if lend_names[slot] != callee_name or slot >= lend_positions.count or slot >= lend_parameter_names.count
                                argument_index: i64 = bam_lender_argument_index(lend_arguments.count, lend_labels, lend_positions[slot], lend_parameter_names[slot])
                                if argument_index >= 0 and argument_index.usize() < lend_arguments.count:
                                    table <- bam_value_owners(lend_arguments[argument_index.usize()], owners, borrow_names, borrow_fields, borrow_owners, out, table)
                                    found_source_summary <- true
                        return if found_source_summary
                        table <- bam_extern_lend_owners(value, owners, borrow_names, borrow_fields, borrow_owners, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.Call(_, _, _, _):
                        pass
                    _:
                        pass

        def bam_report_slot_use(name: sview @source, field: sview, include_wildcard: bool, pos: Ast::Pos, owners: darray[sview @source]&, borrow_names: darray[sview @source]&, borrow_fields: darray[sview @source]&, borrow_owners: darray[sview @source]&, kinds: darray[u32]&, details: darray[sview @source]&, table: lmut SymbolTable) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if name == ""
                exact_recorded: bool = bam_borrow_slot_recorded(borrow_names, borrow_fields, name, field)
                active_owners: mutable darray[sview @source] = []
                if exact_recorded:
                    _ = bam_borrow_exact_owners(borrow_names, borrow_fields, borrow_owners, name, field, active_owners)
                    if active_owners.count == 0 and field == "" and include_wildcard:
                        _ = bam_borrow_exact_owners(borrow_names, borrow_fields, borrow_owners, name, "*", active_owners)
                elif include_wildcard:
                    bam_borrow_owners(borrow_names, borrow_fields, borrow_owners, name, field, active_owners)
                for borrowed_owner in active_owners |table, owners, kinds, details, name, field, pos|:
                    owner_slot: usize = bam_index_of(owners, borrowed_owner)
                    if owner_slot < owners.count and kinds[owner_slot] != 0:
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.BorrowUseAfterOwnerMove, name: name, pos: pos, line: pos.line, expected: details[owner_slot], actual: "", detail: field, expected_count: kinds[owner_slot]})
                        return true
                return false

        def bam_report_use(name: sview @source, field: sview, pos: Ast::Pos, owners: darray[sview @source]&, borrow_names: darray[sview @source]&, borrow_fields: darray[sview @source]&, borrow_owners: darray[sview @source]&, kinds: darray[u32]&, details: darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                rebind slot_reported: bool, table = bam_report_slot_use(name, field, true, pos, owners, borrow_names, borrow_fields, borrow_owners, kinds, details, table)
                return if slot_reported
                closed_fields: mutable darray[sview @source] = []
                probe: mutable usize = borrow_names.count
                while probe > 0 |probe, closed_fields, table, owners, kinds, details, borrow_names, borrow_fields, borrow_owners, name, field, pos|:
                    probe <- probe - 1
                    continue if borrow_names[probe] != name or probe >= borrow_fields.count
                    current_field: sview = borrow_fields[probe]
                    continue if current_field == "" or current_field == "*" or (field != "" and (current_field == field or not bam_field_path_within(current_field, field)))
                    field_closed: mutable bool = false
                    for closed_field in closed_fields |field_closed, current_field, closed_fields|:
                        field_closed <- true if closed_field == current_field
                    continue if field_closed
                    if probe >= borrow_owners.count or borrow_owners[probe] == "":
                        closed_fields.push(current_field)
                    else:
                        owner_slot: usize = bam_index_of(owners, borrow_owners[probe])
                        if owner_slot < owners.count and kinds[owner_slot] != 0:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.BorrowUseAfterOwnerMove, name: name, pos: pos, line: pos.line, expected: details[owner_slot], actual: "", detail: current_field, expected_count: kinds[owner_slot]})
                            return
