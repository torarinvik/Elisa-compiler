extend Semantic:
    private:
        def bam_store_capture_expression(expression: Ast::Expr, out: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        out.push(name) if name != ""
                    Expr.Call(callee, arguments, _, _):
                        bam_store_capture_expression(callee, out)
                        for argument in arguments |out|:
                            bam_store_capture_expression(argument, out)
                    Expr.StaticEffectCall(effect_type: effect_type, candidates: candidates, arguments: arguments, _):
                        bam_store_capture_expression(effect_type, out)
                        for candidate in candidates |out|:
                            for capture in candidate.captures |out|:
                                bam_store_capture_expression(capture, out)
                        for argument in arguments |out|:
                            bam_store_capture_expression(argument, out)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _):
                        bam_store_capture_expression(object, out)
                    Expr.Index(object, index, _) | Expr.Binary(object, _, index, _):
                        bam_store_capture_expression(object, out)
                        bam_store_capture_expression(index, out)
                    Expr.Slice(object, low, high, _):
                        bam_store_capture_expression(object, out)
                        bam_store_capture_expression(low, out)
                        bam_store_capture_expression(high, out)
                    Expr.IndexN(object, indices, _):
                        bam_store_capture_expression(object, out)
                        for index in indices |out|:
                            bam_store_capture_expression(index, out)
                    Expr.Unary(_, operand, _) | Expr.Move(operand, _) | Expr.Paren(operand, _) | Expr.RegionNew(operand, _, _):
                        bam_store_capture_expression(operand, out)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |out|:
                            bam_store_capture_expression(element, out)
                    Expr.DictLit(entries, _):
                        for entry in entries |out|:
                            bam_store_capture_expression(entry.key, out)
                            bam_store_capture_expression(entry.value, out)
                    Expr.Construct(head, fields, _) | Expr.RecordUpdate(head, fields, _):
                        bam_store_capture_expression(head, out)
                        for field in fields |out|:
                            bam_store_capture_expression(field.value, out)
                    Expr.If(condition, then_value, else_value, _):
                        bam_store_capture_expression(condition, out)
                        bam_store_capture_expression(then_value, out)
                        bam_store_capture_expression(else_value, out)
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        bam_store_capture_expression(scrutinee, out)
                        for arm in arms |out|:
                            bam_store_capture_pattern(arm.pattern, out)
                            bam_store_capture_expression(arm.guard, out)
                            bam_store_capture_statements(arm.body, out)
                    Expr.Comprehension(iterable: iterable, condition: condition, body: body, _):
                        bam_store_capture_expression(iterable, out)
                        bam_store_capture_expression(condition, out)
                        bam_store_capture_expression(body, out)
                    Expr.Refinement(base, predicate, _):
                        bam_store_capture_expression(base, out)
                        bam_store_capture_expression(predicate, out)
                    Expr.GetElse(guarded, recovery, _):
                        bam_store_capture_expression(guarded, out)
                        bam_store_capture_statements(recovery, out)
                    Expr.Lambda(_, body, _):
                        bam_store_capture_statements(body, out)
                    Expr.Block(statements, value, captures, _):
                        for capture in captures |out|:
                            out.push(capture) if capture != ""
                        bam_store_capture_statements(statements, out)
                        bam_store_capture_expression(value, out)
                    _:
                        pass

        def bam_store_capture_statements(statements: darray[Ast::Stmt], out: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.Expr(expression, _):
                            bam_store_capture_expression(expression, out)
                        Stmt.VarDecl(value: value, _):
                            bam_store_capture_expression(value, out)
                        Stmt.Assign(target, _, value, _):
                            bam_store_capture_expression(target, out)
                            bam_store_capture_expression(value, out)
                        Stmt.If(condition, then_body, else_body, _):
                            bam_store_capture_expression(condition, out)
                            bam_store_capture_statements(then_body, out)
                            bam_store_capture_statements(else_body, out)
                        Stmt.While(condition, body, _):
                            bam_store_capture_expression(condition, out)
                            bam_store_capture_statements(body, out)
                        Stmt.For(iterable: iterable, body: body, _):
                            bam_store_capture_expression(iterable, out)
                            bam_store_capture_statements(body, out)
                        Stmt.Block(body: body, _):
                            bam_store_capture_statements(body, out)
                        Stmt.Match(scrutinee, arms, _):
                            bam_store_capture_expression(scrutinee, out)
                            for arm in arms |out|:
                                bam_store_capture_pattern(arm.pattern, out)
                                bam_store_capture_expression(arm.guard, out)
                                bam_store_capture_statements(arm.body, out)
                        Stmt.Return(value, _):
                            if value is returned:
                                bam_store_capture_expression(returned, out)
                        Stmt.Contract(_, value, _):
                            bam_store_capture_expression(value, out)
                        _:
                            pass

        def bam_store_local_alias_add_root(alias_id: BindingId, root_id: BindingId, root_kind: u8, root_name: sview, root_known: bool, facts: mutable darray[BorrowLocalCallableAliasRoot]&) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                return false if root_name == ""
                facts.push(BorrowLocalCallableAliasRoot{alias_binding_id: alias_id, root_binding_id: root_id, root_binding_kind: root_kind, root_name: root_name, root_binding_known: root_known})
                return true

        def bam_store_local_alias_add_unknown_root(alias_id: BindingId, facts: mutable darray[BorrowLocalCallableAliasRoot]&) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                unknown_id: BindingId = BindingId{owner: DeclId{value: INVALID_DECL_ID_VALUE}, serial: FIRST_BINDING_SERIAL}
                return bam_store_local_alias_add_root(alias_id, unknown_id, BORROW_LOCAL_ALIAS_UNKNOWN_ROOT_KIND, "<unknown-local-alias>", false, facts)

        def bam_store_local_alias_binding_hash(binding_id: BindingId) -> u64:
            can Abort.Panic:
                hash: mutable u64 = (14695981039346656037 ^ binding_id.owner.value.u64()) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ binding_id.serial) * SEMANTIC_HASH_PRIME
                return hash

        def bam_store_local_alias_edge_hash(alias_id: BindingId, source_id: BindingId) -> u64:
            can Abort.Panic:
                hash: mutable u64 = (14695981039346656037 ^ bam_store_local_alias_binding_hash(source_id)) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ bam_store_local_alias_binding_hash(alias_id)) * SEMANTIC_HASH_PRIME
                return hash

        def bam_store_local_alias_root_hash(alias_id: BindingId, root_id: BindingId, root_kind: u8, root_known: bool) -> u64:
            can Abort.Panic:
                hash: mutable u64 = bam_store_local_alias_binding_hash(alias_id)
                hash <- (hash ^ bam_store_local_alias_binding_hash(root_id)) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ root_kind.u64()) * SEMANTIC_HASH_PRIME
                hash <- (hash ^ (1.u64() if root_known else 0.u64())) * SEMANTIC_HASH_PRIME
                return hash

        # Collision-safe fact insertion for the indexed worklist. Hashes select a chain;
        # complete BindingIds and root metadata decide equality.
        def bam_store_local_alias_graph_add_root(graph: mutable BorrowLocalCallableAliasGraph&, alias_id: BindingId, root_id: BindingId, root_kind: u8, root_name: sview, root_known: bool) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                hash: u64 = bam_store_local_alias_root_hash(alias_id, root_id, root_kind, root_known)
                head: mutable u32 = SYMBOL_INDEX_ROW_NONE
                if graph.root_heads.get(hash) is found_head:
                    head <- found_head
                    row: mutable u32 = head
                    while row != SYMBOL_INDEX_ROW_NONE |row, graph, alias_id, root_id, root_kind, root_known|:
                        prior: BorrowLocalCallableAliasRoot = graph.roots[row.usize()]
                        return false if ownership_binding_ids_equal(prior.alias_binding_id, alias_id) and ownership_binding_ids_equal(prior.root_binding_id, root_id) and prior.root_binding_kind == root_kind and prior.root_binding_known == root_known
                        row <- graph.root_next[row.usize()]
                row_index: u32 = graph.roots.count.u32()
                graph.roots.push(BorrowLocalCallableAliasRoot{alias_binding_id: alias_id, root_binding_id: root_id, root_binding_kind: root_kind, root_name: root_name, root_binding_known: root_known})
                graph.root_next.push(head)
                graph.root_heads <- graph.root_heads.put(hash, row_index) can Global{Read,Write}
                return true

        def bam_store_local_alias_graph_add_edge(graph: mutable BorrowLocalCallableAliasGraph&, edge: BorrowLocalCallableAliasEdge) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                source_hash: u64 = bam_store_local_alias_binding_hash(edge.source_binding_id)
                pair_hash: u64 = bam_store_local_alias_edge_hash(edge.alias_binding_id, edge.source_binding_id)
                source_head: mutable u32 = SYMBOL_INDEX_ROW_NONE
                if graph.edge_heads.get(source_hash) is found_head:
                    source_head <- found_head
                pair_head: mutable u32 = SYMBOL_INDEX_ROW_NONE
                if graph.edge_pair_heads.get(pair_hash) is found_head:
                    pair_head <- found_head
                    row: mutable u32 = pair_head
                    while row != SYMBOL_INDEX_ROW_NONE |row, graph, edge|:
                        prior: BorrowLocalCallableAliasEdge = graph.edges[row.usize()]
                        return if ownership_binding_ids_equal(prior.source_binding_id, edge.source_binding_id) and ownership_binding_ids_equal(prior.alias_binding_id, edge.alias_binding_id)
                        row <- graph.edge_pair_next[row.usize()]
                row_index: u32 = graph.edges.count.u32()
                graph.edges.push(edge)
                graph.edge_next.push(source_head)
                graph.edge_pair_next.push(pair_head)
                graph.edge_heads <- graph.edge_heads.put(source_hash, row_index) can Global{Read,Write}
                graph.edge_pair_heads <- graph.edge_pair_heads.put(pair_hash, row_index) can Global{Read,Write}

        def bam_store_local_alias_add_edge(alias_id: BindingId, source_id: BindingId, edges: mutable darray[BorrowLocalCallableAliasEdge]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if ownership_binding_ids_equal(alias_id, source_id)
                edges.push(BorrowLocalCallableAliasEdge{alias_binding_id: alias_id, source_binding_id: source_id})

        # Resolve closure aliases by lexical BindingIds. One AST pass appends root and
        # edge facts without repeated scans; collision-safe hash chains deduplicate roots
        # and index edges before the worklist propagates roots independent of source order.
        # Nested lambdas are scanned separately by the expression walker.
        def bam_store_local_alias_value(alias_id: BindingId, value: Ast::Expr, owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, lend_names: darray[sview]&, lend_positions: darray[usize]&, facts: mutable darray[BorrowLocalCallableAliasRoot]&, edges: mutable darray[BorrowLocalCallableAliasEdge]&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                direct_root: sview = bam_borrow_root(value)
                direct_root_known, direct_root_position = bam_borrow_root_position(value)
                if direct_root != "" and direct_root_known:
                    root_kind, root_binding_known, root_id = borrow_reference_site_lookup(reference_sites, owner, direct_root_position, table)
                    if root_kind != 0 and root_binding_known:
                        bam_store_local_alias_add_root(alias_id, root_id, root_kind, direct_root, true, facts)
                        return
                match value:
                    Expr.Ident(_, position):
                        source_known, source_id = borrow_reference_site_binding(reference_sites, owner, position, table)
                        if source_known and bam_binding_may_carry_reference(source_id, reference_sites, table):
                            bam_store_local_alias_add_edge(alias_id, source_id, edges)
                    Expr.Call(callee, arguments, argument_names, _):
                        callee_name: mutable sview = ""
                        callee_kind: mutable u8 = 0
                        bare_callee: mutable bool = false
                        qualified_callee: mutable bool = false
                        match callee:
                            Expr.Ident(name, position):
                                callee_name <- name
                                callee_kind <- borrow_reference_site_kind(reference_sites, owner, position, table)
                                bare_callee <- true
                            Expr.Scope(_, name, position) | Expr.Field(_, name, position):
                                callee_name <- name
                                qualified_callee <- true
                            _:
                                pass
                        has_named_arguments: bool = argument_names.count > 0 and (argument_names.count != arguments.count or any argument_name in argument_names where argument_name != "")
                        if bare_callee and callee_kind == 0 and not has_named_arguments:
                            # Exact positional summaries retain the narrow, resolved path.
                            lender_index: mutable usize = 0
                            matched_lender: mutable bool = false
                            while lender_index < lend_names.count and lender_index < lend_positions.count |lender_index, alias_id, arguments, callee_name, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                                if lend_names[lender_index] == callee_name:
                                    matched_lender <- true
                                    argument_index: usize = lend_positions[lender_index]
                                    if argument_index < arguments.count:
                                        bam_store_local_alias_value(alias_id, arguments[argument_index], owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                    else:
                                        bam_store_local_alias_add_unknown_root(alias_id, facts)
                                lender_index <- lender_index + 1
                            if not matched_lender:
                                return_type_id: u32 = function_return_type_id(table, callee_name)
                                bam_store_local_alias_add_unknown_root(alias_id, facts) if not bam_type_is_proven_reference_free_cached(return_type_id, reference_sites, table)
                        else:
                            known_lender: bool = callee_name != "" and (any lender_name in lend_names where lender_name == callee_name)
                            if known_lender:
                                # The summary has no formal labels or qualified owner. Union
                                # argument provenance so named and qualified calls cannot
                                # discard a possible borrowed result.
                                for argument in arguments |alias_id, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                                    bam_store_local_alias_value(alias_id, argument, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                match callee:
                                    Expr.Field(receiver, _, _):
                                        bam_store_local_alias_value(alias_id, receiver, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                    _:
                                        pass
                            elif bare_callee and callee_kind == 0:
                                # Named direct calls can also return a borrowed aggregate.
                                # Use the unique concrete return type when possible; unresolved
                                # schemes and Named rows stay conservative.
                                return_type_id: u32 = function_return_type_id(table, callee_name)
                                bam_store_local_alias_add_unknown_root(alias_id, facts) if not bam_type_is_proven_reference_free_cached(return_type_id, reference_sites, table)
                            elif (bare_callee and callee_kind != 0) or qualified_callee or not bare_callee:
                                # A local or parameter callable, method, qualified call, or computed callee
                                # can return a captured/local reference without a usable
                                # lender summary. Keep argument/receiver roots and add an
                                # explicit maybe-local marker for a later global-store check.
                                bam_store_local_alias_add_unknown_root(alias_id, facts)
                                for argument in arguments |alias_id, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                                    bam_store_local_alias_value(alias_id, argument, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                match callee:
                                    Expr.Field(receiver, _, _) | Expr.Scope(receiver, _, _):
                                        bam_store_local_alias_value(alias_id, receiver, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                    _:
                                        pass
                    Expr.Paren(inner, _) | Expr.Move(inner, _) | Expr.RegionNew(inner, _, _):
                        bam_store_local_alias_value(alias_id, inner, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |alias_id, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                            bam_store_local_alias_value(alias_id, element, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.Construct(_, fields, _) | Expr.RecordUpdate(_, fields, _):
                        for field in fields |alias_id, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                            bam_store_local_alias_value(alias_id, field.value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.DictLit(entries, _):
                        for entry in entries |alias_id, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                            bam_store_local_alias_value(alias_id, entry.value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.If(_, then_value, else_value, _):
                        bam_store_local_alias_value(alias_id, then_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        bam_store_local_alias_value(alias_id, else_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.Block(statements, block_value, _, _):
                        bam_store_local_alias_statements(statements, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        bam_store_local_alias_value(alias_id, block_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.Match(scrutinee, arms, match_pos) | Expr.Catch(scrutinee, arms, match_pos):
                        for arm in arms |alias_id, scrutinee, match_pos, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                            bam_store_local_alias_pattern_bindings(arm.pattern, scrutinee, arm_report_pos(arm, match_pos.line), owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                            bam_store_local_alias_statements(arm.body, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                            if arm.body.count > 0:
                                match arm.body[arm.body.count - 1]:
                                    Stmt.Expr(arm_value, _):
                                        bam_store_local_alias_value(alias_id, arm_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                    Stmt.Return(arm_value_option, _):
                                        if arm_value_option is arm_return_value:
                                            bam_store_local_alias_value(alias_id, arm_return_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                    _:
                                        pass
                    _:
                        pass

        # Preserve resolver identities for destructuring assignments. Matching aggregate
        # shapes pair each binding with its own RHS; when the shape is not statically
        # matched, union the possible RHS roots into every target leaf conservatively.
        def bam_store_local_alias_assignment(target: Ast::Expr, value: Ast::Expr, owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, lend_names: darray[sview]&, lend_positions: darray[usize]&, facts: mutable darray[BorrowLocalCallableAliasRoot]&, edges: mutable darray[BorrowLocalCallableAliasEdge]&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                target_value: Ast::Expr = bam_strip_paren(target)
                source_value: Ast::Expr = bam_strip_paren(value)
                match target_value:
                    Expr.Array(targets, _):
                        match source_value:
                            Expr.Array(values, _) | Expr.Tuple(values, _):
                                if values.count == targets.count:
                                    index: mutable usize = 0
                                    while index < targets.count |index, targets, values, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                                        bam_store_local_alias_assignment(targets[index], values[index], owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                        index <- index + 1
                                    return
                            _:
                                pass
                        for child in targets |source_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                            bam_store_local_alias_assignment(child, source_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.Tuple(targets, _):
                        match source_value:
                            Expr.Tuple(values, _) | Expr.Array(values, _):
                                if values.count == targets.count:
                                    index: mutable usize = 0
                                    while index < targets.count |index, targets, values, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                                        bam_store_local_alias_assignment(targets[index], values[index], owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                        index <- index + 1
                                    return
                            _:
                                pass
                        for child in targets |source_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                            bam_store_local_alias_assignment(child, source_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    Expr.Ident(_, position):
                        binding_known, alias_id = borrow_reference_site_binding(reference_sites, owner, position, table)
                        if binding_known:
                            bam_store_local_alias_value(alias_id, source_value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                    _:
                        pass

        # Match-arm binders have resolver-recorded declaration positions and exact
        # BindingIds. A whole-value binding can inherit the scrutinee's alias facts;
        # projected/destructured bindings are conservatively unknown because this pass
        # does not model field/variant projection types.
        def bam_store_local_alias_pattern_binder_is_whole(pattern: Ast::Pattern, binder_name: sview) -> bool:
            can Abort.Panic:
                match pattern:
                    Pattern.Binding(name) | Pattern.TypeBind(_, name):
                        return name == binder_name
                    Pattern.As(name, inner):
                        return name == binder_name or (inner.count == 1 and bam_store_local_alias_pattern_binder_is_whole(inner[0], binder_name))
                    Pattern.Or(options):
                        return false if options.count == 0
                        for option in options |binder_name|:
                            return false if not bam_store_local_alias_pattern_binder_is_whole(option, binder_name)
                        return true
                    _:
                        return false

        def bam_store_local_alias_pattern_bindings(pattern: Ast::Pattern, scrutinee: Ast::Expr, arm_position: Ast::Pos, owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, lend_names: darray[sview]&, lend_positions: darray[usize]&, facts: mutable darray[BorrowLocalCallableAliasRoot]&, edges: mutable darray[BorrowLocalCallableAliasEdge]&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                arm_names: mutable darray[sview @source] = []
                gather_arm_pattern(pattern, arm_names)
                binder_positions: darray[Ast::Pos] = arm_pattern_binder_positions(table, pattern, arm_names, 0, arm_position)
                pattern_index: mutable usize = 0
                while pattern_index < arm_names.count |pattern_index, arm_names, binder_positions, scrutinee, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                    binder_name: sview = arm_names[pattern_index]
                    if binder_name != "" and binder_name != "_":
                        binder_position: Ast::Pos = binder_positions[pattern_index] if pattern_index < binder_positions.count else Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
                        binding_known, alias_id = borrow_reference_site_binding(reference_sites, owner, binder_position, table)
                        if binding_known:
                            whole_value: bool = bam_store_local_alias_pattern_binder_is_whole(pattern, binder_name)
                            if whole_value:
                                bam_store_local_alias_value(alias_id, scrutinee, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                            else:
                                bam_store_local_alias_add_unknown_root(alias_id, facts)
                    pattern_index <- pattern_index + 1

        # Resolve only types attached to the exact iterable binding. The global
        # name-keyed type sidecar can describe a shadowed binding, so it is not safe
        # for deciding whether a loop binder can carry a reference.
        # Named TypeIds keep a bare spelling, not a module or generic-parameter identity.
        # Resolve a field only when every same-named type declaration is this one Struct
        # and the name is not a generic parameter of the function using the binding.
        def bam_named_type_has_unique_struct_declaration(type_name: sview, owner: DeclId, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if owner.value == INVALID_DECL_ID_VALUE or owner.value.usize() >= table.symbols.count
                owner_symbol: Symbol = table.symbols[owner.value.usize()]
                return false if function_generic_param_named(table, owner_symbol.line, owner_symbol.offset, type_name)
                found_struct: mutable bool = false
                cursor: mutable u32 = symbol_chain_head(table, type_name)
                while cursor != SYMBOL_INDEX_ROW_NONE |cursor, found_struct, table, type_name|:
                    symbol: Symbol = table.symbols[cursor.usize()]
                    if symbol.name == type_name and (symbol.kind == SymbolKind.Struct or symbol.kind == SymbolKind.Enum or symbol.kind == SymbolKind.Alias or symbol.kind == SymbolKind.Extern):
                        return false if found_struct or symbol.kind != SymbolKind.Struct
                        found_struct <- true
                    cursor <- table.symbol_name_next[cursor.usize()]
                return found_struct

        def bam_unique_struct_field_type_id(type_name: sview, field_name: sview, owner: DeclId, table: SymbolTable&) -> u32:
            can Abort.Panic:
                return 0 if not bam_named_type_has_unique_struct_declaration(type_name, owner, table)
                return field_type_id_of(table, type_name, field_name)

        def bam_store_local_alias_iterable_type_id(iterable: Ast::Expr, owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&) -> u32:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                match iterable:
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return bam_store_local_alias_iterable_type_id(inner, owner, reference_sites, table)
                    Expr.Ident(_, position):
                        binding_known, binding_id = borrow_reference_site_binding(reference_sites, owner, position, table)
                        return 0 if not binding_known
                        return bam_binding_declared_type_id(binding_id, reference_sites, table)
                    Expr.Field(object, field_name, _):
                        object_type_id: mutable u32 = bam_store_local_alias_iterable_type_id(object, owner, reference_sites, table)
                        while interned_kind(object_type_id, table) == SemTypeKind.Ref:
                            return 0 if interned_elem_count(object_type_id, table) != 1.u32()
                            object_type_id <- interned_elem(object_type_id, 0, table)
                        return bam_unique_struct_field_type_id(interned_name(object_type_id, table), field_name, owner, table) if interned_kind(object_type_id, table) == SemTypeKind.Named
                        return 0
                    Expr.Call(Expr.Ident(callee_name, callee_position), _, _, _):
                        callee_binding_known, _ = borrow_reference_site_binding(reference_sites, owner, callee_position, table)
                        return 0 if callee_binding_known
                        return function_return_type_id(table, callee_name)
                    _:
                        return 0

        # Unknown iterable shapes stay conservative. A known scalar range or string
        # produces scalar values; a typed container uses its exact yielded element type.
        # Multi-binder dict and tuple loops select the corresponding item type.
        def bam_store_local_alias_iterable_binding_may_carry_reference(iterable: Ast::Expr, binder_count: usize, binder_index: usize, owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                match iterable:
                    Expr.Binary(_, operator, _, _) if operator == TokenKind.Range or operator == TokenKind.RangeLt or operator == TokenKind.RangeLe or operator == TokenKind.RangeGt:
                        return false
                    Expr.StringLit(_, _):
                        return false
                    Expr.Paren(inner, _) | Expr.Move(inner, _):
                        return bam_store_local_alias_iterable_binding_may_carry_reference(inner, binder_count, binder_index, owner, reference_sites, table)
                    _:
                        pass
                iterable_type_id: mutable u32 = bam_store_local_alias_iterable_type_id(iterable, owner, reference_sites, table)
                return true if iterable_type_id == 0
                while interned_kind(iterable_type_id, table) == SemTypeKind.Ref |iterable_type_id|:
                    return true if interned_elem_count(iterable_type_id, table) != 1.u32()
                    iterable_type_id <- interned_elem(iterable_type_id, 0, table)
                iterable_kind: SemTypeKind = interned_kind(iterable_type_id, table)
                if iterable_kind == SemTypeKind.Container:
                    elem_count: usize = interned_elem_count(iterable_type_id, table).usize()
                    container_name: sview = interned_name(iterable_type_id, table)
                    return true if elem_count == 0
                    item_type_id: mutable u32 = 0
                    if container_name == "dict" and binder_count == 2 and elem_count == 2:
                        item_type_id <- interned_elem(iterable_type_id, binder_index.u32(), table)
                    elif (container_name == "darray" or container_name == "array" or container_name == "set") and elem_count > 0:
                        item_type_id <- interned_elem(iterable_type_id, 0, table)
                        if binder_count > 1:
                            if interned_kind(item_type_id, table) == SemTypeKind.Tuple and interned_elem_count(item_type_id, table).usize() == binder_count:
                                item_type_id <- interned_elem(item_type_id, binder_index.u32(), table)
                            else:
                                return true
                    else:
                        # User generics and iterable containers with no established
                        # item-to-type-argument mapping remain opaque.
                        return true
                    return not bam_type_is_proven_reference_free_cached(item_type_id, reference_sites, table)
                if iterable_kind == SemTypeKind.Tuple:
                    return not bam_type_is_proven_reference_free_cached(iterable_type_id, reference_sites, table)
                return false if iterable_kind == SemTypeKind.String or iterable_kind == SemTypeKind.Int or iterable_kind == SemTypeKind.Float or iterable_kind == SemTypeKind.Bool or iterable_kind == SemTypeKind.Char
                return true

        # Exact multi-binder literal loops can pair each tuple component with its
        # corresponding binder. Any opaque or mismatched item keeps the conservative path.
        def bam_store_local_alias_literal_tuple_iterable_matches(iterable: Ast::Expr, binder_count: usize) -> bool:
            can Abort.Panic:
                match iterable:
                    Expr.Array(elements, _) | Expr.SetLit(elements, _):
                        for element in elements:
                            match element:
                                Expr.Tuple(values, _) if values.count == binder_count:
                                    pass
                                _:
                                    return false
                        return true
                    _:
                        return false

        def bam_store_local_alias_statements(statements: darray[Ast::Stmt], owner: DeclId, reference_sites: mutable BorrowReferenceSites&, table: SymbolTable&, lend_names: darray[sview]&, lend_positions: darray[usize]&, facts: mutable darray[BorrowLocalCallableAliasRoot]&, edges: mutable darray[BorrowLocalCallableAliasEdge]&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                for statement in statements |owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                    match statement:
                        Stmt.VarDecl(name, _, value, line):
                            binding_position: mutable Ast::Pos = source_binder_position(table, name, line.line, 0, "__pattern_binder")
                            binding_position <- line if binding_position.line == 0
                            binding_known, alias_id = borrow_reference_site_binding(reference_sites, owner, binding_position, table)
                            if binding_known:
                                bam_store_local_alias_value(alias_id, value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                            bam_store_local_alias_expression(value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        Stmt.Assign(target, _, value, _):
                            bam_store_local_alias_assignment(target, value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                            bam_store_local_alias_expression(value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        Stmt.Expr(expression, _):
                            bam_store_local_alias_expression(expression, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        Stmt.If(condition, then_body, else_body, _):
                            bam_store_local_alias_expression(condition, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                            bam_store_local_alias_statements(then_body, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                            bam_store_local_alias_statements(else_body, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        Stmt.While(condition, body, _):
                            bam_store_local_alias_expression(condition, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                            bam_store_local_alias_statements(body, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        Stmt.For(_, variables, iterable, body, for_pos):
                            bam_store_local_alias_expression(iterable, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                            # A literal collection gives an exact candidate set for a
                            # single loop variable. Opaque iterables receive conservative
                            # element provenance below.
                            if variables.count == 1:
                                match iterable:
                                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                                        binder_position: Ast::Pos = source_binder_position(table, variables[0], for_pos.line, 0, "__for_binder")
                                        if binder_position.line > 0:
                                            binder_known, binder_id = borrow_reference_site_binding(reference_sites, owner, binder_position, table)
                                            if binder_known:
                                                for element in elements |binder_id, elements, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                                                    bam_store_local_alias_value(binder_id, element, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                    _:
                                        binder_position: Ast::Pos = source_binder_position(table, variables[0], for_pos.line, 0, "__for_binder")
                                        if binder_position.line > 0:
                                            binder_known, binder_id = borrow_reference_site_binding(reference_sites, owner, binder_position, table)
                                            if binder_known and bam_store_local_alias_iterable_binding_may_carry_reference(iterable, variables.count, 0, owner, reference_sites, table):
                                                # The iterable itself is not the yielded value's
                                                # provenance. Preserve uncertainty only when its
                                                # exact item type can carry a local reference.
                                                bam_store_local_alias_add_unknown_root(binder_id, facts)
                            else:
                                if bam_store_local_alias_literal_tuple_iterable_matches(iterable, variables.count):
                                    for binder_index in 0..<variables.count |binder_index, variables, for_pos, iterable, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                                        binder_position: Ast::Pos = source_binder_position(table, variables[binder_index], for_pos.line, binder_index, "__for_binder")
                                        if binder_position.line > 0:
                                            binder_known, binder_id = borrow_reference_site_binding(reference_sites, owner, binder_position, table)
                                            if binder_known:
                                                match iterable:
                                                    Expr.Array(elements, _) | Expr.SetLit(elements, _):
                                                        for element in elements |binder_id, binder_index, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                                                            match element:
                                                                Expr.Tuple(values, _):
                                                                    bam_store_local_alias_value(binder_id, values[binder_index], owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                                                _:
                                                                    pass
                                                    _:
                                                        pass
                                else:
                                    for binder_index in 0..<variables.count |binder_index, variables, for_pos, owner, reference_sites, table, facts|:
                                        binder_position: Ast::Pos = source_binder_position(table, variables[binder_index], for_pos.line, binder_index, "__for_binder")
                                        if binder_position.line > 0:
                                            binder_known, binder_id = borrow_reference_site_binding(reference_sites, owner, binder_position, table)
                                            if binder_known and bam_store_local_alias_iterable_binding_may_carry_reference(iterable, variables.count, binder_index, owner, reference_sites, table):
                                                bam_store_local_alias_add_unknown_root(binder_id, facts)
                            bam_store_local_alias_statements(body, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        Stmt.Block(body: body, _):
                            bam_store_local_alias_statements(body, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        Stmt.Match(scrutinee, arms, match_pos):
                            bam_store_local_alias_expression(scrutinee, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                            for arm in arms |scrutinee, match_pos, owner, reference_sites, table, lend_names, lend_positions, facts, edges|:
                                bam_store_local_alias_pattern_bindings(arm.pattern, scrutinee, arm_report_pos(arm, match_pos.line), owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                bam_store_local_alias_expression(arm.guard, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                                bam_store_local_alias_statements(arm.body, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        Stmt.Return(value, _):
                            if value is returned:
                                bam_store_local_alias_expression(returned, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        Stmt.Contract(_, value, _):
                            bam_store_local_alias_expression(value, owner, reference_sites, table, lend_names, lend_positions, facts, edges)
                        _:
                            pass
