extend Semantic:
    private:
        # Resolve owners under scoped aliases while retaining each control-flow outcome.
        # Only the normal result of an expression contributes owners to its enclosing value.
        def bam_nested_value_owners_scoped(value: Ast::Expr, owners: darray[sview @source]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, binders: BorrowBinders&, borrow_names: mutable darray[sview @source]&, borrow_fields: mutable darray[sview @source]&, borrow_owners: mutable darray[sview @source]&, out: mutable darray[sview @source]&, flow: mutable BorrowReplayFlow&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                bam_replay_flow_reset(flow)
                out_mark: usize = out.count
                reachable: mutable bool = true
                if not bam_expr_has_scoped_flow(value):
                    table <- bam_nested_value_owners(value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    bam_replay_flow_set_reachable(flow)
                    return
                match value:
                    Expr.Block(statements, block_value, _, _):
                        base_names: mutable darray[sview @source] = []
                        base_fields: mutable darray[sview @source] = []
                        base_owners: mutable darray[sview @source] = []
                        scoped_names: mutable darray[sview @source] = []
                        scoped_fields: mutable darray[sview @source] = []
                        scoped_owners: mutable darray[sview @source] = []
