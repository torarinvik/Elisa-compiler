                            if reachable and argument_lenders[argument_index] and bam_expr_has_scoped_flow(arguments[argument_index]):
                                for owner in argument_owners |out|:
                                    bam_append_unique_owner(out, owner)
                            argument_index <- argument_index + 1
                        if reachable:
                            table <- bam_nested_value_owners(value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.StaticEffectCall(candidates: candidates, arguments: arguments, _):
                        runtime_children: darray[Ast::Expr] = Ast::effect_runtime_children(candidates, arguments)
                        for child in runtime_children |reachable, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, out, flow, table|:
                            continue if not reachable
                            child_owners: mutable darray[sview @source] = []
                            child_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            table <- bam_nested_value_owners_scoped(child, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, child_owners, child_flow, table)
                            bam_replay_flow_merge_exits(flow, child_flow)
                            reachable <- child_flow.normal_seen
                        if reachable:
                            table <- bam_nested_value_owners(value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.Binary(left, operator, right, _):
                        left_owners: mutable darray[sview @source] = []
                        left_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                        table <- bam_nested_value_owners_scoped(left, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, left_owners, left_flow, table)
                        bam_replay_flow_merge_exits(flow, left_flow)
                        reachable <- left_flow.normal_seen
                        if reachable and operator != TokenKind.Is and operator != TokenKind.As:
                            if operator == TokenKind.And or operator == TokenKind.Or:
                                short_names: mutable darray[sview @source] = []
                                short_fields: mutable darray[sview @source] = []
                                short_owners: mutable darray[sview @source] = []
                                right_names: mutable darray[sview @source] = []
                                right_fields: mutable darray[sview @source] = []
                                right_owners: mutable darray[sview @source] = []
                                short_names.extend(borrow_names)
                                short_fields.extend(borrow_fields)
                                short_owners.extend(borrow_owners)
                                right_names.extend(borrow_names)
                                right_fields.extend(borrow_fields)
                                right_owners.extend(borrow_owners)
                                right_value_owners: mutable darray[sview @source] = []
                                right_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                                table <- bam_nested_value_owners_scoped(right, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, right_names, right_fields, right_owners, right_value_owners, right_flow, table)
                                bam_replay_flow_merge_exits(flow, right_flow)
                                if right_flow.normal_seen:
                                    bam_merge_borrow_state(short_names, short_fields, short_owners, right_names, right_fields, right_owners)
                                bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, short_names, short_fields, short_owners)
                                reachable <- true
                            else:
                                right_owners: mutable darray[sview @source] = []
                                right_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                                table <- bam_nested_value_owners_scoped(right, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, right_owners, right_flow, table)
                                bam_replay_flow_merge_exits(flow, right_flow)
                                reachable <- right_flow.normal_seen
                        if reachable:
                            table <- bam_nested_value_owners(value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.Index(object, index, _):
                        object_owners: mutable darray[sview @source] = []
                        object_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                        table <- bam_nested_value_owners_scoped(object, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, object_owners, object_flow, table)
                        bam_replay_flow_merge_exits(flow, object_flow)
                        reachable <- object_flow.normal_seen
                        if reachable and index is not Expr.Absent:
                            index_owners: mutable darray[sview @source] = []
                            index_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            table <- bam_nested_value_owners_scoped(index, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, index_owners, index_flow, table)
                            bam_replay_flow_merge_exits(flow, index_flow)
                            reachable <- index_flow.normal_seen
                        if reachable:
                            table <- bam_nested_value_owners(value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.Slice(object, low, high, _):
                        object_owners: mutable darray[sview @source] = []
                        object_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                        table <- bam_nested_value_owners_scoped(object, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, object_owners, object_flow, table)
                        bam_replay_flow_merge_exits(flow, object_flow)
                        reachable <- object_flow.normal_seen
                        if reachable and low is not Expr.Absent:
                            low_owners: mutable darray[sview @source] = []
                            low_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            table <- bam_nested_value_owners_scoped(low, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, low_owners, low_flow, table)
                            bam_replay_flow_merge_exits(flow, low_flow)
                            reachable <- low_flow.normal_seen
                        if reachable and high is not Expr.Absent:
                            high_owners: mutable darray[sview @source] = []
                            high_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            table <- bam_nested_value_owners_scoped(high, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, high_owners, high_flow, table)
                            bam_replay_flow_merge_exits(flow, high_flow)
                            reachable <- high_flow.normal_seen
                        if reachable:
                            table <- bam_nested_value_owners(value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.IndexN(object, indices, _):
                        object_owners: mutable darray[sview @source] = []
                        object_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                        table <- bam_nested_value_owners_scoped(object, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, object_owners, object_flow, table)
                        bam_replay_flow_merge_exits(flow, object_flow)
                        reachable <- object_flow.normal_seen
                        for index in indices |reachable, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, out, flow, table|:
                            continue if not reachable
                            index_owners: mutable darray[sview @source] = []
                            index_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            table <- bam_nested_value_owners_scoped(index, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, index_owners, index_flow, table)
                            bam_replay_flow_merge_exits(flow, index_flow)
                            reachable <- index_flow.normal_seen
                        if reachable:
                            table <- bam_nested_value_owners(value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.Field(object, _, _) | Expr.Scope(object, _, _) | Expr.Unary(_, object, _) | Expr.RegionNew(object, _, _):
                        child_owners: mutable darray[sview @source] = []
                        child_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                        table <- bam_nested_value_owners_scoped(object, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, child_owners, child_flow, table)
                        bam_replay_flow_merge_exits(flow, child_flow)
                        reachable <- child_flow.normal_seen
                        if reachable:
                            table <- bam_nested_value_owners(value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.Refinement(base, predicate, _):
                        base_owners: mutable darray[sview @source] = []
                        base_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                        table <- bam_nested_value_owners_scoped(base, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, base_owners, base_flow, table)
                        bam_replay_flow_merge_exits(flow, base_flow)
                        reachable <- base_flow.normal_seen
                        if reachable:
                            predicate_owners: mutable darray[sview @source] = []
                            predicate_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            table <- bam_nested_value_owners_scoped(predicate, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, predicate_owners, predicate_flow, table)
                            bam_replay_flow_merge_exits(flow, predicate_flow)
                            reachable <- predicate_flow.normal_seen
                        if reachable:
                            table <- bam_nested_value_owners(value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                    Expr.Comprehension(variable, iterable, condition, body, _, _):
                        iterable_owners: mutable darray[sview @source] = []
                        iterable_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                        table <- bam_nested_value_owners_scoped(iterable, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, iterable_owners, iterable_flow, table)
                        bam_replay_flow_merge_exits(flow, iterable_flow)
                        if iterable_flow.normal_seen:
                            literal_iterable_value: Ast::Expr = bam_unwrap_replay_literal_iterable(iterable)
                            comprehension_base_names: mutable darray[sview @source] = []
                            comprehension_base_fields: mutable darray[sview @source] = []
                            comprehension_base_owners: mutable darray[sview @source] = []
                            comprehension_base_names.extend(borrow_names)
                            comprehension_base_fields.extend(borrow_fields)
                            comprehension_base_owners.extend(borrow_owners)
                            comprehension_head_names: mutable darray[sview @source] = []
                            comprehension_head_fields: mutable darray[sview @source] = []
                            comprehension_head_owners: mutable darray[sview @source] = []
                            comprehension_head_names.extend(comprehension_base_names)
                            comprehension_head_fields.extend(comprehension_base_fields)
                            comprehension_head_owners.extend(comprehension_base_owners)
                            last_condition_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            last_body_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                            last_body_owners: mutable darray[sview @source] = []
                            definitely_nonempty: mutable bool = match literal_iterable_value:
                                Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _): elements.count > 0
                                _: false
                            first_iteration_pending: mutable bool = true
                            first_iteration_can_complete: mutable bool = false
                            definitely_empty: mutable bool = match literal_iterable_value:
                                Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _): elements.count == 0
                                _: false
                            comprehension_grew: mutable bool = not definitely_empty
                            while comprehension_grew |comprehension_grew, variable, literal_iterable_value, condition, body, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, comprehension_base_names, comprehension_base_fields, comprehension_base_owners, comprehension_head_names, comprehension_head_fields, comprehension_head_owners, last_condition_flow, last_body_flow, last_body_owners, first_iteration_pending, first_iteration_can_complete, table|:
                                iteration_names: mutable darray[sview @source] = []
                                iteration_fields: mutable darray[sview @source] = []
                                iteration_owners: mutable darray[sview @source] = []
                                iteration_names.extend(comprehension_head_names)
                                iteration_fields.extend(comprehension_head_fields)
                                iteration_owners.extend(comprehension_head_owners)
                                literal_iterable: mutable bool = false
                                match literal_iterable_value:
                                    Expr.Array(_, _) | Expr.Tuple(_, _) | Expr.SetLit(_, _):
                                        literal_iterable <- true
                                    _:
                                        pass
                                if literal_iterable:
                                    bam_bind_loop_literal(variable, literal_iterable_value, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, iteration_names, iteration_fields, iteration_owners, table)
                                else:
                                    bam_scope_unknown_loop_binders([variable], owners, binders, iteration_names, iteration_fields, iteration_owners)
                                condition_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                                if condition is Expr.Absent:
                                    bam_replay_flow_set_normal(condition_flow, iteration_names, iteration_fields, iteration_owners)
                                else:
                                    condition_owners: mutable darray[sview @source] = []
                                    table <- bam_nested_value_owners_scoped(condition, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, iteration_names, iteration_fields, iteration_owners, condition_owners, condition_flow, table)
                                binder_locals: darray[sview @source] = [variable]
                                bam_replay_flow_filter_scope(condition_flow, [], binder_locals, binders, comprehension_head_names, comprehension_head_fields, comprehension_head_owners)
                                condition_post_names: mutable darray[sview @source] = []
                                condition_post_fields: mutable darray[sview @source] = []
                                condition_post_owners: mutable darray[sview @source] = []
                                condition_post_names.extend(iteration_names)
                                condition_post_fields.extend(iteration_fields)
                                condition_post_owners.extend(iteration_owners)
                                bam_filter_rhs_scope_borrow_state([], binder_locals, binders, condition_post_names, condition_post_fields, condition_post_owners, comprehension_head_names, comprehension_head_fields, comprehension_head_owners) if condition_flow.normal_seen
                                next_names: mutable darray[sview @source] = []
                                next_fields: mutable darray[sview @source] = []
                                next_owners: mutable darray[sview @source] = []
                                next_names.extend(comprehension_head_names)
                                next_fields.extend(comprehension_head_fields)
                                next_owners.extend(comprehension_head_owners)
                                if condition_flow.normal_seen:
                                    bam_merge_borrow_state(next_names, next_fields, next_owners, condition_post_names, condition_post_fields, condition_post_owners)
                                body_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                                body_owners: mutable darray[sview @source] = []
                                if condition_flow.normal_seen and body is not Expr.Absent:
                                    table <- bam_nested_value_owners_scoped(body, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, iteration_names, iteration_fields, iteration_owners, body_owners, body_flow, table)
                                    bam_replay_flow_filter_scope(body_flow, [], binder_locals, binders, comprehension_head_names, comprehension_head_fields, comprehension_head_owners)
                                    if body_flow.normal_seen:
                                        body_post_names: mutable darray[sview @source] = []
                                        body_post_fields: mutable darray[sview @source] = []
                                        body_post_owners: mutable darray[sview @source] = []
                                        body_post_names.extend(iteration_names)
                                        body_post_fields.extend(iteration_fields)
                                        body_post_owners.extend(iteration_owners)
                                        bam_filter_rhs_scope_borrow_state([], binder_locals, binders, body_post_names, body_post_fields, body_post_owners, comprehension_head_names, comprehension_head_fields, comprehension_head_owners)
                                        bam_merge_borrow_state(next_names, next_fields, next_owners, body_post_names, body_post_fields, body_post_owners)
                                elif condition_flow.normal_seen:
                                    bam_replay_flow_set_normal(body_flow, iteration_names, iteration_fields, iteration_owners)
                                    bam_replay_flow_filter_scope(body_flow, [], binder_locals, binders, comprehension_head_names, comprehension_head_fields, comprehension_head_owners)
                                if first_iteration_pending:
                                    if condition is not Expr.Absent and condition_flow.normal_seen:
                                        first_iteration_can_complete <- true
                                    else:
                                        first_iteration_can_complete <- condition_flow.normal_seen and body_flow.normal_seen
                                    first_iteration_pending <- false
                                comprehension_grew <- not bam_borrow_state_equal(comprehension_head_names, comprehension_head_fields, comprehension_head_owners, next_names, next_fields, next_owners)
                                last_condition_flow <- condition_flow
                                last_body_flow <- body_flow
                                last_body_owners.truncate(0)
                                last_body_owners.extend(body_owners)
                                if comprehension_grew:
                                    comprehension_head_names.truncate(0)
                                    comprehension_head_fields.truncate(0)
                                    comprehension_head_owners.truncate(0)
                                    comprehension_head_names.extend(next_names)
                                    comprehension_head_fields.extend(next_fields)
                                    comprehension_head_owners.extend(next_owners)
                            bam_replay_flow_merge_exits(flow, last_condition_flow)
                            bam_replay_flow_merge_exits(flow, last_body_flow)
                            reachable <- not definitely_nonempty or first_iteration_can_complete
                            if reachable:
                                bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, comprehension_head_names, comprehension_head_fields, comprehension_head_owners)
                                for owner in last_body_owners |out|:
                                    bam_append_unique_owner(out, owner)
                        else:
                            reachable <- false
                    _:
                        table <- bam_nested_value_owners(value, owners, borrow_names, borrow_fields, borrow_owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, out, table)
                if reachable:
                    bam_replay_flow_set_normal(flow, borrow_names, borrow_fields, borrow_owners)
                else:
                    out.truncate(out_mark)

        # For a literal iterable, bind a single loop variable to the union of its possible
        # elements. This preserves exact owners for `for r in [&owner]` without guessing that an
        # opaque iterator can yield every owner in scope.
        def bam_bind_loop_literal(name: sview @source, iterable: Ast::Expr, owners: darray[sview @source]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, lend_parameter_names: darray[sview]&, extern_lend_ids: darray[DeclId]&, extern_lend_positions: darray[usize]&, extern_lend_names: darray[sview]&, call_targets: BorrowResolvedCallTargets&, binders: BorrowBinders&, borrow_names: mutable darray[sview @source]&, borrow_fields: mutable darray[sview @source]&, borrow_owners: mutable darray[sview @source]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match iterable:
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        base_names: mutable darray[sview @source] = []
                        base_fields: mutable darray[sview @source] = []
                        base_owners: mutable darray[sview @source] = []
                        joined_names: mutable darray[sview @source] = []
                        joined_fields: mutable darray[sview @source] = []
                        joined_owners: mutable darray[sview @source] = []
                        base_names.extend(borrow_names)
                        base_fields.extend(borrow_fields)
                        base_owners.extend(borrow_owners)
                        bam_clear_borrow_fields(name, base_names, base_fields, base_owners)
                        joined_names.extend(base_names)
                        joined_fields.extend(base_fields)
                        joined_owners.extend(base_owners)
                        for element in elements |base_names, base_fields, base_owners, joined_names, joined_fields, joined_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, table|:
                            candidate_names: mutable darray[sview @source] = []
                            candidate_fields: mutable darray[sview @source] = []
                            candidate_owners: mutable darray[sview @source] = []
                            candidate_names.extend(base_names)
                            candidate_fields.extend(base_fields)
                            candidate_owners.extend(base_owners)
                            table <- bam_bind(name, true, element, false, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, candidate_names, candidate_fields, candidate_owners, table)
                            bam_merge_borrow_state(joined_names, joined_fields, joined_owners, candidate_names, candidate_fields, candidate_owners)
                        bam_replace_borrow_state(borrow_names, borrow_fields, borrow_owners, joined_names, joined_fields, joined_owners)
                    _:
                        return
