                                arm_base_names.extend(residual_names)
                                arm_base_fields.extend(residual_fields)
                                arm_base_owners.extend(residual_owners)
                                table <- bam_seed_pattern_borrow_state(arm.pattern, scrutinee, scrutinee_owners, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, arm_names, arm_fields, arm_owners, table)
                                has_guard: bool = match arm.guard:
                                    Expr.Invalid | Expr.Absent: false
                                    _: true
                                pattern_catches_all: bool = bam_match_pattern_catches_all(arm.pattern, table)
                                guard_flow: mutable BorrowReplayFlow = BorrowReplayFlow{}
                                arm_locals: mutable darray[sview @source] = []
                                bam_collect_rhs_pattern_locals(arm.pattern, arm_locals)
                                if has_guard:
