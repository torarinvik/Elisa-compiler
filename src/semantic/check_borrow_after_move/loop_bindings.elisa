                        table <- bam_nested_value_owners_scoped(condition, owners, lend_names, lend_positions, lend_parameter_names, extern_lend_ids, extern_lend_positions, extern_lend_names, call_targets, binders, borrow_names, borrow_fields, borrow_owners, condition_owners, condition_flow, table)
                        bam_replay_flow_merge_exits(flow, condition_flow)
