extend Semantic:
    private:
        def bam_store_call_expression(expression: Ast::Expr, locals: darray[sview]&, ref_params: darray[sview]&, writable_ref_params: darray[sview]&, ref_param_types: darray[u32]&, link_names: darray[sview @source]&, link_targets: darray[sview @source]&, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, lend_names: darray[sview @source]&, lend_positions: darray[usize]&, escape_names: darray[sview @source]&, escape_roots: darray[sview @source]&, detached: darray[BorrowDetachedPlace]&, summary: StoreThroughSummary&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                return if writable_ref_params.count == 0 and summary.globals.count == 0
                match expression:
                    Expr.Call(callee, arguments, _, _):
                        table <- bam_store_call_expression(callee, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        for argument in arguments |table, reference_sites| -> table:
                            table <- bam_store_call_expression(argument, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        rebind specialized_push: bool, table = bam_store_push(expression, locals, ref_params, ref_param_types, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, table)
                        table <- bam_store_call_through(expression, specialized_push, [], locals, writable_ref_params, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                    Expr.StaticEffectCall(_, operation, candidates, arguments, argument_names, _):
                        for candidate in candidates |table, reference_sites| -> table:
                            runtime_arguments: mutable darray[Ast::Expr] @source = []
                            runtime_names: mutable darray[sview @source] @source = []
                            runtime_source_numbers: mutable darray[usize] = []
                            for capture in candidate.captures |runtime_arguments|:
                                runtime_arguments.push(capture)
                                runtime_names.push("")
                                runtime_source_numbers.push(0)
                            argument_index: mutable usize = 0
                            for argument in arguments |runtime_arguments, runtime_names, runtime_source_numbers, argument_index, argument_names|:
                                runtime_arguments.push(argument)
                                runtime_names.push(argument_names[argument_index]) if argument_index < argument_names.count else runtime_names.push("")
                                runtime_source_numbers.push(argument_index + 1)
                                argument_index <- argument_index + 1
                            call_pos: Ast::Pos = Ast::expr_pos(expression)
                            synthetic_call: Ast::Expr = Expr.Call(Expr.Ident(candidate.callee, Ast::pos_at_line(0)), runtime_arguments, runtime_names, call_pos)
                            table <- bam_store_call_through(synthetic_call, false, runtime_source_numbers, locals, writable_ref_params, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                            for capture in candidate.captures |table, reference_sites| -> table:
                                table <- bam_store_call_expression(capture, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        for argument in arguments |table, reference_sites| -> table:
                            table <- bam_store_call_expression(argument, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        return if candidates.count > 0
                        table <- bam_store_unknown_call_targets(expression, operation, arguments, [], [], writable_ref_params, link_names, link_targets, locals, lend_names, lend_positions, escape_names, escape_roots, detached, table)
                    Expr.Scope(base, _, _):
                        table <- bam_store_call_expression(base, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                    Expr.Field(object, _, _):
                        table <- bam_store_call_expression(object, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                    Expr.Index(object, index, _):
                        table <- bam_store_call_expression(object, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        table <- bam_store_call_expression(index, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                    Expr.IndexN(object, indices, _):
                        table <- bam_store_call_expression(object, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        for index in indices |table, reference_sites| -> table:
                            table <- bam_store_call_expression(index, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                    Expr.Slice(object, low, high, _):
                        table <- bam_store_call_expression(object, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        table <- bam_store_call_expression(low, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        table <- bam_store_call_expression(high, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                    Expr.Binary(left, _, right, _):
                        table <- bam_store_call_expression(left, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        table <- bam_store_call_expression(right, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                    Expr.Unary(_, operand, _) | Expr.Move(operand, _) | Expr.Paren(operand, _) | Expr.RegionNew(operand, _, _):
                        table <- bam_store_call_expression(operand, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                    Expr.If(condition, then_value, else_value, _):
                        table <- bam_store_call_expression(condition, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        callable_base: mutable darray[BorrowLocalCallable] = []
                        callable_base.extend(reference_sites.local_callables)
                        table <- bam_store_call_expression(then_value, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        then_callables: mutable darray[BorrowLocalCallable] = []
                        then_callables.extend(reference_sites.local_callables)
                        borrow_restore_local_callables(reference_sites, callable_base)
                        table <- bam_store_call_expression(else_value, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        else_callables: mutable darray[BorrowLocalCallable] = []
                        else_callables.extend(reference_sites.local_callables)
                        borrow_merge_local_callable_states(reference_sites, then_callables, else_callables)
                    Expr.Array(elements, _) | Expr.Tuple(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |table, reference_sites| -> table:
                            table <- bam_store_call_expression(element, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                    Expr.DictLit(entries, _):
                        for entry in entries |table, reference_sites| -> table:
                            table <- bam_store_call_expression(entry.key, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                            table <- bam_store_call_expression(entry.value, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                    Expr.Construct(head, fields, _) | Expr.RecordUpdate(head, fields, _):
                        table <- bam_store_call_expression(head, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        for field in fields |table, reference_sites| -> table:
                            table <- bam_store_call_expression(field.value, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                    Expr.Match(scrutinee, arms, _) | Expr.Catch(scrutinee, arms, _):
                        table <- bam_store_call_expression(scrutinee, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        callable_base: mutable darray[BorrowLocalCallable] = []
                        callable_base.extend(reference_sites.local_callables)
                        joined_callables: mutable darray[BorrowLocalCallable] = []
                        joined_callables.extend(reference_sites.local_callables)
                        for arm in arms |table, reference_sites, joined_callables| -> table:
                            borrow_restore_local_callables(reference_sites, callable_base)
                            table <- bam_store_call_expression(arm.guard, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                            table <- bam_store_call_statements(arm.body, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                            arm_callables: mutable darray[BorrowLocalCallable] = []
                            arm_callables.extend(reference_sites.local_callables)
                            joined_callables <- borrow_join_local_callable_states(joined_callables, arm_callables)
                        borrow_restore_local_callables(reference_sites, joined_callables)
                    Expr.Comprehension(iterable: iterable, condition: condition, body: body, _):
                        table <- bam_store_call_expression(iterable, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        table <- bam_store_call_expression(condition, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        table <- bam_store_call_expression(body, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                    Expr.Refinement(base, predicate, _):
                        table <- bam_store_call_expression(base, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        table <- bam_store_call_expression(predicate, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                    Expr.GetElse(guarded, recovery, _):
                        table <- bam_store_call_expression(guarded, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        callable_before_recovery: mutable darray[BorrowLocalCallable] = []
                        callable_before_recovery.extend(reference_sites.local_callables)
                        table <- bam_store_call_statements(recovery, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        callable_after_recovery: mutable darray[BorrowLocalCallable] = []
                        callable_after_recovery.extend(reference_sites.local_callables)
                        borrow_merge_local_callable_states(reference_sites, callable_before_recovery, callable_after_recovery)
                    Expr.Block(body, value, _, _):
                        table <- bam_store_call_statements(body, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        table <- bam_store_call_expression(value, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                    _:
                        pass

        def bam_store_call_statements(statements: darray[Ast::Stmt], locals: darray[sview]&, ref_params: darray[sview]&, writable_ref_params: darray[sview]&, ref_param_types: darray[u32]&, link_names: darray[sview @source]&, link_targets: darray[sview @source]&, function_owner: DeclId, reference_sites: mutable BorrowReferenceSites&, lend_names: darray[sview @source]&, lend_positions: darray[usize]&, escape_names: darray[sview @source]&, escape_roots: darray[sview @source]&, detached: darray[BorrowDetachedPlace]&, summary: StoreThroughSummary&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                for statement in statements |table, reference_sites| -> table:
                    match statement:
                        Stmt.VarDecl(name, _, value, declaration_pos):
                            table <- bam_store_call_expression(value, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                            binder_pos: mutable Ast::Pos = source_binder_position(table, name, declaration_pos.line, 0, "__pattern_binder")
                            binder_pos <- declaration_pos if binder_pos.line == 0
                            bam_remember_local_callable(binder_pos, value, function_owner, reference_sites, table, lend_names, lend_positions, summary.globals)
                        Stmt.Assign(target, _, value, _):
                            table <- bam_store_call_expression(target, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                            table <- bam_store_call_expression(value, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                            match target:
                                Expr.Ident(_, target_pos):
                                    bam_remember_local_callable(target_pos, value, function_owner, reference_sites, table, lend_names, lend_positions, summary.globals)
                                _:
                                    pass
                        Stmt.Expr(value, _):
                            table <- bam_store_call_expression(value, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        Stmt.If(condition, then_body, else_body, _):
                            table <- bam_store_call_expression(condition, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                            callable_base: mutable darray[BorrowLocalCallable] = []
                            callable_base.extend(reference_sites.local_callables)
                            table <- bam_store_call_statements(then_body, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                            then_callables: mutable darray[BorrowLocalCallable] = []
                            then_callables.extend(reference_sites.local_callables)
                            borrow_restore_local_callables(reference_sites, callable_base)
                            table <- bam_store_call_statements(else_body, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                            else_callables: mutable darray[BorrowLocalCallable] = []
                            else_callables.extend(reference_sites.local_callables)
                            borrow_merge_local_callable_states(reference_sites, then_callables, else_callables)
                        Stmt.While(condition, body, _):
                            table <- bam_store_call_expression(condition, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                            loop_callables: mutable darray[BorrowLocalCallable] = []
                            loop_callables.extend(reference_sites.local_callables)
                            callable_changed: mutable bool = true
                            while callable_changed |callable_changed, table, reference_sites|:
                                borrow_restore_local_callables(reference_sites, loop_callables)
                                # The next iteration may have rebound a local callee used
                                # by the condition, so resolve it against each joined state.
                                table <- bam_store_call_expression(condition, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                                table <- bam_store_call_statements(body, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                                body_callables: mutable darray[BorrowLocalCallable] = []
                                body_callables.extend(reference_sites.local_callables)
                                next_callables: darray[BorrowLocalCallable] = borrow_join_local_callable_states(loop_callables, body_callables)
                                callable_changed <- not borrow_local_callable_states_equal(loop_callables, next_callables)
                                loop_callables.truncate(0)
                                loop_callables.extend(next_callables)
                            borrow_restore_local_callables(reference_sites, loop_callables)
                        Stmt.For(_, variables, iterable, body, for_pos):
                            table <- bam_store_call_expression(iterable, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                            bam_remember_loop_literal_callable(variables, iterable, for_pos, function_owner, reference_sites, table, lend_names, lend_positions, summary.globals)
                            loop_callables: mutable darray[BorrowLocalCallable] = []
                            loop_callables.extend(reference_sites.local_callables)
                            callable_changed: mutable bool = true
                            while callable_changed |callable_changed, table, reference_sites|:
                                borrow_restore_local_callables(reference_sites, loop_callables)
                                table <- bam_store_call_statements(body, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                                body_callables: mutable darray[BorrowLocalCallable] = []
                                body_callables.extend(reference_sites.local_callables)
                                next_callables: darray[BorrowLocalCallable] = borrow_join_local_callable_states(loop_callables, body_callables)
                                callable_changed <- not borrow_local_callable_states_equal(loop_callables, next_callables)
                                loop_callables.truncate(0)
                                loop_callables.extend(next_callables)
                            borrow_restore_local_callables(reference_sites, loop_callables)
                        Stmt.Return(value, _):
                            if value is returned_expression:
                                table <- bam_store_call_expression(returned_expression, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        Stmt.Block(body: body, _):
                            table <- bam_store_call_statements(body, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        Stmt.Match(scrutinee, arms, _):
                            table <- bam_store_call_expression(scrutinee, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                            callable_base: mutable darray[BorrowLocalCallable] = []
                            callable_base.extend(reference_sites.local_callables)
                            joined_callables: mutable darray[BorrowLocalCallable] = []
                            joined_callables.extend(reference_sites.local_callables)
                            for arm in arms |table, reference_sites, joined_callables| -> table:
                                borrow_restore_local_callables(reference_sites, callable_base)
                                table <- bam_store_call_expression(arm.guard, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                                table <- bam_store_call_statements(arm.body, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                                arm_callables: mutable darray[BorrowLocalCallable] = []
                                arm_callables.extend(reference_sites.local_callables)
                                joined_callables <- borrow_join_local_callable_states(joined_callables, arm_callables)
                            borrow_restore_local_callables(reference_sites, joined_callables)
                        Stmt.Contract(_, value, _):
                            table <- bam_store_call_expression(value, locals, ref_params, writable_ref_params, ref_param_types, link_names, link_targets, function_owner, reference_sites, lend_names, lend_positions, escape_names, escape_roots, detached, summary, table)
                        _:
                            pass

        def bam_strip_paren(expression: Ast::Expr) -> Ast::Expr:
            can Abort.Panic:
                match expression:
                    Expr.Paren(stripped_inner, _):
                        return bam_strip_paren(stripped_inner)
                    _:
                        return expression

        def bam_store_capture_pattern(pattern: Ast::Pattern, out: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Pin(name):
                        out.push(name) if name != ""
                    Pattern.As(_, nested) | Pattern.Variant(_, nested) | Pattern.Struct(_, nested) | Pattern.Field(_, nested) | Pattern.Tuple(nested) | Pattern.Or(nested):
                        for child in nested |out|:
                            bam_store_capture_pattern(child, out)
                    _:
                        pass
