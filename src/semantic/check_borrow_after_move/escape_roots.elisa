extend Semantic:
    private:
        # Collect local-storage roots carried by a value. Bindings are stored as groups in
        # `escape_names`/`escape_roots`; an empty root starts a new binding version and stops
        # lookup from reaching an older assignment.
        def bam_escape_collect_roots(value: Ast::Expr, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: darray[sview @source]&, escape_roots: darray[sview @source]&, detached: darray[BorrowDetachedPlace]&, out_roots: mutable darray[sview @source]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Unary(operator, operand, _) if operator == TokenKind.Ampersand:
                        root: sview = bam_place_root(operand)
                        out_roots.push(root) if root != ""
                    Expr.Index(Expr.Field(receiver, selector, _), _, _) if selector == "ref":
                        root: sview = bam_place_root(receiver)
                        out_roots.push(root) if root != ""
                    Expr.Call(_, _, _, _):
                        bam_escape_collect_lend_call_roots(value, lend_names, lend_positions, escape_names, escape_roots, detached, out_roots)
                    Expr.Ident(name, _):
                        found_alias: mutable bool = false
                        alias_index: mutable usize = escape_names.count
                        while alias_index > 0 |alias_index, escape_names, escape_roots, found_alias, out_roots|:
                            alias_index <- alias_index - 1
                            if escape_names[alias_index] == name:
                                if escape_roots[alias_index] == "":
                                    break
                                out_roots.push(escape_roots[alias_index])
                                found_alias <- true
                    Expr.Field(object, _, _):
                        bam_escape_collect_roots(object, lend_names, lend_positions, escape_names, escape_roots, detached, out_roots)
                    Expr.Construct(_, fields, _):
                        for initializer in fields |out_roots|:
                            bam_escape_collect_roots(initializer.value, lend_names, lend_positions, escape_names, escape_roots, detached, out_roots)
                    Expr.RecordUpdate(base, fields, _):
                        bam_escape_collect_roots(base, lend_names, lend_positions, escape_names, escape_roots, detached, out_roots)
                        for initializer in fields |out_roots|:
                            bam_escape_collect_roots(initializer.value, lend_names, lend_positions, escape_names, escape_roots, detached, out_roots)
                    Expr.Tuple(elements, _) | Expr.Array(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |out_roots|:
                            bam_escape_collect_roots(element, lend_names, lend_positions, escape_names, escape_roots, detached, out_roots)
                    Expr.DictLit(entries, _):
                        for entry in entries |out_roots|:
                            bam_escape_collect_roots(entry.value, lend_names, lend_positions, escape_names, escape_roots, detached, out_roots)
                    Expr.If(_, then_value, else_value, _):
                        bam_escape_collect_roots(then_value, lend_names, lend_positions, escape_names, escape_roots, detached, out_roots)
                        bam_escape_collect_roots(else_value, lend_names, lend_positions, escape_names, escape_roots, detached, out_roots)
                    Expr.Paren(inner, _) | Expr.Move(inner, _) | Expr.RegionNew(inner, _, _):
                        bam_escape_collect_roots(inner, lend_names, lend_positions, escape_names, escape_roots, detached, out_roots)
                    Expr.Block(value: block_value, _):
                        bam_escape_collect_roots(block_value, lend_names, lend_positions, escape_names, escape_roots, detached, out_roots)
                    _:
                        pass

        def bam_expression_is_direct_borrow(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Unary(operator, _, _):
                        return operator == TokenKind.Ampersand
                    Expr.Index(Expr.Field(receiver, selector, _), target, _):
                        return selector == "ref" or (selector == "cast" and bam_type_is_address(target) and bam_expression_is_direct_borrow(receiver))
                    Expr.Paren(inner, _):
                        return bam_expression_is_direct_borrow(inner)
                    _:
                        return false

        def bam_return_uses_aggregate_diagnostic(expression: Ast::Expr, aggregate_result: bool, direct_reference_result: bool) -> bool:
            can Abort.Panic:
                return true if aggregate_result
                return direct_reference_result and not bam_expression_is_direct_borrow(expression)

        def bam_escape_anchor(returned: Ast::Expr) -> Ast::Pos:
            can Abort.Panic:
                match returned:
                    Expr.Construct(construct_type, _, _):
                        return Ast::expr_pos(construct_type)
                    _:
                        return Ast::expr_pos(returned)

        def bam_report_escape(returned: Ast::Expr, locals: darray[sview]&, perm_containers: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: darray[sview @source]&, escape_roots: darray[sview @source]&, detached: darray[BorrowDetachedPlace]&, aggregate_result: bool, anchor: Ast::Pos, anchored: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # stage0 reports the escape at the RETURNED expression's first token, not at
                # the `&` nested inside a literal; compound arms pass that anchor inward.
                nested_anchor: Ast::Pos = anchor if anchored else bam_escape_anchor(returned)
                match returned:
                    Expr.Unary(return_operator, return_operand, return_pos):
                        return if return_operator != TokenKind.Ampersand or (anchored and bam_place_is_detached(return_operand, detached))
                        table <- bam_report_escape_root(bam_place_root(return_operand), (anchor if anchored else return_pos), locals, aggregate_result, table)
                    # `x.ref[T]` -- the REMOVED reference shorthand. stage0 reports its removal
                    # and then keeps analysing it as `&x`, so the dangle lands too; stage1 used
                    # to stop at the removal message and let the use-after-free through.
                    Expr.Index(Expr.Field(ref_receiver, ref_selector, ref_field_pos), ref_target, ref_index_pos):
                        # `(&x).cast[T&?]` (also inside `trusted`) still points at x.
                        if ref_selector == "cast" and bam_type_is_address(ref_target):
                            # stage0's `perm` rule: a `static T&` function allocates its containers
                            # in `perm`, so `(&out[i]).cast[static T&]` outlives the frame.
                            return if bam_annotation_is_static(ref_target) and bam_borrow_is_element(bam_strip_paren(ref_receiver)) and (any perm_name in perm_containers where perm_name == bam_borrow_root(bam_strip_paren(ref_receiver)))
                            table <- bam_report_escape_root(bam_borrow_root(bam_strip_paren(ref_receiver)), (anchor if anchored else ref_field_pos), locals, aggregate_result, table)
                            return
                        return if ref_selector != "ref"
                        table <- bam_report_escape_root(bam_place_root(ref_receiver), (anchor if anchored else ref_index_pos), locals, aggregate_result, table)
                    Expr.Call(pos: call_pos, _):
                        roots: mutable darray[sview @source] = []
                        bam_escape_collect_roots(returned, lend_names, lend_positions, escape_names, escape_roots, detached, roots)
                        for root in roots |table| -> table:
                            table <- bam_report_escape_root(root, (anchor if anchored else call_pos), locals, aggregate_result, table)
                    Expr.Ident(returned_name, returned_pos):
                        roots: mutable darray[sview @source] = []
                        bam_escape_collect_roots(returned, lend_names, lend_positions, escape_names, escape_roots, detached, roots)
                        for root in roots |table| -> table:
                            table <- bam_report_escape_root(root, (anchor if anchored else returned_pos), locals, aggregate_result, table)
                    Expr.Field(field_object, _, field_pos):
                        roots: mutable darray[sview @source] = []
                        bam_escape_collect_roots(field_object, lend_names, lend_positions, escape_names, escape_roots, detached, roots)
                        for root in roots |table| -> table:
                            table <- bam_report_escape_root(root, (anchor if anchored else field_pos), locals, aggregate_result, table)
                    Expr.Construct(_, fields, _):
                        for initializer in fields |table| -> table:
                            table <- bam_report_escape(initializer.value, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, detached, aggregate_result, nested_anchor, true, table)
                    Expr.RecordUpdate(base, fields, _):
                        table <- bam_report_escape(base, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, detached, aggregate_result, nested_anchor, true, table)
                        for initializer in fields |table| -> table:
                            table <- bam_report_escape(initializer.value, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, detached, aggregate_result, nested_anchor, true, table)
                    Expr.Tuple(elements, _) | Expr.Array(elements, _) | Expr.SetLit(elements, _):
                        for element in elements |table| -> table:
                            table <- bam_report_escape(element, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, detached, aggregate_result, nested_anchor, true, table)
                    Expr.DictLit(entries, _):
                        for entry in entries |table| -> table:
                            table <- bam_report_escape(entry.value, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, detached, aggregate_result, nested_anchor, true, table)
                    Expr.If(_, then_value, else_value, _):
                        table <- bam_report_escape(then_value, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, detached, aggregate_result, nested_anchor, true, table)
                        table <- bam_report_escape(else_value, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, detached, aggregate_result, nested_anchor, true, table)
                    Expr.Paren(inner, _) | Expr.Move(inner, _) | Expr.RegionNew(inner, _, _):
                        table <- bam_report_escape(inner, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, detached, aggregate_result, nested_anchor, true, table)
                    Expr.Block(block_statements, block_value, _, _):
                        table <- bam_report_escape(block_value, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, detached, aggregate_result, nested_anchor, true, table)
                    _:
                        pass

        # `name = value`: a fresh binding version holding the value's local-storage roots.
        def bam_escape_track_declaration(declared_name: sview @source, declared_value: Ast::Expr, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: mutable darray[sview @source]&, escape_roots: mutable darray[sview @source]&, detached: darray[BorrowDetachedPlace]&) -> void:
            can Memory.Allocate, Abort.Panic:
                declared_roots: mutable darray[sview @source] = []
                bam_escape_collect_roots(declared_value, lend_names, lend_positions, escape_names, escape_roots, detached, declared_roots)
                escape_names.push(declared_name)
                escape_roots.push("")
                for declared_root in declared_roots |escape_names, escape_roots|:
                    escape_names.push(declared_name)
                    escape_roots.push(declared_root)

        def bam_escape_track_assign(assign_target: Ast::Expr, assign_value: Ast::Expr, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: mutable darray[sview @source]&, escape_roots: mutable darray[sview @source]&, detached: darray[BorrowDetachedPlace]&) -> void:
            can Memory.Allocate, Abort.Panic:
                assigned_name: sview = bam_place_root(assign_target)
                return if assigned_name == ""
                assigned_roots: mutable darray[sview @source] = []
                bam_escape_collect_roots(assign_value, lend_names, lend_positions, escape_names, escape_roots, detached, assigned_roots)
                # An interior write changes one field/element, not the whole
                # aggregate. Preserve other possibly-borrowed members.
                if bam_place_is_interior(assign_target):
                    existing_roots: darray[sview @source] = bam_escape_roots_for_binding(assigned_name, escape_names, escape_roots)
                    for existing_root in existing_roots |assigned_roots|:
                        assigned_roots.push(existing_root) if not (any known_root in assigned_roots where known_root == existing_root)
                escape_names.push(assigned_name)
                escape_roots.push("")
                for assigned_root in assigned_roots |escape_names, escape_roots|:
                    escape_names.push(assigned_name)
                    escape_roots.push(assigned_root)

        # The container methods that RETAIN their arguments (stage0's
        # returnBorrowContainerInsertMethods).
        def bam_is_container_insert(method: sview) -> bool:
            can Abort.Panic:
                return when method:
                    "push" | "extend" | "insert" | "put" | "add" | "append" | "push_back" | "push_front" | "set" -> true
                    _ -> false

        # `out.push(&x)` as a statement: the receiver now ALSO holds the arguments' roots, so a
        # later `return out` carries them. The receiver's existing roots stay.
        def bam_escape_track_insert(statement_value: Ast::Expr, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: mutable darray[sview @source]&, escape_roots: mutable darray[sview @source]&, detached: darray[BorrowDetachedPlace]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match statement_value:
                    Expr.Call(Expr.Field(insert_receiver, insert_method, _), insert_arguments, _, _):
                        return if not bam_is_container_insert(insert_method)
                        receiver_name: sview = bam_place_root(insert_receiver)
                        return if receiver_name == ""
                        inserted_roots: mutable darray[sview @source] = []
                        for insert_argument in insert_arguments |inserted_roots|:
                            bam_escape_collect_roots(insert_argument, lend_names, lend_positions, escape_names, escape_roots, detached, inserted_roots)
                        return if inserted_roots.count == 0
                        existing_roots: darray[sview @source] = bam_escape_roots_for_binding(receiver_name, escape_names, escape_roots)
                        escape_names.push(receiver_name)
                        escape_roots.push("")
                        for existing_root in existing_roots |escape_names, escape_roots|:
                            escape_names.push(receiver_name)
                            escape_roots.push(existing_root)
                        for inserted_root in inserted_roots |escape_names, escape_roots, existing_roots|:
                            if not (any known_root in existing_roots where known_root == inserted_root):
                                escape_names.push(receiver_name)
                                escape_roots.push(inserted_root)
                    _:
                        pass

        def bam_escape_statements[@r](statements: darray[Ast::Stmt], locals: darray[sview]&, perm_containers: darray[sview]&, lend_names: darray[sview]&, lend_positions: darray[usize]&, escape_names: mutable darray[sview @source]& @r, escape_roots: mutable darray[sview @source]& @r, detached: darray[BorrowDetachedPlace]&, table: lmut SymbolTable, aggregate_result: bool, direct_reference_result: bool, tail_value: bool) -> void:
            can Memory.Allocate, Abort.Panic:
                statement_index: mutable usize = 0
                for statement in statements |table, statement_index, escape_names, escape_roots| -> table:
                    match statement:
                        Stmt.Return(returned_option, returned_pos):
                            if returned_option is returned_expression:
                                table <- bam_report_escape(returned_expression, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, detached, bam_return_uses_aggregate_diagnostic(returned_expression, aggregate_result, direct_reference_result), Ast::expr_pos(returned_expression), false, table)
                        # A body's tail expression is its return value.
                        Stmt.Expr(tail_expression, tail_pos):
                            is_tail_expression: bool = tail_value and statement_index + 1 == statements.count
                            # A value-form loop (`for v in xs |acc| -> acc:`) keeps its
                            # Expr.Block shape in the loop view: its statements write the
                            # captured names like a loop body, and only its yield is a value.
                            value_block: mutable bool = false
                            match tail_expression:
                                Expr.Block(value_block_statements, value_block_value, _, _):
                                    value_block <- true
                                    block_names: mutable darray[sview @source] @r = []
                                    block_roots: mutable darray[sview @source] @r = []
                                    block_names.extend(escape_names)
                                    block_roots.extend(escape_roots)
                                    table <- bam_escape_statements(value_block_statements, locals, perm_containers, lend_names, lend_positions, block_names, block_roots, detached, table, aggregate_result, direct_reference_result, false)
                                    bam_escape_merge_branch(escape_names, escape_roots, block_names, block_roots)
                                    if is_tail_expression and not (value_block_value is Ast::Expr.Invalid):
                                        table <- bam_report_escape(value_block_value, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, detached, bam_return_uses_aggregate_diagnostic(value_block_value, aggregate_result, direct_reference_result), Ast::expr_pos(value_block_value), false, table)
                                _:
                                    pass
                            if is_tail_expression and not value_block:
                                table <- bam_report_escape(tail_expression, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, detached, bam_return_uses_aggregate_diagnostic(tail_expression, aggregate_result, direct_reference_result), Ast::expr_pos(tail_expression), false, table)
                            elif not value_block:
                                bam_escape_track_insert(tail_expression, lend_names, lend_positions, escape_names, escape_roots, detached)
                        Stmt.VarDecl(declared_name, _, declared_value, _):
                            bam_escape_track_declaration(declared_name, declared_value, lend_names, lend_positions, escape_names, escape_roots, detached)
                        Stmt.Assign(assign_target, _, assign_value, _):
                            bam_escape_track_assign(assign_target, assign_value, lend_names, lend_positions, escape_names, escape_roots, detached)
                        Stmt.If(branch_condition, branch_then, branch_else, branch_pos):
                            then_names: mutable darray[sview @source] @r = []
                            then_roots: mutable darray[sview @source] @r = []
                            else_names: mutable darray[sview @source] @r = []
                            else_roots: mutable darray[sview @source] @r = []
                            then_names.extend(escape_names)
                            then_roots.extend(escape_roots)
                            else_names.extend(escape_names)
                            else_roots.extend(escape_roots)
                            table <- bam_escape_statements(branch_then, locals, perm_containers, lend_names, lend_positions, then_names, then_roots, detached, table, aggregate_result, direct_reference_result, false)
                            table <- bam_escape_statements(branch_else, locals, perm_containers, lend_names, lend_positions, else_names, else_roots, detached, table, aggregate_result, direct_reference_result, false)
                            bam_escape_merge_branch(escape_names, escape_roots, then_names, then_roots)
                            bam_escape_merge_branch(escape_names, escape_roots, else_names, else_roots)
                        Stmt.While(loop_condition, loop_body, loop_pos):
                            loop_names: mutable darray[sview @source] @r = []
                            loop_roots: mutable darray[sview @source] @r = []
                            loop_names.extend(escape_names)
                            loop_roots.extend(escape_roots)
                            table <- bam_escape_statements(loop_body, locals, perm_containers, lend_names, lend_positions, loop_names, loop_roots, detached, table, aggregate_result, direct_reference_result, false)
                            bam_escape_merge_branch(escape_names, escape_roots, loop_names, loop_roots)
                        Stmt.For(for_bind, for_variables, for_iterable, for_body, for_pos):
                            loop_names: mutable darray[sview @source] @r = []
                            loop_roots: mutable darray[sview @source] @r = []
                            loop_names.extend(escape_names)
                            loop_roots.extend(escape_roots)
                            table <- bam_escape_statements(for_body, locals, perm_containers, lend_names, lend_positions, loop_names, loop_roots, detached, table, aggregate_result, direct_reference_result, false)
                            bam_escape_merge_branch(escape_names, escape_roots, loop_names, loop_roots)
                        Stmt.Block(block_kind, block_clause, block_binding, block_body, block_pos):
                            table <- bam_escape_statements(block_body, locals, perm_containers, lend_names, lend_positions, escape_names, escape_roots, detached, table, aggregate_result, direct_reference_result, false)
                        Stmt.Match(match_scrutinee, match_arms, match_pos):
                            base_names: mutable darray[sview @source] @r = []
                            base_roots: mutable darray[sview @source] @r = []
                            base_names.extend(escape_names)
                            base_roots.extend(escape_roots)
                            for match_arm in match_arms |table, base_names, base_roots, escape_names, escape_roots| -> table:
                                arm_names: mutable darray[sview @source] @r = []
                                arm_roots: mutable darray[sview @source] @r = []
                                arm_names.extend(base_names)
                                arm_roots.extend(base_roots)
                                table <- bam_escape_statements(match_arm.body, locals, perm_containers, lend_names, lend_positions, arm_names, arm_roots, detached, table, aggregate_result, direct_reference_result, false)
                                bam_escape_merge_branch(escape_names, escape_roots, arm_names, arm_roots)
                        _:
                            pass
                    statement_index <- statement_index + 1

