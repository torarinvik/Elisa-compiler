extend Semantic:
    private:
        # Every call argument, struct-literal field, UFCS receiver and field-access base is a
        # destination; everything else is only descended into.
        def rr_check_expression(expression: Ast::Expr, return_type: Ast::Expr, names: mutable darray[sview]&, kinds: mutable darray[u16]&, origins: mutable darray[sview @source]&, declarations: darray[Ast::Decl]&, extern_params: darray[Ast::ExternParam]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        table <- rr_check_call(callee, arguments, argument_names, names, kinds, origins, declarations, extern_params, table)
                        match callee:
                            Expr.Field(method_receiver, method_name, method_pos):
                                table <- rr_check_expression(method_receiver, return_type, names, kinds, origins, declarations, extern_params, table)
                            _:
                                table <- rr_check_expression(callee, return_type, names, kinds, origins, declarations, extern_params, table)
                        table <- rr_check_expressions(arguments, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.StaticEffectCall(effect_type, operation, candidates, effect_arguments, effect_argument_names, effect_pos):
                        table <- rr_check_expressions(effect_arguments, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.Field(object, field, field_pos):
                        base_name: sview = rr_reborrowed_name(object, names, kinds)
                        table <- rr_report(object, 1, names, kinds, origins, table) if base_name != "" and rr_is_struct_member(field, declarations)
                        table <- rr_check_expression(object, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.Scope(scope_base, scope_name, scope_pos):
                        table <- rr_check_expression(scope_base, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.Index(indexed, index, index_pos):
                        table <- rr_check_expression(indexed, return_type, names, kinds, origins, declarations, extern_params, table)
                        table <- rr_check_expression(index, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.Slice(sliced, low, high, slice_pos):
                        table <- rr_check_expression(sliced, return_type, names, kinds, origins, declarations, extern_params, table)
                        table <- rr_check_expression(low, return_type, names, kinds, origins, declarations, extern_params, table)
                        table <- rr_check_expression(high, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.IndexN(indexed_n, index_arguments, index_n_pos):
                        table <- rr_check_expression(indexed_n, return_type, names, kinds, origins, declarations, extern_params, table)
                        table <- rr_check_expressions(index_arguments, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.Binary(left, operator, right, binary_pos):
                        table <- rr_check_expression(left, return_type, names, kinds, origins, declarations, extern_params, table)
                        table <- rr_check_expression(right, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.Unary(operator, operand, unary_pos):
                        table <- rr_check_expression(operand, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.Move(moved, move_pos):
                        table <- rr_check_expression(moved, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.RegionNew(allocated, region, region_pos):
                        table <- rr_check_expression(allocated, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.Paren(paren_inner, paren_pos):
                        table <- rr_check_expression(paren_inner, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.Array(array_elements, array_pos):
                        table <- rr_check_expressions(array_elements, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.Tuple(tuple_elements, tuple_pos):
                        table <- rr_check_expressions(tuple_elements, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.SetLit(set_elements, set_pos):
                        table <- rr_check_expressions(set_elements, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.DictLit(entries, dict_pos):
                        for entry in entries |table, names, kinds, origins| -> table:
                            table <- rr_check_expression(entry.key, return_type, names, kinds, origins, declarations, extern_params, table)
                            table <- rr_check_expression(entry.value, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.Construct(construct_type, construct_fields, construct_pos):
                        constructed: sview = rr_construct_type_name(construct_type)
                        for field_init in construct_fields |table, names, kinds, origins| -> table:
                            table <- rr_report(field_init.value, 1, names, kinds, origins, table) if rr_is_suspect(field_init.value, names, kinds) and rr_field_rejects(constructed, field_init.name, declarations, table)
                            table <- rr_check_expression(field_init.value, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.RecordUpdate(update_base, update_fields, update_pos):
                        table <- rr_check_expression(update_base, return_type, names, kinds, origins, declarations, extern_params, table)
                        for update_field in update_fields |table, names, kinds, origins| -> table:
                            table <- rr_check_expression(update_field.value, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.If(condition, then_expr, else_expr, if_pos):
                        table <- rr_check_expression(condition, return_type, names, kinds, origins, declarations, extern_params, table)
                        table <- rr_check_expression(then_expr, return_type, names, kinds, origins, declarations, extern_params, table)
                        table <- rr_check_expression(else_expr, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.Match(scrutinee, match_arms, match_pos):
                        table <- rr_check_expression(scrutinee, return_type, names, kinds, origins, declarations, extern_params, table)
                        table <- rr_check_arms(match_arms, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.Catch(guarded, catch_arms, catch_pos):
                        table <- rr_check_expression(guarded, return_type, names, kinds, origins, declarations, extern_params, table)
                        table <- rr_check_arms(catch_arms, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.Comprehension(loop_variable, iterable, comprehension_condition, comprehension_body, comprehension_pos, _):
                        table <- rr_check_expression(iterable, return_type, names, kinds, origins, declarations, extern_params, table)
                        comprehension_mark: usize = names.count
                        rr_bind(loop_variable, 0, sview("", 0, 0), names, kinds, origins)
                        table <- rr_check_expression(comprehension_condition, return_type, names, kinds, origins, declarations, extern_params, table)
                        table <- rr_check_expression(comprehension_body, return_type, names, kinds, origins, declarations, extern_params, table)
                        rr_restore(comprehension_mark, names, kinds, origins)
                    Expr.Refinement(refined, predicate, refinement_pos):
                        table <- rr_check_expression(refined, return_type, names, kinds, origins, declarations, extern_params, table)
                        table <- rr_check_expression(predicate, return_type, names, kinds, origins, declarations, extern_params, table)
                    Expr.GetElse(get_guarded, recovery, get_pos):
                        table <- rr_check_expression(get_guarded, return_type, names, kinds, origins, declarations, extern_params, table)
                        recovery_mark: usize = names.count
                        table <- rr_check_statements(recovery, return_type, names, kinds, origins, declarations, extern_params, table)
                        rr_restore(recovery_mark, names, kinds, origins)
                    Expr.Lambda(lambda_params, lambda_body, lambda_pos):
                        # A lambda's `return` answers to the lambda, whose type is not declared.
                        lambda_mark: usize = names.count
                        for lambda_param in lambda_params |names, kinds, origins|:
                            rr_bind(lambda_param, 0, sview("", 0, 0), names, kinds, origins)
                        table <- rr_check_statements(lambda_body, (Ast::Expr.Invalid), names, kinds, origins, declarations, extern_params, table)
                        rr_restore(lambda_mark, names, kinds, origins)
                    Expr.Block(block_stmts, block_value, block_captures, block_pos):
                        block_mark: usize = names.count
                        table <- rr_check_statements(block_stmts, (Ast::Expr.Invalid), names, kinds, origins, declarations, extern_params, table)
                        table <- rr_check_expression(block_value, (Ast::Expr.Invalid), names, kinds, origins, declarations, extern_params, table)
                        rr_restore(block_mark, names, kinds, origins)
                    _:
                        pass

        def rr_check_statements(statements: darray[Ast::Stmt], return_type: Ast::Expr, names: mutable darray[sview]&, kinds: mutable darray[u16]&, origins: mutable darray[sview @source]&, declarations: darray[Ast::Decl]&, extern_params: darray[Ast::ExternParam]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, names, kinds, origins| -> table:
                    match statement:
                        Stmt.Expr(expression, expression_pos):
                            table <- rr_check_expression(expression, return_type, names, kinds, origins, declarations, extern_params, table)
                        Stmt.VarDecl(declared_name, type_expression, value, declaration_pos):
                            table <- rr_check_expression(value, return_type, names, kinds, origins, declarations, extern_params, table)
                            annotated: bool = rr_is_annotated(type_expression)
                            # The parser spells a typed `with` as this synthesized borrow.
                            with_state: u32 = 2 if declared_name == "__with_place" else 1
                            table <- rr_report(value, with_state, names, kinds, origins, table) if annotated and rr_is_suspect(value, names, kinds) and rr_destination_rejects(type_expression, table)
                            # A written type decides the binding's kind; an inferred one follows the value.
                            bound_kind: u8 = rr_binding_kind_of_type(type_expression) if annotated else rr_inferred_kind(value, names, kinds)
                            bound_origin: sview = sview("", 0, 0) if annotated else rr_ident_name(rr_address_operand(value))
                            rr_bind(declared_name, bound_kind, bound_origin, names, kinds, origins)
                        Stmt.Assign(target, operator, assigned, assign_pos):
                            table <- rr_check_expression(target, return_type, names, kinds, origins, declarations, extern_params, table)
                            table <- rr_check_expression(assigned, return_type, names, kinds, origins, declarations, extern_params, table)
                            # `name = value` DEFINES `name`; `<-` only stores into it.
                            rr_bind(rr_ident_name(target), rr_inferred_kind(assigned, names, kinds), rr_ident_name(rr_address_operand(assigned)), names, kinds, origins) if operator == TokenKind.Assign
                        Stmt.Return(returned_value, return_pos):
                            if returned_value is returned:
                                table <- rr_check_expression(returned, return_type, names, kinds, origins, declarations, extern_params, table)
                                table <- rr_report(returned, 1, names, kinds, origins, table) if rr_is_suspect(returned, names, kinds) and rr_destination_rejects(return_type, table)
                        Stmt.If(if_condition, then_body, else_body, if_pos):
                            table <- rr_check_expression(if_condition, return_type, names, kinds, origins, declarations, extern_params, table)
                            if_mark: usize = names.count
                            rr_bind_condition(if_condition, names, kinds, origins)
                            table <- rr_check_statements(then_body, return_type, names, kinds, origins, declarations, extern_params, table)
                            rr_restore(if_mark, names, kinds, origins)
                            table <- rr_check_statements(else_body, return_type, names, kinds, origins, declarations, extern_params, table)
                            rr_restore(if_mark, names, kinds, origins)
                        Stmt.While(while_condition, while_body, while_pos):
                            table <- rr_check_expression(while_condition, return_type, names, kinds, origins, declarations, extern_params, table)
                            while_mark: usize = names.count
                            rr_bind_condition(while_condition, names, kinds, origins)
                            table <- rr_check_statements(while_body, return_type, names, kinds, origins, declarations, extern_params, table)
                            rr_restore(while_mark, names, kinds, origins)
                        Stmt.For(bind, variables, iterable, for_body, for_pos):
                            table <- rr_check_expression(iterable, return_type, names, kinds, origins, declarations, extern_params, table)
                            for_mark: usize = names.count
                            rr_bind(bind, 0, sview("", 0, 0), names, kinds, origins)
                            for variable in variables |names, kinds, origins|:
                                rr_bind(variable, 0, sview("", 0, 0), names, kinds, origins)
                            table <- rr_check_statements(for_body, return_type, names, kinds, origins, declarations, extern_params, table)
                            rr_restore(for_mark, names, kinds, origins)
                        Stmt.Block(block_kind, clause, binding, block_body, block_pos):
                            block_mark: usize = names.count
                            rr_bind(binding, 0, sview("", 0, 0), names, kinds, origins)
                            table <- rr_check_statements(block_body, return_type, names, kinds, origins, declarations, extern_params, table)
                            rr_restore(block_mark, names, kinds, origins)
                        Stmt.Match(scrutinee, arms, match_pos):
                            table <- rr_check_expression(scrutinee, return_type, names, kinds, origins, declarations, extern_params, table)
                            table <- rr_check_arms(arms, return_type, names, kinds, origins, declarations, extern_params, table)
                        Stmt.Contract(contract_kind, contract_expression, contract_pos):
                            table <- rr_check_expression(contract_expression, return_type, names, kinds, origins, declarations, extern_params, table)
                        _:
                            pass

        # The operand of `&operand` (through parentheses), else Invalid: the name a
        # reference-to-reference local was taken from, for the diagnostic.
        def rr_address_operand(value: Ast::Expr) -> Ast::Expr:
            can Abort.Panic:
                match value:
                    Expr.Unary(operator, operand, unary_pos):
                        return operand if operator == TokenKind.Ampersand
                    Expr.Paren(paren_inner, paren_pos):
                        return rr_address_operand(paren_inner)
                    _:
                        pass
                return (Ast::Expr.Invalid)

        def rr_check_declarations(declarations: darray[Ast::Decl], all_declarations: darray[Ast::Decl]&, extern_params: darray[Ast::ExternParam]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, function_params, function_return, function_body, function_effects, function_decorators, function_pos):
                            names: mutable darray[sview] = []
                            kinds: mutable darray[u16] = []
                            origins: mutable darray[sview @source] = []
                            for parameter in function_params |names, kinds, origins|:
                                rr_bind(parameter.name, rr_binding_kind_of_type(parameter.type_expression), sview("", 0, 0), &names, &kinds, &origins)
                            declared_return: Ast::Expr = get function_return else (Ast::Expr.Invalid)
                            table <- rr_check_statements(function_body, declared_return, &names, &kinds, &origins, all_declarations, extern_params, table)
                        Decl.Module(module_name, module_body, module_pos):
                            table <- rr_check_declarations(module_body, all_declarations, extern_params, table)
                        Decl.Scoped(scoped_body, scoped_pos):
                            table <- rr_check_declarations(scoped_body, all_declarations, extern_params, table)
                        _:
                            pass

        def check_reference_reborrow(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                declarations: mutable darray[Ast::Decl] = []
                rr_collect_declarations(file.top_decls, &declarations)
                table <- rr_check_declarations(file.top_decls, &declarations, file.extern_params, table)
