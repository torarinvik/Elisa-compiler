# Exact source rule for rejecting @noalloc decorators that carry arguments.
module NoallocArgumentPolicy:
    public:
        const NOALLOC_ARGUMENT_MINIMUM_ARGUMENTS: usize = 1

        def is_noalloc(name: sview) -> bool:
            ensure result == (name == "noalloc")
            return when name:
                "noalloc" -> true
                _ -> false

        def rejects_decorator(name: sview, argument_count: usize) -> bool:
            ensure result == (is_noalloc(name) and argument_count >= NOALLOC_ARGUMENT_MINIMUM_ARGUMENTS)
            return is_noalloc(name) and argument_count >= NOALLOC_ARGUMENT_MINIMUM_ARGUMENTS
