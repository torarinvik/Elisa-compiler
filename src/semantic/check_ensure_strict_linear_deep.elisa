# Stage1 semantic — the deep linear-arithmetic prover (`extend Semantic: private:`).
# `lin_add_deep` flattens an expression into a coefficient vector through nested
# arithmetic, and `linear_goal_deep_proven` decides the goal against the collected
# parameter bounds. Continues check_ensure_strict.elisa; split out to keep each part
# file under 600 lines.

extend Semantic:
    private:
        # --- Deep tier: local dataflow + pure-callee inlining ---------------------------
        # lin_add extended with (a) an ENVIRONMENT mapping straight-line LOCALS to affine
        # forms over the parameters (`y = x; y <- y - 1; return y`), and (b) INLINING of
        # pure single-return callees (`return dbl(n)` with `def dbl(x) = return x + x`).
        # Kept separate from lin_add so the shallow provers (assert-by, decreases, hof)
        # keep their exact behavior.
        def lin_add_deep(expression: Ast::Expr, sign: i64, names: mutable darray[sview]&, coeffs: mutable darray[i64]&, konst: mutable i64&, return_expression: Ast::Expr, has_return: bool, depth: u32, env_names: darray[sview]&, env_starts: darray[usize]&, env_counts: darray[usize]&, env_term_names: darray[sview]&, env_term_coeffs: darray[i64]&, env_consts: darray[i64]&, inl_names: darray[sview]&, inl_param_starts: darray[usize]&, inl_param_counts: darray[usize]&, all_inl_params: darray[sview]&, inl_bodies: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                false return if depth > 16
                match expression:
                    Expr.IntLit(value):
                        konst <- konst + sign * value
                        return true
                    Expr.Ident(name, line):
                        (lin_add_deep(return_expression, sign, names, coeffs, konst, Ast::Expr.Invalid, false, depth + 1, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)) return if has_return and name == "result"
                        # A LOCAL with a known affine form expands to it (param space).
                        env_slot: mutable i64 = -1
                        env_probe: mutable usize = 0
                        while env_probe < env_names.count |env_slot, env_probe, name, env_names|:
                            env_slot <- env_probe.i64() if env_names[env_probe] == name and env_slot < 0
                            env_probe <- env_probe + 1
                        if env_slot >= 0:
                            env_index: usize = env_slot.usize()
                            konst <- konst + sign * env_consts[env_index]
                            term_offset: mutable usize = 0
                            while term_offset < env_counts[env_index] |term_offset, konst, names, coeffs, env_index, sign|:
                                term_name: sview = env_term_names[env_starts[env_index] + term_offset]
                                term_coeff: i64 = env_term_coeffs[env_starts[env_index] + term_offset]
                                slot2: mutable i64 = -1
                                probe2: mutable usize = 0
                                while probe2 < names.count |slot2, probe2, term_name, names|:
                                    slot2 <- probe2.i64() if names[probe2] == term_name and slot2 < 0
                                    probe2 <- probe2 + 1
                                if slot2 < 0:
                                    names.push(term_name)
                                    coeffs.push(sign * term_coeff)
                                else:
                                    coeffs[slot2.usize()] <- coeffs[slot2.usize()] + sign * term_coeff
                                term_offset <- term_offset + 1
                            return true
                        slot: mutable i64 = -1
                        probe: mutable usize = 0
                        while probe < names.count |slot, probe, name, names|:
                            slot <- probe.i64() if names[probe] == name and slot < 0
                            probe <- probe + 1
                        if slot < 0:
                            names.push(name)
                            coeffs.push(sign)
                        else:
                            coeffs[slot.usize()] <- coeffs[slot.usize()] + sign
                        return true
                    Expr.Paren(inner, line):
                        return lin_add_deep(inner, sign, names, coeffs, konst, return_expression, has_return, depth + 1, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                    Expr.Unary(operator, operand, line):
                        (lin_add_deep(operand, 0 - sign, names, coeffs, konst, return_expression, has_return, depth + 1, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)) return if operator == TokenKind.Minus
                        return false
                    Expr.Binary(left, operator, right, line):
                        if operator == TokenKind.Plus:
                            false return if not lin_add_deep(left, sign, names, coeffs, konst, return_expression, has_return, depth + 1, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                            return lin_add_deep(right, sign, names, coeffs, konst, return_expression, has_return, depth + 1, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                        if operator == TokenKind.Minus:
                            false return if not lin_add_deep(left, sign, names, coeffs, konst, return_expression, has_return, depth + 1, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                            return lin_add_deep(right, 0 - sign, names, coeffs, konst, return_expression, has_return, depth + 1, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                        if operator == TokenKind.Star:
                            match left:
                                Expr.IntLit(left_value):
                                    return lin_add_deep(right, sign * left_value, names, coeffs, konst, return_expression, has_return, depth + 1, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                                _:
                                    pass
                            match right:
                                Expr.IntLit(right_value):
                                    return lin_add_deep(left, sign * right_value, names, coeffs, konst, return_expression, has_return, depth + 1, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                                _:
                                    pass
                            return false
                        return false
                    Expr.Call(callee, arguments, argument_names, line):
                        # NUMERIC CASTS are OPAQUE here: `x.u64().i64()` is not provably
                        # the identity (stage0 rejects `ensure result == x` on it).
                        false return if call_is_numeric_cast(callee, arguments)
                        # INLINE a pure single-return callee: evaluate each argument to an
                        # affine form in the CALLER's space, bind it as the callee param's
                        # environment, then fold the callee's return expression.
                        called: sview = ident_name_of(callee)
                        false return if called == ""
                        inl_slot: mutable i64 = -1
                        inl_probe: mutable usize = 0
                        while inl_probe < inl_names.count |inl_slot, inl_probe, called, inl_names|:
                            inl_slot <- inl_probe.i64() if inl_names[inl_probe] == called and inl_slot < 0
                            inl_probe <- inl_probe + 1
                        false return if inl_slot < 0
                        inl_index: usize = inl_slot.usize()
                        false return if inl_param_counts[inl_index] != arguments.count
                        callee_env_names: mutable darray[sview] = []
                        callee_env_starts: mutable darray[usize] = []
                        callee_env_counts: mutable darray[usize] = []
                        callee_term_names: mutable darray[sview] = []
                        callee_term_coeffs: mutable darray[i64] = []
                        callee_env_consts: mutable darray[i64] = []
                        arg_offset: mutable usize = 0
                        args_ok: mutable bool = true
                        while arg_offset < arguments.count |arg_offset, args_ok, callee_env_names, callee_env_starts, callee_env_counts, callee_term_names, callee_term_coeffs, callee_env_consts, arguments, inl_index, depth|:
                            arg_names: mutable darray[sview] = []
                            arg_coeffs: mutable darray[i64] = []
                            arg_konst: mutable i64 = 0
                            arg_linear: bool = lin_add_deep(arguments[arg_offset], 1, arg_names, arg_coeffs, arg_konst, Ast::Expr.Invalid, false, depth + 1, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                            args_ok <- false if not arg_linear
                            callee_env_names.push(all_inl_params[inl_param_starts[inl_index] + arg_offset])
                            callee_env_starts.push(callee_term_names.count)
                            callee_env_counts.push(arg_names.count)
                            callee_term_names.extend(arg_names)
                            callee_term_coeffs.extend(arg_coeffs)
                            callee_env_consts.push(arg_konst)
                            arg_offset <- arg_offset + 1
                        false return if not args_ok
                        return lin_add_deep(inl_bodies[inl_index], sign, names, coeffs, konst, Ast::Expr.Invalid, false, depth + 1, callee_env_names, callee_env_starts, callee_env_counts, callee_term_names, callee_term_coeffs, callee_env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                    _:
                        return false


        # linear_goal_is_proven with the DEEP adder (env + inlining). Same box logic.
        def linear_goal_deep_proven(goal_left: Ast::Expr, operator: TokenKind, goal_right: Ast::Expr, return_expression: Ast::Expr, has_return: bool, wrap_safe: bool, int_params: darray[sview]&, has_lo: darray[bool]&, lo: darray[i64]&, has_hi: darray[bool]&, hi: darray[i64]&, env_names: darray[sview]&, env_starts: darray[usize]&, env_counts: darray[usize]&, env_term_names: darray[sview]&, env_term_coeffs: darray[i64]&, env_consts: darray[i64]&, inl_names: darray[sview]&, inl_param_starts: darray[usize]&, inl_param_counts: darray[usize]&, all_inl_params: darray[sview]&, inl_bodies: darray[Ast::Expr]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                # A bare-identifier return that RESOLVES (via straight-line locals) to a
                # non-trivial affine form (`y = x; y += 5; return y` → `x + 5`) still needs the
                # wrap guard below. Probe the resolved form. EQUALITY goals are exempt: both
                # sides wrap identically, so `result == E` holds regardless of overflow.
                wrap_probe_names: mutable darray[sview] = []
                wrap_probe_coeffs: mutable darray[i64] = []
                wrap_probe_konst: mutable i64 = 0
                wrap_probe_linear: bool = has_return and operator != TokenKind.EqEq and lin_add_deep(return_expression, 1, wrap_probe_names, wrap_probe_coeffs, wrap_probe_konst, Ast::Expr.Invalid, false, 0, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                wrap_probe_nz: mutable usize = 0
                wrap_probe_single: mutable i64 = 0
                wrap_probe_scan: mutable usize = 0
                while wrap_probe_scan < wrap_probe_names.count |wrap_probe_nz, wrap_probe_single, wrap_probe_scan, wrap_probe_coeffs|:
                    if wrap_probe_coeffs[wrap_probe_scan] != 0:
                        wrap_probe_nz <- wrap_probe_nz + 1
                        wrap_probe_single <- wrap_probe_coeffs[wrap_probe_scan]
                    wrap_probe_scan <- wrap_probe_scan + 1
                resolved_nontrivial: bool = wrap_probe_linear and (wrap_probe_konst != 0 or wrap_probe_nz > 1 or (wrap_probe_nz == 1 and wrap_probe_single != 1))
                if has_return and (lin_has_arithmetic(return_expression) or resolved_nontrivial):
                    return_names: mutable darray[sview] = []
                    return_coeffs: mutable darray[i64] = []
                    return_konst: mutable i64 = 0
                    false return if not lin_add_deep(return_expression, 1, return_names, return_coeffs, return_konst, Ast::Expr.Invalid, false, 0, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                    # The wrap-around guard is a MULTI-variable concern: `a + b` may
                    # overflow past both bounds, but a single-variable affine step
                    # (`n + 4`) is proven by the interval tier without a box (pinned:
                    # stage0 accepts `requires n >= 0; ensure result >= 4; return n + 4`
                    # and still rejects the unbounded two-variable sum).
                    distinct_vars: mutable usize = 0
                    var_probe: mutable usize = 0
                    while var_probe < return_names.count |distinct_vars, var_probe, return_coeffs|:
                        distinct_vars <- distinct_vars + 1 if return_coeffs[var_probe] != 0
                        var_probe <- var_probe + 1
                    relational_goal: bool = ensure_goal_mentions_variable(goal_left, 0) or ensure_goal_mentions_variable(goal_right, 0)
                    box_needed: bool = distinct_vars >= 2 or relational_goal or ensure_subtracts_variable(return_expression, 0)
                    fully_boxed: mutable bool = true
                    box_probe: mutable usize = 0
                    while box_probe < return_names.count |fully_boxed, box_probe, return_names, return_coeffs, int_params, has_lo, has_hi|:
                        if return_coeffs[box_probe] != 0:
                            slot: mutable i64 = -1
                            param_probe: mutable usize = 0
                            while param_probe < int_params.count |slot, param_probe, box_probe, return_names, int_params|:
                                slot <- param_probe.i64() if int_params[param_probe] == return_names[box_probe] and slot < 0
                                param_probe <- param_probe + 1
                            fully_boxed <- false if slot < 0
                            fully_boxed <- false if slot >= 0 and not (has_lo[slot.usize()] and has_hi[slot.usize()])
                        box_probe <- box_probe + 1
                    # A `wrap_safe` return expression (underflow-guarded pure difference)
                    # has an EXACT affine form, so the interval tier is sound even without a
                    # constant box on a variable that cancels in the goal.
                    false return if box_needed and not fully_boxed and not wrap_safe
                names: mutable darray[sview] = []
                coeffs: mutable darray[i64] = []
                konst: mutable i64 = 0
                false return if not lin_add_deep(goal_left, 1, names, coeffs, konst, return_expression, has_return, 0, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                false return if not lin_add_deep(goal_right, -1, names, coeffs, konst, return_expression, has_return, 0, env_names, env_starts, env_counts, env_term_names, env_term_coeffs, env_consts, inl_names, inl_param_starts, inl_param_counts, all_inl_params, inl_bodies)
                min_value: mutable i64 = konst
                max_value: mutable i64 = konst
                min_known: mutable bool = true
                max_known: mutable bool = true
                term: mutable usize = 0
                while term < names.count |min_value, max_value, min_known, max_known, term, names, coeffs, int_params, has_lo, lo, has_hi, hi|:
                    coefficient: i64 = coeffs[term]
                    if coefficient != 0:
                        slot: mutable i64 = -1
                        probe: mutable usize = 0
                        while probe < int_params.count |slot, probe, term, names, int_params|:
                            slot <- probe.i64() if int_params[probe] == names[term] and slot < 0
                            probe <- probe + 1
                        if slot < 0:
                            min_known <- false
                            max_known <- false
                        else:
                            index: usize = slot.usize()
                            min_uses_lo: bool = coefficient > 0
                            min_bound_known: bool = has_lo[index] if min_uses_lo else has_hi[index]
                            max_bound_known: bool = has_hi[index] if min_uses_lo else has_lo[index]
                            min_bound: i64 = (lo[index] if min_uses_lo else hi[index]) if min_bound_known else 0
                            max_bound: i64 = (hi[index] if min_uses_lo else lo[index]) if max_bound_known else 0
                            min_value <- min_value + coefficient * min_bound if min_bound_known
                            min_known <- false if not min_bound_known
                            max_value <- max_value + coefficient * max_bound if max_bound_known
                            max_known <- false if not max_bound_known
                    term <- term + 1
                (min_known and min_value >= 1) return if operator == TokenKind.Gt
                (min_known and min_value >= 0) return if operator == TokenKind.GtEq
                (max_known and max_value <= (0 - 1)) return if operator == TokenKind.Lt
                (max_known and max_value <= 0) return if operator == TokenKind.LtEq
                (min_known and max_known and min_value == 0 and max_value == 0) return if operator == TokenKind.EqEq
                ((min_known and min_value >= 1) or (max_known and max_value <= (0 - 1))) return if operator == TokenKind.BangEq
                return false
