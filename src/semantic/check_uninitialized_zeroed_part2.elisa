extend Semantic:
    private:
        def zeroed_resolve_type_alias_chain(type_expression: Ast::Expr, alias_names: darray[sview @source]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview @source, table: SymbolTable&, resolved: mutable Ast::Expr&, resolved_owner: mutable sview&, ambiguous_or_cyclic: mutable bool&) -> void:
            can Memory.Allocate, Abort.Panic:
                current: mutable Ast::Expr = type_expression
                resolution_module: mutable sview = current_module
                steps: mutable usize = 0
                while steps <= 256.usize() |current, resolution_module, declarations, alias_declarations, table, resolved, resolved_owner, ambiguous_or_cyclic, steps|:
                    match current:
                        Expr.Unary(operator, operand, _):
                            if operator == TokenKind.Question or operator == TokenKind.Ampersand:
                                resolved <- current
                                resolved_owner <- resolution_module
                                return
                            if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                                current <- operand
                                steps <- steps + 1.usize()
                                continue
                            resolved <- current
                            resolved_owner <- resolution_module
                            return
                        Expr.Paren(inner, _):
                            current <- inner
                            steps <- steps + 1.usize()
                            continue
                        Expr.Refinement(base_type, _, _):
                            current <- base_type
                            steps <- steps + 1.usize()
                            continue
                        _:
                            pass
                    qualified_names: mutable darray[sview] = []
                    if zeroed_collect_qualified_type_path(current, qualified_names) and qualified_names.count > 1:
                        alias_name: sview = qualified_names[qualified_names.count - 1.usize()]
                        module_path: mutable darray[sview] = []
                        path_index: mutable usize = 0
                        while path_index + 1.usize() < qualified_names.count |path_index, qualified_names, module_path|:
                            module_path.push(qualified_names[path_index])
                            path_index <- path_index + 1.usize()
                        path_invalid: mutable bool = false
                        resolution_module <- zeroed_expand_using_module_path(module_path, resolution_module, table, path_invalid)
                        if path_invalid:
                            ambiguous_or_cyclic <- true
                            resolved <- current
                            resolved_owner <- resolution_module
                            return
                        target: mutable Ast::Expr = Expr.Invalid
                        matched_owner: mutable sview = resolution_module
                        local_alias_names: mutable darray[sview @source] = []
                        local_alias_values: mutable darray[Ast::Expr] = []
                        matches: mutable usize = 0
                        zeroed_find_qualified_alias_in_declarations(alias_declarations, resolution_module, module_path, alias_name, target, matched_owner, local_alias_names, local_alias_values, matches)
                        if matches > 1:
                            ambiguous_or_cyclic <- true
                            resolved <- current
                            resolved_owner <- resolution_module
                            return
                        if matches == 0:
                            struct_line: mutable u32 = 0
                            zeroed_find_qualified_nominal_in_declarations(alias_declarations, resolution_module, module_path, alias_name, struct_line, matched_owner, matches, table)
                            ambiguous_or_cyclic <- true if matches > 1.usize()
                            resolved <- Expr.Ident(alias_name, Ast::expr_pos(current)) if matches == 1.usize() else current
                            resolved_owner <- matched_owner if matches == 1.usize() else resolution_module
                            return
                        resolution_module <- matched_owner
                        current <- target
                        steps <- steps + 1.usize()
                        continue
                    alias_name: sview = bare_type_name(current)
                    if alias_name == "":
                        resolved <- current
                        resolved_owner <- resolution_module
                        return
                    if is_primitive_type_name(alias_name):
                        resolved <- current
                        resolved_owner <- resolution_module
                        return
                    alias_owner: mutable sview = resolution_module
                    owner_matches: mutable usize = 0
                    zeroed_find_lexical_alias_owner(alias_declarations, resolution_module, alias_name, alias_owner, owner_matches, table)
                    if owner_matches == 0:
                        zeroed_find_lexical_nominal_owner(alias_declarations, resolution_module, alias_name, alias_owner, owner_matches, table)
                        ambiguous_or_cyclic <- true if owner_matches > 1.usize()
                        resolved <- current
                        resolved_owner <- alias_owner if owner_matches == 1.usize() else resolution_module
                        return
                    if owner_matches != 1.usize():
                        ambiguous_or_cyclic <- true
                        resolved <- current
                        resolved_owner <- resolution_module
                        return
                    resolution_module <- alias_owner
                    alias_target: mutable Ast::Expr = Expr.Invalid
                    target_matches: mutable usize = 0
                    zeroed_find_alias_in_owner(alias_declarations, alias_owner, alias_name, alias_target, target_matches, table)
                    current <- alias_target
                    steps <- steps + 1.usize()
                ambiguous_or_cyclic <- true
                resolved <- current
                resolved_owner <- resolution_module


        # Use the same declaration-owner lookup for direct references and aggregates.
        # Ambiguous and cyclic aliases cannot establish a valid zero representation.
        def zeroed_is_nonnull_ref_type_via_alias(type_expression: Ast::Expr, alias_names: darray[sview @source]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], current_module: sview @source, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                resolved: mutable Ast::Expr = type_expression
                resolved_owner: mutable sview = current_module
                ambiguous_or_cyclic: mutable bool = false
                zeroed_resolve_type_alias_chain(type_expression, alias_names, alias_values, declarations, alias_declarations, current_module, table, resolved, resolved_owner, ambiguous_or_cyclic)
                return true if ambiguous_or_cyclic
                return zeroed_is_nonnull_ref_type(resolved)

        def zeroed_is_function_generic_type_name(name: sview, function_line: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if name == "" or function_line == 0
                index: mutable usize = 0
                while index < table.generic_param_lines.count |index, name, function_line, table|:
                    return true if table.generic_param_lines[index] == function_line and table.generic_param_names[index] == name
                    index <- index + 1
                return false

        const ZEROED_ENUM_ROW_NONE: u32 = 4294967295

        # Tag zero selects the first payload variant. The per-pass projection keeps only
        # those live payload fields, chained by the exact (owner, name) query. This replaces
        # a recursive declaration-tree scan and temporary field-array allocation at every
        # named type reached by the aggregate walk.
        struct ZeroedActiveEnumIndex:
            built: mutable bool
            heads: mutable dict[u64, u32] @source
            tails: mutable dict[u64, u32] @source
            counts: mutable dict[u64, u32] @source
            next: mutable darray[u32] @source
            row_hashes: mutable darray[u64] @source
            owners: mutable darray[sview @source] @source
            names: mutable darray[sview @source] @source
            payloads: mutable darray[Ast::Expr] @source

        def zeroed_active_enum_key(owner: sview, name: sview) -> u64:
            can Abort.Panic:
                return (name_hash(owner) * 1099511628211) ^ name_hash(name)

        def zeroed_active_enum_index_add(index: mutable ZeroedActiveEnumIndex&, owner: sview @source, name: sview @source, payload: Ast::Expr) -> void:
            can Memory.Allocate, Abort.Panic:
                row: u32 = index.payloads.count.u32()
                hash: u64 = zeroed_active_enum_key(owner, name)
                index.next <- index.next.push(ZEROED_ENUM_ROW_NONE)
                index.row_hashes <- index.row_hashes.push(hash)
                index.owners <- index.owners.push(owner)
                index.names <- index.names.push(name)
                index.payloads <- index.payloads.push(payload)
                if index.counts.get(hash) is bucket_count:
                    index.counts <- index.counts.put(hash, bucket_count + 1) can Global{Read,Write}
                else:
                    index.counts <- index.counts.put(hash, 1) can Global{Read,Write}
                if index.tails.get(hash) is bucket_tail:
                    index.next[bucket_tail.usize()] <- row
                    index.tails <- index.tails.put(hash, row) can Global{Read,Write}
                else:
                    index.heads <- index.heads.put(hash, row) can Global{Read,Write}
                    index.tails <- index.tails.put(hash, row) can Global{Read,Write}

        def zeroed_build_active_enum_index(declarations: darray[Ast::Decl], owner: sview @source, index: mutable ZeroedActiveEnumIndex&) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                for declaration in declarations |owner, index|:
                    match declaration:
                        Decl.Enum(enum_name, variants, is_const, _, _):
                            if not is_const and variants.count > 0:
                                for payload in variants[0].fields |owner, enum_name, index|:
                                    zeroed_active_enum_index_add(index, owner, enum_name, payload)
                        Decl.Module(module_name, module_body, _):
                            zeroed_build_active_enum_index(module_body, module_name, index)
                        Decl.Scoped(scoped_body, _):
                            zeroed_build_active_enum_index(scoped_body, owner, index)
                        _:
                            pass

        # Read the owner chain's expected bounds in O(1). The consuming loop validates every
        # linked row against the independent bucket count, insertion order, hash, and tail in
        # the same pass that inspects field types, so a malformed chain cannot produce a clean
        # false. Callers treat invalid metadata as unsafe; the index is built once with the
        # immutable symbol table, so that path is reserved for malformed internal state.
        def zeroed_struct_field_owner_chain_metadata(table: SymbolTable&, owner: sview, head: mutable u32&, tail_row_output: mutable u32&, expected_count: mutable usize&) -> bool:
            can Abort.Panic:
                return false if table.struct_field_owner_next.count != table.struct_field_owner.count or table.struct_field_module.count != table.struct_field_owner.count or table.private_field_types.count != table.struct_field_owner.count or table.struct_field_name.count != table.struct_field_owner.count
                hash: u64 = name_hash(owner)
                head <- SYMBOL_INDEX_ROW_NONE
                tail_row_output <- SYMBOL_INDEX_ROW_NONE
                expected_count <- 0.usize()
                if table.struct_field_owner_counts.get(hash) is bucket_count:
                    expected_count <- bucket_count.usize()
                else:
                    if table.struct_field_owner_heads.get(hash) is orphan_head:
                        return false
                    if table.struct_field_owner_tails.get(hash) is orphan_tail:
                        return false
                    return true
                return false if expected_count == 0.usize()
                if table.struct_field_owner_tails.get(hash) is indexed_tail:
                    tail_row_output <- indexed_tail
                else:
                    return false
                return false if tail_row_output.usize() >= table.struct_field_owner.count
                if table.struct_field_owner_heads.get(hash) is indexed_head:
                    head <- indexed_head
                else:
                    return false
                return false if head.usize() >= table.struct_field_owner.count
                return true

        # Find a non-null reference nested in a tuple, fixed array, or by-value struct.
        # Optional rows stop recursion because their zero representation is the valid absent
        # value. Dynamic containers also stop: a zeroed empty container has no elements yet.
        # Keep this AST-based so alias targets that are themselves references or aggregates
        # remain visible even when the structural type table has no alias row.
        def zeroed_type_expr_contains_nonnull_ref(type_expression: Ast::Expr, alias_names: darray[sview @source]&, alias_values: darray[Ast::Expr]&, visited: mutable darray[sview]&, offending_field: mutable sview&, table: SymbolTable&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], active_enum_index: mutable ZeroedActiveEnumIndex&, current_module: sview @source, generic_names: darray[sview]&, generic_values: darray[Ast::Expr]&, generic_owners: darray[sview @source]&, function_line: u32 = 0, generic_depth: usize = 0, sview_only: bool = false) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                return true if generic_depth > 256.usize()
                # Type arguments retain the lexical owner of the argument expression.
                # Substitution precedes module alias lookup because parameters shadow aliases.
                if type_expression is Expr.Ident(parameter_name, _):
                    mapping_index: mutable usize = generic_names.count
                    while mapping_index > 0 |mapping_index, generic_names, generic_values, generic_owners, parameter_name, active_enum_index|:
                        mapping_index <- mapping_index - 1.usize()
                        if generic_names[mapping_index] == parameter_name:
                            mapped_type: Ast::Expr = generic_values[mapping_index]
                            break if mapped_type is Expr.Ident(mapped_name, _) and mapped_name == parameter_name
                            return true if mapping_index >= generic_owners.count
                            return zeroed_type_expr_contains_nonnull_ref(mapped_type, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, active_enum_index, generic_owners[mapping_index], generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only)
                resolved_type: mutable Ast::Expr = type_expression
                resolved_owner: mutable sview = current_module
                invalid_alias: mutable bool = false
                zeroed_resolve_type_alias_chain(type_expression, alias_names, alias_values, declarations, alias_declarations, current_module, table, resolved_type, resolved_owner, invalid_alias)
                return true if:
                    invalid_alias
                    not sview_only and zeroed_is_nonnull_ref_type(resolved_type)
                    bare_type_name(resolved_type) == "sview"
                match resolved_type:
                    Expr.Unary(operator, operand, _):
                        return false if:
                            operator == TokenKind.Question
                            sview_only and operator == TokenKind.Ampersand
                        return zeroed_type_expr_contains_nonnull_ref(operand, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, active_enum_index, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                        return false
                    Expr.Paren(inner, _):
                        return zeroed_type_expr_contains_nonnull_ref(inner, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, active_enum_index, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only)
                    Expr.Refinement(base_type, _, _):
                        return zeroed_type_expr_contains_nonnull_ref(base_type, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, active_enum_index, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only)
                    Expr.Tuple(elements, _):
                        for element in elements |alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth, sview_only, active_enum_index|:
                            if zeroed_type_expr_contains_nonnull_ref(element, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, active_enum_index, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only):
                                offending_field <- "tuple element" if offending_field == ""
                                return true
                        return false
                    Expr.Index(head, argument, _):
                        return zeroed_type_expr_contains_nonnull_ref(head, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, active_enum_index, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only) if argument is Expr.IntLit(_, _)
                        resolved_head: mutable Ast::Expr = head
                        head_owner: mutable sview = resolved_owner
                        invalid_head: mutable bool = false
                        zeroed_resolve_type_alias_chain(head, alias_names, alias_values, declarations, alias_declarations, resolved_owner, table, resolved_head, head_owner, invalid_head)
                        return true if invalid_head
                        head_name: sview = ident_name_of(resolved_head)
                        return zeroed_type_expr_contains_nonnull_ref(argument, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, active_enum_index, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only) if head_name == "array"
                        struct_line: mutable u32 = 0
                        struct_matches: mutable usize = 0
                        zeroed_find_nominal_in_owner_for_type(alias_declarations, head_owner, head_owner, head_name, struct_line, struct_matches, table)
                        return true if struct_matches > 1.usize()
                        if struct_matches > 0.usize():
                            return true if generic_depth > table.struct_field_owner.count + 16.usize()
                            type_arguments: mutable darray[Ast::Expr] = [argument]
                            struct_generic_names: mutable darray[sview] = []
                            table_index: mutable usize = 0
                            while table_index < table.generic_param_lines.count |table_index, struct_line, struct_generic_names, table|:
                                struct_generic_names.push(table.generic_param_names[table_index]) if table.generic_param_lines[table_index] == struct_line
                                table_index <- table_index + 1
                            # `Type[Extent]` is also Elisa's fixed-array syntax. A
                            # non-generic struct followed by its extent is still the
                            # struct element type; inspect its fields instead of
                            # treating it as an unresolved generic application.
                            return zeroed_type_expr_contains_nonnull_ref(Expr.Ident(head_name, Ast::expr_pos(head)), alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, active_enum_index, head_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only) if struct_generic_names.count == 0
                            return true if type_arguments.count < struct_generic_names.count
                            nested_generic_names: mutable darray[sview] = []
                            nested_generic_values: mutable darray[Ast::Expr] = []
                            nested_generic_owners: mutable darray[sview @source] = []
                            nested_generic_names.extend(generic_names)
                            nested_generic_values.extend(generic_values)
                            nested_generic_owners.extend(generic_owners)
                            table_index <- 0
                            while table_index < struct_generic_names.count |table_index, struct_generic_names, type_arguments, nested_generic_names, nested_generic_values, nested_generic_owners|:
                                parameter_name: sview = struct_generic_names[table_index]
                                argument_is_identity: mutable bool = false
                                if type_arguments[table_index] is Expr.Ident(argument_name, _):
                                    argument_is_identity <- argument_name == parameter_name
                                if not argument_is_identity:
                                    nested_generic_names.push(parameter_name)
                                    nested_generic_values.push(type_arguments[table_index])
                                    nested_generic_owners.push(resolved_owner)
                                table_index <- table_index + 1
                            field_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                            field_tail: mutable u32 = SYMBOL_INDEX_ROW_NONE
                            field_expected_count: mutable usize = 0.usize()
                            return true if not zeroed_struct_field_owner_chain_metadata(table, head_name, field_row, field_tail, field_expected_count)
                            field_bucket_hash: u64 = name_hash(head_name)
                            found_field: mutable bool = false
                            field_probes: mutable usize = 0
                            last_field_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                            previous_field_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                            while field_row != SYMBOL_INDEX_ROW_NONE |field_row, field_probes, last_field_row, previous_field_row, field_expected_count, field_tail, head_name, head_owner, found_field, offending_field, table, alias_names, alias_values, visited, declarations, alias_declarations, nested_generic_names, nested_generic_values, nested_generic_owners, function_line, generic_depth, active_enum_index|:
                                return true if field_probes >= field_expected_count
                                field_index: usize = field_row.usize()
                                return true if:
                                    field_index >= table.struct_field_owner.count
                                    previous_field_row != SYMBOL_INDEX_ROW_NONE and field_row <= previous_field_row
                                    name_hash(table.struct_field_owner[field_index]) != field_bucket_hash
                                if table.struct_field_owner[field_index] == head_name and field_index < table.struct_field_module.count and table.struct_field_module[field_index] == head_owner:
                                    found_field <- true
                                    if zeroed_type_expr_contains_nonnull_ref(table.private_field_types[field_index], alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, active_enum_index, head_owner, nested_generic_names, nested_generic_values, nested_generic_owners, function_line, generic_depth + 1.usize(), sview_only):
                                        offending_field <- table.struct_field_name[field_index] if offending_field == ""
                                        return true
                                last_field_row <- field_row
                                previous_field_row <- field_row
                                field_row <- table.struct_field_owner_next[field_index]
                                field_probes <- field_probes + 1
                            return true if field_probes != field_expected_count or last_field_row != field_tail
                            return false if found_field
                            return true
                        return zeroed_type_expr_contains_nonnull_ref(Expr.Ident(head_name, Ast::expr_pos(head)), alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, active_enum_index, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only) if head_name != ""
                        return false
                    Expr.IndexN(head, arguments, _):
                        resolved_head: mutable Ast::Expr = head
                        head_owner: mutable sview = resolved_owner
                        invalid_head: mutable bool = false
                        zeroed_resolve_type_alias_chain(head, alias_names, alias_values, declarations, alias_declarations, resolved_owner, table, resolved_head, head_owner, invalid_head)
                        return true if invalid_head
                        head_name: sview = ident_name_of(resolved_head)
                        if head_name == "array" and arguments.count > 0:
                            return zeroed_type_expr_contains_nonnull_ref(arguments[0], alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, active_enum_index, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only)
                        has_extent: mutable bool = false
                        for argument in arguments |has_extent|:
                            has_extent <- true if argument is Expr.IntLit(_, _)
                        return zeroed_type_expr_contains_nonnull_ref(head, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, active_enum_index, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only) if has_extent
                        struct_line: mutable u32 = 0
                        struct_matches: mutable usize = 0
                        zeroed_find_nominal_in_owner_for_type(alias_declarations, head_owner, head_owner, head_name, struct_line, struct_matches, table)
                        return true if struct_matches > 1.usize()
                        if struct_matches > 0.usize():
                            return true if generic_depth > table.struct_field_owner.count + 16.usize()
                            struct_generic_names: mutable darray[sview] = []
                            table_index: mutable usize = 0
                            while table_index < table.generic_param_lines.count |table_index, struct_line, struct_generic_names, table|:
                                struct_generic_names.push(table.generic_param_names[table_index]) if table.generic_param_lines[table_index] == struct_line
                                table_index <- table_index + 1
                            return zeroed_type_expr_contains_nonnull_ref(Expr.Ident(head_name, Ast::expr_pos(head)), alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, active_enum_index, head_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only) if struct_generic_names.count == 0
                            return true if arguments.count < struct_generic_names.count
                            nested_generic_names: mutable darray[sview] = []
                            nested_generic_values: mutable darray[Ast::Expr] = []
                            nested_generic_owners: mutable darray[sview @source] = []
                            nested_generic_names.extend(generic_names)
                            nested_generic_values.extend(generic_values)
                            nested_generic_owners.extend(generic_owners)
                            table_index <- 0
                            while table_index < struct_generic_names.count |table_index, struct_generic_names, arguments, nested_generic_names, nested_generic_values, nested_generic_owners|:
                                parameter_name: sview = struct_generic_names[table_index]
                                argument_is_identity: mutable bool = false
                                if arguments[table_index] is Expr.Ident(argument_name, _):
                                    argument_is_identity <- argument_name == parameter_name
                                if not argument_is_identity:
                                    nested_generic_names.push(parameter_name)
                                    nested_generic_values.push(arguments[table_index])
                                    nested_generic_owners.push(resolved_owner)
                                table_index <- table_index + 1
                            field_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                            field_tail: mutable u32 = SYMBOL_INDEX_ROW_NONE
                            field_expected_count: mutable usize = 0.usize()
                            return true if not zeroed_struct_field_owner_chain_metadata(table, head_name, field_row, field_tail, field_expected_count)
                            field_bucket_hash: u64 = name_hash(head_name)
                            found_field: mutable bool = false
                            field_probes: mutable usize = 0
                            last_field_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                            previous_field_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                            while field_row != SYMBOL_INDEX_ROW_NONE |field_row, field_probes, last_field_row, previous_field_row, field_expected_count, field_tail, head_name, head_owner, found_field, offending_field, table, alias_names, alias_values, visited, declarations, alias_declarations, nested_generic_names, nested_generic_values, nested_generic_owners, function_line, generic_depth, active_enum_index|:
                                return true if field_probes >= field_expected_count
                                field_index: usize = field_row.usize()
                                return true if:
                                    field_index >= table.struct_field_owner.count
                                    previous_field_row != SYMBOL_INDEX_ROW_NONE and field_row <= previous_field_row
                                    name_hash(table.struct_field_owner[field_index]) != field_bucket_hash
                                if table.struct_field_owner[field_index] == head_name and field_index < table.struct_field_module.count and table.struct_field_module[field_index] == head_owner:
                                    found_field <- true
                                    if zeroed_type_expr_contains_nonnull_ref(table.private_field_types[field_index], alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, active_enum_index, head_owner, nested_generic_names, nested_generic_values, nested_generic_owners, function_line, generic_depth + 1.usize(), sview_only):
                                        offending_field <- table.struct_field_name[field_index] if offending_field == ""
                                        return true
                                last_field_row <- field_row
                                previous_field_row <- field_row
                                field_row <- table.struct_field_owner_next[field_index]
                                field_probes <- field_probes + 1
                            return true if field_probes != field_expected_count or last_field_row != field_tail
                            return false if found_field
                            return true
                        return zeroed_type_expr_contains_nonnull_ref(Expr.Ident(head_name, Ast::expr_pos(head)), alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, active_enum_index, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only) if head_name != ""
                        return false
                    Expr.Ident(name, _):
                        # An unresolved generic may instantiate to a non-null reference;
                        # reject it in the general zeroed-reference pass. The separate
                        # sview pass only rejects concrete views, avoiding false positives
                        # for generic wrappers whose fields are scalars or optional refs.
                        return true if not sview_only and zeroed_is_function_generic_type_name(name, function_line, table)
                        if not active_enum_index.built:
                            zeroed_build_active_enum_index(alias_declarations, "", active_enum_index)
                            active_enum_index.built <- true
                        enum_hash: u64 = zeroed_active_enum_key(resolved_owner, name)
                        enum_row: mutable u32 = ZEROED_ENUM_ROW_NONE
                        enum_tail: mutable u32 = ZEROED_ENUM_ROW_NONE
                        enum_expected_count: mutable usize = 0.usize()
                        if active_enum_index.counts.get(enum_hash) is indexed_count:
                            enum_expected_count <- indexed_count.usize()
                        else:
                            return true if:
                                active_enum_index.heads.get(enum_hash) is orphan_head
                                active_enum_index.tails.get(enum_hash) is orphan_tail
                        return true if active_enum_index.next.count != active_enum_index.payloads.count or active_enum_index.row_hashes.count != active_enum_index.payloads.count or active_enum_index.owners.count != active_enum_index.payloads.count or active_enum_index.names.count != active_enum_index.payloads.count
                        if enum_expected_count > 0.usize():
                            if active_enum_index.heads.get(enum_hash) is enum_head:
                                enum_row <- enum_head
                            else:
                                return true
                            if active_enum_index.tails.get(enum_hash) is indexed_tail:
                                enum_tail <- indexed_tail
                            else:
                                return true
                            return true if enum_row.usize() >= active_enum_index.payloads.count or enum_tail.usize() >= active_enum_index.payloads.count
                        else:
                            return true if:
                                active_enum_index.heads.get(enum_hash) is empty_count_head
                                active_enum_index.tails.get(enum_hash) is empty_count_tail
                        return true if enum_expected_count > active_enum_index.payloads.count
                        enum_probes: mutable usize = 0.usize()
                        previous_enum_row: mutable u32 = ZEROED_ENUM_ROW_NONE
                        last_enum_row: mutable u32 = ZEROED_ENUM_ROW_NONE
                        while enum_row != ZEROED_ENUM_ROW_NONE |enum_row, enum_probes, previous_enum_row, last_enum_row, enum_hash, enum_expected_count, enum_tail, resolved_owner, name, offending_field, active_enum_index, alias_names, alias_values, visited, table, declarations, alias_declarations, generic_names, generic_values, generic_owners, function_line, generic_depth, sview_only|:
                            return true if enum_probes >= enum_expected_count
                            enum_index: usize = enum_row.usize()
                            return true if:
                                enum_index >= active_enum_index.payloads.count
                                previous_enum_row != ZEROED_ENUM_ROW_NONE and enum_row <= previous_enum_row
                                active_enum_index.row_hashes[enum_index] != enum_hash
                            if active_enum_index.owners[enum_index] == resolved_owner and active_enum_index.names[enum_index] == name:
                                if zeroed_type_expr_contains_nonnull_ref(active_enum_index.payloads[enum_index], alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, active_enum_index, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only):
                                    offending_field <- "enum payload" if offending_field == ""
                                    return true
                            last_enum_row <- enum_row
                            previous_enum_row <- enum_row
                            enum_row <- active_enum_index.next[enum_index]
                            enum_probes <- enum_probes + 1.usize()
                        return true if enum_probes != enum_expected_count or last_enum_row != enum_tail
                        field_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                        field_tail: mutable u32 = SYMBOL_INDEX_ROW_NONE
                        field_expected_count: mutable usize = 0.usize()
                        return true if not zeroed_struct_field_owner_chain_metadata(table, name, field_row, field_tail, field_expected_count)
                        field_bucket_hash: u64 = name_hash(name)
                        field_probes: mutable usize = 0
                        last_field_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                        previous_field_row: mutable u32 = SYMBOL_INDEX_ROW_NONE
                        while field_row != SYMBOL_INDEX_ROW_NONE |field_row, field_probes, last_field_row, previous_field_row, field_expected_count, field_tail, name, alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth, active_enum_index|:
                            return true if field_probes >= field_expected_count
                            field_index: usize = field_row.usize()
                            return true if:
                                field_index >= table.struct_field_owner.count
                                previous_field_row != SYMBOL_INDEX_ROW_NONE and field_row <= previous_field_row
                                name_hash(table.struct_field_owner[field_index]) != field_bucket_hash
                            if table.struct_field_owner[field_index] == name and field_index < table.struct_field_module.count and table.struct_field_module[field_index] == resolved_owner:
                                if zeroed_type_expr_contains_nonnull_ref(table.private_field_types[field_index], alias_names, alias_values, visited, offending_field, table, declarations, alias_declarations, active_enum_index, resolved_owner, generic_names, generic_values, generic_owners, function_line, generic_depth + 1.usize(), sview_only):
                                    offending_field <- table.struct_field_name[field_index] if offending_field == ""
                                    return true
                            last_field_row <- field_row
                            previous_field_row <- field_row
                            field_row <- table.struct_field_owner_next[field_index]
                            field_probes <- field_probes + 1
                        return true if field_probes != field_expected_count or last_field_row != field_tail
                        return false
                    _:
                        return false

        def zeroed_reject_reference_initializer(name: sview @source, type_expression: Ast::Expr, value: Ast::Expr, pos: Ast::Pos, alias_names: darray[sview @source]&, alias_values: darray[Ast::Expr]&, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], active_enum_index: mutable ZeroedActiveEnumIndex&, current_module: sview @source, table: lmut SymbolTable, function_line: u32 = 0, allow_invalid_zeroed: bool = false) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                return if not zeroed_invalid_reference_initializer(value)
                invalid_field: mutable sview = ""
                visited_types: mutable darray[sview] = []
                no_generic_names: darray[sview] = []
                no_generic_values: darray[Ast::Expr] = []
                no_generic_owners: darray[sview @source] = []
                # The view-backing invariant is unconditional, including within
                # trusted raw-storage blocks. Check nested fields and generic
                # substitutions before allowing inactive non-view payload storage.
                if zeroed_type_expr_contains_nonnull_ref(type_expression, alias_names, alias_values, visited_types, invalid_field, table, declarations, alias_declarations, active_enum_index, current_module, no_generic_names, no_generic_values, no_generic_owners, function_line, 0, true):
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: name, pos: pos, line: pos.line, expected: "sview with valid backing", actual: zeroed_reference_initializer_description(value)})
                    return
                # The sview-only walk has already visited every aggregate on its path. The
                # non-null-reference walk uses this same visited set, so leaving those marks
                # in place made ordinary structs appear cycle-complete and skipped all their
                # reference fields (including multi-level nested fields). Each classification
                # is an independent graph walk and needs its own cycle state.
                visited_types <- visited_types.truncate(0)
                # Runtime data structures may use zeroed bytes for an inactive generic
                # payload, but only within an explicit Unsafe.PointerCast block. A direct
                # sview is rejected above regardless: its backing must always be valid.
                return if allow_invalid_zeroed
                if zeroed_is_nonnull_ref_type_via_alias(type_expression, alias_names, alias_values, declarations, alias_declarations, current_module, table):
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidNonNullReferenceInitialization, name: name, pos: pos, line: pos.line, expected: "non-null reference", actual: zeroed_reference_initializer_description(value)})
                    return
                if zeroed_type_expr_contains_nonnull_ref(type_expression, alias_names, alias_values, visited_types, invalid_field, table, declarations, alias_declarations, active_enum_index, current_module, no_generic_names, no_generic_values, no_generic_owners, function_line):
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.InvalidZeroedAggregateReference, name: name, pos: pos, line: pos.line, expected: invalid_field, actual: zeroed_reference_initializer_description(value)})

        def zeroed_reject_nonnull_ref_declarations(statements: darray[Ast::Stmt], return_type: Ast::Expr?, function_line: u32, declarations: darray[Ast::Decl], alias_declarations: darray[Ast::Decl], active_enum_index: mutable ZeroedActiveEnumIndex&, current_module: sview @source, alias_names: darray[sview @source]&, alias_values: darray[Ast::Expr]&, table: lmut SymbolTable, allow_invalid_zeroed: bool = false) -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                for statement in statements |table, active_enum_index|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- zeroed_reject_reference_initializer(name, type_expression, value, line, alias_names, alias_values, declarations, alias_declarations, active_enum_index, current_module, table, function_line, allow_invalid_zeroed)
                        Stmt.Return(value, line):
                            if value is returned_value and return_type is expected_return:
                                table <- zeroed_reject_reference_initializer("return", expected_return, returned_value, line, alias_names, alias_values, declarations, alias_declarations, active_enum_index, current_module, table, function_line, allow_invalid_zeroed) if not (expected_return is Expr.Absent) and not (expected_return is Expr.Invalid)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- zeroed_reject_nonnull_ref_declarations(then_body, return_type, function_line, declarations, alias_declarations, active_enum_index, current_module, alias_names, alias_values, table, allow_invalid_zeroed)
                            table <- zeroed_reject_nonnull_ref_declarations(else_body, return_type, function_line, declarations, alias_declarations, active_enum_index, current_module, alias_names, alias_values, table, allow_invalid_zeroed)
                        Stmt.While(_, body, _) | Stmt.For(_, _, _, body, _):
                            table <- zeroed_reject_nonnull_ref_declarations(body, return_type, function_line, declarations, alias_declarations, active_enum_index, current_module, alias_names, alias_values, table, allow_invalid_zeroed)
                        Stmt.Block(kind, clause, binding, body, _):
                            grants_raw_zeroed: bool = (kind == "trusted" or kind == "can") and any grant in clause where grant == "Unsafe.PointerCast"
                            table <- zeroed_reject_nonnull_ref_declarations(body, return_type, function_line, declarations, alias_declarations, active_enum_index, current_module, alias_names, alias_values, table, allow_invalid_zeroed or grants_raw_zeroed)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table, active_enum_index| -> table:
                                table <- zeroed_reject_nonnull_ref_declarations(arm.body, return_type, function_line, declarations, alias_declarations, active_enum_index, current_module, alias_names, alias_values, table, allow_invalid_zeroed)
                        _:
                            pass

        def zeroed_collect_type_aliases(declarations: darray[Ast::Decl], names: mutable darray[sview @source]&, values: mutable darray[Ast::Expr]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |names, values|:
                    match declaration:
                        Decl.Alias(alias_name, alias_value, alias_line):
                            names.push(alias_name)
                            values.push(alias_value)
                        _:
                            pass

        def zeroed_value_is_zeroed(value: Ast::Expr) -> bool:
            can Abort.Panic:
                match value:
                    Expr.Ident(name, line):
                        return name == "zeroed"
                    _:
                        return false

        def zeroed_invalid_reference_initializer(value: Ast::Expr) -> bool:
            can Abort.Panic:
                return true if:
                    zeroed_value_is_zeroed(value)
                    value is Expr.Invalid or value is Expr.Absent
                return false

        def zeroed_reference_initializer_description(value: Ast::Expr) -> sview:
            can Abort.Panic:
                return "zeroed" if zeroed_value_is_zeroed(value)
                return "an omitted initializer"

        def zeroed_scan_binding_for_reference(table: SymbolTable&, owner: DeclId, line: u32, name: sview) -> BindingId:
            can Abort.Panic:
                for index in 0..<table.ref_binding_ids.count:
                    if index < table.ref_line.count and index < table.ref_name.count and index < table.ref_kind.count:
                        binding: BindingId = table.ref_binding_ids[index]
                        if binding.owner.value == owner.value and table.ref_line[index] == line and table.ref_name[index] == name and table.ref_kind[index] == 2:
                            return binding
                return BindingId{owner: DeclId{value: SYMBOL_INDEX_ROW_NONE}, serial: 0}
