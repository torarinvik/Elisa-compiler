# `-strict-externs` (RequireExternContracts): every `extern` declaration must document its
# boundary — either a `requires`/`ensure` signature contract, or an `@trusted("reason")`
# annotation stating why the unverified native body is trusted. An extern with neither is
# flagged. Decidable syntactically: signature contracts are line-keyed in file.signature_
# contract_lines; the annotation is a decorator named "trusted".
extend Semantic:
    private:
        # An extern's boundary contract is recorded by the parser as an `__extern_contract`
        # annotation line-paired to the extern (its `requires`/`ensure` clause is consumed
        # without being modeled), OR as a line-keyed signature contract.
        def extern_has_signature_contract(line: u32, signature_contract_lines: darray[u32]&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                true return if any contract_line in signature_contract_lines where contract_line == line
                return any annotation in annotations where annotation.name == "__extern_contract" and annotation.line == line

        def extern_has_trusted(decorators: darray[Ast::Annotation]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return any decorator in decorators where decorator.name == "trusted"

        def check_extern_contract(declarations: darray[Ast::Decl], signature_contract_lines: darray[u32], annotations: darray[Ast::EnumAnnotation], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                            has_contract: bool = extern_has_signature_contract(line, signature_contract_lines, annotations)
                            has_trusted: bool = extern_has_trusted(decorators)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ExternNoContract, name: name, line: line, expected: "", actual: ""}) if not has_contract and not has_trusted
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_extern_contract(module_body, signature_contract_lines, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_extern_contract(scoped_body, signature_contract_lines, annotations, table)
                        _:
                            pass
