# Byte-buffer builders for diagnostics and other UTF-8 output.
module Bytes:
    public:
        # Append a NUL-terminated C string's bytes to a byte buffer. The cstr type makes
        # the strlen-based view below explicit at the call boundary.
        def push_str(buffer: mutable darray[u8]&, literal: cstr) -> void can[Memory.Allocate, Abort.Panic]:
            for byte in sview(literal, 0, -1) |buffer|:
                buffer.push(byte)


        # Append a source span's raw bytes to a byte buffer. An sview is a contiguous
        # {data, len} byte view, so this lowers to a single arena_memcpy (not a per-byte
        # fill) — the ideal shape for the hot string-append helper called on every
        # diagnostic and token span.
        def push_sview(buffer: mutable darray[u8]&, view: sview) -> void can[Memory.Allocate, Abort.Panic]:
            buffer.extend(view)


        # Append a variant path's BARE tail: with family "Shape", a `path` of "Shape.Nope"
        # appends `Nope` and a `path` of "Nope" appends `Nope` too. stage0 names the enum and
        # the variant in SEPARATE quoted slots, but stage1's two UnknownVariant sites disagree
        # on what they record -- the pattern walker stores the qualified path it matched, the
        # value-position walker stores the bare member. Normalising here rather than at the two
        # call sites keeps one rule, and stays correct if a third site records either shape.
        # The tail is a SUFFIX of a source sview: nothing is allocated and no view is retained.
        def push_variant_tail(buffer: mutable darray[u8]&, family: sview, path: sview) -> void can[Memory.Allocate, Abort.Panic]:
            start: mutable usize = 0
            if family.len > 0 and path.len > family.len and path[family.len] == 46:
                head_matches: mutable bool = true
                for probe in 0..<family.len |head_matches, family, path|:
                    head_matches <- false if path[probe] != family[probe]
                start <- family.len + 1 if head_matches
            for index in start..<path.len |buffer, path|:
                buffer.push(path[index])


        # Append the decimal digits of `number` (>= 0) to a byte buffer. Digits are generated
        # least-significant first, so they are emitted in reverse to land in reading order.
        def push_int(buffer: mutable darray[u8]&, number: i64) -> void can[Memory.Allocate, Abort.Panic]:
            if number == 0:
                buffer.push(48)
                return
            digits: mutable darray[u8] = []
            while remaining > 0 |remaining: i64 = number|:
                digits.push((48 + (remaining % 10)).u8())
                remaining <- remaining / 10
            while digit_index >= 0 |digit_index: i64 = digits.count.i64() - 1|:
                buffer.push(digits[digit_index.usize()])
                digit_index <- digit_index - 1

