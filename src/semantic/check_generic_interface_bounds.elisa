# Validate explicit type arguments against interface bounds retained from generic
# headers and simple `impl Interface for Concrete` declarations. Bound rows live in
# the generic side table with the owner line's high bit set; implementation rows are
# EnumAnnotations with line 0.

extend Semantic:
    private:
        def type_implements_interface(type_name: sview, interface_name: sview, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.line == 0 and annotation.owner == type_name and annotation.name == interface_name


        # Generic side-table rows are keyed only by line. Require a current owner index
        # with exactly one generic-capable declaration before trusting that key.
        def generic_owner_line_is_unique(line: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if line == 0 or line >= 2147483648 or not table.generic_owner_index_built or table.generic_owner_index_symbol_count != table.generic_owner_source_symbol_count
                owner_count: u32 = count if table.generic_owner_line_counts.get(line) is count else 0
                return owner_count == 1

        def generic_line_has_interface_bounds(line: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if line == 0
                return true if line >= 2147483648
                if table.generic_bound_index_built and table.generic_bound_index_param_count == table.generic_param_lines.count and table.generic_param_lines.count == table.generic_param_names.count:
                    # A stamped empty index proves the canonical, parallel row set has no
                    # encoded bounds; avoid rescanning it for every ordinary line lookup.
                    return false if table.generic_bound_index_empty
                    if table.generic_bound_owner_lines.get(line) is present:
                        return present
                    # The complete index is built after parser rows are copied into the
                    # SymbolTable, and those rows are immutable for this semantic pass.
                    # A missing key in a current index proves absence too.
                    return false
                # A malformed parallel table cannot prove that bounds are absent: its
                # line side may be the truncated column. Treat it as potentially bounded
                # so ambiguity paths report incomplete metadata instead of accepting it.
                return true if table.generic_param_lines.count != table.generic_param_names.count
                # A stale index stamp with valid canonical rows is not proof of absence.
                return any encoded_line in table.generic_param_lines where encoded_line >= 2147483648 and (encoded_line & 2147483647) == line

        def generic_function_name_has_bounds(function_name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                if not table.symbol_name_index_valid or table.symbol_name_indexed_rows != table.symbols.count or table.symbol_name_next.count != table.symbols.count:
                    return any symbol in table.symbols where symbol.name == function_name and symbol.kind == SymbolKind.Func and generic_line_has_interface_bounds(symbol.line, table)
                hash: u64 = name_hash(function_name)
                expected_count: mutable usize = 0.usize()
                if table.symbol_name_count.get(hash) is indexed_count:
                    expected_count <- indexed_count.usize()
                else:
                    if table.symbol_name_head.get(hash) is orphan_head or table.symbol_name_tail.get(hash) is orphan_tail:
                        return any symbol in table.symbols where symbol.name == function_name and symbol.kind == SymbolKind.Func and generic_line_has_interface_bounds(symbol.line, table)
                    return any symbol in table.symbols where symbol.name == function_name and symbol.kind == SymbolKind.Func and generic_line_has_interface_bounds(symbol.line, table)
                return any symbol in table.symbols where symbol.name == function_name and symbol.kind == SymbolKind.Func and generic_line_has_interface_bounds(symbol.line, table) if expected_count == 0
                expected_tail: mutable u32 = 4294967295
                if table.symbol_name_tail.get(hash) is indexed_tail:
                    expected_tail <- indexed_tail
                else:
                    return any symbol in table.symbols where symbol.name == function_name and symbol.kind == SymbolKind.Func and generic_line_has_interface_bounds(symbol.line, table)
                row: mutable u32 = symbol_chain_head(table, function_name)
                probes: mutable usize = 0
                last_row: mutable u32 = 4294967295
                previous_row: mutable u32 = 4294967295
                while row != 4294967295 |row, probes, last_row, previous_row, expected_count, expected_tail, hash, function_name, table|:
                    if probes >= expected_count:
                        return any symbol in table.symbols where symbol.name == function_name and symbol.kind == SymbolKind.Func and generic_line_has_interface_bounds(symbol.line, table)
                    if row >= table.symbols.count or row >= table.symbol_name_next.count or (previous_row != 4294967295 and row <= previous_row) or name_hash(table.symbols[row.usize()].name) != hash or table.symbols[row.usize()].id.value != row:
                        return any symbol in table.symbols where symbol.name == function_name and symbol.kind == SymbolKind.Func and generic_line_has_interface_bounds(symbol.line, table)
                    symbol: Symbol = table.symbols[row.usize()]
                    return true if symbol.name == function_name and symbol.kind == SymbolKind.Func and generic_line_has_interface_bounds(symbol.line, table)
                    last_row <- row
                    previous_row <- row
                    row <- table.symbol_name_next[row.usize()]
                    probes <- probes + 1
                if probes != expected_count or last_row != expected_tail:
                    return any symbol in table.symbols where symbol.name == function_name and symbol.kind == SymbolKind.Func and generic_line_has_interface_bounds(symbol.line, table)
                return row != 4294967295


        # A type ARGUMENT that is itself a generic type parameter bound by the required
        # interface satisfies the bound: `use_pair[B: Builder]` passing `B` to
        # `build_pair[B: Builder]` is well-formed. The generic side-table pairs a param
        # entry `(fnLine, paramName)` with its bound entries `(fnLine + 2^31, interface)`.
        def type_param_satisfies_bound(argument_name: sview, interface_name: sview, caller_line: u32, table: SymbolTable&) -> bool:
            can Abort.Panic:
                return false if:
                    caller_line == 0 or caller_line >= 2147483648
                    table.generic_param_lines.count != table.generic_param_names.count
                    not generic_owner_line_is_unique(caller_line, table)
                if table.generic_param_name_index_count == table.generic_param_names.count and table.generic_param_name_next.count == table.generic_param_names.count:
                    if table.generic_param_name_heads.get(name_hash(argument_name)) is head:
                        parameter_row: mutable u32 = head
                        probes: mutable usize = 0
                        matching_parameter_rows: mutable usize = 0
                        selected_parameter_row: mutable usize = 0
                        index_chain_complete: mutable bool = true
                        while parameter_row != SYMBOL_INDEX_ROW_NONE and probes < table.generic_param_names.count |parameter_row, probes, argument_name, caller_line, table, matching_parameter_rows, selected_parameter_row, index_chain_complete|:
                            if parameter_row.usize() >= table.generic_param_lines.count or parameter_row.usize() >= table.generic_param_name_next.count:
                                index_chain_complete <- false
                                break
                            row_index: usize = parameter_row.usize()
                            if table.generic_param_lines[row_index] == caller_line and table.generic_param_names[row_index] == argument_name:
                                matching_parameter_rows <- matching_parameter_rows + 1
                                selected_parameter_row <- row_index
                            parameter_row <- table.generic_param_name_next[row_index]
                            probes <- probes + 1
                        index_chain_complete <- false if parameter_row != SYMBOL_INDEX_ROW_NONE
                        if index_chain_complete and matching_parameter_rows == 1:
                            bound_row: mutable usize = selected_parameter_row + 1
                            while bound_row < table.generic_param_lines.count |bound_row, caller_line, interface_name, matching_bound|:
                                row_line: u32 = table.generic_param_lines[bound_row]
                                return matching_bound if row_line < 2147483648
                                matching_bound <- true if row_line == caller_line + 2147483648 and table.generic_param_names[bound_row] == interface_name
                                bound_row <- bound_row + 1
                            return matching_bound

                # Missing heads, malformed chains, and ambiguous hits fall back to the
                # canonical row-order scan below.
                matching_parameters: mutable usize = 0
                matching_bound: mutable bool = false
                active_parameter_matches: mutable bool = false
                param_index: mutable usize = 0
                while param_index < table.generic_param_lines.count |param_index, argument_name, interface_name, caller_line, table, matching_parameters, matching_bound, active_parameter_matches|:
                    param_line: u32 = table.generic_param_lines[param_index]
                    if param_line == caller_line and param_line < 2147483648:
                        active_parameter_matches <- table.generic_param_names[param_index] == argument_name
                        matching_parameters <- matching_parameters + 1 if active_parameter_matches
                    elif param_line == caller_line + 2147483648 and active_parameter_matches and table.generic_param_names[param_index] == interface_name:
                        matching_bound <- true
                    param_index <- param_index + 1
                return matching_parameters == 1 and matching_bound


        def inferred_protocol_argument_name(argument: Ast::Expr, argument_type: InferType) -> sview:
            can Abort.Panic:
                if argument is Ast::Expr.Construct(type_expression, fields, pos):
                    return bare_type_name(type_expression)
                return argument_type.name if argument_type.name != ""
                if argument_type.kind != SemTypeKind.Unknown:
                    stage0_name: sview = stage0_value_spelling(argument_type)
                    return stage0_name if stage0_name != ""
                return bare_type_name(argument)


        def explicit_protocol_argument_name(argument: Ast::Expr) -> sview:
            can Abort.Panic:
                argument_name: sview = bare_type_name(argument)
                return "non-name type argument" if argument_name == ""
                return argument_name


        def check_inferred_protocol_argument(function_name: sview, parameter_name: sview, argument: Ast::Expr, argument_type: InferType, call_pos: Ast::Pos, caller_line: u32, unique_direct_function: bool, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Semantic has no selected-call declaration identity here. Calls with a
                # same-name overload set must not inherit the first symbol's protocol bounds.
                # Until selected-candidate metadata is available, fail closed if any candidate
                # has a bound that this call could otherwise bypass.
                return if not sview_starts_with(parameter_name, "__protocol_arg_")
                if not unique_direct_function:
                    if generic_function_name_has_bounds(function_name, table):
                        actual: sview = inferred_protocol_argument_name(argument, argument_type)
                        actual_display: sview = "unresolved argument type" if actual == "" else actual
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.GenericInterfaceBoundUnsatisfied, name: function_name, pos: call_pos, line: call_pos.line, expected: "unambiguous overload for inferred interface bounds", actual: actual_display, expected_count: 1})
                    return
                if find_symbol(table, function_name) is function_symbol:
                    if not generic_owner_line_is_unique(function_symbol.line, table):
                        if generic_line_has_interface_bounds(function_symbol.line, table):
                            actual: sview = inferred_protocol_argument_name(argument, argument_type)
                            actual_display: sview = "unresolved argument type" if actual == "" else actual
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.GenericInterfaceBoundUnsatisfied, name: function_name, pos: call_pos, line: call_pos.line, expected: "unambiguous generic declaration identity", actual: actual_display, expected_count: 1})
                        return
                    if table.generic_param_lines.count != table.generic_param_names.count:
                        actual: sview = inferred_protocol_argument_name(argument, argument_type)
                        actual_display: sview = "unresolved argument type" if actual == "" else actual
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.GenericInterfaceBoundUnsatisfied, name: function_name, pos: call_pos, line: call_pos.line, expected: "complete generic interface bound metadata", actual: actual_display, expected_count: 1})
                        return
                    active_parameter: mutable sview = ""
                    for index in 0..<table.generic_param_lines.count |table, active_parameter, parameter_name, argument_type, function_symbol, function_name, argument|:
                        row_line: u32 = table.generic_param_lines[index]
                        if row_line == function_symbol.line:
                            active_parameter <- table.generic_param_names[index]
                        elif row_line == function_symbol.line + 2147483648 and active_parameter == parameter_name:
                            bound: sview = table.generic_param_names[index]
                            actual: sview = inferred_protocol_argument_name(argument, argument_type)
                            actual_display: sview = "unresolved argument type" if actual == "" else actual
                            satisfied: bool = actual != "" and (type_implements_interface(actual, bound, table.protocol_annotations) or type_param_satisfies_bound(actual, bound, caller_line, table))
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.GenericInterfaceBoundUnsatisfied, name: function_name, pos: call_pos, line: call_pos.line, expected: bound, actual: actual_display, expected_count: 1}) if not satisfied

        def check_interface_specialization(object: Ast::Expr, argument: Ast::Expr, argument_index: usize, line: u32, caller_line: u32, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match object:
                    Expr.Ident(function_name, function_line):
                        # The source walk has only the spelling at this point. Do not bind an
                        # explicit type argument to whichever overload find_symbol returns.
                        if direct_function_count(table, function_name) != 1:
                            if generic_function_name_has_bounds(function_name, table):
                                actual: sview = explicit_protocol_argument_name(argument)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.GenericInterfaceBoundUnsatisfied, name: function_name, line: line, expected: "unambiguous generic overload for interface bounds", actual: actual})
                            return
                        if find_symbol(table, function_name) is symbol:
                            return if symbol.kind != SymbolKind.Func
                            if not generic_owner_line_is_unique(symbol.line, table):
                                if generic_line_has_interface_bounds(symbol.line, table):
                                    actual: sview = explicit_protocol_argument_name(argument)
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.GenericInterfaceBoundUnsatisfied, name: function_name, line: line, expected: "unambiguous generic declaration identity", actual: actual})
                                return
                            if table.generic_param_lines.count != table.generic_param_names.count:
                                actual: sview = explicit_protocol_argument_name(argument)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.GenericInterfaceBoundUnsatisfied, name: function_name, line: line, expected: "complete generic interface bound metadata", actual: actual})
                                return
                            argument_name: sview = bare_type_name(argument)
                            generic_count: mutable usize = 0
                            current_parameter: mutable sview = ""
                            selected_parameter: mutable sview = ""
                            interfaces: mutable darray[sview] = []
                            while bound_index < table.generic_param_lines.count |bound_index: usize = 0, table, generic_count, interfaces, symbol, current_parameter, selected_parameter, argument_index|:
                                encoded_line: u32 = table.generic_param_lines[bound_index]
                                if encoded_line < 2147483648 and encoded_line == symbol.line:
                                    selected_parameter <- table.generic_param_names[bound_index] if generic_count == argument_index
                                    generic_count <- generic_count + 1
                                    current_parameter <- table.generic_param_names[bound_index]
                                elif encoded_line >= 2147483648 and encoded_line - 2147483648 == symbol.line and current_parameter == selected_parameter and selected_parameter != "":
                                    interfaces.push(table.generic_param_names[bound_index])
                                bound_index <- bound_index + 1
                            return if argument_index >= generic_count or selected_parameter == ""
                            for interface_name in interfaces |table, function_name, line, argument_name, annotations|:
                                actual: sview = explicit_protocol_argument_name(argument)
                                satisfied: bool = argument_name != "" and (type_implements_interface(argument_name, interface_name, annotations) or type_param_satisfies_bound(argument_name, interface_name, caller_line, table))
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.GenericInterfaceBoundUnsatisfied, name: function_name, line: line, expected: interface_name, actual: actual}) if not satisfied
                    _:
                        pass


        def walk_interface_bound_expression(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, caller_line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(object, argument, line):
                        table <- check_interface_specialization(object, argument, 0, line.line, caller_line, annotations, table)
                        table <- walk_interface_bound_expression(object, annotations, caller_line, table)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_interface_bound_expression(object, annotations, caller_line, table)
                        for argument_index in 0..<arguments.count |arguments, table, annotations, line, argument_index, caller_line|:
                            table <- check_interface_specialization(object, arguments[argument_index], argument_index, line.line, caller_line, annotations, table)
                            argument: Ast::Expr = arguments[argument_index]
                            table <- walk_interface_bound_expression(argument, annotations, caller_line, table)
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_interface_bound_expression(callee, annotations, caller_line, table)
                        for argument in arguments |table|:
                            table <- walk_interface_bound_expression(argument, annotations, caller_line, table)
                    Expr.Binary(left, operator, right, line):
                        table <- walk_interface_bound_expression(left, annotations, caller_line, table)
                        table <- walk_interface_bound_expression(right, annotations, caller_line, table) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Unary(operator, operand, line):
                        table <- walk_interface_bound_expression(operand, annotations, caller_line, table)
                    Expr.Paren(inner, line):
                        table <- walk_interface_bound_expression(inner, annotations, caller_line, table)
                    Expr.Field(object, field, line):
                        table <- walk_interface_bound_expression(object, annotations, caller_line, table)
                    Expr.Scope(base, name, line):
                        table <- walk_interface_bound_expression(base, annotations, caller_line, table)
                    Expr.Slice(object, low, high, line):
                        table <- walk_interface_bound_expression(object, annotations, caller_line, table)
                        table <- walk_interface_bound_expression(low, annotations, caller_line, table)
                        table <- walk_interface_bound_expression(high, annotations, caller_line, table)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- walk_interface_bound_expression(element, annotations, caller_line, table)
                    Expr.If(condition, then_expression, else_expression, line):
                        table <- walk_interface_bound_expression(condition, annotations, caller_line, table)
                        table <- walk_interface_bound_expression(then_expression, annotations, caller_line, table)
                        table <- walk_interface_bound_expression(else_expression, annotations, caller_line, table)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_interface_bound_expression(scrutinee, annotations, caller_line, table)
                        for arm in arms |table|:
                            table <- walk_interface_bound_statements(arm.body, annotations, caller_line, table)
                    _:
                        pass


        def walk_interface_bound_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, caller_line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- walk_interface_bound_expression(value, annotations, caller_line, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- walk_interface_bound_expression(target, annotations, caller_line, table)
                            table <- walk_interface_bound_expression(value, annotations, caller_line, table)
                        Stmt.Return(value, line):
                            table <- walk_interface_bound_expression(return_value, annotations, caller_line, table) if value is return_value
                        Stmt.Expr(expression, line):
                            table <- walk_interface_bound_expression(expression, annotations, caller_line, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_interface_bound_expression(condition, annotations, caller_line, table)
                            table <- walk_interface_bound_statements(then_body, annotations, caller_line, table)
                            table <- walk_interface_bound_statements(else_body, annotations, caller_line, table)
                        Stmt.While(condition, body, line):
                            table <- walk_interface_bound_expression(condition, annotations, caller_line, table)
                            table <- walk_interface_bound_statements(body, annotations, caller_line, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_interface_bound_expression(iterable, annotations, caller_line, table)
                            table <- walk_interface_bound_statements(body, annotations, caller_line, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- walk_interface_bound_statements(body, annotations, caller_line, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- walk_interface_bound_expression(scrutinee, annotations, caller_line, table)
                            for arm in arms |table|:
                                table <- walk_interface_bound_statements(arm.body, annotations, caller_line, table)
                        _:
                            pass


        def walk_interface_bound_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- walk_interface_bound_statements(body, annotations, line.line, table)
                        Decl.Module(name, body, line) | Decl.Scoped(body, line):
                            table <- walk_interface_bound_declarations(body, annotations, table)
                        _:
                            pass

    public:
        def check_generic_interface_bounds(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- walk_interface_bound_declarations(file.top_decls, file.enum_annotations, table)
