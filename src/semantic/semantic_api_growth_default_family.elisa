# Closed mapping from container growth methods to their default family labels.
module SemanticApiGrowthDefaultFamily:
    public:
        def growth_default_family(method: sview) -> sview:
            ensure (result == "set") == (method == "add")
            ensure (result == "dict") == (method == "put" or method == "get_or_insert")
            ensure (result == "darray") == (method != "add" and method != "put" and method != "get_or_insert")
            can Abort.Panic:
                return when method:
                    "add" -> "set"
                    "put" | "get_or_insert" -> "dict"
                    _ -> "darray"
