extend Semantic:
    private:
        # Finds the call-argument and struct-literal sites nested anywhere in an expression.
        # A nested value `return` (a lambda body) has no enclosing return type of its own here.
        def walk_static_expression(lexical_module: sview, expression: Ast::Expr, names: mutable darray[sview]&, spellings: mutable darray[sview]&, targets: mutable darray[sview]&, consts: darray[sview]&, accumulator_offsets: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        callee_name: sview = ident_name_of(callee)
                        # A local of the callee's spelling (a lambda) is not the function.
                        callee_is_local: bool = callee_name != "" and (any bound_name in names where bound_name == callee_name)
                        table <- check_static_call_arguments(callee_name, arguments, argument_names, call_pos, names, spellings, targets, consts, accumulator_offsets, table) if callee_name != "" and not callee_is_local and direct_function_count(table, callee_name) == 1
                        match callee:
                            Expr.Scope(module_expression, qualified_name, _):
                                module_name: sview = ident_name_of(module_expression)
                                declaration_id: DeclId = static_qualified_function_id(table, module_name, qualified_name) if module_name != "" and not static_module_name_is_alias(table, module_name) else DeclId{value: SYMBOL_INDEX_ROW_NONE}
                                table <- check_static_qualified_call_arguments(qualified_name, declaration_id, arguments, argument_names, call_pos, names, spellings, targets, consts, accumulator_offsets, table) if declaration_id.value != SYMBOL_INDEX_ROW_NONE
                            _:
                                pass
                        table <- walk_static_expression(lexical_module, callee, names, spellings, targets, consts, accumulator_offsets, table)
                        table <- walk_static_expressions(lexical_module, arguments, names, spellings, targets, consts, accumulator_offsets, table)
                    Expr.Construct(type_expression, fields, construct_pos):
                        struct_name: sview = ident_name_of(type_expression)
                        for field in fields |table, names, spellings, targets|:
                            field_target: sview = static_string_target(field_type_of(table, struct_name, field.name)) if struct_name != "" and field.name != "" else ""
                            field_spelling: sview = static_use_spelling(field.value, field_target, names, spellings, targets, consts, accumulator_offsets) if field_target != "" else ""
                            table <- static_report(Diagnostic{kind: DiagnosticKind.ConstructFieldTypeMismatch, name: field.name, pos: Ast::expr_pos(field.value), line: construct_pos.line, expected: field_target, actual: field_spelling}, table) if field_spelling != ""
                            table <- static_ternary_pair(field.value, field_target, names, spellings, targets, consts, accumulator_offsets, table)
                            table <- walk_static_expression(lexical_module, field.value, names, spellings, targets, consts, accumulator_offsets, table)
                    Expr.RecordUpdate(base, fields, _):
                        table <- walk_static_expression(lexical_module, base, names, spellings, targets, consts, accumulator_offsets, table)
                        for field in fields |table, names, spellings, targets|:
                            table <- walk_static_expression(lexical_module, field.value, names, spellings, targets, consts, accumulator_offsets, table)
                    Expr.Binary(left, operator, right, _):
                        table <- walk_static_expression(lexical_module, left, names, spellings, targets, consts, accumulator_offsets, table)
                        table <- walk_static_expression(lexical_module, right, names, spellings, targets, consts, accumulator_offsets, table) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Unary(_, operand, _):
                        table <- walk_static_expression(lexical_module, operand, names, spellings, targets, consts, accumulator_offsets, table)
                    Expr.Move(operand, _):
                        table <- walk_static_expression(lexical_module, operand, names, spellings, targets, consts, accumulator_offsets, table)
                    Expr.RegionNew(operand, _, _):
                        table <- walk_static_expression(lexical_module, operand, names, spellings, targets, consts, accumulator_offsets, table)
                    Expr.Paren(inner, _):
                        table <- walk_static_expression(lexical_module, inner, names, spellings, targets, consts, accumulator_offsets, table)
                    Expr.Field(object, _, _):
                        table <- walk_static_expression(lexical_module, object, names, spellings, targets, consts, accumulator_offsets, table)
                    Expr.Index(object, index, _):
                        table <- walk_static_expression(lexical_module, object, names, spellings, targets, consts, accumulator_offsets, table)
                        table <- walk_static_expression(lexical_module, index, names, spellings, targets, consts, accumulator_offsets, table)
                    Expr.Slice(object, low, high, _):
                        table <- walk_static_expression(lexical_module, object, names, spellings, targets, consts, accumulator_offsets, table)
                        table <- walk_static_expression(lexical_module, low, names, spellings, targets, consts, accumulator_offsets, table)
                        table <- walk_static_expression(lexical_module, high, names, spellings, targets, consts, accumulator_offsets, table)
                    Expr.IndexN(object, arguments, _):
                        table <- walk_static_expression(lexical_module, object, names, spellings, targets, consts, accumulator_offsets, table)
                        table <- walk_static_expressions(lexical_module, arguments, names, spellings, targets, consts, accumulator_offsets, table)
                    Expr.Array(elements, _):
                        table <- walk_static_expressions(lexical_module, elements, names, spellings, targets, consts, accumulator_offsets, table)
                    Expr.Tuple(elements, _):
                        table <- walk_static_expressions(lexical_module, elements, names, spellings, targets, consts, accumulator_offsets, table)
                    Expr.SetLit(elements, _):
                        table <- walk_static_expressions(lexical_module, elements, names, spellings, targets, consts, accumulator_offsets, table)
                    Expr.DictLit(entries, _):
                        for entry in entries |table, names, spellings, targets|:
                            table <- walk_static_expression(lexical_module, entry.key, names, spellings, targets, consts, accumulator_offsets, table)
                            table <- walk_static_expression(lexical_module, entry.value, names, spellings, targets, consts, accumulator_offsets, table)
                    Expr.If(condition, then_expr, else_expr, _):
                        table <- walk_static_expression(lexical_module, condition, names, spellings, targets, consts, accumulator_offsets, table)
                        if_mark: usize = names.count
                        static_push_row("", "", "", names, spellings, targets) if not static_binder_free(condition)
                        table <- walk_static_expression(lexical_module, then_expr, names, spellings, targets, consts, accumulator_offsets, table)
                        table <- walk_static_expression(lexical_module, else_expr, names, spellings, targets, consts, accumulator_offsets, table)
                        static_close_scope(if_mark, names, spellings, targets)
                    Expr.Match(scrutinee, arms, _):
                        table <- walk_static_expression(lexical_module, scrutinee, names, spellings, targets, consts, accumulator_offsets, table)
                        table <- walk_static_arms(lexical_module, arms, "", names, spellings, targets, consts, accumulator_offsets, table)
                    Expr.Catch(guarded, arms, _):
                        table <- walk_static_expression(lexical_module, guarded, names, spellings, targets, consts, accumulator_offsets, table)
                        table <- walk_static_arms(lexical_module, arms, "", names, spellings, targets, consts, accumulator_offsets, table)
                    Expr.Comprehension(variable, iterable, condition, body, _, _):
                        table <- walk_static_expression(lexical_module, iterable, names, spellings, targets, consts, accumulator_offsets, table)
                        comprehension_mark: usize = names.count
                        static_push_row(variable, "", "", names, spellings, targets)
                        table <- walk_static_expression(lexical_module, condition, names, spellings, targets, consts, accumulator_offsets, table)
                        table <- walk_static_expression(lexical_module, body, names, spellings, targets, consts, accumulator_offsets, table)
                        static_close_scope(comprehension_mark, names, spellings, targets)
                    Expr.Refinement(base, _, _):
                        table <- walk_static_expression(lexical_module, base, names, spellings, targets, consts, accumulator_offsets, table)
                    Expr.GetElse(guarded, recovery, _):
                        table <- walk_static_expression(lexical_module, guarded, names, spellings, targets, consts, accumulator_offsets, table)
                        recovery_mark: usize = names.count
                        table <- walk_static_statements(lexical_module, recovery, "", recovery_mark, names, spellings, targets, consts, accumulator_offsets, table)
                        static_close_scope(recovery_mark, names, spellings, targets)
                    Expr.Lambda(parameters, body, _):
                        lambda_mark: usize = names.count
                        for parameter in parameters |names, spellings, targets|:
                            static_push_row(parameter, "", "", names, spellings, targets)
                        table <- walk_static_statements(lexical_module, body, "", lambda_mark, names, spellings, targets, consts, accumulator_offsets, table)
                        static_close_scope(lambda_mark, names, spellings, targets)
                    Expr.Block(statements, block_tail, _, _):
                        block_mark: usize = names.count
                        table <- walk_static_statements(lexical_module, statements, "", block_mark, names, spellings, targets, consts, accumulator_offsets, table)
                        table <- walk_static_expression(lexical_module, block_tail, names, spellings, targets, consts, accumulator_offsets, table)
                        static_close_scope(block_mark, names, spellings, targets)
                    _:
                        pass

        # A typed darray literal: `xs: darray[sview] = [s]` checks each element.
        def check_static_darray_elements(type_expression: Ast::Expr, value: Ast::Expr, names: mutable darray[sview]&, spellings: mutable darray[sview]&, targets: mutable darray[sview]&, consts: darray[sview]&, accumulator_offsets: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Expr.Unary(operator, operand, _):
                        table <- check_static_darray_elements(operand, value, names, spellings, targets, consts, accumulator_offsets, table) if operator == TokenKind.Mutable
                    Expr.Index(head, element_type, _):
                        return if ident_name_of(head) != "darray"
                        element_target: sview = static_annotation_target(element_type)
                        return if element_target == ""
                        match value:
                            Expr.Array(elements, _):
                                for element in elements |table, names, spellings, targets|:
                                    element_spelling: sview = static_use_spelling(element, element_target, names, spellings, targets, consts, accumulator_offsets)
                                    table <- static_report(Diagnostic{kind: DiagnosticKind.DArrayElementTypeMismatch, name: "", pos: Ast::expr_pos(element), line: Ast::expr_pos(element).line, expected: element_target, actual: element_spelling}, table) if element_spelling != ""
                                    table <- static_ternary_pair(element, element_target, names, spellings, targets, consts, accumulator_offsets, table)
                            _:
                                pass
                    _:
                        pass

        # `return_target` is the enclosing function's rejecting return spelling ("" when its
        # return type accepts a static string, is unmodeled, or the body is a lambda's).
        def walk_static_statements(lexical_module: sview, statements: darray[Ast::Stmt], return_target: sview @source, scope_start: usize, names: mutable darray[sview]&, spellings: mutable darray[sview]&, targets: mutable darray[sview]&, consts: darray[sview]&, accumulator_offsets: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, names, spellings, targets|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, pos):
                            table <- walk_static_expression(lexical_module, value, names, spellings, targets, consts, accumulator_offsets, table)
                            declared_target: sview = static_annotation_target(type_expression)
                            declared_spelling: sview = static_use_spelling(value, declared_target, names, spellings, targets, consts, accumulator_offsets) if declared_target != "" else ""
                            table <- static_report(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: name, pos: pos, line: pos.line, expected: declared_target, actual: declared_spelling}, table) if declared_spelling != ""
                            table <- static_ternary_pair(value, declared_target, names, spellings, targets, consts, accumulator_offsets, table)
                            table <- check_static_darray_elements(type_expression, value, names, spellings, targets, consts, accumulator_offsets, table)
                            record_static_binding(statement, scope_start, names, spellings, targets, consts, accumulator_offsets)
                        Stmt.Assign(target, operator, value, pos):
                            table <- walk_static_expression(lexical_module, value, names, spellings, targets, consts, accumulator_offsets, table)
                            assigned_target: sview = static_declared_target(ident_name_of(target), names, targets) if operator == TokenKind.LArrow and ident_name_of(target) != "" else ""
                            assigned_spelling: sview = static_use_spelling(value, assigned_target, names, spellings, targets, consts, accumulator_offsets) if assigned_target != "" else ""
                            table <- static_report(Diagnostic{kind: DiagnosticKind.AssignValueMismatch, name: "", pos: pos, line: pos.line, expected: assigned_target, actual: assigned_spelling}, table) if assigned_spelling != ""
                            table <- static_ternary_pair(value, assigned_target, names, spellings, targets, consts, accumulator_offsets, table)
                            record_static_binding(statement, scope_start, names, spellings, targets, consts, accumulator_offsets)
                        Stmt.Return(value, pos):
                            if value is returned:
                                table <- walk_static_expression(lexical_module, returned, names, spellings, targets, consts, accumulator_offsets, table)
                                returned_spelling: sview = static_use_spelling(returned, return_target, names, spellings, targets, consts, accumulator_offsets) if return_target != "" else ""
                                table <- static_report(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: "return", pos: pos, line: pos.line, expected: return_target, actual: returned_spelling}, table) if returned_spelling != ""
                                table <- static_ternary_pair(returned, return_target, names, spellings, targets, consts, accumulator_offsets, table)
                        Stmt.Expr(expression, _):
                            table <- walk_static_expression(lexical_module, expression, names, spellings, targets, consts, accumulator_offsets, table)
                        Stmt.Contract(_, expression, _):
                            table <- walk_static_expression(lexical_module, expression, names, spellings, targets, consts, accumulator_offsets, table)
                        Stmt.If(condition, then_body, else_body, _):
                            table <- walk_static_expression(lexical_module, condition, names, spellings, targets, consts, accumulator_offsets, table)
                            branch_mark: usize = names.count
                            static_push_row("", "", "", names, spellings, targets) if not static_binder_free(condition)
                            table <- walk_static_statements(lexical_module, then_body, return_target, branch_mark, names, spellings, targets, consts, accumulator_offsets, table)
                            static_close_scope(branch_mark, names, spellings, targets)
                            static_push_row("", "", "", names, spellings, targets) if not static_binder_free(condition)
                            table <- walk_static_statements(lexical_module, else_body, return_target, branch_mark, names, spellings, targets, consts, accumulator_offsets, table)
                            static_close_scope(branch_mark, names, spellings, targets)
                        Stmt.While(condition, body, _):
                            table <- walk_static_expression(lexical_module, condition, names, spellings, targets, consts, accumulator_offsets, table)
                            while_mark: usize = names.count
                            static_push_row("", "", "", names, spellings, targets) if not static_binder_free(condition)
                            table <- walk_static_statements(lexical_module, body, return_target, while_mark, names, spellings, targets, consts, accumulator_offsets, table)
                            static_close_scope(while_mark, names, spellings, targets)
                        Stmt.For(_, variables, iterable, body, _):
                            table <- walk_static_expression(lexical_module, iterable, names, spellings, targets, consts, accumulator_offsets, table)
                            for_mark: usize = names.count
                            # A binder over an array of string literals is `static u8&` in
                            # stage0 (measured: `for w in ["ab"]: f(w)` with `f(s: sview)` is
                            # "expects sview, got static u8&"); stage1 left it unknown and the
                            # call reached the backend as invalid IR.
                            binder_spelling: sview = "static u8&" if variables.count == 1 and static_string_literal_array(iterable) else ""
                            for variable in variables |names, spellings, targets|:
                                static_push_row(variable, binder_spelling if not sview_starts_with(variable, "__") else "", "", names, spellings, targets)
                            table <- walk_static_statements(lexical_module, body, return_target, for_mark, names, spellings, targets, consts, accumulator_offsets, table)
                            static_close_scope(for_mark, names, spellings, targets)
                        Stmt.Block(kind, _, binding, body, _):
                            if kind == "let":
                                let_name: mutable sview = ""
                                let_spelling: mutable sview = ""
                                let_recordable: mutable bool = false
                                if body.count > 0:
                                    match body[0]:
                                        Stmt.Match(let_value, let_arms, _):
                                            let_name <- static_let_simple_name(let_arms)
                                            let_source_spelling: sview = static_value_spelling(let_value, names, spellings, targets, consts, accumulator_offsets)
                                            let_spelling <- "static u8&" if StaticStringSpelling::participates_in_static_join(let_source_spelling) else ("static mutable u8&" if let_source_spelling == "static mutable u8&" else "")
                                            let_recordable <- let_name != "" and not static_bound_in_scope(let_name, scope_start, names) and not sview_starts_with(let_name, "__")
                                        _:
                                            pass
                                # Desugared let bindings are declared in the enclosing scope.
                                # Walking its lowered match and VarDecls there also keeps unknown
                                # destructured names shadowing older bindings after the let.
                                table <- walk_static_statements(lexical_module, body, return_target, scope_start, names, spellings, targets, consts, accumulator_offsets, table)
                                static_set_last_scope_spelling(let_name, scope_start, let_spelling, names, spellings) if let_recordable and let_spelling != ""
                            elif kind == "move" or kind == "expect":
                                # These lowered destructuring forms also introduce names into
                                # the enclosing scope. Keep their generated rows as unknown so
                                # they cannot expose a shadowed outer static-string binding.
                                table <- walk_static_statements(lexical_module, body, return_target, scope_start, names, spellings, targets, consts, accumulator_offsets, table)
                            else:
                                clause_mark: usize = names.count
                                static_push_row(binding, "", "", names, spellings, targets) if binding != ""
                                table <- walk_static_statements(lexical_module, body, return_target, clause_mark, names, spellings, targets, consts, accumulator_offsets, table)
                                static_close_scope(clause_mark, names, spellings, targets)
                        Stmt.Match(scrutinee, arms, _):
                            table <- walk_static_expression(lexical_module, scrutinee, names, spellings, targets, consts, accumulator_offsets, table)
                            table <- walk_static_arms(lexical_module, arms, return_target, names, spellings, targets, consts, accumulator_offsets, table)
                        _:
                            pass

        # Unannotated, immutable string consts as (module, name) pairs; `module_name` is the
        # innermost enclosing module ("" at top level).
        def collect_static_consts(declarations: darray[Ast::Decl], module_name: sview, candidates: mutable darray[sview]&, const_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |candidates, const_names|:
                    match declaration:
                        Decl.Const(name, type_expression, value, is_mutable, _):
                            const_names.push(module_name)
                            const_names.push(name)
                            if not is_mutable and (type_expression is Expr.Invalid or type_expression is Expr.Absent) and (value is Expr.StringLit(_, _)):
                                candidates.push(module_name)
                                candidates.push(name)
                        Decl.Module(inner_module, body, _):
                            collect_static_consts(body, inner_module, candidates, const_names)
                        Decl.Scoped(body, _):
                            collect_static_consts(body, module_name, candidates, const_names)
                        _:
                            pass

        # `const_pairs` are the modeled (module, name) consts; `module_name` is the module whose
        # body `declarations` is ("" at top level).
        def static_string_binding_walk(declarations: darray[Ast::Decl], module_name: sview, const_pairs: darray[sview]&, accumulator_offsets: darray[u32]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                consts: mutable darray[sview] = []
                while pair + 1 < const_pairs.count |pair: usize = 0, consts|:
                    consts.push("b" if const_pairs[pair] == module_name else "")
                    consts.push(const_pairs[pair])
                    consts.push(const_pairs[pair + 1])
                    pair <- pair + 2
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(params: params, return_type: return_type, body: body, _):
                            names: mutable darray[sview] = []
                            spellings: mutable darray[sview] = []
                            targets: mutable darray[sview] = []
                            for parameter in params |names, spellings, targets|:
                                static_push_row(parameter.name, "", "", names, spellings, targets)
                            return_target: sview = static_annotation_target(return_type_expression) if return_type is return_type_expression else ""
                            table <- walk_static_statements(module_name, body, return_target, 0, names, spellings, targets, consts, accumulator_offsets, table)
                        Decl.Module(inner_module, module_body, _):
                            table <- static_string_binding_walk(module_body, inner_module, const_pairs, accumulator_offsets, table)
                        Decl.Scoped(scoped_body, _):
                            table <- static_string_binding_walk(scoped_body, module_name, const_pairs, accumulator_offsets, table)
                        _:
                            pass

    public:
        def check_static_string_binding(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                const_candidates: mutable darray[sview] = []
                const_names: mutable darray[sview] = []
                collect_static_consts(file.top_decls, "", const_candidates, const_names)
                # Only a (module, name) declared exactly once is modeled.
                consts: mutable darray[sview] = []
                while pair + 1 < const_candidates.count |pair: usize = 0, consts|:
                    declared_count: mutable usize = 0
                    while named + 1 < const_names.count |named: usize = 0, declared_count|:
                        declared_count <- declared_count + 1 if const_names[named] == const_candidates[pair] and const_names[named + 1] == const_candidates[pair + 1]
                        named <- named + 2
                    if declared_count == 1:
                        consts.push(const_candidates[pair])
                        consts.push(const_candidates[pair + 1])
                    pair <- pair + 2
                accumulator_offsets: darray[u32] = [annotation.offset for annotation in file.enum_annotations if annotation.name == "__loop_header_accumulator"]
                table <- static_string_binding_walk(file.top_decls, "", consts, accumulator_offsets, table)
