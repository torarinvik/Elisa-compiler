# `-emit ast` — one DECLARATION's summary line, and the whole report: decorator arguments,
# module display names (stage0 renders a nested path with dots), the `static if` chains stage1
# stores as separate Scoped nodes, and the unit-level questions the later modes ask.


    # The `(args)` of a decorator on SOURCE LINE. Annotation.line is the decorator's own
    # line, so using it directly matters when declarations have multiple stacked decorators:
    # looking for the closest line above the declaration made every decorator inherit the
    # arguments of the last one.
def emit_ast_decorator_args(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32, offset: u32) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        at_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
        return if not at_range.found
        return if tokens[at_range.start].kind != Lexer::TokenKind.At
        open_index: mutable usize = at_range.start
        open_found: mutable bool = false
        for open_probe in at_range.start..<at_range.stop |open_index, open_found, tokens|:
            continue if open_found
            if tokens[open_probe].kind == Lexer::TokenKind.LParen:
                open_index <- open_probe
                open_found <- true
        return if not open_found
        emit_ast_render_tokens(buffer, tokens, source, open_index, at_range.stop)




def emit_ast_indent(buffer: mutable darray[u8]&, level: i64) -> void can[Abort.Panic, Memory.Allocate]:
    for indent_index in 0..<(level * 2) |buffer|:
        buffer.push(32)




def emit_ast_annotation_private(name: sview) -> bool:
    return sview_len(name) >= 2 and sview_at(name, 0) == 95 and sview_at(name, 1) == 95




# `export fn` and `export type` share the compact Extern node with real foreign
# declarations. The parser retains the distinction and the target/alias in the
# enum-annotation side table; keep that representation private to the AST report so
# codegen and the other emit modes continue to consume the stable node shape.
def emit_ast_export_fn_target(annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32) -> sview:
    for annotation in annotations |name, line|:
        return annotation.name if annotation.line == line and annotation.owner == name and not emit_ast_annotation_private(annotation.name) and annotation.name != "" and annotation.name != "__export_type" and annotation.name != "__export_global"
    return ""




def emit_ast_export_type_alias(annotations: darray[Ast::EnumAnnotation]&, target: sview, line: u32) -> sview:
    for annotation in annotations |target, line|:
        return annotation.owner if annotation.line == line and annotation.name == target and annotation.owner != target and annotation.owner != "" and not emit_ast_annotation_private(annotation.owner)
    return ""




def emit_ast_export_type_present(annotations: darray[Ast::EnumAnnotation]&, target: sview, line: u32) -> bool:
    for annotation in annotations |target, line|:
        return true if annotation.line == line and annotation.owner == target and annotation.name == "__export_type"
    return false




def emit_ast_export_global_target(annotations: darray[Ast::EnumAnnotation]&, public_name: sview, line: u32) -> sview:
    for annotation in annotations |public_name, line|:
        continue if annotation.line != line or annotation.owner != public_name or emit_ast_annotation_private(annotation.name) or annotation.name == ""
        for marker in annotations |annotation|:
            return annotation.name if marker.line == line and marker.owner == annotation.name and marker.name == "__export_global"
    return ""




# The AST summary uses exprStr, not the source unparser. Most of the expression
# surface is shared with the formatter, but stage0 intentionally has no FloatLit arm
# in exprStr and therefore prints `<expr>` for float constants. Render arrays here so
# that each unsupported float element keeps that placeholder while the formatter still
# supplies the structural spelling for calls, casts and bitwise expressions.
def emit_ast_const_expr(buffer: mutable darray[u8]&, expression: Ast::Expr, tokens: darray[Lexer::Token]&, source: u8&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        if expression is Expr.FloatLit(ast_float_text):
            emit_tokens_push_sview(buffer, "<expr>")
            return
        if expression is Expr.Array(ast_array_elements, ast_array_line):
            buffer.push(91)
            ast_array_first: mutable bool = true
            for ast_array_element in ast_array_elements |buffer, ast_array_first, tokens, source|:
                emit_tokens_push_sview(buffer, ", ") if not ast_array_first
                ast_array_first <- false
                emit_ast_const_expr(buffer, ast_array_element, tokens, source)
            buffer.push(93)
            return
        FmtUnparse::fmt_expr(buffer, expression, tokens, source)




# stage0 renders a nested module path with DOTS (`module Outer.Inner:`). A module nested in
# another module's BODY carries the parser's qualified name (`Outer::Inner`, one `::`
# segment per enclosing level) while stage0 prints the source spelling; skip one leading
# segment per nesting level to print `Inner`. Shared by the ast and iface writers — the
# iface writer once printed the qualified name (`module Outer.Inner:` at level 1), which
# emit_iface_parity_smoke caught as a 2-fixture divergence.
def emit_module_display_name(buffer: mutable darray[u8]&, name: sview, level: i64) -> void can[Abort.Panic, Memory.Allocate]:
    name_start: mutable usize = 0
    skipped_levels: mutable i64 = 0
    for scan in 0..<sview_len(name) |name, name_start, skipped_levels, level|:
        continue if skipped_levels >= level
        if sview_at(name, scan) == 58 and scan + 1 < sview_len(name) and sview_at(name, scan + 1) == 58:
            name_start <- scan + 2
            skipped_levels <- skipped_levels + 1
    for name_index in name_start..<sview_len(name) |buffer, name|:
        name_byte: u8 = sview_at(name, name_index)
        if name_byte == 58:
            buffer.push(46) if name_index + 1 < sview_len(name) and sview_at(name, name_index + 1) != 58 or name_index > 0 and sview_at(name, name_index - 1) == 58
        else:
            buffer.push(name_byte)



def emit_ast_decl(buffer: mutable darray[u8]&, declaration: Ast::Decl, level: i64, tokens: darray[Lexer::Token]&, source: u8&, local_annotations: darray[Ast::LocalRegionAnnotation]&, enum_annotations: darray[Ast::EnumAnnotation]&, struct_names: darray[sview]&, struct_member_rows: darray[Ast::StructMember]&, struct_member_starts: darray[usize]&, struct_member_counts: darray[usize]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        if declaration is Decl.Func(ast_fn_name, ast_fn_params, ast_fn_return, ast_fn_body, ast_fn_effects, ast_fn_decorators, ast_fn_line):
            # Stage0 includes source decorators in the AST summary. `c_variadic` is a
            # stage1-only synthesized backend marker; it has no source annotation and stage0
            # intentionally does not print it.
            for ast_fn_decorator in ast_fn_decorators |buffer, level, tokens, source, ast_fn_line|:
                continue if ast_fn_decorator.name == "c_variadic"
                emit_ast_indent(buffer, level)
                emit_tokens_push_sview(buffer, "@")
                emit_tokens_push_sview(buffer, ast_fn_decorator.name)
                emit_ast_decorator_args(buffer, tokens, source, ast_fn_decorator.line, 0)
                emit_tokens_push_sview(buffer, "\n")
            emit_ast_indent(buffer, level)
            emit_tokens_push_sview(buffer, "def ")
            emit_tokens_push_sview(buffer, ast_fn_name)
            has_explicit_generic: bool = emit_ast_generic_segment_with_inferred(buffer, tokens, source, ast_fn_line.line, ast_fn_line.offset, ast_fn_body)
            emit_ast_generic_segment(buffer, tokens, source, ast_fn_line.line, ast_fn_line.offset) if not has_explicit_generic
            emit_ast_inferred_region_params(buffer, tokens, source, ast_fn_line.line, ast_fn_line.offset) if not has_explicit_generic
            emit_tokens_push_sview(buffer, "(")
            emit_tokens_push_u64(buffer, ast_fn_params.count.u64())
            emit_tokens_push_sview(buffer, " params)")
            if emit_ast_is_law_callable(ast_fn_name, enum_annotations):
                emit_tokens_push_sview(buffer, " -> bool")
            else:
                generated_return: bool = emit_ast_generated_typestate_return(buffer, ast_fn_name, ast_fn_return, enum_annotations, tokens, source)
                emit_ast_return_segment(buffer, tokens, source, ast_fn_line.line, ast_fn_line.offset) if not generated_return
            if ast_fn_effects.count > 0:
                emit_tokens_push_sview(buffer, " can[")
                for ast_fn_effect in ast_fn_effects |buffer, ast_fn_effect_index: usize = 0|:
                    emit_tokens_push_sview(buffer, ", ") if ast_fn_effect_index > 0
                    emit_tokens_push_sview(buffer, ast_fn_effect)
                    ast_fn_effect_index <- ast_fn_effect_index + 1
                emit_tokens_push_sview(buffer, "]")
            emit_tokens_push_sview(buffer, " (")
            wrapped_count: u64 = 1 if not auto_region_params_mention_arena(ast_fn_params) and emit_ast_body_declares_container(ast_fn_body, local_annotations, ast_fn_line.line, struct_names, struct_member_rows, struct_member_starts, struct_member_counts) else ast_fn_body.count.u64()
            emit_tokens_push_u64(buffer, wrapped_count)
            emit_tokens_push_sview(buffer, " stmts)\n")
            return
        if declaration is Decl.Struct(ast_st_name, ast_st_members, ast_st_affinity, ast_st_states, ast_st_derive, ast_st_invariants, ast_st_line):
            emit_ast_indent(buffer, level)
            # Stage0 normalizes both affine and linear single-use declarations to the
            # `affine` spelling in its compact AST summary. Legacy typestate sugar also
            # carries a phantom state parameter even though that bracket is not present on
            # the source declaration line, so render its canonical `[state]` header here.
            emit_tokens_push_sview(buffer, "affine ") if ast_st_affinity == "affine" or ast_st_affinity == "linear"
            emit_tokens_push_sview(buffer, "struct ")
            emit_tokens_push_sview(buffer, ast_st_name)
            emit_tokens_push_sview(buffer, "[state]") if ast_st_affinity == "linear" and ast_st_states
            emit_ast_generic_segment(buffer, tokens, source, ast_st_line.line, ast_st_line.offset) if not (ast_st_affinity == "linear" and ast_st_states)
            emit_tokens_push_sview(buffer, " (")
            emit_tokens_push_u64(buffer, ast_st_members.count.u64())
            emit_tokens_push_sview(buffer, " fields)\n")
            return
        # A CONST enum gets a line; a PLAIN enum gets none. Measured against stage0 on a file
        # holding both: it prints `const enum FD of int: (2 members)` for the const one and
        # NOTHING for `enum Plain`, though both count toward the "(N declarations)" header. The
        # storage head comes from the declaration line's tokens — the node keeps the name, not
        # the source spelling.
        if declaration is Decl.Enum(ast_en_name, ast_en_variants, ast_en_const, ast_en_storage, ast_en_line):
            return if not ast_en_const
            emit_ast_indent(buffer, level)
            emit_tokens_push_sview(buffer, "const enum ")
            emit_tokens_push_sview(buffer, ast_en_name)
            emit_tokens_push_sview(buffer, " of ")
            # `storage_type` is an Expr, not a name — a const enum's head is always a scalar
            # type name, so the Ident is the spelling stage0 prints.
            if ast_en_storage is Expr.Ident(ast_en_storage_name, ast_en_storage_line):
                emit_tokens_push_sview(buffer, ast_en_storage_name)
            emit_tokens_push_sview(buffer, ": (")
            emit_tokens_push_u64(buffer, ast_en_variants.count.u64())
            emit_tokens_push_sview(buffer, " members)\n")
            return
        if declaration is Decl.Alias(ast_al_name, ast_al_target, ast_al_line):
            emit_ast_indent(buffer, level)
            emit_tokens_push_sview(buffer, "type ")
            emit_tokens_push_sview(buffer, ast_al_name)
            emit_tokens_push_sview(buffer, " = ")
            emit_ast_alias_target(buffer, tokens, source, ast_al_line.line, ast_al_line.offset)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Import(ast_im_module, ast_im_line):
            emit_ast_indent(buffer, level)
            emit_tokens_push_sview(buffer, "using ")
            emit_tokens_push_sview(buffer, ast_im_module)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Module(ast_mod_name, ast_mod_body, ast_mod_line):
            emit_ast_indent(buffer, level)
            emit_tokens_push_sview(buffer, "module ")
            emit_module_display_name(buffer, ast_mod_name, level)
            emit_tokens_push_sview(buffer, ": (")
            emit_tokens_push_u64(buffer, ast_mod_body.count.u64())
            emit_tokens_push_sview(buffer, " decls)\n")
            for ast_mod_child in ast_mod_body |buffer, level, tokens, source, local_annotations, enum_annotations|:
                emit_ast_decl(buffer, ast_mod_child, level + 1, tokens, source, local_annotations, enum_annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
            return
        if declaration is Decl.Const(ast_c_name, ast_c_type, ast_c_value, ast_c_mutable, ast_c_line):
            # `const NAME = VALUE` / `global [mutable ]NAME: TYPE` — the whole source line in
            # normalized spelling (the gap renderer reproduces stage0's typeStr/exprStr on
            # canonical source), including the annotation past the clipped colon.
            const_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, ast_c_line.line, ast_c_line.offset)
            return if not const_range.found
            const_stop: mutable usize = const_range.stop
            while const_stop < tokens.count and tokens[const_stop].line == ast_c_line.line and tokens[const_stop].kind != Lexer::TokenKind.Newline |const_stop, tokens, ast_c_line|:
                const_stop <- const_stop + 1
            # stage0 renders these STRUCTURALLY rather than echoing the source line, and the two
            # keywords drop OPPOSITE halves — MEASURED:
            #     const J: i64 = 3        ->  const J = 3            (annotation dropped)
            #     global mutable g: i64 = 7  ->  global mutable g: i64  (initializer dropped)
            # Echoing the line matched only the unannotated `const K = 5`, which is why every
            # existing fixture agreed; a `global` with an initializer is what exposed it.
            const_eq: mutable usize = const_stop
            const_eq_found: mutable bool = false
            for eq_probe in const_range.start..<const_stop |const_eq, const_eq_found, tokens|:
                continue if const_eq_found
                if tokens[eq_probe].kind == Lexer::TokenKind.Assign:
                    const_eq <- eq_probe
                    const_eq_found <- true
            emit_ast_indent(buffer, level)
            if tokens[const_range.start].kind == Lexer::TokenKind.Global:
                emit_iface_render_tokens(buffer, tokens, source, const_range.start, const_eq)
                emit_tokens_push_sview(buffer, "\n")
                return
            emit_tokens_push_sview(buffer, "const ")
            emit_tokens_push_sview(buffer, ast_c_name)
            if const_eq_found:
                emit_tokens_push_sview(buffer, " = ")
                emit_ast_const_expr(buffer, ast_c_value, tokens, source)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Extern(ast_ex_name, ast_ex_param_start, ast_ex_arity, ast_ex_variadic, ast_ex_callable, ast_ex_return, ast_ex_decorators, ast_ex_line):
            # `@link_name(sym)` prints on its own line first, exactly as written.
            # Extern variables carry link-name metadata for codegen, but stage0's AST summary
            # prints that metadata only for callable extern declarations.
            if ast_ex_callable:
                for ast_ex_decorator in ast_ex_decorators |buffer, level, tokens, source, ast_ex_line|:
                    emit_ast_indent(buffer, level)
                    emit_tokens_push_sview(buffer, "@")
                    emit_tokens_push_sview(buffer, ast_ex_decorator.name)
                    emit_ast_decorator_args(buffer, tokens, source, ast_ex_decorator.line, 0)
                    emit_tokens_push_sview(buffer, "\n")
            emit_ast_indent(buffer, level)
            export_fn_target: sview = emit_ast_export_fn_target(enum_annotations, ast_ex_name, ast_ex_line.line)
            export_type_alias: sview = emit_ast_export_type_alias(enum_annotations, ast_ex_name, ast_ex_line.line)
            if export_type_alias != "" or emit_ast_export_type_present(enum_annotations, ast_ex_name, ast_ex_line.line):
                emit_tokens_push_sview(buffer, "export type ")
                emit_tokens_push_sview(buffer, ast_ex_name)
                emit_tokens_push_sview(buffer, " as ")
                emit_tokens_push_sview(buffer, ast_ex_name if export_type_alias == "" else export_type_alias)
                emit_tokens_push_sview(buffer, "\n")
                return
            export_global_target: sview = emit_ast_export_global_target(enum_annotations, ast_ex_name, ast_ex_line.line)
            if export_global_target != "":
                emit_tokens_push_sview(buffer, "export global ")
                emit_tokens_push_sview(buffer, export_global_target)
                emit_tokens_push_sview(buffer, " as ")
                emit_tokens_push_sview(buffer, ast_ex_name)
                emit_tokens_push_sview(buffer, "\n")
                return
            if export_fn_target != "":
                emit_tokens_push_sview(buffer, "export func ")
                emit_tokens_push_sview(buffer, ast_ex_name)
                emit_tokens_push_sview(buffer, "(")
                emit_tokens_push_u64(buffer, ast_ex_arity.u64())
                emit_tokens_push_sview(buffer, " params)")
                emit_ast_return_segment(buffer, tokens, source, ast_ex_line.line, ast_ex_line.offset)
                emit_tokens_push_sview(buffer, " = ")
                emit_tokens_push_sview(buffer, export_fn_target)
                emit_tokens_push_sview(buffer, "\n")
                return
            if not ast_ex_callable:
                # A typed global is a value declaration, not an opaque type. Decl.Extern keeps
                # only the type head for compact semantic metadata, so recover the complete type
                # from the source tokens after the depth-0 colon.
                extern_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, ast_ex_line.line, ast_ex_line.offset)
                if ast_ex_return != "" and extern_range.found and extern_range.stop < tokens.count and tokens[extern_range.stop].kind == Lexer::TokenKind.Colon:
                    emit_tokens_push_sview(buffer, "extern ")
                    emit_tokens_push_sview(buffer, ast_ex_name)
                    emit_tokens_push_sview(buffer, ": ")
                    extern_type_stop: usize = emit_ast_line_end(tokens, ast_ex_line.line, extern_range.stop + 1)
                    emit_ast_render_tokens(buffer, tokens, source, extern_range.stop + 1, extern_type_stop)
                    emit_tokens_push_sview(buffer, "\n")
                    return
                # A bare `extern TypeName` is an opaque TYPE declaration.
                emit_tokens_push_sview(buffer, "extern type ")
                emit_tokens_push_sview(buffer, ast_ex_name)
                emit_tokens_push_sview(buffer, "\n")
                return
            emit_tokens_push_sview(buffer, "extern ")
            emit_tokens_push_sview(buffer, ast_ex_name)
            emit_tokens_push_sview(buffer, "(")
            emit_tokens_push_u64(buffer, ast_ex_arity.u64())
            emit_tokens_push_sview(buffer, " params)")
            emit_ast_return_segment(buffer, tokens, source, ast_ex_line.line, ast_ex_line.offset)
            emit_tokens_push_sview(buffer, "\n")
            return
        # Enum: stage0's printer has no EnumDecl case — counted in the header, no line.
        # Law/Scoped/Invalid likewise print nothing at this summary level.
        return




# Stage1 stores each declaration-level `static if` branch as a separate Scoped node, while
# stage0's AST has one StaticIfDecl for the whole chain. The summary printer must reconstruct
# that presentation without changing the compiler's internal representation used by codegen.
def emit_ast_static_branch_kind(declaration: Ast::Decl, tokens: darray[Lexer::Token]&) -> i64 can[Abort.Panic, Memory.Allocate]:
    if declaration is Decl.Scoped(static_branch_body, static_branch_line):
        line_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, static_branch_line.line, static_branch_line.offset)
        0 return if not line_range.found or line_range.start + 1 >= tokens.count
        0 return if tokens[line_range.start].kind != Lexer::TokenKind.Static
        second_kind: Lexer::TokenKind = tokens[line_range.start + 1].kind
        2 return if second_kind == Lexer::TokenKind.Elif
        3 return if second_kind == Lexer::TokenKind.Else
        1 return if second_kind == Lexer::TokenKind.If
    return 0




def emit_ast_static_condition(file: Ast::File&, branch_line: u32) -> Ast::Expr:
    for condition_index in 0..<file.static_if_lines.count |file|:
        return file.static_if_conds[condition_index] if file.static_if_lines[condition_index] == branch_line and file.static_if_kinds[condition_index] != 2
    return (Ast::Expr.Invalid)




def emit_ast_static_scope(buffer: mutable darray[u8]&, declaration: Ast::Decl, file: Ast::File&, tokens: darray[Lexer::Token]&, source: u8&, elif_count: i64, local_annotations: darray[Ast::LocalRegionAnnotation]&, enum_annotations: darray[Ast::EnumAnnotation]&, struct_names: darray[sview]&, struct_member_rows: darray[Ast::StructMember]&, struct_member_starts: darray[usize]&, struct_member_counts: darray[usize]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    match declaration:
        Decl.Scoped(static_body, static_line):
            emit_tokens_push_sview(buffer, "static if ")
            static_condition: Ast::Expr = emit_ast_static_condition(file, static_line.line)
            FmtUnparse::fmt_expr(buffer, static_condition, tokens, source)
            emit_tokens_push_sview(buffer, ": (")
            emit_tokens_push_u64(buffer, static_body.count.u64())
            emit_tokens_push_sview(buffer, " then, ")
            emit_tokens_push_u64(buffer, elif_count.u64())
            emit_tokens_push_sview(buffer, " elifs)\n")
            for static_child in static_body |buffer, tokens, source, local_annotations, enum_annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts|:
                emit_ast_decl(buffer, static_child, 1, tokens, source, local_annotations, enum_annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
        _:
            pass




def emit_ast_hidden_law_count(declarations: darray[Ast::Decl]) -> u64:
    # Stage1 keeps Law for semantic lookup and appends its callable Func to the file's
    # declaration list. Stage0's AST exposes only that Func. Count the source Law out of
    # the summary when its synthesized callable is present; do not hide effect/frame laws
    # that have no callable counterpart.
    hidden: mutable u64 = 0
    for declaration in declarations |hidden, declarations|:
        match declaration:
            Decl.Law(law_name, law_predicate, law_line):
                for candidate in declarations |hidden, law_name, law_line|:
                    match candidate:
                        Decl.Func(function_name, function_params, function_return, function_body, function_effects, function_decorators, function_line):
                            hidden <- hidden + 1 if function_name == law_name and function_line.line == law_line.line
                        _:
                            pass
            _:
                pass
    return hidden




def emit_ast_report(file: Ast::File&, tokens: darray[Lexer::Token]&, source: u8&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    buffer: mutable darray[u8] = []
    # `using X as Y` lives only in the annotation side tables (__using_alias_target rows
    # carry the TARGET module, which is what stage0 prints); it is a real declaration in
    # stage0's stream, so it joins the count and prints in line order among the decls.
    alias_targets: mutable darray[sview] = []
    alias_lines: mutable darray[u32] = []
    for using_annotation in file.enum_annotations |alias_targets, alias_lines, file|:
        if using_annotation.name == "__using_alias_target":
            alias_targets.push(using_annotation.owner)
            alias_lines.push(using_annotation.line)
        elif using_annotation.name == "__using":
            # An ALIASED using records both rows on nearby lines; only the bare form
            # contributes its own declaration. Skip a __using whose module already has an
            # alias-target row.
            using_is_aliased: mutable bool = false
            for alias_probe in file.enum_annotations |using_is_aliased, using_annotation|:
                using_is_aliased <- true if alias_probe.name == "__using_alias_target" and alias_probe.owner == using_annotation.owner
            if not using_is_aliased:
                alias_targets.push(using_annotation.owner)
                alias_lines.push(using_annotation.line)
    static_branch_count: mutable u64 = 0
    static_chain_count: mutable u64 = 0
    for static_count_declaration in file.top_decls |static_branch_count, static_chain_count, tokens|:
        static_kind: i64 = emit_ast_static_branch_kind(static_count_declaration, tokens)
        static_branch_count <- static_branch_count + 1 if static_kind > 0
        static_chain_count <- static_chain_count + 1 if static_kind == 1
    effective_decl_count: u64 = file.top_decls.count.u64() - static_branch_count + static_chain_count - emit_ast_hidden_law_count(file.top_decls)
    emit_tokens_push_sview(buffer, "File: ")
    emit_tokens_push_source_name(buffer)
    emit_tokens_push_sview(buffer, " (")
    emit_tokens_push_u64(buffer, effective_decl_count + alias_targets.count.u64())
    emit_tokens_push_sview(buffer, " declarations)\n")
    for ast_decl_index in 0..<file.top_decls.count |buffer, tokens, source, alias_targets, alias_lines, file|:
        ast_declaration: Ast::Decl = file.top_decls[ast_decl_index]
        decl_line: u32 = ast_decl_line(ast_declaration)
        for alias_index in 0..<alias_targets.count |buffer, alias_targets, alias_lines, decl_line|:
            if alias_lines[alias_index] != 0 and alias_lines[alias_index] < decl_line:
                emit_tokens_push_sview(buffer, "using ")
                emit_tokens_push_sview(buffer, alias_targets[alias_index])
                emit_tokens_push_sview(buffer, "\n")
                alias_lines[alias_index] <- 0
        static_kind: i64 = emit_ast_static_branch_kind(ast_declaration, tokens)
        if static_kind == 1:
            elif_count: mutable i64 = 0
            scan_index: mutable usize = ast_decl_index + 1
            while scan_index < file.top_decls.count:
                continuation_kind: i64 = emit_ast_static_branch_kind(file.top_decls[scan_index], tokens)
                break if continuation_kind == 0 or continuation_kind == 1
                elif_count <- elif_count + 1 if continuation_kind == 2
                scan_index <- scan_index + 1
            emit_ast_static_scope(buffer, ast_declaration, file, tokens, source, elif_count, file.local_region_annotations, file.enum_annotations, file.struct_names, file.struct_member_rows, file.struct_member_starts, file.struct_member_counts)
        elif static_kind == 0:
            emit_ast_decl(buffer, ast_declaration, 0, tokens, source, file.local_region_annotations, file.enum_annotations, file.struct_names, file.struct_member_rows, file.struct_member_starts, file.struct_member_counts)
    for alias_tail in 0..<alias_targets.count |buffer, alias_targets, alias_lines|:
        if alias_lines[alias_tail] != 0:
            emit_tokens_push_sview(buffer, "using ")
            emit_tokens_push_sview(buffer, alias_targets[alias_tail])
            emit_tokens_push_sview(buffer, "\n")
    return 0 if buffer.count == 0 else emit_tokens_flush(buffer)
