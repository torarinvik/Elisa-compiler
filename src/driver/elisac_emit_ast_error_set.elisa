# Stage0 expands grouped error members into dotted entries in AST summaries.
def emit_ast_error_member(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, start: usize, stop: usize, already_emitted: bool) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    emitted: mutable bool = already_emitted
    group: mutable usize = stop
    for index in start..<stop |group, tokens|:
        group <- index if group == stop and tokens[index].kind == Lexer::TokenKind.LBrace
    if group == stop or stop <= group + 1 or tokens[stop - 1].kind != Lexer::TokenKind.RBrace:
        emit_tokens_push_sview(buffer, ", ") if emitted
        emit_ast_render_tokens(buffer, tokens, source, start, stop)
        return true
    member_start: mutable usize = group + 1
    for index in (group + 1)..<stop |member_start, emitted, buffer, tokens, source, start, group, stop|:
        if tokens[index].kind == Lexer::TokenKind.Comma or index == stop - 1:
            if member_start < index:
                emit_tokens_push_sview(buffer, ", ") if emitted
                emit_ast_render_tokens(buffer, tokens, source, start, group)
                emit_tokens_push_sview(buffer, ".")
                emit_ast_render_tokens(buffer, tokens, source, member_start, index)
                emitted <- true
            member_start <- index + 1
    return emitted

def emit_ast_error_tokens(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, start: usize, stop: usize) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    part_start: mutable usize = start
    depth: mutable i64 = 0
    emitted: mutable bool = false
    for index in start..<(stop + 1) |part_start, depth, emitted, buffer, tokens, source, stop|:
        if index == stop or (depth == 0 and tokens[index].kind == Lexer::TokenKind.Comma):
            emitted <- emit_ast_error_member(buffer, tokens, source, part_start, index, emitted)
            part_start <- index + 1
        else:
            depth <- depth + 1 if tokens[index].kind == Lexer::TokenKind.LBrace or tokens[index].kind == Lexer::TokenKind.LBracket or tokens[index].kind == Lexer::TokenKind.LParen
            depth <- depth - 1 if tokens[index].kind == Lexer::TokenKind.RBrace or tokens[index].kind == Lexer::TokenKind.RBracket or tokens[index].kind == Lexer::TokenKind.RParen

def emit_ast_return_tokens(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, start: usize, stop: usize) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    error_index: mutable usize = stop
    for index in start..<stop |error_index, tokens|:
        error_index <- index if error_index == stop and tokens[index].kind == Lexer::TokenKind.Error and index + 1 < stop and tokens[index + 1].kind == Lexer::TokenKind.LBracket
    if error_index == stop:
        emit_ast_render_tokens(buffer, tokens, source, start, stop)
        return
    close: mutable usize = error_index + 2
    depth: mutable i64 = 1
    while close < stop and depth > 0 |close, depth, tokens|:
        depth <- depth + 1 if tokens[close].kind == Lexer::TokenKind.LBracket
        depth <- depth - 1 if tokens[close].kind == Lexer::TokenKind.RBracket
        close <- close + 1
    if depth != 0:
        emit_ast_render_tokens(buffer, tokens, source, start, stop)
        return
    emit_ast_render_tokens(buffer, tokens, source, start, error_index)
    emit_tokens_push_sview(buffer, " error[")
    emit_ast_error_tokens(buffer, tokens, source, error_index + 2, close - 1)
    emit_tokens_push_sview(buffer, "]")
    emit_ast_render_tokens(buffer, tokens, source, close, stop)
