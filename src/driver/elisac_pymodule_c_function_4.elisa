# `-emit pymodule` — one exported function's C wrapper, stage 4 of 5: the CALL itself, the return
# arena, and the error check that follows it. Continues elisac_pymodule_c_function_3.elisa.

def emit_pymodule_c_function_4(buffer: mutable darray[u8]&, file: mutable Ast::File&, module_name: sview, annotation: Ast::EnumAnnotation) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    return if annotation.name != "__pymodule_fn"
    target_name: mutable sview = ""
    for target_annotation in file.enum_annotations |target_name, annotation|:
        target_name <- target_annotation.owner if target_annotation.name == "__pymodule_target_ref" and target_annotation.line == annotation.line
    target_decl: Ast::Decl? = pymodule_find_function_in(file.top_decls, target_name)
    if target_decl is target_function:
        if target_function is Decl.Func(target_function_name, source_params, target_return, target_body, target_effects, target_decorators, target_pos):
            target_params: mutable darray[Ast::ParamDecl] = pymodule_alias_normalize_params(file, source_params)
            return_type_name: mutable sview = "void"
            if target_return is declared_return:
                return_type_name <- pymodule_alias_type_name(file, declared_return)
            is_error: bool = pymodule_function_is_error(file, target_name)
            error_family: sview = pymodule_function_error_family(file, target_name) if is_error else ""
            has_payload_error: bool = is_error and pymodule_error_set_has_payload_in(file.top_decls, error_family)
            payload_type_name: sview = pymodule_error_payload_type_in(file, file.top_decls, error_family) if has_payload_error else ""
            structured_payload_error: bool = has_payload_error and pymodule_error_payload_is_structured_in(file.top_decls, error_family)
            has_payload_arena: bool = has_payload_error and pymodule_error_payload_needs_arena_in(file, file.top_decls, error_family)
            has_payload_struct: bool = has_payload_error and (pymodule_struct_return_supported(file, payload_type_name) if not structured_payload_error else pymodule_error_payload_contains_struct_in(file, file.top_decls, error_family))
            has_darray_param: mutable bool = false
            for darray_probe in target_params |has_darray_param|:
                has_darray_param <- true if pymodule_is_darray_type(pymodule_alias_type_name(file, darray_probe.type_expression))
            has_darray_ref_param: mutable bool = false
            for darray_ref_probe in target_params |has_darray_ref_param|:
                darray_ref_type_name: sview = pymodule_alias_type_name(file, darray_ref_probe.type_expression)
                has_darray_ref_param <- true if pymodule_darray_ref_parameter(darray_ref_type_name, darray_ref_probe.type_expression)
            has_struct_darray_param: mutable bool = false
            for struct_darray_probe in target_params |has_struct_darray_param|:
                struct_darray_type_name: sview = pymodule_alias_type_name(file, struct_darray_probe.type_expression)
                # Direct struct inputs also own a temporary arena/reference table.  Treat
                # them like aggregate sequence inputs so scalar-return wrappers cannot take
                # the expression fast path and leak that storage after a successful call.
                if pymodule_struct_input_supported(file, struct_darray_type_name):
                    has_struct_darray_param <- true
                elif pymodule_is_darray_type(struct_darray_type_name) or pymodule_is_view_type(struct_darray_type_name):
                    struct_darray_element_name: sview = pymodule_darray_element_name(struct_darray_type_name) if pymodule_is_darray_type(struct_darray_type_name) else pymodule_view_element_name(struct_darray_type_name)
                    has_struct_darray_param <- true if pymodule_struct_input_supported(file, struct_darray_element_name)
            has_dict_param: mutable bool = false
            for dict_probe in target_params |has_dict_param|:
                has_dict_param <- true if pymodule_is_dict_type(pymodule_alias_type_name(file, dict_probe.type_expression))
            has_set_param: mutable bool = false
            for set_probe in target_params |has_set_param|:
                has_set_param <- true if pymodule_is_set_type(pymodule_alias_type_name(file, set_probe.type_expression))
            has_view_param: mutable bool = false
            for view_probe in target_params |has_view_param|:
                has_view_param <- true if pymodule_is_view_type(pymodule_alias_type_name(file, view_probe.type_expression))
            has_dict_return: bool = pymodule_is_dict_type(return_type_name)
            has_set_return: bool = pymodule_is_set_type(return_type_name)
            has_view_return: bool = pymodule_is_view_type(return_type_name)
            has_optional_return: bool = pymodule_is_optional_scalar_type(return_type_name)
            has_struct_return: bool = pymodule_struct_return_supported(file, return_type_name)
            has_fixed_array_return: bool = pymodule_fixed_array_return_supported(return_type_name)
            has_output_arena: bool = pymodule_is_darray_type(return_type_name) or has_dict_return or has_set_return or (has_struct_return and pymodule_struct_return_contains_darray(file, return_type_name)) or has_payload_arena
            has_return_arena: bool = has_output_arena or has_darray_ref_param
            for parameter_index in 0..<target_params.count |buffer, target_params|:
                emit_pymodule_argument_context(buffer, annotation.owner, target_params[parameter_index].name, pymodule_alias_type_name(file, target_params[parameter_index].type_expression), "    ")
                parameter_type_name: sview = pymodule_alias_type_name(file, target_params[parameter_index].type_expression)
                if pymodule_is_set_type(parameter_type_name):
                    set_input_snippet: mutable darray[u8] = []
                    emit_pymodule_set_input_setup(&set_input_snippet, target_params, parameter_type_name, parameter_index)
                    pymodule_contextualize_generated_returns(&set_input_snippet, annotation.owner, target_params[parameter_index].name)
                    for set_input_byte_index in 0..<set_input_snippet.count |buffer, set_input_snippet|:
                        buffer.push(set_input_snippet[set_input_byte_index])
            # Materialize dictionary inputs after the other Python conversions. That keeps
            # every earlier conversion failure on a path with no live dictionary arena; once
            # a dictionary is live, its own setup helpers release all prior dictionaries.
            for parameter_index in 0..<target_params.count |buffer, target_params|:
                emit_pymodule_argument_context(buffer, annotation.owner, target_params[parameter_index].name, pymodule_alias_type_name(file, target_params[parameter_index].type_expression), "    ")
                parameter_type_name: sview = pymodule_alias_type_name(file, target_params[parameter_index].type_expression)
                if pymodule_is_dict_type(parameter_type_name):
                    dict_value_type: sview = pymodule_dict_value_name(parameter_type_name)
                    dict_helper_storage: mutable darray[u8] = []
                    if pymodule_is_dict_type(dict_value_type) or pymodule_is_set_type(dict_value_type) or (pymodule_is_darray_type(dict_value_type) and pymodule_is_set_type(pymodule_darray_element_name(dict_value_type))) or (pymodule_is_darray_type(dict_value_type) and pymodule_is_dict_type(pymodule_darray_element_name(dict_value_type))) or (pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) == 1.usize() and pymodule_struct_input_supported(file, pymodule_darray_element_name(dict_value_type))) or (pymodule_is_view_type(dict_value_type) and pymodule_darray_c_element_type(pymodule_view_element_name(dict_value_type)) == "" and pymodule_struct_input_supported(file, pymodule_view_element_name(dict_value_type))) or (pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) >= 2.usize() and pymodule_top_level_nested_darray_input_supported(file, dict_value_type)):
                        emit_tokens_push_sview(&dict_helper_storage, "elisa_pymodule_")
                        emit_tokens_push_sview(&dict_helper_storage, module_name)
                        emit_tokens_push_sview(&dict_helper_storage, "_")
                        emit_tokens_push_sview(&dict_helper_storage, annotation.owner)
                        emit_tokens_push_sview(&dict_helper_storage, "_dict_")
                        append_decimal(&dict_helper_storage, parameter_index.i64())
                        emit_tokens_push_sview(&dict_helper_storage, "_from_py")
                    dict_helper_name: sview = sview(&dict_helper_storage[0], 0, dict_helper_storage.count) if dict_helper_storage.count > 0 else ""
                    dict_input_snippet: mutable darray[u8] = []
                    emit_pymodule_dict_input_setup(&dict_input_snippet, target_params, parameter_type_name, parameter_index, dict_helper_name)
                    pymodule_contextualize_generated_returns(&dict_input_snippet, annotation.owner, target_params[parameter_index].name)
                    for dict_input_byte_index in 0..<dict_input_snippet.count |buffer, dict_input_snippet|:
                        buffer.push(dict_input_snippet[dict_input_byte_index])
            if has_return_arena:
                emit_tokens_push_sview(buffer, "    ElisaArena arena = {0};\n    arena.strategy = 0;\n")
            if has_payload_error:
                emit_tokens_push_sview(buffer, "    ")
                if structured_payload_error:
                    emit_tokens_push_sview(buffer, "ElisaPymoduleErrorPayload_")
                    emit_tokens_push_sview(buffer, error_family)
                else:
                    payload_c_type: mutable sview = pymodule_c_type_name(payload_type_name)
                    payload_c_type <- payload_type_name if payload_c_type == "" and pymodule_struct_return_supported(file, payload_type_name)
                    emit_tokens_push_sview(buffer, payload_c_type)
                emit_tokens_push_sview(buffer, " native_payload = {0};\n")
            emit_tokens_push_sview(buffer, "    elisa_pymodule_current_path_clear(); elisa_pymodule_current_function = NULL; elisa_pymodule_current_parameter = NULL; elisa_pymodule_current_expected = NULL;\n    ")
            if return_type_name == "void":
                # Payload-bearing error targets still write their source return slot on
                # both success and failure. Keep that slot addressable even when the
                # Elisa function's public return type is void; fieldless void errors
                # retain the historical NULL convention.
                if is_error and has_payload_error:
                    emit_tokens_push_sview(buffer, "int64_t native_result = 0;\n    int32_t native_status = elisa_pymodule_")
                else:
                    emit_tokens_push_sview(buffer, "int32_t native_status = elisa_pymodule_" if is_error else "elisa_pymodule_")
                emit_tokens_push_sview(buffer, module_name)
                emit_tokens_push_sview(buffer, "_")
                emit_tokens_push_sview(buffer, annotation.owner)
                emit_tokens_push_sview(buffer, "(&native_result" if is_error and has_payload_error else "(NULL" if is_error else "(")
                emit_tokens_push_sview(buffer, ", &native_payload") if has_payload_error
            elif return_type_name == "py::Object" or return_type_name == "py::Object?":
                emit_tokens_push_sview(buffer, "PyObject *result = NULL;\n    int32_t native_status = elisa_pymodule_" if is_error else "PyObject *result = elisa_pymodule_")
                emit_tokens_push_sview(buffer, module_name)
                emit_tokens_push_sview(buffer, "_")
                emit_tokens_push_sview(buffer, annotation.owner)
                emit_tokens_push_sview(buffer, "(&result" if is_error else "(")
                emit_tokens_push_sview(buffer, ", &native_payload") if has_payload_error
            elif return_type_name == "cstr" or return_type_name == "cstr?":
                emit_tokens_push_sview(buffer, "const char *result = NULL;\n    int32_t native_status = elisa_pymodule_" if is_error else "const char *result = elisa_pymodule_")
                emit_tokens_push_sview(buffer, module_name)
                emit_tokens_push_sview(buffer, "_")
                emit_tokens_push_sview(buffer, annotation.owner)
                emit_tokens_push_sview(buffer, "(&result" if is_error else "(")
                emit_tokens_push_sview(buffer, ", &native_payload") if has_payload_error
            elif return_type_name == "sview":
                emit_tokens_push_sview(buffer, "ElisaSView result = {0};\n    int32_t native_status = elisa_pymodule_" if is_error else "ElisaSView result = elisa_pymodule_")
                emit_tokens_push_sview(buffer, module_name)
                emit_tokens_push_sview(buffer, "_")
                emit_tokens_push_sview(buffer, annotation.owner)
                emit_tokens_push_sview(buffer, "(&result" if is_error else "(")
                emit_tokens_push_sview(buffer, ", &native_payload") if has_payload_error
            elif has_view_return:
                emit_tokens_push_sview(buffer, "ElisaView result = {0};\n    int32_t native_status = elisa_pymodule_" if is_error else "ElisaView result = elisa_pymodule_")
                emit_tokens_push_sview(buffer, module_name)
                emit_tokens_push_sview(buffer, "_")
                emit_tokens_push_sview(buffer, annotation.owner)
                emit_tokens_push_sview(buffer, "(&result" if is_error else "(")
                emit_tokens_push_sview(buffer, ", &native_payload") if has_payload_error
            elif pymodule_is_darray_type(return_type_name):
                emit_tokens_push_sview(buffer, "ElisaDArray result = {0};\n    int32_t native_status = elisa_pymodule_" if is_error else "ElisaDArray result = {0};\n    elisa_pymodule_")
                emit_tokens_push_sview(buffer, module_name)
                emit_tokens_push_sview(buffer, "_")
                emit_tokens_push_sview(buffer, annotation.owner)
                emit_tokens_push_sview(buffer, "(&result")
                emit_tokens_push_sview(buffer, ", &native_payload") if has_payload_error
            elif has_dict_return:
                emit_tokens_push_sview(buffer, "ElisaDict result = {0};\n    int32_t native_status = elisa_pymodule_" if is_error else "ElisaDict result = {0};\n    elisa_pymodule_")
                emit_tokens_push_sview(buffer, module_name)
                emit_tokens_push_sview(buffer, "_")
                emit_tokens_push_sview(buffer, annotation.owner)
                emit_tokens_push_sview(buffer, "(&result")
                emit_tokens_push_sview(buffer, ", &native_payload") if has_payload_error
            elif has_set_return:
                emit_tokens_push_sview(buffer, "ElisaSet result = {0};\n    int32_t native_status = elisa_pymodule_" if is_error else "ElisaSet result = {0};\n    elisa_pymodule_")
                emit_tokens_push_sview(buffer, module_name)
                emit_tokens_push_sview(buffer, "_")
                emit_tokens_push_sview(buffer, annotation.owner)
                emit_tokens_push_sview(buffer, "(&result")
                emit_tokens_push_sview(buffer, ", &native_payload") if has_payload_error
            elif pymodule_is_optional_scalar_type(return_type_name):
                if is_error:
                    emit_tokens_push_sview(buffer, pymodule_c_type_name(return_type_name))
                    emit_tokens_push_sview(buffer, " native_result = {0};\n    int32_t native_status = elisa_pymodule_")
                else:
                    emit_tokens_push_sview(buffer, pymodule_c_type_name(return_type_name))
                    emit_tokens_push_sview(buffer, " result = {0};\n    elisa_pymodule_")
                emit_tokens_push_sview(buffer, module_name)
                emit_tokens_push_sview(buffer, "_")
                emit_tokens_push_sview(buffer, annotation.owner)
                emit_tokens_push_sview(buffer, "(&native_result" if is_error else "(&result")
                emit_tokens_push_sview(buffer, ", &native_payload") if has_payload_error
            elif has_fixed_array_return:
                fixed_result_element_c_type: sview = pymodule_darray_c_element_type(pymodule_fixed_array_element_name(return_type_name))
                emit_tokens_push_sview(buffer, fixed_result_element_c_type)
                emit_tokens_push_sview(buffer, " fixed_result_items[")
                append_decimal(buffer, pymodule_fixed_array_extent(return_type_name))
                emit_tokens_push_sview(buffer, "];\n    elisa_pymodule_")
                emit_tokens_push_sview(buffer, module_name)
                emit_tokens_push_sview(buffer, "_")
                emit_tokens_push_sview(buffer, annotation.owner)
                emit_tokens_push_sview(buffer, "(fixed_result_items")
            elif pymodule_struct_return_supported(file, return_type_name):
                emit_tokens_push_sview(buffer, return_type_name)
                emit_tokens_push_sview(buffer, " result = {0};\n    elisa_pymodule_")
                emit_tokens_push_sview(buffer, module_name)
                emit_tokens_push_sview(buffer, "_")
                emit_tokens_push_sview(buffer, annotation.owner)
                emit_tokens_push_sview(buffer, "(&result")
            else:
                if is_error:
                    emit_tokens_push_sview(buffer, pymodule_c_type_name(return_type_name))
                    emit_tokens_push_sview(buffer, " native_result = 0;\n    int32_t native_status = elisa_pymodule_")
                elif has_darray_param or has_struct_darray_param or has_dict_param or has_set_param or has_view_param:
                    emit_tokens_push_sview(buffer, pymodule_c_type_name(return_type_name))
                    emit_tokens_push_sview(buffer, " native_result = elisa_pymodule_")
                else:
                    emit_tokens_push_sview(buffer, "return ")
                    # Return helpers need the call as an expression, so scalar return values
                    # are emitted directly below and void is handled as a statement.
                    if return_type_name == "bool":
                        emit_tokens_push_sview(buffer, "PyBool_FromLong(elisa_pymodule_")
                    elif return_type_name == "f32" or return_type_name == "f64":
                        emit_tokens_push_sview(buffer, "PyFloat_FromDouble((double)elisa_pymodule_")
                    elif return_type_name == "u8" or return_type_name == "u16" or return_type_name == "u32" or return_type_name == "u64" or return_type_name == "usize" or return_type_name == "uintptr":
                        emit_tokens_push_sview(buffer, "PyLong_FromUnsignedLongLong((unsigned long long)elisa_pymodule_")
                    else:
                        emit_tokens_push_sview(buffer, "PyLong_FromLongLong((long long)elisa_pymodule_")
                emit_tokens_push_sview(buffer, module_name)
                emit_tokens_push_sview(buffer, "_")
                emit_tokens_push_sview(buffer, annotation.owner)
                emit_tokens_push_sview(buffer, "(&native_result" if is_error else "(")
                emit_tokens_push_sview(buffer, ", &native_payload") if has_payload_error
            emit_pymodule_c_function_5(buffer, file, module_name, annotation)
