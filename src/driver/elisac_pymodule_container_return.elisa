# `-emit pymodule` — returning the other containers: sets, views, and the struct fields that
# carry a dict or a set (whose arena cleanup is redirected into the enclosing record's).


# Reuse the dict return copier inside a struct field block. Its arena cleanup is redirected to a
# zero local arena because the enclosing wrapper owns the native return arena until the whole
# struct has been copied.
def emit_pymodule_struct_dict_field_c_to_py(buffer: mutable darray[u8]&, field_type_name: sview, field_name: sview, python_field_name: sview, nested_value_helper: sview = "") -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    snippet: mutable darray[u8] = []
    empty_params: darray[Ast::ParamDecl] = []
    emit_tokens_push_sview(buffer, "ElisaDict result = value.")
    emit_tokens_push_sview(buffer, field_name)
    emit_tokens_push_sview(buffer, "; ElisaArena arena = {0};\n")
    emit_pymodule_dict_return_conversion(&snippet, empty_params, field_type_name, true, nested_value_helper)
    done_label: mutable darray[u8] = []
    emit_tokens_push_sview(&done_label, "elisa_pymodule_dict_field_done_")
    emit_tokens_push_sview(&done_label, field_name)
    done_label_view: sview = sview(&done_label[0], 0, done_label.count)
    replacement: mutable darray[u8] = []
    emit_tokens_push_sview(&replacement, "field_value = out; goto ")
    emit_tokens_push_sview(&replacement, done_label_view)
    emit_tokens_push_sview(&replacement, ";")
    replacement_view: sview = sview(&replacement[0], 0, replacement.count)
    pymodule_replace_generated(&snippet, "return out;", replacement_view)
    # The normal dictionary copier owns a local `out` mapping.  A struct
    # conversion already has an outer `out` mapping for the whole record, so
    # give the nested copier its own name before splicing it into that scope.
    pymodule_replace_generated_local(&snippet, "out", "field_out")
    for snippet_index in 0..<snippet.count |buffer, snippet|:
        buffer.push(snippet[snippet_index])
    emit_tokens_push_sview(buffer, "\n")
    emit_tokens_push_sview(buffer, done_label_view)
    emit_tokens_push_sview(buffer, ":; ")




def emit_pymodule_struct_set_field_c_to_py(buffer: mutable darray[u8]&, field_type_name: sview, field_name: sview, python_field_name: sview) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    snippet: mutable darray[u8] = []
    empty_params: darray[Ast::ParamDecl] = []
    emit_tokens_push_sview(buffer, "ElisaSet result = value.")
    emit_tokens_push_sview(buffer, field_name)
    emit_tokens_push_sview(buffer, "; ElisaArena arena = {0};\n")
    emit_pymodule_set_return_conversion(&snippet, empty_params, field_type_name, true)
    done_label: mutable darray[u8] = []
    emit_tokens_push_sview(&done_label, "elisa_pymodule_set_field_done_")
    emit_tokens_push_sview(&done_label, field_name)
    done_label_view: sview = sview(&done_label[0], 0, done_label.count)
    replacement: mutable darray[u8] = []
    emit_tokens_push_sview(&replacement, "field_value = out; goto ")
    emit_tokens_push_sview(&replacement, done_label_view)
    emit_tokens_push_sview(&replacement, ";")
    replacement_view: sview = sview(&replacement[0], 0, replacement.count)
    pymodule_replace_generated(&snippet, "return out;", replacement_view)
    pymodule_replace_generated_local(&snippet, "out", "field_out")
    for snippet_index in 0..<snippet.count |buffer, snippet|:
        buffer.push(snippet[snippet_index])
    emit_tokens_push_sview(buffer, "\n")
    emit_tokens_push_sview(buffer, done_label_view)
    emit_tokens_push_sview(buffer, ":; ")




def emit_pymodule_set_return_conversion(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, type_name: sview, is_error: bool) -> void can[Abort.Panic, Memory.Allocate]:
    element_name: sview = pymodule_set_element_name(type_name)
    element_c_type: sview = pymodule_darray_c_element_type(element_name)
    emit_tokens_push_sview(buffer, ");\n") if not is_error
    emit_tokens_push_sview(buffer, "    if (result.count < 0 || result.used < 0 || result.capacity < 0 || result.count > result.used || result.used > result.capacity || result.count > PY_SSIZE_T_MAX || result.capacity > PY_SSIZE_T_MAX) {\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native Elisa function returned an invalid set header\"); return NULL;\n    }\n    PyObject *out = PySet_New(NULL);\n    if (out == NULL) {\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena); return NULL;\n    }\n    if (result.count == 0) {\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena); return out;\n    }\n    if (result.items == NULL || result.capacity == 0) {\n        Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native Elisa function returned null set storage\"); return NULL;\n    }\n    typedef struct { ")
    emit_tokens_push_sview(buffer, element_c_type)
    emit_tokens_push_sview(buffer, " key; uint8_t state; } ElisaPymoduleSetResultBucket;\n    int64_t result_seen = 0;\n    for (int64_t result_index = 0; result_index < result.capacity; ++result_index) {\n        ElisaPymoduleSetResultBucket *bucket = &((ElisaPymoduleSetResultBucket *)result.items)[result_index];\n        if (bucket->state != 1) continue;\n        PyObject *result_item = NULL;\n")
    if element_name == "cstr":
        emit_tokens_push_sview(buffer, "        if (bucket->key == NULL) { Py_DECREF(out);\n")
        emit_pymodule_darray_cleanup(buffer, target_params, "            ")
        emit_pymodule_dict_cleanup(buffer, target_params, "            ")
        emit_tokens_push_sview(buffer, "            arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native set returned a null cstr element\"); return NULL; }\n        result_item = PyUnicode_FromString(bucket->key);\n")
    elif element_name == "sview":
        emit_tokens_push_sview(buffer, "        ElisaSView result_view = bucket->key; if (result_view.len < 0 || result_view.len > PY_SSIZE_T_MAX || (result_view.data == NULL && result_view.len != 0)) { Py_DECREF(out);\n")
        emit_pymodule_darray_cleanup(buffer, target_params, "            ")
        emit_pymodule_dict_cleanup(buffer, target_params, "            ")
        emit_tokens_push_sview(buffer, "            arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native set returned an invalid sview element\"); return NULL; } if (result_view.data == NULL) result_item = PyUnicode_FromString(\"\"); else result_item = PyUnicode_DecodeUTF8(result_view.data, (Py_ssize_t)result_view.len, \"strict\");\n")
    elif element_name == "bool":
        emit_tokens_push_sview(buffer, "        result_item = PyBool_FromLong((long)bucket->key);\n")
    elif pymodule_darray_element_is_unsigned(element_name):
        emit_tokens_push_sview(buffer, "        result_item = PyLong_FromUnsignedLongLong((unsigned long long)bucket->key);\n")
    else:
        emit_tokens_push_sview(buffer, "        result_item = PyLong_FromLongLong((long long)bucket->key);\n")
    emit_tokens_push_sview(buffer, "        if (result_item == NULL) { Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "            ")
    emit_pymodule_dict_cleanup(buffer, target_params, "            ")
    emit_tokens_push_sview(buffer, "            arena_free(&arena); return NULL; }\n        if (PySet_Add(out, result_item) < 0) { Py_DECREF(result_item); Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "            ")
    emit_pymodule_dict_cleanup(buffer, target_params, "            ")
    emit_tokens_push_sview(buffer, "            arena_free(&arena); return NULL; }\n        Py_DECREF(result_item); result_seen++;\n    }\n    if (result_seen != result.count) { Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native set count does not match occupied buckets\"); return NULL;\n    }\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "    ")
    emit_pymodule_dict_cleanup(buffer, target_params, "    ")
    emit_tokens_push_sview(buffer, "    arena_free(&arena); return out;\n")




def emit_pymodule_view_return_conversion(buffer: mutable darray[u8]&, file: Ast::File&, target_params: darray[Ast::ParamDecl]&, type_name: sview, is_error: bool, has_input_arena: bool) -> void can[Abort.Panic, Memory.Allocate]:
    element_name: sview = pymodule_view_element_name(type_name)
    element_c_type: mutable sview = pymodule_darray_c_element_type(element_name)
    element_c_type <- element_name if element_c_type == "" and pymodule_struct_return_supported(file, element_name)
    emit_tokens_push_sview(buffer, ");\n") if not is_error
    emit_tokens_push_sview(buffer, "    if (result.len < 0 || result.len > PY_SSIZE_T_MAX || (result.data == NULL && result.len != 0)) {\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena);\n") if has_input_arena
    emit_tokens_push_sview(buffer, "        PyErr_SetString(PyExc_RuntimeError, \"native Elisa function returned an invalid view\"); return NULL;\n    }\n")
    if element_name == "u8":
        emit_tokens_push_sview(buffer, "    PyObject *out = PyBytes_FromStringAndSize((const char *)result.data, (Py_ssize_t)result.len);\n")
        emit_pymodule_darray_cleanup(buffer, target_params, "    ")
        emit_pymodule_dict_cleanup(buffer, target_params, "    ")
        emit_tokens_push_sview(buffer, "    arena_free(&arena);\n") if has_input_arena
        emit_tokens_push_sview(buffer, "    return out;\n")
        return
    emit_tokens_push_sview(buffer, "    PyObject *out = PyList_New((Py_ssize_t)result.len);\n    if (out == NULL) {\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena);\n") if has_input_arena
    emit_tokens_push_sview(buffer, "        return NULL;\n    }\n    for (Py_ssize_t result_index = 0; result_index < (Py_ssize_t)result.len; ++result_index) {\n        PyObject *item = NULL;\n")
    if pymodule_struct_return_supported(file, element_name):
        emit_tokens_push_sview(buffer, "        item = elisa_pymodule_struct_")
        emit_tokens_push_sview(buffer, element_name)
        emit_tokens_push_sview(buffer, "_to_py(((")
        emit_tokens_push_sview(buffer, element_c_type)
        emit_tokens_push_sview(buffer, " *)result.data)[result_index]);\n")
    elif element_name == "sview" or element_name == "sview?":
        if element_name == "sview?":
            emit_tokens_push_sview(buffer, "        ElisaOptionalSView item_view = ((ElisaOptionalSView *)result.data)[result_index];\n        if (!item_view.has_value) { Py_INCREF(Py_None); item = Py_None; } else {\n            if (item_view.value.len < 0 || item_view.value.len > PY_SSIZE_T_MAX || (item_view.value.data == NULL && item_view.value.len != 0)) { Py_DECREF(out);\n")
            emit_pymodule_darray_cleanup(buffer, target_params, "                ")
            emit_pymodule_dict_cleanup(buffer, target_params, "                ")
            emit_tokens_push_sview(buffer, "                arena_free(&arena);\n") if has_input_arena
            emit_tokens_push_sview(buffer, "                PyErr_SetString(PyExc_RuntimeError, \"native optional sview view element is invalid\"); return NULL; }\n            item = item_view.value.data == NULL ? PyUnicode_FromString(\"\") : PyUnicode_DecodeUTF8(item_view.value.data, (Py_ssize_t)item_view.value.len, \"strict\");\n        }\n")
        else:
            emit_tokens_push_sview(buffer, "        ElisaSView item_view = ((ElisaSView *)result.data)[result_index];\n        if (item_view.len < 0 || item_view.len > PY_SSIZE_T_MAX || (item_view.data == NULL && item_view.len != 0)) { Py_DECREF(out);\n")
            emit_pymodule_darray_cleanup(buffer, target_params, "            ")
            emit_pymodule_dict_cleanup(buffer, target_params, "            ")
            emit_tokens_push_sview(buffer, "            arena_free(&arena);\n") if has_input_arena
            emit_tokens_push_sview(buffer, "            PyErr_SetString(PyExc_RuntimeError, \"native sview view element is invalid\"); return NULL; }\n        item = item_view.data == NULL ? PyUnicode_FromString(\"\") : PyUnicode_DecodeUTF8(item_view.data, (Py_ssize_t)item_view.len, \"strict\");\n")
    elif element_name == "cstr" or element_name == "cstr?":
        emit_tokens_push_sview(buffer, "        const char *item_text = ((const char **)result.data)[result_index];\n")
        if element_name == "cstr?":
            emit_tokens_push_sview(buffer, "        if (item_text == NULL) { Py_INCREF(Py_None); item = Py_None; } else item = PyUnicode_FromString(item_text);\n")
        else:
            emit_tokens_push_sview(buffer, "        if (item_text == NULL) { Py_DECREF(out);\n")
            emit_pymodule_darray_cleanup(buffer, target_params, "            ")
            emit_pymodule_dict_cleanup(buffer, target_params, "            ")
            emit_tokens_push_sview(buffer, "            arena_free(&arena);\n") if has_input_arena
            emit_tokens_push_sview(buffer, "            PyErr_SetString(PyExc_RuntimeError, \"native view returned a null cstr element\"); return NULL; }\n        item = PyUnicode_FromString(item_text);\n")
    elif element_name == "py::Object" or element_name == "py::Object?":
        emit_tokens_push_sview(buffer, "        item = ((PyObject **)result.data)[result_index];\n        if (item == NULL) { Py_INCREF(Py_None); item = Py_None; } else Py_INCREF(item);\n")
    elif pymodule_is_optional_scalar_type(element_name):
        optional_c_type: sview = pymodule_c_type_name(element_name)
        payload_name: sview = pymodule_optional_payload_name(element_name)
        emit_tokens_push_sview(buffer, "        ")
        emit_tokens_push_sview(buffer, optional_c_type)
        emit_tokens_push_sview(buffer, " item_optional = ((")
        emit_tokens_push_sview(buffer, optional_c_type)
        emit_tokens_push_sview(buffer, " *)result.data)[result_index]; if (!item_optional.has_value) { Py_INCREF(Py_None); item = Py_None; } else {")
        if payload_name == "bool":
            emit_tokens_push_sview(buffer, " item = PyBool_FromLong((long)item_optional.value); }\n")
        elif payload_name == "f32" or payload_name == "f64":
            emit_tokens_push_sview(buffer, " item = PyFloat_FromDouble((double)item_optional.value); }\n")
        elif payload_name == "u8" or payload_name == "u16" or payload_name == "u32" or payload_name == "u64" or payload_name == "usize" or payload_name == "uintptr":
            emit_tokens_push_sview(buffer, " item = PyLong_FromUnsignedLongLong((unsigned long long)item_optional.value); }\n")
        else:
            emit_tokens_push_sview(buffer, " item = PyLong_FromLongLong((long long)item_optional.value); }\n")
    elif element_name == "bool":
        emit_tokens_push_sview(buffer, "        item = PyBool_FromLong((long)((bool *)result.data)[result_index]);\n")
    elif element_name == "f32" or element_name == "f64":
        emit_tokens_push_sview(buffer, "        item = PyFloat_FromDouble((double)((")
        emit_tokens_push_sview(buffer, element_c_type)
        emit_tokens_push_sview(buffer, " *)result.data)[result_index]);\n")
    elif pymodule_darray_element_is_unsigned(element_name):
        emit_tokens_push_sview(buffer, "        item = PyLong_FromUnsignedLongLong((unsigned long long)((")
        emit_tokens_push_sview(buffer, element_c_type)
        emit_tokens_push_sview(buffer, " *)result.data)[result_index]);\n")
    else:
        emit_tokens_push_sview(buffer, "        item = PyLong_FromLongLong((long long)((")
        emit_tokens_push_sview(buffer, element_c_type)
        emit_tokens_push_sview(buffer, " *)result.data)[result_index]);\n")
    emit_tokens_push_sview(buffer, "        if (item == NULL) { Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "            ")
    emit_pymodule_dict_cleanup(buffer, target_params, "            ")
    emit_tokens_push_sview(buffer, "            arena_free(&arena);\n") if has_input_arena
    emit_tokens_push_sview(buffer, "            return NULL;\n        }\n        PyList_SET_ITEM(out, result_index, item);\n    }\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "    ")
    emit_pymodule_dict_cleanup(buffer, target_params, "    ")
    emit_tokens_push_sview(buffer, "    arena_free(&arena);\n") if has_input_arena
    emit_tokens_push_sview(buffer, "    return out;\n")
