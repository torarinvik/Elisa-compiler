def run_llvm_compile_request_with_cleanup(compile_file: Ast::File&, out_path: darray[u8]&, static_generation_expanded: bool, tokens: darray[Lexer::Token]&, src_ptr: u8&, source_len: usize, expanded_tokens: darray[Lexer::Token]&, expanded_src_ptr: u8&) -> i64 can[Blocking.IO, Abort.Panic, Memory.Allocate, Memory.Release, Unsafe{PointerArithmetic,PointerCast,RawExtern}, Global{Read,Write}, Console]:
    ctx: LLVMContextRef = LLVMContextCreate()
    # Local value and block names never reach an object or executable, and naming ~4M
    # values was ~8% of IR generation for the self-host unit. Kept for every textual or
    # bitcode output, where a reader sees them.
    LLVMContextSetDiscardValueNames(ctx, 1) if emit_mode_is_plain_object() or emit_mode_is("exe")
    module_handle: LLVMModuleRef = LLVMModuleCreateWithNameInContext("elisac_stage1", ctx)
    stamp_module_source_path(module_handle)
    # Select the target machine at the same level as the IR pass pipeline. The
    # target's legalization/combiner cost model is part of optimization, so
    # configuring it at O0 and only optimizing the module above produced a
    # mixed pipeline with target-specific ABI surprises on arm64.
    opt_level: i64 = optimization_level()
    triple_storage: mutable darray[u8] = []
    machine: void& = Backend::configure_module_target_for_level(module_handle, requested_target_triple(&triple_storage), opt_level)
    target_data: LLVMTargetDataRef = LLVMCreateTargetDataLayout(machine)
    builder: LLVMBuilderRef = LLVMCreateBuilderInContext(ctx)
    status: i64 = run_llvm_compile_request_body(compile_file, out_path, static_generation_expanded, tokens, src_ptr, source_len, expanded_tokens, expanded_src_ptr, ctx, module_handle, machine, target_data, builder, opt_level) can[Blocking.IO, Abort.Panic, Memory.Allocate, Memory.Release, Unsafe{PointerArithmetic,PointerCast,RawExtern}, Global{Read,Write}, Console]
    # Destroy request-local LLVM handles on every ordinary return from the emitter.
    LLVMDisposeBuilder(builder)
    LLVMDisposeModule(module_handle)
    LLVMDisposeTargetData(target_data)
    LLVMDisposeTargetMachine(machine)
    LLVMContextDispose(ctx)
    return status


def run_llvm_compile_request_body(compile_file: Ast::File&, out_path: darray[u8]&, static_generation_expanded: bool, tokens: darray[Lexer::Token]&, src_ptr: u8&, source_len: usize, expanded_tokens: darray[Lexer::Token]&, expanded_src_ptr: u8&, ctx: LLVMContextRef, module_handle: LLVMModuleRef, machine: void&, target_data: LLVMTargetDataRef, builder: LLVMBuilderRef, opt_level: i64) -> i64 can[Blocking.IO, Abort.Panic, Memory.Allocate, Memory.Release, Unsafe{PointerArithmetic,PointerCast,RawExtern}, Global{Read,Write}, Console]:
    source_name_storage: mutable darray[u8] = []
    source_name: mutable sview = sview("", 0, 0)
    if env_value("ELISA_STAGE1_SRC", &source_name_storage):
        source_name <- bytes_view_range(source_name_storage, 0, source_name_storage.count)
    # Contracts are CHECKED at -O0 and erased above it -- stage0's rule ("debug verifies what
    # release assumes"), including its ELISACORE_FORCE_CONTRACTS override.
    contracts_checked: mutable bool = opt_level == STAGE1_OPT_LEVEL_0
    if getenv("ELISACORE_FORCE_CONTRACTS") is forced_contracts:
        contracts_checked <- true
    emitted_count: i64 = Backend::emit_module_with_debug_trace(compile_file, module_handle, ctx, builder, target_data, debug_info_enabled(), trace_info_enabled(), source_name, contracts_checked) can Global{Read,Write}
    # A unit with no function at all emits nothing BY CONSTRUCTION — see
    # unit_declares_function. Only a unit that HAS one and emitted none has failed.
    #
    # SAY SO. This used to be a bare `2 return if …`: exit 2, empty stdout, empty stderr. One
    # unsupported construct anywhere in the unit silently killed every function in it, and the
    # only way to attribute the failure was to bisect the source by truncation until the
    # offending definition fell out — which is exactly what a `pile <- pile.resize(n)` in the
    # project system cost. The backend already recorded every declined name in the module's
    # own `!elisa.declined` metadata; nothing ever read it.
    #
    # Via write_stderr, not puts: libc `puts` collides with elisacore_std's overload under
    # stage1 meta-compile and the stage0 seed, which is why this path was mute in the first
    # place. write(2, …) has no such conflict — the CLI's diagnostics already go out that way.
    if emitted_count <= 0 and unit_declares_function(compile_file.top_decls):
        decline_report: mutable darray[u8] = []
        declined_total: i64 = Backend::declined_function_report(module_handle, &decline_report)
        message: mutable darray[u8] = []
        emit_tokens_push_sview(message, "error: backend could not produce a linkable unit" if emitted_count < 0 else "error: backend emitted no functions for this unit")
        if declined_total > 0:
            emit_tokens_push_sview(message, "; declined ")
            append_decimal(message, declined_total.u32())
            emit_tokens_push_sview(message, ": ")
            message.extend(decline_report)
        message.push(10)
        emit_tokens_push_sview(message, "note: backend declines made this unit unsafe to emit; the object was not written\n" if emitted_count < 0 else "note: every function body was declined; the object was not written\n")
        write_stderr(message)
        return 2
    # A PARTIAL decline is not a valid artifact: even if the emitted bodies form linkable
    # LLVM, the source unit has silently lost a required definition. Reject before writing
    # any output so every executable/object mode fails at the source that triggered it.
    if emitted_count > 0 and unit_declares_function(compile_file.top_decls):
        partial_report: mutable darray[u8] = []
        partial_total: i64 = Backend::declined_function_report(module_handle, &partial_report)
        if partial_total > 0:
            partial_message: mutable darray[u8] = []
            emit_tokens_push_sview(partial_message, "error: backend declined ")
            append_decimal(partial_message, partial_total.u32())
            emit_tokens_push_sview(partial_message, " function body(ies); the object does not define: ")
            partial_message.extend(partial_report)
            partial_message.push(10)
            emit_tokens_push_sview(partial_message, "note: partial backend output is unsafe to emit; no artifact was written\n")
            write_stderr(partial_message)
            return 2

    # Copies of large aggregates become memmoves before LLVM sees them; first-class
    # aggregate load/store pairs of ~100 KB structs made SelectionDAG go quadratic.
    PhaseTimer::mark("llvm-ir-generation") can Global{Read,Write}
    _ = Backend::lower_large_aggregate_copies(module_handle, ctx, target_data)

    # Never hand malformed CFG to LLVM's optimizer or target emitter. A missing block
    # terminator used to survive textual IR output and then crash LLVM in
    # EliminateUnreachableBlocks/SimplifyCFG, turning a frontend/backend defect into a
    # compiler process SIGSEGV. Verify every generated module first and fail closed.
    # Use LLVMPrintMessageAction with a null OutMessage. LLVM then prints its precise
    # verifier diagnostic (usually including the failing function/block) to stderr.
    # Avoid fabricating a C char** by casting Elisa's nullable cstr storage: the C API
    # requires char**, and an incorrectly represented out-slot can hide the message or
    # corrupt adjacent state. Action 1 reports and returns; it does not abort the process.
    #
    # An unoptimised object build with parallel emission verifies inside
    # emit_object_parallel_verifying, before it forks the code generators; a rejected module
    # writes no object and fails with exactly this diagnostic and status.
    # An LTO object is bitcode, never a parallel emit: verify up front.
    verify_during_emit: bool = opt_level == STAGE1_OPT_LEVEL_0 and Backend::parallel_emit_jobs() > 1 and emit_mode_is_plain_object() and not lto_requested()
    if not verify_during_emit and LLVMVerifyModule(module_handle, LLVM_VERIFY_PRINT_MESSAGE_ACTION, null) != 0:
        # ELISA_DUMP_INVALID_IR=<path>: write the rejected module for triage. The verifier
        # message names the instruction but not the function.
        invalid_ir_path: mutable darray[u8] = []
        if env_value("ELISA_DUMP_INVALID_IR", &invalid_ir_path):
            invalid_ir_path.push(0)
            _ = LLVMPrintModuleToFile(module_handle, (&invalid_ir_path[0]).cast[cstr], null) can Unsafe.PointerCast
        return report_invalid_llvm_ir()

    # The pass pipeline runs only when ASKED (ELISA_STAGE1_OPT=1/2/3). It was disabled
    # outright while `default<O2>` trapped on large self-host modules — those traps were
    # the opaque-handle `==` and arena-identity miscompiles in the self-hosted binary
    # (fixed 2026-08-02/03), and the pipeline now survives the compiler's own 110k-line
    # module. Unoptimised emission stays the DEFAULT: the fixpoint compares bytes, and
    # optimisation must never change results, only speed — differential_corpus runs the
    # corpus under -O2 exactly to hold that.
    PhaseTimer::mark("llvm-verify") can Global{Read,Write}
    # Optimised builds may inline the runtime's AST-record lookup (see the function).
    Backend::inline_aos_store_record(module_handle) if opt_level > 0
    if opt_level > 0 and not debug_info_enabled():
        can Global.Read:
            _ = Backend::split_rewrite_module(module_handle, ctx) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read]
        return report_invalid_llvm_ir() if LLVMVerifyModule(module_handle, LLVM_VERIFY_PRINT_MESSAGE_ACTION, null) != 0
    match opt_level:
        1:
            return 5 if not (Backend::run_optimization(machine, module_handle, "default<O1>") can Global{Read,Write})
        2:
            return 5 if not (Backend::run_optimization(machine, module_handle, "default<O2>") can Global{Read,Write})
        3:
            return 5 if not (Backend::run_optimization(machine, module_handle, "default<O3>") can Global{Read,Write})
            if not debug_info_enabled():
                zero_forwarded: mutable usize = 0
                can Global.Read:
                    zero_forwarded <- Backend::forward_zeroed_stack_loads(module_handle) can[Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read]
                return report_invalid_llvm_ir() if zero_forwarded > 0 and LLVMVerifyModule(module_handle, LLVM_VERIFY_PRINT_MESSAGE_ACTION, null) != 0
                folded_ranges: mutable usize = 0
                can Global.Read:
                    folded_ranges <- Backend::fold_constant_global_ranges(module_handle, ctx) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read]
                return report_invalid_llvm_ir() if folded_ranges > 0 and LLVMVerifyModule(module_handle, LLVM_VERIFY_PRINT_MESSAGE_ACTION, null) != 0
                unroll_status: i32 = Backend::experimental_table_unroll(module_handle, ctx, machine) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read]
                return 5 if unroll_status == 2
                return report_invalid_llvm_ir() if unroll_status == 1 and LLVMVerifyModule(module_handle, LLVM_VERIFY_PRINT_MESSAGE_ACTION, null) != 0
        _:
            pass

    PhaseTimer::mark("llvm-optimize") can Global{Read,Write}
    path_cstr: cstr = (&out_path[0]).cast[cstr]
    if emit_llvm_requested():
        return 6 if LLVMPrintModuleToFile(module_handle, path_cstr, null) != 0
    elif emit_mode_is("bc"):
        # `-emit bc` — the SAME module the object path lowers, written as bitcode instead
        # of assembled. It runs after the optimisation pipeline above, so `-O2 -emit bc`
        # is optimised bitcode, matching what stage0 writes.
        return 7 if LLVMWriteBitcodeToFile(module_handle, path_cstr) != 0
    elif emit_mode_is("exe"):
        # Emit the object BESIDE the requested executable (path + ".o"), link, then remove
        # it. Writing next to the target keeps the temporary on the same filesystem the
        # caller can write to.
        object_path: mutable darray[u8] = []
        for path_index in 0..<out_path.count |object_path, out_path|:
            object_path.push(out_path[path_index]) if out_path[path_index] != 0
        object_path.push(46)
        object_path.push(111)
        object_path.push(0)
        object_cstr: cstr = (&object_path[0]).cast[cstr] can Unsafe.PointerCast
        if lto_requested():
            object_path.pop()
            can Global{Read,Write}:
                return 4 if not write_lto_object(machine, module_handle, object_path)
            object_path.push(0)
        else:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global{Read,Write}, Blocking.IO:
                return 4 if not Backend::emit_object_parallel(machine, module_handle, object_cstr, Backend::parallel_emit_jobs(), opt_level > 0)
        object_path.pop()
        PhaseTimer::mark("emit-object") can Global{Read,Write}
        exe_path: mutable darray[u8] = []
        for path_index in 0..<out_path.count |exe_path, out_path|:
            exe_path.push(out_path[path_index]) if out_path[path_index] != 0
        can Global{Read,Write}:
            link_status: i64 = link_executable(object_path, exe_path)
            return link_status if link_status != 0
        PhaseTimer::mark("link") can Global{Read,Write}
    elif emit_mode_is("pymodule-so"):
        # The object is an ordinary one at the default destination; the pipeline links it
        # with the generated shim and the runtime into the extension, whose filename it
        # derives from the module name and the target interpreter's suffix.
        return 4 if not Backend::emit_object(machine, module_handle, path_cstr)
        module_object: mutable darray[u8] = []
        for path_index in 0..<out_path.count |module_object, out_path|:
            module_object.push(out_path[path_index]) if out_path[path_index] != 0
        requested_out: mutable darray[u8] = []
        _ = env_value("ELISA_STAGE1_PYMODULE_OUT", &requested_out)
        can Global{Read,Write}:
            so_status: i64 = emit_pymodule_so_finish(module_object, requested_out)
            _ = unlink(path_cstr)
            return so_status if so_status != 0
    elif emit_mode_is("wasm"):
        # The wasm32 object beside the `.wasm`, then the packaging steps (runtime object,
        # wasm-ld, manifest, facade) — see emit_wasm.elisa.
        wasm_object: mutable darray[u8] = []
        for path_index in 0..<out_path.count |wasm_object, out_path|:
            wasm_object.push(out_path[path_index]) if out_path[path_index] != 0
        emit_tokens_push_sview(&wasm_object, ".o")
        wasm_object.push(0)
        wasm_object_cstr: cstr = (&wasm_object[0]).cast[cstr] can Unsafe.PointerCast
        return 4 if not Backend::emit_object(machine, module_handle, wasm_object_cstr)
        wasm_object.pop()
        wasm_out: mutable darray[u8] = []
        for path_index in 0..<out_path.count |wasm_out, out_path|:
            wasm_out.push(out_path[path_index]) if out_path[path_index] != 0
        # `compile_file` is the EXPANDED parse when a `static generate` block was spliced, so the
        # export scan must be given the tokens and source that parse belongs to — the
        # token ranges are looked up by the declaration's own line and offset.
        wasm_status: mutable i64 = 0
        if expanded_tokens.count > 0:
            wasm_status <- emit_wasm_finish(compile_file, expanded_tokens, expanded_src_ptr, wasm_object, wasm_out) can Global{Read,Write}
        else:
            wasm_status <- emit_wasm_finish(compile_file, tokens, src_ptr, wasm_object, wasm_out) can Global{Read,Write}
        # The pop above dropped the terminator the first cstr relied on; re-terminate and take a
        # fresh cstr instead of reading a popped element.
        wasm_object.push(0)
        wasm_object_unlink: cstr = (&wasm_object[0]).cast[cstr] can Unsafe.PointerCast
        _ = unlink(wasm_object_unlink)
        return wasm_status if wasm_status != 0
    elif lto_requested():
        # `-emit obj -flto`: an LTO (bitcode) object, as `clang -flto -c` writes (stage0
        # writeLTOObjectFile). Link it with an LLVM-matched `clang -flto`.
        lto_object: mutable darray[u8] = []
        for path_index in 0..<out_path.count |lto_object, out_path|:
            lto_object.push(out_path[path_index]) if out_path[path_index] != 0
        can Global{Read,Write}:
            return 4 if not write_lto_object(machine, module_handle, lto_object)
        PhaseTimer::mark("emit-object") can Global{Read,Write}
    else:
        # ELISA_STAGE1_JOBS=N splits object emission over N forked code generators.
        if verify_during_emit:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global{Read,Write}, Blocking.IO, Console:
                emit_status: i64 = Backend::emit_object_parallel_verifying(machine, module_handle, path_cstr, Backend::parallel_emit_jobs())
                return report_invalid_llvm_ir() if emit_status == 2
                return 4 if emit_status != 0
        else:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Global{Read,Write}, Blocking.IO:
                return 4 if not Backend::emit_object_parallel(machine, module_handle, path_cstr, Backend::parallel_emit_jobs(), opt_level > 0)
        PhaseTimer::mark("emit-object") can Global{Read,Write}

    return 0


const ELISAC_INCREMENTAL_COMPILE_SESSION_EPOCH_REQUEST_LIMIT: usize = 32

struct IncrementalCompileServerEpochResult:
    stopped: bool
    status: i64


def incremental_compile_server_mode_supported() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    mode: mutable darray[u8] = []
    return true if not env_value("ELISA_STAGE1_EMIT", &mode)
    return true if mode.count == 0.usize()
    return emit_mode_is("check") or emit_mode_is("obj") or emit_llvm_requested() or emit_mode_is("bc") or emit_mode_is("exe") or emit_mode_is("wasm") or emit_mode_is("pymodule-so") or emit_mode_is("edir")


def incremental_compile_server_epoch(argc: i64, argv: mutable void&, cache_directory: darray[u8]&, report_cache: bool, shadow_enabled: bool, shadow_report: bool, baseline_smt_enabled: bool, baseline_wasm_component_types: darray[u8]&) -> IncrementalCompileServerEpochResult can[Blocking.IO, Abort.Panic, Console, Memory.Allocate, Memory.Release, Global{Read,Write}, Unsafe{PointerArithmetic,PointerCast,RawExtern}]:
    region compile_session:
        sessions: mutable darray[Semantic::IncrementalSemanticSession[compile_session]] @compile_session = []
        sessions.push(Semantic::incremental_semantic_session_new[compile_session](true))
        igc_configure_semantic_query_graph(&sessions[0]) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]
        # Reuse identity buffers across checks; each CLI capture truncates them before refill.
        # The context shares the session lifetime for synchronous cache operations.
        context: mutable SourceIdentity::InvocationContext = SourceIdentity::empty_identity_context(true) can Memory.Allocate
        command: mutable darray[u8] @compile_session = []
        completed_requests: mutable usize = 0.usize()
        while completed_requests < ELISAC_INCREMENTAL_COMPILE_SESSION_EPOCH_REQUEST_LIMIT |completed_requests, command, sessions, context|:
            command.truncate(0.usize())
            command_too_long: mutable bool = false
            input_eof: mutable bool = false
            saw_input: mutable bool = false
            line_terminated: mutable bool = false
            while true |command, command_too_long, input_eof, saw_input, line_terminated|:
                byte: mutable u8 = 0
                amount: isize = read(0, &byte, 1)
                if amount == 0:
                    input_eof <- true
                    break
                if amount < 0:
                    continue if incremental_server_io_interrupted()
                    message: mutable darray[u8] = []
                    message.extend("error: could not read compile-session command\n")
                    write_stderr(message)
                    return IncrementalCompileServerEpochResult{stopped: true, status: 1}
                saw_input <- true
                if byte == 10:
                    line_terminated <- true
                    break
                if command.count < ELISAC_INCREMENTAL_SERVER_COMMAND_LIMIT:
                    command.push(byte)
                else:
                    command_too_long <- true
            if input_eof and not saw_input:
                return IncrementalCompileServerEpochResult{stopped: true, status: 0}
            if line_terminated and command.count > 0 and command[command.count - 1] == 13:
                command.truncate(command.count - 1)
            if command_too_long:
                incremental_server_write_invalid_command()
                continue
            if command.count == 4 and command[0] == 113 and command[1] == 117 and command[2] == 105 and command[3] == 116:
                return IncrementalCompileServerEpochResult{stopped: true, status: 0}
            if command.count == 7 and command[0] == 99 and command[1] == 111 and command[2] == 109 and command[3] == 112 and command[4] == 105 and command[5] == 108 and command[6] == 101:
                completed_requests <- completed_requests + 1.usize()
                request_status: mutable i64 = 1
                PhaseTimer::request_start() can Global{Read,Write}
                can Abort.Panic, Global{Read,Write}:
                    Lexer::line_map_clear()
                region request:
                    raw: mutable darray[u8] @request = cli_request_with_source_context_from(argc, argv, 2, baseline_wasm_component_types, baseline_smt_enabled, &context) can[Abort.Panic, Global{Read,Write}, Memory.Allocate, Unsafe.PointerCast]
                    if raw.count > 1:
                        if incremental_compile_server_mode_supported():
                            request_status <- run_compile_request_with_session(raw, false, 0, context, cache_directory, report_cache, shadow_enabled, shadow_report, &sessions[0]) can[Blocking.IO, Abort.Panic, Console, Memory.Allocate, Memory.Release, Global{Read,Write}, Unsafe{PointerArithmetic,PointerCast,RawExtern}]
                        else:
                            message: mutable darray[u8] = []
                            message.extend("error: compile-session supports -emit check, obj, llvm, bc, exe, wasm, pymodule-so, and edir\n")
                            write_stderr(message)
                incremental_server_write_status(request_status)
            else:
                incremental_server_write_invalid_command()
        return IncrementalCompileServerEpochResult{stopped: false, status: 0}


def run_incremental_compile_server(argc: i64, argv: mutable void&) -> i64 can[Blocking.IO, Abort.Panic, Console, Memory.Allocate, Memory.Release, Global{Read,Write}, Unsafe{PointerArithmetic,PointerCast,RawExtern}]:
    if argc < 3:
        usage: mutable darray[u8] = []
        usage.extend("usage: elisac-stage1 compile-session [-emit check|obj|llvm|bc|exe|wasm|pymodule-so|edir] [-o OUT] SOURCE\nprotocol: write `compile` or `quit` on stdin; each compile prints 0 (accepted) or 1 (rejected) on stdout\n")
        write_stderr(usage)
        return 2
    incremental_shadow_enabled: bool = env_flag_is_one("ELISA_INCREMENTAL_SHADOW") can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]
    incremental_shadow_report_enabled: mutable bool = false
    if incremental_shadow_enabled:
        incremental_shadow_report_enabled <- env_flag_is_one("ELISA_INCREMENTAL_SHADOW_REPORT") can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]
    incremental_cache_directory: mutable darray[u8] = []
    _ = env_value("ELISA_STAGE1_INCREMENTAL_CACHE_DIR", &incremental_cache_directory)
    incremental_cache_report_enabled: bool = env_flag_is_one("ELISA_STAGE1_INCREMENTAL_CACHE_REPORT") can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]
    baseline_smt_enabled: bool = env_flag_enabled("ELISA_STAGE1_SMT") can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]
    baseline_wasm_component_types: mutable darray[u8] = []
    _ = env_value("ELISA_STAGE1_WASM_COMPONENT_TYPES", &baseline_wasm_component_types)
    region server_state:
        stopped: mutable bool = false
        server_status: mutable i64 = 0
        while not stopped |stopped, server_status|:
            epoch: IncrementalCompileServerEpochResult = incremental_compile_server_epoch(argc, argv, incremental_cache_directory, incremental_cache_report_enabled, incremental_shadow_enabled, incremental_shadow_report_enabled, baseline_smt_enabled, baseline_wasm_component_types) can[Blocking.IO, Abort.Panic, Console, Memory.Allocate, Memory.Release, Global{Read,Write}, Unsafe{PointerArithmetic,PointerCast,RawExtern}]
            stopped <- epoch.stopped
            server_status <- epoch.status
        return server_status
