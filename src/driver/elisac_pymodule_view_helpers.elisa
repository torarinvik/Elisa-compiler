        elif element_name == "sview?":
            emit_tokens_push_sview(buffer, "char *item_copy = NULL; if (item_len > 0) { item_copy = (char *)arena_alloc(arena, (int64_t)item_len); if (item_copy == NULL) { Py_DECREF(view_seq); Py_DECREF(field_seq); PyErr_NoMemory(); return -1; } for (Py_ssize_t copy_index = 0; copy_index < item_len; ++copy_index) item_copy[copy_index] = item_data[copy_index]; } ((ElisaOptionalSView *)view_destination->data)[view_index] = (ElisaOptionalSView){true, (ElisaSView){item_copy, (int64_t)item_len}}; ")
