                emit_tokens_push_sview(buffer, "ElisaOptionalSView item_view = ((ElisaOptionalSView *)view.data)[view_index]; if (!item_view.has_value) { Py_INCREF(Py_None); view_item = Py_None; } else { if (item_view.value.len < 0 || item_view.value.len > PY_SSIZE_T_MAX || (item_view.value.data == NULL && item_view.value.len != 0)) { Py_DECREF(field_item); Py_DECREF(out); PyErr_SetString(PyExc_RuntimeError, \"native optional sview view-list element is invalid\"); return NULL; } view_item = item_view.value.data == NULL ? PyUnicode_FromString(\"\") : PyUnicode_DecodeUTF8(item_view.value.data, (Py_ssize_t)item_view.value.len, \"strict\"); }")
