    element_name: sview = pymodule_view_element_name(view_type_name)
    element_c_type: sview = pymodule_darray_c_element_type(element_name)
    if element_c_type == "" and pymodule_struct_return_supported(file, element_name):
        inner_name_storage: mutable darray[u8] = []
