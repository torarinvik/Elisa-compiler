# `-emit pymodule` — the generated helpers for lists of VIEWS: an ordinary ElisaDArray whose
# elements are ElisaView headers, materialized on the way in and copied on the way out.


# A list of views is an ordinary ElisaDArray whose elements are ElisaView headers.  Materialize
# both the headers and each view's element storage in the shared call arena; text is copied and
# opaque Python objects are retained until the native call returns.  This keeps darray[view[T]]
# compositional without borrowing a transient nested Python sequence through the C ABI.
def emit_pymodule_darray_view_input_helper(buffer: mutable darray[u8]&, file: Ast::File&, helper_name: sview, view_type_name: sview) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    element_name: sview = pymodule_view_element_name(view_type_name)
    element_c_type: sview = pymodule_darray_c_element_type(element_name)
    if element_c_type == "" and pymodule_struct_input_supported(file, element_name):
        inner_name_storage: mutable darray[u8] = []
        for helper_index in 0..<sview_len(helper_name) |inner_name_storage, helper_name, helper_index|:
            inner_name_storage.push(sview_at(helper_name, helper_index))
        emit_tokens_push_sview(&inner_name_storage, "_element_from_py")
        inner_name: sview = sview(&inner_name_storage[0], 0, inner_name_storage.count)
        emit_pymodule_view_struct_input_helper(buffer, file, inner_name, element_name)
        emit_tokens_push_sview(buffer, "static int ")
        emit_tokens_push_sview(buffer, helper_name)
        emit_tokens_push_sview(buffer, "(PyObject *field_obj, ElisaDArray *destination, ElisaArena *arena, ElisaPyRefs *refs) { PyObject *field_seq = PySequence_Fast(field_obj, \"expected a sequence of views\"); if (field_seq == NULL) return -1; Py_ssize_t field_count = PySequence_Fast_GET_SIZE(field_seq); if (field_count > PY_SSIZE_T_MAX / (Py_ssize_t)sizeof(ElisaView)) { Py_DECREF(field_seq); PyErr_SetString(PyExc_OverflowError, \"sequence of views is too large\"); return -1; } destination->items = NULL; destination->count = (int64_t)field_count; destination->capacity = (int64_t)field_count; if (field_count > 0) { destination->items = arena_alloc(arena, (int64_t)((size_t)field_count * sizeof(ElisaView))); if (destination->items == NULL) { Py_DECREF(field_seq); PyErr_NoMemory(); return -1; } } for (Py_ssize_t field_index = 0; field_index < field_count; ++field_index) { Py_ssize_t field_path_mark = elisa_pymodule_current_path_length; if (elisa_pymodule_current_path_push_index(field_index) < 0) { Py_DECREF(field_seq); return -1; } if (")
        emit_tokens_push_sview(buffer, inner_name)
        emit_tokens_push_sview(buffer, "(PySequence_Fast_GET_ITEM(field_seq, field_index), &((ElisaView *)destination->items)[field_index], arena, refs) < 0) { Py_DECREF(field_seq); return -1; } elisa_pymodule_current_path_restore(field_path_mark); } Py_DECREF(field_seq); return 0; }\n")
        return
    emit_tokens_push_sview(buffer, "static int ")
    emit_tokens_push_sview(buffer, helper_name)
    emit_tokens_push_sview(buffer, "(PyObject *field_obj, ElisaDArray *destination, ElisaArena *arena, ElisaPyRefs *refs) { PyObject *field_seq = PySequence_Fast(field_obj, \"expected a sequence of views\"); if (field_seq == NULL) return -1; Py_ssize_t field_count = PySequence_Fast_GET_SIZE(field_seq); if (field_count > PY_SSIZE_T_MAX / (Py_ssize_t)sizeof(ElisaView)) { Py_DECREF(field_seq); PyErr_SetString(PyExc_OverflowError, \"sequence of views is too large\"); return -1; } destination->items = NULL; destination->count = (int64_t)field_count; destination->capacity = (int64_t)field_count; if (field_count > 0) { destination->items = arena_alloc(arena, (int64_t)((size_t)field_count * sizeof(ElisaView))); if (destination->items == NULL) { Py_DECREF(field_seq); PyErr_NoMemory(); return -1; } } for (Py_ssize_t field_index = 0; field_index < field_count; ++field_index) { Py_ssize_t field_path_mark = elisa_pymodule_current_path_length; if (elisa_pymodule_current_path_push_index(field_index) < 0) { Py_DECREF(field_seq); return -1; } PyObject *view_seq = PySequence_Fast(PySequence_Fast_GET_ITEM(field_seq, field_index), \"expected a sequence for each view\"); if (view_seq == NULL) { Py_DECREF(field_seq); return -1; } Py_ssize_t view_len = PySequence_Fast_GET_SIZE(view_seq); if (view_len > PY_SSIZE_T_MAX / (Py_ssize_t)sizeof(")
    emit_tokens_push_sview(buffer, element_c_type)
    emit_tokens_push_sview(buffer, ")) { Py_DECREF(view_seq); Py_DECREF(field_seq); PyErr_SetString(PyExc_OverflowError, \"view is too large\"); return -1; } ElisaView *view_destination = &((ElisaView *)destination->items)[field_index]; view_destination->data = NULL; view_destination->len = (int64_t)view_len; if (view_len > 0) { view_destination->data = arena_alloc(arena, (int64_t)((size_t)view_len * sizeof(")
