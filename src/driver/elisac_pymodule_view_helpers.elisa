    emit_tokens_push_sview(buffer, "))); if (view_destination->data == NULL) { Py_DECREF(view_seq); Py_DECREF(field_seq); PyErr_NoMemory(); return -1; } } for (Py_ssize_t view_index = 0; view_index < view_len; ++view_index) { Py_ssize_t item_path_mark = elisa_pymodule_current_path_length; if (elisa_pymodule_current_path_push_index(view_index) < 0) { Py_DECREF(view_seq); Py_DECREF(field_seq); return -1; } PyObject *view_item = PySequence_Fast_GET_ITEM(view_seq, view_index); ")
