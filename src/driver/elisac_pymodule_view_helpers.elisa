        if element_name == "py::Object?":
            emit_tokens_push_sview(buffer, "if (view_item == Py_None) ((PyObject **)view_destination->data)[view_index] = NULL; else { if (elisa_pymodule_retain(view_item, refs) < 0) { Py_DECREF(view_seq); Py_DECREF(field_seq); return -1; } ((PyObject **)view_destination->data)[view_index] = view_item; }")
        else:
            emit_tokens_push_sview(buffer, "if (elisa_pymodule_retain(view_item, refs) < 0) { Py_DECREF(view_seq); Py_DECREF(field_seq); return -1; } ((PyObject **)view_destination->data)[view_index] = view_item;")
