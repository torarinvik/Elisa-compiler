        return
    emit_tokens_push_sview(buffer, "static PyObject *")
    emit_tokens_push_sview(buffer, helper_name)
    emit_tokens_push_sview(buffer, "(ElisaDArray input) { if (input.count < 0 || input.capacity < 0 || input.count > input.capacity || input.count > (int64_t)PY_SSIZE_T_MAX || input.capacity > (int64_t)PY_SSIZE_T_MAX || (input.count > 0 && input.items == NULL)) { PyErr_SetString(PyExc_RuntimeError, \"native view list has invalid storage\"); return NULL; } PyObject *out = PyList_New((Py_ssize_t)input.count); if (out == NULL) return NULL; for (Py_ssize_t field_index = 0; field_index < (Py_ssize_t)input.count; ++field_index) { ElisaView view = ((ElisaView *)input.items)[field_index]; if (view.len < 0 || view.len > (int64_t)PY_SSIZE_T_MAX || (view.data == NULL && view.len != 0)) { Py_DECREF(out); PyErr_SetString(PyExc_RuntimeError, \"native view list element has invalid storage\"); return NULL; } PyObject *field_item = NULL; ")
