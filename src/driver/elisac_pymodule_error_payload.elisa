# `-emit pymodule` — ERROR SETS and their payloads: whether a set carries exactly one payload
# field, whether that payload is structured, and whether it needs an arena to outlive the call.


def pymodule_function_is_error(file: Ast::File&, name: sview) -> bool can[Abort.Panic]:
    for annotation in file.enum_annotations |name|:
        true return if annotation.owner == name and annotation.name == "__error_return"
    return false




def pymodule_error_set_has_payload_in(declarations: darray[Ast::Decl]&, wanted: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |wanted|:
        if declaration is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            if error_name == wanted:
                for variant in error_variants:
                    true return if variant.fields.count > 0
                return false
        if declaration is Decl.Module(error_module_name, error_module_body, error_module_pos):
            true return if pymodule_error_set_has_payload_in(error_module_body, wanted)
        if declaration is Decl.Scoped(error_scope_body, error_scope_pos):
            true return if pymodule_error_set_has_payload_in(error_scope_body, wanted)
    return false




# Return the source spelling of the sole payload field when an error set has exactly one field
# across all variants. The Python C shim carries that field through one explicit pointer;
# structured scalar/text/object sets use the separate native-union mapping below.
def pymodule_error_payload_type_in(file: Ast::File&, declarations: darray[Ast::Decl]&, wanted: sview) -> sview can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |wanted|:
        if declaration is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            if error_name == wanted:
                field_total: mutable usize = 0
                payload_name: mutable sview = ""
                for variant in error_variants |field_total, payload_name|:
                    field_total <- field_total + variant.fields.count
                    if variant.fields.count == 1:
                        payload_name <- pymodule_alias_type_name(file, variant.fields[0])
                return payload_name if field_total == 1
                return ""
        if declaration is Decl.Module(error_module_name, error_module_body, error_module_pos):
            nested: sview = pymodule_error_payload_type_in(file, error_module_body, wanted)
            return nested if nested != ""
        if declaration is Decl.Scoped(error_scope_body, error_scope_pos):
            nested_scoped: sview = pymodule_error_payload_type_in(file, error_scope_body, wanted)
            return nested_scoped if nested_scoped != ""
    return ""




def pymodule_error_payload_supported(file: Ast::File&, type_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if pymodule_unsupported_dict_key_in_type(file, type_name) != ""
    return false if pymodule_unsupported_set_element_in_type(file, type_name) != ""
    # Dictionary payloads use the same native bucket copier as ordinary dictionary returns. The
    # error wrapper copies the mapping before releasing the caller-owned arena, so this is safe for
    # every dictionary value family already accepted by the Python bridge.
    return pymodule_nested_dict_values_supported_in_type(file, type_name, 0.usize()) if pymodule_is_dict_type(type_name)
    if pymodule_is_set_type(type_name):
        return pymodule_set_element_supported(pymodule_set_element_name(type_name))
    if pymodule_is_darray_type(type_name):
        element_name: sview = pymodule_darray_element_name(type_name)
        return pymodule_nested_dict_values_supported_in_type(file, element_name, 0.usize()) if pymodule_is_dict_type(element_name)
        return true if pymodule_is_set_type(element_name) and pymodule_set_element_supported(pymodule_set_element_name(element_name))
        return true if pymodule_darray_nesting_depth(type_name) == 1.usize() and pymodule_struct_return_supported(file, element_name)
        return true if pymodule_error_nested_darray_supported(type_name)
        return true if pymodule_darray_is_bytes(type_name)
        return true if element_name == "i8" or element_name == "i16" or element_name == "i32" or element_name == "i64" or element_name == "int" or element_name == "isize" or element_name == "char" or element_name == "u16" or element_name == "u32" or element_name == "u64" or element_name == "usize" or element_name == "uintptr" or element_name == "f32" or element_name == "f64" or element_name == "bool" or element_name == "cstr" or element_name == "cstr?" or element_name == "sview" or element_name == "sview?" or element_name == "py::Object" or element_name == "py::Object?" or pymodule_darray_element_is_optional_scalar(element_name)
        return false
    if pymodule_is_view_type(type_name):
        element_name_view: sview = pymodule_view_element_name(type_name)
        return true if pymodule_struct_return_supported(file, element_name_view)
        return true if element_name_view == "u8" or element_name_view == "i8" or element_name_view == "i16" or element_name_view == "i32" or element_name_view == "i64" or element_name_view == "int" or element_name_view == "isize" or element_name_view == "char" or element_name_view == "u16" or element_name_view == "u32" or element_name_view == "u64" or element_name_view == "usize" or element_name_view == "uintptr" or element_name_view == "f32" or element_name_view == "f64" or element_name_view == "bool" or element_name_view == "cstr" or element_name_view == "sview" or element_name_view == "py::Object" or element_name_view == "i8?" or element_name_view == "i16?" or element_name_view == "i32?" or element_name_view == "i64?" or element_name_view == "int?" or element_name_view == "isize?" or element_name_view == "char?" or element_name_view == "u8?" or element_name_view == "u16?" or element_name_view == "u32?" or element_name_view == "u64?" or element_name_view == "usize?" or element_name_view == "uintptr?" or element_name_view == "bool?" or element_name_view == "f32?" or element_name_view == "f64?" or element_name_view == "cstr?" or element_name_view == "sview?" or element_name_view == "py::Object?"
        return false
    return true if pymodule_struct_return_supported(file, type_name)
    return type_name == "i8" or type_name == "i16" or type_name == "i32" or type_name == "i64" or type_name == "int" or type_name == "isize" or type_name == "char" or type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or type_name == "usize" or type_name == "uintptr" or type_name == "f32" or type_name == "f64" or type_name == "bool" or type_name == "cstr" or type_name == "sview" or type_name == "py::Object" or type_name == "cstr?" or type_name == "py::Object?" or pymodule_is_optional_scalar_type(type_name)




def pymodule_error_decl_in(declarations: darray[Ast::Decl]&, wanted: sview) -> Ast::Decl? can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |wanted|:
        if declaration is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            return declaration if error_name == wanted
        if declaration is Decl.Module(error_module_name, error_module_body, error_module_pos):
            nested: Ast::Decl? = pymodule_error_decl_in(error_module_body, wanted)
            return nested if nested != null
        if declaration is Decl.Scoped(error_scope_body, error_scope_pos):
            nested_scoped: Ast::Decl? = pymodule_error_decl_in(error_scope_body, wanted)
            return nested_scoped if nested_scoped != null
    return null




def pymodule_error_payload_is_structured_in(declarations: darray[Ast::Decl]&, wanted: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |wanted|:
        if declaration is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            if error_name == wanted:
                field_total: mutable usize = 0
                for variant in error_variants:
                    field_total <- field_total + variant.fields.count
                return field_total > 1.usize()
        if declaration is Decl.Module(error_module_name, error_module_body, error_module_pos):
            true return if pymodule_error_payload_is_structured_in(error_module_body, wanted)
        if declaration is Decl.Scoped(error_scope_body, error_scope_pos):
            true return if pymodule_error_payload_is_structured_in(error_scope_body, wanted)
    return false




def pymodule_error_payload_structured_supported_in(file: Ast::File&, declarations: darray[Ast::Decl]&, wanted: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |wanted|:
        if declaration is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            if error_name == wanted:
                field_total: mutable usize = 0
                for variant in error_variants:
                    for field in variant.fields:
                        field_type_name: sview = pymodule_alias_type_name(file, field)
                        return false if not pymodule_error_payload_supported(file, field_type_name)
                        field_total <- field_total + 1.usize()
                return field_total > 1.usize()
        if declaration is Decl.Module(error_module_name, error_module_body, error_module_pos):
            true return if pymodule_error_payload_structured_supported_in(file, error_module_body, wanted)
        if declaration is Decl.Scoped(error_scope_body, error_scope_pos):
            true return if pymodule_error_payload_structured_supported_in(file, error_scope_body, wanted)
    return false




def pymodule_error_payload_needs_arena_in(file: Ast::File&, declarations: darray[Ast::Decl]&, wanted: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |wanted|:
        if declaration is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            if error_name == wanted:
                for variant in error_variants:
                    for field in variant.fields:
                        field_type_name: sview = pymodule_alias_type_name(file, field)
                        return true if pymodule_is_darray_type(field_type_name) or pymodule_is_view_type(field_type_name) or pymodule_is_dict_type(field_type_name) or pymodule_is_set_type(field_type_name)
                return false
        if declaration is Decl.Module(error_module_name, error_module_body, error_module_pos):
            true return if pymodule_error_payload_needs_arena_in(file, error_module_body, wanted)
        if declaration is Decl.Scoped(error_scope_body, error_scope_pos):
            true return if pymodule_error_payload_needs_arena_in(file, error_scope_body, wanted)
    return false




# Struct payloads borrow text/list storage from struct argument arenas. They do not change the
# native function's ABI to add an arena parameter, but their Python conversion must still happen
# before the ordinary argument cleanup releases that storage.
def pymodule_error_payload_contains_struct_in(file: Ast::File&, declarations: darray[Ast::Decl]&, wanted: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |file, wanted|:
        if declaration is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            if error_name == wanted:
                for variant in error_variants:
                    for field in variant.fields:
                        true return if pymodule_struct_return_supported(file, pymodule_alias_type_name(file, field))
                return false
        if declaration is Decl.Module(error_module_name, error_module_body, error_module_pos):
            true return if pymodule_error_payload_contains_struct_in(file, error_module_body, wanted)
        if declaration is Decl.Scoped(error_scope_body, error_scope_pos):
            true return if pymodule_error_payload_contains_struct_in(file, error_scope_body, wanted)
    return false




def emit_pymodule_error_payload_manifest(buffer: mutable darray[u8]&, file: Ast::File&, declarations: darray[Ast::Decl]&, wanted: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    # Keep the manifest's structured payload contract source-shaped: each active variant
    # declares its own fields and concrete Elisa type spellings. The generated C bridge still
    # remains the ABI authority; this metadata is for IDEs, stub generators, and documentation.
    for declaration in declarations |buffer, wanted|:
        if declaration is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            continue if error_name != wanted
            first_variant: mutable bool = true
            for variant in error_variants |buffer, first_variant|:
                emit_tokens_push_sview(buffer, ",") if not first_variant
                emit_tokens_push_sview(buffer, "{\"name\": \"")
                emit_tokens_push_sview(buffer, variant.name)
                emit_tokens_push_sview(buffer, "\", \"fields\": [")
                first_field: mutable bool = true
                for field_index in 0..<variant.fields.count |buffer, first_field, variant|:
                    emit_tokens_push_sview(buffer, ",") if not first_field
                    emit_tokens_push_sview(buffer, "{\"name\": \"")
                    if field_index < variant.field_names.count and variant.field_names[field_index] != "":
                        emit_tokens_push_sview(buffer, variant.field_names[field_index])
                    else:
                        emit_tokens_push_sview(buffer, "field_")
                        append_decimal(buffer, field_index.i64())
                    emit_tokens_push_sview(buffer, "\", \"type\": \"")
                    emit_tokens_push_sview(buffer, pymodule_alias_type_name(file, variant.fields[field_index]))
                    emit_tokens_push_sview(buffer, "\"}")
                    first_field <- false
                emit_tokens_push_sview(buffer, "]}")
                first_variant <- false
            return true
        if declaration is Decl.Module(error_module_name, error_module_body, error_module_pos):
            true return if emit_pymodule_error_payload_manifest(buffer, file, error_module_body, wanted)
        if declaration is Decl.Scoped(error_scope_body, error_scope_pos):
            true return if emit_pymodule_error_payload_manifest(buffer, file, error_scope_body, wanted)
    return false




def emit_pymodule_error_payload_struct_typedef(buffer: mutable darray[u8]&, file: Ast::File&, declarations: darray[Ast::Decl]&, error_family: sview) -> void can[Abort.Panic, Memory.Allocate]:
    declaration: Ast::Decl? = pymodule_error_decl_in(declarations, error_family)
    if declaration is target:
        if target is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            emit_tokens_push_sview(buffer, "typedef struct { int32_t tag; ")
            field_index: mutable usize = 0.usize()
            for variant in error_variants |buffer, field_index|:
                for field in variant.fields |buffer, field_index|:
                    field_type_name: sview = pymodule_alias_type_name(file, field)
                    field_c_type_name: mutable sview = pymodule_c_type_name(field_type_name)
                    field_c_type_name <- field_type_name if field_c_type_name == "" and pymodule_struct_return_supported(file, field_type_name)
                    emit_tokens_push_sview(buffer, field_c_type_name)
                    emit_tokens_push_sview(buffer, " field_")
                    append_decimal(buffer, field_index.i64())
                    emit_tokens_push_sview(buffer, "; ")
                    field_index <- field_index + 1.usize()
            emit_tokens_push_sview(buffer, "} ElisaPymoduleErrorPayload_")
            emit_tokens_push_sview(buffer, error_family)
            emit_tokens_push_sview(buffer, ";\n")




# Nested darray error payloads use the same owning Python list representation as ordinary
# top-level nested darray returns. Keep the helper names leaf-based so multiple error sets that
# use the same nested element share one static converter in the generated extension.
def pymodule_error_nested_darray_helper_name(element_name: sview) -> sview can[Abort.Panic]:
    "i8" return if element_name == "i8"
    "i16" return if element_name == "i16"
    "i32" return if element_name == "i32"
    "i64" return if element_name == "i64"
    "int" return if element_name == "int"
    "isize" return if element_name == "isize"
    "char" return if element_name == "char"
    "u8" return if element_name == "u8"
    "u16" return if element_name == "u16"
    "u32" return if element_name == "u32"
    "u64" return if element_name == "u64"
    "usize" return if element_name == "usize"
    "uintptr" return if element_name == "uintptr"
    "f32" return if element_name == "f32"
    "f64" return if element_name == "f64"
    "bool" return if element_name == "bool"
    "cstr" return if element_name == "cstr"
    "cstr_optional" return if element_name == "cstr?"
    "sview" return if element_name == "sview"
    "sview_optional" return if element_name == "sview?"
    "object" return if element_name == "py::Object"
    "object_optional" return if element_name == "py::Object?"
    "i8_optional" return if element_name == "i8?"
    "i16_optional" return if element_name == "i16?"
    "i32_optional" return if element_name == "i32?"
    "i64_optional" return if element_name == "i64?"
    "int_optional" return if element_name == "int?"
    "isize_optional" return if element_name == "isize?"
    "char_optional" return if element_name == "char?"
    "u8_optional" return if element_name == "u8?"
    "u16_optional" return if element_name == "u16?"
    "u32_optional" return if element_name == "u32?"
    "u64_optional" return if element_name == "u64?"
    "usize_optional" return if element_name == "usize?"
    "uintptr_optional" return if element_name == "uintptr?"
    "bool_optional" return if element_name == "bool?"
    "f32_optional" return if element_name == "f32?"
    "f64_optional" return if element_name == "f64?"
    return ""




def pymodule_error_nested_darray_supported(type_name: sview) -> bool can[Abort.Panic]:
    depth: usize = pymodule_darray_nesting_depth(type_name)
    return false if depth < 2.usize() or depth > 8.usize()
    return pymodule_error_nested_darray_helper_name(pymodule_darray_leaf_name(type_name)) != ""




def pymodule_error_nested_darray_helper_suffix(type_name: sview, storage: mutable darray[u8]&) -> sview can[Abort.Panic, Memory.Allocate]:
    leaf_suffix: sview = pymodule_error_nested_darray_helper_name(pymodule_darray_leaf_name(type_name))
    return "" if leaf_suffix == ""
    for suffix_index in 0..<sview_len(leaf_suffix) |storage, leaf_suffix, suffix_index|:
        storage.push(sview_at(leaf_suffix, suffix_index))
    depth: usize = pymodule_darray_nesting_depth(type_name)
    if depth > 2.usize():
        emit_tokens_push_sview(storage, "_d")
        append_decimal(storage, depth.u32())
    return sview(&storage[0], 0, storage.count)




def pymodule_error_nested_dict_helper_suffix(type_name: sview, storage: mutable darray[u8]&) -> sview can[Abort.Panic, Memory.Allocate]:
    value_name: sview = pymodule_dict_value_name(type_name)
    if pymodule_is_dict_type(value_name):
        # Nested dictionary error payloads share the ordinary recursive dictionary copier. Use
        # the complete inner spelling as a C-safe suffix so different key/value combinations do
        # not collide while identical inner maps can reuse one generated helper.
        for type_index in 0..<sview_len(value_name) |storage, value_name, type_index|:
            byte: u8 = sview_at(value_name, type_index)
            if (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95:
                storage.push(byte)
            else:
                storage.push(95)
        return sview(&storage[0], 0, storage.count)
    if pymodule_is_darray_type(value_name):
        if pymodule_darray_nesting_depth(value_name) >= 2.usize():
            return pymodule_error_nested_darray_helper_suffix(value_name, storage)
        # A one-dimensional list of a named record needs a small struct-list copier; scalar/text
        # darray values already have direct dictionary conversion branches and need no helper.
        if pymodule_darray_c_element_type(pymodule_darray_element_name(value_name)) == "":
            for type_index in 0..<sview_len(value_name) |storage, value_name, type_index|:
                byte: u8 = sview_at(value_name, type_index)
                if (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95:
                    storage.push(byte)
                else:
                    storage.push(95)
            return sview(&storage[0], 0, storage.count)
    if pymodule_is_view_type(value_name) and pymodule_darray_c_element_type(pymodule_view_element_name(value_name)) == "":
        for type_index in 0..<sview_len(value_name) |storage, value_name, type_index|:
            byte: u8 = sview_at(value_name, type_index)
            if (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95:
                storage.push(byte)
            else:
                storage.push(95)
        return sview(&storage[0], 0, storage.count)
    if pymodule_is_set_type(value_name):
        # Set-valued dictionaries use the same one-column bucket copier as standalone set
        # payloads. Include the complete set spelling in the helper suffix so scalar/text
        # element families cannot collide.
        for type_index in 0..<sview_len(value_name) |storage, value_name, type_index|:
            byte: u8 = sview_at(value_name, type_index)
            if (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95:
                storage.push(byte)
            else:
                storage.push(95)
        return sview(&storage[0], 0, storage.count)
    return ""




def pymodule_error_nested_dict_helper_name(type_name: sview, storage: mutable darray[u8]&) -> sview can[Abort.Panic, Memory.Allocate]:
    suffix_storage: mutable darray[u8] = []
    suffix: sview = pymodule_error_nested_dict_helper_suffix(type_name, &suffix_storage)
    return "" if suffix == "" else emit_pymodule_error_nested_dict_helper_name(storage, suffix)




def emit_pymodule_error_nested_dict_helper_name(storage: mutable darray[u8]&, suffix: sview) -> sview can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(storage, "elisa_pymodule_error_dict_nested_")
    emit_tokens_push_sview(storage, suffix)
    emit_tokens_push_sview(storage, "_to_py")
    return sview(&storage[0], 0, storage.count)




def pymodule_error_darray_dict_helper_name(type_name: sview, storage: mutable darray[u8]&, element: bool) -> sview can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(storage, "elisa_pymodule_error_darray_dict_")
    for type_index in 0..<sview_len(type_name) |storage, type_name, type_index|:
        byte: u8 = sview_at(type_name, type_index)
        if (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95:
            storage.push(byte)
        else:
            storage.push(95)
    emit_tokens_push_sview(storage, "_element_to_py") if element else emit_tokens_push_sview(storage, "_to_py")
    return sview(&storage[0], 0, storage.count)




def pymodule_error_named_aggregate_helper_name(type_name: sview, storage: mutable darray[u8]&) -> sview can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(storage, "elisa_pymodule_error_named_aggregate_")
    for type_index in 0..<sview_len(type_name) |storage, type_name, type_index|:
        byte: u8 = sview_at(type_name, type_index)
        if (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95:
            storage.push(byte)
        else:
            storage.push(95)
    emit_tokens_push_sview(storage, "_to_py")
    return sview(&storage[0], 0, storage.count)




def emit_pymodule_error_darray_dict_output_helper(buffer: mutable darray[u8]&, file: Ast::File&, type_name: sview) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    element_name: sview = pymodule_darray_element_name(type_name)
    element_helper_storage: mutable darray[u8] = []
    element_helper: sview = pymodule_error_darray_dict_helper_name(type_name, &element_helper_storage, true)
    emit_pymodule_composed_dict_output_helper(buffer, file, element_helper, element_name)
    list_helper_storage: mutable darray[u8] = []
    list_helper: sview = pymodule_error_darray_dict_helper_name(type_name, &list_helper_storage, false)
    emit_tokens_push_sview(buffer, "static PyObject *")
    emit_tokens_push_sview(buffer, list_helper)
    emit_tokens_push_sview(buffer, "(ElisaDArray input) { if (input.count < 0 || input.capacity < 0 || input.count > input.capacity || input.count > (int64_t)PY_SSIZE_T_MAX || input.capacity > (int64_t)PY_SSIZE_T_MAX || (input.count > 0 && input.items == NULL)) { PyErr_SetString(PyExc_RuntimeError, \"native darray dictionary payload has invalid storage\"); return NULL; } PyObject *out = PyList_New((Py_ssize_t)input.count); if (out == NULL) return NULL; for (Py_ssize_t index = 0; index < (Py_ssize_t)input.count; ++index) { PyObject *item = ")
    emit_tokens_push_sview(buffer, element_helper)
    emit_tokens_push_sview(buffer, "(((ElisaDict *)input.items)[index]); if (item == NULL) { Py_DECREF(out); return NULL; } PyList_SET_ITEM(out, index, item); } return out; }\n")




# A view pushed into the `emitted` dedup list must not borrow per-iteration storage:
# the list outlives every loop body below, later iterations memcmp the pushed bytes,
# and three sites pushed views into loop-local suffix buffers. The old allocator made
# that survivable by accident — the reclaimed bytes stayed intact long enough — and
# the arena quarantine (mprotect on freed regions) turned the same reads into SIGBUS
# inside this function, which is how the pymodule-c gate crash was traced here. Copy
# the suffix into the PERMANENT arena: a handful of short helper names per module, so
# the deliberate leak is bounded and tiny.
def pymodule_stable_suffix(text: sview) -> sview can[Abort.Panic, Memory.Allocate]:
    length: usize = sview_len(text)
    return text if length == 0
    copy_storage: mutable darray[u8] = []
    for index in 0..<length |copy_storage, text|:
        copy_storage.push(sview_at(text, index))
    stable: mutable heap void& = alloc_perm(length.i64())
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.RawExtern:
        trusted [Unsafe.PointerCast, Unsafe.RawExtern]:
            _ = memcpy(stable, (&copy_storage[0]).cast[void&], length)
            return sview(stable.cast[u8&], 0, length.i64())
