                buffer.push(2)
                ir_field_desc_out(buffer, 7, "Offset")
                buffer.push(2)
                # File (type 66)
                ir_uvarint_out(buffer, 66)
                ir_str_out(buffer, "File")
                ir_uvarint_out(buffer, 3)
                ir_field_desc_out(buffer, 1, "DeclVisibility")
                buffer.push(6)
                buffer.push(4)
                buffer.push(3)
                ir_field_desc_out(buffer, 2, "Decls")
                buffer.push(5)
                buffer.push(4)
                ir_field_desc_out(buffer, 3, "Filename")
