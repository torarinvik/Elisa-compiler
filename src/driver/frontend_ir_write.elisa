# Writing stage0's frontend IR bundle (`.elisair`, format v2).
#
# The reader lives in `frontend_ir.elisa`; this is the other direction, and it is
# the harder one. A reader may skip what it does not model — the format is built
# for that. A WRITER cannot: whatever it emits is claimed to be the program.
#
# So the rule here is REFUSE BY NAME. Every construct stage1's AST cannot map onto
# exactly one stage0 node records a refusal naming the construct, and the driver
# prints it and exits non-zero. A bundle that decodes cleanly but describes a
# different program is the failure this format makes easy to produce, and the
# only defence is declining to guess.
#
# Why a writer is possible at all: the v2 decoder reconciles the file's type table
# with its own schema BY NAME (`codec_decode.go`), and numeric IDs are file-local.
# So this file only has to spell stage0's type and field names correctly. The IDs
# below are stage0's own, taken from its committed registry, purely so the two
# read alike.
#
# The oracle is exact and covers the whole tree:
#
#     elisac -emit lowered BUNDLE   ==   elisac -emit lowered SOURCE
#
# stage0 UNPARSES the tree it decoded, so a single wrong node type, field name or
# nesting shows up as a textual diff of the program. See `test/parity/ir_writer_smoke.sh`.

module IrWrite:
    private:
        # The walk threads four plain out-parameters rather than a state struct:
        # `bodies` (node bodies, each already length-prefixed, in table order; node IDs
        # are 1-based indices into it), `nodes` (how many), `refusal`, and per-node a
        # (`fields`, `live`) pair. A `mutable Struct&` holding darrays cannot infer a
        # region for them — the same constraint that makes project.elisa's StrList
        # mutators `lmut` — and threading `lmut` through a recursive tree walk would put
        # an assignment on every call. Bare `mutable darray[u8]&` has neither problem.

        def ir_uvarint_out(buffer: mutable darray[u8]&, value: u64) -> void:
            can Memory.Allocate, Abort.Panic:
                remaining: mutable u64 = value
                while true |buffer, remaining|:
                    chunk: u8 = (remaining & 0x7f).u8()
                    remaining <- remaining >> 7
                    if remaining == 0:
                        buffer.push(chunk)
                        return
                    buffer.push(chunk | 0x80)

        # Signed values are zigzagged, low bit carrying the sign.
        def ir_varint_out(buffer: mutable darray[u8]&, value: i64) -> void:
            can Memory.Allocate, Abort.Panic:
                zigzag: u64 = ((0 - value).u64() << 1) - 1 if value < 0 else (value.u64() << 1)
                ir_uvarint_out(buffer, zigzag)

        def ir_str_out(buffer: mutable darray[u8]&, text: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                ir_uvarint_out(buffer, sview_len(text).u64())
                buffer.extend(text)

        def ir_blob_out(buffer: mutable darray[u8]&, data: darray[u8]&) -> void:
            can Memory.Allocate, Abort.Panic:
                ir_uvarint_out(buffer, data.count.u64())
                for byte in data |buffer|:
                    buffer.push(byte)

        # A field's header. The value DESCRIPTOR that follows is written by the caller
        # as raw bytes (and, for an inline struct, its type name), because a descriptor
        # is a nested shape rather than a fixed-width value.
        def ir_field_desc_out(buffer: mutable darray[u8]&, field_id: u64, name: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                ir_uvarint_out(buffer, field_id)
                ir_str_out(buffer, name)

        # ---- field accumulation -------------------------------------------------
        #
        # Fields at their zero value are OMITTED, as stage0's encoder omits them; a
        # decoder leaves them zero. Each `ir_put_*` therefore returns early on a zero
        # payload rather than writing an empty field.

        def ir_put_bool(fields: mutable darray[u8]&, live: mutable u32&, field_id: u64, value: bool) -> void:
            can Memory.Allocate, Abort.Panic:
                return if not value
                ir_uvarint_out(fields, field_id)
                ir_uvarint_out(fields, 1)
                fields.push(1)
                live <- live + 1

        def ir_put_int(fields: mutable darray[u8]&, live: mutable u32&, field_id: u64, value: i64) -> void:
            can Memory.Allocate, Abort.Panic:
                return if value == 0
                payload: mutable darray[u8] = []
                ir_varint_out(&payload, value)
                ir_uvarint_out(fields, field_id)
                ir_blob_out(fields, payload)
                live <- live + 1

        def ir_put_str(fields: mutable darray[u8]&, live: mutable u32&, field_id: u64, text: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                return if sview_len(text) == 0
                payload: mutable darray[u8] = []
                ir_str_out(&payload, text)
                ir_uvarint_out(fields, field_id)
                ir_blob_out(fields, payload)
                live <- live + 1

        # A node reference is a uvarint table index; 0 is null and is omitted.
        def ir_put_node(fields: mutable darray[u8]&, live: mutable u32&, field_id: u64, node_id: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                return if node_id == 0
                payload: mutable darray[u8] = []
                ir_uvarint_out(&payload, node_id.u64())
                ir_uvarint_out(fields, field_id)
                ir_blob_out(fields, payload)
                live <- live + 1

        def ir_put_node_list(fields: mutable darray[u8]&, live: mutable u32&, field_id: u64, node_ids: darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if node_ids.count == 0
                payload: mutable darray[u8] = []
                ir_uvarint_out(&payload, node_ids.count.u64())
                for node_id in node_ids |payload|:
                    ir_uvarint_out(&payload, node_id.u64())
                ir_uvarint_out(fields, field_id)
                ir_blob_out(fields, payload)
                live <- live + 1

        # An already-built payload (an inline struct, or a list of them).
        def ir_put_raw(fields: mutable darray[u8]&, live: mutable u32&, field_id: u64, payload: darray[u8]&) -> void:
            can Memory.Allocate, Abort.Panic:
                return if payload.count == 0
                ir_uvarint_out(fields, field_id)
                ir_blob_out(fields, payload)
                live <- live + 1

        # Frame the accumulated fields as a node body and append it to the table.
        # Returns the new node's 1-based ID.
        def ir_emit_node(bodies: mutable darray[u8]&, nodes: mutable u32&, type_id: u64, fields: darray[u8]&, live: u32) -> u32:
            can Memory.Allocate, Abort.Panic:
                body: mutable darray[u8] = []
                ir_uvarint_out(&body, type_id)
                ir_uvarint_out(&body, live.u64())
                for byte in fields |body|:
                    body.push(byte)
                ir_blob_out(bodies, body)
                nodes <- nodes + 1
                return nodes

        # Does the source open a line with `using`? Only a line-leading keyword counts,
        # so the word inside a comment, a string or an identifier does not trip it.
        def ir_source_unmodelled(source: sview) -> sview:
            can Abort.Panic:
                length: i64 = sview_len(source).i64()
                at_line_start: mutable bool = true
                index: mutable i64 = 0
                while index < length |index, at_line_start, source|:
                    byte: u8 = sview_at(source, index)
                    if byte == 10:
                        at_line_start <- true
                        index <- index + 1
                        continue
                    if byte == 32 or byte == 9:
                        index <- index + 1
                        continue
                    if at_line_start and index + 6 <= length:
                        matched: mutable bool = true
                        keyword: sview = "using "
                        for offset in 0..<6 |matched, source, index, keyword|:
                            matched <- false if sview_at(source, index + offset) != sview_at(keyword, offset)
                        "`using` (consumed by the parser, absent from the AST)" return if matched
                    # `def name[T](…)`: the GENERIC PARAMETER list is consumed by the
                    # parser and absent from `Decl.Func`, so a signature rebuilt from the
                    # AST would drop `[T]` silently.
                    if at_line_start and index + 4 <= length and sview_at(source, index) == 100 and sview_at(source, index + 1) == 101 and sview_at(source, index + 2) == 102 and sview_at(source, index + 3) == 32:
                        scan: mutable i64 = index + 4
                        while scan < length |scan, source|:
                            break if sview_at(source, scan) == 40 or sview_at(source, scan) == 91 or sview_at(source, scan) == 10
                            scan <- scan + 1
                        "generic parameter list (consumed by the parser, absent from Decl.Func)" return if scan < length and sview_at(source, scan) == 91
                    at_line_start <- false
                    index <- index + 1
                return ""

        def ir_refuse(refusal: mutable darray[u8]&, construct: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                return if refusal.count != 0
                refusal.extend(construct)
        # GENERATED — do not edit. Rewritten by `bash scripts/gen_ir_type_table.sh`,
        # which reads stage0's frontendir schema so the wire kinds cannot drift.
        def ir_write_type_table(buffer: mutable darray[u8]&) -> void:
            can Memory.Allocate, Abort.Panic:
                ir_uvarint_out(buffer, 70)
                # lexer.Pos (type 278)
                ir_uvarint_out(buffer, 278)
                ir_str_out(buffer, "lexer.Pos")
                ir_uvarint_out(buffer, 7)
                ir_field_desc_out(buffer, 1, "Col")
                buffer.push(2)
                ir_field_desc_out(buffer, 2, "EndCol")
                buffer.push(2)
                ir_field_desc_out(buffer, 3, "EndLine")
                buffer.push(2)
                ir_field_desc_out(buffer, 4, "EndOffset")
