# `-emit pymodule` — materializing a Python iterable into the native open-addressing DynSet
# header, plus the struct-field forms that reuse the dict and set bridges inside a record.


# Reuse the ordinary dict bridge inside a named-struct field. The generated setup is written
# against the synthetic `arg0` names first, then retargeted to the struct's shared arena and
# field object. Keeping this transformation here avoids maintaining a second, subtly different
# dictionary conversion implementation.
def emit_pymodule_struct_dict_field_py_to_c(buffer: mutable darray[u8]&, field_type_name: sview, field_name: sview, nested_value_helper: sview = "") -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    snippet: mutable darray[u8] = []
    empty_params: darray[Ast::ParamDecl] = []
    emit_pymodule_dict_input_setup(&snippet, empty_params, field_type_name, 0.usize(), nested_value_helper)
    pymodule_replace_generated(&snippet, "ElisaPyRefs arg0_struct_refs = (ElisaPyRefs){0};", "")
    pymodule_replace_generated(&snippet, "&arg0_struct_refs", "refs")
    # The field converter borrows the enclosing struct's arena.  Do not free that shared arena
    # (or release the same refs table twice) on a field-local error; the enclosing wrapper owns
    # both lifetimes and will perform the single final cleanup.
    pymodule_replace_generated(&snippet, "arena_free(&arg0_arena);", "")
    pymodule_replace_generated(&snippet, "&arg0_arena", "arena")
    # Hoist the copied mapping pointer so every transformed failure path can release it safely.
    pymodule_replace_generated(&snippet, "PyObject *arg0_owned = ", "arg0_owned = ")
    pymodule_replace_generated(&snippet, "return NULL;", "return -1;")
    pymodule_replace_generated(&snippet, "return -1;", "do { Py_XDECREF(arg0_owned); Py_DECREF(field_obj); return -1; } while (0);")
    emit_tokens_push_sview(buffer, "PyObject *arg0 = field_obj; PyObject *arg0_owned = NULL;\n")
    for snippet_index in 0..<snippet.count |buffer, snippet|:
        buffer.push(snippet[snippet_index])
    emit_tokens_push_sview(buffer, "if (elisa_pymodule_retain(arg0, refs) < 0) { Py_DECREF(arg0); Py_DECREF(field_obj); return -1; } out->")
    emit_tokens_push_sview(buffer, field_name)
    emit_tokens_push_sview(buffer, " = arg0_value; Py_DECREF(arg0); ")




# Materialize a Python iterable into the native open-addressing DynSet header. The owned
# Python set keeps Unicode objects alive while native cstr keys borrow their UTF-8 storage;
# the temporary arena owns only the bucket storage, and both are released by the shared
# dictionary/set cleanup helpers after the native call.
def emit_pymodule_set_iter_cleanup(buffer: mutable darray[u8]&, parameter_index: usize, indent: sview) -> void can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(buffer, indent)
    emit_tokens_push_sview(buffer, "Py_DECREF(arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_item); Py_DECREF(arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_iter);\n")




