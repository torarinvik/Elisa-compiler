def emit_pymodule_struct_set_field_py_to_c(buffer: mutable darray[u8]&, field_type_name: sview, field_name: sview) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    snippet: mutable darray[u8] = []
    empty_params: darray[Ast::ParamDecl] = []
    emit_pymodule_set_input_setup(&snippet, empty_params, field_type_name, 0.usize())
    pymodule_replace_generated(&snippet, "arena_free(&arg0_arena);", "")
    pymodule_replace_generated(&snippet, "&arg0_arena", "arena")
    # Hoist the copied set pointer so every transformed failure path releases it safely.
    pymodule_replace_generated(&snippet, "PyObject *arg0_owned = ", "arg0_owned = ")
