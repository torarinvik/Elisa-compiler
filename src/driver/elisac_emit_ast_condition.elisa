# Stage0's compact expression printer uses <expr> for floating literals.
# Preserve the rest of the condition while matching that representation.
def emit_ast_compact_condition(expression: Ast::Expr, depth: u32 = 0) -> Ast::Expr can[Abort.Panic, Memory.Allocate]:
    return expression if depth >= 1000
    match expression:
        Ast::Expr.FloatLit(_, pos):
            return (Ast::Expr.Ident("<expr>", pos))
        Ast::Expr.Binary(left, operator, right, pos):
            return (Ast::Expr.Binary(emit_ast_compact_condition(left, depth + 1), operator, emit_ast_compact_condition(right, depth + 1), pos))
        Ast::Expr.Unary(operator, operand, pos):
            return (Ast::Expr.Unary(operator, emit_ast_compact_condition(operand, depth + 1), pos))
        Ast::Expr.Paren(inner, pos):
            return (Ast::Expr.Paren(emit_ast_compact_condition(inner, depth + 1), pos))
        _:
            return expression
