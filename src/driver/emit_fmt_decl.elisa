# `-emit fmt` — WHOLE-FILE and DECLARATION assembly: each declaration prints its header line
# gap-rendered from the token stream and its body from the AST, with enum and struct bodies
# copied verbatim in normalized indentation. Continues emit_fmt_expr.elisa.

extend FmtUnparse:
    public:

        # Stacked decorator lines (`@intrusive`) directly above declaration line LINE,
        # rendered verbatim in top-down order. A line qualifies when its first token is
        # `@`; the walk extends upward through a contiguous run of such lines.
        def fmt_struct_decorator_lines(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32, offset: u32, indent: i64) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                fmt_dl_first: mutable u32 = line
                fmt_dl_scanning: mutable bool = true
                while fmt_dl_scanning and fmt_dl_first > 1 |fmt_dl_first, fmt_dl_scanning, tokens|:
                    fmt_dl_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, fmt_dl_first - 1)
                    if fmt_dl_range.found and tokens[fmt_dl_range.start].kind == Lexer::TokenKind.At:
                        fmt_dl_first <- fmt_dl_first - 1
                    else:
                        fmt_dl_scanning <- false
                for fmt_dl_line in fmt_dl_first..<line |buffer, tokens, source, indent|:
                    fmt_dl_render: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, fmt_dl_line)
                    continue if not fmt_dl_render.found
                    continue if tokens[fmt_dl_render.start].kind != Lexer::TokenKind.At
                    fmt_indent(buffer, indent)
                    emit_iface_render_tokens(buffer, tokens, source, fmt_dl_render.start, fmt_dl_render.stop)
                    fmt_push(buffer, "\n")



        # Whole-file assembly: each function prints its header LINE (gap-rendered from
        # the declaration tokens — normalized source spelling) and its body through
        # fmt_stmts; declarations separate with single blank lines. Non-function decls
        # reuse the header line render; a body containing any sentinel marker keeps the
        # file honest rather than approximated.
        def fmt_file(buffer: mutable darray[u8]&, file: Ast::File&, tokens: darray[Lexer::Token]&, source: u8&) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                # `-emit fmt` prints NO inferred region params (stage0's fmt never does); doc, which
                # renders declarations through fmt_decl too, KEEPS them -- so the flag is raised here only.
                emit_suppress_inferred_regions <- true
                # `using` declarations live only in the annotation side-table (parser
                # markers `__using` / `__using_alias_target`); stage0 keeps them as real
                # decls and prints `using TARGET` in line order among the others. Collect
                # (target, line) in parse order — ascending lines — and interleave.
                fmt_us_targets: mutable darray[sview] = []
                fmt_us_lines: mutable darray[u32] = []
                fmt_us_offsets: mutable darray[u32] = []
                for fmt_us_annotation in file.enum_annotations |fmt_us_targets, fmt_us_lines, fmt_us_offsets, file|:
                    if fmt_us_annotation.name == "__using_alias_target":
                        fmt_us_targets.push(fmt_us_annotation.owner)
                        fmt_us_lines.push(fmt_us_annotation.line)
                        fmt_us_offsets.push(fmt_us_annotation.offset)
                    elif fmt_us_annotation.name == "__using":
                        fmt_us_aliased: mutable bool = false
                        for fmt_us_probe in file.enum_annotations |fmt_us_aliased, fmt_us_annotation|:
                            fmt_us_aliased <- true if fmt_us_probe.name == "__using_alias_target" and fmt_us_probe.owner == fmt_us_annotation.owner
                        if not fmt_us_aliased:
                            fmt_us_targets.push(fmt_us_annotation.owner)
                            fmt_us_lines.push(fmt_us_annotation.line)
                            fmt_us_offsets.push(fmt_us_annotation.offset)
                fmt_us_next: mutable usize = 0
                fmt_first_decl: mutable bool = true
                fmt_prev_scoped: mutable bool = false
                for fmt_declaration in file.top_decls |buffer, tokens, source, fmt_first_decl, fmt_prev_scoped, fmt_us_next, fmt_us_targets, fmt_us_lines|:
                    fmt_ff_decl_line: u32 = ast_decl_line(fmt_declaration)
                    fmt_ff_decl_offset: u32 = ast_decl_offset(fmt_declaration)
                    while fmt_us_next < fmt_us_lines.count and fmt_using_precedes(fmt_us_lines[fmt_us_next], fmt_us_offsets[fmt_us_next], fmt_ff_decl_line, fmt_ff_decl_offset) |buffer, fmt_first_decl, fmt_prev_scoped, fmt_us_next, fmt_us_targets, fmt_us_lines, fmt_us_offsets, fmt_ff_decl_offset|:
                        fmt_push(buffer, "\n") if not fmt_first_decl
                        fmt_first_decl <- false
                        fmt_prev_scoped <- false
                        fmt_push(buffer, "using ")
                        fmt_push(buffer, fmt_us_targets[fmt_us_next])
                        fmt_push(buffer, "\n")
                        fmt_us_next <- fmt_us_next + 1
                    # A static if/elif/else CHAIN is ONE decl in stage0, so its branches
                    # print contiguously — but stage1's parser splits them into separate
                    # top-level Scoped decls. Suppress the separator only for a CHAIN
                    # CONTINUATION (`static elif` / `static else`): a fresh `static if`
                    # right after another chain is a new decl and keeps its blank line, as
                    # does an `impl` body, which is the same node kind.
                    fmt_cur_scoped: mutable bool = false
                    fmt_cur_continues: mutable bool = false
                    if fmt_declaration is Decl.Scoped(fmt_ff_body, fmt_ff_line):
                        fmt_ff_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, fmt_ff_line.line, fmt_ff_line.offset)
                        if fmt_ff_range.found:
                            fmt_cur_scoped <- tokens[fmt_ff_range.start].kind == Lexer::TokenKind.Static
                            if fmt_cur_scoped and fmt_ff_range.start + 1 < tokens.count:
                                fmt_ff_second: Lexer::TokenKind = tokens[fmt_ff_range.start + 1].kind
                                fmt_cur_continues <- fmt_ff_second == Lexer::TokenKind.Elif or fmt_ff_second == Lexer::TokenKind.Else
                    fmt_push(buffer, "\n") if not fmt_first_decl and not (fmt_prev_scoped and fmt_cur_continues)
                    fmt_first_decl <- false
                    fmt_prev_scoped <- fmt_cur_scoped
                    fmt_decl(buffer, fmt_declaration, tokens, source, 0)
                while fmt_us_next < fmt_us_lines.count |buffer, fmt_first_decl, fmt_us_next, fmt_us_targets, fmt_us_lines|:
                    fmt_push(buffer, "\n") if not fmt_first_decl
                    fmt_first_decl <- false
                    fmt_push(buffer, "using ")
                    fmt_push(buffer, fmt_us_targets[fmt_us_next])
                    fmt_push(buffer, "\n")
                    fmt_us_next <- fmt_us_next + 1



        def fmt_decl(buffer: mutable darray[u8]&, declaration: Ast::Decl, tokens: darray[Lexer::Token]&, source: u8&, indent: i64) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                if declaration is Decl.Func(fmt_fd_name, fmt_fd_params, fmt_fd_ret, fmt_fd_body, fmt_fd_effects, fmt_fd_decorators, fmt_fd_line):
                    for fmt_fd_decorator in fmt_fd_decorators |buffer, tokens, source, fmt_fd_line, indent|:
                        fmt_indent(buffer, indent)
                        fmt_push(buffer, "@")
                        fmt_push(buffer, fmt_fd_decorator.name)
                        emit_ast_decorator_args(buffer, tokens, source, fmt_fd_decorator.line, 0)
                        fmt_push(buffer, "\n")
                    # The shared signature renderer weaves stage0's inferred region
                    # params into the header (`def fill[@__rg_out](out: ... @__rg_out&)`).
                    emit_signature_line(buffer, "def ", fmt_fd_name, fmt_fd_line.line, tokens, source, indent, true, true, false, false)
                    fmt_push(buffer, "\n")
                    # `def NAME[` -- a generic def: its body keeps UFCS method calls (see fmt_in_generic_def).
                    fmt_fd_head: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, fmt_fd_line.line, fmt_fd_line.offset)
                    fmt_in_generic_def <- fmt_fd_head.found and fmt_fd_head.start + 2 < tokens.count and tokens[fmt_fd_head.start + 2].kind == Lexer::TokenKind.LBracket
                    # stage0's inference-by-default: a body that allocates a region-less
                    # container, in a function that does NOT thread an allocator itself,
                    # is wrapped in a synthesized lazy region and PRINTED as one.
                    if fmt_body_needs_auto_region(fmt_fd_body, fmt_fd_line.line, fmt_fd_line.offset, tokens, source):
                        fmt_indent(buffer, indent + 4)
                        fmt_push(buffer, "with arena __auto_")
                        fmt_push_decimal(buffer, fmt_auto_region_number(fmt_fd_line.line, fmt_fd_line.offset, tokens))
                        fmt_push(buffer, " as :\n")
                        fmt_stmts(buffer, fmt_fd_body, indent + 8, tokens, source)
                        fmt_in_generic_def <- false
                        return
                    fmt_stmts(buffer, fmt_fd_body, indent + 4, tokens, source)
                    fmt_in_generic_def <- false
                    return
                if declaration is Decl.Struct(fmt_sd_name, fmt_sd_members, fmt_sd_aff, fmt_sd_states, fmt_sd_derive, fmt_sd_inv, fmt_sd_line):
                    # A struct's decorators (`@intrusive`) are not carried on the node —
                    # recover the stacked `@…` lines directly above the header.
                    fmt_struct_decorator_lines(buffer, tokens, source, fmt_sd_line.line, fmt_sd_line.offset, indent)
                    # A declaration nested in a module prints at ITS indent (stage0: `    struct X:` under
                    # `module m:`); the plain printer put the header at column 0 (measured 2026-09-08).
                    fmt_block_from_source_at_indent(buffer, tokens, source, fmt_sd_line.line, fmt_sd_line.offset, indent)
                    return
                if declaration is Decl.Enum(fmt_ed_name, fmt_ed_variants, fmt_ed_const, fmt_ed_storage, fmt_ed_line):
                    fmt_block_from_source_at_indent(buffer, tokens, source, fmt_ed_line.line, fmt_ed_line.offset, indent)
                    return
                if declaration is Decl.Const(fmt_cd_name, fmt_cd_type, fmt_cd_value, fmt_cd_mutable, fmt_cd_line):
                    # `const X[: T] = V`: the head renders from source tokens up to the
                    # `=`, the VALUE through fmt_expr — stage0's exprStr parenthesizes a
                    # binary const value (`(8 * 1024)`), measured on string_escapes.
                    fmt_cd_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, fmt_cd_line.line, fmt_cd_line.offset)
                    if fmt_cd_range.found:
                        fmt_cd_stop: mutable usize = fmt_cd_range.stop
                        fmt_cd_eq: mutable usize = 0
                        fmt_cd_eq_found: mutable bool = false
                        while fmt_cd_stop < tokens.count and tokens[fmt_cd_stop].line == fmt_cd_line.line and tokens[fmt_cd_stop].kind != Lexer::TokenKind.Newline |fmt_cd_stop, fmt_cd_eq, fmt_cd_eq_found, tokens, fmt_cd_line|:
                            if not fmt_cd_eq_found and tokens[fmt_cd_stop].kind == Lexer::TokenKind.Assign:
                                fmt_cd_eq <- fmt_cd_stop
                                fmt_cd_eq_found <- true
                            fmt_cd_stop <- fmt_cd_stop + 1
                        if fmt_cd_eq_found:
                            fmt_indent(buffer, indent)
                            emit_iface_render_tokens(buffer, tokens, source, fmt_cd_range.start, fmt_cd_eq)
                            fmt_push(buffer, " = ")
                            fmt_stmt_line <- fmt_cd_line.line
                            fmt_stmt_offset <- fmt_cd_line.offset
                            fmt_expr(buffer, fmt_cd_value, tokens, source)
                        else:
                            fmt_indent(buffer, indent)
                            emit_iface_render_tokens(buffer, tokens, source, fmt_cd_range.start, fmt_cd_stop)
                        fmt_push(buffer, "\n")
                    return
                if declaration is Decl.Extern(fmt_xd_name, fmt_xd_ps, fmt_xd_ar, fmt_xd_va, fmt_xd_call, fmt_xd_ret, fmt_xd_decorators, fmt_xd_line):
                    for fmt_xd_decorator in fmt_xd_decorators |buffer, tokens, source, fmt_xd_line, indent|:
                        fmt_indent(buffer, indent)
                        fmt_push(buffer, "@")
                        fmt_push(buffer, fmt_xd_decorator.name)
                        emit_ast_decorator_args(buffer, tokens, source, fmt_xd_decorator.line, 0)
                        fmt_push(buffer, "\n")
                    fmt_xd_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, fmt_xd_line.line, fmt_xd_line.offset)
                    if fmt_xd_range.found:
                        # A signature WRAPPED across source lines joins onto one: the span
                        # runs to the first depth-0 Newline (the gap renderer skips the
                        # inner Newline/Indent/Dedent tokens and the line break's
                        # whitespace collapses to the single joining space).
                        fmt_xd_stop: mutable usize = fmt_xd_range.start
                        fmt_xd_depth: mutable i64 = 0
                        fmt_xd_scanning: mutable bool = true
                        while fmt_xd_scanning and fmt_xd_stop < tokens.count |fmt_xd_stop, fmt_xd_depth, fmt_xd_scanning, tokens|:
                            fmt_xd_kind: Lexer::TokenKind = tokens[fmt_xd_stop].kind
                            fmt_xd_depth <- fmt_xd_depth + 1 if fmt_xd_kind == Lexer::TokenKind.LParen or fmt_xd_kind == Lexer::TokenKind.LBracket
                            fmt_xd_depth <- fmt_xd_depth - 1 if fmt_xd_kind == Lexer::TokenKind.RParen or fmt_xd_kind == Lexer::TokenKind.RBracket
                            if fmt_xd_depth == 0 and (fmt_xd_kind == Lexer::TokenKind.Newline or fmt_xd_kind == Lexer::TokenKind.Eof):
                                fmt_xd_scanning <- false
                            else:
                                fmt_xd_stop <- fmt_xd_stop + 1
                        fmt_indent(buffer, indent)
                        emit_iface_render_tokens(buffer, tokens, source, fmt_xd_range.start, fmt_xd_stop)
                        fmt_push(buffer, "\n")
                    return
                if declaration is Decl.Alias(fmt_al_name, fmt_al_target, fmt_al_line):
                    # `type X = T` / `alias X = T` render from the source line — the
                    # keyword spelling lives only there. A `permission`/`effect`/
                    # `protocol` block collapses to this same node with an EMPTY target;
                    # its members exist only in the tokens, so render the whole block.
                    fmt_al_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, fmt_al_line.line, fmt_al_line.offset)
                    if fmt_al_range.found and tokens[fmt_al_range.start].kind == Lexer::TokenKind.Ident:
                        fmt_al_head: sview = Lexer::text_or_empty(tokens[fmt_al_range.start], source)
                        if fmt_al_head == "permission" or fmt_al_head == "effect" or fmt_al_head == "protocol":
                            fmt_block_from_source_at_indent(buffer, tokens, source, fmt_al_line.line, fmt_al_line.offset, indent)
                            return
                    if fmt_al_range.found:
                        fmt_al_stop: mutable usize = fmt_al_range.stop
                        while fmt_al_stop < tokens.count and tokens[fmt_al_stop].line == fmt_al_line.line and tokens[fmt_al_stop].kind != Lexer::TokenKind.Newline |fmt_al_stop, tokens, fmt_al_line|:
                            fmt_al_stop <- fmt_al_stop + 1
                        fmt_indent(buffer, indent)
                        emit_iface_render_tokens(buffer, tokens, source, fmt_al_range.start, fmt_al_stop)
                        fmt_push(buffer, "\n")
                    return
                if declaration is Decl.Module(fmt_md_name, fmt_md_body, fmt_md_line):
                    # `module NAME:` with a BLANK LINE between members (stage0's
                    # NamespaceDecl arm blank-lines every i > 0).
                    fmt_indent(buffer, indent)
                    fmt_push(buffer, "module ")
                    # A qualified header (`module Outer::Inner:`) prints with DOTS.
                    fmt_md_index: mutable usize = 0
                    while fmt_md_index < sview_len(fmt_md_name) |fmt_md_index, buffer, fmt_md_name|:
                        fmt_md_byte: u8 = sview_at(fmt_md_name, fmt_md_index)
                        if fmt_md_byte == 58 and fmt_md_index + 1 < sview_len(fmt_md_name) and sview_at(fmt_md_name, fmt_md_index + 1) == 58:
                            buffer.push(46)
                            fmt_md_index <- fmt_md_index + 2
                        else:
                            buffer.push(fmt_md_byte)
                            fmt_md_index <- fmt_md_index + 1
                    fmt_push(buffer, ":\n")
                    fmt_md_first: mutable bool = true
                    for fmt_md_child in fmt_md_body |buffer, tokens, source, indent, fmt_md_first|:
                        fmt_push(buffer, "\n") if not fmt_md_first
                        fmt_md_first <- false
                        fmt_decl(buffer, fmt_md_child, tokens, source, indent + 4)
                    return
                if declaration is Decl.Scoped(fmt_sc_body, fmt_sc_line):
                    # A `static if/elif/else` BRANCH: header line from the source (the
                    # chain's conditions live only there), then the branch's declarations
                    # at 4-space indent — matching stage0's decl-level chain rendering.
                    fmt_sc_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, fmt_sc_line.line, fmt_sc_line.offset)
                    if fmt_sc_range.found:
                        fmt_indent(buffer, indent)
                        # A `Scoped` node is EITHER a `static if/elif/else` branch OR an
                        # `impl`/`extend` body — the parser collapses both into the same
                        # node. Only the chain form parenthesizes; an impl header renders
                        # verbatim (stage0's ImplDecl arm rebuilds `impl[G] I for T:` from
                        # its parts, which is the source spelling).
                        fmt_sc_is_chain: bool = tokens[fmt_sc_range.start].kind == Lexer::TokenKind.Static
                        if not fmt_sc_is_chain:
                            emit_iface_render_tokens(buffer, tokens, source, fmt_sc_range.start, fmt_sc_range.stop)
                        else:
                            # stage0 prints the chain CONDITION parenthesized:
                            # `static if (A == B):` — the head keywords render verbatim, the
                            # condition tokens wrap in parens; a bare `static else` has none.
                            fmt_sc_cond: mutable usize = fmt_sc_range.start
                            fmt_sc_seen_head: mutable bool = false
                            for fmt_sc_probe in fmt_sc_range.start..<fmt_sc_range.stop |fmt_sc_cond, fmt_sc_seen_head, tokens, source|:
                                continue if fmt_sc_seen_head
                                fmt_sc_token: Lexer::Token = tokens[fmt_sc_probe]
                                fmt_sc_is_head: bool = fmt_sc_token.kind == Lexer::TokenKind.Static or fmt_sc_token.kind == Lexer::TokenKind.If or fmt_sc_token.kind == Lexer::TokenKind.Elif or fmt_sc_token.kind == Lexer::TokenKind.Else
                                if fmt_sc_is_head:
                                    fmt_sc_cond <- fmt_sc_probe + 1
                                else:
                                    fmt_sc_seen_head <- true
                            emit_iface_render_tokens(buffer, tokens, source, fmt_sc_range.start, fmt_sc_cond)
                            if fmt_sc_cond < fmt_sc_range.stop:
                                # The parens belong to exprStr's BINARY formatting, not the
                                # chain: a bare-ident condition prints unwrapped.
                                fmt_sc_multi: bool = fmt_sc_range.stop - fmt_sc_cond > 1
                                fmt_push(buffer, " (" if fmt_sc_multi else " ")
                                emit_iface_render_tokens(buffer, tokens, source, fmt_sc_cond, fmt_sc_range.stop)
                                fmt_push(buffer, ")") if fmt_sc_multi
                        fmt_push(buffer, ":\n")
                        if not fmt_sc_is_chain and Lexer::text_or_empty(tokens[fmt_sc_range.start], source) == "handler":
                            # Handler methods are lowered to hidden function names for the
                            # backend. Re-render each method from its original source span so
                            # `fmt` preserves the declared operation names and bodies.
                            for fmt_handler_child in fmt_sc_body |buffer, tokens, source, indent|:
                                if fmt_handler_child is Decl.Func(fmt_handler_name, fmt_handler_params, fmt_handler_return, fmt_handler_body, fmt_handler_effects, fmt_handler_decorators, fmt_handler_line):
                                    fmt_block_from_source_at_indent(buffer, tokens, source, fmt_handler_line.line, fmt_handler_line.offset, indent + 4)
                                else:
                                    fmt_decl(buffer, fmt_handler_child, tokens, source, indent + 4)
                            return
                    for fmt_sc_child in fmt_sc_body |buffer, tokens, source, indent|:
                        fmt_decl(buffer, fmt_sc_child, tokens, source, indent + 4)
                    return
                fmt_push(buffer, "<fmt-decl-todo>\n")



        # An enum/struct declaration prints its header and body verbatim in normalized
        # spelling — fmt does not restructure type declarations, only statements.
        def fmt_block_from_source(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32, offset: u32) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                fmt_bh_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
                return if not fmt_bh_range.found
                emit_iface_render_tokens(buffer, tokens, source, fmt_bh_range.start, fmt_bh_range.stop)
                fmt_push(buffer, ":\n")
                fmt_bb_range: (found: bool, start: usize, stop: usize) = emit_iface_body_range(tokens, fmt_bh_range.stop + 1)
                return if not fmt_bb_range.found
                emit_iface_body_lines(buffer, tokens, source, fmt_bb_range.start, fmt_bb_range.stop, 4, false)



        def fmt_line_has_handler_install(tokens: darray[Lexer::Token]&, source: u8&, line: u32) -> bool:
            can Abort.Panic:
                for fmt_handler_probe in tokens:
                    true return if fmt_handler_probe.line == line and (fmt_handler_probe.kind == Lexer::TokenKind.With or fmt_handler_probe.kind == Lexer::TokenKind.Ident and Lexer::text_or_empty(fmt_handler_probe, source) == "with")
                return false



        def fmt_block_from_source_at_indent(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32, offset: u32, indent: i64) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                fmt_bhi_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
                return if not fmt_bhi_range.found
                fmt_indent(buffer, indent)
                emit_iface_render_tokens(buffer, tokens, source, fmt_bhi_range.start, fmt_bhi_range.stop)
                fmt_push(buffer, ":\n")
                fmt_bbi_range: (found: bool, start: usize, stop: usize) = emit_iface_body_range(tokens, fmt_bhi_range.stop + 1)
                return if not fmt_bbi_range.found
                emit_iface_body_lines(buffer, tokens, source, fmt_bbi_range.start, fmt_bbi_range.stop, indent + 4, false)
