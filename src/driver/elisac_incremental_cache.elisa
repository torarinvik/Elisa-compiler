# Opt-in portable semantic cache admission. The stored values are only collector facts;
# invocation-local AST anchors are rebuilt from the exact parse before any checker skips.
struct IncrementalCacheRead:
    valid: bool
    bytes: darray[u8]


struct IncrementalSessionIdentityKey:
    valid: bool
    bytes: darray[u8]

const IGC_SESSION_IDENTITY_VISIT_LIMIT: usize = 65536


def igc_append_identity_u64(bytes: mutable darray[u8]&, value: u64) -> void can[Abort.Panic, Memory.Allocate]:
    for shift in 0..<8 |bytes|:
        bytes.push(((value >> (shift * 8)) & 255).u8())


def igc_session_identity_key(identity: SourceIdentity::Capture&) -> IncrementalSessionIdentityKey can[Abort.Panic, Memory.Allocate]:
    miss: IncrementalSessionIdentityKey = IncrementalSessionIdentityKey{valid: false, bytes: []}
    return miss if not SourceIdentity::usable(identity)
    return miss if not identity.enabled or not identity.valid or not identity.complete
    return miss if identity.paths.count > IGC_SESSION_IDENTITY_VISIT_LIMIT or identity.edges.count != identity.paths.count - 1
    magic: sview = "ELISA-ID-1"
    header_size: usize = magic.len + 32
    return miss if identity.paths.count > (Semantic::INCREMENTAL_SNAPSHOT_CODEC_LIMIT - header_size) / 17
    path_metadata: usize = identity.paths.count * 17
    return miss if identity.edges.count > (Semantic::INCREMENTAL_SNAPSHOT_CODEC_LIMIT - header_size - path_metadata) / 16
    metadata: usize = header_size + path_metadata + identity.edges.count * 16
    return miss if identity.bytes.count > Semantic::INCREMENTAL_SNAPSHOT_CODEC_LIMIT - metadata
    key: mutable darray[u8] = []
    key.reserve(metadata + identity.bytes.count)
    key.extend(magic)
    igc_append_identity_u64(key, identity.root.u64())
    igc_append_identity_u64(key, identity.bytes.count.u64())
    igc_append_identity_u64(key, identity.paths.count.u64())
    igc_append_identity_u64(key, identity.edges.count.u64())
    key.extend(identity.bytes)
    for path in identity.paths |key|:
        igc_append_identity_u64(key, path.start.u64())
        igc_append_identity_u64(key, path.length.u64())
        key.push(1 if path.expanded else 0)
    for edge in identity.edges |key|:
        igc_append_identity_u64(key, edge.parent.u64())
        igc_append_identity_u64(key, edge.child.u64())
    return IncrementalSessionIdentityKey{valid: true, bytes: key}


def incremental_semantic_session_new[@session]() -> Semantic::IncrementalSemanticSession[session] @session can[Memory.Allocate]:
    return Semantic::incremental_semantic_session_new[session](true)


# The query graph remains experimental until retained-capacity and end-to-end
# benefit are measured. It is opt-in for persistent sessions; setting
# ELISA_STAGE1_INCREMENTAL_QUERY_GRAPH=1 enables graph work while retaining the
# session-owned typed snapshot and its exact surface/body reuse gates.
def igc_configure_semantic_query_graph[@session](session: mutable Semantic::IncrementalSemanticSession[session]& @session) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    setting: mutable darray[u8] = []
    graph_enabled: bool = env_value("ELISA_STAGE1_INCREMENTAL_QUERY_GRAPH", &setting) and setting.count == 1 and setting[0] == 49
    _ = Semantic::incremental_semantic_session_set_query_graph_enabled(session, graph_enabled)


def igc_cache_path(cache_directory: darray[u8]&, source_path: sview) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    path: mutable darray[u8] = []
    for index in 0..<cache_directory.count |path, cache_directory|:
        path.push(cache_directory[index])
    while path.count > 0 and path[path.count - 1] == 47 |path|:
        path <- path.truncate(path.count - 1)
    path.push(47)
    hash: mutable u64 = 14695981039346656037
    for index in 0..<source_path.len |hash, source_path|:
        hash <- (hash ^ source_path[index].u64()) * 1099511628211
    for index in 0..<16 |path, hash|:
        shift: u32 = ((15 - index) * 4).u32()
        digit: u8 = ((hash >> shift) & 15).u8()
        path.push((48 + digit).u8() if digit < 10 else (87 + digit).u8())
    path.extend(".elisa-semantic")
    return path


def igc_mkdir(cache_directory: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    return if cache_directory.count == 0
    path: mutable darray[u8] = []
    for index in 0..<cache_directory.count |path, cache_directory|:
        path.push(cache_directory[index])
    path.push(0)
    path_cstr: cstr = (&path[0]).cast[cstr] can Unsafe.PointerCast
    _ = mkdir(path_cstr, 448.u16())
    return


def igc_read_cache(path: darray[u8]&) -> IncrementalCacheRead can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    path_c: mutable darray[u8] = []
    for index in 0..<path.count |path_c, path|:
        path_c.push(path[index])
    path_c.push(0)
    path_cstr: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
    # O_NOFOLLOW rejects substituted symlinks; O_NONBLOCK keeps an unexpected
    # FIFO from hanging compilation. Both cases are ordinary cache misses.
    descriptor: i64 = open(path_cstr, ELISA_OPEN_READ_CACHE_SAFE, 0)
    return IncrementalCacheRead{valid: false, bytes: []} if descriptor < 0
    bytes: mutable darray[u8] = []
    read_valid: mutable bool = true
    at_eof: mutable bool = false
    limit: usize = Semantic::INCREMENTAL_SNAPSHOT_CODEC_LIMIT
    while not at_eof and read_valid |bytes, descriptor, read_valid, at_eof, limit|:
        available: usize = limit + 1 - bytes.count
        chunk: usize = 65536 if available > 65536 else available
        filled: usize = bytes.count
        bytes.reserve(filled + chunk)
        bytes.count <- filled + chunk
        amount: isize = read(descriptor, &bytes[filled], chunk)
        if amount < 0:
            bytes.count <- filled
            read_valid <- false
        elif amount == 0:
            bytes.count <- filled
            at_eof <- true
        else:
            bytes.count <- filled + amount.usize()
            read_valid <- false if bytes.count > limit
    _ = close(descriptor)
    return IncrementalCacheRead{valid: false, bytes: []} if not read_valid or not at_eof
    return IncrementalCacheRead{valid: true, bytes: bytes}


def igc_write_atomic(path: darray[u8]&, bytes: darray[u8]&, semantic_fingerprint: u64, options_fingerprint: u64, options_key: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    temporary: mutable darray[u8] = []
    temporary.extend(path)
    temporary.extend(".tmp.")
    append_decimal(temporary, elisa_stage1_getpid().u32())
    destination_c: mutable darray[u8] = []
    temporary_c: mutable darray[u8] = []
    destination_c.extend(path)
    temporary_c.extend(temporary)
    destination_c.push(0)
    temporary_c.push(0)
    destination_cstr: cstr = (&destination_c[0]).cast[cstr] can Unsafe.PointerCast
    temporary_cstr: cstr = (&temporary_c[0]).cast[cstr] can Unsafe.PointerCast
    # O_EXCL makes a stale or planted temp path a safe cache miss instead of
    # following a symlink and truncating its target.
    descriptor: i64 = open(temporary_cstr, ELISA_OPEN_WRITE_CREATE_EXCL, 384)
    return false if descriptor < 0
    offset: mutable usize = 0
    write_valid: mutable bool = true
    while offset < bytes.count and write_valid |offset, write_valid, bytes, descriptor|:
        raw: void& = (&bytes[offset]).cast[void&] can Unsafe.PointerCast
        written: isize = write(descriptor, raw, bytes.count - offset)
        if written <= 0:
            write_valid <- false
        else:
            offset <- offset + written.usize()
    close_status: i32 = close(descriptor)
    write_valid <- false if close_status != 0
    decoded: Semantic::IncrementalSnapshotDecodeResult = Semantic::incremental_decode_snapshot(bytes, semantic_fingerprint, options_fingerprint, options_key)
    write_valid <- false if not decoded.valid
    if write_valid:
        renamed: i32 = rename(temporary_cstr, destination_cstr)
        write_valid <- false if renamed != 0
    if not write_valid:
        _ = unlink(temporary_cstr)
    return write_valid


def run_semantic_gate_incremental_with_session[@session](file: Ast::File&, policy_source: u8&, policy_length: usize, analyzed_source: u8&, analyzed_length: usize, tokens: darray[Lexer::Token]&, identity: SourceIdentity::Capture&, cache_directory: darray[u8]&, report_cache: bool, generated_input: bool, session: mutable Semantic::IncrementalSemanticSession[session]& @session) -> i64 can[Abort.Panic, Console, Memory.Allocate, Global{Read,Write}, Unsafe{PointerArithmetic,PointerCast,RawExtern}]:
    options: Semantic::IncrementalSemanticOptions = stage1_semantic_options(policy_source, policy_length)
    semantic_fingerprint: u64 = Semantic::INCREMENTAL_SEMANTIC_ENGINE_VERSION
    session_enabled: bool = Semantic::incremental_semantic_session_is_enabled(session)
    options_key: mutable darray[u8] = []
    options_key_valid: mutable bool = false
    options_fingerprint: mutable u64 = 0
    if cache_directory.count > 0 or session_enabled:
        options_key_valid <- Semantic::incremental_semantic_options_encode(options, &options_key)
        if options_key_valid:
            options_fingerprint <- Semantic::incremental_semantic_options_key_fingerprint(options_key)
    snapshot: mutable Semantic::IncrementalSemanticSnapshot = Semantic::incremental_empty_snapshot()
    cache_path: mutable darray[u8] = []
    cache_admitted: mutable bool = false
    admission_inputs_valid: mutable bool = false
    cache_loaded: mutable bool = false
    source_path: mutable sview = ""
    identity_usable: bool = SourceIdentity::usable(identity) and identity.root < identity.paths.count
    if identity_usable:
        root: SourceIdentity::PathRecord = identity.paths[identity.root]
        source_path <- bytes_view_range_ref(identity.bytes, root.start, root.length)
    admission_inputs_valid <- source_path.len > 0 and options_key_valid and identity_usable
    session_hit: mutable bool = false
    session_has_previous: mutable bool = false
    session_edit_reused: mutable bool = false
    session_attempted: mutable bool = false
    function_body_facts_restored: mutable u32 = 0
    body_query_publish_skips: mutable u32 = 0
    prior_snapshot_fact_fallbacks: mutable u32 = 0
    cold_body_scans: mutable u32 = 0
    source_input_admitted: mutable bool = false
    if admission_inputs_valid:
        if cache_directory.count > 0:
            igc_mkdir(cache_directory)
            cache_path <- igc_cache_path(cache_directory, source_path)
            cache_admitted <- true
        if session_enabled:
            identity_key: IncrementalSessionIdentityKey = igc_session_identity_key(identity)
            if identity_key.valid:
                fact_collection_span: PhaseTimer::Span = PhaseTimer::begin_span() can Global{Read,Write}
                session_result: Semantic::IncrementalSessionCollectionResult = Semantic::incremental_collect_function_facts_with_session(file, analyzed_source, analyzed_length, tokens, source_path, semantic_fingerprint, options_fingerprint, options_key, identity_key.bytes, generated_input, session) can[Abort.Panic, Memory.Allocate, Global{Read,Write}, Unsafe{PointerArithmetic,PointerCast}]
                PhaseTimer::end_span("incremental-fact-collection", fact_collection_span) can Global{Read,Write}
                snapshot <- session_result.snapshot
                session_hit <- session_result.exact_hit
                session_has_previous <- session_result.prior_valid
                session_edit_reused <- session_result.body_facts_reused
                function_body_facts_restored <- session_result.function_body_facts_restored
                body_query_publish_skips <- session_result.body_query_publish_skips
                prior_snapshot_fact_fallbacks <- session_result.prior_snapshot_fact_fallbacks
                cold_body_scans <- session_result.cold_body_scans
                source_input_admitted <- session_result.source_input_admitted
                session_attempted <- true
            else:
                Semantic::incremental_semantic_session_reset(session)
        if not session_attempted:
            if session_enabled:
                Semantic::incremental_semantic_session_reset(session)
            previous: mutable Semantic::IncrementalSemanticSnapshot = Semantic::incremental_empty_snapshot()
            has_previous: mutable bool = false
            if cache_directory.count > 0:
                stored: IncrementalCacheRead = igc_read_cache(cache_path)
                if stored.valid:
                    decoded: Semantic::IncrementalSnapshotDecodeResult = Semantic::incremental_decode_snapshot(stored.bytes, semantic_fingerprint, options_fingerprint, options_key)
                    if decoded.valid:
                        previous <- decoded.snapshot
                        has_previous <- true
                        cache_loaded <- true
            fact_collection_span: PhaseTimer::Span = PhaseTimer::begin_span() can Global{Read,Write}
            snapshot <- Semantic::incremental_collect_function_facts(file, analyzed_source, analyzed_length, tokens, source_path, semantic_fingerprint, options_fingerprint, options_key, previous, has_previous) can[Abort.Panic, Memory.Allocate, Global{Read,Write}, Unsafe.PointerCast]
            PhaseTimer::end_span("incremental-fact-collection", fact_collection_span) can Global{Read,Write}
    elif session_enabled:
        Semantic::incremental_semantic_session_reset(session)

    incremental_skip_count: mutable u64 = 0
    effect_source_bodies_skipped: mutable u64 = 0
    ungranted_panic_bodies_skipped: mutable u64 = 0
    global_permission_axis_scans_skipped: mutable u64 = 0
    name_lookup_stats: mutable Semantic::IncrementalSemanticNameLookupStats = Semantic::IncrementalSemanticNameLookupStats{hits: 0, classification_chain_visits: 0}
    PhaseTimer::mark("incremental-before-semantic") can Global{Read,Write}
    lookup_context: mutable Semantic::IncrementalSemanticNameLookupContext[session] @session = Semantic::incremental_semantic_name_lookup_context_begin_request(session, report_cache) can Global{Read,Write}
    semantic_errors: i64 = run_semantic_gate_with_lookup_context(file, policy_source, policy_length, options, snapshot, &incremental_skip_count, &effect_source_bodies_skipped, &ungranted_panic_bodies_skipped, &global_permission_axis_scans_skipped, &lookup_context) can Global{Read,Write}
    name_lookup_stats <- Semantic::incremental_semantic_name_lookup_stats(&lookup_context)
    # `mark` also flushes buffered short semantic passes; the request end span is independent.
    PhaseTimer::mark("incremental-semantic") can Global{Read,Write}
    cache_published: mutable bool = false
    # This sidecar stores only facts collected from the current AST/source and
    # is revalidated by the authority checker before it can skip a walk. It does
    # not store semantic results or diagnostics, so unrelated semantic errors do
    # not make the current-source snapshot unsafe to publish.
    if cache_admitted:
        encoded: Semantic::IncrementalSnapshotEncodeResult = Semantic::incremental_encode_snapshot(snapshot)
        if encoded.valid:
            cache_published <- igc_write_atomic(cache_path, encoded.bytes, semantic_fingerprint, options_fingerprint, options_key)
    if report_cache:
        report: mutable darray[u8] = []
        eligible_bodies: mutable u32 = 0
        matched_eligible_bodies: mutable u32 = 0
        # Count body records, not collector keys or direct-fact entries: a function
        # may own multiple facts, while the coverage unit is one supported body.
        for record in snapshot.functions |eligible_bodies, matched_eligible_bodies|:
            if record.cacheable:
                eligible_bodies <- eligible_bodies + 1
                matched_eligible_bodies <- matched_eligible_bodies + 1 if record.matched_previous
        report.extend("incremental-ga-cache: input=")
        if generated_input:
            report.extend("generated")
        else:
            report.extend("ordinary")
        report.extend(" prior=")
        if session_hit or session_has_previous:
            report.extend("session")
        elif cache_loaded:
            report.extend("valid")
        else:
            report.extend("miss")
        report.extend(" matched=")
        append_decimal(&report, snapshot.bodies_matched)
        report.extend(" eligible_bodies=")
        append_decimal(&report, eligible_bodies)
        report.extend(" matched_eligible_bodies=")
        append_decimal(&report, matched_eligible_bodies)
        report.extend(" visited=")
        append_decimal(&report, snapshot.bodies_visited)
        report.extend(" rejected=")
        append_decimal(&report, snapshot.bodies_rejected)
        report.extend(" ga_walks_skipped=")
        append_decimal(&report, incremental_skip_count.u32())
        report.extend(" published=")
        if cache_published:
            report.extend("yes")
        else:
            report.extend("no")
        # Keep the established cache-report field sequence through published=yes
        # contiguous for existing parity controls. New session/query metrics are
        # appended so consumers can add them without invalidating older parsers.
        report.extend(" function_body_facts_restored=")
        append_decimal(&report, function_body_facts_restored)
        report.extend(" body_query_publish_skips=")
        append_decimal(&report, body_query_publish_skips)
        report.extend(" prior_snapshot_fact_fallbacks=")
        append_decimal(&report, prior_snapshot_fact_fallbacks)
        report.extend(" cold_body_scans=")
        append_decimal(&report, cold_body_scans)
        report.extend(" source_input_admitted=")
        if source_input_admitted:
            report.extend("yes")
        else:
            report.extend("no")
        report.extend(" direct_fact_count=")
        append_decimal(&report, snapshot.direct_facts.count.u32())
        report.extend(" effect_source_bodies_skipped=")
        append_decimal(&report, effect_source_bodies_skipped.u32())
        report.extend(" ungranted_panic_bodies_skipped=")
        append_decimal(&report, ungranted_panic_bodies_skipped.u32())
        report.extend(" global_permission_axis_scans_skipped=")
        append_decimal(&report, global_permission_axis_scans_skipped.u32())
        report.extend(" name_lookup_hits=")
        append_decimal(&report, name_lookup_stats.hits.u32())
        report.extend(" name_lookup_classification_chain_visits=")
        append_decimal(&report, name_lookup_stats.classification_chain_visits.u32())
        report.extend(" self_assignment_bodies_scanned=")
        append_decimal(&report, snapshot.self_assignment_bodies_scanned)
        report.extend(" self_assignment_bodies_reused=")
        append_decimal(&report, snapshot.self_assignment_bodies_reused)
        report.extend(" session=")
        if not session_enabled:
            report.extend("off")
        elif session_hit:
            report.extend("hit")
        elif session_edit_reused:
            report.extend("edit")
        else:
            report.extend("miss")
        if not admission_inputs_valid:
            report.extend(" reason=unstable-source-or-options")
        report.push(10)
        write_stderr(report)
    PhaseTimer::mark("incremental-post-semantic") can Global{Read,Write}
    return semantic_errors


def run_semantic_gate_incremental(file: Ast::File&, policy_source: u8&, policy_length: usize, analyzed_source: u8&, analyzed_length: usize, tokens: darray[Lexer::Token]&, identity: SourceIdentity::Capture&, cache_directory: darray[u8]&, report_cache: bool, generated_input: bool) -> i64 can[Abort.Panic, Console, Memory.Allocate, Global{Read,Write}, Unsafe{PointerArithmetic,PointerCast,RawExtern}]:
    region local_session:
        sessions: mutable darray[Semantic::IncrementalSemanticSession[local_session]] @local_session = []
        sessions.push(Semantic::incremental_semantic_session_new[local_session](false))
        return run_semantic_gate_incremental_with_session(file, policy_source, policy_length, analyzed_source, analyzed_length, tokens, identity, cache_directory, report_cache, generated_input, &sessions[0]) can Global{Read,Write}
