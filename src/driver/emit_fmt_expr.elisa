# `-emit fmt` / `-emit lowered` — the EXPRESSION half of the unparser port (stage0's
# unparse.FormatFile). Not yet dispatched: the statement/declaration half follows, and the
# mode goes live only when the whole file round-trips against stage0 (see the port plan
# and the two measured blockers in the stage1-parity-status memory: fmt prints DESUGARED
# canonical statements, and region-wrapped bodies print stage0's internal `__auto_N`).
#
# Formatting rules, from unparse_formatexpr_to_formatmatchpattern.go:
#   - binaries print parenthesized: "(" left " " OP " " right ")" with stage0 TokenName
#     operator spellings;
#   - `not (x is P)` prints as `x is not P`, `not (a in b)` as `a not in b`, other `not`
#     as "(not X)"; other unary as "(" OP operand ")" with no space;
#   - strings re-quote via strconv.Quote (escapes re-encoded);
#   - calls print "F(a, b)"; fields "obj.name"; indexes "obj[i]"; parens collapse to
#     their inner expression's own parenthesization.

module FmtUnparse:
    public:
        def fmt_expr(buffer: mutable darray[u8]&, expression: Ast::Expr) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(fmt_name, fmt_line):
                        fmt_push(buffer, fmt_name)
                    Expr.IntLit(fmt_int_value):
                        fmt_int_digits: mutable darray[u8] = []
                        fmt_int_left: mutable i64 = fmt_int_value
                        buffer.push(45) if fmt_int_left < 0
                        fmt_int_left <- 0 - fmt_int_left if fmt_int_left < 0
                        fmt_int_digits.push(48) if fmt_int_left == 0
                        while fmt_int_left > 0 |fmt_int_left, fmt_int_digits|:
                            fmt_int_digits.push((48 + (fmt_int_left % 10)).u8())
                            fmt_int_left <- fmt_int_left / 10
                        fmt_int_index: mutable i64 = fmt_int_digits.count.i64() - 1
                        while fmt_int_index >= 0 |fmt_int_index, fmt_int_digits, buffer|:
                            buffer.push(fmt_int_digits[fmt_int_index.usize()])
                            fmt_int_index <- fmt_int_index - 1
                    Expr.StringLit(fmt_str_text):
                        fmt_quote(buffer, fmt_str_text)
                    Expr.Binary(fmt_left, fmt_operator, fmt_right, fmt_bin_line):
                        buffer.push(40)
                        fmt_expr(buffer, fmt_left)
                        buffer.push(32)
                        fmt_operator_name(buffer, fmt_operator)
                        buffer.push(32)
                        fmt_expr(buffer, fmt_right)
                        buffer.push(41)
                    Expr.Paren(fmt_inner, fmt_paren_line):
                        fmt_expr(buffer, fmt_inner)
                    Expr.Field(fmt_object, fmt_field, fmt_field_line):
                        fmt_expr(buffer, fmt_object)
                        buffer.push(46)
                        fmt_push(buffer, fmt_field)
                    Expr.Index(fmt_head, fmt_index_arg, fmt_index_line):
                        fmt_expr(buffer, fmt_head)
                        buffer.push(91)
                        fmt_expr(buffer, fmt_index_arg)
                        buffer.push(93)
                    Expr.Call(fmt_callee, fmt_args, fmt_arg_names, fmt_call_line):
                        fmt_expr(buffer, fmt_callee)
                        buffer.push(40)
                        fmt_first: mutable bool = true
                        for fmt_argument in fmt_args |buffer, fmt_first|:
                            fmt_push(buffer, ", ") if not fmt_first
                            fmt_first <- false
                            fmt_expr(buffer, fmt_argument)
                        buffer.push(41)
                    _:
                        # Remaining arms (unary/is-not/queries/literals/casts) land with
                        # the statement half; an unknown shape prints a loud marker so a
                        # partial round-trip can never read as byte parity.
                        fmt_push(buffer, "<fmt-todo>")

        def fmt_push(buffer: mutable darray[u8]&, text: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                for fmt_push_index in 0..<sview_len(text) |buffer, text|:
                    buffer.push(sview_at(text, fmt_push_index))

        # strconv.Quote: double-quoted with backslash escapes for \\ " \n \t \r; other
        # control bytes as \xHH (ASCII sources only in this repo's corpus).
        def fmt_quote(buffer: mutable darray[u8]&, text: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                buffer.push(34)
                for fmt_quote_index in 0..<sview_len(text) |buffer, text|:
                    fmt_byte: u8 = sview_at(text, fmt_quote_index)
                    if fmt_byte == 34 or fmt_byte == 92:
                        buffer.push(92)
                        buffer.push(fmt_byte)
                    elif fmt_byte == 10:
                        buffer.push(92)
                        buffer.push(110)
                    elif fmt_byte == 9:
                        buffer.push(92)
                        buffer.push(116)
                    elif fmt_byte == 13:
                        buffer.push(92)
                        buffer.push(114)
                    else:
                        buffer.push(fmt_byte)
                buffer.push(34)

        # stage0 TokenName spellings for the operators the corpus uses; extended alongside
        # the statement half.
        def fmt_operator_name(buffer: mutable darray[u8]&, operator: Lexer::TokenKind) -> void:
            can Memory.Allocate, Abort.Panic:
                if operator == Lexer::TokenKind.Plus:
                    fmt_push(buffer, "+")
                elif operator == Lexer::TokenKind.Minus:
                    fmt_push(buffer, "-")
                elif operator == Lexer::TokenKind.Star:
                    fmt_push(buffer, "*")
                elif operator == Lexer::TokenKind.Slash:
                    fmt_push(buffer, "/")
                elif operator == Lexer::TokenKind.Percent:
                    fmt_push(buffer, "%")
                elif operator == Lexer::TokenKind.EqEq:
                    fmt_push(buffer, "==")
                elif operator == Lexer::TokenKind.BangEq:
                    fmt_push(buffer, "!=")
                elif operator == Lexer::TokenKind.Lt:
                    fmt_push(buffer, "<")
                elif operator == Lexer::TokenKind.Gt:
                    fmt_push(buffer, ">")
                elif operator == Lexer::TokenKind.LtEq:
                    fmt_push(buffer, "<=")
                elif operator == Lexer::TokenKind.GtEq:
                    fmt_push(buffer, ">=")
                else:
                    fmt_push(buffer, "<fmt-op-todo>")
