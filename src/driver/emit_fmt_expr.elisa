# `-emit fmt` / `-emit lowered` — the EXPRESSION half of the unparser port (stage0's
# unparse.FormatFile). Not yet dispatched: the statement/declaration half follows, and the
# mode goes live only when the whole file round-trips against stage0 (see the port plan
# and the two measured blockers in the stage1-parity-status memory: fmt prints DESUGARED
# canonical statements, and region-wrapped bodies print stage0's internal `__auto_N`).
#
# Formatting rules, from unparse_formatexpr_to_formatmatchpattern.go:
#   - binaries print parenthesized: "(" left " " OP " " right ")" with stage0 TokenName
#     operator spellings;
#   - `not (x is P)` prints as `x is not P`, `not (a in b)` as `a not in b`, other `not`
#     as "(not X)"; other unary as "(" OP operand ")" with no space;
#   - strings re-quote via strconv.Quote (escapes re-encoded);
#   - calls print "F(a, b)"; fields "obj.name"; indexes "obj[i]"; parens collapse to
#     their inner expression's own parenthesization.

# Multi-cast lines: pairing each rendered cast NODE with its own `cast[` bracket on the
# line. The old right-to-left cursor was only correct for NESTED casts (outer renders
# first, its bracket is rightmost) and SWAPPED the brackets of two SIBLING casts
# (`f(a.cast[A], b.cast[B])` rendered as `f(a.cast[B], b.cast[A])`). The correct pairing:
# at each cast's render, its bracket is the (K+1)-th UNCLAIMED bracket in textual order,
# where K is the number of casts inside its own head subtree (those are textually to its
# left but not yet rendered). `fmt_cast_claimed` is the per-line claimed bitmask.
global mutable fmt_cast_line: u32

global mutable fmt_cast_claimed: u64

# The line of the statement currently being rendered: literal spelling recovery (a hex
# literal's `0x…` source text) scans this line's tokens for a value match.
global mutable fmt_stmt_line: u32

# stage0 wraps a region-less container-allocating function body in a synthesized region and
# PRINTS it: `with arena __auto_<N> as :`. `N` is `pos.Offset` of the function's `def` token
# in stage0's directive-bearing include expansion — recovered as
# `def_token.start + offset-map delta` (see emit_fmt_offset_delta). -1: no map supplied,
# wrap rendering stays off (a direct driver invocation without the wrapper).
global mutable fmt_map_delta_probe: i64

# A postfix statement guard carrying a grant (`X return if C can E`) desugars to an `if`
# whose single same-line body is the statement. stage0 keeps the grant on the SYNTHESIZED
# HEADER (`if C can E:` / `return X`), so the `if` arm renders it and records the line
# here; the body statement's own grant scan then skips that line instead of printing the
# same clause a second time. 0: nothing claimed (source lines are 1-based).
global mutable fmt_can_claimed_line: u32

# stage0 desugars `nursery workers(N):` in its PARSER and unparses the RESULT: a
# `pool __nursery_pool_K(N):` scope around a synthesized TaskGroup, with every `submit`
# in it collected by `task_group_add`. stage1 lowers `nursery` in the BACKEND instead, so
# the text is reconstructed here. `fmt_nursery_counter` reproduces stage0's parse-time
# counter (nursery blocks in source order); `fmt_nursery_active` is the K of the nursery
# currently being rendered, 0 outside one — it is what tells a `submit` statement which
# group and pool to name.
global mutable fmt_nursery_counter: i64

global mutable fmt_nursery_active: i64

module FmtUnparse:
    public:
        def fmt_expr(buffer: mutable darray[u8]&, expression: Ast::Expr, tokens: darray[Lexer::Token]&, source: u8&) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                match expression:
                    Expr.Ident(fmt_name, fmt_line):
                        fmt_push(buffer, fmt_name)
                    Expr.BoolLit(fmt_bool_value):
                        if fmt_bool_value:
                            fmt_push(buffer, "true")
                        else:
                            fmt_push(buffer, "false")
                    Expr.IntLit(fmt_int_value):
                        # A HEX literal keeps its source spelling (stage0's IntLit stores
                        # the text): scan the current statement's line for a HexLit token
                        # whose parsed value matches.
                        if fmt_stmt_line != 0:
                            fmt_int_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, fmt_stmt_line)
                            if fmt_int_range.found:
                                fmt_int_end: mutable usize = fmt_int_range.stop
                                while fmt_int_end < tokens.count and tokens[fmt_int_end].line == fmt_stmt_line and tokens[fmt_int_end].kind != Lexer::TokenKind.Newline |fmt_int_end, tokens|:
                                    fmt_int_end <- fmt_int_end + 1
                                for fmt_int_probe in fmt_int_range.start..<fmt_int_end |buffer, tokens, source, fmt_int_value|:
                                    fmt_int_token: Lexer::Token = tokens[fmt_int_probe]
                                    continue if fmt_int_token.kind != Lexer::TokenKind.HexLit
                                    fmt_int_text: sview = Lexer::text_or_empty(fmt_int_token, source)
                                    if fmt_parse_int_text(fmt_int_text) == fmt_int_value:
                                        fmt_push(buffer, fmt_int_text)
                                        return
                        fmt_int_digits: mutable darray[u8] = []
                        fmt_int_left: mutable i64 = fmt_int_value
                        buffer.push(45) if fmt_int_left < 0
                        fmt_int_left <- 0 - fmt_int_left if fmt_int_left < 0
                        fmt_int_digits.push(48) if fmt_int_left == 0
                        while fmt_int_left > 0 |fmt_int_left, fmt_int_digits|:
                            fmt_int_digits.push((48 + (fmt_int_left % 10)).u8())
                            fmt_int_left <- fmt_int_left / 10
                        fmt_int_index: mutable i64 = fmt_int_digits.count.i64() - 1
                        while fmt_int_index >= 0 |fmt_int_index, fmt_int_digits, buffer|:
                            buffer.push(fmt_int_digits[fmt_int_index.usize()])
                            fmt_int_index <- fmt_int_index - 1
                    Expr.StringLit(fmt_str_text):
                        fmt_quote(buffer, fmt_str_text)
                    Expr.If(fmt_tern_cond, fmt_tern_then, fmt_tern_else, fmt_tern_line):
                        # `(THEN if COND else ELSE)` — stage0 parenthesizes the whole form.
                        # Any FURTHER layer comes from a real `Expr.Paren` in the operand,
                        # never from a rule here: `(a + b) if c else d` keeps its required
                        # source parens as a node, and `lo + band if … else n` has none.
                        buffer.push(40)
                        fmt_expr(buffer, fmt_tern_then, tokens, source)
                        fmt_push(buffer, " if ")
                        fmt_expr(buffer, fmt_tern_cond, tokens, source)
                        fmt_push(buffer, " else ")
                        fmt_expr(buffer, fmt_tern_else, tokens, source)
                        buffer.push(41)
                    Expr.Block(fmt_vb_stmts, fmt_vb_value, fmt_vb_captures, fmt_vb_line):
                        # A VALUE BLOCK (the parser's lowering for `get X else Y` in value
                        # position, among others): stage0's unparser prints its `<expr>`
                        # placeholder for these — matched, not guessed (measured on the
                        # get-else probe).
                        fmt_push(buffer, "<expr>")
                    Expr.GetElse(fmt_ge_guarded, fmt_ge_recovery, fmt_ge_line):
                        # MEASURED: stage0's own unparser prints `<expr>` for a get-else
                        # value — its placeholder, reproduced verbatim.
                        fmt_push(buffer, "<expr>")
                    Expr.FloatLit(fmt_float_text):
                        # stage0's FloatLit arm prints the kept source spelling.
                        fmt_push(buffer, fmt_float_text)
                    Expr.CharLit(fmt_char_text):
                        # stage0's formatCharLiteral single-quotes the kept source text.
                        buffer.push(39)
                        fmt_push(buffer, fmt_char_text)
                        buffer.push(39)
                    Expr.Binary(fmt_left, fmt_operator, fmt_right, fmt_bin_line):
                        # `X is name` with a bare lowercase non-builtin identifier is
                        # stage0's OptionalBindExpr (docs/80, peekIsBareBindingTarget), and
                        # its formatExpr arm prints `let name = X` — PAREN-FREE, in every
                        # position (if headers, ternary conditions).
                        if fmt_operator == Lexer::TokenKind.Is:
                            if fmt_right is Expr.Ident(fmt_ob_name, fmt_ob_line):
                                if fmt_is_bare_binding_name(fmt_ob_name):
                                    fmt_push(buffer, "let ")
                                    fmt_push(buffer, fmt_ob_name)
                                    fmt_push(buffer, " = ")
                                    fmt_expr(buffer, fmt_left, tokens, source)
                                    return
                        # A RANGE is stage0's MembershipRangeExpr — paren-free, and the
                        # deprecated bare `..` re-spells as `..=` (rangeOpName).
                        fmt_bin_is_range: bool = fmt_operator == Lexer::TokenKind.Range or fmt_operator == Lexer::TokenKind.RangeLt or fmt_operator == Lexer::TokenKind.RangeGt or fmt_operator == Lexer::TokenKind.RangeLe
                        if fmt_bin_is_range:
                            fmt_expr(buffer, fmt_left, tokens, source)
                            buffer.push(32)
                            if fmt_operator == Lexer::TokenKind.Range and fmt_bin_left_is_range(fmt_left):
                                # A STEPPED range `LOW ..< HIGH .. STEP` parses as a bare
                                # `..` whose LEFT is itself a spelled range — the one legal
                                # bare `..` in the language. That outer `..` is the STEP
                                # SEPARATOR, not an inclusive-range operator, and stage0
                                # prints it as a literal " .. " (formatExpr's RangeStep arm)
                                # rather than through rangeOpName. Re-spelling it `..=` here
                                # produced `0 ..< 10 ..= 3`, which is not the source form.
                                fmt_push(buffer, "..")
                            else:
                                fmt_range_text: sview = match fmt_operator:
                                    Lexer::TokenKind.RangeLt: "..<"
                                    Lexer::TokenKind.RangeGt: "..>"
                                    _: "..="
                                fmt_push(buffer, fmt_range_text)
                            buffer.push(32)
                            fmt_expr(buffer, fmt_right, tokens, source)
                        else:
                            buffer.push(40)
                            fmt_binary_operand(buffer, fmt_left, tokens, source, false, fmt_operator)
                            buffer.push(32)
                            fmt_operator_name(buffer, fmt_operator)
                            buffer.push(32)
                            fmt_binary_operand(buffer, fmt_right, tokens, source, true, fmt_operator)
                            buffer.push(41)
                    Expr.Paren(fmt_inner, fmt_paren_line):
                        # stage0 SUPPRESSES the group when the inner node already prints its
                        # own pair, so `(C - 1)` in source prints `(C - 1)` — NOT `((C - 1))`.
                        #
                        # This arm previously doubled the pair, matched to stage0's behaviour
                        # at the time. That behaviour was a BUG (fixed upstream 2026-08-14):
                        # it made `-emit fmt` non-idempotent, growing a paren layer on every
                        # pass — `((total * 10) + i)` -> `((((total * 10)) + i))` -> …
                        #
                        # Formatting the inner into a scratch buffer first is what lets the
                        # decision inspect the produced text; the node kind alone is not
                        # enough, because several arms print paren-free (see
                        # fmt_self_parenthesizing).
                        fmt_paren_inner: mutable darray[u8] = []
                        fmt_expr(&fmt_paren_inner, fmt_inner, tokens, source)
                        fmt_paren_wrapped: bool = fmt_paren_inner.count >= 2 and fmt_paren_inner[0] == 40 and fmt_paren_inner[fmt_paren_inner.count - 1] == 41
                        fmt_paren_drop: bool = fmt_paren_wrapped and fmt_self_parenthesizing(fmt_inner)
                        buffer.push(40) if not fmt_paren_drop
                        for fmt_paren_index in 0..<fmt_paren_inner.count |buffer, fmt_paren_inner|:
                            buffer.push(fmt_paren_inner[fmt_paren_index])
                        buffer.push(41) if not fmt_paren_drop
                    Expr.IndexN(fmt_ixn_object, fmt_ixn_args, fmt_ixn_line):
                        # Generic application `f[T, N]` / multi-index `m[i, j]` — stage0's
                        # SpecializeExpr joins the bracket args with ", ".
                        fmt_expr(buffer, fmt_ixn_object, tokens, source)
                        buffer.push(91)
                        fmt_ixn_first: mutable bool = true
                        for fmt_ixn_arg in fmt_ixn_args |buffer, fmt_ixn_first, tokens, source|:
                            fmt_push(buffer, ", ") if not fmt_ixn_first
                            fmt_ixn_first <- false
                            # A VALUE argument (`pick[i64, 4]`) prints stage0's
                            # formatTypeExpr default `<type>` — measured, bug-for-bug.
                            fmt_ixn_is_lit: mutable bool = false
                            if fmt_ixn_arg is Expr.IntLit(fmt_ixn_iv):
                                fmt_ixn_is_lit <- true
                            if fmt_ixn_is_lit:
                                fmt_push(buffer, "<type>")
                            else:
                                fmt_expr(buffer, fmt_ixn_arg, tokens, source)
                        buffer.push(93)
                    Expr.Scope(fmt_scope_base, fmt_scope_name, fmt_scope_line):
                        # A `::` path prints with DOTS (`H.triple`, `Outer.Inner.double`)
                        # — stage0's selector spelling, measured on the module fixtures.
                        fmt_expr(buffer, fmt_scope_base, tokens, source)
                        buffer.push(46)
                        fmt_push(buffer, fmt_scope_name)
                    Expr.Field(fmt_object, fmt_field, fmt_field_line):
                        # MEASURED: a BINARY receiver prints one extra paren layer —
                        # `((a - b)).usize()`.
                        fmt_fld_wrap: mutable bool = false
                        if fmt_object is Expr.Binary(fmt_fld_l, fmt_fld_o, fmt_fld_r, fmt_fld_bl):
                            fmt_fld_wrap <- true
                        # An `&` receiver can ONLY come from source parens (postfix binds
                        # tighter than prefix `&`), and stage0's ParenExpr keeps them.
                        if fmt_object is Expr.Unary(fmt_fld_uo, fmt_fld_ux, fmt_fld_ul):
                            fmt_fld_wrap <- true if fmt_fld_uo == Lexer::TokenKind.Ampersand
                        buffer.push(40) if fmt_fld_wrap
                        fmt_expr(buffer, fmt_object, tokens, source)
                        buffer.push(41) if fmt_fld_wrap
                        buffer.push(46)
                        fmt_push(buffer, fmt_field)
                    Expr.Index(fmt_head, fmt_index_arg, fmt_index_line):
                        # `.cast[TYPE]`: the bracket holds a TYPE, not a value — render it
                        # from the line tokens (`mutable heap Region&`), found as the
                        # bracket after the `cast` ident.
                        fmt_ix_is_cast: mutable bool = false
                        if fmt_head is Expr.Field(fmt_ix_obj, fmt_ix_name, fmt_ix_fl):
                            fmt_ix_is_cast <- true if fmt_ix_name == "cast"
                        fmt_ix_rendered: mutable bool = false
                        if fmt_ix_is_cast:
                            fmt_ix_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, fmt_index_line.line)
                            if fmt_ix_range.found:
                                fmt_ix_end: mutable usize = fmt_ix_range.stop
                                while fmt_ix_end < tokens.count and tokens[fmt_ix_end].line == fmt_index_line.line and tokens[fmt_ix_end].kind != Lexer::TokenKind.Newline |fmt_ix_end, tokens, fmt_index_line|:
                                    fmt_ix_end <- fmt_ix_end + 1
                                if fmt_cast_line != fmt_index_line.line:
                                    fmt_cast_line <- fmt_index_line.line
                                    fmt_cast_claimed <- 0.u64()
                                # This cast's bracket is the (K+1)-th UNCLAIMED `cast[`
                                # in textual order, K = casts inside its own head subtree
                                # (see the note on fmt_cast_claimed).
                                fmt_ix_claimed: u64 = fmt_cast_claimed
                                fmt_ix_skip: mutable i64 = fmt_count_casts(fmt_head, fmt_index_line.line)
                                fmt_ix_open: mutable usize = 0
                                fmt_ix_found: mutable bool = false
                                fmt_ix_ordinal: mutable i64 = 0
                                fmt_ix_chosen: mutable i64 = 0
                                for fmt_ix_probe in fmt_ix_range.start..<fmt_ix_end |fmt_ix_open, fmt_ix_found, fmt_ix_skip, fmt_ix_ordinal, fmt_ix_chosen, tokens, source, fmt_ix_claimed|:
                                    continue if fmt_ix_found
                                    fmt_ix_token: Lexer::Token = tokens[fmt_ix_probe]
                                    continue if fmt_ix_token.kind != Lexer::TokenKind.Ident
                                    continue if Lexer::text_or_empty(fmt_ix_token, source) != "cast"
                                    fmt_ix_bit: i64 = fmt_ix_ordinal
                                    fmt_ix_ordinal <- fmt_ix_ordinal + 1
                                    continue if ((fmt_ix_claimed >> fmt_ix_bit.u64()) & 1.u64()) == 1.u64()
                                    if fmt_ix_skip > 0:
                                        fmt_ix_skip <- fmt_ix_skip - 1
                                    else:
                                        fmt_ix_open <- fmt_ix_probe + 1
                                        fmt_ix_found <- true
                                        fmt_ix_chosen <- fmt_ix_bit
                                fmt_cast_claimed <- fmt_cast_claimed | (1.u64() << fmt_ix_chosen.u64()) if fmt_ix_found
                                if fmt_ix_found and fmt_ix_open < fmt_ix_end and tokens[fmt_ix_open].kind == Lexer::TokenKind.LBracket:
                                    fmt_ix_close: mutable usize = fmt_ix_open
                                    fmt_ix_depth: mutable i64 = 0
                                    fmt_ix_closing: mutable bool = true
                                    while fmt_ix_closing and fmt_ix_close < fmt_ix_end |fmt_ix_close, fmt_ix_depth, fmt_ix_closing, tokens|:
                                        fmt_ix_kind: Lexer::TokenKind = tokens[fmt_ix_close].kind
                                        fmt_ix_depth <- fmt_ix_depth + 1 if fmt_ix_kind == Lexer::TokenKind.LBracket
                                        fmt_ix_depth <- fmt_ix_depth - 1 if fmt_ix_kind == Lexer::TokenKind.RBracket
                                        if fmt_ix_depth == 0 and fmt_ix_kind == Lexer::TokenKind.RBracket:
                                            fmt_ix_closing <- false
                                        else:
                                            fmt_ix_close <- fmt_ix_close + 1
                                    if not fmt_ix_closing:
                                        fmt_expr(buffer, fmt_head, tokens, source)
                                        buffer.push(91)
                                        emit_iface_render_tokens(buffer, tokens, source, fmt_ix_open + 1, fmt_ix_close)
                                        buffer.push(93)
                                        fmt_ix_rendered <- true
                        if not fmt_ix_rendered:
                            fmt_expr(buffer, fmt_head, tokens, source)
                            buffer.push(91)
                            fmt_expr(buffer, fmt_index_arg, tokens, source)
                            buffer.push(93)
                    Expr.Array(fmt_arr_elements, fmt_arr_line):
                        buffer.push(91)
                        fmt_arr_first: mutable bool = true
                        for fmt_arr_element in fmt_arr_elements |buffer, fmt_arr_first, tokens, source|:
                            fmt_push(buffer, ", ") if not fmt_arr_first
                            fmt_arr_first <- false
                            fmt_expr(buffer, fmt_arr_element, tokens, source)
                        buffer.push(93)
                    Expr.SetLit(fmt_set_elements, fmt_set_line):
                        buffer.push(123)
                        fmt_set_first: mutable bool = true
                        for fmt_set_element in fmt_set_elements |buffer, fmt_set_first, tokens, source|:
                            fmt_push(buffer, ", ") if not fmt_set_first
                            fmt_set_first <- false
                            fmt_expr(buffer, fmt_set_element, tokens, source)
                        buffer.push(125)
                    Expr.DictLit(fmt_dict_entries, fmt_dict_line):
                        # MEASURED: stage0 stores a brace dict as a ListLitExpr whose Keys
                        # side-table its unparser never reads — `{1: 10, 2: 20}` prints as
                        # `{10, 20}`, the VALUES alone. Reproduced, quirk and all; the empty
                        # `{}` initializer (the shape the corpus exercises) agrees either way.
                        buffer.push(123)
                        fmt_dict_first: mutable bool = true
                        for fmt_dict_entry in fmt_dict_entries |buffer, fmt_dict_first, tokens, source|:
                            fmt_push(buffer, ", ") if not fmt_dict_first
                            fmt_dict_first <- false
                            fmt_expr(buffer, fmt_dict_entry.value, tokens, source)
                        buffer.push(125)
                    Expr.Slice(fmt_sl_obj, fmt_sl_low, fmt_sl_high, fmt_sl_line):
                        # `s[low:high]` — open bounds print empty, no interior spaces.
                        fmt_expr(buffer, fmt_sl_obj, tokens, source)
                        buffer.push(91)
                        fmt_sl_has_low: bool = not (fmt_sl_low is Expr.Absent)
                        if fmt_sl_has_low:
                            fmt_expr(buffer, fmt_sl_low, tokens, source)
                        buffer.push(58)
                        fmt_sl_has_high: bool = not (fmt_sl_high is Expr.Absent)
                        if fmt_sl_has_high:
                            fmt_expr(buffer, fmt_sl_high, tokens, source)
                        buffer.push(93)
                    Expr.Refinement(fmt_rf_fallback, fmt_rf_guarded, fmt_rf_line):
                        # `try X else FALLBACK` / `get X else FALLBACK` — the parser folds
                        # both into Refinement(fallback, guarded); only `try` prints its
                        # keyword (stage0's TryExpr vs UnwrapElseExpr).
                        if fmt_has_try_before(tokens, source, fmt_stmt_line, fmt_call_head_name(fmt_rf_guarded)):
                            fmt_push(buffer, "try ")
                        fmt_expr(buffer, fmt_rf_guarded, tokens, source)
                        fmt_push(buffer, " else ")
                        fmt_expr(buffer, fmt_rf_fallback, tokens, source)
                    Expr.Call(fmt_callee, fmt_args, fmt_arg_names, fmt_call_line):
                        # `try f(...)` keeps its keyword: the parser erases it into a
                        # side-table annotation, so the tokens are the surviving record.
                        if fmt_has_try_before(tokens, source, fmt_stmt_line, fmt_call_head_name(fmt_callee)):
                            fmt_push(buffer, "try ")
                        # A UFCS method call on a FILE-LEVEL def unparses as the free
                        # call in stage0's AST (`items.add(v)` → `add(items, v)`);
                        # builtin container methods (`xs.push(v)`) keep method form.
                        fmt_call_free: mutable bool = false
                        fmt_call_recv: mutable Ast::Expr = Ast::Expr.Invalid
                        fmt_call_name: mutable sview = ""
                        if fmt_callee is Expr.Field(fmt_cf_obj, fmt_cf_name, fmt_cf_line):
                            fmt_cf_builtin: bool = fmt_cf_name == "push" or fmt_cf_name == "pop" or fmt_cf_name == "put" or fmt_cf_name == "reserve" or fmt_cf_name == "resize" or fmt_cf_name == "extend" or fmt_cf_name == "clear" or fmt_cf_name == "delete" or fmt_cf_name == "contains" or fmt_cf_name == "keys" or fmt_cf_name == "values"
                            # `xs.enumerate()` is sugar for the FREE builtin `enumerate(xs)`
                            # and unparses back to it, with no `def` in the unit to find.
                            fmt_cf_free_builtin: bool = fmt_cf_name == "enumerate" or fmt_cf_name == "zip" or fmt_cf_name == "reversed"
                            if not fmt_cf_builtin and (fmt_cf_free_builtin or fmt_is_file_def(tokens, source, fmt_cf_name)):
                                fmt_call_free <- true
                                fmt_call_recv <- fmt_cf_obj
                                fmt_call_name <- fmt_cf_name
                        if fmt_call_free:
                            fmt_push(buffer, fmt_call_name)
                            buffer.push(40)
                            fmt_expr(buffer, fmt_call_recv, tokens, source)
                            for fmt_free_argument in fmt_args |buffer, tokens, source|:
                                fmt_push(buffer, ", ")
                                fmt_expr(buffer, fmt_free_argument, tokens, source)
                            buffer.push(41)
                            return
                        fmt_expr(buffer, fmt_callee, tokens, source)
                        buffer.push(40)
                        fmt_first: mutable bool = true
                        for fmt_argument in fmt_args |buffer, fmt_first, tokens, source|:
                            fmt_push(buffer, ", ") if not fmt_first
                            fmt_first <- false
                            fmt_expr(buffer, fmt_argument, tokens, source)
                        buffer.push(41)
                    Expr.Move(fmt_mv_operand, fmt_mv_line):
                        # stage0's MoveExpr arm: the keyword and its operand, PAREN-FREE.
                        fmt_push(buffer, "move ")
                        fmt_expr(buffer, fmt_mv_operand, tokens, source)
                    Expr.Unary(fmt_unary_operator, fmt_unary_operand, fmt_unary_line):
                        # `not (x is P)` prints `x is not P`; `not (a in b)` prints
                        # `a not in b`; a plain `not` prints "(not X)"; other unary
                        # operators print "(" OP operand ")" with no inner space.
                        if fmt_unary_operator == Lexer::TokenKind.Not:
                            if fmt_unary_operand is Expr.Binary(fmt_isnot_left, fmt_isnot_op, fmt_isnot_right, fmt_isnot_line):
                                if fmt_isnot_op == Lexer::TokenKind.Is:
                                    fmt_expr(buffer, fmt_isnot_left, tokens, source)
                                    fmt_push(buffer, " is not ")
                                    fmt_expr(buffer, fmt_isnot_right, tokens, source)
                                    return
                                if fmt_isnot_op == Lexer::TokenKind.In:
                                    fmt_expr(buffer, fmt_isnot_left, tokens, source)
                                    fmt_push(buffer, " not in ")
                                    fmt_expr(buffer, fmt_isnot_right, tokens, source)
                                    return
                            fmt_push(buffer, "(not ")
                            fmt_expr(buffer, fmt_unary_operand, tokens, source)
                            buffer.push(41)
                            return
                        if fmt_unary_operator == Lexer::TokenKind.Ampersand:
                            # MEASURED: `&local[0]` prints paren-free.
                            fmt_push(buffer, "&")
                            fmt_expr(buffer, fmt_unary_operand, tokens, source)
                            return
                        buffer.push(40)
                        fmt_operator_name(buffer, fmt_unary_operator)
                        fmt_expr(buffer, fmt_unary_operand, tokens, source)
                        buffer.push(41)
                    Expr.Construct(fmt_ctor_type, fmt_ctor_fields, fmt_ctor_line):
                        fmt_expr(buffer, fmt_ctor_type, tokens, source)
                        buffer.push(123)
                        fmt_ctor_first: mutable bool = true
                        for fmt_ctor_field in fmt_ctor_fields |buffer, fmt_ctor_first, tokens, source|:
                            fmt_push(buffer, ", ") if not fmt_ctor_first
                            fmt_ctor_first <- false
                            # SHORTHAND `Type{data, len}` stays shorthand in stage0 (its
                            # unnamed args carry no label); stage1's parser back-fills the
                            # label, so a label that just restates its Ident value is the
                            # shorthand spelling.
                            fmt_ctor_shorthand: mutable bool = fmt_ctor_field.name == ""
                            if fmt_ctor_field.value is Expr.Ident(fmt_ctor_vn, fmt_ctor_vl):
                                fmt_ctor_shorthand <- true if fmt_ctor_vn == fmt_ctor_field.name
                            if not fmt_ctor_shorthand:
                                fmt_push(buffer, fmt_ctor_field.name)
                                fmt_push(buffer, ": ")
                            fmt_expr(buffer, fmt_ctor_field.value, tokens, source)
                        buffer.push(125)
                    Expr.Comprehension(fmt_q_var, fmt_q_iterable, fmt_q_condition, fmt_q_body, fmt_q_line):
                        # The parser discards the query HEAD (any/all/count/sum/...); it is
                        # recovered as the first query-keyword Ident on the source line.
                        fmt_q_head: mutable sview = "any"
                        fmt_q_seen_head: mutable bool = false
                        fmt_q_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, fmt_q_line.line)
                        if fmt_q_range.found:
                            fmt_q_end: mutable usize = fmt_q_range.stop
                            while fmt_q_end < tokens.count and tokens[fmt_q_end].line == fmt_q_line.line and tokens[fmt_q_end].kind != Lexer::TokenKind.Newline |fmt_q_end, tokens, fmt_q_line|:
                                fmt_q_end <- fmt_q_end + 1
                            fmt_q_seen: mutable bool = false
                            for fmt_q_probe in fmt_q_range.start..<fmt_q_end |fmt_q_head, fmt_q_seen, fmt_q_seen_head, tokens, source|:
                                continue if fmt_q_seen
                                fmt_q_token: Lexer::Token = tokens[fmt_q_probe]
                                continue if fmt_q_token.kind != Lexer::TokenKind.Ident
                                fmt_q_text: sview = Lexer::text_or_empty(fmt_q_token, source)
                                fmt_q_is_head: bool = fmt_q_text == "any" or fmt_q_text == "all" or fmt_q_text == "count" or fmt_q_text == "sum" or fmt_q_text == "product" or fmt_q_text == "min" or fmt_q_text == "max" or fmt_q_text == "first" or fmt_q_text == "forall" or fmt_q_text == "exists"
                                if fmt_q_is_head:
                                    # stage0's keyword switch maps only any/all/first/
                                    # count/each; every other fold (sum/product/min/max,
                                    # forall/exists) falls to its DEFAULT "any" — measured
                                    # on query_folds, reproduced bug-for-bug.
                                    fmt_q_kept: bool = fmt_q_text == "any" or fmt_q_text == "all" or fmt_q_text == "count" or fmt_q_text == "first" or fmt_q_text == "each"
                                    fmt_q_head <- fmt_q_text if fmt_q_kept
                                    fmt_q_seen <- true
                                    fmt_q_seen_head <- true
                        # A LIST COMPREHENSION shares this node with a query: the parser
                        # maps `[x * x for x in xs]` and `any x in xs` to the same
                        # Expr.Comprehension. Rendering both as a query printed
                        # `[x * x for x in 0 ..< n]` as `any x in 0 ..< n` — the brackets and
                        # the BODY silently dropped, so the unparser did not round-trip.
                        #
                        # They are told apart by whether a query HEAD keyword appears on the
                        # line: a comprehension has none. stage0 renders the bracket form
                        # with its body parenthesised.
                        if not fmt_q_seen_head:
                            buffer.push(91)                       # '['
                            fmt_expr(buffer, fmt_q_body, tokens, source)
                            fmt_push(buffer, " for ")
                            fmt_push(buffer, fmt_q_var)
                            fmt_push(buffer, " in ")
                            fmt_expr(buffer, fmt_q_iterable, tokens, source)
                            if not (fmt_q_condition is Expr.Absent):
                                fmt_push(buffer, " if ")
                                fmt_expr(buffer, fmt_q_condition, tokens, source)
                            buffer.push(93)                       # ']'
                        else:
                            fmt_push(buffer, fmt_q_head)
                            buffer.push(32)
                            fmt_push(buffer, fmt_q_var)
                            fmt_push(buffer, " in ")
                            fmt_expr(buffer, fmt_q_iterable, tokens, source)
                            fmt_q_has_condition: bool = not (fmt_q_condition is Expr.Absent)
                            if fmt_q_has_condition:
                                fmt_push(buffer, " where ")
                                fmt_expr(buffer, fmt_q_condition, tokens, source)
                    Expr.Lambda(fmt_lam_params, fmt_lam_body, fmt_lam_line):
                        # `fn(n: i64) => BODY` — the param TYPES live only in the source
                        # (the node keeps names), so the header renders from the LAST
                        # `fn(`-span on the lambda's line (the annotation's own `fn(` type,
                        # if any, precedes it); the body is its single return expression.
                        # The line range CLIPS at the VarDecl's annotation colon, so scan
                        # to the PHYSICAL line end for the last `fn(` (the value lambda; an
                        # annotation's own `fn(` type precedes it).
                        fmt_lam_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, fmt_lam_line.line)
                        fmt_lam_end: mutable usize = fmt_lam_range.stop
                        while fmt_lam_end < tokens.count and tokens[fmt_lam_end].line == fmt_lam_line.line and tokens[fmt_lam_end].kind != Lexer::TokenKind.Newline |fmt_lam_end, tokens, fmt_lam_line|:
                            fmt_lam_end <- fmt_lam_end + 1
                        fmt_lam_open: mutable usize = 0
                        fmt_lam_found: mutable bool = false
                        if fmt_lam_range.found:
                            for fmt_lam_probe in fmt_lam_range.start..<fmt_lam_end |fmt_lam_open, fmt_lam_found, tokens, source|:
                                fmt_lam_token: Lexer::Token = tokens[fmt_lam_probe]
                                continue if fmt_lam_token.kind != Lexer::TokenKind.Ident
                                continue if Lexer::text_or_empty(fmt_lam_token, source) != "fn"
                                fmt_lam_open <- fmt_lam_probe
                                fmt_lam_found <- true
                        if fmt_lam_found:
                            fmt_lam_close: mutable usize = fmt_lam_open + 1
                            fmt_lam_depth: mutable i64 = 0
                            fmt_lam_closing: mutable bool = true
                            while fmt_lam_closing and fmt_lam_close < fmt_lam_end |fmt_lam_close, fmt_lam_depth, fmt_lam_closing, tokens|:
                                fmt_lam_kind: Lexer::TokenKind = tokens[fmt_lam_close].kind
                                fmt_lam_depth <- fmt_lam_depth + 1 if fmt_lam_kind == Lexer::TokenKind.LParen
                                fmt_lam_depth <- fmt_lam_depth - 1 if fmt_lam_kind == Lexer::TokenKind.RParen
                                if fmt_lam_depth == 0 and fmt_lam_kind == Lexer::TokenKind.RParen:
                                    fmt_lam_closing <- false
                                else:
                                    fmt_lam_close <- fmt_lam_close + 1
                            if fmt_lam_body.count == 0:
                                # A bare fn TYPE in expression position (`call_as[fn(
                                # mutable void&) -> void&]`) parses to a Lambda with no
                                # body; render the whole type span — through the `-> T`
                                # tail — from the tokens.
                                fmt_lam_type_stop: mutable usize = fmt_lam_close + 1
                                fmt_lam_type_depth: mutable i64 = 0
                                fmt_lam_type_scan: mutable bool = true
                                while fmt_lam_type_scan and fmt_lam_type_stop < fmt_lam_end |fmt_lam_type_stop, fmt_lam_type_depth, fmt_lam_type_scan, tokens|:
                                    fmt_lam_tk: Lexer::TokenKind = tokens[fmt_lam_type_stop].kind
                                    fmt_lam_type_depth <- fmt_lam_type_depth + 1 if fmt_lam_tk == Lexer::TokenKind.LParen or fmt_lam_tk == Lexer::TokenKind.LBracket
                                    fmt_lam_type_depth <- fmt_lam_type_depth - 1 if fmt_lam_tk == Lexer::TokenKind.RParen or fmt_lam_tk == Lexer::TokenKind.RBracket
                                    if fmt_lam_type_depth < 0 or (fmt_lam_type_depth == 0 and (fmt_lam_tk == Lexer::TokenKind.Comma or fmt_lam_tk == Lexer::TokenKind.Colon)):
                                        fmt_lam_type_scan <- false
                                    else:
                                        fmt_lam_type_stop <- fmt_lam_type_stop + 1
                                emit_iface_render_tokens(buffer, tokens, source, fmt_lam_open, fmt_lam_type_stop)
                                return
                            emit_iface_render_tokens(buffer, tokens, source, fmt_lam_open, fmt_lam_close + 1)
                            fmt_push(buffer, " => ")
                            fmt_lam_printed: mutable bool = false
                            if fmt_lam_body.count == 1:
                                if fmt_lam_body[0] is Stmt.Return(fmt_lam_ret, fmt_lam_ret_line):
                                    if fmt_lam_ret is fmt_lam_ret_expr:
                                        fmt_expr(buffer, fmt_lam_ret_expr, tokens, source)
                                        fmt_lam_printed <- true
                            fmt_push(buffer, "<fmt-lambda-body-todo>") if not fmt_lam_printed
                        else:
                            fmt_push(buffer, "<fmt-lambda-todo>")
                    _:
                        # MEASURED: `<expr>` is stage0's formatExpr DEFAULT (unparse line
                        # 367) — the faithful catch-all. A stage1 fall-through where stage0
                        # HAS a real arm still diffs, so coverage gaps stay catchable; a
                        # fall-through where stage0 also falls through is TRUE parity.
                        fmt_push(buffer, "<expr>")

        # The STATEMENT half, first arms: Return / Assign / expression statements print
        # their canonical single-line forms at `indent` spaces. Block statements (If/
        # While/For/Match, postfix-if desugaring, VarDecl annotations) follow next.
        def fmt_stmt_source_line(statement: Ast::Stmt) -> u32:
            can Abort.Panic:
                match statement:
                    Stmt.Expr(sl_e, sl_line):
                        return sl_line.line
                    Stmt.Block(sl_k, sl_c, sl_b, sl_body, sl_line):
                        return sl_line.line
                    Stmt.VarDecl(sl_n, sl_t, sl_v, sl_line):
                        return sl_line.line
                    Stmt.Assign(sl_at, sl_ao, sl_av, sl_line):
                        return sl_line.line
                    Stmt.If(sl_ic, sl_it, sl_ie, sl_line):
                        return sl_line.line
                    Stmt.While(sl_wc, sl_wb, sl_line):
                        return sl_line.line
                    Stmt.For(sl_fb, sl_fv, sl_fi, sl_fbody, sl_line):
                        return sl_line.line
                    Stmt.Return(sl_rv, sl_line):
                        return sl_line.line
                    Stmt.Match(sl_ms, sl_ma, sl_line):
                        return sl_line.line
                    Stmt.Contract(sl_ck, sl_ce, sl_line):
                        return sl_line.line
                    _:
                        return 0

        def fmt_stmt(buffer: mutable darray[u8]&, statement: Ast::Stmt, indent: i64, tokens: darray[Lexer::Token]&, source: u8&) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                fmt_stmt_line <- fmt_stmt_source_line(statement)
                match statement:
                    Stmt.Return(fmt_ret_value, fmt_ret_line):
                        fmt_indent(buffer, indent)
                        fmt_push(buffer, "return")
                        if fmt_ret_value is fmt_ret_expr:
                            buffer.push(32)
                            fmt_expr(buffer, fmt_ret_expr, tokens, source)
                        # A source-postfix grant (`return X can E1, E2`) leaves a plain
                        # Return node; the grants render from the line tokens.
                        fmt_ret_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, fmt_ret_line.line)
                        if fmt_ret_range.found and fmt_ret_line.line != fmt_can_claimed_line:
                            fmt_ret_end: mutable usize = fmt_ret_range.stop
                            while fmt_ret_end < tokens.count and tokens[fmt_ret_end].line == fmt_ret_line.line and tokens[fmt_ret_end].kind != Lexer::TokenKind.Newline |fmt_ret_end, tokens, fmt_ret_line|:
                                fmt_ret_end <- fmt_ret_end + 1
                            fmt_ret_can: mutable usize = 0
                            fmt_ret_can_found: mutable bool = false
                            fmt_ret_depth: mutable i64 = 0
                            for fmt_ret_probe in fmt_ret_range.start..<fmt_ret_end |fmt_ret_can, fmt_ret_can_found, fmt_ret_depth, tokens, source|:
                                fmt_ret_kind: Lexer::TokenKind = tokens[fmt_ret_probe].kind
                                fmt_ret_depth <- fmt_ret_depth + 1 if fmt_ret_kind == Lexer::TokenKind.LParen or fmt_ret_kind == Lexer::TokenKind.LBracket
                                fmt_ret_depth <- fmt_ret_depth - 1 if fmt_ret_kind == Lexer::TokenKind.RParen or fmt_ret_kind == Lexer::TokenKind.RBracket
                                continue if fmt_ret_can_found
                                continue if fmt_ret_depth != 0 or fmt_ret_kind != Lexer::TokenKind.Ident
                                if Lexer::text_or_empty(tokens[fmt_ret_probe], source) == "can":
                                    fmt_ret_can <- fmt_ret_probe
                                    fmt_ret_can_found <- true
                            if fmt_ret_can_found:
                                fmt_push(buffer, " can ")
                                emit_iface_render_tokens(buffer, tokens, source, fmt_ret_can + 1, fmt_ret_end)
                        buffer.push(10)
                    Stmt.Assign(fmt_as_target, fmt_as_operator, fmt_as_value, fmt_as_line):
                        fmt_indent(buffer, indent)
                        # A Binary `as` TARGET is stage0's AsRefAssignStmt — the statement
                        # spelling `target as & <- v`, never the expression parens.
                        fmt_as_handled: mutable bool = false
                        if fmt_as_target is Expr.Binary(fmt_as_bl, fmt_as_bo, fmt_as_br, fmt_as_bline):
                            if fmt_as_bo == Lexer::TokenKind.As:
                                fmt_expr(buffer, fmt_as_bl, tokens, source)
                                fmt_push(buffer, " as ")
                                fmt_expr(buffer, fmt_as_br, tokens, source)
                                fmt_as_handled <- true
                        if not fmt_as_handled:
                            fmt_expr(buffer, fmt_as_target, tokens, source)
                        # `=` DEFINES a binding (`_ = f()` discards); `<-` mutates; an
                        # AUGMENTED assignment keeps its own operator spelling (stage0's
                        # AugAssignStmt arm prints lexer.TokenName(op) verbatim).
                        fmt_assignment_text: sview = match fmt_as_operator:
                            Lexer::TokenKind.Assign: " = "
                            Lexer::TokenKind.PlusEq: " += "
                            Lexer::TokenKind.MinusEq: " -= "
                            Lexer::TokenKind.StarEq: " *= "
                            Lexer::TokenKind.SlashEq: " /= "
                            Lexer::TokenKind.PercentEq: " %= "
                            Lexer::TokenKind.CaretEq: " ^= "
                            Lexer::TokenKind.PipeEq: " |= "
                            Lexer::TokenKind.AmpEq: " &= "
                            Lexer::TokenKind.LShiftEq: " <<= "
                            Lexer::TokenKind.RShiftEq: " >>= "
                            Lexer::TokenKind.QAssign: " ?= "
                            _: " <- "
                        fmt_push(buffer, fmt_assignment_text)
                        fmt_expr(buffer, fmt_as_value, tokens, source)
                        # A source-postfix grant (`_ = write(...) can Console`) is a side
                        # table, not a node — recover it from the line tokens.
                        fmt_render_postfix_can(buffer, tokens, source, fmt_as_line.line)
                        buffer.push(10)
                    Stmt.Expr(fmt_es_expr, fmt_es_line):
                        # A statement-position BLOCK expression is the parser's lowering
                        # for a capture-list loop (`for … |x|:`); stage0 unparses that
                        # desugar as `if true:` over the loop. Handled before the plain
                        # expression print so it renders as lines, not `<expr>`.
                        if fmt_es_expr is Expr.Block(fmt_es_stmts, fmt_es_value, fmt_es_caps, fmt_es_bl):
                            if fmt_es_stmts.count > 0:
                                # A RESULT-carrying capture list (`for … |t| -> t:`) is
                                # stage0's ExprBlock and prints `do:` with the result on
                                # its own line; the plain capture list is an if-true
                                # statement. MEASURED both ways on a two-loop probe.
                                fmt_es_has_value: bool = not (fmt_es_value is Expr.Absent) and not (fmt_es_value is Expr.Invalid)
                                fmt_indent(buffer, indent)
                                fmt_push(buffer, "do:\n" if fmt_es_has_value else "if true:\n")
                                fmt_stmts(buffer, fmt_es_stmts, indent + 4, tokens, source)
                                if fmt_es_has_value:
                                    fmt_indent(buffer, indent + 4)
                                    fmt_expr(buffer, fmt_es_value, tokens, source)
                                    buffer.push(10)
                                return
                            fmt_indent(buffer, indent)
                            # `submit CALL(arg)` inside a nursery: stage0's parser turned
                            # it into the group-collecting `task_group_add(…,
                            # pool_submit1(…))`. stage1 keeps a bare value-Block, so the
                            # call is rebuilt here. Only the IMPLICIT form is a nursery
                            # submission — `submit[pool] …` names its own pool.
                            if fmt_nursery_active > 0 and fmt_line_is_implicit_submit(tokens, source, fmt_es_line.line):
                                fmt_push(buffer, "task_group_add(__nursery_grp_")
                                fmt_push_decimal(buffer, fmt_nursery_active)
                                fmt_push(buffer, ".ref[TaskGroup&], pool_submit1(__nursery_pool_")
                                fmt_push_decimal(buffer, fmt_nursery_active)
                                fmt_push(buffer, ".ref[ThreadPool&], ")
                                if fmt_es_value is Expr.Call(fmt_su_callee, fmt_su_args, fmt_su_names, fmt_su_cl):
                                    fmt_expr(buffer, fmt_su_callee, tokens, source)
                                    fmt_push(buffer, ", ")
                                    fmt_expr(buffer, fmt_su_args[0], tokens, source) if fmt_su_args.count > 0
                                fmt_push(buffer, "))")
                                buffer.push(10)
                                return
                            fmt_push(buffer, "if true:\n")
                            return
                        fmt_indent(buffer, indent)
                        # `pass` lowers to Stmt.Expr(Expr.Invalid) — print the keyword.
                        fmt_es_is_pass: mutable bool = false
                        if fmt_es_expr is Expr.Invalid:
                            fmt_es_is_pass <- true
                        # `raise X` is a statement keyword, not a call — stage0 prints it
                        # unparenthesized.
                        fmt_es_is_raise: mutable bool = false
                        if fmt_es_expr is Expr.Call(fmt_es_callee, fmt_es_args, fmt_es_argnames, fmt_es_cl):
                            if fmt_es_callee is Expr.Ident(fmt_es_cn, fmt_es_cil):
                                fmt_es_is_raise <- true if fmt_es_cn == "raise" and fmt_es_args.count == 1
                        if fmt_es_is_pass:
                            fmt_push(buffer, "pass")
                        elif fmt_es_is_raise:
                            if fmt_es_expr is Expr.Call(fmt_es_callee2, fmt_es_args2, fmt_es_argnames2, fmt_es_cl2):
                                fmt_push(buffer, "raise ")
                                fmt_expr(buffer, fmt_es_args2[0], tokens, source)
                        else:
                            fmt_expr(buffer, fmt_es_expr, tokens, source)
                        # A source-postfix grant (`f(x) can E1, E2`) is a side table, not a
                        # node — recovered from the line tokens, as on returns.
                        fmt_render_postfix_can(buffer, tokens, source, fmt_es_line.line)
                        buffer.push(10)
                    Stmt.If(fmt_if_cond, fmt_if_then, fmt_if_else, fmt_if_line):
                        # The canonical block form — the desugaring target for postfix
                        # `STMT if COND` per the measured stage0 behavior.
                        fmt_indent(buffer, indent)
                        fmt_push(buffer, "if ")
                        fmt_expr(buffer, fmt_if_cond, tokens, source)
                        # A HEADER grant (`if f(...) can E:`) parses as a one-Block(can)
                        # then-body; stage0 keeps the grant on the header. Detect the
                        # `can` in the header line (the range stops at the colon) and
                        # unwrap the block.
                        fmt_if_unwrap: mutable bool = false
                        if fmt_if_then.count == 1:
                            if fmt_if_then[0] is Stmt.Block(fmt_if_bk, fmt_if_bc, fmt_if_bb, fmt_if_bbody, fmt_if_bl):
                                if fmt_if_bk == "can" and fmt_if_bl.line == fmt_if_line.line:
                                    fmt_if_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, fmt_if_line.line)
                                    if fmt_if_range.found:
                                        fmt_if_can: mutable usize = 0
                                        fmt_if_can_found: mutable bool = false
                                        fmt_if_depth: mutable i64 = 0
                                        for fmt_if_probe in fmt_if_range.start..<fmt_if_range.stop |fmt_if_can, fmt_if_can_found, fmt_if_depth, tokens, source|:
                                            fmt_if_kind: Lexer::TokenKind = tokens[fmt_if_probe].kind
                                            fmt_if_depth <- fmt_if_depth + 1 if fmt_if_kind == Lexer::TokenKind.LParen or fmt_if_kind == Lexer::TokenKind.LBracket
                                            fmt_if_depth <- fmt_if_depth - 1 if fmt_if_kind == Lexer::TokenKind.RParen or fmt_if_kind == Lexer::TokenKind.RBracket
                                            continue if fmt_if_can_found
                                            continue if fmt_if_depth != 0 or fmt_if_kind != Lexer::TokenKind.Ident
                                            if Lexer::text_or_empty(tokens[fmt_if_probe], source) == "can":
                                                continue if fmt_if_probe + 1 < fmt_if_range.stop and tokens[fmt_if_probe + 1].kind == Lexer::TokenKind.LBracket
                                                fmt_if_can <- fmt_if_probe
                                                fmt_if_can_found <- true
                                        if fmt_if_can_found:
                                            fmt_push(buffer, " can ")
                                            emit_iface_render_tokens(buffer, tokens, source, fmt_if_can + 1, fmt_if_range.stop)
                                            fmt_if_unwrap <- true
                        # The postfix guard form (`X return if COND can E`): the body is the
                        # ONE statement the guard wrapped, on the `if`'s own line. The grant
                        # belongs to the synthesized header — claim the line so the body
                        # statement does not print it again.
                        if not fmt_if_unwrap and fmt_if_then.count == 1 and fmt_if_else.count == 0:
                            if fmt_stmt_source_line(fmt_if_then[0]) == fmt_if_line.line:
                                fmt_can_claimed_line <- fmt_if_line.line if fmt_render_guard_can(buffer, tokens, source, fmt_if_line.line)
                        fmt_push(buffer, ":")
                        buffer.push(10)
                        if fmt_if_unwrap:
                            if fmt_if_then[0] is Stmt.Block(fmt_if_uk, fmt_if_uc, fmt_if_ub, fmt_if_ubody, fmt_if_ul):
                                fmt_stmts(buffer, fmt_if_ubody, indent + 4, tokens, source)
                        else:
                            fmt_stmts(buffer, fmt_if_then, indent + 4, tokens, source)
                        if fmt_if_else.count > 0:
                            fmt_indent(buffer, indent)
                            fmt_push(buffer, "else:")
                            buffer.push(10)
                            fmt_stmts(buffer, fmt_if_else, indent + 4, tokens, source)
                    Stmt.While(fmt_wh_cond, fmt_wh_body, fmt_wh_line):
                        fmt_indent(buffer, indent)
                        fmt_push(buffer, "while ")
                        fmt_expr(buffer, fmt_wh_cond, tokens, source)
                        fmt_push(buffer, ":")
                        buffer.push(10)
                        fmt_stmts(buffer, fmt_wh_body, indent + 4, tokens, source)
                    Stmt.For(fmt_for_bind, fmt_for_vars, fmt_for_iterable, fmt_for_body, fmt_for_line):
                        fmt_indent(buffer, indent)
                        fmt_push(buffer, "for ")
                        fmt_for_first: mutable bool = true
                        for fmt_for_variable in fmt_for_vars |buffer, fmt_for_first|:
                            fmt_push(buffer, ", ") if not fmt_for_first
                            fmt_for_first <- false
                            fmt_push(buffer, fmt_for_variable)
                        fmt_push(buffer, " in ")
                        fmt_expr(buffer, fmt_for_iterable, tokens, source)
                        fmt_push(buffer, ":")
                        buffer.push(10)
                        fmt_stmts(buffer, fmt_for_body, indent + 4, tokens, source)
                    Stmt.VarDecl(fmt_vd_name, fmt_vd_type, fmt_vd_value, fmt_vd_line):
                        # `name: TYPE = VALUE` — the annotation prints through fmt_expr
                        # (type annotations ARE expressions in this AST); an absent
                        # annotation prints the bare `name = VALUE` declaration form.
                        # The annotation renders from the LINE TOKENS (colon to `=`):
                        # `mutable`/`@region` markers live outside the type Expr, and the
                        # gap render IS the normalized spelling. The VALUE goes through
                        # fmt_expr for the canonical parenthesization.
                        fmt_indent(buffer, indent)
                        fmt_push(buffer, fmt_vd_name)
                        fmt_vd_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, fmt_vd_line.line)
                        fmt_vd_rendered: mutable bool = false
                        if fmt_vd_range.found:
                            fmt_vd_colon: usize = fmt_vd_range.stop
                            fmt_vd_eq: mutable usize = 0
                            fmt_vd_eq_found: mutable bool = false
                            fmt_vd_probe: mutable usize = fmt_vd_colon + 1
                            while fmt_vd_probe < tokens.count and tokens[fmt_vd_probe].line == fmt_vd_line.line and tokens[fmt_vd_probe].kind != Lexer::TokenKind.Newline |fmt_vd_probe, fmt_vd_eq, fmt_vd_eq_found|:
                                if not fmt_vd_eq_found and tokens[fmt_vd_probe].kind == Lexer::TokenKind.Assign:
                                    fmt_vd_eq <- fmt_vd_probe
                                    fmt_vd_eq_found <- true
                                fmt_vd_probe <- fmt_vd_probe + 1
                            if fmt_vd_eq_found and fmt_vd_eq > fmt_vd_colon + 1:
                                fmt_push(buffer, ": ")
                                emit_iface_render_tokens(buffer, tokens, source, fmt_vd_colon + 1, fmt_vd_eq)
                                fmt_vd_rendered <- true
                        if not fmt_vd_rendered:
                            fmt_vd_has_type: bool = not (fmt_vd_type is Expr.Absent) and not (fmt_vd_type is Expr.Invalid)
                            if fmt_vd_has_type:
                                fmt_push(buffer, ": ")
                                fmt_expr(buffer, fmt_vd_type, tokens, source)
                        # An UNINITIALISED declaration (`text: u8[9]`) has no value node —
                        # stage0 omits the whole `= …` clause rather than printing a
                        # placeholder for it.
                        if not (fmt_vd_value is Expr.Absent) and not (fmt_vd_value is Expr.Invalid):
                            fmt_push(buffer, " = ")
                            # A `get EXPR` initializer is stage0's GetExpr — its unparser
                            # prints the `<expr>` placeholder for the whole value. The
                            # `get` keyword lives only in the line tokens.
                            fmt_vd_is_get: mutable bool = false
                            if fmt_vd_range.found:
                                fmt_vd_get_probe: mutable usize = fmt_vd_range.stop + 1
                                fmt_vd_get_scan: mutable bool = true
                                while fmt_vd_get_scan and fmt_vd_get_probe < tokens.count and tokens[fmt_vd_get_probe].line == fmt_vd_line.line |fmt_vd_get_probe, fmt_vd_get_scan, fmt_vd_is_get, tokens, source|:
                                    if tokens[fmt_vd_get_probe].kind == Lexer::TokenKind.Assign and fmt_vd_get_probe + 1 < tokens.count:
                                        fmt_vd_get_scan <- false
                                        if tokens[fmt_vd_get_probe + 1].kind == Lexer::TokenKind.Ident:
                                            fmt_vd_is_get <- true if Lexer::text_or_empty(tokens[fmt_vd_get_probe + 1], source) == "get"
                                    else:
                                        fmt_vd_get_probe <- fmt_vd_get_probe + 1
                            if fmt_vd_is_get:
                                fmt_push(buffer, "<expr>")
                            else:
                                fmt_expr(buffer, fmt_vd_value, tokens, source)
                        # A source-postfix grant (`x: T = f() can E1, E2`) is a side table,
                        # not a node — render it from the line tokens past the annotation.
                        if fmt_vd_range.found:
                            fmt_vd_end: mutable usize = fmt_vd_range.stop
                            while fmt_vd_end < tokens.count and tokens[fmt_vd_end].line == fmt_vd_line.line and tokens[fmt_vd_end].kind != Lexer::TokenKind.Newline |fmt_vd_end, tokens, fmt_vd_line|:
                                fmt_vd_end <- fmt_vd_end + 1
                            fmt_vd_can: mutable usize = 0
                            fmt_vd_can_found: mutable bool = false
                            fmt_vd_grant_stop: mutable usize = fmt_vd_end
                            fmt_vd_depth: mutable i64 = 0
                            for fmt_vd_scan in fmt_vd_range.stop..<fmt_vd_end |fmt_vd_can, fmt_vd_can_found, fmt_vd_grant_stop, fmt_vd_depth, tokens, source, fmt_vd_end|:
                                fmt_vd_kind: Lexer::TokenKind = tokens[fmt_vd_scan].kind
                                fmt_vd_depth <- fmt_vd_depth + 1 if fmt_vd_kind == Lexer::TokenKind.LParen or fmt_vd_kind == Lexer::TokenKind.LBracket
                                fmt_vd_depth <- fmt_vd_depth - 1 if fmt_vd_kind == Lexer::TokenKind.RParen or fmt_vd_kind == Lexer::TokenKind.RBracket
                                fmt_vd_grant_stop <- fmt_vd_scan if fmt_vd_can_found and fmt_vd_depth == 0 and fmt_vd_kind == Lexer::TokenKind.If and fmt_vd_scan < fmt_vd_grant_stop
                                continue if fmt_vd_can_found
                                continue if fmt_vd_depth != 0 or fmt_vd_kind != Lexer::TokenKind.Ident
                                if Lexer::text_or_empty(tokens[fmt_vd_scan], source) == "can":
                                    # `can[` is a TYPE'S effect row, not a grant.
                                    continue if fmt_vd_scan + 1 < fmt_vd_end and tokens[fmt_vd_scan + 1].kind == Lexer::TokenKind.LBracket
                                    fmt_vd_can <- fmt_vd_scan
                                    fmt_vd_can_found <- true
                            if fmt_vd_can_found:
                                fmt_push(buffer, " can ")
                                emit_iface_render_tokens(buffer, tokens, source, fmt_vd_can + 1, fmt_vd_grant_stop)
                        buffer.push(10)
                    Stmt.Block(fmt_bl_kind, fmt_bl_clause, fmt_bl_binding, fmt_bl_body, fmt_bl_line):
                        # The statement-form region (`region r(4096)` — name in the BINDING
                        # slot, empty body) and `destroy r` print their single-line forms;
                        # a prefixed block (`region r:`, `in owner:`, `trusted E:`) prints
                        # its header with the clause and recurses. Unknown kinds stay loud.
                        if fmt_bl_kind == "can" and fmt_line_has_handler_install(tokens, source, fmt_bl_line.line):
                            # Static handler installs are normalized to ordinary `can` blocks
                            # in the compact AST, but their source header and effect calls are
                            # part of the user-facing language. Render this block from tokens
                            # so formatting never leaks hidden ABI names.
                            fmt_block_from_source_at_indent(buffer, tokens, source, fmt_bl_line.line, indent)
                        elif fmt_bl_kind == "destroy" and fmt_bl_clause.count == 1:
                            fmt_indent(buffer, indent)
                            fmt_push(buffer, "destroy ")
                            fmt_push(buffer, fmt_bl_clause[0])
                            buffer.push(10)
                        elif fmt_bl_kind == "region" and fmt_bl_binding != "" and fmt_bl_body.count == 0:
                            # The capacity is parsed-and-dropped, so the statement renders
                            # from its source line tokens (`region scratch(4096)`).
                            fmt_indent(buffer, indent)
                            fmt_bl_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, fmt_bl_line.line)
                            if fmt_bl_range.found:
                                emit_iface_render_tokens(buffer, tokens, source, fmt_bl_range.start, fmt_bl_range.stop)
                            else:
                                fmt_push(buffer, "region ")
                                fmt_push(buffer, fmt_bl_binding)
                            buffer.push(10)
                        elif fmt_bl_kind == "static_assert":
                            # Compile-time; registered in the side tables, prints nothing.
                            pass
                        elif fmt_bl_kind == "can" and fmt_bl_body.count == 1 and fmt_can_is_postfixable(fmt_bl_body[0], tokens):
                            # A one-statement effect grant prints POSTFIX, as stage0 does:
                            # `assert_true(...) can Abort.Panic` — except a `panic(...)`
                            # statement, which stage0 keeps in block form.
                            fmt_can_done: mutable bool = false
                            fmt_can_stmt_line: u32 = fmt_stmt_source_line(fmt_bl_body[0])
                            if fmt_bl_body[0] is Stmt.Return(fmt_can_ret, fmt_can_rline):
                                fmt_indent(buffer, indent)
                                fmt_push(buffer, "return")
                                if fmt_can_ret is fmt_can_ret_expr:
                                    buffer.push(32)
                                    fmt_stmt_line <- fmt_can_rline.line
                                    # A TRY value takes surface parens under a `can`.
                                    fmt_can_ret_try: bool = fmt_expr_is_try_form(fmt_can_ret_expr, tokens, source, fmt_can_rline.line)
                                    buffer.push(40) if fmt_can_ret_try
                                    fmt_expr(buffer, fmt_can_ret_expr, tokens, source)
                                    buffer.push(41) if fmt_can_ret_try
                                fmt_can_done <- true
                            if not fmt_can_done and fmt_bl_body[0] is Stmt.Expr(fmt_can_expr, fmt_can_line):
                                fmt_indent(buffer, indent)
                                fmt_stmt_line <- fmt_can_line.line
                                fmt_can_expr_try: bool = fmt_expr_is_try_form(fmt_can_expr, tokens, source, fmt_can_line.line)
                                buffer.push(40) if fmt_can_expr_try
                                fmt_expr(buffer, fmt_can_expr, tokens, source)
                                buffer.push(41) if fmt_can_expr_try
                                fmt_can_done <- true
                            if not fmt_can_done:
                                # Every other postfixable kind (a `catch …:` handler, an
                                # assignment/discard, a var decl): stage0 renders the full
                                # statement and appends the grant to its LAST line, so
                                # drop the trailing newline before the clause.
                                fmt_stmt_line <- fmt_can_stmt_line
                                fmt_stmt(buffer, fmt_bl_body[0], indent, tokens, source)
                                if buffer.count > 0:
                                    if buffer[buffer.count - 1] == 10:
                                        _ = buffer.pop()
                                fmt_can_done <- true
                            if fmt_can_done:
                                fmt_push(buffer, " can")
                                fmt_can_first: mutable bool = true
                                for fmt_can_word in fmt_bl_clause |buffer, fmt_can_first|:
                                    fmt_push(buffer, "," ) if not fmt_can_first
                                    buffer.push(32)
                                    fmt_push(buffer, fmt_can_word)
                                    fmt_can_first <- false
                                buffer.push(10)
                            else:
                                fmt_indent(buffer, indent)
                                fmt_push(buffer, "<fmt-can-todo>")
                                buffer.push(10)
                        elif fmt_bl_kind == "region" and fmt_bl_body.count > 0:
                            # A region BLOCK prints stage0's canonical lowering:
                            # `with arena NAME(cap) as :` — name and capacity from the
                            # block clause (["name", "cap"]).
                            fmt_indent(buffer, indent)
                            fmt_push(buffer, "with arena ")
                            fmt_push(buffer, fmt_bl_clause[0]) if fmt_bl_clause.count > 0
                            if fmt_bl_clause.count > 1:
                                buffer.push(40)
                                fmt_push(buffer, fmt_bl_clause[1])
                                buffer.push(41)
                            fmt_push(buffer, " as :")
                            buffer.push(10)
                            fmt_stmts(buffer, fmt_bl_body, indent + 4, tokens, source)
                        elif fmt_bl_kind == "static" and fmt_bl_body.count == 1 and fmt_static_is_directive(tokens, source, fmt_bl_line.line):
                            # `static error("...")` — a static DIRECTIVE statement prints
                            # inline, not as a chain header.
                            if fmt_bl_body[0] is Stmt.Expr(fmt_sd_expr, fmt_sd_line):
                                fmt_indent(buffer, indent)
                                fmt_push(buffer, "static ")
                                fmt_expr(buffer, fmt_sd_expr, tokens, source)
                                buffer.push(10)
                            else:
                                fmt_indent(buffer, indent)
                                fmt_push(buffer, "<fmt-static-todo>")
                                buffer.push(10)
                        elif fmt_bl_kind == "static" and fmt_bl_body.count > 0:
                            # Statement-level `static if/elif` parenthesizes its multi-
                            # token condition, exactly like the declaration-level chain.
                            fmt_indent(buffer, indent)
                            fmt_sb_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, fmt_bl_line.line)
                            if fmt_sb_range.found:
                                fmt_sb_cond: mutable usize = fmt_sb_range.start
                                fmt_sb_seen: mutable bool = false
                                for fmt_sb_probe in fmt_sb_range.start..<fmt_sb_range.stop |fmt_sb_cond, fmt_sb_seen, tokens|:
                                    continue if fmt_sb_seen
                                    fmt_sb_kind_t: Lexer::TokenKind = tokens[fmt_sb_probe].kind
                                    fmt_sb_is_head: bool = fmt_sb_kind_t == Lexer::TokenKind.Static or fmt_sb_kind_t == Lexer::TokenKind.If or fmt_sb_kind_t == Lexer::TokenKind.Elif or fmt_sb_kind_t == Lexer::TokenKind.Else
                                    if fmt_sb_is_head:
                                        fmt_sb_cond <- fmt_sb_probe + 1
                                    else:
                                        fmt_sb_seen <- true
                                emit_iface_render_tokens(buffer, tokens, source, fmt_sb_range.start, fmt_sb_cond)
                                if fmt_sb_cond < fmt_sb_range.stop:
                                    fmt_sb_multi: bool = fmt_sb_range.stop - fmt_sb_cond > 1
                                    fmt_push(buffer, " (" if fmt_sb_multi else " ")
                                    emit_iface_render_tokens(buffer, tokens, source, fmt_sb_cond, fmt_sb_range.stop)
                                    fmt_push(buffer, ")") if fmt_sb_multi
                            else:
                                fmt_push(buffer, "static")
                            fmt_push(buffer, ":")
                            buffer.push(10)
                            fmt_stmts(buffer, fmt_bl_body, indent + 4, tokens, source)
                        elif fmt_bl_body.count > 0 and (fmt_bl_kind == "in" or fmt_bl_kind == "trusted" or fmt_bl_kind == "can"):
                            # The header renders from the SOURCE LINE: `trusted
                            # Unsafe.PointerCast, Unsafe.PointerArithmetic:` keeps its
                            # grant list (the node's clause drops the dotted spellings).
                            fmt_indent(buffer, indent)
                            fmt_bl_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, fmt_bl_line.line)
                            if fmt_bl_range.found:
                                # stage0 prints grant lists UNBRACKETED: `trusted A, B:`
                                # for a source `trusted [A, B]:` — render token by token,
                                # skipping the brackets.
                                fmt_bh_prev_gap: mutable u32 = 0
                                fmt_bh_have: mutable bool = false
                                for fmt_bh_index in fmt_bl_range.start..<fmt_bl_range.stop |buffer, tokens, source, fmt_bh_prev_gap, fmt_bh_have|:
                                    fmt_bh_token: Lexer::Token = tokens[fmt_bh_index]
                                    continue if fmt_bh_token.kind == Lexer::TokenKind.LBracket or fmt_bh_token.kind == Lexer::TokenKind.RBracket
                                    continue if fmt_bh_token.kind == Lexer::TokenKind.Newline or fmt_bh_token.kind == Lexer::TokenKind.Indent or fmt_bh_token.kind == Lexer::TokenKind.Dedent
                                    buffer.push(32) if fmt_bh_have and (fmt_bh_token.start > fmt_bh_prev_gap or fmt_bh_prev_gap == 1)
                                    fmt_bh_text: sview = Lexer::text_or_empty(fmt_bh_token, source)
                                    emit_tokens_push_sview(buffer, fmt_bh_text)
                                    fmt_bh_prev_gap <- 1 if fmt_bh_token.kind == Lexer::TokenKind.Comma else fmt_bh_token.start + fmt_bh_token.length
                                    fmt_bh_have <- true
                            else:
                                fmt_push(buffer, fmt_bl_kind)
                            fmt_push(buffer, ":")
                            buffer.push(10)
                            fmt_stmts(buffer, fmt_bl_body, indent + 4, tokens, source)
                        elif (fmt_bl_kind == "nursery" or fmt_bl_kind == "pool") and fmt_bl_body.count > 0:
                            # Both print stage0's `pool NAME(WORKERS):` header. A NURSERY's
                            # name and worker count are synthesized (`__nursery_pool_K`,
                            # `perf_cores()` when the source omits `workers(…)`), and its
                            # body is bracketed by the TaskGroup declaration and wait that
                            # stage0's parser splices in.
                            fmt_nu_is_nursery: bool = fmt_bl_kind == "nursery"
                            fmt_nu_saved: i64 = fmt_nursery_active
                            if fmt_nu_is_nursery:
                                fmt_nursery_counter <- fmt_nursery_counter + 1
                                fmt_nursery_active <- fmt_nursery_counter
                            fmt_indent(buffer, indent)
                            fmt_push(buffer, "pool ")
                            if fmt_nu_is_nursery:
                                fmt_push(buffer, "__nursery_pool_")
                                fmt_push_decimal(buffer, fmt_nursery_active)
                            else:
                                fmt_push(buffer, fmt_bl_clause[0]) if fmt_bl_clause.count > 0
                            buffer.push(40)
                            # The clause's capacity entry is the SOURCE SPAN of the worker
                            # expression, as the region arm's is.
                            fmt_push(buffer, fmt_bl_clause[1]) if fmt_bl_clause.count > 1
                            fmt_push(buffer, "perf_cores()") if fmt_bl_clause.count < 2 and fmt_nu_is_nursery
                            buffer.push(41)
                            fmt_push(buffer, ":")
                            buffer.push(10)
                            if fmt_nu_is_nursery:
                                fmt_indent(buffer, indent + 4)
                                fmt_push(buffer, "__nursery_grp_")
                                fmt_push_decimal(buffer, fmt_nursery_active)
                                fmt_push(buffer, ": mutable TaskGroup = task_group_new()")
                                buffer.push(10)
                            fmt_stmts(buffer, fmt_bl_body, indent + 4, tokens, source)
                            if fmt_nu_is_nursery:
                                fmt_indent(buffer, indent + 4)
                                fmt_push(buffer, "task_group_wait_all(__nursery_grp_")
                                fmt_push_decimal(buffer, fmt_nursery_active)
                                fmt_push(buffer, ".ref[TaskGroup&])")
                                buffer.push(10)
                            fmt_nursery_active <- fmt_nu_saved
                        else:
                            fmt_indent(buffer, indent)
                            fmt_push(buffer, "<fmt-block-todo>")
                            buffer.push(10)
                    Stmt.Match(fmt_ma_scrutinee, fmt_ma_arms, fmt_ma_line):
                        fmt_indent(buffer, indent)
                        # A `catch CALL:` handler parses to the SAME Match node (its arms
                        # are the success binding and the error arms); the source line's
                        # leading keyword is what tells them apart.
                        fmt_push(buffer, "catch " if fmt_line_starts_with_catch(tokens, fmt_ma_line.line) else "match ")
                        fmt_expr(buffer, fmt_ma_scrutinee, tokens, source)
                        fmt_push(buffer, ":")
                        buffer.push(10)
                        for fmt_ma_arm in fmt_ma_arms |buffer, indent, tokens, source|:
                            fmt_indent(buffer, indent + 4)
                            fmt_pattern(buffer, fmt_ma_arm.pattern)
                            fmt_push(buffer, ":")
                            buffer.push(10)
                            fmt_stmts(buffer, fmt_ma_arm.body, indent + 8, tokens, source)
                    Stmt.Contract(fmt_ct_kind, fmt_ct_expression, fmt_ct_line):
                        # Contract statements (`ensure result >= a`, `requires ...`):
                        # stage0's fmt DROPS them — max/min print without their ensures.
                        # An `assert` parses through the same node and DOES print.
                        if fmt_ct_kind == "assert":
                            # stage0 prints assert as a CALL: `assert((raw != null))`.
                            fmt_indent(buffer, indent)
                            fmt_push(buffer, "assert(")
                            fmt_expr(buffer, fmt_ct_expression, tokens, source)
                            fmt_push(buffer, ")")
                            buffer.push(10)
                    _:
                        fmt_indent(buffer, indent)
                        fmt_push(buffer, "<fmt-stmt-todo>")
                        buffer.push(10)

        # Arm patterns, first arms: wildcard and literals print their source spellings;
        # constructor/tuple/binding patterns follow with their own sentinel until then.
        def fmt_pattern(buffer: mutable darray[u8]&, pattern: Ast::Pattern) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Wildcard:
                        fmt_push(buffer, "_")
                    Pattern.Literal(fmt_pat_text):
                        fmt_push(buffer, fmt_pat_text)
                    Pattern.Binding(fmt_pat_name):
                        fmt_push(buffer, fmt_pat_name)
                    Pattern.TypeBind(fmt_pat_type, fmt_pat_binder):
                        # A catch-all error arm parses as TypeBind("error", "e") and
                        # prints back as `error e` — stage0's ErrorBinding arm spelling.
                        fmt_push(buffer, fmt_pat_type)
                        buffer.push(32)
                        fmt_push(buffer, fmt_pat_binder)
                    _:
                        fmt_push(buffer, "<fmt-pattern-todo>")

        # POSTFIX `EXPR can E` applies only to a single EXPRESSION statement that is not
        # a `panic(...)` — an `if`/`while`/anything else keeps the block form (measured:
        # string_escapes' single-if can-block prints as a block under stage0).
        # A `static` block whose line carries no if/elif/else is the DIRECTIVE form.
        def fmt_static_is_directive(tokens: darray[Lexer::Token]&, source: u8&, line: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                fmt_sdir_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
                false return if not fmt_sdir_range.found
                for fmt_sdir_probe in fmt_sdir_range.start..<fmt_sdir_range.stop |tokens|:
                    fmt_sdir_kind: Lexer::TokenKind = tokens[fmt_sdir_probe].kind
                    false return if fmt_sdir_kind == Lexer::TokenKind.If or fmt_sdir_kind == Lexer::TokenKind.Elif or fmt_sdir_kind == Lexer::TokenKind.Else
                return true

        def fmt_can_is_postfixable(statement: Ast::Stmt, tokens: darray[Lexer::Token]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                if statement is Stmt.Expr(fmt_cp_expr, fmt_cp_line):
                    if fmt_cp_expr is Expr.Call(fmt_cp_callee, fmt_cp_args, fmt_cp_names, fmt_cp_cl):
                        if fmt_cp_callee is Expr.Ident(fmt_cp_name, fmt_cp_il):
                            return fmt_cp_name != "panic"
                    return true
                if statement is Stmt.Return(fmt_cp_ret, fmt_cp_rl):
                    return true
                # stage0's formatInlineCanStmt also collapses AssignStmt / DiscardStmt
                # (`_ = sched_yield() can Thread.Yield`) and VarDeclStmt.
                if statement is Stmt.Assign(fmt_cp_at, fmt_cp_ao, fmt_cp_av, fmt_cp_al):
                    return true
                if statement is Stmt.VarDecl(fmt_cp_vn, fmt_cp_vt, fmt_cp_vv, fmt_cp_vl):
                    return true
                # A `catch …:` handler is an EXPRESSION statement in stage0, so a lone one
                # postfixes its grant. A real `match` is a STATEMENT there and does not.
                if statement is Stmt.Match(fmt_cp_scrut, fmt_cp_arms, fmt_cp_ml):
                    return fmt_line_starts_with_catch(tokens, fmt_cp_ml.line)
                return false

        def fmt_stmts(buffer: mutable darray[u8]&, statements: darray[Ast::Stmt], indent: i64, tokens: darray[Lexer::Token]&, source: u8&) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                for fmt_body_statement in statements |buffer, indent, tokens, source|:
                    fmt_stmt(buffer, fmt_body_statement, indent, tokens, source)

        # Stacked decorator lines (`@intrusive`) directly above declaration line LINE,
        # rendered verbatim in top-down order. A line qualifies when its first token is
        # `@`; the walk extends upward through a contiguous run of such lines.
        def fmt_struct_decorator_lines(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32, indent: i64) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                fmt_dl_first: mutable u32 = line
                fmt_dl_scanning: mutable bool = true
                while fmt_dl_scanning and fmt_dl_first > 1 |fmt_dl_first, fmt_dl_scanning, tokens|:
                    fmt_dl_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, fmt_dl_first - 1)
                    if fmt_dl_range.found and tokens[fmt_dl_range.start].kind == Lexer::TokenKind.At:
                        fmt_dl_first <- fmt_dl_first - 1
                    else:
                        fmt_dl_scanning <- false
                for fmt_dl_line in fmt_dl_first..<line |buffer, tokens, source, indent|:
                    fmt_dl_render: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, fmt_dl_line)
                    continue if not fmt_dl_render.found
                    continue if tokens[fmt_dl_render.start].kind != Lexer::TokenKind.At
                    fmt_indent(buffer, indent)
                    emit_iface_render_tokens(buffer, tokens, source, fmt_dl_render.start, fmt_dl_render.stop)
                    fmt_push(buffer, "\n")

        # The number of `.cast[...]` nodes inside an expression subtree ON LINE — the K of
        # the bracket-pairing rule (see fmt_cast_claimed). The line filter matters for a
        # MULTI-LINE call: an argument's cast on its own line has its own ordinal space
        # and must not shift the closing line's chain. Walks the shapes a cast head can
        # practically contain; an unlisted shape contributes 0 (a mispair there would show
        # as a byte diff, never silently).
        def fmt_count_casts(expression: Ast::Expr, line: u32) -> i64:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(fmt_cc_head, fmt_cc_arg, fmt_cc_line):
                        fmt_cc_self: mutable i64 = 0
                        match fmt_cc_head:
                            Expr.Field(_, fmt_cc_name, _):
                                fmt_cc_self <- 1 if fmt_cc_name == "cast" and fmt_cc_line.line == line
                            _:
                                pass
                        return fmt_cc_self + fmt_count_casts(fmt_cc_head, line) + fmt_count_casts(fmt_cc_arg, line)
                    Expr.Field(fmt_cc_fobj, _, _):
                        return fmt_count_casts(fmt_cc_fobj, line)
                    Expr.Call(fmt_cc_callee, fmt_cc_args, _, _):
                        fmt_cc_total: mutable i64 = fmt_count_casts(fmt_cc_callee, line)
                        for fmt_cc_argument in fmt_cc_args |fmt_cc_total, line|:
                            fmt_cc_total <- fmt_cc_total + fmt_count_casts(fmt_cc_argument, line)
                        return fmt_cc_total
                    Expr.Unary(_, fmt_cc_operand, _):
                        return fmt_count_casts(fmt_cc_operand, line)
                    Expr.Paren(fmt_cc_inner, _):
                        return fmt_count_casts(fmt_cc_inner, line)
                    Expr.Binary(fmt_cc_left, _, fmt_cc_right, _):
                        return fmt_count_casts(fmt_cc_left, line) + fmt_count_casts(fmt_cc_right, line)
                    Expr.Move(fmt_cc_moperand, _):
                        return fmt_count_casts(fmt_cc_moperand, line)
                    _:
                        return 0

        # stage0's peekIsBareBindingTarget name test: lowercase first byte, and not one of
        # the builtin bare type names (`x is u8` stays a TYPE TEST).
        def fmt_is_bare_binding_name(name: sview) -> bool:
            can Abort.Panic:
                false return if sview_len(name) == 0
                fmt_bb_first: u8 = sview_at(name, 0)
                false return if fmt_bb_first < 97 or fmt_bb_first > 122
                false return if name == "void" or name == "bool" or name == "char" or name == "int"
                false return if name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "isize"
                false return if name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "usize" or name == "uintptr"
                false return if name == "f32" or name == "f64" or name == "cstr" or name == "dstr"
                return true

        # stage0's `maybeWrapFunctionBodyInAutoRegion`: a function that receives an `Arena`
        # manages allocation itself and is left alone; otherwise a body declaring a
        # region-less container earns the synthesized region.
        def fmt_body_needs_auto_region(statements: darray[Ast::Stmt], line: u32, tokens: darray[Lexer::Token]&, source: u8&) -> bool:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                false return if fmt_map_delta_probe < 0
                fmt_ar_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
                false return if not fmt_ar_range.found
                for fmt_ar_probe in fmt_ar_range.start..<fmt_ar_range.stop |tokens, source|:
                    if tokens[fmt_ar_probe].kind == Lexer::TokenKind.Ident:
                        false return if Lexer::text_or_empty(tokens[fmt_ar_probe], source) == "Arena"
                return fmt_declares_regionless_container(statements, tokens)

        # An initializer that actually ALLOCATES a backing buffer — stage0's
        # isAllocatingLiteral: a list literal or a builder comprehension (a quantifier's
        # `body` is Absent and does not allocate). Dict/set literals are deliberately NOT
        # here, matching stage0.
        def fmt_value_is_allocating_literal(value: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Array(_, _):
                        return true
                    Expr.Comprehension(_, _, _, fmt_av_body, _):
                        match fmt_av_body:
                            Expr.Absent:
                                return false
                            _:
                                return true
                    Expr.Paren(fmt_av_inner, _):
                        return fmt_value_is_allocating_literal(fmt_av_inner)
                    _:
                        return false

        # stage0's structLiteralAllocatesContainerArg: a construct whose field argument is
        # itself an allocating literal (`Index{primary: {}, overflow: []}` — the []).
        def fmt_construct_allocates_arg(value: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Construct(_, fmt_ca_fields, _):
                        for fmt_ca_field in fmt_ca_fields:
                            true return if fmt_value_is_allocating_literal(fmt_ca_field.value)
                    _:
                        pass
                return false

        # A body statement declaring a container local with no `@region` on its line —
        # stage0's per-statement wrap triggers (functionBodyNeedsAutoRegion's VarDecl arm
        # + bodyForwardsConstructedStructLocal). The region annotations live in a File
        # side table the decl walker does not carry, and a global `darray` side channel
        # for them bus-errors (a container value in a global is the arena-identity
        # hazard); the `@` is on the declaration LINE either way.
        def fmt_declares_regionless_container(statements: darray[Ast::Stmt], tokens: darray[Lexer::Token]&) -> bool:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                for fmt_rc_statement in statements |tokens, statements|:
                    match fmt_rc_statement:
                        Stmt.VarDecl(fmt_rc_name, fmt_rc_type, fmt_rc_value, fmt_rc_line):
                            if emit_ast_expr_head_is_container(fmt_rc_type) and fmt_value_is_allocating_literal(fmt_rc_value):
                                # A container REFERENCE binding (`h: darray[u32]& = f(s)`)
                                # allocates nothing — stage0 does not wrap for it. The `&`
                                # lives in the line's type span, not the head expr.
                                if not fmt_line_type_is_reference(tokens, fmt_rc_line.line):
                                    true return if not fmt_line_has_region_marker(tokens, fmt_rc_line.line)
                            # A construct with an allocating-literal field arg allocates that
                            # field region-lessly (`t: mutable Index = Index{overflow: []}`).
                            true return if fmt_construct_allocates_arg(fmt_rc_value)
                            # A struct-CONSTRUCTED local later forwarded to a call has its
                            # container fields grown interprocedurally — stage0's
                            # bodyForwardsConstructedStructLocal (top-level approximation).
                            match fmt_rc_value:
                                Expr.Construct(_, _, _):
                                    true return if fmt_body_forwards_local(statements, fmt_rc_name)
                                _:
                                    pass
                        Stmt.If(_, fmt_rc_then, fmt_rc_else, _):
                            true return if fmt_declares_regionless_container(fmt_rc_then, tokens)
                            true return if fmt_declares_regionless_container(fmt_rc_else, tokens)
                        Stmt.While(_, fmt_rc_wbody, _):
                            true return if fmt_declares_regionless_container(fmt_rc_wbody, tokens)
                        Stmt.For(_, _, _, fmt_rc_fbody, _):
                            true return if fmt_declares_regionless_container(fmt_rc_fbody, tokens)
                        Stmt.Block(_, _, _, fmt_rc_bbody, _):
                            true return if fmt_declares_regionless_container(fmt_rc_bbody, tokens)
                        _:
                            pass
                return false

        # Does any statement in the list pass NAME (bare or by `&`) as a call argument?
        def fmt_body_forwards_local(statements: darray[Ast::Stmt], name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for fmt_fw_statement in statements |name|:
                    match fmt_fw_statement:
                        Stmt.Expr(fmt_fw_expression, _):
                            true return if fmt_expr_forwards_name(fmt_fw_expression, name)
                        Stmt.Return(fmt_fw_value, _):
                            if fmt_fw_value is fmt_fw_returned:
                                true return if fmt_expr_forwards_name(fmt_fw_returned, name)
                        Stmt.VarDecl(_, _, fmt_fw_v, _):
                            true return if fmt_expr_forwards_name(fmt_fw_v, name)
                        Stmt.Assign(_, _, fmt_fw_av, _):
                            true return if fmt_expr_forwards_name(fmt_fw_av, name)
                        _:
                            pass
                return false

        def fmt_expr_forwards_name(expression: Ast::Expr, name: sview) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Call(_, fmt_fn_args, _, _):
                        for fmt_fn_argument in fmt_fn_args |name|:
                            fmt_fn_inner: mutable Ast::Expr = fmt_fn_argument
                            match fmt_fn_argument:
                                Expr.Unary(fmt_fn_op, fmt_fn_operand, _):
                                    fmt_fn_inner <- fmt_fn_operand if fmt_fn_op == Lexer::TokenKind.Ampersand
                                _:
                                    pass
                            match fmt_fn_inner:
                                Expr.Ident(fmt_fn_in, _):
                                    true return if fmt_fn_in == name
                                _:
                                    pass
                    _:
                        pass
                return false

        # The declaration line's TYPE span (first depth-0 `:` to the depth-0 `=`, or line
        # end) contains an `&` — a reference annotation, so the local borrows rather than
        # allocates.
        def fmt_line_type_is_reference(tokens: darray[Lexer::Token]&, line: u32) -> bool:
            can Abort.Panic:
                fmt_tr_found: mutable bool = false
                fmt_tr_in_type: mutable bool = false
                fmt_tr_done: mutable bool = false
                fmt_tr_depth: mutable i64 = 0
                for fmt_tr_probe in 0..<tokens.count |fmt_tr_found, fmt_tr_in_type, fmt_tr_done, fmt_tr_depth, tokens, line|:
                    continue if fmt_tr_done
                    continue if tokens[fmt_tr_probe].line != line
                    fmt_tr_kind: Lexer::TokenKind = tokens[fmt_tr_probe].kind
                    fmt_tr_depth <- fmt_tr_depth + 1 if fmt_tr_kind == Lexer::TokenKind.LParen or fmt_tr_kind == Lexer::TokenKind.LBracket
                    fmt_tr_depth <- fmt_tr_depth - 1 if fmt_tr_kind == Lexer::TokenKind.RParen or fmt_tr_kind == Lexer::TokenKind.RBracket
                    if fmt_tr_in_type and fmt_tr_depth == 0 and (fmt_tr_kind == Lexer::TokenKind.Assign or fmt_tr_kind == Lexer::TokenKind.Newline):
                        fmt_tr_done <- true
                    elif fmt_tr_in_type and fmt_tr_depth == 0 and fmt_tr_kind == Lexer::TokenKind.Ampersand:
                        fmt_tr_found <- true
                    elif not fmt_tr_in_type and fmt_tr_depth == 0 and fmt_tr_kind == Lexer::TokenKind.Colon:
                        fmt_tr_in_type <- true
                return fmt_tr_found

        def fmt_line_has_region_marker(tokens: darray[Lexer::Token]&, line: u32) -> bool:
            can Abort.Panic:
                fmt_rm_found: mutable bool = false
                for fmt_rm_probe in 0..<tokens.count |fmt_rm_found, tokens, line|:
                    continue if tokens[fmt_rm_probe].line != line
                    fmt_rm_found <- true if tokens[fmt_rm_probe].kind == Lexer::TokenKind.At
                return fmt_rm_found

        # `__auto_<N>` — see the note on `fmt_map_delta_probe`.
        def fmt_auto_region_number(line: u32, tokens: darray[Lexer::Token]&) -> i64:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                fmt_an_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
                0 return if not fmt_an_range.found
                fmt_an_start: i64 = tokens[fmt_an_range.start].start.i64()
                fmt_an_delta: i64 = emit_fmt_offset_delta(fmt_an_start)
                return fmt_an_start + (fmt_an_delta if fmt_an_delta >= 0 else 0)

        def fmt_push_decimal(buffer: mutable darray[u8]&, value: i64) -> void:
            can Memory.Allocate, Abort.Panic:
                if value <= 0:
                    buffer.push(48)
                    return
                fmt_pd_digits: mutable darray[u8] = []
                fmt_pd_rest: mutable i64 = value
                for _fmt_pd_step in 0..<20 |fmt_pd_digits, fmt_pd_rest|:
                    break if fmt_pd_rest == 0
                    fmt_pd_digits.push((48 + (fmt_pd_rest % 10)).u8())
                    fmt_pd_rest <- fmt_pd_rest / 10
                for fmt_pd_index in 0..<fmt_pd_digits.count |buffer, fmt_pd_digits|:
                    buffer.push(fmt_pd_digits[fmt_pd_digits.count - 1.usize() - fmt_pd_index])

        def fmt_indent(buffer: mutable darray[u8]&, indent: i64) -> void:
            can Memory.Allocate, Abort.Panic:
                for fmt_indent_index in 0..<indent |buffer|:
                    buffer.push(32)

        # Whole-file assembly: each function prints its header LINE (gap-rendered from
        # the declaration tokens — normalized source spelling) and its body through
        # fmt_stmts; declarations separate with single blank lines. Non-function decls
        # reuse the header line render; a body containing any sentinel marker keeps the
        # file honest rather than approximated.
        def fmt_file(buffer: mutable darray[u8]&, file: Ast::File&, tokens: darray[Lexer::Token]&, source: u8&) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                # `using` declarations live only in the annotation side-table (parser
                # markers `__using` / `__using_alias_target`); stage0 keeps them as real
                # decls and prints `using TARGET` in line order among the others. Collect
                # (target, line) in parse order — ascending lines — and interleave.
                fmt_map_delta_probe <- emit_fmt_offset_delta(0)
                fmt_us_targets: mutable darray[sview] = []
                fmt_us_lines: mutable darray[u32] = []
                for fmt_us_annotation in file.enum_annotations |fmt_us_targets, fmt_us_lines, file|:
                    if fmt_us_annotation.name == "__using_alias_target":
                        fmt_us_targets.push(fmt_us_annotation.owner)
                        fmt_us_lines.push(fmt_us_annotation.line)
                    elif fmt_us_annotation.name == "__using":
                        fmt_us_aliased: mutable bool = false
                        for fmt_us_probe in file.enum_annotations |fmt_us_aliased, fmt_us_annotation|:
                            fmt_us_aliased <- true if fmt_us_probe.name == "__using_alias_target" and fmt_us_probe.owner == fmt_us_annotation.owner
                        if not fmt_us_aliased:
                            fmt_us_targets.push(fmt_us_annotation.owner)
                            fmt_us_lines.push(fmt_us_annotation.line)
                fmt_us_next: mutable usize = 0
                fmt_first_decl: mutable bool = true
                fmt_prev_scoped: mutable bool = false
                for fmt_declaration in file.top_decls |buffer, tokens, source, fmt_first_decl, fmt_prev_scoped, fmt_us_next, fmt_us_targets, fmt_us_lines|:
                    fmt_ff_decl_line: u32 = ast_decl_line(fmt_declaration)
                    while fmt_us_next < fmt_us_lines.count and fmt_us_lines[fmt_us_next] < fmt_ff_decl_line |buffer, fmt_first_decl, fmt_prev_scoped, fmt_us_next, fmt_us_targets, fmt_us_lines|:
                        fmt_push(buffer, "\n") if not fmt_first_decl
                        fmt_first_decl <- false
                        fmt_prev_scoped <- false
                        fmt_push(buffer, "using ")
                        fmt_push(buffer, fmt_us_targets[fmt_us_next])
                        fmt_push(buffer, "\n")
                        fmt_us_next <- fmt_us_next + 1
                    # A static if/elif/else CHAIN is ONE decl in stage0, so its branches
                    # print contiguously — but stage1's parser splits them into separate
                    # top-level Scoped decls. Suppress the separator only for a CHAIN
                    # CONTINUATION (`static elif` / `static else`): a fresh `static if`
                    # right after another chain is a new decl and keeps its blank line, as
                    # does an `impl` body, which is the same node kind.
                    fmt_cur_scoped: mutable bool = false
                    fmt_cur_continues: mutable bool = false
                    if fmt_declaration is Decl.Scoped(fmt_ff_body, fmt_ff_line):
                        fmt_ff_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, fmt_ff_line.line)
                        if fmt_ff_range.found:
                            fmt_cur_scoped <- tokens[fmt_ff_range.start].kind == Lexer::TokenKind.Static
                            if fmt_cur_scoped and fmt_ff_range.start + 1 < tokens.count:
                                fmt_ff_second: Lexer::TokenKind = tokens[fmt_ff_range.start + 1].kind
                                fmt_cur_continues <- fmt_ff_second == Lexer::TokenKind.Elif or fmt_ff_second == Lexer::TokenKind.Else
                    fmt_push(buffer, "\n") if not fmt_first_decl and not (fmt_prev_scoped and fmt_cur_continues)
                    fmt_first_decl <- false
                    fmt_prev_scoped <- fmt_cur_scoped
                    fmt_decl(buffer, fmt_declaration, tokens, source, 0)
                while fmt_us_next < fmt_us_lines.count |buffer, fmt_first_decl, fmt_us_next, fmt_us_targets, fmt_us_lines|:
                    fmt_push(buffer, "\n") if not fmt_first_decl
                    fmt_first_decl <- false
                    fmt_push(buffer, "using ")
                    fmt_push(buffer, fmt_us_targets[fmt_us_next])
                    fmt_push(buffer, "\n")
                    fmt_us_next <- fmt_us_next + 1

        def fmt_decl(buffer: mutable darray[u8]&, declaration: Ast::Decl, tokens: darray[Lexer::Token]&, source: u8&, indent: i64) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                if declaration is Decl.Func(fmt_fd_name, fmt_fd_params, fmt_fd_ret, fmt_fd_body, fmt_fd_effects, fmt_fd_decorators, fmt_fd_line):
                    for fmt_fd_decorator in fmt_fd_decorators |buffer, tokens, source, fmt_fd_line, indent|:
                        fmt_indent(buffer, indent)
                        fmt_push(buffer, "@")
                        fmt_push(buffer, fmt_fd_decorator.name)
                        emit_ast_decorator_args(buffer, tokens, source, fmt_fd_line.line)
                        fmt_push(buffer, "\n")
                    # The shared signature renderer weaves stage0's inferred region
                    # params into the header (`def fill[@__rg_out](out: ... @__rg_out&)`).
                    emit_signature_line(buffer, "def ", fmt_fd_name, fmt_fd_line.line, tokens, source, indent, true, true, false, false)
                    fmt_push(buffer, "\n")
                    # stage0's inference-by-default: a body that allocates a region-less
                    # container, in a function that does NOT thread an allocator itself,
                    # is wrapped in a synthesized lazy region and PRINTED as one.
                    if fmt_body_needs_auto_region(fmt_fd_body, fmt_fd_line.line, tokens, source):
                        fmt_indent(buffer, indent + 4)
                        fmt_push(buffer, "with arena __auto_")
                        fmt_push_decimal(buffer, fmt_auto_region_number(fmt_fd_line.line, tokens))
                        fmt_push(buffer, " as :\n")
                        fmt_stmts(buffer, fmt_fd_body, indent + 8, tokens, source)
                        return
                    fmt_stmts(buffer, fmt_fd_body, indent + 4, tokens, source)
                    return
                if declaration is Decl.Struct(fmt_sd_name, fmt_sd_members, fmt_sd_aff, fmt_sd_states, fmt_sd_derive, fmt_sd_inv, fmt_sd_line):
                    # A struct's decorators (`@intrusive`) are not carried on the node —
                    # recover the stacked `@…` lines directly above the header.
                    fmt_struct_decorator_lines(buffer, tokens, source, fmt_sd_line.line, indent)
                    fmt_block_from_source(buffer, tokens, source, fmt_sd_line.line)
                    return
                if declaration is Decl.Enum(fmt_ed_name, fmt_ed_variants, fmt_ed_const, fmt_ed_storage, fmt_ed_line):
                    fmt_block_from_source(buffer, tokens, source, fmt_ed_line.line)
                    return
                if declaration is Decl.Const(fmt_cd_name, fmt_cd_type, fmt_cd_value, fmt_cd_mutable, fmt_cd_line):
                    # `const X[: T] = V`: the head renders from source tokens up to the
                    # `=`, the VALUE through fmt_expr — stage0's exprStr parenthesizes a
                    # binary const value (`(8 * 1024)`), measured on string_escapes.
                    fmt_cd_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, fmt_cd_line.line)
                    if fmt_cd_range.found:
                        fmt_cd_stop: mutable usize = fmt_cd_range.stop
                        fmt_cd_eq: mutable usize = 0
                        fmt_cd_eq_found: mutable bool = false
                        while fmt_cd_stop < tokens.count and tokens[fmt_cd_stop].line == fmt_cd_line.line and tokens[fmt_cd_stop].kind != Lexer::TokenKind.Newline |fmt_cd_stop, fmt_cd_eq, fmt_cd_eq_found, tokens, fmt_cd_line|:
                            if not fmt_cd_eq_found and tokens[fmt_cd_stop].kind == Lexer::TokenKind.Assign:
                                fmt_cd_eq <- fmt_cd_stop
                                fmt_cd_eq_found <- true
                            fmt_cd_stop <- fmt_cd_stop + 1
                        if fmt_cd_eq_found:
                            fmt_indent(buffer, indent)
                            emit_iface_render_tokens(buffer, tokens, source, fmt_cd_range.start, fmt_cd_eq)
                            fmt_push(buffer, " = ")
                            fmt_stmt_line <- fmt_cd_line.line
                            fmt_expr(buffer, fmt_cd_value, tokens, source)
                        else:
                            fmt_indent(buffer, indent)
                            emit_iface_render_tokens(buffer, tokens, source, fmt_cd_range.start, fmt_cd_stop)
                        fmt_push(buffer, "\n")
                    return
