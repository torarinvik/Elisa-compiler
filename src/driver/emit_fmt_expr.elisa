                    # A `static if/elif/else` BRANCH: header line from the source (the
                    # chain's conditions live only there), then the branch's declarations
                    # at 4-space indent — matching stage0's decl-level chain rendering.
                    fmt_sc_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, fmt_sc_line.line)
                    if fmt_sc_range.found:
                        fmt_indent(buffer, indent)
                        # A `Scoped` node is EITHER a `static if/elif/else` branch OR an
                        # `impl`/`extend` body — the parser collapses both into the same
                        # node. Only the chain form parenthesizes; an impl header renders
                        # verbatim (stage0's ImplDecl arm rebuilds `impl[G] I for T:` from
                        # its parts, which is the source spelling).
                        fmt_sc_is_chain: bool = tokens[fmt_sc_range.start].kind == Lexer::TokenKind.Static
                        if not fmt_sc_is_chain:
                            emit_iface_render_tokens(buffer, tokens, source, fmt_sc_range.start, fmt_sc_range.stop)
                        else:
                            # stage0 prints the chain CONDITION parenthesized:
                            # `static if (A == B):` — the head keywords render verbatim, the
                            # condition tokens wrap in parens; a bare `static else` has none.
                            fmt_sc_cond: mutable usize = fmt_sc_range.start
                            fmt_sc_seen_head: mutable bool = false
                            for fmt_sc_probe in fmt_sc_range.start..<fmt_sc_range.stop |fmt_sc_cond, fmt_sc_seen_head, tokens, source|:
                                continue if fmt_sc_seen_head
                                fmt_sc_token: Lexer::Token = tokens[fmt_sc_probe]
                                fmt_sc_is_head: bool = fmt_sc_token.kind == Lexer::TokenKind.Static or fmt_sc_token.kind == Lexer::TokenKind.If or fmt_sc_token.kind == Lexer::TokenKind.Elif or fmt_sc_token.kind == Lexer::TokenKind.Else
                                if fmt_sc_is_head:
                                    fmt_sc_cond <- fmt_sc_probe + 1
                                else:
                                    fmt_sc_seen_head <- true
                            emit_iface_render_tokens(buffer, tokens, source, fmt_sc_range.start, fmt_sc_cond)
                            if fmt_sc_cond < fmt_sc_range.stop:
                                # The parens belong to exprStr's BINARY formatting, not the
                                # chain: a bare-ident condition prints unwrapped.
                                fmt_sc_multi: bool = fmt_sc_range.stop - fmt_sc_cond > 1
                                fmt_push(buffer, " (" if fmt_sc_multi else " ")
                                emit_iface_render_tokens(buffer, tokens, source, fmt_sc_cond, fmt_sc_range.stop)
                                fmt_push(buffer, ")") if fmt_sc_multi
                        fmt_push(buffer, ":\n")
                        if not fmt_sc_is_chain and Lexer::text_or_empty(tokens[fmt_sc_range.start], source) == "handler":
                            # Handler methods are lowered to hidden function names for the
                            # backend. Re-render each method from its original source span so
                            # `fmt` preserves the declared operation names and bodies.
                            for fmt_handler_child in fmt_sc_body |buffer, tokens, source, indent|:
                                if fmt_handler_child is Decl.Func(fmt_handler_name, fmt_handler_params, fmt_handler_return, fmt_handler_body, fmt_handler_effects, fmt_handler_decorators, fmt_handler_line):
                                    fmt_block_from_source_at_indent(buffer, tokens, source, fmt_handler_line.line, indent + 4)
                                else:
                                    fmt_decl(buffer, fmt_handler_child, tokens, source, indent + 4)
                            return
                    for fmt_sc_child in fmt_sc_body |buffer, tokens, source, indent|:
                        fmt_decl(buffer, fmt_sc_child, tokens, source, indent + 4)
                    return
                fmt_push(buffer, "<fmt-decl-todo>\n")

        # An enum/struct declaration prints its header and body verbatim in normalized
        # spelling — fmt does not restructure type declarations, only statements.
        def fmt_block_from_source(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                fmt_bh_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
                return if not fmt_bh_range.found
                emit_iface_render_tokens(buffer, tokens, source, fmt_bh_range.start, fmt_bh_range.stop)
                fmt_push(buffer, ":\n")
                fmt_bb_range: (found: bool, start: usize, stop: usize) = emit_iface_body_range(tokens, fmt_bh_range.stop + 1)
                return if not fmt_bb_range.found
                emit_iface_body_lines(buffer, tokens, source, fmt_bb_range.start, fmt_bb_range.stop, 4)

        def fmt_line_has_handler_install(tokens: darray[Lexer::Token]&, source: u8&, line: u32) -> bool:
            can Abort.Panic:
                for fmt_handler_probe in tokens:
                    true return if fmt_handler_probe.line == line and (fmt_handler_probe.kind == Lexer::TokenKind.With or fmt_handler_probe.kind == Lexer::TokenKind.Ident and Lexer::text_or_empty(fmt_handler_probe, source) == "with")
                return false

        def fmt_block_from_source_at_indent(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32, indent: i64) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                fmt_bhi_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
                return if not fmt_bhi_range.found
                fmt_indent(buffer, indent)
                emit_iface_render_tokens(buffer, tokens, source, fmt_bhi_range.start, fmt_bhi_range.stop)
                fmt_push(buffer, ":\n")
                fmt_bbi_range: (found: bool, start: usize, stop: usize) = emit_iface_body_range(tokens, fmt_bhi_range.stop + 1)
                return if not fmt_bbi_range.found
                emit_iface_body_lines(buffer, tokens, source, fmt_bbi_range.start, fmt_bbi_range.stop, indent + 4)

        # MEASURED: a ternary as a BINARY OPERAND carries one extra paren layer in
        # stage0's output — `(n + ((4 if c else 0)))`.
        # Operator precedence rank, higher binds tighter — only for the wrap decision.
        def fmt_op_rank(operator: Lexer::TokenKind) -> i64:
            can Abort.Panic:
                # `and` binds TIGHTER than `or` — an `or` under an `and` needed source
                # parens (measured on the std's `(A or B) and C` while-conditions).
                return match operator:
                    Lexer::TokenKind.Star | Lexer::TokenKind.Slash | Lexer::TokenKind.Percent: 9
                    Lexer::TokenKind.Plus | Lexer::TokenKind.Minus: 8
                    Lexer::TokenKind.LShift | Lexer::TokenKind.RShift: 7
                    Lexer::TokenKind.Ampersand | Lexer::TokenKind.Pipe | Lexer::TokenKind.Caret: 6
                    Lexer::TokenKind.EqEq | Lexer::TokenKind.BangEq | Lexer::TokenKind.Lt | Lexer::TokenKind.Gt | Lexer::TokenKind.LtEq | Lexer::TokenKind.GtEq | Lexer::TokenKind.Is | Lexer::TokenKind.In: 5
                    Lexer::TokenKind.And: 3
                    Lexer::TokenKind.Or: 2
                    _: 1

        def fmt_binary_operand(buffer: mutable darray[u8]&, expression: Ast::Expr, tokens: darray[Lexer::Token]&, source: u8&, is_right: bool, parent_operator: Lexer::TokenKind) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                # Two compensations for parser-absorbed source parens: a TERNARY operand
                # (the parser folds its parens in every position), and a BINARY as the
                # RIGHT operand — the grammar is left-associative, so right-nesting can
                # only come from source parens (`n + (C - 1)` vs the natural
                # `(n + C) - 1`), which stage0's ParenExpr still prints.
                fmt_bo_wrap: mutable bool = false
                if expression is Expr.If(fmt_bo_c, fmt_bo_t, fmt_bo_e, fmt_bo_l):
                    fmt_bo_wrap <- true
                # Left-associative minimal-parens grammar: a RIGHT binary child of
                # same-or-lower precedence needed source parens, and a LEFT child of
                # STRICTLY lower precedence did too (`(n + c) / d`); a same-rank left
                # child nests naturally.
                if expression is Expr.Binary(fmt_bo_bl, fmt_bo_bo, fmt_bo_br, fmt_bo_bline):
                    if is_right:
                        fmt_bo_wrap <- true if fmt_op_rank(fmt_bo_bo) <= fmt_op_rank(parent_operator)
                    else:
                        fmt_bo_wrap <- true if fmt_op_rank(fmt_bo_bo) < fmt_op_rank(parent_operator)
                buffer.push(40) if fmt_bo_wrap
                fmt_expr(buffer, expression, tokens, source)
                buffer.push(41) if fmt_bo_wrap

        # The parser's integer-literal fold, replicated: decimal or 0x hex, u64
        # accumulation, bit-preserving i64 result (16-digit hex lands negative).
        def fmt_parse_int_text(text: sview) -> i64:
            can Abort.Panic:
                length: usize = sview_len(text)
                is_hex: bool = length > 2 and sview_at(text, 0) == 48 and (sview_at(text, 1) == 120 or sview_at(text, 1) == 88)
                index: mutable usize = 2 if is_hex else 0
                value: mutable u64 = 0
                while index < length |index, value, text, is_hex|:
                    byte: u8 = sview_at(text, index)
                    digit: mutable i64 = -1
                    digit <- (byte - 48).i64() if byte >= 48 and byte <= 57
                    if is_hex:
                        digit <- (byte - 97).i64() + 10 if byte >= 97 and byte <= 102
                        digit <- (byte - 65).i64() + 10 if byte >= 65 and byte <= 70
                    break if digit < 0
                    base: u64 = 16 if is_hex else 10
                    value <- value * base + digit.u64()
                    index <- index + 1
                return value.i64()

        # A source-postfix effect grant (`STMT can E1, E2`) survives only in the tokens —
        # the parser files it in a side table. Render ` can …` from the depth-0 `can`
        # identifier on LINE, or nothing when the line carries none.
        def fmt_render_postfix_can(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                return if line == fmt_can_claimed_line
                range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
                return if not range.found
                stop: mutable usize = range.stop
                while stop < tokens.count and tokens[stop].line == line and tokens[stop].kind != Lexer::TokenKind.Newline |stop, tokens|:
                    stop <- stop + 1
                can_index: mutable usize = 0
                can_found: mutable bool = false
                grant_stop: mutable usize = stop
                depth: mutable i64 = 0
                for probe in range.start..<stop |can_index, can_found, grant_stop, depth, tokens, source|:
                    kind: Lexer::TokenKind = tokens[probe].kind
                    depth <- depth + 1 if kind == Lexer::TokenKind.LParen or kind == Lexer::TokenKind.LBracket
                    depth <- depth - 1 if kind == Lexer::TokenKind.RParen or kind == Lexer::TokenKind.RBracket
                    # A depth-0 postfix `if` ends the grant span: the parser desugared it
                    # into the enclosing block; the tail is not part of the clause.
                    grant_stop <- probe if can_found and depth == 0 and kind == Lexer::TokenKind.If and probe < grant_stop
                    continue if can_found
                    continue if depth != 0 or kind != Lexer::TokenKind.Ident
                    if Lexer::text_or_empty(tokens[probe], source) == "can":
                        # A `can[` at depth 0 is a TYPE'S effect row (`fn(A) -> R can[P]`),
                        # never a statement grant — a grant's first effect is a bare name.
                        continue if probe + 1 < stop and tokens[probe + 1].kind == Lexer::TokenKind.LBracket
                        can_index <- probe
                        can_found <- true
                return if not can_found
                fmt_push(buffer, " can ")
                emit_iface_render_tokens(buffer, tokens, source, can_index + 1, grant_stop)

        # A postfix statement guard whose grant trails the condition
        # (`X return if C can E1, E2`). The guard desugars to an `if` statement, and stage0
        # prints the grant on the synthesized header — so recover it here, from the depth-0
        # `can` that FOLLOWS the depth-0 `if`. Renders ` can …` and returns true on a match;
        # leaves BUFFER untouched and returns false otherwise (a leading-`if` block header, a
        # grant that precedes the guard, or no grant at all).
        def fmt_render_guard_can(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32) -> bool:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
                false return if not range.found
                # A line that OPENS with `if` is a real block header, not a guard: its grant
                # (when any) is already the header's own and renders from the block body.
                false return if tokens[range.start].kind == Lexer::TokenKind.If
                guard: mutable usize = 0
                guard_found: mutable bool = false
                can_index: mutable usize = 0
                can_found: mutable bool = false
                depth: mutable i64 = 0
                for probe in range.start..<range.stop |guard, guard_found, can_index, can_found, depth, tokens, source|:
                    kind: Lexer::TokenKind = tokens[probe].kind
                    depth <- depth + 1 if kind == Lexer::TokenKind.LParen or kind == Lexer::TokenKind.LBracket
                    depth <- depth - 1 if kind == Lexer::TokenKind.RParen or kind == Lexer::TokenKind.RBracket
                    continue if depth != 0
                    if kind == Lexer::TokenKind.If and not guard_found:
                        guard <- probe
                        guard_found <- true
                    continue if not guard_found or can_found or kind != Lexer::TokenKind.Ident
                    if Lexer::text_or_empty(tokens[probe], source) == "can":
                        # `can[` at depth 0 is a TYPE's effect row, never a grant.
                        continue if probe + 1 < range.stop and tokens[probe + 1].kind == Lexer::TokenKind.LBracket
                        can_index <- probe
                        can_found <- true
                false return if not can_found
                fmt_push(buffer, " can ")
                emit_iface_render_tokens(buffer, tokens, source, can_index + 1, range.stop)
                return true

        # Does LINE open with `submit` and NO `[pool]` selector? The parser consumes both
        # the keyword and the selector, so only the tokens still tell a nursery submission
        # (which stage0 collects into the enclosing group) from an explicitly pooled one.
        def fmt_line_is_implicit_submit(tokens: darray[Lexer::Token]&, source: u8&, line: u32) -> bool:
            can Abort.Panic, Memory.Allocate:
                range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
                false return if not range.found or range.start >= tokens.count
                false return if tokens[range.start].kind != Lexer::TokenKind.Ident
                false return if Lexer::text_or_empty(tokens[range.start], source) != "submit"
                return range.start + 1 >= tokens.count or tokens[range.start + 1].kind != Lexer::TokenKind.LBracket

        # Does LINE open with the `catch` keyword? (A catch handler and a `match` build
        # the same node; only the source spelling separates them.)
        def fmt_line_starts_with_catch(tokens: darray[Lexer::Token]&, line: u32) -> bool:
            can Abort.Panic, Memory.Allocate:
                range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
                false return if not range.found or range.start >= tokens.count
                return tokens[range.start].kind == Lexer::TokenKind.Catch

        # The head identifier of a callee: `f`, `f[T]`, `M::f`, `x.f` all reduce to the
        # name a `try` keyword would sit in front of.
        def fmt_call_head_name(expression: Ast::Expr) -> sview:
            can Abort.Panic, Memory.Allocate:
                match expression:
                    Expr.Ident(head_name, head_line):
                        return head_name
                    Expr.IndexN(head_object, head_args, head_line2):
                        return fmt_call_head_name(head_object)
                    Expr.Index(head_object2, head_index, head_line3):
                        return fmt_call_head_name(head_object2)
                    Expr.Scope(head_base, head_scope_name, head_line4):
                        return head_scope_name
                    Expr.Field(head_object3, head_field, head_line5):
                        return head_field
                    _:
                        return ""

        # Is the expression named NAME preceded by a `try` keyword on the current
        # statement's line? `try` is erased by the parser (it records a side-table
        # annotation), so the keyword is recovered from the tokens.
        def fmt_has_try_before(tokens: darray[Lexer::Token]&, source: u8&, line: u32, name: sview) -> bool:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                false return if name == "" or line == 0
                range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
                false return if not range.found
                stop: mutable usize = range.stop
                while stop < tokens.count and tokens[stop].line == line and tokens[stop].kind != Lexer::TokenKind.Newline |stop, tokens|:
                    stop <- stop + 1
                for probe in range.start..<stop |tokens, source, name|:
                    continue if tokens[probe].kind != Lexer::TokenKind.Try
                    continue if probe + 1 >= tokens.count or tokens[probe + 1].kind != Lexer::TokenKind.Ident
                    true return if Lexer::text_or_empty(tokens[probe + 1], source) == name
                return false

        # A TRY form takes surface parens when a `can` clause follows it (stage0's
        # formatExprWithSurfacePermissions wraps TryExpr / UnwrapElseExpr, nothing else).
        def fmt_expr_is_try_form(expression: Ast::Expr, tokens: darray[Lexer::Token]&, source: u8&, line: u32) -> bool:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                match expression:
                    Expr.Refinement(try_fallback, try_guarded, try_line):
                        return true
                    Expr.Call(try_callee, try_args, try_names, try_call_line):
                        return fmt_has_try_before(tokens, source, line, fmt_call_head_name(try_callee))
                    _:
                        return false

        # Is NAME a FILE-LEVEL `def` in this token stream? (Indent depth 0 — module
        # members resolve through `::` paths, never UFCS.)
        def fmt_is_file_def(tokens: darray[Lexer::Token]&, source: u8&, name: sview) -> bool:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                depth: mutable i64 = 0
                for probe in 0..<tokens.count |depth, tokens, source, name|:
                    kind: Lexer::TokenKind = tokens[probe].kind
                    if kind == Lexer::TokenKind.Indent:
                        depth <- depth + 1
                    elif kind == Lexer::TokenKind.Dedent:
                        depth <- depth - 1
                    elif kind == Lexer::TokenKind.Def and depth == 0 and probe + 1 < tokens.count:
                        if tokens[probe + 1].kind == Lexer::TokenKind.Ident:
                            true return if Lexer::text_or_empty(tokens[probe + 1], source) == name
                return false

        # Does this node's own arm already print a surrounding `( … )`? Mirrors stage0's
        # selfParenthesizingExpr: Binary, Unary and If (the ternary) each wrap themselves,
        # so an `Expr.Paren` around one must NOT add a second pair.
        #
        # The arms have EXCEPTIONS that print paren-free — a range Binary, `X is name`
        # optional-bind, `not (x is P)`, `&x` — which is why the caller ALSO checks the
        # produced text really is wrapped rather than trusting the node kind alone. stage0
        # makes the same two-part check for the same reason.
        # Is this operand itself a spelled range? Distinguishes the STEP separator in
        # `LOW ..< HIGH .. STEP` from a plain inclusive `LOW .. HIGH`.
        def fmt_bin_left_is_range(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Binary(fmt_lr_l, fmt_lr_o, fmt_lr_r, fmt_lr_line):
                        fmt_lr_o == Lexer::TokenKind.Range or fmt_lr_o == Lexer::TokenKind.RangeLt or fmt_lr_o == Lexer::TokenKind.RangeGt or fmt_lr_o == Lexer::TokenKind.RangeLe
                    _:
                        false

        def fmt_self_parenthesizing(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Binary(fmt_sp_l, fmt_sp_o, fmt_sp_r, fmt_sp_bl):
                        true
                    Expr.Unary(fmt_sp_uo, fmt_sp_ux, fmt_sp_ul):
                        true
                    Expr.If(fmt_sp_c, fmt_sp_t, fmt_sp_e, fmt_sp_il):
                        true
                    _:
                        false

        def fmt_push(buffer: mutable darray[u8]&, text: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                for fmt_push_index in 0..<sview_len(text) |buffer, text|:
                    buffer.push(sview_at(text, fmt_push_index))

        # strconv.Quote: double-quoted with backslash escapes for \\ " \n \t \r; other
        # control bytes as \xHH (ASCII sources only in this repo's corpus).
        def fmt_quote(buffer: mutable darray[u8]&, text: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                buffer.push(34)
                for fmt_quote_index in 0..<sview_len(text) |buffer, text|:
                    fmt_byte: u8 = sview_at(text, fmt_quote_index)
                    # The sview is the RAW source spelling — its backslash sequences are
                    # already escapes (`\n` is two bytes), and a `"` only occurs behind a
                    # backslash. Re-escaping them printed `\\n` where stage0's
                    # strconv.Quote prints `\n`. Only RAW control bytes still escape.
                    match fmt_byte:
                        34 | 92:
                            buffer.push(fmt_byte)
                        10:
                            buffer.push(92)
                            buffer.push(110)
                        9:
                            buffer.push(92)
                            buffer.push(116)
                        13:
                            buffer.push(92)
                            buffer.push(114)
                        _:
                            buffer.push(fmt_byte)
                buffer.push(34)

        # stage0 TokenName spellings for the operators the corpus uses; extended alongside
        # the statement half.
        def fmt_operator_name(buffer: mutable darray[u8]&, operator: Lexer::TokenKind) -> void:
            can Memory.Allocate, Abort.Panic:
                operator_name: sview = when operator:
                    Lexer::TokenKind.Plus -> "+"
                    Lexer::TokenKind.Minus -> "-"
                    Lexer::TokenKind.Star -> "*"
                    Lexer::TokenKind.Slash -> "/"
                    Lexer::TokenKind.Percent -> "%"
                    Lexer::TokenKind.EqEq -> "=="
                    Lexer::TokenKind.BangEq -> "!="
                    Lexer::TokenKind.Lt -> "<"
                    Lexer::TokenKind.Gt -> ">"
                    Lexer::TokenKind.LtEq -> "<="
                    Lexer::TokenKind.GtEq -> ">="
                    Lexer::TokenKind.Ampersand -> "&"
                    Lexer::TokenKind.And -> "and"
                    Lexer::TokenKind.Or -> "or"
                    Lexer::TokenKind.Is -> "is"
                    Lexer::TokenKind.In -> "in"
                    Lexer::TokenKind.Bang -> "!"
                    Lexer::TokenKind.Pipe -> "|"
                    Lexer::TokenKind.Caret -> "^"
                    Lexer::TokenKind.LShift -> "<<"
                    Lexer::TokenKind.RShift -> ">>"
                    Lexer::TokenKind.Tilde -> "~"
                    _ -> "<fmt-op-todo>"
                fmt_push(buffer, operator_name)
