# `-emit fmt` / `-emit lowered` — the EXPRESSION half of the unparser port (stage0's
# unparse.FormatFile). Not yet dispatched: the statement/declaration half follows, and the
# mode goes live only when the whole file round-trips against stage0 (see the port plan
# and the two measured blockers in the stage1-parity-status memory: fmt prints DESUGARED
# canonical statements, and region-wrapped bodies print stage0's internal `__auto_N`).
#
# Formatting rules, from unparse_formatexpr_to_formatmatchpattern.go:
#   - binaries print parenthesized: "(" left " " OP " " right ")" with stage0 TokenName
#     operator spellings;
#   - `not (x is P)` prints as `x is not P`, `not (a in b)` as `a not in b`, other `not`
#     as "(not X)"; other unary as "(" OP operand ")" with no space;
#   - strings re-quote via strconv.Quote (escapes re-encoded);
#   - calls print "F(a, b)"; fields "obj.name"; indexes "obj[i]"; parens collapse to
#     their inner expression's own parenthesization.

# Multi-cast lines: pairing each rendered cast NODE with its own `cast[` bracket on the
# line. The old right-to-left cursor was only correct for NESTED casts (outer renders
# first, its bracket is rightmost) and SWAPPED the brackets of two SIBLING casts
# (`f(a.cast[A], b.cast[B])` rendered as `f(a.cast[B], b.cast[A])`). The correct pairing:
# at each cast's render, its bracket is the (K+1)-th UNCLAIMED bracket in textual order,
# where K is the number of casts inside its own head subtree (those are textually to its
# left but not yet rendered). `fmt_cast_claimed` is the per-line claimed bitmask.
# `-emit fmt` / `-emit lowered` — the EXPRESSION half of the unparser port (stage0's
# unparse.FormatFile). Not yet dispatched: the statement/declaration half follows, and the
# mode goes live only when the whole file round-trips against stage0 (see the port plan
# and the two measured blockers in the stage1-parity-status memory: fmt prints DESUGARED
# canonical statements, and region-wrapped bodies print stage0's internal `__auto_N`).
#
# Formatting rules, from unparse_formatexpr_to_formatmatchpattern.go:
#   - binaries print parenthesized: "(" left " " OP " " right ")" with stage0 TokenName
#     operator spellings;
#   - `not (x is P)` prints as `x is not P`, `not (a in b)` as `a not in b`, other `not`
#     as "(not X)"; other unary as "(" OP operand ")" with no space;
#   - strings re-quote via strconv.Quote (escapes re-encoded);
#   - calls print "F(a, b)"; fields "obj.name"; indexes "obj[i]"; parens collapse to
#     their inner expression's own parenthesization.

# Multi-cast lines: pairing each rendered cast NODE with its own `cast[` bracket on the
# line. The old right-to-left cursor was only correct for NESTED casts (outer renders
# first, its bracket is rightmost) and SWAPPED the brackets of two SIBLING casts
# (`f(a.cast[A], b.cast[B])` rendered as `f(a.cast[B], b.cast[A])`). The correct pairing:
# at each cast's render, its bracket is the (K+1)-th UNCLAIMED bracket in textual order,
# where K is the number of casts inside its own head subtree (those are textually to its
# left but not yet rendered). `fmt_cast_claimed` is the per-line claimed bitmask.
global mutable fmt_cast_line: u32



global mutable fmt_cast_claimed: u64



# The line of the statement currently being rendered: literal spelling recovery (a hex
# literal's `0x…` source text) scans this line's tokens for a value match.
global mutable fmt_stmt_line: u32
# True while a GENERIC def's body prints. stage0's analyzer cannot resolve a UFCS call
# inside a generic template, so it keeps the method form there (`items.add(v)` in
# `flags_set[T]`), where a non-generic body gets the free call. MEASURED 2026-09-08.
global mutable fmt_in_generic_def: bool
# True while a `catch` arm's pattern prints: stage0 prints an error-payload variant there
# WITHOUT its binding fields (`Payload.Bad:` for the source's `Payload.Bad(code):`), the
# bindings being lowered into the arm body. MEASURED 2026-09-08 (errorset_payload_catch_fields).
global mutable fmt_catch_arm_pattern: bool


# The statement's byte offset beside its line (§4.2); 0 when the statement is generated.
global mutable fmt_stmt_offset: u32




# A postfix statement guard carrying a grant (`X return if C can E`) desugars to an `if`
# whose single same-line body is the statement. stage0 keeps the grant on the SYNTHESIZED
# HEADER (`if C can E:` / `return X`), so the `if` arm renders it and records the line
# here; the body statement's own grant scan then skips that line instead of printing the
# same clause a second time. 0: nothing claimed (source lines are 1-based).
global mutable fmt_can_claimed_line: u32



# stage0 desugars `nursery workers(N):` in its PARSER and unparses the RESULT: a
# `pool __nursery_pool_K(N):` scope around a synthesized TaskGroup, with every `submit`
# in it collected by `task_group_add`. stage1 lowers `nursery` in the BACKEND instead, so
# the text is reconstructed here. `fmt_nursery_counter` reproduces stage0's parse-time
# counter (nursery blocks in source order); `fmt_nursery_active` is the K of the nursery
# currently being rendered, 0 outside one — it is what tells a `submit` statement which
# group and pool to name.
global mutable fmt_nursery_counter: i64



global mutable fmt_nursery_active: i64


module FmtUnparse:
    public:



        def fmt_push_decimal(buffer: mutable darray[u8]&, value: i64) -> void:
            can Memory.Allocate, Abort.Panic:
                if value <= 0:
                    buffer.push(48)
                    return
                fmt_pd_digits: mutable darray[u8] = []
                fmt_pd_rest: mutable i64 = value
                for _fmt_pd_step in 0..<20 |fmt_pd_digits, fmt_pd_rest|:
                    break if fmt_pd_rest == 0
                    fmt_pd_digits.push((48 + (fmt_pd_rest % 10)).u8())
                    fmt_pd_rest <- fmt_pd_rest / 10
                for fmt_pd_index in 0..<fmt_pd_digits.count |buffer, fmt_pd_digits|:
                    buffer.push(fmt_pd_digits[fmt_pd_digits.count - 1.usize() - fmt_pd_index])



        def fmt_indent(buffer: mutable darray[u8]&, indent: i64) -> void:
            can Memory.Allocate, Abort.Panic:
                for fmt_indent_index in 0..<indent |buffer|:
                    buffer.push(32)



        # MEASURED: a ternary as a BINARY OPERAND carries one extra paren layer in
        # stage0's output — `(n + ((4 if c else 0)))`.
        # Operator precedence rank, higher binds tighter — only for the wrap decision.
        def fmt_op_rank(operator: Lexer::TokenKind) -> i64:
            can Abort.Panic:
                # `and` binds TIGHTER than `or` — an `or` under an `and` needed source
                # parens (measured on the std's `(A or B) and C` while-conditions).
                return match operator:
                    Lexer::TokenKind.Star | Lexer::TokenKind.Slash | Lexer::TokenKind.Percent: 12
                    Lexer::TokenKind.Plus | Lexer::TokenKind.Minus: 11
                    Lexer::TokenKind.LShift | Lexer::TokenKind.RShift: 10
                    # `&` binds tighter than `^`, which binds tighter than `|` (the parser's
                    # levels; stage0 prints `(a ^ (b & c))` without a second pair -- MEASURED
                    # 2026-09-08, operator_precedence_levels).
                    Lexer::TokenKind.Ampersand: 9
                    Lexer::TokenKind.Caret: 8
                    Lexer::TokenKind.Pipe: 7
                    Lexer::TokenKind.EqEq | Lexer::TokenKind.BangEq | Lexer::TokenKind.Lt | Lexer::TokenKind.Gt | Lexer::TokenKind.LtEq | Lexer::TokenKind.GtEq | Lexer::TokenKind.Is | Lexer::TokenKind.In: 5
                    Lexer::TokenKind.And: 3
                    Lexer::TokenKind.Or: 2
                    _: 1



        def fmt_binary_operand(buffer: mutable darray[u8]&, expression: Ast::Expr, tokens: darray[Lexer::Token]&, source: u8&, is_right: bool, parent_operator: Lexer::TokenKind) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                # Two compensations for parser-absorbed source parens: a TERNARY operand
                # (the parser folds its parens in every position), and a BINARY as the
                # RIGHT operand — the grammar is left-associative, so right-nesting can
                # only come from source parens (`n + (C - 1)` vs the natural
                # `(n + C) - 1`), which stage0's ParenExpr still prints.
                fmt_bo_wrap: mutable bool = false
                if expression is Expr.If(fmt_bo_c, fmt_bo_t, fmt_bo_e, fmt_bo_l):
                    fmt_bo_wrap <- true
                # Left-associative minimal-parens grammar: a RIGHT binary child of
                # same-or-lower precedence needed source parens, and a LEFT child of
                # STRICTLY lower precedence did too (`(n + c) / d`); a same-rank left
                # child nests naturally.
                if expression is Expr.Binary(fmt_bo_bl, fmt_bo_bo, fmt_bo_br, fmt_bo_bline):
                    if is_right:
                        fmt_bo_wrap <- true if fmt_op_rank(fmt_bo_bo) <= fmt_op_rank(parent_operator)
                    else:
                        fmt_bo_wrap <- true if fmt_op_rank(fmt_bo_bo) < fmt_op_rank(parent_operator)
                buffer.push(40) if fmt_bo_wrap
                fmt_expr(buffer, expression, tokens, source)
                buffer.push(41) if fmt_bo_wrap



        # The parser's integer-literal fold, replicated: decimal or 0x hex, u64
        # accumulation, bit-preserving i64 result (16-digit hex lands negative).
        def fmt_parse_int_text(text: sview) -> i64:
            can Abort.Panic:
                length: usize = sview_len(text)
                is_hex: bool = length > 2 and sview_at(text, 0) == 48 and (sview_at(text, 1) == 120 or sview_at(text, 1) == 88)
                index: mutable usize = 2 if is_hex else 0
                value: mutable u64 = 0
                while index < length |index, value, text, is_hex|:
                    byte: u8 = sview_at(text, index)
                    digit: mutable i64 = -1
                    digit <- (byte - 48).i64() if byte >= 48 and byte <= 57
                    if is_hex:
                        digit <- (byte - 97).i64() + 10 if byte >= 97 and byte <= 102
                        digit <- (byte - 65).i64() + 10 if byte >= 65 and byte <= 70
                    break if digit < 0
                    base: u64 = 16 if is_hex else 10
                    value <- value * base + digit.u64()
                    index <- index + 1
                return value.i64()



        # Does this node's own arm already print a surrounding `( … )`? Mirrors stage0's
        # selfParenthesizingExpr: Binary, Unary and If (the ternary) each wrap themselves,
        # so an `Expr.Paren` around one must NOT add a second pair.
        #
        # The arms have EXCEPTIONS that print paren-free — a range Binary, `X is name`
        # optional-bind, `not (x is P)`, `&x` — which is why the caller ALSO checks the
        # produced text really is wrapped rather than trusting the node kind alone. stage0
        # makes the same two-part check for the same reason.
        # Is this operand itself a spelled range? Distinguishes the STEP separator in
        # `LOW ..< HIGH .. STEP` from a plain inclusive `LOW .. HIGH`.
        def fmt_bin_left_is_range(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Binary(fmt_lr_l, fmt_lr_o, fmt_lr_r, fmt_lr_line):
                        fmt_lr_o == Lexer::TokenKind.Range or fmt_lr_o == Lexer::TokenKind.RangeLt or fmt_lr_o == Lexer::TokenKind.RangeGt or fmt_lr_o == Lexer::TokenKind.RangeLe
                    _:
                        false



        def fmt_self_parenthesizing(expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                return match expression:
                    Expr.Binary(fmt_sp_l, fmt_sp_o, fmt_sp_r, fmt_sp_bl):
                        true
                    Expr.Unary(fmt_sp_uo, fmt_sp_ux, fmt_sp_ul):
                        true
                    Expr.If(fmt_sp_c, fmt_sp_t, fmt_sp_e, fmt_sp_il):
                        true
                    _:
                        false



        def fmt_push(buffer: mutable darray[u8]&, text: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                for fmt_push_index in 0..<sview_len(text) |buffer, text|:
                    buffer.push(sview_at(text, fmt_push_index))



        # strconv.Quote: double-quoted with backslash escapes for \\ " \n \t \r; other
        # control bytes as \xHH (ASCII sources only in this repo's corpus).
        def fmt_quote(buffer: mutable darray[u8]&, text: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                buffer.push(34)
                for fmt_quote_index in 0..<sview_len(text) |buffer, text|:
                    fmt_byte: u8 = sview_at(text, fmt_quote_index)
                    # The sview is the RAW source spelling — its backslash sequences are
                    # already escapes (`\n` is two bytes), and a `"` only occurs behind a
                    # backslash. Re-escaping them printed `\\n` where stage0's
                    # strconv.Quote prints `\n`. Only RAW control bytes still escape.
                    match fmt_byte:
                        34 | 92:
                            buffer.push(fmt_byte)
                        10:
                            buffer.push(92)
                            buffer.push(110)
                        9:
                            buffer.push(92)
                            buffer.push(116)
                        13:
                            buffer.push(92)
                            buffer.push(114)
                        _:
                            buffer.push(fmt_byte)
                buffer.push(34)



        # stage0 TokenName spellings for the operators the corpus uses; extended alongside
        # the statement half.
        def fmt_operator_name(buffer: mutable darray[u8]&, operator: Lexer::TokenKind) -> void:
            can Memory.Allocate, Abort.Panic:
                operator_name: sview = when operator:
                    Lexer::TokenKind.Plus -> "+"
                    Lexer::TokenKind.Minus -> "-"
                    Lexer::TokenKind.Star -> "*"
                    Lexer::TokenKind.Slash -> "/"
                    Lexer::TokenKind.Percent -> "%"
                    Lexer::TokenKind.EqEq -> "=="
                    Lexer::TokenKind.BangEq -> "!="
                    Lexer::TokenKind.Lt -> "<"
                    Lexer::TokenKind.Gt -> ">"
                    Lexer::TokenKind.LtEq -> "<="
                    Lexer::TokenKind.GtEq -> ">="
                    Lexer::TokenKind.Ampersand -> "&"
                    Lexer::TokenKind.And -> "and"
                    Lexer::TokenKind.Or -> "or"
                    Lexer::TokenKind.Is -> "is"
                    Lexer::TokenKind.In -> "in"
                    Lexer::TokenKind.Bang -> "!"
                    Lexer::TokenKind.Pipe -> "|"
                    Lexer::TokenKind.Caret -> "^"
                    Lexer::TokenKind.LShift -> "<<"
                    Lexer::TokenKind.RShift -> ">>"
                    Lexer::TokenKind.Tilde -> "~"
                    _ -> "<fmt-op-todo>"
                fmt_push(buffer, operator_name)

# The primitives above are declared before the parts are spliced in, and `fmt_expr`
# after them: a caller placed ahead of a callee that grows a container through a
# reference parameter silently loses the region the callee was meant to allocate into.

include "./emit_fmt_auto_region.elisa"
include "./emit_fmt_source_probes.elisa"
include "./emit_fmt_expr_places.elisa"
include "./emit_fmt_expr_calls.elisa"
include "./emit_fmt_stmt_control.elisa"
include "./emit_fmt_stmt_blocks.elisa"
include "./emit_fmt_stmt.elisa"
include "./emit_fmt_decl.elisa"

extend FmtUnparse:
    public:
        def fmt_expr(buffer: mutable darray[u8]&, expression: Ast::Expr, tokens: darray[Lexer::Token]&, source: u8&) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                match expression:
                    Expr.Ident(fmt_name, fmt_line):
                        fmt_push(buffer, fmt_name)
                    Expr.BoolLit(fmt_bool_value, _):
                        if fmt_bool_value:
                            fmt_push(buffer, "true")
                        else:
                            fmt_push(buffer, "false")
                    Expr.IntLit(fmt_int_value, _):
                        # A HEX literal keeps its source spelling (stage0's IntLit stores
                        # the text): scan the current statement's line for a HexLit token
                        # whose parsed value matches.
                        if fmt_stmt_line != 0:
                            fmt_int_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, fmt_stmt_line, fmt_stmt_offset)
                            if fmt_int_range.found:
                                fmt_int_end: mutable usize = fmt_int_range.stop
                                while fmt_int_end < tokens.count and tokens[fmt_int_end].line == fmt_stmt_line and tokens[fmt_int_end].kind != Lexer::TokenKind.Newline |fmt_int_end, tokens|:
                                    fmt_int_end <- fmt_int_end + 1
                                for fmt_int_probe in fmt_int_range.start..<fmt_int_end |buffer, tokens, source, fmt_int_value|:
                                    fmt_int_token: Lexer::Token = tokens[fmt_int_probe]
                                    continue if fmt_int_token.kind != Lexer::TokenKind.HexLit
                                    fmt_int_text: sview = Lexer::text_or_empty(fmt_int_token, source)
                                    if fmt_parse_int_text(fmt_int_text) == fmt_int_value:
                                        fmt_push(buffer, fmt_int_text)
                                        return
                        fmt_int_digits: mutable darray[u8] = []
                        fmt_int_left: mutable i64 = fmt_int_value
                        buffer.push(45) if fmt_int_left < 0
                        fmt_int_left <- 0 - fmt_int_left if fmt_int_left < 0
                        fmt_int_digits.push(48) if fmt_int_left == 0
                        while fmt_int_left > 0 |fmt_int_left, fmt_int_digits|:
                            fmt_int_digits.push((48 + (fmt_int_left % 10)).u8())
                            fmt_int_left <- fmt_int_left / 10
                        fmt_int_index: mutable i64 = fmt_int_digits.count.i64() - 1
                        while fmt_int_index >= 0 |fmt_int_index, fmt_int_digits, buffer|:
                            buffer.push(fmt_int_digits[fmt_int_index.usize()])
                            fmt_int_index <- fmt_int_index - 1
                    Expr.StringLit(fmt_str_text, _):
                        fmt_quote(buffer, fmt_str_text)
                    Expr.If(fmt_tern_cond, fmt_tern_then, fmt_tern_else, fmt_tern_line):
                        # `(THEN if COND else ELSE)` — stage0 parenthesizes the whole form.
                        # Any FURTHER layer comes from a real `Expr.Paren` in the operand,
                        # never from a rule here: `(a + b) if c else d` keeps its required
                        # source parens as a node, and `lo + band if … else n` has none.
                        buffer.push(40)
                        fmt_expr(buffer, fmt_tern_then, tokens, source)
                        fmt_push(buffer, " if ")
                        fmt_expr(buffer, fmt_tern_cond, tokens, source)
                        fmt_push(buffer, " else ")
                        fmt_expr(buffer, fmt_tern_else, tokens, source)
                        buffer.push(41)
                    Expr.Block(fmt_vb_stmts, fmt_vb_value, fmt_vb_captures, fmt_vb_line):
                        # A VALUE BLOCK (the parser's lowering for `get X else Y` in value
                        # position, among others): stage0's unparser prints its `<expr>`
                        # placeholder for these — matched, not guessed (measured on the
                        # get-else probe).
                        fmt_push(buffer, "<expr>")
                    Expr.GetElse(fmt_ge_guarded, fmt_ge_recovery, fmt_ge_line):
                        # MEASURED: stage0's own unparser prints `<expr>` for a get-else
                        # value — its placeholder, reproduced verbatim.
                        fmt_push(buffer, "<expr>")
                    Expr.FloatLit(fmt_float_text, _):
                        # stage0's FloatLit arm prints the kept source spelling.
                        fmt_push(buffer, fmt_float_text)
                    Expr.CharLit(fmt_char_text, _):
                        # stage0's formatCharLiteral single-quotes the kept source text.
                        buffer.push(39)
                        fmt_push(buffer, fmt_char_text)
                        buffer.push(39)
                    Expr.Binary(fmt_left, fmt_operator, fmt_right, fmt_bin_line):
                        # `X is name` with a bare lowercase non-builtin identifier is
                        # stage0's OptionalBindExpr (docs/80, peekIsBareBindingTarget), and
                        # its formatExpr arm prints `let name = X` — PAREN-FREE, in every
                        # position (if headers, ternary conditions).
                        if fmt_operator == Lexer::TokenKind.Is:
                            if fmt_right is Expr.Ident(fmt_ob_name, fmt_ob_line):
                                if fmt_is_bare_binding_name(fmt_ob_name):
                                    fmt_push(buffer, "let ")
                                    fmt_push(buffer, fmt_ob_name)
                                    fmt_push(buffer, " = ")
                                    fmt_expr(buffer, fmt_left, tokens, source)
                                    return
                        # A RANGE is stage0's MembershipRangeExpr — paren-free, and the
                        # deprecated bare `..` re-spells as `..=` (rangeOpName).
                        fmt_bin_is_range: bool = fmt_operator == Lexer::TokenKind.Range or fmt_operator == Lexer::TokenKind.RangeLt or fmt_operator == Lexer::TokenKind.RangeGt or fmt_operator == Lexer::TokenKind.RangeLe
                        if fmt_bin_is_range:
                            fmt_expr(buffer, fmt_left, tokens, source)
                            buffer.push(32)
                            if fmt_operator == Lexer::TokenKind.Range and fmt_bin_left_is_range(fmt_left):
                                # A STEPPED range `LOW ..< HIGH .. STEP` parses as a bare
                                # `..` whose LEFT is itself a spelled range — the one legal
                                # bare `..` in the language. That outer `..` is the STEP
                                # SEPARATOR, not an inclusive-range operator, and stage0
                                # prints it as a literal " .. " (formatExpr's RangeStep arm)
                                # rather than through rangeOpName. Re-spelling it `..=` here
                                # produced `0 ..< 10 ..= 3`, which is not the source form.
                                fmt_push(buffer, "..")
                            else:
                                fmt_range_text: sview = match fmt_operator:
                                    Lexer::TokenKind.RangeLt: "..<"
                                    Lexer::TokenKind.RangeGt: "..>"
                                    Lexer::TokenKind.RangeLe: "..<"
                                    _: "..="
                                fmt_push(buffer, fmt_range_text)
                            buffer.push(32)
                            # An INCLUSIVE `..=` is stage0's desugar `..< (HIGH + 1)`: `0 ..= 6 .. 2`
                            # prints `0 ..< (6 + 1) .. 2` (MEASURED 2026-09-08, stepped_range_for).
                            if fmt_operator == Lexer::TokenKind.RangeLe:
                                fmt_push(buffer, "(")
                                fmt_expr(buffer, fmt_right, tokens, source)
                                fmt_push(buffer, " + 1)")
                            else:
                                fmt_expr(buffer, fmt_right, tokens, source)
                        else:
                            buffer.push(40)
                            fmt_binary_operand(buffer, fmt_left, tokens, source, false, fmt_operator)
                            buffer.push(32)
                            fmt_operator_name(buffer, fmt_operator)
                            buffer.push(32)
                            fmt_binary_operand(buffer, fmt_right, tokens, source, true, fmt_operator)
                            buffer.push(41)
                    _:
                        fmt_expr_places(buffer, expression, tokens, source)

