# Stage0 frontend-IR declaration node IDs, shared by the writer and its proof.
module FrontendIrDeclarationNodeTags:
    public:
        const enum NodeKind of u8:
            FuncDecl
            StructDecl
            EnumDecl
            ConstEnumDecl
            TypeAliasDecl
            ImportDecl
            NamespaceDecl
            GlobalDecl
            ConstDecl

        const FUNC_DECL_NODE_TAG: u32 = 71
        const STRUCT_DECL_NODE_TAG: u32 = 254
        const ENUM_DECL_NODE_TAG: u32 = 47
        const CONST_ENUM_DECL_NODE_TAG: u32 = 32
        const TYPE_ALIAS_DECL_NODE_TAG: u32 = 266
        const IMPORT_DECL_NODE_TAG: u32 = 136
        const NAMESPACE_DECL_NODE_TAG: u32 = 195
        const GLOBAL_DECL_NODE_TAG: u32 = 77
        const CONST_DECL_NODE_TAG: u32 = 31

        const FUNC_DECL_BODY_FIELD_ID: u32 = 3
        const FUNC_DECL_NAME_FIELD_ID: u32 = 20
        const FUNC_DECL_PARAMS_FIELD_ID: u32 = 23
        const FUNC_DECL_POSITION_FIELD_ID: u32 = 26
        const FUNC_DECL_RETURN_TYPE_FIELD_ID: u32 = 31
        const STRUCT_DECL_AFFINITY_FIELD_ID: u32 = 1
        const STRUCT_DECL_FIELDS_FIELD_ID: u32 = 5
        const STRUCT_DECL_INVARIANTS_FIELD_ID: u32 = 8
        const STRUCT_DECL_NAME_FIELD_ID: u32 = 10
        const STRUCT_DECL_POSITION_FIELD_ID: u32 = 12
        const ENUM_DECL_NAME_FIELD_ID: u32 = 7
        const ENUM_DECL_POSITION_FIELD_ID: u32 = 10
        const ENUM_DECL_VARIANTS_FIELD_ID: u32 = 11
        const CONST_ENUM_DECL_MEMBERS_FIELD_ID: u32 = 1
        const CONST_ENUM_DECL_NAME_FIELD_ID: u32 = 2
        const CONST_ENUM_DECL_POSITION_FIELD_ID: u32 = 3
        const CONST_ENUM_DECL_STORAGE_FIELD_ID: u32 = 4
        const TYPE_ALIAS_DECL_NAME_FIELD_ID: u32 = 1
        const TYPE_ALIAS_DECL_POSITION_FIELD_ID: u32 = 2
        const TYPE_ALIAS_DECL_TARGET_FIELD_ID: u32 = 3
        const IMPORT_DECL_MODULE_FIELD_ID: u32 = 1
        const IMPORT_DECL_POSITION_FIELD_ID: u32 = 3
        const NAMESPACE_DECL_DECLS_FIELD_ID: u32 = 2
        const NAMESPACE_DECL_MODULE_FIELD_ID: u32 = 4
        const NAMESPACE_DECL_NAME_FIELD_ID: u32 = 5
        const NAMESPACE_DECL_POSITION_FIELD_ID: u32 = 6
        const GLOBAL_DECL_MUTABLE_FIELD_ID: u32 = 1
        const GLOBAL_DECL_NAME_FIELD_ID: u32 = 2
        const GLOBAL_DECL_POSITION_FIELD_ID: u32 = 3
        const GLOBAL_DECL_TYPE_FIELD_ID: u32 = 4
        const GLOBAL_DECL_VALUE_FIELD_ID: u32 = 5
        const CONST_DECL_NAME_FIELD_ID: u32 = 1
        const CONST_DECL_POSITION_FIELD_ID: u32 = 2
        const CONST_DECL_TYPE_FIELD_ID: u32 = 3
        const CONST_DECL_VALUE_FIELD_ID: u32 = 4

        def node_tag(kind: NodeKind) -> u32:
            ensure kind != NodeKind.FuncDecl or result == FUNC_DECL_NODE_TAG
            ensure kind != NodeKind.StructDecl or result == STRUCT_DECL_NODE_TAG
            ensure kind != NodeKind.EnumDecl or result == ENUM_DECL_NODE_TAG
            ensure kind != NodeKind.ConstEnumDecl or result == CONST_ENUM_DECL_NODE_TAG
            ensure kind != NodeKind.TypeAliasDecl or result == TYPE_ALIAS_DECL_NODE_TAG
            ensure kind != NodeKind.ImportDecl or result == IMPORT_DECL_NODE_TAG
            ensure kind != NodeKind.NamespaceDecl or result == NAMESPACE_DECL_NODE_TAG
            ensure kind != NodeKind.GlobalDecl or result == GLOBAL_DECL_NODE_TAG
            ensure kind != NodeKind.ConstDecl or result == CONST_DECL_NODE_TAG
            match kind:
                NodeKind.FuncDecl:
                    return FUNC_DECL_NODE_TAG
                NodeKind.StructDecl:
                    return STRUCT_DECL_NODE_TAG
                NodeKind.EnumDecl:
                    return ENUM_DECL_NODE_TAG
                NodeKind.ConstEnumDecl:
                    return CONST_ENUM_DECL_NODE_TAG
                NodeKind.TypeAliasDecl:
                    return TYPE_ALIAS_DECL_NODE_TAG
                NodeKind.ImportDecl:
                    return IMPORT_DECL_NODE_TAG
                NodeKind.NamespaceDecl:
                    return NAMESPACE_DECL_NODE_TAG
                NodeKind.GlobalDecl:
                    return GLOBAL_DECL_NODE_TAG
                NodeKind.ConstDecl:
                    return CONST_DECL_NODE_TAG

        def field_ids_are_pairwise_distinct(kind: NodeKind) -> bool:
            ensure result == true
            match kind:
                NodeKind.FuncDecl:
                    return ((FUNC_DECL_BODY_FIELD_ID != FUNC_DECL_NAME_FIELD_ID) and (FUNC_DECL_BODY_FIELD_ID != FUNC_DECL_PARAMS_FIELD_ID) and (FUNC_DECL_BODY_FIELD_ID != FUNC_DECL_POSITION_FIELD_ID) and (FUNC_DECL_BODY_FIELD_ID != FUNC_DECL_RETURN_TYPE_FIELD_ID) and (FUNC_DECL_NAME_FIELD_ID != FUNC_DECL_PARAMS_FIELD_ID) and (FUNC_DECL_NAME_FIELD_ID != FUNC_DECL_POSITION_FIELD_ID) and (FUNC_DECL_NAME_FIELD_ID != FUNC_DECL_RETURN_TYPE_FIELD_ID) and (FUNC_DECL_PARAMS_FIELD_ID != FUNC_DECL_POSITION_FIELD_ID) and (FUNC_DECL_PARAMS_FIELD_ID != FUNC_DECL_RETURN_TYPE_FIELD_ID) and (FUNC_DECL_POSITION_FIELD_ID != FUNC_DECL_RETURN_TYPE_FIELD_ID))
                NodeKind.StructDecl:
                    return ((STRUCT_DECL_AFFINITY_FIELD_ID != STRUCT_DECL_FIELDS_FIELD_ID) and (STRUCT_DECL_AFFINITY_FIELD_ID != STRUCT_DECL_INVARIANTS_FIELD_ID) and (STRUCT_DECL_AFFINITY_FIELD_ID != STRUCT_DECL_NAME_FIELD_ID) and (STRUCT_DECL_AFFINITY_FIELD_ID != STRUCT_DECL_POSITION_FIELD_ID) and (STRUCT_DECL_FIELDS_FIELD_ID != STRUCT_DECL_INVARIANTS_FIELD_ID) and (STRUCT_DECL_FIELDS_FIELD_ID != STRUCT_DECL_NAME_FIELD_ID) and (STRUCT_DECL_FIELDS_FIELD_ID != STRUCT_DECL_POSITION_FIELD_ID) and (STRUCT_DECL_INVARIANTS_FIELD_ID != STRUCT_DECL_NAME_FIELD_ID) and (STRUCT_DECL_INVARIANTS_FIELD_ID != STRUCT_DECL_POSITION_FIELD_ID) and (STRUCT_DECL_NAME_FIELD_ID != STRUCT_DECL_POSITION_FIELD_ID))
                NodeKind.EnumDecl:
                    return ((ENUM_DECL_NAME_FIELD_ID != ENUM_DECL_POSITION_FIELD_ID) and (ENUM_DECL_NAME_FIELD_ID != ENUM_DECL_VARIANTS_FIELD_ID) and (ENUM_DECL_POSITION_FIELD_ID != ENUM_DECL_VARIANTS_FIELD_ID))
                NodeKind.ConstEnumDecl:
                    return ((CONST_ENUM_DECL_MEMBERS_FIELD_ID != CONST_ENUM_DECL_NAME_FIELD_ID) and (CONST_ENUM_DECL_MEMBERS_FIELD_ID != CONST_ENUM_DECL_POSITION_FIELD_ID) and (CONST_ENUM_DECL_MEMBERS_FIELD_ID != CONST_ENUM_DECL_STORAGE_FIELD_ID) and (CONST_ENUM_DECL_NAME_FIELD_ID != CONST_ENUM_DECL_POSITION_FIELD_ID) and (CONST_ENUM_DECL_NAME_FIELD_ID != CONST_ENUM_DECL_STORAGE_FIELD_ID) and (CONST_ENUM_DECL_POSITION_FIELD_ID != CONST_ENUM_DECL_STORAGE_FIELD_ID))
                NodeKind.TypeAliasDecl:
                    return ((TYPE_ALIAS_DECL_NAME_FIELD_ID != TYPE_ALIAS_DECL_POSITION_FIELD_ID) and (TYPE_ALIAS_DECL_NAME_FIELD_ID != TYPE_ALIAS_DECL_TARGET_FIELD_ID) and (TYPE_ALIAS_DECL_POSITION_FIELD_ID != TYPE_ALIAS_DECL_TARGET_FIELD_ID))
                NodeKind.ImportDecl:
                    return ((IMPORT_DECL_MODULE_FIELD_ID != IMPORT_DECL_POSITION_FIELD_ID))
                NodeKind.NamespaceDecl:
                    return ((NAMESPACE_DECL_DECLS_FIELD_ID != NAMESPACE_DECL_MODULE_FIELD_ID) and (NAMESPACE_DECL_DECLS_FIELD_ID != NAMESPACE_DECL_NAME_FIELD_ID) and (NAMESPACE_DECL_DECLS_FIELD_ID != NAMESPACE_DECL_POSITION_FIELD_ID) and (NAMESPACE_DECL_MODULE_FIELD_ID != NAMESPACE_DECL_NAME_FIELD_ID) and (NAMESPACE_DECL_MODULE_FIELD_ID != NAMESPACE_DECL_POSITION_FIELD_ID) and (NAMESPACE_DECL_NAME_FIELD_ID != NAMESPACE_DECL_POSITION_FIELD_ID))
                NodeKind.GlobalDecl:
                    return ((GLOBAL_DECL_MUTABLE_FIELD_ID != GLOBAL_DECL_NAME_FIELD_ID) and (GLOBAL_DECL_MUTABLE_FIELD_ID != GLOBAL_DECL_POSITION_FIELD_ID) and (GLOBAL_DECL_MUTABLE_FIELD_ID != GLOBAL_DECL_TYPE_FIELD_ID) and (GLOBAL_DECL_MUTABLE_FIELD_ID != GLOBAL_DECL_VALUE_FIELD_ID) and (GLOBAL_DECL_NAME_FIELD_ID != GLOBAL_DECL_POSITION_FIELD_ID) and (GLOBAL_DECL_NAME_FIELD_ID != GLOBAL_DECL_TYPE_FIELD_ID) and (GLOBAL_DECL_NAME_FIELD_ID != GLOBAL_DECL_VALUE_FIELD_ID) and (GLOBAL_DECL_POSITION_FIELD_ID != GLOBAL_DECL_TYPE_FIELD_ID) and (GLOBAL_DECL_POSITION_FIELD_ID != GLOBAL_DECL_VALUE_FIELD_ID) and (GLOBAL_DECL_TYPE_FIELD_ID != GLOBAL_DECL_VALUE_FIELD_ID))
                NodeKind.ConstDecl:
                    return ((CONST_DECL_NAME_FIELD_ID != CONST_DECL_POSITION_FIELD_ID) and (CONST_DECL_NAME_FIELD_ID != CONST_DECL_TYPE_FIELD_ID) and (CONST_DECL_NAME_FIELD_ID != CONST_DECL_VALUE_FIELD_ID) and (CONST_DECL_POSITION_FIELD_ID != CONST_DECL_TYPE_FIELD_ID) and (CONST_DECL_POSITION_FIELD_ID != CONST_DECL_VALUE_FIELD_ID) and (CONST_DECL_TYPE_FIELD_ID != CONST_DECL_VALUE_FIELD_ID))
