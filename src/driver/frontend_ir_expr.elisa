# `.elisair` v2 — EXPRESSION nodes. Every form stage1's AST cannot map onto exactly one stage0
# node refuses by name rather than guessing. Continues frontend_ir_write.elisa.

extend IrWrite:
    private:

        def ir_expr_node(bodies: mutable darray[u8]&, nodes: mutable u32&, refusal: mutable darray[u8]&, expression: Ast::Expr, filename: sview) -> u32:
            can Memory.Allocate, Abort.Panic:
                fields: mutable darray[u8] = []
                live: mutable u32 = 0
                match expression:
                    Ast::Expr.Absent:
                        return 0
                    Ast::Expr.Invalid:
                        ir_refuse(refusal, "malformed expression")
                        return 0
                    # stage0 keeps the literal's SOURCE spelling; stage1's AST keeps the
                    # decoded value and nothing else, so a hex or digit-separated literal
                    # would come back respelled. Refusing is the only honest answer until
                    # `Expr.IntLit` carries its text.
                    Ast::Expr.IntLit(literal_value, _):
                        digits: mutable darray[u8] = []
                        Bytes::push_int(&digits, literal_value)
                        # push_int's contract is non-negative decimal input. Keep the IR
                        # writer total even if a malformed or unsupported AST violates that
                        # contract: taking &digits[0] on an empty encoding used to trap the
                        # compiler with SIGTRAP instead of refusing the source.
                        if digits.count == 0:
                            ir_refuse(refusal, "integer literal outside the IR writer's decimal domain")
                            return 0
                        ir_put_str(&fields, &live, 4, sview(&digits[0], 0, digits.count.i64()))
                        return ir_emit_node(bodies, nodes, 139, fields, live)
                    Ast::Expr.FloatLit(text, _):
                        ir_put_str(&fields, &live, 3, text)
                        return ir_emit_node(bodies, nodes, 67, fields, live)
                    Ast::Expr.StringLit(text, _):
                        ir_put_str(&fields, &live, 2, text)
                        return ir_emit_node(bodies, nodes, 253, fields, live)
                    Ast::Expr.CharLit(text, _):
                        ir_put_str(&fields, &live, 2, text)
                        return ir_emit_node(bodies, nodes, 28, fields, live)
                    Ast::Expr.BoolLit(value, _):
                        ir_put_bool(&fields, &live, 2, value)
                        return ir_emit_node(bodies, nodes, 18, fields, live)
                    Ast::Expr.Ident(name, ident_pos):
                        ir_put_str(&fields, &live, 1, name)
                        ir_put_pos(&fields, &live, 2, ident_pos, filename)
                        return ir_emit_node(bodies, nodes, 132, fields, live)
                    Ast::Expr.ShorthandMember(parts, member_pos):
                        ir_put_str_list(&fields, &live, 1, parts)
                        ir_put_pos(&fields, &live, 2, member_pos, filename)
                        return ir_emit_node(bodies, nodes, 230, fields, live)
                    Ast::Expr.Binary(left, operator, right, binary_pos):
                        left_id: u32 = ir_expr_node(bodies, nodes, refusal, left, filename)
                        right_id: u32 = ir_expr_node(bodies, nodes, refusal, right, filename)
                        ir_put_node(&fields, &live, 1, left_id)
                        # `emit_tokens_kind_code` is the fixture-validated stage1->stage0 kind
                        # bridge (its codes are stage0's ordinal + 1), so the operator needs
                        # no second table.
                        ir_put_int(&fields, &live, 3, emit_tokens_kind_code(operator).i64() - 1)
                        ir_put_pos(&fields, &live, 4, binary_pos, filename)
                        ir_put_node(&fields, &live, 5, right_id)
                        return ir_emit_node(bodies, nodes, 15, fields, live)
                    Ast::Expr.Unary(operator, operand, unary_pos):
                        operand_id: u32 = ir_expr_node(bodies, nodes, refusal, operand, filename)
                        ir_put_int(&fields, &live, 2, emit_tokens_kind_code(operator).i64() - 1)
                        ir_put_node(&fields, &live, 3, operand_id)
                        ir_put_pos(&fields, &live, 4, unary_pos, filename)
                        return ir_emit_node(bodies, nodes, 268, fields, live)
                    Ast::Expr.Move(operand, move_pos):
                        operand_id: u32 = ir_expr_node(bodies, nodes, refusal, operand, filename)
                        ir_put_node(&fields, &live, 1, operand_id)
                        ir_put_pos(&fields, &live, 2, move_pos, filename)
                        return ir_emit_node(bodies, nodes, 192, fields, live)
                    Ast::Expr.Paren(inner, paren_pos):
                        inner_id: u32 = ir_expr_node(bodies, nodes, refusal, inner, filename)
                        ir_put_node(&fields, &live, 1, inner_id)
                        ir_put_pos(&fields, &live, 2, paren_pos, filename)
                        return ir_emit_node(bodies, nodes, 205, fields, live)
                    Ast::Expr.Field(object, field, field_pos):
                        object_id: u32 = ir_expr_node(bodies, nodes, refusal, object, filename)
                        ir_put_str(&fields, &live, 1, field)
                        ir_put_node(&fields, &live, 2, object_id)
                        ir_put_pos(&fields, &live, 3, field_pos, filename)
                        return ir_emit_node(bodies, nodes, 65, fields, live)
                    # `A::B` is a dotted NAME to stage0 — the same spelling its analyser
                    # resolves a module member to — not a two-node path.
                    Ast::Expr.Scope(base, member, scope_pos):
                        dotted: mutable darray[u8] = []
                        if not ir_dotted_name(&dotted, expression):
                            ir_refuse(refusal, "qualified path")
                            return 0
                        ir_put_str(&fields, &live, 1, sview(&dotted[0], 0, dotted.count.i64()))
                        ir_put_pos(&fields, &live, 2, scope_pos, filename)
                        return ir_emit_node(bodies, nodes, 132, fields, live)
                    Ast::Expr.Index(object, index, index_pos):
                        object_id: u32 = ir_expr_node(bodies, nodes, refusal, object, filename)
                        index_id: u32 = ir_expr_node(bodies, nodes, refusal, index, filename)
                        ir_put_node(&fields, &live, 5, index_id)
                        ir_put_node(&fields, &live, 8, object_id)
                        ir_put_pos(&fields, &live, 9, index_pos, filename)
                        return ir_emit_node(bodies, nodes, 138, fields, live)
                    Ast::Expr.IndexN(object, arguments, indexn_pos):
                        # stage0's IndexExpr has Index and Index2 and no more, so a
                        # subscript of any other arity has no faithful node.
                        if arguments.count != 2:
                            ir_refuse(refusal, "multi-argument subscript")
                            return 0
                        object_id: u32 = ir_expr_node(bodies, nodes, refusal, object, filename)
                        first_id: u32 = ir_expr_node(bodies, nodes, refusal, arguments[0], filename)
                        second_id: u32 = ir_expr_node(bodies, nodes, refusal, arguments[1], filename)
                        ir_put_node(&fields, &live, 5, first_id)
                        ir_put_node(&fields, &live, 6, second_id)
                        ir_put_node(&fields, &live, 8, object_id)
                        ir_put_pos(&fields, &live, 9, indexn_pos, filename)
                        return ir_emit_node(bodies, nodes, 138, fields, live)
                    Ast::Expr.Slice(object, low, high, slice_pos):
                        object_id: u32 = ir_expr_node(bodies, nodes, refusal, object, filename)
                        low_id: u32 = ir_expr_node(bodies, nodes, refusal, low, filename)
                        high_id: u32 = ir_expr_node(bodies, nodes, refusal, high, filename)
                        ir_put_node(&fields, &live, 1, high_id)
                        ir_put_node(&fields, &live, 2, object_id)
                        ir_put_pos(&fields, &live, 3, slice_pos, filename)
                        ir_put_node(&fields, &live, 4, low_id)
                        return ir_emit_node(bodies, nodes, 233, fields, live)
                    Ast::Expr.Call(callee, arguments, argument_names, call_pos):
                        callee_id: u32 = ir_expr_node(bodies, nodes, refusal, callee, filename)
                        argument_ids: mutable darray[u32] = []
                        for argument in arguments |bodies, nodes, refusal, argument_ids|:
                            argument_ids.push(ir_expr_node(bodies, nodes, refusal, argument, filename))
                        any_name: mutable bool = false
                        for argument_name in argument_names |any_name|:
                            any_name <- true if sview_len(argument_name) != 0
                        ir_put_str_list(&fields, &live, 3, argument_names) if any_name
                        ir_put_node_list(&fields, &live, 5, argument_ids)
                        ir_put_node(&fields, &live, 6, callee_id)
                        ir_put_pos(&fields, &live, 10, call_pos, filename)
                        return ir_emit_node(bodies, nodes, 22, fields, live)
                    Ast::Expr.Array(elements, array_pos):
                        element_ids: mutable darray[u32] = []
                        for element in elements |bodies, nodes, refusal, element_ids|:
                            element_ids.push(ir_expr_node(bodies, nodes, refusal, element, filename))
                        ir_put_node_list(&fields, &live, 2, element_ids)
                        ir_put_pos(&fields, &live, 5, array_pos, filename)
                        return ir_emit_node(bodies, nodes, 160, fields, live)
                    Ast::Expr.SetLit(elements, set_pos):
                        element_ids: mutable darray[u32] = []
                        for element in elements |bodies, nodes, refusal, element_ids|:
                            element_ids.push(ir_expr_node(bodies, nodes, refusal, element, filename))
                        ir_put_bool(&fields, &live, 1, true)
                        ir_put_node_list(&fields, &live, 2, element_ids)
                        ir_put_pos(&fields, &live, 5, set_pos, filename)
                        return ir_emit_node(bodies, nodes, 160, fields, live)
                    Ast::Expr.DictLit(entries, dict_pos):
                        key_ids: mutable darray[u32] = []
                        value_ids: mutable darray[u32] = []
                        for entry_index in 0..<entries.count |bodies, nodes, refusal, key_ids, value_ids|:
                            key_ids.push(ir_expr_node(bodies, nodes, refusal, entries[entry_index].key, filename))
                            value_ids.push(ir_expr_node(bodies, nodes, refusal, entries[entry_index].value, filename))
                        ir_put_bool(&fields, &live, 1, true)
                        ir_put_node_list(&fields, &live, 2, value_ids)
                        ir_put_node_list(&fields, &live, 3, key_ids)
                        ir_put_pos(&fields, &live, 5, dict_pos, filename)
                        return ir_emit_node(bodies, nodes, 160, fields, live)
                    Ast::Expr.Tuple(elements, tuple_pos):
                        element_ids: mutable darray[u32] = []
                        for element in elements |bodies, nodes, refusal, element_ids|:
                            element_ids.push(ir_expr_node(bodies, nodes, refusal, element, filename))
                        ir_put_node_list(&fields, &live, 1, element_ids)
                        ir_put_pos(&fields, &live, 2, tuple_pos, filename)
                        return ir_emit_node(bodies, nodes, 263, fields, live)
                    Ast::Expr.Construct(type_expression, initializers, construct_pos):
                        type_name: mutable darray[u8] = []
                        if not ir_dotted_name(&type_name, type_expression):
                            ir_refuse(refusal, "constructed type path")
                            return 0
                        value_ids: mutable darray[u32] = []
                        labels: mutable darray[sview] = []
                        for initializer_index in 0..<initializers.count |bodies, nodes, refusal, value_ids, labels|:
                            value_ids.push(ir_expr_node(bodies, nodes, refusal, initializers[initializer_index].value, filename))
                            labels.push(initializers[initializer_index].name)
                        ir_put_str_list(&fields, &live, 1, labels)
                        ir_put_node_list(&fields, &live, 2, value_ids)
                        ir_put_bool(&fields, &live, 3, true)
                        ir_put_str(&fields, &live, 4, sview(&type_name[0], 0, type_name.count.i64()))
                        ir_put_pos(&fields, &live, 5, construct_pos, filename)
                        return ir_emit_node(bodies, nodes, 255, fields, live)
                    Ast::Expr.RecordUpdate(base, initializers, update_pos):
                        base_id: u32 = ir_expr_node(bodies, nodes, refusal, base, filename)
                        value_ids: mutable darray[u32] = []
                        labels: mutable darray[sview] = []
                        for initializer_index in 0..<initializers.count |bodies, nodes, refusal, value_ids, labels|:
                            value_ids.push(ir_expr_node(bodies, nodes, refusal, initializers[initializer_index].value, filename))
                            labels.push(initializers[initializer_index].name)
                        ir_put_str_list(&fields, &live, 1, labels)
                        ir_put_node_list(&fields, &live, 2, value_ids)
                        ir_put_node(&fields, &live, 3, base_id)
                        ir_put_pos(&fields, &live, 4, update_pos, filename)
                        return ir_emit_node(bodies, nodes, 216, fields, live)
                    Ast::Expr.If(condition, then_expr, else_expr, if_pos):
                        condition_id: u32 = ir_expr_node(bodies, nodes, refusal, condition, filename)
                        then_id: u32 = ir_expr_node(bodies, nodes, refusal, then_expr, filename)
                        else_id: u32 = ir_expr_node(bodies, nodes, refusal, else_expr, filename)
                        ir_put_node(&fields, &live, 1, else_id)
                        ir_put_node(&fields, &live, 2, condition_id)
                        ir_put_pos(&fields, &live, 3, if_pos, filename)
                        ir_put_node(&fields, &live, 4, then_id)
                        return ir_emit_node(bodies, nodes, 258, fields, live)
                    Ast::Expr.Match(scrutinee, arms, match_pos):
                        scrutinee_id: u32 = ir_expr_node(bodies, nodes, refusal, scrutinee, filename)
                        arms_payload: mutable darray[u8] = []
                        ir_arms_out(&arms_payload, bodies, nodes, refusal, arms, filename)
                        ir_put_raw(&fields, &live, 1, arms_payload)
                        ir_put_pos(&fields, &live, 2, match_pos, filename)
                        ir_put_node(&fields, &live, 4, scrutinee_id)
                        return ir_emit_node(bodies, nodes, 172, fields, live)
                    Ast::Expr.Block(statements, value, captures, block_pos):
                        statement_ids: mutable darray[u32] = []
                        for statement in statements |bodies, nodes, refusal, statement_ids|:
                            statement_ids.push(ir_stmt_node(bodies, nodes, refusal, statement, filename))
                        value_id: u32 = ir_expr_node(bodies, nodes, refusal, value, filename)
                        ir_put_str_list(&fields, &live, 1, captures)
                        ir_put_pos(&fields, &live, 2, block_pos, filename)
                        ir_put_node_list(&fields, &live, 3, statement_ids)
                        ir_put_node(&fields, &live, 4, value_id)
                        return ir_emit_node(bodies, nodes, 59, fields, live)
                    Ast::Expr.Lambda(parameter_names, body, lambda_pos):
                        body_ids: mutable darray[u32] = []
                        for statement in body |bodies, nodes, refusal, body_ids|:
                            body_ids.push(ir_stmt_node(bodies, nodes, refusal, statement, filename))
                        params_payload: mutable darray[u8] = []
                        ir_uvarint_out(&params_payload, parameter_names.count.u64())
                        for parameter_name in parameter_names |params_payload|:
                            ir_named_param_out(&params_payload, parameter_name)
                        ir_put_node_list(&fields, &live, 1, body_ids)
                        ir_put_raw(&fields, &live, 5, params_payload) if parameter_names.count != 0
                        ir_put_pos(&fields, &live, 6, lambda_pos, filename)
                        return ir_emit_node(bodies, nodes, 146, fields, live)
                    # `T where PRED` stands for BOTH of stage0's TryExpr and GetExpr in
                    # stage1's AST, so there is no single node to pick. Refused by name
                    # rather than guessed: this is exactly the false clean the format
                    # makes easy to produce.
                    Ast::Expr.Refinement(_, _, _):
                        ir_refuse(refusal, "refinement (`try` / `get` are one node in stage1)")
                        return 0
                    _:
                        ir_refuse(refusal, "expression")
                        return 0



        # A `ParamDecl` inline struct carrying only a name — the shape a lambda's
        # parameter list needs.
        def ir_named_param_out(payload: mutable darray[u8]&, name: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                fields: mutable darray[u8] = []
                live: mutable u32 = 0
                ir_put_str(&fields, &live, 3, name)
                ir_uvarint_out(payload, 204)
                ir_uvarint_out(payload, live.u64())
                for byte in fields |payload|:
                    payload.push(byte)
