# Driver — the never-leak lint (`-Wnever-leak`, `-Werror=never-leak`; src/semantic/check_never_leak.elisa).
#
# OPT-IN and stage1 only: the CLI sets ELISA_STAGE1_NEVER_LEAK=warn|error (the variable may also be
# set directly), and `-permissive` sets ELISA_STAGE1_PERMISSIVE, which turns it off. With the
# variable unset this file does nothing, so every gate and every stage0 parity check is untouched.
#
# The semantic layer decides; this file renders, because a useful message needs the SOURCE TEXT:
# each finding prints the rewrite built from the user's own lines. ELISA_STAGE1_NEVER_LEAK_STATS=1
# adds one tab-separated `never-leak-stat` row per finding, exempt ones included, for corpus counts.

# 0 = off, 1 = warn, 2 = error.
def never_leak_mode() -> u8 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    0 return if env_flag_enabled("ELISA_STAGE1_PERMISSIVE")
    setting: mutable darray[u8] = []
    0 return if not env_value("ELISA_STAGE1_NEVER_LEAK", &setting)
    0 return if setting.count == 1 and setting[0] == 48
    2 return if setting.count == 5 and setting[0] == 101 and setting[1] == 114 and setting[2] == 114
    return 1


# The source the AST was parsed from, split into lines (1-based, flat line numbers), with the
# include line map resolved once per line: a diagnostic names the reader's file and line.
struct NeverLeakSource:
    bytes: mutable darray[u8] = []
    starts: mutable darray[usize] = []
    map_bytes: mutable darray[u8] = []
    map_flat: mutable darray[u32] = []
    map_orig: mutable darray[u32] = []
    map_path_starts: mutable darray[usize] = []
    map_path_stops: mutable darray[usize] = []
    # Per flat line (index line - 1): the map entry that covers it, or NL_NO_ENTRY.
    line_entries: mutable darray[u32] = []


const NL_NO_ENTRY: u32 = 4294967295


def nl_load_source(source: mutable NeverLeakSource&, src_ptr: u8&, source_len: usize) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    source.starts.push(0)
    for offset in 0..<source_len |source, src_ptr|:
        byte: u8 = src_ptr[offset]
        source.bytes.push(byte)
        source.starts.push(offset + 1) if byte == 10
    if env_value("ELISA_STAGE1_LINE_MAP", &source.map_bytes):
        cursor: mutable usize = 0
        while cursor < source.map_bytes.count |cursor, source|:
            flat: mutable u32 = 0
            while cursor < source.map_bytes.count and source.map_bytes[cursor] != 58 |cursor, flat, source|:
                flat <- flat * 10 + (source.map_bytes[cursor] - 48).u32()
                cursor <- cursor + 1
            cursor <- cursor + 1
            orig: mutable u32 = 0
            while cursor < source.map_bytes.count and source.map_bytes[cursor] != 58 |cursor, orig, source|:
                orig <- orig * 10 + (source.map_bytes[cursor] - 48).u32()
                cursor <- cursor + 1
            cursor <- cursor + 1
            path_start: usize = cursor
            while cursor < source.map_bytes.count and source.map_bytes[cursor] != 10 |cursor, source|:
                cursor <- cursor + 1
            source.map_flat.push(flat)
            source.map_orig.push(orig)
            source.map_path_starts.push(path_start)
            source.map_path_stops.push(cursor)
            cursor <- cursor + 1
    # The covering entry of a line is the one with the greatest flat start at or before it
    # (push_diagnostic_location's rule; a later entry wins a tie). Sort the entries by flat
    # start (stable insertion sort; one entry per included file) and sweep the lines once.
    order: mutable darray[u32] = []
    for entry in 0..<source.map_flat.count |order, source|:
        position: mutable usize = order.count
        order.push(entry.u32())
        while position > 0 and source.map_flat[order[position - 1].usize()] > source.map_flat[entry] |position, order, source, entry|:
            order[position] <- order[position - 1]
            position <- position - 1
        order[position] <- entry.u32()
    next: mutable usize = 0
    covering: mutable u32 = NL_NO_ENTRY
    for line_index in 0..<source.starts.count |source, order, next, covering|:
        line: u32 = (line_index + 1).u32()
        while next < order.count and source.map_flat[order[next].usize()] <= line |next, covering, order, source, line|:
            covering <- order[next] if source.map_flat[order[next].usize()] > 0
            next <- next + 1
        source.line_entries.push(covering)


# The line number a reader sees in their own file for a flat line.
def nl_orig_line(source: NeverLeakSource&, flat_line: u32) -> u32 can[Abort.Panic]:
    0 return if flat_line == 0
    index: usize = (flat_line - 1).usize()
    flat_line return if index >= source.line_entries.count
    entry: u32 = source.line_entries[index]
    flat_line return if entry == NL_NO_ENTRY
    return source.map_orig[entry.usize()] + (flat_line - source.map_flat[entry.usize()])


# `PATH:LINE` for a flat line, the location report_diagnostic prints.
def nl_push_location(buffer: mutable darray[u8]&, source: NeverLeakSource&, flat_line: u32) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    index: usize = (flat_line - 1).usize() if flat_line > 0 else 0
    entry: u32 = source.line_entries[index] if index < source.line_entries.count else NL_NO_ENTRY
    if entry == NL_NO_ENTRY:
        push_diagnostic_location(buffer, flat_line)
        return
    for path_index in source.map_path_starts[entry.usize()]..<source.map_path_stops[entry.usize()] |buffer, source|:
        buffer.push(source.map_bytes[path_index])
    buffer.push(58)
    append_decimal(buffer, nl_orig_line(source, flat_line))


def nl_line_start(source: NeverLeakSource&, line: u32) -> usize can[Abort.Panic]:
    index: usize = (line - 1).usize()
    return source.bytes.count if line == 0 or index >= source.starts.count else source.starts[index]


# The line's text without its newline.
def nl_line_end(source: NeverLeakSource&, line: u32) -> usize can[Abort.Panic]:
    cursor: mutable usize = nl_line_start(source, line)
    while cursor < source.bytes.count and source.bytes[cursor] != 10 |cursor, source|:
        cursor <- cursor + 1
    return cursor


def nl_indent_width(source: NeverLeakSource&, line: u32) -> usize can[Abort.Panic]:
    start: usize = nl_line_start(source, line)
    stop: usize = nl_line_end(source, line)
    cursor: mutable usize = start
    while cursor < stop and (source.bytes[cursor] == 32 or source.bytes[cursor] == 9) |cursor, source|:
        cursor <- cursor + 1
    return cursor - start


# A line that holds no code (blank or a comment).
def nl_line_is_filler(source: NeverLeakSource&, line: u32) -> bool can[Abort.Panic]:
    start: usize = nl_line_start(source, line) + nl_indent_width(source, line)
    stop: usize = nl_line_end(source, line)
    return start >= stop or source.bytes[start] == 35


# The last code line of the statement that starts at `first` and ends before `next`.
def nl_statement_last_line(source: NeverLeakSource&, first: u32, next: u32) -> u32 can[Abort.Panic]:
    last: mutable u32 = first
    if next > first:
        last <- next - 1
    while last > first and nl_line_is_filler(source, last) |last, source, first|:
        last <- last - 1
    return last


def nl_push_bytes(buffer: mutable darray[u8]&, source: NeverLeakSource&, start: usize, stop: usize) -> void can[Abort.Panic, Memory.Allocate]:
    for index in start..<stop |buffer, source|:
        buffer.push(source.bytes[index])


def nl_push_spaces(buffer: mutable darray[u8]&, count: usize) -> void can[Abort.Panic, Memory.Allocate]:
    for _space in 0..<count |buffer|:
        buffer.push(32)


# One rewrite line: the gutter, then the source line shifted right by `extra` columns.
def nl_push_shifted_line(buffer: mutable darray[u8]&, source: NeverLeakSource&, line: u32, extra: usize) -> void can[Abort.Panic, Memory.Allocate]:
    nl_push_spaces(buffer, 6)
    if not nl_line_is_filler(source, line) or nl_line_end(source, line) > nl_line_start(source, line):
        nl_push_spaces(buffer, extra)
    nl_push_bytes(buffer, source, nl_line_start(source, line), nl_line_end(source, line))
    buffer.push(10)


# Lines [first, last] shifted right by `extra`; a long range keeps its first and last four lines.
def nl_push_shifted_range(buffer: mutable darray[u8]&, source: NeverLeakSource&, first: u32, last: u32, extra: usize) -> void can[Abort.Panic, Memory.Allocate]:
    return if last < first
    if last - first < 12:
        for line in first..<(last + 1) |buffer, source, extra|:
            nl_push_shifted_line(buffer, source, line, extra)
        return
    for head in first..<(first + 4) |buffer, source, extra|:
        nl_push_shifted_line(buffer, source, head, extra)
    nl_push_spaces(buffer, 6 + nl_indent_width(source, first) + extra)
    emit_tokens_push_sview(buffer, "# ... ")
    append_decimal(buffer, last - first - 7)
    emit_tokens_push_sview(buffer, " more lines ...\n")
    for tail_line in (last - 3)..<(last + 1) |buffer, source, extra|:
        nl_push_shifted_line(buffer, source, tail_line, extra)


def nl_push_line_ref(buffer: mutable darray[u8]&, source: NeverLeakSource&, flat_line: u32) -> void can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(buffer, "line ")
    append_decimal(buffer, nl_orig_line(source, flat_line))


# `first line of a statement`, trimmed, in backquotes (cut at 60 bytes).
def nl_push_quoted_line(buffer: mutable darray[u8]&, source: NeverLeakSource&, line: u32) -> void can[Abort.Panic, Memory.Allocate]:
    start: usize = nl_line_start(source, line) + nl_indent_width(source, line)
    stop: usize = nl_line_end(source, line)
    buffer.push(96)
    if stop - start > 60:
        nl_push_bytes(buffer, source, start, start + 57)
        emit_tokens_push_sview(buffer, "...")
    else:
        nl_push_bytes(buffer, source, start, stop)
    buffer.push(96)


def nl_push_name(buffer: mutable darray[u8]&, name: sview) -> void can[Abort.Panic, Memory.Allocate]:
    buffer.push(96)
    emit_tokens_push_sview(buffer, name)
    buffer.push(96)


def run_never_leak(file: Ast::File&, src_ptr: u8&, source_len: usize) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    mode: u8 = never_leak_mode()
    0 return if mode == 0
    PhaseTimer::mark("semantic-checks")
    findings: mutable darray[Semantic::NeverLeakFinding] = []
    Semantic::never_leak_findings(file, &findings)
    PhaseTimer::mark("never-leak")
    source: mutable NeverLeakSource = NeverLeakSource{}
    nl_load_source(source, src_ptr, source_len)
    stats: bool = env_flag_enabled("ELISA_STAGE1_NEVER_LEAK_STATS")
    reported: mutable i64 = 0
    for finding in findings |reported, source, stats, mode|:
        nl_report_stat(finding, source) if stats
        continue if finding.category == Semantic::NEVER_LEAK_BORROW_EXEMPT
        nl_report_finding(finding, source, mode)
        reported <- reported + 1
    PhaseTimer::mark("never-leak-report")
    return reported if mode == 2 else 0


def nl_category_name(category: u8) -> sview can[Abort.Panic]:
    return when category:
        1 -> "chain"
        2 -> "plain"
        3 -> "borrow-exempt"
        4 -> "overlap"
        _ -> "loop"


def nl_report_stat(finding: Semantic::NeverLeakFinding&, source: NeverLeakSource&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    row: mutable darray[u8] = []
    emit_tokens_push_sview(row, "never-leak-stat\t")
    nl_push_location(row, source, finding.decl_line)
    row.push(9)
    emit_tokens_push_sview(row, nl_category_name(finding.category))
    emit_tokens_push_sview(row, "-escape") if finding.escapes and finding.category == Semantic::NEVER_LEAK_CHAIN
    row.push(9)
    emit_tokens_push_sview(row, finding.name)
    row.push(9)
    append_decimal(row, finding.depth)
    row.push(9)
    row.push(49 if finding.used_next else 48)
    row.push(9)
    row.push(49 if finding.last_is_next else 48)
    row.push(9)
    emit_tokens_push_sview(row, finding.keeper)
    row.push(9)
    append_decimal(row, finding.visible_count)
    row.push(9)
    append_decimal(row, finding.last_use_line - finding.decl_line)
    row.push(9)
    emit_tokens_push_sview(row, finding.function_name)
    row.push(10)
    write_stderr(row)
