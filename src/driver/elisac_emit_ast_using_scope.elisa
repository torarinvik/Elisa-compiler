# Reconstruct each source `using` declaration from parser annotations while
# retaining the lexical module and byte offset used to place it in the AST.
struct EmitAstUsing:
    target: sview @source
    scope: sview @source
    line: u32
    offset: u32

def emit_ast_using_rows(annotations: darray[Ast::EnumAnnotation]&) -> darray[EmitAstUsing] can[Abort.Panic, Memory.Allocate]:
    rows: mutable darray[EmitAstUsing] = []
    for annotation in annotations |rows, annotations|:
        if annotation.name == "__using_alias_target":
            rows.push(EmitAstUsing{target: annotation.owner, scope: annotation.module, line: annotation.line, offset: annotation.offset})
        elif annotation.name == "__using":
            has_alias: mutable bool = false
            for candidate in annotations |has_alias, annotation, annotations|:
                if candidate.name == "__using_alias_target" and candidate.owner == annotation.owner and candidate.module == annotation.module and candidate.line == annotation.line and candidate.offset >= annotation.offset:
                    intervening: mutable bool = false
                    for other in annotations |intervening, annotation, candidate|:
                        intervening <- true if other.name == "__using" and other.module == annotation.module and other.line == annotation.line and other.offset > annotation.offset and other.offset < candidate.offset
                    has_alias <- true if not intervening
            rows.push(EmitAstUsing{target: annotation.owner, scope: annotation.module, line: annotation.line, offset: annotation.offset}) if not has_alias
        elif annotation.name == "__using_member":
            import_scope: mutable sview = ""
            for candidate in annotations |import_scope, annotation|:
                import_scope <- candidate.module if candidate.owner == "__from_src" and candidate.name == annotation.owner and candidate.line == annotation.line and candidate.offset == annotation.offset
            rows.push(EmitAstUsing{target: annotation.owner, scope: import_scope, line: annotation.line, offset: annotation.offset})
    return rows
