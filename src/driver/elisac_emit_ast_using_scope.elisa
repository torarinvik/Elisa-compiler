# Reconstruct source `using` declarations with their lexical module and offset.
struct EmitAstUsing:
    target: sview @source
    scope: sview @source
    line: u32
    offset: u32
    visible: bool

def emit_ast_using_rows(annotations: darray[Ast::EnumAnnotation]&) -> darray[EmitAstUsing] can[Abort.Panic, Memory.Allocate]:
    rows: mutable darray[EmitAstUsing] = []
    for index in 0..<annotations.count |rows, annotations|:
        annotation: Ast::EnumAnnotation = annotations[index]
        if annotation.name == "__using":
            # The parser emits this before the optional alias-target row.
            rows.push(EmitAstUsing{target: annotation.owner, scope: annotation.module, line: annotation.line, offset: annotation.offset, visible: true})
        elif annotation.name == "__using_alias_target":
            paired: mutable bool = false
            if rows.count > 0:
                previous: EmitAstUsing = rows[rows.count - 1]
                paired <- previous.target == annotation.owner and previous.scope == annotation.module and previous.line == annotation.line and previous.offset <= annotation.offset
            rows.push(EmitAstUsing{target: annotation.owner, scope: annotation.module, line: annotation.line, offset: annotation.offset, visible: true}) if not paired
        elif annotation.name == "__from_decl":
            # Stage0 counts a from-import declaration but emits no summary line.
            rows.push(EmitAstUsing{target: annotation.owner, scope: annotation.module, line: annotation.line, offset: annotation.offset, visible: false})
        elif annotation.name == "__using_member":
            # record_from_import_member emits the scope-bearing source row just
            # before this marker; walk backwards to avoid rescanning earlier imports.
            import_scope: mutable sview = ""
            probe: mutable i64 = index.i64() - 1
            while probe >= 0 |probe, import_scope, annotations, annotation|:
                candidate: Ast::EnumAnnotation = annotations[probe.usize()]
                if candidate.owner == "__from_src" and candidate.name == annotation.owner and candidate.line == annotation.line and candidate.offset == annotation.offset:
                    import_scope <- candidate.module
                    break
                probe <- probe - 1
            rows.push(EmitAstUsing{target: annotation.owner, scope: import_scope, line: annotation.line, offset: annotation.offset, visible: true})
    return rows
