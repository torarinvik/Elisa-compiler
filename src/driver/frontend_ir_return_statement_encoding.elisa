# Stage0 frontend-IR v2 IDs for ReturnStmt and its optional value reference.
module FrontendIrReturnStatementEncoding:
    public:
        const enum ReturnStatementField of u8:
            Position
            Value

        const RETURN_STMT_NODE_TYPE_ID: u32 = 228
        const RETURN_POSITION_FIELD_ID: u32 = 1
        const RETURN_VALUE_FIELD_ID: u32 = 2
        const RETURN_NO_VALUE_NODE_ID: u32 = 0

        def node_type_id() -> u32:
            ensure result == RETURN_STMT_NODE_TYPE_ID
            return RETURN_STMT_NODE_TYPE_ID

        def no_value_node_id() -> u32:
            ensure result == RETURN_NO_VALUE_NODE_ID
            return RETURN_NO_VALUE_NODE_ID

        def field_id(field: ReturnStatementField) -> u32:
            ensure field != ReturnStatementField.Position or result == RETURN_POSITION_FIELD_ID
            ensure field != ReturnStatementField.Value or result == RETURN_VALUE_FIELD_ID
            return match field:
                ReturnStatementField.Position: RETURN_POSITION_FIELD_ID
                ReturnStatementField.Value: RETURN_VALUE_FIELD_ID
