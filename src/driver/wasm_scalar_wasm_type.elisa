# Closed scalar mapping for the canonical WASM ABI. The proof gate also checks that the
# export binding builder uses this exact mapping when deciding which types can be emitted.
module WasmScalarWasmType:
    public:
        # Pure membership predicate for contracts that must remain free of the mapping
        # function's Abort.Panic effect.
        def is_scalar_type_name(type_text: sview) -> bool:
            ensure when type_text:
                "i8" | "u8" | "i16" | "u16" | "i32" | "u32" | "int" | "isize" | "usize" | "uintptr" | "bool" | "i64" | "u64" | "char" | "f32" | "f64" | "void" -> result == (true)
                _ -> result == (false)
            return when type_text:
                "i8" | "u8" | "i16" | "u16" | "i32" | "u32" | "int" | "isize" | "usize" | "uintptr" | "bool" | "i64" | "u64" | "char" | "f32" | "f64" | "void" -> true
                _ -> false

        def wasm_scalar_wasm_type(type_text: sview) -> sview can[Abort.Panic]:
            ensure when type_text:
                "i8" | "u8" | "i16" | "u16" | "i32" | "u32" | "int" | "isize" | "usize" | "uintptr" | "bool" -> ((result == "i32")) == (true)
                _ -> ((result == "i32")) == (false)
            ensure when type_text:
                "i64" | "u64" | "char" -> ((result == "i64")) == (true)
                _ -> ((result == "i64")) == (false)
            ensure (result == "f32") == (type_text == "f32")
            ensure (result == "f64") == (type_text == "f64")
            ensure (result == "void") == (type_text == "void")
            ensure (result == "") == (not is_scalar_type_name(type_text))
            can Abort.Panic:
                return when type_text:
                    "i8" | "u8" | "i16" | "u16" | "i32" | "u32" | "int" | "isize" | "usize" | "uintptr" | "bool" -> "i32"
                    "i64" | "u64" | "char" -> "i64"
                    "f32" -> "f32"
                    "f64" -> "f64"
                    "void" -> "void"
                    _ -> ""
