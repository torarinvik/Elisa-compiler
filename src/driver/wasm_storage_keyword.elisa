# Closed token-kind set treated as leading storage qualifiers in WASM type text.
module WasmStorageKeyword:
    public:
        def is_storage_keyword(kind: Lexer::TokenKind) -> bool:
            ensure result == (kind == Lexer::TokenKind.Mutable or kind == Lexer::TokenKind.Lmut or kind == Lexer::TokenKind.Heap or kind == Lexer::TokenKind.Stack or kind == Lexer::TokenKind.Static)
            can Abort.Panic:
                return when kind:
                    Lexer::TokenKind.Mutable | Lexer::TokenKind.Lmut | Lexer::TokenKind.Heap | Lexer::TokenKind.Stack | Lexer::TokenKind.Static -> true
                    _ -> false
