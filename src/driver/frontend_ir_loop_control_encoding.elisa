# Stage0 frontend-IR v2 tags and position field for unlabeled loop-control statements.
module FrontendIrLoopControlEncoding:
    public:
        const enum LoopControlKind of u8:
            Break
            Continue

        const BREAK_STMT_NODE_TYPE_ID: u32 = 19
        const CONTINUE_STMT_NODE_TYPE_ID: u32 = 34
        const LOOP_CONTROL_POSITION_FIELD_ID: u32 = 1

        def node_type_id(kind: LoopControlKind) -> u32:
            ensure kind != LoopControlKind.Break or result == BREAK_STMT_NODE_TYPE_ID
            ensure kind != LoopControlKind.Continue or result == CONTINUE_STMT_NODE_TYPE_ID
            match kind:
                LoopControlKind.Break:
                    return BREAK_STMT_NODE_TYPE_ID
                LoopControlKind.Continue:
                    return CONTINUE_STMT_NODE_TYPE_ID

        def position_field_id(kind: LoopControlKind) -> u32:
            ensure kind != LoopControlKind.Break or result == LOOP_CONTROL_POSITION_FIELD_ID
            ensure kind != LoopControlKind.Continue or result == LOOP_CONTROL_POSITION_FIELD_ID
            match kind:
                LoopControlKind.Break:
                    return LOOP_CONTROL_POSITION_FIELD_ID
                LoopControlKind.Continue:
                    return LOOP_CONTROL_POSITION_FIELD_ID

        def label_is_unlabeled(label: sview) -> bool:
            ensure result == (label.len == 0)
            return label.len == 0
