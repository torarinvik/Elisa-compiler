
include "./elisac_pymodule_dict_type_2.elisa"
include "./elisac_pymodule_dict_type_3.elisa"

# `-emit pymodule` — the DICT type name. The Python-dict bridge keeps the native bucket layout
# boring: scalar integer or text keys and a closed set of value shapes, each spelled out here
# rather than derived, so an unsupported shape is declined by name.


# The Python-dict bridge keeps the native bucket layout boring: scalar integer/text keys, scalar
# numeric/bool/text values, borrowed opaque Python-object values, and explicitly mapped nested
# darrays/views all have a direct C representation. Other complex values remain explicit
# diagnostics until their ownership and aggregate ABI are mapped rather than guessed.
def pymodule_dict_type_name(key_name: sview, value_name: sview) -> sview can[Abort.Panic]:
    return "dict[i8,darray[py::Object?]]" if key_name == "i8" and value_name == "darray[py::Object?]"
    return "dict[i16,darray[py::Object?]]" if key_name == "i16" and value_name == "darray[py::Object?]"
    return "dict[i32,darray[py::Object?]]" if key_name == "i32" and value_name == "darray[py::Object?]"
    return "dict[int,darray[py::Object?]]" if key_name == "int" and value_name == "darray[py::Object?]"
    return "dict[isize,darray[py::Object?]]" if key_name == "isize" and value_name == "darray[py::Object?]"
    return "dict[char,darray[py::Object?]]" if key_name == "char" and value_name == "darray[py::Object?]"
    return "dict[u8,darray[py::Object?]]" if key_name == "u8" and value_name == "darray[py::Object?]"
    return "dict[u16,darray[py::Object?]]" if key_name == "u16" and value_name == "darray[py::Object?]"
    return "dict[u32,darray[py::Object?]]" if key_name == "u32" and value_name == "darray[py::Object?]"
    return "dict[i64,darray[py::Object?]]" if key_name == "i64" and value_name == "darray[py::Object?]"
    return "dict[u64,darray[py::Object?]]" if key_name == "u64" and value_name == "darray[py::Object?]"
    return "dict[usize,darray[py::Object?]]" if key_name == "usize" and value_name == "darray[py::Object?]"
