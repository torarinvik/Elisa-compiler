# Driver — SOURCE and ENVIRONMENT probes: the replay headers the stage0 differential corpus puts
# in a file's first eight lines, whether this unit is the trusted standard library, and the
# ELISA_STAGE1_* switches (emit mode, target triple, optimisation level, debug info, and the
# semantic gate, which is ON by default).

# Does the SOURCE contain the standard library's own definition of `arena_alloc`? That is the
# marker for "this unit IS the trusted stdlib (or the compiler, which includes it)" — the same
# test scripts/elisac_stage1.sh applies to decide the flag, moved INTO the driver so every
# caller gets the same answer.
def source_defines_arena_alloc(source: u8&, length: usize) -> bool can[Abort.Panic]:
    marker: sview = "def arena_alloc("
    marker_length: usize = sview_len(marker)
    false return if length < marker_length
    limit: usize = length - marker_length
    start: mutable usize = 0
    while start <= limit |start|:
        matched: mutable bool = true
        offset: mutable usize = 0
        while offset < marker_length |offset, matched|:
            matched <- false if source[start + offset] != sview_at(marker, offset)
            break if not matched
            offset <- offset + 1.usize()
        true return if matched
        start <- start + 1.usize()
    return false




# Whether one of the first eight source lines is `# DIRECTIVE`. These replay headers carry
# semantic options through the source-only stage1 protocol; silently dropping one disables the
# corresponding checker and invalidates differential coverage.
def source_has_header(source: u8&, length: usize, directive: sview) -> bool can[Abort.Panic]:
    directive_length: usize = sview_len(directive)
    line_start: mutable usize = 0
    line_count: mutable usize = 0
    while line_start < length and line_count < 8.usize() |line_start, line_count|:
        cursor: mutable usize = line_start
        while cursor < length and (source[cursor] == 32 or source[cursor] == 9) |cursor|:
            cursor <- cursor + 1.usize()
        if cursor < length and source[cursor] == 35:
            cursor <- cursor + 1.usize()
            while cursor < length and (source[cursor] == 32 or source[cursor] == 9) |cursor|:
                cursor <- cursor + 1.usize()
            matched: mutable bool = cursor + directive_length <= length
            directive_index: mutable usize = 0
            while matched and directive_index < directive_length |matched, directive_index|:
                matched <- false if source[cursor + directive_index] != sview_at(directive, directive_index)
                directive_index <- directive_index + 1.usize()
            if matched:
                after: usize = cursor + directive_length
                return true if after == length or source[after] == 10 or source[after] == 13 or source[after] == 32 or source[after] == 9
        while line_start < length and source[line_start] != 10 |line_start|:
            line_start <- line_start + 1.usize()
        line_start <- line_start + 1.usize() if line_start < length
        line_count <- line_count + 1.usize()
    return false




# Replay headers used by the stage0 differential corpus.
def source_has_smt_header(source: u8&, length: usize) -> bool can[Abort.Panic]:
    return source_has_header(source, length, "smt")




def source_has_proofhole_header(source: u8&, length: usize) -> bool can[Abort.Panic]:
    return source_has_header(source, length, "proofhole")




def source_has_strict_header(source: u8&, length: usize) -> bool can[Abort.Panic]:
    return source_has_header(source, length, "strict")




def source_has_unsafe_header(source: u8&, length: usize) -> bool can[Abort.Panic]:
    return source_has_header(source, length, "unsafe")




def source_has_global_header(source: u8&, length: usize) -> bool can[Abort.Panic]:
    return source_has_header(source, length, "globals")




# Is this compilation unit the TRUSTED STANDARD LIBRARY (or the compiler, which
# includes it)? stage0 decides per FILE (isRuntimeStdPermissionInternal) and skips the
# passes that only apply to user code — the raw-concurrency surface removal and the
# region-tied-return check. stage1 cannot reproduce that granularity: include flattening
# concatenates without line directives, so a declaration's originating file is gone by the
# time the driver sees the source.
#
# So decide from the FLATTENED UNIT'S CONTENT, in the DRIVER. It used to be decided only by
# the wrapper and passed in through an env var, which meant every OTHER way of reaching the
# driver had to remember to set it: the moment the semantic gate became the default,
# self_host_gen3_smoke's stage B — which pipes the flattened compiler straight into gen2 —
# reported 24 region-tied-return errors and read as "bootstrap closure BROKE". The unit had
# not changed; only who was asking. A decision that belongs to the source belongs where the
# source is read.
#
# The env var still forces it on, for a caller that knows better than the marker.
#
# Coarser than stage0 (whole-unit rather than per-file) — it differs only for a program that
# includes the std AND redefines one of the removed names itself.
def runtime_std_enabled(source: u8&, length: usize) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    true return if source_defines_arena_alloc(source, length)
    flag_storage: mutable darray[u8] = []
    for index in 0..<sview_len("ELISA_STAGE1_RUNTIME_STD") |flag_storage|:
        flag_storage.push(sview_at("ELISA_STAGE1_RUNTIME_STD", index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is real:
        return true
    return false




# ON BY DEFAULT. A compiler that does not CHECK is not a compiler: without this the driver
# went parse -> emit and stage1 accepted programs stage0 rejects.
#
# It was opt-in while a stage1-COMPILED semantic layer computed differently from a
# stage0-compiled one. That is fixed. What it took, in the order the failures surfaced:
#   * `d <- d.put(k, v)` stored the helper's return value over the dict header;
#   * the deep packed pattern's probe ladder read the next level's handle without first
#     branching on the current level's tag;
#   * `for b in sview(literal, 0, -1)` compared the index UNSIGNED, so the std's
#     NUL-terminated sentinel read as 2^64-1;
#   * `scope` was an UNGUARDED contextual block keyword, so `scope.push(x)` parsed as a
#     `scope:` block — and Semantic.mark_mutable_locals' parameter is named `scope`, which
#     alone accounted for 319 E10 false positives on the compiler's own source;
#   * string literals reached LLVM with their escapes undecoded.
#
# gen2 now analyses the compiler's own 110k-line source with ZERO error-severity findings,
# exactly as the stage0-built driver does, and parse_report built by the two compilers agrees
# on 505 of 507 source files (the two are the same severity-2 warning, which does not gate).
#
# ELISA_STAGE1_NO_SEMANTIC_GATE=1 turns it off — an escape hatch for bisecting a suspected
# analyzer regression, not a supported mode.
# Is an environment flag present (any value)?
def env_flag_enabled(name: sview) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag_storage: mutable darray[u8] = []
    for index in 0..<sview_len(name) |flag_storage, name|:
        flag_storage.push(sview_at(name, index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is present:
        return true
    return false




# Does this emit mode ANALYSE before it reports?
#
# stage0 splits its modes in two, and the split is not obvious from what they print.
# MEASURED against stage0 on a program with an undefined identifier:
#
#   gated  (exit 1, no report): iface header packed unsafe progress c-bind-check
#                               c-bind-check-json test-runner tests benches fixtures
#                               test interpret
#   ungated (exit 0, reports):  tokens ast fmt doc lowered deps deps-json
#
# The ungated ones are pure syntax projections — a formatter and a parse dump still have
# something honest to say about a program that does not typecheck. The gated ones all
# describe SEMANTICS (an ABI, a capability set, a test list), so stage0 refuses to
# describe a program it has already rejected.
#
# stage1 ran none of them through the gate, so every mode in the first list published a
# report for programs stage0 refuses — an ABI header for a type stage0 says is not
# C-compatible, an unsafe audit for a program that does not compile.
def emit_mode_analyses_first() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    true return if emit_mode_is("iface")
    true return if emit_mode_is("header")
    true return if emit_mode_is("pymodule")
    true return if emit_mode_is("pymodule-c")
    true return if emit_mode_is("packed")
    true return if emit_mode_is("unsafe")
    true return if emit_mode_is("progress")
    true return if emit_mode_is("c-bind-check")
    true return if emit_mode_is("c-bind-check-json")
    true return if emit_mode_is("test-runner")
    true return if emit_mode_is("tests")
    true return if emit_mode_is("benches")
    true return if emit_mode_is("fixtures")
    true return if emit_mode_is("test")
    true return if emit_mode_is("interpret")
    true return if emit_mode_is("c-archive")
    # stage0 analyses before writing a bundle (`emit_runner.go`, case emitIR).
    true return if emit_mode_is("ir")
    return false




# The analysis gate: report every ERROR-severity finding and answer how many there were.
# Severity 2 (warnings) do not block, matching stage0.
def run_semantic_gate(file: Ast::File&, src_ptr: u8&, source_len: usize) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    0 return if not semantic_gate_enabled()
    semantic_errors: mutable i64 = 0
    # The semantic table is needed only while diagnostics are being reported. Keep it in an
    # explicit region so its large side tables are released before backend codegen starts; the
    # old function-level lifetime kept the complete table live alongside the LLVM module and
    # pushed self-hosting the compiler over the workstation's memory guard.
    region semantic_gate:
        diagnostics: mutable darray[Semantic::Diagnostic] = []
        Semantic::check_full_diagnostics(file, &diagnostics, source_has_strict_header(src_ptr, source_len), false, runtime_std_enabled(src_ptr, source_len), false, env_flag_enabled("ELISA_STAGE1_SMT") or source_has_smt_header(src_ptr, source_len), false, false, false, source_has_unsafe_header(src_ptr, source_len), source_has_proofhole_header(src_ptr, source_len), 64, source_has_global_header(src_ptr, source_len))
        for diagnostic in diagnostics |semantic_errors|:
            severity: u8 = Semantic::diagnostic_severity(diagnostic)
            if severity == 1:
                semantic_errors <- semantic_errors + 1
                report_diagnostic(diagnostic)
            elif severity == 2 and emit_mode_is("interpret"):
                # The interpreter is a user-facing execution mode. Stage0 prints its
                # non-fatal semantic warnings before the result line, so preserve that
                # observable contract while keeping ordinary code-generation modes quiet.
                report_diagnostic(diagnostic)
            elif severity == 0 and source_has_proofhole_header(src_ptr, source_len):
                # Proof-hole hints are explicitly requested output, not ordinary warnings.
                # Keep compilation successful while exposing unresolved assertions to proof
                # authors and automated repair agents.
                report_diagnostic(diagnostic)
    return semantic_errors



def semantic_gate_enabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    # getenv needs a NUL-terminated string and an sview carries no terminator;
    # Backend::sview_to_cstr is private to that module, so terminate it here.
    flag_storage: mutable darray[u8] = []
    for index in 0..<sview_len("ELISA_STAGE1_NO_SEMANTIC_GATE") |flag_storage|:
        flag_storage.push(sview_at("ELISA_STAGE1_NO_SEMANTIC_GATE", index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is real:
        return false
    return true




# The requested optimisation level, from ELISA_STAGE1_OPT ("1"/"2"/"3"; absent or
# anything else = 0). Level 0 skips the pass manager entirely — emitting unoptimised
# objects stays the default, so the fixpoint and every existing measurement are unchanged
# unless a caller ASKS for optimisation.
# The requested target triple from ELISA_STAGE1_TRIPLE, or an empty view for "host".
# `storage` must outlive the returned view, so the caller owns it.
def requested_target_triple(storage: mutable darray[u8]&) -> sview can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag_storage: mutable darray[u8] = []
    for flag_index in 0..<sview_len("ELISA_STAGE1_TRIPLE") |flag_storage|:
        flag_storage.push(sview_at("ELISA_STAGE1_TRIPLE", flag_index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is triple_bytes:
        cursor: mutable i64 = 0
        keep_scanning: mutable bool = true
        while keep_scanning |cursor, keep_scanning, storage, triple_bytes|:
            byte_ref: u8& = triple_bytes + cursor
            triple_byte: u8 = byte_ref
            if triple_byte == 0:
                keep_scanning <- false
            else:
                storage.push(triple_byte)
                cursor <- cursor + 1
    return sview("", 0, 0) if storage.count == 0 else sview(&storage[0], 0, storage.count)




def optimization_level() -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag_storage: mutable darray[u8] = []
    for index in 0..<sview_len("ELISA_STAGE1_OPT") |flag_storage|:
        flag_storage.push(sview_at("ELISA_STAGE1_OPT", index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is level_bytes:
        # Compare as C strings (ctx_streq content compare) rather than dereferencing
        # the env byte: a `u8&` binding read in a value context goes through an
        # auto-deref path this driver otherwise never exercises.
        level_c: cstr = (level_bytes).cast[cstr] can Unsafe.PointerCast
        1 return if level_c == "1"
        2 return if level_c == "2"
        3 return if level_c == "3"
    return 0




# Native builds opt into DWARF and statement tracing through the same environment bridge used
# by the host wrapper. Keeping both switches here makes the stdin protocol and the direct CLI
# share exactly one backend call, which is important for the profiler's local compiler.
def debug_info_enabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    return env_flag_enabled("ELISA_STAGE1_DEBUG")




def trace_info_enabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    return env_flag_enabled("ELISA_STAGE1_TRACE")




# ELISA_STAGE1_EMIT=llvm writes textual IR to the output path instead of an object —
# the same module, the same pipeline, just printed rather than lowered. Anything else
# (or absent) keeps the object path.
def emit_mode_is(wanted: sview) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag_storage: mutable darray[u8] = []
    for index in 0..<sview_len("ELISA_STAGE1_EMIT") |flag_storage|:
        flag_storage.push(sview_at("ELISA_STAGE1_EMIT", index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is mode_bytes:
        mode_c: cstr = (mode_bytes).cast[cstr] can Unsafe.PointerCast
        wanted_storage: mutable darray[u8] = []
        for wanted_index in 0..<sview_len(wanted) |wanted_storage, wanted|:
            wanted_storage.push(sview_at(wanted, wanted_index))
        wanted_storage.push(0)
        wanted_c: cstr = (&wanted_storage[0]).cast[cstr] can Unsafe.PointerCast
        return mode_c == wanted_c
    return false




def emit_llvm_requested() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        return emit_mode_is("llvm")
