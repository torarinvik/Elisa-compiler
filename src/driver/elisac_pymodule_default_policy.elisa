# `-emit pymodule` — what a default may BE on the Python side: hashable values, empty
# containers, enum members, and the scalar literals the generated module reproduces directly.


def pymodule_default_python_hashable_type(type_name: sview) -> bool can[Abort.Panic]:
    return true if type_name == "cstr" or type_name == "sview" or type_name == "bool" or type_name == "f32" or type_name == "f64" or type_name == "i8" or type_name == "i16" or type_name == "i32" or type_name == "i64" or type_name == "int" or type_name == "isize" or type_name == "char" or type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or type_name == "usize" or type_name == "uintptr"
    return false




def pymodule_default_python_value_supported(file: Ast::File&, type_name: sview, expression: Ast::Expr, depth: usize = 0.usize()) -> bool can[Abort.Panic, Memory.Allocate]:
    # Container defaults are accepted only when every leaf is a literal that the
    # generated Python builder can materialize without evaluating Elisa code.
    # Semantic type checking has already established the element/key/value types;
    # this pass only decides whether the boundary has a safe Python constructor.
    return false if depth > 32.usize()
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_python_value_supported(file, type_name, default_inner, depth)
    return pymodule_parameter_is_implicit_optional(type_name) if pymodule_default_is_null(expression)
    # Nullable leaves use the same Python literal as their contained value.  Keep the
    # null case above, then recurse through the optional ABI spelling so aggregate
    # defaults such as `[1, null]` and `{"missing": null}` are accepted without
    # duplicating every scalar branch for every `T?` type.
    if type_name == "cstr?":
        return pymodule_default_string_literal_supported(expression)
    if pymodule_is_optional_scalar_type(type_name):
        optional_leaf_type_name: sview = pymodule_optional_payload_name(type_name)
        return false if optional_leaf_type_name == ""
        return pymodule_default_python_value_supported(file, optional_leaf_type_name, expression, depth)
    if type_name == "cstr" or type_name == "sview":
        return pymodule_default_string_literal_supported(expression)
    if type_name == "bool":
        return expression is Expr.BoolLit(_, _)
    if type_name == "f32" or type_name == "f64":
        return pymodule_default_literal_supported(expression) and not expression is Expr.BoolLit(_, _)
    if type_name == "i8" or type_name == "i16" or type_name == "i32" or type_name == "i64" or type_name == "int" or type_name == "isize" or type_name == "char":
        return pymodule_default_integer_value_supported(file, type_name, expression)
    if type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or type_name == "usize" or type_name == "uintptr":
        return pymodule_default_integer_value_supported(file, type_name, expression) and not pymodule_default_has_minus(expression)
    if pymodule_is_darray_type(type_name):
        if expression is Expr.Array(default_elements, default_array_pos):
            element_type_name: sview = pymodule_darray_element_name(type_name)
            return false if element_type_name == ""
            for default_element in default_elements:
                return false if not pymodule_default_python_value_supported(file, element_type_name, default_element, depth + 1.usize())
            return true
    if pymodule_is_view_type(type_name):
        if expression is Expr.Array(default_view_elements, default_view_pos):
            view_element_type_name: sview = pymodule_view_element_name(type_name)
            return false if view_element_type_name == ""
            for default_view_element in default_view_elements:
                return false if not pymodule_default_python_value_supported(file, view_element_type_name, default_view_element, depth + 1.usize())
            return true
    if pymodule_is_dict_type(type_name):
        if expression is Expr.DictLit(default_entries, default_dict_pos):
            key_type_name: sview = pymodule_dict_key_name(type_name)
            value_type_name: sview = pymodule_dict_value_name(type_name)
            return false if key_type_name == "" or value_type_name == ""
            return false if not pymodule_default_python_hashable_type(key_type_name)
            for default_entry in default_entries:
                return false if not pymodule_default_python_value_supported(file, key_type_name, default_entry.key, depth + 1.usize())
                return false if not pymodule_default_python_value_supported(file, value_type_name, default_entry.value, depth + 1.usize())
            return true
    if pymodule_is_set_type(type_name):
        if expression is Expr.SetLit(default_set_elements, default_set_pos):
            set_element_type_name: sview = pymodule_set_element_name(type_name)
            return false if set_element_type_name == ""
            return false if not pymodule_default_python_hashable_type(set_element_type_name)
            for default_set_element in default_set_elements:
                return false if not pymodule_default_python_value_supported(file, set_element_type_name, default_set_element, depth + 1.usize())
            return true
        if expression is Expr.DictLit(default_set_entries, default_set_dict_pos):
            return default_set_entries.count == 0
    declaration: Ast::Decl? = pymodule_find_struct_in(file.top_decls, type_name)
    if declaration is target:
        if target is Decl.Struct(default_struct_name, default_struct_members, default_struct_affinity, default_struct_named_states, default_struct_derive, default_struct_invariants, default_struct_pos):
            if expression is Expr.Construct(default_construct_type, default_construct_fields, default_construct_pos):
                return false if pymodule_bare_type_name(default_construct_type) != type_name
                for default_construct_field in default_construct_fields |file, depth, type_name|:
                    return false if default_construct_field.name == ""
                    construct_field_type_name: sview = pymodule_struct_member_type_name(file, type_name, default_construct_field.name)
                    return false if construct_field_type_name == ""
                    return false if not pymodule_default_supported(file, construct_field_type_name, default_construct_field.value)
                return true
    return false




def pymodule_default_supported(file: Ast::File&, type_name: sview, expression: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_supported(file, type_name, default_inner)
    return pymodule_parameter_is_implicit_optional(type_name) if pymodule_default_is_null(expression)
    if type_name == "cstr" or type_name == "sview":
        return pymodule_default_string_literal_supported(expression)
    if type_name == "bool":
        return expression is Expr.BoolLit(_, _)
    if type_name == "f32" or type_name == "f64":
        return pymodule_default_literal_supported(expression) and not expression is Expr.BoolLit(_, _)
    if type_name == "i8" or type_name == "i16" or type_name == "i32" or type_name == "i64" or type_name == "int" or type_name == "isize" or type_name == "char":
        return pymodule_default_integer_value_supported(file, type_name, expression)
    if type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or type_name == "usize" or type_name == "uintptr":
        return pymodule_default_integer_value_supported(file, type_name, expression) and not pymodule_default_has_minus(expression)
    if pymodule_is_darray_type(type_name) or pymodule_is_view_type(type_name) or pymodule_is_dict_type(type_name) or pymodule_is_set_type(type_name):
        return pymodule_default_python_value_supported(file, type_name, expression)
    return pymodule_default_python_value_supported(file, type_name, expression)




# Struct fields use the same literal policy as function parameters. Aggregate defaults are first
# materialized as fresh Python objects and then sent through the ordinary field converter, keeping
# nested text/object retention and arena ownership identical to explicitly supplied values.
def pymodule_struct_default_supported(file: Ast::File&, type_name: sview, expression: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
    return pymodule_default_supported(file, type_name, expression)




def pymodule_default_is_empty_container(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.Array(default_elements, default_array_pos):
        return default_elements.count == 0
    if expression is Expr.DictLit(default_entries, default_dict_pos):
        return default_entries.count == 0
    if expression is Expr.SetLit(default_set_elements, default_set_pos):
        return default_set_elements.count == 0
    return false




def pymodule_default_is_container(expression: Ast::Expr) -> bool can[Abort.Panic]:
    return expression is Expr.Array(_, _) or expression is Expr.DictLit(_, _) or expression is Expr.SetLit(_, _) or expression is Expr.Construct(_, _, _)




def emit_pymodule_default_builder_symbol(buffer: mutable darray[u8]&, module_name: sview, function_name: sview, parameter_index: usize) -> void can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(buffer, "elisa_pymodule_")
    emit_tokens_push_sview(buffer, module_name)
    emit_tokens_push_sview(buffer, "_")
    emit_tokens_push_sview(buffer, function_name)
    emit_tokens_push_sview(buffer, "_default_")
    append_decimal(buffer, parameter_index.i64())




def emit_pymodule_struct_default_builder_symbol(buffer: mutable darray[u8]&, struct_type_name: sview, field_name: sview) -> void can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(buffer, "elisa_pymodule_struct_")
    emit_tokens_push_sview(buffer, struct_type_name)
    emit_tokens_push_sview(buffer, "_")
    emit_tokens_push_sview(buffer, pymodule_struct_c_field_name(field_name))
    emit_tokens_push_sview(buffer, "_default")




def emit_pymodule_default_python_scalar(buffer: mutable darray[u8]&, file: Ast::File&, type_name: sview, expression: Ast::Expr) -> void can[Abort.Panic, Memory.Allocate]:
    if pymodule_default_is_null(expression):
        # This helper is used as an initializer expression inside a container
        # builder, so retain the singleton and return it through the comma
        # operator rather than emitting a statement-level `return`.
        emit_tokens_push_sview(buffer, "(Py_INCREF(Py_None), Py_None)")
        return
    # Non-null optional leaves use the contained scalar's Python representation;
    # null itself returned above as `None`. This keeps nested defaults aligned with
    # the ordinary optional argument conversion rules.
    scalar_type_name: mutable sview = type_name
    scalar_type_name <- "cstr" if type_name == "cstr?"
    scalar_type_name <- "sview" if type_name == "sview?"
    scalar_type_name <- pymodule_optional_payload_name(type_name) if pymodule_is_optional_scalar_type(type_name)
    if scalar_type_name == "bool":
        emit_tokens_push_sview(buffer, "PyBool_FromLong((long)(")
        emit_pymodule_default_literal(buffer, file, expression)
        emit_tokens_push_sview(buffer, "))")
        return
    if scalar_type_name == "f32" or scalar_type_name == "f64":
        emit_tokens_push_sview(buffer, "PyFloat_FromDouble((double)(")
        emit_pymodule_default_literal(buffer, file, expression)
        emit_tokens_push_sview(buffer, "))")
        return
    if scalar_type_name == "u8" or scalar_type_name == "u16" or scalar_type_name == "u32" or scalar_type_name == "u64" or scalar_type_name == "usize" or scalar_type_name == "uintptr":
        emit_tokens_push_sview(buffer, "PyLong_FromUnsignedLongLong((unsigned long long)(")
        emit_pymodule_default_literal(buffer, file, expression)
        emit_tokens_push_sview(buffer, "))")
        return
    if scalar_type_name == "cstr" or scalar_type_name == "sview":
        emit_tokens_push_sview(buffer, "PyUnicode_FromStringAndSize(")
        emit_pymodule_default_literal(buffer, file, expression)
        emit_tokens_push_sview(buffer, ", (Py_ssize_t)(sizeof(")
        emit_pymodule_default_literal(buffer, file, expression)
        emit_tokens_push_sview(buffer, ") - 1))")
        return
    emit_tokens_push_sview(buffer, "PyLong_FromLongLong((long long)(")
    emit_pymodule_default_literal(buffer, file, expression)
    emit_tokens_push_sview(buffer, "))")




def pymodule_default_builder_child_name(storage: mutable darray[u8]&, parent_name: sview, suffix: sview, index: usize) -> sview can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(storage, parent_name)
    emit_tokens_push_sview(storage, suffix)
    append_decimal(storage, index.i64())
    return sview(&storage[0], 0, storage.count)




def pymodule_default_builder_field_name(storage: mutable darray[u8]&, parent_name: sview, field_name: sview) -> sview can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(storage, parent_name)
    emit_tokens_push_sview(storage, "_field_")
    emit_tokens_push_sview(storage, pymodule_struct_c_field_name(field_name))
    return sview(&storage[0], 0, storage.count)
