# AST-shape policy for values materialized by PyModule container defaults.
module PymoduleDefaultContainerShapePolicy:
    public:
        def is_empty_container(expression: Ast::Expr) -> bool can[Abort.Panic]:
            ensure match expression:
                Ast::Expr.Array(elements, _): result == (elements.count == 0)
                Ast::Expr.DictLit(entries, _): result == (entries.count == 0)
                Ast::Expr.SetLit(elements, _): result == (elements.count == 0)
                _: result == false
            can Abort.Panic:
                return match expression:
                    Ast::Expr.Array(elements, _): elements.count == 0
                    Ast::Expr.DictLit(entries, _): entries.count == 0
                    Ast::Expr.SetLit(elements, _): elements.count == 0
                    _: false

        def is_container(expression: Ast::Expr) -> bool can[Abort.Panic]:
            ensure match expression:
                Ast::Expr.Array(_, _): result == true
                Ast::Expr.DictLit(_, _): result == true
                Ast::Expr.SetLit(_, _): result == true
                Ast::Expr.Construct(_, _, _): result == true
                _: result == false
            can Abort.Panic:
                return match expression:
                    Ast::Expr.Array(_, _): true
                    Ast::Expr.DictLit(_, _): true
                    Ast::Expr.SetLit(_, _): true
                    Ast::Expr.Construct(_, _, _): true
                    _: false
