# Find the first import candidate that resolves this enum name. Core checks inherited and
# local wildcard `using` targets first, then its program-wide selective-import map. Wildcard
# rows are scope-ranked; selective rows retain global annotation order.
def pymodule_default_visible_enum_import(file: Ast::File&, enum_name: sview, lexical_owner: sview) -> (found: bool, ambiguous: bool, owner: sview) can[Abort.Panic, Memory.Allocate]:
    unresolved_selective_import: mutable bool = false
    for import_priority in 0..<2 |file, enum_name, lexical_owner|:
        if import_priority == 0:
            # Core flattens each block's wildcard rows before descending and prepends
            # inherited rows to local rows. Scope length orders outer usings first;
            # annotation order preserves source order within one scope.
            for import_scope_rank in 0..<(lexical_owner.len + 1.usize()) |file, enum_name, lexical_owner|:
                for import_annotation in file.enum_annotations |file, enum_name, lexical_owner, import_scope_rank|:
                    continue if import_annotation.module.len != import_scope_rank
                    continue if not pymodule_default_alias_scope_matches(import_annotation.module, lexical_owner)
                    continue if import_annotation.name != "__binding_wildcard_import"
                    source_module: sview = import_annotation.owner
                    source_module_path: mutable darray[u8] = []
                    if not pymodule_default_import_target_module_path(file, source_module, import_annotation.module, source_module_path):
                        continue
                    branch: (known: bool, active: bool) = pymodule_default_import_annotation_branch_selection(file, import_annotation)
                    continue if branch.known and not branch.active
                    if not branch.known:
                        return (true, true, "") if pymodule_default_imported_enum_candidate_exists(file, enum_name, source_module_path)
                        continue
                    imported_owner: (found: bool, ambiguous: bool, owner: sview) = pymodule_default_imported_enum_owner(file, enum_name, source_module_path, lexical_owner)
                    return (true, imported_owner.ambiguous, imported_owner.owner) if imported_owner.found
        else:
            # Core's importAliases map is program-wide, so a selective import declared in
            # a sibling module remains a candidate after lexical and wildcard lookup. Its
            # first mapping is the only selective candidate; a missing target falls through
            # to the raw root name rather than trying a later conflicting import.
            for import_annotation in file.enum_annotations |file, enum_name|:
                continue if import_annotation.owner != "__from_member" or import_annotation.name != enum_name
                branch: (known: bool, active: bool) = pymodule_default_import_annotation_branch_selection(file, import_annotation)
                continue if branch.known and not branch.active
                source_module: mutable sview = ""
                source_count: mutable usize = 0
                for source_annotation in file.enum_annotations |import_annotation, source_module, source_count|:
                    if source_annotation.owner == "__from_src" and source_annotation.module == import_annotation.module and source_annotation.line == import_annotation.line and source_annotation.offset == import_annotation.offset:
                        source_module <- source_annotation.name
                        source_count <- source_count + 1.usize()
                return (false, false, "") if source_count != 1.usize() or source_module == ""
                source_module_path: mutable darray[u8] = []
                if not pymodule_default_import_target_module_path(file, source_module, import_annotation.module, source_module_path):
                    return (false, false, "")
                if not branch.known:
                    if pymodule_default_imported_enum_candidate_exists(file, enum_name, source_module_path):
                        return (true, true, "")
                    unresolved_selective_import <- true
                    continue
                imported_owner: (found: bool, ambiguous: bool, owner: sview) = pymodule_default_imported_enum_owner(file, enum_name, source_module_path, lexical_owner)
                return (true, unresolved_selective_import or imported_owner.ambiguous, imported_owner.owner) if imported_owner.found
                return (false, false, "")
    # Import aliases are only additional candidates in Core lookup. When no imported source
    # declares this enum, continue to the raw root spelling in the caller.
    return (false, false, "")




# The `declared` bit matters for shadowing: a nearer enum name blocks imported and outer
# candidates even when it does not contain the requested variant.
def pymodule_default_enum_member_at_owner(file: Ast::File&, enum_name: sview, variant_name: sview, wanted_owner: sview) -> (declared: bool, found: bool, ambiguous: bool, value: i64) can[Abort.Panic]:
    declaration_count: mutable usize = 0
    variant_match_count: mutable usize = 0
    unknown_declaration: mutable bool = false
    value: mutable i64 = 0
    for enum_index in 0..<file.enum_decl_names.count |file, enum_name, variant_name, wanted_owner, declaration_count, variant_match_count, unknown_declaration, value|:
        continue if file.enum_decl_names[enum_index] != enum_name
        enum_owner: sview = file.enum_decl_owners[enum_index] if enum_index < file.enum_decl_owners.count else ""
        continue if enum_owner != wanted_owner
        branch: (known: bool, active: bool) = pymodule_default_enum_metadata_branch_selection(file, enum_index)
        continue if branch.known and not branch.active
        if not branch.known:
            declaration_count <- declaration_count + 1.usize()
            unknown_declaration <- true
            continue
        declaration_count <- declaration_count + 1.usize()
        variant_start: usize = file.enum_decl_variant_starts[enum_index]
        variant_count: usize = file.enum_decl_variant_counts[enum_index]
        for variant_index in 0..<variant_count |file, variant_start, variant_name, variant_match_count, value|:
            if file.enum_decl_variant_names[variant_start + variant_index] == variant_name:
                variant_match_count <- variant_match_count + 1.usize()
                value <- file.enum_decl_variant_values[variant_start + variant_index]
    return (declaration_count > 0, variant_match_count == 1 and declaration_count == 1 and not unknown_declaration, unknown_declaration or declaration_count > 1 or variant_match_count > 1, value)




def pymodule_default_enum_value(file: Ast::File&, expression: Ast::Expr) -> (found: bool, value: i64) can[Abort.Panic, Memory.Allocate]:
    if expression is Expr.Paren(default_enum_inner, default_enum_paren_pos):
        return pymodule_default_enum_value(file, default_enum_inner)
    if expression is Expr.Call(default_enum_callee, default_enum_arguments, default_enum_argument_names, default_enum_call_pos):
        return (false, 0) if default_enum_arguments.count != 0
        if default_enum_callee is Expr.Field(default_enum_base, default_enum_field, default_enum_field_pos):
            # Let integer suffixes reach the cast evaluator; a narrowing enum cast changes
            # the backing value (for example `Mode.Large.u8()`).
            return (false, 0) if pymodule_default_integer_cast_type(default_enum_field)
            # Non-integer cast-like suffixes preserve the scalar backing value here.
            return pymodule_default_enum_value(file, default_enum_base)
        return (false, 0)
    if expression is Expr.Field(default_enum_head, default_enum_variant, default_enum_field_pos):
        enum_name: mutable sview = ""
        enum_qualifier: mutable Ast::Expr? = null
        if default_enum_head is Expr.Ident(default_enum_ident_name, default_enum_ident_pos):
            enum_name <- default_enum_ident_name
        elif default_enum_head is Expr.Scope(default_enum_scope_head, default_enum_scope_name, default_enum_scope_pos):
            enum_name <- default_enum_scope_name
            enum_qualifier <- default_enum_scope_head
        if enum_name == "":
            return (false, 0)
        lexical_owner: sview = pymodule_default_expression_owner(file, expression)
        if enum_qualifier is qualifier:
            qualified_found: mutable bool = false
            qualified_value: mutable i64 = 0
            for enum_index in 0..<file.enum_decl_names.count |file, enum_name, qualifier, lexical_owner|:
                continue if file.enum_decl_names[enum_index] != enum_name
                continue if enum_index >= file.enum_decl_owners.count
                branch: (known: bool, active: bool) = pymodule_default_enum_metadata_branch_selection(file, enum_index)
                continue if branch.known and not branch.active
                return (false, 0) if not branch.known
                continue if not pymodule_default_enum_qualifier_matches_owner(file, qualifier, enum_name, file.enum_decl_owners[enum_index], file.enum_decl_owners[enum_index], lexical_owner)
                # A qualified source spelling still passes through Core's visibility
                # filter. Do not extract a private enum's value after its type candidate
                # would have been rejected by lookupVisibleType.
                continue if not pymodule_default_imported_enum_is_visible(file, enum_name, file.enum_decl_owners[enum_index], lexical_owner)
                variant_start: usize = file.enum_decl_variant_starts[enum_index]
                variant_count: usize = file.enum_decl_variant_counts[enum_index]
                for variant_index in 0..<variant_count |file, variant_start, default_enum_variant, qualified_found, qualified_value|:
                    if file.enum_decl_variant_names[variant_start + variant_index] == default_enum_variant:
                        return (false, 0) if qualified_found == true
                        qualified_found <- true
                        qualified_value <- file.enum_decl_variant_values[variant_start + variant_index]
            return (true, qualified_value) if qualified_found == true
            return (false, 0)

        # Resolve declarations through the complete lexical module chain before considering
        # any visible imports, matching check_global_authority.ga_resolve. A declaration in a
        # parent module therefore outranks an import in a nested module.
        candidate_owner: mutable sview = lexical_owner
        while candidate_owner != "" |file, enum_name, default_enum_variant, candidate_owner|:
            local_member: (declared: bool, found: bool, ambiguous: bool, value: i64) = pymodule_default_enum_member_at_owner(file, enum_name, default_enum_variant, candidate_owner)
            if local_member.declared:
                return (true, local_member.value) if local_member.found and not local_member.ambiguous
                return (false, 0)

            parent_separator: mutable usize = 0.usize()
            has_parent_separator: mutable bool = false
            if candidate_owner.len >= 2.usize():
                for owner_index in 0..<(candidate_owner.len - 1.usize()) |candidate_owner, parent_separator, has_parent_separator|:
                    if candidate_owner[owner_index] == 58 and candidate_owner[owner_index + 1.usize()] == 58:
                        parent_separator <- owner_index
                        has_parent_separator <- true
            if not has_parent_separator:
                break
            candidate_owner <- string_view_slice(candidate_owner, 0, parent_separator.i64())

        # Core's visible-type lookup tries lexical declarations, then imported aliases,
        # and only then the raw root spelling. Keep PyModule defaults in that same order
        # so an imported enum can shadow a same-named root enum.
        visible_import: (found: bool, ambiguous: bool, owner: sview) = pymodule_default_visible_enum_import(file, enum_name, lexical_owner)
        if visible_import.found:
            return (false, 0) if visible_import.ambiguous
            imported_member: (declared: bool, found: bool, ambiguous: bool, value: i64) = pymodule_default_enum_member_at_owner(file, enum_name, default_enum_variant, visible_import.owner)
            return (true, imported_member.value) if imported_member.found and not imported_member.ambiguous
            # Core has already selected the imported enum type. A missing or ambiguous
            # member on that type must not leak through to a same-named root enum.
            return (false, 0)

        top_level_member: (declared: bool, found: bool, ambiguous: bool, value: i64) = pymodule_default_enum_member_at_owner(file, enum_name, default_enum_variant, "")
        if top_level_member.declared:
            return (true, top_level_member.value) if top_level_member.found and not top_level_member.ambiguous
            return (false, 0)
    return (false, 0)




def pymodule_default_unsigned_literal_text_value(text: sview) -> (found: bool, value: u64) can[Abort.Panic]:
    return (false, 0) if text.len == 0
    is_hex: bool = text.len >= 2 and text[0] == 48 and (text[1] == 120 or text[1] == 88)
    start: usize = 2 if is_hex else 0
    base: u64 = 16 if is_hex else 10
    maximum: u64 = 18446744073709551615u64
    value: mutable u64 = 0
    digits: mutable usize = 0
    for index in start..<text.len |text, is_hex, base, maximum, value, digits|:
        byte: u8 = text[index].u8()
        continue if byte == 95
        digit: mutable u32 = 0
        if byte >= 48 and byte <= 57:
            digit <- (byte - 48).u32()
        elif is_hex and byte >= 97 and byte <= 102:
            digit <- (byte - 97 + 10).u32()
        elif is_hex and byte >= 65 and byte <= 70:
            digit <- (byte - 65 + 10).u32()
        else:
            return (false, 0)
        return (false, 0) if value > (maximum - digit.u64()) / base
        value <- value * base + digit.u64()
        digits <- digits + 1.usize()
    return (false, 0) if digits == 0
    return (true, value)




def pymodule_default_unsigned_literal_source_value(file: Ast::File&, position: Ast::Pos) -> (found: bool, value: u64) can[Abort.Panic, Memory.Allocate]:
    for annotation in file.enum_annotations:
        continue if annotation.owner != "__numeric_literal_value" or annotation.offset != position.offset
        return (false, 0) if annotation.line != position.line
        return pymodule_default_unsigned_literal_text_value(annotation.name)
    return (false, 0)




def pymodule_default_unsigned_literal_value(file: Ast::File&, expression: Ast::Expr, negative: bool = false) -> (found: bool, value: u64) can[Abort.Panic, Memory.Allocate]:
    if expression is Expr.IntLit(_, default_pos):
        return (false, 0) if negative
        return pymodule_default_unsigned_literal_source_value(file, default_pos)
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return pymodule_default_unsigned_literal_value(file, default_operand, not negative) if default_operator == Lexer::TokenKind.Minus
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_unsigned_literal_value(file, default_inner, negative)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        return (false, 0) if default_arguments.count != 0
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            if pymodule_default_integer_cast_type(default_field):
                cast_value: (found: bool, is_negative: bool, magnitude: u64) = pymodule_default_integer_cast_value(file, default_base, default_field)
                return (false, 0) if not cast_value.found or cast_value.is_negative != negative
                return (true, cast_value.magnitude)
            return pymodule_default_unsigned_literal_value(file, default_base, negative)
    return (false, 0)




def pymodule_default_signed_literal_value(file: Ast::File&, expression: Ast::Expr, negative: bool = false) -> (found: bool, is_negative: bool, magnitude: u64) can[Abort.Panic, Memory.Allocate]:
    if expression is Expr.IntLit(_, default_pos):
        source_value: (found: bool, value: u64) = pymodule_default_unsigned_literal_source_value(file, default_pos)
        return (source_value.found, negative, source_value.value)
    enum_value: (found: bool, value: i64) = pymodule_default_enum_value(file, expression)
    if enum_value.found:
        enum_is_negative: bool = enum_value.value < 0
        enum_magnitude: u64 = (9223372036854775808u64 if enum_value.value == -9223372036854775808 else (0 - enum_value.value).u64()) if enum_is_negative else enum_value.value.u64()
        return (true, enum_is_negative != negative, enum_magnitude)
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return pymodule_default_signed_literal_value(file, default_operand, not negative) if default_operator == Lexer::TokenKind.Minus
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_signed_literal_value(file, default_inner, negative)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        return (false, false, 0) if default_arguments.count != 0
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            if pymodule_default_integer_cast_type(default_field):
                cast_value: (found: bool, is_negative: bool, magnitude: u64) = pymodule_default_integer_cast_value(file, default_base, default_field)
                return (false, false, 0) if not cast_value.found
                return (true, cast_value.is_negative != negative, cast_value.magnitude)
            return pymodule_default_signed_literal_value(file, default_base, negative)
    return (false, false, 0)




def pymodule_default_integer_cast_type(type_name: sview) -> bool can[Abort.Panic]:
    return type_name == "i8" or type_name == "i16" or type_name == "i32" or type_name == "i64" or type_name == "s8" or type_name == "s16" or type_name == "s32" or type_name == "s64" or type_name == "int" or type_name == "isize" or type_name == "char" or type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or type_name == "usize" or type_name == "uintptr"




def pymodule_default_integer_cast_width(type_name: sview) -> u32 can[Abort.Panic]:
    if type_name == "i8" or type_name == "s8" or type_name == "u8":
        return 8
    if type_name == "i16" or type_name == "s16" or type_name == "u16":
        return 16
    if type_name == "i32" or type_name == "s32" or type_name == "u32":
        return 32
    if type_name == "int" or type_name == "isize" or type_name == "usize" or type_name == "uintptr":
        return (size_of(usize) * 8).u32()
    return 64




# Match Elisa's integer suffix conversion for literal defaults. This exact value feeds the
# generated C default, default range checks, and Python's displayed signature value.
def pymodule_default_integer_cast_value(file: Ast::File&, expression: Ast::Expr, cast_type: sview) -> (found: bool, is_negative: bool, magnitude: u64) can[Abort.Panic, Memory.Allocate]:
    return (false, false, 0) if not pymodule_default_integer_cast_type(cast_type)
    source: (found: bool, is_negative: bool, magnitude: u64) = pymodule_default_signed_literal_value(file, expression)
    return (false, false, 0) if not source.found
    width: u32 = pymodule_default_integer_cast_width(cast_type)
    bits: mutable u64 = 0
    if width == 64:
        if source.is_negative and source.magnitude > 0:
            bits <- 18446744073709551615u64 - (source.magnitude - 1u64)
        else:
            bits <- source.magnitude
    else:
        modulus: u64 = 1u64 << width
        remainder: u64 = source.magnitude % modulus
        bits <- (modulus - remainder) % modulus if source.is_negative
        bits <- remainder if not source.is_negative
    is_unsigned: bool = cast_type == "u8" or cast_type == "u16" or cast_type == "u32" or cast_type == "u64" or cast_type == "usize" or cast_type == "uintptr"
    return (true, false, bits) if is_unsigned
    sign_bit: u64 = 1u64 << (width - 1u32)
    return (true, false, bits) if bits < sign_bit
    if width == 64:
        return (true, true, 18446744073709551615u64 - bits + 1u64)
    return (true, true, (1u64 << width) - bits)




def pymodule_default_unsigned_integer_in_range(type_name: sview, value: u64) -> bool can[Abort.Panic]:
    if type_name == "u8":
        return value <= 255u64
    if type_name == "u16":
        return value <= 65535u64
    if type_name == "u32":
        return value <= 4294967295u64
    if type_name == "u64":
        return true
    if type_name == "usize" or type_name == "uintptr":
        return true if size_of(usize) >= size_of(u64)
        return value <= 4294967295u64
    return false




def pymodule_default_signed_integer_in_range(type_name: sview, negative: bool, magnitude: u64) -> bool can[Abort.Panic]:
    if type_name == "i8":
        return magnitude <= (128u64 if negative else 127u64)
    if type_name == "i16":
        return magnitude <= (32768u64 if negative else 32767u64)
    if type_name == "i32":
        return magnitude <= (2147483648u64 if negative else 2147483647u64)
    if type_name == "i64" or type_name == "char":
        return magnitude <= (9223372036854775808u64 if negative else 9223372036854775807u64)
    if type_name == "int" or type_name == "isize":
        if size_of(usize) < size_of(u64):
            return magnitude <= (2147483648u64 if negative else 2147483647u64)
        return magnitude <= (9223372036854775808u64 if negative else 9223372036854775807u64)
    return false




def pymodule_default_integer_value_supported(file: Ast::File&, type_name: sview, expression: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        if default_arguments.count == 0 and default_callee is Expr.Field(default_base, default_field, default_field_pos) and pymodule_default_integer_cast_type(default_field):
            cast_value: (found: bool, is_negative: bool, magnitude: u64) = pymodule_default_integer_cast_value(file, default_base, default_field)
            return false if not cast_value.found
            if PymoduleDefaultScalarTypePolicy::is_unsigned_integer_type_name(type_name):
                return not cast_value.is_negative and pymodule_default_unsigned_integer_in_range(type_name, cast_value.magnitude)
            if PymoduleDefaultScalarTypePolicy::is_signed_integer_type_name(type_name):
                return pymodule_default_signed_integer_in_range(type_name, cast_value.is_negative, cast_value.magnitude)
            return false
    if pymodule_default_integer_literal_supported(expression):
        if PymoduleDefaultScalarTypePolicy::is_unsigned_integer_type_name(type_name):
            unsigned_value: (found: bool, value: u64) = pymodule_default_unsigned_literal_value(file, expression)
            return unsigned_value.found and pymodule_default_unsigned_integer_in_range(type_name, unsigned_value.value)
        if PymoduleDefaultScalarTypePolicy::is_signed_integer_type_name(type_name):
            signed_value: (found: bool, is_negative: bool, magnitude: u64) = pymodule_default_signed_literal_value(file, expression)
            return signed_value.found and pymodule_default_signed_integer_in_range(type_name, signed_value.is_negative, signed_value.magnitude)
        return pymodule_default_integer_literal_fits(type_name, expression, false)
    enum_value: (found: bool, value: i64) = pymodule_default_enum_value(file, expression)
    return false if not enum_value.found
    return pymodule_default_integer_in_range(type_name, enum_value.value)




def pymodule_default_has_minus(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return true if default_operator == Lexer::TokenKind.Minus
        return pymodule_default_has_minus(default_operand)
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_has_minus(default_inner)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            return pymodule_default_has_minus(default_base)
    return false
