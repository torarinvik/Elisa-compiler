# Closed mapping from nested Python error payload leaf types to generated helper suffixes.
module PymoduleErrorHelperNames:
    public:
        def nested_darray_helper_suffix(element_name: sview) -> sview can[Abort.Panic]:
            return when element_name:
                "i8" -> "i8"
                "i16" -> "i16"
                "i32" -> "i32"
                "i64" -> "i64"
                "int" -> "int"
                "isize" -> "isize"
                "char" -> "char"
                "u8" -> "u8"
                "u16" -> "u16"
                "u32" -> "u32"
                "u64" -> "u64"
                "usize" -> "usize"
                "uintptr" -> "uintptr"
                "f32" -> "f32"
                "f64" -> "f64"
                "bool" -> "bool"
                "cstr" -> "cstr"
                "cstr?" -> "cstr_optional"
                "sview" -> "sview"
                "sview?" -> "sview_optional"
                "py::Object" -> "object"
                "py::Object?" -> "object_optional"
                "i8?" -> "i8_optional"
                "i16?" -> "i16_optional"
                "i32?" -> "i32_optional"
                "i64?" -> "i64_optional"
                "int?" -> "int_optional"
                "isize?" -> "isize_optional"
                "char?" -> "char_optional"
                "u8?" -> "u8_optional"
                "u16?" -> "u16_optional"
                "u32?" -> "u32_optional"
                "u64?" -> "u64_optional"
                "usize?" -> "usize_optional"
                "uintptr?" -> "uintptr_optional"
                "bool?" -> "bool_optional"
                "f32?" -> "f32_optional"
                "f64?" -> "f64_optional"
                _ -> ""
