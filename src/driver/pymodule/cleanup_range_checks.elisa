def emit_pymodule_scalar_range_check(buffer: mutable darray[u8]&, file: Ast::File&, target_params: darray[Ast::ParamDecl]&, type_name: sview, parameter_index: usize) -> void can[Abort.Panic, Memory.Allocate]:
    lower: mutable sview = ""
    upper: mutable sview = ""
    if type_name == "i8":
        lower <- "INT8_MIN"
        upper <- "INT8_MAX"
    elif type_name == "i16":
        lower <- "INT16_MIN"
        upper <- "INT16_MAX"
    elif type_name == "i32":
        lower <- "INT32_MIN"
        upper <- "INT32_MAX"
    elif type_name == "u8":
        upper <- "UINT8_MAX"
    elif type_name == "u16":
        upper <- "UINT16_MAX"
    elif type_name == "u32":
        upper <- "UINT32_MAX"
    elif type_name == "u64":
        upper <- "UINT64_MAX"
    elif type_name == "int" or type_name == "isize":
        lower <- "INTPTR_MIN"
        upper <- "INTPTR_MAX"
    elif type_name == "usize" or type_name == "uintptr":
        upper <- "UINTPTR_MAX"
    return if lower == "" and upper == ""
    emit_tokens_push_sview(buffer, "    if (")
    if type_name == "u64":
        emit_tokens_push_sview(buffer, "!elisa_pymodule_ull_fits_u64(arg")
        append_decimal(buffer, parameter_index.i64())
    else:
        if lower != "":
            emit_tokens_push_sview(buffer, "arg")
            append_decimal(buffer, parameter_index.i64())
            emit_tokens_push_sview(buffer, " < ")
            emit_tokens_push_sview(buffer, lower)
            emit_tokens_push_sview(buffer, " || ")
        emit_tokens_push_sview(buffer, "arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, " > ")
        emit_tokens_push_sview(buffer, upper)
    emit_tokens_push_sview(buffer, ") {\n        PyErr_SetString(PyExc_OverflowError, \"")
    emit_tokens_push_sview(buffer, type_name)
    emit_tokens_push_sview(buffer, " value out of range\");\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ", true, file)
    emit_tokens_push_sview(buffer, "        return NULL;\n    }\n")
