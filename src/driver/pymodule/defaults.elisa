# `-emit pymodule` — C scalar spellings, and the DEFAULT-ARGUMENT policy. Python defaults stay
# deliberately literal: each admitted form is named explicitly and its value range-checked
# against the C type it will be emitted as.


# C scalar spellings match the native LLVM ABI emitted for the corresponding Elisa source type.
# Empty means that `-emit pymodule-c` should refuse the entry instead of publishing a guessed ABI.
def pymodule_c_type_name(type_name: sview) -> sview can[Abort.Panic]:
    known_type: sview = when type_name:
        "void" -> "void"
        "py::Object" | "py::Object?" -> "PyObject *"
        "cstr" | "cstr?" -> "const char *"
        "sview" -> "ElisaSView"
        "sview?" -> "ElisaOptionalSView"
        "i8" -> "int8_t"
        "i16" -> "int16_t"
        "i32" -> "int32_t"
        "i64" | "char" -> "int64_t"
        "int" | "isize" -> "intptr_t"
        "u8" -> "uint8_t"
        "u16" -> "uint16_t"
        "u32" -> "uint32_t"
        "u64" -> "uint64_t"
        "usize" | "uintptr" -> "uintptr_t"
        "bool" -> "bool"
        "f32" -> "float"
        "f64" -> "double"
        "i8?" -> "ElisaOptionalI8"
        "i16?" -> "ElisaOptionalI16"
        "i32?" -> "ElisaOptionalI32"
        "i64?" | "char?" -> "ElisaOptionalI64"
        "int?" | "isize?" -> "ElisaOptionalInt"
        "u8?" -> "ElisaOptionalU8"
        "u16?" -> "ElisaOptionalU16"
        "u32?" -> "ElisaOptionalU32"
        "u64?" -> "ElisaOptionalU64"
        "usize?" | "uintptr?" -> "ElisaOptionalUSize"
        "bool?" -> "ElisaOptionalBool"
        "f32?" -> "ElisaOptionalF32"
        "f64?" -> "ElisaOptionalF64"
        _ -> ""
    return known_type if known_type != ""
    return "ElisaDict" if pymodule_is_dict_type(type_name)
    return "ElisaDArray" if pymodule_is_darray_type(type_name)
    return "ElisaView" if pymodule_is_view_type(type_name)
    return "ElisaSet" if pymodule_is_set_type(type_name)
    return ""




def pymodule_parse_format(type_name: sview) -> sview can[Abort.Panic]:
    format: sview = when type_name:
        "cstr" | "sview" -> "s#"
        "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "char" -> "L"
        "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" -> "K"
        "f32" | "f64" -> "d"
        "bool" -> "p"
        _ -> "O" if type_name != "" else ""
    return format




def pymodule_parameter_is_implicit_optional(type_name: sview) -> bool can[Abort.Panic]:
    return when type_name:
        "py::Object?" | "cstr?" -> true
        _ -> pymodule_is_optional_scalar_type(type_name)




def pymodule_default_is_null(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_is_null(default_inner)
    if expression is Expr.Ident(default_name, default_pos):
        return default_name == "null"
    return false




def pymodule_is_optional_scalar_type(type_name: sview) -> bool can[Abort.Panic]:
    return when type_name:
        "i8?" | "i16?" | "i32?" | "i64?" | "char?" -> true
        "int?" | "isize?" -> true
        "u8?" | "u16?" | "u32?" | "u64?" | "usize?" | "uintptr?" -> true
        "bool?" | "f32?" | "f64?" | "sview?" -> true
        _ -> false




def pymodule_optional_payload_name(type_name: sview) -> sview can[Abort.Panic]:
    return when type_name:
        "i8?" -> "i8"
        "i16?" -> "i16"
        "i32?" -> "i32"
        "i64?" | "char?" -> "i64"
        "int?" | "isize?" -> "int"
        "u8?" -> "u8"
        "u16?" -> "u16"
        "u32?" -> "u32"
        "u64?" -> "u64"
        "usize?" | "uintptr?" -> "usize"
        "bool?" -> "bool"
        "f32?" -> "f32"
        "f64?" -> "f64"
        "sview?" -> "sview"
        _ -> ""




# Keep Python defaults intentionally literal. This covers useful scalar/text cases
# (`limit: i64 = 10`, `enabled: bool = false`, `ratio: f64 = 0.5`, `name: cstr = "guest"`)
# plus empty native containers, whose zero-length representation is unambiguous and does not
# require evaluating arbitrary Elisa code in the CPython shim.
def pymodule_default_literal_supported(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.IntLit(default_int_value, _):
        return true
    if expression is Expr.FloatLit(default_float_text, _):
        return true
    if expression is Expr.BoolLit(default_bool_value, _):
        return true
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return pymodule_default_literal_supported(default_operand) if default_operator == Lexer::TokenKind.Minus
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_literal_supported(default_inner)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        return false if default_arguments.count != 0
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            supported_constructor: bool = when default_field:
                "i8" | "i16" | "i32" | "i64" | "s8" | "s16" | "s32" | "s64" | "int" | "isize" | "char" -> true
                "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" -> true
                "f32" | "f64" -> true
                _ -> false
            return false if not supported_constructor
            return pymodule_default_literal_supported(default_base)
    return false




# String defaults are emitted as the original quoted literal in the generated C shim. Keep the
# accepted escape vocabulary identical to the backend's decoder so a default cannot silently
# acquire different bytes at the Python/C boundary.
def pymodule_default_string_literal_supported(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.StringLit(default_string_text, _):
        string_length: usize = default_string_text.len
        scan: mutable usize = 0
        while scan < string_length |scan, default_string_text|:
            if default_string_text[scan] == 92:
                return false if scan + 1 >= string_length
                escaped: u8 = default_string_text[scan + 1]
                return false if escaped != 110 and escaped != 116 and escaped != 114 and escaped != 48 and escaped != 92 and escaped != 34 and escaped != 39
                scan <- scan + 1
            scan <- scan + 1
        return true
    return false




# Locate the parser's lexical module owner for a literal default. The parser canonicalizes
# both `module Outer::Inner:` and a nested `module Outer:` / `module Inner:` to `Outer::Inner`.
def pymodule_default_expression_contains_offset(expression: Ast::Expr, wanted_offset: u32) -> bool can[Abort.Panic, Memory.Allocate]:
    return true if Ast::expr_pos(expression).offset == wanted_offset
    if expression is Expr.Paren(inner, _):
        return pymodule_default_expression_contains_offset(inner, wanted_offset)
    if expression is Expr.Unary(operator, operand, _):
        return pymodule_default_expression_contains_offset(operand, wanted_offset)
    if expression is Expr.Move(operand, _) or expression is Expr.RegionNew(operand, _, _):
        return pymodule_default_expression_contains_offset(operand, wanted_offset)
    if expression is Expr.Binary(left, operator, right, _):
        return true if pymodule_default_expression_contains_offset(left, wanted_offset)
        return pymodule_default_expression_contains_offset(right, wanted_offset)
    if expression is Expr.Field(base, field, _):
        return pymodule_default_expression_contains_offset(base, wanted_offset)
    if expression is Expr.Scope(base, name, _):
        return pymodule_default_expression_contains_offset(base, wanted_offset)
    if expression is Expr.Index(object, index, _):
        return true if pymodule_default_expression_contains_offset(object, wanted_offset)
        return pymodule_default_expression_contains_offset(index, wanted_offset)
    if expression is Expr.Slice(object, low, high, _):
        return true if pymodule_default_expression_contains_offset(object, wanted_offset)
        return true if pymodule_default_expression_contains_offset(low, wanted_offset)
        return pymodule_default_expression_contains_offset(high, wanted_offset)
    if expression is Expr.IndexN(object, arguments, _):
        return true if pymodule_default_expression_contains_offset(object, wanted_offset)
        for argument in arguments:
            return true if pymodule_default_expression_contains_offset(argument, wanted_offset)
    if expression is Expr.Call(callee, arguments, argument_names, _):
        return true if pymodule_default_expression_contains_offset(callee, wanted_offset)
        for argument in arguments:
            return true if pymodule_default_expression_contains_offset(argument, wanted_offset)
    if expression is Expr.Array(elements, _) or expression is Expr.Tuple(elements, _) or expression is Expr.SetLit(elements, _):
        for element in elements:
            return true if pymodule_default_expression_contains_offset(element, wanted_offset)
    if expression is Expr.DictLit(entries, _):
        for entry in entries:
            return true if pymodule_default_expression_contains_offset(entry.key, wanted_offset)
            return true if pymodule_default_expression_contains_offset(entry.value, wanted_offset)
    if expression is Expr.Construct(type_expression, fields, _):
        return true if pymodule_default_expression_contains_offset(type_expression, wanted_offset)
        for field in fields:
            return true if pymodule_default_expression_contains_offset(field.value, wanted_offset)
    if expression is Expr.RecordUpdate(base, fields, _):
        return true if pymodule_default_expression_contains_offset(base, wanted_offset)
        for field in fields:
            return true if pymodule_default_expression_contains_offset(field.value, wanted_offset)
    if expression is Expr.If(condition, then_expression, else_expression, _):
        return true if pymodule_default_expression_contains_offset(condition, wanted_offset)
        return true if pymodule_default_expression_contains_offset(then_expression, wanted_offset)
        return pymodule_default_expression_contains_offset(else_expression, wanted_offset)
    if expression is Expr.Refinement(base, predicate, _):
        return true if pymodule_default_expression_contains_offset(base, wanted_offset)
        return pymodule_default_expression_contains_offset(predicate, wanted_offset)
    return false




def pymodule_default_find_expression_owner(declarations: darray[Ast::Decl]&, current_owner: sview, wanted_offset: u32, found_owner: mutable sview&, found: mutable bool&) -> void can[Abort.Panic, Memory.Allocate]:
    return if found == true
    for declaration in declarations |current_owner, wanted_offset, found_owner, found|:
        if declaration is Decl.Func(name, parameters, return_type, body, effects, decorators, pos):
            for parameter in parameters |current_owner, wanted_offset, found_owner, found|:
                if parameter.has_default and pymodule_default_expression_contains_offset(parameter.default_value, wanted_offset):
                    found_owner <- current_owner
                    found <- true
                    return
        elif declaration is Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, pos):
            for member in members |current_owner, wanted_offset, found_owner, found|:
                if member.has_default and pymodule_default_expression_contains_offset(member.default_value, wanted_offset):
                    found_owner <- current_owner
                    found <- true
                    return
        elif declaration is Decl.Module(module_name, module_body, pos):
            pymodule_default_find_expression_owner(module_body, module_name, wanted_offset, found_owner, found)
            return if found == true
        elif declaration is Decl.Scoped(scoped_body, pos):
            pymodule_default_find_expression_owner(scoped_body, current_owner, wanted_offset, found_owner, found)
            return if found == true




def pymodule_default_expression_owner(file: Ast::File&, expression: Ast::Expr) -> sview can[Abort.Panic, Memory.Allocate]:
    expression_offset: u32 = Ast::expr_pos(expression).offset
    found_owner: mutable sview = ""
    found: mutable bool = false
    pymodule_default_find_expression_owner(file.top_decls, "", expression_offset, found_owner, found)
    return found_owner




def emit_pymodule_manifest_default_literal(buffer: mutable darray[u8]&, file: Ast::File&, expression: Ast::Expr, type_name: sview = "") -> void can[Abort.Panic, Memory.Allocate]:
    if pymodule_default_is_null(expression) and pymodule_parameter_is_implicit_optional(type_name):
        emit_tokens_push_sview(buffer, "None")
        return
    enum_value: (found: bool, value: i64) = pymodule_default_enum_value(file, expression)
    if enum_value.found:
        append_decimal_i64(buffer, enum_value.value)
        return
    if expression is Expr.StringLit(default_string_text, _):
        buffer.push(92)
        buffer.push(34)
        emit_tokens_push_json_string(buffer, default_string_text)
        buffer.push(92)
        buffer.push(34)
        return
    if expression is Expr.Array(default_array_elements, default_array_pos):
        element_type_name: sview = pymodule_darray_element_name(type_name) if pymodule_is_darray_type(type_name) else pymodule_view_element_name(type_name) if pymodule_is_view_type(type_name) else ""
        if type_name == "darray[u8]":
            all_bytes: mutable bool = true
            for default_byte_element in default_array_elements:
                byte_value: (found: bool, is_negative: bool, magnitude: u64) = pymodule_default_signed_literal_value(file, default_byte_element)
                all_bytes <- false if not byte_value.found or byte_value.is_negative or byte_value.magnitude > 255u64
            if all_bytes:
                buffer.push(98)
                buffer.push(92)
                buffer.push(34)
                for default_byte_index in 0..<default_array_elements.count |buffer, default_array_elements, default_byte_index|:
                    byte_value: (found: bool, is_negative: bool, magnitude: u64) = pymodule_default_signed_literal_value(file, default_array_elements[default_byte_index])
                    buffer.push(92)
                    buffer.push(92)
                    buffer.push(120)
                    emit_pymodule_signature_hex(buffer, byte_value.magnitude.u32(), 2)
                buffer.push(92)
                buffer.push(34)
                return
        emit_tokens_push_sview(buffer, "[")
        for default_element_index in 0..<default_array_elements.count |buffer, default_array_elements, default_element_index, element_type_name|:
            emit_tokens_push_sview(buffer, ", ") if default_element_index > 0
            emit_pymodule_manifest_default_literal(buffer, file, default_array_elements[default_element_index], element_type_name)
        emit_tokens_push_sview(buffer, "]")
        return
    if expression is Expr.DictLit(default_dict_entries, default_dict_pos):
        key_type_name: sview = pymodule_dict_key_name(type_name) if pymodule_is_dict_type(type_name) else ""
        value_type_name: sview = pymodule_dict_value_name(type_name) if pymodule_is_dict_type(type_name) else ""
        emit_tokens_push_sview(buffer, "{")
        for default_entry_index in 0..<default_dict_entries.count |buffer, default_dict_entries, default_entry_index, key_type_name, value_type_name|:
            emit_tokens_push_sview(buffer, ", ") if default_entry_index > 0
            emit_pymodule_manifest_default_literal(buffer, file, default_dict_entries[default_entry_index].key, key_type_name)
            emit_tokens_push_sview(buffer, ": ")
            emit_pymodule_manifest_default_literal(buffer, file, default_dict_entries[default_entry_index].value, value_type_name)
        emit_tokens_push_sview(buffer, "}")
        return
    if expression is Expr.SetLit(default_set_elements, default_set_pos):
        if default_set_elements.count == 0:
            emit_tokens_push_sview(buffer, "set()")
            return
        emit_tokens_push_sview(buffer, "{")
        set_element_type_name: sview = pymodule_set_element_name(type_name) if pymodule_is_set_type(type_name) else ""
        for default_set_element_index in 0..<default_set_elements.count |buffer, default_set_elements, default_set_element_index, set_element_type_name|:
            emit_tokens_push_sview(buffer, ", ") if default_set_element_index > 0
            emit_pymodule_manifest_default_literal(buffer, file, default_set_elements[default_set_element_index], set_element_type_name)
        emit_tokens_push_sview(buffer, "}")
        return
    if expression is Expr.Construct(default_construct_type, default_construct_fields, default_construct_pos):
        emit_tokens_push_sview(buffer, "{")
        for default_construct_field_index in 0..<default_construct_fields.count |buffer, file, type_name, default_construct_fields, default_construct_field_index|:
            default_construct_field: Ast::FieldInit = default_construct_fields[default_construct_field_index]
            emit_tokens_push_sview(buffer, ", ") if default_construct_field_index > 0
            buffer.push(92)
            buffer.push(34)
            emit_tokens_push_json_string(buffer, default_construct_field.name)
            buffer.push(92)
            buffer.push(34)
            emit_tokens_push_sview(buffer, ": ")
            construct_field_type_name: sview = pymodule_struct_member_type_name(file, type_name, default_construct_field.name)
            emit_pymodule_manifest_default_literal(buffer, file, default_construct_field.value, construct_field_type_name)
        emit_tokens_push_sview(buffer, "}")
        return
    emit_pymodule_default_signature_literal(buffer, file, expression, type_name)




def pymodule_default_integer_literal_supported(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.IntLit(default_int_value, _):
        return true
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return pymodule_default_integer_literal_supported(default_operand) if default_operator == Lexer::TokenKind.Minus
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_integer_literal_supported(default_inner)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        return false if default_arguments.count != 0
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            return false if default_field != "i8" and default_field != "i16" and default_field != "i32" and default_field != "i64" and default_field != "s8" and default_field != "s16" and default_field != "s32" and default_field != "s64" and default_field != "int" and default_field != "isize" and default_field != "char" and default_field != "u8" and default_field != "u16" and default_field != "u32" and default_field != "u64" and default_field != "usize" and default_field != "uintptr"
            return pymodule_default_integer_literal_supported(default_base)
    return false




# Resolve a const/plain enum member to the value recorded by the parser.  Enum types erase to
# their scalar backing type at the Python boundary, so a default such as `Mode.Ready` should be
# treated exactly like the integer it compiles to.  The parser metadata is authoritative here:
# it preserves explicit gaps and implicit continuation values, including enums nested in modules.
def pymodule_default_alias_scope_matches(alias_scope: sview, lexical_owner: sview) -> bool can[Abort.Panic]:
    return true if alias_scope == "" or alias_scope == lexical_owner
    return false if alias_scope.len >= lexical_owner.len or lexical_owner[alias_scope.len] != 58
    return false if alias_scope.len + 1.usize() >= lexical_owner.len or lexical_owner[alias_scope.len + 1.usize()] != 58
    for index in 0..<alias_scope.len |alias_scope, lexical_owner|:
        return false if alias_scope[index] != lexical_owner[index]
    return true




def pymodule_default_module_path_parts(path: sview, parts: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    start: mutable usize = 0
    offset: mutable usize = 0
    while offset < path.len |start, offset, path, parts|:
        if offset + 1.usize() < path.len and path[offset] == 58 and path[offset + 1.usize()] == 58:
            parts.push(string_view_slice(path, start.i64(), offset.i64()))
            offset <- offset + 2.usize()
            start <- offset
        else:
            offset <- offset + 1.usize()
    return if start == path.len and path.len == 0
    parts.push(string_view_slice(path, start.i64(), path.len.i64()))




def pymodule_default_visible_module_alias(file: Ast::File&, name: sview, lexical_owner: sview, depth: u32 = 0) -> (index: usize, ambiguous: bool) can[Abort.Panic, Memory.Allocate]:
    return (file.enum_annotations.count, false) if depth > PYMODULE_DEFAULT_ENUM_EXPR_DEPTH_LIMIT
    for index in 0..<file.enum_annotations.count |file, name, depth|:
        annotation: Ast::EnumAnnotation = file.enum_annotations[index]
        continue if annotation.name != "__using_alias" or annotation.owner != name
        # Core stores module aliases program-wide. Conflicting later declarations are
        # diagnosed and leave the first map entry in place, so lookup keeps that first row.
        return (index, false)
    return (file.enum_annotations.count, false)




def pymodule_default_module_identifier_path_rank(module_path: sview, name: sview, lexical_owner: sview) -> (found: bool, rank: usize) can[Abort.Panic]:
    return (true, 0) if module_path == name
    return (false, 0) if module_path.len <= name.len + 2.usize()
    suffix_start: usize = module_path.len - name.len
    return (false, 0) if module_path[suffix_start - 2.usize()] != 58 or module_path[suffix_start - 1.usize()] != 58
    for index in 0..<name.len |module_path, name, suffix_start|:
        return (false, 0) if module_path[suffix_start + index] != name[index]
    prefix_length: usize = suffix_start - 2.usize()
    return (false, 0) if prefix_length == 0
    prefix: sview = string_view_slice(module_path, 0, prefix_length.i64())
    return (pymodule_default_alias_scope_matches(prefix, lexical_owner), prefix_length + 1.usize())




def pymodule_default_find_visible_module_identifier(declarations: darray[Ast::Decl]&, name: sview, lexical_owner: sview, best_rank: mutable usize&, best_owner: mutable sview&, ambiguous: mutable bool&) -> void can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |name, lexical_owner, best_rank, best_owner, ambiguous|:
        if declaration is Decl.Module(module_name, module_body, _):
            candidate: (found: bool, rank: usize) = pymodule_default_module_identifier_path_rank(module_name, name, lexical_owner)
            if candidate.found:
                if best_owner == "" or candidate.rank > best_rank:
                    best_rank <- candidate.rank
                    best_owner <- module_name
                    ambiguous <- false
                elif candidate.rank == best_rank and best_owner != module_name:
                    ambiguous <- true
            pymodule_default_find_visible_module_identifier(module_body, name, lexical_owner, best_rank, best_owner, ambiguous)
        elif declaration is Decl.Scoped(scoped_body, _):
            pymodule_default_find_visible_module_identifier(scoped_body, name, lexical_owner, best_rank, best_owner, ambiguous)




def pymodule_default_visible_module_identifier(file: Ast::File&, name: sview, lexical_owner: sview) -> (found: bool, ambiguous: bool, owner: sview) can[Abort.Panic, Memory.Allocate]:
    best_rank: mutable usize = 0
    best_owner: mutable sview = ""
    ambiguous: mutable bool = false
    pymodule_default_find_visible_module_identifier(file.top_decls, name, lexical_owner, best_rank, best_owner, ambiguous)
    return (best_owner != "", ambiguous, best_owner)




const PYMODULE_DEFAULT_ENUM_EXPR_DEPTH_LIMIT: u32 = 2000



def pymodule_default_append_text_bytes(bytes: mutable darray[u8]&, text: sview) -> void can[Abort.Panic, Memory.Allocate]:
    for index in 0..<text.len |bytes, text|:
        bytes.push(text[index])




def pymodule_default_visible_prior_module_alias(file: Ast::File&, name: sview, lexical_owner: sview, before_offset: u32, depth: u32 = 0) -> (index: usize, ambiguous: bool) can[Abort.Panic, Memory.Allocate]:
    return (file.enum_annotations.count, false) if depth > PYMODULE_DEFAULT_ENUM_EXPR_DEPTH_LIMIT
    for index in 0..<file.enum_annotations.count |file, name, before_offset, depth|:
        annotation: Ast::EnumAnnotation = file.enum_annotations[index]
        continue if annotation.name != "__using_alias" or annotation.owner != name
        continue if annotation.offset >= before_offset
        # Alias targets are canonicalized at registration time from earlier global aliases.
        return (index, false)
    return (file.enum_annotations.count, false)




def pymodule_default_module_path_matches_bytes(module_path: sview, path_bytes: darray[u8]&) -> bool can[Abort.Panic]:
    return false if module_path.len != path_bytes.count
    for index in 0..<module_path.len |module_path, path_bytes|:
        return false if module_path[index] != path_bytes[index]
    return true




def pymodule_default_module_path_bytes_equal(left: darray[u8]&, right: darray[u8]&) -> bool can[Abort.Panic]:
    return false if left.count != right.count
    for index in 0..<left.count |left, right|:
        return false if left[index] != right[index]
    return true




def pymodule_default_module_path_exists(declarations: darray[Ast::Decl]&, path_bytes: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations:
        if declaration is Decl.Module(module_name, module_body, _):
            return true if pymodule_default_module_path_matches_bytes(module_name, path_bytes)
            return true if pymodule_default_module_path_exists(module_body, path_bytes)
        elif declaration is Decl.Scoped(scoped_body, _):
            return true if pymodule_default_module_path_exists(scoped_body, path_bytes)
    return false




def pymodule_default_module_path_declares_enum(file: Ast::File&, enum_name: sview, path_bytes: darray[u8]&) -> bool can[Abort.Panic]:
    for enum_index in 0..<file.enum_decl_names.count |file, enum_name, path_bytes|:
        continue if file.enum_decl_names[enum_index] != enum_name
        continue if enum_index >= file.enum_decl_owners.count
        return true if pymodule_default_module_path_matches_bytes(file.enum_decl_owners[enum_index], path_bytes)
    return false




def pymodule_default_module_owner_suffix_bytes(prefix: sview, owner: sview, suffix_bytes: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if owner.len < prefix.len
    for index in 0..<prefix.len |prefix, owner|:
        return false if prefix[index] != owner[index]
    return true if owner.len == prefix.len
    return false if owner.len < prefix.len + 2.usize()
    return false if owner[prefix.len] != 58 or owner[prefix.len + 1.usize()] != 58
    for index in (prefix.len + 2.usize())..<owner.len |owner, suffix_bytes|:
        suffix_bytes.push(owner[index])
    return true

include "./defaults/alias_targets.elisa"
include "./defaults/integer_ranges.elisa"
