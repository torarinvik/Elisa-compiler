# Type spellings that the generated Python module can safely use as dict keys or set members.
module PymoduleDefaultHashablePolicy:
    public:
        def is_python_hashable_type(type_name: sview) -> bool can[Abort.Panic]:
            ensure when type_name:
                "cstr" | "sview" | "bool" | "f32" | "f64" | "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "char" | "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" -> result == true
                _ -> result == false
            return match type_name:
                "cstr" | "sview" | "bool" | "f32" | "f64" | "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "char" | "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr": true
                _: false
