        emit_tokens_push_sview(buffer, "_arena); Py_XDECREF(elisa_cleanup_owned_arg")
        append_decimal(buffer, cleanup_index.i64())
        emit_tokens_push_sview(buffer, "); }\n")
    emit_pymodule_parameter_default_cleanup(buffer, target_params, indent, cleanup_file)




def emit_pymodule_dict_cleanup_one(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, parameter_index: usize, indent: sview, annotate: bool = true, cleanup_file: Ast::File&? = null) -> void can[Abort.Panic, Memory.Allocate]:
    # Struct dictionary fields reuse the parameter-oriented materializer with
    # no function parameter table.  In that case there is nothing to clean up
    # here; avoid indexing past the empty table while still preserving the
    # existing behavior for real parameters.
    return if parameter_index >= target_params.count
    if annotate:
        emit_tokens_push_sview(buffer, indent)
        emit_tokens_push_sview(buffer, "elisa_pymodule_annotate_argument_error(elisa_pymodule_current_function, elisa_pymodule_current_parameter);\n")
    for cleanup_index in 0..<(parameter_index + 1) |buffer, parameter_index, indent|:
        cleanup_type_name: mutable sview = pymodule_bare_type_name(target_params[cleanup_index].type_expression)
        if cleanup_file is active_file:
            cleanup_type_name <- pymodule_alias_type_name(active_file, target_params[cleanup_index].type_expression)
        is_dict_param: bool = pymodule_expression_is_dict(target_params[cleanup_index].type_expression) or pymodule_is_dict_type(cleanup_type_name)
        continue if not is_dict_param and not pymodule_is_dict_type(cleanup_type_name) and not pymodule_is_set_type(cleanup_type_name)
        emit_tokens_push_sview(buffer, indent)
        emit_tokens_push_sview(buffer, "if (arg")
        append_decimal(buffer, cleanup_index.i64())
        emit_tokens_push_sview(buffer, "_materialized) { arg")
        append_decimal(buffer, cleanup_index.i64())
        emit_tokens_push_sview(buffer, "_materialized = 0; PyObject *elisa_cleanup_owned_arg")
        append_decimal(buffer, cleanup_index.i64())
        emit_tokens_push_sview(buffer, " = arg")
        append_decimal(buffer, cleanup_index.i64())
        emit_tokens_push_sview(buffer, "; arg")
        append_decimal(buffer, cleanup_index.i64())
        emit_tokens_push_sview(buffer, " = NULL; ")
        if is_dict_param:
            emit_tokens_push_sview(buffer, "elisa_pymodule_struct_refs_free(&arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_struct_refs); ")
        emit_tokens_push_sview(buffer, "arena_free(&arg")
        append_decimal(buffer, cleanup_index.i64())
        emit_tokens_push_sview(buffer, "_arena); Py_XDECREF(elisa_cleanup_owned_arg")
        append_decimal(buffer, cleanup_index.i64())
        emit_tokens_push_sview(buffer, "); }\n")
    emit_pymodule_parameter_default_cleanup(buffer, target_params, indent, cleanup_file)




def emit_pymodule_dict_value_range_check(buffer: mutable darray[u8]&, file: Ast::File&, target_params: darray[Ast::ParamDecl]&, value_name: sview, parameter_index: usize) -> void can[Abort.Panic, Memory.Allocate]:
    lower: mutable sview = ""
    upper: mutable sview = ""
    if value_name == "i8":
        lower <- "INT8_MIN"
        upper <- "INT8_MAX"
    elif value_name == "i16":
        lower <- "INT16_MIN"
        upper <- "INT16_MAX"
    elif value_name == "i32":
        lower <- "INT32_MIN"
        upper <- "INT32_MAX"
    elif value_name == "u8":
        upper <- "UINT8_MAX"
    elif value_name == "u16":
        upper <- "UINT16_MAX"
    elif value_name == "u32":
        upper <- "UINT32_MAX"
    elif value_name == "u64":
        upper <- "UINT64_MAX"
    elif value_name == "int" or value_name == "isize":
        lower <- "INTPTR_MIN"
        upper <- "INTPTR_MAX"
    elif value_name == "usize" or value_name == "uintptr":
        upper <- "UINTPTR_MAX"
    return if lower == "" and upper == ""
    emit_tokens_push_sview(buffer, "        if (")
    if value_name == "u64":
        emit_tokens_push_sview(buffer, "!elisa_pymodule_ull_fits_u64(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_value_scalar")
    else:
        if lower != "":
            emit_tokens_push_sview(buffer, "arg")
            append_decimal(buffer, parameter_index.i64())
            emit_tokens_push_sview(buffer, "_value_scalar < ")
            emit_tokens_push_sview(buffer, lower)
            emit_tokens_push_sview(buffer, " || ")
        emit_tokens_push_sview(buffer, "arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_value_scalar > ")
        emit_tokens_push_sview(buffer, upper)
    emit_tokens_push_sview(buffer, ") {\n")
    emit_pymodule_dict_cleanup(buffer, target_params, "            ", true, file)
    emit_tokens_push_sview(buffer, "            PyErr_SetString(PyExc_OverflowError, \"dictionary value out of range\"); return NULL;\n        }\n")




def emit_pymodule_dict_key_range_check(buffer: mutable darray[u8]&, file: Ast::File&, target_params: darray[Ast::ParamDecl]&, key_name: sview, parameter_index: usize) -> void can[Abort.Panic, Memory.Allocate]:
    lower: mutable sview = ""
    upper: mutable sview = ""
    if key_name == "i8":
        lower <- "INT8_MIN"
        upper <- "INT8_MAX"
    elif key_name == "i16":
        lower <- "INT16_MIN"
        upper <- "INT16_MAX"
    elif key_name == "i32":
        lower <- "INT32_MIN"
        upper <- "INT32_MAX"
    elif key_name == "u8":
        upper <- "UINT8_MAX"
    elif key_name == "u16":
        upper <- "UINT16_MAX"
    elif key_name == "u32":
        upper <- "UINT32_MAX"
    elif key_name == "u64":
        upper <- "UINT64_MAX"
    elif key_name == "int" or key_name == "isize":
        lower <- "INTPTR_MIN"
        upper <- "INTPTR_MAX"
    elif key_name == "usize" or key_name == "uintptr":
        upper <- "UINTPTR_MAX"
    return if lower == "" and upper == ""
    emit_tokens_push_sview(buffer, "        if (")
    if key_name == "u64":
        emit_tokens_push_sview(buffer, "!elisa_pymodule_ull_fits_u64(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_key_number")
    else:
        if lower != "":
            emit_tokens_push_sview(buffer, "arg")
            append_decimal(buffer, parameter_index.i64())
            emit_tokens_push_sview(buffer, "_key_number < ")
            emit_tokens_push_sview(buffer, lower)
            emit_tokens_push_sview(buffer, " || ")
        emit_tokens_push_sview(buffer, "arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_key_number > ")
        emit_tokens_push_sview(buffer, upper)
    emit_tokens_push_sview(buffer, ") {\n")
    emit_pymodule_dict_cleanup_one(buffer, target_params, parameter_index, "            ", true, file)
    emit_tokens_push_sview(buffer, "            PyErr_SetString(PyExc_OverflowError, \"dictionary key out of range\"); return NULL;\n        }\n")
