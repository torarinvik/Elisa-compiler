# Closed scalar type-name groups used by PyModule default validation and emission.
module PymoduleDefaultScalarTypePolicy:
    public:
        def is_text_type_name(type_name: sview) -> bool:
            ensure when type_name:
                "cstr" | "sview" -> result == true
                _ -> result == false
            return match type_name:
                "cstr" | "sview": true
                _: false

        def is_float_type_name(type_name: sview) -> bool:
            ensure when type_name:
                "f32" | "f64" -> result == true
                _ -> result == false
            return match type_name:
                "f32" | "f64": true
                _: false

        def is_signed_integer_type_name(type_name: sview) -> bool:
            ensure when type_name:
                "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "char" -> result == true
                _ -> result == false
            return match type_name:
                "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "char": true
                _: false

        def is_unsigned_integer_type_name(type_name: sview) -> bool:
            ensure when type_name:
                "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" -> result == true
                _ -> result == false
            return match type_name:
                "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr": true
                _: false
