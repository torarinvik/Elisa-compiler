# `-emit wasm` — the HOST-SIDE steps: locating wasm-ld and the repository root, running a
# subprocess and reporting its failure, and the content-addressed cache for the portable runtime
# object (keyed by target triple and runtime source, so a rebuild reuses it).
# Continues emit_wasm.elisa.



# --- host-side steps -------------------------------------------------------------------

def wasm_flag_enabled(name: sview) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    storage: mutable darray[u8] = []
    false return if not env_value(name, &storage)
    return storage.count > 0 and not (storage.count == 1.usize() and storage[0] == 48)




# A memory32 PAGE count pinned by the caller (`ELISA_WASM_INITIAL_PAGES` /
# `ELISA_WASM_MAX_PAGES`, both decimal pages). The SDK exports these per UI profile --
# elisa-ui's retained scene needs 34 pages -- and the emitter ignored them, so every
# component was linked and described at the 16-page default. A malformed or zero value
# falls back rather than linking at a nonsense size.
def wasm_env_pages(name: sview, fallback: i64) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    storage: mutable darray[u8] = []
    fallback return if not env_value(name, &storage) or storage.count == 0
    value: mutable i64 = 0
    for index in 0..<storage.count |value, storage, fallback|:
        digit: u8 = storage[index]
        fallback return if digit < 48 or digit > 57
        value <- value * 10 + (digit - 48).i64()
        fallback return if value > 65536
    return value if value > 0 else fallback


def wasm_push_env_or(buffer: mutable darray[u8]&, name: sview, fallback: sview) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    storage: mutable darray[u8] = []
    if env_value(name, &storage) and storage.count > 0:
        for index in 0..<storage.count |buffer, storage|:
            buffer.push(storage[index])
        return
    emit_tokens_push_sview(buffer, fallback)




def wasm_executable(path: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    false return if path.count == 0
    probe: mutable darray[u8] = [entry for entry in path]
    probe.push(0)
    probe_cstr: cstr = (&probe[0]).cast[cstr] can Unsafe.PointerCast
    return access(probe_cstr, 1) == 0




# find_wasm_ld: WASM_LD, then the LLVM bin directory the gate already selects
# (ELISA_LLVM_BIN_DIR), then Homebrew's LLVM, then whatever `wasm-ld` is on PATH.
def wasm_take_candidate(linker: mutable darray[u8]&, candidate: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    false return if not wasm_executable(candidate)
    for index in 0..<candidate.count |linker, candidate|:
        linker.push(candidate[index])
    return true




def wasm_find_linker(component: bool, linker: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    explicit: mutable darray[u8] = []
    _ = env_value("ELISA_STAGE1_WASM_COMPONENT_LD" if component else "ELISA_STAGE1_WASM_LD", &explicit)
    return if wasm_take_candidate(linker, explicit)
    from_env: mutable darray[u8] = []
    _ = env_value("WASM_COMPONENT_LD" if component else "WASM_LD", &from_env)
    return if wasm_take_candidate(linker, from_env)
    if component:
        # Rust's component linker is commonly installed in Cargo's bin
        # directory while rustc itself comes from Homebrew or another
        # distribution. Resolve that standard location directly so a clean
        # self-hosting compiler invocation does not depend on PATH ordering.
        cargo_home: mutable darray[u8] = []
        if env_value("CARGO_HOME", &cargo_home) and cargo_home.count > 0:
            emit_tokens_push_sview(&cargo_home, "/bin/wasm-component-ld")
            return if wasm_take_candidate(linker, cargo_home)
        home: mutable darray[u8] = []
        if env_value("HOME", &home) and home.count > 0:
            emit_tokens_push_sview(&home, "/.cargo/bin/wasm-component-ld")
            return if wasm_take_candidate(linker, home)
        emit_tokens_push_sview(linker, "wasm-component-ld")
        return
    llvm_bin: mutable darray[u8] = []
    if env_value("ELISA_LLVM_BIN_DIR", &llvm_bin) and llvm_bin.count > 0:
        emit_tokens_push_sview(&llvm_bin, "/wasm-ld")
        return if wasm_take_candidate(linker, llvm_bin)
    homebrew: mutable darray[u8] = []
    emit_tokens_push_sview(&homebrew, "/opt/homebrew/opt/llvm/bin/wasm-ld")
    return if wasm_take_candidate(linker, homebrew)
    emit_tokens_push_sview(linker, "wasm-ld")




# The repository root: the driver binary lives in ROOT/bin, so strip `/bin/<name>` from
# argv[0] (ELISA_STAGE1_SELF); a bare name means "invoked from the root" — use `.`.
def wasm_push_root(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    # The host tells us outright when it knows (the wrapper does); otherwise derive it the
    # way the Python did, from the driver's own path, and fall back to the working directory.
    explicit_root: mutable darray[u8] = []
    if env_value("ELISA_STAGE1_ROOT", &explicit_root) and explicit_root.count > 0:
        for index in 0..<explicit_root.count |buffer, explicit_root|:
            buffer.push(explicit_root[index])
        return
    self_path: mutable darray[u8] = []
    if env_value("ELISA_STAGE1_SELF", &self_path):
        cut: mutable usize = 0.usize()
        for index in 0..<self_path.count |cut, self_path|:
            if index + 4.usize() < self_path.count and self_path[index] == 47 and self_path[index + 1] == 98 and self_path[index + 2] == 105 and self_path[index + 3] == 110 and self_path[index + 4] == 47:
                cut <- index
        if cut > 0:
            for index in 0..<cut |buffer, self_path|:
                buffer.push(self_path[index])
            return
    buffer.push(46)




def wasm_run(command: darray[u8]&, label: sview) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    line: mutable darray[u8] = [entry for entry in command]
    line.push(0)
    status: i64 = system((&line[0]).cast[cstr] can Unsafe.PointerCast) / 256
    true return if status == 0
    message: mutable darray[u8] = []
    emit_tokens_push_sview(&message, "error: ")
    emit_tokens_push_sview(&message, label)
    emit_tokens_push_sview(&message, " failed with exit status ")
    append_decimal(&message, status.u32())
    emit_tokens_push_sview(&message, ": ")
    for index in 0..<command.count |message, command|:
        message.push(command[index])
    emit_tokens_push_sview(&message, "\n")
    write_stderr(message)
    return false




def wasm_report_error(message: darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    line: mutable darray[u8] = []
    emit_tokens_push_sview(&line, "error: -emit wasm: ")
    for index in 0..<message.count |line, message|:
        line.push(message[index])
    emit_tokens_push_sview(&line, "\n")
    write_stderr(line)
    return 1




# Runs after the wasm32 object is written beside the output. `out_path` is the `.wasm`
# destination (NUL-free); `object_path` the object just emitted.
# The Python's `^\s*def\s+arena_alloc\s*\(` probe over the FLAT source: a unit that brings
# its own allocator (directly, or by including elisacore_std/arena.elisa) links no runtime
# object at all, and the manifest records the allocator as inline.
def wasm_source_defines_arena_alloc(file: Ast::File&) -> bool can[Abort.Panic, Memory.Allocate]:
    for declaration in file.top_decls:
        if declaration is Decl.Func(fn_name, fn_params, fn_return, fn_body, fn_effects, fn_decorators, fn_line):
            true return if fn_name == "arena_alloc"
    return false




# FNV-1a over the inputs the cached object depends on: the target triple, the runtime source
# it is compiled from, and the compiler binary that compiles it. The Python keyed on the
# compiler's size and mtime; hashing its BYTES is the same answer without a `stat` extern,
# and it cannot go stale on a reseed that lands within an mtime tick.
def wasm_hash_bytes(hash: u64, bytes: darray[u8]&) -> u64 can[Abort.Panic]:
    running: mutable u64 = hash
    for index in 0..<bytes.count |running, bytes|:
        running <- (running ^ bytes[index].u64()) * 1099511628211.u64()
    return running




def wasm_cache_path(root: darray[u8]&, triple: darray[u8]&, runtime_source: darray[u8]&, buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    hash: mutable u64 = 14695981039346656037.u64()
    hash <- wasm_hash_bytes(hash, triple)
    source_terminated: mutable darray[u8] = [entry for entry in runtime_source]
    source_terminated.push(0)
    source_bytes: darray[u8] = read_file((&source_terminated[0]).cast[cstr] can Unsafe.PointerCast)
    hash <- wasm_hash_bytes(hash, source_bytes)
    compiler: mutable darray[u8] = [entry for entry in root]
    emit_tokens_push_sview(&compiler, "/bin/elisac-stage1")
    compiler.push(0)
    compiler_bytes: darray[u8] = read_file((&compiler[0]).cast[cstr] can Unsafe.PointerCast)
    hash <- wasm_hash_bytes(hash, compiler_bytes)
    for index in 0..<root.count |buffer, root|:
        buffer.push(root[index])
    emit_tokens_push_sview(buffer, "/build/wasm-cache/runtime-")
    digits: sview = "0123456789abcdef"
    for nibble in 0..<16 |buffer, hash, digits|:
        shift: u64 = ((15 - nibble) * 4).u64()
        buffer.push(sview_at(digits, ((hash >> shift) & 15.u64()).i64()))
    emit_tokens_push_sview(buffer, ".o")




def wasm_file_present(path: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    probe: mutable darray[u8] = [entry for entry in path]
    probe.push(0)
    probe_cstr: cstr = (&probe[0]).cast[cstr] can Unsafe.PointerCast
    return access(probe_cstr, 0) == 0
