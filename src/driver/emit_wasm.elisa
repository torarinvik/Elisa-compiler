    emit_tokens_push_sview(buffer, "    memcpy(destination, source, size) { new Uint8Array(memory.buffer, destination >>> 0, Number(size)).set(new Uint8Array(memory.buffer, source >>> 0, Number(size))); return destination; },\n")
    emit_tokens_push_sview(buffer, "    memmove(destination, source, size) { const copy = new Uint8Array(memory.buffer, source >>> 0, Number(size)).slice(); new Uint8Array(memory.buffer, destination >>> 0, Number(size)).set(copy); return destination; },\n")
    emit_tokens_push_sview(buffer, "    memset(destination, value, size) { bytes().fill(Number(value) & 255, destination >>> 0, (destination >>> 0) + Number(size)); return destination; },\n")
    emit_tokens_push_sview(buffer, "    memcmp(left, right, size) { const data = bytes(); for (let i = 0; i < Number(size); i++) { const difference = data[(left >>> 0) + i] - data[(right >>> 0) + i]; if (difference) return difference; } return 0; },\n")
    emit_tokens_push_sview(buffer, "    strlen(pointer) { let length = 0; const data = bytes(); while (data[(pointer >>> 0) + length] !== 0) length++; return length; },\n")
    emit_tokens_push_sview(buffer, "    strcmp(left, right) { const a = readCString(left), b = readCString(right); return a < b ? -1 : (a > b ? 1 : 0); },\n")
    emit_tokens_push_sview(buffer, "    puts(pointer) { (options.onPrint ?? ((text) => console.log(text)))(readCString(pointer)); return 0; },\n")
    emit_tokens_push_sview(buffer, "    write(descriptor, pointer, size) { onWrite(UTF8_DECODER.decode(readBytes(pointer, size)), Number(descriptor)); return Number(size); },\n")
    emit_tokens_push_sview(buffer, "    read() { return -1; },\n")
    emit_tokens_push_sview(buffer, "    printf(format) { const text = readCString(format); (options.onPrint ?? ((line) => console.log(line)))(text); return UTF8_ENCODER.encode(text).byteLength; },\n")
    emit_tokens_push_sview(buffer, "    fprintf() { return 0; },\n")
    emit_tokens_push_sview(buffer, "    snprintf() { return -1; },\n")
    emit_tokens_push_sview(buffer, "    backtrace() { return 0; },\n")
    emit_tokens_push_sview(buffer, "    backtrace_symbols_fd() {},\n")
    emit_tokens_push_sview(buffer, "    wasm_memory_size() { return memory.buffer.byteLength / PAGE_SIZE; },\n")
    emit_tokens_push_sview(buffer, "    wasm_memory_grow(index, pages) { try { return memory.grow(Number(pages)); } catch { return -1; } },\n")
    emit_tokens_push_sview(buffer, "    abort() { throw new Error(\"Elisa WASM aborted\"); },\n")
    emit_tokens_push_sview(buffer, "    exit(code) { throw new Error(`Elisa WASM exited with code ${code}`); },\n")
    emit_tokens_push_sview(buffer, "  };\n")
    emit_tokens_push_sview(buffer, "  const imports = { ...customImports, memory, env: { ...env, ...customEnv, ...(options.env ?? {}), memory } };\n")
    emit_tokens_push_sview(buffer, "  Object.defineProperty(imports, RUNTIME_STATE, { value: { setHeapBase, malloc, free, writeBytes, readBytes, writeString, readString: readCString } });\n")
    emit_tokens_push_sview(buffer, "  return imports;\n")
    emit_tokens_push_sview(buffer, "}\n")
    emit_tokens_push_sview(buffer, "\n")
    emit_tokens_push_sview(buffer, "async function sourceBytes(source) {\n")
    emit_tokens_push_sview(buffer, "  if (typeof Response !== \"undefined\" && source instanceof Response) return new Uint8Array(await source.arrayBuffer());\n")
    emit_tokens_push_sview(buffer, "  if (source instanceof ArrayBuffer) return new Uint8Array(source);\n")
    emit_tokens_push_sview(buffer, "  if (ArrayBuffer.isView(source)) return new Uint8Array(source.buffer, source.byteOffset, source.byteLength);\n")
    emit_tokens_push_sview(buffer, "  const url = source instanceof URL ? source : (source ? String(source) : WASM_URL);\n")
    emit_tokens_push_sview(buffer, "  if (url instanceof URL && url.protocol === \"file:\") {\n")
    emit_tokens_push_sview(buffer, "    const { readFile } = await import(\"node:fs/promises\");\n")
    emit_tokens_push_sview(buffer, "    return new Uint8Array(await readFile(url));\n")
    emit_tokens_push_sview(buffer, "  }\n")
    emit_tokens_push_sview(buffer, "  if (typeof url === \"string\" && url.startsWith(\"file:\")) {\n")
    emit_tokens_push_sview(buffer, "    const { readFile } = await import(\"node:fs/promises\");\n")
    emit_tokens_push_sview(buffer, "    return new Uint8Array(await readFile(new URL(url)));\n")
    emit_tokens_push_sview(buffer, "  }\n")
    emit_tokens_push_sview(buffer, "  if (typeof url === \"string\" && !/^(?:https?:|file:)/.test(url)) {\n")
    emit_tokens_push_sview(buffer, "    try { const { readFile } = await import(\"node:fs/promises\"); return new Uint8Array(await readFile(url)); } catch { /* browser URL fallback */ }\n")
    emit_tokens_push_sview(buffer, "  }\n")
    emit_tokens_push_sview(buffer, "  const response = await fetch(url);\n")
    emit_tokens_push_sview(buffer, "  if (!response.ok) throw new Error(`Unable to load Elisa WASM (${response.status} ${response.statusText}): ${response.url || url}`);\n")
    emit_tokens_push_sview(buffer, "  return new Uint8Array(await response.arrayBuffer());\n")
    emit_tokens_push_sview(buffer, "}\n")
