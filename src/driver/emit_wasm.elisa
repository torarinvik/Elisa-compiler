    emit_tokens_push_sview(buffer, "export async function loadWasm(source, options = {}) {\n")
    emit_tokens_push_sview(buffer, "  const imports = createElisaImports(options);\n")
    emit_tokens_push_sview(buffer, "  const module = await WebAssembly.compile(await sourceBytes(source));\n")
    emit_tokens_push_sview(buffer, "  const missing = WebAssembly.Module.imports(module).filter((required) => !(required.name in (imports[required.module] ?? {})));\n")
    emit_tokens_push_sview(buffer, "  if (missing.length) {\n")
    emit_tokens_push_sview(buffer, "    const names = missing.map((required) => `${required.module}.${required.name} (${required.kind})`).join(\", \");\n")
    emit_tokens_push_sview(buffer, "    throw new Error(`Missing Elisa WASM imports: ${names}. Provide them through loadWasm(source, { imports: { module: { name: value } } }).`);\n")
    emit_tokens_push_sview(buffer, "  }\n")
    emit_tokens_push_sview(buffer, "  const instance = await WebAssembly.instantiate(module, imports);\n")
    emit_tokens_push_sview(buffer, "  const runtime = imports[RUNTIME_STATE];\n")
    emit_tokens_push_sview(buffer, "  const heapGlobal = instance.exports.__heap_base;\n")
    emit_tokens_push_sview(buffer, "  const heapBase = heapGlobal instanceof WebAssembly.Global ? heapGlobal.value : heapGlobal;\n")
    emit_tokens_push_sview(buffer, "  if (heapBase === undefined) throw new Error(\"Elisa WASM module does not export __heap_base\");\n")
    emit_tokens_push_sview(buffer, "  runtime.setHeapBase(heapBase);\n")
    emit_tokens_push_sview(buffer, "  const memoryTools = Object.freeze({\n")
    emit_tokens_push_sview(buffer, "    alloc: runtime.malloc,\n")
    emit_tokens_push_sview(buffer, "    free: runtime.free,\n")
    emit_tokens_push_sview(buffer, "    writeBytes: runtime.writeBytes,\n")
    emit_tokens_push_sview(buffer, "    readBytes: runtime.readBytes,\n")
    emit_tokens_push_sview(buffer, "    writeString: runtime.writeString,\n")
    emit_tokens_push_sview(buffer, "    readString: runtime.readString,\n")
    emit_tokens_push_sview(buffer, "  });\n")
    emit_tokens_push_sview(buffer, "  return Object.freeze({\n")


