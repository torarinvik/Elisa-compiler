# `-emit wasm` — the driver's port of scripts/wasm_build.py (§4.4). The Python did four
# things after the compiler produced a wasm32 object: build the portable runtime object,
# link with wasm-ld, write the `.json` manifest, and write the `.mjs` / `.d.ts` / `.d.mts`
# facade from the export table. Everything here is a projection of that same table, so
# the sidecars are byte-identical to the Python's (the oracle in wasm_smoke.sh); the
# manifest's `line` is the export's source line (source_original_line), which is what
# the Python's flat-source scan printed for a single-file unit.
#
# An export row is never STORED: a darray of rows with darray fields needs region plumbing
# the driver avoids everywhere else, so the token scan is re-run per consumer (manifest,
# bindings, declarations, link flags) through wasm_scan_exports with a mode.

@link_name(access)
extern access(path: cstr, mode: i64) -> i64


const WASM_SCAN_MANIFEST: i64 = 0
const WASM_SCAN_BINDINGS: i64 = 1
const WASM_SCAN_DECLARATIONS: i64 = 2
const WASM_SCAN_LINK_EXPORTS: i64 = 3
const WASM_SCAN_VALIDATE: i64 = 4


def wasm_storage_keyword(kind: Lexer::TokenKind) -> bool:
    return kind == Lexer::TokenKind.Mutable or kind == Lexer::TokenKind.Lmut or kind == Lexer::TokenKind.Heap or kind == Lexer::TokenKind.Stack or kind == Lexer::TokenKind.Static


# The Python's normalize_type: whitespace removed, one leading storage keyword dropped.
def wasm_push_type_text(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, start: usize, stop: usize) -> void can[Abort.Panic, Memory.Allocate]:
    first: mutable bool = true
    for index in start..<stop |buffer, first, tokens, source|:
        skip: bool = first and wasm_storage_keyword(tokens[index].kind)
        emit_tokens_push_sview(buffer, Lexer::text_or_empty(tokens[index], source)) if not skip
        first <- false


def wasm_scalar_wasm_type(type_text: sview) -> sview:
    return when type_text:
        "i8" | "u8" | "i16" | "u16" | "i32" | "u32" | "isize" | "usize" | "uintptr" | "bool" -> "i32"
        "i64" | "u64" | "int" | "char" -> "i64"
        "f32" -> "f32"
        "f64" -> "f64"
        "void" -> "void"
        _ -> ""


# abi_for_type: (binding, wasm type), or binding "" with the Python's message in `message`.
def wasm_abi_binding(type_text: sview, function: sview, position: sview, message: mutable darray[u8]&) -> (binding: sview, wasm_type: sview) can[Abort.Panic, Memory.Allocate]:
    length: usize = sview_len(type_text)
    if length > 0 and sview_at(type_text, length - 1) == 63:
        emit_tokens_push_sview(message, function)
        emit_tokens_push_sview(message, ": ")
        emit_tokens_push_sview(message, position)
        emit_tokens_push_sview(message, " type '")
        emit_tokens_push_sview(message, type_text)
        emit_tokens_push_sview(message, "' is nullable; use an explicit scalar/pointer adapter because nullable aggregates do not have a stable JS ABI")
        return ("", "")
    ("string", "i32") return if type_text == "cstr"
    ("pointer", "i32") return if length > 0 and sview_at(type_text, length - 1) == 38
    scalar: sview = wasm_scalar_wasm_type(type_text)
    ("scalar", scalar) return if scalar != ""
    emit_tokens_push_sview(message, function)
    emit_tokens_push_sview(message, ": ")
    emit_tokens_push_sview(message, position)
    emit_tokens_push_sview(message, " type '")
    emit_tokens_push_sview(message, type_text)
    emit_tokens_push_sview(message, "' is not directly representable in the generated WASM bindings; export a scalar or pointer adapter")
    return ("", "")


def wasm_ts_type(type_text: sview, parameter: bool) -> sview:
    ("string | number" if parameter else "string") return if type_text == "cstr"
    "bigint" return if type_text == "i64" or type_text == "u64" or type_text == "int" or type_text == "char"
    "boolean" return if type_text == "bool"
    "void" return if type_text == "void"
    return "number"


def wasm_push_js_input(buffer: mutable darray[u8]&, type_text: sview, name: sview) -> void can[Abort.Panic, Memory.Allocate]:
    if type_text == "i64" or type_text == "u64" or type_text == "int" or type_text == "char":
        emit_tokens_push_sview(buffer, "BigInt(")
        emit_tokens_push_sview(buffer, name)
        emit_tokens_push_sview(buffer, ")")
        return
    if type_text == "bool":
        emit_tokens_push_sview(buffer, name)
        emit_tokens_push_sview(buffer, " ? 1 : 0")
        return
    emit_tokens_push_sview(buffer, name)


# js_output wraps the call EXPRESSION (already in `call`).
def wasm_push_js_output(buffer: mutable darray[u8]&, type_text: sview, call: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
    prefix: mutable sview = ""
    suffix: mutable sview = ""
    if type_text == "cstr":
        prefix <- "memoryTools.readString("
        suffix <- ")"
    elif type_text == "bool":
        prefix <- "!!("
        suffix <- ")"
    elif type_text == "i8":
        prefix <- "(("
        suffix <- " << 24) >> 24)"
    elif type_text == "i16":
        prefix <- "(("
        suffix <- " << 16) >> 16)"
    elif type_text == "isize":
        prefix <- "(("
        suffix <- ") | 0)"
    elif type_text == "u8":
        prefix <- "(("
        suffix <- ") & 0xff)"
    elif type_text == "u16":
        prefix <- "(("
        suffix <- ") & 0xffff)"
    elif type_text == "u32" or type_text == "usize" or type_text == "uintptr":
        prefix <- "(("
        suffix <- ") >>> 0)"
    emit_tokens_push_sview(buffer, prefix)
    for index in 0..<call.count |buffer, call|:
        buffer.push(call[index])
    emit_tokens_push_sview(buffer, suffix)


def wasm_push_json_string(buffer: mutable darray[u8]&, text: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
    buffer.push(34)
    for index in 0..<text.count |buffer, text|:
        buffer.push(92) if text[index] == 34 or text[index] == 92
        buffer.push(text[index])
    buffer.push(34)


def wasm_push_json_sview(buffer: mutable darray[u8]&, text: sview) -> void can[Abort.Panic, Memory.Allocate]:
    bytes: mutable darray[u8] = []
    for index in 0..<sview_len(text) |bytes, text|:
        bytes.push(sview_at(text, index))
    wasm_push_json_string(buffer, bytes)


# The `@link_name("...")` decorator's text, or "" — rendered through the -emit ast helper
# (`("name")`) and unwrapped.
def wasm_link_name(decorators: darray[Ast::Annotation]&, tokens: darray[Lexer::Token]&, source: u8&, link_name: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
    for decorator in decorators |link_name, tokens, source|:
        if decorator.name == "link_name":
            rendered: mutable darray[u8] = []
            emit_ast_decorator_args(&rendered, tokens, source, decorator.line, 0)
            for index in 0..<rendered.count |link_name, rendered|:
                byte: u8 = rendered[index]
                link_name.push(byte) if byte != 40 and byte != 41 and byte != 34
            return true
    return false


# One `export fn NAME(PARAMS) [-> RET] = TARGET` (or the implicit `def main`) row, rendered
# for `mode`. `range_start..<range_stop` are the declaration's tokens; the scan takes the
# parameter list between the first `(` and its `)`, then `-> RET` up to `=`.
def wasm_render_export(mode: i64, buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, range_start: usize, range_stop: usize, name: sview, target: sview, line: u32, implicit: bool, link_name: darray[u8]&, has_link_name: bool, component: bool, first_row: bool, message: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
    # --- locate `(` ... `)` and the return segment
    open_index: mutable usize = range_stop
    for index in range_start..<range_stop |open_index, tokens|:
        open_index <- index if open_index == range_stop and tokens[index].kind == Lexer::TokenKind.LParen
    if open_index == range_stop:
        emit_tokens_push_sview(message, "exported function '")
        emit_tokens_push_sview(message, name)
        emit_tokens_push_sview(message, "' has no parameter list")
        return false
    depth: mutable i64 = 0
    close_index: mutable usize = range_stop
    for index in open_index..<range_stop |depth, close_index, tokens|:
        if close_index == range_stop:
            kind: Lexer::TokenKind = tokens[index].kind
            depth <- depth + 1 if kind == Lexer::TokenKind.LParen or kind == Lexer::TokenKind.LBracket
            depth <- depth - 1 if kind == Lexer::TokenKind.RParen or kind == Lexer::TokenKind.RBracket
            close_index <- index if depth == 0
    return_start: mutable usize = range_stop
    return_stop: mutable usize = range_stop
    for index in close_index..<range_stop |return_start, return_stop, tokens|:
        return_start <- index + 1 if return_start == range_stop and tokens[index].kind == Lexer::TokenKind.Arrow
        return_stop <- index if return_start != range_stop and index >= return_start and return_stop == range_stop and (tokens[index].kind == Lexer::TokenKind.Assign or tokens[index].kind == Lexer::TokenKind.Colon)
    return_text: mutable darray[u8] = []
    if return_start == range_stop:
        emit_tokens_push_sview(&return_text, "void")
    else:
        wasm_push_type_text(&return_text, tokens, source, return_start, return_stop)
    return_view: sview = sview_of_bytes(return_text)
    return_abi: (binding: sview, wasm_type: sview) = wasm_abi_binding(return_view, name, "return", message)
    false return if return_abi.binding == ""

    # --- row head
    if mode == WASM_SCAN_MANIFEST:
        emit_tokens_push_sview(buffer, ",") if not first_row
        emit_tokens_push_sview(buffer, "\n    {\n      \"name\": ")
        wasm_push_json_sview(buffer, name)
        emit_tokens_push_sview(buffer, ",\n      \"target\": ")
        wasm_push_json_sview(buffer, target)
        emit_tokens_push_sview(buffer, ",\n      \"parameters\": [")
    elif mode == WASM_SCAN_BINDINGS:
        emit_tokens_push_sview(buffer, ",\n") if not first_row
        emit_tokens_push_sview(buffer, "    ")
        emit_tokens_push_sview(buffer, name)
        emit_tokens_push_sview(buffer, "(")
    elif mode == WASM_SCAN_DECLARATIONS:
        emit_tokens_push_sview(buffer, "\n") if not first_row
        emit_tokens_push_sview(buffer, "  ")
        emit_tokens_push_sview(buffer, name)
        emit_tokens_push_sview(buffer, "(")
    elif mode == WASM_SCAN_LINK_EXPORTS:
        emit_tokens_push_sview(buffer, " --export=")
        if component and has_link_name:
            for index in 0..<link_name.count |buffer, link_name|:
                buffer.push(link_name[index])
        else:
            emit_tokens_push_sview(buffer, name)
        return true

    # --- parameters: split at depth-0 commas inside (open_index, close_index)
    raw_arguments: mutable darray[u8] = []
    setup: mutable darray[u8] = []
    cleanup: mutable darray[u8] = []
    parameter_count: mutable i64 = 0
    param_start: mutable usize = open_index + 1
    scan: mutable usize = open_index + 1
    scan_depth: mutable i64 = 0
    while scan <= close_index |scan, scan_depth, param_start, parameter_count, raw_arguments, setup, cleanup, buffer, tokens, source, message, mode, name, close_index|:
        kind: Lexer::TokenKind = tokens[scan].kind
        at_end: bool = scan == close_index
        if not at_end and (kind == Lexer::TokenKind.LParen or kind == Lexer::TokenKind.LBracket):
            scan_depth <- scan_depth + 1
        elif not at_end and (kind == Lexer::TokenKind.RParen or kind == Lexer::TokenKind.RBracket):
            scan_depth <- scan_depth - 1
        if (at_end or (kind == Lexer::TokenKind.Comma and scan_depth == 0)) and scan > param_start:
            # NAME : TYPE [= DEFAULT] in tokens[param_start..<scan]
            colon: mutable usize = scan
            default_at: mutable usize = scan
            for index in param_start..<scan |colon, default_at, tokens|:
                colon <- index if colon == scan and tokens[index].kind == Lexer::TokenKind.Colon
                default_at <- index if colon != scan and default_at == scan and index > colon and tokens[index].kind == Lexer::TokenKind.Assign
            if colon == scan:
                emit_tokens_push_sview(message, "exported function '")
                emit_tokens_push_sview(message, name)
                emit_tokens_push_sview(message, "' has a parameter without a name/type")
                return false
            parameter_name: sview = Lexer::text_or_empty(tokens[param_start], source)
            type_text: mutable darray[u8] = []
            wasm_push_type_text(&type_text, tokens, source, colon + 1, default_at)
            type_view: sview = sview_of_bytes(type_text)
            position: mutable darray[u8] = []
            emit_tokens_push_sview(&position, "parameter ")
            emit_tokens_push_sview(&position, parameter_name)
            abi: (binding: sview, wasm_type: sview) = wasm_abi_binding(type_view, name, sview_of_bytes(position), message)
            false return if abi.binding == ""
            if mode == WASM_SCAN_MANIFEST:
                emit_tokens_push_sview(buffer, ",") if parameter_count > 0
                emit_tokens_push_sview(buffer, "\n        {\n          \"name\": ")
                wasm_push_json_sview(buffer, parameter_name)
                emit_tokens_push_sview(buffer, ",\n          \"type\": ")
                wasm_push_json_string(buffer, type_text)
                emit_tokens_push_sview(buffer, ",\n          \"default\": ")
                if default_at == scan:
                    emit_tokens_push_sview(buffer, "null")
                else:
                    default_text: mutable darray[u8] = []
                    for index in (default_at + 1)..<scan |default_text, tokens, source|:
                        emit_tokens_push_sview(&default_text, " ") if default_text.count > 0
                        emit_tokens_push_sview(&default_text, Lexer::text_or_empty(tokens[index], source))
                    wasm_push_json_string(buffer, default_text)
                emit_tokens_push_sview(buffer, ",\n          \"binding\": ")
                wasm_push_json_sview(buffer, abi.binding)
                emit_tokens_push_sview(buffer, ",\n          \"wasm_type\": ")
                wasm_push_json_sview(buffer, abi.wasm_type)
                emit_tokens_push_sview(buffer, "\n        }")
            elif mode == WASM_SCAN_BINDINGS:
                emit_tokens_push_sview(buffer, ", ") if parameter_count > 0
                emit_tokens_push_sview(buffer, parameter_name)
                emit_tokens_push_sview(&raw_arguments, ", ") if parameter_count > 0
                if abi.binding == "string":
                    emit_tokens_push_sview(&raw_arguments, "__elisa_")
                    emit_tokens_push_sview(&raw_arguments, parameter_name)
                    emit_tokens_push_sview(&setup, "\n") if setup.count > 0
                    emit_tokens_push_sview(&setup, "      const __elisa_")
                    emit_tokens_push_sview(&setup, parameter_name)
                    emit_tokens_push_sview(&setup, " = typeof ")
                    emit_tokens_push_sview(&setup, parameter_name)
                    emit_tokens_push_sview(&setup, " === \"string\" ? memoryTools.writeString(")
                    emit_tokens_push_sview(&setup, parameter_name)
                    emit_tokens_push_sview(&setup, ") : (")
                    emit_tokens_push_sview(&setup, parameter_name)
                    emit_tokens_push_sview(&setup, " >>> 0);")
                    emit_tokens_push_sview(&cleanup, "\n") if cleanup.count > 0
                    emit_tokens_push_sview(&cleanup, "        if (typeof ")
                    emit_tokens_push_sview(&cleanup, parameter_name)
                    emit_tokens_push_sview(&cleanup, " === \"string\") memoryTools.free(__elisa_")
                    emit_tokens_push_sview(&cleanup, parameter_name)
                    emit_tokens_push_sview(&cleanup, ");")
                else:
                    wasm_push_js_input(&raw_arguments, type_view, parameter_name)
            elif mode == WASM_SCAN_DECLARATIONS:
                emit_tokens_push_sview(buffer, ", ") if parameter_count > 0
                emit_tokens_push_sview(buffer, parameter_name)
                emit_tokens_push_sview(buffer, ": ")
                emit_tokens_push_sview(buffer, wasm_ts_type(type_view, true))
            parameter_count <- parameter_count + 1
            param_start <- scan + 1
        scan <- scan + 1

    # --- row tail
    if mode == WASM_SCAN_MANIFEST:
        emit_tokens_push_sview(buffer, "\n      ") if parameter_count > 0
        emit_tokens_push_sview(buffer, "],\n      \"return\": ")
        wasm_push_json_string(buffer, return_text)
        emit_tokens_push_sview(buffer, ",\n      \"binding\": ")
        wasm_push_json_sview(buffer, return_abi.binding)
        emit_tokens_push_sview(buffer, ",\n      \"wasm_type\": ")
        wasm_push_json_sview(buffer, return_abi.wasm_type)
        emit_tokens_push_sview(buffer, ",\n      \"line\": ")
        append_decimal(buffer, line)
        if implicit:
            emit_tokens_push_sview(buffer, ",\n      \"implicit\": true")
        if has_link_name:
            emit_tokens_push_sview(buffer, ",\n      \"link_name\": ")
            wasm_push_json_string(buffer, link_name)
        emit_tokens_push_sview(buffer, "\n    }")
    elif mode == WASM_SCAN_BINDINGS:
        call: mutable darray[u8] = []
        emit_tokens_push_sview(&call, "instance.exports[")
        wasm_push_json_sview(&call, name)
        emit_tokens_push_sview(&call, "](")
        for index in 0..<raw_arguments.count |call, raw_arguments|:
            call.push(raw_arguments[index])
        emit_tokens_push_sview(&call, ")")
        if setup.count > 0:
            emit_tokens_push_sview(buffer, ") {\n")
            for index in 0..<setup.count |buffer, setup|:
                buffer.push(setup[index])
            emit_tokens_push_sview(buffer, "\n      try { return ")
            wasm_push_js_output(buffer, return_view, call)
            emit_tokens_push_sview(buffer, "; }\n      finally {\n")
            for index in 0..<cleanup.count |buffer, cleanup|:
                buffer.push(cleanup[index])
            emit_tokens_push_sview(buffer, "\n      }\n    }")
        else:
            emit_tokens_push_sview(buffer, ") { return ")
            wasm_push_js_output(buffer, return_view, call)
            emit_tokens_push_sview(buffer, "; }")
    elif mode == WASM_SCAN_DECLARATIONS:
        emit_tokens_push_sview(buffer, "): ")
        emit_tokens_push_sview(buffer, wasm_ts_type(return_view, false))
        emit_tokens_push_sview(buffer, ";")
    return true


# Walk the top-level declarations in source order: every `export fn` (Decl.Extern with an
# `__export_fn` target) and, once, `def main`. Returns the number of rows, or -1 with the
# message filled in.
def wasm_scan_exports(mode: i64, buffer: mutable darray[u8]&, file: Ast::File&, tokens: darray[Lexer::Token]&, source: u8&, component: bool, message: mutable darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    seen: mutable darray[sview] = []
    rows: mutable i64 = 0
    for declaration in file.top_decls |seen, rows, buffer, file, tokens, source, component, message, mode|:
        if declaration is Decl.Extern(ex_name, ex_param_start, ex_arity, ex_variadic, ex_callable, ex_return, ex_decorators, ex_line):
            export_target: sview = emit_ast_export_fn_target(file.enum_annotations, ex_name, ex_line.line)
            if export_target != "":
                for seen_name in seen |message, ex_name, ex_line|:
                    if seen_name == ex_name:
                        emit_tokens_push_sview(message, "duplicate WASM export '")
                        emit_tokens_push_sview(message, ex_name)
                        emit_tokens_push_sview(message, "' on line ")
                        append_decimal(message, source_original_line(ex_line.line))
                        return -1
                range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, ex_line.line, ex_line.offset)
                if not range.found:
                    emit_tokens_push_sview(message, "exported function '")
                    emit_tokens_push_sview(message, ex_name)
                    emit_tokens_push_sview(message, "' has no source tokens")
                    return -1
                stop: usize = emit_ast_line_end(tokens, ex_line.line, range.start)
                link_name: mutable darray[u8] = []
                has_link_name: bool = wasm_link_name(ex_decorators, tokens, source, &link_name)
                -1 return if not wasm_render_export(mode, buffer, tokens, source, range.start, stop, ex_name, export_target, source_original_line(ex_line.line), false, link_name, has_link_name, component, rows == 0, message)
                seen.push(ex_name)
                rows <- rows + 1
        elif declaration is Decl.Func(fn_name, fn_params, fn_return, fn_body, fn_effects, fn_decorators, fn_line):
            if fn_name == "main":
                already: mutable bool = false
                for seen_name in seen |already|:
                    already <- true if seen_name == "main"
                if not already:
                    range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, fn_line.line, fn_line.offset)
                    if range.found:
                        stop: usize = emit_ast_line_end(tokens, fn_line.line, range.start)
                        no_link: mutable darray[u8] = []
                        -1 return if not wasm_render_export(mode, buffer, tokens, source, range.start, stop, "main", "main", source_original_line(fn_line.line), true, no_link, false, component, rows == 0, message)
                        seen.push("main")
                        rows <- rows + 1
    if rows == 0 and mode == WASM_SCAN_VALIDATE:
        emit_tokens_push_sview(message, "WASM source has no exported function; add `export fn name(...) -> T = target`")
        return -1
    return rows


def wasm_push_mjs_seg1(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(buffer, "// Generated by `elisac -emit wasm`; edit the Elisa source, not this file.\n")
    emit_tokens_push_sview(buffer, "const WASM_URL = new URL(")


def wasm_push_mjs_seg2(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(buffer, ", import.meta.url);\n")
    emit_tokens_push_sview(buffer, "const PAGE_SIZE = 65536;\n")
    emit_tokens_push_sview(buffer, "const DEFAULT_INITIAL_PAGES = ")


def wasm_push_mjs_seg3(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(buffer, ";\n")
    emit_tokens_push_sview(buffer, "const DEFAULT_MAXIMUM_PAGES = ")


def wasm_push_mjs_seg4(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(buffer, ";\n")
    emit_tokens_push_sview(buffer, "const RUNTIME_STATE = Symbol(\"ElisaWasmRuntimeState\");\n")
    emit_tokens_push_sview(buffer, "const UTF8_ENCODER = new TextEncoder();\n")
    emit_tokens_push_sview(buffer, "const UTF8_DECODER = new TextDecoder();\n")
    emit_tokens_push_sview(buffer, "\n")
    emit_tokens_push_sview(buffer, "function align(value, boundary = 16) { return (value + boundary - 1) & ~(boundary - 1); }\n")
    emit_tokens_push_sview(buffer, "\n")
    emit_tokens_push_sview(buffer, "/** Create the small host ABI used by Elisa's portable runtime. User imports win. */\n")
    emit_tokens_push_sview(buffer, "export function createElisaImports(options = {}) {\n")
    emit_tokens_push_sview(buffer, "  const customImports = options.imports ?? {};\n")
    emit_tokens_push_sview(buffer, "  const customEnv = customImports.env ?? {};\n")
    emit_tokens_push_sview(buffer, "  const memory = options.memory ?? customEnv.memory ?? new WebAssembly.Memory({ initial: options.initialPages ?? DEFAULT_INITIAL_PAGES, maximum: options.maximumPages ?? DEFAULT_MAXIMUM_PAGES });\n")
    emit_tokens_push_sview(buffer, "  if (!(memory instanceof WebAssembly.Memory)) throw new TypeError(\"Elisa WASM requires options.memory/imports.env.memory to be a WebAssembly.Memory\");\n")
    emit_tokens_push_sview(buffer, "  let next = options.heapBase === undefined ? 0 : align(Number(options.heapBase));\n")
    emit_tokens_push_sview(buffer, "  let heapReady = options.heapBase !== undefined;\n")
    emit_tokens_push_sview(buffer, "  const allocations = new Map();\n")
    emit_tokens_push_sview(buffer, "  const freeBlocks = [];\n")
    emit_tokens_push_sview(buffer, "  const bytes = () => new Uint8Array(memory.buffer);\n")
    emit_tokens_push_sview(buffer, "  const ensureEnd = (end) => {\n")
    emit_tokens_push_sview(buffer, "    while (end > memory.buffer.byteLength) memory.grow(Math.max(1, Math.ceil((end - memory.buffer.byteLength) / PAGE_SIZE)));\n")
    emit_tokens_push_sview(buffer, "  };\n")
    emit_tokens_push_sview(buffer, "  const readCString = (pointer) => {\n")
    emit_tokens_push_sview(buffer, "    if (!pointer) return \"\";\n")
    emit_tokens_push_sview(buffer, "    const data = bytes(); let end = pointer >>> 0;\n")
    emit_tokens_push_sview(buffer, "    while (end < data.length && data[end] !== 0) end++;\n")
    emit_tokens_push_sview(buffer, "    return UTF8_DECODER.decode(data.subarray(pointer >>> 0, end));\n")
    emit_tokens_push_sview(buffer, "  };\n")
    emit_tokens_push_sview(buffer, "  const coalesceFreeBlocks = () => {\n")
    emit_tokens_push_sview(buffer, "    freeBlocks.sort((left, right) => left.pointer - right.pointer);\n")
    emit_tokens_push_sview(buffer, "    for (let index = 1; index < freeBlocks.length;) {\n")
    emit_tokens_push_sview(buffer, "      const previous = freeBlocks[index - 1], current = freeBlocks[index];\n")
    emit_tokens_push_sview(buffer, "      if (previous.pointer + previous.size === current.pointer) {\n")
    emit_tokens_push_sview(buffer, "        previous.size += current.size;\n")
    emit_tokens_push_sview(buffer, "        freeBlocks.splice(index, 1);\n")
    emit_tokens_push_sview(buffer, "      } else index++;\n")
    emit_tokens_push_sview(buffer, "    }\n")
    emit_tokens_push_sview(buffer, "  };\n")
    emit_tokens_push_sview(buffer, "  const setHeapBase = (value) => {\n")
    emit_tokens_push_sview(buffer, "    const base = align(Number(value));\n")
    emit_tokens_push_sview(buffer, "    next = Math.max(next, base);\n")
    emit_tokens_push_sview(buffer, "    heapReady = true;\n")
    emit_tokens_push_sview(buffer, "  };\n")
    emit_tokens_push_sview(buffer, "  const malloc = (requestedSize) => {\n")
    emit_tokens_push_sview(buffer, "    if (!heapReady) throw new Error(\"Elisa WASM allocator used before __heap_base was initialized\");\n")
    emit_tokens_push_sview(buffer, "    const numericSize = Number(requestedSize);\n")
    emit_tokens_push_sview(buffer, "    if (!Number.isSafeInteger(numericSize) || numericSize < 0) throw new RangeError(`Invalid Elisa WASM allocation size: ${requestedSize}`);\n")
    emit_tokens_push_sview(buffer, "    const size = align(Math.max(1, numericSize));\n")
    emit_tokens_push_sview(buffer, "    const reusable = freeBlocks.findIndex((block) => block.size >= size);\n")
    emit_tokens_push_sview(buffer, "    if (reusable >= 0) {\n")
    emit_tokens_push_sview(buffer, "      const block = freeBlocks[reusable];\n")
    emit_tokens_push_sview(buffer, "      const pointer = block.pointer;\n")
    emit_tokens_push_sview(buffer, "      if (block.size === size) freeBlocks.splice(reusable, 1);\n")
    emit_tokens_push_sview(buffer, "      else { block.pointer += size; block.size -= size; }\n")
    emit_tokens_push_sview(buffer, "      allocations.set(pointer, size);\n")
    emit_tokens_push_sview(buffer, "      return pointer;\n")
    emit_tokens_push_sview(buffer, "    }\n")
    emit_tokens_push_sview(buffer, "    const pointer = align(next);\n")
    emit_tokens_push_sview(buffer, "    next = pointer + size;\n")
    emit_tokens_push_sview(buffer, "    ensureEnd(next);\n")
    emit_tokens_push_sview(buffer, "    allocations.set(pointer, size);\n")
    emit_tokens_push_sview(buffer, "    return pointer;\n")
    emit_tokens_push_sview(buffer, "  };\n")
    emit_tokens_push_sview(buffer, "  const free = (rawPointer) => {\n")
    emit_tokens_push_sview(buffer, "    const pointer = Number(rawPointer) >>> 0;\n")
    emit_tokens_push_sview(buffer, "    const size = allocations.get(pointer);\n")
    emit_tokens_push_sview(buffer, "    if (size === undefined) return;\n")
    emit_tokens_push_sview(buffer, "    allocations.delete(pointer);\n")
    emit_tokens_push_sview(buffer, "    freeBlocks.push({ pointer, size });\n")
    emit_tokens_push_sview(buffer, "    coalesceFreeBlocks();\n")
