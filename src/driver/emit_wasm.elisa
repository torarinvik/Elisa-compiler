    emit_tokens_push_sview(buffer, "      : Uint8Array.from(new Uint8Array(value.buffer ?? value, value.byteOffset ?? 0, value.byteLength ?? value.length));\n")
    emit_tokens_push_sview(buffer, "    const pointer = malloc(source.byteLength + (nulTerminate ? 1 : 0));\n")
    emit_tokens_push_sview(buffer, "    bytes().set(source, pointer);\n")
    emit_tokens_push_sview(buffer, "    if (nulTerminate) bytes()[pointer + source.byteLength] = 0;\n")
    emit_tokens_push_sview(buffer, "    return Object.freeze({ pointer, length: source.byteLength });\n")
    emit_tokens_push_sview(buffer, "  };\n")
    emit_tokens_push_sview(buffer, "  const readBytes = (pointer, length) => bytes().slice(pointer >>> 0, (pointer >>> 0) + Number(length));\n")
    emit_tokens_push_sview(buffer, "  const writeString = (text) => writeBytes(UTF8_ENCODER.encode(String(text)), true).pointer;\n")
    emit_tokens_push_sview(buffer, "  const onWrite = options.onWrite ?? ((text, descriptor) => (descriptor === 2 ? console.error(text) : console.log(text)));\n")
    emit_tokens_push_sview(buffer, "  const env = {\n")
    emit_tokens_push_sview(buffer, "    memory,\n")
