        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, "); arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native set returned an invalid sview element\"); return NULL; } if (error_payload_view.data == NULL) error_payload_item = PyUnicode_FromString(\"\"); else error_payload_item = PyUnicode_DecodeUTF8(error_payload_view.data, (Py_ssize_t)error_payload_view.len, \"strict\"); ")
    elif element_name == "bool":
