    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".items)[error_payload_index]; if (error_payload_bucket->state != 1) continue; PyObject *error_payload_item = NULL; ")
    if element_name == "cstr":
        emit_tokens_push_sview(buffer, "if (error_payload_bucket->key == NULL) { Py_DECREF(")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, "); arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native set returned a null cstr element\"); return NULL; } error_payload_item = PyUnicode_FromString(error_payload_bucket->key); ")
    elif element_name == "sview":
