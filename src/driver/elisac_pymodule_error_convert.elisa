# `-emit pymodule` — copying an error payload out while the native error arena is still alive:
# the darray, view, set and struct-dict payload shapes.


def emit_pymodule_error_payload_darray_conversion(buffer: mutable darray[u8]&, file: Ast::File&, type_name: sview, expression: sview, destination: sview) -> void can[Abort.Panic, Memory.Allocate]:
    # Error payload darrays are borrowed until the Python exception is constructed. Validate and
    # copy them while the wrapper arena (and any input-list buffers they reference) is still live.
    element_name: sview = pymodule_darray_element_name(type_name)
    if pymodule_is_set_type(element_name):
        helper_storage: mutable darray[u8] = []
        helper: sview = pymodule_error_named_aggregate_helper_name(type_name, &helper_storage)
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = ")
        emit_tokens_push_sview(buffer, helper)
        emit_tokens_push_sview(buffer, "(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, "); if (")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " == NULL) { arena_free(&arena); return NULL; }\n")
        return
    if pymodule_is_dict_type(element_name):
        helper_storage: mutable darray[u8] = []
        helper: sview = pymodule_error_darray_dict_helper_name(type_name, &helper_storage, false)
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = ")
        emit_tokens_push_sview(buffer, helper)
        emit_tokens_push_sview(buffer, "(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, "); if (")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " == NULL) { arena_free(&arena); return NULL; }\n")
        return
    if pymodule_darray_nesting_depth(type_name) == 1.usize() and pymodule_struct_return_supported(file, element_name):
        helper_storage: mutable darray[u8] = []
        helper: sview = pymodule_error_named_aggregate_helper_name(type_name, &helper_storage)
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = ")
        emit_tokens_push_sview(buffer, helper)
        emit_tokens_push_sview(buffer, "(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, "); if (")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " == NULL) { arena_free(&arena); return NULL; }\n")
        return
    if pymodule_error_nested_darray_supported(type_name):
        helper_suffix_storage: mutable darray[u8] = []
        helper_suffix: sview = pymodule_error_nested_darray_helper_suffix(type_name, &helper_suffix_storage)
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = elisa_pymodule_error_nested_")
        emit_tokens_push_sview(buffer, helper_suffix)
        emit_tokens_push_sview(buffer, "_to_py(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, "); if (")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " == NULL) { arena_free(&arena); return NULL; }\n")
        return
    emit_tokens_push_sview(buffer, "if (")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".count < 0 || ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".capacity < 0 || ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".count > ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".capacity || ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".count > PY_SSIZE_T_MAX || ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".capacity > PY_SSIZE_T_MAX || (")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".items == NULL && ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".count != 0)) { arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native Elisa error returned an invalid list payload\"); return NULL; }\n")
    if pymodule_darray_is_bytes(type_name):
        emit_tokens_push_sview(buffer, "if (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".count == 0) ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyBytes_FromStringAndSize(\"\", 0); else ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyBytes_FromStringAndSize((const char *)")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".items, (Py_ssize_t)")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".count);\n")
    else:
        emit_tokens_push_sview(buffer, "if (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".count == 0) ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyList_New(0); else { ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyList_New((Py_ssize_t)")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".count); if (")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " == NULL) { arena_free(&arena); return NULL; } for (Py_ssize_t error_payload_index = 0; error_payload_index < (Py_ssize_t)")
        emit_tokens_push_sview(buffer, expression)
        # Element-specific branches may need to declare a temporary native value
        # (`ElisaOptionalI64`, `ElisaSView`, or `PyObject *`) before assigning the
        # Python result.  Start with a standalone NULL declaration; prefixing the
        # branch with `PyObject *error_payload_item =` would concatenate two C
        # declarations and make every typed list payload uncompilable.
        emit_tokens_push_sview(buffer, ".count; ++error_payload_index) { PyObject *error_payload_item = NULL; ")
        if element_name == "sview":
            emit_tokens_push_sview(buffer, "ElisaSView error_payload_view = ((ElisaSView *)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".items)[error_payload_index]; if (error_payload_view.len < 0 || error_payload_view.len > PY_SSIZE_T_MAX || (error_payload_view.data == NULL && error_payload_view.len != 0)) { Py_DECREF(")
            emit_tokens_push_sview(buffer, destination)
            emit_tokens_push_sview(buffer, "); arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native Elisa error returned an invalid text list payload\"); return NULL; } if (error_payload_view.data == NULL) error_payload_item = PyUnicode_FromString(\"\"); else error_payload_item = PyUnicode_DecodeUTF8(error_payload_view.data, (Py_ssize_t)error_payload_view.len, \"strict\"); ")
        elif element_name == "cstr":
            emit_tokens_push_sview(buffer, "const char *error_payload_text = ((const char **)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".items)[error_payload_index]; if (error_payload_text == NULL) { Py_DECREF(")
            emit_tokens_push_sview(buffer, destination)
            emit_tokens_push_sview(buffer, "); arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native Elisa error returned a null cstr list payload\"); return NULL; } error_payload_item = PyUnicode_FromString(error_payload_text); ")
        elif element_name == "cstr?":
            emit_tokens_push_sview(buffer, "const char *error_payload_text = ((const char **)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".items)[error_payload_index]; if (error_payload_text == NULL) { Py_INCREF(Py_None); error_payload_item = Py_None; } else error_payload_item = PyUnicode_FromString(error_payload_text); ")
        elif element_name == "sview?":
            emit_tokens_push_sview(buffer, "ElisaOptionalSView error_payload_optional_view = ((ElisaOptionalSView *)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".items)[error_payload_index]; if (!error_payload_optional_view.has_value) { Py_INCREF(Py_None); error_payload_item = Py_None; } else { ElisaSView error_payload_view = error_payload_optional_view.value; if (error_payload_view.len < 0 || error_payload_view.len > PY_SSIZE_T_MAX || (error_payload_view.data == NULL && error_payload_view.len != 0)) { Py_DECREF(")
            emit_tokens_push_sview(buffer, destination)
            emit_tokens_push_sview(buffer, "); arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native Elisa error returned an invalid optional text list payload\"); return NULL; } error_payload_item = error_payload_view.data == NULL ? PyUnicode_FromString(\"\") : PyUnicode_DecodeUTF8(error_payload_view.data, (Py_ssize_t)error_payload_view.len, \"strict\"); } ")
        elif element_name == "py::Object":
            emit_tokens_push_sview(buffer, "PyObject *error_payload_object = ((PyObject **)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".items)[error_payload_index]; if (error_payload_object == NULL) { Py_INCREF(Py_None); error_payload_item = Py_None; } else { Py_INCREF(error_payload_object); error_payload_item = error_payload_object; } ")
        elif element_name == "py::Object?":
            emit_tokens_push_sview(buffer, "PyObject *error_payload_object = ((PyObject **)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".items)[error_payload_index]; if (error_payload_object == NULL) { Py_INCREF(Py_None); error_payload_item = Py_None; } else { Py_INCREF(error_payload_object); error_payload_item = error_payload_object; } ")
        elif pymodule_is_optional_scalar_type(element_name):
            optional_c_type: sview = pymodule_c_type_name(element_name)
            payload_name: sview = pymodule_optional_payload_name(element_name)
            emit_tokens_push_sview(buffer, optional_c_type)
            emit_tokens_push_sview(buffer, " error_payload_optional = ((")
            emit_tokens_push_sview(buffer, optional_c_type)
            emit_tokens_push_sview(buffer, " *)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".items)[error_payload_index]; if (!error_payload_optional.has_value) { Py_INCREF(Py_None); error_payload_item = Py_None; } else {")
            if payload_name == "bool":
                emit_tokens_push_sview(buffer, " error_payload_item = PyBool_FromLong((long)error_payload_optional.value); } ")
            elif payload_name == "f32" or payload_name == "f64":
                emit_tokens_push_sview(buffer, " error_payload_item = PyFloat_FromDouble((double)error_payload_optional.value); } ")
            elif payload_name == "u8" or payload_name == "u16" or payload_name == "u32" or payload_name == "u64" or payload_name == "usize" or payload_name == "uintptr":
                emit_tokens_push_sview(buffer, " error_payload_item = PyLong_FromUnsignedLongLong((unsigned long long)error_payload_optional.value); } ")
            else:
                emit_tokens_push_sview(buffer, " error_payload_item = PyLong_FromLongLong((long long)error_payload_optional.value); } ")
        elif element_name == "bool":
            emit_tokens_push_sview(buffer, "error_payload_item = PyBool_FromLong((long)((bool *)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".items)[error_payload_index]); ")
        elif element_name == "f32" or element_name == "f64":
            emit_tokens_push_sview(buffer, "error_payload_item = PyFloat_FromDouble((double)((")
            emit_tokens_push_sview(buffer, pymodule_darray_c_element_type(element_name))
            emit_tokens_push_sview(buffer, " *)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".items)[error_payload_index]); ")
        elif pymodule_darray_element_is_unsigned(element_name):
            emit_tokens_push_sview(buffer, "error_payload_item = PyLong_FromUnsignedLongLong((unsigned long long)((")
            emit_tokens_push_sview(buffer, pymodule_darray_c_element_type(element_name))
            emit_tokens_push_sview(buffer, " *)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".items)[error_payload_index]); ")
        else:
            emit_tokens_push_sview(buffer, "error_payload_item = PyLong_FromLongLong((long long)((")
            emit_tokens_push_sview(buffer, pymodule_darray_c_element_type(element_name))
            emit_tokens_push_sview(buffer, " *)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".items)[error_payload_index]); ")
        emit_tokens_push_sview(buffer, "if (error_payload_item == NULL) { Py_DECREF(")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, "); arena_free(&arena); return NULL; } PyList_SET_ITEM(")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, ", error_payload_index, error_payload_item); } }")
        emit_tokens_push_sview(buffer, ";\n")
    emit_tokens_push_sview(buffer, "if (")
    emit_tokens_push_sview(buffer, destination)
    emit_tokens_push_sview(buffer, " == NULL) { arena_free(&arena); return NULL; }\n")




def emit_pymodule_error_payload_view_conversion(buffer: mutable darray[u8]&, file: Ast::File&, type_name: sview, expression: sview, destination: sview) -> void can[Abort.Panic, Memory.Allocate]:
    # Views borrow storage just like sview. Copy the borrowed range while the wrapper arena and
    # any input-sequence backing buffers are still live; Python receives an owning bytes/list.
    element_name: sview = pymodule_view_element_name(type_name)
    if pymodule_struct_return_supported(file, element_name):
        helper_storage: mutable darray[u8] = []
        helper: sview = pymodule_error_named_aggregate_helper_name(type_name, &helper_storage)
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = ")
        emit_tokens_push_sview(buffer, helper)
        emit_tokens_push_sview(buffer, "(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, "); if (")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " == NULL) { arena_free(&arena); return NULL; }\n")
        return
    emit_tokens_push_sview(buffer, "if (")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".len < 0 || ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".len > PY_SSIZE_T_MAX || (")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".data == NULL && ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".len != 0)) { arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native Elisa error returned an invalid view payload\"); return NULL; }\n")
    if element_name == "u8":
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyBytes_FromStringAndSize((const char *)")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".data, (Py_ssize_t)")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".len);\n")
    else:
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyList_New((Py_ssize_t)")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".len); if (")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " == NULL) { arena_free(&arena); return NULL; } for (Py_ssize_t error_payload_index = 0; error_payload_index < (Py_ssize_t)")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".len; ++error_payload_index) { PyObject *error_payload_item = NULL; ")
        if element_name == "sview" or element_name == "sview?":
            if element_name == "sview?":
                emit_tokens_push_sview(buffer, "ElisaOptionalSView error_payload_optional_view = ((ElisaOptionalSView *)")
                emit_tokens_push_sview(buffer, expression)
                emit_tokens_push_sview(buffer, ".data)[error_payload_index]; if (!error_payload_optional_view.has_value) { Py_INCREF(Py_None); error_payload_item = Py_None; } else { ElisaSView error_payload_view = error_payload_optional_view.value; if (error_payload_view.len < 0 || error_payload_view.len > PY_SSIZE_T_MAX || (error_payload_view.data == NULL && error_payload_view.len != 0)) { Py_DECREF(")
                emit_tokens_push_sview(buffer, destination)
                emit_tokens_push_sview(buffer, "); arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native Elisa error returned an invalid optional text view payload\"); return NULL; } error_payload_item = error_payload_view.data == NULL ? PyUnicode_FromString(\"\") : PyUnicode_DecodeUTF8(error_payload_view.data, (Py_ssize_t)error_payload_view.len, \"strict\"); } ")
            else:
                emit_tokens_push_sview(buffer, "ElisaSView error_payload_view = ((ElisaSView *)")
                emit_tokens_push_sview(buffer, expression)
                emit_tokens_push_sview(buffer, ".data)[error_payload_index]; if (error_payload_view.len < 0 || error_payload_view.len > PY_SSIZE_T_MAX || (error_payload_view.data == NULL && error_payload_view.len != 0)) { Py_DECREF(")
                emit_tokens_push_sview(buffer, destination)
                emit_tokens_push_sview(buffer, "); arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native Elisa error returned an invalid text view payload\"); return NULL; } error_payload_item = error_payload_view.data == NULL ? PyUnicode_FromString(\"\") : PyUnicode_DecodeUTF8(error_payload_view.data, (Py_ssize_t)error_payload_view.len, \"strict\"); ")
        elif element_name == "cstr" or element_name == "cstr?":
            emit_tokens_push_sview(buffer, "const char *error_payload_text = ((const char **)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".data)[error_payload_index]; ")
            if element_name == "cstr?":
                emit_tokens_push_sview(buffer, "if (error_payload_text == NULL) { Py_INCREF(Py_None); error_payload_item = Py_None; } else error_payload_item = PyUnicode_FromString(error_payload_text); ")
            else:
                emit_tokens_push_sview(buffer, "if (error_payload_text == NULL) { Py_DECREF(")
                emit_tokens_push_sview(buffer, destination)
                emit_tokens_push_sview(buffer, "); arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native Elisa error returned a null cstr view payload\"); return NULL; } error_payload_item = PyUnicode_FromString(error_payload_text); ")
        elif element_name == "py::Object" or element_name == "py::Object?":
            emit_tokens_push_sview(buffer, "PyObject *error_payload_object = ((PyObject **)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".data)[error_payload_index]; if (error_payload_object == NULL) { Py_INCREF(Py_None); error_payload_item = Py_None; } else { Py_INCREF(error_payload_object); error_payload_item = error_payload_object; } ")
        elif pymodule_is_optional_scalar_type(element_name):
            optional_c_type: sview = pymodule_c_type_name(element_name)
            payload_name: sview = pymodule_optional_payload_name(element_name)
            emit_tokens_push_sview(buffer, optional_c_type)
            emit_tokens_push_sview(buffer, " error_payload_optional = ((")
            emit_tokens_push_sview(buffer, optional_c_type)
            emit_tokens_push_sview(buffer, " *)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".data)[error_payload_index]; if (!error_payload_optional.has_value) { Py_INCREF(Py_None); error_payload_item = Py_None; } else {")
            if payload_name == "bool":
                emit_tokens_push_sview(buffer, " error_payload_item = PyBool_FromLong((long)error_payload_optional.value); } ")
            elif payload_name == "f32" or payload_name == "f64":
                emit_tokens_push_sview(buffer, " error_payload_item = PyFloat_FromDouble((double)error_payload_optional.value); } ")
            elif payload_name == "u8" or payload_name == "u16" or payload_name == "u32" or payload_name == "u64" or payload_name == "usize" or payload_name == "uintptr":
                emit_tokens_push_sview(buffer, " error_payload_item = PyLong_FromUnsignedLongLong((unsigned long long)error_payload_optional.value); } ")
            else:
                emit_tokens_push_sview(buffer, " error_payload_item = PyLong_FromLongLong((long long)error_payload_optional.value); } ")
        elif element_name == "bool":
            emit_tokens_push_sview(buffer, "error_payload_item = PyBool_FromLong((long)((bool *)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".data)[error_payload_index]); ")
        elif element_name == "f32" or element_name == "f64":
            emit_tokens_push_sview(buffer, "error_payload_item = PyFloat_FromDouble((double)((")
            emit_tokens_push_sview(buffer, pymodule_darray_c_element_type(element_name))
            emit_tokens_push_sview(buffer, " *)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".data)[error_payload_index]); ")
        elif pymodule_darray_element_is_unsigned(element_name):
            emit_tokens_push_sview(buffer, "error_payload_item = PyLong_FromUnsignedLongLong((unsigned long long)((")
            emit_tokens_push_sview(buffer, pymodule_darray_c_element_type(element_name))
            emit_tokens_push_sview(buffer, " *)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".data)[error_payload_index]); ")
        else:
            emit_tokens_push_sview(buffer, "error_payload_item = PyLong_FromLongLong((long long)((")
            emit_tokens_push_sview(buffer, pymodule_darray_c_element_type(element_name))
            emit_tokens_push_sview(buffer, " *)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".data)[error_payload_index]); ")
        emit_tokens_push_sview(buffer, "if (error_payload_item == NULL) { Py_DECREF(")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, "); arena_free(&arena); return NULL; } PyList_SET_ITEM(")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, ", error_payload_index, error_payload_item); }\n")
    emit_tokens_push_sview(buffer, "if (")
    emit_tokens_push_sview(buffer, destination)
    emit_tokens_push_sview(buffer, " == NULL) { arena_free(&arena); return NULL; }\n")




def emit_pymodule_error_struct_dict_field_conversion(buffer: mutable darray[u8]&, type_name: sview, expression: sview, field_index: usize) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    # The ordinary dictionary copier already validates every bucket and retains borrowed
    # object values. Splice it into the structured-error field block, using a zero local arena
    # name so its cleanup paths cannot release the wrapper's live error arena before all fields
    # have been copied.
    emit_tokens_push_sview(buffer, "ElisaDict result = ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, "; ElisaArena field_arena = {0};\n")
    snippet: mutable darray[u8] = []
    empty_params: darray[Ast::ParamDecl] = []
    dict_helper_name_storage: mutable darray[u8] = []
    dict_helper_name: sview = pymodule_error_nested_dict_helper_name(type_name, &dict_helper_name_storage)
    emit_pymodule_dict_return_conversion(&snippet, empty_params, type_name, true, dict_helper_name)
    done_label: mutable darray[u8] = []
    emit_tokens_push_sview(&done_label, "elisa_pymodule_error_dict_field_done_")
    append_decimal(&done_label, field_index.i64())
    done_label_view: sview = sview(&done_label[0], 0, done_label.count)
    failed_label: mutable darray[u8] = []
    emit_tokens_push_sview(&failed_label, "elisa_pymodule_error_dict_field_failed_")
    append_decimal(&failed_label, field_index.i64())
    failed_label_view: sview = sview(&failed_label[0], 0, failed_label.count)
    replacement: mutable darray[u8] = []
    emit_tokens_push_sview(&replacement, "field_object = field_out; goto ")
    emit_tokens_push_sview(&replacement, done_label_view)
    emit_tokens_push_sview(&replacement, ";")
    replacement_view: sview = sview(&replacement[0], 0, replacement.count)
    pymodule_replace_generated(&snippet, "&arena", "&field_arena")
    pymodule_replace_generated_local(&snippet, "out", "field_out")
    # Remove the copier's failure-path local-arena releases before installing the success handoff;
    # the handoff itself must retain one explicit field-arena release after the dictionary is copied.
    pymodule_replace_generated(&snippet, "arena_free(&field_arena);", "")
    success_replacement: mutable darray[u8] = []
    emit_tokens_push_sview(&success_replacement, "arena_free(&field_arena); ")
    for replacement_index in 0..<replacement.count |success_replacement, replacement|:
        success_replacement.push(replacement[replacement_index])
    success_replacement_view: sview = sview(&success_replacement[0], 0, success_replacement.count)
    pymodule_replace_generated(&snippet, "return field_out;", success_replacement_view)
    # A malformed native dictionary or a Python allocation failure must still release the
    # enclosing error arena. The nested copier's zero arena is only for its local cleanup calls;
    # centralize both arena releases at one failure label. A goto is required because the copier
    # contains unbraced `if (...) return NULL;` statements; textual cleanup insertion would make
    # those returns unconditional.
    failure_goto: mutable darray[u8] = []
    emit_tokens_push_sview(&failure_goto, "goto ")
    emit_tokens_push_sview(&failure_goto, failed_label_view)
    emit_tokens_push_sview(&failure_goto, ";")
    failure_goto_view: sview = sview(&failure_goto[0], 0, failure_goto.count)
    pymodule_replace_generated(&snippet, "return NULL;", failure_goto_view)
    for snippet_index in 0..<snippet.count |buffer, snippet|:
        buffer.push(snippet[snippet_index])
    emit_tokens_push_sview(buffer, failed_label_view)
    emit_tokens_push_sview(buffer, ":; arena_free(&field_arena); arena_free(&arena); return NULL; ")
    emit_tokens_push_sview(buffer, done_label_view)
    emit_tokens_push_sview(buffer, ":; ")




def emit_pymodule_optional_error_payload_conversion(buffer: mutable darray[u8]&, type_name: sview, expression: sview, destination: sview) -> void can[Abort.Panic, Memory.Allocate]:
    # Optional pointers use null as the absent value; value optionals carry an explicit
    # `has_value` bit. Keep this helper expression-based so single-field and structured
    # payloads share exactly the same Python conversion and validation rules.
    if type_name == "cstr?":
        emit_tokens_push_sview(buffer, "if (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, " == NULL) { Py_INCREF(Py_None); ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = Py_None; } else ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyUnicode_FromString(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ");\n")
        return
    if type_name == "py::Object?":
        emit_tokens_push_sview(buffer, "if (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, " == NULL) { Py_INCREF(Py_None); ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = Py_None; } else { Py_INCREF(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, "); ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = ")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, "; }\n")
        return
    payload_name: sview = pymodule_optional_payload_name(type_name)
    emit_tokens_push_sview(buffer, "if (!(")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ").has_value) { Py_INCREF(Py_None); ")
    emit_tokens_push_sview(buffer, destination)
    emit_tokens_push_sview(buffer, " = Py_None; } else {")
    if payload_name == "sview":
        emit_tokens_push_sview(buffer, " if ((")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value.len < 0 || (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value.len > PY_SSIZE_T_MAX || ((")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value.data == NULL && (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value.len != 0)) { PyErr_SetString(PyExc_RuntimeError, \"native optional sview error payload is invalid\"); return NULL; }")
        emit_tokens_push_sview(buffer, " if ((")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value.data == NULL) ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyUnicode_FromString(\"\"); else ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyUnicode_DecodeUTF8((")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value.data, (Py_ssize_t)(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value.len, \"strict\");")
    elif payload_name == "bool":
        emit_tokens_push_sview(buffer, " ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyBool_FromLong((long)(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value);")
    elif payload_name == "f32" or payload_name == "f64":
        emit_tokens_push_sview(buffer, " ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyFloat_FromDouble((double)(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value);")
    elif payload_name == "u8" or payload_name == "u16" or payload_name == "u32" or payload_name == "u64" or payload_name == "usize" or payload_name == "uintptr":
        emit_tokens_push_sview(buffer, " ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyLong_FromUnsignedLongLong((unsigned long long)(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value);")
    else:
        emit_tokens_push_sview(buffer, " ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyLong_FromLongLong((long long)(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value);")
    emit_tokens_push_sview(buffer, " }\n")




def emit_pymodule_error_payload_set_conversion(buffer: mutable darray[u8]&, type_name: sview, expression: sview, destination: sview) -> void can[Abort.Panic, Memory.Allocate]:
    # Sets carry an open-addressed bucket table rather than a linear darray. Error payloads are
    # borrowed until the exception object is built, so validate the table and materialize a fresh
    # Python set before the wrapper releases its arena.
