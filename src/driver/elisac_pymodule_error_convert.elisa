    emit_tokens_push_sview(buffer, ".capacity || ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".count > PY_SSIZE_T_MAX || ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".capacity > PY_SSIZE_T_MAX) { arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native Elisa error returned an invalid set payload\"); return NULL; } ")
    emit_tokens_push_sview(buffer, destination)
    emit_tokens_push_sview(buffer, " = PySet_New(NULL); if (")
    emit_tokens_push_sview(buffer, destination)
    emit_tokens_push_sview(buffer, " == NULL) { arena_free(&arena); return NULL; } if (")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".count != 0) { if (")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".items == NULL || ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".capacity == 0) { Py_DECREF(")
    emit_tokens_push_sview(buffer, destination)
