# `-emit pymodule` — materializing the dict ITEM shapes that are not plain scalars: optional
# scalars, nested lists, and the view elements that need their own storage.

def emit_pymodule_dict_optional_scalar_input(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, value_name: sview, parameter_index: usize) -> void can[Abort.Panic, Memory.Allocate]:
    payload_name: sview = pymodule_optional_payload_name(value_name)
    optional_c_type: sview = pymodule_c_type_name(value_name)
    payload_c_type: sview = pymodule_optional_payload_c_type(payload_name)
    emit_tokens_push_sview(buffer, "        ")
    emit_tokens_push_sview(buffer, optional_c_type)
    emit_tokens_push_sview(buffer, " arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_value_scalar = {false, 0};\n        if (arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_value_obj != Py_None) {\n")
    if payload_name == "bool":
        emit_tokens_push_sview(buffer, "            int arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_value_truth = PyObject_IsTrue(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_value_obj);\n            if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_value_truth < 0) {\n")
    elif payload_name == "f32" or payload_name == "f64":
        emit_tokens_push_sview(buffer, "            double arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_value_number = PyFloat_AsDouble(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_value_obj);\n            if (PyErr_Occurred()) {\n")
    elif payload_name == "u8" or payload_name == "u16" or payload_name == "u32" or payload_name == "u64" or payload_name == "usize":
        emit_tokens_push_sview(buffer, "            unsigned long long arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_value_number = PyLong_AsUnsignedLongLong(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_value_obj);\n            if (PyErr_Occurred()) {\n")
    else:
        emit_tokens_push_sview(buffer, "            long long arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_value_number = PyLong_AsLongLong(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_value_obj);\n            if (PyErr_Occurred()) {\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "                ")
    emit_pymodule_dict_cleanup_one(buffer, target_params, parameter_index, "                ")
    emit_tokens_push_sview(buffer, "                return NULL;\n            }\n")
    if payload_name == "i8":
        emit_tokens_push_sview(buffer, "            if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_value_number < -128 || arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_value_number > 127) { PyErr_SetString(PyExc_OverflowError, \"i8 dictionary value out of range\");\n")
    elif payload_name == "i16":
        emit_tokens_push_sview(buffer, "            if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_value_number < -32768 || arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_value_number > 32767) { PyErr_SetString(PyExc_OverflowError, \"i16 dictionary value out of range\");\n")
    elif payload_name == "i32":
        emit_tokens_push_sview(buffer, "            if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_value_number < -2147483648LL || arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_value_number > 2147483647LL) { PyErr_SetString(PyExc_OverflowError, \"i32 dictionary value out of range\");\n")
    elif payload_name == "u8":
        emit_tokens_push_sview(buffer, "            if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_value_number > 255ULL) { PyErr_SetString(PyExc_OverflowError, \"u8 dictionary value out of range\");\n")
    elif payload_name == "u16":
        emit_tokens_push_sview(buffer, "            if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_value_number > 65535ULL) { PyErr_SetString(PyExc_OverflowError, \"u16 dictionary value out of range\");\n")
    elif payload_name == "u32":
        emit_tokens_push_sview(buffer, "            if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_value_number > 4294967295ULL) { PyErr_SetString(PyExc_OverflowError, \"u32 dictionary value out of range\");\n")
    if payload_name == "i8" or payload_name == "i16" or payload_name == "i32" or payload_name == "u8" or payload_name == "u16" or payload_name == "u32":
        emit_pymodule_darray_cleanup(buffer, target_params, "                ")
        emit_pymodule_dict_cleanup_one(buffer, target_params, parameter_index, "                ")
        emit_tokens_push_sview(buffer, "                return NULL; }\n")
    emit_tokens_push_sview(buffer, "            arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_value_scalar = (")
    emit_tokens_push_sview(buffer, optional_c_type)
    emit_tokens_push_sview(buffer, "){true, (")
    emit_tokens_push_sview(buffer, payload_c_type)
    emit_tokens_push_sview(buffer, ")(arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_value_truth" if payload_name == "bool" else "_value_number")
    emit_tokens_push_sview(buffer, ")};\n        }\n")




# Convert one scalar nested-list item after the surrounding branch has declared `argN_nested_item`
# and allocated `argN_nested_items`. This keeps nested numeric dictionaries on the same range and
# conversion rules as ordinary darray inputs.
def emit_pymodule_dict_nested_scalar_item_input(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, element_name: sview, parameter_index: usize) -> void can[Abort.Panic, Memory.Allocate]:
    element_c_type: sview = pymodule_darray_c_element_type(element_name)
    if element_name == "bool":
        emit_tokens_push_sview(buffer, "int arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_nested_truth = PyObject_IsTrue(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_nested_item); if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_nested_truth < 0) { Py_DECREF(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_nested_seq);\n")
        emit_pymodule_dict_cleanup_one(buffer, target_params, parameter_index, "                ")
        emit_tokens_push_sview(buffer, "                return NULL; } arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_nested_items[arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_nested_index] = (bool)arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_nested_truth;\n")
        return
    if element_name == "f32" or element_name == "f64":
        emit_tokens_push_sview(buffer, "double arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_nested_number = PyFloat_AsDouble(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_nested_item); if (PyErr_Occurred()) { Py_DECREF(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_nested_seq);\n")
        emit_pymodule_dict_cleanup_one(buffer, target_params, parameter_index, "                ")
        emit_tokens_push_sview(buffer, "                return NULL; } arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_nested_items[arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_nested_index] = (")
        emit_tokens_push_sview(buffer, element_c_type)
        emit_tokens_push_sview(buffer, ")arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_nested_number;\n")
        return
    unsigned_element: bool = pymodule_darray_element_is_unsigned(element_name)
    emit_tokens_push_sview(buffer, "unsigned long long arg" if unsigned_element else "long long arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_number = PyLong_AsUnsignedLongLong(arg" if unsigned_element else "_nested_number = PyLong_AsLongLong(arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_item); if (PyErr_Occurred()) { Py_DECREF(arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_seq);\n")
    emit_pymodule_dict_cleanup_one(buffer, target_params, parameter_index, "                ")
    emit_tokens_push_sview(buffer, "                return NULL; }")
    lower: mutable sview = ""
    upper: mutable sview = ""
    if element_name == "i8":
        lower <- "INT8_MIN"
        upper <- "INT8_MAX"
    elif element_name == "i16":
        lower <- "INT16_MIN"
        upper <- "INT16_MAX"
    elif element_name == "i32":
        lower <- "INT32_MIN"
        upper <- "INT32_MAX"
    elif element_name == "u8":
        upper <- "UINT8_MAX"
    elif element_name == "u16":
        upper <- "UINT16_MAX"
    elif element_name == "u32":
        upper <- "UINT32_MAX"
    if lower != "" or upper != "":
        emit_tokens_push_sview(buffer, " if (")
        if lower != "":
            emit_tokens_push_sview(buffer, "arg")
            append_decimal(buffer, parameter_index.i64())
            emit_tokens_push_sview(buffer, "_nested_number < ")
            emit_tokens_push_sview(buffer, lower)
            emit_tokens_push_sview(buffer, " || ")
        emit_tokens_push_sview(buffer, "arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_nested_number > ")
        emit_tokens_push_sview(buffer, upper)
        emit_tokens_push_sview(buffer, ") { PyErr_SetString(PyExc_OverflowError, \"nested list element out of range\"); Py_DECREF(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_nested_seq);\n")
        emit_pymodule_dict_cleanup_one(buffer, target_params, parameter_index, "                    ")
        emit_tokens_push_sview(buffer, "                    return NULL; }")
    emit_tokens_push_sview(buffer, " arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_items[arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_index] = (")
    emit_tokens_push_sview(buffer, element_c_type)
    emit_tokens_push_sview(buffer, ")arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_number;\n")




# Materialize the non-plain-scalar view elements used inside a dictionary. Numeric views can use
# the compact converter above; text/object/optional views need their native aggregate layout and
# Python lifetime rules spelled out explicitly.
def emit_pymodule_dict_nested_view_special_input(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, element_name: sview, parameter_index: usize) -> void can[Abort.Panic, Memory.Allocate]:
    element_c_type: sview = pymodule_darray_c_element_type(element_name)
    emit_tokens_push_sview(buffer, "        PyObject *arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_seq = PySequence_Fast(arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_value_obj, \"expected a sequence\"); if (arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_seq == NULL) {\n")
    emit_pymodule_dict_cleanup_one(buffer, target_params, parameter_index, "            ")
    emit_tokens_push_sview(buffer, "            return NULL; } Py_ssize_t arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_len = PySequence_Fast_GET_SIZE(arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_seq); if (arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_len > PY_SSIZE_T_MAX / (Py_ssize_t)sizeof(")
    emit_tokens_push_sview(buffer, element_c_type)
    emit_tokens_push_sview(buffer, ")) { Py_DECREF(arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_seq);\n")
    emit_pymodule_dict_cleanup_one(buffer, target_params, parameter_index, "            ")
    emit_tokens_push_sview(buffer, "            PyErr_SetString(PyExc_OverflowError, \"nested view is too large\"); return NULL; } ")
    emit_tokens_push_sview(buffer, element_c_type)
    emit_tokens_push_sview(buffer, " *arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_items = NULL; if (arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_len > 0) { arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_items = (")
    emit_tokens_push_sview(buffer, element_c_type)
    emit_tokens_push_sview(buffer, " *)arena_alloc(&arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_arena, (int64_t)arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_len * (int64_t)sizeof(")
    emit_tokens_push_sview(buffer, element_c_type)
    emit_tokens_push_sview(buffer, ")); if (arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_items == NULL) { Py_DECREF(arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_seq);\n")
    emit_pymodule_dict_cleanup_one(buffer, target_params, parameter_index, "                ")
    emit_tokens_push_sview(buffer, "                PyErr_NoMemory(); return NULL; } } for (Py_ssize_t arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_index = 0; arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_index < arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_len; ++arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_index) { PyObject *arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_item = PySequence_Fast_GET_ITEM(arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_seq, arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_nested_index); ")
    if element_name == "sview" or element_name == "cstr" or element_name == "sview?" or element_name == "cstr?":
        emit_tokens_push_sview(buffer, "if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_nested_item == Py_None) {")
        if element_name == "sview?":
            emit_tokens_push_sview(buffer, " arg")
            append_decimal(buffer, parameter_index.i64())
            emit_tokens_push_sview(buffer, "_nested_items[arg")
            append_decimal(buffer, parameter_index.i64())
            emit_tokens_push_sview(buffer, "_nested_index] = (ElisaOptionalSView){false, (ElisaSView){NULL, 0}};")
        elif element_name == "cstr?":
