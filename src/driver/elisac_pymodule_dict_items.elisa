                emit_tokens_push_sview(buffer, "_nested_item_data[arg")
                append_decimal(buffer, parameter_index.i64())
                emit_tokens_push_sview(buffer, "_nul_index] == '\\0') { Py_DECREF(arg")
                append_decimal(buffer, parameter_index.i64())
                emit_tokens_push_sview(buffer, "_nested_seq);\n")
                emit_pymodule_dict_cleanup_one(buffer, target_params, parameter_index, "                        ")
                emit_tokens_push_sview(buffer, "                        PyErr_SetString(PyExc_ValueError, \"cstr view elements may not contain NUL bytes\"); return NULL; } }")
            emit_tokens_push_sview(buffer, " arg")
