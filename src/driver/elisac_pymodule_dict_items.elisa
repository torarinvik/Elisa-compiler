            if element_name == "cstr" or element_name == "cstr?":
                emit_tokens_push_sview(buffer, " for (Py_ssize_t arg")
                append_decimal(buffer, parameter_index.i64())
                emit_tokens_push_sview(buffer, "_nul_index = 0; arg")
                append_decimal(buffer, parameter_index.i64())
                emit_tokens_push_sview(buffer, "_nul_index < arg")
                append_decimal(buffer, parameter_index.i64())
