            emit_tokens_push_sview(buffer, ";") if element_name == "sview?" or element_name == "cstr?" else emit_tokens_push_sview(buffer, ";")
            emit_tokens_push_sview(buffer, " }") if element_name == "sview?" or element_name == "cstr?" else emit_tokens_push_sview(buffer, "")
    elif element_name == "py::Object" or element_name == "py::Object?":
