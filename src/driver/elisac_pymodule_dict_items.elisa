                emit_tokens_push_sview(buffer, "_nested_item_data, (int64_t)arg")
                append_decimal(buffer, parameter_index.i64())
                emit_tokens_push_sview(buffer, "_nested_item_len}}")
            else:
                emit_tokens_push_sview(buffer, "arg")
