        emit_tokens_push_sview(buffer, " } else {") if element_name == "sview?" or element_name == "cstr?" else emit_tokens_push_sview(buffer, " }")
        if element_name == "sview" or element_name == "sview?" or element_name == "cstr" or element_name == "cstr?":
