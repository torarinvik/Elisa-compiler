# `-emit fmt` — stage0's `maybeWrapFunctionBodyInAutoRegion`. A function that receives an `Arena`
# and declares a container local with no `@region` gets its body wrapped in an internal
# `__auto_N` region, so the unparser has to decide the same thing stage0 did: does this body
# allocate, and does it forward the local on. Continues emit_fmt_expr.elisa.

extend FmtUnparse:
    public:

        # stage0's `maybeWrapFunctionBodyInAutoRegion`: a function that receives an `Arena`
        # manages allocation itself and is left alone; otherwise a body declaring a
        # region-less container earns the synthesized region.
        def fmt_body_needs_auto_region(statements: darray[Ast::Stmt], line: u32, offset: u32, tokens: darray[Lexer::Token]&, source: u8&) -> bool:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                fmt_ar_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
                false return if not fmt_ar_range.found
                for fmt_ar_probe in fmt_ar_range.start..<fmt_ar_range.stop |tokens, source|:
                    if tokens[fmt_ar_probe].kind == Lexer::TokenKind.Ident:
                        false return if Lexer::text_or_empty(tokens[fmt_ar_probe], source) == "Arena"
                return fmt_declares_regionless_container(statements, tokens, true)



        # An initializer that actually ALLOCATES a backing buffer — stage0's
        # isAllocatingLiteral: a list literal or a builder comprehension (a quantifier's
        # `body` is Absent and does not allocate). Dict/set literals are deliberately NOT
        # here, matching stage0.
        def fmt_value_is_allocating_literal(value: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Array(_, _):
                        return true
                    Expr.Comprehension(_, _, _, fmt_av_body, _):
                        match fmt_av_body:
                            Expr.Absent:
                                return false
                            _:
                                return true
                    Expr.Paren(fmt_av_inner, _):
                        return fmt_value_is_allocating_literal(fmt_av_inner)
                    _:
                        return false



        # stage0's structLiteralAllocatesContainerArg: a construct whose field argument is
        # itself an allocating literal (`Index{primary: {}, overflow: []}` — the []).
        def fmt_construct_allocates_arg(value: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match value:
                    Expr.Construct(_, fmt_ca_fields, _):
                        for fmt_ca_field in fmt_ca_fields:
                            true return if fmt_value_is_allocating_literal(fmt_ca_field.value)
                    _:
                        pass
                return false



        # A body statement declaring a container local with no `@region` on its line —
        # stage0's per-statement wrap triggers (functionBodyNeedsAutoRegion's VarDecl arm
        # + bodyForwardsConstructedStructLocal). The region annotations live in a File
        # side table the decl walker does not carry, and a global `darray` side channel
        # for them bus-errors (a container value in a global is the arena-identity
        # hazard); the `@` is on the declaration LINE either way.
        #
        # PLACEMENT (MEASURED 2026-09-08, one-feature probes): a container declared DIRECTLY
        # in a for/while body wraps THAT LOOP BODY (`for d in …:` / `with arena __auto_N as :`,
        # N = the body's first statement) and not the function; one under an `if` inside the
        # loop wraps the FUNCTION; nested loops wrap the innermost; an explicit `region r(…):`
        # block is never re-wrapped. `direct` is false for a loop body's own statements —
        # those are the loop's business — and true again inside any nested `if`.
        def fmt_declares_regionless_container(statements: darray[Ast::Stmt], tokens: darray[Lexer::Token]&, direct: bool) -> bool:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                for fmt_rc_statement in statements |tokens, statements, direct|:
                    match fmt_rc_statement:
                        Stmt.VarDecl(fmt_rc_name, fmt_rc_type, fmt_rc_value, fmt_rc_line):
                            continue if not direct
                            # A set/dict LITERAL local always wraps (`s: set[i64] = {}`, `{2, 4}`,
                            # `d: dict[i64, i64] = {1: 2}` — MEASURED 2026-09-08, forwarded or not).
                            fmt_rc_set_or_dict: bool = (fmt_rc_value is Expr.SetLit(_, _)) or (fmt_rc_value is Expr.DictLit(_, _))
                            if emit_ast_expr_head_is_container(fmt_rc_type) and (fmt_value_is_allocating_literal(fmt_rc_value) or fmt_rc_set_or_dict):
                                # A container REFERENCE binding (`h: darray[u32]& = f(s)`)
                                # allocates nothing — stage0 does not wrap for it. The `&`
                                # lives in the line's type span, not the head expr.
                                if not fmt_line_type_is_reference(tokens, fmt_rc_line.line):
                                    true return if not fmt_line_has_region_marker(tokens, fmt_rc_line.line)
                            # A construct with an allocating-literal field arg allocates that
                            # field region-lessly (`t: mutable Index = Index{overflow: []}`).
                            true return if fmt_construct_allocates_arg(fmt_rc_value)
                            # A struct-CONSTRUCTED local later forwarded to a call has its
                            # container fields grown interprocedurally — stage0's
                            # bodyForwardsConstructedStructLocal (top-level approximation).
                            match fmt_rc_value:
                                Expr.Construct(_, _, _):
                                    true return if fmt_body_forwards_local(statements, fmt_rc_name)
                                Expr.Call(fmt_rc_callee, _, _, _):
                                    # A call to a CAPITALISED name (`ok: bool = VirtualFreeEx(…)`) is
                                    # a constructor to stage0's rule too -- MEASURED 2026-09-08: every
                                    # capitalised callee wraps once the local is forwarded, no
                                    # lower-case one does. That is the whole reason free_region wraps.
                                    if fmt_rc_callee is Expr.Ident(fmt_rc_callee_name, _):
                                        if fmt_ident_is_capitalized(fmt_rc_callee_name):
                                            true return if fmt_body_forwards_local(statements, fmt_rc_name)
                                    # A module-qualified constructor (`w: M::W = M::W(4)` then
                                    # `M::bump(&w, 2)`) is the same rule on the LAST segment.
                                    if fmt_rc_callee is Expr.Scope(_, fmt_rc_scope_name, _):
                                        if fmt_ident_is_capitalized(fmt_rc_scope_name):
                                            true return if fmt_body_forwards_local(statements, fmt_rc_name)
                                    if fmt_rc_callee is Expr.Field(_, fmt_rc_field_name, _):
                                        if fmt_ident_is_capitalized(fmt_rc_field_name):
                                            true return if fmt_body_forwards_local(statements, fmt_rc_name)
                                _:
                                    pass
                        Stmt.If(_, fmt_rc_then, fmt_rc_else, _):
                            true return if fmt_declares_regionless_container(fmt_rc_then, tokens, true)
                            true return if fmt_declares_regionless_container(fmt_rc_else, tokens, true)
                        Stmt.While(_, fmt_rc_wbody, _):
                            true return if fmt_declares_regionless_container(fmt_rc_wbody, tokens, false)
                        Stmt.For(_, _, _, fmt_rc_fbody, _):
                            true return if fmt_declares_regionless_container(fmt_rc_fbody, tokens, false)
                        Stmt.Block(fmt_rc_bkind, _, _, fmt_rc_bbody, _):
                            continue if fmt_rc_bkind == "region"
                            true return if fmt_declares_regionless_container(fmt_rc_bbody, tokens, direct)
                        _:
                            pass
                return false



        # A LOOP BODY wraps itself when one of its own statements (through a non-region
        # block, not through an `if`) declares a region-less container; see the placement
        # note on fmt_declares_regionless_container.
        def fmt_loop_body_needs_auto_region(body: darray[Ast::Stmt], tokens: darray[Lexer::Token]&) -> bool:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                for fmt_lb_statement in body |tokens, body|:
                    match fmt_lb_statement:
                        Stmt.VarDecl(_, _, _, _):
                            fmt_lb_one: darray[Ast::Stmt] = [fmt_lb_statement]
                            # forwarding is judged against the whole body, so re-check with it
                            true return if fmt_declares_regionless_container(fmt_lb_one, tokens, true) or fmt_loop_vardecl_forwarded(fmt_lb_statement, body, tokens)
                        Stmt.Block(fmt_lb_kind, _, _, fmt_lb_body, _):
                            continue if fmt_lb_kind == "region"
                            true return if fmt_loop_body_needs_auto_region(fmt_lb_body, tokens)
                        _:
                            pass
                return false

        # The constructed-local-forwarded half of the VarDecl rule, judged against BODY.
        def fmt_loop_vardecl_forwarded(statement: Ast::Stmt, body: darray[Ast::Stmt], tokens: darray[Lexer::Token]&) -> bool:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                if statement is Stmt.VarDecl(fmt_lv_name, _, fmt_lv_value, _):
                    match fmt_lv_value:
                        Expr.Construct(_, _, _):
                            return fmt_body_forwards_local(body, fmt_lv_name)
                        Expr.Call(fmt_lv_callee, _, _, _):
                            if fmt_lv_callee is Expr.Ident(fmt_lv_n, _):
                                return fmt_body_forwards_local(body, fmt_lv_name) if fmt_ident_is_capitalized(fmt_lv_n) else false
                            if fmt_lv_callee is Expr.Scope(_, fmt_lv_s, _):
                                return fmt_body_forwards_local(body, fmt_lv_name) if fmt_ident_is_capitalized(fmt_lv_s) else false
                            if fmt_lv_callee is Expr.Field(_, fmt_lv_f, _):
                                return fmt_body_forwards_local(body, fmt_lv_name) if fmt_ident_is_capitalized(fmt_lv_f) else false
                        _:
                            pass
                return false

        # Print BODY as a loop body, wrapped in stage0's per-iteration region when it needs one.
        def fmt_loop_body(buffer: mutable darray[u8]&, body: darray[Ast::Stmt], indent: i64, tokens: darray[Lexer::Token]&, source: u8&) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                if body.count > 0 and fmt_loop_body_needs_auto_region(body, tokens):
                    fmt_indent(buffer, indent)
                    fmt_push(buffer, "with arena __auto_")
                    fmt_push_decimal(buffer, fmt_auto_region_number(fmt_stmt_source_line(body[0]), fmt_stmt_source_offset(body[0]), tokens))
                    fmt_push(buffer, " as :\n")
                    fmt_stmts(buffer, body, indent + 4, tokens, source)
                    return
                fmt_stmts(buffer, body, indent, tokens, source)

        # Does any statement in the list pass NAME (bare or by `&`) as a call argument?
        def fmt_body_forwards_local(statements: darray[Ast::Stmt], name: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                for fmt_fw_statement in statements |name|:
                    match fmt_fw_statement:
                        Stmt.Expr(fmt_fw_expression, _):
                            true return if fmt_expr_forwards_name(fmt_fw_expression, name)
                        Stmt.Return(fmt_fw_value, _):
                            if fmt_fw_value is fmt_fw_returned:
                                true return if fmt_expr_forwards_name(fmt_fw_returned, name)
                        Stmt.VarDecl(_, _, fmt_fw_v, _):
                            true return if fmt_expr_forwards_name(fmt_fw_v, name)
                        Stmt.Assign(_, _, fmt_fw_av, _):
                            true return if fmt_expr_forwards_name(fmt_fw_av, name)
                        Stmt.Contract(fmt_fw_kind, fmt_fw_ce, _):
                            # `assert ok` is the call `assert(ok)` to stage0: a bare NAME forwards.
                            if fmt_fw_kind == "assert":
                                if fmt_fw_ce is Expr.Ident(fmt_fw_assert_name, _):
                                    true return if fmt_fw_assert_name == name
                        _:
                            pass
                return false

        def fmt_ident_is_capitalized(name: sview) -> bool:
            can Abort.Panic:
                false return if sview_len(name) == 0
                head: u8 = sview_at(name, 0)
                return head >= 65 and head <= 90

        # `can` at token INDEX is a GRANT only when an EFFECT follows: a capitalised name
        # (`can Memory.Allocate`, `can Unsafe.UncheckedIndex`). The contextual IDENTIFIER
        # `can` (`sink(can)`, `can <- can + 1`) is followed by anything else, and a `can[`
        # at depth 0 is a type's effect row. MEASURED 2026-09-08 on contextual_keyword_names:
        # the token scans rendered `sink(can can)` and doubled the assignment.
        def fmt_can_is_grant(tokens: darray[Lexer::Token]&, source: u8&, index: usize) -> bool:
            can Abort.Panic:
                false return if index + 1 >= tokens.count
                false return if tokens[index + 1].kind != Lexer::TokenKind.Ident
                return fmt_ident_is_capitalized(Lexer::text_or_empty(tokens[index + 1], source))



        def fmt_expr_forwards_name(expression: Ast::Expr, name: sview) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Call(_, fmt_fn_args, _, _):
                        for fmt_fn_argument in fmt_fn_args |name|:
                            fmt_fn_inner: mutable Ast::Expr = fmt_fn_argument
                            match fmt_fn_argument:
                                Expr.Unary(fmt_fn_op, fmt_fn_operand, _):
                                    fmt_fn_inner <- fmt_fn_operand if fmt_fn_op == Lexer::TokenKind.Ampersand
                                _:
                                    pass
                            match fmt_fn_inner:
                                Expr.Ident(fmt_fn_in, _):
                                    true return if fmt_fn_in == name
                                Expr.Call(_, _, _, _) | Expr.Paren(_, _):
                                    # `add(sum(v), 1)` forwards v (MEASURED 2026-09-08).
                                    true return if fmt_expr_forwards_name(fmt_fn_inner, name)
                                _:
                                    pass
                    Expr.Paren(fmt_fn_paren_inner, _):
                        return fmt_expr_forwards_name(fmt_fn_paren_inner, name)
                    _:
                        pass
                return false



        # The declaration line's TYPE span (first depth-0 `:` to the depth-0 `=`, or line
        # end) contains an `&` — a reference annotation, so the local borrows rather than
        # allocates.
        def fmt_line_type_is_reference(tokens: darray[Lexer::Token]&, line: u32) -> bool:
            can Abort.Panic:
                fmt_tr_found: mutable bool = false
                fmt_tr_in_type: mutable bool = false
                fmt_tr_done: mutable bool = false
                fmt_tr_depth: mutable i64 = 0
                for fmt_tr_probe in 0..<tokens.count |fmt_tr_found, fmt_tr_in_type, fmt_tr_done, fmt_tr_depth, tokens, line|:
                    continue if fmt_tr_done
                    continue if tokens[fmt_tr_probe].line != line
                    fmt_tr_kind: Lexer::TokenKind = tokens[fmt_tr_probe].kind
                    fmt_tr_depth <- fmt_tr_depth + 1 if fmt_tr_kind == Lexer::TokenKind.LParen or fmt_tr_kind == Lexer::TokenKind.LBracket
                    fmt_tr_depth <- fmt_tr_depth - 1 if fmt_tr_kind == Lexer::TokenKind.RParen or fmt_tr_kind == Lexer::TokenKind.RBracket
                    if fmt_tr_in_type and fmt_tr_depth == 0 and (fmt_tr_kind == Lexer::TokenKind.Assign or fmt_tr_kind == Lexer::TokenKind.Newline):
                        fmt_tr_done <- true
                    elif fmt_tr_in_type and fmt_tr_depth == 0 and fmt_tr_kind == Lexer::TokenKind.Ampersand:
                        fmt_tr_found <- true
                    elif not fmt_tr_in_type and fmt_tr_depth == 0 and fmt_tr_kind == Lexer::TokenKind.Colon:
                        fmt_tr_in_type <- true
                return fmt_tr_found



        def fmt_line_has_region_marker(tokens: darray[Lexer::Token]&, line: u32) -> bool:
            can Abort.Panic:
                fmt_rm_found: mutable bool = false
                for fmt_rm_probe in 0..<tokens.count |fmt_rm_found, tokens, line|:
                    continue if tokens[fmt_rm_probe].line != line
                    fmt_rm_found <- true if tokens[fmt_rm_probe].kind == Lexer::TokenKind.At
                return fmt_rm_found



        # Does the `using` row precede the declaration? By BYTE OFFSET when both are known —
        # the order that survives `#line` renumbering — else by line, as before.
        def fmt_using_precedes(using_line: u32, using_offset: u32, decl_line: u32, decl_offset: u32) -> bool:
            can Abort.Panic:
                return using_offset < decl_offset if using_offset != 0 and decl_offset != 0 else using_line < decl_line



        def fmt_auto_region_number(line: u32, offset: u32, tokens: darray[Lexer::Token]&) -> i64:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                fmt_an_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
                0 return if not fmt_an_range.found
                # stage0 prints `with arena __auto_<N> as :` with N = the `def` token's
                # pos.Offset in its directive-bearing expansion — which is this buffer.
                return tokens[fmt_an_range.start].start.i64()
