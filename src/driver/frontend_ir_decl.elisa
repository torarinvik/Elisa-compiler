# `.elisair` v2 — DECLARATION nodes: functions and their parameters, struct fields, enum variants,
# const members and the annotations any of them carry. Continues frontend_ir_write.elisa.

include "./frontend_ir_decl_policy.elisa"

extend IrWrite:
    private:

        def ir_annotation_out(payload: mutable darray[u8]&, annotation: Ast::Annotation, annotation_args: darray[sview]&, filename: sview, refusal: mutable darray[u8]&) -> void:
            can Memory.Allocate, Abort.Panic:
                start: usize = annotation.arg_start.usize()
                count: usize = annotation.arg_count.usize()
                if start + count > annotation_args.count:
                    ir_refuse(refusal, "extern decorator arguments")
                    return
                args_payload: mutable darray[u8] = []
                if count != 0:
                    ir_uvarint_out(&args_payload, count.u64())
                    for argument_index in 0..<count |args_payload, annotation_args, start|:
                        ir_str_out(&args_payload, annotation_args[start + argument_index])
                decorator_pos: Ast::Pos = Ast::Pos{
                    line: annotation.line,
                    column: annotation.column,
                    offset: 0,
                    end_line: annotation.line,
                    end_column: annotation.column + sview_len(annotation.name).u32(),
                    end_offset: 0
                }
                fields: mutable darray[u8] = []
                live: mutable u32 = 0
                ir_put_raw(&fields, &live, 1, args_payload)
                ir_put_str(&fields, &live, 2, annotation.name)
                ir_put_pos(&fields, &live, 3, decorator_pos, filename)
                ir_uvarint_out(payload, 7)
                ir_uvarint_out(payload, live.u64())
                payload.extend([byte for byte in fields])



        # ---- declarations -------------------------------------------------------

        # `ParamDecl` is an inline struct, not a node: type ID then fields.
        def ir_param_out(payload: mutable darray[u8]&, bodies: mutable darray[u8]&, nodes: mutable u32&, refusal: mutable darray[u8]&, parameter: Ast::ParamDecl&, filename: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                declared_type_id: u32 = ir_type_node(bodies, nodes, refusal, parameter.type_expression, filename)
                # `T!` is a ref carrying the AFFINE typestate in stage0, not a bare `T`.
                type_id: mutable u32 = declared_type_id
                if parameter.is_affine and declared_type_id != 0:
                    affine_fields: mutable darray[u8] = []
                    affine_live: mutable u32 = 0
                    ir_put_node(&affine_fields, &affine_live, 1, declared_type_id)
                    ir_put_int(&affine_fields, &affine_live, 5, 2)
                    type_id <- ir_emit_node(bodies, nodes, 220, affine_fields, affine_live)
                default_id: mutable u32 = 0
                if parameter.has_default:
                    default_id <- ir_expr_node(bodies, nodes, refusal, parameter.default_value, filename)
                fields: mutable darray[u8] = []
                live: mutable u32 = 0
                ir_put_node(&fields, &live, 1, default_id)
                ir_put_bool(&fields, &live, 2, parameter.is_mutable)
                ir_put_str(&fields, &live, 3, parameter.name)
                ir_put_node(&fields, &live, 5, type_id)
                ir_uvarint_out(payload, 204)
                ir_uvarint_out(payload, live.u64())
                payload.extend([byte for byte in fields])



        def ir_decl_node(bodies: mutable darray[u8]&, nodes: mutable u32&, refusal: mutable darray[u8]&, declaration: Ast::Decl, extern_params: darray[Ast::ExternParam]&, annotations: darray[Ast::EnumAnnotation]&, annotation_args: darray[sview]&, source: sview, filename: sview) -> u32:
            can Memory.Allocate, Abort.Panic:
                fields: mutable darray[u8] = []
                live: mutable u32 = 0
                match declaration:
                    Ast::Decl.Func(name, params, return_type, body, effects, decorators, func_pos):
                        # stage0's PARSER wraps a body that allocates region-lessly in a
                        # synthesized `__auto_<offset>` region, and its bundle carries that
                        # wrap because `-emit ir` writes the post-parse, post-analysis tree.
                        # stage1's parser does no such wrap, so the two trees describe
                        # different programs. Detected conservatively — a container local
                        # anywhere in the body — and REFUSED, because the alternative is a
                        # bundle that decodes cleanly and unparses a different function.
                        if FrontendIrDeclPolicy::function_requires_refusal(ir_body_allocates_regionlessly(body)):
                            ir_refuse(refusal, "function body needing stage0's synthesized auto-region")
                            return 0
                        params_payload: mutable darray[u8] = []
                        if params.count != 0:
                            ir_uvarint_out(&params_payload, params.count.u64())
                            for parameter_index in 0..<params.count |bodies, nodes, refusal, params_payload|:
                                ir_param_out(&params_payload, bodies, nodes, refusal, &params[parameter_index], filename)
                        return_type_id: mutable u32 = 0
                        if return_type is declared_return_type:
                            return_type_id <- ir_type_node(bodies, nodes, refusal, declared_return_type, filename)
                        body_ids: mutable darray[u32] = []
                        for statement in body |bodies, nodes, refusal, body_ids|:
                            body_ids.push(ir_stmt_node(bodies, nodes, refusal, statement, filename))
                        ir_put_node_list(&fields, &live, FrontendIrDeclarationNodeTags::FUNC_DECL_BODY_FIELD_ID, body_ids)
                        ir_put_str(&fields, &live, FrontendIrDeclarationNodeTags::FUNC_DECL_NAME_FIELD_ID, name)
                        ir_put_raw(&fields, &live, FrontendIrDeclarationNodeTags::FUNC_DECL_PARAMS_FIELD_ID, params_payload)
                        ir_put_pos(&fields, &live, FrontendIrDeclarationNodeTags::FUNC_DECL_POSITION_FIELD_ID, func_pos, filename)
                        ir_put_node(&fields, &live, FrontendIrDeclarationNodeTags::FUNC_DECL_RETURN_TYPE_FIELD_ID, return_type_id)
                        return ir_emit_node(bodies, nodes, FrontendIrDeclarationNodeTags::node_tag(FrontendIrDeclarationNodeTags::NodeKind.FuncDecl), fields, live)
                    Ast::Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, struct_pos):
                        if FrontendIrDeclPolicy::struct_requires_refusal(has_named_states, has_derive):
                            ir_refuse(refusal, "typestate struct")
                            return 0
                        members_payload: mutable darray[u8] = []
                        if members.count != 0:
                            ir_uvarint_out(&members_payload, members.count.u64())
                            for member_index in 0..<members.count |bodies, nodes, refusal, members_payload|:
                                ir_field_decl_out(&members_payload, bodies, nodes, refusal, &members[member_index], filename)
                        invariant_ids: mutable darray[u32] = []
                        for invariant in invariants |bodies, nodes, refusal, invariant_ids|:
                            invariant_ids.push(ir_expr_node(bodies, nodes, refusal, invariant, filename))
                        ir_put_bool(&fields, &live, FrontendIrDeclarationNodeTags::STRUCT_DECL_AFFINITY_FIELD_ID, affinity == "affine" or affinity == "linear")
                        ir_put_raw(&fields, &live, FrontendIrDeclarationNodeTags::STRUCT_DECL_FIELDS_FIELD_ID, members_payload)
                        ir_put_node_list(&fields, &live, FrontendIrDeclarationNodeTags::STRUCT_DECL_INVARIANTS_FIELD_ID, invariant_ids)
                        ir_put_str(&fields, &live, FrontendIrDeclarationNodeTags::STRUCT_DECL_NAME_FIELD_ID, name)
                        ir_put_pos(&fields, &live, FrontendIrDeclarationNodeTags::STRUCT_DECL_POSITION_FIELD_ID, struct_pos, filename)
                        return ir_emit_node(bodies, nodes, FrontendIrDeclarationNodeTags::node_tag(FrontendIrDeclarationNodeTags::NodeKind.StructDecl), fields, live)
                    Ast::Decl.Enum(name, variants, is_const, storage_type, enum_pos):
                        if is_const:
                            members_payload: mutable darray[u8] = []
                            if variants.count != 0:
                                ir_uvarint_out(&members_payload, variants.count.u64())
                                for variant_index in 0..<variants.count |bodies, nodes, refusal, members_payload|:
                                    ir_const_member_out(&members_payload, bodies, nodes, refusal, &variants[variant_index], filename)
                            storage_id: u32 = ir_type_node(bodies, nodes, refusal, storage_type, filename)
                            ir_put_raw(&fields, &live, FrontendIrDeclarationNodeTags::CONST_ENUM_DECL_MEMBERS_FIELD_ID, members_payload)
                            ir_put_str(&fields, &live, FrontendIrDeclarationNodeTags::CONST_ENUM_DECL_NAME_FIELD_ID, name)
                            ir_put_pos(&fields, &live, FrontendIrDeclarationNodeTags::CONST_ENUM_DECL_POSITION_FIELD_ID, enum_pos, filename)
                            ir_put_node(&fields, &live, FrontendIrDeclarationNodeTags::CONST_ENUM_DECL_STORAGE_FIELD_ID, storage_id)
                            return ir_emit_node(bodies, nodes, FrontendIrDeclarationNodeTags::node_tag(FrontendIrDeclarationNodeTags::NodeKind.ConstEnumDecl), fields, live)
                        variants_payload: mutable darray[u8] = []
                        if variants.count != 0:
                            ir_uvarint_out(&variants_payload, variants.count.u64())
                            for variant_index in 0..<variants.count |bodies, nodes, refusal, variants_payload|:
                                ir_variant_out(&variants_payload, bodies, nodes, refusal, &variants[variant_index], filename)
                        ir_put_str(&fields, &live, FrontendIrDeclarationNodeTags::ENUM_DECL_NAME_FIELD_ID, name)
                        ir_put_pos(&fields, &live, FrontendIrDeclarationNodeTags::ENUM_DECL_POSITION_FIELD_ID, enum_pos, filename)
                        ir_put_raw(&fields, &live, FrontendIrDeclarationNodeTags::ENUM_DECL_VARIANTS_FIELD_ID, variants_payload)
                        return ir_emit_node(bodies, nodes, FrontendIrDeclarationNodeTags::node_tag(FrontendIrDeclarationNodeTags::NodeKind.EnumDecl), fields, live)
                    Ast::Decl.Alias(name, target, alias_pos):
                        target_id: u32 = ir_type_node(bodies, nodes, refusal, target, filename)
                        ir_put_str(&fields, &live, FrontendIrDeclarationNodeTags::TYPE_ALIAS_DECL_NAME_FIELD_ID, name)
                        ir_put_pos(&fields, &live, FrontendIrDeclarationNodeTags::TYPE_ALIAS_DECL_POSITION_FIELD_ID, alias_pos, filename)
                        ir_put_node(&fields, &live, FrontendIrDeclarationNodeTags::TYPE_ALIAS_DECL_TARGET_FIELD_ID, target_id)
                        return ir_emit_node(bodies, nodes, FrontendIrDeclarationNodeTags::node_tag(FrontendIrDeclarationNodeTags::NodeKind.TypeAliasDecl), fields, live)
                    Ast::Decl.Import(module, import_pos):
                        ir_put_str(&fields, &live, FrontendIrDeclarationNodeTags::IMPORT_DECL_MODULE_FIELD_ID, module)
                        ir_put_pos(&fields, &live, FrontendIrDeclarationNodeTags::IMPORT_DECL_POSITION_FIELD_ID, import_pos, filename)
                        return ir_emit_node(bodies, nodes, FrontendIrDeclarationNodeTags::node_tag(FrontendIrDeclarationNodeTags::NodeKind.ImportDecl), fields, live)
                    Ast::Decl.Module(name, body, module_pos):
                        # stage0 spells a nested namespace `Outer.Inner`, not `Outer::Inner`.
                        dotted_module: mutable darray[u8] = []
                        skip_next_colon: mutable bool = false
                        for index in 0..<sview_len(name).i64() |dotted_module, name, skip_next_colon|:
                            if skip_next_colon:
                                skip_next_colon <- false
                                continue
                            if sview_at(name, index) == 58 and index + 1 < sview_len(name).i64() and sview_at(name, index + 1) == 58:
                                dotted_module.push(46)
                                skip_next_colon <- true
                                continue
                            dotted_module.push(sview_at(name, index))
                        member_ids: mutable darray[u32] = []
                        for member in body |bodies, nodes, refusal, member_ids|:
                            member_ids.push(ir_decl_node(bodies, nodes, refusal, member, extern_params, annotations, annotation_args, source, filename))
                        ir_put_node_list(&fields, &live, FrontendIrDeclarationNodeTags::NAMESPACE_DECL_DECLS_FIELD_ID, member_ids)
                        ir_put_bool(&fields, &live, FrontendIrDeclarationNodeTags::NAMESPACE_DECL_MODULE_FIELD_ID, true)
                        ir_put_str(&fields, &live, FrontendIrDeclarationNodeTags::NAMESPACE_DECL_NAME_FIELD_ID, bytes_view_range(dotted_module, 0, dotted_module.count))
                        ir_put_pos(&fields, &live, FrontendIrDeclarationNodeTags::NAMESPACE_DECL_POSITION_FIELD_ID, module_pos, filename)
                        return ir_emit_node(bodies, nodes, FrontendIrDeclarationNodeTags::node_tag(FrontendIrDeclarationNodeTags::NodeKind.NamespaceDecl), fields, live)
                    Ast::Decl.Const(name, type_expression, value, is_mutable, const_pos):
                        type_id: u32 = ir_type_node(bodies, nodes, refusal, type_expression, filename)
                        value_id: u32 = ir_expr_node(bodies, nodes, refusal, value, filename)
                        if is_mutable:
                            ir_put_bool(&fields, &live, FrontendIrDeclarationNodeTags::GLOBAL_DECL_MUTABLE_FIELD_ID, true)
                            ir_put_str(&fields, &live, FrontendIrDeclarationNodeTags::GLOBAL_DECL_NAME_FIELD_ID, name)
                            ir_put_pos(&fields, &live, FrontendIrDeclarationNodeTags::GLOBAL_DECL_POSITION_FIELD_ID, const_pos, filename)
                            ir_put_node(&fields, &live, FrontendIrDeclarationNodeTags::GLOBAL_DECL_TYPE_FIELD_ID, type_id)
                            ir_put_node(&fields, &live, FrontendIrDeclarationNodeTags::GLOBAL_DECL_VALUE_FIELD_ID, value_id)
                            return ir_emit_node(bodies, nodes, FrontendIrDeclarationNodeTags::node_tag(FrontendIrDeclarationNodeTags::NodeKind.GlobalDecl), fields, live)
                        ir_put_str(&fields, &live, FrontendIrDeclarationNodeTags::CONST_DECL_NAME_FIELD_ID, name)
                        ir_put_pos(&fields, &live, FrontendIrDeclarationNodeTags::CONST_DECL_POSITION_FIELD_ID, const_pos, filename)
                        ir_put_node(&fields, &live, FrontendIrDeclarationNodeTags::CONST_DECL_TYPE_FIELD_ID, type_id)
                        ir_put_node(&fields, &live, FrontendIrDeclarationNodeTags::CONST_DECL_VALUE_FIELD_ID, value_id)
                        return ir_emit_node(bodies, nodes, FrontendIrDeclarationNodeTags::node_tag(FrontendIrDeclarationNodeTags::NodeKind.ConstDecl), fields, live)
                    Ast::Decl.Extern(_, _, _, _, _, _, _, _):
                        return ir_extern_decl_node(bodies, nodes, refusal, declaration, extern_params, annotations, annotation_args, source, filename)
                    # An `impl` body and a `static if` branch are the SAME stage1 node, so
                    # neither can be recovered from it.
                    Ast::Decl.Scoped(_, _):
                        if FrontendIrDeclPolicy::scoped_declaration_requires_refusal():
                            ir_refuse(refusal, "impl / static-if scope (one node in stage1)")
                            return 0
                    _:
                        ir_refuse(refusal, "declaration")
                        return 0



        def ir_field_decl_out(payload: mutable darray[u8]&, bodies: mutable darray[u8]&, nodes: mutable u32&, refusal: mutable darray[u8]&, member: Ast::StructMember&, filename: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                type_id: u32 = ir_type_node(bodies, nodes, refusal, ir_strip_mutable(member.type_expression), filename)
                default_id: mutable u32 = 0
                if member.has_default:
                    default_id <- ir_expr_node(bodies, nodes, refusal, member.default_value, filename)
                fields: mutable darray[u8] = []
                live: mutable u32 = 0
                ir_put_node(&fields, &live, 3, default_id)
                ir_put_bool(&fields, &live, 4, member.is_ghost)
                ir_put_bool(&fields, &live, 6, ir_type_is_mutable(member.type_expression))
                ir_put_str(&fields, &live, 7, member.name)
                ir_put_node(&fields, &live, 9, type_id)
                ir_uvarint_out(payload, 64)
                ir_uvarint_out(payload, live.u64())
                payload.extend([byte for byte in fields])



        def ir_variant_out(payload: mutable darray[u8]&, bodies: mutable darray[u8]&, nodes: mutable u32&, refusal: mutable darray[u8]&, variant: Ast::EnumVariant&, filename: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                fields: mutable darray[u8] = []
                live: mutable u32 = 0
                ir_put_str(&fields, &live, 1, variant.name)
                payload_fields: mutable darray[u8] = []
                if variant.fields.count != 0:
                    ir_uvarint_out(&payload_fields, variant.fields.count.u64())
                    for field_index in 0..<variant.fields.count |bodies, nodes, refusal, payload_fields|:
                        type_id: u32 = ir_type_node(bodies, nodes, refusal, variant.fields[field_index], filename)
                        one: mutable darray[u8] = []
                        one_live: mutable u32 = 0
                        ir_put_str(&one, &one_live, 1, variant.field_names[field_index]) if field_index < variant.field_names.count
                        ir_put_node(&one, &one_live, 4, type_id)
                        ir_uvarint_out(&payload_fields, 48)
                        ir_uvarint_out(&payload_fields, one_live.u64())
                        for byte in one |payload_fields|:
                            payload_fields.push(byte)
                ir_put_raw(&fields, &live, 2, payload_fields)
                ir_uvarint_out(payload, 49)
                ir_uvarint_out(payload, live.u64())
                payload.extend([byte for byte in fields])



        def ir_const_member_out(payload: mutable darray[u8]&, bodies: mutable darray[u8]&, nodes: mutable u32&, refusal: mutable darray[u8]&, variant: Ast::EnumVariant&, filename: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                value_id: u32 = ir_expr_node(bodies, nodes, refusal, variant.value_expr, filename)
                fields: mutable darray[u8] = []
                live: mutable u32 = 0
                ir_put_str(&fields, &live, 1, variant.name)
                ir_put_node(&fields, &live, 3, value_id)
                ir_uvarint_out(payload, 33)
                ir_uvarint_out(payload, live.u64())
                payload.extend([byte for byte in fields])
