# `-emit pymodule-so` — the LINK half: the two object audits, the toolchain invocation, and
# the `.pyi` sidecar. Continues emit_pymodule_so.elisa.
#
# Both audits are SKIPPED when the host has no llvm-nm/llvm-objcopy rather than failing:
# they turn two link-time or import-time surprises into named errors, but neither is
# required to produce a working extension, and the wrapper behaved the same way.

# stage1's backend can DECLINE an unsupported body. On Darwin the bundle linker permits
# unresolved symbols for Python's C API, so a declined wrapper would survive all the way to
# `import module` as an opaque dynamic-loader error. Check every exported name against the
# object's symbol table first and name the one that is missing.
def pymodule_so_audit_symbols(nm_tool: darray[u8]&, object_path: darray[u8]&, work: darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    exports_path: mutable darray[u8] = []
    pymodule_so_join(&exports_path, work, "exports.txt")
    exports_terminated: mutable darray[u8] = [entry for entry in exports_path]
    exports_terminated.push(0)
    exports_cstr: cstr = (&exports_terminated[0]).cast[cstr] can Unsafe.PointerCast
    exports: darray[u8] = read_file(exports_cstr)
    0 return if exports.count == 0

    command: mutable darray[u8] = []
    carchive_push_quoted(&command, nm_tool)
    emit_tokens_push_sview(&command, " -g ")
    carchive_push_quoted(&command, object_path)
    symbols: mutable darray[u8] = []
    0 return if not pymodule_so_capture(command, work, &symbols)

    missing: mutable darray[u8] = []
    start: mutable usize = 0.usize()
    while start < exports.count |start, missing, exports, symbols|:
        stop: usize = pymodule_so_line_stop(exports, start)
        if stop > start:
            wanted: mutable darray[u8] = []
            for index in start..<stop |wanted, exports|:
                wanted.push(exports[index])
            if not pymodule_so_symbol_present(symbols, wanted):
                emit_tokens_push_sview(&missing, "error: native pymodule symbol missing from object: ")
                for index in 0..<wanted.count |missing, wanted|:
                    missing.push(wanted[index])
                emit_tokens_push_sview(&missing, "\n")
        start <- stop + 1.usize()
    0 return if missing.count == 0
    write_stderr(missing)
    return 1




# Is `wanted` one of the whitespace-separated words in `symbols`, ignoring a leading `_`
# (Darwin's underscore prefix)? Compared word by word so a longer name that merely CONTAINS
# the wanted one does not satisfy it.
def pymodule_so_symbol_present(symbols: darray[u8]&, wanted: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
    start: mutable usize = 0.usize()
    while start < symbols.count |start, symbols, wanted|:
        while start < symbols.count and pymodule_so_is_space(symbols[start]) |start, symbols|:
            start <- start + 1.usize()
        break if start >= symbols.count
        stop: mutable usize = start
        while stop < symbols.count and not pymodule_so_is_space(symbols[stop]) |stop, symbols|:
            stop <- stop + 1.usize()
        word_start: usize = start + 1.usize() if symbols[start] == 95 else start
        true return if pymodule_so_word_equals(symbols, word_start, stop, wanted)
        start <- stop
    return false




def pymodule_so_is_space(byte: u8) -> bool can[Abort.Panic]:
    return byte == 32 or byte == 9 or byte == 10 or byte == 13




def pymodule_so_word_equals(text: darray[u8]&, start: usize, stop: usize, wanted: darray[u8]&) -> bool can[Abort.Panic]:
    false return if stop - start != wanted.count
    for index in 0..<wanted.count |text, wanted, start|:
        false return if text[start + index] != wanted[index]
    return true




# A pymodule object links together with the COMPLETE runtime. User functions are reached
# through their generated `elisa_pymodule_*` wrappers, so any same-named definition already
# in the runtime must stay local to the module object — a common name like `fail` otherwise
# fails the link before Python can import anything. Localizing exactly the intersection
# preserves every public wrapper.
def pymodule_so_localize(nm_tool: darray[u8]&, objcopy_tool: darray[u8]&, object_path: darray[u8]&, runtime_object: darray[u8]&, work: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    module_defined: mutable darray[u8] = []
    module_command: mutable darray[u8] = []
    carchive_push_quoted(&module_command, nm_tool)
    emit_tokens_push_sview(&module_command, " --defined-only -g --format=posix ")
    carchive_push_quoted(&module_command, object_path)
    emit_tokens_push_sview(&module_command, " | awk '{print $1}' | sort -u")
    return if not pymodule_so_capture(module_command, work, &module_defined)
    runtime_defined: mutable darray[u8] = []
    runtime_command: mutable darray[u8] = []
    carchive_push_quoted(&runtime_command, nm_tool)
    emit_tokens_push_sview(&runtime_command, " --defined-only -g --format=posix ")
    carchive_push_quoted(&runtime_command, runtime_object)
    emit_tokens_push_sview(&runtime_command, " | awk '{print $1}' | sort -u")
    return if not pymodule_so_capture(runtime_command, work, &runtime_defined)

    shared: mutable darray[u8] = []
    start: mutable usize = 0.usize()
    while start < module_defined.count |start, shared, module_defined, runtime_defined|:
        stop: usize = pymodule_so_line_stop(module_defined, start)
        if stop > start and pymodule_so_line_present(runtime_defined, module_defined, start, stop):
            for index in start..<stop |shared, module_defined|:
                shared.push(module_defined[index])
            shared.push(10)
        start <- stop + 1.usize()
    return if shared.count == 0

    list_path: mutable darray[u8] = []
    pymodule_so_join(&list_path, work, "localize-symbols.txt")
    return if not write_file_bytes(list_path, shared)
    command: mutable darray[u8] = []
    carchive_push_quoted(&command, objcopy_tool)
    emit_tokens_push_sview(&command, " --localize-symbols=")
    carchive_push_quoted(&command, list_path)
    command.push(32)
    carchive_push_quoted(&command, object_path)
    _ = wasm_run(command, "llvm-objcopy")




# Is the line `text[start ..< stop)` one of the lines of `haystack`?
def pymodule_so_line_present(haystack: darray[u8]&, text: darray[u8]&, start: usize, stop: usize) -> bool can[Abort.Panic]:
    cursor: mutable usize = 0.usize()
    while cursor < haystack.count |cursor, haystack, text, start, stop|:
        line_stop: usize = pymodule_so_line_stop(haystack, cursor)
        if line_stop - cursor == stop - start:
            same: mutable bool = true
            for index in 0..<(stop - start) |same, haystack, text, cursor, start|:
                same <- false if haystack[cursor + index] != text[start + index]
            true return if same
        cursor <- line_stop + 1.usize()
    return false




# The runtime deliberately leaves the host callback hooks unresolved — true for a prebuilt
# runtime object as well as an auto-built one. Supplying the documented fallbacks whenever
# those imports are present is what keeps `import demo` from failing on
# `_elisa_native_callback_call_i32_voidp`, which is unrelated to anything the module exports.
def pymodule_so_needs_callback_fallback(nm_tool: darray[u8]&, runtime_object: darray[u8]&, work: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    false return if nm_tool.count == 0
    command: mutable darray[u8] = []
    carchive_push_quoted(&command, nm_tool)
    emit_tokens_push_sview(&command, " -u ")
    carchive_push_quoted(&command, runtime_object)
    unresolved: mutable darray[u8] = []
    false return if not pymodule_so_capture(command, work, &unresolved)
    needle: mutable darray[u8] = []
    emit_tokens_push_sview(&needle, "elisa_native_callback_")
    return pymodule_so_contains(unresolved, needle)




def pymodule_so_contains(text: darray[u8]&, needle: darray[u8]&) -> bool can[Abort.Panic]:
    false return if needle.count == 0 or needle.count > text.count
    limit: usize = text.count - needle.count
    for start in 0..<(limit + 1.usize()) |text, needle|:
        same: mutable bool = true
        for index in 0..<needle.count |same, text, needle, start|:
            same <- false if text[start + index] != needle[index]
        true return if same
    return false
