# Stage0 frontend-IR pattern encoding IDs and source-byte discriminators.
# The pattern writer and its proof share these named values so a tag or field
# cannot silently drift to a neighboring schema entry.
module FrontendIrPatternEncoding:
    public:
        const WILDCARD_PATTERN_NODE_TYPE_ID: u64 = 184
        const BINDING_PATTERN_NODE_TYPE_ID: u64 = 171
        const LITERAL_PATTERN_NODE_TYPE_ID: u64 = 174
        const STRING_LITERAL_PATTERN_NODE_TYPE_ID: u64 = 180
        const VARIANT_PATTERN_NODE_TYPE_ID: u64 = 183
        const STRUCT_PATTERN_NODE_TYPE_ID: u64 = 181
        const TUPLE_PATTERN_NODE_TYPE_ID: u64 = 182
        const BOOL_LITERAL_NODE_TYPE_ID: u64 = 18
        const CHAR_LITERAL_NODE_TYPE_ID: u64 = 28
        const INT_LITERAL_NODE_TYPE_ID: u64 = 139
        const PATTERN_ARG_NODE_TYPE_ID: u64 = 176
        const MATCH_ARM_NODE_TYPE_ID: u64 = 170

        const BINDING_PATTERN_NAME_FIELD_ID: u64 = 2
        const LITERAL_PATTERN_VALUE_FIELD_ID: u64 = 3
        const STRING_LITERAL_PATTERN_VALUE_FIELD_ID: u64 = 2
        const VARIANT_PATTERN_ARGS_FIELD_ID: u64 = 1
        const VARIANT_PATTERN_ENUM_NAME_FIELD_ID: u64 = 3
        const VARIANT_PATTERN_VARIANT_FIELD_ID: u64 = 7
        const STRUCT_PATTERN_ARGS_FIELD_ID: u64 = 1
        const STRUCT_PATTERN_BRACE_FIELD_ID: u64 = 3
        const STRUCT_PATTERN_TYPE_NAME_FIELD_ID: u64 = 7
        const TUPLE_PATTERN_ELEMENTS_FIELD_ID: u64 = 1
        const BOOL_LITERAL_VALUE_FIELD_ID: u64 = 2
        const CHAR_LITERAL_VALUE_FIELD_ID: u64 = 2
        const INT_LITERAL_VALUE_FIELD_ID: u64 = 4
        const PATTERN_ARG_NAME_FIELD_ID: u64 = 1
        const PATTERN_ARG_PATTERN_FIELD_ID: u64 = 2
        const MATCH_ARM_BODY_FIELD_ID: u64 = 1
        const MATCH_ARM_GUARD_FIELD_ID: u64 = 2
        const MATCH_ARM_PATTERN_FIELD_ID: u64 = 3

        const QUALIFIED_PATTERN_PATH_SEPARATOR_BYTE: i64 = 46
        const STRING_PATTERN_QUOTE_BYTE: i64 = 34
        const CHAR_PATTERN_QUOTE_BYTE: i64 = 39
        const ASCII_DIGIT_ZERO_BYTE: i64 = 48
        const ASCII_DIGIT_NINE_BYTE: i64 = 57
