def pymodule_set_type_name(element_name: sview) -> sview can[Abort.Panic]:
    "set[i8]" return if element_name == "i8"
    "set[i16]" return if element_name == "i16"
    "set[i32]" return if element_name == "i32"
    "set[i64]" return if element_name == "i64"
    "set[int]" return if element_name == "int"
    "set[isize]" return if element_name == "isize"
    "set[char]" return if element_name == "char"
    "set[u8]" return if element_name == "u8"
    "set[u16]" return if element_name == "u16"
    "set[u32]" return if element_name == "u32"
    "set[u64]" return if element_name == "u64"
    "set[usize]" return if element_name == "usize"
    "set[uintptr]" return if element_name == "uintptr"
    "set[bool]" return if element_name == "bool"
    "set[cstr]" return if element_name == "cstr"
    "set[sview]" return if element_name == "sview"
    # Nested container elements are canonicalized by `pymodule_alias_type_name` using the
    # parser-owned spelling cache. Keeping this fallback here lets the generic type walker
    # recognize those spellings without pretending that every nested shape is ABI-supported yet.
    if sview_len(element_name) > 5.usize() and element_name[0:5] == "set[" and sview_at(element_name, sview_len(element_name) - 1.usize()) == 93:
        return element_name
    if sview_len(element_name) > 7.usize() and element_name[0:6] == "dict[" and sview_at(element_name, sview_len(element_name) - 1.usize()) == 93:
        return element_name
    if sview_len(element_name) > 8.usize() and element_name[0:7] == "darray[" and sview_at(element_name, sview_len(element_name) - 1.usize()) == 93:
        return element_name
    return ""




def pymodule_darray_element_name(type_name: sview) -> sview can[Abort.Panic]:
    "i8" return if type_name == "darray[i8]"
    "i16" return if type_name == "darray[i16]"
    "i32" return if type_name == "darray[i32]"
    "i64" return if type_name == "darray[i64]"
    "int" return if type_name == "darray[int]"
    "isize" return if type_name == "darray[isize]"
    "char" return if type_name == "darray[char]"
    "u8" return if type_name == "darray[u8]"
    "u16" return if type_name == "darray[u16]"
    "u32" return if type_name == "darray[u32]"
    "u64" return if type_name == "darray[u64]"
    "usize" return if type_name == "darray[usize]"
    "uintptr" return if type_name == "darray[uintptr]"
    "bool" return if type_name == "darray[bool]"
    "f32" return if type_name == "darray[f32]"
    "f64" return if type_name == "darray[f64]"
    "cstr" return if type_name == "darray[cstr]"
    "sview" return if type_name == "darray[sview]"
    "py::Object" return if type_name == "darray[py::Object]"
    "cstr?" return if type_name == "darray[cstr?]"
    "sview?" return if type_name == "darray[sview?]"
    "py::Object?" return if type_name == "darray[py::Object?]"
    "i8?" return if type_name == "darray[i8?]"
    "i16?" return if type_name == "darray[i16?]"
    "i32?" return if type_name == "darray[i32?]"
    "i64?" return if type_name == "darray[i64?]"
    "int?" return if type_name == "darray[int?]"
    "isize?" return if type_name == "darray[isize?]"
    "char?" return if type_name == "darray[char?]"
    "u8?" return if type_name == "darray[u8?]"
    "u16?" return if type_name == "darray[u16?]"
    "u32?" return if type_name == "darray[u32?]"
    "u64?" return if type_name == "darray[u64?]"
    "usize?" return if type_name == "darray[usize?]"
    "uintptr?" return if type_name == "darray[uintptr?]"
    "bool?" return if type_name == "darray[bool?]"
    "f32?" return if type_name == "darray[f32?]"
    "f64?" return if type_name == "darray[f64?]"
    # Named elements are canonicalized by `pymodule_alias_type_name` as
    # `darray[Name]`; preserve the view into that owned spelling here.
    if sview_len(type_name) > 8.usize() and type_name[0:7] == "darray[" and sview_at(type_name, sview_len(type_name) - 1.usize()) == 93:
        return type_name[7:sview_len(type_name) - 1.usize()]
    return ""




def pymodule_is_darray_type(type_name: sview) -> bool can[Abort.Panic]:
    return pymodule_darray_element_name(type_name) != ""




