# `-emit pymodule` — the CONTAINER type names and element queries: darray, view, set and fixed
# array, together with the element-kind predicates every converter branches on.


def pymodule_darray_type_name(element_name: sview) -> sview can[Abort.Panic]:
    return when element_name:
        "i8" -> "darray[i8]"
        "i16" -> "darray[i16]"
        "i32" -> "darray[i32]"
        "i64" -> "darray[i64]"
        "int" -> "darray[int]"
        "isize" -> "darray[isize]"
        "char" -> "darray[char]"
        "u8" -> "darray[u8]"
        "u16" -> "darray[u16]"
        "u32" -> "darray[u32]"
        "u64" -> "darray[u64]"
        "usize" -> "darray[usize]"
        "uintptr" -> "darray[uintptr]"
        "bool" -> "darray[bool]"
        "f32" -> "darray[f32]"
        "f64" -> "darray[f64]"
        "cstr" -> "darray[cstr]"
        "sview" -> "darray[sview]"
        "py::Object" -> "darray[py::Object]"
        "cstr?" -> "darray[cstr?]"
        "sview?" -> "darray[sview?]"
        "py::Object?" -> "darray[py::Object?]"
        "i8?" -> "darray[i8?]"
        "i16?" -> "darray[i16?]"
        "i32?" -> "darray[i32?]"
        "i64?" -> "darray[i64?]"
        "int?" -> "darray[int?]"
        "isize?" -> "darray[isize?]"
        "char?" -> "darray[char?]"
        "u8?" -> "darray[u8?]"
        "u16?" -> "darray[u16?]"
        "u32?" -> "darray[u32?]"
        "u64?" -> "darray[u64?]"
        "usize?" -> "darray[usize?]"
        "uintptr?" -> "darray[uintptr?]"
        "bool?" -> "darray[bool?]"
        "f32?" -> "darray[f32?]"
        "f64?" -> "darray[f64?]"
        _ -> ""




