# `-emit pymodule` — the CONTAINER type names and element queries: darray, view, set and fixed
# array, together with the element-kind predicates every converter branches on.


def pymodule_darray_type_name(element_name: sview) -> sview can[Abort.Panic]:
    "darray[i8]" return if element_name == "i8"
    "darray[i16]" return if element_name == "i16"
    "darray[i32]" return if element_name == "i32"
    "darray[i64]" return if element_name == "i64"
    "darray[int]" return if element_name == "int"
    "darray[isize]" return if element_name == "isize"
    "darray[char]" return if element_name == "char"
    "darray[u8]" return if element_name == "u8"
    "darray[u16]" return if element_name == "u16"
    "darray[u32]" return if element_name == "u32"
    "darray[u64]" return if element_name == "u64"
    "darray[usize]" return if element_name == "usize"
    "darray[uintptr]" return if element_name == "uintptr"
    "darray[bool]" return if element_name == "bool"
    "darray[f32]" return if element_name == "f32"
    "darray[f64]" return if element_name == "f64"
    "darray[cstr]" return if element_name == "cstr"
    "darray[sview]" return if element_name == "sview"
    "darray[py::Object]" return if element_name == "py::Object"
    "darray[cstr?]" return if element_name == "cstr?"
    "darray[sview?]" return if element_name == "sview?"
    "darray[py::Object?]" return if element_name == "py::Object?"
    "darray[i8?]" return if element_name == "i8?"
    "darray[i16?]" return if element_name == "i16?"
    "darray[i32?]" return if element_name == "i32?"
    "darray[i64?]" return if element_name == "i64?"
    "darray[int?]" return if element_name == "int?"
    "darray[isize?]" return if element_name == "isize?"
    "darray[char?]" return if element_name == "char?"
    "darray[u8?]" return if element_name == "u8?"
    "darray[u16?]" return if element_name == "u16?"
    "darray[u32?]" return if element_name == "u32?"
    "darray[u64?]" return if element_name == "u64?"
    "darray[usize?]" return if element_name == "usize?"
    "darray[uintptr?]" return if element_name == "uintptr?"
    "darray[bool?]" return if element_name == "bool?"
    "darray[f32?]" return if element_name == "f32?"
    "darray[f64?]" return if element_name == "f64?"
    return ""




