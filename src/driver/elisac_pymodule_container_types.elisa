def pymodule_set_element_name(type_name: sview) -> sview can[Abort.Panic]:
    "i8" return if type_name == "set[i8]"
    "i16" return if type_name == "set[i16]"
    "i32" return if type_name == "set[i32]"
    "i64" return if type_name == "set[i64]"
    "int" return if type_name == "set[int]"
    "isize" return if type_name == "set[isize]"
    "char" return if type_name == "set[char]"
    "u8" return if type_name == "set[u8]"
    "u16" return if type_name == "set[u16]"
    "u32" return if type_name == "set[u32]"
    "u64" return if type_name == "set[u64]"
    "usize" return if type_name == "set[usize]"
    "uintptr" return if type_name == "set[uintptr]"
    "bool" return if type_name == "set[bool]"
    "cstr" return if type_name == "set[cstr]"
    "sview" return if type_name == "set[sview]"
    if sview_len(type_name) > 5.usize() and type_name[0:4] == "set[" and sview_at(type_name, sview_len(type_name) - 1.usize()) == 93:
        return type_name[4:sview_len(type_name) - 1.usize()]
    return ""




def pymodule_is_set_type(type_name: sview) -> bool can[Abort.Panic]:
    return pymodule_set_element_name(type_name) != "" or (sview_len(type_name) > 5.usize() and type_name[0:4] == "set[" and sview_at(type_name, sview_len(type_name) - 1.usize()) == 93)




def pymodule_fixed_array_element_name(type_name: sview) -> sview can[Abort.Panic]:
    return "" if sview_len(type_name) < 10.usize() or type_name[0:6] != "array[" or sview_at(type_name, sview_len(type_name) - 1.usize()) != 93
    comma: mutable usize = 6.usize()
    while comma + 1.usize() < sview_len(type_name) and sview_at(type_name, comma) != 44 |type_name, comma|:
        comma <- comma + 1.usize()
    return "" if comma == 6.usize() or comma + 1.usize() >= sview_len(type_name)
    element_name: sview = type_name[6:comma]
    return "" if element_name == ""
    for digit_index in (comma + 1.usize())..<(sview_len(type_name) - 1.usize()) |type_name, comma|:
        digit: u8 = sview_at(type_name, digit_index)
        return "" if digit < 48 or digit > 57
    return element_name




def pymodule_fixed_array_extent(type_name: sview) -> i64 can[Abort.Panic]:
    return 0 if pymodule_fixed_array_element_name(type_name) == ""
    comma: mutable usize = 6.usize()
    while comma + 1.usize() < sview_len(type_name) and sview_at(type_name, comma) != 44 |type_name, comma|:
        comma <- comma + 1.usize()
    value: mutable i64 = 0
    for digit_index in (comma + 1.usize())..<(sview_len(type_name) - 1.usize()) |type_name, comma, value|:
        # Python shims only support fixed arrays up to 4096 elements. Saturate at
        # 4097 while parsing so a hostilely large literal cannot overflow the i64
        # accumulator and wrap back into the accepted range.
        digit: i64 = (sview_at(type_name, digit_index) - 48).i64()
        return 4097 if value > 409 or (value == 409 and digit > 6)
        value <- value * 10 + digit
    return value




def pymodule_is_fixed_array_type(type_name: sview) -> bool can[Abort.Panic]:
    return pymodule_fixed_array_element_name(type_name) != "" and pymodule_fixed_array_extent(type_name) > 0




def pymodule_fixed_array_scalar_element_supported(element_name: sview) -> bool can[Abort.Panic]:
    return element_name == "i8" or element_name == "i16" or element_name == "i32" or element_name == "i64" or element_name == "int" or element_name == "isize" or element_name == "char" or element_name == "u8" or element_name == "u16" or element_name == "u32" or element_name == "u64" or element_name == "usize" or element_name == "uintptr" or element_name == "bool" or element_name == "f32" or element_name == "f64"




def pymodule_type_contains_ref(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.Unary(ref_operator, ref_operand, ref_pos):
        return true if ref_operator == Lexer::TokenKind.Ampersand
        return pymodule_type_contains_ref(ref_operand)
    if expression is Expr.Paren(ref_inner, ref_paren_pos):
        return pymodule_type_contains_ref(ref_inner)
    if expression is Expr.Refinement(ref_base, ref_predicate, ref_refinement_pos):
        return pymodule_type_contains_ref(ref_base)
    return false




def pymodule_type_contains_mutable(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.Unary(mutable_operator, mutable_operand, mutable_pos):
        return true if mutable_operator == Lexer::TokenKind.Mutable or mutable_operator == Lexer::TokenKind.Lmut
        return pymodule_type_contains_mutable(mutable_operand)
    if expression is Expr.Paren(mutable_inner, mutable_paren_pos):
        return pymodule_type_contains_mutable(mutable_inner)
    if expression is Expr.Refinement(mutable_base, mutable_predicate, mutable_refinement_pos):
        return pymodule_type_contains_mutable(mutable_base)
    return false




def pymodule_fixed_array_input_supported(file: Ast::File&, type_name: sview, expression: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
    # The generated shim keeps the copied values in a small fixed C buffer for the
    # duration of one call.  Bound that stack allocation so a valid Elisa type cannot
    # turn an import-time wrapper call into an unbounded native stack reservation.
    # Both read-only borrowed arrays (`array[T,N]&`) and by-value arrays use this
    # adapter; mutable references remain rejected because Python cannot observe their
    # in-place writes through a temporary copy.
    return pymodule_is_fixed_array_type(type_name) and pymodule_fixed_array_extent(type_name) <= 4096.usize() and pymodule_fixed_array_scalar_element_supported(pymodule_fixed_array_element_name(type_name)) and not pymodule_type_contains_mutable(expression)




def pymodule_fixed_array_return_supported(type_name: sview) -> bool can[Abort.Panic]:
    return pymodule_is_fixed_array_type(type_name) and pymodule_fixed_array_extent(type_name) <= 4096.usize() and pymodule_fixed_array_scalar_element_supported(pymodule_fixed_array_element_name(type_name))




def pymodule_darray_ref_parameter(type_name: sview, expression: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
    # Read-only darray references carry a hidden caller arena in the native ABI.  The
    # generated Python wrapper supplies that arena while copying the temporary sequence;
    # mutable references remain outside Python's copy-in/copy-out contract.
    return pymodule_is_darray_type(type_name) and pymodule_type_contains_ref(expression) and not pymodule_type_contains_mutable(expression)




def pymodule_darray_is_bytes(type_name: sview) -> bool can[Abort.Panic]:
    return type_name == "darray[u8]"




def pymodule_darray_c_element_type(type_name: sview) -> sview can[Abort.Panic]:
    "int8_t" return if type_name == "i8"
    "int16_t" return if type_name == "i16"
    "int32_t" return if type_name == "i32"
    "int64_t" return if type_name == "i64" or type_name == "int" or type_name == "isize" or type_name == "char"
    "uint8_t" return if type_name == "u8"
    "uint16_t" return if type_name == "u16"
    "uint32_t" return if type_name == "u32"
    "uint64_t" return if type_name == "u64" or type_name == "usize" or type_name == "uintptr"
    "bool" return if type_name == "bool"
    "float" return if type_name == "f32"
    "double" return if type_name == "f64"
    "const char *" return if type_name == "cstr"
    "const char *" return if type_name == "cstr?"
    "ElisaSView" return if type_name == "sview"
    "ElisaOptionalSView" return if type_name == "sview?"
    "PyObject *" return if type_name == "py::Object"
    "PyObject *" return if type_name == "py::Object?"
    "ElisaOptionalI8" return if type_name == "i8?"
    "ElisaOptionalI16" return if type_name == "i16?"
    "ElisaOptionalI32" return if type_name == "i32?"
    "ElisaOptionalI64" return if type_name == "i64?" or type_name == "char?"
    "ElisaOptionalInt" return if type_name == "int?" or type_name == "isize?"
    "ElisaOptionalU8" return if type_name == "u8?"
    "ElisaOptionalU16" return if type_name == "u16?"
    "ElisaOptionalU32" return if type_name == "u32?"
    "ElisaOptionalU64" return if type_name == "u64?"
    "ElisaOptionalUSize" return if type_name == "usize?" or type_name == "uintptr?"
    "ElisaOptionalBool" return if type_name == "bool?"
    "ElisaOptionalF32" return if type_name == "f32?"
    "ElisaOptionalF64" return if type_name == "f64?"
    return ""




def pymodule_darray_element_is_unsigned(type_name: sview) -> bool can[Abort.Panic]:
    return type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or type_name == "usize" or type_name == "uintptr"




def pymodule_darray_element_is_float(type_name: sview) -> bool can[Abort.Panic]:
    return type_name == "f32" or type_name == "f64"




def pymodule_darray_element_is_bool(type_name: sview) -> bool can[Abort.Panic]:
    return type_name == "bool"




def pymodule_darray_element_is_object(type_name: sview) -> bool can[Abort.Panic]:
    return type_name == "py::Object" or type_name == "py::Object?"




def pymodule_darray_element_is_optional_object(type_name: sview) -> bool can[Abort.Panic]:
    return type_name == "py::Object?"




def pymodule_darray_element_is_cstr(type_name: sview) -> bool can[Abort.Panic]:
    return type_name == "cstr"




def pymodule_darray_element_is_optional_cstr(type_name: sview) -> bool can[Abort.Panic]:
    return type_name == "cstr?"




def pymodule_darray_element_is_sview(type_name: sview) -> bool can[Abort.Panic]:
    return type_name == "sview"




def pymodule_darray_element_is_optional_sview(type_name: sview) -> bool can[Abort.Panic]:
    return type_name == "sview?"




def pymodule_darray_element_is_optional_scalar(type_name: sview) -> bool can[Abort.Panic]:
    return pymodule_is_optional_scalar_type(type_name) and type_name != "sview?"




def pymodule_optional_payload_c_type(payload_name: sview) -> sview can[Abort.Panic]:
    "int8_t" return if payload_name == "i8"
    "int16_t" return if payload_name == "i16"
    "int32_t" return if payload_name == "i32"
    "int64_t" return if payload_name == "i64"
    "intptr_t" return if payload_name == "int" or payload_name == "isize"
    "uint8_t" return if payload_name == "u8"
    "uint16_t" return if payload_name == "u16"
    "uint32_t" return if payload_name == "u32"
    "uint64_t" return if payload_name == "u64"
    "uintptr_t" return if payload_name == "usize" or payload_name == "uintptr"
    "bool" return if payload_name == "bool"
    "float" return if payload_name == "f32"
    "double" return if payload_name == "f64"
    return ""
