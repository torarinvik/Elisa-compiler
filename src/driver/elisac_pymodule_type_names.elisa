# `-emit pymodule` — naming a type for the Python bridge: the scalar, string and opaque-object
# atoms, optionals, ordinary Elisa aliases (transparent ABI names), enum backing types, and the
# cached container spellings the converters look up by name.


# The scalar/string/list/bytes/dict/opaque-object/error CPython wrapper emitted by `-emit pymodule-c`.  This is intentionally a separate
# mode from the JSON manifest above: build systems can keep consuming the stable manifest while
# native builds opt into a concrete C source file.  The wrapper calls the stable
# `elisa_pymodule_<module>_<name>` symbols emitted by the ordinary object backend.
def pymodule_type_atom_name(expression: Ast::Expr) -> sview can[Abort.Panic]:
    if expression is Expr.Ident(atom_name, atom_pos):
        return atom_name
    if expression is Expr.Scope(atom_scope_head, atom_scope_name, atom_scope_pos):
        return "py::Object" if atom_scope_head is Expr.Ident(atom_scope_module, atom_scope_module_pos) and atom_scope_module == "py" and atom_scope_name == "Object"
        return atom_scope_name
    if expression is Expr.Unary(atom_operator, atom_operand, atom_unary_pos):
        return pymodule_optional_element_name(expression) if atom_operator == Lexer::TokenKind.Question
        return pymodule_type_atom_name(atom_operand) if atom_operator == Lexer::TokenKind.Mutable or atom_operator == Lexer::TokenKind.Lmut or atom_operator == Lexer::TokenKind.Ampersand
    if expression is Expr.Paren(atom_inner, atom_paren_pos):
        return pymodule_type_atom_name(atom_inner)
    return ""




def pymodule_optional_element_name(expression: Ast::Expr) -> sview can[Abort.Panic]:
    if expression is Expr.Unary(optional_element_operator, optional_element_operand, optional_element_pos):
        if optional_element_operator == Lexer::TokenKind.Question:
            if optional_element_operand is Expr.Ident(optional_element_name, optional_element_name_pos):
                return "cstr?" if optional_element_name == "cstr"
                return "sview?" if optional_element_name == "sview"
                return "i8?" if optional_element_name == "i8"
                return "i16?" if optional_element_name == "i16"
                return "i32?" if optional_element_name == "i32"
                return "i64?" if optional_element_name == "i64"
                return "int?" if optional_element_name == "int"
                return "isize?" if optional_element_name == "isize"
                return "char?" if optional_element_name == "char"
                return "u8?" if optional_element_name == "u8"
                return "u16?" if optional_element_name == "u16"
                return "u32?" if optional_element_name == "u32"
                return "u64?" if optional_element_name == "u64"
                return "usize?" if optional_element_name == "usize"
                return "uintptr?" if optional_element_name == "uintptr"
                return "bool?" if optional_element_name == "bool"
                return "f32?" if optional_element_name == "f32"
                return "f64?" if optional_element_name == "f64"
            if optional_element_operand is Expr.Scope(optional_element_scope_head, optional_element_scope_name, optional_element_scope_pos):
                return "py::Object?" if optional_element_scope_head is Expr.Ident(optional_element_scope_module, optional_element_scope_module_pos) and optional_element_scope_module == "py" and optional_element_scope_name == "Object"
    return ""




def pymodule_bare_type_name(expression: Ast::Expr) -> sview can[Abort.Panic]:
    if expression is Expr.Unary(operator, operand, pos):
        # Parameter type expressions may wrap the actual container in a borrowed
        # reference (`&`) and/or mutability marker (`mutable`/`lmut`). Cleanup and
        # default handling must see the same canonical darray/view/dict name as the
        # conversion paths; otherwise `darray[T]&` buffers allocated by the shim
        # are skipped on every exit path.
        return pymodule_bare_type_name(operand) if operator == Lexer::TokenKind.Mutable or operator == Lexer::TokenKind.Ampersand or operator == Lexer::TokenKind.Lmut
        if operator == Lexer::TokenKind.Question:
            if operand is Expr.Scope(optional_scope_head, optional_scope_name, optional_scope_pos):
                return "py::Object?" if optional_scope_head is Expr.Ident(optional_scope_module, optional_scope_module_pos) and optional_scope_module == "py" and optional_scope_name == "Object"
            if operand is Expr.Ident(optional_cstr_name, optional_cstr_pos):
                return "cstr?" if optional_cstr_name == "cstr"
                return "sview?" if optional_cstr_name == "sview"
                return "i8?" if optional_cstr_name == "i8"
                return "i16?" if optional_cstr_name == "i16"
                return "i32?" if optional_cstr_name == "i32"
                return "i64?" if optional_cstr_name == "i64"
                return "int?" if optional_cstr_name == "int"
                return "isize?" if optional_cstr_name == "isize"
                return "char?" if optional_cstr_name == "char"
                return "u8?" if optional_cstr_name == "u8"
                return "u16?" if optional_cstr_name == "u16"
                return "u32?" if optional_cstr_name == "u32"
                return "u64?" if optional_cstr_name == "u64"
                return "usize?" if optional_cstr_name == "usize"
                return "uintptr?" if optional_cstr_name == "uintptr"
                return "bool?" if optional_cstr_name == "bool"
                return "f32?" if optional_cstr_name == "f32"
                return "f64?" if optional_cstr_name == "f64"
    if expression is Expr.Ident(name, pos):
        return name
    if expression is Expr.Scope(scope_head, scope_name, scope_pos):
        return "py::Object" if scope_head is Expr.Ident(scope_module_name, scope_module_pos) and scope_module_name == "py" and scope_name == "Object"
    if expression is Expr.Index(application_head_single, application_argument_single, application_pos_single):
        if application_head_single is Expr.Ident(application_name_single, application_name_pos_single) and application_name_single == "darray":
            if application_argument_single is Expr.Ident(element_name_single, element_pos_single):
                return pymodule_darray_type_name(element_name_single)
            if application_argument_single is Expr.Scope(element_scope_head, element_scope_name, element_scope_pos):
                return "darray[py::Object]" if element_scope_head is Expr.Ident(element_scope_module, element_scope_module_pos) and element_scope_module == "py" and element_scope_name == "Object"
            optional_element_name_single: sview = pymodule_optional_element_name(application_argument_single)
            return "darray[cstr?]" if optional_element_name_single == "cstr?"
            return "darray[sview?]" if optional_element_name_single == "sview?"
            return "darray[py::Object?]" if optional_element_name_single == "py::Object?"
            return pymodule_darray_type_name(optional_element_name_single) if optional_element_name_single != ""
            nested_darray_element_name_single: sview = pymodule_bare_type_name(application_argument_single)
            return pymodule_darray_type_name(nested_darray_element_name_single) if nested_darray_element_name_single != ""
        if application_head_single is Expr.Ident(view_name_single, view_name_pos_single) and view_name_single == "view":
            if application_argument_single is Expr.Ident(view_element_name_single, view_element_pos_single):
                return pymodule_view_type_name(view_element_name_single)
            if application_argument_single is Expr.Scope(view_element_scope_head, view_element_scope_name, view_element_scope_pos):
                return "view[py::Object]" if view_element_scope_head is Expr.Ident(view_element_scope_module, view_element_scope_module_pos) and view_element_scope_module == "py" and view_element_scope_name == "Object"
            view_optional_element_name_single: sview = pymodule_optional_element_name(application_argument_single)
            return pymodule_view_type_name(view_optional_element_name_single) if view_optional_element_name_single != ""
            nested_view_element_name_single: sview = pymodule_bare_type_name(application_argument_single)
            return pymodule_view_type_name(nested_view_element_name_single) if nested_view_element_name_single != ""
        if application_head_single is Expr.Ident(set_name_single, set_name_pos_single) and set_name_single == "set":
            if application_argument_single is Expr.Ident(set_element_name_single, set_element_pos_single):
                return pymodule_set_type_name(set_element_name_single)
            nested_set_element_name_single: sview = pymodule_bare_type_name(application_argument_single)
            return pymodule_set_type_name(nested_set_element_name_single) if nested_set_element_name_single != ""
    if expression is Expr.IndexN(application_head, application_args, application_pos):
        if application_head is Expr.Ident(application_name, application_name_pos) and application_name == "darray" and application_args.count == 1:
            if application_args[0] is Expr.Ident(element_name, element_pos):
                return pymodule_darray_type_name(element_name)
            if application_args[0] is Expr.Scope(element_scope_head_n, element_scope_name_n, element_scope_pos_n):
                return "darray[py::Object]" if element_scope_head_n is Expr.Ident(element_scope_module_n, element_scope_module_pos_n) and element_scope_module_n == "py" and element_scope_name_n == "Object"
            optional_element_name_n: sview = pymodule_optional_element_name(application_args[0])
            return "darray[cstr?]" if optional_element_name_n == "cstr?"
            return "darray[sview?]" if optional_element_name_n == "sview?"
            return "darray[py::Object?]" if optional_element_name_n == "py::Object?"
            return pymodule_darray_type_name(optional_element_name_n) if optional_element_name_n != ""
            nested_darray_element_name_n: sview = pymodule_bare_type_name(application_args[0])
            return pymodule_darray_type_name(nested_darray_element_name_n) if nested_darray_element_name_n != ""
        if application_head is Expr.Ident(view_application_name, view_application_name_pos) and view_application_name == "view" and application_args.count == 1:
            if application_args[0] is Expr.Ident(view_element_name_n, view_element_pos_n):
                return pymodule_view_type_name(view_element_name_n)
            if application_args[0] is Expr.Scope(view_element_scope_head_n, view_element_scope_name_n, view_element_scope_pos_n):
                return "view[py::Object]" if view_element_scope_head_n is Expr.Ident(view_element_scope_module_n, view_element_scope_module_pos_n) and view_element_scope_module_n == "py" and view_element_scope_name_n == "Object"
            view_optional_element_name_n: sview = pymodule_optional_element_name(application_args[0])
            return pymodule_view_type_name(view_optional_element_name_n) if view_optional_element_name_n != ""
            nested_view_element_name_n: sview = pymodule_bare_type_name(application_args[0])
            return pymodule_view_type_name(nested_view_element_name_n) if nested_view_element_name_n != ""
        if application_head is Expr.Ident(set_application_name, set_application_name_pos) and set_application_name == "set" and application_args.count == 1:
            if application_args[0] is Expr.Ident(set_element_name_n, set_element_pos_n):
                return pymodule_set_type_name(set_element_name_n)
            nested_set_element_name_n: sview = pymodule_bare_type_name(application_args[0])
            return pymodule_set_type_name(nested_set_element_name_n) if nested_set_element_name_n != ""
        if pymodule_type_atom_name(application_head) == "dict" and application_args.count == 2:
            dict_key_name: sview = pymodule_bare_type_name(application_args[0])
            dict_value_name: sview = pymodule_bare_type_name(application_args[1])
            return pymodule_dict_type_name(dict_key_name, dict_value_name)
    return ""




# Python exports should treat ordinary Elisa type aliases as transparent ABI names. Normalize the
# type expression first so aliases of `darray[...]`/`dict[...]` also reach the existing ownership
# and cleanup helpers with their concrete element/value expression, not merely a pretty name.
def pymodule_alias_type_expression(file: Ast::File&, expression: Ast::Expr, depth: usize = 0.usize()) -> Ast::Expr can[Abort.Panic, Memory.Allocate]:
    return expression if depth >= 32.usize()
    if expression is Expr.Ident(alias_name, alias_pos):
        for alias_index in 0..<file.alias_names.count |file, alias_name, depth|:
            if file.alias_names[alias_index] == alias_name:
                return pymodule_alias_type_expression(file, file.alias_targets[alias_index], depth + 1.usize())
        enum_backing: sview = pymodule_enum_backing_type(file, alias_name)
        return Expr.Ident(enum_backing, alias_pos) if enum_backing != ""
        return expression
    if expression is Expr.Unary(alias_operator, alias_operand, alias_pos):
        expanded_operand: Ast::Expr = pymodule_alias_type_expression(file, alias_operand, depth + 1.usize())
        return Expr.Unary(alias_operator, expanded_operand, alias_pos)
    if expression is Expr.Paren(alias_inner, alias_pos):
        return Expr.Paren(pymodule_alias_type_expression(file, alias_inner, depth + 1.usize()), alias_pos)
    if expression is Expr.Refinement(alias_base, alias_predicate, alias_pos):
        return pymodule_alias_type_expression(file, alias_base, depth + 1.usize())
    if expression is Expr.Index(alias_object, alias_index, alias_pos):
        return Expr.Index(pymodule_alias_type_expression(file, alias_object, depth + 1.usize()), pymodule_alias_type_expression(file, alias_index, depth + 1.usize()), alias_pos)
    if expression is Expr.IndexN(alias_object_n, alias_arguments, alias_pos_n):
        expanded_arguments: mutable darray[Ast::Expr] = []
        for alias_argument in alias_arguments |expanded_arguments, file, depth|:
            expanded_arguments.push(pymodule_alias_type_expression(file, alias_argument, depth + 1.usize()))
        return Expr.IndexN(pymodule_alias_type_expression(file, alias_object_n, depth + 1.usize()), expanded_arguments, alias_pos_n)
    return expression




def pymodule_enum_backing_type_in(declarations: darray[Ast::Decl]&, wanted: sview) -> sview can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |wanted|:
        if declaration is Decl.Enum(enum_name, enum_variants, enum_const, enum_storage, enum_pos):
            if enum_name == wanted:
                # Payload enums are tagged aggregates, not integer ABI values. Plain and const
                # enums with no payload fields lower to their declared scalar storage and are
                # pleasant Python integers at the boundary.
                for variant in enum_variants:
                    return "" if variant.fields.count > 0
                backing: sview = pymodule_bare_type_name(enum_storage)
                return backing if backing != "" else "i64"
        if declaration is Decl.Module(enum_module_name, enum_module_body, enum_module_pos):
            nested: sview = pymodule_enum_backing_type_in(enum_module_body, wanted)
            return nested if nested != ""
        if declaration is Decl.Scoped(enum_scope_body, enum_scope_pos):
            nested_scoped: sview = pymodule_enum_backing_type_in(enum_scope_body, wanted)
            return nested_scoped if nested_scoped != ""
    return ""




def pymodule_enum_backing_type(file: Ast::File&, type_name: sview) -> sview can[Abort.Panic, Memory.Allocate]:
    return pymodule_enum_backing_type_in(file.top_decls, type_name)




def pymodule_cached_container_type_name(file: Ast::File&, prefix: sview, element_name: sview) -> sview can[Abort.Panic, Memory.Allocate]:
    # The parser pre-builds these spellings in the file's adopted region. Looking them up
    # here keeps this string-oriented bridge layer read-only while still supporting arbitrary
    # named elements such as `darray[Point]` and `view[Point]`.
    wanted_length: usize = sview_len(prefix) + sview_len(element_name) + 1.usize()
    for cache_index in 0..<file.pymodule_type_name_starts.count |file, cache_index, prefix, element_name, wanted_length|:
        start: usize = file.pymodule_type_name_starts[cache_index]
        continue if file.pymodule_type_name_lengths[cache_index] != wanted_length
        matched: mutable bool = true
        for prefix_index in 0..<sview_len(prefix) |matched, file, start, prefix|:
            matched <- false if file.pymodule_type_name_bytes[start + prefix_index] != sview_at(prefix, prefix_index)
        for element_index in 0..<sview_len(element_name) |matched, file, start, prefix, element_name|:
            matched <- false if file.pymodule_type_name_bytes[start + sview_len(prefix) + element_index] != sview_at(element_name, element_index)
        matched <- false if file.pymodule_type_name_bytes[start + wanted_length - 1.usize()] != 93
        if matched:
            return sview(&file.pymodule_type_name_bytes[0], start, start + wanted_length)
    return ""




def pymodule_cached_dict_type_name(file: Ast::File&, key_name: sview, value_name: sview) -> sview can[Abort.Panic, Memory.Allocate]:
    # Named dictionary values are cached by the parser in the same adopted byte pool as
    # `darray[Struct]`/`view[Struct]`. Matching the three pieces independently avoids building a
    # temporary `key,value` spelling in the driver while still returning a stable sview.
    wanted_length: usize = sview_len("dict[") + sview_len(key_name) + 1.usize() + sview_len(value_name) + 1.usize()
    for cache_index in 0..<file.pymodule_type_name_starts.count |file, cache_index, key_name, value_name, wanted_length|:
        start: usize = file.pymodule_type_name_starts[cache_index]
        continue if file.pymodule_type_name_lengths[cache_index] != wanted_length
        matched: mutable bool = true
        for prefix_index in 0..<sview_len("dict[") |matched, file, start|:
            matched <- false if file.pymodule_type_name_bytes[start + prefix_index] != sview_at("dict[", prefix_index)
        for key_index in 0..<sview_len(key_name) |matched, file, start, key_name|:
            matched <- false if file.pymodule_type_name_bytes[start + sview_len("dict[") + key_index] != sview_at(key_name, key_index)
        comma_index: usize = sview_len("dict[") + sview_len(key_name)
        matched <- false if file.pymodule_type_name_bytes[start + comma_index] != 44
        for value_index in 0..<sview_len(value_name) |matched, file, start, value_name, comma_index|:
            matched <- false if file.pymodule_type_name_bytes[start + comma_index + 1.usize() + value_index] != sview_at(value_name, value_index)
        matched <- false if file.pymodule_type_name_bytes[start + wanted_length - 1.usize()] != 93
        if matched:
            return sview(&file.pymodule_type_name_bytes[0], start, start + wanted_length)
    # Defensive byte-pool lookup for recursively composed dictionary values. The parser cache is
    # normally indexed above; this bounded scan keeps the driver resilient if a future parser
    # cache producer appends a spelling without an index entry.
    if wanted_length <= file.pymodule_type_name_bytes.count:
        for scan_start in 0..<(file.pymodule_type_name_bytes.count - wanted_length + 1.usize()) |file, scan_start, key_name, value_name, wanted_length|:
            matched_scan: mutable bool = true
            for scan_index in 0..<wanted_length |matched_scan, file, scan_start, key_name, value_name|:
                expected: u8 = sview_at("dict[", scan_index) if scan_index < 5.usize() else sview_at(key_name, scan_index - 5.usize()) if scan_index < 5.usize() + sview_len(key_name) else 44 if scan_index == 5.usize() + sview_len(key_name) else sview_at(value_name, scan_index - 6.usize() - sview_len(key_name)) if scan_index < wanted_length - 1.usize() else 93
                matched_scan <- false if file.pymodule_type_name_bytes[scan_start + scan_index] != expected
            if matched_scan:
                return sview(&file.pymodule_type_name_bytes[0], scan_start, scan_start + wanted_length)
    return ""




def pymodule_cached_fixed_array_type_name(file: Ast::File&, element_name: sview, extent: i64) -> sview can[Abort.Panic, Memory.Allocate]:
    return "" if element_name == "" or extent <= 0 or extent > 4294967295
    wanted: mutable darray[u8] = []
    emit_tokens_push_sview(&wanted, "array[")
    emit_tokens_push_sview(&wanted, element_name)
    wanted.push(44)
    append_decimal(&wanted, extent.u32())
    wanted.push(93)
    for cache_index in 0..<file.pymodule_type_name_starts.count |file, wanted|:
        start: usize = file.pymodule_type_name_starts[cache_index]
        wanted_length: usize = wanted.count
        continue if file.pymodule_type_name_lengths[cache_index] != wanted_length
        matched: mutable bool = true
        for wanted_index in 0..<wanted_length |matched, file, start, wanted|:
            matched <- false if file.pymodule_type_name_bytes[start + wanted_index] != wanted[wanted_index]
        if matched:
            return sview(&file.pymodule_type_name_bytes[0], start, start + wanted_length)
    return ""




def pymodule_fixed_array_extent_expression(expression: Ast::Expr) -> (found: bool, value: i64) can[Abort.Panic]:
    if expression is Expr.IntLit(fixed_extent_value, _):
        return (true, fixed_extent_value)
    if expression is Expr.Paren(fixed_extent_inner, fixed_extent_pos):
        return pymodule_fixed_array_extent_expression(fixed_extent_inner)
    return (false, 0)




def pymodule_alias_type_name(file: Ast::File&, expression: Ast::Expr) -> sview can[Abort.Panic, Memory.Allocate]:
    expanded: Ast::Expr = pymodule_alias_type_expression(file, expression)
    if expanded is Expr.Unary(alias_ref_operator, alias_ref_operand, alias_ref_pos):
        if alias_ref_operator == Lexer::TokenKind.Mutable or alias_ref_operator == Lexer::TokenKind.Lmut or alias_ref_operator == Lexer::TokenKind.Ampersand:
            return pymodule_alias_type_name(file, alias_ref_operand)
    if expanded is Expr.Index(container_head, container_argument, container_pos):
        direct_extent: (found: bool, value: i64) = pymodule_fixed_array_extent_expression(container_argument)
        if direct_extent.found:
            direct_element_name: sview = pymodule_alias_type_name(file, container_head)
            direct_array_name: sview = pymodule_cached_fixed_array_type_name(file, direct_element_name, direct_extent.value)
            return direct_array_name if direct_array_name != ""
        if container_head is Expr.Ident(container_name, container_name_pos):
            element_name: mutable sview = pymodule_type_atom_name(container_argument)
            optional_element_name: sview = pymodule_optional_element_name(container_argument)
            element_name <- optional_element_name if element_name == "" and optional_element_name != ""
            element_name <- pymodule_alias_type_name(file, container_argument) if element_name == ""
            if container_name == "darray" and element_name != "":
                known_darray_name: sview = pymodule_darray_type_name(element_name)
                return known_darray_name if known_darray_name != ""
                return pymodule_cached_container_type_name(file, "darray[", element_name)
            if container_name == "view" and element_name != "":
                known_view_name: sview = pymodule_view_type_name(element_name)
                return known_view_name if known_view_name != ""
                return pymodule_cached_container_type_name(file, "view[", element_name)
            if container_name == "set" and element_name != "":
                known_set_name: sview = pymodule_set_type_name(element_name)
                return known_set_name if known_set_name != ""
                return pymodule_cached_container_type_name(file, "set[", element_name)
    if expanded is Expr.IndexN(container_head_n, container_arguments, container_pos_n):
        if container_head_n is Expr.Ident(array_container_name, array_container_name_pos) and array_container_name == "array" and container_arguments.count == 2:
            array_extent: (found: bool, value: i64) = pymodule_fixed_array_extent_expression(container_arguments[1])
            if array_extent.found:
                array_element_name: sview = pymodule_alias_type_name(file, container_arguments[0])
                fixed_array_name: sview = pymodule_cached_fixed_array_type_name(file, array_element_name, array_extent.value)
                return fixed_array_name if fixed_array_name != ""
        if container_head_n is Expr.Ident(container_name_n, container_name_pos_n) and container_arguments.count == 1:
            element_name_n: mutable sview = pymodule_type_atom_name(container_arguments[0])
            optional_element_name_n: sview = pymodule_optional_element_name(container_arguments[0])
            element_name_n <- optional_element_name_n if element_name_n == "" and optional_element_name_n != ""
            element_name_n <- pymodule_alias_type_name(file, container_arguments[0]) if element_name_n == ""
            if container_name_n == "darray" and element_name_n != "":
                known_darray_name_n: sview = pymodule_darray_type_name(element_name_n)
                return known_darray_name_n if known_darray_name_n != ""
                return pymodule_cached_container_type_name(file, "darray[", element_name_n)
            if container_name_n == "view" and element_name_n != "":
                known_view_name_n: sview = pymodule_view_type_name(element_name_n)
                return known_view_name_n if known_view_name_n != ""
                return pymodule_cached_container_type_name(file, "view[", element_name_n)
            if container_name_n == "set" and element_name_n != "":
                known_set_name_n: sview = pymodule_set_type_name(element_name_n)
                return known_set_name_n if known_set_name_n != ""
                return pymodule_cached_container_type_name(file, "set[", element_name_n)
        if pymodule_type_atom_name(container_head_n) == "dict" and container_arguments.count == 2:
            # Normalize both components recursively. This is what lets a dictionary value retain
            # its full cached spelling (`darray[darray[T]]`) instead of collapsing to an empty
            # bare name when the value itself is a generic container expression.
            dict_key_name_n: sview = pymodule_alias_type_name(file, container_arguments[0])
            dict_value_name_n: sview = pymodule_alias_type_name(file, container_arguments[1])
            known_dict_name_n: sview = pymodule_dict_type_name(dict_key_name_n, dict_value_name_n)
            return known_dict_name_n if known_dict_name_n != ""
            return pymodule_cached_dict_type_name(file, dict_key_name_n, dict_value_name_n)
    bare_name: sview = pymodule_bare_type_name(expanded)
    enum_backing: sview = pymodule_enum_backing_type(file, bare_name)
    return enum_backing if enum_backing != "" else bare_name




def pymodule_alias_normalize_params(file: Ast::File&, source_params: darray[Ast::ParamDecl]&) -> darray[Ast::ParamDecl] can[Abort.Panic, Memory.Allocate]:
    normalized: mutable darray[Ast::ParamDecl] = []
    for source_param in source_params |normalized, file|:
        normalized.push(Ast::ParamDecl{
            name: source_param.name,
            type_expression: pymodule_alias_type_expression(file, source_param.type_expression),
            is_mutable: source_param.is_mutable,
            has_default: source_param.has_default,
            default_value: source_param.default_value,
            is_affine: source_param.is_affine
        })
    return normalized




def pymodule_const_decl_type_name(file: Ast::File&, type_expression: Ast::Expr, value_expression: Ast::Expr) -> sview can[Abort.Panic, Memory.Allocate]:
    # Constants commonly spell a simple named alias (`type GreetingText = cstr`). Resolve
    # that file-owned target directly instead of materializing an expanded Expr first. The
    # latter can carry storage owned by the helper's temporary region in the self-hosted
    # compiler; consulting it after return made manifest generation crash for text aliases.
    if type_expression is Expr.Ident(const_alias_name, const_alias_pos):
        for const_alias_index in 0..<file.alias_names.count |file, const_alias_name, value_expression|:
            if file.alias_names[const_alias_index] == const_alias_name:
                return pymodule_const_decl_type_name(file, file.alias_targets[const_alias_index], value_expression)
    declared_name: sview = pymodule_alias_type_name(file, type_expression)
    return declared_name if declared_name != ""
    if value_expression is Expr.IntLit(inferred_int_value, _):
        return "int"
    if value_expression is Expr.BoolLit(inferred_bool_value, _):
        return "bool"
    if value_expression is Expr.FloatLit(inferred_float_value, _):
        return "f64"
    if value_expression is Expr.StringLit(inferred_string_text, _):
        return "cstr"
    if value_expression is Expr.Paren(inferred_inner, inferred_paren_pos):
        return pymodule_const_decl_type_name(file, type_expression, inferred_inner)
    return ""




# Constants have a deliberately smaller ABI than parameters and returns.  The generated
# extension initializes them eagerly with scalar/text/byte accessors; publishing any other
# native shape would make the manifest promise an attribute that the C shim cannot construct.
def pymodule_const_type_supported(type_name: sview) -> bool can[Abort.Panic]:
    return true if type_name == "cstr" or type_name == "sview" or type_name == "darray[u8]"
    return true if type_name == "i8" or type_name == "i16" or type_name == "i32" or type_name == "i64" or type_name == "int" or type_name == "isize" or type_name == "char"
    return true if type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or type_name == "usize" or type_name == "uintptr"
    return true if type_name == "bool" or type_name == "f32" or type_name == "f64"
    return false
