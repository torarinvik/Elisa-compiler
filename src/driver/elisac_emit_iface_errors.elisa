# Stage0 expands grouped error variants into independent entries. The interface
# must retain their order, including repeated families and the open-set marker.
def emit_iface_error_path(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, start: usize, stop: usize) -> void:
    can Abort.Panic, Memory.Allocate:
        source_length: usize = Lexer::token_stream_source_length(tokens)
        for index in start..<stop |buffer|:
            token: Lexer::Token = tokens[index]
            if token.kind != Lexer::TokenKind.Newline and token.kind != Lexer::TokenKind.Indent and token.kind != Lexer::TokenKind.Dedent:
                emit_tokens_push_sview(buffer, Lexer::text_or_empty(token, source, source_length))

def emit_iface_error_members(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, start: usize, stop: usize) -> void:
    can Abort.Panic, Memory.Allocate:
        source_length: usize = Lexer::token_stream_source_length(tokens)
        cursor: mutable usize = start
        emitted: mutable bool = false
        while cursor < stop |cursor, emitted, buffer|:
            kind: Lexer::TokenKind = tokens[cursor].kind
            if kind == Lexer::TokenKind.Comma or kind == Lexer::TokenKind.Newline or kind == Lexer::TokenKind.Indent or kind == Lexer::TokenKind.Dedent:
                cursor <- cursor + 1
                continue
            path_start: usize = cursor
            # An error path has no type arguments in the Stage0 grammar.
            while cursor < stop |cursor|:
                path_kind: Lexer::TokenKind = tokens[cursor].kind
                break if path_kind == Lexer::TokenKind.Comma or path_kind == Lexer::TokenKind.LBrace
                cursor <- cursor + 1
            if cursor < stop and tokens[cursor].kind == Lexer::TokenKind.LBrace:
                path_stop: usize = cursor
                cursor <- cursor + 1
                has_member: mutable bool = false
                while cursor < stop and tokens[cursor].kind != Lexer::TokenKind.RBrace |cursor, emitted, buffer, has_member|:
                    member: Lexer::Token = tokens[cursor]
                    if member.kind == Lexer::TokenKind.Ident:
                        emit_tokens_push_sview(buffer, ", ") if emitted
                        emit_iface_error_path(buffer, tokens, source, path_start, path_stop)
                        buffer.push(46)
                        emit_tokens_push_sview(buffer, Lexer::text_or_empty(member, source, source_length))
                        emitted <- true
                        has_member <- true
                    cursor <- cursor + 1
                # Keep a malformed empty subset identifiable by the interface
                # checker. It is distinct from an empty error set.
                if not has_member:
                    emit_tokens_push_sview(buffer, ", ") if emitted
                    emit_iface_error_path(buffer, tokens, source, path_start, path_stop)
                    emit_tokens_push_sview(buffer, "{}")
                    emitted <- true
                cursor <- cursor + 1 if cursor < stop
            else:
                emit_tokens_push_sview(buffer, ", ") if emitted
                emit_iface_error_path(buffer, tokens, source, path_start, cursor)
                emitted <- true
