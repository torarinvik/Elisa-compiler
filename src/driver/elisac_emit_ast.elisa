# `-emit ast` — rendering a declaration's SIGNATURE from the token stream. stage0 prints the
# signature as written, including the region parameters its inference ADDS, and that inference
# is a body dataflow pass rather than a signature-shape test — so both the token range of each
# declaration line and the growth sites inside its body are recovered here.


    # ---- `-emit ast` (ELISA_STAGE1_EMIT=ast) ----------------------------------------------
    #
    # stage0's parse-tree summary, reproduced line for line for the declaration kinds this
    # AST models: the `File: PATH (N declarations)` header, then one summary line per
    # declaration (`def NAME(N params) -> RET (M stmts)`, `struct NAME[T] (K fields)`,
    # `module NAME: (K decls)` with children indented, `type NAME = TARGET`, `using NAME`).
    # stage0 prints NO line for an enum declaration — it is counted in the header and
    # skipped — and this printer does the same.
    #
    # TYPE RENDERING IS TOKEN-SPAN BASED: stage0's typeStr prints the normalized source
    # spelling of a type, so rather than porting its two-hundred-line shape switch, the
    # return type / generic bracket / alias target are re-rendered from the declaration
    # line's TOKENS with stage0's spacing rules (", " after a comma, a space after the
    # heap/stack/static/mutable/tail storage keywords, nothing elsewhere). That covers every
    # type the language can spell with one rule set instead of one arm per shape.

def emit_ast_token_needs_space(kind: Lexer::TokenKind) -> bool can[Abort.Panic]:
    true return if kind == Lexer::TokenKind.Heap
    true return if kind == Lexer::TokenKind.Stack
    true return if kind == Lexer::TokenKind.Static
    true return if kind == Lexer::TokenKind.Mutable
    true return if kind == Lexer::TokenKind.Tail
    return false




# Render tokens [from, to) of the declaration line with stage0's type spacing.
def emit_ast_render_tokens(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, from_index: usize, to_index: usize) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate:
        for render_index in from_index..<to_index |buffer, tokens, source, from_index, to_index|:
            render_token: Lexer::Token = tokens[render_index]
            render_text: sview = Lexer::text_or_empty(render_token, source)
            # `errorset R` declares a generic ERROR-SET parameter. stage0's parser consumes
            # the keyword and keeps only the name, so every rendered surface prints `[R]`.
            # That is the opposite of `permission P` below, which stage0 keeps verbatim, so
            # the two keywords cannot share a rule: skip this one rather than spacing it.
            continue if render_token.kind == Lexer::TokenKind.Ident and render_text == "errorset" and render_index + 1 < to_index and tokens[render_index + 1].kind == Lexer::TokenKind.Ident
            # An error-UNION return renders as `V error[...]` — one space before `error`.
            buffer.push(32) if render_index > from_index and render_token.kind == Lexer::TokenKind.Error
            # Function types use the same normalized gap as stage0's typeStr:
            # `fn(...) -> T`. The token-span printer already normalizes commas and
            # colons, but omitted both sides of an arrow, which only surfaced when an
            # AST fixture combined an export-type declaration with a callback field.
            buffer.push(32) if render_index > from_index and (render_token.kind == Lexer::TokenKind.Arrow or tokens[render_index - 1].kind == Lexer::TokenKind.Arrow)
            emit_tokens_push_sview(buffer, render_text)
            if render_token.kind == Lexer::TokenKind.Comma:
                buffer.push(32)
            elif render_token.kind == Lexer::TokenKind.Colon:
                # A value-generic's annotation (`[T, N: usize]`) keeps stage0's `: ` gap —
                # measured identically on the ast, iface, and fmt surfaces.
                buffer.push(32)
            elif emit_ast_token_needs_space(render_token.kind):
                buffer.push(32)
            elif render_token.kind == Lexer::TokenKind.Ident and render_text == "permission" and render_index + 1 < to_index and tokens[render_index + 1].kind == Lexer::TokenKind.Ident:
                # A permission generic parameter (`[A, R, permission P]`) — `permission` is an
                # ordinary identifier to the lexer, so its keyword gap is text-decided.
                buffer.push(32)




    # The token index range of declaration LINE's signature: first token on the line to the
    # depth-0 `:` (or the line's end). Brackets and parens nest; a `:` inside `[...]`/`(...)`
    # (a parameter annotation) does not close the signature.
def emit_ast_line_range(tokens: darray[Lexer::Token]&, line: u32) -> (found: bool, start: usize, stop: usize) can[Abort.Panic]:
    start_index: mutable usize = 0
    found_start: mutable bool = false
    for scan_index in 0..<tokens.count |start_index, found_start, tokens, line|:
        continue if found_start
        scan_token: Lexer::Token = tokens[scan_index]
        continue if scan_token.line != line
        continue if scan_token.kind == Lexer::TokenKind.Newline or scan_token.kind == Lexer::TokenKind.Indent or scan_token.kind == Lexer::TokenKind.Dedent
        start_index <- scan_index
        found_start <- true
    (false, 0, 0) return if not found_start
    stop_index: mutable usize = start_index
    depth: mutable i64 = 0
    scanning: mutable bool = true
    while scanning and stop_index < tokens.count |stop_index, depth, scanning, tokens, line|:
        stop_token: Lexer::Token = tokens[stop_index]
        if stop_token.line != line or stop_token.kind == Lexer::TokenKind.Newline:
            scanning <- false
        else:
            depth <- depth + 1 if stop_token.kind == Lexer::TokenKind.LParen or stop_token.kind == Lexer::TokenKind.LBracket
            depth <- depth - 1 if stop_token.kind == Lexer::TokenKind.RParen or stop_token.kind == Lexer::TokenKind.RBracket
            if depth == 0 and stop_token.kind == Lexer::TokenKind.Colon:
                scanning <- false
            else:
                stop_index <- stop_index + 1
    return (true, start_index, stop_index)




# The same range keyed by the node's BYTE OFFSET (§4.2). A `#line` directive makes line numbers
# non-unique across an expanded unit (every included file restarts at 1), so a line-keyed lookup
# cannot survive stage0's directive-bearing expansion; a byte offset can. Binary-search the
# token at `offset`, walk back to the first non-layout token on that token's line, and extend
# exactly as emit_ast_line_range does — so on today's directive-free units the two agree byte
# for byte (the four emit ratchets pin that). offset 0 is a GENERATED node (Ast::pos_at_line):
# fall back to the line.
def emit_ast_range_at(tokens: darray[Lexer::Token]&, line: u32, offset: u32) -> (found: bool, start: usize, stop: usize) can[Abort.Panic]:
    emit_ast_line_range(tokens, line) return if offset == 0 or tokens.count == 0
    low: mutable usize = 0
    high: mutable usize = tokens.count
    while low < high |low, high, tokens, offset|:
        mid: usize = low + (high - low) / 2
        if tokens[mid].start < offset:
            low <- mid + 1
        else:
            high <- mid
    emit_ast_line_range(tokens, line) return if low >= tokens.count or tokens[low].start != offset
    anchor_line: u32 = tokens[low].line
    emit_ast_line_range(tokens, line) return if anchor_line != line
    start_index: mutable usize = low
    while start_index > 0 |start_index, tokens, anchor_line|:
        previous: Lexer::Token = tokens[start_index - 1]
        break if previous.line != anchor_line
        break if previous.kind == Lexer::TokenKind.Newline or previous.kind == Lexer::TokenKind.Indent or previous.kind == Lexer::TokenKind.Dedent
        start_index <- start_index - 1
    return emit_ast_line_range(tokens, anchor_line)




# The physical end of a declaration line, including tokens after a depth-0 colon. The AST
# summary's signature range deliberately stops at that colon, but typed extern globals need the
# complete type span after it.
def emit_ast_line_end(tokens: darray[Lexer::Token]&, line: u32, from_index: usize) -> usize can[Abort.Panic]:
    stop_index: mutable usize = from_index
    while stop_index < tokens.count and tokens[stop_index].line == line and tokens[stop_index].kind != Lexer::TokenKind.Newline |stop_index, tokens, line|:
        stop_index <- stop_index + 1
    return stop_index




# ` -> RET` for the def at LINE, rendered from its signature tokens (empty when the def
# has no arrow). RET ends at the depth-0 `:` or a trailing `can` effects clause.
def emit_ast_return_segment(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32, offset: u32) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        line_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
        return if not line_range.found
        arrow_index: mutable usize = 0
        arrow_found: mutable bool = false
        probe_depth: mutable i64 = 0
        for probe_index in line_range.start..<line_range.stop |arrow_index, arrow_found, probe_depth, tokens|:
            probe_token: Lexer::Token = tokens[probe_index]
            probe_depth <- probe_depth + 1 if probe_token.kind == Lexer::TokenKind.LParen or probe_token.kind == Lexer::TokenKind.LBracket
            probe_depth <- probe_depth - 1 if probe_token.kind == Lexer::TokenKind.RParen or probe_token.kind == Lexer::TokenKind.RBracket
            continue if arrow_found
            if probe_depth == 0 and probe_token.kind == Lexer::TokenKind.Arrow:
                arrow_index <- probe_index
                arrow_found <- true
        return if not arrow_found
        stop_at: mutable usize = line_range.stop
        for stop_probe in (arrow_index + 1)..<line_range.stop |stop_at, tokens, source, arrow_index|:
            continue if stop_at != 0 and stop_at < line_range.stop and stop_probe >= stop_at
            stop_probe_token: Lexer::Token = tokens[stop_probe]
            if stop_probe_token.kind == Lexer::TokenKind.Ident and Lexer::text_or_empty(stop_probe_token, source) == "can":
                stop_at <- stop_probe
            # A trailing `@r` region qualifier is not part of the type expression, but
            # stage0's summary now spells it as a PREFIX: `-> r i64&` for `-> i64& @r`,
            # `-> scratch i64&` for `-> i64& @scratch` (measured 2026-09-05; an earlier
            # stage0 omitted it, which is what the previous version of this code assumed).
            # Stop the type before the `@` and remember the region name to print first.
            stop_at <- stop_probe if stop_probe_token.kind == Lexer::TokenKind.At
            stop_at <- stop_probe if stop_probe_token.kind == Lexer::TokenKind.Assign
        emit_tokens_push_sview(buffer, " -> ")
        # Only a REFERENCE return carries the prefix: stage0 prints `-> darray[i64]` for
        # `-> darray[i64] @r` but `-> r i64&` for `-> i64& @r` (both measured). The region
        # is the referent's lifetime, so a by-value container does not spell it.
        return_is_reference: mutable bool = false
        for amp_probe in (arrow_index + 1)..<stop_at |return_is_reference, tokens|:
            return_is_reference <- true if tokens[amp_probe].kind == Lexer::TokenKind.Ampersand
        for region_probe in (arrow_index + 1)..<line_range.stop |buffer, tokens, source, stop_at, return_is_reference|:
            break if not return_is_reference
            region_probe_token: Lexer::Token = tokens[region_probe]
            break if region_probe_token.kind == Lexer::TokenKind.Colon
            if region_probe_token.kind == Lexer::TokenKind.At and region_probe + 1 < line_range.stop and tokens[region_probe + 1].kind == Lexer::TokenKind.Ident:
                emit_tokens_push_sview(buffer, Lexer::text_or_empty(tokens[region_probe + 1], source))
                emit_tokens_push_sview(buffer, " ")
                break
        emit_ast_render_tokens(buffer, tokens, source, arrow_index + 1, stop_at)




    # Extern declarations keep their capability list in parser side tables rather than in
    # Decl.Extern. Recover the source `can[...]` clause for the AST summary after rendering the
    # return type; omitting it loses part of the declaration signature and changes the public
    # contract shown by `-emit ast`.
def emit_ast_extern_effects(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32, offset: u32) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        line_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
        return if not line_range.found
        arrow_found: mutable bool = false
        depth: mutable i64 = 0
        for effect_probe in line_range.start..<line_range.stop |arrow_found, depth, tokens, source, buffer, line_range|:
            effect_token: Lexer::Token = tokens[effect_probe]
            depth <- depth + 1 if effect_token.kind == Lexer::TokenKind.LParen or effect_token.kind == Lexer::TokenKind.LBracket
            depth <- depth - 1 if effect_token.kind == Lexer::TokenKind.RParen or effect_token.kind == Lexer::TokenKind.RBracket
            if effect_token.kind == Lexer::TokenKind.Arrow and depth == 0:
                arrow_found <- true
            elif arrow_found and depth == 0 and effect_token.kind == Lexer::TokenKind.Ident and Lexer::text_or_empty(effect_token, source) == "can":
                emit_tokens_push_sview(buffer, " ")
                emit_ast_render_tokens(buffer, tokens, source, effect_probe, line_range.stop)
                return




# Count the source parameters of a frame law. Frame laws are represented by Decl.Law for
# semantic checking, while stage0 exposes their zero-body callable in the AST summary.
def emit_ast_law_param_count(tokens: darray[Lexer::Token]&, line: u32, offset: u32) -> u64 can[Abort.Panic]:
    line_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
    return 0 if not line_range.found
    opened: mutable bool = false
    depth: mutable i64 = 0
    saw_parameter: mutable bool = false
    commas: mutable u64 = 0
    for law_probe in line_range.start..<line_range.stop |opened, depth, saw_parameter, commas, tokens|:
        law_token: Lexer::Token = tokens[law_probe]
        if not opened:
            if law_token.kind == Lexer::TokenKind.LParen:
                opened <- true
                depth <- 1
            continue
        if law_token.kind == Lexer::TokenKind.LParen or law_token.kind == Lexer::TokenKind.LBracket:
            depth <- depth + 1
        elif law_token.kind == Lexer::TokenKind.RParen or law_token.kind == Lexer::TokenKind.RBracket:
            depth <- depth - 1
            break if depth == 0
        elif depth == 1 and law_token.kind == Lexer::TokenKind.Comma:
            commas <- commas + 1
        elif depth == 1 and law_token.kind == Lexer::TokenKind.Ident:
            saw_parameter <- true
    return 0 if not saw_parameter else commas + 1




def emit_ast_is_law_callable(name: sview, annotations: darray[Ast::EnumAnnotation]&) -> bool:
    # Predicate laws retain a semantic Decl.Law node but also synthesize a normal bool
    # function. The latter has no source `-> bool` arrow to recover, so the parser marks
    # the law owner with the same private sentinel used by the semantic law checks.
    for annotation in annotations:
        return true if annotation.owner == name and annotation.line == 3900000025
    return false




def emit_ast_generated_typestate_return(buffer: mutable darray[u8]&, name: sview, return_type: Ast::Expr?, annotations: darray[Ast::EnumAnnotation]&, tokens: darray[Lexer::Token]&, source: u8&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    generated: mutable bool = false
    for annotation in annotations |name|:
        generated <- true if annotation.owner == name and annotation.name == "__typestate_generated"
    return false if not generated
    if return_type is generated_type:
        emit_tokens_push_sview(buffer, " -> ")
        FmtUnparse::fmt_expr(buffer, generated_type, tokens, source)
        return true
    return false




    # `[T, @owner]` after a struct/def NAME, when the declaration carries a generic bracket.
def emit_ast_generic_segment(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32, offset: u32) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        line_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
        return if not line_range.found
        # The bracket right after the declaration NAME: token 0 is the keyword, token 1 the
        # name, so a generic bracket is token 2. A def's parameter list follows in parens.
        bracket_index: usize = line_range.start + 2
        return if bracket_index >= line_range.stop
        return if tokens[bracket_index].kind != Lexer::TokenKind.LBracket
        close_index: mutable usize = bracket_index
        close_depth: mutable i64 = 0
        closing: mutable bool = true
        while closing and close_index < line_range.stop |close_index, close_depth, closing, tokens|:
            close_token: Lexer::Token = tokens[close_index]
            close_depth <- close_depth + 1 if close_token.kind == Lexer::TokenKind.LBracket
            close_depth <- close_depth - 1 if close_token.kind == Lexer::TokenKind.RBracket
            if close_depth == 0:
                closing <- false
            else:
                close_index <- close_index + 1
        emit_ast_render_tokens(buffer, tokens, source, bracket_index, close_index + 1)




    # `type NAME = TARGET` — the target is everything after the depth-0 `=` on the line.
def emit_ast_alias_target(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32, offset: u32) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        line_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
        return if not line_range.found
        equals_index: mutable usize = 0
        equals_found: mutable bool = false
        for eq_probe in line_range.start..<line_range.stop |equals_index, equals_found, tokens|:
            continue if equals_found
            if tokens[eq_probe].kind == Lexer::TokenKind.Assign:
                equals_index <- eq_probe
                equals_found <- true
        return if not equals_found
        emit_ast_render_tokens(buffer, tokens, source, equals_index + 1, line_range.stop)




    # Refinement aliases are intentionally stored as a plain base type in Decl.Alias while
    # their predicate is retained in parser side tables. Detect both source refinement forms
    # here so the AST report can apply exprStr's `<type>` rendering without relying on a node
    # shape that is not present in this compact declaration representation.
def emit_ast_alias_is_refinement(tokens: darray[Lexer::Token]&, source: u8&, line: u32, offset: u32) -> bool can[Abort.Panic]:
    line_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
    return false if not line_range.found
    equals_found: mutable bool = false
    for alias_probe in line_range.start..<line_range.stop |equals_found, tokens, source|:
        alias_token: Lexer::Token = tokens[alias_probe]
        if alias_token.kind == Lexer::TokenKind.Assign:
            equals_found <- true
        elif equals_found and alias_token.kind == Lexer::TokenKind.Is:
            return true
        elif equals_found and alias_token.kind == Lexer::TokenKind.Ident:
            alias_text: sview = Lexer::text_or_empty(alias_token, source)
            return true if alias_text == "is" or alias_text == "where"
    return false




    # A method call that can ALLOCATE into its receiver — the growth sites stage0's region
    # inference keys on.
def emit_ast_is_growth_method(name: sview) -> bool:
    return when name:
        "push" | "put" | "extend" | "insert" | "reserve" | "resize" | "append" -> true
        _ -> false




# stage0's region inference is a BODY dataflow pass, not a signature-shape test: a
# reference parameter earns an inferred region only when the body actually GROWS it
# through an implicit allocation (`p.push(..)`, `p.f <- p.f.put(..)`). The std's
# `arena_*` helpers take a container ref of exactly the inferring SHAPE but allocate
# through an explicit arena — either by forwarding to an `arena_*` callee or inside an
# `in a:` block — so stage0 infers nothing for them. This approximates the pass with the
# two signals visible in the token stream: a growth call on the parameter's own chain,
# and the absence of a statement-leading `in` block (an explicit allocation target) in
# the same body.
# `-emit fmt` prints NO inferred region params: across every fmt parity fixture stage0's
# fmt output has not one `[@__rg_` (MEASURED 2026-09-08) -- the weaving is an `-emit ast` /
# `-emit iface` fact. The fmt def printer raises this around its signature call.
global mutable emit_suppress_inferred_regions: bool

def emit_ast_param_grown_in_body(tokens: darray[Lexer::Token]&, source: u8&, line: u32, offset: u32, name: sview) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    false return if emit_suppress_inferred_regions
    can Abort.Panic:
        header_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
        false return if not header_range.found
        body_depth: mutable i64 = 0
        body_entered: mutable bool = false
        body_done: mutable bool = false
        body_grown: mutable bool = false
        body_explicit: mutable bool = false
        for grow_probe in header_range.stop..<tokens.count |body_depth, body_entered, body_done, body_grown, body_explicit, tokens, source, name|:
            continue if body_done
            grow_kind: Lexer::TokenKind = tokens[grow_probe].kind
            if grow_kind == Lexer::TokenKind.Indent:
                body_depth <- body_depth + 1
                body_entered <- true
            elif grow_kind == Lexer::TokenKind.Dedent:
                body_depth <- body_depth - 1
                body_done <- true if body_entered and body_depth <= 0
            elif grow_kind == Lexer::TokenKind.In and grow_probe > 0:
                # `for x in xs` also spells `in`; only a STATEMENT-LEADING `in a:` names an
                # explicit allocation target.
                lead_kind: Lexer::TokenKind = tokens[grow_probe - 1].kind
                body_explicit <- true if lead_kind == Lexer::TokenKind.Indent or lead_kind == Lexer::TokenKind.Newline or lead_kind == Lexer::TokenKind.Dedent
            elif grow_kind == Lexer::TokenKind.Ident and Lexer::text_or_empty(tokens[grow_probe], source) == name:
                chain_index: mutable usize = grow_probe + 1
                chain_scanning: mutable bool = true
                while chain_scanning and chain_index + 2 < tokens.count |chain_index, chain_scanning, body_grown, tokens, source|:
                    if tokens[chain_index].kind != Lexer::TokenKind.Dot or tokens[chain_index + 1].kind != Lexer::TokenKind.Ident:
                        chain_scanning <- false
                    else:
                        chain_method: sview = Lexer::text_or_empty(tokens[chain_index + 1], source)
                        if tokens[chain_index + 2].kind == Lexer::TokenKind.LParen and emit_ast_is_growth_method(chain_method):
                            body_grown <- true
                            chain_scanning <- false
                        else:
                            chain_index <- chain_index + 2
        return body_grown and not body_explicit




    # stage0 prints the region params its inference ADDS: a def with no explicit generic
    # bracket whose parameter list contains a growable REFERENCE (`darray[..]&`, `dict&`)
    # renders as `def f[@__rg_<param>](...)`. Decided from the signature tokens: within the
    # parameter parens, a comma-separated segment that contains a container head AND a
    # trailing `&` contributes `@__rg_` + its first identifier (the parameter name) — gated
    # on that parameter actually being grown by the body.
def emit_ast_inferred_region_params(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32, offset: u32) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        line_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
        return if not line_range.found
        # An explicit bracket right after the name wins; nothing is inferred.
        explicit_index: usize = line_range.start + 2
        return if explicit_index < line_range.stop and tokens[explicit_index].kind == Lexer::TokenKind.LBracket
        emitted_any: mutable bool = false
        paren_depth: mutable i64 = 0
        segment_has_container: mutable bool = false
        segment_has_amp: mutable bool = false
        segment_name: mutable sview = ""
        segment_named: mutable bool = false
        segment_darray: mutable bool = false
        for param_index in line_range.start..<line_range.stop |paren_depth, segment_has_container, segment_has_amp, segment_name, segment_named, segment_darray, emitted_any, buffer, tokens, source, line|:
            param_token: Lexer::Token = tokens[param_index]
            if param_token.kind == Lexer::TokenKind.LParen or param_token.kind == Lexer::TokenKind.LBracket:
                paren_depth <- paren_depth + 1
            elif param_token.kind == Lexer::TokenKind.RParen or param_token.kind == Lexer::TokenKind.RBracket:
                paren_depth <- paren_depth - 1
                if paren_depth == 0 and segment_has_container and segment_has_amp and segment_named and emit_ast_param_grown_in_body(tokens, source, line, offset, segment_name):
                    emit_tokens_push_sview(buffer, "[" if not emitted_any else ", ")
                    emit_tokens_push_sview(buffer, "@__rg_")
                    emit_tokens_push_sview(buffer, segment_name)
                    emitted_any <- true
                if paren_depth == 0:
                    # PAST the parameter list: without this reset the RETURN type's own
                    # closing bracket re-emitted the last segment (`[@__rg_sb, @__rg_sb]`).
                    segment_has_container <- false
                    segment_has_amp <- false
                    segment_named <- false
                    segment_darray <- false
            elif paren_depth >= 1:
                if param_token.kind == Lexer::TokenKind.Comma and paren_depth == 1:
                    if segment_has_container and segment_has_amp and segment_named and emit_ast_param_grown_in_body(tokens, source, line, offset, segment_name):
                        emit_tokens_push_sview(buffer, "[" if not emitted_any else ", ")
                        emit_tokens_push_sview(buffer, "@__rg_")
                        emit_tokens_push_sview(buffer, segment_name)
                        emitted_any <- true
                    segment_has_container <- false
                    segment_has_amp <- false
                    segment_named <- false
                    segment_darray <- false
                elif param_token.kind == Lexer::TokenKind.Comma and paren_depth >= 2 and segment_darray:
                    # A comma INSIDE a darray's bracket is an explicit shape argument
                    # (`darray[u8, shape_in]`) — the region is already named; stage0
                    # infers nothing for this parameter.
                    segment_has_container <- false
                elif param_token.kind == Lexer::TokenKind.Ident:
                    param_text: sview = Lexer::text_or_empty(param_token, source)
                    if not segment_named:
                        segment_name <- param_text
                        segment_named <- true
                    if param_text == "darray" or param_text == "dict" or param_text == "set" or param_text == "dstr":
                        segment_has_container <- true
                        segment_darray <- param_text == "darray"
                elif param_token.kind == Lexer::TokenKind.Ampersand:
                    segment_has_amp <- true
        emit_tokens_push_sview(buffer, "]") if emitted_any




    # The explicit generic bracket on a function can coexist with an inferred region
    # parameter: `def append_one[T](out: mutable darray[T]&, ...)` is printed by stage0 as
    # `def append_one[T, @__rg_out](...)`. The ordinary inferred-region helper above emits a
    # fresh bracket and therefore cannot insert into an already-emitted `[T]`; this variant
    # renders the existing bracket up to its close, then appends the body-proven region names
    # before writing the close. Returning whether an explicit bracket was present keeps the
    # caller from emitting the ordinary helper a second time.
def emit_ast_generic_segment_with_inferred(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32, offset: u32, statements: darray[Ast::Stmt]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        line_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
        false return if not line_range.found
        bracket_index: usize = line_range.start + 2
        false return if bracket_index >= line_range.stop or tokens[bracket_index].kind != Lexer::TokenKind.LBracket
        close_index: mutable usize = bracket_index
        close_depth: mutable i64 = 0
        closing: mutable bool = true
        while closing and close_index < line_range.stop |close_index, close_depth, closing, tokens|:
            close_token: Lexer::Token = tokens[close_index]
            close_depth <- close_depth + 1 if close_token.kind == Lexer::TokenKind.LBracket
            close_depth <- close_depth - 1 if close_token.kind == Lexer::TokenKind.RBracket
            if close_depth == 0:
                closing <- false
            else:
                close_index <- close_index + 1
        return false if close_index >= line_range.stop or tokens[close_index].kind != Lexer::TokenKind.RBracket
        explicit_region_param: mutable bool = false
        for explicit_probe in (bracket_index + 1)..<close_index |explicit_region_param, tokens|:
            explicit_region_param <- true if tokens[explicit_probe].kind == Lexer::TokenKind.At
        # Exclude the existing close so inferred names can be inserted before it.
        emit_ast_render_tokens(buffer, tokens, source, bracket_index, close_index)
        emit_tokens_push_sview(buffer, "]") if explicit_region_param
        return true if explicit_region_param
        emitted_any: mutable bool = false
        paren_depth: mutable i64 = 0
        segment_has_container: mutable bool = false
        segment_has_amp: mutable bool = false
        segment_name: mutable sview = ""
        segment_named: mutable bool = false
        segment_darray: mutable bool = false
        for param_index in line_range.start..<line_range.stop |paren_depth, segment_has_container, segment_has_amp, segment_name, segment_named, segment_darray, emitted_any, buffer, tokens, source, line, statements|:
            param_token: Lexer::Token = tokens[param_index]
            if param_token.kind == Lexer::TokenKind.LParen or param_token.kind == Lexer::TokenKind.LBracket:
                paren_depth <- paren_depth + 1
            elif param_token.kind == Lexer::TokenKind.RParen or param_token.kind == Lexer::TokenKind.RBracket:
                paren_depth <- paren_depth - 1
                if paren_depth == 0 and segment_has_container and segment_has_amp and segment_named and emit_ast_param_grown_in_body(tokens, source, line, offset, segment_name):
                    emit_tokens_push_sview(buffer, ", ") if not emitted_any
                    emit_tokens_push_sview(buffer, "@__rg_")
                    emit_tokens_push_sview(buffer, segment_name)
                    emitted_any <- true
                if paren_depth == 0:
                    segment_has_container <- false
                    segment_has_amp <- false
                    segment_named <- false
                    segment_darray <- false
            elif paren_depth >= 1:
                if param_token.kind == Lexer::TokenKind.Comma and paren_depth == 1:
                    if segment_has_container and segment_has_amp and segment_named and emit_ast_param_grown_in_body(tokens, source, line, offset, segment_name):
                        emit_tokens_push_sview(buffer, ", ") if not emitted_any
                        emit_tokens_push_sview(buffer, "@__rg_")
                        emit_tokens_push_sview(buffer, segment_name)
                        emitted_any <- true
                    segment_has_container <- false
                    segment_has_amp <- false
                    segment_named <- false
                    segment_darray <- false
                elif param_token.kind == Lexer::TokenKind.Comma and paren_depth >= 2 and segment_darray:
                    segment_has_container <- false
                elif param_token.kind == Lexer::TokenKind.Ident:
                    param_text: sview = Lexer::text_or_empty(param_token, source)
                    if not segment_named:
                        segment_name <- param_text
                        segment_named <- true
                    if param_text == "darray" or param_text == "dict" or param_text == "set" or param_text == "dstr":
                        segment_has_container <- true
                        segment_darray <- param_text == "darray"
                elif param_token.kind == Lexer::TokenKind.Ampersand:
                    segment_has_amp <- true
        emit_tokens_push_sview(buffer, "]")
        return true




# Does this unit declare any FUNCTION at all (directly, or inside a module / a `static if`
# branch)? A declaration-only unit — an enum, a const enum, a struct — has nothing for the
# backend to emit, and stage0 writes an (empty) object for it rather than failing. Without
# this, `emitted_count <= 0` read every such file as a codegen failure: MEASURED on 6 of the
# diagnostics fixtures (const_enum_value.neg, duplicate_variant_field.neg, …), which stage0
# accepts and stage1 exited 2 on. The guard stays for a unit that HAS a function and emitted
# none — that is the real failure, and what backend_native_smoke's decline cases assert.
def unit_declares_function(declarations: darray[Ast::Decl]) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        for declaration in declarations:
            if declaration is Decl.Func(udf_fn_name, udf_fn_params, udf_fn_ret, udf_fn_body, udf_fn_effects, udf_fn_decorators, udf_fn_line):
                return true
            if declaration is Decl.Module(udf_mod_name, udf_mod_body, udf_mod_line):
                true return if unit_declares_function(udf_mod_body)
            if declaration is Decl.Scoped(udf_sc_body, udf_sc_line):
                true return if unit_declares_function(udf_sc_body)
        return false




# Whether this unit supplies the complete default runtime itself.  Include-bearing parser and
# compiler tests intentionally compile the runtime into their module; linking the separate runtime
# object on top of that module creates hundreds of duplicate symbols.  This mirrors stage0's
# resultDefinesDefaultElisaCoreRuntime check and is kept structural so it works before LLVM emits
# the object.
def unit_defines_function_named(declarations: darray[Ast::Decl], target: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        for declaration in declarations |target|:
            if declaration is Decl.Func(udfn_name, udfn_params, udfn_ret, udfn_body, udfn_effects, udfn_decorators, udfn_line):
                true return if udfn_name == target
            if declaration is Decl.Module(udfn_mod_name, udfn_mod_body, udfn_mod_line):
                true return if unit_defines_function_named(udfn_mod_body, target)
            if declaration is Decl.Scoped(udfn_sc_body, udfn_sc_line):
                true return if unit_defines_function_named(udfn_sc_body, target)
        return false




def unit_defines_default_runtime(declarations: darray[Ast::Decl]) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        return unit_defines_function_named(declarations, "arena_alloc") and unit_defines_function_named(declarations, "ctx_strlen") and unit_defines_function_named(declarations, "ctx_string_view_slice")




def ast_decl_line(declaration: Ast::Decl) -> u32 can[Abort.Panic, Memory.Allocate]:
    if declaration is Decl.Func(line_fn_name, line_fn_params, line_fn_ret, line_fn_body, line_fn_effects, line_fn_decorators, line_fn_line):
        return line_fn_line.line
    if declaration is Decl.Struct(line_st_name, line_st_members, line_st_aff, line_st_states, line_st_derive, line_st_inv, line_st_line):
        return line_st_line.line
    if declaration is Decl.Enum(line_en_name, line_en_variants, line_en_const, line_en_storage, line_en_line):
        return line_en_line.line
    if declaration is Decl.Alias(line_al_name, line_al_target, line_al_line):
        return line_al_line.line
    if declaration is Decl.Import(line_im_module, line_im_line):
        return line_im_line.line
    if declaration is Decl.Module(line_mod_name, line_mod_body, line_mod_line):
        return line_mod_line.line
    if declaration is Decl.Const(line_c_name, line_c_type, line_c_value, line_c_mut, line_c_line):
        return line_c_line.line
    if declaration is Decl.Extern(line_ex_name, line_ex_ps, line_ex_ar, line_ex_va, line_ex_call, line_ex_ret, line_ex_dec, line_ex_line):
        return line_ex_line.line
    return 4294967295




# The declaration's byte offset — the order key that survives `#line` renumbering (§4.2).
def ast_decl_offset(declaration: Ast::Decl) -> u32 can[Abort.Panic, Memory.Allocate]:
    if declaration is Decl.Func(line_fn_name, line_fn_params, line_fn_ret, line_fn_body, line_fn_effects, line_fn_decorators, line_fn_line):
        return line_fn_line.offset
    if declaration is Decl.Struct(line_st_name, line_st_members, line_st_aff, line_st_states, line_st_derive, line_st_inv, line_st_line):
        return line_st_line.offset
    if declaration is Decl.Enum(line_en_name, line_en_variants, line_en_const, line_en_storage, line_en_line):
        return line_en_line.offset
    if declaration is Decl.Alias(line_al_name, line_al_target, line_al_line):
        return line_al_line.offset
    if declaration is Decl.Import(line_im_module, line_im_line):
        return line_im_line.offset
    if declaration is Decl.Module(line_mod_name, line_mod_body, line_mod_line):
        return line_mod_line.offset
    if declaration is Decl.Const(line_c_name, line_c_type, line_c_value, line_c_mut, line_c_line):
        return line_c_line.offset
    if declaration is Decl.Extern(line_ex_name, line_ex_ps, line_ex_ar, line_ex_va, line_ex_call, line_ex_ret, line_ex_dec, line_ex_line):
        return line_ex_line.offset
    return 4294967295
