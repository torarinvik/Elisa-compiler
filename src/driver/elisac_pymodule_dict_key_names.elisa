    "i64" return if type_name == "dict[i64,i8]" or type_name == "dict[i64,i16]" or type_name == "dict[i64,i32]" or type_name == "dict[i64,int]" or type_name == "dict[i64,isize]" or type_name == "dict[i64,char]" or type_name == "dict[i64,u8]" or type_name == "dict[i64,u16]" or type_name == "dict[i64,u32]" or type_name == "dict[i64,uintptr]" or type_name == "dict[i64,i64]" or type_name == "dict[i64,u64]" or type_name == "dict[i64,usize]" or type_name == "dict[i64,f32]" or type_name == "dict[i64,f64]" or type_name == "dict[i64,bool]" or type_name == "dict[i64,cstr]" or type_name == "dict[i64,sview]" or type_name == "dict[i64,py::Object]" or type_name == "dict[i64,cstr?]" or type_name == "dict[i64,py::Object?]" or type_name == "dict[i64,i8?]" or type_name == "dict[i64,i16?]" or type_name == "dict[i64,i32?]" or type_name == "dict[i64,i64?]" or type_name == "dict[i64,int?]" or type_name == "dict[i64,isize?]" or type_name == "dict[i64,char?]" or type_name == "dict[i64,u8?]" or type_name == "dict[i64,u16?]" or type_name == "dict[i64,u32?]" or type_name == "dict[i64,u64?]" or type_name == "dict[i64,usize?]" or type_name == "dict[i64,uintptr?]" or type_name == "dict[i64,bool?]" or type_name == "dict[i64,f32?]" or type_name == "dict[i64,f64?]"
    "u64" return if type_name == "dict[u64,i8]" or type_name == "dict[u64,i16]" or type_name == "dict[u64,i32]" or type_name == "dict[u64,int]" or type_name == "dict[u64,isize]" or type_name == "dict[u64,char]" or type_name == "dict[u64,u8]" or type_name == "dict[u64,u16]" or type_name == "dict[u64,u32]" or type_name == "dict[u64,uintptr]" or type_name == "dict[u64,i64]" or type_name == "dict[u64,u64]" or type_name == "dict[u64,usize]" or type_name == "dict[u64,f32]" or type_name == "dict[u64,f64]" or type_name == "dict[u64,bool]" or type_name == "dict[u64,cstr]" or type_name == "dict[u64,sview]" or type_name == "dict[u64,py::Object]" or type_name == "dict[u64,cstr?]" or type_name == "dict[u64,py::Object?]" or type_name == "dict[u64,i8?]" or type_name == "dict[u64,i16?]" or type_name == "dict[u64,i32?]" or type_name == "dict[u64,i64?]" or type_name == "dict[u64,int?]" or type_name == "dict[u64,isize?]" or type_name == "dict[u64,char?]" or type_name == "dict[u64,u8?]" or type_name == "dict[u64,u16?]" or type_name == "dict[u64,u32?]" or type_name == "dict[u64,u64?]" or type_name == "dict[u64,usize?]" or type_name == "dict[u64,uintptr?]" or type_name == "dict[u64,bool?]" or type_name == "dict[u64,f32?]" or type_name == "dict[u64,f64?]"
    "cstr" return if type_name == "dict[cstr,i8]" or type_name == "dict[cstr,i16]" or type_name == "dict[cstr,i32]" or type_name == "dict[cstr,int]" or type_name == "dict[cstr,isize]" or type_name == "dict[cstr,char]" or type_name == "dict[cstr,u8]" or type_name == "dict[cstr,u16]" or type_name == "dict[cstr,u32]" or type_name == "dict[cstr,uintptr]" or type_name == "dict[cstr,i64]" or type_name == "dict[cstr,u64]" or type_name == "dict[cstr,usize]" or type_name == "dict[cstr,f32]" or type_name == "dict[cstr,f64]" or type_name == "dict[cstr,bool]" or type_name == "dict[cstr,cstr]" or type_name == "dict[cstr,sview]" or type_name == "dict[cstr,py::Object]" or type_name == "dict[cstr,cstr?]" or type_name == "dict[cstr,py::Object?]" or type_name == "dict[cstr,i8?]" or type_name == "dict[cstr,i16?]" or type_name == "dict[cstr,i32?]" or type_name == "dict[cstr,i64?]" or type_name == "dict[cstr,int?]" or type_name == "dict[cstr,isize?]" or type_name == "dict[cstr,char?]" or type_name == "dict[cstr,u8?]" or type_name == "dict[cstr,u16?]" or type_name == "dict[cstr,u32?]" or type_name == "dict[cstr,u64?]" or type_name == "dict[cstr,usize?]" or type_name == "dict[cstr,uintptr?]" or type_name == "dict[cstr,bool?]" or type_name == "dict[cstr,f32?]" or type_name == "dict[cstr,f64?]"
    "bool" return if type_name == "dict[bool,i8]" or type_name == "dict[bool,i16]" or type_name == "dict[bool,i32]" or type_name == "dict[bool,int]" or type_name == "dict[bool,isize]" or type_name == "dict[bool,char]" or type_name == "dict[bool,u8]" or type_name == "dict[bool,u16]" or type_name == "dict[bool,u32]" or type_name == "dict[bool,uintptr]" or type_name == "dict[bool,i64]" or type_name == "dict[bool,u64]" or type_name == "dict[bool,usize]" or type_name == "dict[bool,f32]" or type_name == "dict[bool,f64]" or type_name == "dict[bool,bool]" or type_name == "dict[bool,cstr]" or type_name == "dict[bool,sview]" or type_name == "dict[bool,py::Object]" or type_name == "dict[bool,cstr?]" or type_name == "dict[bool,py::Object?]" or type_name == "dict[bool,i8?]" or type_name == "dict[bool,i16?]" or type_name == "dict[bool,i32?]" or type_name == "dict[bool,i64?]" or type_name == "dict[bool,int?]" or type_name == "dict[bool,isize?]" or type_name == "dict[bool,char?]" or type_name == "dict[bool,u8?]" or type_name == "dict[bool,u16?]" or type_name == "dict[bool,u32?]" or type_name == "dict[bool,u64?]" or type_name == "dict[bool,usize?]" or type_name == "dict[bool,uintptr?]" or type_name == "dict[bool,bool?]" or type_name == "dict[bool,f32?]" or type_name == "dict[bool,f64?]"
    # Parser-cached `dict[Key, Struct]` spellings are not part of the finite builtin table above.
    # Recover the two top-level components syntactically; nested brackets in a list value do not
    # confuse the split because the comma is accepted only at depth zero.
    if sview_len(type_name) > 6.usize() and type_name[0:5] == "dict[" and sview_at(type_name, sview_len(type_name) - 1.usize()) == 93:
        depth: mutable usize = 0
        for index in 5.usize()..<(sview_len(type_name) - 1.usize()) |type_name, depth|:
            byte: u8 = sview_at(type_name, index)
            depth <- depth + 1.usize() if byte == 91
            depth <- depth - 1.usize() if byte == 93 and depth > 0.usize()
            return type_name[5:index] if byte == 44 and depth == 0.usize()
    return ""
