# `-emit pymodule` — C scalar spellings, and the DEFAULT-ARGUMENT policy. Python defaults stay
# deliberately literal: each admitted form is named explicitly and its value range-checked
# against the C type it will be emitted as.


# C scalar spellings match the native LLVM ABI emitted for the corresponding Elisa source type.
# Empty means that `-emit pymodule-c` should refuse the entry instead of publishing a guessed ABI.
def pymodule_c_type_name(type_name: sview) -> sview can[Abort.Panic]:
    known_type: sview = when type_name:
        "void" -> "void"
        "py::Object" | "py::Object?" -> "PyObject *"
        "cstr" | "cstr?" -> "const char *"
        "sview" -> "ElisaSView"
        "sview?" -> "ElisaOptionalSView"
        "i8" -> "int8_t"
        "i16" -> "int16_t"
        "i32" -> "int32_t"
        "i64" | "char" -> "int64_t"
        "int" | "isize" -> "intptr_t"
        "u8" -> "uint8_t"
        "u16" -> "uint16_t"
        "u32" -> "uint32_t"
        "u64" -> "uint64_t"
        "usize" | "uintptr" -> "uintptr_t"
        "bool" -> "bool"
        "f32" -> "float"
        "f64" -> "double"
        "i8?" -> "ElisaOptionalI8"
        "i16?" -> "ElisaOptionalI16"
        "i32?" -> "ElisaOptionalI32"
        "i64?" | "char?" -> "ElisaOptionalI64"
        "int?" | "isize?" -> "ElisaOptionalInt"
        "u8?" -> "ElisaOptionalU8"
        "u16?" -> "ElisaOptionalU16"
        "u32?" -> "ElisaOptionalU32"
        "u64?" -> "ElisaOptionalU64"
        "usize?" | "uintptr?" -> "ElisaOptionalUSize"
        "bool?" -> "ElisaOptionalBool"
        "f32?" -> "ElisaOptionalF32"
        "f64?" -> "ElisaOptionalF64"
        _ -> ""
    return known_type if known_type != ""
    return "ElisaDict" if pymodule_is_dict_type(type_name)
    return "ElisaDArray" if pymodule_is_darray_type(type_name)
    return "ElisaView" if pymodule_is_view_type(type_name)
    return "ElisaSet" if pymodule_is_set_type(type_name)
    return ""




def pymodule_parse_format(type_name: sview) -> sview can[Abort.Panic]:
    format: sview = when type_name:
        "cstr" | "sview" -> "s#"
        "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "char" -> "L"
        "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" -> "K"
        "f32" | "f64" -> "d"
        "bool" -> "p"
        _ -> "O" if type_name != "" else ""
    return format




def pymodule_parameter_is_implicit_optional(type_name: sview) -> bool can[Abort.Panic]:
    return when type_name:
        "py::Object?" | "cstr?" -> true
        _ -> pymodule_is_optional_scalar_type(type_name)




def pymodule_default_is_null(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_is_null(default_inner)
    if expression is Expr.Ident(default_name, default_pos):
        return default_name == "null"
    return false




def pymodule_is_optional_scalar_type(type_name: sview) -> bool can[Abort.Panic]:
    return when type_name:
        "i8?" | "i16?" | "i32?" | "i64?" | "char?" -> true
        "int?" | "isize?" -> true
        "u8?" | "u16?" | "u32?" | "u64?" | "usize?" | "uintptr?" -> true
        "bool?" | "f32?" | "f64?" | "sview?" -> true
        _ -> false




def pymodule_optional_payload_name(type_name: sview) -> sview can[Abort.Panic]:
    return when type_name:
        "i8?" -> "i8"
        "i16?" -> "i16"
        "i32?" -> "i32"
        "i64?" | "char?" -> "i64"
        "int?" | "isize?" -> "int"
        "u8?" -> "u8"
        "u16?" -> "u16"
        "u32?" -> "u32"
        "u64?" -> "u64"
        "usize?" | "uintptr?" -> "usize"
        "bool?" -> "bool"
        "f32?" -> "f32"
        "f64?" -> "f64"
        "sview?" -> "sview"
        _ -> ""




# Keep Python defaults intentionally literal. This covers useful scalar/text cases
# (`limit: i64 = 10`, `enabled: bool = false`, `ratio: f64 = 0.5`, `name: cstr = "guest"`)
# plus empty native containers, whose zero-length representation is unambiguous and does not
# require evaluating arbitrary Elisa code in the CPython shim.
def pymodule_default_literal_supported(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.IntLit(default_int_value, _):
        return true
    if expression is Expr.FloatLit(default_float_text, _):
        return true
    if expression is Expr.BoolLit(default_bool_value, _):
        return true
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return pymodule_default_literal_supported(default_operand) if default_operator == Lexer::TokenKind.Minus
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_literal_supported(default_inner)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        return false if default_arguments.count != 0
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            supported_constructor: bool = when default_field:
                "i8" | "i16" | "i32" | "i64" | "s8" | "s16" | "s32" | "s64" | "int" | "isize" | "char" -> true
                "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" -> true
                "f32" | "f64" -> true
                _ -> false
            return false if not supported_constructor
            return pymodule_default_literal_supported(default_base)
    return false




# String defaults are emitted as the original quoted literal in the generated C shim. Keep the
# accepted escape vocabulary identical to the backend's decoder so a default cannot silently
# acquire different bytes at the Python/C boundary.
def pymodule_default_string_literal_supported(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.StringLit(default_string_text, _):
        string_length: usize = default_string_text.len
        scan: mutable usize = 0
        while scan < string_length |scan, default_string_text|:
            if default_string_text[scan] == 92:
                return false if scan + 1 >= string_length
                escaped: u8 = default_string_text[scan + 1]
                return false if escaped != 110 and escaped != 116 and escaped != 114 and escaped != 48 and escaped != 92 and escaped != 34 and escaped != 39
                scan <- scan + 1
            scan <- scan + 1
        return true
    return false




# Locate the parser's lexical module owner for a literal default. The parser canonicalizes
# both `module Outer::Inner:` and a nested `module Outer:` / `module Inner:` to `Outer::Inner`.
def pymodule_default_expression_contains_offset(expression: Ast::Expr, wanted_offset: u32) -> bool can[Abort.Panic, Memory.Allocate]:
    return true if Ast::expr_pos(expression).offset == wanted_offset
    if expression is Expr.Paren(inner, _):
        return pymodule_default_expression_contains_offset(inner, wanted_offset)
    if expression is Expr.Unary(operator, operand, _):
        return pymodule_default_expression_contains_offset(operand, wanted_offset)
    if expression is Expr.Move(operand, _) or expression is Expr.RegionNew(operand, _, _):
        return pymodule_default_expression_contains_offset(operand, wanted_offset)
    if expression is Expr.Binary(left, operator, right, _):
        return true if pymodule_default_expression_contains_offset(left, wanted_offset)
        return pymodule_default_expression_contains_offset(right, wanted_offset)
    if expression is Expr.Field(base, field, _):
        return pymodule_default_expression_contains_offset(base, wanted_offset)
    if expression is Expr.Scope(base, name, _):
        return pymodule_default_expression_contains_offset(base, wanted_offset)
    if expression is Expr.Index(object, index, _):
        return true if pymodule_default_expression_contains_offset(object, wanted_offset)
        return pymodule_default_expression_contains_offset(index, wanted_offset)
    if expression is Expr.Slice(object, low, high, _):
        return true if pymodule_default_expression_contains_offset(object, wanted_offset)
        return true if pymodule_default_expression_contains_offset(low, wanted_offset)
        return pymodule_default_expression_contains_offset(high, wanted_offset)
    if expression is Expr.IndexN(object, arguments, _):
        return true if pymodule_default_expression_contains_offset(object, wanted_offset)
        for argument in arguments:
            return true if pymodule_default_expression_contains_offset(argument, wanted_offset)
    if expression is Expr.Call(callee, arguments, argument_names, _):
        return true if pymodule_default_expression_contains_offset(callee, wanted_offset)
        for argument in arguments:
            return true if pymodule_default_expression_contains_offset(argument, wanted_offset)
    if expression is Expr.Array(elements, _) or expression is Expr.Tuple(elements, _) or expression is Expr.SetLit(elements, _):
        for element in elements:
            return true if pymodule_default_expression_contains_offset(element, wanted_offset)
    if expression is Expr.DictLit(entries, _):
        for entry in entries:
            return true if pymodule_default_expression_contains_offset(entry.key, wanted_offset)
            return true if pymodule_default_expression_contains_offset(entry.value, wanted_offset)
    if expression is Expr.Construct(type_expression, fields, _):
        return true if pymodule_default_expression_contains_offset(type_expression, wanted_offset)
        for field in fields:
            return true if pymodule_default_expression_contains_offset(field.value, wanted_offset)
    if expression is Expr.RecordUpdate(base, fields, _):
        return true if pymodule_default_expression_contains_offset(base, wanted_offset)
        for field in fields:
            return true if pymodule_default_expression_contains_offset(field.value, wanted_offset)
    if expression is Expr.If(condition, then_expression, else_expression, _):
        return true if pymodule_default_expression_contains_offset(condition, wanted_offset)
        return true if pymodule_default_expression_contains_offset(then_expression, wanted_offset)
        return pymodule_default_expression_contains_offset(else_expression, wanted_offset)
    if expression is Expr.Refinement(base, predicate, _):
        return true if pymodule_default_expression_contains_offset(base, wanted_offset)
        return pymodule_default_expression_contains_offset(predicate, wanted_offset)
    return false




def pymodule_default_find_expression_owner(declarations: darray[Ast::Decl]&, current_owner: sview, wanted_offset: u32, found_owner: mutable sview&, found: mutable bool&) -> void can[Abort.Panic, Memory.Allocate]:
    return if found == true
    for declaration in declarations |current_owner, wanted_offset, found_owner, found|:
        if declaration is Decl.Func(name, parameters, return_type, body, effects, decorators, pos):
            for parameter in parameters |current_owner, wanted_offset, found_owner, found|:
                if parameter.has_default and pymodule_default_expression_contains_offset(parameter.default_value, wanted_offset):
                    found_owner <- current_owner
                    found <- true
                    return
        elif declaration is Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, pos):
            for member in members |current_owner, wanted_offset, found_owner, found|:
                if member.has_default and pymodule_default_expression_contains_offset(member.default_value, wanted_offset):
                    found_owner <- current_owner
                    found <- true
                    return
        elif declaration is Decl.Module(module_name, module_body, pos):
            pymodule_default_find_expression_owner(module_body, module_name, wanted_offset, found_owner, found)
            return if found == true
        elif declaration is Decl.Scoped(scoped_body, pos):
            pymodule_default_find_expression_owner(scoped_body, current_owner, wanted_offset, found_owner, found)
            return if found == true




def pymodule_default_expression_owner(file: Ast::File&, expression: Ast::Expr) -> sview can[Abort.Panic, Memory.Allocate]:
    expression_offset: u32 = Ast::expr_pos(expression).offset
    found_owner: mutable sview = ""
    found: mutable bool = false
    pymodule_default_find_expression_owner(file.top_decls, "", expression_offset, found_owner, found)
    return found_owner




def emit_pymodule_manifest_default_literal(buffer: mutable darray[u8]&, file: Ast::File&, expression: Ast::Expr, type_name: sview = "") -> void can[Abort.Panic, Memory.Allocate]:
    if pymodule_default_is_null(expression) and pymodule_parameter_is_implicit_optional(type_name):
        emit_tokens_push_sview(buffer, "None")
        return
    enum_value: (found: bool, value: i64) = pymodule_default_enum_value(file, expression)
    if enum_value.found:
        append_decimal_i64(buffer, enum_value.value)
        return
    if expression is Expr.StringLit(default_string_text, _):
        buffer.push(92)
        buffer.push(34)
        emit_tokens_push_json_string(buffer, default_string_text)
        buffer.push(92)
        buffer.push(34)
        return
    if expression is Expr.Array(default_array_elements, default_array_pos):
        element_type_name: sview = pymodule_darray_element_name(type_name) if pymodule_is_darray_type(type_name) else pymodule_view_element_name(type_name) if pymodule_is_view_type(type_name) else ""
        if type_name == "darray[u8]":
            all_bytes: mutable bool = true
            for default_byte_element in default_array_elements:
                byte_value: (found: bool, is_negative: bool, magnitude: u64) = pymodule_default_signed_literal_value(file, default_byte_element)
                all_bytes <- false if not byte_value.found or byte_value.is_negative or byte_value.magnitude > 255u64
            if all_bytes:
                buffer.push(98)
                buffer.push(92)
                buffer.push(34)
                for default_byte_index in 0..<default_array_elements.count |buffer, default_array_elements, default_byte_index|:
                    byte_value: (found: bool, is_negative: bool, magnitude: u64) = pymodule_default_signed_literal_value(file, default_array_elements[default_byte_index])
                    buffer.push(92)
                    buffer.push(92)
                    buffer.push(120)
                    emit_pymodule_signature_hex(buffer, byte_value.magnitude.u32(), 2)
                buffer.push(92)
                buffer.push(34)
                return
        emit_tokens_push_sview(buffer, "[")
        for default_element_index in 0..<default_array_elements.count |buffer, default_array_elements, default_element_index, element_type_name|:
            emit_tokens_push_sview(buffer, ", ") if default_element_index > 0
            emit_pymodule_manifest_default_literal(buffer, file, default_array_elements[default_element_index], element_type_name)
        emit_tokens_push_sview(buffer, "]")
        return
    if expression is Expr.DictLit(default_dict_entries, default_dict_pos):
        key_type_name: sview = pymodule_dict_key_name(type_name) if pymodule_is_dict_type(type_name) else ""
        value_type_name: sview = pymodule_dict_value_name(type_name) if pymodule_is_dict_type(type_name) else ""
        emit_tokens_push_sview(buffer, "{")
        for default_entry_index in 0..<default_dict_entries.count |buffer, default_dict_entries, default_entry_index, key_type_name, value_type_name|:
            emit_tokens_push_sview(buffer, ", ") if default_entry_index > 0
            emit_pymodule_manifest_default_literal(buffer, file, default_dict_entries[default_entry_index].key, key_type_name)
            emit_tokens_push_sview(buffer, ": ")
            emit_pymodule_manifest_default_literal(buffer, file, default_dict_entries[default_entry_index].value, value_type_name)
        emit_tokens_push_sview(buffer, "}")
        return
    if expression is Expr.SetLit(default_set_elements, default_set_pos):
        if default_set_elements.count == 0:
            emit_tokens_push_sview(buffer, "set()")
            return
        emit_tokens_push_sview(buffer, "{")
        set_element_type_name: sview = pymodule_set_element_name(type_name) if pymodule_is_set_type(type_name) else ""
        for default_set_element_index in 0..<default_set_elements.count |buffer, default_set_elements, default_set_element_index, set_element_type_name|:
            emit_tokens_push_sview(buffer, ", ") if default_set_element_index > 0
            emit_pymodule_manifest_default_literal(buffer, file, default_set_elements[default_set_element_index], set_element_type_name)
        emit_tokens_push_sview(buffer, "}")
        return
    if expression is Expr.Construct(default_construct_type, default_construct_fields, default_construct_pos):
        emit_tokens_push_sview(buffer, "{")
        for default_construct_field_index in 0..<default_construct_fields.count |buffer, file, type_name, default_construct_fields, default_construct_field_index|:
            default_construct_field: Ast::FieldInit = default_construct_fields[default_construct_field_index]
            emit_tokens_push_sview(buffer, ", ") if default_construct_field_index > 0
            buffer.push(92)
            buffer.push(34)
            emit_tokens_push_json_string(buffer, default_construct_field.name)
            buffer.push(92)
            buffer.push(34)
            emit_tokens_push_sview(buffer, ": ")
            construct_field_type_name: sview = pymodule_struct_member_type_name(file, type_name, default_construct_field.name)
            emit_pymodule_manifest_default_literal(buffer, file, default_construct_field.value, construct_field_type_name)
        emit_tokens_push_sview(buffer, "}")
        return
    emit_pymodule_default_signature_literal(buffer, file, expression, type_name)




def pymodule_default_integer_literal_supported(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.IntLit(default_int_value, _):
        return true
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return pymodule_default_integer_literal_supported(default_operand) if default_operator == Lexer::TokenKind.Minus
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_integer_literal_supported(default_inner)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        return false if default_arguments.count != 0
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            return false if default_field != "i8" and default_field != "i16" and default_field != "i32" and default_field != "i64" and default_field != "s8" and default_field != "s16" and default_field != "s32" and default_field != "s64" and default_field != "int" and default_field != "isize" and default_field != "char" and default_field != "u8" and default_field != "u16" and default_field != "u32" and default_field != "u64" and default_field != "usize" and default_field != "uintptr"
            return pymodule_default_integer_literal_supported(default_base)
    return false




# Resolve a const/plain enum member to the value recorded by the parser.  Enum types erase to
# their scalar backing type at the Python boundary, so a default such as `Mode.Ready` should be
# treated exactly like the integer it compiles to.  The parser metadata is authoritative here:
# it preserves explicit gaps and implicit continuation values, including enums nested in modules.
def pymodule_default_alias_scope_matches(alias_scope: sview, lexical_owner: sview) -> bool can[Abort.Panic]:
    return true if alias_scope == "" or alias_scope == lexical_owner
    return false if alias_scope.len >= lexical_owner.len or lexical_owner[alias_scope.len] != 58
    return false if alias_scope.len + 1.usize() >= lexical_owner.len or lexical_owner[alias_scope.len + 1.usize()] != 58
    for index in 0..<alias_scope.len |alias_scope, lexical_owner|:
        return false if alias_scope[index] != lexical_owner[index]
    return true




def pymodule_default_module_path_parts(path: sview, parts: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    start: mutable usize = 0
    offset: mutable usize = 0
    while offset < path.len |start, offset, path, parts|:
        if offset + 1.usize() < path.len and path[offset] == 58 and path[offset + 1.usize()] == 58:
            parts.push(string_view_slice(path, start.i64(), offset.i64()))
            offset <- offset + 2.usize()
            start <- offset
        else:
            offset <- offset + 1.usize()
    return if start == path.len and path.len == 0
    parts.push(string_view_slice(path, start.i64(), path.len.i64()))




def pymodule_default_visible_module_alias(file: Ast::File&, name: sview, lexical_owner: sview, depth: u32 = 0) -> (index: usize, ambiguous: bool) can[Abort.Panic, Memory.Allocate]:
    return (file.enum_annotations.count, false) if depth > PYMODULE_DEFAULT_ENUM_EXPR_DEPTH_LIMIT
    best_index: mutable usize = file.enum_annotations.count
    best_rank: mutable usize = 0
    ambiguous: mutable bool = false
    best_target_path: mutable darray[u8] = []
    best_target_identity_available: mutable bool = false
    for index in 0..<file.enum_annotations.count |best_index, best_rank, ambiguous, best_target_path, best_target_identity_available, file, name, lexical_owner, depth|:
        annotation: Ast::EnumAnnotation = file.enum_annotations[index]
        continue if annotation.name != "__using_alias" or annotation.owner != name
        continue if not pymodule_default_alias_scope_matches(annotation.module, lexical_owner)
        rank: usize = annotation.module.len
        continue if best_index < file.enum_annotations.count and rank < best_rank
        candidate_target_owner: mutable sview = ""
        candidate_target_count: mutable usize = 0
        for target_annotation in file.enum_annotations |annotation, candidate_target_owner, candidate_target_count|:
            if target_annotation.name == "__using_alias_target" and target_annotation.module == annotation.module and target_annotation.line == annotation.line and target_annotation.offset == annotation.offset:
                candidate_target_owner <- target_annotation.owner
                candidate_target_count <- candidate_target_count + 1.usize()
        candidate_target_path: mutable darray[u8] = []
        if candidate_target_count == 1.usize() and candidate_target_owner != "":
            pymodule_default_resolve_alias_target_path(file, candidate_target_owner, annotation.module, annotation.offset, annotation.owner, candidate_target_path, depth + 1)
        # The resolver leaves a canonical candidate path in the output even when that
        # module is unresolved. Keep that identity for duplicate-alias coalescing; callers
        # still use the resolver's bool when they need a real module.
        candidate_target_identity_available: bool = candidate_target_count == 1.usize() and candidate_target_owner != "" and candidate_target_path.count > 0.usize()
        if best_index == file.enum_annotations.count or rank > best_rank:
            best_index <- index
            best_rank <- rank
            ambiguous <- false
            best_target_path <- [byte for byte in candidate_target_path]
            best_target_identity_available <- candidate_target_identity_available
        elif rank == best_rank:
            same_target: bool = best_target_identity_available and candidate_target_identity_available and pymodule_default_module_path_bytes_equal(best_target_path, candidate_target_path)
            ambiguous <- true if not same_target
    return (best_index, ambiguous)




def pymodule_default_module_identifier_path_rank(module_path: sview, name: sview, lexical_owner: sview) -> (found: bool, rank: usize) can[Abort.Panic]:
    return (true, 0) if module_path == name
    return (false, 0) if module_path.len <= name.len + 2.usize()
    suffix_start: usize = module_path.len - name.len
    return (false, 0) if module_path[suffix_start - 2.usize()] != 58 or module_path[suffix_start - 1.usize()] != 58
    for index in 0..<name.len |module_path, name, suffix_start|:
        return (false, 0) if module_path[suffix_start + index] != name[index]
    prefix_length: usize = suffix_start - 2.usize()
    return (false, 0) if prefix_length == 0
    prefix: sview = string_view_slice(module_path, 0, prefix_length.i64())
    return (pymodule_default_alias_scope_matches(prefix, lexical_owner), prefix_length + 1.usize())




def pymodule_default_find_visible_module_identifier(declarations: darray[Ast::Decl]&, name: sview, lexical_owner: sview, best_rank: mutable usize&, best_owner: mutable sview&, ambiguous: mutable bool&) -> void can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |name, lexical_owner, best_rank, best_owner, ambiguous|:
        if declaration is Decl.Module(module_name, module_body, _):
            candidate: (found: bool, rank: usize) = pymodule_default_module_identifier_path_rank(module_name, name, lexical_owner)
            if candidate.found:
                if best_owner == "" or candidate.rank > best_rank:
                    best_rank <- candidate.rank
                    best_owner <- module_name
                    ambiguous <- false
                elif candidate.rank == best_rank and best_owner != module_name:
                    ambiguous <- true
            pymodule_default_find_visible_module_identifier(module_body, name, lexical_owner, best_rank, best_owner, ambiguous)
        elif declaration is Decl.Scoped(scoped_body, _):
            pymodule_default_find_visible_module_identifier(scoped_body, name, lexical_owner, best_rank, best_owner, ambiguous)




def pymodule_default_visible_module_identifier(file: Ast::File&, name: sview, lexical_owner: sview) -> (found: bool, ambiguous: bool, owner: sview) can[Abort.Panic, Memory.Allocate]:
    best_rank: mutable usize = 0
    best_owner: mutable sview = ""
    ambiguous: mutable bool = false
    pymodule_default_find_visible_module_identifier(file.top_decls, name, lexical_owner, best_rank, best_owner, ambiguous)
    return (best_owner != "", ambiguous, best_owner)




const PYMODULE_DEFAULT_ENUM_EXPR_DEPTH_LIMIT: u32 = 2000



def pymodule_default_append_text_bytes(bytes: mutable darray[u8]&, text: sview) -> void can[Abort.Panic, Memory.Allocate]:
    for index in 0..<text.len |bytes, text|:
        bytes.push(text[index])




def pymodule_default_visible_prior_module_alias(file: Ast::File&, name: sview, lexical_owner: sview, before_offset: u32, depth: u32 = 0) -> (index: usize, ambiguous: bool) can[Abort.Panic, Memory.Allocate]:
    return (file.enum_annotations.count, false) if depth > PYMODULE_DEFAULT_ENUM_EXPR_DEPTH_LIMIT
    best_index: mutable usize = file.enum_annotations.count
    best_rank: mutable usize = 0
    ambiguous: mutable bool = false
    best_target_path: mutable darray[u8] = []
    best_target_identity_available: mutable bool = false
    for index in 0..<file.enum_annotations.count |best_index, best_rank, ambiguous, best_target_path, best_target_identity_available, file, name, lexical_owner, before_offset, depth|:
        annotation: Ast::EnumAnnotation = file.enum_annotations[index]
        continue if annotation.name != "__using_alias" or annotation.owner != name
        continue if annotation.offset >= before_offset
        continue if not pymodule_default_alias_scope_matches(annotation.module, lexical_owner)
        rank: usize = annotation.module.len
        continue if best_index < file.enum_annotations.count and rank < best_rank
        candidate_target_owner: mutable sview = ""
        candidate_target_count: mutable usize = 0
        for target_annotation in file.enum_annotations |annotation, candidate_target_owner, candidate_target_count|:
            if target_annotation.name == "__using_alias_target" and target_annotation.module == annotation.module and target_annotation.line == annotation.line and target_annotation.offset == annotation.offset:
                candidate_target_owner <- target_annotation.owner
                candidate_target_count <- candidate_target_count + 1.usize()
        candidate_target_path: mutable darray[u8] = []
        if candidate_target_count == 1.usize() and candidate_target_owner != "":
            pymodule_default_resolve_alias_target_path(file, candidate_target_owner, annotation.module, annotation.offset, annotation.owner, candidate_target_path, depth + 1)
        candidate_target_identity_available: bool = candidate_target_count == 1.usize() and candidate_target_owner != "" and candidate_target_path.count > 0.usize()
        if best_index == file.enum_annotations.count or rank > best_rank:
            best_index <- index
            best_rank <- rank
            ambiguous <- false
            best_target_path <- [byte for byte in candidate_target_path]
            best_target_identity_available <- candidate_target_identity_available
        elif rank == best_rank:
            same_target: bool = best_target_identity_available and candidate_target_identity_available and pymodule_default_module_path_bytes_equal(best_target_path, candidate_target_path)
            ambiguous <- true if not same_target
    return (best_index, ambiguous)




def pymodule_default_module_path_matches_bytes(module_path: sview, path_bytes: darray[u8]&) -> bool can[Abort.Panic]:
    return false if module_path.len != path_bytes.count
    for index in 0..<module_path.len |module_path, path_bytes|:
        return false if module_path[index] != path_bytes[index]
    return true




def pymodule_default_module_path_bytes_equal(left: darray[u8]&, right: darray[u8]&) -> bool can[Abort.Panic]:
    return false if left.count != right.count
    for index in 0..<left.count |left, right|:
        return false if left[index] != right[index]
    return true




def pymodule_default_module_path_exists(declarations: darray[Ast::Decl]&, path_bytes: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations:
        if declaration is Decl.Module(module_name, module_body, _):
            return true if pymodule_default_module_path_matches_bytes(module_name, path_bytes)
            return true if pymodule_default_module_path_exists(module_body, path_bytes)
        elif declaration is Decl.Scoped(scoped_body, _):
            return true if pymodule_default_module_path_exists(scoped_body, path_bytes)
    return false




def pymodule_default_module_path_declares_enum(file: Ast::File&, enum_name: sview, path_bytes: darray[u8]&) -> bool can[Abort.Panic]:
    for enum_index in 0..<file.enum_decl_names.count |file, enum_name, path_bytes|:
        continue if file.enum_decl_names[enum_index] != enum_name
        continue if enum_index >= file.enum_decl_owners.count
        return true if pymodule_default_module_path_matches_bytes(file.enum_decl_owners[enum_index], path_bytes)
    return false




def pymodule_default_module_owner_suffix_bytes(prefix: sview, owner: sview, suffix_bytes: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if owner.len < prefix.len
    for index in 0..<prefix.len |prefix, owner|:
        return false if prefix[index] != owner[index]
    return true if owner.len == prefix.len
    return false if owner.len < prefix.len + 2.usize()
    return false if owner[prefix.len] != 58 or owner[prefix.len + 1.usize()] != 58
    for index in (prefix.len + 2.usize())..<owner.len |owner, suffix_bytes|:
        suffix_bytes.push(owner[index])
    return true




def pymodule_default_resolve_alias_target_path(file: Ast::File&, target: sview, declaration_scope: sview, before_offset: u32, alias_name: sview, bytes: mutable darray[u8]&, depth: u32 = 0) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if depth > PYMODULE_DEFAULT_ENUM_EXPR_DEPTH_LIMIT
    target_parts: mutable darray[sview] = []
    pymodule_default_module_path_parts(target, target_parts)
    return false if target_parts.count == 0

    # Alias targets are canonicalized when their using row is registered, so only an
    # earlier alias in the declaration block can expand a target head.
    alias: (index: usize, ambiguous: bool) = pymodule_default_visible_prior_module_alias(file, target_parts[0], declaration_scope, before_offset, depth + 1)
    if alias.ambiguous:
        return false
    elif alias.index < file.enum_annotations.count:
        alias_annotation: Ast::EnumAnnotation = file.enum_annotations[alias.index]
        target_owner: mutable sview = ""
        target_count: mutable usize = 0
        for target_annotation in file.enum_annotations |alias_annotation, target_owner, target_count|:
            if target_annotation.name == "__using_alias_target" and target_annotation.module == alias_annotation.module and target_annotation.line == alias_annotation.line and target_annotation.offset == alias_annotation.offset:
                target_owner <- target_annotation.owner
                target_count <- target_count + 1.usize()
        return false if target_count != 1.usize() or target_owner == ""
        resolved_prefix: mutable darray[u8] = []
        pymodule_default_resolve_alias_target_path(file, target_owner, alias_annotation.module, alias_annotation.offset, alias_annotation.owner, resolved_prefix, depth + 1)
        return false if resolved_prefix.count == 0.usize()
        for byte in resolved_prefix:
            bytes.push(byte)
        for suffix_index in 1..<target_parts.count |bytes, target_parts, suffix_index|:
            bytes.push(58)
            bytes.push(58)
            pymodule_default_append_text_bytes(bytes, target_parts[suffix_index])
        return pymodule_default_module_path_exists(file.top_decls, bytes)
    else:
        exact_path: mutable darray[u8] = []
        if declaration_scope != "":
            pymodule_default_append_text_bytes(exact_path, declaration_scope)
            exact_path.push(58)
            exact_path.push(58)
        pymodule_default_append_text_bytes(exact_path, target_parts[0])
        for suffix_index in 1..<target_parts.count |exact_path, target_parts, suffix_index|:
            exact_path.push(58)
            exact_path.push(58)
            pymodule_default_append_text_bytes(exact_path, target_parts[suffix_index])
        if pymodule_default_module_path_exists(file.top_decls, exact_path):
            for byte in exact_path:
                bytes.push(byte)
            return true

        # If the alias target is unresolved in its declaration scope, ordinary use-site
        # lookup may still fall back to a module spelled exactly like the alias. It must
        # not promote the target name itself to an ancestor or root module.
        alias_path: mutable darray[u8] = []
        pymodule_default_append_text_bytes(alias_path, alias_name)
        if alias_name != "" and pymodule_default_module_path_exists(file.top_decls, alias_path):
            for byte in exact_path:
                bytes.push(byte)
            return false
        for byte in exact_path:
            bytes.push(byte)
        return false




def pymodule_default_alias_target_owner(file: Ast::File&, alias_name: sview, target: sview, declaration_scope: sview, before_offset: u32, enum_name: sview, enum_owner: sview, full_enum_owner: sview) -> (resolved: bool, matches: bool, contains_enum: bool) can[Abort.Panic, Memory.Allocate]:
    target_path: mutable darray[u8] = []
    resolved: bool = pymodule_default_resolve_alias_target_path(file, target, declaration_scope, before_offset, alias_name, target_path)
    matches: bool = pymodule_default_module_path_matches_bytes(enum_owner, target_path)
    suffix: mutable darray[u8] = []
    suffix_found: bool = pymodule_default_module_owner_suffix_bytes(enum_owner, full_enum_owner, suffix)
    qualified_target_path: mutable darray[u8] = []
    for byte in target_path:
        qualified_target_path.push(byte)
    if suffix_found and suffix.count > 0.usize():
        qualified_target_path.push(58)
        qualified_target_path.push(58)
        for byte in suffix:
            qualified_target_path.push(byte)
    contains_enum: bool = resolved and suffix_found and pymodule_default_module_path_declares_enum(file, enum_name, qualified_target_path)
    return (resolved, resolved and matches, contains_enum)



def pymodule_default_enum_qualifier_matches_owner(file: Ast::File&, expression: Ast::Expr, enum_name: sview, owner: sview, full_owner: sview, lexical_owner: sview, depth: u32 = 0, alias_hops: usize = 0) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if depth > PYMODULE_DEFAULT_ENUM_EXPR_DEPTH_LIMIT
    return false if alias_hops > file.enum_annotations.count
    match expression:
        Expr.Ident(name, _):
            # Try a concrete lexical child first. If it does not own this enum,
            # continue to the use-site alias and then the raw module fallback.
            visible_module: (found: bool, ambiguous: bool, owner: sview) = pymodule_default_visible_module_identifier(file, name, lexical_owner)
            if visible_module.found and not visible_module.ambiguous:
                visible_rank: (found: bool, rank: usize) = pymodule_default_module_identifier_path_rank(visible_module.owner, name, lexical_owner)
                if visible_rank.found and visible_rank.rank > 0:
                    # Rebase the raw qualifier's suffix under the nearest lexical
                    # child. If that concrete path declares this enum, its missing
                    # member is authoritative and a root candidate cannot leak in.
                    lexical_enum_path: mutable darray[u8] = []
                    lexical_enum_path_found: mutable bool = false
                    local_suffix: mutable darray[u8] = []
                    if pymodule_default_module_owner_suffix_bytes(visible_module.owner, full_owner, local_suffix):
                        pymodule_default_append_text_bytes(lexical_enum_path, full_owner)
                        lexical_enum_path_found <- true
                    else:
                        lexical_raw_suffix: mutable darray[u8] = []
                        if pymodule_default_module_owner_suffix_bytes(name, full_owner, lexical_raw_suffix):
                            pymodule_default_append_text_bytes(lexical_enum_path, visible_module.owner)
                            if lexical_raw_suffix.count > 0.usize():
                                lexical_enum_path.push(58)
                                lexical_enum_path.push(58)
                                for byte in lexical_raw_suffix:
                                    lexical_enum_path.push(byte)
                            lexical_enum_path_found <- true
                    if lexical_enum_path_found and pymodule_default_module_path_declares_enum(file, enum_name, lexical_enum_path):
                        return pymodule_default_module_path_matches_bytes(full_owner, lexical_enum_path)
            alias: (index: usize, ambiguous: bool) = pymodule_default_visible_module_alias(file, name, lexical_owner, depth + 1)
            if alias.ambiguous:
                return false
            elif alias.index < file.enum_annotations.count:
                alias_annotation: Ast::EnumAnnotation = file.enum_annotations[alias.index]
                target_owner: mutable sview = ""
                target_count: mutable usize = 0
                for target_annotation in file.enum_annotations |alias_annotation, target_owner, target_count|:
                    if target_annotation.name == "__using_alias_target" and target_annotation.line == alias_annotation.line and target_annotation.offset == alias_annotation.offset and target_annotation.module == alias_annotation.module:
                        target_owner <- target_annotation.owner
                        target_count <- target_count + 1.usize()
                return false if target_count != 1.usize() or target_owner == ""
                target_match: (resolved: bool, matches: bool, contains_enum: bool) = pymodule_default_alias_target_owner(file, alias_annotation.owner, target_owner, alias_annotation.module, alias_annotation.offset, enum_name, owner, full_owner)
                # A resolved target is authoritative only when it actually declares the
                # requested enum. If it lacks that enum, ordinary alias-name lookup may
                # still resolve a real module with the same spelling. Once the enum is
                # declared, a missing variant remains authoritative at member lookup.
                return target_match.matches if target_match.resolved and target_match.contains_enum
            # After a lexical child and visible alias fail to own the enum, try the raw
            # root module spelling. The best-ranked lexical module alone is not enough:
            # Stage0 can continue from `Scope::X::Mode` through `AliasTarget::Mode` to
            # the raw `X::Mode` candidate.
            raw_suffix: mutable darray[u8] = []
            raw_suffix_found: bool = pymodule_default_module_owner_suffix_bytes(owner, full_owner, raw_suffix)
            raw_module_path: mutable darray[u8] = []
            pymodule_default_append_text_bytes(raw_module_path, name)
            if raw_suffix_found and raw_suffix.count > 0.usize():
                raw_module_path.push(58)
                raw_module_path.push(58)
                for byte in raw_suffix:
                    raw_module_path.push(byte)
            return true if raw_suffix_found and pymodule_default_module_path_matches_bytes(full_owner, raw_module_path) and pymodule_default_module_path_exists(file.top_decls, raw_module_path)
            return false if visible_module.ambiguous
            return visible_module.found and owner == visible_module.owner
        Expr.Scope(base, name, _):
            return pymodule_default_enum_qualifier_matches_owner(file, base, enum_name, owner, full_owner, lexical_owner, depth + 1, alias_hops) if name == enum_name
            return false if owner.len <= name.len + 2.usize()
            suffix_start: usize = owner.len - name.len
            return false if owner[suffix_start - 2.usize()] != 58 or owner[suffix_start - 1.usize()] != 58
            for index in 0..<name.len |owner, name, suffix_start|:
                return false if owner[suffix_start + index] != name[index]
            owner_prefix: sview = string_view_slice(owner, 0, (suffix_start - 2.usize()).i64())
            return pymodule_default_enum_qualifier_matches_owner(file, base, enum_name, owner_prefix, full_owner, lexical_owner, depth + 1, alias_hops)
        Expr.Paren(inner, _):
            return pymodule_default_enum_qualifier_matches_owner(file, inner, enum_name, owner, full_owner, lexical_owner, depth + 1, alias_hops)
        _:
            return false




def pymodule_default_enum_owner_matches_import_target(enum_owner: sview, target_module_path: darray[u8]&) -> bool can[Abort.Panic]:
    # check_global_authority resolves __from_src text to a canonical module path before
    # comparing it with the declaration owner.
    return pymodule_default_module_path_matches_bytes(enum_owner, target_module_path)




# Resolve an imported enum by its root-resolved source module. Enum ownership metadata is
# sufficient here: only that source module can provide the default member being evaluated.
def pymodule_default_imported_enum_owner(file: Ast::File&, enum_name: sview, target_module_path: darray[u8]&) -> (found: bool, ambiguous: bool, owner: sview) can[Abort.Panic]:
    best_rank: mutable usize = 0
    match_count: mutable usize = 0
    best_owner: mutable sview = ""
    for enum_index in 0..<file.enum_decl_names.count |file, enum_name, target_module_path, best_rank, match_count, best_owner|:
        continue if file.enum_decl_names[enum_index] != enum_name
        enum_owner: sview = file.enum_decl_owners[enum_index] if enum_index < file.enum_decl_owners.count else ""
        continue if not pymodule_default_enum_owner_matches_import_target(enum_owner, target_module_path)
        rank: usize = enum_owner.len
        if match_count == 0 or rank > best_rank:
            best_rank <- rank
            best_owner <- enum_owner
            match_count <- 1.usize()
        elif rank == best_rank:
            match_count <- match_count + 1.usize()
    return (match_count > 0, match_count > 1, best_owner)




# Resolve an import target through visible module aliases before looking up enum owners.
# GA applies the import's lexical module and alias rows to both wildcard and selective
# source paths; retaining only the parser's source spelling loses that canonical owner.
def pymodule_default_import_target_module_path(file: Ast::File&, target: sview, lexical_owner: sview, bytes: mutable darray[u8]&, depth: u32 = 0) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if depth > PYMODULE_DEFAULT_ENUM_EXPR_DEPTH_LIMIT
    target_parts: mutable darray[sview] = []
    pymodule_default_module_path_parts(target, target_parts)
    return false if target_parts.count == 0.usize()

    alias: (index: usize, ambiguous: bool) = pymodule_default_visible_module_alias(file, target_parts[0], lexical_owner, depth + 1)
    return false if alias.ambiguous
    if alias.index < file.enum_annotations.count:
        alias_annotation: Ast::EnumAnnotation = file.enum_annotations[alias.index]
        target_owner: mutable sview = ""
        target_count: mutable usize = 0
        for target_annotation in file.enum_annotations |alias_annotation, target_owner, target_count|:
            if target_annotation.name == "__using_alias_target" and target_annotation.module == alias_annotation.module and target_annotation.line == alias_annotation.line and target_annotation.offset == alias_annotation.offset:
                target_owner <- target_annotation.owner
                target_count <- target_count + 1.usize()
        return false if target_count != 1.usize() or target_owner == ""
        alias_target_path: mutable darray[u8] = []
        alias_target_resolved: bool = pymodule_default_resolve_alias_target_path(file, target_owner, alias_annotation.module, alias_annotation.offset, alias_annotation.owner, alias_target_path, depth + 1)
        return false if alias_target_path.count == 0.usize()
        if alias_target_resolved and pymodule_default_module_path_exists(file.top_decls, alias_target_path):
            for byte in alias_target_path:
                bytes.push(byte)
            for suffix_index in 1..<target_parts.count |bytes, target_parts, suffix_index|:
                bytes.push(58)
                bytes.push(58)
                pymodule_default_append_text_bytes(bytes, target_parts[suffix_index])
            return pymodule_default_module_path_exists(file.top_decls, bytes)

    # If an alias has no concrete target module, GA falls back to a lexical child with
    # the source spelling. Resolve that same child for imports in nested modules.
    visible_module: (found: bool, ambiguous: bool, owner: sview) = pymodule_default_visible_module_identifier(file, target_parts[0], lexical_owner)
    return false if not visible_module.found or visible_module.ambiguous
    pymodule_default_append_text_bytes(bytes, visible_module.owner)
    for suffix_index in 1..<target_parts.count |bytes, target_parts, suffix_index|:
        bytes.push(58)
        bytes.push(58)
        pymodule_default_append_text_bytes(bytes, target_parts[suffix_index])
    return pymodule_default_module_path_exists(file.top_decls, bytes)




# Find the first visible import that resolves this enum name, in the order GA scans import
# annotations. Selective rows pair their source by scope, line, and byte offset; wildcard rows
# carry the target module in `owner` directly.
def pymodule_default_visible_enum_import(file: Ast::File&, enum_name: sview, lexical_owner: sview) -> (found: bool, ambiguous: bool, owner: sview) can[Abort.Panic, Memory.Allocate]:
    saw_visible_import: mutable bool = false
    for import_annotation in file.enum_annotations |file, enum_name, lexical_owner, saw_visible_import|:
        continue if not pymodule_default_alias_scope_matches(import_annotation.module, lexical_owner)
        source_module: mutable sview = ""
        if import_annotation.owner == "__from_member" and import_annotation.name == enum_name:
            saw_visible_import <- true
            source_count: mutable usize = 0
            for source_annotation in file.enum_annotations |import_annotation, source_module, source_count|:
                if source_annotation.owner == "__from_src" and source_annotation.module == import_annotation.module and source_annotation.line == import_annotation.line and source_annotation.offset == import_annotation.offset:
                    source_module <- source_annotation.name
                    source_count <- source_count + 1.usize()
            continue if source_count != 1.usize() or source_module == ""
        elif import_annotation.name == "__binding_wildcard_import":
            saw_visible_import <- true
            source_module <- import_annotation.owner
        else:
            continue
        source_module_path: mutable darray[u8] = []
        if not pymodule_default_import_target_module_path(file, source_module, import_annotation.module, source_module_path):
            continue
        imported_owner: (found: bool, ambiguous: bool, owner: sview) = pymodule_default_imported_enum_owner(file, enum_name, source_module_path)
        # check_global_authority scans visible import rows in source order and accepts the
        # first declaration found in a selectively or wildcard-imported module. Later rows do
        # not make that lookup ambiguous; check_import_conflict diagnoses selective conflicts.
        return (true, imported_owner.ambiguous, imported_owner.owner) if imported_owner.found
    # An import marker still shadows other enum declarations even when its source does not
    # provide this name. The semantic resolver will report the unresolved imported name.
    return (saw_visible_import, saw_visible_import, "")




# The `declared` bit matters for shadowing: a nearer enum name blocks imported and outer
# candidates even when it does not contain the requested variant.
def pymodule_default_enum_member_at_owner(file: Ast::File&, enum_name: sview, variant_name: sview, wanted_owner: sview) -> (declared: bool, found: bool, ambiguous: bool, value: i64) can[Abort.Panic]:
    declaration_count: mutable usize = 0
    variant_match_count: mutable usize = 0
    value: mutable i64 = 0
    for enum_index in 0..<file.enum_decl_names.count |file, enum_name, variant_name, wanted_owner, declaration_count, variant_match_count, value|:
        continue if file.enum_decl_names[enum_index] != enum_name
        enum_owner: sview = file.enum_decl_owners[enum_index] if enum_index < file.enum_decl_owners.count else ""
        continue if enum_owner != wanted_owner
        declaration_count <- declaration_count + 1.usize()
        variant_start: usize = file.enum_decl_variant_starts[enum_index]
        variant_count: usize = file.enum_decl_variant_counts[enum_index]
        for variant_index in 0..<variant_count |file, variant_start, variant_name, variant_match_count, value|:
            if file.enum_decl_variant_names[variant_start + variant_index] == variant_name:
                variant_match_count <- variant_match_count + 1.usize()
                value <- file.enum_decl_variant_values[variant_start + variant_index]
    return (declaration_count > 0, variant_match_count == 1 and declaration_count == 1, declaration_count > 1 or variant_match_count > 1, value)




def pymodule_default_enum_value(file: Ast::File&, expression: Ast::Expr) -> (found: bool, value: i64) can[Abort.Panic, Memory.Allocate]:
    if expression is Expr.Paren(default_enum_inner, default_enum_paren_pos):
        return pymodule_default_enum_value(file, default_enum_inner)
    if expression is Expr.Call(default_enum_callee, default_enum_arguments, default_enum_argument_names, default_enum_call_pos):
        return (false, 0) if default_enum_arguments.count != 0
        if default_enum_callee is Expr.Field(default_enum_base, default_enum_field, default_enum_field_pos):
            # Let integer suffixes reach the cast evaluator; a narrowing enum cast changes
            # the backing value (for example `Mode.Large.u8()`).
            return (false, 0) if pymodule_default_integer_cast_type(default_enum_field)
            # Non-integer cast-like suffixes preserve the scalar backing value here.
            return pymodule_default_enum_value(file, default_enum_base)
        return (false, 0)
    if expression is Expr.Field(default_enum_head, default_enum_variant, default_enum_field_pos):
        enum_name: mutable sview = ""
        enum_qualifier: mutable Ast::Expr? = null
        if default_enum_head is Expr.Ident(default_enum_ident_name, default_enum_ident_pos):
            enum_name <- default_enum_ident_name
        elif default_enum_head is Expr.Scope(default_enum_scope_head, default_enum_scope_name, default_enum_scope_pos):
            enum_name <- default_enum_scope_name
            enum_qualifier <- default_enum_scope_head
        if enum_name == "":
            return (false, 0)
        lexical_owner: sview = pymodule_default_expression_owner(file, expression)
        if enum_qualifier is qualifier:
            qualified_found: mutable bool = false
            qualified_value: mutable i64 = 0
            for enum_index in 0..<file.enum_decl_names.count |file, enum_name, qualifier, lexical_owner|:
                continue if file.enum_decl_names[enum_index] != enum_name
                continue if enum_index >= file.enum_decl_owners.count
                continue if not pymodule_default_enum_qualifier_matches_owner(file, qualifier, enum_name, file.enum_decl_owners[enum_index], file.enum_decl_owners[enum_index], lexical_owner)
                variant_start: usize = file.enum_decl_variant_starts[enum_index]
                variant_count: usize = file.enum_decl_variant_counts[enum_index]
                for variant_index in 0..<variant_count |file, variant_start, default_enum_variant, qualified_found, qualified_value|:
                    if file.enum_decl_variant_names[variant_start + variant_index] == default_enum_variant:
                        return (false, 0) if qualified_found == true
                        qualified_found <- true
                        qualified_value <- file.enum_decl_variant_values[variant_start + variant_index]
            return (true, qualified_value) if qualified_found == true
            return (false, 0)

        # Resolve declarations through the complete lexical module chain before considering
        # any visible imports, matching check_global_authority.ga_resolve. A declaration in a
        # parent module therefore outranks an import in a nested module.
        candidate_owner: mutable sview = lexical_owner
        while candidate_owner != "" |file, enum_name, default_enum_variant, candidate_owner|:
            local_member: (declared: bool, found: bool, ambiguous: bool, value: i64) = pymodule_default_enum_member_at_owner(file, enum_name, default_enum_variant, candidate_owner)
            if local_member.declared:
                return (true, local_member.value) if local_member.found and not local_member.ambiguous
                return (false, 0)

            parent_separator: mutable usize = 0.usize()
            has_parent_separator: mutable bool = false
            if candidate_owner.len >= 2.usize():
                for owner_index in 0..<(candidate_owner.len - 1.usize()) |candidate_owner, parent_separator, has_parent_separator|:
                    if candidate_owner[owner_index] == 58 and candidate_owner[owner_index + 1.usize()] == 58:
                        parent_separator <- owner_index
                        has_parent_separator <- true
            if not has_parent_separator:
                break
            candidate_owner <- string_view_slice(candidate_owner, 0, parent_separator.i64())

        top_level_member: (declared: bool, found: bool, ambiguous: bool, value: i64) = pymodule_default_enum_member_at_owner(file, enum_name, default_enum_variant, "")
        if top_level_member.declared:
            return (true, top_level_member.value) if top_level_member.found and not top_level_member.ambiguous
            return (false, 0)
        visible_import: (found: bool, ambiguous: bool, owner: sview) = pymodule_default_visible_enum_import(file, enum_name, lexical_owner)
        if visible_import.found:
            return (false, 0) if visible_import.ambiguous
            imported_member: (declared: bool, found: bool, ambiguous: bool, value: i64) = pymodule_default_enum_member_at_owner(file, enum_name, default_enum_variant, visible_import.owner)
            return (true, imported_member.value) if imported_member.found and not imported_member.ambiguous
    return (false, 0)




def pymodule_default_unsigned_literal_text_value(text: sview) -> (found: bool, value: u64) can[Abort.Panic]:
    return (false, 0) if text.len == 0
    is_hex: bool = text.len >= 2 and text[0] == 48 and (text[1] == 120 or text[1] == 88)
    start: usize = 2 if is_hex else 0
    base: u64 = 16 if is_hex else 10
    maximum: u64 = 18446744073709551615u64
    value: mutable u64 = 0
    digits: mutable usize = 0
    for index in start..<text.len |text, is_hex, base, maximum, value, digits|:
        byte: u8 = text[index].u8()
        continue if byte == 95
        digit: mutable u32 = 0
        if byte >= 48 and byte <= 57:
            digit <- (byte - 48).u32()
        elif is_hex and byte >= 97 and byte <= 102:
            digit <- (byte - 97 + 10).u32()
        elif is_hex and byte >= 65 and byte <= 70:
            digit <- (byte - 65 + 10).u32()
        else:
            return (false, 0)
        return (false, 0) if value > (maximum - digit.u64()) / base
        value <- value * base + digit.u64()
        digits <- digits + 1.usize()
    return (false, 0) if digits == 0
    return (true, value)




def pymodule_default_unsigned_literal_source_value(file: Ast::File&, position: Ast::Pos) -> (found: bool, value: u64) can[Abort.Panic, Memory.Allocate]:
    for annotation in file.enum_annotations:
        continue if annotation.owner != "__numeric_literal_value" or annotation.offset != position.offset
        return (false, 0) if annotation.line != position.line
        return pymodule_default_unsigned_literal_text_value(annotation.name)
    return (false, 0)




def pymodule_default_unsigned_literal_value(file: Ast::File&, expression: Ast::Expr, negative: bool = false) -> (found: bool, value: u64) can[Abort.Panic, Memory.Allocate]:
    if expression is Expr.IntLit(_, default_pos):
        return (false, 0) if negative
        return pymodule_default_unsigned_literal_source_value(file, default_pos)
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return pymodule_default_unsigned_literal_value(file, default_operand, not negative) if default_operator == Lexer::TokenKind.Minus
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_unsigned_literal_value(file, default_inner, negative)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        return (false, 0) if default_arguments.count != 0
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            if pymodule_default_integer_cast_type(default_field):
                cast_value: (found: bool, is_negative: bool, magnitude: u64) = pymodule_default_integer_cast_value(file, default_base, default_field)
                return (false, 0) if not cast_value.found or cast_value.is_negative != negative
                return (true, cast_value.magnitude)
            return pymodule_default_unsigned_literal_value(file, default_base, negative)
    return (false, 0)




def pymodule_default_signed_literal_value(file: Ast::File&, expression: Ast::Expr, negative: bool = false) -> (found: bool, is_negative: bool, magnitude: u64) can[Abort.Panic, Memory.Allocate]:
    if expression is Expr.IntLit(_, default_pos):
        source_value: (found: bool, value: u64) = pymodule_default_unsigned_literal_source_value(file, default_pos)
        return (source_value.found, negative, source_value.value)
    enum_value: (found: bool, value: i64) = pymodule_default_enum_value(file, expression)
    if enum_value.found:
        enum_is_negative: bool = enum_value.value < 0
        enum_magnitude: u64 = (9223372036854775808u64 if enum_value.value == -9223372036854775808 else (0 - enum_value.value).u64()) if enum_is_negative else enum_value.value.u64()
        return (true, enum_is_negative != negative, enum_magnitude)
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return pymodule_default_signed_literal_value(file, default_operand, not negative) if default_operator == Lexer::TokenKind.Minus
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_signed_literal_value(file, default_inner, negative)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        return (false, false, 0) if default_arguments.count != 0
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            if pymodule_default_integer_cast_type(default_field):
                cast_value: (found: bool, is_negative: bool, magnitude: u64) = pymodule_default_integer_cast_value(file, default_base, default_field)
                return (false, false, 0) if not cast_value.found
                return (true, cast_value.is_negative != negative, cast_value.magnitude)
            return pymodule_default_signed_literal_value(file, default_base, negative)
    return (false, false, 0)




def pymodule_default_integer_cast_type(type_name: sview) -> bool can[Abort.Panic]:
    return type_name == "i8" or type_name == "i16" or type_name == "i32" or type_name == "i64" or type_name == "s8" or type_name == "s16" or type_name == "s32" or type_name == "s64" or type_name == "int" or type_name == "isize" or type_name == "char" or type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or type_name == "usize" or type_name == "uintptr"




def pymodule_default_integer_cast_width(type_name: sview) -> u32 can[Abort.Panic]:
    if type_name == "i8" or type_name == "s8" or type_name == "u8":
        return 8
    if type_name == "i16" or type_name == "s16" or type_name == "u16":
        return 16
    if type_name == "i32" or type_name == "s32" or type_name == "u32":
        return 32
    if type_name == "int" or type_name == "isize" or type_name == "usize" or type_name == "uintptr":
        return (size_of[usize]() * 8).u32()
    return 64




# Match Elisa's integer suffix conversion for literal defaults. This exact value feeds the
# generated C default, default range checks, and Python's displayed signature value.
def pymodule_default_integer_cast_value(file: Ast::File&, expression: Ast::Expr, cast_type: sview) -> (found: bool, is_negative: bool, magnitude: u64) can[Abort.Panic, Memory.Allocate]:
    return (false, false, 0) if not pymodule_default_integer_cast_type(cast_type)
    source: (found: bool, is_negative: bool, magnitude: u64) = pymodule_default_signed_literal_value(file, expression)
    return (false, false, 0) if not source.found
    width: u32 = pymodule_default_integer_cast_width(cast_type)
    bits: mutable u64 = 0
    if width == 64:
        if source.is_negative and source.magnitude > 0:
            bits <- 18446744073709551615u64 - (source.magnitude - 1u64)
        else:
            bits <- source.magnitude
    else:
        modulus: u64 = 1u64 << width
        remainder: u64 = source.magnitude % modulus
        bits <- (modulus - remainder) % modulus if source.is_negative
        bits <- remainder if not source.is_negative
    is_unsigned: bool = cast_type == "u8" or cast_type == "u16" or cast_type == "u32" or cast_type == "u64" or cast_type == "usize" or cast_type == "uintptr"
    return (true, false, bits) if is_unsigned
    sign_bit: u64 = 1u64 << (width - 1u32)
    return (true, false, bits) if bits < sign_bit
    if width == 64:
        return (true, true, 18446744073709551615u64 - bits + 1u64)
    return (true, true, (1u64 << width) - bits)




def pymodule_default_unsigned_integer_in_range(type_name: sview, value: u64) -> bool can[Abort.Panic]:
    if type_name == "u8":
        return value <= 255u64
    if type_name == "u16":
        return value <= 65535u64
    if type_name == "u32":
        return value <= 4294967295u64
    if type_name == "u64":
        return true
    if type_name == "usize" or type_name == "uintptr":
        return true if size_of[usize]() >= size_of[u64]()
        return value <= 4294967295u64
    return false




def pymodule_default_signed_integer_in_range(type_name: sview, negative: bool, magnitude: u64) -> bool can[Abort.Panic]:
    if type_name == "i8":
        return magnitude <= (128u64 if negative else 127u64)
    if type_name == "i16":
        return magnitude <= (32768u64 if negative else 32767u64)
    if type_name == "i32":
        return magnitude <= (2147483648u64 if negative else 2147483647u64)
    if type_name == "i64" or type_name == "char":
        return magnitude <= (9223372036854775808u64 if negative else 9223372036854775807u64)
    if type_name == "int" or type_name == "isize":
        if size_of[usize]() < size_of[u64]():
            return magnitude <= (2147483648u64 if negative else 2147483647u64)
        return magnitude <= (9223372036854775808u64 if negative else 9223372036854775807u64)
    return false




def pymodule_default_integer_value_supported(file: Ast::File&, type_name: sview, expression: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        if default_arguments.count == 0 and default_callee is Expr.Field(default_base, default_field, default_field_pos) and pymodule_default_integer_cast_type(default_field):
            cast_value: (found: bool, is_negative: bool, magnitude: u64) = pymodule_default_integer_cast_value(file, default_base, default_field)
            return false if not cast_value.found
            if PymoduleDefaultScalarTypePolicy::is_unsigned_integer_type_name(type_name):
                return not cast_value.is_negative and pymodule_default_unsigned_integer_in_range(type_name, cast_value.magnitude)
            if PymoduleDefaultScalarTypePolicy::is_signed_integer_type_name(type_name):
                return pymodule_default_signed_integer_in_range(type_name, cast_value.is_negative, cast_value.magnitude)
            return false
    if pymodule_default_integer_literal_supported(expression):
        if PymoduleDefaultScalarTypePolicy::is_unsigned_integer_type_name(type_name):
            unsigned_value: (found: bool, value: u64) = pymodule_default_unsigned_literal_value(file, expression)
            return unsigned_value.found and pymodule_default_unsigned_integer_in_range(type_name, unsigned_value.value)
        if PymoduleDefaultScalarTypePolicy::is_signed_integer_type_name(type_name):
            signed_value: (found: bool, is_negative: bool, magnitude: u64) = pymodule_default_signed_literal_value(file, expression)
            return signed_value.found and pymodule_default_signed_integer_in_range(type_name, signed_value.is_negative, signed_value.magnitude)
        return pymodule_default_integer_literal_fits(type_name, expression, false)
    enum_value: (found: bool, value: i64) = pymodule_default_enum_value(file, expression)
    return false if not enum_value.found
    return pymodule_default_integer_in_range(type_name, enum_value.value)




def pymodule_default_has_minus(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return true if default_operator == Lexer::TokenKind.Minus
        return pymodule_default_has_minus(default_operand)
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_has_minus(default_inner)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            return pymodule_default_has_minus(default_base)
    return false




def pymodule_default_has_unwrapped_minus(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return true if default_operator == Lexer::TokenKind.Minus
        return pymodule_default_has_unwrapped_minus(default_operand)
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_has_unwrapped_minus(default_inner)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        return false if default_arguments.count == 0 and default_callee is Expr.Field(_, default_field, _) and pymodule_default_integer_cast_type(default_field)
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            return pymodule_default_has_unwrapped_minus(default_base)
    return false




def pymodule_default_integer_in_range(type_name: sview, value: i64) -> bool can[Abort.Panic]:
    if type_name == "i8":
        return value >= -128 and value <= 127
    if type_name == "i16":
        return value >= -32768 and value <= 32767
    if type_name == "i32":
        return value >= -2147483648 and value <= 2147483647
    if type_name == "u8":
        return value >= 0 and value <= 255
    if type_name == "u16":
        return value >= 0 and value <= 65535
    if type_name == "u32":
        return value >= 0 and value <= 4294967295
    if type_name == "u64":
        return value >= 0
    if type_name == "int" or type_name == "isize":
        if size_of[usize]() < size_of[i64]():
            return value >= -2147483648 and value <= 2147483647
        return true
    if type_name == "usize" or type_name == "uintptr":
        return value >= 0 and (size_of[usize]() >= size_of[i64]() or value <= 4294967295)
    return true




def pymodule_default_integer_literal_fits(type_name: sview, expression: Ast::Expr, negative: bool) -> bool can[Abort.Panic]:
    if expression is Expr.IntLit(default_int_value, _):
        return pymodule_default_integer_in_range(type_name, -default_int_value if negative else default_int_value)
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return pymodule_default_integer_literal_fits(type_name, default_operand, not negative) if default_operator == Lexer::TokenKind.Minus
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_integer_literal_fits(type_name, default_inner, negative)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            return pymodule_default_integer_literal_fits(type_name, default_base, negative)
    return false




def pymodule_default_integer_literal_value(expression: Ast::Expr, negative: bool = false) -> (found: bool, value: i64) can[Abort.Panic]:
    if expression is Expr.IntLit(default_int_value, _):
        return (true, -default_int_value if negative else default_int_value)
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return pymodule_default_integer_literal_value(default_operand, not negative) if default_operator == Lexer::TokenKind.Minus
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_integer_literal_value(default_inner, negative)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        return (false, 0) if default_arguments.count != 0
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            return pymodule_default_integer_literal_value(default_base, negative)
    return (false, 0)
