# `-emit pymodule` — C scalar spellings, and the DEFAULT-ARGUMENT policy. Python defaults stay
# deliberately literal: each admitted form is named explicitly and its value range-checked
# against the C type it will be emitted as.


# C scalar spellings match the native LLVM ABI emitted for the corresponding Elisa source type.
# Empty means that `-emit pymodule-c` should refuse the entry instead of publishing a guessed ABI.
def pymodule_c_type_name(type_name: sview) -> sview can[Abort.Panic]:
    known_type: sview = when type_name:
        "void" -> "void"
        "py::Object" | "py::Object?" -> "PyObject *"
        "cstr" | "cstr?" -> "const char *"
        "sview" -> "ElisaSView"
        "sview?" -> "ElisaOptionalSView"
        "i8" -> "int8_t"
        "i16" -> "int16_t"
        "i32" -> "int32_t"
        "i64" | "char" -> "int64_t"
        "int" | "isize" -> "intptr_t"
        "u8" -> "uint8_t"
        "u16" -> "uint16_t"
        "u32" -> "uint32_t"
        "u64" -> "uint64_t"
        "usize" | "uintptr" -> "uintptr_t"
        "bool" -> "bool"
        "f32" -> "float"
        "f64" -> "double"
        "i8?" -> "ElisaOptionalI8"
        "i16?" -> "ElisaOptionalI16"
        "i32?" -> "ElisaOptionalI32"
        "i64?" | "char?" -> "ElisaOptionalI64"
        "int?" | "isize?" -> "ElisaOptionalInt"
        "u8?" -> "ElisaOptionalU8"
        "u16?" -> "ElisaOptionalU16"
        "u32?" -> "ElisaOptionalU32"
        "u64?" -> "ElisaOptionalU64"
        "usize?" | "uintptr?" -> "ElisaOptionalUSize"
        "bool?" -> "ElisaOptionalBool"
        "f32?" -> "ElisaOptionalF32"
        "f64?" -> "ElisaOptionalF64"
        _ -> ""
    return known_type if known_type != ""
    return "ElisaDict" if pymodule_is_dict_type(type_name)
    return "ElisaDArray" if pymodule_is_darray_type(type_name)
    return "ElisaView" if pymodule_is_view_type(type_name)
    return "ElisaSet" if pymodule_is_set_type(type_name)
    return ""




def pymodule_parse_format(type_name: sview) -> sview can[Abort.Panic]:
    format: sview = when type_name:
        "cstr" | "sview" -> "s#"
        "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "char" -> "L"
        "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" -> "K"
        "f32" | "f64" -> "d"
        "bool" -> "p"
        _ -> "O" if type_name != "" else ""
    return format




def pymodule_parameter_is_implicit_optional(type_name: sview) -> bool can[Abort.Panic]:
    return when type_name:
        "py::Object?" | "cstr?" -> true
        _ -> pymodule_is_optional_scalar_type(type_name)




def pymodule_default_is_null(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_is_null(default_inner)
    if expression is Expr.Ident(default_name, default_pos):
        return default_name == "null"
    return false




def pymodule_is_optional_scalar_type(type_name: sview) -> bool can[Abort.Panic]:
    return when type_name:
        "i8?" | "i16?" | "i32?" | "i64?" | "char?" -> true
        "int?" | "isize?" -> true
        "u8?" | "u16?" | "u32?" | "u64?" | "usize?" | "uintptr?" -> true
        "bool?" | "f32?" | "f64?" | "sview?" -> true
        _ -> false




def pymodule_optional_payload_name(type_name: sview) -> sview can[Abort.Panic]:
    return when type_name:
        "i8?" -> "i8"
        "i16?" -> "i16"
        "i32?" -> "i32"
        "i64?" | "char?" -> "i64"
        "int?" | "isize?" -> "int"
        "u8?" -> "u8"
        "u16?" -> "u16"
        "u32?" -> "u32"
        "u64?" -> "u64"
        "usize?" | "uintptr?" -> "usize"
        "bool?" -> "bool"
        "f32?" -> "f32"
        "f64?" -> "f64"
        "sview?" -> "sview"
        _ -> ""




# Keep Python defaults intentionally literal. This covers useful scalar/text cases
# (`limit: i64 = 10`, `enabled: bool = false`, `ratio: f64 = 0.5`, `name: cstr = "guest"`)
# plus empty native containers, whose zero-length representation is unambiguous and does not
# require evaluating arbitrary Elisa code in the CPython shim.
def pymodule_default_literal_supported(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.IntLit(default_int_value, _):
        return true
    if expression is Expr.FloatLit(default_float_text, _):
        return true
    if expression is Expr.BoolLit(default_bool_value, _):
        return true
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return pymodule_default_literal_supported(default_operand) if default_operator == Lexer::TokenKind.Minus
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_literal_supported(default_inner)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        return false if default_arguments.count != 0
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            supported_constructor: bool = when default_field:
                "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "char" -> true
                "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" -> true
                "f32" | "f64" -> true
                _ -> false
            return false if not supported_constructor
            return pymodule_default_literal_supported(default_base)
    return false




# String defaults are emitted as the original quoted literal in the generated C shim. Keep the
# accepted escape vocabulary identical to the backend's decoder so a default cannot silently
# acquire different bytes at the Python/C boundary.
def pymodule_default_string_literal_supported(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.StringLit(default_string_text, _):
        string_length: usize = default_string_text.len
        scan: mutable usize = 0
        while scan < string_length |scan, default_string_text|:
            if default_string_text[scan] == 92:
                return false if scan + 1 >= string_length
                escaped: u8 = default_string_text[scan + 1]
                return false if escaped != 110 and escaped != 116 and escaped != 114 and escaped != 48 and escaped != 92 and escaped != 34 and escaped != 39
                scan <- scan + 1
            scan <- scan + 1
        return true
    return false




def emit_pymodule_manifest_default_literal(buffer: mutable darray[u8]&, file: Ast::File&, expression: Ast::Expr, type_name: sview = "") -> void can[Abort.Panic, Memory.Allocate]:
    if pymodule_default_is_null(expression) and pymodule_parameter_is_implicit_optional(type_name):
        emit_tokens_push_sview(buffer, "None")
        return
    enum_value: (found: bool, value: i64) = pymodule_default_enum_value(file, expression)
    if enum_value.found:
        append_decimal_i64(buffer, enum_value.value)
        return
    if expression is Expr.StringLit(default_string_text, _):
        buffer.push(92)
        buffer.push(34)
        emit_tokens_push_json_string(buffer, default_string_text)
        buffer.push(92)
        buffer.push(34)
        return
    if expression is Expr.Array(default_array_elements, default_array_pos):
        element_type_name: sview = pymodule_darray_element_name(type_name) if pymodule_is_darray_type(type_name) else pymodule_view_element_name(type_name) if pymodule_is_view_type(type_name) else ""
        if type_name == "darray[u8]":
            all_bytes: mutable bool = true
            for default_byte_element in default_array_elements:
                byte_value: (found: bool, value: i64) = pymodule_default_integer_literal_value(default_byte_element)
                all_bytes <- false if not byte_value.found or byte_value.value < 0 or byte_value.value > 255
            if all_bytes:
                buffer.push(98)
                buffer.push(92)
                buffer.push(34)
                for default_byte_index in 0..<default_array_elements.count |buffer, default_array_elements, default_byte_index|:
                    byte_value: (found: bool, value: i64) = pymodule_default_integer_literal_value(default_array_elements[default_byte_index])
                    buffer.push(92)
                    buffer.push(92)
                    buffer.push(120)
                    emit_pymodule_signature_hex(buffer, byte_value.value.u32(), 2)
                buffer.push(92)
                buffer.push(34)
                return
        emit_tokens_push_sview(buffer, "[")
        for default_element_index in 0..<default_array_elements.count |buffer, default_array_elements, default_element_index, element_type_name|:
            emit_tokens_push_sview(buffer, ", ") if default_element_index > 0
            emit_pymodule_manifest_default_literal(buffer, file, default_array_elements[default_element_index], element_type_name)
        emit_tokens_push_sview(buffer, "]")
        return
    if expression is Expr.DictLit(default_dict_entries, default_dict_pos):
        key_type_name: sview = pymodule_dict_key_name(type_name) if pymodule_is_dict_type(type_name) else ""
        value_type_name: sview = pymodule_dict_value_name(type_name) if pymodule_is_dict_type(type_name) else ""
        emit_tokens_push_sview(buffer, "{")
        for default_entry_index in 0..<default_dict_entries.count |buffer, default_dict_entries, default_entry_index, key_type_name, value_type_name|:
            emit_tokens_push_sview(buffer, ", ") if default_entry_index > 0
            emit_pymodule_manifest_default_literal(buffer, file, default_dict_entries[default_entry_index].key, key_type_name)
            emit_tokens_push_sview(buffer, ": ")
            emit_pymodule_manifest_default_literal(buffer, file, default_dict_entries[default_entry_index].value, value_type_name)
        emit_tokens_push_sview(buffer, "}")
        return
    if expression is Expr.SetLit(default_set_elements, default_set_pos):
        if default_set_elements.count == 0:
            emit_tokens_push_sview(buffer, "set()")
            return
        emit_tokens_push_sview(buffer, "{")
        set_element_type_name: sview = pymodule_set_element_name(type_name) if pymodule_is_set_type(type_name) else ""
        for default_set_element_index in 0..<default_set_elements.count |buffer, default_set_elements, default_set_element_index, set_element_type_name|:
            emit_tokens_push_sview(buffer, ", ") if default_set_element_index > 0
            emit_pymodule_manifest_default_literal(buffer, file, default_set_elements[default_set_element_index], set_element_type_name)
        emit_tokens_push_sview(buffer, "}")
        return
    if expression is Expr.Construct(default_construct_type, default_construct_fields, default_construct_pos):
        emit_tokens_push_sview(buffer, "{")
        for default_construct_field_index in 0..<default_construct_fields.count |buffer, file, type_name, default_construct_fields, default_construct_field_index|:
            default_construct_field: Ast::FieldInit = default_construct_fields[default_construct_field_index]
            emit_tokens_push_sview(buffer, ", ") if default_construct_field_index > 0
            buffer.push(92)
            buffer.push(34)
            emit_tokens_push_json_string(buffer, default_construct_field.name)
            buffer.push(92)
            buffer.push(34)
            emit_tokens_push_sview(buffer, ": ")
            construct_field_type_name: sview = pymodule_struct_member_type_name(file, type_name, default_construct_field.name)
            emit_pymodule_manifest_default_literal(buffer, file, default_construct_field.value, construct_field_type_name)
        emit_tokens_push_sview(buffer, "}")
        return
    emit_pymodule_default_signature_literal(buffer, file, expression, type_name)




def pymodule_default_integer_literal_supported(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.IntLit(default_int_value, _):
        return true
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return pymodule_default_integer_literal_supported(default_operand) if default_operator == Lexer::TokenKind.Minus
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_integer_literal_supported(default_inner)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        return false if default_arguments.count != 0
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            return false if default_field != "i8" and default_field != "i16" and default_field != "i32" and default_field != "i64" and default_field != "int" and default_field != "isize" and default_field != "char" and default_field != "u8" and default_field != "u16" and default_field != "u32" and default_field != "u64" and default_field != "usize" and default_field != "uintptr"
            return pymodule_default_integer_literal_supported(default_base)
    return false




# Resolve a const/plain enum member to the value recorded by the parser.  Enum types erase to
# their scalar backing type at the Python boundary, so a default such as `Mode.Ready` should be
# treated exactly like the integer it compiles to.  The parser metadata is authoritative here:
# it preserves explicit gaps and implicit continuation values, including enums nested in modules.
def pymodule_default_enum_value(file: Ast::File&, expression: Ast::Expr) -> (found: bool, value: i64) can[Abort.Panic, Memory.Allocate]:
    if expression is Expr.Paren(default_enum_inner, default_enum_paren_pos):
        return pymodule_default_enum_value(file, default_enum_inner)
    if expression is Expr.Call(default_enum_callee, default_enum_arguments, default_enum_argument_names, default_enum_call_pos):
        return (false, 0) if default_enum_arguments.count != 0
        if default_enum_callee is Expr.Field(default_enum_base, default_enum_field, default_enum_field_pos):
            # A cast-like suffix (`Mode.Ready.i64()`) does not change the backing value.
            return pymodule_default_enum_value(file, default_enum_base)
        return (false, 0)
    if expression is Expr.Field(default_enum_head, default_enum_variant, default_enum_field_pos):
        enum_name: mutable sview = ""
        if default_enum_head is Expr.Ident(default_enum_ident_name, default_enum_ident_pos):
            enum_name <- default_enum_ident_name
        elif default_enum_head is Expr.Scope(default_enum_scope_head, default_enum_scope_name, default_enum_scope_pos):
            enum_name <- default_enum_scope_name
        if enum_name == "":
            return (false, 0)
        for enum_index in 0..<file.enum_decl_names.count |file, enum_name, default_enum_variant|:
            continue if file.enum_decl_names[enum_index] != enum_name
            variant_start: usize = file.enum_decl_variant_starts[enum_index]
            variant_count: usize = file.enum_decl_variant_counts[enum_index]
            for variant_index in 0..<variant_count |file, variant_start, default_enum_variant|:
                if file.enum_decl_variant_names[variant_start + variant_index] == default_enum_variant:
                    return (true, file.enum_decl_variant_values[variant_start + variant_index])
            return (false, 0)
    return (false, 0)




def pymodule_default_unsigned_literal_text_value(text: sview) -> (found: bool, value: u64) can[Abort.Panic]:
    return (false, 0) if text.len == 0
    is_hex: bool = text.len >= 2 and text[0] == 48 and (text[1] == 120 or text[1] == 88)
    start: usize = 2 if is_hex else 0
    base: u64 = 16 if is_hex else 10
    maximum: u64 = 18446744073709551615u64
    value: mutable u64 = 0
    digits: mutable usize = 0
    for index in start..<text.len |text, is_hex, base, maximum, value, digits|:
        byte: u8 = text[index].u8()
        continue if byte == 95
        digit: mutable u32 = 0
        if byte >= 48 and byte <= 57:
            digit <- (byte - 48).u32()
        elif is_hex and byte >= 97 and byte <= 102:
            digit <- (byte - 97 + 10).u32()
        elif is_hex and byte >= 65 and byte <= 70:
            digit <- (byte - 65 + 10).u32()
        else:
            return (false, 0)
        return (false, 0) if value > (maximum - digit.u64()) / base
        value <- value * base + digit.u64()
        digits <- digits + 1.usize()
    return (false, 0) if digits == 0
    return (true, value)




def pymodule_default_unsigned_literal_source_value(file: Ast::File&, position: Ast::Pos) -> (found: bool, value: u64) can[Abort.Panic, Memory.Allocate]:
    for annotation in file.enum_annotations:
        continue if annotation.owner != "__numeric_literal_value" or annotation.offset != position.offset
        return (false, 0) if annotation.line != position.line
        return pymodule_default_unsigned_literal_text_value(annotation.name)
    return (false, 0)




def pymodule_default_unsigned_literal_value(file: Ast::File&, expression: Ast::Expr, negative: bool = false) -> (found: bool, value: u64) can[Abort.Panic, Memory.Allocate]:
    if expression is Expr.IntLit(_, default_pos):
        return (false, 0) if negative
        return pymodule_default_unsigned_literal_source_value(file, default_pos)
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return pymodule_default_unsigned_literal_value(file, default_operand, not negative) if default_operator == Lexer::TokenKind.Minus
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_unsigned_literal_value(file, default_inner, negative)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        return (false, 0) if default_arguments.count != 0
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            return pymodule_default_unsigned_literal_value(file, default_base, negative)
    return (false, 0)




def pymodule_default_signed_literal_value(file: Ast::File&, expression: Ast::Expr, negative: bool = false) -> (found: bool, is_negative: bool, magnitude: u64) can[Abort.Panic, Memory.Allocate]:
    if expression is Expr.IntLit(_, default_pos):
        source_value: (found: bool, value: u64) = pymodule_default_unsigned_literal_source_value(file, default_pos)
        return (source_value.found, negative, source_value.value)
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return pymodule_default_signed_literal_value(file, default_operand, not negative) if default_operator == Lexer::TokenKind.Minus
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_signed_literal_value(file, default_inner, negative)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        return (false, false, 0) if default_arguments.count != 0
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            return pymodule_default_signed_literal_value(file, default_base, negative)
    return (false, false, 0)




def pymodule_default_unsigned_integer_in_range(type_name: sview, value: u64) -> bool can[Abort.Panic]:
    if type_name == "u8":
        return value <= 255u64
    if type_name == "u16":
        return value <= 65535u64
    if type_name == "u32":
        return value <= 4294967295u64
    if type_name == "u64":
        return true
    if type_name == "usize" or type_name == "uintptr":
        return true if size_of[usize]() >= size_of[u64]()
        return value <= 4294967295u64
    return false




def pymodule_default_signed_integer_in_range(type_name: sview, negative: bool, magnitude: u64) -> bool can[Abort.Panic]:
    if type_name == "i8":
        return magnitude <= (128u64 if negative else 127u64)
    if type_name == "i16":
        return magnitude <= (32768u64 if negative else 32767u64)
    if type_name == "i32":
        return magnitude <= (2147483648u64 if negative else 2147483647u64)
    if type_name == "i64" or type_name == "char":
        return magnitude <= (9223372036854775808u64 if negative else 9223372036854775807u64)
    if type_name == "int" or type_name == "isize":
        if size_of[usize]() < size_of[u64]():
            return magnitude <= (2147483648u64 if negative else 2147483647u64)
        return magnitude <= (9223372036854775808u64 if negative else 9223372036854775807u64)
    return false




def pymodule_default_integer_value_supported(file: Ast::File&, type_name: sview, expression: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
    if pymodule_default_integer_literal_supported(expression):
        if PymoduleDefaultScalarTypePolicy::is_unsigned_integer_type_name(type_name):
            unsigned_value: (found: bool, value: u64) = pymodule_default_unsigned_literal_value(file, expression)
            return unsigned_value.found and pymodule_default_unsigned_integer_in_range(type_name, unsigned_value.value)
        if PymoduleDefaultScalarTypePolicy::is_signed_integer_type_name(type_name):
            signed_value: (found: bool, is_negative: bool, magnitude: u64) = pymodule_default_signed_literal_value(file, expression)
            return signed_value.found and pymodule_default_signed_integer_in_range(type_name, signed_value.is_negative, signed_value.magnitude)
        return pymodule_default_integer_literal_fits(type_name, expression, false)
    enum_value: (found: bool, value: i64) = pymodule_default_enum_value(file, expression)
    return false if not enum_value.found
    return pymodule_default_integer_in_range(type_name, enum_value.value)




def pymodule_default_has_minus(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return true if default_operator == Lexer::TokenKind.Minus
        return pymodule_default_has_minus(default_operand)
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_has_minus(default_inner)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            return pymodule_default_has_minus(default_base)
    return false




def pymodule_default_integer_in_range(type_name: sview, value: i64) -> bool can[Abort.Panic]:
    if type_name == "i8":
        return value >= -128 and value <= 127
    if type_name == "i16":
        return value >= -32768 and value <= 32767
    if type_name == "i32":
        return value >= -2147483648 and value <= 2147483647
    if type_name == "u8":
        return value >= 0 and value <= 255
    if type_name == "u16":
        return value >= 0 and value <= 65535
    if type_name == "u32":
        return value >= 0 and value <= 4294967295
    if type_name == "u64":
        return value >= 0
    if type_name == "int" or type_name == "isize":
        if size_of[usize]() < size_of[i64]():
            return value >= -2147483648 and value <= 2147483647
        return true
    if type_name == "usize" or type_name == "uintptr":
        return value >= 0 and (size_of[usize]() >= size_of[i64]() or value <= 4294967295)
    return true




def pymodule_default_integer_literal_fits(type_name: sview, expression: Ast::Expr, negative: bool) -> bool can[Abort.Panic]:
    if expression is Expr.IntLit(default_int_value, _):
        return pymodule_default_integer_in_range(type_name, -default_int_value if negative else default_int_value)
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return pymodule_default_integer_literal_fits(type_name, default_operand, not negative) if default_operator == Lexer::TokenKind.Minus
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_integer_literal_fits(type_name, default_inner, negative)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            return pymodule_default_integer_literal_fits(type_name, default_base, negative)
    return false




def pymodule_default_integer_literal_value(expression: Ast::Expr, negative: bool = false) -> (found: bool, value: i64) can[Abort.Panic]:
    if expression is Expr.IntLit(default_int_value, _):
        return (true, -default_int_value if negative else default_int_value)
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return pymodule_default_integer_literal_value(default_operand, not negative) if default_operator == Lexer::TokenKind.Minus
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_integer_literal_value(default_inner, negative)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        return (false, 0) if default_arguments.count != 0
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            return pymodule_default_integer_literal_value(default_base, negative)
    return (false, 0)
