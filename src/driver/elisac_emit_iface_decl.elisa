# `-emit iface` — the per-DECLARATION dispatch and the report: typestate types and the functions
# generated for them, machine enums, packed blocks, and the assembly of the whole interface
# file.


def emit_iface_typestate_type(buffer: mutable darray[u8]&, expression: Ast::Expr, tokens: darray[Lexer::Token]&, source: u8&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        match expression:
            # Generated typestate parameters use qualifiers that FmtUnparse deliberately leaves
            # as an operation placeholder because they are normally source-only syntax. Render
            # this small type grammar explicitly so the synthesized interface remains canonical.
            Expr.Unary(operator, operand, line):
                if operator == Lexer::TokenKind.Mutable:
                    emit_tokens_push_sview(buffer, "mutable ")
                    emit_iface_typestate_type(buffer, operand, tokens, source)
                    return
                if operator == Lexer::TokenKind.Ampersand:
                    emit_iface_typestate_type(buffer, operand, tokens, source)
                    buffer.push(38)
                    return
                FmtUnparse::fmt_expr(buffer, expression, tokens, source)
            Expr.Index(object, index, line):
                emit_iface_typestate_type(buffer, object, tokens, source)
                buffer.push(91)
                emit_iface_typestate_type(buffer, index, tokens, source)
                buffer.push(93)
            _:
                FmtUnparse::fmt_expr(buffer, expression, tokens, source)




def emit_iface_typestate_generated_func(buffer: mutable darray[u8]&, name: sview, params: darray[Ast::ParamDecl]&, return_type: Ast::Expr?, annotations: darray[Ast::EnumAnnotation]&, indent: i64, tokens: darray[Lexer::Token]&, source: u8&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        generated_constructor: bool = any annotation in annotations where annotation.owner == name and annotation.name == "__typestate_generated"
        transition_type: mutable sview = ""
        transition_target: mutable sview = ""
        for annotation in annotations |name, transition_type, transition_target|:
            if annotation.owner == name and annotation.line == 3900000053:
                transition_type <- annotation.name
            if annotation.owner == name and annotation.line == 3900000005:
                transition_target <- annotation.name
        return false if not generated_constructor and (transition_type == "" or transition_target == "")
        for generated_space in 0..<indent |buffer|:
            buffer.push(32)
        emit_tokens_push_sview(buffer, "extern ")
        emit_tokens_push_sview(buffer, name)
        buffer.push(40)
        for parameter_index in 0..<params.count |buffer, params, tokens, source|:
            emit_tokens_push_sview(buffer, ", ") if parameter_index > 0
            parameter: Ast::ParamDecl = params[parameter_index]
            emit_tokens_push_sview(buffer, parameter.name)
            emit_tokens_push_sview(buffer, ": ")
            emit_iface_typestate_type(buffer, parameter.type_expression, tokens, source)
        buffer.push(41)
        if generated_constructor and return_type is constructor_return:
            emit_tokens_push_sview(buffer, " -> ")
            emit_iface_typestate_type(buffer, constructor_return, tokens, source)
        if not generated_constructor:
            emit_tokens_push_sview(buffer, " ensures self => ")
            emit_tokens_push_sview(buffer, transition_target)
        return true




def emit_iface_typestate_struct(buffer: mutable darray[u8]&, name: sview, members: darray[Ast::StructMember]&, indent: i64, tokens: darray[Lexer::Token]&, source: u8&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        for typestate_space in 0..<indent |buffer|:
            buffer.push(32)
        emit_tokens_push_sview(buffer, "affine struct ")
        emit_tokens_push_sview(buffer, name)
        emit_tokens_push_sview(buffer, "[state]:\n")
        for member in members |buffer, tokens, source|:
            for member_space in 0..<(indent + 1) * 4 |buffer|:
                buffer.push(32)
            emit_tokens_push_sview(buffer, member.name)
            emit_tokens_push_sview(buffer, ": ")
            emit_iface_typestate_type(buffer, member.type_expression, tokens, source)
            emit_tokens_push_sview(buffer, "\n")




def emit_iface_is_machine_enum(name: sview) -> bool:
    prefix: sview = "__MachineMode_"
    false return if sview_len(name) < sview_len(prefix)
    for prefix_index in 0..<sview_len(prefix) |name, prefix|:
        false return if sview_at(name, prefix_index) != sview_at(prefix, prefix_index)
    return true




def emit_iface_machine_enum(buffer: mutable darray[u8]&, name: sview, variants: darray[Ast::EnumVariant]&, indent: i64) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        for enum_space in 0..<indent |buffer|:
            buffer.push(32)
        emit_tokens_push_sview(buffer, "enum ")
        # Stage0 disambiguates synthesized machine names with FNV-1a(filename) and the
        # machine's source offset. Stage1's compact Pos intentionally has no filename, so the
        # parser keeps the offset-only spelling internally; recover the public spelling here
        # from the driver's absolute source path. The offset is already stage0's: the unit
        # carries stage0's `#line` directives (see expand_includes).
        absolute_source: mutable darray[u8] = []
        push_absolute_source_path(&absolute_source)
        if absolute_source.count == 0:
            emit_tokens_push_sview(buffer, name)
        else:
            machine_hash: mutable u32 = 2166136261
            for hash_index in 0..<absolute_source.count |machine_hash, absolute_source|:
                machine_hash <- (machine_hash ^ absolute_source[hash_index].u32()) * 16777619
            offset_start: mutable usize = sview_len("__MachineMode_")
            for name_index in offset_start..<sview_len(name) |offset_start, name|:
                offset_start <- name_index + 1 if sview_at(name, name_index) == 95
            machine_offset: mutable u64 = 0
            for offset_index in offset_start..<sview_len(name) |machine_offset, name|:
                offset_byte: u8 = sview_at(name, offset_index)
                machine_offset <- machine_offset * 10 + (offset_byte - 48).u64() if offset_byte >= 48 and offset_byte <= 57
            emit_tokens_push_sview(buffer, "__MachineMode_")
            hex_divisor: mutable u32 = 268435456
            hex_started: mutable bool = false
            while hex_divisor > 0 |buffer, machine_hash, hex_divisor, hex_started|:
                hex_digit: u32 = (machine_hash / hex_divisor) % 16
                if hex_digit != 0 or hex_started or hex_divisor == 1:
                    buffer.push((48 + hex_digit).u8()) if hex_digit < 10
                    buffer.push((87 + hex_digit).u8()) if hex_digit >= 10
                    hex_started <- true
                hex_divisor <- hex_divisor / 16
            emit_tokens_push_sview(buffer, "_")
            emit_tokens_push_u64(buffer, machine_offset)
        emit_tokens_push_sview(buffer, ":\n")
        for variant in variants |buffer, indent|:
            for variant_space in 0..<(indent + 4) |buffer|:
                buffer.push(32)
            emit_tokens_push_sview(buffer, variant.name)
            emit_tokens_push_sview(buffer, "\n")




def emit_iface_static_scope(buffer: mutable darray[u8]&, declaration: Ast::Decl, level: i64, tokens: darray[Lexer::Token]&, source: u8&, enum_annotations: darray[Ast::EnumAnnotation]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        if declaration is Decl.Scoped(static_body, static_line):
            line_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, static_line.line, static_line.offset)
            return if not line_range.found
            for static_space in 0..<(level * 4) |buffer|:
                buffer.push(32)
            emit_iface_render_tokens(buffer, tokens, source, line_range.start, line_range.stop)
            emit_tokens_push_sview(buffer, ":\n")
            for static_child in static_body |buffer, level, tokens, source, enum_annotations|:
                emit_iface_decl(buffer, static_child, level + 1, tokens, source, enum_annotations)




def emit_iface_enum_is_packed(name: sview, enum_annotations: darray[Ast::EnumAnnotation]&) -> bool can[Abort.Panic]:
    for annotation in enum_annotations |name|:
        continue if annotation.owner != name and annotation.name != name
        true return if annotation.name == "__declared_packed" or annotation.name == "__recursive_field" or annotation.name == "__ast_refinement" or annotation.name == "__aos" or annotation.line == 3900000008
    return false




def emit_iface_packed_block_decl(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32, offset: u32, indent: i64, needs_packed: bool) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        header_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
        return if not header_range.found
        for header_space in 0..<indent |buffer|:
            buffer.push(32)
        source_already_packed: mutable bool = false
        for header_index in header_range.start..<header_range.stop |source_already_packed, tokens, source|:
            source_already_packed <- true if Lexer::text_or_empty(tokens[header_index], source) == "packed"
        emit_tokens_push_sview(buffer, "packed ") if needs_packed and not source_already_packed
        emit_iface_render_tokens(buffer, tokens, source, header_range.start, header_range.stop)
        emit_tokens_push_sview(buffer, ":\n")
        body_range: (found: bool, start: usize, stop: usize) = emit_iface_body_range(tokens, header_range.stop + 1)
        return if not body_range.found
        emit_iface_body_lines(buffer, tokens, source, body_range.start, body_range.stop, indent + 4, true)




def emit_iface_decl(buffer: mutable darray[u8]&, declaration: Ast::Decl, level: i64, tokens: darray[Lexer::Token]&, source: u8&, enum_annotations: darray[Ast::EnumAnnotation]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        indent: i64 = level * 4
        if declaration is Decl.Func(if_fn_name, if_fn_params, if_fn_ret, if_fn_body, if_fn_effects, if_fn_decorators, if_fn_line):
            if emit_iface_typestate_generated_func(buffer, if_fn_name, if_fn_params, if_fn_ret, enum_annotations, indent, tokens, source):
                emit_tokens_push_sview(buffer, "\n")
                return
            emit_iface_func(buffer, if_fn_name, if_fn_line.line, if_fn_decorators, tokens, source, indent, emit_ast_is_law_callable(if_fn_name, enum_annotations), true)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Struct(if_st_name, if_st_members, if_st_aff, if_st_states, if_st_derive, if_st_inv, if_st_line):
            typestate_struct: bool = if_st_aff == "linear" and any annotation in enum_annotations where annotation.owner == if_st_name and annotation.name == "__aggregate_state"
            if typestate_struct:
                emit_iface_typestate_struct(buffer, if_st_name, if_st_members, indent, tokens, source)
                return
            emit_iface_block_decl(buffer, tokens, source, if_st_line.line, if_st_line.offset, indent)
            return
        if declaration is Decl.Enum(if_en_name, if_en_variants, if_en_const, if_en_storage, if_en_line):
            if emit_iface_is_machine_enum(if_en_name):
                emit_iface_machine_enum(buffer, if_en_name, if_en_variants, indent)
                return
            emit_iface_packed_block_decl(buffer, tokens, source, if_en_line.line, if_en_line.offset, indent, emit_iface_enum_is_packed(if_en_name, enum_annotations))
            return
        if declaration is Decl.Const(if_c_name, if_c_type, if_c_value, if_c_mutable, if_c_line):
            for const_space in 0..<indent |buffer|:
                buffer.push(32)
            const_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, if_c_line.line, if_c_line.offset)
            return if not const_range.found
            if if_c_mutable:
                # `global [mutable] NAME: T` presents as `extern NAME: T`.
                emit_tokens_push_sview(buffer, "extern ")
                emit_tokens_push_sview(buffer, if_c_name)
                # emit_ast_line_range CLIPS at the depth-0 colon, so the annotation lives
                # just past const_range.stop: scan from there to the physical line end.
                type_stop: mutable usize = const_range.stop + 1
                while type_stop < tokens.count and tokens[type_stop].line == if_c_line.line and tokens[type_stop].kind != Lexer::TokenKind.Newline and tokens[type_stop].kind != Lexer::TokenKind.Assign |type_stop, tokens, if_c_line|:
                    type_stop <- type_stop + 1
                return if const_range.stop >= tokens.count or tokens[const_range.stop].kind != Lexer::TokenKind.Colon
                emit_tokens_push_sview(buffer, ": ")
                emit_iface_render_tokens(buffer, tokens, source, const_range.stop + 1, type_stop)
                emit_tokens_push_sview(buffer, "\n")
                return
            emit_tokens_push_sview(buffer, "const ")
            emit_tokens_push_sview(buffer, if_c_name)
            eq_index: mutable usize = const_range.start
            eq_found: mutable bool = false
            for eq_probe in const_range.start..<tokens.count |eq_index, eq_found, tokens, if_c_line|:
                continue if eq_found
                break if tokens[eq_probe].line != if_c_line.line or tokens[eq_probe].kind == Lexer::TokenKind.Newline
                if tokens[eq_probe].kind == Lexer::TokenKind.Assign:
                    eq_index <- eq_probe
                    eq_found <- true
            return if not eq_found
            has_type_annotation: bool = const_range.stop < tokens.count and tokens[const_range.stop].kind == Lexer::TokenKind.Colon
            if not has_type_annotation:
                emit_tokens_push_sview(buffer, " = ")
                FmtUnparse::fmt_expr(buffer, if_c_value, tokens, source)
                emit_tokens_push_sview(buffer, "\n")
                return
            emit_tokens_push_sview(buffer, ": ")
            emit_iface_render_tokens(buffer, tokens, source, const_range.stop + 1, eq_index)
            emit_tokens_push_sview(buffer, " = ")
            # Unlike the AST report, iface preserves the source-level value. The
            # structural formatter handles multiline arrays and re-quotes strings,
            # while keeping the normalized binary/call spelling stage0 emits here.
            FmtUnparse::fmt_expr(buffer, if_c_value, tokens, source)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Alias(if_al_name, if_al_target, if_al_line):
            # The compact stage1 AST stores named block declarations as Alias. Recover
            # effect/permission/protocol surfaces from the source line and body instead
            # of emitting an empty `type Name =` alias in `.elisai`.
            alias_header: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, if_al_line.line, if_al_line.offset)
            if alias_header.found:
                alias_keyword: sview = Lexer::text_or_empty(tokens[alias_header.start], source)
                if alias_keyword == "effect" or alias_keyword == "permission" or alias_keyword == "protocol":
                    emit_iface_block_decl(buffer, tokens, source, if_al_line.line, if_al_line.offset, indent)
                    return
            for alias_space in 0..<indent |buffer|:
                buffer.push(32)
            emit_tokens_push_sview(buffer, "type ")
            emit_tokens_push_sview(buffer, if_al_name)
            emit_tokens_push_sview(buffer, " = ")
            emit_ast_alias_target(buffer, tokens, source, if_al_line.line, if_al_line.offset)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Import(if_im_module, if_im_line):
            for import_space in 0..<indent |buffer|:
                buffer.push(32)
            emit_tokens_push_sview(buffer, "using ")
            emit_tokens_push_sview(buffer, if_im_module)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Extern(if_ex_name, if_ex_pstart, if_ex_arity, if_ex_variadic, if_ex_callable, if_ex_ret, if_ex_decorators, if_ex_line):
            ex_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, if_ex_line.line, if_ex_line.offset)
            return if not ex_range.found
            # `@link_name(sym)` prints above the signature, exactly as in the ast summary.
            for if_ex_decorator in if_ex_decorators |buffer, indent, tokens, source, if_ex_line|:
                for decorator_space in 0..<indent |buffer|:
                    buffer.push(32)
                emit_tokens_push_sview(buffer, "@")
                emit_tokens_push_sview(buffer, if_ex_decorator.name)
                emit_ast_decorator_args(buffer, tokens, source, if_ex_decorator.line, 0)
                emit_tokens_push_sview(buffer, "\n")
            for extern_space in 0..<indent |buffer|:
                buffer.push(32)
            # Stage0 omits the redundant `as NAME` on a same-name global export in the
            # interface report, while preserving an actual alias (`seed as ctx_seed`).
            # The compact Extern node has no export spelling, so use the paired marker
            # side table that the AST report also consults.
            iface_global_target: sview = emit_ast_export_global_target(enum_annotations, if_ex_name, if_ex_line.line) if not if_ex_callable else ""
            if iface_global_target == if_ex_name:
                emit_tokens_push_sview(buffer, "export global ")
                emit_tokens_push_sview(buffer, if_ex_name)
                emit_tokens_push_sview(buffer, "\n")
                return
            emit_iface_render_tokens(buffer, tokens, source, ex_range.start, ex_range.stop)
            # `emit_ast_line_range` stops at the depth-0 colon because that is the natural
            # boundary for callable signatures. A typed extern global continues with its full
            # ABI type after that colon; dropping the suffix made generated interfaces declare
            # `extern actorat` without a type and caused cross-module consumers to lose the
            # nested array/reference shape.
            if not if_ex_callable and if_ex_ret != "" and ex_range.stop < tokens.count and tokens[ex_range.stop].kind == Lexer::TokenKind.Colon:
                emit_tokens_push_sview(buffer, ": ")
                extern_type_stop_iface: usize = emit_ast_line_end(tokens, if_ex_line.line, ex_range.stop + 1)
                emit_iface_render_tokens(buffer, tokens, source, ex_range.stop + 1, extern_type_stop_iface)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Module(if_mod_name, if_mod_body, if_mod_line):
            for module_space in 0..<indent |buffer|:
                buffer.push(32)
            emit_tokens_push_sview(buffer, "module ")
            emit_module_display_name(buffer, if_mod_name, level)
            emit_tokens_push_sview(buffer, ":\n")
            first_child: mutable bool = true
            for if_mod_child in if_mod_body |buffer, level, tokens, source, first_child|:
                emit_tokens_push_sview(buffer, "\n") if not first_child
                first_child <- false
                emit_iface_decl(buffer, if_mod_child, level + 1, tokens, source, enum_annotations)
            return
        return




    # A header line plus its indented body, rendered verbatim (enum/error/struct keep their
    # bodies in the interface).
def emit_iface_block_decl(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32, offset: u32, indent: i64) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        header_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
        return if not header_range.found
        for header_space in 0..<indent |buffer|:
            buffer.push(32)
        emit_iface_render_tokens(buffer, tokens, source, header_range.start, header_range.stop)
        emit_tokens_push_sview(buffer, ":\n")
        body_range: (found: bool, start: usize, stop: usize) = emit_iface_body_range(tokens, header_range.stop + 1)
        return if not body_range.found
        emit_iface_body_lines(buffer, tokens, source, body_range.start, body_range.stop, indent + 4, false)




def emit_iface_report(file: Ast::File&, tokens: darray[Lexer::Token]&, source: u8&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    buffer: mutable darray[u8] = []
    alias_targets: mutable darray[sview] = []
    alias_lines: mutable darray[u32] = []
    for iface_using in file.enum_annotations |alias_targets, alias_lines, file|:
        if iface_using.name == "__using_alias_target":
            alias_targets.push(iface_using.owner)
            alias_lines.push(iface_using.line)
        elif iface_using.name == "__using":
            iface_aliased: mutable bool = false
            for iface_alias_probe in file.enum_annotations |iface_aliased, iface_using|:
                iface_aliased <- true if iface_alias_probe.name == "__using_alias_target" and iface_alias_probe.owner == iface_using.owner
            if not iface_aliased:
                alias_targets.push(iface_using.owner)
                alias_lines.push(iface_using.line)
    first_decl: mutable bool = true
    for iface_declaration_index in 0..<file.top_decls.count |buffer, tokens, source, alias_targets, alias_lines, first_decl, file|:
        iface_declaration: Ast::Decl = file.top_decls[iface_declaration_index]
        iface_branch_kind: i64 = emit_ast_static_branch_kind(iface_declaration, tokens)
        # A Law is retained as a semantic node, while its synthetic bool callable is the
        # public interface declaration. Non-static Scoped nodes are implementation containers
        # (machines/impl bodies), not interface declarations. Static continuation branches are
        # emitted by their chain head below.
        if iface_declaration is Decl.Law(iface_law_name, iface_law_predicate, iface_law_line):
            continue
        continue if iface_branch_kind == 2 or iface_branch_kind == 3
        if iface_declaration is Decl.Scoped(iface_scoped_body, iface_scoped_line):
            continue if iface_branch_kind == 0
        iface_line: u32 = ast_decl_line(iface_declaration)
        for iface_alias_index in 0..<alias_targets.count |buffer, alias_targets, alias_lines, iface_line, first_decl|:
            if alias_lines[iface_alias_index] != 0 and alias_lines[iface_alias_index] < iface_line:
                emit_tokens_push_sview(buffer, "\n") if not first_decl
                first_decl <- false
                emit_tokens_push_sview(buffer, "using ")
                emit_tokens_push_sview(buffer, alias_targets[iface_alias_index])
                emit_tokens_push_sview(buffer, "\n")
                alias_lines[iface_alias_index] <- 0
        emit_tokens_push_sview(buffer, "\n") if not first_decl
        first_decl <- false
        if iface_branch_kind == 1:
            emit_iface_static_scope(buffer, iface_declaration, 0, tokens, source, file.enum_annotations)
            iface_scan_index: mutable usize = iface_declaration_index + 1
            while iface_scan_index < file.top_decls.count |buffer, tokens, source, file, iface_scan_index|:
                iface_continuation: Ast::Decl = file.top_decls[iface_scan_index]
                iface_continuation_kind: i64 = emit_ast_static_branch_kind(iface_continuation, tokens)
                break if iface_continuation_kind == 0 or iface_continuation_kind == 1
                emit_iface_static_scope(buffer, iface_continuation, 0, tokens, source, file.enum_annotations)
                iface_scan_index <- iface_scan_index + 1
        else:
            emit_iface_decl(buffer, iface_declaration, 0, tokens, source, file.enum_annotations)
    for iface_alias_tail in 0..<alias_targets.count |buffer, alias_targets, alias_lines, first_decl|:
        if alias_lines[iface_alias_tail] != 0:
            emit_tokens_push_sview(buffer, "\n") if not first_decl
            first_decl <- false
            emit_tokens_push_sview(buffer, "using ")
            emit_tokens_push_sview(buffer, alias_targets[iface_alias_tail])
            emit_tokens_push_sview(buffer, "\n")
    return 0 if buffer.count == 0 else emit_tokens_flush(buffer)
