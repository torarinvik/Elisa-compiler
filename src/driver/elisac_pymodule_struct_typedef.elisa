# `-emit pymodule` — the generated C typedef for a Python-facing record, together with the per-
# record helper functions it needs.


def emit_pymodule_struct_typedef_and_helpers(buffer: mutable darray[u8]&, file: Ast::File&, type_name: sview, emitted_names: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    for emitted_name in emitted_names:
        return if emitted_name == type_name
    emitted_names.push(type_name)
    declaration: Ast::Decl? = pymodule_find_struct_in(file.top_decls, type_name)
    if declaration is target:
        if target is Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, pos):
            # C requires nested typedefs to be visible before the containing record. Emit the
            # dependency graph depth-first; emitted_names also breaks any defensive cycle path.
            for member in members:
                nested_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                named_leaf_struct_type: sview = pymodule_named_struct_leaf_for_pymodule(file, nested_type_name, true)
                if named_leaf_struct_type != "":
                    emit_pymodule_struct_typedef_and_helpers(buffer, file, named_leaf_struct_type, emitted_names)
                elif pymodule_struct_input_supported(file, nested_type_name):
                    emit_pymodule_struct_typedef_and_helpers(buffer, file, nested_type_name, emitted_names)
                elif pymodule_is_darray_type(nested_type_name) or pymodule_is_view_type(nested_type_name):
                    nested_element_name: sview = pymodule_darray_element_name(nested_type_name) if pymodule_is_darray_type(nested_type_name) else pymodule_view_element_name(nested_type_name)
                    if pymodule_is_darray_type(nested_element_name):
                        nested_struct_name: sview = pymodule_darray_element_name(nested_element_name)
                        if pymodule_struct_input_supported(file, nested_struct_name):
                            emit_pymodule_struct_typedef_and_helpers(buffer, file, nested_struct_name, emitted_names)
                    elif pymodule_is_dict_type(nested_element_name):
                        nested_dict_value_name: sview = pymodule_dict_value_name(nested_element_name)
                        if pymodule_struct_input_supported(file, nested_dict_value_name):
                            emit_pymodule_struct_typedef_and_helpers(buffer, file, nested_dict_value_name, emitted_names)
                        elif pymodule_is_darray_type(nested_dict_value_name) and pymodule_struct_input_supported(file, pymodule_darray_element_name(nested_dict_value_name)):
                            emit_pymodule_struct_typedef_and_helpers(buffer, file, pymodule_darray_element_name(nested_dict_value_name), emitted_names)
                        elif pymodule_is_view_type(nested_dict_value_name) and pymodule_struct_input_supported(file, pymodule_view_element_name(nested_dict_value_name)):
                            emit_pymodule_struct_typedef_and_helpers(buffer, file, pymodule_view_element_name(nested_dict_value_name), emitted_names)
                    elif pymodule_struct_input_supported(file, nested_element_name):
                        emit_pymodule_struct_typedef_and_helpers(buffer, file, nested_element_name, emitted_names)
                elif pymodule_is_dict_type(nested_type_name):
                    nested_dict_value_name: sview = pymodule_dict_value_name(nested_type_name)
                    if pymodule_struct_input_supported(file, nested_dict_value_name):
                        emit_pymodule_struct_typedef_and_helpers(buffer, file, nested_dict_value_name, emitted_names)
                    elif pymodule_is_darray_type(nested_dict_value_name) and pymodule_struct_input_supported(file, pymodule_darray_element_name(nested_dict_value_name)):
                        emit_pymodule_struct_typedef_and_helpers(buffer, file, pymodule_darray_element_name(nested_dict_value_name), emitted_names)
                    elif pymodule_is_view_type(nested_dict_value_name) and pymodule_struct_input_supported(file, pymodule_view_element_name(nested_dict_value_name)):
                        emit_pymodule_struct_typedef_and_helpers(buffer, file, pymodule_view_element_name(nested_dict_value_name), emitted_names)
            emit_tokens_push_sview(buffer, "typedef struct { ")
            for member in members:
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                field_c_type_name: mutable sview = pymodule_c_type_name(field_type_name)
                field_c_type_name <- field_type_name if field_c_type_name == "" and pymodule_struct_return_supported(file, field_type_name)
                emit_tokens_push_sview(buffer, field_c_type_name)
                emit_tokens_push_sview(buffer, " ")
                emit_tokens_push_sview(buffer, pymodule_struct_c_field_name(member.name))
                emit_tokens_push_sview(buffer, "; ")
            emit_tokens_push_sview(buffer, "} ")
            emit_tokens_push_sview(buffer, type_name)
            emit_tokens_push_sview(buffer, ";\n")
            emit_tokens_push_sview(buffer, "static void elisa_pymodule_struct_")
            emit_tokens_push_sview(buffer, type_name)
            emit_tokens_push_sview(buffer, "_free(")
            emit_tokens_push_sview(buffer, type_name)
            emit_tokens_push_sview(buffer, " *value) {\n")
            for member in members:
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                if pymodule_is_darray_type(field_type_name):
                    emit_tokens_push_sview(buffer, "    value->")
                    emit_tokens_push_sview(buffer, pymodule_struct_c_field_name(member.name))
                    emit_tokens_push_sview(buffer, " = (ElisaDArray){NULL, 0, 0};\n")
                elif pymodule_is_dict_type(field_type_name):
                    emit_tokens_push_sview(buffer, "    value->")
                    emit_tokens_push_sview(buffer, pymodule_struct_c_field_name(member.name))
                    emit_tokens_push_sview(buffer, " = (ElisaDict){NULL, 0, 0, 0, NULL};\n")
                elif pymodule_is_set_type(field_type_name):
                    emit_tokens_push_sview(buffer, "    value->")
                    emit_tokens_push_sview(buffer, pymodule_struct_c_field_name(member.name))
                    emit_tokens_push_sview(buffer, " = (ElisaSet){NULL, 0, 0, 0, NULL};\n")
                elif pymodule_is_view_type(field_type_name):
                    emit_tokens_push_sview(buffer, "    value->")
                    emit_tokens_push_sview(buffer, pymodule_struct_c_field_name(member.name))
                    emit_tokens_push_sview(buffer, " = (ElisaView){NULL, 0};\n")
                elif pymodule_struct_input_supported(file, field_type_name):
                    emit_tokens_push_sview(buffer, "    elisa_pymodule_struct_")
                    emit_tokens_push_sview(buffer, field_type_name)
                    emit_tokens_push_sview(buffer, "_free(&value->")
                    emit_tokens_push_sview(buffer, pymodule_struct_c_field_name(member.name))
                    emit_tokens_push_sview(buffer, ");\n")
            emit_tokens_push_sview(buffer, "}\n")
            # Struct dictionary fields share the ordinary recursive darray bridge.  Emit the
            # field-specific helpers before either struct direction references them so nested
            # dictionary values have the same conversion and lifetime guarantees as top-level
            # parameters and error payloads.
            for member in members |buffer, file, type_name|:
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                continue if not pymodule_is_dict_type(field_type_name)
                dict_value_type: sview = pymodule_dict_value_name(field_type_name)
                if pymodule_is_dict_type(dict_value_type):
                    input_helper_storage: mutable darray[u8] = []
                    input_helper: sview = pymodule_struct_nested_dict_helper_name(&input_helper_storage, type_name, member.name, "from_py")
                    emit_pymodule_composed_dict_input_helper(buffer, file, input_helper, dict_value_type)
                    output_helper_storage: mutable darray[u8] = []
                    output_helper: sview = pymodule_struct_nested_dict_helper_name(&output_helper_storage, type_name, member.name, "to_py")
                    emit_pymodule_composed_dict_output_helper(buffer, file, output_helper, dict_value_type)
                elif pymodule_is_set_type(dict_value_type):
                    input_helper_storage: mutable darray[u8] = []
                    input_helper: sview = pymodule_struct_nested_dict_helper_name(&input_helper_storage, type_name, member.name, "from_py")
                    emit_pymodule_composed_set_input_helper(buffer, input_helper, dict_value_type)
                    output_helper_storage: mutable darray[u8] = []
                    output_helper: sview = pymodule_struct_nested_dict_helper_name(&output_helper_storage, type_name, member.name, "to_py")
                    emit_pymodule_composed_set_output_helper(buffer, output_helper, dict_value_type)
                elif pymodule_is_darray_type(dict_value_type) and pymodule_is_dict_type(pymodule_darray_element_name(dict_value_type)):
                    input_helper_storage: mutable darray[u8] = []
                    input_helper: sview = pymodule_struct_nested_dict_helper_name(&input_helper_storage, type_name, member.name, "from_py")
                    emit_pymodule_darray_dict_input_helper(buffer, file, input_helper, pymodule_darray_element_name(dict_value_type))
                    output_helper_storage: mutable darray[u8] = []
                    output_helper: sview = pymodule_struct_nested_dict_helper_name(&output_helper_storage, type_name, member.name, "to_py")
                    emit_pymodule_darray_dict_output_helper(buffer, file, output_helper, pymodule_darray_element_name(dict_value_type))
                elif pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) == 1.usize() and pymodule_struct_input_supported(file, pymodule_darray_element_name(dict_value_type)):
                    input_helper_storage: mutable darray[u8] = []
                    input_helper: sview = pymodule_struct_nested_dict_helper_name(&input_helper_storage, type_name, member.name, "from_py")
                    emit_pymodule_darray_struct_input_helper(buffer, file, input_helper, pymodule_darray_element_name(dict_value_type))
                elif pymodule_is_view_type(dict_value_type) and pymodule_darray_c_element_type(pymodule_view_element_name(dict_value_type)) == "" and pymodule_struct_input_supported(file, pymodule_view_element_name(dict_value_type)):
                    input_helper_storage: mutable darray[u8] = []
                    input_helper: sview = pymodule_struct_nested_dict_helper_name(&input_helper_storage, type_name, member.name, "from_py")
                    emit_pymodule_view_struct_input_helper(buffer, file, input_helper, pymodule_view_element_name(dict_value_type))
                elif pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) >= 2.usize() and pymodule_top_level_nested_darray_input_supported(file, dict_value_type):
                    input_helper_storage: mutable darray[u8] = []
                    input_helper: sview = pymodule_struct_nested_dict_helper_name(&input_helper_storage, type_name, member.name, "from_py")
                    emit_pymodule_composed_nested_darray_input_helper(buffer, file, input_helper, dict_value_type)
                if pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) >= 2.usize() and pymodule_top_level_nested_darray_return_supported(file, dict_value_type):
                    output_helper_storage: mutable darray[u8] = []
                    output_helper: sview = pymodule_struct_nested_dict_helper_name(&output_helper_storage, type_name, member.name, "to_py")
                    emit_pymodule_composed_nested_darray_output_helper(buffer, file, output_helper, dict_value_type)
                elif pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) == 1.usize() and pymodule_struct_return_supported(file, pymodule_darray_element_name(dict_value_type)):
                    output_helper_storage: mutable darray[u8] = []
                    output_helper: sview = pymodule_struct_nested_dict_helper_name(&output_helper_storage, type_name, member.name, "to_py")
                    emit_pymodule_darray_struct_output_helper(buffer, file, output_helper, pymodule_darray_element_name(dict_value_type))
                elif pymodule_is_view_type(dict_value_type) and pymodule_darray_c_element_type(pymodule_view_element_name(dict_value_type)) == "" and pymodule_struct_return_supported(file, pymodule_view_element_name(dict_value_type)):
                    output_helper_storage: mutable darray[u8] = []
                    output_helper: sview = pymodule_struct_nested_dict_helper_name(&output_helper_storage, type_name, member.name, "to_py")
                    emit_pymodule_view_struct_output_helper(buffer, file, output_helper, pymodule_view_element_name(dict_value_type))
            for member in members |buffer, file, type_name|:
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                continue if not pymodule_is_darray_type(field_type_name)
                dict_element_name: sview = pymodule_darray_element_name(field_type_name)
                continue if not pymodule_is_dict_type(dict_element_name)
                if pymodule_nested_dict_values_supported_in_type(file, dict_element_name, 0.usize()):
                    input_helper_storage: mutable darray[u8] = []
                    input_helper: sview = pymodule_struct_darray_dict_helper_name(&input_helper_storage, type_name, member.name, "from_py")
                    emit_pymodule_darray_dict_input_helper(buffer, file, input_helper, dict_element_name)
                    output_helper_storage: mutable darray[u8] = []
                    output_helper: sview = pymodule_struct_darray_dict_helper_name(&output_helper_storage, type_name, member.name, "to_py")
                    emit_pymodule_darray_dict_output_helper(buffer, file, output_helper, dict_element_name)
            for member in members |buffer, type_name|:
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                continue if not pymodule_is_darray_type(field_type_name)
                set_element_name: sview = pymodule_darray_element_name(field_type_name)
                continue if not pymodule_is_set_type(set_element_name)
                input_helper_storage: mutable darray[u8] = []
                input_helper: sview = pymodule_struct_darray_set_helper_name(&input_helper_storage, type_name, member.name, "from_py")
                emit_pymodule_darray_set_input_helper(buffer, input_helper, set_element_name)
                output_helper_storage: mutable darray[u8] = []
                output_helper: sview = pymodule_struct_darray_set_helper_name(&output_helper_storage, type_name, member.name, "to_py")
                emit_pymodule_darray_set_output_helper(buffer, output_helper, set_element_name)
            # Nested list fields use the same recursive helper chain as top-level list
            # parameters.  Generate field-specific wrappers so the struct converter can pass
            # its shared arena/reference table through every depth without embedding a fixed
            # two-level layout in the containing record helper.
            for member in members |buffer, file, type_name|:
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                continue if not pymodule_is_darray_type(field_type_name) or pymodule_darray_nesting_depth(field_type_name) < 2.usize()
                if pymodule_top_level_nested_darray_input_supported(file, field_type_name):
                    input_helper_storage: mutable darray[u8] = []
                    input_helper: sview = pymodule_struct_darray_nested_helper_name(&input_helper_storage, type_name, member.name, "from_py")
                    emit_pymodule_composed_nested_darray_input_helper(buffer, file, input_helper, field_type_name)
                if pymodule_top_level_nested_darray_return_supported(file, field_type_name):
                    output_helper_storage: mutable darray[u8] = []
                    output_helper: sview = pymodule_struct_darray_nested_helper_name(&output_helper_storage, type_name, member.name, "to_py")
                    emit_pymodule_composed_nested_darray_output_helper(buffer, file, output_helper, field_type_name)
            if pymodule_struct_return_supported(file, type_name):
                emit_tokens_push_sview(buffer, "static PyObject *elisa_pymodule_struct_")
                emit_tokens_push_sview(buffer, type_name)
                emit_tokens_push_sview(buffer, "_to_py(")
                emit_tokens_push_sview(buffer, type_name)
                emit_tokens_push_sview(buffer, " value) { PyObject *out = PyDict_New(); if (out == NULL) return NULL;\n")
                for member in members:
                    field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                    nested_dict_output_helper: mutable sview = ""
                    if pymodule_is_dict_type(field_type_name):
                        dict_value_type: sview = pymodule_dict_value_name(field_type_name)
                        if pymodule_is_dict_type(dict_value_type) or pymodule_is_set_type(dict_value_type) or (pymodule_is_darray_type(dict_value_type) and pymodule_is_dict_type(pymodule_darray_element_name(dict_value_type))) or (pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) == 1.usize() and pymodule_struct_return_supported(file, pymodule_darray_element_name(dict_value_type))) or (pymodule_is_view_type(dict_value_type) and pymodule_darray_c_element_type(pymodule_view_element_name(dict_value_type)) == "" and pymodule_struct_return_supported(file, pymodule_view_element_name(dict_value_type))) or (pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) >= 2.usize() and pymodule_top_level_nested_darray_return_supported(file, dict_value_type)):
                            nested_dict_output_helper_storage: mutable darray[u8] = []
                            nested_dict_output_helper <- pymodule_struct_nested_dict_helper_name(&nested_dict_output_helper_storage, type_name, member.name, "to_py")
                    pymodule_struct_field_c_to_py(buffer, file, field_type_name, member.name, pymodule_struct_c_field_name(member.name), nested_dict_output_helper, type_name)
                emit_tokens_push_sview(buffer, "    return out; }\n")
            emit_tokens_push_sview(buffer, "static int elisa_pymodule_struct_")
            emit_tokens_push_sview(buffer, type_name)
            emit_tokens_push_sview(buffer, "_from_py(PyObject *object, ")
            emit_tokens_push_sview(buffer, type_name)
            emit_tokens_push_sview(buffer, " *out, ElisaArena *arena, ElisaPyRefs *refs) {\n")
            for member in members:
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                nested_dict_input_helper: mutable sview = ""
                if pymodule_is_dict_type(field_type_name):
                    dict_value_type: sview = pymodule_dict_value_name(field_type_name)
                    if pymodule_is_dict_type(dict_value_type) or pymodule_is_set_type(dict_value_type) or (pymodule_is_darray_type(dict_value_type) and pymodule_is_dict_type(pymodule_darray_element_name(dict_value_type))) or (pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) == 1.usize() and pymodule_struct_input_supported(file, pymodule_darray_element_name(dict_value_type))) or (pymodule_is_view_type(dict_value_type) and pymodule_darray_c_element_type(pymodule_view_element_name(dict_value_type)) == "" and pymodule_struct_input_supported(file, pymodule_view_element_name(dict_value_type))) or (pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) >= 2.usize() and pymodule_top_level_nested_darray_input_supported(file, dict_value_type)):
                        nested_dict_input_helper_storage: mutable darray[u8] = []
                        nested_dict_input_helper <- pymodule_struct_nested_dict_helper_name(&nested_dict_input_helper_storage, type_name, member.name, "from_py")
                pymodule_struct_field_py_to_c(buffer, file, field_type_name, member.name, pymodule_struct_c_field_name(member.name), member.has_default, member.default_value, nested_dict_input_helper, type_name)
            emit_tokens_push_sview(buffer, "    return 0; }\n\n")
