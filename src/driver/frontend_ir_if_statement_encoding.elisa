# Stage0 frontend-IR v2 schema IDs for statement-form IfStmt nodes.
module FrontendIrIfStatementEncoding:
    public:
        const enum IfStmtField of u8:
            Condition
            ElseBody
            FromSource
            Position
            ThenBody

        const IF_STMT_NODE_TYPE_ID: u32 = 133
        const IF_CONDITION_FIELD_ID: u32 = 1
        const IF_ELSE_BODY_FIELD_ID: u32 = 3
        const IF_FROM_SOURCE_FIELD_ID: u32 = 4
        const IF_POSITION_FIELD_ID: u32 = 6
        const IF_THEN_BODY_FIELD_ID: u32 = 7

        def node_type_id() -> u32:
            ensure result == IF_STMT_NODE_TYPE_ID
            return IF_STMT_NODE_TYPE_ID

        def field_id(field: IfStmtField) -> u32:
            ensure field != IfStmtField.Condition or result == IF_CONDITION_FIELD_ID
            ensure field != IfStmtField.ElseBody or result == IF_ELSE_BODY_FIELD_ID
            ensure field != IfStmtField.FromSource or result == IF_FROM_SOURCE_FIELD_ID
            ensure field != IfStmtField.Position or result == IF_POSITION_FIELD_ID
            ensure field != IfStmtField.ThenBody or result == IF_THEN_BODY_FIELD_ID
            return match field:
                IfStmtField.Condition: IF_CONDITION_FIELD_ID
                IfStmtField.ElseBody: IF_ELSE_BODY_FIELD_ID
                IfStmtField.FromSource: IF_FROM_SOURCE_FIELD_ID
                IfStmtField.Position: IF_POSITION_FIELD_ID
                IfStmtField.ThenBody: IF_THEN_BODY_FIELD_ID
