# open(2) flags for "write, create, truncate" on the HOST the driver runs on.
# The values differ per OS (Darwin O_CREAT is 0x200, Linux 0x40), so a hardcoded
# Darwin 1537 left every Linux-hosted file write without O_CREAT.
static if ELISA_TARGET_OS_LINUX:
    module HostFileOpen:
        public:
            const WRITE_CREATE_TRUNCATE: i64 = 577
static else:
    module HostFileOpen:
        public:
            const WRITE_CREATE_TRUNCATE: i64 = 1537
