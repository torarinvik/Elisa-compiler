# Stage0 frontend-IR v2 schema IDs for statement-form WhileStmt nodes.
module FrontendIrWhileStatementEncoding:
    public:
        const enum WhileStmtField of u8:
            Body
            Condition
            Position

        const WHILE_STMT_NODE_TYPE_ID: u32 = 276
        const WHILE_BODY_FIELD_ID: u32 = 1
        const WHILE_CONDITION_FIELD_ID: u32 = 3
        const WHILE_POSITION_FIELD_ID: u32 = 5

        def node_type_id() -> u32:
            ensure result == WHILE_STMT_NODE_TYPE_ID
            return WHILE_STMT_NODE_TYPE_ID

        def field_id(field: WhileStmtField) -> u32:
            ensure field != WhileStmtField.Body or result == WHILE_BODY_FIELD_ID
            ensure field != WhileStmtField.Condition or result == WHILE_CONDITION_FIELD_ID
            ensure field != WhileStmtField.Position or result == WHILE_POSITION_FIELD_ID
            return match field:
                WhileStmtField.Body: WHILE_BODY_FIELD_ID
                WhileStmtField.Condition: WHILE_CONDITION_FIELD_ID
                WhileStmtField.Position: WHILE_POSITION_FIELD_ID
