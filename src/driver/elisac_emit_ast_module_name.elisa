# A nested module can be written with its own qualified path. The compact AST
# summary prints that source path, rather than stripping a fixed number of
# segments from the parser's canonical module identity.
def emit_ast_module_source_name(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, position: Ast::Pos, canonical: sview, level: i64) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    span: (found: bool, start: usize, stop: usize) = emit_ast_precise_range_at(tokens, position.line, position.offset) can Global{Read,Write}
    if span.found:
        for index in span.start..<span.stop |buffer, tokens, source, span|:
            word: sview = Lexer::text_or_empty(tokens[index], source, Lexer::token_stream_source_length(tokens))
            if (word == "module" or word == "extend") and index + 1 < span.stop:
                emit_ast_render_tokens(buffer, tokens, source, index + 1, span.stop)
                return
    emit_module_display_name(buffer, canonical, level)
