    emit_tokens_push_sview(buffer, "if (nested_value_obj == NULL) { Py_DECREF(field_value); Py_DECREF(out); return NULL; } PyList_SET_ITEM(field_value, field_index, nested_value_obj); } } ")




# Standalone function parameters/returns reuse the struct nested-list converter through tiny
# generated helpers. Keeping the conversion in a helper gives it the same arena/reference
# lifetime rules as nested struct fields without duplicating the element matrix in the wrapper.
def emit_pymodule_top_level_nested_darray_input_helper(buffer: mutable darray[u8]&, file: Ast::File&, helper_name: sview, element_name: sview) -> void can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(buffer, "static int ")
    emit_tokens_push_sview(buffer, helper_name)
    # The struct-field converter owns and decrefs its `field_obj` reference. Top-level wrapper
    # arguments are borrowed from `args`, so take a temporary owned reference before reusing it;
    # otherwise a literal nested list can leave the call tuple holding a freed object on return.
    emit_tokens_push_sview(buffer, "(PyObject *field_obj, ElisaDArray *destination, ElisaArena *arena, ElisaPyRefs *refs) { Py_INCREF(field_obj); struct { ElisaDArray value; } holder = {{0}};\n#define out (&holder)\n")
    emit_pymodule_struct_nested_darray_input(buffer, file, "value", element_name)
    # `emit_pymodule_struct_nested_darray_input` consumes the owned field reference on every
    # failure path.  Balance the helper's protective INCREF on success as well; otherwise each
    # successful nested-list call leaks one Python reference to the caller's sequence.
    emit_tokens_push_sview(buffer, "\n#undef out\nPy_DECREF(field_obj); *destination = holder.value; return 0; }\n")




def emit_pymodule_top_level_nested_darray_output_helper(buffer: mutable darray[u8]&, file: Ast::File&, helper_name: sview, element_name: sview) -> void can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(buffer, "static PyObject *")
    emit_tokens_push_sview(buffer, helper_name)
    emit_tokens_push_sview(buffer, "(ElisaDArray input) { struct { ElisaDArray value; } value = {input}; PyObject *out = PyList_New(0); if (out == NULL) return NULL; PyObject *field_value = NULL; ")
    emit_pymodule_struct_nested_darray_output(buffer, file, "value", element_name)
    emit_tokens_push_sview(buffer, "Py_DECREF(out); return field_value; }\n")




# Compose the two-level field converter above for arbitrary top-level nesting. Each generated
# helper has the same borrowed-PyObject contract as the ordinary wrapper: it never consumes its
# argument, while the innermost helper retains any opaque objects through the per-call refs table.
def emit_pymodule_composed_nested_darray_input_helper(buffer: mutable darray[u8]&, file: Ast::File&, helper_name: sview, type_name: sview) -> void can[Abort.Panic, Memory.Allocate]:
    element_name: sview = pymodule_darray_element_name(type_name)
    base_element_name: sview = pymodule_darray_element_name(element_name) if pymodule_is_darray_type(element_name) else element_name
    if not pymodule_is_darray_type(base_element_name):
        emit_pymodule_top_level_nested_darray_input_helper(buffer, file, helper_name, base_element_name)
        return
    inner_helper_storage: mutable darray[u8] = []
    for helper_index in 0..<sview_len(helper_name) |inner_helper_storage, helper_name, helper_index|:
        inner_helper_storage.push(sview_at(helper_name, helper_index))
    emit_tokens_push_sview(&inner_helper_storage, "_inner")
    inner_helper: sview = sview(&inner_helper_storage[0], 0, inner_helper_storage.count)
    emit_pymodule_composed_nested_darray_input_helper(buffer, file, inner_helper, element_name)
    emit_tokens_push_sview(buffer, "static int ")
    emit_tokens_push_sview(buffer, helper_name)
    emit_tokens_push_sview(buffer, "(PyObject *field_obj, ElisaDArray *destination, ElisaArena *arena, ElisaPyRefs *refs) { PyObject *field_seq = PySequence_Fast(field_obj, \"expected a sequence for nested darray\"); if (field_seq == NULL) return -1; Py_ssize_t field_count = PySequence_Fast_GET_SIZE(field_seq); if (field_count > PY_SSIZE_T_MAX / (Py_ssize_t)sizeof(ElisaDArray)) { Py_DECREF(field_seq); PyErr_SetString(PyExc_OverflowError, \"nested darray is too large\"); return -1; } destination->items = NULL; destination->count = (int64_t)field_count; destination->capacity = (int64_t)field_count; if (field_count > 0) { destination->items = arena_alloc(arena, (int64_t)((size_t)field_count * sizeof(ElisaDArray))); if (destination->items == NULL) { Py_DECREF(field_seq); PyErr_NoMemory(); return -1; } } for (Py_ssize_t field_index = 0; field_index < field_count; ++field_index) { Py_ssize_t field_path_mark = elisa_pymodule_current_path_length; if (elisa_pymodule_current_path_push_index(field_index) < 0) { Py_DECREF(field_seq); return -1; } PyObject *nested_item = PySequence_Fast_GET_ITEM(field_seq, field_index); if (")
    emit_tokens_push_sview(buffer, inner_helper)
    emit_tokens_push_sview(buffer, "(nested_item, &((ElisaDArray *)destination->items)[field_index], arena, refs) < 0) { Py_DECREF(field_seq); return -1; } elisa_pymodule_current_path_restore(field_path_mark); } Py_DECREF(field_seq); return 0; }\n")




def emit_pymodule_composed_nested_darray_output_helper(buffer: mutable darray[u8]&, file: Ast::File&, helper_name: sview, type_name: sview) -> void can[Abort.Panic, Memory.Allocate]:
    element_name: sview = pymodule_darray_element_name(type_name)
    base_element_name: sview = pymodule_darray_element_name(element_name) if pymodule_is_darray_type(element_name) else element_name
    if not pymodule_is_darray_type(base_element_name):
