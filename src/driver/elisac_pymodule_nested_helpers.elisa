    emit_tokens_push_sview(buffer, "(ElisaDArray input) { if (input.count < 0 || input.capacity < 0 || input.count > input.capacity || input.count > (int64_t)PY_SSIZE_T_MAX || input.capacity > (int64_t)PY_SSIZE_T_MAX || (input.count > 0 && input.items == NULL)) { PyErr_SetString(PyExc_RuntimeError, \"native nested darray has invalid storage\"); return NULL; } PyObject *out = PyList_New((Py_ssize_t)input.count); if (out == NULL) return NULL; for (Py_ssize_t field_index = 0; field_index < (Py_ssize_t)input.count; ++field_index) { PyObject *nested_item = ")
    emit_tokens_push_sview(buffer, inner_helper)
    emit_tokens_push_sview(buffer, "(((ElisaDArray *)input.items)[field_index]); if (nested_item == NULL) { Py_DECREF(out); return NULL; } PyList_SET_ITEM(out, field_index, nested_item); } return out; }\n")




# A darray of dictionaries is represented by a normal ElisaDArray whose element ABI is ElisaDict.
# Reuse the ordinary dictionary converters for each element so list[dict] gets the same key/value
# validation, arena ownership, nested mappings, and Python object retention as a standalone dict.
