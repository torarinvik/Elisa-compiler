# `-emit pymodule` — the generated module's TABLES and its post-processing: the per-record field
# and optional-field name tables, the error payload variants, the method and constant tables,
# `__all__`, and the textual replacements that patch the assembled C source before it is
# flushed. The tail of the module assembly begun in elisac_pymodule_c_report.elisa.

def emit_pymodule_c_tables(buffer: mutable darray[u8]&, file: mutable Ast::File&, module_name: sview) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    error_families: darray[sview] = pymodule_error_families(file)
    for struct_field_index in 0..<file.struct_names.count |buffer, file|:
        emit_tokens_push_sview(buffer, "static const char *elisa_pymodule_struct_fields_")
        append_decimal(buffer, struct_field_index.u32())
        emit_tokens_push_sview(buffer, "[] = {")
        struct_field_decl: Ast::Decl? = pymodule_find_struct_in(file.top_decls, file.struct_names[struct_field_index])
        if struct_field_decl is struct_field_found:
            if struct_field_found is Decl.Struct(struct_field_name, struct_field_members, struct_field_affinity, struct_field_states, struct_field_derive, struct_field_invariants, struct_field_pos):
                for struct_field in struct_field_members |buffer|:
                    emit_tokens_push_sview(buffer, "\"")
                    emit_tokens_push_sview(buffer, struct_field.name)
                    emit_tokens_push_sview(buffer, "\",")
        emit_tokens_push_sview(buffer, "NULL};\n")
        emit_tokens_push_sview(buffer, "static const bool elisa_pymodule_struct_optional_")
        append_decimal(buffer, struct_field_index.u32())
        emit_tokens_push_sview(buffer, "[] = {")
        struct_optional_decl: Ast::Decl? = pymodule_find_struct_in(file.top_decls, file.struct_names[struct_field_index])
        if struct_optional_decl is struct_optional_found:
            if struct_optional_found is Decl.Struct(struct_optional_name, struct_optional_members, struct_optional_affinity, struct_optional_states, struct_optional_derive, struct_optional_invariants, struct_optional_pos):
                for struct_optional_field in struct_optional_members |buffer, file|:
                    struct_optional_type_name: sview = pymodule_alias_type_name(file, struct_optional_field.type_expression)
                    if struct_optional_field.has_default or pymodule_parameter_is_implicit_optional(struct_optional_type_name):
                        emit_tokens_push_sview(buffer, "true,")
                    else:
                        emit_tokens_push_sview(buffer, "false,")
        emit_tokens_push_sview(buffer, "false};\n")
    emit_tokens_push_sview(buffer, "static const char *elisa_pymodule_struct_names[] = {")
    for struct_name_index in 0..<file.struct_names.count |buffer, file|:
        emit_tokens_push_sview(buffer, "\"")
        emit_tokens_push_sview(buffer, file.struct_names[struct_name_index])
        emit_tokens_push_sview(buffer, "\",")
    emit_tokens_push_sview(buffer, "NULL};\nstatic const bool elisa_pymodule_struct_readable[] = {")
    for struct_readable_index in 0..<file.struct_names.count |buffer, file|:
        if pymodule_python_name_is_identifier(file.struct_names[struct_readable_index]):
            emit_tokens_push_sview(buffer, "true,")
        else:
            emit_tokens_push_sview(buffer, "false,")
    emit_tokens_push_sview(buffer, "false};\nstatic const char *const *elisa_pymodule_struct_fields[] = {")
    for struct_fields_index in 0..<file.struct_names.count |buffer|:
        emit_tokens_push_sview(buffer, "elisa_pymodule_struct_fields_")
        append_decimal(buffer, struct_fields_index.u32())
        emit_tokens_push_sview(buffer, ",")
    emit_tokens_push_sview(buffer, "NULL};\n")
    emit_tokens_push_sview(buffer, "static const bool *elisa_pymodule_struct_optional_fields[] = {")
    for struct_optional_fields_index in 0..<file.struct_names.count |buffer|:
        emit_tokens_push_sview(buffer, "elisa_pymodule_struct_optional_")
        append_decimal(buffer, struct_optional_fields_index.u32())
        emit_tokens_push_sview(buffer, ",")
    emit_tokens_push_sview(buffer, "NULL};\n")
    payload_variant_index: mutable usize = 0.usize()
    for payload_family in error_families |buffer, file, payload_variant_index|:
        continue if not pymodule_error_payload_is_structured_in(file.top_decls, payload_family)
        payload_decl: Ast::Decl? = pymodule_error_decl_in(file.top_decls, payload_family)
        if payload_decl is payload_enum_decl:
            if payload_enum_decl is Decl.Enum(payload_enum_name, payload_variants, payload_const, payload_storage, payload_pos):
                for payload_variant in payload_variants |buffer, payload_variant_index|:
                    emit_tokens_push_sview(buffer, "static const char *elisa_pymodule_payload_fields_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, "[] = {\"variant\",")
                    for payload_field_index in 0..<payload_variant.fields.count |buffer, payload_variant|:
                        emit_tokens_push_sview(buffer, "\"")
                        if payload_field_index < payload_variant.field_names.count and payload_variant.field_names[payload_field_index] != "":
                            emit_tokens_push_sview(buffer, payload_variant.field_names[payload_field_index])
                        else:
                            emit_tokens_push_sview(buffer, "field_")
                            append_decimal(buffer, payload_field_index.u32())
                        emit_tokens_push_sview(buffer, "\",")
                    emit_tokens_push_sview(buffer, "NULL};\nstatic const bool elisa_pymodule_payload_optional_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, "[] = {false,")
                    for _payload_field_index in 0..<payload_variant.fields.count |buffer|:
                        emit_tokens_push_sview(buffer, "false,")
                    emit_tokens_push_sview(buffer, "false};\n")
                    payload_variant_index <- payload_variant_index + 1.usize()
    pymodule_function_count: mutable usize = 0
    for count_annotation in file.enum_annotations |pymodule_function_count|:
        pymodule_function_count <- pymodule_function_count + 1 if count_annotation.name == "__pymodule_fn"
    pymodule_constant_count: mutable usize = 0
    for count_const_annotation in file.enum_annotations |pymodule_constant_count|:
        pymodule_constant_count <- pymodule_constant_count + 1 if count_const_annotation.name == "__pymodule_const"
    emit_tokens_push_sview(buffer, "static PyMethodDef elisa_methods[] = {\n")
    for annotation in file.enum_annotations |buffer|:
        continue if annotation.name != "__pymodule_fn"
        doc_target: mutable sview = ""
        for doc_target_annotation in file.enum_annotations |doc_target, annotation|:
            doc_target <- doc_target_annotation.owner if doc_target_annotation.name == "__pymodule_target_ref" and doc_target_annotation.line == annotation.line
        emit_tokens_push_sview(buffer, "    {\"")
        emit_tokens_push_sview(buffer, annotation.owner)
        emit_tokens_push_sview(buffer, "\", (PyCFunction)(void(*)(void))elisa_py_")
        emit_tokens_push_sview(buffer, annotation.owner)
        emit_tokens_push_sview(buffer, ", METH_VARARGS | METH_KEYWORDS, \"")
        emit_tokens_push_sview(buffer, annotation.owner)
        emit_tokens_push_sview(buffer, "($module")
        doc_target_decl: Ast::Decl? = pymodule_find_function_in(file.top_decls, doc_target)
        if doc_target_decl is doc_target_function:
            if doc_target_function is Decl.Func(doc_target_function_name, doc_target_params, doc_target_return, doc_target_body, doc_target_effects, doc_target_decorators, doc_target_pos):
                for doc_parameter_index in 0..<doc_target_params.count |buffer, doc_target_params|:
                    emit_tokens_push_sview(buffer, ", ")
                    emit_tokens_push_sview(buffer, doc_target_params[doc_parameter_index].name)
                    if doc_target_params[doc_parameter_index].has_default:
                        emit_tokens_push_sview(buffer, "=")
                        emit_pymodule_default_signature_literal(buffer, file, doc_target_params[doc_parameter_index].default_value, pymodule_alias_type_name(file, doc_target_params[doc_parameter_index].type_expression))
                    elif pymodule_parameter_is_implicit_optional(pymodule_alias_type_name(file, doc_target_params[doc_parameter_index].type_expression)):
                        emit_tokens_push_sview(buffer, "=None")
        emit_tokens_push_sview(buffer, ")\\n--\\n\\nElisa export of ")
        emit_tokens_push_sview(buffer, doc_target)
        emit_tokens_push_sview(buffer, ".\"},\n")
    emit_tokens_push_sview(buffer, "    {NULL, NULL, 0, NULL}\n};\n\nstatic struct PyModuleDef elisa_module = {\n    PyModuleDef_HEAD_INIT,\n    \"")
    emit_tokens_push_sview(buffer, module_name)
    emit_tokens_push_sview(buffer, "\",\n    NULL,\n    -1,\n    elisa_methods\n};\n\nPyMODINIT_FUNC PyInit_")
    emit_tokens_push_sview(buffer, module_name)
    emit_tokens_push_sview(buffer, "(void) {\n    PyObject *module = PyModule_Create(&elisa_module);\n    if (module == NULL) return NULL;\n    PyObject *elisa_all = PyList_New(")
    append_decimal(buffer, (pymodule_function_count + pymodule_constant_count + error_families.count + 1).u32())
    emit_tokens_push_sview(buffer, ");\n    if (elisa_all == NULL) { Py_DECREF(module); return NULL; }\n    PyObject *elisa_all_item = NULL;\n")
    all_index: mutable usize = 0
    for all_annotation in file.enum_annotations |buffer, all_index|:
        continue if all_annotation.name != "__pymodule_fn"
        emit_tokens_push_sview(buffer, "    elisa_all_item = PyUnicode_FromString(\"")
        emit_tokens_push_sview(buffer, all_annotation.owner)
        emit_tokens_push_sview(buffer, "\");\n    if (elisa_all_item == NULL) { Py_DECREF(elisa_all); Py_DECREF(module); return NULL; }\n    PyList_SET_ITEM(elisa_all, ")
        append_decimal(buffer, all_index.u32())
        emit_tokens_push_sview(buffer, ", elisa_all_item);\n")
        all_index <- all_index + 1
    for all_const_annotation in file.enum_annotations |buffer, all_index|:
        continue if all_const_annotation.name != "__pymodule_const"
        emit_tokens_push_sview(buffer, "    elisa_all_item = PyUnicode_FromString(\"")
        emit_tokens_push_sview(buffer, all_const_annotation.owner)
        emit_tokens_push_sview(buffer, "\");\n    if (elisa_all_item == NULL) { Py_DECREF(elisa_all); Py_DECREF(module); return NULL; }\n    PyList_SET_ITEM(elisa_all, ")
        append_decimal(buffer, all_index.u32())
        emit_tokens_push_sview(buffer, ", elisa_all_item);\n")
        all_index <- all_index + 1
    for error_family in error_families |buffer, all_index|:
        emit_tokens_push_sview(buffer, "    elisa_all_item = PyUnicode_FromString(\"")
        emit_tokens_push_sview(buffer, error_family)
        emit_tokens_push_sview(buffer, "\");\n    if (elisa_all_item == NULL) { Py_DECREF(elisa_all); Py_DECREF(module); return NULL; }\n    PyList_SET_ITEM(elisa_all, ")
        append_decimal(buffer, all_index.u32())
        emit_tokens_push_sview(buffer, ", elisa_all_item);\n")
        all_index <- all_index + 1
    emit_tokens_push_sview(buffer, "    elisa_all_item = PyUnicode_FromString(\"ElisaError\");\n    if (elisa_all_item == NULL) { Py_DECREF(elisa_all); Py_DECREF(module); return NULL; }\n    PyList_SET_ITEM(elisa_all, ")
    append_decimal(buffer, all_index.u32())
    emit_tokens_push_sview(buffer, ", elisa_all_item);\n    if (PyModule_AddObject(module, \"__all__\", elisa_all) < 0) { Py_DECREF(elisa_all); Py_DECREF(module); return NULL; }\n    elisa_error_type = PyErr_NewException(\"")
    emit_tokens_push_sview(buffer, module_name)
    emit_tokens_push_sview(buffer, ".ElisaError\", PyExc_RuntimeError, NULL);\n    if (elisa_error_type == NULL) { Py_DECREF(module); return NULL; }\n    if (PyModule_AddObject(module, \"ElisaError\", elisa_error_type) < 0) { Py_DECREF(elisa_error_type); elisa_error_type = NULL; Py_DECREF(module); return NULL; }\n")
    emit_tokens_push_sview(buffer, "    if (PyObject_SetAttrString(elisa_error_type, \"payload\", Py_None) < 0 || PyObject_SetAttrString(elisa_error_type, \"parameter\", Py_None) < 0 || PyObject_SetAttrString(elisa_error_type, \"expected\", Py_None) < 0 || PyObject_SetAttrString(elisa_error_type, \"path\", Py_None) < 0) { Py_DECREF(module); return NULL; }\n")
    for error_family in error_families |buffer, module_name|:
        emit_tokens_push_sview(buffer, "    { PyObject *elisa_family_type = PyErr_NewException(\"")
        emit_tokens_push_sview(buffer, module_name)
        emit_tokens_push_sview(buffer, ".")
        emit_tokens_push_sview(buffer, error_family)
        emit_tokens_push_sview(buffer, "\", elisa_error_type, NULL);\n    if (elisa_family_type == NULL) { Py_DECREF(module); return NULL; }\n    for (ElisaPymoduleErrorEntry *elisa_family_entry = elisa_pymodule_error_entries; elisa_family_entry->name != NULL; ++elisa_family_entry) { if (elisa_pymodule_error_name_equal(elisa_family_entry->name, \"")
        emit_tokens_push_sview(buffer, error_family)
        emit_tokens_push_sview(buffer, "\")) { elisa_family_entry->type = elisa_family_type; break; } }\n    if (PyModule_AddObject(module, \"")
        emit_tokens_push_sview(buffer, error_family)
        emit_tokens_push_sview(buffer, "\", elisa_family_type) < 0) { Py_DECREF(elisa_family_type); Py_DECREF(module); return NULL; } }\n")
    emit_tokens_push_sview(buffer, "    PyObject *elisa_constant = NULL;\n") if pymodule_constant_count > 0
    for constant_annotation in file.enum_annotations |buffer, file, module_name|:
        continue if constant_annotation.name != "__pymodule_const"
        constant_target: mutable sview = ""
        for constant_target_annotation in file.enum_annotations |constant_target, constant_annotation|:
            constant_target <- constant_target_annotation.owner if constant_target_annotation.name == "__pymodule_const_target_ref" and constant_target_annotation.line == constant_annotation.line
        constant_decl: Ast::Decl? = pymodule_find_const_in(file.top_decls, constant_target)
        if constant_decl is constant_target_decl:
            if constant_target_decl is Decl.Const(constant_target_name, constant_target_type, constant_target_value, constant_target_mutable, constant_target_pos):
                constant_type_name: sview = pymodule_const_decl_type_name(file, constant_target_type, constant_target_value)
                constant_c_type: sview = pymodule_c_type_name(constant_type_name)
                if constant_type_name == "cstr":
                    emit_tokens_push_sview(buffer, "    { const char *elisa_constant_text = elisa_pymodule_")
                    emit_tokens_push_sview(buffer, module_name)
                    emit_tokens_push_sview(buffer, "_")
                    emit_tokens_push_sview(buffer, constant_annotation.owner)
                    emit_tokens_push_sview(buffer, "();\n    if (elisa_constant_text == NULL) { PyErr_SetString(PyExc_RuntimeError, \"native Elisa cstr constant is null\"); Py_DECREF(module); return NULL; }\n    elisa_constant = PyUnicode_FromString(elisa_constant_text); }\n")
                elif constant_type_name == "sview":
                    emit_tokens_push_sview(buffer, "    { ElisaSView elisa_constant_view = elisa_pymodule_")
                    emit_tokens_push_sview(buffer, module_name)
                    emit_tokens_push_sview(buffer, "_")
                    emit_tokens_push_sview(buffer, constant_annotation.owner)
                    emit_tokens_push_sview(buffer, "();\n    if (elisa_constant_view.len < 0 || elisa_constant_view.len > PY_SSIZE_T_MAX || (elisa_constant_view.data == NULL && elisa_constant_view.len != 0)) { PyErr_SetString(PyExc_RuntimeError, \"native Elisa sview constant is invalid\"); Py_DECREF(module); return NULL; }\n    if (elisa_constant_view.data == NULL) elisa_constant = PyUnicode_FromString(\"\"); else elisa_constant = PyUnicode_DecodeUTF8(elisa_constant_view.data, (Py_ssize_t)elisa_constant_view.len, \"strict\"); }\n")
                elif pymodule_darray_is_bytes(constant_type_name):
                    emit_tokens_push_sview(buffer, "    { ElisaDArray elisa_constant_bytes = {0};\n    elisa_pymodule_")
                    emit_tokens_push_sview(buffer, module_name)
                    emit_tokens_push_sview(buffer, "_")
                    emit_tokens_push_sview(buffer, constant_annotation.owner)
                    emit_tokens_push_sview(buffer, "(&elisa_constant_bytes);\n    if (elisa_constant_bytes.count < 0 || elisa_constant_bytes.count > PY_SSIZE_T_MAX || (elisa_constant_bytes.items == NULL && elisa_constant_bytes.count != 0)) { PyErr_SetString(PyExc_RuntimeError, \"native Elisa byte constant is invalid\"); Py_DECREF(module); return NULL; }\n    elisa_constant = PyBytes_FromStringAndSize((const char *)elisa_constant_bytes.items, (Py_ssize_t)elisa_constant_bytes.count); }\n")
                else:
                    emit_tokens_push_sview(buffer, "    elisa_constant = ")
                    if constant_type_name == "bool":
                        emit_tokens_push_sview(buffer, "PyBool_FromLong((long)elisa_pymodule_")
                    elif constant_type_name == "f32" or constant_type_name == "f64":
                        emit_tokens_push_sview(buffer, "PyFloat_FromDouble((double)elisa_pymodule_")
                    elif constant_type_name == "u8" or constant_type_name == "u16" or constant_type_name == "u32" or constant_type_name == "u64" or constant_type_name == "usize" or constant_type_name == "uintptr":
                        emit_tokens_push_sview(buffer, "PyLong_FromUnsignedLongLong((unsigned long long)elisa_pymodule_")
                    else:
                        emit_tokens_push_sview(buffer, "PyLong_FromLongLong((long long)elisa_pymodule_")
                    emit_tokens_push_sview(buffer, module_name)
                    emit_tokens_push_sview(buffer, "_")
                    emit_tokens_push_sview(buffer, constant_annotation.owner)
                    emit_tokens_push_sview(buffer, "());\n")
                emit_tokens_push_sview(buffer, "    if (elisa_constant == NULL) { Py_DECREF(module); return NULL; }\n    if (PyModule_AddObject(module, \"")
                emit_tokens_push_sview(buffer, constant_annotation.owner)
                emit_tokens_push_sview(buffer, "\", elisa_constant) < 0) { Py_DECREF(elisa_constant); Py_DECREF(module); return NULL; }\n")
    # Make named structs constructible from Python and keep their concrete aliases
    # in sync with the stub renderer.  The companion `*Input` attribute is a
    # runtime alias of the same TypedDict factory; it is intentionally omitted
    # from `__all__` because it is a typing-only protocol in the `.pyi` surface.
    emit_tokens_push_sview(buffer, "    for (int elisa_struct_index = 0; elisa_pymodule_struct_names[elisa_struct_index] != NULL; ++elisa_struct_index) {\n        PyObject *elisa_struct_alias = elisa_pymodule_choose_struct_alias(module, elisa_pymodule_struct_names[elisa_struct_index], elisa_struct_index, elisa_pymodule_struct_readable[elisa_struct_index]);\n        if (elisa_struct_alias == NULL) { Py_DECREF(module); return NULL; }\n        const char *elisa_struct_alias_name = PyUnicode_AsUTF8(elisa_struct_alias);\n        if (elisa_struct_alias_name == NULL) { Py_DECREF(elisa_struct_alias); Py_DECREF(module); return NULL; }\n        PyObject *elisa_struct_type = elisa_pymodule_make_struct_type(elisa_struct_alias_name, elisa_pymodule_struct_fields[elisa_struct_index]);\n        if (elisa_struct_type == NULL) { Py_DECREF(elisa_struct_alias); Py_DECREF(module); return NULL; }\n        if (PyModule_AddObject(module, elisa_struct_alias_name, elisa_struct_type) < 0) { Py_DECREF(elisa_struct_type); Py_DECREF(elisa_struct_alias); Py_DECREF(module); return NULL; }\n        PyObject *elisa_struct_input = PyUnicode_FromFormat(\"%sInput\", elisa_struct_alias_name);\n        if (elisa_struct_input == NULL) { Py_DECREF(elisa_struct_alias); Py_DECREF(module); return NULL; }\n        const char *elisa_struct_input_name = PyUnicode_AsUTF8(elisa_struct_input);\n        if (elisa_struct_input_name == NULL) { Py_DECREF(elisa_struct_input); Py_DECREF(elisa_struct_alias); Py_DECREF(module); return NULL; }\n        Py_INCREF(elisa_struct_type);\n        if (PyModule_AddObject(module, elisa_struct_input_name, elisa_struct_type) < 0) { Py_DECREF(elisa_struct_type); Py_DECREF(elisa_struct_input); Py_DECREF(elisa_struct_alias); Py_DECREF(module); return NULL; }\n        PyObject *elisa_struct_all = PyObject_GetAttrString(module, \"__all__\");\n        if (elisa_struct_all == NULL || PyList_Append(elisa_struct_all, elisa_struct_alias) < 0) { Py_XDECREF(elisa_struct_all); Py_DECREF(elisa_struct_input); Py_DECREF(elisa_struct_alias); Py_DECREF(module); return NULL; }\n        Py_DECREF(elisa_struct_all);\n        Py_DECREF(elisa_struct_input);\n        Py_DECREF(elisa_struct_alias);\n    }\n")
    emit_pymodule_runtime_error_payload_types(buffer, file, error_families)
    # `typing.TypedDict` infers its `__module__` from the C call stack, which is
    # an importlib implementation detail for extension modules. Stamp the
    # generated factory with the actual extension name so repr/help/pickling
    # report `structs.Point` rather than an internal frozen-importlib module.
    struct_module_replacement: mutable darray[u8] = []
    emit_tokens_push_sview(&struct_module_replacement, "        if (elisa_struct_type == NULL) { Py_DECREF(elisa_struct_alias); Py_DECREF(module); return NULL; }\n        PyObject *elisa_struct_module_name = PyUnicode_FromString(PyModule_GetName(module)); if (elisa_struct_module_name == NULL || PyObject_SetAttrString(elisa_struct_type, \"__module__\", elisa_struct_module_name) < 0) { Py_XDECREF(elisa_struct_module_name); Py_DECREF(elisa_struct_type); Py_DECREF(elisa_struct_alias); Py_DECREF(module); return NULL; } Py_DECREF(elisa_struct_module_name);\n")
    pymodule_replace_generated(buffer, "        if (elisa_struct_type == NULL) { Py_DECREF(elisa_struct_alias); Py_DECREF(module); return NULL; }\n", sview(&struct_module_replacement[0], 0, struct_module_replacement.count))
    pymodule_replace_generated(buffer, "elisa_pymodule_make_struct_type(elisa_struct_alias_name, elisa_pymodule_struct_fields[elisa_struct_index])", "elisa_pymodule_make_struct_type_with_optional(elisa_struct_alias_name, elisa_pymodule_struct_fields[elisa_struct_index], elisa_pymodule_struct_optional_fields[elisa_struct_index])")
    pymodule_replace_generated(buffer, "PyObject *not_required = PyObject_GetAttrString(typing, \"NotRequired\");", "PyObject *not_required = PyObject_GetAttrString(typing, \"NotRequired\"); bool elisa_pymodule_not_required_fallback = false; if (not_required == NULL) { PyErr_Clear(); PyObject *typing_extensions = PyImport_ImportModule(\"typing_extensions\"); if (typing_extensions != NULL) { PyObject *extension_typed_dict = PyObject_GetAttrString(typing_extensions, \"TypedDict\"); not_required = PyObject_GetAttrString(typing_extensions, \"NotRequired\"); if (extension_typed_dict != NULL && not_required != NULL) { Py_XDECREF(typed_dict); typed_dict = extension_typed_dict; } else { Py_XDECREF(extension_typed_dict); Py_XDECREF(not_required); not_required = NULL; PyErr_Clear(); } Py_DECREF(typing_extensions); } else PyErr_Clear(); if (not_required == NULL) elisa_pymodule_not_required_fallback = true; }")
    pymodule_replace_generated(buffer, "if (typed_dict == NULL || any == NULL || not_required == NULL || fields == NULL)", "if (typed_dict == NULL || any == NULL || fields == NULL)")
    pymodule_replace_generated(buffer, "if (optional_fields != NULL && optional_fields[field_index]) field_type = PyObject_GetItem(not_required, any);", "if (optional_fields != NULL && optional_fields[field_index] && not_required != NULL) field_type = PyObject_GetItem(not_required, any);")
