    emit_tokens_push_sview(&module_doc_replacement, ".\",\n    -1,\n    elisa_methods")
    pymodule_replace_generated(buffer, "    NULL,\n    -1,\n    elisa_methods", sview(&module_doc_replacement[0], 0, module_doc_replacement.count))
    emit_tokens_push_sview(buffer, "    return module;\n}\n")
    return emit_tokens_flush(buffer)
