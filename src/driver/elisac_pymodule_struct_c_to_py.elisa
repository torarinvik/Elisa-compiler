# `-emit pymodule` — converting one struct field back from C to Python, the mirror of the
# py_to_c dispatch.


def pymodule_struct_field_c_to_py(buffer: mutable darray[u8]&, file: Ast::File&, field_type_name: sview, python_field_name: sview, field_name: sview, nested_dict_output_helper: sview = "", struct_type_name: sview = "") -> void can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(buffer, "    { PyObject *field_value = NULL; ")
    if pymodule_struct_return_supported(file, field_type_name):
        emit_tokens_push_sview(buffer, "field_value = elisa_pymodule_struct_")
        emit_tokens_push_sview(buffer, field_type_name)
        emit_tokens_push_sview(buffer, "_to_py(value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, "); ")
    elif pymodule_is_dict_type(field_type_name):
        emit_pymodule_struct_dict_field_c_to_py(buffer, field_type_name, field_name, python_field_name, nested_dict_output_helper)
    elif pymodule_is_set_type(field_type_name):
        emit_pymodule_struct_set_field_c_to_py(buffer, field_type_name, field_name, python_field_name)
    elif pymodule_is_view_type(field_type_name):
        # View returns use the same element-wise copy as darray returns, with the ABI's data/len
        # pair projected into the generated snippet before it is attached to the struct mapping.
        view_element_name: sview = pymodule_view_element_name(field_type_name)
        synthetic_type_storage: mutable darray[u8] = []
        emit_tokens_push_sview(&synthetic_type_storage, "darray[")
        emit_tokens_push_sview(&synthetic_type_storage, view_element_name)
        emit_tokens_push_sview(&synthetic_type_storage, "]")
        synthetic_type_name: sview = sview(&synthetic_type_storage[0], 0, synthetic_type_storage.count)
        view_snippet: mutable darray[u8] = []
        pymodule_struct_field_c_to_py(&view_snippet, file, synthetic_type_name, python_field_name, field_name, "", struct_type_name)
        pymodule_replace_generated(&view_snippet, ".count", ".len")
        pymodule_replace_generated(&view_snippet, ".items", ".data")
        # Keep the real struct field spelling intact. The synthetic darray conversion already
        # targets `value.<field>.count/items`; changing every `list` substring to `view` corrupts
        # legal fields named `list` and also makes the final insertion-removal needle miss.
        pymodule_replace_generated(&view_snippet, "    { PyObject *field_value = NULL; ", "")
        view_insert_storage: mutable darray[u8] = []
        emit_tokens_push_sview(&view_insert_storage, "if (field_value == NULL || PyDict_SetItemString(out, \"")
        emit_tokens_push_sview(&view_insert_storage, python_field_name)
        emit_tokens_push_sview(&view_insert_storage, "\", field_value) < 0) { Py_XDECREF(field_value); Py_DECREF(out); return NULL; } Py_DECREF(field_value); }\n")
        view_insert_needle: sview = sview(&view_insert_storage[0], 0, view_insert_storage.count)
        pymodule_replace_generated(&view_snippet, view_insert_needle, "")
        for view_byte_index in 0..<view_snippet.count |buffer, view_snippet|:
            buffer.push(view_snippet[view_byte_index])
    elif pymodule_is_darray_type(field_type_name):
        element_name: sview = pymodule_darray_element_name(field_type_name)
        if pymodule_is_dict_type(element_name):
            helper_storage: mutable darray[u8] = []
            helper_name: sview = pymodule_struct_darray_dict_helper_name(&helper_storage, struct_type_name, field_name, "to_py")
            emit_tokens_push_sview(buffer, "field_value = ")
            emit_tokens_push_sview(buffer, helper_name)
            emit_tokens_push_sview(buffer, "(value.")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, "); ")
            emit_tokens_push_sview(buffer, "if (field_value == NULL || PyDict_SetItemString(out, \"")
            emit_tokens_push_sview(buffer, python_field_name)
            emit_tokens_push_sview(buffer, "\", field_value) < 0) { Py_XDECREF(field_value); Py_DECREF(out); return NULL; } Py_DECREF(field_value); }\n")
            return
        if pymodule_is_set_type(element_name):
            helper_storage: mutable darray[u8] = []
            helper_name: sview = pymodule_struct_darray_set_helper_name(&helper_storage, struct_type_name, field_name, "to_py")
            emit_tokens_push_sview(buffer, "field_value = ")
            emit_tokens_push_sview(buffer, helper_name)
            emit_tokens_push_sview(buffer, "(value.")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, "); ")
            emit_tokens_push_sview(buffer, "if (field_value == NULL || PyDict_SetItemString(out, \"")
            emit_tokens_push_sview(buffer, python_field_name)
            emit_tokens_push_sview(buffer, "\", field_value) < 0) { Py_XDECREF(field_value); Py_DECREF(out); return NULL; } Py_DECREF(field_value); }\n")
            return
        elif pymodule_is_darray_type(element_name):
            helper_storage: mutable darray[u8] = []
            helper_name: sview = pymodule_struct_darray_nested_helper_name(&helper_storage, struct_type_name, field_name, "to_py")
            emit_tokens_push_sview(buffer, "field_value = ")
            emit_tokens_push_sview(buffer, helper_name)
            emit_tokens_push_sview(buffer, "(value.")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, "); ")
            emit_tokens_push_sview(buffer, "if (field_value == NULL || PyDict_SetItemString(out, \"")
            emit_tokens_push_sview(buffer, python_field_name)
            emit_tokens_push_sview(buffer, "\", field_value) < 0) { Py_XDECREF(field_value); Py_DECREF(out); return NULL; } Py_DECREF(field_value); }\n")
            return
        element_c_type: mutable sview = pymodule_darray_c_element_type(element_name)
        element_c_type <- element_name if element_c_type == "" and pymodule_struct_return_supported(file, element_name)
        emit_tokens_push_sview(buffer, "if (value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, ".count < 0 || value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, ".count > PY_SSIZE_T_MAX) { Py_DECREF(out); PyErr_SetString(PyExc_RuntimeError, \"native struct returned an invalid list length\"); return NULL; } ")
        if pymodule_darray_is_bytes(field_type_name):
            emit_tokens_push_sview(buffer, "if (value.")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ".count == 0) field_value = PyBytes_FromStringAndSize(\"\", 0); else { if (value.")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ".items == NULL) { Py_DECREF(out); PyErr_SetString(PyExc_RuntimeError, \"native struct returned null byte list storage\"); return NULL; } field_value = PyBytes_FromStringAndSize((const char *)value.")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ".items, (Py_ssize_t)value.")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ".count); } ")
        else:
            emit_tokens_push_sview(buffer, "if (value.")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ".count == 0) field_value = PyList_New(0); else { if (value.")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ".items == NULL) { Py_DECREF(out); PyErr_SetString(PyExc_RuntimeError, \"native struct returned null list storage\"); return NULL; } field_value = PyList_New((Py_ssize_t)value.")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ".count); if (field_value == NULL) { Py_DECREF(out); return NULL; } for (Py_ssize_t field_index = 0; field_index < (Py_ssize_t)value.")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ".count; ++field_index) { PyObject *field_item = NULL; ")
            if pymodule_struct_return_supported(file, element_name):
                emit_tokens_push_sview(buffer, "field_item = elisa_pymodule_struct_")
                emit_tokens_push_sview(buffer, element_name)
                emit_tokens_push_sview(buffer, "_to_py(((")
                emit_tokens_push_sview(buffer, element_c_type)
                emit_tokens_push_sview(buffer, " *)value.")
                emit_tokens_push_sview(buffer, field_name)
                emit_tokens_push_sview(buffer, ".items)[field_index]); ")
            elif element_name == "py::Object" or element_name == "py::Object?":
                emit_tokens_push_sview(buffer, "field_item = ((PyObject **)value.")
                emit_tokens_push_sview(buffer, field_name)
                emit_tokens_push_sview(buffer, ".items)[field_index]; if (field_item == NULL) { Py_INCREF(Py_None); field_item = Py_None; } else Py_INCREF(field_item); ")
            elif element_name == "cstr?":
                emit_tokens_push_sview(buffer, "const char *field_text = ((const char **)value.")
                emit_tokens_push_sview(buffer, field_name)
                emit_tokens_push_sview(buffer, ".items)[field_index]; if (field_text == NULL) { Py_INCREF(Py_None); field_item = Py_None; } else field_item = PyUnicode_FromString(field_text); ")
            elif element_name == "cstr":
                emit_tokens_push_sview(buffer, "const char *field_text = ((const char **)value.")
                emit_tokens_push_sview(buffer, field_name)
                emit_tokens_push_sview(buffer, ".items)[field_index]; if (field_text == NULL) { Py_DECREF(field_value); Py_DECREF(out); PyErr_SetString(PyExc_RuntimeError, \"native struct returned a null cstr list element\"); return NULL; } field_item = PyUnicode_FromString(field_text); ")
            elif element_name == "sview?":
                emit_tokens_push_sview(buffer, "ElisaOptionalSView field_optional_view = ((ElisaOptionalSView *)value.")
                emit_tokens_push_sview(buffer, field_name)
                emit_tokens_push_sview(buffer, ".items)[field_index]; if (!field_optional_view.has_value) { Py_INCREF(Py_None); field_item = Py_None; } else { if (field_optional_view.value.len < 0 || field_optional_view.value.len > PY_SSIZE_T_MAX || (field_optional_view.value.data == NULL && field_optional_view.value.len != 0)) { Py_DECREF(field_value); Py_DECREF(out); PyErr_SetString(PyExc_RuntimeError, \"native struct returned an invalid optional sview list element\"); return NULL; } if (field_optional_view.value.data == NULL) field_item = PyUnicode_FromString(\"\"); else field_item = PyUnicode_DecodeUTF8(field_optional_view.value.data, (Py_ssize_t)field_optional_view.value.len, \"strict\"); } ")
            elif element_name == "sview":
                emit_tokens_push_sview(buffer, "ElisaSView field_view = ((ElisaSView *)value.")
                emit_tokens_push_sview(buffer, field_name)
                emit_tokens_push_sview(buffer, ".items)[field_index]; if (field_view.len < 0 || field_view.len > PY_SSIZE_T_MAX || (field_view.data == NULL && field_view.len != 0)) { Py_DECREF(field_value); Py_DECREF(out); PyErr_SetString(PyExc_RuntimeError, \"native struct returned an invalid sview list element\"); return NULL; } if (field_view.data == NULL) field_item = PyUnicode_FromString(\"\"); else field_item = PyUnicode_DecodeUTF8(field_view.data, (Py_ssize_t)field_view.len, \"strict\"); ")
            elif pymodule_darray_element_is_optional_scalar(element_name):
                optional_c_type: sview = pymodule_darray_c_element_type(element_name)
                payload_name: sview = pymodule_optional_payload_name(element_name)
                emit_tokens_push_sview(buffer, optional_c_type)
                emit_tokens_push_sview(buffer, " field_optional = ((")
                emit_tokens_push_sview(buffer, optional_c_type)
                emit_tokens_push_sview(buffer, " *)value.")
                emit_tokens_push_sview(buffer, field_name)
                emit_tokens_push_sview(buffer, ".items)[field_index]; if (!field_optional.has_value) { Py_INCREF(Py_None); field_item = Py_None; } else {")
                if payload_name == "bool":
                    emit_tokens_push_sview(buffer, " field_item = PyBool_FromLong((long)field_optional.value); }")
                elif payload_name == "f32" or payload_name == "f64":
                    emit_tokens_push_sview(buffer, " field_item = PyFloat_FromDouble((double)field_optional.value); }")
                elif payload_name == "u8" or payload_name == "u16" or payload_name == "u32" or payload_name == "u64" or payload_name == "usize" or payload_name == "uintptr":
                    emit_tokens_push_sview(buffer, " field_item = PyLong_FromUnsignedLongLong((unsigned long long)field_optional.value); }")
                else:
                    emit_tokens_push_sview(buffer, " field_item = PyLong_FromLongLong((long long)field_optional.value); }")
            elif pymodule_darray_element_is_bool(element_name):
                emit_tokens_push_sview(buffer, "field_item = PyBool_FromLong((long)((")
                emit_tokens_push_sview(buffer, element_c_type)
                emit_tokens_push_sview(buffer, " *)value.")
                emit_tokens_push_sview(buffer, field_name)
                emit_tokens_push_sview(buffer, ".items)[field_index]); ")
            elif pymodule_darray_element_is_float(element_name):
                emit_tokens_push_sview(buffer, "field_item = PyFloat_FromDouble((double)((")
                emit_tokens_push_sview(buffer, element_c_type)
                emit_tokens_push_sview(buffer, " *)value.")
                emit_tokens_push_sview(buffer, field_name)
                emit_tokens_push_sview(buffer, ".items)[field_index]); ")
            elif pymodule_darray_element_is_unsigned(element_name):
                emit_tokens_push_sview(buffer, "field_item = PyLong_FromUnsignedLongLong((unsigned long long)((")
                emit_tokens_push_sview(buffer, element_c_type)
                emit_tokens_push_sview(buffer, " *)value.")
                emit_tokens_push_sview(buffer, field_name)
                emit_tokens_push_sview(buffer, ".items)[field_index]); ")
            else:
                emit_tokens_push_sview(buffer, "field_item = PyLong_FromLongLong((long long)((")
                emit_tokens_push_sview(buffer, element_c_type)
                emit_tokens_push_sview(buffer, " *)value.")
                emit_tokens_push_sview(buffer, field_name)
                emit_tokens_push_sview(buffer, ".items)[field_index]); ")
            emit_tokens_push_sview(buffer, "if (field_item == NULL) { Py_DECREF(field_value); Py_DECREF(out); return NULL; } PyList_SET_ITEM(field_value, field_index, field_item); } } ")
    elif field_type_name == "cstr?":
        emit_tokens_push_sview(buffer, "if (value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, " == NULL) { Py_INCREF(Py_None); field_value = Py_None; } else field_value = PyUnicode_FromString(value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, "); ")
    elif field_type_name == "py::Object?":
        emit_tokens_push_sview(buffer, "if (value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, " == NULL) { Py_INCREF(Py_None); field_value = Py_None; } else { Py_INCREF(value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, "); field_value = value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, "; } ")
    elif field_type_name == "sview?":
        emit_tokens_push_sview(buffer, "if (!value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, ".has_value) { Py_INCREF(Py_None); field_value = Py_None; } else { if (value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, ".value.len < 0 || (value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, ".value.data == NULL && value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, ".value.len != 0)) { Py_DECREF(out); PyErr_SetString(PyExc_RuntimeError, \"native optional struct sview field is invalid\"); return NULL; } if (value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, ".value.data == NULL) field_value = PyUnicode_FromString(\"\"); else field_value = PyUnicode_DecodeUTF8(value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, ".value.data, (Py_ssize_t)value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, ".value.len, \"strict\"); } ")
    elif pymodule_is_optional_scalar_type(field_type_name):
        payload_name: sview = pymodule_optional_payload_name(field_type_name)
        emit_tokens_push_sview(buffer, "if (!value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, ".has_value) { Py_INCREF(Py_None); field_value = Py_None; } else ")
        if payload_name == "bool":
            emit_tokens_push_sview(buffer, "field_value = PyBool_FromLong((long)value.")
        elif payload_name == "f32" or payload_name == "f64":
            emit_tokens_push_sview(buffer, "field_value = PyFloat_FromDouble((double)value.")
        elif payload_name == "u8" or payload_name == "u16" or payload_name == "u32" or payload_name == "u64" or payload_name == "usize":
            emit_tokens_push_sview(buffer, "field_value = PyLong_FromUnsignedLongLong((unsigned long long)value.")
        else:
            emit_tokens_push_sview(buffer, "field_value = PyLong_FromLongLong((long long)value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, ".value); ")
    elif field_type_name == "cstr":
        emit_tokens_push_sview(buffer, "if (value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(out); PyErr_SetString(PyExc_RuntimeError, \"native struct returned a null cstr field\"); return NULL; } field_value = PyUnicode_FromString(value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, "); ")
    elif field_type_name == "sview":
        emit_tokens_push_sview(buffer, "if (value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, ".len < 0 || value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, ".len > PY_SSIZE_T_MAX || (value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, ".data == NULL && value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, ".len != 0)) { Py_DECREF(out); PyErr_SetString(PyExc_RuntimeError, \"native struct returned an invalid sview field\"); return NULL; } if (value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, ".data == NULL) field_value = PyUnicode_FromString(\"\"); else field_value = PyUnicode_DecodeUTF8(value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, ".data, (Py_ssize_t)value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, ".len, \"strict\"); ")
    elif field_type_name == "py::Object":
        emit_tokens_push_sview(buffer, "if (value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, " == NULL) { Py_INCREF(Py_None); field_value = Py_None; } else { Py_INCREF(value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, "); field_value = value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, "; } ")
    elif field_type_name == "bool":
        emit_tokens_push_sview(buffer, "field_value = PyBool_FromLong((long)value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, "); ")
    elif field_type_name == "f32" or field_type_name == "f64":
        emit_tokens_push_sview(buffer, "field_value = PyFloat_FromDouble((double)value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, "); ")
    elif field_type_name == "u8" or field_type_name == "u16" or field_type_name == "u32" or field_type_name == "u64" or field_type_name == "usize" or field_type_name == "uintptr":
        emit_tokens_push_sview(buffer, "field_value = PyLong_FromUnsignedLongLong((unsigned long long)value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, "); ")
    else:
        emit_tokens_push_sview(buffer, "field_value = PyLong_FromLongLong((long long)value.")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, "); ")
    emit_tokens_push_sview(buffer, "if (field_value == NULL || PyDict_SetItemString(out, \"")
    emit_tokens_push_sview(buffer, python_field_name)
    emit_tokens_push_sview(buffer, "\", field_value) < 0) { Py_XDECREF(field_value); Py_DECREF(out); return NULL; } Py_DECREF(field_value); }\n")
