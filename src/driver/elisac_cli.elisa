# Driver — the COMMAND LINE. `elisac-stage1 [-emit MODE] [-o OUT] [-O0|-O1|-O2|-O3] SOURCE` is
# parsed into the SAME request the ELISA_STAGE1_* environment protocol builds, so the wrapper
# and the real CLI reach one code path rather than two.


# Shared reader for the ELISA_STAGE1_* string variables. Appends to `storage` and reports
# whether anything was found.
def env_value(name: sview, storage: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag_storage: mutable darray[u8] = []
    for flag_index in 0..<name.len |flag_storage, name|:
        flag_storage.push(name[flag_index])
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is value_bytes:
        cursor: mutable i64 = 0
        keep_scanning: mutable bool = true
        while keep_scanning |cursor, keep_scanning, storage, value_bytes|:
            byte_ref: u8& = value_bytes + cursor
            value_byte: u8 = byte_ref
            if value_byte == 0:
                keep_scanning <- false
            else:
                storage.push(value_byte)
                cursor <- cursor + 1
    return storage.count > 0




# A `-emit ir` refusal names the construct the writer will not guess at. Kept separate from
# `report_diagnostic`: this is not a finding about the PROGRAM, it is the writer declining.
def report_ir_refusal(construct: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Console, Unsafe.PointerCast]:
    can Console:
        line_buffer: mutable darray[u8] = []
        line_buffer.extend("error: -emit ir cannot represent this construct yet: ")
        line_buffer.extend(bytes_view_range_ref(construct, 0, construct.count))
        line_buffer.push(10)
        write_stderr(line_buffer)




# The modes whose report IS stdout. stage0 rejects `-o` for each of them.
def cli_emit_mode_refuses_output() -> bool can[Abort.Panic, Unsafe.PointerCast]:
    return emit_mode_is("tests") or emit_mode_is("benches") or emit_mode_is("fixtures") or emit_mode_is("test")




def cli_emit_mode_supported(mode: cstr) -> bool can[Abort.Panic]:
    return when sview(mode, 0, -1):
        "obj" | "llvm" | "bc" | "wasm" | "tokens" | "ast" | "iface" | "fmt" | "deps" | "deps-json" | "doc" | "header" | "pymodule" | "pymodule-c" | "pymodule-pyi" | "pymodule-so" | "test-runner" | "tests" | "benches" | "fixtures" | "test" | "c-bind-check" | "c-bind-check-json" | "packed" | "unsafe" | "c-archive" | "lowered" | "progress" | "ir" | "edir" | "interpret" | "exe" | "check" -> true
        _ -> false


# The compiler-facing PGO file is deliberately smaller than the profiler's report format. The
# profiler converts a validated capture to this contract before invoking the compiler:
#
#     ELISA_PGO_V1
#     hot <qualified-function-name>
#
# Names are source-level identifiers, so generic specializations remain portable across LLVM
# mangling. Reject every unknown record and every empty function name; a truncated or mixed
# artifact must never silently alter optimization choices.
def profile_file_to_hot_functions(path: cstr, output: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    source: darray[u8] = read_file(path)
    return false if source.count == 0
    line_start: mutable usize = 0.usize()
    line_number: mutable usize = 0.usize()
    while line_start <= source.count |line_start, line_number, source, output|:
        line_stop: mutable usize = line_start
        while line_stop < source.count and source[line_stop] != 10 |line_stop, source|:
            line_stop <- line_stop + 1.usize()
        content_start: mutable usize = line_start
        while content_start < line_stop and (source[content_start] == 32 or source[content_start] == 9) |content_start, source|:
            content_start <- content_start + 1.usize()
        content_stop: mutable usize = line_stop
        while content_stop > content_start and (source[content_stop - 1.usize()] == 32 or source[content_stop - 1.usize()] == 9 or source[content_stop - 1.usize()] == 13) |content_stop, source|:
            content_stop <- content_stop - 1.usize()
        if line_number == 0.usize():
            return false if content_stop - content_start != ("ELISA_PGO_V1").len
            for header_index in 0..<("ELISA_PGO_V1").len |header_index, source, content_start|:
                return false if source[content_start + header_index] != ("ELISA_PGO_V1")[header_index]
        elif content_start < content_stop:
            return false if:
                content_stop - content_start < 5.usize()
                source[content_start] != 104 or source[content_start + 1.usize()] != 111 or source[content_start + 2.usize()] != 116
                source[content_start + 3.usize()] != 32 and source[content_start + 3.usize()] != 9
            name_start: mutable usize = content_start + 4.usize()
            while name_start < content_stop and (source[name_start] == 32 or source[name_start] == 9) |name_start, source|:
                name_start <- name_start + 1.usize()
            return false if name_start == content_stop
            for name_index in name_start..<content_stop |name_index, source|:
                return false if source[name_index] == 32 or source[name_index] == 9
            output.push(10) if output.count > 0.usize()
            for name_index in name_start..<content_stop |output, source|:
                output.push(source[name_index])
        break if line_stop == source.count
        line_start <- line_stop + 1.usize()
        line_number <- line_number + 1.usize()
    return true



const enum CliArgumentKind of u8:
    Output
    Filter
    Emit
    Link
    TargetTriple
    Opt0
    Opt1
    Opt2
    Opt3
    WasmOnly
    ComponentType
    WasmLd
    WasmComponentLd
    Python
    PythonConfig
    NoAlias
    BoundsCheck
    OverflowTrap
    OverflowWrap
    DebugInfo
    TraceInfo
    TraceFunctions
    ProfileUse
    KeepFramePointer
    DefaultFramePointer
    Ignored
    SizeOpt
    StrictExterns
    LtoFull
    LtoThin
    NoLto
    TargetCpu
    Permissive
    NeverLeakWarn
    NeverLeakError
    WarningGroup
    Unknown



# `-mcpu=NAME`: the value starts at byte 6.
def cli_argument_has_mcpu_prefix(argument: cstr) -> bool can[Abort.Panic]:
    prefix: sview = "-mcpu="
    for prefix_index in 0..<prefix.len |argument, prefix|:
        return false if argument[prefix_index] != prefix[prefix_index]
    return true



def cli_argument_kind(argument: cstr) -> CliArgumentKind:
    return when sview(argument, 0, -1):
        "-o" -> CliArgumentKind.Output
        "-filter" -> CliArgumentKind.Filter
        "-emit" -> CliArgumentKind.Emit
        "-link" | "-L" | "-l" -> CliArgumentKind.Link
        "-target-triple" -> CliArgumentKind.TargetTriple
        "-O0" -> CliArgumentKind.Opt0
        "-O1" -> CliArgumentKind.Opt1
        "-O2" -> CliArgumentKind.Opt2
        "-O3" -> CliArgumentKind.Opt3
        "--wasm-only" -> CliArgumentKind.WasmOnly
        "--component-type" | "--wit" -> CliArgumentKind.ComponentType
        "--wasm-ld" -> CliArgumentKind.WasmLd
        "--wasm-component-ld" -> CliArgumentKind.WasmComponentLd
        # Everything below reached the driver through the host wrapper's environment until
        # §4.6; the driver accepts it directly now, so the wrapper has nothing left to parse.
        "--python" -> CliArgumentKind.Python
        "--python-config" -> CliArgumentKind.PythonConfig
        "-fnoalias" -> CliArgumentKind.NoAlias
        "-fbounds-check" -> CliArgumentKind.BoundsCheck
        "-foverflow=trap" -> CliArgumentKind.OverflowTrap
        "-foverflow=wrap" -> CliArgumentKind.OverflowWrap
        "-g" | "-debug-info" -> CliArgumentKind.DebugInfo
        "-ftrace" | "-record-trace" -> CliArgumentKind.TraceInfo
        "-ftrace-functions" -> CliArgumentKind.TraceFunctions
        "-fprofile-use" -> CliArgumentKind.ProfileUse
        "-fno-omit-frame-pointer" -> CliArgumentKind.KeepFramePointer
        "-fomit-frame-pointer" -> CliArgumentKind.DefaultFramePointer
        # `-O0` is the default. `-permissive` bypasses mutable-global grant checks and
        # turns off opt-in stage1 lints such as -Wnever-leak.
        "-permissive" -> CliArgumentKind.Permissive
        # The opt-in never-leak lint (src/semantic/check_never_leak.elisa): `-Wnever-leak` or
        # `-W never-leak` warns, `-Werror=never-leak` makes each finding an error, and a
        # `=gentle` (the default) or `=strict` suffix picks the rule (never_leak_cli_flag).
        "-Wnever-leak" | "-Wnever-leak=gentle" | "-Wnever-leak=strict" -> CliArgumentKind.NeverLeakWarn
        "-Werror=never-leak" | "-Werror=never-leak=gentle" | "-Werror=never-leak=strict" -> CliArgumentKind.NeverLeakError
        "-W" -> CliArgumentKind.WarningGroup
        # stage0 has no size-optimisation parity, so there is nothing to hold `-Os`/`-Oz` to.
        "-Os" | "-Oz" -> CliArgumentKind.SizeOpt
        "-strict-externs" -> CliArgumentKind.StrictExterns
        # Link-time optimization (stage0 parity): `-flto` = `-flto=full`; `-flto=thin`;
        # `-fno-lto` turns it back off. Any other `-flto=` spelling is an unknown flag.
        "-flto" | "-flto=full" -> CliArgumentKind.LtoFull
        "-flto=thin" -> CliArgumentKind.LtoThin
        "-fno-lto" -> CliArgumentKind.NoLto
        # `-mcpu NAME`; the `-mcpu=NAME` spelling is recognised in the Unknown arm.
        "-mcpu" -> CliArgumentKind.TargetCpu
        _ -> CliArgumentKind.Unknown




# Parse `elisac-stage1 [-emit MODE] [-o OUT] [-O0|-O1|-O2|-O3] SOURCE` and build the SAME
# buffer the stdin wire protocol produces: output path, newline, source bytes, NUL. Every
# downstream stage is therefore untouched by the CLI existing — the two front doors meet
# immediately and share one compile path.
#
# Unknown `-flags` are IGNORED rather than rejected: the host wrapper passes through
# linker/target options this driver does not implement yet, and failing on them would make
# the CLI less usable than the wrapper it replaces.
def cli_request(argc: i64, argv: mutable void&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast]:
    identity: mutable SourceIdentity::Capture = SourceIdentity::Capture{enabled: false, valid: false, complete: false, root: SourceIdentity::NONE, bytes: [], paths: [], edges: []} can Memory.Allocate
    return cli_request_with_source_identity(argc, argv, &identity) can Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast

def cli_request_with_source_identity(argc: i64, argv: mutable void&, identity: mutable SourceIdentity::Capture&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast]:
    attribution: mutable SourceIdentity::Attribution = SourceIdentity::Attribution{enabled: false, valid: false, bytes: [], entries: []} can Memory.Allocate
    return cli_request_capture(argc, argv, identity, &attribution) can Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast

def cli_request_with_source_context(argc: i64, argv: mutable void&, context: mutable SourceIdentity::InvocationContext&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast]:
    return cli_request_capture(argc, argv, &context.identity, &context.attribution) can Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast

def cli_request_capture(argc: i64, argv: mutable void&, identity: mutable SourceIdentity::Capture&, attribution: mutable SourceIdentity::Attribution&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast]:
    base_component_types: mutable darray[u8] = []
    return cli_request_capture_from(argc, argv, 1, false, base_component_types, false, identity, attribution) can Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast

def cli_request_with_source_context_from(argc: i64, argv: mutable void&, first_argument_index: i64, base_component_types: darray[u8]&, baseline_smt_enabled: bool, context: mutable SourceIdentity::InvocationContext&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast]:
    return cli_request_capture_from(argc, argv, first_argument_index, true, base_component_types, baseline_smt_enabled, &context.identity, &context.attribution) can Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast

include "./elisac_cli_capture.elisa"
