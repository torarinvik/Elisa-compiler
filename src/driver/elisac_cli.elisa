# Driver — the COMMAND LINE. `elisac-stage1 [-emit MODE] [-o OUT] [-O0|-O1|-O2|-O3] SOURCE` is
# parsed into the SAME request the ELISA_STAGE1_* environment protocol builds, so the wrapper
# and the real CLI reach one code path rather than two.


# Shared reader for the ELISA_STAGE1_* string variables. Appends to `storage` and reports
# whether anything was found.
def env_value(name: sview, storage: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag_storage: mutable darray[u8] = []
    for flag_index in 0..<sview_len(name) |flag_storage, name|:
        flag_storage.push(sview_at(name, flag_index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is value_bytes:
        cursor: mutable i64 = 0
        keep_scanning: mutable bool = true
        while keep_scanning |cursor, keep_scanning, storage, value_bytes|:
            byte_ref: u8& = value_bytes + cursor
            value_byte: u8 = byte_ref
            if value_byte == 0:
                keep_scanning <- false
            else:
                storage.push(value_byte)
                cursor <- cursor + 1
    return storage.count > 0




# A `-emit ir` refusal names the construct the writer will not guess at. Kept separate from
# `report_diagnostic`: this is not a finding about the PROGRAM, it is the writer declining.
def report_ir_refusal(construct: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Console, Unsafe.PointerCast]:
    can Console:
        line_buffer: mutable darray[u8] = []
        line_buffer.extend("error: -emit ir cannot represent this construct yet: ")
        line_buffer.extend(sview(&construct[0], 0, construct.count.i64()))
        line_buffer.push(10)
        write_stderr(line_buffer)




def cli_emit_mode_supported(mode: cstr) -> bool can[Abort.Panic]:
    return when sview(mode, 0, -1):
        "obj" | "llvm" | "bc" | "tokens" | "ast" | "iface" | "fmt" | "deps" | "deps-json" | "doc" | "header" | "pymodule" | "pymodule-c" | "pymodule-pyi" | "pymodule-so" | "test-runner" | "tests" | "benches" | "fixtures" | "test" | "c-bind-check" | "c-bind-check-json" | "packed" | "unsafe" | "c-archive" | "lowered" | "progress" | "ir" | "interpret" | "exe" -> true
        _ -> false



const enum CliArgumentKind of u8:
    Output
    Filter
    Emit
    Link
    TargetTriple
    Opt0
    Opt1
    Opt2
    Opt3
    WasmOnly
    ComponentType
    WasmLd
    WasmComponentLd
    Unknown



def cli_argument_kind(argument: cstr) -> CliArgumentKind:
    return when sview(argument, 0, -1):
        "-o" -> CliArgumentKind.Output
        "-filter" -> CliArgumentKind.Filter
        "-emit" -> CliArgumentKind.Emit
        "-link" | "-L" | "-l" -> CliArgumentKind.Link
        "-target-triple" -> CliArgumentKind.TargetTriple
        "-O0" -> CliArgumentKind.Opt0
        "-O1" -> CliArgumentKind.Opt1
        "-O2" -> CliArgumentKind.Opt2
        "-O3" -> CliArgumentKind.Opt3
        "--wasm-only" -> CliArgumentKind.WasmOnly
        "--component-type" -> CliArgumentKind.ComponentType
        "--wasm-ld" -> CliArgumentKind.WasmLd
        "--wasm-component-ld" -> CliArgumentKind.WasmComponentLd
        _ -> CliArgumentKind.Unknown




# Parse `elisac-stage1 [-emit MODE] [-o OUT] [-O0|-O1|-O2|-O3] SOURCE` and build the SAME
# buffer the stdin wire protocol produces: output path, newline, source bytes, NUL. Every
# downstream stage is therefore untouched by the CLI existing — the two front doors meet
# immediately and share one compile path.
#
# Unknown `-flags` are IGNORED rather than rejected: the host wrapper passes through
# linker/target options this driver does not implement yet, and failing on them would make
# the CLI less usable than the wrapper it replaces.
def cli_request(argc: i64, argv: mutable void&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    request: mutable darray[u8] = []
    slots: mutable cstr&& = argv.cast[mutable cstr&&]
    output_path: mutable darray[u8] = []
    link_flags: mutable darray[u8] = []
    source_index: mutable i64 = 0
    index: mutable i64 = 1
    while index < argc |index, slots, output_path, source_index|:
        argument: cstr = slots[index].cast[cstr]
        match cli_argument_kind(argument):
            CliArgumentKind.Output:
                if index + 1 < argc:
                    index <- index + 1
                    push_cstr(&output_path, slots[index].cast[cstr])
                    _ = setenv("ELISA_STAGE1_OUT", slots[index].cast[cstr], 1)
            CliArgumentKind.Filter:
                # Only `-emit test-runner` consumes it today; stage0 rejects it for any mode
                # that cannot use it, which is checked below once the mode is known.
                if index + 1 < argc:
                    index <- index + 1
                    _ = setenv("ELISA_STAGE1_FILTER", slots[index].cast[cstr], 1)
            CliArgumentKind.Emit:
                if index + 1 < argc:
                    index <- index + 1
                    requested_mode: cstr = slots[index].cast[cstr]
                    # REJECT an unsupported mode instead of ignoring it. Ignoring meant `-emit
                    # lowered` silently produced a Mach-O OBJECT at the path the caller expected a
                    # text dump at — a wrong answer that looks like success, and it made every
                    # unimplemented mode read as "supported" when probed by exit code. stage0
                    # rejects unknown modes; so does this.
                    if not cli_emit_mode_supported(requested_mode):
                        message: mutable darray[u8] = []
                        for prefix_index in 0..<sview_len("unsupported -emit mode: ") |message|:
                            message.push(sview_at("unsupported -emit mode: ", prefix_index))
                        push_cstr(&message, requested_mode)
                        for suffix_index in 0..<sview_len("\nsupported: obj llvm bc tokens ast iface fmt doc header test-runner tests benches fixtures test c-bind-check c-bind-check-json packed unsafe c-archive lowered progress interpret deps deps-json\n") |message|:
                            message.push(sview_at("\nsupported: obj llvm bc tokens ast iface fmt doc header test-runner tests benches fixtures test c-bind-check c-bind-check-json packed unsafe c-archive lowered progress interpret deps deps-json\n", suffix_index))
                        write_stderr(message)
                        return request
                    _ = setenv("ELISA_STAGE1_EMIT", requested_mode, 1)
            CliArgumentKind.Link:
                # Linker passthrough. Accumulated into ELISA_STAGE1_LINK as a space-separated
                # string; `-L`/`-l` keep their prefix so the flag reaches clang as written.
                if index + 1 < argc:
                    link_prefix: sview = when sview(argument, 0, -1):
                        "-link" -> ""
                        "-L" -> "-L"
                        _ -> "-l"
                    index <- index + 1
                    link_flags.push(32) if link_flags.count > 0
                    for prefix_index in 0..<sview_len(link_prefix) |link_flags, link_prefix|:
                        link_flags.push(sview_at(link_prefix, prefix_index))
                    push_cstr(&link_flags, slots[index].cast[cstr])
            CliArgumentKind.TargetTriple:
                # CROSS-COMPILATION. The backend already accepted a requested triple
                # (configure_module_target_for) and initializes the AArch64/ARM/x86/RISCV/wasm
                # target families; nothing ever passed one, so stage1 could only ever emit for
                # the host.
                if index + 1 < argc:
                    index <- index + 1
                    _ = setenv("ELISA_STAGE1_TRIPLE", slots[index].cast[cstr], 1)
                    if slots[index].cast[cstr][0] == 119:
                        _ = setenv("ELISA_STAGE1_WASM", "1", 1)
            # `-emit wasm` packaging options (§4.4) travel by environment like every other
            # option: --component-type may repeat, so its paths join with `;`.
            CliArgumentKind.WasmOnly:
                _ = setenv("ELISA_STAGE1_WASM_ONLY", "1", 1)
            CliArgumentKind.ComponentType:
                if index + 1 < argc:
                    index <- index + 1
                    joined: mutable darray[u8] = []
                    _ = env_value("ELISA_STAGE1_WASM_COMPONENT_TYPES", &joined)
                    joined.push(59) if joined.count > 0
                    given_type: mutable darray[u8] = []
                    push_cstr(&given_type, slots[index].cast[cstr])
                    absolute_type: darray[u8] = ProjectSystem::absolute_path(given_type)
                    for byte_index in 0..<absolute_type.count |joined, absolute_type|:
                        joined.push(absolute_type[byte_index])
                    joined.push(0)
                    joined_cstr: cstr = (&joined[0]).cast[cstr] can Unsafe.PointerCast
                    _ = setenv("ELISA_STAGE1_WASM_COMPONENT_TYPES", joined_cstr, 1)
            CliArgumentKind.WasmLd:
                if index + 1 < argc:
                    index <- index + 1
                    _ = setenv("ELISA_STAGE1_WASM_LD", slots[index].cast[cstr], 1)
            CliArgumentKind.WasmComponentLd:
                if index + 1 < argc:
                    index <- index + 1
                    _ = setenv("ELISA_STAGE1_WASM_COMPONENT_LD", slots[index].cast[cstr], 1)
            CliArgumentKind.Opt0:
                _ = setenv("ELISA_STAGE1_OPT", "0", 1)
            CliArgumentKind.Opt1:
                _ = setenv("ELISA_STAGE1_OPT", "1", 1)
            CliArgumentKind.Opt2:
                _ = setenv("ELISA_STAGE1_OPT", "2", 1)
            CliArgumentKind.Opt3:
                _ = setenv("ELISA_STAGE1_OPT", "3", 1)
            CliArgumentKind.Unknown:
                if argument[0] != 45:
                    source_index <- index
                    # Diagnostics name the file. The wrapper already set this for its own callers;
                    # the CLI must set it too or a CLI-compiled program reports a bare line number.
                    _ = setenv("ELISA_STAGE1_SRC", argument, 1)
        index <- index + 1
    if link_flags.count > 0:
        link_flags.push(0)
        link_flags_c: cstr = (&link_flags[0]).cast[cstr] can Unsafe.PointerCast
        _ = setenv("ELISA_STAGE1_LINK", link_flags_c, 1)
    request return if source_index == 0
    source_path: cstr = slots[source_index].cast[cstr]
    # The driver's own path: `-emit wasm` re-invokes it for the runtime object and derives
    # the repository root from it (bin/..).
    _ = setenv("ELISA_STAGE1_SELF", slots[0].cast[cstr], 0)
    if emit_mode_is("wasm"):
        # wasm32 unless a triple was given; ELISA_TARGET_OS_WASM must be known BEFORE parsing.
        triple_probe: mutable darray[u8] = []
        if not env_value("ELISA_STAGE1_TRIPLE", &triple_probe):
            _ = setenv("ELISA_STAGE1_TRIPLE", "wasm32-unknown-unknown", 1)
        _ = setenv("ELISA_STAGE1_WASM", "1", 1)
        # The output is `<source stem>.wasm`, or `-o` with `.wasm` appended when it lacks it.
        if output_path.count == 0:
            push_cstr(&output_path, source_path)
            dot: mutable usize = 0.usize()
            for probe_index in 0..<output_path.count |dot, output_path|:
                dot <- probe_index if output_path[probe_index] == 46
                dot <- 0.usize() if output_path[probe_index] == 47
            output_path.resize(dot) if dot > 0
            emit_tokens_push_sview(&output_path, ".wasm")
        elif not (output_path.count > 5 and output_path[output_path.count - 1] == 109 and output_path[output_path.count - 2] == 115 and output_path[output_path.count - 3] == 97 and output_path[output_path.count - 4] == 119 and output_path[output_path.count - 5] == 46):
            emit_tokens_push_sview(&output_path, ".wasm")
    if emit_mode_is("pymodule-so") or emit_mode_is("pymodule-pyi"):
        # Neither mode can express its default output as a path: `-emit pymodule-so` does not
        # know the FINAL extension filename until the module name and the target
        # interpreter's suffix are both in hand, and `-emit pymodule-pyi` names its stub
        # after the module. So the caller's `-o` — which may be absent — travels separately,
        # and the compile takes the ordinary default destination below.
        # Only when `-o` was actually given: the wrapper passes the caller's path through the
        # SAME variable and no `-o` of its own, so overwriting it with an empty string here
        # threw the destination away and wrote the extension into the working directory.
        if output_path.count > 0:
            requested: mutable darray[u8] = [entry for entry in output_path]
            requested.push(0)
            requested_cstr: cstr = (&requested[0]).cast[cstr] can Unsafe.PointerCast
            _ = setenv("ELISA_STAGE1_PYMODULE_OUT", requested_cstr, 1)
        output_path.resize(0.usize())
    # Default output mirrors stage0's: the source path with the emit-appropriate suffix is
    # the WRAPPER's business, so with no -o the compile still needs a destination; use the
    # source path plus ".o" rather than inventing a name the caller cannot predict.
    if output_path.count == 0:
        push_cstr(&output_path, source_path)
        output_path.push(46)
        output_path.push(111)
    # Expand includes HERE, natively, rather than requiring the caller to pre-flatten.
    # Falls back to the raw file when expansion finds nothing to do, so a single-file
    # program takes the same path it always did.
    source_path_bytes: mutable darray[u8] = []
    push_cstr(&source_path_bytes, source_path)
    source_path_bytes_c: mutable darray[u8] = [entry for entry in source_path_bytes]
    source_path_bytes_c.push(0)
    included_seen: mutable darray[u8] = []
    expanded_source: mutable darray[u8] = []
    include_line_map: mutable darray[u8] = []
    include_emitted_lines: mutable u32 = 0
    contents: mutable darray[u8] = expanded_source if expand_includes(source_path_bytes, &expanded_source, &included_seen, 0, &include_line_map, &include_emitted_lines) else read_file(source_path)
    # Publish the map so every printer — and source_original_line in the lexer — can name the
    # ORIGINAL file and line. Via the environment: stage1's backend has scalar globals only.
    setenv_bytes("ELISA_STAGE1_LINE_MAP", include_line_map) if include_line_map.count > 0.usize()
    # The wrapper set this only when IT flattened; a driver-expanded unit publishes its own.
    # `# smt` belongs to the ORIGINAL file's header. A program whose first line is
    # `include "…/elisacore_runtime.elisa"` (every withstd acceptance probe) puts its own
    # header after eleven thousand lines of std in the expanded buffer, where the gate's
    # 8-line scan cannot see it. The wrapper used to grep the original file and export this
    # bit; now that the driver expands, it reads the root's own head here. Measured: without
    # it `contract_ensure_result_void.neg` (stage0 rejects) was ACCEPTED through the CLI door.
    root_raw: darray[u8] = read_file((&source_path_bytes_c[0]).cast[cstr] can Unsafe.PointerCast)
    if root_raw.count > 0.usize():
        if source_has_smt_header(&root_raw[0], root_raw.count):
            _ = setenv("ELISA_STAGE1_SMT", "1", 1)
    request return if contents.count == 0
    for path_index in 0..<output_path.count |request, output_path|:
        request.push(output_path[path_index])
    request.push(10)
    for content_index in 0..<contents.count |request, contents|:
        request.push(contents[content_index])
    request.push(0)
    return request




def read_all() -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    buf: mutable darray[u8] = []
    chunk: mutable darray[u8] = []
    chunk.resize(8192)
    while true |buf, chunk|:
        n: i64 = read(0, &chunk[0], 8192)
        break if n <= 0
        for index in 0..<n.usize() |buf, chunk|:
            buf.push(chunk[index])
    buf.push(0)
    return buf
