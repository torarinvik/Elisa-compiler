    emit_tokens_push_sview(storage, "_")
    emit_tokens_push_sview(storage, pymodule_struct_c_field_name(field_name))
    emit_tokens_push_sview(storage, "_darray_set_")
    emit_tokens_push_sview(storage, suffix)
    return sview(&storage[0], 0, storage.count)




