def pymodule_struct_darray_dict_helper_name(storage: mutable darray[u8]&, struct_type_name: sview, field_name: sview, suffix: sview) -> sview can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(storage, "elisa_pymodule_struct_")
    emit_tokens_push_sview(storage, struct_type_name)
    emit_tokens_push_sview(storage, "_")
    emit_tokens_push_sview(storage, pymodule_struct_c_field_name(field_name))
    emit_tokens_push_sview(storage, "_darray_dict_")
    emit_tokens_push_sview(storage, suffix)
    return bytes_view_range_ref(storage, 0, storage.count)
