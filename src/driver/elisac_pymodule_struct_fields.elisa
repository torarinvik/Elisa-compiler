# `-emit pymodule` — a struct's C FIELD names, the per-shape helper names its fields need, and
# the field default values the generated module carries.


def pymodule_c_type_name_for(file: Ast::File&, type_name: sview) -> sview can[Abort.Panic, Memory.Allocate]:
    builtin: sview = pymodule_c_type_name(type_name)
    return builtin if builtin != "" else type_name if pymodule_struct_supported(file, type_name) else ""




def pymodule_struct_c_field_name(field_name: sview) -> sview can[Abort.Panic]:
    # Keep the Python-facing key untouched while avoiding C keywords/macros in the generated
    # mirror typedef. Elisa permits these words as member names, and a generated extension should
    # not fail later with an opaque clang syntax error.
    "elisa_pymodule_field_auto" return if field_name == "auto"
    "elisa_pymodule_field_break" return if field_name == "break"
    "elisa_pymodule_field_case" return if field_name == "case"
    "elisa_pymodule_field_char" return if field_name == "char"
    "elisa_pymodule_field_const" return if field_name == "const"
    "elisa_pymodule_field_continue" return if field_name == "continue"
    "elisa_pymodule_field_default" return if field_name == "default"
    "elisa_pymodule_field_do" return if field_name == "do"
    "elisa_pymodule_field_double" return if field_name == "double"
    "elisa_pymodule_field_else" return if field_name == "else"
    "elisa_pymodule_field_enum" return if field_name == "enum"
    "elisa_pymodule_field_extern" return if field_name == "extern"
    "elisa_pymodule_field_float" return if field_name == "float"
    "elisa_pymodule_field_for" return if field_name == "for"
    "elisa_pymodule_field_goto" return if field_name == "goto"
    "elisa_pymodule_field_if" return if field_name == "if"
    "elisa_pymodule_field_inline" return if field_name == "inline"
    "elisa_pymodule_field_int" return if field_name == "int"
    "elisa_pymodule_field_long" return if field_name == "long"
    "elisa_pymodule_field_register" return if field_name == "register"
    "elisa_pymodule_field_restrict" return if field_name == "restrict"
    "elisa_pymodule_field_return" return if field_name == "return"
    "elisa_pymodule_field_short" return if field_name == "short"
    "elisa_pymodule_field_signed" return if field_name == "signed"
    "elisa_pymodule_field_sizeof" return if field_name == "sizeof"
    "elisa_pymodule_field_static" return if field_name == "static"
    "elisa_pymodule_field_struct" return if field_name == "struct"
    "elisa_pymodule_field_switch" return if field_name == "switch"
    "elisa_pymodule_field_typedef" return if field_name == "typedef"
    "elisa_pymodule_field_union" return if field_name == "union"
    "elisa_pymodule_field_unsigned" return if field_name == "unsigned"
    "elisa_pymodule_field_void" return if field_name == "void"
    "elisa_pymodule_field_volatile" return if field_name == "volatile"
    "elisa_pymodule_field_while" return if field_name == "while"
    "elisa_pymodule_field_bool" return if field_name == "bool"
    "elisa_pymodule_field_true" return if field_name == "true"
    "elisa_pymodule_field_false" return if field_name == "false"
    "elisa_pymodule_field_nullptr" return if field_name == "nullptr"
    "elisa_pymodule_field_Alignas" return if field_name == "_Alignas"
    "elisa_pymodule_field_Alignof" return if field_name == "_Alignof"
    "elisa_pymodule_field_Atomic" return if field_name == "_Atomic"
    "elisa_pymodule_field_Bool" return if field_name == "_Bool"
    "elisa_pymodule_field_Complex" return if field_name == "_Complex"
    "elisa_pymodule_field_Generic" return if field_name == "_Generic"
    "elisa_pymodule_field_Imaginary" return if field_name == "_Imaginary"
    "elisa_pymodule_field_Noreturn" return if field_name == "_Noreturn"
    "elisa_pymodule_field_Static_assert" return if field_name == "_Static_assert"
    "elisa_pymodule_field_Thread_local" return if field_name == "_Thread_local"
    "elisa_pymodule_field_asm" return if field_name == "asm"
    "elisa_pymodule_field_typeof" return if field_name == "typeof"
    "elisa_pymodule_field_typeof_unqual" return if field_name == "typeof_unqual"
    return field_name




def emit_pymodule_struct_default_value(buffer: mutable darray[u8]&, file: Ast::File&, field_type_name: sview, expression: Ast::Expr) -> void can[Abort.Panic, Memory.Allocate]:
    if pymodule_default_is_null(expression):
        if field_type_name == "cstr?" or field_type_name == "py::Object?":
            emit_tokens_push_sview(buffer, "NULL")
            return
        if field_type_name == "sview?":
            emit_tokens_push_sview(buffer, "(ElisaOptionalSView){false, {0, 0}}")
            return
        if pymodule_is_optional_scalar_type(field_type_name):
            emit_tokens_push_sview(buffer, "(")
            emit_tokens_push_sview(buffer, pymodule_c_type_name(field_type_name))
            emit_tokens_push_sview(buffer, "){false, 0}")
            return
    if field_type_name == "sview":
        emit_tokens_push_sview(buffer, "(ElisaSView){")
        emit_pymodule_default_literal(buffer, file, expression)
        emit_tokens_push_sview(buffer, ", (int64_t)(sizeof(")
        emit_pymodule_default_literal(buffer, file, expression)
        emit_tokens_push_sview(buffer, ") - 1)}")
        return
    if field_type_name == "cstr?":
        emit_pymodule_default_literal(buffer, file, expression)
        return
    if field_type_name == "sview?":
        emit_tokens_push_sview(buffer, "(ElisaOptionalSView){true, (ElisaSView){")
        emit_pymodule_default_literal(buffer, file, expression)
        emit_tokens_push_sview(buffer, ", (int64_t)(sizeof(")
        emit_pymodule_default_literal(buffer, file, expression)
        emit_tokens_push_sview(buffer, ") - 1)}}")
        return
    if pymodule_is_optional_scalar_type(field_type_name):
        emit_tokens_push_sview(buffer, "(")
        emit_tokens_push_sview(buffer, pymodule_c_type_name(field_type_name))
        emit_tokens_push_sview(buffer, "){true, (")
        emit_tokens_push_sview(buffer, pymodule_c_type_name(pymodule_optional_payload_name(field_type_name)))
        emit_tokens_push_sview(buffer, ")(")
        emit_pymodule_default_literal(buffer, file, expression)
        emit_tokens_push_sview(buffer, ")}")
        return
    if pymodule_is_darray_type(field_type_name):
        emit_tokens_push_sview(buffer, "(ElisaDArray){NULL, 0, 0}")
        return
    if pymodule_is_view_type(field_type_name):
        emit_tokens_push_sview(buffer, "(ElisaView){NULL, 0}")
        return
    if pymodule_is_dict_type(field_type_name):
        emit_tokens_push_sview(buffer, "(ElisaDict){NULL, 0, 0, 0, NULL}")
        return
    if pymodule_is_set_type(field_type_name):
        emit_tokens_push_sview(buffer, "(ElisaSet){NULL, 0, 0, 0, NULL}")
        return
    emit_pymodule_default_literal(buffer, file, expression)




def pymodule_struct_nested_dict_helper_name(storage: mutable darray[u8]&, struct_type_name: sview, field_name: sview, suffix: sview) -> sview can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(storage, "elisa_pymodule_struct_")
    emit_tokens_push_sview(storage, struct_type_name)
    emit_tokens_push_sview(storage, "_")
    emit_tokens_push_sview(storage, pymodule_struct_c_field_name(field_name))
    emit_tokens_push_sview(storage, "_dict_")
    emit_tokens_push_sview(storage, suffix)
    return sview(&storage[0], 0, storage.count)




def pymodule_struct_darray_set_helper_name(storage: mutable darray[u8]&, struct_type_name: sview, field_name: sview, suffix: sview) -> sview can[Abort.Panic, Memory.Allocate]:
