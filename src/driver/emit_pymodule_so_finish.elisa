# `-emit pymodule-so` — the PIPELINE itself, in the wrapper's order. Continues
# emit_pymodule_so.elisa; the object at `object_path` was emitted by main() before this ran.
#
# The order is load-bearing: the manifest comes first so the no-output-path form can derive
# its canonical module name, the import-facing basename is validated BEFORE any native work
# so a typo costs a second rather than a full compile, and the two object audits run before
# the link so a declined body is named rather than surviving to `import`.

# The manifest and the C shim, written into the per-process work directory along with the
# module name the rest of the pipeline keys off. Runs with the report emitters, before
# codegen, so the AST argument is still region-inferable here.
def emit_pymodule_so_prepare(file: mutable Ast::File&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    module_name: sview = pymodule_so_module_name(file)
    if module_name == "":
        message: mutable darray[u8] = []
        emit_tokens_push_sview(&message, "requires `export pymodule NAME:`")
        return pymodule_so_error(message)
    work: mutable darray[u8] = []
    pymodule_so_work_dir(&work)
    name_path: mutable darray[u8] = []
    pymodule_so_join(&name_path, work, "module-name.txt")
    name_bytes: mutable darray[u8] = []
    emit_tokens_push_sview(&name_bytes, module_name)
    1 return if not write_file_bytes(name_path, name_bytes)
    # The audit after the compile needs the exported symbol names. They are written here as
    # one plain line each rather than read back out of the manifest: the driver wrote that
    # JSON, so re-parsing it to recover what it already knew would be the only place in the
    # port that reads its own output.
    exports_path: mutable darray[u8] = []
    pymodule_so_join(&exports_path, work, "exports.txt")
    exports: mutable darray[u8] = []
    for annotation in file.enum_annotations |exports, module_name|:
        if annotation.name == "__pymodule_fn" or annotation.name == "__pymodule_const":
            emit_tokens_push_sview(&exports, "elisa_pymodule_")
            emit_tokens_push_sview(&exports, module_name)
            exports.push(95)
            emit_tokens_push_sview(&exports, annotation.owner)
            exports.push(10)
    1 return if not write_file_bytes(exports_path, exports)
    manifest_path: mutable darray[u8] = []
    pymodule_so_join(&manifest_path, work, "manifest.json")
    manifest_status: i64 = pymodule_so_emit_to(manifest_path, file, false)
    manifest_status return if manifest_status != 0
    shim_path: mutable darray[u8] = []
    pymodule_so_join(&shim_path, work, "module.c")
    return pymodule_so_emit_to(shim_path, file, true)




def emit_pymodule_so_finish(object_path: darray[u8]&, requested_out: darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    message: mutable darray[u8] = []

    clang: mutable darray[u8] = []
    pymodule_so_clang(&clang)
    python: mutable darray[u8] = []
    pymodule_so_python(&python)

    root: mutable darray[u8] = []
    wasm_push_root(&root)
    runtime_object: mutable darray[u8] = []
    pymodule_so_runtime_object(root, &runtime_object)
    runtime_auto: mutable bool = false
    if not wasm_file_present(runtime_object) and not pymodule_so_auto_runtime_disabled():
        # Build it once, from the standard library's own runtime-support unit, rather than
        # making a first-time user go and find scripts/build_runtime_object.sh. Opting out
        # (ELISA_PYMODULE_AUTO_RUNTIME=0) turns the absence back into the named error below.
        runtime_source: mutable darray[u8] = [entry for entry in root]
        emit_tokens_push_sview(&runtime_source, "/elisacore_std/native_runtime_support.elisa")
        if not wasm_file_present(runtime_source):
            emit_tokens_push_sview(&message, "cannot auto-build the runtime: missing ")
            for index in 0..<runtime_source.count |message, runtime_source|:
                message.push(runtime_source[index])
            return pymodule_so_error(message)
        notice: mutable darray[u8] = []
        emit_tokens_push_sview(&notice, "pymodule-so: building runtime object at ")
        for index in 0..<runtime_object.count |notice, runtime_object|:
            notice.push(runtime_object[index])
        emit_tokens_push_sview(&notice, "\n")
        write_stderr(notice)
        runtime_directory: darray[u8] = path_directory(runtime_object)
        make_directory(runtime_directory) if runtime_directory.count > 0.usize()
        self_path: mutable darray[u8] = []
        wasm_push_env_or(&self_path, "ELISA_STAGE1_SELF", "bin/elisac-stage1")
        # The child inherits this compile's environment, so the MODE variables are cleared —
        # otherwise it would take the pymodule path again and reject the runtime source for
        # having no `export pymodule`. Only variables whose readers compare a VALUE are named:
        # the ELISACORE_* pair is read by PRESENCE, and naming them would switch them on.
        runtime_command: mutable darray[u8] = []
        emit_tokens_push_sview(&runtime_command, "ELISA_STAGE1_EMIT= ELISA_STAGE1_PYMODULE_OUT= ELISA_STAGE1_LINE_MAP= ELISA_STAGE1_SRC= ELISA_STAGE1_OPT= ")
        carchive_push_quoted(&runtime_command, self_path)
        emit_tokens_push_sview(&runtime_command, " -emit obj -O0 -o ")
        carchive_push_quoted(&runtime_command, runtime_object)
        runtime_command.push(32)
        carchive_push_quoted(&runtime_command, runtime_source)
        1 return if not wasm_run(runtime_command, "runtime object compilation")
        runtime_auto <- true
    if not wasm_file_present(runtime_object):
        emit_tokens_push_sview(&message, "requires the runtime object at ")
        for index in 0..<runtime_object.count |message, runtime_object|:
            message.push(runtime_object[index])
        emit_tokens_push_sview(&message, " (run scripts/build_runtime_object.sh or set ELISA_PYMODULE_AUTO_RUNTIME=0)")
        return pymodule_so_error(message)

    work: mutable darray[u8] = []
    pymodule_so_work_dir(&work)

    # 1. The manifest, the shim and the module name, written by emit_pymodule_so_prepare
    #    before the compile.
    manifest_path: mutable darray[u8] = []
    pymodule_so_join(&manifest_path, work, "manifest.json")
    shim_path: mutable darray[u8] = []
    pymodule_so_join(&shim_path, work, "module.c")
    name_path: mutable darray[u8] = []
    pymodule_so_join(&name_path, work, "module-name.txt")
    name_terminated: mutable darray[u8] = [entry for entry in name_path]
    name_terminated.push(0)
    name_cstr: cstr = (&name_terminated[0]).cast[cstr] can Unsafe.PointerCast
    module_bytes: darray[u8] = read_file(name_cstr)
    if module_bytes.count == 0:
        emit_tokens_push_sview(&message, "requires `export pymodule NAME:`")
        return pymodule_so_error(message)
    module_name: sview = sview(&module_bytes[0], 0, module_bytes.count.i64())

    # 2. The output name. Absent `-o`, the module's own name; then the interpreter's
    #    canonical extension suffix unless one it already recognises is present.
    out: mutable darray[u8] = [entry for entry in requested_out]
    if out.count == 0:
        emit_tokens_push_sview(&out, module_name)

    suffixes: mutable darray[u8] = []
    suffix_command: mutable darray[u8] = []
    carchive_push_quoted(&suffix_command, python)
    emit_tokens_push_sview(&suffix_command, " -c 'import _imp\nfor s in _imp.extension_suffixes(): print(s)'")
    if not pymodule_so_capture(suffix_command, work, &suffixes):
        emit_tokens_push_sview(&message, "could not determine Python's extension suffixes (set PYTHON_BIN)")
        return pymodule_so_error(message)

    if not pymodule_so_has_known_suffix(out, suffixes):
        ext: mutable darray[u8] = []
        ext_command: mutable darray[u8] = []
        carchive_push_quoted(&ext_command, python)
        emit_tokens_push_sview(&ext_command, " -c 'import sysconfig\nprint(sysconfig.get_config_var(\"EXT_SUFFIX\") or \".so\")'")
        if not pymodule_so_capture(ext_command, work, &ext):
            emit_tokens_push_sview(&message, "could not determine Python's extension suffix")
            return pymodule_so_error(message)
        for index in 0..<ext.count |out, ext|:
            out.push(ext[index])

    name_status: i64 = pymodule_so_check_basename(out, module_name, suffixes)
    name_status return if name_status != 0
    output_directory: darray[u8] = path_directory(out)
    make_directory(output_directory) if output_directory.count > 0.usize()

    # 3. The object audits.
    nm_tool: mutable darray[u8] = []
    has_nm: bool = pymodule_so_llvm_tool("llvm-nm", "ELISA_LLVM_NM", &nm_tool)
    if has_nm:
        audit_status: i64 = pymodule_so_audit_symbols(nm_tool, object_path, work)
        audit_status return if audit_status != 0
        objcopy_tool: mutable darray[u8] = []
        if pymodule_so_llvm_tool("llvm-objcopy", "ELISA_LLVM_OBJCOPY", &objcopy_tool):
            pymodule_so_localize(nm_tool, objcopy_tool, object_path, runtime_object, work)

    # 5. The Python headers.
    include_flags: mutable darray[u8] = []
    include_status: i64 = pymodule_so_include_flags(python, work, &include_flags)
    include_status return if include_status != 0

    # 6. The callback fallbacks, when the runtime leaves those hooks unresolved.
    fallback_object: mutable darray[u8] = []
    if runtime_auto or pymodule_so_needs_callback_fallback(nm_tool, runtime_object, work):
        pymodule_so_join(&fallback_object, work, "native_callback_fallback.o")
        fallback_source: mutable darray[u8] = [entry for entry in root]
        emit_tokens_push_sview(&fallback_source, "/scripts/pymodule_runtime_fallback.c")
        fallback_command: mutable darray[u8] = []
        carchive_push_quoted(&fallback_command, clang)
        emit_tokens_push_sview(&fallback_command, " -c -fPIC -fno-builtin -O2 -o ")
        carchive_push_quoted(&fallback_command, fallback_object)
        fallback_command.push(32)
        carchive_push_quoted(&fallback_command, fallback_source)
        1 return if not wasm_run(fallback_command, "clang")

    # 7. The link.
    link_status: i64 = pymodule_so_link(clang, include_flags, out, shim_path, object_path, runtime_object, fallback_object)
    link_status return if link_status != 0

    # 8. The `.pyi` sidecar, named after the MODULE rather than the ABI-tagged filename, so
    #    an IDE finds `demo.pyi` beside `demo.cpython-314-darwin.so`.
    stub_path: mutable darray[u8] = []
    stub_directory: darray[u8] = path_directory(out)
    for index in 0..<stub_directory.count |stub_path, stub_directory|:
        stub_path.push(stub_directory[index])
    # `path_directory` keeps its trailing separator, so add one only when it did not.
    stub_path.push(47) if stub_directory.count > 0.usize() and stub_directory[stub_directory.count - 1.usize()] != 47
    emit_tokens_push_sview(&stub_path, module_name)
    emit_tokens_push_sview(&stub_path, ".pyi")
    stub_command: mutable darray[u8] = []
    carchive_push_quoted(&stub_command, python)
    stub_command.push(32)
    stub_script: mutable darray[u8] = [entry for entry in root]
    emit_tokens_push_sview(&stub_script, "/scripts/pymodule_pyi.py")
    carchive_push_quoted(&stub_command, stub_script)
    stub_command.push(32)
    carchive_push_quoted(&stub_command, manifest_path)
    stub_command.push(32)
    carchive_push_quoted(&stub_command, stub_path)
    1 return if not wasm_run(stub_command, "pymodule_pyi.py")

    report: mutable darray[u8] = []
    emit_tokens_push_sview(&report, "pymodule-so: wrote ")
    for index in 0..<out.count |report, out|:
        report.push(out[index])
    emit_tokens_push_sview(&report, " and ")
    for index in 0..<stub_path.count |report, stub_path|:
        report.push(stub_path[index])
    emit_tokens_push_sview(&report, " (import as ")
    emit_tokens_push_sview(&report, module_name)
    emit_tokens_push_sview(&report, ")\n")
    write_stderr(report)
    return 0




# Run one report emitter with its output redirected to `path`. `emit_tokens_flush` writes to
# ELISA_STAGE1_OUT, so the redirect is that variable — set, used, restored.
def pymodule_so_emit_to(path: darray[u8]&, file: mutable Ast::File&, shim: bool) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    previous: mutable darray[u8] = []
    had_previous: bool = env_value("ELISA_STAGE1_OUT", &previous)
    terminated: mutable darray[u8] = [entry for entry in path]
    terminated.push(0)
    _ = setenv("ELISA_STAGE1_OUT".cast[cstr], (&terminated[0]).cast[cstr], 1)
    status: i64 = emit_pymodule_c_report(file) if shim else emit_pymodule_report(file)
    if had_previous:
        previous.push(0)
        _ = setenv("ELISA_STAGE1_OUT".cast[cstr], (&previous[0]).cast[cstr], 1)
    else:
        _ = setenv("ELISA_STAGE1_OUT".cast[cstr], "".cast[cstr], 1)
    return status




# Python's import machinery recognises ABI-tagged suffixes and the plain `.so` fallback, not
# an arbitrary suffixless name.
def pymodule_so_has_known_suffix(out: darray[u8]&, suffixes: darray[u8]&) -> bool can[Abort.Panic]:
    start: mutable usize = 0.usize()
    while start < suffixes.count |start, suffixes, out|:
        stop: usize = pymodule_so_line_stop(suffixes, start)
        true return if stop > start and pymodule_so_ends_with(out, suffixes, start, stop)
        start <- stop + 1.usize()
    return false




# The import-facing basename must be the module's own name plus a recognised suffix; anything
# else imports under the wrong name or not at all. Checked before the native work so
# `-o wrong-name.so` costs a second, not a full compile.
def pymodule_so_check_basename(out: darray[u8]&, module_name: sview, suffixes: darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    base_start: usize = pymodule_so_basename_start(out)
    stem_stop: mutable usize = out.count
    start: mutable usize = 0.usize()
    while start < suffixes.count |start, stem_stop, suffixes, out|:
        stop: usize = pymodule_so_line_stop(suffixes, start)
        if stop > start and pymodule_so_ends_with(out, suffixes, start, stop) and stem_stop == out.count:
            stem_stop <- out.count - (stop - start)
        start <- stop + 1.usize()
    matches: mutable bool = stem_stop - base_start == sview_len(module_name)
    if matches:
        for index in base_start..<stem_stop |matches, out, module_name, base_start|:
            matches <- false if out[index] != sview_at(module_name, (index - base_start).i64())
    0 return if matches
    # An ABI-tagged name from a DIFFERENT Python installation is still correct: the build and
    # import interpreters are allowed to differ, and this interpreter's suffix list cannot
    # recognise another one's tag. Accept `<module>.abi3.so`, `<module>.cpython-*.so` and
    # `<module>.pypy*.so` on the shape of the tag alone.
    0 return if pymodule_so_foreign_abi_tag(out, base_start, module_name)
    message: mutable darray[u8] = []
    emit_tokens_push_sview(&message, "output filename '")
    for index in base_start..<out.count |message, out|:
        message.push(out[index])
    emit_tokens_push_sview(&message, "' must be named '")
    emit_tokens_push_sview(&message, module_name)
    emit_tokens_push_sview(&message, "' plus a Python extension suffix to import as ")
    emit_tokens_push_sview(&message, module_name)
    return pymodule_so_error(message)




# `python3-config --includes` when the host names one, else the interpreter's own INCLUDEPY.
def pymodule_so_include_flags(python: darray[u8]&, work: darray[u8]&, flags: mutable darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    config: mutable darray[u8] = []
    if env_value("PYTHON_CONFIG", &config) and config.count > 0:
        message: mutable darray[u8] = []
        # A BARE NAME (`python3.14-config`) is resolved by the shell that runs it, so it must
        # not be probed as a path — `access` would look for it in the working directory and
        # reject a perfectly good PATH entry. Only a value that names a path is checked here.
        if pymodule_so_names_a_path(config) and not wasm_executable(config):
            emit_tokens_push_sview(&message, "requires a usable python3-config (set PYTHON_CONFIG)")
            return pymodule_so_error(message)
        command: mutable darray[u8] = []
        carchive_push_quoted(&command, config)
        emit_tokens_push_sview(&command, " --includes")
        if pymodule_so_capture(command, work, flags):
            # A `python3-config` is NOT guaranteed to belong to the interpreter selected
            # above: `/usr/bin/python3` is 3.9 on this host while Homebrew's python3-config
            # is 3.14, and mixing those headers with that runtime produces an extension that
            # COMPILES and then fails at `import` with an unresolved `_PyObject_DelAttrString`.
            # Reject the pair by name rather than shipping it.
            0 return if pymodule_so_python_versions_agree(python, flags, work)
            emit_tokens_push_sview(&message, "python toolchain mismatch: the selected interpreter and ")
            for index in 0..<config.count |message, config|:
                message.push(config[index])
            emit_tokens_push_sview(&message, " are different Python versions")
            return pymodule_so_error(message)
        emit_tokens_push_sview(&message, "requires a usable python3-config (set PYTHON_CONFIG)")
        return pymodule_so_error(message)
    include_dir: mutable darray[u8] = []
    command: mutable darray[u8] = []
    carchive_push_quoted(&command, python)
    emit_tokens_push_sview(&command, " -c 'import sysconfig\nprint(sysconfig.get_config_var(\"INCLUDEPY\") or sysconfig.get_path(\"include\") or \"\")'")
    if not pymodule_so_capture(command, work, &include_dir):
        message: mutable darray[u8] = []
        emit_tokens_push_sview(&message, "could not determine Python headers (set PYTHON_CONFIG)")
        return pymodule_so_error(message)
    emit_tokens_push_sview(flags, "-I")
    for index in 0..<include_dir.count |flags, include_dir|:
        flags.push(include_dir[index])
    return 0




# Darwin builds a bundle with dynamic lookup (Python's C API resolves at import); Linux a
# plain shared object. Anything else is refused by name rather than linked wrongly.
def pymodule_so_link(clang: darray[u8]&, include_flags: darray[u8]&, out: darray[u8]&, shim_path: darray[u8]&, object_path: darray[u8]&, runtime_object: darray[u8]&, fallback_object: darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    command: mutable darray[u8] = []
    carchive_push_quoted(&command, clang)
    if host_platform_is_darwin():
        emit_tokens_push_sview(&command, " -bundle -undefined dynamic_lookup -Wl,-dead_strip ")
    else:
        emit_tokens_push_sview(&command, " -shared -fPIC -Wl,--gc-sections ")
    for index in 0..<include_flags.count |command, include_flags|:
        command.push(include_flags[index])
    emit_tokens_push_sview(&command, " -o ")
    carchive_push_quoted(&command, out)
    command.push(32)
    carchive_push_quoted(&command, shim_path)
    command.push(32)
    carchive_push_quoted(&command, object_path)
    command.push(32)
    carchive_push_quoted(&command, runtime_object)
    if fallback_object.count > 0:
        command.push(32)
        carchive_push_quoted(&command, fallback_object)
    1 return if not wasm_run(command, "clang")
    return 0




# `-emit pymodule-pyi` — the type-checker stub alone. The manifest goes to the work
# directory and the renderer projects it onto the requested output path.
def emit_pymodule_pyi_report(file: mutable Ast::File&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    module_name: sview = pymodule_so_module_name(file)
    if module_name == "":
        message: mutable darray[u8] = []
        emit_tokens_push_sview(&message, "requires `export pymodule NAME:`")
        return pymodule_so_error(message)
    # `-o` travels in the environment for the same reason it does for `-emit pymodule-so`:
    # absent, the stub is named after the MODULE, which the CLI's `<source>.o` default
    # cannot express.
    out: mutable darray[u8] = []
    _ = env_value("ELISA_STAGE1_PYMODULE_OUT", &out)
    if out.count == 0:
        emit_tokens_push_sview(&out, module_name)
        emit_tokens_push_sview(&out, ".pyi")
    output_directory: darray[u8] = path_directory(out)
    make_directory(output_directory) if output_directory.count > 0.usize()
    work: mutable darray[u8] = []
    pymodule_so_work_dir(&work)
    manifest_path: mutable darray[u8] = []
    pymodule_so_join(&manifest_path, work, "manifest.json")
    manifest_status: i64 = pymodule_so_emit_to(manifest_path, file, false)
    manifest_status return if manifest_status != 0
    python: mutable darray[u8] = []
    pymodule_so_python(&python)
    root: mutable darray[u8] = []
    wasm_push_root(&root)
    command: mutable darray[u8] = []
    carchive_push_quoted(&command, python)
    command.push(32)
    script: mutable darray[u8] = [entry for entry in root]
    emit_tokens_push_sview(&script, "/scripts/pymodule_pyi.py")
    carchive_push_quoted(&command, script)
    command.push(32)
    carchive_push_quoted(&command, manifest_path)
    command.push(32)
    carchive_push_quoted(&command, out)
    1 return if not wasm_run(command, "pymodule_pyi.py")
    report: mutable darray[u8] = []
    emit_tokens_push_sview(&report, "pymodule-pyi: wrote ")
    for index in 0..<out.count |report, out|:
        report.push(out[index])
    emit_tokens_push_sview(&report, "\n")
    write_stderr(report)
    return 0




# Does the basename read as `<module_name>` plus a Python ABI tag this interpreter does not
# itself produce? Only the three documented shapes, so an arbitrary trailing string is still
# rejected.
def pymodule_so_foreign_abi_tag(out: darray[u8]&, base_start: usize, module_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    length: i64 = sview_len(module_name)
    false return if (out.count - base_start).i64() <= length
    for index in 0..<length |out, module_name, base_start|:
        false return if out[base_start + index.usize()] != sview_at(module_name, index)
    abi_tail: mutable darray[u8] = []
    for index in (base_start + length.usize())..<out.count |abi_tail, out|:
        abi_tail.push(out[index])
    false return if not pymodule_so_tail_is(abi_tail, ".so")
    true return if pymodule_so_tail_starts(abi_tail, ".abi3.")
    true return if pymodule_so_tail_starts(abi_tail, ".cpython-")
    return pymodule_so_tail_starts(abi_tail, ".pypy")




def pymodule_so_tail_is(abi_tail: darray[u8]&, suffix: sview) -> bool can[Abort.Panic]:
    length: usize = sview_len(suffix)
    false return if abi_tail.count < length
    base: usize = abi_tail.count - length
    for index in 0..<length |abi_tail, suffix, base|:
        false return if abi_tail[base + index] != sview_at(suffix, index.i64())
    return true




def pymodule_so_tail_starts(abi_tail: darray[u8]&, prefix: sview) -> bool can[Abort.Panic]:
    length: usize = sview_len(prefix)
    false return if abi_tail.count < length
    for index in 0..<length |abi_tail, prefix|:
        false return if abi_tail[index] != sview_at(prefix, index.i64())
    return true




# `ELISA_PYMODULE_AUTO_RUNTIME=0` turns a missing runtime object back into an error instead
# of building one.
def pymodule_so_auto_runtime_disabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    setting: mutable darray[u8] = []
    false return if not env_value("ELISA_PYMODULE_AUTO_RUNTIME", &setting)
    return setting.count == 1.usize() and setting[0] == 48




# Does the `python3-config --includes` output name the same `pythonX.Y` the interpreter
# reports? Compared as the printed version string, which is what appears in the include path.
def pymodule_so_python_versions_agree(python: darray[u8]&, flags: darray[u8]&, work: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    version: mutable darray[u8] = []
    command: mutable darray[u8] = []
    carchive_push_quoted(&command, python)
    emit_tokens_push_sview(&command, " -c 'import sys\nprint(\"python%d.%d\" % sys.version_info[:2])'")
    # An interpreter that cannot answer is not a mismatch; the caller has bigger problems and
    # will meet them with a clearer message.
    true return if not pymodule_so_capture(command, work, &version)
    return pymodule_so_contains(flags, version)




def pymodule_so_names_a_path(value: darray[u8]&) -> bool can[Abort.Panic]:
    for index in 0..<value.count |value|:
        true return if value[index] == 47
    return false
