# The first compiler-to-debugger slice. This writer accepts one intentionally
# narrow shape and emits the debugger's portable EDIR schema-2 artifact with
# exact source identity for one original source file.

module ElisaEDIR:
    private:
        const EDIR_CODEC_SCHEMA: u32 = 2
        const EDIR_PROGRAM_VERSION: u32 = 1
        const EDIR_ROOT_SOURCE_FILE_ID: u64 = 1
        const EDIR_SOURCE_FILE_COUNT: u32 = 1
        const EDIR_SOURCE_PATH_CAPACITY: usize = 1024
        const EDIR_SOURCE_PATH_ASCII_MAX: u64 = 127
        const EDIR_SOURCE_PATH_UTF8_CONTINUATION_BASE: u64 = 128
        const EDIR_SOURCE_PATH_UTF8_CONTINUATION_MAX: u64 = 191
        const EDIR_SOURCE_PATH_UTF8_CONTINUATION_MASK: u64 = 63
        const EDIR_SOURCE_PATH_UTF8_SHIFT: u64 = 6
        const EDIR_SOURCE_PATH_UTF8_FIRST_TWO_MASK: u64 = 31
        const EDIR_SOURCE_PATH_UTF8_FIRST_THREE_MASK: u64 = 15
        const EDIR_SOURCE_PATH_UTF8_FIRST_FOUR_MASK: u64 = 7
        const EDIR_SOURCE_PATH_UTF8_TWO_BYTE_START: u64 = 194
        const EDIR_SOURCE_PATH_UTF8_TWO_BYTE_END: u64 = 223
        const EDIR_SOURCE_PATH_UTF8_THREE_BYTE_START: u64 = 224
        const EDIR_SOURCE_PATH_UTF8_THREE_BYTE_END: u64 = 239
        const EDIR_SOURCE_PATH_UTF8_FOUR_BYTE_START: u64 = 240
        const EDIR_SOURCE_PATH_UTF8_FOUR_BYTE_END: u64 = 244
        const EDIR_SOURCE_PATH_UTF8_TWO_BYTE_MIN: u64 = 128
        const EDIR_SOURCE_PATH_UTF8_THREE_BYTE_MIN: u64 = 2048
        const EDIR_SOURCE_PATH_UTF8_FOUR_BYTE_MIN: u64 = 65536
        const EDIR_SOURCE_PATH_UNICODE_MAX: u64 = 1114111
        const EDIR_SOURCE_PATH_SURROGATE_START: u64 = 55296
        const EDIR_SOURCE_PATH_SURROGATE_END: u64 = 57343
        const EDIR_SOURCE_PATH_ASCII_CONTROL_MAX: u64 = 31
        const EDIR_SOURCE_PATH_DELETE: u64 = 127
        const EDIR_SOURCE_PATH_C1_CONTROL_MAX: u64 = 159
        const EDIR_SOURCE_PATH_SLASH: u8 = 47
        const EDIR_SOURCE_PATH_BACKSLASH: u8 = 92
        const EDIR_SOURCE_PATH_COLON: u8 = 58
        const EDIR_SOURCE_PATH_DOT: u8 = 46
        const EDIR_SOURCE_PATH_UPPER_A: u8 = 65
        const EDIR_SOURCE_PATH_UPPER_Z: u8 = 90
        const EDIR_SOURCE_PATH_LOWER_A: u8 = 97
        const EDIR_SOURCE_PATH_LOWER_Z: u8 = 122
        const EDIR_SOURCE_PATH_SINGLE_DOT_LENGTH: usize = 1
        const EDIR_SOURCE_PATH_PARENT_SEGMENT_LENGTH: usize = 2
        const EDIR_HASH_OFFSET_BASIS: u64 = 14695981039346656037
        const EDIR_HASH_PRIME: u64 = 1099511628211
        const EDIR_HASH_NONZERO_FALLBACK: u64 = 1
        const EDIR_LINE_COUNT_INCREMENT: u64 = 1
        const EDIR_LITERAL_INSTRUCTION_COUNT: u64 = 2
        const EDIR_BINARY_INSTRUCTION_COUNT: u64 = 3
        const EDIR_LOCAL_INSTRUCTION_COUNT: u64 = 4
        const EDIR_LOCAL_BINARY_INSTRUCTION_COUNT: u64 = 5
        const EDIR_COUNTED_LOOP_LOCAL_COUNT: u64 = 2
        const EDIR_COUNTED_LOOP_COUNTER_INDEX: i64 = 0
        const EDIR_COUNTED_LOOP_TOTAL_INDEX: i64 = 1
        const EDIR_COUNTED_LOOP_STATEMENT_COUNT: usize = 4
        const EDIR_COUNTED_LOOP_BODY_STATEMENT_COUNT: usize = 2
        const EDIR_COUNTED_LOOP_COUNTER_DECLARATION_INDEX: usize = 0
        const EDIR_COUNTED_LOOP_TOTAL_DECLARATION_INDEX: usize = 1
        const EDIR_COUNTED_LOOP_WHILE_STATEMENT_INDEX: usize = 2
        const EDIR_COUNTED_LOOP_RETURN_STATEMENT_INDEX: usize = 3
        const EDIR_COUNTED_LOOP_TOTAL_UPDATE_INDEX: usize = 0
        const EDIR_COUNTED_LOOP_COUNTER_UPDATE_INDEX: usize = 1
        const EDIR_COUNTED_LOOP_INITIAL_VALUE: i64 = 0
        const EDIR_COUNTED_LOOP_TOTAL_INCREMENT: i64 = 2
        const EDIR_COUNTED_LOOP_COUNTER_INCREMENT: i64 = 1
        const EDIR_MAX_SERIALIZED_INSTRUCTIONS: usize = 128
        const EDIR_NO_POSITION_LINE: u32 = 0
        const EDIR_NO_POSITION_COLUMN: u32 = 0
        const EDIR_NO_POSITION_OFFSET: u32 = 0
        const EDIR_NO_OPERAND: i64 = 0
        const EDIR_NO_LOCALS: u64 = 0
        const EDIR_SINGLE_LOCAL_COUNT: u64 = 1
        const EDIR_SINGLE_LOCAL_INDEX: i64 = 0
        const EDIR_TOP_LEVEL_DECLARATION_COUNT: usize = 1
        const EDIR_PARAMETER_COUNT: usize = 0
        const EDIR_STATEMENT_COUNT: usize = 1
        const EDIR_LOCAL_STATEMENT_COUNT: usize = 2
        const EDIR_SOURCE_MAP_ENTRY_COUNT: usize = 1
        const EDIR_SOURCE_DISCRIMINATOR: u32 = 0
        const EDIR_UNSUPPORTED_OPCODE: u16 = 0
        const EDIR_STATUS_SUCCESS: i64 = 0
        const EDIR_STATUS_FAILURE: i64 = 1
        const EDIR_SYSCALL_ERROR_THRESHOLD: i64 = 0
        const EDIR_OPCODE_CONSTANT: u16 = 1
        const EDIR_OPCODE_ADD: u16 = 2
        const EDIR_OPCODE_SUBTRACT: u16 = 3
        const EDIR_OPCODE_LOAD_LOCAL: u16 = 4
        const EDIR_OPCODE_STORE_LOCAL: u16 = 5
        const EDIR_OPCODE_MULTIPLY: u16 = 11
        const EDIR_OPCODE_DIVIDE: u16 = 12
        const EDIR_OPCODE_COMPARE_LESS: u16 = 15
        const EDIR_OPCODE_JUMP: u16 = 16
        const EDIR_OPCODE_BRANCH_ZERO: u16 = 17
        const EDIR_OPCODE_RETURN: u16 = 19
        const EDIR_TRUE: u8 = 1
        const EDIR_NUL_BYTE: u8 = 0
        const EDIR_NEWLINE_BYTE: u8 = 10
        const EDIR_BYTE_WIDTH: usize = 1
        const EDIR_U16_WIDTH: usize = 2
        const EDIR_U32_WIDTH: usize = 4
        const EDIR_U64_WIDTH: usize = 8
        const EDIR_BITS_PER_BYTE: u64 = 8
        const EDIR_BYTE_MASK: u64 = 255
        const EDIR_I64_MAX: i64 = 9223372036854775807
        const EDIR_COUNTED_LOOP_TOTAL_MAX: i64 = EDIR_I64_MAX / EDIR_COUNTED_LOOP_TOTAL_INCREMENT
        const EDIR_SOURCE_SPAN_U64_FIELDS: usize = 3
        const EDIR_SOURCE_SPAN_U32_FIELDS: usize = 5
        const EDIR_INSTRUCTION_OPERAND_COUNT: usize = 2
        const EDIR_SOURCE_SPAN_BYTES: usize = EDIR_U64_WIDTH * EDIR_SOURCE_SPAN_U64_FIELDS + EDIR_U32_WIDTH * EDIR_SOURCE_SPAN_U32_FIELDS
        const EDIR_SERIALIZED_INSTRUCTION_BYTES: usize = EDIR_U16_WIDTH + EDIR_U64_WIDTH * EDIR_INSTRUCTION_OPERAND_COUNT + EDIR_SOURCE_SPAN_BYTES
        const EDIR_OPERAND_A_BYTE_OFFSET: usize = EDIR_U16_WIDTH
        static if ELISA_TARGET_OS_LINUX:
            const EDIR_OPEN_WRITE_CREATE_TRUNCATE: i64 = 577
        static else:
            const EDIR_OPEN_WRITE_CREATE_TRUNCATE: i64 = 1537
        const EDIR_OUTPUT_FILE_MODE: i64 = 420
        const EDIR_OUTPUT_DESCRIPTOR_FAILURE: i64 = -1
        const EDIR_WRITE_NO_PROGRESS: isize = 0

        struct EDIRSourceIdentity:
            file_id: mutable u64
            logical_path_id: mutable u64
            content_digest: mutable u64
            line_count: mutable u64
            path_bytes: mutable u8[EDIR_SOURCE_PATH_CAPACITY]
            path_length: mutable usize

        def unsupported(reason: sview) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            message: mutable darray[u8] = []
            emit_tokens_push_sview(&message, "error: -emit edir supports literal arithmetic, one typed integer local, or one bounded counted loop in `def main() -> i64`: ")
            message.extend(reason)
            message.push(EDIR_NEWLINE_BYTE)
            write_stderr(message)
            return EDIR_STATUS_FAILURE



        def append_unsigned_le(buffer: mutable darray[u8]&, value: u64, width: usize) -> void can[Abort.Panic, Memory.Allocate]:
            for byte_index in 0..<width |buffer, value, width|:
                shift: u64 = byte_index.u64() * EDIR_BITS_PER_BYTE
                buffer.push(((value >> shift) & EDIR_BYTE_MASK).u8())



        def append_signed_i64_le(buffer: mutable darray[u8]&, value: i64) -> void can[Abort.Panic, Memory.Allocate]:
            append_unsigned_le(buffer, value.u64(), EDIR_U64_WIDTH)



        def append_source_span(buffer: mutable darray[u8]&, position: Ast::Pos) -> void can[Abort.Panic, Memory.Allocate]:
            append_unsigned_le(buffer, EDIR_ROOT_SOURCE_FILE_ID, EDIR_U64_WIDTH)
            append_unsigned_le(buffer, position.offset.u64(), EDIR_U64_WIDTH)
            append_unsigned_le(buffer, position.end_offset.u64(), EDIR_U64_WIDTH)
            append_unsigned_le(buffer, position.line.u64(), EDIR_U32_WIDTH)
            append_unsigned_le(buffer, position.column.u64(), EDIR_U32_WIDTH)
            append_unsigned_le(buffer, position.end_line.u64(), EDIR_U32_WIDTH)
            append_unsigned_le(buffer, position.end_column.u64(), EDIR_U32_WIDTH)
            append_unsigned_le(buffer, EDIR_SOURCE_DISCRIMINATOR.u64(), EDIR_U32_WIDTH)



        def hash_byte(hash: u64, byte: u8) -> u64:
            return (hash ^ byte.u64()) * EDIR_HASH_PRIME



        def hash_domain_and_bytes(domain: sview, bytes: darray[u8]&) -> u64 can[Abort.Panic]:
            hash: mutable u64 = EDIR_HASH_OFFSET_BASIS
            for index in 0..<sview_len(domain) |hash, domain|:
                hash <- hash_byte(hash, sview_at(domain, index))
            for index in 0..<bytes.count |hash, bytes|:
                hash <- hash_byte(hash, bytes[index])
            return EDIR_HASH_NONZERO_FALLBACK if hash == 0
            return hash



        def source_path_utf8_is_valid(bytes: darray[u8]&) -> bool:
            index: mutable usize = 0
            while index < bytes.count |index, bytes|:
                first: u64 = bytes[index].u64()
                sequence_length: mutable usize = 1
                minimum_codepoint: mutable u64 = 0
                codepoint: mutable u64 = first
                if first > EDIR_SOURCE_PATH_ASCII_MAX:
                    if first >= EDIR_SOURCE_PATH_UTF8_TWO_BYTE_START and first <= EDIR_SOURCE_PATH_UTF8_TWO_BYTE_END:
                        sequence_length <- 2
                        minimum_codepoint <- EDIR_SOURCE_PATH_UTF8_TWO_BYTE_MIN
                        codepoint <- first & EDIR_SOURCE_PATH_UTF8_FIRST_TWO_MASK
                    if first >= EDIR_SOURCE_PATH_UTF8_THREE_BYTE_START and first <= EDIR_SOURCE_PATH_UTF8_THREE_BYTE_END:
                        sequence_length <- 3
                        minimum_codepoint <- EDIR_SOURCE_PATH_UTF8_THREE_BYTE_MIN
                        codepoint <- first & EDIR_SOURCE_PATH_UTF8_FIRST_THREE_MASK
                    if first >= EDIR_SOURCE_PATH_UTF8_FOUR_BYTE_START and first <= EDIR_SOURCE_PATH_UTF8_FOUR_BYTE_END:
                        sequence_length <- 4
                        minimum_codepoint <- EDIR_SOURCE_PATH_UTF8_FOUR_BYTE_MIN
                        codepoint <- first & EDIR_SOURCE_PATH_UTF8_FIRST_FOUR_MASK
                    return false if sequence_length == 1 or sequence_length > bytes.count - index
                    for continuation_index in 1..<sequence_length |bytes, codepoint|:
                        continuation: u64 = bytes[index + continuation_index].u64()
                        return false if continuation < EDIR_SOURCE_PATH_UTF8_CONTINUATION_BASE or continuation > EDIR_SOURCE_PATH_UTF8_CONTINUATION_MAX
                        codepoint <- (codepoint << EDIR_SOURCE_PATH_UTF8_SHIFT) | (continuation & EDIR_SOURCE_PATH_UTF8_CONTINUATION_MASK)
                    return false if codepoint < minimum_codepoint or codepoint > EDIR_SOURCE_PATH_UNICODE_MAX
                    return false if codepoint >= EDIR_SOURCE_PATH_SURROGATE_START and codepoint <= EDIR_SOURCE_PATH_SURROGATE_END
                return false if codepoint <= EDIR_SOURCE_PATH_ASCII_CONTROL_MAX or codepoint >= EDIR_SOURCE_PATH_DELETE and codepoint <= EDIR_SOURCE_PATH_C1_CONTROL_MAX
                index <- index + sequence_length
            return true



        def source_path_has_drive_prefix(bytes: darray[u8]&) -> bool:
            return false if bytes.count <= EDIR_SOURCE_PATH_SINGLE_DOT_LENGTH
            return false if bytes[EDIR_SOURCE_PATH_SINGLE_DOT_LENGTH] != EDIR_SOURCE_PATH_COLON
            first: u8 = bytes[0]
            return first >= EDIR_SOURCE_PATH_UPPER_A and first <= EDIR_SOURCE_PATH_UPPER_Z or first >= EDIR_SOURCE_PATH_LOWER_A and first <= EDIR_SOURCE_PATH_LOWER_Z



        def source_path_is_valid(bytes: darray[u8]&) -> bool:
            return false if bytes.count == 0 or bytes.count > EDIR_SOURCE_PATH_CAPACITY
            return false if bytes[0] == EDIR_SOURCE_PATH_SLASH or bytes[bytes.count - EDIR_BYTE_WIDTH] == EDIR_SOURCE_PATH_SLASH
            return false if not source_path_utf8_is_valid(bytes)
            return false if source_path_has_drive_prefix(bytes)
            segment_start: mutable usize = 0
            for index in 0..<bytes.count |bytes, segment_start|:
                byte: u8 = bytes[index]
                return false if byte == EDIR_SOURCE_PATH_BACKSLASH
                if byte == EDIR_SOURCE_PATH_SLASH:
                    segment_length: usize = index - segment_start
                    return false if segment_length == 0
                    return false if segment_length == EDIR_SOURCE_PATH_SINGLE_DOT_LENGTH and bytes[segment_start] == EDIR_SOURCE_PATH_DOT
                    return false if segment_length == EDIR_SOURCE_PATH_PARENT_SEGMENT_LENGTH and bytes[segment_start] == EDIR_SOURCE_PATH_DOT and bytes[segment_start + 1] == EDIR_SOURCE_PATH_DOT
                    segment_start <- index + EDIR_BYTE_WIDTH
            final_segment_length: usize = bytes.count - segment_start
            return false if final_segment_length == 0
            return false if final_segment_length == EDIR_SOURCE_PATH_SINGLE_DOT_LENGTH and bytes[segment_start] == EDIR_SOURCE_PATH_DOT
            return false if final_segment_length == EDIR_SOURCE_PATH_PARENT_SEGMENT_LENGTH and bytes[segment_start] == EDIR_SOURCE_PATH_DOT and bytes[segment_start + EDIR_BYTE_WIDTH] == EDIR_SOURCE_PATH_DOT
            return true



        def source_path_to_logical_path(source_path: darray[u8]&, logical_path: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            return false if source_path.count == 0
            source_start: mutable usize = 0
            if source_path[0] == EDIR_SOURCE_PATH_SLASH:
                source_root: mutable darray[u8] = []
                return false if not env_value("ELISA_EDIR_SOURCE_ROOT", &source_root)
                return false if source_root.count == 0
                root_length: mutable usize = source_root.count
                root_length <- root_length - EDIR_BYTE_WIDTH if root_length > EDIR_BYTE_WIDTH and source_root[root_length - EDIR_BYTE_WIDTH] == EDIR_SOURCE_PATH_SLASH
                return false if root_length > source_path.count
                for index in 0..<root_length |source_path, source_root|:
                    return false if source_path[index] != source_root[index]
                if root_length == EDIR_BYTE_WIDTH and source_root[0] == EDIR_SOURCE_PATH_SLASH:
                    source_start <- root_length
                else:
                    return false if root_length >= source_path.count or source_path[root_length] != EDIR_SOURCE_PATH_SLASH
                    source_start <- root_length + EDIR_BYTE_WIDTH
            while source_path.count - source_start >= EDIR_SOURCE_PATH_PARENT_SEGMENT_LENGTH and source_path[source_start] == EDIR_SOURCE_PATH_DOT and source_path[source_start + EDIR_BYTE_WIDTH] == EDIR_SOURCE_PATH_SLASH:
                source_start <- source_start + EDIR_SOURCE_PATH_PARENT_SEGMENT_LENGTH
            for index in source_start..<source_path.count |logical_path, source_path|:
                logical_path.push(source_path[index])
            return source_path_is_valid(logical_path)



        def source_identity_create(source_identity: mutable EDIRSourceIdentity&, parsed_source: u8&, parsed_source_length: usize) -> bool can[Abort.Panic, Memory.Allocate]:
            source_path: mutable darray[u8] = []
            return false if not env_value("ELISA_STAGE1_SRC", &source_path)
            return false if source_path.count == 0
            logical_path: mutable darray[u8] = []
            return false if not source_path_to_logical_path(source_path, &logical_path)
            terminal_newline: mutable darray[u8] = []
            return false if not env_value("ELISA_STAGE1_EDIR_SOURCE_TERMINAL_NEWLINE", &terminal_newline)
            source_content_length: mutable usize = parsed_source_length
            if terminal_newline.count == EDIR_BYTE_WIDTH and terminal_newline[0] == 48:
                return false if source_content_length == 0 or parsed_source[source_content_length - EDIR_BYTE_WIDTH] != EDIR_NEWLINE_BYTE
                source_content_length <- source_content_length - EDIR_BYTE_WIDTH
            elif terminal_newline.count != EDIR_BYTE_WIDTH or terminal_newline[0] != 49:
                return false
            source_contents: mutable darray[u8] = []
            for index in 0..<source_content_length |source_contents, parsed_source|:
                source_contents.push(parsed_source[index])
            return false if source_contents.count == 0
            source_identity.file_id <- EDIR_ROOT_SOURCE_FILE_ID
            source_identity.logical_path_id <- hash_domain_and_bytes("EDIR logical path:", logical_path)
            source_identity.content_digest <- hash_domain_and_bytes("EDIR source content:", source_contents)
            source_identity.line_count <- EDIR_LINE_COUNT_INCREMENT
            for index in 0..<source_contents.count |source_identity, source_contents|:
                source_identity.line_count <- source_identity.line_count + EDIR_LINE_COUNT_INCREMENT if source_contents[index] == EDIR_NEWLINE_BYTE
            source_identity.path_length <- logical_path.count
            for index in 0..<logical_path.count |source_identity, logical_path|:
                source_identity.path_bytes[index] <- logical_path[index]
            return true



        def append_source_file(buffer: mutable darray[u8]&, source_identity: EDIRSourceIdentity) -> void can[Abort.Panic, Memory.Allocate]:
            append_unsigned_le(buffer, source_identity.file_id, EDIR_U64_WIDTH)
            append_unsigned_le(buffer, source_identity.logical_path_id, EDIR_U64_WIDTH)
            append_unsigned_le(buffer, source_identity.content_digest, EDIR_U64_WIDTH)
            append_unsigned_le(buffer, source_identity.line_count, EDIR_U64_WIDTH)
            append_unsigned_le(buffer, source_identity.path_length.u64(), EDIR_U32_WIDTH)
            for index in 0..<source_identity.path_length:
                buffer.push(source_identity.path_bytes[index])



        def position_is_usable(position: Ast::Pos) -> bool:
            return false if position.end_offset <= position.offset
            return false if position.end_line < position.line
            return false if position.end_line == position.line and position.end_column < position.column
            return true



        def source_span_cover(start_position: Ast::Pos, end_position: Ast::Pos) -> Ast::Pos:
            return Ast::Pos{
                line: start_position.line,
                column: start_position.column,
                offset: start_position.offset,
                end_line: end_position.end_line,
                end_column: end_position.end_column,
                end_offset: end_position.end_offset
            }



        def append_instruction(buffer: mutable darray[u8]&, opcode: u16, operand_a: i64, position: Ast::Pos) -> void can[Abort.Panic, Memory.Allocate]:
            append_unsigned_le(buffer, opcode.u64(), EDIR_U16_WIDTH)
            append_signed_i64_le(buffer, operand_a)
            append_signed_i64_le(buffer, EDIR_NO_OPERAND)
            append_source_span(buffer, position)



        def patch_instruction_operand(buffer: mutable darray[u8]&, instruction_index: usize, operand_a: i64) -> void can[Abort.Panic, Memory.Allocate]:
            operand_offset: usize = instruction_index * EDIR_SERIALIZED_INSTRUCTION_BYTES + EDIR_OPERAND_A_BYTE_OFFSET
            operand_bits: u64 = operand_a.u64()
            for byte_index in 0..<EDIR_U64_WIDTH |buffer, operand_offset, operand_bits|:
                shift: u64 = byte_index.u64() * EDIR_BITS_PER_BYTE
                buffer[operand_offset + byte_index] <- ((operand_bits >> shift) & EDIR_BYTE_MASK).u8()



        def simple_i64_declaration(statement: Ast::Stmt) -> (name: sview, value: i64, declaration_span: Ast::Pos, valid: bool):
            match statement:
                Ast::Stmt.VarDecl(local_name, local_type, initializer, declaration_position):
                    return ("", EDIR_COUNTED_LOOP_INITIAL_VALUE, Ast::Pos{line: EDIR_NO_POSITION_LINE, column: EDIR_NO_POSITION_COLUMN, offset: EDIR_NO_POSITION_OFFSET, end_line: EDIR_NO_POSITION_LINE, end_column: EDIR_NO_POSITION_COLUMN, end_offset: EDIR_NO_POSITION_OFFSET}, false) if local_name == "" or local_name == "_"
                    match local_type:
                        Ast::Expr.Unary(type_operator, bare_type, _):
                            return ("", EDIR_COUNTED_LOOP_INITIAL_VALUE, Ast::Pos{line: EDIR_NO_POSITION_LINE, column: EDIR_NO_POSITION_COLUMN, offset: EDIR_NO_POSITION_OFFSET, end_line: EDIR_NO_POSITION_LINE, end_column: EDIR_NO_POSITION_COLUMN, end_offset: EDIR_NO_POSITION_OFFSET}, false) if type_operator != Lexer::TokenKind.Mutable
                            match bare_type:
                                Ast::Expr.Ident(type_name, _):
                                    return ("", EDIR_COUNTED_LOOP_INITIAL_VALUE, Ast::Pos{line: EDIR_NO_POSITION_LINE, column: EDIR_NO_POSITION_COLUMN, offset: EDIR_NO_POSITION_OFFSET, end_line: EDIR_NO_POSITION_LINE, end_column: EDIR_NO_POSITION_COLUMN, end_offset: EDIR_NO_POSITION_OFFSET}, false) if type_name != "i64"
                                _:
                                    return ("", EDIR_COUNTED_LOOP_INITIAL_VALUE, Ast::Pos{line: EDIR_NO_POSITION_LINE, column: EDIR_NO_POSITION_COLUMN, offset: EDIR_NO_POSITION_OFFSET, end_line: EDIR_NO_POSITION_LINE, end_column: EDIR_NO_POSITION_COLUMN, end_offset: EDIR_NO_POSITION_OFFSET}, false)
                        _:
                            return ("", EDIR_COUNTED_LOOP_INITIAL_VALUE, Ast::Pos{line: EDIR_NO_POSITION_LINE, column: EDIR_NO_POSITION_COLUMN, offset: EDIR_NO_POSITION_OFFSET, end_line: EDIR_NO_POSITION_LINE, end_column: EDIR_NO_POSITION_COLUMN, end_offset: EDIR_NO_POSITION_OFFSET}, false)
                    match initializer:
                        Ast::Expr.IntLit(value, initializer_position):
                            declaration_span: Ast::Pos = source_span_cover(declaration_position, initializer_position)
                            return (local_name, value, declaration_span, position_is_usable(declaration_span))
                        _:
                            return ("", EDIR_COUNTED_LOOP_INITIAL_VALUE, Ast::Pos{line: EDIR_NO_POSITION_LINE, column: EDIR_NO_POSITION_COLUMN, offset: EDIR_NO_POSITION_OFFSET, end_line: EDIR_NO_POSITION_LINE, end_column: EDIR_NO_POSITION_COLUMN, end_offset: EDIR_NO_POSITION_OFFSET}, false)
                _:
                    return ("", EDIR_COUNTED_LOOP_INITIAL_VALUE, Ast::Pos{line: EDIR_NO_POSITION_LINE, column: EDIR_NO_POSITION_COLUMN, offset: EDIR_NO_POSITION_OFFSET, end_line: EDIR_NO_POSITION_LINE, end_column: EDIR_NO_POSITION_COLUMN, end_offset: EDIR_NO_POSITION_OFFSET}, false)



        def simple_i64_increment(statement: Ast::Stmt, expected_name: sview, expected_increment: i64) -> (span: Ast::Pos, valid: bool):
            match statement:
                Ast::Stmt.Assign(target, assignment_operator, value, _):
                    return (Ast::Pos{line: EDIR_NO_POSITION_LINE, column: EDIR_NO_POSITION_COLUMN, offset: EDIR_NO_POSITION_OFFSET, end_line: EDIR_NO_POSITION_LINE, end_column: EDIR_NO_POSITION_COLUMN, end_offset: EDIR_NO_POSITION_OFFSET}, false) if assignment_operator != Lexer::TokenKind.LArrow
                    match target:
                        Ast::Expr.Ident(target_name, target_position):
                            return (Ast::Pos{line: EDIR_NO_POSITION_LINE, column: EDIR_NO_POSITION_COLUMN, offset: EDIR_NO_POSITION_OFFSET, end_line: EDIR_NO_POSITION_LINE, end_column: EDIR_NO_POSITION_COLUMN, end_offset: EDIR_NO_POSITION_OFFSET}, false) if target_name != expected_name or not position_is_usable(target_position)
                            match value:
                                Ast::Expr.Binary(left, operator, right, _):
                                    return (Ast::Pos{line: EDIR_NO_POSITION_LINE, column: EDIR_NO_POSITION_COLUMN, offset: EDIR_NO_POSITION_OFFSET, end_line: EDIR_NO_POSITION_LINE, end_column: EDIR_NO_POSITION_COLUMN, end_offset: EDIR_NO_POSITION_OFFSET}, false) if operator != Lexer::TokenKind.Plus
                                    match left:
                                        Ast::Expr.Ident(left_name, left_position):
                                            return (Ast::Pos{line: EDIR_NO_POSITION_LINE, column: EDIR_NO_POSITION_COLUMN, offset: EDIR_NO_POSITION_OFFSET, end_line: EDIR_NO_POSITION_LINE, end_column: EDIR_NO_POSITION_COLUMN, end_offset: EDIR_NO_POSITION_OFFSET}, false) if left_name != expected_name or not position_is_usable(left_position)
                                        _:
                                            return (Ast::Pos{line: EDIR_NO_POSITION_LINE, column: EDIR_NO_POSITION_COLUMN, offset: EDIR_NO_POSITION_OFFSET, end_line: EDIR_NO_POSITION_LINE, end_column: EDIR_NO_POSITION_COLUMN, end_offset: EDIR_NO_POSITION_OFFSET}, false)
                                    match right:
                                        Ast::Expr.IntLit(increment, right_position):
                                            return (Ast::Pos{line: EDIR_NO_POSITION_LINE, column: EDIR_NO_POSITION_COLUMN, offset: EDIR_NO_POSITION_OFFSET, end_line: EDIR_NO_POSITION_LINE, end_column: EDIR_NO_POSITION_COLUMN, end_offset: EDIR_NO_POSITION_OFFSET}, false) if increment != expected_increment or not position_is_usable(right_position)
                                            assignment_span: Ast::Pos = source_span_cover(target_position, right_position)
                                            return (assignment_span, position_is_usable(assignment_span))
                                        _:
                                            return (Ast::Pos{line: EDIR_NO_POSITION_LINE, column: EDIR_NO_POSITION_COLUMN, offset: EDIR_NO_POSITION_OFFSET, end_line: EDIR_NO_POSITION_LINE, end_column: EDIR_NO_POSITION_COLUMN, end_offset: EDIR_NO_POSITION_OFFSET}, false)
                                _:
                                    return (Ast::Pos{line: EDIR_NO_POSITION_LINE, column: EDIR_NO_POSITION_COLUMN, offset: EDIR_NO_POSITION_OFFSET, end_line: EDIR_NO_POSITION_LINE, end_column: EDIR_NO_POSITION_COLUMN, end_offset: EDIR_NO_POSITION_OFFSET}, false)
                        _:
                            return (Ast::Pos{line: EDIR_NO_POSITION_LINE, column: EDIR_NO_POSITION_COLUMN, offset: EDIR_NO_POSITION_OFFSET, end_line: EDIR_NO_POSITION_LINE, end_column: EDIR_NO_POSITION_COLUMN, end_offset: EDIR_NO_POSITION_OFFSET}, false)
                _:
                    return (Ast::Pos{line: EDIR_NO_POSITION_LINE, column: EDIR_NO_POSITION_COLUMN, offset: EDIR_NO_POSITION_OFFSET, end_line: EDIR_NO_POSITION_LINE, end_column: EDIR_NO_POSITION_COLUMN, end_offset: EDIR_NO_POSITION_OFFSET}, false)



        def counted_loop_artifact(output_path: darray[u8]&, body: darray[Ast::Stmt], source_identity: EDIRSourceIdentity) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            return unsupported("counted-loop lowering requires two initialized `i64` locals, one bounded `while`, and a return") if body.count != EDIR_COUNTED_LOOP_STATEMENT_COUNT

            counter: (name: sview, value: i64, declaration_span: Ast::Pos, valid: bool) = simple_i64_declaration(body[EDIR_COUNTED_LOOP_COUNTER_DECLARATION_INDEX])
            total: (name: sview, value: i64, declaration_span: Ast::Pos, valid: bool) = simple_i64_declaration(body[EDIR_COUNTED_LOOP_TOTAL_DECLARATION_INDEX])
            return unsupported("counted-loop locals must be initialized typed `i64` declarations with usable source spans") if not counter.valid or not total.valid
            return unsupported("counted-loop locals must have distinct names and start at zero") if counter.name == total.name or counter.value != EDIR_COUNTED_LOOP_INITIAL_VALUE or total.value != EDIR_COUNTED_LOOP_INITIAL_VALUE

            loop_condition_position: mutable Ast::Pos = Ast::Pos{line: EDIR_NO_POSITION_LINE, column: EDIR_NO_POSITION_COLUMN, offset: EDIR_NO_POSITION_OFFSET, end_line: EDIR_NO_POSITION_LINE, end_column: EDIR_NO_POSITION_COLUMN, end_offset: EDIR_NO_POSITION_OFFSET}
            loop_limit: mutable i64 = EDIR_COUNTED_LOOP_INITIAL_VALUE
            counter_assignment_span: mutable Ast::Pos = Ast::Pos{line: EDIR_NO_POSITION_LINE, column: EDIR_NO_POSITION_COLUMN, offset: EDIR_NO_POSITION_OFFSET, end_line: EDIR_NO_POSITION_LINE, end_column: EDIR_NO_POSITION_COLUMN, end_offset: EDIR_NO_POSITION_OFFSET}
            total_assignment_span: mutable Ast::Pos = Ast::Pos{line: EDIR_NO_POSITION_LINE, column: EDIR_NO_POSITION_COLUMN, offset: EDIR_NO_POSITION_OFFSET, end_line: EDIR_NO_POSITION_LINE, end_column: EDIR_NO_POSITION_COLUMN, end_offset: EDIR_NO_POSITION_OFFSET}

            match body[EDIR_COUNTED_LOOP_WHILE_STATEMENT_INDEX]:
                Ast::Stmt.While(condition, loop_body, _):
                    return unsupported("counted-loop body must update the total and then the counter") if loop_body.count != EDIR_COUNTED_LOOP_BODY_STATEMENT_COUNT
                    match condition:
                        Ast::Expr.Binary(left, operator, right, condition_position):
                            return unsupported("counted-loop condition must compare the counter with a nonnegative literal using `<`") if operator != Lexer::TokenKind.Lt
                            match left:
                                Ast::Expr.Ident(condition_name, condition_name_position):
                                    return unsupported("counted-loop condition must use the first local as its counter") if condition_name != counter.name or not position_is_usable(condition_name_position)
                                _:
                                    return unsupported("counted-loop condition must use the first local as its counter")
                            match right:
                                Ast::Expr.IntLit(limit, limit_position):
                                    return unsupported("counted-loop limit must be nonnegative and keep the total within `i64`") if limit < EDIR_COUNTED_LOOP_INITIAL_VALUE or limit > EDIR_COUNTED_LOOP_TOTAL_MAX
                                    loop_limit <- limit
                                    return unsupported("counted-loop limit has no usable source span") if not position_is_usable(limit_position)
                                _:
                                    return unsupported("counted-loop limit must be an integer literal")
                            return unsupported("counted-loop condition has no usable source span") if not position_is_usable(condition_position)
                            loop_condition_position <- condition_position
                        _:
                            return unsupported("counted-loop condition must be a local-versus-literal `<` comparison")
                    total_update: (span: Ast::Pos, valid: bool) = simple_i64_increment(loop_body[EDIR_COUNTED_LOOP_TOTAL_UPDATE_INDEX], total.name, EDIR_COUNTED_LOOP_TOTAL_INCREMENT)
                    counter_update: (span: Ast::Pos, valid: bool) = simple_i64_increment(loop_body[EDIR_COUNTED_LOOP_COUNTER_UPDATE_INDEX], counter.name, EDIR_COUNTED_LOOP_COUNTER_INCREMENT)
                    return unsupported("counted-loop body must use `total <- total + 2` and `counter <- counter + 1`") if not total_update.valid or not counter_update.valid
                    total_assignment_span <- total_update.span
                    counter_assignment_span <- counter_update.span
                _:
                    return unsupported("the third statement in counted-loop `main` must be a `while`")

            instructions: mutable darray[u8] = []
            append_instruction(&instructions, EDIR_OPCODE_CONSTANT, counter.value, counter.declaration_span)
            append_instruction(&instructions, EDIR_OPCODE_STORE_LOCAL, EDIR_COUNTED_LOOP_COUNTER_INDEX, counter.declaration_span)
            append_instruction(&instructions, EDIR_OPCODE_CONSTANT, total.value, total.declaration_span)
            append_instruction(&instructions, EDIR_OPCODE_STORE_LOCAL, EDIR_COUNTED_LOOP_TOTAL_INDEX, total.declaration_span)

            loop_start: usize = instructions.count / EDIR_SERIALIZED_INSTRUCTION_BYTES
            append_instruction(&instructions, EDIR_OPCODE_LOAD_LOCAL, EDIR_COUNTED_LOOP_COUNTER_INDEX, loop_condition_position)
            append_instruction(&instructions, EDIR_OPCODE_COMPARE_LESS, loop_limit, loop_condition_position)
            branch_instruction: usize = instructions.count / EDIR_SERIALIZED_INSTRUCTION_BYTES
            append_instruction(&instructions, EDIR_OPCODE_BRANCH_ZERO, EDIR_NO_OPERAND, loop_condition_position)
            append_instruction(&instructions, EDIR_OPCODE_LOAD_LOCAL, EDIR_COUNTED_LOOP_TOTAL_INDEX, total_assignment_span)
            append_instruction(&instructions, EDIR_OPCODE_ADD, EDIR_COUNTED_LOOP_TOTAL_INCREMENT, total_assignment_span)
            append_instruction(&instructions, EDIR_OPCODE_STORE_LOCAL, EDIR_COUNTED_LOOP_TOTAL_INDEX, total_assignment_span)
            append_instruction(&instructions, EDIR_OPCODE_LOAD_LOCAL, EDIR_COUNTED_LOOP_COUNTER_INDEX, counter_assignment_span)
            append_instruction(&instructions, EDIR_OPCODE_ADD, EDIR_COUNTED_LOOP_COUNTER_INCREMENT, counter_assignment_span)
            append_instruction(&instructions, EDIR_OPCODE_STORE_LOCAL, EDIR_COUNTED_LOOP_COUNTER_INDEX, counter_assignment_span)
            append_instruction(&instructions, EDIR_OPCODE_JUMP, loop_start.i64(), loop_condition_position)
            loop_exit: usize = instructions.count / EDIR_SERIALIZED_INSTRUCTION_BYTES

            match body[EDIR_COUNTED_LOOP_RETURN_STATEMENT_INDEX]:
                Ast::Stmt.Return(return_value, return_position):
                    if return_value is returned_expression:
                        match returned_expression:
                            Ast::Expr.Ident(returned_name, returned_position):
                                return unsupported("counted-loop `main` must return its total local") if returned_name != total.name
                                full_return_position: Ast::Pos = source_span_cover(return_position, returned_position)
                                return unsupported("counted-loop return has no usable source span") if not position_is_usable(full_return_position)
                                append_instruction(&instructions, EDIR_OPCODE_LOAD_LOCAL, EDIR_COUNTED_LOOP_TOTAL_INDEX, full_return_position)
                                append_instruction(&instructions, EDIR_OPCODE_RETURN, EDIR_NO_OPERAND, full_return_position)
                            _:
                                return unsupported("counted-loop `main` must return its total local")
                    else:
                        return unsupported("counted-loop `main` must return a value")
                _:
                    return unsupported("the final statement in counted-loop `main` must be a return")

            instruction_count: usize = instructions.count / EDIR_SERIALIZED_INSTRUCTION_BYTES
            return unsupported("counted-loop artifact exceeds the portable EDIR instruction limit") if instruction_count > EDIR_MAX_SERIALIZED_INSTRUCTIONS
            patch_instruction_operand(&instructions, branch_instruction, loop_exit.i64())

            artifact: mutable darray[u8] = []
            append_header(&artifact, instruction_count.u64(), EDIR_COUNTED_LOOP_LOCAL_COUNT, source_identity)
            for instruction_byte in 0..<instructions.count |artifact, instructions|:
                artifact.push(instructions[instruction_byte])
            return write_artifact_or_report(output_path, artifact)



        def binary_opcode(operator: Lexer::TokenKind, supported: mutable bool&) -> u16:
            supported <- true
            return EDIR_OPCODE_ADD if operator == Lexer::TokenKind.Plus
            return EDIR_OPCODE_SUBTRACT if operator == Lexer::TokenKind.Minus
            return EDIR_OPCODE_MULTIPLY if operator == Lexer::TokenKind.Star
            return EDIR_OPCODE_DIVIDE if operator == Lexer::TokenKind.Slash
            supported <- false
            return EDIR_UNSUPPORTED_OPCODE



        def binary_operands_are_safe(opcode: u16, left: i64, right: i64) -> bool:
            return false if left < EDIR_NO_OPERAND or right < EDIR_NO_OPERAND
            if opcode == EDIR_OPCODE_ADD:
                return left <= EDIR_I64_MAX - right
            if opcode == EDIR_OPCODE_SUBTRACT:
                return true
            if opcode == EDIR_OPCODE_MULTIPLY:
                return true if right == EDIR_NO_OPERAND
                return left <= EDIR_I64_MAX / right
            if opcode == EDIR_OPCODE_DIVIDE:
                return right != EDIR_NO_OPERAND
            return false



        def append_header(buffer: mutable darray[u8]&, instruction_count: u64, local_count: u64, source_identity: EDIRSourceIdentity) -> void can[Abort.Panic, Memory.Allocate]:
            append_unsigned_le(buffer, EDIR_CODEC_SCHEMA.u64(), EDIR_U32_WIDTH)
            append_unsigned_le(buffer, EDIR_PROGRAM_VERSION.u64(), EDIR_U32_WIDTH)
            append_unsigned_le(buffer, instruction_count, EDIR_U64_WIDTH)
            append_unsigned_le(buffer, local_count, EDIR_U64_WIDTH)
            buffer.push(EDIR_TRUE)
            append_unsigned_le(buffer, EDIR_SOURCE_FILE_COUNT.u64(), EDIR_U32_WIDTH)
            append_source_file(buffer, source_identity)



        def core_ir_opcode(operator: ElisaCoreIR::I64BinaryOperator) -> u16:
            return EDIR_OPCODE_ADD if operator == ElisaCoreIR::I64BinaryOperator.Add
            return EDIR_OPCODE_SUBTRACT if operator == ElisaCoreIR::I64BinaryOperator.Subtract
            return EDIR_OPCODE_MULTIPLY if operator == ElisaCoreIR::I64BinaryOperator.Multiply
            return EDIR_OPCODE_DIVIDE


        def core_ir_artifact(output_path: darray[u8]&, program: ElisaCoreIR::Program, source_identity: EDIRSourceIdentity) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            artifact: mutable darray[u8] = []
            if program.has_local:
                return unsupported("the local declaration has no usable source span") if not position_is_usable(program.local_declaration_position)
                return unsupported("the local initializer has no usable source span") if not position_is_usable(program.local_initializer_position)
                local_declaration_span: Ast::Pos = source_span_cover(program.local_declaration_position, program.local_initializer_position)
                return unsupported("the local declaration has no usable source span") if not position_is_usable(local_declaration_span)
                return unsupported("the returned local has no usable source span") if not position_is_usable(program.left_position)
                return unsupported("the return statement has no usable source span") if not position_is_usable(program.return_position)
                if program.has_binary_operator:
                    return unsupported("arithmetic may overflow or divide by zero in the managed engine") if not ElisaCoreIR::scalar_expression_is_defined(program)
                    return unsupported("the right literal has no usable source span") if not position_is_usable(program.right_position)
                    return unsupported("the arithmetic expression has no usable source span") if not position_is_usable(program.expression_position)
                    append_header(&artifact, EDIR_LOCAL_BINARY_INSTRUCTION_COUNT, EDIR_SINGLE_LOCAL_COUNT, source_identity)
                    append_instruction(&artifact, EDIR_OPCODE_CONSTANT, program.local_value, program.local_initializer_position)
                    append_instruction(&artifact, EDIR_OPCODE_STORE_LOCAL, EDIR_SINGLE_LOCAL_INDEX, local_declaration_span)
                    append_instruction(&artifact, EDIR_OPCODE_LOAD_LOCAL, EDIR_SINGLE_LOCAL_INDEX, program.left_position)
                    append_instruction(&artifact, core_ir_opcode(program.operator), program.right, program.expression_position)
                    append_instruction(&artifact, EDIR_OPCODE_RETURN, EDIR_NO_OPERAND, program.return_position)
                    return write_artifact_or_report(output_path, artifact)
                append_header(&artifact, EDIR_LOCAL_INSTRUCTION_COUNT, EDIR_SINGLE_LOCAL_COUNT, source_identity)
                append_instruction(&artifact, EDIR_OPCODE_CONSTANT, program.local_value, program.local_initializer_position)
                append_instruction(&artifact, EDIR_OPCODE_STORE_LOCAL, EDIR_SINGLE_LOCAL_INDEX, local_declaration_span)
                append_instruction(&artifact, EDIR_OPCODE_LOAD_LOCAL, EDIR_SINGLE_LOCAL_INDEX, program.left_position)
                append_instruction(&artifact, EDIR_OPCODE_RETURN, EDIR_NO_OPERAND, program.return_position)
                return write_artifact_or_report(output_path, artifact)
            if not program.has_binary_operator:
                return unsupported("the literal has no usable source span") if not position_is_usable(program.left_position)
                return unsupported("the return statement has no usable source span") if not position_is_usable(program.return_position)
                append_header(&artifact, EDIR_LITERAL_INSTRUCTION_COUNT, EDIR_NO_LOCALS, source_identity)
                append_instruction(&artifact, EDIR_OPCODE_CONSTANT, program.left, program.left_position)
                append_instruction(&artifact, EDIR_OPCODE_RETURN, EDIR_NO_OPERAND, program.return_position)
                return write_artifact_or_report(output_path, artifact)
            return unsupported("arithmetic may overflow or divide by zero in the managed engine") if not ElisaCoreIR::scalar_expression_is_defined(program)
            return unsupported("the left literal has no usable source span") if not position_is_usable(program.left_position)
            return unsupported("the right literal has no usable source span") if not position_is_usable(program.right_position)
            return unsupported("the arithmetic expression has no usable source span") if not position_is_usable(program.expression_position)
            return unsupported("the return statement has no usable source span") if not position_is_usable(program.return_position)
            append_header(&artifact, EDIR_BINARY_INSTRUCTION_COUNT, EDIR_NO_LOCALS, source_identity)
            append_instruction(&artifact, EDIR_OPCODE_CONSTANT, program.left, program.left_position)
            append_instruction(&artifact, core_ir_opcode(program.operator), program.right, program.expression_position)
            append_instruction(&artifact, EDIR_OPCODE_RETURN, EDIR_NO_OPERAND, program.return_position)
            return write_artifact_or_report(output_path, artifact)



        def local_return_artifact(output_path: darray[u8]&, local_name: sview, local_value: i64, declaration_position: Ast::Pos, initializer_position: Ast::Pos, returned_expression: Ast::Expr, return_position: Ast::Pos, source_identity: EDIRSourceIdentity) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            return unsupported("the local declaration has no usable source span") if not position_is_usable(declaration_position)
            return unsupported("the local initializer has no usable source span") if not position_is_usable(initializer_position)
            full_declaration_position: Ast::Pos = source_span_cover(declaration_position, initializer_position)
            return unsupported("the local declaration has no usable source span") if not position_is_usable(full_declaration_position)

            match returned_expression:
                Ast::Expr.Ident(returned_name, returned_position):
                    return unsupported("the return identifier must name the initialized local") if returned_name != local_name
                    return unsupported("the returned local has no usable source span") if not position_is_usable(returned_position)
                    statement_position: Ast::Pos = source_span_cover(return_position, returned_position)
                    return unsupported("the return statement has no usable source span") if not position_is_usable(statement_position)
                    artifact: mutable darray[u8] = []
                    append_header(&artifact, EDIR_LOCAL_INSTRUCTION_COUNT, EDIR_SINGLE_LOCAL_COUNT, source_identity)
                    append_instruction(&artifact, EDIR_OPCODE_CONSTANT, local_value, initializer_position)
                    append_instruction(&artifact, EDIR_OPCODE_STORE_LOCAL, EDIR_SINGLE_LOCAL_INDEX, full_declaration_position)
                    append_instruction(&artifact, EDIR_OPCODE_LOAD_LOCAL, EDIR_SINGLE_LOCAL_INDEX, returned_position)
                    append_instruction(&artifact, EDIR_OPCODE_RETURN, EDIR_NO_OPERAND, statement_position)
                    return write_artifact_or_report(output_path, artifact)
                Ast::Expr.Binary(left, operator, right, _):
                    supported_operator: mutable bool = false
                    opcode: u16 = binary_opcode(operator, &supported_operator)
                    return unsupported("the return arithmetic operator must be `+`, `-`, `*`, or `/`") if not supported_operator
                    match left:
                        Ast::Expr.Ident(left_name, left_position):
                            return unsupported("the left return operand must name the initialized local") if left_name != local_name
                            return unsupported("the local arithmetic operand has no usable source span") if not position_is_usable(left_position)
                            match right:
                                Ast::Expr.IntLit(right_value, right_position):
                                    return unsupported("the right arithmetic literal has no usable source span") if not position_is_usable(right_position)
                                    expression_position: Ast::Pos = source_span_cover(left_position, right_position)
                                    return unsupported("the return arithmetic expression has no usable source span") if not position_is_usable(expression_position)
                                    statement_position: Ast::Pos = source_span_cover(return_position, right_position)
                                    return unsupported("the return statement has no usable source span") if not position_is_usable(statement_position)
                                    return unsupported("arithmetic may overflow or divide by zero in the managed engine") if not binary_operands_are_safe(opcode, local_value, right_value)
                                    artifact: mutable darray[u8] = []
                                    append_header(&artifact, EDIR_LOCAL_BINARY_INSTRUCTION_COUNT, EDIR_SINGLE_LOCAL_COUNT, source_identity)
                                    append_instruction(&artifact, EDIR_OPCODE_CONSTANT, local_value, initializer_position)
                                    append_instruction(&artifact, EDIR_OPCODE_STORE_LOCAL, EDIR_SINGLE_LOCAL_INDEX, full_declaration_position)
                                    append_instruction(&artifact, EDIR_OPCODE_LOAD_LOCAL, EDIR_SINGLE_LOCAL_INDEX, left_position)
                                    append_instruction(&artifact, opcode, right_value, expression_position)
                                    append_instruction(&artifact, EDIR_OPCODE_RETURN, EDIR_NO_OPERAND, statement_position)
                                    return write_artifact_or_report(output_path, artifact)
                                _:
                                    return unsupported("the right operand of local arithmetic must be an integer literal")
                        _:
                            return unsupported("the left operand of return arithmetic must be the initialized local")
                _:
                    return unsupported("`main` must return the initialized local or use it as the left operand of supported integer-literal arithmetic")



        def root_source_map_is_single_file() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            line_map: mutable darray[u8] = []
            return false if not env_value("ELISA_STAGE1_LINE_MAP", &line_map)
            entries: mutable usize = 0
            for line_map_byte in line_map |entries, line_map|:
                entries <- entries + EDIR_BYTE_WIDTH if line_map_byte == EDIR_NEWLINE_BYTE
            return entries == EDIR_SOURCE_MAP_ENTRY_COUNT



        def write_all(descriptor: i64, bytes: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            return false if bytes.count == 0
            offset: mutable usize = 0
            while offset < bytes.count |offset, bytes|:
                chunk: void& = (&bytes[offset]).cast[void&] can Unsafe.PointerCast
                written: isize = write(descriptor, chunk, bytes.count - offset) can Console, Unsafe.PointerCast
                return false if written <= EDIR_WRITE_NO_PROGRESS
                return false if written.usize() > bytes.count - offset
                offset <- offset + written.usize()
            return true



    public:
        def prepare_output(output_path: darray[u8]&) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            return EDIR_STATUS_FAILURE if output_path.count <= EDIR_BYTE_WIDTH
            return EDIR_STATUS_FAILURE if output_path[output_path.count - EDIR_BYTE_WIDTH] != EDIR_NUL_BYTE
            path: cstr = (&output_path[0]).cast[cstr] can Unsafe.PointerCast
            descriptor: i64 = open(path, EDIR_OPEN_WRITE_CREATE_TRUNCATE, EDIR_OUTPUT_FILE_MODE) can Blocking.IO, Unsafe.PointerCast
            if descriptor == EDIR_OUTPUT_DESCRIPTOR_FAILURE:
                output_error: mutable darray[u8] = ProjectSystem::bytes_from_view("error: -emit edir could not open or truncate the requested -o path\n")
                write_stderr(output_error)
                return EDIR_STATUS_FAILURE
            close_result: i64 = close(descriptor) can Blocking.IO, Unsafe.PointerCast
            if close_result < EDIR_SYSCALL_ERROR_THRESHOLD:
                close_error: mutable darray[u8] = ProjectSystem::bytes_from_view("error: -emit edir could not close the prepared -o path\n")
                write_stderr(close_error)
                return EDIR_STATUS_FAILURE
            return EDIR_STATUS_SUCCESS



    private:
        def write_artifact(output_path: darray[u8]&, bytes: darray[u8]&) -> bool can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            return false if output_path.count <= EDIR_BYTE_WIDTH
            return false if output_path[output_path.count - EDIR_BYTE_WIDTH] != EDIR_NUL_BYTE
            path: cstr = (&output_path[0]).cast[cstr] can Unsafe.PointerCast
            descriptor: i64 = open(path, EDIR_OPEN_WRITE_CREATE_TRUNCATE, EDIR_OUTPUT_FILE_MODE) can Blocking.IO, Unsafe.PointerCast
            return false if descriptor == EDIR_OUTPUT_DESCRIPTOR_FAILURE
            wrote_all: bool = write_all(descriptor, bytes) can Blocking.IO, Unsafe.PointerCast
            close_result: i64 = close(descriptor) can Blocking.IO, Unsafe.PointerCast
            return false if not wrote_all or close_result < EDIR_SYSCALL_ERROR_THRESHOLD
            return true



        def write_artifact_or_report(output_path: darray[u8]&, bytes: darray[u8]&) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            wrote_artifact: bool = write_artifact(output_path, bytes) can Blocking.IO, Unsafe.PointerCast
            return EDIR_STATUS_SUCCESS if wrote_artifact
            artifact_error: mutable darray[u8] = []
            emit_tokens_push_sview(&artifact_error, "error: -emit edir could not write the complete artifact to the requested -o path\n")
            write_stderr(artifact_error)
            return EDIR_STATUS_FAILURE

    public:
        def emit(file: Ast::File&, output_path: darray[u8]&, static_generation_expanded: bool, parsed_source: u8&, parsed_source_length: usize) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            return unsupported("static-generate source mapping is not supported yet") if static_generation_expanded
            return unsupported("include-expanded source mapping is not supported yet") if not root_source_map_is_single_file()
            return unsupported("an explicit `-o` output path is required") if output_path.count <= EDIR_BYTE_WIDTH
            source_identity: mutable EDIRSourceIdentity = zeroed
            return unsupported("source path or parsed source identity is invalid; relative paths are required unless ELISA_EDIR_SOURCE_ROOT is set") if not source_identity_create(&source_identity, parsed_source, parsed_source_length)
            return unsupported("the file must contain exactly one top-level declaration") if file.top_decls.count != EDIR_TOP_LEVEL_DECLARATION_COUNT
            if ElisaCoreIR::lower_main(file) is core_program:
                return core_ir_artifact(output_path, core_program, source_identity)

            match file.top_decls[0]:
                Ast::Decl.Func(function_name, parameters, return_type, body, effects, decorators, function_position):
                    return unsupported("the only function must be named `main`") if function_name != "main"
                    return unsupported("`main` must have no parameters") if parameters.count != EDIR_PARAMETER_COUNT
                    if return_type is declared_type_expression:
                        match declared_type_expression:
                            Ast::Expr.Ident(type_name, type_position):
                                return unsupported("`main` must have an explicit `i64` return type") if type_name != "i64"
                            _:
                                return unsupported("`main` must have an explicit `i64` return type")
                    else:
                        return unsupported("`main` must have an explicit `i64` return type")
                    return unsupported("function effects are not supported in this slice") if effects.count != 0
                    return unsupported("function decorators are not supported in this slice") if decorators.count != 0
                    if body.count == EDIR_COUNTED_LOOP_STATEMENT_COUNT:
                        return counted_loop_artifact(output_path, body, source_identity)
                    return unsupported("`main` must contain one return, one typed local followed by return, or one supported counted loop") if body.count != EDIR_STATEMENT_COUNT and body.count != EDIR_LOCAL_STATEMENT_COUNT
                    if body.count == EDIR_STATEMENT_COUNT:
                        match body[0]:
                            Ast::Stmt.Return(return_value, return_position):
                                if return_value is returned_expression:
                                    match returned_expression:
                                        Ast::Expr.IntLit(literal_value, literal_position):
                                            return unsupported("the shared i64 lowering declined a supported literal return")
                                        Ast::Expr.Binary(left, operator, right, _):
                                            supported_operator: mutable bool = false
                                            _opcode: u16 = binary_opcode(operator, &supported_operator)
                                            return unsupported("the return arithmetic operator must be `+`, `-`, `*`, or `/`") if not supported_operator
                                            match left:
                                                Ast::Expr.IntLit(_left_value, _left_position):
                                                    match right:
                                                        Ast::Expr.IntLit(_right_value, _right_position):
                                                            return unsupported("the shared i64 lowering declined supported literal arithmetic")
                                                        _:
                                                            return unsupported("both operands of return arithmetic must be integer literals")
                                                _:
                                                    return unsupported("both operands of return arithmetic must be integer literals")
                                        _:
                                            return unsupported("`main` must return an integer literal or a supported integer-literal arithmetic expression")
                                else:
                                    return unsupported("`main` must return an integer literal or a supported integer-literal arithmetic expression")
                            _:
                                return unsupported("the single statement in `main` must be a return")
                    match body[0]:
                        Ast::Stmt.VarDecl(local_name, local_type, local_initializer, declaration_position):
                            return unsupported("the local name must be a named identifier") if local_name == "" or local_name == "_"
                            match local_type:
                                Ast::Expr.Ident(local_type_name, _):
                                    return unsupported("the local must have an explicit `i64` type") if local_type_name != "i64"
                                _:
                                    return unsupported("the local must have an explicit `i64` type")
                            match local_initializer:
                                Ast::Expr.IntLit(local_value, initializer_position):
                                    match body[1]:
                                        Ast::Stmt.Return(return_value, return_position):
                                            if return_value is returned_expression:
                                                return local_return_artifact(output_path, local_name, local_value, declaration_position, initializer_position, returned_expression, return_position, source_identity)
                                            else:
                                                return unsupported("the second statement in `main` must return the initialized local")
                                        _:
                                            return unsupported("the second statement in `main` must be a return")
                                _:
                                    return unsupported("the local initializer must be an integer literal")
                        _:
                            return unsupported("the first statement in `main` must be one typed local declaration")
                _:
                    return unsupported("the only top-level declaration must be `def main`")
