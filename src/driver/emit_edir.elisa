# deliberately bounded pure-integer shapes and emits the debugger's portable EDIR schema-3 artifact with
# exact source identity for one original source file.

module ElisaEDIR:
    private:
        const module Schema:
            CODEC_VERSION: u32 = 3
            PROGRAM_VERSION: u32 = 1

        const module Source:
            ROOT_FILE_ID: u64 = 1
            FILE_COUNT: u32 = 1
            LINE_COUNT_INCREMENT: u64 = 1

        const module SourcePath:
            CAPACITY: usize = 1024
            FIRST_BYTE_INDEX: usize = 0
            ASCII_MAX: u64 = 127
            UTF8_CONTINUATION_BASE: u64 = 128
            UTF8_CONTINUATION_MAX: u64 = 191
            UTF8_CONTINUATION_MASK: u64 = 63
            UTF8_SHIFT: u64 = 6
            UTF8_FIRST_TWO_MASK: u64 = 31
            UTF8_FIRST_THREE_MASK: u64 = 15
            UTF8_FIRST_FOUR_MASK: u64 = 7
            UTF8_TWO_BYTE_START: u64 = 194
            UTF8_TWO_BYTE_END: u64 = 223
            UTF8_THREE_BYTE_START: u64 = 224
            UTF8_THREE_BYTE_END: u64 = 239
            UTF8_FOUR_BYTE_START: u64 = 240
            UTF8_FOUR_BYTE_END: u64 = 244
            UTF8_TWO_BYTE_MIN: u64 = 128
            UTF8_THREE_BYTE_MIN: u64 = 2048
            UTF8_FOUR_BYTE_MIN: u64 = 65536
            UNICODE_MAX: u64 = 1114111
            SURROGATE_START: u64 = 55296
            SURROGATE_END: u64 = 57343
            ASCII_CONTROL_MAX: u64 = 31
            DELETE: u64 = 127
            C1_CONTROL_MAX: u64 = 159
            SLASH: u8 = 47
            BACKSLASH: u8 = 92
            COLON: u8 = 58
            DOT: u8 = 46
            UPPER_A: u8 = 65
            UPPER_Z: u8 = 90
            LOWER_A: u8 = 97
            LOWER_Z: u8 = 122
            SINGLE_DOT_LENGTH: usize = 1
            PARENT_SEGMENT_LENGTH: usize = 2

        const module Hash:
            OFFSET_BASIS: u64 = 14695981039346656037
            PRIME: u64 = 1099511628211
            NONZERO_FALLBACK: u64 = 1

        const module Integer:
            ZERO: i64 = 0
            I64_MAX: i64 = 9223372036854775807

        const module CountedLoop:
            LOCAL_COUNT: u64 = 2
            COUNTER_INDEX: i64 = 0
            TOTAL_INDEX: i64 = 1
            STATEMENT_COUNT: usize = 4
            BODY_STATEMENT_COUNT: usize = 2
            COUNTER_DECLARATION_INDEX: usize = 0
            TOTAL_DECLARATION_INDEX: usize = 1
            WHILE_STATEMENT_INDEX: usize = 2
            RETURN_STATEMENT_INDEX: usize = 3
            TOTAL_UPDATE_INDEX: usize = 0
            COUNTER_UPDATE_INDEX: usize = 1
            INITIAL_VALUE: i64 = 0
            TOTAL_INCREMENT: i64 = 2
            COUNTER_INCREMENT: i64 = 1
            TOTAL_MAX: i64 = Integer::I64_MAX / CountedLoop::TOTAL_INCREMENT

        const module Instruction:
            LITERAL_COUNT: u64 = 2
            BINARY_COUNT: u64 = 3
            LOCAL_COUNT: u64 = 4
            LOCAL_BINARY_COUNT: u64 = 5
            MAX_COUNT: usize = 128
            UNSUPPORTED_OPCODE: u16 = 0
            CONSTANT_OPCODE: u16 = 1
            ADD_OPCODE: u16 = 2
            SUBTRACT_OPCODE: u16 = 3
            LOAD_LOCAL_OPCODE: u16 = 4
            STORE_LOCAL_OPCODE: u16 = 5
            MULTIPLY_OPCODE: u16 = 11
            DIVIDE_OPCODE: u16 = 12
            COMPARE_EQUAL_OPCODE: u16 = 14
            COMPARE_LESS_OPCODE: u16 = 15
            JUMP_OPCODE: u16 = 16
            BRANCH_ZERO_OPCODE: u16 = 17
            CALL_OPCODE: u16 = 18
            RETURN_OPCODE: u16 = 19

        const module Function:
            MAIN_NAME: sview = "main"
            NO_ID: u64 = 0
            SINGLE_DESCRIPTOR_COUNT: u64 = 1
            ONLY_PARAMETER_INDEX: usize = 0
            ONLY_ARGUMENT_INDEX: usize = 0
            ENTRY_INSTRUCTION_INDEX: usize = 0
            MAX_COUNT: usize = 64
            MAX_NAME_BYTES: usize = 128
            MAX_CALL_DEPTH: i64 = 16
            MAIN_PARAMETER_COUNT: usize = 0
            HELPER_PARAMETER_COUNT: usize = 1
            MAX_LOCAL_COUNT: u64 = 1

        const module Shape:
            FIRST_TOP_LEVEL_DECLARATION_INDEX: usize = 0
            FIRST_STATEMENT_INDEX: usize = 0
            SECOND_STATEMENT_INDEX: usize = 1
            LAST_ITEM_INDEX_OFFSET: usize = 1
            NO_POSITION_LINE: u32 = 0
            NO_POSITION_COLUMN: u32 = 0
            NO_POSITION_OFFSET: u32 = 0
            NO_OPERAND: i64 = 0
            NO_LOCALS: u64 = 0
            SINGLE_LOCAL_COUNT: u64 = 1
            SINGLE_LOCAL_INDEX: i64 = 0
            TOP_LEVEL_DECLARATION_COUNT: usize = 1
            STATEMENT_COUNT: usize = 1
            LOCAL_STATEMENT_COUNT: usize = 2
            SOURCE_MAP_ENTRY_COUNT: usize = 1
            SOURCE_DISCRIMINATOR: u32 = 0
            PARAMETER_COUNT: usize = 0

        const module Status:
            SUCCESS: i64 = 0
            FAILURE: i64 = 1
            SYSCALL_ERROR_THRESHOLD: i64 = 0

        const module Encoding:
            TRUE: u8 = 1
            NUL_BYTE: u8 = 0
            NEWLINE_BYTE: u8 = 10
            TERMINAL_NEWLINE_DISABLED_FLAG: u8 = 48
            TERMINAL_NEWLINE_ENABLED_FLAG: u8 = 49

        const module Binary:
            BYTE_WIDTH: usize = 1
            U16_WIDTH: usize = 2
            U32_WIDTH: usize = 4
            U64_WIDTH: usize = 8
            BITS_PER_BYTE: u64 = 8
            BYTE_MASK: u64 = 255
            SOURCE_SPAN_U64_FIELDS: usize = 3
            SOURCE_SPAN_U32_FIELDS: usize = 5
            INSTRUCTION_OPERAND_COUNT: usize = 2
            SOURCE_SPAN_BYTES: usize = Binary::U64_WIDTH * Binary::SOURCE_SPAN_U64_FIELDS + Binary::U32_WIDTH * Binary::SOURCE_SPAN_U32_FIELDS
            INSTRUCTION_BYTES: usize = Binary::U16_WIDTH + Binary::U64_WIDTH * Binary::INSTRUCTION_OPERAND_COUNT + Binary::SOURCE_SPAN_BYTES
            OPERAND_A_BYTE_OFFSET: usize = Binary::U16_WIDTH

        static if ELISA_TARGET_OS_LINUX:
            const module FileSystemOpen:
                OPEN_WRITE_CREATE_TRUNCATE: i64 = 577
        static else:
            const module FileSystemOpen:
                OPEN_WRITE_CREATE_TRUNCATE: i64 = 1537

        const module FileSystem:
            OUTPUT_FILE_MODE: i64 = 420
            OUTPUT_DESCRIPTOR_FAILURE: i64 = -1
            WRITE_NO_PROGRESS: isize = 0

        struct EDIRSourceIdentity:
            file_id: mutable u64
            logical_path_id: mutable u64
            content_digest: mutable u64
            line_count: mutable u64
            path_bytes: mutable u8[SourcePath::CAPACITY]
            path_length: mutable usize

        struct EDIRFunctionPlan:
            name: sview
            parameter_name: sview
            body: darray[Ast::Stmt]
            source: Ast::Pos
            entry_instruction: usize
            end_instruction_exclusive: usize
            function_id: u64

        struct EDIRCallFixup:
            instruction_index: usize
            function_name: sview

        def unsupported(reason: sview) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            message: mutable darray[u8] = []
            emit_tokens_push_sview(&message, "error: -emit edir supports bounded pure `i64` functions, direct calls, conditional returns, arithmetic, and the existing counted-loop form: ")
            message.extend(reason)
            message.push(Encoding::NEWLINE_BYTE)
            write_stderr(message)
            return Status::FAILURE



        def append_unsigned_le(buffer: mutable darray[u8]&, value: u64, width: usize) -> void can[Abort.Panic, Memory.Allocate]:
            for byte_index in 0..<width |buffer, value, width|:
                shift: u64 = byte_index.u64() * Binary::BITS_PER_BYTE
                buffer.push(((value >> shift) & Binary::BYTE_MASK).u8())



        def append_signed_i64_le(buffer: mutable darray[u8]&, value: i64) -> void can[Abort.Panic, Memory.Allocate]:
            append_unsigned_le(buffer, value.u64(), Binary::U64_WIDTH)



        def append_source_span(buffer: mutable darray[u8]&, position: Ast::Pos) -> void can[Abort.Panic, Memory.Allocate]:
            append_unsigned_le(buffer, Source::ROOT_FILE_ID, Binary::U64_WIDTH)
            append_unsigned_le(buffer, position.offset.u64(), Binary::U64_WIDTH)
            append_unsigned_le(buffer, position.end_offset.u64(), Binary::U64_WIDTH)
            append_unsigned_le(buffer, position.line.u64(), Binary::U32_WIDTH)
            append_unsigned_le(buffer, position.column.u64(), Binary::U32_WIDTH)
            append_unsigned_le(buffer, position.end_line.u64(), Binary::U32_WIDTH)
            append_unsigned_le(buffer, position.end_column.u64(), Binary::U32_WIDTH)
            append_unsigned_le(buffer, Shape::SOURCE_DISCRIMINATOR.u64(), Binary::U32_WIDTH)



        def hash_byte(hash: u64, byte: u8) -> u64:
            return (hash ^ byte.u64()) * Hash::PRIME



        def hash_domain_and_bytes(domain: sview, bytes: darray[u8]&) -> u64 can[Abort.Panic]:
            hash: mutable u64 = Hash::OFFSET_BASIS
            for index in 0..<sview_len(domain) |hash, domain|:
                hash <- hash_byte(hash, sview_at(domain, index))
            for index in 0..<bytes.count |hash, bytes|:
                hash <- hash_byte(hash, bytes[index])
            return Hash::NONZERO_FALLBACK if hash == 0
            return hash



        def source_path_utf8_is_valid(bytes: darray[u8]&) -> bool:
            index: mutable usize = 0
            while index < bytes.count |index, bytes|:
                first: u64 = bytes[index].u64()
            sequence_length: mutable usize = Binary::BYTE_WIDTH
                minimum_codepoint: mutable u64 = 0
                codepoint: mutable u64 = first
                if first > SourcePath::ASCII_MAX:
                    if first >= SourcePath::UTF8_TWO_BYTE_START and first <= SourcePath::UTF8_TWO_BYTE_END:
                        sequence_length <- 2
                        minimum_codepoint <- SourcePath::UTF8_TWO_BYTE_MIN
                        codepoint <- first & SourcePath::UTF8_FIRST_TWO_MASK
                    if first >= SourcePath::UTF8_THREE_BYTE_START and first <= SourcePath::UTF8_THREE_BYTE_END:
                        sequence_length <- 3
                        minimum_codepoint <- SourcePath::UTF8_THREE_BYTE_MIN
                        codepoint <- first & SourcePath::UTF8_FIRST_THREE_MASK
                    if first >= SourcePath::UTF8_FOUR_BYTE_START and first <= SourcePath::UTF8_FOUR_BYTE_END:
                        sequence_length <- 4
                        minimum_codepoint <- SourcePath::UTF8_FOUR_BYTE_MIN
                        codepoint <- first & SourcePath::UTF8_FIRST_FOUR_MASK
                    return false if sequence_length == Binary::BYTE_WIDTH or sequence_length > bytes.count - index
                    for continuation_index in Binary::BYTE_WIDTH..<sequence_length |bytes, codepoint|:
                        continuation: u64 = bytes[index + continuation_index].u64()
                        return false if continuation < SourcePath::UTF8_CONTINUATION_BASE or continuation > SourcePath::UTF8_CONTINUATION_MAX
                        codepoint <- (codepoint << SourcePath::UTF8_SHIFT) | (continuation & SourcePath::UTF8_CONTINUATION_MASK)
                    return false if codepoint < minimum_codepoint or codepoint > SourcePath::UNICODE_MAX
                    return false if codepoint >= SourcePath::SURROGATE_START and codepoint <= SourcePath::SURROGATE_END
                return false if codepoint <= SourcePath::ASCII_CONTROL_MAX or codepoint >= SourcePath::DELETE and codepoint <= SourcePath::C1_CONTROL_MAX
                index <- index + sequence_length
            return true



        def source_path_has_drive_prefix(bytes: darray[u8]&) -> bool:
            return false if bytes.count <= SourcePath::SINGLE_DOT_LENGTH
            return false if bytes[SourcePath::SINGLE_DOT_LENGTH] != SourcePath::COLON
            first: u8 = bytes[SourcePath::FIRST_BYTE_INDEX]
            return first >= SourcePath::UPPER_A and first <= SourcePath::UPPER_Z or first >= SourcePath::LOWER_A and first <= SourcePath::LOWER_Z



        def source_path_is_valid(bytes: darray[u8]&) -> bool:
            return false if bytes.count == 0 or bytes.count > SourcePath::CAPACITY
            return false if bytes[SourcePath::FIRST_BYTE_INDEX] == SourcePath::SLASH or bytes[bytes.count - Shape::LAST_ITEM_INDEX_OFFSET] == SourcePath::SLASH
            return false if not source_path_utf8_is_valid(bytes)
            return false if source_path_has_drive_prefix(bytes)
            segment_start: mutable usize = 0
            for index in 0..<bytes.count |bytes, segment_start|:
                byte: u8 = bytes[index]
                return false if byte == SourcePath::BACKSLASH
                if byte == SourcePath::SLASH:
                    segment_length: usize = index - segment_start
                    return false if segment_length == 0
                    return false if segment_length == SourcePath::SINGLE_DOT_LENGTH and bytes[segment_start] == SourcePath::DOT
                    return false if segment_length == SourcePath::PARENT_SEGMENT_LENGTH and bytes[segment_start] == SourcePath::DOT and bytes[segment_start + Binary::BYTE_WIDTH] == SourcePath::DOT
                    segment_start <- index + Binary::BYTE_WIDTH
            final_segment_length: usize = bytes.count - segment_start
            return false if final_segment_length == 0
            return false if final_segment_length == SourcePath::SINGLE_DOT_LENGTH and bytes[segment_start] == SourcePath::DOT
            return false if final_segment_length == SourcePath::PARENT_SEGMENT_LENGTH and bytes[segment_start] == SourcePath::DOT and bytes[segment_start + Binary::BYTE_WIDTH] == SourcePath::DOT
            return true



        def source_path_to_logical_path(source_path: darray[u8]&, logical_path: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            return false if source_path.count == 0
            source_start: mutable usize = 0
            if source_path[SourcePath::FIRST_BYTE_INDEX] == SourcePath::SLASH:
                source_root: mutable darray[u8] = []
                return false if not env_value("ELISA_EDIR_SOURCE_ROOT", &source_root)
                return false if source_root.count == 0
                root_length: mutable usize = source_root.count
                root_length <- root_length - Binary::BYTE_WIDTH if root_length > Binary::BYTE_WIDTH and source_root[root_length - Binary::BYTE_WIDTH] == SourcePath::SLASH
                return false if root_length > source_path.count
                for index in 0..<root_length |source_path, source_root|:
                    return false if source_path[index] != source_root[index]
                if root_length == Binary::BYTE_WIDTH and source_root[SourcePath::FIRST_BYTE_INDEX] == SourcePath::SLASH:
                    source_start <- root_length
                else:
                    return false if root_length >= source_path.count or source_path[root_length] != SourcePath::SLASH
                    source_start <- root_length + Binary::BYTE_WIDTH
            while source_path.count - source_start >= SourcePath::PARENT_SEGMENT_LENGTH and source_path[source_start] == SourcePath::DOT and source_path[source_start + Binary::BYTE_WIDTH] == SourcePath::SLASH:
                source_start <- source_start + SourcePath::PARENT_SEGMENT_LENGTH
            for index in source_start..<source_path.count |logical_path, source_path|:
                logical_path.push(source_path[index])
            return source_path_is_valid(logical_path)



        def source_identity_create(source_identity: mutable EDIRSourceIdentity&, parsed_source: u8&, parsed_source_length: usize) -> bool can[Abort.Panic, Memory.Allocate]:
            source_path: mutable darray[u8] = []
            return false if not env_value("ELISA_STAGE1_SRC", &source_path)
            return false if source_path.count == 0
            logical_path: mutable darray[u8] = []
            return false if not source_path_to_logical_path(source_path, &logical_path)
            terminal_newline: mutable darray[u8] = []
            return false if not env_value("ELISA_STAGE1_EDIR_SOURCE_TERMINAL_NEWLINE", &terminal_newline)
            source_content_length: mutable usize = parsed_source_length
            if terminal_newline.count == Binary::BYTE_WIDTH and terminal_newline[SourcePath::FIRST_BYTE_INDEX] == Encoding::TERMINAL_NEWLINE_DISABLED_FLAG:
                return false if source_content_length == 0 or parsed_source[source_content_length - Shape::LAST_ITEM_INDEX_OFFSET] != Encoding::NEWLINE_BYTE
                source_content_length <- source_content_length - Binary::BYTE_WIDTH
            elif terminal_newline.count != Binary::BYTE_WIDTH or terminal_newline[SourcePath::FIRST_BYTE_INDEX] != Encoding::TERMINAL_NEWLINE_ENABLED_FLAG:
                return false
            source_contents: mutable darray[u8] = []
            for index in 0..<source_content_length |source_contents, parsed_source|:
                source_contents.push(parsed_source[index])
            return false if source_contents.count == 0
            source_identity.file_id <- Source::ROOT_FILE_ID
            source_identity.logical_path_id <- hash_domain_and_bytes("EDIR logical path:", logical_path)
            source_identity.content_digest <- hash_domain_and_bytes("EDIR source content:", source_contents)
            source_identity.line_count <- Source::LINE_COUNT_INCREMENT
            for index in 0..<source_contents.count |source_identity, source_contents|:
                source_identity.line_count <- source_identity.line_count + Source::LINE_COUNT_INCREMENT if source_contents[index] == Encoding::NEWLINE_BYTE
            source_identity.path_length <- logical_path.count
            for index in 0..<logical_path.count |source_identity, logical_path|:
                source_identity.path_bytes[index] <- logical_path[index]
            return true



        def append_source_file(buffer: mutable darray[u8]&, source_identity: EDIRSourceIdentity) -> void can[Abort.Panic, Memory.Allocate]:
            append_unsigned_le(buffer, source_identity.file_id, Binary::U64_WIDTH)
            append_unsigned_le(buffer, source_identity.logical_path_id, Binary::U64_WIDTH)
            append_unsigned_le(buffer, source_identity.content_digest, Binary::U64_WIDTH)
            append_unsigned_le(buffer, source_identity.line_count, Binary::U64_WIDTH)
            append_unsigned_le(buffer, source_identity.path_length.u64(), Binary::U32_WIDTH)
            for index in 0..<source_identity.path_length:
                buffer.push(source_identity.path_bytes[index])



        def position_is_usable(position: Ast::Pos) -> bool:
            return false if position.end_offset <= position.offset
            return false if position.end_line < position.line
            return false if position.end_line == position.line and position.end_column < position.column
            return true



        def source_span_cover(start_position: Ast::Pos, end_position: Ast::Pos) -> Ast::Pos:
            return Ast::Pos{
                line: start_position.line,
                column: start_position.column,
                offset: start_position.offset,
                end_line: end_position.end_line,
                end_column: end_position.end_column,
                end_offset: end_position.end_offset
            }



        def append_instruction(buffer: mutable darray[u8]&, opcode: u16, operand_a: i64, position: Ast::Pos) -> void can[Abort.Panic, Memory.Allocate]:
            append_instruction_with_operands(buffer, opcode, operand_a, Shape::NO_OPERAND, position)



        def append_instruction_with_operands(buffer: mutable darray[u8]&, opcode: u16, operand_a: i64, operand_b: i64, position: Ast::Pos) -> void can[Abort.Panic, Memory.Allocate]:
            append_unsigned_le(buffer, opcode.u64(), Binary::U16_WIDTH)
            append_signed_i64_le(buffer, operand_a)
            append_signed_i64_le(buffer, operand_b)
            append_source_span(buffer, position)



        def patch_instruction_operand(buffer: mutable darray[u8]&, instruction_index: usize, operand_a: i64) -> void can[Abort.Panic, Memory.Allocate]:
            operand_offset: usize = instruction_index * Binary::INSTRUCTION_BYTES + Binary::OPERAND_A_BYTE_OFFSET
            operand_bits: u64 = operand_a.u64()
            for byte_index in 0..<Binary::U64_WIDTH |buffer, operand_offset, operand_bits|:
                shift: u64 = byte_index.u64() * Binary::BITS_PER_BYTE
                buffer[operand_offset + byte_index] <- ((operand_bits >> shift) & Binary::BYTE_MASK).u8()



        def function_index(functions: darray[EDIRFunctionPlan]&, function_name: sview) -> usize:
            for index in 0..<functions.count:
                return index if functions[index].name == function_name
            return functions.count



        def function_identity(function_name: sview) -> u64 can[Abort.Panic, Memory.Allocate]:
            name_bytes: mutable darray[u8] = []
            for index in 0..<sview_len(function_name):
                name_bytes.push(sview_at(function_name, index))
            return hash_domain_and_bytes("EDIR function:", name_bytes)



        def function_statement_span(statement: Ast::Stmt) -> Ast::Pos:
            match statement:
                Ast::Stmt.Return(value, return_position):
                    if value is returned_expression:
                        return source_span_cover(return_position, Ast::expr_pos(returned_expression))
                    return return_position
                Ast::Stmt.If(condition, then_body, else_body, if_position):
                    if else_body.count > 0:
                        return function_statement_span(else_body[else_body.count - Shape::LAST_ITEM_INDEX_OFFSET])
                    if then_body.count > 0:
                        return function_statement_span(then_body[then_body.count - Shape::LAST_ITEM_INDEX_OFFSET])
                    return if_position
                _:
                    return Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}



        def function_source_span(function_position: Ast::Pos, body: darray[Ast::Stmt]) -> Ast::Pos:
            return Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET} if body.count == 0
            final_position: Ast::Pos = function_statement_span(body[body.count - Shape::LAST_ITEM_INDEX_OFFSET])
            return source_span_cover(function_position, final_position)



        def append_function_descriptor(buffer: mutable darray[u8]&, function_id: u64, entry_instruction: usize, end_instruction_exclusive: usize, position: Ast::Pos, function_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
            name_length: usize = sview_len(function_name)
            return false if function_id == Function::NO_ID or name_length == Integer::ZERO.usize() or name_length > Function::MAX_NAME_BYTES
            return false if not position_is_usable(position)
            name_bytes: mutable darray[u8] = []
            for index in 0..<name_length:
                name_bytes.push(sview_at(function_name, index))
            return false if not source_path_utf8_is_valid(name_bytes)
            append_unsigned_le(buffer, function_id, Binary::U64_WIDTH)
            append_unsigned_le(buffer, entry_instruction.u64(), Binary::U64_WIDTH)
            append_unsigned_le(buffer, end_instruction_exclusive.u64(), Binary::U64_WIDTH)
            append_source_span(buffer, position)
            append_unsigned_le(buffer, name_length.u64(), Binary::U32_WIDTH)
            for index in 0..<name_length:
                buffer.push(name_bytes[index])
            return true



        def append_single_function_table(buffer: mutable darray[u8]&, function_name: sview, function_position: Ast::Pos, instruction_count: u64) -> bool can[Abort.Panic, Memory.Allocate]:
            append_unsigned_le(buffer, Function::SINGLE_DESCRIPTOR_COUNT, Binary::U32_WIDTH)
            return append_function_descriptor(buffer, function_identity(function_name), Function::ENTRY_INSTRUCTION_INDEX, instruction_count.usize(), function_position, function_name)



        def append_function_table(buffer: mutable darray[u8]&, functions: darray[EDIRFunctionPlan]&) -> bool can[Abort.Panic, Memory.Allocate]:
            append_unsigned_le(buffer, functions.count.u64(), Binary::U32_WIDTH)
            for index in 0..<functions.count |buffer, functions|:
                function: EDIRFunctionPlan = functions[index]
                return false if not append_function_descriptor(buffer, function.function_id, function.entry_instruction, function.end_instruction_exclusive, function.source, function.name)
            return true



        def collect_function_plans(file: Ast::File&, functions: mutable darray[EDIRFunctionPlan]&, error_reason: mutable sview&) -> bool can[Abort.Panic, Memory.Allocate]:
            return false if file.top_decls.count == 0 or file.top_decls.count > Function::MAX_COUNT
            for declaration_index in 0..<file.top_decls.count |functions, error_reason|:
                match file.top_decls[declaration_index]:
                    Ast::Decl.Func(function_name, parameters, return_type, body, effects, decorators, function_position):
                        return false if declaration_index == Shape::FIRST_TOP_LEVEL_DECLARATION_INDEX and function_name != Function::MAIN_NAME
                        return false if declaration_index > Shape::FIRST_TOP_LEVEL_DECLARATION_INDEX and function_name == Function::MAIN_NAME
                        return false if parameters.count != Function::MAIN_PARAMETER_COUNT and parameters.count != Function::HELPER_PARAMETER_COUNT
                        return false if declaration_index == Shape::FIRST_TOP_LEVEL_DECLARATION_INDEX and parameters.count != Function::MAIN_PARAMETER_COUNT
                        return false if declaration_index > Shape::FIRST_TOP_LEVEL_DECLARATION_INDEX and parameters.count != Function::HELPER_PARAMETER_COUNT
                        if return_type is declared_return_type:
                            match declared_return_type:
                                Ast::Expr.Ident(return_type_name, _):
                                    return false if return_type_name != "i64"
                                _:
                                    return false
                        else:
                            return false
                        return false if effects.count != 0 or decorators.count != 0
                        return false if not position_is_usable(function_position)
                        parameter_name: mutable sview = ""
                        if parameters.count == Function::HELPER_PARAMETER_COUNT:
                            parameter: Ast::ParamDecl = parameters[Function::ONLY_PARAMETER_INDEX]
                            match parameter.type_expression:
                                Ast::Expr.Ident(parameter_type_name, _):
                                    return false if parameter_type_name != "i64"
                                _:
                                    return false
                            return false if parameter.name == "" or parameter.name == "_" or parameter.is_mutable or parameter.has_default or parameter.is_affine
                            parameter_name <- parameter.name
                        current_id: u64 = function_identity(function_name)
                        for prior_index in 0..<functions.count:
                            return false if functions[prior_index].name == function_name or functions[prior_index].function_id == current_id
                        functions.push(EDIRFunctionPlan{name: function_name, parameter_name: parameter_name, body: body, source: function_source_span(function_position, body), entry_instruction: Function::ENTRY_INSTRUCTION_INDEX, end_instruction_exclusive: Function::ENTRY_INSTRUCTION_INDEX, function_id: current_id})
                        return false if not position_is_usable(functions[functions.count - Shape::LAST_ITEM_INDEX_OFFSET].source)
                    _:
                        return false
            return true



        def integer_literal_value(expression: Ast::Expr) -> (value: i64, position: Ast::Pos, valid: bool):
            match expression:
                Ast::Expr.IntLit(value, position):
                    return (value, position, position_is_usable(position))
                Ast::Expr.Unary(operator, operand, unary_position):
                    if operator == Lexer::TokenKind.Minus:
                        match operand:
                            Ast::Expr.IntLit(value, _):
                                return (Integer::ZERO - value, unary_position, position_is_usable(unary_position))
                            _:
                                pass
                _:
                    pass
            return (Integer::ZERO, Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}, false)



        def compile_integer_expression(instructions: mutable darray[u8]&, expression: Ast::Expr, parameter_name: sview, functions: darray[EDIRFunctionPlan]&, call_fixups: mutable darray[EDIRCallFixup]&) -> bool can[Abort.Panic, Memory.Allocate]:
            match expression:
                Ast::Expr.IntLit(value, position):
                    return false if not position_is_usable(position)
                    append_instruction(instructions, Instruction::CONSTANT_OPCODE, value, position)
                    return true
                Ast::Expr.Ident(name, position):
                    return false if parameter_name == "" or name != parameter_name or not position_is_usable(position)
                    append_instruction(instructions, Instruction::LOAD_LOCAL_OPCODE, Shape::SINGLE_LOCAL_INDEX, position)
                    return true
                Ast::Expr.Paren(inner, _):
                    return compile_integer_expression(instructions, inner, parameter_name, functions, call_fixups)
                Ast::Expr.Unary(operator, operand, position):
                    if operator == Lexer::TokenKind.Minus:
                        match operand:
                            Ast::Expr.IntLit(value, _):
                                return false if not position_is_usable(position)
                                append_instruction(instructions, Instruction::CONSTANT_OPCODE, Integer::ZERO - value, position)
                                return true
                            _:
                                pass
                    return false
                Ast::Expr.Binary(left, operator, right, position):
                    right_literal: (value: i64, position: Ast::Pos, valid: bool) = integer_literal_value(right)
                    return false if not right_literal.valid or not position_is_usable(position)
                    supported_operator: mutable bool = false
                    opcode: u16 = binary_opcode(operator, &supported_operator)
                    return false if not supported_operator or (opcode == Instruction::DIVIDE_OPCODE and right_literal.value == Shape::NO_OPERAND)
                    return false if not compile_integer_expression(instructions, left, parameter_name, functions, call_fixups)
                    append_instruction(instructions, opcode, right_literal.value, position)
                    return true
                Ast::Expr.Call(callee, arguments, argument_names, call_position):
                    match callee:
                        Ast::Expr.Ident(callee_name, _):
                            target_index: usize = function_index(functions, callee_name)
                            return false if target_index >= functions.count or functions[target_index].parameter_name == "" or arguments.count != Function::HELPER_PARAMETER_COUNT or argument_names.count != arguments.count or not position_is_usable(call_position)
                            for argument_index in 0..<argument_names.count:
                                return false if argument_names[argument_index] != ""
                            return false if not compile_integer_expression(instructions, arguments[Function::ONLY_ARGUMENT_INDEX], parameter_name, functions, call_fixups)
                            instruction_index: usize = instructions.count / Binary::INSTRUCTION_BYTES
                            append_instruction_with_operands(instructions, Instruction::CALL_OPCODE, Shape::NO_OPERAND, Function::MAX_CALL_DEPTH, call_position)
                            call_fixups.push(EDIRCallFixup{instruction_index: instruction_index, function_name: callee_name})
                            return true
                        _:
                            return false
                _:
                    return false



        def compile_integer_condition(instructions: mutable darray[u8]&, condition: Ast::Expr, parameter_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
            match condition:
                Ast::Expr.Binary(left, operator, right, condition_position):
                    return false if operator != Lexer::TokenKind.Lt and operator != Lexer::TokenKind.EqEq
                    match left:
                        Ast::Expr.Ident(name, left_position):
                            return false if parameter_name == "" or name != parameter_name or not position_is_usable(left_position)
                            literal: (value: i64, position: Ast::Pos, valid: bool) = integer_literal_value(right)
                            return false if not literal.valid or not position_is_usable(condition_position)
                            append_instruction(instructions, Instruction::LOAD_LOCAL_OPCODE, Shape::SINGLE_LOCAL_INDEX, left_position)
                            comparison_opcode: u16 = Instruction::COMPARE_LESS_OPCODE if operator == Lexer::TokenKind.Lt else Instruction::COMPARE_EQUAL_OPCODE
                            append_instruction(instructions, comparison_opcode, literal.value, condition_position)
                            return true
                        _:
                            return false
                _:
                    return false



        def compile_integer_return(instructions: mutable darray[u8]&, statement: Ast::Stmt, parameter_name: sview, functions: darray[EDIRFunctionPlan]&, call_fixups: mutable darray[EDIRCallFixup]&) -> bool can[Abort.Panic, Memory.Allocate]:
            match statement:
                Ast::Stmt.Return(value, return_position):
                    if value is returned_expression:
                        return false if not compile_integer_expression(instructions, returned_expression, parameter_name, functions, call_fixups)
                        full_return_position: Ast::Pos = source_span_cover(return_position, Ast::expr_pos(returned_expression))
                        return false if not position_is_usable(full_return_position)
                        append_instruction(instructions, Instruction::RETURN_OPCODE, Shape::NO_OPERAND, full_return_position)
                        return true
                    return false
                _:
                    return false



        def compile_integer_if(instructions: mutable darray[u8]&, statement: Ast::Stmt, parameter_name: sview, functions: darray[EDIRFunctionPlan]&, call_fixups: mutable darray[EDIRCallFixup]&) -> bool can[Abort.Panic, Memory.Allocate]:
            match statement:
                Ast::Stmt.If(condition, then_body, else_body, if_position):
                    return false if then_body.count != Shape::STATEMENT_COUNT or else_body.count > Shape::STATEMENT_COUNT or not position_is_usable(if_position)
                    return false if not compile_integer_condition(instructions, condition, parameter_name)
                    branch_index: usize = instructions.count / Binary::INSTRUCTION_BYTES
                    append_instruction(instructions, Instruction::BRANCH_ZERO_OPCODE, Shape::NO_OPERAND, Ast::expr_pos(condition))
                    return false if not compile_integer_return(instructions, then_body[Shape::FIRST_STATEMENT_INDEX], parameter_name, functions, call_fixups)
                    branch_target: usize = instructions.count / Binary::INSTRUCTION_BYTES
                    patch_instruction_operand(instructions, branch_index, branch_target.i64())
                    if else_body.count == Shape::STATEMENT_COUNT:
                        return false if not compile_integer_return(instructions, else_body[Shape::FIRST_STATEMENT_INDEX], parameter_name, functions, call_fixups)
                    return true
                _:
                    return false



        def function_body_has_supported_return_shape(body: darray[Ast::Stmt]) -> bool:
            return false if body.count == 0
            for index in 0..<body.count:
                match body[index]:
                    Ast::Stmt.Return(_, _):
                        return false if index != body.count - Shape::LAST_ITEM_INDEX_OFFSET
                    Ast::Stmt.If(_, then_body, else_body, _):
                        return false if then_body.count != Shape::STATEMENT_COUNT or else_body.count > Shape::STATEMENT_COUNT
                        match then_body[Shape::FIRST_STATEMENT_INDEX]:
                            Ast::Stmt.Return(_, _):
                                pass
                            _:
                                return false
                        if else_body.count == Shape::STATEMENT_COUNT:
                            match else_body[Shape::FIRST_STATEMENT_INDEX]:
                                Ast::Stmt.Return(_, _):
                                    return false if index != body.count - Shape::LAST_ITEM_INDEX_OFFSET
                                _:
                                    return false
                    _:
                        return false
            match body[body.count - Shape::LAST_ITEM_INDEX_OFFSET]:
                Ast::Stmt.Return(_, _):
                    return true
                Ast::Stmt.If(_, _, else_body, _):
                    return else_body.count == Shape::STATEMENT_COUNT
                _:
                    return false



        def compile_function_body(instructions: mutable darray[u8]&, function: EDIRFunctionPlan, functions: darray[EDIRFunctionPlan]&, call_fixups: mutable darray[EDIRCallFixup]&) -> bool can[Abort.Panic, Memory.Allocate]:
            return false if not function_body_has_supported_return_shape(function.body)
            for statement_index in 0..<function.body.count |instructions, function, functions, call_fixups|:
                match function.body[statement_index]:
                    Ast::Stmt.Return(_, _):
                        return false if not compile_integer_return(instructions, function.body[statement_index], function.parameter_name, functions, call_fixups)
                    Ast::Stmt.If(_, _, _, _):
                        return false if not compile_integer_if(instructions, function.body[statement_index], function.parameter_name, functions, call_fixups)
                    _:
                        return false
            return true



        def resolve_call_fixups(instructions: mutable darray[u8]&, functions: darray[EDIRFunctionPlan]&, call_fixups: darray[EDIRCallFixup]&) -> bool:
            for fixup_index in 0..<call_fixups.count |functions, call_fixups|:
                fixup: EDIRCallFixup = call_fixups[fixup_index]
                target_index: usize = function_index(functions, fixup.function_name)
                return false if target_index >= functions.count or functions[target_index].parameter_name == ""
                patch_instruction_operand(instructions, fixup.instruction_index, functions[target_index].entry_instruction.i64())
            return true



        def functions_artifact(output_path: darray[u8]&, functions: mutable darray[EDIRFunctionPlan]&, source_identity: EDIRSourceIdentity) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            instructions: mutable darray[u8] = []
            call_fixups: mutable darray[EDIRCallFixup] = []
            for function_index_value in 0..<functions.count |instructions, functions, call_fixups|:
                functions[function_index_value].entry_instruction <- instructions.count / Binary::INSTRUCTION_BYTES
                return unsupported("function bodies may contain only returns, simple conditional returns, integer arithmetic, and direct single-argument calls") if not compile_function_body(instructions, functions[function_index_value], functions, call_fixups)
                functions[function_index_value].end_instruction_exclusive <- instructions.count / Binary::INSTRUCTION_BYTES
            return unsupported("direct calls must target a declared one-argument helper function") if not resolve_call_fixups(instructions, functions, call_fixups)
            instruction_count: usize = instructions.count / Binary::INSTRUCTION_BYTES
            return unsupported("function artifact exceeds the portable EDIR instruction limit") if instruction_count > Instruction::MAX_COUNT
            artifact: mutable darray[u8] = []
            local_count: u64 = Function::MAX_LOCAL_COUNT if functions.count > Shape::SINGLE_LOCAL_COUNT
            append_header(&artifact, instruction_count.u64(), local_count, source_identity)
            for instruction_byte in 0..<instructions.count |artifact, instructions|:
                artifact.push(instructions[instruction_byte])
            return unsupported("function descriptor table exceeds the portable EDIR bounds") if not append_function_table(&artifact, functions)
            return write_artifact_or_report(output_path, artifact)



        def simple_i64_declaration(statement: Ast::Stmt) -> (name: sview, value: i64, declaration_span: Ast::Pos, valid: bool):
            match statement:
                Ast::Stmt.VarDecl(local_name, local_type, initializer, declaration_position):
                    return ("", Integer::ZERO, Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}, false) if local_name == "" or local_name == "_"
                    match local_type:
                        Ast::Expr.Unary(type_operator, bare_type, _):
                            return ("", Integer::ZERO, Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}, false) if type_operator != Lexer::TokenKind.Mutable
                            match bare_type:
                                Ast::Expr.Ident(type_name, _):
                                    return ("", Integer::ZERO, Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}, false) if type_name != "i64"
                                _:
                                    return ("", Integer::ZERO, Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}, false)
                        _:
                            return ("", Integer::ZERO, Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}, false)
                    match initializer:
                        Ast::Expr.IntLit(value, initializer_position):
                            declaration_span: Ast::Pos = source_span_cover(declaration_position, initializer_position)
                            return (local_name, value, declaration_span, position_is_usable(declaration_span))
                        _:
                            return ("", Integer::ZERO, Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}, false)
                _:
                    return ("", Integer::ZERO, Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}, false)



        def simple_i64_increment(statement: Ast::Stmt, expected_name: sview, expected_increment: i64) -> (span: Ast::Pos, valid: bool):
            match statement:
                Ast::Stmt.Assign(target, assignment_operator, value, _):
                    return (Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}, false) if assignment_operator != Lexer::TokenKind.LArrow
                    match target:
                        Ast::Expr.Ident(target_name, target_position):
                            return (Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}, false) if target_name != expected_name or not position_is_usable(target_position)
                            match value:
                                Ast::Expr.Binary(left, operator, right, _):
                                    return (Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}, false) if operator != Lexer::TokenKind.Plus
                                    match left:
                                        Ast::Expr.Ident(left_name, left_position):
                                            return (Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}, false) if left_name != expected_name or not position_is_usable(left_position)
                                        _:
                                            return (Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}, false)
                                    match right:
                                        Ast::Expr.IntLit(increment, right_position):
                                            return (Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}, false) if increment != expected_increment or not position_is_usable(right_position)
                                            assignment_span: Ast::Pos = source_span_cover(target_position, right_position)
                                            return (assignment_span, position_is_usable(assignment_span))
                                        _:
                                            return (Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}, false)
                                _:
                                    return (Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}, false)
                        _:
                            return (Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}, false)
                _:
                    return (Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}, false)



        def counted_loop_artifact(output_path: darray[u8]&, body: darray[Ast::Stmt], function_position: Ast::Pos, source_identity: EDIRSourceIdentity) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            return unsupported("counted-loop lowering requires two initialized `i64` locals, one bounded `while`, and a return") if body.count != CountedLoop::STATEMENT_COUNT

            counter: (name: sview, value: i64, declaration_span: Ast::Pos, valid: bool) = simple_i64_declaration(body[CountedLoop::COUNTER_DECLARATION_INDEX])
            total: (name: sview, value: i64, declaration_span: Ast::Pos, valid: bool) = simple_i64_declaration(body[CountedLoop::TOTAL_DECLARATION_INDEX])
            return unsupported("counted-loop locals must be initialized typed `i64` declarations with usable source spans") if not counter.valid or not total.valid
            return unsupported("counted-loop locals must have distinct names and start at zero") if counter.name == total.name or counter.value != CountedLoop::INITIAL_VALUE or total.value != CountedLoop::INITIAL_VALUE

            loop_condition_position: mutable Ast::Pos = Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}
            loop_limit: mutable i64 = CountedLoop::INITIAL_VALUE
            counter_assignment_span: mutable Ast::Pos = Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}
            total_assignment_span: mutable Ast::Pos = Ast::Pos{line: Shape::NO_POSITION_LINE, column: Shape::NO_POSITION_COLUMN, offset: Shape::NO_POSITION_OFFSET, end_line: Shape::NO_POSITION_LINE, end_column: Shape::NO_POSITION_COLUMN, end_offset: Shape::NO_POSITION_OFFSET}

            match body[CountedLoop::WHILE_STATEMENT_INDEX]:
                Ast::Stmt.While(condition, loop_body, _):
                    return unsupported("counted-loop body must update the total and then the counter") if loop_body.count != CountedLoop::BODY_STATEMENT_COUNT
                    match condition:
                        Ast::Expr.Binary(left, operator, right, condition_position):
                            return unsupported("counted-loop condition must compare the counter with a nonnegative literal using `<`") if operator != Lexer::TokenKind.Lt
                            match left:
                                Ast::Expr.Ident(condition_name, condition_name_position):
                                    return unsupported("counted-loop condition must use the first local as its counter") if condition_name != counter.name or not position_is_usable(condition_name_position)
                                _:
                                    return unsupported("counted-loop condition must use the first local as its counter")
                            match right:
                                Ast::Expr.IntLit(limit, limit_position):
                                    return unsupported("counted-loop limit must be nonnegative and keep the total within `i64`") if limit < CountedLoop::INITIAL_VALUE or limit > CountedLoop::TOTAL_MAX
                                    loop_limit <- limit
                                    return unsupported("counted-loop limit has no usable source span") if not position_is_usable(limit_position)
                                _:
                                    return unsupported("counted-loop limit must be an integer literal")
                            return unsupported("counted-loop condition has no usable source span") if not position_is_usable(condition_position)
                            loop_condition_position <- condition_position
                        _:
                            return unsupported("counted-loop condition must be a local-versus-literal `<` comparison")
                    total_update: (span: Ast::Pos, valid: bool) = simple_i64_increment(loop_body[CountedLoop::TOTAL_UPDATE_INDEX], total.name, CountedLoop::TOTAL_INCREMENT)
                    counter_update: (span: Ast::Pos, valid: bool) = simple_i64_increment(loop_body[CountedLoop::COUNTER_UPDATE_INDEX], counter.name, CountedLoop::COUNTER_INCREMENT)
                    return unsupported("counted-loop body must use `total <- total + 2` and `counter <- counter + 1`") if not total_update.valid or not counter_update.valid
                    total_assignment_span <- total_update.span
                    counter_assignment_span <- counter_update.span
                _:
                    return unsupported("the third statement in counted-loop `main` must be a `while`")

            instructions: mutable darray[u8] = []
            append_instruction(&instructions, Instruction::CONSTANT_OPCODE, counter.value, counter.declaration_span)
            append_instruction(&instructions, Instruction::STORE_LOCAL_OPCODE, CountedLoop::COUNTER_INDEX, counter.declaration_span)
            append_instruction(&instructions, Instruction::CONSTANT_OPCODE, total.value, total.declaration_span)
            append_instruction(&instructions, Instruction::STORE_LOCAL_OPCODE, CountedLoop::TOTAL_INDEX, total.declaration_span)

            loop_start: usize = instructions.count / Binary::INSTRUCTION_BYTES
            append_instruction(&instructions, Instruction::LOAD_LOCAL_OPCODE, CountedLoop::COUNTER_INDEX, loop_condition_position)
            append_instruction(&instructions, Instruction::COMPARE_LESS_OPCODE, loop_limit, loop_condition_position)
            branch_instruction: usize = instructions.count / Binary::INSTRUCTION_BYTES
            append_instruction(&instructions, Instruction::BRANCH_ZERO_OPCODE, Shape::NO_OPERAND, loop_condition_position)
            append_instruction(&instructions, Instruction::LOAD_LOCAL_OPCODE, CountedLoop::TOTAL_INDEX, total_assignment_span)
            append_instruction(&instructions, Instruction::ADD_OPCODE, CountedLoop::TOTAL_INCREMENT, total_assignment_span)
            append_instruction(&instructions, Instruction::STORE_LOCAL_OPCODE, CountedLoop::TOTAL_INDEX, total_assignment_span)
            append_instruction(&instructions, Instruction::LOAD_LOCAL_OPCODE, CountedLoop::COUNTER_INDEX, counter_assignment_span)
            append_instruction(&instructions, Instruction::ADD_OPCODE, CountedLoop::COUNTER_INCREMENT, counter_assignment_span)
            append_instruction(&instructions, Instruction::STORE_LOCAL_OPCODE, CountedLoop::COUNTER_INDEX, counter_assignment_span)
            append_instruction(&instructions, Instruction::JUMP_OPCODE, loop_start.i64(), loop_condition_position)
            loop_exit: usize = instructions.count / Binary::INSTRUCTION_BYTES

            match body[CountedLoop::RETURN_STATEMENT_INDEX]:
                Ast::Stmt.Return(return_value, return_position):
                    if return_value is returned_expression:
                        match returned_expression:
                            Ast::Expr.Ident(returned_name, returned_position):
                                return unsupported("counted-loop `main` must return its total local") if returned_name != total.name
                                full_return_position: Ast::Pos = source_span_cover(return_position, returned_position)
                                return unsupported("counted-loop return has no usable source span") if not position_is_usable(full_return_position)
                                append_instruction(&instructions, Instruction::LOAD_LOCAL_OPCODE, CountedLoop::TOTAL_INDEX, full_return_position)
                                append_instruction(&instructions, Instruction::RETURN_OPCODE, Shape::NO_OPERAND, full_return_position)
                            _:
                                return unsupported("counted-loop `main` must return its total local")
                    else:
                        return unsupported("counted-loop `main` must return a value")
                _:
                    return unsupported("the final statement in counted-loop `main` must be a return")

            instruction_count: usize = instructions.count / Binary::INSTRUCTION_BYTES
            return unsupported("counted-loop artifact exceeds the portable EDIR instruction limit") if instruction_count > Instruction::MAX_COUNT
            patch_instruction_operand(&instructions, branch_instruction, loop_exit.i64())

            artifact: mutable darray[u8] = []
            append_header(&artifact, instruction_count.u64(), CountedLoop::LOCAL_COUNT, source_identity)
            for instruction_byte in 0..<instructions.count |artifact, instructions|:
                artifact.push(instructions[instruction_byte])
            return unsupported("`main` function descriptor has no usable source span") if not append_single_function_table(&artifact, Function::MAIN_NAME, function_position, instruction_count.u64())
            return write_artifact_or_report(output_path, artifact)



        def binary_opcode(operator: Lexer::TokenKind, supported: mutable bool&) -> u16:
            supported <- true
            return Instruction::ADD_OPCODE if operator == Lexer::TokenKind.Plus
            return Instruction::SUBTRACT_OPCODE if operator == Lexer::TokenKind.Minus
            return Instruction::MULTIPLY_OPCODE if operator == Lexer::TokenKind.Star
            return Instruction::DIVIDE_OPCODE if operator == Lexer::TokenKind.Slash
            supported <- false
            return Instruction::UNSUPPORTED_OPCODE



        def binary_operands_are_safe(opcode: u16, left: i64, right: i64) -> bool:
            return false if left < Shape::NO_OPERAND or right < Shape::NO_OPERAND
            if opcode == Instruction::ADD_OPCODE:
                return left <= Integer::I64_MAX - right
            if opcode == Instruction::SUBTRACT_OPCODE:
                return true
            if opcode == Instruction::MULTIPLY_OPCODE:
                return true if right == Shape::NO_OPERAND
                return left <= Integer::I64_MAX / right
            if opcode == Instruction::DIVIDE_OPCODE:
                return right != Shape::NO_OPERAND
            return false



        def append_header(buffer: mutable darray[u8]&, instruction_count: u64, local_count: u64, source_identity: EDIRSourceIdentity) -> void can[Abort.Panic, Memory.Allocate]:
            append_unsigned_le(buffer, Schema::CODEC_VERSION.u64(), Binary::U32_WIDTH)
            append_unsigned_le(buffer, Schema::PROGRAM_VERSION.u64(), Binary::U32_WIDTH)
            append_unsigned_le(buffer, instruction_count, Binary::U64_WIDTH)
            append_unsigned_le(buffer, local_count, Binary::U64_WIDTH)
            buffer.push(Encoding::TRUE)
            append_unsigned_le(buffer, Source::FILE_COUNT.u64(), Binary::U32_WIDTH)
            append_source_file(buffer, source_identity)



        def literal_artifact(output_path: darray[u8]&, value: i64, value_position: Ast::Pos, return_position: Ast::Pos, function_position: Ast::Pos, source_identity: EDIRSourceIdentity) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            return unsupported("the literal has no usable source span") if not position_is_usable(value_position)
            statement_position: Ast::Pos = source_span_cover(return_position, value_position)
            return unsupported("the return statement has no usable source span") if not position_is_usable(statement_position)
            artifact: mutable darray[u8] = []
            append_header(&artifact, Instruction::LITERAL_COUNT, Shape::NO_LOCALS, source_identity)
            append_instruction(&artifact, Instruction::CONSTANT_OPCODE, value, value_position)
            append_instruction(&artifact, Instruction::RETURN_OPCODE, Shape::NO_OPERAND, statement_position)
            return unsupported("`main` function descriptor has no usable source span") if not append_single_function_table(&artifact, Function::MAIN_NAME, function_position, Instruction::LITERAL_COUNT)
            return write_artifact_or_report(output_path, artifact)



        def binary_artifact(output_path: darray[u8]&, opcode: u16, left_value: i64, left_position: Ast::Pos, right_value: i64, right_position: Ast::Pos, return_position: Ast::Pos, function_position: Ast::Pos, source_identity: EDIRSourceIdentity) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            return unsupported("the left literal has no usable source span") if not position_is_usable(left_position)
            return unsupported("the right literal has no usable source span") if not position_is_usable(right_position)
            full_expression_position: Ast::Pos = source_span_cover(left_position, right_position)
            return unsupported("the arithmetic expression has no usable source span") if not position_is_usable(full_expression_position)
            statement_position: Ast::Pos = source_span_cover(return_position, right_position)
            return unsupported("the return statement has no usable source span") if not position_is_usable(statement_position)
            return unsupported("arithmetic may overflow or divide by zero in the managed engine") if not binary_operands_are_safe(opcode, left_value, right_value)
            artifact: mutable darray[u8] = []
            append_header(&artifact, Instruction::BINARY_COUNT, Shape::NO_LOCALS, source_identity)
            append_instruction(&artifact, Instruction::CONSTANT_OPCODE, left_value, left_position)
            append_instruction(&artifact, opcode, right_value, full_expression_position)
            append_instruction(&artifact, Instruction::RETURN_OPCODE, Shape::NO_OPERAND, statement_position)
            return unsupported("`main` function descriptor has no usable source span") if not append_single_function_table(&artifact, Function::MAIN_NAME, function_position, Instruction::BINARY_COUNT)
            return write_artifact_or_report(output_path, artifact)



        def local_return_artifact(output_path: darray[u8]&, local_name: sview, local_value: i64, declaration_position: Ast::Pos, initializer_position: Ast::Pos, returned_expression: Ast::Expr, return_position: Ast::Pos, function_position: Ast::Pos, source_identity: EDIRSourceIdentity) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            return unsupported("the local declaration has no usable source span") if not position_is_usable(declaration_position)
            return unsupported("the local initializer has no usable source span") if not position_is_usable(initializer_position)
            full_declaration_position: Ast::Pos = source_span_cover(declaration_position, initializer_position)
            return unsupported("the local declaration has no usable source span") if not position_is_usable(full_declaration_position)

            match returned_expression:
                Ast::Expr.Ident(returned_name, returned_position):
                    return unsupported("the return identifier must name the initialized local") if returned_name != local_name
                    return unsupported("the returned local has no usable source span") if not position_is_usable(returned_position)
                    statement_position: Ast::Pos = source_span_cover(return_position, returned_position)
                    return unsupported("the return statement has no usable source span") if not position_is_usable(statement_position)
                    artifact: mutable darray[u8] = []
                    append_header(&artifact, Instruction::LOCAL_COUNT, Shape::SINGLE_LOCAL_COUNT, source_identity)
                    append_instruction(&artifact, Instruction::CONSTANT_OPCODE, local_value, initializer_position)
                    append_instruction(&artifact, Instruction::STORE_LOCAL_OPCODE, Shape::SINGLE_LOCAL_INDEX, full_declaration_position)
                    append_instruction(&artifact, Instruction::LOAD_LOCAL_OPCODE, Shape::SINGLE_LOCAL_INDEX, returned_position)
                    append_instruction(&artifact, Instruction::RETURN_OPCODE, Shape::NO_OPERAND, statement_position)
                    return unsupported("`main` function descriptor has no usable source span") if not append_single_function_table(&artifact, Function::MAIN_NAME, function_position, Instruction::LOCAL_COUNT)
                    return write_artifact_or_report(output_path, artifact)
                Ast::Expr.Binary(left, operator, right, _):
                    supported_operator: mutable bool = false
                    opcode: u16 = binary_opcode(operator, &supported_operator)
                    return unsupported("the return arithmetic operator must be `+`, `-`, `*`, or `/`") if not supported_operator
                    match left:
                        Ast::Expr.Ident(left_name, left_position):
                            return unsupported("the left return operand must name the initialized local") if left_name != local_name
                            return unsupported("the local arithmetic operand has no usable source span") if not position_is_usable(left_position)
                            match right:
                                Ast::Expr.IntLit(right_value, right_position):
                                    return unsupported("the right arithmetic literal has no usable source span") if not position_is_usable(right_position)
                                    expression_position: Ast::Pos = source_span_cover(left_position, right_position)
                                    return unsupported("the return arithmetic expression has no usable source span") if not position_is_usable(expression_position)
                                    statement_position: Ast::Pos = source_span_cover(return_position, right_position)
                                    return unsupported("the return statement has no usable source span") if not position_is_usable(statement_position)
                                    return unsupported("arithmetic may overflow or divide by zero in the managed engine") if not binary_operands_are_safe(opcode, local_value, right_value)
                                    artifact: mutable darray[u8] = []
                                    append_header(&artifact, Instruction::LOCAL_BINARY_COUNT, Shape::SINGLE_LOCAL_COUNT, source_identity)
                                    append_instruction(&artifact, Instruction::CONSTANT_OPCODE, local_value, initializer_position)
                                    append_instruction(&artifact, Instruction::STORE_LOCAL_OPCODE, Shape::SINGLE_LOCAL_INDEX, full_declaration_position)
                                    append_instruction(&artifact, Instruction::LOAD_LOCAL_OPCODE, Shape::SINGLE_LOCAL_INDEX, left_position)
                                    append_instruction(&artifact, opcode, right_value, expression_position)
                                    append_instruction(&artifact, Instruction::RETURN_OPCODE, Shape::NO_OPERAND, statement_position)
                                    return unsupported("`main` function descriptor has no usable source span") if not append_single_function_table(&artifact, Function::MAIN_NAME, function_position, Instruction::LOCAL_BINARY_COUNT)
                                    return write_artifact_or_report(output_path, artifact)
                                _:
                                    return unsupported("the right operand of local arithmetic must be an integer literal")
                        _:
                            return unsupported("the left operand of return arithmetic must be the initialized local")
                _:
                    return unsupported("`main` must return the initialized local or use it as the left operand of supported integer-literal arithmetic")



        def core_ir_opcode(operator: ElisaCoreIR::I64BinaryOperator) -> u16:
            return Instruction::ADD_OPCODE if operator == ElisaCoreIR::I64BinaryOperator.Add
            return Instruction::SUBTRACT_OPCODE if operator == ElisaCoreIR::I64BinaryOperator.Subtract
            return Instruction::MULTIPLY_OPCODE if operator == ElisaCoreIR::I64BinaryOperator.Multiply
            return Instruction::DIVIDE_OPCODE


        def core_ir_artifact(output_path: darray[u8]&, program: ElisaCoreIR::Program, function_position: Ast::Pos, source_identity: EDIRSourceIdentity) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            artifact: mutable darray[u8] = []
            if program.has_local:
                return unsupported("the local declaration has no usable source span") if not position_is_usable(program.local_declaration_position)
                return unsupported("the local initializer has no usable source span") if not position_is_usable(program.local_initializer_position)
                local_declaration_span: Ast::Pos = source_span_cover(program.local_declaration_position, program.local_initializer_position)
                return unsupported("the local declaration has no usable source span") if not position_is_usable(local_declaration_span)
                return unsupported("the returned local has no usable source span") if not position_is_usable(program.left_position)
                return unsupported("the return statement has no usable source span") if not position_is_usable(program.return_position)
                if program.has_binary_operator:
                    return unsupported("arithmetic may overflow or divide by zero in the managed engine") if not ElisaCoreIR::scalar_expression_is_defined(program)
                    return unsupported("the right literal has no usable source span") if not position_is_usable(program.right_position)
                    return unsupported("the arithmetic expression has no usable source span") if not position_is_usable(program.expression_position)
                    append_header(&artifact, Instruction::LOCAL_BINARY_COUNT, Shape::SINGLE_LOCAL_COUNT, source_identity)
                    append_instruction(&artifact, Instruction::CONSTANT_OPCODE, program.local_value, program.local_initializer_position)
                    append_instruction(&artifact, Instruction::STORE_LOCAL_OPCODE, Shape::SINGLE_LOCAL_INDEX, local_declaration_span)
                    append_instruction(&artifact, Instruction::LOAD_LOCAL_OPCODE, Shape::SINGLE_LOCAL_INDEX, program.left_position)
                    append_instruction(&artifact, core_ir_opcode(program.operator), program.right, program.expression_position)
                    append_instruction(&artifact, Instruction::RETURN_OPCODE, Shape::NO_OPERAND, program.return_position)
                    return unsupported("`main` function descriptor has no usable source span") if not append_single_function_table(&artifact, Function::MAIN_NAME, function_position, Instruction::LOCAL_BINARY_COUNT)
                    return write_artifact_or_report(output_path, artifact)
                append_header(&artifact, Instruction::LOCAL_COUNT, Shape::SINGLE_LOCAL_COUNT, source_identity)
                append_instruction(&artifact, Instruction::CONSTANT_OPCODE, program.local_value, program.local_initializer_position)
                append_instruction(&artifact, Instruction::STORE_LOCAL_OPCODE, Shape::SINGLE_LOCAL_INDEX, local_declaration_span)
                append_instruction(&artifact, Instruction::LOAD_LOCAL_OPCODE, Shape::SINGLE_LOCAL_INDEX, program.left_position)
                append_instruction(&artifact, Instruction::RETURN_OPCODE, Shape::NO_OPERAND, program.return_position)
                return unsupported("`main` function descriptor has no usable source span") if not append_single_function_table(&artifact, Function::MAIN_NAME, function_position, Instruction::LOCAL_COUNT)
                return write_artifact_or_report(output_path, artifact)
            if not program.has_binary_operator:
                return unsupported("the literal has no usable source span") if not position_is_usable(program.left_position)
                return unsupported("the return statement has no usable source span") if not position_is_usable(program.return_position)
                append_header(&artifact, Instruction::LITERAL_COUNT, Shape::NO_LOCALS, source_identity)
                append_instruction(&artifact, Instruction::CONSTANT_OPCODE, program.left, program.left_position)
                append_instruction(&artifact, Instruction::RETURN_OPCODE, Shape::NO_OPERAND, program.return_position)
                return unsupported("`main` function descriptor has no usable source span") if not append_single_function_table(&artifact, Function::MAIN_NAME, function_position, Instruction::LITERAL_COUNT)
                return write_artifact_or_report(output_path, artifact)
            return unsupported("arithmetic may overflow or divide by zero in the managed engine") if not ElisaCoreIR::scalar_expression_is_defined(program)
            return unsupported("the left literal has no usable source span") if not position_is_usable(program.left_position)
            return unsupported("the right literal has no usable source span") if not position_is_usable(program.right_position)
            return unsupported("the arithmetic expression has no usable source span") if not position_is_usable(program.expression_position)
            return unsupported("the return statement has no usable source span") if not position_is_usable(program.return_position)
            append_header(&artifact, Instruction::BINARY_COUNT, Shape::NO_LOCALS, source_identity)
            append_instruction(&artifact, Instruction::CONSTANT_OPCODE, program.left, program.left_position)
            append_instruction(&artifact, core_ir_opcode(program.operator), program.right, program.expression_position)
            append_instruction(&artifact, Instruction::RETURN_OPCODE, Shape::NO_OPERAND, program.return_position)
            return unsupported("`main` function descriptor has no usable source span") if not append_single_function_table(&artifact, Function::MAIN_NAME, function_position, Instruction::BINARY_COUNT)
            return write_artifact_or_report(output_path, artifact)



        def root_source_map_is_single_file() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            line_map: mutable darray[u8] = []
            return false if not env_value("ELISA_STAGE1_LINE_MAP", &line_map)
            entries: mutable usize = 0
            for line_map_byte in line_map |entries, line_map|:
                entries <- entries + Binary::BYTE_WIDTH if line_map_byte == Encoding::NEWLINE_BYTE
            return entries == Shape::SOURCE_MAP_ENTRY_COUNT



        def write_all(descriptor: i64, bytes: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            return false if bytes.count == 0
            offset: mutable usize = 0
            while offset < bytes.count |offset, bytes|:
                chunk: void& = (&bytes[offset]).cast[void&] can Unsafe.PointerCast
                written: isize = write(descriptor, chunk, bytes.count - offset) can Console, Unsafe.PointerCast
                return false if written <= FileSystem::WRITE_NO_PROGRESS
                return false if written.usize() > bytes.count - offset
                offset <- offset + written.usize()
            return true



    public:
        def prepare_output(output_path: darray[u8]&) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            return Status::FAILURE if output_path.count <= Binary::BYTE_WIDTH
            return Status::FAILURE if output_path[output_path.count - Binary::BYTE_WIDTH] != Encoding::NUL_BYTE
            path: cstr = (&output_path[SourcePath::FIRST_BYTE_INDEX]).cast[cstr] can Unsafe.PointerCast
            descriptor: i64 = open(path, FileSystemOpen::OPEN_WRITE_CREATE_TRUNCATE, FileSystem::OUTPUT_FILE_MODE) can Blocking.IO, Unsafe.PointerCast
            if descriptor == FileSystem::OUTPUT_DESCRIPTOR_FAILURE:
                output_error: mutable darray[u8] = ProjectSystem::bytes_from_view("error: -emit edir could not open or truncate the requested -o path\n")
                write_stderr(output_error)
                return Status::FAILURE
            close_result: i64 = close(descriptor) can Blocking.IO, Unsafe.PointerCast
            if close_result < Status::SYSCALL_ERROR_THRESHOLD:
                close_error: mutable darray[u8] = ProjectSystem::bytes_from_view("error: -emit edir could not close the prepared -o path\n")
                write_stderr(close_error)
                return Status::FAILURE
            return Status::SUCCESS



    private:
        def write_artifact(output_path: darray[u8]&, bytes: darray[u8]&) -> bool can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            return false if output_path.count <= Binary::BYTE_WIDTH
            return false if output_path[output_path.count - Binary::BYTE_WIDTH] != Encoding::NUL_BYTE
            path: cstr = (&output_path[SourcePath::FIRST_BYTE_INDEX]).cast[cstr] can Unsafe.PointerCast
            descriptor: i64 = open(path, FileSystemOpen::OPEN_WRITE_CREATE_TRUNCATE, FileSystem::OUTPUT_FILE_MODE) can Blocking.IO, Unsafe.PointerCast
            return false if descriptor == FileSystem::OUTPUT_DESCRIPTOR_FAILURE
            wrote_all: bool = write_all(descriptor, bytes) can Blocking.IO, Unsafe.PointerCast
            close_result: i64 = close(descriptor) can Blocking.IO, Unsafe.PointerCast
            return false if not wrote_all or close_result < Status::SYSCALL_ERROR_THRESHOLD
            return true



        def write_artifact_or_report(output_path: darray[u8]&, bytes: darray[u8]&) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            wrote_artifact: bool = write_artifact(output_path, bytes) can Blocking.IO, Unsafe.PointerCast
            return Status::SUCCESS if wrote_artifact
            artifact_error: mutable darray[u8] = []
            emit_tokens_push_sview(&artifact_error, "error: -emit edir could not write the complete artifact to the requested -o path\n")
            write_stderr(artifact_error)
            return Status::FAILURE

    public:
        def emit(file: Ast::File&, output_path: darray[u8]&, static_generation_expanded: bool, parsed_source: u8&, parsed_source_length: usize) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            return unsupported("static-generate source mapping is not supported yet") if static_generation_expanded
            return unsupported("include-expanded source mapping is not supported yet") if not root_source_map_is_single_file()
            return unsupported("an explicit `-o` output path is required") if output_path.count <= Binary::BYTE_WIDTH
            source_identity: mutable EDIRSourceIdentity = zeroed
            return unsupported("source path or parsed source identity is invalid; relative paths are required unless ELISA_EDIR_SOURCE_ROOT is set") if not source_identity_create(&source_identity, parsed_source, parsed_source_length)
            return unsupported("the file must contain a `main` function and no more than the portable function limit") if file.top_decls.count == 0 or file.top_decls.count > Function::MAX_COUNT
            if file.top_decls.count > Shape::TOP_LEVEL_DECLARATION_COUNT:
                function_plans: mutable darray[EDIRFunctionPlan] = []
                function_error: mutable sview = ""
                return unsupported("multiple declarations must be one parameterless `main` followed by uniquely named pure `i64` helpers with one immutable `i64` parameter and no effects or decorators") if not collect_function_plans(file, &function_plans, &function_error)
                return functions_artifact(output_path, function_plans, source_identity)

            match file.top_decls[Shape::FIRST_TOP_LEVEL_DECLARATION_INDEX]:
                Ast::Decl.Func(function_name, parameters, return_type, body, effects, decorators, function_position):
                    return unsupported("the only function must be named `main`") if function_name != Function::MAIN_NAME
                    return unsupported("`main` must have no parameters") if parameters.count != Shape::PARAMETER_COUNT
                    if return_type is declared_type_expression:
                        match declared_type_expression:
                            Ast::Expr.Ident(type_name, type_position):
                                return unsupported("`main` must have an explicit `i64` return type") if type_name != "i64"
                            _:
                                return unsupported("`main` must have an explicit `i64` return type")
                    else:
                        return unsupported("`main` must have an explicit `i64` return type")
                    return unsupported("function effects are not supported in this slice") if effects.count != 0
                    return unsupported("function decorators are not supported in this slice") if decorators.count != 0
                    main_source_span: Ast::Pos = function_source_span(function_position, body)
                    return unsupported("`main` function descriptor has no usable source span") if not position_is_usable(main_source_span)
                    if ElisaCoreIR::lower_main(file) is core_program:
                        return core_ir_artifact(output_path, core_program, main_source_span, source_identity)
                    if body.count == CountedLoop::STATEMENT_COUNT:
                        return counted_loop_artifact(output_path, body, main_source_span, source_identity)
                    return unsupported("`main` must contain one return, one typed local followed by return, or one supported counted loop") if body.count != Shape::STATEMENT_COUNT and body.count != Shape::LOCAL_STATEMENT_COUNT
                    if body.count == Shape::STATEMENT_COUNT:
                        match body[Shape::FIRST_STATEMENT_INDEX]:
                            Ast::Stmt.Return(return_value, return_position):
                                if return_value is returned_expression:
                                    match returned_expression:
                                        Ast::Expr.IntLit(literal_value, literal_position):
                                            return literal_artifact(output_path, literal_value, literal_position, return_position, main_source_span, source_identity)
                                        Ast::Expr.Binary(left, operator, right, _):
                                            supported_operator: mutable bool = false
                                            opcode: u16 = binary_opcode(operator, &supported_operator)
                                            return unsupported("the return arithmetic operator must be `+`, `-`, `*`, or `/`") if not supported_operator
                                            match left:
                                                Ast::Expr.IntLit(left_value, left_position):
                                                    match right:
                                                        Ast::Expr.IntLit(right_value, right_position):
                                                            return binary_artifact(output_path, opcode, left_value, left_position, right_value, right_position, return_position, main_source_span, source_identity)
                                                        _:
                                                            return unsupported("both operands of return arithmetic must be integer literals")
                                                _:
                                                    return unsupported("both operands of return arithmetic must be integer literals")
                                        _:
                                            return unsupported("`main` must return an integer literal or a supported integer-literal arithmetic expression")
                                else:
                                    return unsupported("`main` must return an integer literal or a supported integer-literal arithmetic expression")
                            _:
                                return unsupported("the single statement in `main` must be a return")
                    match body[Shape::FIRST_STATEMENT_INDEX]:
                        Ast::Stmt.VarDecl(local_name, local_type, local_initializer, declaration_position):
                            return unsupported("the local name must be a named identifier") if local_name == "" or local_name == "_"
                            match local_type:
                                Ast::Expr.Ident(local_type_name, _):
                                    return unsupported("the local must have an explicit `i64` type") if local_type_name != "i64"
                                _:
                                    return unsupported("the local must have an explicit `i64` type")
                            match local_initializer:
                                Ast::Expr.IntLit(local_value, initializer_position):
                                    match body[Shape::SECOND_STATEMENT_INDEX]:
                                        Ast::Stmt.Return(return_value, return_position):
                                            if return_value is returned_expression:
                                                return local_return_artifact(output_path, local_name, local_value, declaration_position, initializer_position, returned_expression, return_position, main_source_span, source_identity)
                                            else:
                                                return unsupported("the second statement in `main` must return the initialized local")
                                        _:
                                            return unsupported("the second statement in `main` must be a return")
                                _:
                                    return unsupported("the local initializer must be an integer literal")
                        _:
                            return unsupported("the first statement in `main` must be one typed local declaration")
                _:
                    return unsupported("the only top-level declaration must be `def main`")
