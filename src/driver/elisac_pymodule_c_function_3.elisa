# `-emit pymodule` — one exported function's C wrapper, stage 3 of 5: the remaining parameter
# conversions — the container and struct shapes whose setup needs its own arena and reference
# table. Continues elisac_pymodule_c_function_2.elisa.

def emit_pymodule_c_function_3(buffer: mutable darray[u8]&, file: mutable Ast::File&, module_name: sview, annotation: Ast::EnumAnnotation) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    return if annotation.name != "__pymodule_fn"
    target_name: mutable sview = ""
    for target_annotation in file.enum_annotations |target_name, annotation|:
        target_name <- target_annotation.owner if target_annotation.name == "__pymodule_target_ref" and target_annotation.line == annotation.line
    target_decl: Ast::Decl? = pymodule_find_function_in(file.top_decls, target_name)
    if target_decl is target_function:
        if target_function is Decl.Func(target_function_name, source_params, target_return, target_body, target_effects, target_decorators, target_pos):
            target_params: mutable darray[Ast::ParamDecl] = pymodule_alias_normalize_params(file, source_params)
            return_type_name: mutable sview = "void"
            if target_return is declared_return:
                return_type_name <- pymodule_alias_type_name(file, declared_return)
            is_error: bool = pymodule_function_is_error(file, target_name)
            error_family: sview = pymodule_function_error_family(file, target_name) if is_error else ""
            has_payload_error: bool = is_error and pymodule_error_set_has_payload_in(file.top_decls, error_family)
            payload_type_name: sview = pymodule_error_payload_type_in(file, file.top_decls, error_family) if has_payload_error else ""
            structured_payload_error: bool = has_payload_error and pymodule_error_payload_is_structured_in(file.top_decls, error_family)
            has_payload_arena: bool = has_payload_error and pymodule_error_payload_needs_arena_in(file, file.top_decls, error_family)
            has_payload_struct: bool = has_payload_error and (pymodule_struct_return_supported(file, payload_type_name) if not structured_payload_error else pymodule_error_payload_contains_struct_in(file, file.top_decls, error_family))
            has_darray_param: mutable bool = false
            for darray_probe in target_params |has_darray_param|:
                has_darray_param <- true if pymodule_is_darray_type(pymodule_alias_type_name(file, darray_probe.type_expression))
            has_darray_ref_param: mutable bool = false
            for darray_ref_probe in target_params |has_darray_ref_param|:
                darray_ref_type_name: sview = pymodule_alias_type_name(file, darray_ref_probe.type_expression)
                has_darray_ref_param <- true if pymodule_darray_ref_parameter(darray_ref_type_name, darray_ref_probe.type_expression)
            has_struct_darray_param: mutable bool = false
            for struct_darray_probe in target_params |has_struct_darray_param|:
                struct_darray_type_name: sview = pymodule_alias_type_name(file, struct_darray_probe.type_expression)
                # Direct struct inputs also own a temporary arena/reference table.  Treat
                # them like aggregate sequence inputs so scalar-return wrappers cannot take
                # the expression fast path and leak that storage after a successful call.
                if pymodule_struct_input_supported(file, struct_darray_type_name):
                    has_struct_darray_param <- true
                elif pymodule_is_darray_type(struct_darray_type_name) or pymodule_is_view_type(struct_darray_type_name):
                    struct_darray_element_name: sview = pymodule_darray_element_name(struct_darray_type_name) if pymodule_is_darray_type(struct_darray_type_name) else pymodule_view_element_name(struct_darray_type_name)
                    has_struct_darray_param <- true if pymodule_struct_input_supported(file, struct_darray_element_name)
            has_dict_param: mutable bool = false
            for dict_probe in target_params |has_dict_param|:
                has_dict_param <- true if pymodule_is_dict_type(pymodule_alias_type_name(file, dict_probe.type_expression))
            has_set_param: mutable bool = false
            for set_probe in target_params |has_set_param|:
                has_set_param <- true if pymodule_is_set_type(pymodule_alias_type_name(file, set_probe.type_expression))
            has_view_param: mutable bool = false
            for view_probe in target_params |has_view_param|:
                has_view_param <- true if pymodule_is_view_type(pymodule_alias_type_name(file, view_probe.type_expression))
            has_dict_return: bool = pymodule_is_dict_type(return_type_name)
            has_set_return: bool = pymodule_is_set_type(return_type_name)
            has_view_return: bool = pymodule_is_view_type(return_type_name)
            has_optional_return: bool = pymodule_is_optional_scalar_type(return_type_name)
            has_struct_return: bool = pymodule_struct_return_supported(file, return_type_name)
            has_fixed_array_return: bool = pymodule_fixed_array_return_supported(return_type_name)
            has_output_arena: bool = pymodule_is_darray_type(return_type_name) or has_dict_return or has_set_return or (has_struct_return and pymodule_struct_return_contains_darray(file, return_type_name)) or has_payload_arena
            has_return_arena: bool = has_output_arena or has_darray_ref_param
            for parameter_index in 0..<target_params.count |buffer, target_params|:
                emit_pymodule_argument_context(buffer, annotation.owner, target_params[parameter_index].name, pymodule_alias_type_name(file, target_params[parameter_index].type_expression), "    ")
                parameter_type_name: sview = pymodule_alias_type_name(file, target_params[parameter_index].type_expression)
                if pymodule_fixed_array_input_supported(file, parameter_type_name, target_params[parameter_index].type_expression):
                    emit_pymodule_fixed_array_input_setup(buffer, pymodule_fixed_array_element_name(parameter_type_name), pymodule_fixed_array_extent(parameter_type_name), parameter_index, annotation.owner, target_params[parameter_index].name)
                elif pymodule_is_darray_type(parameter_type_name) or pymodule_is_view_type(parameter_type_name):
                    nested_parameter_element: sview = pymodule_darray_element_name(parameter_type_name) if pymodule_is_darray_type(parameter_type_name) else ""
                    if pymodule_is_darray_type(parameter_type_name) and pymodule_is_view_type(nested_parameter_element):
                        emit_tokens_push_sview(buffer, "    if (elisa_pymodule_")
                        emit_tokens_push_sview(buffer, module_name)
                        emit_tokens_push_sview(buffer, "_")
                        emit_tokens_push_sview(buffer, annotation.owner)
                        emit_tokens_push_sview(buffer, "_view_")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_from_py(arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, ", &arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_value, &arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_struct_arena, &arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_struct_refs) < 0) {\n")
                        emit_pymodule_argument_error_annotation(buffer, annotation.owner, target_params[parameter_index].name, "        ")
                        emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                        emit_tokens_push_sview(buffer, "        return NULL;\n    }\n")
                    elif pymodule_is_darray_type(parameter_type_name) and (pymodule_is_darray_type(nested_parameter_element) or pymodule_is_set_type(nested_parameter_element)):
                        emit_tokens_push_sview(buffer, "    if (elisa_pymodule_")
                        emit_tokens_push_sview(buffer, module_name)
                        emit_tokens_push_sview(buffer, "_")
                        emit_tokens_push_sview(buffer, annotation.owner)
                        emit_tokens_push_sview(buffer, "_nested_")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_from_py(arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, ", &arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_value, &arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_struct_arena, &arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_struct_refs) < 0) {\n")
                        emit_pymodule_argument_error_annotation(buffer, annotation.owner, target_params[parameter_index].name, "        ")
                        emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                        emit_tokens_push_sview(buffer, "        return NULL;\n    }\n")
                    elif pymodule_darray_is_bytes(parameter_type_name):
                        emit_tokens_push_sview(buffer, "    arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_bytes = PyBytes_FromObject(arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, ");\n    if (arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_bytes == NULL) {\n")
                        emit_pymodule_argument_error_annotation(buffer, annotation.owner, target_params[parameter_index].name, "        ")
                        emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                        emit_tokens_push_sview(buffer, "        return NULL;\n    }\n")
                        emit_tokens_push_sview(buffer, "    char *arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_data;\n    Py_ssize_t arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_len;\n    if (PyBytes_AsStringAndSize(arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_bytes, &arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_data, &arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_len) < 0) {\n")
                        emit_pymodule_argument_error_annotation(buffer, annotation.owner, target_params[parameter_index].name, "        ")
                        emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                        emit_tokens_push_sview(buffer, "        return NULL;\n    }\n    ElisaDArray arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_value = {(void *)arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_data, (int64_t)arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_len, (int64_t)arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_len};\n")
                    else:
                        element_name: sview = pymodule_darray_element_name(parameter_type_name) if pymodule_is_darray_type(parameter_type_name) else pymodule_view_element_name(parameter_type_name)
                        element_c_type: mutable sview = pymodule_darray_c_element_type(element_name)
                        element_c_type <- "ElisaDict" if pymodule_is_dict_type(element_name)
                        element_c_type <- element_name if element_c_type == "" and pymodule_struct_input_supported(file, element_name)
                        emit_tokens_push_sview(buffer, "    arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_seq = PySequence_Fast(arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, ", \"expected a sequence\");\n    if (arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_seq == NULL) {\n")
                        emit_pymodule_argument_error_annotation(buffer, annotation.owner, target_params[parameter_index].name, "        ")
                        emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                        emit_tokens_push_sview(buffer, "        return NULL;\n    }\n    Py_ssize_t arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_len = PySequence_Fast_GET_SIZE(arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_seq);\n    if (arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_len > PY_SSIZE_T_MAX / (Py_ssize_t)sizeof(")
                        emit_tokens_push_sview(buffer, element_c_type)
                        emit_tokens_push_sview(buffer, ")) {\n        PyErr_SetString(PyExc_OverflowError, \"sequence is too large\");\n")
                        emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                        emit_tokens_push_sview(buffer, "        return NULL;\n    }\n    arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_items = PyMem_Malloc((size_t)arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_len * sizeof(")
                        emit_tokens_push_sview(buffer, element_c_type)
                        emit_tokens_push_sview(buffer, "));\n    if (arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_items == NULL && arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_len != 0) {\n        PyErr_NoMemory();\n")
                        emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                        emit_tokens_push_sview(buffer, "        return NULL;\n    }\n    for (Py_ssize_t arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_index = 0; arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_index < arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_len; ++arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_index) {\n        PyObject *arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_item = PySequence_Fast_GET_ITEM(arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_seq, arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_index);\n        Py_ssize_t arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_path_mark = elisa_pymodule_current_path_length; if (elisa_pymodule_current_path_push_index(arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_index) < 0) {\n")
                        emit_pymodule_darray_cleanup(buffer, target_params, "            ")
                        emit_tokens_push_sview(buffer, "            return NULL;\n        }\n")
                        if pymodule_is_dict_type(element_name):
                            emit_tokens_push_sview(buffer, "        if (elisa_pymodule_")
                            emit_tokens_push_sview(buffer, module_name)
                            emit_tokens_push_sview(buffer, "_")
                            emit_tokens_push_sview(buffer, annotation.owner)
                            emit_tokens_push_sview(buffer, "_darray_dict_")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_from_py(arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item, &((ElisaDict *)arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_items)[arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_index], &arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_struct_arena, &arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_struct_refs) < 0) {\n")
                            emit_pymodule_darray_cleanup(buffer, target_params, "            ")
                            emit_tokens_push_sview(buffer, "            return NULL;\n        }\n")
                        elif pymodule_struct_input_supported(file, element_name):
                            emit_tokens_push_sview(buffer, "        if (elisa_pymodule_struct_")
                            emit_tokens_push_sview(buffer, element_name)
                            emit_tokens_push_sview(buffer, "_from_py(arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item, &arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_items[arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_index], &arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_struct_arena, &arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_struct_refs) < 0) {\n")
                            emit_pymodule_darray_cleanup(buffer, target_params, "            ")
                            emit_tokens_push_sview(buffer, "            return NULL;\n        }\n")
                        elif pymodule_darray_element_is_optional_sview(element_name):
                            emit_tokens_push_sview(buffer, "        ElisaOptionalSView arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_value = {false, {0, 0}};\n        if (arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item != Py_None) {\n            Py_ssize_t arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_len; const char *arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_data = PyUnicode_AsUTF8AndSize(arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item, &arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_len);\n            if (arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_data == NULL) {\n")
                            emit_pymodule_darray_cleanup(buffer, target_params, "                ")
                            emit_tokens_push_sview(buffer, "                return NULL;\n            }\n            arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_value = (ElisaOptionalSView){true, (ElisaSView){arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_data, (int64_t)arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_len}};\n        }\n        arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_items[arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_index] = arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_value;\n")
                        elif pymodule_darray_element_is_optional_scalar(element_name):
                            emit_pymodule_darray_optional_scalar_input(buffer, target_params, element_name, parameter_index)
                        elif pymodule_darray_element_is_sview(element_name):
                            emit_tokens_push_sview(buffer, "        Py_ssize_t arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_len;\n        const char *arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_data = PyUnicode_AsUTF8AndSize(arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item, &arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_len);\n        if (arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_data == NULL) {\n")
                            emit_pymodule_darray_cleanup(buffer, target_params, "            ")
                            emit_tokens_push_sview(buffer, "            return NULL;\n        }\n        arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_items[arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_index] = (ElisaSView){arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_data, (int64_t)arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_len};\n")
                        elif pymodule_darray_element_is_optional_cstr(element_name):
                            emit_tokens_push_sview(buffer, "        if (arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item == Py_None) {\n            arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_items[arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_index] = NULL;\n        } else {\n            Py_ssize_t arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_len;\n            const char *arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_data = PyUnicode_AsUTF8AndSize(arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item, &arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_len);\n            if (arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_data == NULL) {\n")
                            emit_pymodule_darray_cleanup(buffer, target_params, "                ")
                            emit_tokens_push_sview(buffer, "                return NULL;\n            }\n            for (Py_ssize_t arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_nul_index = 0; arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_nul_index < arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_len; ++arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_nul_index) {\n                if (arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_data[arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_nul_index] == '\\0') {\n                    PyErr_SetString(PyExc_ValueError, \"cstr list elements may not contain NUL bytes\");\n")
                            emit_pymodule_darray_cleanup(buffer, target_params, "                    ")
                            emit_tokens_push_sview(buffer, "                    return NULL;\n                }\n            }\n            arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_items[arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_index] = arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_data;\n        }\n")
                        elif pymodule_darray_element_is_cstr(element_name):
                            emit_tokens_push_sview(buffer, "        Py_ssize_t arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_len;\n        const char *arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item_data = PyUnicode_AsUTF8AndSize(arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_item, &arg")
