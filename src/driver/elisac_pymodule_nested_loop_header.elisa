# Rewrite the generated nested-sequence loop header so each nested element records its index
# path before conversion and releases the dictionary's buckets when conversion fails.
def pymodule_rewrite_nested_loop_header(buffer: mutable darray[u8]&, file: Ast::File&, target_params: darray[Ast::ParamDecl]&, parameter_index: usize) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    nested_loop_needle: mutable darray[u8] = []
    emit_tokens_push_sview(&nested_loop_needle, "for (Py_ssize_t arg")
    append_decimal(&nested_loop_needle, parameter_index.i64())
    emit_tokens_push_sview(&nested_loop_needle, "_nested_index = 0; arg")
    append_decimal(&nested_loop_needle, parameter_index.i64())
    emit_tokens_push_sview(&nested_loop_needle, "_nested_index < arg")
    append_decimal(&nested_loop_needle, parameter_index.i64())
    emit_tokens_push_sview(&nested_loop_needle, "_nested_len; ++arg")
    append_decimal(&nested_loop_needle, parameter_index.i64())
    emit_tokens_push_sview(&nested_loop_needle, "_nested_index) { PyObject *arg")
    append_decimal(&nested_loop_needle, parameter_index.i64())
    emit_tokens_push_sview(&nested_loop_needle, "_nested_item = PySequence_Fast_GET_ITEM(arg")
    append_decimal(&nested_loop_needle, parameter_index.i64())
    emit_tokens_push_sview(&nested_loop_needle, "_nested_seq, arg")
    append_decimal(&nested_loop_needle, parameter_index.i64())
    emit_tokens_push_sview(&nested_loop_needle, "_nested_index); ")
    nested_loop_replacement: mutable darray[u8] = []
    emit_tokens_push_sview(&nested_loop_replacement, "Py_ssize_t arg")
    append_decimal(&nested_loop_replacement, parameter_index.i64())
    emit_tokens_push_sview(&nested_loop_replacement, "_nested_path_base = elisa_pymodule_current_path_length; for (Py_ssize_t arg")
    append_decimal(&nested_loop_replacement, parameter_index.i64())
    emit_tokens_push_sview(&nested_loop_replacement, "_nested_index = 0; arg")
    append_decimal(&nested_loop_replacement, parameter_index.i64())
    emit_tokens_push_sview(&nested_loop_replacement, "_nested_index < arg")
    append_decimal(&nested_loop_replacement, parameter_index.i64())
    emit_tokens_push_sview(&nested_loop_replacement, "_nested_len; ++arg")
    append_decimal(&nested_loop_replacement, parameter_index.i64())
    emit_tokens_push_sview(&nested_loop_replacement, "_nested_index) { elisa_pymodule_current_path_restore(arg")
    append_decimal(&nested_loop_replacement, parameter_index.i64())
    emit_tokens_push_sview(&nested_loop_replacement, "_nested_path_base); if (elisa_pymodule_current_path_push_index(arg")
    append_decimal(&nested_loop_replacement, parameter_index.i64())
    emit_tokens_push_sview(&nested_loop_replacement, "_nested_index) < 0) { Py_DECREF(arg")
    append_decimal(&nested_loop_replacement, parameter_index.i64())
    emit_tokens_push_sview(&nested_loop_replacement, "_nested_seq);\n")
    emit_pymodule_dict_cleanup_one(&nested_loop_replacement, target_params, parameter_index, "            ", true, file)
    emit_tokens_push_sview(&nested_loop_replacement, "            return NULL; } PyObject *arg")
    append_decimal(&nested_loop_replacement, parameter_index.i64())
    emit_tokens_push_sview(&nested_loop_replacement, "_nested_item = PySequence_Fast_GET_ITEM(arg")
    append_decimal(&nested_loop_replacement, parameter_index.i64())
    emit_tokens_push_sview(&nested_loop_replacement, "_nested_seq, arg")
    append_decimal(&nested_loop_replacement, parameter_index.i64())
    emit_tokens_push_sview(&nested_loop_replacement, "_nested_index); ")
    pymodule_replace_generated(buffer, bytes_view_range(nested_loop_needle, 0, nested_loop_needle.count), bytes_view_range(nested_loop_replacement, 0, nested_loop_replacement.count))
