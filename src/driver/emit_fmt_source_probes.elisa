# `-emit fmt` — the SOURCE-LINE probes. Some spellings survive only in the tokens, not in the
# AST: a postfix `can` grant, a statement guard's trailing grant, an implicit `submit`, a `try`
# before a call, a bare binding target, the K-th `cast[` bracket on a line. Each one is a
# read-only look at the token stream. Continues emit_fmt_expr.elisa.

extend FmtUnparse:
    public:

        # POSTFIX `EXPR can E` applies only to a single EXPRESSION statement that is not
        # a `panic(...)` — an `if`/`while`/anything else keeps the block form (measured:
        # string_escapes' single-if can-block prints as a block under stage0).
        # A `static` block whose line carries no if/elif/else is the DIRECTIVE form.
        def fmt_static_is_directive(tokens: darray[Lexer::Token]&, source: u8&, line: u32, offset: u32) -> bool:
            can Memory.Allocate, Abort.Panic:
                fmt_sdir_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
                false return if not fmt_sdir_range.found
                for fmt_sdir_probe in fmt_sdir_range.start..<fmt_sdir_range.stop |tokens|:
                    fmt_sdir_kind: Lexer::TokenKind = tokens[fmt_sdir_probe].kind
                    false return if fmt_sdir_kind == Lexer::TokenKind.If or fmt_sdir_kind == Lexer::TokenKind.Elif or fmt_sdir_kind == Lexer::TokenKind.Else
                return true



        def fmt_can_is_postfixable(statement: Ast::Stmt, tokens: darray[Lexer::Token]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                if statement is Stmt.Expr(fmt_cp_expr, fmt_cp_line):
                    if fmt_cp_expr is Expr.Call(fmt_cp_callee, fmt_cp_args, fmt_cp_names, fmt_cp_cl):
                        if fmt_cp_callee is Expr.Ident(fmt_cp_name, fmt_cp_il):
                            return fmt_cp_name != "panic"
                    return true
                if statement is Stmt.Return(fmt_cp_ret, fmt_cp_rl):
                    return true
                # stage0's formatInlineCanStmt also collapses AssignStmt / DiscardStmt
                # (`_ = sched_yield() can Thread.Yield`) and VarDeclStmt.
                if statement is Stmt.Assign(fmt_cp_at, fmt_cp_ao, fmt_cp_av, fmt_cp_al):
                    return true
                if statement is Stmt.VarDecl(fmt_cp_vn, fmt_cp_vt, fmt_cp_vv, fmt_cp_vl):
                    return true
                # A `catch …:` handler is an EXPRESSION statement in stage0, so a lone one
                # postfixes its grant. A real `match` is a STATEMENT there and does not.
                if statement is Stmt.Match(fmt_cp_scrut, fmt_cp_arms, fmt_cp_ml):
                    return fmt_line_starts_with_catch(tokens, fmt_cp_ml.line, fmt_cp_ml.offset)
                return false



        # The number of `.cast[...]` nodes inside an expression subtree ON LINE — the K of
        # the bracket-pairing rule (see fmt_cast_claimed). The line filter matters for a
        # MULTI-LINE call: an argument's cast on its own line has its own ordinal space
        # and must not shift the closing line's chain. Walks the shapes a cast head can
        # practically contain; an unlisted shape contributes 0 (a mispair there would show
        # as a byte diff, never silently).
        def fmt_count_casts(expression: Ast::Expr, line: u32) -> i64:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Index(fmt_cc_head, fmt_cc_arg, fmt_cc_line):
                        fmt_cc_self: mutable i64 = 0
                        match fmt_cc_head:
                            Expr.Field(_, fmt_cc_name, _):
                                fmt_cc_self <- 1 if fmt_cc_name == "cast" and fmt_cc_line.line == line
                            _:
                                pass
                        return fmt_cc_self + fmt_count_casts(fmt_cc_head, line) + fmt_count_casts(fmt_cc_arg, line)
                    Expr.Field(fmt_cc_fobj, _, _):
                        return fmt_count_casts(fmt_cc_fobj, line)
                    Expr.Call(fmt_cc_callee, fmt_cc_args, _, _):
                        fmt_cc_total: mutable i64 = fmt_count_casts(fmt_cc_callee, line)
                        for fmt_cc_argument in fmt_cc_args |fmt_cc_total, line|:
                            fmt_cc_total <- fmt_cc_total + fmt_count_casts(fmt_cc_argument, line)
                        return fmt_cc_total
                    Expr.Unary(_, fmt_cc_operand, _):
                        return fmt_count_casts(fmt_cc_operand, line)
                    Expr.Paren(fmt_cc_inner, _):
                        return fmt_count_casts(fmt_cc_inner, line)
                    Expr.Binary(fmt_cc_left, _, fmt_cc_right, _):
                        return fmt_count_casts(fmt_cc_left, line) + fmt_count_casts(fmt_cc_right, line)
                    Expr.Move(fmt_cc_moperand, _):
                        return fmt_count_casts(fmt_cc_moperand, line)
                    _:
                        return 0



        # stage0's peekIsBareBindingTarget name test: lowercase first byte, and not one of
        # the builtin bare type names (`x is u8` stays a TYPE TEST).
        def fmt_is_bare_binding_name(name: sview) -> bool:
            can Abort.Panic:
                false return if sview_len(name) == 0
                fmt_bb_first: u8 = sview_at(name, 0)
                false return if fmt_bb_first < 97 or fmt_bb_first > 122
                false return if name == "void" or name == "bool" or name == "char" or name == "int"
                false return if name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "isize"
                false return if name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "usize" or name == "uintptr"
                false return if name == "f32" or name == "f64" or name == "cstr" or name == "dstr"
                return true



        # A source-postfix effect grant (`STMT can E1, E2`) survives only in the tokens —
        # the parser files it in a side table. Render ` can …` from the depth-0 `can`
        # identifier on LINE, or nothing when the line carries none.
        def fmt_render_postfix_can(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32, offset: u32) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                return if line == fmt_can_claimed_line
                range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
                return if not range.found
                stop: mutable usize = range.stop
                while stop < tokens.count and tokens[stop].line == line and tokens[stop].kind != Lexer::TokenKind.Newline |stop, tokens|:
                    stop <- stop + 1
                can_index: mutable usize = 0
                can_found: mutable bool = false
                grant_stop: mutable usize = stop
                depth: mutable i64 = 0
                for probe in range.start..<stop |can_index, can_found, grant_stop, depth, tokens, source|:
                    kind: Lexer::TokenKind = tokens[probe].kind
                    depth <- depth + 1 if kind == Lexer::TokenKind.LParen or kind == Lexer::TokenKind.LBracket
                    depth <- depth - 1 if kind == Lexer::TokenKind.RParen or kind == Lexer::TokenKind.RBracket
                    # A depth-0 postfix `if` ends the grant span: the parser desugared it
                    # into the enclosing block; the tail is not part of the clause.
                    grant_stop <- probe if can_found and depth == 0 and kind == Lexer::TokenKind.If and probe < grant_stop
                    continue if can_found
                    continue if depth != 0 or kind != Lexer::TokenKind.Ident
                    if Lexer::text_or_empty(tokens[probe], source) == "can":
                        # A `can[` at depth 0 is a TYPE'S effect row (`fn(A) -> R can[P]`),
                        # never a statement grant — a grant's first effect is a bare name.
                        continue if probe + 1 < stop and tokens[probe + 1].kind == Lexer::TokenKind.LBracket
                        can_index <- probe
                        can_found <- true
                return if not can_found
                fmt_push(buffer, " can ")
                emit_iface_render_tokens(buffer, tokens, source, can_index + 1, grant_stop)



        # A postfix statement guard whose grant trails the condition
        # (`X return if C can E1, E2`). The guard desugars to an `if` statement, and stage0
        # prints the grant on the synthesized header — so recover it here, from the depth-0
        # `can` that FOLLOWS the depth-0 `if`. Renders ` can …` and returns true on a match;
        # leaves BUFFER untouched and returns false otherwise (a leading-`if` block header, a
        # grant that precedes the guard, or no grant at all).
        def fmt_render_guard_can(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32, offset: u32) -> bool:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
                false return if not range.found
                # A line that OPENS with `if` is a real block header, not a guard: its grant
                # (when any) is already the header's own and renders from the block body.
                false return if tokens[range.start].kind == Lexer::TokenKind.If
                guard: mutable usize = 0
                guard_found: mutable bool = false
                can_index: mutable usize = 0
                can_found: mutable bool = false
                depth: mutable i64 = 0
                for probe in range.start..<range.stop |guard, guard_found, can_index, can_found, depth, tokens, source|:
                    kind: Lexer::TokenKind = tokens[probe].kind
                    depth <- depth + 1 if kind == Lexer::TokenKind.LParen or kind == Lexer::TokenKind.LBracket
                    depth <- depth - 1 if kind == Lexer::TokenKind.RParen or kind == Lexer::TokenKind.RBracket
                    continue if depth != 0
                    if kind == Lexer::TokenKind.If and not guard_found:
                        guard <- probe
                        guard_found <- true
                    continue if not guard_found or can_found or kind != Lexer::TokenKind.Ident
                    if Lexer::text_or_empty(tokens[probe], source) == "can":
                        # `can[` at depth 0 is a TYPE's effect row, never a grant.
                        continue if probe + 1 < range.stop and tokens[probe + 1].kind == Lexer::TokenKind.LBracket
                        can_index <- probe
                        can_found <- true
                false return if not can_found
                fmt_push(buffer, " can ")
                emit_iface_render_tokens(buffer, tokens, source, can_index + 1, range.stop)
                return true



        # Does LINE open with `submit` and NO `[pool]` selector? The parser consumes both
        # the keyword and the selector, so only the tokens still tell a nursery submission
        # (which stage0 collects into the enclosing group) from an explicitly pooled one.
        def fmt_line_is_implicit_submit(tokens: darray[Lexer::Token]&, source: u8&, line: u32, offset: u32) -> bool:
            can Abort.Panic, Memory.Allocate:
                range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
                false return if not range.found or range.start >= tokens.count
                false return if tokens[range.start].kind != Lexer::TokenKind.Ident
                false return if Lexer::text_or_empty(tokens[range.start], source) != "submit"
                return range.start + 1 >= tokens.count or tokens[range.start + 1].kind != Lexer::TokenKind.LBracket



        # Does LINE open with the `catch` keyword? (A catch handler and a `match` build
        # the same node; only the source spelling separates them.)
        def fmt_line_starts_with_catch(tokens: darray[Lexer::Token]&, line: u32, offset: u32) -> bool:
            can Abort.Panic, Memory.Allocate:
                range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
                false return if not range.found or range.start >= tokens.count
                return tokens[range.start].kind == Lexer::TokenKind.Catch



        # The head identifier of a callee: `f`, `f[T]`, `M::f`, `x.f` all reduce to the
        # name a `try` keyword would sit in front of.
        def fmt_call_head_name(expression: Ast::Expr) -> sview:
            can Abort.Panic, Memory.Allocate:
                match expression:
                    Expr.Ident(head_name, head_line):
                        return head_name
                    Expr.IndexN(head_object, head_args, head_line2):
                        return fmt_call_head_name(head_object)
                    Expr.Index(head_object2, head_index, head_line3):
                        return fmt_call_head_name(head_object2)
                    Expr.Scope(head_base, head_scope_name, head_line4):
                        return head_scope_name
                    Expr.Field(head_object3, head_field, head_line5):
                        return head_field
                    _:
                        return ""



        # Is the expression named NAME preceded by a `try` keyword on the current
        # statement's line? `try` is erased by the parser (it records a side-table
        # annotation), so the keyword is recovered from the tokens.
        def fmt_has_try_before(tokens: darray[Lexer::Token]&, source: u8&, line: u32, offset: u32, name: sview) -> bool:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                false return if name == "" or line == 0
                range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
                false return if not range.found
                stop: mutable usize = range.stop
                while stop < tokens.count and tokens[stop].line == line and tokens[stop].kind != Lexer::TokenKind.Newline |stop, tokens|:
                    stop <- stop + 1
                for probe in range.start..<stop |tokens, source, name|:
                    continue if tokens[probe].kind != Lexer::TokenKind.Try
                    continue if probe + 1 >= tokens.count or tokens[probe + 1].kind != Lexer::TokenKind.Ident
                    true return if Lexer::text_or_empty(tokens[probe + 1], source) == name
                return false



        # A TRY form takes surface parens when a `can` clause follows it (stage0's
        # formatExprWithSurfacePermissions wraps TryExpr / UnwrapElseExpr, nothing else).
        def fmt_expr_is_try_form(expression: Ast::Expr, tokens: darray[Lexer::Token]&, source: u8&, line: u32) -> bool:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                match expression:
                    Expr.Refinement(try_fallback, try_guarded, try_line):
                        return true
                    Expr.Call(try_callee, try_args, try_names, try_call_line):
                        return fmt_has_try_before(tokens, source, line, 0, fmt_call_head_name(try_callee))
                    _:
                        return false



        # Is NAME a FILE-LEVEL `def` in this token stream? (Indent depth 0 — module
        # members resolve through `::` paths, never UFCS.)
        def fmt_is_file_def(tokens: darray[Lexer::Token]&, source: u8&, name: sview) -> bool:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                depth: mutable i64 = 0
                for probe in 0..<tokens.count |depth, tokens, source, name|:
                    kind: Lexer::TokenKind = tokens[probe].kind
                    if kind == Lexer::TokenKind.Indent:
                        depth <- depth + 1
                    elif kind == Lexer::TokenKind.Dedent:
                        depth <- depth - 1
                    elif kind == Lexer::TokenKind.Def and depth == 0 and probe + 1 < tokens.count:
                        if tokens[probe + 1].kind == Lexer::TokenKind.Ident:
                            if Lexer::text_or_empty(tokens[probe + 1], source) == name:
                                # A GENERIC target def (`def pick[T](…)`) keeps the method form:
                                # stage0 defers its UFCS resolution, so `x.pick()` stays as
                                # written (MEASURED 2026-09-08, generic_default_argument).
                                return not (probe + 2 < tokens.count and tokens[probe + 2].kind == Lexer::TokenKind.LBracket)
                return false
