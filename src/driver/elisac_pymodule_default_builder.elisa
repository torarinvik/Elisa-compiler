# `-emit pymodule` — emitting the Python-side default VALUE builders and the signature literals
# the manifest carries for them.


def emit_pymodule_default_python_builder(buffer: mutable darray[u8]&, file: Ast::File&, builder_name: sview, type_name: sview, expression: Ast::Expr) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    # Emit nested builders first so every call site sees a complete static function
    # declaration without relying on C99 implicit declarations.
    if expression is Expr.Paren(default_inner, default_paren_pos):
        emit_pymodule_default_python_builder(buffer, file, builder_name, type_name, default_inner)
        return
    if pymodule_is_darray_type(type_name) or pymodule_is_view_type(type_name):
        element_type_name: sview = pymodule_darray_element_name(type_name) if pymodule_is_darray_type(type_name) else pymodule_view_element_name(type_name)
        if expression is Expr.Array(default_elements, default_array_pos):
            for default_element_index in 0..<default_elements.count |buffer, file, builder_name, element_type_name, default_elements, default_element_index|:
                if pymodule_default_is_container(default_elements[default_element_index]):
                    child_name_storage: mutable darray[u8] = []
                    child_name: sview = pymodule_default_builder_child_name(&child_name_storage, builder_name, "_item", default_element_index)
                    emit_pymodule_default_python_builder(buffer, file, child_name, element_type_name, default_elements[default_element_index])
    elif pymodule_is_dict_type(type_name):
        key_type_name: sview = pymodule_dict_key_name(type_name)
        value_type_name: sview = pymodule_dict_value_name(type_name)
        if expression is Expr.DictLit(default_entries, default_dict_pos):
            for default_entry_index in 0..<default_entries.count |buffer, file, builder_name, key_type_name, value_type_name, default_entries, default_entry_index|:
                if pymodule_default_is_container(default_entries[default_entry_index].key):
                    key_name_storage: mutable darray[u8] = []
                    key_name: sview = pymodule_default_builder_child_name(&key_name_storage, builder_name, "_key", default_entry_index)
                    emit_pymodule_default_python_builder(buffer, file, key_name, key_type_name, default_entries[default_entry_index].key)
                if pymodule_default_is_container(default_entries[default_entry_index].value):
                    value_name_storage: mutable darray[u8] = []
                    value_name: sview = pymodule_default_builder_child_name(&value_name_storage, builder_name, "_value", default_entry_index)
                    emit_pymodule_default_python_builder(buffer, file, value_name, value_type_name, default_entries[default_entry_index].value)
    elif pymodule_is_set_type(type_name):
        element_type_name: sview = pymodule_set_element_name(type_name)
        if expression is Expr.SetLit(default_set_elements, default_set_pos):
            for default_set_element_index in 0..<default_set_elements.count |buffer, file, builder_name, element_type_name, default_set_elements, default_set_element_index|:
                if pymodule_default_is_container(default_set_elements[default_set_element_index]):
                    child_name_storage: mutable darray[u8] = []
                    child_name: sview = pymodule_default_builder_child_name(&child_name_storage, builder_name, "_item", default_set_element_index)
                    emit_pymodule_default_python_builder(buffer, file, child_name, element_type_name, default_set_elements[default_set_element_index])
    else:
        declaration: Ast::Decl? = pymodule_find_struct_in(file.top_decls, type_name)
        if declaration is target:
            if target is Decl.Struct(default_struct_name, default_struct_members, default_struct_affinity, default_struct_named_states, default_struct_derive, default_struct_invariants, default_struct_pos):
                if expression is Expr.Construct(default_construct_type, default_construct_fields, default_construct_pos):
                    for default_construct_field in default_construct_fields |buffer, file, builder_name, type_name|:
                        if default_construct_field.name != "":
                            construct_field_type_name: sview = pymodule_struct_member_type_name(file, type_name, default_construct_field.name)
                            if pymodule_default_is_container(default_construct_field.value):
                                child_name_storage: mutable darray[u8] = []
                                child_name: sview = pymodule_default_builder_field_name(&child_name_storage, builder_name, default_construct_field.name)
                                emit_pymodule_default_python_builder(buffer, file, child_name, construct_field_type_name, default_construct_field.value)
    emit_tokens_push_sview(buffer, "static PyObject *")
    emit_tokens_push_sview(buffer, builder_name)
    emit_tokens_push_sview(buffer, "(void) {\n")
    if pymodule_is_darray_type(type_name) or pymodule_is_view_type(type_name):
        element_type_name: sview = pymodule_darray_element_name(type_name) if pymodule_is_darray_type(type_name) else pymodule_view_element_name(type_name)
        if expression is Expr.Array(default_elements_for_emit, default_array_pos_for_emit):
            emit_tokens_push_sview(buffer, "    PyObject *out = PyList_New(")
            append_decimal(buffer, default_elements_for_emit.count.i64())
            emit_tokens_push_sview(buffer, "); if (out == NULL) return NULL;\n")
            for default_element_index_for_emit in 0..<default_elements_for_emit.count |buffer, builder_name, element_type_name, default_elements_for_emit, default_element_index_for_emit|:
                emit_tokens_push_sview(buffer, "    PyObject *item")
                append_decimal(buffer, default_element_index_for_emit.i64())
                emit_tokens_push_sview(buffer, " = ")
                if pymodule_default_is_container(default_elements_for_emit[default_element_index_for_emit]):
                    child_name_storage_for_emit: mutable darray[u8] = []
                    child_name_for_emit: sview = pymodule_default_builder_child_name(&child_name_storage_for_emit, builder_name, "_item", default_element_index_for_emit)
                    emit_tokens_push_sview(buffer, child_name_for_emit)
                    emit_tokens_push_sview(buffer, "()")
                else:
                    emit_pymodule_default_python_scalar(buffer, file, element_type_name, default_elements_for_emit[default_element_index_for_emit])
                emit_tokens_push_sview(buffer, "; if (item")
                append_decimal(buffer, default_element_index_for_emit.i64())
                emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(out); return NULL; } PyList_SET_ITEM(out, ")
                append_decimal(buffer, default_element_index_for_emit.i64())
                emit_tokens_push_sview(buffer, ", item")
                append_decimal(buffer, default_element_index_for_emit.i64())
                emit_tokens_push_sview(buffer, ");\n")
            if type_name == "darray[u8]":
                emit_tokens_push_sview(buffer, "    PyObject *bytes = PyBytes_FromObject(out); Py_DECREF(out); return bytes;\n")
            else:
                emit_tokens_push_sview(buffer, "    return out;\n")
    elif pymodule_is_dict_type(type_name):
        key_type_name: sview = pymodule_dict_key_name(type_name)
        value_type_name: sview = pymodule_dict_value_name(type_name)
        if expression is Expr.DictLit(default_entries_for_emit, default_dict_pos_for_emit):
            emit_tokens_push_sview(buffer, "    PyObject *out = PyDict_New(); if (out == NULL) return NULL;\n")
            for default_entry_index_for_emit in 0..<default_entries_for_emit.count |buffer, builder_name, key_type_name, value_type_name, default_entries_for_emit, default_entry_index_for_emit|:
                emit_tokens_push_sview(buffer, "    PyObject *key")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, " = ")
                if pymodule_default_is_container(default_entries_for_emit[default_entry_index_for_emit].key):
                    key_name_storage_for_emit: mutable darray[u8] = []
                    key_name_for_emit: sview = pymodule_default_builder_child_name(&key_name_storage_for_emit, builder_name, "_key", default_entry_index_for_emit)
                    emit_tokens_push_sview(buffer, key_name_for_emit)
                    emit_tokens_push_sview(buffer, "()")
                else:
                    emit_pymodule_default_python_scalar(buffer, file, key_type_name, default_entries_for_emit[default_entry_index_for_emit].key)
                emit_tokens_push_sview(buffer, "; if (key")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(out); return NULL; }\n    PyObject *value")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, " = ")
                if pymodule_default_is_container(default_entries_for_emit[default_entry_index_for_emit].value):
                    value_name_storage_for_emit: mutable darray[u8] = []
                    value_name_for_emit: sview = pymodule_default_builder_child_name(&value_name_storage_for_emit, builder_name, "_value", default_entry_index_for_emit)
                    emit_tokens_push_sview(buffer, value_name_for_emit)
                    emit_tokens_push_sview(buffer, "()")
                else:
                    emit_pymodule_default_python_scalar(buffer, file, value_type_name, default_entries_for_emit[default_entry_index_for_emit].value)
                emit_tokens_push_sview(buffer, "; if (value")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(key")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, "); Py_DECREF(out); return NULL; } if (PyDict_SetItem(out, key")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, ", value")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, ") < 0) { Py_DECREF(key")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, "); Py_DECREF(value")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, "); Py_DECREF(out); return NULL; } Py_DECREF(key")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, "); Py_DECREF(value")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, ");\n")
            emit_tokens_push_sview(buffer, "    return out;\n")
    elif pymodule_is_set_type(type_name):
        element_type_name: sview = pymodule_set_element_name(type_name)
        if expression is Expr.SetLit(default_set_elements_for_emit, default_set_pos_for_emit):
            emit_tokens_push_sview(buffer, "    PyObject *out = PySet_New(NULL); if (out == NULL) return NULL;\n")
            for default_set_element_index_for_emit in 0..<default_set_elements_for_emit.count |buffer, builder_name, element_type_name, default_set_elements_for_emit, default_set_element_index_for_emit|:
                emit_tokens_push_sview(buffer, "    PyObject *item")
                append_decimal(buffer, default_set_element_index_for_emit.i64())
                emit_tokens_push_sview(buffer, " = ")
                if pymodule_default_is_container(default_set_elements_for_emit[default_set_element_index_for_emit]):
                    child_name_storage_for_emit: mutable darray[u8] = []
                    child_name_for_emit: sview = pymodule_default_builder_child_name(&child_name_storage_for_emit, builder_name, "_item", default_set_element_index_for_emit)
                    emit_tokens_push_sview(buffer, child_name_for_emit)
                    emit_tokens_push_sview(buffer, "()")
                else:
                    emit_pymodule_default_python_scalar(buffer, file, element_type_name, default_set_elements_for_emit[default_set_element_index_for_emit])
                emit_tokens_push_sview(buffer, "; if (item")
                append_decimal(buffer, default_set_element_index_for_emit.i64())
                emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(out); return NULL; } if (PySet_Add(out, item")
                append_decimal(buffer, default_set_element_index_for_emit.i64())
                emit_tokens_push_sview(buffer, ") < 0) { Py_DECREF(item")
                append_decimal(buffer, default_set_element_index_for_emit.i64())
                emit_tokens_push_sview(buffer, "); Py_DECREF(out); return NULL; } Py_DECREF(item")
                append_decimal(buffer, default_set_element_index_for_emit.i64())
                emit_tokens_push_sview(buffer, ");\n")
            emit_tokens_push_sview(buffer, "    return out;\n")
    else:
        declaration_for_emit: Ast::Decl? = pymodule_find_struct_in(file.top_decls, type_name)
        if declaration_for_emit is target_struct_for_emit:
            if target_struct_for_emit is Decl.Struct(default_struct_name_for_emit, default_struct_members_for_emit, default_struct_affinity_for_emit, default_struct_named_states_for_emit, default_struct_derive_for_emit, default_struct_invariants_for_emit, default_struct_pos_for_emit):
                if expression is Expr.Construct(default_construct_type_for_emit, default_construct_fields_for_emit, default_construct_pos_for_emit):
                    emit_tokens_push_sview(buffer, "    PyObject *out = PyDict_New(); if (out == NULL) return NULL;\n")
                    for default_construct_field_index_for_emit in 0..<default_construct_fields_for_emit.count |buffer, file, builder_name, type_name, default_construct_fields_for_emit, default_construct_field_index_for_emit|:
                        default_construct_field_for_emit: Ast::FieldInit = default_construct_fields_for_emit[default_construct_field_index_for_emit]
                        construct_field_type_name_for_emit: sview = pymodule_struct_member_type_name(file, type_name, default_construct_field_for_emit.name)
                        emit_tokens_push_sview(buffer, "    PyObject *field")
                        append_decimal(buffer, default_construct_field_index_for_emit.i64())
                        emit_tokens_push_sview(buffer, " = ")
                        if pymodule_default_is_container(default_construct_field_for_emit.value):
                            child_name_storage_for_emit: mutable darray[u8] = []
                            child_name_for_emit: sview = pymodule_default_builder_field_name(&child_name_storage_for_emit, builder_name, default_construct_field_for_emit.name)
                            emit_tokens_push_sview(buffer, child_name_for_emit)
                            emit_tokens_push_sview(buffer, "()")
                        else:
                            emit_pymodule_default_python_scalar(buffer, file, construct_field_type_name_for_emit, default_construct_field_for_emit.value)
                        emit_tokens_push_sview(buffer, "; if (field")
                        append_decimal(buffer, default_construct_field_index_for_emit.i64())
                        emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(out); return NULL; } if (PyDict_SetItemString(out, \"")
                        emit_tokens_push_json_string(buffer, default_construct_field_for_emit.name)
                        emit_tokens_push_sview(buffer, "\", field")
                        append_decimal(buffer, default_construct_field_index_for_emit.i64())
                        emit_tokens_push_sview(buffer, ") < 0) { Py_DECREF(field")
                        append_decimal(buffer, default_construct_field_index_for_emit.i64())
                        emit_tokens_push_sview(buffer, "); Py_DECREF(out); return NULL; } Py_DECREF(field")
                        append_decimal(buffer, default_construct_field_index_for_emit.i64())
                        emit_tokens_push_sview(buffer, ");\n")
                    emit_tokens_push_sview(buffer, "    return out;\n")
    emit_tokens_push_sview(buffer, "}\n\n")




def emit_pymodule_default_literal(buffer: mutable darray[u8]&, file: Ast::File&, expression: Ast::Expr) -> void can[Abort.Panic, Memory.Allocate]:
    enum_value: (found: bool, value: i64) = pymodule_default_enum_value(file, expression)
    if enum_value.found:
        append_decimal_i64(buffer, enum_value.value)
        return
    if expression is Expr.StringLit(default_string_text, _):
        buffer.push(34)
        emit_tokens_push_sview(buffer, default_string_text)
        buffer.push(34)
        return
    if expression is Expr.IntLit(default_int_value, _):
        append_decimal_i64(buffer, default_int_value)
        return
    if expression is Expr.FloatLit(default_float_text, _):
        float_stop: mutable usize = sview_len(default_float_text)
        if float_stop >= 3 and sview_at(default_float_text, float_stop - 3) == 102 and sview_at(default_float_text, float_stop - 2) == 51 and (sview_at(default_float_text, float_stop - 1) == 50 or sview_at(default_float_text, float_stop - 1) == 52):
            float_stop <- float_stop - 3
        for float_index in 0..<float_stop |buffer, default_float_text|:
            buffer.push(sview_at(default_float_text, float_index))
        return
    if expression is Expr.BoolLit(default_bool_value, _):
        emit_tokens_push_sview(buffer, "1" if default_bool_value else "0")
        return
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        buffer.push(45) if default_operator == Lexer::TokenKind.Minus
        emit_pymodule_default_literal(buffer, file, default_operand)
        return
    if expression is Expr.Paren(default_inner, default_paren_pos):
        buffer.push(40)
        emit_pymodule_default_literal(buffer, file, default_inner)
        buffer.push(41)
        return
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            emit_pymodule_default_literal(buffer, file, default_base)




def emit_pymodule_signature_hex(buffer: mutable darray[u8]&, value: u32, width: usize) -> void can[Abort.Panic, Memory.Allocate]:
    divisor: mutable u32 = 1
    for _ in 0..<width - 1 |divisor|:
        divisor <- divisor * 16
    for _ in 0..<width |buffer, divisor, value|:
        digit: u32 = (value / divisor) % 16
        buffer.push((48 + digit).u8()) if digit < 10
        buffer.push((87 + digit).u8()) if digit >= 10
        divisor <- divisor / 16




def emit_pymodule_default_signature_literal(buffer: mutable darray[u8]&, file: Ast::File&, expression: Ast::Expr, type_name: sview = "") -> void can[Abort.Panic, Memory.Allocate]:
    if expression is Expr.Paren(default_inner, default_paren_pos):
        emit_pymodule_default_signature_literal(buffer, file, default_inner, type_name)
        return
    if pymodule_default_is_null(expression) and pymodule_parameter_is_implicit_optional(type_name):
        emit_tokens_push_sview(buffer, "None")
        return
    enum_value: (found: bool, value: i64) = pymodule_default_enum_value(file, expression)
    if enum_value.found:
        append_decimal_i64(buffer, enum_value.value)
        return
    if expression is Expr.BoolLit(default_bool_value, _):
        emit_tokens_push_sview(buffer, "True" if default_bool_value else "False")
        return
    if expression is Expr.StringLit(default_string_text, _):
        buffer.push(92)
        buffer.push(34)
        signature_index: mutable usize = 0
        while signature_index < sview_len(default_string_text) |signature_index, buffer, default_string_text|:
            signature_byte: u8 = sview_at(default_string_text, signature_index)
            if signature_byte < 128:
                buffer.push(92) if signature_byte == 92 or signature_byte == 34
                buffer.push(signature_byte)
            elif signature_byte >= 194 and signature_byte <= 223 and signature_index + 1 < sview_len(default_string_text):
                codepoint: u32 = ((signature_byte - 192).u32() * 64) + (sview_at(default_string_text, signature_index + 1) - 128).u32()
                buffer.push(92)
                buffer.push(92)
                buffer.push(117)
                emit_pymodule_signature_hex(buffer, codepoint, 4)
                signature_index <- signature_index + 1
            elif signature_byte >= 224 and signature_byte <= 239 and signature_index + 2 < sview_len(default_string_text):
                codepoint: u32 = ((signature_byte - 224).u32() * 4096) + ((sview_at(default_string_text, signature_index + 1) - 128).u32() * 64) + (sview_at(default_string_text, signature_index + 2) - 128).u32()
                buffer.push(92)
                buffer.push(92)
                buffer.push(117)
                emit_pymodule_signature_hex(buffer, codepoint, 4)
                signature_index <- signature_index + 2
            elif signature_byte >= 240 and signature_byte <= 244 and signature_index + 3 < sview_len(default_string_text):
                codepoint: u32 = ((signature_byte - 240).u32() * 262144) + ((sview_at(default_string_text, signature_index + 1) - 128).u32() * 4096) + ((sview_at(default_string_text, signature_index + 2) - 128).u32() * 64) + (sview_at(default_string_text, signature_index + 3) - 128).u32()
                buffer.push(92)
                buffer.push(92)
                buffer.push(85)
                emit_pymodule_signature_hex(buffer, codepoint, 8)
                signature_index <- signature_index + 3
            else:
                buffer.push(63)
            signature_index <- signature_index + 1
        buffer.push(92)
        buffer.push(34)
        return
    if expression is Expr.Array(default_elements, default_array_pos):
        if type_name == "darray[u8]":
            all_bytes: mutable bool = true
            for default_byte_element in default_elements:
                byte_value: (found: bool, value: i64) = pymodule_default_integer_literal_value(default_byte_element)
                all_bytes <- false if not byte_value.found or byte_value.value < 0 or byte_value.value > 255
            if all_bytes:
                buffer.push(98)
                buffer.push(92)
                buffer.push(34)
                for default_byte_index in 0..<default_elements.count |buffer, default_elements, default_byte_index|:
                    byte_value: (found: bool, value: i64) = pymodule_default_integer_literal_value(default_elements[default_byte_index])
                    buffer.push(92)
                    buffer.push(92)
                    buffer.push(120)
                    emit_pymodule_signature_hex(buffer, byte_value.value.u32(), 2)
                buffer.push(92)
                buffer.push(34)
                return
        emit_tokens_push_sview(buffer, "[")
        element_type_name: sview = pymodule_darray_element_name(type_name) if pymodule_is_darray_type(type_name) else pymodule_view_element_name(type_name) if pymodule_is_view_type(type_name) else ""
        for default_element_index in 0..<default_elements.count |buffer, default_elements, default_element_index, element_type_name|:
            emit_tokens_push_sview(buffer, ", ") if default_element_index > 0
            emit_pymodule_default_signature_literal(buffer, file, default_elements[default_element_index], element_type_name)
        emit_tokens_push_sview(buffer, "]")
        return
    if expression is Expr.DictLit(default_entries, default_dict_pos):
        key_type_name: sview = pymodule_dict_key_name(type_name) if pymodule_is_dict_type(type_name) else ""
        value_type_name: sview = pymodule_dict_value_name(type_name) if pymodule_is_dict_type(type_name) else ""
        emit_tokens_push_sview(buffer, "{")
        for default_entry_index in 0..<default_entries.count |buffer, default_entries, default_entry_index, key_type_name, value_type_name|:
            emit_tokens_push_sview(buffer, ", ") if default_entry_index > 0
            emit_pymodule_default_signature_literal(buffer, file, default_entries[default_entry_index].key, key_type_name)
            emit_tokens_push_sview(buffer, ": ")
            emit_pymodule_default_signature_literal(buffer, file, default_entries[default_entry_index].value, value_type_name)
        emit_tokens_push_sview(buffer, "}")
        return
    if expression is Expr.SetLit(default_set_elements, default_set_pos):
        if default_set_elements.count == 0:
            emit_tokens_push_sview(buffer, "set()")
            return
        emit_tokens_push_sview(buffer, "{")
        element_type_name: sview = pymodule_set_element_name(type_name) if pymodule_is_set_type(type_name) else ""
        for default_set_element_index in 0..<default_set_elements.count |buffer, default_set_elements, default_set_element_index, element_type_name|:
            emit_tokens_push_sview(buffer, ", ") if default_set_element_index > 0
            emit_pymodule_default_signature_literal(buffer, file, default_set_elements[default_set_element_index], element_type_name)
        emit_tokens_push_sview(buffer, "}")
        return
    if expression is Expr.Construct(default_construct_type, default_construct_fields, default_construct_pos):
        emit_tokens_push_sview(buffer, "{")
        for default_construct_field_index in 0..<default_construct_fields.count |buffer, file, type_name, default_construct_fields, default_construct_field_index|:
            default_construct_field: Ast::FieldInit = default_construct_fields[default_construct_field_index]
            emit_tokens_push_sview(buffer, ", ") if default_construct_field_index > 0
            buffer.push(92)
            buffer.push(34)
            emit_tokens_push_json_string(buffer, default_construct_field.name)
            buffer.push(92)
            buffer.push(34)
            emit_tokens_push_sview(buffer, ": ")
            construct_field_type_name: sview = pymodule_struct_member_type_name(file, type_name, default_construct_field.name)
            emit_pymodule_default_signature_literal(buffer, file, default_construct_field.value, construct_field_type_name)
        emit_tokens_push_sview(buffer, "}")
        return
    emit_pymodule_default_literal(buffer, file, expression)
