    "u64" return if type_name == "dict[bool,u64]"
    "usize" return if type_name == "dict[bool,usize]"
    "f32" return if type_name == "dict[bool,f32]"
    "f64" return if type_name == "dict[bool,f64]"
    "bool" return if type_name == "dict[bool,bool]"
    "cstr" return if type_name == "dict[bool,cstr]"
    "sview" return if type_name == "dict[bool,sview]"
    "py::Object" return if type_name == "dict[bool,py::Object]"
    "cstr?" return if type_name == "dict[bool,cstr?]"
    "py::Object?" return if type_name == "dict[bool,py::Object?]"
    "i8?" return if type_name == "dict[bool,i8?]"
    "i16?" return if type_name == "dict[bool,i16?]"
    "i32?" return if type_name == "dict[bool,i32?]"
    "i64?" return if type_name == "dict[bool,i64?]"
    "int?" return if type_name == "dict[bool,int?]"
    "isize?" return if type_name == "dict[bool,isize?]"
    "char?" return if type_name == "dict[bool,char?]"
    "u8?" return if type_name == "dict[bool,u8?]"
    "u16?" return if type_name == "dict[bool,u16?]"
    "u32?" return if type_name == "dict[bool,u32?]"
    "u64?" return if type_name == "dict[bool,u64?]"
    "usize?" return if type_name == "dict[bool,usize?]"
    "uintptr?" return if type_name == "dict[bool,uintptr?]"
    "bool?" return if type_name == "dict[bool,bool?]"
    "f32?" return if type_name == "dict[bool,f32?]"
    "f64?" return if type_name == "dict[bool,f64?]"
    if sview_len(type_name) > 6.usize() and type_name[0:5] == "dict[" and sview_at(type_name, sview_len(type_name) - 1.usize()) == 93:
        depth: mutable usize = 0
        for index in 5.usize()..<(sview_len(type_name) - 1.usize()) |type_name, depth|:
            byte: u8 = sview_at(type_name, index)
            depth <- depth + 1.usize() if byte == 91
            depth <- depth - 1.usize() if byte == 93 and depth > 0.usize()
            return type_name[index + 1.usize():sview_len(type_name) - 1.usize()] if byte == 44 and depth == 0.usize()
    return ""




# Find the named record carried anywhere inside a Python-facing aggregate.  The C shim emits
# recursive dictionary/list/view conversion helpers before it emits the wrapper body, so the
# record typedef (and its field converters) must be discovered through every container layer,
# not only the first dictionary value.  Keep the input/return capability check at the leaf: a
# scalar dictionary value should not accidentally be treated as a named record.
def pymodule_named_struct_leaf_for_pymodule(file: Ast::File&, type_name: sview, for_input: bool, depth: usize = 0.usize()) -> sview can[Abort.Panic, Memory.Allocate]:
    return "" if depth > 32.usize()
    if for_input:
        return type_name if pymodule_struct_input_supported(file, type_name)
    else:
        return type_name if pymodule_struct_return_supported(file, type_name)
    if pymodule_is_dict_type(type_name):
        return pymodule_named_struct_leaf_for_pymodule(file, pymodule_dict_value_name(type_name), for_input, depth + 1.usize())
    if pymodule_is_darray_type(type_name):
        return pymodule_named_struct_leaf_for_pymodule(file, pymodule_darray_element_name(type_name), for_input, depth + 1.usize())
    if pymodule_is_view_type(type_name):
        return pymodule_named_struct_leaf_for_pymodule(file, pymodule_view_element_name(type_name), for_input, depth + 1.usize())
    return ""




def pymodule_dict_value_is_optional_scalar(value_name: sview) -> bool can[Abort.Panic]:
    return pymodule_is_optional_scalar_type(value_name) and value_name != "sview?"
