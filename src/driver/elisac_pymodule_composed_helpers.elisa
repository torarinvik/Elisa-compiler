# `-emit pymodule` — COMPOSED helpers: a dictionary or set nested inside another mapping shares
# the enclosing wrapper's arena and reference table, so its input and output converters are
# generated as a pair with that lifetime built in.


# Dictionaries use the same shared arena/reference table as their enclosing wrapper.  Generate
# recursive mapping helpers from the ordinary dictionary setup/copy routines so nested mapping
# values keep their native ElisaDict bucket layout while Python sees ordinary dict objects.
def emit_pymodule_composed_dict_input_helper(buffer: mutable darray[u8]&, file: Ast::File&, helper_name: sview, type_name: sview) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    value_name: sview = pymodule_dict_value_name(type_name)
    inner_helper_storage: mutable darray[u8] = []
    inner_helper: mutable sview = ""
    if pymodule_is_dict_type(value_name):
        for helper_index in 0..<sview_len(helper_name) |inner_helper_storage, helper_name, helper_index|:
            inner_helper_storage.push(sview_at(helper_name, helper_index))
        emit_tokens_push_sview(&inner_helper_storage, "_inner")
        inner_helper <- sview(&inner_helper_storage[0], 0, inner_helper_storage.count)
        emit_pymodule_composed_dict_input_helper(buffer, file, inner_helper, value_name)
    elif pymodule_is_set_type(value_name):
        for helper_index in 0..<sview_len(helper_name) |inner_helper_storage, helper_name, helper_index|:
            inner_helper_storage.push(sview_at(helper_name, helper_index))
        emit_tokens_push_sview(&inner_helper_storage, "_inner")
        inner_helper <- sview(&inner_helper_storage[0], 0, inner_helper_storage.count)
        emit_pymodule_composed_set_input_helper(buffer, inner_helper, value_name)
    elif pymodule_is_darray_type(value_name) and pymodule_is_set_type(pymodule_darray_element_name(value_name)):
        for helper_index in 0..<sview_len(helper_name) |inner_helper_storage, helper_name, helper_index|:
            inner_helper_storage.push(sview_at(helper_name, helper_index))
        emit_tokens_push_sview(&inner_helper_storage, "_inner")
        inner_helper <- sview(&inner_helper_storage[0], 0, inner_helper_storage.count)
        emit_pymodule_darray_set_input_helper(buffer, inner_helper, pymodule_darray_element_name(value_name))
    elif pymodule_is_darray_type(value_name) and pymodule_is_dict_type(pymodule_darray_element_name(value_name)):
        for helper_index in 0..<sview_len(helper_name) |inner_helper_storage, helper_name, helper_index|:
            inner_helper_storage.push(sview_at(helper_name, helper_index))
        emit_tokens_push_sview(&inner_helper_storage, "_inner")
        inner_helper <- sview(&inner_helper_storage[0], 0, inner_helper_storage.count)
        emit_pymodule_darray_dict_input_helper(buffer, file, inner_helper, pymodule_darray_element_name(value_name))
    elif pymodule_darray_element_name(value_name) != "" and not pymodule_is_darray_type(pymodule_darray_element_name(value_name)) and pymodule_struct_input_supported(file, pymodule_darray_element_name(value_name)):
        for helper_index in 0..<sview_len(helper_name) |inner_helper_storage, helper_name, helper_index|:
            inner_helper_storage.push(sview_at(helper_name, helper_index))
        emit_tokens_push_sview(&inner_helper_storage, "_inner")
        inner_helper <- sview(&inner_helper_storage[0], 0, inner_helper_storage.count)
        emit_pymodule_darray_struct_input_helper(buffer, file, inner_helper, pymodule_darray_element_name(value_name))
    elif pymodule_view_element_name(value_name) != "" and pymodule_darray_c_element_type(pymodule_view_element_name(value_name)) == "" and pymodule_struct_input_supported(file, pymodule_view_element_name(value_name)):
        for helper_index in 0..<sview_len(helper_name) |inner_helper_storage, helper_name, helper_index|:
            inner_helper_storage.push(sview_at(helper_name, helper_index))
        emit_tokens_push_sview(&inner_helper_storage, "_inner")
        inner_helper <- sview(&inner_helper_storage[0], 0, inner_helper_storage.count)
        emit_pymodule_view_struct_input_helper(buffer, file, inner_helper, pymodule_view_element_name(value_name))
    snippet: mutable darray[u8] = []
    empty_params: darray[Ast::ParamDecl] = []
    emit_pymodule_dict_input_setup(&snippet, empty_params, type_name, 0.usize(), inner_helper)
    # The ordinary setup is parameter-oriented and therefore owns its own arena/ref locals.
    # Redirect those references to the caller's shared lifetime and make every failure return
    # through the helper's integer status convention.
    pymodule_replace_generated(&snippet, "ElisaPyRefs arg0_struct_refs = (ElisaPyRefs){0};\n", "")
    pymodule_replace_generated(&snippet, "ElisaArena arg0_arena = {0};\n", "")
    pymodule_replace_generated(&snippet, "arg0_arena.strategy = 0;\n", "")
    pymodule_replace_generated(&snippet, "&arg0_struct_refs", "refs")
    pymodule_replace_generated(&snippet, "&arg0_arena", "arena")
    pymodule_replace_generated(&snippet, "arena_free(&arg0_arena);", "")
    pymodule_replace_generated(&snippet, "elisa_pymodule_struct_refs_free(&arg0_struct_refs);", "")
    pymodule_replace_generated(&snippet, "arena_free(arena);", "")
    pymodule_replace_generated(&snippet, "elisa_pymodule_struct_refs_free(refs);", "")
    pymodule_replace_generated(&snippet, "PyObject *arg0_owned = ", "arg0_owned = ")
    pymodule_replace_generated(&snippet, "return NULL;", "do { Py_XDECREF(arg0_owned); return -1; } while (0);")
    emit_tokens_push_sview(buffer, "static int ")
    emit_tokens_push_sview(buffer, helper_name)
    emit_tokens_push_sview(buffer, "(PyObject *field_obj, ElisaDict *destination, ElisaArena *arena, ElisaPyRefs *refs) { PyObject *arg0_owned = NULL; PyObject *arg0 = field_obj;\n")
    for snippet_index in 0..<snippet.count |buffer, snippet|:
        buffer.push(snippet[snippet_index])
    emit_tokens_push_sview(buffer, "    if (elisa_pymodule_retain(arg0_owned, refs) < 0) { Py_XDECREF(arg0_owned); return -1; } Py_DECREF(arg0_owned); *destination = arg0_value; return 0; }\n")




# Sets nested inside dictionaries use the same shared arena/reference lifetime as mappings and
# lists, but their bucket conversion is intentionally kept in the battle-tested standalone set
# path. Splicing that path here keeps Python's nested `dict[K, set[V]]` shape unsurprising while
# preserving the native ElisaSet ABI.
def emit_pymodule_composed_set_input_helper(buffer: mutable darray[u8]&, helper_name: sview, type_name: sview) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    snippet: mutable darray[u8] = []
    empty_params: darray[Ast::ParamDecl] = []
    emit_pymodule_set_input_setup(&snippet, empty_params, type_name, 0.usize())
    pymodule_replace_generated(&snippet, "ElisaPyRefs arg0_struct_refs = (ElisaPyRefs){0};\n", "")
    pymodule_replace_generated(&snippet, "ElisaArena arg0_arena = {0};\n", "")
    pymodule_replace_generated(&snippet, "arg0_arena.strategy = 0;\n", "")
    pymodule_replace_generated(&snippet, "&arg0_struct_refs", "refs")
    pymodule_replace_generated(&snippet, "&arg0_arena", "arena")
    pymodule_replace_generated(&snippet, "arena_free(&arg0_arena);", "")
    pymodule_replace_generated(&snippet, "elisa_pymodule_struct_refs_free(&arg0_struct_refs);", "")
    pymodule_replace_generated(&snippet, "arena_free(arena);", "")
    pymodule_replace_generated(&snippet, "elisa_pymodule_struct_refs_free(refs);", "")
    pymodule_replace_generated(&snippet, "PyObject *arg0_owned = ", "arg0_owned = ")
    pymodule_replace_generated(&snippet, "return NULL;", "do { Py_XDECREF(arg0_owned); return -1; } while (0);")
    emit_tokens_push_sview(buffer, "static int ")
    emit_tokens_push_sview(buffer, helper_name)
    emit_tokens_push_sview(buffer, "(PyObject *field_obj, ElisaSet *destination, ElisaArena *arena, ElisaPyRefs *refs) { PyObject *arg0_owned = NULL; PyObject *arg0 = field_obj;\n")
    for snippet_index in 0..<snippet.count |buffer, snippet|:
        buffer.push(snippet[snippet_index])
    emit_tokens_push_sview(buffer, "    if (elisa_pymodule_retain(arg0_owned, refs) < 0) { Py_XDECREF(arg0_owned); return -1; } Py_DECREF(arg0_owned); *destination = arg0_value; return 0; }\n")




def emit_pymodule_composed_set_output_helper(buffer: mutable darray[u8]&, helper_name: sview, type_name: sview) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    snippet: mutable darray[u8] = []
    empty_params: darray[Ast::ParamDecl] = []
    emit_pymodule_set_return_conversion(&snippet, empty_params, type_name, true)
    emit_tokens_push_sview(buffer, "static PyObject *")
    emit_tokens_push_sview(buffer, helper_name)
    emit_tokens_push_sview(buffer, "(ElisaSet input) { ElisaSet result = input; ElisaArena arena = {0};\n")
    for snippet_index in 0..<snippet.count |buffer, snippet|:
        buffer.push(snippet[snippet_index])
    emit_tokens_push_sview(buffer, "}\n")




def emit_pymodule_composed_dict_output_helper(buffer: mutable darray[u8]&, file: Ast::File&, helper_name: sview, type_name: sview) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    value_name: sview = pymodule_dict_value_name(type_name)
    inner_helper_storage: mutable darray[u8] = []
    inner_helper: mutable sview = ""
    if pymodule_is_dict_type(value_name):
        for helper_index in 0..<sview_len(helper_name) |inner_helper_storage, helper_name, helper_index|:
            inner_helper_storage.push(sview_at(helper_name, helper_index))
        emit_tokens_push_sview(&inner_helper_storage, "_inner")
        inner_helper <- sview(&inner_helper_storage[0], 0, inner_helper_storage.count)
        emit_pymodule_composed_dict_output_helper(buffer, file, inner_helper, value_name)
    elif pymodule_is_set_type(value_name):
        for helper_index in 0..<sview_len(helper_name) |inner_helper_storage, helper_name, helper_index|:
            inner_helper_storage.push(sview_at(helper_name, helper_index))
        emit_tokens_push_sview(&inner_helper_storage, "_inner")
        inner_helper <- sview(&inner_helper_storage[0], 0, inner_helper_storage.count)
        emit_pymodule_composed_set_output_helper(buffer, inner_helper, value_name)
    elif pymodule_is_darray_type(value_name) and pymodule_is_set_type(pymodule_darray_element_name(value_name)):
        for helper_index in 0..<sview_len(helper_name) |inner_helper_storage, helper_name, helper_index|:
            inner_helper_storage.push(sview_at(helper_name, helper_index))
        emit_tokens_push_sview(&inner_helper_storage, "_inner")
        inner_helper <- sview(&inner_helper_storage[0], 0, inner_helper_storage.count)
        emit_pymodule_darray_set_output_helper(buffer, inner_helper, pymodule_darray_element_name(value_name))
    elif pymodule_is_darray_type(value_name) and pymodule_is_dict_type(pymodule_darray_element_name(value_name)):
        for helper_index in 0..<sview_len(helper_name) |inner_helper_storage, helper_name, helper_index|:
            inner_helper_storage.push(sview_at(helper_name, helper_index))
        emit_tokens_push_sview(&inner_helper_storage, "_inner")
        inner_helper <- sview(&inner_helper_storage[0], 0, inner_helper_storage.count)
        emit_pymodule_darray_dict_output_helper(buffer, file, inner_helper, pymodule_darray_element_name(value_name))
    elif pymodule_darray_element_name(value_name) != "" and not pymodule_is_darray_type(pymodule_darray_element_name(value_name)) and pymodule_struct_return_supported(file, pymodule_darray_element_name(value_name)):
        for helper_index in 0..<sview_len(helper_name) |inner_helper_storage, helper_name, helper_index|:
            inner_helper_storage.push(sview_at(helper_name, helper_index))
        emit_tokens_push_sview(&inner_helper_storage, "_inner")
        inner_helper <- sview(&inner_helper_storage[0], 0, inner_helper_storage.count)
        emit_pymodule_darray_struct_output_helper(buffer, file, inner_helper, pymodule_darray_element_name(value_name))
    elif pymodule_view_element_name(value_name) != "" and pymodule_darray_c_element_type(pymodule_view_element_name(value_name)) == "" and pymodule_struct_return_supported(file, pymodule_view_element_name(value_name)):
        for helper_index in 0..<sview_len(helper_name) |inner_helper_storage, helper_name, helper_index|:
            inner_helper_storage.push(sview_at(helper_name, helper_index))
        emit_tokens_push_sview(&inner_helper_storage, "_inner")
        inner_helper <- sview(&inner_helper_storage[0], 0, inner_helper_storage.count)
        emit_pymodule_view_struct_output_helper(buffer, file, inner_helper, pymodule_view_element_name(value_name))
    snippet: mutable darray[u8] = []
    empty_params: darray[Ast::ParamDecl] = []
    emit_pymodule_dict_return_conversion(&snippet, empty_params, type_name, true, inner_helper)
    emit_tokens_push_sview(buffer, "static PyObject *")
    emit_tokens_push_sview(buffer, helper_name)
    emit_tokens_push_sview(buffer, "(ElisaDict input) { ElisaDict result = input; ElisaArena arena = {0};\n")
    for snippet_index in 0..<snippet.count |buffer, snippet|:
        buffer.push(snippet[snippet_index])
    emit_tokens_push_sview(buffer, "}\n")




def pymodule_struct_input_supported_depth(file: Ast::File&, type_name: sview, depth: usize) -> bool can[Abort.Panic, Memory.Allocate]:
    return true if pymodule_struct_supported(file, type_name)
    return false if depth > 32.usize()
    return false if pymodule_struct_cycle_in_type(file, type_name, 0.usize())
    declaration: Ast::Decl? = pymodule_find_struct_in(file.top_decls, type_name)
    if declaration is target:
        if target is Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, pos):
            return false if members.count == 0
            for member in members:
                return false if member.is_ghost or (member.has_default and not pymodule_struct_default_supported(file, pymodule_alias_type_name(file, member.type_expression), member.default_value))
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                if pymodule_is_darray_type(field_type_name):
                    return false if not pymodule_struct_darray_element_supported(file, pymodule_darray_element_name(field_type_name))
                    continue
                if pymodule_is_view_type(field_type_name):
                    return false if not pymodule_view_input_supported(file, field_type_name, depth + 1.usize())
                    continue
                if pymodule_is_dict_type(field_type_name):
                    return false if not pymodule_nested_dict_values_supported_in_type(file, field_type_name, 0.usize())
                    continue
                if pymodule_is_set_type(field_type_name):
                    return false if not pymodule_set_element_supported(pymodule_set_element_name(field_type_name))
                    continue
                continue if pymodule_struct_scalar_field_type(field_type_name)
                return false if not pymodule_struct_input_supported_depth(file, field_type_name, depth + 1.usize())
            return true
    return false




def pymodule_struct_input_supported(file: Ast::File&, type_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    return pymodule_struct_input_supported_depth(file, type_name, 0.usize())




def pymodule_struct_nested_dict_values_supported_depth(file: Ast::File&, type_name: sview, depth: usize, from_dict_value: bool = false) -> bool can[Abort.Panic, Memory.Allocate]:
    # Walk named structs (including structs nested in darray/view/dict values) so a dictionary
    # field whose recursive list converter is outside the eight-level ABI limit is rejected while
    # emitting the module, rather than producing a wrapper that fails only when called.
    return false if depth > 32.usize()
    return false if pymodule_struct_cycle_in_type(file, type_name, 0.usize())
    declaration: Ast::Decl? = pymodule_find_struct_in(file.top_decls, type_name)
    if declaration is target:
        if target is Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, pos):
            for member in members:
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                if pymodule_is_dict_type(field_type_name):
                    return false if not pymodule_dict_key_supported(pymodule_dict_key_name(field_type_name))
                    value_type_name: sview = pymodule_dict_value_name(field_type_name)
                    return false if pymodule_is_set_type(value_type_name) and not pymodule_set_element_supported(pymodule_set_element_name(value_type_name))
                    if pymodule_is_darray_type(value_type_name):
                        return false if not pymodule_top_level_darray_input_supported(file, value_type_name) or not pymodule_top_level_darray_return_supported(file, value_type_name)
                    return false if not pymodule_struct_nested_dict_values_supported_depth(file, value_type_name, depth + 1.usize(), true)
                elif pymodule_is_darray_type(field_type_name):
                    return false if from_dict_value and (not pymodule_top_level_darray_input_supported(file, field_type_name) or not pymodule_top_level_darray_return_supported(file, field_type_name))
                    element_type_name: sview = pymodule_darray_element_name(field_type_name)
                    return false if not pymodule_struct_nested_dict_values_supported_depth(file, element_type_name, depth + 1.usize(), from_dict_value)
                elif pymodule_is_view_type(field_type_name):
                    # A view field is bridged directly by its element converter.  Aggregate
                    # view elements (dict/set/darray/view) do not have a generated converter;
                    # validate the complete input/output bridge here instead of recursively
                    # walking into an unsupported shape and accepting malformed C later.
                    return false if not pymodule_view_bridge_supported(file, field_type_name, depth + 1.usize())
                elif pymodule_is_set_type(field_type_name):
                    return false if not pymodule_set_element_supported(pymodule_set_element_name(field_type_name))
                else:
                    return false if not pymodule_struct_nested_dict_values_supported_depth(file, field_type_name, depth + 1.usize(), from_dict_value)
            return true
    return true




def pymodule_struct_nested_dict_values_supported(file: Ast::File&, type_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    return pymodule_struct_nested_dict_values_supported_depth(file, type_name, 0.usize())




def pymodule_dict_key_supported(key_name: sview) -> bool can[Abort.Panic]:
    # The generated shim has explicit hash/equality bridges for these scalar key families. A
    # syntactically valid Elisa dictionary may still use an aggregate (or float) key, but there is
    # no portable Python-facing ABI for those keys yet; reject them before C emission rather than
    # allowing an empty C type to reach clang.
    return key_name == "i8" or key_name == "i16" or key_name == "i32" or key_name == "i64" or key_name == "int" or key_name == "isize" or key_name == "char" or key_name == "u8" or key_name == "u16" or key_name == "u32" or key_name == "u64" or key_name == "usize" or key_name == "uintptr" or key_name == "bool" or key_name == "cstr" or key_name == "sview"




def pymodule_set_element_supported(element_name: sview) -> bool can[Abort.Panic]:
    # Sets use the same explicit scalar hash/equality matrix as dictionary keys. Named records,
    # containers, and floating-point values do not have a stable Python/native set ABI here.
    return element_name == "i8" or element_name == "i16" or element_name == "i32" or element_name == "i64" or element_name == "int" or element_name == "isize" or element_name == "char" or element_name == "u8" or element_name == "u16" or element_name == "u32" or element_name == "u64" or element_name == "usize" or element_name == "uintptr" or element_name == "bool" or element_name == "cstr" or element_name == "sview"




def pymodule_unsupported_set_element_in_type(file: Ast::File&, type_name: sview, depth: usize = 0.usize()) -> sview can[Abort.Panic, Memory.Allocate]:
    return "" if depth > 32.usize()
    if pymodule_is_set_type(type_name):
        element_name: sview = pymodule_set_element_name(type_name)
        return element_name if element_name != "" and not pymodule_set_element_supported(element_name)
        return ""
    if pymodule_is_dict_type(type_name):
        return pymodule_unsupported_set_element_in_type(file, pymodule_dict_value_name(type_name), depth + 1.usize())
    if pymodule_is_darray_type(type_name) or pymodule_is_view_type(type_name):
        element_name: sview = pymodule_darray_element_name(type_name) if pymodule_is_darray_type(type_name) else pymodule_view_element_name(type_name)
        return pymodule_unsupported_set_element_in_type(file, element_name, depth + 1.usize())
    declaration: Ast::Decl? = pymodule_find_struct_in(file.top_decls, type_name)
    if declaration is target:
        if target is Decl.Struct(struct_name, struct_members, struct_affinity, struct_named_states, struct_derive, struct_invariants, struct_pos):
            for member in struct_members:
                found_element: sview = pymodule_unsupported_set_element_in_type(file, pymodule_alias_type_name(file, member.type_expression), depth + 1.usize())
                return found_element if found_element != ""
    return ""




def pymodule_unsupported_dict_key_in_type(file: Ast::File&, type_name: sview, depth: usize = 0.usize()) -> sview can[Abort.Panic, Memory.Allocate]:
    return "" if depth > 32.usize()
    if pymodule_is_dict_type(type_name):
        key_name: sview = pymodule_dict_key_name(type_name)
        return key_name if key_name != "" and not pymodule_dict_key_supported(key_name)
        return pymodule_unsupported_dict_key_in_type(file, pymodule_dict_value_name(type_name), depth + 1.usize())
    if pymodule_is_darray_type(type_name) or pymodule_is_view_type(type_name) or pymodule_is_set_type(type_name):
        element_name: sview = pymodule_darray_element_name(type_name) if pymodule_is_darray_type(type_name) else pymodule_view_element_name(type_name) if pymodule_is_view_type(type_name) else pymodule_set_element_name(type_name)
        return pymodule_unsupported_dict_key_in_type(file, element_name, depth + 1.usize())
    declaration: Ast::Decl? = pymodule_find_struct_in(file.top_decls, type_name)
    if declaration is target:
        if target is Decl.Struct(struct_name, struct_members, struct_affinity, struct_named_states, struct_derive, struct_invariants, struct_pos):
            for member in struct_members:
                found_key: sview = pymodule_unsupported_dict_key_in_type(file, pymodule_alias_type_name(file, member.type_expression), depth + 1.usize())
                return found_key if found_key != ""
    return ""




def pymodule_nested_dict_values_supported_in_type(file: Ast::File&, type_name: sview, depth: usize, from_dict_value: bool = false) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if depth > 32.usize()
    return false if pymodule_struct_cycle_in_type(file, type_name, 0.usize())
    if pymodule_is_dict_type(type_name):
        return false if not pymodule_dict_key_supported(pymodule_dict_key_name(type_name))
        value_type_name: sview = pymodule_dict_value_name(type_name)
        return false if pymodule_is_set_type(value_type_name) and not pymodule_set_element_supported(pymodule_set_element_name(value_type_name))
        if pymodule_is_darray_type(value_type_name):
            return false if not pymodule_top_level_darray_input_supported(file, value_type_name) or not pymodule_top_level_darray_return_supported(file, value_type_name)
        return pymodule_nested_dict_values_supported_in_type(file, value_type_name, depth + 1.usize(), true)
    if pymodule_is_darray_type(type_name):
        element_type_name: sview = pymodule_darray_element_name(type_name)
        return pymodule_nested_dict_values_supported_in_type(file, element_type_name, depth + 1.usize(), from_dict_value)
    if pymodule_is_view_type(type_name):
        return pymodule_view_bridge_supported(file, type_name, depth)
    if pymodule_is_set_type(type_name):
        return pymodule_set_element_supported(pymodule_set_element_name(type_name))
    declaration: Ast::Decl? = pymodule_find_struct_in(file.top_decls, type_name)
    if declaration is target:
        return pymodule_struct_nested_dict_values_supported_depth(file, type_name, depth, from_dict_value)
    return true
