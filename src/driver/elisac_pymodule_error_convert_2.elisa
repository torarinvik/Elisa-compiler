# `-emit pymodule` — the remaining error-payload conversions, and the ORDER they run in: an
# aggregate payload is copied before ordinary argument cleanup because its storage is the native
# arena's, while a darray reference is released only after that cleanup.


def emit_pymodule_error_payload_field_conversion(buffer: mutable darray[u8]&, file: Ast::File&, type_name: sview, expression: sview, field_index: usize) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    if pymodule_is_dict_type(type_name):
        emit_pymodule_error_struct_dict_field_conversion(buffer, type_name, expression, field_index)
    elif type_name == "cstr?" or type_name == "py::Object?" or pymodule_is_optional_scalar_type(type_name):
        emit_pymodule_optional_error_payload_conversion(buffer, type_name, expression, "field_object")
    elif pymodule_is_darray_type(type_name):
        emit_pymodule_error_payload_darray_conversion(buffer, file, type_name, expression, "field_object")
    elif pymodule_is_view_type(type_name):
        emit_pymodule_error_payload_view_conversion(buffer, file, type_name, expression, "field_object")
    elif pymodule_is_set_type(type_name):
        emit_pymodule_error_payload_set_conversion(buffer, type_name, expression, "field_object")
    elif type_name == "cstr":
        emit_tokens_push_sview(buffer, "if (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, " == NULL) { Py_INCREF(Py_None); field_object = Py_None; } else field_object = PyUnicode_FromString(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ");\n")
    elif type_name == "sview":
        emit_tokens_push_sview(buffer, "if (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".len < 0 || ")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".len > PY_SSIZE_T_MAX || (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".data == NULL && ")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".len != 0)) { PyErr_SetString(PyExc_RuntimeError, \"native Elisa structured error returned an invalid sview payload\"); return NULL; } if (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".data == NULL) field_object = PyUnicode_FromString(\"\"); else field_object = PyUnicode_DecodeUTF8(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".data, (Py_ssize_t)")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".len, \"strict\");\n")
    elif type_name == "py::Object":
        emit_tokens_push_sview(buffer, "if (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, " == NULL) { Py_INCREF(Py_None); field_object = Py_None; } else { Py_INCREF(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, "); field_object = ")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, "; }\n")
    elif pymodule_struct_return_supported(file, type_name):
        emit_tokens_push_sview(buffer, "field_object = elisa_pymodule_struct_")
        emit_tokens_push_sview(buffer, type_name)
        emit_tokens_push_sview(buffer, "_to_py(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ");\n")
    elif type_name == "bool":
        emit_tokens_push_sview(buffer, "field_object = PyBool_FromLong((long)")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ");\n")
    elif type_name == "f32" or type_name == "f64":
        emit_tokens_push_sview(buffer, "field_object = PyFloat_FromDouble((double)")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ");\n")
    elif type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or type_name == "usize" or type_name == "uintptr":
        emit_tokens_push_sview(buffer, "field_object = PyLong_FromUnsignedLongLong((unsigned long long)")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ");\n")
    else:
        emit_tokens_push_sview(buffer, "field_object = PyLong_FromLongLong((long long)")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ");\n")




def emit_pymodule_error_payload_struct_conversion(buffer: mutable darray[u8]&, file: Ast::File&, declarations: darray[Ast::Decl]&, error_family: sview) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    declaration: Ast::Decl? = pymodule_error_decl_in(declarations, error_family)
    if declaration is target:
        if target is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            emit_tokens_push_sview(buffer, "        PyObject *native_payload_object = PyDict_New(); if (native_payload_object == NULL) return NULL;\n        PyObject *native_variant_object = NULL;\n        if (native_payload.tag < 1) { Py_DECREF(native_payload_object); PyErr_SetString(PyExc_RuntimeError, \"native Elisa structured error returned an invalid variant tag\"); return NULL; }\n")
            field_index: mutable usize = 0.usize()
            variant_index: mutable i64 = 0
            for variant in error_variants |buffer, field_index, variant_index|:
                emit_tokens_push_sview(buffer, "        ") if variant_index > 0
                emit_tokens_push_sview(buffer, "else ") if variant_index > 0
                emit_tokens_push_sview(buffer, "if (native_payload.tag == ")
                append_decimal(buffer, (variant_index + 1).i64())
                emit_tokens_push_sview(buffer, ") { native_variant_object = PyUnicode_FromString(\"")
                emit_tokens_push_sview(buffer, variant.name)
                emit_tokens_push_sview(buffer, "\"); if (native_variant_object == NULL || PyDict_SetItemString(native_payload_object, \"variant\", native_variant_object) < 0) { Py_XDECREF(native_variant_object); Py_DECREF(native_payload_object); return NULL; } Py_DECREF(native_variant_object);\n")
                field_offset: mutable usize = 0.usize()
                for field in variant.fields |buffer, field_index, field_offset|:
                    emit_tokens_push_sview(buffer, "            { PyObject *field_object = NULL; ")
                    expression: mutable darray[u8] = []
                    emit_tokens_push_sview(&expression, "native_payload.field_")
                    append_decimal(&expression, field_index.i64())
                    expression_view: sview = sview(&expression[0], 0, expression.count)
                    field_type_name: sview = pymodule_alias_type_name(file, field)
                    emit_pymodule_error_payload_field_conversion(buffer, file, field_type_name, expression_view, field_index)
                    emit_tokens_push_sview(buffer, " if (field_object == NULL || PyDict_SetItemString(native_payload_object, \"")
                    if field_offset < variant.field_names.count and variant.field_names[field_offset] != "":
                        emit_tokens_push_sview(buffer, variant.field_names[field_offset])
                    else:
                        emit_tokens_push_sview(buffer, "field_")
                        append_decimal(buffer, field_offset.i64())
                    emit_tokens_push_sview(buffer, "\", field_object) < 0) { Py_XDECREF(field_object); Py_DECREF(native_payload_object); return NULL; } Py_DECREF(field_object); }\n")
                    field_index <- field_index + 1.usize()
                    field_offset <- field_offset + 1.usize()
                emit_tokens_push_sview(buffer, "        }")
                emit_tokens_push_sview(buffer, "\n")
                variant_index <- variant_index + 1
            emit_tokens_push_sview(buffer, "        else { Py_DECREF(native_payload_object); PyErr_SetString(PyExc_RuntimeError, \"native Elisa structured error returned an unknown variant tag\"); return NULL; }\n")




# Copy a dictionary error payload while the native error arena is still alive. The ordinary dict
# return copier already validates bucket metadata, handles text/object/nullable values, and owns
# every Python reference it creates. Reuse that implementation in a nested block, changing only
# its two successful `return out` exits into a handoff to the surrounding error wrapper. Error
# exits intentionally remain direct returns: the copier has already set a precise Python error
# (and released the arena) so there is no useful Elisa error object to construct afterward.
def emit_pymodule_error_payload_dict_conversion(buffer: mutable darray[u8]&, type_name: sview) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    emit_tokens_push_sview(buffer, "        ElisaDict result = native_payload;\n")
    snippet: mutable darray[u8] = []
    empty_params: darray[Ast::ParamDecl] = []
    dict_helper_name_storage: mutable darray[u8] = []
    dict_helper_name: sview = pymodule_error_nested_dict_helper_name(type_name, &dict_helper_name_storage)
    emit_pymodule_dict_return_conversion(&snippet, empty_params, type_name, true, dict_helper_name)
    empty_return: sview = "        arena_free(&arena);\n        return out;\n"
    final_return: sview = "    arena_free(&arena);\n    return out;\n"
    handoff: sview = "        native_payload_object = out; goto elisa_pymodule_error_dict_done;\n"
    pymodule_replace_generated(&snippet, empty_return, handoff)
    pymodule_replace_generated(&snippet, final_return, handoff)
    for snippet_index in 0..<snippet.count |buffer, snippet|:
        buffer.push(snippet[snippet_index])
    emit_tokens_push_sview(buffer, "        elisa_pymodule_error_dict_done:;\n")




def emit_pymodule_error_payload_conversion(buffer: mutable darray[u8]&, file: Ast::File&, type_name: sview) -> void can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(buffer, "        PyObject *native_payload_object = NULL;\n")
    if pymodule_is_dict_type(type_name):
        emit_pymodule_error_payload_dict_conversion(buffer, type_name)
    elif pymodule_is_darray_type(type_name):
        emit_pymodule_error_payload_darray_conversion(buffer, file, type_name, "native_payload", "native_payload_object")
    elif pymodule_is_view_type(type_name):
        emit_pymodule_error_payload_view_conversion(buffer, file, type_name, "native_payload", "native_payload_object")
    elif pymodule_is_set_type(type_name):
        emit_pymodule_error_payload_set_conversion(buffer, type_name, "native_payload", "native_payload_object")
    elif type_name == "cstr?" or type_name == "py::Object?" or pymodule_is_optional_scalar_type(type_name):
        emit_pymodule_optional_error_payload_conversion(buffer, type_name, "native_payload", "native_payload_object")
    elif type_name == "cstr":
        emit_tokens_push_sview(buffer, "        if (native_payload == NULL) { Py_INCREF(Py_None); native_payload_object = Py_None; } else native_payload_object = PyUnicode_FromString(native_payload);\n")
    elif type_name == "sview":
        emit_tokens_push_sview(buffer, "        if (native_payload.len < 0 || native_payload.len > PY_SSIZE_T_MAX || (native_payload.data == NULL && native_payload.len != 0)) { PyErr_SetString(PyExc_RuntimeError, \"native Elisa error returned an invalid sview payload\"); return NULL; }\n        if (native_payload.data == NULL) native_payload_object = PyUnicode_FromString(\"\"); else native_payload_object = PyUnicode_DecodeUTF8(native_payload.data, (Py_ssize_t)native_payload.len, \"strict\");\n")
    elif type_name == "py::Object":
        emit_tokens_push_sview(buffer, "        if (native_payload == NULL) { Py_INCREF(Py_None); native_payload_object = Py_None; } else { Py_INCREF(native_payload); native_payload_object = native_payload; }\n")
    elif pymodule_struct_return_supported(file, type_name):
        emit_tokens_push_sview(buffer, "        native_payload_object = elisa_pymodule_struct_")
        emit_tokens_push_sview(buffer, type_name)
        emit_tokens_push_sview(buffer, "_to_py(native_payload);\n")
    elif type_name == "bool":
        emit_tokens_push_sview(buffer, "        native_payload_object = PyBool_FromLong((long)native_payload);\n")
    elif type_name == "f32" or type_name == "f64":
        emit_tokens_push_sview(buffer, "        native_payload_object = PyFloat_FromDouble((double)native_payload);\n")
    elif type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or type_name == "usize" or type_name == "uintptr":
        emit_tokens_push_sview(buffer, "        native_payload_object = PyLong_FromUnsignedLongLong((unsigned long long)native_payload);\n")
    else:
        emit_tokens_push_sview(buffer, "        native_payload_object = PyLong_FromLongLong((long long)native_payload);\n")
    emit_tokens_push_sview(buffer, "        if (native_payload_object == NULL) return NULL;\n")




# Aggregate error payloads are copied before ordinary argument cleanup because their native
# storage may borrow a Python sequence, dictionary, or struct arena.  The leaf converters already
# release the result object they have built and often release the output arena on their local
# failure paths, but they cannot see the wrapper's input ownership table.  Emit the conversion in
# a temporary snippet, remove its local wrapper-arena frees, and funnel every failure through one
# wrapper-owned cleanup label.  This keeps the arena/reference table balanced for both malformed
# native payloads and Python allocation failures without changing the successful payload ABI.
def emit_pymodule_error_payload_conversion_guarded(buffer: mutable darray[u8]&, file: Ast::File&, target_params: darray[Ast::ParamDecl]&, payload_type_name: sview, error_family: sview, structured_payload_error: bool, has_return_arena: bool) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    snippet: mutable darray[u8] = []
    if structured_payload_error:
        emit_pymodule_error_payload_struct_conversion(&snippet, file, file.top_decls, error_family)
    else:
        emit_pymodule_error_payload_conversion(&snippet, file, payload_type_name)
    # The wrapper owns the live arena. Any arena-free emitted by a leaf converter belongs to the
    # old direct-return path and must be removed before jumping to the shared cleanup label. Leaf
    # converters also release a partially-built destination before failing; clear that variable
    # before the shared XDECREF so structured and aggregate payloads cannot be decremented twice.
    pymodule_replace_generated(&snippet, "arena_free(&arena);", "")
    pymodule_replace_generated(&snippet, "Py_DECREF(native_payload_object);", "Py_DECREF(native_payload_object); native_payload_object = NULL;")
    pymodule_replace_generated(&snippet, "Py_XDECREF(native_payload_object);", "Py_XDECREF(native_payload_object); native_payload_object = NULL;")
    pymodule_replace_generated(&snippet, "return NULL;", "goto elisa_pymodule_error_payload_conversion_failed;")
    for snippet_index in 0..<snippet.count |buffer, snippet|:
        buffer.push(snippet[snippet_index])
    emit_tokens_push_sview(buffer, "        goto elisa_pymodule_error_payload_conversion_done;\n        elisa_pymodule_error_payload_conversion_failed:\n        Py_XDECREF(native_payload_object);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena);\n") if has_return_arena
    emit_tokens_push_sview(buffer, "        return NULL;\n        elisa_pymodule_error_payload_conversion_done:;\n")




# At this point ordinary argument ownership has already been released, but a darray reference
# input can still keep the wrapper arena live while a scalar/optional payload is copied. Preserve
# the converter's precise Python exception and make every generated failure release that arena.
def emit_pymodule_error_payload_conversion_after_input_cleanup(buffer: mutable darray[u8]&, file: Ast::File&, payload_type_name: sview, error_family: sview, structured_payload_error: bool, has_return_arena: bool) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    if not has_return_arena:
        emit_pymodule_error_payload_struct_conversion(buffer, file, file.top_decls, error_family) if structured_payload_error else emit_pymodule_error_payload_conversion(buffer, file, payload_type_name)
        return
    snippet: mutable darray[u8] = []
    if structured_payload_error:
        emit_pymodule_error_payload_struct_conversion(&snippet, file, file.top_decls, error_family)
    else:
        emit_pymodule_error_payload_conversion(&snippet, file, payload_type_name)
    # Conversion snippets may already contain the old direct-path arena release. Normalize it
    # before routing every failure through one wrapper-owned arena label. A goto is intentional:
    # some small converters use unbraced `if (...) return NULL;` statements, so textual insertion
    # of `arena_free` before `return` would otherwise make the return unconditional.
    pymodule_replace_generated(&snippet, "arena_free(&arena);", "")
    pymodule_replace_generated(&snippet, "return NULL;", "goto elisa_pymodule_error_payload_after_cleanup_failed;")
    for snippet_index in 0..<snippet.count |buffer, snippet|:
        buffer.push(snippet[snippet_index])
    emit_tokens_push_sview(buffer, "        goto elisa_pymodule_error_payload_after_cleanup_done;\n        elisa_pymodule_error_payload_after_cleanup_failed:\n        arena_free(&arena);\n        return NULL;\n        elisa_pymodule_error_payload_after_cleanup_done:;\n")




def pymodule_function_error_family(file: Ast::File&, name: sview) -> sview can[Abort.Panic, Memory.Allocate]:
    target_decl: Ast::Decl? = pymodule_find_function_in(file.top_decls, name)
    if target_decl is target_function:
        if target_function is Decl.Func(target_function_name, target_params, target_return, target_body, target_effects, target_decorators, target_pos):
            for error_index in 0..<file.error_set_func_lines.count |file, target_pos|:
                if file.error_set_func_lines[error_index] == target_pos.line:
                    return file.error_set_func_names[error_index] if error_index < file.error_set_func_names.count
    return ""




def pymodule_error_families(file: Ast::File&) -> darray[sview] can[Abort.Panic, Memory.Allocate]:
    families: mutable darray[sview] = []
    for annotation in file.enum_annotations |families, file|:
        continue if annotation.name != "__pymodule_fn"
        target_name: mutable sview = ""
        for target_annotation in file.enum_annotations |target_name, annotation|:
            target_name <- target_annotation.owner if target_annotation.name == "__pymodule_target_ref" and target_annotation.line == annotation.line
        family: sview = pymodule_function_error_family(file, target_name)
        continue if family == ""
        already_emitted: mutable bool = false
        for emitted_family in families |already_emitted, family|:
            already_emitted <- true if emitted_family == family
        families.push(family) if not already_emitted
    return families
