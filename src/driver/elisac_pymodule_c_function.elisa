# `-emit pymodule` — one exported function's C wrapper, stage 1 of 5: the target lookup, the
# facts derived from its signature, and the per-parameter HELPER functions the wrapper needs
# emitted before it. Called once per `__pymodule_fn` row by elisac_pymodule_c_report.elisa.

include "./elisac_pymodule_c_function_2.elisa"
include "./elisac_pymodule_c_function_3.elisa"
include "./elisac_pymodule_c_function_4.elisa"
include "./elisac_pymodule_c_function_5.elisa"

def emit_pymodule_c_function(buffer: mutable darray[u8]&, file: mutable Ast::File&, module_name: sview, annotation: Ast::EnumAnnotation) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    return if annotation.name != "__pymodule_fn"
    target_name: mutable sview = ""
    for target_annotation in file.enum_annotations |target_name, annotation|:
        target_name <- target_annotation.owner if target_annotation.name == "__pymodule_target_ref" and target_annotation.line == annotation.line
    target_decl: Ast::Decl? = pymodule_find_function_in(file.top_decls, target_name)
    if target_decl is target_function:
        if target_function is Decl.Func(target_function_name, source_params, target_return, target_body, target_effects, target_decorators, target_pos):
            target_params: mutable darray[Ast::ParamDecl] = pymodule_alias_normalize_params(file, source_params)
            return_type_name: mutable sview = "void"
            if target_return is declared_return:
                return_type_name <- pymodule_alias_type_name(file, declared_return)
            is_error: bool = pymodule_function_is_error(file, target_name)
            error_family: sview = pymodule_function_error_family(file, target_name) if is_error else ""
            has_payload_error: bool = is_error and pymodule_error_set_has_payload_in(file.top_decls, error_family)
            payload_type_name: sview = pymodule_error_payload_type_in(file, file.top_decls, error_family) if has_payload_error else ""
            structured_payload_error: bool = has_payload_error and pymodule_error_payload_is_structured_in(file.top_decls, error_family)
            has_payload_arena: bool = has_payload_error and pymodule_error_payload_needs_arena_in(file, file.top_decls, error_family)
            has_payload_struct: bool = has_payload_error and (pymodule_struct_return_supported(file, payload_type_name) if not structured_payload_error else pymodule_error_payload_contains_struct_in(file, file.top_decls, error_family))
            has_darray_param: mutable bool = false
            for darray_probe in target_params |has_darray_param|:
                has_darray_param <- true if pymodule_is_darray_type(pymodule_alias_type_name(file, darray_probe.type_expression))
            has_darray_ref_param: mutable bool = false
            for darray_ref_probe in target_params |has_darray_ref_param|:
                darray_ref_type_name: sview = pymodule_alias_type_name(file, darray_ref_probe.type_expression)
                has_darray_ref_param <- true if pymodule_darray_ref_parameter(darray_ref_type_name, darray_ref_probe.type_expression)
            has_struct_darray_param: mutable bool = false
            for struct_darray_probe in target_params |has_struct_darray_param|:
                struct_darray_type_name: sview = pymodule_alias_type_name(file, struct_darray_probe.type_expression)
                # Direct struct inputs also own a temporary arena/reference table.  Treat
                # them like aggregate sequence inputs so scalar-return wrappers cannot take
                # the expression fast path and leak that storage after a successful call.
                if pymodule_struct_input_supported(file, struct_darray_type_name):
                    has_struct_darray_param <- true
                elif pymodule_is_darray_type(struct_darray_type_name) or pymodule_is_view_type(struct_darray_type_name):
                    struct_darray_element_name: sview = pymodule_darray_element_name(struct_darray_type_name) if pymodule_is_darray_type(struct_darray_type_name) else pymodule_view_element_name(struct_darray_type_name)
                    has_struct_darray_param <- true if pymodule_struct_input_supported(file, struct_darray_element_name)
            has_dict_param: mutable bool = false
            for dict_probe in target_params |has_dict_param|:
                has_dict_param <- true if pymodule_is_dict_type(pymodule_alias_type_name(file, dict_probe.type_expression))
            has_set_param: mutable bool = false
            for set_probe in target_params |has_set_param|:
                has_set_param <- true if pymodule_is_set_type(pymodule_alias_type_name(file, set_probe.type_expression))
            has_view_param: mutable bool = false
            for view_probe in target_params |has_view_param|:
                has_view_param <- true if pymodule_is_view_type(pymodule_alias_type_name(file, view_probe.type_expression))
            has_dict_return: bool = pymodule_is_dict_type(return_type_name)
            has_set_return: bool = pymodule_is_set_type(return_type_name)
            has_view_return: bool = pymodule_is_view_type(return_type_name)
            has_optional_return: bool = pymodule_is_optional_scalar_type(return_type_name)
            has_struct_return: bool = pymodule_struct_return_supported(file, return_type_name)
            has_fixed_array_return: bool = pymodule_fixed_array_return_supported(return_type_name)
            has_output_arena: bool = pymodule_is_darray_type(return_type_name) or has_dict_return or has_set_return or (has_struct_return and pymodule_struct_return_contains_darray(file, return_type_name)) or has_payload_arena
            has_return_arena: bool = has_output_arena or has_darray_ref_param
            # Emit per-wrapper helpers for top-level nested lists after all named-struct
            # typedefs have been declared, but before the wrapper calls them.
            for nested_helper_index in 0..<target_params.count |buffer, file, target_params, target_name, nested_helper_index, module_name|:
                nested_parameter_type: sview = pymodule_alias_type_name(file, target_params[nested_helper_index].type_expression)
                continue if not pymodule_is_darray_type(nested_parameter_type)
                nested_parameter_element: sview = pymodule_darray_element_name(nested_parameter_type)
                continue if not pymodule_is_darray_type(nested_parameter_element) and not pymodule_is_set_type(nested_parameter_element)
                helper_name_storage: mutable darray[u8] = []
                emit_tokens_push_sview(&helper_name_storage, "elisa_pymodule_")
                emit_tokens_push_sview(&helper_name_storage, module_name)
                emit_tokens_push_sview(&helper_name_storage, "_")
                emit_tokens_push_sview(&helper_name_storage, annotation.owner)
                emit_tokens_push_sview(&helper_name_storage, "_nested_")
                append_decimal(&helper_name_storage, nested_helper_index.i64())
                helper_name_storage.push(95)
                emit_tokens_push_sview(&helper_name_storage, "from_py")
                helper_name_from_py: sview = sview(&helper_name_storage[0], 0, helper_name_storage.count)
                if pymodule_is_darray_type(nested_parameter_element) and pymodule_top_level_nested_darray_input_supported(file, nested_parameter_type):
                    emit_pymodule_composed_nested_darray_input_helper(buffer, file, helper_name_from_py, nested_parameter_type)
                elif pymodule_is_set_type(nested_parameter_element):
                    emit_pymodule_darray_set_input_helper(buffer, helper_name_from_py, nested_parameter_element)
                helper_name_to_py_storage: mutable darray[u8] = []
                emit_tokens_push_sview(&helper_name_to_py_storage, "elisa_pymodule_")
                emit_tokens_push_sview(&helper_name_to_py_storage, module_name)
                emit_tokens_push_sview(&helper_name_to_py_storage, "_")
                emit_tokens_push_sview(&helper_name_to_py_storage, annotation.owner)
                emit_tokens_push_sview(&helper_name_to_py_storage, "_nested_")
                append_decimal(&helper_name_to_py_storage, nested_helper_index.i64())
                helper_name_to_py_storage.push(95)
                emit_tokens_push_sview(&helper_name_to_py_storage, "to_py")
                helper_name_to_py: sview = sview(&helper_name_to_py_storage[0], 0, helper_name_to_py_storage.count)
                if pymodule_is_darray_type(nested_parameter_element) and pymodule_top_level_nested_darray_return_supported(file, nested_parameter_type):
                    emit_pymodule_composed_nested_darray_output_helper(buffer, file, helper_name_to_py, nested_parameter_type)
                elif pymodule_is_set_type(nested_parameter_element):
                    emit_pymodule_darray_set_output_helper(buffer, helper_name_to_py, nested_parameter_element)
            # A darray of views has a distinct element ABI (`ElisaView`) and therefore
            # cannot use the ordinary scalar list loop.  Emit one shared-arena converter
            # pair per parameter so nested views retain the same lifetime and diagnostics
            # as standalone views.
            for darray_view_helper_index in 0..<target_params.count |buffer, file, target_params, darray_view_helper_index, module_name, annotation|:
                darray_view_parameter_type: sview = pymodule_alias_type_name(file, target_params[darray_view_helper_index].type_expression)
                continue if not pymodule_is_darray_type(darray_view_parameter_type)
                darray_view_element_type: sview = pymodule_darray_element_name(darray_view_parameter_type)
                continue if not pymodule_is_view_type(darray_view_element_type)
                continue if not pymodule_view_bridge_supported(file, darray_view_element_type)
                darray_view_from_py_storage: mutable darray[u8] = []
                emit_tokens_push_sview(&darray_view_from_py_storage, "elisa_pymodule_")
                emit_tokens_push_sview(&darray_view_from_py_storage, module_name)
                emit_tokens_push_sview(&darray_view_from_py_storage, "_")
                emit_tokens_push_sview(&darray_view_from_py_storage, annotation.owner)
                emit_tokens_push_sview(&darray_view_from_py_storage, "_view_")
                append_decimal(&darray_view_from_py_storage, darray_view_helper_index.i64())
                emit_tokens_push_sview(&darray_view_from_py_storage, "_from_py")
                darray_view_from_py_helper: sview = sview(&darray_view_from_py_storage[0], 0, darray_view_from_py_storage.count)
                emit_pymodule_darray_view_input_helper(buffer, file, darray_view_from_py_helper, darray_view_element_type)
                darray_view_to_py_storage: mutable darray[u8] = []
                emit_tokens_push_sview(&darray_view_to_py_storage, "elisa_pymodule_")
                emit_tokens_push_sview(&darray_view_to_py_storage, module_name)
                emit_tokens_push_sview(&darray_view_to_py_storage, "_")
                emit_tokens_push_sview(&darray_view_to_py_storage, annotation.owner)
                emit_tokens_push_sview(&darray_view_to_py_storage, "_view_")
                append_decimal(&darray_view_to_py_storage, darray_view_helper_index.i64())
                emit_tokens_push_sview(&darray_view_to_py_storage, "_to_py")
                darray_view_to_py_helper: sview = sview(&darray_view_to_py_storage[0], 0, darray_view_to_py_storage.count)
                emit_pymodule_darray_view_output_helper(buffer, file, darray_view_to_py_helper, darray_view_element_type)
            # A list of mappings uses the ordinary dict converter for each ElisaDict element.
            # Generate one pair per parameter so nested value helpers and ownership state stay
            # local to the exported wrapper.
            for darray_dict_helper_index in 0..<target_params.count |buffer, file, target_params, darray_dict_helper_index, module_name, annotation|:
                darray_dict_parameter_type: sview = pymodule_alias_type_name(file, target_params[darray_dict_helper_index].type_expression)
                continue if not pymodule_is_darray_type(darray_dict_parameter_type)
                darray_dict_element_type: sview = pymodule_darray_element_name(darray_dict_parameter_type)
                continue if not pymodule_is_dict_type(darray_dict_element_type)
                darray_dict_from_py_storage: mutable darray[u8] = []
                emit_tokens_push_sview(&darray_dict_from_py_storage, "elisa_pymodule_")
                emit_tokens_push_sview(&darray_dict_from_py_storage, module_name)
                emit_tokens_push_sview(&darray_dict_from_py_storage, "_")
                emit_tokens_push_sview(&darray_dict_from_py_storage, annotation.owner)
                emit_tokens_push_sview(&darray_dict_from_py_storage, "_darray_dict_")
                append_decimal(&darray_dict_from_py_storage, darray_dict_helper_index.i64())
                emit_tokens_push_sview(&darray_dict_from_py_storage, "_from_py")
                darray_dict_from_py_helper: sview = sview(&darray_dict_from_py_storage[0], 0, darray_dict_from_py_storage.count)
                darray_dict_to_py_storage: mutable darray[u8] = []
                emit_tokens_push_sview(&darray_dict_to_py_storage, "elisa_pymodule_")
                emit_tokens_push_sview(&darray_dict_to_py_storage, module_name)
                emit_tokens_push_sview(&darray_dict_to_py_storage, "_")
                emit_tokens_push_sview(&darray_dict_to_py_storage, annotation.owner)
                emit_tokens_push_sview(&darray_dict_to_py_storage, "_darray_dict_")
                append_decimal(&darray_dict_to_py_storage, darray_dict_helper_index.i64())
                emit_tokens_push_sview(&darray_dict_to_py_storage, "_to_py")
                darray_dict_to_py_helper: sview = sview(&darray_dict_to_py_storage[0], 0, darray_dict_to_py_storage.count)
                emit_pymodule_darray_dict_element_helpers(buffer, file, darray_dict_from_py_helper, darray_dict_to_py_helper, darray_dict_element_type)
            # Dictionary values can themselves be recursively nested darrays. Generate a
            # pair of per-wrapper converters so the bucket bridge can reuse the exact same
            # ownership and validation rules as standalone nested-list parameters.
            for dict_helper_index in 0..<target_params.count |buffer, file, target_params, dict_helper_index, module_name, annotation|:
                dict_parameter_type: sview = pymodule_alias_type_name(file, target_params[dict_helper_index].type_expression)
                continue if not pymodule_is_dict_type(dict_parameter_type)
                dict_value_type: sview = pymodule_dict_value_name(dict_parameter_type)
                dict_from_py_storage: mutable darray[u8] = []
                emit_tokens_push_sview(&dict_from_py_storage, "elisa_pymodule_")
                emit_tokens_push_sview(&dict_from_py_storage, module_name)
                emit_tokens_push_sview(&dict_from_py_storage, "_")
                emit_tokens_push_sview(&dict_from_py_storage, annotation.owner)
                emit_tokens_push_sview(&dict_from_py_storage, "_dict_")
                append_decimal(&dict_from_py_storage, dict_helper_index.i64())
                emit_tokens_push_sview(&dict_from_py_storage, "_from_py")
                dict_from_py_helper: sview = sview(&dict_from_py_storage[0], 0, dict_from_py_storage.count)
                if pymodule_is_dict_type(dict_value_type):
                    emit_pymodule_composed_dict_input_helper(buffer, file, dict_from_py_helper, dict_value_type)
                elif pymodule_is_set_type(dict_value_type):
                    emit_pymodule_composed_set_input_helper(buffer, dict_from_py_helper, dict_value_type)
                elif pymodule_is_darray_type(dict_value_type) and pymodule_is_set_type(pymodule_darray_element_name(dict_value_type)):
                    emit_pymodule_darray_set_input_helper(buffer, dict_from_py_helper, pymodule_darray_element_name(dict_value_type))
                elif pymodule_is_darray_type(dict_value_type) and pymodule_is_dict_type(pymodule_darray_element_name(dict_value_type)):
                    emit_pymodule_darray_dict_input_helper(buffer, file, dict_from_py_helper, pymodule_darray_element_name(dict_value_type))
                elif pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) == 1.usize() and pymodule_struct_input_supported(file, pymodule_darray_element_name(dict_value_type)):
                    emit_pymodule_darray_struct_input_helper(buffer, file, dict_from_py_helper, pymodule_darray_element_name(dict_value_type))
                elif pymodule_is_view_type(dict_value_type) and pymodule_darray_c_element_type(pymodule_view_element_name(dict_value_type)) == "" and pymodule_struct_input_supported(file, pymodule_view_element_name(dict_value_type)):
                    emit_pymodule_view_struct_input_helper(buffer, file, dict_from_py_helper, pymodule_view_element_name(dict_value_type))
                elif pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) >= 2.usize() and pymodule_top_level_nested_darray_input_supported(file, dict_value_type):
                    emit_pymodule_composed_nested_darray_input_helper(buffer, file, dict_from_py_helper, dict_value_type)
                dict_to_py_storage: mutable darray[u8] = []
                emit_tokens_push_sview(&dict_to_py_storage, "elisa_pymodule_")
                emit_tokens_push_sview(&dict_to_py_storage, module_name)
                emit_tokens_push_sview(&dict_to_py_storage, "_")
                emit_tokens_push_sview(&dict_to_py_storage, annotation.owner)
                emit_tokens_push_sview(&dict_to_py_storage, "_dict_")
                append_decimal(&dict_to_py_storage, dict_helper_index.i64())
                emit_tokens_push_sview(&dict_to_py_storage, "_to_py")
                dict_to_py_helper: sview = sview(&dict_to_py_storage[0], 0, dict_to_py_storage.count)
                if pymodule_is_dict_type(dict_value_type):
                    emit_pymodule_composed_dict_output_helper(buffer, file, dict_to_py_helper, dict_value_type)
                elif pymodule_is_set_type(dict_value_type):
                    emit_pymodule_composed_set_output_helper(buffer, dict_to_py_helper, dict_value_type)
                elif pymodule_is_darray_type(dict_value_type) and pymodule_is_set_type(pymodule_darray_element_name(dict_value_type)):
                    emit_pymodule_darray_set_output_helper(buffer, dict_to_py_helper, pymodule_darray_element_name(dict_value_type))
                elif pymodule_is_darray_type(dict_value_type) and pymodule_is_dict_type(pymodule_darray_element_name(dict_value_type)):
                    emit_pymodule_darray_dict_output_helper(buffer, file, dict_to_py_helper, pymodule_darray_element_name(dict_value_type))
                elif pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) == 1.usize() and pymodule_struct_return_supported(file, pymodule_darray_element_name(dict_value_type)):
                    emit_pymodule_darray_struct_output_helper(buffer, file, dict_to_py_helper, pymodule_darray_element_name(dict_value_type))
                elif pymodule_is_view_type(dict_value_type) and pymodule_darray_c_element_type(pymodule_view_element_name(dict_value_type)) == "" and pymodule_struct_return_supported(file, pymodule_view_element_name(dict_value_type)):
                    emit_pymodule_view_struct_output_helper(buffer, file, dict_to_py_helper, pymodule_view_element_name(dict_value_type))
                elif pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) >= 2.usize() and pymodule_top_level_nested_darray_return_supported(file, dict_value_type):
                    emit_pymodule_composed_nested_darray_output_helper(buffer, file, dict_to_py_helper, dict_value_type)
            if pymodule_is_darray_type(return_type_name) and pymodule_is_darray_type(pymodule_darray_element_name(return_type_name)) and pymodule_top_level_nested_darray_return_supported(file, return_type_name):
                nested_return_helper_storage: mutable darray[u8] = []
                emit_tokens_push_sview(&nested_return_helper_storage, "elisa_pymodule_")
                emit_tokens_push_sview(&nested_return_helper_storage, module_name)
                emit_tokens_push_sview(&nested_return_helper_storage, "_")
                emit_tokens_push_sview(&nested_return_helper_storage, annotation.owner)
                emit_tokens_push_sview(&nested_return_helper_storage, "_nested_return_to_py")
                nested_return_helper: sview = sview(&nested_return_helper_storage[0], 0, nested_return_helper_storage.count)
                emit_pymodule_composed_nested_darray_output_helper(buffer, file, nested_return_helper, return_type_name)
            if pymodule_is_darray_type(return_type_name) and pymodule_is_view_type(pymodule_darray_element_name(return_type_name)) and pymodule_view_bridge_supported(file, pymodule_darray_element_name(return_type_name)):
                view_return_helper_storage: mutable darray[u8] = []
                emit_tokens_push_sview(&view_return_helper_storage, "elisa_pymodule_")
                emit_tokens_push_sview(&view_return_helper_storage, module_name)
                emit_tokens_push_sview(&view_return_helper_storage, "_")
                emit_tokens_push_sview(&view_return_helper_storage, annotation.owner)
                emit_tokens_push_sview(&view_return_helper_storage, "_view_return_to_py")
                view_return_helper: sview = sview(&view_return_helper_storage[0], 0, view_return_helper_storage.count)
                emit_pymodule_darray_view_output_helper(buffer, file, view_return_helper, pymodule_darray_element_name(return_type_name))
            if pymodule_is_darray_type(return_type_name) and pymodule_is_set_type(pymodule_darray_element_name(return_type_name)):
                nested_set_return_helper_storage: mutable darray[u8] = []
                emit_tokens_push_sview(&nested_set_return_helper_storage, "elisa_pymodule_")
                emit_tokens_push_sview(&nested_set_return_helper_storage, module_name)
                emit_tokens_push_sview(&nested_set_return_helper_storage, "_")
                emit_tokens_push_sview(&nested_set_return_helper_storage, annotation.owner)
                emit_tokens_push_sview(&nested_set_return_helper_storage, "_nested_return_to_py")
                nested_set_return_helper: sview = sview(&nested_set_return_helper_storage[0], 0, nested_set_return_helper_storage.count)
                emit_pymodule_darray_set_output_helper(buffer, nested_set_return_helper, pymodule_darray_element_name(return_type_name))
            if pymodule_is_darray_type(return_type_name) and pymodule_is_dict_type(pymodule_darray_element_name(return_type_name)):
                darray_dict_return_from_py_storage: mutable darray[u8] = []
                emit_tokens_push_sview(&darray_dict_return_from_py_storage, "elisa_pymodule_")
                emit_tokens_push_sview(&darray_dict_return_from_py_storage, module_name)
                emit_tokens_push_sview(&darray_dict_return_from_py_storage, "_")
                emit_tokens_push_sview(&darray_dict_return_from_py_storage, annotation.owner)
                emit_tokens_push_sview(&darray_dict_return_from_py_storage, "_darray_dict_return_from_py")
                darray_dict_return_from_py_helper: sview = sview(&darray_dict_return_from_py_storage[0], 0, darray_dict_return_from_py_storage.count)
                darray_dict_return_to_py_storage: mutable darray[u8] = []
                emit_tokens_push_sview(&darray_dict_return_to_py_storage, "elisa_pymodule_")
                emit_tokens_push_sview(&darray_dict_return_to_py_storage, module_name)
                emit_tokens_push_sview(&darray_dict_return_to_py_storage, "_")
                emit_tokens_push_sview(&darray_dict_return_to_py_storage, annotation.owner)
                emit_tokens_push_sview(&darray_dict_return_to_py_storage, "_darray_dict_return_to_py")
                darray_dict_return_to_py_helper: sview = sview(&darray_dict_return_to_py_storage[0], 0, darray_dict_return_to_py_storage.count)
