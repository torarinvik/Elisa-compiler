# `-emit pymodule` — the generated helpers for nested error payloads. Their names carry a stable
# suffix, because a view pushed into the dedup list must not borrow per-iteration storage.


def emit_pymodule_error_nested_darray_helpers(buffer: mutable darray[u8]&, file: Ast::File&, declarations: darray[Ast::Decl]&, wanted: sview, emitted: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |buffer, file, wanted, emitted|:
        if declaration is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            continue if error_name != wanted
            for variant in error_variants |buffer, file, emitted|:
                for field in variant.fields |buffer, file, emitted|:
                    field_type_name: sview = pymodule_alias_type_name(file, field)
                    if pymodule_is_darray_type(field_type_name) and pymodule_is_set_type(pymodule_darray_element_name(field_type_name)):
                        set_helper_storage: mutable darray[u8] = []
                        set_helper: sview = pymodule_error_named_aggregate_helper_name(field_type_name, &set_helper_storage)
                        already_emitted_set: mutable bool = false
                        for emitted_suffix in emitted |field_type_name|:
                            already_emitted_set <- true if emitted_suffix == field_type_name
                        if not already_emitted_set:
                            emit_pymodule_darray_set_output_helper(buffer, set_helper, pymodule_darray_element_name(field_type_name))
                            emitted.push(field_type_name)
                    elif pymodule_is_darray_type(field_type_name) and pymodule_darray_nesting_depth(field_type_name) == 1.usize() and pymodule_struct_return_supported(file, pymodule_darray_element_name(field_type_name)):
                        named_helper_storage: mutable darray[u8] = []
                        named_helper: sview = pymodule_error_named_aggregate_helper_name(field_type_name, &named_helper_storage)
                        already_emitted_named: mutable bool = false
                        for emitted_suffix in emitted |field_type_name|:
                            already_emitted_named <- true if emitted_suffix == field_type_name
                        if not already_emitted_named:
                            emit_pymodule_darray_struct_output_helper(buffer, file, named_helper, pymodule_darray_element_name(field_type_name))
                            emitted.push(field_type_name)
                    elif pymodule_is_view_type(field_type_name) and pymodule_struct_return_supported(file, pymodule_view_element_name(field_type_name)):
                        named_helper_storage: mutable darray[u8] = []
                        named_helper: sview = pymodule_error_named_aggregate_helper_name(field_type_name, &named_helper_storage)
                        already_emitted_named: mutable bool = false
                        for emitted_suffix in emitted |field_type_name|:
                            already_emitted_named <- true if emitted_suffix == field_type_name
                        if not already_emitted_named:
                            emit_pymodule_view_struct_output_helper(buffer, file, named_helper, pymodule_view_element_name(field_type_name))
                            emitted.push(field_type_name)
                    elif pymodule_is_darray_type(field_type_name) and pymodule_is_dict_type(pymodule_darray_element_name(field_type_name)):
                        darray_dict_suffix_storage: mutable darray[u8] = []
                        darray_dict_suffix: sview = pymodule_error_darray_dict_helper_name(field_type_name, &darray_dict_suffix_storage, false)
                        already_emitted_darray_dict: mutable bool = false
                        for emitted_suffix in emitted |darray_dict_suffix|:
                            already_emitted_darray_dict <- true if emitted_suffix == darray_dict_suffix
                        if not already_emitted_darray_dict:
                            emit_pymodule_error_darray_dict_output_helper(buffer, file, field_type_name)
                            emitted.push(pymodule_stable_suffix(darray_dict_suffix))
                    elif pymodule_is_dict_type(field_type_name):
                        dict_helper_suffix_storage: mutable darray[u8] = []
                        dict_helper_suffix: sview = pymodule_error_nested_dict_helper_suffix(field_type_name, &dict_helper_suffix_storage)
                        if dict_helper_suffix != "":
                            emitted_dict_suffix: mutable darray[u8] = []
                            emit_tokens_push_sview(&emitted_dict_suffix, "dict_")
                            emit_tokens_push_sview(&emitted_dict_suffix, dict_helper_suffix)
                            emitted_dict_suffix_view: sview = sview(&emitted_dict_suffix[0], 0, emitted_dict_suffix.count)
                            already_emitted_dict: mutable bool = false
                            for emitted_suffix in emitted |emitted_dict_suffix_view|:
                                already_emitted_dict <- true if emitted_suffix == emitted_dict_suffix_view
                            if not already_emitted_dict:
                                dict_helper_name_storage: mutable darray[u8] = []
                                dict_helper_name: sview = pymodule_error_nested_dict_helper_name(field_type_name, &dict_helper_name_storage)
                                if pymodule_is_dict_type(pymodule_dict_value_name(field_type_name)):
                                    emit_pymodule_composed_dict_output_helper(buffer, file, dict_helper_name, pymodule_dict_value_name(field_type_name))
                                elif pymodule_is_set_type(pymodule_dict_value_name(field_type_name)):
                                    emit_pymodule_composed_set_output_helper(buffer, dict_helper_name, pymodule_dict_value_name(field_type_name))
                                elif pymodule_is_darray_type(pymodule_dict_value_name(field_type_name)) and pymodule_darray_nesting_depth(pymodule_dict_value_name(field_type_name)) == 1.usize() and pymodule_darray_c_element_type(pymodule_darray_element_name(pymodule_dict_value_name(field_type_name))) == "":
                                    emit_pymodule_darray_struct_output_helper(buffer, file, dict_helper_name, pymodule_darray_element_name(pymodule_dict_value_name(field_type_name)))
                                elif pymodule_is_view_type(pymodule_dict_value_name(field_type_name)) and pymodule_darray_c_element_type(pymodule_view_element_name(pymodule_dict_value_name(field_type_name))) == "":
                                    emit_pymodule_view_struct_output_helper(buffer, file, dict_helper_name, pymodule_view_element_name(pymodule_dict_value_name(field_type_name)))
                                else:
                                    emit_pymodule_composed_nested_darray_output_helper(buffer, file, dict_helper_name, pymodule_dict_value_name(field_type_name))
                                emitted.push(pymodule_stable_suffix(emitted_dict_suffix_view))
                    continue if not pymodule_error_nested_darray_supported(field_type_name)
                    helper_suffix_storage: mutable darray[u8] = []
                    helper_suffix: sview = pymodule_error_nested_darray_helper_suffix(field_type_name, &helper_suffix_storage)
                    continue if helper_suffix == ""
                    already_emitted: mutable bool = false
                    for emitted_suffix in emitted |helper_suffix|:
                        already_emitted <- true if emitted_suffix == helper_suffix
                    continue if already_emitted
                    helper_name_storage: mutable darray[u8] = []
                    emit_tokens_push_sview(&helper_name_storage, "elisa_pymodule_error_nested_")
                    emit_tokens_push_sview(&helper_name_storage, helper_suffix)
                    emit_tokens_push_sview(&helper_name_storage, "_to_py")
                    helper_name: sview = sview(&helper_name_storage[0], 0, helper_name_storage.count)
                    emit_pymodule_composed_nested_darray_output_helper(buffer, file, helper_name, field_type_name)
                    emitted.push(pymodule_stable_suffix(helper_suffix))
        if declaration is Decl.Module(error_module_name, error_module_body, error_module_pos):
            emit_pymodule_error_nested_darray_helpers(buffer, file, error_module_body, wanted, emitted)
        if declaration is Decl.Scoped(error_scope_body, error_scope_pos):
            emit_pymodule_error_nested_darray_helpers(buffer, file, error_scope_body, wanted, emitted)
