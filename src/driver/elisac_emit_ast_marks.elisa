# `-emit ast` -- keyed views of the parser's enum-annotation side table.
#
# The AST summary asks the side table per declaration: is this def a law callable
# (sentinel line 3900000025), a frame law (3900000027), a generated typestate function,
# a `const module`, an `export` alias at this source line? Each question was a scan of the
# whole table, and the table grows with the unit, so the report was quadratic (most of the
# ~17 s `-emit ast` of the compiler's own unit). The report now builds these views once:
# rows stably sorted by `line` (sentinel tags are lines too), plus the two name-keyed
# subsets. Every helper keeps its original predicate and visits the rows that predicate
# could accept in their original relative order, so the first match is the same row.


struct EmitAstMarks:
    # Every row, stably sorted by `line`.
    by_line: darray[Ast::EnumAnnotation]
    # Rows tagged 3900000025 (law callables) and 3900000027 (frame laws), in table order.
    law_callables: darray[Ast::EnumAnnotation]
    frame_laws: darray[Ast::EnumAnnotation]
    # Rows named `__typestate_generated`, and rows owned by `__const_module`, in table order.
    typestate_generated: darray[Ast::EnumAnnotation]
    const_modules: darray[Ast::EnumAnnotation]




# The rows of BY_LINE whose line is LINE, in table order (binary search to the first).
def emit_ast_marks_at_line(by_line: darray[Ast::EnumAnnotation]&, line: u32) -> darray[Ast::EnumAnnotation] can[Abort.Panic, Memory.Allocate]:
    rows: mutable darray[Ast::EnumAnnotation] = []
    low: mutable usize = 0
    high: mutable usize = by_line.count
    while low < high |low, high, by_line, line|:
        middle: usize = low + (high - low) / 2
        if by_line[middle].line < line:
            low <- middle + 1
        else:
            high <- middle
    while low < by_line.count and by_line[low].line == line |low, rows, by_line, line|:
        rows.push(by_line[low])
        low <- low + 1
    return rows




def emit_ast_marks_build(annotations: darray[Ast::EnumAnnotation]&) -> EmitAstMarks can[Abort.Panic, Memory.Allocate]:
    # Bottom-up merge sort of row indices by line; ties keep table order.
    order: mutable darray[usize] = []
    scratch: mutable darray[usize] = []
    for seed_index in 0..<annotations.count |order, scratch|:
        order.push(seed_index)
        scratch.push(seed_index)
    width: mutable usize = 1
    while width < order.count |width, order, scratch, annotations|:
        start: mutable usize = 0
        while start < order.count |start, width, order, scratch, annotations|:
            middle: usize = start + width if start + width < order.count else order.count
            stop: usize = start + 2 * width if start + 2 * width < order.count else order.count
            left: mutable usize = start
            right: mutable usize = middle
            target: mutable usize = start
            while target < stop |target, left, right, middle, stop, order, scratch, annotations|:
                take_right: bool = right < stop and (left >= middle or annotations[order[right]].line < annotations[order[left]].line)
                if take_right:
                    scratch[target] <- order[right]
                    right <- right + 1
                else:
                    scratch[target] <- order[left]
                    left <- left + 1
                target <- target + 1
            start <- stop
        for copy_index in 0..<order.count |order, scratch|:
            order[copy_index] <- scratch[copy_index]
        width <- width * 2
    by_line: mutable darray[Ast::EnumAnnotation] = []
    for sorted_index in order |by_line, annotations|:
        by_line.push(annotations[sorted_index])
    typestate_generated: mutable darray[Ast::EnumAnnotation] = []
    const_modules: mutable darray[Ast::EnumAnnotation] = []
    for annotation in annotations |typestate_generated, const_modules|:
        typestate_generated.push(annotation) if annotation.name == "__typestate_generated"
        const_modules.push(annotation) if annotation.owner == "__const_module"
    law_callables: darray[Ast::EnumAnnotation] = emit_ast_marks_at_line(by_line, 3900000025)
    frame_laws: darray[Ast::EnumAnnotation] = emit_ast_marks_at_line(by_line, 3900000027)
    return EmitAstMarks{by_line: by_line, law_callables: law_callables, frame_laws: frame_laws, typestate_generated: typestate_generated, const_modules: const_modules}
