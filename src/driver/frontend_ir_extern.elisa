# `.elisair` v2 — EXTERN declarations. `Decl.Extern` is deliberately compact in stage1's AST, so
# the two type shapes stage0 expects are rebuilt from what the parser retained, and anything
# whose metadata was lost refuses rather than being written back approximately.
# Continues frontend_ir_write.elisa.

extend IrWrite:
    private:

        # `Decl.Extern` is deliberately compact: the parser keeps the fixed arity and
        # the bare heads of foreign types, while the stage0 bundle needs a real
        # `ExternFuncDecl` with ParamDecl/Type nodes. Rebuild only the closed subset for
        # which the compact side table is lossless. Anything which the parser represented
        # as an opaque type shape is refused by name below; emitting a plausible but
        # weaker signature would change the program at the next stage. Decorators are
        # rebuilt as stage0 Annotation nodes because their compact source spans and raw
        # argument views are retained in the stage1 File side tables.
        def ir_extern_line_is_plain(source: sview, pos: Ast::Pos) -> bool:
            can Abort.Panic:
                index: mutable i64 = pos.offset.i64()
                length: i64 = sview_len(source).i64()
                while index < length and sview_at(source, index) != 10:
                    byte: u8 = sview_at(source, index)
                    break if byte == 35
                    # Optionality, arrays/generic applications, dotted paths, affine
                    # markers, and function-valued signatures all carry information
                    # that ExternParam/Decl.Extern do not retain structurally.
                    false return if byte == 63 or byte == 91 or byte == 93 or byte == 33 or byte == 46
                    if byte == 58 and index + 1 < length and sview_at(source, index + 1) == 58:
                        return false
                    if byte == 102 and index + 1 < length and sview_at(source, index + 1) == 110:
                        return false
                    index <- index + 1
                return true



        def ir_extern_has_lossy_metadata(annotations: darray[Ast::EnumAnnotation]&, line: u32) -> bool:
            can Abort.Panic:
                for annotation in annotations |line|:
                    continue if annotation.line != line
                    # This row is emitted for every ordinary `-> T` and is represented
                    # directly by Decl.Extern.return_type_name.
                    continue if annotation.owner == "__extern_return" and annotation.name != ""
                    return true
                return false



        # Rebuild the two type shapes retained by ExternParam/Decl.Extern without
        # constructing a temporary Ast.Expr. Expr is the compiler's packed AST enum, so
        # creating one outside the parser's active Ast.Expr.Store would itself require a
        # store allocation even though this writer only needs the corresponding stage0
        # wire nodes. The compact extern side tables are sufficient for a bare name and an
        # optional provenance ampersand, which map directly to IdentType and RefType.
        def ir_extern_type_node(bodies: mutable darray[u8]&, nodes: mutable u32&, refusal: mutable darray[u8]&, type_name: sview, provenance_bearing: bool, type_pos: Ast::Pos, filename: sview) -> u32:
            can Memory.Allocate, Abort.Panic:
                if type_name == "":
                    ir_refuse(refusal, "extern type without a name")
                    return 0
                bare_fields: mutable darray[u8] = []
                bare_live: mutable u32 = 0
                ir_put_str(&bare_fields, &bare_live, 1, type_name)
                ir_put_pos(&bare_fields, &bare_live, 2, type_pos, filename)
                bare_id: u32 = ir_emit_node(bodies, nodes, 194, bare_fields, bare_live)
                return bare_id if not provenance_bearing
                ref_fields: mutable darray[u8] = []
                ref_live: mutable u32 = 0
                ir_put_node(&ref_fields, &ref_live, 1, bare_id)
                ir_put_pos(&ref_fields, &ref_live, 3, type_pos, filename)
                return ir_emit_node(bodies, nodes, 220, ref_fields, ref_live)



        def ir_extern_param_out(payload: mutable darray[u8]&, bodies: mutable darray[u8]&, nodes: mutable u32&, refusal: mutable darray[u8]&, parameter: Ast::ExternParam, extern_pos: Ast::Pos, filename: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                if parameter.type_name == "":
                    ir_refuse(refusal, "extern parameter without a type")
                    return
                # `fn(...)` has a separate expression side table and is intentionally
                # outside this first exact subset. The caller checks this too, but keeping
                # the guard here makes the helper safe when reused.
                if parameter.fn_type_line != 0:
                    ir_refuse(refusal, "function-valued extern parameter")
                    return
                type_id: u32 = ir_extern_type_node(bodies, nodes, refusal, parameter.type_name, parameter.provenance_bearing, extern_pos, filename)
                fields: mutable darray[u8] = []
                live: mutable u32 = 0
                ir_put_bool(&fields, &live, 2, parameter.mutable_ref)
                ir_put_str(&fields, &live, 3, parameter.name)
                ir_put_node(&fields, &live, 5, type_id)
                ir_uvarint_out(payload, 204)
                ir_uvarint_out(payload, live.u64())
                for byte in fields |payload|:
                    payload.push(byte)



        def ir_extern_decl_node(bodies: mutable darray[u8]&, nodes: mutable u32&, refusal: mutable darray[u8]&, declaration: Ast::Decl, extern_params: darray[Ast::ExternParam]&, annotations: darray[Ast::EnumAnnotation]&, annotation_args: darray[sview]&, source: sview, filename: sview) -> u32:
            can Memory.Allocate, Abort.Panic:
                match declaration:
                    Ast::Decl.Extern(extern_name, param_start, arity, variadic, callable, return_type_name, decorators, extern_pos):
                        if not callable:
                            ir_refuse(refusal, "non-callable extern declaration")
                            return 0
                        if not ir_extern_line_is_plain(source, extern_pos):
                            ir_refuse(refusal, "opaque extern signature shape")
                            return 0
                        if ir_extern_has_lossy_metadata(annotations, extern_pos.line):
                            ir_refuse(refusal, "extern signature metadata")
                            return 0
                        if param_start.usize() + arity.usize() > extern_params.count:
                            ir_refuse(refusal, "extern parameter side table")
                            return 0
                        params_payload: mutable darray[u8] = []
                        if arity != 0:
                            ir_uvarint_out(&params_payload, arity.u64())
                            for parameter_index in 0..<arity.usize() |bodies, nodes, refusal, params_payload|:
                                ir_extern_param_out(&params_payload, bodies, nodes, refusal, extern_params[param_start.usize() + parameter_index], extern_pos, filename)
                        decorators_payload: mutable darray[u8] = []
                        if decorators.count != 0:
                            ir_uvarint_out(&decorators_payload, decorators.count.u64())
                            for decorator in decorators |decorators_payload, annotation_args, filename, refusal|:
                                ir_annotation_out(&decorators_payload, decorator, annotation_args, filename, refusal)
                        return_type_id: mutable u32 = 0
                        if return_type_name != "":
                            return_type_id <- ir_extern_type_node(bodies, nodes, refusal, return_type_name, false, extern_pos, filename)
                        fields: mutable darray[u8] = []
                        live: mutable u32 = 0
                        ir_put_raw(&fields, &live, 1, decorators_payload)
                        ir_put_str(&fields, &live, 6, extern_name)
                        ir_put_raw(&fields, &live, 8, params_payload)
                        ir_put_pos(&fields, &live, 11, extern_pos, filename)
                        ir_put_node(&fields, &live, 15, return_type_id)
                        ir_put_bool(&fields, &live, 18, variadic)
                        return ir_emit_node(bodies, nodes, 61, fields, live)
                    _:
                        ir_refuse(refusal, "extern declaration")
                        return 0
                return 0
