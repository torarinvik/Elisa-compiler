# Exact value interpretation for the never-leak environment variables.
module NeverLeakEnvValues:
    public:
        const NL_ENV_MODE_OFF: u8 = 0
        const NL_ENV_MODE_WARN: u8 = 1
        const NL_ENV_MODE_ERROR: u8 = 2

        def mode(value: cstr) -> u8:
            return when value:
                "" | "0" -> NL_ENV_MODE_OFF
                "error" -> NL_ENV_MODE_ERROR
                _ -> NL_ENV_MODE_WARN

        def is_strict(value: cstr) -> bool:
            return when value:
                "strict" -> true
                _ -> false
