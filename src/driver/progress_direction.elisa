# Closed direction classification for the compiler's loop-progress report.
module ProgressDirection:
    public:
        const enum Direction of u8:
            NoDirection
            Increase
            Decrease

        def from_comparison_operator(operator: Lexer::TokenKind) -> Direction:
            ensure result == (
                when operator:
                    Lexer::TokenKind.Lt | Lexer::TokenKind.LtEq -> Direction.Increase
                    Lexer::TokenKind.Gt | Lexer::TokenKind.GtEq -> Direction.Decrease
                    _ -> Direction.NoDirection
            )
            return when operator:
                Lexer::TokenKind.Lt | Lexer::TokenKind.LtEq -> Direction.Increase
                Lexer::TokenKind.Gt | Lexer::TokenKind.GtEq -> Direction.Decrease
                _ -> Direction.NoDirection

        def advances(direction: Direction, operator: Lexer::TokenKind, increase_operator: Lexer::TokenKind, decrease_operator: Lexer::TokenKind) -> bool:
            ensure result == (
                when direction:
                    Direction.Increase -> operator == increase_operator
                    Direction.Decrease -> operator == decrease_operator
                    _ -> false
            )
            return when direction:
                Direction.Increase -> operator == increase_operator
                Direction.Decrease -> operator == decrease_operator
                _ -> false
