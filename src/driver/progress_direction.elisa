# Closed direction classification for the compiler's loop-progress report.
module ProgressDirection:
    public:
        const enum Direction of u8:
            NoDirection
            Increase
            Decrease

        def from_comparison_operator(operator: Lexer::TokenKind) -> Direction:
            ensure when operator:
                Lexer::TokenKind.Lt | Lexer::TokenKind.LtEq -> result == (Direction.Increase)
                Lexer::TokenKind.Gt | Lexer::TokenKind.GtEq -> result == (Direction.Decrease)
                _ -> result == (Direction.NoDirection)
            return when operator:
                Lexer::TokenKind.Lt | Lexer::TokenKind.LtEq -> Direction.Increase
                Lexer::TokenKind.Gt | Lexer::TokenKind.GtEq -> Direction.Decrease
                _ -> Direction.NoDirection

        def advances(direction: Direction, operator: Lexer::TokenKind, increase_operator: Lexer::TokenKind, decrease_operator: Lexer::TokenKind) -> bool:
            ensure when direction:
                Direction.Increase -> result == (operator == increase_operator)
                Direction.Decrease -> result == (operator == decrease_operator)
                _ -> result == (false)
            return when direction:
                Direction.Increase -> operator == increase_operator
                Direction.Decrease -> operator == decrease_operator
                _ -> false

        # Stage0 only treats a positive literal step with the directionally matching
        # operator as progress evidence. Zero, negative, and unknown steps stay
        # conservative even when another spelling could express the same arithmetic.
        def advances_by_step(direction: Direction, operator: Lexer::TokenKind, step_direction: Direction, increase_operator: Lexer::TokenKind, decrease_operator: Lexer::TokenKind) -> bool:
            ensure result == (
                (direction == Direction.Increase and operator == increase_operator and step_direction == Direction.Increase) or
                (direction == Direction.Decrease and operator == decrease_operator and step_direction == Direction.Increase)
            )
            return false if step_direction != Direction.Increase
            return advances(direction, operator, increase_operator, decrease_operator)
