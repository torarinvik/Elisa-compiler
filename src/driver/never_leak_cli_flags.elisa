# Exact accepted spelling set for the never-leak warning and error CLI flags.
module NeverLeakCliFlags:
    public:
        const enum Action of u8:
            Unrecognized
            Warn
            WarnGentle
            WarnStrict
            Error
            ErrorGentle
            ErrorStrict

        def classify(flag: cstr) -> Action:
            return when flag:
                "-Wnever-leak" | "never-leak" -> Action.Warn
                "-Wnever-leak=gentle" | "never-leak=gentle" -> Action.WarnGentle
                "-Wnever-leak=strict" | "never-leak=strict" -> Action.WarnStrict
                "-Werror=never-leak" | "error=never-leak" -> Action.Error
                "-Werror=never-leak=gentle" | "error=never-leak=gentle" -> Action.ErrorGentle
                "-Werror=never-leak=strict" | "error=never-leak=strict" -> Action.ErrorStrict
                _ -> Action.Unrecognized
