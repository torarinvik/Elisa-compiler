include "./elisac_source_identity.elisa"

# Driver — native `include` EXPANSION. The unit the driver compiles is one flat buffer, so this
# walks the include graph, splices each file exactly once, and carries stage0's `#line <n> <abs
# path>` directives plus a `FLAT:ORIG:PATH` line map — which is what lets every later stage name
# the original file and line.

const ELISAC_LINE_FEED_BYTE: u8 = 10


# Length of a NUL-terminated C string. Bounded so a missing terminator cannot spin.
def cstr_length(text: cstr) -> i64 can[Abort.Panic]:
    length: mutable i64 = 0
    for _step in 0..<1048576 |length, text|:
        break if text[length.usize()] == 0
        length <- length + 1
    return length




# Whole file by PATH. Returns an empty buffer when the path cannot be opened; the caller
# reports that as the usual "cannot read source" failure.
def read_file(path: cstr) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    contents: mutable darray[u8] = []
    descriptor: i64 = open(path, 0, 0)
    return contents if descriptor < 0
    # Read straight into the tail of `contents` (it was copied over from a chunk buffer one
    # byte at a time: ~30 instructions per source byte of the self-host unit).
    while true |contents, descriptor|:
        filled: usize = contents.count
        # reserve + count, not resize: resize writes every new element first.
        contents.reserve(filled + 65536.usize())
        contents.count <- filled + 65536.usize()
        amount: i64 = read(descriptor, &contents[filled], 65536)
        contents.count <- filled + (amount.usize() if amount > 0 else 0.usize())
        break if amount <= 0
    _ = close(descriptor)
    return contents




# Whether the path can be opened for reading. `read_file` intentionally returns an empty
# buffer for both an empty file and an open failure, so callers that must distinguish those
# cases probe the descriptor separately rather than treating an empty source as missing.
def source_readable(path: cstr) -> bool can[Abort.Panic]:
    descriptor: i64 = open(path, 0, 0)
    return false if descriptor < 0
    _ = close(descriptor)
    return true




# Append a C string's bytes (without its terminator) to a buffer.
def push_cstr(buffer: mutable darray[u8]&, text: cstr) -> void can[Abort.Panic, Memory.Allocate]:
    length: i64 = cstr_length(text)
    for index in 0..<length |buffer, text|:
        buffer.push(text[index.usize()].u8())




# ---- native `include` expansion --------------------------------------------------------
#
# stage0 does this itself (readSourceWithIncludes); stage1 relied on the host wrapper to
# flatten first, which is why feeding an `include` straight to the binary reported
# "undefined identifier". A compiler that cannot resolve its own includes is not a drop-in
# replacement, however good its codegen is.
#
# Recursive, deduplicated (an already-included file is skipped, matching stage0's
# include-once behaviour), and resolved RELATIVE TO THE INCLUDING FILE's directory.

# The directory part of a path, with its trailing slash; empty when the path has none.
def path_directory(path: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    directory: mutable darray[u8] = []
    last_slash: mutable i64 = -1
    for index in 0..<path.count |last_slash, path|:
        last_slash <- index.i64() if path[index] == 47
    return directory if last_slash < 0
    if path.items is source_ptr:
        if Lexer::make_source_view(source_ptr, path.count, 0, (last_slash + 1).usize()) is directory_view:
            directory.extend(directory_view)
    return directory




# Resolve `relative` against `base_directory` unless it is already absolute.
def resolve_include_path(base_directory: darray[u8]&, relative: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    resolved: mutable darray[u8] = []
    if relative.count > 0 and relative[0.usize()] == 47:
        resolved.extend(relative)
        return resolved
    resolved.extend(base_directory)
    resolved.extend(relative)
    return normalize_path(resolved)




# Collapse `./` segments so the SAME file resolved along different paths compares equal.
# Without this a diamond include (`top` -> `mid` -> `sub/lib`, and `top` -> `sub/lib`)
# produced "dir/././sub/lib" and "dir/./sub/lib", the dedupe missed, and the second copy
# was spliced in — "duplicate declaration". `..` is deliberately NOT resolved: that needs
# real path canonicalisation, and leaving it alone only costs a missed dedupe, never a
# wrong file.
def normalize_path(path: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    normalized: mutable darray[u8] = []
    index: mutable usize = 0.usize()
    while index < path.count |index, normalized, path|:
        at_segment_start: bool = normalized.count == 0.usize() or normalized[normalized.count - 1.usize()] == 47
        if at_segment_start and path[index] == 46 and index + 1.usize() < path.count and path[index + 1.usize()] == 47:
            index <- index + 2.usize()
            continue
        normalized.push(path[index])
        index <- index + 1.usize()
    return normalized




def same_path(left: darray[u8]&, right: darray[u8]&) -> bool can[Abort.Panic]:
    return false if left.count != right.count
    for index in 0..<left.count |left, right|:
        return false if left[index] != right[index]
    return true



def path_contains_nul(path: darray[u8]&) -> bool can[Abort.Panic]:
    for index in 0..<path.count |path|:
        return true if path[index] == 0
    return false




# The quoted path of an `include "..."` line (optionally `#include`, optionally indented),
# or an empty buffer when the line is not an include directive.
# stage0's BRACE include directive (parseIncludeDirective): `{$I 'p'}`, `{$I "p"}`,
# `{$I p}` and the `{$include ...}` long form, keyword case-insensitive. A bare argument
# is a path only when it holds no whitespace, which is stage0's rule too. Returns the
# path, or empty when `source[start..stop)` is not a brace directive.
def include_brace_directive_path(source: darray[u8]&, start: usize, stop: usize) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    empty: mutable darray[u8] = []
    begin: mutable usize = start
    while begin < stop |begin, source|:
        break if source[begin] != 32 and source[begin] != 9
        begin <- begin + 1.usize()
    finish: mutable usize = stop
    while finish > begin |finish, source|:
        break if source[finish - 1.usize()] != 32 and source[finish - 1.usize()] != 9 and source[finish - 1.usize()] != 13
        finish <- finish - 1.usize()
    return empty if:
        finish < begin + 4.usize()
        source[begin] != 123 or source[begin + 1.usize()] != 36 or source[finish - 1.usize()] != 125
    body_start: mutable usize = begin + 2.usize()
    body_stop: usize = finish - 1.usize()
    while body_start < body_stop |body_start, source|:
        break if source[body_start] != 32 and source[body_start] != 9
        body_start <- body_start + 1.usize()
    keyword_stop: mutable usize = body_start
    while keyword_stop < body_stop |keyword_stop, source|:
        break if source[keyword_stop] == 32 or source[keyword_stop] == 9
        keyword_stop <- keyword_stop + 1.usize()
    keyword_length: usize = keyword_stop - body_start
    return empty if keyword_length != 1.usize() and keyword_length != 7.usize()
    lowered: mutable darray[u8] = []
    for keyword_index in 0..<keyword_length |lowered, source, body_start|:
        keyword_byte: u8 = source[body_start + keyword_index]
        lowered.push(keyword_byte + 32 if keyword_byte >= 65 and keyword_byte <= 90 else keyword_byte)
    is_short: bool = keyword_length == 1.usize() and lowered[0] == 105
    is_long: bool = keyword_length == 7.usize() and lowered[0] == 105 and lowered[1] == 110 and lowered[2] == 99 and lowered[3] == 108 and lowered[4] == 117 and lowered[5] == 100 and lowered[6] == 101
    return empty if not is_short and not is_long
    argument_start: mutable usize = keyword_stop
    while argument_start < body_stop |argument_start, source|:
        break if source[argument_start] != 32 and source[argument_start] != 9
        argument_start <- argument_start + 1.usize()
    argument_stop: mutable usize = body_stop
    while argument_stop > argument_start |argument_stop, source|:
        break if source[argument_stop - 1.usize()] != 32 and source[argument_stop - 1.usize()] != 9
        argument_stop <- argument_stop - 1.usize()
    return empty if argument_stop <= argument_start
    opening: u8 = source[argument_start]
    closing: u8 = source[argument_stop - 1.usize()]
    quoted: bool = argument_stop - argument_start >= 2.usize() and ((opening == 39 and closing == 39) or (opening == 34 and closing == 34))
    inner_start: usize = argument_start + 1.usize() if quoted else argument_start
    inner_stop: usize = argument_stop - 1.usize() if quoted else argument_stop
    return empty if inner_stop <= inner_start
    # A BARE argument holding whitespace is not a path -- stage0 refuses it rather than
    # guessing where the path ends.
    bare_has_space: mutable bool = false
    for space_probe in inner_start..<inner_stop |bare_has_space, source|:
        bare_has_space <- true if source[space_probe] == 32 or source[space_probe] == 9
    return empty if not quoted and bare_has_space
    captured: mutable darray[u8] = []
    for path_offset in inner_start..<inner_stop |captured, source|:
        captured.push(source[path_offset])
    return captured




# Span form of include_directive_path: scans `source[start..stop)` in place so the caller
# needs no per-line buffer. That buffer was a hard CEILING on line length — see the note in
# expand_includes.
def include_directive_path_span(source: darray[u8]&, start: usize, stop: usize) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    braced_span: darray[u8] = include_brace_directive_path(source, start, stop)
    return braced_span if braced_span.count > 0.usize()
    empty: mutable darray[u8] = []
    cursor: mutable usize = start
    while cursor < stop |cursor, source|:
        break if source[cursor] != 32 and source[cursor] != 9
        cursor <- cursor + 1.usize()
    cursor <- cursor + 1.usize() if cursor < stop and source[cursor] == 35
    while cursor < stop |cursor, source|:
        break if source[cursor] != 32 and source[cursor] != 9
        cursor <- cursor + 1.usize()
    keyword: sview = "include"
    return empty if cursor + 7.usize() > stop
    for keyword_index in 0..<7 |empty, source, cursor, keyword|:
        return empty if source[cursor + keyword_index.usize()] != keyword[keyword_index]
    cursor <- cursor + 7.usize()
    return empty if cursor >= stop or (source[cursor] != 32 and source[cursor] != 9)
    while cursor < stop |cursor, source|:
        break if source[cursor] != 32 and source[cursor] != 9
        cursor <- cursor + 1.usize()
    return empty if cursor >= stop or source[cursor] != 34
    cursor <- cursor + 1.usize()
    captured: mutable darray[u8] = []
    while cursor < stop |cursor, source, captured|:
        break if source[cursor] == 34
        captured.push(source[cursor])
        cursor <- cursor + 1.usize()
    return empty if cursor >= stop or source[cursor] != 34
    return captured




def include_directive_path(line: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    braced_line: darray[u8] = include_brace_directive_path(line, 0.usize(), line.count)
    return braced_line if braced_line.count > 0.usize()
    empty: mutable darray[u8] = []
    cursor: mutable usize = 0.usize()
    while cursor < line.count |cursor, line|:
        break if line[cursor] != 32 and line[cursor] != 9
        cursor <- cursor + 1.usize()
    cursor <- cursor + 1.usize() if cursor < line.count and line[cursor] == 35
    while cursor < line.count |cursor, line|:
        break if line[cursor] != 32 and line[cursor] != 9
        cursor <- cursor + 1.usize()
    keyword: sview = "include"
    return empty if cursor + 7.usize() > line.count
    for keyword_index in 0..<7 |empty, line, cursor, keyword|:
        return empty if line[cursor + keyword_index.usize()] != keyword[keyword_index]
    cursor <- cursor + 7.usize()
    return empty if cursor >= line.count or (line[cursor] != 32 and line[cursor] != 9)
    while cursor < line.count |cursor, line|:
        break if line[cursor] != 32 and line[cursor] != 9
        cursor <- cursor + 1.usize()
    return empty if cursor >= line.count or line[cursor] != 34
    cursor <- cursor + 1.usize()
    captured: mutable darray[u8] = []
    while cursor < line.count |cursor, line, captured|:
        break if line[cursor] == 34
        captured.push(line[cursor])
        cursor <- cursor + 1.usize()
    return empty if cursor >= line.count or line[cursor] != 34
    return captured




# Whether `path` already appears in the NUL-separated `seen` buffer.
def path_already_seen(seen: darray[u8]&, path: darray[u8]&) -> bool can[Abort.Panic]:
    start: mutable usize = 0.usize()
    index: mutable usize = 0.usize()
    while index < seen.count |index, start, seen, path|:
        if seen[index] == 0:
            if index - start == path.count:
                matched: mutable bool = true
                for offset in 0..<path.count |matched, seen, path, start|:
                    matched <- false if seen[start + offset] != path[offset]
                return true if matched
            start <- index + 1.usize()
        index <- index + 1.usize()
    return false




# Append `path`'s contents to `out`, splicing any includes it names. `seen` accumulates the
# already-included paths so a diamond include contributes once; `active` tracks only the
# current recursion chain so a genuine cycle is diagnosed instead of silently skipped.
def setenv_bytes(name: sview, value: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    name_storage: mutable darray[u8] = []
    for name_index in 0..<name.len |name_storage|:
        name_storage.push(name[name_index])
    name_storage.push(0)
    value_storage: mutable darray[u8] = []
    for value_index in 0..<value.count |value_storage, value|:
        value_storage.push(value[value_index])
    value_storage.push(0)
    # The casts are their own statements: an inline `expr.cast[T] can Effect` inside an
    # argument list reads as the end of the call.
    name_c: cstr = (&name_storage[0.usize()]).cast[cstr] can Unsafe.PointerCast
    value_c: cstr = (&value_storage[0.usize()]).cast[cstr] can Unsafe.PointerCast
    _ = setenv(name_c, value_c, 1)




# Persist the driver's original-file attribution map when a caller asks for it. The normal
# compiler environment remains unchanged; this is an explicit side channel for tools such as
# the profiler that need to attribute flattened trace lines after compilation has finished.
def publish_line_map_artifact(line_map: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    output_path: mutable darray[u8] = []
    return if:
        not env_value("ELISA_STAGE1_LINE_MAP_OUTPUT", &output_path)
        line_map.count == 0.usize()
    if not write_file(output_path, bytes_view_range_ref(line_map, 0, line_map.count)):
        message: mutable darray[u8] = []
        message.extend("error: could not write ELISA_STAGE1_LINE_MAP_OUTPUT\n")
        write_stderr(message)


# One `FLAT:ORIG:PATH` line-map entry. FLAT is the 1-based line in the FLATTENED unit, ORIG
# the 1-based line in PATH that it corresponds to. ORIG is needed because a file RESUMES
# after each include it makes, so its contents are not one contiguous run and
# `flat - start + 1` alone would be wrong for everything after the first include.
def push_line_map_entry(line_map: mutable darray[u8]&, flat_line: u32, source_line: u32, path: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
    append_decimal(line_map, flat_line)
    line_map.push(58)
    append_decimal(line_map, source_line)
    line_map.push(58)
    for entry_index in 0..<path.count |line_map, path|:
        line_map.push(path[entry_index])
    line_map.push(10)


# A pathless identity entry lets generated stdin source retain original line numbers while
# diagnostic rendering continues to use ELISA_STAGE1_SRC when one exists.
def driver_identity_line_map() -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    can Memory.Allocate:
        identity: mutable darray[u8] = []
        identity.extend("1:1:\n")
        return identity


struct DriverLineMapEntry:
    flat_line: u32
    source_line: u32
    path_start: usize
    path_stop: usize


# Parse the driver's sparse `FLAT:ORIG:PATH` representation once so generated-source
# composition can split runs at include boundaries without repeatedly rescanning it.
def driver_parse_line_map(map_bytes: darray[u8]&) -> darray[DriverLineMapEntry] can[Abort.Panic, Memory.Allocate]:
    can Memory.Allocate, Abort.Panic:
        entries: mutable darray[DriverLineMapEntry] = []
        cursor: mutable usize = 0
        while cursor < map_bytes.count |cursor, entries, map_bytes|:
            entry_stop: mutable usize = cursor
            while entry_stop < map_bytes.count |entry_stop, map_bytes|:
                break if map_bytes[entry_stop] == 10
                entry_stop <- entry_stop + 1
            return [] if entry_stop == cursor
            scan: mutable usize = cursor
            flat_line: mutable u32 = 0
            while scan < entry_stop and map_bytes[scan] != 58 |scan, flat_line, map_bytes|:
                digit: u8 = map_bytes[scan]
                return [] if digit < 48 or digit > 57
                decimal_digit: u32 = (digit - 48).u32()
                return [] if flat_line > 429496729 or (flat_line == 429496729 and decimal_digit > 5)
                flat_line <- flat_line * 10 + decimal_digit
                scan <- scan + 1
            return [] if scan == cursor or scan >= entry_stop or flat_line == 0
            scan <- scan + 1
            source_line_start: usize = scan
            source_line: mutable u32 = 0
            while scan < entry_stop and map_bytes[scan] != 58 |scan, source_line, map_bytes|:
                digit: u8 = map_bytes[scan]
                return [] if digit < 48 or digit > 57
                decimal_digit: u32 = (digit - 48).u32()
                return [] if source_line > 429496729 or (source_line == 429496729 and decimal_digit > 5)
                source_line <- source_line * 10 + decimal_digit
                scan <- scan + 1
            return [] if scan == source_line_start or scan >= entry_stop or source_line == 0
            path_start: usize = scan + 1
            return [] if path_start > entry_stop
            if entries.count > 0.usize():
                previous: DriverLineMapEntry = entries[entries.count - 1.usize()]
                return [] if flat_line <= previous.flat_line
            entries.push(DriverLineMapEntry{flat_line: flat_line, source_line: source_line, path_start: path_start, path_stop: entry_stop})
            cursor <- entry_stop + 1
        return entries


def driver_append_composed_line_map_entry(out: mutable darray[u8]&, source_map: darray[u8]&, output_line: u32, source_line: u32, path_start: usize, path_stop: usize) -> void can[Abort.Panic, Memory.Allocate]:
    can Memory.Allocate, Abort.Panic:
        append_decimal(out, output_line)
        out.push(58)
        append_decimal(out, source_line)
        out.push(58)
        for path_index in path_start..<path_stop |out, source_map|:
            out.push(source_map[path_index])
        out.push(10)


# Compose sparse generated-output→expanded-input line runs with the include map. The
# result remains sparse: copied text and repeated templates add boundaries only where
# either preprocessing or include expansion changed the source run.
def driver_compose_generated_line_map(source_map: darray[u8]&, generated_runs: darray[u32]&, generated_line_count: u32) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    can Memory.Allocate, Abort.Panic:
        output_map: mutable darray[u8] = []
        return output_map if source_map.count == 0 or generated_runs.count < 2 or generated_line_count == 0
        return output_map if generated_runs.count % 2 != 0
        source_entries: darray[DriverLineMapEntry] = driver_parse_line_map(source_map)
        return output_map if source_entries.count == 0
        run_offset: mutable usize = 0
        while run_offset < generated_runs.count |run_offset, output_map, generated_runs, source_entries, generated_line_count, source_map|:
            output_start: u32 = generated_runs[run_offset]
            source_start: u32 = generated_runs[run_offset + 1.usize()]
            return [] if output_start == 0 or source_start == 0 or output_start > generated_line_count
            output_stop: mutable u32 = generated_line_count
            if run_offset + 2.usize() < generated_runs.count:
                next_output_start: u32 = generated_runs[run_offset + 2.usize()]
                return [] if next_output_start <= output_start or next_output_start > generated_line_count
                output_stop <- next_output_start - 1
            source_stop_u64: u64 = source_start.u64() + (output_stop - output_start).u64()
            return [] if source_stop_u64 > 4294967295
            source_stop: u32 = source_stop_u64.u32()

            # The parser rejects unsorted FLAT entries, so find the last boundary at or
            # before this source line in logarithmic time. Generated templates can create
            # many output runs that each map back to the same include span.
            low: mutable usize = 0
            high: mutable usize = source_entries.count
            while low < high |low, high, source_entries, source_start|:
                middle: usize = low + (high - low) / 2
                entry: DriverLineMapEntry = source_entries[middle]
                if entry.flat_line <= source_start:
                    low <- middle + 1.usize()
                else:
                    high <- middle
            best_entry: mutable usize = 0
            found_entry: mutable bool = false
            if low > 0.usize():
                best_entry <- low - 1.usize()
                found_entry <- true
            if found_entry:
                entry: DriverLineMapEntry = source_entries[best_entry]
                mapped_source_line_u64: u64 = entry.source_line.u64() + (source_start - entry.flat_line).u64()
                return [] if mapped_source_line_u64 > 4294967295
                driver_append_composed_line_map_entry(output_map, source_map, output_start, mapped_source_line_u64.u32(), entry.path_start, entry.path_stop)

            boundary_start: mutable usize = 0
            if found_entry:
                boundary_start <- best_entry + 1.usize()
            for entry_index in boundary_start..<source_entries.count |entry_index, output_map, source_entries, source_map, output_start, source_start, source_stop|:
                entry: DriverLineMapEntry = source_entries[entry_index]
                if entry.flat_line > source_start:
                    break if entry.flat_line > source_stop
                    boundary_output: u32 = output_start + (entry.flat_line - source_start)
                    driver_append_composed_line_map_entry(output_map, source_map, boundary_output, entry.source_line, entry.path_start, entry.path_stop)
            run_offset <- run_offset + 2.usize()
        return output_map




# The expansion carries stage0's own `#line <n> <abs path>\n` directive wherever a file starts
# or resumes, so stage1's buffer IS stage0's buffer and every byte offset (`__auto_<n>`,
# `__MachineMode_<hash>_<n>`, the test-runner echo) matches with no correction. Token lines
# stay BUFFER lines (Lexer.renumber_on_directive is cleared for a driver-expanded unit) and
# the line map below attributes printed locations. ELISA_STAGE1_LINE_DIRECTIVES=0 opts out.
def line_directives_enabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag: mutable darray[u8] = []
    return true if not env_value("ELISA_STAGE1_LINE_DIRECTIVES", &flag)
    return not (flag.count == 1.usize() and flag[0] == 48)




def push_line_directive(out: mutable darray[u8]&, line: u32, path: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
    for prefix_index in 0..<("#line ").len |out|:
        out.push(("#line ")[prefix_index])
    append_decimal(out, line)
    out.push(32)
    for path_index in 0..<path.count |out, path|:
        out.push(path[path_index])
    out.push(10)




# `line_map` accumulates `FLAT:ORIG:PATH` entries (see push_line_map_entry) — one where a
# file starts, and one each time it RESUMES after an include. A diagnostic then names the
# original file and line by finding the last entry at or below the reported line. Per
# file-run, not per line, so the map over the compiler's 509-file closure is tens of KB.
def expand_includes(path: darray[u8]&, out: mutable darray[u8]&, seen: mutable darray[u8]&, active: mutable darray[u8]&, depth: i64, line_map: mutable darray[u8]&, emitted_lines: mutable u32&, cycle_detected: mutable bool&, read_failed: mutable bool&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    identity: mutable SourceIdentity::Capture = SourceIdentity::empty(false) can Memory.Allocate
    return expand_includes_with_source_identity(path, out, seen, active, depth, line_map, emitted_lines, cycle_detected, read_failed, &identity) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast

def expand_includes_with_source_identity(path: darray[u8]&, out: mutable darray[u8]&, seen: mutable darray[u8]&, active: mutable darray[u8]&, depth: i64, line_map: mutable darray[u8]&, emitted_lines: mutable u32&, cycle_detected: mutable bool&, read_failed: mutable bool&, identity: mutable SourceIdentity::Capture&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    root_source: darray[u8] = []
    return expand_includes_with_source_identity_and_root_source(path, out, seen, active, depth, line_map, emitted_lines, cycle_detected, read_failed, identity, root_source) can Abort.Panic, Memory.Allocate, Unsafe.PointerCast

def expand_includes_with_source_identity_and_root_source(path: darray[u8]&, out: mutable darray[u8]&, seen: mutable darray[u8]&, active: mutable darray[u8]&, depth: i64, line_map: mutable darray[u8]&, emitted_lines: mutable u32&, cycle_detected: mutable bool&, read_failed: mutable bool&, identity: mutable SourceIdentity::Capture&, root_source: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    SourceIdentity::begin(identity) can Abort.Panic
    result: bool = expand_includes_capture(path, out, seen, active, depth, line_map, emitted_lines, cycle_detected, read_failed, identity, SourceIdentity::NONE, root_source) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast
    SourceIdentity::finish(result, identity) can Abort.Panic
    return result

def expand_includes_capture(path: darray[u8]&, out: mutable darray[u8]&, seen: mutable darray[u8]&, active: mutable darray[u8]&, depth: i64, line_map: mutable darray[u8]&, emitted_lines: mutable u32&, cycle_detected: mutable bool&, read_failed: mutable bool&, identity: mutable SourceIdentity::Capture&, parent_visit: usize, root_source: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    if depth > 64:
        read_failed <- true
        return false
    # absolute_path and the POSIX open call consume C strings. Refuse embedded NUL bytes
    # before either can truncate the requested name and silently open a different file.
    if path_contains_nul(path):
        read_failed <- true
        return false
    # ABSOLUTE, cleaned paths — stage0 prints what filepath.Abs produced, and more
    # importantly `path_already_seen` compares raw bytes: the same file reached as
    # `./x.elisa` from one directory and `../lexer/x.elisa` from another did not dedup, so
    # the include closure over the compiler's own tree reported 575 files where stage0
    # reports 509. Canonicalising at the door fixes the listing and the dedup together.
    absolute: darray[u8] = ProjectSystem::absolute_path(path)
    identity_visit: usize = SourceIdentity::record(absolute, parent_visit, identity) can Memory.Allocate, Abort.Panic
    if path_already_seen(active, absolute):
        cycle_detected <- true
        return false
    return true if path_already_seen(seen, absolute)
    active.extend(absolute)
    active.push(0)
    # Record the path by APPENDING its bytes plus a NUL. A `darray[darray[u8]]` would need
    # each entry allocated in a region outliving the table, which the region checker
    # correctly rejects for a locally-built buffer; one flat buffer sidesteps the
    # ownership question entirely.
    seen.extend(absolute)
    seen.push(0)
    path_c: mutable darray[u8] = []
    path_c.extend(absolute)
    path_c.push(0)
    path_cstr: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
    contents: mutable darray[u8] = []
    if depth == 0 and root_source.count > 0:
        contents.extend(root_source)
    else:
        if not source_readable(path_cstr):
            read_failed <- true
            active.count <- active.count - absolute.count - 1.usize()
            return false
        contents <- read_file(path_cstr)
    if contents.count == 0:
        active.count <- active.count - absolute.count - 1.usize()
        return false
    SourceIdentity::mark_expanded(identity_visit, identity) can Abort.Panic
    if depth == 0 and emit_mode_is("edir"):
        if contents.count > 0.usize() and contents[contents.count - 1.usize()] == ELISAC_LINE_FEED_BYTE:
            _ = setenv("ELISA_STAGE1_EDIR_SOURCE_TERMINAL_NEWLINE", "1", 1)
        else:
            _ = setenv("ELISA_STAGE1_EDIR_SOURCE_TERMINAL_NEWLINE", "0", 1)
    if line_directives_enabled():
        push_line_directive(out, 1, absolute)
        emitted_lines <- emitted_lines + 1
    # The map entry names the file's FIRST REAL line — after the directive line when one
    # was emitted — so a fault at file line N maps back to N, not N + 1.
    push_line_map_entry(line_map, emitted_lines + 1, 1, absolute)
    directory: darray[u8] = path_directory(absolute)
    # Lines are SPANS into `contents`, not a copied-out buffer.
    #
    # The buffer version accumulated each line byte by byte into a `line` darray that grew
    # while `out` and `seen` were already live below it. Under the driver's non-relocating
    # arena only the TAIL allocation can grow, so the first line longer than ~519 bytes
    # panicked in arena_realloc ("cannot grow in place: not the tail allocation") — which
    # made the CLI unable to read ANY file containing a long line, its own sources included.
    # Nothing caught it because the wrapper flattens includes before the driver runs, so the
    # only route through this code was one no gate exercised.
    # The sentinel iteration at `index == contents.count` flushes a FINAL UNTERMINATED line.
    # It used to run unconditionally, so a file ending in a newline — almost every file — had
    # its already-flushed last line followed by an extra empty one. One spurious blank line
    # per included file: the compiler's own closure came out 22 lines longer than the
    # wrapper's flattening of the same sources, which showed up as line-numbered internal
    # symbols disagreeing between the two.
    trailing_partial: bool = contents.count > 0.usize() and contents[contents.count - 1.usize()] != 10
    expanded: mutable bool = true
    index: mutable usize = 0.usize()
    line_start: mutable usize = 0.usize()
    source_line: mutable u32 = 0
    while index < contents.count + (1.usize() if trailing_partial else 0.usize()) |index, line_start, source_line, emitted_lines, line_map, absolute, contents, out, seen, directory, depth, trailing_partial, identity|:
        at_end: bool = index == contents.count
        byte: u8 = 10 if at_end else contents[index]
        if byte == 10:
            included: darray[u8] = include_directive_path_span(contents, line_start, index)
            if included.count > 0:
                resolved: darray[u8] = resolve_include_path(directory, included)
                resume_flat: usize = out.count
                included_ok: bool = (expand_includes_capture(resolved, out, seen, active, depth + 1, line_map, emitted_lines, cycle_detected, read_failed, identity, identity_visit, root_source) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast) if expanded else true
                expanded <- false if not included_ok
                if included_ok:
                    # This file RESUMES after the include directive: the next flattened line is
                    # this file's line `source_line + 2` (source_line is 0-based and still points
                    # at the directive).
                    if line_directives_enabled():
                        # stage0's newline guard: an include that contributed nothing still ends
                        # its parent's line before the resume directive.
                        if out.count == resume_flat:
                            out.push(10)
                            # That guard byte is an EMPTY BUFFER LINE where the include stood;
                            # the line map must count it or every later line maps one too low.
                            emitted_lines <- emitted_lines + 1
                        push_line_directive(out, source_line + 2, absolute)
                        emitted_lines <- emitted_lines + 1
                    # As at the root: the resume entry names the parent's next REAL line.
                    push_line_map_entry(line_map, emitted_lines + 1, source_line + 2, absolute)
            else:
                # The line's bytes as one block copy (was a push per byte).
                line_length: usize = index - line_start
                if line_length > 0:
                    out_start: usize = out.count
                    out.reserve(out_start + line_length)
                    out.count <- out_start + line_length
                    trusted [Unsafe.PointerCast, Unsafe.RawExtern]:
                        _ = memcpy((&out[out_start]).cast[mutable void&], (&contents[line_start]).cast[void&], line_length)
                out.push(10)
                emitted_lines <- emitted_lines + 1
            line_start <- index + 1.usize()
            source_line <- source_line + 1
        index <- index + 1.usize()
    active.count <- active.count - absolute.count - 1.usize()
    return expanded
