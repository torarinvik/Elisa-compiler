# Driver — native `include` EXPANSION. The unit the driver compiles is one flat buffer, so this
# walks the include graph, splices each file exactly once, and carries stage0's `#line <n> <abs
# path>` directives plus a `FLAT:ORIG:PATH` line map — which is what lets every later stage name
# the original file and line.


# Length of a NUL-terminated C string. Bounded so a missing terminator cannot spin.
def cstr_length(text: cstr) -> i64 can[Abort.Panic]:
    length: mutable i64 = 0
    for _step in 0..<1048576 |length, text|:
        break if text[length.usize()] == 0
        length <- length + 1
    return length




# Whole file by PATH. Returns an empty buffer when the path cannot be opened; the caller
# reports that as the usual "cannot read source" failure.
def read_file(path: cstr) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    contents: mutable darray[u8] = []
    descriptor: i64 = open(path, 0, 0)
    contents return if descriptor < 0
    chunk: mutable darray[u8] = []
    chunk.resize(8192)
    while true |contents, chunk, descriptor|:
        amount: i64 = read(descriptor, &chunk[0], 8192)
        break if amount <= 0
        for index in 0..<amount.usize() |contents, chunk|:
            contents.push(chunk[index])
    _ = close(descriptor)
    return contents




# Whether the path can be opened for reading. `read_file` intentionally returns an empty
# buffer for both an empty file and an open failure, so callers that must distinguish those
# cases probe the descriptor separately rather than treating an empty source as missing.
def source_readable(path: cstr) -> bool can[Abort.Panic]:
    descriptor: i64 = open(path, 0, 0)
    false return if descriptor < 0
    _ = close(descriptor)
    return true




# Append a C string's bytes (without its terminator) to a buffer.
def push_cstr(buffer: mutable darray[u8]&, text: cstr) -> void can[Abort.Panic, Memory.Allocate]:
    length: i64 = cstr_length(text)
    for index in 0..<length |buffer, text|:
        buffer.push(text[index.usize()].u8())




# ---- native `include` expansion --------------------------------------------------------
#
# stage0 does this itself (readSourceWithIncludes); stage1 relied on the host wrapper to
# flatten first, which is why feeding an `include` straight to the binary reported
# "undefined identifier". A compiler that cannot resolve its own includes is not a drop-in
# replacement, however good its codegen is.
#
# Recursive, deduplicated (an already-included file is skipped, matching stage0's
# include-once behaviour), and resolved RELATIVE TO THE INCLUDING FILE's directory.

# The directory part of a path, with its trailing slash; empty when the path has none.
def path_directory(path: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    directory: mutable darray[u8] = []
    last_slash: mutable i64 = -1
    for index in 0..<path.count |last_slash, path|:
        last_slash <- index.i64() if path[index] == 47
    directory return if last_slash < 0
    for index in 0..<(last_slash + 1).usize() |directory, path|:
        directory.push(path[index])
    return directory




# Resolve `relative` against `base_directory` unless it is already absolute.
def resolve_include_path(base_directory: darray[u8]&, relative: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    resolved: mutable darray[u8] = []
    if relative.count > 0 and relative[0.usize()] == 47:
        for index in 0..<relative.count |resolved, relative|:
            resolved.push(relative[index])
        return resolved
    for index in 0..<base_directory.count |resolved, base_directory|:
        resolved.push(base_directory[index])
    for index in 0..<relative.count |resolved, relative|:
        resolved.push(relative[index])
    return normalize_path(resolved)




# Collapse `./` segments so the SAME file resolved along different paths compares equal.
# Without this a diamond include (`top` -> `mid` -> `sub/lib`, and `top` -> `sub/lib`)
# produced "dir/././sub/lib" and "dir/./sub/lib", the dedupe missed, and the second copy
# was spliced in — "duplicate declaration". `..` is deliberately NOT resolved: that needs
# real path canonicalisation, and leaving it alone only costs a missed dedupe, never a
# wrong file.
def normalize_path(path: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    normalized: mutable darray[u8] = []
    index: mutable usize = 0.usize()
    while index < path.count |index, normalized, path|:
        at_segment_start: bool = normalized.count == 0.usize() or normalized[normalized.count - 1.usize()] == 47
        if at_segment_start and path[index] == 46 and index + 1.usize() < path.count and path[index + 1.usize()] == 47:
            index <- index + 2.usize()
            continue
        normalized.push(path[index])
        index <- index + 1.usize()
    return normalized




def same_path(left: darray[u8]&, right: darray[u8]&) -> bool can[Abort.Panic]:
    false return if left.count != right.count
    for index in 0..<left.count |left, right|:
        false return if left[index] != right[index]
    return true




# The quoted path of an `include "..."` line (optionally `#include`, optionally indented),
# or an empty buffer when the line is not an include directive.
# Span form of include_directive_path: scans `source[start..stop)` in place so the caller
# needs no per-line buffer. That buffer was a hard CEILING on line length — see the note in
# expand_includes.
def include_directive_path_span(source: darray[u8]&, start: usize, stop: usize) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    empty: mutable darray[u8] = []
    cursor: mutable usize = start
    while cursor < stop |cursor, source|:
        break if source[cursor] != 32 and source[cursor] != 9
        cursor <- cursor + 1.usize()
    cursor <- cursor + 1.usize() if cursor < stop and source[cursor] == 35
    while cursor < stop |cursor, source|:
        break if source[cursor] != 32 and source[cursor] != 9
        cursor <- cursor + 1.usize()
    keyword: sview = "include"
    empty return if cursor + 7.usize() > stop
    for keyword_index in 0..<7 |empty, source, cursor, keyword|:
        empty return if source[cursor + keyword_index.usize()] != sview_at(keyword, keyword_index)
    cursor <- cursor + 7.usize()
    empty return if cursor >= stop or (source[cursor] != 32 and source[cursor] != 9)
    while cursor < stop |cursor, source|:
        break if source[cursor] != 32 and source[cursor] != 9
        cursor <- cursor + 1.usize()
    empty return if cursor >= stop or source[cursor] != 34
    cursor <- cursor + 1.usize()
    captured: mutable darray[u8] = []
    while cursor < stop |cursor, source, captured|:
        break if source[cursor] == 34
        captured.push(source[cursor])
        cursor <- cursor + 1.usize()
    empty return if cursor >= stop or source[cursor] != 34
    return captured




def include_directive_path(line: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    empty: mutable darray[u8] = []
    cursor: mutable usize = 0.usize()
    while cursor < line.count |cursor, line|:
        break if line[cursor] != 32 and line[cursor] != 9
        cursor <- cursor + 1.usize()
    cursor <- cursor + 1.usize() if cursor < line.count and line[cursor] == 35
    while cursor < line.count |cursor, line|:
        break if line[cursor] != 32 and line[cursor] != 9
        cursor <- cursor + 1.usize()
    keyword: sview = "include"
    empty return if cursor + 7.usize() > line.count
    for keyword_index in 0..<7 |empty, line, cursor, keyword|:
        empty return if line[cursor + keyword_index.usize()] != sview_at(keyword, keyword_index)
    cursor <- cursor + 7.usize()
    empty return if cursor >= line.count or (line[cursor] != 32 and line[cursor] != 9)
    while cursor < line.count |cursor, line|:
        break if line[cursor] != 32 and line[cursor] != 9
        cursor <- cursor + 1.usize()
    empty return if cursor >= line.count or line[cursor] != 34
    cursor <- cursor + 1.usize()
    captured: mutable darray[u8] = []
    while cursor < line.count |cursor, line, captured|:
        break if line[cursor] == 34
        captured.push(line[cursor])
        cursor <- cursor + 1.usize()
    empty return if cursor >= line.count or line[cursor] != 34
    return captured




# Whether `path` already appears in the NUL-separated `seen` buffer.
def path_already_seen(seen: darray[u8]&, path: darray[u8]&) -> bool can[Abort.Panic]:
    start: mutable usize = 0.usize()
    index: mutable usize = 0.usize()
    while index < seen.count |index, start, seen, path|:
        if seen[index] == 0:
            if index - start == path.count:
                matched: mutable bool = true
                for offset in 0..<path.count |matched, seen, path, start|:
                    matched <- false if seen[start + offset] != path[offset]
                true return if matched
            start <- index + 1.usize()
        index <- index + 1.usize()
    return false




# Append `path`'s contents to `out`, splicing any includes it names. `seen` accumulates the
# already-included paths so a diamond include contributes once; `active` tracks only the
# current recursion chain so a genuine cycle is diagnosed instead of silently skipped.
def setenv_bytes(name: sview, value: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    name_storage: mutable darray[u8] = []
    for name_index in 0..<sview_len(name) |name_storage|:
        name_storage.push(sview_at(name, name_index))
    name_storage.push(0)
    value_storage: mutable darray[u8] = []
    for value_index in 0..<value.count |value_storage, value|:
        value_storage.push(value[value_index])
    value_storage.push(0)
    # The casts are their own statements: an inline `expr.cast[T] can Effect` inside an
    # argument list reads as the end of the call.
    name_c: cstr = (&name_storage[0.usize()]).cast[cstr] can Unsafe.PointerCast
    value_c: cstr = (&value_storage[0.usize()]).cast[cstr] can Unsafe.PointerCast
    _ = setenv(name_c, value_c, 1)




# Persist the driver's original-file attribution map when a caller asks for it. The normal
# compiler environment remains unchanged; this is an explicit side channel for tools such as
# the profiler that need to attribute flattened trace lines after compilation has finished.
def publish_line_map_artifact(line_map: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    output_path: mutable darray[u8] = []
    return if not env_value("ELISA_STAGE1_LINE_MAP_OUTPUT", &output_path)
    return if line_map.count == 0.usize()
    if not write_file(output_path, sview(&line_map[0], 0, line_map.count.i64())):
        message: mutable darray[u8] = []
        message.extend("error: could not write ELISA_STAGE1_LINE_MAP_OUTPUT\n")
        write_stderr(message)


# One `FLAT:ORIG:PATH` line-map entry. FLAT is the 1-based line in the FLATTENED unit, ORIG
# the 1-based line in PATH that it corresponds to. ORIG is needed because a file RESUMES
# after each include it makes, so its contents are not one contiguous run and
# `flat - start + 1` alone would be wrong for everything after the first include.
def push_line_map_entry(line_map: mutable darray[u8]&, flat_line: u32, source_line: u32, path: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
    append_decimal(line_map, flat_line)
    line_map.push(58)
    append_decimal(line_map, source_line)
    line_map.push(58)
    for entry_index in 0..<path.count |line_map, path|:
        line_map.push(path[entry_index])
    line_map.push(10)




# The expansion carries stage0's own `#line <n> <abs path>\n` directive wherever a file starts
# or resumes, so stage1's buffer IS stage0's buffer and every byte offset (`__auto_<n>`,
# `__MachineMode_<hash>_<n>`, the test-runner echo) matches with no correction. Token lines
# stay BUFFER lines (Lexer.renumber_on_directive is cleared for a driver-expanded unit) and
# the line map below attributes printed locations. ELISA_STAGE1_LINE_DIRECTIVES=0 opts out.
def line_directives_enabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag: mutable darray[u8] = []
    true return if not env_value("ELISA_STAGE1_LINE_DIRECTIVES", &flag)
    return not (flag.count == 1.usize() and flag[0] == 48)




def push_line_directive(out: mutable darray[u8]&, line: u32, path: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
    for prefix_index in 0..<sview_len("#line ") |out|:
        out.push(sview_at("#line ", prefix_index))
    append_decimal(out, line)
    out.push(32)
    for path_index in 0..<path.count |out, path|:
        out.push(path[path_index])
    out.push(10)




# `line_map` accumulates `FLAT:ORIG:PATH` entries (see push_line_map_entry) — one where a
# file starts, and one each time it RESUMES after an include. A diagnostic then names the
# original file and line by finding the last entry at or below the reported line. Per
# file-run, not per line, so the map over the compiler's 509-file closure is tens of KB.
def expand_includes(path: darray[u8]&, out: mutable darray[u8]&, seen: mutable darray[u8]&, active: mutable darray[u8]&, depth: i64, line_map: mutable darray[u8]&, emitted_lines: mutable u32&, cycle_detected: mutable bool&, read_failed: mutable bool&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    if depth > 64:
        read_failed <- true
        return false
    # ABSOLUTE, cleaned paths — stage0 prints what filepath.Abs produced, and more
    # importantly `path_already_seen` compares raw bytes: the same file reached as
    # `./x.elisa` from one directory and `../lexer/x.elisa` from another did not dedup, so
    # the include closure over the compiler's own tree reported 575 files where stage0
    # reports 509. Canonicalising at the door fixes the listing and the dedup together.
    absolute: darray[u8] = ProjectSystem::absolute_path(path)
    if path_already_seen(active, absolute):
        cycle_detected <- true
        return false
    true return if path_already_seen(seen, absolute)
    for index in 0..<absolute.count |active, absolute|:
        active.push(absolute[index])
    active.push(0)
    # Record the path by APPENDING its bytes plus a NUL. A `darray[darray[u8]]` would need
    # each entry allocated in a region outliving the table, which the region checker
    # correctly rejects for a locally-built buffer; one flat buffer sidesteps the
    # ownership question entirely.
    for index in 0..<absolute.count |seen, absolute|:
        seen.push(absolute[index])
    seen.push(0)
    path_c: mutable darray[u8] = []
    for index in 0..<absolute.count |path_c, absolute|:
        path_c.push(absolute[index])
    path_c.push(0)
    path_cstr: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
    if not source_readable(path_cstr):
        read_failed <- true
        active.count <- active.count - absolute.count - 1.usize()
        return false
    contents: darray[u8] = read_file(path_cstr)
    if contents.count == 0:
        active.count <- active.count - absolute.count - 1.usize()
        return false
    if line_directives_enabled():
        push_line_directive(out, 1, absolute)
        emitted_lines <- emitted_lines + 1
    # The map entry names the file's FIRST REAL line — after the directive line when one
    # was emitted — so a fault at file line N maps back to N, not N + 1.
    push_line_map_entry(line_map, emitted_lines + 1, 1, absolute)
    directory: darray[u8] = path_directory(absolute)
    # Lines are SPANS into `contents`, not a copied-out buffer.
    #
    # The buffer version accumulated each line byte by byte into a `line` darray that grew
    # while `out` and `seen` were already live below it. Under the driver's non-relocating
    # arena only the TAIL allocation can grow, so the first line longer than ~519 bytes
    # panicked in arena_realloc ("cannot grow in place: not the tail allocation") — which
    # made the CLI unable to read ANY file containing a long line, its own sources included.
    # Nothing caught it because the wrapper flattens includes before the driver runs, so the
    # only route through this code was one no gate exercised.
    # The sentinel iteration at `index == contents.count` flushes a FINAL UNTERMINATED line.
    # It used to run unconditionally, so a file ending in a newline — almost every file — had
    # its already-flushed last line followed by an extra empty one. One spurious blank line
    # per included file: the compiler's own closure came out 22 lines longer than the
    # wrapper's flattening of the same sources, which showed up as line-numbered internal
    # symbols disagreeing between the two.
    trailing_partial: bool = contents.count > 0.usize() and contents[contents.count - 1.usize()] != 10
    expanded: mutable bool = true
    index: mutable usize = 0.usize()
    line_start: mutable usize = 0.usize()
    source_line: mutable u32 = 0
    while index < contents.count + (1.usize() if trailing_partial else 0.usize()) |index, line_start, source_line, emitted_lines, line_map, absolute, contents, out, seen, directory, depth, trailing_partial|:
        at_end: bool = index == contents.count
        byte: u8 = 10 if at_end else contents[index]
        if byte == 10:
            included: darray[u8] = include_directive_path_span(contents, line_start, index)
            if included.count > 0:
                resolved: darray[u8] = resolve_include_path(directory, included)
                resume_flat: usize = out.count
                included_ok: bool = expand_includes(resolved, out, seen, active, depth + 1, line_map, emitted_lines, cycle_detected, read_failed) if expanded else true
                expanded <- false if not included_ok
                if included_ok:
                    # This file RESUMES after the include directive: the next flattened line is
                    # this file's line `source_line + 2` (source_line is 0-based and still points
                    # at the directive).
                    if line_directives_enabled():
                        # stage0's newline guard: an include that contributed nothing still ends
                        # its parent's line before the resume directive.
                        if out.count == resume_flat:
                            out.push(10)
                            # That guard byte is an EMPTY BUFFER LINE where the include stood;
                            # the line map must count it or every later line maps one too low.
                            emitted_lines <- emitted_lines + 1
                        push_line_directive(out, source_line + 2, absolute)
                        emitted_lines <- emitted_lines + 1
                    # As at the root: the resume entry names the parent's next REAL line.
                    push_line_map_entry(line_map, emitted_lines + 1, source_line + 2, absolute)
            else:
                for line_index in line_start..<index |out, contents|:
                    out.push(contents[line_index])
                out.push(10)
                emitted_lines <- emitted_lines + 1
            line_start <- index + 1.usize()
            source_line <- source_line + 1
        index <- index + 1.usize()
    active.count <- active.count - absolute.count - 1.usize()
    return expanded
