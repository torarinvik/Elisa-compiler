# `-emit interpret` — run the program and report `main`'s result.


# `-emit interpret` — run the program and report `main`'s RESULT.
#
# stage0 interprets the AST; stage1 compiles and runs, which is observably the same. The
# return value cannot travel out through the process exit status (0-255, and stage0 prints
# 100000 exactly), so the module's `main` is renamed and a synthesized entry point prints it
# — see Backend::wrap_main_for_interpret.
#
# Measured against stage0: an i64 `main` prints `[ result   ] <value>`; a void `main` prints
# NOTHING; a unit with no `main` reports `error: interpreter does not know function "main"`
# and exits 1; the program's own console output comes FIRST.
def interpret_main_returns_void(declarations: darray[Ast::Decl]&, found: mutable bool&) -> bool can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |found|:
        if declaration is Decl.Func(im_name, im_params, im_ret, im_body, im_effects, im_decorators, im_line):
            continue if im_name != "main"
            found <- true
            # `-> void` is either an absent return type or the `void` name.
            if im_ret is im_ret_present:
                if im_ret_present is Expr.Ident(im_ret_name, im_ret_line):
                    return im_ret_name == "void"
                return false
            return true
    return false




def emit_interpret(file: Ast::File&, out_path: darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    found_main: mutable bool = false
    returns_void: bool = interpret_main_returns_void(file.top_decls, &found_main)
    if not found_main:
        message: mutable darray[u8] = []
        emit_tokens_push_sview(&message, "error: interpreter does not know function \"main\"\n")
        write_stderr(message)
        return 1

    ctx: LLVMContextRef = LLVMContextCreate()
    module_handle: LLVMModuleRef = LLVMModuleCreateWithNameInContext("elisac_stage1_interpret", ctx)
    stamp_module_source_path(module_handle)
    triple_storage: mutable darray[u8] = []
    machine: LLVMTargetMachineRef = Backend::configure_module_target_for(module_handle, requested_target_triple(&triple_storage))
    target_data: LLVMTargetDataRef = LLVMCreateTargetDataLayout(machine)
    builder: LLVMBuilderRef = LLVMCreateBuilderInContext(ctx)
    emitted: i64 = Backend::emit_module(file, module_handle, ctx, builder, target_data)
    2 return if emitted <= 0 and unit_declares_function(file.top_decls)
    if not Backend::wrap_main_for_interpret(returns_void, module_handle, ctx, builder):
        message: mutable darray[u8] = []
        emit_tokens_push_sview(&message, "error: interpreter does not know function \"main\"\n")
        write_stderr(message)
        return 1

    # The parity gate compiles programs concurrently. A shared object/executable path lets
    # one invocation replace another between link and run, producing a result for the wrong
    # source (or an intermittent linker failure). Keep each process's artifacts distinct.
    work: mutable darray[u8] = []
    emit_tokens_push_sview(&work, "/tmp/elisa-interpret-stage1-")
    append_decimal(&work, elisa_stage1_getpid().u32())
    object_path: mutable darray[u8] = []
    for object_path_index in 0..<work.count |object_path, work|:
        object_path.push(work[object_path_index])
    emit_tokens_push_sview(&object_path, "-program.o")
    binary_path: mutable darray[u8] = []
    for binary_path_index in 0..<work.count |binary_path, work|:
        binary_path.push(work[binary_path_index])
    emit_tokens_push_sview(&binary_path, "-program")
    object_c: mutable darray[u8] = []
    for object_index in 0..<object_path.count |object_c, object_path|:
        object_c.push(object_path[object_index])
    object_c.push(0)
    object_cstr: cstr = (&object_c[0]).cast[cstr] can Unsafe.PointerCast
    if not Backend::emit_object(machine, module_handle, object_cstr):
        _ = unlink(object_cstr)
        return 4

    # Link with the runtime, exactly as `-emit exe` does -- INCLUDING `-Wl,-dead_strip`
    # (elisac_link.elisa). Without it an extern that is declared and called only from an
    # unreachable function (test/repro/segment_flow_filter_accept) failed to link here while
    # the exe path, the native gate and stage0's interpreter (which never links) all ran it.
    link_command: mutable darray[u8] = []
    emit_tokens_push_sview(&link_command, "clang -fno-builtin -Wl,-dead_strip -o ")
    carchive_push_quoted(&link_command, binary_path)
    link_command.push(32)
    carchive_push_quoted(&link_command, object_path)
    runtime_object: mutable darray[u8] = []
    push_runtime_object_path(&runtime_object)
    if runtime_object.count > 0 and not unit_defines_default_runtime(file.top_decls):
        link_command.push(32)
        carchive_push_quoted(&link_command, runtime_object)
    callback_fallback_path: mutable darray[u8] = []
    for callback_path_index in 0..<work.count |callback_fallback_path, work|:
        callback_fallback_path.push(work[callback_path_index])
    emit_tokens_push_sview(&callback_fallback_path, "-native-callback.c")
    if not write_executable_callback_fallback(callback_fallback_path):
        _ = unlink(object_cstr)
        message: mutable darray[u8] = []
        emit_tokens_push_sview(&message, "error: -emit interpret: could not prepare the native callback fallback\n")
        write_stderr(message)
        return 1
    link_command.push(32)
    carchive_push_quoted(&link_command, callback_fallback_path)
    if cbind_run(link_command) != 0:
        callback_c: mutable darray[u8] = []
        for callback_index in 0..<callback_fallback_path.count |callback_c, callback_fallback_path|:
            callback_c.push(callback_fallback_path[callback_index])
        callback_c.push(0)
        callback_cstr: cstr = (&callback_c[0]).cast[cstr] can Unsafe.PointerCast
        _ = unlink(callback_cstr)
        _ = unlink(object_cstr)
        message: mutable darray[u8] = []
        emit_tokens_push_sview(&message, "error: -emit interpret: could not link the program\n")
        write_stderr(message)
        return 1

    callback_c: mutable darray[u8] = []
    for callback_index in 0..<callback_fallback_path.count |callback_c, callback_fallback_path|:
        callback_c.push(callback_fallback_path[callback_index])
    callback_c.push(0)
    callback_cstr: cstr = (&callback_c[0]).cast[cstr] can Unsafe.PointerCast
    _ = unlink(callback_cstr)
    _ = unlink(object_cstr)

    # Run it. Its stdout IS the report: the program's own output, then the result line the
    # synthesized entry point prints.
    run_command: mutable darray[u8] = []
    carchive_push_quoted(&run_command, binary_path)
    _ = cbind_run(run_command)
    binary_c: mutable darray[u8] = []
    for binary_index in 0..<binary_path.count |binary_c, binary_path|:
        binary_c.push(binary_path[binary_index])
    binary_c.push(0)
    binary_cstr: cstr = (&binary_c[0]).cast[cstr] can Unsafe.PointerCast
    _ = unlink(binary_cstr)
    return 0
