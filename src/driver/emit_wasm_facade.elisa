    emit_tokens_push_sview(buffer, "    strlen(pointer) { let length = 0; const data = bytes(); while (data[(pointer >>> 0) + length] !== 0) length++; return length; },\n")
    emit_tokens_push_sview(buffer, "    strcmp(left, right) { const a = readCString(left), b = readCString(right); return a < b ? -1 : (a > b ? 1 : 0); },\n")
