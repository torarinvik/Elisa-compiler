    emit_tokens_push_sview(buffer, "  };\n")
    emit_tokens_push_sview(buffer, "  const coalesceFreeBlocks = () => {\n")
    emit_tokens_push_sview(buffer, "    freeBlocks.sort((left, right) => left.pointer - right.pointer);\n")
    emit_tokens_push_sview(buffer, "    for (let index = 1; index < freeBlocks.length;) {\n")
    emit_tokens_push_sview(buffer, "      const previous = freeBlocks[index - 1], current = freeBlocks[index];\n")
    emit_tokens_push_sview(buffer, "      if (previous.pointer + previous.size === current.pointer) {\n")
    emit_tokens_push_sview(buffer, "        previous.size += current.size;\n")
