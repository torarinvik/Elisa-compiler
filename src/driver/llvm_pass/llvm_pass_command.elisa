# `elisac llvm-pass PASS INPUT.ll`: runs one Elisa-hosted LLVM pass over a
# textual IR module, verifies the result, and prints the pass's change count
# on the first line and the module after it. The LLVM pass tests in
# test/llvm drive the passes through this command.
#
# Exit codes: 0 done, 1 usage or unknown pass, 2 unreadable IR, 3 the pass
# left invalid IR.
def write_llvm_pass_error(message: sview) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    text: mutable darray[u8] = []
    for index in 0..<message.len |text, message|:
        text.push(message[index])
    write_stderr(text)

# Reports and frees an LLVM-C error message left in an out-cell.
def write_llvm_message(message_storage: void&?, message_slot: u8&&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    if message_storage is present:
        message: cstr = message_slot[0].cast[cstr]
        text: mutable darray[u8] = []
        push_cstr(&text, message)
        text.push(10)
        write_stderr(text)
        LLVMDisposeMessage(message)

# Reads a textual IR file through the LLVM C API. LLVM writes the buffer and the module
# through `void **` out-cells, so each raw pointer is cast to its opaque handle type.
def parse_textual_module(context: LLVMContextRef, path: cstr) -> LLVMModuleRef? can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    buffer_storage: mutable void&? = null
    read_error_storage: mutable void&? = null
    read_error_slot: u8&& = (&read_error_storage).cast[u8&&]
    read_status: i32 = LLVMCreateMemoryBufferWithContentsOfFile(path, (&buffer_storage).cast[void&], (&read_error_storage).cast[void&])
    write_llvm_message(read_error_storage, read_error_slot)
    if buffer_storage is raw_buffer:
        buffer: LLVMMemoryBufferRef = raw_buffer.cast[LLVMMemoryBufferRef]
        if read_status != 0:
            LLVMDisposeMemoryBuffer(buffer)
            return null
        module_storage: mutable void&? = null
        parse_error_storage: mutable void&? = null
        parse_error_slot: u8&& = (&parse_error_storage).cast[u8&&]
        parse_status: i32 = LLVMParseIRInContext(context, buffer, (&module_storage).cast[void&], (&parse_error_storage).cast[void&])
        write_llvm_message(parse_error_storage, parse_error_slot)
        if module_storage is raw_module:
            module: LLVMModuleRef = raw_module.cast[LLVMModuleRef]
            return module if parse_status == 0
            LLVMDisposeModule(module)
    null

def run_llvm_pass_command(argc: i64, argv: mutable void&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic, Console]:
    if argc != 4:
        write_llvm_pass_error("usage: elisac llvm-pass PASS INPUT.ll\n")
        return 1
    slots: mutable cstr&& = argv.cast[mutable cstr&&]
    pass_name: cstr = slots[2].cast[cstr]
    input_path: cstr = slots[3].cast[cstr]
    context: LLVMContextRef = LLVMContextCreate()
    status: mutable i64 = 2
    if parse_textual_module(context, input_path) is module:
        changed: i64 = Backend::run_named_llvm_pass(pass_name, module)
        if changed < 0:
            write_llvm_pass_error("elisac llvm-pass: unknown pass\n")
            status <- 1
        elif LLVMVerifyModule(module, LLVM_VERIFY_PRINT_MESSAGE_ACTION, null) != 0:
            status <- 3
        else:
            output: mutable darray[u8] = []
            append_decimal_i64(&output, changed)
            output.push(10)
            text: cstr = LLVMPrintModuleToString(module)
            push_cstr(&output, text)
            LLVMDisposeMessage(text)
            write_stdout_bytes(output)
            status <- 0
        LLVMDisposeModule(module)
    LLVMContextDispose(context)
    status
