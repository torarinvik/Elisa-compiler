# Driver — rendering a PUSH LOOP finding (src/semantic/check_never_leak_push_loop.elisa).
#
# The message names the darray, its declaration, the loop that fills it and its first later read,
# says why the shape is a problem, and prints the comprehension that replaces the declaration and
# the loop, built from the user's own text: the declared type without `mutable`, the pushed value,
# and each `for`/`if` header line in order, so `[VALUE for x in xs if c for y in ys]` reads exactly
# like the loop it replaces. A finding whose lines do not have that plain one-line shape is not
# reported (there is no rewrite to paste).

# `line` without its indent and its trailing `:` — [start, stop), trailing blanks dropped — when it
# starts with `prefix` (`for ` or `if `) and ends with the colon that opens its block.
def nl_push_clause_span(source: NeverLeakSource&, line: u32, prefix: sview, start: mutable usize&, stop: mutable usize&) -> bool can[Abort.Panic]:
    colon: usize = nl_acc_header_colon(source, line)
    false return if colon == 0
    first: usize = nl_line_start(source, line) + nl_indent_width(source, line)
    false return if not nl_acc_starts_with(source, first, colon, prefix)
    last: mutable usize = colon
    while last > first and source.bytes[last - 1] == 32 |last, source, first|:
        last <- last - 1
    start <- first
    stop <- last
    return stop > start + sview_len(prefix).usize()


# The VALUE of a line that is exactly `name.push(VALUE)`: [start, stop).
def nl_push_value_span(source: NeverLeakSource&, line: u32, name: sview, start: mutable usize&, stop: mutable usize&) -> bool can[Abort.Panic]:
    first: usize = nl_line_start(source, line) + nl_indent_width(source, line)
    last: mutable usize = nl_line_end(source, line)
    while last > first and (source.bytes[last - 1] == 32 or source.bytes[last - 1] == 9) |last, source, first|:
        last <- last - 1
    false return if not nl_acc_starts_with(source, first, last, name)
    receiver_end: usize = first + sview_len(name).usize()
    false return if not nl_acc_starts_with(source, receiver_end, last, ".push(")
    false return if last == 0 or source.bytes[last - 1] != 41
    start <- receiver_end + 6
    stop <- last - 1
    return stop > start


# Whether every line of the finding has the plain shape the rewrite is built from: the declaration
# `name: mutable darray[T] = []` on one line, one `for`/`if` header per line (the first a `for`),
# and the push line.
def nl_push_loop_renderable(finding: Semantic::NeverLeakFinding&, clause_lines: darray[u32]&, source: NeverLeakSource&) -> bool can[Abort.Panic]:
    false return if finding.clause_count < 2
    type_start: mutable usize = 0
    type_stop: mutable usize = 0
    init_start: mutable usize = 0
    false return if not nl_acc_decl_parts(source, finding.decl_line, finding.name, type_start, type_stop, init_start)
    init_stop: mutable usize = nl_line_end(source, finding.decl_line)
    while init_stop > init_start and source.bytes[init_stop - 1] == 32 |init_stop, source, init_start|:
        init_stop <- init_stop - 1
    false return if init_stop != init_start + 2 or source.bytes[init_start] != 91 or source.bytes[init_start + 1] != 93
    first: usize = finding.clause_first.usize()
    last: usize = first + finding.clause_count.usize() - 1
    span_start: mutable usize = 0
    span_stop: mutable usize = 0
    for index in first..<last |span_start, span_stop, clause_lines, source, first|:
        is_for: bool = nl_push_clause_span(source, clause_lines[index], "for ", span_start, span_stop)
        false return if not is_for and (index == first or not nl_push_clause_span(source, clause_lines[index], "if ", span_start, span_stop))
    return nl_push_value_span(source, clause_lines[last], finding.name, span_start, span_stop)


# `line N` or `lines N-M`.
def nl_push_line_span(text: mutable darray[u8]&, source: NeverLeakSource&, first: u32, last: u32) -> void can[Abort.Panic, Memory.Allocate]:
    if last <= first:
        nl_push_line_ref(text, source, first)
        return
    emit_tokens_push_sview(text, "lines ")
    append_decimal(text, nl_orig_line(source, first))
    text.push(45)
    append_decimal(text, nl_orig_line(source, last))


def nl_report_push_loop(finding: Semantic::NeverLeakFinding&, clause_lines: darray[u32]&, source: NeverLeakSource&, mode: u8) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    first: usize = finding.clause_first.usize()
    last: usize = first + finding.clause_count.usize() - 1
    loop_line: u32 = clause_lines[first]
    push_line: u32 = clause_lines[last]
    filtered: mutable bool = false
    span_start: mutable usize = 0
    span_stop: mutable usize = 0
    for index in first..<last |filtered, span_start, span_stop, clause_lines, source|:
        filtered <- true if nl_push_clause_span(source, clause_lines[index], "if ", span_start, span_stop)
    text: mutable darray[u8] = []
    nl_push_location(text, source, finding.decl_line)
    emit_tokens_push_sview(text, ": error: local " if mode == 2 else ": warning: local ")
    nl_push_name(text, finding.name)
    emit_tokens_push_sview(text, " is filled by a push loop and stays mutable after it [-Wnever-leak]\n  ")
    nl_push_name(text, finding.name)
    emit_tokens_push_sview(text, ": declared `mutable` and empty on ")
    nl_push_line_ref(text, source, finding.decl_line)
    emit_tokens_push_sview(text, "; filled only by the loop on ")
    nl_push_line_span(text, source, loop_line, push_line)
    emit_tokens_push_sview(text, ", one `")
    emit_tokens_push_sview(text, finding.name)
    emit_tokens_push_sview(text, ".push` per element")
    emit_tokens_push_sview(text, " that passes its filter" if filtered else "")
    emit_tokens_push_sview(text, "; read only after it (first read: ")
    nl_push_line_ref(text, source, finding.reason_line)
    emit_tokens_push_sview(text, ")\n  kind: push loop (a `mutable` darray that starts empty, that only a loop fills with `push`, and that only code after the loop reads)\n  why: once the loop ends ")
    nl_push_name(text, finding.name)
    emit_tokens_push_sview(text, " is complete, yet it stays `mutable` and in scope, so any later line could still change it; a comprehension builds the same elements in the same order as one immutable binding, in one expression (over a range or a darray with no filter it also allocates the array once, instead of growing it push by push)\n  fix: ")
    if finding.decl_next_line == loop_line:
        emit_tokens_push_sview(text, "replace ")
        nl_push_line_span(text, source, finding.decl_line, push_line)
        emit_tokens_push_sview(text, " with:\n")
    else:
        emit_tokens_push_sview(text, "delete the declaration on ")
        nl_push_line_ref(text, source, finding.decl_line)
        emit_tokens_push_sview(text, " and replace the loop on ")
        nl_push_line_span(text, source, loop_line, push_line)
        emit_tokens_push_sview(text, " with:\n")
    type_start: mutable usize = 0
    type_stop: mutable usize = 0
    init_start: mutable usize = 0
    _ = nl_acc_decl_parts(source, finding.decl_line, finding.name, type_start, type_stop, init_start)
    nl_push_spaces(text, 6 + nl_indent_width(source, loop_line))
    emit_tokens_push_sview(text, finding.name)
    emit_tokens_push_sview(text, ": ")
    nl_push_bytes(text, source, type_start, type_stop)
    emit_tokens_push_sview(text, " = [")
    _ = nl_push_value_span(source, push_line, finding.name, span_start, span_stop)
    nl_push_bytes(text, source, span_start, span_stop)
    for index in first..<last |text, span_start, span_stop, clause_lines, source|:
        if not nl_push_clause_span(source, clause_lines[index], "for ", span_start, span_stop):
            _ = nl_push_clause_span(source, clause_lines[index], "if ", span_start, span_stop)
        text.push(32)
        nl_push_bytes(text, source, span_start, span_stop)
    emit_tokens_push_sview(text, "]\n")
    write_stderr(text)


# Whether a VALUE_THREAD finding (`squares.push(v)` as a statement) sits inside a push loop that
# is reported: the comprehension rewrite deletes that line, so `squares <- squares.push(v)` would
# be a second, conflicting fix for the same line.
def nl_push_loop_covers(thread: Semantic::NeverLeakFinding&, findings: darray[Semantic::NeverLeakFinding]&, clause_lines: darray[u32]&, source: NeverLeakSource&) -> bool can[Abort.Panic]:
    for finding in findings |thread, clause_lines, source|:
        continue if finding.category != Semantic::NEVER_LEAK_PUSH_LOOP or finding.name != thread.name or finding.function_name != thread.function_name
        continue if finding.decl_line != thread.other_decl_line
        true return if nl_push_loop_renderable(finding, clause_lines, source)
    return false
