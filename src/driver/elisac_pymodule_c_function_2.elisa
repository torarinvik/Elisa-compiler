# `-emit pymodule` — one exported function's C wrapper, stage 2 of 5: the argument PARSE table
# (format string, keyword names, defaults) and the per-parameter conversions that materialize
# each Python argument into its native form. Continues elisac_pymodule_c_function.elisa; the
# facts about the target it reads are recomputed there rather than threaded, since every one is
# a pure function of the file and the target's name.

def emit_pymodule_c_function_2(buffer: mutable darray[u8]&, file: mutable Ast::File&, module_name: sview, annotation: Ast::EnumAnnotation) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    return if annotation.name != "__pymodule_fn"
    target_name: mutable sview = ""
    for target_annotation in file.enum_annotations |target_name, annotation|:
        target_name <- target_annotation.owner if target_annotation.name == "__pymodule_target_ref" and target_annotation.line == annotation.line
    target_decl: Ast::Decl? = pymodule_find_function_in(file.top_decls, target_name)
    if target_decl is target_function:
        if target_function is Decl.Func(target_function_name, source_params, target_return, target_body, target_effects, target_decorators, target_pos):
            target_params: mutable darray[Ast::ParamDecl] = pymodule_alias_normalize_params(file, source_params)
            return_type_name: mutable sview = "void"
            if target_return is declared_return:
                return_type_name <- pymodule_alias_type_name(file, declared_return)
            is_error: bool = pymodule_function_is_error(file, target_name)
            error_family: sview = pymodule_function_error_family(file, target_name) if is_error else ""
            has_payload_error: bool = is_error and pymodule_error_set_has_payload_in(file.top_decls, error_family)
            payload_type_name: sview = pymodule_error_payload_type_in(file, file.top_decls, error_family) if has_payload_error else ""
            structured_payload_error: bool = has_payload_error and pymodule_error_payload_is_structured_in(file.top_decls, error_family)
            has_payload_arena: bool = has_payload_error and pymodule_error_payload_needs_arena_in(file, file.top_decls, error_family)
            has_payload_struct: bool = has_payload_error and (pymodule_struct_return_supported(file, payload_type_name) if not structured_payload_error else pymodule_error_payload_contains_struct_in(file, file.top_decls, error_family))
            has_darray_param: mutable bool = false
            for darray_probe in target_params |has_darray_param|:
                has_darray_param <- true if pymodule_is_darray_type(pymodule_alias_type_name(file, darray_probe.type_expression))
            has_darray_ref_param: mutable bool = false
            for darray_ref_probe in target_params |has_darray_ref_param|:
                darray_ref_type_name: sview = pymodule_alias_type_name(file, darray_ref_probe.type_expression)
                has_darray_ref_param <- true if pymodule_darray_ref_parameter(darray_ref_type_name, darray_ref_probe.type_expression)
            has_struct_darray_param: mutable bool = false
            for struct_darray_probe in target_params |has_struct_darray_param|:
                struct_darray_type_name: sview = pymodule_alias_type_name(file, struct_darray_probe.type_expression)
                # Direct struct inputs also own a temporary arena/reference table.  Treat
                # them like aggregate sequence inputs so scalar-return wrappers cannot take
                # the expression fast path and leak that storage after a successful call.
                if pymodule_struct_input_supported(file, struct_darray_type_name):
                    has_struct_darray_param <- true
                elif pymodule_is_darray_type(struct_darray_type_name) or pymodule_is_view_type(struct_darray_type_name):
                    struct_darray_element_name: sview = pymodule_darray_element_name(struct_darray_type_name) if pymodule_is_darray_type(struct_darray_type_name) else pymodule_view_element_name(struct_darray_type_name)
                    has_struct_darray_param <- true if pymodule_struct_input_supported(file, struct_darray_element_name)
            has_dict_param: mutable bool = false
            for dict_probe in target_params |has_dict_param|:
                has_dict_param <- true if pymodule_is_dict_type(pymodule_alias_type_name(file, dict_probe.type_expression))
            has_set_param: mutable bool = false
            for set_probe in target_params |has_set_param|:
                has_set_param <- true if pymodule_is_set_type(pymodule_alias_type_name(file, set_probe.type_expression))
            has_view_param: mutable bool = false
            for view_probe in target_params |has_view_param|:
                has_view_param <- true if pymodule_is_view_type(pymodule_alias_type_name(file, view_probe.type_expression))
            has_dict_return: bool = pymodule_is_dict_type(return_type_name)
            has_set_return: bool = pymodule_is_set_type(return_type_name)
            has_view_return: bool = pymodule_is_view_type(return_type_name)
            has_optional_return: bool = pymodule_is_optional_scalar_type(return_type_name)
            has_struct_return: bool = pymodule_struct_return_supported(file, return_type_name)
            has_fixed_array_return: bool = pymodule_fixed_array_return_supported(return_type_name)
            has_output_arena: bool = pymodule_is_darray_type(return_type_name) or has_dict_return or has_set_return or (has_struct_return and pymodule_struct_return_contains_darray(file, return_type_name)) or has_payload_arena
            has_return_arena: bool = has_output_arena or has_darray_ref_param
            for parameter_index in 0..<target_params.count |buffer, target_params|:
                emit_tokens_push_sview(buffer, ", ") if parameter_index > 0
                emit_tokens_push_sview(buffer, "\"")
                emit_tokens_push_sview(buffer, target_params[parameter_index].name)
                emit_tokens_push_sview(buffer, "\"")
            emit_tokens_push_sview(buffer, ", NULL};\n" if target_params.count > 0 else "NULL};\n")
            for parameter_index in 0..<target_params.count |buffer, target_params|:
                parameter_type_name: sview = pymodule_alias_type_name(file, target_params[parameter_index].type_expression)
                has_container_parameter_default: bool = target_params[parameter_index].has_default and pymodule_default_is_container(target_params[parameter_index].default_value) and pymodule_default_supported(file, parameter_type_name, target_params[parameter_index].default_value)
                if parameter_type_name == "sview":
                    emit_tokens_push_sview(buffer, "    const char *arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_data")
                    if target_params[parameter_index].has_default:
                        emit_tokens_push_sview(buffer, " = ")
                        emit_pymodule_default_literal(buffer, file, target_params[parameter_index].default_value)
                    emit_tokens_push_sview(buffer, ";\n    Py_ssize_t arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_len")
                    if target_params[parameter_index].has_default:
                        emit_tokens_push_sview(buffer, " = (Py_ssize_t)(sizeof(")
                        emit_pymodule_default_literal(buffer, file, target_params[parameter_index].default_value)
                        emit_tokens_push_sview(buffer, ") - 1)")
                    emit_tokens_push_sview(buffer, ";\n")
                elif parameter_type_name == "cstr":
                    emit_tokens_push_sview(buffer, "    const char *arg")
                    append_decimal(buffer, parameter_index.i64())
                    if target_params[parameter_index].has_default:
                        emit_tokens_push_sview(buffer, " = ")
                        emit_pymodule_default_literal(buffer, file, target_params[parameter_index].default_value)
                    emit_tokens_push_sview(buffer, ";\n    Py_ssize_t arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_len")
                    if target_params[parameter_index].has_default:
                        emit_tokens_push_sview(buffer, " = (Py_ssize_t)(sizeof(")
                        emit_pymodule_default_literal(buffer, file, target_params[parameter_index].default_value)
                        emit_tokens_push_sview(buffer, ") - 1)")
                    emit_tokens_push_sview(buffer, ";\n")
                elif pymodule_is_dict_type(parameter_type_name) or pymodule_is_set_type(parameter_type_name):
                    emit_tokens_push_sview(buffer, "    PyObject *arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, " = NULL")
                    emit_tokens_push_sview(buffer, ";\n")
                    if has_container_parameter_default:
                        emit_tokens_push_sview(buffer, "    PyObject *arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_default = NULL;\n")
                    emit_tokens_push_sview(buffer, "    ElisaArena arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_arena = {0};\n")
                    emit_tokens_push_sview(buffer, "    int arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_materialized = 0;\n")
                    if pymodule_is_dict_type(parameter_type_name):
                        emit_tokens_push_sview(buffer, "    ElisaPyRefs arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_struct_refs = (ElisaPyRefs){0};\n")
                elif pymodule_fixed_array_input_supported(file, parameter_type_name, target_params[parameter_index].type_expression):
                    fixed_array_element_c_type: sview = pymodule_darray_c_element_type(pymodule_fixed_array_element_name(parameter_type_name))
                    emit_tokens_push_sview(buffer, "    PyObject *arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, ";\n    PyObject *arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_seq = NULL;\n    ")
                    emit_tokens_push_sview(buffer, fixed_array_element_c_type)
                    emit_tokens_push_sview(buffer, " arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_items[")
                    append_decimal(buffer, pymodule_fixed_array_extent(parameter_type_name).u32())
                    emit_tokens_push_sview(buffer, "];\n")
                elif pymodule_is_darray_type(parameter_type_name) or pymodule_is_view_type(parameter_type_name):
                    emit_tokens_push_sview(buffer, "    PyObject *arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, " = NULL" if has_container_parameter_default else "")
                    emit_tokens_push_sview(buffer, ";\n")
                    if has_container_parameter_default:
                        emit_tokens_push_sview(buffer, "    PyObject *arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_default = NULL;\n")
                    nested_parameter_element: sview = pymodule_darray_element_name(parameter_type_name) if pymodule_is_darray_type(parameter_type_name) else ""
                    if pymodule_is_darray_type(parameter_type_name) and (pymodule_is_darray_type(nested_parameter_element) or pymodule_is_set_type(nested_parameter_element) or pymodule_is_view_type(nested_parameter_element)):
                        emit_tokens_push_sview(buffer, "    ElisaDArray arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_value = {0};\n    ElisaArena arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_struct_arena = {0}; arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_struct_arena.strategy = 0;\n    ElisaPyRefs arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_struct_refs = {0};\n")
                    elif pymodule_darray_is_bytes(parameter_type_name):
                        emit_tokens_push_sview(buffer, "    PyObject *arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_bytes = NULL;\n")
                    else:
                        element_name: sview = pymodule_darray_element_name(parameter_type_name) if pymodule_is_darray_type(parameter_type_name) else pymodule_view_element_name(parameter_type_name)
                        element_c_type: mutable sview = pymodule_darray_c_element_type(element_name)
                        element_c_type <- "ElisaDict" if pymodule_is_dict_type(element_name)
                        element_c_type <- element_name if element_c_type == "" and pymodule_struct_input_supported(file, element_name)
                        emit_tokens_push_sview(buffer, "    PyObject *arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_seq = NULL;\n")
                        if pymodule_struct_input_supported(file, element_name) or pymodule_is_dict_type(element_name):
                            emit_tokens_push_sview(buffer, "    ElisaArena arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_struct_arena = {0}; arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_struct_arena.strategy = 0;\n    ElisaPyRefs arg")
                            append_decimal(buffer, parameter_index.i64())
                            emit_tokens_push_sview(buffer, "_struct_refs = {0};\n")
                        emit_tokens_push_sview(buffer, "    ")
                        emit_tokens_push_sview(buffer, element_c_type)
                        emit_tokens_push_sview(buffer, " *arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_items = NULL;\n")
                elif pymodule_is_optional_scalar_type(parameter_type_name):
                    emit_tokens_push_sview(buffer, "    PyObject *arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_obj = NULL;\n" if target_params[parameter_index].has_default else "_obj = Py_None;\n")
                    if target_params[parameter_index].has_default:
                        emit_tokens_push_sview(buffer, "    PyObject *arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_default = NULL;\n")
                elif pymodule_struct_input_supported(file, parameter_type_name):
                    emit_tokens_push_sview(buffer, "    PyObject *arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, " = NULL;\n" if has_container_parameter_default else ";\n")
                    if has_container_parameter_default:
                        emit_tokens_push_sview(buffer, "    PyObject *arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_default = NULL;\n")
                    emit_tokens_push_sview(buffer, "    ")
                    emit_tokens_push_sview(buffer, "ElisaArena arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_struct_arena = {0}; arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_struct_arena.strategy = 0;\n    ElisaPyRefs arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_struct_refs = {0};\n    ")
                    emit_tokens_push_sview(buffer, parameter_type_name)
                    emit_tokens_push_sview(buffer, " arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_value = {0};\n")
                else:
                    local_type: sview = "PyObject *" if parameter_type_name == "py::Object" or parameter_type_name == "py::Object?" or parameter_type_name == "cstr?" else ("const char *" if parameter_type_name == "cstr" else ("int" if parameter_type_name == "bool" else ("double" if parameter_type_name == "f32" or parameter_type_name == "f64" else ("unsigned long long" if parameter_type_name == "u8" or parameter_type_name == "u16" or parameter_type_name == "u32" or parameter_type_name == "u64" or parameter_type_name == "usize" or parameter_type_name == "uintptr" else "long long"))))
                    emit_tokens_push_sview(buffer, "    ")
                    emit_tokens_push_sview(buffer, local_type)
                    emit_tokens_push_sview(buffer, " arg")
                    append_decimal(buffer, parameter_index.i64())
                    if target_params[parameter_index].has_default and pymodule_parameter_is_implicit_optional(parameter_type_name):
                        emit_tokens_push_sview(buffer, " = NULL")
                        emit_tokens_push_sview(buffer, ";\n    PyObject *arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_default = NULL")
                    elif target_params[parameter_index].has_default:
                        emit_tokens_push_sview(buffer, " = ")
                        emit_pymodule_default_literal(buffer, file, target_params[parameter_index].default_value)
                    elif pymodule_parameter_is_implicit_optional(parameter_type_name):
                        emit_tokens_push_sview(buffer, " = Py_None")
                    emit_tokens_push_sview(buffer, ";\n")
            # Keep the Python-facing parameter names alongside the parser format.  CPython's
            # conversion diagnostics are not consistent about naming the bad argument (for
            # example, a string passed to `L` usually only says "integer expected").  The
            # generated helper uses these tables to recover the first obvious wrong-type
            # parameter while leaving coercions and structural conversions to their normal
            # recursive validators.
            emit_tokens_push_sview(buffer, "    static const char *elisa_parse_parameter_names[] = {")
            for parameter_index in 0..<target_params.count |buffer, target_params|:
                emit_tokens_push_sview(buffer, ", ") if parameter_index > 0
                emit_tokens_push_sview(buffer, "\"")
                emit_tokens_push_sview(buffer, target_params[parameter_index].name)
                emit_tokens_push_sview(buffer, "\"")
            emit_tokens_push_sview(buffer, ", NULL};\n" if target_params.count > 0 else "NULL};\n")
            emit_tokens_push_sview(buffer, "    static const char *elisa_parse_parameter_formats[] = {")
            for parameter_index in 0..<target_params.count |buffer, target_params, file|:
                emit_tokens_push_sview(buffer, ", ") if parameter_index > 0
                emit_tokens_push_sview(buffer, "\"")
                emit_tokens_push_sview(buffer, pymodule_parse_format(pymodule_alias_type_name(file, target_params[parameter_index].type_expression)))
                emit_tokens_push_sview(buffer, "\"")
            emit_tokens_push_sview(buffer, ", NULL};\n" if target_params.count > 0 else "NULL};\n")
            emit_tokens_push_sview(buffer, "    elisa_pymodule_current_path_clear();\n    if (!PyArg_ParseTupleAndKeywords(args, kwargs, \"")
            saw_optional_format: mutable bool = false
            for parameter_index in 0..<target_params.count |buffer, target_params, saw_optional_format|:
                if (target_params[parameter_index].has_default or pymodule_parameter_is_implicit_optional(pymodule_alias_type_name(file, target_params[parameter_index].type_expression))) and not saw_optional_format:
                    emit_tokens_push_sview(buffer, "|")
                    saw_optional_format <- true
                emit_tokens_push_sview(buffer, pymodule_parse_format(pymodule_alias_type_name(file, target_params[parameter_index].type_expression)))
            emit_tokens_push_sview(buffer, "\", elisa_kwlist")
            for parameter_index in 0..<target_params.count |buffer, target_params|:
                parameter_type_name: sview = pymodule_alias_type_name(file, target_params[parameter_index].type_expression)
                if parameter_type_name == "sview":
                    emit_tokens_push_sview(buffer, ", &arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_data, &arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_len")
                elif parameter_type_name == "cstr":
                    emit_tokens_push_sview(buffer, ", &arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, ", &arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_len")
                elif pymodule_is_optional_scalar_type(parameter_type_name):
                    emit_tokens_push_sview(buffer, ", &arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_obj")
                else:
                    emit_tokens_push_sview(buffer, ", &arg")
                    append_decimal(buffer, parameter_index.i64())
            emit_tokens_push_sview(buffer, ")) { elisa_pymodule_annotate_parse_error(\"")
            emit_tokens_push_sview(buffer, annotation.owner)
            emit_tokens_push_sview(buffer, "\", args, kwargs, elisa_parse_parameter_names, elisa_parse_parameter_formats, ")
            append_decimal(buffer, target_params.count.i64())
            emit_tokens_push_sview(buffer, "); return NULL; }\n")
            # PyArg_ParseTupleAndKeywords leaves omitted optional `O` arguments as NULL.
            # Materialize each supported literal-container default as a fresh Python object so
            # the normal conversion paths can stay identical for omitted and explicit values.
            for parameter_index in 0..<target_params.count |buffer, target_params, file|:
                emit_pymodule_argument_context(buffer, annotation.owner, target_params[parameter_index].name, pymodule_alias_type_name(file, target_params[parameter_index].type_expression), "    ")
                parameter_type_name: sview = pymodule_alias_type_name(file, target_params[parameter_index].type_expression)
                if target_params[parameter_index].has_default and pymodule_default_is_container(target_params[parameter_index].default_value) and pymodule_default_supported(file, parameter_type_name, target_params[parameter_index].default_value):
                    emit_tokens_push_sview(buffer, "    if (arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, " == NULL) {\n        arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_default = ")
                    if pymodule_default_is_empty_container(target_params[parameter_index].default_value):
                        if pymodule_is_dict_type(parameter_type_name):
                            emit_tokens_push_sview(buffer, "PyDict_New()")
                        elif pymodule_is_set_type(parameter_type_name):
                            emit_tokens_push_sview(buffer, "PySet_New(NULL)")
                        elif pymodule_is_darray_type(parameter_type_name) and pymodule_darray_is_bytes(parameter_type_name):
                            emit_tokens_push_sview(buffer, "PyBytes_FromStringAndSize(\"\", 0)")
                        else:
                            emit_tokens_push_sview(buffer, "PyList_New(0)")
                    else:
                        default_builder_name_storage: mutable darray[u8] = []
                        emit_pymodule_default_builder_symbol(&default_builder_name_storage, module_name, annotation.owner, parameter_index)
                        emit_tokens_push_sview(buffer, sview(&default_builder_name_storage[0], 0, default_builder_name_storage.count))
                        emit_tokens_push_sview(buffer, "()")
                    emit_tokens_push_sview(buffer, ";\n        if (arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_default == NULL) {\n")
                    emit_pymodule_argument_error_annotation(buffer, annotation.owner, target_params[parameter_index].name, "            ")
                    emit_pymodule_parameter_default_cleanup(buffer, target_params, "            ")
                    emit_tokens_push_sview(buffer, "            return NULL;\n        }\n        arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, " = arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_default;\n    }\n")
            # Optional scalar/text/object defaults use the same omitted-object
            # path as explicit `None`, but retain the freshly-created Python
            # default until the native call and all cleanup paths finish.
            for parameter_index in 0..<target_params.count |buffer, target_params, file|:
                emit_pymodule_argument_context(buffer, annotation.owner, target_params[parameter_index].name, pymodule_alias_type_name(file, target_params[parameter_index].type_expression), "    ")
                parameter_type_name: sview = pymodule_alias_type_name(file, target_params[parameter_index].type_expression)
                if target_params[parameter_index].has_default and pymodule_parameter_is_implicit_optional(parameter_type_name) and not pymodule_default_is_container(target_params[parameter_index].default_value) and pymodule_default_supported(file, parameter_type_name, target_params[parameter_index].default_value):
                    optional_scalar_object: bool = pymodule_is_optional_scalar_type(parameter_type_name)
                    emit_tokens_push_sview(buffer, "    if (arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_obj" if optional_scalar_object else "")
                    emit_tokens_push_sview(buffer, " == NULL) {\n        arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_default = ")
