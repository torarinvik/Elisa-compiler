# Place source `using` declarations within their lexical module, in byte order.
def emit_ast_using_count(rows: darray[EmitAstUsing]&, owner: sview, low: u32, high: u32) -> usize:
    count: mutable usize = 0
    for row in rows |count, owner, low, high|:
        count <- count + 1 if row.scope == owner and row.offset >= low and row.offset < high
    return count

def emit_ast_using_range(buffer: mutable darray[u8]&, rows: darray[EmitAstUsing]&, owner: sview, low: u32, high: u32, level: i64) -> void can[Abort.Panic, Memory.Allocate]:
    for row in rows |buffer, owner, low, high, level|:
        if row.visible and row.scope == owner and row.offset >= low and row.offset < high:
            emit_ast_indent(buffer, level)
            emit_tokens_push_sview(buffer, "using ")
            emit_module_display_name(buffer, row.target, 0)
            emit_tokens_push_sview(buffer, "\n")

# Find the matching lexical DEDENT, which distinguishes reopened modules
# with the same qualified name and remains stable across #line directives.
def emit_ast_module_end(tokens: darray[Lexer::Token]&, start: u32) -> u32:
    started: mutable bool = false
    depth: mutable i64 = 0
    for token in tokens |started, depth, start|:
        continue if token.start < start
        if token.kind == Lexer::TokenKind.Indent:
            started <- true
            depth <- depth + 1
        elif token.kind == Lexer::TokenKind.Dedent and started:
            depth <- depth - 1
            return token.start if depth == 0
    return 4294967295.u32()
