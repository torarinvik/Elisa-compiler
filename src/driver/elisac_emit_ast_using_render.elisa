# Place source `using` declarations within their lexical module, in byte order.
def emit_ast_using_count(rows: darray[EmitAstUsing]&, owner: sview, low: u32, high: u32) -> usize:
    count: mutable usize = 0
    for row in rows |count, owner, low, high|:
        count <- count + 1 if row.scope == owner and row.offset >= low and row.offset < high
    return count

def emit_ast_using_range(buffer: mutable darray[u8]&, rows: darray[EmitAstUsing]&, owner: sview, low: u32, high: u32, level: i64) -> void can[Abort.Panic, Memory.Allocate]:
    for row in rows |buffer, owner, low, high, level|:
        if row.visible and row.scope == owner and row.offset >= low and row.offset < high:
            emit_ast_indent(buffer, level)
            emit_tokens_push_sview(buffer, "using ")
            emit_module_display_name(buffer, row.target, 0)
            emit_tokens_push_sview(buffer, "\n")

# Find the matching lexical DEDENT, which distinguishes reopened modules
# with the same qualified name and remains stable across #line directives.
def emit_ast_module_end(tokens: darray[Lexer::Token]&, start: u32) -> u32:
    started: mutable bool = false
    header_seen: mutable bool = false
    depth: mutable i64 = 0
    for token in tokens |started, header_seen, depth, start|:
        continue if token.start < start
        if not header_seen:
            continue if token.kind == Lexer::TokenKind.Indent or token.kind == Lexer::TokenKind.Dedent or token.kind == Lexer::TokenKind.Newline
            header_seen <- true
        if token.kind == Lexer::TokenKind.Indent:
            started <- true
            depth <- depth + 1
        elif token.kind == Lexer::TokenKind.Dedent and started:
            depth <- depth - 1
            return token.start if depth == 0
    return 4294967295.u32()

# A static branch is a declaration boundary even though its imports retain
# the enclosing module name in the parser's annotation table.
def emit_ast_using_in_static_branch(row: EmitAstUsing, declarations: darray[Ast::Decl]&, tokens: darray[Lexer::Token]&) -> bool can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |row, tokens|:
        kind: i64 = emit_ast_static_branch_kind(declaration, tokens) can Global{Read,Write}
        if kind > 0:
            start: u32 = ast_decl_offset(declaration)
            end: u32 = emit_ast_module_end(tokens, start)
            return true if row.offset >= start and row.offset < end
    return false

def emit_ast_direct_using_count(rows: darray[EmitAstUsing]&, owner: sview, low: u32, high: u32, declarations: darray[Ast::Decl]&, tokens: darray[Lexer::Token]&) -> usize can[Abort.Panic, Memory.Allocate]:
    count: mutable usize = 0
    for row in rows |count, owner, low, high, declarations, tokens|:
        if row.scope == owner and row.offset >= low and row.offset < high and not (emit_ast_using_in_static_branch(row, declarations, tokens) can Global{Read,Write}):
            count <- count + 1
    return count

def emit_ast_direct_using_range(buffer: mutable darray[u8]&, rows: darray[EmitAstUsing]&, owner: sview, low: u32, high: u32, level: i64, declarations: darray[Ast::Decl]&, tokens: darray[Lexer::Token]&) -> void can[Abort.Panic, Memory.Allocate]:
    for row in rows |buffer, owner, low, high, level, declarations, tokens|:
        if row.visible and row.scope == owner and row.offset >= low and row.offset < high and not (emit_ast_using_in_static_branch(row, declarations, tokens) can Global{Read,Write}):
            emit_ast_indent(buffer, level)
            emit_tokens_push_sview(buffer, "using ")
            emit_module_display_name(buffer, row.target, 0)
            emit_tokens_push_sview(buffer, "\n")
