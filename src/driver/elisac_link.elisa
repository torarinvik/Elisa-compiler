# Driver — LINKING an executable: the runtime object, the link flags, and the callback fallback
# stub a unit that declares no callback still needs.




# The emit modes this driver actually implements. stage0 has more; claiming them here by
# silently falling through to the object path would be worse than saying no.
# `-emit exe`: compile to a temporary object, then LINK it against the runtime with the
# host clang, plus any -link/-L/-l the caller passed. Linking is host tooling — stage0 has
# no `exe` mode of its own; this matches what scripts/elisac_stage1.sh does, moved into the
# compiler so a CLI user gets a runnable binary without the wrapper.
def write_executable_callback_fallback(path: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    source: mutable darray[u8] = []
    emit_tokens_push_sview(&source, "#include <stddef.h>\n#include <stdint.h>\n#include <stdlib.h>\n\n")
    # Android NDK headers expose va_copy/va_end as macros, which would rewrite
    # these compatibility function definitions into builtin calls.
    emit_tokens_push_sview(&source, "#ifdef va_copy\n#undef va_copy\n#endif\n#ifdef va_end\n#undef va_end\n#endif\n")
    # The runtime deliberately leaves these optional host hooks unresolved. Weak definitions
    # make a normal executable self-contained while allowing an embedding application's strong
    # callback implementation to override the fallback without a duplicate-symbol failure.
    emit_tokens_push_sview(&source, "#if defined(__GNUC__) || defined(__clang__)\n#define ELISA_WEAK __attribute__((weak))\n#else\n#define ELISA_WEAK\n#endif\n")
    emit_tokens_push_sview(&source, "ELISA_WEAK uint32_t elisa_profile_allocation_negotiate(uint32_t version) { (void)version; return 0; }\n")
    emit_tokens_push_sview(&source, "ELISA_WEAK uint32_t elisa_profile_region_layout_negotiate(uint32_t version) { (void)version; return 0; }\n")
    emit_tokens_push_sview(&source, "ELISA_WEAK void elisa_profile_region_layout_v1(uintptr_t arena, size_t region, uintptr_t header, uintptr_t data, size_t capacity) { (void)arena; (void)region; (void)header; (void)data; (void)capacity; }\n")
    emit_tokens_push_sview(&source, "ELISA_WEAK void elisa_profile_allocation_event_v1(uint32_t kind, uintptr_t address, size_t size, uintptr_t old_address, size_t old_size, uintptr_t arena, size_t region) { (void)kind; (void)address; (void)size; (void)old_address; (void)old_size; (void)arena; (void)region; }\n")
    emit_tokens_push_sview(&source, "ELISA_WEAK void *elisa_native_callback_ptr(uint8_t *name) { (void)name; return NULL; }\n")
    emit_tokens_push_sview(&source, "ELISA_WEAK uint32_t elisa_native_callback_call_u32_voidp(uint8_t *name, void *arg, uint32_t fallback) { (void)name; (void)arg; return fallback; }\n")
    emit_tokens_push_sview(&source, "ELISA_WEAK int32_t elisa_native_callback_call_i32_voidp(uint8_t *name, void *arg, int32_t fallback) { (void)name; (void)arg; return fallback; }\n")
    emit_tokens_push_sview(&source, "ELISA_WEAK uintptr_t elisa_native_callback_call_usize_voidp(uint8_t *name, void *arg, uintptr_t fallback) { (void)name; (void)arg; return fallback; }\n")
    emit_tokens_push_sview(&source, "ELISA_WEAK intptr_t elisa_native_callback_call_isize_voidp(uint8_t *name, void *arg, intptr_t fallback) { (void)name; (void)arg; return fallback; }\n")
    emit_tokens_push_sview(&source, "ELISA_WEAK uint32_t elisa_native_callback_spawn_join_u32_voidp(uint8_t *name, void *arg, uint32_t fallback) { (void)name; (void)arg; return fallback; }\n")
    emit_tokens_push_sview(&source, "ELISA_WEAK void *elisa_native_callback_context_new_u32_voidp(uint8_t *name, void *arg, uint32_t fallback) { (void)name; (void)arg; (void)fallback; return NULL; }\n")
    emit_tokens_push_sview(&source, "ELISA_WEAK void *elisa_native_callback_context_entry_u32_voidp(void) { return NULL; }\n")
    emit_tokens_push_sview(&source, "ELISA_WEAK int32_t elisa_native_callback_context_start_u32_voidp(void *ctx, uintptr_t *thread) { (void)ctx; (void)thread; return -1; }\n")
    emit_tokens_push_sview(&source, "ELISA_WEAK uint32_t elisa_native_callback_context_join_u32_voidp(uintptr_t handle, void *ctx, uint32_t fallback) { (void)handle; (void)ctx; return fallback; }\n")
    emit_tokens_push_sview(&source, "ELISA_WEAK uint32_t elisa_native_callback_context_spawn_join_u32_voidp(void *ctx, uint32_t fallback) { (void)ctx; return fallback; }\n")
    emit_tokens_push_sview(&source, "ELISA_WEAK uint32_t elisa_native_callback_context_result_u32(void *ctx, uint32_t fallback) { (void)ctx; return fallback; }\n")
    emit_tokens_push_sview(&source, "ELISA_WEAK void elisa_native_callback_context_free(void *ctx) { (void)ctx; }\n")
    # va_list is an ARRAY type on x86-64 SysV (and a by-reference struct on AArch64 Linux): the
    # `void *` an Elisa caller passes is a pointer to the caller's live state, so returning it
    # aliases the original and a vsnprintf over the "copy" consumes the original's arguments.
    # Copy into fresh storage with the real __builtin_va_copy; va_end releases it.
    emit_tokens_push_sview(&source, "#if (defined(__x86_64__) && !defined(_WIN32)) || (defined(__aarch64__) && !defined(__APPLE__) && !defined(_WIN32))\n")
    emit_tokens_push_sview(&source, "#define ELISA_VA_LIST_BY_REF 1\n")
    emit_tokens_push_sview(&source, "#endif\n")
    emit_tokens_push_sview(&source, "ELISA_WEAK void *va_copy(void *source) {\n")
    emit_tokens_push_sview(&source, "#ifdef ELISA_VA_LIST_BY_REF\n")
    emit_tokens_push_sview(&source, "  __builtin_va_list *copy = (__builtin_va_list *)malloc(sizeof(__builtin_va_list));\n")
    emit_tokens_push_sview(&source, "  if (copy == NULL) abort();\n")
    emit_tokens_push_sview(&source, "  __builtin_va_copy(*copy, *(__builtin_va_list *)source);\n")
    emit_tokens_push_sview(&source, "  return (void *)copy;\n")
    emit_tokens_push_sview(&source, "#else\n")
    emit_tokens_push_sview(&source, "  return source;\n")
    emit_tokens_push_sview(&source, "#endif\n")
    emit_tokens_push_sview(&source, "}\n")
    emit_tokens_push_sview(&source, "ELISA_WEAK void va_end(void *argument) {\n")
    emit_tokens_push_sview(&source, "#ifdef ELISA_VA_LIST_BY_REF\n")
    emit_tokens_push_sview(&source, "  if (argument != NULL) { __builtin_va_end(*(__builtin_va_list *)argument); free(argument); }\n")
    emit_tokens_push_sview(&source, "#else\n")
    emit_tokens_push_sview(&source, "  (void)argument;\n")
    emit_tokens_push_sview(&source, "#endif\n")
    emit_tokens_push_sview(&source, "}\n")
    return write_file_bytes(path, source)




def append_native_link_driver(command: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    # The host linker driver: ELISA_CLANG (the LLVM-matched clang the wrapper and the gate
    # already select) when set, else whatever `clang` is on PATH — Apple's links ordinary
    # objects fine. This is the same link line the wrapper used to run from bash for
    # `-emit exe` (§4.3); the wrapper now passes `exe` through to here.
    clang_storage: mutable darray[u8] = []
    if env_value("ELISA_CLANG", &clang_storage):
        carchive_push_quoted(command, clang_storage)
    else:
        for clang_index in 0..<sview_len("clang") |command|:
            command.push(sview_at("clang", clang_index))
    # Linux runtime objects are not PIC; GNU/LLVM linkers also use a different
    # dead-section option from Apple's linker. Never try Darwin flags on Linux.
    static if ELISA_TARGET_OS_LINUX:
        emit_tokens_push_sview(command, " -fno-builtin -pthread -no-pie -Wl,--gc-sections -o ")
    static else:
        emit_tokens_push_sview(command, " -fno-builtin -Wl,-dead_strip -o ")


def append_native_link_libraries(command: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
    # Keep libraries after the input objects for linkers with left-to-right
    # resolution. Darwin provides these math symbols through libSystem.
    static if ELISA_TARGET_OS_LINUX:
        emit_tokens_push_sview(command, " -lm")


def link_executable(object_path: darray[u8]&, exe_path: darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    command: mutable darray[u8] = []
    append_native_link_driver(&command)
    carchive_push_quoted(&command, exe_path)
    command.push(32)
    carchive_push_quoted(&command, object_path)
    command.push(32)
    # The runtime object. ELISA_STAGE1_RUNTIME_OBJ overrides the repo-relative default so a
    # caller outside the tree can still link.
    # The runtime object: ELISA_RUNTIME_OBJ is the name the gate, the wrapper and the docs
    # use; ELISA_STAGE1_RUNTIME_OBJ was this function's own older spelling and still works;
    # then the repo-relative default for a caller inside the tree.
    runtime_storage: mutable darray[u8] = []
    if not env_value("ELISA_RUNTIME_OBJ", &runtime_storage):
        if not env_value("ELISA_STAGE1_RUNTIME_OBJ", &runtime_storage):
            for default_index in 0..<sview_len("build/runtime/elisacore_runtime.o") |runtime_storage|:
                runtime_storage.push(sview_at("build/runtime/elisacore_runtime.o", default_index))
    carchive_push_quoted(&command, runtime_storage)
    callback_fallback_path: mutable darray[u8] = []
    emit_tokens_push_sview(&callback_fallback_path, "/tmp/elisa-stage1-callback-")
    append_decimal(&callback_fallback_path, elisa_stage1_getpid().u32())
    emit_tokens_push_sview(&callback_fallback_path, ".c")
    if not write_executable_callback_fallback(&callback_fallback_path):
        callback_failure_object_c: mutable darray[u8] = []
        for object_index in 0..<object_path.count |callback_failure_object_c, object_path|:
            callback_failure_object_c.push(object_path[object_index])
        callback_failure_object_c.push(0)
        callback_failure_object_cstr: cstr = (&callback_failure_object_c[0]).cast[cstr] can Unsafe.PointerCast
        _ = unlink(callback_failure_object_cstr)
        return 8
    command.push(32)
    carchive_push_quoted(&command, callback_fallback_path)
    append_native_link_libraries(&command)
    link_storage: mutable darray[u8] = []
    if env_value("ELISA_STAGE1_LINK", &link_storage):
        command.push(32)
        for link_index in 0..<link_storage.count |command, link_storage|:
            command.push(link_storage[link_index])
    command.push(0)
    command_c: cstr = (&command[0]).cast[cstr] can Unsafe.PointerCast
    status: i64 = system_hiding_line_map(command_c)
    callback_cleanup_c: mutable darray[u8] = []
    for callback_index in 0..<callback_fallback_path.count |callback_cleanup_c, callback_fallback_path|:
        callback_cleanup_c.push(callback_fallback_path[callback_index])
    callback_cleanup_c.push(0)
    callback_cleanup_cstr: cstr = (&callback_cleanup_c[0]).cast[cstr] can Unsafe.PointerCast
    _ = unlink(callback_cleanup_cstr)
    object_cleanup_c: mutable darray[u8] = []
    for object_index in 0..<object_path.count |object_cleanup_c, object_path|:
        object_cleanup_c.push(object_path[object_index])
    object_cleanup_c.push(0)
    object_cleanup_cstr: cstr = (&object_cleanup_c[0]).cast[cstr] can Unsafe.PointerCast
    _ = unlink(object_cleanup_cstr)
    return 0 if status == 0 else 8


# The verifier rejected the module (its own diagnostic is already on stderr): say so and
# fail with status 2, writing nothing. Never hand malformed CFG to the optimizer or emitter.
def report_invalid_llvm_ir() -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    verification_error: mutable darray[u8] = []
    emit_tokens_push_sview(verification_error, "error: backend generated invalid LLVM IR; refusing to optimize or emit\n")
    verification_error.push(10)
    write_stderr(verification_error)
    return 2


# The mode main's final `else` serves: a plain object at the requested path.
def emit_mode_is_plain_object() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    false return if emit_llvm_requested()
    false return if emit_mode_is("bc") or emit_mode_is("exe") or emit_mode_is("pymodule-so") or emit_mode_is("wasm")
    return true


# Every driver `system` call goes through here. The include line map can outgrow one exec
# string, and `system` then fails with E2BIG at the shell's own exec (a `VAR=` prefix in the
# command cannot help); no child the driver runs reads it, so it is hidden for the call.
def system_hiding_line_map(command: cstr) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    line_map: mutable darray[u8] = []
    line_map_hidden: bool = Lexer::line_map_suspend(&line_map)
    status: i64 = system(command)
    Lexer::line_map_resume(&line_map, line_map_hidden)
    return status
