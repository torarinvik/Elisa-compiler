# The parse-error renderer (moved out of elisac_diagnostics.elisa, 2026-09-07): it now
# spells token kinds through emit_tokens_kind_name, an out-param helper that must be
# DEFINED before its caller (region inference; see the file-size-refactor-traps note),
# so this file is included after elisac_emit_tokens.elisa.
#
# stage0's spelling of a token KIND in `expected X, got Y`: `newline` (lower-case, alone),
# EOF/INDENT/DEDENT/IDENT/INT/FLOAT/HEX/STRING upper-case, every keyword and punctuation
# token as its own text. A found literal or identifier is `KIND("text")`.
def push_parse_token_kind(line_buffer: mutable darray[u8]&, kind: TokenKind, storage: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    # emit_tokens_kind_name is keyed by the EMIT-TOKENS code (its own numbering), not by the
    # TokenKind ordinal: passing the ordinal spelled a comma as `(`, so every `got X` in a
    # parse error drifted once the two numberings diverged.
    name: sview = "newline" if kind == TokenKind.Newline else emit_tokens_kind_name(emit_tokens_kind_code(kind) - 1, storage)
    for name_index in 0..<sview_len(name) |line_buffer, name|:
        line_buffer.push(sview_at(name, name_index))

def push_parse_found_token(line_buffer: mutable darray[u8]&, failure: Ast::ParseError&, storage: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    push_parse_token_kind(line_buffer, failure.got_kind, storage)
    is_literal_kind: bool = failure.got_kind == TokenKind.Ident or failure.got_kind == TokenKind.IntLit or failure.got_kind == TokenKind.FloatLit or failure.got_kind == TokenKind.HexLit or failure.got_kind == TokenKind.StringLit
    if is_literal_kind:
        line_buffer.push(40)                              # '('
        line_buffer.push(34)                              # '"'
        for context_index in 0..<sview_len(failure.context) |line_buffer, failure|:
            line_buffer.push(sview_at(failure.context, context_index))
        line_buffer.push(34)
        line_buffer.push(41)                              # ')'

# Append a plain sview to the line under construction.
def push_parse_text(line_buffer: mutable darray[u8]&, text: sview) -> void can[Abort.Panic, Memory.Allocate]:
    for text_index in 0..<sview_len(text) |line_buffer, text|:
        line_buffer.push(sview_at(text, text_index))

# The sentences that NAME something. Each is composed here, from the source views the
# parser recorded, so the parser never has to own a message buffer. Returns false when the
# failure is not one of them.
def push_parse_named_sentence(line_buffer: mutable darray[u8]&, failure: Ast::ParseError&, storage: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    if failure.kind == Ast::ParseErrorKind.RemovedRegionParamSpelling:
        push_parse_text(line_buffer, "region-param spelling `region ")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "` has been removed; use `@")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "`")
        return true
    if failure.kind == Ast::ParseErrorKind.ModulePathDotSeparator:
        push_parse_text(line_buffer, "module paths are separated by `::`, not `.`; write `")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "`")
        return true
    if failure.kind == Ast::ParseErrorKind.VisibilitySectionAtTopLevel:
        push_parse_text(line_buffer, "visibility section \"")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, ":\" is only valid inside declaration blocks")
        return true
    if failure.kind == Ast::ParseErrorKind.RebindWithCapture:
        push_parse_text(line_buffer, "`rebind` and a `|capture|` header may not appear on the same construct (docs/119 E9); make \"")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "\" a rebind target instead")
        return true
    if failure.kind == Ast::ParseErrorKind.LoopHeaderCaptureTwice:
        push_parse_text(line_buffer, "loop header captures \"")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "\" twice (docs/119 §6.3)")
        return true
    if failure.kind == Ast::ParseErrorKind.LoopHeaderDeclAndCapture:
        push_parse_text(line_buffer, "loop header both declares and captures \"")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "\" (docs/119 §6.3)")
        return true
    if failure.kind == Ast::ParseErrorKind.DuplicateGenericParam:
        push_parse_text(line_buffer, "duplicate function generic parameter \"")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "\"")
        return true
    if failure.kind == Ast::ParseErrorKind.StructStateMarkerList:
        push_parse_text(line_buffer, "struct state parameter declaration must use only [?] placeholders, got ")
        push_parse_text(line_buffer, failure.detail)
        return true
    if failure.kind == Ast::ParseErrorKind.EnsuresReturnNeedsBoolLiteral:
        push_parse_text(line_buffer, "ensures return condition expects true or false, got ")
        push_parse_found_token(line_buffer, failure, storage)
        return true
    if failure.kind == Ast::ParseErrorKind.WhenArmOverlap:
        push_parse_text(line_buffer, "arm (")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, ") overlaps arm (")
        push_parse_text(line_buffer, failure.detail2)
        push_parse_text(line_buffer, ") at line ")
        append_decimal(line_buffer, source_line_of(failure.detail_num))
        push_parse_text(line_buffer, "; `when` arms must be disjoint")
        return true
    if failure.kind == Ast::ParseErrorKind.WhenDuplicateDefaultRow:
        push_parse_text(line_buffer, "duplicate `_` default row (first at line ")
        append_decimal(line_buffer, source_line_of(failure.detail_num))
        push_parse_text(line_buffer, "); `when` arms must be disjoint")
        return true
    if failure.kind == Ast::ParseErrorKind.WhenColumnCount:
        push_parse_text(line_buffer, "`when` arm has ")
        append_decimal(line_buffer, failure.detail_num)
        push_parse_text(line_buffer, " column(s) but the scrutinee has ")
        append_decimal(line_buffer, failure.detail_num2)
        return true
    if failure.kind == Ast::ParseErrorKind.ForHeaderTrailingTokens:
        push_parse_text(line_buffer, "unexpected trailing tokens in for-loop header, starting at ")
        push_parse_found_token(line_buffer, failure, storage)
        return true
    if failure.kind == Ast::ParseErrorKind.ThreadSlotNotAParameter:
        push_parse_text(line_buffer, "declared lmut return slot \"")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "\" does not name a parameter")
        return true
    if failure.kind == Ast::ParseErrorKind.ThreadSlotNotLmut:
        push_parse_text(line_buffer, "declared lmut return slot \"")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "\" must thread an `lmut` parameter, but \"")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "\" is not lmut")
        return true
    if failure.kind == Ast::ParseErrorKind.ThreadReturnTupleArity:
        push_parse_text(line_buffer, "a function with declared lmut threading must return a literal tuple of all ")
        append_decimal(line_buffer, failure.detail_num)
        push_parse_text(line_buffer, " declared slots (threaded params in their declared positions)")
        return true
    if failure.kind == Ast::ParseErrorKind.ThreadReturnSlotExpr:
        push_parse_text(line_buffer, "threaded return slot ")
        append_decimal(line_buffer, failure.detail_num)
        push_parse_text(line_buffer, " must be exactly the lmut parameter \"")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "\"")
        return true
    if failure.kind == Ast::ParseErrorKind.GuestOverlayFieldNeedsOffset:
        push_parse_text(line_buffer, "guest overlay field \"")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "\" needs an explicit offset: `")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, ": ")
        push_parse_text(line_buffer, failure.detail2)
        push_parse_text(line_buffer, " at OFFSET`")
        return true
    if failure.kind == Ast::ParseErrorKind.MismatchedWithBindings:
        push_parse_text(line_buffer, "every alternative of a `with`-arm must bind the same constants, so the shared body can read them uniformly")
        if sview_len(failure.detail) > 0:
            push_parse_text(line_buffer, "; this alternative is missing `")
            push_parse_text(line_buffer, failure.detail)
            push_parse_text(line_buffer, "`")
        if sview_len(failure.detail2) > 0:
            push_parse_text(line_buffer, "; this alternative also binds `")
            push_parse_text(line_buffer, failure.detail2)
            push_parse_text(line_buffer, "` which the first alternative does not")
        return true
    # The machine laws (docs/123 `machine over`, docs/125 `machine from`). stage0 prints the
    # names it interpolates with Go's %q, i.e. double-quoted, and the counts bare.
    if failure.kind == Ast::ParseErrorKind.MachineLaw:
        push_parse_text(line_buffer, failure.detail)
        return true
    if failure.kind == Ast::ParseErrorKind.MachineStateDeclaredTwice:
        push_parse_text(line_buffer, "machine state \"")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "\" declared twice")
        return true
    if failure.kind == Ast::ParseErrorKind.MachineStateRepeatsField:
        push_parse_text(line_buffer, "machine state \"")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "\" repeats payload field \"")
        push_parse_text(line_buffer, failure.detail2)
        push_parse_text(line_buffer, "\"")
        return true
    if failure.kind == Ast::ParseErrorKind.MachineStartUndeclaredState:
        push_parse_text(line_buffer, "machine `start` names undeclared state \"")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "\"")
        return true
    if failure.kind == Ast::ParseErrorKind.MachineStartArity:
        push_parse_text(line_buffer, "machine `start ")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "` expects ")
        append_decimal(line_buffer, failure.detail_num)
        push_parse_text(line_buffer, " payload argument(s), got ")
        append_decimal(line_buffer, failure.detail_num3)
        return true
    if failure.kind == Ast::ParseErrorKind.MachineArmNoDecision:
        push_parse_text(line_buffer, "machine arm \"")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "\" makes no decision — end it with `-> State`, `return`, or `break` (docs/123 §5)")
        return true
    if failure.kind == Ast::ParseErrorKind.MachineTransitionUndeclaredState:
        push_parse_text(line_buffer, "machine transition `-> ")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "` names undeclared state")
        return true
    if failure.kind == Ast::ParseErrorKind.MachineTransitionArity:
        push_parse_text(line_buffer, "machine transition `-> ")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "` expects ")
        append_decimal(line_buffer, failure.detail_num)
        push_parse_text(line_buffer, " payload argument(s), got ")
        append_decimal(line_buffer, failure.detail_num3)
        return true
    if failure.kind == Ast::ParseErrorKind.MachineStateNoArms:
        push_parse_text(line_buffer, "machine state \"")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "\" has no arms — every state must handle every input (docs/123 §5)")
        return true
    if failure.kind == Ast::ParseErrorKind.MachineArmUnreachable:
        push_parse_text(line_buffer, "machine arm ")
        append_decimal(line_buffer, failure.detail_num)
        push_parse_text(line_buffer, " for state \"")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "\" is unreachable — an earlier arm already matches every input (docs/123 §5)")
        return true
    if failure.kind == Ast::ParseErrorKind.MachineArmRepeatsInput:
        push_parse_text(line_buffer, "machine arm for state \"")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "\" repeats input ")
        push_parse_text(line_buffer, failure.detail2)
        push_parse_text(line_buffer, " — an earlier arm already handles it, so this arm is unreachable (docs/123 §5)")
        return true
    if failure.kind == Ast::ParseErrorKind.MachineStateNotTotal:
        push_parse_text(line_buffer, "machine state \"")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "\" does not cover all inputs — its final arm must be the unguarded wildcard `")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, ", _:` (docs/123 §5)")
        return true
    if failure.kind == Ast::ParseErrorKind.MachineArmAssignsPayloadField:
        push_parse_text(line_buffer, "machine arm assigns payload field \"")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "\" directly — payloads change only through `-> State(args)` transitions (docs/123 §5)")
        return true
    if failure.kind == Ast::ParseErrorKind.MachineArmForeignState:
        push_parse_text(line_buffer, "machine arms may only mutate the driven resource (")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, ") — \"")
        push_parse_text(line_buffer, failure.detail2)
        push_parse_text(line_buffer, "\" is foreign state (docs/123 §5)")
        return true
    if failure.kind == Ast::ParseErrorKind.MachineFromEnumMismatch:
        push_parse_text(line_buffer, "machine state reference uses enum \"")
        push_parse_text(line_buffer, failure.detail)
        push_parse_text(line_buffer, "\", but this machine uses enum \"")
        push_parse_text(line_buffer, failure.detail2)
        push_parse_text(line_buffer, "\"")
        return true
    return false

def report_parse_error(failure: Ast::ParseError) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    line_buffer: mutable darray[u8] = []
    push_diagnostic_location(&line_buffer, failure.line)
    line_buffer.push(58)                                  # ':'
    append_decimal(line_buffer, failure.column)
    # A parse error that carries an END column prints stage0's full `COL-COL` span. Most do
    # not yet (ParseError has no Pos), so they degrade to the bare column exactly as before.
    if failure.detail_num2 > 0:
        line_buffer.push(45)                              # '-'
        append_decimal(line_buffer, failure.detail_num2)
    line_buffer.push(58)                                  # ':'
    line_buffer.push(32)                                  # ' '
    named_storage: mutable darray[u8] = []
    if push_parse_named_sentence(&line_buffer, failure, &named_storage):
        line_buffer.push(10)
        write_stderr(line_buffer)
        return
    if failure.kind == Ast::ParseErrorKind.ExpectedDeclaration:
        top_storage: mutable darray[u8] = []
        for head_index in 0..<sview_len("unexpected token ") |line_buffer|:
            line_buffer.push(sview_at("unexpected token ", head_index))
        push_parse_found_token(line_buffer, failure, top_storage)
        for tail_index in 0..<sview_len(" at top level") |line_buffer|:
            line_buffer.push(sview_at(" at top level", tail_index))
        line_buffer.push(10)
        write_stderr(line_buffer)
        return
    if failure.has_expected:
        kind_storage: mutable darray[u8] = []
        for expected_index in 0..<sview_len("expected ") |line_buffer|:
            line_buffer.push(sview_at("expected ", expected_index))
        push_parse_token_kind(line_buffer, failure.expected_kind, kind_storage)
        for got_index in 0..<sview_len(", got ") |line_buffer|:
            line_buffer.push(sview_at(", got ", got_index))
        push_parse_found_token(line_buffer, failure, kind_storage)
        line_buffer.push(10)
        write_stderr(line_buffer)
        return
    text: sview = match failure.kind:
        Ast::ParseErrorKind.ExpectedToken: "expected a different token"
        Ast::ParseErrorKind.UnexpectedToken: "unexpected token"
        Ast::ParseErrorKind.ExpectedDeclaration: "expected a declaration"
        Ast::ParseErrorKind.ExpectedExpression: "expected an expression"
        Ast::ParseErrorKind.MismatchedWithBindings: "or-arm alternatives bind different constants"
        Ast::ParseErrorKind.SubmitOutsidePool: "submit outside a pool"
        Ast::ParseErrorKind.Removed: failure.context
        _: "parse error"
    for text_index in 0..<sview_len(text) |line_buffer, text|:
        line_buffer.push(sview_at(text, text_index))
    # A Removed error's context IS the message; nothing is "near" it.
    if sview_len(failure.context) > 0 and failure.kind != Ast::ParseErrorKind.Removed:
        for prefix_index in 0..<sview_len(" near \"") |line_buffer|:
            line_buffer.push(sview_at(" near \"", prefix_index))
        for context_index in 0..<sview_len(failure.context) |line_buffer, failure|:
            line_buffer.push(sview_at(failure.context, context_index))
        line_buffer.push(34)                              # '"'
    line_buffer.push(10)
    write_stderr(line_buffer)
