# `-emit pymodule` — the SUPPORT policy for aggregates: which darray, view and nested-darray
# shapes may cross as INPUTS (borrowed, temporary buffers) and which as RETURNS (owned copies).


# Input-only struct aggregates use the same borrowed, temporary-buffer convention as ordinary
# darray parameters. Text values are copied into the caller arena, while opaque Python objects
# are retained in a small per-call owner table until the native call returns.
def pymodule_struct_darray_element_supported(file: Ast::File&, element_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    if pymodule_is_dict_type(element_name):
        return pymodule_nested_dict_values_supported_in_type(file, element_name, 0.usize())
    # A darray may contain read-only views as elements.  Each view owns a temporary
    # element buffer for the duration of the native call, so validate the complete
    # view bridge instead of treating `view[T]` as an opaque named struct.
    if pymodule_is_view_type(element_name):
        return pymodule_view_input_supported(file, element_name)
    if pymodule_is_darray_type(element_name):
        nested_element_name: sview = pymodule_darray_element_name(element_name)
        # Struct fields use the same recursive ElisaDArray ABI as top-level parameters.  Walk
        # the element chain instead of stopping after one nested level, but retain the bridge's
        # explicit eight-level guard so generated helpers remain bounded and diagnostics stay
        # deterministic for pathological types.
        return false if pymodule_darray_nesting_depth(element_name) >= 8.usize()
        # The recursive list helper's innermost converter currently handles scalar/text/object
        # and named-struct leaves.  A set or dictionary nested below another list has a different
        # aggregate ABI; keep that shape diagnostic-only rather than accepting it and emitting a
        # scalar cast in the innermost loop.
        return false if pymodule_is_set_type(nested_element_name) or pymodule_is_dict_type(nested_element_name)
        return pymodule_struct_darray_element_supported(file, nested_element_name)
    return true if element_name == "i8" or element_name == "i16" or element_name == "i32" or element_name == "i64" or element_name == "int" or element_name == "isize" or element_name == "char" or element_name == "u8" or element_name == "u16" or element_name == "u32" or element_name == "u64" or element_name == "usize" or element_name == "uintptr" or element_name == "f32" or element_name == "f64" or element_name == "bool" or element_name == "cstr" or element_name == "cstr?" or element_name == "sview" or element_name == "sview?" or element_name == "py::Object" or element_name == "py::Object?" or pymodule_darray_element_is_optional_scalar(element_name) or (pymodule_is_set_type(element_name) and pymodule_set_element_supported(pymodule_set_element_name(element_name)))
    return pymodule_struct_input_supported(file, element_name)




def pymodule_struct_darray_return_element_supported(file: Ast::File&, element_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    if pymodule_is_view_type(element_name):
        return pymodule_view_return_supported(file, element_name)
    return true if pymodule_struct_darray_element_supported(file, element_name)
    return element_name == "py::Object" or element_name == "py::Object?"




# `ElisaView` is only a two-word pointer/length carrier.  The Python shim can materialize its
# elements directly when the element has a scalar/text/object C representation, or through the
# dedicated named-struct view helpers.  Treating every syntactically valid `view[T]` as supported
# used to let `view[dict[...]]` and `view[set[...]]` through validation; code generation then
# referenced helpers that were never emitted (or fell through to an empty C element type).
def pymodule_view_input_supported(file: Ast::File&, type_name: sview, depth: usize = 0.usize()) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if depth > 32.usize()
    return false if not pymodule_is_view_type(type_name)
    element_name: sview = pymodule_view_element_name(type_name)
    return true if pymodule_darray_c_element_type(element_name) != ""
    return pymodule_struct_input_supported_depth(file, element_name, depth + 1.usize())




def pymodule_view_return_supported(file: Ast::File&, type_name: sview, depth: usize = 0.usize()) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if depth > 32.usize()
    return false if not pymodule_is_view_type(type_name)
    element_name: sview = pymodule_view_element_name(type_name)
    return true if pymodule_darray_c_element_type(element_name) != ""
    return pymodule_struct_return_supported_depth(file, element_name, depth + 1.usize())




def pymodule_view_bridge_supported(file: Ast::File&, type_name: sview, depth: usize = 0.usize()) -> bool can[Abort.Panic, Memory.Allocate]:
    return pymodule_view_input_supported(file, type_name, depth) and pymodule_view_return_supported(file, type_name, depth)




# Top-level nested darrays use the same ElisaDArray ABI at every level, but need their own
# lifetime-bearing conversion helpers in the Python wrapper. Keep the depth walk centralized so
# aliases and direct spellings behave identically, and reject only shapes the recursive emitter
# cannot safely materialize.
def pymodule_darray_nesting_depth(type_name: sview) -> usize can[Abort.Panic, Memory.Allocate]:
    depth: mutable usize = 0
    current: mutable sview = type_name
    while pymodule_is_darray_type(current) and depth < 16.usize() |depth, current|:
        depth <- depth + 1.usize()
        current <- pymodule_darray_element_name(current)
    return depth




def pymodule_darray_leaf_name(type_name: sview) -> sview can[Abort.Panic, Memory.Allocate]:
    current: mutable sview = type_name
    depth: mutable usize = 0
    while pymodule_is_darray_type(current) and depth < 16.usize() |current, depth|:
        current <- pymodule_darray_element_name(current)
        depth <- depth + 1.usize()
    return current




def pymodule_top_level_nested_darray_input_supported(file: Ast::File&, type_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    depth: usize = pymodule_darray_nesting_depth(type_name)
    return false if depth < 2.usize() or depth > 8.usize()
    leaf_name: sview = pymodule_darray_leaf_name(type_name)
    return pymodule_struct_darray_element_supported(file, leaf_name)




def pymodule_top_level_nested_darray_return_supported(file: Ast::File&, type_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    depth: usize = pymodule_darray_nesting_depth(type_name)
    return false if depth < 2.usize() or depth > 8.usize()
    leaf_name: sview = pymodule_darray_leaf_name(type_name)
    return pymodule_struct_darray_return_element_supported(file, leaf_name)




# A top-level darray has two distinct converter families: one-level lists use the ordinary
# element matrix (including named-struct converters), while nested lists use the bounded
# recursive helpers above. Keep this dispatch in one predicate so the manifest, C ABI report,
# and wrapper generator cannot disagree about a shape that would otherwise produce an invalid
# element C type (for example darray[StructWithUnsupportedAggregate]).
def pymodule_top_level_darray_input_supported(file: Ast::File&, type_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if not pymodule_is_darray_type(type_name)
    depth: usize = pymodule_darray_nesting_depth(type_name)
    return pymodule_top_level_nested_darray_input_supported(file, type_name) if depth >= 2.usize()
    return false if depth != 1.usize()
    return pymodule_struct_darray_element_supported(file, pymodule_darray_element_name(type_name))




def pymodule_top_level_darray_return_supported(file: Ast::File&, type_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if not pymodule_is_darray_type(type_name)
    depth: usize = pymodule_darray_nesting_depth(type_name)
    return pymodule_top_level_nested_darray_return_supported(file, type_name) if depth >= 2.usize()
    return false if depth != 1.usize()
    element_name: sview = pymodule_darray_element_name(type_name)
    # The standalone darray return converter calls the full struct return helper for named
    # elements. The input-oriented predicate is intentionally not reused here: a struct may be
    # representable on output even when its input shape differs, and vice versa.
    return pymodule_struct_return_supported(file, element_name) if pymodule_find_struct_in(file.top_decls, element_name) != null
    return pymodule_struct_darray_return_element_supported(file, element_name)




def pymodule_expression_is_nested_darray(expression: Ast::Expr) -> bool can[Abort.Panic]:
    # Cleanup receives the original AST expression rather than an Ast::File, so recognize this
    # one container shape structurally instead of trying to normalize aliases a second time.
    if expression is Expr.Unary(expression_operator, expression_operand, expression_pos):
        return pymodule_expression_is_nested_darray(expression_operand) if expression_operator == Lexer::TokenKind.Mutable or expression_operator == Lexer::TokenKind.Lmut or expression_operator == Lexer::TokenKind.Ampersand else false
    if expression is Expr.Paren(expression_inner, expression_paren_pos):
        return pymodule_expression_is_nested_darray(expression_inner)
    if expression is Expr.Index(expression_head, expression_argument, expression_index_pos):
        if expression_head is Expr.Ident(expression_name, expression_name_pos) and expression_name == "darray":
            if expression_argument is Expr.Index(nested_head, nested_argument, nested_index_pos):
                return pymodule_type_atom_name(nested_head) == "darray" or pymodule_type_atom_name(nested_head) == "set" or pymodule_type_atom_name(nested_head) == "view"
            if expression_argument is Expr.IndexN(nested_head_n, nested_arguments, nested_index_pos_n):
                return (pymodule_type_atom_name(nested_head_n) == "darray" or pymodule_type_atom_name(nested_head_n) == "set" or pymodule_type_atom_name(nested_head_n) == "view") and nested_arguments.count == 1
    if expression is Expr.IndexN(expression_head_n, expression_arguments, expression_index_pos_n):
        if expression_head_n is Expr.Ident(expression_name_n, expression_name_pos_n) and expression_name_n == "darray" and expression_arguments.count == 1:
            nested_argument_n: Ast::Expr = expression_arguments[0]
            if nested_argument_n is Expr.Index(nested_head_n_i, nested_argument_n_i, nested_index_pos_n_i):
                return pymodule_type_atom_name(nested_head_n_i) == "darray" or pymodule_type_atom_name(nested_head_n_i) == "set" or pymodule_type_atom_name(nested_head_n_i) == "view"
            if nested_argument_n is Expr.IndexN(nested_head_n_in, nested_arguments_in, nested_index_pos_n_in):
                return (pymodule_type_atom_name(nested_head_n_in) == "darray" or pymodule_type_atom_name(nested_head_n_in) == "set" or pymodule_type_atom_name(nested_head_n_in) == "view") and nested_arguments_in.count == 1
    return false
