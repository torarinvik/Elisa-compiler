# Canonical spelling for synthesized return/break/continue guards.
extend FmtUnparse:
    public:
        def fmt_guard_conditions(buffer: mutable darray[u8]&, condition: Ast::Expr, indent: i64, tokens: darray[Lexer::Token]&, source: u8&) -> void:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Expr.Binary(left, Lexer::TokenKind.Or, right, _):
                        fmt_guard_conditions(buffer, left, indent, tokens, source) can Global{Read,Write}
                        fmt_guard_conditions(buffer, right, indent, tokens, source) can Global{Read,Write}
                    _:
                        fmt_indent(buffer, indent)
                        fmt_expr(buffer, condition, tokens, source) can Global{Read,Write}
                        buffer.push(10)

        def fmt_control_guard(buffer: mutable darray[u8]&, condition: Ast::Expr, body: darray[Ast::Stmt], alternative: darray[Ast::Stmt], position: Ast::Pos, indent: i64, tokens: darray[Lexer::Token]&, source: u8&) -> bool:
            can Memory.Allocate, Abort.Panic:
                return false if:
                    body.count != 1 or alternative.count != 0
                    fmt_stmt_source_line(body[0]) != position.line
                # Keep permission-bearing headers on the existing formatter path,
                # which preserves and claims their exact grant spans.
                for token in tokens |position, source, tokens|:
                    return false if token.line == position.line and token.kind == Lexer::TokenKind.Ident and Lexer::text_or_empty(token, source, Lexer::token_stream_source_length(tokens)) == "can"
                match body[0]:
                    Stmt.Return(value, _):
                        fmt_indent(buffer, indent)
                        fmt_push(buffer, "return")
                        if value is present:
                            fmt_push(buffer, " ")
                            fmt_expr(buffer, present, tokens, source) can Global{Read,Write}
                    Stmt.Break(label, _) | Stmt.Continue(label, _):
                        fmt_indent(buffer, indent)
                        fmt_push(buffer, "break" if body[0] is Stmt.Break(_, _) else "continue")
                        if label != "":
                            fmt_push(buffer, " '")
                            fmt_push(buffer, label)
                    _:
                        return false
                match condition:
                    Expr.Binary(_, Lexer::TokenKind.Or, _, _):
                        fmt_push(buffer, " if:")
                        buffer.push(10)
                        fmt_guard_conditions(buffer, condition, indent + 4, tokens, source) can Global{Read,Write}
                    _:
                        fmt_push(buffer, " if ")
                        fmt_expr(buffer, condition, tokens, source) can Global{Read,Write}
                        buffer.push(10)
                return true
