# Pure checked predicates shared by the frontend IR reader and its proof target.
const FRONTEND_IR_U32_MAX: u64 = 4294967295
const FRONTEND_IR_SUPPORTED_VERSION: u64 = 2

# Compare in u64, the wire format's length type, after the reader has bounded
# the usize cursor and checked the length's usize conversion.
def frontend_ir_span_length_fits(remaining: u64, length: u64) -> bool:
    ensure result == (length <= remaining)
    return length <= remaining

def frontend_ir_u32_value_fits(value: u64) -> bool:
    ensure result == (value <= FRONTEND_IR_U32_MAX)
    return value <= FRONTEND_IR_U32_MAX

def frontend_ir_count_fits_input(count: u64, input_bytes: u64) -> bool:
    ensure result == (count <= input_bytes)
    return count <= input_bytes

def frontend_ir_root_is_valid(root: u64, node_count: u64) -> bool:
    ensure result == (root > 0 and root <= node_count)
    return root > 0 and root <= node_count

def frontend_ir_version_is_supported(version: u64) -> bool:
    ensure result == (version == FRONTEND_IR_SUPPORTED_VERSION)
    return version == FRONTEND_IR_SUPPORTED_VERSION

def frontend_ir_varint_payload_fits(shift: u64, payload: u64) -> bool:
    ensure result == (shift != 63 or payload <= 1)
    return shift != 63 or payload <= 1

def frontend_ir_varint_continued_shift_fits(shift: u64) -> bool:
    ensure result == (shift <= 63)
    return shift <= 63

def frontend_ir_cursor_step_fits(total: u64, offset: u64) -> bool:
    ensure result == (offset < total)
    ensure result implies offset + 1 <= total
    return offset < total

def frontend_ir_schema_budget_step_fits(depth: u64) -> bool:
    ensure result == (depth > 0)
    ensure result implies depth - 1 < depth
    return depth > 0
