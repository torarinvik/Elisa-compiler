# Closed source-level set of container and builtin type heads in frontend IR v2.
# The IR writer must classify these names exactly: encoding one as a generic named
# type changes the decoded AST shape.
module FrontendIrBuiltinTypeName:
    public:
        def is_builtin_type_name(name: sview) -> bool:
            ensure result == (name == "darray" or name == "view" or name == "sview" or name == "dict" or name == "set" or name == "deque" or name == "array" or name == "slice" or name == "optional")
            can Abort.Panic:
                return when name:
                    "darray" | "view" | "sview" | "dict" | "set" | "deque" | "array" | "slice" | "optional" -> true
                    _ -> false
