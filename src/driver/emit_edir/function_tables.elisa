extend ElisaEDIR:
    private:
        def append_function_descriptor(buffer: mutable darray[u8]&, function_id: u64, entry_instruction: usize, end_instruction_exclusive: usize, position: Ast::Pos, function_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
            name_length: usize = function_name.len
            return false if:
                function_id == ElisaEDIR::Function::NO_ID or name_length == ElisaEDIR::Integer::ZERO.usize() or name_length > ElisaEDIR::Function::MAX_NAME_BYTES
                not position_is_usable(position)
            name_bytes: mutable darray[u8] = []
            for index in 0..<name_length:
                name_bytes.push(function_name[index])
            return false if not source_path_utf8_is_valid(name_bytes)
            append_unsigned_le(buffer, function_id, ElisaEDIR::Binary::U64_WIDTH)
            append_unsigned_le(buffer, entry_instruction.u64(), ElisaEDIR::Binary::U64_WIDTH)
            append_unsigned_le(buffer, end_instruction_exclusive.u64(), ElisaEDIR::Binary::U64_WIDTH)
            append_source_span(buffer, position)
            append_unsigned_le(buffer, name_length.u64(), ElisaEDIR::Binary::U32_WIDTH)
            for index in 0..<name_length:
                buffer.push(name_bytes[index])
            return true



        def append_single_function_table(buffer: mutable darray[u8]&, function_name: sview, function_position: Ast::Pos, instruction_count: u64) -> bool can[Abort.Panic, Memory.Allocate]:
            append_unsigned_le(buffer, ElisaEDIR::Function::SINGLE_DESCRIPTOR_COUNT, ElisaEDIR::Binary::U32_WIDTH)
            return append_function_descriptor(buffer, function_identity(function_name), ElisaEDIR::Function::ENTRY_INSTRUCTION_INDEX, instruction_count.usize(), function_position, function_name)



        def append_function_table(buffer: mutable darray[u8]&, functions: darray[EDIRFunctionPlan]&) -> bool can[Abort.Panic, Memory.Allocate]:
            append_unsigned_le(buffer, functions.count.u64(), ElisaEDIR::Binary::U32_WIDTH)
            for index in 0..<functions.count |buffer, functions|:
                function: EDIRFunctionPlan = functions[index]
                return false if not append_function_descriptor(buffer, function.function_id, function.entry_instruction, function.end_instruction_exclusive, function.source, function.name)
            return true



        def host_effect_flag_value(value: mutable bool&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                return value



        def host_effect_declaration_valid(declaration: Ast::Decl, seen_clock: mutable bool&, seen_random: mutable bool&, seen_console_output: mutable bool&, seen_console_input: mutable bool&, seen_virtual_file_read: mutable bool&, seen_virtual_file_write: mutable bool&, seen_virtual_file_seek: mutable bool&, seen_virtual_file_try_read: mutable bool&, seen_virtual_file_try_write: mutable bool&, seen_virtual_file_try_seek: mutable bool&, seen_virtual_file_try_close: mutable bool&, seen_virtual_file_try_reopen: mutable bool&) -> bool can[Abort.Panic]:
            match declaration:
                Ast::Decl.Extern(name, _, arity, variadic, callable, return_type_name, decorators, _):
                    return false if variadic or not callable or return_type_name != "i64" or decorators.count != ElisaEDIR::HostEffect::NO_OPERANDS
                    if name == ElisaEDIR::HostEffect::CLOCK_OPERATION:
                        return false if arity != ElisaEDIR::HostEffect::NO_ARITY or host_effect_flag_value(seen_clock)
                        seen_clock <- true
                        return true
                    if name == ElisaEDIR::HostEffect::RANDOM_OPERATION:
                        return false if arity != ElisaEDIR::HostEffect::NO_ARITY or host_effect_flag_value(seen_random)
                        seen_random <- true
                        return true
                    if name == ElisaEDIR::HostEffect::CONSOLE_WRITE_BYTE_OPERATION:
                        return false if arity != ElisaEDIR::HostEffect::SINGLE_ARGUMENT_ARITY or host_effect_flag_value(seen_console_output)
                        seen_console_output <- true
                        return true
                    if name == ElisaEDIR::HostEffect::CONSOLE_READ_BYTE_OPERATION:
                        return false if arity != ElisaEDIR::HostEffect::NO_ARITY or host_effect_flag_value(seen_console_input)
                        seen_console_input <- true
                        return true
                    if name == ElisaEDIR::HostEffect::VIRTUAL_FILE_READ_BYTE_OPERATION:
                        return false if arity != ElisaEDIR::HostEffect::SINGLE_ARGUMENT_ARITY or host_effect_flag_value(seen_virtual_file_read)
                        seen_virtual_file_read <- true
                        return true
                    if name == ElisaEDIR::HostEffect::VIRTUAL_FILE_WRITE_BYTE_OPERATION:
                        return false if arity != ElisaEDIR::HostEffect::TWO_ARGUMENT_ARITY or host_effect_flag_value(seen_virtual_file_write)
                        seen_virtual_file_write <- true
                        return true
                    if name == ElisaEDIR::HostEffect::VIRTUAL_FILE_TRY_READ_BYTE_OPERATION:
                        return false if arity != ElisaEDIR::HostEffect::SINGLE_ARGUMENT_ARITY or host_effect_flag_value(seen_virtual_file_try_read)
                        seen_virtual_file_try_read <- true
                        return true
                    if name == ElisaEDIR::HostEffect::VIRTUAL_FILE_TRY_WRITE_BYTE_OPERATION:
                        return false if arity != ElisaEDIR::HostEffect::TWO_ARGUMENT_ARITY or host_effect_flag_value(seen_virtual_file_try_write)
                        seen_virtual_file_try_write <- true
                        return true
                    if name == ElisaEDIR::HostEffect::VIRTUAL_FILE_TRY_SEEK_OPERATION:
                        return false if arity != ElisaEDIR::HostEffect::TWO_ARGUMENT_ARITY or host_effect_flag_value(seen_virtual_file_try_seek)
                        seen_virtual_file_try_seek <- true
                        return true
                    if name == ElisaEDIR::HostEffect::VIRTUAL_FILE_TRY_CLOSE_OPERATION:
                        return false if arity != ElisaEDIR::HostEffect::SINGLE_ARGUMENT_ARITY or host_effect_flag_value(seen_virtual_file_try_close)
                        seen_virtual_file_try_close <- true
                        return true
                    if name == ElisaEDIR::HostEffect::VIRTUAL_FILE_TRY_REOPEN_OPERATION:
                        return false if arity != ElisaEDIR::HostEffect::SINGLE_ARGUMENT_ARITY or host_effect_flag_value(seen_virtual_file_try_reopen)
                        seen_virtual_file_try_reopen <- true
                        return true
                    if name == ElisaEDIR::HostEffect::VIRTUAL_FILE_SEEK_OPERATION:
                        return false if arity != ElisaEDIR::HostEffect::TWO_ARGUMENT_ARITY or host_effect_flag_value(seen_virtual_file_seek)
                        seen_virtual_file_seek <- true
                        return true
                _:
                    pass
            return false



        def host_effect_module_valid(module_name: sview, declarations: darray[Ast::Decl]) -> bool can[Abort.Panic]:
            return false if module_name != ElisaEDIR::HostEffect::MODULE_NAME or declarations.count < ElisaEDIR::HostEffect::MIN_DECLARATIONS or declarations.count > ElisaEDIR::HostEffect::MAX_DECLARATIONS
            seen_clock: mutable bool = false
            seen_random: mutable bool = false
            seen_console_output: mutable bool = false
            seen_console_input: mutable bool = false
            seen_virtual_file_read: mutable bool = false
            seen_virtual_file_write: mutable bool = false
            seen_virtual_file_seek: mutable bool = false
            seen_virtual_file_try_seek: mutable bool = false
            seen_virtual_file_try_reopen: mutable bool = false
            seen_virtual_file_try_close: mutable bool = false
            seen_virtual_file_try_write: mutable bool = false
            seen_virtual_file_try_read: mutable bool = false
            for declaration_index in 0..<declarations.count:
                return false if not host_effect_declaration_valid(declarations[declaration_index], &seen_clock, &seen_random, &seen_console_output, &seen_console_input, &seen_virtual_file_read, &seen_virtual_file_write, &seen_virtual_file_seek, &seen_virtual_file_try_read, &seen_virtual_file_try_write, &seen_virtual_file_try_seek, &seen_virtual_file_try_close, &seen_virtual_file_try_reopen)
            return seen_clock or seen_random or seen_console_output or seen_console_input or seen_virtual_file_read or seen_virtual_file_write or seen_virtual_file_seek or seen_virtual_file_try_read or seen_virtual_file_try_write or seen_virtual_file_try_seek or seen_virtual_file_try_close or seen_virtual_file_try_reopen



        def function_effects_supported(effects: darray[sview]) -> bool:
            return true if effects.count == ElisaEDIR::HostEffect::NO_OPERANDS
            return false if effects.count > ElisaEDIR::Function::MAX_EFFECT_COUNT
            return effects[ElisaEDIR::HostEffect::NO_OPERANDS] == ElisaEDIR::HostEffect::EFFECT_NAME or effects[ElisaEDIR::HostEffect::NO_OPERANDS] == ElisaEDIR::HostEffect::IO_EFFECT_NAME



        def collect_function_plans(file: Ast::File&, functions: mutable darray[EDIRFunctionPlan]&, error_reason: mutable sview&) -> bool can[Abort.Panic, Memory.Allocate]:
            return false if file.top_decls.count == 0 or file.top_decls.count > ElisaEDIR::Function::MAX_TOP_LEVEL_DECLARATIONS
            host_module_seen: mutable bool = false
            for declaration_index in 0..<file.top_decls.count |functions, error_reason|:
                match file.top_decls[declaration_index]:
                    Ast::Decl.Func(function_name, parameters, return_type, body, effects, decorators, function_position):
                        return false if:
                            functions.count >= ElisaEDIR::Function::MAX_COUNT
                            functions.count == ElisaEDIR::Shape::FIRST_TOP_LEVEL_DECLARATION_INDEX and function_name != ElisaEDIR::Function::MAIN_NAME
                            functions.count > ElisaEDIR::Shape::FIRST_TOP_LEVEL_DECLARATION_INDEX and function_name == ElisaEDIR::Function::MAIN_NAME
                            parameters.count != ElisaEDIR::Function::MAIN_PARAMETER_COUNT and parameters.count != ElisaEDIR::Function::HELPER_PARAMETER_COUNT
                            functions.count == ElisaEDIR::Shape::FIRST_TOP_LEVEL_DECLARATION_INDEX and parameters.count != ElisaEDIR::Function::MAIN_PARAMETER_COUNT
                            functions.count > ElisaEDIR::Shape::FIRST_TOP_LEVEL_DECLARATION_INDEX and parameters.count != ElisaEDIR::Function::HELPER_PARAMETER_COUNT
                        if return_type is declared_return_type:
                            match declared_return_type:
                                Ast::Expr.Ident(return_type_name, _):
                                    return false if return_type_name != "i64"
                                _:
                                    return false
                        else:
                            return false
                        return false if:
                            not function_effects_supported(effects) or decorators.count != 0
                            not position_is_usable(function_position)
                        parameter_name: mutable sview = ""
                        if parameters.count == ElisaEDIR::Function::HELPER_PARAMETER_COUNT:
                            parameter: Ast::ParamDecl = parameters[ElisaEDIR::Function::ONLY_PARAMETER_INDEX]
                            match parameter.type_expression:
                                Ast::Expr.Ident(parameter_type_name, _):
                                    return false if parameter_type_name != "i64"
                                _:
                                    return false
                            return false if parameter.name == "" or parameter.name == "_" or parameter.is_mutable or parameter.has_default or parameter.is_affine
                            parameter_name <- parameter.name
                        current_id: u64 = function_identity(function_name)
                        for prior_index in 0..<functions.count:
                            return false if functions[prior_index].name == function_name or functions[prior_index].function_id == current_id
                        functions.push(EDIRFunctionPlan{name: function_name, parameter_name: parameter_name, body: body, source: function_source_span(function_position, body, file.enum_annotations), entry_instruction: ElisaEDIR::Function::ENTRY_INSTRUCTION_INDEX, end_instruction_exclusive: ElisaEDIR::Function::ENTRY_INSTRUCTION_INDEX, function_id: current_id})
                        return false if not position_is_usable(functions[functions.count - ElisaEDIR::Shape::LAST_ITEM_INDEX_OFFSET].source)
                    Ast::Decl.Module(module_name, module_declarations, _):
                        return false if host_module_seen or not host_effect_module_valid(module_name, module_declarations)
                        host_module_seen <- true
                    _:
                        return false
            return functions.count > ElisaEDIR::HostEffect::NO_OPERANDS and functions[ElisaEDIR::Shape::FIRST_TOP_LEVEL_DECLARATION_INDEX].name == ElisaEDIR::Function::MAIN_NAME



        def integer_literal_value(expression: Ast::Expr) -> (value: i64, position: Ast::Pos, valid: bool):
            match expression:
                Ast::Expr.IntLit(value, position):
                    return (value, position, position_is_usable(position))
                Ast::Expr.Unary(operator, operand, unary_position):
                    if operator == Lexer::TokenKind.Minus:
                        match operand:
                            Ast::Expr.IntLit(value, _):
                                return (ElisaEDIR::Integer::ZERO - value, unary_position, position_is_usable(unary_position))
                            _:
                                pass
                _:
                    pass
            return (ElisaEDIR::Integer::ZERO, Ast::Pos{line: ElisaEDIR::Shape::NO_POSITION_LINE, column: ElisaEDIR::Shape::NO_POSITION_COLUMN, offset: ElisaEDIR::Shape::NO_POSITION_OFFSET, end_line: ElisaEDIR::Shape::NO_POSITION_LINE, end_column: ElisaEDIR::Shape::NO_POSITION_COLUMN, end_offset: ElisaEDIR::Shape::NO_POSITION_OFFSET}, false)



        def compile_integer_expression(instructions: mutable darray[u8]&, expression: Ast::Expr, parameter_name: sview, functions: darray[EDIRFunctionPlan]&, call_fixups: mutable darray[EDIRCallFixup]&) -> bool can[Abort.Panic, Memory.Allocate]:
            match expression:
                Ast::Expr.IntLit(value, position):
                    return false if not position_is_usable(position)
                    append_instruction(instructions, ElisaEDIR::Instruction::CONSTANT_OPCODE, value, position)
                    return true
                Ast::Expr.Ident(name, position):
                    return false if parameter_name == "" or name != parameter_name or not position_is_usable(position)
                    append_instruction(instructions, ElisaEDIR::Instruction::LOAD_LOCAL_OPCODE, ElisaEDIR::Shape::SINGLE_LOCAL_INDEX, position)
                    return true
                Ast::Expr.Paren(inner, _):
                    return compile_integer_expression(instructions, inner, parameter_name, functions, call_fixups)
                Ast::Expr.Unary(operator, operand, position):
                    if operator == Lexer::TokenKind.Minus:
                        match operand:
                            Ast::Expr.IntLit(value, _):
                                return false if not position_is_usable(position)
                                append_instruction(instructions, ElisaEDIR::Instruction::CONSTANT_OPCODE, ElisaEDIR::Integer::ZERO - value, position)
                                return true
                            _:
                                pass
                    return false
                Ast::Expr.Binary(left, operator, right, position):
                    right_literal: (value: i64, position: Ast::Pos, valid: bool) = integer_literal_value(right)
                    return false if not right_literal.valid or not position_is_usable(position)
                    supported_operator: mutable bool = false
                    opcode: u16 = binary_opcode(operator, &supported_operator)
                    return false if:
                        not supported_operator or (opcode == ElisaEDIR::Instruction::DIVIDE_OPCODE and right_literal.value == ElisaEDIR::Shape::NO_OPERAND)
                        not compile_integer_expression(instructions, left, parameter_name, functions, call_fixups)
                    append_instruction(instructions, opcode, right_literal.value, position)
                    return true
                Ast::Expr.Call(callee, arguments, argument_names, call_position):
                    host_opcode: u16 = host_effect_opcode(callee)
                    if host_opcode != ElisaEDIR::Instruction::UNSUPPORTED_OPCODE:
                        effect_source_position: Ast::Pos = host_effect_source_position(callee, call_position)
                        return false if not position_is_usable(effect_source_position)
                        if host_opcode == ElisaEDIR::Instruction::VIRTUAL_FILE_WRITE_BYTE_OPCODE or host_opcode == ElisaEDIR::Instruction::VIRTUAL_FILE_SEEK_OPCODE or host_opcode == ElisaEDIR::Instruction::VIRTUAL_FILE_TRY_WRITE_BYTE_OPCODE or host_opcode == ElisaEDIR::Instruction::VIRTUAL_FILE_TRY_SEEK_OPCODE:
                            return false if arguments.count != ElisaEDIR::HostEffect::TWO_ARGUMENT_COUNT or argument_names.count != arguments.count
                            for argument_index in 0..<argument_names.count:
                                return false if argument_names[argument_index] != ""
                            handle: (value: i64, position: Ast::Pos, valid: bool) = integer_literal_value(arguments[ElisaEDIR::HostEffect::HANDLE_ARGUMENT_INDEX])
                            value: (value: i64, position: Ast::Pos, valid: bool) = integer_literal_value(arguments[ElisaEDIR::HostEffect::VALUE_ARGUMENT_INDEX])
                            return false if:
                                not handle.valid or handle.value <= ElisaEDIR::HostEffect::NO_RESOURCE_HANDLE or not value.valid or value.value < ElisaEDIR::HostEffect::NO_OPERAND
                                (host_opcode == ElisaEDIR::Instruction::VIRTUAL_FILE_WRITE_BYTE_OPCODE or host_opcode == ElisaEDIR::Instruction::VIRTUAL_FILE_TRY_WRITE_BYTE_OPCODE) and value.value > ElisaEDIR::HostEffect::CONSOLE_OUTPUT_BYTE_MAX
                            append_instruction_with_operands(instructions, host_opcode, handle.value, value.value, effect_source_position)
                            return true
                        if host_opcode == ElisaEDIR::Instruction::CONSOLE_WRITE_BYTE_OPCODE or host_opcode == ElisaEDIR::Instruction::VIRTUAL_FILE_READ_BYTE_OPCODE or host_opcode == ElisaEDIR::Instruction::VIRTUAL_FILE_TRY_READ_BYTE_OPCODE or host_opcode == ElisaEDIR::Instruction::VIRTUAL_FILE_TRY_CLOSE_OPCODE or host_opcode == ElisaEDIR::Instruction::VIRTUAL_FILE_TRY_REOPEN_OPCODE:
                            return false if arguments.count != ElisaEDIR::HostEffect::SINGLE_ARGUMENT_COUNT or argument_names.count != arguments.count
                            for argument_index in 0..<argument_names.count:
                                return false if argument_names[argument_index] != ""
                            argument_value: (value: i64, position: Ast::Pos, valid: bool) = integer_literal_value(arguments[ElisaEDIR::HostEffect::SINGLE_ARGUMENT_INDEX])
                            return false if:
                                not argument_value.valid or argument_value.value < ElisaEDIR::HostEffect::NO_RESOURCE_HANDLE
                                host_opcode == ElisaEDIR::Instruction::CONSOLE_WRITE_BYTE_OPCODE and argument_value.value > ElisaEDIR::HostEffect::CONSOLE_OUTPUT_BYTE_MAX
                                (host_opcode == ElisaEDIR::Instruction::VIRTUAL_FILE_READ_BYTE_OPCODE or host_opcode == ElisaEDIR::Instruction::VIRTUAL_FILE_TRY_READ_BYTE_OPCODE or host_opcode == ElisaEDIR::Instruction::VIRTUAL_FILE_TRY_CLOSE_OPCODE or host_opcode == ElisaEDIR::Instruction::VIRTUAL_FILE_TRY_REOPEN_OPCODE) and argument_value.value == ElisaEDIR::HostEffect::NO_RESOURCE_HANDLE
                            append_instruction(instructions, host_opcode, argument_value.value, effect_source_position)
                            return true
                        return false if arguments.count != ElisaEDIR::HostEffect::NO_OPERANDS or argument_names.count != ElisaEDIR::HostEffect::NO_OPERANDS
                        append_instruction(instructions, host_opcode, ElisaEDIR::HostEffect::NO_OPERAND, effect_source_position)
                        return true
                    match callee:
                        Ast::Expr.Ident(callee_name, _):
                            target_index: usize = function_index(functions, callee_name)
                            return false if target_index >= functions.count or functions[target_index].parameter_name == "" or arguments.count != ElisaEDIR::Function::HELPER_PARAMETER_COUNT or argument_names.count != arguments.count or not position_is_usable(call_position)
                            for argument_index in 0..<argument_names.count:
                                return false if argument_names[argument_index] != ""
                            return false if not compile_integer_expression(instructions, arguments[ElisaEDIR::Function::ONLY_ARGUMENT_INDEX], parameter_name, functions, call_fixups)
                            instruction_index: usize = instructions.count / ElisaEDIR::Binary::INSTRUCTION_BYTES
                            append_instruction_with_operands(instructions, ElisaEDIR::Instruction::CALL_OPCODE, ElisaEDIR::Shape::NO_OPERAND, ElisaEDIR::Function::MAX_CALL_DEPTH, call_position)
                            call_fixups.push(EDIRCallFixup{instruction_index: instruction_index, function_name: callee_name})
                            return true
                        _:
                            return false
                _:
                    return false



        def compile_integer_condition(instructions: mutable darray[u8]&, condition: Ast::Expr, parameter_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
            match condition:
                Ast::Expr.Binary(left, operator, right, condition_position):
                    return false if operator != Lexer::TokenKind.Lt and operator != Lexer::TokenKind.EqEq
                    match left:
                        Ast::Expr.Ident(name, left_position):
                            return false if parameter_name == "" or name != parameter_name or not position_is_usable(left_position)
                            literal: (value: i64, position: Ast::Pos, valid: bool) = integer_literal_value(right)
                            return false if not literal.valid or not position_is_usable(condition_position)
                            append_instruction(instructions, ElisaEDIR::Instruction::LOAD_LOCAL_OPCODE, ElisaEDIR::Shape::SINGLE_LOCAL_INDEX, left_position)
                            comparison_opcode: u16 = ElisaEDIR::Instruction::COMPARE_LESS_OPCODE if operator == Lexer::TokenKind.Lt else ElisaEDIR::Instruction::COMPARE_EQUAL_OPCODE
                            append_instruction(instructions, comparison_opcode, literal.value, condition_position)
                            return true
                        _:
                            return false
                _:
                    return false



        def compile_integer_return(instructions: mutable darray[u8]&, statement: Ast::Stmt, parameter_name: sview, functions: darray[EDIRFunctionPlan]&, call_fixups: mutable darray[EDIRCallFixup]&) -> bool can[Abort.Panic, Memory.Allocate]:
            match statement:
                Ast::Stmt.Return(value, return_position):
                    if value is returned_expression:
                        return false if not compile_integer_expression(instructions, returned_expression, parameter_name, functions, call_fixups)
                        full_return_position: Ast::Pos = source_span_cover(return_position, Ast::expr_pos(returned_expression))
                        return false if not position_is_usable(full_return_position)
                        append_instruction(instructions, ElisaEDIR::Instruction::RETURN_OPCODE, ElisaEDIR::Shape::NO_OPERAND, full_return_position)
                        return true
                    return false
                _:
                    return false



        def compile_integer_if(instructions: mutable darray[u8]&, statement: Ast::Stmt, parameter_name: sview, functions: darray[EDIRFunctionPlan]&, call_fixups: mutable darray[EDIRCallFixup]&) -> bool can[Abort.Panic, Memory.Allocate]:
            match statement:
                Ast::Stmt.If(condition, then_body, else_body, if_position):
                    return false if:
                        then_body.count != ElisaEDIR::Shape::STATEMENT_COUNT or else_body.count > ElisaEDIR::Shape::STATEMENT_COUNT or not position_is_usable(if_position)
                        not compile_integer_condition(instructions, condition, parameter_name)
                    branch_index: usize = instructions.count / ElisaEDIR::Binary::INSTRUCTION_BYTES
                    append_instruction(instructions, ElisaEDIR::Instruction::BRANCH_ZERO_OPCODE, ElisaEDIR::Shape::NO_OPERAND, Ast::expr_pos(condition))
                    return false if not compile_integer_return(instructions, then_body[ElisaEDIR::Shape::FIRST_STATEMENT_INDEX], parameter_name, functions, call_fixups)
                    branch_target: usize = instructions.count / ElisaEDIR::Binary::INSTRUCTION_BYTES
                    patch_instruction_operand(instructions, branch_index, branch_target.i64())
                    if else_body.count == ElisaEDIR::Shape::STATEMENT_COUNT:
                        return false if not compile_integer_return(instructions, else_body[ElisaEDIR::Shape::FIRST_STATEMENT_INDEX], parameter_name, functions, call_fixups)
                    return true
                _:
                    return false



        def function_body_has_supported_return_shape(body: darray[Ast::Stmt]) -> bool:
            return false if body.count == 0
            for index in 0..<body.count:
                match body[index]:
                    Ast::Stmt.Return(_, _):
                        return false if index != body.count - ElisaEDIR::Shape::LAST_ITEM_INDEX_OFFSET
                    Ast::Stmt.If(_, then_body, else_body, _):
                        return false if then_body.count != ElisaEDIR::Shape::STATEMENT_COUNT or else_body.count > ElisaEDIR::Shape::STATEMENT_COUNT
                        match then_body[ElisaEDIR::Shape::FIRST_STATEMENT_INDEX]:
                            Ast::Stmt.Return(_, _):
                                pass
                            _:
                                return false
                        if else_body.count == ElisaEDIR::Shape::STATEMENT_COUNT:
                            match else_body[ElisaEDIR::Shape::FIRST_STATEMENT_INDEX]:
                                Ast::Stmt.Return(_, _):
                                    return false if index != body.count - ElisaEDIR::Shape::LAST_ITEM_INDEX_OFFSET
                                _:
                                    return false
                    _:
                        return false
            match body[body.count - ElisaEDIR::Shape::LAST_ITEM_INDEX_OFFSET]:
                Ast::Stmt.Return(_, _):
                    return true
                Ast::Stmt.If(else_body: else_body, _):
                    return else_body.count == ElisaEDIR::Shape::STATEMENT_COUNT
                _:
                    return false



        def compile_function_body(instructions: mutable darray[u8]&, function: EDIRFunctionPlan, functions: darray[EDIRFunctionPlan]&, call_fixups: mutable darray[EDIRCallFixup]&) -> bool can[Abort.Panic, Memory.Allocate]:
            return false if not function_body_has_supported_return_shape(function.body)
            for statement_index in 0..<function.body.count |instructions, function, functions, call_fixups|:
                match function.body[statement_index]:
                    Ast::Stmt.Return(_, _):
                        return false if not compile_integer_return(instructions, function.body[statement_index], function.parameter_name, functions, call_fixups)
                    Ast::Stmt.If(_, _, _, _):
                        return false if not compile_integer_if(instructions, function.body[statement_index], function.parameter_name, functions, call_fixups)
                    _:
                        return false
            return true



        def resolve_call_fixups(instructions: mutable darray[u8]&, functions: darray[EDIRFunctionPlan]&, call_fixups: darray[EDIRCallFixup]&) -> bool:
            for fixup_index in 0..<call_fixups.count |functions, call_fixups|:
                fixup: EDIRCallFixup = call_fixups[fixup_index]
                target_index: usize = function_index(functions, fixup.function_name)
                return false if target_index >= functions.count or functions[target_index].parameter_name == ""
                patch_instruction_operand(instructions, fixup.instruction_index, functions[target_index].entry_instruction.i64())
            return true



        def functions_artifact(output_path: darray[u8]&, functions: mutable darray[EDIRFunctionPlan]&, source_identity: EDIRSourceIdentity) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            instructions: mutable darray[u8] = []
            call_fixups: mutable darray[EDIRCallFixup] = []
            for function_index_value in 0..<functions.count |instructions, functions, call_fixups|:
                functions[function_index_value].entry_instruction <- instructions.count / ElisaEDIR::Binary::INSTRUCTION_BYTES
                return unsupported("function bodies may contain only returns, simple conditional returns, integer arithmetic, and direct single-argument calls") if not compile_function_body(instructions, functions[function_index_value], functions, call_fixups)
                functions[function_index_value].end_instruction_exclusive <- instructions.count / ElisaEDIR::Binary::INSTRUCTION_BYTES
            return unsupported("direct calls must target a declared one-argument helper function") if not resolve_call_fixups(instructions, functions, call_fixups)
            instruction_count: usize = instructions.count / ElisaEDIR::Binary::INSTRUCTION_BYTES
            return unsupported("function artifact exceeds the portable EDIR instruction limit") if instruction_count > ElisaEDIR::Instruction::MAX_COUNT
            artifact: mutable darray[u8] = []
            local_count: u64 = ElisaEDIR::Function::MAX_LOCAL_COUNT if functions.count > ElisaEDIR::Shape::SINGLE_LOCAL_COUNT else ElisaEDIR::Shape::NO_LOCALS
            append_header(&artifact, instruction_count.u64(), local_count, source_identity)
            for instruction_byte in 0..<instructions.count |artifact, instructions|:
                artifact.push(instructions[instruction_byte])
            return unsupported("function descriptor table exceeds the portable EDIR bounds") if not append_function_table(&artifact, functions)
            return write_artifact_or_report(output_path, artifact)



        def simple_i64_declaration(statement: Ast::Stmt) -> (name: sview, value: i64, declaration_span: Ast::Pos, valid: bool):
            match statement:
                Ast::Stmt.VarDecl(local_name, local_type, initializer, declaration_position):
                    return ("", ElisaEDIR::Integer::ZERO, Ast::Pos{line: ElisaEDIR::Shape::NO_POSITION_LINE, column: ElisaEDIR::Shape::NO_POSITION_COLUMN, offset: ElisaEDIR::Shape::NO_POSITION_OFFSET, end_line: ElisaEDIR::Shape::NO_POSITION_LINE, end_column: ElisaEDIR::Shape::NO_POSITION_COLUMN, end_offset: ElisaEDIR::Shape::NO_POSITION_OFFSET}, false) if local_name == "" or local_name == "_"
                    match local_type:
                        Ast::Expr.Unary(type_operator, bare_type, _):
                            return ("", ElisaEDIR::Integer::ZERO, Ast::Pos{line: ElisaEDIR::Shape::NO_POSITION_LINE, column: ElisaEDIR::Shape::NO_POSITION_COLUMN, offset: ElisaEDIR::Shape::NO_POSITION_OFFSET, end_line: ElisaEDIR::Shape::NO_POSITION_LINE, end_column: ElisaEDIR::Shape::NO_POSITION_COLUMN, end_offset: ElisaEDIR::Shape::NO_POSITION_OFFSET}, false) if type_operator != Lexer::TokenKind.Mutable
                            match bare_type:
                                Ast::Expr.Ident(type_name, _):
                                    return ("", ElisaEDIR::Integer::ZERO, Ast::Pos{line: ElisaEDIR::Shape::NO_POSITION_LINE, column: ElisaEDIR::Shape::NO_POSITION_COLUMN, offset: ElisaEDIR::Shape::NO_POSITION_OFFSET, end_line: ElisaEDIR::Shape::NO_POSITION_LINE, end_column: ElisaEDIR::Shape::NO_POSITION_COLUMN, end_offset: ElisaEDIR::Shape::NO_POSITION_OFFSET}, false) if type_name != "i64"
                                _:
                                    return ("", ElisaEDIR::Integer::ZERO, Ast::Pos{line: ElisaEDIR::Shape::NO_POSITION_LINE, column: ElisaEDIR::Shape::NO_POSITION_COLUMN, offset: ElisaEDIR::Shape::NO_POSITION_OFFSET, end_line: ElisaEDIR::Shape::NO_POSITION_LINE, end_column: ElisaEDIR::Shape::NO_POSITION_COLUMN, end_offset: ElisaEDIR::Shape::NO_POSITION_OFFSET}, false)
                        _:
                            return ("", ElisaEDIR::Integer::ZERO, Ast::Pos{line: ElisaEDIR::Shape::NO_POSITION_LINE, column: ElisaEDIR::Shape::NO_POSITION_COLUMN, offset: ElisaEDIR::Shape::NO_POSITION_OFFSET, end_line: ElisaEDIR::Shape::NO_POSITION_LINE, end_column: ElisaEDIR::Shape::NO_POSITION_COLUMN, end_offset: ElisaEDIR::Shape::NO_POSITION_OFFSET}, false)
                    match initializer:
                        Ast::Expr.IntLit(value, initializer_position):
                            declaration_span: Ast::Pos = source_span_cover(declaration_position, initializer_position)
                            return (local_name, value, declaration_span, position_is_usable(declaration_span))
                        _:
                            return ("", ElisaEDIR::Integer::ZERO, Ast::Pos{line: ElisaEDIR::Shape::NO_POSITION_LINE, column: ElisaEDIR::Shape::NO_POSITION_COLUMN, offset: ElisaEDIR::Shape::NO_POSITION_OFFSET, end_line: ElisaEDIR::Shape::NO_POSITION_LINE, end_column: ElisaEDIR::Shape::NO_POSITION_COLUMN, end_offset: ElisaEDIR::Shape::NO_POSITION_OFFSET}, false)
                _:
                    return ("", ElisaEDIR::Integer::ZERO, Ast::Pos{line: ElisaEDIR::Shape::NO_POSITION_LINE, column: ElisaEDIR::Shape::NO_POSITION_COLUMN, offset: ElisaEDIR::Shape::NO_POSITION_OFFSET, end_line: ElisaEDIR::Shape::NO_POSITION_LINE, end_column: ElisaEDIR::Shape::NO_POSITION_COLUMN, end_offset: ElisaEDIR::Shape::NO_POSITION_OFFSET}, false)



        def simple_i64_increment(statement: Ast::Stmt, expected_name: sview, expected_increment: i64) -> (span: Ast::Pos, valid: bool):
            match statement:
                Ast::Stmt.Assign(target, assignment_operator, value, _):
                    return (Ast::Pos{line: ElisaEDIR::Shape::NO_POSITION_LINE, column: ElisaEDIR::Shape::NO_POSITION_COLUMN, offset: ElisaEDIR::Shape::NO_POSITION_OFFSET, end_line: ElisaEDIR::Shape::NO_POSITION_LINE, end_column: ElisaEDIR::Shape::NO_POSITION_COLUMN, end_offset: ElisaEDIR::Shape::NO_POSITION_OFFSET}, false) if assignment_operator != Lexer::TokenKind.LArrow
                    match target:
                        Ast::Expr.Ident(target_name, target_position):
                            return (Ast::Pos{line: ElisaEDIR::Shape::NO_POSITION_LINE, column: ElisaEDIR::Shape::NO_POSITION_COLUMN, offset: ElisaEDIR::Shape::NO_POSITION_OFFSET, end_line: ElisaEDIR::Shape::NO_POSITION_LINE, end_column: ElisaEDIR::Shape::NO_POSITION_COLUMN, end_offset: ElisaEDIR::Shape::NO_POSITION_OFFSET}, false) if target_name != expected_name or not position_is_usable(target_position)
                            match value:
                                Ast::Expr.Binary(left, operator, right, _):
                                    return (Ast::Pos{line: ElisaEDIR::Shape::NO_POSITION_LINE, column: ElisaEDIR::Shape::NO_POSITION_COLUMN, offset: ElisaEDIR::Shape::NO_POSITION_OFFSET, end_line: ElisaEDIR::Shape::NO_POSITION_LINE, end_column: ElisaEDIR::Shape::NO_POSITION_COLUMN, end_offset: ElisaEDIR::Shape::NO_POSITION_OFFSET}, false) if operator != Lexer::TokenKind.Plus
                                    match left:
                                        Ast::Expr.Ident(left_name, left_position):
                                            return (Ast::Pos{line: ElisaEDIR::Shape::NO_POSITION_LINE, column: ElisaEDIR::Shape::NO_POSITION_COLUMN, offset: ElisaEDIR::Shape::NO_POSITION_OFFSET, end_line: ElisaEDIR::Shape::NO_POSITION_LINE, end_column: ElisaEDIR::Shape::NO_POSITION_COLUMN, end_offset: ElisaEDIR::Shape::NO_POSITION_OFFSET}, false) if left_name != expected_name or not position_is_usable(left_position)
                                        _:
                                            return (Ast::Pos{line: ElisaEDIR::Shape::NO_POSITION_LINE, column: ElisaEDIR::Shape::NO_POSITION_COLUMN, offset: ElisaEDIR::Shape::NO_POSITION_OFFSET, end_line: ElisaEDIR::Shape::NO_POSITION_LINE, end_column: ElisaEDIR::Shape::NO_POSITION_COLUMN, end_offset: ElisaEDIR::Shape::NO_POSITION_OFFSET}, false)
                                    match right:
                                        Ast::Expr.IntLit(increment, right_position):
                                            return (Ast::Pos{line: ElisaEDIR::Shape::NO_POSITION_LINE, column: ElisaEDIR::Shape::NO_POSITION_COLUMN, offset: ElisaEDIR::Shape::NO_POSITION_OFFSET, end_line: ElisaEDIR::Shape::NO_POSITION_LINE, end_column: ElisaEDIR::Shape::NO_POSITION_COLUMN, end_offset: ElisaEDIR::Shape::NO_POSITION_OFFSET}, false) if increment != expected_increment or not position_is_usable(right_position)
                                            assignment_span: Ast::Pos = source_span_cover(target_position, right_position)
                                            return (assignment_span, position_is_usable(assignment_span))
                                        _:
                                            return (Ast::Pos{line: ElisaEDIR::Shape::NO_POSITION_LINE, column: ElisaEDIR::Shape::NO_POSITION_COLUMN, offset: ElisaEDIR::Shape::NO_POSITION_OFFSET, end_line: ElisaEDIR::Shape::NO_POSITION_LINE, end_column: ElisaEDIR::Shape::NO_POSITION_COLUMN, end_offset: ElisaEDIR::Shape::NO_POSITION_OFFSET}, false)
                                _:
                                    return (Ast::Pos{line: ElisaEDIR::Shape::NO_POSITION_LINE, column: ElisaEDIR::Shape::NO_POSITION_COLUMN, offset: ElisaEDIR::Shape::NO_POSITION_OFFSET, end_line: ElisaEDIR::Shape::NO_POSITION_LINE, end_column: ElisaEDIR::Shape::NO_POSITION_COLUMN, end_offset: ElisaEDIR::Shape::NO_POSITION_OFFSET}, false)
                        _:
                            return (Ast::Pos{line: ElisaEDIR::Shape::NO_POSITION_LINE, column: ElisaEDIR::Shape::NO_POSITION_COLUMN, offset: ElisaEDIR::Shape::NO_POSITION_OFFSET, end_line: ElisaEDIR::Shape::NO_POSITION_LINE, end_column: ElisaEDIR::Shape::NO_POSITION_COLUMN, end_offset: ElisaEDIR::Shape::NO_POSITION_OFFSET}, false)
                _:
                    return (Ast::Pos{line: ElisaEDIR::Shape::NO_POSITION_LINE, column: ElisaEDIR::Shape::NO_POSITION_COLUMN, offset: ElisaEDIR::Shape::NO_POSITION_OFFSET, end_line: ElisaEDIR::Shape::NO_POSITION_LINE, end_column: ElisaEDIR::Shape::NO_POSITION_COLUMN, end_offset: ElisaEDIR::Shape::NO_POSITION_OFFSET}, false)



        def counted_loop_artifact(output_path: darray[u8]&, body: darray[Ast::Stmt], function_position: Ast::Pos, source_identity: EDIRSourceIdentity) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            return unsupported("counted-loop lowering requires two initialized `i64` locals, one bounded `while`, and a return") if body.count != ElisaEDIR::CountedLoop::STATEMENT_COUNT

            counter: (name: sview, value: i64, declaration_span: Ast::Pos, valid: bool) = simple_i64_declaration(body[ElisaEDIR::CountedLoop::COUNTER_DECLARATION_INDEX])
            total: (name: sview, value: i64, declaration_span: Ast::Pos, valid: bool) = simple_i64_declaration(body[ElisaEDIR::CountedLoop::TOTAL_DECLARATION_INDEX])
            return unsupported("counted-loop locals must be initialized typed `i64` declarations with usable source spans") if not counter.valid or not total.valid
            return unsupported("counted-loop locals must have distinct names and start at zero") if counter.name == total.name or counter.value != ElisaEDIR::CountedLoop::INITIAL_VALUE or total.value != ElisaEDIR::CountedLoop::INITIAL_VALUE

            loop_condition_position: mutable Ast::Pos = Ast::Pos{line: ElisaEDIR::Shape::NO_POSITION_LINE, column: ElisaEDIR::Shape::NO_POSITION_COLUMN, offset: ElisaEDIR::Shape::NO_POSITION_OFFSET, end_line: ElisaEDIR::Shape::NO_POSITION_LINE, end_column: ElisaEDIR::Shape::NO_POSITION_COLUMN, end_offset: ElisaEDIR::Shape::NO_POSITION_OFFSET}
            loop_limit: mutable i64 = ElisaEDIR::CountedLoop::INITIAL_VALUE
            counter_assignment_span: mutable Ast::Pos = Ast::Pos{line: ElisaEDIR::Shape::NO_POSITION_LINE, column: ElisaEDIR::Shape::NO_POSITION_COLUMN, offset: ElisaEDIR::Shape::NO_POSITION_OFFSET, end_line: ElisaEDIR::Shape::NO_POSITION_LINE, end_column: ElisaEDIR::Shape::NO_POSITION_COLUMN, end_offset: ElisaEDIR::Shape::NO_POSITION_OFFSET}
            total_assignment_span: mutable Ast::Pos = Ast::Pos{line: ElisaEDIR::Shape::NO_POSITION_LINE, column: ElisaEDIR::Shape::NO_POSITION_COLUMN, offset: ElisaEDIR::Shape::NO_POSITION_OFFSET, end_line: ElisaEDIR::Shape::NO_POSITION_LINE, end_column: ElisaEDIR::Shape::NO_POSITION_COLUMN, end_offset: ElisaEDIR::Shape::NO_POSITION_OFFSET}

            match body[ElisaEDIR::CountedLoop::WHILE_STATEMENT_INDEX]:
                Ast::Stmt.While(condition, loop_body, _):
                    return unsupported("counted-loop body must update the total and then the counter") if loop_body.count != ElisaEDIR::CountedLoop::BODY_STATEMENT_COUNT
                    match condition:
                        Ast::Expr.Binary(left, operator, right, condition_position):
                            return unsupported("counted-loop condition must compare the counter with a nonnegative literal using `<`") if operator != Lexer::TokenKind.Lt
                            match left:
                                Ast::Expr.Ident(condition_name, condition_name_position):
                                    return unsupported("counted-loop condition must use the first local as its counter") if condition_name != counter.name or not position_is_usable(condition_name_position)
                                _:
                                    return unsupported("counted-loop condition must use the first local as its counter")
                            match right:
                                Ast::Expr.IntLit(limit, limit_position):
                                    return unsupported("counted-loop limit must be nonnegative and keep the total within `i64`") if limit < ElisaEDIR::CountedLoop::INITIAL_VALUE or limit > ElisaEDIR::CountedLoop::TOTAL_MAX
                                    loop_limit <- limit
                                    return unsupported("counted-loop limit has no usable source span") if not position_is_usable(limit_position)
                                _:
                                    return unsupported("counted-loop limit must be an integer literal")
                            return unsupported("counted-loop condition has no usable source span") if not position_is_usable(condition_position)
                            loop_condition_position <- condition_position
                        _:
                            return unsupported("counted-loop condition must be a local-versus-literal `<` comparison")
                    total_update: (span: Ast::Pos, valid: bool) = simple_i64_increment(loop_body[ElisaEDIR::CountedLoop::TOTAL_UPDATE_INDEX], total.name, ElisaEDIR::CountedLoop::TOTAL_INCREMENT)
                    counter_update: (span: Ast::Pos, valid: bool) = simple_i64_increment(loop_body[ElisaEDIR::CountedLoop::COUNTER_UPDATE_INDEX], counter.name, ElisaEDIR::CountedLoop::COUNTER_INCREMENT)
                    return unsupported("counted-loop body must use `total <- total + 2` and `counter <- counter + 1`") if not total_update.valid or not counter_update.valid
                    total_assignment_span <- total_update.span
                    counter_assignment_span <- counter_update.span
                _:
                    return unsupported("the third statement in counted-loop `main` must be a `while`")

            instructions: mutable darray[u8] = []
            append_instruction(&instructions, ElisaEDIR::Instruction::CONSTANT_OPCODE, counter.value, counter.declaration_span)
            append_instruction(&instructions, ElisaEDIR::Instruction::STORE_LOCAL_OPCODE, ElisaEDIR::CountedLoop::COUNTER_INDEX, counter.declaration_span)
            append_instruction(&instructions, ElisaEDIR::Instruction::CONSTANT_OPCODE, total.value, total.declaration_span)
            append_instruction(&instructions, ElisaEDIR::Instruction::STORE_LOCAL_OPCODE, ElisaEDIR::CountedLoop::TOTAL_INDEX, total.declaration_span)

            loop_start: usize = instructions.count / ElisaEDIR::Binary::INSTRUCTION_BYTES
            append_instruction(&instructions, ElisaEDIR::Instruction::LOAD_LOCAL_OPCODE, ElisaEDIR::CountedLoop::COUNTER_INDEX, loop_condition_position)
            append_instruction(&instructions, ElisaEDIR::Instruction::COMPARE_LESS_OPCODE, loop_limit, loop_condition_position)
            branch_instruction: usize = instructions.count / ElisaEDIR::Binary::INSTRUCTION_BYTES
            append_instruction(&instructions, ElisaEDIR::Instruction::BRANCH_ZERO_OPCODE, ElisaEDIR::Shape::NO_OPERAND, loop_condition_position)
            append_instruction(&instructions, ElisaEDIR::Instruction::LOAD_LOCAL_OPCODE, ElisaEDIR::CountedLoop::TOTAL_INDEX, total_assignment_span)
            append_instruction(&instructions, ElisaEDIR::Instruction::ADD_OPCODE, ElisaEDIR::CountedLoop::TOTAL_INCREMENT, total_assignment_span)
            append_instruction(&instructions, ElisaEDIR::Instruction::STORE_LOCAL_OPCODE, ElisaEDIR::CountedLoop::TOTAL_INDEX, total_assignment_span)
            append_instruction(&instructions, ElisaEDIR::Instruction::LOAD_LOCAL_OPCODE, ElisaEDIR::CountedLoop::COUNTER_INDEX, counter_assignment_span)
            append_instruction(&instructions, ElisaEDIR::Instruction::ADD_OPCODE, ElisaEDIR::CountedLoop::COUNTER_INCREMENT, counter_assignment_span)
            append_instruction(&instructions, ElisaEDIR::Instruction::STORE_LOCAL_OPCODE, ElisaEDIR::CountedLoop::COUNTER_INDEX, counter_assignment_span)
            append_instruction(&instructions, ElisaEDIR::Instruction::JUMP_OPCODE, loop_start.i64(), loop_condition_position)
            loop_exit: usize = instructions.count / ElisaEDIR::Binary::INSTRUCTION_BYTES

            match body[ElisaEDIR::CountedLoop::RETURN_STATEMENT_INDEX]:
                Ast::Stmt.Return(return_value, return_position):
                    if return_value is returned_expression:
                        match returned_expression:
                            Ast::Expr.Ident(returned_name, returned_position):
                                return unsupported("counted-loop `main` must return its total local") if returned_name != total.name
                                full_return_position: Ast::Pos = source_span_cover(return_position, returned_position)
                                return unsupported("counted-loop return has no usable source span") if not position_is_usable(full_return_position)
                                append_instruction(&instructions, ElisaEDIR::Instruction::LOAD_LOCAL_OPCODE, ElisaEDIR::CountedLoop::TOTAL_INDEX, full_return_position)
                                append_instruction(&instructions, ElisaEDIR::Instruction::RETURN_OPCODE, ElisaEDIR::Shape::NO_OPERAND, full_return_position)
                            _:
                                return unsupported("counted-loop `main` must return its total local")
                    else:
                        return unsupported("counted-loop `main` must return a value")
                _:
                    return unsupported("the final statement in counted-loop `main` must be a return")

            instruction_count: usize = instructions.count / ElisaEDIR::Binary::INSTRUCTION_BYTES
            return unsupported("counted-loop artifact exceeds the portable EDIR instruction limit") if instruction_count > ElisaEDIR::Instruction::MAX_COUNT
            patch_instruction_operand(&instructions, branch_instruction, loop_exit.i64())

            artifact: mutable darray[u8] = []
            append_header(&artifact, instruction_count.u64(), ElisaEDIR::CountedLoop::LOCAL_COUNT, source_identity)
            for instruction_byte in 0..<instructions.count |artifact, instructions|:
                artifact.push(instructions[instruction_byte])
            return unsupported("`main` function descriptor has no usable source span") if not append_single_function_table(&artifact, ElisaEDIR::Function::MAIN_NAME, function_position, instruction_count.u64())
            return write_artifact_or_report(output_path, artifact)



        def binary_opcode(operator: Lexer::TokenKind, supported: mutable bool&) -> u16:
            supported <- true
            return ElisaEDIR::Instruction::ADD_OPCODE if operator == Lexer::TokenKind.Plus
            return ElisaEDIR::Instruction::SUBTRACT_OPCODE if operator == Lexer::TokenKind.Minus
            return ElisaEDIR::Instruction::MULTIPLY_OPCODE if operator == Lexer::TokenKind.Star
            return ElisaEDIR::Instruction::DIVIDE_OPCODE if operator == Lexer::TokenKind.Slash
            supported <- false
            return ElisaEDIR::Instruction::UNSUPPORTED_OPCODE



        def binary_operands_are_safe(opcode: u16, left: i64, right: i64) -> bool:
            return false if left < ElisaEDIR::Shape::NO_OPERAND or right < ElisaEDIR::Shape::NO_OPERAND
            if opcode == ElisaEDIR::Instruction::ADD_OPCODE:
                return left <= ElisaEDIR::Integer::I64_MAX - right
            if opcode == ElisaEDIR::Instruction::SUBTRACT_OPCODE:
                return true
            if opcode == ElisaEDIR::Instruction::MULTIPLY_OPCODE:
                return true if right == ElisaEDIR::Shape::NO_OPERAND
                return left <= ElisaEDIR::Integer::I64_MAX / right
            if opcode == ElisaEDIR::Instruction::DIVIDE_OPCODE:
                return right != ElisaEDIR::Shape::NO_OPERAND
            return false



        def append_header(buffer: mutable darray[u8]&, instruction_count: u64, local_count: u64, source_identity: EDIRSourceIdentity) -> void can[Abort.Panic, Memory.Allocate]:
            append_unsigned_le(buffer, ElisaEDIR::Schema::CODEC_VERSION.u64(), ElisaEDIR::Binary::U32_WIDTH)
            append_unsigned_le(buffer, ElisaEDIR::Schema::PROGRAM_VERSION.u64(), ElisaEDIR::Binary::U32_WIDTH)
            append_unsigned_le(buffer, instruction_count, ElisaEDIR::Binary::U64_WIDTH)
            append_unsigned_le(buffer, local_count, ElisaEDIR::Binary::U64_WIDTH)
            buffer.push(ElisaEDIR::Encoding::TRUE)
            append_unsigned_le(buffer, ElisaEDIR::Source::FILE_COUNT.u64(), ElisaEDIR::Binary::U32_WIDTH)
            append_source_file(buffer, source_identity)
