extend ElisaEDIR:
    private:
        def literal_artifact(output_path: darray[u8]&, value: i64, value_position: Ast::Pos, return_position: Ast::Pos, function_position: Ast::Pos, source_identity: EDIRSourceIdentity) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            return unsupported("the literal has no usable source span") if not position_is_usable(value_position)
            statement_position: Ast::Pos = source_span_cover(return_position, value_position)
            return unsupported("the return statement has no usable source span") if not position_is_usable(statement_position)
            artifact: mutable darray[u8] = []
            append_header(&artifact, ElisaEDIR::Instruction::LITERAL_COUNT, ElisaEDIR::Shape::NO_LOCALS, source_identity)
            append_instruction(&artifact, ElisaEDIR::Instruction::CONSTANT_OPCODE, value, value_position)
            append_instruction(&artifact, ElisaEDIR::Instruction::RETURN_OPCODE, ElisaEDIR::Shape::NO_OPERAND, statement_position)
            return unsupported("`main` function descriptor has no usable source span") if not append_single_function_table(&artifact, ElisaEDIR::Function::MAIN_NAME, function_position, ElisaEDIR::Instruction::LITERAL_COUNT)
            return write_artifact_or_report(output_path, artifact)



        def binary_artifact(output_path: darray[u8]&, opcode: u16, left_value: i64, left_position: Ast::Pos, right_value: i64, right_position: Ast::Pos, return_position: Ast::Pos, function_position: Ast::Pos, source_identity: EDIRSourceIdentity) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            return unsupported("the left literal has no usable source span") if not position_is_usable(left_position)
            return unsupported("the right literal has no usable source span") if not position_is_usable(right_position)
            full_expression_position: Ast::Pos = source_span_cover(left_position, right_position)
            return unsupported("the arithmetic expression has no usable source span") if not position_is_usable(full_expression_position)
            statement_position: Ast::Pos = source_span_cover(return_position, right_position)
            return unsupported("the return statement has no usable source span") if not position_is_usable(statement_position)
            return unsupported("arithmetic may overflow or divide by zero in the managed engine") if not binary_operands_are_safe(opcode, left_value, right_value)
            artifact: mutable darray[u8] = []
            append_header(&artifact, ElisaEDIR::Instruction::BINARY_COUNT, ElisaEDIR::Shape::NO_LOCALS, source_identity)
            append_instruction(&artifact, ElisaEDIR::Instruction::CONSTANT_OPCODE, left_value, left_position)
            append_instruction(&artifact, opcode, right_value, full_expression_position)
            append_instruction(&artifact, ElisaEDIR::Instruction::RETURN_OPCODE, ElisaEDIR::Shape::NO_OPERAND, statement_position)
            return unsupported("`main` function descriptor has no usable source span") if not append_single_function_table(&artifact, ElisaEDIR::Function::MAIN_NAME, function_position, ElisaEDIR::Instruction::BINARY_COUNT)
            return write_artifact_or_report(output_path, artifact)



        def local_return_artifact(output_path: darray[u8]&, local_name: sview, local_value: i64, declaration_position: Ast::Pos, initializer_position: Ast::Pos, returned_expression: Ast::Expr, return_position: Ast::Pos, function_position: Ast::Pos, source_identity: EDIRSourceIdentity) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            return unsupported("the local declaration has no usable source span") if not position_is_usable(declaration_position)
            return unsupported("the local initializer has no usable source span") if not position_is_usable(initializer_position)
            full_declaration_position: Ast::Pos = source_span_cover(declaration_position, initializer_position)
            return unsupported("the local declaration has no usable source span") if not position_is_usable(full_declaration_position)

            match returned_expression:
                Ast::Expr.Ident(returned_name, returned_position):
                    return unsupported("the return identifier must name the initialized local") if returned_name != local_name
                    return unsupported("the returned local has no usable source span") if not position_is_usable(returned_position)
                    statement_position: Ast::Pos = source_span_cover(return_position, returned_position)
                    return unsupported("the return statement has no usable source span") if not position_is_usable(statement_position)
                    artifact: mutable darray[u8] = []
                    append_header(&artifact, ElisaEDIR::Instruction::LOCAL_COUNT, ElisaEDIR::Shape::SINGLE_LOCAL_COUNT, source_identity)
                    append_instruction(&artifact, ElisaEDIR::Instruction::CONSTANT_OPCODE, local_value, initializer_position)
                    append_instruction(&artifact, ElisaEDIR::Instruction::STORE_LOCAL_OPCODE, ElisaEDIR::Shape::SINGLE_LOCAL_INDEX, full_declaration_position)
                    append_instruction(&artifact, ElisaEDIR::Instruction::LOAD_LOCAL_OPCODE, ElisaEDIR::Shape::SINGLE_LOCAL_INDEX, returned_position)
                    append_instruction(&artifact, ElisaEDIR::Instruction::RETURN_OPCODE, ElisaEDIR::Shape::NO_OPERAND, statement_position)
                    return unsupported("`main` function descriptor has no usable source span") if not append_single_function_table(&artifact, ElisaEDIR::Function::MAIN_NAME, function_position, ElisaEDIR::Instruction::LOCAL_COUNT)
                    return write_artifact_or_report(output_path, artifact)
                Ast::Expr.Binary(left, operator, right, _):
                    supported_operator: mutable bool = false
                    opcode: u16 = binary_opcode(operator, &supported_operator)
                    return unsupported("the return arithmetic operator must be `+`, `-`, `*`, or `/`") if not supported_operator
                    match left:
                        Ast::Expr.Ident(left_name, left_position):
                            return unsupported("the left return operand must name the initialized local") if left_name != local_name
                            return unsupported("the local arithmetic operand has no usable source span") if not position_is_usable(left_position)
                            match right:
                                Ast::Expr.IntLit(right_value, right_position):
                                    return unsupported("the right arithmetic literal has no usable source span") if not position_is_usable(right_position)
                                    expression_position: Ast::Pos = source_span_cover(left_position, right_position)
                                    return unsupported("the return arithmetic expression has no usable source span") if not position_is_usable(expression_position)
                                    statement_position: Ast::Pos = source_span_cover(return_position, right_position)
                                    return unsupported("the return statement has no usable source span") if not position_is_usable(statement_position)
                                    return unsupported("arithmetic may overflow or divide by zero in the managed engine") if not binary_operands_are_safe(opcode, local_value, right_value)
                                    artifact: mutable darray[u8] = []
                                    append_header(&artifact, ElisaEDIR::Instruction::LOCAL_BINARY_COUNT, ElisaEDIR::Shape::SINGLE_LOCAL_COUNT, source_identity)
                                    append_instruction(&artifact, ElisaEDIR::Instruction::CONSTANT_OPCODE, local_value, initializer_position)
                                    append_instruction(&artifact, ElisaEDIR::Instruction::STORE_LOCAL_OPCODE, ElisaEDIR::Shape::SINGLE_LOCAL_INDEX, full_declaration_position)
                                    append_instruction(&artifact, ElisaEDIR::Instruction::LOAD_LOCAL_OPCODE, ElisaEDIR::Shape::SINGLE_LOCAL_INDEX, left_position)
                                    append_instruction(&artifact, opcode, right_value, expression_position)
                                    append_instruction(&artifact, ElisaEDIR::Instruction::RETURN_OPCODE, ElisaEDIR::Shape::NO_OPERAND, statement_position)
                                    return unsupported("`main` function descriptor has no usable source span") if not append_single_function_table(&artifact, ElisaEDIR::Function::MAIN_NAME, function_position, ElisaEDIR::Instruction::LOCAL_BINARY_COUNT)
                                    return write_artifact_or_report(output_path, artifact)
                                _:
                                    return unsupported("the right operand of local arithmetic must be an integer literal")
                        _:
                            return unsupported("the left operand of return arithmetic must be the initialized local")
                _:
                    return unsupported("`main` must return the initialized local or use it as the left operand of supported integer-literal arithmetic")



        def core_ir_opcode(operator: ElisaCoreIR::I64BinaryOperator) -> u16:
            return ElisaEDIR::Instruction::ADD_OPCODE if operator == ElisaCoreIR::I64BinaryOperator.Add
            return ElisaEDIR::Instruction::SUBTRACT_OPCODE if operator == ElisaCoreIR::I64BinaryOperator.Subtract
            return ElisaEDIR::Instruction::MULTIPLY_OPCODE if operator == ElisaCoreIR::I64BinaryOperator.Multiply
            return ElisaEDIR::Instruction::DIVIDE_OPCODE


        def core_ir_artifact(output_path: darray[u8]&, program: ElisaCoreIR::Program, function_position: Ast::Pos, source_identity: EDIRSourceIdentity) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            artifact: mutable darray[u8] = []
            if program.has_local:
                return unsupported("the local declaration has no usable source span") if not position_is_usable(program.local_declaration_position)
                return unsupported("the local initializer has no usable source span") if not position_is_usable(program.local_initializer_position)
                local_declaration_span: Ast::Pos = source_span_cover(program.local_declaration_position, program.local_initializer_position)
                return unsupported("the local declaration has no usable source span") if not position_is_usable(local_declaration_span)
                return unsupported("the returned local has no usable source span") if not position_is_usable(program.left_position)
                return unsupported("the return statement has no usable source span") if not position_is_usable(program.return_position)
                if program.has_binary_operator:
                    return unsupported("arithmetic may overflow or divide by zero in the managed engine") if not ElisaCoreIR::scalar_expression_is_defined(program)
                    return unsupported("the right literal has no usable source span") if not position_is_usable(program.right_position)
                    return unsupported("the arithmetic expression has no usable source span") if not position_is_usable(program.expression_position)
                    append_header(&artifact, ElisaEDIR::Instruction::LOCAL_BINARY_COUNT, ElisaEDIR::Shape::SINGLE_LOCAL_COUNT, source_identity)
                    append_instruction(&artifact, ElisaEDIR::Instruction::CONSTANT_OPCODE, program.local_value, program.local_initializer_position)
                    append_instruction(&artifact, ElisaEDIR::Instruction::STORE_LOCAL_OPCODE, ElisaEDIR::Shape::SINGLE_LOCAL_INDEX, local_declaration_span)
                    append_instruction(&artifact, ElisaEDIR::Instruction::LOAD_LOCAL_OPCODE, ElisaEDIR::Shape::SINGLE_LOCAL_INDEX, program.left_position)
                    append_instruction(&artifact, core_ir_opcode(program.operator), program.right, program.expression_position)
                    append_instruction(&artifact, ElisaEDIR::Instruction::RETURN_OPCODE, ElisaEDIR::Shape::NO_OPERAND, program.return_position)
                    return unsupported("`main` function descriptor has no usable source span") if not append_single_function_table(&artifact, ElisaEDIR::Function::MAIN_NAME, function_position, ElisaEDIR::Instruction::LOCAL_BINARY_COUNT)
                    return write_artifact_or_report(output_path, artifact)
                append_header(&artifact, ElisaEDIR::Instruction::LOCAL_COUNT, ElisaEDIR::Shape::SINGLE_LOCAL_COUNT, source_identity)
                append_instruction(&artifact, ElisaEDIR::Instruction::CONSTANT_OPCODE, program.local_value, program.local_initializer_position)
                append_instruction(&artifact, ElisaEDIR::Instruction::STORE_LOCAL_OPCODE, ElisaEDIR::Shape::SINGLE_LOCAL_INDEX, local_declaration_span)
                append_instruction(&artifact, ElisaEDIR::Instruction::LOAD_LOCAL_OPCODE, ElisaEDIR::Shape::SINGLE_LOCAL_INDEX, program.left_position)
                append_instruction(&artifact, ElisaEDIR::Instruction::RETURN_OPCODE, ElisaEDIR::Shape::NO_OPERAND, program.return_position)
                return unsupported("`main` function descriptor has no usable source span") if not append_single_function_table(&artifact, ElisaEDIR::Function::MAIN_NAME, function_position, ElisaEDIR::Instruction::LOCAL_COUNT)
                return write_artifact_or_report(output_path, artifact)
            if not program.has_binary_operator:
                return unsupported("the literal has no usable source span") if not position_is_usable(program.left_position)
                return unsupported("the return statement has no usable source span") if not position_is_usable(program.return_position)
                append_header(&artifact, ElisaEDIR::Instruction::LITERAL_COUNT, ElisaEDIR::Shape::NO_LOCALS, source_identity)
                append_instruction(&artifact, ElisaEDIR::Instruction::CONSTANT_OPCODE, program.left, program.left_position)
                append_instruction(&artifact, ElisaEDIR::Instruction::RETURN_OPCODE, ElisaEDIR::Shape::NO_OPERAND, program.return_position)
                return unsupported("`main` function descriptor has no usable source span") if not append_single_function_table(&artifact, ElisaEDIR::Function::MAIN_NAME, function_position, ElisaEDIR::Instruction::LITERAL_COUNT)
                return write_artifact_or_report(output_path, artifact)
            return unsupported("arithmetic may overflow or divide by zero in the managed engine") if not ElisaCoreIR::scalar_expression_is_defined(program)
            return unsupported("the left literal has no usable source span") if not position_is_usable(program.left_position)
            return unsupported("the right literal has no usable source span") if not position_is_usable(program.right_position)
            return unsupported("the arithmetic expression has no usable source span") if not position_is_usable(program.expression_position)
            return unsupported("the return statement has no usable source span") if not position_is_usable(program.return_position)
            append_header(&artifact, ElisaEDIR::Instruction::BINARY_COUNT, ElisaEDIR::Shape::NO_LOCALS, source_identity)
            append_instruction(&artifact, ElisaEDIR::Instruction::CONSTANT_OPCODE, program.left, program.left_position)
            append_instruction(&artifact, core_ir_opcode(program.operator), program.right, program.expression_position)
            append_instruction(&artifact, ElisaEDIR::Instruction::RETURN_OPCODE, ElisaEDIR::Shape::NO_OPERAND, program.return_position)
            return unsupported("`main` function descriptor has no usable source span") if not append_single_function_table(&artifact, ElisaEDIR::Function::MAIN_NAME, function_position, ElisaEDIR::Instruction::BINARY_COUNT)
            return write_artifact_or_report(output_path, artifact)



        def root_source_map_is_single_file() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            line_map: mutable darray[u8] = []
            return false if not (driver_line_map_value(&line_map) can Global.Read)
            entries: mutable usize = 0
            for line_map_byte in line_map |entries, line_map|:
                entries <- entries + ElisaEDIR::Binary::BYTE_WIDTH if line_map_byte == ElisaEDIR::Encoding::NEWLINE_BYTE
            return entries == ElisaEDIR::Shape::SOURCE_MAP_ENTRY_COUNT



        def write_all(descriptor: i64, bytes: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            return false if bytes.count == 0
            offset: mutable usize = 0
            while offset < bytes.count |offset, bytes|:
                chunk: void& = (&bytes[offset]).cast[void&] can Unsafe.PointerCast
                written: isize = write(descriptor, chunk, bytes.count - offset) can Console, Unsafe.PointerCast
                return false if:
                    written <= ElisaEDIR::FileSystem::WRITE_NO_PROGRESS
                    written.usize() > bytes.count - offset
                offset <- offset + written.usize()
            return true



    public:
        def prepare_output(output_path: darray[u8]&) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            return ElisaEDIR::Status::FAILURE if:
                output_path.count <= ElisaEDIR::Binary::BYTE_WIDTH
                output_path[output_path.count - ElisaEDIR::Binary::BYTE_WIDTH] != ElisaEDIR::Encoding::NUL_BYTE
            path: cstr = (&output_path[ElisaEDIR::SourcePath::FIRST_BYTE_INDEX]).cast[cstr] can Unsafe.PointerCast
            descriptor: i64 = open(path, ElisaEDIR::FileSystemOpen::OPEN_WRITE_CREATE_TRUNCATE, ElisaEDIR::FileSystem::OUTPUT_FILE_MODE) can Blocking.IO, Unsafe.PointerCast
            if descriptor == ElisaEDIR::FileSystem::OUTPUT_DESCRIPTOR_FAILURE:
                output_error: mutable darray[u8] = ProjectSystem::bytes_from_view("error: -emit edir could not open or truncate the requested -o path\n")
                write_stderr(output_error)
                return ElisaEDIR::Status::FAILURE
            close_result: i64 = close(descriptor) can Blocking.IO, Unsafe.PointerCast
            if close_result < ElisaEDIR::Status::SYSCALL_ERROR_THRESHOLD:
                close_error: mutable darray[u8] = ProjectSystem::bytes_from_view("error: -emit edir could not close the prepared -o path\n")
                write_stderr(close_error)
                return ElisaEDIR::Status::FAILURE
            return ElisaEDIR::Status::SUCCESS



    private:
        def write_artifact(output_path: darray[u8]&, bytes: darray[u8]&) -> bool can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            return false if:
                output_path.count <= ElisaEDIR::Binary::BYTE_WIDTH
                output_path[output_path.count - ElisaEDIR::Binary::BYTE_WIDTH] != ElisaEDIR::Encoding::NUL_BYTE
            path: cstr = (&output_path[ElisaEDIR::SourcePath::FIRST_BYTE_INDEX]).cast[cstr] can Unsafe.PointerCast
            descriptor: i64 = open(path, ElisaEDIR::FileSystemOpen::OPEN_WRITE_CREATE_TRUNCATE, ElisaEDIR::FileSystem::OUTPUT_FILE_MODE) can Blocking.IO, Unsafe.PointerCast
            return false if descriptor == ElisaEDIR::FileSystem::OUTPUT_DESCRIPTOR_FAILURE
            wrote_all: bool = write_all(descriptor, bytes) can Blocking.IO, Unsafe.PointerCast
            close_result: i64 = close(descriptor) can Blocking.IO, Unsafe.PointerCast
            return false if not wrote_all or close_result < ElisaEDIR::Status::SYSCALL_ERROR_THRESHOLD
            return true



        def write_artifact_or_report(output_path: darray[u8]&, bytes: darray[u8]&) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            wrote_artifact: bool = write_artifact(output_path, bytes) can Blocking.IO, Unsafe.PointerCast
            return ElisaEDIR::Status::SUCCESS if wrote_artifact
            artifact_error: mutable darray[u8] = []
            emit_tokens_push_sview(&artifact_error, "error: -emit edir could not write the complete artifact to the requested -o path\n")
            write_stderr(artifact_error)
            return ElisaEDIR::Status::FAILURE

    public:
        def emit(file: Ast::File&, output_path: darray[u8]&, static_generation_expanded: bool, parsed_source: u8&, parsed_source_length: usize) -> i64 can[Abort.Panic, Blocking.IO, Memory.Allocate, Unsafe.PointerCast, Console]:
            return unsupported("static-generate source mapping is not supported yet") if static_generation_expanded
            return unsupported("include-expanded source mapping is not supported yet") if not (root_source_map_is_single_file() can Global.Read)
            return unsupported("an explicit `-o` output path is required") if output_path.count <= ElisaEDIR::Binary::BYTE_WIDTH
            source_identity: mutable EDIRSourceIdentity = zeroed
            if source_identity_create(parsed_source, parsed_source_length) is source_identity_value:
                source_identity <- source_identity_value
            else:
                return unsupported("source path or parsed source identity is invalid; relative paths are required unless ELISA_EDIR_SOURCE_ROOT is set")
            return unsupported("the file must contain a `main` function and no more than the portable declaration limit") if file.top_decls.count == 0 or file.top_decls.count > ElisaEDIR::Function::MAX_TOP_LEVEL_DECLARATIONS
            if file.top_decls.count > ElisaEDIR::Shape::TOP_LEVEL_DECLARATION_COUNT:
                function_plans: mutable darray[EDIRFunctionPlan] = []
                function_error: mutable sview = ""
                return unsupported("the portable function form requires a parameterless `main`, uniquely named `i64` helpers with one immutable `i64` parameter, optional `can[Console]` or `can[IO]`, and at most one DebuggerHostEffects module containing clock, random, console, virtual-file byte reads/writes, or virtual-file seek operations") if not collect_function_plans(file, &function_plans, &function_error)
                return functions_artifact(output_path, function_plans, source_identity)

            match file.top_decls[ElisaEDIR::Shape::FIRST_TOP_LEVEL_DECLARATION_INDEX]:
                Ast::Decl.Func(function_name, parameters, return_type, body, effects, decorators, function_position):
                    return unsupported("the only function must be named `main`") if function_name != ElisaEDIR::Function::MAIN_NAME
                    return unsupported("`main` must have no parameters") if parameters.count != ElisaEDIR::Shape::PARAMETER_COUNT
                    if return_type is declared_type_expression:
                        match declared_type_expression:
                            Ast::Expr.Ident(type_name, type_position):
                                return unsupported("`main` must have an explicit `i64` return type") if type_name != "i64"
                            _:
                                return unsupported("`main` must have an explicit `i64` return type")
                    else:
                        return unsupported("`main` must have an explicit `i64` return type")
                    return unsupported("only the explicit `Console` effect is supported in this slice") if not function_effects_supported(effects)
                    return unsupported("function decorators are not supported in this slice") if decorators.count != 0
                    main_source_span: Ast::Pos = function_source_span(function_position, body, file.enum_annotations)
                    return unsupported("`main` function descriptor has no usable source span") if not position_is_usable(main_source_span)
                    if ElisaCoreIR::lower_main(file) is core_program:
                        return core_ir_artifact(output_path, core_program, main_source_span, source_identity)
                    if body.count == ElisaEDIR::CountedLoop::STATEMENT_COUNT:
                        return counted_loop_artifact(output_path, body, main_source_span, source_identity)
                    return unsupported("`main` must contain one return, one typed local followed by return, or one supported counted loop") if body.count != ElisaEDIR::Shape::STATEMENT_COUNT and body.count != ElisaEDIR::Shape::LOCAL_STATEMENT_COUNT
                    if body.count == ElisaEDIR::Shape::STATEMENT_COUNT:
                        match body[ElisaEDIR::Shape::FIRST_STATEMENT_INDEX]:
                            Ast::Stmt.Return(return_value, return_position):
                                if return_value is returned_expression:
                                    match returned_expression:
                                        Ast::Expr.IntLit(literal_value, literal_position):
                                            return literal_artifact(output_path, literal_value, literal_position, return_position, main_source_span, source_identity)
                                        Ast::Expr.Binary(left, operator, right, _):
                                            supported_operator: mutable bool = false
                                            opcode: u16 = binary_opcode(operator, &supported_operator)
                                            return unsupported("the return arithmetic operator must be `+`, `-`, `*`, or `/`") if not supported_operator
                                            match left:
                                                Ast::Expr.IntLit(left_value, left_position):
                                                    match right:
                                                        Ast::Expr.IntLit(right_value, right_position):
                                                            return binary_artifact(output_path, opcode, left_value, left_position, right_value, right_position, return_position, main_source_span, source_identity)
                                                        _:
                                                            return unsupported("both operands of return arithmetic must be integer literals")
                                                _:
                                                    return unsupported("both operands of return arithmetic must be integer literals")
                                        _:
                                            return unsupported("`main` must return an integer literal or a supported integer-literal arithmetic expression")
                                else:
                                    return unsupported("`main` must return an integer literal or a supported integer-literal arithmetic expression")
                            _:
                                return unsupported("the single statement in `main` must be a return")
                    match body[ElisaEDIR::Shape::FIRST_STATEMENT_INDEX]:
                        Ast::Stmt.VarDecl(local_name, local_type, local_initializer, declaration_position):
                            return unsupported("the local name must be a named identifier") if local_name == "" or local_name == "_"
                            match local_type:
                                Ast::Expr.Ident(local_type_name, _):
                                    return unsupported("the local must have an explicit `i64` type") if local_type_name != "i64"
                                _:
                                    return unsupported("the local must have an explicit `i64` type")
                            match local_initializer:
                                Ast::Expr.IntLit(local_value, initializer_position):
                                    match body[ElisaEDIR::Shape::SECOND_STATEMENT_INDEX]:
                                        Ast::Stmt.Return(return_value, return_position):
                                            if return_value is returned_expression:
                                                return local_return_artifact(output_path, local_name, local_value, declaration_position, initializer_position, returned_expression, return_position, main_source_span, source_identity)
                                            else:
                                                return unsupported("the second statement in `main` must return the initialized local")
                                        _:
                                            return unsupported("the second statement in `main` must be a return")
                                _:
                                    return unsupported("the local initializer must be an integer literal")
                        _:
                            return unsupported("the first statement in `main` must be one typed local declaration")
                _:
                    return unsupported("the only top-level declaration must be `def main`")
