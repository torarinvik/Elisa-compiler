# `-emit unsafe` — stage0's unsafe_report.go, the RULES half: which `Unsafe.*` capability each
# construct implies. A bare subscript on a runtime-length container, an alias reborrow through a
# mutable reference, and the rest are applied per expression and per statement.


# `-emit unsafe` — stage0's unsafe_report.go: which functions hold which Unsafe.*
# capabilities, and which boundary invariants those capabilities put in force.
#
# The capability set is a TRANSITIVE CLOSURE, not a reading of each `can[...]` clause: a
# function calling an extern holds Unsafe.RawExtern without declaring it. The model below is
# validated against stage0 by test/parity/unsafe_permission_model_probe.py at 40/40 with
# ZERO over-claim, and it is entirely AST-decidable — no bounds prover, and nothing recorded
# into `table.diagnostics`, because a REQUIREMENT is not a VIOLATION (stage0 reports
# `Unsafe.UncheckedIndex` for a darray subscript while exiting 0).
#
#   1. declared Unsafe.* effects, from the signature AND in-body `can`/`trusted` clauses
#   2. every callable extern contributes Unsafe.RawExtern
#   3. transitive closure over the call graph
#   4. a bare subscript on a RUNTIME-LENGTH container (darray) needs Unsafe.UncheckedIndex,
#      unless the index is a binder proven against a `.count`
#   5. `(&xs[0]).cast[T]` needs Unsafe.BufferReinterpret


def unsafe_capability_at(index: i64) -> sview can[Abort.Panic]:
    return when index:
        0 -> "PointerCast"
        1 -> "PointerArithmetic"
        2 -> "IndirectCall"
        3 -> "UncheckedIndex"
        4 -> "RawExtern"
        5 -> "MutableGlobal"
        6 -> "ThreadShare"
        7 -> "StaleRef"
        8 -> "Alias"
        9 -> "BufferReinterpret"
        10 -> "Assembly"
        11 -> "ExecutableCodePublish"
        12 -> "GuestHostPointerCast"
        13 -> "PoisonPointerSentinel"
        14 -> "TinyPointerSentinel"
        15 -> "SegmentMutation"
        16 -> "GuestSegmentInstall"
        17 -> "CrossThreadSignalJump"
        18 -> "MachineCodeBuilder"
        19 -> "NonProgress"
        20 -> "BlockMain"
        21 -> "AssumeProgress"
        _ -> ""




# Does `text` spell `Unsafe.<capability>`? Compared with an OFFSET rather than by slicing:
# sview has no slice operation, only sview_len/sview_at.
def unsafe_permission_is(text: sview, capability: sview) -> bool can[Abort.Panic]:
    false return if sview_len(text) != 7 + sview_len(capability)
    for prefix_index in 0..<7 |text|:
        false return if sview_at(text, prefix_index) != sview_at("Unsafe.", prefix_index)
    for member_index in 0..<sview_len(capability) |text, capability|:
        false return if sview_at(text, 7 + member_index) != sview_at(capability, member_index)
    return true




def unsafe_permission_is_unsafe(text: sview) -> bool can[Abort.Panic]:
    false return if sview_len(text) <= 7
    for prefix_index in 0..<7 |text|:
        false return if sview_at(text, prefix_index) != sview_at("Unsafe.", prefix_index)
    return true




def unsafe_name_less(a: sview, b: sview) -> bool can[Abort.Panic]:
    limit: usize = sview_len(a) if sview_len(a) < sview_len(b) else sview_len(b)
    for index in 0..<limit |a, b|:
        left: u8 = sview_at(a, index)
        right: u8 = sview_at(b, index)
        true return if left < right
        false return if left > right
    return sview_len(a) < sview_len(b)




# Add (owner, capability) unless already present.
def unsafe_add_row(owners: mutable darray[sview]&, caps: mutable darray[sview]&, owner: sview, cap: sview) -> void can[Abort.Panic, Memory.Allocate]:
    for existing in 0..<owners.count |owners, caps, owner, cap|:
        return if owners[existing] == owner and caps[existing] == cap
    owners.push(owner)
    caps.push(cap)




# One expression's contribution: rule 4 (bare subscript on a runtime-length container),
# rule 5 (`(&xs[0]).cast[T]`), and the CALL EDGES for the closure.
#
# `Expr.Index` is ALREADY the unchecked form — a `get x[i]` / `x[i] else v` parses to
# `Expr.GetElse`, a different node — so no textual disambiguation is needed.
def unsafe_scan_expression(expression: Ast::Expr, owner: sview, runtime_names: mutable darray[sview]&, proven: mutable darray[sview]&, owners: mutable darray[sview]&, caps: mutable darray[sview]&, call_from: mutable darray[sview]&, call_to: mutable darray[sview]&, trusted_owners: mutable darray[sview]&, trusted_caps: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        match expression:
            Expr.Index(us_object, us_index, us_line):
                # `p.cast[T]` parses as an INDEX whose object is `Field(p, "cast")`, so the
                # reinterpret rule lives here rather than in a Cast node (there is none).
                # `(&xs[0]).cast[T]` reinterprets the container's buffer.
                if us_object is Expr.Field(us_cast_base, us_cast_method, us_cast_line):
                    if us_cast_method == "cast":
                        if us_cast_base is Expr.Unary(us_amp_op, us_amp_operand, us_amp_line):
                            if us_amp_op == Lexer::TokenKind.Ampersand:
                                if us_amp_operand is Expr.Index(us_buf_object, us_buf_index, us_buf_line):
                                    us_buf_name: sview = unsafe_ident_name(us_buf_object)
                                    us_buf_runtime: mutable bool = false
                                    for runtime_name in runtime_names |us_buf_runtime, us_buf_name|:
                                        us_buf_runtime <- true if runtime_name == us_buf_name
                                    unsafe_add_row(owners, caps, owner, "Unsafe.BufferReinterpret") if us_buf_runtime
                us_object_name: sview = unsafe_ident_name(us_object)
                us_index_name: sview = unsafe_ident_name(us_index)
                us_is_runtime: mutable bool = false
                for runtime_name in runtime_names |us_is_runtime, us_object_name|:
                    us_is_runtime <- true if runtime_name == us_object_name
                us_index_proven: mutable bool = false
                for proven_name in proven |us_index_proven, us_index_name|:
                    us_index_proven <- true if proven_name == us_index_name
                unsafe_add_row(owners, caps, owner, "Unsafe.UncheckedIndex") if us_is_runtime and not us_index_proven
                unsafe_scan_expression(us_object, owner, runtime_names, proven, owners, caps, call_from, call_to, trusted_owners, trusted_caps)
                unsafe_scan_expression(us_index, owner, runtime_names, proven, owners, caps, call_from, call_to, trusted_owners, trusted_caps)
            Expr.Call(us_callee, us_arguments, us_argument_names, us_call_line):
                us_callee_name: sview = unsafe_ident_name(us_callee)
                if us_callee_name != "":
                    call_from.push(owner)
                    call_to.push(us_callee_name)
                unsafe_scan_expression(us_callee, owner, runtime_names, proven, owners, caps, call_from, call_to, trusted_owners, trusted_caps)
                for us_argument in us_arguments |owner, runtime_names, proven, owners, caps, call_from, call_to|:
                    unsafe_scan_expression(us_argument, owner, runtime_names, proven, owners, caps, call_from, call_to, trusted_owners, trusted_caps)
            Expr.Binary(us_left, us_op, us_right, us_bin_line):
                unsafe_scan_expression(us_left, owner, runtime_names, proven, owners, caps, call_from, call_to, trusted_owners, trusted_caps)
                unsafe_scan_expression(us_right, owner, runtime_names, proven, owners, caps, call_from, call_to, trusted_owners, trusted_caps)
            Expr.Unary(us_un_op, us_un_operand, us_un_line):
                unsafe_scan_expression(us_un_operand, owner, runtime_names, proven, owners, caps, call_from, call_to, trusted_owners, trusted_caps)
            Expr.Paren(us_paren_inner, us_paren_line):
                unsafe_scan_expression(us_paren_inner, owner, runtime_names, proven, owners, caps, call_from, call_to, trusted_owners, trusted_caps)
            Expr.Field(us_field_object, us_field_name, us_field_line):
                unsafe_scan_expression(us_field_object, owner, runtime_names, proven, owners, caps, call_from, call_to, trusted_owners, trusted_caps)
            Expr.If(us_if_then, us_if_cond, us_if_else, us_if_line):
                unsafe_scan_expression(us_if_then, owner, runtime_names, proven, owners, caps, call_from, call_to, trusted_owners, trusted_caps)
                unsafe_scan_expression(us_if_cond, owner, runtime_names, proven, owners, caps, call_from, call_to, trusted_owners, trusted_caps)
                unsafe_scan_expression(us_if_else, owner, runtime_names, proven, owners, caps, call_from, call_to, trusted_owners, trusted_caps)
            Expr.Block(us_blk_stmts, us_blk_value, us_blk_captures, us_blk_line):
                # A loop carrying a `|capture|` header lowers its BODY to a value block, so a
                # subscript inside `for i in 0..<n |xs|:` lives here and not under Stmt.For.
                # Without this arm every captured loop body was invisible to the scan.
                unsafe_scan_statements(us_blk_stmts, owner, runtime_names, proven, owners, caps, call_from, call_to, trusted_owners, trusted_caps)
                unsafe_scan_expression(us_blk_value, owner, runtime_names, proven, owners, caps, call_from, call_to, trusted_owners, trusted_caps)
            _:
                pass




def unsafe_ident_name(expression: Ast::Expr) -> sview can[Abort.Panic, Memory.Allocate]:
    if expression is Expr.Ident(us_id_name, us_id_line):
        return us_id_name
    return ""




# A mutable-reference parameter is the only alias reborrow shape the report can determine
# without running the full semantic analyzer: `mutable T&` / `lmut T` at a callee boundary,
# receiving a caller parameter that is itself a mutable reference. Stage0 charges that call
# with Unsafe.Alias because the callee receives a second live mutable view of the caller's
# storage. Keep this table separate from the unchecked-index scanner so the audit stays
# type-aware without changing code generation or the normal semantic gate.
def unsafe_type_is_ref(type_expression: Ast::Expr) -> bool can[Abort.Panic]:
    if type_expression is Expr.Unary(us_ref_operator, us_ref_operand, us_ref_line):
        return us_ref_operator == Lexer::TokenKind.Ampersand
    return false




def unsafe_type_is_mutable_ref(type_expression: Ast::Expr) -> bool can[Abort.Panic]:
    if type_expression is Expr.Unary(us_mut_operator, us_mut_operand, us_mut_line):
        return (us_mut_operator == Lexer::TokenKind.Mutable or us_mut_operator == Lexer::TokenKind.Lmut) and unsafe_type_is_ref(us_mut_operand)
    return false




def unsafe_collect_alias_param_info(declarations: darray[Ast::Decl], fn_names: mutable darray[sview]&, fn_indices: mutable darray[usize]&, param_names: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |fn_names, fn_indices, param_names|:
        match declaration:
            Decl.Module(us_module_name, us_module_body, us_module_line):
                unsafe_collect_alias_param_info(us_module_body, fn_names, fn_indices, param_names)
            Decl.Scoped(us_scoped_body, us_scoped_line):
                unsafe_collect_alias_param_info(us_scoped_body, fn_names, fn_indices, param_names)
            Decl.Func(us_function_name, us_function_params, us_function_return, us_function_body, us_function_effects, us_function_decorators, us_function_line):
                for parameter_index in 0..<us_function_params.count |fn_names, fn_indices, param_names|:
                    parameter: Ast::ParamDecl = us_function_params[parameter_index]
                    if unsafe_type_is_mutable_ref(parameter.type_expression):
                        fn_names.push(us_function_name)
                        fn_indices.push(parameter_index)
                        param_names.push(parameter.name)
            _:
                pass




def unsafe_alias_param_present(fn_names: darray[sview]&, fn_indices: darray[usize]&, param_names: darray[sview]&, function_name: sview, parameter_index: usize) -> bool can[Abort.Panic]:
    for row in 0..<fn_names.count |fn_names, fn_indices, function_name, parameter_index|:
        return true if fn_names[row] == function_name and fn_indices[row] == parameter_index
    return false




def unsafe_alias_owner_param_present(fn_names: darray[sview]&, param_names: darray[sview]&, owner: sview, parameter_name: sview) -> bool can[Abort.Panic]:
    for row in 0..<fn_names.count |fn_names, param_names, owner, parameter_name|:
        return true if fn_names[row] == owner and param_names[row] == parameter_name
    return false




def unsafe_scan_alias_expression(expression: Ast::Expr, owner: sview, captured: bool, fn_names: darray[sview]&, fn_indices: darray[usize]&, param_names: darray[sview]&, owners: mutable darray[sview]&, caps: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    match expression:
        Expr.Call(us_alias_callee, us_alias_arguments, us_alias_argument_names, us_alias_line):
            callee_name: sview = unsafe_ident_name(us_alias_callee)
            if callee_name != "":
                for argument_index in 0..<us_alias_arguments.count |owners, caps, fn_names, fn_indices, param_names, owner, callee_name, us_alias_arguments|:
                    argument_name: sview = unsafe_ident_name(us_alias_arguments[argument_index])
                    if captured and argument_name != "" and unsafe_alias_param_present(fn_names, fn_indices, param_names, callee_name, argument_index) and unsafe_alias_owner_param_present(fn_names, param_names, owner, argument_name):
                        unsafe_add_row(owners, caps, owner, "Unsafe.Alias")
            unsafe_scan_alias_expression(us_alias_callee, owner, captured, fn_names, fn_indices, param_names, owners, caps)
            for argument in us_alias_arguments |owner, fn_names, fn_indices, param_names, owners, caps|:
                unsafe_scan_alias_expression(argument, owner, captured, fn_names, fn_indices, param_names, owners, caps)
        Expr.Index(us_alias_object, us_alias_index, us_alias_index_line):
            unsafe_scan_alias_expression(us_alias_object, owner, captured, fn_names, fn_indices, param_names, owners, caps)
            unsafe_scan_alias_expression(us_alias_index, owner, captured, fn_names, fn_indices, param_names, owners, caps)
        Expr.IndexN(us_alias_n_object, us_alias_n_arguments, us_alias_n_line):
            unsafe_scan_alias_expression(us_alias_n_object, owner, captured, fn_names, fn_indices, param_names, owners, caps)
            for argument in us_alias_n_arguments |owner, fn_names, fn_indices, param_names, owners, caps|:
                unsafe_scan_alias_expression(argument, owner, captured, fn_names, fn_indices, param_names, owners, caps)
        Expr.Binary(us_alias_left, us_alias_operator, us_alias_right, us_alias_binary_line):
            unsafe_scan_alias_expression(us_alias_left, owner, captured, fn_names, fn_indices, param_names, owners, caps)
            unsafe_scan_alias_expression(us_alias_right, owner, captured, fn_names, fn_indices, param_names, owners, caps)
        Expr.Unary(us_alias_unary_operator, us_alias_operand, us_alias_unary_line):
            unsafe_scan_alias_expression(us_alias_operand, owner, captured, fn_names, fn_indices, param_names, owners, caps)
        Expr.Paren(us_alias_inner, us_alias_paren_line):
            unsafe_scan_alias_expression(us_alias_inner, owner, captured, fn_names, fn_indices, param_names, owners, caps)
        Expr.Field(us_alias_field_object, us_alias_field_name, us_alias_field_line):
            unsafe_scan_alias_expression(us_alias_field_object, owner, captured, fn_names, fn_indices, param_names, owners, caps)
        Expr.If(us_alias_if_condition, us_alias_if_then, us_alias_if_else, us_alias_if_line):
            unsafe_scan_alias_expression(us_alias_if_condition, owner, captured, fn_names, fn_indices, param_names, owners, caps)
            unsafe_scan_alias_expression(us_alias_if_then, owner, captured, fn_names, fn_indices, param_names, owners, caps)
            unsafe_scan_alias_expression(us_alias_if_else, owner, captured, fn_names, fn_indices, param_names, owners, caps)
        Expr.Block(us_alias_block_stmts, us_alias_block_value, us_alias_block_captures, us_alias_block_line):
            block_captured: bool = captured or us_alias_block_captures.count > 0
            unsafe_scan_alias_statements(us_alias_block_stmts, owner, block_captured, fn_names, fn_indices, param_names, owners, caps)
            unsafe_scan_alias_expression(us_alias_block_value, owner, block_captured, fn_names, fn_indices, param_names, owners, caps)
        _:
            pass




def unsafe_scan_alias_statements(statements: darray[Ast::Stmt], owner: sview, captured: bool, fn_names: darray[sview]&, fn_indices: darray[usize]&, param_names: darray[sview]&, owners: mutable darray[sview]&, caps: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    for statement in statements |owner, fn_names, fn_indices, param_names, owners, caps|:
        match statement:
            Stmt.VarDecl(us_alias_decl_name, us_alias_decl_type, us_alias_decl_value, us_alias_decl_line):
                unsafe_scan_alias_expression(us_alias_decl_value, owner, captured, fn_names, fn_indices, param_names, owners, caps)
            Stmt.Expr(us_alias_expression, us_alias_expr_line):
                unsafe_scan_alias_expression(us_alias_expression, owner, captured, fn_names, fn_indices, param_names, owners, caps)
            Stmt.Return(us_alias_return_value, us_alias_return_line):
                if us_alias_return_value is us_alias_returned:
                    unsafe_scan_alias_expression(us_alias_returned, owner, captured, fn_names, fn_indices, param_names, owners, caps)
            Stmt.Assign(us_alias_target, us_alias_assign_operator, us_alias_assign_value, us_alias_assign_line):
                unsafe_scan_alias_expression(us_alias_target, owner, captured, fn_names, fn_indices, param_names, owners, caps)
                unsafe_scan_alias_expression(us_alias_assign_value, owner, captured, fn_names, fn_indices, param_names, owners, caps)
            Stmt.If(us_alias_condition, us_alias_then, us_alias_else, us_alias_if_line):
                unsafe_scan_alias_expression(us_alias_condition, owner, captured, fn_names, fn_indices, param_names, owners, caps)
                unsafe_scan_alias_statements(us_alias_then, owner, captured, fn_names, fn_indices, param_names, owners, caps)
                unsafe_scan_alias_statements(us_alias_else, owner, captured, fn_names, fn_indices, param_names, owners, caps)
            Stmt.While(us_alias_while_condition, us_alias_while_body, us_alias_while_line):
                unsafe_scan_alias_expression(us_alias_while_condition, owner, captured, fn_names, fn_indices, param_names, owners, caps)
                unsafe_scan_alias_statements(us_alias_while_body, owner, captured, fn_names, fn_indices, param_names, owners, caps)
            Stmt.For(us_alias_for_bind, us_alias_for_variables, us_alias_for_iterable, us_alias_for_body, us_alias_for_line):
                unsafe_scan_alias_expression(us_alias_for_iterable, owner, captured, fn_names, fn_indices, param_names, owners, caps)
                unsafe_scan_alias_statements(us_alias_for_body, owner, captured, fn_names, fn_indices, param_names, owners, caps)
            Stmt.Block(us_alias_block_kind, us_alias_block_clause, us_alias_block_binding, us_alias_block_body, us_alias_block_line):
                unsafe_scan_alias_statements(us_alias_block_body, owner, captured, fn_names, fn_indices, param_names, owners, caps)
            Stmt.Match(us_alias_scrutinee, us_alias_arms, us_alias_match_line):
                unsafe_scan_alias_expression(us_alias_scrutinee, owner, captured, fn_names, fn_indices, param_names, owners, caps)
                for arm in us_alias_arms |owner, fn_names, fn_indices, param_names, owners, caps|:
                    unsafe_scan_alias_expression(arm.guard, owner, captured, fn_names, fn_indices, param_names, owners, caps)
                    unsafe_scan_alias_statements(arm.body, owner, captured, fn_names, fn_indices, param_names, owners, caps)
            Stmt.Contract(us_alias_contract_kind, us_alias_contract_expression, us_alias_contract_line):
                unsafe_scan_alias_expression(us_alias_contract_expression, owner, captured, fn_names, fn_indices, param_names, owners, caps)
            _:
                pass




def unsafe_collect_alias_reborrows(declarations: darray[Ast::Decl], fn_names: darray[sview]&, fn_indices: darray[usize]&, param_names: darray[sview]&, owners: mutable darray[sview]&, caps: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |fn_names, fn_indices, param_names, owners, caps|:
        match declaration:
            Decl.Module(us_alias_module_name, us_alias_module_body, us_alias_module_line):
                unsafe_collect_alias_reborrows(us_alias_module_body, fn_names, fn_indices, param_names, owners, caps)
            Decl.Scoped(us_alias_scoped_body, us_alias_scoped_line):
                unsafe_collect_alias_reborrows(us_alias_scoped_body, fn_names, fn_indices, param_names, owners, caps)
            Decl.Func(us_alias_function_name, us_alias_function_params, us_alias_function_return, us_alias_function_body, us_alias_function_effects, us_alias_function_decorators, us_alias_function_line):
                unsafe_scan_alias_statements(us_alias_function_body, us_alias_function_name, false, fn_names, fn_indices, param_names, owners, caps)
            _:
                pass




# Is this annotation a RUNTIME-LENGTH container (`darray[T]`)? A fixed `array[T, N]` carries
# its extent in the type, so its subscripts can be proven.
def unsafe_is_runtime_length(type_expression: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        if type_expression is Expr.Index(us_rt_object, us_rt_index, us_rt_line):
            return unsafe_ident_name(us_rt_object) == "darray"
        if type_expression is Expr.IndexN(us_rtn_object, us_rtn_args, us_rtn_line):
            return unsafe_ident_name(us_rtn_object) == "darray"
        if type_expression is Expr.Unary(us_rt_op, us_rt_operand, us_rt_op_line):
            return unsafe_is_runtime_length(us_rt_operand)
        if type_expression is Expr.Paren(us_rt_inner, us_rt_paren_line):
            return unsafe_is_runtime_length(us_rt_inner)
        return false
