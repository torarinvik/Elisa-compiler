# `.elisair` v2 — STATEMENT nodes, plus the body probes stage0's auto-region trigger depends on
# (does a local here declare a heap container?) and the discard form of an assignment target.
# Continues frontend_ir_write.elisa.

extend IrWrite:
    private:

        # ---- statements ---------------------------------------------------------

        def ir_stmt_node(bodies: mutable darray[u8]&, nodes: mutable u32&, refusal: mutable darray[u8]&, statement: Ast::Stmt, filename: sview) -> u32:
            can Memory.Allocate, Abort.Panic:
                fields: mutable darray[u8] = []
                live: mutable u32 = 0
                match statement:
                    Ast::Stmt.Invalid:
                        ir_refuse(refusal, "malformed statement")
                        return 0
                    Ast::Stmt.Expr(expression, expr_pos):
                        expression_id: u32 = ir_expr_node(bodies, nodes, refusal, expression, filename)
                        ir_put_node(&fields, &live, FrontendIrExpressionStatementEncoding::field_id(FrontendIrExpressionStatementEncoding::ExpressionStatementField.Expr), expression_id)
                        ir_put_pos(&fields, &live, FrontendIrExpressionStatementEncoding::field_id(FrontendIrExpressionStatementEncoding::ExpressionStatementField.Position), expr_pos, filename)
                        return ir_emit_node(bodies, nodes, FrontendIrExpressionStatementEncoding::node_type_id(), fields, live)
                    Ast::Stmt.Return(value, return_pos):
                        value_id: mutable u32 = FrontendIrReturnStatementEncoding::no_value_node_id()
                        if value is return_value:
                            value_id <- ir_expr_node(bodies, nodes, refusal, return_value, filename)
                        ir_put_pos(&fields, &live, FrontendIrReturnStatementEncoding::field_id(FrontendIrReturnStatementEncoding::ReturnStatementField.Position), return_pos, filename)
                        ir_put_node(&fields, &live, FrontendIrReturnStatementEncoding::field_id(FrontendIrReturnStatementEncoding::ReturnStatementField.Value), value_id)
                        return ir_emit_node(bodies, nodes, FrontendIrReturnStatementEncoding::node_type_id(), fields, live)
                    Ast::Stmt.VarDecl(name, type_expression, value, var_pos):
                        # stage0 carries a local's mutability on the STATEMENT and its type
                        # WITHOUT the qualifier; emitting both printed `mutable mutable i64`.
                        type_id: u32 = ir_type_node(bodies, nodes, refusal, ir_strip_mutable(type_expression), filename)
                        value_id: u32 = ir_expr_node(bodies, nodes, refusal, value, filename)
                        ir_put_bool(&fields, &live, 2, ir_type_is_mutable(type_expression))
                        ir_put_str(&fields, &live, 3, name)
                        ir_put_pos(&fields, &live, 5, var_pos, filename)
                        ir_put_node(&fields, &live, 6, type_id)
                        ir_put_node(&fields, &live, 7, value_id)
                        return ir_emit_node(bodies, nodes, 271, fields, live)
                    Ast::Stmt.Assign(target, operator, value, assign_pos):
                        target_id: u32 = ir_expr_node(bodies, nodes, refusal, target, filename)
                        value_id: u32 = ir_expr_node(bodies, nodes, refusal, value, filename)
                        # The three forms are three different stage0 nodes, and the
                        # difference is not cosmetic: `=` DEFINES a local (or discards, for
                        # `_`), `<-` MUTATES an existing one, and a compound carries its
                        # operator. Collapsing them printed `_ <- b` for a discard.
                        if operator == TokenKind.Assign:
                            if ir_is_underscore(target):
                                ir_put_pos(&fields, &live, 1, assign_pos, filename)
                                ir_put_node(&fields, &live, 2, value_id)
                                return ir_emit_node(bodies, nodes, 40, fields, live)
                            bound_name: mutable darray[u8] = []
                            if not ir_dotted_name(&bound_name, target):
                                ir_refuse(refusal, "definition target")
                                return 0
                            ir_put_str(&fields, &live, 3, bytes_view_range(bound_name, 0, bound_name.count))
                            ir_put_pos(&fields, &live, 5, assign_pos, filename)
                            ir_put_node(&fields, &live, 7, value_id)
                            return ir_emit_node(bodies, nodes, 271, fields, live)
                        if operator == TokenKind.LArrow:
                            ir_put_pos(&fields, &live, 5, assign_pos, filename)
                            ir_put_node(&fields, &live, 6, target_id)
                            ir_put_node(&fields, &live, 7, value_id)
                            return ir_emit_node(bodies, nodes, 12, fields, live)
                        ir_put_int(&fields, &live, 1, emit_tokens_kind_code(operator).i64() - 1)
                        ir_put_pos(&fields, &live, 2, assign_pos, filename)
                        ir_put_node(&fields, &live, 3, target_id)
                        ir_put_node(&fields, &live, 4, value_id)
                        return ir_emit_node(bodies, nodes, 14, fields, live)
                    Ast::Stmt.If(condition, then_body, else_body, if_pos):
                        condition_id: u32 = ir_expr_node(bodies, nodes, refusal, condition, filename)
                        then_ids: mutable darray[u32] = []
                        for statement_in_then in then_body |bodies, nodes, refusal, then_ids|:
                            then_ids.push(ir_stmt_node(bodies, nodes, refusal, statement_in_then, filename))
                        else_ids: mutable darray[u32] = []
                        for statement_in_else in else_body |bodies, nodes, refusal, else_ids|:
                            else_ids.push(ir_stmt_node(bodies, nodes, refusal, statement_in_else, filename))
                        ir_put_node(&fields, &live, FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.Condition), condition_id)
                        ir_put_node_list(&fields, &live, FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.ElseBody), else_ids)
                        ir_put_bool(&fields, &live, FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.FromSource), true)
                        ir_put_pos(&fields, &live, FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.Position), if_pos, filename)
                        ir_put_node_list(&fields, &live, FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.ThenBody), then_ids)
                        return ir_emit_node(bodies, nodes, FrontendIrIfStatementEncoding::node_type_id(), fields, live)
                    Ast::Stmt.While(condition, body, while_pos):
                        condition_id: u32 = ir_expr_node(bodies, nodes, refusal, condition, filename)
                        body_ids: mutable darray[u32] = []
                        for statement_in_body in body |bodies, nodes, refusal, body_ids|:
                            body_ids.push(ir_stmt_node(bodies, nodes, refusal, statement_in_body, filename))
                        ir_put_node_list(&fields, &live, FrontendIrWhileStatementEncoding::field_id(FrontendIrWhileStatementEncoding::WhileStmtField.Body), body_ids)
                        ir_put_node(&fields, &live, FrontendIrWhileStatementEncoding::field_id(FrontendIrWhileStatementEncoding::WhileStmtField.Condition), condition_id)
                        ir_put_pos(&fields, &live, FrontendIrWhileStatementEncoding::field_id(FrontendIrWhileStatementEncoding::WhileStmtField.Position), while_pos, filename)
                        return ir_emit_node(bodies, nodes, FrontendIrWhileStatementEncoding::node_type_id(), fields, live)
                    Ast::Stmt.For(bind, variables, iterable, body, for_pos):
                        bind_mode: FrontendIrForStatementEncoding::ForBindingMode = FrontendIrForStatementEncoding::binding_mode(bind)
                        moved_source: bool = FrontendIrForStatementEncoding::is_explicit_move_source(iterable)
                        if not FrontendIrForStatementEncoding::binding_and_source_are_supported(bind_mode, moved_source):
                            ir_refuse(refusal, "for-loop binding mode or moved source")
                            return 0
                        if variables.count != FrontendIrForStatementEncoding::FOR_LOOP_NAME_BINDER_COUNT:
                            ir_refuse(refusal, "destructuring for-loop")
                            return 0
                        source_expression: mutable Ast::Expr = iterable
                        match iterable:
                            Ast::Expr.Move(move_source, _):
                                source_expression <- move_source
                            _:
                                pass
                        pattern_fields: mutable darray[u8] = []
                        pattern_live: mutable u32 = 0
                        ir_put_str(&pattern_fields, &pattern_live, FrontendIrForStatementEncoding::pattern_name_field_id(), variables[0])
                        pattern_id: u32 = ir_emit_node(bodies, nodes, FrontendIrForStatementEncoding::pattern_node_type_id(), pattern_fields, pattern_live)
                        source_id: u32 = ir_expr_node(bodies, nodes, refusal, source_expression, filename)
                        body_ids: mutable darray[u32] = []
                        for statement_in_body in body |bodies, nodes, refusal, body_ids|:
                            body_ids.push(ir_stmt_node(bodies, nodes, refusal, statement_in_body, filename))
                        if bind_mode == FrontendIrForStatementEncoding::ForBindingMode.MutableReference:
                            ir_put_int(&fields, &live, FrontendIrForStatementEncoding::field_id(FrontendIrForStatementEncoding::ForStatementField.Mode), FrontendIrForStatementEncoding::binding_mode_value(bind_mode))
                        if moved_source:
                            ir_put_bool(&fields, &live, FrontendIrForStatementEncoding::field_id(FrontendIrForStatementEncoding::ForStatementField.MovedSource), true)
                        ir_put_node_list(&fields, &live, FrontendIrForStatementEncoding::field_id(FrontendIrForStatementEncoding::ForStatementField.Body), body_ids)
                        ir_put_node(&fields, &live, FrontendIrForStatementEncoding::field_id(FrontendIrForStatementEncoding::ForStatementField.Pattern), pattern_id)
                        ir_put_pos(&fields, &live, FrontendIrForStatementEncoding::field_id(FrontendIrForStatementEncoding::ForStatementField.Position), for_pos, filename)
                        ir_put_node(&fields, &live, FrontendIrForStatementEncoding::field_id(FrontendIrForStatementEncoding::ForStatementField.Source), source_id)
                        return ir_emit_node(bodies, nodes, FrontendIrForStatementEncoding::node_type_id(), fields, live)
                    # stage0's BreakStmt and ContinueStmt carry no label, so a labelled
                    # one has no node to land in.
                    Ast::Stmt.Break(label, break_pos):
                        if not FrontendIrLoopControlEncoding::label_is_unlabeled(label):
                            ir_refuse(refusal, "labelled break")
                            return 0
                        ir_put_pos(&fields, &live, FrontendIrLoopControlEncoding::LOOP_CONTROL_POSITION_FIELD_ID, break_pos, filename)
                        return ir_emit_node(bodies, nodes, FrontendIrLoopControlEncoding::BREAK_STMT_NODE_TYPE_ID, fields, live)
                    Ast::Stmt.Continue(label, continue_pos):
                        if not FrontendIrLoopControlEncoding::label_is_unlabeled(label):
                            ir_refuse(refusal, "labelled continue")
                            return 0
                        ir_put_pos(&fields, &live, FrontendIrLoopControlEncoding::LOOP_CONTROL_POSITION_FIELD_ID, continue_pos, filename)
                        return ir_emit_node(bodies, nodes, FrontendIrLoopControlEncoding::CONTINUE_STMT_NODE_TYPE_ID, fields, live)
                    Ast::Stmt.Match(scrutinee, arms, match_pos):
                        scrutinee_id: u32 = ir_expr_node(bodies, nodes, refusal, scrutinee, filename)
                        arms_payload: mutable darray[u8] = []
                        ir_arms_out(&arms_payload, bodies, nodes, refusal, arms, filename)
                        ir_put_raw(&fields, &live, 1, arms_payload)
                        ir_put_pos(&fields, &live, 2, match_pos, filename)
                        ir_put_node(&fields, &live, 4, scrutinee_id)
                        return ir_emit_node(bodies, nodes, 179, fields, live)
                    _:
                        ir_refuse(refusal, "statement")
                        return 0



        # Does any local in this body declare a heap container? That is stage0's trigger
        # for inference-by-default (`maybeWrapFunctionBodyInAutoRegion`), reproduced here
        # only closely enough to DECLINE — never closely enough to claim the wrap.
        def ir_body_allocates_regionlessly(body: darray[Ast::Stmt]&) -> bool:
            can Abort.Panic, Memory.Allocate:
                for statement in body:
                    match statement:
                        Ast::Stmt.VarDecl(_, type_expression, _, _):
                            true return if ir_type_is_container(ir_strip_mutable(type_expression))
                        Ast::Stmt.If(_, then_body, else_body, _):
                            true return if ir_body_allocates_regionlessly(then_body)
                            true return if ir_body_allocates_regionlessly(else_body)
                        Ast::Stmt.While(_, inner_body, _):
                            true return if ir_body_allocates_regionlessly(inner_body)
                        Ast::Stmt.For(_, _, _, inner_body, _):
                            true return if ir_body_allocates_regionlessly(inner_body)
                        Ast::Stmt.Block(_, _, _, inner_body, _):
                            true return if ir_body_allocates_regionlessly(inner_body)
                        _:
                            pass
                return false



        # `_` as an assignment target is a DISCARD, not a binding.
        def ir_is_underscore(target: Ast::Expr) -> bool:
            can Abort.Panic:
                match target:
                    Ast::Expr.Ident(name, _):
                        return name == "_"
                    _:
                        return false
                return false
