# `.elisair` v2 — STATEMENT nodes, plus the body probes stage0's auto-region trigger depends on
# (does a local here declare a heap container?) and the discard form of an assignment target.
# Continues frontend_ir_write.elisa.

extend IrWrite:
    private:

        # ---- statements ---------------------------------------------------------

        def ir_stmt_node(bodies: mutable darray[u8]&, nodes: mutable u32&, refusal: mutable darray[u8]&, statement: Ast::Stmt, filename: sview) -> u32:
            can Memory.Allocate, Abort.Panic:
                fields: mutable darray[u8] = []
                live: mutable u32 = 0
                match statement:
                    Ast::Stmt.Invalid:
                        ir_refuse(refusal, "malformed statement")
                        return 0
                    Ast::Stmt.Expr(expression, expr_pos):
                        expression_id: u32 = ir_expr_node(bodies, nodes, refusal, expression, filename)
                        ir_put_node(&fields, &live, 1, expression_id)
                        ir_put_pos(&fields, &live, 2, expr_pos, filename)
                        return ir_emit_node(bodies, nodes, 60, fields, live)
                    Ast::Stmt.Return(value, return_pos):
                        value_id: mutable u32 = 0
                        if value is return_value:
                            value_id <- ir_expr_node(bodies, nodes, refusal, return_value, filename)
                        ir_put_pos(&fields, &live, 1, return_pos, filename)
                        ir_put_node(&fields, &live, 2, value_id)
                        return ir_emit_node(bodies, nodes, 228, fields, live)
                    Ast::Stmt.VarDecl(name, type_expression, value, var_pos):
                        # stage0 carries a local's mutability on the STATEMENT and its type
                        # WITHOUT the qualifier; emitting both printed `mutable mutable i64`.
                        type_id: u32 = ir_type_node(bodies, nodes, refusal, ir_strip_mutable(type_expression), filename)
                        value_id: u32 = ir_expr_node(bodies, nodes, refusal, value, filename)
                        ir_put_bool(&fields, &live, 2, ir_type_is_mutable(type_expression))
                        ir_put_str(&fields, &live, 3, name)
                        ir_put_pos(&fields, &live, 5, var_pos, filename)
                        ir_put_node(&fields, &live, 6, type_id)
                        ir_put_node(&fields, &live, 7, value_id)
                        return ir_emit_node(bodies, nodes, 271, fields, live)
                    Ast::Stmt.Assign(target, operator, value, assign_pos):
                        target_id: u32 = ir_expr_node(bodies, nodes, refusal, target, filename)
                        value_id: u32 = ir_expr_node(bodies, nodes, refusal, value, filename)
                        # The three forms are three different stage0 nodes, and the
                        # difference is not cosmetic: `=` DEFINES a local (or discards, for
                        # `_`), `<-` MUTATES an existing one, and a compound carries its
                        # operator. Collapsing them printed `_ <- b` for a discard.
                        if operator == TokenKind.Assign:
                            if ir_is_underscore(target):
                                ir_put_pos(&fields, &live, 1, assign_pos, filename)
                                ir_put_node(&fields, &live, 2, value_id)
                                return ir_emit_node(bodies, nodes, 40, fields, live)
                            bound_name: mutable darray[u8] = []
                            if not ir_dotted_name(&bound_name, target):
                                ir_refuse(refusal, "definition target")
                                return 0
                            ir_put_str(&fields, &live, 3, sview(&bound_name[0], 0, bound_name.count.i64()))
                            ir_put_pos(&fields, &live, 5, assign_pos, filename)
                            ir_put_node(&fields, &live, 7, value_id)
                            return ir_emit_node(bodies, nodes, 271, fields, live)
                        if operator == TokenKind.LArrow:
                            ir_put_pos(&fields, &live, 5, assign_pos, filename)
                            ir_put_node(&fields, &live, 6, target_id)
                            ir_put_node(&fields, &live, 7, value_id)
                            return ir_emit_node(bodies, nodes, 12, fields, live)
                        ir_put_int(&fields, &live, 1, emit_tokens_kind_code(operator).i64() - 1)
                        ir_put_pos(&fields, &live, 2, assign_pos, filename)
                        ir_put_node(&fields, &live, 3, target_id)
                        ir_put_node(&fields, &live, 4, value_id)
                        return ir_emit_node(bodies, nodes, 14, fields, live)
                    Ast::Stmt.If(condition, then_body, else_body, if_pos):
                        condition_id: u32 = ir_expr_node(bodies, nodes, refusal, condition, filename)
                        then_ids: mutable darray[u32] = []
                        for statement_in_then in then_body |bodies, nodes, refusal, then_ids|:
                            then_ids.push(ir_stmt_node(bodies, nodes, refusal, statement_in_then, filename))
                        else_ids: mutable darray[u32] = []
                        for statement_in_else in else_body |bodies, nodes, refusal, else_ids|:
                            else_ids.push(ir_stmt_node(bodies, nodes, refusal, statement_in_else, filename))
                        ir_put_node(&fields, &live, 1, condition_id)
                        ir_put_node_list(&fields, &live, 3, else_ids)
                        ir_put_bool(&fields, &live, 4, true)
                        ir_put_pos(&fields, &live, 6, if_pos, filename)
                        ir_put_node_list(&fields, &live, 7, then_ids)
                        return ir_emit_node(bodies, nodes, 133, fields, live)
                    Ast::Stmt.While(condition, body, while_pos):
                        condition_id: u32 = ir_expr_node(bodies, nodes, refusal, condition, filename)
                        body_ids: mutable darray[u32] = []
                        for statement_in_body in body |bodies, nodes, refusal, body_ids|:
                            body_ids.push(ir_stmt_node(bodies, nodes, refusal, statement_in_body, filename))
                        ir_put_node_list(&fields, &live, 1, body_ids)
                        ir_put_node(&fields, &live, 3, condition_id)
                        ir_put_pos(&fields, &live, 5, while_pos, filename)
                        return ir_emit_node(bodies, nodes, 276, fields, live)
                    Ast::Stmt.For(bind, variables, iterable, body, for_pos):
                        if variables.count != 1:
                            ir_refuse(refusal, "destructuring for-loop")
                            return 0
                        pattern_fields: mutable darray[u8] = []
                        pattern_live: mutable u32 = 0
                        ir_put_str(&pattern_fields, &pattern_live, 1, variables[0])
                        pattern_id: u32 = ir_emit_node(bodies, nodes, 187, pattern_fields, pattern_live)
                        source_id: u32 = ir_expr_node(bodies, nodes, refusal, iterable, filename)
                        body_ids: mutable darray[u32] = []
                        for statement_in_body in body |bodies, nodes, refusal, body_ids|:
                            body_ids.push(ir_stmt_node(bodies, nodes, refusal, statement_in_body, filename))
                        ir_put_node_list(&fields, &live, 1, body_ids)
                        ir_put_node(&fields, &live, 5, pattern_id)
                        ir_put_pos(&fields, &live, 8, for_pos, filename)
                        ir_put_node(&fields, &live, 12, source_id)
                        return ir_emit_node(bodies, nodes, 143, fields, live)
                    # stage0's BreakStmt and ContinueStmt carry no label, so a labelled
                    # one has no node to land in.
                    Ast::Stmt.Break(label, break_pos):
                        if sview_len(label) != 0:
                            ir_refuse(refusal, "labelled break")
                            return 0
                        ir_put_pos(&fields, &live, 1, break_pos, filename)
                        return ir_emit_node(bodies, nodes, 19, fields, live)
                    Ast::Stmt.Continue(label, continue_pos):
                        if sview_len(label) != 0:
                            ir_refuse(refusal, "labelled continue")
                            return 0
                        ir_put_pos(&fields, &live, 1, continue_pos, filename)
                        return ir_emit_node(bodies, nodes, 34, fields, live)
                    Ast::Stmt.Match(scrutinee, arms, match_pos):
                        scrutinee_id: u32 = ir_expr_node(bodies, nodes, refusal, scrutinee, filename)
                        arms_payload: mutable darray[u8] = []
                        ir_arms_out(&arms_payload, bodies, nodes, refusal, arms, filename)
                        ir_put_raw(&fields, &live, 1, arms_payload)
                        ir_put_pos(&fields, &live, 2, match_pos, filename)
                        ir_put_node(&fields, &live, 4, scrutinee_id)
                        return ir_emit_node(bodies, nodes, 179, fields, live)
                    _:
                        ir_refuse(refusal, "statement")
                        return 0



        # Does any local in this body declare a heap container? That is stage0's trigger
        # for inference-by-default (`maybeWrapFunctionBodyInAutoRegion`), reproduced here
        # only closely enough to DECLINE — never closely enough to claim the wrap.
        def ir_body_allocates_regionlessly(body: darray[Ast::Stmt]&) -> bool:
            can Abort.Panic, Memory.Allocate:
                for statement in body:
                    match statement:
                        Ast::Stmt.VarDecl(_, type_expression, _, _):
                            true return if ir_type_is_container(ir_strip_mutable(type_expression))
                        Ast::Stmt.If(_, then_body, else_body, _):
                            true return if ir_body_allocates_regionlessly(then_body)
                            true return if ir_body_allocates_regionlessly(else_body)
                        Ast::Stmt.While(_, inner_body, _):
                            true return if ir_body_allocates_regionlessly(inner_body)
                        Ast::Stmt.For(_, _, _, inner_body, _):
                            true return if ir_body_allocates_regionlessly(inner_body)
                        Ast::Stmt.Block(_, _, _, inner_body, _):
                            true return if ir_body_allocates_regionlessly(inner_body)
                        _:
                            pass
                return false



        # `_` as an assignment target is a DISCARD, not a binding.
        def ir_is_underscore(target: Ast::Expr) -> bool:
            can Abort.Panic:
                match target:
                    Ast::Expr.Ident(name, _):
                        return name == "_"
                    _:
                        return false
                return false
