# `-emit pymodule` — copying a native dict back into a Python dict, item shape by item shape.


def emit_pymodule_dict_nested_scalar_return_conversion(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, element_name: sview) -> void can[Abort.Panic, Memory.Allocate]:
    element_c_type: sview = pymodule_darray_c_element_type(element_name)
    emit_tokens_push_sview(buffer, "        ElisaDArray result_nested = bucket->value; if (result_nested.count < 0 || result_nested.capacity < 0 || result_nested.count > result_nested.capacity || result_nested.count > PY_SSIZE_T_MAX || result_nested.capacity > PY_SSIZE_T_MAX) { Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "            ")
    emit_pymodule_dict_cleanup(buffer, target_params, "            ")
    emit_tokens_push_sview(buffer, "            arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native dictionary returned an invalid nested scalar list\"); return NULL; } if (result_nested.count == 0) result_value = PyList_New(0); else if (result_nested.items == NULL || result_nested.capacity == 0) { Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "            ")
    emit_pymodule_dict_cleanup(buffer, target_params, "            ")
    emit_tokens_push_sview(buffer, "            arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native dictionary returned null nested scalar storage\"); return NULL; } else { result_value = PyList_New((Py_ssize_t)result_nested.count); if (result_value == NULL) { Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "                ")
    emit_pymodule_dict_cleanup(buffer, target_params, "                ")
    emit_tokens_push_sview(buffer, "                arena_free(&arena); return NULL; } for (Py_ssize_t result_nested_index = 0; result_nested_index < (Py_ssize_t)result_nested.count; ++result_nested_index) { PyObject *result_nested_item = ")
    if element_name == "bool":
        emit_tokens_push_sview(buffer, "PyBool_FromLong((long)((bool *)result_nested.items)[result_nested_index])")
    elif element_name == "f32" or element_name == "f64":
        emit_tokens_push_sview(buffer, "PyFloat_FromDouble((double)((")
        emit_tokens_push_sview(buffer, element_c_type)
        emit_tokens_push_sview(buffer, " *)result_nested.items)[result_nested_index])")
    elif pymodule_darray_element_is_unsigned(element_name):
        emit_tokens_push_sview(buffer, "PyLong_FromUnsignedLongLong((unsigned long long)((")
        emit_tokens_push_sview(buffer, element_c_type)
        emit_tokens_push_sview(buffer, " *)result_nested.items)[result_nested_index])")
    else:
        emit_tokens_push_sview(buffer, "PyLong_FromLongLong((long long)((")
        emit_tokens_push_sview(buffer, element_c_type)
        emit_tokens_push_sview(buffer, " *)result_nested.items)[result_nested_index])")
    emit_tokens_push_sview(buffer, "; if (result_nested_item == NULL) { Py_DECREF(result_value); Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "                    ")
    emit_pymodule_dict_cleanup(buffer, target_params, "                    ")
    emit_tokens_push_sview(buffer, "                    arena_free(&arena); return NULL; } PyList_SET_ITEM(result_value, result_nested_index, result_nested_item); } }\n")




def emit_pymodule_dict_nested_view_special_return_conversion(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, type_name: sview) -> void can[Abort.Panic, Memory.Allocate]:
    element_name: sview = pymodule_view_element_name(type_name)
    emit_tokens_push_sview(buffer, "        ElisaView result_nested = bucket->value; if (result_nested.len < 0 || result_nested.len > PY_SSIZE_T_MAX || (result_nested.data == NULL && result_nested.len != 0)) { Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "            ")
    emit_pymodule_dict_cleanup(buffer, target_params, "            ")
    emit_tokens_push_sview(buffer, "            arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native dictionary returned an invalid nested view\"); return NULL; } result_value = PyList_New((Py_ssize_t)result_nested.len); if (result_value == NULL) { Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "                ")
    emit_pymodule_dict_cleanup(buffer, target_params, "                ")
    emit_tokens_push_sview(buffer, "                arena_free(&arena); return NULL; } for (Py_ssize_t result_nested_index = 0; result_nested_index < (Py_ssize_t)result_nested.len; ++result_nested_index) { PyObject *result_nested_item = NULL; ")
    if element_name == "sview" or element_name == "sview?":
        if element_name == "sview?":
            emit_tokens_push_sview(buffer, "ElisaOptionalSView result_nested_optional = ((ElisaOptionalSView *)result_nested.data)[result_nested_index]; if (!result_nested_optional.has_value) { Py_INCREF(Py_None); result_nested_item = Py_None; } else { ElisaSView result_nested_view = result_nested_optional.value; if (result_nested_view.len < 0 || result_nested_view.len > PY_SSIZE_T_MAX || (result_nested_view.data == NULL && result_nested_view.len != 0)) { Py_DECREF(result_value); Py_DECREF(out);\n")
            emit_pymodule_darray_cleanup(buffer, target_params, "                    ")
            emit_pymodule_dict_cleanup(buffer, target_params, "                    ")
            emit_tokens_push_sview(buffer, "                    arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native dictionary returned an invalid optional sview view element\"); return NULL; } result_nested_item = result_nested_view.data == NULL ? PyUnicode_FromString(\"\") : PyUnicode_DecodeUTF8(result_nested_view.data, (Py_ssize_t)result_nested_view.len, \"strict\"); }")
        else:
            emit_tokens_push_sview(buffer, "ElisaSView result_nested_view = ((ElisaSView *)result_nested.data)[result_nested_index]; if (result_nested_view.len < 0 || result_nested_view.len > PY_SSIZE_T_MAX || (result_nested_view.data == NULL && result_nested_view.len != 0)) { Py_DECREF(result_value); Py_DECREF(out);\n")
            emit_pymodule_darray_cleanup(buffer, target_params, "                    ")
            emit_pymodule_dict_cleanup(buffer, target_params, "                    ")
            emit_tokens_push_sview(buffer, "                    arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native dictionary returned an invalid sview view element\"); return NULL; } result_nested_item = result_nested_view.data == NULL ? PyUnicode_FromString(\"\") : PyUnicode_DecodeUTF8(result_nested_view.data, (Py_ssize_t)result_nested_view.len, \"strict\");")
    elif element_name == "cstr" or element_name == "cstr?":
        emit_tokens_push_sview(buffer, "const char *result_nested_text = ((const char **)result_nested.data)[result_nested_index]; ")
        if element_name == "cstr?":
            emit_tokens_push_sview(buffer, "if (result_nested_text == NULL) { Py_INCREF(Py_None); result_nested_item = Py_None; } else result_nested_item = PyUnicode_FromString(result_nested_text);")
        else:
            emit_tokens_push_sview(buffer, "if (result_nested_text == NULL) { Py_DECREF(result_value); Py_DECREF(out);\n")
            emit_pymodule_darray_cleanup(buffer, target_params, "                    ")
            emit_pymodule_dict_cleanup(buffer, target_params, "                    ")
            emit_tokens_push_sview(buffer, "                    arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native dictionary returned a null cstr view element\"); return NULL; } result_nested_item = PyUnicode_FromString(result_nested_text);")
    elif element_name == "py::Object" or element_name == "py::Object?":
        emit_tokens_push_sview(buffer, "PyObject *result_nested_object = ((PyObject **)result_nested.data)[result_nested_index]; if (result_nested_object == NULL) { Py_INCREF(Py_None); result_nested_item = Py_None; } else { Py_INCREF(result_nested_object); result_nested_item = result_nested_object; }")
    elif pymodule_is_optional_scalar_type(element_name):
        optional_c_type: sview = pymodule_c_type_name(element_name)
        payload_name: sview = pymodule_optional_payload_name(element_name)
        emit_tokens_push_sview(buffer, optional_c_type)
        emit_tokens_push_sview(buffer, " result_nested_optional = ((")
        emit_tokens_push_sview(buffer, optional_c_type)
        emit_tokens_push_sview(buffer, " *)result_nested.data)[result_nested_index]; if (!result_nested_optional.has_value) { Py_INCREF(Py_None); result_nested_item = Py_None; } else {")
        if payload_name == "bool":
            emit_tokens_push_sview(buffer, " result_nested_item = PyBool_FromLong((long)result_nested_optional.value); }")
        elif payload_name == "f32" or payload_name == "f64":
            emit_tokens_push_sview(buffer, " result_nested_item = PyFloat_FromDouble((double)result_nested_optional.value); }")
        elif payload_name == "u8" or payload_name == "u16" or payload_name == "u32" or payload_name == "u64" or payload_name == "usize" or payload_name == "uintptr":
            emit_tokens_push_sview(buffer, " result_nested_item = PyLong_FromUnsignedLongLong((unsigned long long)result_nested_optional.value); }")
        else:
            emit_tokens_push_sview(buffer, " result_nested_item = PyLong_FromLongLong((long long)result_nested_optional.value); }")
    emit_tokens_push_sview(buffer, " if (result_nested_item == NULL) { Py_DECREF(result_value); Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "                    ")
    emit_pymodule_dict_cleanup(buffer, target_params, "                    ")
    emit_tokens_push_sview(buffer, "                    arena_free(&arena); return NULL; } PyList_SET_ITEM(result_value, result_nested_index, result_nested_item); }\n")




def emit_pymodule_dict_nested_view_return_conversion(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, type_name: sview) -> void can[Abort.Panic, Memory.Allocate]:
    element_name: sview = pymodule_view_element_name(type_name)
    element_c_type: sview = pymodule_darray_c_element_type(element_name)
    if element_name == "u8":
        emit_tokens_push_sview(buffer, "        ElisaView result_nested = bucket->value; if (result_nested.len < 0 || result_nested.len > PY_SSIZE_T_MAX || (result_nested.data == NULL && result_nested.len != 0)) { Py_DECREF(out);\n")
        emit_pymodule_darray_cleanup(buffer, target_params, "            ")
        emit_pymodule_dict_cleanup(buffer, target_params, "            ")
        emit_tokens_push_sview(buffer, "            arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native dictionary returned an invalid nested view\"); return NULL; } result_value = PyBytes_FromStringAndSize((const char *)result_nested.data, (Py_ssize_t)result_nested.len);\n")
        return
    emit_tokens_push_sview(buffer, "        ElisaView result_nested = bucket->value; if (result_nested.len < 0 || result_nested.len > PY_SSIZE_T_MAX || (result_nested.data == NULL && result_nested.len != 0)) { Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "            ")
    emit_pymodule_dict_cleanup(buffer, target_params, "            ")
    emit_tokens_push_sview(buffer, "            arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native dictionary returned an invalid nested view\"); return NULL; } result_value = PyList_New((Py_ssize_t)result_nested.len); if (result_value == NULL) { Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "                ")
    emit_pymodule_dict_cleanup(buffer, target_params, "                ")
    emit_tokens_push_sview(buffer, "                arena_free(&arena); return NULL; } for (Py_ssize_t result_nested_index = 0; result_nested_index < (Py_ssize_t)result_nested.len; ++result_nested_index) { PyObject *result_nested_item = ")
    if element_name == "bool":
        emit_tokens_push_sview(buffer, "PyBool_FromLong((long)((bool *)result_nested.data)[result_nested_index])")
    elif element_name == "f32" or element_name == "f64":
        emit_tokens_push_sview(buffer, "PyFloat_FromDouble((double)((")
        emit_tokens_push_sview(buffer, element_c_type)
        emit_tokens_push_sview(buffer, " *)result_nested.data)[result_nested_index])")
    elif pymodule_darray_element_is_unsigned(element_name):
        emit_tokens_push_sview(buffer, "PyLong_FromUnsignedLongLong((unsigned long long)((")
        emit_tokens_push_sview(buffer, element_c_type)
        emit_tokens_push_sview(buffer, " *)result_nested.data)[result_nested_index])")
    else:
        emit_tokens_push_sview(buffer, "PyLong_FromLongLong((long long)((")
        emit_tokens_push_sview(buffer, element_c_type)
        emit_tokens_push_sview(buffer, " *)result_nested.data)[result_nested_index])")
    emit_tokens_push_sview(buffer, "; if (result_nested_item == NULL) { Py_DECREF(result_value); Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "                    ")
    emit_pymodule_dict_cleanup(buffer, target_params, "                    ")
    emit_tokens_push_sview(buffer, "                    arena_free(&arena); return NULL; } PyList_SET_ITEM(result_value, result_nested_index, result_nested_item); }\n")




def emit_pymodule_dict_return_conversion(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, type_name: sview, is_error: bool, nested_value_helper: sview = "") -> void can[Abort.Panic, Memory.Allocate]:
    key_name: sview = pymodule_dict_key_name(type_name)
    value_name: sview = pymodule_dict_value_name(type_name)
    key_c_type: sview = pymodule_c_type_name(key_name)
    value_c_type: mutable sview = pymodule_c_type_name(value_name)
    value_c_type <- value_name if value_c_type == ""
    emit_tokens_push_sview(buffer, ");\n") if not is_error
    emit_tokens_push_sview(buffer, "    if (result.count < 0 || result.capacity < 0 || result.count > result.capacity || result.count > PY_SSIZE_T_MAX || result.capacity > PY_SSIZE_T_MAX) {\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena);\n        PyErr_SetString(PyExc_RuntimeError, \"native Elisa function returned an invalid dictionary header\");\n        return NULL;\n    }\n    PyObject *out = PyDict_New();\n    if (out == NULL) {\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena);\n        return NULL;\n    }\n    if (result.count == 0) {\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena);\n        return out;\n    }\n    if (result.items == NULL || result.capacity == 0) {\n        Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena);\n        PyErr_SetString(PyExc_RuntimeError, \"native Elisa function returned null dictionary storage\");\n        return NULL;\n    }\n    typedef struct { ")
    emit_tokens_push_sview(buffer, key_c_type)
    emit_tokens_push_sview(buffer, " key; ")
    emit_tokens_push_sview(buffer, value_c_type)
    emit_tokens_push_sview(buffer, " value; uint8_t state; } ElisaPymoduleDictResultBucket;\n    int64_t result_seen = 0;\n    for (int64_t result_index = 0; result_index < result.capacity; ++result_index) {\n        ElisaPymoduleDictResultBucket *bucket = &((ElisaPymoduleDictResultBucket *)result.items)[result_index];\n        if (bucket->state != 1) continue;\n        PyObject *result_key = NULL;\n        PyObject *result_value = NULL;\n")
    if key_name == "cstr":
        emit_tokens_push_sview(buffer, "        if (bucket->key == NULL) { Py_DECREF(out);\n")
        emit_pymodule_darray_cleanup(buffer, target_params, "            ")
        emit_pymodule_dict_cleanup(buffer, target_params, "            ")
        emit_tokens_push_sview(buffer, "            arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native dictionary returned a null cstr key\"); return NULL; }\n        result_key = PyUnicode_FromString(bucket->key);\n")
    elif key_name == "sview":
        emit_tokens_push_sview(buffer, "        ElisaSView result_key_view = bucket->key; if (result_key_view.len < 0 || result_key_view.len > PY_SSIZE_T_MAX || (result_key_view.data == NULL && result_key_view.len != 0)) { Py_DECREF(out);\n")
        emit_pymodule_darray_cleanup(buffer, target_params, "            ")
        emit_pymodule_dict_cleanup(buffer, target_params, "            ")
        emit_tokens_push_sview(buffer, "            arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native dictionary returned an invalid sview key\"); return NULL; } if (result_key_view.data == NULL) result_key = PyUnicode_FromString(\"\"); else result_key = PyUnicode_DecodeUTF8(result_key_view.data, (Py_ssize_t)result_key_view.len, \"strict\");\n")
    elif key_name == "u8" or key_name == "u16" or key_name == "u32" or key_name == "u64" or key_name == "usize" or key_name == "uintptr":
        emit_tokens_push_sview(buffer, "        result_key = PyLong_FromUnsignedLongLong((unsigned long long)bucket->key);\n")
    elif key_name == "bool":
        emit_tokens_push_sview(buffer, "        result_key = PyBool_FromLong((long)bucket->key);\n")
    else:
        emit_tokens_push_sview(buffer, "        result_key = PyLong_FromLongLong((long long)bucket->key);\n")
    if pymodule_is_dict_type(value_name):
        if nested_value_helper == "":
            emit_tokens_push_sview(buffer, "        PyErr_SetString(PyExc_TypeError, \"nested dictionary values require a generated converter\"); result_value = NULL;\n")
        else:
            emit_tokens_push_sview(buffer, "        result_value = ")
            emit_tokens_push_sview(buffer, nested_value_helper)
            emit_tokens_push_sview(buffer, "(bucket->value);\n")
    elif pymodule_is_set_type(value_name) and nested_value_helper != "":
        emit_tokens_push_sview(buffer, "        result_value = ")
        emit_tokens_push_sview(buffer, nested_value_helper)
        emit_tokens_push_sview(buffer, "(bucket->value);\n")
    elif pymodule_is_set_type(value_name):
        emit_tokens_push_sview(buffer, "        PyErr_SetString(PyExc_TypeError, \"nested dictionary set values require a generated converter\"); result_value = NULL;\n")
    elif pymodule_is_darray_type(value_name) and nested_value_helper != "":
        emit_tokens_push_sview(buffer, "        result_value = ")
        emit_tokens_push_sview(buffer, nested_value_helper)
        emit_tokens_push_sview(buffer, "(bucket->value);\n")
    elif pymodule_is_darray_type(value_name) and pymodule_darray_nesting_depth(value_name) >= 2.usize():
        if nested_value_helper == "":
            emit_tokens_push_sview(buffer, "        PyErr_SetString(PyExc_TypeError, \"nested dictionary darray values require a generated converter\"); result_value = NULL;\n")
        else:
            emit_tokens_push_sview(buffer, "        result_value = ")
            emit_tokens_push_sview(buffer, nested_value_helper)
            emit_tokens_push_sview(buffer, "(bucket->value);\n")
    elif pymodule_is_view_type(value_name) and nested_value_helper != "":
        emit_tokens_push_sview(buffer, "        result_value = ")
        emit_tokens_push_sview(buffer, nested_value_helper)
        emit_tokens_push_sview(buffer, "(bucket->value);\n")
    elif pymodule_is_view_type(value_name) and (pymodule_view_element_name(value_name) == "sview" or pymodule_view_element_name(value_name) == "cstr" or pymodule_view_element_name(value_name) == "py::Object" or pymodule_view_element_name(value_name) == "sview?" or pymodule_view_element_name(value_name) == "cstr?" or pymodule_view_element_name(value_name) == "py::Object?" or pymodule_is_optional_scalar_type(pymodule_view_element_name(value_name))):
        emit_pymodule_dict_nested_view_special_return_conversion(buffer, target_params, value_name)
    elif pymodule_is_view_type(value_name):
        emit_pymodule_dict_nested_view_return_conversion(buffer, target_params, value_name)
    elif value_name == "darray[u8]":
        emit_tokens_push_sview(buffer, "        ElisaDArray result_nested = bucket->value; if (result_nested.count < 0 || result_nested.capacity < 0 || result_nested.count > result_nested.capacity || result_nested.count > PY_SSIZE_T_MAX || result_nested.capacity > PY_SSIZE_T_MAX) { Py_DECREF(out);\n")
        emit_pymodule_darray_cleanup(buffer, target_params, "            ")
        emit_pymodule_dict_cleanup(buffer, target_params, "            ")
        emit_tokens_push_sview(buffer, "            arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native dictionary returned an invalid nested byte array\"); return NULL; } if (result_nested.count == 0) result_value = PyBytes_FromStringAndSize(\"\", 0); else if (result_nested.items == NULL || result_nested.capacity == 0) { Py_DECREF(out);\n")
        emit_pymodule_darray_cleanup(buffer, target_params, "            ")
        emit_pymodule_dict_cleanup(buffer, target_params, "            ")
        emit_tokens_push_sview(buffer, "            arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native dictionary returned null nested byte storage\"); return NULL; } else result_value = PyBytes_FromStringAndSize((const char *)result_nested.items, (Py_ssize_t)result_nested.count);\n")
    elif value_name == "darray[py::Object]":
        emit_tokens_push_sview(buffer, "        ElisaDArray result_nested = bucket->value; if (result_nested.count < 0 || result_nested.capacity < 0 || result_nested.count > result_nested.capacity || result_nested.count > PY_SSIZE_T_MAX || result_nested.capacity > PY_SSIZE_T_MAX) { Py_DECREF(out);\n")
        emit_pymodule_darray_cleanup(buffer, target_params, "            ")
        emit_pymodule_dict_cleanup(buffer, target_params, "            ")
        emit_tokens_push_sview(buffer, "            arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native dictionary returned an invalid nested object list\"); return NULL; } if (result_nested.count == 0) result_value = PyList_New(0); else if (result_nested.items == NULL || result_nested.capacity == 0) { Py_DECREF(out);\n")
        emit_pymodule_darray_cleanup(buffer, target_params, "            ")
        emit_pymodule_dict_cleanup(buffer, target_params, "            ")
        emit_tokens_push_sview(buffer, "            arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native dictionary returned null nested object storage\"); return NULL; } else { result_value = PyList_New((Py_ssize_t)result_nested.count); if (result_value == NULL) { Py_DECREF(out);\n")
        emit_pymodule_darray_cleanup(buffer, target_params, "                ")
        emit_pymodule_dict_cleanup(buffer, target_params, "                ")
        emit_tokens_push_sview(buffer, "                arena_free(&arena); return NULL; } for (Py_ssize_t result_nested_index = 0; result_nested_index < (Py_ssize_t)result_nested.count; ++result_nested_index) { PyObject *result_nested_item = ((PyObject **)result_nested.items)[result_nested_index]; if (result_nested_item == NULL) { Py_INCREF(Py_None); result_nested_item = Py_None; } else Py_INCREF(result_nested_item); PyList_SET_ITEM(result_value, result_nested_index, result_nested_item); } }\n")
    elif value_name == "darray[i64?]":
        emit_tokens_push_sview(buffer, "        ElisaDArray result_nested = bucket->value; if (result_nested.count < 0 || result_nested.capacity < 0 || result_nested.count > result_nested.capacity || result_nested.count > PY_SSIZE_T_MAX || result_nested.capacity > PY_SSIZE_T_MAX) { Py_DECREF(out);\n")
