# `-emit pymodule` — argument CLEANUP and range checks: everything the shim borrowed on the way
# in is released on every exit path, and each scalar is bounds-checked against its C type before
# the call rather than after it.


def emit_pymodule_darray_cleanup(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, indent: sview) -> void can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(buffer, indent)
    emit_tokens_push_sview(buffer, "elisa_pymodule_annotate_argument_error(elisa_pymodule_current_function, elisa_pymodule_current_parameter);\n")
    for cleanup_index in 0..<target_params.count |buffer, target_params, indent|:
        # Named-struct defaults are Python mappings too. They do not need arena cleanup, but the
        # temporary mapping owns a reference that must be released on every post-parse exit path.
        if target_params[cleanup_index].has_default and pymodule_default_is_container(target_params[cleanup_index].default_value):
            emit_tokens_push_sview(buffer, indent)
            emit_tokens_push_sview(buffer, "Py_XDECREF(arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_default); arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_default = NULL;\n")
        if pymodule_expression_is_nested_darray(target_params[cleanup_index].type_expression):
            emit_tokens_push_sview(buffer, indent)
            emit_tokens_push_sview(buffer, "elisa_pymodule_struct_refs_free(&arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_struct_refs);\n")
            emit_tokens_push_sview(buffer, indent)
            emit_tokens_push_sview(buffer, "arena_free(&arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_struct_arena);\n")
            if target_params[cleanup_index].has_default and pymodule_default_is_container(target_params[cleanup_index].default_value):
                emit_tokens_push_sview(buffer, indent)
                emit_tokens_push_sview(buffer, "Py_XDECREF(arg")
                append_decimal(buffer, cleanup_index.i64())
                emit_tokens_push_sview(buffer, "_default); arg")
                append_decimal(buffer, cleanup_index.i64())
                emit_tokens_push_sview(buffer, "_default = NULL;\n")
            continue
        cleanup_type_name: sview = pymodule_bare_type_name(target_params[cleanup_index].type_expression)
        named_container_element: sview = pymodule_named_container_element_name(target_params[cleanup_index].type_expression)
        owned_container_element: bool = pymodule_expression_has_owned_container_element(target_params[cleanup_index].type_expression)
        if cleanup_type_name != "" and not pymodule_is_darray_type(cleanup_type_name) and not pymodule_is_view_type(cleanup_type_name) and not pymodule_is_dict_type(cleanup_type_name) and not pymodule_is_set_type(cleanup_type_name) and pymodule_c_type_name(cleanup_type_name) == "":
            emit_tokens_push_sview(buffer, indent)
            emit_tokens_push_sview(buffer, "elisa_pymodule_struct_refs_free(&arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_struct_refs);\n")
            emit_tokens_push_sview(buffer, indent)
            emit_tokens_push_sview(buffer, "arena_free(&arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_struct_arena);\n")
            continue
        continue if not pymodule_is_darray_type(cleanup_type_name) and not pymodule_is_view_type(cleanup_type_name) and named_container_element == "" and not owned_container_element
        if pymodule_darray_is_bytes(cleanup_type_name):
            emit_tokens_push_sview(buffer, indent)
            emit_tokens_push_sview(buffer, "Py_XDECREF(arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_bytes);\n")
        else:
            emit_tokens_push_sview(buffer, indent)
            emit_tokens_push_sview(buffer, "Py_XDECREF(arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_seq);\n")
            emit_tokens_push_sview(buffer, indent)
            emit_tokens_push_sview(buffer, "PyMem_Free(arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_items);\n")
            if named_container_element != "" or owned_container_element:
                emit_tokens_push_sview(buffer, indent)
                emit_tokens_push_sview(buffer, "elisa_pymodule_struct_refs_free(&arg")
                append_decimal(buffer, cleanup_index.i64())
                emit_tokens_push_sview(buffer, "_struct_refs);\n")
                emit_tokens_push_sview(buffer, indent)
                emit_tokens_push_sview(buffer, "arena_free(&arg")
                append_decimal(buffer, cleanup_index.i64())
                emit_tokens_push_sview(buffer, "_struct_arena);\n")
        if target_params[cleanup_index].has_default and pymodule_default_is_container(target_params[cleanup_index].default_value):
            emit_tokens_push_sview(buffer, indent)
            emit_tokens_push_sview(buffer, "Py_XDECREF(arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_default); arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_default = NULL;\n")
    emit_pymodule_parameter_default_cleanup(buffer, target_params, indent)




def emit_pymodule_struct_argument_cleanup(buffer: mutable darray[u8]&, file: Ast::File&, target_params: darray[Ast::ParamDecl]&, indent: sview) -> void can[Abort.Panic, Memory.Allocate]:
    for cleanup_index in 0..<target_params.count |buffer, file, target_params, indent|:
        cleanup_type_name: sview = pymodule_alias_type_name(file, target_params[cleanup_index].type_expression)
        continue if not pymodule_struct_input_supported(file, cleanup_type_name)
        emit_tokens_push_sview(buffer, indent)
        emit_tokens_push_sview(buffer, "elisa_pymodule_struct_")
        emit_tokens_push_sview(buffer, cleanup_type_name)
        emit_tokens_push_sview(buffer, "_free(&arg")
        append_decimal(buffer, cleanup_index.i64())
        emit_tokens_push_sview(buffer, "_value);\n")




def emit_pymodule_parameter_default_cleanup(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, indent: sview) -> void can[Abort.Panic, Memory.Allocate]:
    # Parse-time failures happen before container materializers declare their arenas. Only
    # release the Python objects allocated for omitted literal-container and optional scalar/text
    # defaults here; the normal darray/dict/set cleanup paths take over once conversion has started.
    for cleanup_index in 0..<target_params.count |buffer, target_params, indent|:
        cleanup_type_name: sview = pymodule_bare_type_name(target_params[cleanup_index].type_expression)
        if target_params[cleanup_index].has_default and (pymodule_default_is_container(target_params[cleanup_index].default_value) or pymodule_parameter_is_implicit_optional(cleanup_type_name)):
            emit_tokens_push_sview(buffer, indent)
            emit_tokens_push_sview(buffer, "Py_XDECREF(arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_default);\n")




def emit_pymodule_darray_optional_scalar_input(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, element_name: sview, parameter_index: usize) -> void can[Abort.Panic, Memory.Allocate]:
    payload_name: sview = pymodule_optional_payload_name(element_name)
    optional_c_type: sview = pymodule_darray_c_element_type(element_name)
    payload_c_type: sview = pymodule_optional_payload_c_type(payload_name)
    emit_tokens_push_sview(buffer, "        ")
    emit_tokens_push_sview(buffer, optional_c_type)
    emit_tokens_push_sview(buffer, " arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_item_value = {false, 0};\n        if (arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_item != Py_None) {\n")
    if payload_name == "bool":
        emit_tokens_push_sview(buffer, "            int arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_truth = PyObject_IsTrue(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_item);\n            if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_truth < 0) {\n")
    elif payload_name == "f32" or payload_name == "f64":
        emit_tokens_push_sview(buffer, "            double arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number = PyFloat_AsDouble(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_item);\n            if (PyErr_Occurred()) {\n")
    elif payload_name == "u8" or payload_name == "u16" or payload_name == "u32" or payload_name == "u64" or payload_name == "usize" or payload_name == "uintptr":
        emit_tokens_push_sview(buffer, "            unsigned long long arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number = PyLong_AsUnsignedLongLong(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_item);\n            if (PyErr_Occurred()) {\n")
    else:
        emit_tokens_push_sview(buffer, "            long long arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number = PyLong_AsLongLong(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_item);\n            if (PyErr_Occurred()) {\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "                ")
    emit_tokens_push_sview(buffer, "                return NULL;\n            }\n")
    if payload_name == "i8":
        emit_tokens_push_sview(buffer, "            if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number < INT8_MIN || arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number > INT8_MAX) { PyErr_SetString(PyExc_OverflowError, \"i8 list element out of range\");\n")
    elif payload_name == "i16":
        emit_tokens_push_sview(buffer, "            if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number < INT16_MIN || arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number > INT16_MAX) { PyErr_SetString(PyExc_OverflowError, \"i16 list element out of range\");\n")
    elif payload_name == "i32":
        emit_tokens_push_sview(buffer, "            if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number < INT32_MIN || arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number > INT32_MAX) { PyErr_SetString(PyExc_OverflowError, \"i32 list element out of range\");\n")
    elif payload_name == "u8":
        emit_tokens_push_sview(buffer, "            if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number > UINT8_MAX) { PyErr_SetString(PyExc_OverflowError, \"u8 list element out of range\");\n")
    elif payload_name == "u16":
        emit_tokens_push_sview(buffer, "            if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number > UINT16_MAX) { PyErr_SetString(PyExc_OverflowError, \"u16 list element out of range\");\n")
    elif payload_name == "u32":
        emit_tokens_push_sview(buffer, "            if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number > UINT32_MAX) { PyErr_SetString(PyExc_OverflowError, \"u32 list element out of range\");\n")
    if payload_name == "i8" or payload_name == "i16" or payload_name == "i32" or payload_name == "u8" or payload_name == "u16" or payload_name == "u32":
        emit_pymodule_darray_cleanup(buffer, target_params, "                ")
        emit_tokens_push_sview(buffer, "                return NULL; }\n")
    emit_tokens_push_sview(buffer, "            arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_item_value = (")
    emit_tokens_push_sview(buffer, optional_c_type)
    emit_tokens_push_sview(buffer, "){true, (")
    emit_tokens_push_sview(buffer, payload_c_type)
    emit_tokens_push_sview(buffer, ")(")
    emit_tokens_push_sview(buffer, "arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_truth" if payload_name == "bool" else "_number")
    emit_tokens_push_sview(buffer, ")};\n        }\n        arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_items[arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_index] = arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_item_value;\n")




def emit_pymodule_darray_optional_scalar_output(buffer: mutable darray[u8]&, element_name: sview) -> void can[Abort.Panic, Memory.Allocate]:
    payload_name: sview = pymodule_optional_payload_name(element_name)
    optional_c_type: sview = pymodule_darray_c_element_type(element_name)
    emit_tokens_push_sview(buffer, "        ")
    emit_tokens_push_sview(buffer, optional_c_type)
    emit_tokens_push_sview(buffer, " item_value = ((")
    emit_tokens_push_sview(buffer, optional_c_type)
    emit_tokens_push_sview(buffer, " *)result.items)[result_index];\n        if (!item_value.has_value) { Py_INCREF(Py_None); item = Py_None; } else {")
    if payload_name == "bool":
        emit_tokens_push_sview(buffer, " item = PyBool_FromLong((long)item_value.value);\n")
    elif payload_name == "f32" or payload_name == "f64":
        emit_tokens_push_sview(buffer, " item = PyFloat_FromDouble((double)item_value.value);\n")
    elif payload_name == "u8" or payload_name == "u16" or payload_name == "u32" or payload_name == "u64" or payload_name == "usize" or payload_name == "uintptr":
        emit_tokens_push_sview(buffer, " item = PyLong_FromUnsignedLongLong((unsigned long long)item_value.value);\n")
    else:
        emit_tokens_push_sview(buffer, " item = PyLong_FromLongLong((long long)item_value.value);\n")
    emit_tokens_push_sview(buffer, "        }\n")




# Fixed-array parameters are intentionally the narrowest safe first step: only a borrowed
# (`array[T, N]&`) array of scalar numeric/bool elements is exposed.  The native ABI receives a
# pointer to the first element, while Python sees an ordinary sequence with an exact length
# check.  Copying into a stack array keeps the conversion independent of Elisa's arena ABI.
def emit_pymodule_fixed_array_input_setup(buffer: mutable darray[u8]&, element_name: sview, extent: i64, parameter_index: usize, function_name: sview, parameter_name: sview) -> void can[Abort.Panic, Memory.Allocate]:
    element_c_type: sview = pymodule_darray_c_element_type(element_name)
    emit_tokens_push_sview(buffer, "    arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_seq = PySequence_Fast(arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, ", \"expected a fixed-array sequence\");\n    if (arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_seq == NULL) {\n")
    emit_pymodule_argument_error_annotation(buffer, function_name, parameter_name, "        ")
    emit_tokens_push_sview(buffer, "        return NULL;\n    }\n    if (PySequence_Fast_GET_SIZE(arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_seq) != ")
    append_decimal(buffer, extent.u32())
    emit_tokens_push_sview(buffer, ") { Py_DECREF(arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_seq); PyErr_Format(PyExc_ValueError, \"expected fixed array of length %lld\", (long long)")
    append_decimal(buffer, extent.u32())
    emit_tokens_push_sview(buffer, ");\n")
    emit_pymodule_argument_error_annotation(buffer, function_name, parameter_name, "        ")
    emit_tokens_push_sview(buffer, "        return NULL; }\n    for (Py_ssize_t arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_index = 0; arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_index < ")
    append_decimal(buffer, extent.u32())
    emit_tokens_push_sview(buffer, "; ++arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_index) { PyObject *arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_item = PySequence_Fast_GET_ITEM(arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_seq, arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_index); ")
    if element_name == "bool":
        emit_tokens_push_sview(buffer, "if (!PyBool_Check(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_item)) { Py_DECREF(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_seq); PyErr_SetString(PyExc_TypeError, \"expected bool elements in fixed array\");\n")
        emit_pymodule_argument_error_annotation(buffer, function_name, parameter_name, "            ")
        emit_tokens_push_sview(buffer, "            return NULL; } int arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_truth = PyObject_IsTrue(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_item); if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_truth < 0) { Py_DECREF(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_seq);\n")
        emit_pymodule_argument_error_annotation(buffer, function_name, parameter_name, "            ")
        emit_tokens_push_sview(buffer, "            return NULL; } arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_items[arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_index] = (bool)arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_truth; ")
    elif element_name == "f32" or element_name == "f64":
        emit_tokens_push_sview(buffer, "double arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number = PyFloat_AsDouble(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_item); if (PyErr_Occurred()) { Py_DECREF(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_seq);\n")
        emit_pymodule_argument_error_annotation(buffer, function_name, parameter_name, "            ")
        emit_tokens_push_sview(buffer, "            return NULL; } arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_items[arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_index] = (")
        emit_tokens_push_sview(buffer, element_c_type)
        emit_tokens_push_sview(buffer, ")arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number; ")
    elif pymodule_darray_element_is_unsigned(element_name):
        emit_tokens_push_sview(buffer, "unsigned long long arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number = PyLong_AsUnsignedLongLong(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_item); if (PyErr_Occurred()) { Py_DECREF(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_seq);\n")
        emit_pymodule_argument_error_annotation(buffer, function_name, parameter_name, "            ")
        emit_tokens_push_sview(buffer, "            return NULL; }")
        if element_name == "u8" or element_name == "u16" or element_name == "u32":
            emit_tokens_push_sview(buffer, " if (arg")
            append_decimal(buffer, parameter_index.i64())
            emit_tokens_push_sview(buffer, "_number > ")
            emit_tokens_push_sview(buffer, "UINT8_MAX" if element_name == "u8" else "UINT16_MAX" if element_name == "u16" else "UINT32_MAX")
            emit_tokens_push_sview(buffer, ") { Py_DECREF(arg")
            append_decimal(buffer, parameter_index.i64())
            emit_tokens_push_sview(buffer, "_seq); PyErr_SetString(PyExc_OverflowError, \"fixed-array element out of range\");\n")
            emit_pymodule_argument_error_annotation(buffer, function_name, parameter_name, "            ")
            emit_tokens_push_sview(buffer, "            return NULL; }")
        emit_tokens_push_sview(buffer, " arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_items[arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_index] = (")
        emit_tokens_push_sview(buffer, element_c_type)
        emit_tokens_push_sview(buffer, ")arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number; ")
    else:
        emit_tokens_push_sview(buffer, "long long arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number = PyLong_AsLongLong(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_item); if (PyErr_Occurred()) { Py_DECREF(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_seq);\n")
        emit_pymodule_argument_error_annotation(buffer, function_name, parameter_name, "            ")
        emit_tokens_push_sview(buffer, "            return NULL; }")
        if element_name == "i8" or element_name == "i16" or element_name == "i32":
            emit_tokens_push_sview(buffer, " if (arg")
            append_decimal(buffer, parameter_index.i64())
            emit_tokens_push_sview(buffer, "_number < ")
            emit_tokens_push_sview(buffer, "INT8_MIN" if element_name == "i8" else "INT16_MIN" if element_name == "i16" else "INT32_MIN")
            emit_tokens_push_sview(buffer, " || arg")
            append_decimal(buffer, parameter_index.i64())
            emit_tokens_push_sview(buffer, "_number > ")
            emit_tokens_push_sview(buffer, "INT8_MAX" if element_name == "i8" else "INT16_MAX" if element_name == "i16" else "INT32_MAX")
            emit_tokens_push_sview(buffer, ") { Py_DECREF(arg")
            append_decimal(buffer, parameter_index.i64())
            emit_tokens_push_sview(buffer, "_seq); PyErr_SetString(PyExc_OverflowError, \"fixed-array element out of range\");\n")
            emit_pymodule_argument_error_annotation(buffer, function_name, parameter_name, "            ")
            emit_tokens_push_sview(buffer, "            return NULL; }")
        emit_tokens_push_sview(buffer, " arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_items[arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_index] = (")
        emit_tokens_push_sview(buffer, element_c_type)
        emit_tokens_push_sview(buffer, ")arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number; ")
    emit_tokens_push_sview(buffer, "}\n    Py_DECREF(arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_seq); arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_seq = NULL;\n")




def emit_pymodule_fixed_array_return_conversion(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, element_name: sview, extent: i64, has_input_arena: bool) -> void can[Abort.Panic, Memory.Allocate]:
    # The stable symbol has already copied the native aggregate into
    # `fixed_result_items`; expose it as the same owning Python list shape used by
    # ordinary darray returns.  Fixed-array elements are scalar-only by construction.
    emit_tokens_push_sview(buffer, "    PyObject *out = PyList_New(")
    append_decimal(buffer, extent.u32())
    emit_tokens_push_sview(buffer, ");\n    if (out == NULL) {\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena);\n") if has_input_arena
    emit_tokens_push_sview(buffer, "        return NULL;\n    }\n    for (Py_ssize_t result_index = 0; result_index < ")
    append_decimal(buffer, extent.u32())
    emit_tokens_push_sview(buffer, "; ++result_index) {\n        PyObject *item = NULL;\n")
    if element_name == "bool":
        emit_tokens_push_sview(buffer, "        item = PyBool_FromLong((long)fixed_result_items[result_index]);\n")
    elif element_name == "f32" or element_name == "f64":
        emit_tokens_push_sview(buffer, "        item = PyFloat_FromDouble((double)fixed_result_items[result_index]);\n")
    elif pymodule_darray_element_is_unsigned(element_name):
        emit_tokens_push_sview(buffer, "        item = PyLong_FromUnsignedLongLong((unsigned long long)fixed_result_items[result_index]);\n")
    else:
        emit_tokens_push_sview(buffer, "        item = PyLong_FromLongLong((long long)fixed_result_items[result_index]);\n")
    emit_tokens_push_sview(buffer, "        if (item == NULL) { Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "            ")
    emit_pymodule_dict_cleanup(buffer, target_params, "            ")
    emit_tokens_push_sview(buffer, "            arena_free(&arena);\n") if has_input_arena
    emit_tokens_push_sview(buffer, "            return NULL;\n        }\n        PyList_SET_ITEM(out, result_index, item);\n    }\n    ")
    emit_pymodule_darray_cleanup(buffer, target_params, "    ")
    emit_pymodule_dict_cleanup(buffer, target_params, "    ")
    emit_tokens_push_sview(buffer, "    arena_free(&arena);\n") if has_input_arena
    emit_tokens_push_sview(buffer, "    return out;\n")




def emit_pymodule_darray_range_check(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, element_name: sview, parameter_index: usize) -> void can[Abort.Panic, Memory.Allocate]:
    lower: mutable sview = ""
    upper: mutable sview = ""
    if element_name == "i8":
        lower <- "INT8_MIN"
        upper <- "INT8_MAX"
    elif element_name == "i16":
        lower <- "INT16_MIN"
        upper <- "INT16_MAX"
    elif element_name == "i32":
        lower <- "INT32_MIN"
        upper <- "INT32_MAX"
    elif element_name == "u8":
        upper <- "UINT8_MAX"
    elif element_name == "u16":
        upper <- "UINT16_MAX"
    elif element_name == "u32":
        upper <- "UINT32_MAX"
    return if lower == "" and upper == ""
    emit_tokens_push_sview(buffer, "        if (")
    if lower != "":
        emit_tokens_push_sview(buffer, "arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number < ")
        emit_tokens_push_sview(buffer, lower)
        emit_tokens_push_sview(buffer, " || ")
    emit_tokens_push_sview(buffer, "arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_number > ")
    emit_tokens_push_sview(buffer, upper)
    emit_tokens_push_sview(buffer, ") {\n            PyErr_SetString(PyExc_OverflowError, \"list element out of range\");\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "            ")
    emit_tokens_push_sview(buffer, "            return NULL;\n        }\n")




