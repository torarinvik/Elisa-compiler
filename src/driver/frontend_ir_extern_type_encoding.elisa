# Stage0 frontend-IR v2 node and field IDs for retained extern type shapes.
module FrontendIrExternTypeEncoding:
    public:
        const enum ExternTypeShape of u8:
            Named
            ProvenanceRef

        const NAMED_TYPE_NODE_TYPE_ID: u32 = 194
        const REF_TYPE_NODE_TYPE_ID: u32 = 220

        const NAMED_TYPE_NAME_FIELD_ID: u32 = 1
        const NAMED_TYPE_POSITION_FIELD_ID: u32 = 2
        const REF_TYPE_ELEM_FIELD_ID: u32 = 1
        const REF_TYPE_POSITION_FIELD_ID: u32 = 3

        def node_type_id(shape: ExternTypeShape) -> u32:
            ensure shape != ExternTypeShape.Named or result == NAMED_TYPE_NODE_TYPE_ID
            ensure shape != ExternTypeShape.ProvenanceRef or result == REF_TYPE_NODE_TYPE_ID
            return match shape:
                ExternTypeShape.Named: NAMED_TYPE_NODE_TYPE_ID
                ExternTypeShape.ProvenanceRef: REF_TYPE_NODE_TYPE_ID

        def primary_field_id(shape: ExternTypeShape) -> u32:
            ensure shape != ExternTypeShape.Named or result == NAMED_TYPE_NAME_FIELD_ID
            ensure shape != ExternTypeShape.ProvenanceRef or result == REF_TYPE_ELEM_FIELD_ID
            return match shape:
                ExternTypeShape.Named: NAMED_TYPE_NAME_FIELD_ID
                ExternTypeShape.ProvenanceRef: REF_TYPE_ELEM_FIELD_ID

        def position_field_id(shape: ExternTypeShape) -> u32:
            ensure shape != ExternTypeShape.Named or result == NAMED_TYPE_POSITION_FIELD_ID
            ensure shape != ExternTypeShape.ProvenanceRef or result == REF_TYPE_POSITION_FIELD_ID
            return match shape:
                ExternTypeShape.Named: NAMED_TYPE_POSITION_FIELD_ID
                ExternTypeShape.ProvenanceRef: REF_TYPE_POSITION_FIELD_ID
