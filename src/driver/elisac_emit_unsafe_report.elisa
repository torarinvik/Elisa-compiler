# `-emit unsafe` — collecting the capability rows into the report: each function's declared and
# inferred capabilities, the transitive closure over its calls, the statement-level grants that
# survive only in the tokens, and the boundary rules. `-emit c-archive` writes the same bytes as
# an audit sidecar.


# Walk a body: collect runtime-length locals, `.count`-proven binders, in-body grants, and
# every expression contribution.
def unsafe_static_line_is_taken(taken_lines: darray[u32]&, line: u32) -> bool can[Abort.Panic]:
    for taken_line in taken_lines |taken_lines, line|:
        true return if taken_line == line
    return false



def unsafe_scan_statements(statements: darray[Ast::Stmt], owner: sview, runtime_names: mutable darray[sview]&, proven: mutable darray[sview]&, static_taken_lines: darray[u32]&, owners: mutable darray[sview]&, caps: mutable darray[sview]&, call_from: mutable darray[sview]&, call_to: mutable darray[sview]&, call_qualifier: mutable darray[sview]&, trusted_owners: mutable darray[sview]&, trusted_caps: mutable darray[sview]&, trusted_groups: mutable darray[u32]&, next_trusted_group: mutable u32&) -> void can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        # Locals and binders FIRST, so a subscript earlier in the body still sees them.
        for statement in statements |runtime_names, proven|:
            if statement is Stmt.VarDecl(us_vd_name, us_vd_type, us_vd_value, us_vd_line):
                runtime_names.push(us_vd_name) if unsafe_is_runtime_length(us_vd_type)
            if statement is Stmt.For(us_for_bind, us_for_vars, us_for_iterable, us_for_body, us_for_line):
                # `for i in 0..<xs.count` proves `i` against the container's own length.
                # Recorded WITHOUT tying it to the container, which can only ever suppress a
                # report, never invent one — the direction that keeps over-claim at zero.
                if us_for_iterable is Expr.Binary(us_range_lo, us_range_op, us_range_hi, us_range_line):
                    if us_range_op == Lexer::TokenKind.RangeLt or us_range_op == Lexer::TokenKind.RangeLe:
                        if us_range_hi is Expr.Field(us_count_object, us_count_field, us_count_line):
                            if us_count_field == "count":
                                proven.push(us_for_bind) if us_for_bind != ""
                                for us_for_var in us_for_vars |proven|:
                                    proven.push(us_for_var)
        for statement in statements |owner, runtime_names, proven, owners, caps, call_from, call_to|:
            match statement:
                Stmt.VarDecl(us_s_name, us_s_type, us_s_value, us_s_line):
                    unsafe_scan_expression(us_s_value, owner, runtime_names, proven, owners, caps, call_from, call_to, call_qualifier, trusted_owners, trusted_caps)
                Stmt.Expr(us_e_expression, us_e_line):
                    unsafe_scan_expression(us_e_expression, owner, runtime_names, proven, owners, caps, call_from, call_to, call_qualifier, trusted_owners, trusted_caps)
                Stmt.Return(us_r_value, us_r_line):
                    if us_r_value is us_r_present:
                        unsafe_scan_expression(us_r_present, owner, runtime_names, proven, owners, caps, call_from, call_to, call_qualifier, trusted_owners, trusted_caps)
                Stmt.Assign(us_a_target, us_a_operator, us_a_value, us_a_line):
                    unsafe_scan_expression(us_a_target, owner, runtime_names, proven, owners, caps, call_from, call_to, call_qualifier, trusted_owners, trusted_caps)
                    unsafe_scan_expression(us_a_value, owner, runtime_names, proven, owners, caps, call_from, call_to, call_qualifier, trusted_owners, trusted_caps)
                Stmt.If(us_i_condition, us_i_then, us_i_else, us_i_line):
                    unsafe_scan_expression(us_i_condition, owner, runtime_names, proven, owners, caps, call_from, call_to, call_qualifier, trusted_owners, trusted_caps)
                    unsafe_scan_statements(us_i_then, owner, runtime_names, proven, static_taken_lines, owners, caps, call_from, call_to, call_qualifier, trusted_owners, trusted_caps, trusted_groups, next_trusted_group)
                    unsafe_scan_statements(us_i_else, owner, runtime_names, proven, static_taken_lines, owners, caps, call_from, call_to, call_qualifier, trusted_owners, trusted_caps, trusted_groups, next_trusted_group)
                Stmt.While(us_w_condition, us_w_body, us_w_line):
                    unsafe_scan_expression(us_w_condition, owner, runtime_names, proven, owners, caps, call_from, call_to, call_qualifier, trusted_owners, trusted_caps)
                    unsafe_scan_statements(us_w_body, owner, runtime_names, proven, static_taken_lines, owners, caps, call_from, call_to, call_qualifier, trusted_owners, trusted_caps, trusted_groups, next_trusted_group)
                Stmt.For(us_f_bind, us_f_vars, us_f_iterable, us_f_body, us_f_line):
                    unsafe_scan_expression(us_f_iterable, owner, runtime_names, proven, owners, caps, call_from, call_to, call_qualifier, trusted_owners, trusted_caps)
                    unsafe_scan_statements(us_f_body, owner, runtime_names, proven, static_taken_lines, owners, caps, call_from, call_to, call_qualifier, trusted_owners, trusted_caps, trusted_groups, next_trusted_group)
                Stmt.Block(us_b_kind, us_b_clause, us_b_binding, us_b_body, us_b_line):
                    # `static if` branches remain in the parsed body so later compiler phases
                    # can choose a target. The report must apply that same choice before it
                    # counts grants or effects from the branch.
                    continue if us_b_kind == "static" and not unsafe_static_line_is_taken(static_taken_lines, us_b_line.line)
                    trusted_group: mutable u32 = 0
                    if us_b_kind == "trusted":
                        trusted_group <- next_trusted_group
                        next_trusted_group <- next_trusted_group + 1.u32()
                    # An in-body `can Unsafe.X:` / `trusted Unsafe.X:` grant names a capability
                    # the function HOLDS. Each clause entry is a whole dotted permission
                    # (parse_dotted_name), not split identifier tokens.
                    for us_b_grant in us_b_clause |owners, caps, trusted_owners, trusted_caps, owner, us_b_kind|:
                        if us_b_kind == "trusted" and unsafe_permission_is_unsafe(us_b_grant):
                            unsafe_add_trusted_row(trusted_owners, trusted_caps, owner, us_b_grant)
                            trusted_groups.push(trusted_group) if us_b_kind == "trusted" and unsafe_permission_is_unsafe(us_b_grant)
                        elif unsafe_permission_is_unsafe(us_b_grant):
                            unsafe_add_row(owners, caps, owner, us_b_grant)
                    if us_b_kind == "trusted":
                        # A trusted block is a firewall: unsafe operations and calls inside it
                        # belong only to the trusted audit. Scan with scratch ordinary rows and
                        # edges so a same-named capability declared outside the block is not
                        # accidentally erased later.
                        ignored_owners: mutable darray[sview] = []
                        ignored_caps: mutable darray[sview] = []
                        ignored_call_from: mutable darray[sview] = []
                        ignored_call_to: mutable darray[sview] = []
                        unsafe_scan_statements(us_b_body, owner, runtime_names, proven, static_taken_lines, &ignored_owners, &ignored_caps, &ignored_call_from, &ignored_call_to, call_qualifier, trusted_owners, trusted_caps, trusted_groups, next_trusted_group)
                    else:
                        unsafe_scan_statements(us_b_body, owner, runtime_names, proven, static_taken_lines, owners, caps, call_from, call_to, call_qualifier, trusted_owners, trusted_caps, trusted_groups, next_trusted_group)
                _:
                    pass




# Every function's DECLARED capabilities and its body's contributions. Runtime std function
# bodies are still scanned for trusted blocks, but their ordinary implementation details are
# removed after collection to mirror stage0's per-file trusted-runtime boundary.
def unsafe_append_module_name(storage: mutable darray[u8]&, module: sview) -> void can[Abort.Panic, Memory.Allocate]:
    index: mutable usize = 0
    while index < sview_len(module) |index, storage, module|:
        if index + 1.usize() < sview_len(module) and sview_at(module, index) == 58 and sview_at(module, index + 1.usize()) == 58:
            storage.push(46)
            index <- index + 2.usize()
        else:
            storage.push(sview_at(module, index))
            index <- index + 1.usize()




def unsafe_qualified_name(name: sview, module: sview, storage: mutable darray[u8]&) -> sview can[Abort.Panic, Memory.Allocate]:
    name return if module == ""
    start: usize = storage.count
    unsafe_append_module_name(storage, module)
    storage.push(46)
    for index in 0..<sview_len(name) |storage, name|:
        storage.push(sview_at(name, index))
    return sview(&storage[start], 0, storage.count - start)




def unsafe_offset_is_runtime_std(source: u8&, source_length: usize, target_offset: u32) -> bool can[Abort.Panic]:
    cursor: mutable usize = 0
    runtime: mutable bool = false
    while cursor < source_length and cursor <= target_offset.usize() |cursor, runtime, source, target_offset|:
        line_end: mutable usize = cursor
        while line_end < source_length and source[line_end] != 10 |line_end, source|:
            line_end <- line_end + 1.usize()
        if target_offset.usize() <= line_end:
            return runtime
        directive: bool = line_end - cursor >= 6.usize() and source[cursor] == 35 and source[cursor + 1.usize()] == 108 and source[cursor + 2.usize()] == 105 and source[cursor + 3.usize()] == 110 and source[cursor + 4.usize()] == 101 and (source[cursor + 5.usize()] == 32 or source[cursor + 5.usize()] == 9)
        if directive:
            runtime <- false
            probe: mutable usize = cursor
            while probe < line_end |probe, runtime, source|:
                if line_end - probe >= 14.usize() and source[probe] == 101 and source[probe + 1.usize()] == 108 and source[probe + 2.usize()] == 105 and source[probe + 3.usize()] == 115 and source[probe + 4.usize()] == 97 and source[probe + 5.usize()] == 99 and source[probe + 6.usize()] == 111 and source[probe + 7.usize()] == 114 and source[probe + 8.usize()] == 101 and source[probe + 9.usize()] == 95 and source[probe + 10.usize()] == 115 and source[probe + 11.usize()] == 116 and source[probe + 12.usize()] == 100 and source[probe + 13.usize()] == 47:
                    runtime <- true
                    break
                probe <- probe + 1.usize()
        cursor <- line_end + 1.usize()
    return runtime




def unsafe_collect_declarations(declarations: darray[Ast::Decl]&, export_markers: darray[sview]&, source: u8&, source_length: usize, static_taken_lines: darray[u32]&, module: sview, owner_storage: mutable darray[u8]&, owners: mutable darray[sview]&, caps: mutable darray[sview]&, all_names: mutable darray[sview]&, internal_names: mutable darray[sview]&, runtime_names: mutable darray[sview]&, call_from: mutable darray[sview]&, call_to: mutable darray[sview]&, call_qualifier: mutable darray[sview]&, trusted_owners: mutable darray[sview]&, trusted_caps: mutable darray[sview]&, trusted_groups: mutable darray[u32]&, next_trusted_group: mutable u32&) -> void can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        for declaration in declarations |owners, caps, all_names, internal_names, call_from, call_to|:
            if declaration is Decl.Module(us_m_name, us_m_body, us_m_line):
                unsafe_collect_declarations(us_m_body, export_markers, source, source_length, static_taken_lines, us_m_name, owner_storage, owners, caps, all_names, internal_names, runtime_names, call_from, call_to, call_qualifier, trusted_owners, trusted_caps, trusted_groups, next_trusted_group)
                continue
            if declaration is Decl.Scoped(us_sc_body, us_sc_line):
                unsafe_collect_declarations(us_sc_body, export_markers, source, source_length, static_taken_lines, module, owner_storage, owners, caps, all_names, internal_names, runtime_names, call_from, call_to, call_qualifier, trusted_owners, trusted_caps, trusted_groups, next_trusted_group)
                continue
            if declaration is Decl.Extern(us_x_name, us_x_start, us_x_arity, us_x_variadic, us_x_callable, us_x_ret, us_x_decorators, us_x_line):
                # A callable extern carries Unsafe.RawExtern IMPLICITLY — stage0 reports it
                # for an `extern puts(...)` that declares no `can` clause at all.
                #
                # But `export fn name(...) = target` ALSO parses to Decl.Extern, and an EXPORT
                # is not a foreign import: it publishes an Elisa function under a C symbol and
                # calls nothing foreign. Counting those reported RawExtern: 4 for a unit with
                # four exports and no externs at all, where stage0 reports 0.
                continue if not us_x_callable
                qualified_extern: sview = unsafe_qualified_name(us_x_name, module, owner_storage)
                internal_names.push(qualified_extern) if unsafe_is_internal_decorated(us_x_decorators)
                us_x_is_export: mutable bool = false
                for us_x_annotation in export_markers |us_x_is_export, us_x_name|:
                    us_x_is_export <- true if us_x_annotation == us_x_name
                continue if us_x_is_export
                all_names.push(qualified_extern)
                unsafe_add_row(owners, caps, qualified_extern, "Unsafe.RawExtern")
                continue
            if declaration is Decl.Func(us_f_name, us_f_params, us_f_ret, us_f_body, us_f_effects, us_f_decorators, us_f_line):
                qualified_function: sview = unsafe_qualified_name(us_f_name, module, owner_storage)
                internal_names.push(qualified_function) if unsafe_is_internal_decorated(us_f_decorators)
                runtime_names.push(qualified_function) if unsafe_offset_is_runtime_std(source, source_length, us_f_line.offset)
                all_names.push(qualified_function)
                for us_f_effect in us_f_effects |owners, caps, us_f_name|:
                    unsafe_add_row(owners, caps, qualified_function, us_f_effect) if unsafe_permission_is_unsafe(us_f_effect)
                length_names: mutable darray[sview] = []
                proven: mutable darray[sview] = []
                for us_f_param in us_f_params |length_names|:
                    length_names.push(us_f_param.name) if unsafe_is_runtime_length(us_f_param.type_expression)
                unsafe_scan_statements(us_f_body, qualified_function, &length_names, &proven, static_taken_lines, owners, caps, call_from, call_to, call_qualifier, trusted_owners, trusted_caps, trusted_groups, next_trusted_group)




# Remove ordinary rows and call edges belonging to `@internal` declarations before the
# transitive closure. Trusted rows are kept separately and intentionally remain visible in the
# audit, because they describe the implementation's explicit trust boundary.
def unsafe_filter_internal_rows(internal_names: darray[sview]&, owners: mutable darray[sview]&, caps: mutable darray[sview]&, call_from: mutable darray[sview]&, call_to: mutable darray[sview]&, call_qualifier: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    row: mutable usize = 0
    write_row: mutable usize = 0
    while row < owners.count |row, write_row, owners, caps, internal_names|:
        is_internal: mutable bool = false
        for internal_name in internal_names |is_internal, owners, row|:
            is_internal <- true if internal_name == owners[row]
        if not is_internal:
            owners[write_row] <- owners[row]
            caps[write_row] <- caps[row]
            write_row <- write_row + 1.usize()
        row <- row + 1.usize()
    owners.truncate(write_row)
    caps.truncate(write_row)
    edge: mutable usize = 0
    write_edge: mutable usize = 0
    while edge < call_from.count |edge, write_edge, call_from, call_to, internal_names|:
        skip_edge: mutable bool = false
        for internal_name in internal_names |skip_edge, call_from, call_to, edge|:
            skip_edge <- true if internal_name == call_from[edge] or internal_name == call_to[edge]
        if not skip_edge:
            call_from[write_edge] <- call_from[edge]
            call_to[write_edge] <- call_to[edge]
            call_qualifier[write_edge] <- call_qualifier[edge] if edge < call_qualifier.count
            write_edge <- write_edge + 1.usize()
        edge <- edge + 1.usize()
    call_from.truncate(write_edge)
    call_to.truncate(write_edge)
    call_qualifier.truncate(write_edge) if call_qualifier.count > write_edge




# Resolve a qualified call without manufacturing a new string. The AST keeps the module
# qualifier and member as separate views; declaration owners use the same spelling with `.` in
# place of `::`. Ambiguous bare calls are rejected rather than guessed.
def unsafe_call_target_matches(candidate: sview, qualifier: sview, member: sview) -> bool can[Abort.Panic]:
    return false if sview_len(candidate) <= sview_len(member) + 1.usize()
    return false if sview_at(candidate, sview_len(candidate) - sview_len(member) - 1.usize()) != 46
    member_start: usize = sview_len(candidate) - sview_len(member)
    for member_index in 0..<sview_len(member) |candidate, member, member_start|:
        false return if sview_at(candidate, member_start + member_index) != sview_at(member, member_index)
    prefix_length: usize = member_start - 1.usize()
    qualifier_index: mutable usize = 0
    candidate_index: mutable usize = 0
    while qualifier_index < sview_len(qualifier) and candidate_index < prefix_length |qualifier_index, candidate_index, qualifier, candidate, prefix_length|:
        if qualifier_index + 1.usize() < sview_len(qualifier) and sview_at(qualifier, qualifier_index) == 58 and sview_at(qualifier, qualifier_index + 1.usize()) == 58:
            false return if candidate_index >= prefix_length or sview_at(candidate, candidate_index) != 46
            qualifier_index <- qualifier_index + 2.usize()
            candidate_index <- candidate_index + 1.usize()
        else:
            false return if sview_at(qualifier, qualifier_index) != sview_at(candidate, candidate_index)
            qualifier_index <- qualifier_index + 1.usize()
            candidate_index <- candidate_index + 1.usize()
    return qualifier_index == sview_len(qualifier) and candidate_index == prefix_length



def unsafe_resolve_call_target(member: sview, qualifier: sview, all_names: darray[sview]&) -> sview can[Abort.Panic]:
    return unsafe_resolve_effect_owner(member, all_names) if qualifier == ""
    found: mutable sview = ""
    for candidate in all_names |found, member, qualifier|:
        continue if not unsafe_call_target_matches(candidate, qualifier, member)
        return sview("", 0, 0) if found != ""
        found <- candidate
    return found



# Transitive closure: a caller holds everything its callees hold.
def unsafe_close_over_calls(owners: mutable darray[sview]&, caps: mutable darray[sview]&, call_from: darray[sview]&, call_to: darray[sview]&, call_qualifier: darray[sview]&, all_names: darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    changed: mutable bool = true
    while changed |changed, owners, caps, call_from, call_to|:
        changed <- false
        for edge in 0..<call_from.count |changed, owners, caps, call_from, call_to|:
            caller: sview = call_from[edge]
            qualifier: sview = call_qualifier[edge] if edge < call_qualifier.count else ""
            callee: sview = unsafe_resolve_call_target(call_to[edge], qualifier, all_names)
            continue if callee == ""
            for row in 0..<owners.count |changed, owners, caps, caller, callee|:
                continue if owners[row] != callee
                cap: sview = caps[row]
                present: mutable bool = false
                for probe in 0..<owners.count |present, owners, caps, caller, cap|:
                    present <- true if owners[probe] == caller and caps[probe] == cap
                if not present:
                    owners.push(caller)
                    caps.push(cap)
                    changed <- true




def unsafe_boundary_name(index: i64) -> sview can[Abort.Panic]:
    return when index:
        0 -> "GuestHostPointer"
        1 -> "ExecutableCodePublish"
        2 -> "MachineSegmentState"
        3 -> "TinyCallable"
        4 -> "ThreadAffineSignalJump"
        _ -> ""




def unsafe_boundary_triggers(index: i64) -> sview can[Abort.Panic]:
    return when index:
        0 -> "PointerCast PointerArithmetic GuestHostPointerCast"
        1 -> "ExecutableCodePublish MachineCodeBuilder Assembly"
        2 -> "SegmentMutation GuestSegmentInstall"
        3 -> "IndirectCall PoisonPointerSentinel TinyPointerSentinel"
        4 -> "CrossThreadSignalJump ThreadShare"
        _ -> ""




def unsafe_boundary_rule(index: i64, which: i64) -> sview can[Abort.Panic]:
    match index:
        0:
            return when which:
                0 -> "guest addresses must resolve to a proven host/native-mapped pointer before dereference"
                1 -> "trace every guest-to-host address resolve with address, length, mapping, and result"
                _ -> "debug/referee mode traps unresolved, unmapped, poison, or near-null address use"
        1:
            return when which:
                0 -> "runtime executable code must flow through a named publish primitive before call/jump"
                1 -> "trace publish address, size, protection, cache/publish result, and first execution"
                _ -> "debug/referee mode halts execution of unpublished generated code"
        2:
            return when which:
                0 -> "segment register writes require an explicit restore/persistent contract"
                1 -> "trace every host/guest segment switch with thread id and selector"
                _ -> "debug/referee mode asserts expected segment state at guest/host boundaries"
        3:
            return when which:
                0 -> "callable targets must not be poison or near-null unless explicitly marked sentinel"
                1 -> "trace every dynamic callable materialization with source slot/symbol provenance"
                _ -> "debug/referee mode halts poison, non-canonical, or near-null call/jump targets"
        _:
            return when which:
                0 -> "signal-handler longjmp requires a thread-affine buffer or explicit cross-thread trust"
                1 -> "trace signal number, faulting thread, guard thread, and jump decision"
                _ -> "referee mode refuses cross-thread longjmp and records a labeled boundary fault"




def unsafe_triggers_contain(haystack: sview, needle: sview) -> bool can[Abort.Panic]:
    start: mutable usize = 0
    while start < sview_len(haystack) |start, haystack, needle|:
        stop: mutable usize = start
        while stop < sview_len(haystack) and sview_at(haystack, stop) != 32 |stop, haystack|:
            stop <- stop + 1
        if stop - start == sview_len(needle):
            matched: mutable bool = true
            for probe in 0..<sview_len(needle) |matched, haystack, needle, start|:
                matched <- false if sview_at(haystack, start + probe) != sview_at(needle, probe)
            true return if matched
        start <- stop + 1
    return false




# STATEMENT-LEVEL grants, recovered from tokens: `x = expr can Unsafe.PointerCast`.
#
# A postfix `can` on a statement is not a `Stmt.Block` clause and the AST does not carry it
# (the formatter recovers it from tokens too), so it is scanned here and attributed to the
# enclosing function by LINE. Without it a unit whose only pointer cast is granted this way
# reported Unsafe.PointerCast: 0.
def unsafe_collect_token_grants(declarations: darray[Decl]&, tokens: darray[Lexer::Token]&, source: u8&, owners: mutable darray[sview]&, caps: mutable darray[sview]&, trusted_owners: mutable darray[sview]&, trusted_caps: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    # Function start lines, so a grant can be attributed to the function containing it.
    fn_names: mutable darray[sview] = []
    fn_lines: mutable darray[u32] = []
    for declaration in declarations |fn_names, fn_lines|:
        if declaration is Decl.Func(ug_name, ug_params, ug_ret, ug_body, ug_effects, ug_decorators, ug_line):
            fn_names.push(ug_name)
            fn_lines.push(ug_line.line)
    return if fn_names.count == 0
    for probe in 0..<tokens.count |owners, caps, trusted_owners, trusted_caps, tokens, source, fn_names, fn_lines|:
        continue if tokens[probe].kind != Lexer::TokenKind.Ident
        grant_keyword: sview = Lexer::text_or_empty(tokens[probe], source)
        continue if grant_keyword != "can"
        # `can Unsafe.X` — an Ident "Unsafe", a Dot, then the capability name.
        continue if probe + 3 >= tokens.count
        continue if Lexer::text_or_empty(tokens[probe + 1], source) != "Unsafe"
        continue if tokens[probe + 2].kind != Lexer::TokenKind.Dot
        member: sview = Lexer::text_or_empty(tokens[probe + 3], source)
        continue if member == ""
        # The enclosing function is the one with the greatest start line at or before this.
        best: mutable sview = ""
        best_line: mutable u32 = 0
        for candidate in 0..<fn_names.count |best, best_line, fn_names, fn_lines, tokens, probe|:
            continue if fn_lines[candidate] > tokens[probe].line
            if best == "" or fn_lines[candidate] >= best_line:
                best <- fn_names[candidate]
                best_line <- fn_lines[candidate]
        continue if best == ""
        # Rebuild the dotted spelling; the pool holds whole permissions elsewhere.
        for capability_index in 0..<22 |owners, caps, best, member|:
            capability: sview = unsafe_capability_at(capability_index)
            continue if capability != member
            unsafe_add_row(owners, caps, best, unsafe_dotted_capability(capability_index))




# The `Unsafe.<capability>` spelling for a capability index, as a stable sview.
def unsafe_dotted_capability(index: i64) -> sview can[Abort.Panic]:
    return when index:
        0 -> "Unsafe.PointerCast"
        1 -> "Unsafe.PointerArithmetic"
        2 -> "Unsafe.IndirectCall"
        3 -> "Unsafe.UncheckedIndex"
        4 -> "Unsafe.RawExtern"
        5 -> "Unsafe.MutableGlobal"
        6 -> "Unsafe.ThreadShare"
        7 -> "Unsafe.StaleRef"
        8 -> "Unsafe.Alias"
        9 -> "Unsafe.BufferReinterpret"
        10 -> "Unsafe.Assembly"
        11 -> "Unsafe.ExecutableCodePublish"
        12 -> "Unsafe.GuestHostPointerCast"
        13 -> "Unsafe.PoisonPointerSentinel"
        14 -> "Unsafe.TinyPointerSentinel"
        15 -> "Unsafe.SegmentMutation"
        16 -> "Unsafe.GuestSegmentInstall"
        17 -> "Unsafe.CrossThreadSignalJump"
        18 -> "Unsafe.MachineCodeBuilder"
        19 -> "Unsafe.NonProgress"
        20 -> "Unsafe.BlockMain"
        21 -> "Unsafe.AssumeProgress"
        _ -> ""




def unsafe_trusted_group_owner(group: u32, trusted_owners: darray[sview]&, trusted_groups: darray[u32]&) -> sview can[Abort.Panic]:
    for row in 0..<trusted_groups.count |row, group, trusted_owners, trusted_groups|:
        return trusted_owners[row] if trusted_groups[row] == group
    return ""



def unsafe_trusted_group_pick(group: u32, trusted_caps: darray[sview]&, trusted_groups: darray[u32]&, shown: darray[sview]&) -> sview can[Abort.Panic]:
    best: mutable sview = ""
    found: mutable bool = false
    for row in 0..<trusted_groups.count |row, group, trusted_caps, trusted_groups, shown, best, found|:
        continue if trusted_groups[row] != group
        candidate: sview = trusted_caps[row]
        already: mutable bool = false
        for done in shown |already, candidate|:
            already <- true if done == candidate
        continue if already
        if not found or unsafe_name_less(candidate, best):
            best <- candidate
            found <- true
    return best



def unsafe_trusted_group_less(left: u32, right: u32, trusted_owners: darray[sview]&, trusted_caps: darray[sview]&, trusted_groups: darray[u32]&) -> bool can[Abort.Panic, Memory.Allocate]:
    left_owner: sview = unsafe_trusted_group_owner(left, trusted_owners, trusted_groups)
    right_owner: sview = unsafe_trusted_group_owner(right, trusted_owners, trusted_groups)
    return true if unsafe_name_less(left_owner, right_owner)
    return false if unsafe_name_less(right_owner, left_owner)
    left_shown: mutable darray[sview] = []
    right_shown: mutable darray[sview] = []
    for _round in 0..<22 |left_shown, right_shown, left, right, trusted_caps, trusted_groups|:
        left_cap: sview = unsafe_trusted_group_pick(left, trusted_caps, trusted_groups, left_shown)
        right_cap: sview = unsafe_trusted_group_pick(right, trusted_caps, trusted_groups, right_shown)
        if left_cap == "":
            return false
        if right_cap == "":
            return true
        return true if unsafe_name_less(left_cap, right_cap)
        return false if unsafe_name_less(right_cap, left_cap)
        left_shown.push(left_cap)
        right_shown.push(right_cap)
    return left < right



def unsafe_emit_trusted_report(buffer: mutable darray[u8]&, trusted_owners: darray[sview]&, trusted_caps: darray[sview]&, trusted_groups: darray[u32]&, group_count: u32) -> void can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(buffer, "trusted-total: ")
    append_decimal(buffer, trusted_owners.count.u32())
    buffer.push(10)
    if trusted_owners.count == 0:
        emit_tokens_push_sview(buffer, "trusted: none\n")
        return
    emit_tokens_push_sview(buffer, "trusted:\n")
    for capability_index in 0..<22 |buffer, trusted_caps|:
        capability: sview = unsafe_dotted_capability(capability_index)
        count: mutable u32 = 0
        for cap in trusted_caps |count, capability|:
            count <- count + 1 if cap == capability
        continue if count == 0
        emit_tokens_push_sview(buffer, "  ")
        emit_tokens_push_sview(buffer, capability)
        emit_tokens_push_sview(buffer, ": ")
        append_decimal(buffer, count)
        buffer.push(10)
    emitted: mutable darray[u32] = []
    for _round in 0..<group_count |buffer, trusted_owners, trusted_caps, trusted_groups, group_count, emitted|:
        best: mutable u32 = 0
        found: mutable bool = false
        for candidate in 0..<group_count |best, found, trusted_owners, trusted_caps, trusted_groups, emitted|:
            already: mutable bool = false
            for done in emitted |already, candidate|:
                already <- true if done == candidate
            continue if already
            if not found or unsafe_trusted_group_less(candidate, best, trusted_owners, trusted_caps, trusted_groups):
                best <- candidate
                found <- true
        break if not found
        emitted.push(best)
        emit_tokens_push_sview(buffer, "  ")
        emit_tokens_push_sview(buffer, unsafe_trusted_group_owner(best, trusted_owners, trusted_groups))
        emit_tokens_push_sview(buffer, ": ")
        first: mutable bool = true
        shown: mutable darray[sview] = []
        for _permission_round in 0..<22 |buffer, trusted_caps, trusted_groups, best, first, shown|:
            pick: sview = unsafe_trusted_group_pick(best, trusted_caps, trusted_groups, shown)
            break if pick == ""
            shown.push(pick)
            emit_tokens_push_sview(buffer, ", ") if not first
            first <- false
            emit_tokens_push_sview(buffer, pick)
        buffer.push(10)




def unsafe_collect_segment_transition_rows(annotations: darray[Ast::EnumAnnotation]&, owner_storage: mutable darray[u8]&, owners: mutable darray[sview]&, caps: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    for annotation in annotations |owners, caps|:
        is_transition: bool = annotation.name == "__seg_transition_host" or annotation.name == "__seg_transition_guest"
        qualified_owner: sview = unsafe_qualified_name(annotation.owner, annotation.module, owner_storage)
        unsafe_add_row(owners, caps, qualified_owner, "Unsafe.SegmentMutation") if is_transition and annotation.owner != ""




def unsafe_qualified_name_equals(candidate: sview, wanted: sview) -> bool can[Abort.Panic]:
    candidate_index: mutable usize = 0
    wanted_index: mutable usize = 0
    while candidate_index < sview_len(candidate) and wanted_index < sview_len(wanted) |candidate_index, wanted_index, candidate, wanted|:
        if wanted_index + 1.usize() < sview_len(wanted) and sview_at(wanted, wanted_index) == 58 and sview_at(wanted, wanted_index + 1.usize()) == 58:
            false return if sview_at(candidate, candidate_index) != 46
            wanted_index <- wanted_index + 2.usize()
            candidate_index <- candidate_index + 1.usize()
        else:
            false return if sview_at(candidate, candidate_index) != sview_at(wanted, wanted_index)
            wanted_index <- wanted_index + 1.usize()
            candidate_index <- candidate_index + 1.usize()
    return candidate_index == sview_len(candidate) and wanted_index == sview_len(wanted)



def unsafe_resolve_effect_owner(owner: sview, all_names: darray[sview]&) -> sview can[Abort.Panic]:
    exact: mutable sview = ""
    suffix: mutable sview = ""
    for candidate in all_names |exact, suffix, owner|:
        if candidate == owner or unsafe_qualified_name_equals(candidate, owner):
            exact <- candidate
        elif sview_len(candidate) > sview_len(owner) + 1.usize() and sview_at(candidate, sview_len(candidate) - sview_len(owner) - 1.usize()) == 46:
            start: usize = sview_len(candidate) - sview_len(owner)
            matches: mutable bool = true
            for offset in 0..<sview_len(owner) |matches, candidate, owner, start|:
                matches <- false if sview_at(candidate, start + offset) != sview_at(owner, offset)
            if matches:
                return sview("", 0, 0) if suffix != ""
                suffix <- candidate
    return exact if exact != "" else suffix



def unsafe_merge_semantic_effects(file: Ast::File&, all_names: darray[sview]&, runtime_function_names: darray[sview]&, internal_names: darray[sview]&, owners: mutable darray[sview]&, caps: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    table: Semantic::SymbolTable = Semantic::check_full(file, true, false, false, false, false, false, false, false, false, false, 64, false)
    # The regular effect table contains typed semantic facts such as mutable-alias
    # reborrows. They are not always recoverable from the compact AST alone, so
    # include every concrete Unsafe.* row alongside the specialized pointer-cast
    # registry. unsafe_add_row keeps declared and inferred facts idempotent.
    for effect_index in 0..<table.function_effect_owner.count |effect_index, table, all_names, runtime_function_names, internal_names, owners, caps|:
        effect: sview = table.function_effect_name[effect_index]
        continue if not unsafe_permission_is_unsafe(effect)
        resolved_owner: sview = unsafe_resolve_effect_owner(table.function_effect_owner[effect_index], all_names)
        continue if resolved_owner == ""
        continue if unsafe_name_present(runtime_function_names, resolved_owner) or unsafe_name_present(internal_names, resolved_owner)
        unsafe_add_row(owners, caps, resolved_owner, effect)
    for effect_index in 0..<table.function_unsafe_owner.count |effect_index, table, all_names, runtime_function_names, internal_names, owners, caps|:
        effect: sview = table.function_unsafe_name[effect_index]
        continue if not unsafe_permission_is_unsafe(effect)
        resolved_owner: sview = unsafe_resolve_effect_owner(table.function_unsafe_owner[effect_index], all_names)
        continue if resolved_owner == ""
        continue if unsafe_name_present(runtime_function_names, resolved_owner) or unsafe_name_present(internal_names, resolved_owner)
        unsafe_add_row(owners, caps, resolved_owner, effect)



def unsafe_name_present(names: darray[sview]&, wanted: sview) -> bool can[Abort.Panic]:
    for name in names |names, wanted|:
        true return if name == wanted
    return false



def build_unsafe_report(file: Ast::File&, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    owners: mutable darray[sview] = []
    caps: mutable darray[sview] = []
    trusted_owners: mutable darray[sview] = []
    trusted_caps: mutable darray[sview] = []
    trusted_groups: mutable darray[u32] = []
    next_trusted_group: mutable u32 = 0
    all_names: mutable darray[sview] = []
    internal_names: mutable darray[sview] = []
    call_from: mutable darray[sview] = []
    call_to: mutable darray[sview] = []
    call_qualifier: mutable darray[sview] = []
    runtime_function_names: mutable darray[sview] = []
    owner_storage: mutable darray[u8] = []
    owner_storage.reserve(tokens.count * 64 + 4096) if tokens.count > 0
    alias_fn_names: mutable darray[sview] = []
    alias_fn_indices: mutable darray[usize] = []
    alias_param_names: mutable darray[sview] = []
    # `export fn` shares Decl.Extern with a real foreign import; the `__export_fn` marker is
    # what tells them apart.
    # `-emit unsafe` is a report of the PROGRAM that will be emitted, not of every
    # declaration hidden in a target-specific `static if`. The stage0 semantic pass selects
    # those branches before building its permission summary. Reuse the backend's target-aware
    # selector so the report and code generation share one branch decision.
    selected_declarations: darray[Decl] = Backend::select_declarations_for_report(file)
    export_markers: mutable darray[sview] = []
    for export_annotation in file.enum_annotations |export_markers|:
        export_markers.push(export_annotation.owner) if export_annotation.name == "__export_fn"
    static_taken_lines: darray[u32] = Backend::selected_static_lines_for_report(file)
    unsafe_collect_declarations(selected_declarations, export_markers, source, source_length, static_taken_lines, "", &owner_storage, &owners, &caps, &all_names, &internal_names, &runtime_function_names, &call_from, &call_to, &call_qualifier, &trusted_owners, &trusted_caps, &trusted_groups, &next_trusted_group)
    unsafe_collect_alias_param_info(selected_declarations, &alias_fn_names, &alias_fn_indices, &alias_param_names)
    unsafe_collect_alias_flow(selected_declarations, "", &owner_storage, alias_fn_names, alias_fn_indices, &owners, &caps)
    unsafe_collect_alias_reborrows(file.top_decls, alias_fn_names, alias_fn_indices, alias_param_names, &owners, &caps)
    unsafe_collect_token_grants(selected_declarations, tokens, source, &owners, &caps, &trusted_owners, &trusted_caps)
    unsafe_collect_segment_transition_rows(file.enum_annotations, &owner_storage, &owners, &caps)
    unsafe_merge_semantic_effects(file, all_names, runtime_function_names, internal_names, &owners, &caps)
    unsafe_filter_internal_rows(internal_names, &owners, &caps, &call_from, &call_to, &call_qualifier)
    unsafe_filter_internal_rows(runtime_function_names, &owners, &caps, &call_from, &call_to, &call_qualifier)
    unsafe_close_over_calls(&owners, &caps, call_from, call_to, call_qualifier, all_names)

    buffer: mutable darray[u8] = []
    emit_tokens_push_sview(&buffer, "=== unsafe ===\ntotal: ")
    append_decimal(&buffer, owners.count.u32())
    emit_tokens_push_sview(&buffer, "\ncapabilities:\n")
    for capability_index in 0..<22 |buffer, caps|:
        capability: sview = unsafe_capability_at(capability_index)
        count: mutable u32 = 0
        for cap in caps |count, capability|:
            count <- count + 1 if unsafe_permission_is(cap, capability)
        emit_tokens_push_sview(&buffer, "  Unsafe.")
        emit_tokens_push_sview(&buffer, capability)
        emit_tokens_push_sview(&buffer, ": ")
        append_decimal(&buffer, count)
        buffer.push(10)

    active_any: mutable bool = false
    for boundary_probe in 0..<5 |active_any, caps, trusted_caps|:
        for cap in caps |active_any, boundary_probe|:
            for capability_index in 0..<22 |active_any, cap, boundary_probe|:
                capability: sview = unsafe_capability_at(capability_index)
                continue if not unsafe_permission_is(cap, capability)
                active_any <- true if unsafe_triggers_contain(unsafe_boundary_triggers(boundary_probe), capability)
        for cap in trusted_caps |active_any, boundary_probe|:
            for capability_index in 0..<22 |active_any, cap, boundary_probe|:
                capability: sview = unsafe_capability_at(capability_index)
                continue if not unsafe_permission_is(cap, capability)
                active_any <- true if unsafe_triggers_contain(unsafe_boundary_triggers(boundary_probe), capability)
    if not active_any:
        emit_tokens_push_sview(&buffer, "boundary-invariants: none\n")
    else:
        emit_tokens_push_sview(&buffer, "boundary-invariants:\n")
        for boundary_index in 0..<5 |buffer, caps, trusted_caps|:
            boundary_active: mutable bool = false
            for cap in caps |boundary_active, boundary_index|:
                for capability_index in 0..<22 |boundary_active, cap, boundary_index|:
                    capability: sview = unsafe_capability_at(capability_index)
                    continue if not unsafe_permission_is(cap, capability)
                    boundary_active <- true if unsafe_triggers_contain(unsafe_boundary_triggers(boundary_index), capability)
            for cap in trusted_caps |boundary_active, boundary_index|:
                for capability_index in 0..<22 |boundary_active, cap, boundary_index|:
                    capability: sview = unsafe_capability_at(capability_index)
                    continue if not unsafe_permission_is(cap, capability)
                    boundary_active <- true if unsafe_triggers_contain(unsafe_boundary_triggers(boundary_index), capability)
            continue if not boundary_active
            emit_tokens_push_sview(&buffer, "  ")
            emit_tokens_push_sview(&buffer, unsafe_boundary_name(boundary_index))
            emit_tokens_push_sview(&buffer, ":\n    static: ")
            emit_tokens_push_sview(&buffer, unsafe_boundary_rule(boundary_index, 0))
            emit_tokens_push_sview(&buffer, "\n    trace: ")
            emit_tokens_push_sview(&buffer, unsafe_boundary_rule(boundary_index, 1))
            emit_tokens_push_sview(&buffer, "\n    runtime: ")
            emit_tokens_push_sview(&buffer, unsafe_boundary_rule(boundary_index, 2))
            buffer.push(10)

    if owners.count == 0:
        emit_tokens_push_sview(&buffer, "functions: none\n")
    else:
        emit_tokens_push_sview(&buffer, "functions:\n")
        emitted: mutable darray[sview] = []
        for _round in 0..<owners.count |buffer, owners, caps, emitted|:
            best: mutable sview = ""
            found: mutable bool = false
            for candidate in 0..<owners.count |best, found, owners, emitted|:
                name: sview = owners[candidate]
                already: mutable bool = false
                for done in emitted |already, name|:
                    already <- true if done == name
                continue if already
                if not found or unsafe_name_less(name, best):
                    best <- name
                    found <- true
            break if not found
            emitted.push(best)
            emit_tokens_push_sview(&buffer, "  ")
            emit_tokens_push_sview(&buffer, best)
            emit_tokens_push_sview(&buffer, ": ")
            # ALPHABETICAL by dotted name, which is how stage0 prints a function's list —
            # NOT the capability-table order used for the `capabilities:` block above.
            first: mutable bool = true
            shown: mutable darray[sview] = []
            for _permission_round in 0..<owners.count |buffer, owners, caps, best, first, shown|:
                pick: mutable sview = ""
                picked: mutable bool = false
                for row in 0..<owners.count |pick, picked, owners, caps, best, shown|:
                    continue if owners[row] != best
                    candidate: sview = caps[row]
                    already: mutable bool = false
                    for done in shown |already, candidate|:
                        already <- true if done == candidate
                    continue if already
                    if not picked or unsafe_name_less(candidate, pick):
                        pick <- candidate
                        picked <- true
                break if not picked
                shown.push(pick)
                emit_tokens_push_sview(&buffer, ", ") if not first
                first <- false
                emit_tokens_push_sview(&buffer, pick)
            buffer.push(10)

    unsafe_emit_trusted_report(&buffer, trusted_owners, trusted_caps, trusted_groups, next_trusted_group)
    return buffer




# `-emit unsafe` writes the report built above; `-emit c-archive` writes the same bytes to
# its `<base>.unsafe.txt` sidecar.
def emit_unsafe_report(file: Ast::File&, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    report: darray[u8] = build_unsafe_report(file, tokens, source, source_length)
    return emit_tokens_flush(report)
