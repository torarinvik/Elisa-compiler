# Pure refusal predicates shared by the frontend IR declaration writer and its proofs.
module FrontendIrDeclPolicy:
    def function_requires_refusal(body_needs_stage0_auto_region: bool) -> bool:
        return body_needs_stage0_auto_region

    def struct_requires_refusal(has_named_states: bool, has_derive: bool) -> bool:
        return has_named_states or has_derive

    def scoped_declaration_requires_refusal() -> bool:
        return true
