# Pure policy boundary between stage1 source/environment observations and the semantic gate.
# Keeping observations as parameters makes the option policy independently replayable.
include "../semantic/incremental_semantic_options.elisa"

# The semantic analyzer's Stage1 region-stack budget is part of the option policy.
const STAGE1_REGION_STACK_CAP: i64 = 64

def stage1_semantic_options_from_observations(
    strict_header: bool,
    runtime_std_detected: bool,
    smt_environment_enabled: bool,
    smt_header: bool,
    strict_externs_environment_enabled: bool,
    strict_externs_header: bool,
    unsafe_header: bool,
    proofhole_header: bool,
    globals_header: bool,
    permissive_environment_enabled: bool,
    carrier_surface_enabled: bool
) -> Semantic::IncrementalSemanticOptions:
    ensure result.enforce_unsafe_permissions == strict_header
    ensure result.flow_strict == false
    ensure result.runtime_std == runtime_std_detected
    ensure result.flow_warn == false
    ensure result.enable_smt == (smt_environment_enabled or smt_header)
    ensure result.warn_discarded == false
    ensure result.enforce_progress == false
    ensure result.enforce_extern_contracts == (strict_externs_environment_enabled or strict_externs_header)
    ensure result.enforce_raw_unsafe == unsafe_header
    ensure result.emit_proof_hole == proofhole_header
    ensure result.region_stack_cap == STAGE1_REGION_STACK_CAP
    ensure result.enforce_global_permissions == globals_header
    ensure result.enforce_mutable_global_grants != permissive_environment_enabled
    ensure result.carrier_surface == carrier_surface_enabled
    return Semantic::incremental_semantic_options_from_values(
        strict_header,
        false,
        runtime_std_detected,
        false,
        smt_environment_enabled or smt_header,
        false,
        false,
        strict_externs_environment_enabled or strict_externs_header,
        unsafe_header,
        proofhole_header,
        STAGE1_REGION_STACK_CAP,
        globals_header,
        not permissive_environment_enabled,
        carrier_surface_enabled
    )
