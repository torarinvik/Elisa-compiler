# Pure category/reason labels used by the never-leak stats reporter. The named semantic codes
# keep this output contract synchronized with the analyzer.
module NeverLeakReportNames:
    public:
        def severity_prefix(mode: u8) -> sview:
            return ": error: " if mode == NeverLeakEnvValues::NL_ENV_MODE_ERROR else ": warning: "

        def category_name(category: u8) -> sview can[Abort.Panic]:
            return when category:
                Semantic::NEVER_LEAK_CHAIN -> "chain"
                Semantic::NEVER_LEAK_PLAIN -> "plain"
                Semantic::NEVER_LEAK_BORROW_EXEMPT -> "borrow-exempt"
                Semantic::NEVER_LEAK_OVERLAP -> "overlap"
                Semantic::NEVER_LEAK_LOOP -> "loop"
                Semantic::NEVER_LEAK_ACCUMULATOR -> "accumulator"
                Semantic::NEVER_LEAK_VALUE_THREAD -> "value-thread"
                Semantic::NEVER_LEAK_PUSH_LOOP -> "push-loop"
                _ -> "loop"

        def category_phrase(category: u8, escapes: bool) -> sview can[Abort.Panic]:
            return when category:
                Semantic::NEVER_LEAK_CHAIN -> "chain with a loop jump (its last use binds another local, and a `break`/`continue` for an enclosing loop lies in between)" if escapes else "chain (its last use binds another local, so that binding can take the statements as a block expression)"
                Semantic::NEVER_LEAK_OVERLAP -> "overlap (a local declared after it is still needed after its last use)"
                Semantic::NEVER_LEAK_LOOP -> "loop (its last use is a loop it feeds: a counter, accumulator or loop input)"
                _ -> "plain (its last use is a statement with no value to bind)"

        def accumulator_reason_name(reason: u8) -> sview can[Abort.Panic]:
            return when reason:
                Semantic::NEVER_LEAK_ACC_OK -> ""
                Semantic::NEVER_LEAK_ACC_READ_INSIDE -> "-read-inside"
                Semantic::NEVER_LEAK_ACC_WRITTEN_AFTER -> "-written-after"
                Semantic::NEVER_LEAK_ACC_NOT_SCALAR -> "-not-scalar"
                Semantic::NEVER_LEAK_ACC_ESCAPES -> "-escape"
                Semantic::NEVER_LEAK_ACC_SHAPE -> "-shape"
                _ -> "-shape"

        def value_thread_reason_name(reason: u8) -> sview can[Abort.Panic]:
            return when reason:
                Semantic::NEVER_LEAK_VT_OK -> ""
                Semantic::NEVER_LEAK_VT_BORROW -> "-borrow"
                Semantic::NEVER_LEAK_VT_BORROWED_FIELD -> "-borrowed-field"
                Semantic::NEVER_LEAK_VT_GLOBAL -> "-global"
                Semantic::NEVER_LEAK_VT_ARENA -> "-arena"
                Semantic::NEVER_LEAK_VT_EFFECT_ONLY -> "-effect-only"
                Semantic::NEVER_LEAK_VT_SHAPE -> "-shape"
                _ -> "-shape"
