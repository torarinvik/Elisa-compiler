# Closed scalar-name and boundary-label tables used by generated Python bindings.
module PymoduleTypeClassification:
    public:
        def is_scalar_field_type(type_name: sview) -> bool can[Abort.Panic]:
            ensure result == (
                when type_name:
                    "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "char" -> true
                    "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" -> true
                    "f32" | "f64" | "bool" | "cstr" | "sview" | "py::Object" -> true
                    "cstr?" | "py::Object?" -> true
                    "i8?" | "i16?" | "i32?" | "i64?" | "int?" | "isize?" | "char?" -> true
                    "u8?" | "u16?" | "u32?" | "u64?" | "usize?" | "uintptr?" -> true
                    "bool?" | "f32?" | "f64?" | "sview?" -> true
                    _ -> false
            )
            can Abort.Panic:
                return when type_name:
                    "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "char" -> true
                    "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" -> true
                    "f32" | "f64" | "bool" | "cstr" | "sview" | "py::Object" -> true
                    "cstr?" | "py::Object?" -> true
                    "i8?" | "i16?" | "i32?" | "i64?" | "int?" | "isize?" | "char?" -> true
                    "u8?" | "u16?" | "u32?" | "u64?" | "usize?" | "uintptr?" -> true
                    "bool?" | "f32?" | "f64?" | "sview?" -> true
                    _ -> false

        def known_python_expected_type(type_name: sview) -> sview can[Abort.Panic]:
            can Abort.Panic:
                return when type_name:
                    "py::Object" -> "object"
                    "py::Object?" -> "object | None"
                    "cstr" | "sview" -> "str | bytes"
                    "cstr?" | "sview?" -> "str | bytes | None"
                    "bool" -> "bool"
                    "f32" | "f64" -> "float"
                    "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "char" | "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" -> "int"
                    _ -> ""
