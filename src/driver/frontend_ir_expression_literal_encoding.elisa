# Stage0 frontend-IR v2 IDs and value wire types for scalar expression literals.
module FrontendIrExpressionLiteralEncoding:
    public:
        const enum ScalarLiteralKind of u8:
            IntLit
            FloatLit
            StringLit
            CharLit
            BoolLit

        const INT_LIT_NODE_TYPE_ID: u32 = 139
        const FLOAT_LIT_NODE_TYPE_ID: u32 = 67
        const STRING_LIT_NODE_TYPE_ID: u32 = 253
        const CHAR_LIT_NODE_TYPE_ID: u32 = 28
        const BOOL_LIT_NODE_TYPE_ID: u32 = 18

        const INT_LIT_VALUE_FIELD_ID: u32 = 4
        const FLOAT_LIT_VALUE_FIELD_ID: u32 = 3
        const STRING_LIT_VALUE_FIELD_ID: u32 = 2
        const CHAR_LIT_VALUE_FIELD_ID: u32 = 2
        const BOOL_LIT_VALUE_FIELD_ID: u32 = 2

        const STRING_VALUE_WIRE_TYPE_ID: u8 = 3
        const BOOL_VALUE_WIRE_TYPE_ID: u8 = 1

        def node_type_id(kind: ScalarLiteralKind) -> u32:
            ensure kind != ScalarLiteralKind.IntLit or result == INT_LIT_NODE_TYPE_ID
            ensure kind != ScalarLiteralKind.FloatLit or result == FLOAT_LIT_NODE_TYPE_ID
            ensure kind != ScalarLiteralKind.StringLit or result == STRING_LIT_NODE_TYPE_ID
            ensure kind != ScalarLiteralKind.CharLit or result == CHAR_LIT_NODE_TYPE_ID
            ensure kind != ScalarLiteralKind.BoolLit or result == BOOL_LIT_NODE_TYPE_ID
            return match kind:
                ScalarLiteralKind.IntLit: INT_LIT_NODE_TYPE_ID
                ScalarLiteralKind.FloatLit: FLOAT_LIT_NODE_TYPE_ID
                ScalarLiteralKind.StringLit: STRING_LIT_NODE_TYPE_ID
                ScalarLiteralKind.CharLit: CHAR_LIT_NODE_TYPE_ID
                ScalarLiteralKind.BoolLit: BOOL_LIT_NODE_TYPE_ID

        def value_field_id(kind: ScalarLiteralKind) -> u32:
            ensure kind != ScalarLiteralKind.IntLit or result == INT_LIT_VALUE_FIELD_ID
            ensure kind != ScalarLiteralKind.FloatLit or result == FLOAT_LIT_VALUE_FIELD_ID
            ensure kind != ScalarLiteralKind.StringLit or result == STRING_LIT_VALUE_FIELD_ID
            ensure kind != ScalarLiteralKind.CharLit or result == CHAR_LIT_VALUE_FIELD_ID
            ensure kind != ScalarLiteralKind.BoolLit or result == BOOL_LIT_VALUE_FIELD_ID
            return match kind:
                ScalarLiteralKind.IntLit: INT_LIT_VALUE_FIELD_ID
                ScalarLiteralKind.FloatLit: FLOAT_LIT_VALUE_FIELD_ID
                ScalarLiteralKind.StringLit: STRING_LIT_VALUE_FIELD_ID
                ScalarLiteralKind.CharLit: CHAR_LIT_VALUE_FIELD_ID
                ScalarLiteralKind.BoolLit: BOOL_LIT_VALUE_FIELD_ID

        def value_wire_type_id(kind: ScalarLiteralKind) -> u8:
            ensure kind == ScalarLiteralKind.BoolLit or result == STRING_VALUE_WIRE_TYPE_ID
            ensure kind != ScalarLiteralKind.BoolLit or result == BOOL_VALUE_WIRE_TYPE_ID
            return match kind:
                ScalarLiteralKind.IntLit: STRING_VALUE_WIRE_TYPE_ID
                ScalarLiteralKind.FloatLit: STRING_VALUE_WIRE_TYPE_ID
                ScalarLiteralKind.StringLit: STRING_VALUE_WIRE_TYPE_ID
                ScalarLiteralKind.CharLit: STRING_VALUE_WIRE_TYPE_ID
                ScalarLiteralKind.BoolLit: BOOL_VALUE_WIRE_TYPE_ID
