def emit_pymodule_scalar_range_check(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, type_name: sview, parameter_index: usize) -> void can[Abort.Panic, Memory.Allocate]:
    lower: mutable sview = ""
