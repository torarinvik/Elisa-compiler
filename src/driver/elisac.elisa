    "f32?" return if type_name == "dict[bool,f32?]"
    "f64?" return if type_name == "dict[bool,f64?]"
    if sview_len(type_name) > 6.usize() and type_name[0:5] == "dict[" and sview_at(type_name, sview_len(type_name) - 1.usize()) == 93:
        depth: mutable usize = 0
        for index in 5.usize()..<(sview_len(type_name) - 1.usize()) |type_name, depth|:
            byte: u8 = sview_at(type_name, index)
            depth <- depth + 1.usize() if byte == 91
            depth <- depth - 1.usize() if byte == 93 and depth > 0.usize()
            return type_name[index + 1.usize():sview_len(type_name) - 1.usize()] if byte == 44 and depth == 0.usize()
    return ""


# Find the named record carried anywhere inside a Python-facing aggregate.  The C shim emits
# recursive dictionary/list/view conversion helpers before it emits the wrapper body, so the
# record typedef (and its field converters) must be discovered through every container layer,
# not only the first dictionary value.  Keep the input/return capability check at the leaf: a
# scalar dictionary value should not accidentally be treated as a named record.
def pymodule_named_struct_leaf_for_pymodule(file: Ast::File&, type_name: sview, for_input: bool, depth: usize = 0.usize()) -> sview can[Abort.Panic, Memory.Allocate]:
    return "" if depth > 32.usize()
    if for_input:
        return type_name if pymodule_struct_input_supported(file, type_name)
    else:
        return type_name if pymodule_struct_return_supported(file, type_name)
    if pymodule_is_dict_type(type_name):
        return pymodule_named_struct_leaf_for_pymodule(file, pymodule_dict_value_name(type_name), for_input, depth + 1.usize())
    if pymodule_is_darray_type(type_name):
        return pymodule_named_struct_leaf_for_pymodule(file, pymodule_darray_element_name(type_name), for_input, depth + 1.usize())
    if pymodule_is_view_type(type_name):
        return pymodule_named_struct_leaf_for_pymodule(file, pymodule_view_element_name(type_name), for_input, depth + 1.usize())
    return ""


def pymodule_dict_value_is_optional_scalar(value_name: sview) -> bool can[Abort.Panic]:
    return pymodule_is_optional_scalar_type(value_name) and value_name != "sview?"


def pymodule_target_path_matches(wanted: sview, owner: sview, leaf: sview) -> bool can[Abort.Panic]:
    # Unqualified rows retain the convenient "find this name anywhere" behavior. A qualified
    # row must match the complete module path, preventing two modules with the same member
    # name from silently exporting the first declaration encountered in source order.
    if owner == "":
        return wanted == leaf
    false return if sview_len(wanted) != sview_len(owner) + 2.usize() + sview_len(leaf)
    for index in 0..<sview_len(owner) |wanted, owner|:
        false return if sview_at(wanted, index) != sview_at(owner, index)
    false return if sview_at(wanted, sview_len(owner)) != 58 or sview_at(wanted, sview_len(owner) + 1.usize()) != 58
    for index in 0..<sview_len(leaf) |wanted, leaf, owner|:
        false return if sview_at(wanted, sview_len(owner) + 2.usize() + index) != sview_at(leaf, index)
    return true


def pymodule_target_is_qualified(target: sview) -> bool can[Abort.Panic]:
    for index in 0..<sview_len(target) |target|:
        return true if sview_at(target, index) == 58 and index + 1.usize() < sview_len(target) and sview_at(target, index + 1.usize()) == 58
    return false


def pymodule_target_leaf_matches(target: sview, leaf: sview) -> bool can[Abort.Panic]:
    return target == leaf if not pymodule_target_is_qualified(target)
    false return if sview_len(target) <= sview_len(leaf) + 2.usize()
    suffix_start: usize = sview_len(target) - sview_len(leaf)
    false return if sview_at(target, suffix_start - 2.usize()) != 58 or sview_at(target, suffix_start - 1.usize()) != 58
    for index in 0..<sview_len(leaf) |target, leaf, suffix_start|:
        false return if sview_at(target, suffix_start + index) != sview_at(leaf, index)
    return true


def pymodule_const_leaf_count(declarations: darray[Ast::Decl]&, target: sview) -> usize can[Abort.Panic, Memory.Allocate]:
    count: mutable usize = 0
    for declaration in declarations |count, target|:
        if declaration is Decl.Const(name, type_expression, value, is_mutable, line):
            count <- count + 1 if pymodule_target_leaf_matches(target, name)
        elif declaration is Decl.Module(module_name, module_body, module_line):
            count <- count + pymodule_const_leaf_count(module_body, target)
        elif declaration is Decl.Scoped(scoped_body, scoped_line):
            count <- count + pymodule_const_leaf_count(scoped_body, target)
    return count


def pymodule_find_function_in(declarations: darray[Ast::Decl]&, wanted: sview) -> Ast::Decl? can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations:
        if declaration is Decl.Func(name, params, return_type, body, effects, decorators, pos):
            return declaration if pymodule_target_path_matches(wanted, "", name)
        if declaration is Decl.Module(module_name, module_body, module_pos):
            found: Ast::Decl? = pymodule_find_function_in_owner(module_body, wanted, module_name)
            if found is nested:
                return nested
        if declaration is Decl.Scoped(scoped_body, scoped_pos):
            found: Ast::Decl? = pymodule_find_function_in_owner(scoped_body, wanted, "")
            if found is nested_scoped:
                return nested_scoped
    return null


def pymodule_find_function_in_owner(declarations: darray[Ast::Decl]&, wanted: sview, owner: sview) -> Ast::Decl? can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations:
        if declaration is Decl.Func(name, params, return_type, body, effects, decorators, pos):
            return declaration if pymodule_target_path_matches(wanted, owner, name)
        if declaration is Decl.Module(module_name, module_body, module_pos):
            found: Ast::Decl? = pymodule_find_function_in_owner(module_body, wanted, module_name)
            if found is nested:
                return nested
        if declaration is Decl.Scoped(scoped_body, scoped_pos):
            found: Ast::Decl? = pymodule_find_function_in_owner(scoped_body, wanted, owner)
            if found is nested_scoped:
                return nested_scoped
    return null


def pymodule_find_const_in(declarations: darray[Ast::Decl]&, wanted: sview) -> Ast::Decl? can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations:
        if declaration is Decl.Const(name, type_expression, value, is_mutable, pos):
            return declaration if pymodule_target_path_matches(wanted, "", name)
        if declaration is Decl.Module(module_name, module_body, module_pos):
            found: Ast::Decl? = pymodule_find_const_in_owner(module_body, wanted, module_name)
            if found is nested:
                return nested
        if declaration is Decl.Scoped(scoped_body, scoped_pos):
            found: Ast::Decl? = pymodule_find_const_in_owner(scoped_body, wanted, "")
            if found is nested_scoped:
                return nested_scoped
    return null


def pymodule_find_const_in_owner(declarations: darray[Ast::Decl]&, wanted: sview, owner: sview) -> Ast::Decl? can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations:
        if declaration is Decl.Const(name, type_expression, value, is_mutable, pos):
            return declaration if pymodule_target_path_matches(wanted, owner, name)
        if declaration is Decl.Module(module_name, module_body, module_pos):
            found: Ast::Decl? = pymodule_find_const_in_owner(module_body, wanted, module_name)
            if found is nested:
                return nested
        if declaration is Decl.Scoped(scoped_body, scoped_pos):
            found: Ast::Decl? = pymodule_find_const_in_owner(scoped_body, wanted, owner)
            if found is nested_scoped:
                return nested_scoped
    return null


def pymodule_find_struct_in(declarations: darray[Ast::Decl]&, wanted: sview) -> Ast::Decl? can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations:
        if declaration is Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, pos):
            return declaration if name == wanted
        if declaration is Decl.Module(module_name, module_body, module_pos):
            found: Ast::Decl? = pymodule_find_struct_in(module_body, wanted)
            if found is nested:
                return nested
        if declaration is Decl.Scoped(scoped_body, scoped_pos):
            found_scoped: Ast::Decl? = pymodule_find_struct_in(scoped_body, wanted)
            if found_scoped is nested_scoped:
                return nested_scoped
    return null


def pymodule_struct_member_type_name(file: Ast::File&, struct_type_name: sview, field_name: sview) -> sview can[Abort.Panic, Memory.Allocate]:
    declaration: Ast::Decl? = pymodule_find_struct_in(file.top_decls, struct_type_name)
    if declaration is target:
        if target is Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, pos):
            for member in members |file, field_name|:
                return pymodule_alias_type_name(file, member.type_expression) if member.name == field_name
    return ""


def pymodule_struct_scalar_field_type(type_name: sview) -> bool can[Abort.Panic]:
    return type_name == "i8" or type_name == "i16" or type_name == "i32" or type_name == "i64" or type_name == "int" or type_name == "isize" or type_name == "char" or type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or type_name == "usize" or type_name == "uintptr" or type_name == "f32" or type_name == "f64" or type_name == "bool" or type_name == "cstr" or type_name == "sview" or type_name == "py::Object" or type_name == "cstr?" or type_name == "py::Object?" or type_name == "i8?" or type_name == "i16?" or type_name == "i32?" or type_name == "i64?" or type_name == "int?" or type_name == "isize?" or type_name == "char?" or type_name == "u8?" or type_name == "u16?" or type_name == "u32?" or type_name == "u64?" or type_name == "usize?" or type_name == "uintptr?" or type_name == "bool?" or type_name == "f32?" or type_name == "f64?" or type_name == "sview?"


def pymodule_struct_cycle_walk(file: Ast::File&, type_name: sview, active: mutable darray[sview]&, depth: usize) -> bool can[Abort.Panic, Memory.Allocate]:
    # Track the active type path, rather than only bounding recursion depth.  A depth-only walk
    # is finite for a linear cycle but still expands a branching cycle exponentially (for example
    # `Node { left: Node, right: Node }`) before reaching its cap, which was enough to exhaust the
    # host during `-emit pymodule`.  The path is pushed only for the duration of this branch, so
    # repeated types on sibling branches remain valid while true recursive value layouts reject
    # immediately.
    return false if depth > 64.usize()
    probe: mutable usize = 0
    while probe < active.count:
        return true if active[probe] == type_name
        probe <- probe + 1
    active.push(type_name)
    if pymodule_is_darray_type(type_name) or pymodule_is_view_type(type_name) or pymodule_is_set_type(type_name):
        element_name: sview = pymodule_darray_element_name(type_name) if pymodule_is_darray_type(type_name) else pymodule_view_element_name(type_name) if pymodule_is_view_type(type_name) else pymodule_set_element_name(type_name)
        result: bool = pymodule_struct_cycle_walk(file, element_name, active, depth + 1.usize())
        _ = active.pop()
        return result
    if pymodule_is_dict_type(type_name):
        result: bool = pymodule_struct_cycle_walk(file, pymodule_dict_value_name(type_name), active, depth + 1.usize())
        _ = active.pop()
        return result
    declaration: Ast::Decl? = pymodule_find_struct_in(file.top_decls, type_name)
    if declaration is target:
        if target is Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, pos):
            for member in members:
                member_cycle: bool = pymodule_struct_cycle_walk(file, pymodule_alias_type_name(file, member.type_expression), active, depth + 1.usize())
                if member_cycle:
                    _ = active.pop()
                    return true
    _ = active.pop()
    return false


def pymodule_struct_cycle_in_type(file: Ast::File&, type_name: sview, depth: usize) -> bool can[Abort.Panic, Memory.Allocate]:
    active: mutable darray[sview] = []
    return pymodule_struct_cycle_walk(file, type_name, active, depth)


def pymodule_struct_supported_depth(file: Ast::File&, type_name: sview, depth: usize) -> bool can[Abort.Panic, Memory.Allocate]:
    # A recursive value struct has no finite by-value layout. Keep the diagnostic deterministic
    # and bounded even when mutually recursive declarations are present in an otherwise valid
    # source file.
    return false if depth > 32.usize()
    return false if pymodule_struct_cycle_in_type(file, type_name, 0.usize())
    declaration: Ast::Decl? = pymodule_find_struct_in(file.top_decls, type_name)
    if declaration is target:
        if target is Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, pos):
            return false if members.count == 0
            for member in members:
                return false if member.is_ghost
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                if member.has_default:
                    return false if field_type_name == "" or field_type_name == "py::Object" or not pymodule_struct_default_supported(file, field_type_name, member.default_value)
                continue if pymodule_struct_scalar_field_type(field_type_name)
                return false if not pymodule_struct_supported_depth(file, field_type_name, depth + 1.usize())
            return true
    return false


def pymodule_struct_field_supported(file: Ast::File&, field: Ast::StructMember) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if field.is_ghost
    field_type_name: sview = pymodule_alias_type_name(file, field.type_expression)
    if field.has_default:
        return false if field_type_name == "" or field_type_name == "py::Object" or not pymodule_struct_default_supported(file, field_type_name, field.default_value)
    return true if pymodule_struct_scalar_field_type(field_type_name)
    return pymodule_struct_supported_depth(file, field_type_name, 1.usize())


def pymodule_struct_supported(file: Ast::File&, type_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    return pymodule_struct_supported_depth(file, type_name, 0.usize())


# Struct outputs may carry a small, explicitly owned aggregate: numeric/bool darrays.  The
# native backend already threads the caller arena for a returned struct containing a darray; the
# Python shim copies those fields before releasing that arena. Keep this predicate separate from
# `pymodule_struct_supported`, whose scalar-only meaning is used by the input/default path.
def pymodule_struct_return_supported_depth(file: Ast::File&, type_name: sview, depth: usize) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if depth > 32.usize()
    return false if pymodule_struct_cycle_in_type(file, type_name, 0.usize())
    declaration: Ast::Decl? = pymodule_find_struct_in(file.top_decls, type_name)
    if declaration is target:
        if target is Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, pos):
            return false if members.count == 0
            for member in members:
                return false if member.is_ghost
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                return false if member.has_default and not pymodule_struct_default_supported(file, field_type_name, member.default_value)
                continue if pymodule_struct_scalar_field_type(field_type_name)
                if pymodule_is_dict_type(field_type_name):
                    return false if not pymodule_nested_dict_values_supported_in_type(file, field_type_name, 0.usize())
                    continue
                if pymodule_is_set_type(field_type_name):
                    return false if not pymodule_set_element_supported(pymodule_set_element_name(field_type_name))
                    continue
                if pymodule_is_darray_type(field_type_name):
                    return false if not pymodule_struct_darray_return_element_supported(file, pymodule_darray_element_name(field_type_name))
                    continue
                if pymodule_is_view_type(field_type_name):
                    return false if not pymodule_view_return_supported(file, field_type_name, depth + 1.usize())
                    continue
                return false if not pymodule_struct_return_supported_depth(file, field_type_name, depth + 1.usize())
            return true
    return false


def pymodule_struct_return_supported(file: Ast::File&, type_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    return pymodule_struct_return_supported_depth(file, type_name, 0.usize())


def pymodule_struct_return_contains_darray_depth(file: Ast::File&, type_name: sview, depth: usize) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if depth > 32.usize()
    declaration: Ast::Decl? = pymodule_find_struct_in(file.top_decls, type_name)
    if declaration is target:
        if target is Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, pos):
            for member in members:
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                true return if pymodule_is_dict_type(field_type_name)
                true return if pymodule_is_set_type(field_type_name)
                true return if pymodule_is_darray_type(field_type_name)
                true return if pymodule_is_view_type(field_type_name)
                true return if pymodule_struct_return_contains_darray_depth(file, field_type_name, depth + 1.usize())
    return false


def pymodule_struct_return_contains_darray(file: Ast::File&, type_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    return pymodule_struct_return_contains_darray_depth(file, type_name, 0.usize())


# Input-only struct aggregates use the same borrowed, temporary-buffer convention as ordinary
# darray parameters. Text values are copied into the caller arena, while opaque Python objects
# are retained in a small per-call owner table until the native call returns.
def pymodule_struct_darray_element_supported(file: Ast::File&, element_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    if pymodule_is_dict_type(element_name):
        return pymodule_nested_dict_values_supported_in_type(file, element_name, 0.usize())
    # A darray may contain read-only views as elements.  Each view owns a temporary
    # element buffer for the duration of the native call, so validate the complete
    # view bridge instead of treating `view[T]` as an opaque named struct.
    if pymodule_is_view_type(element_name):
        return pymodule_view_input_supported(file, element_name)
    if pymodule_is_darray_type(element_name):
        nested_element_name: sview = pymodule_darray_element_name(element_name)
        # Struct fields use the same recursive ElisaDArray ABI as top-level parameters.  Walk
        # the element chain instead of stopping after one nested level, but retain the bridge's
        # explicit eight-level guard so generated helpers remain bounded and diagnostics stay
        # deterministic for pathological types.
        return false if pymodule_darray_nesting_depth(element_name) >= 8.usize()
        # The recursive list helper's innermost converter currently handles scalar/text/object
        # and named-struct leaves.  A set or dictionary nested below another list has a different
        # aggregate ABI; keep that shape diagnostic-only rather than accepting it and emitting a
        # scalar cast in the innermost loop.
        return false if pymodule_is_set_type(nested_element_name) or pymodule_is_dict_type(nested_element_name)
        return pymodule_struct_darray_element_supported(file, nested_element_name)
    return true if element_name == "i8" or element_name == "i16" or element_name == "i32" or element_name == "i64" or element_name == "int" or element_name == "isize" or element_name == "char" or element_name == "u8" or element_name == "u16" or element_name == "u32" or element_name == "u64" or element_name == "usize" or element_name == "uintptr" or element_name == "f32" or element_name == "f64" or element_name == "bool" or element_name == "cstr" or element_name == "cstr?" or element_name == "sview" or element_name == "sview?" or element_name == "py::Object" or element_name == "py::Object?" or pymodule_darray_element_is_optional_scalar(element_name) or (pymodule_is_set_type(element_name) and pymodule_set_element_supported(pymodule_set_element_name(element_name)))
    return pymodule_struct_input_supported(file, element_name)


def pymodule_struct_darray_return_element_supported(file: Ast::File&, element_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    if pymodule_is_view_type(element_name):
        return pymodule_view_return_supported(file, element_name)
    return true if pymodule_struct_darray_element_supported(file, element_name)
    return element_name == "py::Object" or element_name == "py::Object?"


# `ElisaView` is only a two-word pointer/length carrier.  The Python shim can materialize its
# elements directly when the element has a scalar/text/object C representation, or through the
# dedicated named-struct view helpers.  Treating every syntactically valid `view[T]` as supported
# used to let `view[dict[...]]` and `view[set[...]]` through validation; code generation then
# referenced helpers that were never emitted (or fell through to an empty C element type).
def pymodule_view_input_supported(file: Ast::File&, type_name: sview, depth: usize = 0.usize()) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if depth > 32.usize()
    return false if not pymodule_is_view_type(type_name)
    element_name: sview = pymodule_view_element_name(type_name)
    return true if pymodule_darray_c_element_type(element_name) != ""
    return pymodule_struct_input_supported_depth(file, element_name, depth + 1.usize())


def pymodule_view_return_supported(file: Ast::File&, type_name: sview, depth: usize = 0.usize()) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if depth > 32.usize()
    return false if not pymodule_is_view_type(type_name)
    element_name: sview = pymodule_view_element_name(type_name)
    return true if pymodule_darray_c_element_type(element_name) != ""
    return pymodule_struct_return_supported_depth(file, element_name, depth + 1.usize())


def pymodule_view_bridge_supported(file: Ast::File&, type_name: sview, depth: usize = 0.usize()) -> bool can[Abort.Panic, Memory.Allocate]:
    return pymodule_view_input_supported(file, type_name, depth) and pymodule_view_return_supported(file, type_name, depth)


# Top-level nested darrays use the same ElisaDArray ABI at every level, but need their own
# lifetime-bearing conversion helpers in the Python wrapper. Keep the depth walk centralized so
# aliases and direct spellings behave identically, and reject only shapes the recursive emitter
# cannot safely materialize.
def pymodule_darray_nesting_depth(type_name: sview) -> usize can[Abort.Panic, Memory.Allocate]:
    depth: mutable usize = 0
    current: mutable sview = type_name
    while pymodule_is_darray_type(current) and depth < 16.usize() |depth, current|:
        depth <- depth + 1.usize()
        current <- pymodule_darray_element_name(current)
    return depth


def pymodule_darray_leaf_name(type_name: sview) -> sview can[Abort.Panic, Memory.Allocate]:
    current: mutable sview = type_name
    depth: mutable usize = 0
    while pymodule_is_darray_type(current) and depth < 16.usize() |current, depth|:
        current <- pymodule_darray_element_name(current)
        depth <- depth + 1.usize()
    return current


def pymodule_top_level_nested_darray_input_supported(file: Ast::File&, type_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    depth: usize = pymodule_darray_nesting_depth(type_name)
    return false if depth < 2.usize() or depth > 8.usize()
    leaf_name: sview = pymodule_darray_leaf_name(type_name)
    return pymodule_struct_darray_element_supported(file, leaf_name)


def pymodule_top_level_nested_darray_return_supported(file: Ast::File&, type_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    depth: usize = pymodule_darray_nesting_depth(type_name)
    return false if depth < 2.usize() or depth > 8.usize()
    leaf_name: sview = pymodule_darray_leaf_name(type_name)
    return pymodule_struct_darray_return_element_supported(file, leaf_name)


# A top-level darray has two distinct converter families: one-level lists use the ordinary
# element matrix (including named-struct converters), while nested lists use the bounded
# recursive helpers above. Keep this dispatch in one predicate so the manifest, C ABI report,
# and wrapper generator cannot disagree about a shape that would otherwise produce an invalid
# element C type (for example darray[StructWithUnsupportedAggregate]).
def pymodule_top_level_darray_input_supported(file: Ast::File&, type_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if not pymodule_is_darray_type(type_name)
    depth: usize = pymodule_darray_nesting_depth(type_name)
    return pymodule_top_level_nested_darray_input_supported(file, type_name) if depth >= 2.usize()
    return false if depth != 1.usize()
    return pymodule_struct_darray_element_supported(file, pymodule_darray_element_name(type_name))


def pymodule_top_level_darray_return_supported(file: Ast::File&, type_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if not pymodule_is_darray_type(type_name)
    depth: usize = pymodule_darray_nesting_depth(type_name)
    return pymodule_top_level_nested_darray_return_supported(file, type_name) if depth >= 2.usize()
    return false if depth != 1.usize()
    element_name: sview = pymodule_darray_element_name(type_name)
    # The standalone darray return converter calls the full struct return helper for named
    # elements. The input-oriented predicate is intentionally not reused here: a struct may be
    # representable on output even when its input shape differs, and vice versa.
    return pymodule_struct_return_supported(file, element_name) if pymodule_find_struct_in(file.top_decls, element_name) != null
    return pymodule_struct_darray_return_element_supported(file, element_name)


def pymodule_expression_is_nested_darray(expression: Ast::Expr) -> bool can[Abort.Panic]:
    # Cleanup receives the original AST expression rather than an Ast::File, so recognize this
    # one container shape structurally instead of trying to normalize aliases a second time.
    if expression is Expr.Unary(expression_operator, expression_operand, expression_pos):
        return pymodule_expression_is_nested_darray(expression_operand) if expression_operator == Lexer::TokenKind.Mutable or expression_operator == Lexer::TokenKind.Lmut or expression_operator == Lexer::TokenKind.Ampersand else false
    if expression is Expr.Paren(expression_inner, expression_paren_pos):
        return pymodule_expression_is_nested_darray(expression_inner)
    if expression is Expr.Index(expression_head, expression_argument, expression_index_pos):
        if expression_head is Expr.Ident(expression_name, expression_name_pos) and expression_name == "darray":
            if expression_argument is Expr.Index(nested_head, nested_argument, nested_index_pos):
                return pymodule_type_atom_name(nested_head) == "darray" or pymodule_type_atom_name(nested_head) == "set" or pymodule_type_atom_name(nested_head) == "view"
            if expression_argument is Expr.IndexN(nested_head_n, nested_arguments, nested_index_pos_n):
                return (pymodule_type_atom_name(nested_head_n) == "darray" or pymodule_type_atom_name(nested_head_n) == "set" or pymodule_type_atom_name(nested_head_n) == "view") and nested_arguments.count == 1
    if expression is Expr.IndexN(expression_head_n, expression_arguments, expression_index_pos_n):
        if expression_head_n is Expr.Ident(expression_name_n, expression_name_pos_n) and expression_name_n == "darray" and expression_arguments.count == 1:
            nested_argument_n: Ast::Expr = expression_arguments[0]
            if nested_argument_n is Expr.Index(nested_head_n_i, nested_argument_n_i, nested_index_pos_n_i):
                return pymodule_type_atom_name(nested_head_n_i) == "darray" or pymodule_type_atom_name(nested_head_n_i) == "set" or pymodule_type_atom_name(nested_head_n_i) == "view"
            if nested_argument_n is Expr.IndexN(nested_head_n_in, nested_arguments_in, nested_index_pos_n_in):
                return (pymodule_type_atom_name(nested_head_n_in) == "darray" or pymodule_type_atom_name(nested_head_n_in) == "set" or pymodule_type_atom_name(nested_head_n_in) == "view") and nested_arguments_in.count == 1
    return false


def emit_pymodule_struct_nested_darray_input(buffer: mutable darray[u8]&, file: Ast::File&, field_name: sview, element_name: sview) -> void can[Abort.Panic, Memory.Allocate]:
    element_c_type: mutable sview = pymodule_darray_c_element_type(element_name)
    element_c_type <- element_name if element_c_type == "" and pymodule_struct_input_supported(file, element_name)
    emit_tokens_push_sview(buffer, "PyObject *field_seq = PySequence_Fast(field_obj, \"expected a sequence for struct nested list field\"); if (field_seq == NULL) { Py_DECREF(field_obj); return -1; } Py_ssize_t field_count = PySequence_Fast_GET_SIZE(field_seq); if (field_count > PY_SSIZE_T_MAX / (Py_ssize_t)sizeof(ElisaDArray)) { Py_DECREF(field_seq); Py_DECREF(field_obj); PyErr_SetString(PyExc_OverflowError, \"struct nested list is too large\"); return -1; } out->")
    emit_tokens_push_sview(buffer, field_name)
    emit_tokens_push_sview(buffer, " = (ElisaDArray){NULL, (int64_t)field_count, (int64_t)field_count}; if (field_count > 0) { out->")
    emit_tokens_push_sview(buffer, field_name)
    emit_tokens_push_sview(buffer, ".items = arena_alloc(arena, (int64_t)((size_t)field_count * sizeof(ElisaDArray))); if (out->")
    emit_tokens_push_sview(buffer, field_name)
    emit_tokens_push_sview(buffer, ".items == NULL) { Py_DECREF(field_seq); Py_DECREF(field_obj); PyErr_NoMemory(); return -1; } } for (Py_ssize_t field_index = 0; field_index < field_count; ++field_index) { Py_ssize_t field_path_mark = elisa_pymodule_current_path_length; if (elisa_pymodule_current_path_push_index(field_index) < 0) { Py_DECREF(field_seq); Py_DECREF(field_obj); return -1; } PyObject *nested_seq = PySequence_Fast(PySequence_Fast_GET_ITEM(field_seq, field_index), \"expected a sequence for each struct nested list item\"); if (nested_seq == NULL) { Py_DECREF(field_seq); Py_DECREF(field_obj); return -1; } Py_ssize_t nested_count = PySequence_Fast_GET_SIZE(nested_seq); if (nested_count > PY_SSIZE_T_MAX / (Py_ssize_t)sizeof(")
    emit_tokens_push_sview(buffer, element_c_type)
    emit_tokens_push_sview(buffer, ")) { Py_DECREF(nested_seq); Py_DECREF(field_seq); Py_DECREF(field_obj); PyErr_SetString(PyExc_OverflowError, \"struct nested list is too large\"); return -1; } ElisaDArray *nested_array = &((ElisaDArray *)out->")
    emit_tokens_push_sview(buffer, field_name)
    emit_tokens_push_sview(buffer, ".items)[field_index]; *nested_array = (ElisaDArray){NULL, (int64_t)nested_count, (int64_t)nested_count}; if (nested_count > 0) { nested_array->items = arena_alloc(arena, (int64_t)((size_t)nested_count * sizeof(")
    emit_tokens_push_sview(buffer, element_c_type)
    emit_tokens_push_sview(buffer, "))); if (nested_array->items == NULL) { Py_DECREF(nested_seq); Py_DECREF(field_seq); Py_DECREF(field_obj); PyErr_NoMemory(); return -1; } } for (Py_ssize_t nested_index = 0; nested_index < nested_count; ++nested_index) { Py_ssize_t nested_path_mark = elisa_pymodule_current_path_length; if (elisa_pymodule_current_path_push_index(nested_index) < 0) { Py_DECREF(nested_seq); Py_DECREF(field_seq); Py_DECREF(field_obj); return -1; } PyObject *nested_item = PySequence_Fast_GET_ITEM(nested_seq, nested_index); ")
    if pymodule_struct_input_supported(file, element_name):
        emit_tokens_push_sview(buffer, "if (elisa_pymodule_struct_")
        emit_tokens_push_sview(buffer, element_name)
        emit_tokens_push_sview(buffer, "_from_py(nested_item, &((")
        emit_tokens_push_sview(buffer, element_c_type)
