# Stage1 product compiler: real frontend (lexer/parser) + Backend::emit → native object.
#
# Wire protocol on stdin (kept simple for self-host / non-libc argv):
#   line 1: absolute or relative output object path
#   rest:   Elisa source (includes already expanded, or a single-file program)
#
# Host wrappers (scripts/elisac_stage1.sh) accept `elisac-stage1 -o out.o file.elisa`,
# expand includes, and feed this driver.
include "../backend/codegen.elisa"
include "./emit_fmt_expr.elisa"
# `project view` / `project deps`: reading project.json, resolving the dependency graph and
# printing the two reports. See src/driver/project.elisa.
include "./project.elisa"
include "./abi_lint.elisa"
include "./emit_wasm.elisa"
# `-emit ir`: writing stage0's `.elisair` frontend-IR bundle. See src/driver/frontend_ir_write.elisa.
include "./frontend_ir_write.elisa"
# The SEMANTIC layer is part of the product, not just of the tooling. Without it the driver
# went parse -> emit and stage1 silently ACCEPTED programs stage0 rejects (`x: mutable u8 = 0;
# x <- 300` emitted an object under stage1 and exited 1 under stage0). The bootstrap fixpoint
# cannot see that: every generation skips the check consistently, so gen3 == gen4 holds while
# the compiler analyses nothing.
include "../semantic/semantic.elisa"

include "./elisac_diagnostics.elisa"
include "./elisac_source_probes.elisa"
include "./elisac_emit_tokens.elisa"
include "./elisac_pymodule_report.elisa"
include "./elisac_emit_ast.elisa"
include "./elisac_emit_ast_decl.elisa"
include "./elisac_emit_iface.elisa"
include "./elisac_emit_iface_decl.elisa"
include "./elisac_emit_c_bind.elisa"
include "./elisac_emit_unsafe.elisa"
include "./elisac_emit_unsafe_report.elisa"
include "./elisac_emit_c_archive.elisa"
include "./elisac_emit_progress.elisa"
include "./elisac_emit_interpret.elisa"
include "./elisac_emit_test_runner.elisa"
include "./elisac_emit_annotated.elisa"
include "./elisac_emit_test_run.elisa"
include "./elisac_emit_header.elisa"
include "./elisac_pymodule_type_names.elisa"
include "./elisac_pymodule_container_types.elisa"
include "./elisac_pymodule_dict_type.elisa"
include "./elisac_pymodule_dict_key_names.elisa"
include "./elisac_pymodule_dict_value_names.elisa"
include "./elisac_pymodule_lookup.elisa"
include "./elisac_pymodule_support.elisa"
include "./elisac_pymodule_nested_helpers.elisa"
include "./elisac_pymodule_view_helpers.elisa"
include "./elisac_pymodule_composed_helpers.elisa"
include "./elisac_pymodule_struct_fields.elisa"
include "./elisac_pymodule_struct_py_to_c.elisa"
include "./elisac_pymodule_struct_c_to_py.elisa"
include "./elisac_pymodule_struct_typedef.elisa"
include "./elisac_pymodule_defaults.elisa"
include "./elisac_pymodule_default_policy.elisa"
include "./elisac_pymodule_default_builder.elisa"
include "./elisac_pymodule_error_payload.elisa"
include "./elisac_pymodule_error_helpers.elisa"
include "./elisac_pymodule_error_convert.elisa"
include "./elisac_pymodule_error_convert_2.elisa"
include "./elisac_pymodule_export_names.elisa"
include "./elisac_pymodule_cleanup.elisa"
include "./elisac_pymodule_dict_checks.elisa"
include "./elisac_pymodule_dict_items.elisa"
include "./elisac_pymodule_dict_input.elisa"
include "./elisac_pymodule_set_input.elisa"
include "./elisac_pymodule_dict_return.elisa"
include "./elisac_pymodule_container_return.elisa"
include "./elisac_pymodule_optional.elisa"
include "./elisac_pymodule_c_report.elisa"
include "./emit_pymodule_so.elisa"
include "./emit_pymodule_so_link.elisa"
include "./emit_pymodule_so_finish.elisa"
include "./elisac_emit_doc.elisa"
include "./elisac_includes.elisa"
include "./elisac_init.elisa"
include "./elisac_link.elisa"
include "./elisac_cli.elisa"
include "./elisac_project_commands.elisa"

# Stage1 meta-compile: prefer `u8&`/`i64` over `void&`/`isize` for the read extern so the
# product driver itself lowers under stage1 (gen2). Link still resolves libc `read`.
extern read(fd: i64, buf: u8&, count: usize) -> i64


# Real-CLI support. `main(argc, argv)` is portable and stage0 has always supported it —
# the "non-libc argv" note above was wrong about the obstacle. What actually blocked it
# was that indexing a `T&&` (C's `char**`) DECLINED in stage1's backend until it was
# implemented; there is no platform hook needed (`_NSGetArgv` works but is macOS-only).
#
# Flags are re-exported through setenv so the existing ELISA_STAGE1_* readers below need
# no change: the CLI and the environment stay ONE code path, and the wrapper's env-var
# invocations keep working exactly as before.
# `open` is VARIADIC — `open(const char *, int, ...)`. Declaring the mode as a FIXED third
# parameter passes it in a register, while the arm64 varargs ABI requires it on the stack,
# so libc read garbage and created files with mode `----------` (created, then unreadable).
extern open(path: cstr, flags: i64, ...) -> i64


extern close(fd: i64) -> i64


extern setenv(name: cstr, value: cstr, overwrite: i64) -> i64


extern mkdir(path: cstr, mode: u16) -> i64


# `#line` directives carry an ABSOLUTE path, so a relative -o/source argument is joined
# onto the working directory (stage0 uses filepath.Abs).
extern getcwd(buffer: void&, size: usize) -> void&


extern system(command: cstr) -> i64


# Used only to make the per-invocation work directory unique. Two `-emit test` runs share
# one fixed path otherwise, and the parity gate runs its checks in PARALLEL — one run's
# runner binary and captured streams would overwrite another's mid-suite.
@link_name("getpid")
extern elisa_stage1_getpid() -> i64


extern unlink(path: cstr) -> i64




def main(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    # TWO front doors, ONE compile path. With arguments this is an ordinary CLI; with none
    # it is the original stdin wire protocol, which the host wrapper and the bootstrap both
    # still use. cli_request builds exactly the buffer read_all would have produced, so
    # nothing downstream can tell the difference.
    # `init` is a SUBCOMMAND, not a compile: it consumes the rest of argv itself.
    if argc > 1:
        first_argument: mutable cstr&& = argv.cast[mutable cstr&&]
        run_init(argc, argv) return if first_argument[1].cast[cstr] == "init"
        run_init_lib(argc, argv) return if first_argument[1].cast[cstr] == "init-lib"
        run_project(argc, argv) return if first_argument[1].cast[cstr] == "project"
        # `build|run|test|bench` are stage0 subcommands stage1 does not implement yet. They
        # used to fall through to the compile path, where the subcommand name was taken as a
        # SOURCE PATH — so `elisac-stage1 build` exited 1 having printed nothing at all,
        # which reads exactly like a crash. Name the gap instead. (Same class of defect as
        # the mute backend decline; a compiler that fails must say what it declined.)
        run_unimplemented_subcommand(first_argument[1].cast[cstr]) return if subcommand_is_unimplemented(first_argument[1].cast[cstr])
    # `build|run|test|bench` resolve a project target and then compile its entry. They build
    # the SAME request buffer the flag CLI does, so everything downstream is untouched.
    # The cast is hoisted for READABILITY now, not necessity. Writing the chain inline
    # (`subcommand_compiles_project((argv.cast[mutable cstr&&])[1.usize()].cast[cstr])`)
    # used to make the backend decline this whole unit, so the compiler could not build
    # itself; indexing directly into a cast is lowered since then and pinned by
    # index_into_cast_read/_write in backend_native_smoke.
    project_compile: mutable bool = false
    if argc > 1:
        argv_slots: mutable cstr&& = argv.cast[mutable cstr&&]
        project_compile <- subcommand_compiles_project(argv_slots[1.usize()].cast[cstr])
    project_status: mutable i64 = 0
    raw: mutable darray[u8] = []
    if project_compile:
        raw <- project_compile_request(argc, argv, &project_status)
    elif argc > 1:
        raw <- cli_request(argc, argv)
    else:
        raw <- read_all()
    project_status return if project_compile and project_status != 0
    # `-emit deps`/`deps-json` answer from the include graph alone — no parse, no analysis.
    # Placed after cli_request so the CLI has recorded the source path it walks from.
    emit_deps_report(false) return if emit_mode_is("deps")
    emit_deps_report(true) return if emit_mode_is("deps-json")
    1 return if raw.count <= 1

    out_path: mutable darray[u8] = []
    i: mutable usize = 0
    while i < raw.count - 1 |i, out_path|:
        b: u8 = raw[i]
        break if b == 10
        out_path.push(b)
        i <- i + 1
    1 return if out_path.count == 0
    # Match stage0's output contract: object, bitcode, IR, and native executable writes
    # create the parent directory before handing the path to LLVM or the linker. Project
    # builds commonly name a fresh `build/bin/app`, and relying on the caller to pre-create
    # that directory turns a valid target into a silent object-write failure.
    output_directory: darray[u8] = path_directory(out_path)
    make_directory(output_directory) if output_directory.count > 0.usize()
    path_len: i64 = out_path.count.i64()
    out_path.push(0)
    i <- i + 1 if i < raw.count - 1 and raw[i] == 10
    source_start: usize = i
    source_len: usize = raw.count - 1 - source_start
    1 return if source_len == 0

    src_ptr: u8& = &raw[source_start]
    tokens: darray[Lexer::Token] = frontend_tokenize_expanded_unit(src_ptr, src_ptr, source_len)
    # `-emit tokens` is the LEXER oracle: report and stop before parsing, as stage0 does.
    if emit_mode_is("tokens"):
        return emit_tokens_report(tokens)
    # The unparser needs stage0's grouping nodes; the compile path must not see them.
    # Safe because `-emit fmt` returns below, before the semantic gate and codegen.
    parser_set_preserve_parens(emit_mode_is("fmt") or emit_mode_is("lowered"))
    file: mutable Ast::File = frontend_parser_parse_file(src_ptr, tokens)
    if file.errors.count != 0:
        for parse_error_index in 0..<file.errors.count |file|:
            report_parse_error(file.errors[parse_error_index])
        return 1
    # Wildcard pymodule rows must be expanded before ordinary object codegen as well as the
    # manifest/C emitters: the backend emits the stable native wrapper symbols from this table.
    pymodule_expand_wildcard_exports(file)

    # ANALYSE FIRST for the modes stage0 analyses first (see emit_mode_analyses_first).
    # Placed here, after parse errors and before every report dispatch, so one call
    # covers all of them and the compile path below is untouched.
    if emit_mode_analyses_first():
        1 return if run_semantic_gate(file, src_ptr, source_len) > 0

    # `-emit ast` prints the parse-tree summary and stops, as stage0 does.
    if emit_mode_is("ast"):
        return emit_ast_report(file, tokens, src_ptr)
    if emit_mode_is("iface"):
        return emit_iface_report(file, tokens, src_ptr)
    # `-emit doc` renders the AST as markdown and stops, as stage0 does. Placed beside the
    # other report modes: they all return BEFORE `static generate` expansion, so the page
    # describes what was WRITTEN rather than what was generated.
    if emit_mode_is("doc"):
        return emit_doc_report(file, tokens, src_ptr)
    # `-emit header` runs the backend's struct registration, so it sits with the other
    # report modes but needs no codegen.
    if emit_mode_is("header"):
        return emit_header_report(file)
    if emit_mode_is("pymodule"):
        return emit_pymodule_report(file)
    if emit_mode_is("pymodule-c"):
        return emit_pymodule_c_report(file)
    # `-emit pymodule-pyi` renders the type-checker stub from the compiler-owned manifest.
    # The renderer stays in Python: it is a pure projection of the JSON this driver just
    # wrote, and porting it buys nothing the manifest does not already guarantee.
    if emit_mode_is("pymodule-pyi"):
        return emit_pymodule_pyi_report(file)
    # `-emit pymodule-so` needs three artifacts: the manifest, the C shim, and the object.
    # The first two are emitted HERE, beside the other report modes, because this is where a
    # `mutable Ast::File&` argument is still region-inferable; the compile then continues to
    # the object and the link pipeline runs after it, reading both back from the work
    # directory. They travel through the filesystem rather than through main's locals
    # because that is what the toolchain step consumes anyway.
    if emit_mode_is("pymodule-so"):
        prepare_status: i64 = emit_pymodule_so_prepare(file)
        prepare_status return if prepare_status != 0
    # `-emit test-runner` echoes the unit and appends a synthesized `ctx_test_main`.
    if emit_mode_is("test-runner"):
        return emit_test_runner_report(file, src_ptr, source_len)
    # `-emit tests` / `benches` / `fixtures` list the matching annotated functions.
    if emit_mode_is("tests"):
        return emit_annotated_report(file, "test", tokens, src_ptr)
    if emit_mode_is("benches"):
        return emit_annotated_report(file, "bench", tokens, src_ptr)
    if emit_mode_is("fixtures"):
        return emit_annotated_report(file, "fixture", tokens, src_ptr)
    # `-emit test` compiles the unit once and runs each selected test in its own process.
    if emit_mode_is("test"):
        return emit_test_run(file)
    # `-emit c-bind-check` compares each `@c_bind` struct's layout against the real C one.
    if emit_mode_is("c-bind-check"):
        return emit_c_bind_report(file, tokens, src_ptr, false)
    if emit_mode_is("c-bind-check-json"):
        return emit_c_bind_report(file, tokens, src_ptr, true)
    # `-emit c-archive` bundles the object, the runtime, and the audit sidecars.
    if emit_mode_is("c-archive"):
        return emit_c_archive(file, tokens, src_ptr, out_path)
    # `-emit interpret` runs the program and reports `main`'s result.
    if emit_mode_is("interpret"):
        return emit_interpret(file, out_path)
    # `-emit ir` writes the `.elisair` frontend-IR bundle. A construct stage1's AST cannot
    # map onto exactly one stage0 node REFUSES by name rather than guessing: a bundle that
    # decodes cleanly but describes a different program is this format's easiest failure.
    if emit_mode_is("ir"):
        ir_refusal: mutable darray[u8] = []
        ir_image: darray[u8] = IrWrite::ir_write_bundle(file, "", sview(src_ptr, 0, source_len.i64()), &ir_refusal)
        if ir_refusal.count != 0:
            report_ir_refusal(ir_refusal)
            return 1
        return emit_tokens_flush(ir_image)
    # `-emit progress` reports each function's loop obligations and their evidence.
    if emit_mode_is("progress"):
        return emit_progress_report(file)
    # `-emit unsafe` reports the per-function Unsafe.* capability closure.
    if emit_mode_is("unsafe"):
        return emit_unsafe_report(file, tokens, src_ptr)
    # `-emit packed` describes the packed lowering profile and each packed enum's row layout.
    if emit_mode_is("packed"):
        packed_ctx: LLVMContextRef = LLVMContextCreate()
        packed_module: LLVMModuleRef = LLVMModuleCreateWithNameInContext("elisac_stage1_packed", packed_ctx)
        packed_triple_storage: mutable darray[u8] = []
        packed_machine: LLVMTargetMachineRef = Backend::configure_module_target_for(packed_module, requested_target_triple(&packed_triple_storage))
        packed_target_data: LLVMTargetDataRef = LLVMCreateTargetDataLayout(packed_machine)
        packed_report: darray[u8] = Backend::generate_packed_report(file, packed_module, packed_ctx, packed_target_data)
        packed_body: mutable darray[u8] = []
        for packed_index in 0..<packed_report.count |packed_body, packed_report|:
            packed_body.push(packed_report[packed_index]) if packed_report[packed_index] != 0
        return emit_tokens_flush(packed_body)
    # `-emit fmt` runs the unparser; every unported shape prints a loud <fmt-*-todo>
    # marker, so partial coverage can never read as byte parity in the smoke.
    # `-emit lowered` is stage0's fmt of the ANALYSED AST. stage1's semantic layer does not
    # desugar the tree in place (stage0's does: UFCS, overload mangling, address-of), so this
    # emits the UNLOWERED rendering — which is EXACTLY right for the 41 of 56 corpus fixtures
    # where stage0's own fmt and lowered outputs are identical, i.e. where no lowering
    # applies. The gate ratchets that count rather than claiming parity it does not have.
    if emit_mode_is("fmt") or emit_mode_is("lowered"):
        fmt_buffer: mutable darray[u8] = []
        FmtUnparse::fmt_file(fmt_buffer, file, tokens, src_ptr)
        return 0 if fmt_buffer.count == 0 else emit_tokens_flush(fmt_buffer)

    # `static generate` expansion. The pass has existed since task #35 but was wired ONLY into
    # test/breadth/parse_report.elisa — never into this driver — so every `static generate:`
    # block was silently skipped and its generated names came back as "undefined identifier".
    #
    # Placed AFTER the `-emit fmt` return on purpose: the unparser must see the ORIGINAL source
    # (it round-trips what was written, not what was generated), and `-emit tokens`/`ast`/`iface`
    # have already returned above for the same reason.
    #
    # Recognized blocks are spliced into an expanded source and re-parsed ONCE, so generated
    # declarations flow through the semantic gate and codegen exactly like hand-written ones.
    # `expanded` is declared here so the generated declarations' source spans outlive the parse;
    # unrecognized blocks copy through and the pass answers false, leaving everything untouched.
    expanded: mutable darray[u8] = []
    expanded_tokens: mutable darray[Lexer::Token] = []
    expanded_src_ptr: mutable u8& = src_ptr
    if frontend_preprocess_static_generate(src_ptr, source_len, tokens, file, expanded):
        expanded_src_ptr <- &expanded[0]
        expanded_tokens <- frontend_tokenize_expanded_unit(expanded_src_ptr, expanded_src_ptr, expanded.count)
        file <- frontend_parser_parse_file(expanded_src_ptr, expanded_tokens)
        if file.errors.count != 0:
            for parse_error_index in 0..<file.errors.count |file|:
                report_parse_error(file.errors[parse_error_index])
            return 1

    # ELISA_DEBUG_NODE_COUNT: report how many store rows (AST nodes, dominated by
    # this parse) exist right now, for node-density measurement (u16-handle budget
    # arithmetic, SoA dial planning). Runs before semantic/codegen create stores of
    # their own, so the count is ~pure parser output.
    node_count_flag_storage: mutable darray[u8] = []
    for node_flag_index in 0..<sview_len("ELISA_DEBUG_NODE_COUNT") |node_count_flag_storage|:
        node_count_flag_storage.push(sview_at("ELISA_DEBUG_NODE_COUNT", node_flag_index))
    node_count_flag_storage.push(0)
    node_count_flag: cstr = (&node_count_flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(node_count_flag) is node_count_requested:
        node_count_buffer: mutable darray[u8] = []
        for node_label_index in 0..<sview_len("node-count: ") |node_count_buffer|:
            node_count_buffer.push(sview_at("node-count: ", node_label_index))
        append_decimal(node_count_buffer, ctx_store_rows_observed().u32())
        node_count_buffer.push(10)
        write_stderr(node_count_buffer)

    # Analyse before emitting, as stage0 does: exit 1 on any ERROR-severity finding
    # (severity 1); warnings (2) do not block. Status codes only — see the note on
    # `puts` below — so this reproduces the accept/reject DECISION, not the message.
    #
    # OPT-IN while stage1's semantic layer still OVER-reports relative to stage0 on the
    # compiler's own source (642 findings where stage0 makes none; 437 are severity-2
    # warnings, and the rest are being worked through cluster by cluster). With the gate
    # ON, 40 of the 44 diagnostics fixtures stage1 wrongly ACCEPTED are now correctly
    # rejected (292 cases: 222 -> 258 agreeing with stage0).
    1 return if run_semantic_gate(file, src_ptr, source_len) > 0

    ctx: LLVMContextRef = LLVMContextCreate()
    module_handle: LLVMModuleRef = LLVMModuleCreateWithNameInContext("elisac_stage1", ctx)
    stamp_module_source_path(module_handle)
    triple_storage: mutable darray[u8] = []
    machine: LLVMTargetMachineRef = Backend::configure_module_target_for(module_handle, requested_target_triple(&triple_storage))
    target_data: LLVMTargetDataRef = LLVMCreateTargetDataLayout(machine)
    builder: LLVMBuilderRef = LLVMCreateBuilderInContext(ctx)
    source_name_storage: mutable darray[u8] = []
    source_name: mutable sview = sview("", 0, 0)
    if env_value("ELISA_STAGE1_SRC", &source_name_storage):
        source_name <- sview(&source_name_storage[0], 0, source_name_storage.count.i64())
    emitted_count: i64 = Backend::emit_module_with_debug_trace(file, module_handle, ctx, builder, target_data, debug_info_enabled(), trace_info_enabled(), source_name)
    # A unit with no function at all emits nothing BY CONSTRUCTION — see
    # unit_declares_function. Only a unit that HAS one and emitted none has failed.
    #
    # SAY SO. This used to be a bare `2 return if …`: exit 2, empty stdout, empty stderr. One
    # unsupported construct anywhere in the unit silently killed every function in it, and the
    # only way to attribute the failure was to bisect the source by truncation until the
    # offending definition fell out — which is exactly what a `pile <- pile.resize(n)` in the
    # project system cost. The backend already recorded every declined name in the module's
    # own `!elisa.declined` metadata; nothing ever read it.
    #
    # Via write_stderr, not puts: libc `puts` collides with elisacore_std's overload under
    # stage1 meta-compile and the stage0 seed, which is why this path was mute in the first
    # place. write(2, …) has no such conflict — the CLI's diagnostics already go out that way.
    if emitted_count <= 0 and unit_declares_function(file.top_decls):
        decline_report: mutable darray[u8] = []
        declined_total: i64 = Backend::declined_function_report(module_handle, &decline_report)
        message: mutable darray[u8] = []
        emit_tokens_push_sview(message, "error: backend could not produce a linkable unit" if emitted_count < 0 else "error: backend emitted no functions for this unit")
        if declined_total > 0:
            emit_tokens_push_sview(message, "; declined ")
            append_decimal(message, declined_total.u32())
            emit_tokens_push_sview(message, ": ")
            message.extend(decline_report)
        message.push(10)
        emit_tokens_push_sview(message, "note: emitted functions still reference declined bodies; the object was not written\n" if emitted_count < 0 else "note: every function body was declined; the object was not written\n")
        write_stderr(message)
        return 2

    # The pass pipeline runs only when ASKED (ELISA_STAGE1_OPT=1/2/3). It was disabled
    # outright while `default<O2>` trapped on large self-host modules — those traps were
    # the opaque-handle `==` and arena-identity miscompiles in the self-hosted binary
    # (fixed 2026-08-02/03), and the pipeline now survives the compiler's own 110k-line
    # module. Unoptimised emission stays the DEFAULT: the fixpoint compares bytes, and
    # optimisation must never change results, only speed — differential_corpus runs the
    # corpus under -O2 exactly to hold that.
    opt_level: i64 = optimization_level()
    match opt_level:
        1:
            5 return if not Backend::run_optimization(machine, module_handle, "default<O1>")
        2:
            5 return if not Backend::run_optimization(machine, module_handle, "default<O2>")
        3:
            5 return if not Backend::run_optimization(machine, module_handle, "default<O3>")
        _:
            pass

    path_cstr: cstr = (&out_path[0]).cast[cstr]
    if emit_llvm_requested():
        6 return if LLVMPrintModuleToFile(module_handle, path_cstr, null) != 0
    elif emit_mode_is("bc"):
        # `-emit bc` — the SAME module the object path lowers, written as bitcode instead
        # of assembled. It runs after the optimisation pipeline above, so `-O2 -emit bc`
        # is optimised bitcode, matching what stage0 writes.
        7 return if LLVMWriteBitcodeToFile(module_handle, path_cstr) != 0
    elif emit_mode_is("exe"):
        # Emit the object BESIDE the requested executable (path + ".o"), link, then remove
        # it. Writing next to the target keeps the temporary on the same filesystem the
        # caller can write to.
        object_path: mutable darray[u8] = []
        for path_index in 0..<out_path.count |object_path, out_path|:
            object_path.push(out_path[path_index]) if out_path[path_index] != 0
        object_path.push(46)
        object_path.push(111)
        object_path.push(0)
        object_cstr: cstr = (&object_path[0]).cast[cstr] can Unsafe.PointerCast
        4 return if not Backend::emit_object(machine, module_handle, object_cstr)
        object_path.pop()
        exe_path: mutable darray[u8] = []
        for path_index in 0..<out_path.count |exe_path, out_path|:
            exe_path.push(out_path[path_index]) if out_path[path_index] != 0
        link_status: i64 = link_executable(object_path, exe_path)
        link_status return if link_status != 0
    elif emit_mode_is("pymodule-so"):
        # The object is an ordinary one at the default destination; the pipeline links it
        # with the generated shim and the runtime into the extension, whose filename it
        # derives from the module name and the target interpreter's suffix.
        4 return if not Backend::emit_object(machine, module_handle, path_cstr)
        module_object: mutable darray[u8] = []
        for path_index in 0..<out_path.count |module_object, out_path|:
            module_object.push(out_path[path_index]) if out_path[path_index] != 0
        requested_out: mutable darray[u8] = []
        _ = env_value("ELISA_STAGE1_PYMODULE_OUT", &requested_out)
        so_status: i64 = emit_pymodule_so_finish(module_object, requested_out)
        _ = unlink(path_cstr)
        so_status return if so_status != 0
    elif emit_mode_is("wasm"):
        # The wasm32 object beside the `.wasm`, then the packaging steps (runtime object,
        # wasm-ld, manifest, facade) — see emit_wasm.elisa.
        wasm_object: mutable darray[u8] = []
        for path_index in 0..<out_path.count |wasm_object, out_path|:
            wasm_object.push(out_path[path_index]) if out_path[path_index] != 0
        emit_tokens_push_sview(&wasm_object, ".o")
        wasm_object.push(0)
        wasm_object_cstr: cstr = (&wasm_object[0]).cast[cstr] can Unsafe.PointerCast
        4 return if not Backend::emit_object(machine, module_handle, wasm_object_cstr)
        wasm_object.pop()
        wasm_out: mutable darray[u8] = []
        for path_index in 0..<out_path.count |wasm_out, out_path|:
            wasm_out.push(out_path[path_index]) if out_path[path_index] != 0
        # `file` is the EXPANDED parse when a `static generate` block was spliced, so the
        # export scan must be given the tokens and source that parse belongs to — the
        # token ranges are looked up by the declaration's own line and offset.
        wasm_status: mutable i64 = 0
        if expanded_tokens.count > 0:
            wasm_status <- emit_wasm_finish(file, expanded_tokens, expanded_src_ptr, wasm_object, wasm_out)
        else:
            wasm_status <- emit_wasm_finish(file, tokens, src_ptr, wasm_object, wasm_out)
        _ = unlink(wasm_object_cstr)
        wasm_status return if wasm_status != 0
    else:
        4 return if not Backend::emit_object(machine, module_handle, path_cstr)

    LLVMDisposeBuilder(builder)
    LLVMDisposeModule(module_handle)
    LLVMContextDispose(ctx)
    return 0
