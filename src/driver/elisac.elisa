# Stage1 product compiler: real frontend (lexer/parser) + Backend::emit → native object.
#
# Wire protocol on stdin (kept simple for self-host / non-libc argv):
#   line 1: absolute or relative output object path
#   rest:   Elisa source (includes already expanded, or a single-file program)
#
# Host wrappers (scripts/elisac_stage1.sh) accept `elisac-stage1 -o out.o file.elisa`,
# expand includes, and feed this driver.
include "../backend/codegen.elisa"
include "./emit_fmt_expr.elisa"
# The SEMANTIC layer is part of the product, not just of the tooling. Without it the driver
# went parse -> emit and stage1 silently ACCEPTED programs stage0 rejects (`x: mutable u8 = 0;
# x <- 300` emitted an object under stage1 and exited 1 under stage0). The bootstrap fixpoint
# cannot see that: every generation skips the check consistently, so gen3 == gen4 holds while
# the compiler analyses nothing.
include "../semantic/semantic.elisa"

# Stage1 meta-compile: prefer `u8&`/`i64` over `void&`/`isize` for the read extern so the
# product driver itself lowers under stage1 (gen2). Link still resolves libc `read`.
extern read(fd: i64, buf: u8&, count: usize) -> i64
# Real-CLI support. `main(argc, argv)` is portable and stage0 has always supported it —
# the "non-libc argv" note above was wrong about the obstacle. What actually blocked it
# was that indexing a `T&&` (C's `char**`) DECLINED in stage1's backend until it was
# implemented; there is no platform hook needed (`_NSGetArgv` works but is macOS-only).
#
# Flags are re-exported through setenv so the existing ELISA_STAGE1_* readers below need
# no change: the CLI and the environment stay ONE code path, and the wrapper's env-var
# invocations keep working exactly as before.
# `open` is VARIADIC — `open(const char *, int, ...)`. Declaring the mode as a FIXED third
# parameter passes it in a register, while the arm64 varargs ABI requires it on the stack,
# so libc read garbage and created files with mode `----------` (created, then unreadable).
extern open(path: cstr, flags: i64, ...) -> i64
extern close(fd: i64) -> i64
extern setenv(name: cstr, value: cstr, overwrite: i64) -> i64
extern mkdir(path: cstr, mode: u16) -> i64
# `#line` directives carry an ABSOLUTE path, so a relative -o/source argument is joined
# onto the working directory (stage0 uses filepath.Abs).
extern getcwd(buffer: void&, size: usize) -> void&
extern system(command: cstr) -> i64
extern unlink(path: cstr) -> i64
# Diagnostics go to STDERR through the std's libc `write` (declared in debug_referee.elisa as
# `write(fd: int, buf: void&, count: usize)`), NOT through `puts`: the driver includes
# elisacore_std, whose own `puts` overload shadows libc's under both the stage0 seed and the
# stage1 meta-compile. Passing an explicit length also avoids needing a NUL terminator on an
# owned darray.


# `n` as ASCII decimal, appended to `buffer`. Line numbers only, so u32 range is enough.
def append_decimal(buffer: mutable darray[u8]&, value: u32) -> void can[Abort.Panic, Memory.Allocate]:
    if value == 0:
        buffer.push(48)
        return
    digits: mutable darray[u8] = []
    remaining: mutable u32 = value
    for _step in 0..<12 |digits, remaining|:
        break if remaining == 0
        digits.push((48 + (remaining % 10)).u8())
        remaining <- remaining / 10
    for reverse_index in 0..<digits.count |buffer, digits|:
        buffer.push(digits[digits.count - 1.usize() - reverse_index])


def write_stderr(buffer: darray[u8]&) -> void can[Abort.Panic, Unsafe.PointerCast, Console]:
    can Console:
        return if buffer.count == 0
        # The cast is its own statement: an inline `expr.cast[T] can Effect` inside an argument
        # list reads as the end of the call.
        raw: void& = (&buffer[0]).cast[void&] can Unsafe.PointerCast
        _ = write(2, raw, buffer.count)


    # One diagnostic in stage0's shape minus the file/column span the stdin protocol does not
    # carry: `LINE: error: MESSAGE`. Wording comes from Semantic::diagnostic_message, the single
    # source of truth, so the CLI never re-derives per-kind text.
    #
    # Without this the driver rejected a program with a bare exit 1 and no explanation — the
    # accept/reject DECISION matched stage0 while the compiler was unusable for the thing a
    # diagnostic exists to do. Errors only: warnings do not block the build, and stage1's
    # semantic layer still over-reports them relative to stage0.
# Append the source path from ELISA_STAGE1_SRC, raw (no escaping — that is the JSON
# tokens report's concern). Nothing is appended when the variable is unset, which is how a
# pure-stdin caller that never named a file still gets a usable `LINE: message`.
def push_source_path(buffer: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag_storage: mutable darray[u8] = []
    for flag_index in 0..<sview_len("ELISA_STAGE1_SRC") |flag_storage|:
        flag_storage.push(sview_at("ELISA_STAGE1_SRC", flag_index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    wrote_any: mutable bool = false
    if getenv(flag_name) is path_bytes:
        cursor: mutable i64 = 0
        keep_scanning: mutable bool = true
        while keep_scanning |cursor, keep_scanning, buffer, wrote_any, path_bytes|:
            byte_ref: u8& = path_bytes + cursor
            path_byte: u8 = byte_ref
            if path_byte == 0:
                keep_scanning <- false
            else:
                buffer.push(path_byte)
                wrote_any <- true
                cursor <- cursor + 1
    return wrote_any


# A PARSE error, in stage0's position shape `PATH:LINE:COLUMN: message`.
#
# stage1 previously reported parse errors by exiting 1 with NO output at all — the one
# class of diagnostic every user hits first, and the compiler said nothing. Unlike a
# semantic Diagnostic, Ast::ParseError carries BOTH line and column, so the position here
# is exactly stage0's.
#
# The wording is deliberately close-but-not-identical to stage0's: stage0 names the
# offending TOKEN KIND ("unexpected token DEDENT in expression"), which needs a token-kind
# name table this driver does not have. The offending token's TEXT is printed instead,
# which is the actionable part. Position parity first; wording parity is a separate job.
def report_parse_error(failure: Ast::ParseError) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    line_buffer: mutable darray[u8] = []
    if push_source_path(&line_buffer):
        line_buffer.push(58)                              # ':'
    append_decimal(line_buffer, failure.line)
    line_buffer.push(58)                                  # ':'
    append_decimal(line_buffer, failure.column)
    line_buffer.push(58)                                  # ':'
    line_buffer.push(32)                                  # ' '
    text: sview = match failure.kind:
        Ast::ParseErrorKind.ExpectedToken: "expected a different token"
        Ast::ParseErrorKind.UnexpectedToken: "unexpected token"
        Ast::ParseErrorKind.ExpectedDeclaration: "expected a declaration"
        Ast::ParseErrorKind.ExpectedExpression: "expected an expression"
        Ast::ParseErrorKind.MismatchedWithBindings: "or-arm alternatives bind different constants"
        Ast::ParseErrorKind.SubmitOutsidePool: "submit outside a pool"
        _: "parse error"
    for text_index in 0..<sview_len(text) |line_buffer, text|:
        line_buffer.push(sview_at(text, text_index))
    if sview_len(failure.context) > 0:
        for prefix_index in 0..<sview_len(" near \"") |line_buffer|:
            line_buffer.push(sview_at(" near \"", prefix_index))
        for context_index in 0..<sview_len(failure.context) |line_buffer, failure|:
            line_buffer.push(sview_at(failure.context, context_index))
        line_buffer.push(34)                              # '"'
    line_buffer.push(10)
    write_stderr(line_buffer)


def report_diagnostic(diagnostic: Semantic::Diagnostic) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    line_buffer: mutable darray[u8] = []
    # stage0's shape is `PATH:LINE:COLSTART-COLEND: MESSAGE`. The path and line are here;
    # the COLUMN SPAN is not, because Semantic::Diagnostic carries only `line` — supplying
    # columns means threading spans through every diagnostic construction site, which is a
    # separate piece of work. Emitting `PATH:LINE:` is what editors and CI actually need to
    # jump to the fault, and it is strictly closer to stage0 than the previous bare LINE.
    if push_source_path(&line_buffer):
        line_buffer.push(58)                              # ':'
    append_decimal(line_buffer, diagnostic.line)
    line_buffer.push(58)                                  # ':'
    line_buffer.push(32)                                  # ' '
    message: darray[u8] = Semantic::diagnostic_message(diagnostic)
    line_buffer.extend(message)
    line_buffer.push(10)                                  # '\n'
    write_stderr(line_buffer)

# Does the SOURCE contain the standard library's own definition of `arena_alloc`? That is the
# marker for "this unit IS the trusted stdlib (or the compiler, which includes it)" — the same
# test scripts/elisac_stage1.sh applies to decide the flag, moved INTO the driver so every
# caller gets the same answer.
def source_defines_arena_alloc(source: u8&, length: usize) -> bool can[Abort.Panic]:
    marker: sview = "def arena_alloc("
    marker_length: usize = sview_len(marker)
    false return if length < marker_length
    limit: usize = length - marker_length
    start: mutable usize = 0
    while start <= limit |start|:
        matched: mutable bool = true
        offset: mutable usize = 0
        while offset < marker_length |offset, matched|:
            matched <- false if source[start + offset] != sview_at(marker, offset)
            break if not matched
            offset <- offset + 1.usize()
        true return if matched
        start <- start + 1.usize()
    return false


# Is this compilation unit the TRUSTED STANDARD LIBRARY (or the compiler, which
# includes it)? stage0 decides per FILE (isRuntimeStdPermissionInternal) and skips the
# passes that only apply to user code — the raw-concurrency surface removal and the
# region-tied-return check. stage1 cannot reproduce that granularity: include flattening
# concatenates without line directives, so a declaration's originating file is gone by the
# time the driver sees the source.
#
# So decide from the FLATTENED UNIT'S CONTENT, in the DRIVER. It used to be decided only by
# the wrapper and passed in through an env var, which meant every OTHER way of reaching the
# driver had to remember to set it: the moment the semantic gate became the default,
# self_host_gen3_smoke's stage B — which pipes the flattened compiler straight into gen2 —
# reported 24 region-tied-return errors and read as "bootstrap closure BROKE". The unit had
# not changed; only who was asking. A decision that belongs to the source belongs where the
# source is read.
#
# The env var still forces it on, for a caller that knows better than the marker.
#
# Coarser than stage0 (whole-unit rather than per-file) — it differs only for a program that
# includes the std AND redefines one of the removed names itself.
def runtime_std_enabled(source: u8&, length: usize) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    true return if source_defines_arena_alloc(source, length)
    flag_storage: mutable darray[u8] = []
    for index in 0..<sview_len("ELISA_STAGE1_RUNTIME_STD") |flag_storage|:
        flag_storage.push(sview_at("ELISA_STAGE1_RUNTIME_STD", index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is real:
        return true
    return false


# ON BY DEFAULT. A compiler that does not CHECK is not a compiler: without this the driver
# went parse -> emit and stage1 accepted programs stage0 rejects.
#
# It was opt-in while a stage1-COMPILED semantic layer computed differently from a
# stage0-compiled one. That is fixed. What it took, in the order the failures surfaced:
#   * `d <- d.put(k, v)` stored the helper's return value over the dict header;
#   * the deep packed pattern's probe ladder read the next level's handle without first
#     branching on the current level's tag;
#   * `for b in sview(literal, 0, -1)` compared the index UNSIGNED, so the std's
#     NUL-terminated sentinel read as 2^64-1;
#   * `scope` was an UNGUARDED contextual block keyword, so `scope.push(x)` parsed as a
#     `scope:` block — and Semantic.mark_mutable_locals' parameter is named `scope`, which
#     alone accounted for 319 E10 false positives on the compiler's own source;
#   * string literals reached LLVM with their escapes undecoded.
#
# gen2 now analyses the compiler's own 110k-line source with ZERO error-severity findings,
# exactly as the stage0-built driver does, and parse_report built by the two compilers agrees
# on 505 of 507 source files (the two are the same severity-2 warning, which does not gate).
#
# ELISA_STAGE1_NO_SEMANTIC_GATE=1 turns it off — an escape hatch for bisecting a suspected
# analyzer regression, not a supported mode.
# Is an environment flag present (any value)?
def env_flag_enabled(name: sview) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag_storage: mutable darray[u8] = []
    for index in 0..<sview_len(name) |flag_storage, name|:
        flag_storage.push(sview_at(name, index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is present:
        return true
    return false


def semantic_gate_enabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    # getenv needs a NUL-terminated string and an sview carries no terminator;
    # Backend::sview_to_cstr is private to that module, so terminate it here.
    flag_storage: mutable darray[u8] = []
    for index in 0..<sview_len("ELISA_STAGE1_NO_SEMANTIC_GATE") |flag_storage|:
        flag_storage.push(sview_at("ELISA_STAGE1_NO_SEMANTIC_GATE", index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is real:
        return false
    return true


# The requested optimisation level, from ELISA_STAGE1_OPT ("1"/"2"/"3"; absent or
# anything else = 0). Level 0 skips the pass manager entirely — emitting unoptimised
# objects stays the default, so the fixpoint and every existing measurement are unchanged
# unless a caller ASKS for optimisation.
# The requested target triple from ELISA_STAGE1_TRIPLE, or an empty view for "host".
# `storage` must outlive the returned view, so the caller owns it.
def requested_target_triple(storage: mutable darray[u8]&) -> sview can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag_storage: mutable darray[u8] = []
    for flag_index in 0..<sview_len("ELISA_STAGE1_TRIPLE") |flag_storage|:
        flag_storage.push(sview_at("ELISA_STAGE1_TRIPLE", flag_index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is triple_bytes:
        cursor: mutable i64 = 0
        keep_scanning: mutable bool = true
        while keep_scanning |cursor, keep_scanning, storage, triple_bytes|:
            byte_ref: u8& = triple_bytes + cursor
            triple_byte: u8 = byte_ref
            if triple_byte == 0:
                keep_scanning <- false
            else:
                storage.push(triple_byte)
                cursor <- cursor + 1
    return sview("", 0, 0) if storage.count == 0 else sview(&storage[0], 0, storage.count)


def optimization_level() -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag_storage: mutable darray[u8] = []
    for index in 0..<sview_len("ELISA_STAGE1_OPT") |flag_storage|:
        flag_storage.push(sview_at("ELISA_STAGE1_OPT", index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is level_bytes:
        # Compare as C strings (ctx_streq content compare) rather than dereferencing
        # the env byte: a `u8&` binding read in a value context goes through an
        # auto-deref path this driver otherwise never exercises.
        level_c: cstr = (level_bytes).cast[cstr] can Unsafe.PointerCast
        1 return if level_c == "1"
        2 return if level_c == "2"
        3 return if level_c == "3"
    return 0


# ELISA_STAGE1_EMIT=llvm writes textual IR to the output path instead of an object —
# the same module, the same pipeline, just printed rather than lowered. Anything else
# (or absent) keeps the object path.
def emit_mode_is(wanted: sview) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag_storage: mutable darray[u8] = []
    for index in 0..<sview_len("ELISA_STAGE1_EMIT") |flag_storage|:
        flag_storage.push(sview_at("ELISA_STAGE1_EMIT", index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is mode_bytes:
        mode_c: cstr = (mode_bytes).cast[cstr] can Unsafe.PointerCast
        wanted_storage: mutable darray[u8] = []
        for wanted_index in 0..<sview_len(wanted) |wanted_storage, wanted|:
            wanted_storage.push(sview_at(wanted, wanted_index))
        wanted_storage.push(0)
        wanted_c: cstr = (&wanted_storage[0]).cast[cstr] can Unsafe.PointerCast
        return mode_c == wanted_c
    return false


def emit_llvm_requested() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        return emit_mode_is("llvm")


    # ---- `-emit tokens` (ELISA_STAGE1_EMIT=tokens) ----------------------------------------
    #
    # stage0's lexer oracle, reproduced BYTE FOR BYTE on stdout: a JSON report of token count,
    # the canonical FNV-1a kind checksum (offset 1469598103934665603, prime 1099511628211,
    # count then each kind+1 — the single algorithm the cross-repo lexer parity test defines),
    # and per-token stage0 ordinals + names. `emit_tokens_kind_code` is the fixture-validated
    # stage1->stage0 kind mapping (test/fixtures/lexer/token_model_cases.elisa — the lexer
    # parity gate holds its checksum against the Go oracle); the name table is generated from
    # stage0's lexer/token.go tokenNames map. The wrapper redirects stdout to the -o path.

def emit_tokens_kind_code(kind: TokenKind) -> u64:
    match kind:
        TokenKind.Eof:
            return 1
        TokenKind.Newline:
            return 2
        TokenKind.Indent:
            return 3
        TokenKind.Dedent:
            return 4
        TokenKind.Ident:
            return 5
        TokenKind.IntLit:
            return 6
        TokenKind.FloatLit:
            return 7
        TokenKind.HexLit:
            return 8
        TokenKind.StringLit:
            return 9
        TokenKind.Def:
            return 10
        TokenKind.Error:
            return 11
        TokenKind.Enum:
            return 12
        TokenKind.Struct:
            return 13
        TokenKind.Const:
            return 14
        TokenKind.Global:
            return 15
        TokenKind.Extern:
            return 16
        TokenKind.Export:
            return 17
        TokenKind.If:
            return 18
        TokenKind.Match:
            return 19
        TokenKind.Elif:
            return 20
        TokenKind.Else:
            return 21
        TokenKind.While:
            return 22
        TokenKind.Break:
            return 23
        TokenKind.Continue:
            return 24
        TokenKind.Return:
            return 25
        TokenKind.Heap:
            return 26
        TokenKind.Stack:
            return 27
        # `Owned` is reserved in the stage1 enum but not currently emitted as a keyword
        # (stage0 has no TOKEN_OWNED). Keep a stable unused code so matches stay exhaustive
        # without shifting the stage0-aligned codes for Static/Mutable/…
        TokenKind.Owned:
            return 110
        TokenKind.Static:
            return 28
        TokenKind.Mutable:
            return 29
        TokenKind.Repr:
            return 31
        TokenKind.Packed:
            return 32
        TokenKind.Aligned:
            return 33
        TokenKind.Pass:
            return 34
        TokenKind.Panic:
            return 35
        TokenKind.Not:
            return 36
        TokenKind.And:
            return 37
        TokenKind.Or:
            return 38
        TokenKind.Null:
            return 39
        TokenKind.True:
            return 40
        TokenKind.False:
            return 41
        TokenKind.Zeroed:
            return 42
        TokenKind.Sizeof:
            return 43
        TokenKind.Alignof:
            return 44
        TokenKind.Offsetof:
            return 45
        TokenKind.Tail:
            return 46
        TokenKind.Try:
            return 47
        TokenKind.Catch:
            return 48
        TokenKind.Raise:
            return 49
        TokenKind.Region:
            return 50
        TokenKind.New:
            return 51
        TokenKind.As:
            return 52
        TokenKind.In:
            return 53
        TokenKind.With:
            return 54
        TokenKind.Colon:
            return 55
        TokenKind.Scope:
            return 56
        TokenKind.Arrow:
            return 57
        TokenKind.Dot:
            return 58
        TokenKind.Range:
            return 59
        TokenKind.RangeLt:
            return 60
        TokenKind.RangeGt:
            return 61
        # 110 (the report prints code - 1, so this is stage0's 109 = "..="). It read 109
        # here, which COLLIDED with Semicolon and printed `..=` as `;` — the token report
        # is byte-compared against stage0, and no fixture contained an INCLUSIVE range, so
        # the collision sat in the table unexercised.
        TokenKind.RangeLe:
            return 110
        TokenKind.Comma:
            return 62
        TokenKind.LParen:
            return 63
        TokenKind.RParen:
            return 64
        TokenKind.LBracket:
            return 65
        TokenKind.RBracket:
            return 66
        TokenKind.Hash:
            return 67
        TokenKind.Ampersand:
            return 68
        TokenKind.Question:
            return 69
        TokenKind.QAssign:
            return 70
        TokenKind.Bang:
            return 71
        TokenKind.At:
            return 72
        TokenKind.Ellipsis:
            return 73
        TokenKind.LArrow:
            return 74
        TokenKind.PlusEq:
            return 75
        TokenKind.MinusEq:
            return 76
        TokenKind.StarEq:
            return 77
        TokenKind.SlashEq:
            return 78
        TokenKind.PercentEq:
            return 79
        TokenKind.CaretEq:
            return 80
        TokenKind.PipeEq:
            return 81
        TokenKind.AmpEq:
            return 82
        TokenKind.LShiftEq:
            return 83
        TokenKind.RShiftEq:
            return 84
        TokenKind.Assign:
            return 85
        TokenKind.EqEq:
            return 86
        TokenKind.BangEq:
            return 87
        TokenKind.Lt:
            return 88
        TokenKind.Gt:
            return 89
        TokenKind.LtEq:
            return 90
        TokenKind.GtEq:
            return 91
        TokenKind.Plus:
            return 92
        TokenKind.Minus:
            return 93
        TokenKind.Star:
            return 94
        TokenKind.Slash:
            return 95
        TokenKind.Percent:
            return 96
        TokenKind.Pipe:
            return 97
        TokenKind.Caret:
            return 98
        TokenKind.LShift:
            return 99
        TokenKind.RShift:
            return 100
        TokenKind.Tilde:
            return 101
        TokenKind.CharLit:
            return 102
        TokenKind.Is:
            return 103
        TokenKind.FatArrow:
            return 104
        TokenKind.To:
            return 105
        TokenKind.LBrace:
            return 106
        TokenKind.RBrace:
            return 107
        TokenKind.PipeGt:
            return 108
        TokenKind.Semicolon:
            return 109
        # Comments never enter the main token stream, so this code is unreachable in a
        # report; it is distinct from FString's only so the two cannot be confused the way
        # RangeLe and Semicolon were.
        TokenKind.Comment:
            return 112
        TokenKind.FString:
            return 111
        TokenKind.Lmut:
            return 30
    return 0

def emit_tokens_kind_name(code: u64, storage: mutable darray[u8]&) -> sview can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate:
        "EOF" return if code == 0
        "NEWLINE" return if code == 1
        "INDENT" return if code == 2
        "DEDENT" return if code == 3
        "IDENT" return if code == 4
        "INT" return if code == 5
        "FLOAT" return if code == 6
        "HEX" return if code == 7
        "STRING" return if code == 8
        "def" return if code == 9
        "error" return if code == 10
        "enum" return if code == 11
        "struct" return if code == 12
        "const" return if code == 13
        "global" return if code == 14
        "extern" return if code == 15
        "export" return if code == 16
        "if" return if code == 17
        "match" return if code == 18
        "elif" return if code == 19
        "else" return if code == 20
        "while" return if code == 21
        "break" return if code == 22
        "continue" return if code == 23
        "return" return if code == 24
        "heap" return if code == 25
        "stack" return if code == 26
        "static" return if code == 27
        "mutable" return if code == 28
        "lmut" return if code == 29
        "repr" return if code == 30
        "packed" return if code == 31
        "pass" return if code == 33
        "panic" return if code == 34
        "not" return if code == 35
        "and" return if code == 36
        "or" return if code == 37
        "null" return if code == 38
        "true" return if code == 39
        "false" return if code == 40
        "zeroed" return if code == 41
        "sizeof" return if code == 42
        "alignof" return if code == 43
        "offsetof" return if code == 44
        "tail" return if code == 45
        "try" return if code == 46
        "catch" return if code == 47
        "raise" return if code == 48
        "region" return if code == 49
        "new" return if code == 50
        "as" return if code == 51
        "in" return if code == 52
        "with" return if code == 53
        ":" return if code == 54
        "::" return if code == 55
        "->" return if code == 56
        "." return if code == 57
        ".." return if code == 58
        "..<" return if code == 59
        "..>" return if code == 60
        "," return if code == 61
        "(" return if code == 62
        ")" return if code == 63
        "[" return if code == 64
        "]" return if code == 65
        "#" return if code == 66
        "&" return if code == 67
        "?" return if code == 68
        "?=" return if code == 69
        "!" return if code == 70
        "@" return if code == 71
        "..." return if code == 72
        "<-" return if code == 73
        "+=" return if code == 74
        "-=" return if code == 75
        "*=" return if code == 76
        "/=" return if code == 77
        "%=" return if code == 78
        "^=" return if code == 79
        "|=" return if code == 80
        "&=" return if code == 81
        "<<=" return if code == 82
        ">>=" return if code == 83
        "=" return if code == 84
        "==" return if code == 85
        "!=" return if code == 86
        "<" return if code == 87
        ">" return if code == 88
        "<=" return if code == 89
        ">=" return if code == 90
        "+" return if code == 91
        "-" return if code == 92
        "*" return if code == 93
        "/" return if code == 94
        "%" return if code == 95
        "|" return if code == 96
        "^" return if code == 97
        "<<" return if code == 98
        ">>" return if code == 99
        "~" return if code == 100
        "CHAR" return if code == 101
        "is" return if code == 102
        "=>" return if code == 103
        "to" return if code == 104
        "{" return if code == 105
        "}" return if code == 106
        "|>" return if code == 107
        ";" return if code == 108
        "..=" return if code == 109
        "FSTRING" return if code == 110
        # stage0's TokenName fallback: fmt.Sprintf("TokenKind(%d)", kind).
        storage.clear()
        for prefix_index in 0..<sview_len("TokenKind(") |storage|:
            storage.push(sview_at("TokenKind(", prefix_index))
        append_decimal(storage, code.i64())
        storage.push(41)
        return sview(&storage[0], 0, storage.count)


def emit_tokens_push_sview(buffer: mutable darray[u8]&, text: sview) -> void can[Abort.Panic, Memory.Allocate]:
    for push_index in 0..<sview_len(text) |buffer, text|:
        buffer.push(sview_at(text, push_index))


# A JSON STRING value's bytes, with Go's json.Encoder escaping: `<` `>` `&` become
# \u003c \u003e \u0026 (the encoder HTML-escapes by default), and `"`/`\` get a
# backslash. Operator token names ("->", "<=", "&") hit the HTML set constantly.
def emit_tokens_push_json_string(buffer: mutable darray[u8]&, text: sview) -> void can[Abort.Panic, Memory.Allocate]:
    for json_index in 0..<sview_len(text) |buffer, text|:
        json_byte: u8 = sview_at(text, json_index)
        if json_byte == 60:
            for esc_index in 0..<sview_len("\\u003c") |buffer|:
                buffer.push(sview_at("\\u003c", esc_index))
        elif json_byte == 62:
            for esc_index in 0..<sview_len("\\u003e") |buffer|:
                buffer.push(sview_at("\\u003e", esc_index))
        elif json_byte == 38:
            for esc_index in 0..<sview_len("\\u0026") |buffer|:
                buffer.push(sview_at("\\u0026", esc_index))
        else:
            buffer.push(92) if json_byte == 92 or json_byte == 34
            buffer.push(json_byte)


def emit_tokens_push_u64(buffer: mutable darray[u8]&, value: u64) -> void can[Abort.Panic, Memory.Allocate]:
    digits: mutable darray[u8] = []
    value_left: mutable u64 = value
    digits.push(48) if value_left == 0
    while value_left > 0 |value_left, digits|:
        digits.push((48 + (value_left % 10).i64()).u8())
        value_left <- value_left / 10
    digit_index: mutable i64 = digits.count.i64() - 1
    while digit_index >= 0 |digit_index, digits, buffer|:
        buffer.push(digits[digit_index.usize()])
        digit_index <- digit_index - 1


# The source path stage0 prints in the report, from ELISA_STAGE1_SRC (the wrapper knows
# the original path; the stdin protocol does not carry it). Escapes the two JSON-special
# bytes a path can contain.
def emit_tokens_push_source_name(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag_storage: mutable darray[u8] = []
    for flag_index in 0..<sview_len("ELISA_STAGE1_SRC") |flag_storage|:
        flag_storage.push(sview_at("ELISA_STAGE1_SRC", flag_index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is path_bytes:
        cursor: mutable i64 = 0
        keep_scanning: mutable bool = true
        while keep_scanning |cursor, keep_scanning, buffer, path_bytes|:
            byte_ref: u8& = path_bytes + cursor
            path_byte: u8 = byte_ref
            if path_byte == 0:
                keep_scanning <- false
            else:
                buffer.push(92) if path_byte == 92 or path_byte == 34
                buffer.push(path_byte)
                cursor <- cursor + 1


# The OFFSET-MAP delta covering a flat-buffer byte offset, or -1 when the wrapper
# supplied no map. stage0 names a synthesized auto-region `__auto_<pos.Offset>` with the
# offset measured over its `#line`-directive-bearing include expansion; the wrapper's
# flattener records the divergence as ascending `flatoff:delta` pairs in
# ELISA_STAGE1_OFFSET_MAP, and the covering delta (last pair at or below the offset)
# added to a stage1 token offset recovers stage0's number.
def emit_fmt_offset_delta(offset: i64) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    map_storage: mutable darray[u8] = []
    for map_index in 0..<sview_len("ELISA_STAGE1_OFFSET_MAP") |map_storage|:
        map_storage.push(sview_at("ELISA_STAGE1_OFFSET_MAP", map_index))
    map_storage.push(0)
    map_name: cstr = (&map_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(map_name) is map_bytes:
        best_delta: mutable i64 = -1
        entry_offset: mutable i64 = 0
        entry_delta: mutable i64 = 0
        in_delta: mutable bool = false
        cursor: mutable i64 = 0
        scanning: mutable bool = true
        while scanning |best_delta, entry_offset, entry_delta, in_delta, cursor, scanning, map_bytes, offset|:
            byte_ref: u8& = map_bytes + cursor
            map_byte: u8 = byte_ref
            if map_byte == 0 or map_byte == 44:
                if in_delta and entry_offset <= offset:
                    best_delta <- entry_delta
                entry_offset <- 0
                entry_delta <- 0
                in_delta <- false
                scanning <- false if map_byte == 0
            elif map_byte == 58:
                in_delta <- true
            elif map_byte >= 48 and map_byte <= 57:
                if in_delta:
                    entry_delta <- entry_delta * 10 + (map_byte - 48).i64()
                else:
                    entry_offset <- entry_offset * 10 + (map_byte - 48).i64()
            cursor <- cursor + 1
        return best_delta
    return -1


def emit_tokens_report(tokens: darray[Lexer::Token]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    buffer: mutable darray[u8] = []
    emit_tokens_push_sview(buffer, "{\n  \"file\": \"")
    emit_tokens_push_source_name(buffer)
    emit_tokens_push_sview(buffer, "\",\n  \"count\": ")
    emit_tokens_push_u64(buffer, tokens.count.u64())
    checksum: mutable u64 = 1469598103934665603
    checksum <- (checksum ^ tokens.count.u64()) * 1099511628211
    for checksum_token in tokens |checksum|:
        checksum <- (checksum ^ emit_tokens_kind_code(checksum_token.kind)) * 1099511628211
    emit_tokens_push_sview(buffer, ",\n  \"checksum\": ")
    emit_tokens_push_u64(buffer, checksum)
    emit_tokens_push_sview(buffer, ",\n  \"kinds\": [")
    first_token: mutable bool = true
    name_storage: mutable darray[u8] = []
    for report_token in tokens |buffer, first_token, name_storage|:
        emit_tokens_push_sview(buffer, ",") if not first_token
        first_token <- false
        emit_tokens_push_sview(buffer, "\n    {\n      \"k\": ")
        emit_tokens_push_u64(buffer, emit_tokens_kind_code(report_token.kind) - 1)
        emit_tokens_push_sview(buffer, ",\n      \"n\": \"")
        token_name: sview = emit_tokens_kind_name(emit_tokens_kind_code(report_token.kind) - 1, name_storage)
        emit_tokens_push_json_string(buffer, token_name)
        emit_tokens_push_sview(buffer, "\"\n    }")
    emit_tokens_push_sview(buffer, "\n  ]\n}\n")
    return 0 if buffer.count == 0 else emit_tokens_flush(buffer)


# The REPORT modes (tokens/ast/iface/fmt/deps/deps-json) write to STDOUT, which is how
# stage0 behaves and how the host wrapper consumes them (it redirects with `exec > "$out"`).
# A CLI caller that passed `-o` expects the FILE to be written, though: without this,
# `-emit fmt -o out.txt` printed to the terminal and left out.txt missing — the same shape
# of silent wrong answer as an unsupported -emit mode quietly producing an object.
#
# ELISA_STAGE1_OUT is set only by the CLI path, so the wrapper's stdout contract is
# untouched.
def report_output_path(storage: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag_storage: mutable darray[u8] = []
    for flag_index in 0..<sview_len("ELISA_STAGE1_OUT") |flag_storage|:
        flag_storage.push(sview_at("ELISA_STAGE1_OUT", flag_index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is path_bytes:
        cursor: mutable i64 = 0
        keep_scanning: mutable bool = true
        while keep_scanning |cursor, keep_scanning, storage, path_bytes|:
            byte_ref: u8& = path_bytes + cursor
            path_byte: u8 = byte_ref
            if path_byte == 0:
                keep_scanning <- false
            else:
                storage.push(path_byte)
                cursor <- cursor + 1
    false return if storage.count == 0
    storage.push(0)
    return true


def emit_tokens_flush(buffer: darray[u8]&) -> i64 can[Abort.Panic, Unsafe.PointerCast, Memory.Allocate, Console]:
    can Console:
        0 return if buffer.count == 0
        raw: void& = (&buffer[0]).cast[void&] can Unsafe.PointerCast
        out_path_storage: mutable darray[u8] = []
        if report_output_path(&out_path_storage):
            # O_WRONLY|O_CREAT|O_TRUNC on darwin: 1 | 0x200 | 0x400.
            # The cast is its own statement: an inline `expr.cast[T] can Effect` inside an
            # argument list reads as the end of the call.
            out_path_c: cstr = (&out_path_storage[0]).cast[cstr] can Unsafe.PointerCast
            descriptor: i64 = open(out_path_c, 1537, 420)
            if descriptor >= 0:
                _ = write(descriptor, raw, buffer.count)
                _ = close(descriptor)
                return 0
        _ = write(1, raw, buffer.count)
        return 0


    # ---- `-emit ast` (ELISA_STAGE1_EMIT=ast) ----------------------------------------------
    #
    # stage0's parse-tree summary, reproduced line for line for the declaration kinds this
    # AST models: the `File: PATH (N declarations)` header, then one summary line per
    # declaration (`def NAME(N params) -> RET (M stmts)`, `struct NAME[T] (K fields)`,
    # `module NAME: (K decls)` with children indented, `type NAME = TARGET`, `using NAME`).
    # stage0 prints NO line for an enum declaration — it is counted in the header and
    # skipped — and this printer does the same.
    #
    # TYPE RENDERING IS TOKEN-SPAN BASED: stage0's typeStr prints the normalized source
    # spelling of a type, so rather than porting its two-hundred-line shape switch, the
    # return type / generic bracket / alias target are re-rendered from the declaration
    # line's TOKENS with stage0's spacing rules (", " after a comma, a space after the
    # heap/stack/static/mutable/tail storage keywords, nothing elsewhere). That covers every
    # type the language can spell with one rule set instead of one arm per shape.

def emit_ast_token_needs_space(kind: Lexer::TokenKind) -> bool can[Abort.Panic]:
    true return if kind == Lexer::TokenKind.Heap
    true return if kind == Lexer::TokenKind.Stack
    true return if kind == Lexer::TokenKind.Static
    true return if kind == Lexer::TokenKind.Mutable
    true return if kind == Lexer::TokenKind.Tail
    return false


# Render tokens [from, to) of the declaration line with stage0's type spacing.
def emit_ast_render_tokens(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, from_index: usize, to_index: usize) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate:
        for render_index in from_index..<to_index |buffer, tokens, source, from_index, to_index|:
            render_token: Lexer::Token = tokens[render_index]
            render_text: sview = Lexer::text_or_empty(render_token, source)
            # An error-UNION return renders as `V error[...]` — one space before `error`.
            buffer.push(32) if render_index > from_index and render_token.kind == Lexer::TokenKind.Error
            emit_tokens_push_sview(buffer, render_text)
            if render_token.kind == Lexer::TokenKind.Comma:
                buffer.push(32)
            elif render_token.kind == Lexer::TokenKind.Colon:
                # A value-generic's annotation (`[T, N: usize]`) keeps stage0's `: ` gap —
                # measured identically on the ast, iface, and fmt surfaces.
                buffer.push(32)
            elif emit_ast_token_needs_space(render_token.kind):
                buffer.push(32)
            elif render_token.kind == Lexer::TokenKind.Ident and render_text == "permission" and render_index + 1 < to_index and tokens[render_index + 1].kind == Lexer::TokenKind.Ident:
                # A permission generic parameter (`[A, R, permission P]`) — `permission` is an
                # ordinary identifier to the lexer, so its keyword gap is text-decided.
                buffer.push(32)


    # The token index range of declaration LINE's signature: first token on the line to the
    # depth-0 `:` (or the line's end). Brackets and parens nest; a `:` inside `[...]`/`(...)`
    # (a parameter annotation) does not close the signature.
def emit_ast_line_range(tokens: darray[Lexer::Token]&, line: u32) -> (found: bool, start: usize, stop: usize) can[Abort.Panic]:
    start_index: mutable usize = 0
    found_start: mutable bool = false
    for scan_index in 0..<tokens.count |start_index, found_start, tokens, line|:
        continue if found_start
        scan_token: Lexer::Token = tokens[scan_index]
        continue if scan_token.line != line
        continue if scan_token.kind == Lexer::TokenKind.Newline or scan_token.kind == Lexer::TokenKind.Indent or scan_token.kind == Lexer::TokenKind.Dedent
        start_index <- scan_index
        found_start <- true
    (false, 0, 0) return if not found_start
    stop_index: mutable usize = start_index
    depth: mutable i64 = 0
    scanning: mutable bool = true
    while scanning and stop_index < tokens.count |stop_index, depth, scanning, tokens, line|:
        stop_token: Lexer::Token = tokens[stop_index]
        if stop_token.line != line or stop_token.kind == Lexer::TokenKind.Newline:
            scanning <- false
        else:
            depth <- depth + 1 if stop_token.kind == Lexer::TokenKind.LParen or stop_token.kind == Lexer::TokenKind.LBracket
            depth <- depth - 1 if stop_token.kind == Lexer::TokenKind.RParen or stop_token.kind == Lexer::TokenKind.RBracket
            if depth == 0 and stop_token.kind == Lexer::TokenKind.Colon:
                scanning <- false
            else:
                stop_index <- stop_index + 1
    return (true, start_index, stop_index)


# ` -> RET` for the def at LINE, rendered from its signature tokens (empty when the def
# has no arrow). RET ends at the depth-0 `:` or a trailing `can` effects clause.
def emit_ast_return_segment(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        line_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
        return if not line_range.found
        arrow_index: mutable usize = 0
        arrow_found: mutable bool = false
        probe_depth: mutable i64 = 0
        for probe_index in line_range.start..<line_range.stop |arrow_index, arrow_found, probe_depth, tokens|:
            probe_token: Lexer::Token = tokens[probe_index]
            probe_depth <- probe_depth + 1 if probe_token.kind == Lexer::TokenKind.LParen or probe_token.kind == Lexer::TokenKind.LBracket
            probe_depth <- probe_depth - 1 if probe_token.kind == Lexer::TokenKind.RParen or probe_token.kind == Lexer::TokenKind.RBracket
            continue if arrow_found
            if probe_depth == 0 and probe_token.kind == Lexer::TokenKind.Arrow:
                arrow_index <- probe_index
                arrow_found <- true
        return if not arrow_found
        stop_at: mutable usize = line_range.stop
        for stop_probe in (arrow_index + 1)..<line_range.stop |stop_at, tokens, source, arrow_index|:
            continue if stop_at != 0 and stop_at < line_range.stop and stop_probe >= stop_at
            stop_probe_token: Lexer::Token = tokens[stop_probe]
            if stop_probe_token.kind == Lexer::TokenKind.Ident and Lexer::text_or_empty(stop_probe_token, source) == "can":
                stop_at <- stop_probe
        emit_tokens_push_sview(buffer, " -> ")
        emit_ast_render_tokens(buffer, tokens, source, arrow_index + 1, stop_at)


    # `[T, @owner]` after a struct/def NAME, when the declaration carries a generic bracket.
def emit_ast_generic_segment(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        line_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
        return if not line_range.found
        # The bracket right after the declaration NAME: token 0 is the keyword, token 1 the
        # name, so a generic bracket is token 2. A def's parameter list follows in parens.
        bracket_index: usize = line_range.start + 2
        return if bracket_index >= line_range.stop
        return if tokens[bracket_index].kind != Lexer::TokenKind.LBracket
        close_index: mutable usize = bracket_index
        close_depth: mutable i64 = 0
        closing: mutable bool = true
        while closing and close_index < line_range.stop |close_index, close_depth, closing, tokens|:
            close_token: Lexer::Token = tokens[close_index]
            close_depth <- close_depth + 1 if close_token.kind == Lexer::TokenKind.LBracket
            close_depth <- close_depth - 1 if close_token.kind == Lexer::TokenKind.RBracket
            if close_depth == 0:
                closing <- false
            else:
                close_index <- close_index + 1
        emit_ast_render_tokens(buffer, tokens, source, bracket_index, close_index + 1)


    # `type NAME = TARGET` — the target is everything after the depth-0 `=` on the line.
def emit_ast_alias_target(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        line_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
        return if not line_range.found
        equals_index: mutable usize = 0
        equals_found: mutable bool = false
        for eq_probe in line_range.start..<line_range.stop |equals_index, equals_found, tokens|:
            continue if equals_found
            if tokens[eq_probe].kind == Lexer::TokenKind.Assign:
                equals_index <- eq_probe
                equals_found <- true
        return if not equals_found
        emit_ast_render_tokens(buffer, tokens, source, equals_index + 1, line_range.stop)


    # Whether a type annotation names a CONTAINER (darray/dict/set/dstr head): the shapes
    # whose locals make stage0's region inference wrap the whole body in one `in auto:`
    # block — which is why its ast dump prints such a body as "(1 stmts)".
def emit_ast_expr_head_is_container(expression: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        if expression is Expr.Ident(head_name, head_line):
            return head_name == "darray" or head_name == "dict" or head_name == "set" or head_name == "dstr"
        if expression is Expr.Index(head_object, head_arg, head_index_line):
            return emit_ast_expr_head_is_container(head_object)
        if expression is Expr.IndexN(head_object_n, head_args_n, head_line_n):
            return emit_ast_expr_head_is_container(head_object_n)
        if expression is Expr.Paren(head_inner, head_paren_line):
            return emit_ast_expr_head_is_container(head_inner)
        if expression is Expr.Unary(head_operator, head_operand, head_unary_line):
            return emit_ast_expr_head_is_container(head_operand)
        return false


    # A local whose declared type is a named STRUCT holding a container FIELD wraps too.
    # Measured against stage0: `struct Grid: cells: array[i64, 4]` then `g: Grid = …` prints
    # "(1 stmts)" under stage0 while a struct of plain scalars, and a BARE `array[i64, 3]`
    # local, both print their real count. Looking only at the declared type HEAD missed the
    # whole family — the head is `Grid`, not a container name.
    #
    # `array` counts here even though a fixed array allocates nothing on its own: the rule is
    # stage0's, read off its output, not a claim about where the storage lives.
def emit_ast_struct_field_is_container(field_type: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        if field_type is Expr.Ident(field_head_name, field_head_line):
            return field_head_name == "darray" or field_head_name == "dict" or field_head_name == "set" or field_head_name == "dstr" or field_head_name == "array"
        if field_type is Expr.Index(field_object, field_arg, field_index_line):
            return emit_ast_struct_field_is_container(field_object)
        if field_type is Expr.IndexN(field_object_n, field_args_n, field_line_n):
            return emit_ast_struct_field_is_container(field_object_n)
        return false


def emit_ast_named_struct_holds_container(type_expression: Ast::Expr, struct_names: darray[sview]&, struct_member_rows: darray[Ast::StructMember]&, struct_member_starts: darray[usize]&, struct_member_counts: darray[usize]&) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        if type_expression is Expr.Ident(struct_type_name, struct_type_line):
            for struct_index in 0..<struct_names.count |struct_type_name, struct_names, struct_member_rows, struct_member_starts, struct_member_counts|:
                continue if struct_names[struct_index] != struct_type_name
                member_start: usize = struct_member_starts[struct_index]
                member_count: usize = struct_member_counts[struct_index]
                for member_offset in 0..<member_count |member_start, struct_member_rows|:
                    true return if emit_ast_struct_field_is_container(struct_member_rows[member_start + member_offset].type_expression)
            return false
        return false


    # A container local with an explicit `@region` annotation allocates from THAT region,
    # not the auto one, so it does not trigger the wrap (region_statement_form prints its
    # real statement count under stage0). The annotations are line+name keyed.
def emit_ast_local_has_region(annotations: darray[Ast::LocalRegionAnnotation]&, name: sview, line: u32) -> bool can[Abort.Panic, Memory.Allocate]:
    for region_row in annotations |name, line|:
        true return if region_row.name == name and region_row.line == line and region_row.region != ""
    return false


def emit_ast_body_declares_container(statements: darray[Ast::Stmt]&, annotations: darray[Ast::LocalRegionAnnotation]&, struct_names: darray[sview]&, struct_member_rows: darray[Ast::StructMember]&, struct_member_starts: darray[usize]&, struct_member_counts: darray[usize]&) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        for wrap_statement in statements |annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts|:
            if wrap_statement is Stmt.VarDecl(wrap_name, wrap_type, wrap_value, wrap_line):
                wrap_is_container: bool = emit_ast_expr_head_is_container(wrap_type) or emit_ast_named_struct_holds_container(wrap_type, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
                true return if wrap_is_container and not emit_ast_local_has_region(annotations, wrap_name, wrap_line)
            if wrap_statement is Stmt.If(wrap_cond, wrap_then, wrap_else, wrap_if_line):
                true return if emit_ast_body_declares_container(wrap_then, annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
                true return if emit_ast_body_declares_container(wrap_else, annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
            if wrap_statement is Stmt.While(wrap_wcond, wrap_wbody, wrap_while_line):
                true return if emit_ast_body_declares_container(wrap_wbody, annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
            if wrap_statement is Stmt.For(wrap_bind, wrap_vars, wrap_iter, wrap_fbody, wrap_for_line):
                true return if emit_ast_body_declares_container(wrap_fbody, annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
            if wrap_statement is Stmt.Block(wrap_kind, wrap_clause, wrap_binding, wrap_bbody, wrap_block_line):
                true return if emit_ast_body_declares_container(wrap_bbody, annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
        return false


    # A method call that can ALLOCATE into its receiver — the growth sites stage0's region
    # inference keys on.
def emit_ast_is_growth_method(name: sview) -> bool:
    return name == "push" or name == "put" or name == "extend" or name == "insert" or name == "reserve" or name == "resize" or name == "append"


# stage0's region inference is a BODY dataflow pass, not a signature-shape test: a
# reference parameter earns an inferred region only when the body actually GROWS it
# through an implicit allocation (`p.push(..)`, `p.f <- p.f.put(..)`). The std's
# `arena_*` helpers take a container ref of exactly the inferring SHAPE but allocate
# through an explicit arena — either by forwarding to an `arena_*` callee or inside an
# `in a:` block — so stage0 infers nothing for them. This approximates the pass with the
# two signals visible in the token stream: a growth call on the parameter's own chain,
# and the absence of a statement-leading `in` block (an explicit allocation target) in
# the same body.
def emit_ast_param_grown_in_body(tokens: darray[Lexer::Token]&, source: u8&, line: u32, name: sview) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic:
        header_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
        false return if not header_range.found
        body_depth: mutable i64 = 0
        body_entered: mutable bool = false
        body_done: mutable bool = false
        body_grown: mutable bool = false
        body_explicit: mutable bool = false
        for grow_probe in header_range.stop..<tokens.count |body_depth, body_entered, body_done, body_grown, body_explicit, tokens, source, name|:
            continue if body_done
            grow_kind: Lexer::TokenKind = tokens[grow_probe].kind
            if grow_kind == Lexer::TokenKind.Indent:
                body_depth <- body_depth + 1
                body_entered <- true
            elif grow_kind == Lexer::TokenKind.Dedent:
                body_depth <- body_depth - 1
                body_done <- true if body_entered and body_depth <= 0
            elif grow_kind == Lexer::TokenKind.In and grow_probe > 0:
                # `for x in xs` also spells `in`; only a STATEMENT-LEADING `in a:` names an
                # explicit allocation target.
                lead_kind: Lexer::TokenKind = tokens[grow_probe - 1].kind
                body_explicit <- true if lead_kind == Lexer::TokenKind.Indent or lead_kind == Lexer::TokenKind.Newline or lead_kind == Lexer::TokenKind.Dedent
            elif grow_kind == Lexer::TokenKind.Ident and Lexer::text_or_empty(tokens[grow_probe], source) == name:
                chain_index: mutable usize = grow_probe + 1
                chain_scanning: mutable bool = true
                while chain_scanning and chain_index + 2 < tokens.count |chain_index, chain_scanning, body_grown, tokens, source|:
                    if tokens[chain_index].kind != Lexer::TokenKind.Dot or tokens[chain_index + 1].kind != Lexer::TokenKind.Ident:
                        chain_scanning <- false
                    else:
                        chain_method: sview = Lexer::text_or_empty(tokens[chain_index + 1], source)
                        if tokens[chain_index + 2].kind == Lexer::TokenKind.LParen and emit_ast_is_growth_method(chain_method):
                            body_grown <- true
                            chain_scanning <- false
                        else:
                            chain_index <- chain_index + 2
        return body_grown and not body_explicit


    # stage0 prints the region params its inference ADDS: a def with no explicit generic
    # bracket whose parameter list contains a growable REFERENCE (`darray[..]&`, `dict&`)
    # renders as `def f[@__rg_<param>](...)`. Decided from the signature tokens: within the
    # parameter parens, a comma-separated segment that contains a container head AND a
    # trailing `&` contributes `@__rg_` + its first identifier (the parameter name) — gated
    # on that parameter actually being grown by the body.
def emit_ast_inferred_region_params(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        line_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
        return if not line_range.found
        # An explicit bracket right after the name wins; nothing is inferred.
        explicit_index: usize = line_range.start + 2
        return if explicit_index < line_range.stop and tokens[explicit_index].kind == Lexer::TokenKind.LBracket
        emitted_any: mutable bool = false
        paren_depth: mutable i64 = 0
        segment_has_container: mutable bool = false
        segment_has_amp: mutable bool = false
        segment_name: mutable sview = ""
        segment_named: mutable bool = false
        segment_darray: mutable bool = false
        for param_index in line_range.start..<line_range.stop |paren_depth, segment_has_container, segment_has_amp, segment_name, segment_named, segment_darray, emitted_any, buffer, tokens, source, line|:
            param_token: Lexer::Token = tokens[param_index]
            if param_token.kind == Lexer::TokenKind.LParen or param_token.kind == Lexer::TokenKind.LBracket:
                paren_depth <- paren_depth + 1
            elif param_token.kind == Lexer::TokenKind.RParen or param_token.kind == Lexer::TokenKind.RBracket:
                paren_depth <- paren_depth - 1
                if paren_depth == 0 and segment_has_container and segment_has_amp and segment_named and emit_ast_param_grown_in_body(tokens, source, line, segment_name):
                    emit_tokens_push_sview(buffer, "[" if not emitted_any else ", ")
                    emit_tokens_push_sview(buffer, "@__rg_")
                    emit_tokens_push_sview(buffer, segment_name)
                    emitted_any <- true
                if paren_depth == 0:
                    # PAST the parameter list: without this reset the RETURN type's own
                    # closing bracket re-emitted the last segment (`[@__rg_sb, @__rg_sb]`).
                    segment_has_container <- false
                    segment_has_amp <- false
                    segment_named <- false
                    segment_darray <- false
            elif paren_depth >= 1:
                if param_token.kind == Lexer::TokenKind.Comma and paren_depth == 1:
                    if segment_has_container and segment_has_amp and segment_named and emit_ast_param_grown_in_body(tokens, source, line, segment_name):
                        emit_tokens_push_sview(buffer, "[" if not emitted_any else ", ")
                        emit_tokens_push_sview(buffer, "@__rg_")
                        emit_tokens_push_sview(buffer, segment_name)
                        emitted_any <- true
                    segment_has_container <- false
                    segment_has_amp <- false
                    segment_named <- false
                    segment_darray <- false
                elif param_token.kind == Lexer::TokenKind.Comma and paren_depth >= 2 and segment_darray:
                    # A comma INSIDE a darray's bracket is an explicit shape argument
                    # (`darray[u8, shape_in]`) — the region is already named; stage0
                    # infers nothing for this parameter.
                    segment_has_container <- false
                elif param_token.kind == Lexer::TokenKind.Ident:
                    param_text: sview = Lexer::text_or_empty(param_token, source)
                    if not segment_named:
                        segment_name <- param_text
                        segment_named <- true
                    if param_text == "darray" or param_text == "dict" or param_text == "set" or param_text == "dstr":
                        segment_has_container <- true
                        segment_darray <- param_text == "darray"
                elif param_token.kind == Lexer::TokenKind.Ampersand:
                    segment_has_amp <- true
        emit_tokens_push_sview(buffer, "]") if emitted_any


    # The `(args)` of a decorator printed above declaration LINE: scan the closest line above
    # it that starts with `@`, and render its paren span verbatim.
def emit_ast_decorator_args(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        best_line: mutable u32 = 0
        for at_probe in 0..<tokens.count |best_line, tokens, line|:
            at_token: Lexer::Token = tokens[at_probe]
            continue if at_token.kind != Lexer::TokenKind.At
            best_line <- at_token.line if at_token.line < line and at_token.line > best_line
        return if best_line == 0
        at_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, best_line)
        return if not at_range.found
        open_index: mutable usize = at_range.start
        open_found: mutable bool = false
        for open_probe in at_range.start..<at_range.stop |open_index, open_found, tokens|:
            continue if open_found
            if tokens[open_probe].kind == Lexer::TokenKind.LParen:
                open_index <- open_probe
                open_found <- true
        return if not open_found
        emit_ast_render_tokens(buffer, tokens, source, open_index, at_range.stop)


def emit_ast_indent(buffer: mutable darray[u8]&, level: i64) -> void can[Abort.Panic, Memory.Allocate]:
    for indent_index in 0..<(level * 2) |buffer|:
        buffer.push(32)


def emit_ast_decl(buffer: mutable darray[u8]&, declaration: Ast::Decl, level: i64, tokens: darray[Lexer::Token]&, source: u8&, annotations: darray[Ast::LocalRegionAnnotation]&, struct_names: darray[sview]&, struct_member_rows: darray[Ast::StructMember]&, struct_member_starts: darray[usize]&, struct_member_counts: darray[usize]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        if declaration is Decl.Func(ast_fn_name, ast_fn_params, ast_fn_return, ast_fn_body, ast_fn_effects, ast_fn_decorators, ast_fn_line):
            emit_ast_indent(buffer, level)
            emit_tokens_push_sview(buffer, "def ")
            emit_tokens_push_sview(buffer, ast_fn_name)
            emit_ast_generic_segment(buffer, tokens, source, ast_fn_line)
            emit_ast_inferred_region_params(buffer, tokens, source, ast_fn_line)
            emit_tokens_push_sview(buffer, "(")
            emit_tokens_push_u64(buffer, ast_fn_params.count.u64())
            emit_tokens_push_sview(buffer, " params)")
            emit_ast_return_segment(buffer, tokens, source, ast_fn_line)
            emit_tokens_push_sview(buffer, " (")
            wrapped_count: u64 = 1 if emit_ast_body_declares_container(ast_fn_body, annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts) else ast_fn_body.count.u64()
            emit_tokens_push_u64(buffer, wrapped_count)
            emit_tokens_push_sview(buffer, " stmts)\n")
            return
        if declaration is Decl.Struct(ast_st_name, ast_st_members, ast_st_affinity, ast_st_states, ast_st_derive, ast_st_invariants, ast_st_line):
            emit_ast_indent(buffer, level)
            emit_tokens_push_sview(buffer, "affine ") if ast_st_affinity == "affine"
            emit_tokens_push_sview(buffer, "struct ")
            emit_tokens_push_sview(buffer, ast_st_name)
            emit_ast_generic_segment(buffer, tokens, source, ast_st_line)
            emit_tokens_push_sview(buffer, " (")
            emit_tokens_push_u64(buffer, ast_st_members.count.u64())
            emit_tokens_push_sview(buffer, " fields)\n")
            return
        # A CONST enum gets a line; a PLAIN enum gets none. Measured against stage0 on a file
        # holding both: it prints `const enum FD of int: (2 members)` for the const one and
        # NOTHING for `enum Plain`, though both count toward the "(N declarations)" header. The
        # storage head comes from the declaration line's tokens — the node keeps the name, not
        # the source spelling.
        if declaration is Decl.Enum(ast_en_name, ast_en_variants, ast_en_const, ast_en_storage, ast_en_line):
            return if not ast_en_const
            emit_ast_indent(buffer, level)
            emit_tokens_push_sview(buffer, "const enum ")
            emit_tokens_push_sview(buffer, ast_en_name)
            emit_tokens_push_sview(buffer, " of ")
            # `storage_type` is an Expr, not a name — a const enum's head is always a scalar
            # type name, so the Ident is the spelling stage0 prints.
            if ast_en_storage is Expr.Ident(ast_en_storage_name, ast_en_storage_line):
                emit_tokens_push_sview(buffer, ast_en_storage_name)
            emit_tokens_push_sview(buffer, ": (")
            emit_tokens_push_u64(buffer, ast_en_variants.count.u64())
            emit_tokens_push_sview(buffer, " members)\n")
            return
        if declaration is Decl.Alias(ast_al_name, ast_al_target, ast_al_line):
            emit_ast_indent(buffer, level)
            emit_tokens_push_sview(buffer, "type ")
            emit_tokens_push_sview(buffer, ast_al_name)
            emit_tokens_push_sview(buffer, " = ")
            emit_ast_alias_target(buffer, tokens, source, ast_al_line)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Import(ast_im_module, ast_im_line):
            emit_ast_indent(buffer, level)
            emit_tokens_push_sview(buffer, "using ")
            emit_tokens_push_sview(buffer, ast_im_module)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Module(ast_mod_name, ast_mod_body, ast_mod_line):
            emit_ast_indent(buffer, level)
            emit_tokens_push_sview(buffer, "module ")
            # stage0 renders a nested module path with DOTS (`module Outer.Inner:`).
            for mod_name_index in 0..<sview_len(ast_mod_name) |buffer, ast_mod_name|:
                mod_byte: u8 = sview_at(ast_mod_name, mod_name_index)
                if mod_byte == 58:
                    buffer.push(46) if mod_name_index + 1 < sview_len(ast_mod_name) and sview_at(ast_mod_name, mod_name_index + 1) != 58 or mod_name_index > 0 and sview_at(ast_mod_name, mod_name_index - 1) == 58
                else:
                    buffer.push(mod_byte)
            emit_tokens_push_sview(buffer, ": (")
            emit_tokens_push_u64(buffer, ast_mod_body.count.u64())
            emit_tokens_push_sview(buffer, " decls)\n")
            for ast_mod_child in ast_mod_body |buffer, level, tokens, source|:
                emit_ast_decl(buffer, ast_mod_child, level + 1, tokens, source, annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
            return
        if declaration is Decl.Const(ast_c_name, ast_c_type, ast_c_value, ast_c_mutable, ast_c_line):
            # `const NAME = VALUE` / `global [mutable ]NAME: TYPE` — the whole source line in
            # normalized spelling (the gap renderer reproduces stage0's typeStr/exprStr on
            # canonical source), including the annotation past the clipped colon.
            const_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, ast_c_line)
            return if not const_range.found
            const_stop: mutable usize = const_range.stop
            while const_stop < tokens.count and tokens[const_stop].line == ast_c_line and tokens[const_stop].kind != Lexer::TokenKind.Newline |const_stop, tokens, ast_c_line|:
                const_stop <- const_stop + 1
            # stage0 renders these STRUCTURALLY rather than echoing the source line, and the two
            # keywords drop OPPOSITE halves — MEASURED:
            #     const J: i64 = 3        ->  const J = 3            (annotation dropped)
            #     global mutable g: i64 = 7  ->  global mutable g: i64  (initializer dropped)
            # Echoing the line matched only the unannotated `const K = 5`, which is why every
            # existing fixture agreed; a `global` with an initializer is what exposed it.
            const_eq: mutable usize = const_stop
            const_eq_found: mutable bool = false
            for eq_probe in const_range.start..<const_stop |const_eq, const_eq_found, tokens|:
                continue if const_eq_found
                if tokens[eq_probe].kind == Lexer::TokenKind.Assign:
                    const_eq <- eq_probe
                    const_eq_found <- true
            emit_ast_indent(buffer, level)
            if tokens[const_range.start].kind == Lexer::TokenKind.Global:
                emit_iface_render_tokens(buffer, tokens, source, const_range.start, const_eq)
                emit_tokens_push_sview(buffer, "\n")
                return
            emit_tokens_push_sview(buffer, "const ")
            emit_tokens_push_sview(buffer, ast_c_name)
            if const_eq_found:
                emit_tokens_push_sview(buffer, " = ")
                emit_iface_render_tokens(buffer, tokens, source, const_eq + 1, const_stop)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Extern(ast_ex_name, ast_ex_param_start, ast_ex_arity, ast_ex_variadic, ast_ex_callable, ast_ex_return, ast_ex_decorators, ast_ex_line):
            # `@link_name(sym)` prints on its own line first, exactly as written.
            for ast_ex_decorator in ast_ex_decorators |buffer, level, tokens, source, ast_ex_line|:
                emit_ast_indent(buffer, level)
                emit_tokens_push_sview(buffer, "@")
                emit_tokens_push_sview(buffer, ast_ex_decorator.name)
                emit_ast_decorator_args(buffer, tokens, source, ast_ex_line)
                emit_tokens_push_sview(buffer, "\n")
            emit_ast_indent(buffer, level)
            if not ast_ex_callable:
                # A bare `extern TypeName` is an opaque TYPE declaration.
                emit_tokens_push_sview(buffer, "extern type ")
                emit_tokens_push_sview(buffer, ast_ex_name)
                emit_tokens_push_sview(buffer, "\n")
                return
            emit_tokens_push_sview(buffer, "extern ")
            emit_tokens_push_sview(buffer, ast_ex_name)
            emit_tokens_push_sview(buffer, "(")
            emit_tokens_push_u64(buffer, ast_ex_arity.u64())
            emit_tokens_push_sview(buffer, " params)")
            emit_ast_return_segment(buffer, tokens, source, ast_ex_line)
            emit_tokens_push_sview(buffer, "\n")
            return
        # Enum: stage0's printer has no EnumDecl case — counted in the header, no line.
        # Law/Scoped/Invalid likewise print nothing at this summary level.
        return


def emit_ast_report(file: Ast::File&, tokens: darray[Lexer::Token]&, source: u8&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    buffer: mutable darray[u8] = []
    # `using X as Y` lives only in the annotation side tables (__using_alias_target rows
    # carry the TARGET module, which is what stage0 prints); it is a real declaration in
    # stage0's stream, so it joins the count and prints in line order among the decls.
    alias_targets: mutable darray[sview] = []
    alias_lines: mutable darray[u32] = []
    for using_annotation in file.enum_annotations |alias_targets, alias_lines, file|:
        if using_annotation.name == "__using_alias_target":
            alias_targets.push(using_annotation.owner)
            alias_lines.push(using_annotation.line)
        elif using_annotation.name == "__using":
            # An ALIASED using records both rows on nearby lines; only the bare form
            # contributes its own declaration. Skip a __using whose module already has an
            # alias-target row.
            using_is_aliased: mutable bool = false
            for alias_probe in file.enum_annotations |using_is_aliased, using_annotation|:
                using_is_aliased <- true if alias_probe.name == "__using_alias_target" and alias_probe.owner == using_annotation.owner
            if not using_is_aliased:
                alias_targets.push(using_annotation.owner)
                alias_lines.push(using_annotation.line)
    emit_tokens_push_sview(buffer, "File: ")
    emit_tokens_push_source_name(buffer)
    emit_tokens_push_sview(buffer, " (")
    emit_tokens_push_u64(buffer, (file.top_decls.count + alias_targets.count).u64())
    emit_tokens_push_sview(buffer, " declarations)\n")
    for ast_declaration in file.top_decls |buffer, tokens, source, alias_targets, alias_lines|:
        decl_line: u32 = ast_decl_line(ast_declaration)
        for alias_index in 0..<alias_targets.count |buffer, alias_targets, alias_lines, decl_line|:
            if alias_lines[alias_index] != 0 and alias_lines[alias_index] < decl_line:
                emit_tokens_push_sview(buffer, "using ")
                emit_tokens_push_sview(buffer, alias_targets[alias_index])
                emit_tokens_push_sview(buffer, "\n")
                alias_lines[alias_index] <- 0
        emit_ast_decl(buffer, ast_declaration, 0, tokens, source, file.local_region_annotations, file.struct_names, file.struct_member_rows, file.struct_member_starts, file.struct_member_counts)
    for alias_tail in 0..<alias_targets.count |buffer, alias_targets, alias_lines|:
        if alias_lines[alias_tail] != 0:
            emit_tokens_push_sview(buffer, "using ")
            emit_tokens_push_sview(buffer, alias_targets[alias_tail])
            emit_tokens_push_sview(buffer, "\n")
    return 0 if buffer.count == 0 else emit_tokens_flush(buffer)


# Does this unit declare any FUNCTION at all (directly, or inside a module / a `static if`
# branch)? A declaration-only unit — an enum, a const enum, a struct — has nothing for the
# backend to emit, and stage0 writes an (empty) object for it rather than failing. Without
# this, `emitted_count <= 0` read every such file as a codegen failure: MEASURED on 6 of the
# diagnostics fixtures (const_enum_value.neg, duplicate_variant_field.neg, …), which stage0
# accepts and stage1 exited 2 on. The guard stays for a unit that HAS a function and emitted
# none — that is the real failure, and what backend_native_smoke's decline cases assert.
def unit_declares_function(declarations: darray[Ast::Decl]) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        for declaration in declarations:
            if declaration is Decl.Func(udf_fn_name, udf_fn_params, udf_fn_ret, udf_fn_body, udf_fn_effects, udf_fn_decorators, udf_fn_line):
                return true
            if declaration is Decl.Module(udf_mod_name, udf_mod_body, udf_mod_line):
                true return if unit_declares_function(udf_mod_body)
            if declaration is Decl.Scoped(udf_sc_body, udf_sc_line):
                true return if unit_declares_function(udf_sc_body)
        return false


def ast_decl_line(declaration: Ast::Decl) -> u32 can[Abort.Panic, Memory.Allocate]:
    if declaration is Decl.Func(line_fn_name, line_fn_params, line_fn_ret, line_fn_body, line_fn_effects, line_fn_decorators, line_fn_line):
        return line_fn_line
    if declaration is Decl.Struct(line_st_name, line_st_members, line_st_aff, line_st_states, line_st_derive, line_st_inv, line_st_line):
        return line_st_line
    if declaration is Decl.Enum(line_en_name, line_en_variants, line_en_const, line_en_storage, line_en_line):
        return line_en_line
    if declaration is Decl.Alias(line_al_name, line_al_target, line_al_line):
        return line_al_line
    if declaration is Decl.Import(line_im_module, line_im_line):
        return line_im_line
    if declaration is Decl.Module(line_mod_name, line_mod_body, line_mod_line):
        return line_mod_line
    if declaration is Decl.Const(line_c_name, line_c_type, line_c_value, line_c_mut, line_c_line):
        return line_c_line
    if declaration is Decl.Extern(line_ex_name, line_ex_ps, line_ex_ar, line_ex_va, line_ex_call, line_ex_ret, line_ex_dec, line_ex_line):
        return line_ex_line
    return 4294967295


# ---- `-emit iface` (ELISA_STAGE1_EMIT=iface) ------------------------------------------
#
# stage0's public-interface summary: each declaration re-rendered in normalized source
# spelling — a def becomes an `extern` SIGNATURE (with stage0's inferred `@__rg_<param>`
# region woven into a growable ref param's type), a `global` becomes `extern NAME: T`,
# enum/error/struct declarations keep their indented bodies, and declarations are
# separated by single blank lines in source order. Everything renders from the
# declaration's line tokens (iface spacing: ": " after a colon, ", " after a comma,
# " -> " around an arrow) plus the same side-table merges the ast printer uses.

# SOURCE-GAP spacing: a single space wherever the source had whitespace between two
# tokens, nothing where it had none. On canonically formatted source this IS stage0's
# normalized spelling — commas read ", ", colons ": ", arrows " -> " — with no rule
# table to drift.
def emit_iface_render_tokens(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, from_index: usize, to_index: usize) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate:
        previous_end: mutable u32 = 0
        have_previous: mutable bool = false
        previous_forces_space: mutable bool = false
        previous_was_open: mutable bool = false
        for iface_index in from_index..<to_index |buffer, tokens, source, previous_end, have_previous, previous_forces_space, previous_was_open|:
            iface_token: Lexer::Token = tokens[iface_index]
            continue if iface_token.kind == Lexer::TokenKind.Newline or iface_token.kind == Lexer::TokenKind.Indent or iface_token.kind == Lexer::TokenKind.Dedent
            iface_text: sview = Lexer::text_or_empty(iface_token, source)
            # A colon or comma NORMALIZES to ": "/", " even when the source omitted the gap
            # (`begin:mutable` prints `begin: mutable`) — idempotent on canonical spelling.
            # No space directly inside brackets or before a separator — a line break's
            # whitespace collapsing into `( x` / `x )` would otherwise leak through.
            suppress_space: bool = previous_was_open or iface_token.kind == Lexer::TokenKind.RParen or iface_token.kind == Lexer::TokenKind.RBracket or iface_token.kind == Lexer::TokenKind.Comma
            buffer.push(32) if have_previous and not suppress_space and (iface_token.start > previous_end or previous_forces_space)
            emit_tokens_push_sview(buffer, iface_text)
            previous_end <- iface_token.start + iface_token.length
            have_previous <- true
            previous_forces_space <- iface_token.kind == Lexer::TokenKind.Colon or iface_token.kind == Lexer::TokenKind.Comma
            previous_was_open <- iface_token.kind == Lexer::TokenKind.LParen or iface_token.kind == Lexer::TokenKind.LBracket


    # The BODY token range of a block declaration whose header ends at header_stop: from the
    # Indent after the header's newline to the matching Dedent.
def emit_iface_body_range(tokens: darray[Lexer::Token]&, header_stop: usize) -> (found: bool, start: usize, stop: usize) can[Abort.Panic]:
    probe: mutable usize = header_stop
    depth: mutable i64 = 0
    start_index: mutable usize = 0
    started: mutable bool = false
    finished: mutable bool = false
    stop_index: mutable usize = header_stop
    while not finished and probe < tokens.count |probe, depth, start_index, started, finished, stop_index, tokens|:
        body_token: Lexer::Token = tokens[probe]
        if body_token.kind == Lexer::TokenKind.Indent:
            depth <- depth + 1
            if not started:
                start_index <- probe + 1
                started <- true
        elif body_token.kind == Lexer::TokenKind.Dedent:
            depth <- depth - 1
            if started and depth == 0:
                stop_index <- probe
                finished <- true
        elif started == false and body_token.kind != Lexer::TokenKind.Newline:
            # Content before any Indent: a single-line declaration, no body.
            finished <- true
        probe <- probe + 1
    (false, 0, 0) return if not started
    return (true, start_index, stop_index)


# Body lines at `indent` spaces: each Newline-separated token group renders on its own line.
def emit_iface_body_lines(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, start_index: usize, stop_index: usize, indent: i64) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        line_start: mutable usize = start_index
        cursor: mutable usize = start_index
        while cursor <= stop_index |line_start, cursor, buffer, tokens, source, indent, stop_index|:
            at_break: bool = cursor == stop_index or tokens[cursor].kind == Lexer::TokenKind.Newline
            if at_break:
                has_content: mutable bool = false
                for content_probe in line_start..<cursor |has_content, tokens|:
                    content_kind: Lexer::TokenKind = tokens[content_probe].kind
                    has_content <- true if content_kind != Lexer::TokenKind.Newline and content_kind != Lexer::TokenKind.Indent and content_kind != Lexer::TokenKind.Dedent
                if has_content:
                    for indent_space in 0..<indent |buffer|:
                        buffer.push(32)
                    emit_iface_render_tokens(buffer, tokens, source, line_start, cursor)
                    emit_tokens_push_sview(buffer, "\n")
                line_start <- cursor + 1
            cursor <- cursor + 1


    # One def rendered as its `extern` SIGNATURE. Generics render verbatim when explicit;
    # otherwise stage0's inferred region params both prefix the signature (`[@__rg_xs]`) and
    # weave into the growable ref parameter's own type (`... darray[i64] @__rg_xs&`).
def emit_iface_func(buffer: mutable darray[u8]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, indent: i64) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        emit_signature_line(buffer, "extern ", name, line, tokens, source, indent, false)


    # The shared def/extern signature renderer: KEYWORD + name + explicit-or-inferred
    # generics + woven params + return; `fmt` prints it as `def NAME(...)...:` while the
    # interface prints `extern NAME(...)...`.
    # `trailing_colon` doubles as the SURFACE selector: fmt (true) prints the signature's
    # `can[...]` effects clause as stage0's unparser does; the iface surface (false) drops it.
def emit_signature_line(buffer: mutable darray[u8]&, keyword: sview, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, indent: i64, trailing_colon: bool) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        line_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
        return if not line_range.found
        for indent_space in 0..<indent |buffer|:
            buffer.push(32)
        emit_tokens_push_sview(buffer, keyword)
        emit_tokens_push_sview(buffer, name)
        emit_ast_generic_segment(buffer, tokens, source, line)
        emit_ast_inferred_region_params(buffer, tokens, source, line)
        # Parameter span: the first depth-0 LParen after the name to its matching RParen.
        open_index: mutable usize = 0
        open_found: mutable bool = false
        bracket_depth: mutable i64 = 0
        for open_probe in line_range.start..<line_range.stop |open_index, open_found, bracket_depth, tokens|:
            open_kind: Lexer::TokenKind = tokens[open_probe].kind
            if open_kind == Lexer::TokenKind.LBracket:
                bracket_depth <- bracket_depth + 1
            elif open_kind == Lexer::TokenKind.RBracket:
                bracket_depth <- bracket_depth - 1
            elif open_kind == Lexer::TokenKind.LParen and bracket_depth == 0 and not open_found:
                open_index <- open_probe
                open_found <- true
        return if not open_found
        close_index: mutable usize = open_index
        close_depth: mutable i64 = 0
        closing: mutable bool = true
        while closing and close_index < line_range.stop |close_index, close_depth, closing, tokens|:
            close_kind: Lexer::TokenKind = tokens[close_index].kind
            close_depth <- close_depth + 1 if close_kind == Lexer::TokenKind.LParen
            close_depth <- close_depth - 1 if close_kind == Lexer::TokenKind.RParen
            if close_depth == 0:
                closing <- false
            else:
                close_index <- close_index + 1
        explicit_generics: bool = line_range.start + 2 < line_range.stop and tokens[line_range.start + 2].kind == Lexer::TokenKind.LBracket
        emit_tokens_push_sview(buffer, "(")
        emit_iface_params(buffer, tokens, source, open_index + 1, close_index, explicit_generics)
        emit_tokens_push_sview(buffer, ")")
        # Return segment with iface spacing: from a depth-0 Arrow after the params to the
        # trailing colon or a `can` effects clause.
        arrow_index: mutable usize = 0
        arrow_found: mutable bool = false
        for arrow_probe in close_index..<line_range.stop |arrow_index, arrow_found, tokens|:
            continue if arrow_found
            if tokens[arrow_probe].kind == Lexer::TokenKind.Arrow:
                arrow_index <- arrow_probe
                arrow_found <- true
        if not arrow_found:
            if trailing_colon:
                emit_signature_can_clause(buffer, tokens, source, close_index, line_range.stop)
                emit_tokens_push_sview(buffer, ":")
            return
        ret_stop: mutable usize = line_range.stop
        for ret_probe in (arrow_index + 1)..<line_range.stop |ret_stop, tokens, source|:
            ret_token: Lexer::Token = tokens[ret_probe]
            if ret_token.kind == Lexer::TokenKind.Ident and Lexer::text_or_empty(ret_token, source) == "can":
                ret_stop <- ret_probe if ret_probe < ret_stop
        emit_tokens_push_sview(buffer, " -> ")
        emit_iface_render_tokens(buffer, tokens, source, arrow_index + 1, ret_stop)
        if trailing_colon:
            emit_signature_can_clause(buffer, tokens, source, ret_stop, line_range.stop)
        emit_tokens_push_sview(buffer, ":") if trailing_colon


    # A signature's trailing effects clause (`can[E1, E2]`), rendered ` can[E1, E2]` when the
    # span holds one. Only the BRACKETED form is a signature clause; a depth-0 bare `can`
    # followed by anything else is not expected on a def line.
def emit_signature_can_clause(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, from_index: usize, to_index: usize) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        can_index: mutable usize = 0
        can_found: mutable bool = false
        for can_probe in from_index..<to_index |can_index, can_found, tokens, source|:
            continue if can_found
            can_token: Lexer::Token = tokens[can_probe]
            if can_token.kind == Lexer::TokenKind.Ident and Lexer::text_or_empty(can_token, source) == "can":
                can_index <- can_probe
                can_found <- true
        return if not can_found
        return if can_index + 1 >= to_index or tokens[can_index + 1].kind != Lexer::TokenKind.LBracket
        emit_tokens_push_sview(buffer, " ")
        emit_iface_render_tokens(buffer, tokens, source, can_index, to_index)


    # The parameter list, with stage0's inferred region woven in: a segment that holds a
    # container head and a trailing `&` (and no explicit generic bracket on the line) gets
    # ` @__rg_<param>` inserted before that `&`.
def emit_iface_params(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, from_index: usize, to_index: usize, explicit_generics: bool) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        segment_start: mutable usize = from_index
        cursor: mutable usize = from_index
        depth: mutable i64 = 0
        first_segment: mutable bool = true
        while cursor <= to_index |segment_start, cursor, depth, first_segment, buffer, tokens, source, to_index, explicit_generics|:
            seg_break: bool = cursor == to_index or (depth == 0 and tokens[cursor].kind == Lexer::TokenKind.Comma)
            if cursor < to_index:
                seg_kind: Lexer::TokenKind = tokens[cursor].kind
                depth <- depth + 1 if seg_kind == Lexer::TokenKind.LParen or seg_kind == Lexer::TokenKind.LBracket
                depth <- depth - 1 if seg_kind == Lexer::TokenKind.RParen or seg_kind == Lexer::TokenKind.RBracket
            if seg_break:
                if cursor > segment_start:
                    emit_tokens_push_sview(buffer, ", ") if not first_segment
                    first_segment <- false
                    emit_iface_param_segment(buffer, tokens, source, segment_start, cursor, explicit_generics)
                segment_start <- cursor + 1
            cursor <- cursor + 1


def emit_iface_param_segment(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, from_index: usize, to_index: usize, explicit_generics: bool) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        has_container: mutable bool = false
        amp_index: mutable usize = 0
        amp_found: mutable bool = false
        param_name: mutable sview = ""
        param_named: mutable bool = false
        for seg_probe in from_index..<to_index |has_container, amp_index, amp_found, param_name, param_named, tokens, source|:
            seg_token: Lexer::Token = tokens[seg_probe]
            if seg_token.kind == Lexer::TokenKind.Ident:
                seg_text: sview = Lexer::text_or_empty(seg_token, source)
                if not param_named:
                    param_name <- seg_text
                    param_named <- true
                has_container <- true if seg_text == "darray" or seg_text == "dict" or seg_text == "set" or seg_text == "dstr"
            elif seg_token.kind == Lexer::TokenKind.Ampersand:
                amp_index <- seg_probe
                amp_found <- true
        # Same body-growth gate as the signature-prefix weaver: the shape alone over-fires on
        # the std's explicit-arena helpers.
        weave: bool = has_container and amp_found and param_named and not explicit_generics and emit_ast_param_grown_in_body(tokens, source, tokens[from_index].line, param_name)
        if weave:
            emit_iface_render_tokens(buffer, tokens, source, from_index, amp_index)
            emit_tokens_push_sview(buffer, " @__rg_")
            emit_tokens_push_sview(buffer, param_name)
            emit_iface_render_tokens(buffer, tokens, source, amp_index, to_index)
        else:
            emit_iface_render_tokens(buffer, tokens, source, from_index, to_index)


def emit_iface_decl(buffer: mutable darray[u8]&, declaration: Ast::Decl, level: i64, tokens: darray[Lexer::Token]&, source: u8&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        indent: i64 = level * 4
        if declaration is Decl.Func(if_fn_name, if_fn_params, if_fn_ret, if_fn_body, if_fn_effects, if_fn_decorators, if_fn_line):
            emit_iface_func(buffer, if_fn_name, if_fn_line, tokens, source, indent)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Struct(if_st_name, if_st_members, if_st_aff, if_st_states, if_st_derive, if_st_inv, if_st_line):
            emit_iface_block_decl(buffer, tokens, source, if_st_line, indent)
            return
        if declaration is Decl.Enum(if_en_name, if_en_variants, if_en_const, if_en_storage, if_en_line):
            emit_iface_block_decl(buffer, tokens, source, if_en_line, indent)
            return
        if declaration is Decl.Const(if_c_name, if_c_type, if_c_value, if_c_mutable, if_c_line):
            for const_space in 0..<indent |buffer|:
                buffer.push(32)
            const_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, if_c_line)
            return if not const_range.found
            if if_c_mutable:
                # `global [mutable] NAME: T` presents as `extern NAME: T`.
                emit_tokens_push_sview(buffer, "extern ")
                emit_tokens_push_sview(buffer, if_c_name)
                # emit_ast_line_range CLIPS at the depth-0 colon, so the annotation lives
                # just past const_range.stop: scan from there to the physical line end.
                type_stop: mutable usize = const_range.stop + 1
                while type_stop < tokens.count and tokens[type_stop].line == if_c_line and tokens[type_stop].kind != Lexer::TokenKind.Newline and tokens[type_stop].kind != Lexer::TokenKind.Assign |type_stop, tokens, if_c_line|:
                    type_stop <- type_stop + 1
                return if const_range.stop >= tokens.count or tokens[const_range.stop].kind != Lexer::TokenKind.Colon
                emit_tokens_push_sview(buffer, ": ")
                emit_iface_render_tokens(buffer, tokens, source, const_range.stop + 1, type_stop)
                emit_tokens_push_sview(buffer, "\n")
                return
            emit_tokens_push_sview(buffer, "const ")
            emit_tokens_push_sview(buffer, if_c_name)
            emit_tokens_push_sview(buffer, " = ")
            eq_index: mutable usize = 0
            eq_found: mutable bool = false
            for eq_probe in const_range.start..<const_range.stop |eq_index, eq_found, tokens|:
                continue if eq_found
                if tokens[eq_probe].kind == Lexer::TokenKind.Assign:
                    eq_index <- eq_probe
                    eq_found <- true
            return if not eq_found
            emit_iface_render_tokens(buffer, tokens, source, eq_index + 1, const_range.stop)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Alias(if_al_name, if_al_target, if_al_line):
            for alias_space in 0..<indent |buffer|:
                buffer.push(32)
            emit_tokens_push_sview(buffer, "type ")
            emit_tokens_push_sview(buffer, if_al_name)
            emit_tokens_push_sview(buffer, " = ")
            emit_ast_alias_target(buffer, tokens, source, if_al_line)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Import(if_im_module, if_im_line):
            for import_space in 0..<indent |buffer|:
                buffer.push(32)
            emit_tokens_push_sview(buffer, "using ")
            emit_tokens_push_sview(buffer, if_im_module)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Extern(if_ex_name, if_ex_pstart, if_ex_arity, if_ex_variadic, if_ex_callable, if_ex_ret, if_ex_decorators, if_ex_line):
            ex_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, if_ex_line)
            return if not ex_range.found
            # `@link_name(sym)` prints above the signature, exactly as in the ast summary.
            for if_ex_decorator in if_ex_decorators |buffer, indent, tokens, source, if_ex_line|:
                for decorator_space in 0..<indent |buffer|:
                    buffer.push(32)
                emit_tokens_push_sview(buffer, "@")
                emit_tokens_push_sview(buffer, if_ex_decorator.name)
                emit_ast_decorator_args(buffer, tokens, source, if_ex_line)
                emit_tokens_push_sview(buffer, "\n")
            for extern_space in 0..<indent |buffer|:
                buffer.push(32)
            emit_iface_render_tokens(buffer, tokens, source, ex_range.start, ex_range.stop)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Module(if_mod_name, if_mod_body, if_mod_line):
            for module_space in 0..<indent |buffer|:
                buffer.push(32)
            emit_tokens_push_sview(buffer, "module ")
            for if_mod_index in 0..<sview_len(if_mod_name) |buffer, if_mod_name|:
                if_mod_byte: u8 = sview_at(if_mod_name, if_mod_index)
                if if_mod_byte == 58:
                    buffer.push(46) if if_mod_index + 1 < sview_len(if_mod_name) and sview_at(if_mod_name, if_mod_index + 1) != 58 or if_mod_index > 0 and sview_at(if_mod_name, if_mod_index - 1) == 58
                else:
                    buffer.push(if_mod_byte)
            emit_tokens_push_sview(buffer, ":\n")
            first_child: mutable bool = true
            for if_mod_child in if_mod_body |buffer, level, tokens, source, first_child|:
                emit_tokens_push_sview(buffer, "\n") if not first_child
                first_child <- false
                emit_iface_decl(buffer, if_mod_child, level + 1, tokens, source)
            return
        return


    # A header line plus its indented body, rendered verbatim (enum/error/struct keep their
    # bodies in the interface).
def emit_iface_block_decl(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32, indent: i64) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        header_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
        return if not header_range.found
        for header_space in 0..<indent |buffer|:
            buffer.push(32)
        emit_iface_render_tokens(buffer, tokens, source, header_range.start, header_range.stop)
        emit_tokens_push_sview(buffer, ":\n")
        body_range: (found: bool, start: usize, stop: usize) = emit_iface_body_range(tokens, header_range.stop + 1)
        return if not body_range.found
        emit_iface_body_lines(buffer, tokens, source, body_range.start, body_range.stop, indent + 4)


# `-emit c-bind-check` / `-emit c-bind-check-json` — stage0's C binding ABI verifier.
#
# For every `@c_bind("header.h", "CName")` struct it compares the ELISA layout (from LLVM's
# target data) against the REAL C layout, obtained by generating a probe that prints
# sizeof/_Alignof/offsetof, compiling it with `cc`, and running it. A size/align/offset
# disagreement is an ABI bug that no amount of source review finds.
#
# The Backend supplies the Elisa half as a line protocol (c_bind_layout_for_file); the
# driver owns the C half because it is the side that may write files and spawn processes.


# The Nth string literal on `line`, without quotes — `@c_bind("hdr.h", "CName")` yields
# "hdr.h" at 0 and "CName" at 1. The annotation ARGUMENTS are not kept on the
# EnumAnnotation row (it carries only owner/name/line), so they are recovered from tokens,
# the same way emit_ast_decorator_args recovers a decorator's argument text.
def cbind_string_arg(tokens: darray[Lexer::Token]&, source: u8&, line: u32, which: i64) -> sview can[Abort.Panic, Memory.Allocate]:
    seen: mutable i64 = 0
    for probe in 0..<tokens.count |seen, tokens, source, line, which|:
        continue if tokens[probe].line != line
        continue if tokens[probe].kind != Lexer::TokenKind.StringLit
        if seen == which:
            return Lexer::text_or_empty(tokens[probe], source)
        seen <- seen + 1
    return ""


# The optional trailing `prefix` flag on the decorator.
def cbind_has_prefix_flag(tokens: darray[Lexer::Token]&, source: u8&, line: u32) -> bool can[Abort.Panic, Memory.Allocate]:
    for probe in 0..<tokens.count |tokens, source, line|:
        continue if tokens[probe].line != line
        continue if tokens[probe].kind != Lexer::TokenKind.Ident
        true return if Lexer::text_or_empty(tokens[probe], source) == "prefix"
    return false


# A decimal integer starting at `start`, and the index just past it.
def cbind_parse_int(bytes: darray[u8]&, start: usize) -> (value: i64, stop: usize) can[Abort.Panic]:
    cursor: mutable usize = start
    value: mutable i64 = 0
    while cursor < bytes.count and bytes[cursor] >= 48 and bytes[cursor] <= 57 |cursor, value, bytes|:
        value <- value * 10 + (bytes[cursor] - 48).i64()
        cursor <- cursor + 1
    return (value, cursor)


# The next space- or newline-delimited field starting at `start`, as (start, stop, next).
def cbind_next_word(bytes: darray[u8]&, start: usize) -> (lo: usize, hi: usize, after: usize) can[Abort.Panic]:
    word_lo: mutable usize = start
    while word_lo < bytes.count and (bytes[word_lo] == 32 or bytes[word_lo] == 9) |word_lo, bytes|:
        word_lo <- word_lo + 1
    stop: mutable usize = word_lo
    while stop < bytes.count and bytes[stop] != 32 and bytes[stop] != 9 and bytes[stop] != 10 |stop, bytes|:
        stop <- stop + 1
    return (word_lo, stop, stop)


# Do the bytes in [begin, end) equal `text`?
def cbind_span_equals(data: darray[u8]&, span_lo: usize, span_hi: usize, wanted: sview) -> bool can[Abort.Panic]:
    false return if span_hi - span_lo != sview_len(wanted)
    for index in 0..<sview_len(wanted) |data, span_lo, wanted|:
        false return if data[span_lo + index] != sview_at(wanted, index)
    return true


def write_file_bytes(path: darray[u8]&, contents: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    path_c: mutable darray[u8] = []
    for index in 0..<path.count |path_c, path|:
        path_c.push(path[index])
    path_c.push(0)
    path_cstr: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
    descriptor: i64 = open(path_cstr, 1537, 420)
    false return if descriptor < 0
    if contents.count > 0:
        raw: void& = (&contents[0]).cast[void&] can Unsafe.PointerCast
        _ = write(descriptor, raw, contents.count)
    _ = close(descriptor)
    return true


def cbind_run(command: darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    command_c: mutable darray[u8] = []
    for index in 0..<command.count |command_c, command|:
        command_c.push(command[index])
    command_c.push(0)
    command_cstr: cstr = (&command_c[0]).cast[cstr] can Unsafe.PointerCast
    # system() answers a WAIT STATUS; the child's exit code is the high byte.
    return system(command_cstr) / 256


# One `printf` line of the probe, for a struct or one of its fields.
def cbind_probe_line(probe: mutable darray[u8]&, elisa_name: sview, c_name: sview, field: sview) -> void can[Abort.Panic, Memory.Allocate]:
    if sview_len(field) == 0:
        emit_tokens_push_sview(probe, "  printf(\"STRUCT %s %zu %zu\\n\", \"")
        emit_tokens_push_sview(probe, elisa_name)
        emit_tokens_push_sview(probe, "\", sizeof(")
        emit_tokens_push_sview(probe, c_name)
        emit_tokens_push_sview(probe, "), _Alignof(")
        emit_tokens_push_sview(probe, c_name)
        emit_tokens_push_sview(probe, "));\n")
        return
    emit_tokens_push_sview(probe, "  printf(\"FIELD %s %s %zu\\n\", \"")
    emit_tokens_push_sview(probe, elisa_name)
    emit_tokens_push_sview(probe, "\", \"")
    emit_tokens_push_sview(probe, field)
    emit_tokens_push_sview(probe, "\", offsetof(")
    emit_tokens_push_sview(probe, c_name)
    emit_tokens_push_sview(probe, ", ")
    emit_tokens_push_sview(probe, field)
    emit_tokens_push_sview(probe, "));\n")


def emit_c_bind_report(file: Ast::File&, tokens: darray[Lexer::Token]&, source: u8&, want_json: bool) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    owners: mutable darray[sview] = []
    lines: mutable darray[u32] = []
    # The `__c_bind_line` marker carries the DECORATOR's line, which is where its string
    # arguments live. The plain `c_bind` row records the STRUCT header line instead.
    for annotation in file.enum_annotations |owners, lines|:
        if annotation.name == "__c_bind_line":
            owners.push(annotation.owner)
            lines.push(annotation.line)

    if owners.count == 0:
        empty: mutable darray[u8] = []
        if want_json:
            emit_tokens_push_sview(&empty, "{\n  \"version\": 1,\n  \"target_triple\": \"\",\n  \"structs\": []\n}\n")
        else:
            emit_tokens_push_sview(&empty, "c-bind-check: no @c_bind structs\n")
        return emit_tokens_flush(empty)

    # ---- the ELISA half, from LLVM target data ----
    ctx: LLVMContextRef = LLVMContextCreate()
    module_handle: LLVMModuleRef = LLVMModuleCreateWithNameInContext("elisac_stage1_cbind", ctx)
    triple_storage: mutable darray[u8] = []
    machine: LLVMTargetMachineRef = Backend::configure_module_target_for(module_handle, requested_target_triple(&triple_storage))
    layout_data: LLVMTargetDataRef = LLVMCreateTargetDataLayout(machine)
    facts: darray[u8] = Backend::c_bind_layout_for_file(file, module_handle, ctx, layout_data)
    facts_base: cstr = (&facts[0]).cast[cstr] can Unsafe.PointerCast
    # ELISA_STAGE1_CBIND_FACTS=1 dumps the Backend's line protocol verbatim. The Elisa half
    # is the part with no external oracle — `cc` reports the C side for itself — so being
    # able to see it directly is what makes a layout disagreement debuggable.
    if env_flag_enabled("ELISA_STAGE1_CBIND_FACTS"):
        dump: mutable darray[u8] = []
        for dump_index in 0..<facts.count |dump, facts|:
            dump.push(facts[dump_index]) if facts[dump_index] != 0
        return emit_tokens_flush(dump)

    elisa_names: mutable darray[sview] = []
    elisa_sizes: mutable darray[i64] = []
    elisa_aligns: mutable darray[i64] = []
    field_owners: mutable darray[sview] = []
    field_names: mutable darray[sview] = []
    field_offsets: mutable darray[i64] = []
    cursor: mutable usize = 0
    while cursor < facts.count and facts[cursor] != 0 |cursor, facts, facts_base, elisa_names, elisa_sizes, elisa_aligns, field_owners, field_names, field_offsets|:
        kind: u8 = facts[cursor]
        name_word: (lo: usize, hi: usize, after: usize) = cbind_next_word(facts, cursor + 2)
        # sview(value, start, END) — the third argument is the END index, not a length.
        name_span: sview = sview(facts_base, name_word.lo.i64(), name_word.hi.i64())
        if kind == 83:
            size_word: (lo: usize, hi: usize, after: usize) = cbind_next_word(facts, name_word.after)
            size_value: (value: i64, stop: usize) = cbind_parse_int(facts, size_word.lo)
            align_word: (lo: usize, hi: usize, after: usize) = cbind_next_word(facts, size_word.after)
            align_value: (value: i64, stop: usize) = cbind_parse_int(facts, align_word.lo)
            elisa_names.push(name_span)
            elisa_sizes.push(size_value.value)
            elisa_aligns.push(align_value.value)
        elif kind == 70:
            field_word: (lo: usize, hi: usize, after: usize) = cbind_next_word(facts, name_word.after)
            field_span: sview = sview(facts_base, field_word.lo.i64(), field_word.hi.i64())
            offset_word: (lo: usize, hi: usize, after: usize) = cbind_next_word(facts, field_word.after)
            offset_value: (value: i64, stop: usize) = cbind_parse_int(facts, offset_word.lo)
            field_owners.push(name_span)
            field_names.push(field_span)
            field_offsets.push(offset_value.value)
        while cursor < facts.count and facts[cursor] != 10 and facts[cursor] != 0 |cursor, facts|:
            cursor <- cursor + 1
        cursor <- cursor + 1 if cursor < facts.count and facts[cursor] == 10

    # ---- the C half: generate a probe, compile it, run it ----
    work: mutable darray[u8] = []
    emit_tokens_push_sview(&work, "/tmp/elisa-cbind-stage1")
    make_directory(work)
    probe_path: darray[u8] = joined_path(work, "probe.c")
    binary_path: darray[u8] = joined_path(work, "probe")
    output_path: darray[u8] = joined_path(work, "probe.out")
    compile_log: darray[u8] = joined_path(work, "cc.log")

    probe: mutable darray[u8] = []
    emit_tokens_push_sview(&probe, "#include <stddef.h>\n#include <stdio.h>\n")
    # Each DISTINCT header once. Two `@c_bind` structs naming the same header emitted it
    # twice, which an UNGUARDED header answers with "typedef redefinition" — the guarded
    # fixture I first wrote hid this, and the gate's unguarded one caught it.
    seen_headers: mutable darray[sview] = []
    for include_index in 0..<owners.count |probe, owners, lines, tokens, source, seen_headers|:
        header_name: sview = cbind_string_arg(tokens, source, lines[include_index], 0)
        already: mutable bool = false
        for seen in seen_headers |already, header_name|:
            already <- true if seen == header_name
        continue if already
        seen_headers.push(header_name)
        emit_tokens_push_sview(&probe, "#include \"")
        emit_tokens_push_sview(&probe, header_name)
        emit_tokens_push_sview(&probe, "\"\n")
    emit_tokens_push_sview(&probe, "int main(void) {\n")
    for struct_index in 0..<owners.count |probe, owners, lines, tokens, source, field_owners, field_names|:
        c_name: sview = cbind_string_arg(tokens, source, lines[struct_index], 1)
        cbind_probe_line(&probe, owners[struct_index], c_name, "")
        for field_index in 0..<field_owners.count |probe, field_owners, field_names, owners, struct_index, c_name|:
            continue if field_owners[field_index] != owners[struct_index]
            cbind_probe_line(&probe, owners[struct_index], c_name, field_names[field_index])
    emit_tokens_push_sview(&probe, "  return 0;\n}\n")
    if not write_file_bytes(&probe_path, probe):
        failure: mutable darray[u8] = []
        emit_tokens_push_sview(&failure, "error: could not write the C binding probe\n")
        write_stderr(failure)
        return 1

    compile_command: mutable darray[u8] = []
    emit_tokens_push_sview(&compile_command, "cc ")
    for probe_index in 0..<probe_path.count |compile_command, probe_path|:
        compile_command.push(probe_path[probe_index])
    emit_tokens_push_sview(&compile_command, " -o ")
    for binary_index in 0..<binary_path.count |compile_command, binary_path|:
        compile_command.push(binary_path[binary_index])
    emit_tokens_push_sview(&compile_command, " > ")
    for log_index in 0..<compile_log.count |compile_command, compile_log|:
        compile_command.push(compile_log[log_index])
    emit_tokens_push_sview(&compile_command, " 2>&1")
    if cbind_run(compile_command) != 0:
        # stage0 reports the compiler's own diagnostics, which name the undeclared C type —
        # far more useful than "the check failed".
        failure: mutable darray[u8] = []
        emit_tokens_push_sview(&failure, "error: failed to compile C binding probe with cc\n")
        log_path_c: mutable darray[u8] = []
        for log_copy in 0..<compile_log.count |log_path_c, compile_log|:
            log_path_c.push(compile_log[log_copy])
        log_path_c.push(0)
        log_cstr: cstr = (&log_path_c[0]).cast[cstr] can Unsafe.PointerCast
        log_bytes: darray[u8] = read_file(log_cstr)
        for log_byte_index in 0..<log_bytes.count |failure, log_bytes|:
            failure.push(log_bytes[log_byte_index]) if log_bytes[log_byte_index] != 0
        write_stderr(failure)
        return 1

    run_command: mutable darray[u8] = []
    for binary_run in 0..<binary_path.count |run_command, binary_path|:
        run_command.push(binary_path[binary_run])
    emit_tokens_push_sview(&run_command, " > ")
    for out_index in 0..<output_path.count |run_command, output_path|:
        run_command.push(output_path[out_index])
    if cbind_run(run_command) != 0:
        failure: mutable darray[u8] = []
        emit_tokens_push_sview(&failure, "error: C binding probe did not run\n")
        write_stderr(failure)
        return 1

    output_path_c: mutable darray[u8] = []
    for out_copy in 0..<output_path.count |output_path_c, output_path|:
        output_path_c.push(output_path[out_copy])
    output_path_c.push(0)
    output_cstr: cstr = (&output_path_c[0]).cast[cstr] can Unsafe.PointerCast
    probe_output: darray[u8] = read_file(output_cstr)

    # ---- compare ----
    # C-side rows, parsed from the probe's stdout in the same shape as the Elisa facts.
    c_struct_sizes: mutable darray[i64] = []
    c_struct_aligns: mutable darray[i64] = []
    for _slot in 0..<owners.count |c_struct_sizes, c_struct_aligns|:
        c_struct_sizes.push(-1)
        c_struct_aligns.push(-1)
    c_field_offsets: mutable darray[i64] = []
    for _field_slot in 0..<field_owners.count |c_field_offsets|:
        c_field_offsets.push(-1)

    scan: mutable usize = 0
    while scan < probe_output.count and probe_output[scan] != 0 |scan, probe_output, owners, field_owners, field_names, c_struct_sizes, c_struct_aligns, c_field_offsets|:
        head: (lo: usize, hi: usize, after: usize) = cbind_next_word(probe_output, scan)
        is_struct: bool = cbind_span_equals(probe_output, head.lo, head.hi, "STRUCT")
        is_field: bool = cbind_span_equals(probe_output, head.lo, head.hi, "FIELD")
        if is_struct or is_field:
            owner_word: (lo: usize, hi: usize, after: usize) = cbind_next_word(probe_output, head.after)
            if is_struct:
                size_word: (lo: usize, hi: usize, after: usize) = cbind_next_word(probe_output, owner_word.after)
                size_value: (value: i64, stop: usize) = cbind_parse_int(probe_output, size_word.lo)
                align_word: (lo: usize, hi: usize, after: usize) = cbind_next_word(probe_output, size_word.after)
                align_value: (value: i64, stop: usize) = cbind_parse_int(probe_output, align_word.lo)
                for owner_index in 0..<owners.count |c_struct_sizes, c_struct_aligns, owners, probe_output, owner_word, size_value, align_value|:
                    continue if not cbind_span_equals(probe_output, owner_word.lo, owner_word.hi, owners[owner_index])
                    c_struct_sizes[owner_index] <- size_value.value
                    c_struct_aligns[owner_index] <- align_value.value
            else:
                field_word: (lo: usize, hi: usize, after: usize) = cbind_next_word(probe_output, owner_word.after)
                offset_word: (lo: usize, hi: usize, after: usize) = cbind_next_word(probe_output, field_word.after)
                offset_value: (value: i64, stop: usize) = cbind_parse_int(probe_output, offset_word.lo)
                for row_index in 0..<field_owners.count |c_field_offsets, field_owners, field_names, probe_output, owner_word, field_word, offset_value|:
                    continue if not cbind_span_equals(probe_output, owner_word.lo, owner_word.hi, field_owners[row_index])
                    continue if not cbind_span_equals(probe_output, field_word.lo, field_word.hi, field_names[row_index])
                    c_field_offsets[row_index] <- offset_value.value
        while scan < probe_output.count and probe_output[scan] != 10 and probe_output[scan] != 0 |scan, probe_output|:
            scan <- scan + 1
        scan <- scan + 1 if scan < probe_output.count and probe_output[scan] == 10

    # Every mismatch, in stage0's order: per struct, size then align then each field offset.
    problems: mutable darray[u8] = []
    for check_index in 0..<owners.count |problems, owners, elisa_names, elisa_sizes, elisa_aligns, c_struct_sizes, c_struct_aligns, field_owners, field_names, field_offsets, c_field_offsets|:
        name: sview = owners[check_index]
        elisa_slot: mutable i64 = -1
        for locate in 0..<elisa_names.count |elisa_slot, elisa_names, name|:
            elisa_slot <- locate.i64() if elisa_names[locate] == name
        continue if elisa_slot < 0
        elisa_size: i64 = elisa_sizes[elisa_slot.usize()]
        elisa_align: i64 = elisa_aligns[elisa_slot.usize()]
        if elisa_size != c_struct_sizes[check_index]:
            emit_tokens_push_sview(&problems, name)
            emit_tokens_push_sview(&problems, ": size mismatch Elisa=")
            append_decimal(&problems, elisa_size.u32())
            emit_tokens_push_sview(&problems, " C=")
            append_decimal(&problems, c_struct_sizes[check_index].u32())
            problems.push(10)
        if elisa_align != c_struct_aligns[check_index]:
            emit_tokens_push_sview(&problems, name)
            emit_tokens_push_sview(&problems, ": align mismatch Elisa=")
            append_decimal(&problems, elisa_align.u32())
            emit_tokens_push_sview(&problems, " C=")
            append_decimal(&problems, c_struct_aligns[check_index].u32())
            problems.push(10)
        for row in 0..<field_owners.count |problems, field_owners, field_names, field_offsets, c_field_offsets, name|:
            continue if field_owners[row] != name
            continue if field_offsets[row] == c_field_offsets[row]
            emit_tokens_push_sview(&problems, name)
            problems.push(46)
            emit_tokens_push_sview(&problems, field_names[row])
            emit_tokens_push_sview(&problems, ": offset mismatch Elisa=")
            append_decimal(&problems, field_offsets[row].u32())
            emit_tokens_push_sview(&problems, " C=")
            append_decimal(&problems, c_field_offsets[row].u32())
            problems.push(10)

    if problems.count > 0:
        failure: mutable darray[u8] = []
        emit_tokens_push_sview(&failure, "error: C binding layout check failed:\n")
        for problem_index in 0..<problems.count |failure, problems|:
            failure.push(problems[problem_index])
        write_stderr(failure)
        return 1

    report: mutable darray[u8] = []
    if want_json:
        emit_tokens_push_sview(&report, "{\n  \"version\": 1,\n  \"target_triple\": \"")
        emit_tokens_push_sview(&report, requested_target_triple(&triple_storage))
        emit_tokens_push_sview(&report, "\",\n  \"structs\": [\n")
        for json_index in 0..<owners.count |report, owners, lines, tokens, source, elisa_names, elisa_sizes, elisa_aligns, c_struct_sizes, c_struct_aligns, field_owners, field_names, field_offsets, c_field_offsets|:
            emit_tokens_push_sview(&report, ",\n") if json_index > 0
            name: sview = owners[json_index]
            elisa_slot: mutable i64 = -1
            for locate in 0..<elisa_names.count |elisa_slot, elisa_names, name|:
                elisa_slot <- locate.i64() if elisa_names[locate] == name
            emit_tokens_push_sview(&report, "    {\n      \"elisa_name\": \"")
            emit_tokens_push_sview(&report, name)
            emit_tokens_push_sview(&report, "\",\n      \"c_name\": \"")
            emit_tokens_push_sview(&report, cbind_string_arg(tokens, source, lines[json_index], 1))
            emit_tokens_push_sview(&report, "\",\n      \"header\": \"")
            emit_tokens_push_sview(&report, cbind_string_arg(tokens, source, lines[json_index], 0))
            emit_tokens_push_sview(&report, "\",\n      \"prefix\": ")
            emit_tokens_push_sview(&report, "true" if cbind_has_prefix_flag(tokens, source, lines[json_index]) else "false")
            emit_tokens_push_sview(&report, ",\n      \"elisa\": {\n        \"size\": ")
            append_decimal(&report, elisa_sizes[elisa_slot.usize()].u32())
            emit_tokens_push_sview(&report, ",\n        \"align\": ")
            append_decimal(&report, elisa_aligns[elisa_slot.usize()].u32())
            emit_tokens_push_sview(&report, "\n      },\n      \"c\": {\n        \"size\": ")
            append_decimal(&report, c_struct_sizes[json_index].u32())
            emit_tokens_push_sview(&report, ",\n        \"align\": ")
            append_decimal(&report, c_struct_aligns[json_index].u32())
            emit_tokens_push_sview(&report, "\n      },\n      \"fields\": [\n")
            first_field: mutable bool = true
            for row in 0..<field_owners.count |report, field_owners, field_names, field_offsets, c_field_offsets, name, first_field|:
                continue if field_owners[row] != name
                emit_tokens_push_sview(&report, ",\n") if not first_field
                first_field <- false
                emit_tokens_push_sview(&report, "        {\n          \"name\": \"")
                emit_tokens_push_sview(&report, field_names[row])
                emit_tokens_push_sview(&report, "\",\n          \"elisa_offset\": ")
                append_decimal(&report, field_offsets[row].u32())
                emit_tokens_push_sview(&report, ",\n          \"c_offset\": ")
                append_decimal(&report, c_field_offsets[row].u32())
                emit_tokens_push_sview(&report, "\n        }")
            emit_tokens_push_sview(&report, "\n      ]\n    }")
        emit_tokens_push_sview(&report, "\n  ]\n}\n")
    else:
        for text_index in 0..<owners.count |report, owners, lines, tokens, source, elisa_names, elisa_sizes, elisa_aligns, field_owners|:
            name: sview = owners[text_index]
            elisa_slot: mutable i64 = -1
            for locate in 0..<elisa_names.count |elisa_slot, elisa_names, name|:
                elisa_slot <- locate.i64() if elisa_names[locate] == name
            field_count: mutable u32 = 0
            for row in 0..<field_owners.count |field_count, field_owners, name|:
                field_count <- field_count + 1 if field_owners[row] == name
            emit_tokens_push_sview(&report, "c-bind-check: ")
            emit_tokens_push_sview(&report, name)
            emit_tokens_push_sview(&report, " matches ")
            emit_tokens_push_sview(&report, cbind_string_arg(tokens, source, lines[text_index], 1))
            emit_tokens_push_sview(&report, " from ")
            emit_tokens_push_sview(&report, cbind_string_arg(tokens, source, lines[text_index], 0))
            emit_tokens_push_sview(&report, " (size=")
            append_decimal(&report, elisa_sizes[elisa_slot.usize()].u32())
            emit_tokens_push_sview(&report, " align=")
            append_decimal(&report, elisa_aligns[elisa_slot.usize()].u32())
            emit_tokens_push_sview(&report, " fields=")
            append_decimal(&report, field_count)
            emit_tokens_push_sview(&report, ")\n")
    return emit_tokens_flush(report)


# `-emit unsafe` — stage0's unsafe_report.go: which functions hold which Unsafe.*
# capabilities, and which boundary invariants those capabilities put in force.
#
# The capability set is a TRANSITIVE CLOSURE, not a reading of each `can[...]` clause: a
# function calling an extern holds Unsafe.RawExtern without declaring it. The model below is
# validated against stage0 by test/parity/unsafe_permission_model_probe.py at 40/40 with
# ZERO over-claim, and it is entirely AST-decidable — no bounds prover, and nothing recorded
# into `table.diagnostics`, because a REQUIREMENT is not a VIOLATION (stage0 reports
# `Unsafe.UncheckedIndex` for a darray subscript while exiting 0).
#
#   1. declared Unsafe.* effects, from the signature AND in-body `can`/`trusted` clauses
#   2. every callable extern contributes Unsafe.RawExtern
#   3. transitive closure over the call graph
#   4. a bare subscript on a RUNTIME-LENGTH container (darray) needs Unsafe.UncheckedIndex,
#      unless the index is a binder proven against a `.count`
#   5. `(&xs[0]).cast[T]` needs Unsafe.BufferReinterpret


def unsafe_capability_at(index: i64) -> sview can[Abort.Panic]:
    "PointerCast" return if index == 0
    "PointerArithmetic" return if index == 1
    "IndirectCall" return if index == 2
    "UncheckedIndex" return if index == 3
    "RawExtern" return if index == 4
    "MutableGlobal" return if index == 5
    "ThreadShare" return if index == 6
    "StaleRef" return if index == 7
    "Alias" return if index == 8
    "BufferReinterpret" return if index == 9
    "Assembly" return if index == 10
    "ExecutableCodePublish" return if index == 11
    "GuestHostPointerCast" return if index == 12
    "PoisonPointerSentinel" return if index == 13
    "TinyPointerSentinel" return if index == 14
    "SegmentMutation" return if index == 15
    "GuestSegmentInstall" return if index == 16
    "CrossThreadSignalJump" return if index == 17
    "MachineCodeBuilder" return if index == 18
    "NonProgress" return if index == 19
    "BlockMain" return if index == 20
    "AssumeProgress" return if index == 21
    return ""


# Does `text` spell `Unsafe.<capability>`? Compared with an OFFSET rather than by slicing:
# sview has no slice operation, only sview_len/sview_at.
def unsafe_permission_is(text: sview, capability: sview) -> bool can[Abort.Panic]:
    false return if sview_len(text) != 7 + sview_len(capability)
    for prefix_index in 0..<7 |text|:
        false return if sview_at(text, prefix_index) != sview_at("Unsafe.", prefix_index)
    for member_index in 0..<sview_len(capability) |text, capability|:
        false return if sview_at(text, 7 + member_index) != sview_at(capability, member_index)
    return true


def unsafe_permission_is_unsafe(text: sview) -> bool can[Abort.Panic]:
    false return if sview_len(text) <= 7
    for prefix_index in 0..<7 |text|:
        false return if sview_at(text, prefix_index) != sview_at("Unsafe.", prefix_index)
    return true


def unsafe_name_less(a: sview, b: sview) -> bool can[Abort.Panic]:
    limit: usize = sview_len(a) if sview_len(a) < sview_len(b) else sview_len(b)
    for index in 0..<limit |a, b|:
        left: u8 = sview_at(a, index)
        right: u8 = sview_at(b, index)
        true return if left < right
        false return if left > right
    return sview_len(a) < sview_len(b)


# Add (owner, capability) unless already present.
def unsafe_add_row(owners: mutable darray[sview]&, caps: mutable darray[sview]&, owner: sview, cap: sview) -> void can[Abort.Panic, Memory.Allocate]:
    for existing in 0..<owners.count |owners, caps, owner, cap|:
        return if owners[existing] == owner and caps[existing] == cap
    owners.push(owner)
    caps.push(cap)


# One expression's contribution: rule 4 (bare subscript on a runtime-length container),
# rule 5 (`(&xs[0]).cast[T]`), and the CALL EDGES for the closure.
#
# `Expr.Index` is ALREADY the unchecked form — a `get x[i]` / `x[i] else v` parses to
# `Expr.GetElse`, a different node — so no textual disambiguation is needed.
def unsafe_scan_expression(expression: Ast::Expr, owner: sview, runtime_names: mutable darray[sview]&, proven: mutable darray[sview]&, owners: mutable darray[sview]&, caps: mutable darray[sview]&, call_from: mutable darray[sview]&, call_to: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        match expression:
            Expr.Index(us_object, us_index, us_line):
                # `p.cast[T]` parses as an INDEX whose object is `Field(p, "cast")`, so the
                # reinterpret rule lives here rather than in a Cast node (there is none).
                # `(&xs[0]).cast[T]` reinterprets the container's buffer.
                if us_object is Expr.Field(us_cast_base, us_cast_method, us_cast_line):
                    if us_cast_method == "cast":
                        if us_cast_base is Expr.Unary(us_amp_op, us_amp_operand, us_amp_line):
                            if us_amp_op == Lexer::TokenKind.Ampersand:
                                if us_amp_operand is Expr.Index(us_buf_object, us_buf_index, us_buf_line):
                                    us_buf_name: sview = unsafe_ident_name(us_buf_object)
                                    us_buf_runtime: mutable bool = false
                                    for runtime_name in runtime_names |us_buf_runtime, us_buf_name|:
                                        us_buf_runtime <- true if runtime_name == us_buf_name
                                    unsafe_add_row(owners, caps, owner, "Unsafe.BufferReinterpret") if us_buf_runtime
                us_object_name: sview = unsafe_ident_name(us_object)
                us_index_name: sview = unsafe_ident_name(us_index)
                us_is_runtime: mutable bool = false
                for runtime_name in runtime_names |us_is_runtime, us_object_name|:
                    us_is_runtime <- true if runtime_name == us_object_name
                us_index_proven: mutable bool = false
                for proven_name in proven |us_index_proven, us_index_name|:
                    us_index_proven <- true if proven_name == us_index_name
                unsafe_add_row(owners, caps, owner, "Unsafe.UncheckedIndex") if us_is_runtime and not us_index_proven
                unsafe_scan_expression(us_object, owner, runtime_names, proven, owners, caps, call_from, call_to)
                unsafe_scan_expression(us_index, owner, runtime_names, proven, owners, caps, call_from, call_to)
            Expr.Call(us_callee, us_arguments, us_argument_names, us_call_line):
                us_callee_name: sview = unsafe_ident_name(us_callee)
                if us_callee_name != "":
                    call_from.push(owner)
                    call_to.push(us_callee_name)
                unsafe_scan_expression(us_callee, owner, runtime_names, proven, owners, caps, call_from, call_to)
                for us_argument in us_arguments |owner, runtime_names, proven, owners, caps, call_from, call_to|:
                    unsafe_scan_expression(us_argument, owner, runtime_names, proven, owners, caps, call_from, call_to)
            Expr.Binary(us_left, us_op, us_right, us_bin_line):
                unsafe_scan_expression(us_left, owner, runtime_names, proven, owners, caps, call_from, call_to)
                unsafe_scan_expression(us_right, owner, runtime_names, proven, owners, caps, call_from, call_to)
            Expr.Unary(us_un_op, us_un_operand, us_un_line):
                unsafe_scan_expression(us_un_operand, owner, runtime_names, proven, owners, caps, call_from, call_to)
            Expr.Paren(us_paren_inner, us_paren_line):
                unsafe_scan_expression(us_paren_inner, owner, runtime_names, proven, owners, caps, call_from, call_to)
            Expr.Field(us_field_object, us_field_name, us_field_line):
                unsafe_scan_expression(us_field_object, owner, runtime_names, proven, owners, caps, call_from, call_to)
            Expr.If(us_if_then, us_if_cond, us_if_else, us_if_line):
                unsafe_scan_expression(us_if_then, owner, runtime_names, proven, owners, caps, call_from, call_to)
                unsafe_scan_expression(us_if_cond, owner, runtime_names, proven, owners, caps, call_from, call_to)
                unsafe_scan_expression(us_if_else, owner, runtime_names, proven, owners, caps, call_from, call_to)
            Expr.Block(us_blk_stmts, us_blk_value, us_blk_captures, us_blk_line):
                # A loop carrying a `|capture|` header lowers its BODY to a value block, so a
                # subscript inside `for i in 0..<n |xs|:` lives here and not under Stmt.For.
                # Without this arm every captured loop body was invisible to the scan.
                unsafe_scan_statements(us_blk_stmts, owner, runtime_names, proven, owners, caps, call_from, call_to)
                unsafe_scan_expression(us_blk_value, owner, runtime_names, proven, owners, caps, call_from, call_to)
            _:
                pass


def unsafe_ident_name(expression: Ast::Expr) -> sview can[Abort.Panic, Memory.Allocate]:
    if expression is Expr.Ident(us_id_name, us_id_line):
        return us_id_name
    return ""


# Is this annotation a RUNTIME-LENGTH container (`darray[T]`)? A fixed `array[T, N]` carries
# its extent in the type, so its subscripts can be proven.
def unsafe_is_runtime_length(type_expression: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        if type_expression is Expr.Index(us_rt_object, us_rt_index, us_rt_line):
            return unsafe_ident_name(us_rt_object) == "darray"
        if type_expression is Expr.IndexN(us_rtn_object, us_rtn_args, us_rtn_line):
            return unsafe_ident_name(us_rtn_object) == "darray"
        if type_expression is Expr.Unary(us_rt_op, us_rt_operand, us_rt_op_line):
            return unsafe_is_runtime_length(us_rt_operand)
        if type_expression is Expr.Paren(us_rt_inner, us_rt_paren_line):
            return unsafe_is_runtime_length(us_rt_inner)
        return false


# Walk a body: collect runtime-length locals, `.count`-proven binders, in-body grants, and
# every expression contribution.
def unsafe_scan_statements(statements: darray[Ast::Stmt], owner: sview, runtime_names: mutable darray[sview]&, proven: mutable darray[sview]&, owners: mutable darray[sview]&, caps: mutable darray[sview]&, call_from: mutable darray[sview]&, call_to: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        # Locals and binders FIRST, so a subscript earlier in the body still sees them.
        for statement in statements |runtime_names, proven|:
            if statement is Stmt.VarDecl(us_vd_name, us_vd_type, us_vd_value, us_vd_line):
                runtime_names.push(us_vd_name) if unsafe_is_runtime_length(us_vd_type)
            if statement is Stmt.For(us_for_bind, us_for_vars, us_for_iterable, us_for_body, us_for_line):
                # `for i in 0..<xs.count` proves `i` against the container's own length.
                # Recorded WITHOUT tying it to the container, which can only ever suppress a
                # report, never invent one — the direction that keeps over-claim at zero.
                if us_for_iterable is Expr.Binary(us_range_lo, us_range_op, us_range_hi, us_range_line):
                    if us_range_op == Lexer::TokenKind.RangeLt or us_range_op == Lexer::TokenKind.RangeLe:
                        if us_range_hi is Expr.Field(us_count_object, us_count_field, us_count_line):
                            if us_count_field == "count":
                                proven.push(us_for_bind) if us_for_bind != ""
                                for us_for_var in us_for_vars |proven|:
                                    proven.push(us_for_var)
        for statement in statements |owner, runtime_names, proven, owners, caps, call_from, call_to|:
            match statement:
                Stmt.VarDecl(us_s_name, us_s_type, us_s_value, us_s_line):
                    unsafe_scan_expression(us_s_value, owner, runtime_names, proven, owners, caps, call_from, call_to)
                Stmt.Expr(us_e_expression, us_e_line):
                    unsafe_scan_expression(us_e_expression, owner, runtime_names, proven, owners, caps, call_from, call_to)
                Stmt.Return(us_r_value, us_r_line):
                    if us_r_value is us_r_present:
                        unsafe_scan_expression(us_r_present, owner, runtime_names, proven, owners, caps, call_from, call_to)
                Stmt.Assign(us_a_target, us_a_operator, us_a_value, us_a_line):
                    unsafe_scan_expression(us_a_target, owner, runtime_names, proven, owners, caps, call_from, call_to)
                    unsafe_scan_expression(us_a_value, owner, runtime_names, proven, owners, caps, call_from, call_to)
                Stmt.If(us_i_condition, us_i_then, us_i_else, us_i_line):
                    unsafe_scan_expression(us_i_condition, owner, runtime_names, proven, owners, caps, call_from, call_to)
                    unsafe_scan_statements(us_i_then, owner, runtime_names, proven, owners, caps, call_from, call_to)
                    unsafe_scan_statements(us_i_else, owner, runtime_names, proven, owners, caps, call_from, call_to)
                Stmt.While(us_w_condition, us_w_body, us_w_line):
                    unsafe_scan_expression(us_w_condition, owner, runtime_names, proven, owners, caps, call_from, call_to)
                    unsafe_scan_statements(us_w_body, owner, runtime_names, proven, owners, caps, call_from, call_to)
                Stmt.For(us_f_bind, us_f_vars, us_f_iterable, us_f_body, us_f_line):
                    unsafe_scan_expression(us_f_iterable, owner, runtime_names, proven, owners, caps, call_from, call_to)
                    unsafe_scan_statements(us_f_body, owner, runtime_names, proven, owners, caps, call_from, call_to)
                Stmt.Block(us_b_kind, us_b_clause, us_b_binding, us_b_body, us_b_line):
                    # An in-body `can Unsafe.X:` / `trusted Unsafe.X:` grant names a capability
                    # the function HOLDS. Each clause entry is a whole dotted permission
                    # (parse_dotted_name), not split identifier tokens.
                    for us_b_grant in us_b_clause |owners, caps, owner|:
                        unsafe_add_row(owners, caps, owner, us_b_grant) if unsafe_permission_is_unsafe(us_b_grant)
                    unsafe_scan_statements(us_b_body, owner, runtime_names, proven, owners, caps, call_from, call_to)
                _:
                    pass


# Every function's DECLARED capabilities and its body's contributions.
def unsafe_collect_declarations(declarations: darray[Ast::Decl]&, export_markers: darray[sview]&, owners: mutable darray[sview]&, caps: mutable darray[sview]&, all_names: mutable darray[sview]&, call_from: mutable darray[sview]&, call_to: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        for declaration in declarations |owners, caps, all_names, call_from, call_to|:
            if declaration is Decl.Module(us_m_name, us_m_body, us_m_line):
                unsafe_collect_declarations(us_m_body, export_markers, owners, caps, all_names, call_from, call_to)
                continue
            if declaration is Decl.Scoped(us_sc_body, us_sc_line):
                unsafe_collect_declarations(us_sc_body, export_markers, owners, caps, all_names, call_from, call_to)
                continue
            if declaration is Decl.Extern(us_x_name, us_x_start, us_x_arity, us_x_variadic, us_x_callable, us_x_ret, us_x_decorators, us_x_line):
                # A callable extern carries Unsafe.RawExtern IMPLICITLY — stage0 reports it
                # for an `extern puts(...)` that declares no `can` clause at all.
                #
                # But `export fn name(...) = target` ALSO parses to Decl.Extern, and an EXPORT
                # is not a foreign import: it publishes an Elisa function under a C symbol and
                # calls nothing foreign. Counting those reported RawExtern: 4 for a unit with
                # four exports and no externs at all, where stage0 reports 0.
                continue if not us_x_callable
                us_x_is_export: mutable bool = false
                for us_x_annotation in export_markers |us_x_is_export, us_x_name|:
                    us_x_is_export <- true if us_x_annotation == us_x_name
                continue if us_x_is_export
                all_names.push(us_x_name)
                unsafe_add_row(owners, caps, us_x_name, "Unsafe.RawExtern")
                continue
            if declaration is Decl.Func(us_f_name, us_f_params, us_f_ret, us_f_body, us_f_effects, us_f_decorators, us_f_line):
                all_names.push(us_f_name)
                for us_f_effect in us_f_effects |owners, caps, us_f_name|:
                    unsafe_add_row(owners, caps, us_f_name, us_f_effect) if unsafe_permission_is_unsafe(us_f_effect)
                runtime_names: mutable darray[sview] = []
                proven: mutable darray[sview] = []
                for us_f_param in us_f_params |runtime_names|:
                    runtime_names.push(us_f_param.name) if unsafe_is_runtime_length(us_f_param.type_expression)
                unsafe_scan_statements(us_f_body, us_f_name, &runtime_names, &proven, owners, caps, call_from, call_to)


# Transitive closure: a caller holds everything its callees hold.
def unsafe_close_over_calls(owners: mutable darray[sview]&, caps: mutable darray[sview]&, call_from: darray[sview]&, call_to: darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    changed: mutable bool = true
    while changed |changed, owners, caps, call_from, call_to|:
        changed <- false
        for edge in 0..<call_from.count |changed, owners, caps, call_from, call_to|:
            caller: sview = call_from[edge]
            callee: sview = call_to[edge]
            for row in 0..<owners.count |changed, owners, caps, caller, callee|:
                continue if owners[row] != callee
                cap: sview = caps[row]
                present: mutable bool = false
                for probe in 0..<owners.count |present, owners, caps, caller, cap|:
                    present <- true if owners[probe] == caller and caps[probe] == cap
                if not present:
                    owners.push(caller)
                    caps.push(cap)
                    changed <- true


def unsafe_boundary_name(index: i64) -> sview can[Abort.Panic]:
    "GuestHostPointer" return if index == 0
    "ExecutableCodePublish" return if index == 1
    "MachineSegmentState" return if index == 2
    "TinyCallable" return if index == 3
    "ThreadAffineSignalJump" return if index == 4
    return ""


def unsafe_boundary_triggers(index: i64) -> sview can[Abort.Panic]:
    "PointerCast PointerArithmetic GuestHostPointerCast" return if index == 0
    "ExecutableCodePublish MachineCodeBuilder Assembly" return if index == 1
    "SegmentMutation GuestSegmentInstall" return if index == 2
    "IndirectCall PoisonPointerSentinel TinyPointerSentinel" return if index == 3
    "CrossThreadSignalJump ThreadShare" return if index == 4
    return ""


def unsafe_boundary_rule(index: i64, which: i64) -> sview can[Abort.Panic]:
    if index == 0:
        "guest addresses must resolve to a proven host/native-mapped pointer before dereference" return if which == 0
        "trace every guest-to-host address resolve with address, length, mapping, and result" return if which == 1
        return "debug/referee mode traps unresolved, unmapped, poison, or near-null address use"
    if index == 1:
        "runtime executable code must flow through a named publish primitive before call/jump" return if which == 0
        "trace publish address, size, protection, cache/publish result, and first execution" return if which == 1
        return "debug/referee mode halts execution of unpublished generated code"
    if index == 2:
        "segment register writes require an explicit restore/persistent contract" return if which == 0
        "trace every host/guest segment switch with thread id and selector" return if which == 1
        return "debug/referee mode asserts expected segment state at guest/host boundaries"
    if index == 3:
        "callable targets must not be poison or near-null unless explicitly marked sentinel" return if which == 0
        "trace every dynamic callable materialization with source slot/symbol provenance" return if which == 1
        return "debug/referee mode halts poison, non-canonical, or near-null call/jump targets"
    "signal-handler longjmp requires a thread-affine buffer or explicit cross-thread trust" return if which == 0
    "trace signal number, faulting thread, guard thread, and jump decision" return if which == 1
    return "referee mode refuses cross-thread longjmp and records a labeled boundary fault"


def unsafe_triggers_contain(haystack: sview, needle: sview) -> bool can[Abort.Panic]:
    start: mutable usize = 0
    while start < sview_len(haystack) |start, haystack, needle|:
        stop: mutable usize = start
        while stop < sview_len(haystack) and sview_at(haystack, stop) != 32 |stop, haystack|:
            stop <- stop + 1
        if stop - start == sview_len(needle):
            matched: mutable bool = true
            for probe in 0..<sview_len(needle) |matched, haystack, needle, start|:
                matched <- false if sview_at(haystack, start + probe) != sview_at(needle, probe)
            true return if matched
        start <- stop + 1
    return false


# STATEMENT-LEVEL grants, recovered from tokens: `x = expr can Unsafe.PointerCast`.
#
# A postfix `can` on a statement is not a `Stmt.Block` clause and the AST does not carry it
# (the formatter recovers it from tokens too), so it is scanned here and attributed to the
# enclosing function by LINE. Without it a unit whose only pointer cast is granted this way
# reported Unsafe.PointerCast: 0.
def unsafe_collect_token_grants(file: Ast::File&, tokens: darray[Lexer::Token]&, source: u8&, owners: mutable darray[sview]&, caps: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    # Function start lines, so a grant can be attributed to the function containing it.
    fn_names: mutable darray[sview] = []
    fn_lines: mutable darray[u32] = []
    for declaration in file.top_decls |fn_names, fn_lines|:
        if declaration is Decl.Func(ug_name, ug_params, ug_ret, ug_body, ug_effects, ug_decorators, ug_line):
            fn_names.push(ug_name)
            fn_lines.push(ug_line)
    return if fn_names.count == 0
    for probe in 0..<tokens.count |owners, caps, tokens, source, fn_names, fn_lines|:
        continue if tokens[probe].kind != Lexer::TokenKind.Ident
        continue if Lexer::text_or_empty(tokens[probe], source) != "can"
        # `can Unsafe.X` — an Ident "Unsafe", a Dot, then the capability name.
        continue if probe + 3 >= tokens.count
        continue if Lexer::text_or_empty(tokens[probe + 1], source) != "Unsafe"
        continue if tokens[probe + 2].kind != Lexer::TokenKind.Dot
        member: sview = Lexer::text_or_empty(tokens[probe + 3], source)
        continue if member == ""
        # The enclosing function is the one with the greatest start line at or before this.
        best: mutable sview = ""
        best_line: mutable u32 = 0
        for candidate in 0..<fn_names.count |best, best_line, fn_names, fn_lines, tokens, probe|:
            continue if fn_lines[candidate] > tokens[probe].line
            if best == "" or fn_lines[candidate] >= best_line:
                best <- fn_names[candidate]
                best_line <- fn_lines[candidate]
        continue if best == ""
        # Rebuild the dotted spelling; the pool holds whole permissions elsewhere.
        for capability_index in 0..<22 |owners, caps, best, member|:
            capability: sview = unsafe_capability_at(capability_index)
            continue if capability != member
            unsafe_add_row(owners, caps, best, unsafe_dotted_capability(capability_index))


# The `Unsafe.<capability>` spelling for a capability index, as a stable sview.
def unsafe_dotted_capability(index: i64) -> sview can[Abort.Panic]:
    "Unsafe.PointerCast" return if index == 0
    "Unsafe.PointerArithmetic" return if index == 1
    "Unsafe.IndirectCall" return if index == 2
    "Unsafe.UncheckedIndex" return if index == 3
    "Unsafe.RawExtern" return if index == 4
    "Unsafe.MutableGlobal" return if index == 5
    "Unsafe.ThreadShare" return if index == 6
    "Unsafe.StaleRef" return if index == 7
    "Unsafe.Alias" return if index == 8
    "Unsafe.BufferReinterpret" return if index == 9
    "Unsafe.Assembly" return if index == 10
    "Unsafe.ExecutableCodePublish" return if index == 11
    "Unsafe.GuestHostPointerCast" return if index == 12
    "Unsafe.PoisonPointerSentinel" return if index == 13
    "Unsafe.TinyPointerSentinel" return if index == 14
    "Unsafe.SegmentMutation" return if index == 15
    "Unsafe.GuestSegmentInstall" return if index == 16
    "Unsafe.CrossThreadSignalJump" return if index == 17
    "Unsafe.MachineCodeBuilder" return if index == 18
    "Unsafe.NonProgress" return if index == 19
    "Unsafe.BlockMain" return if index == 20
    "Unsafe.AssumeProgress" return if index == 21
    return ""


def build_unsafe_report(file: Ast::File&, tokens: darray[Lexer::Token]&, source: u8&) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    owners: mutable darray[sview] = []
    caps: mutable darray[sview] = []
    all_names: mutable darray[sview] = []
    call_from: mutable darray[sview] = []
    call_to: mutable darray[sview] = []
    # `export fn` shares Decl.Extern with a real foreign import; the `__export_fn` marker is
    # what tells them apart.
    export_markers: mutable darray[sview] = []
    for export_annotation in file.enum_annotations |export_markers|:
        export_markers.push(export_annotation.owner) if export_annotation.name == "__export_fn"
    unsafe_collect_declarations(file.top_decls, export_markers, &owners, &caps, &all_names, &call_from, &call_to)
    unsafe_collect_token_grants(file, tokens, source, &owners, &caps)
    unsafe_close_over_calls(&owners, &caps, call_from, call_to)

    buffer: mutable darray[u8] = []
    emit_tokens_push_sview(&buffer, "=== unsafe ===\ntotal: ")
    append_decimal(&buffer, owners.count.u32())
    emit_tokens_push_sview(&buffer, "\ncapabilities:\n")
    for capability_index in 0..<22 |buffer, caps|:
        capability: sview = unsafe_capability_at(capability_index)
        count: mutable u32 = 0
        for cap in caps |count, capability|:
            count <- count + 1 if unsafe_permission_is(cap, capability)
        emit_tokens_push_sview(&buffer, "  Unsafe.")
        emit_tokens_push_sview(&buffer, capability)
        emit_tokens_push_sview(&buffer, ": ")
        append_decimal(&buffer, count)
        buffer.push(10)

    active_any: mutable bool = false
    for boundary_probe in 0..<5 |active_any, caps|:
        for cap in caps |active_any, boundary_probe|:
            for capability_index in 0..<22 |active_any, cap, boundary_probe|:
                capability: sview = unsafe_capability_at(capability_index)
                continue if not unsafe_permission_is(cap, capability)
                active_any <- true if unsafe_triggers_contain(unsafe_boundary_triggers(boundary_probe), capability)
    if not active_any:
        emit_tokens_push_sview(&buffer, "boundary-invariants: none\n")
    else:
        emit_tokens_push_sview(&buffer, "boundary-invariants:\n")
        for boundary_index in 0..<5 |buffer, caps|:
            boundary_active: mutable bool = false
            for cap in caps |boundary_active, boundary_index|:
                for capability_index in 0..<22 |boundary_active, cap, boundary_index|:
                    capability: sview = unsafe_capability_at(capability_index)
                    continue if not unsafe_permission_is(cap, capability)
                    boundary_active <- true if unsafe_triggers_contain(unsafe_boundary_triggers(boundary_index), capability)
            continue if not boundary_active
            emit_tokens_push_sview(&buffer, "  ")
            emit_tokens_push_sview(&buffer, unsafe_boundary_name(boundary_index))
            emit_tokens_push_sview(&buffer, ":\n    static: ")
            emit_tokens_push_sview(&buffer, unsafe_boundary_rule(boundary_index, 0))
            emit_tokens_push_sview(&buffer, "\n    trace: ")
            emit_tokens_push_sview(&buffer, unsafe_boundary_rule(boundary_index, 1))
            emit_tokens_push_sview(&buffer, "\n    runtime: ")
            emit_tokens_push_sview(&buffer, unsafe_boundary_rule(boundary_index, 2))
            buffer.push(10)

    if owners.count == 0:
        emit_tokens_push_sview(&buffer, "functions: none\n")
    else:
        emit_tokens_push_sview(&buffer, "functions:\n")
        emitted: mutable darray[sview] = []
        for _round in 0..<owners.count |buffer, owners, caps, emitted|:
            best: mutable sview = ""
            found: mutable bool = false
            for candidate in 0..<owners.count |best, found, owners, emitted|:
                name: sview = owners[candidate]
                already: mutable bool = false
                for done in emitted |already, name|:
                    already <- true if done == name
                continue if already
                if not found or unsafe_name_less(name, best):
                    best <- name
                    found <- true
            break if not found
            emitted.push(best)
            emit_tokens_push_sview(&buffer, "  ")
            emit_tokens_push_sview(&buffer, best)
            emit_tokens_push_sview(&buffer, ": ")
            # ALPHABETICAL by dotted name, which is how stage0 prints a function's list —
            # NOT the capability-table order used for the `capabilities:` block above.
            first: mutable bool = true
            shown: mutable darray[sview] = []
            for _permission_round in 0..<owners.count |buffer, owners, caps, best, first, shown|:
                pick: mutable sview = ""
                picked: mutable bool = false
                for row in 0..<owners.count |pick, picked, owners, caps, best, shown|:
                    continue if owners[row] != best
                    candidate: sview = caps[row]
                    already: mutable bool = false
                    for done in shown |already, candidate|:
                        already <- true if done == candidate
                    continue if already
                    if not picked or unsafe_name_less(candidate, pick):
                        pick <- candidate
                        picked <- true
                break if not picked
                shown.push(pick)
                emit_tokens_push_sview(&buffer, ", ") if not first
                first <- false
                emit_tokens_push_sview(&buffer, pick)
            buffer.push(10)

    emit_tokens_push_sview(&buffer, "trusted-total: 0\ntrusted: none\n")
    return buffer


# `-emit unsafe` writes the report built above; `-emit c-archive` writes the same bytes to
# its `<base>.unsafe.txt` sidecar.
def emit_unsafe_report(file: Ast::File&, tokens: darray[Lexer::Token]&, source: u8&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    report: darray[u8] = build_unsafe_report(file, tokens, source)
    return emit_tokens_flush(report)


# `-emit c-archive` — the C ABI delivery bundle: a static library plus its audit sidecars.
#
#   <base>.a               module object + the Elisa runtime, via `ar rcs`
#   <base>.h               the generated C header  (same generator as `-emit header`)
#   <base>.unsafe.txt      the capability audit    (same builder as `-emit unsafe`)
#   <base>.elisa-abi.json  a manifest naming all of the above
#
# stage0 runs the unsafe audit BEFORE writing anything, so a rejected program leaves no
# linkable artifact behind — its own comment records that emitting first meant a refused
# program still produced a complete `.a` that linked and ran.


# The exported entities, in declaration order, for the manifest.
def carchive_push_export_list(buffer: mutable darray[u8]&, file: Ast::File&, marker: sview) -> void can[Abort.Panic, Memory.Allocate]:
    first: mutable bool = true
    for annotation in file.enum_annotations |buffer, first, marker|:
        continue if annotation.name != marker
        emit_tokens_push_sview(buffer, ",") if not first
        emit_tokens_push_sview(buffer, "\n    \"")
        emit_tokens_push_sview(buffer, annotation.owner)
        buffer.push(34)
        first <- false
    emit_tokens_push_sview(buffer, "\n  ") if not first


# A shell-quoted path. Single quotes, so a space or a shell metacharacter in a directory
# name cannot split the argument.
def carchive_push_quoted(buffer: mutable darray[u8]&, path: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
    buffer.push(39)
    for index in 0..<path.count |buffer, path|:
        buffer.push(path[index])
    buffer.push(39)


def carchive_push_path(buffer: mutable darray[u8]&, path: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
    for index in 0..<path.count |buffer, path|:
        buffer.push(path[index])


# `<archive>.a` -> `<archive>` (stage0's cArchiveSidecarBase), the stem every sidecar hangs off.
def carchive_sidecar_base(out_path: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    base: mutable darray[u8] = []
    # The driver's out_path carries a TRAILING NUL (main appends one so the buffer can be
    # handed to C directly). Copying it into a derived path embeds a NUL mid-string, and
    # every command built from it truncates there — `ar rcs <archive>\0<member>` reached ar
    # as an archive with NO members.
    stop: mutable usize = out_path.count
    while stop > 0 and out_path[stop - 1] == 0 |stop, out_path|:
        stop <- stop - 1
    if stop >= 2 and out_path[stop - 2] == 46 and out_path[stop - 1] == 97:
        stop <- stop - 2
    for index in 0..<stop |base, out_path|:
        base.push(out_path[index])
    return base


# The Elisa runtime object to bundle, from ELISA_RUNTIME_OBJ. Empty when unset, in which
# case the archive holds the module object alone and the manifest says runtime_included:false.
def push_runtime_object_path(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag_storage: mutable darray[u8] = []
    for flag_index in 0..<sview_len("ELISA_RUNTIME_OBJ") |flag_storage|:
        flag_storage.push(sview_at("ELISA_RUNTIME_OBJ", flag_index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is runtime_bytes:
        cursor: mutable i64 = 0
        scanning: mutable bool = true
        while scanning |cursor, scanning, buffer, runtime_bytes|:
            byte_ref: u8& = runtime_bytes + cursor
            runtime_byte: u8 = byte_ref
            if runtime_byte == 0:
                scanning <- false
            else:
                buffer.push(runtime_byte)
                cursor <- cursor + 1


def emit_c_archive(file: Ast::File&, tokens: darray[Lexer::Token]&, source: u8&, out_path: darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    base: darray[u8] = carchive_sidecar_base(out_path)
    header_path: mutable darray[u8] = []
    carchive_push_path(&header_path, base)
    emit_tokens_push_sview(&header_path, ".h")
    unsafe_path: mutable darray[u8] = []
    carchive_push_path(&unsafe_path, base)
    emit_tokens_push_sview(&unsafe_path, ".unsafe.txt")
    manifest_path: mutable darray[u8] = []
    carchive_push_path(&manifest_path, base)
    emit_tokens_push_sview(&manifest_path, ".elisa-abi.json")

    # AUDIT FIRST — nothing is written until the header can be generated, so a unit with an
    # exported type that has no C ABI form leaves no half-built archive.
    guard: mutable darray[u8] = []
    push_header_guard(&guard)
    guard.push(0)
    header_ctx: LLVMContextRef = LLVMContextCreate()
    header_module: LLVMModuleRef = LLVMModuleCreateWithNameInContext("elisac_stage1_archive_header", header_ctx)
    # The cast is its OWN statement: an inline `.cast[T] can Effect` inside an argument list
    # does not parse in this dialect.
    guard_cstr: cstr = (&guard[0]).cast[cstr] can Unsafe.PointerCast
    header_bytes: darray[u8] = Backend::generate_c_header_for_file(file, header_module, header_ctx, sview(guard_cstr, 0, guard.count - 1))
    if header_bytes.count == 0:
        message: mutable darray[u8] = []
        emit_tokens_push_sview(&message, "error: -emit c-archive: an exported type has no C ABI representation\n")
        write_stderr(message)
        return 1

    # The module object, beside the archive so the temporary shares its filesystem.
    # `ar` records a member by its BASENAME, so the object must literally be named
    # `elisacore_module.o` — writing `<base>.elisacore_module.o` beside the archive produced a
    # member called `lib.elisacore_module.o`. stage0 uses a temp DIR for the same reason.
    work_dir: mutable darray[u8] = []
    emit_tokens_push_sview(&work_dir, "/tmp/elisa-c-archive-stage1")
    make_directory(work_dir)
    object_path: darray[u8] = joined_path(work_dir, "elisacore_module.o")
    _ = setenv("ELISA_STAGE1_OUT", "", 1)
    ctx: LLVMContextRef = LLVMContextCreate()
    module_handle: LLVMModuleRef = LLVMModuleCreateWithNameInContext("elisac_stage1", ctx)
    archive_builder: LLVMBuilderRef = LLVMCreateBuilderInContext(ctx)
    emitted: i64 = Backend::emit_module(file, module_handle, ctx, archive_builder)
    2 return if emitted <= 0 and unit_declares_function(file.top_decls)
    triple_storage: mutable darray[u8] = []
    machine: LLVMTargetMachineRef = Backend::configure_module_target_for(module_handle, requested_target_triple(&triple_storage))
    object_c: mutable darray[u8] = []
    carchive_push_path(&object_c, object_path)
    object_c.push(0)
    object_cstr: cstr = (&object_c[0]).cast[cstr] can Unsafe.PointerCast
    4 return if not Backend::emit_object(machine, module_handle, object_cstr)

    # `ar rcs <archive> <module.o> <runtime.o>` — the runtime object is the one the build
    # already produces for `-emit exe`.
    archive_command: mutable darray[u8] = []
    # Every path is QUOTED: this repo lives under a directory with a SPACE in its name
    # ("Coding Projects"), so an unquoted runtime path split into two ar arguments and the
    # archive gained a bogus member called `Coding`.
    emit_tokens_push_sview(&archive_command, "ar rcs ")
    archive_path: mutable darray[u8] = []
    for out_index in 0..<out_path.count |archive_path, out_path|:
        archive_path.push(out_path[out_index]) if out_path[out_index] != 0
    carchive_push_quoted(&archive_command, archive_path)
    archive_command.push(32)
    carchive_push_quoted(&archive_command, object_path)
    runtime_object: mutable darray[u8] = []
    push_runtime_object_path(&runtime_object)
    if runtime_object.count > 0:
        archive_command.push(32)
        carchive_push_quoted(&archive_command, runtime_object)
    if cbind_run(archive_command) != 0:
        message: mutable darray[u8] = []
        emit_tokens_push_sview(&message, "error: -emit c-archive: ar failed\n")
        write_stderr(message)
        return 1
    _ = unlink(object_cstr)

    header_body: mutable darray[u8] = []
    for index in 0..<header_bytes.count |header_body, header_bytes|:
        header_body.push(header_bytes[index]) if header_bytes[index] != 0
    _ = write_file_bytes(&header_path, header_body)
    unsafe_bytes: darray[u8] = build_unsafe_report(file, tokens, source)
    _ = write_file_bytes(&unsafe_path, unsafe_bytes)

    manifest: mutable darray[u8] = []
    emit_tokens_push_sview(&manifest, "{\n  \"source\": \"")
    _ = push_source_path(&manifest)
    emit_tokens_push_sview(&manifest, "\",\n  \"archive\": \"")
    carchive_push_path(&manifest, archive_path)
    emit_tokens_push_sview(&manifest, "\",\n  \"objects\": [\n    \"elisacore_module.o\"")
    emit_tokens_push_sview(&manifest, ",\n    \"elisacore_runtime.o\"") if runtime_object.count > 0
    emit_tokens_push_sview(&manifest, "\n  ],\n  \"runtime_included\": ")
    emit_tokens_push_sview(&manifest, "true" if runtime_object.count > 0 else "false")
    emit_tokens_push_sview(&manifest, ",\n  \"runtime_object\": \"elisacore_runtime.o\",\n  \"header_audit\": \"")
    carchive_push_path(&manifest, header_path)
    emit_tokens_push_sview(&manifest, "\",\n  \"unsafe_report\": \"")
    carchive_push_path(&manifest, unsafe_path)
    emit_tokens_push_sview(&manifest, "\",\n  \"exported_functions\": [")
    carchive_push_export_list(&manifest, file, "__export_fn")
    emit_tokens_push_sview(&manifest, "],\n  \"exported_globals\": [")
    carchive_push_export_list(&manifest, file, "__export_global")
    emit_tokens_push_sview(&manifest, "],\n  \"exported_types\": [")
    carchive_push_export_list(&manifest, file, "__export_type")
    emit_tokens_push_sview(&manifest, "],\n  \"generated_by\": \"elisacore -emit c-archive\",\n  \"abi_contract\": \"checked-in C/C++ headers are the build contract; generated headers are audit artifacts\"\n}\n")
    _ = write_file_bytes(&manifest_path, manifest)
    return 0


# `-emit progress` — stage0's progress/liveness report: per function, the loop obligations it
# carries and whether each is discharged.
#
# Every rule below was measured against stage0, not inferred:
#   * `obligations=Loop:N` counts WHILE loops only; a bounded `for i in 0..<3` contributes
#     nothing, being finite by construction.
#   * `evidence=progress` when EVERY while loop provably advances: the condition is
#     `var OP bound` with OP in {<, <=, >, >=} (NOT `!=`, measured), and the loop body
#     contains a TOP-LEVEL assignment moving `var` toward the bound (`n <- n + k` / `n += k`
#     for `<`, the `-` forms for `>`). An increment nested inside an `if` does NOT count.
#   * `evidence=unsafe-nonprogress` (and unsafe_nonprogress=true) inside
#     `trusted Unsafe.NonProgress`; `trusted Unsafe.BlockMain` sets unsafe_block_main.
#     A DECLARED `can[Unsafe.NonProgress]` does NOT — only the trusted form.
#   * `@main_thread` sets main_thread.
#   * a loop with no evidence emits a progress WARNING and bumps `warnings:`.
#
# `blocking` and `blocking_path` are emitted as false/none: they are false in ALL 56 corpus
# fixtures, so there is no witness to derive their rule from. That is recorded rather than
# guessed at — see the emit-mode-port-order memory.


# Does this while-loop condition name a variable compared against a bound, and if so which
# direction discharges it? 0: not a directional comparison. 1: `<`/`<=` (needs an increase).
# 2: `>`/`>=` (needs a decrease).
def progress_condition_direction(condition: Ast::Expr, name: mutable sview&) -> i64 can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        if condition is Expr.Binary(pc_left, pc_op, pc_right, pc_line):
            if pc_left is Expr.Ident(pc_name, pc_name_line):
                name <- pc_name
                1 return if pc_op == Lexer::TokenKind.Lt or pc_op == Lexer::TokenKind.LtEq
                2 return if pc_op == Lexer::TokenKind.Gt or pc_op == Lexer::TokenKind.GtEq
                return 0
        return 0


# Does `statements` contain a TOP-LEVEL assignment moving `name` in `direction`?
def progress_body_advances(statements: darray[Ast::Stmt], name: sview, direction: i64) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        for statement in statements |name, direction|:
            if statement is Stmt.Assign(pb_target, pb_operator, pb_value, pb_line):
                # The assignment must target the loop variable itself.
                pb_targets_name: mutable bool = false
                if pb_target is Expr.Ident(pb_target_name, pb_target_line):
                    pb_targets_name <- pb_target_name == name
                continue if not pb_targets_name
                # `n += k` / `n -= k`.
                true return if direction == 1 and pb_operator == Lexer::TokenKind.PlusEq
                true return if direction == 2 and pb_operator == Lexer::TokenKind.MinusEq
                # `n <- n + k` / `n <- n - k`.
                if pb_value is Expr.Binary(pv_left, pv_op, pv_right, pv_line):
                    pv_is_same: mutable bool = false
                    if pv_left is Expr.Ident(pv_name, pv_name_line):
                        pv_is_same <- pv_name == name
                    continue if not pv_is_same
                    true return if direction == 1 and pv_op == Lexer::TokenKind.Plus
                    true return if direction == 2 and pv_op == Lexer::TokenKind.Minus
        return false


# Count while loops and how many of them advance. `trusted` state is threaded so a loop
# inside `trusted Unsafe.NonProgress` is credited to that instead.
def progress_scan(statements: darray[Ast::Stmt], loops: mutable i64&, advancing: mutable i64&, in_nonprogress: bool, nonprogress_loops: mutable i64&) -> void can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        for statement in statements |loops, advancing, nonprogress_loops, in_nonprogress|:
            match statement:
                Stmt.While(ps_condition, ps_body, ps_line):
                    loops <- loops + 1
                    if in_nonprogress:
                        nonprogress_loops <- nonprogress_loops + 1
                    else:
                        ps_name: mutable sview = ""
                        ps_direction: i64 = progress_condition_direction(ps_condition, &ps_name)
                        if ps_direction != 0 and progress_body_advances(ps_body, ps_name, ps_direction):
                            advancing <- advancing + 1
                    progress_scan(ps_body, loops, advancing, in_nonprogress, nonprogress_loops)
                Stmt.If(pi_condition, pi_then, pi_else, pi_line):
                    progress_scan(pi_then, loops, advancing, in_nonprogress, nonprogress_loops)
                    progress_scan(pi_else, loops, advancing, in_nonprogress, nonprogress_loops)
                Stmt.For(pf_bind, pf_vars, pf_iterable, pf_body, pf_line):
                    progress_scan(pf_body, loops, advancing, in_nonprogress, nonprogress_loops)
                Stmt.Block(pb_kind, pb_clause, pb_binding, pb_body, pb_line):
                    pb_nonprogress: mutable bool = in_nonprogress
                    if pb_kind == "trusted":
                        for pb_grant in pb_clause |pb_nonprogress|:
                            pb_nonprogress <- true if pb_grant == "Unsafe.NonProgress"
                    progress_scan(pb_body, loops, advancing, pb_nonprogress, nonprogress_loops)
                Stmt.Expr(pe_expression, pe_line):
                    # A loop carrying a `|capture|` header lowers its BODY to a value block,
                    # so `while i < 2 |i|:` is reached through an expression rather than
                    # Stmt.While — the same lowering that hid subscripts from `-emit unsafe`.
                    if pe_expression is Expr.Block(pe_stmts, pe_value, pe_captures, pe_block_line):
                        progress_scan(pe_stmts, loops, advancing, in_nonprogress, nonprogress_loops)
                _:
                    pass


# Is a `trusted <permission>` block present anywhere in the body?
def progress_has_trusted(statements: darray[Ast::Stmt], permission: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        for statement in statements |permission|:
            if statement is Stmt.Block(pt_kind, pt_clause, pt_binding, pt_body, pt_line):
                if pt_kind == "trusted":
                    for pt_grant in pt_clause |permission|:
                        true return if pt_grant == permission
                true return if progress_has_trusted(pt_body, permission)
            if statement is Stmt.If(pt_cond, pt_then, pt_else, pt_if_line):
                true return if progress_has_trusted(pt_then, permission)
                true return if progress_has_trusted(pt_else, permission)
            if statement is Stmt.While(pt_wcond, pt_wbody, pt_w_line):
                true return if progress_has_trusted(pt_wbody, permission)
            if statement is Stmt.For(pt_bind, pt_vars, pt_iter, pt_fbody, pt_f_line):
                true return if progress_has_trusted(pt_fbody, permission)
        return false


# One function's summary line, and its warning count.
def progress_emit_function(buffer: mutable darray[u8]&, name: sview, body: darray[Ast::Stmt], decorators: darray[Ast::Annotation]&, warnings: mutable i64&) -> void can[Abort.Panic, Memory.Allocate]:
    loops: mutable i64 = 0
    advancing: mutable i64 = 0
    nonprogress_loops: mutable i64 = 0
    progress_scan(body, &loops, &advancing, false, &nonprogress_loops)
    emit_tokens_push_sview(buffer, "  ")
    emit_tokens_push_sview(buffer, name)
    emit_tokens_push_sview(buffer, ": obligations=")
    if loops == 0:
        emit_tokens_push_sview(buffer, "none")
    else:
        emit_tokens_push_sview(buffer, "Loop:")
        append_decimal(buffer, loops.u32())
    emit_tokens_push_sview(buffer, " evidence=")
    if nonprogress_loops > 0:
        emit_tokens_push_sview(buffer, "unsafe-nonprogress")
    elif loops > 0 and advancing == loops:
        emit_tokens_push_sview(buffer, "progress")
    else:
        emit_tokens_push_sview(buffer, "none")
        # An undischarged loop obligation is what stage0 counts in `warnings:`.
        warnings <- warnings + (loops - advancing)
    emit_tokens_push_sview(buffer, " unsafe_nonprogress=")
    emit_tokens_push_sview(buffer, "true" if progress_has_trusted(body, "Unsafe.NonProgress") else "false")
    # `blocking` / `blocking_path` are false/none in ALL 56 corpus fixtures, so there is no
    # witness to derive their rule from — emitted as measured, not guessed.
    emit_tokens_push_sview(buffer, " blocking=false unsafe_block_main=")
    emit_tokens_push_sview(buffer, "true" if progress_has_trusted(body, "Unsafe.BlockMain") else "false")
    emit_tokens_push_sview(buffer, " main_thread=")
    pm_main_thread: mutable bool = false
    for pm_decorator in decorators |pm_main_thread|:
        pm_main_thread <- true if pm_decorator.name == "main_thread"
    emit_tokens_push_sview(buffer, "true" if pm_main_thread else "false")
    emit_tokens_push_sview(buffer, " blocking_path=none\n")


def progress_collect_functions(declarations: darray[Ast::Decl]&, names: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |names|:
        if declaration is Decl.Module(pcf_m_name, pcf_m_body, pcf_m_line):
            progress_collect_functions(pcf_m_body, names)
            continue
        if declaration is Decl.Scoped(pcf_s_body, pcf_s_line):
            progress_collect_functions(pcf_s_body, names)
            continue
        if declaration is Decl.Func(pcf_name, pcf_params, pcf_ret, pcf_body, pcf_effects, pcf_decorators, pcf_line):
            names.push(pcf_name)


# Every function's summary, rendered into a flat pool with its name, so OVERLOADS (which
# share a name) each get their own line — a name-keyed lookup collapsed them into one.
def progress_render_all(declarations: darray[Ast::Decl]&, names: mutable darray[sview]&, starts: mutable darray[usize]&, stops: mutable darray[usize]&, pool: mutable darray[u8]&, warnings: mutable i64&) -> void can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |names, starts, stops, pool, warnings|:
        if declaration is Decl.Module(pra_m_name, pra_m_body, pra_m_line):
            progress_render_all(pra_m_body, names, starts, stops, pool, warnings)
            continue
        if declaration is Decl.Scoped(pra_s_body, pra_s_line):
            progress_render_all(pra_s_body, names, starts, stops, pool, warnings)
            continue
        if declaration is Decl.Func(pra_name, pra_params, pra_ret, pra_body, pra_effects, pra_decorators, pra_line):
            names.push(pra_name)
            starts.push(pool.count)
            progress_emit_function(pool, pra_name, pra_body, pra_decorators, warnings)
            stops.push(pool.count)


def emit_progress_report(file: Ast::File&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    names: mutable darray[sview] = []
    progress_collect_functions(file.top_decls, &names)
    # The summaries are rendered FIRST so `warnings:` can be counted from them, then the
    # header is prepended — stage0 prints the count before the summaries that produce it.
    summary_names: mutable darray[sview] = []
    summary_starts: mutable darray[usize] = []
    summary_stops: mutable darray[usize] = []
    summary_pool: mutable darray[u8] = []
    warnings: mutable i64 = 0
    progress_render_all(file.top_decls, &summary_names, &summary_starts, &summary_stops, &summary_pool, &warnings)

    buffer: mutable darray[u8] = []
    emit_tokens_push_sview(&buffer, "=== progress ===\nwarnings: ")
    append_decimal(&buffer, warnings.u32())
    emit_tokens_push_sview(&buffer, "\nfunctions: ")
    append_decimal(&buffer, names.count.u32())
    emit_tokens_push_sview(&buffer, "\nfunction summaries:\n")
    # Alphabetical by name, STABLE for equal names so overloads keep declaration order.
    emitted: mutable darray[usize] = []
    for _round in 0..<summary_names.count |buffer, summary_names, summary_starts, summary_stops, summary_pool, emitted|:
        best: mutable usize = 0
        found: mutable bool = false
        for candidate in 0..<summary_names.count |best, found, summary_names, emitted|:
            already: mutable bool = false
            for done in emitted |already, candidate|:
                already <- true if done == candidate
            continue if already
            if not found or unsafe_name_less(summary_names[candidate], summary_names[best]):
                best <- candidate
                found <- true
        break if not found
        emitted.push(best)
        for byte_index in summary_starts[best]..<summary_stops[best] |buffer, summary_pool|:
            buffer.push(summary_pool[byte_index])
    return emit_tokens_flush(buffer)


# `-emit interpret` — run the program and report `main`'s RESULT.
#
# stage0 interprets the AST; stage1 compiles and runs, which is observably the same. The
# return value cannot travel out through the process exit status (0-255, and stage0 prints
# 100000 exactly), so the module's `main` is renamed and a synthesized entry point prints it
# — see Backend::wrap_main_for_interpret.
#
# Measured against stage0: an i64 `main` prints `[ result   ] <value>`; a void `main` prints
# NOTHING; a unit with no `main` reports `error: interpreter does not know function "main"`
# and exits 1; the program's own console output comes FIRST.
def interpret_main_returns_void(declarations: darray[Ast::Decl]&, found: mutable bool&) -> bool can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |found|:
        if declaration is Decl.Func(im_name, im_params, im_ret, im_body, im_effects, im_decorators, im_line):
            continue if im_name != "main"
            found <- true
            # `-> void` is either an absent return type or the `void` name.
            if im_ret is im_ret_present:
                if im_ret_present is Expr.Ident(im_ret_name, im_ret_line):
                    return im_ret_name == "void"
                return false
            return true
    return false


def emit_interpret(file: Ast::File&, out_path: darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    found_main: mutable bool = false
    returns_void: bool = interpret_main_returns_void(file.top_decls, &found_main)
    if not found_main:
        message: mutable darray[u8] = []
        emit_tokens_push_sview(&message, "error: interpreter does not know function \"main\"\n")
        write_stderr(message)
        return 1

    ctx: LLVMContextRef = LLVMContextCreate()
    module_handle: LLVMModuleRef = LLVMModuleCreateWithNameInContext("elisac_stage1_interpret", ctx)
    builder: LLVMBuilderRef = LLVMCreateBuilderInContext(ctx)
    emitted: i64 = Backend::emit_module(file, module_handle, ctx, builder)
    2 return if emitted <= 0 and unit_declares_function(file.top_decls)
    if not Backend::wrap_main_for_interpret(returns_void, module_handle, ctx, builder):
        message: mutable darray[u8] = []
        emit_tokens_push_sview(&message, "error: interpreter does not know function \"main\"\n")
        write_stderr(message)
        return 1

    triple_storage: mutable darray[u8] = []
    machine: LLVMTargetMachineRef = Backend::configure_module_target_for(module_handle, requested_target_triple(&triple_storage))
    work: mutable darray[u8] = []
    emit_tokens_push_sview(&work, "/tmp/elisa-interpret-stage1")
    make_directory(work)
    object_path: darray[u8] = joined_path(work, "program.o")
    binary_path: darray[u8] = joined_path(work, "program")
    object_c: mutable darray[u8] = []
    for object_index in 0..<object_path.count |object_c, object_path|:
        object_c.push(object_path[object_index])
    object_c.push(0)
    object_cstr: cstr = (&object_c[0]).cast[cstr] can Unsafe.PointerCast
    4 return if not Backend::emit_object(machine, module_handle, object_cstr)

    # Link with the runtime, exactly as `-emit exe` does.
    link_command: mutable darray[u8] = []
    emit_tokens_push_sview(&link_command, "clang -o ")
    carchive_push_quoted(&link_command, binary_path)
    link_command.push(32)
    carchive_push_quoted(&link_command, object_path)
    runtime_object: mutable darray[u8] = []
    push_runtime_object_path(&runtime_object)
    if runtime_object.count > 0:
        link_command.push(32)
        carchive_push_quoted(&link_command, runtime_object)
    if cbind_run(link_command) != 0:
        message: mutable darray[u8] = []
        emit_tokens_push_sview(&message, "error: -emit interpret: could not link the program\n")
        write_stderr(message)
        return 1

    # Run it. Its stdout IS the report: the program's own output, then the result line the
    # synthesized entry point prints.
    run_command: mutable darray[u8] = []
    carchive_push_quoted(&run_command, binary_path)
    _ = cbind_run(run_command)
    return 0


# `-emit test-runner` — stage0's synthesized test driver: the unit's source, then a
# `ctx_test_main` that calls each `@test` function in declaration order and reports it.
#
# `-filter` selects tests by SUBSTRING of the name (measured against stage0: `checks`
# matches both `checks_one` and `checks_two`; `one` matches only `checks_one`).


# The source path as an ABSOLUTE path, which is what stage0's `#line` directive carries
# (filepath.Abs). ELISA_STAGE1_SRC is passed through as the caller wrote it, so a relative
# path is joined onto the working directory.
def push_absolute_source_path(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    given: mutable darray[u8] = []
    _ = push_source_path(&given)
    return if given.count == 0
    if given[0] == 47:
        for absolute_index in 0..<given.count |buffer, given|:
            buffer.push(given[absolute_index])
        return
    # $PWD FIRST, then getcwd(3). Go's os.Getwd — which is what stage0's filepath.Abs uses
    # — returns the LOGICAL working directory from $PWD when it names the same place, while
    # getcwd(3) returns the PHYSICAL one. On macOS that is the difference between `/tmp` and
    # `/private/tmp`, and it is visible in the `#line` directive.
    pwd_storage: mutable darray[u8] = []
    for pwd_flag_index in 0..<sview_len("PWD") |pwd_storage|:
        pwd_storage.push(sview_at("PWD", pwd_flag_index))
    pwd_storage.push(0)
    pwd_name: cstr = (&pwd_storage[0]).cast[cstr] can Unsafe.PointerCast
    wrote_directory: mutable bool = false
    if getenv(pwd_name) is pwd_bytes:
        pwd_cursor: mutable i64 = 0
        pwd_scanning: mutable bool = true
        while pwd_scanning |pwd_cursor, pwd_scanning, buffer, wrote_directory, pwd_bytes|:
            pwd_ref: u8& = pwd_bytes + pwd_cursor
            pwd_byte: u8 = pwd_ref
            if pwd_byte == 0:
                pwd_scanning <- false
            else:
                buffer.push(pwd_byte)
                wrote_directory <- true
                pwd_cursor <- pwd_cursor + 1
    if not wrote_directory:
        cwd_storage: mutable darray[u8] = [0 for _ in 0..<4096]
        cwd_pointer: void& = (&cwd_storage[0]).cast[void&] can Unsafe.PointerCast
        _ = getcwd(cwd_pointer, 4096)
        for cwd_index in 0..<cwd_storage.count |buffer, cwd_storage|:
            break if cwd_storage[cwd_index] == 0
            buffer.push(cwd_storage[cwd_index])
    buffer.push(47)
    # A leading `./` is redundant once the directory is prefixed — filepath.Abs cleans it.
    skip: usize = 2 if given.count >= 2 and given[0] == 46 and given[1] == 47 else 0
    for relative_index in skip..<given.count |buffer, given|:
        buffer.push(given[relative_index])


# The `-filter` value from ELISA_STAGE1_FILTER, or "" when unset.
def push_test_filter(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag_storage: mutable darray[u8] = []
    for flag_index in 0..<sview_len("ELISA_STAGE1_FILTER") |flag_storage|:
        flag_storage.push(sview_at("ELISA_STAGE1_FILTER", flag_index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is filter_bytes:
        cursor: mutable i64 = 0
        scanning: mutable bool = true
        while scanning |cursor, scanning, buffer, filter_bytes|:
            byte_ref: u8& = filter_bytes + cursor
            filter_byte: u8 = byte_ref
            if filter_byte == 0:
                scanning <- false
            else:
                buffer.push(filter_byte)
                cursor <- cursor + 1


# Does `name` contain `needle`? stage0's filter is a SUBSTRING test, not an exact match.
def test_name_matches(name: sview, needle: darray[u8]&) -> bool can[Abort.Panic]:
    true return if needle.count == 0
    false return if needle.count > sview_len(name)
    for start in 0..<(sview_len(name) - needle.count + 1) |name, needle|:
        matched: mutable bool = true
        for probe in 0..<needle.count |matched, name, needle, start|:
            matched <- false if sview_at(name, start + probe) != needle[probe]
        true return if matched
    return false


# Every `@test`-decorated function name, in declaration order, that the filter selects.
def test_collect_names(declarations: darray[Ast::Decl]&, needle: darray[u8]&, names: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |needle, names|:
        if declaration is Decl.Module(test_m_name, test_m_body, test_m_line):
            test_collect_names(test_m_body, needle, names)
            continue
        if declaration is Decl.Scoped(test_s_body, test_s_line):
            test_collect_names(test_s_body, needle, names)
            continue
        if declaration is Decl.Func(test_f_name, test_f_params, test_f_ret, test_f_body, test_f_effects, test_f_decorators, test_f_line):
            is_test: mutable bool = false
            for test_f_decorator in test_f_decorators |is_test|:
                is_test <- true if test_f_decorator.name == "test"
            names.push(test_f_name) if is_test and test_name_matches(test_f_name, needle)


# One `puts("<prefix><name>".cast[u8&])` line, TAB-indented to `depth` — stage0's
# synthesized body uses tabs, not spaces.
def test_push_puts(buffer: mutable darray[u8]&, depth: i64, prefix: sview, name: sview) -> void can[Abort.Panic, Memory.Allocate]:
    for tab_index in 0..<depth |buffer|:
        buffer.push(9)
    emit_tokens_push_sview(buffer, "puts(\"")
    emit_tokens_push_sview(buffer, prefix)
    emit_tokens_push_sview(buffer, name)
    emit_tokens_push_sview(buffer, "\".cast[u8&])\n")


def emit_test_runner_report(file: Ast::File&, source: u8&, source_len: usize) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    needle: mutable darray[u8] = []
    push_test_filter(&needle)
    names: mutable darray[sview] = []
    test_collect_names(file.top_decls, needle, &names)

    buffer: mutable darray[u8] = []
    # The unit's source, attributed to the original file. For a SINGLE-FILE unit this is
    # byte-identical to stage0. For an include-bearing unit stage0's echo also carries a
    # directive per spliced file, which stage1's flattening does not emit; the emitted
    # runner still compiles and runs. See the emit-mode-port-order note for why emitting
    # those directives upstream currently breaks the line-keyed token recovery.
    emit_tokens_push_sview(&buffer, "#line 1 ")
    push_absolute_source_path(&buffer)
    buffer.push(10)
    for source_index in 0..<source_len |buffer, source|:
        byte_ref: u8& = source + source_index.i64()
        buffer.push(byte_ref)
    buffer.push(10) if buffer.count > 0 and buffer[buffer.count - 1] != 10

    emit_tokens_push_sview(&buffer, "\nextern puts(text: u8&) -> int can[Console.Write]\n\ndef ctx_test_main() -> int can[Console.Write]:\n")
    if names.count == 0:
        # ONE tab, and the grant sits on the CALL rather than a surrounding block.
        emit_tokens_push_sview(&buffer, "\tputs(\"[ NO TESTS ] no @test functions matched filter \\\"")
        for needle_index in 0..<needle.count |buffer, needle|:
            buffer.push(needle[needle_index])
        emit_tokens_push_sview(&buffer, "\\\"\".cast[u8&]) can Console.Write\n\treturn 1\n")
    else:
        emit_tokens_push_sview(&buffer, "\tcan Console.Write:\n")
        for test_name in names |buffer|:
            test_push_puts(&buffer, 2, "[ RUN      ] ", test_name)
            buffer.push(9)
            buffer.push(9)
            emit_tokens_push_sview(&buffer, test_name)
            emit_tokens_push_sview(&buffer, "()\n")
            test_push_puts(&buffer, 2, "[       OK ] ", test_name)
        buffer.push(9)
        buffer.push(9)
        emit_tokens_push_sview(&buffer, "puts(\"[ SUMMARY  ] ")
        append_decimal(&buffer, names.count.u32())
        emit_tokens_push_sview(&buffer, " test(s) selected; runnable=")
        append_decimal(&buffer, names.count.u32())
        emit_tokens_push_sview(&buffer, " skipped=0 failed=0\".cast[u8&])\n\t\treturn 0\n")
    emit_tokens_push_sview(&buffer, "\nexport fn main() -> int = ctx_test_main\n")
    return emit_tokens_flush(buffer)


# `-emit tests` / `-emit benches` / `-emit fixtures` — one TAB-separated
# `NAME<TAB>SIGNATURE` row per annotated function, in declaration order, selected by the
# same substring `-filter` the test runner uses. stage0 refuses `-o` for all three, so the
# report always goes to stdout.
#
# The signature is stage0's SEMANTIC FuncType string, but every annotated function is
# already constrained to take NO PARAMETERS — a param-bearing `@test`/`@bench`/`@fixture`
# is a hard error raised before the listing runs — so the head is always `fn()`. That
# leaves two variable parts:
#
#   * the RETURN TYPE, recovered from the declaration line's tokens exactly the way
#     `-emit iface` recovers it (an absent `->` prints `void`); and
#   * the permission clause, which stage0 renders from the FAMILY names only —
#     `can[Memory.Allocate, Console.Write]` prints as `can[Console, Memory]`, i.e.
#     deduplicated and SORTED, not source order. A `@fixture` may not require permissions
#     at all, so in practice only tests and benches ever grow one.


# `Memory.Allocate` -> `Memory`. An effect with no dot is already a family.
def annotated_effect_family(effect: sview) -> sview can[Abort.Panic]:
    dot: i64 = sview_find_byte(effect, 46)
    effect return if dot < 0
    return string_view_prefix(effect, dot)


def annotated_family_less(left: sview, right: sview) -> bool can[Abort.Panic]:
    shorter: usize = sview_len(left) if sview_len(left) < sview_len(right) else sview_len(right)
    for probe in 0..<shorter |left, right|:
        left_byte: u8 = sview_at(left, probe)
        right_byte: u8 = sview_at(right, probe)
        true return if left_byte < right_byte
        false return if left_byte > right_byte
    return sview_len(left) < sview_len(right)


# ` can[A, B]`, families deduplicated and sorted ascending. Emits nothing when the
# function declares no effects.
def annotated_push_effects(buffer: mutable darray[u8]&, effects: darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    families: mutable darray[sview] = []
    for effect in effects |families|:
        family: sview = annotated_effect_family(effect)
        seen: mutable bool = false
        for known in families |seen, family|:
            seen <- true if known == family
        families.push(family) if not seen
    return if families.count == 0
    # Selection sort: the family count is bounded by the permission taxonomy, so the
    # quadratic shape is irrelevant and the code stays obviously correct.
    for slot in 0..<families.count |families|:
        best: mutable usize = slot
        for probe in (slot + 1)..<families.count |best, families|:
            best <- probe if annotated_family_less(families[probe], families[best])
        if best != slot:
            swap: sview = families[slot]
            families[slot] <- families[best]
            families[best] <- swap
    emit_tokens_push_sview(buffer, " can[")
    for index in 0..<families.count |buffer, families|:
        emit_tokens_push_sview(buffer, ", ") if index > 0
        emit_tokens_push_sview(buffer, families[index])
    emit_tokens_push_sview(buffer, "]")


# `fn() -> RET`, the return type taken from the declaration line's tokens.
def annotated_push_signature(buffer: mutable darray[u8]&, line: u32, tokens: darray[Lexer::Token]&, source: u8&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    emit_tokens_push_sview(buffer, "fn() -> ")
    line_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
    if not line_range.found:
        emit_tokens_push_sview(buffer, "void")
        return
    arrow_index: mutable usize = 0
    arrow_found: mutable bool = false
    for arrow_probe in line_range.start..<line_range.stop |arrow_index, arrow_found, tokens|:
        continue if arrow_found
        if tokens[arrow_probe].kind == Lexer::TokenKind.Arrow:
            arrow_index <- arrow_probe
            arrow_found <- true
    if not arrow_found:
        emit_tokens_push_sview(buffer, "void")
        return
    # The type ends at the effects clause when there is one, otherwise at the trailing
    # colon — which must be matched at bracket depth 0 so a tuple return `(a: i64)` or a
    # `dict[i64, i64]` does not truncate it.
    ret_stop: mutable usize = line_range.stop
    depth: mutable i64 = 0
    scanning: mutable bool = true
    for ret_probe in (arrow_index + 1)..<line_range.stop |ret_stop, depth, scanning, tokens, source|:
        continue if not scanning
        ret_token: Lexer::Token = tokens[ret_probe]
        depth <- depth + 1 if ret_token.kind == Lexer::TokenKind.LParen or ret_token.kind == Lexer::TokenKind.LBracket
        depth <- depth - 1 if ret_token.kind == Lexer::TokenKind.RParen or ret_token.kind == Lexer::TokenKind.RBracket
        stops: bool = depth == 0 and ((ret_token.kind == Lexer::TokenKind.Ident and Lexer::text_or_empty(ret_token, source) == "can") or ret_token.kind == Lexer::TokenKind.Colon)
        if stops:
            ret_stop <- ret_probe
            scanning <- false
    if ret_stop <= arrow_index + 1:
        emit_tokens_push_sview(buffer, "void")
        return
    emit_iface_render_tokens(buffer, tokens, source, arrow_index + 1, ret_stop)


def annotated_report_decls(buffer: mutable darray[u8]&, declarations: darray[Ast::Decl]&, annotation: sview, needle: darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    for declaration in declarations |buffer, annotation, needle, tokens, source|:
        if declaration is Decl.Module(ann_m_name, ann_m_body, ann_m_line):
            annotated_report_decls(buffer, ann_m_body, annotation, needle, tokens, source)
            continue
        if declaration is Decl.Scoped(ann_s_body, ann_s_line):
            annotated_report_decls(buffer, ann_s_body, annotation, needle, tokens, source)
            continue
        if declaration is Decl.Func(ann_f_name, ann_f_params, ann_f_ret, ann_f_body, ann_f_effects, ann_f_decorators, ann_f_line):
            matched: mutable bool = false
            for ann_f_decorator in ann_f_decorators |matched, annotation|:
                matched <- true if ann_f_decorator.name == annotation
            continue if not matched
            continue if not test_name_matches(ann_f_name, needle)
            emit_tokens_push_sview(buffer, ann_f_name)
            buffer.push(9)
            annotated_push_signature(buffer, ann_f_line, tokens, source)
            annotated_push_effects(buffer, ann_f_effects)
            buffer.push(10)


def emit_annotated_report(file: Ast::File&, annotation: sview, tokens: darray[Lexer::Token]&, source: u8&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    needle: mutable darray[u8] = []
    push_test_filter(&needle)
    buffer: mutable darray[u8] = []
    annotated_report_decls(&buffer, file.top_decls, annotation, needle, tokens, source)
    return emit_tokens_flush(buffer)


# `-emit header` — the C ABI header for a unit's exports.
#
# The GENERATOR already existed (src/backend/c_header.elisa, exercised by
# test/breadth/emit_header.elisa); it simply had no CLI exposure. All this adds is the
# include guard, which stage0 derives from the SOURCE FILENAME and the breadth driver
# hardcoded as ELISA_GENERATED_H.


# stage0's headerGuardName: uppercase the basename, drop the extension, map every byte that
# is not A-Z or 0-9 to `_`, trim leading/trailing `_`, and append `_H`. An empty result
# falls back to ELISACORE_EXPORT.
def push_header_guard(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    base: mutable darray[u8] = []
    push_source_basename(&base)
    # Drop the extension — everything from the LAST dot.
    stop: mutable usize = base.count
    for dot_index in 0..<base.count |stop, base|:
        stop <- dot_index if base[dot_index] == 46
    folded: mutable darray[u8] = []
    for index in 0..<stop |folded, base|:
        byte: u8 = base[index]
        upper: u8 = (byte - 32) if byte >= 97 and byte <= 122 else byte
        is_alnum: bool = (upper >= 65 and upper <= 90) or (upper >= 48 and upper <= 57)
        folded.push(upper if is_alnum else 95)
    # Trim the underscores stage0's strings.Trim removes from BOTH ends.
    first: mutable usize = 0
    while first < folded.count and folded[first] == 95 |first, folded|:
        first <- first + 1
    last: mutable usize = folded.count
    while last > first and folded[last - 1] == 95 |last, folded, first|:
        last <- last - 1
    if last <= first:
        emit_tokens_push_sview(buffer, "ELISACORE_EXPORT_H")
        return
    for copy_index in first..<last |buffer, folded|:
        buffer.push(folded[copy_index])
    emit_tokens_push_sview(buffer, "_H")


def emit_header_report(file: Ast::File&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    guard: mutable darray[u8] = []
    push_header_guard(&guard)
    guard.push(0)
    ctx: LLVMContextRef = LLVMContextCreate()
    module_handle: LLVMModuleRef = LLVMModuleCreateWithNameInContext("elisac_stage1_header", ctx)
    header: darray[u8] = Backend::generate_c_header_for_file(file, module_handle, ctx, sview((&guard[0]).cast[cstr], 0, guard.count - 1))
    # An UNSUPPORTED exported type makes the generator answer empty rather than publish
    # declarations that disagree with the object ABI. Fail loudly: a partial header
    # compiles against the wrong ABI, which is worse than no header.
    if header.count == 0:
        message: mutable darray[u8] = []
        emit_tokens_push_sview(&message, "error: -emit header: an exported type has no C ABI representation\n")
        write_stderr(message)
        return 1
    # The generator NUL-terminates; the wire report must not carry the terminator.
    body: mutable darray[u8] = []
    for index in 0..<header.count |body, header|:
        body.push(header[index]) if header[index] != 0
    return emit_tokens_flush(body)


# `-emit doc` — stage0's docgen.go. Markdown reference pages built from the AST alone.
#
# The section body is UNPARSED, not copied from source: stage0's `- declaration:` line is
# declarationHeadline(unparse.FormatDecl(decl)), so it prints the CANONICAL rendering of
# the header. That is why this reuses FmtUnparse::fmt_decl rather than the token-span
# recovery emit_iface_decl uses — the two modes genuinely want different text.


# The basename of ELISA_STAGE1_SRC — stage0's filepath.Base for the `# Reference:` title.
def push_source_basename(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    whole: mutable darray[u8] = []
    _ = push_source_path(&whole)
    return if whole.count == 0
    start: mutable usize = 0
    for scan_index in 0..<whole.count |start, whole|:
        start <- scan_index + 1 if whole[scan_index] == 47
    for copy_index in start..<whole.count |buffer, whole|:
        buffer.push(whole[copy_index])


# stage0's declarationHeadline: the first non-blank line of the formatted declaration that
# does not begin with `@`. Decorator lines are skipped so the headline is the signature
# itself, and a multi-line body contributes nothing.
def doc_push_headline(buffer: mutable darray[u8]&, declaration: Ast::Decl, tokens: darray[Lexer::Token]&, source: u8&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    rendered: mutable darray[u8] = []
    FmtUnparse::fmt_decl(&rendered, declaration, tokens, source, 0)
    line_start: mutable usize = 0
    emitted: mutable bool = false
    scan: mutable usize = 0
    while scan <= rendered.count and not emitted |scan, line_start, emitted, buffer, rendered|:
        at_end: bool = scan == rendered.count
        if at_end or rendered[scan] == 10:
            # Trim this line, then accept it unless it is blank or a decorator.
            trim_start: mutable usize = line_start
            while trim_start < scan and (rendered[trim_start] == 32 or rendered[trim_start] == 9) |trim_start, rendered, scan|:
                trim_start <- trim_start + 1
            trim_stop: mutable usize = scan
            while trim_stop > trim_start and (rendered[trim_stop - 1] == 32 or rendered[trim_stop - 1] == 9 or rendered[trim_stop - 1] == 13) |trim_stop, rendered, trim_start|:
                trim_stop <- trim_stop - 1
            if trim_stop > trim_start and rendered[trim_start] != 64:
                for copy_index in trim_start..<trim_stop |buffer, rendered|:
                    buffer.push(rendered[copy_index])
                emitted <- true
            line_start <- scan + 1
        scan <- scan + 1


# stage0's writeSimpleReferenceSection header half: `## KIND \`NAME\`` then the
# `- declaration:` line. The caller appends any extra bullets and the trailing blank line.
def doc_open_section(buffer: mutable darray[u8]&, level: i64, kind: sview, name: sview, namespace: darray[u8]&, declaration: Ast::Decl, tokens: darray[Lexer::Token]&, source: u8&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    for hash_index in 0..<level |buffer|:
        buffer.push(35)
    buffer.push(32)
    emit_tokens_push_sview(buffer, kind)
    emit_tokens_push_sview(buffer, " `")
    # stage0's qualifyDocName: a declaration inside a namespace is named `Outer.Inner.name`.
    for namespace_index in 0..<namespace.count |buffer, namespace|:
        buffer.push(namespace[namespace_index])
    buffer.push(46) if namespace.count > 0
    emit_tokens_push_sview(buffer, name)
    emit_tokens_push_sview(buffer, "`\n\n- declaration: `")
    doc_push_headline(buffer, declaration, tokens, source)
    emit_tokens_push_sview(buffer, "`\n")


# stage0's writeAnnotationsList for declarations whose stage1 node does NOT carry a
# decorator list (Struct, Extern): the stacked `@name(...)` lines sit directly above the
# header, so they are recovered from the token stream — the same recovery
# fmt_struct_decorator_lines does for the formatter.
def doc_push_decorator_annotations(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    names: mutable darray[sview] = []
    lines: mutable darray[u32] = []
    probe_line: mutable u32 = line
    scanning: mutable bool = true
    while scanning and probe_line > 1 |scanning, probe_line, names, lines, tokens, source|:
        probe_line <- probe_line - 1
        probe_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, probe_line)
        if not probe_range.found or probe_range.start + 1 >= tokens.count:
            scanning <- false
        elif tokens[probe_range.start].kind != Lexer::TokenKind.At:
            scanning <- false
        else:
            names.push(Lexer::text_or_empty(tokens[probe_range.start + 1], source))
            lines.push(probe_line)
    return if names.count == 0
    emit_tokens_push_sview(buffer, "- annotations:\n")
    # The scan walked UPWARD, so replay in declaration order.
    for reverse_index in 0..<names.count |buffer, names, lines, tokens, source|:
        pick: usize = names.count - 1.usize() - reverse_index
        emit_tokens_push_sview(buffer, "  - `@")
        emit_tokens_push_sview(buffer, names[pick])
        # emit_ast_decorator_args looks for the nearest `@` line STRICTLY BEFORE the
        # line it is given, so it is handed the line AFTER this annotation's own.
        emit_ast_decorator_args(buffer, tokens, source, lines[pick] + 1)
        emit_tokens_push_sview(buffer, "`\n")


# The binary operators FormatExpr parenthesizes around. Used to decide whether a static-if
# condition recovered from tokens needs the pair stage0's FormatExpr would have added.
def doc_token_is_binary_operator(kind: Lexer::TokenKind) -> bool can[Abort.Panic]:
    true return if kind == Lexer::TokenKind.EqEq or kind == Lexer::TokenKind.BangEq
    true return if kind == Lexer::TokenKind.Lt or kind == Lexer::TokenKind.Gt
    true return if kind == Lexer::TokenKind.LtEq or kind == Lexer::TokenKind.GtEq
    true return if kind == Lexer::TokenKind.And or kind == Lexer::TokenKind.Or
    true return if kind == Lexer::TokenKind.Plus or kind == Lexer::TokenKind.Minus
    true return if kind == Lexer::TokenKind.Star or kind == Lexer::TokenKind.Slash
    return false


# Which part of a `static if` CHAIN this declaration is, if any.
#
# stage0 models the whole chain as ONE StaticIfDecl (Cond + Then + Elifs + Else); stage1's
# parser splits every branch into its own top-level `Decl.Scoped`. Left alone that inflates
# `- top-level declarations:` by one per continuation branch — the entire count divergence
# on the std-including fixtures — and prints a section per branch where stage0 prints one.
#
# 0: not a static-if branch.  1: the `static if` HEAD.  2: a `static elif`.  3: `static else`.
def doc_static_branch_kind(declaration: Ast::Decl, tokens: darray[Lexer::Token]&) -> i64 can[Abort.Panic, Memory.Allocate]:
    if declaration is Decl.Scoped(doc_sb_body, doc_sb_line):
        doc_sb_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, doc_sb_line)
        0 return if not doc_sb_range.found or doc_sb_range.start + 1 >= tokens.count
        0 return if tokens[doc_sb_range.start].kind != Lexer::TokenKind.Static
        doc_sb_second: Lexer::TokenKind = tokens[doc_sb_range.start + 1].kind
        2 return if doc_sb_second == Lexer::TokenKind.Elif
        3 return if doc_sb_second == Lexer::TokenKind.Else
        1 return if doc_sb_second == Lexer::TokenKind.If
        return 0
    return 0


# A struct field's TYPE text, recovered from the token stream.
#
# stage0 renders it with unparse.FormatType, which stage1 has no equivalent of: fmt_expr
# is an EXPRESSION renderer and prints `<fmt-op-todo>` markers for the type-only operators
# (`mutable`, a trailing `?`, `heap`), so `mutable void&?` came out as
# `(<fmt-op-todo>(<fmt-op-todo>&void))`. The declared text after the field's `:` IS the
# type as written, and for these forms stage0's canonical rendering equals it.
#
# Returns false when the field's line cannot be located, leaving the caller to fall back.
def doc_push_field_type(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, struct_line: u32, field_name: sview) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    body_start: mutable usize = 0
    header_found: mutable bool = false
    for header_probe in 0..<tokens.count |body_start, header_found, tokens, struct_line|:
        continue if header_found
        if tokens[header_probe].line > struct_line:
            body_start <- header_probe
            header_found <- true
    false return if not header_found
    # Scan forward for `NAME :` at the head of a line, stopping at the next declaration
    # keyword so a later struct's identically named field cannot be picked up.
    cursor: mutable usize = body_start
    while cursor + 1 < tokens.count |cursor, buffer, tokens, source, field_name|:
        head: Lexer::Token = tokens[cursor]
        break if head.kind == Lexer::TokenKind.Def or head.kind == Lexer::TokenKind.Struct or head.kind == Lexer::TokenKind.Enum
        if head.kind == Lexer::TokenKind.Ident and Lexer::text_or_empty(head, source) == field_name and tokens[cursor + 1].kind == Lexer::TokenKind.Colon:
            type_stop: mutable usize = cursor + 2
            while type_stop < tokens.count and tokens[type_stop].line == head.line and tokens[type_stop].kind != Lexer::TokenKind.Newline and tokens[type_stop].kind != Lexer::TokenKind.Assign |type_stop, tokens, head|:
                type_stop <- type_stop + 1
            false return if type_stop <= cursor + 2
            emit_iface_render_tokens(buffer, tokens, source, cursor + 2, type_stop)
            return true
        cursor <- cursor + 1
    return false


# One declaration's reference section. `level` is the markdown heading depth (2 at top
# level); stage0 clamps it at 6 (minHeading) when recursing into a namespace.
def emit_doc_decl(buffer: mutable darray[u8]&, declaration: Ast::Decl, level: i64, namespace: darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, annotations: darray[Ast::LocalRegionAnnotation]&, struct_names: darray[sview]&, struct_member_rows: darray[Ast::StructMember]&, struct_member_starts: darray[usize]&, struct_member_counts: darray[usize]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        if declaration is Decl.Func(doc_fn_name, doc_fn_params, doc_fn_ret, doc_fn_body, doc_fn_effects, doc_fn_decorators, doc_fn_line):
            doc_open_section(buffer, level, "Function", doc_fn_name, namespace, declaration, tokens, source)
            if doc_fn_decorators.count > 0:
                emit_tokens_push_sview(buffer, "- annotations:\n")
                for doc_fn_decorator in doc_fn_decorators |buffer, tokens, source, doc_fn_line|:
                    emit_tokens_push_sview(buffer, "  - `@")
                    emit_tokens_push_sview(buffer, doc_fn_decorator.name)
                    emit_ast_decorator_args(buffer, tokens, source, doc_fn_line)
                    emit_tokens_push_sview(buffer, "`\n")
            emit_tokens_push_sview(buffer, "- body statements: ")
            # stage0 WRAPS a region-less container-declaring body in a synthesized
            # region, so its statement count collapses to 1. The AST report already
            # reproduces that rule; doc must use the same one or it reports 10 where
            # stage0 reports 1.
            doc_fn_wrapped: bool = emit_ast_body_declares_container(doc_fn_body, annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
            append_decimal(buffer, 1 if doc_fn_wrapped else doc_fn_body.count.u32())
            emit_tokens_push_sview(buffer, "\n\n")
            return
        if declaration is Decl.Enum(doc_en_name, doc_en_variants, doc_en_const, doc_en_storage, doc_en_line):
            # `error Bad:` also parses to Decl.Enum (see error_type_declaration), and a
            # `packed enum` is not modelled as a flag, so the SECTION KIND comes from the
            # leading keyword on the declaration line.
            doc_en_is_error: mutable bool = false
            doc_en_is_packed: mutable bool = false
            doc_en_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, doc_en_line)
            if doc_en_range.found:
                doc_en_is_error <- tokens[doc_en_range.start].kind == Lexer::TokenKind.Error
                doc_en_is_packed <- Lexer::text_or_empty(tokens[doc_en_range.start], source) == "packed"
            doc_en_kind: mutable sview = "Enum"
            if doc_en_is_error:
                doc_en_kind <- "Error set"
            elif doc_en_const:
                doc_en_kind <- "Const enum"
            elif doc_en_is_packed:
                doc_en_kind <- "Packed enum"
            doc_open_section(buffer, level, doc_en_kind, doc_en_name, namespace, declaration, tokens, source)
            if doc_en_is_error:
                emit_tokens_push_sview(buffer, "- tags:\n")
                for doc_en_tag in doc_en_variants |buffer|:
                    emit_tokens_push_sview(buffer, "  - `")
                    emit_tokens_push_sview(buffer, doc_en_tag.name)
                    emit_tokens_push_sview(buffer, "`\n")
            elif doc_en_const:
                emit_tokens_push_sview(buffer, "- storage: `")
                FmtUnparse::fmt_expr(buffer, doc_en_storage, tokens, source)
                emit_tokens_push_sview(buffer, "`\n- members:\n")
                for doc_en_member in doc_en_variants |buffer, tokens, source|:
                    emit_tokens_push_sview(buffer, "  - `")
                    emit_tokens_push_sview(buffer, doc_en_member.name)
                    # `value_expr` is an Expr with an Absent variant, NOT an optional —
                    # `is <name>` would bind unconditionally rather than test it.
                    if not (doc_en_member.value_expr is Expr.Absent) and not (doc_en_member.value_expr is Expr.Invalid):
                        emit_tokens_push_sview(buffer, " = ")
                        FmtUnparse::fmt_expr(buffer, doc_en_member.value_expr, tokens, source)
                    emit_tokens_push_sview(buffer, "`\n")
            else:
                doc_push_decorator_annotations(buffer, tokens, source, doc_en_line)
                emit_tokens_push_sview(buffer, "- variants:\n")
                for doc_en_variant in doc_en_variants |buffer, tokens, source|:
                    emit_tokens_push_sview(buffer, "  - `")
                    emit_tokens_push_sview(buffer, doc_en_variant.name)
                    if doc_en_variant.fields.count > 0:
                        buffer.push(40)
                        for doc_en_field_index in 0..<doc_en_variant.fields.count |buffer, tokens, source, doc_en_variant|:
                            emit_tokens_push_sview(buffer, ", ") if doc_en_field_index > 0
                            if doc_en_variant.field_names[doc_en_field_index] != "":
                                emit_tokens_push_sview(buffer, doc_en_variant.field_names[doc_en_field_index])
                                emit_tokens_push_sview(buffer, ": ")
                            FmtUnparse::fmt_expr(buffer, doc_en_variant.fields[doc_en_field_index], tokens, source)
                        buffer.push(41)
                    emit_tokens_push_sview(buffer, "`\n")
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Struct(doc_st_name, doc_st_members, doc_st_aff, doc_st_states, doc_st_derive, doc_st_inv, doc_st_line):
            doc_open_section(buffer, level, "Struct", doc_st_name, namespace, declaration, tokens, source)
            doc_push_decorator_annotations(buffer, tokens, source, doc_st_line)
            emit_tokens_push_sview(buffer, "- fields:\n")
            for doc_st_member in doc_st_members |buffer, tokens, source|:
                emit_tokens_push_sview(buffer, "  - `")
                emit_tokens_push_sview(buffer, doc_st_member.name)
                emit_tokens_push_sview(buffer, ": ")
                # Source-recovered type text; the expression unparser is the fallback for a
                # field whose line cannot be located (it prints `<fmt-op-todo>` markers for
                # the type-only operators, so it is loud rather than silently wrong).
                if not doc_push_field_type(buffer, tokens, source, doc_st_line, doc_st_member.name):
                    FmtUnparse::fmt_expr(buffer, doc_st_member.type_expression, tokens, source)
                emit_tokens_push_sview(buffer, "`\n")
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Extern(doc_ex_name, doc_ex_start, doc_ex_arity, doc_ex_variadic, doc_ex_callable, doc_ex_ret, doc_ex_decorators, doc_ex_line):
            # stage1 folds stage0's whole extern/export declaration family into ONE node,
            # so the section KIND is recovered from the leading keywords on the decl line.
            doc_ex_kind: mutable sview = "Extern function"
            doc_ex_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, doc_ex_line)
            if doc_ex_range.found and doc_ex_range.start + 1 < tokens.count:
                doc_ex_head: Lexer::TokenKind = tokens[doc_ex_range.start].kind
                # `type` is not a TokenKind — it lexes as an identifier, so the second
                # keyword is matched by TEXT.
                doc_ex_second: sview = Lexer::text_or_empty(tokens[doc_ex_range.start + 1], source)
                if doc_ex_head == Lexer::TokenKind.Export:
                    doc_ex_kind <- "Exported type" if doc_ex_second == "type" else "Exported function"
                elif doc_ex_second == "type":
                    doc_ex_kind <- "Extern type"
                elif not doc_ex_callable:
                    # A bare `extern NAME` is stage0's ExternTypeDecl — an OPAQUE type. Only
                    # `extern NAME: T`, which carries a type annotation, is its ExternVarDecl.
                    # Keying on `callable` alone called every opaque type a variable.
                    #
                    # The annotation colon sits AT range.stop, not inside the range:
                    # emit_ast_line_range clips at the depth-0 colon. Scanning only the
                    # range called `extern stderr: void&` an opaque type.
                    doc_ex_annotated: bool = doc_ex_range.stop < tokens.count and tokens[doc_ex_range.stop].kind == Lexer::TokenKind.Colon
                    doc_ex_kind <- "Extern variable" if doc_ex_annotated else "Extern type"
            doc_open_section(buffer, level, doc_ex_kind, doc_ex_name, namespace, declaration, tokens, source)
            # stage0 lists annotations for the extern FUNCTION form only; the variable and
            # type forms take the nil `extra` callback.
            doc_push_decorator_annotations(buffer, tokens, source, doc_ex_line) if doc_ex_kind == "Extern function"
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Const(doc_c_name, doc_c_type, doc_c_value, doc_c_mutable, doc_c_line):
            doc_open_section(buffer, level, "Global" if doc_c_mutable else "Constant", doc_c_name, namespace, declaration, tokens, source)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Module(doc_m_name, doc_m_body, doc_m_line):
            for doc_m_hash in 0..<level |buffer|:
                buffer.push(35)
            emit_tokens_push_sview(buffer, " Namespace `")
            # The QUALIFIED name, which is both what this heading prints and the prefix
            # every nested declaration inherits.
            #
            # A qualified `module Outer::Inner:` is captured VERBATIM by stage1's parser,
            # while stage0 nests two NamespaceDecls and qualifies them with a DOT. Rewrite
            # the separator so both spell the same name.
            doc_m_qualified: mutable darray[u8] = []
            for doc_m_outer in 0..<namespace.count |doc_m_qualified, namespace|:
                doc_m_qualified.push(namespace[doc_m_outer])
            doc_m_qualified.push(46) if namespace.count > 0
            for doc_m_index in 0..<sview_len(doc_m_name) |doc_m_qualified, doc_m_name|:
                doc_m_byte: u8 = sview_at(doc_m_name, doc_m_index)
                continue if doc_m_byte == 58 and doc_m_index + 1 < sview_len(doc_m_name) and sview_at(doc_m_name, doc_m_index + 1) == 58
                doc_m_qualified.push(46 if doc_m_byte == 58 else doc_m_byte)
            for doc_m_emit in 0..<doc_m_qualified.count |buffer, doc_m_qualified|:
                buffer.push(doc_m_qualified[doc_m_emit])
            emit_tokens_push_sview(buffer, "`\n\n- declaration: `")
            doc_push_headline(buffer, declaration, tokens, source)
            emit_tokens_push_sview(buffer, "`\n\n")
            # stage0 qualifies nested names as `Outer.Inner` and clamps the heading at 6.
            doc_m_nested_level: i64 = level + 1 if level < 6 else 6
            doc_m_first: mutable bool = true
            for doc_m_child in doc_m_body |buffer, tokens, source, doc_m_nested_level, doc_m_first, doc_m_qualified|:
                emit_tokens_push_sview(buffer, "\n") if not doc_m_first
                doc_m_first <- false
                emit_doc_decl(buffer, doc_m_child, doc_m_nested_level, doc_m_qualified, tokens, source, annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
            return
        # Everything stage1 does not model as its own doc section falls to stage0's
        # DEFAULT arm, which prints the headline under a bare `Declaration` heading. That
        # is a real stage0 output shape (325 sections across this repo's corpus), not a
        # placeholder — so an unported kind still produces stage0's own text for it.
        for doc_d_hash in 0..<level |buffer|:
            buffer.push(35)
        emit_tokens_push_sview(buffer, " Declaration\n\n- surface: `")
        doc_push_headline(buffer, declaration, tokens, source)
        emit_tokens_push_sview(buffer, "`\n\n")


# stage0's StaticIfDecl section, reassembled from the branch decls stage1 split apart.
# `head` indexes the `static if`; the continuations follow it contiguously.
def emit_doc_static_conditional(buffer: mutable darray[u8]&, decls: darray[Ast::Decl]&, head: usize, level: i64, tokens: darray[Lexer::Token]&, source: u8&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    for hash_index in 0..<level |buffer|:
        buffer.push(35)
    emit_tokens_push_sview(buffer, " Static conditional\n\n- condition: `")
    if decls[head] is Decl.Scoped(doc_sc_body, doc_sc_line):
        # The condition text runs from just past `static if` to the clipped range end.
        doc_sc_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, doc_sc_line)
        if doc_sc_range.found and doc_sc_range.start + 2 <= doc_sc_range.stop:
            # stage0 renders the condition with FormatExpr, which WRAPS a binary in its
            # own parens (`(A == B)`). Decl.Scoped does not carry the condition as an Expr,
            # so the same rule is applied to the token span: a depth-0 binary operator
            # means the rendered text gets the pair.
            doc_sc_binary: mutable bool = false
            doc_sc_depth: mutable i64 = 0
            for doc_sc_probe in (doc_sc_range.start + 2)..<doc_sc_range.stop |doc_sc_binary, doc_sc_depth, tokens|:
                doc_sc_kind_probe: Lexer::TokenKind = tokens[doc_sc_probe].kind
                if doc_sc_kind_probe == Lexer::TokenKind.LParen or doc_sc_kind_probe == Lexer::TokenKind.LBracket:
                    doc_sc_depth <- doc_sc_depth + 1
                elif doc_sc_kind_probe == Lexer::TokenKind.RParen or doc_sc_kind_probe == Lexer::TokenKind.RBracket:
                    doc_sc_depth <- doc_sc_depth - 1
                elif doc_sc_depth == 0 and doc_token_is_binary_operator(doc_sc_kind_probe):
                    doc_sc_binary <- true
            buffer.push(40) if doc_sc_binary
            emit_iface_render_tokens(buffer, tokens, source, doc_sc_range.start + 2, doc_sc_range.stop)
            buffer.push(41) if doc_sc_binary
        emit_tokens_push_sview(buffer, "`\n- then declarations: ")
        append_decimal(buffer, doc_sc_body.count.u32())
    else:
        emit_tokens_push_sview(buffer, "`\n- then declarations: 0")
    doc_sc_elifs: mutable usize = 0
    doc_sc_else: mutable usize = 0
    doc_sc_scan: mutable usize = head + 1
    while doc_sc_scan < decls.count |doc_sc_scan, doc_sc_elifs, doc_sc_else, decls, tokens|:
        doc_sc_kind: i64 = doc_static_branch_kind(decls[doc_sc_scan], tokens)
        break if doc_sc_kind != 2 and doc_sc_kind != 3
        if doc_sc_kind == 2:
            doc_sc_elifs <- doc_sc_elifs + 1
        elif decls[doc_sc_scan] is Decl.Scoped(doc_sc_else_body, doc_sc_else_line):
            doc_sc_else <- doc_sc_else_body.count
        doc_sc_scan <- doc_sc_scan + 1
    emit_tokens_push_sview(buffer, "\n- elif declarations: ")
    append_decimal(buffer, doc_sc_elifs.u32())
    emit_tokens_push_sview(buffer, "\n- else declarations: ")
    append_decimal(buffer, doc_sc_else.u32())
    # stage0's StaticIfDecl arm prints its four lines and stops — unlike
    # writeSimpleReferenceSection, it appends NO trailing blank line.
    emit_tokens_push_sview(buffer, "\n")


def emit_doc_report(file: Ast::File&, tokens: darray[Lexer::Token]&, source: u8&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    buffer: mutable darray[u8] = []
    emit_tokens_push_sview(&buffer, "# Reference: ")
    push_source_basename(&buffer)
    emit_tokens_push_sview(&buffer, "\n\nGenerated from `")
    _ = push_source_path(&buffer)
    emit_tokens_push_sview(&buffer, "`.\n\n## Summary\n\n- top-level declarations: ")
    # A `static if` CHAIN is ONE declaration to stage0; stage1's parser splits each branch
    # into its own Scoped decl, so every continuation is discounted here and folded into
    # its head's section below.
    doc_continuations: mutable usize = 0
    for doc_count_declaration in file.top_decls |doc_continuations, tokens|:
        doc_count_kind: i64 = doc_static_branch_kind(doc_count_declaration, tokens)
        doc_continuations <- doc_continuations + 1 if doc_count_kind == 2 or doc_count_kind == 3
    append_decimal(&buffer, (file.top_decls.count - doc_continuations).u32())
    emit_tokens_push_sview(&buffer, "\n- formatter source: structural AST rendering (comments are not preserved yet)\n\n")
    doc_first: mutable bool = true
    doc_top_namespace: darray[u8] = []
    for doc_index in 0..<file.top_decls.count |buffer, tokens, source, doc_first, doc_top_namespace, file|:
        doc_declaration: Ast::Decl = file.top_decls[doc_index]
        doc_branch: i64 = doc_static_branch_kind(doc_declaration, tokens)
        # A continuation branch was already reported by its chain head.
        continue if doc_branch == 2 or doc_branch == 3
        emit_tokens_push_sview(&buffer, "\n") if not doc_first
        doc_first <- false
        if doc_branch == 1:
            emit_doc_static_conditional(&buffer, file.top_decls, doc_index, 2, tokens, source)
            continue
        emit_doc_decl(&buffer, doc_declaration, 2, doc_top_namespace, tokens, source, file.local_region_annotations, file.struct_names, file.struct_member_rows, file.struct_member_starts, file.struct_member_counts)
    # stage0 trims every trailing newline and then writes exactly one.
    while buffer.count > 0 and buffer[buffer.count - 1] == 10 |buffer|:
        buffer.pop()
    buffer.push(10)
    return emit_tokens_flush(buffer)


def emit_iface_report(file: Ast::File&, tokens: darray[Lexer::Token]&, source: u8&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    buffer: mutable darray[u8] = []
    alias_targets: mutable darray[sview] = []
    alias_lines: mutable darray[u32] = []
    for iface_using in file.enum_annotations |alias_targets, alias_lines, file|:
        if iface_using.name == "__using_alias_target":
            alias_targets.push(iface_using.owner)
            alias_lines.push(iface_using.line)
        elif iface_using.name == "__using":
            iface_aliased: mutable bool = false
            for iface_alias_probe in file.enum_annotations |iface_aliased, iface_using|:
                iface_aliased <- true if iface_alias_probe.name == "__using_alias_target" and iface_alias_probe.owner == iface_using.owner
            if not iface_aliased:
                alias_targets.push(iface_using.owner)
                alias_lines.push(iface_using.line)
    first_decl: mutable bool = true
    for iface_declaration in file.top_decls |buffer, tokens, source, alias_targets, alias_lines, first_decl|:
        iface_line: u32 = ast_decl_line(iface_declaration)
        for iface_alias_index in 0..<alias_targets.count |buffer, alias_targets, alias_lines, iface_line, first_decl|:
            if alias_lines[iface_alias_index] != 0 and alias_lines[iface_alias_index] < iface_line:
                emit_tokens_push_sview(buffer, "\n") if not first_decl
                first_decl <- false
                emit_tokens_push_sview(buffer, "using ")
                emit_tokens_push_sview(buffer, alias_targets[iface_alias_index])
                emit_tokens_push_sview(buffer, "\n")
                alias_lines[iface_alias_index] <- 0
        emit_tokens_push_sview(buffer, "\n") if not first_decl
        first_decl <- false
        emit_iface_decl(buffer, iface_declaration, 0, tokens, source)
    for iface_alias_tail in 0..<alias_targets.count |buffer, alias_targets, alias_lines, first_decl|:
        if alias_lines[iface_alias_tail] != 0:
            emit_tokens_push_sview(buffer, "\n") if not first_decl
            first_decl <- false
            emit_tokens_push_sview(buffer, "using ")
            emit_tokens_push_sview(buffer, alias_targets[iface_alias_tail])
            emit_tokens_push_sview(buffer, "\n")
    return 0 if buffer.count == 0 else emit_tokens_flush(buffer)


# Length of a NUL-terminated C string. Bounded so a missing terminator cannot spin.
def cstr_length(text: cstr) -> i64 can[Abort.Panic]:
    length: mutable i64 = 0
    for _step in 0..<1048576 |length, text|:
        break if text[length.usize()] == 0
        length <- length + 1
    return length


# Whole file by PATH. Returns an empty buffer when the path cannot be opened; the caller
# reports that as the usual "cannot read source" failure.
def read_file(path: cstr) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    contents: mutable darray[u8] = []
    descriptor: i64 = open(path, 0, 0)
    contents return if descriptor < 0
    chunk: mutable darray[u8] = []
    chunk.resize(8192)
    while true |contents, chunk, descriptor|:
        amount: i64 = read(descriptor, &chunk[0], 8192)
        break if amount <= 0
        for index in 0..<amount.usize() |contents, chunk|:
            contents.push(chunk[index])
    _ = close(descriptor)
    return contents


# Append a C string's bytes (without its terminator) to a buffer.
def push_cstr(buffer: mutable darray[u8]&, text: cstr) -> void can[Abort.Panic, Memory.Allocate]:
    length: i64 = cstr_length(text)
    for index in 0..<length |buffer, text|:
        buffer.push(text[index.usize()].u8())


# ---- native `include` expansion --------------------------------------------------------
#
# stage0 does this itself (readSourceWithIncludes); stage1 relied on the host wrapper to
# flatten first, which is why feeding an `include` straight to the binary reported
# "undefined identifier". A compiler that cannot resolve its own includes is not a drop-in
# replacement, however good its codegen is.
#
# Recursive, deduplicated (an already-included file is skipped, matching stage0's
# include-once behaviour), and resolved RELATIVE TO THE INCLUDING FILE's directory.

# The directory part of a path, with its trailing slash; empty when the path has none.
def path_directory(path: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    directory: mutable darray[u8] = []
    last_slash: mutable i64 = -1
    for index in 0..<path.count |last_slash, path|:
        last_slash <- index.i64() if path[index] == 47
    directory return if last_slash < 0
    for index in 0..<(last_slash + 1).usize() |directory, path|:
        directory.push(path[index])
    return directory


# Resolve `relative` against `base_directory` unless it is already absolute.
def resolve_include_path(base_directory: darray[u8]&, relative: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    resolved: mutable darray[u8] = []
    if relative.count > 0 and relative[0.usize()] == 47:
        for index in 0..<relative.count |resolved, relative|:
            resolved.push(relative[index])
        return resolved
    for index in 0..<base_directory.count |resolved, base_directory|:
        resolved.push(base_directory[index])
    for index in 0..<relative.count |resolved, relative|:
        resolved.push(relative[index])
    return normalize_path(resolved)


# Collapse `./` segments so the SAME file resolved along different paths compares equal.
# Without this a diamond include (`top` -> `mid` -> `sub/lib`, and `top` -> `sub/lib`)
# produced "dir/././sub/lib" and "dir/./sub/lib", the dedupe missed, and the second copy
# was spliced in — "duplicate declaration". `..` is deliberately NOT resolved: that needs
# real path canonicalisation, and leaving it alone only costs a missed dedupe, never a
# wrong file.
def normalize_path(path: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    normalized: mutable darray[u8] = []
    index: mutable usize = 0.usize()
    while index < path.count |index, normalized, path|:
        at_segment_start: bool = normalized.count == 0.usize() or normalized[normalized.count - 1.usize()] == 47
        if at_segment_start and path[index] == 46 and index + 1.usize() < path.count and path[index + 1.usize()] == 47:
            index <- index + 2.usize()
            continue
        normalized.push(path[index])
        index <- index + 1.usize()
    return normalized


def same_path(left: darray[u8]&, right: darray[u8]&) -> bool can[Abort.Panic]:
    false return if left.count != right.count
    for index in 0..<left.count |left, right|:
        false return if left[index] != right[index]
    return true


# The quoted path of an `include "..."` line (optionally `#include`, optionally indented),
# or an empty buffer when the line is not an include directive.
def include_directive_path(line: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    empty: mutable darray[u8] = []
    cursor: mutable usize = 0.usize()
    while cursor < line.count |cursor, line|:
        break if line[cursor] != 32 and line[cursor] != 9
        cursor <- cursor + 1.usize()
    cursor <- cursor + 1.usize() if cursor < line.count and line[cursor] == 35
    while cursor < line.count |cursor, line|:
        break if line[cursor] != 32 and line[cursor] != 9
        cursor <- cursor + 1.usize()
    keyword: sview = "include"
    empty return if cursor + 7.usize() > line.count
    for keyword_index in 0..<7 |empty, line, cursor, keyword|:
        empty return if line[cursor + keyword_index.usize()] != sview_at(keyword, keyword_index)
    cursor <- cursor + 7.usize()
    empty return if cursor >= line.count or (line[cursor] != 32 and line[cursor] != 9)
    while cursor < line.count |cursor, line|:
        break if line[cursor] != 32 and line[cursor] != 9
        cursor <- cursor + 1.usize()
    empty return if cursor >= line.count or line[cursor] != 34
    cursor <- cursor + 1.usize()
    captured: mutable darray[u8] = []
    while cursor < line.count |cursor, line, captured|:
        break if line[cursor] == 34
        captured.push(line[cursor])
        cursor <- cursor + 1.usize()
    empty return if cursor >= line.count or line[cursor] != 34
    return captured


# Whether `path` already appears in the NUL-separated `seen` buffer.
def path_already_seen(seen: darray[u8]&, path: darray[u8]&) -> bool can[Abort.Panic]:
    start: mutable usize = 0.usize()
    index: mutable usize = 0.usize()
    while index < seen.count |index, start, seen, path|:
        if seen[index] == 0:
            if index - start == path.count:
                matched: mutable bool = true
                for offset in 0..<path.count |matched, seen, path, start|:
                    matched <- false if seen[start + offset] != path[offset]
                true return if matched
            start <- index + 1.usize()
        index <- index + 1.usize()
    return false


# Append `path`'s contents to `out`, splicing any includes it names. `seen` accumulates the
# already-included paths so a diamond include contributes once and a cycle terminates.
def expand_includes(path: darray[u8]&, out: mutable darray[u8]&, seen: mutable darray[u8]&, depth: i64) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    false return if depth > 64
    true return if path_already_seen(seen, path)
    # Record the path by APPENDING its bytes plus a NUL. A `darray[darray[u8]]` would need
    # each entry allocated in a region outliving the table, which the region checker
    # correctly rejects for a locally-built buffer; one flat buffer sidesteps the
    # ownership question entirely.
    for index in 0..<path.count |seen, path|:
        seen.push(path[index])
    seen.push(0)
    path_c: mutable darray[u8] = []
    for index in 0..<path.count |path_c, path|:
        path_c.push(path[index])
    path_c.push(0)
    contents: darray[u8] = read_file((&path_c[0]).cast[cstr] can Unsafe.PointerCast)
    false return if contents.count == 0
    directory: darray[u8] = path_directory(path)
    line: mutable darray[u8] = []
    index: mutable usize = 0.usize()
    while index <= contents.count |index, contents, line, out, seen, directory, depth|:
        at_end: bool = index == contents.count
        byte: u8 = 10 if at_end else contents[index]
        if byte == 10:
            included: darray[u8] = include_directive_path(line)
            if included.count > 0:
                resolved: darray[u8] = resolve_include_path(directory, included)
                _ = expand_includes(resolved, out, seen, depth + 1)
            else:
                for line_index in 0..<line.count |out, line|:
                    out.push(line[line_index])
                out.push(10)
            line <- []
        else:
            line.push(byte)
        index <- index + 1.usize()
    return true


# ---- `elisac-stage1 init NAME [--path DIR] [--strict]` ---------------------------------
#
# stage0's project scaffold, byte for byte: project.json, src/main.elisa, and empty
# lib/ and test/ marked with .gitkeep.

def write_file(path: darray[u8]&, contents: sview) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    path_c: mutable darray[u8] = []
    for index in 0..<path.count |path_c, path|:
        path_c.push(path[index])
    path_c.push(0)
    path_cstr: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
    descriptor: i64 = open(path_cstr, 1537, 420)
    false return if descriptor < 0
    bytes: mutable darray[u8] = []
    for byte_index in 0..<sview_len(contents) |bytes, contents|:
        bytes.push(sview_at(contents, byte_index))
    if bytes.count > 0:
        raw: void& = (&bytes[0]).cast[void&] can Unsafe.PointerCast
        _ = write(descriptor, raw, bytes.count)
    _ = close(descriptor)
    return true


def make_directory(path: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    # Creates INTERMEDIATE directories, like `mkdir -p`. mkdir(2) creates ONE level and
    # fails with ENOENT when a parent is missing, so `init app --path custom/demo` used to
    # create nothing at all and still exit 0 — a silent failure that produced no project
    # and no message. Every prefix ending at a `/` is created in turn before the full path.
    path_c: mutable darray[u8] = []
    for index in 0..<path.count |path_c, path|:
        path_c.push(path[index])
    path_c.push(0)
    for separator_index in 1..<path.count |path_c, path|:
        continue if path[separator_index] != 47
        # Terminate at this separator, create the prefix, then restore the byte. The cast is
        # its OWN statement: an inline `.cast[T] can Effect` inside an argument list does not
        # parse in this dialect.
        path_c[separator_index] <- 0
        prefix_cstr: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
        _ = mkdir(prefix_cstr, 493.u16())
        path_c[separator_index] <- 47
    path_cstr: cstr = (&path_c[0]).cast[cstr] can Unsafe.PointerCast
    # 0755. An existing directory answers EEXIST, which is fine — init is idempotent.
    _ = mkdir(path_cstr, 493.u16())


def joined_path(base: darray[u8]&, leaf: sview) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    joined: mutable darray[u8] = []
    for index in 0..<base.count |joined, base|:
        joined.push(base[index])
    joined.push(47)
    for leaf_index in 0..<sview_len(leaf) |joined, leaf|:
        joined.push(sview_at(leaf, leaf_index))
    return joined


# joined_path for a leaf that is BUILT rather than literal — `init-lib` derives its file
# names from the library name, so the leaf is a buffer, not an sview.
def joined_path_bytes(base: darray[u8]&, leaf: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    joined: mutable darray[u8] = []
    for index in 0..<base.count |joined, base|:
        joined.push(base[index])
    joined.push(47)
    for leaf_index in 0..<leaf.count |joined, leaf|:
        joined.push(leaf[leaf_index])
    return joined


def run_init(argc: i64, argv: mutable void&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    slots: mutable cstr&& = argv.cast[mutable cstr&&]
    project_name: mutable darray[u8] = []
    base_directory: mutable darray[u8] = []
    strict: mutable bool = false
    index: mutable i64 = 2
    rejected: mutable bool = false
    while index < argc |index, slots, project_name, base_directory, strict, rejected|:
        argument: cstr = slots[index].cast[cstr]
        if argument == "--strict":
            strict <- true
        elif argument == "--path" and index + 1 < argc:
            index <- index + 1
            push_cstr(&base_directory, slots[index].cast[cstr])
        elif argument[0] != 45 and project_name.count == 0:
            push_cstr(&project_name, argument)
        elif argument[0] == 45:
            # REJECT an unknown flag rather than ignore it. Ignoring meant
            # `init demo --bogus` scaffolded a project and exited 0, so a typo in a flag
            # name silently produced a project configured differently from the one asked
            # for. stage0 rejects; so does this.
            rejected <- true
        index <- index + 1
    # Exit 1, matching stage0. This returned 2, which callers distinguish from a normal
    # usage error.
    if project_name.count == 0 or rejected:
        usage: mutable darray[u8] = []
        for usage_index in 0..<sview_len("usage: elisac init <name> [--path <dir>] [--strict]\n") |usage|:
            usage.push(sview_at("usage: elisac init <name> [--path <dir>] [--strict]\n", usage_index))
        write_stderr(usage)
        return 1
    # `--path DIR` puts the project at DIR/NAME. The separator has to be pushed explicitly;
    # an earlier version reused joined_path and lost it, producing "customdemo".
    root: mutable darray[u8] = []
    if base_directory.count > 0:
        make_directory(base_directory)
        for base_index in 0..<base_directory.count |root, base_directory|:
            root.push(base_directory[base_index])
        root.push(47) if root[root.count - 1.usize()] != 47
    for name_index in 0..<project_name.count |root, project_name|:
        root.push(project_name[name_index])
    make_directory(root)
    source_directory: darray[u8] = joined_path(root, "src")
    library_directory: darray[u8] = joined_path(root, "lib")
    test_directory: darray[u8] = joined_path(root, "test")
    # `build` and `native` are created EMPTY (no .gitkeep). They were missed on the first
    # pass because the scaffold was read with `find -type f`, which cannot see a directory
    # holding no files — the spec looked complete and was not.
    build_directory: darray[u8] = joined_path(root, "build")
    native_directory: darray[u8] = joined_path(root, "native")
    make_directory(source_directory)
    make_directory(library_directory)
    make_directory(test_directory)
    make_directory(build_directory)
    make_directory(native_directory)
    project_body: sview = "{\n  \"version\": \"0.1.0\",\n  \"dependency-search-paths\": [\n    \"lib\"\n  ],\n  \"include-dirs\": [\n    \"src\"\n  ],\n  \"targets\": {\n    \"app\": {\n      \"entry\": \"src/main.elisa\",\n      \"emit\": \"llvm\",\n      \"run-emit\": \"interpret\",\n      \"output\": \"build/app.ll\",\n      \"opt\": \"O0\"\n    }\n  }\n}\n"
    strict_body: sview = "{\n  \"version\": \"0.1.0\",\n  \"dependency-search-paths\": [\n    \"lib\"\n  ],\n  \"include-dirs\": [\n    \"src\"\n  ],\n  \"targets\": {\n    \"app\": {\n      \"entry\": \"src/main.elisa\",\n      \"emit\": \"llvm\",\n      \"run-emit\": \"interpret\",\n      \"output\": \"build/app.ll\",\n      \"opt\": \"O0\",\n      \"warnings\": {\n        \"strict\": true\n      }\n    }\n  }\n}\n"
    # Bind each joined path to a local first: write_file borrows, and a temporary built in
    # the argument list is not a place the callee can borrow from.
    project_path: darray[u8] = joined_path(root, "project.json")
    main_path: darray[u8] = joined_path(source_directory, "main.elisa")
    library_keep: darray[u8] = joined_path(library_directory, ".gitkeep")
    test_keep: darray[u8] = joined_path(test_directory, ".gitkeep")
    _ = write_file(project_path, strict_body if strict else project_body)
    _ = write_file(main_path, "def main() -> int:\n    return 0\n")
    _ = write_file(library_keep, "")
    _ = write_file(test_keep, "")
    return 0


# `elisac init-lib <name> [--path <dir>]` — the LIBRARY scaffold, a different shape from
# `init`'s application one: a `<name>.elisalib` bundle directory holding a manifest, a
# README, and a src/ with a source and its matching `.elisai` interface. There is no
# `--strict`, no project.json, and no build/native/test/lib tree.
def run_init_lib(argc: i64, argv: mutable void&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    slots: mutable cstr&& = argv.cast[mutable cstr&&]
    library_name: mutable darray[u8] = []
    base_directory: mutable darray[u8] = []
    index: mutable i64 = 2
    rejected: mutable bool = false
    while index < argc |index, slots, library_name, base_directory, rejected|:
        argument: cstr = slots[index].cast[cstr]
        if argument == "--path" and index + 1 < argc:
            index <- index + 1
            push_cstr(&base_directory, slots[index].cast[cstr])
        elif argument[0] != 45 and library_name.count == 0:
            push_cstr(&library_name, argument)
        elif argument[0] == 45:
            rejected <- true
        index <- index + 1
    if library_name.count == 0 or rejected:
        usage: mutable darray[u8] = []
        for usage_index in 0..<sview_len("usage: elisac init-lib <name> [--path <dir>]\n") |usage|:
            usage.push(sview_at("usage: elisac init-lib <name> [--path <dir>]\n", usage_index))
        write_stderr(usage)
        return 1
    root: mutable darray[u8] = []
    if base_directory.count > 0:
        make_directory(base_directory)
        for base_index in 0..<base_directory.count |root, base_directory|:
            root.push(base_directory[base_index])
        root.push(47) if root[root.count - 1.usize()] != 47
    for name_index in 0..<library_name.count |root, library_name|:
        root.push(library_name[name_index])
    for suffix_index in 0..<sview_len(".elisalib") |root|:
        root.push(sview_at(".elisalib", suffix_index))
    make_directory(root)
    source_directory: darray[u8] = joined_path(root, "src")
    make_directory(source_directory)
    # `native/` is created EMPTY, so `find -type f` cannot see it — the same trap the
    # `init` scaffold hit. It is part of stage0's bundle and a `diff -r` catches its
    # absence where a file listing does not.
    native_directory: darray[u8] = joined_path(root, "native")
    make_directory(native_directory)
    # The bundle CONTENTS are written by a helper so their buffers nest inside `root`'s
    # lifetime instead of interleaving with it — the inferred region rejects overlapping
    # growable locals once the stack budget is spent.
    return write_init_lib_files(source_directory, root, library_name)


def write_init_lib_files(source_directory: darray[u8]&, root: darray[u8]&, library_name: darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    # One file per helper. Each of these builds two growable buffers (a path and a body),
    # which is already the practical ceiling before the inferred region reports their live
    # ranges as interleaved — writing all four inline does not compile.
    write_init_lib_manifest(root, library_name)
    write_init_lib_readme(root, library_name)
    write_init_lib_source(source_directory, library_name)
    write_init_lib_interface(source_directory, library_name)
    return 0


# `<name>` followed by a literal suffix, appended to an existing buffer so the caller keeps
# the only growable.
def push_name_with_suffix(buffer: mutable darray[u8]&, library_name: darray[u8]&, suffix: sview) -> void can[Abort.Panic, Memory.Allocate]:
    for name_index in 0..<library_name.count |buffer, library_name|:
        buffer.push(library_name[name_index])
    emit_tokens_push_sview(buffer, suffix)


def write_init_lib_manifest(root: darray[u8]&, library_name: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    manifest: mutable darray[u8] = []
    emit_tokens_push_sview(&manifest, "{\n  \"provides\": \"")
    push_name_with_suffix(&manifest, library_name, "\",\n  \"entry\": \"src/")
    push_name_with_suffix(&manifest, library_name, ".elisa\",\n  \"interface\": \"src/")
    push_name_with_suffix(&manifest, library_name, ".elisai\",\n  \"include-dirs\": [\n    \"src\"\n  ]\n}\n")
    manifest_path: darray[u8] = joined_path(root, "manifest.json")
    _ = write_file_bytes(manifest_path, manifest)


def write_init_lib_readme(root: darray[u8]&, library_name: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    readme: mutable darray[u8] = []
    emit_tokens_push_sview(&readme, "# ")
    push_name_with_suffix(&readme, library_name, "\n")
    readme_path: darray[u8] = joined_path(root, "README.md")
    _ = write_file_bytes(readme_path, readme)


def write_init_lib_source(source_directory: darray[u8]&, library_name: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    body: mutable darray[u8] = []
    emit_tokens_push_sview(&body, "def ")
    push_name_with_suffix(&body, library_name, "_value() -> int:\n    return 1\n")
    source_path: mutable darray[u8] = []
    push_derived_bundle_path(&source_path, source_directory, library_name, ".elisa")
    _ = write_file_bytes(source_path, body)


def write_init_lib_interface(source_directory: darray[u8]&, library_name: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    body: mutable darray[u8] = []
    emit_tokens_push_sview(&body, "extern ")
    push_name_with_suffix(&body, library_name, "_value() -> int\n")
    interface_path: mutable darray[u8] = []
    push_derived_bundle_path(&interface_path, source_directory, library_name, ".elisai")
    _ = write_file_bytes(interface_path, body)


# `<directory>/<name><extension>`, appended in place.
def push_derived_bundle_path(buffer: mutable darray[u8]&, directory: darray[u8]&, library_name: darray[u8]&, extension: sview) -> void can[Abort.Panic, Memory.Allocate]:
    for directory_index in 0..<directory.count |buffer, directory|:
        buffer.push(directory[directory_index])
    buffer.push(47)
    push_name_with_suffix(buffer, library_name, extension)




# The emit modes this driver actually implements. stage0 has more; claiming them here by
# silently falling through to the object path would be worse than saying no.
# `-emit exe`: compile to a temporary object, then LINK it against the runtime with the
# host clang, plus any -link/-L/-l the caller passed. Linking is host tooling — stage0 has
# no `exe` mode of its own; this matches what scripts/elisac_stage1.sh does, moved into the
# compiler so a CLI user gets a runnable binary without the wrapper.
def link_executable(object_path: darray[u8]&, exe_path: darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    command: mutable darray[u8] = []
    for prefix_index in 0..<sview_len("clang -Wl,-dead_strip -o ") |command|:
        command.push(sview_at("clang -Wl,-dead_strip -o ", prefix_index))
    for exe_index in 0..<exe_path.count |command, exe_path|:
        command.push(exe_path[exe_index])
    command.push(32)
    for object_index in 0..<object_path.count |command, object_path|:
        command.push(object_path[object_index])
    command.push(32)
    # The runtime object. ELISA_STAGE1_RUNTIME_OBJ overrides the repo-relative default so a
    # caller outside the tree can still link.
    runtime_storage: mutable darray[u8] = []
    if not env_value("ELISA_STAGE1_RUNTIME_OBJ", &runtime_storage):
        for default_index in 0..<sview_len("build/runtime/elisacore_runtime.o") |runtime_storage|:
            runtime_storage.push(sview_at("build/runtime/elisacore_runtime.o", default_index))
    for runtime_index in 0..<runtime_storage.count |command, runtime_storage|:
        command.push(runtime_storage[runtime_index])
    link_storage: mutable darray[u8] = []
    if env_value("ELISA_STAGE1_LINK", &link_storage):
        command.push(32)
        for link_index in 0..<link_storage.count |command, link_storage|:
            command.push(link_storage[link_index])
    command.push(0)
    command_c: cstr = (&command[0]).cast[cstr] can Unsafe.PointerCast
    status: i64 = system(command_c)
    object_c: mutable darray[u8] = []
    for object_index in 0..<object_path.count |object_c, object_path|:
        object_c.push(object_path[object_index])
    object_c.push(0)
    object_cstr: cstr = (&object_c[0]).cast[cstr] can Unsafe.PointerCast
    _ = unlink(object_cstr)
    return 0 if status == 0 else 8


# Shared reader for the ELISA_STAGE1_* string variables. Appends to `storage` and reports
# whether anything was found.
def env_value(name: sview, storage: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag_storage: mutable darray[u8] = []
    for flag_index in 0..<sview_len(name) |flag_storage, name|:
        flag_storage.push(sview_at(name, flag_index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is value_bytes:
        cursor: mutable i64 = 0
        keep_scanning: mutable bool = true
        while keep_scanning |cursor, keep_scanning, storage, value_bytes|:
            byte_ref: u8& = value_bytes + cursor
            value_byte: u8 = byte_ref
            if value_byte == 0:
                keep_scanning <- false
            else:
                storage.push(value_byte)
                cursor <- cursor + 1
    return storage.count > 0


def cli_emit_mode_supported(mode: cstr) -> bool can[Abort.Panic]:
    true return if mode == "obj"
    true return if mode == "llvm"
    true return if mode == "bc"
    true return if mode == "tokens"
    true return if mode == "ast"
    true return if mode == "iface"
    true return if mode == "fmt"
    true return if mode == "deps"
    true return if mode == "deps-json"
    true return if mode == "doc"
    true return if mode == "header"
    true return if mode == "test-runner"
    true return if mode == "tests"
    true return if mode == "benches"
    true return if mode == "fixtures"
    true return if mode == "c-bind-check"
    true return if mode == "c-bind-check-json"
    true return if mode == "packed"
    true return if mode == "unsafe"
    true return if mode == "c-archive"
    true return if mode == "lowered"
    true return if mode == "progress"
    true return if mode == "interpret"
    true return if mode == "exe"
    return false


# Parse `elisac-stage1 [-emit MODE] [-o OUT] [-O0|-O1|-O2|-O3] SOURCE` and build the SAME
# buffer the stdin wire protocol produces: output path, newline, source bytes, NUL. Every
# downstream stage is therefore untouched by the CLI existing — the two front doors meet
# immediately and share one compile path.
#
# Unknown `-flags` are IGNORED rather than rejected: the host wrapper passes through
# linker/target options this driver does not implement yet, and failing on them would make
# the CLI less usable than the wrapper it replaces.
def cli_request(argc: i64, argv: mutable void&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    request: mutable darray[u8] = []
    slots: mutable cstr&& = argv.cast[mutable cstr&&]
    output_path: mutable darray[u8] = []
    link_flags: mutable darray[u8] = []
    source_index: mutable i64 = 0
    index: mutable i64 = 1
    while index < argc |index, slots, output_path, source_index|:
        argument: cstr = slots[index].cast[cstr]
        if argument == "-o" and index + 1 < argc:
            index <- index + 1
            push_cstr(&output_path, slots[index].cast[cstr])
            _ = setenv("ELISA_STAGE1_OUT", slots[index].cast[cstr], 1)
        elif argument == "-filter" and index + 1 < argc:
            # Only `-emit test-runner` consumes it today; stage0 rejects it for any mode
            # that cannot use it, which is checked below once the mode is known.
            index <- index + 1
            _ = setenv("ELISA_STAGE1_FILTER", slots[index].cast[cstr], 1)
        elif argument == "-emit" and index + 1 < argc:
            index <- index + 1
            requested_mode: cstr = slots[index].cast[cstr]
            # REJECT an unsupported mode instead of ignoring it. Ignoring meant `-emit
            # lowered` silently produced a Mach-O OBJECT at the path the caller expected a
            # text dump at — a wrong answer that looks like success, and it made every
            # unimplemented mode read as "supported" when probed by exit code. stage0
            # rejects unknown modes; so does this.
            if not cli_emit_mode_supported(requested_mode):
                message: mutable darray[u8] = []
                for prefix_index in 0..<sview_len("unsupported -emit mode: ") |message|:
                    message.push(sview_at("unsupported -emit mode: ", prefix_index))
                push_cstr(&message, requested_mode)
                for suffix_index in 0..<sview_len("\nsupported: obj llvm bc tokens ast iface fmt doc header test-runner tests benches fixtures c-bind-check c-bind-check-json packed unsafe c-archive lowered progress interpret deps deps-json\n") |message|:
                    message.push(sview_at("\nsupported: obj llvm bc tokens ast iface fmt doc header test-runner tests benches fixtures c-bind-check c-bind-check-json packed unsafe c-archive lowered progress interpret deps deps-json\n", suffix_index))
                write_stderr(message)
                return request
            _ = setenv("ELISA_STAGE1_EMIT", requested_mode, 1)
        elif (argument == "-link" or argument == "-L" or argument == "-l") and index + 1 < argc:
            # Linker passthrough. Accumulated into ELISA_STAGE1_LINK as a space-separated
            # string; `-L`/`-l` keep their prefix so the flag reaches clang as written.
            link_prefix: sview = "" if argument == "-link" else ("-L" if argument == "-L" else "-l")
            index <- index + 1
            link_flags.push(32) if link_flags.count > 0
            for prefix_index in 0..<sview_len(link_prefix) |link_flags, link_prefix|:
                link_flags.push(sview_at(link_prefix, prefix_index))
            push_cstr(&link_flags, slots[index].cast[cstr])
        elif argument == "-target-triple" and index + 1 < argc:
            # CROSS-COMPILATION. The backend already accepted a requested triple
            # (configure_module_target_for) and initializes the AArch64/ARM/x86/RISCV/wasm
            # target families; nothing ever passed one, so stage1 could only ever emit for
            # the host.
            index <- index + 1
            _ = setenv("ELISA_STAGE1_TRIPLE", slots[index].cast[cstr], 1)
        elif argument == "-O0":
            _ = setenv("ELISA_STAGE1_OPT", "0", 1)
        elif argument == "-O1":
            _ = setenv("ELISA_STAGE1_OPT", "1", 1)
        elif argument == "-O2":
            _ = setenv("ELISA_STAGE1_OPT", "2", 1)
        elif argument == "-O3":
            _ = setenv("ELISA_STAGE1_OPT", "3", 1)
        elif argument[0] != 45:
            source_index <- index
            # Diagnostics name the file. The wrapper already set this for its own callers;
            # the CLI must set it too or a CLI-compiled program reports a bare line number.
            _ = setenv("ELISA_STAGE1_SRC", argument, 1)
        index <- index + 1
    if link_flags.count > 0:
        link_flags.push(0)
        link_flags_c: cstr = (&link_flags[0]).cast[cstr] can Unsafe.PointerCast
        _ = setenv("ELISA_STAGE1_LINK", link_flags_c, 1)
    request return if source_index == 0
    source_path: cstr = slots[source_index].cast[cstr]
    # Default output mirrors stage0's: the source path with the emit-appropriate suffix is
    # the WRAPPER's business, so with no -o the compile still needs a destination; use the
    # source path plus ".o" rather than inventing a name the caller cannot predict.
    if output_path.count == 0:
        push_cstr(&output_path, source_path)
        output_path.push(46)
        output_path.push(111)
    # Expand includes HERE, natively, rather than requiring the caller to pre-flatten.
    # Falls back to the raw file when expansion finds nothing to do, so a single-file
    # program takes the same path it always did.
    source_path_bytes: mutable darray[u8] = []
    push_cstr(&source_path_bytes, source_path)
    included_seen: mutable darray[u8] = []
    expanded_source: mutable darray[u8] = []
    contents: mutable darray[u8] = expanded_source if expand_includes(source_path_bytes, &expanded_source, &included_seen, 0) else read_file(source_path)
    request return if contents.count == 0
    for path_index in 0..<output_path.count |request, output_path|:
        request.push(output_path[path_index])
    request.push(10)
    for content_index in 0..<contents.count |request, contents|:
        request.push(contents[content_index])
    request.push(0)
    return request


def read_all() -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    buf: mutable darray[u8] = []
    chunk: mutable darray[u8] = []
    chunk.resize(8192)
    while true |buf, chunk|:
        n: i64 = read(0, &chunk[0], 8192)
        break if n <= 0
        for index in 0..<n.usize() |buf, chunk|:
            buf.push(chunk[index])
    buf.push(0)
    return buf


# `-emit deps` / `-emit deps-json`: the resolved include CLOSURE, root first, in include
# order. stage0 emits this natively; stage1 had it only as PYTHON inside the host wrapper,
# which meant the compiler could not answer "what does this file depend on" on its own.
#
# expand_includes already walks exactly this graph and records each file once, so deps is
# that walk with its `seen` buffer printed instead of its expanded source.
def emit_deps_report(json_form: bool) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    source_path_bytes: mutable darray[u8] = []
    1 return if not push_source_path(&source_path_bytes)
    seen: mutable darray[u8] = []
    scratch: mutable darray[u8] = []
    1 return if not expand_includes(source_path_bytes, &scratch, &seen, 0)
    out: mutable darray[u8] = []
    if not json_form:
        for byte_index in 0..<seen.count |out, seen|:
            out.push(10) if seen[byte_index] == 0 else out.push(seen[byte_index])
        return emit_tokens_flush(out)
    # stage0's JSON names the ROOT and then lists EVERY file, the root included — so the
    # root appears twice, once per field. Two scans rather than one, because the root is
    # not a special case in `files`.
    for prefix_index in 0..<sview_len("{\n  \"root\": \"") |out|:
        out.push(sview_at("{\n  \"root\": \"", prefix_index))
    root_index: mutable usize = 0.usize()
    while root_index < seen.count |root_index, out, seen|:
        break if seen[root_index] == 0
        out.push(seen[root_index])
        root_index <- root_index + 1.usize()
    for files_index in 0..<sview_len("\",\n  \"files\": [\n") |out|:
        out.push(sview_at("\",\n  \"files\": [\n", files_index))
    index: mutable usize = 0.usize()
    start: mutable usize = 0.usize()
    entry_number: mutable i64 = 0
    while index < seen.count |index, start, out, seen, entry_number|:
        if seen[index] == 0:
            if entry_number > 0:
                for sep_index in 0..<sview_len(",\n") |out|:
                    out.push(sview_at(",\n", sep_index))
            for quote_index in 0..<sview_len("    \"") |out|:
                out.push(sview_at("    \"", quote_index))
            for byte_index in start..<index |out, seen|:
                out.push(seen[byte_index])
            out.push(34)
            entry_number <- entry_number + 1
            start <- index + 1.usize()
        index <- index + 1.usize()
    for tail_index in 0..<sview_len("\n  ]\n}\n") |out|:
        out.push(sview_at("\n  ]\n}\n", tail_index))
    return emit_tokens_flush(out)


def main(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    # TWO front doors, ONE compile path. With arguments this is an ordinary CLI; with none
    # it is the original stdin wire protocol, which the host wrapper and the bootstrap both
    # still use. cli_request builds exactly the buffer read_all would have produced, so
    # nothing downstream can tell the difference.
    # `init` is a SUBCOMMAND, not a compile: it consumes the rest of argv itself.
    if argc > 1:
        first_argument: mutable cstr&& = argv.cast[mutable cstr&&]
        run_init(argc, argv) return if first_argument[1].cast[cstr] == "init"
        run_init_lib(argc, argv) return if first_argument[1].cast[cstr] == "init-lib"
    raw: darray[u8] = cli_request(argc, argv) if argc > 1 else read_all()
    # `-emit deps`/`deps-json` answer from the include graph alone — no parse, no analysis.
    # Placed after cli_request so the CLI has recorded the source path it walks from.
    emit_deps_report(false) return if emit_mode_is("deps")
    emit_deps_report(true) return if emit_mode_is("deps-json")
    1 return if raw.count <= 1

    out_path: mutable darray[u8] = []
    i: mutable usize = 0
    while i < raw.count - 1 |i, out_path|:
        b: u8 = raw[i]
        break if b == 10
        out_path.push(b)
        i <- i + 1
    1 return if out_path.count == 0
    path_len: i64 = out_path.count.i64()
    out_path.push(0)
    i <- i + 1 if i < raw.count - 1 and raw[i] == 10
    source_start: usize = i
    source_len: usize = raw.count - 1 - source_start
    1 return if source_len == 0

    src_ptr: u8& = &raw[source_start]
    tokens: darray[Lexer::Token] = frontend_tokenize_with_length(src_ptr, src_ptr, source_len)
    # `-emit tokens` is the LEXER oracle: report and stop before parsing, as stage0 does.
    if emit_mode_is("tokens"):
        return emit_tokens_report(tokens)
    # The unparser needs stage0's grouping nodes; the compile path must not see them.
    # Safe because `-emit fmt` returns below, before the semantic gate and codegen.
    parser_set_preserve_parens(emit_mode_is("fmt") or emit_mode_is("lowered"))
    file: mutable Ast::File = frontend_parser_parse_file(src_ptr, tokens)
    if file.errors.count != 0:
        for parse_error_index in 0..<file.errors.count |file|:
            report_parse_error(file.errors[parse_error_index])
        return 1

    # `-emit ast` prints the parse-tree summary and stops, as stage0 does.
    if emit_mode_is("ast"):
        return emit_ast_report(file, tokens, src_ptr)
    if emit_mode_is("iface"):
        return emit_iface_report(file, tokens, src_ptr)
    # `-emit doc` renders the AST as markdown and stops, as stage0 does. Placed beside the
    # other report modes: they all return BEFORE `static generate` expansion, so the page
    # describes what was WRITTEN rather than what was generated.
    if emit_mode_is("doc"):
        return emit_doc_report(file, tokens, src_ptr)
    # `-emit header` runs the backend's struct registration, so it sits with the other
    # report modes but needs no codegen.
    if emit_mode_is("header"):
        return emit_header_report(file)
    # `-emit test-runner` echoes the unit and appends a synthesized `ctx_test_main`.
    if emit_mode_is("test-runner"):
        return emit_test_runner_report(file, src_ptr, source_len)
    # `-emit tests` / `benches` / `fixtures` list the matching annotated functions.
    if emit_mode_is("tests"):
        return emit_annotated_report(file, "test", tokens, src_ptr)
    if emit_mode_is("benches"):
        return emit_annotated_report(file, "bench", tokens, src_ptr)
    if emit_mode_is("fixtures"):
        return emit_annotated_report(file, "fixture", tokens, src_ptr)
    # `-emit c-bind-check` compares each `@c_bind` struct's layout against the real C one.
    if emit_mode_is("c-bind-check"):
        return emit_c_bind_report(file, tokens, src_ptr, false)
    if emit_mode_is("c-bind-check-json"):
        return emit_c_bind_report(file, tokens, src_ptr, true)
    # `-emit c-archive` bundles the object, the runtime, and the audit sidecars.
    if emit_mode_is("c-archive"):
        return emit_c_archive(file, tokens, src_ptr, out_path)
    # `-emit interpret` runs the program and reports `main`'s result.
    if emit_mode_is("interpret"):
        return emit_interpret(file, out_path)
    # `-emit progress` reports each function's loop obligations and their evidence.
    if emit_mode_is("progress"):
        return emit_progress_report(file)
    # `-emit unsafe` reports the per-function Unsafe.* capability closure.
    if emit_mode_is("unsafe"):
        return emit_unsafe_report(file, tokens, src_ptr)
    # `-emit packed` describes the packed lowering profile and each packed enum's row layout.
    if emit_mode_is("packed"):
        packed_ctx: LLVMContextRef = LLVMContextCreate()
        packed_module: LLVMModuleRef = LLVMModuleCreateWithNameInContext("elisac_stage1_packed", packed_ctx)
        packed_report: darray[u8] = Backend::generate_packed_report(file, packed_module, packed_ctx)
        packed_body: mutable darray[u8] = []
        for packed_index in 0..<packed_report.count |packed_body, packed_report|:
            packed_body.push(packed_report[packed_index]) if packed_report[packed_index] != 0
        return emit_tokens_flush(packed_body)
    # `-emit fmt` runs the unparser; every unported shape prints a loud <fmt-*-todo>
    # marker, so partial coverage can never read as byte parity in the smoke.
    # `-emit lowered` is stage0's fmt of the ANALYSED AST. stage1's semantic layer does not
    # desugar the tree in place (stage0's does: UFCS, overload mangling, address-of), so this
    # emits the UNLOWERED rendering — which is EXACTLY right for the 41 of 56 corpus fixtures
    # where stage0's own fmt and lowered outputs are identical, i.e. where no lowering
    # applies. The gate ratchets that count rather than claiming parity it does not have.
    if emit_mode_is("fmt") or emit_mode_is("lowered"):
        fmt_buffer: mutable darray[u8] = []
        FmtUnparse::fmt_file(fmt_buffer, file, tokens, src_ptr)
        return 0 if fmt_buffer.count == 0 else emit_tokens_flush(fmt_buffer)

    # `static generate` expansion. The pass has existed since task #35 but was wired ONLY into
    # test/breadth/parse_report.elisa — never into this driver — so every `static generate:`
    # block was silently skipped and its generated names came back as "undefined identifier".
    #
    # Placed AFTER the `-emit fmt` return on purpose: the unparser must see the ORIGINAL source
    # (it round-trips what was written, not what was generated), and `-emit tokens`/`ast`/`iface`
    # have already returned above for the same reason.
    #
    # Recognized blocks are spliced into an expanded source and re-parsed ONCE, so generated
    # declarations flow through the semantic gate and codegen exactly like hand-written ones.
    # `expanded` is declared here so the generated declarations' source spans outlive the parse;
    # unrecognized blocks copy through and the pass answers false, leaving everything untouched.
    expanded: mutable darray[u8] = []
    expanded_tokens: mutable darray[Lexer::Token] = []
    expanded_src_ptr: mutable u8& = src_ptr
    if frontend_preprocess_static_generate(src_ptr, source_len, tokens, file, expanded):
        expanded_src_ptr <- &expanded[0]
        expanded_tokens <- frontend_tokenize_with_length(expanded_src_ptr, expanded_src_ptr, expanded.count)
        file <- frontend_parser_parse_file(expanded_src_ptr, expanded_tokens)
        if file.errors.count != 0:
            for parse_error_index in 0..<file.errors.count |file|:
                report_parse_error(file.errors[parse_error_index])
            return 1

    # Analyse before emitting, as stage0 does: exit 1 on any ERROR-severity finding
    # (severity 1); warnings (2) do not block. Status codes only — see the note on
    # `puts` below — so this reproduces the accept/reject DECISION, not the message.
    #
    # OPT-IN while stage1's semantic layer still OVER-reports relative to stage0 on the
    # compiler's own source (642 findings where stage0 makes none; 437 are severity-2
    # warnings, and the rest are being worked through cluster by cluster). With the gate
    # ON, 40 of the 44 diagnostics fixtures stage1 wrongly ACCEPTED are now correctly
    # rejected (292 cases: 222 -> 258 agreeing with stage0).
    if semantic_gate_enabled():
        table: Semantic::SymbolTable = Semantic::check_full(file, false, false, runtime_std_enabled(src_ptr, source_len), false, false, false, false, false, false, false, 64)
        semantic_errors: mutable i64 = 0
        for diagnostic in table.diagnostics |semantic_errors|:
            continue if Semantic::diagnostic_severity(diagnostic) != 1
            semantic_errors <- semantic_errors + 1
            report_diagnostic(diagnostic)
        1 return if semantic_errors > 0

    ctx: LLVMContextRef = LLVMContextCreate()
    module_handle: LLVMModuleRef = LLVMModuleCreateWithNameInContext("elisac_stage1", ctx)
    builder: LLVMBuilderRef = LLVMCreateBuilderInContext(ctx)
    emitted_count: i64 = Backend::emit_module(file, module_handle, ctx, builder)
    # Status codes only (no puts/write): logging via libc puts conflicts with
    # elisacore_std's puts overload under stage1 meta-compile / stage0 seed.
    # A unit with no function at all emits nothing BY CONSTRUCTION — see
    # unit_declares_function. Only a unit that HAS one and emitted none has failed.
    2 return if emitted_count <= 0 and unit_declares_function(file.top_decls)

    triple_storage: mutable darray[u8] = []
    machine: LLVMTargetMachineRef = Backend::configure_module_target_for(module_handle, requested_target_triple(&triple_storage))
    # The pass pipeline runs only when ASKED (ELISA_STAGE1_OPT=1/2/3). It was disabled
    # outright while `default<O2>` trapped on large self-host modules — those traps were
    # the opaque-handle `==` and arena-identity miscompiles in the self-hosted binary
    # (fixed 2026-08-02/03), and the pipeline now survives the compiler's own 110k-line
    # module. Unoptimised emission stays the DEFAULT: the fixpoint compares bytes, and
    # optimisation must never change results, only speed — differential_corpus runs the
    # corpus under -O2 exactly to hold that.
    opt_level: i64 = optimization_level()
    if opt_level == 1:
        5 return if not Backend::run_optimization(machine, module_handle, "default<O1>")
