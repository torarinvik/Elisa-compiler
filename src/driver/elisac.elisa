def emit_pymodule_error_struct_dict_field_conversion(buffer: mutable darray[u8]&, type_name: sview, expression: sview, field_index: usize) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    # The ordinary dictionary copier already validates every bucket and retains borrowed
    # object values. Splice it into the structured-error field block, using a zero local arena
    # name so its cleanup paths cannot release the wrapper's live error arena before all fields
    # have been copied.
    emit_tokens_push_sview(buffer, "ElisaDict result = ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, "; ElisaArena field_arena = {0};\n")
    snippet: mutable darray[u8] = []
    empty_params: darray[Ast::ParamDecl] = []
    dict_helper_name_storage: mutable darray[u8] = []
    dict_helper_name: sview = pymodule_error_nested_dict_helper_name(type_name, &dict_helper_name_storage)
    emit_pymodule_dict_return_conversion(&snippet, empty_params, type_name, true, dict_helper_name)
    done_label: mutable darray[u8] = []
    emit_tokens_push_sview(&done_label, "elisa_pymodule_error_dict_field_done_")
    append_decimal(&done_label, field_index.i64())
    done_label_view: sview = sview(&done_label[0], 0, done_label.count)
    failed_label: mutable darray[u8] = []
    emit_tokens_push_sview(&failed_label, "elisa_pymodule_error_dict_field_failed_")
    append_decimal(&failed_label, field_index.i64())
    failed_label_view: sview = sview(&failed_label[0], 0, failed_label.count)
    replacement: mutable darray[u8] = []
    emit_tokens_push_sview(&replacement, "field_object = field_out; goto ")
    emit_tokens_push_sview(&replacement, done_label_view)
    emit_tokens_push_sview(&replacement, ";")
    replacement_view: sview = sview(&replacement[0], 0, replacement.count)
    pymodule_replace_generated(&snippet, "&arena", "&field_arena")
    pymodule_replace_generated_local(&snippet, "out", "field_out")
    # Remove the copier's failure-path local-arena releases before installing the success handoff;
    # the handoff itself must retain one explicit field-arena release after the dictionary is copied.
    pymodule_replace_generated(&snippet, "arena_free(&field_arena);", "")
    success_replacement: mutable darray[u8] = []
    emit_tokens_push_sview(&success_replacement, "arena_free(&field_arena); ")
    for replacement_index in 0..<replacement.count |success_replacement, replacement|:
        success_replacement.push(replacement[replacement_index])
    success_replacement_view: sview = sview(&success_replacement[0], 0, success_replacement.count)
    pymodule_replace_generated(&snippet, "return field_out;", success_replacement_view)
    # A malformed native dictionary or a Python allocation failure must still release the
    # enclosing error arena. The nested copier's zero arena is only for its local cleanup calls;
    # centralize both arena releases at one failure label. A goto is required because the copier
    # contains unbraced `if (...) return NULL;` statements; textual cleanup insertion would make
    # those returns unconditional.
    failure_goto: mutable darray[u8] = []
    emit_tokens_push_sview(&failure_goto, "goto ")
    emit_tokens_push_sview(&failure_goto, failed_label_view)
    emit_tokens_push_sview(&failure_goto, ";")
    failure_goto_view: sview = sview(&failure_goto[0], 0, failure_goto.count)
    pymodule_replace_generated(&snippet, "return NULL;", failure_goto_view)
    for snippet_index in 0..<snippet.count |buffer, snippet|:
        buffer.push(snippet[snippet_index])
    emit_tokens_push_sview(buffer, failed_label_view)
    emit_tokens_push_sview(buffer, ":; arena_free(&field_arena); arena_free(&arena); return NULL; ")
    emit_tokens_push_sview(buffer, done_label_view)
    emit_tokens_push_sview(buffer, ":; ")


def emit_pymodule_optional_error_payload_conversion(buffer: mutable darray[u8]&, type_name: sview, expression: sview, destination: sview) -> void can[Abort.Panic, Memory.Allocate]:
    # Optional pointers use null as the absent value; value optionals carry an explicit
    # `has_value` bit. Keep this helper expression-based so single-field and structured
    # payloads share exactly the same Python conversion and validation rules.
    if type_name == "cstr?":
        emit_tokens_push_sview(buffer, "if (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, " == NULL) { Py_INCREF(Py_None); ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = Py_None; } else ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyUnicode_FromString(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ");\n")
        return
    if type_name == "py::Object?":
        emit_tokens_push_sview(buffer, "if (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, " == NULL) { Py_INCREF(Py_None); ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = Py_None; } else { Py_INCREF(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, "); ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = ")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, "; }\n")
        return
    payload_name: sview = pymodule_optional_payload_name(type_name)
    emit_tokens_push_sview(buffer, "if (!(")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ").has_value) { Py_INCREF(Py_None); ")
    emit_tokens_push_sview(buffer, destination)
    emit_tokens_push_sview(buffer, " = Py_None; } else {")
    if payload_name == "sview":
        emit_tokens_push_sview(buffer, " if ((")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value.len < 0 || (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value.len > PY_SSIZE_T_MAX || ((")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value.data == NULL && (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value.len != 0)) { PyErr_SetString(PyExc_RuntimeError, \"native optional sview error payload is invalid\"); return NULL; }")
        emit_tokens_push_sview(buffer, " if ((")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value.data == NULL) ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyUnicode_FromString(\"\"); else ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyUnicode_DecodeUTF8((")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value.data, (Py_ssize_t)(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value.len, \"strict\");")
    elif payload_name == "bool":
        emit_tokens_push_sview(buffer, " ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyBool_FromLong((long)(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value);")
    elif payload_name == "f32" or payload_name == "f64":
        emit_tokens_push_sview(buffer, " ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyFloat_FromDouble((double)(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value);")
    elif payload_name == "u8" or payload_name == "u16" or payload_name == "u32" or payload_name == "u64" or payload_name == "usize" or payload_name == "uintptr":
        emit_tokens_push_sview(buffer, " ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyLong_FromUnsignedLongLong((unsigned long long)(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value);")
    else:
        emit_tokens_push_sview(buffer, " ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyLong_FromLongLong((long long)(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ").value);")
    emit_tokens_push_sview(buffer, " }\n")


def emit_pymodule_error_payload_set_conversion(buffer: mutable darray[u8]&, type_name: sview, expression: sview, destination: sview) -> void can[Abort.Panic, Memory.Allocate]:
    # Sets carry an open-addressed bucket table rather than a linear darray. Error payloads are
    # borrowed until the exception object is built, so validate the table and materialize a fresh
    # Python set before the wrapper releases its arena.
    element_name: sview = pymodule_set_element_name(type_name)
    element_c_type: sview = pymodule_darray_c_element_type(element_name)
    emit_tokens_push_sview(buffer, "if (")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".count < 0 || ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".used < 0 || ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".capacity < 0 || ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".count > ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".used || ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".used > ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".capacity || ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".count > PY_SSIZE_T_MAX || ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".capacity > PY_SSIZE_T_MAX) { arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native Elisa error returned an invalid set payload\"); return NULL; } ")
    emit_tokens_push_sview(buffer, destination)
    emit_tokens_push_sview(buffer, " = PySet_New(NULL); if (")
    emit_tokens_push_sview(buffer, destination)
    emit_tokens_push_sview(buffer, " == NULL) { arena_free(&arena); return NULL; } if (")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".count != 0) { if (")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".items == NULL || ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".capacity == 0) { Py_DECREF(")
    emit_tokens_push_sview(buffer, destination)
    emit_tokens_push_sview(buffer, "); arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native set returned null set storage\"); return NULL; } typedef struct { ")
    emit_tokens_push_sview(buffer, element_c_type)
    emit_tokens_push_sview(buffer, " key; uint8_t state; } ElisaPymoduleErrorSetBucket; int64_t error_payload_seen = 0; for (int64_t error_payload_index = 0; error_payload_index < ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".capacity; ++error_payload_index) { ElisaPymoduleErrorSetBucket *error_payload_bucket = &((ElisaPymoduleErrorSetBucket *)")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".items)[error_payload_index]; if (error_payload_bucket->state != 1) continue; PyObject *error_payload_item = NULL; ")
    if element_name == "cstr":
        emit_tokens_push_sview(buffer, "if (error_payload_bucket->key == NULL) { Py_DECREF(")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, "); arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native set returned a null cstr element\"); return NULL; } error_payload_item = PyUnicode_FromString(error_payload_bucket->key); ")
    elif element_name == "sview":
        emit_tokens_push_sview(buffer, "ElisaSView error_payload_view = error_payload_bucket->key; if (error_payload_view.len < 0 || error_payload_view.len > PY_SSIZE_T_MAX || (error_payload_view.data == NULL && error_payload_view.len != 0)) { Py_DECREF(")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, "); arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native set returned an invalid sview element\"); return NULL; } if (error_payload_view.data == NULL) error_payload_item = PyUnicode_FromString(\"\"); else error_payload_item = PyUnicode_DecodeUTF8(error_payload_view.data, (Py_ssize_t)error_payload_view.len, \"strict\"); ")
    elif element_name == "bool":
        emit_tokens_push_sview(buffer, "error_payload_item = PyBool_FromLong((long)error_payload_bucket->key); ")
    elif pymodule_darray_element_is_unsigned(element_name):
        emit_tokens_push_sview(buffer, "error_payload_item = PyLong_FromUnsignedLongLong((unsigned long long)error_payload_bucket->key); ")
    else:
        emit_tokens_push_sview(buffer, "error_payload_item = PyLong_FromLongLong((long long)error_payload_bucket->key); ")
    emit_tokens_push_sview(buffer, "if (error_payload_item == NULL) { Py_DECREF(")
    emit_tokens_push_sview(buffer, destination)
    emit_tokens_push_sview(buffer, "); arena_free(&arena); return NULL; } if (PySet_Add(")
    emit_tokens_push_sview(buffer, destination)
    emit_tokens_push_sview(buffer, ", error_payload_item) < 0) { Py_DECREF(error_payload_item); Py_DECREF(")
    emit_tokens_push_sview(buffer, destination)
    emit_tokens_push_sview(buffer, "); arena_free(&arena); return NULL; } Py_DECREF(error_payload_item); error_payload_seen++; } if (error_payload_seen != ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".count) { Py_DECREF(")
    emit_tokens_push_sview(buffer, destination)
    emit_tokens_push_sview(buffer, "); arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native set count does not match occupied buckets\"); return NULL; } }\n")


def emit_pymodule_error_payload_field_conversion(buffer: mutable darray[u8]&, file: Ast::File&, type_name: sview, expression: sview, field_index: usize) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    if pymodule_is_dict_type(type_name):
        emit_pymodule_error_struct_dict_field_conversion(buffer, type_name, expression, field_index)
    elif type_name == "cstr?" or type_name == "py::Object?" or pymodule_is_optional_scalar_type(type_name):
        emit_pymodule_optional_error_payload_conversion(buffer, type_name, expression, "field_object")
    elif pymodule_is_darray_type(type_name):
        emit_pymodule_error_payload_darray_conversion(buffer, file, type_name, expression, "field_object")
    elif pymodule_is_view_type(type_name):
        emit_pymodule_error_payload_view_conversion(buffer, file, type_name, expression, "field_object")
    elif pymodule_is_set_type(type_name):
        emit_pymodule_error_payload_set_conversion(buffer, type_name, expression, "field_object")
    elif type_name == "cstr":
        emit_tokens_push_sview(buffer, "if (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, " == NULL) { Py_INCREF(Py_None); field_object = Py_None; } else field_object = PyUnicode_FromString(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ");\n")
    elif type_name == "sview":
        emit_tokens_push_sview(buffer, "if (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".len < 0 || ")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".len > PY_SSIZE_T_MAX || (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".data == NULL && ")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".len != 0)) { PyErr_SetString(PyExc_RuntimeError, \"native Elisa structured error returned an invalid sview payload\"); return NULL; } if (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".data == NULL) field_object = PyUnicode_FromString(\"\"); else field_object = PyUnicode_DecodeUTF8(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".data, (Py_ssize_t)")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".len, \"strict\");\n")
    elif type_name == "py::Object":
        emit_tokens_push_sview(buffer, "if (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, " == NULL) { Py_INCREF(Py_None); field_object = Py_None; } else { Py_INCREF(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, "); field_object = ")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, "; }\n")
    elif pymodule_struct_return_supported(file, type_name):
        emit_tokens_push_sview(buffer, "field_object = elisa_pymodule_struct_")
        emit_tokens_push_sview(buffer, type_name)
        emit_tokens_push_sview(buffer, "_to_py(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ");\n")
    elif type_name == "bool":
        emit_tokens_push_sview(buffer, "field_object = PyBool_FromLong((long)")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ");\n")
    elif type_name == "f32" or type_name == "f64":
        emit_tokens_push_sview(buffer, "field_object = PyFloat_FromDouble((double)")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ");\n")
    elif type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or type_name == "usize" or type_name == "uintptr":
        emit_tokens_push_sview(buffer, "field_object = PyLong_FromUnsignedLongLong((unsigned long long)")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ");\n")
    else:
        emit_tokens_push_sview(buffer, "field_object = PyLong_FromLongLong((long long)")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ");\n")


def emit_pymodule_error_payload_struct_conversion(buffer: mutable darray[u8]&, file: Ast::File&, declarations: darray[Ast::Decl]&, error_family: sview) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    declaration: Ast::Decl? = pymodule_error_decl_in(declarations, error_family)
    if declaration is target:
        if target is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            emit_tokens_push_sview(buffer, "        PyObject *native_payload_object = PyDict_New(); if (native_payload_object == NULL) return NULL;\n        PyObject *native_variant_object = NULL;\n        if (native_payload.tag < 1) { Py_DECREF(native_payload_object); PyErr_SetString(PyExc_RuntimeError, \"native Elisa structured error returned an invalid variant tag\"); return NULL; }\n")
            field_index: mutable usize = 0.usize()
            variant_index: mutable i64 = 0
            for variant in error_variants |buffer, field_index, variant_index|:
                emit_tokens_push_sview(buffer, "        ") if variant_index > 0
                emit_tokens_push_sview(buffer, "else ") if variant_index > 0
                emit_tokens_push_sview(buffer, "if (native_payload.tag == ")
                append_decimal(buffer, (variant_index + 1).i64())
                emit_tokens_push_sview(buffer, ") { native_variant_object = PyUnicode_FromString(\"")
                emit_tokens_push_sview(buffer, variant.name)
                emit_tokens_push_sview(buffer, "\"); if (native_variant_object == NULL || PyDict_SetItemString(native_payload_object, \"variant\", native_variant_object) < 0) { Py_XDECREF(native_variant_object); Py_DECREF(native_payload_object); return NULL; } Py_DECREF(native_variant_object);\n")
                field_offset: mutable usize = 0.usize()
                for field in variant.fields |buffer, field_index, field_offset|:
                    emit_tokens_push_sview(buffer, "            { PyObject *field_object = NULL; ")
                    expression: mutable darray[u8] = []
                    emit_tokens_push_sview(&expression, "native_payload.field_")
                    append_decimal(&expression, field_index.i64())
                    expression_view: sview = sview(&expression[0], 0, expression.count)
                    field_type_name: sview = pymodule_alias_type_name(file, field)
                    emit_pymodule_error_payload_field_conversion(buffer, file, field_type_name, expression_view, field_index)
                    emit_tokens_push_sview(buffer, " if (field_object == NULL || PyDict_SetItemString(native_payload_object, \"")
                    if field_offset < variant.field_names.count and variant.field_names[field_offset] != "":
                        emit_tokens_push_sview(buffer, variant.field_names[field_offset])
                    else:
                        emit_tokens_push_sview(buffer, "field_")
                        append_decimal(buffer, field_offset.i64())
                    emit_tokens_push_sview(buffer, "\", field_object) < 0) { Py_XDECREF(field_object); Py_DECREF(native_payload_object); return NULL; } Py_DECREF(field_object); }\n")
                    field_index <- field_index + 1.usize()
                    field_offset <- field_offset + 1.usize()
                emit_tokens_push_sview(buffer, "        }")
                emit_tokens_push_sview(buffer, "\n")
                variant_index <- variant_index + 1
            emit_tokens_push_sview(buffer, "        else { Py_DECREF(native_payload_object); PyErr_SetString(PyExc_RuntimeError, \"native Elisa structured error returned an unknown variant tag\"); return NULL; }\n")


# Copy a dictionary error payload while the native error arena is still alive. The ordinary dict
# return copier already validates bucket metadata, handles text/object/nullable values, and owns
# every Python reference it creates. Reuse that implementation in a nested block, changing only
# its two successful `return out` exits into a handoff to the surrounding error wrapper. Error
# exits intentionally remain direct returns: the copier has already set a precise Python error
# (and released the arena) so there is no useful Elisa error object to construct afterward.
def emit_pymodule_error_payload_dict_conversion(buffer: mutable darray[u8]&, type_name: sview) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    emit_tokens_push_sview(buffer, "        ElisaDict result = native_payload;\n")
    snippet: mutable darray[u8] = []
    empty_params: darray[Ast::ParamDecl] = []
    dict_helper_name_storage: mutable darray[u8] = []
    dict_helper_name: sview = pymodule_error_nested_dict_helper_name(type_name, &dict_helper_name_storage)
    emit_pymodule_dict_return_conversion(&snippet, empty_params, type_name, true, dict_helper_name)
    empty_return: sview = "        arena_free(&arena);\n        return out;\n"
    final_return: sview = "    arena_free(&arena);\n    return out;\n"
    handoff: sview = "        native_payload_object = out; goto elisa_pymodule_error_dict_done;\n"
    pymodule_replace_generated(&snippet, empty_return, handoff)
    pymodule_replace_generated(&snippet, final_return, handoff)
    for snippet_index in 0..<snippet.count |buffer, snippet|:
        buffer.push(snippet[snippet_index])
    emit_tokens_push_sview(buffer, "        elisa_pymodule_error_dict_done:;\n")


def emit_pymodule_error_payload_conversion(buffer: mutable darray[u8]&, file: Ast::File&, type_name: sview) -> void can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(buffer, "        PyObject *native_payload_object = NULL;\n")
    if pymodule_is_dict_type(type_name):
        emit_pymodule_error_payload_dict_conversion(buffer, type_name)
    elif pymodule_is_darray_type(type_name):
        emit_pymodule_error_payload_darray_conversion(buffer, file, type_name, "native_payload", "native_payload_object")
    elif pymodule_is_view_type(type_name):
        emit_pymodule_error_payload_view_conversion(buffer, file, type_name, "native_payload", "native_payload_object")
    elif pymodule_is_set_type(type_name):
        emit_pymodule_error_payload_set_conversion(buffer, type_name, "native_payload", "native_payload_object")
    elif type_name == "cstr?" or type_name == "py::Object?" or pymodule_is_optional_scalar_type(type_name):
        emit_pymodule_optional_error_payload_conversion(buffer, type_name, "native_payload", "native_payload_object")
    elif type_name == "cstr":
        emit_tokens_push_sview(buffer, "        if (native_payload == NULL) { Py_INCREF(Py_None); native_payload_object = Py_None; } else native_payload_object = PyUnicode_FromString(native_payload);\n")
    elif type_name == "sview":
        emit_tokens_push_sview(buffer, "        if (native_payload.len < 0 || native_payload.len > PY_SSIZE_T_MAX || (native_payload.data == NULL && native_payload.len != 0)) { PyErr_SetString(PyExc_RuntimeError, \"native Elisa error returned an invalid sview payload\"); return NULL; }\n        if (native_payload.data == NULL) native_payload_object = PyUnicode_FromString(\"\"); else native_payload_object = PyUnicode_DecodeUTF8(native_payload.data, (Py_ssize_t)native_payload.len, \"strict\");\n")
    elif type_name == "py::Object":
        emit_tokens_push_sview(buffer, "        if (native_payload == NULL) { Py_INCREF(Py_None); native_payload_object = Py_None; } else { Py_INCREF(native_payload); native_payload_object = native_payload; }\n")
    elif pymodule_struct_return_supported(file, type_name):
        emit_tokens_push_sview(buffer, "        native_payload_object = elisa_pymodule_struct_")
        emit_tokens_push_sview(buffer, type_name)
        emit_tokens_push_sview(buffer, "_to_py(native_payload);\n")
    elif type_name == "bool":
        emit_tokens_push_sview(buffer, "        native_payload_object = PyBool_FromLong((long)native_payload);\n")
    elif type_name == "f32" or type_name == "f64":
        emit_tokens_push_sview(buffer, "        native_payload_object = PyFloat_FromDouble((double)native_payload);\n")
    elif type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or type_name == "usize" or type_name == "uintptr":
        emit_tokens_push_sview(buffer, "        native_payload_object = PyLong_FromUnsignedLongLong((unsigned long long)native_payload);\n")
    else:
        emit_tokens_push_sview(buffer, "        native_payload_object = PyLong_FromLongLong((long long)native_payload);\n")
    emit_tokens_push_sview(buffer, "        if (native_payload_object == NULL) return NULL;\n")


# Aggregate error payloads are copied before ordinary argument cleanup because their native
# storage may borrow a Python sequence, dictionary, or struct arena.  The leaf converters already
# release the result object they have built and often release the output arena on their local
# failure paths, but they cannot see the wrapper's input ownership table.  Emit the conversion in
# a temporary snippet, remove its local wrapper-arena frees, and funnel every failure through one
# wrapper-owned cleanup label.  This keeps the arena/reference table balanced for both malformed
# native payloads and Python allocation failures without changing the successful payload ABI.
def emit_pymodule_error_payload_conversion_guarded(buffer: mutable darray[u8]&, file: Ast::File&, target_params: darray[Ast::ParamDecl]&, payload_type_name: sview, error_family: sview, structured_payload_error: bool, has_return_arena: bool) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    snippet: mutable darray[u8] = []
    if structured_payload_error:
        emit_pymodule_error_payload_struct_conversion(&snippet, file, file.top_decls, error_family)
    else:
        emit_pymodule_error_payload_conversion(&snippet, file, payload_type_name)
    # The wrapper owns the live arena. Any arena-free emitted by a leaf converter belongs to the
    # old direct-return path and must be removed before jumping to the shared cleanup label. Leaf
    # converters also release a partially-built destination before failing; clear that variable
    # before the shared XDECREF so structured and aggregate payloads cannot be decremented twice.
    pymodule_replace_generated(&snippet, "arena_free(&arena);", "")
    pymodule_replace_generated(&snippet, "Py_DECREF(native_payload_object);", "Py_DECREF(native_payload_object); native_payload_object = NULL;")
    pymodule_replace_generated(&snippet, "Py_XDECREF(native_payload_object);", "Py_XDECREF(native_payload_object); native_payload_object = NULL;")
    pymodule_replace_generated(&snippet, "return NULL;", "goto elisa_pymodule_error_payload_conversion_failed;")
    for snippet_index in 0..<snippet.count |buffer, snippet|:
        buffer.push(snippet[snippet_index])
    emit_tokens_push_sview(buffer, "        goto elisa_pymodule_error_payload_conversion_done;\n        elisa_pymodule_error_payload_conversion_failed:\n        Py_XDECREF(native_payload_object);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena);\n") if has_return_arena
    emit_tokens_push_sview(buffer, "        return NULL;\n        elisa_pymodule_error_payload_conversion_done:;\n")


# At this point ordinary argument ownership has already been released, but a darray reference
# input can still keep the wrapper arena live while a scalar/optional payload is copied. Preserve
# the converter's precise Python exception and make every generated failure release that arena.
def emit_pymodule_error_payload_conversion_after_input_cleanup(buffer: mutable darray[u8]&, file: Ast::File&, payload_type_name: sview, error_family: sview, structured_payload_error: bool, has_return_arena: bool) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    if not has_return_arena:
        emit_pymodule_error_payload_struct_conversion(buffer, file, file.top_decls, error_family) if structured_payload_error else emit_pymodule_error_payload_conversion(buffer, file, payload_type_name)
        return
    snippet: mutable darray[u8] = []
    if structured_payload_error:
        emit_pymodule_error_payload_struct_conversion(&snippet, file, file.top_decls, error_family)
    else:
        emit_pymodule_error_payload_conversion(&snippet, file, payload_type_name)
    # Conversion snippets may already contain the old direct-path arena release. Normalize it
    # before routing every failure through one wrapper-owned arena label. A goto is intentional:
    # some small converters use unbraced `if (...) return NULL;` statements, so textual insertion
    # of `arena_free` before `return` would otherwise make the return unconditional.
    pymodule_replace_generated(&snippet, "arena_free(&arena);", "")
    pymodule_replace_generated(&snippet, "return NULL;", "goto elisa_pymodule_error_payload_after_cleanup_failed;")
    for snippet_index in 0..<snippet.count |buffer, snippet|:
        buffer.push(snippet[snippet_index])
    emit_tokens_push_sview(buffer, "        goto elisa_pymodule_error_payload_after_cleanup_done;\n        elisa_pymodule_error_payload_after_cleanup_failed:\n        arena_free(&arena);\n        return NULL;\n        elisa_pymodule_error_payload_after_cleanup_done:;\n")


def pymodule_function_error_family(file: Ast::File&, name: sview) -> sview can[Abort.Panic, Memory.Allocate]:
    target_decl: Ast::Decl? = pymodule_find_function_in(file.top_decls, name)
    if target_decl is target_function:
        if target_function is Decl.Func(target_function_name, target_params, target_return, target_body, target_effects, target_decorators, target_pos):
            for error_index in 0..<file.error_set_func_lines.count |file, target_pos|:
                if file.error_set_func_lines[error_index] == target_pos.line:
                    return file.error_set_func_names[error_index] if error_index < file.error_set_func_names.count
    return ""


def pymodule_error_families(file: Ast::File&) -> darray[sview] can[Abort.Panic, Memory.Allocate]:
    families: mutable darray[sview] = []
    for annotation in file.enum_annotations |families, file|:
        continue if annotation.name != "__pymodule_fn"
        target_name: mutable sview = ""
        for target_annotation in file.enum_annotations |target_name, annotation|:
            target_name <- target_annotation.owner if target_annotation.name == "__pymodule_target_ref" and target_annotation.line == annotation.line
        family: sview = pymodule_function_error_family(file, target_name)
        continue if family == ""
        already_emitted: mutable bool = false
        for emitted_family in families |already_emitted, family|:
            already_emitted <- true if emitted_family == family
        families.push(family) if not already_emitted
    return families


# Expand opt-in `fn *` / `const *` rows after parsing the complete file. Keep the expansion
# limited to top-level declarations: nested modules can still be selected explicitly with the
# existing qualified-target form, while a wildcard remains predictable and collision-safe.
def pymodule_expand_wildcard_exports(file: mutable Ast::File&) -> void can[Abort.Panic, Memory.Allocate]:
    has_fn_wildcard: mutable bool = false
    has_const_wildcard: mutable bool = false
    already_expanded: mutable bool = false
    for annotation in file.enum_annotations |has_fn_wildcard, has_const_wildcard, already_expanded|:
        has_fn_wildcard <- true if annotation.name == "__pymodule_fn_all"
        has_const_wildcard <- true if annotation.name == "__pymodule_const_all"
        already_expanded <- true if annotation.name == "__pymodule_wildcard_expanded"
    return if already_expanded or (not has_fn_wildcard and not has_const_wildcard)
    if has_fn_wildcard:
        for declaration in file.top_decls |file|:
            if declaration is Decl.Func(wildcard_function_name, wildcard_function_params, wildcard_function_return, wildcard_function_body, wildcard_function_effects, wildcard_function_decorators, wildcard_function_pos):
                file.enum_annotations <- file.enum_annotations.push(Ast::EnumAnnotation{owner: wildcard_function_name, name: "__pymodule_fn", line: wildcard_function_pos.line})
                file.enum_annotations <- file.enum_annotations.push(Ast::EnumAnnotation{owner: wildcard_function_name, name: "__pymodule_target_ref", line: wildcard_function_pos.line})
    if has_const_wildcard:
        for declaration in file.top_decls |file|:
            if declaration is Decl.Const(wildcard_const_name, wildcard_const_type, wildcard_const_value, wildcard_const_mutable, wildcard_const_pos):
                file.enum_annotations <- file.enum_annotations.push(Ast::EnumAnnotation{owner: wildcard_const_name, name: "__pymodule_const", line: wildcard_const_pos.line})
                file.enum_annotations <- file.enum_annotations.push(Ast::EnumAnnotation{owner: wildcard_const_name, name: "__pymodule_const_target_ref", line: wildcard_const_pos.line})
    file.enum_annotations <- file.enum_annotations.push(Ast::EnumAnnotation{owner: "*", name: "__pymodule_wildcard_expanded", line: 0})


# Python source and CPython extension initialization both require identifier-shaped public names.
# Keep this check in the compiler-owned contract so `-emit pymodule`, `-emit pymodule-c`, and the
# convenience `-emit pymodule-so` path fail before producing an unusable module or invalid stub.
def pymodule_python_name_is_keyword(name: sview) -> bool can[Abort.Panic]:
    return true if name == "False" or name == "None" or name == "True" or name == "and" or name == "as" or name == "assert" or name == "async" or name == "await"
    return true if name == "break" or name == "class" or name == "continue" or name == "def" or name == "del" or name == "elif" or name == "else" or name == "except"
    return true if name == "finally" or name == "for" or name == "from" or name == "global" or name == "if" or name == "import" or name == "in" or name == "is"
    return true if name == "lambda" or name == "nonlocal" or name == "not" or name == "or" or name == "pass" or name == "raise" or name == "return" or name == "try"
    return true if name == "while" or name == "with" or name == "yield" or name == "__debug__"
    return false


def pymodule_python_name_is_identifier(name: sview) -> bool can[Abort.Panic]:
    length: usize = sview_len(name)
    return false if length == 0
    first: u8 = sview_at(name, 0)
    return false if not (first == 95 or first in 65..90 or first in 97..122)
    for index in 1..<length |name|:
        character: u8 = sview_at(name, index)
        return false if not (character == 95 or character in 48..57 or character in 65..90 or character in 97..122)
    return false if pymodule_python_name_is_keyword(name)
    return true


# The Python manifest currently identifies named records by their leaf name. A pair of
# module-local `Point` declarations would therefore make both the generated stub aliases
# and the C conversion helpers ambiguous. Detect that shape before publishing a contract;
# qualified record metadata can relax this restriction later without changing diagnostics
# for today's unambiguous modules.
def pymodule_duplicate_struct_name(file: Ast::File&) -> sview can[Abort.Panic]:
    for first_index in 0..<file.struct_names.count |file|:
        for second_index in first_index + 1.usize()..<file.struct_names.count |file, first_index|:
            if file.struct_names[first_index] == file.struct_names[second_index]:
                return file.struct_names[first_index]
    return ""


# The generated module always owns `__all__`, `ElisaError`, and one Python exception class per
# exported error family. Reject an export that would overwrite one of those runtime attributes;
# otherwise the extension could import successfully while silently replacing its error API.
def pymodule_validate_reserved_export_names(file: Ast::File&, emit_mode: sview) -> bool can[Abort.Panic, Memory.Allocate, Console]:
    module_name: mutable sview = ""
    for module_annotation in file.enum_annotations |module_name|:
        module_name <- module_annotation.owner if module_annotation.name == "__export_pymodule" and module_name == ""
    if not pymodule_python_name_is_identifier(module_name):
        message_module: mutable darray[u8] = []
        emit_tokens_push_sview(&message_module, "error: -emit ")
        emit_tokens_push_sview(&message_module, emit_mode)
        emit_tokens_push_sview(&message_module, " module name `")
        emit_tokens_push_sview(&message_module, module_name)
        emit_tokens_push_sview(&message_module, "` must be a valid Python identifier (ASCII letters, digits, and underscores; not a keyword)\n")
        write_stderr(message_module)
        return false
    duplicate_struct_name: sview = pymodule_duplicate_struct_name(file)
    if duplicate_struct_name != "":
        message_duplicate_struct: mutable darray[u8] = []
        emit_tokens_push_sview(&message_duplicate_struct, "error: -emit ")
        emit_tokens_push_sview(&message_duplicate_struct, emit_mode)
        emit_tokens_push_sview(&message_duplicate_struct, " struct name `")
        emit_tokens_push_sview(&message_duplicate_struct, duplicate_struct_name)
        emit_tokens_push_sview(&message_duplicate_struct, "` appears more than once; Python interop currently requires unique named-struct names\n")
        write_stderr(message_duplicate_struct)
        return false
    families: darray[sview] = pymodule_error_families(file)
    for family in families:
        if not pymodule_python_name_is_identifier(family):
            message_error_family_identifier: mutable darray[u8] = []
            emit_tokens_push_sview(&message_error_family_identifier, "error: -emit ")
            emit_tokens_push_sview(&message_error_family_identifier, emit_mode)
            emit_tokens_push_sview(&message_error_family_identifier, " error family name `")
            emit_tokens_push_sview(&message_error_family_identifier, family)
            emit_tokens_push_sview(&message_error_family_identifier, "` must be a valid Python identifier (ASCII letters, digits, and underscores; not a keyword)\n")
            write_stderr(message_error_family_identifier)
            return false
        if family == "__all__":
            message_error_family_all: mutable darray[u8] = []
            emit_tokens_push_sview(&message_error_family_all, "error: -emit ")
            emit_tokens_push_sview(&message_error_family_all, emit_mode)
            emit_tokens_push_sview(&message_error_family_all, " error family `__all__` conflicts with the generated module attribute\n")
            write_stderr(message_error_family_all)
            return false
        if family == "ElisaError":
            message: mutable darray[u8] = []
            emit_tokens_push_sview(&message, "error: -emit ")
            emit_tokens_push_sview(&message, emit_mode)
            emit_tokens_push_sview(&message, " error family `ElisaError` conflicts with the generated base exception name\n")
            write_stderr(message)
            return false
    # Every public row becomes a module-level Python attribute and, for functions,
    # a C wrapper symbol. Reject duplicate names before emitting either artifact;
    # otherwise two wrappers can collide at compile time or a later row can silently
    # replace an earlier function/constant in the imported module.
    exported_names: mutable darray[sview] = []
    for export_annotation in file.enum_annotations |exported_names, file, emit_mode|:
        continue if export_annotation.name != "__pymodule_fn" and export_annotation.name != "__pymodule_const"
        for existing_export_name in exported_names |export_annotation, emit_mode|:
            if existing_export_name == export_annotation.owner:
                message_duplicate: mutable darray[u8] = []
                emit_tokens_push_sview(&message_duplicate, "error: -emit ")
                emit_tokens_push_sview(&message_duplicate, emit_mode)
                emit_tokens_push_sview(&message_duplicate, " export name `")
                emit_tokens_push_sview(&message_duplicate, export_annotation.owner)
                emit_tokens_push_sview(&message_duplicate, "` is declared more than once; Python module attributes must be unique\n")
                write_stderr(message_duplicate)
                return false
        exported_names.push(export_annotation.owner)
    for annotation in file.enum_annotations |families, file, emit_mode|:
        continue if annotation.name != "__pymodule_fn" and annotation.name != "__pymodule_const"
        if not pymodule_python_name_is_identifier(annotation.owner):
            message_identifier: mutable darray[u8] = []
            emit_tokens_push_sview(&message_identifier, "error: -emit ")
            emit_tokens_push_sview(&message_identifier, emit_mode)
            emit_tokens_push_sview(&message_identifier, " export name `")
            emit_tokens_push_sview(&message_identifier, annotation.owner)
            emit_tokens_push_sview(&message_identifier, "` must be a valid Python identifier (ASCII letters, digits, and underscores; not a keyword)\n")
            write_stderr(message_identifier)
            return false
        if annotation.name == "__pymodule_fn":
            target_name: mutable sview = ""
            for target_annotation in file.enum_annotations |target_name, annotation|:
                target_name <- target_annotation.owner if target_annotation.name == "__pymodule_target_ref" and target_annotation.line == annotation.line
            target_decl: Ast::Decl? = pymodule_find_function_in(file.top_decls, target_name)
            if target_decl is target_function:
                if target_function is Decl.Func(target_function_name, target_params, target_return, target_body, target_effects, target_decorators, target_pos):
                    for parameter in target_params |file, emit_mode, annotation|:
                        if not pymodule_python_name_is_identifier(parameter.name):
                            message_parameter: mutable darray[u8] = []
                            emit_tokens_push_sview(&message_parameter, "error: -emit ")
                            emit_tokens_push_sview(&message_parameter, emit_mode)
                            emit_tokens_push_sview(&message_parameter, " parameter name `")
                            emit_tokens_push_sview(&message_parameter, parameter.name)
                            emit_tokens_push_sview(&message_parameter, "` in exported function `")
                            emit_tokens_push_sview(&message_parameter, annotation.owner)
                            emit_tokens_push_sview(&message_parameter, "` must be a valid Python identifier (ASCII letters, digits, and underscores; not a keyword)\n")
                            write_stderr(message_parameter)
                            return false
        elif annotation.name == "__pymodule_const":
            constant_target_name: mutable sview = ""
            for constant_target_annotation in file.enum_annotations |constant_target_name, annotation|:
                constant_target_name <- constant_target_annotation.owner if constant_target_annotation.name == "__pymodule_const_target_ref" and constant_target_annotation.line == annotation.line
            constant_target_decl: Ast::Decl? = pymodule_find_const_in(file.top_decls, constant_target_name)
            constant_target_found: mutable bool = false
            if constant_target_decl is constant_target:
                constant_target_found <- true
                if constant_target is Decl.Const(constant_target_decl_name, constant_target_type, constant_target_value, constant_target_mutable, constant_target_pos):
                    if pymodule_target_is_qualified(constant_target_name) and pymodule_const_leaf_count(file.top_decls, constant_target_name) > 1:
                        message_ambiguous_constant: mutable darray[u8] = []
                        emit_tokens_push_sview(&message_ambiguous_constant, "error: -emit ")
                        emit_tokens_push_sview(&message_ambiguous_constant, emit_mode)
                        emit_tokens_push_sview(&message_ambiguous_constant, " cannot disambiguate qualified constant target `")
                        emit_tokens_push_sview(&message_ambiguous_constant, constant_target_name)
                        emit_tokens_push_sview(&message_ambiguous_constant, "` because multiple constants share its leaf name; use a unique target leaf or export an accessor\n")
                        write_stderr(message_ambiguous_constant)
                        return false
                    constant_type_name: sview = pymodule_const_decl_type_name(file, constant_target_type, constant_target_value)
                    if not pymodule_const_type_supported(constant_type_name):
                        message_unsupported_constant: mutable darray[u8] = []
                        emit_tokens_push_sview(&message_unsupported_constant, "error: -emit ")
                        emit_tokens_push_sview(&message_unsupported_constant, emit_mode)
                        emit_tokens_push_sview(&message_unsupported_constant, " supports scalar, text, and byte constants (target `")
                        emit_tokens_push_sview(&message_unsupported_constant, constant_target_name)
                        emit_tokens_push_sview(&message_unsupported_constant, "`)\n")
                        write_stderr(message_unsupported_constant)
                        return false
            if not constant_target_found:
                message_missing_constant: mutable darray[u8] = []
                emit_tokens_push_sview(&message_missing_constant, "error: -emit ")
                emit_tokens_push_sview(&message_missing_constant, emit_mode)
                emit_tokens_push_sview(&message_missing_constant, " export target \"")
                emit_tokens_push_sview(&message_missing_constant, constant_target_name)
                emit_tokens_push_sview(&message_missing_constant, "\" is undefined\n")
                write_stderr(message_missing_constant)
                return false
        if annotation.owner == "__all__":
            message_all: mutable darray[u8] = []
            emit_tokens_push_sview(&message_all, "error: -emit ")
            emit_tokens_push_sview(&message_all, emit_mode)
            emit_tokens_push_sview(&message_all, " export name `__all__` conflicts with the generated module attribute\n")
            write_stderr(message_all)
            return false
        if annotation.owner == "ElisaError":
            message_base: mutable darray[u8] = []
            emit_tokens_push_sview(&message_base, "error: -emit ")
            emit_tokens_push_sview(&message_base, emit_mode)
            emit_tokens_push_sview(&message_base, " export name `ElisaError` conflicts with the generated base exception\n")
            write_stderr(message_base)
            return false
        for family in families |file, emit_mode, annotation|:
            if annotation.owner == family:
                message_family: mutable darray[u8] = []
                emit_tokens_push_sview(&message_family, "error: -emit ")
                emit_tokens_push_sview(&message_family, emit_mode)
                emit_tokens_push_sview(&message_family, " export name `")
                emit_tokens_push_sview(&message_family, annotation.owner)
                emit_tokens_push_sview(&message_family, "` conflicts with its generated error class\n")
                write_stderr(message_family)
                return false
    return true


def pymodule_named_container_element_name(expression: Ast::Expr) -> sview can[Abort.Panic]:
    if expression is Expr.Index(container_head, container_argument, container_pos):
        if container_head is Expr.Ident(container_name, container_name_pos):
            if container_name == "darray" or container_name == "view":
                element_name: mutable sview = pymodule_type_atom_name(container_argument)
                element_name <- pymodule_bare_type_name(container_argument) if element_name == ""
                return element_name if element_name != "" and pymodule_darray_c_element_type(element_name) == ""
    if expression is Expr.IndexN(container_head_n, container_arguments, container_pos_n):
        if container_head_n is Expr.Ident(container_name_n, container_name_pos_n) and (container_name_n == "darray" or container_name_n == "view") and container_arguments.count == 1:
            element_name_n: mutable sview = pymodule_type_atom_name(container_arguments[0])
            element_name_n <- pymodule_bare_type_name(container_arguments[0]) if element_name_n == ""
            return element_name_n if element_name_n != "" and pymodule_darray_c_element_type(element_name_n) == ""
    if expression is Expr.Unary(unary_operator, unary_operand, unary_pos):
        return pymodule_named_container_element_name(unary_operand) if unary_operator == Lexer::TokenKind.Mutable or unary_operator == Lexer::TokenKind.Lmut or unary_operator == Lexer::TokenKind.Ampersand else ""
    if expression is Expr.Paren(paren_inner, paren_pos):
        return pymodule_named_container_element_name(paren_inner)
    return ""


def pymodule_expression_head_is_owned_container(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.Ident(generic_name, generic_pos):
        return generic_name == "dict" or generic_name == "set" or generic_name == "darray" or generic_name == "view"
    return false


def pymodule_expression_has_owned_container_element(expression: Ast::Expr) -> bool can[Abort.Panic]:
    # Some nested aggregate spellings (notably `darray[dict[K,V]]`) cannot be
    # represented by the small no-allocation bare-name helper. Cleanup still needs
    # to know that the element converter owns a struct arena and Python-reference
    # table, so recognize those container heads structurally.
    if expression is Expr.Unary(owned_operator, owned_operand, owned_pos):
        return pymodule_expression_has_owned_container_element(owned_operand) if owned_operator == Lexer::TokenKind.Mutable or owned_operator == Lexer::TokenKind.Lmut or owned_operator == Lexer::TokenKind.Ampersand else false
    if expression is Expr.Paren(owned_inner, owned_paren_pos):
        return pymodule_expression_has_owned_container_element(owned_inner)
    if expression is Expr.Index(owned_head, owned_argument, owned_index_pos):
        if owned_head is Expr.Ident(owned_container_name, owned_container_pos) and (owned_container_name == "darray" or owned_container_name == "view"):
            return true if pymodule_named_container_element_name(expression) != ""
            if owned_argument is Expr.Index(owned_element_head, owned_element_argument, owned_element_pos):
                return pymodule_expression_head_is_owned_container(owned_element_head)
            if owned_argument is Expr.IndexN(owned_element_head_n, owned_element_arguments, owned_element_pos_n):
                return pymodule_expression_head_is_owned_container(owned_element_head_n)
    if expression is Expr.IndexN(owned_head_n, owned_arguments_n, owned_index_pos_n):
        if owned_head_n is Expr.Ident(owned_container_name_n, owned_container_pos_n) and (owned_container_name_n == "darray" or owned_container_name_n == "view") and owned_arguments_n.count == 1:
            return true if pymodule_named_container_element_name(expression) != ""
            owned_argument_n: Ast::Expr = owned_arguments_n[0]
            if owned_argument_n is Expr.Index(owned_element_head_n, owned_element_argument_n, owned_element_pos_n):
                return pymodule_expression_head_is_owned_container(owned_element_head_n)
            if owned_argument_n is Expr.IndexN(owned_element_head_n_n, owned_element_arguments_n, owned_element_pos_n_n):
                return pymodule_expression_head_is_owned_container(owned_element_head_n_n)
    return false


def pymodule_expression_is_dict(expression: Ast::Expr) -> bool can[Abort.Panic]:
    # Cleanup runs from the original parameter expression and intentionally has no `Ast::File`
    # handle. Recognize the dictionary shape structurally so parser-cached named values (for
    # example `dict[cstr, Point]`) still release their arena and retained Python references.
    if expression is Expr.Index(index_head, index_argument, index_pos):
        if index_head is Expr.Ident(index_name, index_name_pos):
            return index_name == "dict"
        return false
    if expression is Expr.IndexN(index_head_n, index_arguments, index_pos_n):
        if index_head_n is Expr.Ident(index_name_n, index_name_pos_n):
            return index_name_n == "dict" and index_arguments.count == 2
        return false
    if expression is Expr.Unary(index_operator, index_operand, index_pos_unary):
        return pymodule_expression_is_dict(index_operand) if index_operator == Lexer::TokenKind.Mutable or index_operator == Lexer::TokenKind.Lmut or index_operator == Lexer::TokenKind.Ampersand else false
    if expression is Expr.Paren(index_inner, index_pos_paren):
        return pymodule_expression_is_dict(index_inner)
    return false


def emit_pymodule_darray_cleanup(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, indent: sview) -> void can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(buffer, indent)
    emit_tokens_push_sview(buffer, "elisa_pymodule_annotate_argument_error(elisa_pymodule_current_function, elisa_pymodule_current_parameter);\n")
    for cleanup_index in 0..<target_params.count |buffer, target_params, indent|:
        # Named-struct defaults are Python mappings too. They do not need arena cleanup, but the
        # temporary mapping owns a reference that must be released on every post-parse exit path.
        if target_params[cleanup_index].has_default and pymodule_default_is_container(target_params[cleanup_index].default_value):
            emit_tokens_push_sview(buffer, indent)
            emit_tokens_push_sview(buffer, "Py_XDECREF(arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_default); arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_default = NULL;\n")
        if pymodule_expression_is_nested_darray(target_params[cleanup_index].type_expression):
            emit_tokens_push_sview(buffer, indent)
            emit_tokens_push_sview(buffer, "elisa_pymodule_struct_refs_free(&arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_struct_refs);\n")
            emit_tokens_push_sview(buffer, indent)
            emit_tokens_push_sview(buffer, "arena_free(&arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_struct_arena);\n")
            if target_params[cleanup_index].has_default and pymodule_default_is_container(target_params[cleanup_index].default_value):
                emit_tokens_push_sview(buffer, indent)
                emit_tokens_push_sview(buffer, "Py_XDECREF(arg")
                append_decimal(buffer, cleanup_index.i64())
                emit_tokens_push_sview(buffer, "_default); arg")
                append_decimal(buffer, cleanup_index.i64())
                emit_tokens_push_sview(buffer, "_default = NULL;\n")
            continue
        cleanup_type_name: sview = pymodule_bare_type_name(target_params[cleanup_index].type_expression)
        named_container_element: sview = pymodule_named_container_element_name(target_params[cleanup_index].type_expression)
        owned_container_element: bool = pymodule_expression_has_owned_container_element(target_params[cleanup_index].type_expression)
        if cleanup_type_name != "" and not pymodule_is_darray_type(cleanup_type_name) and not pymodule_is_view_type(cleanup_type_name) and not pymodule_is_dict_type(cleanup_type_name) and not pymodule_is_set_type(cleanup_type_name) and pymodule_c_type_name(cleanup_type_name) == "":
            emit_tokens_push_sview(buffer, indent)
            emit_tokens_push_sview(buffer, "elisa_pymodule_struct_refs_free(&arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_struct_refs);\n")
            emit_tokens_push_sview(buffer, indent)
            emit_tokens_push_sview(buffer, "arena_free(&arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_struct_arena);\n")
            continue
        continue if not pymodule_is_darray_type(cleanup_type_name) and not pymodule_is_view_type(cleanup_type_name) and named_container_element == "" and not owned_container_element
        if pymodule_darray_is_bytes(cleanup_type_name):
            emit_tokens_push_sview(buffer, indent)
            emit_tokens_push_sview(buffer, "Py_XDECREF(arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_bytes);\n")
        else:
            emit_tokens_push_sview(buffer, indent)
            emit_tokens_push_sview(buffer, "Py_XDECREF(arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_seq);\n")
            emit_tokens_push_sview(buffer, indent)
            emit_tokens_push_sview(buffer, "PyMem_Free(arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_items);\n")
            if named_container_element != "" or owned_container_element:
                emit_tokens_push_sview(buffer, indent)
                emit_tokens_push_sview(buffer, "elisa_pymodule_struct_refs_free(&arg")
                append_decimal(buffer, cleanup_index.i64())
                emit_tokens_push_sview(buffer, "_struct_refs);\n")
                emit_tokens_push_sview(buffer, indent)
                emit_tokens_push_sview(buffer, "arena_free(&arg")
                append_decimal(buffer, cleanup_index.i64())
                emit_tokens_push_sview(buffer, "_struct_arena);\n")
        if target_params[cleanup_index].has_default and pymodule_default_is_container(target_params[cleanup_index].default_value):
            emit_tokens_push_sview(buffer, indent)
            emit_tokens_push_sview(buffer, "Py_XDECREF(arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_default); arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_default = NULL;\n")
    emit_pymodule_parameter_default_cleanup(buffer, target_params, indent)


def emit_pymodule_struct_argument_cleanup(buffer: mutable darray[u8]&, file: Ast::File&, target_params: darray[Ast::ParamDecl]&, indent: sview) -> void can[Abort.Panic, Memory.Allocate]:
    for cleanup_index in 0..<target_params.count |buffer, file, target_params, indent|:
        cleanup_type_name: sview = pymodule_alias_type_name(file, target_params[cleanup_index].type_expression)
        continue if not pymodule_struct_input_supported(file, cleanup_type_name)
        emit_tokens_push_sview(buffer, indent)
        emit_tokens_push_sview(buffer, "elisa_pymodule_struct_")
        emit_tokens_push_sview(buffer, cleanup_type_name)
        emit_tokens_push_sview(buffer, "_free(&arg")
        append_decimal(buffer, cleanup_index.i64())
        emit_tokens_push_sview(buffer, "_value);\n")


def emit_pymodule_parameter_default_cleanup(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, indent: sview) -> void can[Abort.Panic, Memory.Allocate]:
    # Parse-time failures happen before container materializers declare their arenas. Only
    # release the Python objects allocated for omitted literal-container and optional scalar/text
    # defaults here; the normal darray/dict/set cleanup paths take over once conversion has started.
    for cleanup_index in 0..<target_params.count |buffer, target_params, indent|:
        cleanup_type_name: sview = pymodule_bare_type_name(target_params[cleanup_index].type_expression)
        if target_params[cleanup_index].has_default and (pymodule_default_is_container(target_params[cleanup_index].default_value) or pymodule_parameter_is_implicit_optional(cleanup_type_name)):
            emit_tokens_push_sview(buffer, indent)
            emit_tokens_push_sview(buffer, "Py_XDECREF(arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_default);\n")


