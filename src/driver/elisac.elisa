} for (const char *const *field = field_names; *field != NULL; ++field) { if (PyDict_SetItemString(fields, *field, any) < 0) { Py_DECREF(fields); Py_DECREF(any); Py_DECREF(typed_dict); Py_DECREF(typing); return NULL; } } PyObject *name_object = PyUnicode_FromString(name); PyObject *result = name_object == NULL ? NULL : PyObject_CallFunctionObjArgs(typed_dict, name_object, fields, NULL); Py_XDECREF(name_object); Py_DECREF(fields); Py_DECREF(any); Py_DECREF(typed_dict); Py_DECREF(typing); return result; }\n\n")
