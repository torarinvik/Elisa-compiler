    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native dictionary count does not match occupied buckets\"); return NULL;\n    }\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "    ")
    emit_pymodule_dict_cleanup(buffer, target_params, "    ")
    emit_tokens_push_sview(buffer, "    arena_free(&arena);\n    return out;\n")


# Reuse the dict return copier inside a struct field block. Its arena cleanup is redirected to a
# zero local arena because the enclosing wrapper owns the native return arena until the whole
# struct has been copied.
def emit_pymodule_struct_dict_field_c_to_py(buffer: mutable darray[u8]&, field_type_name: sview, field_name: sview, python_field_name: sview, nested_value_helper: sview = "") -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    snippet: mutable darray[u8] = []
    empty_params: darray[Ast::ParamDecl] = []
    emit_tokens_push_sview(buffer, "ElisaDict result = value.")
    emit_tokens_push_sview(buffer, field_name)
    emit_tokens_push_sview(buffer, "; ElisaArena arena = {0};\n")
    emit_pymodule_dict_return_conversion(&snippet, empty_params, field_type_name, true, nested_value_helper)
    done_label: mutable darray[u8] = []
    emit_tokens_push_sview(&done_label, "elisa_pymodule_dict_field_done_")
    emit_tokens_push_sview(&done_label, field_name)
    done_label_view: sview = sview(&done_label[0], 0, done_label.count)
    replacement: mutable darray[u8] = []
    emit_tokens_push_sview(&replacement, "field_value = out; goto ")
    emit_tokens_push_sview(&replacement, done_label_view)
    emit_tokens_push_sview(&replacement, ";")
    replacement_view: sview = sview(&replacement[0], 0, replacement.count)
    pymodule_replace_generated(&snippet, "return out;", replacement_view)
    # The normal dictionary copier owns a local `out` mapping.  A struct
    # conversion already has an outer `out` mapping for the whole record, so
    # give the nested copier its own name before splicing it into that scope.
    pymodule_replace_generated_local(&snippet, "out", "field_out")
    for snippet_index in 0..<snippet.count |buffer, snippet|:
        buffer.push(snippet[snippet_index])
    emit_tokens_push_sview(buffer, "\n")
    emit_tokens_push_sview(buffer, done_label_view)
    emit_tokens_push_sview(buffer, ":; ")


def emit_pymodule_struct_set_field_c_to_py(buffer: mutable darray[u8]&, field_type_name: sview, field_name: sview, python_field_name: sview) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    snippet: mutable darray[u8] = []
    empty_params: darray[Ast::ParamDecl] = []
    emit_tokens_push_sview(buffer, "ElisaSet result = value.")
    emit_tokens_push_sview(buffer, field_name)
    emit_tokens_push_sview(buffer, "; ElisaArena arena = {0};\n")
    emit_pymodule_set_return_conversion(&snippet, empty_params, field_type_name, true)
    done_label: mutable darray[u8] = []
    emit_tokens_push_sview(&done_label, "elisa_pymodule_set_field_done_")
    emit_tokens_push_sview(&done_label, field_name)
    done_label_view: sview = sview(&done_label[0], 0, done_label.count)
    replacement: mutable darray[u8] = []
    emit_tokens_push_sview(&replacement, "field_value = out; goto ")
    emit_tokens_push_sview(&replacement, done_label_view)
    emit_tokens_push_sview(&replacement, ";")
    replacement_view: sview = sview(&replacement[0], 0, replacement.count)
    pymodule_replace_generated(&snippet, "return out;", replacement_view)
    pymodule_replace_generated_local(&snippet, "out", "field_out")
    for snippet_index in 0..<snippet.count |buffer, snippet|:
        buffer.push(snippet[snippet_index])
    emit_tokens_push_sview(buffer, "\n")
    emit_tokens_push_sview(buffer, done_label_view)
    emit_tokens_push_sview(buffer, ":; ")


def emit_pymodule_set_return_conversion(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, type_name: sview, is_error: bool) -> void can[Abort.Panic, Memory.Allocate]:
    element_name: sview = pymodule_set_element_name(type_name)
    element_c_type: sview = pymodule_darray_c_element_type(element_name)
    emit_tokens_push_sview(buffer, ");\n") if not is_error
    emit_tokens_push_sview(buffer, "    if (result.count < 0 || result.used < 0 || result.capacity < 0 || result.count > result.used || result.used > result.capacity || result.count > PY_SSIZE_T_MAX || result.capacity > PY_SSIZE_T_MAX) {\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native Elisa function returned an invalid set header\"); return NULL;\n    }\n    PyObject *out = PySet_New(NULL);\n    if (out == NULL) {\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena); return NULL;\n    }\n    if (result.count == 0) {\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena); return out;\n    }\n    if (result.items == NULL || result.capacity == 0) {\n        Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native Elisa function returned null set storage\"); return NULL;\n    }\n    typedef struct { ")
    emit_tokens_push_sview(buffer, element_c_type)
    emit_tokens_push_sview(buffer, " key; uint8_t state; } ElisaPymoduleSetResultBucket;\n    int64_t result_seen = 0;\n    for (int64_t result_index = 0; result_index < result.capacity; ++result_index) {\n        ElisaPymoduleSetResultBucket *bucket = &((ElisaPymoduleSetResultBucket *)result.items)[result_index];\n        if (bucket->state != 1) continue;\n        PyObject *result_item = NULL;\n")
    if element_name == "cstr":
        emit_tokens_push_sview(buffer, "        if (bucket->key == NULL) { Py_DECREF(out);\n")
        emit_pymodule_darray_cleanup(buffer, target_params, "            ")
        emit_pymodule_dict_cleanup(buffer, target_params, "            ")
        emit_tokens_push_sview(buffer, "            arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native set returned a null cstr element\"); return NULL; }\n        result_item = PyUnicode_FromString(bucket->key);\n")
    elif element_name == "sview":
        emit_tokens_push_sview(buffer, "        ElisaSView result_view = bucket->key; if (result_view.len < 0 || result_view.len > PY_SSIZE_T_MAX || (result_view.data == NULL && result_view.len != 0)) { Py_DECREF(out);\n")
        emit_pymodule_darray_cleanup(buffer, target_params, "            ")
        emit_pymodule_dict_cleanup(buffer, target_params, "            ")
        emit_tokens_push_sview(buffer, "            arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native set returned an invalid sview element\"); return NULL; } if (result_view.data == NULL) result_item = PyUnicode_FromString(\"\"); else result_item = PyUnicode_DecodeUTF8(result_view.data, (Py_ssize_t)result_view.len, \"strict\");\n")
    elif element_name == "bool":
        emit_tokens_push_sview(buffer, "        result_item = PyBool_FromLong((long)bucket->key);\n")
    elif pymodule_darray_element_is_unsigned(element_name):
        emit_tokens_push_sview(buffer, "        result_item = PyLong_FromUnsignedLongLong((unsigned long long)bucket->key);\n")
    else:
        emit_tokens_push_sview(buffer, "        result_item = PyLong_FromLongLong((long long)bucket->key);\n")
    emit_tokens_push_sview(buffer, "        if (result_item == NULL) { Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "            ")
    emit_pymodule_dict_cleanup(buffer, target_params, "            ")
    emit_tokens_push_sview(buffer, "            arena_free(&arena); return NULL; }\n        if (PySet_Add(out, result_item) < 0) { Py_DECREF(result_item); Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "            ")
    emit_pymodule_dict_cleanup(buffer, target_params, "            ")
    emit_tokens_push_sview(buffer, "            arena_free(&arena); return NULL; }\n        Py_DECREF(result_item); result_seen++;\n    }\n    if (result_seen != result.count) { Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native set count does not match occupied buckets\"); return NULL;\n    }\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "    ")
    emit_pymodule_dict_cleanup(buffer, target_params, "    ")
    emit_tokens_push_sview(buffer, "    arena_free(&arena); return out;\n")


def emit_pymodule_view_return_conversion(buffer: mutable darray[u8]&, file: Ast::File&, target_params: darray[Ast::ParamDecl]&, type_name: sview, is_error: bool, has_input_arena: bool) -> void can[Abort.Panic, Memory.Allocate]:
    element_name: sview = pymodule_view_element_name(type_name)
    element_c_type: mutable sview = pymodule_darray_c_element_type(element_name)
    element_c_type <- element_name if element_c_type == "" and pymodule_struct_return_supported(file, element_name)
    emit_tokens_push_sview(buffer, ");\n") if not is_error
    emit_tokens_push_sview(buffer, "    if (result.len < 0 || result.len > PY_SSIZE_T_MAX || (result.data == NULL && result.len != 0)) {\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena);\n") if has_input_arena
    emit_tokens_push_sview(buffer, "        PyErr_SetString(PyExc_RuntimeError, \"native Elisa function returned an invalid view\"); return NULL;\n    }\n")
    if element_name == "u8":
        emit_tokens_push_sview(buffer, "    PyObject *out = PyBytes_FromStringAndSize((const char *)result.data, (Py_ssize_t)result.len);\n")
        emit_pymodule_darray_cleanup(buffer, target_params, "    ")
        emit_pymodule_dict_cleanup(buffer, target_params, "    ")
        emit_tokens_push_sview(buffer, "    arena_free(&arena);\n") if has_input_arena
        emit_tokens_push_sview(buffer, "    return out;\n")
        return
    emit_tokens_push_sview(buffer, "    PyObject *out = PyList_New((Py_ssize_t)result.len);\n    if (out == NULL) {\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
    emit_tokens_push_sview(buffer, "        arena_free(&arena);\n") if has_input_arena
    emit_tokens_push_sview(buffer, "        return NULL;\n    }\n    for (Py_ssize_t result_index = 0; result_index < (Py_ssize_t)result.len; ++result_index) {\n        PyObject *item = NULL;\n")
    if pymodule_struct_return_supported(file, element_name):
        emit_tokens_push_sview(buffer, "        item = elisa_pymodule_struct_")
        emit_tokens_push_sview(buffer, element_name)
        emit_tokens_push_sview(buffer, "_to_py(((")
        emit_tokens_push_sview(buffer, element_c_type)
        emit_tokens_push_sview(buffer, " *)result.data)[result_index]);\n")
    elif element_name == "sview" or element_name == "sview?":
        if element_name == "sview?":
            emit_tokens_push_sview(buffer, "        ElisaOptionalSView item_view = ((ElisaOptionalSView *)result.data)[result_index];\n        if (!item_view.has_value) { Py_INCREF(Py_None); item = Py_None; } else {\n            if (item_view.value.len < 0 || item_view.value.len > PY_SSIZE_T_MAX || (item_view.value.data == NULL && item_view.value.len != 0)) { Py_DECREF(out);\n")
            emit_pymodule_darray_cleanup(buffer, target_params, "                ")
            emit_pymodule_dict_cleanup(buffer, target_params, "                ")
            emit_tokens_push_sview(buffer, "                arena_free(&arena);\n") if has_input_arena
            emit_tokens_push_sview(buffer, "                PyErr_SetString(PyExc_RuntimeError, \"native optional sview view element is invalid\"); return NULL; }\n            item = item_view.value.data == NULL ? PyUnicode_FromString(\"\") : PyUnicode_DecodeUTF8(item_view.value.data, (Py_ssize_t)item_view.value.len, \"strict\");\n        }\n")
        else:
            emit_tokens_push_sview(buffer, "        ElisaSView item_view = ((ElisaSView *)result.data)[result_index];\n        if (item_view.len < 0 || item_view.len > PY_SSIZE_T_MAX || (item_view.data == NULL && item_view.len != 0)) { Py_DECREF(out);\n")
            emit_pymodule_darray_cleanup(buffer, target_params, "            ")
            emit_pymodule_dict_cleanup(buffer, target_params, "            ")
            emit_tokens_push_sview(buffer, "            arena_free(&arena);\n") if has_input_arena
            emit_tokens_push_sview(buffer, "            PyErr_SetString(PyExc_RuntimeError, \"native sview view element is invalid\"); return NULL; }\n        item = item_view.data == NULL ? PyUnicode_FromString(\"\") : PyUnicode_DecodeUTF8(item_view.data, (Py_ssize_t)item_view.len, \"strict\");\n")
    elif element_name == "cstr" or element_name == "cstr?":
        emit_tokens_push_sview(buffer, "        const char *item_text = ((const char **)result.data)[result_index];\n")
        if element_name == "cstr?":
            emit_tokens_push_sview(buffer, "        if (item_text == NULL) { Py_INCREF(Py_None); item = Py_None; } else item = PyUnicode_FromString(item_text);\n")
        else:
            emit_tokens_push_sview(buffer, "        if (item_text == NULL) { Py_DECREF(out);\n")
            emit_pymodule_darray_cleanup(buffer, target_params, "            ")
            emit_pymodule_dict_cleanup(buffer, target_params, "            ")
            emit_tokens_push_sview(buffer, "            arena_free(&arena);\n") if has_input_arena
            emit_tokens_push_sview(buffer, "            PyErr_SetString(PyExc_RuntimeError, \"native view returned a null cstr element\"); return NULL; }\n        item = PyUnicode_FromString(item_text);\n")
    elif element_name == "py::Object" or element_name == "py::Object?":
        emit_tokens_push_sview(buffer, "        item = ((PyObject **)result.data)[result_index];\n        if (item == NULL) { Py_INCREF(Py_None); item = Py_None; } else Py_INCREF(item);\n")
    elif pymodule_is_optional_scalar_type(element_name):
        optional_c_type: sview = pymodule_c_type_name(element_name)
        payload_name: sview = pymodule_optional_payload_name(element_name)
        emit_tokens_push_sview(buffer, "        ")
        emit_tokens_push_sview(buffer, optional_c_type)
        emit_tokens_push_sview(buffer, " item_optional = ((")
        emit_tokens_push_sview(buffer, optional_c_type)
        emit_tokens_push_sview(buffer, " *)result.data)[result_index]; if (!item_optional.has_value) { Py_INCREF(Py_None); item = Py_None; } else {")
        if payload_name == "bool":
            emit_tokens_push_sview(buffer, " item = PyBool_FromLong((long)item_optional.value); }\n")
        elif payload_name == "f32" or payload_name == "f64":
            emit_tokens_push_sview(buffer, " item = PyFloat_FromDouble((double)item_optional.value); }\n")
        elif payload_name == "u8" or payload_name == "u16" or payload_name == "u32" or payload_name == "u64" or payload_name == "usize" or payload_name == "uintptr":
            emit_tokens_push_sview(buffer, " item = PyLong_FromUnsignedLongLong((unsigned long long)item_optional.value); }\n")
        else:
            emit_tokens_push_sview(buffer, " item = PyLong_FromLongLong((long long)item_optional.value); }\n")
    elif element_name == "bool":
        emit_tokens_push_sview(buffer, "        item = PyBool_FromLong((long)((bool *)result.data)[result_index]);\n")
    elif element_name == "f32" or element_name == "f64":
        emit_tokens_push_sview(buffer, "        item = PyFloat_FromDouble((double)((")
        emit_tokens_push_sview(buffer, element_c_type)
        emit_tokens_push_sview(buffer, " *)result.data)[result_index]);\n")
    elif pymodule_darray_element_is_unsigned(element_name):
        emit_tokens_push_sview(buffer, "        item = PyLong_FromUnsignedLongLong((unsigned long long)((")
        emit_tokens_push_sview(buffer, element_c_type)
        emit_tokens_push_sview(buffer, " *)result.data)[result_index]);\n")
    else:
        emit_tokens_push_sview(buffer, "        item = PyLong_FromLongLong((long long)((")
        emit_tokens_push_sview(buffer, element_c_type)
        emit_tokens_push_sview(buffer, " *)result.data)[result_index]);\n")
    emit_tokens_push_sview(buffer, "        if (item == NULL) { Py_DECREF(out);\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "            ")
    emit_pymodule_dict_cleanup(buffer, target_params, "            ")
    emit_tokens_push_sview(buffer, "            arena_free(&arena);\n") if has_input_arena
    emit_tokens_push_sview(buffer, "            return NULL;\n        }\n        PyList_SET_ITEM(out, result_index, item);\n    }\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "    ")
    emit_pymodule_dict_cleanup(buffer, target_params, "    ")
    emit_tokens_push_sview(buffer, "    arena_free(&arena);\n") if has_input_arena
    emit_tokens_push_sview(buffer, "    return out;\n")


def emit_pymodule_optional_input_setup(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, type_name: sview, parameter_index: usize) -> void can[Abort.Panic, Memory.Allocate]:
    c_type: sview = pymodule_c_type_name(type_name)
    payload_name: sview = pymodule_optional_payload_name(type_name)
    if payload_name == "sview":
        emit_tokens_push_sview(buffer, "    ElisaOptionalSView arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, " = {false, {0, 0}};\n    if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_obj != Py_None) {\n        Py_ssize_t arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_len = 0; const char *arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_data = NULL; if (PyUnicode_Check(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_obj)) arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_data = PyUnicode_AsUTF8AndSize(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_obj, &arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_len); else if (PyBytes_Check(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_obj)) { char *arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_bytes_data = NULL; if (PyBytes_AsStringAndSize(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_obj, &arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_bytes_data, &arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_len) < 0) arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_data = NULL; else arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_data = arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_bytes_data; } else { PyErr_SetString(PyExc_TypeError, \"expected str or bytes for sview?\"); }\n        if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_data == NULL) {\n")
        emit_pymodule_darray_cleanup(buffer, target_params, "            ")
        emit_pymodule_dict_cleanup_one(buffer, target_params, parameter_index, "            ")
        emit_tokens_push_sview(buffer, "            return NULL;\n        }\n        if (elisa_pymodule_validate_utf8(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_data, arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_len) < 0) {\n")
        emit_pymodule_darray_cleanup(buffer, target_params, "            ")
        emit_pymodule_dict_cleanup_one(buffer, target_params, parameter_index, "            ")
        emit_tokens_push_sview(buffer, "            return NULL;\n        }\n        arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, " = (ElisaOptionalSView){true, (ElisaSView){arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_data, (int64_t)arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_len}};\n    }\n")
        return
    emit_tokens_push_sview(buffer, "    ")
    emit_tokens_push_sview(buffer, c_type)
    emit_tokens_push_sview(buffer, " arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, " = {false, 0};\n    if (arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_obj != Py_None) {\n")
    if payload_name == "bool":
        emit_tokens_push_sview(buffer, "        int arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_truth = PyObject_IsTrue(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_obj);\n        if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_truth < 0) {\n")
    elif payload_name == "f32" or payload_name == "f64":
        emit_tokens_push_sview(buffer, "        double arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number = PyFloat_AsDouble(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_obj);\n        if (PyErr_Occurred()) {\n")
    elif payload_name == "u8" or payload_name == "u16" or payload_name == "u32" or payload_name == "u64" or payload_name == "usize":
        emit_tokens_push_sview(buffer, "        unsigned long long arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number = PyLong_AsUnsignedLongLong(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_obj);\n        if (PyErr_Occurred()) {\n")
    else:
        emit_tokens_push_sview(buffer, "        long long arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number = PyLong_AsLongLong(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_obj);\n        if (PyErr_Occurred()) {\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "            ")
    emit_pymodule_dict_cleanup_one(buffer, target_params, parameter_index, "            ")
    emit_tokens_push_sview(buffer, "            return NULL;\n        }\n")
    if payload_name == "i8":
        emit_tokens_push_sview(buffer, "        if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number < -128 || arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number > 127) { PyErr_SetString(PyExc_OverflowError, \"i8 value out of range\");\n")
    elif payload_name == "i16":
        emit_tokens_push_sview(buffer, "        if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number < -32768 || arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number > 32767) { PyErr_SetString(PyExc_OverflowError, \"i16 value out of range\");\n")
    elif payload_name == "i32":
        emit_tokens_push_sview(buffer, "        if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number < -2147483648LL || arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number > 2147483647LL) { PyErr_SetString(PyExc_OverflowError, \"i32 value out of range\");\n")
    elif payload_name == "u8":
        emit_tokens_push_sview(buffer, "        if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number > 255ULL) { PyErr_SetString(PyExc_OverflowError, \"u8 value out of range\");\n")
    elif payload_name == "u16":
        emit_tokens_push_sview(buffer, "        if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number > 65535ULL) { PyErr_SetString(PyExc_OverflowError, \"u16 value out of range\");\n")
    elif payload_name == "u32":
        emit_tokens_push_sview(buffer, "        if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number > 4294967295ULL) { PyErr_SetString(PyExc_OverflowError, \"u32 value out of range\");\n")
    if payload_name == "i8" or payload_name == "i16" or payload_name == "i32" or payload_name == "u8" or payload_name == "u16" or payload_name == "u32":
        emit_pymodule_dict_cleanup_one(buffer, target_params, parameter_index, "            ")
        emit_tokens_push_sview(buffer, "            return NULL; }\n")
    emit_tokens_push_sview(buffer, "        arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, " = (")
    emit_tokens_push_sview(buffer, c_type)
    emit_tokens_push_sview(buffer, "){true, (")
    emit_tokens_push_sview(buffer, "bool" if payload_name == "bool" else "double" if payload_name == "f32" or payload_name == "f64" else "unsigned long long" if payload_name == "u8" or payload_name == "u16" or payload_name == "u32" or payload_name == "u64" or payload_name == "usize" else "long long")
    emit_tokens_push_sview(buffer, ")(arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_truth" if payload_name == "bool" else "_number")
    emit_tokens_push_sview(buffer, ")};\n    }\n")


def emit_pymodule_optional_return_conversion(buffer: mutable darray[u8]&, type_name: sview, value_name: sview) -> void can[Abort.Panic, Memory.Allocate]:
    payload_name: sview = pymodule_optional_payload_name(type_name)
    emit_tokens_push_sview(buffer, "    if (!")
    emit_tokens_push_sview(buffer, value_name)
    emit_tokens_push_sview(buffer, ".has_value) Py_RETURN_NONE;\n")
    if payload_name == "sview":
        emit_tokens_push_sview(buffer, "    if (")
        emit_tokens_push_sview(buffer, value_name)
        emit_tokens_push_sview(buffer, ".value.len < 0 || (")
        emit_tokens_push_sview(buffer, value_name)
        emit_tokens_push_sview(buffer, ".value.data == NULL && ")
        emit_tokens_push_sview(buffer, value_name)
        emit_tokens_push_sview(buffer, ".value.len != 0)) { PyErr_SetString(PyExc_RuntimeError, \"native optional sview has invalid length\"); return NULL; }\n    if (")
        emit_tokens_push_sview(buffer, value_name)
        emit_tokens_push_sview(buffer, ".value.data == NULL) return PyUnicode_FromString(\"\");\n    return PyUnicode_DecodeUTF8(")
        emit_tokens_push_sview(buffer, value_name)
        emit_tokens_push_sview(buffer, ".value.data, (Py_ssize_t)")
        emit_tokens_push_sview(buffer, value_name)
        emit_tokens_push_sview(buffer, ".value.len, \"strict\");\n")
        return
    if payload_name == "bool":
        emit_tokens_push_sview(buffer, "    return PyBool_FromLong((long)")
    elif payload_name == "f32" or payload_name == "f64":
        emit_tokens_push_sview(buffer, "    return PyFloat_FromDouble((double)")
    elif payload_name == "u8" or payload_name == "u16" or payload_name == "u32" or payload_name == "u64" or payload_name == "usize":
        emit_tokens_push_sview(buffer, "    return PyLong_FromUnsignedLongLong((unsigned long long)")
    else:
        emit_tokens_push_sview(buffer, "    return PyLong_FromLongLong((long long)")
    emit_tokens_push_sview(buffer, value_name)
    emit_tokens_push_sview(buffer, ".value);\n")


def emit_pymodule_runtime_error_payload_types(buffer: mutable darray[u8]&, file: Ast::File&, error_families: darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    # Structured error payload variants are TypedDict declarations in the stub.
    # Publish matching runtime factories too, so explicit imports used by
    # serializers, validation helpers, and IDE-generated code do not fail at
    # runtime. The aliases are deliberately kept out of __all__: they are type
    # helpers, not ordinary Elisa exports.
    payload_variant_index: mutable usize = 0.usize()
    for payload_family in error_families |buffer, file, payload_variant_index|:
        continue if not pymodule_error_payload_is_structured_in(file.top_decls, payload_family)
        payload_decl: Ast::Decl? = pymodule_error_decl_in(file.top_decls, payload_family)
        if payload_decl is payload_enum_decl:
            if payload_enum_decl is Decl.Enum(payload_enum_name, payload_variants, payload_const, payload_storage, payload_pos):
                variant_count: usize = payload_variants.count
                continue if variant_count == 0
                family_start_index: usize = payload_variant_index
                emit_tokens_push_sview(buffer, "    {\n")
                for payload_variant in payload_variants |buffer, file, payload_variant_index|:
                    emit_tokens_push_sview(buffer, "        PyObject *elisa_payload_name_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, " = elisa_pymodule_choose_generated_name(module, \"")
                    emit_tokens_push_sview(buffer, payload_family)
                    emit_tokens_push_sview(buffer, payload_variant.name)
                    emit_tokens_push_sview(buffer, "Payload\"); if (elisa_payload_name_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(module); return NULL; } const char *elisa_payload_name_text_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, " = PyUnicode_AsUTF8(elisa_payload_name_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, "); if (elisa_payload_name_text_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(elisa_payload_name_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(module); return NULL; } PyObject *elisa_payload_type_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, " = elisa_pymodule_make_struct_type_with_optional(elisa_payload_name_text_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, ", elisa_pymodule_payload_fields_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, ", elisa_pymodule_payload_optional_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, "); if (elisa_payload_type_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, " == NULL || elisa_pymodule_stamp_type_module(module, elisa_payload_type_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, ") < 0) { Py_XDECREF(elisa_payload_type_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(elisa_payload_name_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(module); return NULL; } if (PyModule_AddObject(module, elisa_payload_name_text_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, ", elisa_payload_type_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, ") < 0) { Py_DECREF(elisa_payload_type_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(elisa_payload_name_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(module); return NULL; } elisa_payload_type_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, " = PyObject_GetAttrString(module, elisa_payload_name_text_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(elisa_payload_name_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, "); if (elisa_payload_type_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(module); return NULL; }\n")
                    payload_variant_index <- payload_variant_index + 1.usize()
                alias_index: usize = payload_variant_index
                emit_tokens_push_sview(buffer, "        PyObject *elisa_payload_union_name_")
                append_decimal(buffer, alias_index.u32())
                emit_tokens_push_sview(buffer, " = elisa_pymodule_choose_generated_name(module, \"")
                emit_tokens_push_sview(buffer, payload_family)
                emit_tokens_push_sview(buffer, "Payload\"); if (elisa_payload_union_name_")
                append_decimal(buffer, alias_index.u32())
                emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(module); return NULL; } const char *elisa_payload_union_name_text_")
                append_decimal(buffer, alias_index.u32())
                emit_tokens_push_sview(buffer, " = PyUnicode_AsUTF8(elisa_payload_union_name_")
                append_decimal(buffer, alias_index.u32())
                emit_tokens_push_sview(buffer, "); if (elisa_payload_union_name_text_")
                append_decimal(buffer, alias_index.u32())
                emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(elisa_payload_union_name_")
                append_decimal(buffer, alias_index.u32())
                emit_tokens_push_sview(buffer, "); Py_DECREF(module); return NULL; }\n")
                if variant_count == 1:
                    emit_tokens_push_sview(buffer, "        Py_INCREF(elisa_payload_type_")
                    append_decimal(buffer, family_start_index.u32())
                    emit_tokens_push_sview(buffer, "); if (PyModule_AddObject(module, elisa_payload_union_name_text_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, ", elisa_payload_type_")
                    append_decimal(buffer, family_start_index.u32())
                    emit_tokens_push_sview(buffer, ") < 0) { Py_DECREF(elisa_payload_type_")
                    append_decimal(buffer, family_start_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(elisa_payload_union_name_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(module); return NULL; } Py_DECREF(elisa_payload_type_")
                    append_decimal(buffer, family_start_index.u32())
                    emit_tokens_push_sview(buffer, ");\n")
                else:
                    emit_tokens_push_sview(buffer, "        PyObject *elisa_payload_union_args_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, " = PyTuple_New(")
                    append_decimal(buffer, variant_count.u32())
                    emit_tokens_push_sview(buffer, "); if (elisa_payload_union_args_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(elisa_payload_union_name_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(module); return NULL; }\n")
                    for payload_union_index in family_start_index..<payload_variant_index |buffer|:
                        emit_tokens_push_sview(buffer, "        Py_INCREF(elisa_payload_type_")
                        append_decimal(buffer, payload_union_index.u32())
                        emit_tokens_push_sview(buffer, "); PyTuple_SET_ITEM(elisa_payload_union_args_")
                        append_decimal(buffer, alias_index.u32())
                        emit_tokens_push_sview(buffer, ", ")
                        append_decimal(buffer, (payload_union_index - family_start_index).u32())
                        emit_tokens_push_sview(buffer, ", elisa_payload_type_")
                        append_decimal(buffer, payload_union_index.u32())
                        emit_tokens_push_sview(buffer, "); Py_DECREF(elisa_payload_type_")
                        append_decimal(buffer, payload_union_index.u32())
                        emit_tokens_push_sview(buffer, ");\n")
                    emit_tokens_push_sview(buffer, "        PyObject *elisa_payload_typing_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, " = PyImport_ImportModule(\"typing\"); PyObject *elisa_payload_union_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, " = elisa_payload_typing_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, " == NULL ? NULL : PyObject_GetAttrString(elisa_payload_typing_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, ", \"Union\"); PyObject *elisa_payload_union_value_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, " = elisa_payload_union_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, " == NULL ? NULL : PyObject_GetItem(elisa_payload_union_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, ", elisa_payload_union_args_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_XDECREF(elisa_payload_union_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_XDECREF(elisa_payload_typing_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(elisa_payload_union_args_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, ");\n")
                    for payload_release_index in family_start_index..<payload_variant_index |buffer|:
                        emit_tokens_push_sview(buffer, "        Py_DECREF(elisa_payload_type_")
                        append_decimal(buffer, payload_release_index.u32())
                        emit_tokens_push_sview(buffer, ");\n")
                    emit_tokens_push_sview(buffer, "        if (elisa_payload_union_value_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, " == NULL || PyModule_AddObject(module, elisa_payload_union_name_text_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, ", elisa_payload_union_value_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, ") < 0) { Py_XDECREF(elisa_payload_union_value_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(elisa_payload_union_name_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(module); return NULL; }\n")
                emit_tokens_push_sview(buffer, "        Py_DECREF(elisa_payload_union_name_")
                append_decimal(buffer, alias_index.u32())
                emit_tokens_push_sview(buffer, ");\n    }\n")


def emit_pymodule_c_report(file: mutable Ast::File&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    pymodule_expand_wildcard_exports(file)
    module_name: mutable sview = ""
    for annotation in file.enum_annotations |module_name|:
        module_name <- annotation.owner if annotation.name == "__export_pymodule" and module_name == ""
    if module_name == "":
        message: mutable darray[u8] = []
        emit_tokens_push_sview(&message, "error: -emit pymodule-c requires `export pymodule NAME:`\n")
        write_stderr(message)
        return 1
    return 1 if not pymodule_validate_reserved_export_names(file, "pymodule-c")
    error_families: darray[sview] = pymodule_error_families(file)
    buffer: mutable darray[u8] = []
    emit_tokens_push_sview(&buffer, "#define PY_SSIZE_T_CLEAN\n#include <Python.h>\n#include <stdbool.h>\n#include <stdint.h>\n#include <stddef.h>\n\ntypedef struct { const char *data; int64_t len; } ElisaSView;\ntypedef struct { void *items; int64_t count; int64_t capacity; } ElisaDArray;\ntypedef struct { void *base; void *tail; int64_t reserved; int64_t strategy; } ElisaArena;\nextern void arena_free(void *arena);\n\nstatic PyObject *elisa_error_type = NULL;\nstatic PyObject *elisa_pymodule_error_message(const char *function_name, int32_t code, PyObject *payload) {\n    PyObject *payload_repr = payload == NULL ? NULL : PyObject_Repr(payload);\n    if (payload != NULL && payload_repr == NULL) return NULL;\n    PyObject *message = payload == NULL\n        ? PyUnicode_FromFormat(\"Elisa function '%s' failed with error code %d\", function_name, (int)code)\n        : PyUnicode_FromFormat(\"Elisa function '%s' failed with error code %d (payload: %U)\", function_name, (int)code, payload_repr);\n    Py_XDECREF(payload_repr);\n    return message;\n}\nstatic PyObject *elisa_raise_error(const char *function_name, int32_t code) {\n    if (elisa_error_type == NULL) {\n        PyErr_Format(PyExc_RuntimeError, \"Elisa function '%s' failed with error code %d\", function_name, (int)code);\n        return NULL;\n    }\n    PyObject *message = elisa_pymodule_error_message(function_name, code, NULL);\n    if (message == NULL) return NULL;\n    PyObject *error = PyObject_CallFunctionObjArgs(elisa_error_type, message, NULL);\n    Py_DECREF(message);\n    if (error == NULL) return NULL;\n    PyObject *code_object = PyLong_FromLong((long)code);\n    if (code_object == NULL || PyObject_SetAttrString(error, \"code\", code_object) < 0) {\n        Py_XDECREF(code_object); Py_DECREF(error); return NULL;\n    }\n    Py_DECREF(code_object);\n    PyObject *function_object = PyUnicode_FromString(function_name);\n    if (function_object == NULL || PyObject_SetAttrString(error, \"function\", function_object) < 0) {\n        Py_XDECREF(function_object); Py_DECREF(error); return NULL;\n    }\n    Py_DECREF(function_object);\n    PyErr_SetObject(elisa_error_type, error);\n    Py_DECREF(error);\n    return NULL;\n}\n\n")
    emit_tokens_push_sview(&buffer, "/* Prefix Python argument failures with the exported Elisa function. PyArg_ParseTupleAndKeywords already names the offending argument when it can; preserving the original exception class and detail keeps normal Python validation behavior while making the boundary obvious in tracebacks and logs. */\nstatic void elisa_pymodule_annotate_argument_error(const char *function_name, const char *parameter_name) {\n    if (!PyErr_Occurred()) return;\n    PyObject *error_type = NULL;\n    PyObject *error_value = NULL;\n    PyObject *error_traceback = NULL;\n    PyErr_Fetch(&error_type, &error_value, &error_traceback);\n    if (error_value == NULL) {\n        PyErr_Restore(error_type, error_value, error_traceback);\n        return;\n    }\n    PyObject *detail = PyObject_Str(error_value);\n    if (detail == NULL) {\n        PyErr_Restore(error_type, error_value, error_traceback);\n        return;\n    }\n    PyObject *message = parameter_name == NULL\n        ? PyUnicode_FromFormat(\"Elisa function '%s' argument error: %U\", function_name, detail)\n        : PyUnicode_FromFormat(\"Elisa function '%s' argument '%s': %U\", function_name, parameter_name, detail);\n    Py_DECREF(detail);\n    if (message == NULL) {\n        PyErr_Restore(error_type, error_value, error_traceback);\n        return;\n    }\n    if (error_type == NULL) error_type = PyExc_TypeError;\n    PyErr_SetObject(error_type, message);\n    Py_DECREF(message);\n    Py_XDECREF(error_type);\n    Py_XDECREF(error_value);\n    Py_XDECREF(error_traceback);\n}\n\n")
    emit_tokens_push_sview(&buffer, "/* Keep text inputs consistent at every boundary. Python's scalar `s#` parser accepts Unicode and bytes, while this helper extends the same rule to lists, sets, mappings, views, and struct fields. Bytes are validated as UTF-8 while their original storage remains owned by the Python container for the duration of the call. */\nstatic int elisa_pymodule_validate_utf8(const char *data, Py_ssize_t size) {\n    if (size <= 0) return 0;\n    if (data == NULL) { PyErr_SetString(PyExc_ValueError, \"text input has null storage\"); return -1; }\n    PyObject *validated = PyUnicode_DecodeUTF8(data, size, \"strict\");\n    if (validated == NULL) return -1;\n    Py_DECREF(validated);\n    return 0;\n}\nstatic const char *elisa_pymodule_text_data(PyObject *object, Py_ssize_t *size) {\n    if (PyUnicode_Check(object)) return PyUnicode_AsUTF8AndSize(object, size);\n    if (PyBytes_Check(object)) {\n        char *data = NULL;\n        if (PyBytes_AsStringAndSize(object, &data, size) < 0) return NULL;\n        if (elisa_pymodule_validate_utf8(data, *size) < 0) return NULL;\n        return data;\n    }\n    PyErr_SetString(PyExc_TypeError, \"expected str or bytes\");\n    return NULL;\n}\n#define PyUnicode_AsUTF8AndSize elisa_pymodule_text_data\n\n")
    emit_tokens_push_sview(&buffer, "typedef struct { PyObject **items; Py_ssize_t count; Py_ssize_t capacity; } ElisaPyRefs;\nstatic int elisa_pymodule_retain(PyObject *value, ElisaPyRefs *refs) {\n    if (refs->count == refs->capacity) {\n        Py_ssize_t next = refs->capacity == 0 ? 8 : refs->capacity * 2;\n        if (next < refs->capacity || next > PY_SSIZE_T_MAX / (Py_ssize_t)sizeof(PyObject *)) { PyErr_NoMemory(); return -1; }\n        PyObject **grown = (PyObject **)PyMem_Realloc(refs->items, (size_t)next * sizeof(PyObject *));\n        if (grown == NULL) { PyErr_NoMemory(); return -1; }\n        refs->items = grown; refs->capacity = next;\n    }\n    Py_INCREF(value); refs->items[refs->count++] = value; return 0;\n}\nstatic void elisa_pymodule_struct_refs_free(ElisaPyRefs *refs) {\n    for (Py_ssize_t index = 0; index < refs->count; ++index) Py_DECREF(refs->items[index]);\n    PyMem_Free(refs->items); refs->items = NULL; refs->count = 0; refs->capacity = 0;\n}\n\n")
    emit_tokens_push_sview(&buffer, "static PyObject *elisa_raise_error_with_payload(const char *function_name, int32_t code, PyObject *payload) {\n    if (elisa_error_type == NULL) { Py_XDECREF(payload); PyErr_Format(PyExc_RuntimeError, \"Elisa function '%s' failed with error code %d\", function_name, (int)code); return NULL; }\n    PyObject *message = PyUnicode_FromFormat(\"Elisa function '%s' failed with error code %d\", function_name, (int)code);\n    if (message == NULL) { Py_XDECREF(payload); return NULL; }\n    PyObject *error = PyObject_CallFunctionObjArgs(elisa_error_type, message, NULL); Py_DECREF(message);\n    if (error == NULL) { Py_XDECREF(payload); return NULL; }\n    PyObject *code_object = PyLong_FromLong((long)code);\n    if (code_object == NULL || PyObject_SetAttrString(error, \"code\", code_object) < 0) { Py_XDECREF(code_object); Py_XDECREF(payload); Py_DECREF(error); return NULL; }\n    Py_DECREF(code_object);\n    PyObject *function_object = PyUnicode_FromString(function_name);\n    if (function_object == NULL || PyObject_SetAttrString(error, \"function\", function_object) < 0) { Py_XDECREF(function_object); Py_XDECREF(payload); Py_DECREF(error); return NULL; }\n    Py_DECREF(function_object);\n    if (payload != NULL && PyObject_SetAttrString(error, \"payload\", payload) < 0) { Py_DECREF(payload); Py_DECREF(error); return NULL; }\n    Py_XDECREF(payload); PyErr_SetObject(elisa_error_type, error); Py_DECREF(error); return NULL;\n}\n\n")
