# Stage1 product compiler: real frontend (lexer/parser) + Backend::emit → native object.
#
# Wire protocol on stdin (kept simple for self-host / non-libc argv):
#   line 1: absolute or relative output object path
#   rest:   Elisa source (includes already expanded, or a single-file program)
#
# Host wrappers (scripts/elisac_stage1.sh) accept `elisac-stage1 -o out.o file.elisa`,
# expand includes, and feed this driver.
include "../backend/codegen.elisa"
include "./emit_fmt_expr.elisa"
# The SEMANTIC layer is part of the product, not just of the tooling. Without it the driver
# went parse -> emit and stage1 silently ACCEPTED programs stage0 rejects (`x: mutable u8 = 0;
# x <- 300` emitted an object under stage1 and exited 1 under stage0). The bootstrap fixpoint
# cannot see that: every generation skips the check consistently, so gen3 == gen4 holds while
# the compiler analyses nothing.
include "../semantic/semantic.elisa"

# Stage1 meta-compile: prefer `u8&`/`i64` over `void&`/`isize` for the read extern so the
# product driver itself lowers under stage1 (gen2). Link still resolves libc `read`.
extern read(fd: i64, buf: u8&, count: usize) -> i64
# Real-CLI support. `main(argc, argv)` is portable and stage0 has always supported it —
# the "non-libc argv" note above was wrong about the obstacle. What actually blocked it
# was that indexing a `T&&` (C's `char**`) DECLINED in stage1's backend until it was
# implemented; there is no platform hook needed (`_NSGetArgv` works but is macOS-only).
#
# Flags are re-exported through setenv so the existing ELISA_STAGE1_* readers below need
# no change: the CLI and the environment stay ONE code path, and the wrapper's env-var
# invocations keep working exactly as before.
extern open(path: cstr, flags: i64) -> i64
extern close(fd: i64) -> i64
extern setenv(name: cstr, value: cstr, overwrite: i64) -> i64
# Diagnostics go to STDERR through the std's libc `write` (declared in debug_referee.elisa as
# `write(fd: int, buf: void&, count: usize)`), NOT through `puts`: the driver includes
# elisacore_std, whose own `puts` overload shadows libc's under both the stage0 seed and the
# stage1 meta-compile. Passing an explicit length also avoids needing a NUL terminator on an
# owned darray.


# `n` as ASCII decimal, appended to `buffer`. Line numbers only, so u32 range is enough.
def append_decimal(buffer: mutable darray[u8]&, value: u32) -> void can[Abort.Panic, Memory.Allocate]:
    if value == 0:
        buffer.push(48)
        return
    digits: mutable darray[u8] = []
    remaining: mutable u32 = value
    for _step in 0..<12 |digits, remaining|:
        break if remaining == 0
        digits.push((48 + (remaining % 10)).u8())
        remaining <- remaining / 10
    for reverse_index in 0..<digits.count |buffer, digits|:
        buffer.push(digits[digits.count - 1.usize() - reverse_index])


def write_stderr(buffer: darray[u8]&) -> void can[Abort.Panic, Unsafe.PointerCast, Console]:
    can Console:
        return if buffer.count == 0
        # The cast is its own statement: an inline `expr.cast[T] can Effect` inside an argument
        # list reads as the end of the call.
        raw: void& = (&buffer[0]).cast[void&] can Unsafe.PointerCast
        _ = write(2, raw, buffer.count)


    # One diagnostic in stage0's shape minus the file/column span the stdin protocol does not
    # carry: `LINE: error: MESSAGE`. Wording comes from Semantic::diagnostic_message, the single
    # source of truth, so the CLI never re-derives per-kind text.
    #
    # Without this the driver rejected a program with a bare exit 1 and no explanation — the
    # accept/reject DECISION matched stage0 while the compiler was unusable for the thing a
    # diagnostic exists to do. Errors only: warnings do not block the build, and stage1's
    # semantic layer still over-reports them relative to stage0.
# Append the source path from ELISA_STAGE1_SRC, raw (no escaping — that is the JSON
# tokens report's concern). Nothing is appended when the variable is unset, which is how a
# pure-stdin caller that never named a file still gets a usable `LINE: message`.
def push_source_path(buffer: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag_storage: mutable darray[u8] = []
    for flag_index in 0..<sview_len("ELISA_STAGE1_SRC") |flag_storage|:
        flag_storage.push(sview_at("ELISA_STAGE1_SRC", flag_index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    wrote_any: mutable bool = false
    if getenv(flag_name) is path_bytes:
        cursor: mutable i64 = 0
        keep_scanning: mutable bool = true
        while keep_scanning |cursor, keep_scanning, buffer, wrote_any, path_bytes|:
            byte_ref: u8& = path_bytes + cursor
            path_byte: u8 = byte_ref
            if path_byte == 0:
                keep_scanning <- false
            else:
                buffer.push(path_byte)
                wrote_any <- true
                cursor <- cursor + 1
    return wrote_any


# A PARSE error, in stage0's position shape `PATH:LINE:COLUMN: message`.
#
# stage1 previously reported parse errors by exiting 1 with NO output at all — the one
# class of diagnostic every user hits first, and the compiler said nothing. Unlike a
# semantic Diagnostic, Ast::ParseError carries BOTH line and column, so the position here
# is exactly stage0's.
#
# The wording is deliberately close-but-not-identical to stage0's: stage0 names the
# offending TOKEN KIND ("unexpected token DEDENT in expression"), which needs a token-kind
# name table this driver does not have. The offending token's TEXT is printed instead,
# which is the actionable part. Position parity first; wording parity is a separate job.
def report_parse_error(failure: Ast::ParseError) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    line_buffer: mutable darray[u8] = []
    if push_source_path(&line_buffer):
        line_buffer.push(58)                              # ':'
    append_decimal(line_buffer, failure.line)
    line_buffer.push(58)                                  # ':'
    append_decimal(line_buffer, failure.column)
    line_buffer.push(58)                                  # ':'
    line_buffer.push(32)                                  # ' '
    text: sview = match failure.kind:
        Ast::ParseErrorKind.ExpectedToken: "expected a different token"
        Ast::ParseErrorKind.UnexpectedToken: "unexpected token"
        Ast::ParseErrorKind.ExpectedDeclaration: "expected a declaration"
        Ast::ParseErrorKind.ExpectedExpression: "expected an expression"
        Ast::ParseErrorKind.MismatchedWithBindings: "or-arm alternatives bind different constants"
        Ast::ParseErrorKind.SubmitOutsidePool: "submit outside a pool"
        _: "parse error"
    for text_index in 0..<sview_len(text) |line_buffer, text|:
        line_buffer.push(sview_at(text, text_index))
    if sview_len(failure.context) > 0:
        for prefix_index in 0..<sview_len(" near \"") |line_buffer|:
            line_buffer.push(sview_at(" near \"", prefix_index))
        for context_index in 0..<sview_len(failure.context) |line_buffer, failure|:
            line_buffer.push(sview_at(failure.context, context_index))
        line_buffer.push(34)                              # '"'
    line_buffer.push(10)
    write_stderr(line_buffer)


def report_diagnostic(diagnostic: Semantic::Diagnostic) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    line_buffer: mutable darray[u8] = []
    # stage0's shape is `PATH:LINE:COLSTART-COLEND: MESSAGE`. The path and line are here;
    # the COLUMN SPAN is not, because Semantic::Diagnostic carries only `line` — supplying
    # columns means threading spans through every diagnostic construction site, which is a
    # separate piece of work. Emitting `PATH:LINE:` is what editors and CI actually need to
    # jump to the fault, and it is strictly closer to stage0 than the previous bare LINE.
    if push_source_path(&line_buffer):
        line_buffer.push(58)                              # ':'
    append_decimal(line_buffer, diagnostic.line)
    line_buffer.push(58)                                  # ':'
    line_buffer.push(32)                                  # ' '
    message: darray[u8] = Semantic::diagnostic_message(diagnostic)
    line_buffer.extend(message)
    line_buffer.push(10)                                  # '\n'
    write_stderr(line_buffer)

# Does the SOURCE contain the standard library's own definition of `arena_alloc`? That is the
# marker for "this unit IS the trusted stdlib (or the compiler, which includes it)" — the same
# test scripts/elisac_stage1.sh applies to decide the flag, moved INTO the driver so every
# caller gets the same answer.
def source_defines_arena_alloc(source: u8&, length: usize) -> bool can[Abort.Panic]:
    marker: sview = "def arena_alloc("
    marker_length: usize = sview_len(marker)
    false return if length < marker_length
    limit: usize = length - marker_length
    start: mutable usize = 0
    while start <= limit |start|:
        matched: mutable bool = true
        offset: mutable usize = 0
        while offset < marker_length |offset, matched|:
            matched <- false if source[start + offset] != sview_at(marker, offset)
            break if not matched
            offset <- offset + 1.usize()
        true return if matched
        start <- start + 1.usize()
    return false


# Is this compilation unit the TRUSTED STANDARD LIBRARY (or the compiler, which
# includes it)? stage0 decides per FILE (isRuntimeStdPermissionInternal) and skips the
# passes that only apply to user code — the raw-concurrency surface removal and the
# region-tied-return check. stage1 cannot reproduce that granularity: include flattening
# concatenates without line directives, so a declaration's originating file is gone by the
# time the driver sees the source.
#
# So decide from the FLATTENED UNIT'S CONTENT, in the DRIVER. It used to be decided only by
# the wrapper and passed in through an env var, which meant every OTHER way of reaching the
# driver had to remember to set it: the moment the semantic gate became the default,
# self_host_gen3_smoke's stage B — which pipes the flattened compiler straight into gen2 —
# reported 24 region-tied-return errors and read as "bootstrap closure BROKE". The unit had
# not changed; only who was asking. A decision that belongs to the source belongs where the
# source is read.
#
# The env var still forces it on, for a caller that knows better than the marker.
#
# Coarser than stage0 (whole-unit rather than per-file) — it differs only for a program that
# includes the std AND redefines one of the removed names itself.
def runtime_std_enabled(source: u8&, length: usize) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    true return if source_defines_arena_alloc(source, length)
    flag_storage: mutable darray[u8] = []
    for index in 0..<sview_len("ELISA_STAGE1_RUNTIME_STD") |flag_storage|:
        flag_storage.push(sview_at("ELISA_STAGE1_RUNTIME_STD", index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is real:
        return true
    return false


# ON BY DEFAULT. A compiler that does not CHECK is not a compiler: without this the driver
# went parse -> emit and stage1 accepted programs stage0 rejects.
#
# It was opt-in while a stage1-COMPILED semantic layer computed differently from a
# stage0-compiled one. That is fixed. What it took, in the order the failures surfaced:
#   * `d <- d.put(k, v)` stored the helper's return value over the dict header;
#   * the deep packed pattern's probe ladder read the next level's handle without first
#     branching on the current level's tag;
#   * `for b in sview(literal, 0, -1)` compared the index UNSIGNED, so the std's
#     NUL-terminated sentinel read as 2^64-1;
#   * `scope` was an UNGUARDED contextual block keyword, so `scope.push(x)` parsed as a
#     `scope:` block — and Semantic.mark_mutable_locals' parameter is named `scope`, which
#     alone accounted for 319 E10 false positives on the compiler's own source;
#   * string literals reached LLVM with their escapes undecoded.
#
# gen2 now analyses the compiler's own 110k-line source with ZERO error-severity findings,
# exactly as the stage0-built driver does, and parse_report built by the two compilers agrees
# on 505 of 507 source files (the two are the same severity-2 warning, which does not gate).
#
# ELISA_STAGE1_NO_SEMANTIC_GATE=1 turns it off — an escape hatch for bisecting a suspected
# analyzer regression, not a supported mode.
def semantic_gate_enabled() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    # getenv needs a NUL-terminated string and an sview carries no terminator;
    # Backend::sview_to_cstr is private to that module, so terminate it here.
    flag_storage: mutable darray[u8] = []
    for index in 0..<sview_len("ELISA_STAGE1_NO_SEMANTIC_GATE") |flag_storage|:
        flag_storage.push(sview_at("ELISA_STAGE1_NO_SEMANTIC_GATE", index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is real:
        return false
    return true


# The requested optimisation level, from ELISA_STAGE1_OPT ("1"/"2"/"3"; absent or
# anything else = 0). Level 0 skips the pass manager entirely — emitting unoptimised
# objects stays the default, so the fixpoint and every existing measurement are unchanged
# unless a caller ASKS for optimisation.
def optimization_level() -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag_storage: mutable darray[u8] = []
    for index in 0..<sview_len("ELISA_STAGE1_OPT") |flag_storage|:
        flag_storage.push(sview_at("ELISA_STAGE1_OPT", index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is level_bytes:
        # Compare as C strings (ctx_streq content compare) rather than dereferencing
        # the env byte: a `u8&` binding read in a value context goes through an
        # auto-deref path this driver otherwise never exercises.
        level_c: cstr = (level_bytes).cast[cstr] can Unsafe.PointerCast
        1 return if level_c == "1"
        2 return if level_c == "2"
        3 return if level_c == "3"
    return 0


# ELISA_STAGE1_EMIT=llvm writes textual IR to the output path instead of an object —
# the same module, the same pipeline, just printed rather than lowered. Anything else
# (or absent) keeps the object path.
def emit_mode_is(wanted: sview) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag_storage: mutable darray[u8] = []
    for index in 0..<sview_len("ELISA_STAGE1_EMIT") |flag_storage|:
        flag_storage.push(sview_at("ELISA_STAGE1_EMIT", index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is mode_bytes:
        mode_c: cstr = (mode_bytes).cast[cstr] can Unsafe.PointerCast
        wanted_storage: mutable darray[u8] = []
        for wanted_index in 0..<sview_len(wanted) |wanted_storage, wanted|:
            wanted_storage.push(sview_at(wanted, wanted_index))
        wanted_storage.push(0)
        wanted_c: cstr = (&wanted_storage[0]).cast[cstr] can Unsafe.PointerCast
        return mode_c == wanted_c
    return false


def emit_llvm_requested() -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        return emit_mode_is("llvm")


    # ---- `-emit tokens` (ELISA_STAGE1_EMIT=tokens) ----------------------------------------
    #
    # stage0's lexer oracle, reproduced BYTE FOR BYTE on stdout: a JSON report of token count,
    # the canonical FNV-1a kind checksum (offset 1469598103934665603, prime 1099511628211,
    # count then each kind+1 — the single algorithm the cross-repo lexer parity test defines),
    # and per-token stage0 ordinals + names. `emit_tokens_kind_code` is the fixture-validated
    # stage1->stage0 kind mapping (test/fixtures/lexer/token_model_cases.elisa — the lexer
    # parity gate holds its checksum against the Go oracle); the name table is generated from
    # stage0's lexer/token.go tokenNames map. The wrapper redirects stdout to the -o path.

def emit_tokens_kind_code(kind: TokenKind) -> u64:
    match kind:
        TokenKind.Eof:
            return 1
        TokenKind.Newline:
            return 2
        TokenKind.Indent:
            return 3
        TokenKind.Dedent:
            return 4
        TokenKind.Ident:
            return 5
        TokenKind.IntLit:
            return 6
        TokenKind.FloatLit:
            return 7
        TokenKind.HexLit:
            return 8
        TokenKind.StringLit:
            return 9
        TokenKind.Def:
            return 10
        TokenKind.Error:
            return 11
        TokenKind.Enum:
            return 12
        TokenKind.Struct:
            return 13
        TokenKind.Const:
            return 14
        TokenKind.Global:
            return 15
        TokenKind.Extern:
            return 16
        TokenKind.Export:
            return 17
        TokenKind.If:
            return 18
        TokenKind.Match:
            return 19
        TokenKind.Elif:
            return 20
        TokenKind.Else:
            return 21
        TokenKind.While:
            return 22
        TokenKind.Break:
            return 23
        TokenKind.Continue:
            return 24
        TokenKind.Return:
            return 25
        TokenKind.Heap:
            return 26
        TokenKind.Stack:
            return 27
        # `Owned` is reserved in the stage1 enum but not currently emitted as a keyword
        # (stage0 has no TOKEN_OWNED). Keep a stable unused code so matches stay exhaustive
        # without shifting the stage0-aligned codes for Static/Mutable/…
        TokenKind.Owned:
            return 110
        TokenKind.Static:
            return 28
        TokenKind.Mutable:
            return 29
        TokenKind.Repr:
            return 31
        TokenKind.Packed:
            return 32
        TokenKind.Aligned:
            return 33
        TokenKind.Pass:
            return 34
        TokenKind.Panic:
            return 35
        TokenKind.Not:
            return 36
        TokenKind.And:
            return 37
        TokenKind.Or:
            return 38
        TokenKind.Null:
            return 39
        TokenKind.True:
            return 40
        TokenKind.False:
            return 41
        TokenKind.Zeroed:
            return 42
        TokenKind.Sizeof:
            return 43
        TokenKind.Alignof:
            return 44
        TokenKind.Offsetof:
            return 45
        TokenKind.Tail:
            return 46
        TokenKind.Try:
            return 47
        TokenKind.Catch:
            return 48
        TokenKind.Raise:
            return 49
        TokenKind.Region:
            return 50
        TokenKind.New:
            return 51
        TokenKind.As:
            return 52
        TokenKind.In:
            return 53
        TokenKind.With:
            return 54
        TokenKind.Colon:
            return 55
        TokenKind.Scope:
            return 56
        TokenKind.Arrow:
            return 57
        TokenKind.Dot:
            return 58
        TokenKind.Range:
            return 59
        TokenKind.RangeLt:
            return 60
        TokenKind.RangeGt:
            return 61
        # 110 (the report prints code - 1, so this is stage0's 109 = "..="). It read 109
        # here, which COLLIDED with Semicolon and printed `..=` as `;` — the token report
        # is byte-compared against stage0, and no fixture contained an INCLUSIVE range, so
        # the collision sat in the table unexercised.
        TokenKind.RangeLe:
            return 110
        TokenKind.Comma:
            return 62
        TokenKind.LParen:
            return 63
        TokenKind.RParen:
            return 64
        TokenKind.LBracket:
            return 65
        TokenKind.RBracket:
            return 66
        TokenKind.Hash:
            return 67
        TokenKind.Ampersand:
            return 68
        TokenKind.Question:
            return 69
        TokenKind.QAssign:
            return 70
        TokenKind.Bang:
            return 71
        TokenKind.At:
            return 72
        TokenKind.Ellipsis:
            return 73
        TokenKind.LArrow:
            return 74
        TokenKind.PlusEq:
            return 75
        TokenKind.MinusEq:
            return 76
        TokenKind.StarEq:
            return 77
        TokenKind.SlashEq:
            return 78
        TokenKind.PercentEq:
            return 79
        TokenKind.CaretEq:
            return 80
        TokenKind.PipeEq:
            return 81
        TokenKind.AmpEq:
            return 82
        TokenKind.LShiftEq:
            return 83
        TokenKind.RShiftEq:
            return 84
        TokenKind.Assign:
            return 85
        TokenKind.EqEq:
            return 86
        TokenKind.BangEq:
            return 87
        TokenKind.Lt:
            return 88
        TokenKind.Gt:
            return 89
        TokenKind.LtEq:
            return 90
        TokenKind.GtEq:
            return 91
        TokenKind.Plus:
            return 92
        TokenKind.Minus:
            return 93
        TokenKind.Star:
            return 94
        TokenKind.Slash:
            return 95
        TokenKind.Percent:
            return 96
        TokenKind.Pipe:
            return 97
        TokenKind.Caret:
            return 98
        TokenKind.LShift:
            return 99
        TokenKind.RShift:
            return 100
        TokenKind.Tilde:
            return 101
        TokenKind.CharLit:
            return 102
        TokenKind.Is:
            return 103
        TokenKind.FatArrow:
            return 104
        TokenKind.To:
            return 105
        TokenKind.LBrace:
            return 106
        TokenKind.RBrace:
            return 107
        TokenKind.PipeGt:
            return 108
        TokenKind.Semicolon:
            return 109
        # Comments never enter the main token stream, so this code is unreachable in a
        # report; it is distinct from FString's only so the two cannot be confused the way
        # RangeLe and Semicolon were.
        TokenKind.Comment:
            return 112
        TokenKind.FString:
            return 111
        TokenKind.Lmut:
            return 30
    return 0

def emit_tokens_kind_name(code: u64, storage: mutable darray[u8]&) -> sview can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate:
        "EOF" return if code == 0
        "NEWLINE" return if code == 1
        "INDENT" return if code == 2
        "DEDENT" return if code == 3
        "IDENT" return if code == 4
        "INT" return if code == 5
        "FLOAT" return if code == 6
        "HEX" return if code == 7
        "STRING" return if code == 8
        "def" return if code == 9
        "error" return if code == 10
        "enum" return if code == 11
        "struct" return if code == 12
        "const" return if code == 13
        "global" return if code == 14
        "extern" return if code == 15
        "export" return if code == 16
        "if" return if code == 17
        "match" return if code == 18
        "elif" return if code == 19
        "else" return if code == 20
        "while" return if code == 21
        "break" return if code == 22
        "continue" return if code == 23
        "return" return if code == 24
        "heap" return if code == 25
        "stack" return if code == 26
        "static" return if code == 27
        "mutable" return if code == 28
        "lmut" return if code == 29
        "repr" return if code == 30
        "packed" return if code == 31
        "pass" return if code == 33
        "panic" return if code == 34
        "not" return if code == 35
        "and" return if code == 36
        "or" return if code == 37
        "null" return if code == 38
        "true" return if code == 39
        "false" return if code == 40
        "zeroed" return if code == 41
        "sizeof" return if code == 42
        "alignof" return if code == 43
        "offsetof" return if code == 44
        "tail" return if code == 45
        "try" return if code == 46
        "catch" return if code == 47
        "raise" return if code == 48
        "region" return if code == 49
        "new" return if code == 50
        "as" return if code == 51
        "in" return if code == 52
        "with" return if code == 53
        ":" return if code == 54
        "::" return if code == 55
        "->" return if code == 56
        "." return if code == 57
        ".." return if code == 58
        "..<" return if code == 59
        "..>" return if code == 60
        "," return if code == 61
        "(" return if code == 62
        ")" return if code == 63
        "[" return if code == 64
        "]" return if code == 65
        "#" return if code == 66
        "&" return if code == 67
        "?" return if code == 68
        "?=" return if code == 69
        "!" return if code == 70
        "@" return if code == 71
        "..." return if code == 72
        "<-" return if code == 73
        "+=" return if code == 74
        "-=" return if code == 75
        "*=" return if code == 76
        "/=" return if code == 77
        "%=" return if code == 78
        "^=" return if code == 79
        "|=" return if code == 80
        "&=" return if code == 81
        "<<=" return if code == 82
        ">>=" return if code == 83
        "=" return if code == 84
        "==" return if code == 85
        "!=" return if code == 86
        "<" return if code == 87
        ">" return if code == 88
        "<=" return if code == 89
        ">=" return if code == 90
        "+" return if code == 91
        "-" return if code == 92
        "*" return if code == 93
        "/" return if code == 94
        "%" return if code == 95
        "|" return if code == 96
        "^" return if code == 97
        "<<" return if code == 98
        ">>" return if code == 99
        "~" return if code == 100
        "CHAR" return if code == 101
        "is" return if code == 102
        "=>" return if code == 103
        "to" return if code == 104
        "{" return if code == 105
        "}" return if code == 106
        "|>" return if code == 107
        ";" return if code == 108
        "..=" return if code == 109
        "FSTRING" return if code == 110
        # stage0's TokenName fallback: fmt.Sprintf("TokenKind(%d)", kind).
        storage.clear()
        for prefix_index in 0..<sview_len("TokenKind(") |storage|:
            storage.push(sview_at("TokenKind(", prefix_index))
        append_decimal(storage, code.i64())
        storage.push(41)
        return sview(&storage[0], 0, storage.count)


def emit_tokens_push_sview(buffer: mutable darray[u8]&, text: sview) -> void can[Abort.Panic, Memory.Allocate]:
    for push_index in 0..<sview_len(text) |buffer, text|:
        buffer.push(sview_at(text, push_index))


# A JSON STRING value's bytes, with Go's json.Encoder escaping: `<` `>` `&` become
# \u003c \u003e \u0026 (the encoder HTML-escapes by default), and `"`/`\` get a
# backslash. Operator token names ("->", "<=", "&") hit the HTML set constantly.
def emit_tokens_push_json_string(buffer: mutable darray[u8]&, text: sview) -> void can[Abort.Panic, Memory.Allocate]:
    for json_index in 0..<sview_len(text) |buffer, text|:
        json_byte: u8 = sview_at(text, json_index)
        if json_byte == 60:
            for esc_index in 0..<sview_len("\\u003c") |buffer|:
                buffer.push(sview_at("\\u003c", esc_index))
        elif json_byte == 62:
            for esc_index in 0..<sview_len("\\u003e") |buffer|:
                buffer.push(sview_at("\\u003e", esc_index))
        elif json_byte == 38:
            for esc_index in 0..<sview_len("\\u0026") |buffer|:
                buffer.push(sview_at("\\u0026", esc_index))
        else:
            buffer.push(92) if json_byte == 92 or json_byte == 34
            buffer.push(json_byte)


def emit_tokens_push_u64(buffer: mutable darray[u8]&, value: u64) -> void can[Abort.Panic, Memory.Allocate]:
    digits: mutable darray[u8] = []
    value_left: mutable u64 = value
    digits.push(48) if value_left == 0
    while value_left > 0 |value_left, digits|:
        digits.push((48 + (value_left % 10).i64()).u8())
        value_left <- value_left / 10
    digit_index: mutable i64 = digits.count.i64() - 1
    while digit_index >= 0 |digit_index, digits, buffer|:
        buffer.push(digits[digit_index.usize()])
        digit_index <- digit_index - 1


# The source path stage0 prints in the report, from ELISA_STAGE1_SRC (the wrapper knows
# the original path; the stdin protocol does not carry it). Escapes the two JSON-special
# bytes a path can contain.
def emit_tokens_push_source_name(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    flag_storage: mutable darray[u8] = []
    for flag_index in 0..<sview_len("ELISA_STAGE1_SRC") |flag_storage|:
        flag_storage.push(sview_at("ELISA_STAGE1_SRC", flag_index))
    flag_storage.push(0)
    flag_name: cstr = (&flag_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(flag_name) is path_bytes:
        cursor: mutable i64 = 0
        keep_scanning: mutable bool = true
        while keep_scanning |cursor, keep_scanning, buffer, path_bytes|:
            byte_ref: u8& = path_bytes + cursor
            path_byte: u8 = byte_ref
            if path_byte == 0:
                keep_scanning <- false
            else:
                buffer.push(92) if path_byte == 92 or path_byte == 34
                buffer.push(path_byte)
                cursor <- cursor + 1


# The OFFSET-MAP delta covering a flat-buffer byte offset, or -1 when the wrapper
# supplied no map. stage0 names a synthesized auto-region `__auto_<pos.Offset>` with the
# offset measured over its `#line`-directive-bearing include expansion; the wrapper's
# flattener records the divergence as ascending `flatoff:delta` pairs in
# ELISA_STAGE1_OFFSET_MAP, and the covering delta (last pair at or below the offset)
# added to a stage1 token offset recovers stage0's number.
def emit_fmt_offset_delta(offset: i64) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    map_storage: mutable darray[u8] = []
    for map_index in 0..<sview_len("ELISA_STAGE1_OFFSET_MAP") |map_storage|:
        map_storage.push(sview_at("ELISA_STAGE1_OFFSET_MAP", map_index))
    map_storage.push(0)
    map_name: cstr = (&map_storage[0]).cast[cstr] can Unsafe.PointerCast
    if getenv(map_name) is map_bytes:
        best_delta: mutable i64 = -1
        entry_offset: mutable i64 = 0
        entry_delta: mutable i64 = 0
        in_delta: mutable bool = false
        cursor: mutable i64 = 0
        scanning: mutable bool = true
        while scanning |best_delta, entry_offset, entry_delta, in_delta, cursor, scanning, map_bytes, offset|:
            byte_ref: u8& = map_bytes + cursor
            map_byte: u8 = byte_ref
            if map_byte == 0 or map_byte == 44:
                if in_delta and entry_offset <= offset:
                    best_delta <- entry_delta
                entry_offset <- 0
                entry_delta <- 0
                in_delta <- false
                scanning <- false if map_byte == 0
            elif map_byte == 58:
                in_delta <- true
            elif map_byte >= 48 and map_byte <= 57:
                if in_delta:
                    entry_delta <- entry_delta * 10 + (map_byte - 48).i64()
                else:
                    entry_offset <- entry_offset * 10 + (map_byte - 48).i64()
            cursor <- cursor + 1
        return best_delta
    return -1


def emit_tokens_report(tokens: darray[Lexer::Token]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    buffer: mutable darray[u8] = []
    emit_tokens_push_sview(buffer, "{\n  \"file\": \"")
    emit_tokens_push_source_name(buffer)
    emit_tokens_push_sview(buffer, "\",\n  \"count\": ")
    emit_tokens_push_u64(buffer, tokens.count.u64())
    checksum: mutable u64 = 1469598103934665603
    checksum <- (checksum ^ tokens.count.u64()) * 1099511628211
    for checksum_token in tokens |checksum|:
        checksum <- (checksum ^ emit_tokens_kind_code(checksum_token.kind)) * 1099511628211
    emit_tokens_push_sview(buffer, ",\n  \"checksum\": ")
    emit_tokens_push_u64(buffer, checksum)
    emit_tokens_push_sview(buffer, ",\n  \"kinds\": [")
    first_token: mutable bool = true
    name_storage: mutable darray[u8] = []
    for report_token in tokens |buffer, first_token, name_storage|:
        emit_tokens_push_sview(buffer, ",") if not first_token
        first_token <- false
        emit_tokens_push_sview(buffer, "\n    {\n      \"k\": ")
        emit_tokens_push_u64(buffer, emit_tokens_kind_code(report_token.kind) - 1)
        emit_tokens_push_sview(buffer, ",\n      \"n\": \"")
        token_name: sview = emit_tokens_kind_name(emit_tokens_kind_code(report_token.kind) - 1, name_storage)
        emit_tokens_push_json_string(buffer, token_name)
        emit_tokens_push_sview(buffer, "\"\n    }")
    emit_tokens_push_sview(buffer, "\n  ]\n}\n")
    return 0 if buffer.count == 0 else emit_tokens_flush(buffer)


def emit_tokens_flush(buffer: darray[u8]&) -> i64 can[Abort.Panic, Unsafe.PointerCast, Console]:
    can Console:
        raw: void& = (&buffer[0]).cast[void&] can Unsafe.PointerCast
        _ = write(1, raw, buffer.count)
        return 0


    # ---- `-emit ast` (ELISA_STAGE1_EMIT=ast) ----------------------------------------------
    #
    # stage0's parse-tree summary, reproduced line for line for the declaration kinds this
    # AST models: the `File: PATH (N declarations)` header, then one summary line per
    # declaration (`def NAME(N params) -> RET (M stmts)`, `struct NAME[T] (K fields)`,
    # `module NAME: (K decls)` with children indented, `type NAME = TARGET`, `using NAME`).
    # stage0 prints NO line for an enum declaration — it is counted in the header and
    # skipped — and this printer does the same.
    #
    # TYPE RENDERING IS TOKEN-SPAN BASED: stage0's typeStr prints the normalized source
    # spelling of a type, so rather than porting its two-hundred-line shape switch, the
    # return type / generic bracket / alias target are re-rendered from the declaration
    # line's TOKENS with stage0's spacing rules (", " after a comma, a space after the
    # heap/stack/static/mutable/tail storage keywords, nothing elsewhere). That covers every
    # type the language can spell with one rule set instead of one arm per shape.

def emit_ast_token_needs_space(kind: Lexer::TokenKind) -> bool can[Abort.Panic]:
    true return if kind == Lexer::TokenKind.Heap
    true return if kind == Lexer::TokenKind.Stack
    true return if kind == Lexer::TokenKind.Static
    true return if kind == Lexer::TokenKind.Mutable
    true return if kind == Lexer::TokenKind.Tail
    return false


# Render tokens [from, to) of the declaration line with stage0's type spacing.
def emit_ast_render_tokens(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, from_index: usize, to_index: usize) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate:
        for render_index in from_index..<to_index |buffer, tokens, source, from_index, to_index|:
            render_token: Lexer::Token = tokens[render_index]
            render_text: sview = Lexer::text_or_empty(render_token, source)
            # An error-UNION return renders as `V error[...]` — one space before `error`.
            buffer.push(32) if render_index > from_index and render_token.kind == Lexer::TokenKind.Error
            emit_tokens_push_sview(buffer, render_text)
            if render_token.kind == Lexer::TokenKind.Comma:
                buffer.push(32)
            elif render_token.kind == Lexer::TokenKind.Colon:
                # A value-generic's annotation (`[T, N: usize]`) keeps stage0's `: ` gap —
                # measured identically on the ast, iface, and fmt surfaces.
                buffer.push(32)
            elif emit_ast_token_needs_space(render_token.kind):
                buffer.push(32)
            elif render_token.kind == Lexer::TokenKind.Ident and render_text == "permission" and render_index + 1 < to_index and tokens[render_index + 1].kind == Lexer::TokenKind.Ident:
                # A permission generic parameter (`[A, R, permission P]`) — `permission` is an
                # ordinary identifier to the lexer, so its keyword gap is text-decided.
                buffer.push(32)


    # The token index range of declaration LINE's signature: first token on the line to the
    # depth-0 `:` (or the line's end). Brackets and parens nest; a `:` inside `[...]`/`(...)`
    # (a parameter annotation) does not close the signature.
def emit_ast_line_range(tokens: darray[Lexer::Token]&, line: u32) -> (found: bool, start: usize, stop: usize) can[Abort.Panic]:
    start_index: mutable usize = 0
    found_start: mutable bool = false
    for scan_index in 0..<tokens.count |start_index, found_start, tokens, line|:
        continue if found_start
        scan_token: Lexer::Token = tokens[scan_index]
        continue if scan_token.line != line
        continue if scan_token.kind == Lexer::TokenKind.Newline or scan_token.kind == Lexer::TokenKind.Indent or scan_token.kind == Lexer::TokenKind.Dedent
        start_index <- scan_index
        found_start <- true
    (false, 0, 0) return if not found_start
    stop_index: mutable usize = start_index
    depth: mutable i64 = 0
    scanning: mutable bool = true
    while scanning and stop_index < tokens.count |stop_index, depth, scanning, tokens, line|:
        stop_token: Lexer::Token = tokens[stop_index]
        if stop_token.line != line or stop_token.kind == Lexer::TokenKind.Newline:
            scanning <- false
        else:
            depth <- depth + 1 if stop_token.kind == Lexer::TokenKind.LParen or stop_token.kind == Lexer::TokenKind.LBracket
            depth <- depth - 1 if stop_token.kind == Lexer::TokenKind.RParen or stop_token.kind == Lexer::TokenKind.RBracket
            if depth == 0 and stop_token.kind == Lexer::TokenKind.Colon:
                scanning <- false
            else:
                stop_index <- stop_index + 1
    return (true, start_index, stop_index)


# ` -> RET` for the def at LINE, rendered from its signature tokens (empty when the def
# has no arrow). RET ends at the depth-0 `:` or a trailing `can` effects clause.
def emit_ast_return_segment(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        line_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
        return if not line_range.found
        arrow_index: mutable usize = 0
        arrow_found: mutable bool = false
        probe_depth: mutable i64 = 0
        for probe_index in line_range.start..<line_range.stop |arrow_index, arrow_found, probe_depth, tokens|:
            probe_token: Lexer::Token = tokens[probe_index]
            probe_depth <- probe_depth + 1 if probe_token.kind == Lexer::TokenKind.LParen or probe_token.kind == Lexer::TokenKind.LBracket
            probe_depth <- probe_depth - 1 if probe_token.kind == Lexer::TokenKind.RParen or probe_token.kind == Lexer::TokenKind.RBracket
            continue if arrow_found
            if probe_depth == 0 and probe_token.kind == Lexer::TokenKind.Arrow:
                arrow_index <- probe_index
                arrow_found <- true
        return if not arrow_found
        stop_at: mutable usize = line_range.stop
        for stop_probe in (arrow_index + 1)..<line_range.stop |stop_at, tokens, source, arrow_index|:
            continue if stop_at != 0 and stop_at < line_range.stop and stop_probe >= stop_at
            stop_probe_token: Lexer::Token = tokens[stop_probe]
            if stop_probe_token.kind == Lexer::TokenKind.Ident and Lexer::text_or_empty(stop_probe_token, source) == "can":
                stop_at <- stop_probe
        emit_tokens_push_sview(buffer, " -> ")
        emit_ast_render_tokens(buffer, tokens, source, arrow_index + 1, stop_at)


    # `[T, @owner]` after a struct/def NAME, when the declaration carries a generic bracket.
def emit_ast_generic_segment(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        line_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
        return if not line_range.found
        # The bracket right after the declaration NAME: token 0 is the keyword, token 1 the
        # name, so a generic bracket is token 2. A def's parameter list follows in parens.
        bracket_index: usize = line_range.start + 2
        return if bracket_index >= line_range.stop
        return if tokens[bracket_index].kind != Lexer::TokenKind.LBracket
        close_index: mutable usize = bracket_index
        close_depth: mutable i64 = 0
        closing: mutable bool = true
        while closing and close_index < line_range.stop |close_index, close_depth, closing, tokens|:
            close_token: Lexer::Token = tokens[close_index]
            close_depth <- close_depth + 1 if close_token.kind == Lexer::TokenKind.LBracket
            close_depth <- close_depth - 1 if close_token.kind == Lexer::TokenKind.RBracket
            if close_depth == 0:
                closing <- false
            else:
                close_index <- close_index + 1
        emit_ast_render_tokens(buffer, tokens, source, bracket_index, close_index + 1)


    # `type NAME = TARGET` — the target is everything after the depth-0 `=` on the line.
def emit_ast_alias_target(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        line_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
        return if not line_range.found
        equals_index: mutable usize = 0
        equals_found: mutable bool = false
        for eq_probe in line_range.start..<line_range.stop |equals_index, equals_found, tokens|:
            continue if equals_found
            if tokens[eq_probe].kind == Lexer::TokenKind.Assign:
                equals_index <- eq_probe
                equals_found <- true
        return if not equals_found
        emit_ast_render_tokens(buffer, tokens, source, equals_index + 1, line_range.stop)


    # Whether a type annotation names a CONTAINER (darray/dict/set/dstr head): the shapes
    # whose locals make stage0's region inference wrap the whole body in one `in auto:`
    # block — which is why its ast dump prints such a body as "(1 stmts)".
def emit_ast_expr_head_is_container(expression: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        if expression is Expr.Ident(head_name, head_line):
            return head_name == "darray" or head_name == "dict" or head_name == "set" or head_name == "dstr"
        if expression is Expr.Index(head_object, head_arg, head_index_line):
            return emit_ast_expr_head_is_container(head_object)
        if expression is Expr.IndexN(head_object_n, head_args_n, head_line_n):
            return emit_ast_expr_head_is_container(head_object_n)
        if expression is Expr.Paren(head_inner, head_paren_line):
            return emit_ast_expr_head_is_container(head_inner)
        if expression is Expr.Unary(head_operator, head_operand, head_unary_line):
            return emit_ast_expr_head_is_container(head_operand)
        return false


    # A local whose declared type is a named STRUCT holding a container FIELD wraps too.
    # Measured against stage0: `struct Grid: cells: array[i64, 4]` then `g: Grid = …` prints
    # "(1 stmts)" under stage0 while a struct of plain scalars, and a BARE `array[i64, 3]`
    # local, both print their real count. Looking only at the declared type HEAD missed the
    # whole family — the head is `Grid`, not a container name.
    #
    # `array` counts here even though a fixed array allocates nothing on its own: the rule is
    # stage0's, read off its output, not a claim about where the storage lives.
def emit_ast_struct_field_is_container(field_type: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        if field_type is Expr.Ident(field_head_name, field_head_line):
            return field_head_name == "darray" or field_head_name == "dict" or field_head_name == "set" or field_head_name == "dstr" or field_head_name == "array"
        if field_type is Expr.Index(field_object, field_arg, field_index_line):
            return emit_ast_struct_field_is_container(field_object)
        if field_type is Expr.IndexN(field_object_n, field_args_n, field_line_n):
            return emit_ast_struct_field_is_container(field_object_n)
        return false


def emit_ast_named_struct_holds_container(type_expression: Ast::Expr, struct_names: darray[sview]&, struct_member_rows: darray[Ast::StructMember]&, struct_member_starts: darray[usize]&, struct_member_counts: darray[usize]&) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        if type_expression is Expr.Ident(struct_type_name, struct_type_line):
            for struct_index in 0..<struct_names.count |struct_type_name, struct_names, struct_member_rows, struct_member_starts, struct_member_counts|:
                continue if struct_names[struct_index] != struct_type_name
                member_start: usize = struct_member_starts[struct_index]
                member_count: usize = struct_member_counts[struct_index]
                for member_offset in 0..<member_count |member_start, struct_member_rows|:
                    true return if emit_ast_struct_field_is_container(struct_member_rows[member_start + member_offset].type_expression)
            return false
        return false


    # A container local with an explicit `@region` annotation allocates from THAT region,
    # not the auto one, so it does not trigger the wrap (region_statement_form prints its
    # real statement count under stage0). The annotations are line+name keyed.
def emit_ast_local_has_region(annotations: darray[Ast::LocalRegionAnnotation]&, name: sview, line: u32) -> bool can[Abort.Panic, Memory.Allocate]:
    for region_row in annotations |name, line|:
        true return if region_row.name == name and region_row.line == line and region_row.region != ""
    return false


def emit_ast_body_declares_container(statements: darray[Ast::Stmt]&, annotations: darray[Ast::LocalRegionAnnotation]&, struct_names: darray[sview]&, struct_member_rows: darray[Ast::StructMember]&, struct_member_starts: darray[usize]&, struct_member_counts: darray[usize]&) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        for wrap_statement in statements |annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts|:
            if wrap_statement is Stmt.VarDecl(wrap_name, wrap_type, wrap_value, wrap_line):
                wrap_is_container: bool = emit_ast_expr_head_is_container(wrap_type) or emit_ast_named_struct_holds_container(wrap_type, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
                true return if wrap_is_container and not emit_ast_local_has_region(annotations, wrap_name, wrap_line)
            if wrap_statement is Stmt.If(wrap_cond, wrap_then, wrap_else, wrap_if_line):
                true return if emit_ast_body_declares_container(wrap_then, annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
                true return if emit_ast_body_declares_container(wrap_else, annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
            if wrap_statement is Stmt.While(wrap_wcond, wrap_wbody, wrap_while_line):
                true return if emit_ast_body_declares_container(wrap_wbody, annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
            if wrap_statement is Stmt.For(wrap_bind, wrap_vars, wrap_iter, wrap_fbody, wrap_for_line):
                true return if emit_ast_body_declares_container(wrap_fbody, annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
            if wrap_statement is Stmt.Block(wrap_kind, wrap_clause, wrap_binding, wrap_bbody, wrap_block_line):
                true return if emit_ast_body_declares_container(wrap_bbody, annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
        return false


    # A method call that can ALLOCATE into its receiver — the growth sites stage0's region
    # inference keys on.
def emit_ast_is_growth_method(name: sview) -> bool:
    return name == "push" or name == "put" or name == "extend" or name == "insert" or name == "reserve" or name == "resize" or name == "append"


# stage0's region inference is a BODY dataflow pass, not a signature-shape test: a
# reference parameter earns an inferred region only when the body actually GROWS it
# through an implicit allocation (`p.push(..)`, `p.f <- p.f.put(..)`). The std's
# `arena_*` helpers take a container ref of exactly the inferring SHAPE but allocate
# through an explicit arena — either by forwarding to an `arena_*` callee or inside an
# `in a:` block — so stage0 infers nothing for them. This approximates the pass with the
# two signals visible in the token stream: a growth call on the parameter's own chain,
# and the absence of a statement-leading `in` block (an explicit allocation target) in
# the same body.
def emit_ast_param_grown_in_body(tokens: darray[Lexer::Token]&, source: u8&, line: u32, name: sview) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic:
        header_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
        false return if not header_range.found
        body_depth: mutable i64 = 0
        body_entered: mutable bool = false
        body_done: mutable bool = false
        body_grown: mutable bool = false
        body_explicit: mutable bool = false
        for grow_probe in header_range.stop..<tokens.count |body_depth, body_entered, body_done, body_grown, body_explicit, tokens, source, name|:
            continue if body_done
            grow_kind: Lexer::TokenKind = tokens[grow_probe].kind
            if grow_kind == Lexer::TokenKind.Indent:
                body_depth <- body_depth + 1
                body_entered <- true
            elif grow_kind == Lexer::TokenKind.Dedent:
                body_depth <- body_depth - 1
                body_done <- true if body_entered and body_depth <= 0
            elif grow_kind == Lexer::TokenKind.In and grow_probe > 0:
                # `for x in xs` also spells `in`; only a STATEMENT-LEADING `in a:` names an
                # explicit allocation target.
                lead_kind: Lexer::TokenKind = tokens[grow_probe - 1].kind
                body_explicit <- true if lead_kind == Lexer::TokenKind.Indent or lead_kind == Lexer::TokenKind.Newline or lead_kind == Lexer::TokenKind.Dedent
            elif grow_kind == Lexer::TokenKind.Ident and Lexer::text_or_empty(tokens[grow_probe], source) == name:
                chain_index: mutable usize = grow_probe + 1
                chain_scanning: mutable bool = true
                while chain_scanning and chain_index + 2 < tokens.count |chain_index, chain_scanning, body_grown, tokens, source|:
                    if tokens[chain_index].kind != Lexer::TokenKind.Dot or tokens[chain_index + 1].kind != Lexer::TokenKind.Ident:
                        chain_scanning <- false
                    else:
                        chain_method: sview = Lexer::text_or_empty(tokens[chain_index + 1], source)
                        if tokens[chain_index + 2].kind == Lexer::TokenKind.LParen and emit_ast_is_growth_method(chain_method):
                            body_grown <- true
                            chain_scanning <- false
                        else:
                            chain_index <- chain_index + 2
        return body_grown and not body_explicit


    # stage0 prints the region params its inference ADDS: a def with no explicit generic
    # bracket whose parameter list contains a growable REFERENCE (`darray[..]&`, `dict&`)
    # renders as `def f[@__rg_<param>](...)`. Decided from the signature tokens: within the
    # parameter parens, a comma-separated segment that contains a container head AND a
    # trailing `&` contributes `@__rg_` + its first identifier (the parameter name) — gated
    # on that parameter actually being grown by the body.
def emit_ast_inferred_region_params(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        line_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
        return if not line_range.found
        # An explicit bracket right after the name wins; nothing is inferred.
        explicit_index: usize = line_range.start + 2
        return if explicit_index < line_range.stop and tokens[explicit_index].kind == Lexer::TokenKind.LBracket
        emitted_any: mutable bool = false
        paren_depth: mutable i64 = 0
        segment_has_container: mutable bool = false
        segment_has_amp: mutable bool = false
        segment_name: mutable sview = ""
        segment_named: mutable bool = false
        segment_darray: mutable bool = false
        for param_index in line_range.start..<line_range.stop |paren_depth, segment_has_container, segment_has_amp, segment_name, segment_named, segment_darray, emitted_any, buffer, tokens, source, line|:
            param_token: Lexer::Token = tokens[param_index]
            if param_token.kind == Lexer::TokenKind.LParen or param_token.kind == Lexer::TokenKind.LBracket:
                paren_depth <- paren_depth + 1
            elif param_token.kind == Lexer::TokenKind.RParen or param_token.kind == Lexer::TokenKind.RBracket:
                paren_depth <- paren_depth - 1
                if paren_depth == 0 and segment_has_container and segment_has_amp and segment_named and emit_ast_param_grown_in_body(tokens, source, line, segment_name):
                    emit_tokens_push_sview(buffer, "[" if not emitted_any else ", ")
                    emit_tokens_push_sview(buffer, "@__rg_")
                    emit_tokens_push_sview(buffer, segment_name)
                    emitted_any <- true
                if paren_depth == 0:
                    # PAST the parameter list: without this reset the RETURN type's own
                    # closing bracket re-emitted the last segment (`[@__rg_sb, @__rg_sb]`).
                    segment_has_container <- false
                    segment_has_amp <- false
                    segment_named <- false
                    segment_darray <- false
            elif paren_depth >= 1:
                if param_token.kind == Lexer::TokenKind.Comma and paren_depth == 1:
                    if segment_has_container and segment_has_amp and segment_named and emit_ast_param_grown_in_body(tokens, source, line, segment_name):
                        emit_tokens_push_sview(buffer, "[" if not emitted_any else ", ")
                        emit_tokens_push_sview(buffer, "@__rg_")
                        emit_tokens_push_sview(buffer, segment_name)
                        emitted_any <- true
                    segment_has_container <- false
                    segment_has_amp <- false
                    segment_named <- false
                    segment_darray <- false
                elif param_token.kind == Lexer::TokenKind.Comma and paren_depth >= 2 and segment_darray:
                    # A comma INSIDE a darray's bracket is an explicit shape argument
                    # (`darray[u8, shape_in]`) — the region is already named; stage0
                    # infers nothing for this parameter.
                    segment_has_container <- false
                elif param_token.kind == Lexer::TokenKind.Ident:
                    param_text: sview = Lexer::text_or_empty(param_token, source)
                    if not segment_named:
                        segment_name <- param_text
                        segment_named <- true
                    if param_text == "darray" or param_text == "dict" or param_text == "set" or param_text == "dstr":
                        segment_has_container <- true
                        segment_darray <- param_text == "darray"
                elif param_token.kind == Lexer::TokenKind.Ampersand:
                    segment_has_amp <- true
        emit_tokens_push_sview(buffer, "]") if emitted_any


    # The `(args)` of a decorator printed above declaration LINE: scan the closest line above
    # it that starts with `@`, and render its paren span verbatim.
def emit_ast_decorator_args(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        best_line: mutable u32 = 0
        for at_probe in 0..<tokens.count |best_line, tokens, line|:
            at_token: Lexer::Token = tokens[at_probe]
            continue if at_token.kind != Lexer::TokenKind.At
            best_line <- at_token.line if at_token.line < line and at_token.line > best_line
        return if best_line == 0
        at_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, best_line)
        return if not at_range.found
        open_index: mutable usize = at_range.start
        open_found: mutable bool = false
        for open_probe in at_range.start..<at_range.stop |open_index, open_found, tokens|:
            continue if open_found
            if tokens[open_probe].kind == Lexer::TokenKind.LParen:
                open_index <- open_probe
                open_found <- true
        return if not open_found
        emit_ast_render_tokens(buffer, tokens, source, open_index, at_range.stop)


def emit_ast_indent(buffer: mutable darray[u8]&, level: i64) -> void can[Abort.Panic, Memory.Allocate]:
    for indent_index in 0..<(level * 2) |buffer|:
        buffer.push(32)


def emit_ast_decl(buffer: mutable darray[u8]&, declaration: Ast::Decl, level: i64, tokens: darray[Lexer::Token]&, source: u8&, annotations: darray[Ast::LocalRegionAnnotation]&, struct_names: darray[sview]&, struct_member_rows: darray[Ast::StructMember]&, struct_member_starts: darray[usize]&, struct_member_counts: darray[usize]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        if declaration is Decl.Func(ast_fn_name, ast_fn_params, ast_fn_return, ast_fn_body, ast_fn_effects, ast_fn_decorators, ast_fn_line):
            emit_ast_indent(buffer, level)
            emit_tokens_push_sview(buffer, "def ")
            emit_tokens_push_sview(buffer, ast_fn_name)
            emit_ast_generic_segment(buffer, tokens, source, ast_fn_line)
            emit_ast_inferred_region_params(buffer, tokens, source, ast_fn_line)
            emit_tokens_push_sview(buffer, "(")
            emit_tokens_push_u64(buffer, ast_fn_params.count.u64())
            emit_tokens_push_sview(buffer, " params)")
            emit_ast_return_segment(buffer, tokens, source, ast_fn_line)
            emit_tokens_push_sview(buffer, " (")
            wrapped_count: u64 = 1 if emit_ast_body_declares_container(ast_fn_body, annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts) else ast_fn_body.count.u64()
            emit_tokens_push_u64(buffer, wrapped_count)
            emit_tokens_push_sview(buffer, " stmts)\n")
            return
        if declaration is Decl.Struct(ast_st_name, ast_st_members, ast_st_affinity, ast_st_states, ast_st_derive, ast_st_invariants, ast_st_line):
            emit_ast_indent(buffer, level)
            emit_tokens_push_sview(buffer, "affine ") if ast_st_affinity == "affine"
            emit_tokens_push_sview(buffer, "struct ")
            emit_tokens_push_sview(buffer, ast_st_name)
            emit_ast_generic_segment(buffer, tokens, source, ast_st_line)
            emit_tokens_push_sview(buffer, " (")
            emit_tokens_push_u64(buffer, ast_st_members.count.u64())
            emit_tokens_push_sview(buffer, " fields)\n")
            return
        # A CONST enum gets a line; a PLAIN enum gets none. Measured against stage0 on a file
        # holding both: it prints `const enum FD of int: (2 members)` for the const one and
        # NOTHING for `enum Plain`, though both count toward the "(N declarations)" header. The
        # storage head comes from the declaration line's tokens — the node keeps the name, not
        # the source spelling.
        if declaration is Decl.Enum(ast_en_name, ast_en_variants, ast_en_const, ast_en_storage, ast_en_line):
            return if not ast_en_const
            emit_ast_indent(buffer, level)
            emit_tokens_push_sview(buffer, "const enum ")
            emit_tokens_push_sview(buffer, ast_en_name)
            emit_tokens_push_sview(buffer, " of ")
            # `storage_type` is an Expr, not a name — a const enum's head is always a scalar
            # type name, so the Ident is the spelling stage0 prints.
            if ast_en_storage is Expr.Ident(ast_en_storage_name, ast_en_storage_line):
                emit_tokens_push_sview(buffer, ast_en_storage_name)
            emit_tokens_push_sview(buffer, ": (")
            emit_tokens_push_u64(buffer, ast_en_variants.count.u64())
            emit_tokens_push_sview(buffer, " members)\n")
            return
        if declaration is Decl.Alias(ast_al_name, ast_al_target, ast_al_line):
            emit_ast_indent(buffer, level)
            emit_tokens_push_sview(buffer, "type ")
            emit_tokens_push_sview(buffer, ast_al_name)
            emit_tokens_push_sview(buffer, " = ")
            emit_ast_alias_target(buffer, tokens, source, ast_al_line)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Import(ast_im_module, ast_im_line):
            emit_ast_indent(buffer, level)
            emit_tokens_push_sview(buffer, "using ")
            emit_tokens_push_sview(buffer, ast_im_module)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Module(ast_mod_name, ast_mod_body, ast_mod_line):
            emit_ast_indent(buffer, level)
            emit_tokens_push_sview(buffer, "module ")
            # stage0 renders a nested module path with DOTS (`module Outer.Inner:`).
            for mod_name_index in 0..<sview_len(ast_mod_name) |buffer, ast_mod_name|:
                mod_byte: u8 = sview_at(ast_mod_name, mod_name_index)
                if mod_byte == 58:
                    buffer.push(46) if mod_name_index + 1 < sview_len(ast_mod_name) and sview_at(ast_mod_name, mod_name_index + 1) != 58 or mod_name_index > 0 and sview_at(ast_mod_name, mod_name_index - 1) == 58
                else:
                    buffer.push(mod_byte)
            emit_tokens_push_sview(buffer, ": (")
            emit_tokens_push_u64(buffer, ast_mod_body.count.u64())
            emit_tokens_push_sview(buffer, " decls)\n")
            for ast_mod_child in ast_mod_body |buffer, level, tokens, source|:
                emit_ast_decl(buffer, ast_mod_child, level + 1, tokens, source, annotations, struct_names, struct_member_rows, struct_member_starts, struct_member_counts)
            return
        if declaration is Decl.Const(ast_c_name, ast_c_type, ast_c_value, ast_c_mutable, ast_c_line):
            # `const NAME = VALUE` / `global [mutable ]NAME: TYPE` — the whole source line in
            # normalized spelling (the gap renderer reproduces stage0's typeStr/exprStr on
            # canonical source), including the annotation past the clipped colon.
            const_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, ast_c_line)
            return if not const_range.found
            const_stop: mutable usize = const_range.stop
            while const_stop < tokens.count and tokens[const_stop].line == ast_c_line and tokens[const_stop].kind != Lexer::TokenKind.Newline |const_stop, tokens, ast_c_line|:
                const_stop <- const_stop + 1
            # stage0 renders these STRUCTURALLY rather than echoing the source line, and the two
            # keywords drop OPPOSITE halves — MEASURED:
            #     const J: i64 = 3        ->  const J = 3            (annotation dropped)
            #     global mutable g: i64 = 7  ->  global mutable g: i64  (initializer dropped)
            # Echoing the line matched only the unannotated `const K = 5`, which is why every
            # existing fixture agreed; a `global` with an initializer is what exposed it.
            const_eq: mutable usize = const_stop
            const_eq_found: mutable bool = false
            for eq_probe in const_range.start..<const_stop |const_eq, const_eq_found, tokens|:
                continue if const_eq_found
                if tokens[eq_probe].kind == Lexer::TokenKind.Assign:
                    const_eq <- eq_probe
                    const_eq_found <- true
            emit_ast_indent(buffer, level)
            if tokens[const_range.start].kind == Lexer::TokenKind.Global:
                emit_iface_render_tokens(buffer, tokens, source, const_range.start, const_eq)
                emit_tokens_push_sview(buffer, "\n")
                return
            emit_tokens_push_sview(buffer, "const ")
            emit_tokens_push_sview(buffer, ast_c_name)
            if const_eq_found:
                emit_tokens_push_sview(buffer, " = ")
                emit_iface_render_tokens(buffer, tokens, source, const_eq + 1, const_stop)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Extern(ast_ex_name, ast_ex_param_start, ast_ex_arity, ast_ex_variadic, ast_ex_callable, ast_ex_return, ast_ex_decorators, ast_ex_line):
            # `@link_name(sym)` prints on its own line first, exactly as written.
            for ast_ex_decorator in ast_ex_decorators |buffer, level, tokens, source, ast_ex_line|:
                emit_ast_indent(buffer, level)
                emit_tokens_push_sview(buffer, "@")
                emit_tokens_push_sview(buffer, ast_ex_decorator.name)
                emit_ast_decorator_args(buffer, tokens, source, ast_ex_line)
                emit_tokens_push_sview(buffer, "\n")
            emit_ast_indent(buffer, level)
            if not ast_ex_callable:
                # A bare `extern TypeName` is an opaque TYPE declaration.
                emit_tokens_push_sview(buffer, "extern type ")
                emit_tokens_push_sview(buffer, ast_ex_name)
                emit_tokens_push_sview(buffer, "\n")
                return
            emit_tokens_push_sview(buffer, "extern ")
            emit_tokens_push_sview(buffer, ast_ex_name)
            emit_tokens_push_sview(buffer, "(")
            emit_tokens_push_u64(buffer, ast_ex_arity.u64())
            emit_tokens_push_sview(buffer, " params)")
            emit_ast_return_segment(buffer, tokens, source, ast_ex_line)
            emit_tokens_push_sview(buffer, "\n")
            return
        # Enum: stage0's printer has no EnumDecl case — counted in the header, no line.
        # Law/Scoped/Invalid likewise print nothing at this summary level.
        return


def emit_ast_report(file: Ast::File&, tokens: darray[Lexer::Token]&, source: u8&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    buffer: mutable darray[u8] = []
    # `using X as Y` lives only in the annotation side tables (__using_alias_target rows
    # carry the TARGET module, which is what stage0 prints); it is a real declaration in
    # stage0's stream, so it joins the count and prints in line order among the decls.
    alias_targets: mutable darray[sview] = []
    alias_lines: mutable darray[u32] = []
    for using_annotation in file.enum_annotations |alias_targets, alias_lines, file|:
        if using_annotation.name == "__using_alias_target":
            alias_targets.push(using_annotation.owner)
            alias_lines.push(using_annotation.line)
        elif using_annotation.name == "__using":
            # An ALIASED using records both rows on nearby lines; only the bare form
            # contributes its own declaration. Skip a __using whose module already has an
            # alias-target row.
            using_is_aliased: mutable bool = false
            for alias_probe in file.enum_annotations |using_is_aliased, using_annotation|:
                using_is_aliased <- true if alias_probe.name == "__using_alias_target" and alias_probe.owner == using_annotation.owner
            if not using_is_aliased:
                alias_targets.push(using_annotation.owner)
                alias_lines.push(using_annotation.line)
    emit_tokens_push_sview(buffer, "File: ")
    emit_tokens_push_source_name(buffer)
    emit_tokens_push_sview(buffer, " (")
    emit_tokens_push_u64(buffer, (file.top_decls.count + alias_targets.count).u64())
    emit_tokens_push_sview(buffer, " declarations)\n")
    for ast_declaration in file.top_decls |buffer, tokens, source, alias_targets, alias_lines|:
        decl_line: u32 = ast_decl_line(ast_declaration)
        for alias_index in 0..<alias_targets.count |buffer, alias_targets, alias_lines, decl_line|:
            if alias_lines[alias_index] != 0 and alias_lines[alias_index] < decl_line:
                emit_tokens_push_sview(buffer, "using ")
                emit_tokens_push_sview(buffer, alias_targets[alias_index])
                emit_tokens_push_sview(buffer, "\n")
                alias_lines[alias_index] <- 0
        emit_ast_decl(buffer, ast_declaration, 0, tokens, source, file.local_region_annotations, file.struct_names, file.struct_member_rows, file.struct_member_starts, file.struct_member_counts)
    for alias_tail in 0..<alias_targets.count |buffer, alias_targets, alias_lines|:
        if alias_lines[alias_tail] != 0:
            emit_tokens_push_sview(buffer, "using ")
            emit_tokens_push_sview(buffer, alias_targets[alias_tail])
            emit_tokens_push_sview(buffer, "\n")
    return 0 if buffer.count == 0 else emit_tokens_flush(buffer)


# Does this unit declare any FUNCTION at all (directly, or inside a module / a `static if`
# branch)? A declaration-only unit — an enum, a const enum, a struct — has nothing for the
# backend to emit, and stage0 writes an (empty) object for it rather than failing. Without
# this, `emitted_count <= 0` read every such file as a codegen failure: MEASURED on 6 of the
# diagnostics fixtures (const_enum_value.neg, duplicate_variant_field.neg, …), which stage0
# accepts and stage1 exited 2 on. The guard stays for a unit that HAS a function and emitted
# none — that is the real failure, and what backend_native_smoke's decline cases assert.
def unit_declares_function(declarations: darray[Ast::Decl]) -> bool can[Abort.Panic, Memory.Allocate]:
    can Abort.Panic, Memory.Allocate:
        for declaration in declarations:
            if declaration is Decl.Func(udf_fn_name, udf_fn_params, udf_fn_ret, udf_fn_body, udf_fn_effects, udf_fn_decorators, udf_fn_line):
                return true
            if declaration is Decl.Module(udf_mod_name, udf_mod_body, udf_mod_line):
                true return if unit_declares_function(udf_mod_body)
            if declaration is Decl.Scoped(udf_sc_body, udf_sc_line):
                true return if unit_declares_function(udf_sc_body)
        return false


def ast_decl_line(declaration: Ast::Decl) -> u32 can[Abort.Panic, Memory.Allocate]:
    if declaration is Decl.Func(line_fn_name, line_fn_params, line_fn_ret, line_fn_body, line_fn_effects, line_fn_decorators, line_fn_line):
        return line_fn_line
    if declaration is Decl.Struct(line_st_name, line_st_members, line_st_aff, line_st_states, line_st_derive, line_st_inv, line_st_line):
        return line_st_line
    if declaration is Decl.Enum(line_en_name, line_en_variants, line_en_const, line_en_storage, line_en_line):
        return line_en_line
    if declaration is Decl.Alias(line_al_name, line_al_target, line_al_line):
        return line_al_line
    if declaration is Decl.Import(line_im_module, line_im_line):
        return line_im_line
    if declaration is Decl.Module(line_mod_name, line_mod_body, line_mod_line):
        return line_mod_line
    if declaration is Decl.Const(line_c_name, line_c_type, line_c_value, line_c_mut, line_c_line):
        return line_c_line
    if declaration is Decl.Extern(line_ex_name, line_ex_ps, line_ex_ar, line_ex_va, line_ex_call, line_ex_ret, line_ex_dec, line_ex_line):
        return line_ex_line
    return 4294967295


# ---- `-emit iface` (ELISA_STAGE1_EMIT=iface) ------------------------------------------
#
# stage0's public-interface summary: each declaration re-rendered in normalized source
# spelling — a def becomes an `extern` SIGNATURE (with stage0's inferred `@__rg_<param>`
# region woven into a growable ref param's type), a `global` becomes `extern NAME: T`,
# enum/error/struct declarations keep their indented bodies, and declarations are
# separated by single blank lines in source order. Everything renders from the
# declaration's line tokens (iface spacing: ": " after a colon, ", " after a comma,
# " -> " around an arrow) plus the same side-table merges the ast printer uses.

# SOURCE-GAP spacing: a single space wherever the source had whitespace between two
# tokens, nothing where it had none. On canonically formatted source this IS stage0's
# normalized spelling — commas read ", ", colons ": ", arrows " -> " — with no rule
# table to drift.
def emit_iface_render_tokens(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, from_index: usize, to_index: usize) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate:
        previous_end: mutable u32 = 0
        have_previous: mutable bool = false
        previous_forces_space: mutable bool = false
        previous_was_open: mutable bool = false
        for iface_index in from_index..<to_index |buffer, tokens, source, previous_end, have_previous, previous_forces_space, previous_was_open|:
            iface_token: Lexer::Token = tokens[iface_index]
            continue if iface_token.kind == Lexer::TokenKind.Newline or iface_token.kind == Lexer::TokenKind.Indent or iface_token.kind == Lexer::TokenKind.Dedent
            iface_text: sview = Lexer::text_or_empty(iface_token, source)
            # A colon or comma NORMALIZES to ": "/", " even when the source omitted the gap
            # (`begin:mutable` prints `begin: mutable`) — idempotent on canonical spelling.
            # No space directly inside brackets or before a separator — a line break's
            # whitespace collapsing into `( x` / `x )` would otherwise leak through.
            suppress_space: bool = previous_was_open or iface_token.kind == Lexer::TokenKind.RParen or iface_token.kind == Lexer::TokenKind.RBracket or iface_token.kind == Lexer::TokenKind.Comma
            buffer.push(32) if have_previous and not suppress_space and (iface_token.start > previous_end or previous_forces_space)
            emit_tokens_push_sview(buffer, iface_text)
            previous_end <- iface_token.start + iface_token.length
            have_previous <- true
            previous_forces_space <- iface_token.kind == Lexer::TokenKind.Colon or iface_token.kind == Lexer::TokenKind.Comma
            previous_was_open <- iface_token.kind == Lexer::TokenKind.LParen or iface_token.kind == Lexer::TokenKind.LBracket


    # The BODY token range of a block declaration whose header ends at header_stop: from the
    # Indent after the header's newline to the matching Dedent.
def emit_iface_body_range(tokens: darray[Lexer::Token]&, header_stop: usize) -> (found: bool, start: usize, stop: usize) can[Abort.Panic]:
    probe: mutable usize = header_stop
    depth: mutable i64 = 0
    start_index: mutable usize = 0
    started: mutable bool = false
    finished: mutable bool = false
    stop_index: mutable usize = header_stop
    while not finished and probe < tokens.count |probe, depth, start_index, started, finished, stop_index, tokens|:
        body_token: Lexer::Token = tokens[probe]
        if body_token.kind == Lexer::TokenKind.Indent:
            depth <- depth + 1
            if not started:
                start_index <- probe + 1
                started <- true
        elif body_token.kind == Lexer::TokenKind.Dedent:
            depth <- depth - 1
            if started and depth == 0:
                stop_index <- probe
                finished <- true
        elif started == false and body_token.kind != Lexer::TokenKind.Newline:
            # Content before any Indent: a single-line declaration, no body.
            finished <- true
        probe <- probe + 1
    (false, 0, 0) return if not started
    return (true, start_index, stop_index)


# Body lines at `indent` spaces: each Newline-separated token group renders on its own line.
def emit_iface_body_lines(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, start_index: usize, stop_index: usize, indent: i64) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        line_start: mutable usize = start_index
        cursor: mutable usize = start_index
        while cursor <= stop_index |line_start, cursor, buffer, tokens, source, indent, stop_index|:
            at_break: bool = cursor == stop_index or tokens[cursor].kind == Lexer::TokenKind.Newline
            if at_break:
                has_content: mutable bool = false
                for content_probe in line_start..<cursor |has_content, tokens|:
                    content_kind: Lexer::TokenKind = tokens[content_probe].kind
                    has_content <- true if content_kind != Lexer::TokenKind.Newline and content_kind != Lexer::TokenKind.Indent and content_kind != Lexer::TokenKind.Dedent
                if has_content:
                    for indent_space in 0..<indent |buffer|:
                        buffer.push(32)
                    emit_iface_render_tokens(buffer, tokens, source, line_start, cursor)
                    emit_tokens_push_sview(buffer, "\n")
                line_start <- cursor + 1
            cursor <- cursor + 1


    # One def rendered as its `extern` SIGNATURE. Generics render verbatim when explicit;
    # otherwise stage0's inferred region params both prefix the signature (`[@__rg_xs]`) and
    # weave into the growable ref parameter's own type (`... darray[i64] @__rg_xs&`).
def emit_iface_func(buffer: mutable darray[u8]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, indent: i64) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        emit_signature_line(buffer, "extern ", name, line, tokens, source, indent, false)


    # The shared def/extern signature renderer: KEYWORD + name + explicit-or-inferred
    # generics + woven params + return; `fmt` prints it as `def NAME(...)...:` while the
    # interface prints `extern NAME(...)...`.
    # `trailing_colon` doubles as the SURFACE selector: fmt (true) prints the signature's
    # `can[...]` effects clause as stage0's unparser does; the iface surface (false) drops it.
def emit_signature_line(buffer: mutable darray[u8]&, keyword: sview, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, indent: i64, trailing_colon: bool) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        line_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
        return if not line_range.found
        for indent_space in 0..<indent |buffer|:
            buffer.push(32)
        emit_tokens_push_sview(buffer, keyword)
        emit_tokens_push_sview(buffer, name)
        emit_ast_generic_segment(buffer, tokens, source, line)
        emit_ast_inferred_region_params(buffer, tokens, source, line)
        # Parameter span: the first depth-0 LParen after the name to its matching RParen.
        open_index: mutable usize = 0
        open_found: mutable bool = false
        bracket_depth: mutable i64 = 0
        for open_probe in line_range.start..<line_range.stop |open_index, open_found, bracket_depth, tokens|:
            open_kind: Lexer::TokenKind = tokens[open_probe].kind
            if open_kind == Lexer::TokenKind.LBracket:
                bracket_depth <- bracket_depth + 1
            elif open_kind == Lexer::TokenKind.RBracket:
                bracket_depth <- bracket_depth - 1
            elif open_kind == Lexer::TokenKind.LParen and bracket_depth == 0 and not open_found:
                open_index <- open_probe
                open_found <- true
        return if not open_found
        close_index: mutable usize = open_index
        close_depth: mutable i64 = 0
        closing: mutable bool = true
        while closing and close_index < line_range.stop |close_index, close_depth, closing, tokens|:
            close_kind: Lexer::TokenKind = tokens[close_index].kind
            close_depth <- close_depth + 1 if close_kind == Lexer::TokenKind.LParen
            close_depth <- close_depth - 1 if close_kind == Lexer::TokenKind.RParen
            if close_depth == 0:
                closing <- false
            else:
                close_index <- close_index + 1
        explicit_generics: bool = line_range.start + 2 < line_range.stop and tokens[line_range.start + 2].kind == Lexer::TokenKind.LBracket
        emit_tokens_push_sview(buffer, "(")
        emit_iface_params(buffer, tokens, source, open_index + 1, close_index, explicit_generics)
        emit_tokens_push_sview(buffer, ")")
        # Return segment with iface spacing: from a depth-0 Arrow after the params to the
        # trailing colon or a `can` effects clause.
        arrow_index: mutable usize = 0
        arrow_found: mutable bool = false
        for arrow_probe in close_index..<line_range.stop |arrow_index, arrow_found, tokens|:
            continue if arrow_found
            if tokens[arrow_probe].kind == Lexer::TokenKind.Arrow:
                arrow_index <- arrow_probe
                arrow_found <- true
        if not arrow_found:
            if trailing_colon:
                emit_signature_can_clause(buffer, tokens, source, close_index, line_range.stop)
                emit_tokens_push_sview(buffer, ":")
            return
        ret_stop: mutable usize = line_range.stop
        for ret_probe in (arrow_index + 1)..<line_range.stop |ret_stop, tokens, source|:
            ret_token: Lexer::Token = tokens[ret_probe]
            if ret_token.kind == Lexer::TokenKind.Ident and Lexer::text_or_empty(ret_token, source) == "can":
                ret_stop <- ret_probe if ret_probe < ret_stop
        emit_tokens_push_sview(buffer, " -> ")
        emit_iface_render_tokens(buffer, tokens, source, arrow_index + 1, ret_stop)
        if trailing_colon:
            emit_signature_can_clause(buffer, tokens, source, ret_stop, line_range.stop)
        emit_tokens_push_sview(buffer, ":") if trailing_colon


    # A signature's trailing effects clause (`can[E1, E2]`), rendered ` can[E1, E2]` when the
    # span holds one. Only the BRACKETED form is a signature clause; a depth-0 bare `can`
    # followed by anything else is not expected on a def line.
def emit_signature_can_clause(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, from_index: usize, to_index: usize) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        can_index: mutable usize = 0
        can_found: mutable bool = false
        for can_probe in from_index..<to_index |can_index, can_found, tokens, source|:
            continue if can_found
            can_token: Lexer::Token = tokens[can_probe]
            if can_token.kind == Lexer::TokenKind.Ident and Lexer::text_or_empty(can_token, source) == "can":
                can_index <- can_probe
                can_found <- true
        return if not can_found
        return if can_index + 1 >= to_index or tokens[can_index + 1].kind != Lexer::TokenKind.LBracket
        emit_tokens_push_sview(buffer, " ")
        emit_iface_render_tokens(buffer, tokens, source, can_index, to_index)


    # The parameter list, with stage0's inferred region woven in: a segment that holds a
    # container head and a trailing `&` (and no explicit generic bracket on the line) gets
    # ` @__rg_<param>` inserted before that `&`.
def emit_iface_params(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, from_index: usize, to_index: usize, explicit_generics: bool) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        segment_start: mutable usize = from_index
        cursor: mutable usize = from_index
        depth: mutable i64 = 0
        first_segment: mutable bool = true
        while cursor <= to_index |segment_start, cursor, depth, first_segment, buffer, tokens, source, to_index, explicit_generics|:
            seg_break: bool = cursor == to_index or (depth == 0 and tokens[cursor].kind == Lexer::TokenKind.Comma)
            if cursor < to_index:
                seg_kind: Lexer::TokenKind = tokens[cursor].kind
                depth <- depth + 1 if seg_kind == Lexer::TokenKind.LParen or seg_kind == Lexer::TokenKind.LBracket
                depth <- depth - 1 if seg_kind == Lexer::TokenKind.RParen or seg_kind == Lexer::TokenKind.RBracket
            if seg_break:
                if cursor > segment_start:
                    emit_tokens_push_sview(buffer, ", ") if not first_segment
                    first_segment <- false
                    emit_iface_param_segment(buffer, tokens, source, segment_start, cursor, explicit_generics)
                segment_start <- cursor + 1
            cursor <- cursor + 1


def emit_iface_param_segment(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, from_index: usize, to_index: usize, explicit_generics: bool) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        has_container: mutable bool = false
        amp_index: mutable usize = 0
        amp_found: mutable bool = false
        param_name: mutable sview = ""
        param_named: mutable bool = false
        for seg_probe in from_index..<to_index |has_container, amp_index, amp_found, param_name, param_named, tokens, source|:
            seg_token: Lexer::Token = tokens[seg_probe]
            if seg_token.kind == Lexer::TokenKind.Ident:
                seg_text: sview = Lexer::text_or_empty(seg_token, source)
                if not param_named:
                    param_name <- seg_text
                    param_named <- true
                has_container <- true if seg_text == "darray" or seg_text == "dict" or seg_text == "set" or seg_text == "dstr"
            elif seg_token.kind == Lexer::TokenKind.Ampersand:
                amp_index <- seg_probe
                amp_found <- true
        # Same body-growth gate as the signature-prefix weaver: the shape alone over-fires on
        # the std's explicit-arena helpers.
        weave: bool = has_container and amp_found and param_named and not explicit_generics and emit_ast_param_grown_in_body(tokens, source, tokens[from_index].line, param_name)
        if weave:
            emit_iface_render_tokens(buffer, tokens, source, from_index, amp_index)
            emit_tokens_push_sview(buffer, " @__rg_")
            emit_tokens_push_sview(buffer, param_name)
            emit_iface_render_tokens(buffer, tokens, source, amp_index, to_index)
        else:
            emit_iface_render_tokens(buffer, tokens, source, from_index, to_index)


def emit_iface_decl(buffer: mutable darray[u8]&, declaration: Ast::Decl, level: i64, tokens: darray[Lexer::Token]&, source: u8&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        indent: i64 = level * 4
        if declaration is Decl.Func(if_fn_name, if_fn_params, if_fn_ret, if_fn_body, if_fn_effects, if_fn_decorators, if_fn_line):
            emit_iface_func(buffer, if_fn_name, if_fn_line, tokens, source, indent)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Struct(if_st_name, if_st_members, if_st_aff, if_st_states, if_st_derive, if_st_inv, if_st_line):
            emit_iface_block_decl(buffer, tokens, source, if_st_line, indent)
            return
        if declaration is Decl.Enum(if_en_name, if_en_variants, if_en_const, if_en_storage, if_en_line):
            emit_iface_block_decl(buffer, tokens, source, if_en_line, indent)
            return
        if declaration is Decl.Const(if_c_name, if_c_type, if_c_value, if_c_mutable, if_c_line):
            for const_space in 0..<indent |buffer|:
                buffer.push(32)
            const_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, if_c_line)
            return if not const_range.found
            if if_c_mutable:
                # `global [mutable] NAME: T` presents as `extern NAME: T`.
                emit_tokens_push_sview(buffer, "extern ")
                emit_tokens_push_sview(buffer, if_c_name)
                # emit_ast_line_range CLIPS at the depth-0 colon, so the annotation lives
                # just past const_range.stop: scan from there to the physical line end.
                type_stop: mutable usize = const_range.stop + 1
                while type_stop < tokens.count and tokens[type_stop].line == if_c_line and tokens[type_stop].kind != Lexer::TokenKind.Newline and tokens[type_stop].kind != Lexer::TokenKind.Assign |type_stop, tokens, if_c_line|:
                    type_stop <- type_stop + 1
                return if const_range.stop >= tokens.count or tokens[const_range.stop].kind != Lexer::TokenKind.Colon
                emit_tokens_push_sview(buffer, ": ")
                emit_iface_render_tokens(buffer, tokens, source, const_range.stop + 1, type_stop)
                emit_tokens_push_sview(buffer, "\n")
                return
            emit_tokens_push_sview(buffer, "const ")
            emit_tokens_push_sview(buffer, if_c_name)
            emit_tokens_push_sview(buffer, " = ")
            eq_index: mutable usize = 0
            eq_found: mutable bool = false
            for eq_probe in const_range.start..<const_range.stop |eq_index, eq_found, tokens|:
                continue if eq_found
                if tokens[eq_probe].kind == Lexer::TokenKind.Assign:
                    eq_index <- eq_probe
                    eq_found <- true
            return if not eq_found
            emit_iface_render_tokens(buffer, tokens, source, eq_index + 1, const_range.stop)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Alias(if_al_name, if_al_target, if_al_line):
            for alias_space in 0..<indent |buffer|:
                buffer.push(32)
            emit_tokens_push_sview(buffer, "type ")
            emit_tokens_push_sview(buffer, if_al_name)
            emit_tokens_push_sview(buffer, " = ")
            emit_ast_alias_target(buffer, tokens, source, if_al_line)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Import(if_im_module, if_im_line):
            for import_space in 0..<indent |buffer|:
                buffer.push(32)
            emit_tokens_push_sview(buffer, "using ")
            emit_tokens_push_sview(buffer, if_im_module)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Extern(if_ex_name, if_ex_pstart, if_ex_arity, if_ex_variadic, if_ex_callable, if_ex_ret, if_ex_decorators, if_ex_line):
            ex_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, if_ex_line)
            return if not ex_range.found
            # `@link_name(sym)` prints above the signature, exactly as in the ast summary.
            for if_ex_decorator in if_ex_decorators |buffer, indent, tokens, source, if_ex_line|:
                for decorator_space in 0..<indent |buffer|:
                    buffer.push(32)
                emit_tokens_push_sview(buffer, "@")
                emit_tokens_push_sview(buffer, if_ex_decorator.name)
                emit_ast_decorator_args(buffer, tokens, source, if_ex_line)
                emit_tokens_push_sview(buffer, "\n")
            for extern_space in 0..<indent |buffer|:
                buffer.push(32)
            emit_iface_render_tokens(buffer, tokens, source, ex_range.start, ex_range.stop)
            emit_tokens_push_sview(buffer, "\n")
            return
        if declaration is Decl.Module(if_mod_name, if_mod_body, if_mod_line):
            for module_space in 0..<indent |buffer|:
                buffer.push(32)
            emit_tokens_push_sview(buffer, "module ")
            for if_mod_index in 0..<sview_len(if_mod_name) |buffer, if_mod_name|:
                if_mod_byte: u8 = sview_at(if_mod_name, if_mod_index)
                if if_mod_byte == 58:
                    buffer.push(46) if if_mod_index + 1 < sview_len(if_mod_name) and sview_at(if_mod_name, if_mod_index + 1) != 58 or if_mod_index > 0 and sview_at(if_mod_name, if_mod_index - 1) == 58
                else:
                    buffer.push(if_mod_byte)
            emit_tokens_push_sview(buffer, ":\n")
            first_child: mutable bool = true
            for if_mod_child in if_mod_body |buffer, level, tokens, source, first_child|:
                emit_tokens_push_sview(buffer, "\n") if not first_child
                first_child <- false
                emit_iface_decl(buffer, if_mod_child, level + 1, tokens, source)
            return
        return


    # A header line plus its indented body, rendered verbatim (enum/error/struct keep their
    # bodies in the interface).
def emit_iface_block_decl(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, line: u32, indent: i64) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        header_range: (found: bool, start: usize, stop: usize) = emit_ast_line_range(tokens, line)
        return if not header_range.found
        for header_space in 0..<indent |buffer|:
            buffer.push(32)
        emit_iface_render_tokens(buffer, tokens, source, header_range.start, header_range.stop)
        emit_tokens_push_sview(buffer, ":\n")
        body_range: (found: bool, start: usize, stop: usize) = emit_iface_body_range(tokens, header_range.stop + 1)
        return if not body_range.found
        emit_iface_body_lines(buffer, tokens, source, body_range.start, body_range.stop, indent + 4)


def emit_iface_report(file: Ast::File&, tokens: darray[Lexer::Token]&, source: u8&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    buffer: mutable darray[u8] = []
    alias_targets: mutable darray[sview] = []
    alias_lines: mutable darray[u32] = []
    for iface_using in file.enum_annotations |alias_targets, alias_lines, file|:
        if iface_using.name == "__using_alias_target":
            alias_targets.push(iface_using.owner)
            alias_lines.push(iface_using.line)
        elif iface_using.name == "__using":
            iface_aliased: mutable bool = false
            for iface_alias_probe in file.enum_annotations |iface_aliased, iface_using|:
                iface_aliased <- true if iface_alias_probe.name == "__using_alias_target" and iface_alias_probe.owner == iface_using.owner
            if not iface_aliased:
                alias_targets.push(iface_using.owner)
                alias_lines.push(iface_using.line)
    first_decl: mutable bool = true
    for iface_declaration in file.top_decls |buffer, tokens, source, alias_targets, alias_lines, first_decl|:
        iface_line: u32 = ast_decl_line(iface_declaration)
        for iface_alias_index in 0..<alias_targets.count |buffer, alias_targets, alias_lines, iface_line, first_decl|:
            if alias_lines[iface_alias_index] != 0 and alias_lines[iface_alias_index] < iface_line:
                emit_tokens_push_sview(buffer, "\n") if not first_decl
                first_decl <- false
                emit_tokens_push_sview(buffer, "using ")
                emit_tokens_push_sview(buffer, alias_targets[iface_alias_index])
                emit_tokens_push_sview(buffer, "\n")
                alias_lines[iface_alias_index] <- 0
        emit_tokens_push_sview(buffer, "\n") if not first_decl
        first_decl <- false
        emit_iface_decl(buffer, iface_declaration, 0, tokens, source)
    for iface_alias_tail in 0..<alias_targets.count |buffer, alias_targets, alias_lines, first_decl|:
        if alias_lines[iface_alias_tail] != 0:
            emit_tokens_push_sview(buffer, "\n") if not first_decl
            first_decl <- false
            emit_tokens_push_sview(buffer, "using ")
            emit_tokens_push_sview(buffer, alias_targets[iface_alias_tail])
            emit_tokens_push_sview(buffer, "\n")
    return 0 if buffer.count == 0 else emit_tokens_flush(buffer)


# Length of a NUL-terminated C string. Bounded so a missing terminator cannot spin.
def cstr_length(text: cstr) -> i64 can[Abort.Panic]:
    length: mutable i64 = 0
    for _step in 0..<1048576 |length, text|:
        break if text[length.usize()] == 0
        length <- length + 1
    return length


# Whole file by PATH. Returns an empty buffer when the path cannot be opened; the caller
# reports that as the usual "cannot read source" failure.
def read_file(path: cstr) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    contents: mutable darray[u8] = []
    descriptor: i64 = open(path, 0)
    contents return if descriptor < 0
    chunk: mutable darray[u8] = []
    chunk.resize(8192)
    while true |contents, chunk, descriptor|:
        amount: i64 = read(descriptor, &chunk[0], 8192)
        break if amount <= 0
        for index in 0..<amount.usize() |contents, chunk|:
            contents.push(chunk[index])
    _ = close(descriptor)
    return contents


# Append a C string's bytes (without its terminator) to a buffer.
def push_cstr(buffer: mutable darray[u8]&, text: cstr) -> void can[Abort.Panic, Memory.Allocate]:
    length: i64 = cstr_length(text)
    for index in 0..<length |buffer, text|:
        buffer.push(text[index.usize()].u8())


# ---- native `include` expansion --------------------------------------------------------
#
# stage0 does this itself (readSourceWithIncludes); stage1 relied on the host wrapper to
# flatten first, which is why feeding an `include` straight to the binary reported
# "undefined identifier". A compiler that cannot resolve its own includes is not a drop-in
# replacement, however good its codegen is.
#
# Recursive, deduplicated (an already-included file is skipped, matching stage0's
# include-once behaviour), and resolved RELATIVE TO THE INCLUDING FILE's directory.

# The directory part of a path, with its trailing slash; empty when the path has none.
def path_directory(path: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    directory: mutable darray[u8] = []
    last_slash: mutable i64 = -1
    for index in 0..<path.count |last_slash, path|:
        last_slash <- index.i64() if path[index] == 47
    directory return if last_slash < 0
    for index in 0..<(last_slash + 1).usize() |directory, path|:
        directory.push(path[index])
    return directory


# Resolve `relative` against `base_directory` unless it is already absolute.
def resolve_include_path(base_directory: darray[u8]&, relative: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    resolved: mutable darray[u8] = []
    if relative.count > 0 and relative[0.usize()] == 47:
        for index in 0..<relative.count |resolved, relative|:
            resolved.push(relative[index])
        return resolved
    for index in 0..<base_directory.count |resolved, base_directory|:
        resolved.push(base_directory[index])
    for index in 0..<relative.count |resolved, relative|:
        resolved.push(relative[index])
    return normalize_path(resolved)


# Collapse `./` segments so the SAME file resolved along different paths compares equal.
# Without this a diamond include (`top` -> `mid` -> `sub/lib`, and `top` -> `sub/lib`)
# produced "dir/././sub/lib" and "dir/./sub/lib", the dedupe missed, and the second copy
# was spliced in — "duplicate declaration". `..` is deliberately NOT resolved: that needs
# real path canonicalisation, and leaving it alone only costs a missed dedupe, never a
# wrong file.
def normalize_path(path: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    normalized: mutable darray[u8] = []
    index: mutable usize = 0.usize()
    while index < path.count |index, normalized, path|:
        at_segment_start: bool = normalized.count == 0.usize() or normalized[normalized.count - 1.usize()] == 47
        if at_segment_start and path[index] == 46 and index + 1.usize() < path.count and path[index + 1.usize()] == 47:
            index <- index + 2.usize()
            continue
        normalized.push(path[index])
        index <- index + 1.usize()
    return normalized


def same_path(left: darray[u8]&, right: darray[u8]&) -> bool can[Abort.Panic]:
    false return if left.count != right.count
    for index in 0..<left.count |left, right|:
        false return if left[index] != right[index]
    return true


# The quoted path of an `include "..."` line (optionally `#include`, optionally indented),
# or an empty buffer when the line is not an include directive.
def include_directive_path(line: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    empty: mutable darray[u8] = []
    cursor: mutable usize = 0.usize()
    while cursor < line.count |cursor, line|:
        break if line[cursor] != 32 and line[cursor] != 9
        cursor <- cursor + 1.usize()
    cursor <- cursor + 1.usize() if cursor < line.count and line[cursor] == 35
    while cursor < line.count |cursor, line|:
        break if line[cursor] != 32 and line[cursor] != 9
        cursor <- cursor + 1.usize()
    keyword: sview = "include"
    empty return if cursor + 7.usize() > line.count
    for keyword_index in 0..<7 |empty, line, cursor, keyword|:
        empty return if line[cursor + keyword_index.usize()] != sview_at(keyword, keyword_index)
    cursor <- cursor + 7.usize()
    empty return if cursor >= line.count or (line[cursor] != 32 and line[cursor] != 9)
    while cursor < line.count |cursor, line|:
        break if line[cursor] != 32 and line[cursor] != 9
        cursor <- cursor + 1.usize()
    empty return if cursor >= line.count or line[cursor] != 34
    cursor <- cursor + 1.usize()
    captured: mutable darray[u8] = []
    while cursor < line.count |cursor, line, captured|:
        break if line[cursor] == 34
        captured.push(line[cursor])
        cursor <- cursor + 1.usize()
    empty return if cursor >= line.count or line[cursor] != 34
    return captured


# Whether `path` already appears in the NUL-separated `seen` buffer.
def path_already_seen(seen: darray[u8]&, path: darray[u8]&) -> bool can[Abort.Panic]:
    start: mutable usize = 0.usize()
    index: mutable usize = 0.usize()
    while index < seen.count |index, start, seen, path|:
        if seen[index] == 0:
            if index - start == path.count:
                matched: mutable bool = true
                for offset in 0..<path.count |matched, seen, path, start|:
                    matched <- false if seen[start + offset] != path[offset]
                true return if matched
            start <- index + 1.usize()
        index <- index + 1.usize()
    return false


# Append `path`'s contents to `out`, splicing any includes it names. `seen` accumulates the
# already-included paths so a diamond include contributes once and a cycle terminates.
def expand_includes(path: darray[u8]&, out: mutable darray[u8]&, seen: mutable darray[u8]&, depth: i64) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    false return if depth > 64
    true return if path_already_seen(seen, path)
    # Record the path by APPENDING its bytes plus a NUL. A `darray[darray[u8]]` would need
    # each entry allocated in a region outliving the table, which the region checker
    # correctly rejects for a locally-built buffer; one flat buffer sidesteps the
    # ownership question entirely.
    for index in 0..<path.count |seen, path|:
        seen.push(path[index])
    seen.push(0)
    path_c: mutable darray[u8] = []
    for index in 0..<path.count |path_c, path|:
        path_c.push(path[index])
    path_c.push(0)
    contents: darray[u8] = read_file((&path_c[0]).cast[cstr] can Unsafe.PointerCast)
    false return if contents.count == 0
    directory: darray[u8] = path_directory(path)
    line: mutable darray[u8] = []
    index: mutable usize = 0.usize()
    while index <= contents.count |index, contents, line, out, seen, directory, depth|:
        at_end: bool = index == contents.count
        byte: u8 = 10 if at_end else contents[index]
        if byte == 10:
            included: darray[u8] = include_directive_path(line)
            if included.count > 0:
                resolved: darray[u8] = resolve_include_path(directory, included)
                _ = expand_includes(resolved, out, seen, depth + 1)
            else:
                for line_index in 0..<line.count |out, line|:
                    out.push(line[line_index])
                out.push(10)
            line <- []
        else:
            line.push(byte)
        index <- index + 1.usize()
    return true


# The emit modes this driver actually implements. stage0 has more; claiming them here by
# silently falling through to the object path would be worse than saying no.
def cli_emit_mode_supported(mode: cstr) -> bool can[Abort.Panic]:
    true return if mode == "obj"
    true return if mode == "llvm"
    true return if mode == "bc"
    true return if mode == "tokens"
    true return if mode == "ast"
    true return if mode == "iface"
    true return if mode == "fmt"
    true return if mode == "deps"
    true return if mode == "deps-json"
    return false


# Parse `elisac-stage1 [-emit MODE] [-o OUT] [-O0|-O1|-O2|-O3] SOURCE` and build the SAME
# buffer the stdin wire protocol produces: output path, newline, source bytes, NUL. Every
# downstream stage is therefore untouched by the CLI existing — the two front doors meet
# immediately and share one compile path.
#
# Unknown `-flags` are IGNORED rather than rejected: the host wrapper passes through
# linker/target options this driver does not implement yet, and failing on them would make
# the CLI less usable than the wrapper it replaces.
def cli_request(argc: i64, argv: mutable void&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    request: mutable darray[u8] = []
    slots: mutable cstr&& = argv.cast[mutable cstr&&]
    output_path: mutable darray[u8] = []
    source_index: mutable i64 = 0
    index: mutable i64 = 1
    while index < argc |index, slots, output_path, source_index|:
        argument: cstr = slots[index].cast[cstr]
        if argument == "-o" and index + 1 < argc:
            index <- index + 1
            push_cstr(&output_path, slots[index].cast[cstr])
        elif argument == "-emit" and index + 1 < argc:
            index <- index + 1
            requested_mode: cstr = slots[index].cast[cstr]
            # REJECT an unsupported mode instead of ignoring it. Ignoring meant `-emit
            # lowered` silently produced a Mach-O OBJECT at the path the caller expected a
            # text dump at — a wrong answer that looks like success, and it made every
            # unimplemented mode read as "supported" when probed by exit code. stage0
            # rejects unknown modes; so does this.
            if not cli_emit_mode_supported(requested_mode):
                message: mutable darray[u8] = []
                for prefix_index in 0..<sview_len("unsupported -emit mode: ") |message|:
                    message.push(sview_at("unsupported -emit mode: ", prefix_index))
                push_cstr(&message, requested_mode)
                for suffix_index in 0..<sview_len("\nsupported: obj llvm bc tokens ast iface fmt deps deps-json\n") |message|:
                    message.push(sview_at("\nsupported: obj llvm bc tokens ast iface fmt deps deps-json\n", suffix_index))
                write_stderr(message)
                return request
            _ = setenv("ELISA_STAGE1_EMIT", requested_mode, 1)
        elif argument == "-O0":
            _ = setenv("ELISA_STAGE1_OPT", "0", 1)
        elif argument == "-O1":
            _ = setenv("ELISA_STAGE1_OPT", "1", 1)
        elif argument == "-O2":
            _ = setenv("ELISA_STAGE1_OPT", "2", 1)
        elif argument == "-O3":
            _ = setenv("ELISA_STAGE1_OPT", "3", 1)
        elif argument[0] != 45:
            source_index <- index
            # Diagnostics name the file. The wrapper already set this for its own callers;
            # the CLI must set it too or a CLI-compiled program reports a bare line number.
            _ = setenv("ELISA_STAGE1_SRC", argument, 1)
        index <- index + 1
    request return if source_index == 0
    source_path: cstr = slots[source_index].cast[cstr]
    # Default output mirrors stage0's: the source path with the emit-appropriate suffix is
    # the WRAPPER's business, so with no -o the compile still needs a destination; use the
    # source path plus ".o" rather than inventing a name the caller cannot predict.
    if output_path.count == 0:
        push_cstr(&output_path, source_path)
        output_path.push(46)
        output_path.push(111)
    # Expand includes HERE, natively, rather than requiring the caller to pre-flatten.
    # Falls back to the raw file when expansion finds nothing to do, so a single-file
    # program takes the same path it always did.
    source_path_bytes: mutable darray[u8] = []
    push_cstr(&source_path_bytes, source_path)
    included_seen: mutable darray[u8] = []
    expanded_source: mutable darray[u8] = []
    contents: mutable darray[u8] = expanded_source if expand_includes(source_path_bytes, &expanded_source, &included_seen, 0) else read_file(source_path)
    request return if contents.count == 0
    for path_index in 0..<output_path.count |request, output_path|:
        request.push(output_path[path_index])
    request.push(10)
    for content_index in 0..<contents.count |request, contents|:
        request.push(contents[content_index])
    request.push(0)
    return request


def read_all() -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    buf: mutable darray[u8] = []
    chunk: mutable darray[u8] = []
    chunk.resize(8192)
    while true |buf, chunk|:
        n: i64 = read(0, &chunk[0], 8192)
        break if n <= 0
        for index in 0..<n.usize() |buf, chunk|:
            buf.push(chunk[index])
    buf.push(0)
    return buf


# `-emit deps` / `-emit deps-json`: the resolved include CLOSURE, root first, in include
# order. stage0 emits this natively; stage1 had it only as PYTHON inside the host wrapper,
# which meant the compiler could not answer "what does this file depend on" on its own.
#
# expand_includes already walks exactly this graph and records each file once, so deps is
# that walk with its `seen` buffer printed instead of its expanded source.
def emit_deps_report(json_form: bool) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    source_path_bytes: mutable darray[u8] = []
    1 return if not push_source_path(&source_path_bytes)
    seen: mutable darray[u8] = []
    scratch: mutable darray[u8] = []
    1 return if not expand_includes(source_path_bytes, &scratch, &seen, 0)
    out: mutable darray[u8] = []
    if not json_form:
        for byte_index in 0..<seen.count |out, seen|:
            out.push(10) if seen[byte_index] == 0 else out.push(seen[byte_index])
        return emit_tokens_flush(out)
    # stage0's JSON names the ROOT and then lists EVERY file, the root included — so the
    # root appears twice, once per field. Two scans rather than one, because the root is
    # not a special case in `files`.
    for prefix_index in 0..<sview_len("{\n  \"root\": \"") |out|:
        out.push(sview_at("{\n  \"root\": \"", prefix_index))
    root_index: mutable usize = 0.usize()
    while root_index < seen.count |root_index, out, seen|:
        break if seen[root_index] == 0
        out.push(seen[root_index])
        root_index <- root_index + 1.usize()
    for files_index in 0..<sview_len("\",\n  \"files\": [\n") |out|:
        out.push(sview_at("\",\n  \"files\": [\n", files_index))
    index: mutable usize = 0.usize()
    start: mutable usize = 0.usize()
    entry_number: mutable i64 = 0
    while index < seen.count |index, start, out, seen, entry_number|:
        if seen[index] == 0:
            if entry_number > 0:
                for sep_index in 0..<sview_len(",\n") |out|:
                    out.push(sview_at(",\n", sep_index))
            for quote_index in 0..<sview_len("    \"") |out|:
                out.push(sview_at("    \"", quote_index))
            for byte_index in start..<index |out, seen|:
                out.push(seen[byte_index])
            out.push(34)
            entry_number <- entry_number + 1
            start <- index + 1.usize()
        index <- index + 1.usize()
    for tail_index in 0..<sview_len("\n  ]\n}\n") |out|:
        out.push(sview_at("\n  ]\n}\n", tail_index))
    return emit_tokens_flush(out)


def main(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    # TWO front doors, ONE compile path. With arguments this is an ordinary CLI; with none
    # it is the original stdin wire protocol, which the host wrapper and the bootstrap both
    # still use. cli_request builds exactly the buffer read_all would have produced, so
    # nothing downstream can tell the difference.
    raw: darray[u8] = cli_request(argc, argv) if argc > 1 else read_all()
    # `-emit deps`/`deps-json` answer from the include graph alone — no parse, no analysis.
    # Placed after cli_request so the CLI has recorded the source path it walks from.
    emit_deps_report(false) return if emit_mode_is("deps")
    emit_deps_report(true) return if emit_mode_is("deps-json")
    1 return if raw.count <= 1

    out_path: mutable darray[u8] = []
    i: mutable usize = 0
    while i < raw.count - 1 |i, out_path|:
        b: u8 = raw[i]
        break if b == 10
        out_path.push(b)
        i <- i + 1
    1 return if out_path.count == 0
    path_len: i64 = out_path.count.i64()
    out_path.push(0)
    i <- i + 1 if i < raw.count - 1 and raw[i] == 10
    source_start: usize = i
    source_len: usize = raw.count - 1 - source_start
    1 return if source_len == 0

    src_ptr: u8& = &raw[source_start]
    tokens: darray[Lexer::Token] = frontend_tokenize_with_length(src_ptr, src_ptr, source_len)
    # `-emit tokens` is the LEXER oracle: report and stop before parsing, as stage0 does.
    if emit_mode_is("tokens"):
        return emit_tokens_report(tokens)
    # The unparser needs stage0's grouping nodes; the compile path must not see them.
    # Safe because `-emit fmt` returns below, before the semantic gate and codegen.
    parser_set_preserve_parens(emit_mode_is("fmt"))
    file: mutable Ast::File = frontend_parser_parse_file(src_ptr, tokens)
    if file.errors.count != 0:
        for parse_error_index in 0..<file.errors.count |file|:
            report_parse_error(file.errors[parse_error_index])
        return 1

    # `-emit ast` prints the parse-tree summary and stops, as stage0 does.
    if emit_mode_is("ast"):
        return emit_ast_report(file, tokens, src_ptr)
    if emit_mode_is("iface"):
        return emit_iface_report(file, tokens, src_ptr)
    # `-emit fmt` runs the unparser; every unported shape prints a loud <fmt-*-todo>
    # marker, so partial coverage can never read as byte parity in the smoke.
    if emit_mode_is("fmt"):
        fmt_buffer: mutable darray[u8] = []
        FmtUnparse::fmt_file(fmt_buffer, file, tokens, src_ptr)
        return 0 if fmt_buffer.count == 0 else emit_tokens_flush(fmt_buffer)

    # `static generate` expansion. The pass has existed since task #35 but was wired ONLY into
    # test/breadth/parse_report.elisa — never into this driver — so every `static generate:`
    # block was silently skipped and its generated names came back as "undefined identifier".
    #
    # Placed AFTER the `-emit fmt` return on purpose: the unparser must see the ORIGINAL source
    # (it round-trips what was written, not what was generated), and `-emit tokens`/`ast`/`iface`
    # have already returned above for the same reason.
    #
    # Recognized blocks are spliced into an expanded source and re-parsed ONCE, so generated
    # declarations flow through the semantic gate and codegen exactly like hand-written ones.
    # `expanded` is declared here so the generated declarations' source spans outlive the parse;
    # unrecognized blocks copy through and the pass answers false, leaving everything untouched.
    expanded: mutable darray[u8] = []
    expanded_tokens: mutable darray[Lexer::Token] = []
    expanded_src_ptr: mutable u8& = src_ptr
    if frontend_preprocess_static_generate(src_ptr, source_len, tokens, file, expanded):
        expanded_src_ptr <- &expanded[0]
        expanded_tokens <- frontend_tokenize_with_length(expanded_src_ptr, expanded_src_ptr, expanded.count)
        file <- frontend_parser_parse_file(expanded_src_ptr, expanded_tokens)
        if file.errors.count != 0:
            for parse_error_index in 0..<file.errors.count |file|:
                report_parse_error(file.errors[parse_error_index])
            return 1

    # Analyse before emitting, as stage0 does: exit 1 on any ERROR-severity finding
    # (severity 1); warnings (2) do not block. Status codes only — see the note on
    # `puts` below — so this reproduces the accept/reject DECISION, not the message.
    #
    # OPT-IN while stage1's semantic layer still OVER-reports relative to stage0 on the
    # compiler's own source (642 findings where stage0 makes none; 437 are severity-2
    # warnings, and the rest are being worked through cluster by cluster). With the gate
    # ON, 40 of the 44 diagnostics fixtures stage1 wrongly ACCEPTED are now correctly
    # rejected (292 cases: 222 -> 258 agreeing with stage0).
    if semantic_gate_enabled():
        table: Semantic::SymbolTable = Semantic::check_full(file, false, false, runtime_std_enabled(src_ptr, source_len), false, false, false, false, false, false, false, 64)
        semantic_errors: mutable i64 = 0
        for diagnostic in table.diagnostics |semantic_errors|:
            continue if Semantic::diagnostic_severity(diagnostic) != 1
            semantic_errors <- semantic_errors + 1
            report_diagnostic(diagnostic)
        1 return if semantic_errors > 0

    ctx: LLVMContextRef = LLVMContextCreate()
    module_handle: LLVMModuleRef = LLVMModuleCreateWithNameInContext("elisac_stage1", ctx)
    builder: LLVMBuilderRef = LLVMCreateBuilderInContext(ctx)
    emitted_count: i64 = Backend::emit_module(file, module_handle, ctx, builder)
    # Status codes only (no puts/write): logging via libc puts conflicts with
    # elisacore_std's puts overload under stage1 meta-compile / stage0 seed.
    # A unit with no function at all emits nothing BY CONSTRUCTION — see
    # unit_declares_function. Only a unit that HAS one and emitted none has failed.
    2 return if emitted_count <= 0 and unit_declares_function(file.top_decls)

    machine: LLVMTargetMachineRef = Backend::configure_module_target(module_handle)
    # The pass pipeline runs only when ASKED (ELISA_STAGE1_OPT=1/2/3). It was disabled
    # outright while `default<O2>` trapped on large self-host modules — those traps were
    # the opaque-handle `==` and arena-identity miscompiles in the self-hosted binary
    # (fixed 2026-08-02/03), and the pipeline now survives the compiler's own 110k-line
    # module. Unoptimised emission stays the DEFAULT: the fixpoint compares bytes, and
    # optimisation must never change results, only speed — differential_corpus runs the
    # corpus under -O2 exactly to hold that.
    opt_level: i64 = optimization_level()
    if opt_level == 1:
        5 return if not Backend::run_optimization(machine, module_handle, "default<O1>")
    elif opt_level == 2:
        5 return if not Backend::run_optimization(machine, module_handle, "default<O2>")
    elif opt_level == 3:
        5 return if not Backend::run_optimization(machine, module_handle, "default<O3>")

    path_cstr: cstr = (&out_path[0]).cast[cstr]
    if emit_llvm_requested():
        6 return if LLVMPrintModuleToFile(module_handle, path_cstr, null) != 0
    elif emit_mode_is("bc"):
        # `-emit bc` — the SAME module the object path lowers, written as bitcode instead
        # of assembled. It runs after the optimisation pipeline above, so `-O2 -emit bc`
        # is optimised bitcode, matching what stage0 writes.
        7 return if LLVMWriteBitcodeToFile(module_handle, path_cstr) != 0
    else:
        4 return if not Backend::emit_object(machine, module_handle, path_cstr)

    LLVMDisposeBuilder(builder)
    LLVMDisposeModule(module_handle)
    LLVMContextDispose(ctx)
    return 0
