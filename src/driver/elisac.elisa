        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, "); ")
    emit_tokens_push_sview(buffer, "if (field_value == NULL || PyDict_SetItemString(out, \"")
    emit_tokens_push_sview(buffer, python_field_name)
    emit_tokens_push_sview(buffer, "\", field_value) < 0) { Py_XDECREF(field_value); Py_DECREF(out); return NULL; } Py_DECREF(field_value); }\n")


def emit_pymodule_struct_typedef_and_helpers(buffer: mutable darray[u8]&, file: Ast::File&, type_name: sview, emitted_names: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    for emitted_name in emitted_names:
        return if emitted_name == type_name
    emitted_names.push(type_name)
    declaration: Ast::Decl? = pymodule_find_struct_in(file.top_decls, type_name)
    if declaration is target:
        if target is Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, pos):
            # C requires nested typedefs to be visible before the containing record. Emit the
            # dependency graph depth-first; emitted_names also breaks any defensive cycle path.
            for member in members:
                nested_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                named_leaf_struct_type: sview = pymodule_named_struct_leaf_for_pymodule(file, nested_type_name, true)
                if named_leaf_struct_type != "":
                    emit_pymodule_struct_typedef_and_helpers(buffer, file, named_leaf_struct_type, emitted_names)
                elif pymodule_struct_input_supported(file, nested_type_name):
                    emit_pymodule_struct_typedef_and_helpers(buffer, file, nested_type_name, emitted_names)
                elif pymodule_is_darray_type(nested_type_name) or pymodule_is_view_type(nested_type_name):
                    nested_element_name: sview = pymodule_darray_element_name(nested_type_name) if pymodule_is_darray_type(nested_type_name) else pymodule_view_element_name(nested_type_name)
                    if pymodule_is_darray_type(nested_element_name):
                        nested_struct_name: sview = pymodule_darray_element_name(nested_element_name)
                        if pymodule_struct_input_supported(file, nested_struct_name):
                            emit_pymodule_struct_typedef_and_helpers(buffer, file, nested_struct_name, emitted_names)
                    elif pymodule_is_dict_type(nested_element_name):
                        nested_dict_value_name: sview = pymodule_dict_value_name(nested_element_name)
                        if pymodule_struct_input_supported(file, nested_dict_value_name):
                            emit_pymodule_struct_typedef_and_helpers(buffer, file, nested_dict_value_name, emitted_names)
                        elif pymodule_is_darray_type(nested_dict_value_name) and pymodule_struct_input_supported(file, pymodule_darray_element_name(nested_dict_value_name)):
                            emit_pymodule_struct_typedef_and_helpers(buffer, file, pymodule_darray_element_name(nested_dict_value_name), emitted_names)
                        elif pymodule_is_view_type(nested_dict_value_name) and pymodule_struct_input_supported(file, pymodule_view_element_name(nested_dict_value_name)):
                            emit_pymodule_struct_typedef_and_helpers(buffer, file, pymodule_view_element_name(nested_dict_value_name), emitted_names)
                    elif pymodule_struct_input_supported(file, nested_element_name):
                        emit_pymodule_struct_typedef_and_helpers(buffer, file, nested_element_name, emitted_names)
                elif pymodule_is_dict_type(nested_type_name):
                    nested_dict_value_name: sview = pymodule_dict_value_name(nested_type_name)
                    if pymodule_struct_input_supported(file, nested_dict_value_name):
                        emit_pymodule_struct_typedef_and_helpers(buffer, file, nested_dict_value_name, emitted_names)
                    elif pymodule_is_darray_type(nested_dict_value_name) and pymodule_struct_input_supported(file, pymodule_darray_element_name(nested_dict_value_name)):
                        emit_pymodule_struct_typedef_and_helpers(buffer, file, pymodule_darray_element_name(nested_dict_value_name), emitted_names)
                    elif pymodule_is_view_type(nested_dict_value_name) and pymodule_struct_input_supported(file, pymodule_view_element_name(nested_dict_value_name)):
                        emit_pymodule_struct_typedef_and_helpers(buffer, file, pymodule_view_element_name(nested_dict_value_name), emitted_names)
            emit_tokens_push_sview(buffer, "typedef struct { ")
            for member in members:
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                field_c_type_name: mutable sview = pymodule_c_type_name(field_type_name)
                field_c_type_name <- field_type_name if field_c_type_name == "" and pymodule_struct_return_supported(file, field_type_name)
                emit_tokens_push_sview(buffer, field_c_type_name)
                emit_tokens_push_sview(buffer, " ")
                emit_tokens_push_sview(buffer, pymodule_struct_c_field_name(member.name))
                emit_tokens_push_sview(buffer, "; ")
            emit_tokens_push_sview(buffer, "} ")
            emit_tokens_push_sview(buffer, type_name)
            emit_tokens_push_sview(buffer, ";\n")
            emit_tokens_push_sview(buffer, "static void elisa_pymodule_struct_")
            emit_tokens_push_sview(buffer, type_name)
            emit_tokens_push_sview(buffer, "_free(")
            emit_tokens_push_sview(buffer, type_name)
            emit_tokens_push_sview(buffer, " *value) {\n")
            for member in members:
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                if pymodule_is_darray_type(field_type_name):
                    emit_tokens_push_sview(buffer, "    value->")
                    emit_tokens_push_sview(buffer, pymodule_struct_c_field_name(member.name))
                    emit_tokens_push_sview(buffer, " = (ElisaDArray){NULL, 0, 0};\n")
                elif pymodule_is_dict_type(field_type_name):
                    emit_tokens_push_sview(buffer, "    value->")
                    emit_tokens_push_sview(buffer, pymodule_struct_c_field_name(member.name))
                    emit_tokens_push_sview(buffer, " = (ElisaDict){NULL, 0, 0, 0, NULL};\n")
                elif pymodule_is_set_type(field_type_name):
                    emit_tokens_push_sview(buffer, "    value->")
                    emit_tokens_push_sview(buffer, pymodule_struct_c_field_name(member.name))
                    emit_tokens_push_sview(buffer, " = (ElisaSet){NULL, 0, 0, 0, NULL};\n")
                elif pymodule_is_view_type(field_type_name):
                    emit_tokens_push_sview(buffer, "    value->")
                    emit_tokens_push_sview(buffer, pymodule_struct_c_field_name(member.name))
                    emit_tokens_push_sview(buffer, " = (ElisaView){NULL, 0};\n")
                elif pymodule_struct_input_supported(file, field_type_name):
                    emit_tokens_push_sview(buffer, "    elisa_pymodule_struct_")
                    emit_tokens_push_sview(buffer, field_type_name)
                    emit_tokens_push_sview(buffer, "_free(&value->")
                    emit_tokens_push_sview(buffer, pymodule_struct_c_field_name(member.name))
                    emit_tokens_push_sview(buffer, ");\n")
            emit_tokens_push_sview(buffer, "}\n")
            # Struct dictionary fields share the ordinary recursive darray bridge.  Emit the
            # field-specific helpers before either struct direction references them so nested
            # dictionary values have the same conversion and lifetime guarantees as top-level
            # parameters and error payloads.
            for member in members |buffer, file, type_name|:
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                continue if not pymodule_is_dict_type(field_type_name)
                dict_value_type: sview = pymodule_dict_value_name(field_type_name)
                if pymodule_is_dict_type(dict_value_type):
                    input_helper_storage: mutable darray[u8] = []
                    input_helper: sview = pymodule_struct_nested_dict_helper_name(&input_helper_storage, type_name, member.name, "from_py")
                    emit_pymodule_composed_dict_input_helper(buffer, file, input_helper, dict_value_type)
                    output_helper_storage: mutable darray[u8] = []
                    output_helper: sview = pymodule_struct_nested_dict_helper_name(&output_helper_storage, type_name, member.name, "to_py")
                    emit_pymodule_composed_dict_output_helper(buffer, file, output_helper, dict_value_type)
                elif pymodule_is_set_type(dict_value_type):
                    input_helper_storage: mutable darray[u8] = []
                    input_helper: sview = pymodule_struct_nested_dict_helper_name(&input_helper_storage, type_name, member.name, "from_py")
                    emit_pymodule_composed_set_input_helper(buffer, input_helper, dict_value_type)
                    output_helper_storage: mutable darray[u8] = []
                    output_helper: sview = pymodule_struct_nested_dict_helper_name(&output_helper_storage, type_name, member.name, "to_py")
                    emit_pymodule_composed_set_output_helper(buffer, output_helper, dict_value_type)
                elif pymodule_is_darray_type(dict_value_type) and pymodule_is_dict_type(pymodule_darray_element_name(dict_value_type)):
                    input_helper_storage: mutable darray[u8] = []
                    input_helper: sview = pymodule_struct_nested_dict_helper_name(&input_helper_storage, type_name, member.name, "from_py")
                    emit_pymodule_darray_dict_input_helper(buffer, file, input_helper, pymodule_darray_element_name(dict_value_type))
                    output_helper_storage: mutable darray[u8] = []
                    output_helper: sview = pymodule_struct_nested_dict_helper_name(&output_helper_storage, type_name, member.name, "to_py")
                    emit_pymodule_darray_dict_output_helper(buffer, file, output_helper, pymodule_darray_element_name(dict_value_type))
                elif pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) == 1.usize() and pymodule_struct_input_supported(file, pymodule_darray_element_name(dict_value_type)):
                    input_helper_storage: mutable darray[u8] = []
                    input_helper: sview = pymodule_struct_nested_dict_helper_name(&input_helper_storage, type_name, member.name, "from_py")
                    emit_pymodule_darray_struct_input_helper(buffer, file, input_helper, pymodule_darray_element_name(dict_value_type))
                elif pymodule_is_view_type(dict_value_type) and pymodule_darray_c_element_type(pymodule_view_element_name(dict_value_type)) == "" and pymodule_struct_input_supported(file, pymodule_view_element_name(dict_value_type)):
                    input_helper_storage: mutable darray[u8] = []
                    input_helper: sview = pymodule_struct_nested_dict_helper_name(&input_helper_storage, type_name, member.name, "from_py")
                    emit_pymodule_view_struct_input_helper(buffer, file, input_helper, pymodule_view_element_name(dict_value_type))
                elif pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) >= 2.usize() and pymodule_top_level_nested_darray_input_supported(file, dict_value_type):
                    input_helper_storage: mutable darray[u8] = []
                    input_helper: sview = pymodule_struct_nested_dict_helper_name(&input_helper_storage, type_name, member.name, "from_py")
                    emit_pymodule_composed_nested_darray_input_helper(buffer, file, input_helper, dict_value_type)
                if pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) >= 2.usize() and pymodule_top_level_nested_darray_return_supported(file, dict_value_type):
                    output_helper_storage: mutable darray[u8] = []
                    output_helper: sview = pymodule_struct_nested_dict_helper_name(&output_helper_storage, type_name, member.name, "to_py")
                    emit_pymodule_composed_nested_darray_output_helper(buffer, file, output_helper, dict_value_type)
                elif pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) == 1.usize() and pymodule_struct_return_supported(file, pymodule_darray_element_name(dict_value_type)):
                    output_helper_storage: mutable darray[u8] = []
                    output_helper: sview = pymodule_struct_nested_dict_helper_name(&output_helper_storage, type_name, member.name, "to_py")
                    emit_pymodule_darray_struct_output_helper(buffer, file, output_helper, pymodule_darray_element_name(dict_value_type))
                elif pymodule_is_view_type(dict_value_type) and pymodule_darray_c_element_type(pymodule_view_element_name(dict_value_type)) == "" and pymodule_struct_return_supported(file, pymodule_view_element_name(dict_value_type)):
                    output_helper_storage: mutable darray[u8] = []
                    output_helper: sview = pymodule_struct_nested_dict_helper_name(&output_helper_storage, type_name, member.name, "to_py")
                    emit_pymodule_view_struct_output_helper(buffer, file, output_helper, pymodule_view_element_name(dict_value_type))
            for member in members |buffer, file, type_name|:
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                continue if not pymodule_is_darray_type(field_type_name)
                dict_element_name: sview = pymodule_darray_element_name(field_type_name)
                continue if not pymodule_is_dict_type(dict_element_name)
                if pymodule_nested_dict_values_supported_in_type(file, dict_element_name, 0.usize()):
                    input_helper_storage: mutable darray[u8] = []
                    input_helper: sview = pymodule_struct_darray_dict_helper_name(&input_helper_storage, type_name, member.name, "from_py")
                    emit_pymodule_darray_dict_input_helper(buffer, file, input_helper, dict_element_name)
                    output_helper_storage: mutable darray[u8] = []
                    output_helper: sview = pymodule_struct_darray_dict_helper_name(&output_helper_storage, type_name, member.name, "to_py")
                    emit_pymodule_darray_dict_output_helper(buffer, file, output_helper, dict_element_name)
            for member in members |buffer, type_name|:
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                continue if not pymodule_is_darray_type(field_type_name)
                set_element_name: sview = pymodule_darray_element_name(field_type_name)
                continue if not pymodule_is_set_type(set_element_name)
                input_helper_storage: mutable darray[u8] = []
                input_helper: sview = pymodule_struct_darray_set_helper_name(&input_helper_storage, type_name, member.name, "from_py")
                emit_pymodule_darray_set_input_helper(buffer, input_helper, set_element_name)
                output_helper_storage: mutable darray[u8] = []
                output_helper: sview = pymodule_struct_darray_set_helper_name(&output_helper_storage, type_name, member.name, "to_py")
                emit_pymodule_darray_set_output_helper(buffer, output_helper, set_element_name)
            # Nested list fields use the same recursive helper chain as top-level list
            # parameters.  Generate field-specific wrappers so the struct converter can pass
            # its shared arena/reference table through every depth without embedding a fixed
            # two-level layout in the containing record helper.
            for member in members |buffer, file, type_name|:
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                continue if not pymodule_is_darray_type(field_type_name) or pymodule_darray_nesting_depth(field_type_name) < 2.usize()
                if pymodule_top_level_nested_darray_input_supported(file, field_type_name):
                    input_helper_storage: mutable darray[u8] = []
                    input_helper: sview = pymodule_struct_darray_nested_helper_name(&input_helper_storage, type_name, member.name, "from_py")
                    emit_pymodule_composed_nested_darray_input_helper(buffer, file, input_helper, field_type_name)
                if pymodule_top_level_nested_darray_return_supported(file, field_type_name):
                    output_helper_storage: mutable darray[u8] = []
                    output_helper: sview = pymodule_struct_darray_nested_helper_name(&output_helper_storage, type_name, member.name, "to_py")
                    emit_pymodule_composed_nested_darray_output_helper(buffer, file, output_helper, field_type_name)
            if pymodule_struct_return_supported(file, type_name):
                emit_tokens_push_sview(buffer, "static PyObject *elisa_pymodule_struct_")
                emit_tokens_push_sview(buffer, type_name)
                emit_tokens_push_sview(buffer, "_to_py(")
                emit_tokens_push_sview(buffer, type_name)
                emit_tokens_push_sview(buffer, " value) { PyObject *out = PyDict_New(); if (out == NULL) return NULL;\n")
                for member in members:
                    field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                    nested_dict_output_helper: mutable sview = ""
                    if pymodule_is_dict_type(field_type_name):
                        dict_value_type: sview = pymodule_dict_value_name(field_type_name)
                        if pymodule_is_dict_type(dict_value_type) or pymodule_is_set_type(dict_value_type) or (pymodule_is_darray_type(dict_value_type) and pymodule_is_dict_type(pymodule_darray_element_name(dict_value_type))) or (pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) == 1.usize() and pymodule_struct_return_supported(file, pymodule_darray_element_name(dict_value_type))) or (pymodule_is_view_type(dict_value_type) and pymodule_darray_c_element_type(pymodule_view_element_name(dict_value_type)) == "" and pymodule_struct_return_supported(file, pymodule_view_element_name(dict_value_type))) or (pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) >= 2.usize() and pymodule_top_level_nested_darray_return_supported(file, dict_value_type)):
                            nested_dict_output_helper_storage: mutable darray[u8] = []
                            nested_dict_output_helper <- pymodule_struct_nested_dict_helper_name(&nested_dict_output_helper_storage, type_name, member.name, "to_py")
                    pymodule_struct_field_c_to_py(buffer, file, field_type_name, member.name, pymodule_struct_c_field_name(member.name), nested_dict_output_helper, type_name)
                emit_tokens_push_sview(buffer, "    return out; }\n")
            emit_tokens_push_sview(buffer, "static int elisa_pymodule_struct_")
            emit_tokens_push_sview(buffer, type_name)
            emit_tokens_push_sview(buffer, "_from_py(PyObject *object, ")
            emit_tokens_push_sview(buffer, type_name)
            emit_tokens_push_sview(buffer, " *out, ElisaArena *arena, ElisaPyRefs *refs) {\n")
            for member in members:
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                nested_dict_input_helper: mutable sview = ""
                if pymodule_is_dict_type(field_type_name):
                    dict_value_type: sview = pymodule_dict_value_name(field_type_name)
                    if pymodule_is_dict_type(dict_value_type) or pymodule_is_set_type(dict_value_type) or (pymodule_is_darray_type(dict_value_type) and pymodule_is_dict_type(pymodule_darray_element_name(dict_value_type))) or (pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) == 1.usize() and pymodule_struct_input_supported(file, pymodule_darray_element_name(dict_value_type))) or (pymodule_is_view_type(dict_value_type) and pymodule_darray_c_element_type(pymodule_view_element_name(dict_value_type)) == "" and pymodule_struct_input_supported(file, pymodule_view_element_name(dict_value_type))) or (pymodule_is_darray_type(dict_value_type) and pymodule_darray_nesting_depth(dict_value_type) >= 2.usize() and pymodule_top_level_nested_darray_input_supported(file, dict_value_type)):
                        nested_dict_input_helper_storage: mutable darray[u8] = []
                        nested_dict_input_helper <- pymodule_struct_nested_dict_helper_name(&nested_dict_input_helper_storage, type_name, member.name, "from_py")
                pymodule_struct_field_py_to_c(buffer, file, field_type_name, member.name, pymodule_struct_c_field_name(member.name), member.has_default, member.default_value, nested_dict_input_helper, type_name)
            emit_tokens_push_sview(buffer, "    return 0; }\n\n")


# C scalar spellings match the native LLVM ABI emitted for the corresponding Elisa source type.
# Empty means that `-emit pymodule-c` should refuse the entry instead of publishing a guessed ABI.
def pymodule_c_type_name(type_name: sview) -> sview can[Abort.Panic]:
    "void" return if type_name == "void"
    "PyObject *" return if type_name == "py::Object"
    "PyObject *" return if type_name == "py::Object?"
    "const char *" return if type_name == "cstr"
    "const char *" return if type_name == "cstr?"
    "ElisaSView" return if type_name == "sview"
    "ElisaOptionalSView" return if type_name == "sview?"
    "ElisaDict" return if pymodule_is_dict_type(type_name)
    "ElisaDArray" return if pymodule_is_darray_type(type_name)
    "ElisaView" return if pymodule_is_view_type(type_name)
    "ElisaSet" return if pymodule_is_set_type(type_name)
    "int8_t" return if type_name == "i8"
    "int16_t" return if type_name == "i16"
    "int32_t" return if type_name == "i32"
    "int64_t" return if type_name == "i64" or type_name == "char"
    "intptr_t" return if type_name == "int" or type_name == "isize"
    "uint8_t" return if type_name == "u8"
    "uint16_t" return if type_name == "u16"
    "uint32_t" return if type_name == "u32"
    "uint64_t" return if type_name == "u64"
    "uintptr_t" return if type_name == "usize" or type_name == "uintptr"
    "bool" return if type_name == "bool"
    "float" return if type_name == "f32"
    "double" return if type_name == "f64"
    "ElisaOptionalI8" return if type_name == "i8?"
    "ElisaOptionalI16" return if type_name == "i16?"
    "ElisaOptionalI32" return if type_name == "i32?"
    "ElisaOptionalI64" return if type_name == "i64?" or type_name == "char?"
    "ElisaOptionalInt" return if type_name == "int?" or type_name == "isize?"
    "ElisaOptionalU8" return if type_name == "u8?"
    "ElisaOptionalU16" return if type_name == "u16?"
    "ElisaOptionalU32" return if type_name == "u32?"
    "ElisaOptionalU64" return if type_name == "u64?"
    "ElisaOptionalUSize" return if type_name == "usize?" or type_name == "uintptr?"
    "ElisaOptionalBool" return if type_name == "bool?"
    "ElisaOptionalF32" return if type_name == "f32?"
    "ElisaOptionalF64" return if type_name == "f64?"
    return ""


def pymodule_parse_format(type_name: sview) -> sview can[Abort.Panic]:
    "O" return if type_name == "py::Object"
    "O" return if type_name == "py::Object?"
    "s#" return if type_name == "cstr"
    "O" return if type_name == "cstr?"
    "s#" return if type_name == "sview"
    "O" return if pymodule_is_dict_type(type_name)
    "O" return if pymodule_is_darray_type(type_name)
    "O" return if pymodule_is_view_type(type_name)
    "O" return if pymodule_is_set_type(type_name)
    "L" return if type_name == "i8" or type_name == "i16" or type_name == "i32" or type_name == "i64" or type_name == "int" or type_name == "isize" or type_name == "char"
    "K" return if type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or type_name == "usize" or type_name == "uintptr"
    "d" return if type_name == "f32" or type_name == "f64"
    "p" return if type_name == "bool"
    "O" return if pymodule_c_type_name(type_name) == "ElisaOptionalI8" or pymodule_c_type_name(type_name) == "ElisaOptionalI16" or pymodule_c_type_name(type_name) == "ElisaOptionalI32" or pymodule_c_type_name(type_name) == "ElisaOptionalI64" or pymodule_c_type_name(type_name) == "ElisaOptionalInt" or pymodule_c_type_name(type_name) == "ElisaOptionalU8" or pymodule_c_type_name(type_name) == "ElisaOptionalU16" or pymodule_c_type_name(type_name) == "ElisaOptionalU32" or pymodule_c_type_name(type_name) == "ElisaOptionalU64" or pymodule_c_type_name(type_name) == "ElisaOptionalUSize" or pymodule_c_type_name(type_name) == "ElisaOptionalBool" or pymodule_c_type_name(type_name) == "ElisaOptionalF32" or pymodule_c_type_name(type_name) == "ElisaOptionalF64" or pymodule_c_type_name(type_name) == "ElisaOptionalSView"
    "O" return if type_name != ""
    return ""


def pymodule_parameter_is_implicit_optional(type_name: sview) -> bool can[Abort.Panic]:
    return type_name == "py::Object?" or type_name == "cstr?" or pymodule_is_optional_scalar_type(type_name)


def pymodule_default_is_null(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_is_null(default_inner)
    if expression is Expr.Ident(default_name, default_pos):
        return default_name == "null"
    return false


def pymodule_is_optional_scalar_type(type_name: sview) -> bool can[Abort.Panic]:
    c_type: sview = pymodule_c_type_name(type_name)
    return c_type == "ElisaOptionalI8" or c_type == "ElisaOptionalI16" or c_type == "ElisaOptionalI32" or c_type == "ElisaOptionalI64" or c_type == "ElisaOptionalInt" or c_type == "ElisaOptionalU8" or c_type == "ElisaOptionalU16" or c_type == "ElisaOptionalU32" or c_type == "ElisaOptionalU64" or c_type == "ElisaOptionalUSize" or c_type == "ElisaOptionalBool" or c_type == "ElisaOptionalF32" or c_type == "ElisaOptionalF64" or c_type == "ElisaOptionalSView"


def pymodule_optional_payload_name(type_name: sview) -> sview can[Abort.Panic]:
    "i8" return if type_name == "i8?"
    "i16" return if type_name == "i16?"
    "i32" return if type_name == "i32?"
    "i64" return if type_name == "i64?" or type_name == "char?"
    "int" return if type_name == "int?" or type_name == "isize?"
    "u8" return if type_name == "u8?"
    "u16" return if type_name == "u16?"
    "u32" return if type_name == "u32?"
    "u64" return if type_name == "u64?"
    "usize" return if type_name == "usize?" or type_name == "uintptr?"
    "bool" return if type_name == "bool?"
    "f32" return if type_name == "f32?"
    "f64" return if type_name == "f64?"
    "sview" return if type_name == "sview?"
    return ""


# Keep Python defaults intentionally literal. This covers useful scalar/text cases
# (`limit: i64 = 10`, `enabled: bool = false`, `ratio: f64 = 0.5`, `name: cstr = "guest"`)
# plus empty native containers, whose zero-length representation is unambiguous and does not
# require evaluating arbitrary Elisa code in the CPython shim.
def pymodule_default_literal_supported(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.IntLit(default_int_value):
        return true
    if expression is Expr.FloatLit(default_float_text):
        return true
    if expression is Expr.BoolLit(default_bool_value):
        return true
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return pymodule_default_literal_supported(default_operand) if default_operator == Lexer::TokenKind.Minus
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_literal_supported(default_inner)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        return false if default_arguments.count != 0
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            return false if default_field != "i8" and default_field != "i16" and default_field != "i32" and default_field != "i64" and default_field != "int" and default_field != "isize" and default_field != "char" and default_field != "u8" and default_field != "u16" and default_field != "u32" and default_field != "u64" and default_field != "usize" and default_field != "uintptr" and default_field != "f32" and default_field != "f64"
            return pymodule_default_literal_supported(default_base)
    return false


# String defaults are emitted as the original quoted literal in the generated C shim. Keep the
# accepted escape vocabulary identical to the backend's decoder so a default cannot silently
# acquire different bytes at the Python/C boundary.
def pymodule_default_string_literal_supported(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.StringLit(default_string_text):
        string_length: usize = sview_len(default_string_text)
        scan: mutable usize = 0
        while scan < string_length |scan, default_string_text|:
            if sview_at(default_string_text, scan) == 92:
                return false if scan + 1 >= string_length
                escaped: u8 = sview_at(default_string_text, scan + 1)
                return false if escaped != 110 and escaped != 116 and escaped != 114 and escaped != 48 and escaped != 92 and escaped != 34 and escaped != 39
                scan <- scan + 1
            scan <- scan + 1
        return true
    return false


def emit_pymodule_manifest_default_literal(buffer: mutable darray[u8]&, file: Ast::File&, expression: Ast::Expr, type_name: sview = "") -> void can[Abort.Panic, Memory.Allocate]:
    if pymodule_default_is_null(expression) and pymodule_parameter_is_implicit_optional(type_name):
        emit_tokens_push_sview(buffer, "None")
        return
    enum_value: (found: bool, value: i64) = pymodule_default_enum_value(file, expression)
    if enum_value.found:
        append_decimal_i64(buffer, enum_value.value)
        return
    if expression is Expr.StringLit(default_string_text):
        buffer.push(92)
        buffer.push(34)
        emit_tokens_push_json_string(buffer, default_string_text)
        buffer.push(92)
        buffer.push(34)
        return
    if expression is Expr.Array(default_array_elements, default_array_pos):
        element_type_name: sview = pymodule_darray_element_name(type_name) if pymodule_is_darray_type(type_name) else pymodule_view_element_name(type_name) if pymodule_is_view_type(type_name) else ""
        if type_name == "darray[u8]":
            all_bytes: mutable bool = true
            for default_byte_element in default_array_elements:
                byte_value: (found: bool, value: i64) = pymodule_default_integer_literal_value(default_byte_element)
                all_bytes <- false if not byte_value.found or byte_value.value < 0 or byte_value.value > 255
            if all_bytes:
                buffer.push(98)
                buffer.push(92)
                buffer.push(34)
                for default_byte_index in 0..<default_array_elements.count |buffer, default_array_elements, default_byte_index|:
                    byte_value: (found: bool, value: i64) = pymodule_default_integer_literal_value(default_array_elements[default_byte_index])
                    buffer.push(92)
                    buffer.push(92)
                    buffer.push(120)
                    emit_pymodule_signature_hex(buffer, byte_value.value.u32(), 2)
                buffer.push(92)
                buffer.push(34)
                return
        emit_tokens_push_sview(buffer, "[")
        for default_element_index in 0..<default_array_elements.count |buffer, default_array_elements, default_element_index, element_type_name|:
            emit_tokens_push_sview(buffer, ", ") if default_element_index > 0
            emit_pymodule_manifest_default_literal(buffer, file, default_array_elements[default_element_index], element_type_name)
        emit_tokens_push_sview(buffer, "]")
        return
    if expression is Expr.DictLit(default_dict_entries, default_dict_pos):
        key_type_name: sview = pymodule_dict_key_name(type_name) if pymodule_is_dict_type(type_name) else ""
        value_type_name: sview = pymodule_dict_value_name(type_name) if pymodule_is_dict_type(type_name) else ""
        emit_tokens_push_sview(buffer, "{")
        for default_entry_index in 0..<default_dict_entries.count |buffer, default_dict_entries, default_entry_index, key_type_name, value_type_name|:
            emit_tokens_push_sview(buffer, ", ") if default_entry_index > 0
            emit_pymodule_manifest_default_literal(buffer, file, default_dict_entries[default_entry_index].key, key_type_name)
            emit_tokens_push_sview(buffer, ": ")
            emit_pymodule_manifest_default_literal(buffer, file, default_dict_entries[default_entry_index].value, value_type_name)
        emit_tokens_push_sview(buffer, "}")
        return
    if expression is Expr.SetLit(default_set_elements, default_set_pos):
        if default_set_elements.count == 0:
            emit_tokens_push_sview(buffer, "set()")
            return
        emit_tokens_push_sview(buffer, "{")
        set_element_type_name: sview = pymodule_set_element_name(type_name) if pymodule_is_set_type(type_name) else ""
        for default_set_element_index in 0..<default_set_elements.count |buffer, default_set_elements, default_set_element_index, set_element_type_name|:
            emit_tokens_push_sview(buffer, ", ") if default_set_element_index > 0
            emit_pymodule_manifest_default_literal(buffer, file, default_set_elements[default_set_element_index], set_element_type_name)
        emit_tokens_push_sview(buffer, "}")
        return
    if expression is Expr.Construct(default_construct_type, default_construct_fields, default_construct_pos):
        emit_tokens_push_sview(buffer, "{")
        for default_construct_field_index in 0..<default_construct_fields.count |buffer, file, type_name, default_construct_fields, default_construct_field_index|:
            default_construct_field: Ast::FieldInit = default_construct_fields[default_construct_field_index]
            emit_tokens_push_sview(buffer, ", ") if default_construct_field_index > 0
            buffer.push(92)
            buffer.push(34)
            emit_tokens_push_json_string(buffer, default_construct_field.name)
            buffer.push(92)
            buffer.push(34)
            emit_tokens_push_sview(buffer, ": ")
            construct_field_type_name: sview = pymodule_struct_member_type_name(file, type_name, default_construct_field.name)
            emit_pymodule_manifest_default_literal(buffer, file, default_construct_field.value, construct_field_type_name)
        emit_tokens_push_sview(buffer, "}")
        return
    emit_pymodule_default_signature_literal(buffer, file, expression, type_name)


def pymodule_default_integer_literal_supported(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.IntLit(default_int_value):
        return true
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return pymodule_default_integer_literal_supported(default_operand) if default_operator == Lexer::TokenKind.Minus
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_integer_literal_supported(default_inner)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        return false if default_arguments.count != 0
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            return false if default_field != "i8" and default_field != "i16" and default_field != "i32" and default_field != "i64" and default_field != "int" and default_field != "isize" and default_field != "char" and default_field != "u8" and default_field != "u16" and default_field != "u32" and default_field != "u64" and default_field != "usize" and default_field != "uintptr"
            return pymodule_default_integer_literal_supported(default_base)
    return false


# Resolve a const/plain enum member to the value recorded by the parser.  Enum types erase to
# their scalar backing type at the Python boundary, so a default such as `Mode.Ready` should be
# treated exactly like the integer it compiles to.  The parser metadata is authoritative here:
# it preserves explicit gaps and implicit continuation values, including enums nested in modules.
def pymodule_default_enum_value(file: Ast::File&, expression: Ast::Expr) -> (found: bool, value: i64) can[Abort.Panic, Memory.Allocate]:
    if expression is Expr.Paren(default_enum_inner, default_enum_paren_pos):
        return pymodule_default_enum_value(file, default_enum_inner)
    if expression is Expr.Call(default_enum_callee, default_enum_arguments, default_enum_argument_names, default_enum_call_pos):
        return (false, 0) if default_enum_arguments.count != 0
        if default_enum_callee is Expr.Field(default_enum_base, default_enum_field, default_enum_field_pos):
            # A cast-like suffix (`Mode.Ready.i64()`) does not change the backing value.
            return pymodule_default_enum_value(file, default_enum_base)
        return (false, 0)
    if expression is Expr.Field(default_enum_head, default_enum_variant, default_enum_field_pos):
        enum_name: mutable sview = ""
        if default_enum_head is Expr.Ident(default_enum_ident_name, default_enum_ident_pos):
            enum_name <- default_enum_ident_name
        elif default_enum_head is Expr.Scope(default_enum_scope_head, default_enum_scope_name, default_enum_scope_pos):
            enum_name <- default_enum_scope_name
        if enum_name == "":
            return (false, 0)
        for enum_index in 0..<file.enum_decl_names.count |file, enum_name, default_enum_variant|:
            continue if file.enum_decl_names[enum_index] != enum_name
            variant_start: usize = file.enum_decl_variant_starts[enum_index]
            variant_count: usize = file.enum_decl_variant_counts[enum_index]
            for variant_index in 0..<variant_count |file, variant_start, default_enum_variant|:
                if file.enum_decl_variant_names[variant_start + variant_index] == default_enum_variant:
                    return (true, file.enum_decl_variant_values[variant_start + variant_index])
            return (false, 0)
    return (false, 0)


def pymodule_default_integer_value_supported(file: Ast::File&, type_name: sview, expression: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
    return true if pymodule_default_integer_literal_supported(expression) and pymodule_default_integer_literal_fits(type_name, expression, false)
    enum_value: (found: bool, value: i64) = pymodule_default_enum_value(file, expression)
    return false if not enum_value.found
    return pymodule_default_integer_in_range(type_name, enum_value.value)


def pymodule_default_has_minus(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return true if default_operator == Lexer::TokenKind.Minus
        return pymodule_default_has_minus(default_operand)
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_has_minus(default_inner)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            return pymodule_default_has_minus(default_base)
    return false


def pymodule_default_integer_in_range(type_name: sview, value: i64) -> bool can[Abort.Panic]:
    if type_name == "i8":
        return value >= -128 and value <= 127
    if type_name == "i16":
        return value >= -32768 and value <= 32767
    if type_name == "i32":
        return value >= -2147483648 and value <= 2147483647
    if type_name == "u8":
        return value >= 0 and value <= 255
    if type_name == "u16":
        return value >= 0 and value <= 65535
    if type_name == "u32":
        return value >= 0 and value <= 4294967295
    if type_name == "u64" or type_name == "usize" or type_name == "uintptr":
        return value >= 0
    return true


def pymodule_default_integer_literal_fits(type_name: sview, expression: Ast::Expr, negative: bool) -> bool can[Abort.Panic]:
    if expression is Expr.IntLit(default_int_value):
        return pymodule_default_integer_in_range(type_name, -default_int_value if negative else default_int_value)
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return pymodule_default_integer_literal_fits(type_name, default_operand, not negative) if default_operator == Lexer::TokenKind.Minus
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_integer_literal_fits(type_name, default_inner, negative)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            return pymodule_default_integer_literal_fits(type_name, default_base, negative)
    return false


def pymodule_default_integer_literal_value(expression: Ast::Expr, negative: bool = false) -> (found: bool, value: i64) can[Abort.Panic]:
    if expression is Expr.IntLit(default_int_value):
        return (true, -default_int_value if negative else default_int_value)
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        return pymodule_default_integer_literal_value(default_operand, not negative) if default_operator == Lexer::TokenKind.Minus
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_integer_literal_value(default_inner, negative)
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        return (false, 0) if default_arguments.count != 0
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            return pymodule_default_integer_literal_value(default_base, negative)
    return (false, 0)


def pymodule_default_python_hashable_type(type_name: sview) -> bool can[Abort.Panic]:
    return true if type_name == "cstr" or type_name == "sview" or type_name == "bool" or type_name == "f32" or type_name == "f64" or type_name == "i8" or type_name == "i16" or type_name == "i32" or type_name == "i64" or type_name == "int" or type_name == "isize" or type_name == "char" or type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or type_name == "usize" or type_name == "uintptr"
    return false


def pymodule_default_python_value_supported(file: Ast::File&, type_name: sview, expression: Ast::Expr, depth: usize = 0.usize()) -> bool can[Abort.Panic, Memory.Allocate]:
    # Container defaults are accepted only when every leaf is a literal that the
    # generated Python builder can materialize without evaluating Elisa code.
    # Semantic type checking has already established the element/key/value types;
    # this pass only decides whether the boundary has a safe Python constructor.
    return false if depth > 32.usize()
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_python_value_supported(file, type_name, default_inner, depth)
    return pymodule_parameter_is_implicit_optional(type_name) if pymodule_default_is_null(expression)
    # Nullable leaves use the same Python literal as their contained value.  Keep the
    # null case above, then recurse through the optional ABI spelling so aggregate
    # defaults such as `[1, null]` and `{"missing": null}` are accepted without
    # duplicating every scalar branch for every `T?` type.
    if type_name == "cstr?":
        return pymodule_default_string_literal_supported(expression)
    if pymodule_is_optional_scalar_type(type_name):
        optional_leaf_type_name: sview = pymodule_optional_payload_name(type_name)
        return false if optional_leaf_type_name == ""
        return pymodule_default_python_value_supported(file, optional_leaf_type_name, expression, depth)
    if type_name == "cstr" or type_name == "sview":
        return pymodule_default_string_literal_supported(expression)
    if type_name == "bool":
        return expression is Expr.BoolLit(_)
    if type_name == "f32" or type_name == "f64":
        return pymodule_default_literal_supported(expression) and not expression is Expr.BoolLit(_)
    if type_name == "i8" or type_name == "i16" or type_name == "i32" or type_name == "i64" or type_name == "int" or type_name == "isize" or type_name == "char":
        return pymodule_default_integer_value_supported(file, type_name, expression)
    if type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or type_name == "usize" or type_name == "uintptr":
        return pymodule_default_integer_value_supported(file, type_name, expression) and not pymodule_default_has_minus(expression)
    if pymodule_is_darray_type(type_name):
        if expression is Expr.Array(default_elements, default_array_pos):
            element_type_name: sview = pymodule_darray_element_name(type_name)
            return false if element_type_name == ""
            for default_element in default_elements:
                return false if not pymodule_default_python_value_supported(file, element_type_name, default_element, depth + 1.usize())
            return true
    if pymodule_is_view_type(type_name):
        if expression is Expr.Array(default_view_elements, default_view_pos):
            view_element_type_name: sview = pymodule_view_element_name(type_name)
            return false if view_element_type_name == ""
            for default_view_element in default_view_elements:
                return false if not pymodule_default_python_value_supported(file, view_element_type_name, default_view_element, depth + 1.usize())
            return true
    if pymodule_is_dict_type(type_name):
        if expression is Expr.DictLit(default_entries, default_dict_pos):
            key_type_name: sview = pymodule_dict_key_name(type_name)
            value_type_name: sview = pymodule_dict_value_name(type_name)
            return false if key_type_name == "" or value_type_name == ""
            return false if not pymodule_default_python_hashable_type(key_type_name)
            for default_entry in default_entries:
                return false if not pymodule_default_python_value_supported(file, key_type_name, default_entry.key, depth + 1.usize())
                return false if not pymodule_default_python_value_supported(file, value_type_name, default_entry.value, depth + 1.usize())
            return true
    if pymodule_is_set_type(type_name):
        if expression is Expr.SetLit(default_set_elements, default_set_pos):
            set_element_type_name: sview = pymodule_set_element_name(type_name)
            return false if set_element_type_name == ""
            return false if not pymodule_default_python_hashable_type(set_element_type_name)
            for default_set_element in default_set_elements:
                return false if not pymodule_default_python_value_supported(file, set_element_type_name, default_set_element, depth + 1.usize())
            return true
        if expression is Expr.DictLit(default_set_entries, default_set_dict_pos):
            return default_set_entries.count == 0
    declaration: Ast::Decl? = pymodule_find_struct_in(file.top_decls, type_name)
    if declaration is target:
        if target is Decl.Struct(default_struct_name, default_struct_members, default_struct_affinity, default_struct_named_states, default_struct_derive, default_struct_invariants, default_struct_pos):
            if expression is Expr.Construct(default_construct_type, default_construct_fields, default_construct_pos):
                return false if pymodule_bare_type_name(default_construct_type) != type_name
                for default_construct_field in default_construct_fields |file, depth, type_name|:
                    return false if default_construct_field.name == ""
                    construct_field_type_name: sview = pymodule_struct_member_type_name(file, type_name, default_construct_field.name)
                    return false if construct_field_type_name == ""
                    return false if not pymodule_default_supported(file, construct_field_type_name, default_construct_field.value)
                return true
    return false


def pymodule_default_supported(file: Ast::File&, type_name: sview, expression: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
    if expression is Expr.Paren(default_inner, default_paren_pos):
        return pymodule_default_supported(file, type_name, default_inner)
    return pymodule_parameter_is_implicit_optional(type_name) if pymodule_default_is_null(expression)
    if type_name == "cstr" or type_name == "sview":
        return pymodule_default_string_literal_supported(expression)
    if type_name == "bool":
        return expression is Expr.BoolLit(_)
    if type_name == "f32" or type_name == "f64":
        return pymodule_default_literal_supported(expression) and not expression is Expr.BoolLit(_)
    if type_name == "i8" or type_name == "i16" or type_name == "i32" or type_name == "i64" or type_name == "int" or type_name == "isize" or type_name == "char":
        return pymodule_default_integer_value_supported(file, type_name, expression)
    if type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or type_name == "usize" or type_name == "uintptr":
        return pymodule_default_integer_value_supported(file, type_name, expression) and not pymodule_default_has_minus(expression)
    if pymodule_is_darray_type(type_name) or pymodule_is_view_type(type_name) or pymodule_is_dict_type(type_name) or pymodule_is_set_type(type_name):
        return pymodule_default_python_value_supported(file, type_name, expression)
    return pymodule_default_python_value_supported(file, type_name, expression)


# Struct fields use the same literal policy as function parameters. Aggregate defaults are first
# materialized as fresh Python objects and then sent through the ordinary field converter, keeping
# nested text/object retention and arena ownership identical to explicitly supplied values.
def pymodule_struct_default_supported(file: Ast::File&, type_name: sview, expression: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
    return pymodule_default_supported(file, type_name, expression)


def pymodule_default_is_empty_container(expression: Ast::Expr) -> bool can[Abort.Panic]:
    if expression is Expr.Array(default_elements, default_array_pos):
        return default_elements.count == 0
    if expression is Expr.DictLit(default_entries, default_dict_pos):
        return default_entries.count == 0
    if expression is Expr.SetLit(default_set_elements, default_set_pos):
        return default_set_elements.count == 0
    return false


def pymodule_default_is_container(expression: Ast::Expr) -> bool can[Abort.Panic]:
    return expression is Expr.Array(_, _) or expression is Expr.DictLit(_, _) or expression is Expr.SetLit(_, _) or expression is Expr.Construct(_, _, _)


def emit_pymodule_default_builder_symbol(buffer: mutable darray[u8]&, module_name: sview, function_name: sview, parameter_index: usize) -> void can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(buffer, "elisa_pymodule_")
    emit_tokens_push_sview(buffer, module_name)
    emit_tokens_push_sview(buffer, "_")
    emit_tokens_push_sview(buffer, function_name)
    emit_tokens_push_sview(buffer, "_default_")
    append_decimal(buffer, parameter_index.i64())


def emit_pymodule_struct_default_builder_symbol(buffer: mutable darray[u8]&, struct_type_name: sview, field_name: sview) -> void can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(buffer, "elisa_pymodule_struct_")
    emit_tokens_push_sview(buffer, struct_type_name)
    emit_tokens_push_sview(buffer, "_")
    emit_tokens_push_sview(buffer, pymodule_struct_c_field_name(field_name))
    emit_tokens_push_sview(buffer, "_default")


def emit_pymodule_default_python_scalar(buffer: mutable darray[u8]&, file: Ast::File&, type_name: sview, expression: Ast::Expr) -> void can[Abort.Panic, Memory.Allocate]:
    if pymodule_default_is_null(expression):
        # This helper is used as an initializer expression inside a container
        # builder, so retain the singleton and return it through the comma
        # operator rather than emitting a statement-level `return`.
        emit_tokens_push_sview(buffer, "(Py_INCREF(Py_None), Py_None)")
        return
    # Non-null optional leaves use the contained scalar's Python representation;
    # null itself returned above as `None`. This keeps nested defaults aligned with
    # the ordinary optional argument conversion rules.
    scalar_type_name: mutable sview = type_name
    scalar_type_name <- "cstr" if type_name == "cstr?"
    scalar_type_name <- "sview" if type_name == "sview?"
    scalar_type_name <- pymodule_optional_payload_name(type_name) if pymodule_is_optional_scalar_type(type_name)
    if scalar_type_name == "bool":
        emit_tokens_push_sview(buffer, "PyBool_FromLong((long)(")
        emit_pymodule_default_literal(buffer, file, expression)
        emit_tokens_push_sview(buffer, "))")
        return
    if scalar_type_name == "f32" or scalar_type_name == "f64":
        emit_tokens_push_sview(buffer, "PyFloat_FromDouble((double)(")
        emit_pymodule_default_literal(buffer, file, expression)
        emit_tokens_push_sview(buffer, "))")
        return
    if scalar_type_name == "u8" or scalar_type_name == "u16" or scalar_type_name == "u32" or scalar_type_name == "u64" or scalar_type_name == "usize" or scalar_type_name == "uintptr":
        emit_tokens_push_sview(buffer, "PyLong_FromUnsignedLongLong((unsigned long long)(")
        emit_pymodule_default_literal(buffer, file, expression)
        emit_tokens_push_sview(buffer, "))")
        return
    if scalar_type_name == "cstr" or scalar_type_name == "sview":
        emit_tokens_push_sview(buffer, "PyUnicode_FromStringAndSize(")
        emit_pymodule_default_literal(buffer, file, expression)
        emit_tokens_push_sview(buffer, ", (Py_ssize_t)(sizeof(")
        emit_pymodule_default_literal(buffer, file, expression)
        emit_tokens_push_sview(buffer, ") - 1))")
        return
    emit_tokens_push_sview(buffer, "PyLong_FromLongLong((long long)(")
    emit_pymodule_default_literal(buffer, file, expression)
    emit_tokens_push_sview(buffer, "))")


def pymodule_default_builder_child_name(storage: mutable darray[u8]&, parent_name: sview, suffix: sview, index: usize) -> sview can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(storage, parent_name)
    emit_tokens_push_sview(storage, suffix)
    append_decimal(storage, index.i64())
    return sview(&storage[0], 0, storage.count)


def pymodule_default_builder_field_name(storage: mutable darray[u8]&, parent_name: sview, field_name: sview) -> sview can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(storage, parent_name)
    emit_tokens_push_sview(storage, "_field_")
    emit_tokens_push_sview(storage, pymodule_struct_c_field_name(field_name))
    return sview(&storage[0], 0, storage.count)


def emit_pymodule_default_python_builder(buffer: mutable darray[u8]&, file: Ast::File&, builder_name: sview, type_name: sview, expression: Ast::Expr) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    # Emit nested builders first so every call site sees a complete static function
    # declaration without relying on C99 implicit declarations.
    if expression is Expr.Paren(default_inner, default_paren_pos):
        emit_pymodule_default_python_builder(buffer, file, builder_name, type_name, default_inner)
        return
    if pymodule_is_darray_type(type_name) or pymodule_is_view_type(type_name):
        element_type_name: sview = pymodule_darray_element_name(type_name) if pymodule_is_darray_type(type_name) else pymodule_view_element_name(type_name)
        if expression is Expr.Array(default_elements, default_array_pos):
            for default_element_index in 0..<default_elements.count |buffer, file, builder_name, element_type_name, default_elements, default_element_index|:
                if pymodule_default_is_container(default_elements[default_element_index]):
                    child_name_storage: mutable darray[u8] = []
                    child_name: sview = pymodule_default_builder_child_name(&child_name_storage, builder_name, "_item", default_element_index)
                    emit_pymodule_default_python_builder(buffer, file, child_name, element_type_name, default_elements[default_element_index])
    elif pymodule_is_dict_type(type_name):
        key_type_name: sview = pymodule_dict_key_name(type_name)
        value_type_name: sview = pymodule_dict_value_name(type_name)
        if expression is Expr.DictLit(default_entries, default_dict_pos):
            for default_entry_index in 0..<default_entries.count |buffer, file, builder_name, key_type_name, value_type_name, default_entries, default_entry_index|:
                if pymodule_default_is_container(default_entries[default_entry_index].key):
                    key_name_storage: mutable darray[u8] = []
                    key_name: sview = pymodule_default_builder_child_name(&key_name_storage, builder_name, "_key", default_entry_index)
                    emit_pymodule_default_python_builder(buffer, file, key_name, key_type_name, default_entries[default_entry_index].key)
                if pymodule_default_is_container(default_entries[default_entry_index].value):
                    value_name_storage: mutable darray[u8] = []
                    value_name: sview = pymodule_default_builder_child_name(&value_name_storage, builder_name, "_value", default_entry_index)
                    emit_pymodule_default_python_builder(buffer, file, value_name, value_type_name, default_entries[default_entry_index].value)
    elif pymodule_is_set_type(type_name):
        element_type_name: sview = pymodule_set_element_name(type_name)
        if expression is Expr.SetLit(default_set_elements, default_set_pos):
            for default_set_element_index in 0..<default_set_elements.count |buffer, file, builder_name, element_type_name, default_set_elements, default_set_element_index|:
                if pymodule_default_is_container(default_set_elements[default_set_element_index]):
                    child_name_storage: mutable darray[u8] = []
                    child_name: sview = pymodule_default_builder_child_name(&child_name_storage, builder_name, "_item", default_set_element_index)
                    emit_pymodule_default_python_builder(buffer, file, child_name, element_type_name, default_set_elements[default_set_element_index])
    else:
        declaration: Ast::Decl? = pymodule_find_struct_in(file.top_decls, type_name)
        if declaration is target:
            if target is Decl.Struct(default_struct_name, default_struct_members, default_struct_affinity, default_struct_named_states, default_struct_derive, default_struct_invariants, default_struct_pos):
                if expression is Expr.Construct(default_construct_type, default_construct_fields, default_construct_pos):
                    for default_construct_field in default_construct_fields |buffer, file, builder_name, type_name|:
                        if default_construct_field.name != "":
                            construct_field_type_name: sview = pymodule_struct_member_type_name(file, type_name, default_construct_field.name)
                            if pymodule_default_is_container(default_construct_field.value):
                                child_name_storage: mutable darray[u8] = []
                                child_name: sview = pymodule_default_builder_field_name(&child_name_storage, builder_name, default_construct_field.name)
                                emit_pymodule_default_python_builder(buffer, file, child_name, construct_field_type_name, default_construct_field.value)
    emit_tokens_push_sview(buffer, "static PyObject *")
    emit_tokens_push_sview(buffer, builder_name)
    emit_tokens_push_sview(buffer, "(void) {\n")
    if pymodule_is_darray_type(type_name) or pymodule_is_view_type(type_name):
        element_type_name: sview = pymodule_darray_element_name(type_name) if pymodule_is_darray_type(type_name) else pymodule_view_element_name(type_name)
        if expression is Expr.Array(default_elements_for_emit, default_array_pos_for_emit):
            emit_tokens_push_sview(buffer, "    PyObject *out = PyList_New(")
            append_decimal(buffer, default_elements_for_emit.count.i64())
            emit_tokens_push_sview(buffer, "); if (out == NULL) return NULL;\n")
            for default_element_index_for_emit in 0..<default_elements_for_emit.count |buffer, builder_name, element_type_name, default_elements_for_emit, default_element_index_for_emit|:
                emit_tokens_push_sview(buffer, "    PyObject *item")
                append_decimal(buffer, default_element_index_for_emit.i64())
                emit_tokens_push_sview(buffer, " = ")
                if pymodule_default_is_container(default_elements_for_emit[default_element_index_for_emit]):
                    child_name_storage_for_emit: mutable darray[u8] = []
                    child_name_for_emit: sview = pymodule_default_builder_child_name(&child_name_storage_for_emit, builder_name, "_item", default_element_index_for_emit)
                    emit_tokens_push_sview(buffer, child_name_for_emit)
                    emit_tokens_push_sview(buffer, "()")
                else:
                    emit_pymodule_default_python_scalar(buffer, file, element_type_name, default_elements_for_emit[default_element_index_for_emit])
                emit_tokens_push_sview(buffer, "; if (item")
                append_decimal(buffer, default_element_index_for_emit.i64())
                emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(out); return NULL; } PyList_SET_ITEM(out, ")
                append_decimal(buffer, default_element_index_for_emit.i64())
                emit_tokens_push_sview(buffer, ", item")
                append_decimal(buffer, default_element_index_for_emit.i64())
                emit_tokens_push_sview(buffer, ");\n")
            if type_name == "darray[u8]":
                emit_tokens_push_sview(buffer, "    PyObject *bytes = PyBytes_FromObject(out); Py_DECREF(out); return bytes;\n")
            else:
                emit_tokens_push_sview(buffer, "    return out;\n")
    elif pymodule_is_dict_type(type_name):
        key_type_name: sview = pymodule_dict_key_name(type_name)
        value_type_name: sview = pymodule_dict_value_name(type_name)
        if expression is Expr.DictLit(default_entries_for_emit, default_dict_pos_for_emit):
            emit_tokens_push_sview(buffer, "    PyObject *out = PyDict_New(); if (out == NULL) return NULL;\n")
            for default_entry_index_for_emit in 0..<default_entries_for_emit.count |buffer, builder_name, key_type_name, value_type_name, default_entries_for_emit, default_entry_index_for_emit|:
                emit_tokens_push_sview(buffer, "    PyObject *key")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, " = ")
                if pymodule_default_is_container(default_entries_for_emit[default_entry_index_for_emit].key):
                    key_name_storage_for_emit: mutable darray[u8] = []
                    key_name_for_emit: sview = pymodule_default_builder_child_name(&key_name_storage_for_emit, builder_name, "_key", default_entry_index_for_emit)
                    emit_tokens_push_sview(buffer, key_name_for_emit)
                    emit_tokens_push_sview(buffer, "()")
                else:
                    emit_pymodule_default_python_scalar(buffer, file, key_type_name, default_entries_for_emit[default_entry_index_for_emit].key)
                emit_tokens_push_sview(buffer, "; if (key")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(out); return NULL; }\n    PyObject *value")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, " = ")
                if pymodule_default_is_container(default_entries_for_emit[default_entry_index_for_emit].value):
                    value_name_storage_for_emit: mutable darray[u8] = []
                    value_name_for_emit: sview = pymodule_default_builder_child_name(&value_name_storage_for_emit, builder_name, "_value", default_entry_index_for_emit)
                    emit_tokens_push_sview(buffer, value_name_for_emit)
                    emit_tokens_push_sview(buffer, "()")
                else:
                    emit_pymodule_default_python_scalar(buffer, file, value_type_name, default_entries_for_emit[default_entry_index_for_emit].value)
                emit_tokens_push_sview(buffer, "; if (value")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(key")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, "); Py_DECREF(out); return NULL; } if (PyDict_SetItem(out, key")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, ", value")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, ") < 0) { Py_DECREF(key")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, "); Py_DECREF(value")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, "); Py_DECREF(out); return NULL; } Py_DECREF(key")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, "); Py_DECREF(value")
                append_decimal(buffer, default_entry_index_for_emit.i64())
                emit_tokens_push_sview(buffer, ");\n")
            emit_tokens_push_sview(buffer, "    return out;\n")
    elif pymodule_is_set_type(type_name):
        element_type_name: sview = pymodule_set_element_name(type_name)
        if expression is Expr.SetLit(default_set_elements_for_emit, default_set_pos_for_emit):
            emit_tokens_push_sview(buffer, "    PyObject *out = PySet_New(NULL); if (out == NULL) return NULL;\n")
            for default_set_element_index_for_emit in 0..<default_set_elements_for_emit.count |buffer, builder_name, element_type_name, default_set_elements_for_emit, default_set_element_index_for_emit|:
                emit_tokens_push_sview(buffer, "    PyObject *item")
                append_decimal(buffer, default_set_element_index_for_emit.i64())
                emit_tokens_push_sview(buffer, " = ")
                if pymodule_default_is_container(default_set_elements_for_emit[default_set_element_index_for_emit]):
                    child_name_storage_for_emit: mutable darray[u8] = []
                    child_name_for_emit: sview = pymodule_default_builder_child_name(&child_name_storage_for_emit, builder_name, "_item", default_set_element_index_for_emit)
                    emit_tokens_push_sview(buffer, child_name_for_emit)
                    emit_tokens_push_sview(buffer, "()")
                else:
                    emit_pymodule_default_python_scalar(buffer, file, element_type_name, default_set_elements_for_emit[default_set_element_index_for_emit])
                emit_tokens_push_sview(buffer, "; if (item")
                append_decimal(buffer, default_set_element_index_for_emit.i64())
                emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(out); return NULL; } if (PySet_Add(out, item")
                append_decimal(buffer, default_set_element_index_for_emit.i64())
                emit_tokens_push_sview(buffer, ") < 0) { Py_DECREF(item")
                append_decimal(buffer, default_set_element_index_for_emit.i64())
                emit_tokens_push_sview(buffer, "); Py_DECREF(out); return NULL; } Py_DECREF(item")
                append_decimal(buffer, default_set_element_index_for_emit.i64())
                emit_tokens_push_sview(buffer, ");\n")
            emit_tokens_push_sview(buffer, "    return out;\n")
    else:
        declaration_for_emit: Ast::Decl? = pymodule_find_struct_in(file.top_decls, type_name)
        if declaration_for_emit is target_struct_for_emit:
            if target_struct_for_emit is Decl.Struct(default_struct_name_for_emit, default_struct_members_for_emit, default_struct_affinity_for_emit, default_struct_named_states_for_emit, default_struct_derive_for_emit, default_struct_invariants_for_emit, default_struct_pos_for_emit):
                if expression is Expr.Construct(default_construct_type_for_emit, default_construct_fields_for_emit, default_construct_pos_for_emit):
                    emit_tokens_push_sview(buffer, "    PyObject *out = PyDict_New(); if (out == NULL) return NULL;\n")
                    for default_construct_field_index_for_emit in 0..<default_construct_fields_for_emit.count |buffer, file, builder_name, type_name, default_construct_fields_for_emit, default_construct_field_index_for_emit|:
                        default_construct_field_for_emit: Ast::FieldInit = default_construct_fields_for_emit[default_construct_field_index_for_emit]
                        construct_field_type_name_for_emit: sview = pymodule_struct_member_type_name(file, type_name, default_construct_field_for_emit.name)
                        emit_tokens_push_sview(buffer, "    PyObject *field")
                        append_decimal(buffer, default_construct_field_index_for_emit.i64())
                        emit_tokens_push_sview(buffer, " = ")
                        if pymodule_default_is_container(default_construct_field_for_emit.value):
                            child_name_storage_for_emit: mutable darray[u8] = []
                            child_name_for_emit: sview = pymodule_default_builder_field_name(&child_name_storage_for_emit, builder_name, default_construct_field_for_emit.name)
                            emit_tokens_push_sview(buffer, child_name_for_emit)
                            emit_tokens_push_sview(buffer, "()")
                        else:
                            emit_pymodule_default_python_scalar(buffer, file, construct_field_type_name_for_emit, default_construct_field_for_emit.value)
                        emit_tokens_push_sview(buffer, "; if (field")
                        append_decimal(buffer, default_construct_field_index_for_emit.i64())
                        emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(out); return NULL; } if (PyDict_SetItemString(out, \"")
                        emit_tokens_push_json_string(buffer, default_construct_field_for_emit.name)
                        emit_tokens_push_sview(buffer, "\", field")
                        append_decimal(buffer, default_construct_field_index_for_emit.i64())
                        emit_tokens_push_sview(buffer, ") < 0) { Py_DECREF(field")
                        append_decimal(buffer, default_construct_field_index_for_emit.i64())
                        emit_tokens_push_sview(buffer, "); Py_DECREF(out); return NULL; } Py_DECREF(field")
                        append_decimal(buffer, default_construct_field_index_for_emit.i64())
                        emit_tokens_push_sview(buffer, ");\n")
                    emit_tokens_push_sview(buffer, "    return out;\n")
    emit_tokens_push_sview(buffer, "}\n\n")


def emit_pymodule_default_literal(buffer: mutable darray[u8]&, file: Ast::File&, expression: Ast::Expr) -> void can[Abort.Panic, Memory.Allocate]:
    enum_value: (found: bool, value: i64) = pymodule_default_enum_value(file, expression)
    if enum_value.found:
        append_decimal_i64(buffer, enum_value.value)
        return
    if expression is Expr.StringLit(default_string_text):
        buffer.push(34)
        emit_tokens_push_sview(buffer, default_string_text)
        buffer.push(34)
        return
    if expression is Expr.IntLit(default_int_value):
        append_decimal_i64(buffer, default_int_value)
        return
    if expression is Expr.FloatLit(default_float_text):
        float_stop: mutable usize = sview_len(default_float_text)
        if float_stop >= 3 and sview_at(default_float_text, float_stop - 3) == 102 and sview_at(default_float_text, float_stop - 2) == 51 and (sview_at(default_float_text, float_stop - 1) == 50 or sview_at(default_float_text, float_stop - 1) == 52):
            float_stop <- float_stop - 3
        for float_index in 0..<float_stop |buffer, default_float_text|:
            buffer.push(sview_at(default_float_text, float_index))
        return
    if expression is Expr.BoolLit(default_bool_value):
        emit_tokens_push_sview(buffer, "1" if default_bool_value else "0")
        return
    if expression is Expr.Unary(default_operator, default_operand, default_unary_pos):
        buffer.push(45) if default_operator == Lexer::TokenKind.Minus
        emit_pymodule_default_literal(buffer, file, default_operand)
        return
    if expression is Expr.Paren(default_inner, default_paren_pos):
        buffer.push(40)
        emit_pymodule_default_literal(buffer, file, default_inner)
        buffer.push(41)
        return
    if expression is Expr.Call(default_callee, default_arguments, default_argument_names, default_call_pos):
        if default_callee is Expr.Field(default_base, default_field, default_field_pos):
            emit_pymodule_default_literal(buffer, file, default_base)


def emit_pymodule_signature_hex(buffer: mutable darray[u8]&, value: u32, width: usize) -> void can[Abort.Panic, Memory.Allocate]:
    divisor: mutable u32 = 1
    for _ in 0..<width - 1 |divisor|:
        divisor <- divisor * 16
    for _ in 0..<width |buffer, divisor, value|:
        digit: u32 = (value / divisor) % 16
        buffer.push((48 + digit).u8()) if digit < 10
        buffer.push((87 + digit).u8()) if digit >= 10
        divisor <- divisor / 16


def emit_pymodule_default_signature_literal(buffer: mutable darray[u8]&, file: Ast::File&, expression: Ast::Expr, type_name: sview = "") -> void can[Abort.Panic, Memory.Allocate]:
    if expression is Expr.Paren(default_inner, default_paren_pos):
        emit_pymodule_default_signature_literal(buffer, file, default_inner, type_name)
        return
    if pymodule_default_is_null(expression) and pymodule_parameter_is_implicit_optional(type_name):
        emit_tokens_push_sview(buffer, "None")
        return
    enum_value: (found: bool, value: i64) = pymodule_default_enum_value(file, expression)
    if enum_value.found:
        append_decimal_i64(buffer, enum_value.value)
        return
    if expression is Expr.BoolLit(default_bool_value):
        emit_tokens_push_sview(buffer, "True" if default_bool_value else "False")
        return
    if expression is Expr.StringLit(default_string_text):
        buffer.push(92)
        buffer.push(34)
        signature_index: mutable usize = 0
        while signature_index < sview_len(default_string_text) |signature_index, buffer, default_string_text|:
            signature_byte: u8 = sview_at(default_string_text, signature_index)
            if signature_byte < 128:
                buffer.push(92) if signature_byte == 92 or signature_byte == 34
                buffer.push(signature_byte)
            elif signature_byte >= 194 and signature_byte <= 223 and signature_index + 1 < sview_len(default_string_text):
                codepoint: u32 = ((signature_byte - 192).u32() * 64) + (sview_at(default_string_text, signature_index + 1) - 128).u32()
                buffer.push(92)
                buffer.push(92)
                buffer.push(117)
                emit_pymodule_signature_hex(buffer, codepoint, 4)
                signature_index <- signature_index + 1
            elif signature_byte >= 224 and signature_byte <= 239 and signature_index + 2 < sview_len(default_string_text):
                codepoint: u32 = ((signature_byte - 224).u32() * 4096) + ((sview_at(default_string_text, signature_index + 1) - 128).u32() * 64) + (sview_at(default_string_text, signature_index + 2) - 128).u32()
                buffer.push(92)
                buffer.push(92)
                buffer.push(117)
                emit_pymodule_signature_hex(buffer, codepoint, 4)
                signature_index <- signature_index + 2
            elif signature_byte >= 240 and signature_byte <= 244 and signature_index + 3 < sview_len(default_string_text):
                codepoint: u32 = ((signature_byte - 240).u32() * 262144) + ((sview_at(default_string_text, signature_index + 1) - 128).u32() * 4096) + ((sview_at(default_string_text, signature_index + 2) - 128).u32() * 64) + (sview_at(default_string_text, signature_index + 3) - 128).u32()
                buffer.push(92)
                buffer.push(92)
                buffer.push(85)
                emit_pymodule_signature_hex(buffer, codepoint, 8)
                signature_index <- signature_index + 3
            else:
                buffer.push(63)
            signature_index <- signature_index + 1
        buffer.push(92)
        buffer.push(34)
        return
    if expression is Expr.Array(default_elements, default_array_pos):
        if type_name == "darray[u8]":
            all_bytes: mutable bool = true
            for default_byte_element in default_elements:
                byte_value: (found: bool, value: i64) = pymodule_default_integer_literal_value(default_byte_element)
                all_bytes <- false if not byte_value.found or byte_value.value < 0 or byte_value.value > 255
            if all_bytes:
                buffer.push(98)
                buffer.push(92)
                buffer.push(34)
                for default_byte_index in 0..<default_elements.count |buffer, default_elements, default_byte_index|:
                    byte_value: (found: bool, value: i64) = pymodule_default_integer_literal_value(default_elements[default_byte_index])
                    buffer.push(92)
                    buffer.push(92)
                    buffer.push(120)
                    emit_pymodule_signature_hex(buffer, byte_value.value.u32(), 2)
                buffer.push(92)
                buffer.push(34)
                return
        emit_tokens_push_sview(buffer, "[")
        element_type_name: sview = pymodule_darray_element_name(type_name) if pymodule_is_darray_type(type_name) else pymodule_view_element_name(type_name) if pymodule_is_view_type(type_name) else ""
        for default_element_index in 0..<default_elements.count |buffer, default_elements, default_element_index, element_type_name|:
            emit_tokens_push_sview(buffer, ", ") if default_element_index > 0
            emit_pymodule_default_signature_literal(buffer, file, default_elements[default_element_index], element_type_name)
        emit_tokens_push_sview(buffer, "]")
        return
    if expression is Expr.DictLit(default_entries, default_dict_pos):
        key_type_name: sview = pymodule_dict_key_name(type_name) if pymodule_is_dict_type(type_name) else ""
        value_type_name: sview = pymodule_dict_value_name(type_name) if pymodule_is_dict_type(type_name) else ""
        emit_tokens_push_sview(buffer, "{")
        for default_entry_index in 0..<default_entries.count |buffer, default_entries, default_entry_index, key_type_name, value_type_name|:
            emit_tokens_push_sview(buffer, ", ") if default_entry_index > 0
            emit_pymodule_default_signature_literal(buffer, file, default_entries[default_entry_index].key, key_type_name)
            emit_tokens_push_sview(buffer, ": ")
            emit_pymodule_default_signature_literal(buffer, file, default_entries[default_entry_index].value, value_type_name)
        emit_tokens_push_sview(buffer, "}")
        return
    if expression is Expr.SetLit(default_set_elements, default_set_pos):
        if default_set_elements.count == 0:
            emit_tokens_push_sview(buffer, "set()")
            return
        emit_tokens_push_sview(buffer, "{")
        element_type_name: sview = pymodule_set_element_name(type_name) if pymodule_is_set_type(type_name) else ""
        for default_set_element_index in 0..<default_set_elements.count |buffer, default_set_elements, default_set_element_index, element_type_name|:
            emit_tokens_push_sview(buffer, ", ") if default_set_element_index > 0
            emit_pymodule_default_signature_literal(buffer, file, default_set_elements[default_set_element_index], element_type_name)
        emit_tokens_push_sview(buffer, "}")
        return
    if expression is Expr.Construct(default_construct_type, default_construct_fields, default_construct_pos):
        emit_tokens_push_sview(buffer, "{")
        for default_construct_field_index in 0..<default_construct_fields.count |buffer, file, type_name, default_construct_fields, default_construct_field_index|:
            default_construct_field: Ast::FieldInit = default_construct_fields[default_construct_field_index]
            emit_tokens_push_sview(buffer, ", ") if default_construct_field_index > 0
            buffer.push(92)
            buffer.push(34)
            emit_tokens_push_json_string(buffer, default_construct_field.name)
            buffer.push(92)
            buffer.push(34)
            emit_tokens_push_sview(buffer, ": ")
            construct_field_type_name: sview = pymodule_struct_member_type_name(file, type_name, default_construct_field.name)
            emit_pymodule_default_signature_literal(buffer, file, default_construct_field.value, construct_field_type_name)
        emit_tokens_push_sview(buffer, "}")
        return
    emit_pymodule_default_literal(buffer, file, expression)


def pymodule_function_is_error(file: Ast::File&, name: sview) -> bool can[Abort.Panic]:
    for annotation in file.enum_annotations |name|:
        true return if annotation.owner == name and annotation.name == "__error_return"
    return false


def pymodule_error_set_has_payload_in(declarations: darray[Ast::Decl]&, wanted: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |wanted|:
        if declaration is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            if error_name == wanted:
                for variant in error_variants:
                    true return if variant.fields.count > 0
                return false
        if declaration is Decl.Module(error_module_name, error_module_body, error_module_pos):
            true return if pymodule_error_set_has_payload_in(error_module_body, wanted)
        if declaration is Decl.Scoped(error_scope_body, error_scope_pos):
            true return if pymodule_error_set_has_payload_in(error_scope_body, wanted)
    return false


# Return the source spelling of the sole payload field when an error set has exactly one field
# across all variants. The Python C shim carries that field through one explicit pointer;
# structured scalar/text/object sets use the separate native-union mapping below.
def pymodule_error_payload_type_in(file: Ast::File&, declarations: darray[Ast::Decl]&, wanted: sview) -> sview can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |wanted|:
        if declaration is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            if error_name == wanted:
                field_total: mutable usize = 0
                payload_name: mutable sview = ""
                for variant in error_variants |field_total, payload_name|:
                    field_total <- field_total + variant.fields.count
                    if variant.fields.count == 1:
                        payload_name <- pymodule_alias_type_name(file, variant.fields[0])
                return payload_name if field_total == 1
                return ""
        if declaration is Decl.Module(error_module_name, error_module_body, error_module_pos):
            nested: sview = pymodule_error_payload_type_in(file, error_module_body, wanted)
            return nested if nested != ""
        if declaration is Decl.Scoped(error_scope_body, error_scope_pos):
            nested_scoped: sview = pymodule_error_payload_type_in(file, error_scope_body, wanted)
            return nested_scoped if nested_scoped != ""
    return ""


def pymodule_error_payload_supported(file: Ast::File&, type_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if pymodule_unsupported_dict_key_in_type(file, type_name) != ""
    return false if pymodule_unsupported_set_element_in_type(file, type_name) != ""
    # Dictionary payloads use the same native bucket copier as ordinary dictionary returns. The
    # error wrapper copies the mapping before releasing the caller-owned arena, so this is safe for
    # every dictionary value family already accepted by the Python bridge.
    return pymodule_nested_dict_values_supported_in_type(file, type_name, 0.usize()) if pymodule_is_dict_type(type_name)
    if pymodule_is_set_type(type_name):
        return pymodule_set_element_supported(pymodule_set_element_name(type_name))
    if pymodule_is_darray_type(type_name):
        element_name: sview = pymodule_darray_element_name(type_name)
        return pymodule_nested_dict_values_supported_in_type(file, element_name, 0.usize()) if pymodule_is_dict_type(element_name)
        return true if pymodule_is_set_type(element_name) and pymodule_set_element_supported(pymodule_set_element_name(element_name))
        return true if pymodule_darray_nesting_depth(type_name) == 1.usize() and pymodule_struct_return_supported(file, element_name)
        return true if pymodule_error_nested_darray_supported(type_name)
        return true if pymodule_darray_is_bytes(type_name)
        return true if element_name == "i8" or element_name == "i16" or element_name == "i32" or element_name == "i64" or element_name == "int" or element_name == "isize" or element_name == "char" or element_name == "u16" or element_name == "u32" or element_name == "u64" or element_name == "usize" or element_name == "uintptr" or element_name == "f32" or element_name == "f64" or element_name == "bool" or element_name == "cstr" or element_name == "cstr?" or element_name == "sview" or element_name == "sview?" or element_name == "py::Object" or element_name == "py::Object?" or pymodule_darray_element_is_optional_scalar(element_name)
        return false
    if pymodule_is_view_type(type_name):
        element_name_view: sview = pymodule_view_element_name(type_name)
        return true if pymodule_struct_return_supported(file, element_name_view)
        return true if element_name_view == "u8" or element_name_view == "i8" or element_name_view == "i16" or element_name_view == "i32" or element_name_view == "i64" or element_name_view == "int" or element_name_view == "isize" or element_name_view == "char" or element_name_view == "u16" or element_name_view == "u32" or element_name_view == "u64" or element_name_view == "usize" or element_name_view == "uintptr" or element_name_view == "f32" or element_name_view == "f64" or element_name_view == "bool" or element_name_view == "cstr" or element_name_view == "sview" or element_name_view == "py::Object" or element_name_view == "i8?" or element_name_view == "i16?" or element_name_view == "i32?" or element_name_view == "i64?" or element_name_view == "int?" or element_name_view == "isize?" or element_name_view == "char?" or element_name_view == "u8?" or element_name_view == "u16?" or element_name_view == "u32?" or element_name_view == "u64?" or element_name_view == "usize?" or element_name_view == "uintptr?" or element_name_view == "bool?" or element_name_view == "f32?" or element_name_view == "f64?" or element_name_view == "cstr?" or element_name_view == "sview?" or element_name_view == "py::Object?"
        return false
    return true if pymodule_struct_return_supported(file, type_name)
    return type_name == "i8" or type_name == "i16" or type_name == "i32" or type_name == "i64" or type_name == "int" or type_name == "isize" or type_name == "char" or type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or type_name == "usize" or type_name == "uintptr" or type_name == "f32" or type_name == "f64" or type_name == "bool" or type_name == "cstr" or type_name == "sview" or type_name == "py::Object" or type_name == "cstr?" or type_name == "py::Object?" or pymodule_is_optional_scalar_type(type_name)


def pymodule_error_decl_in(declarations: darray[Ast::Decl]&, wanted: sview) -> Ast::Decl? can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |wanted|:
        if declaration is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            return declaration if error_name == wanted
        if declaration is Decl.Module(error_module_name, error_module_body, error_module_pos):
            nested: Ast::Decl? = pymodule_error_decl_in(error_module_body, wanted)
            return nested if nested != null
        if declaration is Decl.Scoped(error_scope_body, error_scope_pos):
            nested_scoped: Ast::Decl? = pymodule_error_decl_in(error_scope_body, wanted)
            return nested_scoped if nested_scoped != null
    return null


def pymodule_error_payload_is_structured_in(declarations: darray[Ast::Decl]&, wanted: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |wanted|:
        if declaration is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            if error_name == wanted:
                field_total: mutable usize = 0
                for variant in error_variants:
                    field_total <- field_total + variant.fields.count
                return field_total > 1.usize()
        if declaration is Decl.Module(error_module_name, error_module_body, error_module_pos):
            true return if pymodule_error_payload_is_structured_in(error_module_body, wanted)
        if declaration is Decl.Scoped(error_scope_body, error_scope_pos):
            true return if pymodule_error_payload_is_structured_in(error_scope_body, wanted)
    return false


def pymodule_error_payload_structured_supported_in(file: Ast::File&, declarations: darray[Ast::Decl]&, wanted: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |wanted|:
        if declaration is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            if error_name == wanted:
                field_total: mutable usize = 0
                for variant in error_variants:
                    for field in variant.fields:
                        field_type_name: sview = pymodule_alias_type_name(file, field)
                        return false if not pymodule_error_payload_supported(file, field_type_name)
                        field_total <- field_total + 1.usize()
                return field_total > 1.usize()
        if declaration is Decl.Module(error_module_name, error_module_body, error_module_pos):
            true return if pymodule_error_payload_structured_supported_in(file, error_module_body, wanted)
        if declaration is Decl.Scoped(error_scope_body, error_scope_pos):
            true return if pymodule_error_payload_structured_supported_in(file, error_scope_body, wanted)
    return false


def pymodule_error_payload_needs_arena_in(file: Ast::File&, declarations: darray[Ast::Decl]&, wanted: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |wanted|:
        if declaration is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            if error_name == wanted:
                for variant in error_variants:
                    for field in variant.fields:
                        field_type_name: sview = pymodule_alias_type_name(file, field)
                        return true if pymodule_is_darray_type(field_type_name) or pymodule_is_view_type(field_type_name) or pymodule_is_dict_type(field_type_name) or pymodule_is_set_type(field_type_name)
                return false
        if declaration is Decl.Module(error_module_name, error_module_body, error_module_pos):
            true return if pymodule_error_payload_needs_arena_in(file, error_module_body, wanted)
        if declaration is Decl.Scoped(error_scope_body, error_scope_pos):
            true return if pymodule_error_payload_needs_arena_in(file, error_scope_body, wanted)
    return false


# Struct payloads borrow text/list storage from struct argument arenas. They do not change the
# native function's ABI to add an arena parameter, but their Python conversion must still happen
# before the ordinary argument cleanup releases that storage.
def pymodule_error_payload_contains_struct_in(file: Ast::File&, declarations: darray[Ast::Decl]&, wanted: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |file, wanted|:
        if declaration is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            if error_name == wanted:
                for variant in error_variants:
                    for field in variant.fields:
                        true return if pymodule_struct_return_supported(file, pymodule_alias_type_name(file, field))
                return false
        if declaration is Decl.Module(error_module_name, error_module_body, error_module_pos):
            true return if pymodule_error_payload_contains_struct_in(file, error_module_body, wanted)
        if declaration is Decl.Scoped(error_scope_body, error_scope_pos):
            true return if pymodule_error_payload_contains_struct_in(file, error_scope_body, wanted)
    return false


def emit_pymodule_error_payload_manifest(buffer: mutable darray[u8]&, file: Ast::File&, declarations: darray[Ast::Decl]&, wanted: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    # Keep the manifest's structured payload contract source-shaped: each active variant
    # declares its own fields and concrete Elisa type spellings. The generated C bridge still
    # remains the ABI authority; this metadata is for IDEs, stub generators, and documentation.
    for declaration in declarations |buffer, wanted|:
        if declaration is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            continue if error_name != wanted
            first_variant: mutable bool = true
            for variant in error_variants |buffer, first_variant|:
                emit_tokens_push_sview(buffer, ",") if not first_variant
                emit_tokens_push_sview(buffer, "{\"name\": \"")
                emit_tokens_push_sview(buffer, variant.name)
                emit_tokens_push_sview(buffer, "\", \"fields\": [")
                first_field: mutable bool = true
                for field_index in 0..<variant.fields.count |buffer, first_field, variant|:
                    emit_tokens_push_sview(buffer, ",") if not first_field
                    emit_tokens_push_sview(buffer, "{\"name\": \"")
                    if field_index < variant.field_names.count and variant.field_names[field_index] != "":
                        emit_tokens_push_sview(buffer, variant.field_names[field_index])
                    else:
                        emit_tokens_push_sview(buffer, "field_")
                        append_decimal(buffer, field_index.i64())
                    emit_tokens_push_sview(buffer, "\", \"type\": \"")
                    emit_tokens_push_sview(buffer, pymodule_alias_type_name(file, variant.fields[field_index]))
                    emit_tokens_push_sview(buffer, "\"}")
                    first_field <- false
                emit_tokens_push_sview(buffer, "]}")
                first_variant <- false
            return true
        if declaration is Decl.Module(error_module_name, error_module_body, error_module_pos):
            true return if emit_pymodule_error_payload_manifest(buffer, file, error_module_body, wanted)
        if declaration is Decl.Scoped(error_scope_body, error_scope_pos):
            true return if emit_pymodule_error_payload_manifest(buffer, file, error_scope_body, wanted)
    return false


def emit_pymodule_error_payload_struct_typedef(buffer: mutable darray[u8]&, file: Ast::File&, declarations: darray[Ast::Decl]&, error_family: sview) -> void can[Abort.Panic, Memory.Allocate]:
    declaration: Ast::Decl? = pymodule_error_decl_in(declarations, error_family)
    if declaration is target:
        if target is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            emit_tokens_push_sview(buffer, "typedef struct { int32_t tag; ")
            field_index: mutable usize = 0.usize()
            for variant in error_variants |buffer, field_index|:
                for field in variant.fields |buffer, field_index|:
                    field_type_name: sview = pymodule_alias_type_name(file, field)
                    field_c_type_name: mutable sview = pymodule_c_type_name(field_type_name)
                    field_c_type_name <- field_type_name if field_c_type_name == "" and pymodule_struct_return_supported(file, field_type_name)
                    emit_tokens_push_sview(buffer, field_c_type_name)
                    emit_tokens_push_sview(buffer, " field_")
                    append_decimal(buffer, field_index.i64())
                    emit_tokens_push_sview(buffer, "; ")
                    field_index <- field_index + 1.usize()
            emit_tokens_push_sview(buffer, "} ElisaPymoduleErrorPayload_")
            emit_tokens_push_sview(buffer, error_family)
            emit_tokens_push_sview(buffer, ";\n")


# Nested darray error payloads use the same owning Python list representation as ordinary
# top-level nested darray returns. Keep the helper names leaf-based so multiple error sets that
# use the same nested element share one static converter in the generated extension.
def pymodule_error_nested_darray_helper_name(element_name: sview) -> sview can[Abort.Panic]:
    "i8" return if element_name == "i8"
    "i16" return if element_name == "i16"
    "i32" return if element_name == "i32"
    "i64" return if element_name == "i64"
    "int" return if element_name == "int"
    "isize" return if element_name == "isize"
    "char" return if element_name == "char"
    "u8" return if element_name == "u8"
    "u16" return if element_name == "u16"
    "u32" return if element_name == "u32"
    "u64" return if element_name == "u64"
    "usize" return if element_name == "usize"
    "uintptr" return if element_name == "uintptr"
    "f32" return if element_name == "f32"
    "f64" return if element_name == "f64"
    "bool" return if element_name == "bool"
    "cstr" return if element_name == "cstr"
    "cstr_optional" return if element_name == "cstr?"
    "sview" return if element_name == "sview"
    "sview_optional" return if element_name == "sview?"
    "object" return if element_name == "py::Object"
    "object_optional" return if element_name == "py::Object?"
    "i8_optional" return if element_name == "i8?"
    "i16_optional" return if element_name == "i16?"
    "i32_optional" return if element_name == "i32?"
    "i64_optional" return if element_name == "i64?"
    "int_optional" return if element_name == "int?"
    "isize_optional" return if element_name == "isize?"
    "char_optional" return if element_name == "char?"
    "u8_optional" return if element_name == "u8?"
    "u16_optional" return if element_name == "u16?"
    "u32_optional" return if element_name == "u32?"
    "u64_optional" return if element_name == "u64?"
    "usize_optional" return if element_name == "usize?"
    "uintptr_optional" return if element_name == "uintptr?"
    "bool_optional" return if element_name == "bool?"
    "f32_optional" return if element_name == "f32?"
    "f64_optional" return if element_name == "f64?"
    return ""


def pymodule_error_nested_darray_supported(type_name: sview) -> bool can[Abort.Panic]:
    depth: usize = pymodule_darray_nesting_depth(type_name)
    return false if depth < 2.usize() or depth > 8.usize()
    return pymodule_error_nested_darray_helper_name(pymodule_darray_leaf_name(type_name)) != ""


def pymodule_error_nested_darray_helper_suffix(type_name: sview, storage: mutable darray[u8]&) -> sview can[Abort.Panic, Memory.Allocate]:
    leaf_suffix: sview = pymodule_error_nested_darray_helper_name(pymodule_darray_leaf_name(type_name))
    return "" if leaf_suffix == ""
    for suffix_index in 0..<sview_len(leaf_suffix) |storage, leaf_suffix, suffix_index|:
        storage.push(sview_at(leaf_suffix, suffix_index))
    depth: usize = pymodule_darray_nesting_depth(type_name)
    if depth > 2.usize():
        emit_tokens_push_sview(storage, "_d")
        append_decimal(storage, depth.u32())
    return sview(&storage[0], 0, storage.count)


def pymodule_error_nested_dict_helper_suffix(type_name: sview, storage: mutable darray[u8]&) -> sview can[Abort.Panic, Memory.Allocate]:
    value_name: sview = pymodule_dict_value_name(type_name)
    if pymodule_is_dict_type(value_name):
        # Nested dictionary error payloads share the ordinary recursive dictionary copier. Use
        # the complete inner spelling as a C-safe suffix so different key/value combinations do
        # not collide while identical inner maps can reuse one generated helper.
        for type_index in 0..<sview_len(value_name) |storage, value_name, type_index|:
            byte: u8 = sview_at(value_name, type_index)
            if (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95:
                storage.push(byte)
            else:
                storage.push(95)
        return sview(&storage[0], 0, storage.count)
    if pymodule_is_darray_type(value_name):
        if pymodule_darray_nesting_depth(value_name) >= 2.usize():
            return pymodule_error_nested_darray_helper_suffix(value_name, storage)
        # A one-dimensional list of a named record needs a small struct-list copier; scalar/text
        # darray values already have direct dictionary conversion branches and need no helper.
        if pymodule_darray_c_element_type(pymodule_darray_element_name(value_name)) == "":
            for type_index in 0..<sview_len(value_name) |storage, value_name, type_index|:
                byte: u8 = sview_at(value_name, type_index)
                if (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95:
                    storage.push(byte)
                else:
                    storage.push(95)
            return sview(&storage[0], 0, storage.count)
    if pymodule_is_view_type(value_name) and pymodule_darray_c_element_type(pymodule_view_element_name(value_name)) == "":
        for type_index in 0..<sview_len(value_name) |storage, value_name, type_index|:
            byte: u8 = sview_at(value_name, type_index)
            if (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95:
                storage.push(byte)
            else:
                storage.push(95)
        return sview(&storage[0], 0, storage.count)
    if pymodule_is_set_type(value_name):
        # Set-valued dictionaries use the same one-column bucket copier as standalone set
        # payloads. Include the complete set spelling in the helper suffix so scalar/text
        # element families cannot collide.
        for type_index in 0..<sview_len(value_name) |storage, value_name, type_index|:
            byte: u8 = sview_at(value_name, type_index)
            if (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95:
                storage.push(byte)
            else:
                storage.push(95)
        return sview(&storage[0], 0, storage.count)
    return ""


def pymodule_error_nested_dict_helper_name(type_name: sview, storage: mutable darray[u8]&) -> sview can[Abort.Panic, Memory.Allocate]:
    suffix_storage: mutable darray[u8] = []
    suffix: sview = pymodule_error_nested_dict_helper_suffix(type_name, &suffix_storage)
    return "" if suffix == "" else emit_pymodule_error_nested_dict_helper_name(storage, suffix)


def emit_pymodule_error_nested_dict_helper_name(storage: mutable darray[u8]&, suffix: sview) -> sview can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(storage, "elisa_pymodule_error_dict_nested_")
    emit_tokens_push_sview(storage, suffix)
    emit_tokens_push_sview(storage, "_to_py")
    return sview(&storage[0], 0, storage.count)


def pymodule_error_darray_dict_helper_name(type_name: sview, storage: mutable darray[u8]&, element: bool) -> sview can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(storage, "elisa_pymodule_error_darray_dict_")
    for type_index in 0..<sview_len(type_name) |storage, type_name, type_index|:
        byte: u8 = sview_at(type_name, type_index)
        if (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95:
            storage.push(byte)
        else:
            storage.push(95)
    emit_tokens_push_sview(storage, "_element_to_py") if element else emit_tokens_push_sview(storage, "_to_py")
    return sview(&storage[0], 0, storage.count)


def pymodule_error_named_aggregate_helper_name(type_name: sview, storage: mutable darray[u8]&) -> sview can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(storage, "elisa_pymodule_error_named_aggregate_")
    for type_index in 0..<sview_len(type_name) |storage, type_name, type_index|:
        byte: u8 = sview_at(type_name, type_index)
        if (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95:
            storage.push(byte)
        else:
            storage.push(95)
    emit_tokens_push_sview(storage, "_to_py")
    return sview(&storage[0], 0, storage.count)


def emit_pymodule_error_darray_dict_output_helper(buffer: mutable darray[u8]&, file: Ast::File&, type_name: sview) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    element_name: sview = pymodule_darray_element_name(type_name)
    element_helper_storage: mutable darray[u8] = []
    element_helper: sview = pymodule_error_darray_dict_helper_name(type_name, &element_helper_storage, true)
    emit_pymodule_composed_dict_output_helper(buffer, file, element_helper, element_name)
    list_helper_storage: mutable darray[u8] = []
    list_helper: sview = pymodule_error_darray_dict_helper_name(type_name, &list_helper_storage, false)
    emit_tokens_push_sview(buffer, "static PyObject *")
    emit_tokens_push_sview(buffer, list_helper)
    emit_tokens_push_sview(buffer, "(ElisaDArray input) { if (input.count < 0 || input.capacity < 0 || input.count > input.capacity || input.count > (int64_t)PY_SSIZE_T_MAX || input.capacity > (int64_t)PY_SSIZE_T_MAX || (input.count > 0 && input.items == NULL)) { PyErr_SetString(PyExc_RuntimeError, \"native darray dictionary payload has invalid storage\"); return NULL; } PyObject *out = PyList_New((Py_ssize_t)input.count); if (out == NULL) return NULL; for (Py_ssize_t index = 0; index < (Py_ssize_t)input.count; ++index) { PyObject *item = ")
    emit_tokens_push_sview(buffer, element_helper)
    emit_tokens_push_sview(buffer, "(((ElisaDict *)input.items)[index]); if (item == NULL) { Py_DECREF(out); return NULL; } PyList_SET_ITEM(out, index, item); } return out; }\n")


def emit_pymodule_error_nested_darray_helpers(buffer: mutable darray[u8]&, file: Ast::File&, declarations: darray[Ast::Decl]&, wanted: sview, emitted: mutable darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations |buffer, file, wanted, emitted|:
        if declaration is Decl.Enum(error_name, error_variants, error_const, error_storage, error_pos):
            continue if error_name != wanted
            for variant in error_variants |buffer, file, emitted|:
                for field in variant.fields |buffer, file, emitted|:
                    field_type_name: sview = pymodule_alias_type_name(file, field)
                    if pymodule_is_darray_type(field_type_name) and pymodule_is_set_type(pymodule_darray_element_name(field_type_name)):
                        set_helper_storage: mutable darray[u8] = []
                        set_helper: sview = pymodule_error_named_aggregate_helper_name(field_type_name, &set_helper_storage)
                        already_emitted_set: mutable bool = false
                        for emitted_suffix in emitted |field_type_name|:
                            already_emitted_set <- true if emitted_suffix == field_type_name
                        if not already_emitted_set:
                            emit_pymodule_darray_set_output_helper(buffer, set_helper, pymodule_darray_element_name(field_type_name))
                            emitted.push(field_type_name)
                    elif pymodule_is_darray_type(field_type_name) and pymodule_darray_nesting_depth(field_type_name) == 1.usize() and pymodule_struct_return_supported(file, pymodule_darray_element_name(field_type_name)):
                        named_helper_storage: mutable darray[u8] = []
                        named_helper: sview = pymodule_error_named_aggregate_helper_name(field_type_name, &named_helper_storage)
                        already_emitted_named: mutable bool = false
                        for emitted_suffix in emitted |field_type_name|:
                            already_emitted_named <- true if emitted_suffix == field_type_name
                        if not already_emitted_named:
                            emit_pymodule_darray_struct_output_helper(buffer, file, named_helper, pymodule_darray_element_name(field_type_name))
                            emitted.push(field_type_name)
                    elif pymodule_is_view_type(field_type_name) and pymodule_struct_return_supported(file, pymodule_view_element_name(field_type_name)):
                        named_helper_storage: mutable darray[u8] = []
                        named_helper: sview = pymodule_error_named_aggregate_helper_name(field_type_name, &named_helper_storage)
                        already_emitted_named: mutable bool = false
                        for emitted_suffix in emitted |field_type_name|:
                            already_emitted_named <- true if emitted_suffix == field_type_name
                        if not already_emitted_named:
                            emit_pymodule_view_struct_output_helper(buffer, file, named_helper, pymodule_view_element_name(field_type_name))
                            emitted.push(field_type_name)
                    elif pymodule_is_darray_type(field_type_name) and pymodule_is_dict_type(pymodule_darray_element_name(field_type_name)):
                        darray_dict_suffix_storage: mutable darray[u8] = []
                        darray_dict_suffix: sview = pymodule_error_darray_dict_helper_name(field_type_name, &darray_dict_suffix_storage, false)
                        already_emitted_darray_dict: mutable bool = false
                        for emitted_suffix in emitted |darray_dict_suffix|:
                            already_emitted_darray_dict <- true if emitted_suffix == darray_dict_suffix
                        if not already_emitted_darray_dict:
                            emit_pymodule_error_darray_dict_output_helper(buffer, file, field_type_name)
                            emitted.push(darray_dict_suffix)
                    elif pymodule_is_dict_type(field_type_name):
                        dict_helper_suffix_storage: mutable darray[u8] = []
                        dict_helper_suffix: sview = pymodule_error_nested_dict_helper_suffix(field_type_name, &dict_helper_suffix_storage)
                        if dict_helper_suffix != "":
                            emitted_dict_suffix: mutable darray[u8] = []
                            emit_tokens_push_sview(&emitted_dict_suffix, "dict_")
                            emit_tokens_push_sview(&emitted_dict_suffix, dict_helper_suffix)
                            emitted_dict_suffix_view: sview = sview(&emitted_dict_suffix[0], 0, emitted_dict_suffix.count)
                            already_emitted_dict: mutable bool = false
                            for emitted_suffix in emitted |emitted_dict_suffix_view|:
                                already_emitted_dict <- true if emitted_suffix == emitted_dict_suffix_view
                            if not already_emitted_dict:
                                dict_helper_name_storage: mutable darray[u8] = []
                                dict_helper_name: sview = pymodule_error_nested_dict_helper_name(field_type_name, &dict_helper_name_storage)
                                if pymodule_is_dict_type(pymodule_dict_value_name(field_type_name)):
                                    emit_pymodule_composed_dict_output_helper(buffer, file, dict_helper_name, pymodule_dict_value_name(field_type_name))
                                elif pymodule_is_set_type(pymodule_dict_value_name(field_type_name)):
                                    emit_pymodule_composed_set_output_helper(buffer, dict_helper_name, pymodule_dict_value_name(field_type_name))
                                elif pymodule_is_darray_type(pymodule_dict_value_name(field_type_name)) and pymodule_darray_nesting_depth(pymodule_dict_value_name(field_type_name)) == 1.usize() and pymodule_darray_c_element_type(pymodule_darray_element_name(pymodule_dict_value_name(field_type_name))) == "":
                                    emit_pymodule_darray_struct_output_helper(buffer, file, dict_helper_name, pymodule_darray_element_name(pymodule_dict_value_name(field_type_name)))
                                elif pymodule_is_view_type(pymodule_dict_value_name(field_type_name)) and pymodule_darray_c_element_type(pymodule_view_element_name(pymodule_dict_value_name(field_type_name))) == "":
                                    emit_pymodule_view_struct_output_helper(buffer, file, dict_helper_name, pymodule_view_element_name(pymodule_dict_value_name(field_type_name)))
                                else:
                                    emit_pymodule_composed_nested_darray_output_helper(buffer, file, dict_helper_name, pymodule_dict_value_name(field_type_name))
                                emitted.push(emitted_dict_suffix_view)
                    continue if not pymodule_error_nested_darray_supported(field_type_name)
                    helper_suffix_storage: mutable darray[u8] = []
                    helper_suffix: sview = pymodule_error_nested_darray_helper_suffix(field_type_name, &helper_suffix_storage)
                    continue if helper_suffix == ""
                    already_emitted: mutable bool = false
                    for emitted_suffix in emitted |helper_suffix|:
                        already_emitted <- true if emitted_suffix == helper_suffix
                    continue if already_emitted
                    helper_name_storage: mutable darray[u8] = []
                    emit_tokens_push_sview(&helper_name_storage, "elisa_pymodule_error_nested_")
                    emit_tokens_push_sview(&helper_name_storage, helper_suffix)
                    emit_tokens_push_sview(&helper_name_storage, "_to_py")
                    helper_name: sview = sview(&helper_name_storage[0], 0, helper_name_storage.count)
                    emit_pymodule_composed_nested_darray_output_helper(buffer, file, helper_name, field_type_name)
                    emitted.push(helper_suffix)
        if declaration is Decl.Module(error_module_name, error_module_body, error_module_pos):
            emit_pymodule_error_nested_darray_helpers(buffer, file, error_module_body, wanted, emitted)
        if declaration is Decl.Scoped(error_scope_body, error_scope_pos):
            emit_pymodule_error_nested_darray_helpers(buffer, file, error_scope_body, wanted, emitted)


def emit_pymodule_error_payload_darray_conversion(buffer: mutable darray[u8]&, file: Ast::File&, type_name: sview, expression: sview, destination: sview) -> void can[Abort.Panic, Memory.Allocate]:
    # Error payload darrays are borrowed until the Python exception is constructed. Validate and
    # copy them while the wrapper arena (and any input-list buffers they reference) is still live.
    element_name: sview = pymodule_darray_element_name(type_name)
    if pymodule_is_set_type(element_name):
        helper_storage: mutable darray[u8] = []
        helper: sview = pymodule_error_named_aggregate_helper_name(type_name, &helper_storage)
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = ")
        emit_tokens_push_sview(buffer, helper)
        emit_tokens_push_sview(buffer, "(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, "); if (")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " == NULL) { arena_free(&arena); return NULL; }\n")
        return
    if pymodule_is_dict_type(element_name):
        helper_storage: mutable darray[u8] = []
        helper: sview = pymodule_error_darray_dict_helper_name(type_name, &helper_storage, false)
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = ")
        emit_tokens_push_sview(buffer, helper)
        emit_tokens_push_sview(buffer, "(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, "); if (")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " == NULL) { arena_free(&arena); return NULL; }\n")
        return
    if pymodule_darray_nesting_depth(type_name) == 1.usize() and pymodule_struct_return_supported(file, element_name):
        helper_storage: mutable darray[u8] = []
        helper: sview = pymodule_error_named_aggregate_helper_name(type_name, &helper_storage)
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = ")
        emit_tokens_push_sview(buffer, helper)
        emit_tokens_push_sview(buffer, "(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, "); if (")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " == NULL) { arena_free(&arena); return NULL; }\n")
        return
    if pymodule_error_nested_darray_supported(type_name):
        helper_suffix_storage: mutable darray[u8] = []
        helper_suffix: sview = pymodule_error_nested_darray_helper_suffix(type_name, &helper_suffix_storage)
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = elisa_pymodule_error_nested_")
        emit_tokens_push_sview(buffer, helper_suffix)
        emit_tokens_push_sview(buffer, "_to_py(")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, "); if (")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " == NULL) { arena_free(&arena); return NULL; }\n")
        return
    emit_tokens_push_sview(buffer, "if (")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".count < 0 || ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".capacity < 0 || ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".count > ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".capacity || ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".count > PY_SSIZE_T_MAX || ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".capacity > PY_SSIZE_T_MAX || (")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".items == NULL && ")
    emit_tokens_push_sview(buffer, expression)
    emit_tokens_push_sview(buffer, ".count != 0)) { arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native Elisa error returned an invalid list payload\"); return NULL; }\n")
    if pymodule_darray_is_bytes(type_name):
        emit_tokens_push_sview(buffer, "if (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".count == 0) ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyBytes_FromStringAndSize(\"\", 0); else ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyBytes_FromStringAndSize((const char *)")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".items, (Py_ssize_t)")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".count);\n")
    else:
        emit_tokens_push_sview(buffer, "if (")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".count == 0) ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyList_New(0); else { ")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " = PyList_New((Py_ssize_t)")
        emit_tokens_push_sview(buffer, expression)
        emit_tokens_push_sview(buffer, ".count); if (")
        emit_tokens_push_sview(buffer, destination)
        emit_tokens_push_sview(buffer, " == NULL) { arena_free(&arena); return NULL; } for (Py_ssize_t error_payload_index = 0; error_payload_index < (Py_ssize_t)")
        emit_tokens_push_sview(buffer, expression)
        # Element-specific branches may need to declare a temporary native value
        # (`ElisaOptionalI64`, `ElisaSView`, or `PyObject *`) before assigning the
        # Python result.  Start with a standalone NULL declaration; prefixing the
        # branch with `PyObject *error_payload_item =` would concatenate two C
        # declarations and make every typed list payload uncompilable.
        emit_tokens_push_sview(buffer, ".count; ++error_payload_index) { PyObject *error_payload_item = NULL; ")
        if element_name == "sview":
            emit_tokens_push_sview(buffer, "ElisaSView error_payload_view = ((ElisaSView *)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".items)[error_payload_index]; if (error_payload_view.len < 0 || error_payload_view.len > PY_SSIZE_T_MAX || (error_payload_view.data == NULL && error_payload_view.len != 0)) { Py_DECREF(")
            emit_tokens_push_sview(buffer, destination)
            emit_tokens_push_sview(buffer, "); arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native Elisa error returned an invalid text list payload\"); return NULL; } if (error_payload_view.data == NULL) error_payload_item = PyUnicode_FromString(\"\"); else error_payload_item = PyUnicode_DecodeUTF8(error_payload_view.data, (Py_ssize_t)error_payload_view.len, \"strict\"); ")
        elif element_name == "cstr":
            emit_tokens_push_sview(buffer, "const char *error_payload_text = ((const char **)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".items)[error_payload_index]; if (error_payload_text == NULL) { Py_DECREF(")
            emit_tokens_push_sview(buffer, destination)
            emit_tokens_push_sview(buffer, "); arena_free(&arena); PyErr_SetString(PyExc_RuntimeError, \"native Elisa error returned a null cstr list payload\"); return NULL; } error_payload_item = PyUnicode_FromString(error_payload_text); ")
        elif element_name == "cstr?":
            emit_tokens_push_sview(buffer, "const char *error_payload_text = ((const char **)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".items)[error_payload_index]; if (error_payload_text == NULL) { Py_INCREF(Py_None); error_payload_item = Py_None; } else error_payload_item = PyUnicode_FromString(error_payload_text); ")
        elif element_name == "sview?":
            emit_tokens_push_sview(buffer, "ElisaOptionalSView error_payload_optional_view = ((ElisaOptionalSView *)")
            emit_tokens_push_sview(buffer, expression)
            emit_tokens_push_sview(buffer, ".items)[error_payload_index]; if (!error_payload_optional_view.has_value) { Py_INCREF(Py_None); error_payload_item = Py_None; } else { ElisaSView error_payload_view = error_payload_optional_view.value; if (error_payload_view.len < 0 || error_payload_view.len > PY_SSIZE_T_MAX || (error_payload_view.data == NULL && error_payload_view.len != 0)) { Py_DECREF(")
            emit_tokens_push_sview(buffer, destination)
