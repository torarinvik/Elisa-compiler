# POSIX read takes a C int descriptor and returns pointer-sized ssize_t.
# Keep the byte-buffer spelling for the self-hosted driver.
extern read(fd: i32, buf: u8&, count: usize) -> isize


# Real-CLI support. `main(argc, argv)` is portable and stage0 has always supported it —
# the "non-libc argv" note above was wrong about the obstacle. What actually blocked it
# was that indexing a `T&&` (C's `char**`) DECLINED in stage1's backend until it was
# implemented; there is no platform hook needed (`_NSGetArgv` works but is macOS-only).
#
# Flags are re-exported through setenv so the existing ELISA_STAGE1_* readers below need
# no change: the CLI and the environment stay ONE code path, and the wrapper's env-var
# invocations keep working exactly as before.
# `open` is VARIADIC — `open(const char *, int, ...)`. Declaring the mode as a FIXED third
# parameter passes it in a register, while the arm64 varargs ABI requires it on the stack,
# so libc read garbage and created files with mode `----------` (created, then unreadable).
extern open(path: cstr, flags: i32, ...) -> i32
# File open flags differ by OS. O_CREAT/O_TRUNC/O_EXCL are 0x200/0x400/0x800 on macOS/BSD and
# 0x40/0x200/0x80 on Linux. O_NOFOLLOW|O_NONBLOCK is 0x104 on macOS/BSD and 0x20800 on Linux.
# The macOS literal 1537 on Linux meant O_WRONLY|O_TRUNC|0x400 with no O_CREAT, so every new
# file failed with ENOENT and `-emit exe` exited 8.
static if ELISA_TARGET_OS_LINUX:
    const ELISA_OPEN_WRITE_CREATE_TRUNC: i32 = 577
    const ELISA_OPEN_WRITE_CREATE_EXCL: i32 = 193
    const ELISA_OPEN_READ_CACHE_SAFE: i32 = 133120
static else:
    const ELISA_OPEN_WRITE_CREATE_TRUNC: i32 = 1537
    const ELISA_OPEN_WRITE_CREATE_EXCL: i32 = 2561
    const ELISA_OPEN_READ_CACHE_SAFE: i32 = 260


extern close(fd: i32) -> i32


extern setenv(name: cstr, value: cstr, overwrite: i32) -> i32


extern unsetenv(name: cstr) -> i32


extern mkdir(path: cstr, mode: u16) -> i32


# `#line` directives carry an ABSOLUTE path, so a relative -o/source argument is joined
# onto the working directory (stage0 uses filepath.Abs).
extern getcwd(buffer: void&, size: usize) -> void&


extern system(command: cstr) -> i32


# Used only to make the per-invocation work directory unique. Two `-emit test` runs share
# one fixed path otherwise, and the parity gate runs its checks in PARALLEL — one run's
# runner binary and captured streams would overwrite another's mid-suite.
@link_name("getpid")
extern elisa_stage1_getpid() -> i32


extern unlink(path: cstr) -> i32


extern rename(old_path: cstr, new_path: cstr) -> i32


include "./elisac_incremental_cache.elisa"
include "./elisac_incremental_server.elisa"




# The legacy shadow remains an opt-in observer. The separate cache path below only passes
# re-collected and validated facts into the narrow Global-authority replay seam.
def collect_incremental_shadow[@input_source, @output](file: Ast::File& @input_source, analyzed_source: u8& @input_source, analyzed_length: usize, analyzed_tokens: darray[Lexer::Token]& @input_source, identity: SourceIdentity::Capture&, shadow_enabled: bool, report_enabled: bool, generated_input: bool) -> void can[Abort.Panic, Console, Memory.Allocate, Global{Read,Write}, Unsafe{PointerArithmetic,PointerCast,RawExtern}]:
    return if not shadow_enabled

    shadow_options: Semantic::IncrementalSemanticOptions = Semantic::incremental_semantic_options_from_values(false, false, false, false, false, false, false, false, false, false, 64, false, false, false)
    shadow_options_key: mutable darray[u8] = []
    _ = Semantic::incremental_semantic_options_encode(shadow_options, &shadow_options_key)

    if SourceIdentity::usable(identity) and identity.root < identity.paths.count:
        root: SourceIdentity::PathRecord = identity.paths[identity.root]
        source_path: sview = bytes_view_range_ref(identity.bytes, root.start, root.length)
        # This cold shadow has no prior snapshot, so the zero fingerprints are intentionally
        # non-persistent markers rather than claims of a complete cache identity.
        previous_slots: mutable darray[Semantic::IncrementalSemanticSnapshot[output]] @output = [Semantic::incremental_empty_snapshot[output]()]
        previous_slots[0].schema_version <- Semantic::INCREMENTAL_FUNCTION_FACTS_SCHEMA
        previous_slots[0].declaration_surface_hash <- Semantic::INCREMENTAL_FACT_HASH_OFFSET
        shadow: Semantic::IncrementalSemanticSnapshot[output] = Semantic::incremental_collect_function_facts[input_source, output, output](file, analyzed_source, analyzed_length, analyzed_tokens, source_path, 0, 0, shadow_options_key, &previous_slots[0], false) can[Abort.Panic, Memory.Allocate, Global{Read,Write}, Unsafe.PointerCast]
        if report_enabled:
            report: mutable darray[u8] = []
            report.extend("incremental-shadow: cold_gate=passed collector=shadow-only input=")
            if generated_input:
                report.extend("generated")
            else:
                report.extend("ordinary")
            report.extend(" bytes=")
            append_decimal(&report, analyzed_length.u32())
            report.extend(" tokens=")
            append_decimal(&report, analyzed_tokens.count.u32())
            report.extend(" functions=")
            append_decimal(&report, shadow.functions.count.u32())
            report.extend(" visited=")
            append_decimal(&report, shadow.bodies_visited)
            report.extend(" matched=")
            append_decimal(&report, shadow.bodies_matched)
            report.extend(" rejected=")
            append_decimal(&report, shadow.bodies_rejected)
            report.push(10)
            write_stderr(report)
            return

    if report_enabled:
        skipped: mutable darray[u8] = []
        skipped.extend("incremental-shadow: cold_gate=passed collector=skipped reason=unstable-source\n")
        write_stderr(skipped)
    return


const LLVM_VERIFY_RETURN_STATUS_ACTION: i32 = 2
const LLVM_VERIFY_PRINT_MESSAGE_ACTION: i32 = 1
const SETENV_OVERWRITE_EXISTING: i32 = 1

def main(argc: i64, argv: mutable void&) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe{PointerCast,RawExtern}]:
    # TWO front doors, ONE compile path. With arguments this is an ordinary CLI; with none
    # it is the original stdin wire protocol, which the host wrapper and the bootstrap both
    # still use. cli_request builds exactly the buffer read_all would have produced, so
    # nothing downstream can tell the difference.
    PhaseTimer::start() can Global{Read,Write}
    # Never trust caller-supplied source attribution. The project/CLI front doors rebuild this
    # map from the input paths before parsing; stdin-only compiles have no trusted path map.
    can Abort.Panic, Global{Read,Write}:
        Lexer::line_map_clear()
    if argc > 0:
        argv_slots: mutable cstr&& = argv.cast[mutable cstr&&]
        _ = setenv("ELISA_STAGE1_SELF", argv_slots[0].cast[cstr], SETENV_OVERWRITE_EXISTING)
    # `init` is a SUBCOMMAND, not a compile: it consumes the rest of argv itself.
    if argc > 1:
        first_argument: mutable cstr&& = argv.cast[mutable cstr&&]
        subcommand: cstr = first_argument[1].cast[cstr]
        match subcommand:
            "init":
                return run_init(argc, argv)
            "init-lib":
                return run_init_lib(argc, argv)
            "project":
                can Global.Read:
                    return run_project(argc, argv)
            "semantic-session":
                return run_incremental_semantic_server(argc, argv) can Global{Read,Write}
            "compile-session":
                return run_incremental_compile_server(argc, argv) can[Blocking.IO, Abort.Panic, Console, Memory.Allocate, Memory.Release, Global{Read,Write}, Unsafe{PointerArithmetic,PointerCast,RawExtern}]
            _:
                pass
        # `build|run|test|bench` are stage0 subcommands stage1 does not implement yet. They
        # used to fall through to the compile path, where the subcommand name was taken as a
        # SOURCE PATH — so `elisac-stage1 build` exited 1 having printed nothing at all,
        # which reads exactly like a crash. Name the gap instead. (Same class of defect as
        # the mute backend decline; a compiler that fails must say what it declined.)
        return run_unimplemented_subcommand(subcommand) if subcommand_is_unimplemented(subcommand)
    # `build|run|test|bench` resolve a project target and then compile its entry. They build
    # the SAME request buffer the flag CLI does, so everything downstream is untouched.
    # The cast is hoisted for READABILITY now, not necessity. Writing the chain inline
    # (`subcommand_compiles_project((argv.cast[mutable cstr&&])[1.usize()].cast[cstr])`)
    # used to make the backend decline this whole unit, so the compiler could not build
    # itself; indexing directly into a cast is lowered since then and pinned by
    # index_into_cast_read/_write in backend_native_smoke.
    project_compile: mutable bool = false
    if argc > 1:
        argv_slots: mutable cstr&& = argv.cast[mutable cstr&&]
        project_compile <- subcommand_compiles_project(argv_slots[1.usize()].cast[cstr])
    incremental_shadow_enabled: bool = env_flag_is_one("ELISA_INCREMENTAL_SHADOW") can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]
    incremental_shadow_report_enabled: mutable bool = false
    if incremental_shadow_enabled:
        incremental_shadow_report_enabled <- env_flag_is_one("ELISA_INCREMENTAL_SHADOW_REPORT") can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]
    incremental_cache_directory: mutable darray[u8] = []
    incremental_cache_enabled: bool = env_value("ELISA_STAGE1_INCREMENTAL_CACHE_DIR", &incremental_cache_directory)
    incremental_cache_report_enabled: mutable bool = false
    if incremental_cache_enabled:
        incremental_cache_report_enabled <- env_flag_is_one("ELISA_STAGE1_INCREMENTAL_CACHE_REPORT") can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]
    source_identity_enabled: bool = incremental_shadow_enabled or incremental_cache_enabled
    region one_shot_session:
        incremental_context: mutable SourceIdentity::InvocationContext = zeroed
        if source_identity_enabled:
            incremental_context <- SourceIdentity::empty_identity_context(true) can Memory.Allocate
        project_status: mutable i64 = 0
        raw: mutable darray[u8] = []
        if project_compile:
            if source_identity_enabled:
                raw <- project_compile_request_with_source_context(argc, argv, &project_status, &incremental_context) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]
            else:
                raw <- project_compile_request(argc, argv, &project_status)
        elif argc > 1:
            if source_identity_enabled:
                raw <- cli_request_with_source_context(argc, argv, &incremental_context) can[Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast]
            else:
                raw <- cli_request(argc, argv) can[Memory.Allocate, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast]
        else:
            raw <- read_all()
        sessions: mutable darray[Semantic::IncrementalSemanticSession[one_shot_session]] @one_shot_session = []
        sessions.push(Semantic::incremental_semantic_session_new[one_shot_session](false))
        return run_compile_request_with_session(raw, project_compile, project_status, incremental_context, incremental_cache_directory, incremental_cache_report_enabled, incremental_shadow_enabled, incremental_shadow_report_enabled, &sessions[0]) can[Blocking.IO, Abort.Panic, Memory.Allocate, Memory.Release, Unsafe{PointerArithmetic,PointerCast,RawExtern}, Global{Read,Write}, Console]



def run_compile_request_with_session[@session](raw: darray[u8]&, project_compile: bool, project_status: i64, incremental_context: mutable SourceIdentity::InvocationContext&, incremental_cache_directory: darray[u8]&, incremental_cache_report_enabled: bool, incremental_shadow_enabled: bool, incremental_shadow_report_enabled: bool, session: mutable Semantic::IncrementalSemanticSession[session]& @session) -> i64 can[Blocking.IO, Abort.Panic, Memory.Allocate, Memory.Release, Unsafe{PointerArithmetic,PointerCast,RawExtern}, Global{Read,Write}, Console]:
    return project_status if project_compile and project_status != 0
    # `-emit deps`/`deps-json` answer from the include graph alone — no parse, no analysis.
    # Placed after cli_request so the CLI has recorded the source path it walks from.
    return emit_deps_report(false) if emit_mode_is("deps")
    return emit_deps_report(true) if emit_mode_is("deps-json")
    return 1 if raw.count <= 1
    # The parser stores AST rows and source views in the caller's source region.
    # Keep this backing buffer alive through parsing, semantic analysis, and codegen.
    source_bytes: mutable darray[u8] @source = []
    source_bytes.extend(raw)
    region request_source:
        out_path: mutable darray[u8] = []
        i: mutable usize = 0
        while i < raw.count - 1 |i, out_path|:
            b: u8 = raw[i]
            break if b == 10
            out_path.push(b)
            i <- i + 1
        return 1 if out_path.count == 0
        # Match stage0's output contract: object, bitcode, IR, and native executable writes
        # create the parent directory before handing the path to LLVM or the linker. Project
        # builds commonly name a fresh `build/bin/app`, and relying on the caller to pre-create
        # that directory turns a valid target into a silent object-write failure.
        output_directory: darray[u8] = path_directory(out_path)
        make_directory(output_directory) if output_directory.count > 0.usize()
        path_len: i64 = out_path.count.i64()
        out_path.push(0)
        i <- i + 1 if i < raw.count - 1 and raw[i] == 10
        source_start: usize = i
        source_len: usize = raw.count - 1 - source_start
        return 1 if source_len == 0

        # A REPORT mode's output path is TRUNCATED before any work: the host wrapper used to do
        # this with `exec > "$out"`, and callers depend on it — a report that fails writes its
        # diagnosis to stderr and must leave an EMPTY file behind, not the previous run's answer.
        # (emit_c_bind_parity compares `-o` output and falls back to stderr only when the file is
        # empty; a stale success from an earlier case read as a divergence.)
        if emit_mode_is("edir"):
            return 1 if ElisaEDIR::prepare_output(out_path) != 0
        elif emit_mode_reports_to_output():
            truncate_report_output()

        src_ptr: u8& @source = &source_bytes[source_start]
        PhaseTimer::mark("read-and-expand-includes") can Global{Read,Write}
        tokens: darray[Lexer::Token] @source = frontend_tokenize_expanded_unit(src_ptr, src_ptr, source_len)
        PhaseTimer::mark("lex") can Global{Read,Write}
        # `-emit tokens` is the LEXER oracle: report and stop before parsing, as stage0 does.
        if emit_mode_is("tokens"):
            return emit_tokens_report(tokens)
        # Formatting modes need stage0's grouping nodes; ordinary compilation erases them.
        if emit_mode_is("pymodule-pyi"):
            clear_requested_pyi_status: i64 = emit_pymodule_pyi_clear_requested_output()
            return clear_requested_pyi_status if clear_requested_pyi_status != 0
        file: mutable Ast::File = frontend_parser_parse_file_with_length(src_ptr, source_len, tokens, emit_mode_is("fmt") or emit_mode_is("lowered")) can Global{Read,Write}
        PhaseTimer::mark("parse") can Global{Read,Write}
        if file.errors.count != 0:
            for parse_error_index in 0..<file.errors.count |file|:
                can Global.Read:
                    report_parse_error(file.errors[parse_error_index])
            return 1
        # Wildcard pymodule rows must be expanded before ordinary object codegen as well as the
        # manifest/C emitters: the backend emits the stable native wrapper symbols from this table.
        pymodule_expand_wildcard_exports(file)
        if emit_mode_is("pymodule-pyi"):
            clear_default_pyi_status: i64 = emit_pymodule_pyi_clear_default_output(file)
            return clear_default_pyi_status if clear_default_pyi_status != 0

        # `-emit ast` prints the parse-tree summary and stops, as stage0 does.
        if emit_mode_is("ast"):
            return emit_ast_report(file, tokens, src_ptr) can Global{Read,Write}
        # `-emit doc` renders the AST as markdown and stops, as stage0 does. Placed beside the
        # source projections so the page describes what was WRITTEN rather than what was generated.
        if emit_mode_is("doc"):
            return emit_doc_report(file, tokens, src_ptr) can Global{Read,Write}

        # `-emit fmt` runs the unparser; every unported shape prints a loud <fmt-*-todo>
        # marker, so partial coverage can never read as byte parity in the smoke.
        # `-emit lowered` is stage0's fmt of the ANALYSED AST. stage1's semantic layer does not
        # desugar the tree in place (stage0's does: UFCS, overload mangling, address-of), so this
        # emits the UNLOWERED rendering — which is EXACTLY right for the 41 of 56 corpus fixtures
        # where stage0's own fmt and lowered outputs are identical, i.e. where no lowering
        # applies. The gate ratchets that count rather than claiming parity it does not have.
        if emit_mode_is("fmt") or emit_mode_is("lowered"):
            fmt_buffer: mutable darray[u8] = []
            FmtUnparse::fmt_file(fmt_buffer, file, tokens, src_ptr) can Global{Read,Write}
            return 0 if fmt_buffer.count == 0 else emit_tokens_flush(fmt_buffer)

        # `static generate` expansion. The pass has existed since task #35 but was wired ONLY into
        # test/breadth/parse_report.elisa — never into this driver — so every `static generate:`
        # block was silently skipped and its generated names came back as "undefined identifier".
        #
        # Placed AFTER the `-emit fmt` return on purpose: the unparser must see the ORIGINAL source
        # (it round-trips what was written, not what was generated), and `-emit tokens`/`ast`/`doc`
        # /fmt/lowered have already returned above for the same reason.
        #
        # Recognized blocks are spliced into an expanded source and re-parsed ONCE, so generated
        # declarations flow through the semantic gate and codegen exactly like hand-written ones.
        # `expanded` is declared here so the generated declarations' source spans outlive the parse;
        # unrecognized blocks copy through and the pass answers false, leaving everything untouched.
        compile_file: mutable Ast::File = file
        # Keep the AST descriptor itself in the source region as well as its source-backed
        # arrays. Semantic analysis can then borrow a stable descriptor for this request.
        semantic_file_roots: mutable darray[Ast::File] @source = [file]
        expanded: mutable darray[u8] @source = []
        expanded_tokens: mutable darray[Lexer::Token] @source = []
        expanded_src_ptr: mutable u8& @source = src_ptr
        generated_line_runs: mutable darray[u32] = []
        generated_line_count: mutable u32 = 0
        static_generation_expanded: mutable bool = false
        semantic_gate_already_run: mutable bool = false
        static_generation_expanded <- frontend_preprocess_static_generate_with_line_map(src_ptr, source_len, tokens, file, expanded, generated_line_runs, &generated_line_count)
        if static_generation_expanded:
            original_line_map: mutable darray[u8] = []
            _ = driver_line_map_value(&original_line_map) can Global.Read
            original_line_map <- driver_identity_line_map() if original_line_map.count == 0.usize()
            generated_line_map: mutable darray[u8] = driver_compose_generated_line_map(original_line_map, generated_line_runs, generated_line_count)
            if original_line_map.count > 0.usize() and generated_line_map.count == 0.usize():
                line_map_error: mutable darray[u8] = []
                line_map_error.extend("error: could not map generated source to original locations\n")
                write_stderr(line_map_error)
                return 1
            elif generated_line_map.count > 0.usize():
                can Global{Read,Write}:
                    Lexer::line_map_publish(generated_line_map)
            expanded_src_ptr <- &expanded[0]
            expanded_tokens <- frontend_tokenize_expanded_unit(expanded_src_ptr, expanded_src_ptr, expanded.count)
            expanded_file: mutable Ast::File = frontend_parser_parse_file_with_length(expanded_src_ptr, expanded.count, expanded_tokens) can Global{Read,Write}
            if expanded_file.errors.count != 0:
                for parse_error_index in 0..<expanded_file.errors.count |expanded_file|:
                    can Global.Read:
                        report_parse_error(expanded_file.errors[parse_error_index])
                return 1
            # Mutate wildcard export rows while the expanded parse still has one unambiguous
            # region; after the branch merge `compile_file` is intentionally read-only.
            pymodule_expand_wildcard_exports(expanded_file)
            semantic_file_roots[0] <- expanded_file
            if emit_mode_is("pymodule-pyi"):
                clear_expanded_pyi_status: i64 = emit_pymodule_pyi_clear_default_output(expanded_file)
