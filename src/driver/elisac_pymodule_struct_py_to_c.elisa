# `-emit pymodule` — converting ONE struct field from Python to C: the widest dispatch in the
# bridge, one branch per supported field shape.


def pymodule_struct_field_py_to_c(buffer: mutable darray[u8]&, file: Ast::File&, field_type_name: sview, python_field_name: sview, field_name: sview, has_default: bool, default_value: Ast::Expr, nested_dict_input_helper: sview = "", struct_type_name: sview = "") -> void can[Abort.Panic, Memory.Allocate]:
    # Scalar cstr/sview fields borrow CPython's UTF-8 buffer. Their field object
    # must join the per-call owner table before the temporary field reference is
    # released; otherwise an attribute/mapping that returns a fresh string can
    # leave the native struct pointing at reclaimed memory.
    uses_python_container_default: bool = has_default and pymodule_default_is_container(default_value) and not pymodule_default_is_empty_container(default_value) and pymodule_default_supported(file, field_type_name, default_value)
    conversion_has_default: bool = has_default and not uses_python_container_default
    emit_tokens_push_sview(buffer, "    { Py_ssize_t field_path_mark = elisa_pymodule_current_path_length; if (elisa_pymodule_current_path_push_field(\"")
    emit_tokens_push_sview(buffer, python_field_name)
    emit_tokens_push_sview(buffer, "\") < 0) return -1; PyObject *field_obj = elisa_pymodule_get_field(object, \"")
    emit_tokens_push_sview(buffer, python_field_name)
    emit_tokens_push_sview(buffer, "\"); if (field_obj == NULL) ")
    if has_default:
        emit_tokens_push_sview(buffer, "{ if (!PyErr_ExceptionMatches(PyExc_KeyError) && !PyErr_ExceptionMatches(PyExc_AttributeError)) return -1; PyErr_Clear(); ")
        if uses_python_container_default:
            emit_tokens_push_sview(buffer, "field_obj = ")
            builder_name_storage: mutable darray[u8] = []
            emit_pymodule_struct_default_builder_symbol(&builder_name_storage, struct_type_name, field_name)
            emit_tokens_push_sview(buffer, sview(&builder_name_storage[0], 0, builder_name_storage.count))
            emit_tokens_push_sview(buffer, "(); if (field_obj == NULL) return -1; }")
        else:
            emit_tokens_push_sview(buffer, "out->")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, " = ")
            emit_pymodule_struct_default_value(buffer, file, field_type_name, default_value)
            emit_tokens_push_sview(buffer, "; } else { ")
    elif field_type_name == "cstr?" or field_type_name == "py::Object?" or pymodule_is_optional_scalar_type(field_type_name):
        emit_tokens_push_sview(buffer, "{ if (!PyErr_ExceptionMatches(PyExc_KeyError) && !PyErr_ExceptionMatches(PyExc_AttributeError)) return -1; PyErr_Clear(); Py_INCREF(Py_None); field_obj = Py_None; } ")
    else:
        emit_tokens_push_sview(buffer, "return -1; ")
    if pymodule_struct_input_supported(file, field_type_name):
        emit_tokens_push_sview(buffer, "if (elisa_pymodule_struct_")
        emit_tokens_push_sview(buffer, field_type_name)
        emit_tokens_push_sview(buffer, "_from_py(field_obj, &out->")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, ", arena, refs) < 0) { Py_DECREF(field_obj); elisa_pymodule_struct_")
        emit_tokens_push_sview(buffer, field_type_name)
        emit_tokens_push_sview(buffer, "_free(&out->")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, "); return -1; } ")
    elif pymodule_is_dict_type(field_type_name):
        emit_pymodule_struct_dict_field_py_to_c(buffer, field_type_name, field_name, nested_dict_input_helper)
    elif pymodule_is_set_type(field_type_name):
        emit_pymodule_struct_set_field_py_to_c(buffer, field_type_name, field_name)
    elif pymodule_is_view_type(field_type_name):
        # A view field is borrowed by the native call, but the Python sequence that owns its
        # text/object elements must stay alive until the call returns. Generate the battle-tested
        # darray conversion into a temporary value, then project its storage/count onto ElisaView.
        view_element_name: sview = pymodule_view_element_name(field_type_name)
        synthetic_type_storage: mutable darray[u8] = []
        emit_tokens_push_sview(&synthetic_type_storage, "darray[")
        emit_tokens_push_sview(&synthetic_type_storage, view_element_name)
        emit_tokens_push_sview(&synthetic_type_storage, "]")
        synthetic_type_name: sview = sview(&synthetic_type_storage[0], 0, synthetic_type_storage.count)
        view_value_storage: mutable darray[u8] = []
        emit_tokens_push_sview(&view_value_storage, "field_view_")
        emit_tokens_push_sview(&view_value_storage, field_name)
        view_value_name: sview = sview(&view_value_storage[0], 0, view_value_storage.count)
        emit_tokens_push_sview(buffer, "    ElisaDArray ")
        emit_tokens_push_sview(buffer, view_value_name)
        emit_tokens_push_sview(buffer, " = {NULL, 0, 0};\n")
        view_snippet: mutable darray[u8] = []
        pymodule_struct_field_py_to_c(&view_snippet, file, synthetic_type_name, python_field_name, field_name, has_default, default_value, "", struct_type_name)
        pymodule_replace_generated(&view_snippet, "out->", "field_view_")
        pymodule_replace_generated(&view_snippet, "struct list", "struct view")
        pymodule_replace_generated(&view_snippet, "} Py_DECREF(field_seq); ", "} if (elisa_pymodule_retain(field_seq, refs) < 0) { Py_DECREF(field_seq); Py_DECREF(field_obj); return -1; } Py_DECREF(field_seq); ")
        for view_byte_index in 0..<view_snippet.count |buffer, view_snippet|:
            buffer.push(view_snippet[view_byte_index])
        emit_tokens_push_sview(buffer, "    out->")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, " = (ElisaView){")
        emit_tokens_push_sview(buffer, view_value_name)
        emit_tokens_push_sview(buffer, ".items, ")
        emit_tokens_push_sview(buffer, view_value_name)
        emit_tokens_push_sview(buffer, ".count};\n")
    elif pymodule_is_darray_type(field_type_name):
        element_name: sview = pymodule_darray_element_name(field_type_name)
        if pymodule_is_dict_type(element_name):
            helper_storage: mutable darray[u8] = []
            helper_name: sview = pymodule_struct_darray_dict_helper_name(&helper_storage, struct_type_name, field_name, "from_py")
            emit_tokens_push_sview(buffer, "if (")
            emit_tokens_push_sview(buffer, helper_name)
            emit_tokens_push_sview(buffer, "(field_obj, &out->")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ", arena, refs) < 0) { Py_DECREF(field_obj); return -1; } Py_DECREF(field_obj);")
            emit_tokens_push_sview(buffer, " }" if conversion_has_default else "")
            emit_tokens_push_sview(buffer, " elisa_pymodule_current_path_restore(field_path_mark); }")
            emit_tokens_push_sview(buffer, "\n")
            return
        if pymodule_is_set_type(element_name):
            helper_storage: mutable darray[u8] = []
            helper_name: sview = pymodule_struct_darray_set_helper_name(&helper_storage, struct_type_name, field_name, "from_py")
            emit_tokens_push_sview(buffer, "if (")
            emit_tokens_push_sview(buffer, helper_name)
            emit_tokens_push_sview(buffer, "(field_obj, &out->")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ", arena, refs) < 0) { Py_DECREF(field_obj); return -1; } Py_DECREF(field_obj);")
            emit_tokens_push_sview(buffer, " elisa_pymodule_current_path_restore(field_path_mark); }")
            emit_tokens_push_sview(buffer, "\n")
            return
        if pymodule_is_darray_type(element_name):
            helper_storage: mutable darray[u8] = []
            helper_name: sview = pymodule_struct_darray_nested_helper_name(&helper_storage, struct_type_name, field_name, "from_py")
            emit_tokens_push_sview(buffer, "if (")
            emit_tokens_push_sview(buffer, helper_name)
            emit_tokens_push_sview(buffer, "(field_obj, &out->")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ", arena, refs) < 0) { Py_DECREF(field_obj); return -1; } Py_DECREF(field_obj);")
            emit_tokens_push_sview(buffer, " }" if conversion_has_default else "")
            emit_tokens_push_sview(buffer, " elisa_pymodule_current_path_restore(field_path_mark); }")
            emit_tokens_push_sview(buffer, "\n")
            return
        element_c_type: mutable sview = pymodule_darray_c_element_type(element_name)
        element_c_type <- element_name if element_c_type == "" and pymodule_struct_input_supported(file, element_name)
        emit_tokens_push_sview(buffer, "PyObject *field_seq = PySequence_Fast(field_obj, \"expected a sequence for struct list field\"); if (field_seq == NULL) { Py_DECREF(field_obj); return -1; } Py_ssize_t field_count = PySequence_Fast_GET_SIZE(field_seq); if (field_count > PY_SSIZE_T_MAX / (Py_ssize_t)sizeof(")
        emit_tokens_push_sview(buffer, element_c_type)
        emit_tokens_push_sview(buffer, ")) { Py_DECREF(field_seq); Py_DECREF(field_obj); PyErr_SetString(PyExc_OverflowError, \"struct list is too large\"); return -1; } out->")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, " = (ElisaDArray){NULL, (int64_t)field_count, (int64_t)field_count}; if (field_count > 0) { out->")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, ".items = arena_alloc(arena, (int64_t)((size_t)field_count * sizeof(")
        emit_tokens_push_sview(buffer, element_c_type)
        emit_tokens_push_sview(buffer, "))); if (out->")
        emit_tokens_push_sview(buffer, field_name)
        emit_tokens_push_sview(buffer, ".items == NULL) { Py_DECREF(field_seq); Py_DECREF(field_obj); PyErr_NoMemory(); return -1; } } for (Py_ssize_t field_index = 0; field_index < field_count; ++field_index) { Py_ssize_t field_element_path_mark = elisa_pymodule_current_path_length; if (elisa_pymodule_current_path_push_index(field_index) < 0) { Py_DECREF(field_seq); Py_DECREF(field_obj); return -1; } PyObject *field_item = PySequence_Fast_GET_ITEM(field_seq, field_index); ")
        if pymodule_struct_input_supported(file, element_name):
            emit_tokens_push_sview(buffer, "if (elisa_pymodule_struct_")
            emit_tokens_push_sview(buffer, element_name)
            emit_tokens_push_sview(buffer, "_from_py(field_item, &((")
            emit_tokens_push_sview(buffer, element_c_type)
            emit_tokens_push_sview(buffer, " *)out->")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ".items)[field_index], arena, refs) < 0) { Py_DECREF(field_seq); Py_DECREF(field_obj); return -1; } ")
        elif element_name == "py::Object" or element_name == "py::Object?":
            emit_tokens_push_sview(buffer, "if (field_item != Py_None && elisa_pymodule_retain(field_item, refs) < 0) { Py_DECREF(field_seq); Py_DECREF(field_obj); return -1; } ((PyObject **)out->")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ".items)[field_index] = field_item == Py_None ? NULL : field_item; ")
        elif element_name == "cstr?":
            emit_tokens_push_sview(buffer, "if (field_item == Py_None) ((const char **)out->")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ".items)[field_index] = NULL; else { Py_ssize_t field_len = 0; const char *field_data = PyUnicode_AsUTF8AndSize(field_item, &field_len); if (field_data == NULL) { Py_DECREF(field_seq); Py_DECREF(field_obj); return -1; } for (Py_ssize_t nul_index = 0; nul_index < field_len; ++nul_index) { if (field_data[nul_index] == '\\0') { Py_DECREF(field_seq); Py_DECREF(field_obj); PyErr_SetString(PyExc_ValueError, \"cstr optional struct list elements may not contain NUL bytes\"); return -1; } } char *field_copy = (char *)arena_alloc(arena, (int64_t)(field_len + 1)); if (field_copy == NULL) { Py_DECREF(field_seq); Py_DECREF(field_obj); PyErr_NoMemory(); return -1; } for (Py_ssize_t copy_index = 0; copy_index < field_len; ++copy_index) field_copy[copy_index] = field_data[copy_index]; field_copy[field_len] = '\\0'; ((const char **)out->")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ".items)[field_index] = field_copy; } ")
        elif element_name == "cstr":
            emit_tokens_push_sview(buffer, "Py_ssize_t field_len = 0; const char *field_data = PyUnicode_AsUTF8AndSize(field_item, &field_len); if (field_data == NULL) { Py_DECREF(field_seq); Py_DECREF(field_obj); return -1; } for (Py_ssize_t nul_index = 0; nul_index < field_len; ++nul_index) { if (field_data[nul_index] == '\\0') { Py_DECREF(field_seq); Py_DECREF(field_obj); PyErr_SetString(PyExc_ValueError, \"cstr struct list elements may not contain NUL bytes\"); return -1; } } char *field_copy = (char *)arena_alloc(arena, (int64_t)(field_len + 1)); if (field_copy == NULL) { Py_DECREF(field_seq); Py_DECREF(field_obj); PyErr_NoMemory(); return -1; } for (Py_ssize_t copy_index = 0; copy_index < field_len; ++copy_index) field_copy[copy_index] = field_data[copy_index]; field_copy[field_len] = '\\0'; ((const char **)out->")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ".items)[field_index] = field_copy; ")
        elif element_name == "sview?":
            emit_tokens_push_sview(buffer, "if (field_item == Py_None) ((ElisaOptionalSView *)out->")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ".items)[field_index] = (ElisaOptionalSView){false, {0, 0}}; else { Py_ssize_t field_len = 0; const char *field_data = PyUnicode_AsUTF8AndSize(field_item, &field_len); if (field_data == NULL) { Py_DECREF(field_seq); Py_DECREF(field_obj); return -1; } char *field_copy = NULL; if (field_len > 0) { field_copy = (char *)arena_alloc(arena, (int64_t)field_len); if (field_copy == NULL) { Py_DECREF(field_seq); Py_DECREF(field_obj); PyErr_NoMemory(); return -1; } for (Py_ssize_t copy_index = 0; copy_index < field_len; ++copy_index) field_copy[copy_index] = field_data[copy_index]; } ((ElisaOptionalSView *)out->")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ".items)[field_index] = (ElisaOptionalSView){true, (ElisaSView){field_copy, (int64_t)field_len}}; } ")
        elif element_name == "sview":
            emit_tokens_push_sview(buffer, "Py_ssize_t field_len = 0; const char *field_data = PyUnicode_AsUTF8AndSize(field_item, &field_len); if (field_data == NULL) { Py_DECREF(field_seq); Py_DECREF(field_obj); return -1; } char *field_copy = NULL; if (field_len > 0) { field_copy = (char *)arena_alloc(arena, (int64_t)field_len); if (field_copy == NULL) { Py_DECREF(field_seq); Py_DECREF(field_obj); PyErr_NoMemory(); return -1; } for (Py_ssize_t copy_index = 0; copy_index < field_len; ++copy_index) field_copy[copy_index] = field_data[copy_index]; } ((ElisaSView *)out->")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ".items)[field_index] = (ElisaSView){field_copy, (int64_t)field_len}; ")
        elif pymodule_darray_element_is_optional_scalar(element_name):
            optional_c_type: sview = pymodule_darray_c_element_type(element_name)
            payload_name: sview = pymodule_optional_payload_name(element_name)
            payload_c_type: sview = pymodule_optional_payload_c_type(payload_name)
            emit_tokens_push_sview(buffer, "if (field_item == Py_None) ((")
            emit_tokens_push_sview(buffer, optional_c_type)
            emit_tokens_push_sview(buffer, " *)out->")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ".items)[field_index] = (")
            emit_tokens_push_sview(buffer, optional_c_type)
            emit_tokens_push_sview(buffer, "){false, 0}; else { ")
            if payload_name == "bool":
                emit_tokens_push_sview(buffer, "if (!PyBool_Check(field_item)) { Py_DECREF(field_seq); Py_DECREF(field_obj); PyErr_SetString(PyExc_TypeError, \"expected bool elements in optional struct list field\"); return -1; } int field_truth = PyObject_IsTrue(field_item); if (field_truth < 0) { Py_DECREF(field_seq); Py_DECREF(field_obj); return -1; } ")
                emit_tokens_push_sview(buffer, "((")
                emit_tokens_push_sview(buffer, optional_c_type)
                emit_tokens_push_sview(buffer, " *)out->")
                emit_tokens_push_sview(buffer, field_name)
                emit_tokens_push_sview(buffer, ".items)[field_index] = (")
                emit_tokens_push_sview(buffer, optional_c_type)
                emit_tokens_push_sview(buffer, "){true, field_truth != 0}; ")
            elif payload_name == "f32" or payload_name == "f64":
                emit_tokens_push_sview(buffer, "double field_number = PyFloat_AsDouble(field_item); if (PyErr_Occurred()) { Py_DECREF(field_seq); Py_DECREF(field_obj); return -1; } ((")
                emit_tokens_push_sview(buffer, optional_c_type)
                emit_tokens_push_sview(buffer, " *)out->")
                emit_tokens_push_sview(buffer, field_name)
                emit_tokens_push_sview(buffer, ".items)[field_index] = (")
                emit_tokens_push_sview(buffer, optional_c_type)
                emit_tokens_push_sview(buffer, "){true, (")
                emit_tokens_push_sview(buffer, payload_c_type)
                emit_tokens_push_sview(buffer, ")field_number}; ")
            elif payload_name == "u8" or payload_name == "u16" or payload_name == "u32" or payload_name == "u64" or payload_name == "usize" or payload_name == "uintptr":
                emit_tokens_push_sview(buffer, "unsigned long long field_number = PyLong_AsUnsignedLongLong(field_item); if (PyErr_Occurred()) { Py_DECREF(field_seq); Py_DECREF(field_obj); return -1; } ")
                if payload_name == "u8":
                    emit_tokens_push_sview(buffer, "if (field_number > 255ULL) { Py_DECREF(field_seq); Py_DECREF(field_obj); PyErr_SetString(PyExc_OverflowError, \"u8 optional struct list element out of range\"); return -1; } ")
                elif payload_name == "u16":
                    emit_tokens_push_sview(buffer, "if (field_number > 65535ULL) { Py_DECREF(field_seq); Py_DECREF(field_obj); PyErr_SetString(PyExc_OverflowError, \"u16 optional struct list element out of range\"); return -1; } ")
                elif payload_name == "u32":
                    emit_tokens_push_sview(buffer, "if (field_number > 4294967295ULL) { Py_DECREF(field_seq); Py_DECREF(field_obj); PyErr_SetString(PyExc_OverflowError, \"u32 optional struct list element out of range\"); return -1; } ")
                emit_tokens_push_sview(buffer, "((")
                emit_tokens_push_sview(buffer, optional_c_type)
                emit_tokens_push_sview(buffer, " *)out->")
                emit_tokens_push_sview(buffer, field_name)
                emit_tokens_push_sview(buffer, ".items)[field_index] = (")
                emit_tokens_push_sview(buffer, optional_c_type)
                emit_tokens_push_sview(buffer, "){true, (")
                emit_tokens_push_sview(buffer, payload_c_type)
                emit_tokens_push_sview(buffer, ")field_number}; ")
            else:
                emit_tokens_push_sview(buffer, "long long field_number = PyLong_AsLongLong(field_item); if (PyErr_Occurred()) { Py_DECREF(field_seq); Py_DECREF(field_obj); return -1; } ")
                if payload_name == "i8":
                    emit_tokens_push_sview(buffer, "if (field_number < -128 || field_number > 127) { Py_DECREF(field_seq); Py_DECREF(field_obj); PyErr_SetString(PyExc_OverflowError, \"i8 optional struct list element out of range\"); return -1; } ")
                elif payload_name == "i16":
                    emit_tokens_push_sview(buffer, "if (field_number < -32768 || field_number > 32767) { Py_DECREF(field_seq); Py_DECREF(field_obj); PyErr_SetString(PyExc_OverflowError, \"i16 optional struct list element out of range\"); return -1; } ")
                elif payload_name == "i32":
                    emit_tokens_push_sview(buffer, "if (field_number < -2147483648LL || field_number > 2147483647LL) { Py_DECREF(field_seq); Py_DECREF(field_obj); PyErr_SetString(PyExc_OverflowError, \"i32 optional struct list element out of range\"); return -1; } ")
                emit_tokens_push_sview(buffer, "((")
                emit_tokens_push_sview(buffer, optional_c_type)
                emit_tokens_push_sview(buffer, " *)out->")
                emit_tokens_push_sview(buffer, field_name)
                emit_tokens_push_sview(buffer, ".items)[field_index] = (")
                emit_tokens_push_sview(buffer, optional_c_type)
                emit_tokens_push_sview(buffer, "){true, (")
                emit_tokens_push_sview(buffer, payload_c_type)
                emit_tokens_push_sview(buffer, ")field_number}; ")
            emit_tokens_push_sview(buffer, "} ")
        elif element_name == "bool":
            emit_tokens_push_sview(buffer, "if (!PyBool_Check(field_item)) { Py_DECREF(field_seq); Py_DECREF(field_obj); PyErr_SetString(PyExc_TypeError, \"expected bool elements in struct list field\"); return -1; } int field_truth = PyObject_IsTrue(field_item); if (field_truth < 0) { Py_DECREF(field_seq); Py_DECREF(field_obj); return -1; } ((bool *)out->")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ".items)[field_index] = field_truth != 0; ")
        elif element_name == "f32" or element_name == "f64":
            emit_tokens_push_sview(buffer, "double field_number = PyFloat_AsDouble(field_item); if (PyErr_Occurred()) { Py_DECREF(field_seq); Py_DECREF(field_obj); return -1; } ((")
            emit_tokens_push_sview(buffer, element_c_type)
            emit_tokens_push_sview(buffer, " *)out->")
            emit_tokens_push_sview(buffer, field_name)
            emit_tokens_push_sview(buffer, ".items)[field_index] = (")
            emit_tokens_push_sview(buffer, element_c_type)
            emit_tokens_push_sview(buffer, ")field_number; ")
        elif element_name == "u8" or element_name == "u16" or element_name == "u32" or element_name == "u64" or element_name == "usize" or element_name == "uintptr":
            emit_tokens_push_sview(buffer, "unsigned long long field_number = PyLong_AsUnsignedLongLong(field_item); if (PyErr_Occurred()) { Py_DECREF(field_seq); Py_DECREF(field_obj); return -1; } ")
            if element_name == "u8":
                emit_tokens_push_sview(buffer, "if (field_number > 255ULL) { Py_DECREF(field_seq); Py_DECREF(field_obj); PyErr_SetString(PyExc_OverflowError, \"u8 struct list element out of range\"); return -1; } ")
            elif element_name == "u16":
