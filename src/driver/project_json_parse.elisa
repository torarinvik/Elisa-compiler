# Project system — a JSON READER over the raw bytes. Only what a manifest can contain is modelled:
# objects, string lists, bools, and enough skipping to step over a value whose key was not
# wanted. Escapes (including surrogate pairs) are resolved to UTF-8 here.
# Continues project.elisa.

extend ProjectSystem:

    # ---- JSON ----------------------------------------------------------------------------
    #
    # Enough of RFC 8259 to read project.json and manifest.json, and no more. Values are
    # pulled straight into the destination fields; there is no DOM. Every routine threads a
    # JsonCursor — once `ok` goes false the caller stops, so a malformed file reports one
    # failure rather than a cascade.
    #
    # The cursor is a struct rather than a pair of `mutable usize&` / `mutable bool&`
    # out-parameters because a `mutable T&` reads as a reference, not a number: `data[position]`
    # is rejected with "index must be numeric", while `data[cursor.position]` is a plain field
    # read and works.
    #
    # stage0 decodes with DisallowUnknownFields, so an unrecognised key is an ERROR, not
    # something to skip.

    struct JsonCursor:
        position: mutable usize
        ok: mutable bool
        # The key that failed, so the caller can reproduce Go's
        # `json: unknown field "x"` verbatim rather than a generic message.
        bad_key_start: mutable usize
        bad_key_length: mutable usize



    def json_skip_ws(data: darray[u8]&, cursor: mutable JsonCursor&) -> void:
        while cursor.position < data.count |cursor, data|:
            break if not bytes_is_space(data[cursor.position])
            cursor.position <- cursor.position + 1.usize()



    def json_at(data: darray[u8]&, position: usize) -> u8:
        0 return if position >= data.count
        return data[position]



    def json_peek(data: darray[u8]&, cursor: mutable JsonCursor&) -> u8:
        json_skip_ws(data, cursor)
        return json_at(data, cursor.position)



    # Append the UTF-8 encoding of a code point. A surrogate pair arrives as two \u escapes
    # and is combined by the caller before this is reached.
    def json_push_utf8(out: mutable darray[u8]&, code: u32) -> void:
        can Memory.Allocate, Abort.Panic:
            if code < 128:
                out.push(code.u8())
            elif code < 2048:
                out.push((192 + (code / 64)).u8())
                out.push((128 + (code % 64)).u8())
            elif code < 65536:
                out.push((224 + (code / 4096)).u8())
                out.push((128 + ((code / 64) % 64)).u8())
                out.push((128 + (code % 64)).u8())
            else:
                out.push((240 + (code / 262144)).u8())
                out.push((128 + ((code / 4096) % 64)).u8())
                out.push((128 + ((code / 64) % 64)).u8())
                out.push((128 + (code % 64)).u8())



    def json_hex_digit(byte: u8) -> i64:
        (byte - 48).i64() return if byte >= 48 and byte <= 57
        (byte - 97 + 10).i64() return if byte >= 97 and byte <= 102
        (byte - 65 + 10).i64() return if byte >= 65 and byte <= 70
        return -1



    # Four hex digits at `position`, or -1 when they are not all hex.
    def json_hex4(data: darray[u8]&, position: usize) -> i64:
        value: mutable i64 = 0
        for offset in 0..<4 |value, data, position|:
            digit: i64 = json_hex_digit(json_at(data, position + offset.usize()))
            -1 return if digit < 0
            value <- value * 16 + digit
        return value



    # Decode one UTF-16 code unit, consuming a following low-surrogate escape only when the
    # pair is valid. Like Go's JSON decoder, isolated surrogates become U+FFFD.
    def json_unicode_escape_scalar(data: darray[u8]&, cursor: mutable JsonCursor&, first: i64) -> i64:
        if first >= 55296 and first <= 56319 and json_at(data, cursor.position) == 92 and json_at(data, cursor.position + 1.usize()) == 117:
            low: i64 = json_hex4(data, cursor.position + 2.usize())
            if low >= 56320 and low <= 57343:
                cursor.position <- cursor.position + 6.usize()
                return 65536 + (first - 55296) * 1024 + (low - 56320)
        return 65533 if first >= 55296 and first <= 57343
        return first



    def json_is_utf8_continuation(byte: u8) -> bool:
        return byte >= 128 and byte <= 191



    # Return the width of one valid UTF-8 scalar, or zero for an invalid leading byte. Go's
    # encoding/json replaces malformed input one byte at a time with U+FFFD.
    def json_raw_utf8_width(data: darray[u8]&, position: usize, end: usize) -> usize:
        first: u8 = data[position]
        remaining: usize = end - position
        return 1.usize() if first < 128
        if first >= 194 and first <= 223:
            return 2.usize() if remaining >= 2.usize() and json_is_utf8_continuation(data[position + 1.usize()])
            return 0.usize()
        if first == 224:
            if remaining >= 3.usize() and data[position + 1.usize()] >= 160 and data[position + 1.usize()] <= 191 and json_is_utf8_continuation(data[position + 2.usize()]):
                return 3.usize()
            return 0.usize()
        if first >= 225 and first <= 236 or first >= 238 and first <= 239:
            if remaining >= 3.usize() and json_is_utf8_continuation(data[position + 1.usize()]) and json_is_utf8_continuation(data[position + 2.usize()]):
                return 3.usize()
            return 0.usize()
        if first == 237:
            if remaining >= 3.usize() and data[position + 1.usize()] >= 128 and data[position + 1.usize()] <= 159 and json_is_utf8_continuation(data[position + 2.usize()]):
                return 3.usize()
            return 0.usize()
        if first == 240:
            if remaining >= 4.usize() and data[position + 1.usize()] >= 144 and data[position + 1.usize()] <= 191 and json_is_utf8_continuation(data[position + 2.usize()]) and json_is_utf8_continuation(data[position + 3.usize()]):
                return 4.usize()
            return 0.usize()
        if first >= 241 and first <= 243:
            if remaining >= 4.usize() and json_is_utf8_continuation(data[position + 1.usize()]) and json_is_utf8_continuation(data[position + 2.usize()]) and json_is_utf8_continuation(data[position + 3.usize()]):
                return 4.usize()
            return 0.usize()
        if first == 244:
            if remaining >= 4.usize() and data[position + 1.usize()] >= 128 and data[position + 1.usize()] <= 143 and json_is_utf8_continuation(data[position + 2.usize()]) and json_is_utf8_continuation(data[position + 3.usize()]):
                return 4.usize()
            return 0.usize()
        return 0.usize()



    def json_push_raw_utf8(out: mutable darray[u8]&, data: darray[u8]&, position: usize, width: usize) -> void:
        can Memory.Allocate, Abort.Panic:
            for offset in 0..<width |out, data, position|:
                out.push(data[position + offset])



    def json_span_is_mode(data: darray[u8]&, start: usize, length: usize, name: sview, ascii_fold: bool) -> bool:
        # Check start before subtracting, avoiding overflow in an unchecked start + length.
        false return if start > data.count
        false return if length > data.count - start
        end: usize = start + length
        position: mutable usize = start
        name_position: mutable usize = 0.usize()
        name_length: usize = sview_len(name)
        while position < end |position, name_position, data, end, name, name_length|:
            byte: u8 = data[position]
            decoded: mutable u32 = byte.u32()
            if byte == 92:
                remaining: usize = end - position
                return false if remaining < 2.usize()
                escape: u8 = data[position + 1.usize()]
                if escape == 34 or escape == 92 or escape == 47:
                    decoded <- escape.u32()
                    position <- position + 2.usize()
                elif escape == 98:
                    decoded <- 8
                    position <- position + 2.usize()
                elif escape == 102:
                    decoded <- 12
                    position <- position + 2.usize()
                elif escape == 110:
                    decoded <- 10
                    position <- position + 2.usize()
                elif escape == 114:
                    decoded <- 13
                    position <- position + 2.usize()
                elif escape == 116:
                    decoded <- 9
                    position <- position + 2.usize()
                elif escape == 117:
                    return false if remaining < 6.usize()
                    scalar: i64 = json_hex4(data, position + 2.usize())
                    return false if scalar < 0
                    if ascii_fold and scalar == 8490:
                        decoded <- 107
                    elif ascii_fold and scalar == 383:
                        decoded <- 115
                    else:
                        return false if scalar >= 128
                        decoded <- scalar.u32()
                    position <- position + 6.usize()
                else:
                    return false
            else:
                remaining: usize = end - position
                if ascii_fold and byte == 226 and remaining >= 3.usize() and data[position + 1.usize()] == 132 and data[position + 2.usize()] == 170:
                    decoded <- 107
                    position <- position + 3.usize()
                elif ascii_fold and byte == 197 and remaining >= 2.usize() and data[position + 1.usize()] == 191:
                    decoded <- 115
                    position <- position + 2.usize()
                else:
                    position <- position + 1.usize()
            return false if decoded >= 128 or name_position >= name_length
            expected: mutable u8 = sview_at(name, name_position.i64())
            if ascii_fold:
                decoded <- decoded + 32 if decoded >= 65 and decoded <= 90
                expected <- expected + 32 if expected >= 65 and expected <= 90
            return false if decoded.u8() != expected
            name_position <- name_position + 1.usize()
        return name_position == name_length



    def json_span_is(data: darray[u8]&, start: usize, length: usize, name: sview) -> bool:
        return json_span_is_mode(data, start, length, name, false)



    # Consume a JSON null value. For strings and booleans Go leaves an existing field alone;
    # slice and map callers use this to clear their nil-like destination explicitly.
    def json_take_null(data: darray[u8]&, cursor: mutable JsonCursor&) -> bool:
        json_skip_ws(data, cursor)
        false return if not json_span_is(data, cursor.position, 4.usize(), "null")
        cursor.position <- cursor.position + 4.usize()
        return true



    # encoding/json accepts Unicode simple-folded struct field names. For these ASCII schema
    # names, the only non-ASCII scalars that fold onto ASCII are Kelvin sign (K) and long s (S).
    # Map keys (platform and target names) stay exact.
    def json_struct_field_is(data: darray[u8]&, start: usize, length: usize, name: sview) -> bool:
        return json_span_is_mode(data, start, length, name, true)



    # A quoted string with escapes resolved. The cursor must be at the opening quote and is
    # left just past the closing one.
    def json_parse_string(data: darray[u8]&, cursor: mutable JsonCursor&) -> darray[u8]:
        can Memory.Allocate, Abort.Panic:
            out: mutable darray[u8] = []
            json_skip_ws(data, cursor)
            if json_at(data, cursor.position) != 34:
                cursor.ok <- false
                return out
            cursor.position <- cursor.position + 1.usize()
            while cursor.position < data.count |cursor, out, data|:
                byte: u8 = data[cursor.position]
                if byte == 34:
                    cursor.position <- cursor.position + 1.usize()
                    return out
                if byte != 92:
                    if byte < 32:
                        cursor.ok <- false
                        return out
                    if byte < 128:
                        out.push(byte)
                        cursor.position <- cursor.position + 1.usize()
                        continue
                    width: usize = json_raw_utf8_width(data, cursor.position, data.count)
                    if width == 0.usize():
                        json_push_utf8(&out, 65533.u32())
                        cursor.position <- cursor.position + 1.usize()
                    else:
                        json_push_raw_utf8(&out, data, cursor.position, width)
                        cursor.position <- cursor.position + width
                    continue
                escape: u8 = json_at(data, cursor.position + 1.usize())
                cursor.position <- cursor.position + 2.usize()
                if escape == 34 or escape == 92 or escape == 47:
                    out.push(escape)
                elif escape == 98:
                    out.push(8)
                elif escape == 102:
                    out.push(12)
                elif escape == 110:
                    out.push(10)
                elif escape == 114:
                    out.push(13)
                elif escape == 116:
                    out.push(9)
                elif escape == 117:
                    first: i64 = json_hex4(data, cursor.position)
                    if first < 0:
                        cursor.ok <- false
                        return out
                    cursor.position <- cursor.position + 4.usize()
                    code: i64 = json_unicode_escape_scalar(data, cursor, first)
                    json_push_utf8(&out, code.u32())
                else:
                    cursor.ok <- false
                    return out
            cursor.ok <- false
            return out



    def json_parse_string_field(data: darray[u8]&, cursor: mutable JsonCursor&, current: darray[u8]&) -> darray[u8]:
        can Memory.Allocate, Abort.Panic:
            return bytes_copy(current) if json_take_null(data, cursor)
            return json_parse_string(data, cursor)



    # Decode one quoted string DIRECTLY into `list` as a new entry. Like `json_skip_string_list`,
    # this cannot delegate to `json_parse_string`: the function returns void and so has no
    # region for an owned result. Appending into the list's own buffer avoids the temporary
    # altogether, which is the same trick the escape handling below relies on.
    def json_push_string_entry(data: darray[u8]&, cursor: mutable JsonCursor&, list: lmut StrList) -> void:
        can Memory.Allocate, Abort.Panic:
            if json_take_null(data, cursor):
                empty_start: usize = list.data.count
                list.starts <- list.starts.push(empty_start)
                list.lengths <- list.lengths.push(0.usize())
                return
            json_skip_ws(data, cursor)
            if json_at(data, cursor.position) != 34:
                cursor.ok <- false
                return
            cursor.position <- cursor.position + 1.usize()
            entry_start: usize = list.data.count
            while cursor.position < data.count |cursor, list, data|:
                byte: u8 = data[cursor.position]
                if byte == 34:
                    cursor.position <- cursor.position + 1.usize()
                    list.starts <- list.starts.push(entry_start)
                    list.lengths <- list.lengths.push(list.data.count - entry_start)
                    return
                if byte != 92:
                    if byte < 32:
                        cursor.ok <- false
                        return
                    if byte < 128:
                        list.data <- list.data.push(byte)
                        cursor.position <- cursor.position + 1.usize()
                        continue
                    width: usize = json_raw_utf8_width(data, cursor.position, data.count)
                    if width == 0.usize():
                        json_push_utf8(&list.data, 65533.u32())
                        cursor.position <- cursor.position + 1.usize()
                    else:
                        json_push_raw_utf8(&list.data, data, cursor.position, width)
                        cursor.position <- cursor.position + width
                    continue
                escape: u8 = json_at(data, cursor.position + 1.usize())
                cursor.position <- cursor.position + 2.usize()
                if escape == 34 or escape == 92 or escape == 47:
                    list.data <- list.data.push(escape)
                elif escape == 98:
                    list.data <- list.data.push(8)
                elif escape == 102:
                    list.data <- list.data.push(12)
                elif escape == 110:
                    list.data <- list.data.push(10)
                elif escape == 114:
                    list.data <- list.data.push(13)
                elif escape == 116:
                    list.data <- list.data.push(9)
                elif escape == 117:
                    first_unit: i64 = json_hex4(data, cursor.position)
                    if first_unit < 0:
                        cursor.ok <- false
                        return
                    cursor.position <- cursor.position + 4.usize()
                    code: i64 = json_unicode_escape_scalar(data, cursor, first_unit)
                    scalar: u32 = code.u32()
                    if scalar < 128:
                        list.data <- list.data.push(scalar.u8())
                    elif scalar < 2048:
                        list.data <- list.data.push((192 + (scalar / 64)).u8())
                        list.data <- list.data.push((128 + (scalar % 64)).u8())
                    elif scalar < 65536:
                        list.data <- list.data.push((224 + (scalar / 4096)).u8())
                        list.data <- list.data.push((128 + ((scalar / 64) % 64)).u8())
                        list.data <- list.data.push((128 + (scalar % 64)).u8())
                    else:
                        list.data <- list.data.push((240 + (scalar / 262144)).u8())
                        list.data <- list.data.push((128 + ((scalar / 4096) % 64)).u8())
                        list.data <- list.data.push((128 + ((scalar / 64) % 64)).u8())
                        list.data <- list.data.push((128 + (scalar % 64)).u8())
                else:
                    cursor.ok <- false
                    return
            cursor.ok <- false



    # Consume `[` ... `]` of strings into `list`. The cursor must be at the opening bracket.
    def json_read_string_list(data: darray[u8]&, cursor: mutable JsonCursor&, list: lmut StrList) -> void:
        can Memory.Allocate, Abort.Panic:
            if json_take_null(data, cursor):
                list <- StrList{data: [], starts: [], lengths: []}
                return
            json_skip_ws(data, cursor)
            if json_at(data, cursor.position) != 91:
                cursor.ok <- false
                return
            cursor.position <- cursor.position + 1.usize()
            first: mutable bool = true
            while cursor.ok |cursor, list, first, data|:
                json_skip_ws(data, cursor)
                if json_at(data, cursor.position) == 93:
                    cursor.position <- cursor.position + 1.usize()
                    break
                if not first:
                    if json_at(data, cursor.position) != 44:
                        cursor.ok <- false
                        break
                    cursor.position <- cursor.position + 1.usize()
                first <- false
                list <- json_push_string_entry(data, cursor, list)
                break if not cursor.ok



    # Step over a quoted string WITHOUT building it. The skipped platform's link flags still
    # have to be valid JSON strings, including valid escapes and no unescaped control bytes.
    def json_skip_string(data: darray[u8]&, cursor: mutable JsonCursor&) -> void:
        if json_at(data, cursor.position) != 34:
            cursor.ok <- false
            return
        cursor.position <- cursor.position + 1.usize()
        while cursor.position < data.count |cursor, data|:
            byte: u8 = data[cursor.position]
            if byte == 34:
                cursor.position <- cursor.position + 1.usize()
                return
            if byte < 32:
                cursor.ok <- false
                return
            if byte == 92:
                remaining: usize = data.count - cursor.position
                # Validate the escape before advancing, including the four hex digits after
                # `\u`; a skipped string must obey the same JSON grammar as a decoded one.
                if remaining < 2.usize():
                    cursor.ok <- false
                    return
                escape: u8 = data[cursor.position + 1.usize()]
                if escape == 34 or escape == 92 or escape == 47 or escape == 98 or escape == 102 or escape == 110 or escape == 114 or escape == 116:
                    cursor.position <- cursor.position + 2.usize()
                    continue
                if escape == 117:
                    if remaining < 6.usize() or json_hex4(data, cursor.position + 2.usize()) < 0:
                        cursor.ok <- false
                        return
                    cursor.position <- cursor.position + 6.usize()
                    continue
                cursor.ok <- false
                return
            cursor.position <- cursor.position + 1.usize()
        cursor.ok <- false



    # The unselected platform's field has the schema type `[]string`, not an arbitrary JSON
    # value. Validate its array and every string while discarding the payload; this also rejects
    # mismatched delimiters, nested values, malformed literals, and trailing commas.
    def json_skip_string_list(data: darray[u8]&, cursor: mutable JsonCursor&) -> void:
        json_skip_ws(data, cursor)
        return if json_take_null(data, cursor)
        if json_at(data, cursor.position) != 91:
            cursor.ok <- false
            return
        cursor.position <- cursor.position + 1.usize()
        first: mutable bool = true
        while cursor.ok |cursor, first, data|:
            json_skip_ws(data, cursor)
            if json_at(data, cursor.position) == 93:
                cursor.position <- cursor.position + 1.usize()
                return
            if not first:
                if json_at(data, cursor.position) != 44:
                    cursor.ok <- false
                    return
                cursor.position <- cursor.position + 1.usize()
                json_skip_ws(data, cursor)
            first <- false
            continue if json_take_null(data, cursor)
            json_skip_string(data, cursor)
        cursor.ok <- false



    def json_read_bool(data: darray[u8]&, cursor: mutable JsonCursor&, current: bool) -> bool:
        json_skip_ws(data, cursor)
        return current if json_take_null(data, cursor)
        if json_span_is(data, cursor.position, 4.usize(), "true"):
            cursor.position <- cursor.position + 4.usize()
            return true
        if json_span_is(data, cursor.position, 5.usize(), "false"):
            cursor.position <- cursor.position + 5.usize()
            return false
        cursor.ok <- false
        return false



    # Position the cursor at the value of the next key of an object, reporting the raw string
    # contents as a span into `data`. Key comparisons decode valid JSON escapes. Returns false
    # at `}`.
    def json_next_key(data: darray[u8]&, cursor: mutable JsonCursor&, first: mutable bool&, out_start: mutable usize&, out_length: mutable usize&) -> bool:
        json_skip_ws(data, cursor)
        if json_at(data, cursor.position) == 125:
            cursor.position <- cursor.position + 1.usize()
            return false
        # `not first` is rejected on a `mutable bool&` (it reads as a reference, not a
        # bool); the comparison form derefs.
        if first == false:
            if json_at(data, cursor.position) != 44:
                cursor.ok <- false
                return false
            cursor.position <- cursor.position + 1.usize()
            json_skip_ws(data, cursor)
            # Go rejects a trailing comma before `}`, so this does too.
            if json_at(data, cursor.position) == 125:
                cursor.ok <- false
                return false
        first <- false
        if json_at(data, cursor.position) != 34:
            cursor.ok <- false
            return false
        out_start <- cursor.position + 1.usize()
        json_skip_string(data, cursor)
        return false if not cursor.ok
        out_length <- cursor.position - out_start - 1.usize()
        json_skip_ws(data, cursor)
        if json_at(data, cursor.position) != 58:
            cursor.ok <- false
            return false
        cursor.position <- cursor.position + 1.usize()
        return true



    # Consume the `{` that opens an object.
    def json_open_object(data: darray[u8]&, cursor: mutable JsonCursor&) -> void:
        json_skip_ws(data, cursor)
        if json_at(data, cursor.position) != 123:
            cursor.ok <- false
            return
        cursor.position <- cursor.position + 1.usize()



    # After the top-level value: only whitespace may remain (Go reports trailing data).
    def json_finish(data: darray[u8]&, cursor: mutable JsonCursor&) -> void:
        json_skip_ws(data, cursor)
        cursor.ok <- false if cursor.position != data.count
