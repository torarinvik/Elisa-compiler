# Stage0 frontend-IR v2 IDs for expression statement nodes.
module FrontendIrExpressionStatementEncoding:
    public:
        const enum ExpressionStatementField of u8:
            Expr
            Position

        const EXPR_STMT_NODE_TYPE_ID: u32 = 60
        const EXPR_STMT_EXPR_FIELD_ID: u32 = 1
        const EXPR_STMT_POSITION_FIELD_ID: u32 = 2

        def node_type_id() -> u32:
            ensure result == EXPR_STMT_NODE_TYPE_ID
            return EXPR_STMT_NODE_TYPE_ID

        def field_id(field: ExpressionStatementField) -> u32:
            ensure field != ExpressionStatementField.Expr or result == EXPR_STMT_EXPR_FIELD_ID
            ensure field != ExpressionStatementField.Position or result == EXPR_STMT_POSITION_FIELD_ID
            match field:
                ExpressionStatementField.Expr:
                    return EXPR_STMT_EXPR_FIELD_ID
                ExpressionStatementField.Position:
                    return EXPR_STMT_POSITION_FIELD_ID
