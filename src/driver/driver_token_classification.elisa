# Closed token-kind sets shared by the AST and documentation emitters.
module DriverTokenClassification:
    public:
        def needs_ast_token_space(kind: Lexer::TokenKind) -> bool can[Abort.Panic]:
            ensure result == (kind == Lexer::TokenKind.Heap or kind == Lexer::TokenKind.Stack or kind == Lexer::TokenKind.Static or kind == Lexer::TokenKind.Mutable or kind == Lexer::TokenKind.Tail)
            can Abort.Panic:
                return when kind:
                    Lexer::TokenKind.Heap | Lexer::TokenKind.Stack | Lexer::TokenKind.Static | Lexer::TokenKind.Mutable | Lexer::TokenKind.Tail -> true
                    _ -> false

        def is_doc_binary_operator(kind: Lexer::TokenKind) -> bool can[Abort.Panic]:
            ensure result == (kind == Lexer::TokenKind.EqEq or kind == Lexer::TokenKind.BangEq or kind == Lexer::TokenKind.Lt or kind == Lexer::TokenKind.Gt or kind == Lexer::TokenKind.LtEq or kind == Lexer::TokenKind.GtEq or kind == Lexer::TokenKind.And or kind == Lexer::TokenKind.Or or kind == Lexer::TokenKind.Plus or kind == Lexer::TokenKind.Minus or kind == Lexer::TokenKind.Star or kind == Lexer::TokenKind.Slash)
            can Abort.Panic:
                return when kind:
                    Lexer::TokenKind.EqEq | Lexer::TokenKind.BangEq | Lexer::TokenKind.Lt | Lexer::TokenKind.Gt | Lexer::TokenKind.LtEq | Lexer::TokenKind.GtEq | Lexer::TokenKind.And | Lexer::TokenKind.Or | Lexer::TokenKind.Plus | Lexer::TokenKind.Minus | Lexer::TokenKind.Star | Lexer::TokenKind.Slash -> true
                    _ -> false
