# Driver — rendering an ACCUMULATOR finding (src/semantic/check_never_leak_accumulator.elisa).
#
# A rewritable finding names every accumulator of the loop with its declaration, first write and
# first later read, says why the shape is a problem, and prints the loop rewritten as a loop
# value with the user's own lines: the accumulator declarations move into the loop header
# (without `mutable`), the loop yields them with `->` (a tuple for several), the binding takes
# the declared names, and the loop body follows verbatim, one level deeper. An excluded candidate
# (strict mode only) says exactly why no rewrite applies.

# The pieces of `name: mutable T = init` on `line`: [type_start, type_stop) is `T`, init runs from
# init_start to the line's end. False when the line has another shape.
def nl_acc_decl_parts(source: NeverLeakSource&, line: u32, name: sview, type_start: mutable usize&, type_stop: mutable usize&, init_start: mutable usize&) -> bool can[Abort.Panic]:
    start: usize = nl_line_start(source, line) + nl_indent_width(source, line)
    stop: usize = nl_line_end(source, line)
    length: usize = sview_len(name).usize()
    false return if start + length + 2 > stop
    for offset in 0..<sview_len(name) |source, name, start|:
        false return if source.bytes[start + offset.usize()] != sview_at(name, offset)
    cursor: mutable usize = start + length
    false return if source.bytes[cursor] != 58
    cursor <- cursor + 1
    while cursor < stop and source.bytes[cursor] == 32 |cursor, source, stop|:
        cursor <- cursor + 1
    if nl_acc_starts_with(source, cursor, stop, "mutable "):
        cursor <- cursor + 8
    type_start <- cursor
    while cursor + 2 < stop and not (source.bytes[cursor] == 32 and source.bytes[cursor + 1] == 61 and source.bytes[cursor + 2] == 32) |cursor, source, stop|:
        cursor <- cursor + 1
    false return if cursor + 2 >= stop or cursor == type_start
    type_stop <- cursor
    init_start <- cursor + 3
    return true


def nl_acc_starts_with(source: NeverLeakSource&, at: usize, stop: usize, text: sview) -> bool can[Abort.Panic]:
    length: usize = sview_len(text).usize()
    false return if at + length > stop
    for offset in 0..<sview_len(text) |source, at, text|:
        false return if source.bytes[at + offset.usize()] != sview_at(text, offset)
    return true


# Where the loop header's trailing `:` sits on its line (0 when the header does not end there,
# i.e. it continues on later lines or already carries a `|...|` header).
def nl_acc_header_colon(source: NeverLeakSource&, line: u32) -> usize can[Abort.Panic]:
    start: usize = nl_line_start(source, line)
    stop: mutable usize = nl_line_end(source, line)
    while stop > start and (source.bytes[stop - 1] == 32 or source.bytes[stop - 1] == 9) |stop, source, start|:
        stop <- stop - 1
    0 return if stop == start or source.bytes[stop - 1] != 58
    for scan in start..<stop |source|:
        0 return if source.bytes[scan] == 124
    return stop - 1


# The reason to report: the semantic one, or SHAPE when a declaration does not fit on its line
# (a continuation line follows it) or the loop header does not end on its first line.
def nl_acc_reason(finding: Semantic::NeverLeakFinding&, names: darray[sview]&, name_lines: darray[u32]&, source: NeverLeakSource&) -> u8 can[Abort.Panic]:
    finding.acc_reason return if finding.acc_reason != Semantic::NEVER_LEAK_ACC_OK
    Semantic::NEVER_LEAK_ACC_SHAPE return if nl_acc_header_colon(source, finding.last_use_line) == 0
    for member in 0..<finding.acc_count |finding, names, name_lines, source|:
        entry: usize = (finding.acc_first + member).usize()
        decl_line: u32 = name_lines[entry * 3]
        type_start: mutable usize = 0
        type_stop: mutable usize = 0
        init_start: mutable usize = 0
        Semantic::NEVER_LEAK_ACC_SHAPE return if not nl_acc_decl_parts(source, decl_line, names[entry], type_start, type_stop, init_start)
        # A deeper-indented line right after the declaration continues it.
        Semantic::NEVER_LEAK_ACC_SHAPE return if not nl_line_is_filler(source, decl_line + 1) and nl_indent_width(source, decl_line + 1) > nl_indent_width(source, decl_line)
    return Semantic::NEVER_LEAK_ACC_OK


def nl_acc_push_names(text: mutable darray[u8]&, finding: Semantic::NeverLeakFinding&, names: darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    for member in 0..<finding.acc_count |text, finding, names|:
        if member > 0:
            emit_tokens_push_sview(text, " and " if member + 1 == finding.acc_count else ", ")
        nl_push_name(text, names[(finding.acc_first + member).usize()])


def nl_report_accumulator(finding: Semantic::NeverLeakFinding&, names: darray[sview]&, name_lines: darray[u32]&, source: NeverLeakSource&, mode: u8, reason: u8) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    text: mutable darray[u8] = []
    several: bool = finding.acc_count > 1
    nl_push_location(text, source, finding.decl_line)
    emit_tokens_push_sview(text, ": error: " if mode == 2 else ": warning: ")
    emit_tokens_push_sview(text, "accumulators " if several else "accumulator ")
    nl_acc_push_names(text, finding, names)
    emit_tokens_push_sview(text, " stay mutable and visible after their loop [-Wnever-leak]\n" if several else " stays mutable and visible after its loop [-Wnever-leak]\n")
    rewritable: bool = reason == Semantic::NEVER_LEAK_ACC_OK
    for member in 0..<finding.acc_count |text, finding, names, name_lines, source, rewritable|:
        entry: usize = (finding.acc_first + member).usize()
        emit_tokens_push_sview(text, "  ")
        nl_push_name(text, names[entry])
        emit_tokens_push_sview(text, ": declared `mutable` on ")
        nl_push_line_ref(text, source, name_lines[entry * 3])
        emit_tokens_push_sview(text, "; written only inside the loop on " if rewritable else "; written inside the loop on ")
        nl_push_line_ref(text, source, finding.last_use_line)
        if name_lines[entry * 3 + 1] != 0 and name_lines[entry * 3 + 1] != finding.last_use_line:
            emit_tokens_push_sview(text, " (first write: ")
            nl_push_line_ref(text, source, name_lines[entry * 3 + 1])
            text.push(41)
        emit_tokens_push_sview(text, "; read only after it (first read: " if rewritable else "; read after it (first read: ")
        nl_push_line_ref(text, source, name_lines[entry * 3 + 2])
        emit_tokens_push_sview(text, ")\n")
    if rewritable:
        emit_tokens_push_sview(text, "  kind: accumulator (a `mutable` local that only a loop writes and only code after the loop reads)\n")
    else:
        emit_tokens_push_sview(text, "  kind: accumulator candidate (a `mutable` local a loop writes and later code reads; reported by -Wnever-leak=strict only)\n")
    if reason != Semantic::NEVER_LEAK_ACC_OK:
        nl_acc_render_excluded(text, finding, names, source, reason)
        write_stderr(text)
        return
    emit_tokens_push_sview(text, "  why: once the loop ends ")
    emit_tokens_push_sview(text, "they are" if several else "it is")
    emit_tokens_push_sview(text, " finished, yet ")
    emit_tokens_push_sview(text, "they stay" if several else "it stays")
    emit_tokens_push_sview(text, " `mutable` and in scope, so any later line could still change ")
    emit_tokens_push_sview(text, "them" if several else "it")
    emit_tokens_push_sview(text, "; as the loop's value ")
    emit_tokens_push_sview(text, "they become immutable bindings" if several else "it becomes one immutable binding")
    emit_tokens_push_sview(text, " that only the loop computes\n")
    emit_tokens_push_sview(text, "  fix: declare ")
    emit_tokens_push_sview(text, "them" if several else "it")
    emit_tokens_push_sview(text, " in the loop header and let the loop yield ")
    emit_tokens_push_sview(text, "them as a tuple" if several else "it")
    emit_tokens_push_sview(text, " (same machine code as the `mutable` form at -O0 and -O2; `break` still ends the loop, and a loop that runs zero times yields the initial value):\n")
    nl_acc_render_rewrite(text, finding, names, name_lines, source)
    write_stderr(text)


def nl_acc_render_excluded(text: mutable darray[u8]&, finding: Semantic::NeverLeakFinding&, names: darray[sview]&, source: NeverLeakSource&, reason: u8) -> void can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(text, "  no loop-value rewrite applies: ")
    if reason == Semantic::NEVER_LEAK_ACC_READ_INSIDE:
        emit_tokens_push_sview(text, "the loop also reads ")
        nl_push_name(text, finding.name)
        emit_tokens_push_sview(text, " on ")
        nl_push_line_ref(text, source, finding.reason_line)
        emit_tokens_push_sview(text, " outside its own update (")
        nl_push_quoted_line(text, source, finding.reason_line)
        emit_tokens_push_sview(text, "), so it is loop state the body depends on, not a value the loop only produces\n")
    elif reason == Semantic::NEVER_LEAK_ACC_WRITTEN_AFTER:
        emit_tokens_push_sview(text, "")
        nl_push_quoted_line(text, source, finding.reason_line)
        emit_tokens_push_sview(text, " on ")
        nl_push_line_ref(text, source, finding.reason_line)
        emit_tokens_push_sview(text, " changes ")
        nl_push_name(text, finding.name)
        emit_tokens_push_sview(text, " after the loop (an assignment, a mutating call or its address), so it has to stay `mutable` past the loop\n")
    elif reason == Semantic::NEVER_LEAK_ACC_NOT_SCALAR:
        emit_tokens_push_sview(text, "its type is not a scalar or an optional scalar, so a loop value would copy it into the binding instead of reusing the loop's storage (the rewrite promises identical machine code)\n")
    elif reason == Semantic::NEVER_LEAK_ACC_ESCAPES:
        emit_tokens_push_sview(text, "the loop on ")
        nl_push_line_ref(text, source, finding.reason_line)
        emit_tokens_push_sview(text, " contains a `break`/`continue` for an enclosing loop, which may not leave a loop value\n")
    else:
        emit_tokens_push_sview(text, "the declaration on ")
        nl_push_line_ref(text, source, finding.decl_line)
        emit_tokens_push_sview(text, " or the loop header on ")
        nl_push_line_ref(text, source, finding.last_use_line)
        emit_tokens_push_sview(text, " is not a one-line `name: mutable T = init` / `for …:` line, so it cannot move into a loop header as written; put it on one line and the rewrite applies\n")


# The rewrite (see the file header). Statements between the first accumulator's declaration and
# the loop that declare no accumulator stay where they are.
def nl_acc_render_rewrite(text: mutable darray[u8]&, finding: Semantic::NeverLeakFinding&, names: darray[sview]&, name_lines: darray[u32]&, source: NeverLeakSource&) -> void can[Abort.Panic, Memory.Allocate]:
    loop_line: u32 = finding.last_use_line
    indent: usize = nl_indent_width(source, loop_line)
    for line in finding.decl_line..<loop_line |text, finding, name_lines, source|:
        declares: mutable bool = false
        for member in 0..<finding.acc_count |declares, finding, name_lines, line|:
            declares <- true if name_lines[((finding.acc_first + member) * 3).usize()] == line
        nl_push_shifted_line(text, source, line, 0) if not declares
    # The binding: `sum: usize =` for one accumulator, `total, count =` for several.
    nl_push_spaces(text, 6 + indent)
    first_entry: usize = finding.acc_first.usize()
    if finding.acc_count == 1:
        type_start: mutable usize = 0
        type_stop: mutable usize = 0
        init_start: mutable usize = 0
        _ = nl_acc_decl_parts(source, name_lines[first_entry * 3], names[first_entry], type_start, type_stop, init_start)
        emit_tokens_push_sview(text, names[first_entry])
        emit_tokens_push_sview(text, ": ")
        nl_push_bytes(text, source, type_start, type_stop)
    else:
        for member in 0..<finding.acc_count |text, finding, names|:
            emit_tokens_push_sview(text, ", ") if member > 0
            emit_tokens_push_sview(text, names[(finding.acc_first + member).usize()])
    emit_tokens_push_sview(text, " =\n")
    # The loop header gains `|decls| -> yield` before its `:`.
    colon: usize = nl_acc_header_colon(source, loop_line)
    nl_push_spaces(text, 6 + 4)
    nl_push_bytes(text, source, nl_line_start(source, loop_line), colon)
    emit_tokens_push_sview(text, " |")
    for member in 0..<finding.acc_count |text, finding, names, name_lines, source|:
        entry: usize = (finding.acc_first + member).usize()
        type_start: mutable usize = 0
        type_stop: mutable usize = 0
        init_start: mutable usize = 0
        _ = nl_acc_decl_parts(source, name_lines[entry * 3], names[entry], type_start, type_stop, init_start)
        emit_tokens_push_sview(text, ", ") if member > 0
        emit_tokens_push_sview(text, names[entry])
        emit_tokens_push_sview(text, ": ")
        nl_push_bytes(text, source, type_start, type_stop)
        emit_tokens_push_sview(text, " = ")
        nl_push_bytes(text, source, init_start, nl_line_end(source, name_lines[entry * 3]))
    emit_tokens_push_sview(text, "| -> ")
    if finding.acc_count == 1:
        emit_tokens_push_sview(text, names[first_entry])
    else:
        text.push(40)
        for member in 0..<finding.acc_count |text, finding, names|:
            emit_tokens_push_sview(text, ", ") if member > 0
            emit_tokens_push_sview(text, names[(finding.acc_first + member).usize()])
        text.push(41)
    emit_tokens_push_sview(text, ":\n")
    # The whole body, never elided: the rewrite must paste as is.
    loop_last: u32 = nl_statement_last_line(source, loop_line, finding.after_last_line)
    for body_line in (loop_line + 1)..<(loop_last + 1) |text, source|:
        nl_push_shifted_line(text, source, body_line, 4)
    nl_push_shifted_line(text, source, finding.after_last_line, 0)
