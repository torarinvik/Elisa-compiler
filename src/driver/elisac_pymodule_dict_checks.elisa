# `-emit pymodule` — dict CLEANUP and the key/value range checks.


def emit_pymodule_dict_cleanup(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, indent: sview) -> void can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(buffer, indent)
    emit_tokens_push_sview(buffer, "elisa_pymodule_annotate_argument_error(elisa_pymodule_current_function, elisa_pymodule_current_parameter);\n")
    for cleanup_index in 0..<target_params.count |buffer, target_params, indent|:
        cleanup_type_name: sview = pymodule_bare_type_name(target_params[cleanup_index].type_expression)
        is_dict_param: bool = pymodule_expression_is_dict(target_params[cleanup_index].type_expression)
        continue if not is_dict_param and not pymodule_is_dict_type(cleanup_type_name) and not pymodule_is_set_type(cleanup_type_name)
        emit_tokens_push_sview(buffer, indent)
        emit_tokens_push_sview(buffer, "if (arg")
        append_decimal(buffer, cleanup_index.i64())
        emit_tokens_push_sview(buffer, "_materialized) { ")
        if is_dict_param:
            emit_tokens_push_sview(buffer, "elisa_pymodule_struct_refs_free(&arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_struct_refs); ")
        emit_tokens_push_sview(buffer, "arena_free(&arg")
        append_decimal(buffer, cleanup_index.i64())
        emit_tokens_push_sview(buffer, "_arena); Py_DECREF(arg")
        append_decimal(buffer, cleanup_index.i64())
        emit_tokens_push_sview(buffer, "); }\n")




def emit_pymodule_dict_cleanup_before(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, parameter_index: usize, indent: sview) -> void can[Abort.Panic, Memory.Allocate]:
    emit_tokens_push_sview(buffer, indent)
    emit_tokens_push_sview(buffer, "elisa_pymodule_annotate_argument_error(elisa_pymodule_current_function, elisa_pymodule_current_parameter);\n")
    for cleanup_index in 0..<parameter_index |buffer, target_params, indent|:
        cleanup_type_name: sview = pymodule_bare_type_name(target_params[cleanup_index].type_expression)
        is_dict_param: bool = pymodule_expression_is_dict(target_params[cleanup_index].type_expression)
        continue if not is_dict_param and not pymodule_is_dict_type(cleanup_type_name) and not pymodule_is_set_type(cleanup_type_name)
        emit_tokens_push_sview(buffer, indent)
        emit_tokens_push_sview(buffer, "if (arg")
        append_decimal(buffer, cleanup_index.i64())
        emit_tokens_push_sview(buffer, "_materialized) { ")
        if is_dict_param:
            emit_tokens_push_sview(buffer, "elisa_pymodule_struct_refs_free(&arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_struct_refs); ")
        emit_tokens_push_sview(buffer, "arena_free(&arg")
        append_decimal(buffer, cleanup_index.i64())
        emit_tokens_push_sview(buffer, "_arena); Py_DECREF(arg")
        append_decimal(buffer, cleanup_index.i64())
        emit_tokens_push_sview(buffer, "); }\n")




def emit_pymodule_dict_cleanup_one(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, parameter_index: usize, indent: sview) -> void can[Abort.Panic, Memory.Allocate]:
    # Struct dictionary fields reuse the parameter-oriented materializer with
    # no function parameter table.  In that case there is nothing to clean up
    # here; avoid indexing past the empty table while still preserving the
    # existing behavior for real parameters.
    return if parameter_index >= target_params.count
    emit_tokens_push_sview(buffer, indent)
    emit_tokens_push_sview(buffer, "elisa_pymodule_annotate_argument_error(elisa_pymodule_current_function, elisa_pymodule_current_parameter);\n")
    for cleanup_index in 0..<(parameter_index + 1) |buffer, parameter_index, indent|:
        cleanup_type_name: sview = pymodule_bare_type_name(target_params[cleanup_index].type_expression)
        is_dict_param: bool = pymodule_expression_is_dict(target_params[cleanup_index].type_expression)
        continue if not is_dict_param and not pymodule_is_dict_type(cleanup_type_name) and not pymodule_is_set_type(cleanup_type_name)
        emit_tokens_push_sview(buffer, indent)
        emit_tokens_push_sview(buffer, "if (arg")
        append_decimal(buffer, cleanup_index.i64())
        emit_tokens_push_sview(buffer, "_materialized) { ")
        if is_dict_param:
            emit_tokens_push_sview(buffer, "elisa_pymodule_struct_refs_free(&arg")
            append_decimal(buffer, cleanup_index.i64())
            emit_tokens_push_sview(buffer, "_struct_refs); ")
        emit_tokens_push_sview(buffer, "arena_free(&arg")
        append_decimal(buffer, cleanup_index.i64())
        emit_tokens_push_sview(buffer, "_arena); Py_DECREF(arg")
        append_decimal(buffer, cleanup_index.i64())
        emit_tokens_push_sview(buffer, "); }\n")




def emit_pymodule_dict_value_range_check(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, value_name: sview, parameter_index: usize) -> void can[Abort.Panic, Memory.Allocate]:
    lower: mutable sview = ""
    upper: mutable sview = ""
    if value_name == "i8":
        lower <- "INT8_MIN"
        upper <- "INT8_MAX"
    elif value_name == "i16":
        lower <- "INT16_MIN"
        upper <- "INT16_MAX"
    elif value_name == "i32":
        lower <- "INT32_MIN"
        upper <- "INT32_MAX"
    elif value_name == "u8":
        upper <- "UINT8_MAX"
    elif value_name == "u16":
        upper <- "UINT16_MAX"
    elif value_name == "u32":
        upper <- "UINT32_MAX"
    return if lower == "" and upper == ""
    emit_tokens_push_sview(buffer, "        if (")
    if lower != "":
        emit_tokens_push_sview(buffer, "arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_value_scalar < ")
        emit_tokens_push_sview(buffer, lower)
        emit_tokens_push_sview(buffer, " || ")
    emit_tokens_push_sview(buffer, "arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_value_scalar > ")
    emit_tokens_push_sview(buffer, upper)
    emit_tokens_push_sview(buffer, ") {\n")
    emit_pymodule_dict_cleanup(buffer, target_params, "            ")
    emit_tokens_push_sview(buffer, "            PyErr_SetString(PyExc_OverflowError, \"dictionary value out of range\"); return NULL;\n        }\n")




def emit_pymodule_dict_key_range_check(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, key_name: sview, parameter_index: usize) -> void can[Abort.Panic, Memory.Allocate]:
    lower: mutable sview = ""
    upper: mutable sview = ""
    if key_name == "i8":
        lower <- "INT8_MIN"
        upper <- "INT8_MAX"
    elif key_name == "i16":
        lower <- "INT16_MIN"
        upper <- "INT16_MAX"
    elif key_name == "i32":
        lower <- "INT32_MIN"
        upper <- "INT32_MAX"
    elif key_name == "u8":
        upper <- "UINT8_MAX"
    elif key_name == "u16":
        upper <- "UINT16_MAX"
    elif key_name == "u32":
        upper <- "UINT32_MAX"
    return if lower == "" and upper == ""
    emit_tokens_push_sview(buffer, "        if (")
    if lower != "":
        emit_tokens_push_sview(buffer, "arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_key_number < ")
        emit_tokens_push_sview(buffer, lower)
        emit_tokens_push_sview(buffer, " || ")
    emit_tokens_push_sview(buffer, "arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_key_number > ")
    emit_tokens_push_sview(buffer, upper)
    emit_tokens_push_sview(buffer, ") {\n")
    emit_pymodule_dict_cleanup_one(buffer, target_params, parameter_index, "            ")
    emit_tokens_push_sview(buffer, "            PyErr_SetString(PyExc_OverflowError, \"dictionary key out of range\"); return NULL;\n        }\n")
