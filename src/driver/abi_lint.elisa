# Stage1's `project abi-lint`: stage0's src/native_abi_lint.go.
#
# The report half is ordinary formatting over a resolved target. The LINT half is twelve
# regexes in stage0, and Elisa has no regex library, so each one is a hand-rolled matcher
# below. That is the risk in this file: a matcher that is subtly too narrow makes the tool
# print "ABI lint: clean" for a project it did not actually check — a false clean is worse
# than no lint at all. So each matcher names the pattern it stands for, and the smoke drives
# one fixture per rule against stage0 rather than trusting the translation.
#
# Go's `\b` is a boundary between a word byte ([0-9A-Za-z_]) and anything else, including the
# string edges; `abi_word_at` implements exactly that and every `\b` matcher goes through it.

extend ProjectSystem:

    # ---- byte matchers ---------------------------------------------------------------------

    def abi_is_word_byte(value: u8) -> bool:
        return (value >= 48 and value <= 57) or (value >= 65 and value <= 90) or (value >= 97 and value <= 122) or value == 95

    def abi_lower(value: u8) -> u8:
        return value + 32 if value >= 65 and value <= 90 else value

    # Does `text` contain `needle` at `start`?
    def abi_span_is(text: darray[u8]&, start: usize, needle: sview) -> bool:
        false return if start + sview_len(needle) > text.count
        for index in 0..<sview_len(needle) |text, needle, start|:
            false return if text[start + index] != sview_at(needle, index)
        return true

    # Case-insensitive form of abi_span_is (Go's `(?i)`).
    def abi_span_is_ci(text: darray[u8]&, start: usize, needle: sview) -> bool:
        false return if start + sview_len(needle) > text.count
        for index in 0..<sview_len(needle) |text, needle, start|:
            false return if abi_lower(text[start + index]) != abi_lower(sview_at(needle, index))
        return true

    def abi_contains(text: darray[u8]&, needle: sview) -> bool:
        false return if sview_len(needle) == 0.usize()
        for start in 0..<text.count |text, needle|:
            true return if abi_span_is(text, start, needle)
        return false

    def abi_contains_ci(text: darray[u8]&, needle: sview) -> bool:
        false return if sview_len(needle) == 0.usize()
        for start in 0..<text.count |text, needle|:
            true return if abi_span_is_ci(text, start, needle)
        return false

    # `needle` as a WHOLE WORD: `\bneedle\b`, searched in `text[from ..< to)`. The span form
    # is what the line-scoped patterns need, and it means no matcher here has to COPY a line
    # out — a bool-returning function has no region to allocate one in.
    def abi_word_in_span(text: darray[u8]&, span_start: usize, span_stop: usize, needle: sview) -> bool:
        false return if sview_len(needle) == 0.usize()
        length: usize = sview_len(needle)
        stop: usize = span_stop if span_stop <= text.count else text.count
        for start in span_start..<stop |text, needle, length, stop, span_start|:
            continue if start + length > stop
            continue if not abi_span_is(text, start, needle)
            before_ok: bool = start == span_start or not abi_is_word_byte(text[start - 1.usize()])
            after_ok: bool = start + length >= stop or not abi_is_word_byte(text[start + length])
            true return if before_ok and after_ok
        return false

    def abi_contains_word(text: darray[u8]&, needle: sview) -> bool:
        return abi_word_in_span(text, 0.usize(), text.count, needle)

    # ---- the twelve patterns -----------------------------------------------------------------

    # `\b(__asm__|asm)\b`
    def abi_has_asm_token(text: darray[u8]&) -> bool:
        return abi_contains_word(text, "__asm__") or abi_contains_word(text, "asm")

    # `(?i)(RunMainEntry|guest_exec|GuestExec|entry_trampoline|call_main_entry|jump_main_entry)`
    # — case-insensitive, so `guest_exec` and `GuestExec` collapse to one probe.
    def abi_is_guestish(text: darray[u8]&) -> bool:
        true return if abi_contains_ci(text, "runmainentry")
        true return if abi_contains_ci(text, "guest_exec")
        true return if abi_contains_ci(text, "entry_trampoline")
        true return if abi_contains_ci(text, "call_main_entry")
        true return if abi_contains_ci(text, "jump_main_entry")
        return false

    # `%[0-9]` — a positional operand. Note `%%rdi` does NOT match: the byte after `%` is
    # another `%`, not a digit.
    def abi_has_positional_operand(text: darray[u8]&) -> bool:
        for index in 0..<text.count |text|:
            continue if text[index] != 37
            continue if index + 1.usize() >= text.count
            next_byte: u8 = text[index + 1.usize()]
            true return if next_byte >= 48 and next_byte <= 57
        return false

    # `%%r(di|si|dx|cx|8|9)\b` — an ABI ARGUMENT register.
    def abi_has_arg_register(text: darray[u8]&) -> bool:
        true return if abi_register_suffix_at(text, "%%rdi")
        true return if abi_register_suffix_at(text, "%%rsi")
        true return if abi_register_suffix_at(text, "%%rdx")
        true return if abi_register_suffix_at(text, "%%rcx")
        true return if abi_register_suffix_at(text, "%%r8")
        true return if abi_register_suffix_at(text, "%%r9")
        return false

    # `%%r(9|10|11)\b` — scratch parking.
    def abi_has_scratch_parking(text: darray[u8]&) -> bool:
        true return if abi_register_suffix_at(text, "%%r9")
        true return if abi_register_suffix_at(text, "%%r10")
        true return if abi_register_suffix_at(text, "%%r11")
        return false

    # A register spelling followed by a word BOUNDARY. `%` is not a word byte, so only the
    # trailing edge needs checking — which is what keeps `%%r1` from matching `%%r10`.
    def abi_register_in_span(text: darray[u8]&, span_start: usize, span_stop: usize, spelling: sview) -> bool:
        length: usize = sview_len(spelling)
        stop: usize = span_stop if span_stop <= text.count else text.count
        for start in span_start..<stop |text, spelling, length, stop|:
            continue if start + length > stop
            continue if not abi_span_is(text, start, spelling)
            true return if start + length >= stop or not abi_is_word_byte(text[start + length])
        return false

    def abi_register_suffix_at(text: darray[u8]&, spelling: sview) -> bool:
        return abi_register_in_span(text, 0.usize(), text.count, spelling)

    # `\b(pushq|popq)\b|\b(andq|subq|addq|lea)\b[^\n]*%%rsp\b`
    def abi_has_stack_mutation(text: darray[u8]&) -> bool:
        true return if abi_contains_word(text, "pushq")
        true return if abi_contains_word(text, "popq")
        # The second alternative is LINE-SCOPED: `[^\n]*` cannot cross a newline, so the
        # instruction and the `%%rsp` it touches must appear on the same line.
        line_start: mutable usize = 0.usize()
        found: mutable bool = false
        for index in 0..<text.count + 1.usize() |line_start, found, text|:
            continue if found
            at_end: bool = index == text.count
            continue if not at_end and text[index] != 10
            has_instruction: bool = abi_word_in_span(text, line_start, index, "andq") or abi_word_in_span(text, line_start, index, "subq") or abi_word_in_span(text, line_start, index, "addq") or abi_word_in_span(text, line_start, index, "lea")
            found <- true if has_instruction and abi_register_in_span(text, line_start, index, "%%rsp")
            line_start <- index + 1.usize()
        return found

    # `\bcall\s+\*` and `\bjmp\s+\*` — an INDIRECT call/jump.
    def abi_has_indirect(text: darray[u8]&, keyword: sview) -> bool:
        length: usize = sview_len(keyword)
        for start in 0..<text.count |text, keyword, length|:
            continue if not abi_span_is(text, start, keyword)
            continue if start != 0.usize() and abi_is_word_byte(text[start - 1.usize()])
            cursor: mutable usize = start + length
            spaces: mutable usize = 0.usize()
            while cursor < text.count |cursor, spaces, text|:
                break if not (text[cursor] == 32 or text[cursor] == 9)
                cursor <- cursor + 1.usize()
                spaces <- spaces + 1.usize()
            # `\s+` is ONE OR MORE, so `call*` does not match.
            continue if spaces == 0.usize()
            true return if cursor < text.count and text[cursor] == 42
        return false

    # `(?i)(noreturn|__builtin_unreachable|\[\[noreturn\]\])` — the bracketed spelling
    # contains "noreturn", so the plain probe already covers it.
    def abi_is_noreturnish(text: darray[u8]&) -> bool:
        return abi_contains_ci(text, "noreturn") or abi_contains_ci(text, "__builtin_unreachable")

    # `"memory"`, quotes included.
    def abi_has_memory_clobber(text: darray[u8]&) -> bool:
        return abi_contains(text, "\"memory\"")

    # `ELISA_ABI_LINT_ALLOW(<code>)` or `(all)` anywhere in the block suppresses a rule.
    def abi_lint_allowed(block: darray[u8]&, code: sview) -> bool:
        prefix: sview = "ELISA_ABI_LINT_ALLOW("
        for start in 0..<block.count |block, prefix, code|:
            continue if not abi_span_is(block, start, prefix)
            after: usize = start + sview_len(prefix)
            continue if not abi_span_is(block, after, code)
            closing: usize = after + sview_len(code)
            true return if closing < block.count and block[closing] == 41
        return abi_contains(block, "ELISA_ABI_LINT_ALLOW(all)")

    # ---- issues ------------------------------------------------------------------------------
    #
    # Issues are FOUR entries per row in one flat StrList (severity, code, file, message) plus
    # a parallel line column, rather than a struct of four StrLists.
    #
    # Not a style choice: `lmut` threading only works on the PARAMETER itself. Writing
    # `issues.severity <- strlist_push_view(issues.severity, …)` on a struct FIELD is rejected
    # ("cannot assign void"), so a struct of lists cannot be appended to at all through the
    # one form the mutability rules allow. A single list threaded as the lmut param can.

    # The message is an sview, not a built darray: this returns void and so has no region to
    # allocate one in. The one rule whose message varies passes one of two constants.
    def abi_push_issue(fields: lmut StrList, severity: sview, code: sview, file: darray[u8]&, message: sview) -> void:
        can Memory.Allocate, Abort.Panic:
            fields <- strlist_push_view(fields, severity)
            fields <- strlist_push_view(fields, code)
            fields <- strlist_push(fields, file)
            fields <- strlist_push_view(fields, message)

    # Append to the LAST entry rather than adding a new one. The read-failure message has to
    # embed a PATH, and this function has no region to concatenate one in, so the message is
    # assembled directly in the list's backing buffer instead.
    def abi_extend_last(fields: lmut StrList, value: darray[u8]&) -> void:
        can Memory.Allocate, Abort.Panic:
            return if fields.lengths.count == 0.usize()
            for index in 0..<value.count |fields, value|:
                fields.data <- fields.data.push(value[index])
            last: usize = fields.lengths.count - 1.usize()
            fields.lengths[last] <- fields.lengths[last] + value.count

    def abi_extend_last_view(fields: lmut StrList, text: sview) -> void:
        can Memory.Allocate, Abort.Panic:
            return if fields.lengths.count == 0.usize()
            for index in 0..<sview_len(text) |fields, text|:
                fields.data <- fields.data.push(sview_at(text, index))
            last: usize = fields.lengths.count - 1.usize()
            fields.lengths[last] <- fields.lengths[last] + sview_len(text)

    def abi_issue_count(fields: StrList&) -> usize:
        return strlist_count(fields) / 4.usize()

    # `ELISA_ABI_CONTRACT\s+([^\n*/]+)`, trimmed — the payload stops at a newline or at the
    # `*/` that closes the comment it usually sits in.
    def abi_collect_contracts(text: darray[u8]&) -> StrList:
        can Memory.Allocate, Abort.Panic:
            # The brace literal, not strlist_new(): a StrList-RETURNING call pins the local's
            # region and the `lmut` thread below can then no longer infer one (same note as
            # strlist_dedupe in project.elisa).
            found: mutable StrList = StrList{data: [], starts: [], lengths: []}
            marker: sview = "ELISA_ABI_CONTRACT"
            index: mutable usize = 0.usize()
            while index < text.count |index, found, text, marker|:
                if not abi_span_is(text, index, marker):
                    index <- index + 1.usize()
                    continue
                cursor: mutable usize = index + sview_len(marker)
                spaces: mutable usize = 0.usize()
                while cursor < text.count |cursor, spaces, text|:
                    break if not (text[cursor] == 32 or text[cursor] == 9)
                    cursor <- cursor + 1.usize()
                    spaces <- spaces + 1.usize()
                if spaces == 0.usize():
                    index <- index + sview_len(marker)
                    continue
                value_start: usize = cursor
                while cursor < text.count |cursor, text|:
                    break if text[cursor] == 10 or text[cursor] == 42 or text[cursor] == 47
                    cursor <- cursor + 1.usize()
                value_stop: mutable usize = cursor
                # TrimSpace on the captured payload.
                while value_stop > value_start |value_stop, text|:
                    break if not (text[value_stop - 1.usize()] == 32 or text[value_stop - 1.usize()] == 9 or text[value_stop - 1.usize()] == 13)
                    value_stop <- value_stop - 1.usize()
                found <- strlist_push_span(found, text, value_start, value_stop - value_start) if value_stop > value_start
                index <- cursor
            return found

    # The asm block starting at `start_line`: lines are accumulated until parentheses balance
    # on a line containing `;`, or 80 lines pass. Returns the END line (inclusive).
    def abi_asm_block_end(text: darray[u8]&, line_starts: darray[usize]&, start_line: usize) -> usize:
        depth: mutable i64 = 0
        saw_paren: mutable bool = false
        result: mutable usize = line_starts.count - 1.usize()
        settled: mutable bool = false
        for line_index in start_line..<line_starts.count |depth, saw_paren, result, settled, text, line_starts, start_line|:
            continue if settled
            stop: usize = line_starts[line_index + 1.usize()] - 1.usize() if line_index + 1.usize() < line_starts.count else text.count
            semicolon: mutable bool = false
            for byte_index in line_starts[line_index]..<stop |depth, saw_paren, semicolon, text|:
                if text[byte_index] == 40:
                    depth <- depth + 1
                    saw_paren <- true
                elif text[byte_index] == 41 and depth > 0:
                    depth <- depth - 1
                elif text[byte_index] == 59:
                    semicolon <- true
            if saw_paren and depth == 0 and semicolon:
                result <- line_index
                settled <- true
            elif line_index - start_line >= 80.usize():
                result <- line_index
                settled <- true
        return result

    # 1-based start offset of every line in `text`.
    def abi_line_starts(text: darray[u8]&) -> darray[usize]:
        can Memory.Allocate, Abort.Panic:
            starts: mutable darray[usize] = [0.usize()]
            for index in 0..<text.count |starts, text|:
                starts <- starts.push(index + 1.usize()) if text[index] == 10
            return starts

    # Is this a C/C++ source or header? stage0 scans only these, by lowercased extension.
    def abi_is_native_source(path: darray[u8]&) -> bool:
        dot: mutable usize = path.count
        for index in 0..<path.count |dot, path|:
            dot <- index if path[index] == 46
        false return if dot >= path.count
        extension: mutable darray[u8] = []
        for index in dot..<path.count |extension, path|:
            extension.push(abi_lower(path[index]))
        true return if bytes_equal_view(extension, ".c")
        true return if bytes_equal_view(extension, ".cc")
        true return if bytes_equal_view(extension, ".cpp")
        true return if bytes_equal_view(extension, ".cxx")
        true return if bytes_equal_view(extension, ".h")
        true return if bytes_equal_view(extension, ".hpp")
        true return if bytes_equal_view(extension, ".hh")
        return false

    # `^\s*#\s*include\s+"([^"]+)"` — the QUOTED include on this line, or empty.
    def abi_quoted_include(text: darray[u8]&, line_start: usize, line_stop: usize) -> darray[u8]:
        can Memory.Allocate, Abort.Panic:
            empty: mutable darray[u8] = []
            cursor: mutable usize = line_start
            while cursor < line_stop |cursor, text|:
                break if not (text[cursor] == 32 or text[cursor] == 9)
                cursor <- cursor + 1.usize()
            empty return if cursor >= line_stop or text[cursor] != 35
            cursor <- cursor + 1.usize()
            while cursor < line_stop |cursor, text|:
                break if not (text[cursor] == 32 or text[cursor] == 9)
                cursor <- cursor + 1.usize()
            empty return if not abi_span_is(text, cursor, "include")
            cursor <- cursor + 7.usize()
            spaces: mutable usize = 0.usize()
            while cursor < line_stop |cursor, spaces, text|:
                break if not (text[cursor] == 32 or text[cursor] == 9)
                cursor <- cursor + 1.usize()
                spaces <- spaces + 1.usize()
            empty return if spaces == 0.usize()
            empty return if cursor >= line_stop or text[cursor] != 34
            cursor <- cursor + 1.usize()
            captured: mutable darray[u8] = []
            while cursor < line_stop |cursor, captured, text|:
                break if text[cursor] == 34
                captured.push(text[cursor])
                cursor <- cursor + 1.usize()
            empty return if cursor >= line_stop or text[cursor] != 34
            return captured

    # stage0's lintNativeAsmBlock, over `block` = six lines of leading CONTEXT plus the asm
    # block itself. The context matters: `guestish` is usually the enclosing function's name,
    # which is above the `__asm__` line, not inside it.
    def abi_lint_asm_block(fields: lmut StrList, lines: mutable darray[u32]&, file: darray[u8]&, start_line: u32, block: darray[u8]&) -> void:
        can Memory.Allocate, Abort.Panic:
            guestish: bool = abi_is_guestish(block)
            touches_args: bool = abi_has_arg_register(block)
            touches_stack: bool = abi_has_stack_mutation(block)
            uses_positional: bool = abi_has_positional_operand(block)
            uses_call: bool = abi_has_indirect(block, "call")
            uses_jump: bool = abi_has_indirect(block, "jmp")
            noreturnish: bool = abi_is_noreturnish(block)
            has_memory_clobber: bool = abi_has_memory_clobber(block)
            has_scratch: bool = abi_has_scratch_parking(block)

            if uses_positional and (touches_args or touches_stack) and not abi_lint_allowed(block, "inline-asm-positional-abi-operands"):
                fields <- abi_push_issue(fields, "warning", "inline-asm-positional-abi-operands", file, "inline asm touches ABI stack/argument registers while using positional operands like %0/%1; prefer named operands parked in scratch registers before clobbering rdi/rsi/rsp")
                lines.push(start_line)
            if touches_stack and not has_memory_clobber and not abi_lint_allowed(block, "inline-asm-stack-without-memory-clobber"):
                fields <- abi_push_issue(fields, "warning", "inline-asm-stack-without-memory-clobber", file, "inline asm mutates stack state but does not declare a memory clobber; this can hide ABI-sensitive stack setup from the optimizer")
                lines.push(start_line)
            if guestish and uses_call and touches_stack and not abi_lint_allowed(block, "guest-entry-call-mangles-stack"):
                # stage0 appends " and this block is not marked noreturn" when the block does
                # not look noreturn. Spelled as TWO constants rather than a built string: this
                # function returns void, so it has no region to concatenate in.
                if noreturnish:
                    fields <- abi_push_issue(fields, "error", "guest-entry-call-mangles-stack", file, "guest-entry inline asm prepares a synthetic process stack but uses call *; C++ shadPS4 uses a no-return jmp for real guest entry so call will push a host return address")
                else:
                    fields <- abi_push_issue(fields, "error", "guest-entry-call-mangles-stack", file, "guest-entry inline asm prepares a synthetic process stack but uses call *; C++ shadPS4 uses a no-return jmp for real guest entry so call will push a host return address and this block is not marked noreturn")
                lines.push(start_line)
            if guestish and uses_jump and touches_stack and not noreturnish and not abi_lint_allowed(block, "guest-entry-jump-not-noreturn"):
                fields <- abi_push_issue(fields, "warning", "guest-entry-jump-not-noreturn", file, "guest-entry inline asm jumps into guest code but the surrounding helper does not look noreturn; add a noreturn attribute or builtin unreachable")
                lines.push(start_line)
            if guestish and touches_args and touches_stack and not has_scratch and not abi_lint_allowed(block, "guest-entry-no-scratch-register-parking"):
                fields <- abi_push_issue(fields, "warning", "guest-entry-no-scratch-register-parking", file, "guest-entry inline asm sets ABI argument registers and stack without obvious r9/r10/r11 scratch parking; operand allocation can alias registers that the asm later overwrites")
                lines.push(start_line)

    # One source: every asm block linted, plus the contracts it declares. `scanned` carries
    # the seen-set (absolute paths) so a diamond of includes is walked once.
    def abi_scan_source(path: darray[u8]&, fields: lmut StrList, lines: mutable darray[u32]&, contracts: mutable StrList&, scanned: mutable StrList&, depth: i64) -> void:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            return if depth > 32
            absolute: darray[u8] = absolute_path(path)
            return if strlist_contains(scanned, absolute)
            scanned <- strlist_push(scanned, absolute)
            text: darray[u8] = read_file_bytes(absolute)
            # stage0 reports a read failure as an issue rather than aborting the report.
            if text.count == 0.usize() and not file_exists(absolute):
                # Go's os.ReadFile error text, verbatim: `open PATH: no such file or
                # directory`. stage0 puts err.Error() straight into the message.
                fields <- abi_push_issue(fields, "error", "native-source-read-failed", absolute, "open ")
                fields <- abi_extend_last(fields, absolute)
                fields <- abi_extend_last_view(fields, ": no such file or directory")
                lines.push(0)
                return
            declared: StrList = abi_collect_contracts(text)
            for contract_index in 0..<strlist_count(&declared) |contracts, declared|:
                contracts <- strlist_push_span(contracts, declared.data, declared.starts[contract_index], declared.lengths[contract_index])
            starts: darray[usize] = abi_line_starts(text)
            if abi_is_native_source(absolute):
                for line_index in 0..<starts.count |fields, lines, text, starts, absolute, line_index|:
                    line_stop: usize = starts[line_index + 1.usize()] - 1.usize() if line_index + 1.usize() < starts.count else text.count
                    continue if not abi_word_in_span(text, starts[line_index], line_stop, "__asm__") and not abi_word_in_span(text, starts[line_index], line_stop, "asm")
                    end_line: usize = abi_asm_block_end(text, starts, line_index)
                    # stage0 prepends SIX lines of context so the enclosing function's name is
                    # visible to the `guestish` probe.
                    context_line: usize = line_index - 6.usize() if line_index >= 6.usize() else 0.usize()
                    block_stop: usize = starts[end_line + 1.usize()] if end_line + 1.usize() < starts.count else text.count
                    block: mutable darray[u8] = []
                    for byte_index in starts[context_line]..<block_stop |block, text|:
                        block.push(text[byte_index])
                    fields <- abi_lint_asm_block(fields, lines, absolute, (line_index + 1.usize()).u32(), block)
            # Recurse through QUOTED includes that name a C/C++ file which exists.
            directory: darray[u8] = path_directory(absolute)
            for include_index in 0..<starts.count |fields, lines, contracts, scanned, text, starts, directory, depth, include_index|:
                include_stop: usize = starts[include_index + 1.usize()] - 1.usize() if include_index + 1.usize() < starts.count else text.count
                quoted: darray[u8] = abi_quoted_include(text, starts[include_index], include_stop)
                continue if quoted.count == 0.usize()
                combined: darray[u8] = path_join(directory, quoted)
                joined: darray[u8] = path_clean(combined)
                continue if not abi_is_native_source(joined)
                continue if not file_exists(joined)
                fields <- abi_scan_source(joined, fields, lines, contracts, scanned, depth + 1)

    # An index permutation putting `list`'s entries in byte order (Go's sort.Strings). The
    # entries themselves are not moved: the issue columns are positional, so reordering the
    # backing data would desynchronise them.
    def abi_sorted_order(list: StrList&) -> darray[usize]:
        can Memory.Allocate, Abort.Panic:
            order: mutable darray[usize] = []
            for index in 0..<strlist_count(list) |order|:
                order <- order.push(index)
            # Insertion sort: these lists are a handful of paths, and it is stable, which
            # keeps equal entries in discovery order the way Go's sort.Strings leaves them.
            for outer in 1..<order.count |order, list|:
                position: mutable usize = outer
                while position > 0.usize() |position, order, list|:
                    left: darray[u8] = strlist_entry_copy(list, order[position - 1.usize()])
                    right: darray[u8] = strlist_entry_copy(list, order[position])
                    break if not bytes_less(right, left)
                    swap: usize = order[position - 1.usize()]
                    order[position - 1.usize()] <- order[position]
                    order[position] <- swap
                    position <- position - 1.usize()
            return order

    # stage0's formatNativeABILintReport, text form.
    def render_abi_lint_text(resolved: ResolvedTarget&, scanned: StrList&, contracts: StrList&, fields: StrList&, lines: darray[u32]&) -> darray[u8]:
        can Memory.Allocate, Abort.Panic:
            out: mutable darray[u8] = []
            push_labelled(&out, "Project: ", resolved.project_file)
            push_labelled(&out, "Target: ", resolved.name)
            push_labelled(&out, "Entry: ", resolved.entry_path)
            push_labelled(&out, "Emit: ", resolved.emit)
            push_labelled(&out, "Run emit: ", resolved.run_emit)
            bytes_extend_view(&out, "Target triple: ")
            if resolved.target_triple.count == 0.usize():
                bytes_extend_view(&out, "<host-default>")
            else:
                bytes_extend(&out, resolved.target_triple)
            out.push(10)
            if strlist_count(&resolved.foreign) == 0.usize():
                bytes_extend_view(&out, "Foreign sources: <none>\n")
            else:
                bytes_extend_view(&out, "Foreign sources:\n")
                foreign_order: darray[usize] = abi_sorted_order(&resolved.foreign)
                for index in 0..<foreign_order.count |out, resolved, foreign_order|:
                    bytes_extend_view(&out, "  - ")
                    strlist_append_entry(&out, &resolved.foreign, foreign_order[index])
                    out.push(10)
            if strlist_count(scanned) != 0.usize():
                bytes_extend_view(&out, "Scanned native files:\n")
                scanned_order: darray[usize] = abi_sorted_order(scanned)
                for index in 0..<scanned_order.count |out, scanned, scanned_order|:
                    bytes_extend_view(&out, "  - ")
                    strlist_append_entry(&out, scanned, scanned_order[index])
                    out.push(10)
            if strlist_count(contracts) != 0.usize():
                bytes_extend_view(&out, "ABI contracts:\n")
                contract_order: darray[usize] = abi_sorted_order(contracts)
                for index in 0..<contract_order.count |out, contracts, contract_order|:
                    bytes_extend_view(&out, "  - ")
                    strlist_append_entry(&out, contracts, contract_order[index])
                    out.push(10)
            if strlist_count(&resolved.link_flags) != 0.usize():
                bytes_extend_view(&out, "Link flags:\n")
                for index in 0..<strlist_count(&resolved.link_flags) |out, resolved|:
                    bytes_extend_view(&out, "  - ")
                    strlist_append_entry(&out, &resolved.link_flags, index)
                    out.push(10)
            if abi_issue_count(fields) == 0.usize():
                bytes_extend_view(&out, "ABI lint: clean\n")
                return out
            bytes_extend_view(&out, "ABI lint issues:\n")
            for issue in 0..<abi_issue_count(fields) |out, fields, lines|:
                bytes_extend_view(&out, "  - [")
                strlist_append_entry(&out, fields, issue * 4.usize())
                bytes_extend_view(&out, "] ")
                strlist_append_entry(&out, fields, issue * 4.usize() + 1.usize())
                out.push(32)
                strlist_append_entry(&out, fields, issue * 4.usize() + 2.usize())
                # stage0 appends `:LINE` only when the issue carries one.
                if lines[issue] != 0:
                    out.push(58)
                    bytes_push_decimal(&out, lines[issue].usize())
                bytes_extend_view(&out, ": ")
                strlist_append_entry(&out, fields, issue * 4.usize() + 3.usize())
                out.push(10)
            return out

    # stage0's buildNativeABILintReport + runProjectABILint, minus the JSON form.
    #
    # Returns the rendered text; `had_error` reports whether any issue is ERROR severity,
    # which is what stage0 turns into exit 1.
    def render_abi_lint(resolved: ResolvedTarget&, strict_contracts: bool, json_form: bool, had_error: mutable bool&) -> darray[u8]:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            fields: mutable StrList = StrList{data: [], starts: [], lengths: []}
            lines: mutable darray[u32] = []
            contracts: mutable StrList = StrList{data: [], starts: [], lengths: []}
            scanned: mutable StrList = StrList{data: [], starts: [], lengths: []}
            # Foreign sources are scanned in SORTED order: stage0 sorts before walking, and
            # the issue order follows the walk.
            foreign_order: darray[usize] = abi_sorted_order(&resolved.foreign)
            for index in 0..<foreign_order.count |fields, lines, contracts, scanned, resolved, foreign_order|:
                entry: darray[u8] = strlist_entry_copy(&resolved.foreign, foreign_order[index])
                fields <- abi_scan_source(entry, fields, &lines, &contracts, &scanned, 0)

            if strict_contracts:
                has_guest_entry: mutable bool = false
                for contract_index in 0..<strlist_count(&contracts) |has_guest_entry, contracts|:
                    entry: darray[u8] = strlist_entry_copy(&contracts, contract_index)
                    has_guest_entry <- true if abi_contains(entry, "guest_entry")
                scanned_order: darray[usize] = abi_sorted_order(&scanned)
                for index in 0..<scanned_order.count |fields, lines, scanned, scanned_order, has_guest_entry|:
                    entry: darray[u8] = strlist_entry_copy(&scanned, scanned_order[index])
                    continue if not abi_is_guestish(entry) or has_guest_entry
                    fields <- abi_push_issue(fields, "error", "missing-guest-entry-abi-contract", entry, "strict ABI contracts require ELISA_ABI_CONTRACT guest_entry for guest execution native runtime files")
                    lines.push(0)
                if has_guest_entry and not abi_contains(resolved.target_triple, "x86_64"):
                    fields <- abi_push_issue(fields, "error", "guest-entry-target-not-x86_64", resolved.project_file, "guest_entry ABI contract requires an explicit x86_64 target triple for real guest execution")
                    lines.push(0)

            if resolved.target_triple.count == 0.usize() and strlist_count(&resolved.foreign) != 0.usize():
                fields <- abi_push_issue(fields, "info", "target-triple-defaulted", resolved.project_file, "target does not set an explicit target triple; native code will use the compiler default host triple")
                lines.push(0)

            for issue in 0..<abi_issue_count(&fields) |had_error, fields|:
                severity: darray[u8] = strlist_entry_copy(&fields, issue * 4.usize())
                had_error <- true if bytes_equal_view(severity, "error")

            deduped: StrList = strlist_dedupe(&contracts)
            render_abi_lint_json(resolved, &scanned, &deduped, &fields, lines) return if json_form
            return render_abi_lint_text(resolved, &scanned, &deduped, &fields, lines)

    # A StrList holding `list`'s entries in sorted order — the JSON arrays are emitted through
    # json_push_string_array, which walks a list rather than an index permutation.
    def abi_sorted_list(list: StrList&) -> StrList:
        can Memory.Allocate, Abort.Panic:
            result: mutable StrList = StrList{data: [], starts: [], lengths: []}
            order: darray[usize] = abi_sorted_order(list)
            for index in 0..<order.count |result, list, order|:
                result <- strlist_push_span(result, list.data, list.starts[order[index]], list.lengths[order[index]])
            return result

    # stage0's json.MarshalIndent of nativeABILintReport. Field ORDER is the Go struct's
    # declaration order; every `omitempty` field is dropped when empty. `issues` is NOT
    # omitempty, so it is always present — and Go renders a nil slice as `null`, which is what
    # a clean project prints.
    def render_abi_lint_json(resolved: ResolvedTarget&, scanned: StrList&, contracts: StrList&, fields: StrList&, lines: darray[u32]&) -> darray[u8]:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            out: mutable darray[u8] = []
            out.push(123)
            out.push(10)
            json_push_string_field(&out, 1.usize(), "project", resolved.project_file, true)
            json_push_string_field(&out, 1.usize(), "target", resolved.name, true)
            json_push_string_field(&out, 1.usize(), "entry", resolved.entry_path, true)
            json_push_string_field(&out, 1.usize(), "emit", resolved.emit, true)
            json_push_string_field(&out, 1.usize(), "runEmit", resolved.run_emit, true)
            json_push_string_field(&out, 1.usize(), "targetTriple", resolved.target_triple, true) if resolved.target_triple.count > 0.usize()
            if strlist_count(&resolved.foreign) != 0.usize():
                sorted_foreign: StrList = abi_sorted_list(&resolved.foreign)
                json_push_string_array(&out, 1.usize(), "foreign", &sorted_foreign, true)
            if strlist_count(scanned) != 0.usize():
                sorted_scanned: StrList = abi_sorted_list(scanned)
                json_push_string_array(&out, 1.usize(), "scanned", &sorted_scanned, true)
            if strlist_count(&resolved.link_flags) != 0.usize():
                json_push_string_array(&out, 1.usize(), "linkFlags", &resolved.link_flags, true)
            if strlist_count(contracts) != 0.usize():
                sorted_contracts: StrList = abi_sorted_list(contracts)
                json_push_string_array(&out, 1.usize(), "contracts", &sorted_contracts, true)
            if abi_issue_count(fields) == 0.usize():
                json_push_indent(&out, 1.usize())
                bytes_extend_view(&out, "\"issues\": null\n")
                out.push(125)
                out.push(10)
                return out
            json_push_indent(&out, 1.usize())
            bytes_extend_view(&out, "\"issues\": [\n")
            for issue in 0..<abi_issue_count(fields) |out, fields, lines|:
                json_push_indent(&out, 2.usize())
                bytes_extend_view(&out, "{\n")
                json_push_indent(&out, 3.usize())
                bytes_extend_view(&out, "\"severity\": ")
                json_push_escaped_span(&out, fields.data, fields.starts[issue * 4.usize()], fields.lengths[issue * 4.usize()])
                bytes_extend_view(&out, ",\n")
                json_push_indent(&out, 3.usize())
                bytes_extend_view(&out, "\"code\": ")
                json_push_escaped_span(&out, fields.data, fields.starts[issue * 4.usize() + 1.usize()], fields.lengths[issue * 4.usize() + 1.usize()])
                bytes_extend_view(&out, ",\n")
                json_push_indent(&out, 3.usize())
                bytes_extend_view(&out, "\"file\": ")
                json_push_escaped_span(&out, fields.data, fields.starts[issue * 4.usize() + 2.usize()], fields.lengths[issue * 4.usize() + 2.usize()])
                bytes_extend_view(&out, ",\n")
                # `line` is omitempty, so an issue without one drops the field entirely.
                if lines[issue] != 0:
                    json_push_indent(&out, 3.usize())
                    bytes_extend_view(&out, "\"line\": ")
                    bytes_push_decimal(&out, lines[issue].usize())
                    bytes_extend_view(&out, ",\n")
                json_push_indent(&out, 3.usize())
                bytes_extend_view(&out, "\"message\": ")
                json_push_escaped_span(&out, fields.data, fields.starts[issue * 4.usize() + 3.usize()], fields.lengths[issue * 4.usize() + 3.usize()])
                out.push(10)
                json_push_indent(&out, 2.usize())
                out.push(125)
                out.push(44) if issue + 1.usize() < abi_issue_count(fields)
                out.push(10)
            json_push_indent(&out, 1.usize())
            out.push(93)
            out.push(10)
            out.push(125)
            out.push(10)
            return out

    # ---- `project easm-lint` -----------------------------------------------------------------
    #
    # stage0's easm.BuildReport/FormatReport. The FILE LIST half needs no parsing and is
    # reproduced exactly. The MODULE half does: stage0 runs easm.ParseFile over each `.easm`
    # input and prints each module's exports, facts and labels. That parser is ~13k lines and
    # is not ported, so a project that actually carries `.easm` inputs is REFUSED BY NAME
    # rather than given a report with the module section silently missing — an empty module
    # list reads as "no exports and no issues", which is a false clean.
    #
    # The zero-input case is not a degenerate corner: it is every project that does not use
    # EASM, and stage0's output for it is exactly these three lines.

    def render_easm_lint_text(resolved: ResolvedTarget&, verified: mutable bool&) -> darray[u8]:
        can Memory.Allocate, Abort.Panic:
            out: mutable darray[u8] = []
            bytes_extend_view(&out, "Target triple: ")
            if resolved.target_triple.count == 0.usize():
                bytes_extend_view(&out, "<host-default>")
            else:
                bytes_extend(&out, resolved.target_triple)
            out.push(10)
            bytes_extend_view(&out, "EASM files (")
            bytes_push_decimal(&out, strlist_count(&resolved.easm))
            bytes_extend_view(&out, "):\n")
            bytes_extend_view(&out, "  - <none>\n") if strlist_count(&resolved.easm) == 0.usize()
            for index in 0..<strlist_count(&resolved.easm) |out, resolved|:
                bytes_extend_view(&out, "  - ")
                strlist_append_entry(&out, &resolved.easm, index)
                out.push(10)
            body: darray[u8] = render_easm_full(resolved, verified)
            # `verified` is a `mutable bool&`; a bare ref is not a bool condition here.
            bytes_extend(&out, body) if verified == true
            return out

    # `targetTriple` is omitempty; `files` and `modules` are not, so both are always present
    # and render as `null` when empty (Go's nil slice).
    def render_easm_lint_json(resolved: ResolvedTarget&) -> darray[u8]:
        can Memory.Allocate, Abort.Panic:
            out: mutable darray[u8] = []
            out.push(123)
            out.push(10)
            json_push_string_field(&out, 1.usize(), "targetTriple", resolved.target_triple, true) if resolved.target_triple.count > 0.usize()
            if strlist_count(&resolved.easm) == 0.usize():
                json_push_indent(&out, 1.usize())
                bytes_extend_view(&out, "\"files\": null,\n")
            else:
                json_push_string_array(&out, 1.usize(), "files", &resolved.easm, true)
            json_push_indent(&out, 1.usize())
            bytes_extend_view(&out, "\"modules\": null\n")
            out.push(125)
            out.push(10)
            return out

    # ---- EASM: why there is no parser here ----------------------------------------------------
    #
    # A routine-subset parser was written and then REMOVED. It parsed `module`/`target`/
    # `export def` and the section lines, and reproduced stage0's `Module …` / `  export …`
    # lines exactly for a simple fixture.
    #
    # It was not safe. stage0's easm-lint does not pretty-print a parse — it VERIFIES. The same
    # fixture with two exports produced eight `Issues:` entries from checks the parser knows
    # nothing about: an entry-fact whitelist (`unsupported-entry-fact`), label-contract
    # validation (`label-contract-without-label`, `empty-label-precondition`), control-contract
    # validation (`unknown-control-contract`, `noreturn-jump-without-tail-contract`),
    # parameter/input binding (`missing-input-binding`), and REGISTER DATAFLOW over the
    # instruction stream (`register-read-uninitialized`: "rdi is read but not established").
    #
    # A parser without those checks prints a module with no issues — which reads as "this EASM
    # is fine" for code stage0 rejects with eight errors. That is the false clean this file
    # exists to avoid, so `easm-lint` refuses any target carrying EASM inputs instead.
    #
    # Porting it means porting the verifier, not the grammar. See docs/PORTING_GAPS.md.


    # ---- EASM helpers ------------------------------------------------------------------------

    def bytes_slice_from(value: darray[u8]&, from_index: usize) -> darray[u8]:
        can Memory.Allocate, Abort.Panic:
            out: mutable darray[u8] = []
            for index in from_index..<value.count |out, value|:
                out.push(value[index])
            return bytes_trimmed(out)

    # `a, b , c` -> three trimmed entries (Go's splitCSV).
    def easm_split_csv(value: darray[u8]&) -> StrList:
        can Memory.Allocate, Abort.Panic:
            parts: mutable StrList = StrList{data: [], starts: [], lengths: []}
            start: mutable usize = 0.usize()
            for index in 0..<value.count + 1.usize() |parts, start, value|:
                at_end: bool = index == value.count
                continue if not at_end and value[index] != 44
                a: mutable usize = start
                b: mutable usize = index
                while a < b |a, value|:
                    break if not (value[a] == 32 or value[a] == 9)
                    a <- a + 1.usize()
                while b > a |b, value|:
                    break if not (value[b - 1.usize()] == 32 or value[b - 1.usize()] == 9)
                    b <- b - 1.usize()
                parts <- strlist_push_span(parts, value, a, b - a) if b > a
                start <- index + 1.usize()
            return parts

    # The body column is space-joined mnemonics.
    def easm_split_space(value: darray[u8]&) -> StrList:
        can Memory.Allocate, Abort.Panic:
            parts: mutable StrList = StrList{data: [], starts: [], lengths: []}
            start: mutable usize = 0.usize()
            for index in 0..<value.count + 1.usize() |parts, start, value|:
                at_end: bool = index == value.count
                continue if not at_end and value[index] != 32
                parts <- strlist_push_span(parts, value, start, index - start) if index > start
                start <- index + 1.usize()
            return parts

    # stage0's allowedControlToken.
    def easm_control_known(atom: darray[u8]&) -> bool:
        return bytes_equal_view(atom, "returns") or bytes_equal_view(atom, "noreturn") or bytes_equal_view(atom, "tail_jumps") or bytes_equal_view(atom, "may_fault")

    # The operand-free mnemonics this port models. cpuid/rdtsc are excluded on purpose: they
    # carry ImplicitReads/ImplicitClobbers, which reaches the clobber checks.
    def easm_modelled_op(op: darray[u8]&) -> bool:
        return bytes_equal_view(op, "pause") or bytes_equal_view(op, "ret") or bytes_equal_view(op, "trap") or bytes_equal_view(op, "lfence")

    # Their Capability from stage0's easm_oprules.go.
    def easm_op_capability(op: darray[u8]&) -> sview:
        "x86_64.sse.pause" return if bytes_equal_view(op, "pause")
        "x86_64.sse.lfence" return if bytes_equal_view(op, "lfence")
        "debug.trap" return if bytes_equal_view(op, "trap")
        return ""

    # stage0's isRegisterName, the x86-64 names this subset can mention.
    def easm_is_register(name: darray[u8]&) -> bool:
        candidates: sview = "rax rbx rcx rdx rsi rdi rsp rbp r8 r9 r10 r11 r12 r13 r14 r15 eax ebx ecx edx esi edi esp ebp al ah ax bl bh bx cl ch cx dl dh dx sp"
        start: mutable usize = 0.usize()
        for index in 0..<sview_len(candidates) + 1.usize() |start, candidates, name|:
            at_end: bool = index == sview_len(candidates)
            continue if not at_end and sview_at(candidates, index) != 32
            length: usize = index - start
            matched: mutable bool = length == name.count
            for byte_index in 0..<length |matched, candidates, name, start|:
                continue if not matched
                matched <- false if sview_at(candidates, start + byte_index) != name[byte_index]
            true return if matched
            start <- index + 1.usize()
        return false

    # One issue line in stage0's shape: `  [error] code file:line: message`.
    def easm_push_issue(out: mutable darray[u8]&, code: sview, file: darray[u8]&, line: u32, message: darray[u8]&) -> void:
        can Memory.Allocate, Abort.Panic:
            bytes_extend_view(out, "  [error] ")
            bytes_extend_view(out, code)
            out.push(32)
            bytes_extend(out, file)
            out.push(58)
            bytes_push_decimal(out, line.usize())
            bytes_extend_view(out, ": ")
            bytes_extend(out, message)
            out.push(10)

    # ---- EASM: verify the VOID / NO-PARAM subset ---------------------------------------------
    #
    # easm-lint is a machine-state verifier (126 codes). Reporting "clean" claims all of them,
    # so a partial port must refuse any shape whose applicable checks it lacks — refusing
    # per-check is not enough, because the universal contract checks fire on every routine.
    #
    # The boundary that makes a sound subset is VOID RETURN AND NO PARAMETERS. Declaring
    # `inputs:`/`outputs:` is what pulls in register dataflow (`input-register-unused`,
    # `return-register-not-written`), and a non-void or parameterised routine is REQUIRED to
    # declare them. Excluding those, an exhaustive sweep of 5040 configurations reaches exactly
    # THIRTEEN codes, all decidable from the declarations plus the operand-free instruction
    # list. That subset is also the real-world one: the intrinsic shims projects actually carry
    # (`pause; ret`, `trap`).
    #
    # Anything else — parameters, a non-void return, inputs/outputs, `facts:`/`labels:`, an
    # instruction with operands, an unmodelled mnemonic, fragment/protocol/template/layout/
    # lockstep — sets `ok` false and the whole report is refused.

    def easm_check_routine(out: mutable darray[u8]&, file: darray[u8]&, line: u32, controls: StrList&, stacks: StrList&, clobbers: StrList&, preserves: StrList&, requires: StrList&, ops: StrList&, op_lines: darray[u32]&, have_body: bool) -> void:
        can Memory.Allocate, Abort.Panic:
          # An explicit region: this returns void, so the entry copies and message buffers
          # below have nowhere else to live.
          region checks(262144):
              # 1. missing-capability, per instruction in body order.
              for op_index in 0..<strlist_count(ops) |out, ops, requires, op_lines, file|:
                  op: darray[u8] = strlist_entry_copy(ops, op_index)
                  capability: sview = easm_op_capability(op)
                  continue if sview_len(capability) == 0.usize()
                  declared: mutable bool = false
                  for r in 0..<strlist_count(requires) |declared, requires, capability|:
                      entry: darray[u8] = strlist_entry_copy(requires, r)
                      declared <- true if bytes_equal_view(entry, capability)
                  continue if declared
                  message: mutable darray[u8] = bytes_from_view("instruction \"")
                  bytes_extend(&message, op)
                  bytes_extend_view(&message, "\" requires capability ")
                  bytes_extend_view(&message, capability)
                  op_line: u32 = op_lines[op_index] if op_index < op_lines.count else 0
                  easm_push_issue(out, "missing-capability", file, op_line, message)
              # 2. invalid-clobber-register
              for index in 0..<strlist_count(clobbers) |out, clobbers, file, line|:
                  atom: darray[u8] = strlist_entry_copy(clobbers, index)
                  continue if bytes_equal_view(atom, "memory") or bytes_equal_view(atom, "cc") or easm_is_register(atom)
                  message: mutable darray[u8] = bytes_from_view("unknown clobber register ")
                  bytes_extend(&message, atom)
                  easm_push_issue(out, "invalid-clobber-register", file, line, message)
              # 3. invalid-preserve-register, then 4. preserve-without-clobber, per atom.
              for index in 0..<strlist_count(preserves) |out, preserves, clobbers, file, line|:
                  atom: darray[u8] = strlist_entry_copy(preserves, index)
                  if not easm_is_register(atom):
                      message: mutable darray[u8] = bytes_from_view("unknown preserve register ")
                      bytes_extend(&message, atom)
                      easm_push_issue(out, "invalid-preserve-register", file, line, message)
                  covered: mutable bool = false
                  for c in 0..<strlist_count(clobbers) |covered, clobbers, atom|:
                      entry: darray[u8] = strlist_entry_copy(clobbers, c)
                      covered <- true if bytes_equal(entry, atom)
                  continue if covered
                  message2: mutable darray[u8] = bytes_from_view("preserves declares ")
                  bytes_extend(&message2, atom)
                  bytes_extend_view(&message2, " but clobbers does not")
                  easm_push_issue(out, "preserve-without-clobber", file, line, message2)
              # Order, all measured against stage0: unknown-control-contract, then
              # missing-body, then the missing-* contract checks.
              for index in 0..<strlist_count(controls) |out, controls, file, line|:
                  atom: darray[u8] = strlist_entry_copy(controls, index)
                  continue if easm_control_known(atom)
                  message: mutable darray[u8] = bytes_from_view("unknown control contract ")
                  bytes_extend(&message, atom)
                  easm_push_issue(out, "unknown-control-contract", file, line, message)
              if not have_body:
                  no_body: darray[u8] = bytes_from_view("EASM export must contain a body")
                  easm_push_issue(out, "missing-body", file, line, no_body)
              # 5. missing-stack-contract
              if strlist_count(stacks) == 0.usize():
                  message: darray[u8] = bytes_from_view("EASM export must declare stack behavior")
                  easm_push_issue(out, "missing-stack-contract", file, line, message)
              # 6. missing-control-contract
              if strlist_count(controls) == 0.usize():
                  message: darray[u8] = bytes_from_view("EASM export must declare control behavior")
                  easm_push_issue(out, "missing-control-contract", file, line, message)
              # 8. the control-derived body checks.
              has_ret: mutable bool = false
              has_jmp: mutable bool = false
              has_trap: mutable bool = false
              last_terminal: mutable bool = false
              for index in 0..<strlist_count(ops) |has_ret, has_jmp, has_trap, last_terminal, ops|:
                  op: darray[u8] = strlist_entry_copy(ops, index)
                  has_ret <- true if bytes_equal_view(op, "ret")
                  has_jmp <- true if bytes_equal_view(op, "jmp")
                  has_trap <- true if bytes_equal_view(op, "trap")
                  last_terminal <- bytes_equal_view(op, "jmp") or bytes_equal_view(op, "trap")
              wants_returns: mutable bool = false
              wants_noreturn: mutable bool = false
              wants_tail: mutable bool = false
              wants_fault: mutable bool = false
              for index in 0..<strlist_count(controls) |wants_returns, wants_noreturn, wants_tail, wants_fault, controls|:
                  atom: darray[u8] = strlist_entry_copy(controls, index)
                  wants_returns <- true if bytes_equal_view(atom, "returns")
                  wants_noreturn <- true if bytes_equal_view(atom, "noreturn")
                  wants_tail <- true if bytes_equal_view(atom, "tail_jumps")
                  wants_fault <- true if bytes_equal_view(atom, "may_fault")
              if wants_returns and not has_ret:
                  message: darray[u8] = bytes_from_view("returning function must contain ret")
                  easm_push_issue(out, "returns-missing-ret", file, line, message)
              if wants_noreturn and has_ret:
                  message: darray[u8] = bytes_from_view("noreturn function contains ret")
                  easm_push_issue(out, "noreturn-can-return", file, line, message)
              if wants_noreturn and not last_terminal:
                  message: darray[u8] = bytes_from_view("noreturn function must end in jmp or trap")
                  easm_push_issue(out, "noreturn-missing-terminal", file, line, message)
              if wants_tail and not has_jmp:
                  message: darray[u8] = bytes_from_view("tail_jumps control contract requires a jmp instruction")
                  easm_push_issue(out, "tail-jumps-without-jump", file, line, message)
              if wants_fault and not has_trap:
                  message: darray[u8] = bytes_from_view("may_fault control contract requires memory, call, or trap behavior")
                  easm_push_issue(out, "may-fault-without-faulting-op", file, line, message)

    # Parse one file and, when every routine is inside the modelled subset, append its
    # `Module …` / `  export …` lines to `text` and its issues to `issues`. Sets `ok` false
    # for anything outside the subset — the caller then refuses the whole report.
    def easm_verify_file(path: darray[u8]&, text: mutable darray[u8]&, issues: mutable darray[u8]&, ok: mutable bool&) -> void:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
          region parse(1048576):
            source: darray[u8] = read_file_bytes(path)
            starts: darray[usize] = abi_line_starts(source)
            module_name: mutable darray[u8] = []
            module_target: mutable darray[u8] = bytes_from_view("any")
            exports: mutable darray[u8] = []
            found: mutable darray[u8] = []
            open_routine: mutable bool = false
            r_name: mutable darray[u8] = []
            r_abi: mutable darray[u8] = []
            r_line: mutable u32 = 0
            cur_ctl: mutable darray[u8] = []
            cur_stk: mutable darray[u8] = []
            cur_clb: mutable darray[u8] = []
            cur_prs: mutable darray[u8] = []
            cur_req: mutable darray[u8] = []
            cur_ops: mutable darray[u8] = []
            # Instruction-level issues carry the INSTRUCTION's line, not the header's.
            cur_op_lines: mutable darray[u32] = []
            have_body: mutable bool = false
            in_body: mutable bool = false
            for line_index in 0..<starts.count |ok, text, issues, exports, found, module_name, module_target, open_routine, r_name, r_abi, r_line, cur_ctl, cur_stk, cur_clb, cur_prs, cur_req, cur_ops, cur_op_lines, have_body, in_body, source, starts, path|:
                continue if ok == false
                stop_raw: usize = starts[line_index + 1.usize()] - 1.usize() if line_index + 1.usize() < starts.count else source.count
                a: mutable usize = starts[line_index]
                b: mutable usize = stop_raw
                while a < b |a, source|:
                    break if not (source[a] == 32 or source[a] == 9 or source[a] == 13)
                    a <- a + 1.usize()
                while b > a |b, source|:
                    break if not (source[b - 1.usize()] == 32 or source[b - 1.usize()] == 9 or source[b - 1.usize()] == 13)
                    b <- b - 1.usize()
                for scan in a..<b |b, source, a|:
                    if source[scan] == 35:
                        b <- scan
                        break
                while b > a |b, source|:
                    break if not (source[b - 1.usize()] == 32 or source[b - 1.usize()] == 9)
                    b <- b - 1.usize()
                continue if b <= a
                line: mutable darray[u8] = []
                for index in a..<b |line, source|:
                    line.push(source[index])

                if abi_span_is(line, 0.usize(), "module "):
                    module_name <- bytes_slice_from(line, sview_len("module "))
                    in_body <- false
                    continue
                if abi_span_is(line, 0.usize(), "target "):
                    ok <- false if abi_contains(line, " lockstep ")
                    module_target <- bytes_slice_from(line, sview_len("target ")) if not abi_contains(line, " lockstep ")
                    in_body <- false
                    continue
                if abi_span_is(line, 0.usize(), "export def "):
                    if open_routine:
                        easm_emit_export(&exports, r_name, r_abi, cur_ctl, cur_stk)
                        easm_check_from_text(&found, path, r_line, cur_ctl, cur_stk, cur_clb, cur_prs, cur_req, cur_ops, cur_op_lines, have_body)
                    r_name <- []
                    r_abi <- []
                    cur_ctl <- []
                    cur_stk <- []
                    cur_clb <- []
                    cur_prs <- []
                    cur_req <- []
                    cur_ops <- []
                    cur_op_lines <- []
                    have_body <- false
                    r_line <- (line_index + 1.usize()).u32()
                    ok <- false if not easm_parse_void_header(line, &r_name, &r_abi)
                    open_routine <- true
                    in_body <- false
                    continue
                if not open_routine:
                    ok <- false
                    continue
                colon: mutable usize = line.count
                for index in 0..<line.count |colon, line|:
                    colon <- index if line[index] == 58 and colon == line.count
                if colon < line.count and not in_body:
                    sect: mutable darray[u8] = []
                    for index in 0..<colon |sect, line|:
                        sect.push(abi_lower(line[index]))
                    value: darray[u8] = bytes_slice_from(line, colon + 1.usize())
                    if bytes_equal_view(sect, "body"):
                        in_body <- true
                        continue
                    bytes_extend(&cur_ctl, value) if bytes_equal_view(sect, "control")
                    bytes_extend(&cur_stk, value) if bytes_equal_view(sect, "stack")
                    bytes_extend(&cur_clb, value) if bytes_equal_view(sect, "clobbers")
                    bytes_extend(&cur_prs, value) if bytes_equal_view(sect, "preserves")
                    bytes_extend(&cur_req, value) if bytes_equal_view(sect, "requires")
                    modelled: bool = bytes_equal_view(sect, "control") or bytes_equal_view(sect, "stack") or bytes_equal_view(sect, "clobbers") or bytes_equal_view(sect, "preserves") or bytes_equal_view(sect, "requires")
                    # `inputs:`/`outputs:` reach register dataflow; `facts:`/`labels:` have
                    # their own checks. Both are outside the subset.
                    ok <- false if not modelled
                    continue
                if in_body:
                    have_body <- true
                    op: mutable darray[u8] = []
                    for index in 0..<line.count |op, line|:
                        break if line[index] == 32 or line[index] == 9
                        op.push(abi_lower(line[index]))
                    ok <- false if op.count != line.count or not easm_modelled_op(op)
                    cur_ops.push(32) if cur_ops.count > 0.usize()
                    bytes_extend(&cur_ops, op)
                    cur_op_lines <- cur_op_lines.push((line_index + 1.usize()).u32())
                    continue
                ok <- false
            if open_routine and ok == true:
                easm_emit_export(&exports, r_name, r_abi, cur_ctl, cur_stk)
                easm_check_from_text(&found, path, r_line, cur_ctl, cur_stk, cur_clb, cur_prs, cur_req, cur_ops, cur_op_lines, have_body)
            if ok == true:
                bytes_extend_view(text, "Module ")
                bytes_extend(text, module_name)
                bytes_extend_view(text, " target=")
                bytes_extend(text, module_target)
                text.push(10)
                bytes_extend(text, exports)
                bytes_extend(issues, found)

    # `export def NAME() -> void abi ABI:` — the ONLY header shape in the subset. A parameter
    # list or a non-void return is refused, which is what keeps register dataflow out of reach.
    def easm_parse_void_header(line: darray[u8]&, name_out: mutable darray[u8]&, abi_out: mutable darray[u8]&) -> bool:
        can Memory.Allocate, Abort.Panic:
            false return if not abi_span_is(line, 0.usize(), "export def ")
            cursor: mutable usize = sview_len("export def ")
            name_start: usize = cursor
            while cursor < line.count |cursor, line|:
                break if not abi_is_word_byte(line[cursor])
                cursor <- cursor + 1.usize()
            false return if cursor == name_start
            for index in name_start..<cursor |name_out, line|:
                name_out.push(line[index])
            false return if not abi_span_is(line, cursor, "()")
            cursor <- cursor + 2.usize()
            while cursor < line.count |cursor, line|:
                break if line[cursor] != 32
                cursor <- cursor + 1.usize()
            false return if not abi_span_is(line, cursor, "-> void")
            cursor <- cursor + sview_len("-> void")
            while cursor < line.count |cursor, line|:
                break if line[cursor] != 32
                cursor <- cursor + 1.usize()
            if abi_span_is(line, cursor, "abi "):
                cursor <- cursor + 4.usize()
                abi_start: usize = cursor
                while cursor < line.count |cursor, line|:
                    break if line[cursor] == 32 or line[cursor] == 58
                    cursor <- cursor + 1.usize()
                for index in abi_start..<cursor |abi_out, line|:
                    abi_out.push(line[index])
                while cursor < line.count |cursor, line|:
                    break if line[cursor] != 32
                    cursor <- cursor + 1.usize()
            return cursor + 1.usize() == line.count and line[cursor] == 58

    def easm_emit_export(out: mutable darray[u8]&, name: darray[u8]&, abi: darray[u8]&, control: darray[u8]&, stack_text: darray[u8]&) -> void:
        can Memory.Allocate, Abort.Panic:
          region emit(65536):
            bytes_extend_view(out, "  export ")
            bytes_extend(out, name)
            bytes_extend_view(out, " abi=")
            if abi.count == 0.usize():
                bytes_extend_view(out, "c")
            else:
                bytes_extend(out, abi)
            bytes_extend_view(out, " control=")
            easm_join_into(out, control)
            bytes_extend_view(out, " stack=")
            easm_join_into(out, stack_text)
            out.push(10)

    def easm_join_into(out: mutable darray[u8]&, value: darray[u8]&) -> void:
        can Memory.Allocate, Abort.Panic:
          region join(16384):
            parts: StrList = easm_split_csv(value)
            for index in 0..<strlist_count(&parts) |out, parts|:
                out.push(44) if index > 0.usize()
                strlist_append_entry(out, &parts, index)

    def easm_check_from_text(out: mutable darray[u8]&, file: darray[u8]&, line: u32, control: darray[u8]&, stack_text: darray[u8]&, clobbers: darray[u8]&, preserves: darray[u8]&, requires: darray[u8]&, ops_text: darray[u8]&, op_lines: darray[u32]&, have_body: bool) -> void:
        can Memory.Allocate, Abort.Panic:
          region split(65536):
            controls: StrList = easm_split_csv(control)
            stacks: StrList = easm_split_csv(stack_text)
            clobs: StrList = easm_split_csv(clobbers)
            press: StrList = easm_split_csv(preserves)
            reqs: StrList = easm_split_csv(requires)
            ops: StrList = easm_split_space(ops_text)
            easm_check_routine(out, file, line, &controls, &stacks, &clobs, &press, &reqs, &ops, op_lines, have_body)

    # The full body: per-module sections, then one Issues: block, exactly as stage0 orders it.
    def render_easm_full(resolved: ResolvedTarget&, ok: mutable bool&) -> darray[u8]:
        can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
            modules: mutable darray[u8] = []
            issues: mutable darray[u8] = []
            for index in 0..<strlist_count(&resolved.easm) |modules, issues, ok, resolved|:
                entry: darray[u8] = strlist_entry_copy(&resolved.easm, index)
                absolute: darray[u8] = absolute_path(entry)
                easm_verify_file(absolute, &modules, &issues, ok)
            out: mutable darray[u8] = []
            bytes_extend(&out, modules)
            if issues.count > 0.usize():
                bytes_extend_view(&out, "Issues:\n")
                bytes_extend(&out, issues)
            return out
