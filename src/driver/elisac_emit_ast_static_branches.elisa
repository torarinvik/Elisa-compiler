def emit_ast_static_branch_kind(declaration: Ast::Decl, tokens: darray[Lexer::Token]&) -> i64 can[Abort.Panic, Memory.Allocate]:
    if declaration is Decl.Scoped(static_branch_body, static_branch_line):
        line_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, static_branch_line.line, static_branch_line.offset) can Global{Read,Write}
        return 0 if:
            not line_range.found or line_range.start + 1 >= tokens.count
            tokens[line_range.start].kind != Lexer::TokenKind.Static
        second_kind: Lexer::TokenKind = tokens[line_range.start + 1].kind
        return 2 if second_kind == Lexer::TokenKind.Elif
        return 3 if second_kind == Lexer::TokenKind.Else
        return 1 if second_kind == Lexer::TokenKind.If
    return 0



def emit_ast_static_condition(file: Ast::File&, branch_pos: Ast::Pos) -> Ast::Expr:
    for condition_index in 0..<file.static_if_lines.count |file|:
        return file.static_if_conds[condition_index] if condition_index < file.static_if_offsets.count and file.static_if_lines[condition_index] == branch_pos.line and file.static_if_offsets[condition_index] == branch_pos.offset and file.static_if_kinds[condition_index] != StaticIfBranch::Kind.Fallback
    return (Ast::Expr.Invalid)




def emit_ast_static_scope(buffer: mutable darray[u8]&, declaration: Ast::Decl, file: Ast::File&, tokens: darray[Lexer::Token]&, source: u8&, elif_count: i64, level: i64, owner: sview, local_annotations: darray[Ast::LocalRegionAnnotation]&, marks: EmitAstMarks&, struct_names: darray[sview]&, struct_member_rows: darray[Ast::StructMember]&, struct_member_starts: darray[usize]&, struct_member_counts: darray[usize]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    match declaration:
        Decl.Scoped(static_body, static_line):
            emit_ast_indent(buffer, level)
            emit_tokens_push_sview(buffer, "static if ")
            static_condition: Ast::Expr = emit_ast_static_condition(file, static_line)
            FmtUnparse::fmt_expr(buffer, emit_ast_compact_condition(static_condition), tokens, source) can Global{Read,Write}
            emit_tokens_push_sview(buffer, ": (")
            static_end: u32 = emit_ast_module_end(tokens, static_line.offset)
            static_using_count: usize = emit_ast_direct_using_count(marks.using_rows, owner, static_line.offset, static_end, static_body, tokens) can Global{Read,Write}
            child_count: mutable usize = static_using_count
            for child in static_body |child_count, tokens|:
                kind: i64 = emit_ast_static_branch_kind(child, tokens) can Global{Read,Write}
                child_count <- child_count + 1 if kind == 0 or kind == 1
            emit_tokens_push_u64(buffer, child_count.u64())
            emit_tokens_push_sview(buffer, " then, ")
            emit_tokens_push_u64(buffer, elif_count.u64())
            emit_tokens_push_sview(buffer, " elifs)\n")
            static_previous: mutable u32 = static_line.offset
            for child_index in 0..<static_body.count |buffer, tokens, source, local_annotations, marks, struct_names, struct_member_rows, struct_member_starts, struct_member_counts, static_previous, static_end, owner|:
                static_child: Ast::Decl = static_body[child_index]
                child_offset: u32 = ast_decl_offset(static_child)
                emit_ast_direct_using_range(buffer, marks.using_rows, owner, static_previous, child_offset, level + 1, static_body, tokens) can Global{Read,Write}
                static_previous <- child_offset
                kind: i64 = emit_ast_static_branch_kind(static_child, tokens) can Global{Read,Write}
                if kind == 1:
                    nested_elifs: mutable i64 = 0
                    next_index: mutable usize = child_index + 1
                    while next_index < static_body.count:
                        next_kind: i64 = emit_ast_static_branch_kind(static_body[next_index], tokens) can Global{Read,Write}
                        break if next_kind == 0 or next_kind == 1
                        nested_elifs <- nested_elifs + 1 if next_kind == 2
                        next_index <- next_index + 1
                    emit_ast_static_scope(buffer, static_child, file, tokens, source, nested_elifs, level + 1, owner, local_annotations, marks, struct_names, struct_member_rows, struct_member_starts, struct_member_counts) can Global{Read,Write}
                elif kind == 0:
                    emit_ast_decl(buffer, static_child, level + 1, tokens, source, local_annotations, marks, struct_names, struct_member_rows, struct_member_starts, struct_member_counts, file) can Global{Read,Write}
            emit_ast_direct_using_range(buffer, marks.using_rows, owner, static_previous, static_end, level + 1, static_body, tokens) can Global{Read,Write}
        _:
            pass
