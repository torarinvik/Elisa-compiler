# `-emit pymodule` — LOOKUP over the unit: find the function, const or struct an export row
# names, and answer whether a struct may cross the boundary — including the cycle walk that
# stops a recursive record from being expanded forever.


def pymodule_target_path_matches(wanted: sview, owner: sview, leaf: sview) -> bool can[Abort.Panic]:
    # Unqualified rows retain the convenient "find this name anywhere" behavior. A qualified
    # row must match the complete module path, preventing two modules with the same member
    # name from silently exporting the first declaration encountered in source order.
    if owner == "":
        return wanted == leaf
    false return if sview_len(wanted) != sview_len(owner) + 2.usize() + sview_len(leaf)
    for index in 0..<sview_len(owner) |wanted, owner|:
        false return if sview_at(wanted, index) != sview_at(owner, index)
    false return if sview_at(wanted, sview_len(owner)) != 58 or sview_at(wanted, sview_len(owner) + 1.usize()) != 58
    for index in 0..<sview_len(leaf) |wanted, leaf, owner|:
        false return if sview_at(wanted, sview_len(owner) + 2.usize() + index) != sview_at(leaf, index)
    return true




def pymodule_target_is_qualified(target: sview) -> bool can[Abort.Panic]:
    for index in 0..<sview_len(target) |target|:
        return true if sview_at(target, index) == 58 and index + 1.usize() < sview_len(target) and sview_at(target, index + 1.usize()) == 58
    return false




def pymodule_target_leaf_matches(target: sview, leaf: sview) -> bool can[Abort.Panic]:
    return target == leaf if not pymodule_target_is_qualified(target)
    false return if sview_len(target) <= sview_len(leaf) + 2.usize()
    suffix_start: usize = sview_len(target) - sview_len(leaf)
    false return if sview_at(target, suffix_start - 2.usize()) != 58 or sview_at(target, suffix_start - 1.usize()) != 58
    for index in 0..<sview_len(leaf) |target, leaf, suffix_start|:
        false return if sview_at(target, suffix_start + index) != sview_at(leaf, index)
    return true




def pymodule_const_leaf_count(declarations: darray[Ast::Decl]&, target: sview) -> usize can[Abort.Panic, Memory.Allocate]:
    count: mutable usize = 0
    for declaration in declarations |count, target|:
        if declaration is Decl.Const(name, type_expression, value, is_mutable, line):
            count <- count + 1 if pymodule_target_leaf_matches(target, name)
        elif declaration is Decl.Module(module_name, module_body, module_line):
            count <- count + pymodule_const_leaf_count(module_body, target)
        elif declaration is Decl.Scoped(scoped_body, scoped_line):
            count <- count + pymodule_const_leaf_count(scoped_body, target)
    return count




def pymodule_find_function_in(declarations: darray[Ast::Decl]&, wanted: sview) -> Ast::Decl? can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations:
        if declaration is Decl.Func(name, params, return_type, body, effects, decorators, pos):
            return declaration if pymodule_target_path_matches(wanted, "", name)
        if declaration is Decl.Module(module_name, module_body, module_pos):
            found: Ast::Decl? = pymodule_find_function_in_owner(module_body, wanted, module_name)
            if found is nested:
                return nested
        if declaration is Decl.Scoped(scoped_body, scoped_pos):
            found: Ast::Decl? = pymodule_find_function_in_owner(scoped_body, wanted, "")
            if found is nested_scoped:
                return nested_scoped
    return null




def pymodule_find_function_in_owner(declarations: darray[Ast::Decl]&, wanted: sview, owner: sview) -> Ast::Decl? can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations:
        if declaration is Decl.Func(name, params, return_type, body, effects, decorators, pos):
            return declaration if pymodule_target_path_matches(wanted, owner, name)
        if declaration is Decl.Module(module_name, module_body, module_pos):
            found: Ast::Decl? = pymodule_find_function_in_owner(module_body, wanted, module_name)
            if found is nested:
                return nested
        if declaration is Decl.Scoped(scoped_body, scoped_pos):
            found: Ast::Decl? = pymodule_find_function_in_owner(scoped_body, wanted, owner)
            if found is nested_scoped:
                return nested_scoped
    return null




def pymodule_find_const_in(declarations: darray[Ast::Decl]&, wanted: sview) -> Ast::Decl? can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations:
        if declaration is Decl.Const(name, type_expression, value, is_mutable, pos):
            return declaration if pymodule_target_path_matches(wanted, "", name)
        if declaration is Decl.Module(module_name, module_body, module_pos):
            found: Ast::Decl? = pymodule_find_const_in_owner(module_body, wanted, module_name)
            if found is nested:
                return nested
        if declaration is Decl.Scoped(scoped_body, scoped_pos):
            found: Ast::Decl? = pymodule_find_const_in_owner(scoped_body, wanted, "")
            if found is nested_scoped:
                return nested_scoped
    return null




def pymodule_find_const_in_owner(declarations: darray[Ast::Decl]&, wanted: sview, owner: sview) -> Ast::Decl? can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations:
        if declaration is Decl.Const(name, type_expression, value, is_mutable, pos):
            return declaration if pymodule_target_path_matches(wanted, owner, name)
        if declaration is Decl.Module(module_name, module_body, module_pos):
            found: Ast::Decl? = pymodule_find_const_in_owner(module_body, wanted, module_name)
            if found is nested:
                return nested
        if declaration is Decl.Scoped(scoped_body, scoped_pos):
            found: Ast::Decl? = pymodule_find_const_in_owner(scoped_body, wanted, owner)
            if found is nested_scoped:
                return nested_scoped
    return null




def pymodule_find_struct_in(declarations: darray[Ast::Decl]&, wanted: sview) -> Ast::Decl? can[Abort.Panic, Memory.Allocate]:
    for declaration in declarations:
        if declaration is Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, pos):
            return declaration if name == wanted
        if declaration is Decl.Module(module_name, module_body, module_pos):
            found: Ast::Decl? = pymodule_find_struct_in(module_body, wanted)
            if found is nested:
                return nested
        if declaration is Decl.Scoped(scoped_body, scoped_pos):
            found_scoped: Ast::Decl? = pymodule_find_struct_in(scoped_body, wanted)
            if found_scoped is nested_scoped:
                return nested_scoped
    return null




def pymodule_struct_member_type_name(file: Ast::File&, struct_type_name: sview, field_name: sview) -> sview can[Abort.Panic, Memory.Allocate]:
    declaration: Ast::Decl? = pymodule_find_struct_in(file.top_decls, struct_type_name)
    if declaration is target:
        if target is Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, pos):
            for member in members |file, field_name|:
                return pymodule_alias_type_name(file, member.type_expression) if member.name == field_name
    return ""




def pymodule_struct_scalar_field_type(type_name: sview) -> bool can[Abort.Panic]:
    return type_name == "i8" or type_name == "i16" or type_name == "i32" or type_name == "i64" or type_name == "int" or type_name == "isize" or type_name == "char" or type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or type_name == "usize" or type_name == "uintptr" or type_name == "f32" or type_name == "f64" or type_name == "bool" or type_name == "cstr" or type_name == "sview" or type_name == "py::Object" or type_name == "cstr?" or type_name == "py::Object?" or type_name == "i8?" or type_name == "i16?" or type_name == "i32?" or type_name == "i64?" or type_name == "int?" or type_name == "isize?" or type_name == "char?" or type_name == "u8?" or type_name == "u16?" or type_name == "u32?" or type_name == "u64?" or type_name == "usize?" or type_name == "uintptr?" or type_name == "bool?" or type_name == "f32?" or type_name == "f64?" or type_name == "sview?"




def pymodule_struct_cycle_walk(file: Ast::File&, type_name: sview, active: mutable darray[sview]&, depth: usize) -> bool can[Abort.Panic, Memory.Allocate]:
    # Track the active type path, rather than only bounding recursion depth.  A depth-only walk
    # is finite for a linear cycle but still expands a branching cycle exponentially (for example
    # `Node { left: Node, right: Node }`) before reaching its cap, which was enough to exhaust the
    # host during `-emit pymodule`.  The path is pushed only for the duration of this branch, so
    # repeated types on sibling branches remain valid while true recursive value layouts reject
    # immediately.
    return false if depth > 64.usize()
    probe: mutable usize = 0
    while probe < active.count:
        return true if active[probe] == type_name
        probe <- probe + 1
    active.push(type_name)
    if pymodule_is_darray_type(type_name) or pymodule_is_view_type(type_name) or pymodule_is_set_type(type_name):
        element_name: sview = pymodule_darray_element_name(type_name) if pymodule_is_darray_type(type_name) else pymodule_view_element_name(type_name) if pymodule_is_view_type(type_name) else pymodule_set_element_name(type_name)
        result: bool = pymodule_struct_cycle_walk(file, element_name, active, depth + 1.usize())
        _ = active.pop()
        return result
    if pymodule_is_dict_type(type_name):
        result: bool = pymodule_struct_cycle_walk(file, pymodule_dict_value_name(type_name), active, depth + 1.usize())
        _ = active.pop()
        return result
    declaration: Ast::Decl? = pymodule_find_struct_in(file.top_decls, type_name)
    if declaration is target:
        if target is Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, pos):
            for member in members:
                member_cycle: bool = pymodule_struct_cycle_walk(file, pymodule_alias_type_name(file, member.type_expression), active, depth + 1.usize())
                if member_cycle:
                    _ = active.pop()
                    return true
    _ = active.pop()
    return false




def pymodule_struct_cycle_in_type(file: Ast::File&, type_name: sview, depth: usize) -> bool can[Abort.Panic, Memory.Allocate]:
    active: mutable darray[sview] = []
    return pymodule_struct_cycle_walk(file, type_name, active, depth)




def pymodule_struct_supported_depth(file: Ast::File&, type_name: sview, depth: usize) -> bool can[Abort.Panic, Memory.Allocate]:
    # A recursive value struct has no finite by-value layout. Keep the diagnostic deterministic
    # and bounded even when mutually recursive declarations are present in an otherwise valid
    # source file.
    return false if depth > 32.usize()
    return false if pymodule_struct_cycle_in_type(file, type_name, 0.usize())
    declaration: Ast::Decl? = pymodule_find_struct_in(file.top_decls, type_name)
    if declaration is target:
        if target is Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, pos):
            return false if members.count == 0
            for member in members:
                return false if member.is_ghost
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                if member.has_default:
                    return false if field_type_name == "" or field_type_name == "py::Object" or not pymodule_struct_default_supported(file, field_type_name, member.default_value)
                continue if pymodule_struct_scalar_field_type(field_type_name)
                return false if not pymodule_struct_supported_depth(file, field_type_name, depth + 1.usize())
            return true
    return false




def pymodule_struct_field_supported(file: Ast::File&, field: Ast::StructMember) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if field.is_ghost
    field_type_name: sview = pymodule_alias_type_name(file, field.type_expression)
    if field.has_default:
        return false if field_type_name == "" or field_type_name == "py::Object" or not pymodule_struct_default_supported(file, field_type_name, field.default_value)
    return true if pymodule_struct_scalar_field_type(field_type_name)
    return pymodule_struct_supported_depth(file, field_type_name, 1.usize())




def pymodule_struct_supported(file: Ast::File&, type_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    return pymodule_struct_supported_depth(file, type_name, 0.usize())




# Struct outputs may carry a small, explicitly owned aggregate: numeric/bool darrays.  The
# native backend already threads the caller arena for a returned struct containing a darray; the
# Python shim copies those fields before releasing that arena. Keep this predicate separate from
# `pymodule_struct_supported`, whose scalar-only meaning is used by the input/default path.
def pymodule_struct_return_supported_depth(file: Ast::File&, type_name: sview, depth: usize) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if depth > 32.usize()
    return false if pymodule_struct_cycle_in_type(file, type_name, 0.usize())
    declaration: Ast::Decl? = pymodule_find_struct_in(file.top_decls, type_name)
    if declaration is target:
        if target is Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, pos):
            return false if members.count == 0
            for member in members:
                return false if member.is_ghost
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                return false if member.has_default and not pymodule_struct_default_supported(file, field_type_name, member.default_value)
                continue if pymodule_struct_scalar_field_type(field_type_name)
                if pymodule_is_dict_type(field_type_name):
                    return false if not pymodule_nested_dict_values_supported_in_type(file, field_type_name, 0.usize())
                    continue
                if pymodule_is_set_type(field_type_name):
                    return false if not pymodule_set_element_supported(pymodule_set_element_name(field_type_name))
                    continue
                if pymodule_is_darray_type(field_type_name):
                    return false if not pymodule_struct_darray_return_element_supported(file, pymodule_darray_element_name(field_type_name))
                    continue
                if pymodule_is_view_type(field_type_name):
                    return false if not pymodule_view_return_supported(file, field_type_name, depth + 1.usize())
                    continue
                return false if not pymodule_struct_return_supported_depth(file, field_type_name, depth + 1.usize())
            return true
    return false




def pymodule_struct_return_supported(file: Ast::File&, type_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    return pymodule_struct_return_supported_depth(file, type_name, 0.usize())




def pymodule_struct_return_contains_darray_depth(file: Ast::File&, type_name: sview, depth: usize) -> bool can[Abort.Panic, Memory.Allocate]:
    return false if depth > 32.usize()
    declaration: Ast::Decl? = pymodule_find_struct_in(file.top_decls, type_name)
    if declaration is target:
        if target is Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, pos):
            for member in members:
                field_type_name: sview = pymodule_alias_type_name(file, member.type_expression)
                true return if pymodule_is_dict_type(field_type_name)
                true return if pymodule_is_set_type(field_type_name)
                true return if pymodule_is_darray_type(field_type_name)
                true return if pymodule_is_view_type(field_type_name)
                true return if pymodule_struct_return_contains_darray_depth(file, field_type_name, depth + 1.usize())
    return false




def pymodule_struct_return_contains_darray(file: Ast::File&, type_name: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    return pymodule_struct_return_contains_darray_depth(file, type_name, 0.usize())
