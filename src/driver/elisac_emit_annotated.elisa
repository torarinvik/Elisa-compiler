# `-emit tests` / `-emit benches` / `-emit fixtures` — one TAB-separated row per annotated
# function: its name, its rendered signature, and its effect families, deduplicated and sorted.


# `-emit tests` / `-emit benches` / `-emit fixtures` — one TAB-separated
# `NAME<TAB>SIGNATURE` row per annotated function, in declaration order, selected by the
# same substring `-filter` the test runner uses. stage0 refuses `-o` for all three, so the
# report always goes to stdout.
#
# The signature is stage0's SEMANTIC FuncType string, but every annotated function is
# already constrained to take NO PARAMETERS — a param-bearing `@test`/`@bench`/`@fixture`
# is a hard error raised before the listing runs — so the head is always `fn()`. That
# leaves two variable parts:
#
#   * the RETURN TYPE, recovered from the declaration line's tokens exactly the way
#     `-emit iface` recovers it (an absent `->` prints `void`); and
#   * the permission clause, which stage0 renders from the FAMILY names only —
#     `can[Memory.Allocate, Console.Write]` prints as `can[Console, Memory]`, i.e.
#     deduplicated and SORTED, not source order. A `@fixture` may not require permissions
#     at all, so in practice only tests and benches ever grow one.


# `Memory.Allocate` -> `Memory`. An effect with no dot is already a family.
def annotated_effect_family(effect: sview) -> sview can[Abort.Panic]:
    dot: i64 = sview_find_byte(effect, 46)
    effect return if dot < 0
    return string_view_prefix(effect, dot)




def annotated_family_less(left: sview, right: sview) -> bool can[Abort.Panic]:
    shorter: usize = sview_len(left) if sview_len(left) < sview_len(right) else sview_len(right)
    for probe in 0..<shorter |left, right|:
        left_byte: u8 = sview_at(left, probe)
        right_byte: u8 = sview_at(right, probe)
        true return if left_byte < right_byte
        false return if left_byte > right_byte
    return sview_len(left) < sview_len(right)




# ` can[A, B]`, families deduplicated and sorted ascending. Emits nothing when the
# function declares no effects.
def annotated_push_effects(buffer: mutable darray[u8]&, effects: darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    families: mutable darray[sview] = []
    for effect in effects |families|:
        family: sview = annotated_effect_family(effect)
        seen: mutable bool = false
        for known in families |seen, family|:
            seen <- true if known == family
        families.push(family) if not seen
    return if families.count == 0
    # Selection sort: the family count is bounded by the permission taxonomy, so the
    # quadratic shape is irrelevant and the code stays obviously correct.
    for slot in 0..<families.count |families|:
        best: mutable usize = slot
        for probe in (slot + 1)..<families.count |best, families|:
            best <- probe if annotated_family_less(families[probe], families[best])
        if best != slot:
            swap: sview = families[slot]
            families[slot] <- families[best]
            families[best] <- swap
    emit_tokens_push_sview(buffer, " can[")
    for index in 0..<families.count |buffer, families|:
        emit_tokens_push_sview(buffer, ", ") if index > 0
        emit_tokens_push_sview(buffer, families[index])
    emit_tokens_push_sview(buffer, "]")




# `fn() -> RET`, the return type taken from the declaration line's tokens.
def annotated_push_signature(buffer: mutable darray[u8]&, line: u32, offset: u32, tokens: darray[Lexer::Token]&, source: u8&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    emit_tokens_push_sview(buffer, "fn() -> ")
    line_range: (found: bool, start: usize, stop: usize) = emit_ast_range_at(tokens, line, offset)
    if not line_range.found:
        emit_tokens_push_sview(buffer, "void")
        return
    arrow_index: mutable usize = 0
    arrow_found: mutable bool = false
    for arrow_probe in line_range.start..<line_range.stop |arrow_index, arrow_found, tokens|:
        continue if arrow_found
        if tokens[arrow_probe].kind == Lexer::TokenKind.Arrow:
            arrow_index <- arrow_probe
            arrow_found <- true
    if not arrow_found:
        emit_tokens_push_sview(buffer, "void")
        return
    # The type ends at the effects clause when there is one, otherwise at the trailing
    # colon — which must be matched at bracket depth 0 so a tuple return `(a: i64)` or a
    # `dict[i64, i64]` does not truncate it.
    ret_stop: mutable usize = line_range.stop
    depth: mutable i64 = 0
    scanning: mutable bool = true
    for ret_probe in (arrow_index + 1)..<line_range.stop |ret_stop, depth, scanning, tokens, source|:
        continue if not scanning
        ret_token: Lexer::Token = tokens[ret_probe]
        depth <- depth + 1 if ret_token.kind == Lexer::TokenKind.LParen or ret_token.kind == Lexer::TokenKind.LBracket
        depth <- depth - 1 if ret_token.kind == Lexer::TokenKind.RParen or ret_token.kind == Lexer::TokenKind.RBracket
        stops: bool = depth == 0 and ((ret_token.kind == Lexer::TokenKind.Ident and Lexer::text_or_empty(ret_token, source) == "can") or ret_token.kind == Lexer::TokenKind.Colon)
        if stops:
            ret_stop <- ret_probe
            scanning <- false
    if ret_stop <= arrow_index + 1:
        emit_tokens_push_sview(buffer, "void")
        return
    emit_iface_render_tokens(buffer, tokens, source, arrow_index + 1, ret_stop)




def annotated_report_decls(buffer: mutable darray[u8]&, declarations: darray[Ast::Decl]&, annotation: sview, needle: darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    for declaration in declarations |buffer, annotation, needle, tokens, source|:
        if declaration is Decl.Module(ann_m_name, ann_m_body, ann_m_line):
            annotated_report_decls(buffer, ann_m_body, annotation, needle, tokens, source)
            continue
        if declaration is Decl.Scoped(ann_s_body, ann_s_line):
            annotated_report_decls(buffer, ann_s_body, annotation, needle, tokens, source)
            continue
        if declaration is Decl.Func(ann_f_name, ann_f_params, ann_f_ret, ann_f_body, ann_f_effects, ann_f_decorators, ann_f_line):
            matched: mutable bool = false
            for ann_f_decorator in ann_f_decorators |matched, annotation|:
                matched <- true if ann_f_decorator.name == annotation
            continue if not matched
            continue if not test_name_matches(ann_f_name, needle)
            emit_tokens_push_sview(buffer, ann_f_name)
            buffer.push(9)
            annotated_push_signature(buffer, ann_f_line.line, ann_f_line.offset, tokens, source)
            annotated_push_effects(buffer, ann_f_effects)
            buffer.push(10)




def emit_annotated_report(file: Ast::File&, annotation: sview, tokens: darray[Lexer::Token]&, source: u8&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    needle: mutable darray[u8] = []
    push_test_filter(&needle)
    buffer: mutable darray[u8] = []
    annotated_report_decls(&buffer, file.top_decls, annotation, needle, tokens, source)
    return emit_tokens_flush(buffer)
