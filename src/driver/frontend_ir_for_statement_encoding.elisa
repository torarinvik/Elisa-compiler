# Stage0 frontend-IR v2 IDs and supported binding modes for IterForStmt.
module FrontendIrForStatementEncoding:
    public:
        const enum ForBindingMode of u8:
            Value
            MutableReference
            Unsupported

        const enum ForStatementField of u8:
            Body
            Mode
            MovedSource
            Pattern
            Position
            Source

        const ITER_FOR_STMT_NODE_TYPE_ID: u32 = 143
        const MOVE_BIND_NAME_PATTERN_NODE_TYPE_ID: u32 = 187

        const ITER_FOR_BODY_FIELD_ID: u32 = 1
        const ITER_FOR_MODE_FIELD_ID: u32 = 3
        const ITER_FOR_MOVED_SOURCE_FIELD_ID: u32 = 4
        const ITER_FOR_PATTERN_FIELD_ID: u32 = 5
        const ITER_FOR_POSITION_FIELD_ID: u32 = 8
        const ITER_FOR_SOURCE_FIELD_ID: u32 = 12
        const MOVE_BIND_NAME_PATTERN_NAME_FIELD_ID: u32 = 1

        # Stage0's IterBindMode declaration is Value = 0, Ref = 1, MutableRef = 2.
        # Ref is rejected by the source parser; only Value and MutableReference are emitted.
        const ITER_BIND_VALUE_MODE_VALUE: i64 = 0
        const ITER_BIND_MUTABLE_REFERENCE_MODE_VALUE: i64 = 2
        const FOR_LOOP_NAME_BINDER_COUNT: usize = 1

        def binding_mode(bind: sview) -> ForBindingMode:
            ensure bind != "" or result == ForBindingMode.Value
            ensure bind != "mutable" or result == ForBindingMode.MutableReference
            ensure (bind == "" or bind == "mutable") or result == ForBindingMode.Unsupported
            return match bind:
                "": ForBindingMode.Value
                "mutable": ForBindingMode.MutableReference
                _: ForBindingMode.Unsupported

        def binding_mode_value(mode: ForBindingMode) -> i64:
            ensure mode != ForBindingMode.Value or result == ITER_BIND_VALUE_MODE_VALUE
            ensure mode != ForBindingMode.MutableReference or result == ITER_BIND_MUTABLE_REFERENCE_MODE_VALUE
            ensure mode != ForBindingMode.Unsupported or result == ITER_BIND_VALUE_MODE_VALUE
            match mode:
                ForBindingMode.Value:
                    return ITER_BIND_VALUE_MODE_VALUE
                ForBindingMode.MutableReference:
                    return ITER_BIND_MUTABLE_REFERENCE_MODE_VALUE
                ForBindingMode.Unsupported:
                    return ITER_BIND_VALUE_MODE_VALUE

        def binding_and_source_are_supported(mode: ForBindingMode, moved_source: bool) -> bool:
            ensure result == (mode == ForBindingMode.Value or (mode == ForBindingMode.MutableReference and not moved_source))
            match mode:
                ForBindingMode.Value:
                    return true
                ForBindingMode.MutableReference:
                    return not moved_source
                ForBindingMode.Unsupported:
                    return false

        def is_explicit_move_source(iterable: Ast::Expr) -> bool:
            return match iterable:
                Ast::Expr.Move(_, _): true
                _: false

        def node_type_id() -> u32:
            ensure result == ITER_FOR_STMT_NODE_TYPE_ID
            return ITER_FOR_STMT_NODE_TYPE_ID

        def pattern_node_type_id() -> u32:
            ensure result == MOVE_BIND_NAME_PATTERN_NODE_TYPE_ID
            return MOVE_BIND_NAME_PATTERN_NODE_TYPE_ID

        def pattern_name_field_id() -> u32:
            ensure result == MOVE_BIND_NAME_PATTERN_NAME_FIELD_ID
            return MOVE_BIND_NAME_PATTERN_NAME_FIELD_ID

        def field_id(field: ForStatementField) -> u32:
            ensure field != ForStatementField.Body or result == ITER_FOR_BODY_FIELD_ID
            ensure field != ForStatementField.Mode or result == ITER_FOR_MODE_FIELD_ID
            ensure field != ForStatementField.MovedSource or result == ITER_FOR_MOVED_SOURCE_FIELD_ID
            ensure field != ForStatementField.Pattern or result == ITER_FOR_PATTERN_FIELD_ID
            ensure field != ForStatementField.Position or result == ITER_FOR_POSITION_FIELD_ID
            ensure field != ForStatementField.Source or result == ITER_FOR_SOURCE_FIELD_ID
            match field:
                ForStatementField.Body:
                    return ITER_FOR_BODY_FIELD_ID
                ForStatementField.Mode:
                    return ITER_FOR_MODE_FIELD_ID
                ForStatementField.MovedSource:
                    return ITER_FOR_MOVED_SOURCE_FIELD_ID
                ForStatementField.Pattern:
                    return ITER_FOR_PATTERN_FIELD_ID
                ForStatementField.Position:
                    return ITER_FOR_POSITION_FIELD_ID
                ForStatementField.Source:
                    return ITER_FOR_SOURCE_FIELD_ID
