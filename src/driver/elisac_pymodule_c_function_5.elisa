# `-emit pymodule` — one exported function's C wrapper, stage 5 of 5: argument CLEANUP, the error
# raise, and the conversion of the result back into a Python object, one return shape at a
# time. Continues elisac_pymodule_c_function_4.elisa.

def emit_pymodule_c_function_5(buffer: mutable darray[u8]&, file: mutable Ast::File&, module_name: sview, annotation: Ast::EnumAnnotation) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    return if annotation.name != "__pymodule_fn"
    target_name: mutable sview = ""
    for target_annotation in file.enum_annotations |target_name, annotation|:
        target_name <- target_annotation.owner if target_annotation.name == "__pymodule_target_ref" and target_annotation.line == annotation.line
    target_decl: Ast::Decl? = pymodule_find_function_in(file.top_decls, target_name)
    if target_decl is target_function:
        if target_function is Decl.Func(target_function_name, source_params, target_return, target_body, target_effects, target_decorators, target_pos):
            target_params: mutable darray[Ast::ParamDecl] = pymodule_alias_normalize_params(file, source_params)
            return_type_name: mutable sview = "void"
            if target_return is declared_return:
                return_type_name <- pymodule_alias_type_name(file, declared_return)
            is_error: bool = pymodule_function_is_error(file, target_name)
            error_family: sview = pymodule_function_error_family(file, target_name) if is_error else ""
            has_payload_error: bool = is_error and pymodule_error_set_has_payload_in(file.top_decls, error_family)
            payload_type_name: sview = pymodule_error_payload_type_in(file, file.top_decls, error_family) if has_payload_error else ""
            structured_payload_error: bool = has_payload_error and pymodule_error_payload_is_structured_in(file.top_decls, error_family)
            has_payload_arena: bool = has_payload_error and pymodule_error_payload_needs_arena_in(file, file.top_decls, error_family)
            has_payload_struct: bool = has_payload_error and (pymodule_struct_return_supported(file, payload_type_name) if not structured_payload_error else pymodule_error_payload_contains_struct_in(file, file.top_decls, error_family))
            has_darray_param: mutable bool = false
            for darray_probe in target_params |has_darray_param|:
                has_darray_param <- true if pymodule_is_darray_type(pymodule_alias_type_name(file, darray_probe.type_expression))
            has_darray_ref_param: mutable bool = false
            for darray_ref_probe in target_params |has_darray_ref_param|:
                darray_ref_type_name: sview = pymodule_alias_type_name(file, darray_ref_probe.type_expression)
                has_darray_ref_param <- true if pymodule_darray_ref_parameter(darray_ref_type_name, darray_ref_probe.type_expression)
            has_struct_darray_param: mutable bool = false
            for struct_darray_probe in target_params |has_struct_darray_param|:
                struct_darray_type_name: sview = pymodule_alias_type_name(file, struct_darray_probe.type_expression)
                # Direct struct inputs also own a temporary arena/reference table.  Treat
                # them like aggregate sequence inputs so scalar-return wrappers cannot take
                # the expression fast path and leak that storage after a successful call.
                if pymodule_struct_input_supported(file, struct_darray_type_name):
                    has_struct_darray_param <- true
                elif pymodule_is_darray_type(struct_darray_type_name) or pymodule_is_view_type(struct_darray_type_name):
                    struct_darray_element_name: sview = pymodule_darray_element_name(struct_darray_type_name) if pymodule_is_darray_type(struct_darray_type_name) else pymodule_view_element_name(struct_darray_type_name)
                    has_struct_darray_param <- true if pymodule_struct_input_supported(file, struct_darray_element_name)
            has_dict_param: mutable bool = false
            for dict_probe in target_params |has_dict_param|:
                has_dict_param <- true if pymodule_is_dict_type(pymodule_alias_type_name(file, dict_probe.type_expression))
            has_set_param: mutable bool = false
            for set_probe in target_params |has_set_param|:
                has_set_param <- true if pymodule_is_set_type(pymodule_alias_type_name(file, set_probe.type_expression))
            has_view_param: mutable bool = false
            for view_probe in target_params |has_view_param|:
                has_view_param <- true if pymodule_is_view_type(pymodule_alias_type_name(file, view_probe.type_expression))
            has_dict_return: bool = pymodule_is_dict_type(return_type_name)
            has_set_return: bool = pymodule_is_set_type(return_type_name)
            has_view_return: bool = pymodule_is_view_type(return_type_name)
            has_optional_return: bool = pymodule_is_optional_scalar_type(return_type_name)
            has_struct_return: bool = pymodule_struct_return_supported(file, return_type_name)
            has_fixed_array_return: bool = pymodule_fixed_array_return_supported(return_type_name)
            has_output_arena: bool = pymodule_is_darray_type(return_type_name) or has_dict_return or has_set_return or (has_struct_return and pymodule_struct_return_contains_darray(file, return_type_name)) or has_payload_arena
            has_return_arena: bool = has_output_arena or has_darray_ref_param
            for parameter_index in 0..<target_params.count |buffer, target_params|:
                emit_tokens_push_sview(buffer, ", ") if parameter_index > 0 or has_struct_return or has_fixed_array_return or pymodule_is_darray_type(return_type_name) or has_dict_return or has_set_return or has_optional_return or is_error
                parameter_type_name: sview = pymodule_alias_type_name(file, target_params[parameter_index].type_expression)
                if parameter_type_name == "sview":
                    emit_tokens_push_sview(buffer, "(ElisaSView){arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_data, (int64_t)arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_len}")
                elif pymodule_is_dict_type(parameter_type_name) or pymodule_is_set_type(parameter_type_name):
                    emit_tokens_push_sview(buffer, "&arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_value")
                elif pymodule_fixed_array_input_supported(file, parameter_type_name, target_params[parameter_index].type_expression):
                    emit_tokens_push_sview(buffer, "arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_items")
                elif pymodule_is_darray_type(parameter_type_name) or pymodule_is_view_type(parameter_type_name) or pymodule_is_set_type(parameter_type_name):
                    emit_tokens_push_sview(buffer, "&arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, "_value")
                else:
                    if pymodule_is_optional_scalar_type(parameter_type_name):
                        emit_tokens_push_sview(buffer, "&arg")
                        append_decimal(buffer, parameter_index.i64())
                        continue
                    if parameter_type_name == "py::Object?" or parameter_type_name == "cstr?":
                        emit_tokens_push_sview(buffer, "arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_value")
                        continue
                    if pymodule_struct_input_supported(file, parameter_type_name):
                        emit_tokens_push_sview(buffer, "&arg")
                        append_decimal(buffer, parameter_index.i64())
                        emit_tokens_push_sview(buffer, "_value")
                        continue
                    emit_tokens_push_sview(buffer, "(PyObject *)(arg" if parameter_type_name == "py::Object" else "(const char *)(arg" if parameter_type_name == "cstr" else "(bool)(arg" if parameter_type_name == "bool" else "(double)(arg" if parameter_type_name == "f32" or parameter_type_name == "f64" else "(unsigned long long)(arg" if parameter_type_name == "u8" or parameter_type_name == "u16" or parameter_type_name == "u32" or parameter_type_name == "u64" or parameter_type_name == "usize" or parameter_type_name == "uintptr" else "(long long)(arg")
                    append_decimal(buffer, parameter_index.i64())
                    emit_tokens_push_sview(buffer, ")")
            emit_tokens_push_sview(buffer, ", &arena") if has_return_arena
            if is_error:
                emit_tokens_push_sview(buffer, ");\n    if (native_status != 0) {\n")
                if has_payload_error and (has_payload_arena or has_payload_struct):
                    # Aggregate payloads may borrow darray input storage; copy them before the
                    # normal argument cleanup runs, then release the arena exactly once.
                    emit_pymodule_error_payload_conversion_guarded(buffer, file, target_params, payload_type_name, error_family, structured_payload_error, has_return_arena)
                    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
                    emit_tokens_push_sview(buffer, "        arena_free(&arena);\n") if has_return_arena
                    emit_tokens_push_sview(buffer, "        return elisa_raise_error_family(\"")
                    emit_tokens_push_sview(buffer, annotation.owner)
                    emit_tokens_push_sview(buffer, "\", \"")
                    emit_tokens_push_sview(buffer, error_family)
                    emit_tokens_push_sview(buffer, "\", native_status, native_payload_object);\n    }\n")
                else:
                    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
                    if has_payload_error:
                        emit_pymodule_error_payload_conversion_after_input_cleanup(buffer, file, payload_type_name, error_family, structured_payload_error, has_return_arena)
                        emit_tokens_push_sview(buffer, "        arena_free(&arena);\n") if has_return_arena
                        emit_tokens_push_sview(buffer, "        return elisa_raise_error_family(\"")
                        emit_tokens_push_sview(buffer, annotation.owner)
                        emit_tokens_push_sview(buffer, "\", \"")
                        emit_tokens_push_sview(buffer, error_family)
                        emit_tokens_push_sview(buffer, "\", native_status, native_payload_object);\n    }\n")
                    else:
                        emit_tokens_push_sview(buffer, "        arena_free(&arena);\n") if has_return_arena
                        emit_tokens_push_sview(buffer, "        return elisa_raise_error_family(\"")
                        emit_tokens_push_sview(buffer, annotation.owner)
                        emit_tokens_push_sview(buffer, "\", \"")
                        emit_tokens_push_sview(buffer, error_family)
                        emit_tokens_push_sview(buffer, "\", native_status, NULL);\n    }\n")
            if return_type_name == "void":
                emit_tokens_push_sview(buffer, ");\n") if not is_error
                emit_pymodule_darray_cleanup(buffer, target_params, "    ")
                emit_pymodule_dict_cleanup(buffer, target_params, "    ")
                emit_tokens_push_sview(buffer, "    arena_free(&arena);\n") if has_darray_ref_param and not has_output_arena
                emit_tokens_push_sview(buffer, "    Py_RETURN_NONE;\n")
            elif return_type_name == "py::Object?":
                emit_tokens_push_sview(buffer, ");\n") if not is_error
                emit_pymodule_darray_cleanup(buffer, target_params, "    ")
                emit_pymodule_dict_cleanup(buffer, target_params, "    ")
                emit_tokens_push_sview(buffer, "    arena_free(&arena);\n") if has_darray_ref_param and not has_output_arena
                emit_tokens_push_sview(buffer, "    if (result == NULL) Py_RETURN_NONE;\n    Py_INCREF(result);\n    return result;\n")
            elif return_type_name == "py::Object":
                emit_tokens_push_sview(buffer, ");\n") if not is_error
                emit_pymodule_darray_cleanup(buffer, target_params, "    ")
                emit_pymodule_dict_cleanup(buffer, target_params, "    ")
                emit_tokens_push_sview(buffer, "    arena_free(&arena);\n") if has_darray_ref_param and not has_output_arena
                emit_tokens_push_sview(buffer, "    if (result == NULL) return NULL;\n    Py_INCREF(result);\n    return result;\n")
            elif return_type_name == "cstr?":
                emit_tokens_push_sview(buffer, ");\n") if not is_error
                emit_pymodule_darray_cleanup(buffer, target_params, "    ")
                emit_pymodule_dict_cleanup(buffer, target_params, "    ")
                emit_tokens_push_sview(buffer, "    arena_free(&arena);\n") if has_darray_ref_param and not has_output_arena
                emit_tokens_push_sview(buffer, "    if (result == NULL) Py_RETURN_NONE;\n    PyObject *out = PyUnicode_FromString(result);\n    return out;\n")
            elif return_type_name == "cstr":
                emit_tokens_push_sview(buffer, ");\n") if not is_error
                emit_tokens_push_sview(buffer, "    if (result == NULL) {\n")
                emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                emit_pymodule_dict_cleanup(buffer, target_params, "        ")
                emit_tokens_push_sview(buffer, "        arena_free(&arena);\n") if has_darray_ref_param and not has_output_arena
                emit_tokens_push_sview(buffer, "        PyErr_SetString(PyExc_RuntimeError, \"native Elisa function returned a null cstr\");\n        return NULL;\n    }\n    PyObject *out = PyUnicode_FromString(result);\n")
                emit_pymodule_darray_cleanup(buffer, target_params, "    ")
                emit_pymodule_dict_cleanup(buffer, target_params, "    ")
                emit_tokens_push_sview(buffer, "    arena_free(&arena);\n") if has_darray_ref_param and not has_output_arena
                emit_tokens_push_sview(buffer, "    return out;\n")
            elif return_type_name == "sview":
                emit_tokens_push_sview(buffer, ");\n") if not is_error
                emit_tokens_push_sview(buffer, "    if (result.len < 0) {\n")
                emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                emit_pymodule_dict_cleanup(buffer, target_params, "        ")
                emit_tokens_push_sview(buffer, "        arena_free(&arena);\n") if has_darray_ref_param and not has_output_arena
                emit_tokens_push_sview(buffer, "        PyErr_SetString(PyExc_RuntimeError, \"native Elisa function returned a negative sview length\");\n        return NULL;\n    }\n    if (result.data == NULL) {\n        if (result.len != 0) {\n")
                emit_pymodule_darray_cleanup(buffer, target_params, "            ")
                emit_pymodule_dict_cleanup(buffer, target_params, "            ")
                emit_tokens_push_sview(buffer, "            arena_free(&arena);\n") if has_darray_ref_param and not has_output_arena
                emit_tokens_push_sview(buffer, "            PyErr_SetString(PyExc_RuntimeError, \"native Elisa function returned an invalid sview\");\n            return NULL;\n        }\n        PyObject *out = PyUnicode_FromString(\"\");\n")
                emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                emit_pymodule_dict_cleanup(buffer, target_params, "        ")
                emit_tokens_push_sview(buffer, "        arena_free(&arena);\n") if has_darray_ref_param and not has_output_arena
                emit_tokens_push_sview(buffer, "        return out;\n    }\n    PyObject *out = PyUnicode_DecodeUTF8(result.data, (Py_ssize_t)result.len, \"strict\");\n")
                emit_pymodule_darray_cleanup(buffer, target_params, "    ")
                emit_pymodule_dict_cleanup(buffer, target_params, "    ")
                emit_tokens_push_sview(buffer, "    arena_free(&arena);\n") if has_darray_ref_param and not has_output_arena
                emit_tokens_push_sview(buffer, "    return out;\n")
            elif pymodule_is_view_type(return_type_name):
                emit_pymodule_view_return_conversion(buffer, file, target_params, return_type_name, is_error, has_darray_ref_param and not has_output_arena)
            elif pymodule_is_optional_scalar_type(return_type_name):
                emit_tokens_push_sview(buffer, ");\n") if not is_error
                emit_pymodule_darray_cleanup(buffer, target_params, "    ")
                emit_pymodule_dict_cleanup(buffer, target_params, "    ")
                emit_tokens_push_sview(buffer, "    arena_free(&arena);\n") if has_darray_ref_param and not has_output_arena
                emit_pymodule_optional_return_conversion(buffer, return_type_name, "native_result" if is_error else "result")
            elif pymodule_darray_is_bytes(return_type_name):
                emit_tokens_push_sview(buffer, ");\n") if not is_error
                emit_tokens_push_sview(buffer, "    if (result.count < 0 || result.count > PY_SSIZE_T_MAX) {\n")
                emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                emit_pymodule_dict_cleanup(buffer, target_params, "        ")
                emit_tokens_push_sview(buffer, "        arena_free(&arena);\n        PyErr_SetString(PyExc_RuntimeError, \"native Elisa function returned an invalid byte array length\");\n        return NULL;\n    }\n    if (result.count == 0) {\n        PyObject *out = PyBytes_FromStringAndSize(\"\", 0);\n")
                emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                emit_pymodule_dict_cleanup(buffer, target_params, "        ")
                emit_tokens_push_sview(buffer, "        arena_free(&arena);\n        return out;\n    }\n    if (result.items == NULL) {\n")
                emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                emit_pymodule_dict_cleanup(buffer, target_params, "        ")
                emit_tokens_push_sview(buffer, "        arena_free(&arena);\n        PyErr_SetString(PyExc_RuntimeError, \"native Elisa function returned a null byte array\");\n        return NULL;\n    }\n    PyObject *out = PyBytes_FromStringAndSize((const char *)result.items, (Py_ssize_t)result.count);\n")
                emit_pymodule_darray_cleanup(buffer, target_params, "    ")
                emit_pymodule_dict_cleanup(buffer, target_params, "    ")
                emit_tokens_push_sview(buffer, "    arena_free(&arena);\n    return out;\n")
            elif has_fixed_array_return:
                emit_tokens_push_sview(buffer, ");\n")
                emit_pymodule_fixed_array_return_conversion(buffer, target_params, pymodule_fixed_array_element_name(return_type_name), pymodule_fixed_array_extent(return_type_name), has_darray_ref_param and not has_output_arena)
            elif pymodule_struct_return_supported(file, return_type_name):
                emit_tokens_push_sview(buffer, ");\n    PyObject *out = elisa_pymodule_struct_")
                emit_tokens_push_sview(buffer, return_type_name)
                emit_tokens_push_sview(buffer, "_to_py(result);\n")
                if pymodule_struct_return_contains_darray(file, return_type_name):
                    emit_tokens_push_sview(buffer, "    if (out == NULL) {\n")
                    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
                    emit_tokens_push_sview(buffer, "        arena_free(&arena);\n        return NULL;\n    }\n")
                    emit_pymodule_darray_cleanup(buffer, target_params, "    ")
                    emit_pymodule_dict_cleanup(buffer, target_params, "    ")
                    emit_tokens_push_sview(buffer, "    arena_free(&arena);\n")
                else:
                    emit_pymodule_darray_cleanup(buffer, target_params, "    ")
                    emit_pymodule_dict_cleanup(buffer, target_params, "    ")
                    emit_tokens_push_sview(buffer, "    arena_free(&arena);\n") if has_darray_ref_param and not has_output_arena
                emit_tokens_push_sview(buffer, "    return out;\n")
            elif pymodule_is_darray_type(return_type_name):
                result_element_name: sview = pymodule_darray_element_name(return_type_name)
                if pymodule_is_view_type(result_element_name) and pymodule_view_bridge_supported(file, result_element_name):
                    emit_tokens_push_sview(buffer, ");\n") if not is_error
                    emit_tokens_push_sview(buffer, "    PyObject *view_out = elisa_pymodule_")
                    emit_tokens_push_sview(buffer, module_name)
                    emit_tokens_push_sview(buffer, "_")
                    emit_tokens_push_sview(buffer, annotation.owner)
                    emit_tokens_push_sview(buffer, "_view_return_to_py(result);\n")
                    emit_tokens_push_sview(buffer, "    if (view_out == NULL) {\n")
                    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
                    emit_tokens_push_sview(buffer, "        arena_free(&arena); return NULL;\n    }\n")
                    emit_pymodule_darray_cleanup(buffer, target_params, "    ")
                    emit_pymodule_dict_cleanup(buffer, target_params, "    ")
                    emit_tokens_push_sview(buffer, "    arena_free(&arena); return view_out;\n")
                    # This branch fully owns the wrapper's return path.  Falling
                    # through into the scalar darray conversion below emitted a
                    # second cast with an empty element C type (`(( *)...)`).
                    emit_tokens_push_sview(buffer, "}\n\n")
                    return
                elif pymodule_is_set_type(result_element_name):
                    emit_tokens_push_sview(buffer, ");\n") if not is_error
                    emit_tokens_push_sview(buffer, "    PyObject *nested_out = elisa_pymodule_")
                    emit_tokens_push_sview(buffer, module_name)
                    emit_tokens_push_sview(buffer, "_")
                    emit_tokens_push_sview(buffer, annotation.owner)
                    emit_tokens_push_sview(buffer, "_nested_return_to_py(result);\n")
                    emit_tokens_push_sview(buffer, "    if (nested_out == NULL) {\n")
                    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
                    emit_tokens_push_sview(buffer, "        arena_free(&arena); return NULL;\n    }\n")
                    emit_pymodule_darray_cleanup(buffer, target_params, "    ")
                    emit_pymodule_dict_cleanup(buffer, target_params, "    ")
                    emit_tokens_push_sview(buffer, "    arena_free(&arena); return nested_out;\n}\n\n")
                    return
                if pymodule_is_darray_type(result_element_name):
                    emit_tokens_push_sview(buffer, ");\n") if not is_error
                    emit_tokens_push_sview(buffer, "    PyObject *nested_out = elisa_pymodule_")
                    emit_tokens_push_sview(buffer, module_name)
                    emit_tokens_push_sview(buffer, "_")
                    emit_tokens_push_sview(buffer, annotation.owner)
                    emit_tokens_push_sview(buffer, "_nested_return_to_py(result);\n")
                    emit_tokens_push_sview(buffer, "    if (nested_out == NULL) {\n")
                    emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                    emit_pymodule_dict_cleanup(buffer, target_params, "        ")
                    emit_tokens_push_sview(buffer, "        arena_free(&arena); return NULL;\n    }\n")
                    emit_pymodule_darray_cleanup(buffer, target_params, "    ")
                    emit_pymodule_dict_cleanup(buffer, target_params, "    ")
                    emit_tokens_push_sview(buffer, "    arena_free(&arena); return nested_out;\n")
                result_element_c_type: mutable sview = pymodule_darray_c_element_type(result_element_name)
                result_element_c_type <- result_element_name if result_element_c_type == "" and pymodule_struct_return_supported(file, result_element_name)
                emit_tokens_push_sview(buffer, ");\n") if not is_error and not pymodule_is_darray_type(result_element_name)
                emit_tokens_push_sview(buffer, "    if (result.count < 0 || result.count > PY_SSIZE_T_MAX) {\n")
                emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                emit_pymodule_dict_cleanup(buffer, target_params, "        ")
                emit_tokens_push_sview(buffer, "        arena_free(&arena);\n        PyErr_SetString(PyExc_RuntimeError, \"native Elisa function returned an invalid list length\");\n        return NULL;\n    }\n    if (result.count == 0) {\n        PyObject *out = PyList_New(0);\n")
                emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                emit_pymodule_dict_cleanup(buffer, target_params, "        ")
                emit_tokens_push_sview(buffer, "        arena_free(&arena);\n        return out;\n    }\n    if (result.items == NULL) {\n")
                emit_pymodule_darray_cleanup(buffer, target_params, "        ")
                emit_pymodule_dict_cleanup(buffer, target_params, "        ")
