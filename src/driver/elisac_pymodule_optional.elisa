# `-emit pymodule` — OPTIONAL parameters and returns, and the runtime error-payload type
# declarations the generated module needs before any of the converters can be emitted.


def emit_pymodule_optional_input_setup(buffer: mutable darray[u8]&, target_params: darray[Ast::ParamDecl]&, type_name: sview, parameter_index: usize) -> void can[Abort.Panic, Memory.Allocate]:
    c_type: sview = pymodule_c_type_name(type_name)
    payload_name: sview = pymodule_optional_payload_name(type_name)
    if payload_name == "sview":
        emit_tokens_push_sview(buffer, "    ElisaOptionalSView arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, " = {false, {0, 0}};\n    if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_obj != Py_None) {\n        Py_ssize_t arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_len = 0; const char *arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_data = NULL; if (PyUnicode_Check(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_obj)) arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_data = PyUnicode_AsUTF8AndSize(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_obj, &arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_len); else if (PyBytes_Check(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_obj)) { char *arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_bytes_data = NULL; if (PyBytes_AsStringAndSize(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_obj, &arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_bytes_data, &arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_len) < 0) arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_data = NULL; else arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_data = arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_bytes_data; } else { PyErr_SetString(PyExc_TypeError, \"expected str or bytes for sview?\"); }\n        if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_data == NULL) {\n")
        emit_pymodule_darray_cleanup(buffer, target_params, "            ")
        emit_pymodule_dict_cleanup_one(buffer, target_params, parameter_index, "            ")
        emit_tokens_push_sview(buffer, "            return NULL;\n        }\n        if (elisa_pymodule_validate_utf8(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_data, arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_len) < 0) {\n")
        emit_pymodule_darray_cleanup(buffer, target_params, "            ")
        emit_pymodule_dict_cleanup_one(buffer, target_params, parameter_index, "            ")
        emit_tokens_push_sview(buffer, "            return NULL;\n        }\n        arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, " = (ElisaOptionalSView){true, (ElisaSView){arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_data, (int64_t)arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_len}};\n    }\n")
        return
    emit_tokens_push_sview(buffer, "    ")
    emit_tokens_push_sview(buffer, c_type)
    emit_tokens_push_sview(buffer, " arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, " = {false, 0};\n    if (arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_obj != Py_None) {\n")
    if payload_name == "bool":
        emit_tokens_push_sview(buffer, "        int arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_truth = PyObject_IsTrue(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_obj);\n        if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_truth < 0) {\n")
    elif payload_name == "f32" or payload_name == "f64":
        emit_tokens_push_sview(buffer, "        double arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number = PyFloat_AsDouble(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_obj);\n        if (PyErr_Occurred()) {\n")
    elif payload_name == "u8" or payload_name == "u16" or payload_name == "u32" or payload_name == "u64" or payload_name == "usize":
        emit_tokens_push_sview(buffer, "        unsigned long long arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number = PyLong_AsUnsignedLongLong(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_obj);\n        if (PyErr_Occurred()) {\n")
    else:
        emit_tokens_push_sview(buffer, "        long long arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number = PyLong_AsLongLong(arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_obj);\n        if (PyErr_Occurred()) {\n")
    emit_pymodule_darray_cleanup(buffer, target_params, "            ")
    emit_pymodule_dict_cleanup_one(buffer, target_params, parameter_index, "            ")
    emit_tokens_push_sview(buffer, "            return NULL;\n        }\n")
    if payload_name == "i8":
        emit_tokens_push_sview(buffer, "        if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number < -128 || arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number > 127) { PyErr_SetString(PyExc_OverflowError, \"i8 value out of range\");\n")
    elif payload_name == "i16":
        emit_tokens_push_sview(buffer, "        if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number < -32768 || arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number > 32767) { PyErr_SetString(PyExc_OverflowError, \"i16 value out of range\");\n")
    elif payload_name == "i32":
        emit_tokens_push_sview(buffer, "        if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number < -2147483648LL || arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number > 2147483647LL) { PyErr_SetString(PyExc_OverflowError, \"i32 value out of range\");\n")
    elif payload_name == "u8":
        emit_tokens_push_sview(buffer, "        if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number > 255ULL) { PyErr_SetString(PyExc_OverflowError, \"u8 value out of range\");\n")
    elif payload_name == "u16":
        emit_tokens_push_sview(buffer, "        if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number > 65535ULL) { PyErr_SetString(PyExc_OverflowError, \"u16 value out of range\");\n")
    elif payload_name == "u32":
        emit_tokens_push_sview(buffer, "        if (arg")
        append_decimal(buffer, parameter_index.i64())
        emit_tokens_push_sview(buffer, "_number > 4294967295ULL) { PyErr_SetString(PyExc_OverflowError, \"u32 value out of range\");\n")
    if payload_name == "i8" or payload_name == "i16" or payload_name == "i32" or payload_name == "u8" or payload_name == "u16" or payload_name == "u32":
        emit_pymodule_dict_cleanup_one(buffer, target_params, parameter_index, "            ")
        emit_tokens_push_sview(buffer, "            return NULL; }\n")
    emit_tokens_push_sview(buffer, "        arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, " = (")
    emit_tokens_push_sview(buffer, c_type)
    emit_tokens_push_sview(buffer, "){true, (")
    emit_tokens_push_sview(buffer, "bool" if payload_name == "bool" else "double" if payload_name == "f32" or payload_name == "f64" else "unsigned long long" if payload_name == "u8" or payload_name == "u16" or payload_name == "u32" or payload_name == "u64" or payload_name == "usize" else "long long")
    emit_tokens_push_sview(buffer, ")(arg")
    append_decimal(buffer, parameter_index.i64())
    emit_tokens_push_sview(buffer, "_truth" if payload_name == "bool" else "_number")
    emit_tokens_push_sview(buffer, ")};\n    }\n")




def emit_pymodule_optional_return_conversion(buffer: mutable darray[u8]&, type_name: sview, value_name: sview) -> void can[Abort.Panic, Memory.Allocate]:
    payload_name: sview = pymodule_optional_payload_name(type_name)
    emit_tokens_push_sview(buffer, "    if (!")
    emit_tokens_push_sview(buffer, value_name)
    emit_tokens_push_sview(buffer, ".has_value) Py_RETURN_NONE;\n")
    if payload_name == "sview":
        emit_tokens_push_sview(buffer, "    if (")
        emit_tokens_push_sview(buffer, value_name)
        emit_tokens_push_sview(buffer, ".value.len < 0 || (")
        emit_tokens_push_sview(buffer, value_name)
        emit_tokens_push_sview(buffer, ".value.data == NULL && ")
        emit_tokens_push_sview(buffer, value_name)
        emit_tokens_push_sview(buffer, ".value.len != 0)) { PyErr_SetString(PyExc_RuntimeError, \"native optional sview has invalid length\"); return NULL; }\n    if (")
        emit_tokens_push_sview(buffer, value_name)
        emit_tokens_push_sview(buffer, ".value.data == NULL) return PyUnicode_FromString(\"\");\n    return PyUnicode_DecodeUTF8(")
        emit_tokens_push_sview(buffer, value_name)
        emit_tokens_push_sview(buffer, ".value.data, (Py_ssize_t)")
        emit_tokens_push_sview(buffer, value_name)
        emit_tokens_push_sview(buffer, ".value.len, \"strict\");\n")
        return
    if payload_name == "bool":
        emit_tokens_push_sview(buffer, "    return PyBool_FromLong((long)")
    elif payload_name == "f32" or payload_name == "f64":
        emit_tokens_push_sview(buffer, "    return PyFloat_FromDouble((double)")
    elif payload_name == "u8" or payload_name == "u16" or payload_name == "u32" or payload_name == "u64" or payload_name == "usize":
        emit_tokens_push_sview(buffer, "    return PyLong_FromUnsignedLongLong((unsigned long long)")
    else:
        emit_tokens_push_sview(buffer, "    return PyLong_FromLongLong((long long)")
    emit_tokens_push_sview(buffer, value_name)
    emit_tokens_push_sview(buffer, ".value);\n")




def emit_pymodule_runtime_error_payload_types(buffer: mutable darray[u8]&, file: Ast::File&, error_families: darray[sview]&) -> void can[Abort.Panic, Memory.Allocate]:
    # Structured error payload variants are TypedDict declarations in the stub.
    # Publish matching runtime factories too, so explicit imports used by
    # serializers, validation helpers, and IDE-generated code do not fail at
    # runtime. The aliases are deliberately kept out of __all__: they are type
    # helpers, not ordinary Elisa exports.
    payload_variant_index: mutable usize = 0.usize()
    for payload_family in error_families |buffer, file, payload_variant_index|:
        continue if not pymodule_error_payload_is_structured_in(file.top_decls, payload_family)
        payload_decl: Ast::Decl? = pymodule_error_decl_in(file.top_decls, payload_family)
        if payload_decl is payload_enum_decl:
            if payload_enum_decl is Decl.Enum(payload_enum_name, payload_variants, payload_const, payload_storage, payload_pos):
                variant_count: usize = payload_variants.count
                continue if variant_count == 0
                family_start_index: usize = payload_variant_index
                emit_tokens_push_sview(buffer, "    {\n")
                for payload_variant in payload_variants |buffer, file, payload_variant_index|:
                    emit_tokens_push_sview(buffer, "        PyObject *elisa_payload_name_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, " = elisa_pymodule_choose_generated_name(module, \"")
                    emit_tokens_push_sview(buffer, payload_family)
                    emit_tokens_push_sview(buffer, payload_variant.name)
                    emit_tokens_push_sview(buffer, "Payload\"); if (elisa_payload_name_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(module); return NULL; } const char *elisa_payload_name_text_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, " = PyUnicode_AsUTF8(elisa_payload_name_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, "); if (elisa_payload_name_text_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(elisa_payload_name_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(module); return NULL; } PyObject *elisa_payload_type_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, " = elisa_pymodule_make_struct_type_with_optional(elisa_payload_name_text_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, ", elisa_pymodule_payload_fields_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, ", elisa_pymodule_payload_optional_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, "); if (elisa_payload_type_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, " == NULL || elisa_pymodule_stamp_type_module(module, elisa_payload_type_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, ") < 0) { Py_XDECREF(elisa_payload_type_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(elisa_payload_name_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(module); return NULL; } if (PyModule_AddObject(module, elisa_payload_name_text_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, ", elisa_payload_type_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, ") < 0) { Py_DECREF(elisa_payload_type_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(elisa_payload_name_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(module); return NULL; } elisa_payload_type_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, " = PyObject_GetAttrString(module, elisa_payload_name_text_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(elisa_payload_name_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, "); if (elisa_payload_type_")
                    append_decimal(buffer, payload_variant_index.u32())
                    emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(module); return NULL; }\n")
                    payload_variant_index <- payload_variant_index + 1.usize()
                alias_index: usize = payload_variant_index
                emit_tokens_push_sview(buffer, "        PyObject *elisa_payload_union_name_")
                append_decimal(buffer, alias_index.u32())
                emit_tokens_push_sview(buffer, " = elisa_pymodule_choose_generated_name(module, \"")
                emit_tokens_push_sview(buffer, payload_family)
                emit_tokens_push_sview(buffer, "Payload\"); if (elisa_payload_union_name_")
                append_decimal(buffer, alias_index.u32())
                emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(module); return NULL; } const char *elisa_payload_union_name_text_")
                append_decimal(buffer, alias_index.u32())
                emit_tokens_push_sview(buffer, " = PyUnicode_AsUTF8(elisa_payload_union_name_")
                append_decimal(buffer, alias_index.u32())
                emit_tokens_push_sview(buffer, "); if (elisa_payload_union_name_text_")
                append_decimal(buffer, alias_index.u32())
                emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(elisa_payload_union_name_")
                append_decimal(buffer, alias_index.u32())
                emit_tokens_push_sview(buffer, "); Py_DECREF(module); return NULL; }\n")
                if variant_count == 1:
                    emit_tokens_push_sview(buffer, "        Py_INCREF(elisa_payload_type_")
                    append_decimal(buffer, family_start_index.u32())
                    emit_tokens_push_sview(buffer, "); if (PyModule_AddObject(module, elisa_payload_union_name_text_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, ", elisa_payload_type_")
                    append_decimal(buffer, family_start_index.u32())
                    emit_tokens_push_sview(buffer, ") < 0) { Py_DECREF(elisa_payload_type_")
                    append_decimal(buffer, family_start_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(elisa_payload_union_name_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(module); return NULL; } Py_DECREF(elisa_payload_type_")
                    append_decimal(buffer, family_start_index.u32())
                    emit_tokens_push_sview(buffer, ");\n")
                else:
                    emit_tokens_push_sview(buffer, "        PyObject *elisa_payload_union_args_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, " = PyTuple_New(")
                    append_decimal(buffer, variant_count.u32())
                    emit_tokens_push_sview(buffer, "); if (elisa_payload_union_args_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, " == NULL) { Py_DECREF(elisa_payload_union_name_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(module); return NULL; }\n")
                    for payload_union_index in family_start_index..<payload_variant_index |buffer|:
                        emit_tokens_push_sview(buffer, "        Py_INCREF(elisa_payload_type_")
                        append_decimal(buffer, payload_union_index.u32())
                        emit_tokens_push_sview(buffer, "); PyTuple_SET_ITEM(elisa_payload_union_args_")
                        append_decimal(buffer, alias_index.u32())
                        emit_tokens_push_sview(buffer, ", ")
                        append_decimal(buffer, (payload_union_index - family_start_index).u32())
                        emit_tokens_push_sview(buffer, ", elisa_payload_type_")
                        append_decimal(buffer, payload_union_index.u32())
                        emit_tokens_push_sview(buffer, "); Py_DECREF(elisa_payload_type_")
                        append_decimal(buffer, payload_union_index.u32())
                        emit_tokens_push_sview(buffer, ");\n")
                    emit_tokens_push_sview(buffer, "        PyObject *elisa_payload_typing_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, " = PyImport_ImportModule(\"typing\"); PyObject *elisa_payload_union_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, " = elisa_payload_typing_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, " == NULL ? NULL : PyObject_GetAttrString(elisa_payload_typing_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, ", \"Union\"); PyObject *elisa_payload_union_value_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, " = elisa_payload_union_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, " == NULL ? NULL : PyObject_GetItem(elisa_payload_union_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, ", elisa_payload_union_args_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_XDECREF(elisa_payload_union_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_XDECREF(elisa_payload_typing_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(elisa_payload_union_args_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, ");\n")
                    for payload_release_index in family_start_index..<payload_variant_index |buffer|:
                        emit_tokens_push_sview(buffer, "        Py_DECREF(elisa_payload_type_")
                        append_decimal(buffer, payload_release_index.u32())
                        emit_tokens_push_sview(buffer, ");\n")
                    emit_tokens_push_sview(buffer, "        if (elisa_payload_union_value_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, " == NULL || PyModule_AddObject(module, elisa_payload_union_name_text_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, ", elisa_payload_union_value_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, ") < 0) { Py_XDECREF(elisa_payload_union_value_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(elisa_payload_union_name_")
                    append_decimal(buffer, alias_index.u32())
                    emit_tokens_push_sview(buffer, "); Py_DECREF(module); return NULL; }\n")
                emit_tokens_push_sview(buffer, "        Py_DECREF(elisa_payload_union_name_")
                append_decimal(buffer, alias_index.u32())
                emit_tokens_push_sview(buffer, ");\n    }\n")
