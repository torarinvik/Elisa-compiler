# Find the return type in an exported function signature without including
# trailing effect clauses. Parenthesized and generic type arguments can contain
# delimiters of their own, so only header-level tokens end the return type.
def wasm_export_return_span(tokens: darray[Lexer::Token]&, source: u8&, close_index: usize, range_stop: usize) -> (start: usize, stop: usize) can[Abort.Panic]:
    return_start: mutable usize = range_stop
    return_stop: mutable usize = range_stop
    nesting: mutable i64 = 0
    source_length: usize = Lexer::token_stream_source_length(tokens)
    for index in close_index..<range_stop |return_start, return_stop, nesting, tokens, source, source_length|:
        token: Lexer::Token = tokens[index]
        if return_start == range_stop:
            return_start <- index + 1 if token.kind == Lexer::TokenKind.Arrow
            continue
        if return_stop != range_stop:
            continue
        effect_clause: bool = index > return_start and nesting == 0 and token.kind == Lexer::TokenKind.Ident and index + 1.usize() < range_stop and tokens[index + 1.usize()].kind == Lexer::TokenKind.LBracket and Lexer::text_or_empty(token, source, source_length) == "can"
        if nesting == 0 and (token.kind == Lexer::TokenKind.Assign or token.kind == Lexer::TokenKind.Colon or effect_clause):
            return_stop <- index
        elif token.kind == Lexer::TokenKind.LParen or token.kind == Lexer::TokenKind.LBracket:
            nesting <- nesting + 1
        elif token.kind == Lexer::TokenKind.RParen or token.kind == Lexer::TokenKind.RBracket:
            nesting <- nesting - 1
    return (return_start, return_stop)
