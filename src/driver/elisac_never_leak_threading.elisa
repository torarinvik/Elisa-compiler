# -Wnever-leak, category VALUE_THREAD (src/semantic/check_never_leak_threading*.elisa): the text
# of one finding. A rewritable site prints the rebinding built from its own source line; a
# candidate (strict only) prints why no rewrite applies.

# The reason, with the one shape only the source text shows: a statement continued on the next
# line cannot be spelled as one rebinding verbatim.
def nl_vt_reason(finding: Semantic::NeverLeakFinding&, source: NeverLeakSource&) -> u8 can[Abort.Panic]:
    finding.acc_reason return if finding.acc_reason != Semantic::NEVER_LEAK_VT_OK
    next: mutable u32 = finding.decl_line + 1
    while next.usize() <= source.starts.count and nl_line_is_filler(source, next) |next, source|:
        next <- next + 1
    Semantic::NEVER_LEAK_VT_SHAPE return if next.usize() <= source.starts.count and nl_indent_width(source, next) > nl_indent_width(source, finding.decl_line)
    return Semantic::NEVER_LEAK_VT_OK


# The reasons, as stat-row suffixes.
def nl_vt_reason_name(reason: u8) -> sview can[Abort.Panic]:
    return when reason:
        0 -> ""
        1 -> "-borrow"
        2 -> "-borrowed-field"
        3 -> "-global"
        4 -> "-arena"
        5 -> "-effect-only"
        _ -> "-shape"


def nl_report_value_thread(finding: Semantic::NeverLeakFinding&, names: darray[sview]&, source: NeverLeakSource&, mode: u8, reason: u8) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    text: mutable darray[u8] = []
    first: usize = finding.acc_first.usize()
    owned: bool = reason == Semantic::NEVER_LEAK_VT_OK or reason == Semantic::NEVER_LEAK_VT_ARENA or reason == Semantic::NEVER_LEAK_VT_EFFECT_ONLY or reason == Semantic::NEVER_LEAK_VT_SHAPE
    nl_push_location(text, source, finding.decl_line)
    emit_tokens_push_sview(text, ": error: " if mode == 2 else ": warning: ")
    emit_tokens_push_sview(text, "owned local " if owned else "")
    nl_push_name(text, finding.name)
    emit_tokens_push_sview(text, " is changed in place by a statement that drops the call's result [-Wnever-leak]\n  ")
    nl_push_name(text, finding.name)
    emit_tokens_push_sview(text, ": ")
    if reason == Semantic::NEVER_LEAK_VT_BORROW:
        emit_tokens_push_sview(text, "a borrow (")
        nl_vt_push_typed(text, finding.bind_name, names[first])
        emit_tokens_push_sview(text, ") declared on ")
        nl_push_line_ref(text, source, finding.other_decl_line)
    elif reason == Semantic::NEVER_LEAK_VT_BORROWED_FIELD:
        emit_tokens_push_sview(text, "reached through the borrow ")
        nl_push_name(text, finding.bind_name)
        emit_tokens_push_sview(text, " (")
        nl_vt_push_typed(text, finding.bind_name, names[first])
        text.push(41)
    elif reason == Semantic::NEVER_LEAK_VT_GLOBAL:
        emit_tokens_push_sview(text, "a global (")
        nl_vt_push_typed(text, finding.bind_name, names[first])
        text.push(41)
    else:
        emit_tokens_push_sview(text, "declared on ")
        nl_push_line_ref(text, source, finding.other_decl_line)
        if reason == Semantic::NEVER_LEAK_VT_ARENA:
            emit_tokens_push_sview(text, " inside `")
            emit_tokens_push_sview(text, names[first])
            emit_tokens_push_sview(text, ":`")
    emit_tokens_push_sview(text, "; changed in place on ")
    nl_push_line_ref(text, source, finding.decl_line)
    emit_tokens_push_sview(text, " by ")
    nl_push_quoted_line(text, source, finding.decl_line)
    text.push(10)
    if reason != Semantic::NEVER_LEAK_VT_OK:
        emit_tokens_push_sview(text, "  kind: value-threading candidate (an in-place call no value-threading rewrite fits; reported by -Wnever-leak=strict only)\n")
        nl_vt_render_excluded(text, finding, names, source, reason)
        write_stderr(text)
        return
    emit_tokens_push_sview(text, "  kind: value-threading (an owned local that a statement changes through an in-place call whose result it drops)\n")
    emit_tokens_push_sview(text, "  why: the line reads as a call made for its effect, and nothing at its start says that ")
    nl_push_name(text, finding.name)
    emit_tokens_push_sview(text, " changes; as a rebinding, `")
    emit_tokens_push_sview(text, finding.name)
    emit_tokens_push_sview(text, " <- ...` names the value the line changes, the way every other update of a local does\n")
    emit_tokens_push_sview(text, "  fix: thread the value through the call (same machine code as the in-place form at -O0 and -O2):\n")
    nl_push_spaces(text, 6 + nl_indent_width(source, finding.decl_line))
    emit_tokens_push_sview(text, finding.name)
    emit_tokens_push_sview(text, " <- ")
    nl_push_bytes(text, source, nl_line_start(source, finding.decl_line) + nl_indent_width(source, finding.decl_line), nl_line_end(source, finding.decl_line))
    text.push(10)
    write_stderr(text)


# `name: type` in backquotes.
def nl_vt_push_typed(text: mutable darray[u8]&, name: sview, type_text: sview) -> void can[Abort.Panic, Memory.Allocate]:
    text.push(96)
    emit_tokens_push_sview(text, name)
    emit_tokens_push_sview(text, ": ")
    emit_tokens_push_sview(text, type_text)
    text.push(96)


def nl_vt_render_excluded(text: mutable darray[u8]&, finding: Semantic::NeverLeakFinding&, names: darray[sview]&, source: NeverLeakSource&, reason: u8) -> void can[Abort.Panic, Memory.Allocate]:
    first: usize = finding.acc_first.usize()
    emit_tokens_push_sview(text, "  no value-threading rewrite applies: ")
    if reason == Semantic::NEVER_LEAK_VT_BORROW:
        nl_push_name(text, finding.name)
        emit_tokens_push_sview(text, " is a borrow, so its storage belongs to the caller and cannot be moved into the call and bound again here; keep the in-place call\n")
    elif reason == Semantic::NEVER_LEAK_VT_BORROWED_FIELD:
        nl_push_name(text, finding.name)
        emit_tokens_push_sview(text, " is part of the borrow ")
        nl_push_name(text, finding.bind_name)
        emit_tokens_push_sview(text, ", so only the owner of ")
        nl_push_name(text, finding.bind_name)
        emit_tokens_push_sview(text, " can move it out and put it back; keep the in-place call\n")
    elif reason == Semantic::NEVER_LEAK_VT_GLOBAL:
        nl_push_name(text, finding.name)
        emit_tokens_push_sview(text, " is a global, which any function may read by name while the call runs, so it stays in place; keep the in-place call\n")
    elif reason == Semantic::NEVER_LEAK_VT_ARENA:
        emit_tokens_push_sview(text, "the arena of `")
        emit_tokens_push_sview(text, names[first])
        emit_tokens_push_sview(text, ":` owns the storage of ")
        nl_push_name(text, finding.name)
        emit_tokens_push_sview(text, " and grows it in place, so keep the in-place call inside the block\n")
    elif reason == Semantic::NEVER_LEAK_VT_EFFECT_ONLY:
        nl_push_name(text, finding.other_name)
        emit_tokens_push_sview(text, " takes ")
        nl_push_name(text, finding.name)
        emit_tokens_push_sview(text, " as `mutable ")
        emit_tokens_push_sview(text, names[first])
        emit_tokens_push_sview(text, "&` and returns nothing, so the call is there only for its effect and has no value form to call; give ")
        nl_push_name(text, finding.other_name)
        emit_tokens_push_sview(text, " one that takes `")
        emit_tokens_push_sview(text, names[first + 2])
        emit_tokens_push_sview(text, ": ")
        emit_tokens_push_sview(text, names[first])
        emit_tokens_push_sview(text, "` by value and returns it (`-> ")
        emit_tokens_push_sview(text, names[first])
        emit_tokens_push_sview(text, "`, STYLE_GUIDE.md section 6), and the call becomes `")
        emit_tokens_push_sview(text, finding.name)
        emit_tokens_push_sview(text, " <- ")
        emit_tokens_push_sview(text, names[first + 1])
        emit_tokens_push_sview(text, "`\n")
    else:
        emit_tokens_push_sview(text, "the statement continues past ")
        nl_push_line_ref(text, source, finding.decl_line)
        emit_tokens_push_sview(text, ", so it cannot be spelled as one rebinding as written; put the call on one line and the rewrite applies\n")
