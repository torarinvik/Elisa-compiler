# Closed TypeScript projection used by generated WASM declarations and facades.
module WasmTypeScriptType:
    public:
        def wasm_ts_type(type_text: sview, parameter: bool) -> sview:
            ensure (result == "string | number") == (type_text == "cstr" and parameter)
            ensure (result == "string") == (type_text == "cstr" and not parameter)
            ensure (result == "bigint") == (
                when type_text:
                    "i64" | "u64" | "char" -> true
                    _ -> false
            )
            ensure (result == "boolean") == (type_text == "bool")
            ensure (result == "void") == (type_text == "void")
            ensure (result == "number") == (
                when type_text:
                    "cstr" | "i64" | "u64" | "char" | "bool" | "void" -> false
                    _ -> true
            )
            return when type_text:
                "cstr" -> ("string | number" if parameter else "string")
                "i64" | "u64" | "char" -> "bigint"
                "bool" -> "boolean"
                "void" -> "void"
                _ -> "number"

        def wasm_ts_input_requires_bigint(type_text: sview) -> bool:
            ensure result == (
                when type_text:
                    "i64" | "u64" | "char" -> true
                    _ -> false
            )
            return when type_text:
                "i64" | "u64" | "char" -> true
                _ -> false
