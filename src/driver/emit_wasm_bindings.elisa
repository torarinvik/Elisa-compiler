# `-emit wasm` — the TYPE MAPPING. One Elisa type becomes a wasm scalar type, a TypeScript type,
# and the JS input/output conversions that wrap a call. This is the Python's normalize_type +
# abi_for_type + js_input/js_output, and every sidecar is a projection of it.
# Continues emit_wasm.elisa.


def wasm_storage_keyword(kind: Lexer::TokenKind) -> bool:
    return kind == Lexer::TokenKind.Mutable or kind == Lexer::TokenKind.Lmut or kind == Lexer::TokenKind.Heap or kind == Lexer::TokenKind.Stack or kind == Lexer::TokenKind.Static




# The Python's normalize_type: whitespace removed, one leading storage keyword dropped.
def wasm_push_type_text(buffer: mutable darray[u8]&, tokens: darray[Lexer::Token]&, source: u8&, start: usize, stop: usize) -> void can[Abort.Panic, Memory.Allocate]:
    first: mutable bool = true
    for index in start..<stop |buffer, first, tokens, source|:
        skip: bool = first and wasm_storage_keyword(tokens[index].kind)
        emit_tokens_push_sview(buffer, Lexer::text_or_empty(tokens[index], source)) if not skip
        first <- false




def wasm_scalar_wasm_type(type_text: sview) -> sview:
    return when type_text:
        "i8" | "u8" | "i16" | "u16" | "i32" | "u32" | "int" | "isize" | "usize" | "uintptr" | "bool" -> "i32"
        "i64" | "u64" | "char" -> "i64"
        "f32" -> "f32"
        "f64" -> "f64"
        "void" -> "void"
        _ -> ""




# abi_for_type: (binding, wasm type), or binding "" with the Python's message in `message`.
def wasm_abi_binding(type_text: sview, function: sview, position: sview, component: bool, message: mutable darray[u8]&) -> (binding: sview, wasm_type: sview) can[Abort.Panic, Memory.Allocate]:
    length: usize = sview_len(type_text)
    if length > 0 and sview_at(type_text, length - 1) == 63:
        emit_tokens_push_sview(message, function)
        emit_tokens_push_sview(message, ": ")
        emit_tokens_push_sview(message, position)
        emit_tokens_push_sview(message, " type '")
        emit_tokens_push_sview(message, type_text)
        emit_tokens_push_sview(message, "' is nullable; use an explicit scalar/pointer adapter because nullable aggregates do not have a stable JS ABI")
        return ("", "")
    ("string", "i32") return if type_text == "cstr"
    ("pointer", "i32") return if length > 0 and sview_at(type_text, length - 1) == 38
    scalar: sview = wasm_scalar_wasm_type(type_text)
    ("scalar", scalar) return if scalar != ""
    # A component type file supplies the semantic WIT shape for named scalar
    # enums. Their core canonical ABI representation is i32; unlike the JS
    # facade, the component path does not need to invent a binding for the
    # source-level enum name. wasm-component-ld validates the resulting core
    # export against the supplied WIT type.
    ("scalar", "i32") return if component
    emit_tokens_push_sview(message, function)
    emit_tokens_push_sview(message, ": ")
    emit_tokens_push_sview(message, position)
    emit_tokens_push_sview(message, " type '")
    emit_tokens_push_sview(message, type_text)
    emit_tokens_push_sview(message, "' is not directly representable in the generated WASM bindings; export a scalar or pointer adapter")
    return ("", "")




def wasm_ts_type(type_text: sview, parameter: bool) -> sview:
    ("string | number" if parameter else "string") return if type_text == "cstr"
    "bigint" return if type_text == "i64" or type_text == "u64" or type_text == "char"
    "boolean" return if type_text == "bool"
    "void" return if type_text == "void"
    return "number"




def wasm_push_js_input(buffer: mutable darray[u8]&, type_text: sview, name: sview) -> void can[Abort.Panic, Memory.Allocate]:
    if type_text == "i64" or type_text == "u64" or type_text == "char":
        emit_tokens_push_sview(buffer, "BigInt(")
        emit_tokens_push_sview(buffer, name)
        emit_tokens_push_sview(buffer, ")")
        return
    if type_text == "bool":
        emit_tokens_push_sview(buffer, name)
        emit_tokens_push_sview(buffer, " ? 1 : 0")
        return
    emit_tokens_push_sview(buffer, name)




# js_output wraps the call EXPRESSION (already in `call`).
def wasm_push_js_output(buffer: mutable darray[u8]&, type_text: sview, call: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
    prefix: mutable sview = ""
    suffix: mutable sview = ""
    if type_text == "cstr":
        prefix <- "memoryTools.readString("
        suffix <- ")"
    elif type_text == "bool":
        prefix <- "!!("
        suffix <- ")"
    elif type_text == "i8":
        prefix <- "(("
        suffix <- " << 24) >> 24)"
    elif type_text == "i16":
        prefix <- "(("
        suffix <- " << 16) >> 16)"
    elif type_text == "isize":
        prefix <- "(("
        suffix <- ") | 0)"
    elif type_text == "u8":
        prefix <- "(("
        suffix <- ") & 0xff)"
    elif type_text == "u16":
        prefix <- "(("
        suffix <- ") & 0xffff)"
    elif type_text == "u32" or type_text == "usize" or type_text == "uintptr":
        prefix <- "(("
        suffix <- ") >>> 0)"
    emit_tokens_push_sview(buffer, prefix)
    for index in 0..<call.count |buffer, call|:
        buffer.push(call[index])
    emit_tokens_push_sview(buffer, suffix)




def wasm_utf8_scalar_at(text: darray[u8]&, index: usize) -> (codepoint: i64, width: usize):
    first: u8 = text[index]
    return (first.i64(), 1.usize()) if first < 0x80

    if first >= 0xC2 and first <= 0xDF and index + 1 < text.count:
        second: u8 = text[index + 1]
        if second >= 0x80 and second <= 0xBF:
            return (((first.i64() & 0x1F) << 6) | (second.i64() & 0x3F), 2.usize())

    if index + 2 < text.count:
        second: u8 = text[index + 1]
        third: u8 = text[index + 2]
        valid_second: bool = second >= 0x80 and second <= 0xBF
        valid_third: bool = third >= 0x80 and third <= 0xBF
        if first == 0xE0 and second >= 0xA0 and second <= 0xBF and valid_third:
            codepoint: i64 = ((first.i64() & 0x0F) << 12) | ((second.i64() & 0x3F) << 6) | (third.i64() & 0x3F)
            return (codepoint, 3.usize())
        if first >= 0xE1 and first <= 0xEC and valid_second and valid_third:
            codepoint: i64 = ((first.i64() & 0x0F) << 12) | ((second.i64() & 0x3F) << 6) | (third.i64() & 0x3F)
            return (codepoint, 3.usize())
        if first == 0xED and second >= 0x80 and second <= 0x9F and valid_third:
            codepoint: i64 = ((first.i64() & 0x0F) << 12) | ((second.i64() & 0x3F) << 6) | (third.i64() & 0x3F)
            return (codepoint, 3.usize())
        if first >= 0xEE and first <= 0xEF and valid_second and valid_third:
            codepoint: i64 = ((first.i64() & 0x0F) << 12) | ((second.i64() & 0x3F) << 6) | (third.i64() & 0x3F)
            return (codepoint, 3.usize())

    if index + 3 < text.count:
        second: u8 = text[index + 1]
        third: u8 = text[index + 2]
        fourth: u8 = text[index + 3]
        valid_third: bool = third >= 0x80 and third <= 0xBF
        valid_fourth: bool = fourth >= 0x80 and fourth <= 0xBF
        if first == 0xF0 and second >= 0x90 and second <= 0xBF and valid_third and valid_fourth:
            codepoint: i64 = ((first.i64() & 0x07) << 18) | ((second.i64() & 0x3F) << 12) | ((third.i64() & 0x3F) << 6) | (fourth.i64() & 0x3F)
            return (codepoint, 4.usize())
        if first >= 0xF1 and first <= 0xF3 and second >= 0x80 and second <= 0xBF and valid_third and valid_fourth:
            codepoint: i64 = ((first.i64() & 0x07) << 18) | ((second.i64() & 0x3F) << 12) | ((third.i64() & 0x3F) << 6) | (fourth.i64() & 0x3F)
            return (codepoint, 4.usize())
        if first == 0xF4 and second >= 0x80 and second <= 0x8F and valid_third and valid_fourth:
            codepoint: i64 = ((first.i64() & 0x07) << 18) | ((second.i64() & 0x3F) << 12) | ((third.i64() & 0x3F) << 6) | (fourth.i64() & 0x3F)
            return (codepoint, 4.usize())

    # Python's filesystem decoding uses surrogateescape for an invalid byte;
    # json.dumps then spells that surrogate as one ASCII \uXXXX escape.
    return (0xDC00 + first.i64(), 1.usize())


def wasm_json_hex_digit(value: i64) -> u8:
    return (48 + value).u8() if value < 10
    return (87 + value).u8()


def wasm_push_json_u16_escape(buffer: mutable darray[u8]&, codepoint: i64) -> void can[Abort.Panic, Memory.Allocate]:
    buffer.push(92)
    buffer.push(117)
    buffer.push(wasm_json_hex_digit((codepoint >> 12) & 15))
    buffer.push(wasm_json_hex_digit((codepoint >> 8) & 15))
    buffer.push(wasm_json_hex_digit((codepoint >> 4) & 15))
    buffer.push(wasm_json_hex_digit(codepoint & 15))




def wasm_push_json_string(buffer: mutable darray[u8]&, text: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
    buffer.push(34)
    index: mutable usize = 0
    while index < text.count |index, buffer, text|:
        scalar: (codepoint: i64, width: usize) = wasm_utf8_scalar_at(text, index)
        codepoint: i64 = scalar.codepoint
        if codepoint == 34 or codepoint == 92:
            buffer.push(92)
            buffer.push(codepoint.u8())
        elif codepoint == 8:
            buffer.push(92)
            buffer.push(98)
        elif codepoint == 9:
            buffer.push(92)
            buffer.push(116)
        elif codepoint == 10:
            buffer.push(92)
            buffer.push(110)
        elif codepoint == 12:
            buffer.push(92)
            buffer.push(102)
        elif codepoint == 13:
            buffer.push(92)
            buffer.push(114)
        elif codepoint < 32 or codepoint > 126 and codepoint <= 65535:
            wasm_push_json_u16_escape(buffer, codepoint)
        elif codepoint > 65535:
            supplementary: i64 = codepoint - 65536
            wasm_push_json_u16_escape(buffer, 55296 + (supplementary >> 10))
            wasm_push_json_u16_escape(buffer, 56320 + (supplementary & 1023))
        else:
            buffer.push(codepoint.u8())
        index <- index + scalar.width
    buffer.push(34)




def wasm_push_json_sview(buffer: mutable darray[u8]&, text: sview) -> void can[Abort.Panic, Memory.Allocate]:
    bytes: mutable darray[u8] = []
    for index in 0..<sview_len(text) |bytes, text|:
        bytes.push(sview_at(text, index))
    wasm_push_json_string(buffer, bytes)




# The `@link_name("...")` decorator's text, or "" — rendered through the -emit ast helper
# (`("name")`) and unwrapped.
def wasm_link_name(decorators: darray[Ast::Annotation]&, tokens: darray[Lexer::Token]&, source: u8&, link_name: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
    for decorator in decorators |link_name, tokens, source|:
        if decorator.name == "link_name":
            rendered: mutable darray[u8] = []
            emit_ast_decorator_args(&rendered, tokens, source, decorator.line, 0)
            for index in 0..<rendered.count |link_name, rendered|:
                byte: u8 = rendered[index]
                link_name.push(byte) if byte != 40 and byte != 41 and byte != 34
            return true
    return false
