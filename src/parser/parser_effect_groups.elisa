# Normalize grouped member sugar once at the parser boundary. The family prefix
# retains qualification and type arguments; members keep source order and any via.
extend Parser:
    private:
        def persist_effect_ref(ref: sview) -> sview:
            can Memory.Allocate, Abort.Panic:
                bytes: mutable darray[u8] = []
                for index in 0..<sview_len(ref) |bytes|:
                    bytes.push(sview_at(ref, index))
                return persist_name_bytes(&bytes, 0) can Global{Read,Write}

        def effect_group_open(ref: sview) -> usize:
            can Abort.Panic:
                depth: mutable int = 0
                for index in 0..<sview_len(ref) |depth|:
                    byte: u8 = sview_at(ref, index)
                    index return if byte == 123 and depth == 0
                    depth <- depth + 1 if byte == 91 or byte == 40
                    depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41)
                return sview_len(ref)

        def normalize_effect_groups(parser: lmut Parser) -> void:
            can Memory.Allocate, Abort.Panic:
                grouped: bool = any ref in parser.captured_effects where effect_group_open(ref) < sview_len(ref)
                return if not grouped
                previous_bytes: mutable darray[u8] = []
                previous_starts: mutable darray[usize] = []
                previous_ends: mutable darray[usize] = []
                for ref in parser.captured_effects |previous_bytes, previous_starts, previous_ends|:
                    previous_starts.push(previous_bytes.count)
                    for index in 0..<sview_len(ref) |previous_bytes|:
                        previous_bytes.push(sview_at(ref, index))
                    previous_ends.push(previous_bytes.count)
                parser.captured_effects <- parser.captured_effects.truncate(0)
                for row in 0..<previous_starts.count |parser| -> parser:
                    owned_bytes: mutable darray[u8] = []
                    for index in previous_starts[row]..<previous_ends[row] |owned_bytes|:
                        owned_bytes.push(previous_bytes[index])
                    ref: sview = persist_name_bytes(&owned_bytes, 0) can Global{Read,Write}
                    opening: usize = effect_group_open(ref)
                    if opening >= sview_len(ref):
                        parser.captured_effects <- parser.captured_effects.push(ref)
                        continue
                    closing: mutable usize = opening + 1
                    depth: mutable int = 0
                    while closing < sview_len(ref) |closing, depth|:
                        byte: u8 = sview_at(ref, closing)
                        break if byte == 125 and depth == 0
                        depth <- depth + 1 if byte == 91 or byte == 40 or byte == 123
                        depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41 or byte == 125)
                        closing <- closing + 1
                    if closing >= sview_len(ref):
                        parser.captured_effects <- parser.captured_effects.push(ref)
                        continue
                    start: mutable usize = opening + 1
                    while start < closing |start, parser| -> parser:
                        end: mutable usize = start
                        member_depth: mutable int = 0
                        while end < closing |end, member_depth|:
                            byte: u8 = sview_at(ref, end)
                            break if byte == 44 and member_depth == 0
                            member_depth <- member_depth + 1 if byte == 91 or byte == 40
                            member_depth <- member_depth - 1 if member_depth > 0 and (byte == 93 or byte == 41)
                            end <- end + 1
                        first: mutable usize = start
                        last: mutable usize = end
                        while first < last and (sview_at(ref, first) == 32 or sview_at(ref, first) == 9) |first|:
                            first <- first + 1
                        while last > first and (sview_at(ref, last - 1) == 32 or sview_at(ref, last - 1) == 9) |last|:
                            last <- last - 1
                        if first < last:
                            bytes: mutable darray[u8] = []
                            for index in 0..<opening |bytes|:
                                bytes.push(sview_at(ref, index))
                            bytes.push(46)
                            for index in first..<last |bytes|:
                                bytes.push(sview_at(ref, index))
                            for index in closing + 1..<sview_len(ref) |bytes|:
                                bytes.push(sview_at(ref, index))
                            expanded: sview = persist_name_bytes(&bytes, 0) can Global{Read,Write}
                            parser.captured_effects <- parser.captured_effects.push(expanded)
                        start <- end + 1
