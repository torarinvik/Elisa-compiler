extend Parser:
    private:
        def effect_reference_type(parser: Parser&, spelling: sview) -> Ast::Expr?:
            for reference in parser.effect_type_references:
                return reference.type_expression if handler_effect_ref_equal(handler_effect_abstract(reference.spelling), handler_effect_abstract(spelling))
            return null

        def effect_family_unambiguous(parser: Parser&, family: sview) -> bool:
            count: mutable usize = 0
            for annotation in parser.enum_annotations |count|:
                count <- count + 1.usize() if annotation.owner == "__effect_decl" and annotation.name == family
            return count == 1.usize()

        def effect_head_is_qualified(head: Ast::Expr) -> bool:
            match head:
                Expr.Scope(namespace, name, position) | Expr.Field(namespace, name, position):
                    return true
                Expr.Index(indexed_head, argument, position):
                    return effect_head_is_qualified(indexed_head)
                Expr.IndexN(indexed_head_n, arguments, position):
                    return effect_head_is_qualified(indexed_head_n)
                _:
                    return false

        def effect_reference_may_resolve(parser: Parser&, reference: sview) -> bool:
            abstract_reference: sview = handler_effect_abstract(reference)
            return true if handler_effect_ref_has_namespace(abstract_reference)
            return parser.effect_family_unambiguous(handler_effect_family(abstract_reference))

        def effect_type_depends_on_generic(parser: Parser&, expression: Ast::Expr, source_line: u32) -> bool:
            match expression:
                Expr.Ident(name, position):
                    for index in 0..<parser.generic_param_lines.count:
                        return true if parser.generic_param_lines[index] < 2147483648 and (source_line == 0 or parser.generic_param_lines[index] == source_line) and parser.generic_param_names[index] == name
                Expr.Index(head, argument, position):
                    return parser.effect_type_depends_on_generic(head, source_line) or parser.effect_type_depends_on_generic(argument, source_line)
                Expr.IndexN(head, arguments, position):
                    return true if parser.effect_type_depends_on_generic(head, source_line)
                    for argument in arguments:
                        return true if parser.effect_type_depends_on_generic(argument, source_line)
                Expr.Unary(operator, target, position):
                    return parser.effect_type_depends_on_generic(target, source_line)
                Expr.Tuple(elements, position):
                    for element in elements:
                        return true if parser.effect_type_depends_on_generic(element, source_line)
                _:
                    pass
            return false

        # Eligibility is not resolution. A generic row can produce a clone when a
        # matching family exists, but each deferred operation must still select a
        # candidate by resolved types when that clone is instantiated.
        def effect_environment_may_cover(parser: Parser&, effect_ref: sview, installation: u32, source_line: u32) -> bool:
            return true if parser.effect_environment_covers(effect_ref, installation)
            return false if not parser.effect_reference_may_resolve(effect_ref)
            if parser.effect_reference_type(effect_ref) is requested:
                return false if not parser.effect_type_depends_on_generic(requested, source_line)
                current: mutable u32 = installation
                while current != 0 |current, parser, requested|:
                    if parser.effect_reference_type(parser.effect_install_effect_at(current)) is candidate:
                        return true if Ast::effect_path_equal(Ast::effect_application_head(requested), Ast::effect_application_head(candidate)) and Ast::effect_application_arguments(requested).count == Ast::effect_application_arguments(candidate).count
                    current <- parser.effect_install_parent(current)
            return false

        def defer_generic_effect_call(parser: lmut Parser, head: Ast::Expr, operation: sview, arguments: darray[Ast::Expr], argument_names: darray[sview], position: Ast::Pos, effect_name: sview, handler_name: sview, captures: darray[Ast::Expr]) -> Ast::Expr?:
            source_line: u32 = parser.effect_clone_source_line
            return null if not parser.effect_type_depends_on_generic(head, source_line)
            return null if not effect_head_is_qualified(head) and not parser.effect_family_unambiguous(handler_effect_head_family(head))
            candidates: mutable darray[Ast::StaticEffectCandidate] = []
            current: mutable u32 = parser.effect_active_install
            capture_offset: mutable usize = 0
            while current != 0 |parser, current, capture_offset, candidates, head, operation|:
                current_handler: sview = parser.effect_install_handler_at(current)
                current_effect: sview = parser.effect_install_effect_at(current)
                current_effect_identity_id: u32 = parser.effect_install_effect_identity_at(current)
                current_handler_identity_id: u32 = parser.effect_install_handler_identity_at(current)
                candidate_captures: mutable darray[Ast::Expr] = []
                for capture_index in 0..<parser.handler_capture_owners.count |capture_offset, candidate_captures, parser, current_handler, current_handler_identity_id|:
                    capture_owner: sview = parser.handler_capture_owners[capture_index]
                    if capture_owner == current_handler and (current_handler_identity_id == 0 or parser.handler_capture_identity_ids[capture_index] == current_handler_identity_id):
                        candidate_captures.push(parser.effect_context_arguments[capture_offset])
                        capture_offset <- capture_offset + 1.usize()
                if parser.effect_reference_type(current_effect) is candidate_type:
                    # Open installation types need their own lexical binder environment;
                    # never accidentally resolve them with the callee's same-spelled T.
                    closed_candidate: bool = not parser.effect_type_depends_on_generic(candidate_type, 0)
                    if closed_candidate and Ast::effect_path_equal(Ast::effect_application_head(head), Ast::effect_application_head(candidate_type)) and parser.handler_declares_operation_identity(current_handler, operation, current_handler_identity_id):
                        hidden_name: sview = parser.handler_operation_name_for_identity(current_handler, operation, current_handler_identity_id)
                        candidate_owner: sview = parser.effect_clone_active_owner if parser.effect_clone_active_owner != "" else parser.current_module
                        candidates.push(Ast::StaticEffectCandidate{effect_type: candidate_type, callee: hidden_name, captures: candidate_captures, effect_identity_id: current_effect_identity_id, handler_identity_id: current_handler_identity_id, callee_owner: candidate_owner})
                current <- parser.effect_install_parent(current)
            return null if candidates.count == 0.usize()
            rewritten_arguments: mutable darray[Ast::Expr] = []
            for argument in arguments |parser, rewritten_arguments|:
                rebind rewritten_argument: Ast::Expr, parser = parser.rewrite_handler_expression(argument, effect_name, handler_name, captures)
                rewritten_arguments.push(rewritten_argument)
            return Expr.StaticEffectCall(head, operation, candidates, rewritten_arguments, argument_names, position)
