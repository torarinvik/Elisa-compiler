# Stage1 parser — roots reached through a DRIVEN RESOURCE or a CALL (docs/123). An arm can mutate
# the driven resource through a mutable reference, and a call argument can carry a root that the
# plain walk never sees; both are collected here. Continues parser_stmt_machine.elisa.

extend Parser:
    public:

        def machine_collect_driven_statement_roots(statements: darray[Ast::Stmt], over_roots: darray[sview], mutated_roots: mutable darray[sview]&) -> void:
            for statement in statements |over_roots, mutated_roots|:
                match statement:
                    Ast::Stmt.VarDecl(name, type_expression, value, line):
                        machine_collect_driven_roots(value, over_roots, mutated_roots)
                    Ast::Stmt.Assign(target, operator, value, line):
                        machine_collect_driven_roots(target, over_roots, mutated_roots)
                        machine_collect_driven_roots(value, over_roots, mutated_roots)
                    Ast::Stmt.Expr(expression, line):
                        machine_collect_driven_roots(expression, over_roots, mutated_roots)
                    Ast::Stmt.Return(value, line):
                        if value is returned:
                            machine_collect_driven_roots(returned, over_roots, mutated_roots)
                    Ast::Stmt.If(condition, then_body, else_body, line):
                        machine_collect_driven_roots(condition, over_roots, mutated_roots)
                        machine_collect_driven_statement_roots(then_body, over_roots, mutated_roots)
                        machine_collect_driven_statement_roots(else_body, over_roots, mutated_roots)
                    Ast::Stmt.While(condition, body, line):
                        machine_collect_driven_roots(condition, over_roots, mutated_roots)
                        machine_collect_driven_statement_roots(body, over_roots, mutated_roots)
                    Ast::Stmt.For(bind, variables, iterable, body, line):
                        machine_collect_driven_roots(iterable, over_roots, mutated_roots)
                        machine_collect_driven_statement_roots(body, over_roots, mutated_roots)
                    Ast::Stmt.Block(kind, clause, binding, body, line):
                        machine_collect_driven_statement_roots(body, over_roots, mutated_roots)
                    Ast::Stmt.Match(scrutinee, arms, line):
                        machine_collect_driven_roots(scrutinee, over_roots, mutated_roots)
                        for arm in arms |over_roots, mutated_roots|:
                            machine_collect_driven_roots(arm.guard, over_roots, mutated_roots)
                            machine_collect_driven_statement_roots(arm.body, over_roots, mutated_roots)
                    Ast::Stmt.Contract(_, expression, _):
                        machine_collect_driven_roots(expression, over_roots, mutated_roots)
                    _:
                        pass



        # Calls can mutate a driven resource through a mutable reference even when the arm
        # contains no assignment node. Mirror stage0's conservative rule by collecting every
        # root in each call expression and retaining only roots already licensed by the machine
        # header. Statement-bearing expressions delegate to the matching statement walker so
        # calls in block, lambda, recovery, and handler bodies cannot evade capture analysis.
        def machine_collect_driven_roots(expression: Ast::Expr, over_roots: darray[sview], mutated_roots: mutable darray[sview]&) -> void:
            match expression:
                Ast::Expr.Ident(name, _):
                    machine_add_root(mutated_roots, name) if any driven_name in over_roots where driven_name == name
                Ast::Expr.Field(object, _, _):
                    machine_collect_driven_roots(object, over_roots, mutated_roots)
                Ast::Expr.Scope(base, _, _):
                    machine_collect_driven_roots(base, over_roots, mutated_roots)
                Ast::Expr.Call(callee, arguments, _, _):
                    machine_collect_driven_roots(callee, over_roots, mutated_roots) if machine_expr_ident_name(callee) == ""
                    for argument in arguments |over_roots, mutated_roots|:
                        machine_collect_driven_roots(argument, over_roots, mutated_roots)
                Ast::Expr.Index(object, index, _):
                    machine_collect_driven_roots(object, over_roots, mutated_roots)
                    machine_collect_driven_roots(index, over_roots, mutated_roots)
                Ast::Expr.Slice(object, low, high, _):
                    machine_collect_driven_roots(object, over_roots, mutated_roots)
                    machine_collect_driven_roots(low, over_roots, mutated_roots)
                    machine_collect_driven_roots(high, over_roots, mutated_roots)
                Ast::Expr.IndexN(object, arguments, _):
                    machine_collect_driven_roots(object, over_roots, mutated_roots)
                    for argument in arguments |over_roots, mutated_roots|:
                        machine_collect_driven_roots(argument, over_roots, mutated_roots)
                Ast::Expr.Binary(left, _, right, _):
                    machine_collect_driven_roots(left, over_roots, mutated_roots)
                    machine_collect_driven_roots(right, over_roots, mutated_roots)
                Ast::Expr.Unary(_, operand, _):
                    machine_collect_driven_roots(operand, over_roots, mutated_roots)
                Ast::Expr.Move(operand, _):
                    machine_collect_driven_roots(operand, over_roots, mutated_roots)
                Ast::Expr.RegionNew(operand, _, _):
                    machine_collect_driven_roots(operand, over_roots, mutated_roots)
                Ast::Expr.Paren(inner, _):
                    machine_collect_driven_roots(inner, over_roots, mutated_roots)
                Ast::Expr.Refinement(base, predicate, _):
                    machine_collect_driven_roots(base, over_roots, mutated_roots)
                    machine_collect_driven_roots(predicate, over_roots, mutated_roots)
                Ast::Expr.GetElse(guarded, recovery, _):
                    machine_collect_driven_roots(guarded, over_roots, mutated_roots)
                    machine_collect_driven_statement_roots(recovery, over_roots, mutated_roots)
                Ast::Expr.Array(elements, _):
                    for element in elements |over_roots, mutated_roots|:
                        machine_collect_driven_roots(element, over_roots, mutated_roots)
                Ast::Expr.Tuple(elements, _):
                    for element in elements |over_roots, mutated_roots|:
                        machine_collect_driven_roots(element, over_roots, mutated_roots)
                Ast::Expr.SetLit(elements, _):
                    for element in elements |over_roots, mutated_roots|:
                        machine_collect_driven_roots(element, over_roots, mutated_roots)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |over_roots, mutated_roots|:
                        machine_collect_driven_roots(entry.key, over_roots, mutated_roots)
                        machine_collect_driven_roots(entry.value, over_roots, mutated_roots)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |over_roots, mutated_roots|:
                        machine_collect_driven_roots(field.value, over_roots, mutated_roots)
                Ast::Expr.RecordUpdate(base, fields, _):
                    machine_collect_driven_roots(base, over_roots, mutated_roots)
                    for field in fields |over_roots, mutated_roots|:
                        machine_collect_driven_roots(field.value, over_roots, mutated_roots)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    machine_collect_driven_roots(condition, over_roots, mutated_roots)
                    machine_collect_driven_roots(then_expression, over_roots, mutated_roots)
                    machine_collect_driven_roots(else_expression, over_roots, mutated_roots)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    machine_collect_driven_roots(iterable, over_roots, mutated_roots)
                    machine_collect_driven_roots(condition, over_roots, mutated_roots)
                    machine_collect_driven_roots(body, over_roots, mutated_roots)
                Ast::Expr.Lambda(_, body, _):
                    machine_collect_driven_statement_roots(body, over_roots, mutated_roots)
                Ast::Expr.Block(statements, value, _, _):
                    machine_collect_driven_statement_roots(statements, over_roots, mutated_roots)
                    machine_collect_driven_roots(value, over_roots, mutated_roots)
                Ast::Expr.Match(scrutinee, arms, _):
                    machine_collect_driven_roots(scrutinee, over_roots, mutated_roots)
                    for arm in arms |over_roots, mutated_roots|:
                        machine_collect_driven_roots(arm.guard, over_roots, mutated_roots)
                        machine_collect_driven_statement_roots(arm.body, over_roots, mutated_roots)
                Ast::Expr.Catch(scrutinee, arms, _):
                    machine_collect_driven_roots(scrutinee, over_roots, mutated_roots)
                    for arm in arms |over_roots, mutated_roots|:
                        machine_collect_driven_roots(arm.guard, over_roots, mutated_roots)
                        machine_collect_driven_statement_roots(arm.body, over_roots, mutated_roots)
                _:
                    pass



        def machine_collect_call_statement_roots(statements: darray[Ast::Stmt], over_roots: darray[sview], mutated_roots: mutable darray[sview]&) -> void:
            for statement in statements |over_roots, mutated_roots|:
                match statement:
                    Ast::Stmt.VarDecl(name, type_expression, value, line):
                        machine_collect_call_roots(value, over_roots, mutated_roots)
                    Ast::Stmt.Assign(target, operator, value, line):
                        machine_collect_call_roots(target, over_roots, mutated_roots)
                        machine_collect_call_roots(value, over_roots, mutated_roots)
                    Ast::Stmt.Expr(expression, line):
                        machine_collect_call_roots(expression, over_roots, mutated_roots)
                    Ast::Stmt.Return(value, line):
                        if value is returned:
                            machine_collect_call_roots(returned, over_roots, mutated_roots)
                    Ast::Stmt.If(condition, then_body, else_body, line):
                        machine_collect_call_roots(condition, over_roots, mutated_roots)
                        machine_collect_call_statement_roots(then_body, over_roots, mutated_roots)
                        machine_collect_call_statement_roots(else_body, over_roots, mutated_roots)
                    Ast::Stmt.While(condition, body, line):
                        machine_collect_call_roots(condition, over_roots, mutated_roots)
                        machine_collect_call_statement_roots(body, over_roots, mutated_roots)
                    Ast::Stmt.For(bind, variables, iterable, body, line):
                        machine_collect_call_roots(iterable, over_roots, mutated_roots)
                        machine_collect_call_statement_roots(body, over_roots, mutated_roots)
                    Ast::Stmt.Block(kind, clause, binding, body, line):
                        machine_collect_call_statement_roots(body, over_roots, mutated_roots)
                    Ast::Stmt.Match(scrutinee, arms, line):
                        machine_collect_call_roots(scrutinee, over_roots, mutated_roots)
                        for arm in arms |over_roots, mutated_roots|:
                            machine_collect_call_roots(arm.guard, over_roots, mutated_roots)
                            machine_collect_call_statement_roots(arm.body, over_roots, mutated_roots)
                    Ast::Stmt.Contract(_, expression, _):
                        machine_collect_call_roots(expression, over_roots, mutated_roots)
                    _:
                        pass



        def machine_collect_call_roots(expression: Ast::Expr, over_roots: darray[sview], mutated_roots: mutable darray[sview]&) -> void:
            match expression:
                Ast::Expr.Call(_, _, _, _):
                    machine_collect_driven_roots(expression, over_roots, mutated_roots)
                Ast::Expr.Field(object, _, _):
                    machine_collect_call_roots(object, over_roots, mutated_roots)
                Ast::Expr.Scope(base, _, _):
                    machine_collect_call_roots(base, over_roots, mutated_roots)
                Ast::Expr.Index(object, index, _):
                    machine_collect_call_roots(object, over_roots, mutated_roots)
                    machine_collect_call_roots(index, over_roots, mutated_roots)
                Ast::Expr.Slice(object, low, high, _):
                    machine_collect_call_roots(object, over_roots, mutated_roots)
                    machine_collect_call_roots(low, over_roots, mutated_roots)
                    machine_collect_call_roots(high, over_roots, mutated_roots)
                Ast::Expr.IndexN(object, arguments, _):
                    machine_collect_call_roots(object, over_roots, mutated_roots)
                    for argument in arguments |over_roots, mutated_roots|:
                        machine_collect_call_roots(argument, over_roots, mutated_roots)
                Ast::Expr.Binary(left, _, right, _):
                    machine_collect_call_roots(left, over_roots, mutated_roots)
                    machine_collect_call_roots(right, over_roots, mutated_roots)
                Ast::Expr.Unary(_, operand, _):
                    machine_collect_call_roots(operand, over_roots, mutated_roots)
                Ast::Expr.Move(operand, _):
                    machine_collect_call_roots(operand, over_roots, mutated_roots)
                Ast::Expr.RegionNew(operand, _, _):
                    machine_collect_call_roots(operand, over_roots, mutated_roots)
                Ast::Expr.Paren(inner, _):
                    machine_collect_call_roots(inner, over_roots, mutated_roots)
                Ast::Expr.Refinement(base, predicate, _):
                    machine_collect_call_roots(base, over_roots, mutated_roots)
                    machine_collect_call_roots(predicate, over_roots, mutated_roots)
                Ast::Expr.GetElse(guarded, recovery, _):
                    machine_collect_call_roots(guarded, over_roots, mutated_roots)
                    machine_collect_call_statement_roots(recovery, over_roots, mutated_roots)
                Ast::Expr.Array(elements, _):
                    for element in elements |over_roots, mutated_roots|:
                        machine_collect_call_roots(element, over_roots, mutated_roots)
                Ast::Expr.Tuple(elements, _):
                    for element in elements |over_roots, mutated_roots|:
                        machine_collect_call_roots(element, over_roots, mutated_roots)
                Ast::Expr.SetLit(elements, _):
                    for element in elements |over_roots, mutated_roots|:
                        machine_collect_call_roots(element, over_roots, mutated_roots)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |over_roots, mutated_roots|:
                        machine_collect_call_roots(entry.key, over_roots, mutated_roots)
                        machine_collect_call_roots(entry.value, over_roots, mutated_roots)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |over_roots, mutated_roots|:
                        machine_collect_call_roots(field.value, over_roots, mutated_roots)
                Ast::Expr.RecordUpdate(base, fields, _):
                    machine_collect_call_roots(base, over_roots, mutated_roots)
                    for field in fields |over_roots, mutated_roots|:
                        machine_collect_call_roots(field.value, over_roots, mutated_roots)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    machine_collect_call_roots(condition, over_roots, mutated_roots)
                    machine_collect_call_roots(then_expression, over_roots, mutated_roots)
                    machine_collect_call_roots(else_expression, over_roots, mutated_roots)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    machine_collect_call_roots(iterable, over_roots, mutated_roots)
                    machine_collect_call_roots(condition, over_roots, mutated_roots)
                    machine_collect_call_roots(body, over_roots, mutated_roots)
                Ast::Expr.Lambda(_, body, _):
                    machine_collect_call_statement_roots(body, over_roots, mutated_roots)
                Ast::Expr.Block(statements, value, _, _):
                    machine_collect_call_statement_roots(statements, over_roots, mutated_roots)
                    machine_collect_call_roots(value, over_roots, mutated_roots)
                Ast::Expr.Match(scrutinee, arms, _):
                    machine_collect_call_roots(scrutinee, over_roots, mutated_roots)
                    for arm in arms |over_roots, mutated_roots|:
                        machine_collect_call_roots(arm.guard, over_roots, mutated_roots)
                        machine_collect_call_statement_roots(arm.body, over_roots, mutated_roots)
                Ast::Expr.Catch(scrutinee, arms, _):
                    machine_collect_call_roots(scrutinee, over_roots, mutated_roots)
                    for arm in arms |over_roots, mutated_roots|:
                        machine_collect_call_roots(arm.guard, over_roots, mutated_roots)
                        machine_collect_call_statement_roots(arm.body, over_roots, mutated_roots)
                _:
                    pass
