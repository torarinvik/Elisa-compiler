# Stage1 parser — the EXPRESSION PROBES a machine header asks about: is this arm value a literal,
# which identifier does it name, does it mention a given binder, is it a parse error. These match
# stage0's payload-pattern classification. Continues parser_stmt_machine.elisa.

extend Parser:
    public:

        def machine_expr_is_literal(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.IntLit(_, _):
                    return true
                Ast::Expr.FloatLit(_, _):
                    return true
                Ast::Expr.CharLit(_, _):
                    return true
                Ast::Expr.StringLit(_, _):
                    return true
                Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.Unary(operator, operand, _):
                    return machine_expr_is_literal(operand)
                Ast::Expr.Paren(inner, _):
                    return machine_expr_is_literal(inner)
                _:
                    return false



        def machine_expr_ident_name(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                _:
                    return ""



        # Match stage0's payload-pattern classification: an expression that mentions
        # the state field is already a predicate over that field; every other expression
        # is an equality value, even when it is a computed literal such as `1 + 0`.
        def machine_expr_mentions_ident(expression: Ast::Expr, name: sview, fold_names: bool = false) -> bool:
            match expression:
                Ast::Expr.Ident(ident_name, _):
                    return ident_name == name or (fold_names and fold_pinned_reserved_name(ident_name))
                Ast::Expr.Field(object, _, _):
                    return machine_expr_mentions_ident(object, name, fold_names)
                Ast::Expr.Scope(base, _, _):
                    return machine_expr_mentions_ident(base, name, fold_names)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if machine_expr_mentions_ident(callee, name, fold_names)
                    return any argument in arguments where machine_expr_mentions_ident(argument, name, fold_names)
                Ast::Expr.StaticEffectCall(effect_type, _, candidates, arguments, _, _):
                    return true if machine_expr_mentions_ident(effect_type, name, fold_names)
                    return true if any argument in arguments where machine_expr_mentions_ident(argument, name, fold_names)
                    for candidate in candidates:
                        return true if machine_expr_mentions_ident(candidate.effect_type, name, fold_names)
                        return true if any capture in candidate.captures where machine_expr_mentions_ident(capture, name, fold_names)
                    return false
                Ast::Expr.Index(object, index, _):
                    return machine_expr_mentions_ident(object, name, fold_names) or machine_expr_mentions_ident(index, name, fold_names)
                Ast::Expr.Slice(object, low, high, _):
                    return machine_expr_mentions_ident(object, name, fold_names) or machine_expr_mentions_ident(low, name, fold_names) or machine_expr_mentions_ident(high, name, fold_names)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if machine_expr_mentions_ident(object, name, fold_names)
                    return any argument in arguments where machine_expr_mentions_ident(argument, name, fold_names)
                Ast::Expr.Binary(left, _, right, _):
                    return machine_expr_mentions_ident(left, name, fold_names) or machine_expr_mentions_ident(right, name, fold_names)
                Ast::Expr.Unary(_, operand, _):
                    return machine_expr_mentions_ident(operand, name, fold_names)
                Ast::Expr.Move(operand, _):
                    return machine_expr_mentions_ident(operand, name, fold_names)
                Ast::Expr.RegionNew(operand, _, _):
                    return machine_expr_mentions_ident(operand, name, fold_names)
                Ast::Expr.Paren(inner, _):
                    return machine_expr_mentions_ident(inner, name, fold_names)
                Ast::Expr.Refinement(base, predicate, _):
                    return machine_expr_mentions_ident(base, name, fold_names) or machine_expr_mentions_ident(predicate, name, fold_names)
                Ast::Expr.GetElse(guarded, recovery, _):
                    return true if machine_expr_mentions_ident(guarded, name, fold_names)
                    return machine_statement_mentions_ident(recovery, name, fold_names)
                Ast::Expr.Array(elements, _):
                    return any element in elements where machine_expr_mentions_ident(element, name, fold_names)
                Ast::Expr.Tuple(elements, _):
                    return any element in elements where machine_expr_mentions_ident(element, name, fold_names)
                Ast::Expr.SetLit(elements, _):
                    return any element in elements where machine_expr_mentions_ident(element, name, fold_names)
                Ast::Expr.DictLit(entries, _):
                    return any entry in entries where machine_expr_mentions_ident(entry.key, name, fold_names) or machine_expr_mentions_ident(entry.value, name, fold_names)
                Ast::Expr.Construct(_, fields, _):
                    return any field in fields where machine_expr_mentions_ident(field.value, name, fold_names)
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if machine_expr_mentions_ident(base, name, fold_names)
                    return any field in fields where machine_expr_mentions_ident(field.value, name, fold_names)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return machine_expr_mentions_ident(condition, name, fold_names) or machine_expr_mentions_ident(then_expression, name, fold_names) or machine_expr_mentions_ident(else_expression, name, fold_names)
                Ast::Expr.Comprehension(iterable: iterable, condition: condition, body: body, _):
                    return machine_expr_mentions_ident(iterable, name, fold_names) or machine_expr_mentions_ident(condition, name, fold_names) or machine_expr_mentions_ident(body, name, fold_names)
                Ast::Expr.Lambda(_, body, _):
                    return machine_statement_mentions_ident(body, name, fold_names)
                Ast::Expr.Block(statements, value, captures, _):
                    return true if any capture in captures where capture == name or (fold_names and fold_pinned_reserved_name(capture))
                    return true if machine_statement_mentions_ident(statements, name, fold_names)
                    return machine_expr_mentions_ident(value, name, fold_names)
                Ast::Expr.Match(scrutinee, arms, _):
                    return true if machine_expr_mentions_ident(scrutinee, name, fold_names)
                    for arm in arms:
                        return true if:
                            machine_expr_mentions_ident(arm.guard, name, fold_names)
                            machine_statement_mentions_ident(arm.body, name, fold_names)
                    return false
                Ast::Expr.Catch(scrutinee, arms, _):
                    return true if machine_expr_mentions_ident(scrutinee, name, fold_names)
                    for arm in arms:
                        return true if:
                            machine_expr_mentions_ident(arm.guard, name, fold_names)
                            machine_statement_mentions_ident(arm.body, name, fold_names)
                    return false
                _:
                    return false



        def machine_statement_mentions_ident(statements: darray[Ast::Stmt], name: sview, fold_names: bool = false) -> bool:
            for statement in statements:
                match statement:
                    Ast::Stmt.VarDecl(value: value, _):
                        return true if machine_expr_mentions_ident(value, name, fold_names)
                    Ast::Stmt.Assign(target, _, value, _):
                        return true if machine_expr_mentions_ident(target, name, fold_names) or machine_expr_mentions_ident(value, name, fold_names)
                    Ast::Stmt.Expr(expression, _):
                        return true if machine_expr_mentions_ident(expression, name, fold_names)
                    Ast::Stmt.Return(value, _):
                        if value is returned:
                            return true if machine_expr_mentions_ident(returned, name, fold_names)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return true if machine_expr_mentions_ident(condition, name, fold_names) or machine_statement_mentions_ident(then_body, name, fold_names) or machine_statement_mentions_ident(else_body, name, fold_names)
                    Ast::Stmt.While(condition, body, _):
                        return true if machine_expr_mentions_ident(condition, name, fold_names) or machine_statement_mentions_ident(body, name, fold_names)
                    Ast::Stmt.For(iterable: iterable, body: body, _):
                        return true if machine_expr_mentions_ident(iterable, name, fold_names) or machine_statement_mentions_ident(body, name, fold_names)
                    Ast::Stmt.Block(body: body, _):
                        return true if machine_statement_mentions_ident(body, name, fold_names)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return true if machine_expr_mentions_ident(scrutinee, name, fold_names)
                        for arm in arms:
                            return true if machine_expr_mentions_ident(arm.guard, name, fold_names) or machine_statement_mentions_ident(arm.body, name, fold_names)
                    Ast::Stmt.Contract(_, expression, _):
                        return true if machine_expr_mentions_ident(expression, name, fold_names)
                    _:
                        pass
            return false



        def machine_expr_is_invalid(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Invalid:
                    return true
                Ast::Expr.Absent:
                    return true
                _:
                    return false
