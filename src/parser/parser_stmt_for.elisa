# Stage1 parser — `for` statement parsing (`extend Parser: private:`). Covers the
# `for`/`parallel for` header (region clause, destructuring constructor and brace
# patterns) and its small lookahead helpers. Continues parser_stmt.elisa; split out
# to keep each part file under 600 lines.

extend Parser:
    private:
        # Whether the current `region ...` line has a top-level trailing `:` and
        # therefore opens the older scoped-block form. Capacity parentheses may
        # contain nested tokens; only a depth-zero colon selects the block grammar.
        def region_header_has_block_colon(parser: Parser&) -> bool:
            scan: mutable usize = 1
            depth: mutable int = 0
            while parser.peek_at(scan) != TokenKind.Newline and parser.peek_at(scan) != TokenKind.Eof |scan, depth|:
                kind: TokenKind = parser.peek_at(scan)
                true return if depth == 0 and kind == TokenKind.Colon
                depth <- depth + 1 if kind == TokenKind.LParen or kind == TokenKind.LBracket
                depth <- depth - 1 if kind == TokenKind.RParen or kind == TokenKind.RBracket
                scan <- scan + 1
            return false


        # `for VAR [, VAR]* in ITER: <block>` (contextual `for`; the lexer emits it as an
        # identifier). Every loop variable is recorded so destructuring loops bind them all.
        def for_statement(parser: lmut Parser, parallel: bool) -> Ast::Stmt?:
            rebind for_token: Token, parser = parser.advance()              # consume the `for` identifier

            # Iteration binding intent, before the first variable (mirrors stage0
            # parseIterBindMode): `mutable` = mutate elements in place, nothing = read
            # (the compiler binds by reference under the hood when beneficial or
            # required — affine elements auto-borrow). The mechanism spellings
            # `ref` / `mutable ref` were removed; stage0 rejects them with a directed
            # error, so here a stray `ref` simply fails the variable-name expect.
            rebind accepted_mutable: bool, parser = parser.accept(TokenKind.Mutable)
            bind: mutable sview = "parallel" if parallel else ("mutable" if accepted_mutable else "")

            variables_buffer: mutable darray[sview] = []
            match parser.peek():
                TokenKind.LBrace:
                    parser <- parser.consume_for_brace_pattern(variables_buffer)
                TokenKind.Ident if parser.peek_at(1) == TokenKind.LParen:
                    parser <- parser.consume_for_constructor_pattern(variables_buffer)
                _:
                    rebind variable_token: Token, parser = parser.expect(TokenKind.Ident)
                    variables_buffer.push(Lexer::text_or_empty(variable_token, parser.source))

            while parser.accept(TokenKind.Comma) |parser|:
                rebind next_variable_token: Token, parser = parser.expect(TokenKind.Ident)
                variables_buffer.push(Lexer::text_or_empty(next_variable_token, parser.source))

            # Parallel iteration may bind the source index as `item at i`.
            # Keep the index in the For binder list so it shares the loop scope.
            at_token: Token = parser.cursor()
            if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(at_token, parser.source) == "at":
                parser, _ <- parser.advance()
                rebind index_variable_token: Token, parser = parser.expect(TokenKind.Ident)
                variables_buffer.push(Lexer::text_or_empty(index_variable_token, parser.source))

            parser, _ <- parser.expect(TokenKind.In)
            # docs/119 §3: binary parsing stops at a header's opening `|` (loop_header_at),
            # so the ordinary iterable parse already yields the pre-header expression; a
            # genuine bitwise `|` in the iterable is consumed normally.
            # Parse through binary/range precedence but leave a top-level `if`
            # for the loop filter (`for x in xs if pred:`), rather than consuming
            # it as a value ternary that would demand `else`.
            rebind iterable_left: Ast::Expr, parser = get parser.unary_expression()
            rebind parsed_iterable_expression: Ast::Expr, parser = parser.binary_expression_at_level(iterable_left, 1)
            iterable_expression: mutable Ast::Expr = parsed_iterable_expression
            # Optional `where COND` filter (contextual keyword): `for x in xs where P:`.
            # The condition is preserved by wrapping the iterable in a Refinement (the same
            # shape as the `if pred` filter below) so a refinement `is`-pattern in it
            # (`where item is Expr.Int(value):`) keeps its payload bindings in scope for the
            # loop body.
            where_token: Token = parser.cursor()
            if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(where_token, parser.source) == "where":
                parser, _ <- parser.advance()                       # `where`
                rebind where_condition: Ast::Expr, parser = get parser.expression()
                iterable_expression <- (Ast::Expr.Refinement(iterable_expression, where_condition, where_token.line))
                # Pattern filter guard: `where Pattern: predicate:`. The first colon
                # separates pattern from guard; the second opens the loop body.
                #
                # The guard is RETAINED as a second Refinement layer, not parsed and dropped.
                # Dropping it was a SILENT WRONG ANSWER, not a decline:
                # `for item in items where item is Expr.Int(value): value > 2:` summed every
                # Int, answering 4 where stage0 answers 3.
                #
                # Layering works because the loop emitter's desugar re-enters itself on the
                # Refinement's base: the outer (guard) layer becomes the inner `if`, so the
                # body reads `if item is Expr.Int(value): if value > 2: …` and the guard sees
                # the pattern's bindings.
                if parser.peek() == TokenKind.Colon and parser.colon_before_line_end(1):
                    parser, _ <- parser.advance()
                    rebind guard_condition_opt: Ast::Expr?, parser = parser.expression()
                    if guard_condition_opt is guard_condition:
                        iterable_expression <- (Ast::Expr.Refinement(iterable_expression, guard_condition, where_token.line))
            if parser.peek() == TokenKind.If:
                rebind filter_token: Token, parser = parser.advance()
                rebind filter_expression: Ast::Expr, parser = get parser.expression()
                iterable_expression <- (Ast::Expr.Refinement(iterable_expression, filter_expression, filter_token.line))
            # Range execution marker `by par` is part of the header, not the iterable.
            by_token: Token = parser.cursor()
            if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(by_token, parser.source) == "by":
                parser, _ <- parser.advance()
                rebind by_mode_token: Token, parser = parser.expect(TokenKind.Ident)
                # Preserve the data-parallel execution marker in the same binder slot used by
                # `parallel for`. The backend can then lower both spellings through the runtime
                # structured-parallel path instead of silently treating `by par` as sequential.
                bind <- "parallel" if Lexer::text_or_empty(by_mode_token, parser.source) == "par"
            # docs/119 §3: optional loop-expression header `|acc = init, …| [-> yield]`.
            header_declarations: mutable darray[Ast::Stmt] = []
            header_captures: mutable darray[sview] = []
            header_yield: mutable Ast::Expr = (Ast::Expr.Invalid)
            header_has_yield: mutable bool = false
            header_present: bool = parser.loop_header_at()
            header_yield, parser <- parser.parse_loop_header(header_declarations, header_captures, header_has_yield) if header_present
            # Chained `for a in A for b in B: body` == nested loops: the inner `for`
            # becomes the single body statement of the outer loop.
            chain_token: Token = parser.cursor()
            if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(chain_token, parser.source) == "for":
                nested: mutable darray[Ast::Stmt] = []
                rebind __m_302: Ast::Stmt?, parser = parser.for_statement(false)
                if __m_302 is inner_for:
                    nested.push(inner_for)
                nested_loop: Ast::Stmt = (Ast::Stmt.For(bind, variables_buffer, iterable_expression, nested, for_token.line))
                if header_present:
                    rebind __ret_287: Ast::Stmt, parser = parser.wrap_loop_header(header_declarations, header_yield, nested_loop, for_token.line, header_captures)
                    return __ret_287
                return nested_loop
            rebind body: darray[Ast::Stmt], parser = parser.parse_block()
            loop_statement: Ast::Stmt = (Ast::Stmt.For(bind, variables_buffer, iterable_expression, body, for_token.line))
            if header_present:
                rebind __ret_292: Ast::Stmt, parser = parser.wrap_loop_header(header_declarations, header_yield, loop_statement, for_token.line, header_captures)
                return __ret_292
            return loop_statement

        def consume_for_constructor_pattern(parser: lmut Parser, variables: mutable darray[sview]&) -> void:
            parser, _ <- parser.advance()                       # constructor/type name
            parser, _ <- parser.advance()                       # `(`
            while parser.peek() != TokenKind.RParen and parser.peek() != TokenKind.Eof |parser, variables|:
                match parser.peek():
                    TokenKind.Ident:
                        rebind field_token: Token, parser = parser.advance()
                        variables.push(Lexer::text_or_empty(field_token, parser.source))
                    _:
                        parser, _ <- parser.advance()
            parser, _ <- parser.expect(TokenKind.RParen)

        # Whether a second top-level colon occurs later on the current logical line.
        # Used to distinguish `where Pattern: guard:` from `where condition:`.
        def colon_before_line_end(parser: Parser&, start: usize) -> bool:
            scan: mutable usize = start
            depth: mutable int = 0
            while parser.peek_at(scan) != TokenKind.Newline and parser.peek_at(scan) != TokenKind.Eof |scan, depth|:
                kind: TokenKind = parser.peek_at(scan)
                depth <- depth + 1 if kind == TokenKind.LParen or kind == TokenKind.LBracket or kind == TokenKind.LBrace
                depth <- depth - 1 if kind == TokenKind.RParen or kind == TokenKind.RBracket or kind == TokenKind.RBrace
                true return if depth == 0 and kind == TokenKind.Colon
                scan <- scan + 1
            return false

        def consume_for_brace_pattern(parser: lmut Parser, variables: mutable darray[sview]&) -> void:
            parser, _ <- parser.expect(TokenKind.LBrace)
            while parser.peek() != TokenKind.RBrace and parser.peek() != TokenKind.Eof |parser, variables|:
                if parser.peek() == TokenKind.Ident:
                    rebind name_token: Token, parser = parser.advance()
                    # The FIELD name is recorded for every member, in pattern order, keyed by
                    # the header line. Only the binder reaches `Stmt.For`, so under a rename
                    # (`right: item_right`) the backend's field lookup had nothing to look up
                    # and the loop declined; shorthand worked only because binder == field.
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: Lexer::text_or_empty(name_token, parser.source), name: "__for_brace_field", line: name_token.line})
                    # `field: binder` binds only the RHS; shorthand `field` binds itself.
                    if parser.peek() == TokenKind.Colon:
                        parser, _ <- parser.advance()
                        rebind binder_token: Token, parser = parser.expect(TokenKind.Ident)
                        variables.push(Lexer::text_or_empty(binder_token, parser.source))
                    else:
                        variables.push(Lexer::text_or_empty(name_token, parser.source))
                else:
                    parser, _ <- parser.advance()
            parser, _ <- parser.expect(TokenKind.RBrace)
