extend Parser:
    private:
        # Normalize an effect operation after a block has been parsed. The postfix parser also
        # performs this rewrite while the handler context is active, but keeping this pass at the
        # block boundary makes the invariant explicit and covers parser helpers that temporarily
        # re-enter expression parsing with a copied context. It is still only AST normalization:
        # handler captures become ordinary leading arguments and no runtime handler is built.
        def rewrite_handler_expression(parser: lmut Parser, expression: Ast::Expr, effect_name: sview @source, handler_name: sview, captures: darray[Ast::Expr] @source) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        if parser.effect_clone_source_active:
                            match callee:
                                Expr.Field(deferred_head, deferred_operation, deferred_position):
                                    rebind deferred: Ast::Expr?, parser = parser.defer_generic_effect_call(deferred_head, deferred_operation, arguments, argument_names, call_pos, effect_name, handler_name, captures) can Global{Read,Write}
                                    return deferred_call if deferred is deferred_call
                                Expr.Scope(deferred_scope_head, deferred_scope_operation, deferred_scope_position):
                                    rebind deferred_scope: Ast::Expr?, parser = parser.defer_generic_effect_call(deferred_scope_head, deferred_scope_operation, arguments, argument_names, call_pos, effect_name, handler_name, captures) can Global{Read,Write}
                                    return deferred_scope_call if deferred_scope is deferred_scope_call
                                _:
                                    pass
                        # An effectful helper is a compile-time template. Once the file-wide
                        # specialization pass has registered a clone for this active handler,
                        # rewrite the ordinary helper call to that clone and prepend the
                        # handler captures. Before that pass the lookup is empty, so normal
                        # parsing remains unchanged.
                        effect_template_name: sview = effect_template_callee_name(callee)
                        if effect_template_name != "":
                            lexical_owner: sview = parser.effect_clone_active_owner if (any visible_name in parser.effect_clone_visible_names where visible_name == effect_template_name) else ""
                            source_owner: sview = effect_template_callee_owner(callee, lexical_owner)
                            specialized_name: sview = parser.effect_clone_for_call(effect_template_name, arguments.count, effect_name, handler_name, source_owner)
                            if specialized_name != "":
                                specialized_arguments: mutable darray[Ast::Expr] @source = []
                                specialized_names: mutable darray[sview @source] @source = []
                                for capture in parser.effect_context_arguments |specialized_arguments, specialized_names|:
                                    specialized_arguments.push(capture)
                                    specialized_names.push("")
                                specialized_index: mutable usize = 0
                                while specialized_index < arguments.count |parser, specialized_index, specialized_arguments, specialized_names, argument_names, effect_name, handler_name, captures|:
                                    rebind specialized_argument: Ast::Expr, parser = parser.rewrite_handler_expression(arguments[specialized_index], effect_name, handler_name, captures) can Global{Read,Write}
                                    specialized_arguments.push(specialized_argument)
                                    specialized_names.push(argument_names[specialized_index] if specialized_index < argument_names.count else "")
                                    specialized_index <- specialized_index + 1.usize()
                                return (Ast::Expr.Call(effect_specialized_callee(callee, specialized_name), specialized_arguments, specialized_names, call_pos))
                        # Clones from a module are emitted at file scope, but their source body
                        # still resolves bare sibling calls in that module. Qualify only names
                        # known to be functions in the active source module; locals and values
                        # continue through the ordinary rewrite unchanged.
                        if callee is Expr.Ident(module_sibling_name, module_sibling_pos):
                            if parser.effect_clone_active_owner != "" and (any visible_name in parser.effect_clone_visible_names where visible_name == module_sibling_name):
                                qualified_arguments: mutable darray[Ast::Expr] @source = []
                                qualified_names: mutable darray[sview @source] @source = []
                                qualified_index: mutable usize = 0
                                while qualified_index < arguments.count |parser, qualified_index, qualified_arguments, qualified_names, argument_names, effect_name, handler_name, captures|:
                                    rebind qualified_argument: Ast::Expr, parser = parser.rewrite_handler_expression(arguments[qualified_index], effect_name, handler_name, captures) can Global{Read,Write}
                                    qualified_arguments.push(qualified_argument)
                                    qualified_names.push(argument_names[qualified_index] if qualified_index < argument_names.count else "")
                                    qualified_index <- qualified_index + 1.usize()
                                qualified_owner_expr: Ast::Expr = Ast::Expr.Ident(parser.effect_clone_active_owner, Ast::pos_at_line(0))
                                qualified_callee: Ast::Expr = Ast::Expr.Scope(qualified_owner_expr, module_sibling_name, module_sibling_pos)
                                return (Ast::Expr.Call(qualified_callee, qualified_arguments, qualified_names, call_pos))
                        match callee:
                            Expr.Field(effect_head, operation, field_pos):
                                if parser.handler_operation_ref_matches_effect(operation, field_pos, effect_name) and parser.handler_effect_head_matches(effect_head, effect_name, call_pos.offset.usize()) and parser.handler_declares_operation(handler_name, operation):
                                    rewritten_arguments: mutable darray[Ast::Expr] @source = []
                                    rewritten_names: mutable darray[sview @source] @source = []
                                    for capture in captures |rewritten_arguments, rewritten_names|:
                                        rewritten_arguments.push(capture)
                                        rewritten_names.push("")
                                    argument_index: mutable usize = 0
                                    while argument_index < arguments.count |parser, argument_index, rewritten_arguments, rewritten_names, argument_names|:
                                        rebind rewritten_argument: Ast::Expr, parser = parser.rewrite_handler_expression(arguments[argument_index], effect_name, handler_name, captures) can Global{Read,Write}
                                        rewritten_arguments.push(rewritten_argument)
                                        rewritten_names.push(argument_names[argument_index] if argument_index < argument_names.count else "")
                                        argument_index <- argument_index + 1
                                    # Line zero marks a compiler-generated callee. The generated
                                    # function is intentionally not a source-level capability:
                                    # semantic validation uses this marker to reject a user who
                                    # tries to spell the lowered name directly.
                                    return (Ast::Expr.Call(parser.handler_operation_callee(handler_name, operation, Ast::pos_at_line(0)), rewritten_arguments, rewritten_names, call_pos))
                                elif handler_effect_head_family(effect_head) == handler_effect_family(effect_name) and parser.handler_is_known(handler_name) and parser.handler_declares_operation(handler_name, operation):
                                    parser <- parser.record_effect_specialization_mismatch_for(effect_name, field_pos)
                            Expr.Scope(effect_head, operation, scope_pos):
                                if parser.handler_operation_ref_matches_effect(operation, scope_pos, effect_name) and parser.handler_effect_head_matches(effect_head, effect_name, call_pos.offset.usize()) and parser.handler_declares_operation(handler_name, operation):
                                    rewritten_arguments: mutable darray[Ast::Expr] @source = []
                                    rewritten_names: mutable darray[sview @source] @source = []
                                    for capture in captures |rewritten_arguments, rewritten_names|:
                                        rewritten_arguments.push(capture)
                                        rewritten_names.push("")
                                    argument_index_scope: mutable usize = 0
                                    while argument_index_scope < arguments.count |parser, argument_index_scope, rewritten_arguments, rewritten_names, argument_names|:
                                        rebind rewritten_argument_scope: Ast::Expr, parser = parser.rewrite_handler_expression(arguments[argument_index_scope], effect_name, handler_name, captures) can Global{Read,Write}
                                        rewritten_arguments.push(rewritten_argument_scope)
                                        rewritten_names.push(argument_names[argument_index_scope] if argument_index_scope < argument_names.count else "")
                                        argument_index_scope <- argument_index_scope + 1
                                    # Keep the lowered operation private to the static rewrite.
                                    return (Ast::Expr.Call(parser.handler_operation_callee(handler_name, operation, Ast::pos_at_line(0)), rewritten_arguments, rewritten_names, call_pos))
                                elif handler_effect_head_family(effect_head) == handler_effect_family(effect_name) and parser.handler_is_known(handler_name) and parser.handler_declares_operation(handler_name, operation):
                                    parser <- parser.record_effect_specialization_mismatch_for(effect_name, scope_pos)
                            _:
                                pass
                        rebind rewritten_callee: Ast::Expr, parser = parser.rewrite_handler_expression(callee, effect_name, handler_name, captures) can Global{Read,Write}
                        rewritten_arguments: mutable darray[Ast::Expr] @source = []
                        rewritten_names: mutable darray[sview @source] @source = []
                        argument_index: mutable usize = 0
                        while argument_index < arguments.count |parser, argument_index, rewritten_arguments, rewritten_names, argument_names|:
                            rebind rewritten_argument: Ast::Expr, parser = parser.rewrite_handler_expression(arguments[argument_index], effect_name, handler_name, captures) can Global{Read,Write}
                            rewritten_arguments.push(rewritten_argument)
                            rewritten_names.push(argument_names[argument_index] if argument_index < argument_names.count else "")
                            argument_index <- argument_index + 1
                        return (Ast::Expr.Call(rewritten_callee, rewritten_arguments, rewritten_names, call_pos))
                    Expr.Field(object, field, field_pos):
                        rebind rewritten_object: Ast::Expr, parser = parser.rewrite_handler_expression(object, effect_name, handler_name, captures) can Global{Read,Write}
                        return (Ast::Expr.Field(rewritten_object, field, field_pos))
                    Expr.Scope(object, field, field_pos):
                        rebind rewritten_object: Ast::Expr, parser = parser.rewrite_handler_expression(object, effect_name, handler_name, captures) can Global{Read,Write}
                        return (Ast::Expr.Scope(rewritten_object, field, field_pos))
                    Expr.Index(object, index, index_pos):
                        rebind rewritten_object: Ast::Expr, parser = parser.rewrite_handler_expression(object, effect_name, handler_name, captures) can Global{Read,Write}
                        rebind rewritten_index: Ast::Expr, parser = parser.rewrite_handler_expression(index, effect_name, handler_name, captures) can Global{Read,Write}
                        return (Ast::Expr.Index(rewritten_object, rewritten_index, index_pos))
                    Expr.Slice(object, low, high, slice_pos):
                        rebind rewritten_object: Ast::Expr, parser = parser.rewrite_handler_expression(object, effect_name, handler_name, captures) can Global{Read,Write}
                        rebind rewritten_low: Ast::Expr, parser = parser.rewrite_handler_expression(low, effect_name, handler_name, captures) can Global{Read,Write}
                        rebind rewritten_high: Ast::Expr, parser = parser.rewrite_handler_expression(high, effect_name, handler_name, captures) can Global{Read,Write}
                        return (Ast::Expr.Slice(rewritten_object, rewritten_low, rewritten_high, slice_pos))
                    Expr.IndexN(object, arguments, index_pos):
                        rebind rewritten_object: Ast::Expr, parser = parser.rewrite_handler_expression(object, effect_name, handler_name, captures) can Global{Read,Write}
                        rewritten_arguments: mutable darray[Ast::Expr] @source = []
                        for argument in arguments |rewritten_arguments, parser|:
                            rebind rewritten_argument: Ast::Expr, parser = parser.rewrite_handler_expression(argument, effect_name, handler_name, captures) can Global{Read,Write}
                            rewritten_arguments.push(rewritten_argument)
                        return (Ast::Expr.IndexN(rewritten_object, rewritten_arguments, index_pos))
                    Expr.Binary(left, operator, right, binary_pos):
                        rebind rewritten_left: Ast::Expr, parser = parser.rewrite_handler_expression(left, effect_name, handler_name, captures) can Global{Read,Write}
                        rebind rewritten_right: Ast::Expr, parser = parser.rewrite_handler_expression(right, effect_name, handler_name, captures) can Global{Read,Write}
                        return (Ast::Expr.Binary(rewritten_left, operator, rewritten_right, binary_pos))
                    Expr.Unary(operator, operand, unary_pos):
                        rebind rewritten_operand: Ast::Expr, parser = parser.rewrite_handler_expression(operand, effect_name, handler_name, captures) can Global{Read,Write}
                        return (Ast::Expr.Unary(operator, rewritten_operand, unary_pos))
                    Expr.Move(operand, move_pos):
                        rebind rewritten_operand: Ast::Expr, parser = parser.rewrite_handler_expression(operand, effect_name, handler_name, captures) can Global{Read,Write}
                        return (Ast::Expr.Move(rewritten_operand, move_pos))
                    Expr.RegionNew(operand, region, new_pos):
                        rebind rewritten_operand: Ast::Expr, parser = parser.rewrite_handler_expression(operand, effect_name, handler_name, captures) can Global{Read,Write}
                        return (Ast::Expr.RegionNew(rewritten_operand, region, new_pos))
                    Expr.Paren(inner, paren_pos):
                        rebind rewritten_inner: Ast::Expr, parser = parser.rewrite_handler_expression(inner, effect_name, handler_name, captures) can Global{Read,Write}
                        return (Ast::Expr.Paren(rewritten_inner, paren_pos))
                    Expr.Array(elements, array_pos):
                        rewritten_elements: mutable darray[Ast::Expr] @source = []
                        for element in elements |rewritten_elements, parser|:
                            rebind rewritten_element: Ast::Expr, parser = parser.rewrite_handler_expression(element, effect_name, handler_name, captures) can Global{Read,Write}
                            rewritten_elements.push(rewritten_element)
                        return (Ast::Expr.Array(rewritten_elements, array_pos))
                    Expr.Tuple(elements, tuple_pos):
                        rewritten_elements: mutable darray[Ast::Expr] @source = []
                        for element in elements |rewritten_elements, parser|:
                            rebind rewritten_element: Ast::Expr, parser = parser.rewrite_handler_expression(element, effect_name, handler_name, captures) can Global{Read,Write}
                            rewritten_elements.push(rewritten_element)
                        return (Ast::Expr.Tuple(rewritten_elements, tuple_pos))
                    Expr.SetLit(elements, set_pos):
                        rewritten_elements: mutable darray[Ast::Expr] @source = []
                        for element in elements |rewritten_elements, parser|:
                            rebind rewritten_element: Ast::Expr, parser = parser.rewrite_handler_expression(element, effect_name, handler_name, captures) can Global{Read,Write}
                            rewritten_elements.push(rewritten_element)
                        return (Ast::Expr.SetLit(rewritten_elements, set_pos))
                    Expr.DictLit(entries, dict_pos):
                        rewritten_entries: mutable darray[Ast::DictEntry] @source = []
                        for entry in entries |rewritten_entries, parser|:
                            rebind rewritten_key: Ast::Expr, parser = parser.rewrite_handler_expression(entry.key, effect_name, handler_name, captures) can Global{Read,Write}
                            rebind rewritten_value: Ast::Expr, parser = parser.rewrite_handler_expression(entry.value, effect_name, handler_name, captures) can Global{Read,Write}
                            rewritten_entries.push(Ast::DictEntry{key: rewritten_key, value: rewritten_value})
                        return (Ast::Expr.DictLit(rewritten_entries, dict_pos))
                    Expr.Construct(type_expression, fields, construct_pos):
                        rebind rewritten_type: Ast::Expr, parser = parser.rewrite_handler_expression(type_expression, effect_name, handler_name, captures) can Global{Read,Write}
                        rewritten_fields: mutable darray[Ast::FieldInit] @source = []
                        for field in fields |rewritten_fields, parser|:
                            rebind rewritten_value: Ast::Expr, parser = parser.rewrite_handler_expression(field.value, effect_name, handler_name, captures) can Global{Read,Write}
                            rewritten_fields.push(Ast::FieldInit{name: field.name, value: rewritten_value})
                        return (Ast::Expr.Construct(rewritten_type, rewritten_fields, construct_pos))
                    Expr.RecordUpdate(base, fields, update_pos):
                        rebind rewritten_base: Ast::Expr, parser = parser.rewrite_handler_expression(base, effect_name, handler_name, captures) can Global{Read,Write}
                        rewritten_fields: mutable darray[Ast::FieldInit] @source = []
                        for field in fields |rewritten_fields, parser|:
                            rebind rewritten_value: Ast::Expr, parser = parser.rewrite_handler_expression(field.value, effect_name, handler_name, captures) can Global{Read,Write}
                            rewritten_fields.push(Ast::FieldInit{name: field.name, value: rewritten_value})
                        return (Ast::Expr.RecordUpdate(rewritten_base, rewritten_fields, update_pos))
                    Expr.If(condition, then_expr, else_expr, if_pos):
                        rebind rewritten_condition: Ast::Expr, parser = parser.rewrite_handler_expression(condition, effect_name, handler_name, captures) can Global{Read,Write}
                        rebind rewritten_then: Ast::Expr, parser = parser.rewrite_handler_expression(then_expr, effect_name, handler_name, captures) can Global{Read,Write}
                        rebind rewritten_else: Ast::Expr, parser = parser.rewrite_handler_expression(else_expr, effect_name, handler_name, captures) can Global{Read,Write}
                        return (Ast::Expr.If(rewritten_condition, rewritten_then, rewritten_else, if_pos))
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_pos, comprehension_scope_id):
                        rebind rewritten_iterable: Ast::Expr, parser = parser.rewrite_handler_expression(iterable, effect_name, handler_name, captures) can Global{Read,Write}
                        rebind rewritten_condition: Ast::Expr, parser = parser.rewrite_handler_expression(condition, effect_name, handler_name, captures) can Global{Read,Write}
                        rebind rewritten_body: Ast::Expr, parser = parser.rewrite_handler_expression(body, effect_name, handler_name, captures) can Global{Read,Write}
                        return (Ast::Expr.Comprehension(variable, rewritten_iterable, rewritten_condition, rewritten_body, comprehension_pos, comprehension_scope_id))
                    Expr.Refinement(base, predicate, refinement_pos):
                        rebind rewritten_base: Ast::Expr, parser = parser.rewrite_handler_expression(base, effect_name, handler_name, captures) can Global{Read,Write}
                        rebind rewritten_predicate: Ast::Expr, parser = parser.rewrite_handler_expression(predicate, effect_name, handler_name, captures) can Global{Read,Write}
                        return (Ast::Expr.Refinement(rewritten_base, rewritten_predicate, refinement_pos))
                    Expr.GetElse(guarded, recovery, get_pos):
                        rebind rewritten_guarded: Ast::Expr, parser = parser.rewrite_handler_expression(guarded, effect_name, handler_name, captures) can Global{Read,Write}
                        rebind rewritten_recovery: darray[Ast::Stmt] @source, parser = parser.rewrite_handler_statements(recovery, effect_name, handler_name, captures) can Global{Read,Write}
                        return (Ast::Expr.GetElse(rewritten_guarded, rewritten_recovery, get_pos))
                    Expr.Lambda(parameters, body, lambda_pos):
                        rebind rewritten_body: darray[Ast::Stmt] @source, parser = parser.rewrite_handler_statements(body, effect_name, handler_name, captures) can Global{Read,Write}
                        return (Ast::Expr.Lambda(parameters, rewritten_body, lambda_pos))
                    Expr.Block(statements, value, block_captures, block_pos):
                        rebind rewritten_statements: darray[Ast::Stmt] @source, parser = parser.rewrite_handler_statements(statements, effect_name, handler_name, captures) can Global{Read,Write}
                        rebind rewritten_value: Ast::Expr, parser = parser.rewrite_handler_expression(value, effect_name, handler_name, captures) can Global{Read,Write}
                        return (Ast::Expr.Block(rewritten_statements, rewritten_value, block_captures, block_pos))
                    Expr.Match(scrutinee, arms, match_pos):
                        rebind rewritten_scrutinee: Ast::Expr, parser = parser.rewrite_handler_expression(scrutinee, effect_name, handler_name, captures) can Global{Read,Write}
                        rewritten_arms: mutable darray[Ast::MatchArm] @source = []
                        for arm in arms |rewritten_arms, parser|:
                            rebind rewritten_guard: Ast::Expr, parser = parser.rewrite_handler_expression(arm.guard, effect_name, handler_name, captures) can Global{Read,Write}
                            rebind rewritten_body: darray[Ast::Stmt] @source, parser = parser.rewrite_handler_statements(arm.body, effect_name, handler_name, captures) can Global{Read,Write}
                            rewritten_arms.push(Ast::MatchArm{pattern: arm.pattern, body: rewritten_body, guard: rewritten_guard, pos: arm.pos})
                        return (Ast::Expr.Match(rewritten_scrutinee, rewritten_arms, match_pos))
                    Expr.Catch(guarded, arms, catch_pos):
                        rebind rewritten_guarded: Ast::Expr, parser = parser.rewrite_handler_expression(guarded, effect_name, handler_name, captures) can Global{Read,Write}
                        rewritten_arms: mutable darray[Ast::MatchArm] @source = []
                        for arm in arms |rewritten_arms, parser|:
                            rebind rewritten_guard: Ast::Expr, parser = parser.rewrite_handler_expression(arm.guard, effect_name, handler_name, captures) can Global{Read,Write}
                            rebind rewritten_body: darray[Ast::Stmt] @source, parser = parser.rewrite_handler_statements(arm.body, effect_name, handler_name, captures) can Global{Read,Write}
                            rewritten_arms.push(Ast::MatchArm{pattern: arm.pattern, body: rewritten_body, guard: rewritten_guard, pos: arm.pos})
                        return (Ast::Expr.Catch(rewritten_guarded, rewritten_arms, catch_pos))
                    _:
                        return expression
                return expression
