extend Parser:
    private:
        # Rebuild one declaration so nested module/scoped declaration arrays stay owned by the
        # AST value being returned. Pattern-bound nested darrays are immutable views in Elisa;
        # attempting to pass them to the in-place list mutator would either fail to compile or
        # require an unsafe escape from the parser's temporary region.
        def effect_specialize_declaration(parser: lmut Parser, declaration: Ast::Decl) -> Ast::Decl:
            match declaration:
                Decl.Module(module_name, module_body, module_pos):
                    saved_owner: sview = parser.effect_clone_active_owner
                    saved_visible_count: usize = parser.effect_clone_visible_names.count
                    parser.effect_clone_active_owner <- module_name
                    for member in module_body |parser|:
                        if member is Decl.Func(member_name, member_parameters, member_return, member_body, member_effects, member_decorators, member_position):
                            parser.effect_clone_visible_names <- parser.effect_clone_visible_names.push(member_name)
                    specialized_module: mutable darray[Ast::Decl] @source = []
                    for nested in module_body |parser, specialized_module|:
                        rebind specialized_nested: Ast::Decl, parser = parser.effect_specialize_declaration(nested) can Global{Read,Write}
                        specialized_module.push(specialized_nested)
                    parser.effect_clone_active_owner <- saved_owner
                    parser.effect_clone_visible_names <- parser.effect_clone_visible_names.truncate(saved_visible_count)
                    return Decl.Module(module_name, specialized_module, module_pos)
                Decl.Scoped(scoped_body, scoped_pos):
                    specialized_scope: mutable darray[Ast::Decl] @source = []
                    for nested_scope in scoped_body |parser, specialized_scope|:
                        rebind specialized_nested_scope: Ast::Decl, parser = parser.effect_specialize_declaration(nested_scope) can Global{Read,Write}
                        specialized_scope.push(specialized_nested_scope)
                    return Decl.Scoped(specialized_scope, scoped_pos)
                Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                    rebind specialized_body: darray[Ast::Stmt] @source, parser = parser.effect_specialize_install_statements(body) can Global{Read,Write}
                    return Decl.Func(function_name, parameters, return_type, specialized_body, effects, decorators, line)
                _:
                    return declaration

        def effect_specialize_declarations(parser: lmut Parser, declarations: mutable darray[Ast::Decl]&) -> void:
            for declaration_index in 0..<declarations.count |parser, declarations|:
                rebind specialized_declaration: Ast::Decl, parser = parser.effect_specialize_declaration(declarations[declaration_index]) can Global{Read,Write}
                declarations[declaration_index] <- specialized_declaration

        # One post-parse transaction keeps the order explicit: discover templates, register
        # the complete clone set, build clones, then redirect calls in ordinary functions.
        def specialize_effect_templates(parser: lmut Parser, declarations: mutable darray[Ast::Decl]&) -> void:
            parser <- parser.mark_effect_templates(declarations) can Global{Read,Write}
            # Template markers must be retained even when no handler installation exists,
            # because backend emission still needs to omit the source templates. There can
            # be no concrete clones or redirected calls in that case, so skip the declaration
            # collection and rewrite walks below.
            if parser.effect_install_lines.count == 0:
                parser.effect_active_install <- 0
                return
            parser <- parser.effect_register_clones(declarations) can Global{Read,Write}
            rebind clones: darray[Ast::Decl], parser = parser.effect_build_clones(declarations) can Global{Read,Write}
            parser <- parser.effect_specialize_declarations(declarations) can Global{Read,Write}
            declarations.extend(clones)
