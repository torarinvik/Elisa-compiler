# Stage1 parser — block-introducing statements (`extend Parser: private:`). Covers
# `proof`, `expect`, `static if` blocks, and the prefixed-block dispatcher that
# handles the remaining keyword-headed blocks. Continues parser_stmt_control.elisa;
# split out to keep each part file under 600 lines.

extend Parser:
    private:
        # `proof GOAL:` — a scoped proof-tactic block (docs/90) whose GOAL must follow from
        # the block's OWN facts (walls: the caller's `requires` do NOT count). Model it exactly
        # like `assert GOAL by scoped:` so check_assert_by judges it: the goal rides as the
        # block's first Contract and the tactic binding is "scoped".
        def proof_block_statement(parser: lmut Parser) -> Ast::Stmt?:
            can Memory.Allocate, Abort.Panic:
                keyword_token: Token = parser.cursor()
                parser, _ <- parser.advance()                            # `proof`
                rebind predicate_opt: Ast::Expr?, parser = parser.expression() can Global{Read,Write}
                predicate: Ast::Expr = get predicate_opt else (Ast::Expr.Invalid)
                parser, _ <- parser.accept(TokenKind.Colon)
                rebind proof_body: darray[Ast::Stmt], parser = parser.parse_indented_block_if(true) can Global{Read,Write}
                carried: mutable darray[Ast::Stmt] @source = [(Ast::Stmt.Contract("assert", predicate, Ast::pos_of_token(keyword_token)))]
                carried.extend(proof_body)
                empty_clause: darray[sview @source] @source = []
                return (Ast::Stmt.Block("assert_by", empty_clause, sview("scoped", 0, 6), carried, Ast::pos_of_token(keyword_token)))

        # `expect EXPR as PATTERN(S)` (with an optional `:` block) and the inverted
        # `expect let PATTERN = EXPR` — assert EXPR matches PATTERN, binding its fields.
        # Modeled as a Match on EXPR. Stage0 keeps a dedicated ExpectPatternStmt and
        # lowers its failure path in the backend; stage1 represents that failure as an
        # explicit wildcard panic arm so the AST remains self-contained.
        def expect_pattern_failure_stmt(parser: Parser&, line: u32) -> Ast::Stmt:
            panic_callee: Ast::Expr = (Ast::Expr.Ident("panic", Ast::pos_at_line(line)))
            panic_message: Ast::Expr = (Ast::Expr.StringLit("expect pattern failed", Ast::pos_at_line(0)))
            panic_args: mutable darray[Ast::Expr] @source = [panic_message]
            no_arg_names: darray[sview @source] @source = [""]
            panic_call: Ast::Expr = (Ast::Expr.Call(panic_callee, panic_args, no_arg_names, Ast::pos_at_line(line)))
            return (Ast::Stmt.Expr(panic_call, Ast::pos_at_line(line)))

        def expect_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind expect_token: Token, parser = parser.advance()              # `expect`

            let_token: Token = parser.cursor()
            if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(let_token, parser.source, parser.source_length) == "let":
                parser, _ <- parser.advance()                       # `let`
                # `|` fans out into sibling arms here too, the way stage0's
                # parseTopLevelMatchPatterns does; only the word `or` leaves a single
                # Pattern.Or for the analyzer to refuse.
                let_alternatives: mutable darray[Ast::Pattern] = []
                parser <- parser.parse_top_level_patterns(let_alternatives)
                parser, _ <- parser.capture_pattern_span() if parser.peek() != TokenKind.Assign      # exotic tail; consumed losslessly
                parser, _ <- parser.expect(TokenKind.Assign)
                rebind let_value: Ast::Expr, parser = get parser.expression() can Global{Read,Write}
                let_body: mutable darray[Ast::Stmt] @source = []
                let_has_block: bool = parser.peek() == TokenKind.Colon
                let_body, parser <- parser.parse_block() can Global{Read,Write} if let_has_block
                let_arms: mutable darray[Ast::MatchArm] @source = []
                for let_alternative in let_alternatives:
                    let_arms.push(Ast::MatchArm{pattern: let_alternative, body: let_body, guard: (Ast::Expr.Absent)})
                let_panic_body: darray[Ast::Stmt] @source = [parser.expect_pattern_failure_stmt(expect_token.line)]
                let_arms.push(Ast::MatchArm{pattern: (Ast::Pattern.Wildcard), body: let_panic_body, guard: (Ast::Expr.Absent)})
                let_match: Ast::Stmt = (Ast::Stmt.Match(let_value, let_arms, Ast::pos_of_token(expect_token)))
                if let_has_block:
                    return let_match
                else:
                    let_lowered: mutable darray[Ast::Stmt] @source = [let_match]
                    let_bindings: mutable darray[sview @source] = []
                    pattern_binding_names_many(let_alternatives, let_bindings)
                    let_lowered.extend([(Ast::Stmt.VarDecl(let_binding, (Ast::Expr.Invalid), (Ast::Expr.Absent), Ast::pos_of_token(expect_token))) for let_binding in let_bindings])
                    return (Ast::Stmt.Block("expect", [], "", let_lowered, Ast::pos_of_token(expect_token)))

            parser.suppress_as_pattern <- true
            rebind value_option: Ast::Expr?, parser = parser.expression() can Global{Read,Write}
            parser.suppress_as_pattern <- false
            value: Ast::Expr = get value_option else return (Ast::Stmt.Invalid)
            parser, _ <- parser.expect(TokenKind.As)
            # `|` fans out into sibling arms here too, the way stage0's
            # parseTopLevelMatchPatterns does; only the word `or` leaves a single
            # Pattern.Or for the analyzer to refuse.
            alternatives: mutable darray[Ast::Pattern] = []
            parser <- parser.parse_top_level_patterns(alternatives)

            body: mutable darray[Ast::Stmt] @source = []
            has_block: bool = parser.peek() == TokenKind.Colon
            body, parser <- parser.parse_block() can Global{Read,Write} if has_block
            body.push((Ast::Stmt.Expr((Ast::Expr.Invalid), Ast::pos_of_token(expect_token)))) if body.count == 0

            arms: mutable darray[Ast::MatchArm] @source = []
            for alternative in alternatives:
                arms.push(Ast::MatchArm{pattern: alternative, body: body, guard: (Ast::Expr.Absent)})
            panic_body: darray[Ast::Stmt] @source = [parser.expect_pattern_failure_stmt(expect_token.line)]
            arms.push(Ast::MatchArm{pattern: (Ast::Pattern.Wildcard), body: panic_body, guard: (Ast::Expr.Absent)})
            expect_match: Ast::Stmt = (Ast::Stmt.Match(value, arms, Ast::pos_of_token(expect_token)))
            if has_block:
                return expect_match
            else:
                expect_lowered: mutable darray[Ast::Stmt] @source = [expect_match]
                bindings: mutable darray[sview @source] = []
                pattern_binding_names_many(alternatives, bindings)
                expect_lowered.extend([(Ast::Stmt.VarDecl(binding_name, (Ast::Expr.Invalid), (Ast::Expr.Absent), Ast::pos_of_token(expect_token))) for binding_name in bindings])
                return (Ast::Stmt.Block("expect", [], "", expect_lowered, Ast::pos_of_token(expect_token)))


        # A handler installation has a richer header than an ordinary permission grant. Keep
        # `Effect[T] with Handler(capture)` as one effect reference and parse the capture
        # expressions before the block body so the body parser can perform direct-call rewriting.
        def can_handler_clause_ahead(parser: Parser&) -> bool:
            return false if parser.peek() != TokenKind.Ident
            scan: mutable usize = 1
            depth: mutable int = 0
            while parser.peek_at(scan) != TokenKind.Eof |parser, scan, depth|:
                kind: TokenKind = parser.peek_at(scan)
                return true if depth == 0 and kind == TokenKind.With
                break if depth == 0 and (kind == TokenKind.Colon or kind == TokenKind.Newline)
                depth <- depth + 1 if kind == TokenKind.LParen or kind == TokenKind.LBracket or kind == TokenKind.LBrace
                depth <- depth - 1 if depth > 0 and (kind == TokenKind.RParen or kind == TokenKind.RBracket or kind == TokenKind.RBrace)
                scan <- scan + 1
            return false

        def handler_effect_trim_layout(effect_ref: sview) -> sview:
            start: mutable usize = 0
            finish: mutable usize = effect_ref.len
            while start < finish and (effect_ref[start] == 32 or effect_ref[start] == 9 or effect_ref[start] == 13) |start, finish, effect_ref|:
                start <- start + 1.usize()
            while finish > start and (effect_ref[finish - 1.usize()] == 32 or effect_ref[finish - 1.usize()] == 9 or effect_ref[finish - 1.usize()] == 13) |finish, start, effect_ref|:
                finish <- finish - 1.usize()
            return effect_ref[start:finish]

        # Expand a grouped grant into the same refs as `can [Family.A, Family.B]`.
        # Keep the joined names in parser-owned storage for the AST's lifetime.
        def block_effect_member_name[@r](parser: mutable Parser& @r, family: sview, member: sview) -> sview @source:
            name_bytes: mutable darray[u8] = []
            append_machine_name_text(name_bytes, family)
            name_bytes.push(46)
            append_machine_name_text(name_bytes, member)
            return NameStore::append(&parser.module_name_store, name_bytes, parser.name_store_chunk())

        def consume_block_effect_members(parser: lmut Parser, family: sview, clause: mutable darray[sview]&) -> void:
            parser, _ <- parser.expect(TokenKind.LBrace)
            while parser.peek() == TokenKind.Ident |parser, clause|:
                rebind member: sview, parser = parser.parse_dotted_name()
                qualified: sview = parser.block_effect_member_name(family, member)
                clause.push(qualified)
                rebind comma: bool, parser = parser.accept(TokenKind.Comma)
                break if not comma
            parser, _ <- parser.expect(TokenKind.RBrace)

        # Consume a bracketed effect row as complete source spans. The ordinary block-prefix
        # scanner treats a bracket as a generic nesting delimiter, which is correct for
        # `can Writer[T]:` but loses the `via` dimension in `can[Writer[T] via Console.Write]:`.
        # This path keeps nested type brackets opaque while splitting only at row-level commas.
        def consume_block_effect_list(parser: lmut Parser, clause: mutable darray[sview]&) -> void:
            parser, _ <- parser.advance()                              # consume `[`
            item_start: mutable usize = parser.cursor().start.usize()
            depth: mutable int = 0
            item_has_tokens: mutable bool = false
            while parser.peek() != TokenKind.Eof |parser, item_start, depth, item_has_tokens, clause|:
                kind: TokenKind = parser.peek()
                if kind == TokenKind.RBracket and depth == 0:
                    clause.push(parser.span_view(item_start, parser.cursor().start.usize())) if item_has_tokens
                    parser, _ <- parser.advance()
                    return
                if kind == TokenKind.Comma and depth == 0:
                    clause.push(parser.span_view(item_start, parser.cursor().start.usize())) if item_has_tokens
                    parser, _ <- parser.advance()
                    item_start <- parser.cursor().start.usize()
                    item_has_tokens <- false
                else:
                    item_has_tokens <- true
                    depth <- depth + 1 if kind == TokenKind.LBracket or kind == TokenKind.LParen or kind == TokenKind.LBrace
                    depth <- depth - 1 if depth > 0 and (kind == TokenKind.RBracket or kind == TokenKind.RParen or kind == TokenKind.RBrace)
                    parser, _ <- parser.advance()

        # Fill only the trailing omitted captures whose handler declaration supplied a
        # default. The resulting arguments are ordinary AST expressions and are then
        # bound to lexical locals by the installation rewrite, so each default runs once
        # per installation. Required omissions remain absent for the semantic arity check.
        def materialize_handler_capture_defaults(parser: Parser&, handler_name: sview, arguments: mutable darray[Ast::Expr]&) -> void can[Memory.Allocate]:
            return if parser.handler_capture_owners.count == 0
            handler_owner: sview = parser.current_module
            handler_identity_id: u32 = parser.handler_identity_for_name(handler_name, handler_owner)
            return if handler_identity_id == 0
            capture_index: mutable usize = 0
            owner_index: mutable usize = 0
            while owner_index < parser.handler_capture_owners.count |owner_index, capture_index, arguments|:
                if parser.handler_capture_owners[owner_index] == handler_name and parser.handler_capture_identity_ids[owner_index] == handler_identity_id:
                    parameter: Ast::ParamDecl = parser.handler_capture_params[owner_index]
                    if capture_index >= arguments.count and parameter.has_default:
                        arguments.push(parameter.default_value)
                    capture_index <- capture_index + 1.usize()
                owner_index <- owner_index + 1.usize()

        def consume_can_handler_clause(parser: lmut Parser, clause: mutable darray[sview]&, effect_name: mutable sview&, handler_name: mutable sview&, arguments: mutable darray[Ast::Expr]&, install_offset: u32) -> bool:
            return false if not parser.can_handler_clause_ahead()
            # `prefixed_block_statement` is entered with the contextual `can` token still
            # under the cursor. The effect span begins after that marker, not at `can`.
            leading_can_token: Token = parser.cursor()
            parser, _ <- parser.advance() if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(leading_can_token, parser.source, parser.source_length) == "can"
            effect_start_token: Token = parser.cursor()
            effect_reference_start: usize = parser.position
            effect_name <- Lexer::text_or_empty(effect_start_token, parser.source, parser.source_length)
            effect_start: usize = effect_start_token.start.usize()
            effect_end: mutable usize = effect_start
            depth: mutable int = 0
            while parser.peek() != TokenKind.Eof |parser, depth, effect_end|:
                kind: TokenKind = parser.peek()
                break if depth == 0 and kind == TokenKind.With
                break if depth == 0 and (kind == TokenKind.Colon or kind == TokenKind.Newline)
                current: Token = parser.cursor()
                effect_end <- current.start.usize() + current.length.usize()
                depth <- depth + 1 if kind == TokenKind.LParen or kind == TokenKind.LBracket or kind == TokenKind.LBrace
                depth <- depth - 1 if depth > 0 and (kind == TokenKind.RParen or kind == TokenKind.RBracket or kind == TokenKind.RBrace)
                parser, _ <- parser.advance()
            effect_ref: sview = parser.span_view(effect_start, effect_end)
            effect_reference_finish: usize = parser.position
            parser <- parser.record_effect_reference(effect_reference_start, effect_reference_finish)
            clause.push(effect_ref) if effect_end > effect_start
            # Preserve the installation's handler identity in the side table. The compact
            # stage1 statement node intentionally remains the ordinary Block shape; semantic
            # validation joins this record by the block's exact source position.
            parser, _ <- parser.expect(TokenKind.With)
            rebind handler_ident: Token, parser = parser.expect(TokenKind.Ident)
            handler_name <- Lexer::text_or_empty(handler_ident, parser.source, parser.source_length)
            installed_handler_value: sview = Lexer::text_or_empty(handler_ident, parser.source, parser.source_length)
            installed_effect_identity_id: u32 = parser.effect_identity_for_reference(effect_ref, parser.current_module, effect_start_token.start)
            installed_handler_identity_id: u32 = parser.handler_identity_for_name(installed_handler_value, parser.current_module)
            # The first annotation records the handler after `with` is consumed. Keeping all
            # annotation fields immutable avoids storing a view typed as a mutable reference.
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__effect_install", name: installed_handler_value, line: effect_start_token.line, offset: install_offset, identity_id: installed_handler_identity_id})
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__effect_install_effect", name: effect_ref, line: effect_start_token.line, module: parser.current_module, offset: install_offset, occurrence_offset: effect_start_token.start, identity_id: installed_effect_identity_id})
            # Installing a static handler also installs the concrete permissions used
            # by its operation methods. Scan the side table by index rather than using
            # the accumulator form here: the latter aliases the mutable `clause` darray
            # through the generated loop frame and stage1 can reclaim its backing region
            # while the handler header is still being parsed.
            annotation_index: mutable usize = 0
            installed_target_ref: mutable sview = ""
            installed_target_identity_id: mutable u32 = 0
            while annotation_index < parser.enum_annotations.count |parser, annotation_index, clause, handler_name, installed_target_ref, installed_target_identity_id|:
                handler_annotation: Ast::EnumAnnotation = parser.enum_annotations[annotation_index]
                annotation_index <- annotation_index + 1
                if installed_handler_identity_id != 0 and handler_annotation.owner == handler_name and (handler_annotation.line == 3900000084 or handler_annotation.line == 3900000095) and handler_annotation.identity_id == installed_handler_identity_id:
                    target_realization: sview = handler_effect_via(handler_annotation.name)
                    installed_target_ref <- handler_annotation.name
                    if handler_annotation.line == 3900000084 and handler_annotation.referenced_identity_id != 0:
                        installed_target_identity_id <- handler_annotation.referenced_identity_id
                    elif installed_target_identity_id == 0:
                        installed_target_identity_id <- parser.effect_identity_for_reference(handler_annotation.name, parser.handler_identity_owner(installed_handler_identity_id), handler_annotation.offset)
                    clause.push(target_realization) if target_realization != ""
                continue if installed_handler_identity_id == 0 or handler_annotation.owner != handler_name or handler_annotation.line != 3900000087 or handler_annotation.identity_id != installed_handler_identity_id
                realization: sview = handler_effect_via(handler_annotation.name)
                if realization != "":
                    clause.push(realization)
                else:
                    method_effect_identity_id: u32 = handler_annotation.referenced_identity_id if handler_annotation.referenced_identity_id != 0 else parser.effect_identity_for_reference(handler_annotation.name, handler_annotation.module, handler_annotation.offset)
                    is_abstract: bool = method_effect_identity_id != 0
                    clause.push(handler_annotation.name) if not is_abstract
            # `handler HA() for A::Tick` installed as `can Tick with HA:` names two different
            # declarations. Comparing the two rows as text sees the same terminal family and
            # accepts it; the operation call then lowers to HA's hidden function. Resolve both
            # sides against the module each was written in and record the disagreement.
            installed_target_identity_id <- parser.effect_identity_for_reference(installed_target_ref, parser.handler_identity_owner(installed_handler_identity_id), effect_start_token.start) if installed_target_identity_id == 0 and installed_target_ref != ""
            if installed_target_identity_id != 0 and installed_effect_identity_id != 0 and installed_target_identity_id != installed_effect_identity_id:
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__effect_install_identity_mismatch", name: installed_target_ref, line: effect_start_token.line, offset: install_offset, identity_id: installed_handler_identity_id})
            if parser.peek() == TokenKind.LParen:
                parser, _ <- parser.advance()
                while parser.peek() != TokenKind.RParen and parser.peek() != TokenKind.Eof |parser, arguments|:
                    rebind argument_opt: Ast::Expr?, parser = parser.expression() can Global{Read,Write}
                    arguments.push(argument) if argument_opt is argument
                    rebind accepted_comma: bool, parser = parser.accept(TokenKind.Comma)
                    break if not accepted_comma
                parser, _ <- parser.expect(TokenKind.RParen)
            parser <- parser.materialize_handler_capture_defaults(installed_handler_value, arguments)
            # Keep the supplied count paired with this installation. Preserve the block
            # coordinates in line/offset and store the count in identity_id; this marker is
            # only consumed by exact-position capture-arity validation.
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__effect_install_capture_count", name: installed_handler_value, line: effect_start_token.line, offset: install_offset, identity_id: arguments.count.u32()})
            return true

        # The unbracketed block form has the same row grammar as a postfix grant:
        # `can Tick via Console.Write:` is one relation, not the three entries
        # `Tick`, `via`, and `Console.Write`. Only depth-zero `via` selects this
        # path, so a word inside `Effect[T]` remains part of its specialization.
        def can_via_clause_ahead(parser: Parser&) -> bool:
            return false if parser.peek() != TokenKind.Ident
            leading_can: Token = parser.cursor()
            return false if Lexer::text_or_empty(leading_can, parser.source, parser.source_length) != "can"
            scan: mutable usize = 1
            depth: mutable int = 0
            while parser.peek_at(scan) != TokenKind.Eof |parser, scan, depth|:
                kind: TokenKind = parser.peek_at(scan)
                return false if depth == 0 and (kind == TokenKind.Colon or kind == TokenKind.Newline)
                if depth == 0 and kind == TokenKind.Ident and Lexer::text_or_empty(parser.tokens[parser.position + scan], parser.source, parser.source_length) == "via":
                    return true
                depth <- depth + 1 if kind == TokenKind.LParen or kind == TokenKind.LBracket or kind == TokenKind.LBrace
                depth <- depth - 1 if depth > 0 and (kind == TokenKind.RParen or kind == TokenKind.RBracket or kind == TokenKind.RBrace)
                scan <- scan + 1.usize()
            return false

        def consume_unbracketed_via_effect(parser: lmut Parser, clause: mutable darray[sview]&) -> void:
            parser, _ <- parser.advance()                         # consume `can`
            effect_start: mutable usize = parser.cursor().start.usize()
            depth: mutable int = 0
            while parser.peek() != TokenKind.Eof |parser, depth, effect_start|:
                kind: TokenKind = parser.peek()
                if depth == 0 and (kind == TokenKind.Colon or kind == TokenKind.Newline):
                    clause.push(handler_effect_trim_layout(parser.span_view(effect_start, parser.cursor().start.usize()))) if parser.cursor().start.usize() > effect_start
                    break
                if depth == 0 and kind == TokenKind.Comma:
                    clause.push(handler_effect_trim_layout(parser.span_view(effect_start, parser.cursor().start.usize()))) if parser.cursor().start.usize() > effect_start
                    parser, _ <- parser.advance()
                    effect_start <- parser.cursor().start.usize()
                    continue
                current: Token = parser.cursor()
                depth <- depth + 1 if kind == TokenKind.LParen or kind == TokenKind.LBracket or kind == TokenKind.LBrace
                depth <- depth - 1 if depth > 0 and (kind == TokenKind.RParen or kind == TokenKind.RBracket or kind == TokenKind.RBrace)
                parser, _ <- parser.advance()

        # Rebuild statements with handler operation calls normalized. This is the statement
        # counterpart to rewrite_handler_expression; the AST is value-shaped, so each nested
        # body is rebuilt into the same ordinary Stmt variants rather than introducing a runtime
        # handler node.
        def rewrite_handler_statements(parser: lmut Parser, statements: darray[Ast::Stmt] @source, effect_name: sview @source, handler_name: sview, captures: darray[Ast::Expr] @source) -> darray[Ast::Stmt] @source:
            can Memory.Allocate, Abort.Panic:
                rewritten: mutable darray[Ast::Stmt] @source = []
                for statement in statements |rewritten, parser|:
                    match statement:
                        Stmt.Expr(expression, statement_pos):
                            rebind rewritten_expression: Ast::Expr, parser = parser.rewrite_handler_expression(expression, effect_name, handler_name, captures) can Global{Read,Write}
                            rewritten.push(Ast::Stmt.Expr(rewritten_expression, statement_pos))
                        Stmt.VarDecl(name, type_expression, value, statement_pos):
                            rebind rewritten_type: Ast::Expr, parser = parser.rewrite_handler_expression(type_expression, effect_name, handler_name, captures) can Global{Read,Write}
                            rebind rewritten_value: Ast::Expr, parser = parser.rewrite_handler_expression(value, effect_name, handler_name, captures) can Global{Read,Write}
                            rewritten.push(Ast::Stmt.VarDecl(name, rewritten_type, rewritten_value, statement_pos))
                        Stmt.Assign(target, operator, value, statement_pos):
                            rebind rewritten_target: Ast::Expr, parser = parser.rewrite_handler_expression(target, effect_name, handler_name, captures) can Global{Read,Write}
                            rebind rewritten_value: Ast::Expr, parser = parser.rewrite_handler_expression(value, effect_name, handler_name, captures) can Global{Read,Write}
                            rewritten.push(Ast::Stmt.Assign(rewritten_target, operator, rewritten_value, statement_pos))
                        Stmt.If(condition, then_body, else_body, statement_pos):
                            rebind rewritten_condition: Ast::Expr, parser = parser.rewrite_handler_expression(condition, effect_name, handler_name, captures) can Global{Read,Write}
                            rebind rewritten_then: darray[Ast::Stmt] @source, parser = parser.rewrite_handler_statements(then_body, effect_name, handler_name, captures) can Global{Read,Write}
                            rebind rewritten_else: darray[Ast::Stmt] @source, parser = parser.rewrite_handler_statements(else_body, effect_name, handler_name, captures) can Global{Read,Write}
                            rewritten.push(Ast::Stmt.If(rewritten_condition, rewritten_then, rewritten_else, statement_pos))
                        Stmt.While(condition, body, statement_pos):
                            rebind rewritten_condition: Ast::Expr, parser = parser.rewrite_handler_expression(condition, effect_name, handler_name, captures) can Global{Read,Write}
                            rebind rewritten_body: darray[Ast::Stmt] @source, parser = parser.rewrite_handler_statements(body, effect_name, handler_name, captures) can Global{Read,Write}
                            rewritten.push(Ast::Stmt.While(rewritten_condition, rewritten_body, statement_pos))
                        Stmt.For(bind, variables, iterable, body, statement_pos):
                            rebind rewritten_iterable: Ast::Expr, parser = parser.rewrite_handler_expression(iterable, effect_name, handler_name, captures) can Global{Read,Write}
                            rebind rewritten_body: darray[Ast::Stmt] @source, parser = parser.rewrite_handler_statements(body, effect_name, handler_name, captures) can Global{Read,Write}
                            rewritten.push(Ast::Stmt.For(bind, variables, rewritten_iterable, rewritten_body, statement_pos))
                        Stmt.Block(kind, clause, binding, body, statement_pos):
                            rebind rewritten_body: darray[Ast::Stmt] @source, parser = parser.rewrite_handler_statements(body, effect_name, handler_name, captures) can Global{Read,Write}
                            rewritten.push(Ast::Stmt.Block(kind, clause, binding, rewritten_body, statement_pos))
                        Stmt.Return(value, statement_pos):
                            if value is returned_value:
                                rebind rewritten_value: Ast::Expr, parser = parser.rewrite_handler_expression(returned_value, effect_name, handler_name, captures) can Global{Read,Write}
                                rewritten.push(Ast::Stmt.Return(rewritten_value, statement_pos))
                            else:
                                rewritten.push(statement)
                        Stmt.Match(scrutinee, arms, statement_pos):
                            rebind rewritten_scrutinee: Ast::Expr, parser = parser.rewrite_handler_expression(scrutinee, effect_name, handler_name, captures) can Global{Read,Write}
                            rewritten_arms: mutable darray[Ast::MatchArm] @source = []
                            for arm in arms |rewritten_arms, parser|:
                                rebind rewritten_guard: Ast::Expr, parser = parser.rewrite_handler_expression(arm.guard, effect_name, handler_name, captures) can Global{Read,Write}
                                rebind rewritten_body: darray[Ast::Stmt] @source, parser = parser.rewrite_handler_statements(arm.body, effect_name, handler_name, captures) can Global{Read,Write}
                                rewritten_arms.push(Ast::MatchArm{pattern: arm.pattern, body: rewritten_body, guard: rewritten_guard, pos: arm.pos})
                            rewritten.push(Ast::Stmt.Match(rewritten_scrutinee, rewritten_arms, statement_pos))
                        Stmt.Contract(kind, expression, statement_pos):
                            rebind rewritten_expression: Ast::Expr, parser = parser.rewrite_handler_expression(expression, effect_name, handler_name, captures) can Global{Read,Write}
                            rewritten.push(Ast::Stmt.Contract(kind, rewritten_expression, statement_pos))
                        _:
                            rewritten.push(statement)
                return rewritten
