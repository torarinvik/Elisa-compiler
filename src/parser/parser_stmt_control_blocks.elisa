# Stage1 parser — block-introducing statements (`extend Parser: private:`). Covers
# `proof`, `expect`, `static if` blocks, and the prefixed-block dispatcher that
# handles the remaining keyword-headed blocks. Continues parser_stmt_control.elisa;
# split out to keep each part file under 600 lines.

extend Parser:
    private:
        # `proof GOAL:` — a scoped proof-tactic block (docs/90) whose GOAL must follow from
        # the block's OWN facts (walls: the caller's `requires` do NOT count). Model it exactly
        # like `assert GOAL by scoped:` so check_assert_by judges it: the goal rides as the
        # block's first Contract and the tactic binding is "scoped".
        def proof_block_statement(parser: lmut Parser) -> Ast::Stmt?:
            can Memory.Allocate, Abort.Panic:
                keyword_token: Token = parser.cursor()
                parser, _ <- parser.advance()                            # `proof`
                rebind predicate_opt: Ast::Expr?, parser = parser.expression()
                predicate: Ast::Expr = get predicate_opt else (Ast::Expr.Invalid)
                parser, _ <- parser.accept(TokenKind.Colon)
                rebind proof_body: darray[Ast::Stmt], parser = parser.parse_indented_block_if(true)
                carried: mutable darray[Ast::Stmt] = [(Ast::Stmt.Contract("assert", predicate, Ast::pos_of_token(keyword_token)))]
                carried.extend(proof_body)
                empty_clause: darray[sview] = []
                return (Ast::Stmt.Block("assert_by", empty_clause, sview("scoped", 0, 6), carried, Ast::pos_of_token(keyword_token)))

        # `expect EXPR as PATTERN(S)` (with an optional `:` block) and the inverted
        # `expect let PATTERN = EXPR` — assert EXPR matches PATTERN, binding its fields.
        # Modeled as a Match on EXPR. Stage0 keeps a dedicated ExpectPatternStmt and
        # lowers its failure path in the backend; stage1 represents that failure as an
        # explicit wildcard panic arm so the AST remains self-contained.
        def expect_pattern_failure_stmt(parser: Parser&, line: u32) -> Ast::Stmt:
            panic_callee: Ast::Expr = (Ast::Expr.Ident("panic", Ast::pos_at_line(line)))
            panic_message: Ast::Expr = (Ast::Expr.StringLit("expect pattern failed"))
            panic_args: mutable darray[Ast::Expr] = [panic_message]
            no_arg_names: darray[sview] = [""]
            panic_call: Ast::Expr = (Ast::Expr.Call(panic_callee, panic_args, no_arg_names, Ast::pos_at_line(line)))
            return (Ast::Stmt.Expr(panic_call, Ast::pos_at_line(line)))

        def expect_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind expect_token: Token, parser = parser.advance()              # `expect`

            let_token: Token = parser.cursor()
            if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(let_token, parser.source) == "let":
                parser, _ <- parser.advance()                       # `let`
                rebind let_pattern: Ast::Pattern, parser = parser.parse_pattern()
                parser, _ <- parser.capture_pattern_span() if parser.peek() != TokenKind.Assign      # exotic tail; consumed losslessly
                parser, _ <- parser.expect(TokenKind.Assign)
                rebind let_value: Ast::Expr, parser = get parser.expression()
                let_body: mutable darray[Ast::Stmt] = []
                let_has_block: bool = parser.peek() == TokenKind.Colon
                let_body, parser <- parser.parse_block() if let_has_block
                let_arms: mutable darray[Ast::MatchArm] = [Ast::MatchArm{pattern: let_pattern, body: let_body, guard: (Ast::Expr.Absent)}]
                let_panic_body: darray[Ast::Stmt] = [parser.expect_pattern_failure_stmt(expect_token.line)]
                let_arms.push(Ast::MatchArm{pattern: (Ast::Pattern.Wildcard), body: let_panic_body, guard: (Ast::Expr.Absent)})
                let_match: Ast::Stmt = (Ast::Stmt.Match(let_value, let_arms, Ast::pos_of_token(expect_token)))
                if let_has_block:
                    return let_match
                else:
                    let_lowered: mutable darray[Ast::Stmt] = [let_match]
                    let_bindings: mutable darray[sview] = []
                    pattern_binding_names(let_pattern, let_bindings)
                    let_lowered.extend([(Ast::Stmt.VarDecl(let_binding, (Ast::Expr.Invalid), (Ast::Expr.Absent), Ast::pos_of_token(expect_token))) for let_binding in let_bindings])
                    return (Ast::Stmt.Block("expect", [], "", let_lowered, Ast::pos_of_token(expect_token)))

            parser.suppress_as_pattern <- true
            rebind value_option: Ast::Expr?, parser = parser.expression()
            parser.suppress_as_pattern <- false
            value: Ast::Expr = get value_option else return (Ast::Stmt.Invalid)
            parser, _ <- parser.expect(TokenKind.As)
            rebind pattern: Ast::Pattern, parser = parser.parse_pattern()

            body: mutable darray[Ast::Stmt] = []
            has_block: bool = parser.peek() == TokenKind.Colon
            body, parser <- parser.parse_block() if has_block
            body.push((Ast::Stmt.Expr((Ast::Expr.Invalid), Ast::pos_of_token(expect_token)))) if body.count == 0

            arms: mutable darray[Ast::MatchArm] = [Ast::MatchArm{pattern: pattern, body: body, guard: (Ast::Expr.Absent)}]
            panic_body: darray[Ast::Stmt] = [parser.expect_pattern_failure_stmt(expect_token.line)]
            arms.push(Ast::MatchArm{pattern: (Ast::Pattern.Wildcard), body: panic_body, guard: (Ast::Expr.Absent)})
            expect_match: Ast::Stmt = (Ast::Stmt.Match(value, arms, Ast::pos_of_token(expect_token)))
            if has_block:
                return expect_match
            else:
                expect_lowered: mutable darray[Ast::Stmt] = [expect_match]
                bindings: mutable darray[sview] = []
                pattern_binding_names(pattern, bindings)
                expect_lowered.extend([(Ast::Stmt.VarDecl(binding_name, (Ast::Expr.Invalid), (Ast::Expr.Absent), Ast::pos_of_token(expect_token))) for binding_name in bindings])
                return (Ast::Stmt.Block("expect", [], "", expect_lowered, Ast::pos_of_token(expect_token)))


        # A handler installation has a richer header than an ordinary permission grant. Keep
        # `Effect[T] with Handler(capture)` as one effect reference and parse the capture
        # expressions before the block body so the body parser can perform direct-call rewriting.
        def can_handler_clause_ahead(parser: Parser&) -> bool:
            false return if parser.peek() != TokenKind.Ident
            scan: mutable usize = 1
            depth: mutable int = 0
            while parser.peek_at(scan) != TokenKind.Eof |parser, scan, depth|:
                kind: TokenKind = parser.peek_at(scan)
                return true if depth == 0 and kind == TokenKind.With
                break if depth == 0 and (kind == TokenKind.Colon or kind == TokenKind.Newline)
                depth <- depth + 1 if kind == TokenKind.LParen or kind == TokenKind.LBracket or kind == TokenKind.LBrace
                depth <- depth - 1 if depth > 0 and (kind == TokenKind.RParen or kind == TokenKind.RBracket or kind == TokenKind.RBrace)
                scan <- scan + 1
            return false

        def handler_effect_trim_layout(effect_ref: sview) -> sview:
            start: mutable usize = 0
            finish: mutable usize = sview_len(effect_ref)
            while start < finish and (sview_at(effect_ref, start) == 32 or sview_at(effect_ref, start) == 9 or sview_at(effect_ref, start) == 13) |start, finish, effect_ref|:
                start <- start + 1.usize()
            while finish > start and (sview_at(effect_ref, finish - 1.usize()) == 32 or sview_at(effect_ref, finish - 1.usize()) == 9 or sview_at(effect_ref, finish - 1.usize()) == 13) |finish, start, effect_ref|:
                finish <- finish - 1.usize()
            return effect_ref[start:finish]

        # Consume a bracketed effect row as complete source spans. The ordinary block-prefix
        # scanner treats a bracket as a generic nesting delimiter, which is correct for
        # `can Writer[T]:` but loses the `via` dimension in `can[Writer[T] via Console.Write]:`.
        # This path keeps nested type brackets opaque while splitting only at row-level commas.
        def consume_block_effect_list(parser: lmut Parser, clause: mutable darray[sview]&) -> void:
            parser, _ <- parser.advance()                              # consume `[`
            item_start: mutable usize = parser.cursor().start.usize()
            depth: mutable int = 0
            item_has_tokens: mutable bool = false
            while parser.peek() != TokenKind.Eof |parser, item_start, depth, item_has_tokens, clause|:
                kind: TokenKind = parser.peek()
                if kind == TokenKind.RBracket and depth == 0:
                    if item_has_tokens:
                        clause.push(parser.span_view(item_start, parser.cursor().start.usize()))
                    parser, _ <- parser.advance()
                    return
                if kind == TokenKind.Comma and depth == 0:
                    if item_has_tokens:
                        clause.push(parser.span_view(item_start, parser.cursor().start.usize()))
                    parser, _ <- parser.advance()
                    item_start <- parser.cursor().start.usize()
                    item_has_tokens <- false
                else:
                    item_has_tokens <- true
                    depth <- depth + 1 if kind == TokenKind.LBracket or kind == TokenKind.LParen or kind == TokenKind.LBrace
                    depth <- depth - 1 if depth > 0 and (kind == TokenKind.RBracket or kind == TokenKind.RParen or kind == TokenKind.RBrace)
                    parser, _ <- parser.advance()

        # Fill only the trailing omitted captures whose handler declaration supplied a
        # default. The resulting arguments are ordinary AST expressions and are then
        # bound to lexical locals by the installation rewrite, so each default runs once
        # per installation. Required omissions remain absent for the semantic arity check.
        def materialize_handler_capture_defaults(parser: Parser&, handler_name: mutable sview&, arguments: mutable darray[Ast::Expr]&) -> void can[Memory.Allocate]:
            capture_index: mutable usize = 0
            owner_index: mutable usize = 0
            while owner_index < parser.handler_capture_owners.count |owner_index, capture_index, arguments|:
                if parser.handler_capture_owners[owner_index] == handler_name:
                    parameter: Ast::ParamDecl = parser.handler_capture_params[owner_index]
                    if capture_index >= arguments.count and parameter.has_default:
                        arguments.push(parameter.default_value)
                    capture_index <- capture_index + 1.usize()
                owner_index <- owner_index + 1.usize()

        def consume_can_handler_clause(parser: lmut Parser, clause: mutable darray[sview]&, effect_name: mutable sview&, handler_name: mutable sview&, arguments: mutable darray[Ast::Expr]&) -> bool:
            false return if not parser.can_handler_clause_ahead()
            # `prefixed_block_statement` is entered with the contextual `can` token still
            # under the cursor. The effect span begins after that marker, not at `can`.
            leading_can_token: Token = parser.cursor()
            parser, _ <- parser.advance() if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(leading_can_token, parser.source) == "can"
            effect_start_token: Token = parser.cursor()
            effect_name <- Lexer::text_or_empty(effect_start_token, parser.source)
            effect_start: usize = effect_start_token.start.usize()
            effect_end: mutable usize = effect_start
            depth: mutable int = 0
            while parser.peek() != TokenKind.Eof |parser, depth, effect_end|:
                kind: TokenKind = parser.peek()
                break if depth == 0 and kind == TokenKind.With
                break if depth == 0 and (kind == TokenKind.Colon or kind == TokenKind.Newline)
                current: Token = parser.cursor()
                effect_end <- current.start.usize() + current.length.usize()
                depth <- depth + 1 if kind == TokenKind.LParen or kind == TokenKind.LBracket or kind == TokenKind.LBrace
                depth <- depth - 1 if depth > 0 and (kind == TokenKind.RParen or kind == TokenKind.RBracket or kind == TokenKind.RBrace)
                parser, _ <- parser.advance()
            effect_ref: sview = parser.span_view(effect_start, effect_end)
            clause.push(effect_ref) if effect_end > effect_start
            # Preserve the installation's handler identity in the side table. The compact
            # stage1 statement node intentionally remains the ordinary Block shape; semantic
            # validation uses this source-location-independent record instead.
            parser, _ <- parser.expect(TokenKind.With)
            rebind handler_ident: Token, parser = parser.expect(TokenKind.Ident)
            handler_name <- Lexer::text_or_empty(handler_ident, parser.source)
            installed_handler_value: sview = Lexer::text_or_empty(handler_ident, parser.source)
            # The first annotation records the handler after `with` is consumed. Keeping all
            # annotation fields immutable avoids storing a view typed as a mutable reference.
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__effect_install", name: installed_handler_value, line: effect_start_token.line})
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__effect_install_effect", name: effect_ref, line: effect_start_token.line})
            # Installing a static handler also installs the concrete permissions used
            # by its operation methods. Scan the side table by index rather than using
            # the accumulator form here: the latter aliases the mutable `clause` darray
            # through the generated loop frame and stage1 can reclaim its backing region
            # while the handler header is still being parsed.
            annotation_index: mutable usize = 0
            while annotation_index < parser.enum_annotations.count |parser, annotation_index, clause, handler_name|:
                handler_annotation: Ast::EnumAnnotation = parser.enum_annotations[annotation_index]
                annotation_index <- annotation_index + 1
                if handler_annotation.owner == handler_name and (handler_annotation.line == 3900000084 or handler_annotation.line == 3900000095):
                    target_realization: sview = handler_effect_via(handler_annotation.name)
                    clause.push(target_realization) if target_realization != ""
                continue if handler_annotation.owner != handler_name or handler_annotation.line != 3900000087
                realization: sview = handler_effect_via(handler_annotation.name)
                if realization != "":
                    clause.push(realization)
                else:
                    is_abstract: bool = any effect_annotation in parser.enum_annotations where effect_annotation.owner == "__effect_decl" and effect_annotation.name == handler_effect_family(handler_annotation.name)
                    clause.push(handler_annotation.name) if not is_abstract
            if parser.peek() == TokenKind.LParen:
                parser, _ <- parser.advance()
                while parser.peek() != TokenKind.RParen and parser.peek() != TokenKind.Eof |parser, arguments|:
                    rebind argument_opt: Ast::Expr?, parser = parser.expression()
                    arguments.push(argument) if argument_opt is argument
                    rebind accepted_comma: bool, parser = parser.accept(TokenKind.Comma)
                    break if not accepted_comma
                parser, _ <- parser.expect(TokenKind.RParen)
            parser <- parser.materialize_handler_capture_defaults(handler_name, arguments)
            # Keep the supplied count paired with this installation. The source AST
            # intentionally remains the ordinary Block shape; this side row is only
            # compile-time ABI validation and is searched forward from the matching
            # installation annotation, so nested capture expressions remain ordered.
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__effect_install_capture_count", name: installed_handler_value, line: arguments.count.u32()})
            return true

        # The unbracketed block form has the same row grammar as a postfix grant:
        # `can Tick via Console.Write:` is one relation, not the three entries
        # `Tick`, `via`, and `Console.Write`. Only depth-zero `via` selects this
        # path, so a word inside `Effect[T]` remains part of its specialization.
        def can_via_clause_ahead(parser: Parser&) -> bool:
            false return if parser.peek() != TokenKind.Ident
            leading_can: Token = parser.cursor()
            false return if Lexer::text_or_empty(leading_can, parser.source) != "can"
            scan: mutable usize = 1
            depth: mutable int = 0
            while parser.peek_at(scan) != TokenKind.Eof |parser, scan, depth|:
                kind: TokenKind = parser.peek_at(scan)
                return false if depth == 0 and (kind == TokenKind.Colon or kind == TokenKind.Newline)
                if depth == 0 and kind == TokenKind.Ident and Lexer::text_or_empty(parser.tokens[parser.position + scan], parser.source) == "via":
                    return true
                depth <- depth + 1 if kind == TokenKind.LParen or kind == TokenKind.LBracket or kind == TokenKind.LBrace
                depth <- depth - 1 if depth > 0 and (kind == TokenKind.RParen or kind == TokenKind.RBracket or kind == TokenKind.RBrace)
                scan <- scan + 1.usize()
            return false

        def consume_unbracketed_via_effect(parser: lmut Parser, clause: mutable darray[sview]&) -> void:
            parser, _ <- parser.advance()                         # consume `can`
            effect_start: mutable usize = parser.cursor().start.usize()
            depth: mutable int = 0
            while parser.peek() != TokenKind.Eof |parser, depth, effect_start|:
                kind: TokenKind = parser.peek()
                if depth == 0 and (kind == TokenKind.Colon or kind == TokenKind.Newline):
                    clause.push(handler_effect_trim_layout(parser.span_view(effect_start, parser.cursor().start.usize()))) if parser.cursor().start.usize() > effect_start
                    break
                if depth == 0 and kind == TokenKind.Comma:
                    clause.push(handler_effect_trim_layout(parser.span_view(effect_start, parser.cursor().start.usize()))) if parser.cursor().start.usize() > effect_start
                    parser, _ <- parser.advance()
                    effect_start <- parser.cursor().start.usize()
                    continue
                current: Token = parser.cursor()
                depth <- depth + 1 if kind == TokenKind.LParen or kind == TokenKind.LBracket or kind == TokenKind.LBrace
                depth <- depth - 1 if depth > 0 and (kind == TokenKind.RParen or kind == TokenKind.RBracket or kind == TokenKind.RBrace)
                parser, _ <- parser.advance()

        # Rebuild statements with handler operation calls normalized. This is the statement
        # counterpart to rewrite_handler_expression; the AST is value-shaped, so each nested
        # body is rebuilt into the same ordinary Stmt variants rather than introducing a runtime
        # handler node.
        def rewrite_handler_statements(parser: lmut Parser, statements: darray[Ast::Stmt], effect_name: sview, handler_name: sview, captures: darray[Ast::Expr]) -> darray[Ast::Stmt]:
            can Memory.Allocate, Abort.Panic:
                rewritten: mutable darray[Ast::Stmt] = []
                for statement in statements |rewritten, parser|:
                    match statement:
                        Stmt.Expr(expression, statement_pos):
                            rebind rewritten_expression: Ast::Expr, parser = parser.rewrite_handler_expression(expression, effect_name, handler_name, captures)
                            rewritten.push(Ast::Stmt.Expr(rewritten_expression, statement_pos))
                        Stmt.VarDecl(name, type_expression, value, statement_pos):
                            rebind rewritten_type: Ast::Expr, parser = parser.rewrite_handler_expression(type_expression, effect_name, handler_name, captures)
                            rebind rewritten_value: Ast::Expr, parser = parser.rewrite_handler_expression(value, effect_name, handler_name, captures)
                            rewritten.push(Ast::Stmt.VarDecl(name, rewritten_type, rewritten_value, statement_pos))
                        Stmt.Assign(target, operator, value, statement_pos):
                            rebind rewritten_target: Ast::Expr, parser = parser.rewrite_handler_expression(target, effect_name, handler_name, captures)
                            rebind rewritten_value: Ast::Expr, parser = parser.rewrite_handler_expression(value, effect_name, handler_name, captures)
                            rewritten.push(Ast::Stmt.Assign(rewritten_target, operator, rewritten_value, statement_pos))
                        Stmt.If(condition, then_body, else_body, statement_pos):
                            rebind rewritten_condition: Ast::Expr, parser = parser.rewrite_handler_expression(condition, effect_name, handler_name, captures)
                            rebind rewritten_then: darray[Ast::Stmt], parser = parser.rewrite_handler_statements(then_body, effect_name, handler_name, captures)
                            rebind rewritten_else: darray[Ast::Stmt], parser = parser.rewrite_handler_statements(else_body, effect_name, handler_name, captures)
                            rewritten.push(Ast::Stmt.If(rewritten_condition, rewritten_then, rewritten_else, statement_pos))
                        Stmt.While(condition, body, statement_pos):
                            rebind rewritten_condition: Ast::Expr, parser = parser.rewrite_handler_expression(condition, effect_name, handler_name, captures)
                            rebind rewritten_body: darray[Ast::Stmt], parser = parser.rewrite_handler_statements(body, effect_name, handler_name, captures)
                            rewritten.push(Ast::Stmt.While(rewritten_condition, rewritten_body, statement_pos))
                        Stmt.For(bind, variables, iterable, body, statement_pos):
                            rebind rewritten_iterable: Ast::Expr, parser = parser.rewrite_handler_expression(iterable, effect_name, handler_name, captures)
                            rebind rewritten_body: darray[Ast::Stmt], parser = parser.rewrite_handler_statements(body, effect_name, handler_name, captures)
                            rewritten.push(Ast::Stmt.For(bind, variables, rewritten_iterable, rewritten_body, statement_pos))
                        Stmt.Block(kind, clause, binding, body, statement_pos):
                            rebind rewritten_body: darray[Ast::Stmt], parser = parser.rewrite_handler_statements(body, effect_name, handler_name, captures)
                            rewritten.push(Ast::Stmt.Block(kind, clause, binding, rewritten_body, statement_pos))
                        Stmt.Return(value, statement_pos):
                            if value is returned_value:
                                rebind rewritten_value: Ast::Expr, parser = parser.rewrite_handler_expression(returned_value, effect_name, handler_name, captures)
                                rewritten.push(Ast::Stmt.Return(rewritten_value, statement_pos))
                            else:
                                rewritten.push(statement)
                        Stmt.Match(scrutinee, arms, statement_pos):
                            rebind rewritten_scrutinee: Ast::Expr, parser = parser.rewrite_handler_expression(scrutinee, effect_name, handler_name, captures)
                            rewritten_arms: mutable darray[Ast::MatchArm] = []
                            for arm in arms |rewritten_arms, parser|:
                                rebind rewritten_guard: Ast::Expr, parser = parser.rewrite_handler_expression(arm.guard, effect_name, handler_name, captures)
                                rebind rewritten_body: darray[Ast::Stmt], parser = parser.rewrite_handler_statements(arm.body, effect_name, handler_name, captures)
                                rewritten_arms.push(Ast::MatchArm{pattern: arm.pattern, body: rewritten_body, guard: rewritten_guard})
                            rewritten.push(Ast::Stmt.Match(rewritten_scrutinee, rewritten_arms, statement_pos))
                        Stmt.Contract(kind, expression, statement_pos):
                            rebind rewritten_expression: Ast::Expr, parser = parser.rewrite_handler_expression(expression, effect_name, handler_name, captures)
                            rewritten.push(Ast::Stmt.Contract(kind, rewritten_expression, statement_pos))
                        _:
                            rewritten.push(statement)
                return rewritten

        def prefixed_block_statement(parser: lmut Parser) -> Ast::Stmt?:
            line: u32 = parser.cursor().line

            # Classify the clause category from the leading token so region/effect
            # passes can dispatch structurally. Keyword-token prefixes map to their
            # spelling; contextual-keyword prefixes (`can`, `region`, …) are Idents
            # and carry their text directly; a bare `slot:` success arm is "arm".
            first_kind: TokenKind = parser.peek()
            first_token: Token = parser.cursor()
            is_arm: bool = first_kind == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon and parser.peek_at(2) == TokenKind.Newline
            # `region NAME(...)`: register NAME so type-position uses of the region
            # (`Box[i64, scratch]`, `@scratch` bindings) resolve.
            is_region_block: bool = first_kind == TokenKind.Ident and Lexer::text_or_empty(first_token, parser.source) == "region" and parser.peek_at(1) == TokenKind.Ident
            region_named_token: Token = parser.tokens[parser.position + 1] if is_region_block else first_token
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: Lexer::text_or_empty(region_named_token, parser.source), name: "__region_name", line: line}) if is_region_block
            # is_arm requires Ident, so the arm guard lives inside the Ident arm.
            block_kind: sview = match first_kind:
                TokenKind.With:    "with"
                TokenKind.Region:  "region"
                TokenKind.Try:     "try"
                TokenKind.Catch:   "catch"
                TokenKind.In:      "in"
                TokenKind.Error:   "error"
                TokenKind.Static:  "static"
                TokenKind.Ident:   "arm" if is_arm else Lexer::text_or_empty(first_token, parser.source)
                _:                 ""

            # Capture the name a binding-introducing prefix brings into scope:
            # `error IDENT:` binds the error value; a success arm `IDENT:` binds the
            # result. Everything else binds nothing.
            binding: mutable sview = ""
            match first_kind:
                TokenKind.Error:
                    parser, _ <- parser.advance()                       # `error`
                    if parser.peek() == TokenKind.Ident:
                        error_token: Token = parser.cursor()
                        binding <- Lexer::text_or_empty(error_token, parser.source)
                _:
                    binding <- Lexer::text_or_empty(first_token, parser.source) if is_arm

            # Collect the prefix's identifier tokens (in order) up to the block colon:
            # granted effect names (`can Mem.Allocate:`) or a region name
            # (`region scratch(…):`). The leading clause keyword and the arm binding are
            # already captured above, so skip identifiers at position 0.
            clause: mutable darray[sview] = []
            installed_effect: mutable sview = ""
            installed_handler: mutable sview = ""
            installed_arguments: mutable darray[Ast::Expr] = []
            is_handler_install: mutable bool = false
            if block_kind == "can":
                rebind consumed_handler_clause: bool, parser = parser.consume_can_handler_clause(clause, installed_effect, installed_handler, installed_arguments)
                is_handler_install <- consumed_handler_clause
                parser <- parser.consume_unbracketed_via_effect(clause) if not is_handler_install and parser.can_via_clause_ahead()
            region_capacity_start: mutable usize = 0
            pool_capacity_start: mutable usize = 0
            # Whether the bracket currently open is a block's EFFECT LIST (`can [A, B]:`,
            # `trusted [Unsafe.PointerCast]:`) rather than a type argument. Clause identifiers
            # are otherwise collected at depth 0 only, so the bracketed spelling reached the
            # AST with an EMPTY clause and every consumer read it as granting nothing — which
            # is why `trusted [Global.Read]:` could not be told from `trusted:`. The
            # discriminator is position, not spelling: an effect list opens immediately after
            # the block keyword, before any clause entry, so `can Writer[sview]:` (where
            # `Writer` is already collected) keeps its type argument out of the clause.
            effect_list: mutable bool = false
            # Contextual block keywords are themselves Ident tokens. Detect the bracket
            # immediately after that leading token before the general scanner skips it.
            if first_kind == TokenKind.Ident and (block_kind == "can" or block_kind == "trusted") and parser.peek_at(1) == TokenKind.LBracket:
                parser, _ <- parser.advance()
            if parser.peek() == TokenKind.LBracket and clause.count == 0 and (block_kind == "can" or block_kind == "trusted"):
                parser <- parser.consume_block_effect_list(clause)
            while not is_handler_install and parser.peek() != TokenKind.Eof |parser, effect_list, depth: int = 0, first: bool = true|:
                kind: TokenKind = parser.peek()
                match kind:
                    TokenKind.LParen | TokenKind.LBracket:
                        # `with arena scratch(4096) as owner:` carries its capacity exactly like
                        # `region scratch(4096)`, so it is captured the same way -- without this
                        # the clause held only the names and the backend had no size to open an
                        # arena with.
                        region_capacity_start <- parser.cursor().start.usize() + 1 if (block_kind == "region" or block_kind == "with") and kind == TokenKind.LParen and depth == 0
                        pool_capacity_start <- parser.cursor().start.usize() + 1 if (block_kind == "pool" or block_kind == "nursery" or block_kind == "scope") and kind == TokenKind.LParen and depth == 0
                        effect_list <- true if kind == TokenKind.LBracket and depth == 0 and clause.count == 0 and (block_kind == "can" or block_kind == "trusted")
                        depth <- depth + 1
                        parser, _ <- parser.advance()
                    TokenKind.RParen | TokenKind.RBracket:
                        if (block_kind == "region" or block_kind == "with") and kind == TokenKind.RParen and depth == 1 and region_capacity_start > 0:
                            capacity_end: usize = parser.cursor().start.usize()
                            clause.push(parser.span_view(region_capacity_start, capacity_end))
                            region_capacity_start <- 0
                        if (block_kind == "pool" or block_kind == "nursery" or block_kind == "scope") and kind == TokenKind.RParen and depth == 1 and pool_capacity_start > 0:
                            pool_capacity_end: usize = parser.cursor().start.usize()
                            clause.push(parser.span_view(pool_capacity_start, pool_capacity_end))
                            pool_capacity_start <- 0
                        depth <- depth - 1
                        effect_list <- false if kind == TokenKind.RBracket and depth == 0
                        parser, _ <- parser.advance()
                    TokenKind.Colon | TokenKind.Newline if depth == 0:
                        break
                    TokenKind.As if depth == 0 and (block_kind == "can" or block_kind == "lock" or block_kind == "with"):
                        # `can Effects as Family:` records the effect-family cast
                        # target; `lock mutex as guard:` records the guard binding;
                        # `with arena scratch(N) as owner:` binds the resource handle.
                        parser, _ <- parser.advance()
                        rebind binding_token: Token, parser = parser.expect(TokenKind.Ident)
                        binding <- Lexer::text_or_empty(binding_token, parser.source)
                    TokenKind.Ident if (depth == 0 and not first) or (depth == 1 and effect_list):
                        # Preserve region's contextual `using` marker separately so the
                        # clause side-table retains allocator intent; qualified effect
                        # paths remain one entry.
                        clause_token: Token = parser.cursor()
                        if block_kind == "region" and Lexer::text_or_empty(clause_token, parser.source) == "using":
                            clause.push("using")
                            parser, _ <- parser.advance()
                        else:
                            rebind dotted_clause_name: sview, parser = parser.parse_dotted_name()
                            clause.push(dotted_clause_name)
                            # `pool workers(N):` binds the named pool handle in its
                            # body. Preserve it in the generic block binding slot.
                            binding <- dotted_clause_name if block_kind == "pool" and binding == ""
                    _:
                        first <- false
                        parser, _ <- parser.advance()

            if parser.peek() != TokenKind.Colon:
                # Region declarations are the only currently recognized prefix whose
                # no-block form is unambiguously invalid at this frontend layer. Keep
                # legacy recovery for other keyword-shaped expression forms until their
                # dedicated AST nodes are ported.
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, first_token) if block_kind == "region"
                # Keep the existing recovery node shape after recording the error;
                # downstream walkers already treat this expression as non-executable.
                return (Ast::Stmt.Expr((Ast::Expr.Invalid), Ast::pos_at_line(line)))

            pool_scope: bool = block_kind == "pool" or block_kind == "nursery"
            parser.active_pool_depth <- parser.active_pool_depth + 1 if pool_scope
            parser.local_region_annotations <- parser.local_region_annotations.push(Ast::LocalRegionAnnotation{name: "__region_local", type_expression: (Ast::Expr.Invalid), region: clause[0], line: line}) if block_kind == "region" and clause.count > 0
            # A `can ComplexFlow:` grant exempts every block-`if` in its body (transitively)
            # from the flow-strict census. OR into the flag so nested non-ComplexFlow blocks
            # keep the exemption; restore afterwards.
            is_complex_flow: bool = block_kind == "can" and any grant in clause where grant == "ComplexFlow"
            saved_complex_flow: bool = parser.in_complex_flow
            parser.in_complex_flow <- parser.in_complex_flow or is_complex_flow
            saved_effect_name: sview = parser.active_effect_name
            saved_handler_name: sview = parser.active_handler_name
            installed_effect_value: sview = clause[0] if is_handler_install and clause.count > 0 else ""
            # Materialize handler captures as ordinary block locals before the
            # handler context becomes active. Every operation call then receives
            # an identifier, so a capture expression is evaluated exactly once
            # per installation rather than once per operation.
            handler_capture_bindings: mutable darray[Ast::Stmt] = []
            handler_capture_arguments: mutable darray[Ast::Expr] = []
            if is_handler_install:
                for installed_argument in installed_arguments |parser, handler_capture_bindings, handler_capture_arguments|:
                    capture_name: sview = parser.handler_capture_name(installed_handler, line)
                    handler_capture_bindings.push(Ast::Stmt.VarDecl(capture_name, (Ast::Expr.Invalid), installed_argument, Ast::pos_at_line(line)))
                    handler_capture_arguments.push(Ast::Expr.Ident(capture_name, Ast::pos_at_line(line)))
            parser.active_effect_name <- installed_effect_value if is_handler_install
            parser.active_handler_name <- installed_handler if is_handler_install
            saved_handler_argument_start: usize = parser.active_handler_argument_start
            saved_handler_argument_count: usize = parser.active_handler_argument_count
            installed_handler_argument_start: usize = parser.active_handler_arguments.count
            if is_handler_install:
                for capture_argument in handler_capture_arguments |parser|:
                    parser.active_handler_arguments <- parser.active_handler_arguments.push(capture_argument)
            parser.active_handler_argument_start <- installed_handler_argument_start if is_handler_install
            parser.active_handler_argument_count <- handler_capture_arguments.count if is_handler_install
            rebind parsed_body: darray[Ast::Stmt], parser = parser.parse_block()
            body: mutable darray[Ast::Stmt] = parsed_body
            if is_handler_install:
                rebind normalized_body: darray[Ast::Stmt], parser = parser.rewrite_handler_statements(body, installed_effect_value, installed_handler, handler_capture_arguments)
                body <- normalized_body
                # If the inner handler is partial, a second normalization pass
                # resolves still-abstract operations against the enclosing
                # handler. This is compile-time forwarding: the final AST has
                # one direct hidden call and no runtime handler chain.
                if saved_handler_name != "" and saved_effect_name != "":
                    fallback_arguments: mutable darray[Ast::Expr] = []
                    fallback_index: mutable usize = saved_handler_argument_start
                    fallback_end: usize = fallback_index + saved_handler_argument_count
                    while fallback_index < fallback_end |parser, fallback_index, fallback_arguments|:
                        fallback_arguments.push(parser.active_handler_arguments[fallback_index])
                        fallback_index <- fallback_index + 1.usize()
                    rebind forwarded_body: darray[Ast::Stmt], parser = parser.rewrite_handler_statements(body, saved_effect_name, saved_handler_name, fallback_arguments)
                    body <- forwarded_body
                if handler_capture_bindings.count > 0.usize():
                    handler_capture_bindings.extend(body)
                    body <- handler_capture_bindings
            parser.active_effect_name <- saved_effect_name
            parser.active_handler_name <- saved_handler_name
            parser.active_handler_argument_start <- saved_handler_argument_start
            parser.active_handler_argument_count <- saved_handler_argument_count
            parser.in_complex_flow <- saved_complex_flow
            parser.active_pool_depth <- parser.active_pool_depth - 1 if pool_scope
            return (Ast::Stmt.Block(block_kind, clause, binding, body, Ast::pos_at_line(line)))
