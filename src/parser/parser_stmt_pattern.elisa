extend Parser:
    private:
        # Collect every binding introduced by a destructuring pattern. Used by
        # statement-level `move ... as ...`, whose names continue in the surrounding
        # scope (unlike an ordinary match arm). Composite payloads are snapshotted
        # before recursive node reads invalidate their borrowed side-tables.
        def pattern_binding_names(pattern: Ast::Pattern, names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Ast::Pattern.Binding(name):
                        names.push(name)
                    Ast::Pattern.TypeBind(type_name, binder):
                        names.push(binder)
                    Ast::Pattern.Variant(path, fields) | Ast::Pattern.Struct(path, fields):
                        handles: darray[Ast::Pattern] = [field for field in fields]
                        pattern_binding_names_many(handles, names)
                    Ast::Pattern.Field(selector, inner):
                        handles: darray[Ast::Pattern] = [element for element in inner]
                        pattern_binding_names_many(handles, names)
                    Ast::Pattern.Tuple(elements) | Ast::Pattern.Or(elements):
                        handles: darray[Ast::Pattern] = [element for element in elements]
                        pattern_binding_names_many(handles, names)
                    Ast::Pattern.As(name, inner):
                        names.push(name)
                        handles: darray[Ast::Pattern] = [element for element in inner]
                        pattern_binding_names_many(handles, names)
                    Ast::Pattern.Rest(name):
                        names.push(name) if name != ""
                    _:
                        pass

        # Walk child patterns with an explicit machine state. The binding sink remains the
        # driven resource, so recursive collection has no hidden sequential loop.
        def pattern_binding_names_many(handles: darray[Ast::Pattern], names: mutable darray[sview]&) -> void:
            machine over handles for handle in handles:
                state Scan
                start Scan

                Scan, _:
                    pattern_binding_names(handle, names)
                    -> Scan


        # Qualified head path of a move pattern (`Expr.Int`), or "" for a plain
        # struct/name pattern. Stored on the transparent move block for semantic
        # packed-Store validation without re-borrowing nested Match arm payloads.
        def move_pattern_head_path(pattern: Ast::Pattern) -> sview:
            can Abort.Panic:
                match pattern:
                    Ast::Pattern.Variant(path, fields):
                        return path
                    Ast::Pattern.As(name, inner):
                        move_pattern_head_path(inner[0]) return if inner.count > 0
                    _:
                        pass
                return ""



        # `match SCRUTINEE:` with indented `PATTERN: <block>` arms. The scrutinee and each
        # arm's body are fully parsed; the pattern is captured as its raw source text
        # (exotic/recovery patterns may still use Pattern.Other). Each arm owns its body
        # `darray[Stmt]`, and the arm list becomes the Match node's `arms` side-table.
        # Build a source view over the byte span [start, end) via a synthetic span
        # token (direct slicing of a raw u8& is not permitted here).
        def span_view(parser: Parser&, start: usize, end: usize) -> sview:
            span_token: mutable Token = zeroed
            span_token.start <- start.u32()
            span_token.length <- (end - start).u32()
            return Lexer::text_or_empty(span_token, parser.source)


        # Consume tokens up to an arm's block colon (paren/bracket/brace-balanced so
        # `A.B(x)` / `{a, b}` stay whole) and return their raw source span. Used as the
        # lossless fallback for pattern forms not yet structured.
        def capture_pattern_span(parser: lmut Parser) -> sview:
            pattern_start: usize = parser.cursor().start.usize()
            start_position: usize = parser.position
            machine over parser.position while true:
                state Scan(depth: int)
                start Scan(0)

                # Stop at the arm colon / end of line, and ALSO at an unbalanced closer — a
                # closer at depth 0 belongs to the enclosing construct.
                Scan(depth), _ if depth == 0 and (parser.peek() == TokenKind.Colon or parser.peek() == TokenKind.Newline or parser.peek() == TokenKind.RParen or parser.peek() == TokenKind.RBracket or parser.peek() == TokenKind.RBrace) or parser.peek() == TokenKind.Eof:
                    break

                Scan(depth), _ if parser.peek() == TokenKind.LParen or parser.peek() == TokenKind.LBracket or parser.peek() == TokenKind.LBrace:
                    parser.position <- parser.position + 1
                    -> Scan(depth + 1)

                Scan(depth), _ if parser.peek() == TokenKind.RParen or parser.peek() == TokenKind.RBracket or parser.peek() == TokenKind.RBrace:
                    parser.position <- parser.position + 1
                    -> Scan(depth - 1)

                Scan(depth), _:
                    parser.position <- parser.position + 1
                    -> Scan(depth)

            pattern_end: mutable usize = pattern_start
            if parser.position > start_position:
                last_token: Token = parser.tokens[parser.position - 1]
                pattern_end <- last_token.start.usize() + last_token.length.usize()
            return parser.span_view(pattern_start, pattern_end)


        # An or-pattern `A | B | …` / `A or B or …` (or just a single primary). The lexer
        # already distinguishes boolean `or`; inside a pattern it is an alternative token.
        # Previously the parser stopped after A and silently ignored the remaining alternatives,
        # so a source arm compiled as though only its first variant had been written.
        def parse_pattern_or(parser: lmut Parser) -> Ast::Pattern:
            rebind first: Ast::Pattern, parser = parser.parse_pattern_primary()
            first return if parser.peek() != TokenKind.Pipe and parser.peek() != TokenKind.Or
                
            options: mutable darray[Ast::Pattern] = [first]
            machine over parser.position while parser.peek() == TokenKind.Pipe or parser.peek() == TokenKind.Or:
                state More
                start More

                More, _:
                    parser.position <- parser.position + 1
                    options.push(parser.parse_pattern_primary())
                    -> More
            return (Ast::Pattern.Or(options))


        # stage0 parity (parseMatchPatternNoPipe + parseTopLevelMatchArmAlternatives): at the
        # TOP level of an arm header the two spellings are NOT synonyms.
        #
        #   A(x) | B(y):      `|` separates SIBLING ARMS. The parser fans the header out into
        #                     one arm per alternative, each with its own copy of the shared
        #                     body, so the alternatives never have to agree on binder names.
        #   A(x) or B(y):     `or` builds ONE Pattern.Or arm. stage0 then REFUSES it whenever
        #                     an alternative binds a name, because it cannot merge alias and
        #                     borrow facts across the alternatives
        #                     (check_or_pattern_bindings: TopLevelOrPatternBindsNames).
        #
        # Nested payload patterns still read BOTH spellings as one or-group — that is what
        # stage0's parseNestedOrMatchPattern does — so parse_pattern_or above is unchanged and
        # keeps serving every nested site.
        #
        # Reading `|` as an arm-level Pattern.Or (what stage1 did before) conflated the two in
        # both directions: a stage0-legal `A(x) | B(y):` arm looked like the unsupported `or`
        # form, and an `A(x) or B(y):` arm that stage0 refuses was silently accepted.
        def parse_pattern_no_pipe(parser: lmut Parser) -> Ast::Pattern:
            rebind first: Ast::Pattern, parser = parser.parse_pattern_or_word()
            first return if parser.peek() != TokenKind.Comma

            elements: mutable darray[Ast::Pattern] = [first]
            machine over parser.position while true:
                state More
                state Element
                start More

                More, _ if parser.peek() != TokenKind.Comma:
                    break

                More, _:
                    parser.position <- parser.position + 1
                    -> Element

                Element, _ if parser.peek() == TokenKind.Colon or parser.peek() == TokenKind.Newline:
                    break

                Element, _:
                    elements.push(parser.parse_pattern_or_word())
                    -> More
            return (Ast::Pattern.Tuple(elements))


        # One arm-level alternative: a primary, optionally joined to further primaries by the
        # WORD `or`. A `|` is left for parse_top_level_patterns to fan out.
        def parse_pattern_or_word(parser: lmut Parser) -> Ast::Pattern:
            rebind first: Ast::Pattern, parser = parser.parse_pattern_primary()
            first return if parser.peek() != TokenKind.Or

            options: mutable darray[Ast::Pattern] = [first]
            machine over parser.position while parser.peek() == TokenKind.Or:
                state More
                start More

                More, _:
                    parser.position <- parser.position + 1
                    options.push(parser.parse_pattern_primary())
                    -> More
            return (Ast::Pattern.Or(options))


        # `PATTERN (| PATTERN)*` — every top-level alternative of one arm header, appended to
        # a caller-owned buffer. A separating `|` may sit on a continuation line, so a layout
        # Newline in front of it is skipped (the rule parse_with_arm already follows).
        def parse_top_level_patterns(parser: lmut Parser, out: mutable darray[Ast::Pattern]&) -> void:
            rebind first: Ast::Pattern, parser = parser.parse_pattern_no_pipe()
            out.push(first)
            machine over parser.position while parser.next_nonnewline_is_pipe():
                state More
                start More

                More, _:
                    parser <- parser.skip_newlines()
                    parser.position <- parser.position + 1                       # `|`
                    rebind alternative: Ast::Pattern, parser = parser.parse_pattern_no_pipe()
                    out.push(alternative)
                    -> More
            return


        # Push one fanned-out sibling arm. Every alternative gets its OWN copy of the shared
        # body: arms are rewritten independently downstream, so they must not alias one buffer.
        def append_arm_alternative(alternative: Ast::Pattern, body: darray[Ast::Stmt], guard: Ast::Expr, arm_head: Token, arms_buffer: mutable darray[Ast::MatchArm]&) -> void:
            copied: mutable darray[Ast::Stmt] = []
            copied.extend(body)
            arms_buffer.push(Ast::MatchArm{pattern: alternative, body: copied, guard: guard, pos: Ast::pos_of_token(arm_head)})


        # Whether `pattern` introduces ANY binding name. A deliberate structural mirror of
        # the semantic layer's collect_pattern_binding_names: the arm-level or-pattern rule
        # is purely syntactic, so deciding it here — where the arm head token is still in
        # hand — cannot disagree with the analyzer on a real program.
        def pattern_binds_any_name(pattern: Ast::Pattern) -> bool:
            can Abort.Panic:
                match pattern:
                    Ast::Pattern.Binding(binding_name):
                        return binding_name != "" and binding_name != "_"
                    Ast::Pattern.TypeBind(bound_type_name, binder_name):
                        return binder_name != "" and binder_name != "_"
                    Ast::Pattern.As(as_name, as_inner):
                        true return if as_name != "" and as_name != "_"
                        for as_inner_pattern in as_inner:
                            true return if pattern_binds_any_name(as_inner_pattern)
                        return false
                    Ast::Pattern.Variant(variant_path, variant_fields):
                        for variant_field in variant_fields:
                            true return if pattern_binds_any_name(variant_field)
                        return false
                    Ast::Pattern.Struct(struct_path, struct_fields):
                        for struct_field in struct_fields:
                            true return if pattern_binds_any_name(struct_field)
                        return false
                    Ast::Pattern.Field(field_selector, field_inner):
                        for field_inner_pattern in field_inner:
                            true return if pattern_binds_any_name(field_inner_pattern)
                        return false
                    Ast::Pattern.Tuple(tuple_elements):
                        for tuple_element in tuple_elements:
                            true return if pattern_binds_any_name(tuple_element)
                        return false
                    Ast::Pattern.Or(nested_options):
                        for nested_option in nested_options:
                            true return if pattern_binds_any_name(nested_option)
                        return false
                    _:
                        return false
                return false


        # Record the arm HEAD span when this arm's top-level pattern is an `or` that binds a
        # name — the span stage0 reports for "top-level or-pattern alternatives that bind
        # names are not supported". Only the WORD `or` builds a `Pattern.Or` at arm level
        # (`|` fans out into sibling arms in parse_top_level_patterns), so a legal
        # `A(x) | B(y):` arm is never recorded.
        #
        # The span lives in scalar File columns rather than in `MatchArm.pos` because that
        # field does not survive into the semantic layer for a match STATEMENT, only for a
        # match EXPRESSION; reporting from here is position-exact for both.
        def note_or_arm_binding(parser: lmut Parser, alternative: Ast::Pattern, arm_head: Token) -> void:
            can Memory.Allocate, Abort.Panic:
                binds: mutable bool = false
                match alternative:
                    Ast::Pattern.Or(recorded_options):
                        for recorded_option in recorded_options |binds|:
                            binds <- true if pattern_binds_any_name(recorded_option)
                    _:
                        pass
                return if not binds
                parser.or_arm_binding_lines <- parser.or_arm_binding_lines.push(arm_head.line)
                parser.or_arm_binding_columns <- parser.or_arm_binding_columns.push(arm_head.column)
                parser.or_arm_binding_end_columns <- parser.or_arm_binding_end_columns.push(arm_head.column + arm_head.length)
                return


        # Capture a range's upper literal, preserving a unary minus as part of the
        # source span (`-5..<-1`). Stage0 parses the bound as a value expression rather
        # than treating the minus as a separate pattern token.
        def parse_pattern_range_hi(parser: lmut Parser) -> sview:
            hi_start: Token = parser.cursor()
            if parser.peek() == TokenKind.Minus:
                parser, _ <- parser.advance()
                rebind magnitude_token: Token, parser = parser.advance()
                hi_end: usize = magnitude_token.start.usize() + magnitude_token.length.usize()
                return parser.span_view(hi_start.start.usize(), hi_end)
            rebind hi_token: Token, parser = parser.advance()
            # CharLit interiors expand to quoted spans (see CharLit arm of parse_pattern_primary).
            parser.span_view(hi_token.start.usize() - 1, hi_token.start.usize() + hi_token.length.usize() + 1) return if hi_token.kind == TokenKind.CharLit and hi_token.start.usize() > 0
            return Lexer::text_or_empty(hi_token, parser.source)


        # Catch expressions reuse the shared arm-block parser, but unlike `match`
        # they require a non-error-binding success arm first. Stage0 rejected a
        # leading `error NAME:` here so we mirror that check after the shared parse.
        def parse_catch_arm_block(parser: lmut Parser, catch_token: Token) -> darray[Ast::MatchArm]:
            # Parse directly into this frame's destination. A shallow copy of MatchArm
            # is not enough: its packed Pattern may carry a payload-bearing Variant, and
            # copying the arm after parse_arm_block returns can lose that payload under
            # stage1's region/side-table lowering. The catch validator and the eventual
            # Match node must observe the same arm values that were parsed.
            arms_buffer: mutable darray[Ast::MatchArm] = []
            parser <- parser.parse_arm_block_into(arms_buffer)
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, catch_token) if arms_buffer.count == 0
            arms_buffer return if arms_buffer.count == 0
            match arms_buffer[0].pattern:
                Ast::Pattern.TypeBind(type_name, binder):
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, catch_token) if type_name == "error"
                _:
                    pass
            return arms_buffer


        # A primary pattern: wildcard, literal, bare binding, (qualified) variant,
        # struct pattern, or a category arm with a binder (`Type s`).
        def parse_pattern_primary(parser: lmut Parser) -> Ast::Pattern:
            token: Token = parser.cursor()
            kind: TokenKind = parser.peek()

            # Dispatch on the lead token kind: literal (or docs/122 §5.2 range), the
            # `error NAME` catch-arm binder, the `^name` pin pattern (guarded — only
            # when a binding name follows), identifier-headed forms, or (default)
            # anything exotic captured losslessly.
            match kind:
                # List-pattern rest: `...rest` binds the unmatched tail, while bare `...`
                # is a discard-only tail marker. The tuple parser keeps this as one element.
                TokenKind.Ellipsis:
                    parser, _ <- parser.advance()
                    if parser.peek() == TokenKind.Ident:
                        rebind rest_token: Token, parser = parser.advance()
                        return (Ast::Pattern.Rest(Lexer::text_or_empty(rest_token, parser.source)))
                    return (Ast::Pattern.Rest(Lexer::empty_sview()))

                # Bracketed list patterns use the same tuple element representation as
                # comma-separated patterns, with an optional Rest tail (`[head, ...tail]`).
                TokenKind.LBracket:
                    parser, _ <- parser.advance()
                    list_elements: mutable darray[Ast::Pattern] = []
                    machine over parser.position while true:
                        state Parse
                        state Separator
                        start Parse

                        Parse, _ if parser.peek() == TokenKind.RBracket or parser.peek() == TokenKind.Eof:
                            break

                        Parse, _:
                            list_elements.push(parser.parse_pattern_or())
                            -> Separator

                        Separator, _ if parser.peek() == TokenKind.Comma:
                            parser.position <- parser.position + 1
                            -> Parse

                        Separator, _:
                            break
                    parser, _ <- parser.expect(TokenKind.RBracket)
                    return (Ast::Pattern.Tuple(list_elements))

                # Anonymous brace destructure used by `let {field: binding, short} = value`.
                # Store it as a struct-pattern with an empty type path; field labels are
                # selectors while shorthand fields bind their own names.
                TokenKind.LBrace:
                    parser, _ <- parser.advance()
                    brace_fields: mutable darray[Ast::Pattern] = []
                    while parser.peek() != TokenKind.RBrace and parser.peek() != TokenKind.Eof |parser, brace_fields|:
                        selector_token: Token = parser.cursor()
                        selector: sview = Lexer::text_or_empty(selector_token, parser.source) if selector_token.kind == TokenKind.Ident else ""
                        if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon:
                            parser, _ <- parser.advance()
                            parser, _ <- parser.advance()
                        inner: Ast::Pattern = parser.parse_pattern_or()
                        brace_fields.push((Ast::Pattern.Field(selector, [inner])) if selector != "" else inner)
                        break if not parser.accept(TokenKind.Comma)
                    parser, _ <- parser.expect(TokenKind.RBrace)
                    return (Ast::Pattern.Struct(Lexer::empty_sview(), brace_fields))

                # Parenthesized patterns are transparent in stage0; retain the inner
                # structured node rather than degrading `(pattern)` to Other.
                TokenKind.LParen:
                    parser, _ <- parser.advance()
                    rebind inner_pattern: Ast::Pattern, parser = parser.parse_pattern_or()
                    parser, _ <- parser.expect(TokenKind.RParen)
                    return inner_pattern

                # Signed numeric literals are value patterns, not exotic expressions.
                # Preserve the complete source span (`-1`) as a literal, including the
                # signed lower bound of a range pattern.
                TokenKind.Minus if parser.peek_at(1) == TokenKind.IntLit or parser.peek_at(1) == TokenKind.HexLit or parser.peek_at(1) == TokenKind.FloatLit:
                    parser, _ <- parser.advance()
                    rebind magnitude_token: Token, parser = parser.advance()
                    parser <- parser.record_numeric_suffix(magnitude_token)
                    signed_end: usize = magnitude_token.start.usize() + magnitude_token.length.usize()
                    signed_lo: sview = parser.span_view(token.start.usize(), signed_end)
                    parser <- parser.error_removed(token, "range pattern needs an explicit bound spelling: use `..<` (exclusive) or `..=` (inclusive)") if parser.peek() == TokenKind.Range
                    if parser.peek() == TokenKind.RangeLt or parser.peek() == TokenKind.RangeLe:
                        rebind range_token: Token, parser = parser.advance()
                        rebind hi_text: sview, parser = parser.parse_pattern_range_hi()
                        return (Ast::Pattern.Range(signed_lo, hi_text, range_token.kind == TokenKind.RangeLe))
                    return (Ast::Pattern.Literal(signed_lo))

                # Leading-dot enum shorthand (`.Ready` / `.State.Ready`) is a
                # payload-less variant pattern. Store the selector path without the
                # leading dot so existing enum-tail and mismatch checks can reuse it.
                TokenKind.Dot if parser.peek_at(1) == TokenKind.Ident:
                    parser, _ <- parser.advance()
                    rebind first_segment: Token, parser = parser.advance()
                    shorthand_start: usize = first_segment.start.usize()
                    shorthand_end: mutable usize = first_segment.start.usize() + first_segment.length.usize()
                    shorthand_position: usize = parser.position
                    machine over parser.position while parser.peek() == TokenKind.Dot and parser.peek_at(1) == TokenKind.Ident:
                        state More
                        start More

                        More, _:
                            parser.position <- parser.position + 1
                            parser.position <- parser.position + 1
                            -> More
                    if parser.position > shorthand_position:
                        segment_token: Token = parser.tokens[parser.position - 1]
                        shorthand_end <- segment_token.start.usize() + segment_token.length.usize()
                    return (Ast::Pattern.Variant(parser.span_view(shorthand_start, shorthand_end), []))

                # Literal value patterns — or a docs/122 §5.2 range pattern when the
                # literal is followed by `..<` / `..=` (`'a'..<'z'`, `0..=127`).
                TokenKind.IntLit | TokenKind.HexLit | TokenKind.FloatLit | TokenKind.StringLit | TokenKind.CharLit | TokenKind.True | TokenKind.False | TokenKind.Null:
                    parser <- parser.record_numeric_suffix(token) if kind == TokenKind.IntLit or kind == TokenKind.HexLit or kind == TokenKind.FloatLit
                    # CharLit token text is the INTERIOR only (`A`, not `'A'`). Re-include the
                    # surrounding quotes in the pattern text so the backend can distinguish
                    # char code `'0'` (48) from integer `0` (0).
                    lit_text: mutable sview = Lexer::text_or_empty(token, parser.source)
                    if kind == TokenKind.CharLit and token.start.usize() > 0:
                        quote_start: usize = token.start.usize() - 1
                        quote_end: usize = token.start.usize() + token.length.usize() + 1
                        lit_text <- parser.span_view(quote_start, quote_end)
                    parser, _ <- parser.advance()
                    parser <- parser.error_removed(token, "range pattern needs an explicit bound spelling: use `..<` (exclusive) or `..=` (inclusive)") if parser.peek() == TokenKind.Range
                    if parser.peek() == TokenKind.RangeLt or parser.peek() == TokenKind.RangeLe:
                        rebind range_token: Token, parser = parser.advance()
                        rebind hi_text: sview, parser = parser.parse_pattern_range_hi()
                        return (Ast::Pattern.Range(lit_text, hi_text, range_token.kind == TokenKind.RangeLe))
                    return (Ast::Pattern.Literal(lit_text))

                # `error NAME` catch-arm: binds the caught error value to NAME (a category
                # binder). Modeled as a TypeBind so name resolution registers the binding;
                # a bare `error` with no name is a catch-all wildcard.
                TokenKind.Error:
                    parser, _ <- parser.advance()                       # `error`
                    if parser.peek() == TokenKind.Ident:
                        rebind error_binding_token: Token, parser = parser.advance()
                        return (Ast::Pattern.TypeBind("error", Lexer::text_or_empty(error_binding_token, parser.source)))
                    return (Ast::Pattern.Wildcard)

                # `^name` pin pattern — compares against the VALUE of an existing binding
                # instead of introducing a new one. No binding to register, so the pinned
                # name is kept losslessly as an Other pattern.
                TokenKind.Caret if parser.peek_at(1) == TokenKind.Ident:
                    parser, _ <- parser.advance()                       # `^`
                    rebind pin_token: Token, parser = parser.advance()      # the pinned binding name
                    return (Ast::Pattern.Pin(Lexer::text_or_empty(pin_token, parser.source)))

                # Identifier-headed: wildcard, bare binding, variant, struct, or type binder.
                TokenKind.Ident:
                    head: sview = Lexer::text_or_empty(token, parser.source)
                    if head == "_":
                        parser, _ <- parser.advance()
                        return (Ast::Pattern.Wildcard)

                    # Consume a (possibly module-qualified) path: Ident ((`.`|`::`) Ident)*.
                    path_start: usize = token.start.usize()
                    rebind last: Token, parser = parser.advance()
                    # Plain accumulators + statement loop rather than a multi-place
                    # loop-EXPRESSION: the tuple-yielding value form is not in the emitted subset.
                    dotted: mutable bool = false
                    path_end: mutable usize = last.start.usize() + last.length.usize()
                    # Preserve the COMPLETE path, including `::` module qualifiers. Dropping
                    # the prefix made `Alpha::Result.Ok` indistinguishable from a bare
                    # `Result.Ok`; when two modules declared different packed/payload enums
                    # with that name, the backend could select the first row and silently test
                    # the wrong tag. Every resolver now accepts both lexical bare paths and
                    # fully qualified paths, so the source identity must remain lossless.
                    path_from: mutable usize = path_start
                    # Separator bookkeeping for the module-path rule below: whether any `.`
                    # appeared, and whether one appeared BEFORE the last separator.
                    any_dot: mutable bool = false
                    previous_dot: mutable bool = false
                    nonlast_dot: mutable bool = false
                    while parser.peek() == TokenKind.Dot or parser.peek() == TokenKind.Scope |parser, dotted, path_end, path_from, any_dot, previous_dot, nonlast_dot|:
                        dotted <- true
                        nonlast_dot <- true if previous_dot
                        previous_dot <- parser.peek() == TokenKind.Dot
                        any_dot <- true if previous_dot
                        rebind separator_token: Token, parser = parser.advance()      # `.` or `::`
                        rebind segment_token: Token, parser = parser.advance()      # path segment
                        path_end <- segment_token.start.usize() + segment_token.length.usize()
                    path: sview = parser.span_view(path_from, path_end)
                    # `::` is the only module separator. In a variant path only the LAST
                    # separator may be `.` (`Pack::Kind.A`); a `Type{...}` destructure target
                    # is a plain type path and may carry none. stage0: parseVariantPathName /
                    # parseQualifiedDeclName -- same sentence, reported at the head token.
                    struct_target: bool = parser.peek() == TokenKind.LBrace
                    if (struct_target and any_dot) or nonlast_dot:
                        corrected_path: sview = parser.normalize_module_name_separators(path) if struct_target else parser.normalize_leading_module_separators(path)
                        parser <- parser.error_named(Ast::ParseErrorKind.ModulePathDotSeparator, token, corrected_path, "", 0, token.column + token.length)

                    # `Variant(field, …)` — field subpatterns are or-patterns (their own commas
                    # separate fields, so they must not be parsed as a tuple). A field may be
                    # labeled (`Variant(name: subpattern)`); the label is a selector, so it is
                    # consumed and only the subpattern is kept.
                    match parser.peek():
                        TokenKind.LParen:
                            parser, _ <- parser.advance()
                            fields_buffer: mutable darray[Ast::Pattern] = []
                            while parser.peek() != TokenKind.RParen and parser.peek() != TokenKind.Eof |parser|:
                                selector: mutable sview = ""
                                if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon:
                                    rebind selector_token: Token, parser = parser.advance() # field label
                                    selector <- Lexer::text_or_empty(selector_token, parser.source)
                                    parser, _ <- parser.advance()               # `:`
                                rebind __a_129: Ast::Pattern, parser = parser.parse_pattern_or()
                                wrapped: Ast::Pattern = (Ast::Pattern.Field(selector, [__a_129])) if selector != "" else __a_129
                                fields_buffer.push(wrapped)
                                rebind accepted_comma: bool, parser = parser.accept(TokenKind.Comma)
                                break if not accepted_comma
                            parser, _ <- parser.expect(TokenKind.RParen)
                            # docs/122 §5.4 as-binding: `Enum.V(...) as whole` binds the entire
                            # matched value alongside the destructure.
                            if parser.peek() == TokenKind.As:
                                parser, _ <- parser.advance()               # `as`
                                rebind as_token: Token, parser = parser.expect(TokenKind.Ident)
                                return (Ast::Pattern.As(Lexer::text_or_empty(as_token, parser.source), [(Ast::Pattern.Variant(path, fields_buffer))]))
                            return (Ast::Pattern.Variant(path, fields_buffer))

                        # `Type{a, b: sub}` — struct pattern. A labeled field (`name:`) keeps its
                        # subpattern; a shorthand field is parsed as a primary (bare name → Binding).
                        TokenKind.LBrace:
                            parser, _ <- parser.advance()
                            struct_fields: mutable darray[Ast::Pattern] = []
                            while parser.peek() != TokenKind.RBrace and parser.peek() != TokenKind.Eof |parser|:
                                selector_token: Token = parser.cursor()
                                selector: sview = Lexer::text_or_empty(selector_token, parser.source) if selector_token.kind == TokenKind.Ident else ""
                                if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon:
                                    parser, _ <- parser.advance()           # field label (selector, not a binding)
                                    parser, _ <- parser.advance()           # `:`
                                rebind __a_145: Ast::Pattern, parser = parser.parse_pattern_or()
                                struct_fields.push((Ast::Pattern.Field(selector, [__a_145])) if selector != "" else __a_145)
                                rebind accepted_comma_2: bool, parser = parser.accept(TokenKind.Comma)
                                break if not accepted_comma_2
                            parser, _ <- parser.expect(TokenKind.RBrace)
                            # docs/122 §5.4 as-binding on a struct pattern.
                            if parser.peek() == TokenKind.As:
                                parser, _ <- parser.advance()               # `as`
                                rebind as_token_2: Token, parser = parser.expect(TokenKind.Ident)
                                return (Ast::Pattern.As(Lexer::text_or_empty(as_token_2, parser.source), [(Ast::Pattern.Struct(path, struct_fields))]))
                            return (Ast::Pattern.Struct(path, struct_fields))

                        # A category arm with a binder: `Type s` (two identifiers, no separator).
                        TokenKind.Ident:
                            rebind binder_token: Token, parser = parser.advance()
                            return (Ast::Pattern.TypeBind(path, Lexer::text_or_empty(binder_token, parser.source)))

                        _:
                            pass

                    # A dotted head with no fields is a bare enum constant; a single bare
                    # name binds the scrutinee.
                    #
                    # docs/122 §5.4 as-binding on a payloadless variant: `Shape.Empty as
                    # whole`. Mirrors the LParen/LBrace as-checks above; only reachable when
                    # `dotted`, so a plain (undotted) binding pattern is untouched — `x as y`
                    # is not a shape this covers.
                    if dotted and parser.peek() == TokenKind.As:
                        parser, _ <- parser.advance()               # `as`
                        rebind as_token_3: Token, parser = parser.expect(TokenKind.Ident)
                        return (Ast::Pattern.As(Lexer::text_or_empty(as_token_3, parser.source), [(Ast::Pattern.Variant(path, []))]))
                    (Ast::Pattern.Variant(path, [])) return if dotted
                    return (Ast::Pattern.Binding(path))

                # Anything else: keep the raw span, advancing to the block colon.
                _:
                    rebind __v_164: sview, parser = parser.capture_pattern_span()
                    return (Ast::Pattern.Other(__v_164))


        def match_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind match_token: Token, parser = parser.expect(TokenKind.Match)
            if parser.peek() == TokenKind.Question:
                parser <- parser.error_removed(match_token, "`match?` is no longer supported; use `match ...:` with a `null` arm")
                parser <- parser.skip_removed_construct()
                return (Ast::Stmt.Invalid)
            rebind scrutinee_value: Ast::Expr, parser = get parser.expression()
            scrutinee: mutable Ast::Expr = scrutinee_value
            # Multi-scrutinee `match a, b, c:` — the scrutinees form a tuple and each
            # arm carries a matching comma-separated pattern list (parse_arm_block).
            if parser.peek() == TokenKind.Comma:
                scrutinees: mutable darray[Ast::Expr] = [scrutinee]
                while parser.accept(TokenKind.Comma) |parser|:
                    rebind more_option: Ast::Expr?, parser = parser.expression()
                    if more_option is more:
                        scrutinees.push(more)
                scrutinee <- (Ast::Expr.Tuple(scrutinees, Ast::pos_of_token(match_token)))
            # Optional scrutinee alias `match EXPR as NAME:` — binds the matched value
            # under NAME in the arms. The alias is a selector consumed here (expression()
            # stops before `as`; see the reinterpret-target gate in binary_expression_at_level).
            rebind accepted_as: bool, parser = parser.accept(TokenKind.As)
            parser, _ <- parser.expect(TokenKind.Ident) if accepted_as
            rebind arms_buffer: darray[Ast::MatchArm], parser = parser.parse_arm_block()
            return (Ast::Stmt.Match(scrutinee, arms_buffer, Ast::pos_of_token(match_token)))


        # `catch EXPR:` — run EXPR and dispatch on its outcome via indented arms: a bare
        # `n:` success binding, error-variant patterns (`ModuleError.MapFailed(v):`), and a
        # catch-all `error e:`. Structurally a match on the call's result, so it reuses the
        # match arm loop and is modeled as a Match node (the scrutinee is the guarded call).
        def catch_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind catch_token: Token, parser = parser.expect(TokenKind.Catch)
            rebind scrutinee: Ast::Expr, parser = get parser.expression()
            # Optional alias `catch EXPR as NAME:` (mirrors match_statement).
            rebind accepted_as_2: bool, parser = parser.accept(TokenKind.As)
            parser, _ <- parser.expect(TokenKind.Ident) if accepted_as_2
            rebind arms_buffer: darray[Ast::MatchArm], parser = parser.parse_catch_arm_block(catch_token)
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__catch_match", name: "__catch_match", line: catch_token.line})
            # The two catch RULES (`non-exhaustive catch over F; missing F.V` and `catch arm
            # "X" does not match F`) read the parser's side tables, and only the EXPRESSION
            # form was recording them. A statement `catch` therefore went entirely unchecked:
            # stage0 rejects `catch f(x): value: ... Problem.First: ...` when `Problem.Second`
            # is unhandled, and stage1 compiled it silently -- an error case the author never
            # wrote a branch for, accepted. Record the same rows here.
            #
            # Arm 0 is the SUCCESS arm and is skipped, exactly as the expression form does:
            # it binds the call's value, not an error variant, so counting it would both
            # satisfy exhaustiveness by accident and read its binder as a variant name.
            catch_callee: sview = parser.catch_callee_name(scrutinee)
            if catch_callee != "":
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: catch_callee, name: "__catch_expr", line: catch_token.line})
                # Keep the match on the arm's packed pattern in place; passing a MatchArm
                # through a helper copies its payload-bearing pattern handle.
                while catch_arm_index < arms_buffer.count |catch_arm_index: usize = 1, parser, catch_callee, catch_token|:
                    match arms_buffer[catch_arm_index].pattern:
                        Ast::Pattern.Binding(binder_name):
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: catch_callee, name: binder_name, line: catch_token.line})
                        Ast::Pattern.Variant(variant_path, variant_fields):
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: catch_callee, name: variant_path, line: catch_token.line})
                        Ast::Pattern.Wildcard:
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: catch_callee, name: "__catch_all", line: catch_token.line})
                        Ast::Pattern.TypeBind(bind_type_name, bind_binder):
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: catch_callee, name: "__catch_all", line: catch_token.line}) if bind_type_name == "error"
                        _:
                            pass
                    catch_arm_index <- catch_arm_index + 1
            # stage0 reads a `catch` arm as a MATCH EXPRESSION arm, so each one must end with
            # an expression: an arm whose last statement ASSIGNS is rejected there ("match
            # expression arm must end with an expression") while stage1 accepted it. Recorded
            # as an annotation, the way the other catch rules reach the semantic layer.
            #
            # Deliberately narrow — only a trailing ASSIGNMENT. A tail that `return`s, raises
            # or yields a value is fine, and anything else stays unflagged rather than risking
            # a false rejection of a program stage0 accepts.
            machine over parser.enum_annotations while true:
                state Scan(index: usize)
                start Scan(0)

                Scan(index), _ if index >= arms_buffer.count:
                    break

                Scan(index), _:
                    parser <- parser.record_catch_tail(arms_buffer[index], catch_token)
                    -> Scan(index + 1)
            return (Ast::Stmt.Match(scrutinee, arms_buffer, Ast::pos_of_token(catch_token)))

        def record_catch_tail(parser: lmut Parser, tail_arm: Ast::MatchArm, catch_token: Token) -> void:
            return if tail_arm.body.count == 0
            match tail_arm.body[tail_arm.body.count - 1]:
                Stmt.Assign(tail_target, tail_operator, tail_value, tail_line):
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__catch_match", name: "__catch_arm_tail", line: catch_token.line})
                _:
                    pass


        # Parse the `: NEWLINE INDENT (PATTERN: <block>)* DEDENT` arm block shared by
        # `match` and `catch`. Each arm header is decomposed via parse_top_level_patterns (exotic
        # forms captured losslessly), and parsing always halts at the arm's block colon so
        # a malformed head never spins the loop.
        def parse_arm_block(parser: lmut Parser) -> darray[Ast::MatchArm]:
            arms_buffer: mutable darray[Ast::MatchArm] = []
            parser <- parser.parse_arm_block_into(arms_buffer)
            parser <- parser.note_wildcard_arms(arms_buffer)
            return arms_buffer


        # Record the span of every non-final `_` arm head. stage0 rejects a `_`-headed arm
        # anywhere but LAST, guarded or not, and reports it at the ARM HEAD (`7:9-10`) for
        # the statement and the expression form alike. Recorded HERE rather than in the
        # semantic walk because a match STATEMENT's arms reach that walk with
        # `MatchArm.pos` zeroed (a match EXPRESSION's do not) -- the same asymmetry the
        # or-pattern columns above work around. `arms` is still the parser's own buffer at
        # this point, so its arm positions are intact.
        #
        # Called from parse_arm_block, the `match` wrapper only: `catch` blocks reach
        # parse_arm_block_into directly, and stage0 applies this rule to `match`, not to
        # `catch`.
        def note_wildcard_arms(parser: lmut Parser, arms: darray[Ast::MatchArm]&) -> void:
            can Memory.Allocate, Abort.Panic:
                wildcard_index: mutable usize = 0
                for wildcard_arm in arms |parser, wildcard_index|:
                    arm_is_wildcard: bool = match wildcard_arm.pattern:
                        Ast::Pattern.Wildcard: true
                        _: false
                    if arm_is_wildcard and wildcard_index + 1 < arms.count:
                        parser.wildcard_arm_lines <- parser.wildcard_arm_lines.push(wildcard_arm.pos.line)
                        parser.wildcard_arm_columns <- parser.wildcard_arm_columns.push(wildcard_arm.pos.column)
                        parser.wildcard_arm_end_columns <- parser.wildcard_arm_end_columns.push(wildcard_arm.pos.end_column)
                    wildcard_index <- wildcard_index + 1
                return


        # Populate a caller-owned arm buffer so packed patterns are never shallow-copied
        # across the parser frame. This is especially important for catch arms: a named
        # error variant stores its path/fields in the Pattern payload, unlike a wildcard
        # or binding arm, and stage1 must retain that payload for catch exhaustiveness.
        def parse_arm_block_into(parser: lmut Parser, arms_buffer: mutable darray[Ast::MatchArm]&) -> void:
            parser, _ <- parser.expect(TokenKind.Colon)
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)

            while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser|:
                parser <- parser.skip_newlines()
                break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof

                arm_head: Token = parser.cursor()
                parser <- parser.error_removed(arm_head, "match arms do not use a `case` keyword; write the pattern directly (e.g. `E.A(v: v):`)") if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(arm_head, parser.source) == "case" and parser.peek_at(1) != TokenKind.Colon

                # docs/125 §5 — an arm header carrying a top-level `with` fans out into one
                # sibling MatchArm per alternative (each with its discriminating constants
                # prepended). Only this path differs; every `with`-less arm is unchanged.
                if parser.arm_header_has_with():
                    rebind with_arms: darray[Ast::MatchArm], parser = parser.parse_with_arm()
                    arms_buffer.extend([arm for arm in with_arms])
                    continue

                # `A | B:` fans out into one sibling arm per alternative, the way stage0's
                # parseTopLevelMatchArmAlternatives does; only the word `or` stays a single
                # Pattern.Or arm. A comma-separated pattern list is still a tuple arm
                # (`A, B, C:` — one pattern per scrutinee of a multi-scrutinee match), which
                # parse_pattern_no_pipe folds in per alternative.
                alternatives: mutable darray[Ast::Pattern] = []
                parser <- parser.parse_top_level_patterns(alternatives)

                # docs/122 §5.1 arm-header guard: `Pattern if cond:` — the guard
                # expression ends at the arm's block colon; pattern bindings are in
                # scope inside it (registered by the resolver).
                guard: mutable Ast::Expr = (Ast::Expr.Absent)
                if parser.peek() == TokenKind.If:
                    parser, _ <- parser.advance()                   # `if`
                    rebind guard_opt: Ast::Expr?, parser = parser.expression()
                    if guard_opt is guard_value:
                        guard <- guard_value

                # If the pattern parse didn't land on the block colon (an exotic
                # tail), drop the rest of the head losslessly so we don't spin.
                parser, _ <- parser.capture_pattern_span() if parser.peek() != TokenKind.Colon
                if parser.peek() != TokenKind.Colon:
                    parser, _ <- parser.advance()                   # malformed arm; don't spin
                    continue

                # Recorded only once the arm head is known well-formed (the malformed-arm
                # guard above `continue`s before here), so a dropped arm is never reported.
                for recorded_alternative in alternatives |parser|:
                    parser <- parser.note_or_arm_binding(recorded_alternative, arm_head)

                rebind body: darray[Ast::Stmt], parser = parser.parse_block()
                for alternative in alternatives:
                    append_arm_alternative(alternative, body, guard, arm_head, arms_buffer)

            parser, _ <- parser.expect(TokenKind.Dedent)
            return
