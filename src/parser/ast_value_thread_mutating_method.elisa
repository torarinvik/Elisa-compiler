# Closed set of builtin container methods that update their receiver in place.
module AstValueThreadMutatingMethod:
    public:
        def is_mutating_method(method: sview) -> bool:
            ensure result == (
                when method:
                    "push" | "pop" | "insert" | "remove" | "clear" | "extend" | "resize" -> true
                    "truncate" | "put" | "reserve" | "append" | "add" | "discard" -> true
                    "sort" | "reverse" | "swap" | "fill" | "push_front" | "pop_front" -> true
                    "retain" | "drain" -> true
                    _ -> false
            )
            return when method:
                "push" | "pop" | "insert" | "remove" | "clear" | "extend" | "resize" -> true
                "truncate" | "put" | "reserve" | "append" | "add" | "discard" -> true
                "sort" | "reverse" | "swap" | "fill" | "push_front" | "pop_front" -> true
                "retain" | "drain" -> true
                _ -> false
