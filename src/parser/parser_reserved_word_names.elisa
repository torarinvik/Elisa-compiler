# Stage1 parser -- reserved keywords used as names (`extend Parser: private:`), stage0's
# parser_reserved_word_names.go. `to: i64 = 3`, `def f(stack: i64)` or a field named `tail`
# used to give "unexpected token" plus a cascade, and a local named `error` was silently
# accepted and then miscompiled. The parser names the actual problem at the site, then
# treats the word as an identifier so the rest of the line parses normally. Which words are
# reserved is unchanged: the lexer's keyword table.

extend Parser:
    private:
        # A keyword token spelled like an identifier (stage0 isReservedWordToken).
        def is_reserved_word_token(parser: Parser&, token: Token) -> bool:
            return false if token.kind == TokenKind.Ident
            text: sview = Lexer::text_or_empty(token, parser.source, parser.source_length)
            return false if text.len == 0 or Lexer::frontend_lookup_keyword(text) == TokenKind.Ident
            first: u8 = text[0]
            first == 95 or (first >= 97 and first <= 122) or (first >= 65 and first <= 90)

        # Keywords that read naturally as names. A statement that starts with one of these
        # followed by `:` and a type, `=` or `<-` declares or assigns a reserved name; other
        # keywords are left to their statement parsers.
        def is_statement_name_like_reserved_word(kind: TokenKind) -> bool:
            when kind:
                TokenKind.To | TokenKind.Stack | TokenKind.Heap | TokenKind.Tail | TokenKind.Error | TokenKind.Packed -> true
                _ -> false

        # Whether NEXT can follow `heap`/`stack`/`tail` used as a type qualifier: a token
        # that starts a type (stage0 tokenCanStartTypeExpr), or one that ends a bare storage
        # literal type argument (`Ref[i64, heap]`). Any other token makes the word a name.
        def storage_qualifier_operand_follows(next: TokenKind) -> bool:
            when next:
                TokenKind.Ident | TokenKind.Mutable | TokenKind.Lmut | TokenKind.Tail | TokenKind.LParen | TokenKind.Heap | TokenKind.Stack | TokenKind.Static -> true
                TokenKind.RBracket | TokenKind.Comma | TokenKind.RParen | TokenKind.Ampersand | TokenKind.LBracket -> true
                _ -> false

        def report_reserved_word_as_name(parser: lmut Parser, token: Token) -> void:
            word: sview = Lexer::text_or_empty(token, parser.source, parser.source_length)
            sentence_pieces: darray[sview] = ["`", word, "` is a reserved keyword and cannot be used as a name"]
            sentence: sview @source = parser.removed_sentence(sentence_pieces)
            parser <- parser.error_removed(token, sentence)

        # From here on the token at `index` is an identifier (stage0 rewriteTokenKind).
        def rewrite_token_as_identifier(parser: lmut Parser, index: usize) -> void:
            return if index >= parser.tokens.count
            rewritten: mutable Token = parser.tokens[index]
            rewritten.kind <- TokenKind.Ident
            parser.tokens[index] <- rewritten

        # A statement-initial `kw: T = ...`, `kw = ...` or `kw <- ...` whose keyword is
        # name-like: reported, then parsed as a name. A `kw:` block opener is not a name.
        def recover_reserved_word_statement_name(parser: lmut Parser) -> void:
            token: Token = parser.cursor()
            return if not is_statement_name_like_reserved_word(token.kind) or not parser.is_reserved_word_token(token)
            next_kind: TokenKind = parser.peek_at(1)
            names_a_binding: bool = when next_kind:
                TokenKind.Colon -> parser.peek_at(2) != TokenKind.Newline and parser.peek_at(2) != TokenKind.Eof
                TokenKind.Assign | TokenKind.LArrow -> true
                _ -> false
            return if not names_a_binding
            parser <- parser.report_reserved_word_as_name(token)
            name_position: usize = parser.position
            parser <- parser.rewrite_token_as_identifier(name_position)

        # `for to in xs:` / `for tail, x in ...`: the binder at `index`.
        def recover_reserved_word_loop_binder(parser: lmut Parser, index: usize) -> void:
            return if index + 1 >= parser.tokens.count
            binder: Token = parser.tokens[index]
            return if not parser.is_reserved_word_token(binder)
            next_kind: TokenKind = parser.tokens[index + 1].kind
            return if next_kind != TokenKind.In and next_kind != TokenKind.Comma
            parser <- parser.report_reserved_word_as_name(binder)
            parser <- parser.rewrite_token_as_identifier(index)
