# Source-level expansion of `static generate` blocks (docs/... static generate; task #35).
#
# stage0 expands `static generate` at the AST level (analyzer_decl_analysis.go →
# expandActiveAndGeneratedDecls). stage1 does it as a SOURCE→SOURCE preprocessing pass BEFORE
# the real parse: it recognizes the decidable shape
#
#     static generate:
#         for VAR in variants(ENUM):
#             emit def PREFIX${VAR.name}...(...):
#                 BODY (may contain ${VAR.name})
#
# and, for each variant of ENUM, splices a concrete declaration (the emit template with
# `${VAR.name}` replaced by the variant name) into the output source, dropping the original
# block. The expanded source is then lexed+parsed ONCE, so all generated declarations live in
# a single coherent node store and flow through symbol collection, resolution, type-checking,
# and duplicate detection exactly like hand-written ones. This makes generated names resolve
# (a caller of `is_Int` type-checks), generated bodies type-check (`bad: bool = 7` errors), and
# a generated name colliding with an existing declaration reports a duplicate — matching stage0.
#
# The pass is DELIBERATELY NARROW: only the single-`for`-over-`variants(ENUM)`, single-`emit def`
# shape whose interpolations are all `${VAR.name}` is expanded. Any other block (a runtime-call
# interpolation, a filter, a nested form, an unknown enum) is copied through verbatim, so the
# existing parser + `check_static_generate_interp` handle it unchanged (e.g. the compile-time
# interpolation error). The output buffer is caller-owned, so the generated declarations' source
# spans stay alive for the whole analysis, just like the original source.
using Lexer

# The variant names of ENUM among a parsed file's top-level enum declarations, or empty.
def sg_enum_variant_names(file: Ast::File&, enum_name: sview) -> darray[sview]:
    can Memory.Allocate, Abort.Panic:
        result: mutable darray[sview] = []
        for decl in file.top_decls |result|:
            match decl:
                Ast::Decl.Enum(name, variants, is_const, storage_type, line):
                    result.extend([variant.name for variant in variants]) if name == enum_name
                _:
                    pass
        return result


# Sparse `OUTPUT_LINE, INPUT_LINE` runs. Within a run, line origins advance by one.
def sg_line_map_set_run(line_map: mutable darray[u32]&, output_line: u32, input_line: u32) -> void:
    can Memory.Allocate, Abort.Panic:
        if line_map.count >= 2.usize() and line_map[line_map.count - 2.usize()] == output_line:
            line_map[line_map.count - 1.usize()] <- input_line
        else:
            line_map.push(output_line)
            line_map.push(input_line)


def sg_advance_source_line(source: u8&, from_at: usize, end_at: usize, input_line: mutable u32&) -> void:
    can Abort.Panic:
        cursor: mutable usize = from_at
        while cursor < end_at |cursor, input_line, source|:
            input_line <- input_line + 1 if source[cursor] == 10
            cursor <- cursor + 1


def sg_append_mapped_range(out: mutable darray[u8]&, line_map: mutable darray[u32]&, source: u8&, from_at: usize, end_at: usize, input_line: mutable u32&, output_line: mutable u32&) -> void:
    can Memory.Allocate, Abort.Panic:
        return if from_at >= end_at
        sg_line_map_set_run(line_map, output_line, input_line)
        cursor: mutable usize = from_at
        while cursor < end_at |cursor, input_line, output_line, out, source|:
            byte: u8 = source[cursor]
            out.push(byte)
            if byte == 10:
                input_line <- input_line + 1
                output_line <- output_line + 1
            cursor <- cursor + 1


def sg_append_mapped_template(out: mutable darray[u8]&, line_map: mutable darray[u32]&, source: u8&, slen: usize, tstart: usize, tend: usize, var_name: sview, variant_name: sview, template_input_line: u32, output_line: mutable u32&, template_last_line: mutable u32&) -> void:
    can Memory.Allocate, Abort.Panic:
        sg_line_map_set_run(line_map, output_line, template_input_line)
        var_length: usize = var_name.len
        cursor: mutable usize = tstart
        while cursor < tend |cursor, output_line, template_last_line, out|:
            if cursor + 1 < tend and source[cursor] == 36 and source[cursor + 1] == 123 and sg_interp_is_var_name(source, slen, cursor, var_name):
                sg_append_sview(out, variant_name)
                cursor <- cursor + 2 + var_length + 6
            else:
                byte: u8 = source[cursor]
                out.push(byte)
                if byte == 10:
                    output_line <- output_line + 1
                    template_last_line <- template_last_line + 1
                cursor <- cursor + 1


def sg_append_mapped_template_separator(out: mutable darray[u8]&, line_map: mutable darray[u32]&, output_line: mutable u32&, template_last_line: u32) -> void:
    can Memory.Allocate, Abort.Panic:
        out.push(10)
        output_line <- output_line + 1
        sg_line_map_set_run(line_map, output_line, template_last_line)
        out.push(10)
        output_line <- output_line + 1
        sg_line_map_set_run(line_map, output_line, template_last_line)


# Append the bytes of an sview to out.
def sg_append_sview(out: mutable darray[u8]&, value: sview) -> void:
    can Memory.Allocate, Abort.Panic:
        length: usize = value.len
        index: mutable usize = 0
        while index < length |index, out|:
            out.push(value[index])
            index <- index + 1


# Whether source bytes at position `at` spell `${VAR.name}` for the given VAR name.
def sg_interp_is_var_name(source: u8&, slen: usize, at: usize, var_name: sview) -> bool:
    can Abort.Panic:
        var_length: usize = var_name.len
        # Need: `$` `{` VAR `.` `n` `a` `m` `e` `}`  = 2 + var_length + 6 bytes.
        needed: usize = at + var_length + 8
        return false if:
            needed > slen
            source[at] != 36 or source[at + 1] != 123
        probe: mutable usize = 0
        while probe < var_length |probe|:
            return false if source[at + 2 + probe] != var_name[probe]
            probe <- probe + 1
        suffix_at: usize = at + 2 + var_length
        # `.name}`
        return source[suffix_at] == 46 and source[suffix_at + 1] == 110 and source[suffix_at + 2] == 97 and source[suffix_at + 3] == 109 and source[suffix_at + 4] == 101 and source[suffix_at + 5] == 125


# Whether EVERY `${...}` interpolation in source[tstart ..< tend) is exactly `${VAR.name}`.
# A block with any other interpolation shape is left unexpanded (copied verbatim).
def sg_template_interps_ok(source: u8&, slen: usize, tstart: usize, tend: usize, var_name: sview) -> bool:
    can Memory.Allocate, Abort.Panic:
        cursor: mutable usize = tstart
        while cursor + 1 < tend |cursor|:
            if source[cursor] == 36 and source[cursor + 1] == 123:
                return false if not sg_interp_is_var_name(source, slen, cursor, var_name)
                cursor <- cursor + 1
            cursor <- cursor + 1
        return true


# Append the emit template source[tstart ..< tend) to out, substituting every `${VAR.name}`
# with the variant name. Assumes sg_template_interps_ok already validated the interpolations.
def sg_append_template(out: mutable darray[u8]&, source: u8&, slen: usize, tstart: usize, tend: usize, var_name: sview, variant_name: sview) -> void:
    can Memory.Allocate, Abort.Panic:
        var_length: usize = var_name.len
        cursor: mutable usize = tstart
        while cursor < tend |cursor, out|:
            if cursor + 1 < tend and source[cursor] == 36 and source[cursor + 1] == 123 and sg_interp_is_var_name(source, slen, cursor, var_name):
                sg_append_sview(out, variant_name)
                cursor <- cursor + 2 + var_length + 6
            else:
                out.push(source[cursor])
                cursor <- cursor + 1


# Keep the source-to-source scan on references to the token backing array. A direct
# `tokens[index]` expression is a value expression in the stage1 backend, so projecting
# `.kind` or `.start` from it materializes the whole 20-byte Token. This pass walks the
# complete compiler source and that temporary was enough to exhaust gen3's native stack.
def sg_token_ref(tokens: darray[Lexer::Token]&, index: usize) -> Lexer::Token&:
    trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic]:
        first: Lexer::Token& = &tokens[0.usize()]
        return (first.cast[u8&] + index * size_of(Lexer::Token)).cast[Lexer::Token&]

def sg_token_kind(tokens: darray[Lexer::Token]&, index: usize) -> Lexer::TokenKind:
    token: Lexer::Token& = sg_token_ref(tokens, index)
    return token.kind

def sg_token_text(tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, index: usize) -> sview:
    token: Lexer::Token& = sg_token_ref(tokens, index)
    return Lexer::text_or_empty(token, source, source_length)

def sg_token_start(tokens: darray[Lexer::Token]&, index: usize) -> usize:
    token: Lexer::Token& = sg_token_ref(tokens, index)
    return token.start.usize()

def sg_token_end(tokens: darray[Lexer::Token]&, index: usize) -> usize:
    token: Lexer::Token& = sg_token_ref(tokens, index)
    return token.start.usize() + token.length.usize()


# Expand recognized `static generate` blocks and return sparse output-line to input-line runs.
# Each pair is `OUTPUT_LINE, INPUT_EXPANDED_LINE`; a run advances both lines by one until the
# next pair. Repeated templates start new runs at the original `emit def` line. If no block is
# expanded, the output is left untouched and the line map stays empty; callers should retain the
# input source and map for that case.
def frontend_preprocess_static_generate_with_line_map(source: u8&, slen: usize, tokens: darray[Lexer::Token]&, file: Ast::File&, out: mutable darray[u8]&, out_line_map: mutable darray[u32]&, out_line_count: mutable u32&) -> bool:
    can Memory.Allocate, Abort.Panic:
        copied: mutable usize = 0
        changed: mutable bool = false
        source_line: mutable u32 = 1
        output_line: mutable u32 = 1
        out_line_map.truncate(0)
        out_line_count <- 0
        count: usize = tokens.count
        i: mutable usize = 0
        while i < count |i, copied, changed, source_line, output_line, out, out_line_map|:
            recognized: mutable bool = false
            # `static generate :`
            if sg_token_kind(tokens, i) == Lexer::TokenKind.Static and i + 3 < count and sg_token_text(tokens, source, slen, i + 1) == "generate" and sg_token_kind(tokens, i + 2) == Lexer::TokenKind.Colon:
                # After the colon: Newline, Indent open the block body (depth 1).
                if sg_token_kind(tokens, i + 3) == Lexer::TokenKind.Newline and i + 4 < count and sg_token_kind(tokens, i + 4) == Lexer::TokenKind.Indent:
                    body: usize = i + 5
                    # `for VAR in variants ( ENUM ) :`
                    if body + 7 < count and sg_token_text(tokens, source, slen, body) == "for" and sg_token_kind(tokens, body + 1) == Lexer::TokenKind.Ident and sg_token_kind(tokens, body + 2) == Lexer::TokenKind.In and sg_token_text(tokens, source, slen, body + 3) == "variants" and sg_token_kind(tokens, body + 4) == Lexer::TokenKind.LParen and sg_token_kind(tokens, body + 5) == Lexer::TokenKind.Ident and sg_token_kind(tokens, body + 6) == Lexer::TokenKind.RParen and sg_token_kind(tokens, body + 7) == Lexer::TokenKind.Colon:
                        var_name: sview = sg_token_text(tokens, source, slen, body + 1)
                        enum_name: sview = sg_token_text(tokens, source, slen, body + 5)
                        # After the for-colon: Newline, Indent open the for body (depth 2),
                        # then `emit def ...`.
                        loop_body: usize = body + 8
                        if loop_body + 2 < count and sg_token_kind(tokens, loop_body) == Lexer::TokenKind.Newline and sg_token_kind(tokens, loop_body + 1) == Lexer::TokenKind.Indent and sg_token_text(tokens, source, slen, loop_body + 2) == "emit" and loop_body + 3 < count and sg_token_kind(tokens, loop_body + 3) == Lexer::TokenKind.Def:
                            def_index: usize = loop_body + 3
                            template_start: usize = sg_token_start(tokens, def_index)
                            # Walk the emit declaration: its signature line, then its INDENT-opened
                            # body, until the matching DEDENT closes it. The last token before that
                            # DEDENT ends the template. depth counts INDENT/DEDENT from the def line.
                            scan: mutable usize = def_index
                            depth: mutable i64 = 0
                            template_end: mutable usize = sg_token_end(tokens, def_index)
                            opened: mutable bool = false
                            done: mutable bool = false
                            while scan < count and not done |scan, depth, template_end, opened, done|:
                                kind: Lexer::TokenKind = sg_token_kind(tokens, scan)
                                if kind == Lexer::TokenKind.Indent:
                                    depth <- depth + 1
                                    opened <- true
                                elif kind == Lexer::TokenKind.Dedent:
                                    depth <- depth - 1
                                    done <- true if opened and depth <= 0
                                elif kind != Lexer::TokenKind.Newline:
                                    template_end <- sg_token_end(tokens, scan)
                                scan <- scan + 1
                            # scan now sits just past the DEDENT that closed the emit body (depth 2
                            # → 1). The whole `static generate` block closes when two more DEDENTs
                            # bring depth to 0; skip forward to the first token past the block.
                            block_depth: mutable i64 = 1
                            resume: mutable usize = scan
                            while resume < count and block_depth > 0 |resume, block_depth|:
                                rkind: Lexer::TokenKind = sg_token_kind(tokens, resume)
                                block_depth <- block_depth + 1 if rkind == Lexer::TokenKind.Indent
                                block_depth <- block_depth - 1 if rkind == Lexer::TokenKind.Dedent
                                resume <- resume + 1
                            variant_names: darray[sview] = sg_enum_variant_names(file, enum_name)
                            interps_ok: bool = sg_template_interps_ok(source, slen, template_start, template_end, var_name)
                            if variant_names.count > 0 and interps_ok:
                                # Copy everything up to the `static` keyword, then splice one concrete
                                # declaration per variant, then resume after the block.
                                static_start: usize = sg_token_start(tokens, i)
                                sg_append_mapped_range(out, out_line_map, source, copied, static_start, &source_line, &output_line)
                                sg_advance_source_line(source, static_start, template_start, &source_line)
                                template_input_line: u32 = source_line
                                for variant_name in variant_names |out, out_line_map, output_line|:
                                    template_last_line: mutable u32 = template_input_line
                                    sg_append_mapped_template(out, out_line_map, source, slen, template_start, template_end, var_name, variant_name, template_input_line, &output_line, &template_last_line)
                                    sg_append_mapped_template_separator(out, out_line_map, &output_line, template_last_line)
                                resume_byte: usize = sg_token_start(tokens, resume) if resume < count else slen
                                sg_advance_source_line(source, template_start, resume_byte, &source_line)
                                copied <- resume_byte
                                changed <- true
                                recognized <- true
                                i <- resume
            i <- i + 1 if not recognized
        return false if not changed
        sg_append_mapped_range(out, out_line_map, source, copied, slen, &source_line, &output_line)
        out_line_count <- output_line
        return true


# Existing parser/report callers that do not publish diagnostics can keep the bytes-only API.
def frontend_preprocess_static_generate(source: u8&, slen: usize, tokens: darray[Lexer::Token]&, file: Ast::File&, out: mutable darray[u8]&) -> bool:
    can Memory.Allocate, Abort.Panic:
        line_map: mutable darray[u32] = []
        line_count: mutable u32 = 0
        return frontend_preprocess_static_generate_with_line_map(source, slen, tokens, file, out, line_map, &line_count)
