# Stage1 parser — declaration parsing, part 1 (`extend Parser: private:`). Covers
# decorators, the declaration-unit dispatcher, modules/`using`/`include`, type aliases,
# `impl`/named-block/`static if`/law/alias decls, and the top-level `declaration` dispatcher.
# Struct/enum/const declarations and the public `parse_file` entry point continue in
# parser_types.elisa. Split out of parser.elisa to keep each part file under 600 lines.

extend Parser:
    private:
        # ============================================================
        # Declaration parsing
        # ============================================================

        # Parse one declaration unit into `out`. A single keyword declaration appends one
        # node; `module`/visibility sections (`public:`/`private:`) append their
        # flattened children. `module`/`include`/`public`/`private` are contextual
        # keywords (the lexer emits them as identifiers), matched here by text.
        # Consume any leading `@name` / `@name(arguments)` decorators before a declaration
        # (e.g. `@inline(always)`, `@hot`, `@test`), recording each bare decorator name
        # into `parser.pending_decorators` (cleared in place first) for the declaration
        # that follows to pick up. Arguments are consumed but not modeled.
        # Capture comma-separated raw argument spans while balancing nested groups.
        def parse_decorator_arguments(parser: lmut Parser) -> void:
            depth: mutable int = 1
            arg_start: mutable usize = 0
            arg_end: mutable usize = 0
            while depth > 0 and parser.peek() != TokenKind.Eof |parser, depth, arg_start, arg_end|:
                token: Token = parser.cursor()
                kind: TokenKind = token.kind
                ends_arg: bool = depth == 1 and kind in {TokenKind.Comma, TokenKind.RParen}
                parser <- parser.capture_decorator_arg(arg_start, arg_end) if ends_arg and arg_end > arg_start
                arg_start <- 0 if ends_arg else (token.start.usize() if arg_start == 0 else arg_start)
                arg_end <- token.start.usize() + token.length.usize() if not ends_arg else 0
                depth <- depth + 1 if kind in {TokenKind.LParen, TokenKind.LBracket, TokenKind.LBrace}
                depth <- depth - 1 if kind in {TokenKind.RParen, TokenKind.RBracket, TokenKind.RBrace}
                parser, _ <- parser.advance()

        def capture_decorator_arg(parser: lmut Parser, start: usize, end: usize) -> void:
            parser.annotation_args <- parser.annotation_args.push(Lexer::source_view_or_empty(parser.source, start, end))

        # Record one `@name` / `@dotted.name` decorator plus its optional `(...)`
        # arguments. A no-operator unless the cursor is on an identifier.
        def parse_one_decorator(parser: lmut Parser) -> void:
            return if parser.peek() != TokenKind.Ident
            rebind name: sview, parser = parser.parse_dotted_name()
            arg_start: u32 = parser.annotation_args.count.u32()
            rebind accepted_lparen: bool, parser = parser.accept(TokenKind.LParen)
            parser <- parser.parse_decorator_arguments() if accepted_lparen
            arg_count: u32 = parser.annotation_args.count.u32() - arg_start
            parser.pending_decorators <- parser.pending_decorators.push(Ast::Annotation{name: name, arg_start: arg_start, arg_count: arg_count})

        def parse_decorators(parser: lmut Parser) -> void:
            parser.pending_decorators <- parser.pending_decorators.truncate(0)
            while parser.peek() == TokenKind.At |parser|:
                parser, _ <- parser.advance()                   # `@`
                # Bracketed list `@[a, b(x), c]` is equivalent to writing each `@a` /
                # `@b(x)` / `@c` on its own line; anything else is a single decorator.
                rebind accepted_lbracket: bool, parser = parser.accept(TokenKind.LBracket)
                parser <- parser.parse_bracketed_decorator_list() if accepted_lbracket else parser.parse_one_decorator()
                parser <- parser.skip_newlines()

        # Parse the comma-separated decorators of a bracketed list `@[a, b(x), c]`,
        # entered just past the opening `[`.
        def parse_bracketed_decorator_list(parser: lmut Parser) -> void:
            while parser.peek() != TokenKind.RBracket and parser.peek() != TokenKind.Eof |parser|:
                parser <- parser.parse_one_decorator()
                rebind accepted_comma: bool, parser = parser.accept(TokenKind.Comma)
                break if not accepted_comma
            parser, _ <- parser.accept(TokenKind.RBracket)


        # Handle a `static …` compile-time declaration form, entered with the cursor on
        # `static`. Returns true when the form was fully consumed (the caller should
        # stop); false when `static` is a false alarm (unrecognized directive rewound,
        # or a `static` followed by nothing we model) so the caller falls through to
        # `declaration()`. Forms: `static if/elif/else COND:` (conditional decls), `static def
        # NAME(...)` (the marker is dropped, function parses normally), `static generate:`
        # (an `emit …` template block, skipped whole), and `static assert COND[, MSG]` /
        # `static assert:` block (skipped).
        def parse_static(parser: lmut Parser, out: mutable darray[Ast::Decl]&) -> bool:
            false return if parser.peek() != TokenKind.Static
            next: TokenKind = parser.peek_at(1)
            match next:
                TokenKind.If | TokenKind.Elif | TokenKind.Else:
                    parser <- parser.static_if_declaration(out)
                    return true
                TokenKind.Def:
                    parser, _ <- parser.advance()               # `static` (compile-time marker)
                    rebind __m_75: Ast::Decl?, parser = parser.function_declaration()
                    out.push(static_function) if __m_75 is static_function
                    return true
                TokenKind.Ident:
                    static_saved: usize = parser.position
                    parser, _ <- parser.advance()               # `static`
                    directive_token: Token = parser.cursor()
                    directive: sview = Lexer::text_or_empty(directive_token, parser.source)
                    is_directive: bool = directive == "generate" or directive == "assert"
                    # Not a recognized directive — rewind and fall through to declaration().
                    parser.position <- static_saved if not is_directive
                    false return if not is_directive
                    parser, _ <- parser.advance()               # the directive name
                    # Block form (`static generate:` / `static assert:`) skips the
                    # whole indented block; line form (`static assert COND[, MSG]`)
                    # skips to end of line.
                    rebind accepted_colon: bool, parser = parser.accept(TokenKind.Colon)
                    parser <- parser.skip_indented_block() if accepted_colon
                    parser <- parser.skip_to_line_end() if not accepted_colon
                    return true
                _:
                    pass
            return false

        # Append an optional declaration node to `out` (a no-operator when parsing yielded
        # none). Collapses the `if parser.X() is n: out.push(n)` idiom that every
        # single-keyword declaration arm in `parse_declaration_unit` shares.
        def push_opt(parser: lmut Parser, out: mutable darray[Ast::Decl]&, node: Ast::Decl?) -> void:
            out.push(declaration) if node is declaration

        # Consume (and discard) one expression when COND holds. Same tuple-guard-if
        # parse gotcha as `advance_if` (declared in parser_types_signature.elisa).
        def skip_expression_if(parser: lmut Parser, cond: bool) -> void:
            return if not cond
            parser, _ <- parser.expression()

        # Accept a specific token kind (discarding whether it matched) when COND holds.
        # Same tuple-guard-if parse gotcha as `advance_if` (parser_types_signature.elisa).
        def accept_if(parser: lmut Parser, kind: TokenKind, cond: bool) -> void:
            return if not cond
            parser, _ <- parser.accept(kind)

        # Skip a whole indented block, entered with the cursor just after the opening
        # `:`. Balances nested Indent/Dedent pairs; a no-operator if no block follows
        # (`depth` is loop-local, seeded to the one open Indent).
        def skip_indented_block(parser: lmut Parser) -> void:
            parser, _ <- parser.accept(TokenKind.Newline)
            rebind accepted_indent: bool, parser = parser.accept(TokenKind.Indent)
            return if not accepted_indent
            while depth > 0 and parser.peek() != TokenKind.Eof |parser, depth = 1|:
                rebind advanced_token: Token, parser = parser.advance()
                depth <- match advanced_token.kind:
                    TokenKind.Indent: depth + 1
                    TokenKind.Dedent: depth - 1
                    _: depth

        # Consume tokens through the end of the current logical line.
        def skip_to_line_end(parser: lmut Parser) -> void:
            while parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Eof |parser|:
                parser, _ <- parser.advance()

        # Collect an indented block of declaration units into a fresh `Decl.Scoped` node
        # (its own scope, tagged with `head`'s line), entered with the cursor on the
        # block-opening `:`. Each child is a full declaration-unit; a unit that consumes nothing
        # is force-advanced to guarantee progress. A no-operator if no `:`-block follows.
        def parse_scoped_block(parser: lmut Parser, out: mutable darray[Ast::Decl]&, head: Token) -> void:
            return if parser.peek() != TokenKind.Colon
            parser, _ <- parser.expect(TokenKind.Colon)
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)
            body: mutable darray[Ast::Decl] = []
            while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser|:
                parser <- parser.skip_newlines()
                break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof
                before: usize = parser.position
                parser <- parser.parse_declaration_unit(body)
                parser <- parser.advance_if(parser.position == before)
            parser, _ <- parser.expect(TokenKind.Dedent)
            out.push((Ast::Decl.Scoped(body, head.line)))

        def parse_declaration_unit(parser: lmut Parser, out: mutable darray[Ast::Decl]&) -> void:
            parser <- parser.parse_decorators()
            # Declaration layout modifier `packed enum …` / `packed struct …`: a
            # dedicated keyword (not an ident), so consume it and parse the qualified
            # declaration. Preserve the modifier until that declaration consumes it;
            # packed enums feed semantic Store validation through a File side-table.
            if parser.peek() == TokenKind.Packed:
                parser, _ <- parser.advance()
                parser.pending_packed_decl <- true
                if parser.peek() == TokenKind.Enum:
                    rebind packed_enum: Ast::Decl?, parser = parser.enum_declaration(false)
                    out.push(declaration) if packed_enum is declaration
                elif parser.peek() == TokenKind.Struct:
                    rebind packed_struct: Ast::Decl?, parser = parser.struct_declaration()
                    out.push(declaration) if packed_struct is declaration
                else:
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, parser.cursor())
                return
            if parser.peek() == TokenKind.Ident:
                current_token: Token = parser.cursor()
                text: sview = Lexer::text_or_empty(current_token, parser.source)
                # A recognized declaration keyword parses to an optional `Decl` node,
                # collected once below; `matched` stays true so the unit returns even
                # when the node is null. The three `out`-managing forms
                # (`using`/visibility/`impl`) collect themselves and return in-arm. A
                # non-keyword ident clears `matched` and falls through to the
                # compile-time forms.
                matched: mutable bool = true
                no_declaration: Ast::Decl? = null
                node: Ast::Decl? = match text:
                    # `extend Foo:` shares the module body grammar and is modeled as a
                    # Module node (member collection is identical — the canonical/duplicate
                    # checks the backend enforces aren't part of stage1's resolver).
                    "module" | "extend":
                        rebind __v_172: Ast::Decl?, parser = parser.module_declaration()
                        __v_172
                    "include":
                        rebind __v_173: Ast::Decl?, parser = parser.include_declaration()
                        __v_173
                    "type":
                        rebind __v_174: Ast::Decl?, parser = parser.type_alias_declaration()
                        __v_174
                    "alias":
                        rebind __v_175: Ast::Decl?, parser = parser.alias_declaration()
                        __v_175
                    "law":
                        rebind __v_176: Ast::Decl?, parser = parser.law_declaration()
                        __v_176
                    "refine":
                        rebind refine_decl: Ast::Decl?, parser = parser.refine_declaration()
                        refine_decl
                    "typestate":
                        rebind typestate_decl: Ast::Decl?, parser = parser.typestate_declaration(false)
                        typestate_decl
                    "contract":
                        rebind contract_decl: Ast::Decl?, parser = parser.contract_declaration()
                        contract_decl
                    "permission" | "effect" | "protocol":
                        rebind __v_177: Ast::Decl?, parser = parser.named_block_declaration()
                        __v_177
                    # Single-use discipline modifiers (`linear struct X:` / `affine struct
                    # X:`) — struct-only in stage0. struct_declaration parses the modifier itself
                    # (mirrors how it owns its `layout(...)` clause), so route straight
                    # there rather than discarding the modifier and recursing generically.
                    "linear" | "affine":
                        next_token: Token = parser.tokens[parser.position + 1]
                        next_text: sview = Lexer::text_or_empty(next_token, parser.source)
                        if text == "linear" and parser.peek_at(1) == TokenKind.Ident and next_text == "typestate":
                            rebind linear_typestate_decl: Ast::Decl?, parser = parser.typestate_declaration(true)
                            linear_typestate_decl
                        else:
                            rebind __v_182: Ast::Decl?, parser = parser.struct_declaration()
                            __v_182
                    # `using Foo` (wildcard), `using Foo::bar`/`using Foo.bar` (selective
                    # member), `using Foo as F` (qualifier alias) — drops/shortens a
                    # module qualifier. Not yet modeled in stage1's resolver (name lookup
                    # is whole-program, see module-visibility-and-qualified-construction),
                    # so consumed like other not-yet-modeled clauses.
                    "using":
                        parser <- parser.using_declaration()
                        return
                    "public" | "private":
                        parser <- parser.visibility_section(out)
                        return
                    "impl":
                        parser <- parser.impl_declaration(out)
                        return
                    _:
                        matched <- false
                        no_declaration
                if matched:
                    parser <- parser.push_opt(out, node)
                    return

            # `static if/elif/else COND:` compile-time conditional declarations, plus the
            # other compile-time forms: `static def NAME(...)` (compile-time function —
            # the marker is dropped and the function parses normally), `static generate:`
            # (an indented block of `emit …` templates, skipped whole), and
            # `static assert COND[, MSG]` / `static assert:` block (skipped).
            if parser.peek() == TokenKind.Static:
                rebind __v_209: bool, parser = parser.parse_static(out)
                return if __v_209

            # docs/120 §6: the declaration-collection conditional is dataflow — its branch
            # mutations are lifted into the `<-` target list (the manifest), not buried
            # in the branch bodies. `parser.declaration()` itself is a hot-path silent mutation
            # (parse_declaration_unit stays silent-tier — no declared threading — so its many
            # ambient parser mutations don't each demand a manifest; docs/120 §7 is for
            # boundaries with few, clean mutation points).
            rebind declaration_opt: Ast::Decl?, parser = parser.declaration()
            parser, out <-
                if declaration_opt is declaration:
                    parser, out.push(declaration)
                else:
                    parser.advance(), out


        def type_alias_declaration(parser: lmut Parser) -> Ast::Decl?:
            rebind token: Token, parser = parser.advance()          # consume the `type` identifier
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            # Optional generic params `[..]` between the name and `=`.
            rebind accepted_lbracket_2: bool, parser = parser.accept(TokenKind.LBracket)
            parser <- parser.skip_generic_param_group() if accepted_lbracket_2
            parser, _ <- parser.expect(TokenKind.Assign)
            target: mutable Ast::Expr = (Ast::Expr.Invalid)
            rebind target_opt: Ast::Expr?, parser = parser.expression()
            if target_opt is parsed_target:
                target <- parsed_target
            # Optional refinement predicate `type X = T where PRED` (e.g. `where 0 <=
            # self <= 100`) — preserve the predicate in a structured refinement node.
            where_token: Token = parser.cursor()
            has_where: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(where_token, parser.source) == "where"
            if has_where:
                parser, _ <- parser.advance()
                rebind predicate_opt: Ast::Expr?, parser = parser.expression()
                if predicate_opt is predicate:
                    target <- (Ast::Expr.Refinement(target, predicate, where_token.line))
            return (Ast::Decl.Alias(Lexer::text_or_empty(name_token, parser.source), target, token.line))

        # Skip the tokens of a generic-parameter group `[...]`, entered just past the
        # opening `[` (non-nesting — ends at the first `]`, matching the stage0 grammar).
        def skip_generic_param_group(parser: lmut Parser) -> void:
            while parser.peek() != TokenKind.RBracket and parser.peek() != TokenKind.Eof |parser|:
                parser, _ <- parser.advance()
            parser, _ <- parser.accept(TokenKind.RBracket)


        # `impl[params] Trait for Type:` (or inherent `impl Type:`) — a trait/inherent
        # implementation block. The header (`[params] Trait for Type`) is skipped to the
        # colon; the body's method declarations are captured in a `Decl.Scoped` node (its
        # own scope) so a method with the same signature in another impl — e.g.
        # `br_remaining(self: Self)` implemented for two types — is not a duplicate.
        def impl_declaration(parser: lmut Parser, out: mutable darray[Ast::Decl]&) -> void:
            head: Token = parser.cursor()
            parser, _ <- parser.advance()                           # consume the `impl` identifier
            # Retain the simple `impl Interface for Concrete:` fact. Generic and
            # qualified impl headers continue through the ordinary skipped-header path.
            if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Ident and parser.peek_at(2) == TokenKind.Ident:
                interface_token: Token = parser.cursor()
                for_token: Token = parser.tokens[parser.position + 1]
                concrete_token: Token = parser.tokens[parser.position + 2]
                interface_name: sview = Lexer::text_or_empty(interface_token, parser.source)
                for_text: sview = Lexer::text_or_empty(for_token, parser.source)
                concrete_name: sview = Lexer::text_or_empty(concrete_token, parser.source)
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: concrete_name, name: interface_name, line: 0}) if for_text == "for"
            parser <- parser.skip_declaration_header_clauses()
            parser <- parser.parse_scoped_block(out, head)


        # `permission Name:` / `effect Name:` / `protocol Name:` — a named declaration
        # with an indented member block (capability sets, effect families, protocol
        # method signatures). Header clauses + the whole indented body are skipped; the
        # name is recorded as an Alias node. Returns null if there is no block.
        def named_block_declaration(parser: lmut Parser) -> Ast::Decl?:
            rebind token: Token, parser = parser.advance()              # consume the contextual keyword
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            # Skip the header clauses up to the block-opening colon. A protocol may carry
            # an `is Parent[, Parent]` supertype clause (`protocol X is Parent:`), so the
            # block opener is the colon followed by a newline, not the first colon seen.
            while parser.peek() != TokenKind.Eof |parser, depth = 0|:
                header_kind: TokenKind = parser.peek()
                break if depth == 0 and header_kind == TokenKind.Newline
                break if depth == 0 and header_kind == TokenKind.Colon and parser.peek_at(1) == TokenKind.Newline
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, parser.cursor()) if depth == 0 and header_kind == TokenKind.Colon
                depth <- match header_kind:
                    TokenKind.LParen | TokenKind.LBracket: depth + 1
                    TokenKind.RParen | TokenKind.RBracket: depth - 1
                    _: depth
                parser, _ <- parser.advance()
            rebind accepted_colon_2: bool, parser = parser.accept(TokenKind.Colon)
            declaration_kind: sview = Lexer::text_or_empty(token, parser.source)
            parser <- parser.reject_protocol_method_bodies() if accepted_colon_2 and declaration_kind == "protocol"
            parser <- parser.skip_indented_block() if accepted_colon_2
            return (Ast::Decl.Alias(Lexer::text_or_empty(name_token, parser.source), (Ast::Expr.Invalid), token.line))

        def reject_protocol_method_bodies(parser: lmut Parser) -> void:
            scan: mutable usize = 0
            indent_depth: mutable int = 0
            while parser.peek_at(scan) != TokenKind.Eof |parser, scan, indent_depth|:
                kind: TokenKind = parser.peek_at(scan)
                scanned: Token = parser.tokens[parser.position + scan]
                indent_depth <- indent_depth + 1 if kind == TokenKind.Indent
                indent_depth <- indent_depth - 1 if kind == TokenKind.Dedent
                break if kind == TokenKind.Dedent and indent_depth == 0
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, scanned) if indent_depth >= 2 and kind in {TokenKind.Assign, TokenKind.LArrow}
                scan <- scan + 1


        # `static if/elif/else COND:` compile-time conditional declarations. Each branch
        # body is collected into its OWN `Decl.Conditional` node (a separate scope) so a
        # name declared in multiple branches — a per-backend `mutex_init` — is not a
        # duplicate. Branch selection isn't evaluated (all branches are kept); the
        # `static elif`/`static else` continuation is consumed recursively.
        def static_if_declaration(parser: lmut Parser, out: mutable darray[Ast::Decl]&) -> void:
            head: Token = parser.cursor()
            parser, _ <- parser.advance()                           # `static`
            matched_head: bool = parser.peek() in {TokenKind.If, TokenKind.Elif}
            parser <- parser.advance_if(matched_head)                # `if` / `elif`
            parser <- parser.skip_expression_if(matched_head)        # compile-time condition (consumed)
            parser <- parser.accept_if(TokenKind.Else, not matched_head)

            parser <- parser.parse_scoped_block(out, head)

            parser <- parser.skip_newlines()
            has_continuation: bool = parser.peek() == TokenKind.Static and parser.peek_at(1) in {TokenKind.Elif, TokenKind.Else}
            parser <- parser.static_if_declaration(out) if has_continuation


        # `law Name(params) = <predicate>` algebraic/refinement law. Skip the header
        # parameter list to its top-level `=`, then parse the predicate through the normal
        # expression parser so quantifiers and operators remain structured.
        def law_declaration(parser: lmut Parser) -> Ast::Decl?:
            rebind token: Token, parser = parser.advance()              # consume the `law` identifier
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            while parser.peek() != TokenKind.Assign and parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Eof |parser, depth: int = 0|:
                kind: TokenKind = parser.peek()
                depth <- depth + 1 if kind in {TokenKind.LParen, TokenKind.LBracket, TokenKind.LBrace}
                depth <- depth - 1 if kind in {TokenKind.RParen, TokenKind.RBracket, TokenKind.RBrace}
                parser, _ <- parser.advance()
            parser, _ <- parser.accept(TokenKind.Assign)
            predicate: mutable Ast::Expr = (Ast::Expr.Invalid)
            rebind predicate_option: Ast::Expr?, parser = parser.expression()
            predicate <- parsed_predicate if predicate_option is parsed_predicate
            return (Ast::Decl.Law(Lexer::text_or_empty(name_token, parser.source), predicate, token.line))

        # Named refinement sugar: `refine Name[Ts](params) = Base where predicate`.
        # Stage1 represents it with the same structured Alias+Refinement shape as a
        # `type` refinement while consuming both generic and value parameter headers.
        def refine_declaration(parser: lmut Parser) -> Ast::Decl?:
            rebind token: Token, parser = parser.advance()
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            rebind has_generic_params: bool, parser = parser.accept(TokenKind.LBracket)
            parser <- parser.skip_bracketed_group() if has_generic_params
            rebind has_value_params: bool, parser = parser.accept(TokenKind.LParen)
            parser <- parser.skip_refine_value_params() if has_value_params
            parser, _ <- parser.expect(TokenKind.Assign)
            rebind base_opt: Ast::Expr?, parser = parser.expression()
            base: mutable Ast::Expr = get base_opt else (Ast::Expr.Invalid)
            where_token: Token = parser.cursor()
            if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(where_token, parser.source) == "where":
                parser, _ <- parser.advance()
                rebind predicate_opt: Ast::Expr?, parser = parser.expression()
                if predicate_opt is predicate:
                    base <- (Ast::Expr.Refinement(base, predicate, where_token.line))
            return (Ast::Decl.Alias(Lexer::text_or_empty(name_token, parser.source), base, token.line))

        def skip_refine_value_params(parser: lmut Parser) -> void:
            while parser.peek() != TokenKind.RParen and parser.peek() != TokenKind.Eof |parser|:
                parser, _ <- parser.advance()
            parser, _ <- parser.expect(TokenKind.RParen)

        def typestate_name_exists(names: darray[sview], candidate: sview) -> bool:
            for name in names:
                true return if name == candidate
            return false

        # Parse the legacy typestate declaration sugar and expose its state-bearing
        # aggregate plus transition functions through existing stage1 AST nodes.
        def typestate_declaration(parser: lmut Parser, is_linear: bool) -> Ast::Decl?:
            parser, _ <- parser.advance() if is_linear                 # `linear`
            rebind token: Token, parser = parser.advance()             # `typestate`
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            parser, _ <- parser.expect(TokenKind.Colon)
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)
            states: mutable darray[sview] = []
            while parser.peek() not in {TokenKind.Dedent, TokenKind.Eof} |parser, states|:
                parser <- parser.skip_newlines()
                break if parser.peek() in {TokenKind.Dedent, TokenKind.Eof}
                line_head: Token = parser.cursor()
                head_text: sview = Lexer::text_or_empty(line_head, parser.source)
                if head_text == "states":
                    parser, _ <- parser.advance()
                    parser, _ <- parser.expect(TokenKind.Colon)
                    while parser.peek() not in {TokenKind.Newline, TokenKind.Dedent, TokenKind.Eof} |parser, states|:
                        if parser.peek() == TokenKind.Ident:
                            rebind state_token: Token, parser = parser.advance()
                            states.push(Lexer::text_or_empty(state_token, parser.source))
                        else:
                            parser, _ <- parser.advance()
                elif head_text == "terminal":
                    parser, _ <- parser.advance()
                    parser, _ <- parser.expect(TokenKind.Colon)
                    rebind terminal_token: Token, parser = parser.expect(TokenKind.Ident)
                    terminal_name: sview = Lexer::text_or_empty(terminal_token, parser.source)
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, terminal_token) if not typestate_name_exists(states, terminal_name)
                elif head_text == "transition":
                    parser, _ <- parser.advance()
                    rebind transition_name: Token, parser = parser.expect(TokenKind.Ident)
                    rebind has_transition_params: bool, parser = parser.accept(TokenKind.LParen)
                    if has_transition_params:
                        while parser.peek() != TokenKind.RParen and parser.peek() != TokenKind.Eof |parser|:
                            parser, _ <- parser.advance()
                        parser, _ <- parser.expect(TokenKind.RParen)
                    parser, _ <- parser.expect(TokenKind.Colon)
                    rebind source_state: Token, parser = parser.expect(TokenKind.Ident)
                    parser, _ <- parser.expect(TokenKind.Arrow)
                    rebind target_state: Token, parser = parser.expect(TokenKind.Ident)
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, source_state) if not typestate_name_exists(states, Lexer::text_or_empty(source_state, parser.source))
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, target_state) if not typestate_name_exists(states, Lexer::text_or_empty(target_state, parser.source))
                    rebind has_other_target: bool, parser = parser.accept(TokenKind.Pipe)
                    if has_other_target:
                        rebind other_target: Token, parser = parser.expect(TokenKind.Ident)
                        parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, other_target) if not typestate_name_exists(states, Lexer::text_or_empty(other_target, parser.source))
                    no_params: darray[Ast::ParamDecl] = []
                    no_body: darray[Ast::Stmt] = []
                    no_effects: darray[sview] = []
                    no_decorators: darray[Ast::Annotation] = []
                    parser.pending_decls <- parser.pending_decls.push((Ast::Decl.Func(Lexer::text_or_empty(transition_name, parser.source), no_params, null, no_body, no_effects, no_decorators, transition_name.line)))
                while parser.peek() not in {TokenKind.Newline, TokenKind.Dedent, TokenKind.Eof} |parser|:
                    parser, _ <- parser.advance()
                parser, _ <- parser.accept(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Dedent)
            no_members: darray[Ast::StructMember] = []
            no_invariants: darray[Ast::Expr] = []
            affinity: sview = "linear" if is_linear else ""
            return (Ast::Decl.Struct(Lexer::text_or_empty(name_token, parser.source), no_members, affinity, true, true, no_invariants, token.line))

        # Named contract declaration; structurally a function whose body consists of
        # contract statements. This keeps its symbol and parameter scope available.
        def contract_declaration(parser: lmut Parser) -> Ast::Decl?:
            rebind token: Token, parser = parser.advance()
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            params: mutable darray[Ast::ParamDecl] = []
            rebind has_params: bool, parser = parser.accept(TokenKind.LParen)
            parser <- parser.parse_param_list(params, 0) if has_params
            rebind body: darray[Ast::Stmt], parser = parser.parse_block()
            no_effects: darray[sview] = []
            no_decorators: darray[Ast::Annotation] = []
            return (Ast::Decl.Func(Lexer::text_or_empty(name_token, parser.source), params, null, body, no_effects, no_decorators, token.line))


        # `alias Name = <effect-list>` / `alias Name = <type>` (effect-set / capability
        # aliases). The RHS is a comma-separated list of dotted effect names; consume the
        # whole line after `=` since the list/effect grammar isn't modeled yet.
        def alias_declaration(parser: lmut Parser) -> Ast::Decl?:
            rebind token: Token, parser = parser.advance()              # consume the `alias` identifier
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            rebind accepted_assign: bool, parser = parser.accept(TokenKind.Assign)
            while accepted_assign and parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser|:
                parser, _ <- parser.advance()
            return (Ast::Decl.Alias(Lexer::text_or_empty(name_token, parser.source), (Ast::Expr.Invalid), token.line))
