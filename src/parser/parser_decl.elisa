# Stage1 parser — declaration parsing, part 1 (`extend Parser: private:`). Covers
# decorators, the declaration-unit dispatcher, modules/`using`/`include`, type aliases,
# `impl`/named-block/`static if`/law/alias decls, and the top-level `decl` dispatcher.
# Struct/enum/const declarations and the public `parse_file` entry point continue in
# parser_types.elisa. Split out of parser.elisa to keep each part file under 600 lines.

extend Parser:
    private:
        # ============================================================
        # Declaration parsing
        # ============================================================

        # Parse one declaration unit into `out`. A single keyword decl appends one
        # node; `module`/visibility sections (`public:`/`private:`) append their
        # flattened children. `module`/`include`/`public`/`private` are contextual
        # keywords (the lexer emits them as identifiers), matched here by text.
        # Consume any leading `@name` / `@name(args)` decorators before a declaration
        # (e.g. `@inline(always)`, `@hot`, `@test`), recording each bare decorator name
        # into `parser.pending_decorators` (cleared in place first) for the declaration
        # that follows to pick up. Arguments are consumed but not modeled.
        def parse_decorators(parser: mutable Parser&) -> void:
            parser.pending_decorators.truncate(0)
            while parser.peek() == TokenKind.At:
                parser.advance()                   # `@`
                # Bracketed attribute-list form `@[a, b, c]` — equivalent to writing each
                # `@a`/`@b`/`@c` on its own line; each name is recorded as a decorator (an
                # attribute may carry its own `(...)` args, e.g. `@[align(64), packed]`).
                if parser.accept(TokenKind.LBracket):
                    while parser.peek() != TokenKind.RBracket and parser.peek() != TokenKind.Eof:
                        if parser.peek() == TokenKind.Ident:
                            parser.pending_decorators.push(parser.parse_dotted_name())
                            if parser.accept(TokenKind.LParen):
                                d2: mutable int = 1
                                while d2 > 0 and parser.peek() != TokenKind.Eof:
                                    k2: TokenKind = parser.advance().kind
                                    d2 <- match k2:
                                        TokenKind.LParen: d2 + 1
                                        TokenKind.RParen: d2 - 1
                                        _: d2
                        if not parser.accept(TokenKind.Comma):
                            break
                    parser.accept(TokenKind.RBracket)
                    parser.skip_newlines()
                else:
                    if parser.peek() == TokenKind.Ident:
                        parser.pending_decorators.push(parser.parse_dotted_name())
                    if parser.accept(TokenKind.LParen):
                        depth: mutable int = 1
                        while depth > 0 and parser.peek() != TokenKind.Eof:
                            kind: TokenKind = parser.advance().kind
                            if kind == TokenKind.LParen:
                                depth <- depth + 1
                            elif kind == TokenKind.RParen:
                                depth <- depth - 1
                    parser.skip_newlines()


        def parse_decl_unit(parser: mutable Parser&, out: mutable darray[Ast::Decl]&) -> void:
            parser.parse_decorators()
            # Declaration layout modifier `packed enum …` / `packed struct …`: a
            # dedicated keyword (not an ident), so consume it and parse the qualified
            # declaration. Layout is not modeled in stage1's parse/resolve.
            if parser.peek() == TokenKind.Packed:
                parser.advance()
                parser.parse_decl_unit(out)
                return
            if parser.peek() == TokenKind.Ident:
                cur: Token = parser.cursor()
                text: sview = Lexer::text_or_empty(cur, parser.source)
                match text:
                    "module":
                        if parser.module_decl() is mod:
                            out.push(mod)
                        return
                    # `extend Foo:` shares the module body grammar; modeled as a Module node
                    # (member collection is identical — the canonical/duplicate checks the
                    # backend enforces aren't part of stage1's resolver).
                    "extend":
                        if parser.module_decl() is ext:
                            out.push(ext)
                        return
                    "include":
                        if parser.include_decl() is inc:
                            out.push(inc)
                        return
                    # `using Foo` (wildcard), `using Foo::bar`/`using Foo.bar` (selective
                    # member), `using Foo as F` (qualifier alias) — drops/shortens a
                    # module qualifier. Not yet modeled in stage1's resolver (name lookup
                    # is whole-program, see module-visibility-and-qualified-construction),
                    # so consumed like other not-yet-modeled clauses.
                    "using":
                        parser.using_decl()
                        return
                    "public" | "private":
                        parser.visibility_section(out)
                        return
                    "type":
                        if parser.type_alias_decl() is alias:
                            out.push(alias)
                        return
                    "alias":
                        if parser.alias_decl() is alias_node:
                            out.push(alias_node)
                        return
                    "law":
                        if parser.law_decl() is law_node:
                            out.push(law_node)
                        return
                    "permission" | "effect" | "protocol":
                        if parser.named_block_decl() is block_node:
                            out.push(block_node)
                        return
                    "impl":
                        parser.impl_decl(out)
                        return
                    # Single-use discipline modifiers (`linear struct X:` / `affine
                    # struct X:`) — struct-only in stage0 (no enum/other form).
                    # struct_decl parses the modifier itself (mirrors how it also
                    # owns its `layout(...)` clause), so route straight there rather
                    # than discarding the modifier and recursing generically.
                    "linear" | "affine":
                        if parser.struct_decl() is struct_node:
                            out.push(struct_node)
                        return
                    _:
                        pass

            # `static if/elif/else COND:` compile-time conditional declarations, plus the
            # other compile-time forms: `static def NAME(...)` (compile-time function —
            # the marker is dropped and the function parses normally), `static generate:`
            # (an indented block of `emit …` templates, skipped whole), and
            # `static assert COND[, MSG]` / `static assert:` block (skipped).
            if parser.peek() == TokenKind.Static:
                n1: TokenKind = parser.peek_at(1)
                if n1 == TokenKind.If or n1 == TokenKind.Elif or n1 == TokenKind.Else:
                    parser.static_if_decl(out)
                    return
                if n1 == TokenKind.Def:
                    parser.advance()               # `static` (compile-time marker)
                    if parser.func_decl() is sfn:
                        out.push(sfn)
                    return
                if n1 == TokenKind.Ident:
                    static_saved: usize = parser.position
                    parser.advance()               # `static`
                    directive_tok: Token = parser.cursor()
                    directive: sview = Lexer::text_or_empty(directive_tok, parser.source)
                    if directive == "generate" or directive == "assert":
                        parser.advance()           # the directive name
                        # Block form (`static generate:` / `static assert:`): skip the
                        # whole indented block. Line form (`static assert COND[, MSG]`):
                        # skip to end of line.
                        if parser.accept(TokenKind.Colon):
                            parser.accept(TokenKind.Newline)
                            if parser.accept(TokenKind.Indent):
                                sdepth =
                                    while sdepth > 0 and parser.peek() != TokenKind.Eof |parser, sdepth=1| -> sdepth:
                                        sk: TokenKind = parser.advance().kind
                                        sdepth <- match sk:
                                            TokenKind.Indent: sdepth + 1
                                            TokenKind.Dedent: sdepth - 1
                                            _: sdepth
                        else:
                            while parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Eof:
                                parser.advance()
                        return
                    # Not a recognized directive — rewind and fall through to decl().
                    parser.position <- static_saved

            if parser.decl() is d:
                out.push(d)
            else:
                parser.advance()


        # `type Name = <target-type>` (optionally `type Name[params] = ...`). The target
        # is parsed as an expression (type expressions reuse the expression grammar).
        def type_alias_decl(parser: mutable Parser&) -> Ast::Decl?:
            tok: Token = parser.advance()          # consume the `type` identifier
            name_tok: Token = parser.expect(TokenKind.Ident)
            # Optional generic params `[..]` between the name and `=`.
            if parser.accept(TokenKind.LBracket):
                while parser.peek() != TokenKind.RBracket and parser.peek() != TokenKind.Eof:
                    parser.advance()
                parser.accept(TokenKind.RBracket)
            parser.expect(TokenKind.Assign)
            if parser.expr() is target:
                # Optional refinement predicate `type X = T where PRED` (e.g. `where 0 <=
                # self <= 100`) — narrows the alias to values satisfying PRED. Not yet
                # modeled on `Decl.Alias`; consumed so the clause doesn't leak into the
                # next top-level declaration and cascade.
                where_tok: Token = parser.cursor()
                if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(where_tok, parser.source) == "where":
                    parser.advance()
                    parser.expr()
                return (Ast::Decl.Alias(Lexer::text_or_empty(name_tok, parser.source), target, tok.line))
            return null


        # `impl[params] Trait for Type:` (or inherent `impl Type:`) — a trait/inherent
        # implementation block. The header (`[params] Trait for Type`) is skipped to the
        # colon; the body's method declarations are captured in a `Decl.Scoped` node (its
        # own scope) so a method with the same signature in another impl — e.g.
        # `br_remaining(self: Self)` implemented for two types — is not a duplicate.
        def impl_decl(parser: mutable Parser&, out: mutable darray[Ast::Decl]&) -> void:
            head: Token = parser.cursor()
            parser.advance()                           # consume the `impl` identifier
            parser.skip_decl_header_clauses()
            if parser.peek() == TokenKind.Colon:
                parser.expect(TokenKind.Colon)
                parser.expect(TokenKind.Newline)
                parser.expect(TokenKind.Indent)
                body: mutable darray[Ast::Decl] = []
                while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof:
                    parser.skip_newlines()
                    if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof:
                        break
                    before: usize = parser.position
                    parser.parse_decl_unit(body)
                    if parser.position == before:
                        parser.advance()
                parser.expect(TokenKind.Dedent)
                out.push((Ast::Decl.Scoped(body, head.line)))


        # `permission Name:` / `effect Name:` / `protocol Name:` — a named declaration
        # with an indented member block (capability sets, effect families, protocol
        # method signatures). Header clauses + the whole indented body are skipped; the
        # name is recorded as an Alias node. Returns null if there is no block.
        def named_block_decl(parser: mutable Parser&) -> Ast::Decl?:
            tok: Token = parser.advance()              # consume the contextual keyword
            name_tok: Token = parser.expect(TokenKind.Ident)
            # Skip the header clauses up to the block-opening colon. A protocol may carry
            # an `is Parent[, Parent]` supertype clause (`protocol X is Parent:`), so the
            # block opener is the colon followed by a newline, not the first colon seen.
            depth: mutable int = 0
            while parser.peek() != TokenKind.Eof:
                hk: TokenKind = parser.peek()
                if hk in {TokenKind.LParen, TokenKind.LBracket}:
                    depth <- depth + 1
                    parser.advance()
                elif hk in {TokenKind.RParen, TokenKind.RBracket}:
                    depth <- depth - 1
                    parser.advance()
                elif depth == 0 and hk == TokenKind.Newline:
                    break
                elif depth == 0 and hk == TokenKind.Colon and parser.peek_at(1) == TokenKind.Newline:
                    break
                else:
                    parser.advance()
            if parser.peek() == TokenKind.Colon:
                parser.advance()
                if parser.accept(TokenKind.Newline) and parser.accept(TokenKind.Indent):
                    depth: mutable int = 1
                    while depth > 0 and parser.peek() != TokenKind.Eof:
                        kind: TokenKind = parser.advance().kind
                        if kind == TokenKind.Indent:
                            depth <- depth + 1
                        elif kind == TokenKind.Dedent:
                            depth <- depth - 1
            return (Ast::Decl.Alias(Lexer::text_or_empty(name_tok, parser.source), (Ast::Expr.Invalid), tok.line))


        # `static if/elif/else COND:` compile-time conditional declarations. Each branch
        # body is collected into its OWN `Decl.Conditional` node (a separate scope) so a
        # name declared in multiple branches — a per-backend `mutex_init` — is not a
        # duplicate. Branch selection isn't evaluated (all branches are kept); the
        # `static elif`/`static else` continuation is consumed recursively.
        def static_if_decl(parser: mutable Parser&, out: mutable darray[Ast::Decl]&) -> void:
            head: Token = parser.cursor()
            parser.advance()                           # `static`
            if parser.accept(TokenKind.If) or parser.accept(TokenKind.Elif):
                parser.expr()                          # compile-time condition (consumed)
            else:
                parser.accept(TokenKind.Else)

            if parser.peek() == TokenKind.Colon:
                parser.expect(TokenKind.Colon)
                parser.expect(TokenKind.Newline)
                parser.expect(TokenKind.Indent)
                branch: mutable darray[Ast::Decl] = []
                while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof:
                    parser.skip_newlines()
                    if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof:
                        break
                    before: usize = parser.position
                    parser.parse_decl_unit(branch)
                    if parser.position == before:
                        parser.advance()
                parser.expect(TokenKind.Dedent)
                out.push((Ast::Decl.Scoped(branch, head.line)))

            parser.skip_newlines()
            if parser.peek() == TokenKind.Static:
                n1: TokenKind = parser.peek_at(1)
                if n1 in {TokenKind.Elif, TokenKind.Else}:
                    parser.static_if_decl(out)


        # `law Name(params) = <predicate>` algebraic/refinement law. The predicate uses
        # quantifier syntax (`forall i in 0..<n: P`) not yet decomposed into an AST, so the
        # raw source span after the law name (params + `=` + body) is preserved on the
        # `Law` node up to the terminating newline — lossless for a later verification
        # pass. Consumed paren/bracket/brace-balanced so a nested `,`/newline stays whole.
        def law_decl(parser: mutable Parser&) -> Ast::Decl?:
            tok: Token = parser.advance()              # consume the `law` identifier
            name_tok: Token = parser.expect(TokenKind.Ident)
            pred_start: usize = parser.cursor().start.usize()
            pred_end: mutable usize = pred_start
            depth: mutable int = 0
            while parser.peek() != TokenKind.Eof:
                kind: TokenKind = parser.peek()
                if kind in {TokenKind.LParen, TokenKind.LBracket, TokenKind.LBrace}:
                    depth <- depth + 1
                elif kind in {TokenKind.RParen, TokenKind.RBracket, TokenKind.RBrace}:
                    depth <- depth - 1
                elif depth == 0 and kind in {TokenKind.Newline, TokenKind.Dedent}:
                    break
                consumed: Token = parser.advance()
                pred_end <- consumed.start.usize() + consumed.length.usize()
            predicate: sview = parser.span_view(pred_start, pred_end)
            return (Ast::Decl.Law(Lexer::text_or_empty(name_tok, parser.source), predicate, tok.line))


        # `alias Name = <effect-list>` / `alias Name = <type>` (effect-set / capability
        # aliases). The RHS is a comma-separated list of dotted effect names; consume the
        # whole line after `=` since the list/effect grammar isn't modeled yet.
        def alias_decl(parser: mutable Parser&) -> Ast::Decl?:
            tok: Token = parser.advance()              # consume the `alias` identifier
            name_tok: Token = parser.expect(TokenKind.Ident)
            if parser.accept(TokenKind.Assign):
                while parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof:
                    parser.advance()
            return (Ast::Decl.Alias(Lexer::text_or_empty(name_tok, parser.source), (Ast::Expr.Invalid), tok.line))


