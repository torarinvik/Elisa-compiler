# Structured abstract-effect type references. Capture source token ranges during
# the ordinary scan, then parse their type applications after forward effect
# declarations are known. These nodes are compiler metadata, never runtime values.
extend Parser:
    private:
        def record_effect_reference(parser: lmut Parser, start: usize, finish: usize) -> void:
            return if finish <= start
            parser.effect_reference_starts <- parser.effect_reference_starts.push(start)
            parser.effect_reference_ends <- parser.effect_reference_ends.push(finish)
            parser.effect_reference_owners <- parser.effect_reference_owners.push(parser.current_module)

        def materialize_effect_type_references(parser: lmut Parser) -> void:
            saved_position: usize = parser.position
            saved_module: sview = parser.current_module
            reference_count: usize = parser.effect_reference_starts.count
            for index in 0..<reference_count |parser|:
                first: usize = parser.effect_reference_starts[index]
                finish: usize = parser.effect_reference_ends[index]
                first_token: Token = parser.tokens[first]
                last_token: Token = parser.tokens[finish - 1.usize()]
                spelling: sview = parser.span_view(first_token.start.usize(), last_token.start.usize() + last_token.length.usize())
                continue if not parser.effect_template_row_is_abstract(spelling)
                parser.position <- first
                parser.current_module <- parser.effect_reference_owners[index]
                rebind type_expression_opt: Ast::Expr?, parser = parser.expression()
                if type_expression_opt is type_expression:
                    identity_id: u32 = parser.effect_identity_for_reference(spelling, parser.effect_reference_owners[index])
                    parser.effect_type_references <- parser.effect_type_references.push(Ast::EffectTypeReference{spelling: spelling, type_expression: type_expression, position: Ast::pos_of_token(first_token), lexical_owner: parser.effect_reference_owners[index], identity_id: identity_id})
            parser.position <- saved_position
            parser.current_module <- saved_module
