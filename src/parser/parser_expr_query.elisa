extend Parser:
    private:
        # Find an Index inside the shape used for a checked access. Return false for every
        # other expression so `get (opt)` keeps the Paren node's retained root position.
        def checked_get_index_position(expression: Ast::Expr) -> (found: bool, position: Ast::Pos):
            can Abort.Panic:
                match expression:
                    Ast::Expr.Index(_, _, index_position):
                        return (true, index_position)
                    Ast::Expr.Paren(inner, _):
                        return checked_get_index_position(inner)
                    Ast::Expr.Binary(left, operator, _, _) if operator == TokenKind.Else:
                        return checked_get_index_position(left)
                    _:
                        return (false, Ast::expr_pos(expression))

        # Value fallbacks are represented as Binary(Index, Else, fallback), so normalize
        # that form (and parens around an Index) to the owning Index. Non-index results keep
        # their original root position, including `get (opt)`.
        def checked_get_owner_position(expression: Ast::Expr) -> Ast::Pos:
            can Abort.Panic:
                checked_index: (found: bool, position: Ast::Pos) = checked_get_index_position(expression)
                return checked_index.position if checked_index.found
                return Ast::expr_pos(expression)

        # `get EXPR else <recovery>`: yields the guarded EXPR's value. The `else` clause
        # is consumed but not modeled — a control-flow statement (`return`/`break`/
        # `continue`) or a fallback expression. The guarded expression is returned as the
        # node (the recovery semantics are erased until an explicit Get/Try node exists).
        def get_expression(parser: lmut Parser) -> Ast::Expr?:
            rebind get_token: Token, parser = parser.advance()      # consume `get`
            rebind inner: Ast::Expr?, parser = parser.expression() can Global{Read,Write}
            rebind accepted_else: bool, parser = parser.accept(TokenKind.Else)
            if get_token.kind == TokenKind.Try and not accepted_else:
                try_owner: sview = parser.try_expression_owner(try_expression) if inner is try_expression else "__noncall"
                rebind lexical_module_id: u32, parser = parser.effect_identity_for_current_declaration("__try_lexical_module")
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: try_owner, name: "__try_without_else", line: get_token.line, offset: get_token.start, identity_id: lexical_module_id, pos: Ast::pos_of_token(get_token)})
                if inner is try_expression:
                    # The AST keeps the guarded expression but drops the `try` head.
                    # Preserve the expression root's raw source identity so backend
                    # inference can distinguish `try value`/`try f()` from an ordinary
                    # ErrorUnion value without borrowing a logical #line.
                    propagating_expr_pos: Ast::Pos = Ast::expr_pos(try_expression)
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__try_propagating_expr", name: "", line: propagating_expr_pos.line, offset: propagating_expr_pos.offset, pos: propagating_expr_pos})
                    call_arity: (known: bool, value: u32) = parser.try_expression_call_arity(try_expression)
                    # Store the argument count on its own call-offset row. The Try checker
                    # uses symbol arity ranges to distinguish same-name overloads before
                    # comparing their error sets.
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__try_callee_arity", name: "", line: get_token.line, offset: get_token.start, identity_id: call_arity.value}) if call_arity.known
                    parser <- parser.try_expression_record_named_arguments(try_expression, get_token.line, get_token.start) can Global{Read,Write}
                # `try Mods::B::step(...)` names the module explicitly; retain the full
                # qualifier so family lookup distinguishes paths that share a last segment.
                try_qualifier: sview @source = parser.try_expression_qualifier(try_expression) if inner is try_expression else ""
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__try_callee_module", name: try_qualifier, line: get_token.line, offset: get_token.start}) if try_qualifier != ""
            fallback: mutable Ast::Expr? = null
            # The control-flow recovery, RETAINED (not discarded): `get f() else return 7`
            # binds a `T`, and the early return is the only reason that is sound.
            recovery: mutable darray[Ast::Stmt] @source = []
            if accepted_else:
                match parser.peek():
                    # `raise` belongs here, not with the value fallbacks below: it TERMINATES.
                    # Parsed as an expression it became the fallback half of a Refinement node,
                    # which types the recovered expression by a value the branch never produces
                    # -- so `ptr: T = get alloc(n) else raise MemoryError.OutOfMemory` lost the
                    # branch that makes unwrapping the optional sound.
                    TokenKind.Return | TokenKind.Raise | TokenKind.Break | TokenKind.Continue:
                        rebind recovery_statement: Ast::Stmt?, parser = parser.statement() can Global{Read,Write}
                        recovery.push(recovery_statement_value) if recovery_statement is recovery_statement_value
                    TokenKind.Ident if parser.peek_at(1) == TokenKind.Colon:
                        # Error-binding recovery: `try f() else err: BLOCK`. RETAIN the block
                        # in the GetElse node so its statements (a `raise`, a call) are walked
                        # by later passes rather than silently discarded.
                        parser, _ <- parser.advance()
                        rebind recovery_block: darray[Ast::Stmt], parser = parser.parse_block() can Global{Read,Write}
                        recovery.extend(recovery_block)
                    _:
                        parser, fallback <- parser.expression() can Global{Read,Write}               # fallback-expression else-clause
            # A value fallback determines the recovered expression's non-optional
            # result type while the guarded optional is still retained and walked.
            # Refinement(base, predicate) provides exactly that two-child shape:
            # semantic type inference follows the base; resolution visits both.
            if fallback is fallback_expression:
                if inner is guarded_expression:
                    # `check_try_fallible` only needs its extra AST walk when a try value
                    # fallback produced this Refinement node. Keep the marker narrow so
                    # ordinary `get` fallbacks and control-flow recovery don't trigger it.
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__try_fallback_expression", name: "", line: get_token.line, offset: get_token.start}) if get_token.kind == TokenKind.Try
                    return (Ast::Expr.Refinement(fallback_expression, guarded_expression, Ast::pos_of_token(get_token)))
            # A CONTROL-FLOW recovery keeps its body, so the guarded optional and the branch
            # that makes unwrapping it sound stay in one node.
            if inner is control_flow_guarded:
                recovered: Ast::Expr? = (Ast::Expr.GetElse(control_flow_guarded, recovery, Ast::pos_of_token(get_token)))
                return recovered if recovery.count > 0
            # A `get xs[i]` returns the inner expression unchanged (an optional-producing
            # checked access), so its checked-ness would be lost to later passes. Anchor the
            # marker to the owning Index: for `get xs[i] else value`, the postfix parser has
            # retained Binary(Index, Else, fallback), and every index consumer sees the same
            # Index position. Bare `get xs[i]` already has that Index as its root.
            checked_get_position: Ast::Pos = checked_get_owner_position(checked_get_expression) if inner is checked_get_expression else Ast::pos_of_token(get_token)
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__checked_get", name: "", line: checked_get_position.line, offset: checked_get_position.offset, pos: checked_get_position})
            return inner

        # Find the first source byte of the module path while preserving the exact full
        # qualifier span for later scope checks.
        def try_expression_qualifier_start(expression: Ast::Expr) -> (found: bool, offset: u32):
            can Abort.Panic:
                match expression:
                    Ast::Expr.Ident(_, pos):
                        return (true, pos.offset)
                    Ast::Expr.Scope(base, _, _):
                        return try_expression_qualifier_start(base)
                    Ast::Expr.Paren(inner, _):
                        return try_expression_qualifier_start(inner)
                    _:
                        return (false, 0)

        def try_expression_qualifier(parser: Parser&, expression: Ast::Expr) -> sview @source:
            can Abort.Panic:
                match expression:
                    Ast::Expr.Paren(inner, _):
                        return parser.try_expression_qualifier(inner)
                    Ast::Expr.Call(qualifier_callee, qualifier_arguments, qualifier_names, qualifier_line):
                        match qualifier_callee:
                            Ast::Expr.Scope(qualifier_base, qualifier_name, qualifier_scope_line):
                                path_start: (found: bool, offset: u32) = try_expression_qualifier_start(qualifier_base)
                                return parser.span_view(path_start.offset.usize(), qualifier_scope_line.offset.usize()) if path_start.found and qualifier_scope_line.offset >= path_start.offset
                                return ""
                            _:
                                return ""
                    _:
                        return ""


        def try_expression_owner(parser: Parser&, expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Ast::Expr.Call(callee, arguments, argument_names, line):
                        match callee:
                            Ast::Expr.Ident(name, ident_line):
                                return name
                            Ast::Expr.Scope(scope_base, scope_name, scope_line):
                                return scope_name
                            _:
                                return "__unknown_call"
                    _:
                        return "__noncall"

        def try_expression_call_arity(parser: Parser&, expression: Ast::Expr) -> (known: bool, value: u32):
            can Abort.Panic:
                match expression:
                    Ast::Expr.Call(_, arguments, _, _):
                        call_position: Ast::Pos = Ast::expr_pos(expression)
                        return (false, 0) if any marker in parser.enum_annotations where marker.owner == "__arg_forward" and marker.name == "__arg_forward" and marker.line == call_position.line and marker.offset == call_position.offset
                        return (true, arguments.count.u32())
                    Ast::Expr.Paren(inner, _):
                        return parser.try_expression_call_arity(inner)
                    _:
                        return (false, 0)

        def try_expression_record_named_arguments(parser: lmut Parser, expression: Ast::Expr, try_line: u32, try_offset: u32) -> void:
            can Abort.Panic, Global{Read,Write}:
                match expression:
                    Ast::Expr.Call(_, arguments, argument_names, _):
                        call_position: Ast::Pos = Ast::expr_pos(expression)
                        has_forward_arguments: bool = any marker in parser.enum_annotations where marker.owner == "__arg_forward" and marker.name == "__arg_forward" and marker.line == call_position.line and marker.offset == call_position.offset
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__try_callee_argument_forward", name: "", line: try_line, offset: try_offset}) if has_forward_arguments
                        for index in 0..<arguments.count |parser, arguments, argument_names, try_line, try_offset|:
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__try_callee_argument_position", name: "", line: try_line, offset: try_offset, identity_id: index.u32(), pos: Ast::expr_pos(arguments[index])}) can Global{Read,Write}
                            match arguments[index]:
                                Ast::Expr.Call(callee, _, _, _):
                                    match callee:
                                        Ast::Expr.Ident(call_name, call_position):
                                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__try_callee_argument_direct_call", name: call_name, line: try_line, offset: try_offset, identity_id: index.u32(), pos: call_position}) can Global{Read,Write}
                                        _:
                                            pass
                                _:
                                    pass
                            if index < argument_names.count:
                                argument_name: sview = argument_names[index]
                                if argument_name != "":
                                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__try_callee_named_arg", name: argument_name, line: try_line, offset: try_offset, identity_id: index.u32()}) can Global{Read,Write}
                    Ast::Expr.Paren(inner, _):
                        parser <- parser.try_expression_record_named_arguments(inner, try_line, try_offset)
                    _:
                        pass


        # Quantifier `any|all VAR in ITER where COND` — a boolean over ITER. VAR is
        # bound in COND (not in ITER). Modeled as a Comprehension with no body. The
        # `any`/`all` head is the current token.
        def quantifier_expression(parser: lmut Parser) -> Ast::Expr?:
            rebind head: Token, parser = parser.advance()             # `any` / `all`
            rebind variable_token: Token, parser = parser.expect(TokenKind.Ident)
            # The query's BINDER, paired with the `__query` head row the caller just pushed.
            # The backend derives one query scope ID from this raw head token offset, so
            # same-line queries and nested heads keep distinct binder/head pairs.
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__query_binder_of", name: Lexer::text_or_empty(variable_token, parser.source, parser.source_length), line: head.line, offset: head.start})
            # Extra query variables (`count k, v in m where …`) — the first variable is the
            # canonical binder recorded on the Comprehension node; the rest are source-offset
            # paired to the head as `__query_binder` markers so the resolver still scopes them.
            machine over parser.position while parser.peek() == TokenKind.Comma:
                state More
                start More

                More, _:
                    parser.position <- parser.position + 1
                    rebind extra_binder_token: Token, parser = parser.expect(TokenKind.Ident)
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: Lexer::text_or_empty(extra_binder_token, parser.source, parser.source_length), name: "__query_binder", line: head.line, offset: head.start})
                    -> More
            parser, _ <- parser.expect(TokenKind.In)
            # Parse only the iterable precedence expression; the following contextual
            # `where` belongs to this query rather than to an expression-level view.
            rebind iterable_left: Ast::Expr, parser = get parser.unary_expression() can Global{Read,Write}, Memory.Allocate
            rebind iterable_expression: Ast::Expr, parser = parser.binary_expression_at_level(iterable_left, 1) can Global{Read,Write}, Memory.Allocate
            condition_expression: mutable Ast::Expr = (Ast::Expr.Absent)
            guard_expression: mutable Ast::Expr = (Ast::Expr.Absent)
            where_token: Token = parser.cursor()
            saw_where: mutable bool = false
            if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(where_token, parser.source, parser.source_length) == "where":
                saw_where <- true
                parser, _ <- parser.advance()                       # `where`
                guarded_pattern: bool = parser.query_pattern_filter_head()
                rebind parsed_condition_opt: Ast::Expr?, parser = parser.expression() can Global{Read,Write}
                condition_expression <- parsed_condition if parsed_condition_opt is parsed_condition
                # Guarded pattern filter: `where PATTERN: PRED` or
                # `where subject is PATTERN: PRED`. Keep the PATTERN in the condition slot
                # (its `is`-payload bindings must scope PRED) and put PRED in the body slot,
                # so resolution binds the pattern before walking the guard. Previously PRED
                # overwrote the condition, dropping the pattern's bindings.
                if guarded_pattern and parser.peek() == TokenKind.Colon:
                    parser, _ <- parser.advance()
                    rebind guard_opt: Ast::Expr?, parser = parser.expression() can Global{Read,Write}
                    guard_expression <- guard if guard_opt is guard
                    # The body slot of a leading-keyword query means two different things:
                    # a GUARD here, and a PROJECTION in `EXPR for each x in xs` (which the
                    # projection parser fills). The backend cannot tell them apart from the
                    # node, and pushing a guard as the collected ELEMENT would be a wrong
                    # answer, so the guarded case is marked explicitly.
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__query_guard", name: "", line: head.line, offset: head.start}) if guard_opt is guard_marker
            # `count x in xs` with NO filter is not a query at all in stage0 — it reports
            # `expected IDENT` and then `expected "where"`. MEASURED across the whole keyword
            # family: `sum` and `product` accept the bare form, `count` does not. (any/all/
            # first/min/max/each reject the bare form too, but stage1 already declines those
            # downstream, so only `count` is a live divergence.) Narrow on purpose — this is
            # the oracle's rule, not a generalisation of it.
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, where_token) if not saw_where and Lexer::text_or_empty(head, parser.source, parser.source_length) == "count"
            return (Ast::Expr.Comprehension(Lexer::text_or_empty(variable_token, parser.source, parser.source_length), iterable_expression, condition_expression, guard_expression, Ast::pos_of_token(head), Ast::query_scope_id_from_offset(head.start)))

        # A guarded query pattern starts either with a qualified variant pattern
        # (`Expr.Int(...)`) or contains a top-level `is` subject separator. This keeps
        # an enclosing statement's block colon out of the query expression.
        def query_pattern_filter_head(parser: Parser&) -> bool:
            return true if parser.peek_where_view_pattern_filter()
            machine over parser.position:
                state Scan(scan: usize, depth: int)
                start Scan(0, 0)

                Scan(scan, depth), _ if depth == 0 and parser.peek_at(scan) == TokenKind.Is:
                    return true

                Scan(scan, depth), _ if depth == 0 and parser.peek_at(scan) == TokenKind.Colon:
                    break

                Scan(scan, depth), _ if parser.peek_at(scan) == TokenKind.Newline or parser.peek_at(scan) == TokenKind.Eof:
                    break

                Scan(scan, depth), _ if parser.peek_at(scan) == TokenKind.LParen or parser.peek_at(scan) == TokenKind.LBracket or parser.peek_at(scan) == TokenKind.LBrace:
                    -> Scan(scan + 1, depth + 1)

                Scan(scan, depth), _ if parser.peek_at(scan) == TokenKind.RParen or parser.peek_at(scan) == TokenKind.RBracket or parser.peek_at(scan) == TokenKind.RBrace:
                    -> Scan(scan + 1, depth - 1)

                Scan(scan, depth), _:
                    -> Scan(scan + 1, depth)
            return false


        # A `where`-clause variant/struct pattern head is a CAPITALIZED type name —
        # `Expr.Int(n)`, `Color.Red`, `Point{...}` — never a lowercase field access
        # like `directive.kind`. Mirrors stage0's peekWhereViewPatternFilter: without
        # the capitalization gate, `where directive.kind in {...}:` was misread as a
        # guarded pattern filter, stealing the enclosing `if`'s block colon.
        def peek_where_view_pattern_filter(parser: Parser&) -> bool:
            return false if parser.peek() != TokenKind.Ident
            head_token: Token = parser.cursor()
            head_text: sview = Lexer::text_or_empty(head_token, parser.source, parser.source_length)
            return false if head_text.len == 0
            first: u8 = head_text[0]
            capitalized: bool = first >= 65 and first <= 90
            next: TokenKind = parser.peek_at(1)
            return true if capitalized and (next == TokenKind.LParen or next == TokenKind.LBrace)
            return false if:
                next != TokenKind.Dot
                not capitalized
            # Walk the dotted chain `Ident (.Ident)*`, then require the token after it
            # to be one that can legitimately follow a pattern head.
            machine over parser.position:
                state Scan(index: usize)
                start Scan(1)

                Scan(index), _ if parser.peek_at(index) == TokenKind.Dot and parser.peek_at(index + 1) == TokenKind.Ident:
                    -> Scan(index + 2)

                Scan(index), _:
                    return when parser.peek_at(index):
                        TokenKind.LParen | TokenKind.Colon | TokenKind.RParen | TokenKind.RBracket | TokenKind.Comma | TokenKind.Newline | TokenKind.Eof -> true
                        _ -> false
            return false


        # Non-destructive check that the token stream after a query keyword has the
        # `VAR (, VAR)* in` shape that selects the query-expression form (mirrors
        # stage0's looksLikeQueryExpr).
        def looks_like_query_expression(parser: Parser&) -> bool:
            return false if parser.peek_at(1) != TokenKind.Ident
            machine over parser.position:
                state Scan(index: usize)
                start Scan(2)

                Scan(index), _ if parser.peek_at(index) == TokenKind.Comma and parser.peek_at(index + 1) != TokenKind.Ident:
                    return false

                Scan(index), _ if parser.peek_at(index) == TokenKind.Comma:
                    -> Scan(index + 2)

                Scan(index), _:
                    return parser.peek_at(index) == TokenKind.In
            return false


