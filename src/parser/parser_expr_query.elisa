extend Parser:
    private:
        # `get EXPR else <recovery>`: yields the guarded EXPR's value. The `else` clause
        # is consumed but not modeled — a control-flow statement (`return`/`break`/
        # `continue`) or a fallback expression. The guarded expression is returned as the
        # node (the recovery semantics are erased until an explicit Get/Try node exists).
        def get_expr(parser: lmut Parser) -> Ast::Expr?:
            parser, _ <- parser.advance()                           # consume `get`
            rebind inner: Ast::Expr?, parser = parser.expr()
            rebind accepted_else: bool, parser = parser.accept(TokenKind.Else)
            if accepted_else:
                kind: TokenKind = parser.peek()
                if kind in {TokenKind.Return, TokenKind.Break, TokenKind.Continue}:
                    parser, _ <- parser.stmt()                      # control-flow else-clause
                else:
                    parser, _ <- parser.expr()                      # fallback-expression else-clause
            return inner


        # Quantifier `any|all VAR in ITER where COND` — a boolean over ITER. VAR is
        # bound in COND (not in ITER). Modeled as a Comprehension with no body. The
        # `any`/`all` head is the current token.
        def quantifier_expr(parser: lmut Parser) -> Ast::Expr?:
            rebind head: Token, parser = parser.advance()             # `any` / `all`
            rebind var_tok: Token, parser = parser.expect(TokenKind.Ident)
            # Extra query variables (`count k, v in m where …`) — consumed; the first
            # variable is the canonical binder recorded on the Comprehension node.
            while parser.accept(TokenKind.Comma) |parser|:
                parser, _ <- parser.expect(TokenKind.Ident)
            parser, _ <- parser.expect(TokenKind.In)
            rebind iter_expr: Ast::Expr, parser = get parser.expr()
            cond_expr: mutable Ast::Expr = (Ast::Expr.Invalid)
            where_tok: Token = parser.cursor()
            if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(where_tok, parser.source) == "where":
                parser, _ <- parser.advance()                       # `where`
                rebind parsed_cond_opt: Ast::Expr?, parser = parser.expr()
                if parsed_cond_opt is parsed_cond:
                    cond_expr <- parsed_cond
            return (Ast::Expr.Comprehension(Lexer::text_or_empty(var_tok, parser.source), iter_expr, cond_expr, (Ast::Expr.Invalid), head.line))


        # Non-destructive check that the token stream after a query keyword has the
        # `VAR (, VAR)* in` shape that selects the query-expression form (mirrors
        # stage0's looksLikeQueryExpr).
        def looks_like_query_expr(parser: lmut Parser) -> bool:
            if parser.peek_at(1) != TokenKind.Ident:
                return false
            i: mutable usize = 2
            while parser.peek_at(i) == TokenKind.Comma:
                if parser.peek_at(i + 1) != TokenKind.Ident:
                    return false
                i <- i + 2
            return parser.peek_at(i) == TokenKind.In


        # `forall VAR in ITER: PRED` / `exists VAR in ITER: PRED` — the colon-body sibling
        # of `quantifier_expr`'s `where`-clause form, used in `invariant`/`law` predicates.
        # PRED is required (not optional like `where COND`).
        def forall_exists_expr(parser: lmut Parser) -> Ast::Expr?:
            rebind head: Token, parser = parser.advance()             # `forall` / `exists`
            rebind var_tok: Token, parser = parser.expect(TokenKind.Ident)
            parser, _ <- parser.expect(TokenKind.In)
            rebind iter_expr: Ast::Expr, parser = get parser.expr()
            parser, _ <- parser.expect(TokenKind.Colon)
            cond_expr: mutable Ast::Expr = (Ast::Expr.Invalid)
            rebind parsed_cond_opt_2: Ast::Expr?, parser = parser.expr()
            if parsed_cond_opt_2 is parsed_cond:
                cond_expr <- parsed_cond
            return (Ast::Expr.Comprehension(Lexer::text_or_empty(var_tok, parser.source), iter_expr, cond_expr, (Ast::Expr.Invalid), head.line))


        # Non-destructive check that the current lambda-keyword token begins a lambda:
        # the parenthesized param signature (+ optional `-> T`) must be followed by a
        # `:` or `=>`. Saves and restores the parse position so a bare `fn` reference /
        # `fn(x)` call (both very common — `fn` is an ordinary local name) is NOT
        # misread as a lambda.
        def looks_like_lambda(parser: lmut Parser) -> bool:
            saved: usize = parser.position
            parser, _ <- parser.advance()                           # the lambda keyword
            rebind ok: bool, parser = parser.lambda_signature_probe()
            result: mutable bool = false
            if ok:
                # Optional return type `-> T`: skip to the depth-0 `:` / `=>` / line end.
                rebind accepted_arrow: bool, parser = parser.accept(TokenKind.Arrow)
                if accepted_arrow:
                    while parser.peek() != TokenKind.Eof |rdepth = 0|:
                        k: TokenKind = parser.peek()
                        if k in {TokenKind.LParen, TokenKind.LBracket}:
                            rdepth <- rdepth + 1
                        elif k in {TokenKind.RParen, TokenKind.RBracket}:
                            rdepth <- rdepth - 1
                        elif rdepth == 0 and k in {TokenKind.Colon, TokenKind.FatArrow, TokenKind.Newline}:
                            break
                        parser, _ <- parser.advance()
                result <- parser.peek() == TokenKind.Colon or parser.peek() == TokenKind.FatArrow
            parser.position <- saved
            return result


        # Non-destructive check that the current lambda-keyword token begins the
        # *removed* shorthand param shape `fn x: x` / `fn a, b: expr` (unparenthesized
        # — dropped in bd208ae, parens are now required). Scans `IDENT (, IDENT)*`
        # directly after the keyword for a top-level `:`; a bare `fn(...)` call/paren
        # signature never enters this path since it starts with LParen, not Ident. Saves
        # and restores position like `looks_like_lambda`.
        def looks_like_removed_shorthand_lambda(parser: lmut Parser) -> bool:
            saved: usize = parser.position
            parser, _ <- parser.advance()                           # the lambda keyword
            result: mutable bool = false
            if parser.peek() == TokenKind.Ident:
                parser, _ <- parser.advance()
                while parser.accept(TokenKind.Comma) |parser|:
                    break if parser.peek() != TokenKind.Ident
                    parser, _ <- parser.advance()
                result <- parser.peek() == TokenKind.Colon
            parser.position <- saved
            return result


        # Consume a lambda parameter signature (used only inside the probe): a
        # parenthesized list `(a: T, b, …)` (types skipped, paren/bracket-balanced).
        # Parameters are always parenthesized — the shorthand form has been removed.
        def lambda_signature_probe(parser: lmut Parser) -> bool:
            if parser.peek() != TokenKind.LParen:
                return false
            parser, _ <- parser.advance()
            if parser.peek() != TokenKind.RParen:
                while true:
                    parser, _ <- parser.accept(TokenKind.Mutable)
                    if parser.peek() != TokenKind.Ident:
                        return false
                    parser, _ <- parser.advance()                   # param name
                    rebind accepted_colon: bool, parser = parser.accept(TokenKind.Colon)
                    if accepted_colon:
                        # Skip the param type to a top-level `,` or the closing `)`.
                        tdepth: mutable int = 0
                        while parser.peek() != TokenKind.Eof:
                            tk: TokenKind = parser.peek()
                            if tk in {TokenKind.LParen, TokenKind.LBracket}:
                                tdepth <- tdepth + 1
                            elif tk in {TokenKind.RParen, TokenKind.RBracket}:
                                break if tdepth == 0
                                tdepth <- tdepth - 1
                            elif tdepth == 0 and tk == TokenKind.Comma:
                                break
                            elif tdepth == 0 and tk == TokenKind.Newline:
                                return false
                            parser, _ <- parser.advance()
                    rebind accepted_comma: bool, parser = parser.accept(TokenKind.Comma)
                    break if not accepted_comma
            rebind accepted_rparen: bool, parser = parser.accept(TokenKind.RParen)
            return accepted_rparen


        # Parse a lambda `fn(params) [-> T] => EXPR` (expression body) / `fn(params):`
        # + block (keyword already confirmed by looks_like_lambda). Params are always
        # parenthesized. The `=> EXPR` body is normalized to a single `return EXPR` so
        # the body is uniformly `darray[Stmt]`; the `:` form reuses parse_block. Param
        # types and the return type are consumed but not modeled.
        def lambda_expr(parser: lmut Parser) -> Ast::Expr?:
            rebind tok: Token, parser = parser.advance()              # the lambda keyword
            params: mutable darray[sview] = []
            rebind accepted_lparen: bool, parser = parser.accept(TokenKind.LParen)
            if accepted_lparen:
                while parser.peek() != TokenKind.RParen and parser.peek() != TokenKind.Eof:
                    parser, _ <- parser.accept(TokenKind.Mutable)
                    rebind pname: Token, parser = parser.expect(TokenKind.Ident)
                    params.push(Lexer::text_or_empty(pname, parser.source))
                    rebind accepted_colon_2: bool, parser = parser.accept(TokenKind.Colon)
                    if accepted_colon_2:
                        parser, _ <- parser.expr()                  # param type (consumed)
                    rebind accepted_comma_2: bool, parser = parser.accept(TokenKind.Comma)
                    break if not accepted_comma_2
                parser, _ <- parser.expect(TokenKind.RParen)

            rebind accepted_arrow_2: bool, parser = parser.accept(TokenKind.Arrow)
            if accepted_arrow_2:
                parser, _ <- parser.expr()                          # return type (consumed)

            body: mutable darray[Ast::Stmt] = []
            rebind accepted_fatarrow: bool, parser = parser.accept(TokenKind.FatArrow)
            if accepted_fatarrow:
                # `=> EXPR` — normalize to a single `return EXPR` body (region-poly
                # helper so the darray survives being stored in the Lambda payload).
                vtok: Token = parser.cursor()
                rv: mutable Ast::Expr? = null
                rebind v_opt: Ast::Expr?, parser = parser.expr()
                if v_opt is v:
                    rv <- v
                body, parser <- parser.single_stmt_body((Ast::Stmt.Return(rv, vtok.line)))
            elif parser.peek() == TokenKind.Colon:
                body, parser <- parser.parse_block()

            return (Ast::Expr.Lambda(params, body, tok.line))

