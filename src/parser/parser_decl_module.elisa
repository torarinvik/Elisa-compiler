extend Parser:
    private:
        def record_private_member_if(parser: lmut Parser, private_section: bool, member_name: sview, section_line: u32) -> void:
            return if not private_section or member_name == ""
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__private_member", name: member_name, line: section_line})
            # Paired with the entry above: WHICH module hides the name. Without it a
            # private `draw_text` in one module hid a public `draw_text` in another.
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__private_member_module", name: parser.current_module, line: section_line})

        # A `public:` / `private:` visibility section (indented block or flat label), or
        # the `public def f(...)` prefix form. Visibility is a layout grouping only here;
        # members are flattened into the enclosing declaration list, and each one is
        # recorded in the annotations side table (`__section_public` / `__section_private`,
        # keyed by member name and owning module) so the formatter can print the sections
        # back -- dropping them turned every private member public.
        def visibility_section(parser: lmut Parser, out: mutable darray[Ast::Decl]&) -> void:
            can Abort.Panic, Memory.Allocate:
                section_token: Token = parser.cursor()
                is_private: bool = Lexer::text_or_empty(section_token, parser.source) == "private"
                visibility_name: sview = "private" if is_private else "public"
                # Prefix form: the keyword marks the ONE declaration that follows.
                if parser.peek_at(1) != TokenKind.Colon:
                    parser, _ <- parser.advance()
                    rebind prefixed_name: sview = parser.private_name_ahead()
                    parser <- parser.record_private_member_if(is_private, prefixed_name, section_token.line)
                    parser <- parser.record_section_member(prefixed_name, visibility_name)
                    # `private module M:` hides every member of M, not just the module name
                    # (stage0: parseVisibilityPrefixedDecl sets NamespaceDecl.Private, and
                    # isPrivateDecl then hides each member). The module body reads this.
                    prefixed_head: sview = parser.header_token_text(0)
                    parser.pending_private_module <- is_private and (prefixed_head == "module" or prefixed_head == "extend")
                    parser <- parser.parse_declaration_unit(out)
                    return
                # stage0: a section is only valid inside a declaration block.
                parser <- parser.error_named(Ast::ParseErrorKind.VisibilitySectionAtTopLevel, section_token, visibility_name, "", 0, section_token.column + section_token.length) if parser.decl_block_depth == 0
                parser, _ <- parser.advance()                       # consume the public/private identifier
                parser, _ <- parser.expect(TokenKind.Colon)
                parser, _ <- parser.expect(TokenKind.Newline)
                # Flat-label form: no indented block -- the visibility applies to the rest of
                # the enclosing module body (consumed by the module-body loop).
                if parser.peek() != TokenKind.Indent:
                    parser.section_visibility <- visibility_name
                    return
                parser, _ <- parser.expect(TokenKind.Indent)
                saved_section_visibility: sview = parser.section_visibility
                parser.section_visibility <- ""
                machine over parser.position while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof:
                    state Scan
                    state Parse(before: usize, member_count: usize, member_name: sview, private_section: bool)
                    state Progress(before: usize, member_count: usize, member_name: sview, private_section: bool)
                    state Advance(before: usize)
                    start Scan

                    Scan, _:
                        parser <- parser.skip_newlines()
                        rebind captured_name: sview = parser.private_name_ahead()
                        parser <- parser.record_private_member_if(is_private, captured_name, section_token.line)
                        parser <- parser.record_section_member(captured_name, visibility_name)
                        -> Parse(parser.position, out.count, captured_name, is_private)

                    Parse(_, _, _, _), _ if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof:
                        break

                    Parse(before, member_count, member_name, private_section), _:
                        parser <- parser.parse_declaration_unit(out)
                        -> Progress(before, member_count, member_name, private_section)

                    Progress(before, _, _, _), _:
                        -> Advance(before)

                    Advance(before), _ if parser.position == before:
                        parser.position <- parser.position + 1
                        -> Scan

                    Advance(_), _:
                        -> Scan
                parser, _ <- parser.expect(TokenKind.Dedent)
                parser.section_visibility <- saved_section_visibility

        # Record ONE member of a `public:` / `private:` section, keyed by its declared name
        # and owning module -- the same key the private-member rows already use, and captured
        # BEFORE the member is parsed (the recorder runs in the section loop's scan state, so
        # it never has to reach back into a declaration list the callee has since rebound).
        def record_section_member(parser: lmut Parser, member_name: sview, visibility_name: sview) -> void:
            can Abort.Panic, Memory.Allocate:
                return if visibility_name == "" or member_name == ""
                owning_module: sview = parser.current_module
                # The visibility rides in the MARKER (the annotation has no spare string
                # field); `name` is the member and `module` its owner.
                section_marker: sview = "__section_private" if visibility_name == "private" else "__section_public"
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: section_marker, name: member_name, line: 0, module: owning_module})


            # Recover the member name before parsing consumes the declaration header.
        def private_name_ahead(parser: Parser&) -> sview:
            can Abort.Panic:
                first: TokenKind = parser.peek()
                current: Token = parser.cursor()
                # `global` was missing here, so a private global was never recorded as private and
                # `A::counter` read fine from outside the module (stage0: "is private to module").
                accepted: bool = first == TokenKind.Def or first == TokenKind.Struct or first == TokenKind.Enum or first == TokenKind.Const or first == TokenKind.Global or (first == TokenKind.Ident and Lexer::text_or_empty(current, parser.source) == "alias")
                sview("", 0, 0) return if not accepted
                machine over parser.position:
                    state Scan(index: usize)
                    start Scan(1)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Ident:
                        return parser.module_token_text_at(index)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Newline or parser.peek_at(index) == TokenKind.Eof:
                        return sview("", 0, 0)

                    Scan(index), _:
                        -> Scan(index + 1)
                return sview("", 0, 0)

        def module_token_text_at(parser: Parser&, offset: usize) -> sview:
            token: Token = parser.tokens[parser.position + offset]
            return Lexer::text_or_empty(token, parser.source)

        def record_from_import_member(parser: lmut Parser, member: sview, source_module: sview, line: u32) -> void:
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__from_member", name: member, line: line})
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__from_src", name: source_module, line: line}) if source_module != ""

        def parse_module_name(parser: lmut Parser) -> sview:
            first_name_token: Token = parser.cursor()
            name_start: usize = first_name_token.start.usize()
            rebind first_name: Token, parser = parser.expect(TokenKind.Ident)
            initial_end: usize = (first_name.start + first_name.length).usize()
            machine over parser.position while true:
                state Scan(end: usize)
                start Scan(initial_end)

                Scan(end), _ if (parser.peek() != TokenKind.Dot and parser.peek() != TokenKind.Scope) or parser.peek_at(1) != TokenKind.Ident:
                    return parser.span_view(name_start, end)

                Scan(end), _:
                    parser.position <- parser.position + 1
                    rebind segment: Token, parser = parser.advance()
                    -> Scan((segment.start + segment.length).usize())
            return parser.span_view(name_start, initial_end)


        # Does the chain use the DOT separator? `module Outer.Inner:` is NOT valid: `::`
        # is the namespace separator and `.` accesses a value member. Both compilers used
        # to parse the dotted form -- stage0 accepted it outright, and stage1 registered the
        # module under the verbatim "Outer.Inner" that no `Outer::Inner::f()` use site can
        # ever name, so the module was declared and then unreachable. It is now an ERROR in
        # both (stage0: parser_parsequalifieddeclname..., parseModulePathName).
        #
        # The name is still NORMALISED onto `::` after the error is recorded, so the one
        # diagnostic is the dotted separator rather than a cascade of unresolved names.
        def module_name_has_dot(name: sview) -> bool:
            for index in 0..<sview_len(name):
                true return if sview_at(name, index) == 46
            return false


        # Rewrite a dotted chain onto the `::` spelling the rest of stage1 uses. Built in
        # `module_name_storage`, reserved up front for the same reason
        # qualify_nested_module_name reserves: views into it must survive later appends.
        def normalize_module_name_separators[@r](parser: mutable Parser& @r, name: sview) -> sview:
            name return if not module_name_has_dot(name)
            parser.module_name_storage.reserve(parser.tokens.count * 64 + 4096) if parser.module_name_storage.count == 0
            start: usize = parser.module_name_storage.count
            length: usize = sview_len(name)
            index: mutable usize = 0
            while index < length |index, length, parser, name|:
                if sview_at(name, index) == 46:
                    parser.module_name_storage.push(58)
                    parser.module_name_storage.push(58)
                else:
                    parser.module_name_storage.push(sview_at(name, index))
                index <- index + 1.usize()
            count: usize = parser.module_name_storage.count - start
            return sview(&parser.module_name_storage[start], 0, count)


        # The pattern-path variant of normalize_module_name_separators: every separator
        # but the LAST is a module separator (`Pack.Kind.A` -> `Pack::Kind.A`); the last one
        # selects the variant and keeps its spelling.
        def normalize_leading_module_separators[@r](parser: mutable Parser& @r, name: sview) -> sview:
            length: usize = sview_len(name)
            last_separator: mutable usize = length
            scan: mutable usize = 0
            while scan < length |scan, length, last_separator, name|:
                byte: u8 = sview_at(name, scan)
                last_separator <- scan if byte == 46 or (byte == 58 and (scan == 0 or sview_at(name, scan - 1.usize()) != 58))
                scan <- scan + 1.usize()
            name return if last_separator == length
            parser.module_name_storage.reserve(parser.tokens.count * 64 + 4096) if parser.module_name_storage.count == 0
            start: usize = parser.module_name_storage.count
            index: mutable usize = 0
            while index < length |index, length, last_separator, parser, name|:
                if sview_at(name, index) == 46 and index != last_separator:
                    parser.module_name_storage.push(58)
                    parser.module_name_storage.push(58)
                else:
                    parser.module_name_storage.push(sview_at(name, index))
                index <- index + 1.usize()
            count: usize = parser.module_name_storage.count - start
            return sview(&parser.module_name_storage[start], 0, count)


        # Token index of the last identifier of the `Ident (. | ::) Ident ...` chain that
        # starts at token `start` (== start when there is no chain).
        def qualified_chain_end(parser: Parser&, start: usize) -> usize:
            end: mutable usize = start
            while end + 2.usize() < parser.tokens.count and (parser.tokens[end + 1.usize()].kind == TokenKind.Dot or parser.tokens[end + 1.usize()].kind == TokenKind.Scope) and parser.tokens[end + 2.usize()].kind == TokenKind.Ident |end, parser|:
                end <- end + 2.usize()
            return end


        def qualified_chain_has_dot(parser: Parser&, start: usize, end: usize) -> bool:
            index: mutable usize = start + 1.usize()
            while index < end |index, end, parser|:
                true return if parser.tokens[index].kind == TokenKind.Dot
                index <- index + 2.usize()
            return false


        # A qualified name in a DECLARATION type position -- a generic bound, an `impl`
        # interface, a protocol/enum parent, a `from` import source -- can only ever walk
        # modules, so every separator must be `::`. Reported at the head identifier with the
        # corrected spelling, the same sentence as `module A.B:` (stage0:
        # parser.parseQualifiedDeclName). The chain itself is left for the caller's scan.
        def reject_dotted_type_chain(parser: lmut Parser, start: usize) -> void:
            can Memory.Allocate, Abort.Panic:
                return if start >= parser.tokens.count or parser.tokens[start].kind != TokenKind.Ident
                end: usize = qualified_chain_end(parser, start)
                return if end == start or not qualified_chain_has_dot(parser, start, end)
                head_token: Token = parser.tokens[start]
                last_token: Token = parser.tokens[end]
                spelled: sview = parser.span_view(head_token.start.usize(), last_token.start.usize() + last_token.length.usize())
                corrected: sview = parser.normalize_module_name_separators(spelled)
                parser <- parser.error_named(Ast::ParseErrorKind.ModulePathDotSeparator, head_token, corrected, "", 0, head_token.column + head_token.length)


        def module_name_is_qualified(name: sview) -> bool:
            for index in 0..<sview_len(name):
                true return if sview_at(name, index) == 58 or sview_at(name, index) == 46
            return false

        def qualify_nested_module_name[@r](parser: mutable Parser& @r, name: sview) -> sview:
            name return if parser.current_module == ""
            name return if module_name_is_qualified(name)
            parser.module_name_storage.reserve(parser.tokens.count * 64 + 4096) if parser.module_name_storage.count == 0
            start: usize = parser.module_name_storage.count
            append_machine_name_text(parser.module_name_storage, parser.current_module)
            parser.module_name_storage.push(58)
            parser.module_name_storage.push(58)
            append_machine_name_text(parser.module_name_storage, name)
            count: usize = parser.module_name_storage.count - start
            return sview(&parser.module_name_storage[start], 0, count)

        # `Name__native`, the opaque handle type behind `extern resource Name`, in the same
        # persistent storage as qualified module names.
        def resource_handle_name[@r](parser: mutable Parser& @r, base: sview) -> sview:
            parser.module_name_storage.reserve(parser.tokens.count * 64 + 4096) if parser.module_name_storage.count == 0
            start: usize = parser.module_name_storage.count
            append_machine_name_text(parser.module_name_storage, base)
            append_machine_name_text(parser.module_name_storage, "__native")
            count: usize = parser.module_name_storage.count - start
            return sview(&parser.module_name_storage[start], 0, count)

        def module_declaration(parser: lmut Parser) -> Ast::Decl?:
            rebind token: Token, parser = parser.advance()          # consume the `module`/`extend` identifier
            # A qualified module name (`module Common::Log::Class:`) is a single Ident
            # chain joined by `::`. The `.` form is still CONSUMED here so the declaration
            # body parses normally and the user sees one diagnostic instead of a cascade,
            # but it is recorded as an error and normalised away.
            # The chain scan yields the end offset of the last segment consumed.
            name_token: Token = parser.cursor()
            rebind dotted_or_scoped_name: sview, parser = parser.parse_module_name()
            spelled_name: sview = parser.normalize_module_name_separators(dotted_or_scoped_name)
            # A PARSE error, matching stage0's layer: it aborts the emit modes the way a
            # syntax failure must (stage0 prints only the diagnostic for `-emit fmt`, where a
            # semantic finding would have let the formatter run on a file that does not
            # parse). `detail` is the corrected `::` spelling, held in the parser's own
            # module_name_storage; `detail_num2` carries the END column so the span reads
            # `1:8-13` exactly as stage0's does.
            parser <- parser.error_named(Ast::ParseErrorKind.ModulePathDotSeparator, name_token, spelled_name, "", 0, name_token.column + name_token.length) if module_name_has_dot(dotted_or_scoped_name)
            # A module declared INSIDE another module's body is recorded under its QUALIFIED
            # name (`Outer::Inner`): the spelling stage0 uses for its symbols (`Outer.Inner.run`)
            # and the one the verbatim `module Outer::Inner:` form already registers, so every
            # consumer sees one shape for both spellings. Before this, a nested module's
            # functions were declared under the bare `Inner` at one nesting level only, and
            # every call into them declined in the backend (plan §3.1.5, probes p10/p12).
            name: sview = parser.qualify_nested_module_name(spelled_name)

            body_items: mutable darray[Ast::Decl] = []
            (Ast::Decl.Module(name, body_items, Ast::pos_of_token(token))) return if parser.peek() != TokenKind.Colon
            parser, _ <- parser.expect(TokenKind.Colon)
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)
            # `extend Ast:` is how the compiler's own AST declarations are assembled across
            # source files. Preserve that distinction in the parser metadata: a user may
            # legally declare `module Ast:` and types named `Node`/`Decl`, and those names
            # must not silently acquire the compiler's packed-store ABI merely because the
            # backend sees the same bare spelling. The declaration node intentionally keeps
            # module and extend blocks in one shape, so this small sentinel is the provenance
            # bit the later enum registration pass needs.
            # `pos`/`offset` are recorded too: check_module_extension_target reports AT the
            # `extend` keyword, and a line number alone cannot carry a column span.
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__compiler_extension_module", name: name, line: token.line, module: name, offset: token.start, pos: Ast::pos_of_token(token)}) if Lexer::text_or_empty(token, parser.source) == "extend"
            # Record the module whose body follows, so a `struct` declared inside it is
            # registered under an OWNER instead of landing in one flat name table with
            # every other module's. Saved and restored, so a nested module leaves the
            # outer one intact.
            # Claimed by the `private module M:` prefix, and cleared so a NESTED module
            # does not inherit it.
            body_is_private: bool = parser.pending_private_module
            parser.pending_private_module <- false
            saved_module: sview = parser.current_module
            parser.current_module <- name
            saved_body_section: sview = parser.section_visibility
            parser.section_visibility <- ""
            parser.decl_block_depth <- parser.decl_block_depth + 1
            machine over parser.position while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof:
                state Scan
                state Classify(before: usize)
                state Progress(before: usize)
                start Scan

                Scan, _:
                    parser <- parser.skip_newlines()
                    -> Classify(parser.position)

                Classify(_), _ if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof:
                    break

                Classify(before), _ if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Assign:
                    body_items.push(parser.bare_const_member())
                    -> Progress(before)

                Classify(before), _ if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon and parser.peek_at(2) != TokenKind.Newline:
                    body_items.push(parser.bare_const_member())
                    -> Progress(before)

                Classify(before), _:
                    # A flat-label section (`public:` on its own line) in force covers this
                    # member: record it exactly like a block-section member. The field is
                    # copied out first -- naming it inside a call that also threads `parser`
                    # would alias the linear binding.
                    flat_visibility: sview = parser.section_visibility
                    flat_line: u32 = parser.cursor().line
                    rebind flat_name: sview = parser.private_name_ahead()
                    parser <- parser.record_private_member_if(body_is_private or flat_visibility == "private", flat_name, flat_line)
                    parser <- parser.record_section_member(flat_name, flat_visibility)
                    parser <- parser.parse_declaration_unit(body_items)
                    -> Progress(before)

                Progress(before), _ if parser.position == before:
                    parser.position <- parser.position + 1
                    -> Scan

                Progress(_), _:
                    -> Scan
            parser, _ <- parser.expect(TokenKind.Dedent)
            parser.current_module <- saved_module
            parser.section_visibility <- saved_body_section
            parser.decl_block_depth <- parser.decl_block_depth - 1

            return (Ast::Decl.Module(name, body_items, Ast::pos_of_token(token)))

        # A bare const-module member `NAME [: T] [= value]` (the `const` keyword is implied
        # by the enclosing `const module`/`const enum` grouping). Mirrors const_declaration's
        # binding tail; recorded as a Const node.
        def bare_const_member(parser: lmut Parser) -> Ast::Decl:
            token: Token = parser.cursor()
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            # docs/119 §6 captured value blocks: the `|parser|` header licenses the
            # cursor-advancing calls (`accept`/`expression`) inside a block used as a value.
            type_expression: Ast::Expr = |parser|
                rebind accepted_colon: bool, parser = parser.accept(TokenKind.Colon)
                if accepted_colon and parser.expression() is parsed_type:
                    parsed_type
                else:
                    (Ast::Expr.Invalid)
            value: Ast::Expr = |parser|
                rebind accepted_assign: bool, parser = parser.accept(TokenKind.Assign)
                if accepted_assign and parser.expression() is parsed_value:
                    parsed_value
                else:
                    (Ast::Expr.Invalid)
            return (Ast::Decl.Const(Lexer::text_or_empty(name_token, parser.source), type_expression, value, false, Ast::pos_of_token(token)))


        def include_declaration(parser: lmut Parser) -> Ast::Decl?:
            rebind token: Token, parser = parser.advance()          # consume the `include` identifier
            rebind path_token: Token, parser = parser.expect(TokenKind.StringLit)
            return (Ast::Decl.Import(Lexer::text_or_empty(path_token, parser.source), Ast::pos_of_token(token)))


        # `using Foo` / `using Foo::bar` (or `Foo.bar`) / `using Foo as F` plus
        # comma-separated targets and brace-selective members are consumed whole
        # since they are not modeled yet.
        def skip_qualified_decl_name(parser: lmut Parser) -> void:
            parser, _ <- parser.expect(TokenKind.Ident)
            machine over parser.position while (parser.peek() == TokenKind.Dot or parser.peek() == TokenKind.Scope) and parser.peek_at(1) == TokenKind.Ident:
                state More
                start More

                More, _:
                    parser.position <- parser.position + 1
                    parser.position <- parser.position + 1
                    -> More

        def skip_using_target(parser: lmut Parser) -> void:
            parser <- parser.skip_qualified_decl_name()
            return if parser.peek() != TokenKind.Dot or parser.peek_at(1) != TokenKind.LBrace
            parser, _ <- parser.advance()
            parser, _ <- parser.advance()
            machine over parser.position while true:
                state Item
                state Separator
                start Item

                Item, _ if parser.peek() == TokenKind.RBrace or parser.peek() == TokenKind.Eof:
                    break

                Item, _:
                    rebind ignored_member: Token, parser = parser.expect(TokenKind.Ident)
                    -> Separator

                Separator, _ if parser.peek() == TokenKind.Comma:
                    parser.position <- parser.position + 1
                    -> Item

                Separator, _:
                    break
            parser, _ <- parser.accept(TokenKind.RBrace)

        # An optional `as ALIAS` suffix on a using target.
        # `using Mod as M` — RECORD the alias instead of discarding it.
        #
        # The alias name used to be skipped, so `M` was a name nothing downstream had ever
        # heard of: `M::f()` resolved to `undefined identifier 'M'` and the backend had no
        # owner to look up. Two line-paired markers carry it — the alias as `__using_alias`
        # and the module it stands for as `__using_alias_target` — the same line-pairing
        # `__from_member`/`__from_src` already use for selective imports.
        def using_alias(parser: lmut Parser, target_module: sview) -> void:
            rebind accepted_as: bool, parser = parser.accept(TokenKind.As)
            return if not accepted_as
            alias_token: Token = parser.cursor()
            parser, _ <- parser.expect(TokenKind.Ident)
            alias_name: sview = Lexer::text_or_empty(alias_token, parser.source)
            return if alias_name == "" or target_module == ""
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: alias_name, name: "__using_alias", line: alias_token.line, offset: alias_token.start})
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: target_module, name: "__using_alias_target", line: alias_token.line, offset: alias_token.start})

        # A `using` target is a module path (`::` only -- a `.` is rejected like every
        # other module path). stage0's rule (parser.parseUsingDecl): with an `as` alias the
        # whole chain is the aliased module; otherwise a MULTI-segment chain is SELECTIVE --
        # the last segment is the member, everything before it the module -- and a single
        # name is a wildcard import. The previous version kept only the first token, so
        # `using Pack::Sub::f` silently became a wildcard `using Pack`.
        def consume_using_target(parser: lmut Parser) -> void:
            can Memory.Allocate, Abort.Panic:
                target_token: Token = parser.cursor()
                start: usize = parser.position
                end: usize = qualified_chain_end(parser, start)
                parser <- parser.reject_dotted_type_chain(start)
                last_token: Token = parser.tokens[end]
                full_text: sview = parser.span_view(target_token.start.usize(), last_token.start.usize() + last_token.length.usize())
                alias_follows: bool = parser.tokens[end + 1.usize()].kind == TokenKind.As if end + 1.usize() < parser.tokens.count else false
                if end > start and not alias_follows:
                    module_last: Token = parser.tokens[end - 2.usize()]
                    module_text: sview = parser.span_view(target_token.start.usize(), module_last.start.usize() + module_last.length.usize())
                    member_text: sview = Lexer::text_or_empty(last_token, parser.source)
                    parser <- parser.record_from_import_member(member_text, module_text, target_token.line)
                    # The formatter prints this back as `using MODULE::member` (stage0 keeps a
                    # UsingDecl with its Member); the `__from_*` rows above carry the import.
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: module_text, name: "__using_member", line: target_token.line, module: member_text, offset: target_token.start})
                else:
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: full_text, name: "__using", line: target_token.line, offset: target_token.start})
                parser <- parser.skip_using_target()
                parser <- parser.using_alias(full_text)

        def using_declaration(parser: lmut Parser) -> void:
            parser, _ <- parser.advance()                       # `using`
            machine over parser.position while true:
                state Item
                state Separator
                start Item

                Item, _ if parser.peek() == TokenKind.Newline or parser.peek() == TokenKind.Eof:
                    break

                Item, _:
                    parser <- parser.consume_using_target()
                    -> Separator

                Separator, _ if parser.peek() == TokenKind.Comma:
                    parser.position <- parser.position + 1
                    -> Item

                Separator, _:
                    break
            parser, _ <- parser.accept(TokenKind.Newline)


        # `from Mod import a, b, c` — a selective import. Each named member is recorded as
        # `__from_member` so the resolver makes exactly those members (and no others)
        # visible unqualified, matching stage0: an un-listed member stays undefined. The
        # leading `from Mod import` header tokens are skipped; every identifier after the
        # `import` keyword is a brought-in member (commas separate them).
        def from_import_declaration(parser: lmut Parser) -> void:
            from_token: Token = parser.cursor()
            parser, _ <- parser.advance()                       # `from`
            machine over parser.position while true:
                state Scan(past_import: bool, source_module: sview)
                start Scan(false, sview("", 0, 0))

                Scan(_, _), _ if parser.peek() == TokenKind.Newline or parser.peek() == TokenKind.Eof:
                    break

                Scan(true, source_module), _ if parser.peek() == TokenKind.Ident:
                    token: Token = parser.cursor()
                    parser <- parser.record_from_import_member(Lexer::text_or_empty(token, parser.source), source_module, token.line)
                    parser.position <- parser.position + 1
                    -> Scan(true, source_module)

                Scan(false, source_module), _ if parser.peek() == TokenKind.Ident and parser.header_token_text(0) == "import":
                    parser.position <- parser.position + 1
                    -> Scan(true, source_module)

                Scan(false, source_module), _ if source_module == "" and parser.peek() == TokenKind.Ident:
                    # The source module is the whole `::` chain (`from Pack::Sub import f`);
                    # a `.` in it is rejected like every other module path.
                    source_token: Token = parser.cursor()
                    source_start: usize = parser.position
                    chain_end: usize = qualified_chain_end(parser, source_start)
                    chain_last: Token = parser.tokens[chain_end]
                    source_text: sview = parser.span_view(source_token.start.usize(), chain_last.start.usize() + chain_last.length.usize())
                    parser <- parser.reject_dotted_type_chain(source_start)
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: source_text, name: "__from_decl", line: source_token.line, offset: from_token.start})
                    parser.position <- chain_end + 1.usize()
                    -> Scan(false, source_text)

                Scan(past_import, source_module), _:
                    parser.position <- parser.position + 1
                    -> Scan(past_import, source_module)
            parser, _ <- parser.accept(TokenKind.Newline)


        def declaration(parser: lmut Parser) -> Ast::Decl?:
            kind: TokenKind = parser.peek()

            match kind:
                TokenKind.Def:
                    rebind __ret_128: Ast::Decl?, parser = parser.function_declaration()
                    return __ret_128

                TokenKind.Struct:
                    rebind __ret_131: Ast::Decl?, parser = parser.struct_declaration()
                    return __ret_131

                TokenKind.Enum:
                    rebind __ret_134: Ast::Decl?, parser = parser.enum_declaration(false)
                    return __ret_134

                TokenKind.Const:
                    rebind __ret_137: Ast::Decl?, parser = parser.const_declaration()
                    return __ret_137

                TokenKind.Global:
                    rebind __ret_140: Ast::Decl?, parser = parser.const_declaration()
                    return __ret_140

                TokenKind.Extern:
                    rebind __ret_143: Ast::Decl?, parser = parser.extern_declaration()
                    return __ret_143

                TokenKind.Export:
                    rebind __ret_146: Ast::Decl?, parser = parser.extern_declaration()
                    return __ret_146

                TokenKind.Error:
                    rebind __ret_149: Ast::Decl?, parser = parser.error_type_declaration()
                    return __ret_149

                _:
                    parser <- parser.error_at(Ast::ParseErrorKind.ExpectedDeclaration, parser.cursor())
                    return null
