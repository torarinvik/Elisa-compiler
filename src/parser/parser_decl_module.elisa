extend Parser:
    private:
        # An indented `public:` / `private:` block. Visibility is a layout grouping
        # only here; members are flattened into the enclosing declaration list.
        def visibility_section(parser: mutable Parser&, out: mutable darray[Ast::Decl]&) -> void:
            parser.advance()                       # consume the public/private identifier
            parser.expect(TokenKind.Colon)
            parser.expect(TokenKind.Newline)
            parser.expect(TokenKind.Indent)
            while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof:
                parser.skip_newlines()
                break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof
                before: usize = parser.position
                parser.parse_decl_unit(out)
                if parser.position == before:      # never spin on an unrecognized token
                    parser.advance()
            parser.expect(TokenKind.Dedent)


        def module_decl(parser: mutable Parser&) -> Ast::Decl?:
            tok: Token = parser.advance()          # consume the `module`/`extend` identifier
            # A qualified module name (`module Common::Log::Class:`) is a single Ident
            # chain joined by `.` or `::`; both separators are accepted and the whole
            # chain is recorded verbatim as the module's name (mirrors parse_dotted_name,
            # but also accepts `::` since a namespace chain — unlike a value path —
            # commonly uses it).
            name_start: usize = parser.cursor().start.usize()
            first_name_token: Token = parser.expect(TokenKind.Ident)
            name_end: mutable usize = (first_name_token.start + first_name_token.length).usize()
            while (parser.peek() == TokenKind.Dot or parser.peek() == TokenKind.Scope) and parser.peek_at(1) == TokenKind.Ident:
                parser.advance()                          # `.` or `::`
                segment: Token = parser.advance()              # next Ident segment
                name_end <- (segment.start + segment.length).usize()
            name: sview = parser.span_view(name_start, name_end)

            body_items: mutable darray[Ast::Decl] = []
            if parser.peek() == TokenKind.Colon:
                parser.expect(TokenKind.Colon)
                parser.expect(TokenKind.Newline)
                parser.expect(TokenKind.Indent)
                while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof:
                    parser.skip_newlines()
                    break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof
                    before: usize = parser.position
                    # `const module`/`const enum` grouping propagates const-ness to its
                    # members, which are then written bare — `NAME: T = value` / `NAME = value`
                    # with the `const` keyword dropped (the zero-overhead-constants idiom).
                    # `decl()` only recognizes a keyword-led `const …`, so parse a bare
                    # `IDENT : T = …` / `IDENT = …` member as a Const here. A `NAME =` is
                    # unambiguous; a `NAME :` is a const member only when a type follows on
                    # the SAME line — `NAME :` NEWLINE is a `public:`/`private:` visibility
                    # section (or other block), which must fall through to parse_decl_unit.
                    is_bare_const_member =
                        match parser.peek(), parser.peek_at(1), parser.peek_at(2):
                            # `NAME :` NEWLINE — a `public:`/`private:` visibility section (or
                            # other block); falls through to parse_decl_unit.
                            TokenKind.Ident, TokenKind.Colon, TokenKind.Newline:
                                false
                            # `NAME : T …` — a typed const member (type on the SAME line).
                            TokenKind.Ident, TokenKind.Colon, _:
                                true
                            # `NAME = value` — an unambiguous valued const member.
                            TokenKind.Ident, TokenKind.Assign, _:
                                true
                            _:
                                false

                    if is_bare_const_member:
                        if parser.bare_const_member() is member:
                            body_items.push(member)
                    else:
                        parser.parse_decl_unit(body_items)
                    if parser.position == before:
                        parser.advance()
                parser.expect(TokenKind.Dedent)

            return (Ast::Decl.Module(name, body_items, tok.line))


        # A bare const-module member `NAME [: T] [= value]` (the `const` keyword is implied
        # by the enclosing `const module`/`const enum` grouping). Mirrors const_decl's
        # binding tail; recorded as a Const node.
        def bare_const_member(parser: mutable Parser&) -> Ast::Decl?:
            tok: Token = parser.cursor()
            name_tok: Token = parser.expect(TokenKind.Ident)
            type_expr: mutable Ast::Expr = (Ast::Expr.Invalid)
            if parser.accept(TokenKind.Colon) and parser.expr() is parsed_type:
                type_expr <- parsed_type
            value: mutable Ast::Expr = (Ast::Expr.Invalid)
            if parser.accept(TokenKind.Assign) and parser.expr() is parsed_value:
                value <- parsed_value
            return (Ast::Decl.Const(Lexer::text_or_empty(name_tok, parser.source), type_expr, value, false, tok.line))


        def include_decl(parser: mutable Parser&) -> Ast::Decl?:
            tok: Token = parser.advance()          # consume the `include` identifier
            path_tok: Token = parser.expect(TokenKind.StringLit)
            return (Ast::Decl.Import(Lexer::text_or_empty(path_tok, parser.source), tok.line))


        # `using Foo` / `using Foo::bar` (or `Foo.bar`) / `using Foo as F` — consumed
        # whole (qualified name, optional `as ALIAS`) since it isn't modeled yet.
        def using_decl(parser: mutable Parser&) -> void:
            parser.advance()                       # `using`
            parser.expect(TokenKind.Ident)
            while parser.peek() == TokenKind.Dot or parser.peek() == TokenKind.Scope:
                parser.advance()
                parser.expect(TokenKind.Ident)
            if parser.accept(TokenKind.As):
                parser.expect(TokenKind.Ident)
            parser.accept(TokenKind.Newline)


        def decl(parser: mutable Parser&) -> Ast::Decl?:
            kind: TokenKind = parser.peek()

            match kind:
                TokenKind.Def:
                    return parser.func_decl()

                TokenKind.Struct:
                    return parser.struct_decl()

                TokenKind.Enum:
                    return parser.enum_decl()

                TokenKind.Const:
                    return parser.const_decl()

                TokenKind.Global:
                    return parser.const_decl()

                TokenKind.Extern:
                    return parser.extern_decl()

                TokenKind.Export:
                    return parser.extern_decl()

                TokenKind.Error:
                    return parser.error_type_decl()

                _:
                    parser.error_at(Ast::ParseErrorKind.ExpectedDeclaration, parser.cursor())
                    return null


