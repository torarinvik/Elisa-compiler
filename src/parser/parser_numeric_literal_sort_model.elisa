# Pure admission predicates for numeric literal sort metadata.
module ParserNumericLiteralSort:
    public:
        def accepts_integer_token(is_integer: bool, is_hex: bool) -> bool:
            ensure result == (is_integer or is_hex)
            return is_integer or is_hex

        def accepts_suffix(suffix: sview) -> bool:
            ensure result == (
                when suffix:
                    "u8" | "u16" | "u32" | "u64" | "usize" | "i8" | "i16" | "i32" | "i64" | "isize" -> true
                    _ -> false
            )
            return when suffix:
                "u8" | "u16" | "u32" | "u64" | "usize" | "i8" | "i16" | "i32" | "i64" | "isize" -> true
                _ -> false

        def span_fits(start: usize, length: usize, source_length: usize) -> bool:
            requires start < source_length
            ensure result == (length <= source_length - start)
            return length <= source_length - start

        def span_end(start: usize, length: usize, source_length: usize) -> usize:
            requires start < source_length
            requires length <= source_length - start
            ensure result == start + length
            ensure result <= source_length
            return start + length
