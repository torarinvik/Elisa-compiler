# Stage1 parser — compile-time specialization of effect-polymorphic helpers.
#
# A function that declares an abstract effect row is a template, not a function carrying a
# runtime handler value. At each statically known `can Effect with Handler` installation we
# make one ordinary clone, prepend the handler captures as ABI parameters, and rewrite the
# clone's abstract operations to the handler's hidden direct functions. Calls inside the
# installation are then redirected to that clone. The original template is retained for
# diagnostics/metadata and filtered from backend emission.

extend Parser:
    private:
        # The append sites record parser annotations in source order. A source position
        # is the full block key: logical #line values are deliberately allowed to repeat.
        def effect_install_line_lower_bound(lines: darray[u32]&, line: u32) -> usize:
            low: mutable usize = 0
            high: mutable usize = lines.count
            while low < high |low, high, lines, line|:
                middle: usize = low + ((high - low) / 2.usize())
                if lines[middle] < line:
                    low <- middle + 1.usize()
                else:
                    high <- middle
            return low

        def effect_install_row_at(parser: Parser&, line: u32, offset: u32) -> usize:
            return parser.effect_install_lines.count if parser.effect_install_lines.count != parser.effect_install_offsets.count
            if parser.effect_install_lines_monotonic:
                index: mutable usize = effect_install_line_lower_bound(parser.effect_install_lines, line)
                while index < parser.effect_install_lines.count |index, parser, line, offset|:
                    break if parser.effect_install_lines[index] != line
                    return index if index < parser.effect_install_offsets.count and parser.effect_install_offsets[index] == offset
                    index <- index + 1.usize()
                return parser.effect_install_lines.count
            for index in 0..<parser.effect_install_lines.count:
                return index if parser.effect_install_lines[index] == line and index < parser.effect_install_offsets.count and parser.effect_install_offsets[index] == offset
            return parser.effect_install_lines.count

        def effect_install_id_at(parser: Parser&, line: u32, offset: u32) -> u32:
            index: usize = parser.effect_install_row_at(line, offset)
            return (index + 1.usize()).u32() if index < parser.effect_install_lines.count
            return 0

        def effect_install_parent(parser: Parser&, install_id: u32) -> u32:
            return 0 if install_id == 0
            index: usize = (install_id - 1).usize()
            return parser.effect_install_parents[index] if index < parser.effect_install_lines.count and index < parser.effect_install_parents.count
            return 0

        def effect_environment_covers(parser: Parser&, effect_ref: sview, installation: u32) -> bool:
            current: mutable u32 = installation
            while current != 0 |current, parser, effect_ref|:
                return true if effect_template_row_matches(effect_ref, parser.effect_install_effect_at(current))
                current <- parser.effect_install_parent(current)
            return false

        def effect_environment_arguments(parser: Parser&, installation: u32) -> darray[Ast::Expr]:
            result: mutable darray[Ast::Expr] = []
            current: mutable u32 = installation
            while current != 0 |current, result, parser|:
                result.extend(parser.effect_install_captures_at(current))
                current <- parser.effect_install_parent(current)
            return result

        def effect_ref_has_bracket(effect_ref: sview) -> bool:
            for index in 0..<effect_ref.len |effect_ref|:
                return true if effect_ref[index] == 91
            return false

        # Bare abstract rows are family-polymorphic (`can[Tick]` can be satisfied by a
        # `Tick` installation), while an explicitly specialized row must agree with the
        # installation's specialization. Qualified rows retain namespace identity when both
        # sides spell it; a bare row remains the ergonomic family-level form.
        def effect_template_row_matches(template_ref: sview, installed_ref: sview) -> bool:
            template_abstract: sview = handler_effect_abstract(template_ref)
            installed_abstract: sview = handler_effect_abstract(installed_ref)
            return handler_effect_ref_equal(template_abstract, installed_abstract) if:
                handler_effect_ref_has_namespace(template_abstract) and handler_effect_ref_has_namespace(installed_abstract)
                effect_ref_has_bracket(template_abstract) or effect_ref_has_bracket(installed_abstract)
            return handler_effect_family(template_abstract) == handler_effect_family(installed_abstract)

        def effect_template_row_is_abstract(parser: Parser&, effect_ref: sview) -> bool:
            family: sview = handler_effect_family(effect_ref)
            return any declaration_name in parser.effect_declaration_names where declaration_name == family

        def effect_template_callee_name(callee: Ast::Expr) -> sview:
            match callee:
                Expr.Ident(callee_name, callee_pos):
                    return callee_name
                Expr.Scope(scope_head, scoped_callee_name, scoped_callee_pos):
                    # Module qualification is resolved by the ordinary symbol table. The
                    # static effect pass only needs the terminal declaration name to select
                    # its already-unique clone; the clone itself is emitted at file scope.
                    return scoped_callee_name
                Expr.Index(base, argument, position):
                    return effect_template_callee_name(base)
                Expr.IndexN(base, arguments, position):
                    return effect_template_callee_name(base)
                _:
                    return ""

        def effect_template_callee_owner(callee: Ast::Expr, lexical_owner: sview) -> sview:
            match callee:
                Expr.Scope(head, name, position):
                    if head is Expr.Ident(owner, owner_pos):
                        return owner
                    return "__unresolved_effect_owner"
                Expr.Index(base, argument, position):
                    return effect_template_callee_owner(base, lexical_owner)
                Expr.IndexN(base, arguments, position):
                    return effect_template_callee_owner(base, lexical_owner)
                _:
                    return lexical_owner

        def effect_specialized_callee(callee: Ast::Expr, name: sview @source) -> Ast::Expr:
            match callee:
                Expr.Index(base, argument, position):
                    return Expr.Index(Expr.Ident(name, Ast::pos_at_line(0)), argument, position)
                Expr.IndexN(base, arguments, position):
                    return Expr.IndexN(Expr.Ident(name, Ast::pos_at_line(0)), arguments, position)
                _:
                    return Expr.Ident(name, Ast::pos_at_line(0))

        # A declared abstract row alone does not make a function a template. A helper may
        # carry an abstract permission in its contract while doing no abstract dispatch at
        # all (for example a grant-only wrapper that just returns). Only bodies which contain
        # an abstract operation call, or call another abstract-effect helper, need cloning.
        def effect_function_has_abstract_row(parser: Parser&, effects: darray[sview]) -> bool:
            for effect_ref in effects:
                return true if parser.effect_template_row_is_abstract(effect_ref)
            return false

        def effect_callee_is_abstract_helper(parser: Parser&, declarations: darray[Ast::Decl]&, callee: Ast::Expr) -> bool:
            match callee:
                Expr.Index(base, argument, position):
                    return parser.effect_callee_is_abstract_helper(declarations, base)
                Expr.IndexN(base, arguments, position):
                    return parser.effect_callee_is_abstract_helper(declarations, base)
                Expr.Scope(owner_expression, member_name, position):
                    if owner_expression is Expr.Ident(owner_name, owner_position):
                        for declaration in declarations:
                            if declaration is Decl.Module(module_name, module_body, module_position):
                                if module_name == owner_name:
                                    return parser.effect_callee_is_abstract_helper(module_body, Expr.Ident(member_name, position))
                            elif declaration is Decl.Scoped(scoped_body, scoped_position):
                                return true if parser.effect_callee_is_abstract_helper(scoped_body, callee)
                Expr.Ident(callee_name, callee_pos):
                    for declaration in declarations:
                        if declaration is Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            return true if function_name == callee_name and parser.effect_function_has_abstract_row(effects)
                        elif declaration is Decl.Scoped(scoped_body, scoped_position):
                            return true if parser.effect_callee_is_abstract_helper(scoped_body, callee)
                _:
                    pass
            return false

        def effect_expression_depends_on_abstract(parser: Parser&, expression: Ast::Expr, declared_effects: darray[sview], declarations: darray[Ast::Decl]&) -> bool:
            match expression:
                Expr.Call(callee, arguments, argument_names, call_pos):
                    if callee is Expr.Field(operation_head, operation_name, operation_pos):
                        for effect_ref in declared_effects:
                            return true if parser.effect_template_row_is_abstract(effect_ref) and handler_effect_head_family(operation_head) == handler_effect_family(effect_ref)
                    if callee is Expr.Scope(operation_head_scope, operation_name_scope, operation_scope_pos):
                        for effect_ref_scope in declared_effects:
                            return true if parser.effect_template_row_is_abstract(effect_ref_scope) and handler_effect_head_family(operation_head_scope) == handler_effect_family(effect_ref_scope)
                    return true if:
                        parser.effect_callee_is_abstract_helper(declarations, callee)
                        (parser.effect_expression_depends_on_abstract(callee, declared_effects, declarations) can Global{Read,Write})
                    for argument in arguments:
                        return true if (parser.effect_expression_depends_on_abstract(argument, declared_effects, declarations) can Global{Read,Write})
                    return false
                Expr.Field(object, field, field_pos):
                    return parser.effect_expression_depends_on_abstract(object, declared_effects, declarations) can Global{Read,Write}
                Expr.Scope(object_scope, field_scope, field_scope_pos):
                    return parser.effect_expression_depends_on_abstract(object_scope, declared_effects, declarations) can Global{Read,Write}
                Expr.Index(object_index, index, index_pos):
                    return parser.effect_expression_depends_on_abstract(object_index, declared_effects, declarations) or parser.effect_expression_depends_on_abstract(index, declared_effects, declarations) can Global{Read,Write}
                Expr.Slice(object_slice, low, high, slice_pos):
                    return parser.effect_expression_depends_on_abstract(object_slice, declared_effects, declarations) or parser.effect_expression_depends_on_abstract(low, declared_effects, declarations) or parser.effect_expression_depends_on_abstract(high, declared_effects, declarations) can Global{Read,Write}
                Expr.IndexN(object_index_n, arguments_index_n, index_n_pos):
                    return true if (parser.effect_expression_depends_on_abstract(object_index_n, declared_effects, declarations) can Global{Read,Write})
                    for argument_index_n in arguments_index_n:
                        return true if (parser.effect_expression_depends_on_abstract(argument_index_n, declared_effects, declarations) can Global{Read,Write})
                    return false
                Expr.Binary(left, operator, right, binary_pos):
                    return parser.effect_expression_depends_on_abstract(left, declared_effects, declarations) or parser.effect_expression_depends_on_abstract(right, declared_effects, declarations) can Global{Read,Write}
                Expr.Unary(operator_unary, operand, unary_pos):
                    return parser.effect_expression_depends_on_abstract(operand, declared_effects, declarations) can Global{Read,Write}
                Expr.Move(operand_move, move_pos):
                    return parser.effect_expression_depends_on_abstract(operand_move, declared_effects, declarations) can Global{Read,Write}
                Expr.RegionNew(operand_new, region, new_pos):
                    return parser.effect_expression_depends_on_abstract(operand_new, declared_effects, declarations) can Global{Read,Write}
                Expr.Paren(inner, paren_pos):
                    return parser.effect_expression_depends_on_abstract(inner, declared_effects, declarations) can Global{Read,Write}
                Expr.Array(elements, array_pos):
                    for element in elements:
                        return true if (parser.effect_expression_depends_on_abstract(element, declared_effects, declarations) can Global{Read,Write})
                    return false
                Expr.Tuple(elements_tuple, tuple_pos):
                    for element_tuple in elements_tuple:
                        return true if (parser.effect_expression_depends_on_abstract(element_tuple, declared_effects, declarations) can Global{Read,Write})
                    return false
                Expr.SetLit(elements_set, set_pos):
                    for element_set in elements_set:
                        return true if (parser.effect_expression_depends_on_abstract(element_set, declared_effects, declarations) can Global{Read,Write})
                    return false
                Expr.DictLit(entries, dict_pos):
                    for entry in entries:
                        return true if (parser.effect_expression_depends_on_abstract(entry.key, declared_effects, declarations) or parser.effect_expression_depends_on_abstract(entry.value, declared_effects, declarations) can Global{Read,Write})
                    return false
                Expr.Construct(type_expression, fields, construct_pos):
                    return true if (parser.effect_expression_depends_on_abstract(type_expression, declared_effects, declarations) can Global{Read,Write})
                    for field in fields:
                        return true if (parser.effect_expression_depends_on_abstract(field.value, declared_effects, declarations) can Global{Read,Write})
                    return false
                Expr.RecordUpdate(base, fields_update, update_pos):
                    return true if (parser.effect_expression_depends_on_abstract(base, declared_effects, declarations) can Global{Read,Write})
                    for field_update in fields_update:
                        return true if (parser.effect_expression_depends_on_abstract(field_update.value, declared_effects, declarations) can Global{Read,Write})
                    return false
                Expr.If(condition, then_expression, else_expression, if_pos):
                    return parser.effect_expression_depends_on_abstract(condition, declared_effects, declarations) or parser.effect_expression_depends_on_abstract(then_expression, declared_effects, declarations) or parser.effect_expression_depends_on_abstract(else_expression, declared_effects, declarations) can Global{Read,Write}
                Expr.Match(scrutinee, arms, match_pos):
                    return true if (parser.effect_expression_depends_on_abstract(scrutinee, declared_effects, declarations) can Global{Read,Write})
                    for arm in arms:
                        return true if (parser.effect_expression_depends_on_abstract(arm.guard, declared_effects, declarations) or parser.effect_statements_depend_on_abstract(arm.body, declared_effects, declarations) can Global{Read,Write})
                    return false
                Expr.Catch(guarded, arms_catch, catch_pos):
                    return true if (parser.effect_expression_depends_on_abstract(guarded, declared_effects, declarations) can Global{Read,Write})
                    for arm_catch in arms_catch:
                        return true if (parser.effect_expression_depends_on_abstract(arm_catch.guard, declared_effects, declarations) or parser.effect_statements_depend_on_abstract(arm_catch.body, declared_effects, declarations) can Global{Read,Write})
                    return false
                Expr.Comprehension(variable, iterable, condition_comp, body_comp, comprehension_pos, _):
                    return parser.effect_expression_depends_on_abstract(iterable, declared_effects, declarations) or parser.effect_expression_depends_on_abstract(condition_comp, declared_effects, declarations) or parser.effect_expression_depends_on_abstract(body_comp, declared_effects, declarations) can Global{Read,Write}
                Expr.Refinement(base_refinement, predicate, refinement_pos):
                    return parser.effect_expression_depends_on_abstract(base_refinement, declared_effects, declarations) or parser.effect_expression_depends_on_abstract(predicate, declared_effects, declarations) can Global{Read,Write}
                Expr.GetElse(guarded_get, recovery, get_pos):
                    return parser.effect_expression_depends_on_abstract(guarded_get, declared_effects, declarations) or parser.effect_statements_depend_on_abstract(recovery, declared_effects, declarations) can Global{Read,Write}
                Expr.Lambda(parameters_lambda, body_lambda, lambda_pos):
                    return parser.effect_statements_depend_on_abstract(body_lambda, declared_effects, declarations) can Global{Read,Write}
                Expr.Block(statements_block, value, captures, block_pos):
                    return parser.effect_statements_depend_on_abstract(statements_block, declared_effects, declarations) or parser.effect_expression_depends_on_abstract(value, declared_effects, declarations) can Global{Read,Write}
                _:
                    return false

        def effect_statements_depend_on_abstract(parser: Parser&, statements: darray[Ast::Stmt], declared_effects: darray[sview], declarations: darray[Ast::Decl]&) -> bool:
            for statement in statements:
                match statement:
                    Stmt.Expr(expression, statement_pos):
                        return true if (parser.effect_expression_depends_on_abstract(expression, declared_effects, declarations) can Global{Read,Write})
                    Stmt.VarDecl(name, type_expression, value, statement_pos):
                        return true if (parser.effect_expression_depends_on_abstract(type_expression, declared_effects, declarations) or parser.effect_expression_depends_on_abstract(value, declared_effects, declarations) can Global{Read,Write})
                    Stmt.Assign(target, operator, value_assign, statement_pos):
                        return true if (parser.effect_expression_depends_on_abstract(target, declared_effects, declarations) or parser.effect_expression_depends_on_abstract(value_assign, declared_effects, declarations) can Global{Read,Write})
                    Stmt.If(condition, then_body, else_body, statement_pos):
                        return true if (parser.effect_expression_depends_on_abstract(condition, declared_effects, declarations) or parser.effect_statements_depend_on_abstract(then_body, declared_effects, declarations) or parser.effect_statements_depend_on_abstract(else_body, declared_effects, declarations) can Global{Read,Write})
                    Stmt.While(condition_while, body_while, statement_while):
                        return true if (parser.effect_expression_depends_on_abstract(condition_while, declared_effects, declarations) or parser.effect_statements_depend_on_abstract(body_while, declared_effects, declarations) can Global{Read,Write})
                    Stmt.For(bind, variables, iterable, body_for, statement_for):
                        return true if (parser.effect_expression_depends_on_abstract(iterable, declared_effects, declarations) or parser.effect_statements_depend_on_abstract(body_for, declared_effects, declarations) can Global{Read,Write})
                    Stmt.Block(kind, clause, binding, body_block, statement_block):
                        return true if (parser.effect_statements_depend_on_abstract(body_block, declared_effects, declarations) can Global{Read,Write})
                    Stmt.Return(value_return, statement_return):
                        if value_return is returned_expression:
                            return true if (parser.effect_expression_depends_on_abstract(returned_expression, declared_effects, declarations) can Global{Read,Write})
                    Stmt.Match(scrutinee, arms_match, statement_match):
                        return true if (parser.effect_expression_depends_on_abstract(scrutinee, declared_effects, declarations) can Global{Read,Write})
                        for arm_match in arms_match:
                            return true if (parser.effect_expression_depends_on_abstract(arm_match.guard, declared_effects, declarations) or parser.effect_statements_depend_on_abstract(arm_match.body, declared_effects, declarations) can Global{Read,Write})
                    Stmt.Contract(kind_contract, expression_contract, statement_contract):
                        return true if (parser.effect_expression_depends_on_abstract(expression_contract, declared_effects, declarations) can Global{Read,Write})
                    _:
                        pass
            return false

        def mark_effect_templates(parser: lmut Parser, declarations: darray[Ast::Decl]&) -> void:
            for declaration in declarations |parser|:
                if declaration is Decl.Module(module_name, module_body, module_pos):
                    parser <- parser.mark_effect_templates(module_body) can Global{Read,Write}
                elif declaration is Decl.Scoped(scoped_body, scoped_pos):
                    parser <- parser.mark_effect_templates(scoped_body) can Global{Read,Write}
                elif declaration is Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                    has_abstract_effect: mutable bool = false
                    for effect_ref in effects |parser, has_abstract_effect|:
                        has_abstract_effect <- true if parser.effect_template_row_is_abstract(effect_ref)
                    depends_on_abstract: bool = (parser.effect_statements_depend_on_abstract(body, effects, declarations) can Global{Read,Write}) if has_abstract_effect else false
                    if depends_on_abstract:
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__effect_template", name: function_name, line: line.line, offset: line.offset}) if not (any annotation in parser.enum_annotations where annotation.owner == "__effect_template" and annotation.name == function_name and annotation.line == line.line and annotation.offset == line.offset)
                        # Keep the helper's abstract requirements available to semantic
                        # checking. A helper can have a clone for one installation and still
                        # be called directly elsewhere in the same file.
                        for effect_ref in effects |parser, function_name|:
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: function_name, name: handler_effect_abstract(effect_ref), line: 3900000100}) if parser.effect_template_row_is_abstract(effect_ref) and not (any annotation in parser.enum_annotations where annotation.owner == function_name and annotation.line == 3900000100 and annotation.name == handler_effect_abstract(effect_ref))

        def effect_install_effect_at(parser: Parser&, install_id: u32) -> sview @source:
            return "" if install_id == 0
            index: usize = (install_id - 1).usize()
            return parser.effect_install_effects[index] if index < parser.effect_install_lines.count and index < parser.effect_install_effects.count
            return ""

        def effect_install_handler_at(parser: Parser&, install_id: u32) -> sview:
            return "" if install_id == 0
            index: usize = (install_id - 1).usize()
            return parser.effect_install_handlers[index] if index < parser.effect_install_lines.count and index < parser.effect_install_handlers.count
            return ""

        def effect_install_effect_identity_at(parser: Parser&, install_id: u32) -> u32:
            return 0 if install_id == 0
            index: usize = (install_id - 1).usize()
            recorded_identity: u32 = parser.effect_install_effect_identity_ids[index] if index < parser.effect_install_lines.count and index < parser.effect_install_effect_identity_ids.count else 0
            return recorded_identity if recorded_identity != 0 or not parser.effect_declarations_complete
            install_line: u32 = parser.effect_install_lines[index] if index < parser.effect_install_lines.count else 0
            install_offset: u32 = parser.effect_install_offsets[index] if index < parser.effect_install_offsets.count else 0
            for annotation in parser.enum_annotations:
                if annotation.owner == "__effect_install_effect" and annotation.line == install_line and annotation.offset == install_offset:
                    return parser.effect_identity_for_reference(annotation.name, annotation.module, annotation.occurrence_offset)
            return 0

        def effect_install_handler_identity_at(parser: Parser&, install_id: u32) -> u32:
            return 0 if install_id == 0
            index: usize = (install_id - 1).usize()
            return parser.effect_install_handler_identity_ids[index] if index < parser.effect_install_lines.count and index < parser.effect_install_handler_identity_ids.count
            return 0


        def effect_handler_target_reference(parser: Parser&, handler_name: sview, handler_identity_id: u32) -> sview:
            return "" if handler_identity_id == 0
            for annotation in parser.enum_annotations:
                return annotation.name if annotation.line == 3900000084 and annotation.owner == handler_name and annotation.identity_id == handler_identity_id
            return ""


        def effect_handler_target_identity_at(parser: Parser&, handler_name: sview, handler_identity_id: u32) -> u32:
            return 0 if handler_identity_id == 0
            for annotation in parser.enum_annotations:
                if annotation.line == 3900000084 and annotation.owner == handler_name and annotation.identity_id == handler_identity_id:
                    return annotation.referenced_identity_id if annotation.referenced_identity_id != 0
                    return parser.effect_identity_for_reference(annotation.name, annotation.module, annotation.offset)
            return 0

        def effect_install_line_at(parser: Parser&, install_id: u32) -> u32:
            return 0 if install_id == 0
            index: usize = (install_id - 1).usize()
            return parser.effect_install_lines[index] if index < parser.effect_install_lines.count
            return 0

        def effect_install_captures_at(parser: Parser&, install_id: u32) -> darray[Ast::Expr] @source:
            captures: mutable darray[Ast::Expr] @source = []
            if parser.effect_install_capture_ids_monotonic:
                index: mutable usize = effect_install_line_lower_bound(parser.effect_install_capture_ids, install_id)
                while index < parser.effect_install_capture_ids.count |captures, index, parser, install_id|:
                    break if parser.effect_install_capture_ids[index] != install_id
                    captures.push(Ast::Expr.Ident(parser.effect_install_capture_names[index], Ast::pos_at_line(0))) if index < parser.effect_install_capture_names.count
                    index <- index + 1.usize()
            else:
                for index in 0..<parser.effect_install_capture_ids.count |captures|:
                    captures.push(Ast::Expr.Ident(parser.effect_install_capture_names[index], Ast::pos_at_line(0))) if parser.effect_install_capture_ids[index] == install_id and index < parser.effect_install_capture_names.count
            return captures

        def effect_clone_capture_name[@r](parser: mutable Parser& @r, handler_name: sview, source_line: u32, capture_index: usize) -> sview @source:
            name_bytes: mutable darray[u8] = []
            append_handler_name_text(name_bytes, "__effect_capture__")
            append_handler_name_text(name_bytes, handler_name)
            append_handler_name_text(name_bytes, "__")
            # stage0 names the clone by the line IT sees — the file's own line, not the buffer's.
            append_handler_capture_number(name_bytes, (Lexer::source_original_line(source_line) can Global{Read,Write}).usize())
            append_handler_name_text(name_bytes, "__")
            append_handler_capture_number(name_bytes, capture_index)
            return NameStore::append(&parser.handler_name_store, name_bytes, parser.name_store_chunk())

        def effect_clone_name[@r](parser: mutable Parser& @r, source_name: sview, handler_name: sview, source_line: u32, source_offset: u32) -> sview @source:
            name_bytes: mutable darray[u8] = []
            append_handler_name_text(name_bytes, "__effect__")
            append_handler_name_text(name_bytes, source_name)
            append_handler_name_text(name_bytes, "__")
            append_handler_name_text(name_bytes, handler_name)
            append_handler_name_text(name_bytes, "__")
            # stage0 names the clone by the line IT sees — the file's own line, not the buffer's.
            append_handler_capture_number(name_bytes, (Lexer::source_original_line(source_line) can Global{Read,Write}).usize())
            append_handler_name_text(name_bytes, "__src_")
            append_handler_capture_number(name_bytes, source_offset.usize())
            append_handler_name_text(name_bytes, "__at_")
            append_handler_capture_number(name_bytes, parser.effect_active_install.usize())
            return NameStore::append(&parser.handler_name_store, name_bytes, parser.name_store_chunk())

        def effect_clone_for_call(parser: Parser&, source_name: sview, argument_count: usize, effect_ref: sview, handler_name: sview, source_owner: sview) -> sview:
            selected: mutable sview = ""
            for clone_index in 0..<parser.effect_clone_names.count |parser, source_name, argument_count, effect_ref, handler_name|:
                continue if parser.effect_clone_sources[clone_index] != source_name
                continue if parser.effect_clone_owners[clone_index] != source_owner
                continue if parser.effect_clone_install_ids[clone_index] != parser.effect_active_install
                continue if argument_count > parser.effect_clone_param_counts[clone_index] or argument_count < parser.effect_clone_required_counts[clone_index]
                if parser.effect_active_install != 0:
                    return "" if selected != ""
                    selected <- parser.effect_clone_names[clone_index]
            return selected

