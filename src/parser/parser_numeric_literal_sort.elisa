# Literal sort provenance uses exact source positions. The legacy suffix arrays
# are line-only and cannot distinguish mixed signed/unsigned literals on a line.
# This is source metadata, not a range check or permission to reinterpret bits.
extend Parser:
    private:
        def record_numeric_literal_sort(parser: lmut Parser, token: Token, suffix: sview) -> void:
            return if token.kind != TokenKind.IntLit and token.kind != TokenKind.HexLit
            return if suffix != "u8" and suffix != "u16" and suffix != "u32" and suffix != "u64" and suffix != "usize" and suffix != "i8" and suffix != "i16" and suffix != "i32" and suffix != "i64" and suffix != "isize"
            start: usize = token.start.usize()
            length: usize = token.length.usize()
            return if start >= parser.source_length or length == 0
            return if length > parser.source_length - start
            spelling: sview = Lexer::source_view_or_empty(parser.source, parser.source_length, start, start + length)
            # Adjacent triple: source line + sort; source column + sort;
            # exact numeric token spelling + source line. Consumers must validate
            # the triple and independently decode/range-check the spelling.
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__numeric_literal_sort", name: suffix, line: token.line})
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__numeric_literal_sort_column", name: suffix, line: token.column})
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__numeric_literal_sort_text", name: spelling, line: token.line})
