# Literal sort provenance uses exact source positions. The legacy suffix arrays
# are line-only and cannot distinguish mixed signed/unsigned literals on a line.
# This is source metadata, not a range check or permission to reinterpret bits.
include "./parser_numeric_literal_sort_model.elisa"

extend Parser:
    private:
        # Preserve every integer token's original digits so downstream consumers can
        # distinguish full-width unsigned values from the parser's saturated i64 payload.
        # The byte offset is the stable AST join key; this metadata does not assign a type.
        def record_numeric_literal_value(parser: lmut Parser, token: Token) -> void:
            return if token.kind != TokenKind.IntLit and token.kind != TokenKind.HexLit
            start: usize = token.start.usize()
            length: usize = token.length.usize()
            return if:
                start >= parser.source_length
                length == 0
                not ParserNumericLiteralSort::span_fits(start, length, parser.source_length)
            span_end: usize = ParserNumericLiteralSort::span_end(start, length, parser.source_length)
            spelling: sview = Lexer::source_view_or_empty(parser.source, parser.source_length, start, span_end)
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__numeric_literal_value", name: spelling, line: token.line, offset: token.start})




        def record_numeric_literal_sort(parser: lmut Parser, token: Token, suffix: sview @source) -> void:
            return if:
                not ParserNumericLiteralSort::accepts_integer_token(token.kind == TokenKind.IntLit, token.kind == TokenKind.HexLit)
                not ParserNumericLiteralSort::accepts_suffix(suffix)
            start: usize = token.start.usize()
            length: usize = token.length.usize()
            return if:
                start >= parser.source_length
                length == 0
                not ParserNumericLiteralSort::span_fits(start, length, parser.source_length)
            span_end: usize = ParserNumericLiteralSort::span_end(start, length, parser.source_length)
            spelling: sview = Lexer::source_view_or_empty(parser.source, parser.source_length, start, span_end)
            # Adjacent triple: source line + sort; source column + sort;
            # exact numeric token spelling + source line. Consumers must validate
            # the triple and independently decode/range-check the spelling.
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__numeric_literal_sort", name: suffix, line: token.line})
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__numeric_literal_sort_column", name: suffix, line: token.column})
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__numeric_literal_sort_text", name: spelling, line: token.line})
