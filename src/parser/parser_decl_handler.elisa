# Stage1 parser — `handler H(capture: T) for Effect[Args]:`. The header is compile-time: every
# handler is PREDECLARED (name, owner and operations) before ordinary declaration parsing, so
# an operation call can be rewritten wherever it appears, and the members are then lowered
# into an ordinary scoped declaration. Part of `module Parser` (see parser.elisa).

extend Parser:
    private:

        # `resume()` is intentionally much smaller than a general continuation:
        # the zero-overhead subset accepts only a direct, argument-free call as a
        # top-level final statement of a void handler operation.
        def handler_resume_call(statement: Ast::Stmt) -> bool:
            if statement is Stmt.Expr(expression, statement_pos):
                if expression is Expr.Call(callee, arguments, argument_names, call_pos):
                    if callee is Expr.Ident(name, callee_pos):
                        return name == "resume"
            return false



        def handler_tail_resume(statement: Ast::Stmt) -> bool:
            if statement is Stmt.Expr(expression, statement_pos):
                if expression is Expr.Call(callee, arguments, argument_names, call_pos):
                    if callee is Expr.Ident(name, callee_pos):
                        return name == "resume" and arguments.count == 0
            return false



        def handler_return_is_void(return_type: Ast::Expr?) -> bool:
            if return_type is return_expression:
                if return_expression is Expr.Ident(name, return_pos):
                    return name == "void"
                return false
            return true



        # Count every source-level `resume` mention in a handler operation. The zero-overhead
        # subset only permits one direct, argument-free tail call; walking the complete AST here
        # prevents a nested occurrence from reaching ordinary name resolution as if it were a
        # user function. A scalar count keeps this check metadata-only and allocation-free.
        def handler_resume_mentions_expression(expression: Ast::Expr) -> usize:
            match expression:
                Expr.Ident(name, ident_pos):
                    return 1.usize() if name == "resume"
                    return 0.usize()
                Expr.Call(callee, arguments, argument_names, call_pos):
                    count: mutable usize = handler_resume_mentions_expression(callee)
                    for argument in arguments |count|:
                        count <- count + handler_resume_mentions_expression(argument)
                    return count
                Expr.Field(object, field, field_pos):
                    return handler_resume_mentions_expression(object)
                Expr.Scope(object, field, field_pos):
                    return handler_resume_mentions_expression(object)
                Expr.Index(object, index, index_pos):
                    return handler_resume_mentions_expression(object) + handler_resume_mentions_expression(index)
                Expr.Slice(object, low, high, slice_pos):
                    return handler_resume_mentions_expression(object) + handler_resume_mentions_expression(low) + handler_resume_mentions_expression(high)
                Expr.IndexN(object, arguments, index_pos):
                    count_index: mutable usize = handler_resume_mentions_expression(object)
                    for argument_index in arguments |count_index|:
                        count_index <- count_index + handler_resume_mentions_expression(argument_index)
                    return count_index
                Expr.Binary(left, operator, right, binary_pos):
                    return handler_resume_mentions_expression(left) + handler_resume_mentions_expression(right)
                Expr.Unary(operator, operand, unary_pos):
                    return handler_resume_mentions_expression(operand)
                Expr.Move(operand, move_pos):
                    return handler_resume_mentions_expression(operand)
                Expr.RegionNew(operand, region, new_pos):
                    return handler_resume_mentions_expression(operand)
                Expr.Paren(inner, paren_pos):
                    return handler_resume_mentions_expression(inner)
                Expr.Array(elements, array_pos):
                    count_array: mutable usize = 0
                    for element in elements |count_array|:
                        count_array <- count_array + handler_resume_mentions_expression(element)
                    return count_array
                Expr.Tuple(elements, tuple_pos):
                    count_tuple: mutable usize = 0
                    for element_tuple in elements |count_tuple|:
                        count_tuple <- count_tuple + handler_resume_mentions_expression(element_tuple)
                    return count_tuple
                Expr.SetLit(elements, set_pos):
                    count_set: mutable usize = 0
                    for element_set in elements |count_set|:
                        count_set <- count_set + handler_resume_mentions_expression(element_set)
                    return count_set
                Expr.DictLit(entries, dict_pos):
                    count_dict: mutable usize = 0
                    for entry in entries |count_dict|:
                        count_dict <- count_dict + handler_resume_mentions_expression(entry.key)
                        count_dict <- count_dict + handler_resume_mentions_expression(entry.value)
                    return count_dict
                Expr.Construct(type_expression, fields, construct_pos):
                    count_construct: mutable usize = handler_resume_mentions_expression(type_expression)
                    for field in fields |count_construct|:
                        count_construct <- count_construct + handler_resume_mentions_expression(field.value)
                    return count_construct
                Expr.RecordUpdate(base, fields, update_pos):
                    count_update: mutable usize = handler_resume_mentions_expression(base)
                    for field_update in fields |count_update|:
                        count_update <- count_update + handler_resume_mentions_expression(field_update.value)
                    return count_update
                Expr.If(condition, then_expression, else_expression, if_pos):
                    return handler_resume_mentions_expression(condition) + handler_resume_mentions_expression(then_expression) + handler_resume_mentions_expression(else_expression)
                Expr.Match(scrutinee, arms, match_pos):
                    count_match: mutable usize = handler_resume_mentions_expression(scrutinee)
                    for arm in arms |count_match|:
                        count_match <- count_match + handler_resume_mentions_expression(arm.guard)
                        count_match <- count_match + handler_resume_mentions_statements(arm.body)
                    return count_match
                Expr.Catch(guarded, arms, catch_pos):
                    count_catch: mutable usize = handler_resume_mentions_expression(guarded)
                    for arm_catch in arms |count_catch|:
                        count_catch <- count_catch + handler_resume_mentions_expression(arm_catch.guard)
                        count_catch <- count_catch + handler_resume_mentions_statements(arm_catch.body)
                    return count_catch
                Expr.Comprehension(variable, iterable, condition, body, comprehension_pos):
                    return handler_resume_mentions_expression(iterable) + handler_resume_mentions_expression(condition) + handler_resume_mentions_expression(body)
                Expr.Refinement(base, predicate, refinement_pos):
                    return handler_resume_mentions_expression(base) + handler_resume_mentions_expression(predicate)
                Expr.GetElse(guarded, recovery, get_pos):
                    return handler_resume_mentions_expression(guarded) + handler_resume_mentions_statements(recovery)
                Expr.Lambda(parameters, body, lambda_pos):
                    return handler_resume_mentions_statements(body)
                Expr.Block(statements, value, captures, block_pos):
                    return handler_resume_mentions_statements(statements) + handler_resume_mentions_expression(value)
                _:
                    return 0.usize()



        def handler_resume_mentions_statements(statements: darray[Ast::Stmt]) -> usize:
            count: mutable usize = 0
            for statement in statements |count|:
                match statement:
                    Stmt.Expr(expression, statement_pos):
                        count <- count + handler_resume_mentions_expression(expression)
                    Stmt.VarDecl(name, type_expression, value, statement_pos):
                        count <- count + handler_resume_mentions_expression(type_expression)
                        count <- count + handler_resume_mentions_expression(value)
                    Stmt.Assign(target, operator, value, statement_pos):
                        count <- count + handler_resume_mentions_expression(target)
                        count <- count + handler_resume_mentions_expression(value)
                    Stmt.If(condition, then_body, else_body, statement_pos):
                        count <- count + handler_resume_mentions_expression(condition)
                        count <- count + handler_resume_mentions_statements(then_body)
                        count <- count + handler_resume_mentions_statements(else_body)
                    Stmt.While(condition, body, statement_pos):
                        count <- count + handler_resume_mentions_expression(condition)
                        count <- count + handler_resume_mentions_statements(body)
                    Stmt.For(bind, variables, iterable, body, statement_pos):
                        count <- count + handler_resume_mentions_expression(iterable)
                        count <- count + handler_resume_mentions_statements(body)
                    Stmt.Block(kind, clause, binding, body, statement_pos):
                        count <- count + handler_resume_mentions_statements(body)
                    Stmt.Return(value, statement_pos):
                        count <- count + handler_resume_mentions_expression(returned_value) if value is returned_value
                    Stmt.Match(scrutinee, arms, statement_pos):
                        count <- count + handler_resume_mentions_expression(scrutinee)
                        for arm in arms |count|:
                            count <- count + handler_resume_mentions_expression(arm.guard)
                            count <- count + handler_resume_mentions_statements(arm.body)
                    Stmt.Contract(kind, expression, statement_pos):
                        count <- count + handler_resume_mentions_expression(expression)
                    _:
                        pass
            return count



        # One past the last token of the module name starting at `start_index`. Mirrors
        # `parse_module_name`: a chain of `Ident` segments joined by `.` or `::`.
        def module_name_end_index_at(parser: Parser&, start_index: usize) -> usize:
            cursor: mutable usize = start_index + 1.usize()
            while cursor + 1.usize() < parser.tokens.count |parser, cursor|:
                separator_kind: TokenKind = parser.tokens[cursor].kind
                break if separator_kind != TokenKind.Dot and separator_kind != TokenKind.Scope
                break if parser.tokens[cursor + 1.usize()].kind != TokenKind.Ident
                cursor <- cursor + 2.usize()
            return cursor



        # The module name spelled by tokens `[start_index, end_index)`, read without moving the
        # cursor and recorded verbatim, so it compares equal to the `current_module` the real
        # parse installs for the same block.
        def module_name_span_at(parser: Parser&, start_index: usize, end_index: usize) -> sview:
            first_token: Token = parser.tokens[start_index]
            last_token: Token = parser.tokens[end_index - 1.usize()]
            return parser.span_view(first_token.start.usize(), (last_token.start + last_token.length).usize())



        # Locate every `handler [static] Name` declaration site and pair it with the module that
        # lexically encloses it. `module` and `extend` are contextual identifiers whose bodies are
        # indent-delimited, so one pass with a depth-keyed stack reproduces the `current_module`
        # the real parse will establish for the same block. Owner recovery is kept in its own
        # routine: predeclaration below then walks a short site list instead of the whole token
        # stream, and neither routine carries the other's nesting.
        def collect_handler_declaration_sites(parser: lmut Parser) -> void:
            can Memory.Allocate, Abort.Panic:
                owner_names: mutable darray[sview] = []
                owner_depths: mutable darray[usize] = []
                depth: mutable usize = 0
                index: mutable usize = 0
                while index + 1.usize() < parser.tokens.count |parser, index, depth, owner_names, owner_depths|:
                    token: Token = parser.tokens[index]
                    kind: TokenKind = token.kind
                    if kind == TokenKind.Indent:
                        depth <- depth + 1.usize()
                    elif kind == TokenKind.Dedent:
                        while owner_depths.count > 0 and owner_depths[owner_depths.count - 1.usize()] >= depth |owner_names, owner_depths|:
                            owner_names.truncate(owner_names.count - 1.usize())
                            owner_depths.truncate(owner_depths.count - 1.usize())
                        depth <- depth - 1.usize() if depth > 0.usize()
                    elif kind == TokenKind.Ident:
                        token_text: sview = Lexer::text_or_empty(token, parser.source)
                        if (token_text == "module" or token_text == "extend") and parser.tokens[index + 1.usize()].kind == TokenKind.Ident:
                            # `module_declaration` only installs `current_module` for a header
                            # that actually opens an indented body, so require the same shape
                            # here rather than reacting to the keyword alone.
                            module_head_end: usize = parser.module_name_end_index_at(index + 1.usize())
                            opens_body: bool = module_head_end + 2.usize() < parser.tokens.count and parser.tokens[module_head_end].kind == TokenKind.Colon and parser.tokens[module_head_end + 1.usize()].kind == TokenKind.Newline and parser.tokens[module_head_end + 2.usize()].kind == TokenKind.Indent
                            if opens_body:
                                owner_names.push(parser.module_name_span_at(index + 1.usize(), module_head_end))
                                owner_depths.push(depth + 1.usize())
                        elif token_text == "handler":
                            name_index: mutable usize = index + 1.usize()
                            name_index <- name_index + 1.usize() if parser.tokens[name_index].kind == TokenKind.Static
                            if name_index < parser.tokens.count and parser.tokens[name_index].kind == TokenKind.Ident:
                                site_owner: sview = owner_names[owner_names.count - 1.usize()] if owner_names.count > 0 else ""
                                parser.handler_predecl_sites <- parser.handler_predecl_sites.push(index)
                                parser.handler_predecl_owners <- parser.handler_predecl_owners.push(site_owner)
                    index <- index + 1.usize()



        # Register handler names and operation names before normal declaration parsing starts.
        # Handler installations may appear before their declarations; without this source-order
        # pass the parser would optimistically lower a partial handler's missing operation to an
        # undefined hidden function. These are parser-only facts (sentinels 39000000{92,94}); the
        # actual handler declaration later records its target and ABI signatures as usual.
        def predeclare_handlers(parser: lmut Parser) -> void:
            can Memory.Allocate, Abort.Panic:
                parser <- parser.collect_handler_declaration_sites()
                for site_index in 0..<parser.handler_predecl_sites.count |parser|:
                    site_token_index: usize = parser.handler_predecl_sites[site_index]
                    site_owner: sview = parser.handler_predecl_owners[site_index]
                    parser <- parser.predeclare_handler_at(site_token_index, site_owner)



        # Predeclare one handler. `owner` is the enclosing module, so the identity registered
        # here is the same one `handler_identity_for_current_declaration` resolves to when the
        # declaration itself is parsed; an installation appearing earlier in source therefore
        # generates the same hidden operation name the declaration will define.
        def predeclare_handler_at(parser: lmut Parser, index: usize, owner: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                token: Token = parser.tokens[index]
                name_index: mutable usize = index + 1.usize()
                name_index <- name_index + 1.usize() if name_index < parser.tokens.count and parser.tokens[name_index].kind == TokenKind.Static
                return if name_index >= parser.tokens.count or parser.tokens[name_index].kind != TokenKind.Ident
                handler_name: sview = Lexer::text_or_empty(parser.tokens[name_index], parser.source)
                rebind handler_identity_id: u32, parser = parser.handler_identity_for_declaration(handler_name, owner)
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__handler_predecl", name: handler_name, line: token.line, identity_id: handler_identity_id})
                header_cursor: mutable usize = name_index + 1.usize()
                header_depth: mutable int = 0
                while header_cursor < parser.tokens.count |parser, header_cursor, header_depth|:
                    header_token: Token = parser.tokens[header_cursor]
                    break if header_depth == 0 and header_token.kind == TokenKind.Colon
                    break if header_depth == 0 and (header_token.kind == TokenKind.Newline or header_token.kind == TokenKind.Dedent or header_token.kind == TokenKind.Eof)
                    header_depth <- header_depth + 1 if header_token.kind == TokenKind.LParen or header_token.kind == TokenKind.LBracket or header_token.kind == TokenKind.LBrace
                    header_depth <- header_depth - 1 if header_depth > 0 and (header_token.kind == TokenKind.RParen or header_token.kind == TokenKind.RBracket or header_token.kind == TokenKind.RBrace)
                    header_cursor <- header_cursor + 1.usize()
                return if header_cursor >= parser.tokens.count or parser.tokens[header_cursor].kind != TokenKind.Colon
                # Preserve the handler's target row in the predeclaration table as well as its
                # operation set. An installation may precede the handler in source order, but
                # still needs the target's concrete `via` permission in its block grant. The row
                # is keyed by the handler's identity, matching the declaration's own target row.
                target_start: mutable usize = 0
                target_end: mutable usize = 0
                target_depth: mutable int = 0
                target_seen_for: mutable bool = false
                target_scan: mutable usize = name_index + 1.usize()
                while target_scan < header_cursor |parser, target_scan, target_depth, target_seen_for, target_start, target_end|:
                    target_token: Token = parser.tokens[target_scan]
                    target_text: sview = Lexer::text_or_empty(target_token, parser.source)
                    if target_depth == 0 and target_token.kind == TokenKind.Ident and target_text == "for":
                        target_seen_for <- true
                        target_start <- parser.tokens[target_scan + 1.usize()].start.usize() if target_scan + 1.usize() < header_cursor
                    elif target_seen_for:
                        target_end <- target_token.start.usize() + target_token.length.usize()
                    target_depth <- target_depth + 1 if target_token.kind == TokenKind.LParen or target_token.kind == TokenKind.LBracket or target_token.kind == TokenKind.LBrace
                    target_depth <- target_depth - 1 if target_depth > 0 and (target_token.kind == TokenKind.RParen or target_token.kind == TokenKind.RBracket or target_token.kind == TokenKind.RBrace)
                    target_scan <- target_scan + 1.usize()
                target_ref: sview = parser.span_view(target_start, target_end) if target_seen_for and target_end > target_start else ""
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: handler_name, name: target_ref, line: 3900000095, identity_id: handler_identity_id}) if target_ref != ""
                body_cursor: mutable usize = header_cursor + 1.usize()
                while body_cursor < parser.tokens.count and parser.tokens[body_cursor].kind != TokenKind.Indent and parser.tokens[body_cursor].kind != TokenKind.Eof |body_cursor|:
                    body_cursor <- body_cursor + 1.usize()
                return if body_cursor >= parser.tokens.count or parser.tokens[body_cursor].kind != TokenKind.Indent
                body_depth: mutable int = 1
                body_cursor <- body_cursor + 1.usize()
                while body_cursor < parser.tokens.count and body_depth > 0 |parser, body_cursor, body_depth, handler_name|:
                    body_token: Token = parser.tokens[body_cursor]
                    body_depth <- body_depth + 1 if body_token.kind == TokenKind.Indent
                    body_depth <- body_depth - 1 if body_token.kind == TokenKind.Dedent
                    if body_depth == 1 and body_token.kind == TokenKind.Def and body_cursor + 1.usize() < parser.tokens.count and parser.tokens[body_cursor + 1.usize()].kind == TokenKind.Ident:
                        operation_token: Token = parser.tokens[body_cursor + 1.usize()]
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: handler_name, name: Lexer::text_or_empty(operation_token, parser.source), line: 3900000094, identity_id: handler_identity_id})
                    body_cursor <- body_cursor + 1.usize()



        # `handler H(capture: T, ...) for Effect[Args]:` is lowered into an ordinary scoped
        # set of functions. Captures are prepended to each method's parameter list, making the
        # handler resource an explicit ABI parameter and preserving zero runtime overhead.
        def rewrite_handler_members(parser: lmut Parser, declarations: darray[Ast::Decl], captures: darray[Ast::ParamDecl], handler_name: sview, handler_identity_id: u32) -> darray[Ast::Decl]:
            rewritten: mutable darray[Ast::Decl] = []
            for declaration in declarations |rewritten, captures, handler_name|:
                match declaration:
                    Decl.Func(method_name, method_params, method_return, method_body, method_effects, method_decorators, method_line):
                        parameters: mutable darray[Ast::ParamDecl] = []
                        parameters.extend(captures)
                        parameters.extend(method_params)
                        hidden_name: sview = parser.handler_operation_name_for_identity(handler_name, method_name, handler_identity_id)
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: handler_name, name: method_name, line: 3900000083, identity_id: handler_identity_id})
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: handler_name, name: hidden_name, line: 3900000086, identity_id: handler_identity_id})
                        # Sentinel 3900000089 is paired by ordinal with the handler's
                        # 3900000083 operation row. Keeping the raw source contract here lets
                        # semantic report a precise signature mismatch instead of allowing an
                        # ill-typed rewritten call to become a backend decline.
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: handler_name, name: parser.signature_span_at_offset(method_line.offset.usize()), line: 3900000089, identity_id: handler_identity_id})
                        resume_count: usize = handler_resume_mentions_statements(method_body)
                        has_resume: bool = resume_count > 0.usize()
                        normalized_method_body: mutable darray[Ast::Stmt] = method_body
                        has_tail_resume: bool = method_body.count > 0 and handler_tail_resume(method_body[method_body.count - 1])
                        if has_resume:
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: handler_name, name: method_name, line: 3900000088, identity_id: handler_identity_id})
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: handler_name, name: method_name, line: 3900000091, identity_id: handler_identity_id}) if resume_count != 1 or not has_tail_resume
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: handler_name, name: method_name, line: 3900000092, identity_id: handler_identity_id}) if not handler_return_is_void(method_return)
                            # Erase the marker only in the exact tail position. The
                            # hidden operation remains a direct function call, so the
                            # caller naturally continues after it returns.
                            normalized_method_body[method_body.count - 1] <- Ast::Stmt.Return(null, Ast::pos_at_line(method_line.line)) if has_tail_resume
                        for method_effect in method_effects |parser|:
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: handler_name, name: method_effect, line: 3900000087, identity_id: handler_identity_id})
                        rewritten.push(Ast::Decl.Func(hidden_name, parameters, method_return, normalized_method_body, method_effects, method_decorators, method_line))
                    Decl.Scoped(nested_body, nested_line):
                        rebind nested_rewritten: darray[Ast::Decl], parser = parser.rewrite_handler_members(nested_body, captures, handler_name, handler_identity_id)
                        rewritten.push(Ast::Decl.Scoped(nested_rewritten, nested_line))
                    _:
                        rewritten.push(declaration)
            return rewritten



        # `handler H(capture: T) for Effect[Args]:` — the handler header is compile-time
        # metadata; the body remains a normal Decl.Scoped so the existing backend emits each
        # generated operation function directly.
        def handler_declaration(parser: lmut Parser, out: mutable darray[Ast::Decl]&) -> void:
            can Memory.Allocate, Abort.Panic:
                head: Token = parser.cursor()
                parser, _ <- parser.advance()                         # `handler`
                handler_static: mutable bool = false
                while true:
                    if parser.peek() == TokenKind.Static:
                        handler_static <- true
                        parser, _ <- parser.advance()
                        continue
                    break
                rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
                handler_name: sview = Lexer::text_or_empty(name_token, parser.source)
                rebind handler_identity_id: u32, parser = parser.handler_identity_for_current_declaration(handler_name)
                captures: mutable darray[Ast::ParamDecl] = []
                rebind accepted_lparen: bool, parser = parser.accept(TokenKind.LParen)
                if accepted_lparen:
                    rebind ignored_variadic: bool, parser = parser.parse_param_list(captures, head.line)
                required_captures: u32 =
                    for capture in captures |required_count: u32 = 0| -> required_count:
                        required_count <- required_count + 1 if not capture.has_default
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__handler_capture_total", name: handler_name, line: captures.count.u32(), identity_id: handler_identity_id})
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__handler_capture_required", name: handler_name, line: required_captures, identity_id: handler_identity_id})
                # Keep the parsed declarations in parser-owned side storage. The compact
                # handler metadata records only counts, but installation lowering needs the
                # actual default AST so omitted captures can be evaluated exactly once at
                # the lexical installation site.
                for capture in captures |parser, handler_name|:
                    parser.handler_capture_owners <- parser.handler_capture_owners.push(handler_name)
                    parser.handler_capture_identity_ids <- parser.handler_capture_identity_ids.push(handler_identity_id)
                    parser.handler_capture_params <- parser.handler_capture_params.push(capture)
                # `for` is contextual in this header, so match its spelling rather than a
                # closed lexical token kind.
                for_token: Token = parser.cursor()
                parser <- parser.error_at(Ast::ParseErrorKind.ExpectedToken, for_token) if not (parser.peek() == TokenKind.Ident and Lexer::text_or_empty(for_token, parser.source) == "for")
                parser, _ <- parser.advance() if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(for_token, parser.source) == "for"
                effect_start_token: Token = parser.cursor()
                effect_reference_start: usize = parser.position
                effect_start: usize = effect_start_token.start.usize()
                effect_end: mutable usize = effect_start
                depth: mutable int = 0
                while parser.peek() != TokenKind.Eof |parser, depth, effect_end|:
                    kind: TokenKind = parser.peek()
                    break if depth == 0 and (kind == TokenKind.Colon or kind == TokenKind.Newline)
                    current: Token = parser.cursor()
                    effect_end <- current.start.usize() + current.length.usize()
                    depth <- depth + 1 if kind == TokenKind.LParen or kind == TokenKind.LBracket
                    depth <- depth - 1 if depth > 0 and (kind == TokenKind.RParen or kind == TokenKind.RBracket)
                    parser, _ <- parser.advance()
                effect_ref: sview = parser.span_view(effect_start, effect_end)
                effect_reference_finish: usize = parser.position
                parser <- parser.record_effect_reference(effect_reference_start, effect_reference_finish)
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__handler_decl", name: handler_name, line: head.line, identity_id: handler_identity_id})
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: handler_name, name: effect_ref, line: 3900000084, identity_id: handler_identity_id,})
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__handler_scope", name: handler_name, line: head.line, identity_id: handler_identity_id})
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__handler_static", name: handler_name, line: head.line, identity_id: handler_identity_id}) if handler_static
                parser <- parser.parse_scoped_block(out, head)
                return if out.count == 0
                last_index: usize = out.count - 1
                match out[last_index]:
                    Decl.Scoped(handler_body, handler_line):
                        out.truncate(last_index)
                        rebind rewritten_handler_body: darray[Ast::Decl], parser = parser.rewrite_handler_members(handler_body, captures, handler_name, handler_identity_id)
                        out.push(Ast::Decl.Scoped(rewritten_handler_body, handler_line))
                    _:
                        pass
