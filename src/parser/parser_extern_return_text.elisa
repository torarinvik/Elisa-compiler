# Preserve the complete extern return spelling, not only its first identifier.
# This is lossless source metadata, not type checking or a native safety summary.
extend Parser:
    private:
        def extern_return_text_boundary(parser: Parser&, index: usize) -> bool:
            kind: TokenKind = parser.peek_at(index)
            return true if kind == TokenKind.Newline or kind == TokenKind.Eof or kind == TokenKind.Assign or kind == TokenKind.Colon
            return false if kind != TokenKind.Ident
            # Clause-like names in a qualified type are still part of that type.
            return false if parser.peek_at(index + 1) == TokenKind.Scope
            return false if index > 0 and parser.peek_at(index - 1) == TokenKind.Scope
            name: sview = parser.header_token_text(index)
            return name == "can" or name == "requires" or name == "ensure" or name == "ensures" or name == "decreases" or name == "changes" or name == "preserves"

        def record_extern_return_text(parser: lmut Parser, owner: sview, line: u32) -> void can[Memory.Allocate, Abort.Panic]:
            return if owner == "" or parser.peek() != TokenKind.Arrow
            index: mutable usize = 1
            return if parser.extern_return_text_boundary(index)
            first: usize = parser.tokens[parser.position + index].start.usize()
            return if first >= parser.source_length
            end: mutable usize = first
            closers: mutable darray[TokenKind] = []
            while true |index, end, closers, first, owner, line|:
                kind: TokenKind = parser.peek_at(index)
                if kind == TokenKind.Newline or kind == TokenKind.Eof:
                    return if closers.count != 0
                    break
                break if closers.count == 0 and parser.extern_return_text_boundary(index)
                if kind == TokenKind.LParen:
                    closers.push(TokenKind.RParen)
                elif kind == TokenKind.LBracket:
                    closers.push(TokenKind.RBracket)
                elif kind == TokenKind.LBrace:
                    closers.push(TokenKind.RBrace)
                elif kind == TokenKind.RParen or kind == TokenKind.RBracket or kind == TokenKind.RBrace:
                    return if closers.count == 0 or closers[closers.count - 1] != kind
                    closers.resize(closers.count - 1)
                # Match the bounded source-replay nesting limit. Deep/unfinished
                # shapes get no completeness marker, never a truncated type.
                return if closers.count > 96
                token: Token = parser.tokens[parser.position + index]
                token_start: usize = token.start.usize()
                token_length: usize = token.length.usize()
                # Reject corrupt/out-of-order spans before constructing a view;
                # add in usize only after proving the source-bound subtraction.
                return if token_start < end or token_start >= parser.source_length or token_length == 0
                return if token_length > parser.source_length - token_start
                end <- token_start + token_length
                index <- index + 1
            return if end <= first or closers.count != 0
            spelling: sview = Lexer::source_view_or_empty(parser.source, parser.source_length, first, end)
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: owner, name: "__extern_return_text_complete", line: line})
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_return_text", name: spelling, line: line})
