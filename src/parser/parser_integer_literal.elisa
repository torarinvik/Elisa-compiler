extend Parser:
    private:
        # Decode an integer-literal token's source text to its i64 value. Handles decimal
        # and `0x`/`0X` hex, skips `_` digit separators, and stops at a type suffix (e.g.
        # `3u`). Value-dependent semantic checks (division-by-zero, array-literal arity) need
        # the real value; previously every IntLit was recorded as 0.
        #
        # Accumulation is in u64 so a full-width literal (e.g. `0xFFFFFFFFFFFFFFFF` == u64.max,
        # which is -1 as an i64 bit pattern) fits without a checked-arithmetic overflow trap;
        # the exact bit pattern is then converted back to i64 (`.i64()` is a same-width
        # reinterpret — it does NOT clamp or trap; u64.max → -1). A digit is folded as u64
        # too so no signed intermediate can trap. Once the source exceeds u64.max, saturate
        # instead of wrapping: modulo wrap could turn a hostile literal such as `u64.max + 1`
        # into zero (or another small positive value) and make size-bearing syntax appear valid.
        # This recursive ghost fold specifies the exact result for every input span,
        # including separators, malformed bytes, and saturation beyond u64.max.
        ghost def parse_int_literal_reference_from(text: sview, index: usize, is_hex: bool, value: u64) -> u64:
            requires index <= sview_len(text)
            decreases sview_len(text) - index
            return value if index == sview_len(text)
            byte: u8 = sview_at(text, index)
            return parse_int_literal_reference_from(text, index + 1, is_hex, value) if byte == 95
            return 0 if not ((byte >= 48 and byte <= 57) or (is_hex and byte >= 97 and byte <= 102) or (is_hex and byte >= 65 and byte <= 70))
            digit: i64 = (byte - 48).i64() if byte >= 48 and byte <= 57 else (byte - 97 + 10).i64() if is_hex and byte >= 97 and byte <= 102 else (byte - 65 + 10).i64()
            base: u64 = 16 if is_hex else 10
            maximum: u64 = 18446744073709551615u64
            next_value: u64 = maximum if value > (maximum - digit.u64()) / base else value * base + digit.u64()
            return parse_int_literal_reference_from(text, index + 1, is_hex, next_value)

        ghost def parse_int_literal_reference(text: sview) -> i64:
            n: usize = sview_len(text)
            is_hex: bool = n >= 2 and sview_at(text, 0) == 48 and (sview_at(text, 1) == 120 or sview_at(text, 1) == 88)
            start_index: usize = 2 if is_hex else 0
            return parse_int_literal_reference_from(text, start_index, is_hex, 0).i64()

        def parse_int_literal_value(text: sview) -> i64:
            ensure result == parse_int_literal_reference(text)
            n: usize = sview_len(text)
            is_hex: bool = n >= 2 and sview_at(text, 0) == 48 and (sview_at(text, 1) == 120 or sview_at(text, 1) == 88)
            start_index: usize = 2 if is_hex else 0
            result: mutable u64 = 0
            index: mutable usize = start_index
            while index < n |index, result, text, is_hex, n, start_index|:
                decreases n - index
                invariant index <= n
                invariant parse_int_literal_reference_from(text, index, is_hex, result) == parse_int_literal_reference_from(text, start_index, is_hex, 0)
                byte: u8 = sview_at(text, index)
                if byte == 95:
                    index <- index + 1
                elif not ((byte >= 48 and byte <= 57) or (is_hex and byte >= 97 and byte <= 102) or (is_hex and byte >= 65 and byte <= 70)):
                    result <- 0
                    index <- n
                else:
                    digit: i64 = (byte - 48).i64() if byte >= 48 and byte <= 57 else (byte - 97 + 10).i64() if is_hex and byte >= 97 and byte <= 102 else (byte - 65 + 10).i64()
                    base: u64 = 16 if is_hex else 10
                    maximum: u64 = 18446744073709551615u64
                    result <- maximum if result > (maximum - digit.u64()) / base else result * base + digit.u64()
                    index <- index + 1
            return result.i64()
