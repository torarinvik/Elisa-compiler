extend Parser:
    private:
        # Decode an integer-literal token's source text to its i64 value. Handles decimal
        # and `0x`/`0X` hex, skips `_` digit separators, and stops at a type suffix (e.g.
        # `3u`). Value-dependent semantic checks (division-by-zero, array-literal arity) need
        # the real value; previously every IntLit was recorded as 0.
        #
        # Accumulation is in u64 so a full-width literal (e.g. `0xFFFFFFFFFFFFFFFF` == u64.max,
        # which is -1 as an i64 bit pattern) fits without a checked-arithmetic overflow trap;
        # the exact bit pattern is then converted back to i64 (`.i64()` is a same-width
        # reinterpret — it does NOT clamp or trap; u64.max → -1). A digit is folded as u64
        # too so no signed intermediate can trap. Once the source exceeds u64.max, saturate
        # instead of wrapping: modulo wrap could turn a hostile literal such as `u64.max + 1`
        # into zero (or another small positive value) and make size-bearing syntax appear valid.
        # This recursive ghost fold specifies the exact result for every input span,
        # including separators, malformed bytes, and saturation beyond u64.max.
        ghost def parse_int_literal_reference_from(text: sview, index: usize, is_hex: bool, value: u64) -> u64:
            requires index <= text.len
            decreases text.len - index
            return value if index == text.len
            byte: u8 = text[index].u8()
            return parse_int_literal_reference_from(text, index + 1, is_hex, value) if byte == 95
            return 0 if not ((byte >= 48 and byte <= 57) or (is_hex and byte >= 97 and byte <= 102) or (is_hex and byte >= 65 and byte <= 70))
            digit: i64 = (byte - 48).i64() if byte >= 48 and byte <= 57 else (byte - 97 + 10).i64() if is_hex and byte >= 97 and byte <= 102 else (byte - 65 + 10).i64()
            base: u64 = 16 if is_hex else 10
            maximum: u64 = 18446744073709551615u64
            next_value: u64 = maximum if value > (maximum - digit.u64()) / base else value * base + digit.u64()
            return parse_int_literal_reference_from(text, index + 1, is_hex, next_value)

        ghost def parse_int_literal_reference(text: sview) -> i64:
            n: usize = text.len
            return parse_int_literal_reference_from(text, 2, true, 0).i64() if n >= 2 and text[0] == 48 and (text[1] == 120 or text[1] == 88)
            return parse_int_literal_reference_from(text, 0, false, 0).i64()

        # One production transition, paired with the recursive oracle's exact fold step.
        # Keeping branching out of the loop lets its progress proof use this monotone bound.
        def parse_int_literal_step(text: sview, index: usize, is_hex: bool, value: u64) -> (next_index: usize, next_value: u64):
            requires index < text.len
            requires text[index].u8() == 95 or (text[index].u8() >= 48 and text[index].u8() <= 57) or (is_hex and text[index].u8() >= 97 and text[index].u8() <= 102) or (is_hex and text[index].u8() >= 65 and text[index].u8() <= 70)
            ensure result.next_index == index + 1
            ensure parse_int_literal_reference_from(text, index, is_hex, value) == parse_int_literal_reference_from(text, result.next_index, is_hex, result.next_value)
            byte: u8 = text[index].u8()
            if byte == 95:
                next_index: usize = index + 1
                assert next_index <= text.len
                assert parse_int_literal_reference_from(text, index, is_hex, value) == parse_int_literal_reference_from(text, next_index, is_hex, value)
                return (next_index, value)
            digit: i64 = (byte - 48).i64() if byte >= 48 and byte <= 57 else (byte - 97 + 10).i64() if is_hex and byte >= 97 and byte <= 102 else (byte - 65 + 10).i64()
            base: u64 = 16 if is_hex else 10
            maximum: u64 = 18446744073709551615u64
            next_value: u64 = maximum if value > (maximum - digit.u64()) / base else value * base + digit.u64()
            next_index: usize = index + 1
            assert next_index <= text.len
            assert parse_int_literal_reference_from(text, index, is_hex, value) == parse_int_literal_reference_from(text, next_index, is_hex, next_value)
            return (next_index, next_value)

        def parse_int_literal_value(text: sview) -> i64:
            ensure result == parse_int_literal_reference(text)
            n: usize = text.len
            is_hex: bool = n >= 2 and text[0] == 48 and (text[1] == 120 or text[1] == 88)
            start_index: usize = 2 if is_hex else 0
            assert start_index <= n
            assert parse_int_literal_reference(text) == parse_int_literal_reference_from(text, start_index, is_hex, 0).i64()
            result: mutable u64 = 0
            for index in start_index..<n |result, text, is_hex, n, start_index|:
                invariant index <= n
                invariant index >= start_index
                invariant n == text.len
                invariant start_index <= n
                invariant parse_int_literal_reference_from(text, index, is_hex, result) == parse_int_literal_reference_from(text, start_index, is_hex, 0)
                assert index < text.len
                byte: u8 = text[index].u8()
                if not ((byte >= 48 and byte <= 57) or (is_hex and byte >= 97 and byte <= 102) or (is_hex and byte >= 65 and byte <= 70) or byte == 95):
                    assert parse_int_literal_reference_from(text, index, is_hex, result) == 0
                    assert parse_int_literal_reference_from(text, start_index, is_hex, 0) == 0
                    return 0
                assert text[index].u8() == 95 or (text[index].u8() >= 48 and text[index].u8() <= 57) or (is_hex and text[index].u8() >= 97 and text[index].u8() <= 102) or (is_hex and text[index].u8() >= 65 and text[index].u8() <= 70)
                step: (next_index: usize, next_value: u64) = parse_int_literal_step(text, index, is_hex, result)
                assert step.next_index == index + 1
                assert parse_int_literal_reference_from(text, index, is_hex, result) == parse_int_literal_reference_from(text, step.next_index, is_hex, step.next_value)
                result <- step.next_value
                assert parse_int_literal_reference_from(text, index + 1, is_hex, result) == parse_int_literal_reference_from(text, start_index, is_hex, 0)
            assert n == text.len
            assert parse_int_literal_reference_from(text, n, is_hex, result) == result
            assert result.i64() == parse_int_literal_reference(text)
            return result.i64()
