extend Parser:
    private:
        # Decode an integer-literal token's source text to its i64 value. Handles decimal
        # and `0x`/`0X` hex, skips `_` digit separators, and stops at a type suffix (e.g.
        # `3u`). Value-dependent semantic checks (division-by-zero, array-literal arity) need
        # the real value; previously every IntLit was recorded as 0.
        #
        # Accumulation is in u64 so a full-width literal (e.g. `0xFFFFFFFFFFFFFFFF` == u64.max,
        # which is -1 as an i64 bit pattern) fits without a checked-arithmetic overflow trap;
        # the exact bit pattern is then converted back to i64 (`.i64()` is a same-width
        # reinterpret — it does NOT clamp or trap; u64.max → -1). A digit is folded as u64
        # too so no signed intermediate can trap. Once the source exceeds u64.max, saturate
        # instead of wrapping: modulo wrap could turn a hostile literal such as `u64.max + 1`
        # into zero (or another small positive value) and make size-bearing syntax appear valid.
        def parse_int_literal_value(text: sview) -> i64:
            n: usize = sview_len(text)
            is_hex: bool = n >= 2 and sview_at(text, 0) == 48 and (sview_at(text, 1) == 120 or sview_at(text, 1) == 88)
            start_index: usize = 2 if is_hex else 0
            result: mutable u64 = 0
            machine over result while true:
                state Scan(index: usize)
                start Scan(start_index)

                Scan(index), _ if index >= n:
                    break

                Scan(index), _ if sview_at(text, index) == 95:
                    -> Scan(index + 1)

                Scan(index), _ if not ((sview_at(text, index) >= 48 and sview_at(text, index) <= 57) or (is_hex and sview_at(text, index) >= 97 and sview_at(text, index) <= 102) or (is_hex and sview_at(text, index) >= 65 and sview_at(text, index) <= 70)):
                    result <- 0
                    break

                Scan(index), _:
                    digit: i64 = (sview_at(text, index) - 48).i64() if sview_at(text, index) >= 48 and sview_at(text, index) <= 57 else (sview_at(text, index) - 97 + 10).i64() if is_hex and sview_at(text, index) >= 97 and sview_at(text, index) <= 102 else (sview_at(text, index) - 65 + 10).i64()
                    base: u64 = 16 if is_hex else 10
                    maximum: u64 = 18446744073709551615u64
                    result <- maximum if result > (maximum - digit.u64()) / base else result * base + digit.u64()
                    -> Scan(index + 1)
            return result.i64()
