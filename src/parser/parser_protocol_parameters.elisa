# Protocol-typed parameters are sugar for independently inferred constrained types.
extend Parser:
    private:
        def reserve_protocol_parameter_names(buffer: mutable darray[u8]&, capacity: usize) -> void:
            buffer.reserve(capacity) if buffer.count == 0

        def protocol_parameter_path(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Ident(name, pos):
                    return name
                _:
                    return ""

        def protocol_parameter_path_prefix(expression: Ast::Expr, path: sview, end: usize) -> bool:
            match expression:
                Ast::Expr.Ident(name, pos):
                    return false if name.len != end
                    for index in 0..<end:
                        return false if sview_at(name, index) != sview_at(path, index)
                    return true
                Ast::Expr.Scope(base, name, pos):
                    return false if end <= name.len + 2
                    split: usize = end - name.len - 2
                    return false if sview_at(path, split) != 58 or sview_at(path, split + 1) != 58
                    for index in 0..<name.len:
                        return false if sview_at(name, index) != sview_at(path, split + 2 + index)
                    return protocol_parameter_path_prefix(base, path, split)
                _:
                    return false

        def protocol_parameter_path_matches(expression: Ast::Expr, path: sview) -> bool:
            return protocol_parameter_path_prefix(expression, path, path.len)

        def protocol_parameter_bound(parser: Parser&, expression: Ast::Expr, owner: sview, line: u32) -> sview:
            name: mutable sview = protocol_parameter_path(expression)
            qualified: mutable bool = false
            qualifier: mutable Ast::Expr = Ast::Expr.Invalid
            if expression is Ast::Expr.Scope(base, terminal, pos):
                qualified <- true
                qualifier <- base
            if expression is Ast::Expr.Scope(base, terminal, pos):
                name <- terminal
            return "" if name == ""
            for index in 0..<parser.generic_param_lines.count:
                return "" if parser.generic_param_lines[index] == line and parser.generic_param_names[index] == name
            for index in 0..<parser.struct_names.count:
                return "" if parser.struct_names[index] == name and ((not qualified and (parser.struct_owners[index] == owner or parser.struct_owners[index] == "")) or (qualified and protocol_parameter_path_matches(qualifier, parser.struct_owners[index])))
            # Prefer the lexical module, then top level, then explicit imports.
            for annotation in parser.enum_annotations:
                continue if annotation.owner != "__protocol_decl" or annotation.name != name
                return name if qualified and protocol_parameter_path_matches(qualifier, annotation.module)
                return name if not qualified and annotation.module == owner
            return "" if qualified
            for annotation in parser.enum_annotations:
                continue if annotation.owner != "__protocol_decl" or annotation.name != name
                return name if annotation.module == ""
                for imported in parser.enum_annotations:
                    return name if imported.name == "__using" and imported.owner == annotation.module and imported.line < line
            return ""

        def lower_protocol_parameter(parser: lmut Parser, expression: Ast::Expr, owner: sview, line: u32, ordinal: usize) -> Ast::Expr:
            match expression:
                Ast::Expr.Unary(operator, operand, pos):
                    if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Question:
                        rebind lowered: Ast::Expr, parser = parser.lower_protocol_parameter(operand, owner, line, ordinal)
                        return Ast::Expr.Unary(operator, lowered, pos)
                _:
                    pass
            bound: sview = parser.protocol_parameter_bound(expression, owner, line)
            return expression if bound == ""
            reserve_protocol_parameter_names(parser.handler_name_storage, parser.tokens.count * 128)
            parameter_name: mutable sview = ""
            candidate: mutable usize = ordinal
            while true |parser, parameter_name, candidate|:
                start: usize = parser.handler_name_storage.count
                append_handler_name_text(parser.handler_name_storage, "__protocol_arg_")
                append_handler_capture_number(parser.handler_name_storage, candidate)
                parameter_name <- sview(&parser.handler_name_storage[start], 0, parser.handler_name_storage.count - start)
                occupied: bool = any token in parser.tokens where Lexer::text_or_empty(token, parser.source) == parameter_name
                generated: bool = any name in parser.generic_param_names where name == parameter_name
                break if not occupied and not generated
                candidate <- candidate + 1
            parser.generic_param_lines <- parser.generic_param_lines.push(line)
            parser.generic_param_names <- parser.generic_param_names.push(parameter_name)
            parser.generic_param_lines <- parser.generic_param_lines.push(line + 2147483648)
            parser.generic_param_names <- parser.generic_param_names.push(bound)
            return Ast::Expr.Ident(parameter_name, Ast::expr_pos(expression))

        def lower_protocol_parameter_declarations(parser: lmut Parser, declarations: darray[Ast::Decl], owner: sview) -> darray[Ast::Decl]:
            result: mutable darray[Ast::Decl] = []
            for declaration in declarations |parser, result, owner|:
                match declaration:
                    Ast::Decl.Func(name, params, return_type, body, effects, decorators, pos):
                        generic_mark: usize = parser.generic_param_lines.count
                        lowered_params: mutable darray[Ast::ParamDecl] = []
                        for index in 0..<params.count |parser, lowered_params, params, owner, pos|:
                            parameter: Ast::ParamDecl = params[index]
                            rebind expression: Ast::Expr, parser = parser.lower_protocol_parameter(parameter.type_expression, owner, pos.line, index)
                            lowered_params.push(Ast::ParamDecl{name: parameter.name, type_expression: expression, is_mutable: parameter.is_mutable, has_default: parameter.has_default, default_value: parameter.default_value, is_affine: parameter.is_affine})
                        if parser.generic_param_lines.count == generic_mark:
                            result.push(declaration)
                            continue
                        lowered: Ast::Decl = Ast::Decl.Func(name, lowered_params, return_type, body, effects, decorators, pos)
                        result.push(lowered)
                        parser.current_module <- owner
                        recorded: mutable bool = false
                        for metadata_index in 0..<parser.generic_func_decl_lines.count |parser, recorded, lowered, pos|:
                            if parser.generic_func_decl_lines[metadata_index] == pos.line:
                                parser.generic_func_decls[metadata_index] <- lowered
                                recorded <- true
                        parser <- parser.record_generic_func_metadata(lowered, name, pos.line) if not recorded
                    Ast::Decl.Module(name, body, pos):
                        rebind lowered_body: darray[Ast::Decl], parser = parser.lower_protocol_parameter_declarations(body, name)
                        result.push(Ast::Decl.Module(name, lowered_body, pos))
                    Ast::Decl.Scoped(body, pos):
                        rebind lowered_body: darray[Ast::Decl], parser = parser.lower_protocol_parameter_declarations(body, owner)
                        result.push(Ast::Decl.Scoped(lowered_body, pos))
                    _:
                        result.push(declaration)
            return result

        def lower_protocol_parameters(parser: lmut Parser, declarations: mutable darray[Ast::Decl]&) -> void:
            source_declarations: darray[Ast::Decl] = [entry for entry in declarations]
            rebind lowered: darray[Ast::Decl], parser = parser.lower_protocol_parameter_declarations(source_declarations, "")
            declarations.clear()
            declarations.extend(lowered)
            parser.current_module <- ""
