extend Parser:
    private:
        # Max nested-expression depth. Deep enough that no real (or generated) code
        # reaches it, ~10x below the ~20k stack-overflow threshold. A pathological
        # `((((…))))` past this emits one diagnostic and unwinds instead of crashing.
        const EXPR_DEPTH_LIMIT: u32 = 2000

        # Depth-guarded entry point: every `parser.expression()` — including the recursive
        # re-entry from a parenthesized/bracketed sub-expression — passes through here,
        # so bounding `parser.depth` bounds the whole recursive-descent expression stack.
        def expression(parser: lmut Parser) -> Ast::Expr?:
            parser.depth <- parser.depth + 1
            if parser.depth > EXPR_DEPTH_LIMIT:
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, parser.cursor())
                parser.depth <- parser.depth - 1
                return null
            else:
                rebind result: Ast::Expr?, parser = parser.expression_body()
                parser.depth <- parser.depth - 1
                return result


        def expression_body(parser: lmut Parser) -> Ast::Expr?:
            rebind left: Ast::Expr, parser = get parser.unary_expression()
            rebind __d_25: Ast::Expr, parser = parser.binary_expression_at_level(left, 1)
            value: mutable Ast::Expr = __d_25

            # Projection query `EXPR for each|first VAR in ITER [where COND]` (e.g.
            # `item * 2 for each item in items where item > 0`) — the value-projecting
            # sibling of the leading-keyword query form. `for`/`each`/`first` are
            # contextual idents, so probe by shape (for + each|first + VAR + in).
            if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Ident and parser.peek_at(2) == TokenKind.Ident and parser.peek_at(3) == TokenKind.In:
                projection_saved_position: usize = parser.position
                projection_token: Token = parser.cursor()
                for_text: sview = Lexer::text_or_empty(projection_token, parser.source)
                parser, _ <- parser.advance()
                selector_token: Token = parser.cursor()
                selector_text: sview = Lexer::text_or_empty(selector_token, parser.source)
                parser.position <- projection_saved_position
                if for_text == "for" and (selector_text == "each" or selector_text == "first"):
                    parser, _ <- parser.advance()                   # `for`
                    parser, _ <- parser.advance()                   # `each` / `first`
                    rebind projection_variable_token: Token, parser = parser.expect(TokenKind.Ident)
                    parser, _ <- parser.expect(TokenKind.In)
                    rebind __d_44: Ast::Expr?, parser = parser.unary_expression()
                    projection_iterable_left: Ast::Expr = get __d_44 else return value
                    rebind projection_iterable: Ast::Expr, parser = parser.binary_expression_at_level(projection_iterable_left, 1)

                    projection_where_token: Token = parser.cursor()
                    projection_condition: Ast::Expr = |parser|
                        if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(projection_where_token, parser.source) == "where":
                            parser, _ <- parser.advance()
                            rebind where_condition_opt: Ast::Expr?, parser = parser.expression()
                            if where_condition_opt is where_condition:
                                where_condition
                            else:
                                Ast::Expr.Invalid
                        else:
                            Ast::Expr.Invalid
                    value <- Ast::Expr.Comprehension(Lexer::text_or_empty(projection_variable_token, parser.source), projection_iterable, projection_condition, value, projection_token.line)

            # Conditional expression `VALUE if COND else ALT` (Python-style ternary).
            # Not after a Dedent: there the `if` opens the NEXT statement (the value
            # just closed a multi-line block form, e.g. match-expression arms).
            if parser.peek() == TokenKind.If and not parser.prev_is_dedent():
                rebind if_token: Token, parser = parser.advance()       # `if`
                rebind condition_opt: Ast::Expr?, parser = parser.expression()
                condition: Ast::Expr = get condition_opt else return value
                alternative: mutable Ast::Expr = |parser|
                    rebind accepted_else: bool, parser = parser.accept(TokenKind.Else)
                    if accepted_else and parser.expression() is parsed_alternative:
                        parsed_alternative
                    else:
                        Ast::Expr.Invalid
                value <- Ast::Expr.If(condition, value, alternative, if_token.line)

            # Trailing inline effect grant (`expression can E1, E2`) — valid after any
            # expression, including a call argument; consumed but not modeled.
            parser <- parser.skip_trailing_can(false)
            return value


        # f-string desugar (mirrors stage0's parser_fstring.go): the FString token spans
        # the RAW interior of `f"...{EXPR}..."`. Split it into literal chunks and embedded
        # expression spans, sub-lex/sub-parse each `{EXPR}` over the SAME source buffer
        # (absolute offsets, so views and LSP positions stay valid), and build
        # `__fstr(chunk, expression, chunk, ...)`. Chunks are kept as their raw spans (stage1
        # never materializes decoded text — it does no codegen, and resolution does not
        # read chunk contents). A no-interpolation f-string collapses to a StringLit.
        # A view over an arbitrary [start,end) span of the parser's source, built via a
        # synthetic token (u8& slicing is not available here; text_or_empty is).
        def fstring_span_view(parser: Parser&, token: Token, span_start: usize, span_end: usize) -> sview:
            position: mutable LexerPosition = zeroed
            position.line <- token.line.int()
            position.column <- token.column.int()
            span_token: Token = Lexer::Token(TokenKind.StringLit, position, span_start, span_end)
            return Lexer::text_or_empty(span_token, parser.source)


        # Flush a pending literal chunk [chunk_start, end) as a raw-span StringLit, skipping
        # empty spans. Extracted so the machine arm below stays straight-line (arms forbid `if`).
        def fstring_flush_chunk(parser: Parser&, token: Token, chunk_start: usize, end: usize, arguments: mutable darray[Ast::Expr]&) -> void can[Memory.Allocate, Abort.Panic]:
            if end > chunk_start:
                arguments.push((Ast::Expr.StringLit(parser.fstring_span_view(token, chunk_start, end))))

        # Close one `{EXPR}` interpolation: `close_pos` is the matching `}`. Sub-lex + sub-parse
        # the span [expr_start, close_pos), append its expression (or an ExpectedExpression error)
        # to `arguments`, forward sub-parse errors, and reopen the next literal chunk after the
        # `}` (chunk_start <- close_pos + 1). Extracted so the arm body stays straight-line
        # (machine arms forbid the `if`/`for` this contains).
        def fstring_close_interp(parser: lmut Parser, token: Token, expr_start: usize, close_pos: usize, arguments: mutable darray[Ast::Expr]&, chunk_start: mutable usize&) -> void can[Memory.Allocate, Abort.Panic]:
            if close_pos > expr_start:
                sub_tokens: darray[Token] = Lexer::frontend_tokenize_span("", parser.source, expr_start, close_pos)
                sub_parser: mutable Parser = Parser(parser.source, sub_tokens)
                rebind part_opt: Ast::Expr?, sub_parser = sub_parser.expression()
                if part_opt is part:
                    arguments.push(part)
                for sub_error in sub_parser.errors |parser|:
                    parser.errors <- parser.errors.push(sub_error)
            else:
                parser <- parser.error_at(Ast::ParseErrorKind.ExpectedExpression, token)
            chunk_start <- close_pos + 1

        def fstring_expression(parser: lmut Parser, token: Token) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                start_offset: usize = token.start.usize()
                end_offset: usize = start_offset + token.length.usize()
                arguments: mutable darray[Ast::Expr] = []
                scan_index: mutable usize = start_offset
                chunk_start: mutable usize = start_offset
                # docs/123 §3's own worked example: the f-string scanner as a three-phase
                # `machine`. `depth` stays >= 1 by construction (only `Expr(depth), '{'` raises
                # it and the sole exit to Text is `Expr(1..1), '}'`), so the plain `usize` local
                # never underflows — the type-level `where depth > 0` is left to the design doc.
                # `chunk_start`/`arguments` are outer locals the arms grow through helper calls
                # (a statement-form machine, like the original `while`, may mutate them freely);
                # the machine's own payloads are just the interpolation state (expr_start, depth).
                machine over parser.source[scan_index].char() while scan_index < end_offset:
                    state Text
                    state Expr(expr_start: usize, depth: usize)
                    state StringInExpr(depth: usize)
                    start Text

                    # Text: `{{`/`}}`/`\` escapes stay put; a lone `{` opens an interpolation.
                    Text, '{' if scan_index + 1 < end_offset and parser.source[scan_index + 1].char() == '{':
                        scan_index <- scan_index + 2
                        -> Text
                    Text, '}' if scan_index + 1 < end_offset and parser.source[scan_index + 1].char() == '}':
                        scan_index <- scan_index + 2
                        -> Text
                    Text, '\\':
                        scan_index <- scan_index + 2
                        -> Text
                    Text, '{':
                        parser.fstring_flush_chunk(token, chunk_start, scan_index, arguments)
                        scan_index <- scan_index + 1
                        -> Expr(scan_index, 1)
                    Text, _:
                        scan_index <- scan_index + 1
                        -> Text

                    # Expr: balance braces; a `"` hands off to the string sub-state; the matching
                    # `}` at depth 1 sub-parses [expr_start, scan_index) and reopens Text.
                    Expr(expr_start, depth), '{':
                        scan_index <- scan_index + 1
                        -> Expr(expr_start, depth + 1)
                    Expr(expr_start, 1), '}':
                        parser <- parser.fstring_close_interp(token, expr_start, scan_index, arguments, chunk_start)
                        scan_index <- scan_index + 1
                        -> Text
                    Expr(expr_start, depth > 1), '}':
                        scan_index <- scan_index + 1
                        -> Expr(expr_start, depth - 1)
                    Expr(expr_start, depth), '"':
                        scan_index <- scan_index + 1
                        -> StringInExpr(depth)
                    Expr(expr_start, depth), _:
                        scan_index <- scan_index + 1
                        -> Expr(expr_start, depth)

                    # StringInExpr: a `"..."` embedded in the interpolation — never count braces.
                    StringInExpr(depth), '\\':
                        scan_index <- scan_index + 2
                        -> StringInExpr(depth)
                    StringInExpr(depth), '"':
                        scan_index <- scan_index + 1
                        -> Expr(expr_start, depth)
                    StringInExpr(depth), _:
                        scan_index <- scan_index + 1
                        -> StringInExpr(depth)
                # Flush the trailing literal chunk (chunk_start tracks the last reopened position).
                parser.fstring_flush_chunk(token, chunk_start, end_offset, arguments)
                # docs/119 gap #3: every f-string lowers through __fstr, so `f"…"` has one
                # type (the owned formatted string) whether or not it interpolates — no
                # static-literal shortcut for the no-interpolation case (which broke
                # match/if-expression arm unification). An empty f"" gets one empty part.
                if arguments.count == 0:
                    arguments.push((Ast::Expr.StringLit(sview("", 0, 0))))
                names: darray[sview] = []
                return (Ast::Expr.Call((Ast::Expr.Ident("__fstr", token.line)), arguments, names, token.line))


        # Parse an optional comprehension filter — a trailing `if COND` or `where COND`
        # — returning the condition, or Invalid when neither is present. Shared by the
        # list/dict/set comprehension forms. `if` and `where` are mutually exclusive:
        # once `if` is consumed its expression is the filter, never a following `where`.
        def parse_comprehension_filter(parser: lmut Parser) -> Ast::Expr:
            filter_token: Token = parser.cursor()
            rebind accepted_if: bool, parser = parser.accept(TokenKind.If)
            if accepted_if:
                rebind condition_opt: Ast::Expr?, parser = parser.expression()
                if condition_opt is condition:
                    return condition
                return (Ast::Expr.Invalid)
            if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(filter_token, parser.source) == "where":
                parser, _ <- parser.advance()
                rebind condition_opt_2: Ast::Expr?, parser = parser.expression()
                if condition_opt_2 is condition:
                    return condition
            return (Ast::Expr.Invalid)

        def array_literal(parser: lmut Parser) -> Ast::Expr?:
            rebind token: Token, parser = parser.expect(TokenKind.LBracket)
            element_items: mutable darray[Ast::Expr] = []

            if parser.peek() != TokenKind.RBracket:
                # A leading `...` marks a spread element (`[...rest]`, `[a, ...rest]`) —
                # splice the operand's elements. Modeled as a Unary(Ellipsis, expression) so the
                # resolver walks the operand via the existing unary path.
                rebind lead_spread: bool, parser = parser.accept(TokenKind.Ellipsis)
                rebind element_handle_value: Ast::Expr?, parser = parser.expression()
                element_handle: mutable Ast::Expr? = element_handle_value

                # List comprehension `[BODY for VAR in ITER (if COND)?]` — detected when
                # the first element is followed by the contextual `for`. ITER is parsed at
                # the binary level (no ternary post-processing) so a trailing `if COND`
                # reads as the filter, not a `ITER if … else …` conditional. Reuses the
                # Comprehension node; the resolver binds VAR and walks iterable/condition/body.
                comprehension_for_token: Token = parser.cursor()
                if not lead_spread and parser.peek() == TokenKind.Ident and Lexer::text_or_empty(comprehension_for_token, parser.source) == "for":
                    if element_handle is body:
                        parser, _ <- parser.advance()                       # `for`
                        rebind comprehension_variable_token: Token, parser = parser.expect(TokenKind.Ident)
                        parser, _ <- parser.expect(TokenKind.In)
                        rebind comprehension_iterable_left: Ast::Expr, parser = get parser.unary_expression()
                        rebind comprehension_iterable: Ast::Expr, parser = parser.binary_expression_at_level(comprehension_iterable_left, 1)
                        rebind comprehension_condition: Ast::Expr, parser = parser.parse_comprehension_filter()
                        parser, _ <- parser.expect(TokenKind.RBracket)
                        return (Ast::Expr.Comprehension(Lexer::text_or_empty(comprehension_variable_token, parser.source), comprehension_iterable, comprehension_condition, body, token.line))

                if element_handle is element:
                    if lead_spread:
                        element_items.push((Ast::Expr.Unary(TokenKind.Ellipsis, element, token.line)))
                    else:
                        element_items.push(element)

                while parser.accept(TokenKind.Comma) |parser|:
                    break if parser.peek() == TokenKind.RBracket

                    rebind inner_spread: bool, parser = parser.accept(TokenKind.Ellipsis)
                    parser, element_handle <- parser.expression()
                    if element_handle is next_element:
                        if inner_spread:
                            element_items.push((Ast::Expr.Unary(TokenKind.Ellipsis, next_element, token.line)))
                        else:
                            element_items.push(next_element)

            parser, _ <- parser.expect(TokenKind.RBracket)
            return (Ast::Expr.Array(element_items, token.line))


        # Set/dict literal: `{a, b}` is a SetLit, `{k: v, ...}` a DictLit. The form is
        # decided by whether the first element is followed by `:`. The empty `{}` is an
        # empty DictLit (the canonical empty-dict init).
        def brace_literal(parser: lmut Parser) -> Ast::Expr?:
            rebind token: Token, parser = parser.expect(TokenKind.LBrace)
            if parser.peek() == TokenKind.RBrace:
                parser, _ <- parser.advance()
                return (Ast::Expr.DictLit([], token.line))

            rebind first: Ast::Expr, parser = get parser.expression()

            rebind accepted_colon: bool, parser = parser.accept(TokenKind.Colon)
            if accepted_colon:
                # Dict literal `{k: v, ...}` OR dict comprehension `{k: v for x in xs
                # (where COND)?}` — same disambiguation as the list comprehension in
                # `array_literal`: detected when the value is followed by `for`. The
                # key/value pair is carried as a Tuple body (no dedicated dict-comp AST
                # node yet) so the resolver can still walk both sides.
                rebind first_value: Ast::Expr, parser = get parser.expression()

                comprehension_for_token: Token = parser.cursor()
                if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(comprehension_for_token, parser.source) == "for":
                    parser, _ <- parser.advance()                       # `for`
                    rebind comprehension_variable_token: Token, parser = parser.expect(TokenKind.Ident)
                    parser, _ <- parser.expect(TokenKind.In)
                    rebind comprehension_iterable_left: Ast::Expr, parser = get parser.unary_expression()
                    rebind comprehension_iterable: Ast::Expr, parser = parser.binary_expression_at_level(comprehension_iterable_left, 1)
                    rebind comprehension_condition: Ast::Expr, parser = parser.parse_comprehension_filter()
                    parser, _ <- parser.expect(TokenKind.RBrace)
                    pair: Ast::Expr = (Ast::Expr.Tuple([first, first_value], token.line))
                    return (Ast::Expr.Comprehension(Lexer::text_or_empty(comprehension_variable_token, parser.source), comprehension_iterable, comprehension_condition, pair, token.line))

                entries: mutable darray[Ast::DictEntry] = [Ast::DictEntry{key: first, value: first_value}]

                while parser.accept(TokenKind.Comma) |parser|:
                    break if parser.peek() == TokenKind.RBrace

                    rebind entry_key_opt: Ast::Expr?, parser = parser.expression()
                    if entry_key_opt is entry_key:
                        parser, _ <- parser.expect(TokenKind.Colon)
                        rebind entry_value_opt: Ast::Expr?, parser = parser.expression()
                        if entry_value_opt is entry_value:
                            entries.push(Ast::DictEntry{key: entry_key, value: entry_value})

                parser, _ <- parser.expect(TokenKind.RBrace)
                return (Ast::Expr.DictLit(entries, token.line))

            # Set comprehension `{BODY for VAR in ITER (where COND)?}` — same shape as
            # the dict-comp branch above, minus the key/value split.
            comprehension_for_token_2: Token = parser.cursor()
            if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(comprehension_for_token_2, parser.source) == "for":
                parser, _ <- parser.advance()                       # `for`
                rebind set_variable_token: Token, parser = parser.expect(TokenKind.Ident)
                parser, _ <- parser.expect(TokenKind.In)
                rebind set_iterable_left: Ast::Expr, parser = get parser.unary_expression()
                rebind set_iterable: Ast::Expr, parser = parser.binary_expression_at_level(set_iterable_left, 1)
                rebind set_condition: Ast::Expr, parser = parser.parse_comprehension_filter()
                parser, _ <- parser.expect(TokenKind.RBrace)
                return (Ast::Expr.Comprehension(Lexer::text_or_empty(set_variable_token, parser.source), set_iterable, set_condition, first, token.line))

            # Set literal `{a, b, ...}`.
            elements: mutable darray[Ast::Expr] = [first]
            while parser.accept(TokenKind.Comma) |parser|:
                break if parser.peek() == TokenKind.RBrace

                rebind element_opt: Ast::Expr?, parser = parser.expression()
                if element_opt is element:
                    elements.push(element)
            parser, _ <- parser.expect(TokenKind.RBrace)
            return (Ast::Expr.SetLit(elements, token.line))


# Whether `text` introduces a lambda: the canonical `fn` or a Unicode lambda letter —
# the BMP letters Greek λ/Λ and the Latin lambda-with-stroke ƛ, plus the
# supplementary-plane Mathematical-Alphanumeric lambda variants (all five styles,
# small and capital; the lexer spans 4-byte identifier runes). MUST stay in lockstep
# with stage0's isLambdaKeyword (compiler/src/parser). The removed `lambda` spelling
# is not accepted (rejected like stage0).
# Query-expression keywords (`KW VAR in ITER [where COND]`): quantifiers (any/all),
# value folds (first/count/sum/product/min/max), and side-effect iteration (each).
# MUST stay in lockstep with stage0's looksLikeQueryExpr keyword set.
def is_query_keyword(text: sview) -> bool:
    if text == "any" or text == "all" or text == "first" or text == "count":
        return true
    return text == "each" or text == "sum" or text == "product" or text == "min" or text == "max"


def is_lambda_keyword(text: sview) -> bool:
    if text == "fn" or text == "λ" or text == "Λ" or text == "ƛ":
        return true
    return text == "𝛌" or text == "𝜆" or text == "𝝀" or text == "𝝺" or text == "𝞴" or text == "𝚲" or text == "𝛬" or text == "𝜦" or text == "𝝠" or text == "𝞚"
