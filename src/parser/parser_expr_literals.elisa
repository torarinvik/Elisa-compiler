extend Parser:
    private:
        # Max nested-expression depth. Deep enough that no real (or generated) code
        # reaches it, ~10x below the ~20k stack-overflow threshold. A pathological
        # `((((…))))` past this emits one diagnostic and unwinds instead of crashing.
        const EXPR_DEPTH_LIMIT: u32 = 2000

        # Depth-guarded entry point: every `parser.expression()` — including the recursive
        # re-entry from a parenthesized/bracketed sub-expression — passes through here,
        # so bounding `parser.depth` bounds the whole recursive-descent expression stack.
        def expression(parser: lmut Parser) -> Ast::Expr?:
            # NOTE: do NOT rewrite this with a `|parser|` capture value-block — an
            # optional-Expr capture block in this hot recursive entry mis-lowers and
            # segfaults at runtime (stage0 codegen bug found in the docs/125 parser
            # migration). Guard-form with a cond-guarded body wrapper instead.
            parser.depth <- parser.depth + 1
            exceeded: bool = parser.depth > EXPR_DEPTH_LIMIT
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, parser.cursor()) if exceeded
            rebind result: Ast::Expr?, parser = parser.expression_body_if(not exceeded)
            parser.depth <- parser.depth - 1
            return result

        def expression_body_if(parser: lmut Parser, cond: bool) -> Ast::Expr?:
            null return if not cond
            rebind body_result: Ast::Expr?, parser = parser.expression_body()
            return body_result


        def expression_body(parser: lmut Parser) -> Ast::Expr?:
            can Abort.Panic:
                rebind left: Ast::Expr, parser = get parser.unary_expression()
                rebind binary_value: Ast::Expr, parser = parser.binary_expression_at_level(left, 1)

                # Parenthesized expression-level where view, projection query, then
                # conditional expression — each a value-in /
                # value-out suffix over the expression parsed so far.
                rebind viewed_value: Ast::Expr, parser = parser.where_view_suffix(binary_value)
                rebind projected_value: Ast::Expr, parser = parser.projection_query_suffix(viewed_value)
                rebind value: Ast::Expr, parser = parser.conditional_suffix(projected_value)

                # Trailing inline effect grant (`expression can E1, E2`) — valid after any
                # expression, including a call argument; consumed but not modeled.
                parser <- parser.skip_trailing_can(false)
                # docs/125 §6b: `EXPR can E if COND` — a can-annotated expression still admits a
                # postfix guard, which follows the effect clause, so re-run the conditional suffix.
                rebind guarded_value: Ast::Expr, parser = parser.conditional_suffix(value)
                return guarded_value

            # `SOURCE where binder: predicate`, tuple-binder, and pattern-filter forms.
            # This spelling is expression-level only inside an explicit parenthesized group;
            # declaration/type refinements use their own `where` parser.
        def where_view_suffix(parser: lmut Parser, source: Ast::Expr) -> Ast::Expr:
            source return if not parser.in_where_group
            where_token: Token = parser.cursor()
            source return if parser.peek() != TokenKind.Ident or Lexer::text_or_empty(where_token, parser.source) != "where"
            parser, _ <- parser.advance()

            binder: mutable sview = "__where_item"
            condition: mutable Ast::Expr = (Ast::Expr.Absent)
            first_token: Token = parser.cursor()
            if parser.peek() == TokenKind.Ident:
                first_text: sview = Lexer::text_or_empty(first_token, parser.source)
                # An explicit binder is followed by `:`, `,`, or `is`; a dotted/call
                # head is a variant pattern over the implicit item.
                explicit: bool = parser.peek_at(1) == TokenKind.Colon or parser.peek_at(1) == TokenKind.Comma or parser.peek_at(1) == TokenKind.Is
                binder <- first_text if explicit
                rebind head_opt: Ast::Expr?, parser = parser.expression()
                condition <- head if head_opt is head
                while parser.accept(TokenKind.Comma) |parser|:
                    parser, _ <- parser.expect(TokenKind.Ident)
                if parser.peek() == TokenKind.Is:
                    parser, _ <- parser.advance()
                    rebind subject_pattern_opt: Ast::Expr?, parser = parser.expression()
                    condition <- subject_pattern if subject_pattern_opt is subject_pattern
                rebind accepted_where_colon: bool, parser = parser.accept(TokenKind.Colon)
                if accepted_where_colon:
                    rebind predicate_opt: Ast::Expr?, parser = parser.expression()
                    if predicate_opt is predicate:
                        condition <- predicate
            return (Ast::Expr.Comprehension(binder, source, condition, (Ast::Expr.Absent), where_token.line))


        # Projection query `EXPR for each|first VAR in ITER [where COND]` (e.g.
        # `item * 2 for each item in items where item > 0`) — the value-projecting
        # sibling of the leading-keyword query form. `for`/`each`/`first` are
        # contextual idents, so probe by shape (for + each|first + VAR + in).
        # Returns `projected` untouched when the suffix is not present. Extracted from
        # expression_body so the probe reads as guards (docs/125 §6b strict flow).
        def projection_query_suffix(parser: lmut Parser, projected: Ast::Expr) -> Ast::Expr:
            can Abort.Panic:
                # `EXPR for each|first VAR (, VAR)* in ITER` — the token after the first binder
                # is `in` (single binder) or `,` (a two-binder head like `v for first k, v in d`).
                projected return if parser.peek() != TokenKind.Ident or parser.peek_at(1) != TokenKind.Ident or parser.peek_at(2) != TokenKind.Ident or (parser.peek_at(3) != TokenKind.In and parser.peek_at(3) != TokenKind.Comma)
                projection_saved_position: usize = parser.position
                projection_token: Token = parser.cursor()
                for_text: sview = Lexer::text_or_empty(projection_token, parser.source)
                parser, _ <- parser.advance()
                selector_token: Token = parser.cursor()
                selector_text: sview = Lexer::text_or_empty(selector_token, parser.source)
                parser.position <- projection_saved_position
                projected return if not (for_text == "for" and (selector_text == "each" or selector_text == "first"))
                parser, _ <- parser.advance()                   # `for`
                parser, _ <- parser.advance()                   # `each` / `first`
                rebind projection_variable_token: Token, parser = parser.expect(TokenKind.Ident)
                # The query HEAD, exactly as the leading-keyword form records it. Without it
                # `query_head_for` answers "" for a projection query, so `first` was not
                # recognised as producing its own Optional: emit_expression re-emitted the node
                # at the PAYLOAD type and the comprehension emitter took the integer-fold path,
                # where an unknown head declines. Pushed with its BINDER row so the two
                # line-keyed pools stay index-aligned.
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__query", name: selector_text, line: projection_token.line})
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__query_binder_of", name: Lexer::text_or_empty(projection_variable_token, parser.source), line: projection_token.line})
                # Extra binders (`v for first k, v in d`) — the first is canonical on the node,
                # the rest are line-paired `__query_binder` markers so the resolver scopes them.
                while parser.accept(TokenKind.Comma) |parser|:
                    rebind projection_extra_binder: Token, parser = parser.expect(TokenKind.Ident)
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: Lexer::text_or_empty(projection_extra_binder, parser.source), name: "__query_binder", line: projection_token.line})
                parser, _ <- parser.expect(TokenKind.In)
                rebind __d_44: Ast::Expr?, parser = parser.unary_expression()
                projection_iterable_left: Ast::Expr = get __d_44 else return projected
                rebind projection_iterable: Ast::Expr, parser = parser.binary_expression_at_level(projection_iterable_left, 1)

                projection_where_token: Token = parser.cursor()
                # The projection form has NO slot for a guard: `body` already holds the
                # projection. Dropping one silently is a WRONG ANSWER once the rest of the form
                # lowers -- `value for each item in items where Expr.Int(value): value > 0`
                # collected the excluded elements (stage1 38, stage0 34). Mark the line so the
                # backend DECLINES the shape rather than emitting a filter it cannot honour.
                #
                # Detected by LOOKAHEAD, before the condition's value block: that block may not
                # mutate `parser` (docs/119 E4), so the annotation cannot be pushed from inside
                # it. A false positive would only cost an extra decline, never an emit.
                projection_has_guard: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(projection_where_token, parser.source) == "where" and parser.colon_before_line_end(1)
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__query_guard_dropped", name: "", line: projection_token.line}) if projection_has_guard
                projection_condition: Ast::Expr = |parser|
                    if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(projection_where_token, parser.source) == "where":
                        parser, _ <- parser.advance()
                        guarded_projection_pattern: bool = parser.query_pattern_filter_head()
                        rebind where_condition_opt: Ast::Expr?, parser = parser.expression()
                        if where_condition_opt is where_condition:
                            if guarded_projection_pattern and parser.peek() == TokenKind.Colon:
                                parser, _ <- parser.advance()
                                # Consume the guard predicate, but keep the PATTERN in the condition
                                # slot: its `is`-payload bindings (`value` in `item is Expr.Int(value)`)
                                # must scope the projected body. Mirrors quantifier_expression, which
                                # keeps the pattern separate from the guard. (The guard is a sound
                                # resolution miss for the projection form — no dedicated slot.)
                                rebind where_guard_opt: Ast::Expr?, parser = parser.expression()
                                where_condition
                            else:
                                where_condition
                        else:
                            # `where` present but its expression failed to parse — error.
                            Ast::Expr.Invalid
                    else:
                        # No `where` clause — the filter is legitimately omitted.
                        Ast::Expr.Absent
                # `… for each x in xs with OWNER` — an EXPLICIT allocation owner for the
                # produced darray. Without consuming it the iterable stopped at `xs` and the
                # trailing `with OWNER` was left for the statement parser, which turned the
                # whole `return` into a recovery `pass` — the function then had no return at
                # all ("'names' must return a value"). The name is line-keyed for the backend;
                # the node has no slot for it.
                if parser.peek() == TokenKind.With and parser.peek_at(1) == TokenKind.Ident:
                    parser, _ <- parser.advance()                   # `with`
                    rebind projection_owner_token: Token, parser = parser.advance()
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: Lexer::text_or_empty(projection_owner_token, parser.source), name: "__query_owner", line: projection_token.line})
                return (Ast::Expr.Comprehension(Lexer::text_or_empty(projection_variable_token, parser.source), projection_iterable, projection_condition, projected, projection_token.line))


            # Conditional expression `VALUE if COND else ALT` (Python-style ternary).
            # Not after a Dedent: there the `if` opens the NEXT statement (the value
            # just closed a multi-line block form, e.g. match-expression arms).
            # Returns `selected` untouched when no ternary follows. Extracted from
            # expression_body so the probe reads as guards (docs/125 §6b strict flow).
        def conditional_suffix(parser: lmut Parser, selected: Ast::Expr) -> Ast::Expr:
            selected return if parser.peek() != TokenKind.If or parser.prev_is_dedent()
            rebind if_token: Token, parser = parser.advance()       # `if`
            rebind condition_opt: Ast::Expr?, parser = parser.expression()
            condition: Ast::Expr = get condition_opt else return selected
            alternative: mutable Ast::Expr = |parser|
                rebind accepted_else: bool, parser = parser.accept(TokenKind.Else)
                if not accepted_else:
                    Ast::Expr.Absent
                else:
                    if parser.expression() is parsed_alternative:
                        parsed_alternative
                    else:
                        Ast::Expr.Invalid
            return (Ast::Expr.If(condition, selected, alternative, if_token.line))


        # f-string desugar (mirrors stage0's parser_fstring.go): the FString token spans
        # the RAW interior of `f"...{EXPR}..."`. Split it into literal chunks and embedded
        # expression spans, sub-lex/sub-parse each `{EXPR}` over the SAME source buffer
        # (absolute offsets, so views and LSP positions stay valid), and build
        # `__fstr(chunk, expression, chunk, ...)`. Chunks are kept as their raw spans (stage1
        # never materializes decoded text — it does no codegen, and resolution does not
        # read chunk contents). A no-interpolation f-string collapses to a StringLit.
        # A view over an arbitrary [start,end) span of the parser's source, built via a
        # synthetic token (u8& slicing is not available here; text_or_empty is).
        def fstring_span_view(parser: Parser&, token: Token, span_start: usize, span_end: usize) -> sview:
            position: mutable LexerPosition = zeroed
            position.line <- token.line.int()
            position.column <- token.column.int()
            span_token: Token = Lexer::Token(TokenKind.StringLit, position, span_start, span_end)
            return Lexer::text_or_empty(span_token, parser.source)


        # Flush a pending literal chunk [chunk_start, end) as a raw-span StringLit, skipping
        # empty spans. Extracted so the machine arm below stays straight-line (arms forbid `if`).
        def fstring_flush_chunk(parser: Parser&, token: Token, chunk_start: usize, end: usize, arguments: mutable darray[Ast::Expr]&) -> void can[Memory.Allocate, Abort.Panic]:
            arguments.push((Ast::Expr.StringLit(parser.fstring_span_view(token, chunk_start, end)))) if end > chunk_start

        # Close one `{EXPR}` interpolation: `close_pos` is the matching `}`. Sub-lex + sub-parse
        # the span [expr_start, close_pos), append its expression (or an ExpectedExpression error)
        # to `arguments`, forward sub-parse errors, and reopen the next literal chunk after the
        # `}` (chunk_start <- close_pos + 1). Extracted so the arm body stays straight-line
        # (machine arms forbid the `if`/`for` this contains).
        def fstring_close_interp(parser: lmut Parser, token: Token, expr_start: usize, close_pos: usize, arguments: mutable darray[Ast::Expr]&, chunk_start: mutable usize&) -> void can[Memory.Allocate, Abort.Panic]:
            parser <- parser.error_at(Ast::ParseErrorKind.ExpectedExpression, token) if close_pos <= expr_start
            chunk_start <- close_pos + 1
            return if close_pos <= expr_start
            sub_tokens: darray[Token] = Lexer::frontend_tokenize_span("", parser.source, expr_start, close_pos)
            sub_parser: mutable Parser = Parser(parser.source, sub_tokens)
            rebind part_opt: Ast::Expr?, sub_parser = sub_parser.expression()
            if part_opt is part:
                arguments.push(part)
            for sub_error in sub_parser.errors |parser|:
                parser.errors <- parser.errors.push(sub_error)

        def fstring_expression(parser: lmut Parser, token: Token) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                start_offset: usize = token.start.usize()
                end_offset: usize = start_offset + token.length.usize()
                arguments: mutable darray[Ast::Expr] = []
                scan_index: mutable usize = start_offset
                chunk_start: mutable usize = start_offset
                # docs/123 §3's own worked example: the f-string scanner as a three-phase
                # `machine`. `depth` stays >= 1 by construction (only `Expr(depth), '{'` raises
                # it and the sole exit to Text is `Expr(1..1), '}'`), so the plain `usize` local
                # never underflows — the type-level `where depth > 0` is left to the design doc.
                # `chunk_start`/`arguments` are outer locals the arms grow through helper calls
                # (a statement-form machine, like the original `while`, may mutate them freely);
                # the machine's own payloads are just the interpolation state (expr_start, depth).
                # Explicit three-state scanner (Text / Expr / StringInExpr). This is what the
                # docs/123 §3 `machine over` form lowers to; written out because the machine
                # statement is not yet in the emitted subset. NOTE: `expr_start` is a flat local
                # here, so it SURVIVES a `"..."` inside an interpolation — the machine spelling
                # had StringInExpr carry only `depth` and then re-entered `Expr(expr_start, depth)`
                # with `expr_start` unbound, losing the interpolation's start offset.
                fs_text: i64 = 0
                fs_expr: i64 = 1
                fs_string: i64 = 2
                fs_state: mutable i64 = fs_text
                expr_start: mutable usize = start_offset
                depth: mutable usize = 0
                while scan_index < end_offset |parser, scan_index, chunk_start, arguments, fs_state, expr_start, depth, token, end_offset, fs_text, fs_expr, fs_string|:
                    ch: i64 = parser.source[scan_index].char()
                    if fs_state == fs_text:
                        # `{{`/`}}`/`\` escapes stay put; a lone `{` opens an interpolation.
                        if ch == '{' and scan_index + 1 < end_offset and parser.source[scan_index + 1].char() == '{':
                            scan_index <- scan_index + 2
                        elif ch == '}' and scan_index + 1 < end_offset and parser.source[scan_index + 1].char() == '}':
                            scan_index <- scan_index + 2
                        elif ch == '\\':
                            scan_index <- scan_index + 2
                        elif ch == '{':
                            parser.fstring_flush_chunk(token, chunk_start, scan_index, arguments)
                            scan_index <- scan_index + 1
                            expr_start <- scan_index
                            depth <- 1
                            fs_state <- fs_expr
                        else:
                            scan_index <- scan_index + 1
                    elif fs_state == fs_expr:
                        # Balance braces; a `"` hands off to the string sub-state; the matching
                        # `}` at depth 1 sub-parses [expr_start, scan_index) and reopens Text.
                        if ch == '{':
                            scan_index <- scan_index + 1
                            depth <- depth + 1
                        elif ch == '}' and depth == 1:
                            parser <- parser.fstring_close_interp(token, expr_start, scan_index, arguments, chunk_start)
                            scan_index <- scan_index + 1
                            fs_state <- fs_text
                        elif ch == '}':
                            scan_index <- scan_index + 1
                            depth <- depth - 1
                        elif ch == '"':
                            scan_index <- scan_index + 1
                            fs_state <- fs_string
                        else:
                            scan_index <- scan_index + 1
                    else:
                        # A `"..."` embedded in the interpolation — never count braces.
                        if ch == '\\':
                            scan_index <- scan_index + 2
                        elif ch == '"':
                            scan_index <- scan_index + 1
                            fs_state <- fs_expr
                        else:
                            scan_index <- scan_index + 1
                # Flush the trailing literal chunk (chunk_start tracks the last reopened position).
                parser.fstring_flush_chunk(token, chunk_start, end_offset, arguments)
                # docs/119 gap #3: every f-string lowers through __fstr, so `f"…"` has one
                # type (the owned formatted string) whether or not it interpolates — no
                # static-literal shortcut for the no-interpolation case (which broke
                # match/if-expression arm unification). An empty f"" gets one empty part.
                arguments.push((Ast::Expr.StringLit(sview("", 0, 0)))) if arguments.count == 0
                names: darray[sview] = []
                return (Ast::Expr.Call((Ast::Expr.Ident("__fstr", token.line)), arguments, names, token.line))


        # Parse an optional comprehension filter — a trailing `if COND` or `where COND`
        # — returning the condition, or Invalid when neither is present. Shared by the
        # list/dict/set comprehension forms. `if` and `where` are mutually exclusive:
        # once `if` is consumed its expression is the filter, never a following `where`.
        # Leading-guard helper for the `if`-filter branch of `parse_comprehension_filter`:
        # null when `if` was not accepted, so the caller reaches it via a valued-return
        # guard instead of a ternary over two lmut-Parser-threading calls (docs/125 §6b).
        def try_if_filter_condition(parser: lmut Parser, accepted_if: bool) -> Ast::Expr?:
            null return if not accepted_if
            rebind condition: Ast::Expr, parser = parser.comprehension_filter_condition()
            return condition

        def parse_comprehension_filter(parser: lmut Parser) -> Ast::Expr:
            filter_token: Token = parser.cursor()
            rebind accepted_if: bool, parser = parser.accept(TokenKind.If)
            rebind maybe_if_filter: Ast::Expr?, parser = parser.try_if_filter_condition(accepted_if)
            if maybe_if_filter is if_filter_condition:
                return if_filter_condition
            has_where: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(filter_token, parser.source) == "where"
            # Neither `if` nor `where` — the filter is legitimately omitted.
            (Ast::Expr.Absent) return if not has_where
            # A COMPREHENSION filter is spelled `if`, never `where`: stage0 parses
            # `[i for i in 0..<4 where i > 0]` as an unterminated list and reports
            # `expected ], got "where"`, while stage1 accepted it. `where` is the QUERY
            # form's filter (`count x in xs where …`), which has its own parser.
            # Reported and then consumed anyway, so the rest of the expression still parses
            # and the error list stays short — the same shape as the `in OWNER` guard below.
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, filter_token)
            parser, _ <- parser.advance()
            rebind where_condition: Ast::Expr, parser = parser.comprehension_filter_condition()
            return where_condition

        # The condition expression after a consumed `if`/`where` filter keyword —
        # the parsed expression, or Invalid when the keyword's expression failed
        # to parse (a real error, unlike the legitimately omitted Absent).
        def comprehension_filter_condition(parser: lmut Parser) -> Ast::Expr:
            rebind condition_opt: Ast::Expr?, parser = parser.expression()
            if condition_opt is condition:
                return condition
            return (Ast::Expr.Invalid)

        # The shared `for VAR in ITER (if|where COND)? CLOSE` tail of the list/dict/set
        # comprehension forms, entered with the contextual `for` still unconsumed.
        # ITER is parsed at the binary level (no ternary post-processing) so a trailing
        # `if COND` reads as the filter, not a `ITER if … else …` conditional. Reuses the
        # Comprehension node; the resolver binds VAR and walks iterable/condition/body.
        def finish_comprehension_tail(parser: lmut Parser, close: TokenKind, token: Token, body: Ast::Expr) -> Ast::Expr?:
            can Abort.Panic:
                parser, _ <- parser.advance()                       # `for`
                rebind comprehension_variable_token: Token, parser = parser.expect(TokenKind.Ident)
                # Extra binders (`[v for k, v in d]`) — first canonical on the node, the rest
                # line-paired `__query_binder` markers so the resolver scopes them.
                while parser.accept(TokenKind.Comma) |parser|:
                    rebind comprehension_extra_binder: Token, parser = parser.expect(TokenKind.Ident)
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: Lexer::text_or_empty(comprehension_extra_binder, parser.source), name: "__query_binder", line: token.line})
                parser, _ <- parser.expect(TokenKind.In)
                rebind comprehension_iterable_left: Ast::Expr, parser = get parser.unary_expression()
                rebind comprehension_iterable: Ast::Expr, parser = parser.binary_expression_at_level(comprehension_iterable_left, 1)
                rebind comprehension_condition: Ast::Expr, parser = parser.parse_comprehension_filter()
                parser, _ <- parser.expect(close)
                # `[… for x in xs] in OWNER` — an EXPRESSION owner on a comprehension. stage0
                # rejects it (an owner belongs on the binding, not the comprehension); stage1
                # read the trailing `in` as an ordinary membership test and accepted it.
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, parser.cursor()) if parser.peek() == TokenKind.In
                return (Ast::Expr.Comprehension(Lexer::text_or_empty(comprehension_variable_token, parser.source), comprehension_iterable, comprehension_condition, body, token.line))

            # Leading-guard helper: null when `is_match` is false, so callers reach
            # `finish_comprehension_tail` via a valued-return guard instead of a ternary
            # over two lmut-Parser-threading calls (docs/125 §6b).
        def try_finish_comprehension_tail(parser: lmut Parser, close: TokenKind, token: Token, body: Ast::Expr, is_match: bool) -> Ast::Expr?:
            can Abort.Panic:
                null return if not is_match
                rebind result: Ast::Expr?, parser = parser.finish_comprehension_tail(close, token, body)
                return result

            # Consume the closing `]` and build the Array node — the common tail of the
            # empty and element-list paths of array_literal.
        def close_array_literal(parser: lmut Parser, token: Token, element_items: darray[Ast::Expr]) -> Ast::Expr?:
            parser, _ <- parser.expect(TokenKind.RBracket)
            return (Ast::Expr.Array(element_items, token.line))

        # Leading-guard helper: null when the array is not immediately closed, so
        # `array_literal` reaches `close_array_literal` via a valued-return guard
        # instead of a ternary over two lmut-Parser-threading calls (docs/125 §6b).
        def try_close_empty_array(parser: lmut Parser, token: Token, element_items: darray[Ast::Expr]) -> Ast::Expr?:
            null return if parser.peek() != TokenKind.RBracket
            rebind closed: Ast::Expr?, parser = parser.close_array_literal(token, element_items)
            return closed

        def array_literal(parser: lmut Parser) -> Ast::Expr?:
            rebind token: Token, parser = parser.expect(TokenKind.LBracket)
            element_items: mutable darray[Ast::Expr] = []

            rebind maybe_closed_empty: Ast::Expr?, parser = parser.try_close_empty_array(token, element_items)
            if maybe_closed_empty is closed_empty:
                return closed_empty

            # A leading `...` marks a spread element (`[...rest]`, `[a, ...rest]`) —
            # splice the operand's elements. Modeled as a Unary(Ellipsis, expression) so the
            # resolver walks the operand via the existing unary path.
            rebind lead_spread: bool, parser = parser.accept(TokenKind.Ellipsis)
            rebind element_handle_value: Ast::Expr?, parser = parser.expression()
            element_handle: mutable Ast::Expr? = element_handle_value

            # List comprehension `[BODY for VAR in ITER (if COND)?]` — detected when
            # the first element is followed by the contextual `for`.
            comprehension_for_token: Token = parser.cursor()
            if element_handle is body:
                is_list_comprehension: bool = not lead_spread and parser.peek() == TokenKind.Ident and Lexer::text_or_empty(comprehension_for_token, parser.source) == "for"
                rebind maybe_list_comprehension: Ast::Expr?, parser = parser.try_finish_comprehension_tail(TokenKind.RBracket, token, body, is_list_comprehension)
                if maybe_list_comprehension is list_comprehension_result:
                    return list_comprehension_result
                element_items.push((Ast::Expr.Unary(TokenKind.Ellipsis, body, token.line)) if lead_spread else body)

            while parser.accept(TokenKind.Comma) |parser|:
                break if parser.peek() == TokenKind.RBracket

                rebind inner_spread: bool, parser = parser.accept(TokenKind.Ellipsis)
                parser, element_handle <- parser.expression()
                if element_handle is next_element:
                    element_items.push((Ast::Expr.Unary(TokenKind.Ellipsis, next_element, token.line)) if inner_spread else next_element)

            rebind closed: Ast::Expr?, parser = parser.close_array_literal(token, element_items)
            return closed


        # Consume the closing `}` of an empty brace pair and build the canonical
        # empty-dict literal. Split out so `brace_literal` can reach it via a
        # valued-return guard instead of a block `if` (docs/125 §6b).
        def empty_dict_literal(parser: lmut Parser, token: Token) -> Ast::Expr?:
            parser, _ <- parser.advance()
            return (Ast::Expr.DictLit([], token.line))

        # Leading-guard helper: null when the brace pair is not immediately closed, so
        # `brace_literal` reaches `empty_dict_literal` via a valued-return guard instead
        # of a ternary over two lmut-Parser-threading calls (docs/125 §6b).
        def try_empty_dict_literal(parser: lmut Parser, token: Token) -> Ast::Expr?:
            null return if parser.peek() != TokenKind.RBrace
            rebind result: Ast::Expr?, parser = parser.empty_dict_literal(token)
            return result

        # Tail of a dict comprehension `{k: v for x in xs (where COND)?}`, entered
        # with the cursor just after the confirmed `for`. The key/value pair is
        # carried as a Tuple body (no dedicated dict-comp AST node yet) so the
        # resolver can still walk both sides.
        def dict_comprehension_tail(parser: lmut Parser, first: Ast::Expr, first_value: Ast::Expr, token: Token) -> Ast::Expr?:
            parser, _ <- parser.advance()                       # `for`
            rebind comprehension_variable_token: Token, parser = parser.expect(TokenKind.Ident)
            parser, _ <- parser.expect(TokenKind.In)
            rebind comprehension_iterable_left: Ast::Expr, parser = get parser.unary_expression()
            rebind comprehension_iterable: Ast::Expr, parser = parser.binary_expression_at_level(comprehension_iterable_left, 1)
            rebind comprehension_condition: Ast::Expr, parser = parser.parse_comprehension_filter()
            parser, _ <- parser.expect(TokenKind.RBrace)
            pair: Ast::Expr = (Ast::Expr.Tuple([first, first_value], token.line))
            return (Ast::Expr.Comprehension(Lexer::text_or_empty(comprehension_variable_token, parser.source), comprehension_iterable, comprehension_condition, pair, token.line))

        # Leading-guard helper: null when `is_match` is false, so `dict_literal_tail`
        # reaches `dict_comprehension_tail` via a valued-return guard instead of a
        # ternary over two lmut-Parser-threading calls (docs/125 §6b).
        def try_dict_comprehension_tail(parser: lmut Parser, first: Ast::Expr, first_value: Ast::Expr, token: Token, is_match: bool) -> Ast::Expr?:
            can Abort.Panic:
                null return if not is_match
                rebind result: Ast::Expr?, parser = parser.dict_comprehension_tail(first, first_value, token)
                return result

            # Tail of a dict literal `{k: v, ...}` once the comprehension form has been
            # ruled out: collects the remaining `key: value` entries.
        def dict_entries_tail(parser: lmut Parser, first: Ast::Expr, first_value: Ast::Expr, token: Token) -> Ast::Expr?:
            entries: mutable darray[Ast::DictEntry] = [Ast::DictEntry{key: first, value: first_value}]

            while parser.accept(TokenKind.Comma) |parser|:
                break if parser.peek() == TokenKind.RBrace

                rebind entry_key_opt: Ast::Expr?, parser = parser.expression()
                if entry_key_opt is entry_key:
                    parser, _ <- parser.expect(TokenKind.Colon)
                    rebind entry_value_opt: Ast::Expr?, parser = parser.expression()
                    if entry_value_opt is entry_value:
                        entries.push(Ast::DictEntry{key: entry_key, value: entry_value})

            parser, _ <- parser.expect(TokenKind.RBrace)
            return (Ast::Expr.DictLit(entries, token.line))

        # Dict literal `{k: v, ...}` OR dict comprehension `{k: v for x in xs (where
        # COND)?}` — same disambiguation as the list comprehension in `array_literal`:
        # detected when the value is followed by `for`. Returns `null` when the `:`
        # was never accepted, so `brace_literal` can reach this via a valued-return
        # guard (docs/125 §6b) instead of wrapping the whole tail in a block `if`.
        def dict_literal_tail(parser: lmut Parser, first: Ast::Expr, accepted_colon: bool, token: Token) -> Ast::Expr?:
            can Abort.Panic:
                null return if not accepted_colon

                rebind first_value: Ast::Expr, parser = get parser.expression()

                comprehension_for_token: Token = parser.cursor()
                is_dict_comprehension: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(comprehension_for_token, parser.source) == "for"
                rebind maybe_dict_comprehension: Ast::Expr?, parser = parser.try_dict_comprehension_tail(first, first_value, token, is_dict_comprehension)
                if maybe_dict_comprehension is dict_comprehension_result:
                    return dict_comprehension_result
                rebind dict_entries_result: Ast::Expr?, parser = parser.dict_entries_tail(first, first_value, token)
                return dict_entries_result

            # Tail of a set comprehension `{BODY for VAR in ITER (where COND)?}` —
            # entered with the cursor just after the confirmed `for`. Same shape as
            # `dict_comprehension_tail`, minus the key/value split.
        def set_comprehension_tail(parser: lmut Parser, first: Ast::Expr, token: Token) -> Ast::Expr?:
            can Abort.Panic:
                parser, _ <- parser.advance()                       # `for`
                rebind set_variable_token: Token, parser = parser.expect(TokenKind.Ident)
                parser, _ <- parser.expect(TokenKind.In)
                rebind set_iterable_left: Ast::Expr, parser = get parser.unary_expression()
                rebind set_iterable: Ast::Expr, parser = parser.binary_expression_at_level(set_iterable_left, 1)
                rebind set_condition: Ast::Expr, parser = parser.parse_comprehension_filter()
                parser, _ <- parser.expect(TokenKind.RBrace)
                return (Ast::Expr.Comprehension(Lexer::text_or_empty(set_variable_token, parser.source), set_iterable, set_condition, first, token.line))

            # Leading-guard helper: null when `is_match` is false, so `brace_literal`
            # reaches `set_comprehension_tail` via a valued-return guard instead of a
            # ternary over two lmut-Parser-threading calls (docs/125 §6b).
        def try_set_comprehension_tail(parser: lmut Parser, first: Ast::Expr, token: Token, is_match: bool) -> Ast::Expr?:
            can Abort.Panic:
                null return if not is_match
                rebind result: Ast::Expr?, parser = parser.set_comprehension_tail(first, token)
                return result

            # Set/dict literal: `{a, b}` is a SetLit, `{k: v, ...}` a DictLit. The form is
            # decided by whether the first element is followed by `:`. The empty `{}` is an
            # empty DictLit (the canonical empty-dict init).
        def brace_literal(parser: lmut Parser) -> Ast::Expr?:
            rebind token: Token, parser = parser.expect(TokenKind.LBrace)
            rebind maybe_empty_dict: Ast::Expr?, parser = parser.try_empty_dict_literal(token)
            if maybe_empty_dict is empty_dict_result:
                return empty_dict_result

            rebind first: Ast::Expr, parser = get parser.expression()

            rebind accepted_colon: bool, parser = parser.accept(TokenKind.Colon)
            rebind dict_result: Ast::Expr?, parser = parser.dict_literal_tail(first, accepted_colon, token)
            if dict_result is result:
                return result

            # Set comprehension `{BODY for VAR in ITER (where COND)?}` — same shape as
            # the dict-comp branch above, minus the key/value split.
            comprehension_for_token_2: Token = parser.cursor()
            is_set_comprehension: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(comprehension_for_token_2, parser.source) == "for"
            rebind maybe_set_comprehension: Ast::Expr?, parser = parser.try_set_comprehension_tail(first, token, is_set_comprehension)
            if maybe_set_comprehension is set_comprehension_result:
                return set_comprehension_result

            # Set literal `{a, b, ...}`.
            elements: mutable darray[Ast::Expr] = [first]
            while parser.accept(TokenKind.Comma) |parser|:
                break if parser.peek() == TokenKind.RBrace

                rebind element_opt: Ast::Expr?, parser = parser.expression()
                if element_opt is element:
                    elements.push(element)
            parser, _ <- parser.expect(TokenKind.RBrace)
            return (Ast::Expr.SetLit(elements, token.line))


# Whether `text` introduces a lambda: the canonical `fn` or a Unicode lambda letter —
# the BMP letters Greek λ/Λ and the Latin lambda-with-stroke ƛ, plus the
# supplementary-plane Mathematical-Alphanumeric lambda variants (all five styles,
# small and capital; the lexer spans 4-byte identifier runes). MUST stay in lockstep
# with stage0's isLambdaKeyword (compiler/src/parser). The removed `lambda` spelling
# is not accepted (rejected like stage0).
# Query-expression keywords (`KW VAR in ITER [where COND]`): quantifiers (any/all),
# value folds (first/count/sum/product/min/max), and side-effect iteration (each).
# MUST stay in lockstep with stage0's looksLikeQueryExpr keyword set.
def is_query_keyword(text: sview) -> bool:
    return text == "any" or text == "all" or text == "first" or text == "count" or text == "each" or text == "sum" or text == "product" or text == "min" or text == "max"


def is_lambda_keyword(text: sview) -> bool:
    return text == "fn" or text == "λ" or text == "Λ" or text == "ƛ" or text == "𝛌" or text == "𝜆" or text == "𝝀" or text == "𝝺" or text == "𝞴" or text == "𝚲" or text == "𝛬" or text == "𝜦" or text == "𝝠" or text == "𝞚"
