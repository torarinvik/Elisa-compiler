# Postfix statement guards: one expression, or an indented list. `if:` joins the list
# by short-circuit or (the statement runs when any line holds); `if not:` joins it by
# short-circuit and and negates it (the statement runs unless every line holds).
extend Parser:
    private:
        # Whether the guard condition at the cursor is a list: `:` or `not :`.
        def guard_condition_list_ahead(parser: Parser&) -> bool:
            parser.peek() == TokenKind.Colon or (parser.peek() == TokenKind.Not and parser.peek_at(1) == TokenKind.Colon)

        def guard_condition(parser: lmut Parser) -> Ast::Expr?:
            can Memory.Allocate, Abort.Panic:
                if not parser.guard_condition_list_ahead():
                    rebind inline_condition: Ast::Expr?, parser = parser.expression() can Global{Read,Write}
                    return inline_condition
                negated: bool = parser.peek() == TokenKind.Not
                not_token: Token = parser.cursor()
                parser, _ <- parser.advance() if negated
                rebind colon: Token, parser = parser.advance()
                parser, _ <- parser.expect(TokenKind.Newline)
                parser <- parser.skip_newlines()
                rebind indented: bool, parser = parser.accept(TokenKind.Indent)
                if not indented:
                    parser <- parser.error_removed(colon, "guard condition list requires an indented, nonempty block of bool expressions")
                    return (Ast::Expr.Invalid)
                condition: mutable Ast::Expr? = null
                # A plain loop, not a `machine`: each entry folds into `condition`, which a
                # machine arm may not mutate (docs/123 §5 rule 3).
                while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser, condition|:
                    parser <- parser.skip_newlines()
                    break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof
                    before: usize = parser.position
                    entry_token: Token = parser.cursor()
                    rebind next_condition: Ast::Expr?, parser = parser.expression() can Global{Read,Write}
                    if next_condition is next:
                        if condition is previous:
                            join: TokenKind = TokenKind.And if negated else TokenKind.Or
                            condition <- (Ast::Expr.Binary(previous, join, next, Ast::pos_of_token(entry_token)))
                        else:
                            condition <- next
                    parser, _ <- parser.expect(TokenKind.Newline) if not parser.prev_is_dedent()
                    parser, _ <- parser.advance() if parser.position == before
                parser, _ <- parser.expect(TokenKind.Dedent)
                parser <- parser.error_removed(colon, "guard condition list must contain at least one bool expression") if condition == null
                joined: Ast::Expr = get condition else (Ast::Expr.Invalid)
                return joined if not negated or condition == null
                return (Ast::Expr.Unary(TokenKind.Not, (Ast::Expr.Paren(joined, Ast::expr_pos(joined))), Ast::pos_of_token(not_token)))
