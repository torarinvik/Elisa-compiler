# Postfix statement guards: one expression, or an indented list joined by short-circuit or.
extend Parser:
    private:
        def guard_condition(parser: lmut Parser) -> Ast::Expr?:
            can Memory.Allocate, Abort.Panic:
                if parser.peek() != TokenKind.Colon:
                    rebind inline_condition: Ast::Expr?, parser = parser.expression() can Global{Read,Write}
                    return inline_condition
                rebind colon: Token, parser = parser.advance()
                parser, _ <- parser.expect(TokenKind.Newline)
                parser <- parser.skip_newlines()
                rebind indented: bool, parser = parser.accept(TokenKind.Indent)
                if not indented:
                    parser <- parser.error_removed(colon, "guard condition list requires an indented, nonempty block of bool expressions")
                    return null
                condition: mutable Ast::Expr? = null
                machine over parser.position while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof:
                    state Next
                    start Next

                    Next, _:
                        parser <- parser.skip_newlines()
                        break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof
                        before: usize = parser.position
                        rebind next_condition: Ast::Expr?, parser = parser.expression() can Global{Read,Write}
                        if next_condition is next:
                            if condition is previous:
                                condition <- (Ast::Expr.Binary(previous, TokenKind.Or, next, Ast::pos_of_token(colon)))
                            else:
                                condition <- next
                        parser, _ <- parser.expect(TokenKind.Newline) if not parser.prev_is_dedent()
                        parser, _ <- parser.advance() if parser.position == before
                        -> Next
                parser, _ <- parser.expect(TokenKind.Dedent)
                parser <- parser.error_removed(colon, "guard condition list must contain at least one bool expression") if condition == null
                return condition
