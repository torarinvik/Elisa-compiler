# Stage1 parser — the copy-update struct literal `Type{..base, field: value}`.
# Part of `module Parser` (see parser.elisa).
#
# The literal is expanded HERE, inside Parser::parse_file, into an ordinary full
# `Expr.Construct`: the written fields in written order, then one
# `field: base.field` entry (an `Expr.Field` over the base, the shape the parser builds
# for a hand-written `base.field`) for every declared field that was not written. Field
# defaults never apply when a base is present, because every field is now written.
# Semantic analysis, the backend, and tools that only parse (elisa-proof) therefore see
# exactly the literal a user would have written by hand.
#
# `base` must be an identifier or a field path `a.b.c`, so reading it once per field is
# the same as evaluating it once. The base itself is recorded in File.struct_copy_bases so
# semantic can check that it has the literal's struct type (check_struct_copy_base.elisa).
#
# The struct's field list may come from a declaration later in the file, so a file whose
# tokens hold `{ ..` is parsed twice (parse_file): the first parse collects the complete
# struct table and leaves each literal unexpanded (the base as a FieldInit with
# `is_copy_base`), the second parse is seeded with that table and expands. `-emit fmt`
# keeps the unexpanded first parse, so it can print what was written.

extend Parser:
    private:

        # Whether any `{` is directly followed by `..` — the only token shape that opens a
        # copy-update literal. Decides whether parse_file needs its seeded second parse.
        def tokens_hold_struct_copy_base(tokens: darray[Token]) -> bool:
            can Abort.Panic:
                for index in 1..<tokens.count |tokens|:
                    true return if tokens[index].kind == TokenKind.Range and tokens[index - 1].kind == TokenKind.LBrace
                return false

        # An identifier or a plain field path `a.b.c`: the only accepted copy sources.
        def struct_copy_base_is_path(expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Expr.Ident(_, _):
                        return true
                    Expr.Field(object, _, _):
                        return struct_copy_base_is_path(object)
                    _:
                        return false

        # The bare struct name a literal's type expression names: `T`, `M::T`, `T[A]`.
        def struct_copy_base_type_head(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match type_expression:
                    Expr.Ident(name, _):
                        return name
                    Expr.Scope(_, name, _):
                        return name
                    Expr.Index(object, _, _):
                        return struct_copy_base_type_head(object)
                    Expr.IndexN(object, _, _):
                        return struct_copy_base_type_head(object)
                    _:
                        return ""

        # The innermost module a qualified type expression names (`M` in `A::M::T`), "" for
        # an unqualified one. Struct owners are recorded as the innermost module name too.
        def struct_copy_base_type_owner(type_expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match type_expression:
                    Expr.Scope(base, _, _):
                        return struct_copy_base_type_head(base)
                    Expr.Index(object, _, _):
                        return struct_copy_base_type_owner(object)
                    Expr.IndexN(object, _, _):
                        return struct_copy_base_type_owner(object)
                    _:
                        return ""

        # Row of the literal's struct in the seeded struct table, -1 when it is not
        # declared. A qualified name must match its module. An unqualified one prefers the
        # struct of the module being parsed, then a unique declaration, then a top-level one.
        def struct_copy_base_row(parser: Parser&, type_expression: Ast::Expr) -> i64:
            can Abort.Panic:
                name: sview = struct_copy_base_type_head(type_expression)
                owner: sview = struct_copy_base_type_owner(type_expression)
                -1 return if name == ""
                names: darray[sview] = parser.copy_base_seed_names
                owners: darray[sview] = parser.copy_base_seed_owners
                current: sview = parser.current_module
                available: usize = names.count if names.count < owners.count else owners.count
                matches: mutable usize = 0
                last_match: mutable i64 = -1
                top_level: mutable i64 = -1
                for index in 0..<available |names, owners, name, owner, current, matches, last_match, top_level|:
                    continue if names[index] != name
                    if owner != "":
                        index.i64() return if owners[index] == owner
                        continue
                    index.i64() return if owners[index] == current
                    matches <- matches + 1
                    last_match <- index.i64()
                    top_level <- index.i64() if owners[index] == ""
                last_match return if matches == 1
                return top_level

        # Expand a copy-update literal's fields (the base is entry 0, `is_copy_base`). Before
        # the seeded parse the fields are returned unchanged.
        def expand_struct_copy_base(parser: lmut Parser, type_expression: Ast::Expr, fields: darray[Ast::FieldInit], token: Token) -> darray[Ast::FieldInit]:
            can Memory.Allocate, Abort.Panic:
                fields return if not parser.copy_base_seed_active
                row: i64 = struct_copy_base_row(parser, type_expression)
                if row < 0 or row.usize() >= parser.copy_base_seed_starts.count or row.usize() >= parser.copy_base_seed_counts.count:
                    parser <- parser.error_removed(token, "struct literal copy source `..base` needs the struct's declaration, and none was found for this literal's type")
                    return fields
                base: Ast::Expr = fields[0].value
                base_pos: Ast::Pos = Ast::expr_pos(base)
                # Recorded before the field names are read: they are views of the parser's seed
                # table, and growing a parser store afterwards would invalidate them.
                parser.struct_copy_bases <- parser.struct_copy_bases.push(Ast::StructCopyBase{type_expression: type_expression, base: base, pos: Ast::pos_of_token(token)})
                expanded: mutable darray[Ast::FieldInit] = []
                for written_index in 1..<fields.count |expanded, fields|:
                    expanded.push(fields[written_index])
                rows: darray[Ast::StructMember] = parser.copy_base_seed_rows
                member_start: usize = parser.copy_base_seed_starts[row.usize()]
                member_end: usize = member_start + parser.copy_base_seed_counts[row.usize()]
                for member_index in member_start..<member_end |expanded, fields, rows, base, base_pos|:
                    continue if member_index >= rows.count
                    member_name: sview = rows[member_index].name
                    written: mutable bool = false
                    for probe in 1..<fields.count |written, fields, member_name|:
                        written <- true if fields[probe].name == member_name
                    expanded.push(Ast::FieldInit{name: member_name, value: (Ast::Expr.Field(base, member_name, base_pos))}) if not written
                return expanded
