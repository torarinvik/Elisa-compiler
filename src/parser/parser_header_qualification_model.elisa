# Pure predicates used by contextual parser keyword disambiguation.
module ParserHeaderQualification:
    public:
        def has_token(position: usize, token_count: usize) -> bool:
            ensure result == (position < token_count)
            return position < token_count

        def offset_is_in_range(position: usize, token_count: usize, offset: usize) -> bool:
            requires position < token_count
            ensure result == (offset < token_count - position)
            return offset < token_count - position

        def qualified_by_neighbors(offset: usize, following_is_scope: bool, previous_is_scope: bool, previous_token_is_scope: bool) -> bool:
            ensure result == (following_is_scope or (offset > 0 and previous_is_scope) or (offset == 0 and previous_token_is_scope))
            return following_is_scope or (offset > 0 and previous_is_scope) or (offset == 0 and previous_token_is_scope)
