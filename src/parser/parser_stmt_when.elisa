extend Parser:
    private:
        # docs/125 §4 R1 (stage1-OWNED, docs/125 step 13): the comparable value a single
        # `when` column atom reduces to, for disjointness testing. `Opaque` is an atom the
        # parser could not evaluate — overlap involving it is NEVER reported (a missed
        # overlap is a sound miss; a wrong overlap report would be a false positive, which
        # is worse). Stage1's Pattern.Literal erases the token kind (the lexer stores a
        # string/char literal's CONTENT, quotes stripped — so `"a"`, `'a'`, and a bare
        # `a` are byte-identical), so this port is deliberately narrower than stage0's
        # kinded whenAtom: a `Lit` carries its RAW text (compared by byte-equality — two
        # arms with identical literal text always denote the same value, whatever the
        # scrutinee type) plus a `numeric` value that is CONSUMED ONLY against a `Range`.
        # That is sound because a `Range` can only appear in a numeric-scrutinee column
        # (you cannot range over strings), so a sibling `Lit`'s integer reading is correct
        # exactly where it is used. Cross-spelling misses (`1` vs `01`, char ranges) are
        # sound misses.
        const enum WhenAtomKind of u8:
            Wild
            Lit
            Tag
            Range
            Opaque

        # One classified column option. For `Lit`: `text` is the raw span (byte-equality),
        # `numeric` says whether `text` is a pure integer literal, and `ival`==`hi` is its
        # value when numeric. For `Range`: `ival`..`hi` is the inclusive numeric interval.
        # For `Tag`: `text` is the dotted variant path (compared on its final segment).
        struct WhenAtom:
            text: sview
            ival: i64
            hi: i64
            kind: WhenAtomKind
            numeric: bool


extend Parser:
    private:
        # docs/125 §4 — `when`: an order-independent decision table. Port of stage0's
        # parser desugar (compiler/src/parser/when.go). Like `machine` (docs/123) it is a
        # contextual keyword lowered ENTIRELY in the parser, onto the existing Match node,
        # so every downstream pass (resolve, the check_* diagnostics, semantic) reuses its
        # `match` handling unchanged.
        #
        # Stage1 deltas from stage0 (frontend-only; the `when` source is already
        # stage0-validated when it reaches this parser):
        #   - the R1/R2/R3 refusal diagnostics (disjointness, totality, restricted arm
        #     grammar) are NOT re-emitted — stage0 owns them; the stage1 parse is purely
        #     structural (mirrors the machine port).
        #   - arm bodies desugar to Match arms exactly as stage0 does.
        #
        # Grammar (arms differ from `match` top-level arms: `|` binds WITHIN a column and
        # `,` separates columns, so `"u8" | "u16", true` is ONE two-column row):
        #
        #   when SCRUT[, SCRUT]*:
        #       PAT[|PAT]*[, PAT[|PAT]*]* -> VALUE-or-BLOCK
        #       _ -> VALUE-or-BLOCK

        # `when` is a contextual keyword: the construct is recognized only when the next
        # token can begin a scrutinee in a position a `when` variable could not continue
        # (an identifier, a literal, or a unary minus). Postfix/operator continuations
        # (`when(x)`, `when[i]`, `when.f`, `when <- v`, `when = e`) keep the identifier
        # meaning — this mirrors stage0's gate exactly.
        def when_construct_ahead(parser: Parser&) -> bool:
            next_kind: TokenKind = parser.peek_at(1)
            return when next_kind:
                TokenKind.Ident | TokenKind.IntLit | TokenKind.HexLit | TokenKind.FloatLit | TokenKind.CharLit | TokenKind.StringLit | TokenKind.True | TokenKind.False | TokenKind.Minus -> true
                _ -> false

        # Parse the comma-separated scrutinee list (mirrors match_statement's head). A
        # single scrutinee stays scalar; two or more form a tuple the arm columns match.
        def parse_when_head(parser: lmut Parser) -> Ast::Expr:
            when_token: Token = parser.cursor()
            parser.when_scrutinee_columns <- 1
            rebind first_option: Ast::Expr?, parser = parser.expression()
            first: Ast::Expr = get first_option else (Ast::Expr.Invalid)
            first return if parser.peek() != TokenKind.Comma

            scrutinees: mutable darray[Ast::Expr] = [first]
            while parser.accept(TokenKind.Comma) |parser|:
                rebind more_option: Ast::Expr?, parser = parser.expression()
                if more_option is more:
                    scrutinees.push(more)
            parser.when_scrutinee_columns <- scrutinees.count
            return (Ast::Expr.Tuple(scrutinees, Ast::pos_of_token(when_token)))

        def when_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind when_token: Token, parser = parser.advance()      # `when`
            rebind scrutinee: Ast::Expr, parser = parser.parse_when_head()
            expected_columns: usize = parser.when_scrutinee_columns
            rebind arms: darray[Ast::MatchArm], parser = parser.parse_when_arms(expected_columns)
            return (Ast::Stmt.Match(scrutinee, arms, Ast::pos_of_token(when_token)))

        def when_expression(parser: lmut Parser) -> Ast::Expr?:
            rebind when_token: Token, parser = parser.advance()      # `when`
            rebind scrutinee: Ast::Expr, parser = parser.parse_when_head()
            expected_columns: usize = parser.when_scrutinee_columns
            rebind arms: darray[Ast::MatchArm], parser = parser.parse_when_arms(expected_columns)
            return (Ast::Expr.Match(scrutinee, arms, Ast::pos_of_token(when_token)))

        # `: NEWLINE INDENT (ROW)* DEDENT`, each ROW a `PATTERN-COLUMNS -> BODY` arm.
        # The `_` default row is emitted LAST (order-independence: a mid-table default
        # must not shadow later arms under match's first-wins), matching stage0.
        def parse_when_arms(parser: lmut Parser, expected_columns: usize) -> darray[Ast::MatchArm]:
            parser, _ <- parser.expect(TokenKind.Colon)
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)

            arms: mutable darray[Ast::MatchArm] = []
            defaults: mutable darray[Ast::MatchArm] = []
            # docs/125 §4 R1: every row's pattern + head token, in source order, for the
            # stage1-owned disjointness check once the whole table is parsed.
            check_patterns: mutable darray[Ast::Pattern] = []
            check_tokens: mutable darray[Token] = []
            while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser, arms, defaults, check_patterns, check_tokens|:
                parser <- parser.skip_newlines()
                break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof

                row_head: Token = parser.cursor()
                rebind arm: Ast::MatchArm, parser = parser.parse_when_row()
                check_patterns.push(arm.pattern)
                check_tokens.push(row_head)
                # A MULTI-COLUMN default is `_, _`, which is a Tuple of wildcards — not a bare
                # `Pattern.Wildcard`. Testing only for the bare form left a mid-table `_, _`
                # row in place instead of moving it last, so the later specific rows became
                # unreachable under match's first-wins order and the table stopped being
                # order-independent: `0,0 -> 11 / _,_ -> 44 / 1,1 -> 33` answered 44 where
                # stage0 answers 33. A silent wrong answer, and one no fixture had.
                is_default: bool = when_pattern_full_wild(arm.pattern)
                actual_columns: usize = when_pattern_column_count(arm.pattern)
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, row_head) if not is_default and actual_columns != expected_columns
                defaults.push(arm) if is_default
                # Stage0 fans a single-column `A | B` row out into sibling match
                # arms.  Multi-column rows retain the per-column Or because the
                # tuple is one decision-table row.
                if not is_default:
                    match arm.pattern:
                        Ast::Pattern.Or(options):
                            arms.extend([Ast::MatchArm{pattern: option, body: arm.body, guard: arm.guard} for option in options])
                        _:
                            arms.push(arm)
            parser, _ <- parser.expect(TokenKind.Dedent)

            parser <- parser.check_when_disjoint(check_patterns, check_tokens)

            arms.extend(defaults)
            return arms

        # One `PATTERN-COLUMNS -> BODY` row. Columns are `PAT (| PAT)*`, separated by
        # `,`; a single wildcard column is the total-default row (Pattern.Wildcard).
        def parse_when_row(parser: lmut Parser) -> Ast::MatchArm:
            row_token: Token = parser.cursor()

            columns: mutable darray[darray[Ast::Pattern]] = []
            while true |parser, columns|:
                option_token: Token = parser.cursor()
                rebind first_option: Ast::Pattern, parser = parser.parse_pattern_primary()
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, option_token) if when_atom_pattern_illegal(first_option)
                column: mutable darray[Ast::Pattern] = [first_option]
                while parser.accept(TokenKind.Pipe) |parser, column|:
                    alt_token: Token = parser.cursor()
                    alt_option: Ast::Pattern = parser.parse_pattern_primary()
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, alt_token) if when_atom_pattern_illegal(alt_option)
                    column.push(alt_option)
                columns.push(column)
                break if not parser.accept(TokenKind.Comma)

            parser <- parser.skip_when_invalid_guard()

            pattern: Ast::Pattern = when_columns_pattern(columns)

            # If the row head didn't land on the arrow (an exotic/malformed pattern),
            # drop the rest of the line losslessly so the arm loop never spins.
            malformed: bool = parser.peek() != TokenKind.Arrow
            parser <- parser.skip_when_malformed_row() if malformed
            empty_body: darray[Ast::Stmt] = []
            Ast::MatchArm{pattern: pattern, body: empty_body, guard: (Ast::Expr.Absent)} return if malformed

            parser, _ <- parser.advance()                           # `->`
            rebind body: darray[Ast::Stmt], parser = parser.parse_when_body(row_token.line)
            return Ast::MatchArm{pattern: pattern, body: body, guard: (Ast::Expr.Absent)}

        # A guard (`PAT if COND ->`) is not part of `when` (R3: arm forms are restricted so
        # disjointness stays decidable at parse time — a computed guard needs `match`).
        # Stage1 now OWNS the refusal (docs/125 step 13); consume the guard for recovery.
        def skip_when_invalid_guard(parser: lmut Parser) -> void:
            return if parser.peek() != TokenKind.If
            if_token: Token = parser.cursor()
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, if_token)
            parser, _ <- parser.advance()
            parser, _ <- parser.expression()

        # Lossless drop of a malformed row's tail up to the line boundary.
        def skip_when_malformed_row(parser: lmut Parser) -> void:
            while parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser|:
                parser, _ <- parser.advance()

        # The arm value after `->`: an indented statement block, or an inline expression
        # (a top-level comma builds a tuple value, mirroring a match-expression arm).
        def parse_when_body(parser: lmut Parser, line: u32) -> darray[Ast::Stmt]:
            is_block_form: bool = parser.peek() == TokenKind.Newline
            # Each forwarded body is re-materialized locally: a callee's darray returned
            # straight out of this frame dies with this frame's auto region (parse_block).
            rebind block_body: darray[Ast::Stmt], parser = parser.parse_when_block_body(is_block_form)
            adopted_block: darray[Ast::Stmt] = [statement for statement in block_body]
            adopted_block return if is_block_form

            rebind value_option: Ast::Expr?, parser = parser.expression()
            value: Ast::Expr = get value_option else (Ast::Expr.Invalid)
            is_tuple_form: bool = parser.peek() == TokenKind.Comma
            rebind tuple_body: darray[Ast::Stmt], parser = parser.parse_when_inline_tuple(value, line, is_tuple_form)
            adopted_tuple: darray[Ast::Stmt] = [statement for statement in tuple_body]
            adopted_tuple return if is_tuple_form
            parser, _ <- parser.accept(TokenKind.Newline)
            inline_body: darray[Ast::Stmt] = [(Ast::Stmt.Expr(value, Ast::pos_at_line(line)))]
            return inline_body

        # An indented `-> NEWLINE INDENT stmt* DEDENT` arm body block.
        def parse_when_block_body(parser: lmut Parser, cond: bool) -> darray[Ast::Stmt]:
            empty_body: darray[Ast::Stmt] = []
            empty_body return if not cond
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)
            block: mutable darray[Ast::Stmt] = []
            while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser, block|:
                parser <- parser.skip_newlines()
                break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof
                rebind statement_option: Ast::Stmt?, parser = parser.statement()
                if statement_option is body_statement:
                    block.push(body_statement)
                    parser <- parser.skip_trailing_can(true)
                    parser, _ <- parser.accept(TokenKind.Newline)
                else:
                    parser, _ <- parser.advance()                   # error recovery: never spin
            parser, _ <- parser.expect(TokenKind.Dedent)
            return block

        # An inline `VALUE, VALUE, …` arm body: a top-level comma builds a tuple value.
        def parse_when_inline_tuple(parser: lmut Parser, first_value: Ast::Expr, line: u32, cond: bool) -> darray[Ast::Stmt]:
            empty_body: darray[Ast::Stmt] = []
            empty_body return if not cond
            elements: mutable darray[Ast::Expr] = [first_value]
            while parser.accept(TokenKind.Comma) |parser, elements|:
                rebind element_option: Ast::Expr?, parser = parser.expression()
                if element_option is element:
                    elements.push(element)
            inline_tuple_body: darray[Ast::Stmt] = [(Ast::Stmt.Expr((Ast::Expr.Tuple(elements, Ast::pos_at_line(line))), Ast::pos_at_line(line)))]
            return inline_tuple_body

        # Build the arm pattern from the parsed columns. A single column collapses to its
        # sole pattern (or an Or of its options); multiple columns form a Tuple whose
        # elements are per-column patterns (each itself an Or when it has options).
        def when_columns_pattern(columns: darray[darray[Ast::Pattern]]) -> Ast::Pattern:
            when_column_pattern(columns[0]) return if columns.count == 1
            elements: mutable darray[Ast::Pattern] = []
            elements.extend([when_column_pattern(column) for column in columns])
            return (Ast::Pattern.Tuple(elements))

        def when_column_pattern(options: darray[Ast::Pattern]) -> Ast::Pattern:
            options[0] return if options.count == 1
            return (Ast::Pattern.Or(options))

        # docs/125 §4 R3, stage1-OWNED (docs/125 step 13): a `when` column atom is
        # restricted to the forms whose disjointness is DECIDABLE at parse time — a
        # literal, a range, a payload-less enum tag, `_`, or an or-group of those. A
        # binding, a struct/tuple destructure, a payload-carrying variant, a `T binder`
        # type-bind, or an `as` capture is REFUSED (`match` owns those). Mirrors stage0's
        # classifyWhenAtom (parser/when.go); a returned `true` marks the atom illegal.
        def when_atom_pattern_illegal(pattern: Ast::Pattern) -> bool:
            return match pattern:
                Ast::Pattern.Wildcard: false
                Ast::Pattern.Literal(text): false
                Ast::Pattern.Range(lo, hi, inclusive): false
                # A payload-less enum tag is legal; destructuring its fields is not.
                Ast::Pattern.Variant(path, fields): fields.count > 0
                # An or-group is legal iff every option is a legal atom.
                Ast::Pattern.Or(options):
                    any option in options where when_atom_pattern_illegal(option)
                # Bindings, destructures, type-binds, and as-captures all need `match`.
                Ast::Pattern.Binding(name): true
                Ast::Pattern.Pin(name): true
                Ast::Pattern.Struct(path, fields): true
                Ast::Pattern.Field(selector, inner): true
                Ast::Pattern.Tuple(elements): true
                Ast::Pattern.Rest(name): true
                Ast::Pattern.TypeBind(type, binder): true
                Ast::Pattern.As(name, inner): true
                Ast::Pattern.Other(text): true

        # ============================================================
        # docs/125 §4 R1 (stage1-OWNED, docs/125 step 13): disjointness.
        # Choosing `when` over `match` DECLARES the arms order-independent; the parser
        # enforces it — every pair of non-default rows must be PROVABLY disjoint (some
        # column non-overlapping), and a second `_` default row is itself an overlap.
        # An atom the parser cannot evaluate stays Opaque and NEVER reports an overlap
        # (a missed overlap is a sound miss; a wrong report is a false positive). Mirrors
        # stage0's checkWhenDisjoint / whenAtomsOverlap (parser/when.go).
        # ============================================================

        # Byte-equality of two source spans (Str / Float raw-text comparison).
        def when_text_equal(a: sview, b: sview) -> bool:
            la: usize = sview_len(a)
            lb: usize = sview_len(b)
            false return if la != lb
            i: mutable usize = 0
            while i < la |i|:
                false return if sview_at(a, i) != sview_at(b, i)
                i <- i + 1
            return true

        # Index just past the last `.`/`:` path separator — the final tag segment start.
        # Both `.Red` and `Color.Red` normalize to `Red`, matching stage0's tag render.
        def when_tail_start(text: sview) -> usize:
            n: usize = sview_len(text)
            start: mutable usize = 0
            i: mutable usize = 0
            while i < n |start, i|:
                separator: bool = sview_at(text, i) == 46 or sview_at(text, i) == 58
                start <- i + 1 if separator
                i <- i + 1
            return start

        # Tag equality on final path segments (a single `when`'s tags share one enum, so
        # equal final segments mean the same variant).
        def when_tag_equal(a: sview, b: sview) -> bool:
            start_a: usize = when_tail_start(a)
            start_b: usize = when_tail_start(b)
            len_a: usize = sview_len(a) - start_a
            len_b: usize = sview_len(b) - start_b
            false return if len_a != len_b
            i: mutable usize = 0
            while i < len_a |i|:
                false return if sview_at(a, start_a + i) != sview_at(b, start_b + i)
                i <- i + 1
            return true

        # Whether a raw literal span is a pure integer literal (decimal digits, or a
        # `0x`/`0X` hex body), allowing `_` digit separators. Only such a span gets a
        # numeric reading — and that reading is used solely against a `Range` (see the
        # WhenAtomKind comment for why that is sound).
        def when_is_integer_text(text: sview) -> bool:
            n: usize = sview_len(text)
            false return if n == 0
            is_hex: bool = n >= 2 and sview_at(text, 0) == 48 and (sview_at(text, 1) == 120 or sview_at(text, 1) == 88)
            false return if is_hex and n == 2                      # bare `0x`, no digits
            start: usize = 2 if is_hex else 0
            saw_digit: mutable bool = false
            i: mutable usize = start
            while i < n |saw_digit, i|:
                b: u8 = sview_at(text, i)
                is_decimal: bool = b >= 48 and b <= 57
                is_hex_digit: bool = is_hex and ((b >= 97 and b <= 102) or (b >= 65 and b <= 70))
                is_separator: bool = b == 95
                false return if not (is_decimal or is_hex_digit or is_separator)
                saw_digit <- true if is_decimal or is_hex_digit
                i <- i + 1
            return saw_digit

        # Reduce a literal-pattern span to a `Lit` atom: raw text for byte-equality, plus a
        # numeric value when the text is a pure integer literal.
        def classify_when_literal(text: sview) -> WhenAtom:
            WhenAtom{kind: WhenAtomKind.Opaque, ival: 0, hi: 0, numeric: false, text: text} return if sview_len(text) == 0
            numeric: bool = when_is_integer_text(text)
            value: i64 = parse_int_literal_value(text) if numeric else 0
            return WhenAtom{kind: WhenAtomKind.Lit, ival: value, hi: value, numeric: numeric, text: text}

        # Reduce a range pattern to a numeric interval [lo, hi] (inclusive). A range can
        # only appear in a numeric-scrutinee column, so integer bounds are the norm; a
        # non-integer bound (e.g. a char range) leaves the range Opaque — a sound miss.
        def classify_when_range(lo: sview, hi: sview, inclusive: bool) -> WhenAtom:
            opaque: WhenAtom = WhenAtom{kind: WhenAtomKind.Opaque, ival: 0, hi: 0, numeric: false, text: Lexer::empty_sview()}
            opaque return if not (when_is_integer_text(lo) and when_is_integer_text(hi))
            lo_value: i64 = parse_int_literal_value(lo)
            hi_raw: i64 = parse_int_literal_value(hi)
            hi_value: i64 = hi_raw if inclusive else hi_raw - 1
            return WhenAtom{kind: WhenAtomKind.Range, ival: lo_value, hi: hi_value, numeric: true, text: Lexer::empty_sview()}

        def classify_when_atom(pattern: Ast::Pattern) -> WhenAtom:
            return match pattern:
                Ast::Pattern.Wildcard:
                    WhenAtom{kind: WhenAtomKind.Wild, ival: 0, hi: 0, numeric: false, text: Lexer::empty_sview()}
                Ast::Pattern.Literal(text):
                    classify_when_literal(text)
                Ast::Pattern.Range(lo, hi, inclusive):
                    classify_when_range(lo, hi, inclusive)
                Ast::Pattern.Variant(path, fields):
                    WhenAtom{kind: WhenAtomKind.Tag, ival: 0, hi: 0, numeric: false, text: path} if fields.count == 0 else WhenAtom{kind: WhenAtomKind.Opaque, ival: 0, hi: 0, numeric: false, text: path}
                _:
                    WhenAtom{kind: WhenAtomKind.Opaque, ival: 0, hi: 0, numeric: false, text: Lexer::empty_sview()}

        # A row's column count, read structurally with no allocation (a Tuple for multi-
        # column rows, Wildcard for the default, a lone atom/Or for single-column).
        def when_pattern_column_count(pattern: Ast::Pattern) -> usize:
            return match pattern:
                Ast::Pattern.Wildcard: 0
                Ast::Pattern.Tuple(elements): elements.count
                _: 1

        # The i-th column pattern (itself an Or or atom). Region-neutral: returns a stored
        # handle, never a fresh container.
        def when_pattern_column(pattern: Ast::Pattern, index: usize) -> Ast::Pattern:
            return match pattern:
                Ast::Pattern.Tuple(elements): elements[index]
                _: pattern

        def when_is_wildcard(pattern: Ast::Pattern) -> bool:
            return match pattern:
                Ast::Pattern.Wildcard: true
                _: false

        # A full-row default: a bare `_`, or a multi-column row of only wildcards.
        def when_pattern_full_wild(pattern: Ast::Pattern) -> bool:
            return match pattern:
                Ast::Pattern.Wildcard: true
                Ast::Pattern.Tuple(elements):
                    elements.count > 0 and not (any element in elements where not when_is_wildcard(element))
                _: false

        def when_atom_overlap(a: WhenAtom, b: WhenAtom) -> bool:
            false return if a.kind == WhenAtomKind.Opaque or b.kind == WhenAtomKind.Opaque
            true return if a.kind == WhenAtomKind.Wild or b.kind == WhenAtomKind.Wild
            # A range compares on the numeric interval; the other side must supply one (a
            # range, or a `Lit` with an integer reading). `Lit` stores ival == hi, so the
            # same interval-overlap test serves a point value too.
            if a.kind == WhenAtomKind.Range or b.kind == WhenAtomKind.Range:
                a_interval: bool = a.kind == WhenAtomKind.Range or (a.kind == WhenAtomKind.Lit and a.numeric)
                b_interval: bool = b.kind == WhenAtomKind.Range or (b.kind == WhenAtomKind.Lit and b.numeric)
                return a_interval and b_interval and a.ival <= b.hi and b.ival <= a.hi
            # Two literals overlap iff their raw texts are byte-equal (identical literal
            # text denotes the same value for any single scrutinee type).
            when_text_equal(a.text, b.text) return if a.kind == WhenAtomKind.Lit and b.kind == WhenAtomKind.Lit
            when_tag_equal(a.text, b.text) return if a.kind == WhenAtomKind.Tag and b.kind == WhenAtomKind.Tag
            return false

        # Two columns overlap if some option of one overlaps some option of the other.
        # An `A | B` column fans out recursively over the stored options darray (no fresh
        # allocation, so the check stays region-neutral).
        def when_columns_overlap(a: Ast::Pattern, b: Ast::Pattern) -> bool:
            return match a:
                Ast::Pattern.Or(a_options):
                    any a_option in a_options where when_columns_overlap(a_option, b)
                _:
                    when_column_atom_overlap(a, b)

        def when_column_atom_overlap(a: Ast::Pattern, b: Ast::Pattern) -> bool:
            return match b:
                Ast::Pattern.Or(b_options):
                    any b_option in b_options where when_column_atom_overlap(a, b_option)
                _:
                    when_atom_overlap(classify_when_atom(a), classify_when_atom(b))

        # Two non-default rows overlap iff EVERY column overlaps.
        def when_patterns_overlap(a: Ast::Pattern, b: Ast::Pattern) -> bool:
            count_a: usize = when_pattern_column_count(a)
            count_b: usize = when_pattern_column_count(b)
            false return if count_a != count_b
            false return if count_a == 0
            i: mutable usize = 0
            while i < count_a |i|:
                false return if not when_columns_overlap(when_pattern_column(a, i), when_pattern_column(b, i))
                i <- i + 1
            return true

        # Report R1: a duplicate `_` default row, and any pair of overlapping non-default
        # rows. Errors anchor at the offending (later) row's head token.
        def check_when_disjoint(parser: lmut Parser, patterns: darray[Ast::Pattern], tokens: darray[Token]) -> void:
            default_seen: mutable bool = false
            i: mutable usize = 0
            while i < patterns.count |parser, default_seen, i|:
                if when_pattern_full_wild(patterns[i]):
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, tokens[i]) if default_seen
                    default_seen <- true
                i <- i + 1
            a: mutable usize = 0
            while a < patterns.count |parser, a|:
                if not when_pattern_full_wild(patterns[a]):
                    b: mutable usize = a + 1
                    while b < patterns.count |parser, b|:
                        overlaps: bool = not when_pattern_full_wild(patterns[b]) and when_patterns_overlap(patterns[a], patterns[b])
                        parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, tokens[b]) if overlaps
                        b <- b + 1
                a <- a + 1
