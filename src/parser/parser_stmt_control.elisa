extend Parser:
    private:
        # Distinguish the `guard COND else …` statement from a local named `guard`
        # (`guard: T = …`, `guard.field <- …`). Scan the rest of the line, tracking
        # bracket depth; it is a guard statement iff a top-level `else` appears before
        # the line ends (mirrors stage0 looksLikeGuardStmt).
        def looks_like_guard_statement(parser: Parser&) -> bool:
            while true |depth: int = 0, scan_index: usize = 1|:
                kind: TokenKind = parser.peek_at(scan_index)
                false return if kind == TokenKind.Eof or kind == TokenKind.Newline
                match kind:
                    TokenKind.LParen | TokenKind.LBracket:
                        depth <- depth + 1
                    TokenKind.RParen | TokenKind.RBracket:
                        depth <- depth - 1 if depth > 0
                    TokenKind.Else:
                        true return if depth == 0
                    _:
                        pass
                scan_index <- scan_index + 1
            return false


        # `guard COND else STMT` / `guard COND else: BLOCK` — an early-exit guard whose
        # else-branch runs when COND is false. Desugared to `if not COND: <else>` so the
        # condition and the else body both resolve like any other if. (Contextual
        # keyword — the lexer emits `guard` as an identifier.)
        def guard_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind guard_token: Token, parser = parser.advance()              # `guard`
            rebind condition: Ast::Expr, parser = get parser.expression()
            parser, _ <- parser.expect(TokenKind.Else)
            negated_condition: Ast::Expr = (Ast::Expr.Unary(TokenKind.Not, condition, guard_token.line))
            then_body: mutable darray[Ast::Stmt] = []
            match parser.peek():
                TokenKind.Colon:
                    then_body, parser <- parser.parse_block()
                _:
                    rebind __es: Ast::Stmt?, parser = parser.statement()
                    if __es is else_statement:
                        then_body.push(else_statement)
            no_else: darray[Ast::Stmt] = []
            return (Ast::Stmt.If(negated_condition, then_body, no_else, guard_token.line))


        # Parse the value RHS of a `name: T = …` binding when an `=` was accepted: a bare
        # block-value (docs/119 §2) or a plain expression (absent → Invalid). No `=` → Invalid,
        # parser untouched. Extracted so the caller threads it as one assignment rather than a
        # block `if` wrapping the block-vs-expression decision.
        def parse_binding_value(parser: lmut Parser, accepted_assign: bool) -> Ast::Expr:
            (Ast::Expr.Invalid) return if not accepted_assign
            if parser.block_value_rhs_ahead():
                rebind block_value: Ast::Expr, parser = parser.parse_block_value_rhs()
                return block_value
            rebind parsed_value_option: Ast::Expr?, parser = parser.expression()
            return (get parsed_value_option else (Ast::Expr.Invalid))


        def variable_declaration_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            parser, _ <- parser.expect(TokenKind.Colon)
            parser <- parser.reject_positional_tuple_type_ahead()
            rebind parsed_type_expression: Ast::Expr?, parser = parser.expression()
            type_expression: mutable Ast::Expr = get parsed_type_expression
            rebind refined_type: Ast::Expr, parser = parser.parse_refinement_suffix(type_expression)
            type_expression <- refined_type

            # Optional `@region` binding annotation (`x: T @scratch = …`) pinning the
            # local to a named region. The region name is a region selector, not a value
            # reference, so it is consumed and discarded.
            rebind accepted_at: bool, parser = parser.accept(TokenKind.At)
            parser, _ <- parser.accept(TokenKind.Ident) if accepted_at

            # `value` is non-optional in the AST; an uninitialized binding records Invalid.
            value: mutable Ast::Expr = (Ast::Expr.Invalid)
            rebind accepted_assign: bool, parser = parser.accept(TokenKind.Assign)
            value, parser <- parser.parse_binding_value(accepted_assign)
            rebind __t_67: Ast::Expr, parser = parser.consume_removed_as_cast(value)
            value <- __t_67

            # Optional-binding recovery tail `NAME: T = EXPR else <statement>` (the desugared
            # `get`): if the RHS is empty, run the else statement (typically `return …`).
            # The else branch isn't modeled on VarDecl; parse it so the line is consumed.
            rebind accepted_else: bool, parser = parser.accept(TokenKind.Else)
            if accepted_else:
                match parser.peek():
                    TokenKind.Colon:
                        parser, _ <- parser.parse_block()
                    _:
                        parser, _ <- parser.statement()

            return (Ast::Stmt.VarDecl(Lexer::text_or_empty(name_token, parser.source), type_expression, value, name_token.line))


        # `rebind TARGET (, TARGET)* = <block/expression>` (docs/119 §5) threads a value block's
        # result back into outer mutables (bare targets) and fresh bindings (`name: T`).
        # For the frontend, resolution is what matters: every target name binds and the
        # RHS resolves, so the whole form desugars to a tuple assignment over the target
        # idents (a fresh target's `: T` annotation is parsed and dropped — the temp-move
        # threading and E8 discipline are stage0 codegen concerns, not name resolution).
        def rebind_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind keyword_token: Token, parser = parser.advance()   # consume `rebind`
            targets: mutable darray[Ast::Expr] = []
            while true |parser|:
                rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
                targets.push((Ast::Expr.Ident(Lexer::text_or_empty(name_token, parser.source), name_token.line)))
                # Optional `: T` marks a fresh binding; the type is a selector here.
                rebind accepted_colon: bool, parser = parser.accept(TokenKind.Colon)
                parser, _ <- parser.expression() if accepted_colon
                rebind accepted_comma: bool, parser = parser.accept(TokenKind.Comma)
                break if not accepted_comma
            parser, _ <- parser.expect(TokenKind.Assign)
            value: mutable Ast::Expr = (Ast::Expr.Invalid)
            if parser.block_value_rhs_ahead():
                value, parser <- parser.parse_block_value_rhs()
            else:
                rebind parsed_value_option: Ast::Expr?, parser = parser.expression()
                value <- parsed_value if parsed_value_option is parsed_value
            return (Ast::Stmt.Assign((Ast::Expr.Array(targets, keyword_token.line)), TokenKind.Assign, value, keyword_token.line))


        # `requires E` / `ensure E` / `decreases E` / `invariant E` / `changes PATH` /
        # `preserves PATH` —
        # a design-by-contract leading body statement. The keyword is contextual; the
        # dispatcher has already confirmed an operand follows on the same line.
        def contract_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind keyword_token: Token, parser = parser.advance()              # consume the contract keyword
            kind_text: sview = Lexer::text_or_empty(keyword_token, parser.source)
            if kind_text == "decreases" and parser.peek() == TokenKind.Star:
                parser, _ <- parser.advance()
                reason: mutable Ast::Expr = (Ast::Expr.StringLit(""))
                if parser.peek() == TokenKind.StringLit:
                    rebind reason_token: Token, parser = parser.advance()
                    reason <- (Ast::Expr.StringLit(Lexer::text_or_empty(reason_token, parser.source)))
                return (Ast::Stmt.Contract("decreases*", reason, keyword_token.line))
            rebind predicate_value: Ast::Expr, parser = get parser.expression()
            predicate: mutable Ast::Expr = predicate_value
            # `ensure GUARD => POST` / `ensure GUARD implies POST` — an implication
            # postcondition (docs/118-B: conditional progress contracts). Fold to
            # `(not GUARD) or POST` so BOTH sides name-resolve; the stage1 frontend does
            # not discharge contracts, so the desugaring only needs to be resolvable and
            # to match the shape stage0's parser produces for differential parity.
            implies_token: Token = parser.cursor()
            is_implies_keyword: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(implies_token, parser.source) == "implies"
            if parser.peek() == TokenKind.FatArrow or is_implies_keyword:
                rebind arrow_token: Token, parser = parser.advance()    # `=>` or `implies`
                rebind consequent: Ast::Expr, parser = get parser.expression()
                negated_guard: Ast::Expr = (Ast::Expr.Unary(TokenKind.Not, predicate, arrow_token.line))
                predicate <- (Ast::Expr.Binary(negated_guard, TokenKind.Or, consequent, arrow_token.line))
            if kind_text == "assert" and parser.peek() == TokenKind.Comma:
                parser, _ <- parser.advance()
                parser, _ <- parser.expression()
            return (Ast::Stmt.Contract(kind_text, predicate, keyword_token.line))


        # `expect EXPR as PATTERN(S)` (with an optional `:` block) and the inverted
        # `expect let PATTERN = EXPR` — assert EXPR matches PATTERN, binding its fields.
        # Modeled as a Match on EXPR. Stage0 keeps a dedicated ExpectPatternStmt and
        # lowers its failure path in the backend; stage1 represents that failure as an
        # explicit wildcard panic arm so the AST remains self-contained.
        def expect_pattern_failure_stmt(parser: Parser&, line: u32) -> Ast::Stmt:
            panic_callee: Ast::Expr = (Ast::Expr.Ident("panic", line))
            panic_message: Ast::Expr = (Ast::Expr.StringLit("expect pattern failed"))
            panic_args: mutable darray[Ast::Expr] = [panic_message]
            no_arg_names: darray[sview] = [""]
            panic_call: Ast::Expr = (Ast::Expr.Call(panic_callee, panic_args, no_arg_names, line))
            return (Ast::Stmt.Expr(panic_call, line))

        def expect_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind expect_token: Token, parser = parser.advance()              # `expect`

            let_token: Token = parser.cursor()
            if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(let_token, parser.source) == "let":
                parser, _ <- parser.advance()                       # `let`
                rebind let_pattern: Ast::Pattern, parser = parser.parse_pattern()
                parser, _ <- parser.capture_pattern_span() if parser.peek() != TokenKind.Assign      # exotic tail; consumed losslessly
                parser, _ <- parser.expect(TokenKind.Assign)
                rebind let_value: Ast::Expr, parser = get parser.expression()
                let_body: mutable darray[Ast::Stmt] = []
                let_body, parser <- parser.parse_block() if parser.peek() == TokenKind.Colon
                let_arms: mutable darray[Ast::MatchArm] = [Ast::MatchArm{pattern: let_pattern, body: let_body, guard: (Ast::Expr.Absent)}]
                let_panic_body: darray[Ast::Stmt] = [parser.expect_pattern_failure_stmt(expect_token.line)]
                let_arms.push(Ast::MatchArm{pattern: (Ast::Pattern.Wildcard), body: let_panic_body, guard: (Ast::Expr.Absent)})
                return (Ast::Stmt.Match(let_value, let_arms, expect_token.line))

            parser.suppress_as_pattern <- true
            rebind value_option: Ast::Expr?, parser = parser.expression()
            parser.suppress_as_pattern <- false
            value: Ast::Expr = get value_option else return (Ast::Stmt.Invalid)
            parser, _ <- parser.expect(TokenKind.As)
            rebind pattern: Ast::Pattern, parser = parser.parse_pattern()

            body: mutable darray[Ast::Stmt] = []
            body, parser <- parser.parse_block() if parser.peek() == TokenKind.Colon
            body.push((Ast::Stmt.Expr((Ast::Expr.Invalid), expect_token.line))) if body.count == 0

            arms: mutable darray[Ast::MatchArm] = [Ast::MatchArm{pattern: pattern, body: body, guard: (Ast::Expr.Absent)}]
            panic_body: darray[Ast::Stmt] = [parser.expect_pattern_failure_stmt(expect_token.line)]
            arms.push(Ast::MatchArm{pattern: (Ast::Pattern.Wildcard), body: panic_body, guard: (Ast::Expr.Absent)})
            return (Ast::Stmt.Match(value, arms, expect_token.line))


        # A statement whose prefix clause is not yet modeled but which introduces a
        # `:`-block (e.g. `can Mem.Allocate:`, `region scratch:`, `try:`). Skip the
        # prefix tokens up to a paren-balanced top-level `:`, then parse the block.
        # A prefix with no block (e.g. `region scratch(1024)`) is malformed. Do not
        # silently degrade it to an empty statement: the stage0 parser rejects the
        # construct and silently dropping it makes a typo disappear from the AST.
        def prefixed_block_statement(parser: lmut Parser) -> Ast::Stmt?:
            line: u32 = parser.cursor().line

            # Classify the clause category from the leading token so region/effect
            # passes can dispatch structurally. Keyword-token prefixes map to their
            # spelling; contextual-keyword prefixes (`can`, `region`, …) are Idents
            # and carry their text directly; a bare `slot:` success arm is "arm".
            first_kind: TokenKind = parser.peek()
            first_token: Token = parser.cursor()
            is_arm: bool = first_kind == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon and parser.peek_at(2) == TokenKind.Newline
            # is_arm requires Ident, so the arm guard lives inside the Ident arm.
            block_kind: sview = match first_kind:
                TokenKind.With:    "with"
                TokenKind.Region:  "region"
                TokenKind.Try:     "try"
                TokenKind.Catch:   "catch"
                TokenKind.In:      "in"
                TokenKind.Error:   "error"
                TokenKind.Static:  "static"
                TokenKind.Ident:   "arm" if is_arm else Lexer::text_or_empty(first_token, parser.source)
                _:                 ""

            # Capture the name a binding-introducing prefix brings into scope:
            # `error IDENT:` binds the error value; a success arm `IDENT:` binds the
            # result. Everything else binds nothing.
            binding: mutable sview = ""
            match first_kind:
                TokenKind.Error:
                    parser, _ <- parser.advance()                       # `error`
                    if parser.peek() == TokenKind.Ident:
                        error_token: Token = parser.cursor()
                        binding <- Lexer::text_or_empty(error_token, parser.source)
                _:
                    binding <- Lexer::text_or_empty(first_token, parser.source) if is_arm

            # Collect the prefix's identifier tokens (in order) up to the block colon:
            # granted effect names (`can Mem.Allocate:`) or a region name
            # (`region scratch(…):`). The leading clause keyword and the arm binding are
            # already captured above, so skip identifiers at position 0.
            clause: mutable darray[sview] = []
            region_capacity_start: mutable usize = 0
            while parser.peek() != TokenKind.Eof |parser, depth: int = 0, first: bool = true|:
                kind: TokenKind = parser.peek()
                match kind:
                    TokenKind.LParen | TokenKind.LBracket:
                        region_capacity_start <- parser.cursor().start.usize() + 1 if block_kind == "region" and kind == TokenKind.LParen and depth == 0
                        depth <- depth + 1
                        parser, _ <- parser.advance()
                    TokenKind.RParen | TokenKind.RBracket:
                        if block_kind == "region" and kind == TokenKind.RParen and depth == 1 and region_capacity_start > 0:
                            capacity_end: usize = parser.cursor().start.usize()
                            clause.push(parser.span_view(region_capacity_start, capacity_end))
                            region_capacity_start <- 0
                        depth <- depth - 1
                        parser, _ <- parser.advance()
                    TokenKind.Colon | TokenKind.Newline if depth == 0:
                        break
                    TokenKind.As if depth == 0 and (block_kind == "can" or block_kind == "lock"):
                        # `can Effects as Family:` records the effect-family cast
                        # target; `lock mutex as guard:` records the guard binding.
                        parser, _ <- parser.advance()
                        rebind binding_token: Token, parser = parser.expect(TokenKind.Ident)
                        binding <- Lexer::text_or_empty(binding_token, parser.source)
                    TokenKind.Ident if depth == 0 and not first:
                        # Preserve region's contextual `using` marker separately so the
                        # clause side-table retains allocator intent; qualified effect
                        # paths remain one entry.
                        clause_token: Token = parser.cursor()
                        if block_kind == "region" and Lexer::text_or_empty(clause_token, parser.source) == "using":
                            clause.push("using")
                            parser, _ <- parser.advance()
                        else:
                            rebind dotted_clause_name: sview, parser = parser.parse_dotted_name()
                            clause.push(dotted_clause_name)
                    _:
                        first <- false
                        parser, _ <- parser.advance()

            if parser.peek() != TokenKind.Colon:
                # Region declarations are the only currently recognized prefix whose
                # no-block form is unambiguously invalid at this frontend layer. Keep
                # legacy recovery for other keyword-shaped expression forms until their
                # dedicated AST nodes are ported.
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, first_token) if block_kind == "region"
                # Keep the existing recovery node shape after recording the error;
                # downstream walkers already treat this expression as non-executable.
                return (Ast::Stmt.Expr((Ast::Expr.Invalid), line))

            rebind body: darray[Ast::Stmt], parser = parser.parse_block()
            return (Ast::Stmt.Block(block_kind, clause, binding, body, line))


        def if_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind if_token: Token, parser = parser.expect(TokenKind.If)
            rebind __ret_237: Ast::Stmt?, parser = parser.if_tail(if_token)
            return __ret_237


        # Shared tail for `if` and `elif`: parse `<condition> <block>` then an optional
        # `elif`/`else` continuation. An `elif` chain desugars into a nested If stored
        # as the single statement of the parent's else_body — no separate elif node.
        def if_tail(parser: lmut Parser, token: Token) -> Ast::Stmt?:
            # Optional branch-prediction hint `if likely COND:` / `if unlikely COND:`
            # (contextual idents, also valid on `elif`). Only consumed when an operand
            # follows, so a bool local literally named `likely` still works bare.
            hint_token: Token = parser.cursor()
            if parser.peek() == TokenKind.Ident:
                hint_text: sview = Lexer::text_or_empty(hint_token, parser.source)
                parser, _ <- parser.advance() if (hint_text == "likely" or hint_text == "unlikely") and tokenStartsValue(parser.peek_at(1))
            rebind condition: Ast::Expr, parser = get parser.expression()
            rebind then_body: darray[Ast::Stmt], parser = parser.parse_block()

            else_body: mutable darray[Ast::Stmt] = []
            parser <- parser.skip_newlines()

            next_kind: TokenKind = parser.peek()
            match next_kind:
                TokenKind.Elif:
                    rebind elif_token: Token, parser = parser.advance()
                    # An `elif` chain desugars into a nested If as the single statement of the
                    # parent's else body.
                    rebind __m_264: Ast::Stmt?, parser = parser.if_tail(elif_token)
                    else_body.push(nested_if) if __m_264 is nested_if
                TokenKind.Else:
                    parser, _ <- parser.advance()
                    else_body, parser <- parser.parse_block()
                _:
                    pass

            return (Ast::Stmt.If(condition, then_body, else_body, token.line))


        def while_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind while_token: Token, parser = parser.expect(TokenKind.While)
            hint_token: Token = parser.cursor()
            has_hint: bool = parser.peek() == TokenKind.Ident and (Lexer::text_or_empty(hint_token, parser.source) == "likely" or Lexer::text_or_empty(hint_token, parser.source) == "unlikely") and tokenStartsValue(parser.peek_at(1))
            parser, _ <- parser.advance() if has_hint
            # docs/119 §3: binary parsing stops at a header's opening `|` (loop_header_at),
            # so the ordinary condition parse already yields the pre-header expression.
            rebind condition: Ast::Expr, parser = get parser.expression()
            if not parser.loop_header_at():
                rebind body: darray[Ast::Stmt], parser = parser.parse_block()
                return (Ast::Stmt.While(condition, body, while_token.line))
            header_declarations: mutable darray[Ast::Stmt] = []
            header_captures: mutable darray[sview] = []
            header_has_yield: mutable bool = false
            rebind header_yield: Ast::Expr, parser = parser.parse_loop_header(header_declarations, header_captures, header_has_yield)
            rebind loop_body: darray[Ast::Stmt], parser = parser.parse_block()
            rebind __ret_285: Ast::Stmt, parser = parser.wrap_loop_header(header_declarations, header_yield, (Ast::Stmt.While(condition, loop_body, while_token.line)), while_token.line, header_captures)
            return __ret_285


        def return_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind return_token: Token, parser = parser.expect(TokenKind.Return)

            # `return if COND: THEN else: ELSE` is a value expression. Its leading tokens
            # overlap the postfix guard `return if COND`; a top-level colon before the
            # newline distinguishes the value form.
            rebind accepted_if: bool, parser = parser.accept(TokenKind.If)
            if accepted_if:
                rebind condition: Ast::Expr, parser = get parser.expression()
                if parser.peek() == TokenKind.Colon:
                    parser, _ <- parser.advance()
                    rebind then_value: Ast::Expr, parser = parser.parse_bare_block_value()
                    parser <- parser.skip_newlines()
                    parser, _ <- parser.expect(TokenKind.Else)
                    parser, _ <- parser.expect(TokenKind.Colon)
                    rebind else_value: Ast::Expr, parser = parser.parse_bare_block_value()
                    conditional: Ast::Expr = (Ast::Expr.If(condition, then_value, else_value, return_token.line))
                    return (Ast::Stmt.Return(conditional, return_token.line))
                # No colon: bare postfix guard `return if COND` (== `if COND: return`).
                body: mutable darray[Ast::Stmt] = []
                body.push((Ast::Stmt.Return(null, return_token.line)))
                no_else: darray[Ast::Stmt] = []
                return (Ast::Stmt.If(condition, body, no_else, return_token.line))
            else:
                value: mutable Ast::Expr? = null
                parser, value <- parser.expression() if parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Eof
                if value is value_present:
                    parser, _ <- parser.consume_removed_as_cast(value_present)

                # Multi-value return `return a, b` (a named-tuple result type's value
                # list) — collect the remaining values into a Tuple.
                if parser.peek() == TokenKind.Comma and value is first_value:
                    return_elements: mutable darray[Ast::Expr] = [first_value]
                    while parser.accept(TokenKind.Comma) |parser|:
                        break if parser.peek() == TokenKind.Newline or parser.peek() == TokenKind.Eof
                        rebind return_element_option: Ast::Expr?, parser = parser.expression()
                        return_elements.push(return_element) if return_element_option is return_element
                    value <- (Ast::Expr.Tuple(return_elements, return_token.line))

                parser <- parser.validate_declared_thread_return(value, return_token)

                # Trailing guard `return VALUE if COND` (== `if COND: return VALUE`).
                rebind accepted_if_2: bool, parser = parser.accept(TokenKind.If)
                if accepted_if_2:
                    rebind value_condition: Ast::Expr, parser = get parser.expression()
                    value_body: mutable darray[Ast::Stmt] = []
                    value_body.push((Ast::Stmt.Return(value, return_token.line)))
                    value_no_else: darray[Ast::Stmt] = []
                    return (Ast::Stmt.If(value_condition, value_body, value_no_else, return_token.line))
                else:
                    return (Ast::Stmt.Return(value, return_token.line))

        def validate_declared_thread_return(parser: lmut Parser, value: Ast::Expr?, token: Token) -> void:
            return if parser.declared_thread_slots.count == 0
            if value is threaded_value:
                match threaded_value:
                    Ast::Expr.Tuple(elements, line):
                        if elements.count == parser.declared_thread_slots.count + 1:
                            valid: mutable bool = true
                            i: mutable usize = 0
                            while i < parser.declared_thread_slots.count |i, valid|:
                                expected: sview = parser.declared_thread_slots[i]
                                match elements[i + 1]:
                                    Ast::Expr.Ident(actual, ident_line):
                                        valid <- false if actual != expected
                                    _:
                                        valid <- false
                                i <- i + 1
                            return if valid
                    _:
                        pass
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token)
