extend Parser:
    private:
        # Distinguish the `guard COND else …` statement from a local named `guard`
        # (`guard: T = …`, `guard.field <- …`). Scan the rest of the line, tracking
        # bracket depth; it is a guard statement iff a top-level `else` appears before
        # the line ends (mirrors stage0 looksLikeGuardStmt).
        def looks_like_guard_statement(parser: Parser&) -> bool:
            while true |depth: int = 0, scan_index: usize = 1|:
                kind: TokenKind = parser.peek_at(scan_index)
                false return if kind == TokenKind.Eof or kind == TokenKind.Newline
                match kind:
                    TokenKind.LParen | TokenKind.LBracket:
                        depth <- depth + 1
                    TokenKind.RParen | TokenKind.RBracket:
                        depth <- depth - 1 if depth > 0
                    TokenKind.Else:
                        true return if depth == 0
                    _:
                        pass
                scan_index <- scan_index + 1
            return false


        # `guard COND else STMT` / `guard COND else: BLOCK` — an early-exit guard whose
        # else-branch runs when COND is false. Desugared to `if not COND: <else>` so the
        # condition and the else body both resolve like any other if. (Contextual
        # keyword — the lexer emits `guard` as an identifier.)
        def guard_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind guard_token: Token, parser = parser.advance()              # `guard`
            rebind condition: Ast::Expr, parser = get parser.expression()
            parser, _ <- parser.expect(TokenKind.Else)
            negated_condition: Ast::Expr = (Ast::Expr.Unary(TokenKind.Not, condition, guard_token.line))
            then_body: mutable darray[Ast::Stmt] = []
            match parser.peek():
                TokenKind.Colon:
                    then_body, parser <- parser.parse_block()
                _:
                    rebind __es: Ast::Stmt?, parser = parser.statement()
                    if __es is else_statement:
                        then_body.push(else_statement)
            no_else: darray[Ast::Stmt] = []
            return (Ast::Stmt.If(negated_condition, then_body, no_else, guard_token.line))


        # Parse the value RHS of a `name: T = …` binding when an `=` was accepted: a bare
        # block-value (docs/119 §2) or a plain expression (absent → Invalid). No `=` → Invalid,
        # parser untouched. Extracted so the caller threads it as one assignment rather than a
        # block `if` wrapping the block-vs-expression decision.
        def parse_binding_value(parser: lmut Parser, accepted_assign: bool) -> Ast::Expr:
            (Ast::Expr.Invalid) return if not accepted_assign
            if parser.block_value_rhs_ahead():
                rebind block_value: Ast::Expr, parser = parser.parse_block_value_rhs()
                return block_value
            rebind parsed_value_option: Ast::Expr?, parser = parser.expression()
            return (get parsed_value_option else (Ast::Expr.Invalid))


        def variable_declaration_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            parser, _ <- parser.expect(TokenKind.Colon)
            parser <- parser.reject_positional_tuple_type_ahead()
            # Parse the TYPE in type-annotation context so a `fn(A)->R` local type resolves as a
            # fn-TYPE (arrow, no body) rather than a call to a fn named `fn`.
            parser.in_type_annotation <- true
            rebind parsed_type_expression: Ast::Expr?, parser = parser.expression()
            parser.in_type_annotation <- false
            type_expression: mutable Ast::Expr = get parsed_type_expression
            rebind refined_type: Ast::Expr, parser = parser.parse_refinement_suffix(type_expression)
            type_expression <- refined_type
            parser <- parser.record_tuple_type(type_expression)

            # The compact AST stores the payload type for a local error union. Preserve
            # and consume its `error[Family]` suffix so the declaration remains a single
            # typed binding and the backend can attach the first-class union later.
            parser <- parser.record_error_union(name_token.line, "__local_error_union") if parser.peek() == TokenKind.Error

            # Optional `@region` binding annotation (`x: T @scratch = …`) pinning the
            # local to a named region. The region name is a region selector, not a value
            # reference, so it is consumed and discarded.
            rebind accepted_at: bool, parser = parser.accept(TokenKind.At)
            region_token: Token = parser.cursor()
            has_region_name: bool = accepted_at and parser.peek() == TokenKind.Ident
            parser <- parser.advance_when(has_region_name)
            parser.local_region_annotations <- parser.local_region_annotations.push(Ast::LocalRegionAnnotation{name: Lexer::text_or_empty(name_token, parser.source), type_expression: type_expression, region: Lexer::text_or_empty(region_token, parser.source), line: name_token.line}) if has_region_name

            # `value` is non-optional in the AST; an uninitialized binding records Invalid.
            value: mutable Ast::Expr = (Ast::Expr.Invalid)
            rebind accepted_assign: bool, parser = parser.accept(TokenKind.Assign)
            value, parser <- parser.parse_binding_value(accepted_assign)
            rebind __t_67: Ast::Expr, parser = parser.consume_removed_as_cast(value)
            value <- __t_67

            # Optional-binding recovery tail `NAME: T = EXPR else <statement>` (the desugared
            # `get`): if the RHS is empty, run the else statement (typically `return …`).
            # The else branch isn't modeled on VarDecl; parse it so the line is consumed.
            rebind accepted_else: bool, parser = parser.accept(TokenKind.Else)
            if accepted_else:
                match parser.peek():
                    TokenKind.Colon:
                        parser, _ <- parser.parse_block()
                    _:
                        parser, _ <- parser.statement()

            return (Ast::Stmt.VarDecl(Lexer::text_or_empty(name_token, parser.source), type_expression, value, name_token.line))


        # `rebind TARGET (, TARGET)* = <block/expression>` (docs/119 §5) threads a value block's
        # result back into outer mutables (bare targets) and fresh bindings (`name: T`).
        # For the frontend, resolution is what matters: every target name binds and the
        # RHS resolves, so the whole form desugars to a tuple assignment over the target
        # idents (a fresh target's `: T` annotation is parsed and dropped — the temp-move
        # threading and E8 discipline are stage0 codegen concerns, not name resolution).
        def rebind_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind keyword_token: Token, parser = parser.advance()   # consume `rebind`
            targets: mutable darray[Ast::Expr] = []
            any_colon: mutable bool = false
            first_is_fresh: mutable bool = false
            first_name: mutable sview = ""
            first_type: mutable Ast::Expr = (Ast::Expr.Invalid)
            target_count: mutable usize = 0
            while true |parser, targets, any_colon, first_is_fresh, first_name, first_type, target_count|:
                rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
                targets.push((Ast::Expr.Ident(Lexer::text_or_empty(name_token, parser.source), name_token.line)))
                # Optional `: T` marks a fresh binding; the type is a selector here.
                rebind accepted_colon: bool, parser = parser.accept(TokenKind.Colon)
                any_colon <- true if accepted_colon
                # A colon-LESS target re-binds an existing name — it CLAIMS a threaded slot
                # (docs/120): the callee must thread it (via an `lmut` parameter). Recorded here
                # keyed by the rebind's line so a semantic check can validate the claim.
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__lmut_rebind_claim", name: Lexer::text_or_empty(name_token, parser.source), line: keyword_token.line}) if not accepted_colon
                # The first target's `: T` annotation is RETAINED (not dropped): the bare-`get`
                # threading form `rebind X: T, recv = get recv.method()` lowers to a plain
                # VarDecl below, and the VarDecl bare-get path needs T to unwrap the optional.
                if accepted_colon:
                    parser.in_type_annotation <- true
                    rebind target_type_option: Ast::Expr?, parser = parser.expression()
                    parser.in_type_annotation <- false
                    if target_count == 0:
                        first_type <- target_type_value if target_type_option is target_type_value
                if target_count == 0:
                    first_is_fresh <- accepted_colon
                    first_name <- Lexer::text_or_empty(name_token, parser.source)
                target_count <- target_count + 1
                rebind accepted_comma: bool, parser = parser.accept(TokenKind.Comma)
                break if not accepted_comma
            parser, _ <- parser.expect(TokenKind.Assign)
            # Was the RHS a bare `get`? The stripped node loses that marker, so capture it
            # here (the enclosing fn must return an optional for the None to propagate into).
            value_head_token: Token = parser.cursor()
            value_is_get: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(value_head_token, parser.source) == "get" and parser.peek_at(1) == TokenKind.Ident
            value: mutable Ast::Expr = (Ast::Expr.Invalid)
            if parser.block_value_rhs_ahead():
                value, parser <- parser.parse_block_value_rhs()
            else:
                rebind parsed_value_option: Ast::Expr?, parser = parser.expression()
                value <- parsed_value if parsed_value_option is parsed_value
            # `rebind X: T, recv = get recv.method()` — the single-fresh-binding threading
            # form. The receiver `recv` threads through the call (an `lmut` argument mutated
            # in place), so the trailing claim-targets need no store: this is exactly a
            # VarDecl bare-get `X: T = get recv.method()`. Lower to it so the backend's
            # VarDecl bare-get path binds X's payload and PROPAGATES None on absent.
            (Ast::Stmt.VarDecl(first_name, first_type, value, keyword_token.line)) return if value_is_get and first_is_fresh and target_count >= 1
            # A colon on ANY target marks the group as introducing fresh bindings (the
            # threading idiom `rebind x: T, parser = …`). With NO colon anywhere, `rebind`
            # re-binds EXISTING targets (like `<-`): lower with LArrow so the resolver
            # requires them to already resolve rather than silently defining them.
            rebind_operator: TokenKind = TokenKind.Assign if any_colon else TokenKind.LArrow
            return (Ast::Stmt.Assign((Ast::Expr.Array(targets, keyword_token.line)), rebind_operator, value, keyword_token.line))


        # A contract-position expression (docs/90 brick 90-4): the ordinary expression
        # grammar plus the spec-only forms — a `forall i, j:`/`exists i:` quantifier
        # prefix (optionally parenthesized binders, optionally `in <range>`) and the
        # right-associative `implies`/`=>` implication infix. The stage1 frontend does
        # not discharge contracts, so a quantifier lowers to a resolvable shape: a block
        # declaring each binder as an integer local whose value expression is the body
        # (binders resolve, the body type-checks, nothing is proven). An `in <range>`
        # source is consumed and dropped — it only feeds stage0's prover.
        def contract_expression(parser: lmut Parser) -> Ast::Expr:
            saved_in_contract: bool = parser.in_contract
            parser.in_contract <- true
            rebind result: Ast::Expr, parser = parser.contract_expression_inner()
            parser.in_contract <- saved_in_contract
            return result

        def contract_expression_inner(parser: lmut Parser) -> Ast::Expr:
            head_token: Token = parser.cursor()
            head_text: sview = Lexer::text_or_empty(head_token, parser.source)
            is_quantifier: bool = parser.peek() == TokenKind.Ident and (head_text == "forall" or head_text == "exists") and (parser.peek_at(1) == TokenKind.Ident or parser.peek_at(1) == TokenKind.LParen)
            if is_quantifier:
                parser, _ <- parser.advance()                       # forall / exists
                has_parens: bool = parser.peek() == TokenKind.LParen
                parser, _ <- parser.advance() if has_parens
                binders: mutable darray[sview] = []
                rebind first_binder_token: Token, parser = parser.expect(TokenKind.Ident)
                binders.push(Lexer::text_or_empty(first_binder_token, parser.source))
                while parser.accept(TokenKind.Comma) |parser, binders|:
                    rebind more_binder_token: Token, parser = parser.expect(TokenKind.Ident)
                    binders.push(Lexer::text_or_empty(more_binder_token, parser.source))
                parser, _ <- parser.expect(TokenKind.RParen) if has_parens
                quantifier_source: mutable Ast::Expr = (Ast::Expr.Invalid)
                if parser.peek() == TokenKind.In:
                    parser, _ <- parser.advance()
                    rebind range_source_opt: Ast::Expr?, parser = parser.expression()
                    range_source: Ast::Expr = get range_source_opt else (Ast::Expr.Invalid)
                    # A BARE `a .. b` quantifier source is ambiguous and stage0 rejects it
                    # (the expression form of this quantifier already did; the contract
                    # form -- `law P(...) = forall k in 0 .. n: ...` -- did not).
                    bare_range: mutable bool = false
                    if range_source is Expr.Binary(range_left, range_operator, range_right, range_line):
                        bare_range <- range_operator == TokenKind.Range
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, head_token) if bare_range
                    quantifier_source <- range_source
                parser, _ <- parser.expect(TokenKind.Colon)
                rebind body_option: Ast::Expr?, parser = parser.expression()
                body: mutable Ast::Expr = get body_option else (Ast::Expr.Invalid)
                # `forall k: GUARD implies POST` — fold the implication INSIDE the
                # quantifier. contract_statement folds a trailing `implies` around the
                # WHOLE predicate, which put the consequent outside the binder's block:
                # every `k` in POST then resolved as an undefined identifier.
                quantifier_implies_token: Token = parser.cursor()
                quantifier_is_implies: bool = parser.peek() == TokenKind.FatArrow or (parser.peek() == TokenKind.Ident and Lexer::text_or_empty(quantifier_implies_token, parser.source) == "implies")
                if quantifier_is_implies:
                    rebind quantifier_arrow: Token, parser = parser.advance()
                    rebind quantifier_consequent_opt: Ast::Expr?, parser = parser.expression()
                    quantifier_consequent: Ast::Expr = get quantifier_consequent_opt else (Ast::Expr.Invalid)
                    quantifier_negated: Ast::Expr = (Ast::Expr.Unary(TokenKind.Not, body, quantifier_arrow.line))
                    body <- (Ast::Expr.Binary(quantifier_negated, TokenKind.Or, quantifier_consequent, quantifier_arrow.line))
                binder_declarations: mutable darray[Ast::Stmt] = []
                first_binder: mutable bool = true
                for binder in binders |binder_declarations, first_binder, quantifier_source|:
                    binder_value: Ast::Expr = quantifier_source if first_binder else (Ast::Expr.IntLit(0))
                    binder_declarations.push(Ast::Stmt.VarDecl(binder, (Ast::Expr.Ident("i64", head_token.line)), binder_value, head_token.line))
                    first_binder <- false
                no_captures: darray[sview] = []
                return (Ast::Expr.Block(binder_declarations, body, no_captures, head_token.line))
            rebind base_option: Ast::Expr?, parser = parser.expression()
            folded: mutable Ast::Expr = get base_option else (Ast::Expr.Invalid)
            implies_cursor: Token = parser.cursor()
            is_implies: bool = parser.peek() == TokenKind.FatArrow or (parser.peek() == TokenKind.Ident and Lexer::text_or_empty(implies_cursor, parser.source) == "implies")
            if is_implies:
                rebind implication_token: Token, parser = parser.advance()
                rebind consequent_option: Ast::Expr?, parser = parser.expression()
                consequent: Ast::Expr = get consequent_option else (Ast::Expr.Invalid)
                folded <- (Ast::Expr.Binary((Ast::Expr.Unary(TokenKind.Not, folded, implication_token.line)), TokenKind.Or, consequent, implication_token.line))
            return folded

        # `requires E` / `ensure E` / `decreases E` / `invariant E` / `changes PATH` /
        # `preserves PATH` —
        # a design-by-contract leading body statement. The keyword is contextual; the
        # dispatcher has already confirmed an operand follows on the same line.
        def contract_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind keyword_token: Token, parser = parser.advance()              # consume the contract keyword
            kind_text: sview = Lexer::text_or_empty(keyword_token, parser.source)
            if kind_text == "decreases" and parser.peek() == TokenKind.Star:
                parser, _ <- parser.advance()
                reason: mutable Ast::Expr = (Ast::Expr.StringLit(""))
                if parser.peek() == TokenKind.StringLit:
                    rebind reason_token: Token, parser = parser.advance()
                    reason <- (Ast::Expr.StringLit(Lexer::text_or_empty(reason_token, parser.source)))
                return (Ast::Stmt.Contract("decreases*", reason, keyword_token.line))
            rebind predicate_value: Ast::Expr, parser = parser.contract_expression()
            predicate: mutable Ast::Expr = predicate_value
            # `ensure GUARD => POST` / `ensure GUARD implies POST` — an implication
            # postcondition (docs/118-B: conditional progress contracts). Fold to
            # `(not GUARD) or POST` so BOTH sides name-resolve; the stage1 frontend does
            # not discharge contracts, so the desugaring only needs to be resolvable and
            # to match the shape stage0's parser produces for differential parity.
            implies_token: Token = parser.cursor()
            is_implies_keyword: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(implies_token, parser.source) == "implies"
            if parser.peek() == TokenKind.FatArrow or is_implies_keyword:
                rebind arrow_token: Token, parser = parser.advance()    # `=>` or `implies`
                rebind consequent: Ast::Expr, parser = get parser.expression()
                negated_guard: Ast::Expr = (Ast::Expr.Unary(TokenKind.Not, predicate, arrow_token.line))
                predicate <- (Ast::Expr.Binary(negated_guard, TokenKind.Or, consequent, arrow_token.line))
            if kind_text == "assert" and parser.peek() == TokenKind.Comma:
                parser, _ <- parser.advance()
                parser, _ <- parser.expression()
            # `assert COND by TACTIC:` — a scoped proof tactic block (docs/90). The tactic
            # name and its indented proof body are consumed; stage1 does not discharge the
            # proof, so the block is skipped (the goal predicate above still resolves).
            by_token: Token = parser.cursor()
            by_present: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(by_token, parser.source) == "by"
            parser <- parser.advance_when(by_present)                    # `by`
            # The tactic name is OPTIONAL (`assert C by:` is the bare form). It is RETAINED as the
            # block's binding so the semantic checker can honor `by scoped:` (walls — no caller facts).
            tactic_token: Token = parser.cursor()
            tactic_named: bool = by_present and parser.peek() == TokenKind.Ident
            tactic_name: sview = Lexer::text_or_empty(tactic_token, parser.source) if tactic_named else sview("", 0, 0)
            parser <- parser.advance_when(tactic_named)                  # tactic name
            has_tactic_block: bool = by_present and parser.peek() == TokenKind.Colon
            parser <- parser.advance_when(has_tactic_block)              # `:`
            # An inline mode word may trail the colon (`by scoped: bitvector`) before
            # the indented proof body.
            parser <- parser.skip_to_line_end() if has_tactic_block
            (Ast::Stmt.Contract(kind_text, predicate, keyword_token.line)) return if not has_tactic_block
            # The proof body is RETAINED (not skipped): check_assert_by judges the
            # goal from the block's facts and rejects effectful statements in it.
            # The goal rides as the block's first statement.
            rebind proof_body: darray[Ast::Stmt], parser = parser.parse_indented_block_if(true)
            carried: mutable darray[Ast::Stmt] = [(Ast::Stmt.Contract(kind_text, predicate, keyword_token.line))]
            carried.extend(proof_body)
            empty_clause: darray[sview] = []
            return (Ast::Stmt.Block("assert_by", empty_clause, tactic_name, carried, keyword_token.line))


        # `proof GOAL:` — a scoped proof-tactic block (docs/90) whose GOAL must follow from
        # the block's OWN facts (walls: the caller's `requires` do NOT count). Model it exactly
        # like `assert GOAL by scoped:` so check_assert_by judges it: the goal rides as the
        # block's first Contract and the tactic binding is "scoped".
        def proof_block_statement(parser: lmut Parser) -> Ast::Stmt?:
            can Memory.Allocate, Abort.Panic:
                keyword_token: Token = parser.cursor()
                parser, _ <- parser.advance()                            # `proof`
                rebind predicate_opt: Ast::Expr?, parser = parser.expression()
                predicate: Ast::Expr = get predicate_opt else (Ast::Expr.Invalid)
                parser, _ <- parser.accept(TokenKind.Colon)
                rebind proof_body: darray[Ast::Stmt], parser = parser.parse_indented_block_if(true)
                carried: mutable darray[Ast::Stmt] = [(Ast::Stmt.Contract("assert", predicate, keyword_token.line))]
                carried.extend(proof_body)
                empty_clause: darray[sview] = []
                return (Ast::Stmt.Block("assert_by", empty_clause, sview("scoped", 0, 6), carried, keyword_token.line))

        # `expect EXPR as PATTERN(S)` (with an optional `:` block) and the inverted
        # `expect let PATTERN = EXPR` — assert EXPR matches PATTERN, binding its fields.
        # Modeled as a Match on EXPR. Stage0 keeps a dedicated ExpectPatternStmt and
        # lowers its failure path in the backend; stage1 represents that failure as an
        # explicit wildcard panic arm so the AST remains self-contained.
        def expect_pattern_failure_stmt(parser: Parser&, line: u32) -> Ast::Stmt:
            panic_callee: Ast::Expr = (Ast::Expr.Ident("panic", line))
            panic_message: Ast::Expr = (Ast::Expr.StringLit("expect pattern failed"))
            panic_args: mutable darray[Ast::Expr] = [panic_message]
            no_arg_names: darray[sview] = [""]
            panic_call: Ast::Expr = (Ast::Expr.Call(panic_callee, panic_args, no_arg_names, line))
            return (Ast::Stmt.Expr(panic_call, line))

        def expect_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind expect_token: Token, parser = parser.advance()              # `expect`

            let_token: Token = parser.cursor()
            if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(let_token, parser.source) == "let":
                parser, _ <- parser.advance()                       # `let`
                rebind let_pattern: Ast::Pattern, parser = parser.parse_pattern()
                parser, _ <- parser.capture_pattern_span() if parser.peek() != TokenKind.Assign      # exotic tail; consumed losslessly
                parser, _ <- parser.expect(TokenKind.Assign)
                rebind let_value: Ast::Expr, parser = get parser.expression()
                let_body: mutable darray[Ast::Stmt] = []
                let_has_block: bool = parser.peek() == TokenKind.Colon
                let_body, parser <- parser.parse_block() if let_has_block
                let_arms: mutable darray[Ast::MatchArm] = [Ast::MatchArm{pattern: let_pattern, body: let_body, guard: (Ast::Expr.Absent)}]
                let_panic_body: darray[Ast::Stmt] = [parser.expect_pattern_failure_stmt(expect_token.line)]
                let_arms.push(Ast::MatchArm{pattern: (Ast::Pattern.Wildcard), body: let_panic_body, guard: (Ast::Expr.Absent)})
                let_match: Ast::Stmt = (Ast::Stmt.Match(let_value, let_arms, expect_token.line))
                if let_has_block:
                    return let_match
                else:
                    let_lowered: mutable darray[Ast::Stmt] = [let_match]
                    let_bindings: mutable darray[sview] = []
                    pattern_binding_names(let_pattern, let_bindings)
                    for let_binding in let_bindings |let_lowered|:
                        let_lowered.push((Ast::Stmt.VarDecl(let_binding, (Ast::Expr.Invalid), (Ast::Expr.Absent), expect_token.line)))
                    return (Ast::Stmt.Block("expect", [], "", let_lowered, expect_token.line))

            parser.suppress_as_pattern <- true
            rebind value_option: Ast::Expr?, parser = parser.expression()
            parser.suppress_as_pattern <- false
            value: Ast::Expr = get value_option else return (Ast::Stmt.Invalid)
            parser, _ <- parser.expect(TokenKind.As)
            rebind pattern: Ast::Pattern, parser = parser.parse_pattern()

            body: mutable darray[Ast::Stmt] = []
            has_block: bool = parser.peek() == TokenKind.Colon
            body, parser <- parser.parse_block() if has_block
            body.push((Ast::Stmt.Expr((Ast::Expr.Invalid), expect_token.line))) if body.count == 0

            arms: mutable darray[Ast::MatchArm] = [Ast::MatchArm{pattern: pattern, body: body, guard: (Ast::Expr.Absent)}]
            panic_body: darray[Ast::Stmt] = [parser.expect_pattern_failure_stmt(expect_token.line)]
            arms.push(Ast::MatchArm{pattern: (Ast::Pattern.Wildcard), body: panic_body, guard: (Ast::Expr.Absent)})
            expect_match: Ast::Stmt = (Ast::Stmt.Match(value, arms, expect_token.line))
            if has_block:
                return expect_match
            else:
                expect_lowered: mutable darray[Ast::Stmt] = [expect_match]
                bindings: mutable darray[sview] = []
                pattern_binding_names(pattern, bindings)
                for binding_name in bindings |expect_lowered|:
                    expect_lowered.push((Ast::Stmt.VarDecl(binding_name, (Ast::Expr.Invalid), (Ast::Expr.Absent), expect_token.line)))
                return (Ast::Stmt.Block("expect", [], "", expect_lowered, expect_token.line))


        # A statement whose prefix clause is not yet modeled but which introduces a
        # `:`-block (e.g. `can Mem.Allocate:`, `region scratch:`, `try:`). Skip the
        # prefix tokens up to a paren-balanced top-level `:`, then parse the block.
        # A prefix with no block (e.g. `region scratch(1024)`) is malformed. Do not
        # silently degrade it to an empty statement: the stage0 parser rejects the
        # construct and silently dropping it makes a typo disappear from the AST.
        # `static if/elif/else COND:` in STATEMENT position. Same capture discipline as the
        # declaration-level form (parser_decl.elisa): the condition and branch kind land in
        # the file-wide static_if side tables keyed by the `static` token's line, and the
        # node keeps the ordinary `Stmt.Block("static", ...)` shape -- the three semantic
        # passes that skip `kind == "static"` blocks keep working unchanged, and the backend
        # pairs body with condition through the line.
        def static_if_block_statement(parser: lmut Parser) -> Ast::Stmt?:
            head: Token = parser.cursor()                            # `static`
            parser, _ <- parser.advance()
            is_chain_head: bool = parser.peek() == TokenKind.If
            matched_head: bool = parser.peek() == TokenKind.If or parser.peek() == TokenKind.Elif
            parser <- parser.advance_if(matched_head)                # `if` / `elif`
            parser <- parser.capture_static_if_condition(head.line, is_chain_head) if matched_head
            parser <- parser.record_static_else(head.line) if not matched_head
            parser <- parser.accept_if(TokenKind.Else, not matched_head)
            rebind body: darray[Ast::Stmt], parser = parser.parse_block()
            empty_clause: darray[sview] = []
            return (Ast::Stmt.Block("static", empty_clause, "", body, head.line))


        def prefixed_block_statement(parser: lmut Parser) -> Ast::Stmt?:
            line: u32 = parser.cursor().line

            # Classify the clause category from the leading token so region/effect
            # passes can dispatch structurally. Keyword-token prefixes map to their
            # spelling; contextual-keyword prefixes (`can`, `region`, …) are Idents
            # and carry their text directly; a bare `slot:` success arm is "arm".
            first_kind: TokenKind = parser.peek()
            first_token: Token = parser.cursor()
            is_arm: bool = first_kind == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon and parser.peek_at(2) == TokenKind.Newline
            # `region NAME(...)`: register NAME so type-position uses of the region
            # (`Box[i64, scratch]`, `@scratch` bindings) resolve.
            is_region_block: bool = first_kind == TokenKind.Ident and Lexer::text_or_empty(first_token, parser.source) == "region" and parser.peek_at(1) == TokenKind.Ident
            region_named_token: Token = parser.tokens[parser.position + 1] if is_region_block else first_token
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: Lexer::text_or_empty(region_named_token, parser.source), name: "__region_name", line: line}) if is_region_block
            # is_arm requires Ident, so the arm guard lives inside the Ident arm.
            block_kind: sview = match first_kind:
                TokenKind.With:    "with"
                TokenKind.Region:  "region"
                TokenKind.Try:     "try"
                TokenKind.Catch:   "catch"
                TokenKind.In:      "in"
                TokenKind.Error:   "error"
                TokenKind.Static:  "static"
                TokenKind.Ident:   "arm" if is_arm else Lexer::text_or_empty(first_token, parser.source)
                _:                 ""

            # Capture the name a binding-introducing prefix brings into scope:
            # `error IDENT:` binds the error value; a success arm `IDENT:` binds the
            # result. Everything else binds nothing.
            binding: mutable sview = ""
            match first_kind:
                TokenKind.Error:
                    parser, _ <- parser.advance()                       # `error`
                    if parser.peek() == TokenKind.Ident:
                        error_token: Token = parser.cursor()
                        binding <- Lexer::text_or_empty(error_token, parser.source)
                _:
                    binding <- Lexer::text_or_empty(first_token, parser.source) if is_arm

            # Collect the prefix's identifier tokens (in order) up to the block colon:
            # granted effect names (`can Mem.Allocate:`) or a region name
            # (`region scratch(…):`). The leading clause keyword and the arm binding are
            # already captured above, so skip identifiers at position 0.
            clause: mutable darray[sview] = []
            region_capacity_start: mutable usize = 0
            pool_capacity_start: mutable usize = 0
            while parser.peek() != TokenKind.Eof |parser, depth: int = 0, first: bool = true|:
                kind: TokenKind = parser.peek()
                match kind:
                    TokenKind.LParen | TokenKind.LBracket:
                        region_capacity_start <- parser.cursor().start.usize() + 1 if block_kind == "region" and kind == TokenKind.LParen and depth == 0
                        pool_capacity_start <- parser.cursor().start.usize() + 1 if (block_kind == "pool" or block_kind == "nursery") and kind == TokenKind.LParen and depth == 0
                        depth <- depth + 1
                        parser, _ <- parser.advance()
                    TokenKind.RParen | TokenKind.RBracket:
                        if block_kind == "region" and kind == TokenKind.RParen and depth == 1 and region_capacity_start > 0:
                            capacity_end: usize = parser.cursor().start.usize()
                            clause.push(parser.span_view(region_capacity_start, capacity_end))
                            region_capacity_start <- 0
                        if (block_kind == "pool" or block_kind == "nursery") and kind == TokenKind.RParen and depth == 1 and pool_capacity_start > 0:
                            pool_capacity_end: usize = parser.cursor().start.usize()
                            clause.push(parser.span_view(pool_capacity_start, pool_capacity_end))
                            pool_capacity_start <- 0
                        depth <- depth - 1
                        parser, _ <- parser.advance()
                    TokenKind.Colon | TokenKind.Newline if depth == 0:
                        break
                    TokenKind.As if depth == 0 and (block_kind == "can" or block_kind == "lock" or block_kind == "with"):
                        # `can Effects as Family:` records the effect-family cast
                        # target; `lock mutex as guard:` records the guard binding;
                        # `with arena scratch(N) as owner:` binds the resource handle.
                        parser, _ <- parser.advance()
                        rebind binding_token: Token, parser = parser.expect(TokenKind.Ident)
                        binding <- Lexer::text_or_empty(binding_token, parser.source)
                    TokenKind.Ident if depth == 0 and not first:
                        # Preserve region's contextual `using` marker separately so the
                        # clause side-table retains allocator intent; qualified effect
                        # paths remain one entry.
                        clause_token: Token = parser.cursor()
                        if block_kind == "region" and Lexer::text_or_empty(clause_token, parser.source) == "using":
                            clause.push("using")
                            parser, _ <- parser.advance()
                        else:
                            rebind dotted_clause_name: sview, parser = parser.parse_dotted_name()
                            clause.push(dotted_clause_name)
                            # `pool workers(N):` binds the named pool handle in its
                            # body. Preserve it in the generic block binding slot.
                            binding <- dotted_clause_name if block_kind == "pool" and binding == ""
                    _:
                        first <- false
                        parser, _ <- parser.advance()

            if parser.peek() != TokenKind.Colon:
                # Region declarations are the only currently recognized prefix whose
                # no-block form is unambiguously invalid at this frontend layer. Keep
                # legacy recovery for other keyword-shaped expression forms until their
                # dedicated AST nodes are ported.
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, first_token) if block_kind == "region"
                # Keep the existing recovery node shape after recording the error;
                # downstream walkers already treat this expression as non-executable.
                return (Ast::Stmt.Expr((Ast::Expr.Invalid), line))

            pool_scope: bool = block_kind == "pool" or block_kind == "nursery"
            parser.active_pool_depth <- parser.active_pool_depth + 1 if pool_scope
            parser.local_region_annotations <- parser.local_region_annotations.push(Ast::LocalRegionAnnotation{name: "__region_local", type_expression: (Ast::Expr.Invalid), region: clause[0], line: line}) if block_kind == "region" and clause.count > 0
            # A `can ComplexFlow:` grant exempts every block-`if` in its body (transitively)
            # from the flow-strict census. OR into the flag so nested non-ComplexFlow blocks
            # keep the exemption; restore afterwards.
            is_complex_flow: bool = block_kind == "can" and any grant in clause where grant == "ComplexFlow"
            saved_complex_flow: bool = parser.in_complex_flow
            parser.in_complex_flow <- parser.in_complex_flow or is_complex_flow
            rebind body: darray[Ast::Stmt], parser = parser.parse_block()
            parser.in_complex_flow <- saved_complex_flow
            parser.active_pool_depth <- parser.active_pool_depth - 1 if pool_scope
            return (Ast::Stmt.Block(block_kind, clause, binding, body, line))


        # docs/125 §6b: whether a statement-position block `if` is a sanctioned conditional
        # COMPUTATION (a guard), not a hidden decision, so the flow-strict census exempts it.
        # Mirrors stage0's condContainsIsTest + isLegitimateGuardBlock (the common, decidable
        # subset): an `is`-test condition (checked destructure), a branch that binds a local,
        # a single loop/match body, a multi-statement branch, or uneven if/else alternation.
        # An elif chain (else is a lone `if`) is a decision TABLE and stays flagged.
        def block_if_is_exempt(condition: Ast::Expr, then_body: darray[Ast::Stmt], else_body: darray[Ast::Stmt]) -> bool:
            can Memory.Allocate, Abort.Panic:
                true return if expr_contains_is_test(condition)
                # An elif chain (else is a lone `if`) is a decision TABLE — stays flagged.
                false return if else_body.count == 1 and first_stmt_is_if(else_body)
                true return if body_binds_local(then_body) or body_binds_local(else_body)
                # Single loop/match body (no else): a computation / sanctioned decision form.
                true return if else_body.count == 0 and then_body.count == 1 and stmt_is_loop_or_match(then_body[0])
                # Straight-line multi-effect guard, or if/else with a 2+-statement branch.
                true return if else_body.count == 0 and then_body.count >= 2
                true return if else_body.count > 0 and (then_body.count >= 2 or else_body.count >= 2)
                return false

        # Whether the branch's first statement is a block `if` (used to detect an elif chain).
        def first_stmt_is_if(body: darray[Ast::Stmt]) -> bool:
            can Abort.Panic:
                return match body[0]:
                    Ast::Stmt.If(if_cond, if_then, if_else, if_line): true
                    _: false

        # Whether a statement is a loop or a match (the guarded-computation exemption).
        def stmt_is_loop_or_match(statement: Ast::Stmt) -> bool:
            can Abort.Panic:
                return match statement:
                    Ast::Stmt.While(w_cond, w_body, w_line): true
                    Ast::Stmt.For(f_bind, f_vars, f_iter, f_body, f_line): true
                    Ast::Stmt.Match(m_scrut, m_arms, m_line): true
                    _: false

        # Whether an `if` condition contains a top-level (or boolean-combined) `is` refinement
        # test — `if x is Foo:` / `if a and x is Foo:` — a checked destructure, not a decision.
        def expr_contains_is_test(condition: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match condition:
                    Ast::Expr.Binary(left, operator, right, line):
                        true return if operator == TokenKind.Is
                        return expr_contains_is_test(left) or expr_contains_is_test(right)
                    Ast::Expr.Unary(operator, operand, line):
                        return expr_contains_is_test(operand)
                    Ast::Expr.Paren(inner, line):
                        return expr_contains_is_test(inner)
                    _:
                        return false

        # Whether any statement in the branch binds a local (`x = …` / `x: T = …`).
        def stmt_is_vardecl(statement: Ast::Stmt) -> bool:
            can Abort.Panic:
                return match statement:
                    Ast::Stmt.VarDecl(name, type_expression, value, line): true
                    _: false

        def body_binds_local(body: darray[Ast::Stmt]) -> bool:
            can Memory.Allocate, Abort.Panic:
                return any statement in body where stmt_is_vardecl(statement)

        def if_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind if_token: Token, parser = parser.expect(TokenKind.If)
            rebind if_stmt_option: Ast::Stmt?, parser = parser.if_tail(if_token)
            # A statement-position block `if` (docs/125 §6b flow-strict target); postfix
            # guards / value-ifs never reach this parse path. Tag it for the flow-strict
            # census UNLESS it is inside a `can ComplexFlow:` grant (the escape hatch) or is a
            # sanctioned guard shape (binds a local, single loop/match, multi-statement, …).
            if if_stmt_option is if_stmt:
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__block_if", name: "__block_if", line: if_token.line}) if not parser.in_complex_flow
            return if_stmt_option


        # Shared tail for `if` and `elif`: parse `<condition> <block>` then an optional
        # `elif`/`else` continuation. An `elif` chain desugars into a nested If stored
        # as the single statement of the parent's else_body — no separate elif node.
        def if_tail(parser: lmut Parser, token: Token) -> Ast::Stmt?:
            # Optional branch-prediction hint `if likely COND:` / `if unlikely COND:`
            # (contextual idents, also valid on `elif`). Only consumed when an operand
            # follows, so a bool local literally named `likely` still works bare.
            hint_token: Token = parser.cursor()
            hint_kind: mutable sview = ""
            if parser.peek() == TokenKind.Ident:
                hint_text: sview = Lexer::text_or_empty(hint_token, parser.source)
                if (hint_text == "likely" or hint_text == "unlikely") and tokenStartsValue(parser.peek_at(1)):
                    hint_kind <- hint_text
                    parser, _ <- parser.advance()
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__branch_hint", name: hint_kind, line: token.line}) if hint_kind != ""
            rebind condition: Ast::Expr, parser = get parser.expression()
            rebind then_body: darray[Ast::Stmt], parser = parser.parse_block()

            else_body: mutable darray[Ast::Stmt] = []
            parser <- parser.skip_newlines()

            next_kind: TokenKind = parser.peek()
            match next_kind:
                TokenKind.Elif:
                    rebind elif_token: Token, parser = parser.advance()
                    # An `elif` chain desugars into a nested If as the single statement of the
                    # parent's else body.
                    rebind __m_264: Ast::Stmt?, parser = parser.if_tail(elif_token)
                    else_body.push(nested_if) if __m_264 is nested_if
                TokenKind.Else:
                    parser, _ <- parser.advance()
                    else_body, parser <- parser.parse_block()
                _:
                    pass

            return (Ast::Stmt.If(condition, then_body, else_body, token.line))


        def while_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind while_token: Token, parser = parser.expect(TokenKind.While)
            hint_token: Token = parser.cursor()
            hint_kind: mutable sview = ""
            has_hint: bool = parser.peek() == TokenKind.Ident and (Lexer::text_or_empty(hint_token, parser.source) == "likely" or Lexer::text_or_empty(hint_token, parser.source) == "unlikely") and tokenStartsValue(parser.peek_at(1))
            hint_kind <- Lexer::text_or_empty(hint_token, parser.source) if has_hint
            parser, _ <- parser.advance() if has_hint
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__branch_hint", name: hint_kind, line: while_token.line}) if has_hint
            # docs/119 §3: binary parsing stops at a header's opening `|` (loop_header_at),
            # so the ordinary condition parse already yields the pre-header expression.
            rebind condition: Ast::Expr, parser = get parser.expression()
            if not parser.loop_header_at():
                rebind body: darray[Ast::Stmt], parser = parser.parse_block()
                return (Ast::Stmt.While(condition, body, while_token.line))
            header_declarations: mutable darray[Ast::Stmt] = []
            header_captures: mutable darray[sview] = []
            header_has_yield: mutable bool = false
            rebind header_yield: Ast::Expr, parser = parser.parse_loop_header(header_declarations, header_captures, header_has_yield)
            rebind loop_body: darray[Ast::Stmt], parser = parser.parse_block()
            rebind __ret_285: Ast::Stmt, parser = parser.wrap_loop_header(header_declarations, header_yield, (Ast::Stmt.While(condition, loop_body, while_token.line)), while_token.line, header_captures)
            return __ret_285


        def return_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind return_token: Token, parser = parser.expect(TokenKind.Return)

            # `return if COND: THEN else: ELSE` is a value expression. Its leading tokens
            # overlap the postfix guard `return if COND`; a top-level colon before the
            # newline distinguishes the value form.
            rebind accepted_if: bool, parser = parser.accept(TokenKind.If)
            if accepted_if:
                rebind condition: Ast::Expr, parser = get parser.expression()
                if parser.peek() == TokenKind.Colon:
                    parser, _ <- parser.advance()
                    rebind then_value: Ast::Expr, parser = parser.parse_bare_block_value()
                    parser <- parser.skip_newlines()
                    parser, _ <- parser.expect(TokenKind.Else)
                    parser, _ <- parser.expect(TokenKind.Colon)
                    rebind else_value: Ast::Expr, parser = parser.parse_bare_block_value()
                    conditional: Ast::Expr = (Ast::Expr.If(condition, then_value, else_value, return_token.line))
                    return (Ast::Stmt.Return(conditional, return_token.line))
                # No colon: bare postfix guard `return if COND` (== `if COND: return`).
                body: mutable darray[Ast::Stmt] = []
                body.push((Ast::Stmt.Return(null, return_token.line)))
                no_else: darray[Ast::Stmt] = []
                return (Ast::Stmt.If(condition, body, no_else, return_token.line))
            else:
                value: mutable Ast::Expr? = null
                value_start: usize = parser.position
                parser, value <- parser.expression() if parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Eof
                if value is value_present:
                    parser, _ <- parser.consume_removed_as_cast(value_present)

                # Multi-value return `return a, b` (a named-tuple result type's value
                # list) — collect the remaining values into a Tuple.
                if parser.peek() == TokenKind.Comma and value is first_value:
                    return_elements: mutable darray[Ast::Expr] = [first_value]
                    while parser.accept(TokenKind.Comma) |parser|:
                        break if parser.peek() == TokenKind.Newline or parser.peek() == TokenKind.Eof
                        rebind return_element_option: Ast::Expr?, parser = parser.expression()
                        return_elements.push(return_element) if return_element_option is return_element
                    value <- (Ast::Expr.Tuple(return_elements, return_token.line))

                value_end: usize = parser.position
                parser <- parser.validate_declared_thread_return_tokens(value_start, value_end, return_token)

                # Trailing guard `return VALUE if COND` (== `if COND: return VALUE`).
                rebind accepted_if_2: bool, parser = parser.accept(TokenKind.If)
                if accepted_if_2:
                    rebind value_condition: Ast::Expr, parser = get parser.expression()
                    value_body: mutable darray[Ast::Stmt] = []
                    value_body.push((Ast::Stmt.Return(value, return_token.line)))
                    value_no_else: darray[Ast::Stmt] = []
                    return (Ast::Stmt.If(value_condition, value_body, value_no_else, return_token.line))
                else:
                    return (Ast::Stmt.Return(value, return_token.line))

        # A declared-threading return (`-> (ch: i64, lx: lmut L)`) must end with the
        # threaded slots, named in order. Everything BEFORE them is an ordinary value
        # expression: the old rule demanded the first element be a single identifier and
        # required exactly one leading value, so `return 1, lx` (a literal) and a
        # value-less `-> (lx: lmut L)` were both rejected -- forms stage0 accepts.
        def validate_declared_thread_return_tokens(parser: lmut Parser, start: mutable usize, end: mutable usize, token: Token) -> void:
            return if parser.declared_thread_slots.count == 0
            if end > start and parser.tokens[start].kind == TokenKind.LParen and parser.tokens[end - 1].kind == TokenKind.RParen:
                start <- start + 1
                end <- end - 1
            element_is_ident: mutable darray[bool] = []
            element_names: mutable darray[sview] = []
            segment_start: mutable usize = start
            scan: mutable usize = start
            depth: mutable int = 0
            while scan <= end |parser, scan, depth, segment_start, element_is_ident, element_names, start, end|:
                at_end: bool = scan == end
                kind: TokenKind = parser.tokens[scan].kind if not at_end else TokenKind.Comma
                depth <- depth + 1 if not at_end and (kind == TokenKind.LParen or kind == TokenKind.LBracket)
                depth <- depth - 1 if not at_end and (kind == TokenKind.RParen or kind == TokenKind.RBracket)
                is_separator: bool = at_end or (kind == TokenKind.Comma and depth == 0)
                if is_separator:
                    segment_length: usize = scan - segment_start
                    is_ident: bool = segment_length == 1 and parser.tokens[segment_start].kind == TokenKind.Ident
                    element_is_ident.push(is_ident)
                    element_names.push(Lexer::text_or_empty(parser.tokens[segment_start], parser.source) if is_ident else sview("", 0, 0))
                    segment_start <- scan + 1
                scan <- scan + 1
            slot_count: usize = parser.declared_thread_slots.count
            valid: mutable bool = element_is_ident.count >= slot_count
            if valid:
                lead: usize = element_is_ident.count - slot_count
                for slot_index in 0..<slot_count |valid, lead, element_is_ident, element_names, parser|:
                    valid <- false if not element_is_ident[lead + slot_index]
                    valid <- false if element_names[lead + slot_index] != parser.declared_thread_slots[slot_index]
            return if valid
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token)
