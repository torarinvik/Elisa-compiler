# Stage1 parser — the PARAMETER list of an extern signature: the scan that records each
# parameter, the rejection of a default value (an extern has no body to evaluate one in), and
# the skips that step over the rest of the line.
# Part of `module Parser` (see parser.elisa).

extend Parser:
    private:

        # Consume an extern's balanced parameter list while counting only top-level
        # `name:` entries. This deliberately leaves foreign/variadic type syntax opaque,
        # matching the old permissive skipper while retaining enough shape for arity.
        def scan_extern_params(parser: lmut Parser, arity: mutable u32&, variadic: mutable bool&) -> void:
            parser, _ <- parser.expect(TokenKind.LParen)
            depth: mutable int = 0
            param_name: mutable sview = ""
            type_name: mutable sview = ""
            protocol_state: mutable sview = ""
            element_type_name: mutable sview = ""
            generic_ident_count: mutable u32 = 0
            provenance: mutable bool = false
            after_colon: mutable bool = false
            mutable_ref: mutable bool = false
            fn_type_line: mutable u32 = 0
            fn_type_param_count: mutable u32 = 0
            while parser.peek() != TokenKind.Eof |parser, depth, arity, variadic, param_name, type_name, protocol_state, element_type_name, generic_ident_count, provenance, after_colon, mutable_ref, fn_type_line, fn_type_param_count|:
                current_token: Token = parser.cursor()
                kind: TokenKind = current_token.kind
                break if depth == 0 and kind == TokenKind.RParen
                is_param_head: bool = depth == 0 and kind == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon
                param_name <- Lexer::text_or_empty(current_token, parser.source) if is_param_head else param_name
                arity <- arity + 1 if is_param_head else arity
                after_colon <- true if is_param_head else after_colon
                is_type_head: bool = depth == 0 and after_colon and kind == TokenKind.Ident and type_name == "" and parser.peek_at(1) != TokenKind.Colon
                type_name <- Lexer::text_or_empty(current_token, parser.source) if is_type_head else type_name
                # `extern f(r: M::Rec&)` -- the head is the segment after the LAST `::`,
                # not the module. Structs are registered under their BARE name with the
                # module as owner, so capturing `M` found no struct, the parameter fell
                # back to `void&`, and every call site declined because a real struct
                # cannot coerce into it. Clearing the head lets the next segment take it.
                type_name <- "" if is_type_head and parser.peek_at(1) == TokenKind.Scope
                # Most extern types remain intentionally opaque, but a function-valued
                # parameter is a real Elisa type whose nested ABI must survive the compact
                # extern side table. Parse just this shape with the ordinary type-context
                # expression parser, then let the scanner resume at its comma or closing `)`.
                is_function_type_head: bool = depth == 0 and after_colon and kind == TokenKind.Ident and type_name == "fn" and fn_type_line == 0
                if is_function_type_head:
                    previous_type_context: bool = parser.in_type_annotation
                    parser.in_type_annotation <- true
                    rebind parsed_function_type: Ast::Expr?, parser = parser.expression()
                    parser.in_type_annotation <- previous_type_context
                    if parsed_function_type is parsed_fn_type:
                        match parsed_fn_type:
                            Expr.Lambda(parsed_fn_params, _, _):
                                fn_type_line <- current_token.line
                                fn_type_param_count <- parsed_fn_params.count.u32()
                            _:
                                pass
                        if fn_type_line != 0:
                            retained_function_type: sview = "fn"
                            if parser.peek() == TokenKind.Comma:
                                parser.extern_params <- parser.extern_params.push(Ast::ExternParam{name: param_name, type_name: retained_function_type, element_type_name: "", provenance_bearing: provenance, mutable_ref: mutable_ref, fn_type_line: fn_type_line, fn_type_param_count: fn_type_param_count})
                                param_name <- ""
                                type_name <- ""
                                protocol_state <- ""
                                element_type_name <- ""
                                generic_ident_count <- 0
                                provenance <- false
                                mutable_ref <- false
                                fn_type_line <- 0
                                fn_type_param_count <- 0
                                after_colon <- false
                                parser, _ <- parser.advance()
                                continue
                            if parser.peek() == TokenKind.RParen:
                                break
                is_generic_ident: bool = depth == 1 and after_colon and kind == TokenKind.Ident
                generic_ident_count <- generic_ident_count + 1 if is_generic_ident else generic_ident_count
                # Retain the first application argument (`view[T]`, `darray[T]`, …).
                # The old compact record kept only the head, so an extern `view[i32]`
                # was indistinguishable from an unsupported bare `view`.
                element_type_name <- Lexer::text_or_empty(current_token, parser.source) if is_generic_ident and generic_ident_count == 1
                protocol_state <- Lexer::text_or_empty(current_token, parser.source) if is_generic_ident and generic_ident_count == 2 else protocol_state
                provenance <- true if after_colon and (kind == TokenKind.Ampersand or kind == TokenKind.Lmut)
                # A `mutable`/`lmut` marker anywhere in the param makes it a mutable binding.
                mutable_ref <- true if depth == 0 and (kind == TokenKind.Mutable or kind == TokenKind.Lmut)
                variadic <- true if depth == 0 and kind == TokenKind.Ellipsis
                finishes_param: bool = depth == 0 and kind == TokenKind.Comma and param_name != ""
                retained_type: sview = protocol_state if protocol_state != "" and (type_name == "Thread" or type_name == "Task") else type_name
                parser.extern_params <- parser.extern_params.push(Ast::ExternParam{name: param_name, type_name: retained_type, element_type_name: element_type_name, provenance_bearing: provenance, mutable_ref: mutable_ref, fn_type_line: fn_type_line, fn_type_param_count: fn_type_param_count}) if finishes_param
                param_name <- "" if finishes_param else param_name
                type_name <- "" if finishes_param else type_name
                protocol_state <- "" if finishes_param else protocol_state
                element_type_name <- "" if finishes_param else element_type_name
                generic_ident_count <- 0 if finishes_param else generic_ident_count
                provenance <- false if finishes_param else provenance
                mutable_ref <- false if finishes_param else mutable_ref
                fn_type_line <- 0 if finishes_param
                fn_type_param_count <- 0 if finishes_param
                after_colon <- false if finishes_param else after_colon
                depth <- depth + 1 if kind == TokenKind.LParen or kind == TokenKind.LBracket
                depth <- depth - 1 if kind == TokenKind.RParen or kind == TokenKind.RBracket
                parser, _ <- parser.advance()
            retained_type: sview = protocol_state if protocol_state != "" and (type_name == "Thread" or type_name == "Task") else type_name
            parser.extern_params <- parser.extern_params.push(Ast::ExternParam{name: param_name, type_name: retained_type, element_type_name: element_type_name, provenance_bearing: provenance, mutable_ref: mutable_ref, fn_type_line: fn_type_line, fn_type_param_count: fn_type_param_count}) if param_name != ""
            parser, _ <- parser.expect(TokenKind.RParen)



        def reject_extern_param_defaults(parser: lmut Parser) -> void:
            return if parser.peek() != TokenKind.LParen
            saved_position: usize = parser.position
            parser.position <- parser.position + 1
            machine over parser.position while true:
                state Scan(depth: int)
                start Scan(1)

                Scan(depth), _ if depth <= 0 or parser.peek() == TokenKind.Eof:
                    break

                Scan(1), _ if parser.peek() == TokenKind.Assign:
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, parser.cursor())
                    parser.position <- parser.position + 1
                    -> Scan(1)

                Scan(depth), _ if parser.peek() == TokenKind.LParen:
                    parser.position <- parser.position + 1
                    -> Scan(depth + 1)

                Scan(depth), _ if parser.peek() == TokenKind.RParen:
                    parser.position <- parser.position + 1
                    -> Scan(depth - 1)

                Scan(depth), _:
                    parser.position <- parser.position + 1
                    -> Scan(depth)
            parser.position <- saved_position



        # `extern:`/`export:` indented block, entered with the cursor on the opening `:`.
        def parse_extern_trailing_block(parser: lmut Parser) -> void:
            parser, _ <- parser.advance()               # `:`
            parser <- parser.skip_indented_block()



        # Consume the remainder of a single-line extern (the `: T`), stopping before
        # the newline/dedent/eof.
        def skip_extern_line_remainder(parser: lmut Parser) -> void:
            machine over parser.position while parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof:
                state Skip
                start Skip

                Skip, _:
                    parser.position <- parser.position + 1
                    -> Skip
