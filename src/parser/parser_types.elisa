# Stage1 parser — declaration parsing, part 2 (`extend Parser:`). Covers error-type,
# extern, func, struct, and enum/const declarations (private), plus the public
# `parse_file` region-polymorphic entry point. Continues from parser_decl.elisa. Split
# out of parser.elisa to keep each part file under 600 lines.

extend Parser:
    private:
        # `error Name:` is a closed tagged family. Reuse the enum variant shape so
        # payload constructors retain arity/names and semantic resolution can inspect
        # `raise Family.Tag(...)` instead of treating the family as opaque.
        def error_type_declaration(parser: lmut Parser) -> Ast::Decl?:
            rebind token: Token, parser = parser.expect(TokenKind.Error)
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            parser <- parser.skip_declaration_header_clauses()
            variants: mutable darray[Ast::EnumVariant] = []
            variants, parser <- parser.enum_variant_block() if parser.peek() == TokenKind.Colon and parser.peek_at(1) == TokenKind.Newline
            return (Ast::Decl.Enum(Lexer::text_or_empty(name_token, parser.source), variants, false, (Ast::Expr.Absent), token.line))

        # Consume the `:` NEWLINE INDENT ... DEDENT body of an `error Name:` declaration,
        # entered with the cursor on the opening `:`. The body's contents aren't modeled.
        def skip_error_type_body(parser: lmut Parser) -> void:
            parser, _ <- parser.advance()          # `:`
            parser, _ <- parser.expect(TokenKind.Newline)
            rebind accepted_indent: bool, parser = parser.accept(TokenKind.Indent)
            parser <- parser.skip_to_matching_dedent() if accepted_indent

        # Depth-tracked skip of an already-opened Indent/Dedent block, entered with the
        # cursor just past the opening `Indent` (loop-local `depth` seeded to that one
        # open indent). Shared by the handful of not-yet-modeled block clauses below.
        def skip_to_matching_dedent(parser: lmut Parser) -> void:
            while depth > 0 and parser.peek() != TokenKind.Eof |parser, depth: int = 1|:
                rebind advanced_token: Token, parser = parser.advance()
                kind: TokenKind = advanced_token.kind
                depth <- match kind:
                    TokenKind.Indent: depth + 1
                    TokenKind.Dedent: depth - 1
                    _: depth

        # Depth-tracked skip of an already-opened `[...]` group, entered with the cursor
        # just past the opening `[`. Shared by generic/region param lists and inline
        # `can[...]` effect clauses.
        def skip_bracketed_group(parser: lmut Parser) -> void:
            while depth > 0 and parser.peek() != TokenKind.Eof |parser, depth: int = 1|:
                rebind advanced_token: Token, parser = parser.advance()
                kind: TokenKind = advanced_token.kind
                depth <- match kind:
                    TokenKind.LBracket: depth + 1
                    TokenKind.RBracket: depth - 1
                    _: depth

        # Advance the cursor when COND holds, discarding the consumed token. A guarded
        # tuple-assign (`parser, _ <- parser.advance() if cond`) does not parse (the
        # `if` is taken as a ternary demanding `else`), so the guard is routed through
        # this helper's bare exit guard instead. Named distinctly from parser_decl.elisa's
        # `advance_if` (same idiom, different file) to avoid a cross-file duplicate
        # declaration — `extend Parser: private:` members share one flat namespace.
        def advance_when(parser: lmut Parser, cond: bool) -> void:
            return if not cond
            parser, _ <- parser.advance()

        # Consume (and discard) one expression when COND holds. Same tuple-guard-if
        # parse gotcha as `advance_when` above.
        def expression_when(parser: lmut Parser, cond: bool) -> void:
            return if not cond
            parser, _ <- parser.expression()

        # Accept a specific token kind (discarding whether it matched) when COND holds.
        # Same tuple-guard-if parse gotcha as `advance_when` above.
        def accept_when(parser: lmut Parser, kind: TokenKind, cond: bool) -> void:
            return if not cond
            parser, _ <- parser.accept(kind)


        # `extern <signature>` / `extern <Name>` (FFI import or opaque type) and
        # `export fn name -> target` / `extern:`/`export:` blocks. Their internals
        # aren't modeled yet; consume the declaration line (and any indented block) so
        # the surrounding module parses. Recorded as an Invalid declaration node.
        def extern_declaration(parser: lmut Parser) -> Ast::Decl?:
            rebind token: Token, parser = parser.advance()              # `extern` / `export`
            is_export: bool = Lexer::text_or_empty(token, parser.source) == "export"
            is_export_global: bool = is_export and parser.peek() == TokenKind.Global
            export_head: Token = parser.cursor()
            is_export_type: bool = is_export and parser.peek() == TokenKind.Ident and Lexer::text_or_empty(export_head, parser.source) == "type"
            # Threading both the parsed `Ast::Decl` and the advanced `parser` out of a
            # two-real-branch ternary (`A() if cond else B()`) isn't reliable here, so
            # each branch is routed through a dedicated single-call out-param helper
            # instead (guarded single-target reassigns, like `advance_when` elsewhere).
            decl: mutable Ast::Decl = (Ast::Decl.Invalid)
            parser <- parser.capture_export_global_decl(token, decl) if is_export_global
            parser <- parser.capture_export_type_decl(token, decl) if is_export_type
            parser <- parser.capture_extern_signature_decl(token, decl) if not is_export_global and not is_export_type
            return decl

        def capture_export_type_decl(parser: lmut Parser, token: Token, decl: mutable Ast::Decl&) -> void:
            parser, _ <- parser.advance()
            target_token: Token = parser.cursor()
            target_name: sview = Lexer::text_or_empty(target_token, parser.source) if parser.peek() == TokenKind.Ident else ""
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: target_name, name: "__export_type", line: token.line}) if target_name != ""
            parser <- parser.skip_extern_line_remainder()
            decl <- (Ast::Decl.Extern(target_name, parser.extern_params.count.u32(), 0, false, false, "", parser.pending_decorators, token.line))

        # `is_export_global` branch of `extern_declaration`, isolated to a single real
        # call so the caller's guarded reassign threads `parser` cleanly.
        def capture_export_global_decl(parser: lmut Parser, token: Token, decl: mutable Ast::Decl&) -> void:
            rebind parsed: Ast::Decl, parser = parser.parse_export_global_extern(token)
            decl <- parsed

        # The non-`export global` branch of `extern_declaration`. Same single-call
        # isolation as `capture_export_global_decl` above.
        def capture_extern_signature_decl(parser: lmut Parser, token: Token, decl: mutable Ast::Decl&) -> void:
            rebind parsed: Ast::Decl, parser = parser.parse_extern_signature_and_body(token)
            decl <- parsed

        # `export global Mod::name [as alias]`: record the public alias when present,
        # otherwise the final target segment. The full target is stage0's concern;
        # stage1 only needs one symbol name.
        def parse_export_global_extern(parser: lmut Parser, token: Token) -> Ast::Decl:
            parser, _ <- parser.advance()               # `global`
            exported_name: mutable sview = ""
            target_name: mutable sview = ""
            while parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser, exported_name|:
                is_alias: bool = parser.peek() == TokenKind.As and parser.peek_at(1) == TokenKind.Ident
                is_plain_ident: bool = not is_alias and parser.peek() == TokenKind.Ident
                parser <- parser.capture_export_alias(exported_name) if is_alias
                parser <- parser.capture_export_part(exported_name) if is_plain_ident
                target_name <- exported_name if is_plain_ident else target_name
                parser <- parser.advance_when(not is_alias and not is_plain_ident)
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: target_name, name: "__export_global", line: token.line}) if target_name != ""
            return (Ast::Decl.Extern(exported_name, parser.extern_params.count.u32(), 0, false, false, "", parser.pending_decorators, token.line))

        # `as alias` — consume the `as` and record the alias identifier's text.
        def capture_export_alias(parser: lmut Parser, exported_name: mutable sview&) -> void:
            parser, _ <- parser.advance()               # `as`
            rebind alias_token: Token, parser = parser.advance()
            exported_name <- Lexer::text_or_empty(alias_token, parser.source)

        # A bare `Mod::name` path segment — consume it and record its text (later
        # segments overwrite earlier ones, matching "the final target segment").
        def capture_export_part(parser: lmut Parser, exported_name: mutable sview&) -> void:
            rebind part_token: Token, parser = parser.advance()
            exported_name <- Lexer::text_or_empty(part_token, parser.source)

        # The non-`export global` extern forms: `export fn NAME …` / `export def NAME …`
        # / typed `extern name: T` / `extern:`/`export:` blocks.
        def parse_extern_signature_and_body(parser: lmut Parser, token: Token) -> Ast::Decl:
            # `export fn NAME …` / `export def NAME …`: skip the leading func/def word
            # so the captured name is the exported symbol, not the keyword.
            parser, _ <- parser.accept(TokenKind.Def)
            parser <- parser.skip_export_func_word() if parser.peek() == TokenKind.Ident
            # The external name is the first identifier; record it so it becomes a symbol.
            name_cursor: Token = parser.cursor()
            is_name_ident: bool = parser.peek() == TokenKind.Ident
            name: mutable sview = Lexer::text_or_empty(name_cursor, parser.source) if is_name_ident else ""
            parser <- parser.advance_when(is_name_ident)
            rebind accepted_generic_header: bool, parser = parser.accept(TokenKind.LBracket)
            parser <- parser.skip_bracketed_group() if accepted_generic_header
            error_family: sview = parser.header_error_family()
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__error_return", line: token.line}) if error_family != ""
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: error_family, line: token.line}) if error_family != ""
            parser <- parser.capture_header_error_families(token.line) if error_family != ""
            is_export_signature: bool = Lexer::text_or_empty(token, parser.source) == "export"
            has_fixed_array_boundary: bool = is_export_signature and parser.header_has_fixed_array_type()
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__export_array", line: token.line}) if has_fixed_array_boundary
            has_params: bool = parser.peek() == TokenKind.LParen
            parser <- parser.reject_extern_param_defaults() if is_export_signature and has_params
            arity: mutable u32 = 0
            variadic: mutable bool = false
            param_start: u32 = parser.extern_params.count.u32()
            parser <- parser.scan_extern_params(arity, variadic) if has_params
            extern_return_type: sview = parser.extern_return_type_head()
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_return", name: extern_return_type, line: token.line}) if extern_return_type != ""
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_return_ptr", name: name, line: token.line}) if extern_return_type != "" and parser.extern_return_is_pointer()
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__extern_effect", line: token.line}) if parser.header_has_signature_can()
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__extern_segment_owner", line: token.line}) if parser.header_grants_segment_owner()
            parser <- parser.record_extern_segment_flow(name, token.line) if name != ""
            extern_shape: sview = parser.extern_return_darray_shape()
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_return_shape", name: extern_shape, line: token.line}) if extern_shape != ""
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_return_shape_fn", name: name, line: token.line}) if extern_shape != ""
            extern_effect_ref: sview = parser.header_signature_can_ref()
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_effect_ref", name: extern_effect_ref, line: token.line}) if extern_effect_ref != ""
            # Retain the export-vs-extern distinction and the `= TARGET` re-export target on
            # the side-table (the node signature drops both), so semantic can validate
            # duplicate export names and undefined re-export targets.
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__export_fn", line: token.line}) if is_export_signature and name != ""
            parser <- parser.capture_export_reexport_target(token.line) if is_export_signature
            parser <- parser.skip_declaration_header_clauses()          # to the block colon or end of line
            # Only `extern:` / `export:` followed by a newline opens an indented block;
            # a typed `extern name: T` stops at the colon (skip the rest of the line).
            has_trailing_block: bool = parser.peek() == TokenKind.Colon and parser.peek_at(1) == TokenKind.Newline
            parser <- parser.parse_extern_trailing_block() if has_trailing_block
            # Typed `extern name: T` (or any single-line extern): consume the remainder
            # of the line (the `: T`) so it isn't reparsed.
            parser <- parser.skip_extern_line_remainder() if not has_trailing_block
            return (Ast::Decl.Extern(name, param_start, arity, variadic, has_params, extern_return_type, parser.pending_decorators, token.line))


        def extern_return_type_head(parser: Parser&) -> sview:
            can Abort.Panic:
                "" return if parser.peek() != TokenKind.Arrow
                while parser.peek_at(scan) not in {TokenKind.Newline, TokenKind.Eof, TokenKind.Colon} |scan: usize = 1|:
                    token: Token = parser.tokens[parser.position + scan]
                    Lexer::text_or_empty(token, parser.source) return if token.kind == TokenKind.Ident
                    scan <- scan + 1
                return ""

        # Whether the `-> T` clause names a POINTER return (`T&`, including the
        # `heap T&` / `mutable heap T&?` forms). The `return_type_name` side table
        # keeps only the bare head name — exactly as `ExternParam.type_name` drops a
        # param's `&` — so without this an `extern malloc(n: usize) -> mutable heap
        # void&?` lowers to a `void` return instead of a `ptr`, and every FFI
        # allocator is undeclarable. Mirrors `ExternParam.provenance_bearing`, but
        # for the return.
        def extern_return_is_pointer(parser: Parser&) -> bool:
            can Abort.Panic:
                false return if parser.peek() != TokenKind.Arrow
                while parser.peek_at(scan) not in {TokenKind.Newline, TokenKind.Eof, TokenKind.Colon} |scan: usize = 1|:
                    true return if parser.peek_at(scan) == TokenKind.Ampersand
                    scan <- scan + 1
                return false

        # The extern return type's darray SHAPE argument ("shape_out" from
        # `-> darray[i32, shape_out]`), or "" when the return is not a
        # two-argument darray. Fresh-shape provenance (docs/86-style shape pairs)
        # needs it to seed instance counters for extern producers.
        def extern_return_darray_shape(parser: Parser&) -> sview:
            can Abort.Panic:
                "" return if parser.peek() != TokenKind.Arrow
                while parser.peek_at(scan) not in {TokenKind.Newline, TokenKind.Eof, TokenKind.Colon} |scan: usize = 1|:
                    token: Token = parser.tokens[parser.position + scan]
                    if token.kind == TokenKind.Ident and Lexer::text_or_empty(token, parser.source) == "darray" and parser.peek_at(scan + 1) == TokenKind.LBracket and parser.peek_at(scan + 2) == TokenKind.Ident and parser.peek_at(scan + 3) == TokenKind.Comma and parser.peek_at(scan + 4) == TokenKind.Ident:
                        candidate_shape: sview = Lexer::text_or_empty(parser.tokens[parser.position + scan + 4], parser.source)
                        # Shape-preserving externs name the SAME shape in a parameter;
                        # only a return-exclusive shape marks a fresh producer.
                        param_scan: mutable usize = 0
                        while param_scan < scan |param_scan|:
                            param_token: Token = parser.tokens[parser.position + param_scan]
                            "" return if param_token.kind == TokenKind.Ident and Lexer::text_or_empty(param_token, parser.source) == candidate_shape
                            param_scan <- param_scan + 1
                        return candidate_shape
                    scan <- scan + 1
                return ""

        def header_has_signature_can(parser: Parser&) -> bool:
            can Abort.Panic:
                while parser.peek_at(scan) not in {TokenKind.Newline, TokenKind.Eof} |scan: usize = 0|:
                    token: Token = parser.tokens[parser.position + scan]
                    true return if token.kind == TokenKind.Ident and Lexer::text_or_empty(token, parser.source) == "can" and parser.peek_at(scan + 1) == TokenKind.LBracket
                    scan <- scan + 1
                return false

        # Whether the signature header's `can[...]` grants a segment-transition owner: it
        # establishes an owner only when it contains BOTH `Unsafe.SegmentMutation` AND one of
        # `Segment.Guest` / `Segment.Host` (mirrors stage0 permissionRefsTransitionOwner). Such an
        # extern needs an explicit @segment_transition so the owner is a typed contract.
        def header_grants_segment_owner(parser: Parser&) -> bool:
            can Abort.Panic:
                has_mutation: mutable bool = false
                has_owner: mutable bool = false
                while parser.peek_at(scan) not in {TokenKind.Newline, TokenKind.Eof} |scan: usize = 0, has_mutation, has_owner|:
                    token: Token = parser.tokens[parser.position + scan]
                    if token.kind == TokenKind.Ident and parser.peek_at(scan + 1) == TokenKind.Dot and parser.peek_at(scan + 2) == TokenKind.Ident:
                        head_text: sview = Lexer::text_or_empty(token, parser.source)
                        member_text: sview = Lexer::text_or_empty(parser.tokens[parser.position + scan + 2], parser.source)
                        has_mutation <- true if head_text == "Unsafe" and member_text == "SegmentMutation"
                        has_owner <- true if head_text == "Segment" and (member_text == "Guest" or member_text == "Host")
                    scan <- scan + 1
                return has_mutation and has_owner

        # The specific `Segment.Host` / `Segment.Guest` member named in the signature
        # `can[...]` ("Host"/"Guest"), or "" when none. Used to derive both the
        # transition owner (with Unsafe.SegmentMutation) and a plain required owner.
        def header_segment_owner_member(parser: Parser&) -> sview:
            can Abort.Panic:
                while parser.peek_at(scan) not in {TokenKind.Newline, TokenKind.Eof} |scan: usize = 0|:
                    token: Token = parser.tokens[parser.position + scan]
                    if token.kind == TokenKind.Ident and parser.peek_at(scan + 1) == TokenKind.Dot and parser.peek_at(scan + 2) == TokenKind.Ident:
                        head_text: sview = Lexer::text_or_empty(token, parser.source)
                        member_text: sview = Lexer::text_or_empty(parser.tokens[parser.position + scan + 2], parser.source)
                        member_text return if head_text == "Segment" and (member_text == "Host" or member_text == "Guest")
                    scan <- scan + 1
                return ""

        def header_has_segment_mutation(parser: Parser&) -> bool:
            can Abort.Panic:
                while parser.peek_at(scan) not in {TokenKind.Newline, TokenKind.Eof} |scan: usize = 0|:
                    token: Token = parser.tokens[parser.position + scan]
                    if token.kind == TokenKind.Ident and parser.peek_at(scan + 1) == TokenKind.Dot and parser.peek_at(scan + 2) == TokenKind.Ident:
                        head_text: sview = Lexer::text_or_empty(token, parser.source)
                        member_text: sview = Lexer::text_or_empty(parser.tokens[parser.position + scan + 2], parser.source)
                        true return if head_text == "Unsafe" and member_text == "SegmentMutation"
                    scan <- scan + 1
                return false

        # The segment owner ("Host"/"Guest") a `@segment_transition(host|guest)` decorator
        # on the just-parsed signature establishes, or "" when absent. Reads the decorator's
        # first captured argument from `annotation_args`.
        def pending_decorator_segment_owner(parser: Parser&) -> sview:
            can Memory.Allocate, Abort.Panic:
                for decorator in parser.pending_decorators:
                    continue if decorator.name != "segment_transition" or decorator.arg_count == 0
                    arg: sview = parser.annotation_args[decorator.arg_start.usize()]
                    "Host" return if arg == "host" or arg == "Host" or arg == "Segment.Host"
                    "Guest" return if arg == "guest" or arg == "Guest" or arg == "Segment.Guest"
                return ""

        # Emit the segment-flow side-table fact for an extern signature: which ambient
        # segment a call TRANSITIONS to (mutation + member, or a @segment_transition
        # decorator), or which ambient it REQUIRES (a plain Segment.X with no transition).
        # Mirrors stage0 funcTypeSegmentTransitionOwner / funcTypeRequiredSegmentOwner.
        def record_extern_segment_flow(parser: lmut Parser, name: sview, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                member: sview = parser.header_segment_owner_member()
                mutation: bool = parser.header_has_segment_mutation()
                deco_owner: sview = parser.pending_decorator_segment_owner()
                transition_owner: sview = deco_owner if deco_owner != "" else (member if mutation and member != "" else "")
                required_owner: sview = "" if transition_owner != "" else member
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__seg_transition_host", line: line}) if transition_owner == "Host"
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__seg_transition_guest", line: line}) if transition_owner == "Guest"
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__seg_required_host", line: line}) if required_owner == "Host"
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__seg_required_guest", line: line}) if required_owner == "Guest"

        # The FIRST effect ref inside a signature `can[...]` ("Console.Write",
        # "Abort", ...), spanning dotted segments, or "" when absent. Rendered into
        # stage0's exact ungranted-call warning for extern callees.
        def header_signature_can_ref(parser: Parser&) -> sview:
            can Abort.Panic:
                while parser.peek_at(scan) not in {TokenKind.Newline, TokenKind.Eof} |scan: usize = 0|:
                    token: Token = parser.tokens[parser.position + scan]
                    if token.kind == TokenKind.Ident and Lexer::text_or_empty(token, parser.source) == "can" and parser.peek_at(scan + 1) == TokenKind.LBracket and parser.peek_at(scan + 2) == TokenKind.Ident:
                        ref_start: u32 = parser.tokens[parser.position + scan + 2].start
                        ref_end: mutable u32 = ref_start + parser.tokens[parser.position + scan + 2].length
                        segment: mutable usize = scan + 3
                        while parser.peek_at(segment) == TokenKind.Dot and parser.peek_at(segment + 1) == TokenKind.Ident |ref_end, segment|:
                            ref_end <- parser.tokens[parser.position + segment + 1].start + parser.tokens[parser.position + segment + 1].length
                            segment <- segment + 2
                        return Lexer::source_view_or_empty(parser.source, ref_start.usize(), ref_end.usize())
                    scan <- scan + 1
                return ""

        def header_has_fixed_array_type(parser: Parser&) -> bool:
            can Abort.Panic:
                while parser.peek_at(scan) not in {TokenKind.Newline, TokenKind.Eof} |scan: usize = 0|:
                    true return if parser.peek_at(scan) == TokenKind.LBracket and parser.peek_at(scan + 1) in {TokenKind.IntLit, TokenKind.HexLit}
                    scan <- scan + 1
                return false

        def header_error_family(parser: Parser&) -> sview:
            can Abort.Panic:
                while parser.peek_at(scan) not in {TokenKind.Newline, TokenKind.Eof} |scan: usize = 0|:
                    Lexer::text_or_empty(parser.tokens[parser.position + scan + 2], parser.source) return if parser.peek_at(scan) == TokenKind.Error and parser.peek_at(scan + 1) == TokenKind.LBracket and parser.peek_at(scan + 2) == TokenKind.Ident
                    scan <- scan + 1
                return ""

        # Preserve every family named by a function's `error[...]` destination. The
        # compact return-type AST intentionally omits the suffix; semantic raise/try
        # validation consumes these line-keyed rows instead.
        def capture_header_error_families(parser: lmut Parser, function_line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                inside_error_set: mutable bool = false
                while parser.peek_at(scan) not in {TokenKind.Newline, TokenKind.Eof} |parser, scan: usize = 0, inside_error_set|:
                    kind: TokenKind = parser.peek_at(scan)
                    starts_error_set: bool = kind == TokenKind.Error and parser.peek_at(scan + 1) == TokenKind.LBracket
                    inside_error_set <- true if starts_error_set
                    token: Token = parser.tokens[parser.position + scan]
                    previous_kind: TokenKind = parser.peek_at(scan - 1) if scan > 0 else TokenKind.Eof
                    family: bool = inside_error_set and kind == TokenKind.Ident and previous_kind in {TokenKind.LBracket, TokenKind.Comma}
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__error_set_family", name: Lexer::text_or_empty(token, parser.source), line: function_line}) if family
                    inside_error_set <- false if inside_error_set and kind == TokenKind.RBracket
                    scan <- scan + 1

        # Consume an extern's balanced parameter list while counting only top-level
        # `name:` entries. This deliberately leaves foreign/variadic type syntax opaque,
        # matching the old permissive skipper while retaining enough shape for arity.
        def scan_extern_params(parser: lmut Parser, arity: mutable u32&, variadic: mutable bool&) -> void:
            parser, _ <- parser.expect(TokenKind.LParen)
            depth: mutable int = 0
            param_name: mutable sview = ""
            type_name: mutable sview = ""
            protocol_state: mutable sview = ""
            generic_ident_count: mutable u32 = 0
            provenance: mutable bool = false
            after_colon: mutable bool = false
            while parser.peek() != TokenKind.Eof |parser, depth, arity, variadic, param_name, type_name, protocol_state, generic_ident_count, provenance, after_colon|:
                current_token: Token = parser.cursor()
                kind: TokenKind = current_token.kind
                break if depth == 0 and kind == TokenKind.RParen
                is_param_head: bool = depth == 0 and kind == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon
                param_name <- Lexer::text_or_empty(current_token, parser.source) if is_param_head else param_name
                arity <- arity + 1 if is_param_head else arity
                after_colon <- true if is_param_head else after_colon
                is_type_head: bool = depth == 0 and after_colon and kind == TokenKind.Ident and type_name == "" and parser.peek_at(1) != TokenKind.Colon
                type_name <- Lexer::text_or_empty(current_token, parser.source) if is_type_head else type_name
                is_generic_ident: bool = depth == 1 and after_colon and kind == TokenKind.Ident
                generic_ident_count <- generic_ident_count + 1 if is_generic_ident else generic_ident_count
                protocol_state <- Lexer::text_or_empty(current_token, parser.source) if is_generic_ident and generic_ident_count == 2 else protocol_state
                provenance <- true if after_colon and kind in {TokenKind.Ampersand, TokenKind.Lmut}
                variadic <- true if depth == 0 and kind == TokenKind.Ellipsis
                finishes_param: bool = depth == 0 and kind == TokenKind.Comma and param_name != ""
                retained_type: sview = protocol_state if protocol_state != "" and type_name in {"Thread", "Task"} else type_name
                parser.extern_params <- parser.extern_params.push(Ast::ExternParam{name: param_name, type_name: retained_type, provenance_bearing: provenance}) if finishes_param
                param_name <- "" if finishes_param else param_name
                type_name <- "" if finishes_param else type_name
                protocol_state <- "" if finishes_param else protocol_state
                generic_ident_count <- 0 if finishes_param else generic_ident_count
                provenance <- false if finishes_param else provenance
                after_colon <- false if finishes_param else after_colon
                depth <- depth + 1 if kind in {TokenKind.LParen, TokenKind.LBracket}
                depth <- depth - 1 if kind in {TokenKind.RParen, TokenKind.RBracket}
                parser, _ <- parser.advance()
            retained_type: sview = protocol_state if protocol_state != "" and type_name in {"Thread", "Task"} else type_name
            parser.extern_params <- parser.extern_params.push(Ast::ExternParam{name: param_name, type_name: retained_type, provenance_bearing: provenance}) if param_name != ""
            parser, _ <- parser.expect(TokenKind.RParen)

        def reject_extern_param_defaults(parser: lmut Parser) -> void:
            return if parser.peek() != TokenKind.LParen
            scan: mutable usize = 1
            depth: mutable int = 1
            while depth > 0 and parser.peek_at(scan) != TokenKind.Eof |parser, scan, depth|:
                kind: TokenKind = parser.peek_at(scan)
                scanned_token: Token = parser.tokens[parser.position + scan]
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, scanned_token) if depth == 1 and kind == TokenKind.Assign
                depth <- depth + 1 if kind == TokenKind.LParen
                depth <- depth - 1 if kind == TokenKind.RParen
                scan <- scan + 1

        # `func`/`fn` word immediately after `export`/`extern` before the name.
        def skip_export_func_word(parser: lmut Parser) -> void:
            func_word: Token = parser.cursor()
            func_word_text: sview = Lexer::text_or_empty(func_word, parser.source)
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, func_word) if func_word_text == "func"
            parser <- parser.advance_when(func_word_text == "func" or func_word_text == "fn")

        # `extern:`/`export:` indented block, entered with the cursor on the opening `:`.
        def parse_extern_trailing_block(parser: lmut Parser) -> void:
            parser, _ <- parser.advance()               # `:`
            parser <- parser.skip_indented_block()

        # Scan (without consuming) the rest of an `export fn` signature line for a `= TARGET`
        # re-export clause and record TARGET on the side-table for the undefined-target check.
        def capture_export_reexport_target(parser: lmut Parser, line: u32) -> void:
            scan: mutable usize = 0
            while parser.peek_at(scan) != TokenKind.Newline and parser.peek_at(scan) != TokenKind.Dedent and parser.peek_at(scan) != TokenKind.Eof |scan, parser|:
                if parser.peek_at(scan) == TokenKind.Assign and parser.peek_at(scan + 1) == TokenKind.Ident:
                    target_token: Token = parser.tokens[parser.position + scan + 1]
                    target_name: sview = Lexer::text_or_empty(target_token, parser.source)
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: target_name, name: "__export_target_ref", line: line}) if target_name != ""
                scan <- scan + 1

        # Consume the remainder of a single-line extern (the `: T`), stopping before
        # the newline/dedent/eof.
        def skip_extern_line_remainder(parser: lmut Parser) -> void:
            while parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser|:
                parser, _ <- parser.advance()


        def function_declaration(parser: lmut Parser) -> Ast::Decl?:
            rebind token: Token, parser = parser.expect(TokenKind.Def)
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            function_name: sview = Lexer::text_or_empty(name_token, parser.source)
            # Capture this method's own `changes self.FIELD` set for frame-condition conformance
            # (the signature clause is otherwise skipped). Keyed under the impl sentinel; only
            # methods whose name matches a protocol method are checked, so plain functions are inert.
            parser <- parser.capture_signature_changes(function_name, 3900000003)
            parser <- parser.scan_preserves_conflict(function_name)
            error_family: sview = parser.header_error_family()
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: function_name, name: "__error_return", line: token.line}) if error_family != ""
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: function_name, name: error_family, line: token.line}) if error_family != ""
            parser <- parser.capture_header_error_families(token.line) if error_family != ""
            parser.declared_thread_slots <- parser.declared_thread_slots.truncate(0)
            parser.lmut_param_names <- parser.lmut_param_names.truncate(0)
            parser.mutable_param_names <- parser.mutable_param_names.truncate(0)

            # Leading `@name` decorators were captured just before dispatch; snapshot them
            # now before any nested parse clobbers the parser's pending buffer.
            decorators: mutable darray[Ast::Annotation] = []
            for decorator in parser.pending_decorators |decorators|:
                decorators.push(decorator)

            # Optional generic/region params `[T]`, `[K, V]`, `[@r]` between name and `(`.
            rebind accepted_lbracket: bool, parser = parser.accept(TokenKind.LBracket)
            parser <- parser.reject_legacy_region_params() if accepted_lbracket
            parser <- parser.capture_function_generic_params(token.line) if accepted_lbracket

            param_items: mutable darray[Ast::ParamDecl] = []
            rebind accepted_lparen: bool, parser = parser.accept(TokenKind.LParen)
            parser <- parser.parse_param_list(param_items, token.line) if accepted_lparen

            effects: mutable darray[sview] = []

            rebind accepted_arrow: bool, parser = parser.accept(TokenKind.Arrow)
            parser <- parser.validate_conditional_ensures_return() if accepted_arrow
            parser <- parser.capture_typestate_postcondition(function_name, param_items, token.line)
            rebind return_type: Ast::Expr?, parser = parser.capture_return_type_and_effects(accepted_arrow)
            return_region_token: Token = parser.cursor()
            rebind accepted_return_region: bool, parser = parser.accept(TokenKind.At)
            return_region_name_token: Token = parser.cursor()
            # Consume the region name ONLY after an `@`; a bare identifier here is the first word
            # of a signature clause (`ensures`/`requires`) and must survive for capture.
            has_return_region: bool = accepted_return_region and parser.peek() == TokenKind.Ident
            parser <- parser.advance_region_name(has_return_region)
            parser.local_region_annotations <- parser.local_region_annotations.push(Ast::LocalRegionAnnotation{name: "__region_return", type_expression: get return_type else (Ast::Expr.Invalid), region: Lexer::text_or_empty(return_region_name_token, parser.source), line: token.line}) if has_return_region
            parser <- parser.error_at(Ast::ParseErrorKind.ExpectedToken, return_region_token) if accepted_return_region and not has_return_region
            parser <- parser.validate_declared_thread_slots(token)
            # The return-type `expression()` consumes a trailing effect grant
            # (`-> T can[...]`) via skip_trailing_can; recover it from the parser. The
            # copy lives HERE, where `effects` is locally owned — growing it through a
            # ref param inside the helper detaches the growth from its arena ("darray
            # reserve requires an active in <arena>: scope" at codegen).
            effects.extend(parser.captured_effects) if accepted_arrow

            # Remaining signature clauses before the body colon: a bare `can` grant when
            # there is no return type, plus error sets (`raises ...`) and contracts
            # (`requires`/`ensures`), which are consumed without modeling.
            parser <- parser.parse_signature_clauses(effects)

            # Drain this signature's captured `requires`/`ensures` into the file-level side-channel,
            # keyed by the owning function's line. (Snapshot BEFORE the body parse — a nested `def`
            # re-enters parse_signature_clauses and clobbers the per-signature buffers.)
            parser <- parser.drain_signature_contracts(token.line)

            # Drain this signature's plain `fulfills LawName` clauses, keyed by the owning
            # function name (sentinel line 3900000021), for the effect-law fulfillment check.
            while fulfills_index < parser.pending_fulfills.count |parser, fulfills_index: usize = 0|:
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: function_name, name: parser.pending_fulfills[fulfills_index], line: 3900000021})
                fulfills_index <- fulfills_index + 1
            parser.pending_fulfills <- parser.pending_fulfills.truncate(0)

            # Drain `fulfills SUBJECT is LAW` clauses as lockstep (law, subject) annotation
            # pairs keyed by the function name (sentinels 3900000029 law, 3900000030 subject),
            # for the frame-law conformance check.
            while is_index < parser.pending_fulfills_is_law.count |parser, is_index: usize = 0|:
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: function_name, name: parser.pending_fulfills_is_law[is_index], line: 3900000029})
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: function_name, name: parser.pending_fulfills_is_subject[is_index], line: 3900000030})
                is_index <- is_index + 1
            parser.pending_fulfills_is_subject <- parser.pending_fulfills_is_subject.truncate(0)
            parser.pending_fulfills_is_law <- parser.pending_fulfills_is_law.truncate(0)

            # Record this function's line if its signature declared an `error[...]` return
            # set, so the RaiseWithoutErrorSet check can exempt it (drained into
            # File.error_set_func_lines by parse_file).
            parser.error_set_func_lines <- parser.error_set_func_lines.push(token.line) if parser.signature_has_error_set

            rebind accepted_assign: bool, parser = parser.accept(TokenKind.Assign)
            is_block_body: bool = not accepted_assign and parser.peek() == TokenKind.Colon
            # Expression-bodied function `def f(...) -> T = EXPR` == a body of a single
            # `return EXPR` (same `=` "definition is this expression" as law/type/alias).
            signature_has_pool: bool = any effect in effects where effect == "Pool" or (sview_len(effect) > 4 and effect[0:4] == "Pool")
            parser.active_pool_depth <- parser.active_pool_depth + 1 if signature_has_pool
            rebind resolved_body: darray[Ast::Stmt], parser = parser.resolve_function_body(accepted_assign, is_block_body)
            parser.active_pool_depth <- parser.active_pool_depth - 1 if signature_has_pool

            return (Ast::Decl.Func(function_name, param_items, return_type, resolved_body, effects, decorators, token.line))

        # Capture the declaration names in a function generic header, entered just
        # after `[`. A top-level identifier immediately after `[` or `,` is a generic
        # parameter (`T`, `N`); constraints after `:` are skipped. Region parameters
        # beginning with `@` are intentionally omitted from value-name resolution.
        def capture_function_generic_params(parser: lmut Parser, function_line: u32) -> void:
            expect_name: mutable bool = true
            expect_bound: mutable bool = false
            depth: mutable int = 0
            while parser.peek() != TokenKind.Eof |parser, expect_name, expect_bound, depth|:
                kind: TokenKind = parser.peek()
                break if depth == 0 and kind == TokenKind.RBracket
                token: Token = parser.cursor()
                # `errorset R` — an error-set generic parameter. Record R on the side-table
                # (keyed by the function line, matching Decl.Func's line) and do NOT treat the
                # `errorset` keyword itself as a generic type name.
                is_errorset_kw: bool = depth == 0 and expect_name and kind == TokenKind.Ident and Lexer::text_or_empty(token, parser.source) == "errorset" and parser.peek_at(1) == TokenKind.Ident
                errorset_name_token: Token = parser.tokens[parser.position + 1] if is_errorset_kw else token
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__errorset_param", name: Lexer::text_or_empty(errorset_name_token, parser.source), line: function_line}) if is_errorset_kw
                is_generic_name: bool = depth == 0 and expect_name and kind == TokenKind.Ident and not is_errorset_kw
                is_bound_name: bool = depth == 0 and expect_bound and kind == TokenKind.Ident
                region_parameter: bool = depth == 0 and kind == TokenKind.At and parser.peek_at(1) == TokenKind.Ident
                region_name_token: Token = parser.tokens[parser.position + 1] if region_parameter else token
                parser.local_region_annotations <- parser.local_region_annotations.push(Ast::LocalRegionAnnotation{name: "__region_param", type_expression: (Ast::Expr.Invalid), region: Lexer::text_or_empty(region_name_token, parser.source), line: function_line}) if region_parameter
                parser.generic_param_lines <- parser.generic_param_lines.push(function_line) if is_generic_name
                parser.generic_param_names <- parser.generic_param_names.push(Lexer::text_or_empty(token, parser.source)) if is_generic_name
                # Bound rows share the proven-stable generic side table. The high line
                # bit distinguishes metadata from ordinary parameter rows, so existing
                # exact-line scope consumers ignore it.
                parser.generic_param_lines <- parser.generic_param_lines.push(function_line + 2147483648) if is_bound_name
                parser.generic_param_names <- parser.generic_param_names.push(Lexer::text_or_empty(token, parser.source)) if is_bound_name
                expect_name <- false if depth == 0 and (is_generic_name or is_errorset_kw or kind == TokenKind.At)
                expect_bound <- true if depth == 0 and kind == TokenKind.Colon
                expect_bound <- false if is_bound_name or (depth == 0 and kind == TokenKind.Comma)
                expect_name <- true if depth == 0 and kind == TokenKind.Comma
                depth <- depth + 1 if kind in {TokenKind.LParen, TokenKind.LBracket}
                depth <- depth - 1 if kind in {TokenKind.RParen, TokenKind.RBracket}
                parser, _ <- parser.advance()
            parser, _ <- parser.expect(TokenKind.RBracket)

        # Dispatch the function body form. A region-polymorphic `darray[Ast::Stmt]`
        # can't be threaded out through a mutable-ref out-param (the callee's `in
        # auto:` region doesn't survive the store into the caller's ref — "value
        # escapes its `in auto:` scope") the way a plain-value out-param can, and a
        # 3-way ternary chain of real calls doesn't thread `parser` reliably either, so
        # each branch is a sequential value-first exit guard instead: call the one real
        # function that applies and return its (region-poly) result directly.
        def resolve_function_body(parser: lmut Parser, accepted_assign: bool, is_block_body: bool) -> darray[Ast::Stmt]:
            no_declared_body: darray[Ast::Stmt] = []
            no_declared_body return if not accepted_assign and not is_block_body
            # The expression-body parse must be cond-guarded: calling it unconditionally
            # consumes the block `:` as an expression and breaks every block-bodied def.
            rebind expr_body: darray[Ast::Stmt], parser = parser.parse_expression_bodied_function_if(accepted_assign)
            expr_body return if accepted_assign
            rebind block_body: darray[Ast::Stmt], parser = parser.parse_block()
            return block_body

        def parse_expression_bodied_function_if(parser: lmut Parser, cond: bool) -> darray[Ast::Stmt]:
            no_body: darray[Ast::Stmt] = []
            no_body return if not cond
            rebind body: darray[Ast::Stmt], parser = parser.parse_expression_bodied_function()
            return body

        # Parse the balanced `(param, ...)` list into `param_items`, entered with the
        # cursor just past the opening `(`.
        def parse_param_list(parser: lmut Parser, param_items: mutable darray[Ast::ParamDecl]&, function_line: u32) -> void:
            while parser.peek() != TokenKind.RParen and parser.peek() != TokenKind.Eof |parser|:
                rebind keep_going: bool, parser = parser.parse_one_param(param_items, function_line)
                break if not keep_going
            parser, _ <- parser.expect(TokenKind.RParen)

        # Parse the contextual `where PRED` suffix used on type annotations. The
        # base expression is already parsed; retain the predicate structurally.
        def parse_refinement_suffix(parser: lmut Parser, base: Ast::Expr) -> Ast::Expr:
            where_token: Token = parser.cursor()
            has_where: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(where_token, parser.source) == "where"
            parser, _ <- parser.advance() if has_where
            rebind predicate_opt: Ast::Expr?, parser = parser.expression_if(has_where)
            return match predicate_opt:
                predicate: (Ast::Expr.Refinement(base, predicate, where_token.line))
                _: base

        # A default-value expression is evaluated in a scope WITHOUT the function's own
        # parameters (`def f(x: i64, y: i64 = x)` — `x` is undefined there). The parser
        # discards the default expr, so record a `__default_param_ref` marker for every
        # bare-Ident reference to an already-seen parameter; the semantic layer turns each
        # into an `undefined identifier` diagnostic (unless the name also names a global).
        def record_default_param_refs(parser: lmut Parser, expression: Ast::Expr, param_items: darray[Ast::ParamDecl]&, function_line: u32) -> void:
            match expression:
                Ast::Expr.Ident(name, ident_line):
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__default_param_ref", name: name, line: function_line}) if any parameter in param_items where parameter.name == name
                Ast::Expr.Binary(left, operator, right, binary_line):
                    parser <- parser.record_default_param_refs(left, param_items, function_line)
                    parser <- parser.record_default_param_refs(right, param_items, function_line)
                Ast::Expr.Unary(operator, operand, unary_line):
                    parser <- parser.record_default_param_refs(operand, param_items, function_line)
                Ast::Expr.Paren(inner, paren_line):
                    parser <- parser.record_default_param_refs(inner, param_items, function_line)
                Ast::Expr.Field(object, field_name, field_line):
                    parser <- parser.record_default_param_refs(object, param_items, function_line)
                Ast::Expr.Index(object, index, index_line):
                    parser <- parser.record_default_param_refs(object, param_items, function_line)
                    parser <- parser.record_default_param_refs(index, param_items, function_line)
                Ast::Expr.Call(callee, arguments, argument_names, call_line):
                    parser <- parser.record_default_param_refs(callee, param_items, function_line)
                    for argument in arguments |parser| -> parser:
                        parser <- parser.record_default_param_refs(argument, param_items, function_line)
                _:
                    pass

        # Parse one `(param, ...)` entry, appending it to `param_items` when a full name
        # + type clause was captured. Returns whether the caller's comma-separated loop
        # should continue (a trailing comma was accepted).
        def parse_one_param(parser: lmut Parser, param_items: mutable darray[Ast::ParamDecl]&, function_line: u32) -> bool:
            # Legacy leading `mutable name:` form; the canonical `name: mutable T&` form
            # is captured by the type expression itself.
            rebind leading_mutable: bool, parser = parser.accept(TokenKind.Mutable)
            rebind param_name: Token, parser = parser.expect(TokenKind.Ident)
            parser, _ <- parser.expect(TokenKind.Colon)
            parser <- parser.reject_positional_tuple_type_ahead()
            is_lmut_param: bool = parser.peek() == TokenKind.Lmut
            parser.lmut_param_names <- parser.lmut_param_names.push(Lexer::text_or_empty(param_name, parser.source)) if is_lmut_param
            is_mutable_param: bool = leading_mutable or parser.peek() == TokenKind.Mutable or is_lmut_param
            parser.mutable_param_names <- parser.mutable_param_names.push(Lexer::text_or_empty(param_name, parser.source)) if is_mutable_param
            rebind parsed_type_expression: Ast::Expr?, parser = parser.expression()
            type_expression: mutable Ast::Expr? = parsed_type_expression
            if type_expression is param_type:
                rebind refined_type: Ast::Expr, parser = parser.parse_refinement_suffix(param_type)
                type_expression <- refined_type

            # Function-type error set: `fn(...) -> T error[R]`. The function type is
            # represented by the existing expression shape; consume its error-set
            # selector so it remains part of this parameter rather than an orphan token.
            if parser.peek() == TokenKind.Error:
                parser, _ <- parser.advance()
                rebind accepted_error_lbracket: bool, parser = parser.accept(TokenKind.LBracket)
                parser <- parser.skip_bracketed_group() if accepted_error_lbracket

            # Optional `@region` binding on the param type (`out: darray[u8]& @r`) pinning
            # the parameter to a region-polymorphic region declared in the `[@r]` generic
            # list. The region name is a selector, not a value ref; retain it in the
            # File side table for call-result lifetime inference.
            rebind accepted_at: bool, parser = parser.accept(TokenKind.At)
            region_name_token: Token = parser.cursor()
            rebind accepted_region_name: bool, parser = parser.accept(TokenKind.Ident)
            parser.local_region_annotations <- parser.local_region_annotations.push(Ast::LocalRegionAnnotation{name: Lexer::text_or_empty(param_name, parser.source), type_expression: get type_expression else (Ast::Expr.Invalid), region: Lexer::text_or_empty(region_name_token, parser.source), line: function_line}) if accepted_at and accepted_region_name and function_line > 0

            # Trailing function-type effect clause on the param type (`body: fn(usize) ->
            # i64 can[Abort.Panic]`): skip the balanced `can[...]` so it isn't mistaken
            # for the next parameter.
            can_clause_cursor: Token = parser.cursor()
            is_can_clause: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(can_clause_cursor, parser.source) == "can" and parser.peek_at(1) == TokenKind.LBracket
            has_param_effects: bool = is_can_clause or parser.captured_effects.count > 0
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__effect_param", name: Lexer::text_or_empty(param_name, parser.source), line: function_line}) if has_param_effects
            parser <- parser.skip_param_can_clause() if is_can_clause

            # Optional default value `param: T = <expression>`. Recorded on the
            # ParamDecl (pushed below, once the full param clause is known) so arity
            # checking can split required from defaultable parameters.
            rebind param_has_default: bool, parser = parser.accept(TokenKind.Assign)
            if param_has_default:
                rebind default_expression: Ast::Expr?, parser = parser.expression()
                if default_expression is default_value:
                    parser <- parser.record_default_param_refs(default_value, param_items, function_line)

            if type_expression is param_type:
                param: Ast::ParamDecl = Ast::ParamDecl{name: Lexer::text_or_empty(param_name, parser.source), type_expression: param_type, is_mutable: leading_mutable, has_default: param_has_default}
                param_items.push(param)

            rebind accepted_comma: bool, parser = parser.accept(TokenKind.Comma)
            return accepted_comma

        # Skip a param's trailing `can[...]` effect clause, entered with the cursor on
        # the `can` identifier.
        def skip_param_can_clause(parser: lmut Parser) -> void:
            parser, _ <- parser.advance()               # `can`
            parser, _ <- parser.accept(TokenKind.LBracket)
            parser <- parser.skip_bracketed_group()

        # Capture the return-type expression and any trailing effect grant (`-> T
        # can[...]`, recovered from `parser.captured_effects` via skip_trailing_can
        # inside `expression()`) when `has_arrow` holds; a no-operator (returns `null`)
        # otherwise. `Ast::Expr?` can't be an out-param (`mutable Ast::Expr?&` doesn't
        # parse — the `?` closes the type before `&` can bind) and threading it plus
        # `parser` out of a two-real-branch ternary at the call site isn't reliable
        # (also true of `-> T` vs "no type" here), so the branch is folded into this
        # single call via a value-first exit guard instead.
        def advance_region_name(parser: lmut Parser, gate: bool) -> void:
            return if not gate
            parser, _ <- parser.advance()

        # Move the per-signature captured contracts into the file-level accumulators, tagged with
        # the owning function's line, then clear the per-signature buffers.
        def drain_signature_contracts(parser: lmut Parser, function_line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                while contract_index < parser.captured_contract_kinds.count |parser, contract_index: usize = 0|:
                    parser.signature_contract_lines <- parser.signature_contract_lines.push(function_line)
                    parser.signature_contract_kinds <- parser.signature_contract_kinds.push(parser.captured_contract_kinds[contract_index])
                    parser.signature_contract_exprs <- parser.signature_contract_exprs.push(parser.captured_contract_exprs[contract_index])
                    contract_index <- contract_index + 1
                parser.captured_contract_kinds <- parser.captured_contract_kinds.truncate(0)
                parser.captured_contract_exprs <- parser.captured_contract_exprs.truncate(0)

        def capture_return_type_and_effects(parser: lmut Parser, has_arrow: bool) -> Ast::Expr?:
            null return if not has_arrow
            parser <- parser.reject_positional_tuple_type_ahead()
            parser <- parser.capture_declared_thread_slots()
            rebind return_type_opt: Ast::Expr?, parser = parser.expression()
            if return_type_opt is return_type:
                rebind refined_return_type: Ast::Expr, parser = parser.parse_refinement_suffix(return_type)
                return refined_return_type
            return return_type_opt

        def capture_declared_thread_slots(parser: lmut Parser) -> void:
            return if parser.peek() != TokenKind.LParen
            scan: mutable usize = 1
            depth: mutable int = 1
            while depth > 0 and parser.peek_at(scan) != TokenKind.Eof |parser, scan, depth|:
                kind: TokenKind = parser.peek_at(scan)
                if depth == 1 and kind == TokenKind.Ident and parser.peek_at(scan + 1) == TokenKind.Colon:
                    label_token: Token = parser.tokens[parser.position + scan]
                    is_lmut_slot: bool = parser.peek_at(scan + 2) == TokenKind.Lmut
                    parser.declared_thread_slots <- parser.declared_thread_slots.push(Lexer::text_or_empty(label_token, parser.source)) if is_lmut_slot
                depth <- depth + 1 if kind == TokenKind.LParen
                depth <- depth - 1 if kind == TokenKind.RParen
                scan <- scan + 1

        def validate_declared_thread_slots(parser: lmut Parser, token: Token) -> void:
            for slot in parser.declared_thread_slots |parser|:
                found: mutable bool = false
                for param in parser.lmut_param_names |found|:
                    found <- true if slot == param
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if not found

        # Expression-bodied function `def f(...) -> T = EXPR`: builds the one-element
        # body as a list literal (not `[]`+push): a push-only fresh darray does not
        # survive the region-polymorphic return, but a seeded literal is adopted.
        def parse_expression_bodied_function(parser: lmut Parser) -> darray[Ast::Stmt]:
            value_token: Token = parser.cursor()
            return_value: mutable Ast::Expr? = null
            rebind value_expr_opt: Ast::Expr?, parser = parser.expression()
            if value_expr_opt is value_expr:
                return_value <- value_expr
            rebind body: darray[Ast::Stmt], parser = parser.single_statement_body((Ast::Stmt.Return(return_value, value_token.line)))
            return body


        # Guest-overlay member clause (`struct X layout(guest, size: N):`): a trailing
        # `at OFFSET [requires size >= N]` after a field. The offset and minimum-size guard
        # aren't modeled in stage1; consume them so the member line parses. A no-op when the
        # next token isn't the contextual `at` keyword.
        def skip_guest_overlay_clause(parser: lmut Parser, field_name: sview) -> void:
            at_token: Token = parser.cursor()
            is_at_clause: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(at_token, parser.source) == "at"
            parser <- parser.consume_guest_overlay_at_clause(field_name) if is_at_clause

        # `at OFFSET [requires size >= N]`, entered with the cursor on `at`. The offset
        # (and any minimum-size guard) is RECORDED (owner "__overlay_field" /
        # "__overlay_reqsize", the numeric riding in `line`) so the guest-overlay checks
        # can validate accesses; fields follow their struct's "__overlay_struct" marker.
        def consume_guest_overlay_at_clause(parser: lmut Parser, field_name: sview) -> void:
            parser, _ <- parser.advance()               # `at`
            offset_token: Token = parser.cursor()
            parser, _ <- parser.advance()               # OFFSET (int/hex literal)
            offset_value: u32 = parse_layout_number(Lexer::text_or_empty(offset_token, parser.source))
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__overlay_field", name: field_name, line: offset_value})
            requires_token: Token = parser.cursor()
            has_requires: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(requires_token, parser.source) == "requires"
            if has_requires:
                # `requires size >= N` — capture N before skipping the tail.
                bound_value: mutable u32 = 0
                scan: mutable usize = 0
                while parser.peek_at(scan) != TokenKind.Newline and parser.peek_at(scan) != TokenKind.Eof |parser, scan, bound_value|:
                    scan_token: Token = parser.tokens[parser.position + scan]
                    candidate: u32 = parse_layout_number(Lexer::text_or_empty(scan_token, parser.source)) if scan_token.kind == TokenKind.IntLit else 0
                    bound_value <- candidate if candidate != 0
                    scan <- scan + 1
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__overlay_reqsize", name: field_name, line: bound_value})
            parser <- parser.skip_to_line_end() if has_requires


        # A decimal layout number ("64" -> 64); non-numeric text -> 0.
        def parse_layout_number(text: sview) -> u32:
            value: mutable u32 = 0
            index: mutable usize = 0
            while index < text.len |value, index, text|:
                byte: u8 = text[index]
                break if byte < 48 or byte > 57
                value <- value * 10 + (byte - 48).u32()
                index <- index + 1
            return value

        # Parse the indented body of a struct: `(IDENT : <type> NEWLINE)*`.
        # Non-field forms (e.g. `pass`, `bitset:`) are skipped token-by-token so an
        # unrecognized member never derails the surrounding declaration.
        def struct_member_block(parser: lmut Parser, struct_name: sview) -> darray[Ast::StructMember]:
            parser, _ <- parser.expect(TokenKind.Colon)
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)

            # Reset the per-body capture buffers (mirror of `captured_effects`): the derive
            # flag and invariant list are carried back to `struct_declaration` on `parser`.
            parser.captured_has_derive <- false
            parser.captured_invariants <- parser.captured_invariants.truncate(0)

            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__overlay_struct", name: struct_name, line: 0}) if parser.current_struct_is_guest
            members: mutable darray[Ast::StructMember] = []
            while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser, members|:
                parser <- parser.skip_newlines()
                break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof
                not_ident: bool = parser.peek() != TokenKind.Ident
                parser <- parser.advance_when(not_ident)
                continue if not_ident

                # `derive state:` — typestate derivation block (`struct X[state A | B]:`),
                # an indented list of `Variant when PREDICATE` lines mapping field values
                # to states. Preserve every predicate in parser metadata for typestate
                # validation and mutation invalidation in semantic analysis.
                derive_token: Token = parser.cursor()
                is_derive: bool = Lexer::text_or_empty(derive_token, parser.source) == "derive" and parser.peek_at(1) == TokenKind.Ident and parser.peek_at(2) == TokenKind.Colon
                parser <- parser.parse_struct_derive_block(struct_name) if is_derive
                continue if is_derive

                # `ghost NAME: T` — a verification-only model field, erased at codegen.
                # Not yet modeled distinctly in the stage1 AST; parsed as an ordinary
                # field so the member line doesn't cascade. Disambiguated like stage0:
                # `ghost` is a leading IDENT immediately followed by another IDENT (the
                # field name), so a field literally named `ghost` (`ghost: T`) still
                # parses as an ordinary field.
                ghost_token: Token = parser.cursor()
                is_ghost_field: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(ghost_token, parser.source) == "ghost" and parser.peek_at(1) == TokenKind.Ident
                parser <- parser.advance_when(is_ghost_field)

                # Struct-body design-by-contract clause (`invariant EXPR` — a leading
                # `self.field …` predicate, not yet modeled in the stage1 AST). Same
                # contextual-keyword disambiguation as `contract_statement`: only treated as
                # a clause when a value-starting token follows on the same line, so a
                # field literally named `invariant` still parses as `invariant: T`.
                head_token: Token = parser.cursor()
                is_invariant_head: bool = Lexer::text_or_empty(head_token, parser.source) == "invariant"
                invariant_next_kind: TokenKind = parser.peek_at(1)
                is_invariant_clause: bool = is_invariant_head and invariant_next_kind in {TokenKind.Ident, TokenKind.IntLit, TokenKind.FloatLit, TokenKind.StringLit, TokenKind.CharLit, TokenKind.True, TokenKind.False, TokenKind.Not}
                parser <- parser.skip_invariant_clause() if is_invariant_clause
                continue if is_invariant_clause

                rebind member_name: Token, parser = parser.expect(TokenKind.Ident)
                # `name?: T` — optional (absent-allowed) field; the `?` belongs to the
                # field-name clause (mirrors the enum-payload spelling). An optional field
                # may be omitted in a by-label construction.
                rebind is_optional: bool, parser = parser.accept(TokenKind.Question)
                parser, _ <- parser.expect(TokenKind.Colon)
                # Capture the field's type-head identifier before parsing the type
                # expression, so `flags: bitset:` / `layout: bitfield:` groups can be
                # recognized (a bare `bitset`/`bitfield` name followed by a `:` block).
                type_head_token: Token = parser.cursor()
                type_head_text: sview = Lexer::text_or_empty(type_head_token, parser.source)
                rebind parsed_member_type: Ast::Expr?, parser = parser.expression()
                member_type_opt: mutable Ast::Expr? = parsed_member_type
                if member_type_opt is member_type:
                    member_type_value: mutable Ast::Expr = member_type
                    rebind refined_member_type: Ast::Expr, parser = parser.parse_refinement_suffix(member_type_value)
                    member_type_value <- refined_member_type
                    member_type_opt <- member_type_value
                    # Optional default value `name: T = <expression>` — the type parser stops
                    # at `=` (precedence 0), so consume the default explicitly (it was
                    # previously swallowed token-by-token by the non-Ident recovery). A
                    # defaulted field, like an optional one, may be omitted in a literal.
                    rebind accepted_assign_2: bool, parser = parser.accept(TokenKind.Assign)
                    has_default: bool = accepted_assign_2
                    parser <- parser.expression_when(accepted_assign_2)

                    # A field with its own indented block (`flags: bitset:` then flag names,
                    # or `layout: bitfield:` then `name: T` members) — the type expression
                    # above consumed the `bitset`/`bitfield` head, so a trailing `: NEWLINE
                    # INDENT ... DEDENT` follows. When the head is exactly `bitset`/`bitfield`
                    # the members are captured structurally; any other nested block is
                    # skipped blindly (unchanged behavior).
                    group_kind: mutable sview = ""
                    opens_block: bool = parser.peek() == TokenKind.Colon and parser.peek_at(1) == TokenKind.Newline
                    is_bit_group: bool = type_head_text == "bitset" or type_head_text == "bitfield"
                    is_captured_bit_group: bool = opens_block and is_bit_group
                    is_raw_nested_block: bool = opens_block and not is_bit_group
                    group_kind <- type_head_text if is_captured_bit_group
                    # A region-polymorphic `darray[Ast::BitGroupMember]` can't be threaded
                    # out through a mutable-ref out-param ("value escapes its `in auto:`
                    # scope"), so the condition is folded into the callee via a value-first
                    # exit guard instead (mirrors `resolve_function_body` above).
                    rebind group_members: darray[Ast::BitGroupMember], parser = parser.capture_bit_group_members_or_default(is_captured_bit_group)
                    parser <- parser.skip_bit_group_block_raw() if is_raw_nested_block

                    # Optional `@region` field annotation (`next: T @owner`) — a region
                    # selector, not part of the field type. Captured verbatim so the
                    # region-annotation-on-scalar check can inspect it; "" when absent.
                    member_region: mutable sview = ""
                    rebind accepted_at_2: bool, parser = parser.accept(TokenKind.At)
                    parser <- parser.capture_member_region(member_region) if accepted_at_2
                    member: Ast::StructMember = Ast::StructMember{name: Lexer::text_or_empty(member_name, parser.source), type_expression: member_type_value, omittable: is_optional or has_default, is_ghost: is_ghost_field, has_default: has_default, region: member_region, bit_group_kind: group_kind, bit_group_members: group_members}
                    members.push(member)
                    # `field: type at OFFSET [requires size >= N]` guest-overlay clause.
                    guest_clause_token: Token = parser.cursor()
                    has_guest_at: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(guest_clause_token, parser.source) == "at"
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, member_name) if parser.current_struct_is_guest and not has_guest_at
                    parser <- parser.skip_guest_overlay_clause(Lexer::text_or_empty(member_name, parser.source))
                parser, _ <- parser.accept(TokenKind.Newline)

            parser, _ <- parser.expect(TokenKind.Dedent)
            return members

        # `derive state:` block, entered with the cursor on the `derive` identifier.
        def parse_struct_derive_block(parser: lmut Parser, struct_name: sview) -> void:
            parser.captured_has_derive <- true              # a `derive state:` block is present
            parser, _ <- parser.advance()                   # `derive`
            parser, _ <- parser.advance()                   # `state`
            parser, _ <- parser.expect(TokenKind.Colon)
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)
            while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser|:
                parser <- parser.skip_newlines()
                break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof
                rebind state_token: Token, parser = parser.expect(TokenKind.Ident)
                rebind when_token: Token, parser = parser.expect(TokenKind.Ident)
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, when_token) if Lexer::text_or_empty(when_token, parser.source) != "when"
                rebind condition_opt: Ast::Expr?, parser = parser.expression()
                if condition_opt is condition:
                    parser.derived_state_rules <- parser.derived_state_rules.push(Ast::DerivedStateRule{owner: struct_name, state: Lexer::text_or_empty(state_token, parser.source), condition: condition, line: state_token.line})
                parser, _ <- parser.accept(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Dedent)

        # `invariant EXPR` struct-body clause, entered with the cursor on `invariant`.
        def skip_invariant_clause(parser: lmut Parser) -> void:
            parser, _ <- parser.advance()               # `invariant`
            # Capture the predicate as a structured expression onto the parser's
            # invariant buffer (drained into `Decl.Struct.invariants`). Any residue up to
            # the line break is drained so a partial parse can't derail the following
            # member line.
            rebind inv_opt: Ast::Expr?, parser = parser.expression()
            if inv_opt is inv_expr:
                parser.captured_invariants <- parser.captured_invariants.push(inv_expr)
            while parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Eof |parser|:
                parser, _ <- parser.advance()
            parser, _ <- parser.accept(TokenKind.Newline)

        # Capture a `flags: bitset:` / `layout: bitfield:` field's member block, entered
        # with the cursor on the nested `:`, when `is_captured_bit_group` holds; an
        # empty list (the prior default) otherwise.
        def capture_bit_group_members_or_default(parser: lmut Parser, is_captured_bit_group: bool) -> darray[Ast::BitGroupMember]:
            empty: darray[Ast::BitGroupMember] = []
            empty return if not is_captured_bit_group
            rebind members: darray[Ast::BitGroupMember], parser = parser.bit_group_member_block()
            return members

        # `next: T @owner` region annotation, entered with the cursor just past the
        # accepted `@`.
        def capture_member_region(parser: lmut Parser, member_region: mutable sview&) -> void:
            region_token: Token = parser.cursor()
            rebind accepted_region_name: bool, parser = parser.accept(TokenKind.Ident)
            member_region <- Lexer::text_or_empty(region_token, parser.source) if accepted_region_name


        # Parse the indented body of a packed bit group (`flags: bitset:` / `layout:
        # bitfield:`). The leading `:` NEWLINE INDENT and trailing DEDENT are consumed here.
        # A `bitset` flag is a bare `IDENT` line (type left `Invalid` — an implicit 1-bit
        # member); a `bitfield` member is `IDENT : TYPE`. Names and (bitfield) storage types
        # are captured in declaration order for the semantic layout checks.
        def bit_group_member_block(parser: lmut Parser) -> darray[Ast::BitGroupMember]:
            result: mutable darray[Ast::BitGroupMember] = []
            parser, _ <- parser.advance()                 # the nested `:`
            parser, _ <- parser.expect(TokenKind.Newline)
            rebind accepted_indent: bool, parser = parser.accept(TokenKind.Indent)
            parser <- parser.parse_bit_group_members(result) if accepted_indent
            return result

        # The bit-group member loop, entered with the cursor just past the accepted
        # `Indent` (mirrors `struct_member_block`'s member loop).
        def parse_bit_group_members(parser: lmut Parser, result: mutable darray[Ast::BitGroupMember]&) -> void:
            while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser|:
                parser <- parser.skip_newlines()
                break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof
                not_ident: bool = parser.peek() != TokenKind.Ident
                parser <- parser.advance_when(not_ident)
                continue if not_ident
                rebind bg_name: Token, parser = parser.expect(TokenKind.Ident)
                bg_line: u32 = bg_name.line
                bg_type: mutable Ast::Expr = (Ast::Expr.Invalid)
                rebind accepted_bg_colon: bool, parser = parser.accept(TokenKind.Colon)
                parser <- parser.capture_bit_group_member_type(bg_type) if accepted_bg_colon
                result.push(Ast::BitGroupMember{name: Lexer::text_or_empty(bg_name, parser.source), type_expression: bg_type, line: bg_line})
                parser, _ <- parser.accept(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Dedent)

        # A `bitfield` member's `: TYPE` clause, entered just past the accepted `:`.
        def capture_bit_group_member_type(parser: lmut Parser, bg_type: mutable Ast::Expr&) -> void:
            rebind bg_type_opt: Ast::Expr?, parser = parser.expression()
            if bg_type_opt is bg_type_value:
                bg_type <- bg_type_value


        # Blindly skip a field's nested `:` NEWLINE INDENT ... DEDENT block that is not a
        # recognized packed bit group (depth-tracked token consumption; unchanged behavior).
        def skip_bit_group_block_raw(parser: lmut Parser) -> void:
            parser, _ <- parser.advance()                 # the nested `:`
            parser, _ <- parser.expect(TokenKind.Newline)
            rebind accepted_indent_raw: bool, parser = parser.accept(TokenKind.Indent)
            parser <- parser.skip_to_matching_dedent() if accepted_indent_raw


        # Parse the indented body of an enum: `(IDENT [ ( <field>, ... ) ] NEWLINE)*`.
        def enum_variant_block(parser: lmut Parser) -> darray[Ast::EnumVariant]:
            parser.captured_enum_common_count <- 0
            parser, _ <- parser.expect(TokenKind.Colon)
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)

            variants: mutable darray[Ast::EnumVariant] = []
            common_fields: mutable darray[Ast::Expr] = []
            common_names: mutable darray[sview] = []
            while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser, variants|:
                parser <- parser.skip_newlines()
                break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof
                not_ident: bool = parser.peek() != TokenKind.Ident
                parser <- parser.advance_when(not_ident)
                continue if not_ident

                rebind variant_name: Token, parser = parser.expect(TokenKind.Ident)

                # `common:` fields are constructor payload prefix fields inherited by
                # every packed variant. Preserve them instead of discarding the block.
                is_common: bool = Lexer::text_or_empty(variant_name, parser.source) == "common" and parser.peek() == TokenKind.Colon
                parser <- parser.parse_common_clause(common_fields, common_names) if is_common
                continue if is_common

                field_items: mutable darray[Ast::Expr] = [common_field for common_field in common_fields]
                field_names: mutable darray[sview] = [common_name for common_name in common_names]

                rebind accepted_lparen_2: bool, parser = parser.accept(TokenKind.LParen)
                parser <- parser.parse_enum_payload_fields(field_items, field_names) if accepted_lparen_2

                # `Variant = VALUE` — a const-enum member's explicit integer value.
                variant_value: mutable Ast::Expr = (Ast::Expr.Absent)
                rebind accepted_value_assign: bool, parser = parser.accept(TokenKind.Assign)
                parser <- parser.capture_variant_value(variant_value) if accepted_value_assign
                variant: Ast::EnumVariant = Ast::EnumVariant{name: Lexer::text_or_empty(variant_name, parser.source), fields: field_items, field_names: field_names, value_expr: variant_value}
                variants.push(variant)
                parser, _ <- parser.accept(TokenKind.Newline)

            parser, _ <- parser.expect(TokenKind.Dedent)
            parser.captured_enum_common_count <- common_fields.count.u32()
            return variants

        # `common:` shared-fields block, entered just after the consumed `common` name.
        def parse_common_clause(parser: lmut Parser, fields: mutable darray[Ast::Expr]&, names: mutable darray[sview]&) -> void:
            parser, _ <- parser.expect(TokenKind.Colon)
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)
            while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser, fields, names|:
                parser <- parser.skip_newlines()
                break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof
                if parser.peek() == TokenKind.At:
                    rebind at_token: Token, parser = parser.advance()
                    rebind annotation_token: Token, parser = parser.expect(TokenKind.Ident)
                    parser, _ <- parser.expect(TokenKind.LParen)
                    rebind mode_token: Token, parser = parser.expect(TokenKind.Ident)
                    mode: sview = Lexer::text_or_empty(mode_token, parser.source)
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, mode_token) if mode != "inline" and mode != "side_table"
                    parser, _ <- parser.expect(TokenKind.RParen)
                    parser, _ <- parser.accept(TokenKind.Newline)
                    continue
                rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
                common_name: sview = Lexer::text_or_empty(name_token, parser.source)
                parser, _ <- parser.expect(TokenKind.Colon)
                rebind field_option: Ast::Expr?, parser = parser.expression()
                fields.push(field_value) if field_option is field_value
                names.push(common_name) if field_option is field_value
                parser, _ <- parser.accept(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Dedent)

        # Parse the comma-separated `(name: type, ...)` payload fields of an enum
        # variant, entered just past the accepted opening `(`.
        def parse_enum_payload_fields(parser: lmut Parser, field_items: mutable darray[Ast::Expr]&, field_names: mutable darray[sview]&) -> void:
            while parser.peek() != TokenKind.RParen and parser.peek() != TokenKind.Eof |parser, field_items, field_names|:
                field_name: mutable sview = ""
                # Payload fields are `name: type`; keep the optional label parallel to
                # the type expression for named-constructor checks. `name?: type` marks
                # an optional (absent-allowed) payload field — the `?` is part of the
                # field name clause, not the type.
                is_labeled: bool = parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon
                is_optional_labeled: bool = not is_labeled and parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Question and parser.peek_at(2) == TokenKind.Colon
                parser <- parser.capture_labeled_field_name(field_name) if is_labeled
                parser <- parser.capture_optional_labeled_field_name(field_name) if is_optional_labeled
                rebind parsed_field_opt: Ast::Expr?, parser = parser.expression()
                if parsed_field_opt is parsed_field:
                    field_items.push(parsed_field)
                    field_names.push(field_name)
                rebind accepted_comma_2: bool, parser = parser.accept(TokenKind.Comma)
                break if not accepted_comma_2
            parser, _ <- parser.expect(TokenKind.RParen)

        # `name: ` labeled payload-field head, entered with the cursor on `name`.
        def capture_labeled_field_name(parser: lmut Parser, field_name: mutable sview&) -> void:
            rebind field_name_token: Token, parser = parser.advance()
            field_name <- Lexer::text_or_empty(field_name_token, parser.source)
            parser, _ <- parser.advance()               # `:`

        # `name?: ` optional labeled payload-field head, entered with the cursor on `name`.
        def capture_optional_labeled_field_name(parser: lmut Parser, field_name: mutable sview&) -> void:
            rebind optional_field_name_token: Token, parser = parser.advance()
            field_name <- Lexer::text_or_empty(optional_field_name_token, parser.source)
            parser, _ <- parser.advance()               # `?`
            parser, _ <- parser.advance()               # `:`

        # `Variant = VALUE` explicit const-enum value, entered just past the accepted `=`.
        def capture_variant_value(parser: lmut Parser, variant_value: mutable Ast::Expr&) -> void:
            rebind parsed_value_opt: Ast::Expr?, parser = parser.expression()
            if parsed_value_opt is parsed_value:
                variant_value <- parsed_value
