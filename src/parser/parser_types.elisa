# Stage1 parser — declaration parsing, part 2 (`extend Parser:`). Covers error-type,
# extern, func, struct, and enum/const declarations (private), plus the public
# `parse_file` region-polymorphic entry point. Continues from parser_decl.elisa. Split
# out of parser.elisa to keep each part file under 600 lines.

extend Parser:
    private:
        # `error Name:` error-type declaration with an indented body of variants/fields.
        # The body is skipped; the name is recorded as an Alias node.
        def error_type_decl(parser: lmut Parser) -> Ast::Decl?:
            rebind tok: Token, parser = parser.expect(TokenKind.Error)
            rebind name_tok: Token, parser = parser.expect(TokenKind.Ident)
            parser <- parser.skip_decl_header_clauses()
            if parser.peek() == TokenKind.Colon and parser.peek_at(1) == TokenKind.Newline:
                parser, _ <- parser.advance()
                parser, _ <- parser.expect(TokenKind.Newline)
                rebind accepted_indent: bool, parser = parser.accept(TokenKind.Indent)
                if accepted_indent:
                    while depth > 0 and parser.peek() != TokenKind.Eof |parser, depth: int = 1|:
                        rebind adv_tok_kind: Token, parser = parser.advance()

                        kind: TokenKind = adv_tok_kind.kind
                        if kind == TokenKind.Indent:
                            depth <- depth + 1
                        elif kind == TokenKind.Dedent:
                            depth <- depth - 1
            return (Ast::Decl.Alias(Lexer::text_or_empty(name_tok, parser.source), (Ast::Expr.Invalid), tok.line))


        # `extern <signature>` / `extern <Name>` (FFI import or opaque type) and
        # `export fn name -> target` / `extern:`/`export:` blocks. Their internals
        # aren't modeled yet; consume the declaration line (and any indented block) so
        # the surrounding module parses. Recorded as an Invalid declaration node.
        def extern_decl(parser: lmut Parser) -> Ast::Decl?:
            rebind tok: Token, parser = parser.advance()              # `extern` / `export`
            # `export fn NAME …` / `export def NAME …`: skip the leading func/def word
            # so the captured name is the exported symbol, not the keyword.
            parser, _ <- parser.accept(TokenKind.Def)
            if parser.peek() == TokenKind.Ident:
                func_word: Token = parser.cursor()
                if Lexer::text_or_empty(func_word, parser.source) == "func":
                    parser, _ <- parser.advance()
            # The external name is the first identifier; record it so it becomes a symbol.
            name: mutable sview = ""
            if parser.peek() == TokenKind.Ident:
                name_cur: Token = parser.cursor()
                name <- Lexer::text_or_empty(name_cur, parser.source)
                parser, _ <- parser.advance()
            parser <- parser.skip_decl_header_clauses()          # to the block colon or end of line
            # Only `extern:` / `export:` followed by a newline opens an indented block;
            # a typed `extern name: T` stops at the colon (skip the rest of the line).
            if parser.peek() == TokenKind.Colon and parser.peek_at(1) == TokenKind.Newline:
                parser, _ <- parser.advance()
                rebind accepted_newline: bool, parser = parser.accept(TokenKind.Newline)
                entered_block: mutable bool = false
                if accepted_newline:
                    rebind accepted_indent: bool, parser = parser.accept(TokenKind.Indent)
                    entered_block <- accepted_indent
                if entered_block:
                    while depth > 0 and parser.peek() != TokenKind.Eof |parser, depth: int = 1|:
                        rebind adv_tok_kind: Token, parser = parser.advance()

                        kind: TokenKind = adv_tok_kind.kind
                        if kind == TokenKind.Indent:
                            depth <- depth + 1
                        elif kind == TokenKind.Dedent:
                            depth <- depth - 1
            else:
                # Typed `extern name: T` (or any single-line extern): consume the
                # remainder of the line (the `: T`) so it isn't reparsed.
                while parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser|:
                    parser, _ <- parser.advance()
            return (Ast::Decl.Extern(name, tok.line))


        def func_decl(parser: lmut Parser) -> Ast::Decl?:
            rebind tok: Token, parser = parser.expect(TokenKind.Def)
            rebind name_tok: Token, parser = parser.expect(TokenKind.Ident)

            # Leading `@name` decorators were captured just before dispatch; snapshot them
            # now before any nested parse clobbers the parser's pending buffer.
            decorators: mutable darray[sview] = []
            for d in parser.pending_decorators |decorators|:
                decorators.push(d)

            # Optional generic/region params `[T]`, `[K, V]`, `[@r]` between name and `(`.
            rebind accepted_lbracket: bool, parser = parser.accept(TokenKind.LBracket)
            if accepted_lbracket:
                while gp_depth > 0 and parser.peek() != TokenKind.Eof |parser, gp_depth: int = 1|:
                    rebind adv_tok_gk: Token, parser = parser.advance()

                    gk: TokenKind = adv_tok_gk.kind
                    if gk == TokenKind.LBracket:
                        gp_depth <- gp_depth + 1
                    elif gk == TokenKind.RBracket:
                        gp_depth <- gp_depth - 1

            param_items: mutable darray[Ast::ParamDecl] = []
            rebind accepted_lparen: bool, parser = parser.accept(TokenKind.LParen)
            if accepted_lparen:
                while parser.peek() != TokenKind.RParen and parser.peek() != TokenKind.Eof |parser, param_items|:
                    # Legacy leading `mutable name:` form; the canonical `name: mutable T&`
                    # form is captured by the type expression itself.
                    rebind leading_mutable: bool, parser = parser.accept(TokenKind.Mutable)
                    rebind param_name: Token, parser = parser.expect(TokenKind.Ident)
                    parser, _ <- parser.expect(TokenKind.Colon)
                    rebind type_expr: Ast::Expr?, parser = parser.expr()

                    # Optional `@region` binding on the param type (`out: darray[u8]& @r`)
                    # pinning the parameter to a region-polymorphic region declared in the
                    # `[@r]` generic list. The region name is a selector, not a value ref;
                    # consume and discard it (mirrors struct-field / var-decl handling).
                    rebind accepted_at: bool, parser = parser.accept(TokenKind.At)
                    if accepted_at:
                        parser, _ <- parser.accept(TokenKind.Ident)

                    # Trailing function-type effect clause on the param type
                    # (`body: fn(usize) -> i64 can[Abort.Panic]`): skip the balanced
                    # `can[...]` so it isn't mistaken for the next parameter.
                    can_tok: Token = parser.cursor()
                    if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(can_tok, parser.source) == "can" and parser.peek_at(1) == TokenKind.LBracket:
                        parser, _ <- parser.advance()
                        parser, _ <- parser.accept(TokenKind.LBracket)
                        while can_depth > 0 and parser.peek() != TokenKind.Eof |parser, can_depth: int = 1|:
                            rebind adv_tok_bk: Token, parser = parser.advance()

                            bk: TokenKind = adv_tok_bk.kind
                            if bk == TokenKind.LBracket:
                                can_depth <- can_depth + 1
                            elif bk == TokenKind.RBracket:
                                can_depth <- can_depth - 1

                    # Optional default value `param: T = <expr>`. Recorded on the
                    # ParamDecl (pushed below, once the full param clause is known) so
                    # arity checking can split required from defaultable parameters.
                    rebind param_has_default: bool, parser = parser.accept(TokenKind.Assign)
                    if param_has_default:
                        parser, _ <- parser.expr()

                    if type_expr is param_type:
                        param: Ast::ParamDecl = Ast::ParamDecl{name: Lexer::text_or_empty(param_name, parser.source), type_expr: param_type, is_mutable: leading_mutable, has_default: param_has_default}
                        param_items.push(param)

                    rebind accepted_comma: bool, parser = parser.accept(TokenKind.Comma)
                    if not accepted_comma:
                        break

                parser, _ <- parser.expect(TokenKind.RParen)

            effects: mutable darray[sview] = []

            return_type: mutable Ast::Expr? = null
            rebind accepted_arrow: bool, parser = parser.accept(TokenKind.Arrow)
            if accepted_arrow:
                rebind ret: Ast::Expr?, parser = parser.expr()
                if ret is parsed_return_type:
                    return_type <- parsed_return_type
                # The return-type `expr()` consumes a trailing effect grant
                # (`-> T can[...]`) via skip_trailing_can; recover it from the parser.
                for e in parser.captured_effects |effects|:
                    effects.push(e)

            # Remaining signature clauses before the body colon: a bare `can` grant when
            # there is no return type, plus error sets (`raises ...`) and contracts
            # (`requires`/`ensures`), which are consumed without modeling.
            parser <- parser.parse_signature_clauses(effects)

            body: mutable darray[Ast::Stmt] = []
            rebind accepted_assign: bool, parser = parser.accept(TokenKind.Assign)
            if accepted_assign:
                # Expression-bodied function `def f(...) -> T = EXPR` == a body of a
                # single `return EXPR` (same `=` "definition is this expression" as
                # law/type/alias). The return value is an `Expr?` (matching
                # Stmt.Return's payload). The one-element body is built as a list
                # literal (not `[]`+push): a push-only fresh darray does not survive
                # the region-polymorphic return, but a seeded literal is adopted.
                value_tok: Token = parser.cursor()
                ret_value: mutable Ast::Expr? = null
                rebind value_expr_opt: Ast::Expr?, parser = parser.expr()
                if value_expr_opt is value_expr:
                    ret_value <- value_expr
                body, parser <- parser.single_stmt_body((Ast::Stmt.Return(ret_value, value_tok.line)))
            elif parser.peek() == TokenKind.Colon:
                body, parser <- parser.parse_block()

            return (Ast::Decl.Func(Lexer::text_or_empty(name_tok, parser.source), param_items, return_type, body, effects, decorators, tok.line))


        # Parse the indented body of a struct: `(IDENT : <type> NEWLINE)*`.
        # Non-field forms (e.g. `pass`, `bitset:`) are skipped token-by-token so an
        # unrecognized member never derails the surrounding declaration.
        def struct_member_block(parser: lmut Parser) -> darray[Ast::StructMember]:
            parser, _ <- parser.expect(TokenKind.Colon)
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)

            members: mutable darray[Ast::StructMember] = []
            while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser, members|:
                parser <- parser.skip_newlines()
                if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof:
                    break
                if parser.peek() != TokenKind.Ident:
                    parser, _ <- parser.advance()
                    continue

                # `derive state:` — typestate derivation block (`struct X[state A | B]:`),
                # an indented list of `Variant when PREDICATE` lines mapping field values
                # to states. Not modeled in stage1; the whole block is skipped.
                derive_tok: Token = parser.cursor()
                if Lexer::text_or_empty(derive_tok, parser.source) == "derive" and parser.peek_at(1) == TokenKind.Ident and parser.peek_at(2) == TokenKind.Colon:
                    parser, _ <- parser.advance()                   # `derive`
                    parser, _ <- parser.advance()                   # `state` (the derived clause name)
                    parser, _ <- parser.advance()                   # `:`
                    parser <- parser.skip_indented_block()
                    parser, _ <- parser.accept(TokenKind.Newline)
                    continue

                # `ghost NAME: T` — a verification-only model field, erased at codegen.
                # Not yet modeled distinctly in the stage1 AST; parsed as an ordinary
                # field so the member line doesn't cascade. Disambiguated like stage0:
                # `ghost` is a leading IDENT immediately followed by another IDENT (the
                # field name), so a field literally named `ghost` (`ghost: T`) still
                # parses as an ordinary field.
                ghost_tok: Token = parser.cursor()
                if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(ghost_tok, parser.source) == "ghost" and parser.peek_at(1) == TokenKind.Ident:
                    parser, _ <- parser.advance()

                # Struct-body design-by-contract clause (`invariant EXPR` — a leading
                # `self.field …` predicate, not yet modeled in the stage1 AST). Same
                # contextual-keyword disambiguation as `contract_stmt`: only treated as
                # a clause when a value-starting token follows on the same line, so a
                # field literally named `invariant` still parses as `invariant: T`.
                head_tok: Token = parser.cursor()
                if Lexer::text_or_empty(head_tok, parser.source) == "invariant":
                    n1: TokenKind = parser.peek_at(1)
                    if n1 in {TokenKind.Ident, TokenKind.IntLit, TokenKind.FloatLit, TokenKind.StringLit, TokenKind.CharLit, TokenKind.True, TokenKind.False, TokenKind.Not}:
                        while parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Eof |parser|:
                            parser, _ <- parser.advance()
                        parser, _ <- parser.accept(TokenKind.Newline)
                        continue

                rebind member_name: Token, parser = parser.expect(TokenKind.Ident)
                # `name?: T` — optional (absent-allowed) field; the `?` belongs to the
                # field-name clause (mirrors the enum-payload spelling). An optional field
                # may be omitted in a by-label construction.
                rebind is_optional: bool, parser = parser.accept(TokenKind.Question)
                parser, _ <- parser.expect(TokenKind.Colon)
                rebind member_type_opt: Ast::Expr?, parser = parser.expr()
                if member_type_opt is member_type:
                    # Optional default value `name: T = <expr>` — the type parser stops
                    # at `=` (precedence 0), so consume the default explicitly (it was
                    # previously swallowed token-by-token by the non-Ident recovery). A
                    # defaulted field, like an optional one, may be omitted in a literal.
                    has_default: mutable bool = false
                    rebind accepted_assign_2: bool, parser = parser.accept(TokenKind.Assign)
                    if accepted_assign_2:
                        has_default <- true
                        parser, _ <- parser.expr()
                    member: Ast::StructMember = Ast::StructMember{name: Lexer::text_or_empty(member_name, parser.source), type_expr: member_type, omittable: is_optional or has_default}
                    members.push(member)
                    # Optional `@region` field annotation (`next: T @owner`) — a region
                    # selector, not part of the field type; consumed and discarded.
                    rebind accepted_at_2: bool, parser = parser.accept(TokenKind.At)
                    if accepted_at_2:
                        parser, _ <- parser.accept(TokenKind.Ident)
                    # Guest-overlay member clauses (`struct X layout(guest, size: N):`):
                    # `field: type at OFFSET [requires size >= N]`. The offset and the
                    # minimum-size guard aren't modeled in stage1; consume them so the
                    # member line parses (offsets/widths are a stage0 overlay concern).
                    at_tok: Token = parser.cursor()
                    if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(at_tok, parser.source) == "at":
                        parser, _ <- parser.advance()               # `at`
                        parser, _ <- parser.advance()               # OFFSET (int/hex literal)
                        req_tok: Token = parser.cursor()
                        if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(req_tok, parser.source) == "requires":
                            while parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Eof |parser|:
                                parser, _ <- parser.advance()       # `requires size >= N`

                # A field with its own indented block (`flags: bitset:` then flag names) —
                # the type expr above consumed `bitset`; skip the trailing `: NEWLINE INDENT
                # ... DEDENT` so the flag lines aren't parsed as malformed members.
                if parser.peek() == TokenKind.Colon and parser.peek_at(1) == TokenKind.Newline:
                    parser, _ <- parser.advance()                 # the nested `:`
                    parser, _ <- parser.expect(TokenKind.Newline)
                    rebind accepted_indent_2: bool, parser = parser.accept(TokenKind.Indent)
                    if accepted_indent_2:
                        while depth > 0 and parser.peek() != TokenKind.Eof |parser, depth: int = 1|:
                            rebind adv_tok_kind: Token, parser = parser.advance()

                            kind: TokenKind = adv_tok_kind.kind
                            if kind == TokenKind.Indent:
                                depth <- depth + 1
                            elif kind == TokenKind.Dedent:
                                depth <- depth - 1
                parser, _ <- parser.accept(TokenKind.Newline)

            parser, _ <- parser.expect(TokenKind.Dedent)
            return members


        # Parse the indented body of an enum: `(IDENT [ ( <field>, ... ) ] NEWLINE)*`.
        def enum_variant_block(parser: lmut Parser) -> darray[Ast::EnumVariant]:
            parser, _ <- parser.expect(TokenKind.Colon)
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)

            variants: mutable darray[Ast::EnumVariant] = []
            while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser, variants|:
                parser <- parser.skip_newlines()
                if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof:
                    break
                if parser.peek() != TokenKind.Ident:
                    parser, _ <- parser.advance()
                    continue

                rebind variant_name: Token, parser = parser.expect(TokenKind.Ident)

                # `common:` — an indented block of fields shared by every variant, not a
                # variant itself. Not modeled here; skip the block so the real variants
                # that follow parse cleanly.
                if Lexer::text_or_empty(variant_name, parser.source) == "common" and parser.peek() == TokenKind.Colon:
                    parser, _ <- parser.advance()                       # `:`
                    parser, _ <- parser.accept(TokenKind.Newline)
                    rebind accepted_indent_3: bool, parser = parser.accept(TokenKind.Indent)
                    if accepted_indent_3:
                        while depth > 0 and parser.peek() != TokenKind.Eof |parser, depth: int = 1|:
                            rebind adv_tok_k: Token, parser = parser.advance()

                            k: TokenKind = adv_tok_k.kind
                            if k == TokenKind.Indent:
                                depth <- depth + 1
                            elif k == TokenKind.Dedent:
                                depth <- depth - 1
                    continue

                field_items: mutable darray[Ast::Expr] = []

                rebind accepted_lparen_2: bool, parser = parser.accept(TokenKind.LParen)
                if accepted_lparen_2:
                    while parser.peek() != TokenKind.RParen and parser.peek() != TokenKind.Eof |parser, field_items|:
                        # Payload fields are `name: type`; the name is recorded structurally
                        # by position, so only the type expression is kept as the field node.
                        # `name?: type` marks an optional (absent-allowed) payload field —
                        # the `?` is part of the field name clause, not the type.
                        if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon:
                            parser, _ <- parser.advance()
                            parser, _ <- parser.advance()
                        elif parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Question and parser.peek_at(2) == TokenKind.Colon:
                            parser, _ <- parser.advance()
                            parser, _ <- parser.advance()
                            parser, _ <- parser.advance()
                        rebind parsed_field_opt: Ast::Expr?, parser = parser.expr()
                        if parsed_field_opt is parsed_field:
                            field_items.push(parsed_field)
                        rebind accepted_comma_2: bool, parser = parser.accept(TokenKind.Comma)
                        if not accepted_comma_2:
                            break
                    parser, _ <- parser.expect(TokenKind.RParen)

                variant: Ast::EnumVariant = Ast::EnumVariant{name: Lexer::text_or_empty(variant_name, parser.source), fields: field_items}
                variants.push(variant)
                parser, _ <- parser.accept(TokenKind.Newline)

            parser, _ <- parser.expect(TokenKind.Dedent)
            return variants

