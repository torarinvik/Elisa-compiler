# Stage1 parser — token cursor and block parsing (`extend Parser: private:`). Covers
# `cursor`/`peek`/`advance`/`accept`/`expect`, error recording, and `parse_block` with
# its inline and indented variants. Continues parser_core.elisa (the canonical
# `module Parser:`); split out to keep each part file under 600 lines.

extend Parser:
    private:
        # ============================================================
        # Token consumption helpers
        #
        # Every part file (parser_expr.elisa / parser_stmt.elisa / parser_decl.elisa /
        # parser_types.elisa) reads the token stream exclusively through this small set of
        # helpers — `cursor`/`peek`/`peek_at` for lookahead, `advance`/`accept`/`expect` for
        # consumption, and `error_at` for recording a located parse error without aborting
        # the parse (recovery keeps scanning so one bad token doesn't cascade into losing
        # every declaration after it). Nothing outside this file indexes `parser.tokens`
        # directly, which keeps the EOF/out-of-range sentinel handling in exactly one place.
        # ============================================================

        def cursor(parser: Parser&) -> Token:
            zero: Token = zeroed
            zero.kind <- TokenKind.Eof
            machine over parser.position:
                state Cursor
                start Cursor

                Cursor, _ if parser.position < parser.tokens.count:
                    return parser.tokens[parser.position]

                Cursor, _:
                    return zero

            return zero


        def peek(parser: Parser&) -> TokenKind:
            return parser.cursor().kind


        # Lookahead by `offset` tokens without advancing. Out-of-range reads as Eof,
        # so callers never index past the token stream.
        def peek_at(parser: Parser&, offset: usize) -> TokenKind:
            token_index: usize = parser.position + offset
            machine over token_index:
                state Peek
                start Peek

                Peek, _ if token_index < parser.tokens.count:
                    return parser.tokens[token_index].kind

                Peek, _:
                    return TokenKind.Eof

            return TokenKind.Eof


        # Whether the token consumed immediately before the current position was a
        # Dedent — the boundary a multi-line block expression (match arms, an indented
        # value block) leaves behind. A postfix-ternary `if` directly after that
        # boundary belongs to the NEXT statement, not the just-closed expression
        # (mirrors stage0's prevTokenIsDedent).
        def prev_is_dedent(parser: Parser&) -> bool:
            return parser.position != 0 and parser.position <= parser.tokens.count and parser.tokens[parser.position - 1].kind == TokenKind.Dedent


        # Consume a run of layout Newlines. Blank lines and statement terminators
        # collapse here so block/declaration loops only ever see real grammar tokens.
        def skip_newlines(parser: lmut Parser) -> void:
            machine over parser.position while parser.peek() == TokenKind.Newline:
                state Drain
                start Drain

                Drain, _:
                    parser.position <- parser.position + 1
                    -> Drain


        def advance(parser: lmut Parser) -> Token:
            token: Token = parser.cursor()
            machine over parser.position:
                state Advance
                start Advance

                Advance, _ if parser.position < parser.tokens.count:
                    parser.position <- parser.position + 1
                    return token

                Advance, _:
                    return token

            return token


        def accept(parser: lmut Parser, kind: TokenKind) -> bool:
            machine over parser.position:
                state Accept
                start Accept

                Accept, _ if parser.peek() != kind:
                    return false

                Accept, _ if parser.position < parser.tokens.count:
                    parser.position <- parser.position + 1
                    return true

                Accept, _:
                    return true

            return false


        def expect(parser: lmut Parser, kind: TokenKind) -> Token:
            current_token: Token = parser.cursor()
            # `;` where a statement newline is required. The separator has been removed, so
            # stage0's expectNewline reports it once and CONSUMES it: the statements after it
            # on the same line still parse, instead of spilling out as top-level junk.
            if kind == TokenKind.Newline and current_token.kind == TokenKind.Semicolon:
                parser <- parser.error_removed(current_token, "`;` statement separator has been removed; put each statement on its own line (or use `def f(...) -> T = EXPR` for a one-expression body)")
                parser.position <- parser.position + 1 if parser.position < parser.tokens.count
                return current_token
            machine over parser.position:
                state Expect
                start Expect

                Expect, _ if current_token.kind != kind and parser.position < parser.tokens.count:
                    parser <- parser.error_expected(kind, current_token)
                    parser.position <- parser.position + 1
                    return current_token

                Expect, _ if current_token.kind != kind:
                    parser <- parser.error_expected(kind, current_token)
                    return current_token

                Expect, _ if parser.position < parser.tokens.count:
                    parser.position <- parser.position + 1
                    return current_token

                Expect, _:
                    return current_token

            return current_token


        def error_at(parser: lmut Parser, kind: Ast::ParseErrorKind, token: Token) -> void:
            parse_error: Ast::ParseError = Ast::ParseError{
                kind: kind,
                line: token.line,
                column: token.column,
                context: Lexer::text_or_empty(token, parser.source),
                got_kind: token.kind,
                expected_kind: TokenKind.Eof,
                has_expected: false
            }
            parser.errors <- parser.errors.push(parse_error)

        # `expected KIND, got TOKEN` -- the wanted kind travels with the error (stage0's wording).
        def error_expected(parser: lmut Parser, expected: TokenKind, token: Token) -> void:
            parser.errors <- parser.errors.push(Ast::ParseError{kind: Ast::ParseErrorKind.ExpectedToken, line: token.line, column: token.column, context: Lexer::text_or_empty(token, parser.source), got_kind: token.kind, expected_kind: expected, has_expected: true})

        # A sentence that NAMES something. `detail`/`detail2` are views into the source, and
        # the renderer composes the sentence from them (see Ast::ParseError).
        def error_named(parser: lmut Parser, kind: Ast::ParseErrorKind, token: Token, detail: sview, detail2: sview, detail_num: u32 = 0, detail_num2: u32 = 0, detail_num3: u32 = 0) -> void:
            parser.errors <- parser.errors.push(Ast::ParseError{kind: kind, line: token.line, column: token.column, context: Lexer::text_or_empty(token, parser.source), got_kind: token.kind, expected_kind: TokenKind.Eof, has_expected: false, detail: detail, detail2: detail2, detail_num: detail_num, detail_num2: detail_num2, detail_num3: detail_num3})

        # Same, addressing the token by INDEX. `parser.error_named(..., parser.tokens[i], ...)`
        # names `parser` twice in one call, which the linear-mutable rule refuses; reading the
        # token into a local first is the shape that passes.
        def error_named_at(parser: lmut Parser, kind: Ast::ParseErrorKind, token_index: usize, detail: sview, detail2: sview, detail_num: u32 = 0, detail_num2: u32 = 0) -> void:
            token: Token = parser.tokens[token_index]
            parser <- parser.error_named(kind, token, detail, detail2, detail_num, detail_num2)

        # A removed spelling, reported with stage0's sentence (parse_error_message_diff).
        def error_removed(parser: lmut Parser, token: Token, message: sview) -> void:
            parser.errors <- parser.errors.push(Ast::ParseError{kind: Ast::ParseErrorKind.Removed, line: token.line, column: token.column, context: message, got_kind: token.kind, expected_kind: TokenKind.Eof, has_expected: false})

        # After a REMOVED construct's diagnostic: consume the rest of its line (and, for
        # skip_removed_construct, the indented block that follows). stage0 reports the removal
        # ONCE; stage1 used to cascade a second and third "unexpected token" from the residue.
        def skip_removed_line(parser: lmut Parser) -> void:
            while parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Eof |parser|:
                parser, _ <- parser.advance()

        def skip_removed_construct(parser: lmut Parser) -> void:
            parser <- parser.skip_removed_line()
            parser, _ <- parser.advance() if parser.peek() == TokenKind.Newline
            if parser.peek() == TokenKind.Indent:
                depth: mutable int = 1
                parser, _ <- parser.advance()
                while depth > 0 and parser.peek() != TokenKind.Eof |parser, depth|:
                    depth <- depth + 1 if parser.peek() == TokenKind.Indent
                    depth <- depth - 1 if parser.peek() == TokenKind.Dedent
                    parser, _ <- parser.advance()


        # Parse a `:`-introduced statement block and return the block's statements as a
        # `darray[Stmt]` — the side-table that hangs directly off the owning node's payload
        # (docs/76). Two layouts are accepted, matching the lexer's token model:
        #   inline    `: <statement> NEWLINE`
        #   indented  `: NEWLINE INDENT (<statement> NEWLINE)* DEDENT`
        # The opening Colon and all layout tokens (Newline/Indent/Dedent) are consumed
        # here, so statement parsers never see layout noise.
        # Wrap a single statement into a body darray. A region-poly return (like
        # parse_block's) so the caller adopts the darray into its region — a body
        # darray built inline in function_declaration and stored straight into the Decl.Func
        # packed payload does NOT survive the region-polymorphic return.
        def single_statement_body(parser: lmut Parser, only_statement: Ast::Stmt) -> darray[Ast::Stmt]:
            # A one-element list literal, region-poly like parse_block's return so the
            # caller adopts it into its region.
            return [only_statement]


        def parse_block(parser: lmut Parser) -> darray[Ast::Stmt]:
            parser, _ <- parser.expect(TokenKind.Colon)
            # Dispatch the two block layouts as one transition: the input token is
            # the layout state, so the parser never nests a sequential conditional.
            machine over parser.peek() == TokenKind.Newline:
                state Layout
                start Layout

                Layout, true:
                    rebind indented_items: darray[Ast::Stmt], parser = parser.parse_indented_block_if(true)
                    return [item for item in indented_items]

                Layout, _:
                    rebind inline_items: darray[Ast::Stmt], parser = parser.parse_inline_block_if(true)
                    return [item for item in inline_items]

            return []

        # A FUNCTION body after `:`. Identical to parse_block except for the INLINE layout:
        # stage0's parseFuncBodyAfterColon keeps taking statements while the cursor stays on
        # the opening line, so `def f() -> T: a; b` is one body of two statements. A
        # STATEMENT's inline body (`if c: return x`) is exactly one statement in both, which
        # is why this cannot simply replace parse_block.
        def parse_function_block(parser: lmut Parser) -> darray[Ast::Stmt]:
            parser, _ <- parser.expect(TokenKind.Colon)
            machine over parser.peek() == TokenKind.Newline:
                state Layout
                start Layout

                Layout, true:
                    rebind indented_items: darray[Ast::Stmt], parser = parser.parse_indented_block_if(true)
                    return [item for item in indented_items]

                Layout, _:
                    rebind inline_function_items: darray[Ast::Stmt], parser = parser.parse_inline_function_body_if(true)
                    return [item for item in inline_function_items]

            return []


        # The inline layout of a function body. Takes statements while the cursor stays on the
        # body's opening line; a `;` between them is the removed separator, reported once and
        # consumed so the statements after it still parse instead of spilling to top level.
        def parse_inline_function_body_if(parser: lmut Parser, cond: bool) -> darray[Ast::Stmt]:
            empty_function_body: darray[Ast::Stmt] = []
            empty_function_body return if not cond
            items: mutable darray[Ast::Stmt] = []
            inline_line: u32 = parser.cursor().line
            while parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Eof and parser.peek() != TokenKind.Dedent |parser, items|:
                break if parser.cursor().line != inline_line and parser.cursor().line != 0
                rebind inline_function_statement: Ast::Stmt?, parser = parser.statement()
                if inline_function_statement is function_body_statement:
                    parser <- parser.push_statement_with_pending(items, function_body_statement)
                else:
                    parser, _ <- parser.advance()   # error recovery: never spin on a bad token
                parser <- parser.skip_trailing_can(true)
                if parser.peek() == TokenKind.Semicolon:
                    inline_semicolon_token: Token = parser.cursor()
                    parser <- parser.error_removed(inline_semicolon_token, "`;` statement separator has been removed; put each statement on its own line (or use `def f(...) -> T = EXPR` for a one-expression body)")
                    parser, _ <- parser.advance()
            parser, _ <- parser.accept(TokenKind.Newline)
            return items


        # Inline single-statement block: `if condition: return x`.
        def parse_inline_block_if(parser: lmut Parser, cond: bool) -> darray[Ast::Stmt]:
            empty_body: darray[Ast::Stmt] = []
            empty_body return if not cond
            items: mutable darray[Ast::Stmt] = []
            rebind __m_179: Ast::Stmt?, parser = parser.statement()
            if __m_179 is inline_statement:
                parser <- parser.push_statement_with_pending(items, inline_statement)
            parser <- parser.skip_trailing_can(true)
            parser, _ <- parser.accept(TokenKind.Newline)
            return items

        # Indented block.
        def parse_indented_block_if(parser: lmut Parser, cond: bool) -> darray[Ast::Stmt]:
            empty_body: darray[Ast::Stmt] = []
            empty_body return if not cond
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)
            items: mutable darray[Ast::Stmt] = []

            machine over parser.position while true:
                state More
                state Check
                start More

                More, _:
                    parser <- parser.skip_newlines()
                    -> Check

                Check, _ if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof:
                    break

                Check, _:
                    parser <- parser.consume_indented_statement(items)
                    -> More

            parser, _ <- parser.expect(TokenKind.Dedent)
            return items

        # Push one parsed statement, then the statements its parse queued on
        # `pending_statements` (a multi-target `rebind`'s per-target writes), flat and in order.
        def push_statement_with_pending(parser: lmut Parser, items: mutable darray[Ast::Stmt]&, statement: Ast::Stmt) -> void:
            items.push(statement)
            return if parser.pending_statements.count == 0
            items.extend(parser.pending_statements)
            parser.pending_statements <- parser.pending_statements.truncate(0)

        def consume_indented_statement(parser: lmut Parser, items: mutable darray[Ast::Stmt]&) -> void:
            rebind __m_192: Ast::Stmt?, parser = parser.statement()
            if __m_192 is body_statement:
                parser <- parser.push_statement_with_pending(items, body_statement)
                parser <- parser.skip_trailing_can(true)
                parser <- parser.expect_statement_newline()
                parser, _ <- parser.accept(TokenKind.Newline)
            else:
                parser, _ <- parser.advance()   # error recovery: never spin on a bad token

        # stage0's expectNewline. A statement ends at a NEWLINE, or at the EOF/DEDENT that
        # closes its block; a `;` is the removed separator (named sentence, then consumed so
        # the rest of the line still parses), and anything else is `expected newline, got X`,
        # reported WITHOUT consuming it -- stage0 leaves the token for the next statement.
        #
        # stage1 cannot ask "is the cursor on a newline?" the way stage0 does: many of its
        # statement parsers consume their own trailing newline, so by the time control gets
        # here the cursor is usually already the NEXT line's first token. Asking that
        # question directly rejected 30+ valid std-library statements. The condition that
        # actually distinguishes the two is whether anything is LEFT OVER on the statement's
        # own line, which takes BOTH tests below:
        #
        #   - the token before the cursor must be a real token, not layout. A NEWLINE carries
        #     the line it ENDS, but INDENT/DEDENT are emitted after the cursor has moved, so
        #     they carry the line they OPEN -- a line test alone fires on every statement that
        #     follows an inner block (293 valid std-library statements did).
        #   - and the cursor must still sit on that token's line.
        def statement_line_has_leftover(parser: Parser&) -> bool:
            return false if parser.position == 0 or parser.position >= parser.tokens.count
            previous_token: Token = parser.tokens[parser.position - 1]
            return false if previous_token.kind == TokenKind.Newline or previous_token.kind == TokenKind.Indent or previous_token.kind == TokenKind.Dedent
            current_token: Token = parser.tokens[parser.position]
            return current_token.line != 0 and current_token.line == previous_token.line

        def expect_statement_newline(parser: lmut Parser) -> void:
            return if not parser.statement_line_has_leftover()
            terminator: TokenKind = parser.peek()
            if terminator == TokenKind.Semicolon:
                semicolon_token: Token = parser.cursor()
                parser <- parser.error_removed(semicolon_token, "`;` statement separator has been removed; put each statement on its own line (or use `def f(...) -> T = EXPR` for a one-expression body)")
                parser, _ <- parser.advance()
                return
            return if terminator == TokenKind.Newline or terminator == TokenKind.Eof or terminator == TokenKind.Dedent
            terminator_token: Token = parser.cursor()
            parser <- parser.error_expected(TokenKind.Newline, terminator_token)


        # ============================================================
        # Synthesized removed-spelling sentences
        #
        # Several of stage0's removed-spelling sentences NAME the thing they refuse
        # (`shorthand named argument \`start:\` …`). A ParseError may only carry a SOURCE
        # sview or a static string literal — a view into a local darray dangles the moment
        # the frame goes — so the assembled text lives in the parser's long-lived
        # `module_name_storage`, reserved once up front so no push can move it.
        # ============================================================

        def removed_sentence[@r](parser: mutable Parser& @r, pieces: darray[sview]) -> sview:
            parser.module_name_storage.reserve(parser.tokens.count * 64 + 4096) if parser.module_name_storage.count == 0
            start: usize = parser.module_name_storage.count
            for piece in pieces |parser|:
                for piece_index in 0..<sview_len(piece) |parser|:
                    parser.module_name_storage.push(sview_at(piece, piece_index))
            count: usize = parser.module_name_storage.count - start
            return sview(&parser.module_name_storage[start], 0, count)


        # stage0's standalone-layout sentence, which carries the declared size twice. The
        # digits are materialised FIRST (before the sentence run begins) so both views point
        # into the same already-reserved storage.
        def standalone_layout_sentence[@r](parser: mutable Parser& @r, name: sview, size: u32) -> sview:
            parser.module_name_storage.reserve(parser.tokens.count * 64 + 4096) if parser.module_name_storage.count == 0
            digits: mutable darray[u8] = []
            remaining: mutable u32 = size
            while remaining > 0 |remaining, digits|:
                digits.push((48 + (remaining % 10)).u8())
                remaining <- remaining / 10
            size_start: usize = parser.module_name_storage.count
            digit_index: mutable i64 = digits.count.i64() - 1
            while digit_index >= 0 |digit_index, digits, parser|:
                parser.module_name_storage.push(digits[digit_index.usize()])
                digit_index <- digit_index - 1
            size_count: usize = parser.module_name_storage.count - size_start
            size_text: mutable sview = sview("", 0, 0)
            size_text <- sview(&parser.module_name_storage[size_start], 0, size_count) if size_count > 0
            pieces: mutable darray[sview] = []
            pieces.push("standalone `layout ")
            pieces.push(name)
            if size > 0:
                pieces.push(" size ")
                pieces.push(size_text)
            pieces.push(":` has been removed; use `struct ")
            pieces.push(name)
            if size > 0:
                pieces.push(" layout(guest, size: ")
                pieces.push(size_text)
                pieces.push("):` with `field: type at OFFSET` members")
            else:
                pieces.push(" layout(guest):` with `field: type at OFFSET` members")
            start: usize = parser.module_name_storage.count
            for piece in pieces |parser|:
                for piece_index in 0..<sview_len(piece) |parser|:
                    parser.module_name_storage.push(sview_at(piece, piece_index))
            count: usize = parser.module_name_storage.count - start
            return sview(&parser.module_name_storage[start], 0, count)


        # `layout NAME [size N]:` — the standalone guest overlay declaration (docs/107 §(a)),
        # replaced by the postfix `struct NAME layout(guest, size: N):` clause. Mirrors stage0's
        # looksLikeLayoutDecl: an identifier name, then the first COLON reached before any
        # `struct`/`enum`/`(`/newline decides it (so `layout soa struct Name:` is NOT this form).
        def looks_like_standalone_layout(parser: Parser&) -> bool:
            false return if parser.peek_at(1) != TokenKind.Ident
            scan: mutable usize = 1
            result: mutable bool = false
            while parser.position + scan < parser.tokens.count |scan, result|:
                kind: TokenKind = parser.tokens[parser.position + scan].kind
                if kind == TokenKind.Colon:
                    result <- true
                    break
                break if kind == TokenKind.Struct or kind == TokenKind.Enum or kind == TokenKind.LParen or kind == TokenKind.Newline or kind == TokenKind.Eof
                scan <- scan + 1
            return result


        # The `size N` clause of a standalone layout head, or 0 when it is absent.
        def standalone_layout_size(parser: Parser&) -> u32:
            zero: u32 = 0
            zero return if parser.peek_at(2) != TokenKind.Ident or parser.header_token_text(2) != "size"
            zero return if parser.position + 3 >= parser.tokens.count
            size_token: Token = parser.tokens[parser.position + 3]
            zero return if size_token.kind != TokenKind.IntLit
            return parse_layout_number(Lexer::text_or_empty(size_token, parser.source))


        # `rewrite EXPR as sequence[T]:` — the removed fold spelling. Contextual, so the claim
        # needs the `as` that follows on the SAME line; a variable named `rewrite` is untouched.
        def rewrite_as_ahead(parser: Parser&) -> bool:
            scan: mutable usize = 1
            found: mutable bool = false
            while parser.position + scan < parser.tokens.count |scan, found|:
                kind: TokenKind = parser.tokens[parser.position + scan].kind
                break if kind == TokenKind.Newline or kind == TokenKind.Eof
                if kind == TokenKind.As:
                    found <- true
                    break
                scan <- scan + 1
            return found
