# Stage1 parser — token cursor and block parsing (`extend Parser: private:`). Covers
# `cursor`/`peek`/`advance`/`accept`/`expect`, error recording, and `parse_block` with
# its inline and indented variants. Continues parser_core.elisa (the canonical
# `module Parser:`); split out to keep each part file under 600 lines.

extend Parser:
    private:
        # ============================================================
        # Token consumption helpers
        #
        # Every part file (parser_expr.elisa / parser_stmt.elisa / parser_decl.elisa /
        # parser_types.elisa) reads the token stream exclusively through this small set of
        # helpers — `cursor`/`peek`/`peek_at` for lookahead, `advance`/`accept`/`expect` for
        # consumption, and `error_at` for recording a located parse error without aborting
        # the parse (recovery keeps scanning so one bad token doesn't cascade into losing
        # every declaration after it). Nothing outside this file indexes `parser.tokens`
        # directly, which keeps the EOF/out-of-range sentinel handling in exactly one place.
        # ============================================================

        def cursor(parser: Parser&) -> Token:
            parser.tokens[parser.position] return if parser.position < parser.tokens.count
            zero: Token = zeroed
            zero.kind <- TokenKind.Eof
            return zero


        def peek(parser: Parser&) -> TokenKind:
            return parser.cursor().kind


        # Lookahead by `offset` tokens without advancing. Out-of-range reads as Eof,
        # so callers never index past the token stream.
        def peek_at(parser: Parser&, offset: usize) -> TokenKind:
            token_index: usize = parser.position + offset
            return TokenKind.Eof if token_index >= parser.tokens.count else parser.tokens[token_index].kind


        # Whether the token consumed immediately before the current position was a
        # Dedent — the boundary a multi-line block expression (match arms, an indented
        # value block) leaves behind. A postfix-ternary `if` directly after that
        # boundary belongs to the NEXT statement, not the just-closed expression
        # (mirrors stage0's prevTokenIsDedent).
        def prev_is_dedent(parser: Parser&) -> bool:
            return parser.position != 0 and parser.position <= parser.tokens.count and parser.tokens[parser.position - 1].kind == TokenKind.Dedent


        # Consume a run of layout Newlines. Blank lines and statement terminators
        # collapse here so block/declaration loops only ever see real grammar tokens.
        def skip_newlines(parser: lmut Parser) -> void:
            while parser.peek() == TokenKind.Newline |parser|:
                parser, _ <- parser.advance()


        def advance(parser: lmut Parser) -> Token:
            token: Token = parser.cursor()
            parser.position <-
                if parser.position < parser.tokens.count:
                   parser.position + 1
                else:
                    parser.position
            return token


        def accept(parser: lmut Parser, kind: TokenKind) -> bool:
            false return if parser.peek() != kind
            parser, _ <- parser.advance()
            return true


        def expect(parser: lmut Parser, kind: TokenKind) -> Token:
            current_token: Token = parser.cursor()
            parser <- parser.error_at(Ast::ParseErrorKind.ExpectedToken, current_token) if current_token.kind != kind
            rebind advanced_token: Token, parser = parser.advance()
            return advanced_token


        def error_at(parser: lmut Parser, kind: Ast::ParseErrorKind, token: Token) -> void:
            parse_error: Ast::ParseError = Ast::ParseError{
                kind: kind,
                line: token.line,
                column: token.column,
                context: Lexer::text_or_empty(token, parser.source)
            }
            parser.errors <- parser.errors.push(parse_error)


        # Parse a `:`-introduced statement block and return the block's statements as a
        # `darray[Stmt]` — the side-table that hangs directly off the owning node's payload
        # (docs/76). Two layouts are accepted, matching the lexer's token model:
        #   inline    `: <statement> NEWLINE`
        #   indented  `: NEWLINE INDENT (<statement> NEWLINE)* DEDENT`
        # The opening Colon and all layout tokens (Newline/Indent/Dedent) are consumed
        # here, so statement parsers never see layout noise.
        # Wrap a single statement into a body darray. A region-poly return (like
        # parse_block's) so the caller adopts the darray into its region — a body
        # darray built inline in function_declaration and stored straight into the Decl.Func
        # packed payload does NOT survive the region-polymorphic return.
        def single_statement_body(parser: lmut Parser, only_statement: Ast::Stmt) -> darray[Ast::Stmt]:
            # A one-element list literal, region-poly like parse_block's return so the
            # caller adopts it into its region.
            return [only_statement]


        def parse_block(parser: lmut Parser) -> darray[Ast::Stmt]:
            parser, _ <- parser.expect(TokenKind.Colon)
            is_inline: bool = parser.peek() != TokenKind.Newline
            # Same tuple-guard-if parse gotcha as `advance_if` / `parse_block_if`
            # (parser_stmt_control.elisa) — a ternary combining two lmut-threading calls
            # mis-parses, so each form is a cond-guarded helper called unconditionally.
            # A darray returned STRAIGHT out of a callee does not survive this frame: the
            # callee's auto region is this frame's, not the caller's, so forwarding the
            # header hands the caller a freed buffer. Re-materialize the block locally
            # (one comprehension = one presize-and-fill) so the return is region-poly.
            rebind inline_items: darray[Ast::Stmt], parser = parser.parse_inline_block_if(is_inline)
            adopted_inline: darray[Ast::Stmt] = [item for item in inline_items]
            adopted_inline return if is_inline
            rebind indented_items: darray[Ast::Stmt], parser = parser.parse_indented_block_if(not is_inline)
            return [item for item in indented_items]

        # Inline single-statement block: `if condition: return x`.
        def parse_inline_block_if(parser: lmut Parser, cond: bool) -> darray[Ast::Stmt]:
            empty_body: darray[Ast::Stmt] = []
            empty_body return if not cond
            items: mutable darray[Ast::Stmt] = []
            rebind __m_179: Ast::Stmt?, parser = parser.statement()
            if __m_179 is inline_statement:
                items.push(inline_statement)
            parser <- parser.skip_trailing_can(true)
            parser, _ <- parser.accept(TokenKind.Newline)
            return items

        # Indented block.
        def parse_indented_block_if(parser: lmut Parser, cond: bool) -> darray[Ast::Stmt]:
            empty_body: darray[Ast::Stmt] = []
            empty_body return if not cond
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)
            items: mutable darray[Ast::Stmt] = []

            while true |parser|:
                parser <- parser.skip_newlines()
                break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof
                rebind __m_192: Ast::Stmt?, parser = parser.statement()
                if __m_192 is body_statement:
                    items.push(body_statement)
                    parser <- parser.skip_trailing_can(true)
                    parser, _ <- parser.accept(TokenKind.Newline)
                else:
                    parser, _ <- parser.advance()   # error recovery: never spin on a bad token

            parser, _ <- parser.expect(TokenKind.Dedent)
            return items
