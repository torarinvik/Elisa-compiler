# Stage1 parser — the EXPRESSION-STATEMENT TAIL (`extend Parser: private:`): what may follow a
# parsed expression at statement position — assignment and compound-assignment operators, the
# arrow forms, and the `place with Type{ field <- value }` field-update block.
# Continues parser_stmt.elisa.

extend Parser:
    private:

        def statement_expression_tail(parser: lmut Parser, token: Token) -> Ast::Stmt?:
            # Otherwise an expression statement, an assignment/binding
            # (`target <- value` / `target = value`), or a guarded return.
            rebind target_raw: Ast::Expr, parser = get parser.expression()
            rebind target: Ast::Expr, parser = parser.consume_removed_as_cast(target_raw)
            # Multi-target (tuple-unpack) assignment `a, b = expression` / `a, b <- expression`:
            # collect the comma-separated targets into an Array target. Bare-ident
            # targets bind as new locals (see gather_locals).
            if parser.peek() == TokenKind.Comma:
                targets: mutable darray[Ast::Expr] = [target]
                while parser.accept(TokenKind.Comma) |parser|:
                    rebind more_target_option: Ast::Expr?, parser = parser.expression()
                    if more_target_option is more_target:
                        targets.push(more_target)
                if parser.peek() == TokenKind.LArrow or parser.peek() == TokenKind.Assign or isCompoundAssign(parser.peek()):
                    rebind multi_operator_token: Token, parser = parser.advance()

                    multi_operator: TokenKind = multi_operator_token.kind
                    # docs/119 §2: `a, b =` NEWLINE INDENT … — bare block whose tail
                    # tuple binds the targets.
                    if parser.block_value_rhs_ahead():
                        rebind __v_213: Ast::Expr, parser = parser.parse_block_value_rhs()
                        # docs/120 §6 dataflow MANIFEST — `A, B <-` NEWLINE `if C: (a, b) else:
                        # (c, d)`: branch mutations are lifted into the place list. DESUGAR it here
                        # into the plain statement `if C: A <- a; B <- b else: A <- c; B <- d`,
                        # which is exactly what it means and which needs no separate multi-place
                        # lowering downstream. A place assigned its own name (`parser` in the arm
                        # that does not advance) is a no-op and is skipped rather than emitted as a
                        # self-assignment.
                        if manifest_desugar_applies(__v_213, targets):
                            rebind manifest_stmt: Ast::Stmt, parser = parser.manifest_to_if_statement(__v_213, targets, multi_operator, token.line)
                            return manifest_stmt
                        return (Ast::Stmt.Assign((Ast::Expr.Array(targets, Ast::pos_of_token(token))), multi_operator, __v_213, Ast::pos_of_token(token)))
                    rebind first_value: Ast::Expr, parser = get parser.expression()
                    # The RHS may itself be a comma-separated tuple (`a, b <- b, a`),
                    # not just a single multi-valued call/expression — collect it the same
                    # way the LHS targets were collected above.
                    if parser.peek() == TokenKind.Comma:
                        values: mutable darray[Ast::Expr] = [first_value]
                        while parser.accept(TokenKind.Comma) |parser|:
                            rebind more_value_option: Ast::Expr?, parser = parser.expression()
                            if more_value_option is more_value:
                                values.push(more_value)
                        # docs/125 §6b again: a trailing `if COND` with NO `else` guards the
                        # whole STATEMENT, but it parses as part of the LAST element, so
                        # `first, second <- second, first if swap` arrives as
                        # `[second, If(swap, first, Absent)]`. Lift it back out: strip the
                        # conditional off the final value and wrap the assignment in `if COND:`.
                        # Without this the last element is an else-less conditional VALUE, which
                        # has no lowering — stage0 accepts the statement, so leaving it would be
                        # a parse divergence, not just a missing feature.
                        if values.count > 0:
                            match values[values.count - 1]:
                                Expr.If(tuple_guard_condition, tuple_guarded_value, Expr.Absent, tuple_guard_line):
                                    if multi_operator != TokenKind.Assign:
                                        values[values.count - 1] <- tuple_guarded_value
                                        tuple_guard_body: mutable darray[Ast::Stmt] = []
                                        tuple_guard_body.push((Ast::Stmt.Assign((Ast::Expr.Array(targets, Ast::pos_of_token(token))), multi_operator, (Ast::Expr.Array(values, Ast::pos_of_token(token))), Ast::pos_of_token(token))))
                                        tuple_guard_no_else: darray[Ast::Stmt] = []
                                        return (Ast::Stmt.If(tuple_guard_condition, tuple_guard_body, tuple_guard_no_else, Ast::pos_of_token(token)))
                                _:
                                    pass
                        return (Ast::Stmt.Assign((Ast::Expr.Array(targets, Ast::pos_of_token(token))), multi_operator, (Ast::Expr.Array(values, Ast::pos_of_token(token))), Ast::pos_of_token(token)))
                    # docs/125 §6b: like the single-place form below, a multi-place
                    # `<-` RHS `call() if COND` with NO `else` is a do-or-skip guard
                    # — desugar to `if COND: a, b <- call()`, mirroring stage0's
                    # tryParseTupleBindStmt guard. `=` bindings stay unconditional.
                    if multi_operator != TokenKind.Assign:
                        match first_value:
                            Expr.If(multi_guard_condition, multi_guarded_value, Expr.Absent, multi_guard_line):
                                multi_guard_body: mutable darray[Ast::Stmt] = []
                                multi_guard_body.push((Ast::Stmt.Assign((Ast::Expr.Array(targets, Ast::pos_of_token(token))), multi_operator, multi_guarded_value, Ast::pos_of_token(token))))
                                multi_guard_no_else: darray[Ast::Stmt] = []
                                return (Ast::Stmt.If(multi_guard_condition, multi_guard_body, multi_guard_no_else, Ast::pos_of_token(token)))
                            _:
                                pass
                    return (Ast::Stmt.Assign((Ast::Expr.Array(targets, Ast::pos_of_token(token))), multi_operator, first_value, Ast::pos_of_token(token)))
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if not parser.in_value_block
                # A comma-list with NO assignment operator inside a VALUE BLOCK is a multi-value
                # TUPLE result (docs/120 §6 manifest arms: `if C: parser, out.push(d) else: …`).
                # Keeping only `target` SILENTLY DISCARDED every element after the first — the
                # dropped `out.push(d)` was a real side effect, not dead code.
                (Ast::Stmt.Expr((Ast::Expr.Tuple(targets, Ast::pos_of_token(token))), Ast::pos_of_token(token))) return if parser.in_value_block and targets.count > 1
                return (Ast::Stmt.Expr(target, Ast::pos_of_token(token)))
            # `place with T{ field <- value ... }`: several fields of one place (docs/18).
            if parser.peek() == TokenKind.With:
                rebind with_stmt: Ast::Stmt?, parser = parser.parse_with_fields_stmt(target, token)
                return with_stmt
            if parser.peek() == TokenKind.LArrow or parser.peek() == TokenKind.Assign or isCompoundAssign(parser.peek()):
                rebind assign_operator_token: Token, parser = parser.advance()

                assign_operator: TokenKind = assign_operator_token.kind
                # docs/119 §2: `target <- ` / `target = ` NEWLINE INDENT … is a bare block.
                if parser.block_value_rhs_ahead():
                    rebind __v_233: Ast::Expr, parser = parser.parse_block_value_rhs()
                    return (Ast::Stmt.Assign(target, assign_operator, __v_233, Ast::pos_of_token(token)))
                # docs/119 §3: the same loop expression written INLINE rather than as a
                # block on the next line.
                if parser.inline_loop_value_ahead():
                    rebind inline_loop: Ast::Expr, parser = parser.parse_inline_loop_value()
                    return (Ast::Stmt.Assign(target, assign_operator, inline_loop, Ast::pos_of_token(token)))
                rebind value_raw: Ast::Expr, parser = get parser.expression()
                rebind value: Ast::Expr, parser = parser.consume_removed_as_cast(value_raw)
                # A bare (parenless) tuple RHS on a `=` binding (`pair = 4, 9`) — the
                # single-target sibling of the multi-place `a, b = x, y` form above.
                # Only `=` bindings take it (a `<-`/compound comma is a distinct error).
                if assign_operator == TokenKind.Assign and parser.peek() == TokenKind.Comma:
                    tuple_values: mutable darray[Ast::Expr] = [value]
                    while parser.accept(TokenKind.Comma) |parser|:
                        rebind tuple_more_option: Ast::Expr?, parser = parser.expression()
                        if tuple_more_option is tuple_more:
                            tuple_values.push(tuple_more)
                    return (Ast::Stmt.Assign(target, assign_operator, (Ast::Expr.Tuple(tuple_values, Ast::pos_of_token(token))), Ast::pos_of_token(token)))
                # docs/125 §6b generalized postfix statement guard: a mutation RHS
                # `v if COND` with NO `else` (the lenient ternary parse leaves an
                # Invalid alternative) is do-or-skip sugar — desugar to
                # `if COND: target <- v`, mirroring stage0. Only `<-` and compound
                # ops guard; a `=` binding must bind unconditionally.
                if assign_operator != TokenKind.Assign:
                    match value:
                        Expr.If(assign_guard_condition, assign_guarded_value, Expr.Absent, assign_guard_line):
                            assign_guard_body: mutable darray[Ast::Stmt] = []
                            assign_guard_body.push((Ast::Stmt.Assign(target, assign_operator, assign_guarded_value, Ast::pos_of_token(token))))
                            assign_guard_no_else: darray[Ast::Stmt] = []
                            return (Ast::Stmt.If(assign_guard_condition, assign_guard_body, assign_guard_no_else, Ast::pos_of_token(token)))
                        _:
                            pass
                # A `=` BINDING with a no-else ternary (`x = 1 if cond`) is a
                # PARSE error in stage0 ("expected `else`"): a binding must bind
                # unconditionally. Record the error and keep the node for recovery.
                if assign_operator == TokenKind.Assign:
                    match value:
                        Expr.If(binding_guard_condition, binding_guarded_value, Expr.Absent, binding_guard_line):
                            parser <- parser.error_at(Ast::ParseErrorKind.ExpectedToken, parser.cursor())
                        _:
                            pass
                return (Ast::Stmt.Assign(target, assign_operator, value, Ast::pos_of_token(token)))
            else:
                # Postfix guarded return `VALUE return if COND` (== `if COND:
                # return VALUE`). Desugared into a real If node so the guard's
                # references resolve (and count as uses) like any condition.
                if parser.peek() == TokenKind.Return:
                    parser, _ <- parser.advance()
                    rebind accepted_if_3: bool, parser = parser.accept(TokenKind.If)
                    if accepted_if_3:
                        rebind guard_condition: Ast::Expr, parser = get parser.expression()
                        guard_body: mutable darray[Ast::Stmt] = []
                        guard_body.push((Ast::Stmt.Return(target, Ast::pos_of_token(token))))
                        guard_no_else: darray[Ast::Stmt] = []
                        return (Ast::Stmt.If(guard_condition, guard_body, guard_no_else, Ast::pos_of_token(token)))
                    return (Ast::Stmt.Return(target, Ast::pos_of_token(token)))
                # docs/125 §6b: an expression statement `EXPR if COND` with no
                    # `else` is a postfix statement guard — `if COND: EXPR`.
                match target:
                    Expr.If(stmt_guard_condition, stmt_guarded_value, Expr.Absent, stmt_guard_line):
                        stmt_guard_body: mutable darray[Ast::Stmt] = []
                        stmt_guard_body.push((Ast::Stmt.Expr(stmt_guarded_value, Ast::pos_of_token(token))))
                        stmt_guard_no_else: darray[Ast::Stmt] = []
                        return (Ast::Stmt.If(stmt_guard_condition, stmt_guard_body, stmt_guard_no_else, Ast::pos_of_token(token)))
                    _:
                        pass
                return (Ast::Stmt.Expr(target, Ast::pos_of_token(token)))



        # `place with Type{ field <- value ... }` desugars, parser-level like the match
        # `with` and `machine`, into a hidden reference to the place followed by one
        # ordinary assignment per field, inside an `if true:` block that scopes the
        # binding:
        #     if true:
        #         __with_L_C = &place        (inferred `mutable T&`)
        #         __with_L_C.field <- value
        # The place is evaluated ONCE and the fields are assigned in the order written.
        # The optional type name is accepted here; stage0 checks it against the place's
        # type, stage1 does not yet (a parity gap on REJECTION only).
        def parse_with_fields_stmt(parser: lmut Parser, place: Ast::Expr, token: Token) -> Ast::Stmt?:
            can Abort.Panic, Memory.Allocate:
                parser, _ <- parser.expect(TokenKind.With)
                # `place with Type { ... }` -- the optional type name. Keep the TOKEN, not
                # just the fact that one was there: annotating the hidden reference with
                # `mutable Type&` is what makes a WRONG name an error instead of silence.
                # stage0 does exactly this; stage1 accepted `pts[0] with Other{ x <- 9 }`
                # against a darray of Point and compiled it.
                typed: mutable bool = false
                # Seeded with the `with` token itself; only read when `typed` is true.
                type_token: mutable Token = token
                if parser.peek() == TokenKind.Ident:
                    rebind type_token, parser = parser.expect(TokenKind.Ident)
                    typed <- true
                parser, _ <- parser.expect(TokenKind.LBrace)
                # A bare identifier is already a place that costs nothing to
                # re-evaluate, and taking its address would turn a reference
                # parameter into a reference to a reference; assign through it
                # directly. Any other place is bound ONCE to a hidden reference
                # (one hidden name is enough: each `with` is its own block).
                place_name: mutable sview = "__with_place"
                body: mutable darray[Ast::Stmt] = []
                direct: mutable bool = false
                if not typed:
                    match place:
                        Ast::Expr.Ident(ident_name, ident_pos):
                            place_name <- ident_name
                            direct <- true
                        _:
                            pass
                if not direct:
                    with_pos: Ast::Pos = Ast::pos_of_token(token)
                    with_annotation: mutable Ast::Expr = (Ast::Expr.Invalid)
                    if typed:
                        with_annotation <- (Ast::Expr.Unary(TokenKind.Mutable, (Ast::Expr.Unary(TokenKind.Ampersand, (Ast::Expr.Ident(Lexer::text_or_empty(type_token, parser.source), with_pos)), with_pos)), with_pos))
                    body.push((Ast::Stmt.VarDecl(place_name, with_annotation, (Ast::Expr.Unary(TokenKind.Ampersand, place, with_pos)), with_pos)))
                temp_name: sview = place_name
                while parser.peek() != TokenKind.RBrace and parser.peek() != TokenKind.Eof |parser, body, temp_name|:
                    if parser.peek() == TokenKind.Newline or parser.peek() == TokenKind.Indent or parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Comma:
                        parser, _ <- parser.advance()
                        continue
                    rebind field_token: Token, parser = parser.expect(TokenKind.Ident)
                    # Field punning: `with { kind, parent }` assigns each field from
                    # the local of the same name.
                    value: mutable Ast::Expr = (Ast::Expr.Ident(Lexer::text_or_empty(field_token, parser.source), Ast::pos_of_token(field_token)))
                    if parser.peek() == TokenKind.LArrow:
                        parser, _ <- parser.advance()
                        # Do not use `rebind value = get parser.expression()` here. The
                        # stage1 backend's optional-unwrapping lowering can lose the parsed
                        # expression when the result is a loop-local AST handle; stage0's
                        # equivalent keeps the non-optional expression result directly.
                        rebind parsed_value: Ast::Expr?, parser = parser.expression()
                        if parsed_value is parsed:
                            value <- parsed
                    field_target: Ast::Expr = (Ast::Expr.Field((Ast::Expr.Ident(temp_name, Ast::pos_of_token(field_token))), Lexer::text_or_empty(field_token, parser.source), Ast::pos_of_token(field_token)))
                    body.push((Ast::Stmt.Assign(field_target, TokenKind.LArrow, value, Ast::pos_of_token(field_token))))
                parser, _ <- parser.expect(TokenKind.RBrace)
                parser, _ <- parser.accept(TokenKind.Newline)
                no_else: darray[Ast::Stmt] = []
                return (Ast::Stmt.If((Ast::Expr.BoolLit(true, Ast::pos_at_line(0))), body, no_else, Ast::pos_of_token(token)))
