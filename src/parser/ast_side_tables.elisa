# Stage1 AST — the RECORDS the node handles point into: parameters, annotations, struct and enum
# members, match arms, field initializers, and the per-file metadata rows the parser fills in
# for the later stages. Part of `module Ast` (see parser.elisa).

extend Ast:


    struct ParamDecl:
        name: sview
        type_expression: Expr
        is_mutable: bool
        # Whether the parameter carries a default value (`p: T = v`) — callers may
        # omit it, so arity checking needs required-vs-total counts.
        has_default: bool
        # The default VALUE expression, so a call site that omits the argument can be
        # filled in. Previously the expression was parsed and DISCARDED, leaving only the
        # flag above, which is why every call relying on a default declined.
        # Expr.Invalid when there is no default.
        default_value: Expr
        # `p: T!` — the AFFINE-consumption marker. The parser used to accept the `!` and
        # throw it away, so the AST could not tell `T` from `T!` and anything rebuilding a
        # signature from it silently widened the parameter. stage0 carries it as a ref
        # typestate; here it is one bit. Defaulted, so existing constructions are unchanged.
        is_affine: bool = false




    struct Annotation:
        name: sview
        arg_start: u32
        arg_count: u32
        # Source position of the decorator name (stage0-parity duplicate messages
        # cite the first occurrence as "line L:C"). 0 when synthesized.
        line: u32 = 0
        column: u32 = 0




    struct ExternParam:
        name: sview
        type_name: sview
        # The compact extern scanner keeps the head in `type_name`; retain the first
        # application argument as well for by-value containers such as `view[T]` and
        # `darray[T]`. Dropping `T` made a representable `%DynArrayView` ABI unmodelled.
        element_type_name: sview = ""
        provenance_bearing: bool
        # Whether the param is a MUTABLE reference (`mutable p: T&` / `lmut p: T`), so a call
        # passing an argument here can widen its typestate. A plain `&` (const ref) cannot.
        mutable_ref: bool
        # Function-valued extern parameters retain a line-keyed reference into the parser's
        # existing fn-type side tables. Scalars keep this compact ABI record bootstrap-safe;
        # the recursive expression itself remains in those tables rather than in every param.
        fn_type_line: u32 = 0
        fn_type_param_count: u32 = 0
        # The parameter NAME token's span: a diagnostic about one parameter points at it
        # (stage0 reports an untyped `void&?` parameter at the parameter, not the extern).
        pos: Pos
        # Whether the type spelling carries a depth-0 `&` (a reference) and a `?`
        # (optional). The compact head in `type_name` alone cannot tell `void&?` apart
        # from a bare head, and the extern pointer discipline (docs/127 D1/D12) needs both.
        is_ref: bool
        optional: bool




    struct LocalRegionAnnotation:
        name: sview
        type_expression: Expr
        region: sview
        line: u32
        # Last line of a `region NAME(...):` BLOCK; 0 when the row has no bounded extent --
        # a region param, an Arena local, an ordinary `@r` annotation, or the bare
        # `region NAME(N)` statement form whose scope runs to the end of the function.
        #
        # Without an extent, `local_region_is_in_scope` could only compare LINE ORDER, so a
        # region that had already CLOSED still counted as in scope: stage1 accepted
        #     region a(4096):
        #         pass
        #     region b(4096):
        #         values: mutable darray[i64] @a = []    # `a` is closed here
        # where stage0 reports `unknown region qualifier "a"`. 0 keeps every other row's
        # behaviour exactly as it was.
        end_line: mutable u32




    struct EnumAnnotation:
        owner: sview
        name: sview
        line: u32
        # A SECOND line, for the annotations whose `line` is a sentinel tag rather than a
        # source position (`3900000076` and friends -- the tag IS the table key). Those had
        # no way to name where in the file they came from, and the one diagnostic that
        # reported such an annotation printed the sentinel itself as its line number.
        detail_line: u32 = 0
        # Module that owns the annotation. Storage metadata is keyed by module as well as
        # enum/field because two modules may declare the same packed hierarchy names.
        module: sview = ""
        # Stable declaration identity for effect/handler metadata. Raw owner/name remain
        # intentionally available for diagnostics and for older metadata consumers; this
        # numeric key prevents same-spelled declarations in different modules from aliasing.
        identity_id: u32 = 0
        # The annotated token's byte offset (§4.2): a line is not unique once `#line` directives
        # restart numbering per included file, so consumers that ORDER or MATCH annotations use
        # this when it is set. 0 = not recorded (the 231 creation sites default to it).
        offset: u32 = 0
        # The annotated NAME's own source extent, for rows that exist to carry one. Names held
        # in a bare `darray[sview]` field (a loop's `variables`, a `can` clause's effect refs)
        # have no position anywhere in the tree, and stage0 reports at the name: a row here is
        # how the semantic layer recovers it. Defaulted for the same reason `Diagnostic.pos` is.
        pos: Pos = Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}




    # One member of a packed bit group (`flags: bitset:` flags, or a `layout: bitfield:`
    # field). For a `bitset` flag, `type_expression` is `Expr.Invalid` (each flag is an
    # implicit 1-bit member). For a `bitfield` member, `type_expression` is the declared
    # storage type (a bit-int like `u4` or a const-enum). `line` places diagnostics.
    struct BitGroupMember:
        name: sview
        type_expression: Expr
        # The member NAME's source extent: stage0 spans the name when it reports a
        # duplicate. Widened from a bare `line: u32` (see docs: widen, never add).
        pos: Pos




    struct StructMember:
        name: sview
        type_expression: Expr
        # Whether the field may be omitted in a by-label construction — an optional
        # field (`name?: T`) or one with a default value (`name: T = expression`). Required
        # fields (omittable == false) must all appear in a labeled `Name{...}` literal.
        omittable: bool
        # Whether the field is a `ghost` verification-only model field (erased at codegen).
        is_ghost: bool
        # Whether the field carries an explicit default-value initializer (`name: T = expr`).
        # Distinct from `omittable`, which also covers optional `name?: T` fields.
        has_default: bool
        # The initializer itself (`Expr.Invalid` when `has_default` is false). The parser
        # used to PARSE the default purely to get past it and then discard the node, so a
        # labeled literal that omitted the field stored a zero instead of the default —
        # `P{}` with `x: i64 = 42` answered 0 where stage0 answers 42.
        default_value: Expr
        # The `@region` provenance qualifier on the field type (`next: T @owner`), captured
        # verbatim; "" when absent. A region selector, not part of the field type — used by
        # the region-annotation-on-scalar structural check.
        region: sview
        # Packed bit-group kind: "" for an ordinary field, "bitset" for a `flags: bitset:`
        # block, "bitfield" for a `layout: bitfield:` block. When non-empty,
        # `bit_group_members` holds the captured nested members in declaration order.
        bit_group_kind: sview
        bit_group_members: darray[BitGroupMember]




    struct EnumVariant:
        name: sview
        # Payload field TYPE expressions and optional labels, in declaration order.
        # `field_names[i] == ""` means the payload field is positional/unnamed.
        fields: darray[Expr]
        field_names: darray[sview]
        # A const-enum member's explicit `= VALUE` initializer (Absent when omitted). For an
        # `Expr.IntLit` the parser has already decoded its `i64` value.
        value_expr: Expr




    struct MatchArm:
        # The arm pattern, structurally decomposed (see `Pattern`).
        pattern: Pattern
        # The arm body statements.
        body: darray[Stmt]
        # The docs/122 §5.1 arm-header guard (`Pattern if cond:`), or Absent when the
        # arm is unguarded. Pattern bindings are in scope inside the guard.
        guard: Expr
        # The arm HEAD token's source extent (the `_` of a wildcard arm, the first token
        # of a variant path). `Pattern` carries no position of its own, so an arm-level
        # diagnostic has nowhere else to point. Defaulted for the same reason
        # `Diagnostic.pos` is: the arms synthesized by desugars and by the backend have no
        # source token, and degrade to line-only reporting rather than a wrong column.
        pos: Pos = Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}




    # One field initializer in a brace construction `Type{name: value, …}`. `name` is the
    # field label, or "" for a positional/shorthand field (`Type{value}`), in which case
    # the value expression carries the reference. The label is a member selector, not a
    # value reference.
    struct FieldInit:
        name: sview
        value: Expr




    # One key/value pair in a dict literal `{key: value, …}`. Both are value references.
    struct DictEntry:
        key: Expr
        value: Expr




    struct MachineCoverageRow:
        # docs/125 §9 Tier-2: ONE arm-atom of a `machine over` whose input is a free-function
        # (classifier) call — either a variant `tag` this state's arm spells, or a wildcard/bind
        # marker (`tag == ""`, `has_wildcard`). Rows sharing a `line` (the machine head) belong
        # to one machine; grouped by (line, state_name) in semantic, they reconstruct each
        # state's tag set + wildcard flag. Semantic resolves the classifier's return type and, if
        # a CLOSED const enum, enforces "spell every variant, reject `_`" (the add-a-variant
        # safety net). A flat row (sviews + scalars only) — the parser->semantic side-table
        # carries no region-allocated containers or node-store handles.
        input_callee: sview
        state_name: sview
        tag: sview
        has_wildcard: bool
        line: u32



    # One clause from a struct's `derive state:` block. Kept as file metadata so the
    # stable Decl.Struct payload need not change while semantic analysis still receives
    # the predicate expression and can derive its field dependencies.
    struct DerivedStateRule:
        owner: sview
        state: sview
        condition: Expr
        # The STATE name's source extent (`Open` in `Open when hp > 0`), which is where
        # stage0 reports a non-field-based rule. Widened from a bare `line: u32`.
        pos: Pos



    # A function signature postcondition `ensures PARAM => STATE`, used as the
    # declared typestate summary at reference-call sites.
    struct TypestatePostcondition:
        function_name: sview
        parameter_name: sview
        state: sview
        position: u32
        line: u32



    # Compile-time type application for an abstract-effect row. Keep the source
    # spelling for diagnostics, but do not require later type-directed handler
    # selection to reconstruct nested type arguments from text.
    struct StaticEffectCandidate:
        effect_type: Expr
        callee: sview
        captures: darray[Expr]
        effect_identity_id: u32 = 0
        handler_identity_id: u32 = 0
        callee_owner: sview = ""




    struct EffectTypeReference:
        spelling: sview
        type_expression: Expr
        position: Pos
        lexical_owner: sview
        identity_id: u32 = 0




    # The source position a declaration node carries (its header token). `Invalid`
    # has none and yields the zero position.
    # The declared NAME of a declaration node, "" for the forms that have none
    # (`impl`/`static if` bodies, imports). Paired with `decl_pos`.
    def decl_name(declaration: Decl) -> sview:
        can Abort.Panic:
            match declaration:
                Decl.Func(func_name, _, _, _, _, _, _):
                    return func_name
                Decl.Struct(struct_name, _, _, _, _, _, _):
                    return struct_name
                Decl.Enum(enum_name, _, _, _, _):
                    return enum_name
                Decl.Alias(alias_name, _, _):
                    return alias_name
                Decl.Law(law_name, _, _):
                    return law_name
                Decl.Extern(extern_name, _, _, _, _, _, _, _):
                    return extern_name
                Decl.Const(const_name, _, _, _, _):
                    return const_name
                Decl.Module(module_name, _, _):
                    return module_name
                _:
                    pass
            return sview("", 0, 0)




    def decl_pos(declaration: Decl) -> Pos:
        can Abort.Panic:
            match declaration:
                Decl.Func(_, _, _, _, _, _, func_pos):
                    return func_pos
                Decl.Struct(_, _, _, _, _, _, struct_pos):
                    return struct_pos
                Decl.Enum(_, _, _, _, enum_pos):
                    return enum_pos
                Decl.Alias(_, _, alias_pos):
                    return alias_pos
                Decl.Law(_, _, law_pos):
                    return law_pos
                Decl.Import(_, import_pos):
                    return import_pos
                Decl.Scoped(_, scoped_pos):
                    return scoped_pos
                Decl.Extern(_, _, _, _, _, _, _, extern_pos):
                    return extern_pos
                Decl.Const(_, _, _, _, const_pos):
                    return const_pos
                Decl.Module(_, _, module_pos):
                    return module_pos
                _:
                    pass
            return pos_at_line(0)
