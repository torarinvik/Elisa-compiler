# Stage1 parser — `func` declarations (`extend Parser: private:`). Covers the function
# header (generic params, parameter list with defaults and refinements, return type and
# effects, declared thread slots) and both body forms. Continues
# parser_types_extern.elisa; split out to keep each part file under 600 lines.

extend Parser:
    private:
        def record_generic_func_metadata(parser: lmut Parser, declaration: Ast::Decl, name: sview, line: u32) -> void:
            has_generic: mutable bool = false
            has_errorset: mutable bool = false
            machine over has_generic for parameter_line in parser.generic_param_lines:
                state Scan
                start Scan

                Scan, _ if parameter_line < 2147483648 and parameter_line == line:
                    has_generic <- true
                    -> Scan

                Scan, _:
                    -> Scan

            # `errorset R` is a semantic generic parameter, but it deliberately has no
            # ordinary type-parameter row: the backend binds it as an error-family selector
            # rather than as a runtime/type argument. Keep such templates in the generic
            # declaration side table as well, otherwise the backend sees `f[errorset R]` as
            # an ordinary function and emits its body with the unspecialized error ABI.
            machine over has_errorset for annotation in parser.enum_annotations:
                state Scan
                start Scan

                Scan, _ if annotation.owner == "__errorset_param" and annotation.line == line:
                    has_errorset <- true
                    -> Scan

                Scan, _:
                    -> Scan
            return if not has_generic and not has_errorset
            parser.generic_func_decls <- parser.generic_func_decls.push(declaration)
            parser.generic_func_decl_names <- parser.generic_func_decl_names.push(name)
            parser.generic_func_decl_lines <- parser.generic_func_decl_lines.push(line)
            parser.generic_func_decl_owners <- parser.generic_func_decl_owners.push(parser.current_module)



        def function_declaration(parser: lmut Parser) -> Ast::Decl?:
            rebind token: Token, parser = parser.expect(TokenKind.Def)
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            function_name: sview = Lexer::text_or_empty(name_token, parser.source)
            # The `def` keyword's own position — stage0 mangles a named constructor with it.
            parser.func_decl_lines <- parser.func_decl_lines.push(token.line)
            parser.func_decl_columns <- parser.func_decl_columns.push(token.column)
            # Capture this method's own `changes self.FIELD` set for frame-condition conformance
            # (the signature clause is otherwise skipped). Keyed under the impl sentinel; only
            # methods whose name matches a protocol method are checked, so plain functions are inert.
            parser <- parser.capture_signature_changes(function_name, 3900000003)
            parser <- parser.scan_preserves_conflict(function_name)
            error_family: sview = parser.header_error_family()
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: function_name, name: "__error_return", line: token.line}) if error_family != ""
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: function_name, name: error_family, line: token.line}) if error_family != ""
            parser <- parser.capture_header_error_families(token.line, token.start) if error_family != ""
            parser.declared_thread_slots <- parser.declared_thread_slots.truncate(0)
            parser.lmut_param_names <- parser.lmut_param_names.truncate(0)
            parser.mutable_param_names <- parser.mutable_param_names.truncate(0)

            # Leading `@name` decorators were captured just before dispatch; snapshot them
            # now before any nested parse clobbers the parser's pending buffer.
            decorators: mutable darray[Ast::Annotation] = []
            machine over decorators for decorator in parser.pending_decorators:
                state Scan
                start Scan

                Scan, _:
                    decorators.push(decorator)
                    -> Scan

            # Optional generic/region params `[T]`, `[K, V]`, `[@r]` between name and `(`.
            rebind accepted_lbracket: bool, parser = parser.accept(TokenKind.LBracket)
            parser <- parser.reject_legacy_region_params() if accepted_lbracket
            parser <- parser.capture_function_generic_params(token.line) if accepted_lbracket

            param_items: mutable darray[Ast::ParamDecl] = []
            rebind accepted_lparen: bool, parser = parser.accept(TokenKind.LParen)
            variadic_definition: mutable bool = false
            if accepted_lparen:
                rebind parsed_variadic: bool, parser = parser.parse_param_list(param_items, token.line)
                variadic_definition <- parsed_variadic
            decorators.push(Ast::Annotation{name: "c_variadic", arg_start: 0, arg_count: 0, line: token.line, column: token.column}) if variadic_definition

            effects: mutable darray[sview] = []

            rebind accepted_arrow: bool, parser = parser.accept(TokenKind.Arrow)
            parser <- parser.validate_conditional_ensures_return() if accepted_arrow
            parser <- parser.capture_typestate_postcondition(function_name, param_items, token.line)
            rebind return_type: Ast::Expr?, parser = parser.capture_return_type_and_effects(accepted_arrow)
            return_region_token: Token = parser.cursor()
            rebind accepted_return_region: bool, parser = parser.accept(TokenKind.At)
            return_region_name_token: Token = parser.cursor()
            # Consume the region name ONLY after an `@`; a bare identifier here is the first word
            # of a signature clause (`ensures`/`requires`) and must survive for capture.
            has_return_region: bool = accepted_return_region and parser.peek() == TokenKind.Ident
            parser <- parser.advance_region_name(has_return_region)
            parser.local_region_annotations <- parser.local_region_annotations.push(Ast::LocalRegionAnnotation{name: "__region_return", type_expression: get return_type else (Ast::Expr.Invalid), region: Lexer::text_or_empty(return_region_name_token, parser.source), line: token.line}) if has_return_region
            parser <- parser.error_at(Ast::ParseErrorKind.ExpectedToken, return_region_token) if accepted_return_region and not has_return_region
            parser <- parser.validate_declared_thread_slots(token)
            # The return-type `expression()` consumes a trailing effect grant
            # (`-> T can[...]`) via skip_trailing_can; recover it from the parser. The
            # copy lives HERE, where `effects` is locally owned — growing it through a
            # ref param inside the helper detaches the growth from its arena ("darray
            # reserve requires an active in <arena>: scope" at codegen).
            effects.extend(parser.captured_effects) if accepted_arrow

            # `parse_signature_clauses` intentionally consumes opaque clause payloads,
            # but an unknown identifier at the start of the tail is not a clause. Flag it
            # before recovery can turn a damaged header into a body-less function and send
            # an invalid AST to the backend (the malformed-input fuzz regression).
            signature_head_token: Token = parser.cursor()
            unknown_signature_head: bool = parser.peek() == TokenKind.Ident and not is_signature_clause_head(Lexer::text_or_empty(signature_head_token, parser.source))
            # A NON-identifier here is the same damage in a different token kind, and it
            # slipped past the guard above: parse_signature_clauses consumes ANY token
            # until the body colon, so `def f 9 -> 3` was swallowed whole with no
            # diagnostic, the def became a phantom declaration-only `f`, and a later
            # genuine `def f` made a duplicate whose call crashed the backend (SIGSEGV,
            # found by malformed_input_smoke). The only legal heads at this point are a
            # clause keyword, the body `:`, an expression body `=`, a bare `error[...]`
            # set, or the end of the line.
            head_kind: TokenKind = parser.peek()
            # TokenKind.Bang stays legal: a return type `-> P!` (the affine marker) has
            # always left its `!` here for parse_signature_clauses to swallow — see the
            # parameter-list note below on how `-> P!` "worked only INCIDENTALLY". Banning
            # it declined 47 corpus programs and broke gen2 on the compiler's own source.
            junk_signature_head: bool = signature_head_token.line == token.line and head_kind != TokenKind.Ident and head_kind != TokenKind.Colon and head_kind != TokenKind.Assign and head_kind != TokenKind.Error and head_kind != TokenKind.Bang and head_kind != TokenKind.Newline and head_kind != TokenKind.Eof
            flagged_signature_head: bool = unknown_signature_head or junk_signature_head
            parser <- parser.error_at(Ast::ParseErrorKind.ExpectedToken, parser.cursor()) if flagged_signature_head
            parser <- parser.skip_to_line_end() if flagged_signature_head

            # Remaining signature clauses before the body colon: a bare `can` grant when
            # there is no return type, plus error sets (`raises ...`) and contracts
            # (`requires`/`ensures`), which are consumed without modeling.
            parser <- parser.parse_signature_clauses(effects)

            # Drain this signature's captured `requires`/`ensures` into the file-level side-channel,
            # keyed by the owning function's line. (Snapshot BEFORE the body parse — a nested `def`
            # re-enters parse_signature_clauses and clobbers the per-signature buffers.)
            parser <- parser.drain_signature_contracts(token.line)

            parser <- parser.drain_pending_fulfills(function_name)
            parser <- parser.drain_pending_fulfills_is(function_name)

            # Record this function's line if its signature declared an `error[...]` return
            # set, so the RaiseWithoutErrorSet check can exempt it (drained into
            # File.error_set_func_lines by parse_file).
            parser.error_set_func_lines <- parser.error_set_func_lines.push(token.line) if parser.signature_has_error_set
            parser.error_set_func_names <- parser.error_set_func_names.push(parser.signature_error_set_name) if parser.signature_has_error_set

            rebind accepted_assign: bool, parser = parser.accept(TokenKind.Assign)
            is_block_body: bool = not accepted_assign and parser.peek() == TokenKind.Colon
            # A declaration-only `def f()` legitimately ends at the newline. If a
            # same-line token remains here, however, the header is malformed (for
            # example a mutation can turn `: return ...` into `turn return ...`). The
            # old parser silently built a body-less function and sent the malformed AST
            # into LLVM, where it could trap instead of producing a diagnostic.
            malformed_body_header: bool = not accepted_assign and not is_block_body and parser.cursor().line == token.line and parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Eof
            parser <- parser.error_at(Ast::ParseErrorKind.ExpectedToken, parser.cursor()) if malformed_body_header
            parser <- parser.skip_to_line_end() if malformed_body_header
            # Expression-bodied function `def f(...) -> T = EXPR` == a body of a single
            # `return EXPR` (same `=` "definition is this expression" as law/type/alias).
            signature_has_pool: mutable bool = false
            machine over signature_has_pool for effect in effects:
                state Scan
                start Scan

                Scan, _ if effect == "Pool" or (sview_len(effect) > 4 and effect[0:4] == "Pool"):
                    signature_has_pool <- true
                    -> Scan

                Scan, _:
                    -> Scan
            parser.active_pool_depth <- parser.active_pool_depth + 1 if signature_has_pool
            # Local state declarations must never leak between functions.
            parser.pending_state_decls <- parser.pending_state_decls.truncate(0)
            rebind resolved_body: darray[Ast::Stmt], parser = parser.resolve_function_body(accepted_assign, is_block_body)
            parser.active_pool_depth <- parser.active_pool_depth - 1 if signature_has_pool
            return (Ast::Decl.Func(function_name, param_items, return_type, resolved_body, effects, decorators, Ast::pos_of_token(token)))



        # Capture the declaration names in a function generic header, entered just
        # after `[`. A top-level identifier immediately after `[` or `,` is a generic
        # parameter (`T`, `N`); constraints after `:` are skipped. Region parameters
        # beginning with `@` are intentionally omitted from value-name resolution.
        def capture_function_generic_params(parser: lmut Parser, function_line: u32) -> void:
            expect_name: mutable bool = true
            expect_bound: mutable bool = false
            depth: mutable int = 0
            while parser.peek() != TokenKind.Eof |parser, expect_name, expect_bound, depth|:
                kind: TokenKind = parser.peek()
                break if depth == 0 and kind == TokenKind.RBracket
                token: Token = parser.cursor()
                # `errorset R` — an error-set generic parameter. Record R on the side-table
                # (keyed by the function line, matching Decl.Func's line) and do NOT treat the
                # `errorset` keyword itself as a generic type name.
                is_errorset_kw: bool = depth == 0 and expect_name and kind == TokenKind.Ident and Lexer::text_or_empty(token, parser.source) == "errorset" and parser.peek_at(1) == TokenKind.Ident
                errorset_name_token: Token = parser.tokens[parser.position + 1] if is_errorset_kw else token
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__errorset_param", name: Lexer::text_or_empty(errorset_name_token, parser.source), line: function_line}) if is_errorset_kw
                # `permission P` — a PHANTOM parameter naming an effect row, used only in a
                # `can[P]` clause. It has no representation, so the call site supplies no type
                # argument for it. Without this the `permission` KEYWORD was itself recorded as
                # the generic parameter name, making pool_submit1's param_count 3 against the
                # 2 type args `submit` passes — instantiate_generic_at's arity check then
                # declined, dropping for_indices_par. Skipped like a region parameter: the
                # backend never resolves P as a type.
                is_permission_kw: bool = depth == 0 and expect_name and kind == TokenKind.Ident and Lexer::text_or_empty(token, parser.source) == "permission" and parser.peek_at(1) == TokenKind.Ident
                is_generic_name: bool = depth == 0 and expect_name and kind == TokenKind.Ident and not is_errorset_kw and not is_permission_kw
                is_bound_name: bool = depth == 0 and expect_bound and kind == TokenKind.Ident
                region_parameter: bool = depth == 0 and kind == TokenKind.At and parser.peek_at(1) == TokenKind.Ident
                region_name_token: Token = parser.tokens[parser.position + 1] if region_parameter else token
                parser.local_region_annotations <- parser.local_region_annotations.push(Ast::LocalRegionAnnotation{name: "__region_param", type_expression: (Ast::Expr.Invalid), region: Lexer::text_or_empty(region_name_token, parser.source), line: function_line}) if region_parameter
                parser.generic_param_lines <- parser.generic_param_lines.push(function_line) if is_generic_name
                parser.generic_param_names <- parser.generic_param_names.push(Lexer::text_or_empty(token, parser.source)) if is_generic_name
                # Bound rows share the proven-stable generic side table. The high line
                # bit distinguishes metadata from ordinary parameter rows, so existing
                # exact-line scope consumers ignore it.
                parser.generic_param_lines <- parser.generic_param_lines.push(function_line + 2147483648) if is_bound_name
                parser.generic_param_names <- parser.generic_param_names.push(Lexer::text_or_empty(token, parser.source)) if is_bound_name
                expect_name <- false if depth == 0 and (is_generic_name or is_errorset_kw or is_permission_kw or kind == TokenKind.At)
                expect_bound <- true if depth == 0 and kind == TokenKind.Colon
                expect_bound <- false if is_bound_name or (depth == 0 and kind == TokenKind.Comma)
                expect_name <- true if depth == 0 and kind == TokenKind.Comma
                depth <- depth + 1 if kind == TokenKind.LParen or kind == TokenKind.LBracket
                depth <- depth - 1 if kind == TokenKind.RParen or kind == TokenKind.RBracket
                parser, _ <- parser.advance()
            parser, _ <- parser.expect(TokenKind.RBracket)



        # Dispatch the function body form. A region-polymorphic `darray[Ast::Stmt]`
        # can't be threaded out through a mutable-ref out-param (the callee's `in
        # auto:` region doesn't survive the store into the caller's ref — "value
        # escapes its `in auto:` scope") the way a plain-value out-param can, and a
        # 3-way ternary chain of real calls doesn't thread `parser` reliably either, so
        # each branch is a sequential value-first exit guard instead: call the one real
        # function that applies and return its (region-poly) result directly.
        def resolve_function_body(parser: lmut Parser, accepted_assign: bool, is_block_body: bool) -> darray[Ast::Stmt]:
            no_declared_body: darray[Ast::Stmt] = []
            no_declared_body return if not accepted_assign and not is_block_body
            # The expression-body parse must be cond-guarded: calling it unconditionally
            # consumes the block `:` as an expression and breaks every block-bodied def.
            # Both branches are re-materialized locally: a darray forwarded straight out
            # of this frame dies with this frame's auto region (see parse_block).
            rebind expr_body: darray[Ast::Stmt], parser = parser.parse_expression_bodied_function_if(accepted_assign)
            adopted_expr_body: darray[Ast::Stmt] = [statement for statement in expr_body]
            adopted_expr_body return if accepted_assign
            rebind block_body: darray[Ast::Stmt], parser = parser.parse_block()
            return [statement for statement in block_body]



        def parse_expression_bodied_function_if(parser: lmut Parser, cond: bool) -> darray[Ast::Stmt]:
            no_body: darray[Ast::Stmt] = []
            no_body return if not cond
            rebind body: darray[Ast::Stmt], parser = parser.parse_expression_bodied_function()
            return [statement for statement in body]



        def drain_pending_fulfills(parser: lmut Parser, function_name: sview) -> void:
            saved_position: usize = parser.position
            parser.position <- 0
            machine over parser.position while parser.position < parser.pending_fulfills.count:
                state Drain
                start Drain

                Drain, _:
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: function_name, name: parser.pending_fulfills[parser.position], line: 3900000021})
                    parser.position <- parser.position + 1
                    -> Drain
            parser.pending_fulfills <- parser.pending_fulfills.truncate(0)
            parser.position <- saved_position



        def drain_pending_fulfills_is(parser: lmut Parser, function_name: sview) -> void:
            saved_position: usize = parser.position
            parser.position <- 0
            machine over parser.position while parser.position < parser.pending_fulfills_is_law.count:
                state Drain
                start Drain

                Drain, _:
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: function_name, name: parser.pending_fulfills_is_law[parser.position], line: 3900000029})
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: function_name, name: parser.pending_fulfills_is_subject[parser.position], line: 3900000030})
                    parser.position <- parser.position + 1
                    -> Drain
            parser.pending_fulfills_is_subject <- parser.pending_fulfills_is_subject.truncate(0)
            parser.pending_fulfills_is_law <- parser.pending_fulfills_is_law.truncate(0)
            parser.position <- saved_position



        # Move the per-signature captured contracts into the file-level accumulators, tagged with
        # the owning function's line, then clear the per-signature buffers.
        def drain_signature_contracts(parser: lmut Parser, function_line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                saved_position: usize = parser.position
                parser.position <- 0
                machine over parser.position while parser.position < parser.captured_contract_kinds.count:
                    state Drain
                    start Drain

                    Drain, _:
                        parser.signature_contract_lines <- parser.signature_contract_lines.push(function_line)
                        parser.signature_contract_kinds <- parser.signature_contract_kinds.push(parser.captured_contract_kinds[parser.position])
                        parser.signature_contract_exprs <- parser.signature_contract_exprs.push(parser.captured_contract_exprs[parser.position])
                        parser.position <- parser.position + 1
                        -> Drain
                parser.captured_contract_kinds <- parser.captured_contract_kinds.truncate(0)
                parser.captured_contract_exprs <- parser.captured_contract_exprs.truncate(0)
                parser.position <- saved_position



        def capture_return_type_and_effects(parser: lmut Parser, has_arrow: bool) -> Ast::Expr?:
            null return if not has_arrow
            parser <- parser.reject_positional_tuple_type_ahead()
            parser <- parser.capture_declared_thread_slots()
            # A `fn(A)->R` RETURN type is followed by the function's own `:` body; mark type
            # context so a lambda-type's block-body branch does not swallow that body.
            parser.in_type_annotation <- true
            rebind return_type_opt: Ast::Expr?, parser = parser.expression()
            parser.in_type_annotation <- false
            if return_type_opt is return_type:
                rebind refined_return_type: Ast::Expr, parser = parser.parse_refinement_suffix(return_type)
                parser <- parser.record_tuple_type(refined_return_type)
                return refined_return_type
            return return_type_opt



        # Expression-bodied function `def f(...) -> T = EXPR`: builds the one-element
        # body as a list literal (not `[]`+push): a push-only fresh darray does not
        # survive the region-polymorphic return, but a seeded literal is adopted.
        def parse_expression_bodied_function(parser: lmut Parser) -> darray[Ast::Stmt]:
            value_token: Token = parser.cursor()
            return_value: mutable Ast::Expr? = null
            rebind value_expr_opt: Ast::Expr?, parser = parser.expression()
            if value_expr_opt is value_expr:
                return_value <- value_expr
            rebind body: darray[Ast::Stmt], parser = parser.single_statement_body((Ast::Stmt.Return(return_value, Ast::pos_of_token(value_token))))
            return [statement for statement in body]




        # Guest-overlay member clause (`struct X layout(guest, size: N):`): a trailing
        # `at OFFSET [requires size >= N]` after a field. The offset and minimum-size guard
        # aren't modeled in stage1; consume them so the member line parses. A no-op when the
        # next token isn't the contextual `at` keyword.
        def skip_guest_overlay_clause(parser: lmut Parser, field_name: sview) -> void:
            at_token: Token = parser.cursor()
            is_at_clause: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(at_token, parser.source) == "at"
            parser <- parser.consume_guest_overlay_at_clause(field_name) if is_at_clause



        # `at OFFSET [requires size >= N]`, entered with the cursor on `at`. The offset
        # (and any minimum-size guard) is RECORDED (owner "__overlay_field" /
        # "__overlay_reqsize", the numeric riding in `line`) so the guest-overlay checks
        # can validate accesses; fields follow their struct's "__overlay_struct" marker.
        def consume_guest_overlay_at_clause(parser: lmut Parser, field_name: sview) -> void:
            parser, _ <- parser.advance()               # `at`
            offset_token: Token = parser.cursor()
            parser, _ <- parser.advance()               # OFFSET (int/hex literal)
            offset_value: u32 = parse_layout_number(Lexer::text_or_empty(offset_token, parser.source))
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__overlay_field", name: field_name, line: offset_value})
            requires_token: Token = parser.cursor()
            has_requires: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(requires_token, parser.source) == "requires"
            if has_requires:
                # `requires size >= N` — capture N before skipping the tail.
                bound_value: mutable u32 = 0
                scan: mutable usize = 0
                while parser.peek_at(scan) != TokenKind.Newline and parser.peek_at(scan) != TokenKind.Eof |parser, scan, bound_value|:
                    scan_token: Token = parser.tokens[parser.position + scan]
                    candidate: u32 = parse_layout_number(Lexer::text_or_empty(scan_token, parser.source)) if scan_token.kind == TokenKind.IntLit else 0
                    bound_value <- candidate if candidate != 0
                    scan <- scan + 1
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__overlay_reqsize", name: field_name, line: bound_value})
            parser <- parser.skip_to_line_end() if has_requires

include "./parser_func_params.elisa"
include "./parser_func_thread_slots.elisa"
