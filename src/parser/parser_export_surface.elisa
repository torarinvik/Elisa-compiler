# Stage1 parser — the EXPORT declarations: `export pymodule NAME:` and its body, `export type`,
# `export global Mod::name as alias`, and the `export fn`/`export def` signatures. Each records
# an annotation pair the driver's emitters read back.
# Part of `module Parser` (see parser.elisa).

extend Parser:
    private:

        # `export pymodule NAME:` is the Python-module export surface. The module body is
        # intentionally metadata-only in this first stage: each `fn public = target` row (or the
        # opt-in `fn *`/`const *` wildcard) is retained in the file annotation table, while the
        # ordinary declarations stay in the enclosing file and are compiled exactly as before.
        # Keeping this out of Decl avoids changing the stable AST layout shared by stage0/stage1
        # and gives the backend a clean metadata boundary for native-symbol and CPython-wrapper
        # emission.
        def capture_export_pymodule_decl(parser: lmut Parser, token: Token, decl: mutable Ast::Decl&) -> void:
            can Abort.Panic, Memory.Allocate:
                parser, _ <- parser.advance()                         # `pymodule`
                module_token: Token = parser.cursor()
                module_name: sview = Lexer::text_or_empty(module_token, parser.source) if parser.peek() == TokenKind.Ident else ""
                parser <- parser.error_at(Ast::ParseErrorKind.ExpectedDeclaration, module_token) if module_name == ""
                parser, _ <- parser.advance() if module_name != ""
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: module_name, name: "__export_pymodule", line: token.line}) if module_name != ""
                parser <- parser.capture_export_pymodule_body(module_name) if parser.peek() == TokenKind.Colon
                parser <- parser.skip_extern_line_remainder() if parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof
                decl <- (Ast::Decl.Extern(module_name, 0, 0, false, false, "", parser.pending_decorators, Ast::pos_of_token(token)))



        # Consume the indented `pymodule` body and record one annotation pair per function.
        # `__pymodule_fn` is keyed by the public Python name; the matching
        # `__pymodule_target_ref` row carries the Elisa target and shares its source line.
        # Assigned targets are retained as a source-backed path, so `fn add = Math::add`
        # stays lossless in manifests and can be resolved without allocating a joined name.
        def capture_export_pymodule_body(parser: lmut Parser, module_name: sview) -> void:
            can Abort.Panic, Memory.Allocate:
                parser, _ <- parser.expect(TokenKind.Colon)
                parser, _ <- parser.expect(TokenKind.Newline)
                rebind accepted_indent: bool, parser = parser.accept(TokenKind.Indent)
                return if not accepted_indent
                while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser, module_name|:
                    parser <- parser.skip_newlines()
                    break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof
                    line: u32 = parser.cursor().line
                    fn_word: Token = parser.cursor()
                    is_fn: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(fn_word, parser.source) == "fn"
                    is_const: bool = parser.peek() == TokenKind.Const
                    parser, _ <- parser.advance() if is_fn or is_const
                    public_token: Token = parser.cursor()
                    is_wildcard: bool = (is_fn or is_const) and parser.peek() == TokenKind.Star
                    public_name: sview = "*" if is_wildcard else (Lexer::text_or_empty(public_token, parser.source) if (is_fn or is_const) and parser.peek() == TokenKind.Ident else "")
                    parser, _ <- parser.advance() if public_name != ""
                    accepted_assign: bool = parser.peek() == TokenKind.Assign
                    parser, _ <- parser.accept(TokenKind.Assign) if accepted_assign
                    target_token: Token = parser.cursor()
                    # The common case is a same-name export (`fn parse`), so the
                    # assignment is optional when the line ends after the public name.
                    # Keep `fn public = implementation` for explicit renames.
                    shorthand: bool = (is_fn or is_const) and public_name != "" and not accepted_assign and (parser.peek() == TokenKind.Newline or parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof)
                    target_name: mutable sview = public_name if shorthand else ""
                    if accepted_assign and parser.peek() == TokenKind.Ident:
                        target_start: usize = target_token.start.usize()
                        target_end: mutable usize = (target_token.start + target_token.length).usize()
                        parser, _ <- parser.advance()
                        # The final segment is the callable/constant name. Keep the whole
                        # `Module::name` path in the annotation; consumers split it at the
                        # last scope separator when they need the owner and leaf separately.
                        while parser.peek() == TokenKind.Scope and parser.peek_at(1) == TokenKind.Ident |parser, target_end|:
                            parser, _ <- parser.advance()
                            rebind target_segment: Token, parser = parser.advance()
                            target_end <- (target_segment.start + target_segment.length).usize()
                        target_name <- parser.span_view(target_start, target_end)
                    # `fn *` / `const *` are explicit opt-in wildcards. They are expanded by the
                    # pymodule emitters after the complete AST is available, so the declaration
                    # may appear before the functions/constants it exports.
                    wildcard_row: bool = is_wildcard and not accepted_assign and (parser.peek() == TokenKind.Newline or parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof)
                    if is_fn and wildcard_row:
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "*", name: "__pymodule_fn_all", line: line})
                    elif is_const and wildcard_row:
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "*", name: "__pymodule_const_all", line: line})
                    elif is_fn and public_name != "" and target_name != "":
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: public_name, name: "__pymodule_fn", line: line})
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: target_name, name: "__pymodule_target_ref", line: line})
                    elif is_const and public_name != "" and target_name != "":
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: public_name, name: "__pymodule_const", line: line})
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: target_name, name: "__pymodule_const_target_ref", line: line})
                    else:
                        parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, fn_word)
                    parser <- parser.skip_extern_line_remainder()
                parser, _ <- parser.expect(TokenKind.Dedent)



        def capture_export_type_decl(parser: lmut Parser, token: Token, decl: mutable Ast::Decl&) -> void:
            parser, _ <- parser.advance()
            target_token: Token = parser.cursor()
            target_name: sview = Lexer::text_or_empty(target_token, parser.source) if parser.peek() == TokenKind.Ident else ""
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: target_name, name: "__export_type", line: token.line}) if target_name != ""
            # Preserve the public spelling of a concrete export (`export type T as Public`).
            # The old parser discarded everything after T, which made the backend unable to
            # name exported aggregate definitions in a C ABI header.
            alias_name: mutable sview = ""
            scan: mutable usize = 1
            machine over alias_name while true:
                state Scan(index: usize)
                start Scan(1)

                Scan(index), _ if parser.peek_at(index) == TokenKind.Newline or parser.peek_at(index) == TokenKind.Eof:
                    break

                Scan(index), _ if parser.peek_at(index) == TokenKind.As and parser.peek_at(index + 1) == TokenKind.Ident:
                    alias_token: Token = parser.tokens[parser.position + index + 1]
                    alias_name <- Lexer::text_or_empty(alias_token, parser.source)
                    -> Scan(index + 1)

                Scan(index), _:
                    -> Scan(index + 1)
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: alias_name, name: target_name, line: token.line}) if alias_name != "" and target_name != ""
            parser <- parser.skip_extern_line_remainder()
            decl <- (Ast::Decl.Extern(target_name, parser.extern_params.count.u32(), 0, false, false, "", parser.pending_decorators, Ast::pos_of_token(token)))



        # `is_export_global` branch of `extern_declaration`, isolated to a single real
        # call so the caller's guarded reassign threads `parser` cleanly.
        def capture_export_global_decl(parser: lmut Parser, token: Token, decl: mutable Ast::Decl&) -> void:
            rebind parsed: Ast::Decl, parser = parser.parse_export_global_extern(token)
            decl <- parsed



        # The non-`export global` branch of `extern_declaration`. Same single-call
        # isolation as `capture_export_global_decl` above.
        def capture_extern_signature_decl(parser: lmut Parser, token: Token, decl: mutable Ast::Decl&) -> void:
            rebind parsed: Ast::Decl, parser = parser.parse_extern_signature_and_body(token)
            decl <- parsed



        # `export global Mod::name [as alias]`: record the public alias when present,
        # otherwise the final target segment. The full target is stage0's concern;
        # stage1 only needs one symbol name.
        def parse_export_global_extern(parser: lmut Parser, token: Token) -> Ast::Decl:
            parser, _ <- parser.advance()               # `global`
            exported_name: mutable sview = ""
            target_name: mutable sview = ""
            while parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser, exported_name|:
                is_alias: bool = parser.peek() == TokenKind.As and parser.peek_at(1) == TokenKind.Ident
                is_plain_ident: bool = not is_alias and parser.peek() == TokenKind.Ident
                parser <- parser.capture_export_alias(exported_name) if is_alias
                parser <- parser.capture_export_part(exported_name) if is_plain_ident
                target_name <- exported_name if is_plain_ident else target_name
                parser <- parser.advance_when(not is_alias and not is_plain_ident)
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: target_name, name: "__export_global", line: token.line}) if target_name != ""
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: exported_name, name: target_name, line: token.line}) if exported_name != "" and target_name != ""
            return (Ast::Decl.Extern(exported_name, parser.extern_params.count.u32(), 0, false, false, "", parser.pending_decorators, Ast::pos_of_token(token)))



        # `as alias` — consume the `as` and record the alias identifier's text.
        def capture_export_alias(parser: lmut Parser, exported_name: mutable sview&) -> void:
            parser, _ <- parser.advance()               # `as`
            rebind alias_token: Token, parser = parser.advance()
            exported_name <- Lexer::text_or_empty(alias_token, parser.source)



        # A bare `Mod::name` path segment — consume it and record its text (later
        # segments overwrite earlier ones, matching "the final target segment").
        def capture_export_part(parser: lmut Parser, exported_name: mutable sview&) -> void:
            rebind part_token: Token, parser = parser.advance()
            exported_name <- Lexer::text_or_empty(part_token, parser.source)



        # The non-`export global` extern forms: `export fn NAME …` / `export def NAME …`
        # / typed `extern name: T` / `extern:`/`export:` blocks.
        def parse_extern_signature_and_body(parser: lmut Parser, token: Token) -> Ast::Decl:
            can Abort.Panic:
                # `export fn NAME …` / `export def NAME …`: skip the leading func/def word
                # so the captured name is the exported symbol, not the keyword.
                parser, _ <- parser.accept(TokenKind.Def)
                parser <- parser.skip_export_func_word() if parser.peek() == TokenKind.Ident
                # The external name is the first identifier; record it so it becomes a symbol.
                name_cursor: Token = parser.cursor()
                is_name_ident: bool = parser.peek() == TokenKind.Ident
                name: mutable sview = Lexer::text_or_empty(name_cursor, parser.source) if is_name_ident else ""
                parser <- parser.advance_when(is_name_ident)
                rebind accepted_generic_header: bool, parser = parser.accept(TokenKind.LBracket)
                # `extern push[T](box: mutable MethodBox[T]&, item: T)` — the generic header was
                # SKIPPED outright, so `T` was never a known type parameter, every parameter
                # mentioning it resolved Unmodeled, and the extern failed to register at all.
                # Record the FIRST type parameter and the owning extern's name as a pair keyed
                # by the declaration LINE, matching how the `__extern_return*` rows are keyed.
                generic_param_token: Token = parser.cursor()
                extern_generic_param: sview = Lexer::text_or_empty(generic_param_token, parser.source) if accepted_generic_header and parser.peek() == TokenKind.Ident else sview("", 0, 0)
                if extern_generic_param != "" and name != "":
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_generic_param", name: extern_generic_param, line: token.line})
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_generic_name", name: name, line: token.line})
                parser <- parser.skip_bracketed_group() if accepted_generic_header
                error_family: sview = parser.header_error_family()
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__error_return", line: token.line}) if error_family != ""
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: error_family, line: token.line}) if error_family != ""
                parser <- parser.capture_header_error_families(token.line, token.start) if error_family != ""
                is_export_signature: bool = Lexer::text_or_empty(token, parser.source) == "export"
                has_fixed_array_boundary: bool = parser.header_has_fixed_array_type(is_export_signature)
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__export_array", line: token.line}) if has_fixed_array_boundary
                has_params: bool = parser.peek() == TokenKind.LParen
                parser <- parser.reject_extern_param_defaults() if is_export_signature and has_params
                arity: mutable u32 = 0
                variadic: mutable bool = false
                param_start: u32 = parser.extern_params.count.u32()
                parser <- parser.scan_extern_params(arity, variadic) if has_params
                extern_return_type: mutable sview = parser.extern_return_type_head()
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_return", name: extern_return_type, line: token.line}) if extern_return_type != ""
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_return_ptr", name: name, line: token.line}) if extern_return_type != "" and parser.extern_return_is_pointer()
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_return_optional", name: name, line: token.line}) if extern_return_type != "" and parser.extern_return_is_optional()
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__extern_effect", line: token.line}) if parser.header_has_signature_can()
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__extern_segment_owner", line: token.line}) if parser.header_grants_segment_owner()
                parser <- parser.record_extern_segment_flow(name, token.line) if name != ""
                extern_darray_element: sview = parser.extern_return_darray_element()
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__extern_return_darray", line: token.line}) if extern_darray_element != "" and name != ""
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: extern_darray_element, name: "__extern_return_darray_elem", line: token.line}) if extern_darray_element != ""
                extern_shape: sview = parser.extern_return_darray_shape()
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_return_shape", name: extern_shape, line: token.line}) if extern_shape != ""
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_return_shape_fn", name: name, line: token.line}) if extern_shape != ""
                extern_effect_ref: sview = parser.header_signature_can_ref()
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_effect_ref", name: extern_effect_ref, line: token.line}) if extern_effect_ref != ""
                # A `@blocking` extern requires `Blocking.RawExtern` at every call site (verified
                # against stage0: fires even under `can Blocking.Wait:` — a distinct member). Register
                # it as an extern effect (owner + adjacent ref) so the ungranted-effect check sees it.
                has_blocking: mutable bool = false
                machine over has_blocking while true:
                    state Scan(index: usize)
                    start Scan(0)

                    Scan(_), _ if has_blocking:
                        break

                    Scan(index), _ if index >= parser.pending_decorators.count:
                        break

                    Scan(index), _ if parser.pending_decorators[index].name == "blocking":
                        has_blocking <- true
                        -> Scan(index + 1)

                    Scan(index), _:
                        -> Scan(index + 1)
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__extern_effect", line: token.line}) if has_blocking
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_effect_ref", name: "Blocking.RawExtern", line: token.line}) if has_blocking
                # Retain the export-vs-extern distinction and the `= TARGET` re-export target on
                # the side-table (the node signature drops both), so semantic can validate
                # duplicate export names and undefined re-export targets.
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__export_fn", line: token.line}) if is_export_signature and name != ""
                parser <- parser.capture_export_reexport_target(name, token.line) if is_export_signature
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__extern_contract", line: token.line}) if name != "" and parser.header_has_signature_contract()
                parser <- parser.capture_extern_header_contracts(token.line)  # capture `requires`, then skip the rest to the block colon or end of line
                # Only `extern:` / `export:` followed by a newline opens an indented block;
                # a typed `extern name: T` stops at the colon (skip the rest of the line).
                has_trailing_block: bool = parser.peek() == TokenKind.Colon and parser.peek_at(1) == TokenKind.Newline
                # A non-call extern uses the same return-type side table as a callable
                # extern, even though its type follows `:` rather than `->`.
                extern_return_type <- parser.typed_extern_global_type() if not has_params and not has_trailing_block
                parser <- parser.capture_typed_extern_global_type(name) if not has_params and not has_trailing_block
                parser <- parser.parse_extern_trailing_block() if has_trailing_block
                # Typed `extern name: T` (or any single-line extern): consume the remainder
                # of the line (the `: T`) so it isn't reparsed.
                parser <- parser.skip_extern_line_remainder() if not has_trailing_block
                return (Ast::Decl.Extern(name, param_start, arity, variadic, has_params, extern_return_type, parser.pending_decorators, Ast::pos_of_token(token)))




            # `extern errno_value: i32` — capture the first type name after the colon
            # without consuming it. The line skipper below owns cursor advancement.
        def typed_extern_global_type(parser: Parser&) -> sview:
            can Abort.Panic:
                "" return if parser.peek() != TokenKind.Colon
                machine over parser.position:
                    state Scan(index: usize)
                    start Scan(1)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Ident:
                        return parser.header_token_text(index)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Newline or parser.peek_at(index) == TokenKind.Eof:
                        return ""

                    Scan(index), _:
                        -> Scan(index + 1)
                return ""




        # Decl.Extern intentionally keeps only a bare type head for compact ABI metadata.
        # Typed non-call externs need their COMPLETE type as well: `array` by itself cannot
        # describe the nested storage of a cross-module C global such as `actorat`. Parse the
        # annotation with the ordinary type-expression grammar, retain the AST in parallel
        # rows, then restore the cursor because skip_extern_line_remainder owns the line.
        def capture_typed_extern_global_type(parser: lmut Parser, name: sview) -> void:
            can Abort.Panic, Memory.Allocate:
                return if parser.peek() != TokenKind.Colon
                saved_position: usize = parser.position
                parser, _ <- parser.advance()
                previous_type_context: bool = parser.in_type_annotation
                parser.in_type_annotation <- true
                rebind parsed_type: Ast::Expr?, parser = parser.expression()
                parser.in_type_annotation <- previous_type_context
                if parsed_type is type_expression:
                    parser.extern_global_type_names <- parser.extern_global_type_names.push(name)
                    parser.extern_global_type_exprs <- parser.extern_global_type_exprs.push(type_expression)
                parser.position <- saved_position



        # `func`/`fn` word immediately after `export`/`extern` before the name.
        def skip_export_func_word(parser: lmut Parser) -> void:
            func_word: Token = parser.cursor()
            func_word_text: sview = Lexer::text_or_empty(func_word, parser.source)
            parser <- parser.error_removed(func_word, "`export func` has been renamed to `export fn`") if func_word_text == "func"
            parser <- parser.advance_when(func_word_text == "func" or func_word_text == "fn")



        # Scan (without consuming) the rest of an `export fn` signature line for a `= TARGET`
        # re-export clause and record TARGET on the side-table for the undefined-target check.
        def record_export_reexport_target(parser: lmut Parser, export_name: sview, target_name: sview, line: u32) -> void:
            return if export_name == "" or target_name == ""
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: export_name, name: target_name, line: line})
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: target_name, name: "__export_target_ref", line: line})



        def record_export_reexport_generic_if(parser: lmut Parser, export_name: sview, target_name: sview, line: u32, argument: sview, has_argument: bool) -> void:
            return if not has_argument or export_name == ""
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: export_name, name: argument, line: 3900000060})



        def capture_export_reexport_target(parser: lmut Parser, export_name: sview, line: u32) -> void:
            saved_position: usize = parser.position
            machine over parser.position while true:
                state Scan(scan: usize)
                start Scan(0)

                Scan(scan), _ if saved_position + scan >= parser.tokens.count or parser.tokens[saved_position + scan].kind == TokenKind.Newline or parser.tokens[saved_position + scan].kind == TokenKind.Dedent or parser.tokens[saved_position + scan].kind == TokenKind.Eof:
                    break

                Scan(scan), _ if parser.tokens[saved_position + scan].kind == TokenKind.Assign and saved_position + scan + 1 < parser.tokens.count and parser.tokens[saved_position + scan + 1].kind == TokenKind.Ident:
                    target_token: Token = parser.tokens[saved_position + scan + 1]
                    target_name: sview = Lexer::text_or_empty(target_token, parser.source)
                    has_generic_argument: bool = saved_position + scan + 3 < parser.tokens.count and parser.tokens[saved_position + scan + 2].kind == TokenKind.LBracket and parser.tokens[saved_position + scan + 3].kind == TokenKind.Ident
                    generic_argument: sview = Lexer::text_or_empty(parser.tokens[saved_position + scan + 3], parser.source) if has_generic_argument else sview("", 0, 0)
                    parser <- parser.record_export_reexport_target(export_name, target_name, line)
                    parser <- parser.record_export_reexport_generic_if(export_name, target_name, line, generic_argument, has_generic_argument)
                    parser.position <- saved_position + scan + 1
                    -> Scan(scan + 1)

                Scan(scan), _:
                    parser.position <- saved_position + scan + 1
                    -> Scan(scan + 1)
            parser.position <- saved_position
