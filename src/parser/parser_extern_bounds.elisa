# Stage1 parser — `@bounds(buf, count, ...)` on an extern (docs/127 §3.3, legacy form): the
# native prototype takes a pointer and a separate length; the Elisa-facing signature takes ONE
# bounded `view[T]` and the compiler supplies the length from `buf.count`. The rewrite happens
# HERE, on the extern's parameter rows, so the semantic layer and the backend both see the
# bounded signature (mirrors stage0's AST rewrite before its function type is built). What
# the backend still needs — the C parameter ORDER — is recorded as `__bounds_cpart`
# annotations, one per C position, `line` = new_index * 8 + part (0 whole, 1 pointer,
# 2 length). Validation failures are recorded for the semantic layer to report with
# stage0's messages; a failed annotation performs no rewrite.
# Part of `module Parser` (see parser.elisa).

extend Parser:
    private:
        def bounds_param_index(parser: Parser&, param_start: u32, arity: u32, wanted: sview) -> i64:
            can Abort.Panic:
                for offset in 0..<arity.usize():
                    offset.i64() return if parser.extern_params[param_start.usize() + offset].name == wanted
                return -1

        def bounds_type_is_integer(name: sview) -> bool:
            return name == "usize" or name == "isize" or name == "int" or name == "uint" or name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "uintptr"

        def bounds_index_listed(indices: darray[i64]&, wanted: i64) -> bool:
            can Abort.Panic:
                return any listed in indices where listed == wanted

        def apply_extern_bounds(parser: lmut Parser, extern_name: sview, param_start: u32, arity: mutable u32&, extern_line: u32) -> void:
            can Abort.Panic, Memory.Allocate:
                decorators: darray[Ast::Annotation] = parser.pending_decorators
                ptr_indices: mutable darray[i64] = []
                len_indices: mutable darray[i64] = []
                failed: mutable bool = false
                for decorator in decorators |parser, ptr_indices, len_indices, failed, arity|:
                    continue if decorator.name != "bounds" or failed
                    if decorator.arg_count == 0 or decorator.arg_count % 2 != 0:
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: extern_name, name: "__bounds_odd", line: extern_line})
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: extern_name, name: "__bounds_odd_count", line: decorator.arg_count})
                        failed <- true
                        continue
                    for pair in 0..<(decorator.arg_count / 2) |parser, ptr_indices, len_indices, failed, arity|:
                        continue if failed
                        ptr_name: sview = parser.annotation_args[decorator.arg_start.usize() + (pair * 2).usize()]
                        len_name: sview = parser.annotation_args[decorator.arg_start.usize() + (pair * 2).usize() + 1.usize()]
                        ptr_index: i64 = bounds_param_index(parser, param_start, arity, ptr_name)
                        len_index: i64 = bounds_param_index(parser, param_start, arity, len_name)
                        if ptr_index < 0 or len_index < 0:
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: ptr_name if ptr_index < 0 else len_name, name: "__bounds_unknown", line: extern_line})
                            failed <- true
                            continue
                        if ptr_index == len_index or bounds_index_listed(ptr_indices, ptr_index) or bounds_index_listed(len_indices, ptr_index) or bounds_index_listed(ptr_indices, len_index) or bounds_index_listed(len_indices, len_index):
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: ptr_name, name: "__bounds_reused", line: extern_line})
                            failed <- true
                            continue
                        ptr_row: Ast::ExternParam = parser.extern_params[param_start.usize() + ptr_index.usize()]
                        if not ptr_row.is_ref or ptr_row.optional:
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: ptr_name, name: "__bounds_badptr", line: extern_line})
                            failed <- true
                            continue
                        len_row: Ast::ExternParam = parser.extern_params[param_start.usize() + len_index.usize()]
                        if len_row.is_ref or not bounds_type_is_integer(len_row.type_name):
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: len_name, name: "__bounds_badlen", line: extern_line})
                            failed <- true
                            continue
                        ptr_indices.push(ptr_index)
                        len_indices.push(len_index)
                return if failed or ptr_indices.count == 0
                # The pairs, for the semantic checks (contract mentions, D6): owner, ptr, len per pair.
                for pair_index in 0..<ptr_indices.count |parser, ptr_indices, len_indices|:
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: extern_name, name: "__bounds_owner", line: extern_line})
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: parser.extern_params[param_start.usize() + ptr_indices[pair_index].usize()].name, name: "__bounds_ptr", line: extern_line})
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: parser.extern_params[param_start.usize() + len_indices[pair_index].usize()].name, name: "__bounds_len", line: extern_line})
                # The rewritten rows: pointers become views, lengths disappear.
                kept: mutable darray[Ast::ExternParam] = []
                new_index: mutable darray[i64] = []
                for offset in 0..<arity.usize() |kept, new_index, parser, ptr_indices, len_indices|:
                    row: Ast::ExternParam = parser.extern_params[param_start.usize() + offset]
                    if bounds_index_listed(len_indices, offset.i64()):
                        new_index.push(-1)
                        continue
                    new_index.push(kept.count.i64())
                    if bounds_index_listed(ptr_indices, offset.i64()):
                        kept.push(Ast::ExternParam{name: row.name, type_name: "view", element_type_name: row.type_name, provenance_bearing: false, mutable_ref: row.mutable_ref, fn_type_line: 0, fn_type_param_count: 0, pos: row.pos, is_ref: false, optional: false})
                    else:
                        kept.push(row)
                # The C order, one code per original position.
                for offset in 0..<arity.usize() |parser, new_index, ptr_indices, len_indices|:
                    code: mutable u32 = 0
                    if bounds_index_listed(len_indices, offset.i64()):
                        for pair_index in 0..<len_indices.count |code, len_indices, ptr_indices, new_index|:
                            code <- new_index[ptr_indices[pair_index].usize()].u32() * 8 + 2 if len_indices[pair_index] == offset.i64()
                    elif bounds_index_listed(ptr_indices, offset.i64()):
                        code <- new_index[offset].u32() * 8 + 1
                    else:
                        code <- new_index[offset].u32() * 8
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: extern_name, name: "__bounds_cpart", line: code})
                parser.extern_params <- parser.extern_params.truncate(param_start.usize())
                for row in kept |parser|:
                    parser.extern_params <- parser.extern_params.push(row)
                arity <- kept.count.u32()
