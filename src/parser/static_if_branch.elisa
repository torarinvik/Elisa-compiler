# Shared, serialized branch tags for static-if rows. Parser and backend must agree because the
# parser stores every branch kind in Ast::File and the backend later selects live branches.
module StaticIfBranch:
    public:
        const enum Kind of u32:
            ChainHead
            ChainContinuation
            Fallback

        const TOP_LEVEL_DEPTH: u32 = 0
        const NESTING_LEVEL_STEP: u32 = 1
        const CONDITION_FALSE_VALUE: i64 = 0
