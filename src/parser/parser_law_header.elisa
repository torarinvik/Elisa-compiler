# Stage1 parser — a law's `(params)` HEADER (`extend Parser: private:`). A predicate law and a
# value law share one spelling, so the header is first probed non-destructively for its subject
# type and only then consumed into ParamDecls. Continues parser_decl_law.elisa.

extend Parser:
    private:

        # If the cursor is on a law's `(params)` header, consume it (so the following
        # `changes`/`preserves`/`=` can be inspected). Returns whether the params contain a
        # `&` (a reference `self`) — a `changes`/`preserves` frame law needs one.
        # Non-destructive: whether the law's `(params)` header (at the current cursor) names at
        # least one parameter — a `self`/value subject. `()` or a missing header means none.
        def law_header_has_subject(parser: Parser&) -> bool:
            can Abort.Panic:
                offset: mutable usize = 0
                # Skip a leading generic-parameter group `[...]` (`law Name[T](self: T)`), so the
                # `(params)` header is found even on a generic law.
                if parser.peek_at(offset) == TokenKind.LBracket:
                    offset <- 1
                    machine over offset while true:
                        state Scan(depth: int)
                        start Scan(1)

                        Scan(depth), _ if depth <= 0 or parser.peek_at(offset) == TokenKind.Eof:
                            break

                        Scan(depth), _ if parser.peek_at(offset) == TokenKind.LBracket:
                            offset <- offset + 1
                            -> Scan(depth + 1)

                        Scan(depth), _ if parser.peek_at(offset) == TokenKind.RBracket:
                            offset <- offset + 1
                            -> Scan(depth - 1)

                        Scan(depth), _:
                            offset <- offset + 1
                            -> Scan(depth)
                false return if parser.peek_at(offset) != TokenKind.LParen
                offset <- offset + 1
                found: mutable bool = false
                machine over found while true:
                    state Scan(offset: usize, depth: int)
                    start Scan(offset, 1)

                    Scan(offset, depth), _ if depth <= 0 or parser.peek_at(offset) == TokenKind.Eof:
                        break

                    Scan(offset, depth), _ if parser.peek_at(offset) == TokenKind.LParen:
                        -> Scan(offset + 1, depth + 1)

                    Scan(offset, depth), _ if parser.peek_at(offset) == TokenKind.RParen:
                        -> Scan(offset + 1, depth - 1)

                    Scan(offset, depth), _ if parser.peek_at(offset) == TokenKind.Ident and depth >= 1:
                        found <- true
                        -> Scan(offset + 1, depth)

                    Scan(offset, depth), _:
                        -> Scan(offset + 1, depth)
                return found



        # Non-destructive: the SUBJECT type name of a law header — the type of the first parameter
        # (`law N(self: i64, …)` -> "i64"), i.e. the first identifier after the first `:`. "" when
        # there is no header/parameter. Looks through a leading generic `[…]` group.
        def law_header_subject_type(parser: Parser&) -> sview:
            can Abort.Panic:
                offset: mutable usize = 0
                if parser.peek_at(offset) == TokenKind.LBracket:
                    offset <- 1
                    machine over offset while true:
                        state Scan(depth: int)
                        start Scan(1)

                        Scan(depth), _ if depth <= 0 or parser.peek_at(offset) == TokenKind.Eof:
                            break

                        Scan(depth), _ if parser.peek_at(offset) == TokenKind.LBracket:
                            offset <- offset + 1
                            -> Scan(depth + 1)

                        Scan(depth), _ if parser.peek_at(offset) == TokenKind.RBracket:
                            offset <- offset + 1
                            -> Scan(depth - 1)

                        Scan(depth), _:
                            offset <- offset + 1
                            -> Scan(depth)
                sview("", 0, 0) return if parser.peek_at(offset) != TokenKind.LParen
                offset <- offset + 1
                result: mutable sview = sview("", 0, 0)
                machine over result while true:
                    state Scan(offset: usize, saw_colon: bool)
                    start Scan(offset, false)

                    Scan(offset, _), _ if parser.peek_at(offset) == TokenKind.RParen or parser.peek_at(offset) == TokenKind.Eof:
                        break

                    Scan(offset, _), _ if parser.peek_at(offset) == TokenKind.Colon:
                        -> Scan(offset + 1, true)

                    Scan(offset, true), _ if parser.peek_at(offset) == TokenKind.Ident and result == "":
                        result <- Lexer::text_or_empty(parser.tokens[parser.position + offset], parser.source)
                        -> Scan(offset + 1, true)

                    Scan(offset, saw_colon), _:
                        -> Scan(offset + 1, saw_colon)
                return result



        # Capture a value law's `(name: TYPE, ...)` header as ParamDecls. The predicate law
        # IS a callable in stage0 — `law InRange(self: u32, lo: u32, hi: u32) = ...` exports
        # `_InRange` — but stage1 only ever SKIPPED this header, so no signature survived and
        # no function was emitted. Types are captured as bare name Idents, which is what a
        # law's scalar parameters are in practice.
        def capture_law_params(parser: lmut Parser, law_name: sview, out: mutable darray[Ast::ParamDecl]&) -> void:
            return if parser.peek() != TokenKind.LParen
            parser, _ <- parser.advance()                               # `(`
            # The machine must keep executing after a transition lands on `)` so the
            # `Skip -> Store` edge records the final parameter. The loop's boundary is
            # therefore an explicit terminal arm, not the machine guard: a guard is checked
            # before the next state runs and would otherwise stop before `Store`.
            machine over parser.position while true:
                state Scan
                state Colon(name_token: Token, param_name: sview)
                state Type(name_token: Token, param_name: sview)
                state Skip(name_token: Token, param_name: sview, type_name: sview)
                state Store(name_token: Token, param_name: sview, type_name: sview)
                state Separator
                start Scan

                Scan, _ if parser.peek() == TokenKind.RParen or parser.peek() == TokenKind.Eof:
                    break

                Scan, _ if parser.peek() != TokenKind.Ident:
                    parser.position <- parser.position + 1
                    -> Scan

                Scan, _:
                    parsed_name_token: Token = parser.cursor()
                    parser.position <- parser.position + 1
                    -> Colon(parsed_name_token, Lexer::text_or_empty(parsed_name_token, parser.source))

                Colon(name_token, param_name), _ if parser.peek() == TokenKind.Colon:
                    parser.position <- parser.position + 1
                    -> Type(name_token, param_name)

                Colon(name_token, param_name), _:
                    -> Skip(name_token, param_name, sview("", 0, 0))

                Type(name_token, param_name), _ if parser.peek() == TokenKind.Ident:
                    type_token: Token = parser.cursor()
                    parser.position <- parser.position + 1
                    -> Skip(name_token, param_name, Lexer::text_or_empty(type_token, parser.source))

                Type(name_token, param_name), _:
                    -> Skip(name_token, param_name, sview("", 0, 0))

                Skip(name_token, param_name, type_name), _ if parser.peek() == TokenKind.Comma or parser.peek() == TokenKind.RParen or parser.peek() == TokenKind.Eof:
                    -> Store(name_token, param_name, type_name)

                Skip(name_token, param_name, type_name), _:
                    parser.position <- parser.position + 1
                    -> Skip(name_token, param_name, type_name)

                Store(name_token, param_name, type_name), _ if param_name != "" and type_name != "":
                    parser <- parser.append_law_param(out, law_name, name_token, param_name, type_name)
                    -> Separator

                Store(_, _, _), _:
                    -> Separator

                Separator, _ if parser.peek() == TokenKind.Comma:
                    parser.position <- parser.position + 1
                    -> Scan

                Separator, _:
                    break
            parser, _ <- parser.accept(TokenKind.RParen)



        def append_law_param(parser: lmut Parser, out: mutable darray[Ast::ParamDecl]&, law_name: sview, name_token: Token, param_name: sview, type_name: sview) -> void:
            out.push(Ast::ParamDecl{name: param_name, type_expression: (Ast::Expr.Ident(type_name, Ast::pos_of_token(name_token))), is_mutable: false, has_default: false, default_value: (Ast::Expr.Absent)})
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: law_name, name: param_name, line: 3900000034})




        def skip_law_params(parser: lmut Parser) -> bool:
            false return if parser.peek() != TokenKind.LParen
            parser, _ <- parser.advance()                               # `(`
            machine over parser.position while true:
                state Scan(depth: int, saw_ref: bool)
                start Scan(1, false)

                Scan(depth, saw_ref), _ if depth <= 0 or parser.peek() == TokenKind.Eof:
                    return saw_ref

                Scan(depth, _), _ if parser.peek() == TokenKind.Ampersand:
                    parser.position <- parser.position + 1
                    -> Scan(depth, true)

                Scan(depth, saw_ref), _ if parser.peek() == TokenKind.LParen:
                    parser.position <- parser.position + 1
                    -> Scan(depth + 1, saw_ref)

                Scan(depth, saw_ref), _ if parser.peek() == TokenKind.RParen:
                    parser.position <- parser.position + 1
                    -> Scan(depth - 1, saw_ref)

                Scan(depth, saw_ref), _:
                    parser.position <- parser.position + 1
                    -> Scan(depth, saw_ref)
            return false
