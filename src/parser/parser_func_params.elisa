# Stage1 parser — a function's PARAMETER LIST (`extend Parser: private:`). Walks the balanced
# `(name: TYPE = DEFAULT where PRED, ...)` header one entry at a time, recording the ref-ness,
# arena-naming, tuple-type and variadic facts the later stages read off each ParamDecl.
# Continues parser_types_function.elisa.

extend Parser:
    private:

        def param_type_has_ref_ahead(parser: Parser&) -> bool:
            scan: mutable usize = 0
            machine over scan while true:
                state Scan(depth: int)
                start Scan(0)

                Scan(depth), _ if parser.peek_at(scan) == TokenKind.Eof or parser.peek_at(scan) == TokenKind.Newline or (depth == 0 and parser.peek_at(scan) == TokenKind.Comma):
                    break

                Scan(depth), _ if parser.peek_at(scan) == TokenKind.Ampersand or parser.peek_at(scan) == TokenKind.Lmut:
                    return true

                Scan(depth), _ if parser.peek_at(scan) == TokenKind.LParen or parser.peek_at(scan) == TokenKind.LBracket:
                    scan <- scan + 1
                    -> Scan(depth + 1)

                Scan(depth), _ if parser.peek_at(scan) == TokenKind.RParen or parser.peek_at(scan) == TokenKind.RBracket:
                    scan <- scan + 1
                    -> Scan(depth - 1)

                Scan(depth), _:
                    scan <- scan + 1
                    -> Scan(depth)
            return false



        def record_variadic_marker(parser: lmut Parser, function_line: u32) -> void:
            parser, _ <- parser.advance()
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__variadic", name: "__variadic", line: function_line})




        # Parse the balanced `(param, ...)` list into `param_items`, entered with the
        # cursor just past the opening `(`.
        def parse_param_list(parser: lmut Parser, param_items: mutable darray[Ast::ParamDecl]&, function_line: u32) -> bool:
            machine over parser.position while parser.peek() != TokenKind.RParen and parser.peek() != TokenKind.Eof:
                state Parse(keep_going: bool)
                start Parse(true)

                Parse(false), _:
                    break

                # A source-defined C-ABI variadic function uses the same `...` marker
                # as an extern (`def f(fixed: T, ...)`).  It is declaration metadata,
                # not a ParamDecl: the unnamed tail has no source type and is lowered
                # by LLVM as a real variadic function type.  Keep the marker in the
                # file side table because the compact Decl.Func payload is deliberately
                # stable and already has many consumers.
                Parse(true), _ if parser.peek() == TokenKind.Ellipsis:
                    break

                Parse(true), _:
                    rebind parsed_keep_going: bool, parser = parser.parse_one_param(param_items, function_line)
                    -> Parse(parsed_keep_going)
            variadic: bool = parser.peek() == TokenKind.Ellipsis
            parser <- parser.record_variadic_marker(function_line) if variadic
            parser, _ <- parser.expect(TokenKind.RParen)
            return variadic



        # Parse the contextual `where PRED` suffix used on type annotations. The
        # base expression is already parsed; retain the predicate structurally.
        def parse_refinement_suffix(parser: lmut Parser, base: Ast::Expr) -> Ast::Expr:
            where_token: Token = parser.cursor()
            has_where: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(where_token, parser.source) == "where"
            parser, _ <- parser.advance() if has_where
            rebind predicate_opt: Ast::Expr?, parser = parser.expression_if(has_where)
            if predicate_opt is predicate:
                return (Ast::Expr.Refinement(base, predicate, Ast::pos_of_token(where_token)))
            return base



        # A default-value expression is evaluated in a scope WITHOUT the function's own
        # parameters (`def f(x: i64, y: i64 = x)` — `x` is undefined there). The parser
        # discards the default expr, so record a `__default_param_ref` marker for every
        # bare-Ident reference to an already-seen parameter; the semantic layer turns each
        # into an `undefined identifier` diagnostic (unless the name also names a global).
        def record_default_param_ref_if(parser: lmut Parser, name: sview, param_items: darray[Ast::ParamDecl]&, function_line: u32) -> void:
            saved_position: usize = parser.position
            parser.position <- 0
            machine over parser.position while parser.position < param_items.count:
                state Scan
                start Scan

                Scan, _ if param_items[parser.position].name == name:
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__default_param_ref", name: name, line: function_line})
                    parser.position <- parser.position + 1
                    -> Scan

                Scan, _:
                    parser.position <- parser.position + 1
                    -> Scan
            parser.position <- saved_position



        def record_default_param_refs_ahead(parser: lmut Parser, param_items: darray[Ast::ParamDecl]&, function_line: u32) -> void:
            saved_position: usize = parser.position
            machine over parser.position while true:
                state Scan(scan: usize, depth: int)
                start Scan(0, 0)

                Scan(scan, depth), _ if saved_position + scan >= parser.tokens.count or parser.tokens[saved_position + scan].kind == TokenKind.Eof or parser.tokens[saved_position + scan].kind == TokenKind.Newline or (depth == 0 and (parser.tokens[saved_position + scan].kind == TokenKind.Comma or parser.tokens[saved_position + scan].kind == TokenKind.RParen)):
                    break

                Scan(scan, depth), _ if parser.tokens[saved_position + scan].kind == TokenKind.Ident and (scan == 0 or parser.tokens[saved_position + scan - 1].kind != TokenKind.Dot):
                    token: Token = parser.tokens[saved_position + scan]
                    parser <- parser.record_default_param_ref_if(Lexer::text_or_empty(token, parser.source), param_items, function_line)
                    parser.position <- saved_position + scan + 1
                    -> Scan(scan + 1, depth)

                Scan(scan, depth), _ if parser.tokens[saved_position + scan].kind == TokenKind.LParen or parser.tokens[saved_position + scan].kind == TokenKind.LBracket:
                    parser.position <- saved_position + scan + 1
                    -> Scan(scan + 1, depth + 1)

                Scan(scan, depth), _ if parser.tokens[saved_position + scan].kind == TokenKind.RParen or parser.tokens[saved_position + scan].kind == TokenKind.RBracket:
                    parser.position <- saved_position + scan + 1
                    -> Scan(scan + 1, depth - 1)

                Scan(scan, depth), _:
                    parser.position <- saved_position + scan + 1
                    -> Scan(scan + 1, depth)
            parser.position <- saved_position



        # Parse one `(param, ...)` entry, appending it to `param_items` when a full name
        # + type clause was captured. Returns whether the caller's comma-separated loop
        # should continue (a trailing comma was accepted).
        # Whether a local's declared type is an ARENA REFERENCE (`Arena&` / `mutable Arena&`).
        # Such a local owns a region in its own right, so `@name` may select it.
        def type_expression_names_arena(parser: Parser&, expression: Ast::Expr) -> bool:
            can Abort.Panic:
                match expression:
                    Ast::Expr.Unary(operator, operand, line):
                        return parser.type_expression_names_arena(operand)
                    Ast::Expr.Paren(inner, paren_line):
                        return parser.type_expression_names_arena(inner)
                    Ast::Expr.Ident(name, ident_line):
                        return name == "Arena"
                    _:
                        return false




        def record_tuple_type(parser: lmut Parser, expression: Ast::Expr) -> void:
            match expression:
                Expr.Tuple(elements, line):
                    parser.tuple_type_starts <- parser.tuple_type_starts.push(parser.tuple_type_elements.count)
                    parser.tuple_type_counts <- parser.tuple_type_counts.push(elements.count)
                    parser.tuple_type_lines <- parser.tuple_type_lines.push(line.line)
                    machine over parser.tuple_type_elements for element in elements:
                        state Scan
                        start Scan

                        Scan, _:
                            parser.tuple_type_elements <- parser.tuple_type_elements.push(element)
                            -> Scan
                _:
                    pass



        def parse_one_param(parser: lmut Parser, param_items: mutable darray[Ast::ParamDecl]&, function_line: u32) -> bool:
            # Legacy leading `mutable name:` form; the canonical `name: mutable T&` form
            # is captured by the type expression itself.
            rebind leading_mutable: bool, parser = parser.accept(TokenKind.Mutable)
            rebind param_name: Token, parser = parser.expect(TokenKind.Ident)
            parser, _ <- parser.expect(TokenKind.Colon)
            parser <- parser.reject_positional_tuple_type_ahead()
            is_lmut_param: bool = parser.peek() == TokenKind.Lmut
            is_ref_type_ahead: bool = parser.param_type_has_ref_ahead()
            parser.lmut_param_names <- parser.lmut_param_names.push(Lexer::text_or_empty(param_name, parser.source)) if is_lmut_param
            is_mutable_param: bool = leading_mutable or parser.peek() == TokenKind.Mutable or is_lmut_param
            parser.mutable_param_names <- parser.mutable_param_names.push(Lexer::text_or_empty(param_name, parser.source)) if is_mutable_param
            # Parameter annotations are type context too. In particular, a callback
            # parameter such as `body: fn(Slice[T]) -> R` must be parsed as a function-type
            # expression rather than as an ordinary `fn(...)` call/reference. Keep the
            # context scoped so defaults and subsequent signature clauses retain their
            # normal expression parsing rules.
            previous_type_context: bool = parser.in_type_annotation
            parser.in_type_annotation <- true
            # `fn(...) -> R` is ambiguous with a call to a value named `fn`. In a
            # declaration parameter's type slot the grammar is unambiguous, so dispatch
            # directly to the lambda/type parser; this also preserves each complete
            # callback parameter expression for backend ABI resolution.
            function_type_token: Token = parser.cursor()
            is_function_type_head: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(function_type_token, parser.source) == "fn"
            rebind parsed_type_expression: Ast::Expr?, parser = parser.expression()
            parser.in_type_annotation <- previous_type_context
            type_expression: mutable Ast::Expr? = parsed_type_expression
            if type_expression is param_type:
                rebind refined_type: Ast::Expr, parser = parser.parse_refinement_suffix(param_type)
                type_expression <- refined_type
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: Lexer::text_or_empty(param_name, parser.source), name: "__typestate_ref_param", line: function_line}) if is_ref_type_ahead

            # An AFFINE type marker `T!` on the parameter (`def g(b: P!)`). `!` is not a
            # binary operator, so `expression()` stops before it and the parameter loop then
            # found `!` where it expected `,` or `)` — the whole FILE failed to parse with
            # "expected a token, found '!'", while stage0 accepts it.
            #
            # A RETURN type `-> P!` already worked only INCIDENTALLY: parse_signature_clauses
            # skips trailing signature tokens on the way to the body `:` and swallows the
            # leftover `!`. The parameter list has no such skip, which is why the two
            # positions diverged.
            rebind consumed_affine_marker: bool, parser = parser.accept(TokenKind.Bang)

            # Function-type error set: `fn(...) -> T error[R]`. The function type is
            # represented by the existing expression shape; consume its error-set
            # selector so it remains part of this parameter rather than an orphan token.
            parser <- parser.record_parameter_error_union(param_name.line) if type_expression is param_type and not is_function_type_head
            if parser.peek() == TokenKind.Error:
                parser, _ <- parser.advance()
                rebind accepted_error_lbracket: bool, parser = parser.accept(TokenKind.LBracket)
                parser <- parser.skip_bracketed_group() if accepted_error_lbracket

            # Optional `@region` binding on the param type (`out: darray[u8]& @r`) pinning
            # the parameter to a region-polymorphic region declared in the `[@r]` generic
            # list. The region name is a selector, not a value ref; retain it in the
            # File side table for call-result lifetime inference.
            rebind accepted_at: bool, parser = parser.accept(TokenKind.At)
            region_name_token: Token = parser.cursor()
            rebind accepted_region_name: bool, parser = parser.accept(TokenKind.Ident)
            parser.local_region_annotations <- parser.local_region_annotations.push(Ast::LocalRegionAnnotation{name: Lexer::text_or_empty(param_name, parser.source), type_expression: get type_expression else (Ast::Expr.Invalid), region: Lexer::text_or_empty(region_name_token, parser.source), line: function_line}) if accepted_at and accepted_region_name and function_line > 0

            # Trailing function-type effect clause on the param type (`body: fn(usize) ->
            # i64 can[Abort.Panic]`): skip the balanced `can[...]` so it isn't mistaken
            # for the next parameter.
            can_clause_cursor: Token = parser.cursor()
            is_can_clause: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(can_clause_cursor, parser.source) == "can" and parser.peek_at(1) == TokenKind.LBracket
            has_param_effects: bool = is_can_clause or parser.captured_effects.count > 0
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__effect_param", name: Lexer::text_or_empty(param_name, parser.source), line: function_line}) if has_param_effects
            parser <- parser.skip_param_can_clause() if is_can_clause

            # Optional default value `param: T = <expression>`. Recorded on the
            # ParamDecl (pushed below, once the full param clause is known) so arity
            # checking can split required from defaultable parameters.
            rebind param_has_default: bool, parser = parser.accept(TokenKind.Assign)
            # KEEP the default expression, do not just note that one exists: a call site
            # omitting the argument needs the value to fill in.
            param_default_value: mutable Ast::Expr = (Ast::Expr.Invalid)
            if param_has_default:
                parser <- parser.record_default_param_refs_ahead(param_items, function_line)
                rebind default_expression: Ast::Expr?, parser = parser.expression()
                param_default_value <- parsed_default if default_expression is parsed_default

            if type_expression is param_type:
                param: Ast::ParamDecl = Ast::ParamDecl{name: Lexer::text_or_empty(param_name, parser.source), type_expression: param_type, is_mutable: leading_mutable, has_default: param_has_default, default_value: param_default_value, is_affine: consumed_affine_marker}
                parser <- parser.record_tuple_type(param_type)
                param_items.push(param)

            rebind accepted_comma: bool, parser = parser.accept(TokenKind.Comma)
            return accepted_comma



        # Skip a param's trailing `can[...]` effect clause, entered with the cursor on
        # the `can` identifier.
        def skip_param_can_clause(parser: lmut Parser) -> void:
            parser, _ <- parser.advance()               # `can`
            parser, _ <- parser.accept(TokenKind.LBracket)
            parser <- parser.skip_bracketed_group()



        # Capture the return-type expression and any trailing effect grant (`-> T
        # can[...]`, recovered from `parser.captured_effects` via skip_trailing_can
        # inside `expression()`) when `has_arrow` holds; a no-operator (returns `null`)
        # otherwise. `Ast::Expr?` can't be an out-param (`mutable Ast::Expr?&` doesn't
        # parse — the `?` closes the type before `&` can bind) and threading it plus
        # `parser` out of a two-real-branch ternary at the call site isn't reliable
        # (also true of `-> T` vs "no type" here), so the branch is folded into this
        # single call via a value-first exit guard instead.
        def advance_region_name(parser: lmut Parser, gate: bool) -> void:
            return if not gate
            parser, _ <- parser.advance()
