extend Parser:
    public:
        # docs/123 — `machine over INPUT [while COND] [-> YIELD]:` checked state-machine
        # loops. Port of stage0's parser desugar (compiler/src/parser/machine.go): a
        # machine lowers to a hoisted payload-less mode enum + scalarized payload locals
        # + `while COND` reading the input once per step and dispatching on the mode.
        #
        # Stage1 deltas from stage0 (frontend-only; the machine source is already
        # stage0-validated when it reaches this parser):
        #   - the mode dispatch lowers to an `if mode == Enum.State:` chain instead of a
        #     `match` (no dynamic "Enum.State" pattern-path strings need synthesizing);
        #   - refusal diagnostics are not re-emitted (stage0 owns them); the parse is
        #     structural;
        #   - synthesized names live in a parser-owned arena.

        struct MachinePayloadPat:
            bind: sview             # non-empty: plain-ident bind (aliases the field local)
            condition: Ast::Expr    # non-Invalid: literal (equality) or predicate (verbatim)
            is_wild: bool

        # A range alternative in a machine arm header (`Num, '0'..='9':`, docs/122 §5.2
        # shared pattern grammar). `lo`/`hi` are the bound expressions; `inclusive`
        # distinguishes `..=` from `..<`. Lowered to a `lo <= input and input <(=) hi`
        # bounds test, OR'd with any equality alternatives.
        struct MachineRange:
            lo: Ast::Expr
            hi: Ast::Expr
            inclusive: bool

        struct MachineArmAst:
            state_name: sview
            payloads: darray[MachinePayloadPat]
            input_literals: darray[Ast::Expr]
            input_ranges: darray[MachineRange]
            input_wild: bool
            input_bind: sview       # input BIND pattern name ("" if none)
            guard: Ast::Expr        # Invalid if none
            body: darray[Ast::Stmt]
            has_transition: bool
            target: sview
            target_line: u32
            target_offset: u32
            transition_args: darray[Ast::Expr]
            # Parser-owned names for temporaries that preserve transition argument
            # evaluation before scalarized destination fields are overwritten.
            transition_temp_names: darray[sview]
            line: u32

        struct MachineStateAst:
            name: sview
            field_names: darray[sview]
            field_types: darray[Ast::Expr]
            line: u32

        # Synthesized machine names are parser-owned, not selected from a finite table. The
        # arena is fully reserved before its first name is appended, so later names cannot
        # relocate sviews already embedded in the AST. Sixty-four bytes per source token is
        # a strict overestimate: every synthesized name has a corresponding source token,
        # including one temporary per transition argument, and every name is shorter than
        # 64 bytes.
        def append_machine_name_text(buffer: mutable darray[u8]&, text: sview) -> void:
            machine over buffer for index in 0..<sview_len(text):
                state Append
                start Append

                Append, _:
                    buffer.push(sview_at(text, index))
                    -> Append

        def append_machine_name_decimal(buffer: mutable darray[u8]&, value: usize) -> void:
            if value == 0:
                buffer.push(48)
                return
            digits: mutable darray[u8] = []
            remaining: mutable usize = value
            machine over digits while remaining > 0:
                state Collect
                start Collect

                Collect, _:
                    digits.push((48.usize() + (remaining % 10)).u8())
                    remaining <- remaining / 10
                    -> Collect
            machine over buffer for reverse_index in 0..<digits.count:
                state Append
                start Append

                Append, _:
                    buffer.push(digits[digits.count - 1.usize() - reverse_index])
                    -> Append

        def machine_generated_name[@r](parser: mutable Parser& @r, prefix: sview, index: usize) -> sview:
            parser.machine_name_storage.reserve(parser.tokens.count * 64) if parser.machine_name_storage.count == 0
            start: usize = parser.machine_name_storage.count
            append_machine_name_text(parser.machine_name_storage, prefix)
            append_machine_name_decimal(parser.machine_name_storage, index)
            count: usize = parser.machine_name_storage.count - start
            return sview(&parser.machine_name_storage[start], 0, count)

        def machine_transition_temp_names(parser: lmut Parser, arm: MachineArmAst) -> darray[sview]:
            names: mutable darray[sview] = []
            machine over names for argument_index in 0..<arm.transition_args.count:
                state Capture
                start Capture

                Capture, _:
                    names.push(parser.machine_generated_name("__machine_arg_", arm.target_offset + argument_index.u32()))
                    -> Capture
            return names

        def machine_over_ahead(parser: Parser&) -> bool:
            false return if parser.peek() != TokenKind.Ident
            false return if parser.position + 1 >= parser.tokens.count
            next_token: Token = parser.tokens[parser.position + 1]
            false return if next_token.kind != TokenKind.Ident
            return Lexer::text_or_empty(next_token, parser.source) == "over"

        # Stage0 licenses every named root occurring in the `over` expression and the
        # optional `while` condition. This is necessary for expressions such as
        # `ready and lexer.next()`: both `ready` and `lexer` are driven resources for the
        # value block.
        def machine_add_root(roots: mutable darray[sview]&, name: sview) -> void:
            return if name == ""
            for existing in roots:
                return if existing == name
            roots.push(name)

        # The driven-resource root of the `over` expression (`lexer.current_char()` ->
        # `lexer`). Keep this separate from general expression-root collection: the
        # loop header must capture the resource being advanced, not every identifier
        # mentioned by a classifier call.
        def machine_over_root(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Field(object, _, _):
                    return machine_over_root(object)
                Ast::Expr.Call(callee, arguments, _, _):
                    # A free-function call `f(resource.m())` drives the resource in
                    # its argument; a method call `resource.m()` drives the callee.
                    machine_over_root(arguments[0]) return if machine_expr_ident_name(callee) != "" and arguments.count > 0
                    return machine_over_root(callee)
                Ast::Expr.Index(object, _, _):
                    return machine_over_root(object)
                _:
                    return ""

        # Recovery and handler arms are statement-bearing expression children. They execute
        # conditionally, but their values and calls still belong to the enclosing machine's
        # driven-resource graph and must not disappear from the root walk.
        def machine_collect_statement_roots(statements: darray[Ast::Stmt], roots: mutable darray[sview]&) -> void:
            for statement in statements |roots|:
                match statement:
                    Ast::Stmt.VarDecl(name, type_expression, value, line):
                        machine_collect_roots(value, roots)
                    Ast::Stmt.Assign(target, operator, value, line):
                        machine_collect_roots(target, roots)
                        machine_collect_roots(value, roots)
                    Ast::Stmt.Expr(expression, line):
                        machine_collect_roots(expression, roots)
                    Ast::Stmt.Return(value, line):
                        if value is returned:
                            machine_collect_roots(returned, roots)
                    Ast::Stmt.If(condition, then_body, else_body, line):
                        machine_collect_roots(condition, roots)
                        machine_collect_statement_roots(then_body, roots)
                        machine_collect_statement_roots(else_body, roots)
                    Ast::Stmt.While(condition, body, line):
                        machine_collect_roots(condition, roots)
                        machine_collect_statement_roots(body, roots)
                    Ast::Stmt.For(bind, variables, iterable, body, line):
                        machine_collect_roots(iterable, roots)
                        machine_collect_statement_roots(body, roots)
                    Ast::Stmt.Block(kind, clause, binding, body, line):
                        machine_collect_statement_roots(body, roots)
                    Ast::Stmt.Match(scrutinee, arms, line):
                        machine_collect_roots(scrutinee, roots)
                        for arm in arms |roots|:
                            machine_collect_roots(arm.guard, roots)
                            machine_collect_statement_roots(arm.body, roots)
                    Ast::Stmt.Contract(_, expression, _):
                        machine_collect_roots(expression, roots)
                    _:
                        pass

        def machine_collect_roots(expression: Ast::Expr, roots: mutable darray[sview]&) -> void:
            match expression:
                Ast::Expr.Ident(name, _):
                    machine_add_root(roots, name)
                Ast::Expr.Field(object, _, _):
                    machine_collect_roots(object, roots)
                Ast::Expr.Scope(base, _, _):
                    machine_collect_roots(base, roots)
                Ast::Expr.Call(callee, arguments, _, _):
                    machine_collect_roots(callee, roots) if machine_expr_ident_name(callee) == ""
                    for argument in arguments |roots|:
                        machine_collect_roots(argument, roots)
                Ast::Expr.Index(object, index, _):
                    machine_collect_roots(object, roots)
                    machine_collect_roots(index, roots)
                Ast::Expr.Slice(object, low, high, _):
                    machine_collect_roots(object, roots)
                    machine_collect_roots(low, roots)
                    machine_collect_roots(high, roots)
                Ast::Expr.IndexN(object, arguments, _):
                    machine_collect_roots(object, roots)
                    for argument in arguments |roots|:
                        machine_collect_roots(argument, roots)
                Ast::Expr.Binary(left, _, right, _):
                    machine_collect_roots(left, roots)
                    machine_collect_roots(right, roots)
                Ast::Expr.Unary(_, operand, _):
                    machine_collect_roots(operand, roots)
                Ast::Expr.Move(operand, _):
                    machine_collect_roots(operand, roots)
                Ast::Expr.RegionNew(operand, _, _):
                    machine_collect_roots(operand, roots)
                Ast::Expr.Paren(inner, _):
                    machine_collect_roots(inner, roots)
                Ast::Expr.Refinement(base, predicate, _):
                    machine_collect_roots(base, roots)
                    machine_collect_roots(predicate, roots)
                Ast::Expr.GetElse(guarded, recovery, _):
                    machine_collect_roots(guarded, roots)
                    machine_collect_statement_roots(recovery, roots)
                Ast::Expr.Array(elements, _):
                    for element in elements |roots|:
                        machine_collect_roots(element, roots)
                Ast::Expr.Tuple(elements, _):
                    for element in elements |roots|:
                        machine_collect_roots(element, roots)
                Ast::Expr.SetLit(elements, _):
                    for element in elements |roots|:
                        machine_collect_roots(element, roots)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |roots|:
                        machine_collect_roots(entry.key, roots)
                        machine_collect_roots(entry.value, roots)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |roots|:
                        machine_collect_roots(field.value, roots)
                Ast::Expr.RecordUpdate(base, fields, _):
                    machine_collect_roots(base, roots)
                    for field in fields |roots|:
                        machine_collect_roots(field.value, roots)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    machine_collect_roots(condition, roots)
                    machine_collect_roots(then_expression, roots)
                    machine_collect_roots(else_expression, roots)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    machine_collect_roots(iterable, roots)
                    machine_collect_roots(condition, roots)
                    machine_collect_roots(body, roots)
                Ast::Expr.Lambda(_, body, _):
                    machine_collect_statement_roots(body, roots)
                Ast::Expr.Block(statements, value, _, _):
                    machine_collect_statement_roots(statements, roots)
                    machine_collect_roots(value, roots)
                Ast::Expr.Match(scrutinee, arms, _):
                    machine_collect_roots(scrutinee, roots)
                    for arm in arms |roots|:
                        machine_collect_roots(arm.guard, roots)
                        machine_collect_statement_roots(arm.body, roots)
                Ast::Expr.Catch(scrutinee, arms, _):
                    machine_collect_roots(scrutinee, roots)
                    for arm in arms |roots|:
                        machine_collect_roots(arm.guard, roots)
                        machine_collect_statement_roots(arm.body, roots)
                _:
                    pass

        def machine_collect_driven_statement_roots(statements: darray[Ast::Stmt], over_roots: darray[sview], mutated_roots: mutable darray[sview]&) -> void:
            for statement in statements |over_roots, mutated_roots|:
                match statement:
                    Ast::Stmt.VarDecl(name, type_expression, value, line):
                        machine_collect_driven_roots(value, over_roots, mutated_roots)
                    Ast::Stmt.Assign(target, operator, value, line):
                        machine_collect_driven_roots(target, over_roots, mutated_roots)
                        machine_collect_driven_roots(value, over_roots, mutated_roots)
                    Ast::Stmt.Expr(expression, line):
                        machine_collect_driven_roots(expression, over_roots, mutated_roots)
                    Ast::Stmt.Return(value, line):
                        if value is returned:
                            machine_collect_driven_roots(returned, over_roots, mutated_roots)
                    Ast::Stmt.If(condition, then_body, else_body, line):
                        machine_collect_driven_roots(condition, over_roots, mutated_roots)
                        machine_collect_driven_statement_roots(then_body, over_roots, mutated_roots)
                        machine_collect_driven_statement_roots(else_body, over_roots, mutated_roots)
                    Ast::Stmt.While(condition, body, line):
                        machine_collect_driven_roots(condition, over_roots, mutated_roots)
                        machine_collect_driven_statement_roots(body, over_roots, mutated_roots)
                    Ast::Stmt.For(bind, variables, iterable, body, line):
                        machine_collect_driven_roots(iterable, over_roots, mutated_roots)
                        machine_collect_driven_statement_roots(body, over_roots, mutated_roots)
                    Ast::Stmt.Block(kind, clause, binding, body, line):
                        machine_collect_driven_statement_roots(body, over_roots, mutated_roots)
                    Ast::Stmt.Match(scrutinee, arms, line):
                        machine_collect_driven_roots(scrutinee, over_roots, mutated_roots)
                        for arm in arms |over_roots, mutated_roots|:
                            machine_collect_driven_roots(arm.guard, over_roots, mutated_roots)
                            machine_collect_driven_statement_roots(arm.body, over_roots, mutated_roots)
                    Ast::Stmt.Contract(_, expression, _):
                        machine_collect_driven_roots(expression, over_roots, mutated_roots)
                    _:
                        pass

        # Calls can mutate a driven resource through a mutable reference even when the arm
        # contains no assignment node. Mirror stage0's conservative rule by collecting every
        # root in each call expression and retaining only roots already licensed by the machine
        # header. Statement-bearing expressions delegate to the matching statement walker so
        # calls in block, lambda, recovery, and handler bodies cannot evade capture analysis.
        def machine_collect_driven_roots(expression: Ast::Expr, over_roots: darray[sview], mutated_roots: mutable darray[sview]&) -> void:
            match expression:
                Ast::Expr.Ident(name, _):
                    machine_add_root(mutated_roots, name) if any driven_name in over_roots where driven_name == name
                Ast::Expr.Field(object, _, _):
                    machine_collect_driven_roots(object, over_roots, mutated_roots)
                Ast::Expr.Scope(base, _, _):
                    machine_collect_driven_roots(base, over_roots, mutated_roots)
                Ast::Expr.Call(callee, arguments, _, _):
                    machine_collect_driven_roots(callee, over_roots, mutated_roots) if machine_expr_ident_name(callee) == ""
                    for argument in arguments |over_roots, mutated_roots|:
                        machine_collect_driven_roots(argument, over_roots, mutated_roots)
                Ast::Expr.Index(object, index, _):
                    machine_collect_driven_roots(object, over_roots, mutated_roots)
                    machine_collect_driven_roots(index, over_roots, mutated_roots)
                Ast::Expr.Slice(object, low, high, _):
                    machine_collect_driven_roots(object, over_roots, mutated_roots)
                    machine_collect_driven_roots(low, over_roots, mutated_roots)
                    machine_collect_driven_roots(high, over_roots, mutated_roots)
                Ast::Expr.IndexN(object, arguments, _):
                    machine_collect_driven_roots(object, over_roots, mutated_roots)
                    for argument in arguments |over_roots, mutated_roots|:
                        machine_collect_driven_roots(argument, over_roots, mutated_roots)
                Ast::Expr.Binary(left, _, right, _):
                    machine_collect_driven_roots(left, over_roots, mutated_roots)
                    machine_collect_driven_roots(right, over_roots, mutated_roots)
                Ast::Expr.Unary(_, operand, _):
                    machine_collect_driven_roots(operand, over_roots, mutated_roots)
                Ast::Expr.Move(operand, _):
                    machine_collect_driven_roots(operand, over_roots, mutated_roots)
                Ast::Expr.RegionNew(operand, _, _):
                    machine_collect_driven_roots(operand, over_roots, mutated_roots)
                Ast::Expr.Paren(inner, _):
                    machine_collect_driven_roots(inner, over_roots, mutated_roots)
                Ast::Expr.Refinement(base, predicate, _):
                    machine_collect_driven_roots(base, over_roots, mutated_roots)
                    machine_collect_driven_roots(predicate, over_roots, mutated_roots)
                Ast::Expr.GetElse(guarded, recovery, _):
                    machine_collect_driven_roots(guarded, over_roots, mutated_roots)
                    machine_collect_driven_statement_roots(recovery, over_roots, mutated_roots)
                Ast::Expr.Array(elements, _):
                    for element in elements |over_roots, mutated_roots|:
                        machine_collect_driven_roots(element, over_roots, mutated_roots)
                Ast::Expr.Tuple(elements, _):
                    for element in elements |over_roots, mutated_roots|:
                        machine_collect_driven_roots(element, over_roots, mutated_roots)
                Ast::Expr.SetLit(elements, _):
                    for element in elements |over_roots, mutated_roots|:
                        machine_collect_driven_roots(element, over_roots, mutated_roots)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |over_roots, mutated_roots|:
                        machine_collect_driven_roots(entry.key, over_roots, mutated_roots)
                        machine_collect_driven_roots(entry.value, over_roots, mutated_roots)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |over_roots, mutated_roots|:
                        machine_collect_driven_roots(field.value, over_roots, mutated_roots)
                Ast::Expr.RecordUpdate(base, fields, _):
                    machine_collect_driven_roots(base, over_roots, mutated_roots)
                    for field in fields |over_roots, mutated_roots|:
                        machine_collect_driven_roots(field.value, over_roots, mutated_roots)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    machine_collect_driven_roots(condition, over_roots, mutated_roots)
                    machine_collect_driven_roots(then_expression, over_roots, mutated_roots)
                    machine_collect_driven_roots(else_expression, over_roots, mutated_roots)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    machine_collect_driven_roots(iterable, over_roots, mutated_roots)
                    machine_collect_driven_roots(condition, over_roots, mutated_roots)
                    machine_collect_driven_roots(body, over_roots, mutated_roots)
                Ast::Expr.Lambda(_, body, _):
                    machine_collect_driven_statement_roots(body, over_roots, mutated_roots)
                Ast::Expr.Block(statements, value, _, _):
                    machine_collect_driven_statement_roots(statements, over_roots, mutated_roots)
                    machine_collect_driven_roots(value, over_roots, mutated_roots)
                Ast::Expr.Match(scrutinee, arms, _):
                    machine_collect_driven_roots(scrutinee, over_roots, mutated_roots)
                    for arm in arms |over_roots, mutated_roots|:
                        machine_collect_driven_roots(arm.guard, over_roots, mutated_roots)
                        machine_collect_driven_statement_roots(arm.body, over_roots, mutated_roots)
                Ast::Expr.Catch(scrutinee, arms, _):
                    machine_collect_driven_roots(scrutinee, over_roots, mutated_roots)
                    for arm in arms |over_roots, mutated_roots|:
                        machine_collect_driven_roots(arm.guard, over_roots, mutated_roots)
                        machine_collect_driven_statement_roots(arm.body, over_roots, mutated_roots)
                _:
                    pass

        def machine_collect_call_statement_roots(statements: darray[Ast::Stmt], over_roots: darray[sview], mutated_roots: mutable darray[sview]&) -> void:
            for statement in statements |over_roots, mutated_roots|:
                match statement:
                    Ast::Stmt.VarDecl(name, type_expression, value, line):
                        machine_collect_call_roots(value, over_roots, mutated_roots)
                    Ast::Stmt.Assign(target, operator, value, line):
                        machine_collect_call_roots(target, over_roots, mutated_roots)
                        machine_collect_call_roots(value, over_roots, mutated_roots)
                    Ast::Stmt.Expr(expression, line):
                        machine_collect_call_roots(expression, over_roots, mutated_roots)
                    Ast::Stmt.Return(value, line):
                        if value is returned:
                            machine_collect_call_roots(returned, over_roots, mutated_roots)
                    Ast::Stmt.If(condition, then_body, else_body, line):
                        machine_collect_call_roots(condition, over_roots, mutated_roots)
                        machine_collect_call_statement_roots(then_body, over_roots, mutated_roots)
                        machine_collect_call_statement_roots(else_body, over_roots, mutated_roots)
                    Ast::Stmt.While(condition, body, line):
                        machine_collect_call_roots(condition, over_roots, mutated_roots)
                        machine_collect_call_statement_roots(body, over_roots, mutated_roots)
                    Ast::Stmt.For(bind, variables, iterable, body, line):
                        machine_collect_call_roots(iterable, over_roots, mutated_roots)
                        machine_collect_call_statement_roots(body, over_roots, mutated_roots)
                    Ast::Stmt.Block(kind, clause, binding, body, line):
                        machine_collect_call_statement_roots(body, over_roots, mutated_roots)
                    Ast::Stmt.Match(scrutinee, arms, line):
                        machine_collect_call_roots(scrutinee, over_roots, mutated_roots)
                        for arm in arms |over_roots, mutated_roots|:
                            machine_collect_call_roots(arm.guard, over_roots, mutated_roots)
                            machine_collect_call_statement_roots(arm.body, over_roots, mutated_roots)
                    Ast::Stmt.Contract(_, expression, _):
                        machine_collect_call_roots(expression, over_roots, mutated_roots)
                    _:
                        pass

        def machine_collect_call_roots(expression: Ast::Expr, over_roots: darray[sview], mutated_roots: mutable darray[sview]&) -> void:
            match expression:
                Ast::Expr.Call(_, _, _, _):
                    machine_collect_driven_roots(expression, over_roots, mutated_roots)
                Ast::Expr.Field(object, _, _):
                    machine_collect_call_roots(object, over_roots, mutated_roots)
                Ast::Expr.Scope(base, _, _):
                    machine_collect_call_roots(base, over_roots, mutated_roots)
                Ast::Expr.Index(object, index, _):
                    machine_collect_call_roots(object, over_roots, mutated_roots)
                    machine_collect_call_roots(index, over_roots, mutated_roots)
                Ast::Expr.Slice(object, low, high, _):
                    machine_collect_call_roots(object, over_roots, mutated_roots)
                    machine_collect_call_roots(low, over_roots, mutated_roots)
                    machine_collect_call_roots(high, over_roots, mutated_roots)
                Ast::Expr.IndexN(object, arguments, _):
                    machine_collect_call_roots(object, over_roots, mutated_roots)
                    for argument in arguments |over_roots, mutated_roots|:
                        machine_collect_call_roots(argument, over_roots, mutated_roots)
                Ast::Expr.Binary(left, _, right, _):
                    machine_collect_call_roots(left, over_roots, mutated_roots)
                    machine_collect_call_roots(right, over_roots, mutated_roots)
                Ast::Expr.Unary(_, operand, _):
                    machine_collect_call_roots(operand, over_roots, mutated_roots)
                Ast::Expr.Move(operand, _):
                    machine_collect_call_roots(operand, over_roots, mutated_roots)
                Ast::Expr.RegionNew(operand, _, _):
                    machine_collect_call_roots(operand, over_roots, mutated_roots)
                Ast::Expr.Paren(inner, _):
                    machine_collect_call_roots(inner, over_roots, mutated_roots)
                Ast::Expr.Refinement(base, predicate, _):
                    machine_collect_call_roots(base, over_roots, mutated_roots)
                    machine_collect_call_roots(predicate, over_roots, mutated_roots)
                Ast::Expr.GetElse(guarded, recovery, _):
                    machine_collect_call_roots(guarded, over_roots, mutated_roots)
                    machine_collect_call_statement_roots(recovery, over_roots, mutated_roots)
                Ast::Expr.Array(elements, _):
                    for element in elements |over_roots, mutated_roots|:
                        machine_collect_call_roots(element, over_roots, mutated_roots)
                Ast::Expr.Tuple(elements, _):
                    for element in elements |over_roots, mutated_roots|:
                        machine_collect_call_roots(element, over_roots, mutated_roots)
                Ast::Expr.SetLit(elements, _):
                    for element in elements |over_roots, mutated_roots|:
                        machine_collect_call_roots(element, over_roots, mutated_roots)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |over_roots, mutated_roots|:
                        machine_collect_call_roots(entry.key, over_roots, mutated_roots)
                        machine_collect_call_roots(entry.value, over_roots, mutated_roots)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |over_roots, mutated_roots|:
                        machine_collect_call_roots(field.value, over_roots, mutated_roots)
                Ast::Expr.RecordUpdate(base, fields, _):
                    machine_collect_call_roots(base, over_roots, mutated_roots)
                    for field in fields |over_roots, mutated_roots|:
                        machine_collect_call_roots(field.value, over_roots, mutated_roots)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    machine_collect_call_roots(condition, over_roots, mutated_roots)
                    machine_collect_call_roots(then_expression, over_roots, mutated_roots)
                    machine_collect_call_roots(else_expression, over_roots, mutated_roots)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    machine_collect_call_roots(iterable, over_roots, mutated_roots)
                    machine_collect_call_roots(condition, over_roots, mutated_roots)
                    machine_collect_call_roots(body, over_roots, mutated_roots)
                Ast::Expr.Lambda(_, body, _):
                    machine_collect_call_statement_roots(body, over_roots, mutated_roots)
                Ast::Expr.Block(statements, value, _, _):
                    machine_collect_call_statement_roots(statements, over_roots, mutated_roots)
                    machine_collect_call_roots(value, over_roots, mutated_roots)
                Ast::Expr.Match(scrutinee, arms, _):
                    machine_collect_call_roots(scrutinee, over_roots, mutated_roots)
                    for arm in arms |over_roots, mutated_roots|:
                        machine_collect_call_roots(arm.guard, over_roots, mutated_roots)
                        machine_collect_call_statement_roots(arm.body, over_roots, mutated_roots)
                Ast::Expr.Catch(scrutinee, arms, _):
                    machine_collect_call_roots(scrutinee, over_roots, mutated_roots)
                    for arm in arms |over_roots, mutated_roots|:
                        machine_collect_call_roots(arm.guard, over_roots, mutated_roots)
                        machine_collect_call_statement_roots(arm.body, over_roots, mutated_roots)
                _:
                    pass

        def machine_expr_is_literal(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.IntLit(_):
                    return true
                Ast::Expr.FloatLit(_):
                    return true
                Ast::Expr.CharLit(_):
                    return true
                Ast::Expr.StringLit(_):
                    return true
                Ast::Expr.BoolLit(_):
                    return true
                Ast::Expr.Unary(operator, operand, _):
                    return machine_expr_is_literal(operand)
                Ast::Expr.Paren(inner, _):
                    return machine_expr_is_literal(inner)
                _:
                    return false

        def machine_expr_ident_name(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                _:
                    return ""

        # Match stage0's payload-pattern classification: an expression that mentions
        # the state field is already a predicate over that field; every other expression
        # is an equality value, even when it is a computed literal such as `1 + 0`.
        def machine_expr_mentions_ident(expression: Ast::Expr, name: sview) -> bool:
            match expression:
                Ast::Expr.Ident(ident_name, _):
                    return ident_name == name
                Ast::Expr.Field(object, _, _):
                    return machine_expr_mentions_ident(object, name)
                Ast::Expr.Scope(base, _, _):
                    return machine_expr_mentions_ident(base, name)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if machine_expr_mentions_ident(callee, name)
                    return any argument in arguments where machine_expr_mentions_ident(argument, name)
                Ast::Expr.Index(object, index, _):
                    return machine_expr_mentions_ident(object, name) or machine_expr_mentions_ident(index, name)
                Ast::Expr.Slice(object, low, high, _):
                    return machine_expr_mentions_ident(object, name) or machine_expr_mentions_ident(low, name) or machine_expr_mentions_ident(high, name)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if machine_expr_mentions_ident(object, name)
                    return any argument in arguments where machine_expr_mentions_ident(argument, name)
                Ast::Expr.Binary(left, _, right, _):
                    return machine_expr_mentions_ident(left, name) or machine_expr_mentions_ident(right, name)
                Ast::Expr.Unary(_, operand, _):
                    return machine_expr_mentions_ident(operand, name)
                Ast::Expr.Move(operand, _):
                    return machine_expr_mentions_ident(operand, name)
                Ast::Expr.RegionNew(operand, _, _):
                    return machine_expr_mentions_ident(operand, name)
                Ast::Expr.Paren(inner, _):
                    return machine_expr_mentions_ident(inner, name)
                Ast::Expr.Refinement(base, predicate, _):
                    return machine_expr_mentions_ident(base, name) or machine_expr_mentions_ident(predicate, name)
                Ast::Expr.GetElse(guarded, recovery, _):
                    return true if machine_expr_mentions_ident(guarded, name)
                    return machine_statement_mentions_ident(recovery, name)
                Ast::Expr.Array(elements, _):
                    return any element in elements where machine_expr_mentions_ident(element, name)
                Ast::Expr.Tuple(elements, _):
                    return any element in elements where machine_expr_mentions_ident(element, name)
                Ast::Expr.SetLit(elements, _):
                    return any element in elements where machine_expr_mentions_ident(element, name)
                Ast::Expr.DictLit(entries, _):
                    return any entry in entries where machine_expr_mentions_ident(entry.key, name) or machine_expr_mentions_ident(entry.value, name)
                Ast::Expr.Construct(_, fields, _):
                    return any field in fields where machine_expr_mentions_ident(field.value, name)
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if machine_expr_mentions_ident(base, name)
                    return any field in fields where machine_expr_mentions_ident(field.value, name)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return machine_expr_mentions_ident(condition, name) or machine_expr_mentions_ident(then_expression, name) or machine_expr_mentions_ident(else_expression, name)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return machine_expr_mentions_ident(iterable, name) or machine_expr_mentions_ident(condition, name) or machine_expr_mentions_ident(body, name)
                Ast::Expr.Lambda(_, body, _):
                    return machine_statement_mentions_ident(body, name)
                Ast::Expr.Block(statements, value, _, _):
                    return true if machine_statement_mentions_ident(statements, name)
                    return machine_expr_mentions_ident(value, name)
                Ast::Expr.Match(scrutinee, arms, _):
                    return true if machine_expr_mentions_ident(scrutinee, name)
                    for arm in arms:
                        return true if machine_expr_mentions_ident(arm.guard, name)
                        return true if machine_statement_mentions_ident(arm.body, name)
                    return false
                Ast::Expr.Catch(scrutinee, arms, _):
                    return true if machine_expr_mentions_ident(scrutinee, name)
                    for arm in arms:
                        return true if machine_expr_mentions_ident(arm.guard, name)
                        return true if machine_statement_mentions_ident(arm.body, name)
                    return false
                _:
                    return false

        def machine_statement_mentions_ident(statements: darray[Ast::Stmt], name: sview) -> bool:
            for statement in statements:
                match statement:
                    Ast::Stmt.VarDecl(_, _, value, _):
                        return true if machine_expr_mentions_ident(value, name)
                    Ast::Stmt.Assign(target, _, value, _):
                        return true if machine_expr_mentions_ident(target, name) or machine_expr_mentions_ident(value, name)
                    Ast::Stmt.Expr(expression, _):
                        return true if machine_expr_mentions_ident(expression, name)
                    Ast::Stmt.Return(value, _):
                        if value is returned:
                            return true if machine_expr_mentions_ident(returned, name)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return true if machine_expr_mentions_ident(condition, name) or machine_statement_mentions_ident(then_body, name) or machine_statement_mentions_ident(else_body, name)
                    Ast::Stmt.While(condition, body, _):
                        return true if machine_expr_mentions_ident(condition, name) or machine_statement_mentions_ident(body, name)
                    Ast::Stmt.For(_, _, iterable, body, _):
                        return true if machine_expr_mentions_ident(iterable, name) or machine_statement_mentions_ident(body, name)
                    Ast::Stmt.Block(_, _, _, body, _):
                        return true if machine_statement_mentions_ident(body, name)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return true if machine_expr_mentions_ident(scrutinee, name)
                        for arm in arms:
                            return true if machine_expr_mentions_ident(arm.guard, name) or machine_statement_mentions_ident(arm.body, name)
                    Ast::Stmt.Contract(_, expression, _):
                        return machine_expr_mentions_ident(expression, name)
                    _:
                        pass
            return false

        def machine_expr_is_invalid(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Invalid:
                    return true
                Ast::Expr.Absent:
                    return true
                _:
                    return false

        # Parse the interior of a `(expr, expr, …)` argument list: the caller has already
        # consumed the `(` and expects the closing `)` afterward. An empty list (`()`) yields
        # no arguments. Shared by machine transition targets (`-> State(a, b)`) and the
        # `start State(a, b)` declaration.
        def parse_machine_call_arguments(parser: lmut Parser) -> darray[Ast::Expr]:
            arguments: mutable darray[Ast::Expr] = []
            machine over parser.position while parser.peek() != TokenKind.RParen and parser.peek() != TokenKind.Eof:
                state Parse
                state Separator
                start Parse

                Parse, _:
                    rebind arg_opt: Ast::Expr?, parser = parser.expression()
                    arguments.push(get arg_opt else (Ast::Expr.Invalid))
                    -> Separator

                Separator, _ if parser.peek() == TokenKind.Comma:
                    parser.position <- parser.position + 1
                    -> Parse

                Separator, _:
                    break
            return arguments

        def parse_machine_payload_pat(parser: lmut Parser) -> MachinePayloadPat:
            token: Token = parser.cursor()
            if token.kind == TokenKind.Ident and Lexer::text_or_empty(token, parser.source) == "_":
                parser, _ <- parser.advance()
                return MachinePayloadPat{bind: "", condition: (Ast::Expr.Absent), is_wild: true}
            rebind expression_opt: Ast::Expr?, parser = parser.expression()
            expression: Ast::Expr = get expression_opt else (Ast::Expr.Invalid)
            bind_name: sview = machine_expr_ident_name(expression)
            MachinePayloadPat{bind: bind_name, condition: (Ast::Expr.Absent), is_wild: false} return if bind_name != ""
            return MachinePayloadPat{bind: "", condition: expression, is_wild: false}
