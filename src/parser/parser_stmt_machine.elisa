        # `machine` is a contextual keyword: a machine statement only when the ident
        # `over` follows (no legal expression has two bare identifiers in sequence).
        def machine_over_ahead(parser: Parser&) -> bool:
            false return if parser.peek() != TokenKind.Ident
            false return if parser.position + 1 >= parser.tokens.count
            next_token: Token = parser.tokens[parser.position + 1]
            false return if next_token.kind != TokenKind.Ident
            return Lexer::text_or_empty(next_token, parser.source) == "over"

        # The driven-resource root of the `over` expression (`lexer.current_char()` ->
        # "lexer") — captured so the loop body's mutation of it is licensed (docs/120).
        def machine_over_root(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Field(object, _, _):
                    return machine_over_root(object)
                Ast::Expr.Call(callee, arguments, _, _):
                    # A free-function call `f(resource.m())` (a classifier) drives the RESOURCE in
                    # its argument, not f; a method call `resource.m()` drives the callee's root.
                    machine_over_root(arguments[0]) return if machine_expr_ident_name(callee) != "" and arguments.count > 0
                    return machine_over_root(callee)
                Ast::Expr.Index(object, _, _):
                    return machine_over_root(object)
                _:
                    return ""

        def machine_expr_is_literal(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.IntLit(_):
                    return true
                Ast::Expr.CharLit(_):
                    return true
                Ast::Expr.StringLit(_):
                    return true
                Ast::Expr.BoolLit(_):
                    return true
                _:
                    return false

        def machine_expr_ident_name(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                _:
                    return ""

        def machine_expr_is_invalid(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Invalid:
                    return true
                Ast::Expr.Absent:
                    return true
                _:
                    return false

        # Parse the interior of a `(expr, expr, …)` argument list: the caller has already
        # consumed the `(` and expects the closing `)` afterward. An empty list (`()`) yields
        # no arguments. Shared by machine transition targets (`-> State(a, b)`) and the
        # `start State(a, b)` declaration.
        def parse_machine_call_arguments(parser: lmut Parser) -> darray[Ast::Expr]:
            arguments: mutable darray[Ast::Expr] = []
            machine over parser.position while parser.peek() != TokenKind.RParen and parser.peek() != TokenKind.Eof:
                state Parse
                state Separator
                start Parse

                Parse, _:
                    rebind arg_opt: Ast::Expr?, parser = parser.expression()
                    arguments.push(get arg_opt else (Ast::Expr.Invalid))
                    -> Separator

                Separator, _ if parser.peek() == TokenKind.Comma:
                    parser.position <- parser.position + 1
                    -> Parse

                Separator, _:
                    break
            return arguments

        def parse_machine_payload_pat(parser: lmut Parser) -> MachinePayloadPat:
            token: Token = parser.cursor()
            if token.kind == TokenKind.Ident and Lexer::text_or_empty(token, parser.source) == "_":
                parser, _ <- parser.advance()
                return MachinePayloadPat{bind: "", condition: (Ast::Expr.Absent), is_wild: true}
            rebind expression_opt: Ast::Expr?, parser = parser.expression()
            expression: Ast::Expr = get expression_opt else (Ast::Expr.Invalid)
            bind_name: sview = machine_expr_ident_name(expression)
            MachinePayloadPat{bind: bind_name, condition: (Ast::Expr.Absent), is_wild: false} return if bind_name != ""
            return MachinePayloadPat{bind: "", condition: expression, is_wild: false}
