extend Parser:
    public:
        # docs/123 — `machine over INPUT [while COND] [-> YIELD]:` checked state-machine
        # loops. Port of stage0's parser desugar (compiler/src/parser/machine.go): a
        # machine lowers to a hoisted payload-less mode enum + scalarized payload locals
        # + `while COND` reading the input once per step and dispatching on the mode.
        #
        # Stage1 deltas from stage0 (frontend-only; the machine source is already
        # stage0-validated when it reaches this parser):
        #   - the mode dispatch lowers to an `if mode == Enum.State:` chain instead of a
        #     `match` (no dynamic "Enum.State" pattern-path strings need synthesizing);
        #   - refusal diagnostics are not re-emitted (stage0 owns them); the parse is
        #     structural;
        #   - synthesized names come from fixed per-file counter tables.

        struct MachinePayloadPat:
            bind: sview             # non-empty: plain-ident bind (aliases the field local)
            condition: Ast::Expr    # non-Invalid: literal (equality) or predicate (verbatim)
            is_wild: bool

        # A range alternative in a machine arm header (`Num, '0'..='9':`, docs/122 §5.2
        # shared pattern grammar). `lo`/`hi` are the bound expressions; `inclusive`
        # distinguishes `..=` from `..<`. Lowered to a `lo <= input and input <(=) hi`
        # bounds test, OR'd with any equality alternatives.
        struct MachineRange:
            lo: Ast::Expr
            hi: Ast::Expr
            inclusive: bool

        struct MachineArmAst:
            state_name: sview
            payloads: darray[MachinePayloadPat]
            input_literals: darray[Ast::Expr]
            input_ranges: darray[MachineRange]
            input_wild: bool
            input_bind: sview       # input BIND pattern name ("" if none)
            guard: Ast::Expr        # Invalid if none
            body: darray[Ast::Stmt]
            has_transition: bool
            target: sview
            target_line: u32
            transition_args: darray[Ast::Expr]
            line: u32

        struct MachineStateAst:
            name: sview
            field_names: darray[sview]
            line: u32

        # Fixed synthesized-name tables (per-file counter; the enum is file-scope so the
        # counter keeps names unique per file; mode/input locals are block-scoped).
        # Product self-host has 15+ machines in one unit — must not wrap at 8.
        def machine_enum_name(index: usize) -> sview:
            return when index:
                0 -> "__MachineMode_0"
                1 -> "__MachineMode_1"
                2 -> "__MachineMode_2"
                3 -> "__MachineMode_3"
                4 -> "__MachineMode_4"
                5 -> "__MachineMode_5"
                6 -> "__MachineMode_6"
                7 -> "__MachineMode_7"
                8 -> "__MachineMode_8"
                9 -> "__MachineMode_9"
                10 -> "__MachineMode_10"
                11 -> "__MachineMode_11"
                12 -> "__MachineMode_12"
                13 -> "__MachineMode_13"
                14 -> "__MachineMode_14"
                15 -> "__MachineMode_15"
                16 -> "__MachineMode_16"
                17 -> "__MachineMode_17"
                18 -> "__MachineMode_18"
                19 -> "__MachineMode_19"
                20 -> "__MachineMode_20"
                21 -> "__MachineMode_21"
                22 -> "__MachineMode_22"
                23 -> "__MachineMode_23"
                24 -> "__MachineMode_24"
                25 -> "__MachineMode_25"
                26 -> "__MachineMode_26"
                27 -> "__MachineMode_27"
                28 -> "__MachineMode_28"
                29 -> "__MachineMode_29"
                30 -> "__MachineMode_30"
                _ -> "__MachineMode_31"

        def machine_mode_var_name(index: usize) -> sview:
            return when index:
                0 -> "__machine_mode_0"
                1 -> "__machine_mode_1"
                2 -> "__machine_mode_2"
                3 -> "__machine_mode_3"
                4 -> "__machine_mode_4"
                5 -> "__machine_mode_5"
                6 -> "__machine_mode_6"
                7 -> "__machine_mode_7"
                8 -> "__machine_mode_8"
                9 -> "__machine_mode_9"
                10 -> "__machine_mode_10"
                11 -> "__machine_mode_11"
                12 -> "__machine_mode_12"
                13 -> "__machine_mode_13"
                14 -> "__machine_mode_14"
                15 -> "__machine_mode_15"
                16 -> "__machine_mode_16"
                17 -> "__machine_mode_17"
                18 -> "__machine_mode_18"
                19 -> "__machine_mode_19"
                20 -> "__machine_mode_20"
                21 -> "__machine_mode_21"
                22 -> "__machine_mode_22"
                23 -> "__machine_mode_23"
                24 -> "__machine_mode_24"
                25 -> "__machine_mode_25"
                26 -> "__machine_mode_26"
                27 -> "__machine_mode_27"
                28 -> "__machine_mode_28"
                29 -> "__machine_mode_29"
                30 -> "__machine_mode_30"
                _ -> "__machine_mode_31"

        def machine_input_var_name(index: usize) -> sview:
            return when index:
                0 -> "__machine_input_0"
                1 -> "__machine_input_1"
                2 -> "__machine_input_2"
                3 -> "__machine_input_3"
                4 -> "__machine_input_4"
                5 -> "__machine_input_5"
                6 -> "__machine_input_6"
                7 -> "__machine_input_7"
                8 -> "__machine_input_8"
                9 -> "__machine_input_9"
                10 -> "__machine_input_10"
                11 -> "__machine_input_11"
                12 -> "__machine_input_12"
                13 -> "__machine_input_13"
                14 -> "__machine_input_14"
                15 -> "__machine_input_15"
                16 -> "__machine_input_16"
                17 -> "__machine_input_17"
                18 -> "__machine_input_18"
                19 -> "__machine_input_19"
                20 -> "__machine_input_20"
                21 -> "__machine_input_21"
                22 -> "__machine_input_22"
                23 -> "__machine_input_23"
                24 -> "__machine_input_24"
                25 -> "__machine_input_25"
                26 -> "__machine_input_26"
                27 -> "__machine_input_27"
                28 -> "__machine_input_28"
                29 -> "__machine_input_29"
                30 -> "__machine_input_30"
                _ -> "__machine_input_31"

        # `machine` is a contextual keyword: a machine statement only when the ident
        # `over` follows (no legal expression has two bare identifiers in sequence).
        def machine_over_ahead(parser: Parser&) -> bool:
            false return if parser.peek() != TokenKind.Ident
            false return if parser.position + 1 >= parser.tokens.count
            next_token: Token = parser.tokens[parser.position + 1]
            false return if next_token.kind != TokenKind.Ident
            return Lexer::text_or_empty(next_token, parser.source) == "over"

        # The driven-resource root of the `over` expression (`lexer.current_char()` ->
        # "lexer") — captured so the loop body's mutation of it is licensed (docs/120).
        def machine_over_root(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Field(object, _, _):
                    return machine_over_root(object)
                Ast::Expr.Call(callee, arguments, _, _):
                    # A free-function call `f(resource.m())` (a classifier) drives the RESOURCE in
                    # its argument, not f; a method call `resource.m()` drives the callee's root.
                    machine_over_root(arguments[0]) return if machine_expr_ident_name(callee) != "" and arguments.count > 0
                    return machine_over_root(callee)
                Ast::Expr.Index(object, _, _):
                    return machine_over_root(object)
                _:
                    return ""

        def machine_expr_is_literal(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.IntLit(_):
                    return true
                Ast::Expr.CharLit(_):
                    return true
                Ast::Expr.StringLit(_):
                    return true
                Ast::Expr.BoolLit(_):
                    return true
                _:
                    return false

        def machine_expr_ident_name(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                _:
                    return ""

        def machine_expr_is_invalid(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Invalid:
                    return true
                Ast::Expr.Absent:
                    return true
                _:
                    return false

        # Parse the interior of a `(expr, expr, …)` argument list: the caller has already
        # consumed the `(` and expects the closing `)` afterward. An empty list (`()`) yields
        # no arguments. Shared by machine transition targets (`-> State(a, b)`) and the
        # `start State(a, b)` declaration.
        def parse_machine_call_arguments(parser: lmut Parser) -> darray[Ast::Expr]:
            arguments: mutable darray[Ast::Expr] = []
            if parser.peek() != TokenKind.RParen:
                while true |parser, arguments|:
                    rebind arg_opt: Ast::Expr?, parser = parser.expression()
                    arguments.push(get arg_opt else (Ast::Expr.Invalid))
                    rebind accepted_comma: bool, parser = parser.accept(TokenKind.Comma)
                    break if not accepted_comma
            return arguments

        def parse_machine_payload_pat(parser: lmut Parser) -> MachinePayloadPat:
            token: Token = parser.cursor()
            if token.kind == TokenKind.Ident and Lexer::text_or_empty(token, parser.source) == "_":
                parser, _ <- parser.advance()
                return MachinePayloadPat{bind: "", condition: (Ast::Expr.Absent), is_wild: true}
            rebind expression_opt: Ast::Expr?, parser = parser.expression()
            expression: Ast::Expr = get expression_opt else (Ast::Expr.Invalid)
            bind_name: sview = machine_expr_ident_name(expression)
            MachinePayloadPat{bind: bind_name, condition: (Ast::Expr.Absent), is_wild: false} return if bind_name != ""
            return MachinePayloadPat{bind: "", condition: expression, is_wild: false}
