extend Parser:
    public:
        # docs/123 — `machine over INPUT [while COND] [-> YIELD]:` checked state-machine
        # loops. Port of stage0's parser desugar (compiler/src/parser/machine.go): a
        # machine lowers to a hoisted payload-less mode enum + scalarized payload locals
        # + `while COND` reading the input once per step and dispatching on the mode.
        #
        # Stage1 keeps the machine's local structural and mutation laws in the self-hosted
        # parser as well; broader enclosing-root capture context is still stage0-owned.
        # Deltas from stage0 are frontend-only:
        #   - the mode dispatch lowers to an `if mode == Enum.State:` chain instead of a
        #     `match` (no dynamic "Enum.State" pattern-path strings need synthesizing);
        #   - machine-local refusal checks are mirrored, while enclosing-root capture
        #     diagnostics remain stage0-owned;
        #   - synthesized names live in a parser-owned arena.

        struct MachinePayloadPat:
            bind: sview             # non-empty: plain-ident bind (aliases the field local)
            condition: Ast::Expr    # non-Invalid: literal (equality) or predicate (verbatim)
            is_wild: bool



        # A range alternative in a machine arm header (`Num, '0'..='9':`, docs/122 §5.2
        # shared pattern grammar). `lo`/`hi` are the bound expressions; `inclusive`
        # distinguishes `..=` from `..<`. Lowered to a `lo <= input and input <(=) hi`
        # bounds test, OR'd with any equality alternatives.
        struct MachineRange:
            lo: Ast::Expr
            hi: Ast::Expr
            inclusive: bool



        struct MachineArmAst:
            state_name: sview
            payloads: darray[MachinePayloadPat]
            input_literals: darray[Ast::Expr]
            # The SOURCE spelling of each input literal, parallel to `input_literals`.
            # stage0's `repeats input %s` sentence reconstructs the literal from its
            # coverage key (`char:m` -> `'m'`), which is the source text in every spelling,
            # so recording the span while the tokens are in hand beats re-printing an Expr.
            input_literal_texts: darray[sview]
            input_ranges: darray[MachineRange]
            input_wild: bool
            input_bind: sview       # input BIND pattern name ("" if none)
            guard: Ast::Expr        # Invalid if none
            body: darray[Ast::Stmt]
            has_transition: bool
            target: sview
            target_line: u32
            target_offset: u32
            transition_args: darray[Ast::Expr]
            # Parser-owned names for temporaries that preserve transition argument
            # evaluation before scalarized destination fields are overwritten.
            transition_temp_names: darray[sview]
            # Whether the arm ends in `-> State`, `return` or `break`. stage0 reports the
            # missing decision from validateMachine, AFTER the whole block is parsed, so the
            # fact has to survive the arm parser rather than being refused inside it.
            has_decision: bool
            line: u32

        # Path summary for a machine arm statement sequence. `falls_through` tracks the
        # paths that may continue into a shared suffix arrow after a partial branch.
        struct MachineArmFlow:
            valid: bool
            falls_through: bool
            falls_through_has_var_decl: bool



        struct MachineStateAst:
            name: sview
            field_names: darray[sview]
            field_types: darray[Ast::Expr]
            line: u32



        # Synthesized names are built in a local buffer and copied into a NameStore pool,
        # whose views live as long as the AST.
        def append_machine_name_text(buffer: mutable darray[u8]&, text: sview) -> void:
            machine over buffer for index in 0..<sview_len(text):
                state Append
                start Append

                Append, _:
                    buffer.push(sview_at(text, index))
                    -> Append



        # Copies `buffer[start..]` into the permanent region, drops those bytes from the
        # scratch buffer and returns a view of the copy. Names are short and few per
        # declaration, so the deliberate leak is bounded.
        def persist_name_bytes(buffer: mutable darray[u8]&, start: usize) -> sview can[Abort.Panic, Memory.Allocate]:
            return sview("", 0, 0) if start >= buffer.count
            count: usize = buffer.count - start
            stable: mutable heap void& = alloc_perm(count.i64()) can Global{Read,Write}
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.RawExtern:
                trusted [Unsafe.PointerCast, Unsafe.RawExtern]:
                    _ = memcpy(stable, (&buffer[start]).cast[void&], count)
                    buffer.truncate(start)
                    stable_bytes: heap u8& = stable.cast[heap u8&] can Unsafe.PointerCast
                    return unsafe_sview_bounded_bytes(stable_bytes, count)



        def append_machine_name_decimal(buffer: mutable darray[u8]&, value: usize) -> void:
            if value == 0:
                buffer.push(48)
                return
            digits: mutable darray[u8] = []
            remaining: mutable usize = value
            machine over digits while remaining > 0:
                state Collect
                start Collect

                Collect, _:
                    digits.push((48.usize() + (remaining % 10)).u8())
                    remaining <- remaining / 10
                    -> Collect
            machine over buffer for reverse_index in 0..<digits.count:
                state Append
                start Append

                Append, _:
                    buffer.push(digits[digits.count - 1.usize() - reverse_index])
                    -> Append



        # Fresh-buffer size for the parser's name pools (NameStore): sixty-four bytes per
        # source token is a generous per-generation budget; a longer name gets its own buffer.
        def name_store_chunk(parser: Parser&) -> usize:
            return parser.tokens.count * 64 + 4096

        # Parser-only branch-transition labels start with punctuation that cannot occur
        # in a source identifier, so they cannot alias a user's `break label` statement.
        def machine_transition_marker[@r](parser: mutable Parser& @r, target: sview) -> sview:
            bytes: mutable darray[u8] = [35, 45, 62]
            for index in 0..<sview_len(target) |bytes|:
                bytes.push(sview_at(target, index))
            return NameStore::append(&parser.machine_name_store, bytes, parser.name_store_chunk())

        def machine_transition_marker_matches(marker: sview, target: sview) -> bool:
            false return if sview_len(marker) != sview_len(target) + 3
            false return if sview_at(marker, 0) != 35 or sview_at(marker, 1) != 45 or sview_at(marker, 2) != 62
            for index in 0..<sview_len(target):
                return false if sview_at(marker, index + 3) != sview_at(target, index)
            return true

        def machine_transition_marker_prefix(marker: sview) -> bool:
            sview_len(marker) >= 3 and sview_at(marker, 0) == 35 and sview_at(marker, 1) == 45 and sview_at(marker, 2) == 62

        def machine_generated_name[@r](parser: mutable Parser& @r, prefix: sview, index: usize) -> sview:
            bytes: mutable darray[u8] = []
            append_machine_name_text(bytes, prefix)
            append_machine_name_decimal(bytes, index)
            return NameStore::append(&parser.machine_name_store, bytes, parser.name_store_chunk())

        # Three generated names in ONE call, space-separated; read each back with
        # machine_name_part.
        def machine_generated_names3[@r](parser: mutable Parser& @r, first: sview, second: sview, third: sview, index: usize) -> sview:
            bytes: mutable darray[u8] = []
            append_machine_name_text(bytes, first)
            append_machine_name_decimal(bytes, index)
            append_machine_name_text(bytes, " ")
            append_machine_name_text(bytes, second)
            append_machine_name_decimal(bytes, index)
            append_machine_name_text(bytes, " ")
            append_machine_name_text(bytes, third)
            append_machine_name_decimal(bytes, index)
            return NameStore::append(&parser.machine_name_store, bytes, parser.name_store_chunk())

        # The PART-th (0-based) space-separated name of a machine_generated_names3 result.
        def machine_name_part(combined: sview, part: usize) -> sview:
            length: usize = sview_len(combined)
            seen: mutable usize = 0
            begin: mutable usize = 0
            for position in 0..<length |seen, begin, combined, part|:
                if combined[position] == ' ':
                    return string_view_slice(combined, i64(begin), i64(position)) if seen == part
                    seen <- seen + 1
                    begin <- position + 1
            return string_view_slice(combined, i64(begin), i64(length))

        # `__rb_N_i`: a multi-target rebind's temp for slot `i` (stage0's freshRebindName).
        def rebind_temp_name[@r](parser: mutable Parser& @r, counter: usize, slot: usize) -> sview:
            bytes: mutable darray[u8] = []
            append_machine_name_text(bytes, "__rb_")
            append_machine_name_decimal(bytes, counter)
            append_machine_name_text(bytes, "_")
            append_machine_name_decimal(bytes, slot)
            return NameStore::append(&parser.machine_name_store, bytes, parser.name_store_chunk())



        def machine_transition_temp_names(parser: lmut Parser, arm: MachineArmAst) -> darray[sview]:
            names: mutable darray[sview] = []
            machine over names for argument_index in 0..<arm.transition_args.count:
                state Capture
                start Capture

                Capture, _:
                    names.push(parser.machine_generated_name("__machine_arg_", arm.target_offset + argument_index.u32()))
                    -> Capture
            return names



        # Parse the interior of a `(expr, expr, …)` argument list: the caller has already
        # consumed the `(` and expects the closing `)` afterward. An empty list (`()`) yields
        # no arguments. Shared by machine transition targets (`-> State(a, b)`) and the
        # `start State(a, b)` declaration.
        def parse_machine_call_arguments(parser: lmut Parser) -> darray[Ast::Expr]:
            arguments: mutable darray[Ast::Expr] = []
            machine over parser.position while parser.peek() != TokenKind.RParen and parser.peek() != TokenKind.Eof:
                state Parse
                state Separator
                start Parse

                Parse, _:
                    rebind arg_opt: Ast::Expr?, parser = parser.expression() can Global{Read,Write}
                    arguments.push(get arg_opt else (Ast::Expr.Invalid))
                    -> Separator

                Separator, _ if parser.peek() == TokenKind.Comma:
                    parser.position <- parser.position + 1
                    -> Parse

                Separator, _:
                    break
            return arguments



        def parse_machine_payload_pat(parser: lmut Parser) -> MachinePayloadPat:
            token: Token = parser.cursor()
            if token.kind == TokenKind.Ident and Lexer::text_or_empty(token, parser.source) == "_":
                parser, _ <- parser.advance()
                return MachinePayloadPat{bind: "", condition: (Ast::Expr.Absent), is_wild: true}
            rebind expression_opt: Ast::Expr?, parser = parser.expression() can Global{Read,Write}
            expression: Ast::Expr = get expression_opt else (Ast::Expr.Invalid)
            bind_name: sview = machine_expr_ident_name(expression)
            MachinePayloadPat{bind: bind_name, condition: (Ast::Expr.Absent), is_wild: false} return if bind_name != ""
            return MachinePayloadPat{bind: "", condition: expression, is_wild: false}

include "./parser_machine_roots.elisa"
include "./parser_machine_driven_roots.elisa"
include "./parser_machine_expr_probes.elisa"
