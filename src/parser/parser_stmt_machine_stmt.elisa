# Stage1 parser — the `machine` statement itself (`extend Parser: public:`): parse the
# state declarations and arms, validate them, and lower the whole construct to a loop
# over the generated mode enum. Continues parser_stmt_machine_arms.elisa; split out to
# keep each part file under 600 lines.

extend Parser:
    public:
        # Machine arms are intentionally straight-line. Keep the state-machine scans at
        # the boundary, and put the small decisions needed by their payload-building
        # helpers behind guards or ordinary helper calls. This is the shape required by
        # docs/123 §5; putting a nested machine or an `if` directly in an arm is rejected
        # by the language, rather than being a compiler limitation.
        def machine_state_field_seen(seen_fields: darray[sview]&, field_name: sview) -> bool:
            for seen in seen_fields:
                return true if seen == field_name
            return false

        def append_machine_state_declarations(declarations: mutable darray[Ast::Stmt]&, seen_fields: mutable darray[sview]&, state: MachineStateAst, start_args: darray[Ast::Expr], resolved_start: sview, line: u32) -> void:
            machine over declarations for field_index in 0..<state.field_names.count:
                state Field
                start Field

                Field, _ if machine_state_field_seen(seen_fields, state.field_names[field_index]):
                    -> Field

                Field, _ if state.name == resolved_start and field_index < start_args.count:
                    field_name: sview = state.field_names[field_index]
                    initializer: Ast::Expr = start_args[field_index]
                    seen_fields.push(field_name)
                    declarations.push((Ast::Stmt.VarDecl(field_name, state.field_types[field_index], initializer, Ast::pos_at_line(state.line))))
                    -> Field

                Field, _:
                    field_name: sview = state.field_names[field_index]
                    initializer: Ast::Expr = (Ast::Expr.Ident("zeroed", Ast::pos_at_line(line)))
                    seen_fields.push(field_name)
                    declarations.push((Ast::Stmt.VarDecl(field_name, state.field_types[field_index], initializer, Ast::pos_at_line(state.line))))
                    -> Field

        def append_machine_state_block(state: MachineStateAst, states: darray[MachineStateAst], arms: darray[MachineArmAst], enum_name: sview, mode_var: sview, input_var: sview, line: u32) -> darray[Ast::Stmt]:
            state_arm_indices: mutable darray[usize] = []
            for arm_i in 0..<arms.count:
                state_arm_indices.push(arm_i) if arms[arm_i].state_name == state.name
            block: mutable darray[Ast::Stmt] = []
            if state_arm_indices.count > 0:
                for state_arm_index in state_arm_indices:
                    append_machine_transition_temp_declarations(block, arms[state_arm_index], states) if machine_arm_shadows_transition_target(arms[state_arm_index], state.field_names, states)
                last_index: usize = state_arm_indices.count - 1
                last_arm: MachineArmAst = arms[state_arm_indices[last_index]]
                chain: mutable darray[Ast::Stmt] = lower_machine_arm_body(last_arm, states, state.field_names, enum_name, mode_var, input_var, line)
                last_condition: Ast::Expr = machine_arm_condition(last_arm, state.field_names, input_var)
                if not machine_expr_is_invalid(last_condition):
                    fallback: darray[Ast::Stmt] = [(Ast::Stmt.Break("", Ast::pos_at_line(last_arm.line)))]
                    chain <- [(Ast::Stmt.If(last_condition, chain, fallback, Ast::pos_at_line(last_arm.line)))]
                machine over chain while true:
                    state Fold(remaining: usize)
                    start Fold(last_index)

                    Fold(remaining), _ if remaining == 0:
                        break

                    Fold(remaining), _:
                        arm_index: usize = state_arm_indices[remaining - 1]
                        arm_condition: Ast::Expr = machine_arm_condition(arms[arm_index], state.field_names, input_var)
                        arm_body: darray[Ast::Stmt] = lower_machine_arm_body(arms[arm_index], states, state.field_names, enum_name, mode_var, input_var, line)
                        chain <- arm_body if machine_expr_is_invalid(arm_condition) else [(Ast::Stmt.If(arm_condition, arm_body, chain, Ast::pos_at_line(arms[arm_index].line)))]
                        -> Fold(remaining - 1)
                block.extend(chain)
            return block

        def machine_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind machine_token: Token, parser = parser.advance()   # `machine`
            parser, _ <- parser.advance()                            # `over`
            line: u32 = machine_token.line

            # Header expressions stop at a top-level `->` (the yield introducer) — the
            # binary parser would otherwise take it as the function-type arrow.
            saved_suppress_arrow: bool = parser.suppress_arrow
            parser.suppress_arrow <- true
            rebind input_opt: Ast::Expr?, parser = parser.expression()
            input_expression: Ast::Expr = get input_opt else (Ast::Expr.Invalid)
            for_bind: mutable sview = ""
            has_for_driver: mutable bool = false
            for_variables: mutable darray[sview] = []
            for_iterable: mutable Ast::Expr = (Ast::Expr.Invalid)
            header_token: Token = parser.cursor()
            if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(header_token, parser.source) == "for":
                parser, _ <- parser.advance()
                has_for_driver <- true
                rebind accepted_for_mutable: bool, parser = parser.accept(TokenKind.Mutable)
                for_bind <- "mutable" if accepted_for_mutable else ""
                rebind for_variable: Token, parser = parser.expect(TokenKind.Ident)
                for_variables.push(Lexer::text_or_empty(for_variable, parser.source))
                while parser.accept(TokenKind.Comma) |parser, for_variables|:
                    rebind next_for_variable: Token, parser = parser.expect(TokenKind.Ident)
                    for_variables.push(Lexer::text_or_empty(next_for_variable, parser.source))
                parser, _ <- parser.expect(TokenKind.In)
                rebind for_iterable_opt: Ast::Expr?, parser = parser.expression()
                for_iterable <- get for_iterable_opt else (Ast::Expr.Invalid)
            condition: mutable Ast::Expr = (Ast::Expr.BoolLit(true))
            if parser.peek() == TokenKind.While:
                parser, _ <- parser.advance()
                rebind condition_opt: Ast::Expr?, parser = parser.expression()
                condition_value: Ast::Expr = get condition_opt else (Ast::Expr.Invalid)
                condition <- condition_value
            parser.suppress_arrow <- saved_suppress_arrow
            yield_expression: mutable Ast::Expr = (Ast::Expr.Invalid)
            rebind accepted_arrow: bool, parser = parser.accept(TokenKind.Arrow)
            if accepted_arrow:
                rebind yield_opt: Ast::Expr?, parser = parser.expression()
                yield_value: Ast::Expr = get yield_opt else (Ast::Expr.Invalid)
                yield_expression <- yield_value

            parser, _ <- parser.expect(TokenKind.Colon)
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)

            states: mutable darray[MachineStateAst] = []
            start_state: mutable sview = ""
            start_args: mutable darray[Ast::Expr] = []
            arms: mutable darray[MachineArmAst] = []
            while true |parser, states, start_state, start_args, arms|:
                parser <- parser.skip_newlines()
                break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof
                head_token: Token = parser.cursor()
                if head_token.kind != TokenKind.Ident:
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, head_token)
                    parser, _ <- parser.advance()
                    continue
                head: sview = Lexer::text_or_empty(head_token, parser.source)
                match head:
                    "state":
                        rebind state_decls: darray[MachineStateAst], parser = parser.parse_machine_state_decls()
                        states.extend(state_decls)
                    "start":
                        parser, _ <- parser.advance()
                        rebind start_token: Token, parser = parser.expect(TokenKind.Ident)
                        start_state <- Lexer::text_or_empty(start_token, parser.source)
                        rebind accepted_paren: bool, parser = parser.accept(TokenKind.LParen)
                        if accepted_paren:
                            rebind parsed_start_args: darray[Ast::Expr], parser = parser.parse_machine_call_arguments()
                            start_args <- parsed_start_args
                            parser, _ <- parser.expect(TokenKind.RParen)
                        parser, _ <- parser.accept(TokenKind.Newline)
                    _:
                        rebind parsed_arm: MachineArmAst, parser = parser.parse_machine_arm()
                        rebind transition_names: darray[sview], parser = parser.machine_transition_temp_names(parsed_arm)
                        arm: MachineArmAst = MachineArmAst{
                            state_name: parsed_arm.state_name,
                            payloads: parsed_arm.payloads,
                            input_literals: parsed_arm.input_literals,
                            input_ranges: parsed_arm.input_ranges,
                            input_wild: parsed_arm.input_wild,
                            input_bind: parsed_arm.input_bind,
                            guard: parsed_arm.guard,
                            body: parsed_arm.body,
                            has_transition: parsed_arm.has_transition,
                            target: parsed_arm.target,
                            target_line: parsed_arm.target_line,
                            target_offset: parsed_arm.target_offset,
                            transition_args: parsed_arm.transition_args,
                            transition_temp_names: transition_names,
                            line: parsed_arm.line
                        }
                        arms.push(arm)
            parser, _ <- parser.expect(TokenKind.Dedent)

            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, machine_token) if states.count == 0
            (Ast::Stmt.Expr((Ast::Expr.Invalid), Ast::pos_at_line(line))) return if states.count == 0

            # docs/123 §5 per-state coverage refusals (stage1-owned; see check_machine_coverage).
            parser <- parser.check_machine_coverage(states, arms, machine_token)
            over_roots: mutable darray[sview] = []
            mutated_roots: mutable darray[sview] = []
            parser.machine_collect_roots(input_expression, over_roots)
            parser.machine_collect_roots(condition, over_roots)
            parser <- parser.validate_machine_transitions(states, arms, start_state, start_args, over_roots, mutated_roots, machine_token)

            # docs/125 §9 Tier-2: record per-state {classifier, tags, wildcard} rows for the
            # semantic closed-enum totality check (the parser can't see the classifier's type).
            parser <- parser.record_machine_coverage(arms, input_expression, line)

            machine_index: usize = parser.machine_count
            parser.machine_count <- parser.machine_count + 1
            enum_name: sview = parser.machine_generated_name("__MachineMode_", machine_index)
            mode_var: sview = parser.machine_generated_name("__machine_mode_", machine_index)
            input_var: sview = parser.machine_generated_name("__machine_input_", machine_index)

            # Hoisted payload-less mode enum (drained into top_decls by parse_file).
            variants: mutable darray[Ast::EnumVariant] = []
            variants.extend([Ast::EnumVariant{name: state.name, fields: [], field_names: [], value_expr: (Ast::Expr.Absent)} for state in states])
            # Plain, payload-less mode enum. The state tag is a normal enum value, while
            # payload fields remain scalarized locals. This keeps the synthesized enum in
            # the ordinary enum registry without routing machine metadata through the
            # heavier const-enum scalar path.
            parser.pending_decls <- parser.pending_decls.push((Ast::Decl.Enum(enum_name, variants, false, (Ast::Expr.Absent), Ast::pos_at_line(line))))
            # The Decl alone is not enough: the backend registers enums from the FILE
            # METADATA pools (register_enums_from_metadata reads enum_decl_names, never the
            # Decl), so without these rows `__MachineMode_N.State` resolves Unmodeled and the
            # untyped mode-var declaration declines — dropping every function with a machine.
            # Written out rather than routed through record_enum_metadata, whose payload-vs-not
            # branch reads captured_enum_variant_field_counts left over from the last real enum.
            parser.enum_decl_names <- parser.enum_decl_names.push(enum_name)
            parser.enum_decl_storage_heads <- parser.enum_decl_storage_heads.push("")
            parser.enum_decl_is_const <- parser.enum_decl_is_const.push(false)
            parser.enum_decl_variant_starts <- parser.enum_decl_variant_starts.push(parser.enum_decl_variant_names.count)
            parser.enum_decl_variant_counts <- parser.enum_decl_variant_counts.push(variants.count)
            # A machine's synthesized mode enum has no explicit values: ordinal IS the value.
            machine over parser.enum_decl_variant_names for machine_variant in variants:
                state Scan(machine_mode_value: i64)
                start Scan(0)

                Scan(machine_mode_value), _:
                    parser.enum_decl_variant_names <- parser.enum_decl_variant_names.push(machine_variant.name)
                    parser.enum_decl_variant_values <- parser.enum_decl_variant_values.push(machine_mode_value)
                    -> Scan(machine_mode_value + 1)

            # Header decls: mode var + one scalar local per unique payload field name
            # (loop-header style: untyped, initializer-seeded; docs/119 accumulators).
            declarations: mutable darray[Ast::Stmt] = []
            resolved_start: mutable sview = start_state
            resolved_start <- states[0].name if resolved_start == ""
            declarations.push((Ast::Stmt.VarDecl(mode_var, (Ast::Expr.Invalid), (Ast::Expr.Field((Ast::Expr.Ident(enum_name, Ast::pos_at_line(line))), resolved_start, Ast::pos_at_line(line))), Ast::pos_at_line(line))))
            seen_fields: mutable darray[sview] = []
            machine over declarations for state in states:
                state Scan
                start Scan

                Scan, _:
                    append_machine_state_declarations(declarations, seen_fields, state, start_args, resolved_start, line)
                    -> Scan

            # Per-state dispatch: guarded if-ladder. The final arm is only an
            # `else` when it is genuinely irrefutable; a tagged or payload-conditional
            # final arm must retain its condition so it cannot execute the wrong transition.
            state_blocks: mutable darray[darray[Ast::Stmt]] = []
            machine over state_blocks for state in states:
                state Build
                start Build

                Build, _:
                    state_block: darray[Ast::Stmt] = append_machine_state_block(state, states, arms, enum_name, mode_var, input_var, line)
                    state_blocks.push(state_block)
                    -> Build

            # Mode dispatch chain: `if mode == Enum.S0: … else: if mode == Enum.S1: …`,
            # last state as the final else.
            dispatch: mutable darray[Ast::Stmt] = state_blocks[state_blocks.count - 1]
            machine over dispatch while true:
                state Fold(state_index: usize)
                start Fold(states.count - 1)

                Fold(state_index), _ if state_index == 0:
                    break

                Fold(state_index), _:
                    previous: usize = state_index - 1
                    compare: Ast::Expr = (Ast::Expr.Binary((Ast::Expr.Ident(mode_var, Ast::pos_at_line(states[previous].line))), TokenKind.EqEq, (Ast::Expr.Field((Ast::Expr.Ident(enum_name, Ast::pos_at_line(states[previous].line))), states[previous].name, Ast::pos_at_line(states[previous].line))), Ast::pos_at_line(states[previous].line)))
                    dispatch <- [(Ast::Stmt.If(compare, state_blocks[previous], dispatch, Ast::pos_at_line(states[previous].line)))]
                    -> Fold(previous)

            loop_body: mutable darray[Ast::Stmt] = [(Ast::Stmt.VarDecl(input_var, (Ast::Expr.Invalid), input_expression, Ast::pos_at_line(line)))]
            loop_body.extend(dispatch)
            # A one-state wildcard self-loop has no runtime state. Preserve one
            # evaluation of `over` per iteration, then emit the arm body directly;
            # ordinary for-loops can therefore migrate to machines at zero cost.
            if has_for_driver and states.count == 1 and arms.count == 1 and states[0].field_names.count == 0 and arms[0].state_name == states[0].name and machine_arm_irrefutable(arms[0]) and arms[0].has_transition and arms[0].target == states[0].name and arms[0].transition_args.count == 0:
                declarations <- []
                if arms[0].input_bind != "":
                    # The ordinary match path declares input_var before dispatch.
                    # Preserve it in the zero-state fast path when the arm body names it.
                    loop_body <- [(Ast::Stmt.VarDecl(input_var, (Ast::Expr.Invalid), input_expression, Ast::pos_at_line(line)))]
                else:
                    loop_body <- [(Ast::Stmt.Expr(input_expression, Ast::pos_at_line(line)))]
                loop_body.extend(lower_machine_arm_body(arms[0], states, states[0].field_names, enum_name, mode_var, input_var, line))
            loop_statement: mutable Ast::Stmt = (Ast::Stmt.While(condition, loop_body, Ast::pos_at_line(line)))
            if has_for_driver:
                loop_statement <- (Ast::Stmt.For(for_bind, for_variables, for_iterable, loop_body, Ast::pos_at_line(line)))

            captures: mutable darray[sview] = []
            for root in mutated_roots |captures|:
                machine_add_root(captures, root)

            rebind wrapped: Ast::Stmt, parser = parser.wrap_loop_header(declarations, yield_expression, loop_statement, line, captures)
            return wrapped
