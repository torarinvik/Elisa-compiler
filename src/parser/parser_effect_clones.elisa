extend Parser:
    private:
        def effect_template_decl_at(declarations: darray[Ast::Decl]&, source_name: sview, source_line: u32, source_offset: u32) -> Ast::Decl?:
            for declaration in declarations:
                if declaration is Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                    return declaration if function_name == source_name and line.line == source_line and line.offset == source_offset
                if declaration is Decl.Module(module_name, module_body, module_pos):
                    if effect_template_decl_at(module_body, source_name, source_line, source_offset) is nested_decl:
                        return nested_decl
                if declaration is Decl.Scoped(scoped_body, scoped_pos):
                    if effect_template_decl_at(scoped_body, source_name, source_line, source_offset) is nested_scope_decl:
                        return nested_scope_decl
            return null

        # Freeze the marked source declarations once, in declaration traversal order.
        # The sparse marker list excludes installation/handler/clone metadata. Both lists
        # stay local to this transaction, so clone registration cannot invalidate them.
        def effect_collect_template_declarations(declarations: darray[Ast::Decl]&, markers: darray[Ast::EnumAnnotation]&, source_owner: sview @source, templates: mutable darray[Ast::Decl]&, owners: mutable darray[sview @source]&) -> void:
            for declaration in declarations |templates, owners, markers, source_owner|:
                if declaration is Decl.Func(source_name, source_params, source_return, source_body, source_effects, source_decorators, source_line):
                    if any marker in markers where marker.name == source_name and marker.line == source_line.line and marker.offset == source_line.offset:
                        templates.push(declaration) can Memory.Allocate
                        owners.push(source_owner) can Memory.Allocate
                elif declaration is Decl.Module(module_name, module_body, module_pos):
                    effect_collect_template_declarations(module_body, markers, module_name, templates, owners) can Global{Read,Write}
                elif declaration is Decl.Scoped(scoped_body, scoped_pos):
                    effect_collect_template_declarations(scoped_body, markers, source_owner, templates, owners) can Global{Read,Write}

        def effect_register_clone_templates(parser: lmut Parser, templates: darray[Ast::Decl]&, owners: darray[sview @source]&, effect_ref: sview @source, handler_name: sview @source) -> void:
            for template_index in 0..<templates.count |parser, templates, owners, effect_ref, handler_name|:
                declaration: Ast::Decl = templates[template_index] can Abort.Panic
                if declaration is Decl.Func(source_name, source_params, source_return, source_body, source_effects, source_decorators, source_line):
                    environment_complete: mutable bool = true
                    for required_effect in source_effects |parser, environment_complete|:
                        environment_complete <- false if parser.effect_template_row_is_abstract(required_effect) and not parser.effect_environment_may_cover(required_effect, parser.effect_active_install, source_line.line, source_line.offset)
                    continue if not environment_complete
                    for template_effect in source_effects |parser, source_name, source_line, handler_name, effect_ref, source_params, owners, template_index|:
                        if parser.effect_template_row_is_abstract(template_effect):
                            required_count: mutable usize = source_params.count
                            while required_count > 0.usize() and source_params[required_count - 1.usize()].has_default |required_count, source_params|:
                                required_count <- required_count - 1.usize()
                            parser <- parser.effect_register_clone(source_name, source_line.line, source_line.offset, handler_name, effect_ref, source_params.count, owners[template_index], required_count) can Global{Read,Write}, Abort.Panic
                            break

        def effect_register_clone(parser: lmut Parser, source_name: sview @source, source_line: u32, source_offset: u32, handler_name: sview @source, effect_ref: sview @source, parameter_count: usize, source_owner: sview @source, required_count: usize) -> void:
            for clone_index in 0..<parser.effect_clone_names.count |parser, source_name, source_line, source_offset, handler_name, effect_ref, parameter_count, source_owner|:
                continue if parser.effect_clone_install_ids[clone_index] != parser.effect_active_install
                continue if parser.effect_clone_sources[clone_index] != source_name or parser.effect_clone_source_lines[clone_index] != source_line or parser.effect_clone_source_offsets[clone_index] != source_offset or parser.effect_clone_owners[clone_index] != source_owner or parser.effect_clone_handlers[clone_index] != handler_name or parser.effect_clone_param_counts[clone_index] != parameter_count
                return if effect_template_row_matches(parser.effect_clone_effects[clone_index], effect_ref)
            clone_name: sview = parser.effect_clone_name(source_name, handler_name, source_line, source_offset) can Global{Read,Write}
            parser.effect_clone_sources <- parser.effect_clone_sources.push(source_name)
            parser.effect_clone_source_lines <- parser.effect_clone_source_lines.push(source_line)
            parser.effect_clone_source_offsets <- parser.effect_clone_source_offsets.push(source_offset)
            parser.effect_clone_handlers <- parser.effect_clone_handlers.push(handler_name)
            parser.effect_clone_effects <- parser.effect_clone_effects.push(effect_ref)
            parser.effect_clone_names <- parser.effect_clone_names.push(clone_name)
            parser.effect_clone_param_counts <- parser.effect_clone_param_counts.push(parameter_count)
            parser.effect_clone_required_counts <- parser.effect_clone_required_counts.push(required_count)
            parser.effect_clone_install_ids <- parser.effect_clone_install_ids.push(parser.effect_active_install)
            parser.effect_clone_owners <- parser.effect_clone_owners.push(source_owner) can Memory.Allocate
            # Semantic validation may skip the abstract source body only when at least one
            # concrete clone exists. Without this marker an uninstalled helper would be
            # skipped as a template and fail later as an opaque backend decline.
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__effect_clone", name: source_name, line: source_line, offset: source_offset})
            # Generic clones are themselves backend templates. Keep their concrete emitted name
            # in a separate marker: the ordinary clone marker deliberately points back to the
            # source helper so semantic checking can decide whether that source body is installed.
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__effect_clone_name", name: clone_name, line: source_line, offset: source_offset})

        # Register every source-template/installation pair before creating any clone body.
        # That makes helper-to-helper calls inside a clone resolve in the same pass, including
        # recursive helpers, without a runtime dispatch fallback.
        def effect_register_clones(parser: lmut Parser, declarations: darray[Ast::Decl]&) -> void:
            markers: mutable darray[Ast::EnumAnnotation] = []
            for annotation in parser.enum_annotations |markers|:
                markers.push(annotation) can Memory.Allocate if annotation.owner == "__effect_template"
            # Most installations perform operations directly and need no helper clones.
            if markers.count == 0:
                parser.effect_active_install <- 0
                return
            templates: mutable darray[Ast::Decl] = []
            owners: mutable darray[sview @source] = []
            effect_collect_template_declarations(declarations, markers, "", templates, owners) can Global{Read,Write}
            # Walk only the annotations present on entry: effect_register_clone pushes clone
            # markers onto parser.enum_annotations, so iterating the field itself would walk a
            # buffer the callee relocates or overwrites.
            for install_index in 0..<parser.enum_annotations.count |install_index, parser, templates, owners|:
                install_annotation: Ast::EnumAnnotation = parser.enum_annotations[install_index]
                continue if install_annotation.owner != "__effect_install"
                install_id: u32 = parser.effect_install_id_at(install_annotation.line, install_annotation.offset)
                effect_ref: sview @source = parser.effect_install_effect_at(install_id)
                continue if effect_ref == "" or parser.effect_install_handler_identity_at(install_id) == 0
                handler_name: sview @source = install_annotation.name
                parser.effect_active_install <- install_id
                parser <- parser.effect_register_clone_templates(templates, owners, effect_ref, handler_name) can Global{Read,Write}
            parser.effect_active_install <- 0

        # Build the explicit capture ABI of a clone. The captures are new formal parameters;
        # the source installation's capture locals are passed at each redirected call site.
        def effect_clone_capture_abi(parser: lmut Parser, handler_name: sview, install_id: u32, capture_index: mutable usize&, parameters: mutable darray[Ast::ParamDecl]&, expressions: mutable darray[Ast::Expr]&) -> void:
            source_line: u32 = parser.effect_install_line_at(install_id)
            handler_identity_id: u32 = parser.effect_install_handler_identity_at(install_id)
            return if handler_identity_id == 0
            for owner_index in 0..<parser.handler_capture_owners.count |parser, owner_index, capture_index, handler_name, handler_identity_id, source_line, parameters, expressions|:
                continue if parser.handler_capture_owners[owner_index] != handler_name
                continue if owner_index >= parser.handler_capture_identity_ids.count or parser.handler_capture_identity_ids[owner_index] != handler_identity_id
                capture: Ast::ParamDecl = parser.handler_capture_params[owner_index]
                formal_name: sview = parser.effect_clone_capture_name(handler_name, source_line, capture_index) can Global{Read,Write}
                # Keep the capture's source-name position so parameter error-family
                # metadata remains attached to the synthesized ABI formal. The family
                # annotation is keyed by the original parameter token offset.
                parameters.push(Ast::ParamDecl{name: formal_name, name_pos: capture.name_pos, type_expression: capture.type_expression, is_mutable: capture.is_mutable, has_default: false, default_value: (Ast::Expr.Invalid), is_affine: capture.is_affine})
                expressions.push(Ast::Expr.Ident(formal_name, Ast::pos_at_line(0)))
                capture_index <- capture_index + 1.usize()

        # Collect the bare function names visible from a module-local source helper. This is a
        # deliberately narrow lexical fact: only declarations in that module are qualified, so
        # local variables and unrelated top-level functions retain ordinary name resolution.
        def effect_collect_owner_function_names(parser: Parser&, declarations: darray[Ast::Decl]&, target_owner: sview, names: mutable darray[sview]&) -> void:
            for declaration in declarations |names, target_owner|:
                if declaration is Decl.Module(module_name, module_body, module_pos):
                    if module_name == target_owner:
                        for nested in module_body |names|:
                            if nested is Decl.Func(nested_name, nested_params, nested_return, nested_body, nested_effects, nested_decorators, nested_line):
                                names.push(nested_name)
                    else:
                        parser.effect_collect_owner_function_names(module_body, target_owner, names)
                elif declaration is Decl.Scoped(scoped_body, scoped_pos):
                    parser.effect_collect_owner_function_names(scoped_body, target_owner, names)

        def effect_build_clone(parser: lmut Parser, declarations: darray[Ast::Decl]&, clone_index: usize) -> Ast::Decl?:
            source_name: sview = parser.effect_clone_sources[clone_index]
            source_line_number: u32 = parser.effect_clone_source_lines[clone_index]
            source_offset: u32 = parser.effect_clone_source_offsets[clone_index]
            clone_effect: sview = parser.effect_clone_effects[clone_index]
            clone_handler: sview = parser.effect_clone_handlers[clone_index]
            clone_name: sview = parser.effect_clone_names[clone_index]
            clone_owner: sview = parser.effect_clone_owners[clone_index] if clone_index < parser.effect_clone_owners.count else ""
            source: Ast::Decl? = effect_template_decl_at(declarations, source_name, source_line_number, source_offset)
            if source is source_decl:
                if source_decl is Decl.Func(source_name, source_params, source_return, source_body, source_effects, source_decorators, source_line):
                    clone_parameters: mutable darray[Ast::ParamDecl] @source = []
                    clone_captures: mutable darray[Ast::Expr] @source = []
                    parser.effect_active_install <- parser.effect_clone_install_ids[clone_index]
                    parser.effect_clone_source_active <- true
                    parser.effect_clone_source_line <- source_line.line
                    parser.effect_clone_source_offset <- source_line.offset
                    capture_install: mutable u32 = parser.effect_active_install
                    capture_name_index: mutable usize = 0
                    while capture_install != 0 |parser, capture_install, capture_name_index, clone_parameters, clone_captures|:
                        capture_handler: sview = parser.effect_install_handler_at(capture_install)
                        parser <- parser.effect_clone_capture_abi(capture_handler, capture_install, capture_name_index, clone_parameters, clone_captures) can Global{Read,Write}
                        capture_install <- parser.effect_install_parent(capture_install)
                    clone_parameters.extend(source_params)
                    parser.effect_clone_active_owner <- clone_owner
                    parser.effect_clone_visible_names <- parser.effect_clone_visible_names.truncate(0)
                    parser.effect_collect_owner_function_names(declarations, clone_owner, parser.effect_clone_visible_names) can Unsafe.Alias
                    parser.effect_context_arguments <- parser.effect_context_arguments.truncate(0)
                    for capture in clone_captures |parser|:
                        parser.effect_context_arguments <- parser.effect_context_arguments.push(capture)
                    clone_body: mutable darray[Ast::Stmt] @source = source_body
                    current_install: mutable u32 = parser.effect_active_install
                    capture_offset: mutable usize = 0
                    while current_install != 0 |parser, current_install, capture_offset, clone_body, clone_captures|:
                        current_handler: sview = parser.effect_install_handler_at(current_install)
                        current_handler_identity_id: u32 = parser.effect_install_handler_identity_at(current_install)
                        current_effect: sview @source = parser.effect_install_effect_at(current_install)
                        current_arguments: mutable darray[Ast::Expr] @source = []
                        for capture_owner_index in 0..<parser.handler_capture_owners.count |capture_offset, current_arguments, clone_captures, current_handler, current_handler_identity_id|:
                            continue if current_handler_identity_id == 0
                            continue if parser.handler_capture_owners[capture_owner_index] != current_handler
                            continue if capture_owner_index >= parser.handler_capture_identity_ids.count or parser.handler_capture_identity_ids[capture_owner_index] != current_handler_identity_id
                            if capture_offset < clone_captures.count:
                                current_arguments.push(clone_captures[capture_offset])
                                capture_offset <- capture_offset + 1.usize()
                        rebind rewritten_body: darray[Ast::Stmt] @source, parser = parser.rewrite_handler_statements(clone_body, current_effect, current_handler, current_arguments) can Global{Read,Write}
                        clone_body <- rewritten_body
                        current_install <- parser.effect_install_parent(current_install)
                    parser.effect_clone_active_owner <- ""
                    parser.effect_clone_visible_names <- parser.effect_clone_visible_names.truncate(0)
                    residual_effects: mutable darray[sview @source] @source = []
                    for source_effect in source_effects |residual_effects, clone_effect|:
                        residual_effects.push(source_effect) if not parser.effect_template_row_is_abstract(source_effect)
                        realization: sview = handler_effect_via(source_effect)
                        residual_effects.push(realization) if realization != ""
                    for handler_annotation in parser.enum_annotations |residual_effects, clone_handler, parser|:
                        permission_install: mutable u32 = parser.effect_active_install
                        installed_owner: mutable bool = false
                        handler_target_ref: sview = parser.effect_handler_target_reference(handler_annotation.owner, handler_annotation.identity_id)
                        handler_target_identity_id: u32 = parser.effect_handler_target_identity_at(handler_annotation.owner, handler_annotation.identity_id)
                        while permission_install != 0 |parser, permission_install, installed_owner, handler_annotation, handler_target_ref, handler_target_identity_id|:
                            installed_handler_identity_id: u32 = parser.effect_install_handler_identity_at(permission_install)
                            installed_effect_identity_id: u32 = parser.effect_install_effect_identity_at(permission_install)
                            installed_effect_ref: sview @source = parser.effect_install_effect_at(permission_install)
                            installed_owner <- true if installed_handler_identity_id != 0 and handler_annotation.identity_id == installed_handler_identity_id and parser.effect_install_handler_at(permission_install) == handler_annotation.owner and handler_target_identity_id != 0 and handler_target_identity_id == installed_effect_identity_id and effect_template_row_matches(handler_target_ref, installed_effect_ref)
                            permission_install <- parser.effect_install_parent(permission_install)
                        continue if not installed_owner
                        if handler_annotation.line == 3900000087:
                            method_effect_identity_id: u32 = handler_annotation.referenced_identity_id if handler_annotation.referenced_identity_id != 0 else parser.effect_identity_for_reference(handler_annotation.name, handler_annotation.module, handler_annotation.offset)
                            residual_effects.push(handler_annotation.name) if method_effect_identity_id == 0
                        if handler_annotation.line == 3900000084 or handler_annotation.line == 3900000095:
                            target_effect: sview = handler_effect_via(handler_annotation.name)
                            residual_effects.push(target_effect) if target_effect != ""
                    parser.effect_active_install <- 0
                    parser.effect_clone_source_active <- false
                    parser.effect_clone_source_line <- 0
                    parser.effect_clone_source_offset <- 0
                    parser.effect_context_arguments <- parser.effect_context_arguments.truncate(0)
                    return (Decl.Func(clone_name, clone_parameters, source_return, clone_body, residual_effects, source_decorators, source_line))
            return null

        def effect_build_clones(parser: lmut Parser, declarations: darray[Ast::Decl]&) -> darray[Ast::Decl]:
            clones: mutable darray[Ast::Decl] = []
            for clone_index in 0..<parser.effect_clone_names.count |parser, clone_index, declarations, clones|:
                rebind clone_opt: Ast::Decl?, parser = parser.effect_build_clone(declarations, clone_index) can Global{Read,Write}
                clones.push(clone) if clone_opt is clone
            return clones

        # The ordinary handler rewrite already walks every expression and statement shape.
        # Reuse it for an installation body so helper calls in branches, loops, matches, and
        # value blocks receive the same direct-clone treatment as a top-level call.
        def effect_specialize_install_statements(parser: lmut Parser, statements: darray[Ast::Stmt]) -> darray[Ast::Stmt] @source:
            rewritten: mutable darray[Ast::Stmt] @source = []
            for statement in statements |rewritten, parser|:
                match statement:
                    Stmt.Block(kind, clause, binding, body, position):
                        install_id: u32 = parser.effect_install_id_at(position.line, position.offset)
                        effect_ref: sview @source = parser.effect_install_effect_at(install_id)
                        handler_name: sview = parser.effect_install_handler_at(install_id) if kind == "can" else ""
                        if handler_name != "" and effect_ref != "":
                            actual_captures: darray[Ast::Expr] @source = parser.effect_install_captures_at(install_id)
                            rebind inner_body: darray[Ast::Stmt] @source, parser = parser.effect_specialize_install_statements(body) can Global{Read,Write}
                            saved_active_install: u32 = parser.effect_active_install
                            parser.effect_active_install <- install_id
                            environment_arguments: darray[Ast::Expr] = parser.effect_environment_arguments(install_id)
                            parser.effect_context_arguments <- parser.effect_context_arguments.truncate(0)
                            for argument in environment_arguments |parser|:
                                parser.effect_context_arguments <- parser.effect_context_arguments.push(argument)
                            rebind specialized_body: darray[Ast::Stmt] @source, parser = parser.rewrite_handler_statements(inner_body, effect_ref, handler_name, actual_captures) can Global{Read,Write}
                            parser.effect_active_install <- saved_active_install
                            parser.effect_context_arguments <- parser.effect_context_arguments.truncate(0)
                            rewritten.push(Stmt.Block(kind, clause, binding, specialized_body, position))
                        else:
                            rebind nested_body: darray[Ast::Stmt] @source, parser = parser.effect_specialize_install_statements(body) can Global{Read,Write}
                            rewritten.push(Stmt.Block(kind, clause, binding, nested_body, position))
                    Stmt.If(condition, then_body, else_body, position):
                        rebind specialized_condition: Ast::Expr, parser = parser.rewrite_handler_expression(condition, "", "", []) can Global{Read,Write}
                        rebind specialized_then: darray[Ast::Stmt] @source, parser = parser.effect_specialize_install_statements(then_body) can Global{Read,Write}
                        rebind specialized_else: darray[Ast::Stmt] @source, parser = parser.effect_specialize_install_statements(else_body) can Global{Read,Write}
                        rewritten.push(Stmt.If(specialized_condition, specialized_then, specialized_else, position))
                    Stmt.While(condition, body, position):
                        rebind specialized_condition: Ast::Expr, parser = parser.rewrite_handler_expression(condition, "", "", []) can Global{Read,Write}
                        rebind specialized_body: darray[Ast::Stmt] @source, parser = parser.effect_specialize_install_statements(body) can Global{Read,Write}
                        rewritten.push(Stmt.While(specialized_condition, specialized_body, position))
                    Stmt.For(binding, variables, iterable, body, position):
                        rebind specialized_iterable: Ast::Expr, parser = parser.rewrite_handler_expression(iterable, "", "", []) can Global{Read,Write}
                        rebind specialized_body: darray[Ast::Stmt] @source, parser = parser.effect_specialize_install_statements(body) can Global{Read,Write}
                        rewritten.push(Stmt.For(binding, variables, specialized_iterable, specialized_body, position))
                    Stmt.Match(scrutinee, arms, position):
                        specialized_arms: mutable darray[Ast::MatchArm] @source = []
                        for arm in arms |parser, specialized_arms|:
                            rebind specialized_guard: Ast::Expr, parser = parser.rewrite_handler_expression(arm.guard, "", "", []) can Global{Read,Write}
                            rebind specialized_arm_body: darray[Ast::Stmt] @source, parser = parser.effect_specialize_install_statements(arm.body) can Global{Read,Write}
                            specialized_arms.push(Ast::MatchArm{pattern: arm.pattern, body: specialized_arm_body, guard: specialized_guard, pos: arm.pos})
                        rebind specialized_scrutinee: Ast::Expr, parser = parser.rewrite_handler_expression(scrutinee, "", "", []) can Global{Read,Write}
                        rewritten.push(Stmt.Match(specialized_scrutinee, specialized_arms, position))
                    _:
                        rewritten.push(statement)
            return rewritten
