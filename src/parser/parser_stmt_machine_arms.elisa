# Stage1 parser — `machine` arm parsing and coverage (`extend Parser: public:`). Covers
# arm parsing, transition validation, arm-body lowering, the arm-condition builder, and
# the literal-domain coverage check. Continues parser_stmt_machine.elisa; split out to
# keep each part file under 600 lines.

extend Parser:
    public:
        def parse_machine_state_decl(parser: lmut Parser) -> MachineStateAst:
            parser, _ <- parser.advance()   # `state`
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            name_text: sview = Lexer::text_or_empty(name_token, parser.source)
            field_names: mutable darray[sview] = []
            field_types: mutable darray[Ast::Expr] = []
            rebind accepted_paren: bool, parser = parser.accept(TokenKind.LParen)
            if accepted_paren:
                machine over parser.position while true:
                    state Field
                    state FieldColon(field_token: Token)
                    state ConsumeColon
                    state FieldType
                    state Refinement
                    state Separator
                    start Field

                    Field, _ if parser.peek() == TokenKind.RParen or parser.peek() == TokenKind.Eof:
                        break

                    Field, _:
                        rebind parsed_field_token: Token, parser = parser.expect(TokenKind.Ident)
                        -> FieldColon(parsed_field_token)

                    FieldColon(field_token), _:
                        field_names.push(Lexer::text_or_empty(field_token, parser.source))
                        -> ConsumeColon

                    ConsumeColon, _:
                        parser.position <- parser.position + 1
                        -> FieldType

                    FieldType, _:
                        rebind field_type: Ast::Expr?, parser = parser.expression()
                        field_type_value: Ast::Expr = get field_type else (Ast::Expr.Invalid)
                        field_types.push(field_type_value)
                        -> Refinement

                    Refinement, _ if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(parser.tokens[parser.position], parser.source) == "where":
                        parser.position <- parser.position + 1
                        rebind ignored_refinement: Ast::Expr?, parser = parser.expression()
                        -> Separator

                    Refinement, _:
                        -> Separator

                    Separator, _ if parser.peek() == TokenKind.Comma:
                        parser.position <- parser.position + 1
                        -> Field

                    Separator, _:
                        break
                parser, _ <- parser.expect(TokenKind.RParen)
            # Callers own line progress. Function-local directives return null and let
            # parse_block consume this newline; `machine over` skips it at loop top.
            return MachineStateAst{name: name_text, field_names: field_names, field_types: field_types, line: name_token.line}

        # One typed declaration or concise payload-less declaration group. The
        # grouped spelling is normalized immediately, so every later graph check
        # sees precisely the same MachineStateAst sequence as repeated `state` lines.
        def parse_machine_state_decls(parser: lmut Parser) -> darray[MachineStateAst]:
            declarations: mutable darray[MachineStateAst] = []
            # `parse_machine_state_decl` owns the leading contextual `state`; inspect
            # before consuming so the scalar and grouped paths share one entry point.
            grouped: bool = parser.peek_at(1) == TokenKind.LBrace
            if not grouped:
                rebind declaration: MachineStateAst, parser = parser.parse_machine_state_decl()
                declarations.push(declaration)
                return declarations

            parser, _ <- parser.advance() # `state`
            parser, _ <- parser.expect(TokenKind.LBrace)
            machine over parser.position while parser.peek() != TokenKind.RBrace and parser.peek() != TokenKind.Eof:
                state Parse
                state Separator
                start Parse

                Parse, _:
                    rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
                    empty_names: darray[sview] = []
                    empty_types: darray[Ast::Expr] = []
                    declarations.push(MachineStateAst{name: Lexer::text_or_empty(name_token, parser.source), field_names: empty_names, field_types: empty_types, line: name_token.line})
                    -> Separator

                Separator, _ if parser.peek() == TokenKind.Comma:
                    parser.position <- parser.position + 1
                    -> Parse

                Separator, _:
                    break
            parser, _ <- parser.expect(TokenKind.RBrace)
            return declarations

        # Function-local declarations live in parser state beyond this helper's
        # auto region, so append each normalized declaration directly to the
        # parser-owned array instead of returning a temporary group.
        def parse_pending_machine_state_decls(parser: lmut Parser):
            parser, _ <- parser.advance()
            parser, _ <- parser.expect(TokenKind.LBrace)
            machine over parser.position while parser.peek() != TokenKind.RBrace and parser.peek() != TokenKind.Eof:
                state Parse
                state Separator
                start Parse

                Parse, _:
                    rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
                    parser.pending_state_decls <- parser.pending_state_decls.push(MachineStateAst{name: Lexer::text_or_empty(name_token, parser.source), field_names: [], field_types: [], line: name_token.line})
                    -> Separator

                Separator, _ if parser.peek() == TokenKind.Comma:
                    parser.position <- parser.position + 1
                    -> Parse

                Separator, _:
                    break
            parser, _ <- parser.expect(TokenKind.RBrace)

        # docs/123 §5 (the machine arm law): an arm body is STRAIGHT-LINE. All discrimination
        # lives in the arm HEADER (`State, input if guard:`), so hidden branching/looping
        # (`if`/`match`/`while`/`for`) inside a body is refused — as is `continue` (every arm
        # ends in `-> State`, `return`, or `break`). `return`/`break` stay legal: they are arm
        # EXITS. Stage1 now OWNS this refusal (docs/125 step 13) rather than deferring to
        # stage0; mirrors stage0's validateMachineArmStmt (parser/machine.go). A `can`/`with`/…
        # wrapper is transparent — its body is retested one level down.
        def machine_over_arm_stmt_illegal(statement: Ast::Stmt) -> bool:
            return match statement:
                Ast::Stmt.If(condition, then_body, else_body, line):
                    true
                Ast::Stmt.While(condition, body, line):
                    true
                Ast::Stmt.For(bind, variables, iterable, body, line):
                    true
                Ast::Stmt.Match(scrutinee, arms, line):
                    true
                Ast::Stmt.Continue(label, line):
                    true
                Ast::Stmt.Block(kind, clause, binding, body, line):
                    any inner in body where machine_over_arm_stmt_illegal(inner)
                _:
                    false

        def parse_machine_arm(parser: lmut Parser) -> MachineArmAst:
            rebind state_token: Token, parser = parser.expect(TokenKind.Ident)
            state_text: sview = Lexer::text_or_empty(state_token, parser.source)
            payloads: mutable darray[MachinePayloadPat] = []
            rebind accepted_paren: bool, parser = parser.accept(TokenKind.LParen)
            if accepted_paren:
                if parser.peek() != TokenKind.RParen:
                    machine over parser.position while true:
                        state Payload
                        state Separator
                        start Payload

                        Payload, _:
                            rebind payload: MachinePayloadPat, parser = parser.parse_machine_payload_pat()
                            payloads.push(payload)
                            -> Separator

                        Separator, _ if parser.peek() == TokenKind.Comma:
                            parser.position <- parser.position + 1
                            -> Payload

                        Separator, _:
                            break
                parser, _ <- parser.expect(TokenKind.RParen)
            parser, _ <- parser.expect(TokenKind.Comma)

            input_literals: mutable darray[Ast::Expr] = []
            input_ranges: mutable darray[MachineRange] = []
            input_wild: mutable bool = false
            input_bind: mutable sview = ""
            input_token: Token = parser.cursor()
            if input_token.kind == TokenKind.Ident and Lexer::text_or_empty(input_token, parser.source) == "_":
                parser, _ <- parser.advance()
                input_wild <- true
            elif input_token.kind == TokenKind.Ident and (parser.peek_at(1) == TokenKind.If or parser.peek_at(1) == TokenKind.Colon):
                # Input BIND pattern: matches any input, names it for the guard/body.
                parser, _ <- parser.advance()
                input_bind <- Lexer::text_or_empty(input_token, parser.source)
                input_wild <- true
            else:
                machine over parser.position while true:
                    state Alternative
                    state Range(lo: Ast::Expr)
                    state Separator
                    start Alternative

                    Alternative, _:
                        rebind literal_opt: Ast::Expr?, parser = parser.unary_expression()
                        -> Range(get literal_opt else (Ast::Expr.Invalid))

                    Range(lo), _ if parser.peek() == TokenKind.RangeLt or parser.peek() == TokenKind.RangeLe:
                        rebind range_token: Token, parser = parser.advance()
                        rebind hi_opt: Ast::Expr?, parser = parser.unary_expression()
                        input_ranges.push(MachineRange{lo: lo, hi: get hi_opt else (Ast::Expr.Invalid), inclusive: range_token.kind == TokenKind.RangeLe})
                        -> Separator

                    Range(lo), _:
                        input_literals.push(lo)
                        -> Separator

                    Separator, _ if parser.peek() == TokenKind.Pipe:
                        parser.position <- parser.position + 1
                        -> Alternative

                    Separator, _:
                        break

            guard: mutable Ast::Expr = (Ast::Expr.Absent)
            if parser.peek() == TokenKind.If:
                parser, _ <- parser.advance()
                rebind guard_opt: Ast::Expr?, parser = parser.expression()
                guard_value: Ast::Expr = get guard_opt else (Ast::Expr.Invalid)
                guard <- guard_value

            parser, _ <- parser.expect(TokenKind.Colon)
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)

            body: mutable darray[Ast::Stmt] = []
            has_transition: mutable bool = false
            target: mutable sview = ""
            target_line: mutable u32 = state_token.line
            target_offset: mutable u32 = state_token.start
            transition_args: mutable darray[Ast::Expr] = []
            saw_decision: mutable bool = false
            machine over parser.position while true:
                state Scan
                start Scan

                Scan, _ if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof:
                    break

                Scan, _:
                    parser <- parser.consume_machine_arm_body_item(body, has_transition, target, target_line, target_offset, transition_args, saw_decision, state_token)
                    -> Scan
            parser, _ <- parser.expect(TokenKind.Dedent)

            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, state_token) if not saw_decision

            return MachineArmAst{
                state_name: state_text,
                payloads: payloads,
                input_literals: input_literals,
                input_ranges: input_ranges,
                input_wild: input_wild,
                input_bind: input_bind,
                guard: guard,
                body: body,
                has_transition: has_transition,
                target: target,
                target_line: target_line,
                target_offset: target_offset,
                transition_args: transition_args,
                transition_temp_names: [],
                line: state_token.line
            }

        # The arm body is a graph of parsing phases, not a statement loop with its
        # decisions hidden in a helper. Transition metadata travels as state payload,
        # so an arm cannot accidentally update the target without also setting the
        # decision and source-line facts.
        def consume_machine_arm_body_item(parser: lmut Parser, body: mutable darray[Ast::Stmt]&, has_transition: mutable bool&, target: mutable sview&, target_line: mutable u32&, target_offset: mutable u32&, transition_args: mutable darray[Ast::Expr]&, saw_decision: mutable bool&, state_token: Token) -> void:
            parser <- parser.skip_newlines()
            return if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof
            match parser.peek():
                TokenKind.Arrow:
                    rebind arrow_token: Token, parser = parser.advance()
                    rebind target_token: Token, parser = parser.expect(TokenKind.Ident)
                    has_transition <- true
                    saw_decision <- true
                    target <- Lexer::text_or_empty(target_token, parser.source)
                    target_line <- arrow_token.line
                    target_offset <- target_token.start
                    rebind accepted_args: bool, parser = parser.accept(TokenKind.LParen)
                    if accepted_args:
                        rebind parsed_args: darray[Ast::Expr], parser = parser.parse_machine_call_arguments()
                        transition_args <- transition_args.truncate(0)
                        transition_args.extend(parsed_args)
                        parser, _ <- parser.expect(TokenKind.RParen)
                    parser, _ <- parser.accept(TokenKind.Newline)
                _:
                    body_head_token: Token = parser.cursor()
                    saw_decision_value: bool = saw_decision
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, body_head_token) if saw_decision_value
                    rebind stmt_opt: Ast::Stmt?, parser = parser.statement()
                    if stmt_opt is body_statement:
                        parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, body_head_token) if machine_over_arm_stmt_illegal(body_statement)
                        body.push(body_statement)
                        saw_decision <- true if machine_statement_exits(body_statement)
                        parser <- parser.skip_trailing_can(true)
                        parser, _ <- parser.accept(TokenKind.Newline)
                    else:
                        parser, _ <- parser.advance()
        def machine_statement_exits(statement: Ast::Stmt) -> bool:
            return match statement:
                Ast::Stmt.Return(value, line): true
                Ast::Stmt.Break(label, line): true
                _: false

        def machine_assignment_root(statement: Ast::Stmt) -> sview:
            return match statement:
                Ast::Stmt.Assign(target, operator, value, line): machine_over_root(target)
                _: ""

        # The state dispatch body has the current state's payload locals in scope. An
        # alias, input binder, or ordinary arm-local with a destination-field spelling
        # would hide the state slot while the transition is being emitted. Keep this
        # predicate structural so the repair applies equally to payload aliases and
        # declarations nested in a transparent clause block.
        def machine_state_statement_declares_any_name(statement: Ast::Stmt, field_names: darray[sview]) -> bool:
            return match statement:
                Ast::Stmt.VarDecl(name, type_expression, value, pos): any field_name in field_names where field_name == name
                Ast::Stmt.Block(kind, clause, binding, body, pos): machine_state_declares_any_name(body, field_names)
                _: false

        def machine_state_declares_any_name(statements: darray[Ast::Stmt]&, field_names: darray[sview]) -> bool:
            found: mutable bool = false
            machine over found for statement in statements:
                state Scan
                start Scan

                Scan, _ if machine_state_statement_declares_any_name(statement, field_names):
                    found <- true
                    -> Scan

                Scan, _:
                    -> Scan
            return found

        def machine_arm_payload_shadows_target(arm: MachineArmAst&, source_fields: darray[sview], target_state: MachineStateAst) -> bool:
            shadowed: mutable bool = false
            machine over shadowed for payload_index in 0..<arm.payloads.count:
                state Payload
                start Payload

                Payload, _ if payload_index >= source_fields.count:
                    -> Payload

                Payload, _ if payload_index < source_fields.count and machine_arm_payload_shadows_target_at(arm, source_fields, target_state, payload_index):
                    shadowed <- true
                    -> Payload

                Payload, _:
                    -> Payload
            return shadowed

        def machine_arm_payload_shadows_target_at(arm: MachineArmAst&, source_fields: darray[sview], target_state: MachineStateAst, payload_index: usize) -> bool:
            bind_name: sview = arm.payloads[payload_index].bind
            return bind_name != "" and bind_name != source_fields[payload_index] and any field_name in target_state.field_names where field_name == bind_name

        def machine_arm_shadows_transition_target(arm: MachineArmAst&, source_fields: darray[sview], states: darray[MachineStateAst]) -> bool:
            false return if not arm.has_transition
            shadowed: mutable bool = false
            machine over shadowed for target_state in states:
                state Scan
                start Scan

                Scan, _ if target_state.name != arm.target:
                    -> Scan

                Scan, _ if arm.input_bind != "" and any field_name in target_state.field_names where field_name == arm.input_bind:
                    shadowed <- true
                    -> Scan

                Scan, _ if machine_arm_payload_shadows_target(arm, source_fields, target_state):
                    shadowed <- true
                    -> Scan

                Scan, _ if machine_state_declares_any_name(arm.body, target_state.field_names):
                    shadowed <- true
                    -> Scan

                Scan, _:
                    -> Scan
            return shadowed

        def append_machine_transition_temp_declarations_for_state(declarations: mutable darray[Ast::Stmt]&, arm: MachineArmAst&, target_state: MachineStateAst) -> void:
            machine over declarations for argument_index in 0..<arm.transition_args.count:
                state Scan
                start Scan

                Scan, _ if argument_index >= target_state.field_types.count:
                    -> Scan

                Scan, _:
                    temp_type: Ast::Expr = (Ast::Expr.Unary(TokenKind.Mutable, target_state.field_types[argument_index], Ast::pos_at_line(arm.target_line)))
                    declarations.push((Ast::Stmt.VarDecl(arm.transition_temp_names[argument_index], temp_type, (Ast::Expr.Ident("zeroed", Ast::pos_at_line(arm.target_line))), Ast::pos_at_line(arm.target_line))))
                    -> Scan

        def append_machine_transition_temp_declarations(declarations: mutable darray[Ast::Stmt]&, arm: MachineArmAst&, states: darray[MachineStateAst]) -> void:
            machine over declarations for target_state in states:
                state Scan
                start Scan

                Scan, _ if not arm.has_transition or target_state.name != arm.target:
                    -> Scan

                Scan, _:
                    append_machine_transition_temp_declarations_for_state(declarations, arm, target_state)
                    -> Scan

        def machine_expr_sequence_equal(first: darray[Ast::Expr], second: darray[Ast::Expr]) -> bool:
            same: mutable bool = first.count == second.count
            machine over same for index in 0..<first.count:
                state Scan
                start Scan

                Scan, _ if index >= second.count:
                    -> Scan

                Scan, _ if not machine_type_expression_equal(first[index], second[index]):
                    same <- false
                    -> Scan

                Scan, _:
                    -> Scan
            return same

        def machine_type_expression_equal(first: Ast::Expr, second: Ast::Expr) -> bool:
            match first:
                Ast::Expr.IntLit(first_value):
                    match second:
                        Ast::Expr.IntLit(second_value):
                            return first_value == second_value
                        _:
                            return false
                Ast::Expr.FloatLit(first_text):
                    match second:
                        Ast::Expr.FloatLit(second_text):
                            return first_text == second_text
                        _:
                            return false
                Ast::Expr.StringLit(first_text):
                    match second:
                        Ast::Expr.StringLit(second_text):
                            return first_text == second_text
                        _:
                            return false
                Ast::Expr.CharLit(first_text):
                    match second:
                        Ast::Expr.CharLit(second_text):
                            return first_text == second_text
                        _:
                            return false
                Ast::Expr.BoolLit(first_value):
                    match second:
                        Ast::Expr.BoolLit(second_value):
                            return first_value == second_value
                        _:
                            return false
                Ast::Expr.Ident(first_name, _):
                    match second:
                        Ast::Expr.Ident(second_name, _):
                            return first_name == second_name
                        _:
                            return false
                Ast::Expr.Scope(first_base, first_name, _):
                    match second:
                        Ast::Expr.Scope(second_base, second_name, _):
                            return first_name == second_name and machine_type_expression_equal(first_base, second_base)
                        _:
                            return false
                Ast::Expr.Index(first_object, first_index, _):
                    match second:
                        Ast::Expr.Index(second_object, second_index, _):
                            return machine_type_expression_equal(first_object, second_object) and machine_type_expression_equal(first_index, second_index)
                        _:
                            return false
                Ast::Expr.IndexN(first_object, first_arguments, _):
                    match second:
                        Ast::Expr.IndexN(second_object, second_arguments, _):
                            return false if not machine_type_expression_equal(first_object, second_object)
                            return machine_expr_sequence_equal(first_arguments, second_arguments)
                        _:
                            return false
                Ast::Expr.Binary(first_left, first_operator, first_right, _):
                    match second:
                        Ast::Expr.Binary(second_left, second_operator, second_right, _):
                            return first_operator == second_operator and machine_type_expression_equal(first_left, second_left) and machine_type_expression_equal(first_right, second_right)
                        _:
                            return false
                Ast::Expr.Unary(first_operator, first_operand, _):
                    match second:
                        Ast::Expr.Unary(second_operator, second_operand, _):
                            return first_operator == second_operator and machine_type_expression_equal(first_operand, second_operand)
                        _:
                            return false
                Ast::Expr.Paren(first_inner, _):
                    match second:
                        Ast::Expr.Paren(second_inner, _):
                            return machine_type_expression_equal(first_inner, second_inner)
                        _:
                            return false
                Ast::Expr.Array(first_elements, _):
                    match second:
                        Ast::Expr.Array(second_elements, _):
                            return machine_expr_sequence_equal(first_elements, second_elements)
                        _:
                            return false
                Ast::Expr.Tuple(first_elements, _):
                    match second:
                        Ast::Expr.Tuple(second_elements, _):
                            return machine_expr_sequence_equal(first_elements, second_elements)
                        _:
                            return false
                Ast::Expr.Refinement(first_base, first_predicate, _):
                    match second:
                        Ast::Expr.Refinement(second_base, second_predicate, _):
                            return machine_type_expression_equal(first_base, second_base) and machine_type_expression_equal(first_predicate, second_predicate)
                        _:
                            return false
                _:
                    return false

        def machine_state_name_duplicate(states: darray[MachineStateAst], state_index: usize) -> bool:
            duplicate: mutable bool = false
            machine over duplicate for previous_index in 0..<state_index:
                state Scan
                start Scan

                Scan, _ if states[state_index].name != states[previous_index].name:
                    -> Scan

                Scan, _:
                    duplicate <- true
                    -> Scan
            return duplicate

        def machine_state_field_duplicate(state: MachineStateAst, field_index: usize) -> bool:
            duplicate: mutable bool = false
            machine over duplicate for previous_index in 0..<field_index:
                state Scan
                start Scan

                Scan, _ if state.field_names[field_index] != state.field_names[previous_index]:
                    -> Scan

                Scan, _:
                    duplicate <- true
                    -> Scan
            return duplicate

        def machine_state_field_type_conflict_in(states: darray[MachineStateAst], state_index: usize, field_index: usize, previous_state_index: usize) -> bool:
            conflict: mutable bool = false
            machine over conflict for previous_field_index in 0..<states[previous_state_index].field_names.count:
                state Scan
                start Scan

                Scan, _ if states[state_index].field_names[field_index] != states[previous_state_index].field_names[previous_field_index]:
                    -> Scan

                Scan, _:
                    conflict <- not machine_type_expression_equal(states[state_index].field_types[field_index], states[previous_state_index].field_types[previous_field_index])
                    -> Scan
            return conflict

        def machine_state_field_type_conflict(states: darray[MachineStateAst], state_index: usize, field_index: usize) -> bool:
            conflict: mutable bool = false
            machine over conflict for previous_state_index in 0..<state_index:
                state Scan
                start Scan

                Scan, _ if machine_state_field_type_conflict_in(states, state_index, field_index, previous_state_index):
                    conflict <- true
                    -> Scan

                Scan, _:
                    -> Scan
            return conflict

        def validate_machine_state_field(parser: lmut Parser, states: darray[MachineStateAst], state_index: usize, field_index: usize, token: Token) -> void:
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if machine_state_field_duplicate(states[state_index], field_index)
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if machine_state_field_type_conflict(states, state_index, field_index)

        def validate_machine_state_fields(parser: lmut Parser, states: darray[MachineStateAst], state_index: usize, token: Token) -> void:
            machine over parser.position for field_index in 0..<states[state_index].field_names.count:
                state Scan
                start Scan

                Scan, _:
                    parser <- parser.validate_machine_state_field(states, state_index, field_index, token)
                    -> Scan

        def validate_machine_state(parser: lmut Parser, states: darray[MachineStateAst], state_index: usize, token: Token) -> void:
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if machine_state_name_duplicate(states, state_index)
            parser <- parser.validate_machine_state_fields(states, state_index, token)

        def validate_machine_state_declarations(parser: lmut Parser, states: darray[MachineStateAst], token: Token) -> void:
            machine over parser.position for state_index in 0..<states.count:
                state Scan
                start Scan

                Scan, _:
                    parser <- parser.validate_machine_state(states, state_index, token)
                    -> Scan

        def machine_state_name_exists(states: darray[MachineStateAst], name: sview) -> bool:
            return any state in states where state.name == name

        def machine_state_field_count(states: darray[MachineStateAst], name: sview) -> usize:
            found: mutable usize = 0
            machine over found for state in states:
                state Scan
                start Scan

                Scan, _ if state.name != name:
                    -> Scan

                Scan, _:
                    found <- state.field_names.count
                    -> Scan
            return found

        def validate_machine_arm_statement(parser: lmut Parser, statement: Ast::Stmt, arm: MachineArmAst, over_root: sview, token: Token) -> void:
            root: sview = machine_assignment_root(statement)
            if root != "":
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if any payload in arm.payloads where payload.bind != "" and root == payload.bind
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if any param in parser.mutable_param_names where root == param and root != over_root

        def validate_machine_arm_target(parser: lmut Parser, arm: MachineArmAst, states: darray[MachineStateAst], token: Token) -> void:
            target_found: bool = not arm.has_transition or machine_state_name_exists(states, arm.target)
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if not target_found
            target_field_count: usize = machine_state_field_count(states, arm.target)
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if arm.has_transition and target_found and arm.transition_args.count != target_field_count

        def validate_machine_arm(parser: lmut Parser, arm: MachineArmAst, states: darray[MachineStateAst], over_root: sview, token: Token) -> void:
            parser <- parser.validate_machine_arm_target(arm, states, token)
            machine over parser.position for statement in arm.body:
                state Scan
                start Scan

                Scan, _:
                    parser <- parser.validate_machine_arm_statement(statement, arm, over_root, token)
                    -> Scan

        def validate_machine_transitions(parser: lmut Parser, states: darray[MachineStateAst], arms: darray[MachineArmAst], start_state: sview, start_args: darray[Ast::Expr], input_expression: Ast::Expr, token: Token) -> void:
            over_root: sview = machine_over_root(input_expression)
            parser <- parser.validate_machine_state_declarations(states, token)
            start_found: bool = start_state == "" or machine_state_name_exists(states, start_state)
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if not start_found
            start_field_count: usize = machine_state_field_count(states, start_state)
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if start_state != "" and start_found and start_args.count != start_field_count
            machine over parser.position for arm in arms:
                state Scan
                start Scan

                Scan, _:
                    parser <- parser.validate_machine_arm(arm, states, over_root, token)
                    -> Scan

        # Lower one arm: payload-pattern conds AND input conds AND guard; body plus the
        # transition's payload assigns + mode rebind. Payload assignments are retained even
        # when both identifiers have the same spelling: an arm-local may shadow the state
        # slot, in which case `-> Next(value)` must copy that local into Next.value.
        def lower_machine_arm_body(arm: MachineArmAst&, states: darray[MachineStateAst], state_fields: darray[sview], enum_name: sview, mode_var: sview, input_var: sview, line: u32) -> darray[Ast::Stmt]:
            lowered: mutable darray[Ast::Stmt] = []
            if arm.input_bind != "":
                # The input binder belongs to this arm, not to the whole state dispatch.
                # The guard receives a separate expression-block binding below.
                lowered.push((Ast::Stmt.VarDecl(arm.input_bind, (Ast::Expr.Invalid), (Ast::Expr.Ident(input_var, Ast::pos_at_line(arm.line))), Ast::pos_at_line(arm.line))))
            # Payload bind aliases (bind name != field name).
            machine over lowered for index in 0..<arm.payloads.count:
                state Scan
                start Scan

                Scan, _ if index >= state_fields.count:
                    -> Scan

                Scan, _ if arm.payloads[index].is_wild or arm.payloads[index].bind == "" or arm.payloads[index].bind == state_fields[index]:
                    -> Scan

                Scan, _:
                    pat: MachinePayloadPat = arm.payloads[index]
                    lowered.push((Ast::Stmt.VarDecl(pat.bind, (Ast::Expr.Invalid), (Ast::Expr.Ident(state_fields[index], Ast::pos_at_line(arm.line))), Ast::pos_at_line(arm.line))))
                    -> Scan
            machine over lowered for statement in arm.body:
                state Scan
                start Scan

                Scan, _:
                    lowered.push(statement)
                    -> Scan
            lowered.reserve(lowered.count + states.count)
            machine over lowered for target_state in states:
                state Scan
                start Scan

                Scan, _ if not arm.has_transition or target_state.name != arm.target:
                    -> Scan

                Scan, _:
                    append_machine_transition_for_target(lowered, arm, target_state, enum_name, mode_var)
                    -> Scan
            lowered.push((Ast::Stmt.Expr((Ast::Expr.Invalid), Ast::pos_at_line(line)))) if lowered.count == 0
            return lowered

        def append_machine_transition_for_target[@r](lowered: mutable darray[Ast::Stmt]& @r, arm: MachineArmAst&, target_state: MachineStateAst, enum_name: sview, mode_var: sview) -> void:
            shadowed: bool = machine_state_declares_any_name(lowered, target_state.field_names)
            if shadowed:
                captured: mutable darray[Ast::Stmt] @r = []
                captured.extend(lowered)
                values: mutable darray[Ast::Expr] @r = []
                machine over values for argument_index in 0..<arm.transition_args.count:
                    state Capture
                    start Capture

                    Capture, _:
                        append_machine_transition_capture(captured, values, arm, argument_index)
                        -> Capture
                lowered <- [(Ast::Stmt.Block("can", [], "", captured, Ast::pos_at_line(arm.line)))]
                append_machine_transition_for_values(lowered, arm, target_state, enum_name, mode_var, values)
                return
            append_machine_transition_for_state(lowered, arm, target_state, enum_name, mode_var)

        def append_machine_transition_capture(captured: mutable darray[Ast::Stmt]&, values: mutable darray[Ast::Expr]&, arm: MachineArmAst&, argument_index: usize) -> void:
            captured.push((Ast::Stmt.Assign((Ast::Expr.Ident(arm.transition_temp_names[argument_index], Ast::pos_at_line(arm.target_line))), TokenKind.LArrow, arm.transition_args[argument_index], Ast::pos_at_line(arm.target_line))))
            values.push((Ast::Expr.Ident(arm.transition_temp_names[argument_index], Ast::pos_at_line(arm.target_line))))

        def append_machine_transition_for_state(lowered: mutable darray[Ast::Stmt]&, arm: MachineArmAst&, target_state: MachineStateAst, enum_name: sview, mode_var: sview) -> void:
            machine over lowered for argument_index in 0..<arm.transition_args.count:
                state Capture
                start Capture

                Capture, _:
                    lowered.push((Ast::Stmt.VarDecl(arm.transition_temp_names[argument_index], (Ast::Expr.Invalid), arm.transition_args[argument_index], Ast::pos_at_line(arm.target_line))))
                    -> Capture
            machine over lowered for index in 0..<target_state.field_names.count:
                state Scan
                start Scan

                Scan, _ if index >= arm.transition_args.count:
                    -> Scan

                Scan, _:
                    lowered.push((Ast::Stmt.Assign((Ast::Expr.Ident(target_state.field_names[index], Ast::pos_at_line(arm.target_line))), TokenKind.LArrow, (Ast::Expr.Ident(arm.transition_temp_names[index], Ast::pos_at_line(arm.target_line))), Ast::pos_at_line(arm.target_line))))
                    -> Scan
            lowered.push((Ast::Stmt.Assign((Ast::Expr.Ident(mode_var, Ast::pos_at_line(arm.target_line))), TokenKind.LArrow, (Ast::Expr.Field((Ast::Expr.Ident(enum_name, Ast::pos_at_line(arm.target_line))), arm.target, Ast::pos_at_line(arm.target_line))), Ast::pos_at_line(arm.target_line)))) if arm.target != arm.state_name

        def append_machine_transition_for_values(lowered: mutable darray[Ast::Stmt]&, arm: MachineArmAst&, target_state: MachineStateAst, enum_name: sview, mode_var: sview, values: darray[Ast::Expr]) -> void:
            machine over lowered for index in 0..<target_state.field_names.count:
                state Scan
                start Scan

                Scan, _ if index >= values.count:
                    -> Scan

                Scan, _:
                    lowered.push((Ast::Stmt.Assign((Ast::Expr.Ident(target_state.field_names[index], Ast::pos_at_line(arm.target_line))), TokenKind.LArrow, values[index], Ast::pos_at_line(arm.target_line))))
                    -> Scan
            lowered.push((Ast::Stmt.Assign((Ast::Expr.Ident(mode_var, Ast::pos_at_line(arm.target_line))), TokenKind.LArrow, (Ast::Expr.Field((Ast::Expr.Ident(enum_name, Ast::pos_at_line(arm.target_line))), arm.target, Ast::pos_at_line(arm.target_line))), Ast::pos_at_line(arm.target_line)))) if arm.target != arm.state_name

        # Build the arm's dispatch condition (Invalid when irrefutable).
        def machine_arm_condition(arm: MachineArmAst&, state_fields: darray[sview], input_var: sview) -> Ast::Expr:
            condition: mutable Ast::Expr = (Ast::Expr.Invalid)
            machine over condition while true:
                state Scan(index: usize, value: Ast::Expr)
                start Scan(0, (Ast::Expr.Invalid))

                Scan(index, value), _ if index >= arm.payloads.count:
                    condition <- value
                    break

                Scan(index, value), _ if index >= state_fields.count or arm.payloads[index].is_wild or arm.payloads[index].bind != "":
                    -> Scan(index + 1, value)

                Scan(index, value), _:
                    pat: MachinePayloadPat = arm.payloads[index]
                    # Literal payload pattern = equality test; predicate used verbatim.
                    term: Ast::Expr = machine_payload_condition(pat, state_fields[index], arm.line)
                    next_value: Ast::Expr = combine_machine_condition(value, term, TokenKind.And, arm.line)
                    -> Scan(index + 1, next_value)
            if not arm.input_wild:
                input_condition: mutable Ast::Expr = (Ast::Expr.Invalid)
                append_machine_input_condition(input_condition, arm, input_var)
                condition <- input_condition if machine_expr_is_invalid(condition) else (Ast::Expr.Binary(condition, TokenKind.And, input_condition, Ast::pos_at_line(arm.line)))
            guard: mutable Ast::Expr = arm.guard
            if arm.input_bind != "" and not machine_expr_is_invalid(guard):
                guard <- (Ast::Expr.Block([(Ast::Stmt.VarDecl(arm.input_bind, (Ast::Expr.Invalid), (Ast::Expr.Ident(input_var, Ast::pos_at_line(arm.line))), Ast::pos_at_line(arm.line)))], guard, [], Ast::pos_at_line(arm.line)))
            condition <- (guard if machine_expr_is_invalid(condition) else (Ast::Expr.Binary(condition, TokenKind.And, guard, Ast::pos_at_line(arm.line)))) if not machine_expr_is_invalid(guard)
            return condition

        def append_machine_input_condition(input_condition: mutable Ast::Expr&, arm: MachineArmAst&, input_var: sview) -> void:
            machine over input_condition while true:
                state Scan(phase: usize, index: usize, value: Ast::Expr)
                start Scan(0, 0, (Ast::Expr.Invalid))

                Scan(0, index, value), _ if index >= arm.input_literals.count:
                    -> Scan(1, 0, value)

                Scan(1, index, value), _ if index >= arm.input_ranges.count:
                    input_condition <- value
                    break

                Scan(0, index, value), _:
                    literal: Ast::Expr = arm.input_literals[index]
                    comparison: Ast::Expr = (Ast::Expr.Binary((Ast::Expr.Ident(input_var, Ast::pos_at_line(arm.line))), TokenKind.EqEq, literal, Ast::pos_at_line(arm.line)))
                    next_value: Ast::Expr = combine_machine_condition(value, comparison, TokenKind.Or, arm.line)
                    -> Scan(0, index + 1, next_value)

                Scan(1, index, value), _:
                    range: MachineRange = arm.input_ranges[index]
                    lo_test: Ast::Expr = (Ast::Expr.Binary((Ast::Expr.Ident(input_var, Ast::pos_at_line(arm.line))), TokenKind.GtEq, range.lo, Ast::pos_at_line(arm.line)))
                    hi_operator: TokenKind = machine_range_hi_operator(range)
                    hi_test: Ast::Expr = (Ast::Expr.Binary((Ast::Expr.Ident(input_var, Ast::pos_at_line(arm.line))), hi_operator, range.hi, Ast::pos_at_line(arm.line)))
                    range_test: Ast::Expr = (Ast::Expr.Binary(lo_test, TokenKind.And, hi_test, Ast::pos_at_line(arm.line)))
                    next_value: Ast::Expr = combine_machine_condition(value, range_test, TokenKind.Or, arm.line)
                    -> Scan(1, index + 1, next_value)


        def machine_payload_condition(pat: MachinePayloadPat, state_field: sview, line: u32) -> Ast::Expr:
            return (Ast::Expr.Binary((Ast::Expr.Ident(state_field, Ast::pos_at_line(line))), TokenKind.EqEq, pat.condition, Ast::pos_at_line(line))) if machine_expr_is_literal(pat.condition) else pat.condition

        def combine_machine_condition(existing: Ast::Expr, next: Ast::Expr, operator: TokenKind, line: u32) -> Ast::Expr:
            return next if machine_expr_is_invalid(existing) else (Ast::Expr.Binary(existing, operator, next, Ast::pos_at_line(line)))

        def machine_range_hi_operator(range: MachineRange) -> TokenKind:
            return TokenKind.LtEq if range.inclusive else TokenKind.Lt

        # docs/123 §5 per-state coverage, stage1-OWNED (docs/125 step 13). All three
        # refusals are parser-decidable (no types), 0-FP, and faithful to stage0's
        # parser/machine.go (~L518-561) — stage0 already accepts stage1's own machines and
        # runs these same checks, so a faithful port cannot regress self-hostable.

        # A payload list is unconditional when no element is a literal/predicate condition
        # (a condition is a non-wild, non-binding payload — mirrors machine_arm_condition).
        def machine_payloads_unconditional(arm: MachineArmAst&) -> bool:
            return not (any pat in arm.payloads where not pat.is_wild and pat.bind == "")

        # An arm matches EVERY input: an unguarded `_`/bind input with an unconditional
        # payload. Such an arm discharges a state's coverage.
        def machine_arm_irrefutable(arm: MachineArmAst&) -> bool:
            return arm.input_wild and machine_expr_is_invalid(arm.guard) and machine_payloads_unconditional(arm)

        # An open-domain literal (char/int/float/bool/string) — a state carrying one can
        # never be exhaustive without a final `_`, and the parser proves it without types.
        def machine_expr_open_domain(expression: Ast::Expr) -> bool:
            return match expression:
                Ast::Expr.IntLit(value): true
                Ast::Expr.FloatLit(text): true
                Ast::Expr.CharLit(text): true
                Ast::Expr.BoolLit(value): true
                Ast::Expr.StringLit(text): true
                Ast::Expr.Unary(operator, operand, _): machine_expr_open_domain(operand)
                Ast::Expr.Paren(inner, _): machine_expr_open_domain(inner)
                _: false

        def machine_arm_open_domain(arm: MachineArmAst&) -> bool:
            return not arm.input_wild and (arm.input_ranges.count > 0 or (any literal in arm.input_literals where machine_expr_open_domain(literal)))

        def machine_shorthand_equal(first: darray[sview], second: darray[sview]) -> bool:
            same: mutable bool = first.count == second.count
            machine over same for index in 0..<first.count:
                state Scan
                start Scan

                Scan, _ if index >= second.count:
                    -> Scan

                Scan, _ if first[index] != second[index]:
                    same <- false
                    -> Scan

                Scan, _:
                    -> Scan
            return same

        # Exact literal equality for the per-state duplicate-input check (0-FP: fires only
        # when the SAME literal is handled twice, never on possibly-overlapping forms).
        def machine_literal_equal(a: Ast::Expr, b: Ast::Expr) -> bool:
            match a:
                Ast::Expr.IntLit(a_value):
                    match b:
                        Ast::Expr.IntLit(b_value):
                            return a_value == b_value
                        _:
                            return false
                Ast::Expr.CharLit(a_text):
                    match b:
                        Ast::Expr.CharLit(b_text):
                            return when_text_equal(a_text, b_text)
                        _:
                            return false
                Ast::Expr.FloatLit(a_text):
                    match b:
                        Ast::Expr.FloatLit(b_text):
                            return when_text_equal(a_text, b_text)
                        _:
                            return false
                Ast::Expr.StringLit(a_text):
                    match b:
                        Ast::Expr.StringLit(b_text):
                            return when_text_equal(a_text, b_text)
                        _:
                            return false
                Ast::Expr.BoolLit(a_value):
                    match b:
                        Ast::Expr.BoolLit(b_value):
                            return a_value == b_value
                        _:
                            return false
                Ast::Expr.Unary(a_operator, a_operand, _):
                    match b:
                        Ast::Expr.Unary(b_operator, b_operand, _):
                            return a_operator == b_operator and machine_literal_equal(a_operand, b_operand)
                        _:
                            return false
                Ast::Expr.Paren(a_inner, _):
                    return machine_literal_equal(a_inner, b)
                Ast::Expr.Field(a_object, a_field, _):
                    match b:
                        Ast::Expr.Field(b_object, b_field, _):
                            a_object_name: sview = machine_expr_ident_name(a_object)
                            b_object_name: sview = machine_expr_ident_name(b_object)
                            return a_object_name != "" and a_object_name == b_object_name and a_field == b_field
                        _:
                            return false
                Ast::Expr.ShorthandMember(a_parts, _):
                    match b:
                        Ast::Expr.ShorthandMember(b_parts, _):
                            return machine_shorthand_equal(a_parts, b_parts)
                        _:
                            return false
                _:
                    return false
            return false

        # Per declared state: no arms is an error; an irrefutable arm before the last makes
        # the rest unreachable; an open-domain state with no irrefutable arm cannot be
        # total. Errors anchor at the machine head token.
        def check_machine_coverage(parser: lmut Parser, states: darray[MachineStateAst], arms: darray[MachineArmAst], machine_token: Token) -> void:
            state_index: mutable usize = 0
            while state_index < states.count |parser, state_index|:
                state_name: sview = states[state_index].name
                total_for_state: mutable usize = 0
                counting: mutable usize = 0
                while counting < arms.count |total_for_state, counting|:
                    total_for_state <- total_for_state + 1 if arms[counting].state_name == state_name
                    counting <- counting + 1
                has_wildcard: mutable bool = false
                has_open_domain: mutable bool = false
                seen: mutable usize = 0
                # Literal inputs already handled by an earlier unguarded, payload-
                # unconditional arm of this state — a repeat is unreachable (docs/123 §5).
                seen_literals: mutable darray[Ast::Expr] = []
                arm_index: mutable usize = 0
                while arm_index < arms.count |parser, has_wildcard, has_open_domain, seen, seen_literals, arm_index|:
                    if arms[arm_index].state_name == state_name:
                        seen <- seen + 1
                        if machine_arm_irrefutable(arms[arm_index]):
                            has_wildcard <- true
                            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, machine_token) if seen < total_for_state
                        has_open_domain <- true if machine_arm_open_domain(arms[arm_index])
                        # Only an unguarded, payload-unconditional arm claims exclusive
                        # coverage of a literal, so only those participate in the check.
                        if machine_expr_is_invalid(arms[arm_index].guard) and machine_payloads_unconditional(arms[arm_index]):
                            literal_index: mutable usize = 0
                            while literal_index < arms[arm_index].input_literals.count |parser, seen_literals, literal_index|:
                                literal: Ast::Expr = arms[arm_index].input_literals[literal_index]
                                duplicate: mutable bool = false
                                for previous in seen_literals:
                                    duplicate <- true if machine_literal_equal(previous, literal)
                                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, machine_token) if duplicate
                                seen_literals.push(literal) if not duplicate
                                literal_index <- literal_index + 1
                    arm_index <- arm_index + 1
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, machine_token) if total_for_state == 0
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, machine_token) if has_open_domain and not has_wildcard
                state_index <- state_index + 1

        # docs/125 §9 Tier-2: the classifier function name of a `machine over` input, or "" when
        # the input is not a bare free-function call (a method-call / char input is open-domain,
        # already handled by the parser's per-state coverage check).
        def machine_input_callee(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, call_line):
                    return machine_expr_ident_name(callee)
                _:
                    return ""

        # The variant name of a `Enum.Variant` or `.Variant` tag input, or "" for a literal /
        # range / non-tag input.
        def machine_arm_variant_tag(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Field(object, field, field_line):
                    return field
                Ast::Expr.ShorthandMember(parts, shorthand_line):
                    return parts[parts.count - 1] if parts.count > 0
                _:
                    return ""

        # Record MachineCoverageRow arm-atoms of a classifier-input machine (docs/125 §9 Tier-2):
        # one row per spelled variant tag + one wildcard-marker row per wildcard/bind arm.
        # Non-classifier inputs record nothing — open-domain totality is the parser's job.
        def record_machine_coverage(parser: lmut Parser, arms: darray[MachineArmAst], input_expression: Ast::Expr, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                input_callee: sview = machine_input_callee(input_expression)
                return if input_callee == ""
                machine over parser.machine_coverage for arm in arms:
                    state Scan
                    start Scan

                    Scan, _ if arm.input_wild:
                        parser.machine_coverage <- parser.machine_coverage.push(Ast::MachineCoverageRow{input_callee: input_callee, state_name: arm.state_name, tag: "", has_wildcard: true, line: line})
                        -> Scan

                    Scan, _:
                        parser <- parser.record_machine_literal_coverage(arm, input_callee, line)
                        -> Scan

        def record_machine_literal_coverage(parser: lmut Parser, arm: MachineArmAst, input_callee: sview, line: u32) -> void:
            machine over parser.machine_coverage for literal in arm.input_literals:
                state Scan
                start Scan

                Scan, _ if machine_arm_variant_tag(literal) == "":
                    -> Scan

                Scan, _:
                    parser.machine_coverage <- parser.machine_coverage.push(Ast::MachineCoverageRow{input_callee: input_callee, state_name: arm.state_name, tag: machine_arm_variant_tag(literal), has_wildcard: false, line: line})
                    -> Scan
