# Stage1 parser — enum variant blocks (`extend Parser: private:`). Covers the variant
# block, `common` clauses, payload fields (labeled and positional), and recursive-field
# detection. Continues parser_types_struct.elisa; split out to keep each part file under
# 600 lines.

extend Parser:
    private:
        # Parse the indented body of an enum: `(IDENT [ ( <field>, ... ) ] NEWLINE)*`.
        def enum_variant_block(parser: lmut Parser, enum_owner: sview) -> darray[Ast::EnumVariant]:
            parser.captured_enum_common_count <- 0
            parser, _ <- parser.expect(TokenKind.Colon)
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)

            variants: mutable darray[Ast::EnumVariant] = []
            common_fields: mutable darray[Ast::Expr] = []
            common_names: mutable darray[sview] = []
            # Seed with the ancestors' commons BEFORE this enum's own `common:` clause
            # appends — constructors then take root commons first, exactly the order
            # stage0's hierarchy inheritance produces.
            parser <- parser.inherit_enum_commons(enum_owner, common_fields, common_names)
            parser.captured_enum_variant_names <- parser.captured_enum_variant_names.truncate(0)
            parser.captured_enum_variant_field_starts <- parser.captured_enum_variant_field_starts.truncate(0)
            parser.captured_enum_variant_field_counts <- parser.captured_enum_variant_field_counts.truncate(0)
            parser.captured_enum_variant_fields <- parser.captured_enum_variant_fields.truncate(0)
            parser.captured_enum_variant_field_names <- parser.captured_enum_variant_field_names.truncate(0)
            while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser, variants|:
                parser <- parser.skip_newlines()
                break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof
                not_ident: bool = parser.peek() != TokenKind.Ident
                parser <- parser.advance_when(not_ident)
                continue if not_ident

                rebind variant_name: Token, parser = parser.expect(TokenKind.Ident)

                # `common:` fields are constructor payload prefix fields inherited by
                # every packed variant. Preserve them instead of discarding the block.
                is_common: bool = Lexer::text_or_empty(variant_name, parser.source) == "common" and parser.peek() == TokenKind.Colon
                parser <- parser.parse_common_clause(enum_owner, common_fields, common_names) if is_common
                continue if is_common

                field_items: mutable darray[Ast::Expr] = [common_field for common_field in common_fields]
                field_names: mutable darray[sview] = [common_name for common_name in common_names]

                rebind accepted_lparen_2: bool, parser = parser.accept(TokenKind.LParen)
                parser <- parser.parse_enum_payload_fields(field_items, field_names, enum_owner) if accepted_lparen_2

                # `Variant = VALUE` — a const-enum member's explicit integer value.
                variant_value: mutable Ast::Expr = (Ast::Expr.Absent)
                rebind accepted_value_assign: bool, parser = parser.accept(TokenKind.Assign)
                parser <- parser.capture_variant_value(variant_value) if accepted_value_assign
                variant: Ast::EnumVariant = Ast::EnumVariant{name: Lexer::text_or_empty(variant_name, parser.source), fields: field_items, field_names: field_names, value_expr: variant_value}
                parser.captured_enum_variant_names <- parser.captured_enum_variant_names.push(variant.name)
                parser.captured_enum_variant_field_starts <- parser.captured_enum_variant_field_starts.push(parser.captured_enum_variant_fields.count)
                parser.captured_enum_variant_field_counts <- parser.captured_enum_variant_field_counts.push(variant.fields.count)
                parser <- parser.append_enum_variant_fields(variant)
                variants.push(variant)
                parser, _ <- parser.accept(TokenKind.Newline)

            parser, _ <- parser.expect(TokenKind.Dedent)
            parser.captured_enum_common_count <- common_fields.count.u32()
            # Register this enum's FULL commons (inherited + own) so its own refinements
            # inherit transitively with a single registry hop.
            parser <- parser.register_enum_commons(enum_owner, common_fields, common_names)
            return variants


        # Prepend the transitive ancestor commons of `enum_owner` (docs/77 hierarchy
        # inheritance, stage0: inheritHierarchyCommonFields). The parent edge was pushed
        # into enum_annotations (line key 3900000008) before this body parses; the
        # registry row for the parent already carries the parent's OWN ancestors.
        def inherit_enum_commons(parser: lmut Parser, enum_owner: sview, fields: mutable darray[Ast::Expr]&, names: mutable darray[sview]&) -> void:
            return if enum_owner == ""
            parent: mutable sview = ""
            machine over parent for annotation in parser.enum_annotations:
                state Scan
                start Scan

                Scan, _ if annotation.owner == enum_owner and annotation.line == 3900000008:
                    parent <- annotation.name
                    -> Scan

                Scan, _:
                    -> Scan
            return if parent == ""
            registry_index: mutable usize = 0
            while registry_index < parser.enum_commons_owner.count |registry_index, parser, fields, names, parent|:
                if parser.enum_commons_owner[registry_index] == parent:
                    start: usize = parser.enum_commons_start[registry_index]
                    count: usize = parser.enum_commons_count[registry_index]
                    for offset in 0..<count |fields, names, parser, start|:
                        fields.push(parser.enum_commons_field[start + offset])
                        names.push(parser.enum_commons_name[start + offset])
                    return
                registry_index <- registry_index + 1


        def register_enum_commons(parser: lmut Parser, enum_owner: sview, fields: darray[Ast::Expr]&, names: darray[sview]&) -> void:
            return if enum_owner == "" or fields.count == 0
            parser.enum_commons_owner <- parser.enum_commons_owner.push(enum_owner)
            parser.enum_commons_start <- parser.enum_commons_start.push(parser.enum_commons_field.count)
            parser.enum_commons_count <- parser.enum_commons_count.push(fields.count)
            for field_index in 0..<fields.count |parser, fields, names|:
                parser.enum_commons_field <- parser.enum_commons_field.push(fields[field_index])
                parser.enum_commons_name <- parser.enum_commons_name.push(names[field_index])

        # `common:` shared-fields block, entered just after the consumed `common` name.
        # Keep the storage decorator in the parser's annotation side channel. The stage1 AST
        # intentionally keeps common fields as ordinary Expr/name rows, so throwing the
        # decorator away here made every dynamic AoS common look like a side-table field even
        # when the source explicitly requested `@storage(inline)`.
        def parse_common_clause(parser: lmut Parser, enum_owner: sview, fields: mutable darray[Ast::Expr]&, names: mutable darray[sview]&) -> void:
            parser, _ <- parser.expect(TokenKind.Colon)
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)
            pending_storage: mutable sview = ""
            while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser, fields, names, pending_storage, enum_owner|:
                parser <- parser.skip_newlines()
                break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof
                if parser.peek() == TokenKind.At:
                    rebind at_token: Token, parser = parser.advance()
                    rebind annotation_token: Token, parser = parser.expect(TokenKind.Ident)
                    parser, _ <- parser.expect(TokenKind.LParen)
                    rebind mode_token: Token, parser = parser.expect(TokenKind.Ident)
                    mode: sview = Lexer::text_or_empty(mode_token, parser.source)
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, mode_token) if mode != "inline" and mode != "side_table"
                    parser, _ <- parser.expect(TokenKind.RParen)
                    parser, _ <- parser.accept(TokenKind.Newline)
                    pending_storage <- mode
                    continue
                rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
                common_name: sview = Lexer::text_or_empty(name_token, parser.source)
                parser, _ <- parser.expect(TokenKind.Colon)
                rebind field_option: Ast::Expr?, parser = parser.expression()
                fields.push(field_value) if field_option is field_value
                names.push(common_name) if field_option is field_value
                if field_option is field_value and (pending_storage == "inline" or pending_storage == "side_table"):
                    # These sentinel line keys are compiler-internal metadata, not source
                    # locations. The backend resolves the owner through the hierarchy root and
                    # the field name through the common-name pool.
                    storage_line: u32 = 3900000088 if pending_storage == "inline" else 3900000089
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: enum_owner, name: common_name, line: storage_line})
                pending_storage <- ""
                parser, _ <- parser.accept(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Dedent)

        # Parse the comma-separated `(name: type, ...)` payload fields of an enum
        # variant, entered just past the accepted opening `(`.
        def record_recursive_field_ahead(parser: lmut Parser, enum_owner: sview) -> void:
            return if enum_owner == ""
            saved_position: usize = parser.position
            machine over parser.position while true:
                state Scan(depth: int)
                start Scan(0)

                Scan(depth), _ if parser.peek() == TokenKind.Eof or parser.peek() == TokenKind.Newline or (depth == 0 and (parser.peek() == TokenKind.Comma or parser.peek() == TokenKind.RParen)):
                    break

                Scan(depth), _ if parser.peek() == TokenKind.Ident:
                    token: Token = parser.cursor()
                    parser <- parser.record_recursive_field(enum_owner, token)
                    parser.position <- parser.position + 1
                    -> Scan(depth)

                Scan(depth), _ if parser.peek() == TokenKind.LParen or parser.peek() == TokenKind.LBracket:
                    parser.position <- parser.position + 1
                    -> Scan(depth + 1)

                Scan(depth), _ if parser.peek() == TokenKind.RParen or parser.peek() == TokenKind.RBracket:
                    parser.position <- parser.position + 1
                    -> Scan(depth - 1)

                Scan(depth), _:
                    parser.position <- parser.position + 1
                    -> Scan(depth)
            parser.position <- saved_position

        # A refinement's recursive child names an ANCESTOR, not itself: docs/77 writes
        # `enum Container is Widget:` with `Panel(first_child: Widget)`, so an
        # identity-only test never fired and a real recursive hierarchy (a widget tree, an
        # expression tree split into categories) was lowered as a flat enum instead of the
        # unified AoS store its handles require. Any field naming a member of the SAME
        # hierarchy is a recursive edge. For a flat enum the root of a name is that name,
        # so this reduces exactly to the previous identity test.
        def record_recursive_field(parser: lmut Parser, enum_owner: sview, token: Token) -> void:
            field_text: sview = Lexer::text_or_empty(token, parser.source)
            return if field_text == "" or enum_owner == ""
            same_hierarchy: bool = enum_hierarchy_root(parser, field_text) == enum_hierarchy_root(parser, enum_owner)
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: enum_owner, name: "__recursive_field", line: 3900000043}) if field_text == enum_owner or same_hierarchy

        def append_enum_variant_fields(parser: lmut Parser, variant: Ast::EnumVariant) -> void:
            saved_position: usize = parser.position
            parser.position <- 0
            machine over parser.position while parser.position < variant.fields.count:
                state Scan
                start Scan

                Scan, _:
                    parser.captured_enum_variant_fields <- parser.captured_enum_variant_fields.push(variant.fields[parser.position])
                    parser.captured_enum_variant_field_names <- parser.captured_enum_variant_field_names.push(variant.field_names[parser.position] if parser.position < variant.field_names.count else sview("", 0, 0))
                    parser.position <- parser.position + 1
                    -> Scan
            parser.position <- saved_position

        def parse_enum_payload_fields(parser: lmut Parser, field_items: mutable darray[Ast::Expr]&, field_names: mutable darray[sview]&, enum_owner: sview) -> void:
            machine over parser.position while true:
                state Field
                state Expression(field_name: sview)
                state Commit(field_name: sview, parsed: Ast::Expr?)
                state Separator
                start Field

                Field, _ if parser.peek() == TokenKind.RParen or parser.peek() == TokenKind.Eof:
                    break

                Field, _ if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon:
                    field_name_token: Token = parser.cursor()
                    parser.position <- parser.position + 2
                    -> Expression(Lexer::text_or_empty(field_name_token, parser.source))

                # `name?: type` marks an absent-allowed payload field; `?` belongs to
                # the label clause rather than to the parsed type expression.
                Field, _ if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Question and parser.peek_at(2) == TokenKind.Colon:
                    field_name_token: Token = parser.cursor()
                    parser.position <- parser.position + 3
                    -> Expression(Lexer::text_or_empty(field_name_token, parser.source))

                Field, _:
                    -> Expression(sview("", 0, 0))

                Expression(field_name), _:
                    parser <- parser.record_recursive_field_ahead(enum_owner)
                    rebind parsed_field: Ast::Expr?, parser = parser.expression()
                    -> Commit(field_name, parsed_field)

                Commit(field_name, parsed), _ if parsed is field_value:
                    field_items.push(field_value)
                    field_names.push(field_name)
                    -> Separator

                Commit(_, _), _:
                    -> Separator

                Separator, _ if parser.peek() == TokenKind.Comma:
                    parser.position <- parser.position + 1
                    -> Field

                Separator, _:
                    break
            parser, _ <- parser.expect(TokenKind.RParen)

        # `Variant = VALUE` explicit const-enum value, entered just past the accepted `=`.
        def capture_variant_value(parser: lmut Parser, variant_value: mutable Ast::Expr&) -> void:
            rebind parsed_value_opt: Ast::Expr?, parser = parser.expression()
            if parsed_value_opt is parsed_value:
                variant_value <- parsed_value
