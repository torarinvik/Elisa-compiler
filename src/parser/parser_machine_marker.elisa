# Exact prefix policy for the parser's internal machine-transition marker.
module ParserMachineMarker:
    public:
        @inline(always)
        def has_prefix(marker: sview) -> bool:
            ensure result == (sview_len(marker) >= 3 and sview_at(marker, 0) == 35 and sview_at(marker, 1) == 45 and sview_at(marker, 2) == 62)
            return sview_len(marker) >= 3 and sview_at(marker, 0) == 35 and sview_at(marker, 1) == 45 and sview_at(marker, 2) == 62

        @inline(always)
        def matches(marker: sview, target: sview) -> bool:
            false return if not has_prefix(marker)
            false return if sview_len(marker) != sview_len(target) + 3
            for index in 0..<sview_len(target):
                return false if sview_at(marker, index + 3) != sview_at(target, index)
            return true
