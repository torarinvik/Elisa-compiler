# Exact prefix policy for the parser's internal machine-transition marker.
module ParserMachineMarker:
    public:
        @inline(always)
        def has_prefix(marker: sview) -> bool:
            ensure result == (marker.len >= 3 and marker[0] == 35 and marker[1] == 45 and marker[2] == 62)
            return marker.len >= 3 and marker[0] == 35 and marker[1] == 45 and marker[2] == 62

        @inline(always)
        def matches(marker: sview, target: sview) -> bool:
            return false if:
                not has_prefix(marker)
                marker.len != target.len + 3
            for index in 0..<target.len:
                return false if marker[index + 3] != target[index]
            return true
