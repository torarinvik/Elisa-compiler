# Stage1 parser — expression parsing (`extend Parser: private:`). Covers primary/postfix/
# unary/binary expressions plus array/dict/brace literals. Split out of parser.elisa to
# keep each part file under 600 lines; see parser.elisa for the module overview.

extend Parser:
    private:
        # ============================================================
        # Expression parsing
        # Returns Expr? (opaque AST handle or null on error)
        # All allocations happen implicitly in inferred region
        # ============================================================

        # Decode an integer-literal token's source text to its i64 value. Handles decimal
        # and `0x`/`0X` hex, skips `_` digit separators, and stops at a type suffix (e.g.
        # `3u`). Value-dependent semantic checks (division-by-zero, array-literal arity) need
        # the real value; previously every IntLit was recorded as 0.
        def parse_int_literal_value(text: sview) -> i64:
            n: usize = sview_len(text)
            is_hex: bool = n >= 2 and sview_at(text, 0) == 48 and (sview_at(text, 1) == 120 or sview_at(text, 1) == 88)
            value: mutable i64 = 0
            i: mutable usize = 2 if is_hex else 0
            while i < n |value, i|:
                b: u8 = sview_at(text, i)
                if b == 95:
                    i <- i + 1
                    continue
                digit: mutable i64 = -1
                if b >= 48 and b <= 57:
                    digit <- (b - 48).i64()
                elif is_hex and b >= 97 and b <= 102:
                    digit <- (b - 97 + 10).i64()
                elif is_hex and b >= 65 and b <= 70:
                    digit <- (b - 65 + 10).i64()
                break if digit < 0
                base: i64 = 16 if is_hex else 10
                value <- value * base + digit
                i <- i + 1
            return value

        def primary_expression(parser: lmut Parser) -> Ast::Expr?:
            kind: TokenKind = parser.peek()
            token: Token = parser.cursor()
            no_expr: Ast::Expr? = null

            # One value-match over the token kind: every arm YIELDS the node; arms
            # that dispatch to a sub-parser or reject still return early. Return-position
            # (not bound to a local) so the arm allocations thread the caller's region.
            return match kind:
                TokenKind.Match:
                    # Expression-form `match EXPR: ...` (e.g. `return match x:` / `y = match x:`).
                    # Statement-position `match` is routed to match_statement by the statement
                    # dispatcher first; this handles `match` nested in an expression. Reuses
                    # the shared arm-block parser; arms carry statement bodies (as in the
                    # statement form), which the resolver's Expr.Match walker already handles.
                    rebind match_token: Token, parser = parser.advance()        # `match`
                    rebind match_scrutinee: Ast::Expr, parser = get parser.expression()
                    rebind accepted_as: bool, parser = parser.accept(TokenKind.As)
                    if accepted_as:
                        parser, _ <- parser.expect(TokenKind.Ident)
                    rebind match_arms: darray[Ast::MatchArm], parser = parser.parse_arm_block()
                    (Ast::Expr.Match(match_scrutinee, match_arms, match_token.line))

                # Decode the literal's value (decimal or hex) so value-dependent checks work.
                TokenKind.IntLit | TokenKind.HexLit:
                    literal_text: sview = Lexer::text_or_empty(token, parser.source)
                    parser, _ <- parser.advance()
                    (Ast::Expr.IntLit(parse_int_literal_value(literal_text)))

                TokenKind.FloatLit:
                    parser, _ <- parser.advance()
                    (Ast::Expr.FloatLit(Lexer::text_or_empty(token, parser.source)))

                TokenKind.CharLit:
                    parser, _ <- parser.advance()
                    (Ast::Expr.CharLit(Lexer::text_or_empty(token, parser.source)))

                TokenKind.StringLit:
                    parser, _ <- parser.advance()
                    (Ast::Expr.StringLit(Lexer::text_or_empty(token, parser.source)))

                TokenKind.FString:
                    parser, _ <- parser.advance()
                    rebind __v_55: Ast::Expr, parser = parser.fstring_expression(token)
                    __v_55

                TokenKind.Ident:
                    # `get EXPR else <recovery>` recovery form (contextual keyword): the
                    # guarded expression is the value; the `else` clause is a fallback
                    # expression or a control-flow statement (`else return null`).
                    head_text: sview = Lexer::text_or_empty(token, parser.source)
                    if head_text == "get":
                        rebind __ret_63: Ast::Expr?, parser = parser.get_expression()
                        return __ret_63
                    # `when SCRUT: …` decision table in expression position (docs/125 §4)
                    # — e.g. `x = when k:` / `return when c:`. Statement-position `when` is
                    # routed by the statement dispatcher first; this handles the nested
                    # expression form. Contextual gate mirrors the statement site.
                    if head_text == "when" and parser.when_construct_ahead():
                        rebind __ret_when_expr: Ast::Expr?, parser = parser.when_expression()
                        return __ret_when_expr
                    # `move EXPR` ownership transfer — the moved value is the expression;
                    # the move marker is consumed but not modeled.
                    if head_text == "move":
                        parser, _ <- parser.advance()
                        rebind __ret_68: Ast::Expr?, parser = parser.unary_expression()
                        return __ret_68
                    # `submit [pool] TASK(...)` pool/nursery task submission — the task
                    # call is the expression; the submit marker (and optional bracketed
                    # pool selector) is consumed. The task call is wrapped in a bare
                    # value-Block so statement checkers can tell a submitted call from a
                    # bare discarded call (the submission machinery consumes the result);
                    # the Block is value-transparent to resolution and typing.
                    if head_text == "submit" and parser.peek_at(1) in {TokenKind.Ident, TokenKind.LBracket}:
                        parser, _ <- parser.advance()
                        rebind accepted_lbracket: bool, parser = parser.accept(TokenKind.LBracket)
                        if accepted_lbracket:
                            parser, _ <- parser.expression()              # pool/region selector (consumed)
                            parser, _ <- parser.expect(TokenKind.RBracket)
                        rebind __ret_79: Ast::Expr?, parser = parser.unary_expression()
                        if __ret_79 is submitted_task:
                            return (Ast::Expr.Block([], submitted_task, [], token.line))
                        return __ret_79
                    # Query/quantifier expression `KW VAR[, VAR]* in ITER [where COND]` —
                    # the full stage0 family: any/all (bool), first/count/sum/product/
                    # min/max (fold values), each (side-effect). Contextual keywords —
                    # `count`/`first`/`min`/… are common identifiers, so only the exact
                    # `VAR(, VAR)* in` shape after the keyword selects the query form.
                    if is_query_keyword(head_text) and parser.looks_like_query_expression():
                        rebind __ret_86: Ast::Expr?, parser = parser.quantifier_expression()
                        return __ret_86
                    # Verification quantifier `forall|exists VAR in ITER: PRED` (contextual
                    # keywords, `invariant`/`law` predicate spelling — colon body instead of
                    # `where`). Same disambiguation shape as any/all; reuses the Comprehension
                    # node since the quantifier semantics (var/iterable/condition) are identical.
                    if (head_text == "forall" or head_text == "exists") and parser.peek_at(1) == TokenKind.Ident and parser.peek_at(2) == TokenKind.In:
                        rebind __ret_92: Ast::Expr?, parser = parser.forall_exists_expression()
                        return __ret_92
                    # Anonymous function `fn(...) => EXPR` / `fn(...): BLOCK` (params are
                    # always parenthesized — mirrors a function's shape; also any Unicode
                    # lambda letter). Contextual — `fn` is a very common variable name, so
                    # only when the lambda signature is actually followed by `:` or `=>`
                    # (a bare `fn(x)` call / `fn` reference is not).
                    if is_lambda_keyword(head_text):
                        rebind __c_lam: bool, parser = parser.looks_like_lambda()
                        if __c_lam:
                            rebind __ret_99: Ast::Expr?, parser = parser.lambda_expression()
                            return __ret_99
                    # Removed shorthand lambda params `fn x: x` / `λ a, b: expression` (params
                    # are always parenthesized now — bd208ae). Left unflagged, `fn` falls
                    # through to being parsed as a bare Ident and the orphaned `x: x` gets
                    # silently reinterpreted as a brand-new statement (0 errors, 2 stmts).
                    # Only fires on the exact removed shape (`IDENT (, IDENT)* COLON`
                    # directly after the keyword) so a bare `fn` reference / `fn(x)` call
                    # is untouched.
                    if is_lambda_keyword(head_text):
                        rebind __c_rsl: bool, parser = parser.looks_like_removed_shorthand_lambda()
                        if __c_rsl:
                            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token)
                            parser, _ <- parser.advance()
                            return null
                    parser, _ <- parser.advance()
                    (Ast::Expr.Ident(head_text, token.line))

                TokenKind.True | TokenKind.False:
                    parser, _ <- parser.advance()
                    (Ast::Expr.BoolLit(kind == TokenKind.True))

                # Leaf keywords recorded as identifier nodes: `null` (no dedicated Null
                # node yet), `sizeof`/`alignof`/`offsetof` (the following `(...)` is
                # consumed by the postfix Call rule), `panic`/`raise` (operand consumed
                # by the postfix/unary rules), and `zeroed`.
                TokenKind.Null | TokenKind.Sizeof | TokenKind.Alignof | TokenKind.Offsetof | TokenKind.Panic | TokenKind.Raise | TokenKind.Zeroed:
                    parser, _ <- parser.advance()
                    (Ast::Expr.Ident(Lexer::text_or_empty(token, parser.source), token.line))

                TokenKind.New:
                    # `new [region] Type(...)`: skip the keyword and optional region
                    # bracket, then parse the constructor expression as the value.
                    parser, _ <- parser.advance()
                    rebind accepted_lbracket_2: bool, parser = parser.accept(TokenKind.LBracket)
                    if accepted_lbracket_2:
                        while parser.peek() != TokenKind.RBracket and parser.peek() != TokenKind.Eof:
                            parser, _ <- parser.advance()
                        parser, _ <- parser.accept(TokenKind.RBracket)
                    rebind __v_141: Ast::Expr?, parser = parser.postfix_expression()
                    __v_141

                TokenKind.LParen:
                    parser, _ <- parser.advance()
                    # `()` unit tuple.
                    if parser.peek() == TokenKind.RParen:
                        parser, _ <- parser.advance()
                        return (Ast::Expr.Tuple([], token.line))
                    # `(name: T, …)` named-tuple TYPE (e.g. a multi-value return type
                    # `-> (stmt_count: usize, checksum: i64)`). The element labels are
                    # selectors, not values — `(x: 1)` is never a value expression — so
                    # a leading `IDENT :` inside parens selects the labeled-tuple form;
                    # each label is consumed and only the element types are kept.
                    if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon:
                        named_elements: mutable darray[Ast::Expr] = []
                        while parser.peek() != TokenKind.RParen and parser.peek() != TokenKind.Eof |parser, named_elements|:
                            if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon:
                                parser, _ <- parser.advance()           # element label
                                parser, _ <- parser.advance()           # `:`
                            rebind named_element_opt: Ast::Expr?, parser = parser.expression()
                            if named_element_opt is named_element:
                                named_elements.push(named_element)
                            rebind accepted_comma: bool, parser = parser.accept(TokenKind.Comma)
                            if not accepted_comma:
                                break
                        parser, _ <- parser.expect(TokenKind.RParen)
                        return (Ast::Expr.Tuple(named_elements, token.line))
                    rebind paren_first_raw: Ast::Expr, parser = get parser.expression()
                    rebind paren_first: Ast::Expr, parser = parser.consume_removed_as_cast(paren_first_raw)
                    # `(a, b, …)` tuple (value or type position); a single `(x)` is grouping.
                    if parser.peek() == TokenKind.Comma:
                        tuple_elements: mutable darray[Ast::Expr] = [paren_first]
                        while parser.accept(TokenKind.Comma) |parser|:
                            break if parser.peek() == TokenKind.RParen
                            rebind tuple_element_opt: Ast::Expr?, parser = parser.expression()
                            if tuple_element_opt is tuple_element:
                                tuple_elements.push(tuple_element)
                        parser, _ <- parser.expect(TokenKind.RParen)
                        return (Ast::Expr.Tuple(tuple_elements, token.line))
                    parser, _ <- parser.expect(TokenKind.RParen)
                    paren_first

                TokenKind.LBracket:
                    rebind __v_184: Ast::Expr?, parser = parser.array_literal()
                    __v_184

                TokenKind.LBrace:
                    rebind __v_187: Ast::Expr?, parser = parser.brace_literal()
                    __v_187

                TokenKind.Dot:
                    # Leading-dot enum shorthand `.Variant` / `.A.B` — the enclosing enum
                    # type is inferred from context. Consume the whole `.Ident(.Ident)*`
                    # chain here; a following call/index is handled by the postfix rule.
                    parser, _ <- parser.advance()                       # leading `.`
                    parts: mutable darray[sview] = []
                    rebind first_part: Token, parser = parser.expect(TokenKind.Ident)
                    parts.push(Lexer::text_or_empty(first_part, parser.source))
                    while parser.accept(TokenKind.Dot) |parser|:
                        rebind next_part: Token, parser = parser.expect(TokenKind.Ident)
                        parts.push(Lexer::text_or_empty(next_part, parser.source))
                    (Ast::Expr.ShorthandMember(parts, token.line))

                TokenKind.Try:
                    # `try EXPR else <recovery>` inline recovery expression — same shape
                    # as `get …`; the guarded expression is the value.
                    rebind __v_205: Ast::Expr?, parser = parser.get_expression()
                    __v_205

                TokenKind.Catch:
                    # `catch EXPR:` fallible expression with success/error arms
                    # (`return catch self.foo(...):`). The guarded expression is the
                    # value; the `:` arm block is parsed and consumed. (Statement-position
                    # `catch:` is handled earlier in statement(); this is the expression form.)
                    parser, _ <- parser.advance()                       # `catch`
                    rebind guarded: Ast::Expr, parser = get parser.expression()
                    if parser.peek() == TokenKind.Colon:
                        parser, _ <- parser.parse_catch_arm_block(token)
                    guarded

                _:
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token)
                    parser, _ <- parser.advance()   # consume the offending token so callers don't re-error on it
                    no_expr
