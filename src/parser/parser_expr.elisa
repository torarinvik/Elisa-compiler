# Stage1 parser — expression parsing (`extend Parser: private:`). Covers primary/postfix/
# unary/binary expressions plus array/dict/brace literals. Split out of parser.elisa to
# keep each part file under 600 lines; see parser.elisa for the module overview.
include "./parser_numeric_literal_sort.elisa"
include "./parser_numeric_suffix.elisa"
include "./parser_integer_literal.elisa"

extend Parser:
    private:
        # ============================================================
        # Expression parsing
        # Returns Expr? (opaque AST handle or null on error)
        # All allocations happen implicitly in inferred region
        # ============================================================

        # `new[store] Enum.Variant(...)` is lowered through a RegionNew wrapper, while the
        # packed-constructor backend later sees only the inner call. When the operand is a
        # call through a field/scope (possibly parenthesized), keep the selector marker at
        # that callee position so same-line allocations can choose different stores. Other
        # expression shapes retain the `new` token position.
        def new_region_use_position(expression: Ast::Expr, fallback: Ast::Pos) -> Ast::Pos:
            match expression:
                Expr.Call(callee, arguments, argument_names, call_pos):
                    match callee:
                        Expr.Field(_, _, field_pos) | Expr.Scope(_, _, field_pos):
                            return field_pos
                        Expr.Paren(inner, _):
                            return new_region_use_position(inner, fallback)
                        _:
                            pass
                Expr.Paren(inner, _):
                    return new_region_use_position(inner, fallback)
                _:
                    pass
            return fallback


        # `new` is erased from the expression tree. Keep its marker at the exact AST node
        # consumers inspect (the call or array node), unwrapping only transparent parentheses
        # and nested RegionNew wrappers. The keyword position cannot identify that node.
        def new_construct_target_position(expression: Ast::Expr) -> Ast::Pos:
            match expression:
                Expr.Paren(inner, _):
                    return new_construct_target_position(inner)
                Expr.RegionNew(inner, _, _):
                    return new_construct_target_position(inner)
                _:
                    return Ast::expr_pos(expression)

        def primary_literal(parser: lmut Parser, kind: TokenKind, token: Token) -> Ast::Expr?:
            # Literal parsing is a closed token-kind table. A match keeps each token's
            # side effects adjacent to its construction and avoids a fall-through chain of
            # independent predicates that repeatedly tests the same discriminant.
            match kind:
                TokenKind.IntLit | TokenKind.HexLit:
                    literal_text: sview = Lexer::text_or_empty(token, parser.source, parser.source_length)
                    parser <- parser.record_numeric_suffix(token)
                    parser <- parser.record_numeric_literal_value(token)
                    parser, _ <- parser.advance()
                    return (Ast::Expr.IntLit(parse_int_literal_value(literal_text), Ast::pos_of_token(token)))
                TokenKind.FloatLit:
                    parser <- parser.record_numeric_suffix(token)
                    parser, _ <- parser.advance()
                    return (Ast::Expr.FloatLit(Lexer::text_or_empty(token, parser.source, parser.source_length), Ast::pos_of_token(token)))
                TokenKind.CharLit:
                    parser, _ <- parser.advance()
                    return (Ast::Expr.CharLit(Lexer::text_or_empty(token, parser.source, parser.source_length), Ast::pos_of_quoted_token(token)))
                TokenKind.StringLit:
                    parser, _ <- parser.advance()
                    return (Ast::Expr.StringLit(Lexer::text_or_empty(token, parser.source, parser.source_length), Ast::pos_of_quoted_token(token)))
                TokenKind.FString:
                    parser, _ <- parser.advance()
                    rebind fstring: Ast::Expr, parser = parser.fstring_expression(token) can Global{Read,Write}
                    return fstring
                _:
                    return null

        def parenthesized_expression(parser: lmut Parser, token: Token) -> Ast::Expr?:
            parser, _ <- parser.advance()
            if parser.peek() == TokenKind.RParen:
                parser, _ <- parser.advance()
                return (Ast::Expr.Tuple([], Ast::pos_of_token(token)))
            if parser.fold_binding_ahead():
                rebind bound_fold: Ast::Expr, parser = parser.bound_fold_expression(token) can Global{Read,Write}
                return bound_fold
            group_head: Token = parser.cursor()
            is_do_block: bool = parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon and Lexer::text_or_empty(group_head, parser.source, parser.source_length) == "do"
            if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon and not is_do_block:
                named_elements: mutable darray[Ast::Expr] @source = []
                machine over parser.position while true:
                    state Element
                    state Expression
                    state Commit(candidate: Ast::Expr?)
                    state Separator
                    start Element

                    Element, _ if parser.peek() == TokenKind.RParen or parser.peek() == TokenKind.Eof:
                        break

                    Element, _ if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon:
                        tuple_label_token: Token = parser.cursor()
                        tuple_label_row: Ast::EnumAnnotation = Ast::EnumAnnotation{owner: "__tuple_label", name: Lexer::text_or_empty(tuple_label_token, parser.source, parser.source_length), line: tuple_label_token.line, offset: tuple_label_token.start}
                        parser.enum_annotations <- parser.enum_annotations.push(tuple_label_row)
                        parser.tuple_label_annotations <- parser.tuple_label_annotations.push(tuple_label_row)
                        parser.position <- parser.position + 2
                        -> Expression

                    Element, _:
                        -> Expression

                    Expression, _:
                        rebind parsed_candidate: Ast::Expr?, parser = parser.expression() can Global{Read,Write}
                        -> Commit(parsed_candidate)

                    Commit(candidate), _ if candidate is named_element:
                        named_elements.push(named_element)
                        -> Separator

                    Commit(_), _:
                        -> Separator

                    # A region suffix on a named tuple TYPE field (`(name: sview @source)`):
                    # the region is not modelled on tuple fields, so it is consumed.
                    Separator, _ if parser.peek() == TokenKind.At and parser.peek_at(1) == TokenKind.Ident:
                        parser.position <- parser.position + 2
                        -> Separator

                    Separator, _ if parser.peek() == TokenKind.Comma:
                        parser.position <- parser.position + 1
                        -> Element

                    Separator, _:
                        break
                parser, _ <- parser.expect(TokenKind.RParen)
                return (Ast::Expr.Tuple(named_elements, Ast::pos_of_token(token)))
            previous_where_group: bool = parser.in_where_group
            parser.in_where_group <- true
            previous_conditional_guard: bool = parser.in_conditional_guard
            parser.in_conditional_guard <- false
            paren_first_raw: mutable Ast::Expr = (Ast::Expr.Invalid)
            if parser.in_contract:
                rebind contract_group: Ast::Expr, parser = parser.contract_expression() can Global{Read,Write}
                paren_first_raw <- contract_group
            else:
                rebind paren_first_opt: Ast::Expr?, parser = parser.expression() can Global{Read,Write}
                paren_first_raw <- get paren_first_opt else (Ast::Expr.Invalid)
            parser.in_where_group <- previous_where_group
            parser.in_conditional_guard <- previous_conditional_guard
            rebind paren_first: Ast::Expr, parser = parser.consume_removed_as_cast(paren_first_raw) can Global{Read,Write}
            fold_for_token: Token = parser.cursor()
            if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(fold_for_token, parser.source, parser.source_length) == "for":
                fold_bindings: mutable darray[Ast::Stmt] @source = []
                rebind fold_expression: Ast::Expr, parser = parser.finish_fold_expression(token, paren_first, fold_bindings) can Global{Read,Write}
                return fold_expression
            parser <- parser.reject_guardless_conditional(paren_first)
            if parser.peek() == TokenKind.Comma:
                tuple_elements: mutable darray[Ast::Expr] @source = [paren_first]
                # The machine must keep running through the Element state after consuming
                # the comma; a header guard on `peek() == Comma` would stop before parsing
                # that element. Terminate explicitly from More instead.
                machine over parser.position while true:
                    state More
                    state Element
                    start More

                    More, _ if parser.peek() != TokenKind.Comma:
                        break

                    More, _:
                        parser.position <- parser.position + 1
                        -> Element

                    Element, _ if parser.peek() == TokenKind.RParen:
                        break

                    Element, _:
                        rebind tuple_element_opt: Ast::Expr?, parser = parser.expression() can Global{Read,Write}
                        tuple_element: Ast::Expr = get tuple_element_opt else (Ast::Expr.Invalid)
                        parser <- parser.reject_guardless_conditional(tuple_element)
                        tuple_elements.push(tuple_element)
                        -> More
                parser, _ <- parser.expect(TokenKind.RParen)
                return (Ast::Expr.Tuple(tuple_elements, Ast::pos_of_token(token)))
            parser, _ <- parser.expect(TokenKind.RParen)
            # Preserve the outer source location for an indexed method receiver
            # without changing the expression shape consumed by code generation.
            if parser.peek() == TokenKind.Dot:
                match paren_first:
                    Expr.Index(_, _, _) | Expr.IndexN(_, _, _):
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__parenthesized_receiver", name: "", line: Ast::expr_pos(paren_first).line, offset: Ast::expr_pos(paren_first).offset, pos: Ast::pos_of_token(token)})
                    _:
                        pass
            # Keep grouped method callees at the call boundary: `(value.cstr)()`
            # is ordinary UFCS, whereas `value.cstr()` is a target conversion.
            # Other compile-path groups retain the existing erased representation.
            if parser.peek() == TokenKind.LParen:
                match paren_first:
                    Expr.Field(_, _, _):
                        return (Ast::Expr.Paren(paren_first, Ast::pos_of_token(token)))
                    Expr.Paren(_, _):
                        return (Ast::Expr.Paren(paren_first, Ast::pos_of_token(token)))
                    Expr.Unary(TokenKind.Question, Expr.Field(_, _, _), _):
                        return (Ast::Expr.Paren(paren_first, Ast::pos_of_token(token)))
                    _:
                        pass
            return (Ast::Expr.Paren(paren_first, Ast::pos_of_token(token))) if parser.preserve_parens
            return paren_first

        # A ternary in a NESTED position must carry its `else`. stage0 parses the else-less
        # form ONLY as a statement-tail postfix guard (`total <- v if c`, `EXPR if c`,
        # `break v if c`); as a sub-expression it is "expected else, got X" -- measured for
        # `(1 if c)`, `take(1 if c)`, `[1 if c, 2]` and `1 if c else (2 if d)`. stage1's
        # lenient parse leaves an Absent alternative, and the statement layer then read a
        # PARENTHESISED one as a guard: `break (1 if i > 2)` inside a value loop became
        # `if i > 2: break 1` instead of an error (stage0's TestBreakValueTernaryAndGuardCompose
        # pins exactly that). Call this on any sub-expression a closing delimiter follows.
        def reject_guardless_conditional(parser: lmut Parser, parsed: Ast::Expr) -> void:
            match parsed:
                Expr.If(condition, selected, Expr.Absent, if_pos):
                    parser <- parser.error_at(Ast::ParseErrorKind.ExpectedToken, parser.cursor())
                _:
                    pass

        def primary_identifier(parser: lmut Parser, token: Token) -> Ast::Expr?:
            # `get EXPR else <recovery>` recovery form (contextual keyword): the
            # guarded expression is the value; the `else` clause is a fallback
            # expression or a control-flow statement (`else return null`).
            head_text: sview = Lexer::text_or_empty(token, parser.source, parser.source_length)
            # Legacy `do:` value block. Stage0 still accepts this spelling
            # (with a deprecation notice); lower it to the canonical bare
            # Expr.Block so every expression position shares one AST shape.
            if head_text == "do" and parser.peek_at(1) == TokenKind.Colon:
                parser, _ <- parser.advance()
                parser, _ <- parser.advance()
                rebind do_block: Ast::Expr, parser = parser.parse_bare_block_value() can Global{Read,Write}
                return do_block
            # Removed spellings are contextual identifiers everywhere else, but
            # their former expression/type shapes receive a parser diagnostic.
            # The removed `lambda` spelling. stage0 parses the lambda anyway and reports each
            # removed piece once — the keyword, unparenthesized params, and an inline `: EXPR`
            # body — so all three sentences land on the lambda's own line instead of one bare
            # "unexpected token".
            if head_text == "lambda" and (parser.peek_at(1) == TokenKind.Ident or parser.peek_at(1) == TokenKind.LParen):
                parser <- parser.error_removed(token, "the `lambda` keyword has been removed; use `fn` (or a Unicode lambda letter `λ`)")
                parser, _ <- parser.advance()                       # the `lambda` keyword
                if parser.peek() == TokenKind.LParen:
                    lambda_paren_depth: mutable int = 0
                    while parser.peek() != TokenKind.Eof |parser, lambda_paren_depth|:
                        lambda_paren_depth <- lambda_paren_depth + 1 if parser.peek() == TokenKind.LParen
                        lambda_paren_depth <- lambda_paren_depth - 1 if parser.peek() == TokenKind.RParen
                        parser, _ <- parser.advance()
                        break if lambda_paren_depth == 0
                else:
                    shorthand_params_token: Token = parser.cursor()
                    parser <- parser.error_removed(shorthand_params_token, "shorthand lambda parameters have been removed; parenthesize them: `fn(a, b) => …`")
                    parser, _ <- parser.advance() if parser.peek() == TokenKind.Ident
                    while parser.peek() == TokenKind.Comma and parser.peek_at(1) == TokenKind.Ident |parser|:
                        parser, _ <- parser.advance()
                        parser, _ <- parser.advance()
                if parser.peek() == TokenKind.Colon and parser.peek_at(1) != TokenKind.Newline:
                    inline_body_token: Token = parser.cursor()
                    parser <- parser.error_removed(inline_body_token, "an inline `: EXPR` lambda body has been removed; use `=> EXPR` for an expression body (or `:` with an indented block)")
                parser <- parser.skip_removed_line()
                return (Ast::Expr.Ident(head_text, Ast::pos_of_token(token)))
            # `rewrite EXPR as sequence[T]:` (docs/81). Contextual like `cascade`, so the claim
            # needs the `as` that follows on the same line; stage0 reports it once and consumes
            # the whole construct, arms included.
            if head_text == "rewrite" and parser.rewrite_as_ahead():
                parser <- parser.error_removed(token, "`rewrite … as sequence[T]:` has been removed; build the result explicitly with a `darray[T] = []` and a `for` loop that `.push(…)`es each element (`emit all` → an inner push loop)")
                parser <- parser.skip_removed_construct()
                return (Ast::Expr.Ident(head_text, Ast::pos_of_token(token)))
            parser <- parser.error_removed(token, "the `func` type keyword has been renamed to `fn`; write `fn(...) -> T`") if head_text == "func" and parser.peek_at(1) == TokenKind.LParen
            # The `cascade EXPR => …` EXPRESSION (the statement head is refused in
            # parser_stmt_contextual). `cascade` is an ordinary identifier elsewhere, so the
            # claim needs the whole shape: a receiver ident and the `=>` that followed it.
            if head_text == "cascade" and parser.peek_at(1) == TokenKind.Ident and parser.peek_at(2) == TokenKind.FatArrow:
                parser <- parser.error_removed(token, "the `cascade` expression has been removed")
                parser <- parser.skip_removed_line()
                return (Ast::Expr.Ident(head_text, Ast::pos_of_token(token)))
            # `get EXPR else …` — contextual, so the gate mirrors stage0's: the
            # next token must be an IDENT. Ungated, `get(40)` consumed the `get`
            # and parsed `(40)` as the guarded expression, so the CALL NODE
            # vanished and `def get(...)` became uncallable — silently, since the
            # residue is a well-formed expression (`get(1, 2, 3)` misparsed to a
            # tuple rather than erroring).
            if head_text == "get" and parser.peek_at(1) == TokenKind.Ident:
                rebind __ret_63: Ast::Expr?, parser = parser.get_expression() can Global{Read,Write}
                return __ret_63
            # `when SCRUT: …` decision table in expression position (docs/125 §4)
            # — e.g. `x = when k:` / `return when c:`. Statement-position `when` is
            # routed by the statement dispatcher first; this handles the nested
            # expression form. Contextual gate mirrors the statement site.
            if head_text == "when" and parser.when_construct_ahead():
                rebind __ret_when_expr: Ast::Expr?, parser = parser.when_expression() can Global{Read,Write}
                return __ret_when_expr
            # `machine from START:` state-machine expression (docs/125 §5) — e.g.
            # `kind: TokenKind = machine from Num.Integer:`. Statement-position
            # `machine over` is routed first (it checks `over`); the `from` form
            # reaches here as an expression.
            if head_text == "machine" and parser.machine_from_ahead():
                rebind __ret_mf_expr: Ast::Expr?, parser = parser.machine_from_expression() can Global{Read,Write}
                return __ret_mf_expr
            if head_text == "start" and parser.start_machine_ahead():
                rebind __ret_start_expr: Ast::Expr?, parser = parser.start_machine_expression() can Global{Read,Write}
                return __ret_start_expr
            # `move EXPR` ownership transfer. Retain the marker so semantic
            # ownership flow can distinguish a transfer from an ordinary use.
            if head_text == "move":
                parser, _ <- parser.advance()
                rebind __ret_68: Ast::Expr?, parser = parser.unary_expression() can Global{Read,Write}, Memory.Allocate
                if __ret_68 is moved_value:
                    return (Ast::Expr.Move(moved_value, Ast::pos_of_token(token)))
                return __ret_68
            # `new [region] Type(...)` is contextual in stage0 even though the
            # legacy token slot remains reserved. Lower it to the constructor
            # expression itself, exactly like the TokenKind.New compatibility arm.
            if head_text == "new" and (parser.peek_at(1) == TokenKind.Ident or parser.peek_at(1) == TokenKind.LBracket):
                parser, _ <- parser.advance()
                new_region_name: mutable sview = sview("", 0, 0)
                new_auto_form: mutable bool = false
                rebind accepted_new_region: bool, parser = parser.accept(TokenKind.LBracket)
                if accepted_new_region:
                    # `new[auto] T(...)` is the deprecated explicit auto-region form
                    # (superseded by bare `new`, which infers the region). Record it
                    # so the semantic pass can emit the deprecation.
                    region_token: Token = parser.cursor()
                    region_selector: sview = Lexer::text_or_empty(region_token, parser.source, parser.source_length)
                    new_auto_form <- parser.peek() == TokenKind.Ident and region_selector == "auto"
                    new_region_name <- region_selector if parser.peek() == TokenKind.Ident and region_selector != "auto"
                    machine over parser.position while true:
                        state Scan
                        start Scan

                        Scan, _ if parser.peek() == TokenKind.RBracket or parser.peek() == TokenKind.Eof:
                            break

                        Scan, _:
                            parser.position <- parser.position + 1
                            -> Scan
                    parser, _ <- parser.accept(TokenKind.RBracket)
                # A NAMED region (`new[scratch] …`) allocates in that region and yields a
                # ref to the allocation, so the wrapper has to survive to the backend.
                # Bare `new` and `new[auto]` keep the historical transparent lowering —
                # their region is inferred, and erasing them changes no observable value.
                if new_region_name != "":
                    # `new` binds LOOSER than the arithmetic operators: stage0 allocates the
                    # whole of `new[scratch] seed + 1` (its IR adds first, then allocates and
                    # stores the sum). Parsing only the postfix operand would instead build
                    # `RegionNew(seed) + 1` -- pointer arithmetic on the allocation.
                    rebind region_new_operand: Ast::Expr?, parser = parser.expression() can Global{Read,Write}
                    if region_new_operand is region_new_allocated:
                        new_construct_pos: Ast::Pos = new_construct_target_position(region_new_allocated)
                        parser <- parser.record_new_construct(new_construct_pos)
                        region_use_position: Ast::Pos = new_region_use_position(region_new_allocated, Ast::pos_of_token(token))
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: new_region_name, name: "__region_use", line: region_use_position.line, offset: region_use_position.offset})
                        return (Ast::Expr.RegionNew(region_new_allocated, new_region_name, Ast::pos_of_token(token)))
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: new_region_name, name: "__region_use", line: token.line, offset: token.start})
                    return region_new_operand
                rebind contextual_new: Ast::Expr?, parser = parser.postfix_expression() can Global{Read,Write}, Memory.Allocate
                if contextual_new is new_construct_operand:
                    new_construct_pos: Ast::Pos = new_construct_target_position(new_construct_operand)
                    parser <- parser.record_new_construct(new_construct_pos)
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__new_auto", name: "__new_auto", line: token.line, offset: token.start}) if new_auto_form
                return contextual_new
            # Ownership/concurrency value wrappers are semantically transparent
            # to name/type resolution: retain and walk their operand instead of
            # leaving the contextual keyword as an undefined identifier.
            if (head_text == "freeze" or head_text == "await") and tokenStartsValue(parser.peek_at(1)):
                parser, _ <- parser.advance()
                rebind wrapped_value: Ast::Expr?, parser = parser.unary_expression() can Global{Read,Write}, Memory.Allocate
                if head_text == "await" and wrapped_value is awaited_value:
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__await", name: "__await", line: token.line, offset: token.start})
                    return (Ast::Expr.Block([], awaited_value, [], Ast::pos_of_token(token)))
                return wrapped_value
            # `submit [pool] TASK(...)` pool/nursery task submission — the task
            # call is the expression; the submit marker (and optional bracketed
            # pool selector) is consumed. The task call is wrapped in a bare
            # value-Block so statement checkers can tell a submitted call from a
            # bare discarded call (the submission machinery consumes the result);
            # the Block is value-transparent to resolution and typing.
            if head_text == "submit" and (parser.peek_at(1) == TokenKind.Ident or parser.peek_at(1) == TokenKind.LBracket):
                explicit_pool: bool = parser.peek_at(1) == TokenKind.LBracket
                parser <- parser.error_at(Ast::ParseErrorKind.SubmitOutsidePool, token) if parser.active_pool_depth == 0 and not explicit_pool
                parser, _ <- parser.advance()
                rebind accepted_lbracket: bool, parser = parser.accept(TokenKind.LBracket)
                if accepted_lbracket:
                    # `submit[pool] f(x)` — the selector NAMES the pool to submit to. It used to
                    # be consumed and dropped, so the backend could not tell which pool and the
                    # explicit form declined while the implicit one worked. Record the submit
                    # token offset: line-keyed selectors alias when two submissions share a line.
                    if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.RBracket:
                        rebind submit_pool_token: Token, parser = parser.advance()
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: Lexer::text_or_empty(submit_pool_token, parser.source, parser.source_length), name: "__submit_pool", line: token.line, offset: token.start})
                    else:
                        parser, _ <- parser.expression() can Global{Read,Write}          # a non-name selector is dropped, as before
                    parser, _ <- parser.expect(TokenKind.RBracket)
                rebind __ret_79: Ast::Expr?, parser = parser.unary_expression() can Global{Read,Write}, Memory.Allocate
                if __ret_79 is submitted_task:
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__submit", name: "__submit", line: token.line, offset: token.start})
                    return (Ast::Expr.Block([], submitted_task, [], Ast::pos_of_token(token)))
                return __ret_79
            # Query/quantifier expression `KW VAR[, VAR]* in ITER [where COND]` —
            # the full stage0 family: any/all (bool), first/count/sum/product/
            # min/max (fold values), each (side-effect). Contextual keywords —
            # `count`/`first`/`min`/… are common identifiers, so only the exact
            # `VAR(, VAR)* in` shape after the keyword selects the query form.
            if is_query_keyword(head_text) and parser.looks_like_query_expression():
                # Record WHICH query keyword this is. Expr.Comprehension keeps the binder,
                # iterable, condition, body, diagnostic position, and scope ID, but not the
                # head keyword — so the backend could not tell `count` from `sum`/`min`/`max`
                # and treated every empty-body form as `any`. The marker uses this head token's
                # offset in the side table, like `__submit`/`__await`; the `__query_` prefix
                # keeps it distinct from a fn-type return head.
                query_head_storage: mutable darray[u8] = []
                _ = query_head_storage
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__query", name: head_text, line: token.line, offset: token.start})
                rebind __ret_86: Ast::Expr?, parser = parser.quantifier_expression() can Global{Read,Write}
                return __ret_86
            # Verification quantifier `forall|exists VAR in ITER: PRED` (contextual
            # keywords, `invariant`/`law` predicate spelling — colon body instead of
            # `where`). Same disambiguation shape as any/all; reuses the Comprehension
            # node since the quantifier semantics (var/iterable/condition) are identical.
            direct_quantifier: bool = parser.peek_at(1) == TokenKind.Ident and parser.peek_at(2) == TokenKind.In
            grouped_quantifier: bool = parser.peek_at(1) == TokenKind.LParen and parser.peek_at(2) == TokenKind.Ident
            if (head_text == "forall" or head_text == "exists") and (direct_quantifier or grouped_quantifier):
                # Same `__query` marker the any/all form records. These reuse Expr.Comprehension,
                # so without it the backend cannot tell `forall` (universal) from `exists`
                # (existential) either — and defaulting that pair to `any` would miscompile
                # every `forall` the same way it miscompiled `all`.
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__query", name: head_text, line: token.line, offset: token.start})
                rebind forall_head: Token, parser = parser.advance()
                rebind forall_grouped: bool, parser = parser.accept(TokenKind.LParen)
                rebind forall_variable: Token, parser = parser.expect(TokenKind.Ident)
                # Binder row for the `__query` head above — see quantifier_expression.
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__query_binder_of", name: Lexer::text_or_empty(forall_variable, parser.source, parser.source_length), line: token.line, offset: token.start})
                machine over parser.position while parser.peek() == TokenKind.Comma:
                    state More
                    start More

                    More, _:
                        parser.position <- parser.position + 1
                        rebind extra_forall_binder: Token, parser = parser.expect(TokenKind.Ident)
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: Lexer::text_or_empty(extra_forall_binder, parser.source, parser.source_length), name: "__query_binder", line: forall_head.line, offset: forall_head.start})
                        -> More
                parser, _ <- parser.expect(TokenKind.RParen) if forall_grouped
                parser, _ <- parser.expect(TokenKind.In)
                rebind forall_iterable: Ast::Expr, parser = get parser.expression() can Global{Read,Write}
                match forall_iterable:
                    Ast::Expr.Binary(left, operator, right, line):
                        # The for-header path already refuses a bare `..`; a quantifier's
                        # iterable is the same ambiguity and gets the same sentence.
                        parser <- parser.error_removed(forall_head, "ambiguous bare `..` range: use `..<` for exclusive (e.g. `lo ..< hi`) or `..=` for inclusive (e.g. `lo ..= hi`)") if operator == TokenKind.Range
                    _:
                        pass
                parser, _ <- parser.expect(TokenKind.Colon)
                forall_condition: mutable Ast::Expr = (Ast::Expr.Absent)
                rebind forall_condition_opt: Ast::Expr?, parser = parser.expression() can Global{Read,Write}
                forall_condition <- parsed_forall_condition if forall_condition_opt is parsed_forall_condition
                return (Ast::Expr.Comprehension(Lexer::text_or_empty(forall_variable, parser.source, parser.source_length), forall_iterable, forall_condition, (Ast::Expr.Absent), Ast::pos_of_token(forall_head), Ast::query_scope_id_from_offset(forall_head.start)))
            # Anonymous function `fn(...) => EXPR` / `fn(...): BLOCK` (params are
            # always parenthesized — mirrors a function's shape; also any Unicode
            # lambda letter). Contextual — `fn` is a very common variable name, so
            # only when the lambda signature is actually followed by `:` or `=>`
            # (a bare `fn(x)` call / `fn` reference is not).
            if is_lambda_keyword(head_text):
                rebind __c_lam: bool, parser = parser.looks_like_lambda()
                if __c_lam:
                    rebind __ret_99: Ast::Expr?, parser = parser.lambda_expression() can Global{Read,Write}
                    return __ret_99
            # Removed shorthand lambda params `fn x: x` / `λ a, b: expression` (params
            # are always parenthesized now — bd208ae). Left unflagged, `fn` falls
            # through to being parsed as a bare Ident and the orphaned `x: x` gets
            # silently reinterpreted as a brand-new statement (0 errors, 2 stmts).
            # Only fires on the exact removed shape (`IDENT (, IDENT)* COLON`
            # directly after the keyword) so a bare `fn` reference / `fn(x)` call
            # is untouched.
            if is_lambda_keyword(head_text):
                rebind __c_rsl: bool, parser = parser.looks_like_removed_shorthand_lambda()
                if __c_rsl:
                    parser <- parser.error_removed(token, "shorthand lambda parameters have been removed; parenthesize them: `fn(a, b) => …`")
                    parser <- parser.skip_removed_line()
                    return null
            parser, _ <- parser.advance()
            return (Ast::Expr.Ident(head_text, Ast::pos_of_token(token)))


include "./parser_expr_keywords.elisa"

