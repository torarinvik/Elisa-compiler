# Stage1 parser — expression parsing (`extend Parser: private:`). Covers primary/postfix/
# unary/binary expressions plus array/dict/brace literals. Split out of parser.elisa to
# keep each part file under 600 lines; see parser.elisa for the module overview.

extend Parser:
    private:
        # ============================================================
        # Expression parsing
        # Returns Expr? (opaque AST handle or null on error)
        # All allocations happen implicitly in inferred region
        # ============================================================

        def primary_expr(parser: mutable Parser&) -> Ast::Expr?:
            kind: TokenKind = parser.peek()
            tok: Token = parser.cursor()

            match kind:
                TokenKind.Match:
                    # Expression-form `match EXPR: ...` (e.g. `return match x:` / `y = match x:`).
                    # Statement-position `match` is routed to match_stmt by the statement
                    # dispatcher first; this handles `match` nested in an expression. Reuses
                    # the shared arm-block parser; arms carry statement bodies (as in the
                    # statement form), which the resolver's Expr.Match walker already handles.
                    match_tok: Token = parser.advance()        # `match`
                    m_scrut: Ast::Expr = get parser.expr()
                    if parser.accept(TokenKind.As):
                        parser.expect(TokenKind.Ident)
                    m_arms: darray[Ast::MatchArm] = parser.parse_arm_block()
                    return (Ast::Expr.Match(m_scrut, m_arms, match_tok.line))

                TokenKind.IntLit:
                    parser.advance()
                    return (Ast::Expr.IntLit(0))

                TokenKind.HexLit:
                    # Literal value evaluation is deferred; the node records the form only.
                    parser.advance()
                    return (Ast::Expr.IntLit(0))

                TokenKind.FloatLit:
                    parser.advance()
                    return (Ast::Expr.FloatLit(Lexer::text_or_empty(tok, parser.source)))

                TokenKind.CharLit:
                    parser.advance()
                    return (Ast::Expr.CharLit(Lexer::text_or_empty(tok, parser.source)))

                TokenKind.StringLit:
                    parser.advance()
                    return (Ast::Expr.StringLit(Lexer::text_or_empty(tok, parser.source)))

                TokenKind.FString:
                    parser.advance()
                    return parser.fstring_expr(tok)

                TokenKind.Ident:
                    # `get EXPR else <recovery>` recovery form (contextual keyword): the
                    # guarded expression is the value; the `else` clause is a fallback
                    # expression or a control-flow statement (`else return null`).
                    head_text: sview = Lexer::text_or_empty(tok, parser.source)
                    if head_text == "get":
                        return parser.get_expr()
                    # `move EXPR` ownership transfer — the moved value is the expression;
                    # the move marker is consumed but not modeled.
                    if head_text == "move":
                        parser.advance()
                        return parser.unary_expr()
                    # `submit [pool] TASK(...)` pool/nursery task submission — the task
                    # call is the expression; the submit marker (and optional bracketed
                    # pool selector) is consumed but not modeled, like `move`. Only when
                    # an operand follows (bare `submit` stays an ordinary identifier).
                    if head_text == "submit" and parser.peek_at(1) in {TokenKind.Ident, TokenKind.LBracket}:
                        parser.advance()
                        if parser.accept(TokenKind.LBracket):
                            parser.expr()              # pool/region selector (consumed)
                            parser.expect(TokenKind.RBracket)
                        return parser.unary_expr()
                    # Query/quantifier expression `KW VAR[, VAR]* in ITER [where COND]` —
                    # the full stage0 family: any/all (bool), first/count/sum/product/
                    # min/max (fold values), each (side-effect). Contextual keywords —
                    # `count`/`first`/`min`/… are common identifiers, so only the exact
                    # `VAR(, VAR)* in` shape after the keyword selects the query form.
                    if is_query_keyword(head_text) and parser.looks_like_query_expr():
                        return parser.quantifier_expr()
                    # Verification quantifier `forall|exists VAR in ITER: PRED` (contextual
                    # keywords, `invariant`/`law` predicate spelling — colon body instead of
                    # `where`). Same disambiguation shape as any/all; reuses the Comprehension
                    # node since the quantifier semantics (var/iter/cond) are identical.
                    if (head_text == "forall" or head_text == "exists") and parser.peek_at(1) == TokenKind.Ident and parser.peek_at(2) == TokenKind.In:
                        return parser.forall_exists_expr()
                    # Anonymous function `fn(...) => EXPR` / `fn(...): BLOCK` (params are
                    # always parenthesized — mirrors a function's shape; also any Unicode
                    # lambda letter). Contextual — `fn` is a very common variable name, so
                    # only when the lambda signature is actually followed by `:` or `=>`
                    # (a bare `fn(x)` call / `fn` reference is not).
                    if is_lambda_keyword(head_text) and parser.looks_like_lambda():
                        return parser.lambda_expr()
                    # Removed shorthand lambda params `fn x: x` / `λ a, b: expr` (params
                    # are always parenthesized now — bd208ae). Left unflagged, `fn` falls
                    # through to being parsed as a bare Ident and the orphaned `x: x` gets
                    # silently reinterpreted as a brand-new statement (0 errors, 2 stmts).
                    # Only fires on the exact removed shape (`IDENT (, IDENT)* COLON`
                    # directly after the keyword) so a bare `fn` reference / `fn(x)` call
                    # is untouched.
                    if is_lambda_keyword(head_text) and parser.looks_like_removed_shorthand_lambda():
                        parser.error_at(Ast::ParseErrorKind.UnexpectedToken, tok)
                        parser.advance()
                        return null
                    parser.advance()
                    return (Ast::Expr.Ident(head_text, tok.line))

                TokenKind.True:
                    parser.advance()
                    return (Ast::Expr.BoolLit(true))

                TokenKind.False:
                    parser.advance()
                    return (Ast::Expr.BoolLit(false))

                TokenKind.Null:
                    # No dedicated Null node yet; record the keyword as a leaf identifier.
                    parser.advance()
                    return (Ast::Expr.Ident(Lexer::text_or_empty(tok, parser.source), tok.line))

                TokenKind.Sizeof:
                    # `sizeof(T)` / `size_of(T)` (and alignof/offsetof): the keyword is a
                    # leaf; the following `(...)` is consumed by the postfix Call rule.
                    parser.advance()
                    return (Ast::Expr.Ident(Lexer::text_or_empty(tok, parser.source), tok.line))

                TokenKind.Alignof:
                    parser.advance()
                    return (Ast::Expr.Ident(Lexer::text_or_empty(tok, parser.source), tok.line))

                TokenKind.Offsetof:
                    parser.advance()
                    return (Ast::Expr.Ident(Lexer::text_or_empty(tok, parser.source), tok.line))

                TokenKind.Panic:
                    # `panic(msg)` / `raise Err`: leaf keyword; the operand (a `(...)` call
                    # or a following expression) is consumed by the postfix/unary rules.
                    parser.advance()
                    return (Ast::Expr.Ident(Lexer::text_or_empty(tok, parser.source), tok.line))

                TokenKind.Raise:
                    parser.advance()
                    return (Ast::Expr.Ident(Lexer::text_or_empty(tok, parser.source), tok.line))

                TokenKind.Zeroed:
                    parser.advance()
                    return (Ast::Expr.Ident(Lexer::text_or_empty(tok, parser.source), tok.line))

                TokenKind.New:
                    # `new [region] Type(...)`: skip the keyword and optional region
                    # bracket, then parse the constructor expression as the value.
                    parser.advance()
                    if parser.accept(TokenKind.LBracket):
                        while parser.peek() != TokenKind.RBracket and parser.peek() != TokenKind.Eof:
                            parser.advance()
                        parser.accept(TokenKind.RBracket)
                    return parser.postfix_expr()

                TokenKind.LParen:
                    parser.advance()
                    # `()` unit tuple.
                    if parser.peek() == TokenKind.RParen:
                        parser.advance()
                        return (Ast::Expr.Tuple([], tok.line))
                    # `(name: T, …)` named-tuple TYPE (e.g. a multi-value return type
                    # `-> (stmt_count: usize, checksum: i64)`). The element labels are
                    # selectors, not values — `(x: 1)` is never a value expression — so
                    # a leading `IDENT :` inside parens selects the labeled-tuple form;
                    # each label is consumed and only the element types are kept.
                    if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon:
                        named_elems: mutable darray[Ast::Expr] = []
                        while parser.peek() != TokenKind.RParen and parser.peek() != TokenKind.Eof:
                            if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon:
                                parser.advance()           # element label
                                parser.advance()           # `:`
                            if parser.expr() is ne:
                                named_elems.push(ne)
                            if not parser.accept(TokenKind.Comma):
                                break
                        parser.expect(TokenKind.RParen)
                        return (Ast::Expr.Tuple(named_elems, tok.line))
                    paren_first: Ast::Expr = parser.consume_removed_as_cast(get parser.expr())
                    # `(a, b, …)` tuple (value or type position); a single `(x)` is grouping.
                    if parser.peek() == TokenKind.Comma:
                        tuple_elems: mutable darray[Ast::Expr] = [paren_first]
                        while parser.accept(TokenKind.Comma):
                            break if parser.peek() == TokenKind.RParen
                            if parser.expr() is te:
                                tuple_elems.push(te)
                        parser.expect(TokenKind.RParen)
                        return (Ast::Expr.Tuple(tuple_elems, tok.line))
                    parser.expect(TokenKind.RParen)
                    return paren_first

                TokenKind.LBracket:
                    return parser.array_literal()

                TokenKind.LBrace:
                    return parser.brace_literal()

                TokenKind.Dot:
                    # Leading-dot enum shorthand `.Variant` / `.A.B` — the enclosing enum
                    # type is inferred from context. Consume the whole `.Ident(.Ident)*`
                    # chain here; a following call/index is handled by the postfix rule.
                    parser.advance()                       # leading `.`
                    parts: mutable darray[sview] = []
                    first_part: Token = parser.expect(TokenKind.Ident)
                    parts.push(Lexer::text_or_empty(first_part, parser.source))
                    while parser.accept(TokenKind.Dot):
                        next_part: Token = parser.expect(TokenKind.Ident)
                        parts.push(Lexer::text_or_empty(next_part, parser.source))
                    return (Ast::Expr.ShorthandMember(parts, tok.line))

                TokenKind.Try:
                    # `try EXPR else <recovery>` inline recovery expression — same shape
                    # as `get …`; the guarded expression is the value.
                    return parser.get_expr()

                TokenKind.Catch:
                    # `catch EXPR:` fallible expression with success/error arms
                    # (`return catch self.foo(...):`). The guarded expression is the
                    # value; the `:` arm block is parsed and consumed. (Statement-position
                    # `catch:` is handled earlier in stmt(); this is the expression form.)
                    parser.advance()                       # `catch`
                    guarded: Ast::Expr = get parser.expr()
                    if parser.peek() == TokenKind.Colon:
                        parser.parse_block()               # ok:/error e: arms (consumed)
                    return guarded

                _:
                    parser.error_at(Ast::ParseErrorKind.UnexpectedToken, tok)
                    parser.advance()   # consume the offending token so callers don't re-error on it
                    return null

