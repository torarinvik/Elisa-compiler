# Stage1 parser — the public entry point (`extend Parser: public:`). `parse_file` drives
# the declaration loop over a token stream, followed by the whole-file scans it runs
# once the AST is built (allocation regions, console members, permission params, legacy
# error syntax). Split out to keep each part file under 600 lines.

extend Parser:
    public:
        # ============================================================
        # Region-polymorphic file parsing entry point
        # No Arena& param; region inferred from call site
        # Returns owned Ast::File with all AST nodes in inferred region
        # ============================================================

        def parse_file(source: u8&, tokens: darray[Token]) -> Ast::File:
            # Region is fully inferred: the parser's stores are backed by this function's
            # inferred auto-region, threaded into every helper call and adopted by the caller
            # on return (region-polymorphic return). No explicit Arena, no `@r`.
            parser: mutable Parser = Parser(source, tokens)
            top_items: mutable darray[Ast::Decl] = []

            while true |parser|:
                parser <- parser.skip_newlines()
                break if parser.peek() == TokenKind.Eof
                before: usize = parser.position
                parser <- parser.parse_declaration_unit(top_items)
                parser <- parser.advance_if(parser.position == before)      # guarantee forward progress

            # Drain decls synthesized by statement-level desugars (docs/123 machine
            # mode enums) so they resolve like ordinary top-level declarations.
            for pending_decl in parser.pending_decls:
                top_items.push(pending_decl)

            parser <- parser.scan_legacy_error_syntax()
            parser <- parser.scan_allocation_regions()
            parser <- parser.scan_invalid_console_members()
            parser <- parser.scan_permission_param_members()

            return Ast::File{
                top_decls: top_items,
                protocol_default_methods: parser.protocol_default_methods,
                errors: parser.errors,
                error_set_func_lines: parser.error_set_func_lines,
                error_set_func_names: parser.error_set_func_names,
                error_set_decl_names: parser.error_set_decl_names,
                signature_contract_lines: parser.signature_contract_lines,
                signature_contract_kinds: parser.signature_contract_kinds,
                signature_contract_exprs: parser.signature_contract_exprs,
                tuple_type_elements: parser.tuple_type_elements,
                tuple_type_starts: parser.tuple_type_starts,
                tuple_type_counts: parser.tuple_type_counts,
                tuple_type_lines: parser.tuple_type_lines,
                numeric_suffix_names: parser.numeric_suffix_names,
                numeric_suffix_lines: parser.numeric_suffix_lines,
                machine_coverage: parser.machine_coverage,
                derived_state_rules: parser.derived_state_rules,
                typestate_postconditions: parser.typestate_postconditions,
                generic_param_lines: parser.generic_param_lines,
                generic_param_names: parser.generic_param_names,
                generic_struct_decls: parser.generic_struct_decls,
                generic_struct_decl_names: parser.generic_struct_decl_names,
                generic_struct_decl_lines: parser.generic_struct_decl_lines,
                generic_func_decls: parser.generic_func_decls,
                generic_func_decl_names: parser.generic_func_decl_names,
                func_decl_lines: parser.func_decl_lines,
                func_decl_columns: parser.func_decl_columns,
                generic_func_decl_lines: parser.generic_func_decl_lines,
                annotation_args: parser.annotation_args,
                extern_params: parser.extern_params,
                local_region_annotations: parser.local_region_annotations,
                ghost_local_lines: parser.ghost_local_lines,
                static_assert_conds: parser.static_assert_conds,
                static_if_conds: parser.static_if_conds,
                static_if_lines: parser.static_if_lines,
                static_if_kinds: parser.static_if_kinds,
                static_assert_msgs: parser.static_assert_msgs,
                static_assert_lines: parser.static_assert_lines,
                allocation_region_names: parser.allocation_region_names,
                allocation_region_lines: parser.allocation_region_lines,
                enum_annotations: parser.enum_annotations,
                fn_type_param_lines: parser.fn_type_param_lines,
                fn_type_param_exprs: parser.fn_type_param_exprs,
                fn_type_return_lines: parser.fn_type_return_lines,
                fn_type_return_exprs: parser.fn_type_return_exprs,
                packed_enum_names: parser.packed_enum_names,
                alias_names: parser.alias_names,
                alias_targets: parser.alias_targets,
                alias_target_heads: parser.alias_target_heads,
                struct_names: parser.struct_names,
                struct_member_rows: parser.struct_member_rows,
                struct_member_starts: parser.struct_member_starts,
                struct_member_counts: parser.struct_member_counts,
                enum_decl_names: parser.enum_decl_names,
                enum_decl_storage_heads: parser.enum_decl_storage_heads,
                enum_decl_is_const: parser.enum_decl_is_const,
                enum_decl_variant_names: parser.enum_decl_variant_names,
                enum_decl_variant_values: parser.enum_decl_variant_values,
                enum_decl_variant_starts: parser.enum_decl_variant_starts,
                enum_decl_variant_counts: parser.enum_decl_variant_counts,
                payload_enum_names: parser.payload_enum_names,
                payload_enum_is_const: parser.payload_enum_is_const,
                payload_enum_variant_starts: parser.payload_enum_variant_starts,
                payload_enum_variant_counts: parser.payload_enum_variant_counts,
                payload_enum_variant_names: parser.payload_enum_variant_names,
                payload_enum_variant_field_starts: parser.payload_enum_variant_field_starts,
                payload_enum_variant_field_counts: parser.payload_enum_variant_field_counts,
                payload_enum_variant_fields: parser.payload_enum_variant_fields,
                payload_enum_variant_field_names: parser.payload_enum_variant_field_names,
                enum_common_owners: parser.enum_common_owners,
                enum_common_counts: parser.enum_common_counts
            }


        def scan_allocation_regions(parser: lmut Parser) -> void:
            can Memory.Allocate, Abort.Panic:
                for index in 0..<parser.tokens.count |parser|:
                    continue if index + 2 >= parser.tokens.count
                    head: Token = parser.tokens[index]
                    lbracket: Token = parser.tokens[index + 1]
                    region: Token = parser.tokens[index + 2]
                    contextual_new: bool = head.kind == TokenKind.Ident and Lexer::text_or_empty(head, parser.source) == "new"
                    has_region: bool = (head.kind == TokenKind.New or contextual_new) and lbracket.kind == TokenKind.LBracket and region.kind == TokenKind.Ident
                    parser.allocation_region_names <- parser.allocation_region_names.push(Lexer::text_or_empty(region, parser.source)) if has_region
                    parser.allocation_region_lines <- parser.allocation_region_lines.push(head.line) if has_region


        def scan_invalid_console_members(parser: lmut Parser) -> void:
            can Memory.Allocate, Abort.Panic:
                for index in 0..<parser.tokens.count |parser|:
                    continue if index + 2 >= parser.tokens.count
                    family: Token = parser.tokens[index]
                    member: Token = parser.tokens[index + 2]
                    permission_context: bool = index > 0 and parser.tokens[index - 1].kind == TokenKind.Ident and Lexer::text_or_empty(parser.tokens[index - 1], parser.source) == "can"
                    console_member: bool = permission_context and family.kind == TokenKind.Ident and Lexer::text_or_empty(family, parser.source) == "Console" and parser.tokens[index + 1].kind == TokenKind.Dot and member.kind == TokenKind.Ident
                    member_name: sview = Lexer::text_or_empty(member, parser.source)
                    invalid: bool = console_member and member_name != "Format" and member_name != "Write"
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__invalid_console", name: member_name, line: family.line}) if invalid


        # Permission-row parameters stand for a complete permission value. Unlike a
        # concrete permission family (`Console.Write`), they cannot be qualified with a
        # member (`P.Write`). Preserve this source-level distinction for semantic
        # diagnostics; the compact type AST intentionally erases generic-parameter kinds.
        def permission_param_on_line(names: darray[sview]&, lines: darray[u32]&, name: sview, line: u32) -> bool:
            can Abort.Panic:
                for index in 0..<names.count:
                    true return if names[index] == name and lines[index] == line
                return false


        def scan_permission_param_members(parser: lmut Parser) -> void:
            can Memory.Allocate, Abort.Panic:
                permission_params: mutable darray[sview] = []
                permission_param_lines: mutable darray[u32] = []
                for index in 0..<parser.tokens.count |parser, permission_params, permission_param_lines|:
                    continue if index + 1 >= parser.tokens.count
                    marker: Token = parser.tokens[index]
                    candidate: Token = parser.tokens[index + 1]
                    is_permission_marker: bool = marker.kind == TokenKind.Ident and Lexer::text_or_empty(marker, parser.source) == "permission"
                    if is_permission_marker and candidate.kind == TokenKind.Ident:
                        permission_params.push(Lexer::text_or_empty(candidate, parser.source))
                        permission_param_lines.push(candidate.line)
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__permission_param_decl", name: Lexer::text_or_empty(candidate, parser.source), line: candidate.line})

                for index in 0..<parser.tokens.count |parser, permission_params, permission_param_lines|:
                    continue if index + 2 >= parser.tokens.count
                    family: Token = parser.tokens[index]
                    member: Token = parser.tokens[index + 2]
                    dotted: bool = family.kind == TokenKind.Ident and parser.tokens[index + 1].kind == TokenKind.Dot and member.kind == TokenKind.Ident
                    family_name: sview = Lexer::text_or_empty(family, parser.source)
                    is_permission_param: bool = permission_param_on_line(permission_params, permission_param_lines, family_name, family.line)
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__permission_param_member", name: family_name, line: family.line}) if dotted and is_permission_param

        def scan_legacy_error_syntax(parser: lmut Parser) -> void:
            can Memory.Allocate, Abort.Panic:
                saw_arrow: mutable bool = false
                for token_index in 0..<parser.tokens.count |parser, saw_arrow|:
                    kind: TokenKind = parser.tokens[token_index].kind
                    saw_arrow <- false if kind == TokenKind.Newline
                    saw_arrow <- true if kind == TokenKind.Arrow
                    wildcard_error: bool = kind == TokenKind.Error and token_index + 5 < parser.tokens.count and parser.tokens[token_index + 1].kind == TokenKind.LBracket and parser.tokens[token_index + 2].kind == TokenKind.Ident and parser.tokens[token_index + 3].kind == TokenKind.Dot and parser.tokens[token_index + 4].kind == TokenKind.Star and parser.tokens[token_index + 5].kind == TokenKind.RBracket
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "", name: "__legacy_error_wildcard", line: parser.tokens[token_index].line}) if wildcard_error
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "", name: "__legacy_error_pipe", line: parser.tokens[token_index].line}) if kind == TokenKind.Pipe and saw_arrow
                    # `error[Set, ...]`: a Comma directly followed by `...` inside the set is the
                    # dropped open-suffix form. Detect the `, ...` token pair (deprecated: a bare
                    # set name already means the whole family).
                    comma_ellipsis: bool = saw_arrow and kind == TokenKind.Comma and token_index + 1 < parser.tokens.count and parser.tokens[token_index + 1].kind == TokenKind.Ellipsis
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "", name: "__legacy_error_open", line: parser.tokens[token_index].line}) if comma_ellipsis
