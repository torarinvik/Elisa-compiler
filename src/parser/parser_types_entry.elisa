# Stage1 parser — the public entry point (`extend Parser: public:`). `parse_file` drives
# the declaration loop over a token stream, followed by the whole-file scans it runs
# once the AST is built (allocation regions, console members, permission params, legacy
# error syntax). Split out to keep each part file under 600 lines.

# The Python-module emitter consumes a compact string-oriented type view in a few hot paths.
# Builtin containers already have static spellings, but a named element (`darray[Point]`) or
# dictionary value (`dict[cstr, Point]`) needs an owned wrapper around the AST's `Point` view.
# Build those wrappers while the parser is still adopting its whole-file region; the driver only
# performs read-only lookups afterward.
def parser_cache_pymodule_render_type_expression(expression: Ast::Expr, out: mutable darray[u8]&) -> bool:
    if expression is Expr.Ident(render_name, render_pos):
        for render_index in 0..<sview_len(render_name) |out, render_name|:
            out.push(sview_at(render_name, render_index))
        return true
    if expression is Expr.Scope(render_scope_head, render_scope_name, render_scope_pos):
        return false if not parser_cache_pymodule_render_type_expression(render_scope_head, out)
        out.push(58)
        out.push(58)
        for render_index in 0..<sview_len(render_scope_name) |out, render_scope_name|:
            out.push(sview_at(render_scope_name, render_index))
        return true
    if expression is Expr.Unary(render_operator, render_operand, render_unary_pos):
        return false if not parser_cache_pymodule_render_type_expression(render_operand, out)
        if render_operator == TokenKind.Question:
            out.push(63)
        return true
    if expression is Expr.Paren(render_inner, render_paren_pos):
        return parser_cache_pymodule_render_type_expression(render_inner, out)
    if expression is Expr.Refinement(render_base, render_predicate, render_refinement_pos):
        return parser_cache_pymodule_render_type_expression(render_base, out)
    if expression is Expr.Index(render_index_head, render_index_argument, render_index_pos):
        return false if not parser_cache_pymodule_render_type_expression(render_index_head, out)
        out.push(91)
        return false if not parser_cache_pymodule_render_type_expression(render_index_argument, out)
        out.push(93)
        return true
    if expression is Expr.IndexN(render_index_head_n, render_index_arguments, render_index_n_pos):
        return false if not parser_cache_pymodule_render_type_expression(render_index_head_n, out)
        out.push(91)
        first_argument: mutable bool = true
        for render_argument in render_index_arguments |out, first_argument|:
            if not first_argument:
                out.push(44)
            return false if not parser_cache_pymodule_render_type_expression(render_argument, out)
            first_argument <- false
        out.push(93)
        return true
    return false

def parser_cache_pymodule_is_container_expression(expression: Ast::Expr) -> bool:
    if expression is Expr.Index(container_head, container_argument, container_pos):
        if container_head is Expr.Ident(container_name, container_name_pos):
            return container_name == "darray" or container_name == "view" or container_name == "set"
        return false
    if expression is Expr.IndexN(container_head_n, container_arguments, container_pos_n):
        if container_head_n is Expr.Ident(container_name_n, container_name_pos_n):
            return container_name_n == "darray" or container_name_n == "view" or container_name_n == "set" or container_name_n == "dict"
        return false
    return false

def parser_cache_pymodule_container_type_expression(expression: Ast::Expr, bytes: mutable darray[u8]&, starts: mutable darray[usize]&, lengths: mutable darray[usize]&) -> void:
    if expression is Expr.Unary(container_expression_operator, container_expression_operand, container_expression_unary_pos):
        parser_cache_pymodule_container_type_expression(container_expression_operand, bytes, starts, lengths)
        return
    if expression is Expr.Paren(container_expression_inner, container_expression_paren_pos):
        parser_cache_pymodule_container_type_expression(container_expression_inner, bytes, starts, lengths)
        return
    if expression is Expr.Refinement(container_expression_base, container_expression_predicate, container_expression_refinement_pos):
        parser_cache_pymodule_container_type_expression(container_expression_base, bytes, starts, lengths)
        return
    if expression is Expr.Index(container_expression_head, container_expression_argument, container_expression_index_pos):
        parser_cache_pymodule_container_type_expression(container_expression_head, bytes, starts, lengths)
        parser_cache_pymodule_container_type_expression(container_expression_argument, bytes, starts, lengths)
    if expression is Expr.IndexN(container_expression_head_n, container_expression_arguments, container_expression_index_n_pos):
        parser_cache_pymodule_container_type_expression(container_expression_head_n, bytes, starts, lengths)
        for container_expression_argument_n in container_expression_arguments |bytes, starts, lengths|:
            parser_cache_pymodule_container_type_expression(container_expression_argument_n, bytes, starts, lengths)
    return if not parser_cache_pymodule_is_container_expression(expression)
    rendered: mutable darray[u8] = []
    return if not parser_cache_pymodule_render_type_expression(expression, &rendered)
    start: usize = bytes.count
    for rendered_byte in rendered |bytes|:
        bytes.push(rendered_byte)
    starts.push(start)
    lengths.push(bytes.count - start)

def parser_cache_pymodule_container_declarations(declarations: darray[Ast::Decl], bytes: mutable darray[u8]&, starts: mutable darray[usize]&, lengths: mutable darray[usize]&) -> void:
    for declaration in declarations |bytes, starts, lengths|:
        if declaration is Decl.Func(container_function_name, container_function_params, container_function_return, container_function_body, container_function_effects, container_function_decorators, container_function_pos):
            for container_function_param in container_function_params |bytes, starts, lengths|:
                parser_cache_pymodule_container_type_expression(container_function_param.type_expression, bytes, starts, lengths)
            if container_function_return is container_function_return_expression:
                parser_cache_pymodule_container_type_expression(container_function_return_expression, bytes, starts, lengths)
        if declaration is Decl.Struct(container_struct_name, container_struct_members, container_struct_affinity, container_struct_states, container_struct_derive, container_struct_invariants, container_struct_pos):
            for container_struct_member in container_struct_members |bytes, starts, lengths|:
                parser_cache_pymodule_container_type_expression(container_struct_member.type_expression, bytes, starts, lengths)
            prefixes: darray[sview] = ["darray[", "view[", "set["]
            for prefix in prefixes |bytes, starts, lengths, prefix, container_struct_name|:
                start: usize = bytes.count
                for prefix_index in 0..<sview_len(prefix) |bytes, prefix|:
                    bytes.push(sview_at(prefix, prefix_index))
                for name_index in 0..<sview_len(container_struct_name) |bytes, container_struct_name|:
                    bytes.push(sview_at(container_struct_name, name_index))
                bytes.push(93)
                starts.push(start)
                lengths.push(bytes.count - start)
        if declaration is Decl.Enum(container_enum_name, container_enum_variants, container_enum_const, container_enum_storage, container_enum_pos):
            parser_cache_pymodule_container_type_expression(container_enum_storage, bytes, starts, lengths)
            for container_enum_variant in container_enum_variants |bytes, starts, lengths|:
                for container_enum_field in container_enum_variant.fields |bytes, starts, lengths|:
                    parser_cache_pymodule_container_type_expression(container_enum_field, bytes, starts, lengths)
        if declaration is Decl.Alias(container_alias_name, container_alias_target, container_alias_pos):
            parser_cache_pymodule_container_type_expression(container_alias_target, bytes, starts, lengths)
        if declaration is Decl.Const(container_const_name, container_const_type, container_const_value, container_const_mutable, container_const_pos):
            parser_cache_pymodule_container_type_expression(container_const_type, bytes, starts, lengths)
        if declaration is Decl.Module(container_module_name, container_module_body, container_module_pos):
            parser_cache_pymodule_container_declarations(container_module_body, bytes, starts, lengths)
        if declaration is Decl.Scoped(container_scoped_body, container_scoped_pos):
            parser_cache_pymodule_container_declarations(container_scoped_body, bytes, starts, lengths)

# Fixed arrays carry their extent as a value in the AST (`i64[3]` or
# `array[i64, 3]`), so they cannot be covered by the finite spelling table above.
# Cache every source-level fixed-array spelling in the same adopted byte pool.  The
# driver can then publish the exact manifest type without allocating a transient
# string (and without making a guessed ABI decision for the native wrapper).
def parser_pymodule_fixed_array_element_name(expression: Ast::Expr) -> sview:
    if expression is Expr.Ident(array_element_name, array_element_pos):
        return array_element_name
    if expression is Expr.Scope(array_scope_head, array_scope_name, array_scope_pos):
        return "py::Object" if array_scope_head is Expr.Ident(array_scope_module, array_scope_module_pos) and array_scope_module == "py" and array_scope_name == "Object"
        return array_scope_name
    if expression is Expr.Unary(array_element_operator, array_element_operand, array_element_unary_pos):
        return parser_pymodule_fixed_array_element_name(array_element_operand) if array_element_operator == TokenKind.Mutable or array_element_operator == TokenKind.Lmut
    if expression is Expr.Paren(array_element_inner, array_element_paren_pos):
        return parser_pymodule_fixed_array_element_name(array_element_inner)
    if expression is Expr.Refinement(array_element_base, array_element_predicate, array_element_refinement_pos):
        return parser_pymodule_fixed_array_element_name(array_element_base)
    return ""


def parser_cache_pymodule_fixed_array_name(element_name: sview, extent: i64, bytes: mutable darray[u8]&, starts: mutable darray[usize]&, lengths: mutable darray[usize]&) -> void:
    return if element_name == "" or extent <= 0
    digits: mutable darray[u8] = []
    remaining: mutable i64 = extent
    while remaining > 0 |remaining, digits|:
        digits.push((48 + (remaining % 10)).u8())
        remaining <- remaining / 10
    start: usize = bytes.count
    for prefix_index in 0..<sview_len("array[") |bytes|:
        bytes.push(sview_at("array[", prefix_index))
    for element_index in 0..<sview_len(element_name) |bytes, element_name|:
        bytes.push(sview_at(element_name, element_index))
    bytes.push(44)
    digit_index: mutable i64 = digits.count.i64() - 1
    while digit_index >= 0 |digit_index, digits, bytes|:
        bytes.push(digits[digit_index.usize()])
        digit_index <- digit_index - 1
    bytes.push(93)
    starts.push(start)
    lengths.push(bytes.count - start)


def parser_cache_pymodule_fixed_array_expression(expression: Ast::Expr, bytes: mutable darray[u8]&, starts: mutable darray[usize]&, lengths: mutable darray[usize]&) -> void:
    if expression is Expr.Unary(array_expression_operator, array_expression_operand, array_expression_unary_pos):
        parser_cache_pymodule_fixed_array_expression(array_expression_operand, bytes, starts, lengths)
        return
    if expression is Expr.Paren(array_expression_inner, array_expression_paren_pos):
        parser_cache_pymodule_fixed_array_expression(array_expression_inner, bytes, starts, lengths)
        return
    if expression is Expr.Refinement(array_expression_base, array_expression_predicate, array_expression_refinement_pos):
        parser_cache_pymodule_fixed_array_expression(array_expression_base, bytes, starts, lengths)
        parser_cache_pymodule_fixed_array_expression(array_expression_predicate, bytes, starts, lengths)
        return
    if expression is Expr.Index(array_expression_head, array_expression_extent, array_expression_index_pos):
        if array_expression_extent is Expr.IntLit(array_extent_value):
            parser_cache_pymodule_fixed_array_name(parser_pymodule_fixed_array_element_name(array_expression_head), array_extent_value, bytes, starts, lengths)
        parser_cache_pymodule_fixed_array_expression(array_expression_head, bytes, starts, lengths)
        parser_cache_pymodule_fixed_array_expression(array_expression_extent, bytes, starts, lengths)
        return
    if expression is Expr.IndexN(array_expression_head_n, array_expression_arguments, array_expression_index_pos_n):
        if array_expression_head_n is Expr.Ident(array_expression_name_n, array_expression_name_pos_n) and array_expression_name_n == "array" and array_expression_arguments.count == 2:
            if array_expression_arguments[1] is Expr.IntLit(array_extent_value_n):
                parser_cache_pymodule_fixed_array_name(parser_pymodule_fixed_array_element_name(array_expression_arguments[0]), array_extent_value_n, bytes, starts, lengths)
        parser_cache_pymodule_fixed_array_expression(array_expression_head_n, bytes, starts, lengths)
        for array_expression_argument in array_expression_arguments |bytes, starts, lengths|:
            parser_cache_pymodule_fixed_array_expression(array_expression_argument, bytes, starts, lengths)


def parser_cache_pymodule_fixed_array_declarations(declarations: darray[Ast::Decl], bytes: mutable darray[u8]&, starts: mutable darray[usize]&, lengths: mutable darray[usize]&) -> void:
    for declaration in declarations |bytes, starts, lengths|:
        if declaration is Decl.Func(array_function_name, array_function_params, array_function_return, array_function_body, array_function_effects, array_function_decorators, array_function_pos):
            for array_function_param in array_function_params |bytes, starts, lengths|:
                parser_cache_pymodule_fixed_array_expression(array_function_param.type_expression, bytes, starts, lengths)
            if array_function_return is array_function_return_expression:
                parser_cache_pymodule_fixed_array_expression(array_function_return_expression, bytes, starts, lengths)
        if declaration is Decl.Struct(array_struct_name, array_struct_members, array_struct_affinity, array_struct_states, array_struct_derive, array_struct_invariants, array_struct_pos):
            for array_struct_member in array_struct_members |bytes, starts, lengths|:
                parser_cache_pymodule_fixed_array_expression(array_struct_member.type_expression, bytes, starts, lengths)
        if declaration is Decl.Enum(array_enum_name, array_enum_variants, array_enum_const, array_enum_storage, array_enum_pos):
            parser_cache_pymodule_fixed_array_expression(array_enum_storage, bytes, starts, lengths)
        if declaration is Decl.Alias(array_alias_name, array_alias_target, array_alias_pos):
            parser_cache_pymodule_fixed_array_expression(array_alias_target, bytes, starts, lengths)
        if declaration is Decl.Const(array_const_name, array_const_type, array_const_value, array_const_mutable, array_const_pos):
            parser_cache_pymodule_fixed_array_expression(array_const_type, bytes, starts, lengths)
        if declaration is Decl.Module(array_module_name, array_module_body, array_module_pos):
            parser_cache_pymodule_fixed_array_declarations(array_module_body, bytes, starts, lengths)
        if declaration is Decl.Scoped(array_scoped_body, array_scoped_pos):
            parser_cache_pymodule_fixed_array_declarations(array_scoped_body, bytes, starts, lengths)

extend Parser:
    public:
        # ============================================================
        # Region-polymorphic file parsing entry point
        # No Arena& param; region inferred from call site
        # Returns owned Ast::File with all AST nodes in inferred region
        # ============================================================

        def drain_pending_declarations(parser: lmut Parser, out: mutable darray[Ast::Decl]&) -> void:
            # Stage0 publishes declarations synthesized while parsing one top-level item
            # immediately after that item. Keeping the drain here (instead of at EOF) is
            # observable for source-order-sensitive emitters: a law's synthesized callable
            # must stay beside its Law node, and a machine's generated mode enum must stay
            # beside the function that owns it.
            machine over out for pending_decl in parser.pending_decls:
                state Drain
                start Drain

                Drain, _:
                    out.push(pending_decl)
                    -> Drain
            parser.pending_decls <- parser.pending_decls.truncate(0)

        def parse_file(source: u8&, tokens: darray[Token]) -> Ast::File:
            # Region is fully inferred: the parser's stores are backed by this function's
            # inferred auto-region, threaded into every helper call and adopted by the caller
            # on return (region-polymorphic return). No explicit Arena, no `@r`.
            parser: mutable Parser = Parser(source, tokens)
            top_items: mutable darray[Ast::Decl] = []
            parser <- parser.predeclare_handlers()

            machine over parser.position while true:
                state Scan
                state Parse
                start Scan

                Scan, _ if parser.peek() == TokenKind.Eof:
                    break

                Scan, _:
                    parser <- parser.skip_newlines()
                    -> Parse

                Parse, _ if parser.peek() == TokenKind.Eof:
                    break

                Parse, _:
                    before: usize = parser.position
                    parser <- parser.parse_declaration_unit(top_items)
                    parser <- parser.advance_if(parser.position == before)      # guarantee forward progress
                    parser <- parser.drain_pending_declarations(&top_items)
                    -> Scan

            parser <- parser.scan_legacy_error_syntax()
            parser <- parser.scan_allocation_regions()
            parser <- parser.scan_invalid_console_members()
            parser <- parser.scan_permission_param_members()

            pymodule_type_name_bytes: mutable darray[u8] = []
            pymodule_type_name_starts: mutable darray[usize] = []
            pymodule_type_name_lengths: mutable darray[usize] = []
            parser_cache_pymodule_container_declarations(top_items, &pymodule_type_name_bytes, &pymodule_type_name_starts, &pymodule_type_name_lengths)
            parser_cache_pymodule_fixed_array_declarations(top_items, &pymodule_type_name_bytes, &pymodule_type_name_starts, &pymodule_type_name_lengths)

            return Ast::File{
                top_decls: top_items,
                pymodule_type_name_bytes: pymodule_type_name_bytes,
                pymodule_type_name_starts: pymodule_type_name_starts,
                pymodule_type_name_lengths: pymodule_type_name_lengths,
                protocol_default_methods: parser.protocol_default_methods,
                errors: parser.errors,
                error_set_func_lines: parser.error_set_func_lines,
                error_set_func_names: parser.error_set_func_names,
                error_set_decl_names: parser.error_set_decl_names,
                signature_contract_lines: parser.signature_contract_lines,
                signature_contract_kinds: parser.signature_contract_kinds,
                signature_contract_exprs: parser.signature_contract_exprs,
                tuple_type_elements: parser.tuple_type_elements,
                tuple_type_starts: parser.tuple_type_starts,
                tuple_type_counts: parser.tuple_type_counts,
                tuple_type_lines: parser.tuple_type_lines,
                numeric_suffix_names: parser.numeric_suffix_names,
                numeric_suffix_lines: parser.numeric_suffix_lines,
                machine_coverage: parser.machine_coverage,
                derived_state_rules: parser.derived_state_rules,
                typestate_postconditions: parser.typestate_postconditions,
                generic_param_lines: parser.generic_param_lines,
                generic_param_names: parser.generic_param_names,
                generic_struct_decls: parser.generic_struct_decls,
                generic_struct_decl_names: parser.generic_struct_decl_names,
                generic_struct_decl_owners: parser.generic_struct_decl_owners,
                generic_struct_decl_lines: parser.generic_struct_decl_lines,
                generic_func_decls: parser.generic_func_decls,
                generic_func_decl_names: parser.generic_func_decl_names,
                generic_func_decl_owners: parser.generic_func_decl_owners,
                func_decl_lines: parser.func_decl_lines,
                func_decl_columns: parser.func_decl_columns,
                panic_lines: parser.panic_lines,
                panic_columns: parser.panic_columns,
                generic_func_decl_lines: parser.generic_func_decl_lines,
                annotation_args: parser.annotation_args,
                extern_params: parser.extern_params,
                extern_global_type_names: parser.extern_global_type_names,
                extern_global_type_exprs: parser.extern_global_type_exprs,
                local_region_annotations: parser.local_region_annotations,
                ghost_local_lines: parser.ghost_local_lines,
                static_assert_conds: parser.static_assert_conds,
                static_if_conds: parser.static_if_conds,
                static_if_lines: parser.static_if_lines,
                static_if_kinds: parser.static_if_kinds,
                static_assert_msgs: parser.static_assert_msgs,
                static_assert_lines: parser.static_assert_lines,
                allocation_region_names: parser.allocation_region_names,
                allocation_region_lines: parser.allocation_region_lines,
                enum_annotations: parser.enum_annotations,
                fn_type_param_lines: parser.fn_type_param_lines,
                fn_type_param_exprs: parser.fn_type_param_exprs,
                fn_type_return_lines: parser.fn_type_return_lines,
                fn_type_return_exprs: parser.fn_type_return_exprs,
                packed_enum_names: parser.packed_enum_names,
                alias_names: parser.alias_names,
                alias_targets: parser.alias_targets,
                alias_target_heads: parser.alias_target_heads,
                struct_names: parser.struct_names,
                struct_owners: parser.struct_owners,
                struct_member_rows: parser.struct_member_rows,
                struct_member_starts: parser.struct_member_starts,
                struct_member_counts: parser.struct_member_counts,
                enum_decl_names: parser.enum_decl_names,
                enum_decl_storage_heads: parser.enum_decl_storage_heads,
                enum_decl_is_const: parser.enum_decl_is_const,
                enum_decl_variant_names: parser.enum_decl_variant_names,
                enum_decl_variant_values: parser.enum_decl_variant_values,
                enum_decl_variant_starts: parser.enum_decl_variant_starts,
                enum_decl_variant_counts: parser.enum_decl_variant_counts,
                payload_enum_names: parser.payload_enum_names,
                payload_enum_is_const: parser.payload_enum_is_const,
                payload_enum_variant_starts: parser.payload_enum_variant_starts,
                payload_enum_variant_counts: parser.payload_enum_variant_counts,
                payload_enum_variant_names: parser.payload_enum_variant_names,
                payload_enum_variant_field_starts: parser.payload_enum_variant_field_starts,
                payload_enum_variant_field_counts: parser.payload_enum_variant_field_counts,
                payload_enum_variant_fields: parser.payload_enum_variant_fields,
                payload_enum_variant_field_names: parser.payload_enum_variant_field_names,
                enum_common_owners: parser.enum_common_owners,
                enum_common_counts: parser.enum_common_counts,
                enum_common_starts: parser.enum_commons_start,
                enum_common_fields: parser.enum_commons_field,
                enum_common_field_names: parser.enum_commons_name
            }


        # Read scalar token fields through a reference to the backing array instead of
        # repeatedly materializing the 20-byte Token value in a full-file machine. The
        # stage1 backend lowers a direct `tokens[index]` value expression to a stack
        # temporary; inside a million-token scan that temporary was not reclaimed per
        # iteration and the self-hosted gen3 binary exhausted its native stack.
        def scan_token_ref(parser: Parser&, index: usize) -> Token&:
            trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic]:
                first: Token& = &parser.tokens[0.usize()]
                return (first.cast[u8&] + index * size_of(Token)).cast[Token&]

        def scan_token_kind(parser: Parser&, index: usize) -> TokenKind:
            token: Token& = parser.scan_token_ref(index)
            return token.kind

        def scan_token_line(parser: Parser&, index: usize) -> u32:
            token: Token& = parser.scan_token_ref(index)
            return token.line

        def scan_token_text(parser: Parser&, index: usize) -> sview:
            token: Token& = parser.scan_token_ref(index)
            return Lexer::text_or_empty(token, parser.source)

        def scan_allocation_regions(parser: lmut Parser) -> void:
            can Memory.Allocate, Abort.Panic:
                machine over parser.tokens for index in 0..<parser.tokens.count:
                    state Scan
                    start Scan

                    Scan, _ if index + 2 >= parser.tokens.count:
                        -> Scan

                    Scan, _ if (parser.scan_token_kind(index) == TokenKind.New or (parser.scan_token_kind(index) == TokenKind.Ident and parser.scan_token_text(index) == "new")) and parser.scan_token_kind(index + 1) == TokenKind.LBracket and parser.scan_token_kind(index + 2) == TokenKind.Ident:
                        parser.allocation_region_names <- parser.allocation_region_names.push(parser.scan_token_text(index + 2))
                        parser.allocation_region_lines <- parser.allocation_region_lines.push(parser.scan_token_line(index))
                        -> Scan

                    Scan, _:
                        -> Scan


        def scan_invalid_console_members(parser: lmut Parser) -> void:
            can Memory.Allocate, Abort.Panic:
                machine over parser.tokens for index in 0..<parser.tokens.count:
                    state Scan
                    start Scan

                    Scan, _ if index + 2 >= parser.tokens.count:
                        -> Scan

                    Scan, _ if index > 0 and parser.scan_token_kind(index - 1) == TokenKind.Ident and parser.scan_token_text(index - 1) == "can" and parser.scan_token_kind(index) == TokenKind.Ident and parser.scan_token_text(index) == "Console" and parser.scan_token_kind(index + 1) == TokenKind.Dot and parser.scan_token_kind(index + 2) == TokenKind.Ident and parser.scan_token_text(index + 2) != "Format" and parser.scan_token_text(index + 2) != "Write":
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__invalid_console", name: parser.scan_token_text(index + 2), line: parser.scan_token_line(index)})
                        -> Scan

                    Scan, _:
                        -> Scan


        # Permission-row parameters stand for a complete permission value. Unlike a
        # concrete permission family (`Console.Write`), they cannot be qualified with a
        # member (`P.Write`). Preserve this source-level distinction for semantic
        # diagnostics; the compact type AST intentionally erases generic-parameter kinds.
        def permission_param_on_line(names: darray[sview]&, lines: darray[u32]&, name: sview, line: u32) -> bool:
            can Abort.Panic:
                machine over names for index in 0..<names.count:
                    state Scan
                    start Scan

                    Scan, _ if names[index] == name and lines[index] == line:
                        return true

                    Scan, _:
                        -> Scan
                return false


        def scan_permission_param_members(parser: lmut Parser) -> void:
            can Memory.Allocate, Abort.Panic:
                permission_params: mutable darray[sview] = []
                permission_param_lines: mutable darray[u32] = []
                machine over parser.tokens for index in 0..<parser.tokens.count:
                    state Scan
                    start Scan

                    Scan, _ if index + 1 >= parser.tokens.count:
                        -> Scan

                    Scan, _ if parser.scan_token_kind(index) == TokenKind.Ident and parser.scan_token_text(index) == "permission" and parser.scan_token_kind(index + 1) == TokenKind.Ident:
                        permission_params.push(parser.scan_token_text(index + 1))
                        permission_param_lines.push(parser.scan_token_line(index + 1))
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__permission_param_decl", name: parser.scan_token_text(index + 1), line: parser.scan_token_line(index + 1)})
                        -> Scan

                    Scan, _:
                        -> Scan

                machine over parser.tokens for index in 0..<parser.tokens.count:
                    state Scan
                    start Scan

                    Scan, _ if index + 2 >= parser.tokens.count:
                        -> Scan

                    Scan, _ if parser.scan_token_kind(index) == TokenKind.Ident and parser.scan_token_kind(index + 1) == TokenKind.Dot and parser.scan_token_kind(index + 2) == TokenKind.Ident and permission_param_on_line(permission_params, permission_param_lines, parser.scan_token_text(index), parser.scan_token_line(index)):
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__permission_param_member", name: parser.scan_token_text(index), line: parser.scan_token_line(index)})
                        -> Scan

                    Scan, _:
                        -> Scan

        def scan_legacy_error_syntax(parser: lmut Parser) -> void:
            can Memory.Allocate, Abort.Panic:
                machine over parser.enum_annotations for token_index in 0..<parser.tokens.count:
                    state Scan(saw_arrow: bool)
                    start Scan(false)

                    Scan(_), _ if parser.scan_token_kind(token_index) == TokenKind.Newline:
                        -> Scan(false)

                    Scan(_), _ if parser.scan_token_kind(token_index) == TokenKind.Arrow:
                        -> Scan(true)

                    Scan(saw_arrow), _ if parser.scan_token_kind(token_index) == TokenKind.Error and token_index + 5 < parser.tokens.count and parser.scan_token_kind(token_index + 1) == TokenKind.LBracket and parser.scan_token_kind(token_index + 2) == TokenKind.Ident and parser.scan_token_kind(token_index + 3) == TokenKind.Dot and parser.scan_token_kind(token_index + 4) == TokenKind.Star and parser.scan_token_kind(token_index + 5) == TokenKind.RBracket:
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "", name: "__legacy_error_wildcard", line: parser.scan_token_line(token_index)})
                        -> Scan(saw_arrow)

                    Scan(true), _ if parser.scan_token_kind(token_index) == TokenKind.Pipe:
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "", name: "__legacy_error_pipe", line: parser.scan_token_line(token_index)})
                        -> Scan(true)

                    # `error[Set, ...]`: a Comma directly followed by `...` inside the set is
                    # the dropped open-suffix form (deprecated: a bare set name means the family).
                    Scan(true), _ if parser.scan_token_kind(token_index) == TokenKind.Comma and token_index + 1 < parser.tokens.count and parser.scan_token_kind(token_index + 1) == TokenKind.Ellipsis:
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "", name: "__legacy_error_open", line: parser.scan_token_line(token_index)})
                        -> Scan(true)

                    Scan(saw_arrow), _:
                        -> Scan(saw_arrow)
