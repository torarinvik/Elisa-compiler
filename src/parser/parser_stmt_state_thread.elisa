# Identity-yielding field-update blocks thread their target in place. Preserve
# lexical scopes and cleanup; erase only the proven redundant aggregate result.
extend Parser:
    private:
        def state_thread_root(value: Ast::Expr, name: sview) -> bool:
            match value:
                Ast::Expr.Ident(found, _):
                    return found == name
                Ast::Expr.Field(base, _, _):
                    return state_thread_root(base, name)
                _:
                    return false

        def state_thread_binding_condition(value: Ast::Expr) -> bool:
            match value:
                Ast::Expr.Binary(left, op, right, _):
                    return op == TokenKind.Is or state_thread_binding_condition(left) or state_thread_binding_condition(right)
                Ast::Expr.Unary(_, operand, _):
                    return state_thread_binding_condition(operand)
                Ast::Expr.Paren(inner, _):
                    return state_thread_binding_condition(inner)
                _:
                    return false

        # 0 is an ordinary value, 1 is identity, 2 is identity with field writes.
        def state_thread_shape(value: Ast::Expr, name: sview) -> i64:
            match value:
                Ast::Expr.Ident(found, _):
                    return 1 if found == name else 0
                Ast::Expr.Paren(inner, _):
                    return state_thread_shape(inner, name)
                Ast::Expr.If(condition, yes, no, _):
                    return 0 if state_thread_binding_condition(condition)
                    left: i64 = state_thread_shape(yes, name)
                    right: i64 = state_thread_shape(no, name)
                    return 0 if left == 0 or right == 0
                    return 2 if left == 2 or right == 2 else 1
                Ast::Expr.Block(statements, block_value, _, _):
                    shape: mutable i64 = state_thread_shape(block_value, name)
                    return 0 if shape == 0
                    for statement in statements |shape|:
                        match statement:
                            Ast::Stmt.VarDecl(declared, _, _, _):
                                return 0 if declared == name
                            Ast::Stmt.Assign(target, op, _, _):
                                return 0 if op == TokenKind.Assign
                                match target:
                                    Ast::Expr.Field(_, _, _):
                                        shape <- 2 if state_thread_root(target, name)
                                    Ast::Expr.Ident:
                                        pass
                                    _:
                                        return 0
                            Ast::Stmt.Block(kind, _, _, _, _):
                                return 0 if kind != "defer"
                            _:
                                # Unknown binding forms may shadow the identity result.
                                return 0
                    return shape
                _:
                    return 0

        def erase_state_thread_result(value: Ast::Expr, name: sview) -> Ast::Expr:
            match value:
                Ast::Expr.Block(statements, block_value, captures, pos):
                    allowed: mutable darray[sview] = []
                    found: mutable bool = false
                    for capture in captures |found, allowed|:
                        allowed.push(capture)
                        found <- true if capture == name
                    allowed.push(name) if not found
                    return Ast::Expr.Block(statements, erase_state_thread_result(block_value, name), allowed, pos)
                Ast::Expr.If(condition, yes, no, pos):
                    return Ast::Expr.If(condition, erase_state_thread_result(yes, name), erase_state_thread_result(no, name), pos)
                Ast::Expr.Paren(inner, _):
                    return erase_state_thread_result(inner, name)
                _:
                    return Ast::Expr.IntLit(0, Ast::pos_at_line(0))

        def state_thread_assignment(target: Ast::Expr, value: Ast::Expr) -> Ast::Stmt?:
            match target:
                Ast::Expr.Ident(name, pos):
                    match value:
                        Ast::Expr.Block(_, _, captures, _):
                            if captures.count == 0 and state_thread_shape(value, name) == 2:
                                return Ast::Stmt.Expr(erase_state_thread_result(value, name), pos)
                        _:
                            pass
                _:
                    pass
            return null
