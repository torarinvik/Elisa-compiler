extend Parser:
    private:
        def primary_catch_expression(parser: lmut Parser, token: Token) -> Ast::Expr?:
            can Memory.Allocate, Abort.Panic:
                # `catch EXPR:` fallible expression with success/error arms
                # (`return catch self.foo(...):`). The guarded expression is the
                # value; the `:` arm block is parsed and consumed. (Statement-position
                # `catch:` is handled earlier in statement(); this is the expression form.)
                parser, _ <- parser.advance()                       # `catch`
                rebind guarded: Ast::Expr, parser = get parser.expression() can Global{Read,Write}
                catch_result: mutable Ast::Expr = guarded
                if parser.peek() == TokenKind.Colon:
                    rebind catch_arms: darray[Ast::MatchArm], parser = parser.parse_catch_arm_block(token) can Global{Read,Write}
                    callee_name: sview = parser.catch_callee_name(guarded)
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: callee_name, name: "__catch_expr", line: token.line, offset: token.start, module: parser.current_module}) if callee_name != ""
                    parser <- parser.record_static_if_branch_rows("__catch_expr_static_branch", callee_name, token) if callee_name != ""
                    catch_callee_module: sview @source = parser.try_expression_qualifier(guarded)
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__catch_callee_module", name: catch_callee_module, line: token.line, offset: token.start, module: parser.current_module}) if catch_callee_module != ""
                    # Keep each arm's packed pattern accessed by index while passing only its
                    # pattern to the recursive recorder, so nested Or alternatives are retained.
                    catch_module: sview @source = parser.current_module
                    while arm_index < catch_arms.count |arm_index: usize = 1, parser, catch_module|:
                        parser <- parser.record_catch_pattern_annotations(catch_arms[arm_index].pattern, callee_name, token.line, token.start, catch_module)
                        arm_index <- arm_index + 1
                    catch_result <- (Ast::Expr.Catch(guarded, catch_arms, Ast::pos_of_token(token)))
                return catch_result


        def primary_keyword_expression(parser: lmut Parser, kind: TokenKind, token: Token) -> Ast::Expr?:
            no_expr: Ast::Expr? = null
            if kind == TokenKind.True or kind == TokenKind.False:
                    parser, _ <- parser.advance()
                    return (Ast::Expr.BoolLit(kind == TokenKind.True, Ast::pos_of_token(token)))

                # `raise Error.Tag` is a terminating expression with an unparenthesized
                # operand. Model it as a call-shaped node so generic expression walkers
                # retain the tag and flow analysis still recognizes the `raise` head.
            if kind == TokenKind.Raise:
                    parser, _ <- parser.advance()
                    raise_head: Ast::Expr = (Ast::Expr.Ident("raise", Ast::pos_of_token(token)))
                    rebind raised_value: Ast::Expr?, parser = parser.unary_expression() can Global{Read,Write}, Memory.Allocate
                    if raised_value is raised_expression:
                        raise_arguments: darray[Ast::Expr] @source = [raised_expression]
                        raise_argument_names: darray[sview @source] @source = [""]
                        return (Ast::Expr.Call(raise_head, raise_arguments, raise_argument_names, Ast::pos_of_token(token)))
                    else:
                        return raise_head

                # Leaf keywords recorded as identifier nodes: `null` (no dedicated Null
                # node yet), `sizeof`/`alignof`/`offsetof` (the following `(...)` is
                # consumed by the postfix Call rule), `panic`/`raise` (operand consumed
                # by the postfix/unary rules), and `zeroed`.
            if kind == TokenKind.Null or kind == TokenKind.Sizeof or kind == TokenKind.Alignof or kind == TokenKind.Offsetof or kind == TokenKind.Panic or kind == TokenKind.Zeroed or kind == TokenKind.Error:
                    spelling: sview = Lexer::text_or_empty(token, parser.source, parser.source_length)
                    parser <- parser.error_removed(token, "`sizeof` has been removed; use `size_of`") if spelling == "sizeof"
                    parser <- parser.error_removed(token, "`alignof` has been removed; use `align_of`") if spelling == "alignof"
                    parser <- parser.error_removed(token, "`offsetof` has been removed; use `offset_of`") if spelling == "offsetof"
                    if kind == TokenKind.Panic:
                        parser.panic_lines <- parser.panic_lines.push(token.line)
                        parser.panic_columns <- parser.panic_columns.push(token.column)
                    parser, _ <- parser.advance()
                    return (Ast::Expr.Ident(Lexer::text_or_empty(token, parser.source, parser.source_length), Ast::pos_of_token(token)))

            if kind == TokenKind.New:
                    # `new [region] Type(...)`: skip the keyword and optional region
                    # bracket, then parse the constructor expression as the value. The marker
                    # is recorded against the resulting AST target after it has been parsed.
                    parser, _ <- parser.advance()
                    rebind accepted_lbracket_2: bool, parser = parser.accept(TokenKind.LBracket)
                    if accepted_lbracket_2:
                        machine over parser.position while true:
                            state Scan
                            start Scan

                            Scan, _ if parser.peek() == TokenKind.RBracket or parser.peek() == TokenKind.Eof:
                                break

                            Scan, _:
                                parser.position <- parser.position + 1
                                -> Scan
                        parser, _ <- parser.accept(TokenKind.RBracket)
                    rebind __v_141: Ast::Expr?, parser = parser.postfix_expression() can Global{Read,Write}, Memory.Allocate
                    if __v_141 is new_construct_operand:
                        new_construct_pos: Ast::Pos = new_construct_target_position(new_construct_operand)
                        parser <- parser.record_new_construct(new_construct_pos)
                    return __v_141

            if kind == TokenKind.LParen:
                    rebind parenthesized: Ast::Expr?, parser = parser.parenthesized_expression(token) can Global{Read,Write}
                    return parenthesized

            if kind == TokenKind.LBracket:
                    rebind __v_184: Ast::Expr?, parser = parser.array_literal() can Global{Read,Write}
                    return __v_184

            if kind == TokenKind.LBrace:
                    rebind __v_187: Ast::Expr?, parser = parser.brace_literal() can Global{Read,Write}
                    return __v_187

            if kind == TokenKind.Dot:
                    # Leading-dot enum shorthand `.Variant` / `.A.B` — the enclosing enum
                    # type is inferred from context. Consume the whole `.Ident(.Ident)*`
                    # chain here; a following call/index is handled by the postfix rule.
                    parser, _ <- parser.advance()                       # leading `.`
                    parts: mutable darray[sview @source] @source = []
                    rebind first_part: Token, parser = parser.expect(TokenKind.Ident)
                    parts.push(Lexer::text_or_empty(first_part, parser.source, parser.source_length))
                    machine over parser.position while true:
                        state More
                        start More

                        More, _ if parser.peek() != TokenKind.Dot:
                            break

                        More, _:
                            parser.position <- parser.position + 1
                            rebind next_part: Token, parser = parser.expect(TokenKind.Ident)
                            parts.push(Lexer::text_or_empty(next_part, parser.source, parser.source_length))
                            -> More
                    return (Ast::Expr.ShorthandMember(parts, Ast::pos_of_token(token)))

            if kind == TokenKind.Try:
                    if parser.peek_at(1) == TokenKind.Question:
                        parser <- parser.error_removed(token, "`try? ... default` is no longer supported; use `try ... else ...`")
                        parser <- parser.skip_removed_line()
                        return (Ast::Expr.Invalid)
                    # `try EXPR else <recovery>` inline recovery expression — same shape
                    # as `get …`; the guarded expression is the value.
                    rebind __v_205: Ast::Expr?, parser = parser.get_expression() can Global{Read,Write}
                    return __v_205

            if kind == TokenKind.Catch:
                rebind catch_expression: Ast::Expr?, parser = parser.primary_catch_expression(token) can Global{Read,Write}, Memory.Allocate
                return catch_expression
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedInExpression, token)
            parser, _ <- parser.advance()   # consume the offending token so callers don't re-error on it
            return no_expr

include "./parser_expr_primary.elisa"
