extend Parser:
    public:
        # Per declared state: no arms is an error; an irrefutable arm before the last makes
        # the rest unreachable; an open-domain state with no irrefutable arm cannot be
        # total. Errors anchor at the machine head token.
        def check_machine_coverage(parser: lmut Parser, states: darray[MachineStateAst], arms: darray[MachineArmAst], machine_token: Token) -> void:
            state_index: mutable usize = 0
            while state_index < states.count |parser, state_index|:
                state_name: sview = states[state_index].name
                total_for_state: mutable usize = 0
                counting: mutable usize = 0
                while counting < arms.count |total_for_state, counting|:
                    total_for_state <- total_for_state + 1 if arms[counting].state_name == state_name
                    counting <- counting + 1
                has_wildcard: mutable bool = false
                has_open_domain: mutable bool = false
                seen: mutable usize = 0
                # Literal inputs already handled by an earlier unguarded, payload-
                # unconditional arm of this state — a repeat is unreachable (docs/123 §5).
                seen_literals: mutable darray[Ast::Expr] = []
                arm_index: mutable usize = 0
                while arm_index < arms.count |parser, has_wildcard, has_open_domain, seen, seen_literals, arm_index|:
                    if arms[arm_index].state_name == state_name:
                        seen <- seen + 1
                        if machine_arm_irrefutable(arms[arm_index]):
                            has_wildcard <- true
                            parser <- parser.error_named(Ast::ParseErrorKind.MachineArmUnreachable, machine_token, state_name, "", (seen + 1).u32()) if seen < total_for_state
                        has_open_domain <- true if machine_arm_open_domain(arms[arm_index])
                        # Only an unguarded, payload-unconditional arm claims exclusive
                        # coverage of a literal, so only those participate in the check.
                        if machine_expr_is_invalid(arms[arm_index].guard) and machine_payloads_unconditional(arms[arm_index]):
                            literal_index: mutable usize = 0
                            while literal_index < arms[arm_index].input_literals.count |parser, seen_literals, literal_index|:
                                literal: Ast::Expr = arms[arm_index].input_literals[literal_index]
                                duplicate: mutable bool = false
                                for previous in seen_literals:
                                    duplicate <- true if machine_literal_equal(previous, literal)
                                repeat_text: sview = machine_arm_input_literal_text(arms[arm_index], literal_index)
                                parser <- parser.error_named(Ast::ParseErrorKind.MachineArmRepeatsInput, machine_token, state_name, repeat_text) if duplicate
                                seen_literals.push(literal) if not duplicate
                                literal_index <- literal_index + 1
                    arm_index <- arm_index + 1
                parser <- parser.error_named(Ast::ParseErrorKind.MachineStateNoArms, machine_token, state_name, "") if total_for_state == 0
                parser <- parser.error_named(Ast::ParseErrorKind.MachineStateNotTotal, machine_token, state_name, "") if has_open_domain and not has_wildcard
                state_index <- state_index + 1



        # docs/125 §9 Tier-2: the classifier function name of a `machine over` input, or "" when
        # the input is not a bare free-function call (a method-call / literal input is open-domain,
        # already handled by the parser's per-state coverage check).
        def machine_input_callee(expression: Ast::Expr) -> sview @source:
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, call_line):
                    return machine_expr_ident_name(callee)
                _:
                    return ""



        # The variant name of an enum tag input: either `Enum.Variant` (Field) or `.Variant`
        # (ShorthandMember), or "" for a literal/range/non-tag input.
        def machine_arm_variant_tag(expression: Ast::Expr) -> sview @source:
            match expression:
                Ast::Expr.Field(object, field, field_line):
                    return field
                Ast::Expr.ShorthandMember(parts, _):
                    return parts[parts.count - 1] if parts.count > 0
                    return ""
                _:
                    return ""



        # Record MachineCoverageRow arm-atoms of a classifier-input machine (docs/125 §9 Tier-2):
        # one row per spelled variant tag + one wildcard-marker row per wildcard/bind arm.
        # Non-classifier inputs record nothing — open-domain totality is the parser's job.
        def record_machine_coverage(parser: lmut Parser, arms: darray[MachineArmAst] @source, input_expression: Ast::Expr, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                input_callee: sview @source = machine_input_callee(input_expression)
                return if input_callee == ""
                machine over parser.machine_coverage for arm in arms:
                    state Scan
                    start Scan

                    Scan, _ if arm.input_wild:
                        parser.machine_coverage <- parser.machine_coverage.push(Ast::MachineCoverageRow{input_callee: input_callee, state_name: arm.state_name, tag: "", has_wildcard: true, line: line})
                        -> Scan

                    Scan, _:
                        parser <- parser.record_machine_literal_coverage(arm, input_callee, line)
                        -> Scan



        def record_machine_literal_coverage(parser: lmut Parser, arm: MachineArmAst, input_callee: sview @source, line: u32) -> void:
            machine over parser.machine_coverage for literal in arm.input_literals:
                state Scan
                start Scan

                Scan, _ if machine_arm_variant_tag(literal) == "":
                    -> Scan

                Scan, _:
                    parser.machine_coverage <- parser.machine_coverage.push(Ast::MachineCoverageRow{input_callee: input_callee, state_name: arm.state_name, tag: machine_arm_variant_tag(literal), has_wildcard: false, line: line})
                    -> Scan
