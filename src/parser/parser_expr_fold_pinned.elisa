# Fixed eight-lane fold lowering. The tree and remainder order mirror Stage0.
extend Parser:
    private:
        # Fixed lane names are compiler-generated locals. If source code uses
        # one, the scalar form retains its lexical meaning without shadowing.
        def fold_pinned_reserved_name(name: sview) -> bool:
            return name == "__fold_n" or name == "__fold_i" or name == "__fold_a0" or name == "__fold_a1" or name == "__fold_a2" or name == "__fold_a3" or name == "__fold_a4" or name == "__fold_a5" or name == "__fold_a6" or name == "__fold_a7"

        def fold_pinned_name_conflict(source: Ast::Expr, item: sview, accumulator: sview, transform: Ast::Expr) -> bool:
            source_name: sview = match source:
                Ast::Expr.Ident(name, _): name
                _: ""
            return fold_pinned_reserved_name(source_name) or fold_pinned_reserved_name(item) or fold_pinned_reserved_name(accumulator) or machine_expr_mentions_ident(transform, "", true)

        def fold_identifier(name: sview @source, pos: Ast::Pos) -> Ast::Expr:
            return (Ast::Expr.Ident(name, pos))

        def fold_number(value: i64, pos: Ast::Pos) -> Ast::Expr:
            return (Ast::Expr.IntLit(value, pos))

        def fold_binary(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, pos: Ast::Pos) -> Ast::Expr:
            return (Ast::Expr.Binary(left, operator, right, pos))

        def fold_assignment(name: sview @source, value: Ast::Expr, pos: Ast::Pos) -> Ast::Stmt:
            return (Ast::Stmt.Assign(fold_identifier(name, pos), TokenKind.LArrow, value, pos))

        def fold_mutable_declaration(parser: lmut Parser, name: sview @source, type_expression: Ast::Expr, value: Ast::Expr, pos: Ast::Pos) -> Ast::Stmt:
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__loop_header_accumulator", line: pos.line, offset: pos.offset})
            return (Ast::Stmt.VarDecl(name, type_expression, value, pos))

        def pinned_fold(parser: lmut Parser, source: Ast::Expr, item: sview @source, accumulator: sview @source, accumulator_type: Ast::Expr, seed: Ast::Expr, transform: Ast::Expr, first_transform: Ast::Expr, operator: TokenKind, pos: Ast::Pos, accumulator_pos: Ast::Pos) -> Ast::Expr:
            lanes: darray[sview @source] @source = ["__fold_a0", "__fold_a1", "__fold_a2", "__fold_a3", "__fold_a4", "__fold_a5", "__fold_a6", "__fold_a7"]
            absent_type: Ast::Expr = (Ast::Expr.Invalid)
            identity: mutable Ast::Expr = fold_number(1 if operator == TokenKind.Star else 0, pos)
            if seed is Ast::Expr.FloatLit(_, _):
                identity <- (Ast::Expr.FloatLit("1.0" if operator == TokenKind.Star else "0.0", pos))
            length: Ast::Expr = (Ast::Expr.Field(source, "count", pos))
            length_decl: Ast::Stmt = (Ast::Stmt.VarDecl("__fold_n", absent_type, length, pos))
            rebind accumulator_decl: Ast::Stmt, parser = parser.fold_mutable_declaration(accumulator, accumulator_type, seed, accumulator_pos)
            first: Ast::Expr = (Ast::Expr.Index(source, fold_number(0, pos), pos))
            large: mutable darray[Ast::Stmt] @source = []
            rebind item_decl: Ast::Stmt, parser = parser.fold_mutable_declaration(item, absent_type, first, pos)
            large.push(item_decl)
            for lane_index in 0..<lanes.count |parser, large|:
                lane_seed: Ast::Expr = seed if lane_index == 0 else identity
                rebind lane_decl: Ast::Stmt, parser = parser.fold_mutable_declaration(lanes[lane_index], absent_type, lane_seed, pos)
                large.push(lane_decl)
            rebind index_decl: Ast::Stmt, parser = parser.fold_mutable_declaration("__fold_i", (Ast::Expr.Ident("usize", pos)), fold_number(0, pos), pos)
            large.push(index_decl)
            main_body: mutable darray[Ast::Stmt] @source = []
            for lane_index in 0..<lanes.count |main_body|:
                index: Ast::Expr = fold_identifier("__fold_i", pos) if lane_index == 0 else fold_binary(fold_identifier("__fold_i", pos), TokenKind.Plus, fold_number(lane_index.i64(), pos), pos)
                main_body.push(fold_assignment(item, (Ast::Expr.Index(source, index, pos)), pos))
                lane_transform: Ast::Expr = first_transform if lane_index == 0 else (get fold_clone_transform(transform) else (Ast::Expr.Invalid))
                main_body.push(fold_assignment(lanes[lane_index], fold_binary(fold_identifier(lanes[lane_index], pos), operator, lane_transform, pos), pos))
            main_body.push(fold_assignment("__fold_i", fold_binary(fold_identifier("__fold_i", pos), TokenKind.Plus, fold_number(8, pos), pos), pos))
            main_condition: Ast::Expr = fold_binary(fold_binary(fold_identifier("__fold_i", pos), TokenKind.Plus, fold_number(8, pos), pos), TokenKind.LtEq, fold_identifier("__fold_n", pos), pos)
            large.push((Ast::Stmt.While(main_condition, main_body, pos)))
            remainder_transform: Ast::Expr = get fold_clone_transform(transform) else (Ast::Expr.Invalid)
            remainder: darray[Ast::Stmt] @source = [fold_assignment(item, (Ast::Expr.Index(source, fold_identifier("__fold_i", pos), pos)), pos), fold_assignment(lanes[0], fold_binary(fold_identifier(lanes[0], pos), operator, remainder_transform, pos), pos), fold_assignment("__fold_i", fold_binary(fold_identifier("__fold_i", pos), TokenKind.Plus, fold_number(1, pos), pos), pos)]
            large.push((Ast::Stmt.While(fold_binary(fold_identifier("__fold_i", pos), TokenKind.Lt, fold_identifier("__fold_n", pos), pos), remainder, pos)))
            pair01: Ast::Expr = fold_binary(fold_identifier(lanes[0], pos), operator, fold_identifier(lanes[1], pos), pos)
            pair23: Ast::Expr = fold_binary(fold_identifier(lanes[2], pos), operator, fold_identifier(lanes[3], pos), pos)
            pair45: Ast::Expr = fold_binary(fold_identifier(lanes[4], pos), operator, fold_identifier(lanes[5], pos), pos)
            pair67: Ast::Expr = fold_binary(fold_identifier(lanes[6], pos), operator, fold_identifier(lanes[7], pos), pos)
            tree: Ast::Expr = fold_binary(fold_binary(pair01, operator, pair23, pos), operator, fold_binary(pair45, operator, pair67, pos), pos)
            large.push(fold_assignment(accumulator, tree, pos))
            small_transform: Ast::Expr = get fold_clone_transform(transform) else (Ast::Expr.Invalid)
            small_update: Ast::Stmt = fold_assignment(accumulator, fold_binary(fold_identifier(accumulator, pos), operator, small_transform, pos), pos)
            small_loop: Ast::Stmt = (Ast::Stmt.For("", [item], source, [small_update], pos))
            branch: Ast::Stmt = (Ast::Stmt.If(fold_binary(fold_identifier("__fold_n", pos), TokenKind.GtEq, fold_number(8, pos), pos), large, [small_loop], pos))
            return (Ast::Expr.Block([length_decl, accumulator_decl, branch], fold_identifier(accumulator, accumulator_pos), [], pos))
