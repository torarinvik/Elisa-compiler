# The parser's generated-name pools (module, machine and handler names). The AST keeps
# views into these bytes for its whole lifetime, so a buffer must never reallocate once a
# view into it exists. `@append_only` makes the compiler ENFORCE that (see
# semantic/check_append_only_store.elisa): only `make_room` and `append` touch the buffers,
# and `make_room` only retires a full buffer (keeps it, never writes it again) and starts a
# fresh one. A store never grows past its reservation, and never frees.
module NameStore:
    @append_only
    struct Store:
        private:
            current: mutable darray[u8]
            retired: mutable darray[darray[u8]]

    def new_store() -> Store:
        return Store{current: [], retired: []}

    # Room for NEEDED more bytes without growing: retire the current buffer if it cannot
    # take them. A fresh buffer reserves max(needed, chunk). Retiring an empty buffer is
    # harmless (it holds no bytes), so the retire step is unconditional.
    def make_room[@r](store: mutable Store& @r, needed: usize, chunk: usize) -> void:
        return if store.current.count + needed <= store.current.capacity
        store.retired.push(store.current)
        store.current <- []
        store.current.reserve(needed if needed > chunk else chunk)

    # Copy BYTES into the store and return a view of the copy, valid for the store's life.
    def append[@r](store: mutable Store& @r, bytes: darray[u8]&, chunk: usize) -> sview:
        make_room(store, bytes.count, chunk)
        start: usize = store.current.count
        for index in 0..<bytes.count |store, bytes|:
            store.current.push(bytes[index])
        return bytes_view_range(store.current, start, bytes.count)
