def lie1() -> sview:
    x: mutable darray[u8] = [65, 66]
    p: static u8& = (&x[0]).cast[static u8&]
    trusted Unsafe.PointerCast:
        return StringView{data: p, len: 2}

def lie2() -> static u8&:
    v: u8 = 65
    return (&v).cast[static u8&]

def lie3(k: u8) -> sview:
    x: mutable darray[u8] = []
    x.push(k)
    p: static u8& = (&x[0]).cast[static u8&]
    trusted Unsafe.PointerCast:
        return StringView{data: p, len: 1}

def main() -> i32:
    return 0
