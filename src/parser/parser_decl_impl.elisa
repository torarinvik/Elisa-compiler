# Stage1 parser — `impl`, protocol, and named-block declarations (`extend Parser:
# private:`). Covers impl blocks and their contract spans, protocol default methods and
# body rejection, permission includes, frame-clause scanning, and `static if` at
# declaration level. Continues parser_decl_dispatch.elisa; split out to keep each part
# file under 600 lines.

extend Parser:
    private:

        # `impl[params] Trait for Type:` (or inherent `impl Type:`) — a trait/inherent
        # implementation block. The header (`[params] Trait for Type`) is skipped to the
        # colon; the body's method declarations are captured in a `Decl.Scoped` node (its
        # own scope) so a method with the same signature in another impl — e.g.
        # `br_remaining(self: Self)` implemented for two types — is not a duplicate.
        def impl_declaration(parser: lmut Parser, out: mutable darray[Ast::Decl]&) -> void:
            head: Token = parser.cursor()
            parser, _ <- parser.advance()
            # `impl[T] I for C[T]:` — a GENERIC impl block carries its own type parameters
            # between `impl` and the interface name. Consume and record them here, before the
            # header-shape tests below, which read bare token POSITIONS: with the `[T]` still in
            # front, `parser.peek()` was LBracket, neither branch fired, and the parameters were
            # skipped along with the rest of the header by skip_declaration_header_clauses.
            rebind accepted_impl_params: bool, parser = parser.accept(TokenKind.LBracket)
            parser <- parser.capture_impl_generic_params() if accepted_impl_params
            if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Ident and parser.peek_at(2) == TokenKind.Ident:
                interface_token: Token = parser.cursor()
                for_token: Token = parser.tokens[parser.position + 1]
                concrete_token: Token = parser.tokens[parser.position + 2]
                interface_name: sview = Lexer::text_or_empty(interface_token, parser.source)
                for_text: sview = Lexer::text_or_empty(for_token, parser.source)
                concrete_name: sview = Lexer::text_or_empty(concrete_token, parser.source)
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: concrete_name, name: interface_name, line: 0}) if for_text == "for"
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: interface_name, name: interface_name, line: 3900000014}) if for_text == "for"
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__impl_scope", name: interface_name, line: head.line}) if for_text == "for"
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__impl_concrete", name: concrete_name, line: head.line}) if for_text == "for"
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__impl_derived", name: interface_name, line: head.line}) if for_text == "for" and parser.pending_decorators.count > 0
                parser <- parser.capture_impl_contract_spans() if for_text == "for"
            # `impl C:` with NO `for` is an EXTENSION impl: its members are extension methods
            # on C, which stage0 names `__ext__<method>__<C>__<method>`. The branch above only
            # fires for the three-identifier `impl I for C` form, so this shape recorded
            # nothing and its methods were emitted under their bare names.
            if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon:
                extension_token: Token = parser.cursor()
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__ext_concrete", name: Lexer::text_or_empty(extension_token, parser.source), line: head.line})
            parser <- parser.skip_declaration_header_clauses(false)
            parser <- parser.parse_scoped_block(out, head)


        # The generic parameters of `impl[T] I for C[T]:`, entered just after the `[`.
        # Consumes through the matching `]`, then peek-scans the impl BODY (which is parsed
        # normally afterwards) and records each parameter against EVERY member `def`'s line on
        # the same side table function-level generics use — generic_param_lines /
        # generic_param_names, keyed by the `def` token's line, which is exactly what
        # Decl.Func carries.
        #
        # That is the whole of it: a member of a generic impl then registers as a generic
        # TEMPLATE, precisely as if it had been spelled `def store_get[T](s: darray[T]&, …)`.
        # record_generic_func_metadata puts it in the generic table, decl_line_is_generic keeps
        # the eager declare/emit passes off it, and resolve_declarations binds `T` inside its
        # body. Before this the `[T]` was captured nowhere, so declare_function_impl resolved
        # the member's `darray[T]&` with no binding for T, got TypeKind.Unmodeled and returned
        # null — declining the member and, because a unit is dropped whole when any function
        # declines, every other function with it ("backend emitted no functions for this unit;
        # declined 40: store_get, store_count, store_find, …" for a program as small as
        # `print(42)`, which reaches the std's Store impls through string interning).
        #
        # Parameter-list shape mirrors capture_function_generic_params: a top-level identifier
        # after `[` or `,` is a parameter, a `:` introduces a BOUND whose names are skipped.
        def capture_impl_generic_params(parser: lmut Parser) -> void:
            can Memory.Allocate, Abort.Panic:
                names: mutable darray[sview] = []
                expect_name: mutable bool = true
                expect_bound: mutable bool = false
                depth: mutable int = 0
                while parser.peek() != TokenKind.Eof |parser, expect_name, expect_bound, depth, names|:
                    param_kind: TokenKind = parser.peek()
                    break if depth == 0 and param_kind == TokenKind.RBracket
                    param_token: Token = parser.cursor()
                    is_generic_name: bool = depth == 0 and expect_name and param_kind == TokenKind.Ident
                    is_bound_name: bool = depth == 0 and expect_bound and param_kind == TokenKind.Ident
                    names.push(Lexer::text_or_empty(param_token, parser.source)) if is_generic_name
                    expect_name <- false if depth == 0 and (is_generic_name or param_kind == TokenKind.At)
                    expect_bound <- true if depth == 0 and param_kind == TokenKind.Colon
                    expect_bound <- false if is_bound_name or (depth == 0 and param_kind == TokenKind.Comma)
                    expect_name <- true if depth == 0 and param_kind == TokenKind.Comma
                    depth <- depth + 1 if param_kind == TokenKind.LParen or param_kind == TokenKind.LBracket
                    depth <- depth - 1 if param_kind == TokenKind.RParen or param_kind == TokenKind.RBracket
                    parser, _ <- parser.advance()
                parser, _ <- parser.expect(TokenKind.RBracket)
                return if names.count == 0
                scan: mutable usize = 0
                indent_depth: mutable int = 0
                seen_indent: mutable bool = false
                while parser.peek_at(scan) != TokenKind.Eof |parser, scan, indent_depth, seen_indent, names|:
                    body_kind: TokenKind = parser.peek_at(scan)
                    seen_indent <- true if body_kind == TokenKind.Indent
                    indent_depth <- indent_depth + 1 if body_kind == TokenKind.Indent
                    indent_depth <- indent_depth - 1 if body_kind == TokenKind.Dedent
                    break if seen_indent and indent_depth == 0 and body_kind == TokenKind.Dedent
                    # Depth 1 is the impl block's own member level; a `def` nested deeper
                    # belongs to a member's body and is not parameterized by the impl header.
                    if indent_depth == 1 and body_kind == TokenKind.Def and parser.peek_at(scan + 1) == TokenKind.Ident:
                        member_line: u32 = parser.tokens[parser.position + scan].line
                        member_index: mutable usize = 0
                        while member_index < names.count |parser, member_index, names, member_line|:
                            parser.generic_param_lines <- parser.generic_param_lines.push(member_line)
                            parser.generic_param_names <- parser.generic_param_names.push(names[member_index])
                            member_index <- member_index + 1
                    scan <- scan + 1




        # `static if/elif/else COND:` compile-time conditional declarations. Each branch
        # body is collected into its OWN `Decl.Conditional` node (a separate scope) so a
        # name declared in multiple branches — a per-backend `mutex_init` — is not a
        # duplicate. Branch selection isn't evaluated (all branches are kept); the
        # `static elif`/`static else` continuation is consumed recursively.
        def static_if_declaration(parser: lmut Parser, out: mutable darray[Ast::Decl]&) -> void:
            has_continuation: mutable bool = true
            while has_continuation |parser, out, has_continuation|:
                head: Token = parser.cursor()
                parser, _ <- parser.advance()                           # `static`
                matched_head: bool = parser.peek() == TokenKind.If or parser.peek() == TokenKind.Elif
                # Read BEFORE consuming: `if` opens a new chain, `elif` continues the current one.
                # The backend needs that distinction to know where a chain starts, and therefore
                # which preceding conditions a `static else` is the fallback for.
                is_chain_head: bool = parser.peek() == TokenKind.If
                parser <- parser.advance_if(matched_head)                # `if` / `elif`
                # CAPTURE the condition rather than discarding it. All branches are still kept
                # (a name declared in two branches is not a duplicate), but the backend has to
                # pick exactly one -- a per-target `const ARENA_BACKEND` declared once per branch
                # left it seeing conflicting consts, and every function reading one declined.
                parser <- parser.capture_static_if_condition(head.line, is_chain_head) if matched_head
                parser <- parser.record_static_else(head.line) if not matched_head
                parser <- parser.accept_if(TokenKind.Else, not matched_head)

                parser <- parser.parse_scoped_block(out, head)

                parser <- parser.skip_newlines()
                has_continuation <- parser.peek() == TokenKind.Static and (parser.peek_at(1) == TokenKind.Elif or parser.peek_at(1) == TokenKind.Else)

include "./parser_decl_handler.elisa"
include "./parser_decl_contracts.elisa"
include "./parser_decl_named_block.elisa"
