# Stage1 parser — `impl`, protocol, and named-block declarations (`extend Parser:
# private:`). Covers impl blocks and their contract spans, protocol default methods and
# body rejection, permission includes, frame-clause scanning, and `static if` at
# declaration level. Continues parser_decl_dispatch.elisa; split out to keep each part
# file under 600 lines.

extend Parser:
    private:
        # `impl[params] Trait for Type:` (or inherent `impl Type:`) — a trait/inherent
        # implementation block. The header (`[params] Trait for Type`) is skipped to the
        # colon; the body's method declarations are captured in a `Decl.Scoped` node (its
        # own scope) so a method with the same signature in another impl — e.g.
        # `br_remaining(self: Self)` implemented for two types — is not a duplicate.
        def impl_declaration(parser: lmut Parser, out: mutable darray[Ast::Decl]&) -> void:
            head: Token = parser.cursor()
            parser, _ <- parser.advance()
            if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Ident and parser.peek_at(2) == TokenKind.Ident:
                interface_token: Token = parser.cursor()
                for_token: Token = parser.tokens[parser.position + 1]
                concrete_token: Token = parser.tokens[parser.position + 2]
                interface_name: sview = Lexer::text_or_empty(interface_token, parser.source)
                for_text: sview = Lexer::text_or_empty(for_token, parser.source)
                concrete_name: sview = Lexer::text_or_empty(concrete_token, parser.source)
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: concrete_name, name: interface_name, line: 0}) if for_text == "for"
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: interface_name, name: interface_name, line: 3900000014}) if for_text == "for"
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__impl_scope", name: interface_name, line: head.line}) if for_text == "for"
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__impl_concrete", name: concrete_name, line: head.line}) if for_text == "for"
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__impl_derived", name: interface_name, line: head.line}) if for_text == "for" and parser.pending_decorators.count > 0
                parser <- parser.capture_impl_contract_spans() if for_text == "for"
            parser <- parser.skip_declaration_header_clauses()
            parser <- parser.parse_scoped_block(out, head)


        # `permission Name:` / `effect Name:` / `protocol Name:` — a named declaration
        # with an indented member block (capability sets, effect families, protocol
        # method signatures). Header clauses + the whole indented body are skipped; the
        # name is recorded as an Alias node. Returns null if there is no block.
        def named_block_declaration(parser: lmut Parser) -> Ast::Decl?:
            rebind token: Token, parser = parser.advance()              # consume the contextual keyword
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            # Record protocol declarations + their `is Parent` supertype (captured before the header
            # skip) so the unknown-interface check can validate impl targets and protocol parents.
            keyword_text: sview = Lexer::text_or_empty(token, parser.source)
            protocol_parent: sview = parser.header_enum_parent()
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__protocol_decl", name: Lexer::text_or_empty(name_token, parser.source), line: token.line}) if keyword_text == "protocol"
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: Lexer::text_or_empty(name_token, parser.source), name: protocol_parent, line: 3900000013}) if keyword_text == "protocol" and protocol_parent != ""
            # Skip the header clauses up to the block-opening colon. A protocol may carry
            # an `is Parent[, Parent]` supertype clause (`protocol X is Parent:`), so the
            # block opener is the colon followed by a newline, not the first colon seen.
            depth: mutable int = 0
            while parser.peek() != TokenKind.Eof |parser, depth|:
                header_kind: TokenKind = parser.peek()
                break if depth == 0 and header_kind == TokenKind.Newline
                break if depth == 0 and header_kind == TokenKind.Colon and parser.peek_at(1) == TokenKind.Newline
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, parser.cursor()) if depth == 0 and header_kind == TokenKind.Colon
                depth <- depth + 1 if header_kind == TokenKind.LParen or header_kind == TokenKind.LBracket
                depth <- depth - 1 if header_kind == TokenKind.RParen or header_kind == TokenKind.RBracket
                parser, _ <- parser.advance()
            rebind accepted_colon_2: bool, parser = parser.accept(TokenKind.Colon)
            declaration_kind: sview = Lexer::text_or_empty(token, parser.source)
            parser <- parser.reject_protocol_method_bodies(Lexer::text_or_empty(name_token, parser.source)) if accepted_colon_2 and declaration_kind == "protocol"
            # The `permission`/`effect`/`protocol` keyword is otherwise dropped (all collapse to a
            # generic Alias). Record permission declarations on the side-table (decl-level pushes
            # propagate) so the reserved-name check can see them.
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__permission_decl", name: Lexer::text_or_empty(name_token, parser.source), line: token.line}) if declaration_kind == "permission"
            parser <- parser.capture_permission_includes(Lexer::text_or_empty(name_token, parser.source)) if accepted_colon_2 and declaration_kind == "permission"
            # A protocol's DEFAULT methods (a `def` with an indented body) carry real code +
            # contracts stage0 checks; materialize each as a Decl.Func on the obligation-only
            # side-list (NOT top_decls, so the full check suite does not over-fire on protocol-
            # scoped methods). `Self` already resolves as a type name.
            if accepted_colon_2 and declaration_kind == "protocol":
                parser <- parser.parse_protocol_default_methods()
            else:
                parser <- parser.skip_indented_block() if accepted_colon_2
            return (Ast::Decl.Alias(Lexer::text_or_empty(name_token, parser.source), (Ast::Expr.Invalid), token.line))

        # Whether the `def` at the cursor has an indented body (a `:` at bracket-depth 0 before
        # end-of-line) — i.e. a DEFAULT method, not a bare signature.
        def protocol_def_has_body(parser: lmut Parser) -> bool:
            can Memory.Allocate, Abort.Panic:
                scan: mutable usize = 0
                depth: mutable int = 0
                while parser.peek_at(scan) != TokenKind.Eof |parser, scan, depth|:
                    kind: TokenKind = parser.peek_at(scan)
                    false return if depth == 0 and kind == TokenKind.Newline
                    true return if depth == 0 and kind == TokenKind.Colon
                    depth <- depth + 1 if kind == TokenKind.LParen or kind == TokenKind.LBracket
                    depth <- depth - 1 if kind == TokenKind.RParen or kind == TokenKind.RBracket
                    scan <- scan + 1
                return false

        # Parse a protocol body's DEFAULT methods onto the obligation-only side-list, skipping
        # signature-only methods and `type`/`law` members. The header peek-scan already captured
        # the conformance annotations; this only materializes runnable default bodies.
        def parse_protocol_default_methods(parser: lmut Parser) -> void:
            can Memory.Allocate, Abort.Panic:
                parser, _ <- parser.accept(TokenKind.Newline)
                rebind accepted_indent: bool, parser = parser.accept(TokenKind.Indent)
                return if not accepted_indent
                depth: mutable int = 1
                while depth > 0 and parser.peek() != TokenKind.Eof |parser, depth|:
                    if depth == 1 and parser.peek() == TokenKind.Def and parser.protocol_def_has_body():
                        rebind method_decl: Ast::Decl?, parser = parser.function_declaration()
                        parser.protocol_default_methods <- parser.protocol_default_methods.push(materialized) if method_decl is materialized
                    else:
                        rebind advanced: Token, parser = parser.advance()
                        depth <- depth + 1 if advanced.kind == TokenKind.Indent
                        depth <- depth - 1 if advanced.kind == TokenKind.Dedent

        # Peek-scan a `permission NAME:` body for `includes Q[, R]` clauses, recording each
        # included family (owner=NAME, name=Q) under sentinel 3900000007 so the permission-includes
        # checks can validate them and detect cycles. Non-consuming (the body is skipped afterward).
        def capture_permission_includes(parser: lmut Parser, permission_name: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                scan: mutable usize = 0
                depth: mutable int = 0
                seen_indent: mutable bool = false
                in_includes: mutable bool = false
                while parser.peek_at(scan) != TokenKind.Eof |parser, scan, depth, seen_indent, in_includes|:
                    kind: TokenKind = parser.peek_at(scan)
                    seen_indent <- true if kind == TokenKind.Indent
                    depth <- depth + 1 if kind == TokenKind.Indent
                    depth <- depth - 1 if kind == TokenKind.Dedent
                    break if seen_indent and depth == 0 and kind == TokenKind.Dedent
                    in_includes <- false if kind == TokenKind.Newline
                    if kind == TokenKind.Ident:
                        word: sview = Lexer::text_or_empty(parser.tokens[parser.position + scan], parser.source)
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: permission_name, name: word, line: 3900000007}) if in_includes and word != "includes"
                        in_includes <- true if word == "includes"
                    scan <- scan + 1

        # Scan a method signature's leading tokens (up to the block colon / end of line) for a
        # `changes self.FIELD, self.FIELD2` clause and record each FIELD on the side-table keyed by
        # METHOD_NAME under SENTINEL (protocol vs impl). The whole signature is later skipped, so
        # this is the only capture point for frame-condition conformance. Non-consuming (peek-only).
        # Whether WORD is a frame/contract clause keyword (ends the current clause's target list).
        def frame_clause_keyword(word: sview) -> bool:
            can Abort.Panic:
                return word == "changes" or word == "preserves" or word == "requires" or word == "ensure" or word == "ensures" or word == "decreases" or word == "invariant" or word == "uses"

        # Peek-scan a signature's `changes`/`preserves` clauses, recording each whole-`changes ROOT`
        # root (sentinel 3900000010) and each `preserves ROOT.field` root+field (3900000011/12, pushed
        # in lockstep) so the preserves-conflict check can detect a place that is both preserved and
        # changed (docs/87 §7). Non-consuming; the header is skipped elsewhere.
        def scan_preserves_conflict(parser: lmut Parser, function_name: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                return if function_name == ""
                scan: mutable usize = 0
                depth: mutable int = 0
                mode: mutable int = 0                    # 0 = none, 1 = changes, 2 = preserves
                while parser.peek_at(scan) != TokenKind.Eof |parser, scan, depth, mode|:
                    kind: TokenKind = parser.peek_at(scan)
                    break if depth == 0 and kind == TokenKind.Newline
                    break if depth == 0 and kind == TokenKind.Colon and parser.peek_at(scan + 1) == TokenKind.Newline
                    depth <- depth + 1 if kind == TokenKind.LParen or kind == TokenKind.LBracket
                    depth <- depth - 1 if kind == TokenKind.RParen or kind == TokenKind.RBracket
                    if kind == TokenKind.Ident:
                        word: sview = Lexer::text_or_empty(parser.tokens[parser.position + scan], parser.source)
                        mode <- 1 if word == "changes"
                        mode <- 2 if word == "preserves"
                        mode <- 0 if frame_clause_keyword(word) and word != "changes" and word != "preserves"
                        # A function whose signature carries ANY frame/contract clause is marked
                        # `__has_contract` (sentinel 3900000040). Consumers that conservatively
                        # assume a plain mutable borrow mutates use this to EXEMPT contracted
                        # callees (ensures-preserve, disjoint `changes`, etc.) — over-marking only
                        # suppresses, never over-fires.
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: function_name, name: "__has_contract", line: 3900000040}) if frame_clause_keyword(word)
                        next_is_dot: bool = parser.peek_at(scan + 1) == TokenKind.Dot
                        prev_is_dot: bool = scan > 0 and parser.peek_at(scan - 1) == TokenKind.Dot
                        # Whole-`changes ROOT` root (bare, not a `.field` selector).
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: function_name, name: word, line: 3900000010}) if mode == 1 and not frame_clause_keyword(word) and not next_is_dot and not prev_is_dot
                        # `preserves ROOT.field` — root + field pushed together (index-paired).
                        if mode == 2 and not frame_clause_keyword(word) and next_is_dot and not prev_is_dot:
                            preserved_field: sview = Lexer::text_or_empty(parser.tokens[parser.position + scan + 2], parser.source) if parser.peek_at(scan + 2) == TokenKind.Ident else sview("", 0, 0)
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: function_name, name: word, line: 3900000011})
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: function_name, name: preserved_field, line: 3900000012})
                        # `changes ROOT.field` — the mutated field, keyed by function (3900000014).
                        # A contracted callee whose declared `changes` set OVERLAPS a caller's
                        # postcondition field cannot preserve it (interproc frame violation).
                        if mode == 1 and not frame_clause_keyword(word) and next_is_dot and not prev_is_dot:
                            changed_field: sview = Lexer::text_or_empty(parser.tokens[parser.position + scan + 2], parser.source) if parser.peek_at(scan + 2) == TokenKind.Ident else sview("", 0, 0)
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: function_name, name: changed_field, line: 3900000077}) if changed_field != ""
                    scan <- scan + 1

        def capture_signature_changes(parser: lmut Parser, method_name: sview, sentinel: u32) -> void:
            return if method_name == ""
            scan: mutable usize = 0
            depth: mutable int = 0
            in_changes: mutable bool = false
            while parser.peek_at(scan) != TokenKind.Eof |parser, scan, depth, in_changes|:
                kind: TokenKind = parser.peek_at(scan)
                break if depth == 0 and kind == TokenKind.Newline
                break if depth == 0 and kind == TokenKind.Colon and parser.peek_at(scan + 1) == TokenKind.Newline
                depth <- depth + 1 if kind == TokenKind.LParen or kind == TokenKind.LBracket
                depth <- depth - 1 if kind == TokenKind.RParen or kind == TokenKind.RBracket
                if kind == TokenKind.Ident:
                    keyword: sview = Lexer::text_or_empty(parser.tokens[parser.position + scan], parser.source)
                    in_changes <- true if keyword == "changes"
                    in_changes <- false if keyword == "requires" or keyword == "ensure" or keyword == "ensures" or keyword == "preserves" or keyword == "decreases" or keyword == "invariant" or keyword == "uses"
                if in_changes and kind == TokenKind.Dot and parser.peek_at(scan + 1) == TokenKind.Ident:
                    field: sview = Lexer::text_or_empty(parser.tokens[parser.position + scan + 1], parser.source)
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: method_name, name: field, line: sentinel})
                # The ROOT of each `changes` target — an Ident that starts a target (directly
                # preceded by the `changes` keyword or a top-level comma) and is followed by `.`.
                # Recorded under sentinel 3900000006 so the changes-target-is-a-parameter check can
                # verify the root names an actual parameter. (The field capture above drops the root.)
                if in_changes and kind == TokenKind.Ident and parser.peek_at(scan + 1) == TokenKind.Dot and scan > 0:
                    previous_token: Token = parser.tokens[parser.position + scan - 1]
                    previous_is_target_start: bool = previous_token.kind == TokenKind.Comma or (previous_token.kind == TokenKind.Ident and Lexer::text_or_empty(previous_token, parser.source) == "changes")
                    root: sview = Lexer::text_or_empty(parser.tokens[parser.position + scan], parser.source)
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: method_name, name: root, line: 3900000006}) if previous_is_target_start
                scan <- scan + 1

        # Peek-scan the upcoming impl body (non-consuming) for each method's `requires`/`ensure`
        # PREDICATE source span, keyed by method name: requires -> 3900000074, ensure -> 3900000075.
        # The impl body is parsed normally afterward; this is a parallel capture so the variance
        # check can text-compare impl vs protocol clauses without walking the parsed contract Exprs.
        def capture_impl_contract_spans(parser: lmut Parser) -> void:
            can Memory.Allocate, Abort.Panic:
                scan: mutable usize = 0
                indent_depth: mutable int = 0
                seen_indent: mutable bool = false
                current_method: mutable sview = ""
                collecting_params: mutable bool = false
                param_paren_depth: mutable int = 0
                param_expect_name: mutable bool = false
                while parser.peek_at(scan) != TokenKind.Eof |parser, scan, indent_depth, seen_indent, current_method, collecting_params, param_paren_depth, param_expect_name|:
                    kind: TokenKind = parser.peek_at(scan)
                    scanned: Token = parser.tokens[parser.position + scan]
                    seen_indent <- true if kind == TokenKind.Indent
                    indent_depth <- indent_depth + 1 if kind == TokenKind.Indent
                    indent_depth <- indent_depth - 1 if kind == TokenKind.Dedent
                    break if seen_indent and indent_depth == 0 and kind == TokenKind.Dedent
                    current_method <- Lexer::text_or_empty(parser.tokens[parser.position + scan + 1], parser.source) if kind == TokenKind.Def and parser.peek_at(scan + 1) == TokenKind.Ident
                    # Capture the impl method's ORDERED param names (excluding self) at 3900000068.
                    collecting_params <- true if kind == TokenKind.Def and parser.peek_at(scan + 1) == TokenKind.Ident
                    if collecting_params:
                        param_paren_depth <- param_paren_depth + 1 if kind == TokenKind.LParen
                        param_expect_name <- true if kind == TokenKind.LParen and param_paren_depth == 0
                        param_expect_name <- true if kind == TokenKind.Comma and param_paren_depth == 1
                        if kind == TokenKind.Ident and param_expect_name and param_paren_depth == 1 and current_method != "":
                            impl_param_ident: sview = Lexer::text_or_empty(scanned, parser.source)
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: current_method, name: impl_param_ident, line: 3900000068}) if impl_param_ident != "self"
                            param_expect_name <- false
                        param_paren_depth <- param_paren_depth - 1 if kind == TokenKind.RParen
                        collecting_params <- false if kind == TokenKind.RParen and param_paren_depth == 0
                    if kind == TokenKind.Ident and current_method != "":
                        keyword: sview = Lexer::text_or_empty(scanned, parser.source)
                        is_req: bool = keyword == "requires"
                        is_ens: bool = keyword == "ensure" or keyword == "ensures"
                        if is_req or is_ens:
                            pred_end: mutable usize = scan + 1
                            while parser.peek_at(pred_end) != TokenKind.Newline and parser.peek_at(pred_end) != TokenKind.Eof and parser.peek_at(pred_end) != TokenKind.Dedent and parser.peek_at(pred_end) != TokenKind.Indent |pred_end|:
                                pred_end <- pred_end + 1
                            if pred_end > scan + 1:
                                pred_first: Token = parser.tokens[parser.position + scan + 1]
                                pred_last: Token = parser.tokens[parser.position + pred_end - 1]
                                pred_span: sview = Lexer::source_view_or_empty(parser.source, pred_first.start.usize(), pred_last.start.usize() + pred_last.length.usize())
                                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: current_method, name: pred_span, line: 3900000074}) if is_req
                                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: current_method, name: pred_span, line: 3900000075}) if is_ens
                    scan <- scan + 1

        def reject_protocol_method_bodies(parser: lmut Parser, protocol_name: sview) -> void:
            scan: mutable usize = 0
            indent_depth: mutable int = 0
            current_method: mutable sview = ""
            in_changes: mutable bool = false
            in_can: mutable bool = false
            error_seen: mutable bool = false
            in_error: mutable bool = false
            after_arrow: mutable bool = false
            collecting_params: mutable bool = false
            param_paren_depth: mutable int = 0
            param_expect_name: mutable bool = false
            while parser.peek_at(scan) != TokenKind.Eof |parser, scan, indent_depth, current_method, in_changes, in_can, error_seen, in_error, after_arrow, collecting_params, param_paren_depth, param_expect_name|:
                kind: TokenKind = parser.peek_at(scan)
                scanned: Token = parser.tokens[parser.position + scan]
                indent_depth <- indent_depth + 1 if kind == TokenKind.Indent
                indent_depth <- indent_depth - 1 if kind == TokenKind.Dedent
                break if kind == TokenKind.Dedent and indent_depth == 0
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, scanned) if indent_depth >= 2 and (kind == TokenKind.Assign or kind == TokenKind.LArrow)
                # Capture each protocol method's `changes self.FIELD` set (skipped otherwise).
                current_method <- Lexer::text_or_empty(parser.tokens[parser.position + scan + 1], parser.source) if kind == TokenKind.Def and parser.peek_at(scan + 1) == TokenKind.Ident
                # Capture the protocol method's ORDERED param names (excluding self) at
                # 3900000066 so behavioural-variance can canonicalise predicates modulo a
                # param rename (`factor > 0` in the protocol == `f > 0` in the impl).
                collecting_params <- true if kind == TokenKind.Def and parser.peek_at(scan + 1) == TokenKind.Ident
                if collecting_params:
                    param_paren_depth <- param_paren_depth + 1 if kind == TokenKind.LParen
                    param_expect_name <- true if kind == TokenKind.LParen and param_paren_depth == 0
                    param_expect_name <- true if kind == TokenKind.Comma and param_paren_depth == 1
                    if kind == TokenKind.Ident and param_expect_name and param_paren_depth == 1 and current_method != "":
                        param_ident: sview = Lexer::text_or_empty(scanned, parser.source)
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: current_method, name: param_ident, line: 3900000066}) if param_ident != "self"
                        param_expect_name <- false
                    param_paren_depth <- param_paren_depth - 1 if kind == TokenKind.RParen
                    collecting_params <- false if kind == TokenKind.RParen and param_paren_depth == 0
                # Capture the protocol's declared member NAMES for impl-conformance: a
                # top-level (indent_depth 1) `def NAME` method (3900000060) or `type NAME`
                # associated type (3900000061).
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: protocol_name, name: Lexer::text_or_empty(parser.tokens[parser.position + scan + 1], parser.source), line: 3900000060}) if protocol_name != "" and indent_depth == 1 and kind == TokenKind.Def and parser.peek_at(scan + 1) == TokenKind.Ident
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: protocol_name, name: Lexer::text_or_empty(parser.tokens[parser.position + scan + 1], parser.source), line: 3900000061}) if protocol_name != "" and indent_depth == 1 and kind == TokenKind.Ident and Lexer::text_or_empty(scanned, parser.source) == "type" and parser.peek_at(scan + 1) == TokenKind.Ident
                # A method with a body (its statements are indented to depth 2) is a DEFAULT —
                # an impl need not override it. Mark it so conformance excludes it as required.
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: protocol_name, name: current_method, line: 3900000062}) if protocol_name != "" and indent_depth == 2 and current_method != ""
                in_changes <- false if kind == TokenKind.Def or kind == TokenKind.Newline
                # Track the `can[...]` region of a protocol method line so we capture ONLY
                # its granted effects (a dotted `Family.Member`), not qualified types elsewhere.
                in_can <- false if kind == TokenKind.Newline
                in_can <- true if kind == TokenKind.Ident and Lexer::text_or_empty(scanned, parser.source) == "can"
                if protocol_name != "" and in_can and current_method != "" and kind == TokenKind.Ident and parser.peek_at(scan + 1) == TokenKind.Dot and parser.peek_at(scan + 2) == TokenKind.Ident:
                    member_end_token: Token = parser.tokens[parser.position + scan + 2]
                    effect_span: sview = Lexer::source_view_or_empty(parser.source, scanned.start.usize(), member_end_token.start.usize() + member_end_token.length.usize())
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: current_method, name: effect_span, line: 3900000063})
                # Capture the protocol method's RETURN type head (first Ident after `->`) at
                # 3900000065 for impl return-type conformance.
                after_arrow <- false if kind == TokenKind.Newline
                if protocol_name != "" and after_arrow and current_method != "" and kind == TokenKind.Ident:
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: current_method, name: Lexer::text_or_empty(scanned, parser.source), line: 3900000065})
                    after_arrow <- false
                after_arrow <- true if kind == TokenKind.Arrow
                # Track the `error[...]` families a protocol method declares (each a single
                # Ident between `error [` and `]`), captured at 3900000064.
                in_error <- false if kind == TokenKind.Newline or kind == TokenKind.RBracket
                in_error <- true if kind == TokenKind.LBracket and error_seen
                error_seen <- (kind == TokenKind.Error or (kind == TokenKind.Ident and Lexer::text_or_empty(scanned, parser.source) == "error")) and parser.peek_at(scan + 1) == TokenKind.LBracket
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: current_method, name: Lexer::text_or_empty(scanned, parser.source), line: 3900000064}) if protocol_name != "" and in_error and current_method != "" and kind == TokenKind.Ident and Lexer::text_or_empty(scanned, parser.source) != "error"
                if kind == TokenKind.Ident:
                    keyword: sview = Lexer::text_or_empty(scanned, parser.source)
                    in_changes <- true if keyword == "changes"
                    in_changes <- false if keyword == "requires" or keyword == "ensure" or keyword == "ensures" or keyword == "preserves" or keyword == "decreases" or keyword == "invariant" or keyword == "uses"
                    # Capture a protocol method's `requires`/`ensure` PREDICATE source span (to
                    # end of line) for behavioural-subtyping variance. requires -> 3900000072,
                    # ensure -> 3900000073, keyed by method name (as effects/returns are).
                    is_req: bool = keyword == "requires"
                    is_ens: bool = keyword == "ensure" or keyword == "ensures"
                    if protocol_name != "" and current_method != "" and (is_req or is_ens):
                        pred_end: mutable usize = scan + 1
                        while parser.peek_at(pred_end) != TokenKind.Newline and parser.peek_at(pred_end) != TokenKind.Eof and parser.peek_at(pred_end) != TokenKind.Dedent and parser.peek_at(pred_end) != TokenKind.Indent |pred_end|:
                            pred_end <- pred_end + 1
                        if pred_end > scan + 1:
                            pred_first: Token = parser.tokens[parser.position + scan + 1]
                            pred_last: Token = parser.tokens[parser.position + pred_end - 1]
                            pred_span: sview = Lexer::source_view_or_empty(parser.source, pred_first.start.usize(), pred_last.start.usize() + pred_last.length.usize())
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: current_method, name: pred_span, line: 3900000072}) if is_req
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: current_method, name: pred_span, line: 3900000073}) if is_ens
                    # Capture a protocol `law NAME(params) = PREDICATE` value law's PREDICATE span
                    # (everything after `=`, to end of line) keyed by the PROTOCOL, sentinel
                    # 3900000078, so the ensure prover can see an available algebraic law
                    # (e.g. transitivity) that discharges a generic goal.
                    if protocol_name != "" and indent_depth == 1 and keyword == "law":
                        eq_scan: mutable usize = scan + 1
                        eq_depth: mutable int = 0
                        found_eq: mutable bool = false
                        while parser.peek_at(eq_scan) != TokenKind.Newline and parser.peek_at(eq_scan) != TokenKind.Eof and parser.peek_at(eq_scan) != TokenKind.Dedent and parser.peek_at(eq_scan) != TokenKind.Indent and not found_eq |eq_scan, eq_depth, found_eq, parser|:
                            eq_kind: TokenKind = parser.peek_at(eq_scan)
                            eq_depth <- eq_depth + 1 if eq_kind == TokenKind.LParen or eq_kind == TokenKind.LBracket
                            eq_depth <- eq_depth - 1 if eq_kind == TokenKind.RParen or eq_kind == TokenKind.RBracket
                            found_eq <- true if eq_kind == TokenKind.Assign and eq_depth == 0
                            break if found_eq
                            eq_scan <- eq_scan + 1
                        if found_eq:
                            law_pred_end: mutable usize = eq_scan + 1
                            while parser.peek_at(law_pred_end) != TokenKind.Newline and parser.peek_at(law_pred_end) != TokenKind.Eof and parser.peek_at(law_pred_end) != TokenKind.Dedent and parser.peek_at(law_pred_end) != TokenKind.Indent |law_pred_end, parser|:
                                law_pred_end <- law_pred_end + 1
                            if law_pred_end > eq_scan + 1:
                                law_first: Token = parser.tokens[parser.position + eq_scan + 1]
                                law_last: Token = parser.tokens[parser.position + law_pred_end - 1]
                                law_span: sview = Lexer::source_view_or_empty(parser.source, law_first.start.usize(), law_last.start.usize() + law_last.length.usize())
                                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: protocol_name, name: law_span, line: 3900000078})
                if in_changes and kind == TokenKind.Dot and parser.peek_at(scan + 1) == TokenKind.Ident and current_method != "":
                    field: sview = Lexer::text_or_empty(parser.tokens[parser.position + scan + 1], parser.source)
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: current_method, name: field, line: 3900000002})
                scan <- scan + 1


        # `static if/elif/else COND:` compile-time conditional declarations. Each branch
        # body is collected into its OWN `Decl.Conditional` node (a separate scope) so a
        # name declared in multiple branches — a per-backend `mutex_init` — is not a
        # duplicate. Branch selection isn't evaluated (all branches are kept); the
        # `static elif`/`static else` continuation is consumed recursively.
        def static_if_declaration(parser: lmut Parser, out: mutable darray[Ast::Decl]&) -> void:
            has_continuation: mutable bool = true
            while has_continuation |parser, out, has_continuation|:
                head: Token = parser.cursor()
                parser, _ <- parser.advance()                           # `static`
                matched_head: bool = parser.peek() == TokenKind.If or parser.peek() == TokenKind.Elif
                # Read BEFORE consuming: `if` opens a new chain, `elif` continues the current one.
                # The backend needs that distinction to know where a chain starts, and therefore
                # which preceding conditions a `static else` is the fallback for.
                is_chain_head: bool = parser.peek() == TokenKind.If
                parser <- parser.advance_if(matched_head)                # `if` / `elif`
                # CAPTURE the condition rather than discarding it. All branches are still kept
                # (a name declared in two branches is not a duplicate), but the backend has to
                # pick exactly one -- a per-target `const ARENA_BACKEND` declared once per branch
                # left it seeing conflicting consts, and every function reading one declined.
                parser <- parser.capture_static_if_condition(head.line, is_chain_head) if matched_head
                parser <- parser.record_static_else(head.line) if not matched_head
                parser <- parser.accept_if(TokenKind.Else, not matched_head)

                parser <- parser.parse_scoped_block(out, head)

                parser <- parser.skip_newlines()
                has_continuation <- parser.peek() == TokenKind.Static and (parser.peek_at(1) == TokenKind.Elif or parser.peek_at(1) == TokenKind.Else)
