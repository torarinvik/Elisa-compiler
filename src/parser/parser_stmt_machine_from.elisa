extend Parser:
    public:
        # docs/125 §5 — `machine from START [|header|] [decreases M]:` state-machine EXPRESSION.
        # Port of stage0's MachineFromExpr. Stage1 is a frontend (no codegen), so this
        # desugars — entirely in the parser — to a value `Expr.Block` that RESOLVES:
        #   header locals + result/done/mode locals + `while not done: <mode if-chain>`, yielding result.
        # States are the variants of an EXISTING enum, so `mode` reuses that enum and no
        # enum is synthesized (unlike `machine over`). The parser enforces the graph facts it
        # can establish syntactically; stage0 repeats the type-resolved graph checks. `next State`
        # -> `mode <- Enum.State`; `done VALUE` ->
        # `result <- VALUE; done <- true`.

        struct MachineFromTermAst:
            is_done: bool
            target: sview          # next: successor state
            args: darray[Ast::Expr]  # next: payload construction args (empty when none)
            value: Ast::Expr       # done: yielded value (Invalid for next)
            guard: Ast::Expr       # Absent when unguarded
            line: u32

        struct MachineFromArmS:
            state: sview
            bindings: darray[sview]  # payload field bindings from `State(a, b):` (empty when none)
            body: darray[Ast::Stmt]
            terminators: darray[MachineFromTermAst]
            out_edges: darray[sview]  # R5 declared out-edge set `-> {A, B}`
            has_out_edges: bool       # distinguishes explicit `-> {}` from an omitted clause
            line: u32

        # `machine from …`: recognized when the ident `from` immediately follows `machine`.
        def machine_from_ahead(parser: Parser&) -> bool:
            false return if parser.position + 1 >= parser.tokens.count
            next_token: Token = parser.tokens[parser.position + 1]
            return next_token.kind == TokenKind.Ident and Lexer::text_or_empty(next_token, parser.source) == "from"

        # Parse `Enum.State` (or a bare `State`) and return the variant name. The AST keeps only
        # that name, so validate an explicit prefix before discarding it.
        def parse_machine_from_variant_for(parser: lmut Parser, expected_enum: sview) -> sview:
            prefix_token: Token = parser.cursor()
            rebind first: Token, parser = parser.expect(TokenKind.Ident)
            first_text: sview = Lexer::text_or_empty(first, parser.source)
            rebind accepted_dot: bool, parser = parser.accept(TokenKind.Dot)
            first_text return if not accepted_dot
            parser <- parser.validate_machine_from_enum_prefix(first_text, expected_enum, prefix_token)
            rebind second: Token, parser = parser.expect(TokenKind.Ident)
            return Lexer::text_or_empty(second, parser.source)

        def validate_machine_from_enum_prefix(parser: lmut Parser, actual: sview, expected: sview, token: Token) -> void:
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if actual != "" and expected != "" and actual != expected

        # `.State` tail of a dotted state reference: the second ident when `dotted`, the
        # bare first name otherwise.
        def parse_machine_from_dotted_tail(parser: lmut Parser, dotted: bool, first_text: sview) -> sview:
            first_text return if not dotted
            rebind second: Token, parser = parser.expect(TokenKind.Ident)
            return Lexer::text_or_empty(second, parser.source)

        def machine_from_expression(parser: lmut Parser) -> Ast::Expr?:
            rebind machine_token: Token, parser = parser.advance()   # machine
            parser, _ <- parser.advance()                            # from

            # Start state `Enum.State`: capture both the enum (for `mode`'s member exprs)
            # and the entry variant.
            rebind start_first: Token, parser = parser.expect(TokenKind.Ident)
            start_name: sview = Lexer::text_or_empty(start_first, parser.source)
            rebind start_dotted: bool, parser = parser.accept(TokenKind.Dot)
            start_enum: sview = start_name if start_dotted else sview("", 0, 0)
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, start_first) if not start_dotted
            rebind start_state: sview, parser = parser.parse_machine_from_dotted_tail(start_dotted, start_name)
            rebind machine_result: Ast::Expr?, parser = parser.machine_from_tail(start_enum, start_state, machine_token)
            return machine_result

        # Shared body of explicit `machine from Enum.State` and local `start State`.
        def machine_from_tail(parser: lmut Parser, start_enum: sview, start_state: sview, machine_token: Token) -> Ast::Expr?:
            # Optional entry-state payload `machine from Once.Only(seed)` (docs/125 §5).
            rebind start_args: darray[Ast::Expr], parser = parser.parse_machine_from_call_args()

            # Optional machine header pipe. It is deliberately detected directly rather than
            # through loop_header_at(): `decreases` may follow the closing pipe, whereas the
            # loop lookahead only recognizes headers followed immediately by `:` or `->`.
            header_declarations: mutable darray[Ast::Stmt] = []
            header_captures: mutable darray[sview] = []
            header_yield: mutable Ast::Expr = (Ast::Expr.Invalid)
            header_has_yield: mutable bool = false
            if parser.peek() == TokenKind.Pipe:
                header_yield, parser <- parser.parse_loop_header(header_declarations, header_captures, header_has_yield)
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, parser.cursor()) if header_has_yield

            # Optional `decreases MEASURE` — retain the expression in the generated loop so
            # stage1's ordinary termination checks see the same contract stage0 analyzes.
            # Presence is tracked separately from the expression: a malformed measure still
            # counts as declared for the cycle check, while the Invalid AST is not emitted as
            # a second bogus contract.
            decreases_token: Token = parser.cursor()
            has_decreases: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(decreases_token, parser.source) == "decreases"
            rebind decreases: Ast::Expr, parser = parser.skip_machine_from_decreases()

            # Keep all synthesized locals in this machine's private namespace. The parser-owned
            # source-position generator makes two machine-from expressions in one function
            # disjoint and keeps stage0/stage1 names stable.
            result_var: sview = parser.machine_generated_name("__mf_result_", machine_token.start)
            done_var: sview = parser.machine_generated_name("__mf_done_", machine_token.start)
            mode_var: sview = parser.machine_generated_name("__mf_mode_", machine_token.start)

            parser, _ <- parser.expect(TokenKind.Colon)
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)

            machine_arms: mutable darray[MachineFromArmS] = []
            machine over parser.position while true:
                state Scan
                state Parse
                start Scan

                Scan, _ if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof:
                    break

                Scan, _:
                    parser <- parser.skip_newlines()
                    -> Parse

                Parse, _ if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof:
                    break

                Parse, _:
                    rebind arm: MachineFromArmS, parser = parser.parse_machine_from_arm(start_enum)
                    machine_arms.push(arm)
                    -> Scan
            parser, _ <- parser.expect(TokenKind.Dedent)

            parser <- parser.check_machine_from_coverage(machine_arms, start_enum, start_state, machine_token)
            parser <- parser.check_machine_from_reachability(machine_arms, start_state, machine_token)
            parser <- parser.check_machine_from_decisions(machine_arms, machine_token)
            parser <- parser.check_machine_from_termination(machine_arms, has_decreases, machine_token)
            return (build_machine_from_block(start_enum, start_state, start_args, machine_arms, header_declarations, header_captures, decreases, result_var, done_var, mode_var, machine_token.line))

        def start_machine_ahead(parser: Parser&) -> bool:
            return parser.position + 1 < parser.tokens.count and parser.peek_at(1) == TokenKind.Ident

        # Function-local typed state sugar. The private payload enum makes transition
        # construction and arm binding use the ordinary enum type checker.
        def start_machine_expression(parser: lmut Parser) -> Ast::Expr?:
            rebind start_token: Token, parser = parser.advance()
            rebind state_token: Token, parser = parser.expect(TokenKind.Ident)
            start_state: sview = Lexer::text_or_empty(state_token, parser.source)
            states: darray[MachineStateAst] = [state for state in parser.pending_state_decls]
            parser.pending_state_decls <- parser.pending_state_decls.truncate(0)
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, start_token) if states.count == 0

            # Name the synthesized enum from source position, not a mutable per-file counter.
            # Counter-based names changed when an unrelated machine was inserted earlier in
            # the file and could collide with another parser entry path.
            enum_name: sview = parser.machine_generated_name("__MachineMode_", start_token.start)
            variants: mutable darray[Ast::EnumVariant] = []
            variants.extend([Ast::EnumVariant{name: state.name, fields: state.field_types, field_names: state.field_names, value_expr: (Ast::Expr.Absent)} for state in states])
            # The bootstrap compiler scalarizes payload-less local state enums. The
            # self-host backend still routes synthesized local states through its
            # payload-enum registry, so retain the regular representation here until
            # const-enum `is` lowering reaches self-host parity.
            parser.pending_decls <- parser.pending_decls.push((Ast::Decl.Enum(enum_name, variants, false, (Ast::Expr.Absent), Ast::pos_of_token(start_token))))

            # The backend registers payload enums from these flat metadata rows.
            parser.payload_enum_names <- parser.payload_enum_names.push(enum_name)
            parser.payload_enum_is_const <- parser.payload_enum_is_const.push(false)
            parser.payload_enum_variant_starts <- parser.payload_enum_variant_starts.push(parser.payload_enum_variant_names.count)
            parser.payload_enum_variant_counts <- parser.payload_enum_variant_counts.push(states.count)
            for state in states |parser|:
                parser.payload_enum_variant_names <- parser.payload_enum_variant_names.push(state.name)
                parser.payload_enum_variant_field_starts <- parser.payload_enum_variant_field_starts.push(parser.payload_enum_variant_fields.count)
                parser.payload_enum_variant_field_counts <- parser.payload_enum_variant_field_counts.push(state.field_types.count)
                for field_index in 0..<state.field_types.count |parser|:
                    parser.payload_enum_variant_fields <- parser.payload_enum_variant_fields.push(state.field_types[field_index])
                    parser.payload_enum_variant_field_names <- parser.payload_enum_variant_field_names.push(state.field_names[field_index])
            rebind start_result: Ast::Expr?, parser = parser.machine_from_tail(enum_name, start_state, start_token)
            return start_result

        # A machine whose transition graph has a CYCLE must carry a `decreases` measure, or the
        # loop may never terminate (docs/125 §5: "transition cycle through state A has no
        # `decreases` measure"). A cycle exists iff some state is reachable from itself via ≥1
        # `next`. Only checked when no measure was declared.
        def check_machine_from_termination(parser: lmut Parser, machine_arms: darray[MachineFromArmS], has_decreases: bool, token: Token) -> void:
            can Memory.Allocate, Abort.Panic:
                return if has_decreases
                cyclic: bool = any arm in machine_arms where machine_from_reaches_self(machine_arms, arm.state)
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if cyclic

        # Whether STATE can transition back to itself through one or more `next` edges. A node is
        # "active" (contributes its out-edges) if it IS the start state (seed) or already reached;
        # after the fixpoint, a cycle exists iff STATE's own arm became reached.
        def machine_from_reaches_self(machine_arms: darray[MachineFromArmS], state: sview) -> bool:
            can Memory.Allocate, Abort.Panic:
                reached: mutable darray[bool] = [false for arm in machine_arms]
                pass_index: mutable usize = 0
                while pass_index <= machine_arms.count |reached, pass_index|:
                    source_index: mutable usize = 0
                    while source_index < machine_arms.count |reached, source_index|:
                        active: bool = reached[source_index] or machine_arms[source_index].state == state
                        for terminator in machine_arms[source_index].terminators |reached|:
                            mark_index: mutable usize = 0
                            while mark_index < machine_arms.count |reached, mark_index|:
                                should_mark: bool = active and not terminator.is_done and terminator.target != "" and machine_arms[mark_index].state == terminator.target
                                reached[mark_index] <- true if should_mark
                                mark_index <- mark_index + 1
                        source_index <- source_index + 1
                    pass_index <- pass_index + 1
                result: mutable bool = false
                check_index: mutable usize = 0
                while check_index < machine_arms.count |result, check_index|:
                    result <- true if machine_arms[check_index].state == state and reached[check_index]
                    check_index <- check_index + 1
                return result

        # Every declared state needs exactly one arm. The parser can know the enum's variants
        # when its metadata has already been recorded (including the synthesized local-state
        # enum); if an explicit enum is parsed later, stage0 repeats the check after resolution.
        def check_machine_from_coverage(parser: lmut Parser, machine_arms: darray[MachineFromArmS], enum_name: sview, start_state: sview, token: Token) -> void:
            # Duplicate arms are always decidable from the syntax, even when enum metadata is
            # not available yet.
            for arm_index in 0..<machine_arms.count:
                for previous_index in 0..<arm_index:
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if machine_arms[arm_index].state == machine_arms[previous_index].state

            # Regular payload-less/const enums and payload enums use separate flat metadata
            # pools. Check only a matching pool row; an enum declared later is intentionally
            # left for the semantic analyzer rather than being rejected by source order.
            for enum_index in 0..<parser.enum_decl_names.count:
                if parser.enum_decl_names[enum_index] == enum_name:
                    return if enum_index >= parser.enum_decl_variant_starts.count or enum_index >= parser.enum_decl_variant_counts.count
                    variant_start: usize = parser.enum_decl_variant_starts[enum_index]
                    variant_count: usize = parser.enum_decl_variant_counts[enum_index]
                    variant_names: mutable darray[sview] = []
                    variant_names.extend(parser.enum_decl_variant_names)
                    parser <- parser.check_machine_from_variant_rows(machine_arms, variant_names, variant_start, variant_count, start_state, token)
                    return
            for enum_index in 0..<parser.payload_enum_names.count:
                if parser.payload_enum_names[enum_index] == enum_name:
                    return if enum_index >= parser.payload_enum_variant_starts.count or enum_index >= parser.payload_enum_variant_counts.count
                    variant_start: usize = parser.payload_enum_variant_starts[enum_index]
                    variant_count: usize = parser.payload_enum_variant_counts[enum_index]
                    variant_names: mutable darray[sview] = []
                    variant_names.extend(parser.payload_enum_variant_names)
                    parser <- parser.check_machine_from_variant_rows(machine_arms, variant_names, variant_start, variant_count, start_state, token)
                    return

        def check_machine_from_variant_rows(parser: lmut Parser, machine_arms: darray[MachineFromArmS], variant_names: darray[sview], variant_start: usize, variant_count: usize, start_state: sview, token: Token) -> void:
            return if variant_start > variant_names.count or variant_count > variant_names.count - variant_start
            start_known: mutable bool = false
            for variant_index in 0..<variant_count:
                state_name: sview = variant_names[variant_start + variant_index]
                start_known <- true if state_name == start_state
                has_arm: bool = any arm in machine_arms where arm.state == state_name
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if not has_arm
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if not start_known
            for arm in machine_arms |parser|:
                arm_known: bool = parser.machine_from_variant_row_has_name(variant_names, variant_start, variant_count, arm.state)
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if not arm_known
                for transition in arm.terminators |parser|:
                    target_known: mutable bool = transition.is_done
                    target_known <- true if parser.machine_from_variant_row_has_name(variant_names, variant_start, variant_count, transition.target)
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if not target_known

        def machine_from_variant_row_has_name(parser: Parser&, variant_names: darray[sview], variant_start: usize, variant_count: usize, name: sview) -> bool:
            for variant_index in 0..<variant_count:
                return true if variant_names[variant_start + variant_index] == name
            return false

        # Every arm needs a decision, and its FINAL `next`/`done` must be unguarded. An unguarded
        # earlier terminator does not make later guarded terminators safe: stage0 rejects that
        # shape because the final path can still fall through without deciding.
        def check_machine_from_decisions(parser: lmut Parser, machine_arms: darray[MachineFromArmS], token: Token) -> void:
            can Memory.Allocate, Abort.Panic:
                for arm in machine_arms |parser| -> parser:
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if arm.terminators.count == 0
                    if arm.terminators.count > 0:
                        last: MachineFromTermAst = arm.terminators[arm.terminators.count - 1]
                        final_unguarded: bool = match last.guard:
                            Ast::Expr.Absent: true
                            _: false
                        parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if not final_unguarded
                        if arm.terminators.count > 1:
                            for terminator_index in 0..<(arm.terminators.count - 1):
                                earlier_unguarded: bool = match arm.terminators[terminator_index].guard:
                                    Ast::Expr.Absent: true
                                    _: false
                                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if earlier_unguarded
                    # R5: a `next TARGET` must be in the arm's declared out-edge set (when declared).
                    for transition in arm.terminators |parser| -> parser:
                        declared: bool = any edge in arm.out_edges where edge == transition.target
                        undeclared: bool = arm.has_out_edges and not transition.is_done and transition.target != "" and not declared
                        parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if undeclared

        # A state whose arm is not reachable from the start state via any `next` terminator is dead
        # code ("machine state B is unreachable from the start state A"). Fixpoint BFS over the
        # arm.state -> terminator.target edges, bounded to |arms| passes.
        def check_machine_from_reachability(parser: lmut Parser, machine_arms: darray[MachineFromArmS], start_state: sview, token: Token) -> void:
            can Memory.Allocate, Abort.Panic:
                return if start_state == ""
                reached: mutable darray[bool] = [arm.state == start_state for arm in machine_arms]
                pass_index: mutable usize = 0
                while pass_index < machine_arms.count |reached, pass_index|:
                    source_index: mutable usize = 0
                    while source_index < machine_arms.count |reached, source_index|:
                        source_reached: bool = reached[source_index]
                        for terminator in machine_arms[source_index].terminators |reached|:
                            mark_index: mutable usize = 0
                            while mark_index < machine_arms.count |reached, mark_index|:
                                is_target: bool = source_reached and not terminator.is_done and terminator.target != "" and machine_arms[mark_index].state == terminator.target
                                reached[mark_index] <- true if is_target
                                mark_index <- mark_index + 1
                        source_index <- source_index + 1
                    pass_index <- pass_index + 1
                report_index: mutable usize = 0
                while report_index < machine_arms.count |parser, report_index| -> parser:
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if not reached[report_index]
                    report_index <- report_index + 1

        # Optional `(EXPR, EXPR, …)` payload-construction args after a state reference (start
        # state or a `next` target). Returns [] when no `(` follows, so a payload-free state
        # stays a bare reference.
        def parse_machine_from_call_args(parser: lmut Parser) -> darray[Ast::Expr]:
            args: mutable darray[Ast::Expr] = []
            args return if parser.peek() != TokenKind.LParen
            parser, _ <- parser.advance()   # (
            machine over parser.position while parser.peek() != TokenKind.RParen and parser.peek() != TokenKind.Eof:
                state Parse
                state Separator
                start Parse

                Parse, _:
                    rebind arg_opt: Ast::Expr?, parser = parser.expression()
                    parsed_arg: Ast::Expr = get arg_opt else (Ast::Expr.Invalid)
                    args.push(parsed_arg)
                    -> Separator

                Separator, _ if parser.peek() == TokenKind.Comma:
                    parser.position <- parser.position + 1
                    -> Parse

                Separator, _:
                    break
            parser, _ <- parser.expect(TokenKind.RParen)
            return args

        # Optional `(name, name, …)` payload BINDING list in an arm header
        # (`Num.Exponent(was_fraction):`) — identifiers the arm body binds.
        def parse_machine_from_bindings(parser: lmut Parser) -> darray[sview]:
            names: mutable darray[sview] = []
            names return if parser.peek() != TokenKind.LParen
            parser, _ <- parser.advance()   # (
            machine over parser.position while parser.peek() != TokenKind.RParen and parser.peek() != TokenKind.Eof:
                state Parse
                state Separator
                start Parse

                Parse, _:
                    rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
                    names.push(Lexer::text_or_empty(name_token, parser.source))
                    -> Separator

                Separator, _ if parser.peek() == TokenKind.Comma:
                    parser.position <- parser.position + 1
                    -> Parse

                Separator, _:
                    break
            parser, _ <- parser.expect(TokenKind.RParen)
            return names

        # Optional `decreases MEASURE` after the start state. Preserve the parsed expression
        # for the loop-body contract; the machine graph check separately tracks whether the
        # clause was present. A bare bool measure keeps the existing precise stage1 diagnostic
        # while complex measures flow to the ordinary termination analysis.
        def skip_machine_from_decreases(parser: lmut Parser) -> Ast::Expr:
            decreases_token: Token = parser.cursor()
            (Ast::Expr.Invalid) return if parser.peek() != TokenKind.Ident or Lexer::text_or_empty(decreases_token, parser.source) != "decreases"
            parser, _ <- parser.advance()
            measure_start: usize = parser.position
            rebind measure: Ast::Expr?, parser = parser.expression()
            if measure is measure_expr:
                # A machine `decreases` measure must be integer-typed. Keep the existing
                # focused bool-parameter diagnostic for the subset that can be resolved from
                # parser metadata; the full expression is now also present in the loop AST.
                if parser.position == measure_start + 1 and parser.tokens[measure_start].kind == TokenKind.Ident:
                    measure_name: sview = Lexer::text_or_empty(parser.tokens[measure_start], parser.source)
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: measure_name, name: "__machine_decreases_measure", line: decreases_token.line})
                return measure_expr
            return (Ast::Expr.Invalid)

        # Optional R5 out-edge contract `-> {A, B}` after an arm header. Stage0 owns the R5
        # enforcement; stage1 only consumes the clause so the arm reaches its block colon.
        def capture_machine_from_declared_out(parser: lmut Parser, out_edges: mutable darray[sview]&, expected_enum: sview) -> void:
            return if parser.peek() != TokenKind.Arrow
            parser, _ <- parser.advance()   # ->
            parser, _ <- parser.expect(TokenKind.LBrace)
            while parser.peek() != TokenKind.RBrace and parser.peek() != TokenKind.Eof |parser, out_edges|:
                rebind edge_name: sview, parser = parser.parse_machine_from_variant_for(expected_enum)
                out_edges.push(edge_name)
                break if not parser.accept(TokenKind.Comma)
            parser, _ <- parser.expect(TokenKind.RBrace)

        # docs/125 §5 R1 (the machine arm law): an arm body is STRAIGHT-LINE. Resolution is
        # `next`/`done`, so a `return`/`break`/`continue` escape, and hidden branching
        # (`if`/`match`/`while`/`for`) inside a body — instead of guarded `next`/`done`
        # terminators — both defeat the state-graph reading. Mutation (the `<-` advance) stays
        # legal. Sibling of machine-over's arm law; stage0 owns the rich message, stage1 now
        # OWNS the refusal itself (docs/125 step 13) rather than deferring it. A `can`/`with`/…
        # wrapper block is transparent — its body is retested so a branch hidden one level down
        # is still caught.
        def machine_from_arm_stmt_illegal(statement: Ast::Stmt) -> bool:
            return match statement:
                Ast::Stmt.If(condition, then_body, else_body, line):
                    true
                Ast::Stmt.While(condition, body, line):
                    true
                Ast::Stmt.For(bind, variables, iterable, body, line):
                    true
                Ast::Stmt.Match(scrutinee, arms, line):
                    true
                Ast::Stmt.Return(value, line):
                    true
                Ast::Stmt.Break(label, line):
                    true
                Ast::Stmt.Continue(label, line):
                    true
                Ast::Stmt.Block(kind, clause, binding, body, line):
                    any inner in body where machine_from_arm_stmt_illegal(inner)
                _:
                    false

        def parse_machine_from_arm(parser: lmut Parser, expected_enum: sview) -> MachineFromArmS:
            arm_token: Token = parser.cursor()
            rebind state: sview, parser = parser.parse_machine_from_variant_for(expected_enum)
            # Optional payload bindings `State(a, b):` and R5 out-edge contract `-> {…}`.
            rebind bindings: darray[sview], parser = parser.parse_machine_from_bindings()
            out_edges: mutable darray[sview] = []
            has_out_edges: bool = parser.peek() == TokenKind.Arrow
            parser <- parser.capture_machine_from_declared_out(out_edges, expected_enum)
            parser, _ <- parser.expect(TokenKind.Colon)
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)

            body: mutable darray[Ast::Stmt] = []
            terminators: mutable darray[MachineFromTermAst] = []
            saw_terminator: mutable bool = false
            while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser, body, terminators, saw_terminator|:
                parser <- parser.skip_newlines()
                break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof
                head_token: Token = parser.cursor()
                head: sview = Lexer::text_or_empty(head_token, parser.source)
                head_is_terminator: bool = parser.peek() == TokenKind.Arrow or parser.peek() == TokenKind.FatArrow or (parser.peek() == TokenKind.Ident and (head == "next" or head == "done"))
                if head_is_terminator:
                    parser <- parser.parse_machine_from_arm_terminator(terminators, expected_enum)
                    saw_terminator <- true
                continue if head_is_terminator
                rebind stmt_opt: Ast::Stmt?, parser = parser.statement()
                if stmt_opt is body_statement:
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, head_token) if saw_terminator
                    # R1: flag a branch/escape in the arm body (see machine_from_arm_stmt_illegal).
                    # Keep the statement in the structural parse so downstream shape is intact.
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, head_token) if machine_from_arm_stmt_illegal(body_statement)
                    body.push(body_statement)
                    parser <- parser.skip_trailing_can(true)
                    parser, _ <- parser.accept(TokenKind.Newline)
                else:
                    parser, _ <- parser.advance()   # error recovery: never spin
            parser, _ <- parser.expect(TokenKind.Dedent)

            return MachineFromArmS{state: state, bindings: bindings, body: body, terminators: terminators, out_edges: out_edges, has_out_edges: has_out_edges, line: arm_token.line}

        # A canonical `->`/`=>` line (or compatible `next`/`done` alias).
        def parse_machine_from_arm_terminator(parser: lmut Parser, terminators: mutable darray[MachineFromTermAst]&, expected_enum: sview) -> void:
            rebind term: MachineFromTermAst, parser = parser.parse_machine_from_terminator(expected_enum)
            terminators.push(term)

        def parse_machine_from_terminator(parser: lmut Parser, expected_enum: sview) -> Parser.MachineFromTermAst:
            rebind keyword_token: Token, parser = parser.advance()   # -> | => | next | done
            keyword_text: sview = Lexer::text_or_empty(keyword_token, parser.source)
            is_result: bool = keyword_token.kind == TokenKind.FatArrow or keyword_text == "done"
            if is_result:
                rebind done_term: MachineFromTermAst, parser = parser.parse_machine_from_done_terminator(keyword_token.line)
                return done_term
            rebind next_term: MachineFromTermAst, parser = parser.parse_machine_from_next_terminator(keyword_token.line, expected_enum)
            return next_term

        # `done VALUE [if COND]`. The value ends at a top-level `if` guard; the lenient
        # ternary parse swallows `done VALUE if COND` as an else-less `Expr.If` whose
        # then-branch is the value and whose condition is the guard — split it back.
        def parse_machine_from_done_terminator(parser: lmut Parser, line: u32) -> MachineFromTermAst:
            value: mutable Ast::Expr = (Ast::Expr.Invalid)
            rebind value_opt: Ast::Expr?, parser = parser.expression()
            if value_opt is parsed_value:
                value <- parsed_value
            guard: mutable Ast::Expr = (Ast::Expr.Absent)
            match value:
                Ast::Expr.If(condition, then_value, else_value, if_line):
                    is_absent: bool = match else_value:
                        Ast::Expr.Absent: true
                        _: false
                    guard <- condition if is_absent
                    value <- then_value if is_absent
                _:
                    pass
            parser, _ <- parser.accept(TokenKind.Newline)
            no_args: darray[Ast::Expr] = []
            return MachineFromTermAst{is_done: true, target: "", args: no_args, value: value, guard: guard, line: line}

        # `next State[(args)] [if COND]` — the successor state, its payload-construction
        # args, and an optional trailing guard.
        def parse_machine_from_next_terminator(parser: lmut Parser, line: u32, expected_enum: sview) -> MachineFromTermAst:
            rebind target: sview, parser = parser.parse_machine_from_variant_for(expected_enum)
            # `next Num.Exponent(was_fraction)` constructs the successor's payload.
            rebind next_args: darray[Ast::Expr], parser = parser.parse_machine_from_call_args()
            rebind guard: Ast::Expr, parser = parser.parse_machine_from_next_guard()
            parser, _ <- parser.accept(TokenKind.Newline)
            return MachineFromTermAst{is_done: false, target: target, args: next_args, value: (Ast::Expr.Invalid), guard: guard, line: line}

        # Optional trailing `if COND` guard on a `next` terminator; Absent when unguarded.
        def parse_machine_from_next_guard(parser: lmut Parser) -> Ast::Expr:
            (Ast::Expr.Absent) return if parser.peek() != TokenKind.If
            parser, _ <- parser.advance()
            rebind guard_opt: Ast::Expr?, parser = parser.expression()
            if guard_opt is parsed_guard:
                return parsed_guard
            return (Ast::Expr.Absent)

        # Build the value-block desugar: result/done/mode locals + `while not done:` over a
        # mode if-chain, yielding result. Dispatch is an `if mode is Enum.State(binds): …`
        # chain rather than `mode == Enum.State`: the refinement `is`-pattern both selects
        # the arm AND binds the state's payload fields (docs/125 §5 state payloads), so a
        # body reading a payload resolves. Payload-free states use a bare `mode is Enum.State`
        # test. Every arm is conditional (innermost else is empty) so each arm's `is` binds in
        # its own branch; stage0 owns exhaustiveness, the stage1 parse stays structural.
        def build_machine_from_block(start_enum: sview, start_state: sview, start_args: darray[Ast::Expr], machine_arms: darray[MachineFromArmS], header_declarations: darray[Ast::Stmt], header_captures: darray[sview], decreases: Ast::Expr, result_var: sview, done_var: sview, mode_var: sview, line: u32) -> Ast::Expr:

            # Header accumulators are machine-private locals, so they must precede the mode
            # locals and the loop in the same value-block scope. Their initializers may be
            # referenced by both the decreases measure and every arm.
            declarations: mutable darray[Ast::Stmt] = [declaration for declaration in header_declarations]
            # The result carrier is intentionally context-typed by the backend from the value
            # block's expected type. `zeroed` is only an initialization seed; every machine arm
            # assigns the carrier before the block yields it. Keeping the language's zero value
            # here preserves machine results whose type is not an integer (structs, arrays,
            # optionals, and views) instead of forcing all lowered machines through i64.
            declarations.push((Ast::Stmt.VarDecl(result_var, (Ast::Expr.Invalid), (Ast::Expr.Ident("zeroed", Ast::pos_at_line(line))), Ast::pos_at_line(line))))
            declarations.push((Ast::Stmt.VarDecl(done_var, (Ast::Expr.Unary(TokenKind.Mutable, (Ast::Expr.Ident("bool", Ast::pos_at_line(line))), Ast::pos_at_line(line))), (Ast::Expr.BoolLit(false)), Ast::pos_at_line(line))))
            # The machine mode is an existing enum, not an inferred temporary. Keeping its
            # mutable annotation explicit is important for every transition: the backend must
            # know the aggregate carrier type before it emits the entry constructor and later
            # arm-local `is` refinements, and must treat `mode <- next_state` as a store. Scalar
            # payload-free states happened to infer and rebind here, which masked both type
            # boundaries for multi-field payloads.
            declarations.push((Ast::Stmt.VarDecl(mode_var, (Ast::Expr.Unary(TokenKind.Mutable, (Ast::Expr.Ident(start_enum, Ast::pos_at_line(line))), Ast::pos_at_line(line))), machine_from_state_value(start_enum, start_state, start_args, line), Ast::pos_at_line(line))))

            # Per-state dispatch block: arm body ++ terminator if/else chain.
            state_blocks: mutable darray[darray[Ast::Stmt]] = []
            for arm in machine_arms:
                block: mutable darray[Ast::Stmt] = []
                # `extend` rather than push-loops: the terminator chain is a returned darray, and
                # iterating a call TEMPORARY directly is outside the emitted subset.
                chained: darray[Ast::Stmt] = machine_from_terminator_chain(arm.terminators, start_enum, result_var, done_var, mode_var, arm.line)
                block.extend(arm.body)
                block.extend(chained)
                state_blocks.push(block)

            # Mode dispatch built right-to-left: `if mode is S0(..): b0 else: (if mode is S1(..):
            # b1 else: …)`, innermost else empty.
            dispatch: mutable darray[Ast::Stmt] = []
            state_index: mutable usize = machine_arms.count
            while state_index > 0 |dispatch, state_index, machine_arms, state_blocks, start_enum, mode_var|:
                current: usize = state_index - 1
                arm_line: u32 = machine_arms[current].line
                condition: Ast::Expr = machine_from_is_condition(mode_var, start_enum, machine_arms[current].state, machine_arms[current].bindings, arm_line)
                dispatch <- [(Ast::Stmt.If(condition, state_blocks[current], dispatch, Ast::pos_at_line(arm_line)))]
                state_index <- state_index - 1

            loop_condition: Ast::Expr = (Ast::Expr.Unary(TokenKind.Not, (Ast::Expr.Ident(done_var, Ast::pos_at_line(line))), Ast::pos_at_line(line)))
            loop_body: mutable darray[Ast::Stmt] = []
            # Keep the machine-level termination obligation attached to the generated loop.
            # This lets stage1's normal decreases walkers inspect the same AST shape that
            # stage0's analyzer constructs, including the measure's actual expression.
            loop_body.push((Ast::Stmt.Contract("decreases", decreases, Ast::pos_at_line(line)))) if not machine_expr_is_invalid(decreases)
            loop_body.extend(dispatch)
            declarations.push((Ast::Stmt.While(loop_condition, loop_body, Ast::pos_at_line(line))))

            # A machine-from expression is a value block, so every outer binding it
            # mutates must be an explicit block capture. This is especially important
            # for `lmut` resources such as the lexer: the graph yields both its result
            # and the updated resource rather than hiding mutation inside a value block.
            # Locals declared by an arm stay internal and are not captures.
            assigned: mutable darray[sview] = []
            declared: mutable darray[sview] = []
            header_local_names: mutable darray[sview] = []
            for declaration in header_declarations |header_local_names|:
                match declaration:
                    Ast::Stmt.VarDecl(name, _, _, _):
                        header_local_names.push(name)
                    _:
                        pass
            for arm in machine_arms |assigned, declared|:
                gather_machine_assigned_idents(arm.body, assigned)
                gather_machine_declared_idents(arm.body, declared)
            captures: mutable darray[sview] = []
            for assigned_name in assigned |captures|:
                captures.push(assigned_name) if not (any declared_name in declared where declared_name == assigned_name) and not (any header_name in header_local_names where header_name == assigned_name) and not (any existing in captures where existing == assigned_name)
            for header_capture in header_captures |captures|:
                captures.push(header_capture) if not (any existing in captures where existing == header_capture)
            return (Ast::Expr.Block(declarations, (Ast::Expr.Ident(result_var, Ast::pos_at_line(line))), captures, Ast::pos_at_line(line)))

        # Collect the root identifiers assigned (`x <- …` / `x = …`) anywhere in a body.
        def gather_machine_assigned_idents(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            for statement in statements |out|:
                match statement:
                    Ast::Stmt.Assign(target, operator, value, line):
                        match target:
                            Expr.Ident(target_name, target_line):
                                out.push(target_name)
                            _:
                                pass
                    Ast::Stmt.If(condition, then_body, else_body, line):
                        gather_machine_assigned_idents(then_body, out)
                        gather_machine_assigned_idents(else_body, out)
                    Ast::Stmt.While(condition, body, line):
                        gather_machine_assigned_idents(body, out)
                    Ast::Stmt.For(bind, variables, iterable, body, line):
                        gather_machine_assigned_idents(body, out)
                    Ast::Stmt.Block(kind, clause, binding, body, line):
                        gather_machine_assigned_idents(body, out)
                    Ast::Stmt.Match(scrutinee, arms, line):
                        for arm in arms |out|:
                            gather_machine_assigned_idents(arm.body, out)
                    _:
                        pass

        def gather_machine_declared_idents(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            for statement in statements |out|:
                match statement:
                    Ast::Stmt.VarDecl(name, type_expression, initializer, line):
                        out.push(name)
                    Ast::Stmt.If(condition, then_body, else_body, line):
                        gather_machine_declared_idents(then_body, out)
                        gather_machine_declared_idents(else_body, out)
                    Ast::Stmt.While(condition, body, line):
                        gather_machine_declared_idents(body, out)
                    Ast::Stmt.For(bind, variables, iterable, body, line):
                        out.extend(variables)
                        gather_machine_declared_idents(body, out)
                    Ast::Stmt.Block(kind, clause, binding, body, line):
                        gather_machine_declared_idents(body, out)
                    Ast::Stmt.Match(scrutinee, arms, line):
                        for arm in arms |out|:
                            gather_machine_declared_idents(arm.body, out)
                    _:
                        pass

        # A trailing run of terminators as a nested if/else: guarded terminators become the
        # conditions, the final unguarded one the else. A single unguarded terminator is its
        # bare action.
        def machine_from_terminator_chain(terminators: darray[MachineFromTermAst], start_enum: sview, result_var: sview, done_var: sview, mode_var: sview, line: u32) -> darray[Ast::Stmt]:
            count: usize = terminators.count
            no_terminators: darray[Ast::Stmt] = []
            no_terminators return if count == 0
            # Build right-to-left: the last terminator's action is the base.
            chain: mutable darray[Ast::Stmt] = machine_from_terminator_action(terminators[count - 1], start_enum, result_var, done_var, mode_var)
            machine over chain while true:
                state Fold(remaining: usize)
                start Fold(count - 1)

                Fold(remaining), _ if remaining == 0:
                    break

                Fold(remaining), _ if machine_from_term_guard_absent(terminators[remaining - 1]):
                    chain <- machine_from_terminator_action(terminators[remaining - 1], start_enum, result_var, done_var, mode_var)
                    -> Fold(remaining - 1)

                Fold(remaining), _:
                    action: darray[Ast::Stmt] = machine_from_terminator_action(terminators[remaining - 1], start_enum, result_var, done_var, mode_var)
                    chain <- [(Ast::Stmt.If(terminators[remaining - 1].guard, action, chain, Ast::pos_at_line(terminators[remaining - 1].line)))]
                    -> Fold(remaining - 1)
            return chain

        def machine_from_term_guard_absent(term: MachineFromTermAst) -> bool:
            return match term.guard:
                Ast::Expr.Absent: true
                _: false

        def machine_from_terminator_action(term: MachineFromTermAst, start_enum: sview, result_var: sview, done_var: sview, mode_var: sview) -> darray[Ast::Stmt]:
            machine_from_done_action(term, result_var, done_var) return if term.is_done
            # `next State(args)` -> `mode <- Enum.State(args)` (a payload-free target stays a
            # bare member reference).
            return [(Ast::Stmt.Assign((Ast::Expr.Ident(mode_var, Ast::pos_at_line(term.line))), TokenKind.LArrow, machine_from_state_value(start_enum, term.target, term.args, term.line), Ast::pos_at_line(term.line)))]

        # `done VALUE` -> `result <- VALUE; done <- true`.
        def machine_from_done_action(term: MachineFromTermAst, result_var: sview, done_var: sview) -> darray[Ast::Stmt]:
            stmts: mutable darray[Ast::Stmt] = []
            stmts.push((Ast::Stmt.Assign((Ast::Expr.Ident(result_var, Ast::pos_at_line(term.line))), TokenKind.LArrow, term.value, Ast::pos_at_line(term.line))))
            stmts.push((Ast::Stmt.Assign((Ast::Expr.Ident(done_var, Ast::pos_at_line(term.line))), TokenKind.LArrow, (Ast::Expr.BoolLit(true)), Ast::pos_at_line(term.line))))
            return stmts


# `Enum.State` — or `Enum.State(args)` when the state carries a payload (docs/125 §5). Used
# for the entry-state init and every `next` target. A payload-free state stays a bare member.
def machine_from_state_value(start_enum: sview, state: sview, args: darray[Ast::Expr], line: u32) -> Ast::Expr:
    member: Ast::Expr = (Ast::Expr.Field((Ast::Expr.Ident(start_enum, Ast::pos_at_line(line))), state, Ast::pos_at_line(line)))
    member return if args.count == 0
    no_names: darray[sview] = []
    return (Ast::Expr.Call(member, args, no_names, Ast::pos_at_line(line)))


# The dispatch condition `mode is Enum.State(binds…)`: the refinement `is`-pattern selects
# the arm and binds the state's payload fields for the arm body. Payload-free states test a
# bare `mode is Enum.State`.
def machine_from_is_condition(mode_var: sview, start_enum: sview, state: sview, bindings: darray[sview], line: u32) -> Ast::Expr:
    binding_exprs: mutable darray[Ast::Expr] = []
    binding_exprs.extend([(Ast::Expr.Ident(name, Ast::pos_at_line(line))) for name in bindings])
    rhs: Ast::Expr = machine_from_state_value(start_enum, state, binding_exprs, line)
    # A bare variant test is still an `is` refinement even when the arm elects not to bind
    # payload fields. Equality on a payload enum compares only its tag in stage0, but the
    # aggregate equality path is not the right AST contract for a state-machine dispatch and
    # previously made `Nested.Inner:` (no bindings) lower to a zero-argument constructor. That
    # constructor is invalid for a multi-field payload. The backend's bare payload-variant `is`
    # path now compares the tag without constructing or reading the payload.
    return (Ast::Expr.Binary((Ast::Expr.Ident(mode_var, Ast::pos_at_line(line))), TokenKind.Is, rhs, Ast::pos_at_line(line)))
