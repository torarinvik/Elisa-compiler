# Structural operations shared by the static-effect frontend and typed lowering.
extend Ast:
    public:
        def effect_runtime_children(candidates: darray[StaticEffectCandidate], arguments: darray[Expr]) -> darray[Expr]:
            children: mutable darray[Expr] = []
            for candidate in candidates |children|:
                children.extend(candidate.captures)
            children.extend(arguments)
            return children

        def effect_application_head(expression: Expr) -> Expr:
            match expression:
                Expr.Index(head, argument, position):
                    return head
                Expr.IndexN(head, arguments, position):
                    return head
                _:
                    return expression

        def effect_application_arguments(expression: Expr) -> darray[Expr]:
            match expression:
                Expr.Index(head, argument, position):
                    return [argument]
                Expr.IndexN(head, arguments, position):
                    return arguments
                _:
                    return []

        def effect_path_equal(left: Expr, right: Expr) -> bool:
            match left:
                Expr.Ident(left_name, left_position):
                    if right is Expr.Ident(right_name, right_position):
                        return left_name == right_name
                Expr.Scope(left_head, left_name, left_position):
                    if right is Expr.Scope(right_head, right_name, right_position):
                        return left_name == right_name and effect_path_equal(left_head, right_head)
                _:
                    pass
            return false
