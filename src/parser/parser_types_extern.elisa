# Stage1 parser — `extern` and `export` declarations (`extend Parser: private:`). Covers
# the extern signature and its trailing body, the export forms (type, global, alias,
# re-export), and the header probes that read effect grants, contracts, segment
# ownership, and error families off an extern line. Continues parser_types.elisa; split
# out to keep each part file under 600 lines.

extend Parser:
    private:
        # Text lookup used by machine guards. Keeping the token in a local gives the
        # borrowed `Lexer.text_or_empty` view an addressable value rather than a temporary.
        def header_token_text(parser: Parser&, offset: usize) -> sview:
            token: Token = parser.tokens[parser.position + offset]
            return Lexer::text_or_empty(token, parser.source)

        def header_has_fixed_array_type(parser: Parser&, is_export_signature: bool) -> bool:
            false return if not is_export_signature
            scan: mutable usize = 0
            machine over scan while true:
                state Scan
                start Scan

                Scan, _ if parser.peek_at(scan) == TokenKind.Newline or parser.peek_at(scan) == TokenKind.Eof:
                    return false

                Scan, _ if parser.peek_at(scan) == TokenKind.LBracket and (parser.peek_at(scan + 1) == TokenKind.IntLit or parser.peek_at(scan + 1) == TokenKind.HexLit):
                    return true

                Scan, _:
                    scan <- scan + 1
                    -> Scan
            return false

        # `extern <signature>` / `extern <Name>` (FFI import or opaque type) and
        # `export fn name -> target` / `extern:`/`export:` blocks. Their internals
        # aren't modeled yet; consume the declaration line (and any indented block) so
        # the surrounding module parses. Recorded as an Invalid declaration node.
        def extern_declaration(parser: lmut Parser) -> Ast::Decl?:
            rebind token: Token, parser = parser.advance()              # `extern` / `export`
            is_export: bool = Lexer::text_or_empty(token, parser.source) == "export"
            is_export_global: bool = is_export and parser.peek() == TokenKind.Global
            export_head: Token = parser.cursor()
            is_export_type: bool = is_export and parser.peek() == TokenKind.Ident and Lexer::text_or_empty(export_head, parser.source) == "type"
            is_export_pymodule: bool = is_export and parser.peek() == TokenKind.Ident and Lexer::text_or_empty(export_head, parser.source) == "pymodule"
            # Threading both the parsed `Ast::Decl` and the advanced `parser` out of a
            # two-real-branch ternary (`A() if cond else B()`) isn't reliable here, so
            # each branch is routed through a dedicated single-call out-param helper
            # instead (guarded single-target reassigns, like `advance_when` elsewhere).
            decl: mutable Ast::Decl = (Ast::Decl.Invalid)
            parser <- parser.capture_export_global_decl(token, decl) if is_export_global
            parser <- parser.capture_export_type_decl(token, decl) if is_export_type
            parser <- parser.capture_export_pymodule_decl(token, decl) if is_export_pymodule
            parser <- parser.capture_extern_signature_decl(token, decl) if not is_export_global and not is_export_type and not is_export_pymodule
            return decl

        # `export pymodule NAME:` is the Python-module export surface. The module body is
        # intentionally metadata-only in this first stage: each `fn public = target` row (or the
        # opt-in `fn *`/`const *` wildcard) is retained in the file annotation table, while the
        # ordinary declarations stay in the enclosing file and are compiled exactly as before.
        # Keeping this out of Decl avoids changing the stable AST layout shared by stage0/stage1
        # and gives the backend a clean metadata boundary for native-symbol and CPython-wrapper
        # emission.
        def capture_export_pymodule_decl(parser: lmut Parser, token: Token, decl: mutable Ast::Decl&) -> void:
            can Abort.Panic, Memory.Allocate:
                parser, _ <- parser.advance()                         # `pymodule`
                module_token: Token = parser.cursor()
                module_name: sview = Lexer::text_or_empty(module_token, parser.source) if parser.peek() == TokenKind.Ident else ""
                parser <- parser.error_at(Ast::ParseErrorKind.ExpectedDeclaration, module_token) if module_name == ""
                parser, _ <- parser.advance() if module_name != ""
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: module_name, name: "__export_pymodule", line: token.line}) if module_name != ""
                parser <- parser.capture_export_pymodule_body(module_name) if parser.peek() == TokenKind.Colon
                parser <- parser.skip_extern_line_remainder() if parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof
                decl <- (Ast::Decl.Extern(module_name, 0, 0, false, false, "", parser.pending_decorators, Ast::pos_of_token(token)))

        # Consume the indented `pymodule` body and record one annotation pair per function.
        # `__pymodule_fn` is keyed by the public Python name; the matching
        # `__pymodule_target_ref` row carries the Elisa target and shares its source line.
        # Assigned targets are retained as a source-backed path, so `fn add = Math::add`
        # stays lossless in manifests and can be resolved without allocating a joined name.
        def capture_export_pymodule_body(parser: lmut Parser, module_name: sview) -> void:
            can Abort.Panic, Memory.Allocate:
                parser, _ <- parser.expect(TokenKind.Colon)
                parser, _ <- parser.expect(TokenKind.Newline)
                rebind accepted_indent: bool, parser = parser.accept(TokenKind.Indent)
                return if not accepted_indent
                while parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser, module_name|:
                    parser <- parser.skip_newlines()
                    break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof
                    line: u32 = parser.cursor().line
                    fn_word: Token = parser.cursor()
                    is_fn: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(fn_word, parser.source) == "fn"
                    is_const: bool = parser.peek() == TokenKind.Const
                    parser, _ <- parser.advance() if is_fn or is_const
                    public_token: Token = parser.cursor()
                    is_wildcard: bool = (is_fn or is_const) and parser.peek() == TokenKind.Star
                    public_name: sview = "*" if is_wildcard else (Lexer::text_or_empty(public_token, parser.source) if (is_fn or is_const) and parser.peek() == TokenKind.Ident else "")
                    parser, _ <- parser.advance() if public_name != ""
                    accepted_assign: bool = parser.peek() == TokenKind.Assign
                    parser, _ <- parser.accept(TokenKind.Assign) if accepted_assign
                    target_token: Token = parser.cursor()
                    # The common case is a same-name export (`fn parse`), so the
                    # assignment is optional when the line ends after the public name.
                    # Keep `fn public = implementation` for explicit renames.
                    shorthand: bool = (is_fn or is_const) and public_name != "" and not accepted_assign and (parser.peek() == TokenKind.Newline or parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof)
                    target_name: mutable sview = public_name if shorthand else ""
                    if accepted_assign and parser.peek() == TokenKind.Ident:
                        target_start: usize = target_token.start.usize()
                        target_end: mutable usize = (target_token.start + target_token.length).usize()
                        parser, _ <- parser.advance()
                        # The final segment is the callable/constant name. Keep the whole
                        # `Module::name` path in the annotation; consumers split it at the
                        # last scope separator when they need the owner and leaf separately.
                        while parser.peek() == TokenKind.Scope and parser.peek_at(1) == TokenKind.Ident |parser, target_end|:
                            parser, _ <- parser.advance()
                            rebind target_segment: Token, parser = parser.advance()
                            target_end <- (target_segment.start + target_segment.length).usize()
                        target_name <- parser.span_view(target_start, target_end)
                    # `fn *` / `const *` are explicit opt-in wildcards. They are expanded by the
                    # pymodule emitters after the complete AST is available, so the declaration
                    # may appear before the functions/constants it exports.
                    wildcard_row: bool = is_wildcard and not accepted_assign and (parser.peek() == TokenKind.Newline or parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof)
                    if is_fn and wildcard_row:
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "*", name: "__pymodule_fn_all", line: line})
                    elif is_const and wildcard_row:
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "*", name: "__pymodule_const_all", line: line})
                    elif is_fn and public_name != "" and target_name != "":
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: public_name, name: "__pymodule_fn", line: line})
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: target_name, name: "__pymodule_target_ref", line: line})
                    elif is_const and public_name != "" and target_name != "":
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: public_name, name: "__pymodule_const", line: line})
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: target_name, name: "__pymodule_const_target_ref", line: line})
                    else:
                        parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, fn_word)
                    parser <- parser.skip_extern_line_remainder()
                parser, _ <- parser.expect(TokenKind.Dedent)

        def capture_export_type_decl(parser: lmut Parser, token: Token, decl: mutable Ast::Decl&) -> void:
            parser, _ <- parser.advance()
            target_token: Token = parser.cursor()
            target_name: sview = Lexer::text_or_empty(target_token, parser.source) if parser.peek() == TokenKind.Ident else ""
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: target_name, name: "__export_type", line: token.line}) if target_name != ""
            # Preserve the public spelling of a concrete export (`export type T as Public`).
            # The old parser discarded everything after T, which made the backend unable to
            # name exported aggregate definitions in a C ABI header.
            alias_name: mutable sview = ""
            scan: mutable usize = 1
            machine over alias_name while true:
                state Scan(index: usize)
                start Scan(1)

                Scan(index), _ if parser.peek_at(index) == TokenKind.Newline or parser.peek_at(index) == TokenKind.Eof:
                    break

                Scan(index), _ if parser.peek_at(index) == TokenKind.As and parser.peek_at(index + 1) == TokenKind.Ident:
                    alias_token: Token = parser.tokens[parser.position + index + 1]
                    alias_name <- Lexer::text_or_empty(alias_token, parser.source)
                    -> Scan(index + 1)

                Scan(index), _:
                    -> Scan(index + 1)
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: alias_name, name: target_name, line: token.line}) if alias_name != "" and target_name != ""
            parser <- parser.skip_extern_line_remainder()
            decl <- (Ast::Decl.Extern(target_name, parser.extern_params.count.u32(), 0, false, false, "", parser.pending_decorators, Ast::pos_of_token(token)))

        # `is_export_global` branch of `extern_declaration`, isolated to a single real
        # call so the caller's guarded reassign threads `parser` cleanly.
        def capture_export_global_decl(parser: lmut Parser, token: Token, decl: mutable Ast::Decl&) -> void:
            rebind parsed: Ast::Decl, parser = parser.parse_export_global_extern(token)
            decl <- parsed

        # The non-`export global` branch of `extern_declaration`. Same single-call
        # isolation as `capture_export_global_decl` above.
        def capture_extern_signature_decl(parser: lmut Parser, token: Token, decl: mutable Ast::Decl&) -> void:
            rebind parsed: Ast::Decl, parser = parser.parse_extern_signature_and_body(token)
            decl <- parsed

        # `export global Mod::name [as alias]`: record the public alias when present,
        # otherwise the final target segment. The full target is stage0's concern;
        # stage1 only needs one symbol name.
        def parse_export_global_extern(parser: lmut Parser, token: Token) -> Ast::Decl:
            parser, _ <- parser.advance()               # `global`
            exported_name: mutable sview = ""
            target_name: mutable sview = ""
            while parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof |parser, exported_name|:
                is_alias: bool = parser.peek() == TokenKind.As and parser.peek_at(1) == TokenKind.Ident
                is_plain_ident: bool = not is_alias and parser.peek() == TokenKind.Ident
                parser <- parser.capture_export_alias(exported_name) if is_alias
                parser <- parser.capture_export_part(exported_name) if is_plain_ident
                target_name <- exported_name if is_plain_ident else target_name
                parser <- parser.advance_when(not is_alias and not is_plain_ident)
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: target_name, name: "__export_global", line: token.line}) if target_name != ""
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: exported_name, name: target_name, line: token.line}) if exported_name != "" and target_name != ""
            return (Ast::Decl.Extern(exported_name, parser.extern_params.count.u32(), 0, false, false, "", parser.pending_decorators, Ast::pos_of_token(token)))

        # `as alias` — consume the `as` and record the alias identifier's text.
        def capture_export_alias(parser: lmut Parser, exported_name: mutable sview&) -> void:
            parser, _ <- parser.advance()               # `as`
            rebind alias_token: Token, parser = parser.advance()
            exported_name <- Lexer::text_or_empty(alias_token, parser.source)

        # A bare `Mod::name` path segment — consume it and record its text (later
        # segments overwrite earlier ones, matching "the final target segment").
        def capture_export_part(parser: lmut Parser, exported_name: mutable sview&) -> void:
            rebind part_token: Token, parser = parser.advance()
            exported_name <- Lexer::text_or_empty(part_token, parser.source)

        # The non-`export global` extern forms: `export fn NAME …` / `export def NAME …`
        # / typed `extern name: T` / `extern:`/`export:` blocks.
        def parse_extern_signature_and_body(parser: lmut Parser, token: Token) -> Ast::Decl:
            can Abort.Panic:
                # `export fn NAME …` / `export def NAME …`: skip the leading func/def word
                # so the captured name is the exported symbol, not the keyword.
                parser, _ <- parser.accept(TokenKind.Def)
                parser <- parser.skip_export_func_word() if parser.peek() == TokenKind.Ident
                # The external name is the first identifier; record it so it becomes a symbol.
                name_cursor: Token = parser.cursor()
                is_name_ident: bool = parser.peek() == TokenKind.Ident
                name: mutable sview = Lexer::text_or_empty(name_cursor, parser.source) if is_name_ident else ""
                parser <- parser.advance_when(is_name_ident)
                rebind accepted_generic_header: bool, parser = parser.accept(TokenKind.LBracket)
                # `extern push[T](box: mutable MethodBox[T]&, item: T)` — the generic header was
                # SKIPPED outright, so `T` was never a known type parameter, every parameter
                # mentioning it resolved Unmodeled, and the extern failed to register at all.
                # Record the FIRST type parameter and the owning extern's name as a pair keyed
                # by the declaration LINE, matching how the `__extern_return*` rows are keyed.
                generic_param_token: Token = parser.cursor()
                extern_generic_param: sview = Lexer::text_or_empty(generic_param_token, parser.source) if accepted_generic_header and parser.peek() == TokenKind.Ident else sview("", 0, 0)
                if extern_generic_param != "" and name != "":
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_generic_param", name: extern_generic_param, line: token.line})
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_generic_name", name: name, line: token.line})
                parser <- parser.skip_bracketed_group() if accepted_generic_header
                error_family: sview = parser.header_error_family()
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__error_return", line: token.line}) if error_family != ""
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: error_family, line: token.line}) if error_family != ""
                parser <- parser.capture_header_error_families(token.line) if error_family != ""
                is_export_signature: bool = Lexer::text_or_empty(token, parser.source) == "export"
                has_fixed_array_boundary: bool = parser.header_has_fixed_array_type(is_export_signature)
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__export_array", line: token.line}) if has_fixed_array_boundary
                has_params: bool = parser.peek() == TokenKind.LParen
                parser <- parser.reject_extern_param_defaults() if is_export_signature and has_params
                arity: mutable u32 = 0
                variadic: mutable bool = false
                param_start: u32 = parser.extern_params.count.u32()
                parser <- parser.scan_extern_params(arity, variadic) if has_params
                extern_return_type: mutable sview = parser.extern_return_type_head()
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_return", name: extern_return_type, line: token.line}) if extern_return_type != ""
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_return_ptr", name: name, line: token.line}) if extern_return_type != "" and parser.extern_return_is_pointer()
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_return_optional", name: name, line: token.line}) if extern_return_type != "" and parser.extern_return_is_optional()
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__extern_effect", line: token.line}) if parser.header_has_signature_can()
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__extern_segment_owner", line: token.line}) if parser.header_grants_segment_owner()
                parser <- parser.record_extern_segment_flow(name, token.line) if name != ""
                extern_darray_element: sview = parser.extern_return_darray_element()
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__extern_return_darray", line: token.line}) if extern_darray_element != "" and name != ""
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: extern_darray_element, name: "__extern_return_darray_elem", line: token.line}) if extern_darray_element != ""
                extern_shape: sview = parser.extern_return_darray_shape()
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_return_shape", name: extern_shape, line: token.line}) if extern_shape != ""
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_return_shape_fn", name: name, line: token.line}) if extern_shape != ""
                extern_effect_ref: sview = parser.header_signature_can_ref()
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_effect_ref", name: extern_effect_ref, line: token.line}) if extern_effect_ref != ""
                # A `@blocking` extern requires `Blocking.RawExtern` at every call site (verified
                # against stage0: fires even under `can Blocking.Wait:` — a distinct member). Register
                # it as an extern effect (owner + adjacent ref) so the ungranted-effect check sees it.
                has_blocking: mutable bool = false
                machine over has_blocking while true:
                    state Scan(index: usize)
                    start Scan(0)

                    Scan(_), _ if has_blocking:
                        break

                    Scan(index), _ if index >= parser.pending_decorators.count:
                        break

                    Scan(index), _ if parser.pending_decorators[index].name == "blocking":
                        has_blocking <- true
                        -> Scan(index + 1)

                    Scan(index), _:
                        -> Scan(index + 1)
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__extern_effect", line: token.line}) if has_blocking
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_effect_ref", name: "Blocking.RawExtern", line: token.line}) if has_blocking
                # Retain the export-vs-extern distinction and the `= TARGET` re-export target on
                # the side-table (the node signature drops both), so semantic can validate
                # duplicate export names and undefined re-export targets.
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__export_fn", line: token.line}) if is_export_signature and name != ""
                parser <- parser.capture_export_reexport_target(name, token.line) if is_export_signature
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__extern_contract", line: token.line}) if name != "" and parser.header_has_signature_contract()
                parser <- parser.capture_extern_header_contracts(token.line)  # capture `requires`, then skip the rest to the block colon or end of line
                # Only `extern:` / `export:` followed by a newline opens an indented block;
                # a typed `extern name: T` stops at the colon (skip the rest of the line).
                has_trailing_block: bool = parser.peek() == TokenKind.Colon and parser.peek_at(1) == TokenKind.Newline
                # A non-call extern uses the same return-type side table as a callable
                # extern, even though its type follows `:` rather than `->`.
                extern_return_type <- parser.typed_extern_global_type() if not has_params
                parser <- parser.parse_extern_trailing_block() if has_trailing_block
                # Typed `extern name: T` (or any single-line extern): consume the remainder
                # of the line (the `: T`) so it isn't reparsed.
                parser <- parser.skip_extern_line_remainder() if not has_trailing_block
                return (Ast::Decl.Extern(name, param_start, arity, variadic, has_params, extern_return_type, parser.pending_decorators, Ast::pos_of_token(token)))


            # `extern errno_value: i32` — capture the first type name after the colon
            # without consuming it. The line skipper below owns cursor advancement.
        def typed_extern_global_type(parser: Parser&) -> sview:
            can Abort.Panic:
                "" return if parser.peek() != TokenKind.Colon
                machine over parser.position:
                    state Scan(index: usize)
                    start Scan(1)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Ident:
                        return parser.header_token_text(index)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Newline or parser.peek_at(index) == TokenKind.Eof:
                        return ""

                    Scan(index), _:
                        -> Scan(index + 1)
                return ""


        def extern_return_type_head(parser: Parser&) -> sview:
            can Abort.Panic:
                "" return if parser.peek() != TokenKind.Arrow
                machine over parser.position:
                    state Scan(index: usize)
                    start Scan(1)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Ident:
                        return parser.header_token_text(index)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Newline or parser.peek_at(index) == TokenKind.Eof or parser.peek_at(index) == TokenKind.Colon:
                        return ""

                    Scan(index), _:
                        -> Scan(index + 1)
                return ""

        # The ELEMENT type of a `-> darray[T]` / `-> darray[T, shape]` / `-> view[T]` return. The
        # `return_type_name` side table keeps only the head (`darray`), which alone cannot be
        # resolved to a type, so an extern returning a darray had NO usable return type and
        # every caller declined. Empty when the return is not a darray.
        def extern_return_darray_element(parser: Parser&) -> sview:
            can Abort.Panic:
                "" return if parser.peek() != TokenKind.Arrow
                machine over parser.position:
                    state Scan(index: usize)
                    start Scan(1)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Ident and (parser.header_token_text(index) == "darray" or parser.header_token_text(index) == "view") and parser.peek_at(index + 1) == TokenKind.LBracket and parser.peek_at(index + 2) == TokenKind.Ident:
                        return parser.header_token_text(index + 2)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Newline or parser.peek_at(index) == TokenKind.Eof or parser.peek_at(index) == TokenKind.Colon:
                        return ""

                    Scan(index), _:
                        -> Scan(index + 1)
                return ""


        # Whether the `-> T` clause names a POINTER return (`T&`, including the
        # `heap T&` / `mutable heap T&?` forms). The `return_type_name` side table
        # keeps only the bare head name — exactly as `ExternParam.type_name` drops a
        # param's `&` — so without this an `extern malloc(n: usize) -> mutable heap
        # void&?` lowers to a `void` return instead of a `ptr`, and every FFI
        # allocator is undeclarable. Mirrors `ExternParam.provenance_bearing`, but
        # for the return.
        # Whether the `-> T` clause is NULLABLE (`-> heap T&?`). The extern node keeps only
        # the bare head name, and a nullable pointer return registers as a plain ref (stage0
        # represents `heap T&?` as a bare ptr, null = absent), so without this marker there is
        # no way to tell `-> T&` from `-> T&?` later -- and `get f()` is legal on exactly one
        # of them.
        def extern_return_is_optional(parser: Parser&) -> bool:
            can Abort.Panic:
                false return if parser.peek() != TokenKind.Arrow
                machine over parser.position:
                    state Scan(index: usize)
                    start Scan(1)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Question:
                        return true

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Newline or parser.peek_at(index) == TokenKind.Eof or parser.peek_at(index) == TokenKind.Colon:
                        return false

                    Scan(index), _:
                        -> Scan(index + 1)
                return false

        def extern_return_is_pointer(parser: Parser&) -> bool:
            can Abort.Panic:
                false return if parser.peek() != TokenKind.Arrow
                machine over parser.position:
                    state Scan(index: usize)
                    start Scan(1)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Ampersand or parser.peek_at(index) == TokenKind.Bang:
                        return true

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Newline or parser.peek_at(index) == TokenKind.Eof or parser.peek_at(index) == TokenKind.Colon:
                        return false

                    Scan(index), _:
                        -> Scan(index + 1)
                return false

        # The extern return type's darray SHAPE argument ("shape_out" from
        # `-> darray[i32, shape_out]`), or "" when the return is not a
        # two-argument darray. Fresh-shape provenance (docs/86-style shape pairs)
        # needs it to seed instance counters for extern producers.
        def extern_return_darray_shape(parser: Parser&) -> sview:
            can Abort.Panic:
                "" return if parser.peek() != TokenKind.Arrow
                machine over parser.position:
                    state Scan(index: usize)
                    start Scan(1)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Ident and parser.header_token_text(index) == "darray" and parser.peek_at(index + 1) == TokenKind.LBracket and parser.peek_at(index + 2) == TokenKind.Ident and parser.peek_at(index + 3) == TokenKind.Comma and parser.peek_at(index + 4) == TokenKind.Ident and parser.extern_shape_in_parameters(parser.header_token_text(index + 4), index):
                        return ""

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Ident and parser.header_token_text(index) == "darray" and parser.peek_at(index + 1) == TokenKind.LBracket and parser.peek_at(index + 2) == TokenKind.Ident and parser.peek_at(index + 3) == TokenKind.Comma and parser.peek_at(index + 4) == TokenKind.Ident:
                        return parser.header_token_text(index + 4)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Newline or parser.peek_at(index) == TokenKind.Eof or parser.peek_at(index) == TokenKind.Colon:
                        return ""

                    Scan(index), _:
                        -> Scan(index + 1)
                return ""

        def extern_shape_in_parameters(parser: Parser&, candidate_shape: sview, limit: usize) -> bool:
            machine over parser.position:
                state Scan(index: usize)
                start Scan(0)

                Scan(index), _ if index >= limit:
                    return false

                Scan(index), _ if parser.peek_at(index) == TokenKind.Ident and parser.header_token_text(index) == candidate_shape:
                    return true

                Scan(index), _:
                    -> Scan(index + 1)
            return false

        def header_has_signature_can(parser: Parser&) -> bool:
            can Abort.Panic:
                machine over parser.position:
                    state Scan(index: usize)
                    start Scan(0)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Ident and parser.header_token_text(index) == "can" and parser.peek_at(index + 1) == TokenKind.LBracket:
                        return true

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Newline or parser.peek_at(index) == TokenKind.Eof:
                        return false

                    Scan(index), _:
                        -> Scan(index + 1)
                return false

        # Whether the extern signature header declares a `requires`/`ensure`/`ensures` boundary
        # contract (consumed by skip_declaration_header_clauses without being modeled). Used to
        # mark contract-bearing externs for the -strict-externs check.
        def header_has_signature_contract(parser: Parser&) -> bool:
            can Abort.Panic:
                machine over parser.position:
                    state Scan(index: usize)
                    start Scan(0)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Ident and (parser.header_token_text(index) == "requires" or parser.header_token_text(index) == "ensure" or parser.header_token_text(index) == "ensures"):
                        return true

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Newline or parser.peek_at(index) == TokenKind.Eof:
                        return false

                    Scan(index), _:
                        -> Scan(index + 1)
                return false

        # Whether the signature header's `can[...]` grants a segment-transition owner: it
        # establishes an owner only when it contains BOTH `Unsafe.SegmentMutation` AND one of
        # `Segment.Guest` / `Segment.Host` (mirrors stage0 permissionRefsTransitionOwner). Such an
        # extern needs an explicit @segment_transition so the owner is a typed contract.
        def header_grants_segment_owner(parser: Parser&) -> bool:
            can Abort.Panic:
                scan: mutable usize = 0
                machine over scan while true:
                    state Scan(has_mutation: bool, has_owner: bool)
                    start Scan(false, false)

                    Scan(has_mutation, has_owner), _ if parser.peek_at(scan) == TokenKind.Newline or parser.peek_at(scan) == TokenKind.Eof:
                        return has_mutation and has_owner

                    Scan(has_mutation, has_owner), _ if parser.peek_at(scan) == TokenKind.Ident and parser.peek_at(scan + 1) == TokenKind.Dot and parser.peek_at(scan + 2) == TokenKind.Ident:
                        head_text: sview = Lexer::text_or_empty(parser.tokens[parser.position + scan], parser.source)
                        member_text: sview = Lexer::text_or_empty(parser.tokens[parser.position + scan + 2], parser.source)
                        next_mutation: bool = has_mutation or (head_text == "Unsafe" and member_text == "SegmentMutation")
                        next_owner: bool = has_owner or (head_text == "Segment" and (member_text == "Guest" or member_text == "Host"))
                        scan <- scan + 1
                        -> Scan(next_mutation, next_owner)

                    Scan(has_mutation, has_owner), _:
                        scan <- scan + 1
                        -> Scan(has_mutation, has_owner)
                return false

        # The specific `Segment.Host` / `Segment.Guest` member named in the signature
        # `can[...]` ("Host"/"Guest"), or "" when none. Used to derive both the
        # transition owner (with Unsafe.SegmentMutation) and a plain required owner.
        def header_segment_owner_member(parser: Parser&) -> sview:
            can Abort.Panic:
                machine over parser.position:
                    state Scan(index: usize)
                    start Scan(0)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Ident and parser.header_token_text(index) == "Segment" and parser.peek_at(index + 1) == TokenKind.Dot and (parser.header_token_text(index + 2) == "Host" or parser.header_token_text(index + 2) == "Guest"):
                        return parser.header_token_text(index + 2)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Newline or parser.peek_at(index) == TokenKind.Eof:
                        return ""

                    Scan(index), _:
                        -> Scan(index + 1)
                return ""

        def header_has_segment_mutation(parser: Parser&) -> bool:
            can Abort.Panic:
                machine over parser.position:
                    state Scan(index: usize)
                    start Scan(0)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Ident and parser.header_token_text(index) == "Unsafe" and parser.peek_at(index + 1) == TokenKind.Dot and parser.header_token_text(index + 2) == "SegmentMutation":
                        return true

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Newline or parser.peek_at(index) == TokenKind.Eof:
                        return false

                    Scan(index), _:
                        -> Scan(index + 1)
                return false

        # The segment owner ("Host"/"Guest") a `@segment_transition(host|guest)` decorator
        # on the just-parsed signature establishes, or "" when absent. Reads the decorator's
        # first captured argument from `annotation_args`.
        def pending_decorator_segment_owner(parser: Parser&) -> sview:
            can Abort.Panic:
                machine over parser.position while true:
                    state Scan(index: usize)
                    start Scan(0)

                    Scan(index), _ if index >= parser.pending_decorators.count:
                        return ""

                    Scan(index), _ if parser.pending_decorators[index].name != "segment_transition" or parser.pending_decorators[index].arg_count == 0:
                        -> Scan(index + 1)

                    Scan(index), _ if parser.annotation_args[parser.pending_decorators[index].arg_start.usize()] == "host" or parser.annotation_args[parser.pending_decorators[index].arg_start.usize()] == "Host" or parser.annotation_args[parser.pending_decorators[index].arg_start.usize()] == "Segment.Host":
                        return "Host"

                    Scan(index), _ if parser.annotation_args[parser.pending_decorators[index].arg_start.usize()] == "guest" or parser.annotation_args[parser.pending_decorators[index].arg_start.usize()] == "Guest" or parser.annotation_args[parser.pending_decorators[index].arg_start.usize()] == "Segment.Guest":
                        return "Guest"

                    Scan(index), _:
                        -> Scan(index + 1)
                return ""

        # Emit the segment-flow side-table fact for an extern signature: which ambient
        # segment a call TRANSITIONS to (mutation + member, or a @segment_transition
        # decorator), or which ambient it REQUIRES (a plain Segment.X with no transition).
        # Mirrors stage0 funcTypeSegmentTransitionOwner / funcTypeRequiredSegmentOwner.
        def record_extern_segment_flow(parser: lmut Parser, name: sview, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                member: sview = parser.header_segment_owner_member()
                mutation: bool = parser.header_has_segment_mutation()
                deco_owner: sview = parser.pending_decorator_segment_owner()
                transition_owner: sview = deco_owner if deco_owner != "" else (member if mutation and member != "" else "")
                required_owner: sview = "" if transition_owner != "" else member
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__seg_transition_host", line: line}) if transition_owner == "Host"
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__seg_transition_guest", line: line}) if transition_owner == "Guest"
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__seg_required_host", line: line}) if required_owner == "Host"
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__seg_required_guest", line: line}) if required_owner == "Guest"

        # The FIRST effect ref inside a signature `can[...]` ("Console.Write",
        # "Abort", ...), spanning dotted segments, or "" when absent. Rendered into
        # stage0's exact ungranted-call warning for extern callees.
        def header_signature_can_ref(parser: Parser&) -> sview:
            can Abort.Panic:
                machine over parser.position:
                    state Scan(index: usize)
                    start Scan(0)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Ident and parser.header_token_text(index) == "can" and parser.peek_at(index + 1) == TokenKind.LBracket and parser.peek_at(index + 2) == TokenKind.Ident:
                        ref_start: u32 = parser.tokens[parser.position + index + 2].start
                        ref_end: u32 = ref_start + parser.tokens[parser.position + index + 2].length
                        final_end: u32 = parser.header_can_ref_end(index + 3, ref_end)
                        return Lexer::source_view_or_empty(parser.source, ref_start.usize(), final_end.usize())

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Newline or parser.peek_at(index) == TokenKind.Eof:
                        return ""

                    Scan(index), _:
                        -> Scan(index + 1)
                return ""

        def header_can_ref_end(parser: Parser&, segment: usize, ref_end: u32) -> u32:
            machine over parser.position:
                state Scan(index: usize, end: u32)
                start Scan(segment, ref_end)

                Scan(index, end), _ if parser.peek_at(index) == TokenKind.Dot and parser.peek_at(index + 1) == TokenKind.Ident:
                    next_end: u32 = parser.tokens[parser.position + index + 1].start + parser.tokens[parser.position + index + 1].length
                    -> Scan(index + 2, next_end)

                Scan(_, end), _:
                    return end
            return ref_end

        def header_error_family(parser: Parser&) -> sview:
            can Abort.Panic:
                machine over parser.position:
                    state Scan(index: usize)
                    start Scan(0)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Error and parser.peek_at(index + 1) == TokenKind.LBracket and parser.peek_at(index + 2) == TokenKind.Ident:
                        return parser.header_token_text(index + 2)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Newline or parser.peek_at(index) == TokenKind.Eof:
                        return ""

                    Scan(index), _:
                        -> Scan(index + 1)
                return ""

        # Preserve every family named by a function's `error[...]` destination. The
        # compact return-type AST intentionally omits the suffix; semantic raise/try
        # validation consumes these line-keyed rows instead.
        def capture_header_error_families(parser: lmut Parser, function_line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                inside_error_set: mutable bool = false
                # `{...}` after a family (`error[FooError{Bad1}]`) restricts the allowed
                # variant subset; capture the family (__error_variant_family) and each allowed
                # variant (__error_variant_allow) keyed by function line so a raise of another
                # variant of that family can be rejected.
                inside_variant_set: mutable bool = false
                restricted_family: mutable sview = ""
                scan: mutable usize = 0
                while parser.peek_at(scan) != TokenKind.Newline and parser.peek_at(scan) != TokenKind.Eof |parser, scan, inside_error_set, inside_variant_set, restricted_family|:
                    kind: TokenKind = parser.peek_at(scan)
                    starts_error_set: bool = kind == TokenKind.Error and parser.peek_at(scan + 1) == TokenKind.LBracket
                    inside_error_set <- true if starts_error_set
                    token: Token = parser.tokens[parser.position + scan]
                    previous_kind: TokenKind = parser.peek_at(scan - 1) if scan > 0 else TokenKind.Eof
                    family: bool = inside_error_set and kind == TokenKind.Ident and (previous_kind == TokenKind.LBracket or previous_kind == TokenKind.Comma)
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__error_set_family", name: Lexer::text_or_empty(token, parser.source), line: function_line}) if family
                    # Entering a `{` right after a family opens its variant-restriction set.
                    restricted_family <- Lexer::text_or_empty(token, parser.source) if family and parser.peek_at(scan + 1) == TokenKind.LBrace
                    inside_variant_set <- true if kind == TokenKind.LBrace and restricted_family != ""
                    if inside_variant_set and kind == TokenKind.Ident and (previous_kind == TokenKind.LBrace or previous_kind == TokenKind.Comma):
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__error_variant_family", name: restricted_family, line: function_line})
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__error_variant_allow", name: Lexer::text_or_empty(token, parser.source), line: function_line})
                    if kind == TokenKind.RBrace:
                        inside_variant_set <- false
                        restricted_family <- ""
                    inside_error_set <- false if inside_error_set and kind == TokenKind.RBracket
                    scan <- scan + 1

        # Consume an extern's balanced parameter list while counting only top-level
        # `name:` entries. This deliberately leaves foreign/variadic type syntax opaque,
        # matching the old permissive skipper while retaining enough shape for arity.
        def scan_extern_params(parser: lmut Parser, arity: mutable u32&, variadic: mutable bool&) -> void:
            parser, _ <- parser.expect(TokenKind.LParen)
            depth: mutable int = 0
            param_name: mutable sview = ""
            type_name: mutable sview = ""
            protocol_state: mutable sview = ""
            generic_ident_count: mutable u32 = 0
            provenance: mutable bool = false
            after_colon: mutable bool = false
            mutable_ref: mutable bool = false
            while parser.peek() != TokenKind.Eof |parser, depth, arity, variadic, param_name, type_name, protocol_state, generic_ident_count, provenance, after_colon, mutable_ref|:
                current_token: Token = parser.cursor()
                kind: TokenKind = current_token.kind
                break if depth == 0 and kind == TokenKind.RParen
                is_param_head: bool = depth == 0 and kind == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon
                param_name <- Lexer::text_or_empty(current_token, parser.source) if is_param_head else param_name
                arity <- arity + 1 if is_param_head else arity
                after_colon <- true if is_param_head else after_colon
                is_type_head: bool = depth == 0 and after_colon and kind == TokenKind.Ident and type_name == "" and parser.peek_at(1) != TokenKind.Colon
                type_name <- Lexer::text_or_empty(current_token, parser.source) if is_type_head else type_name
                is_generic_ident: bool = depth == 1 and after_colon and kind == TokenKind.Ident
                generic_ident_count <- generic_ident_count + 1 if is_generic_ident else generic_ident_count
                protocol_state <- Lexer::text_or_empty(current_token, parser.source) if is_generic_ident and generic_ident_count == 2 else protocol_state
                provenance <- true if after_colon and (kind == TokenKind.Ampersand or kind == TokenKind.Lmut)
                # A `mutable`/`lmut` marker anywhere in the param makes it a mutable binding.
                mutable_ref <- true if depth == 0 and (kind == TokenKind.Mutable or kind == TokenKind.Lmut)
                variadic <- true if depth == 0 and kind == TokenKind.Ellipsis
                finishes_param: bool = depth == 0 and kind == TokenKind.Comma and param_name != ""
                retained_type: sview = protocol_state if protocol_state != "" and (type_name == "Thread" or type_name == "Task") else type_name
                parser.extern_params <- parser.extern_params.push(Ast::ExternParam{name: param_name, type_name: retained_type, provenance_bearing: provenance, mutable_ref: mutable_ref}) if finishes_param
                param_name <- "" if finishes_param else param_name
                type_name <- "" if finishes_param else type_name
                protocol_state <- "" if finishes_param else protocol_state
                generic_ident_count <- 0 if finishes_param else generic_ident_count
                provenance <- false if finishes_param else provenance
                mutable_ref <- false if finishes_param else mutable_ref
                after_colon <- false if finishes_param else after_colon
                depth <- depth + 1 if kind == TokenKind.LParen or kind == TokenKind.LBracket
                depth <- depth - 1 if kind == TokenKind.RParen or kind == TokenKind.RBracket
                parser, _ <- parser.advance()
            retained_type: sview = protocol_state if protocol_state != "" and (type_name == "Thread" or type_name == "Task") else type_name
            parser.extern_params <- parser.extern_params.push(Ast::ExternParam{name: param_name, type_name: retained_type, provenance_bearing: provenance, mutable_ref: mutable_ref}) if param_name != ""
            parser, _ <- parser.expect(TokenKind.RParen)

        def reject_extern_param_defaults(parser: lmut Parser) -> void:
            return if parser.peek() != TokenKind.LParen
            saved_position: usize = parser.position
            parser.position <- parser.position + 1
            machine over parser.position while true:
                state Scan(depth: int)
                start Scan(1)

                Scan(depth), _ if depth <= 0 or parser.peek() == TokenKind.Eof:
                    break

                Scan(1), _ if parser.peek() == TokenKind.Assign:
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, parser.cursor())
                    parser.position <- parser.position + 1
                    -> Scan(1)

                Scan(depth), _ if parser.peek() == TokenKind.LParen:
                    parser.position <- parser.position + 1
                    -> Scan(depth + 1)

                Scan(depth), _ if parser.peek() == TokenKind.RParen:
                    parser.position <- parser.position + 1
                    -> Scan(depth - 1)

                Scan(depth), _:
                    parser.position <- parser.position + 1
                    -> Scan(depth)
            parser.position <- saved_position

        # `func`/`fn` word immediately after `export`/`extern` before the name.
        def skip_export_func_word(parser: lmut Parser) -> void:
            func_word: Token = parser.cursor()
            func_word_text: sview = Lexer::text_or_empty(func_word, parser.source)
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, func_word) if func_word_text == "func"
            parser <- parser.advance_when(func_word_text == "func" or func_word_text == "fn")

        # `extern:`/`export:` indented block, entered with the cursor on the opening `:`.
        def parse_extern_trailing_block(parser: lmut Parser) -> void:
            parser, _ <- parser.advance()               # `:`
            parser <- parser.skip_indented_block()

        # Scan (without consuming) the rest of an `export fn` signature line for a `= TARGET`
        # re-export clause and record TARGET on the side-table for the undefined-target check.
        def record_export_reexport_target(parser: lmut Parser, export_name: sview, target_name: sview, line: u32) -> void:
            return if export_name == "" or target_name == ""
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: export_name, name: target_name, line: line})
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: target_name, name: "__export_target_ref", line: line})

        def record_export_reexport_generic_if(parser: lmut Parser, export_name: sview, target_name: sview, line: u32, argument: sview, has_argument: bool) -> void:
            return if not has_argument or export_name == ""
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: export_name, name: argument, line: 3900000060})

        def capture_export_reexport_target(parser: lmut Parser, export_name: sview, line: u32) -> void:
            saved_position: usize = parser.position
            machine over parser.position while true:
                state Scan(scan: usize)
                start Scan(0)

                Scan(scan), _ if saved_position + scan >= parser.tokens.count or parser.tokens[saved_position + scan].kind == TokenKind.Newline or parser.tokens[saved_position + scan].kind == TokenKind.Dedent or parser.tokens[saved_position + scan].kind == TokenKind.Eof:
                    break

                Scan(scan), _ if parser.tokens[saved_position + scan].kind == TokenKind.Assign and saved_position + scan + 1 < parser.tokens.count and parser.tokens[saved_position + scan + 1].kind == TokenKind.Ident:
                    target_token: Token = parser.tokens[saved_position + scan + 1]
                    target_name: sview = Lexer::text_or_empty(target_token, parser.source)
                    has_generic_argument: bool = saved_position + scan + 3 < parser.tokens.count and parser.tokens[saved_position + scan + 2].kind == TokenKind.LBracket and parser.tokens[saved_position + scan + 3].kind == TokenKind.Ident
                    generic_argument: sview = Lexer::text_or_empty(parser.tokens[saved_position + scan + 3], parser.source) if has_generic_argument else sview("", 0, 0)
                    parser <- parser.record_export_reexport_target(export_name, target_name, line)
                    parser <- parser.record_export_reexport_generic_if(export_name, target_name, line, generic_argument, has_generic_argument)
                    parser.position <- saved_position + scan + 1
                    -> Scan(scan + 1)

                Scan(scan), _:
                    parser.position <- saved_position + scan + 1
                    -> Scan(scan + 1)
            parser.position <- saved_position

        # Consume the remainder of a single-line extern (the `: T`), stopping before
        # the newline/dedent/eof.
        def skip_extern_line_remainder(parser: lmut Parser) -> void:
            machine over parser.position while parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Dedent and parser.peek() != TokenKind.Eof:
                state Skip
                start Skip

                Skip, _:
                    parser.position <- parser.position + 1
                    -> Skip
