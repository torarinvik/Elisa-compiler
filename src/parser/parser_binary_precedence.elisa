# Shared operator binding powers for the parser. This is kept separate from the
# precedence-climbing loop so the ordering can be proved over the exact table that
# the production parser calls.
module ParserBinaryPrecedence:
    public:
        const ARROW_OR: int = 1
        const AND: int = 2
        const COMPARISON: int = 3
        const RANGE: int = 4
        const BITWISE_OR: int = 5
        const BITWISE_XOR: int = 6
        const BITWISE_AND: int = 7
        const SHIFT: int = 8
        const ADDITIVE: int = 9
        const MULTIPLICATIVE: int = 10

        def precedence(kind: Lexer::TokenKind) -> int:
            return when kind:
                # Function-type/result arrow and boolean disjunction bind loosest.
                Lexer::TokenKind.Arrow | Lexer::TokenKind.Or -> ARROW_OR
                Lexer::TokenKind.And -> AND
                # Membership, refinement tests, reinterpret-target `as`, and comparisons.
                Lexer::TokenKind.EqEq | Lexer::TokenKind.BangEq | Lexer::TokenKind.Lt | Lexer::TokenKind.Gt | Lexer::TokenKind.LtEq | Lexer::TokenKind.GtEq | Lexer::TokenKind.In | Lexer::TokenKind.Is | Lexer::TokenKind.As -> COMPARISON
                # Range constructors bind between comparison and arithmetic.
                Lexer::TokenKind.Range | Lexer::TokenKind.RangeLt | Lexer::TokenKind.RangeGt | Lexer::TokenKind.RangeLe -> RANGE
                Lexer::TokenKind.Pipe -> BITWISE_OR
                Lexer::TokenKind.Caret -> BITWISE_XOR
                Lexer::TokenKind.Ampersand -> BITWISE_AND
                Lexer::TokenKind.LShift | Lexer::TokenKind.RShift -> SHIFT
                Lexer::TokenKind.Plus | Lexer::TokenKind.Minus -> ADDITIVE
                Lexer::TokenKind.Star | Lexer::TokenKind.Slash | Lexer::TokenKind.Percent -> MULTIPLICATIVE
                _ -> 0
