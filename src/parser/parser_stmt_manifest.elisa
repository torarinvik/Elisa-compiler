# Stage1 parser — the MANIFEST desugar (docs/120 §6, `extend Parser: private:`): a bare block
# whose whole value is a set of guarded branches lowers to an if/elif chain here, so the later
# stages never see the manifest form. Continues parser_stmt.elisa.

extend Parser:
    private:

        # Is `value` the docs/120 §6 manifest shape — a bare block whose whole value is an
        # `if` yielding one tuple per branch, each with exactly one element per place?
        def manifest_desugar_applies(value: Ast::Expr, targets: darray[Ast::Expr]) -> bool:
            false return if targets.count < 2
            match value:
                Expr.Block(block_statements, block_value, block_captures, block_line):
                    false return if block_statements.count > 0
                    match block_value:
                        Expr.If(condition, then_value, else_value, if_line):
                            match then_value:
                                Expr.Tuple(then_elements, then_line):
                                    match else_value:
                                        Expr.Tuple(else_elements, else_line):
                                            return then_elements.count == targets.count and else_elements.count == targets.count
                                        _:
                                            pass
                                _:
                                    pass
                        _:
                            pass
                _:
                    pass
            return false



        # One branch of the desugared manifest.
        #
        # For a REBIND (`<-`) the branch stays ONE parallel assignment, `[places] <- [elements]`,
        # rather than one statement per position. Two reasons, and the first is a correctness
        # rule, not a tidiness one:
        #
        #   * the multi-target form is where an `lmut` method call in a threading position means
        #     "call it, and the value is the MUTATED RECEIVER" (`parser, out <- parser.advance(),
        #     out.push(d)`). Splitting the branch into single-target statements ERASES that
        #     context, and the surviving `parser <- parser.advance()` reaches the single-target
        #     store path, where the reading is not available — stage1 declined the whole function
        #     (corpus `lmut_threading_value`) while stage0 accepted it. Keeping the parallel shape
        #     hands the branch to the emitter that already implements the rule, and leaves the
        #     BARE single-target spelling declining exactly as stage0 rejects it.
        #   * the parallel emitter evaluates every element BEFORE storing any of them, which is
        #     what a positional branch means: `a, b <- b, a` inside an `if` must still swap.
        #
        # Self-assignments are KEPT here (a `<-` branch re-states an untouched place only to hold
        # its column); the parallel path stores each place from its own element, so a place
        # assigned its own name is a self-store and cannot lose a value. A `=` branch is DECLARING
        # names, which the parallel path does not do, so it keeps the per-position statements and
        # the self-assignment skip.
        def manifest_branch_body(targets: darray[Ast::Expr], elements: darray[Ast::Expr], assign_op: TokenKind, at_line: u32) -> darray[Ast::Stmt]:
            body: mutable darray[Ast::Stmt] = []
            if assign_op == TokenKind.LArrow:
                branch_targets: mutable darray[Ast::Expr] = []
                branch_elements: mutable darray[Ast::Expr] = []
                for parallel_index in 0..<targets.count |branch_targets, branch_elements, targets, elements|:
                    branch_targets.push(targets[parallel_index])
                    branch_elements.push(elements[parallel_index])
                body.push((Ast::Stmt.Assign((Ast::Expr.Array(branch_targets, Ast::pos_at_line(at_line))), assign_op, (Ast::Expr.Array(branch_elements, Ast::pos_at_line(at_line))), Ast::pos_at_line(at_line))))
                return body
            for index in 0..<targets.count |body, targets, elements, assign_op, at_line|:
                is_self_assignment: mutable bool = false
                match targets[index]:
                    Expr.Ident(target_name, target_line):
                        match elements[index]:
                            Expr.Ident(element_name, element_line):
                                is_self_assignment <- element_name == target_name
                            _:
                                pass
                    _:
                        pass
                continue if is_self_assignment
                body.push((Ast::Stmt.Assign(targets[index], assign_op, elements[index], Ast::pos_at_line(at_line))))
            return body



        def manifest_to_if_statement(parser: lmut Parser, value: Ast::Expr, targets: darray[Ast::Expr], assign_op: TokenKind, at_line: u32) -> Ast::Stmt:
            match value:
                Expr.Block(block_statements, block_value, block_captures, block_line):
                    match block_value:
                        Expr.If(condition, then_value, else_value, if_line):
                            match then_value:
                                Expr.Tuple(then_elements, then_line):
                                    match else_value:
                                        Expr.Tuple(else_elements, else_line):
                                            return (Ast::Stmt.If(condition, manifest_branch_body(targets, then_elements, assign_op, at_line), manifest_branch_body(targets, else_elements, assign_op, at_line), Ast::pos_at_line(at_line)))
                                        _:
                                            pass
                                _:
                                    pass
                        _:
                            pass
                _:
                    pass
            return (Ast::Stmt.Invalid)
