# Stage1 parser — the HEADER PROBES that read an extern line without consuming it: its `can`
# grants, its contract clauses, the ownership and mutation a segment declares, and the error
# families it names. Part of `module Parser` (see parser.elisa).

extend Parser:
    private:

        def header_has_signature_can(parser: Parser&) -> bool:
            can Abort.Panic:
                machine over parser.position:
                    state Scan(index: usize)
                    start Scan(0)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Ident and parser.header_token_text(index) == "can" and parser.peek_at(index + 1) == TokenKind.LBracket:
                        return true

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Newline or parser.peek_at(index) == TokenKind.Eof:
                        return false

                    Scan(index), _:
                        -> Scan(index + 1)
                return false



        # Whether the extern signature header declares a `requires`/`require`/`ensure`/`ensures` boundary
        # contract (consumed by skip_declaration_header_clauses without being modeled). Used to
        # mark contract-bearing externs for the -strict-externs check.
        def header_has_signature_contract(parser: Parser&) -> bool:
            can Abort.Panic:
                machine over parser.position:
                    state Scan(index: usize, depth: int)
                    start Scan(0, 0)

                    Scan(index, depth), _ if depth == 0 and parser.peek_at(index) == TokenKind.Ident and not parser.header_token_is_qualified(index) and (parser.header_token_text(index) == "requires" or parser.header_token_text(index) == "require" or parser.header_token_text(index) == "ensure" or parser.header_token_text(index) == "ensures") and parser.peek_at(index + 1) != TokenKind.Return:
                        return true

                    Scan(index, _), _ if parser.peek_at(index) == TokenKind.Newline or parser.peek_at(index) == TokenKind.Eof:
                        return false

                    Scan(index, depth), _ if parser.peek_at(index) == TokenKind.LParen or parser.peek_at(index) == TokenKind.LBracket:
                        -> Scan(index + 1, depth + 1)

                    Scan(index, depth), _ if parser.peek_at(index) == TokenKind.RParen or parser.peek_at(index) == TokenKind.RBracket:
                        -> Scan(index + 1, depth - 1)

                    Scan(index, depth), _:
                        -> Scan(index + 1, depth)
                return false



        # Whether the signature header's `can[...]` grants a segment-transition owner: it
        # establishes an owner only when it contains BOTH `Unsafe.SegmentMutation` AND one of
        # `Segment.Guest` / `Segment.Host` (mirrors stage0 permissionRefsTransitionOwner). Such an
        # extern needs an explicit @segment_transition so the owner is a typed contract.
        def header_grants_segment_owner(parser: Parser&) -> bool:
            can Abort.Panic:
                scan: mutable usize = 0
                machine over scan while true:
                    state Scan(has_mutation: bool, has_owner: bool)
                    start Scan(false, false)

                    Scan(has_mutation, has_owner), _ if parser.peek_at(scan) == TokenKind.Newline or parser.peek_at(scan) == TokenKind.Eof:
                        return has_mutation and has_owner

                    Scan(has_mutation, has_owner), _ if parser.peek_at(scan) == TokenKind.Ident and parser.peek_at(scan + 1) == TokenKind.Dot and parser.peek_at(scan + 2) == TokenKind.Ident:
                        head_text: sview = Lexer::text_or_empty(parser.tokens[parser.position + scan], parser.source, parser.source_length)
                        member_text: sview = Lexer::text_or_empty(parser.tokens[parser.position + scan + 2], parser.source, parser.source_length)
                        next_mutation: bool = has_mutation or (head_text == "Unsafe" and member_text == "SegmentMutation")
                        next_owner: bool = has_owner or (head_text == "Segment" and (member_text == "Guest" or member_text == "Host"))
                        scan <- scan + 1
                        -> Scan(next_mutation, next_owner)

                    Scan(has_mutation, has_owner), _:
                        scan <- scan + 1
                        -> Scan(has_mutation, has_owner)
                return false



        # The specific `Segment.Host` / `Segment.Guest` member named in the signature
        # `can[...]` ("Host"/"Guest"), or "" when none. Used to derive both the
        # transition owner (with Unsafe.SegmentMutation) and a plain required owner.
        def header_segment_owner_member(parser: Parser&) -> sview:
            can Abort.Panic:
                machine over parser.position:
                    state Scan(index: usize)
                    start Scan(0)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Ident and parser.header_token_text(index) == "Segment" and parser.peek_at(index + 1) == TokenKind.Dot and (parser.header_token_text(index + 2) == "Host" or parser.header_token_text(index + 2) == "Guest"):
                        return parser.header_token_text(index + 2)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Newline or parser.peek_at(index) == TokenKind.Eof:
                        return ""

                    Scan(index), _:
                        -> Scan(index + 1)
                return ""



        def header_has_segment_mutation(parser: Parser&) -> bool:
            can Abort.Panic:
                machine over parser.position:
                    state Scan(index: usize)
                    start Scan(0)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Ident and parser.header_token_text(index) == "Unsafe" and parser.peek_at(index + 1) == TokenKind.Dot and parser.header_token_text(index + 2) == "SegmentMutation":
                        return true

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Newline or parser.peek_at(index) == TokenKind.Eof:
                        return false

                    Scan(index), _:
                        -> Scan(index + 1)
                return false



        # The segment owner ("Host"/"Guest") a `@segment_transition(host|guest)` decorator
        # on the just-parsed signature establishes, or "" when absent. Reads the decorator's
        # first captured argument from `annotation_args`.
        def pending_decorator_segment_owner(parser: Parser&) -> sview:
            can Abort.Panic:
                machine over parser.position while true:
                    state Scan(index: usize)
                    start Scan(0)

                    Scan(index), _ if index >= parser.pending_decorators.count:
                        return ""

                    Scan(index), _ if parser.pending_decorators[index].name != "segment_transition" or parser.pending_decorators[index].arg_count == 0:
                        -> Scan(index + 1)

                    Scan(index), _ if parser.annotation_args[parser.pending_decorators[index].arg_start.usize()] == "host" or parser.annotation_args[parser.pending_decorators[index].arg_start.usize()] == "Host" or parser.annotation_args[parser.pending_decorators[index].arg_start.usize()] == "Segment.Host":
                        return "Host"

                    Scan(index), _ if parser.annotation_args[parser.pending_decorators[index].arg_start.usize()] == "guest" or parser.annotation_args[parser.pending_decorators[index].arg_start.usize()] == "Guest" or parser.annotation_args[parser.pending_decorators[index].arg_start.usize()] == "Segment.Guest":
                        return "Guest"

                    Scan(index), _:
                        -> Scan(index + 1)
                return ""



        # Emit the segment-flow side-table fact for an extern signature: which ambient
        # segment a call TRANSITIONS to (mutation + member, or a @segment_transition
        # decorator), or which ambient it REQUIRES (a plain Segment.X with no transition).
        # Mirrors stage0 funcTypeSegmentTransitionOwner / funcTypeRequiredSegmentOwner.
        def record_extern_segment_flow(parser: lmut Parser, name: sview @source, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                member: sview = parser.header_segment_owner_member()
                mutation: bool = parser.header_has_segment_mutation()
                deco_owner: sview = parser.pending_decorator_segment_owner()
                transition_owner: sview = deco_owner if deco_owner != "" else (member if mutation and member != "" else "")
                required_owner: sview = "" if transition_owner != "" else member
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__seg_transition_host", line: line, module: parser.current_module}) if transition_owner == "Host"
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__seg_transition_guest", line: line, module: parser.current_module}) if transition_owner == "Guest"
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__seg_required_host", line: line, module: parser.current_module}) if required_owner == "Host"
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name, name: "__seg_required_guest", line: line, module: parser.current_module}) if required_owner == "Guest"



        # The FIRST effect ref inside a signature `can[...]` ("Console.Write",
        # "Abort", ...), spanning dotted segments, or "" when absent. Rendered into
        # stage0's exact ungranted-call warning for extern callees.
        def header_signature_can_ref(parser: Parser&) -> sview:
            can Abort.Panic:
                machine over parser.position:
                    state Scan(index: usize)
                    start Scan(0)

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Ident and parser.header_token_text(index) == "can" and parser.peek_at(index + 1) == TokenKind.LBracket and parser.peek_at(index + 2) == TokenKind.Ident:
                        ref_start: u32 = parser.tokens[parser.position + index + 2].start
                        ref_end: u32 = ref_start + parser.tokens[parser.position + index + 2].length
                        final_end: u32 = parser.header_can_ref_end(index + 3, ref_end)
                        return Lexer::source_view_or_empty(parser.source, parser.source_length, ref_start.usize(), final_end.usize())

                    Scan(index), _ if parser.peek_at(index) == TokenKind.Newline or parser.peek_at(index) == TokenKind.Eof:
                        return ""

                    Scan(index), _:
                        -> Scan(index + 1)
                return ""

        # Proof tools need the complete declared row, not the legacy first-member
        # diagnostic hint above. Preserve the exact interior source span only
        # after finding its matching closing bracket; incomplete rows get no
        # completeness marker. Consumers must parse/validate every member.
        def record_extern_effect_row(parser: lmut Parser, owner: sview @source, line: u32, owner_offset: u32) -> void can[Memory.Allocate, Abort.Panic]:
            index: mutable usize = 0
            while parser.peek_at(index) != TokenKind.Newline and parser.peek_at(index) != TokenKind.Eof:
                if parser.peek_at(index) == TokenKind.Ident and parser.header_token_text(index) == "can" and parser.peek_at(index + 1) == TokenKind.LBracket:
                    start: usize = (parser.tokens[parser.position + index + 1].start + parser.tokens[parser.position + index + 1].length).usize()
                    depth: mutable usize = 1
                    probe: mutable usize = index + 2
                    while parser.peek_at(probe) != TokenKind.Newline and parser.peek_at(probe) != TokenKind.Eof:
                        depth <- depth + 1 if parser.peek_at(probe) == TokenKind.LBracket
                        depth <- depth - 1 if parser.peek_at(probe) == TokenKind.RBracket
                        if depth == 0:
                            end: usize = parser.tokens[parser.position + probe].start.usize()
                            row: sview = Lexer::source_view_or_empty(parser.source, parser.source_length, start, end)
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: owner, name: "__extern_effect_row_complete", module: parser.current_module, line: line, offset: owner_offset})
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__extern_effect_row_text", name: row, module: parser.current_module, line: line, offset: owner_offset})
                            return
                        probe <- probe + 1
                    return
                index <- index + 1
            return



        def header_can_ref_end(parser: Parser&, segment: usize, ref_end: u32) -> u32:
            machine over parser.position:
                state Scan(index: usize, end: u32)
                start Scan(segment, ref_end)

                Scan(index, end), _ if parser.peek_at(index) == TokenKind.Dot and parser.peek_at(index + 1) == TokenKind.Ident:
                    next_end: u32 = parser.tokens[parser.position + index + 1].start + parser.tokens[parser.position + index + 1].length
                    -> Scan(index + 2, next_end)

                Scan(_, end), _:
                    return end
            return ref_end



        # `error[Mod::Name]` names Name; the leading segments are MODULES, not the family.
        # Returning the token right after `[` returned the module, so `try` was told the
        # callee propagated "Backend" while its function returned "SceneError". stage0
        # accepts the qualified spelling, and from inside a nested module accepts ONLY it.
        def header_error_family_tail(parser: Parser&, index: usize, depth: u32) -> sview:
            qualified: bool = parser.peek_at(index + 1) == TokenKind.Scope and parser.peek_at(index + 2) == TokenKind.Ident
            return parser.header_token_text(index) if depth > 8 or not qualified
            return parser.header_error_family_tail(index + 2, depth + 1)



        # Scan a callable header's top-level error clauses. An error set written after
        # a returned function type belongs to that function type; the enclosing callable's
        # own set, when present, follows the returned type's callable clauses. Count the
        # top-level function-type arrows and select the final error set after those nested
        # clauses. Parameter function types are nested in the declaration's parameter
        # parentheses and are therefore excluded.
        def header_error_family_at(parser: Parser&, start: usize) -> (family: sview, occurrence_offset: u32):
            can Abort.Panic:
                parenthesis_depth: mutable u32 = 0
                bracket_depth: mutable u32 = 0
                method_return_arrow_seen: mutable bool = false
                returned_function_arrows: mutable u32 = 0
                top_level_error_sets: mutable u32 = 0
                selected_family: mutable sview = ""
                selected_occurrence: mutable u32 = 0
                scan: mutable usize = start
                while parser.peek_at(scan) != TokenKind.Newline and parser.peek_at(scan) != TokenKind.Eof |parser, scan, parenthesis_depth, bracket_depth, method_return_arrow_seen, returned_function_arrows, top_level_error_sets, selected_family, selected_occurrence|:
                    kind: TokenKind = parser.peek_at(scan)
                    at_type_level: bool = parenthesis_depth == 0 and bracket_depth == 0
                    break if at_type_level and (kind == TokenKind.Colon or kind == TokenKind.Assign)
                    if at_type_level and kind == TokenKind.Arrow:
                        if method_return_arrow_seen:
                            returned_function_arrows <- returned_function_arrows + 1
                        else:
                            method_return_arrow_seen <- true
                    clause_word: sview = Lexer::text_or_empty(parser.tokens[parser.position + scan], parser.source, parser.source_length) if at_type_level and kind == TokenKind.Ident else ""
                    # A returned function's `can[...]` belongs to that nested callable,
                    # and its own `error[...]` may follow it before the enclosing set.
                    # Keep scanning through the effect bracket; the return-type parser's
                    # error occurrence count below distinguishes the nested and outer rows.
                    break if at_type_level and (clause_word == "requires" or clause_word == "require" or clause_word == "ensures" or clause_word == "ensure" or clause_word == "changes" or clause_word == "preserves" or clause_word == "decreases" or clause_word == "invariant" or clause_word == "uses" or clause_word == "where" or clause_word == "at" or clause_word == "abi")
                    is_error_set: bool = at_type_level and kind == TokenKind.Error and parser.peek_at(scan + 1) == TokenKind.LBracket and parser.peek_at(scan + 2) == TokenKind.Ident
                    if is_error_set:
                        top_level_error_sets <- top_level_error_sets + 1
                        selected_family <- parser.header_error_family_tail(scan + 2, 0)
                        selected_occurrence <- parser.tokens[parser.position + scan].start
                    parenthesis_depth <- parenthesis_depth + 1 if kind == TokenKind.LParen
                    parenthesis_depth <- parenthesis_depth - 1 if kind == TokenKind.RParen and parenthesis_depth > 0
                    bracket_depth <- bracket_depth + 1 if kind == TokenKind.LBracket
                    bracket_depth <- bracket_depth - 1 if kind == TokenKind.RBracket and bracket_depth > 0
                    scan <- scan + 1.usize()
                return (selected_family, selected_occurrence) if top_level_error_sets > returned_function_arrows
                return ("", 0)



        def header_error_family(parser: Parser&) -> (family: sview, occurrence_offset: u32):
            return parser.header_error_family_at(0)



        # Core stores qualified error-set names in dotted form, with aliases left as
        # written. Build that exact sort key from identifier tokens so source trivia
        # around `::` cannot change the backend's ABI family order.
        def header_error_family_order_key(parser: Parser&, start_scan: usize, end_scan: usize) -> sview @source:
            can Abort.Panic, Memory.Allocate:
                bytes: mutable darray[u8] = []
                has_segment: mutable bool = false
                for index in start_scan..<(end_scan + 1.usize()) |bytes, has_segment, parser|:
                    continue if parser.peek_at(index) != TokenKind.Ident
                    bytes.push(46) if has_segment
                    token: Token = parser.tokens[parser.position + index]
                    segment: sview = Lexer::text_or_empty(token, parser.source, parser.source_length)
                    for byte_index in 0..<segment.len |bytes, segment|:
                        bytes.push(segment[byte_index])
                    has_segment <- true
                return persist_name_bytes(&bytes, 0) can Global{Read,Write}



        # Protocol method signatures do not become ordinary Decl.Func nodes, so their
        # parameter function types are not visited by capture_header_error_families.
        # Capture their ordinary family/path rows and both brace- and dot-selected subsets;
        # the protocol method's own return occurrence is handled by its protocol rows.
        def capture_protocol_callback_error_sets_at(parser: lmut Parser, function_line: u32, function_offset: u32, start: usize, excluded_occurrence: u32, identity_id: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                inside_error_set: mutable bool = false
                error_set_bracket_depth: mutable u32 = 0
                error_set_brace_depth: mutable u32 = 0
                error_set_occurrence_offset: mutable u32 = 0
                error_family_path_start: mutable usize = 0.usize()
                error_family_path_start_token: mutable usize = 0.usize()
                inside_variant_set: mutable bool = false
                restricted_family: mutable sview = ""
                restricted_family_has_variant: mutable bool = false
                dot_variant_family: mutable sview = ""
                scan: mutable usize = start
                while parser.peek_at(scan) != TokenKind.Newline and parser.peek_at(scan) != TokenKind.Eof |parser, scan, inside_error_set, error_set_bracket_depth, error_set_brace_depth, error_set_occurrence_offset, error_family_path_start, error_family_path_start_token, inside_variant_set, restricted_family, restricted_family_has_variant, dot_variant_family|:
                    kind: TokenKind = parser.peek_at(scan)
                    token: Token = parser.tokens[parser.position + scan]
                    starts_error_set: bool = kind == TokenKind.Error and parser.peek_at(scan + 1) == TokenKind.LBracket
                    if starts_error_set:
                        inside_error_set <- true
                        error_set_bracket_depth <- 0
                        error_set_brace_depth <- 0
                        error_set_occurrence_offset <- token.start
                        error_family_path_start <- 0.usize()
                        error_family_path_start_token <- 0.usize()
                        inside_variant_set <- false
                        restricted_family <- ""
                        restricted_family_has_variant <- false
                        dot_variant_family <- ""
                    previous_kind: TokenKind = parser.peek_at(scan - 1) if scan > 0 else TokenKind.Eof
                    error_family_path_start <- token.start.usize() if inside_error_set and error_set_brace_depth == 0 and kind == TokenKind.Ident and (previous_kind == TokenKind.LBracket or previous_kind == TokenKind.Comma)
                    error_family_path_start_token <- scan if inside_error_set and error_set_brace_depth == 0 and kind == TokenKind.Ident and (previous_kind == TokenKind.LBracket or previous_kind == TokenKind.Comma)
                    path_head: bool = parser.peek_at(scan + 1) == TokenKind.Scope
                    family: bool = inside_error_set and error_set_brace_depth == 0 and kind == TokenKind.Ident and (previous_kind == TokenKind.LBracket or previous_kind == TokenKind.Comma or previous_kind == TokenKind.Scope) and not path_head
                    if family and error_set_occurrence_offset != excluded_occurrence:
                        family_name: sview = Lexer::text_or_empty(token, parser.source, parser.source_length)
                        family_path: sview @source = parser.span_view(error_family_path_start, token.start.usize() + token.length.usize())
                        family_order_key: sview @source = parser.header_error_family_order_key(error_family_path_start_token, scan) can Global{Read,Write}
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__error_set_family", name: family_name, line: function_line, offset: function_offset, module: parser.current_module, identity_id: identity_id, occurrence_offset: error_set_occurrence_offset, family_order_key: family_order_key})
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__error_set_family_path", name: family_path, line: function_line, offset: function_offset, identity_id: identity_id, occurrence_offset: error_set_occurrence_offset})
                        restricted_family <- family_name if parser.peek_at(scan + 1) == TokenKind.LBrace
                        dot_variant_family <- family_name if parser.peek_at(scan + 1) == TokenKind.Dot
                    if family and error_set_occurrence_offset != excluded_occurrence and parser.peek_at(scan + 1) == TokenKind.LBrace:
                        restricted_family_has_variant <- false
                    if inside_error_set and error_set_occurrence_offset != excluded_occurrence and dot_variant_family != "" and kind == TokenKind.Ident and previous_kind == TokenKind.Dot:
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__error_variant_family", name: dot_variant_family, line: function_line, offset: function_offset, identity_id: identity_id, occurrence_offset: error_set_occurrence_offset})
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__error_variant_allow", name: Lexer::text_or_empty(token, parser.source, parser.source_length), line: function_line, offset: function_offset, identity_id: identity_id, occurrence_offset: error_set_occurrence_offset})
                        dot_variant_family <- ""
                    if inside_error_set and kind == TokenKind.LBrace and restricted_family != "":
                        inside_variant_set <- true
                        restricted_family_has_variant <- false
                    if inside_variant_set and error_set_occurrence_offset != excluded_occurrence and kind == TokenKind.Ident and (previous_kind == TokenKind.LBrace or previous_kind == TokenKind.Comma):
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__error_variant_family", name: restricted_family, line: function_line, offset: function_offset, identity_id: identity_id, occurrence_offset: error_set_occurrence_offset})
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__error_variant_allow", name: Lexer::text_or_empty(token, parser.source, parser.source_length), line: function_line, offset: function_offset, identity_id: identity_id, occurrence_offset: error_set_occurrence_offset})
                        restricted_family_has_variant <- true
                    error_set_brace_depth <- error_set_brace_depth + 1 if inside_error_set and kind == TokenKind.LBrace
                    if inside_error_set and kind == TokenKind.RBrace and error_set_brace_depth > 0:
                        error_set_brace_depth <- error_set_brace_depth - 1
                        if error_set_brace_depth == 0:
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__error_variant_family", name: restricted_family, line: function_line, offset: function_offset, identity_id: identity_id, occurrence_offset: error_set_occurrence_offset}) if inside_variant_set and not restricted_family_has_variant and error_set_occurrence_offset != excluded_occurrence
                            inside_variant_set <- false
                            restricted_family <- ""
                            restricted_family_has_variant <- false
                    if inside_error_set and kind == TokenKind.LBracket and previous_kind != TokenKind.Error:
                        error_set_bracket_depth <- error_set_bracket_depth + 1
                    if inside_error_set and kind == TokenKind.RBracket:
                        if error_set_bracket_depth > 0:
                            error_set_bracket_depth <- error_set_bracket_depth - 1
                        else:
                            inside_error_set <- false
                            dot_variant_family <- ""
                    scan <- scan + 1.usize()



        # `error[]` has no family or subset marker for the header scanners to retain.
        # Also preserve `Family{}` groups globally: header scanners capture their own rows,
        # but ordinary field and local type positions have no declaration-header callback.
        def empty_error_subset_count(parser: Parser&, error_index: usize) -> usize can[Abort.Panic]:
            can Abort.Panic:
                count: mutable usize = 0
                scan: mutable usize = error_index + 2.usize()
                brace_depth: mutable u32 = 0
                previous_kind: mutable TokenKind = TokenKind.LBracket
                while scan < parser.tokens.count |count, scan, brace_depth, previous_kind, parser|:
                    kind: TokenKind = parser.scan_token_kind(scan)
                    break if kind == TokenKind.Eof
                    if kind == TokenKind.RBracket and brace_depth == 0:
                        return count
                    if kind == TokenKind.LBrace:
                        empty_end: mutable usize = scan + 1.usize()
                        while empty_end < parser.tokens.count |empty_end, parser|:
                            layout_kind: TokenKind = parser.scan_token_kind(empty_end)
                            break if layout_kind != TokenKind.Newline and layout_kind != TokenKind.Indent and layout_kind != TokenKind.Dedent
                            empty_end <- empty_end + 1.usize()
                        empty_group: bool = empty_end < parser.tokens.count and parser.scan_token_kind(empty_end) == TokenKind.RBrace
                        count <- count + 1.usize() if brace_depth == 0 and previous_kind == TokenKind.Ident and empty_group
                        brace_depth <- brace_depth + 1
                    elif kind == TokenKind.RBrace and brace_depth > 0:
                        brace_depth <- brace_depth - 1
                    previous_kind <- kind if kind != TokenKind.Newline and kind != TokenKind.Indent and kind != TokenKind.Dedent
                    scan <- scan + 1.usize()
                return count



        def captured_empty_error_subset_count(parser: Parser&, occurrence_offset: u32) -> usize can[Abort.Panic]:
            count: mutable usize = 0
            for index in 0..<parser.enum_annotations.count |parser, occurrence_offset|:
                annotation: Ast::EnumAnnotation = parser.enum_annotations[index]
                if annotation.owner == "__error_variant_family" and annotation.occurrence_offset == occurrence_offset:
                    has_allow_row: mutable bool = false
                    if index + 1.usize() < parser.enum_annotations.count:
                        next: Ast::EnumAnnotation = parser.enum_annotations[index + 1.usize()]
                        has_allow_row <- next.owner == "__error_variant_allow" and next.line == annotation.line and next.offset == annotation.offset and next.identity_id == annotation.identity_id and next.occurrence_offset == annotation.occurrence_offset
                    count <- count + 1.usize() if not has_allow_row
                elif annotation.owner == "__protocol_error_variant_family" and annotation.line == 3900000146 and annotation.occurrence_offset == occurrence_offset:
                    has_allow_row: mutable bool = false
                    if index + 1.usize() < parser.enum_annotations.count:
                        next: Ast::EnumAnnotation = parser.enum_annotations[index + 1.usize()]
                        has_allow_row <- next.owner == annotation.name and next.line == 3900000147 and next.module == annotation.module and next.offset == annotation.offset and next.occurrence_offset == annotation.occurrence_offset
                    count <- count + 1.usize() if not has_allow_row
            return count



        # `error[]` has no family or subset marker for the header scanners to retain.
        # Record it globally so semantic validation can match Stage0's zero-tag error in
        # every type position, including nested function types and protocol signatures.
        def record_missing_empty_error_subset_rows(parser: lmut Parser, error_token: Token, missing_count: usize) -> void:
            can Memory.Allocate, Abort.Panic:
                for missing_index in 0..<missing_count |parser, error_token|:
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__empty_error_set", name: "", line: error_token.line, offset: error_token.start, occurrence_offset: error_token.start})

        def scan_empty_error_set_syntax(parser: lmut Parser) -> void:
            can Memory.Allocate, Abort.Panic:
                machine over parser.tokens for index in 0..<parser.tokens.count:
                    state Scan
                    start Scan

                    Scan, _ if index + 2 >= parser.tokens.count:
                        -> Scan

                    Scan, _ if parser.scan_token_kind(index) == TokenKind.Error and parser.scan_token_kind(index + 1) == TokenKind.LBracket and parser.scan_token_kind(index + 2) == TokenKind.RBracket:
                        error_token: Token = parser.tokens[index]
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__empty_error_set", name: "", line: error_token.line, offset: error_token.start, occurrence_offset: error_token.start})
                        -> Scan

                    Scan, _ if parser.scan_token_kind(index) == TokenKind.Error and parser.scan_token_kind(index + 1) == TokenKind.LBracket:
                        error_token: Token = parser.tokens[index]
                        subset_count: usize = parser.empty_error_subset_count(index)
                        captured_count: usize = parser.captured_empty_error_subset_count(error_token.start)
                        missing_count: usize = subset_count - captured_count if subset_count > captured_count else 0.usize()
                        if missing_count > 0:
                            parser <- parser.record_missing_empty_error_subset_rows(error_token, missing_count)
                        -> Scan

                    Scan, _:
                        -> Scan



        # Preserve every family named by a function's `error[...]` destination. The
        # compact return-type AST intentionally omits the suffix; semantic raise/try
        # validation consumes these line-keyed rows instead.
        def capture_header_error_families(parser: lmut Parser, function_line: u32, function_offset: u32, identity_id: u32 = 0) -> void:
            can Memory.Allocate, Abort.Panic:
                inside_error_set: mutable bool = false
                error_set_bracket_depth: mutable u32 = 0
                error_set_brace_depth: mutable u32 = 0
                error_set_key_start: mutable usize = 0
                error_set_occurrence_offset: mutable u32 = 0
                error_family_path_start: mutable usize = 0
                error_family_path_start_token: mutable usize = 0
                complex_error_set: mutable bool = false
                # `{...}` after a family (`error[FooError{Bad1}]`) restricts the allowed
                # variant subset; capture the family (__error_variant_family) and each allowed
                # variant (__error_variant_allow) keyed by function line so a raise of another
                # variant of that family can be rejected.
                inside_variant_set: mutable bool = false
                restricted_family: mutable sview = ""
                restricted_family_has_variant: mutable bool = false
                dot_variant_family: mutable sview = ""
                scan: mutable usize = 0
                while parser.peek_at(scan) != TokenKind.Newline and parser.peek_at(scan) != TokenKind.Eof |parser, scan, inside_error_set, inside_variant_set, restricted_family, restricted_family_has_variant, dot_variant_family, error_family_path_start_token|:
                    kind: TokenKind = parser.peek_at(scan)
                    starts_error_set: bool = kind == TokenKind.Error and parser.peek_at(scan + 1) == TokenKind.LBracket
                    if starts_error_set:
                        inside_error_set <- true
                        error_set_bracket_depth <- 0
                        error_set_brace_depth <- 0
                        complex_error_set <- false
                        error_set_key_start <- parser.tokens[parser.position + scan + 2].start.usize() if parser.peek_at(scan + 2) != TokenKind.Eof
                        error_family_path_start <- 0.usize()
                        error_family_path_start_token <- 0.usize()
                        dot_variant_family <- ""
                    token: Token = parser.tokens[parser.position + scan]
                    error_set_occurrence_offset <- token.start if starts_error_set
                    previous_kind: TokenKind = parser.peek_at(scan - 1) if scan > 0 else TokenKind.Eof
                    # The family is the LAST segment of a `::` path, not the first.
                    # `error[Backend::SceneError]` names SceneError; recording the token
                    # after `[` unconditionally recorded Backend and dropped the member, so
                    # `try` had a destination set that does not exist ("cannot propagate
                    # Backend from a function returning SceneError"). stage0 accepts the
                    # qualified spelling, and from inside a nested module accepts ONLY it.
                    # A segment followed by `::` is a MODULE, so it is skipped; a segment
                    # preceded by `::` is the tail, so it is taken.
                    path_head: bool = parser.peek_at(scan + 1) == TokenKind.Scope
                    error_family_path_start <- token.start.usize() if inside_error_set and not inside_variant_set and kind == TokenKind.Ident and (previous_kind == TokenKind.LBracket or previous_kind == TokenKind.Comma)
                    error_family_path_start_token <- scan if inside_error_set and not inside_variant_set and kind == TokenKind.Ident and (previous_kind == TokenKind.LBracket or previous_kind == TokenKind.Comma)
                    family: bool = inside_error_set and not inside_variant_set and kind == TokenKind.Ident and (previous_kind == TokenKind.LBracket or previous_kind == TokenKind.Comma or previous_kind == TokenKind.Scope) and not path_head
                    family_path: mutable sview @source = ""
                    family_order_key: mutable sview @source = ""
                    if family:
                        family_path <- parser.span_view(error_family_path_start, token.start.usize() + token.length.usize())
                        family_order_key <- parser.header_error_family_order_key(error_family_path_start_token, scan) can Global{Read,Write}
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__error_set_family", name: Lexer::text_or_empty(token, parser.source, parser.source_length), line: function_line, offset: function_offset, module: parser.current_module, identity_id: identity_id, occurrence_offset: error_set_occurrence_offset, family_order_key: family_order_key}) if family
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__error_set_family_path", name: family_path, line: function_line, offset: function_offset, identity_id: identity_id, occurrence_offset: error_set_occurrence_offset}) if family
                    dot_variant_family <- Lexer::text_or_empty(token, parser.source, parser.source_length) if family and parser.peek_at(scan + 1) == TokenKind.Dot
                    # Entering a `{` right after a family opens its variant-restriction set.
                    if family and parser.peek_at(scan + 1) == TokenKind.LBrace:
                        restricted_family <- Lexer::text_or_empty(token, parser.source, parser.source_length)
                        restricted_family_has_variant <- false
                    if kind == TokenKind.LBrace and restricted_family != "":
                        inside_variant_set <- true
                        restricted_family_has_variant <- false
                    if inside_error_set and not inside_variant_set and dot_variant_family != "" and kind == TokenKind.Ident and previous_kind == TokenKind.Dot:
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__error_variant_family", name: dot_variant_family, line: function_line, offset: function_offset, identity_id: identity_id, occurrence_offset: error_set_occurrence_offset})
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__error_variant_allow", name: Lexer::text_or_empty(token, parser.source, parser.source_length), line: function_line, offset: function_offset, identity_id: identity_id, occurrence_offset: error_set_occurrence_offset})
                        dot_variant_family <- ""
                    if inside_variant_set and kind == TokenKind.Ident and (previous_kind == TokenKind.LBrace or previous_kind == TokenKind.Comma):
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__error_variant_family", name: restricted_family, line: function_line, offset: function_offset, identity_id: identity_id, occurrence_offset: error_set_occurrence_offset})
                        parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__error_variant_allow", name: Lexer::text_or_empty(token, parser.source, parser.source_length), line: function_line, offset: function_offset, identity_id: identity_id, occurrence_offset: error_set_occurrence_offset})
                        restricted_family_has_variant <- true
                    if inside_error_set and kind == TokenKind.Comma and error_set_brace_depth == 0:
                        complex_error_set <- true
                    if inside_error_set and kind == TokenKind.Dot and error_set_brace_depth == 0:
                        complex_error_set <- true
                    if inside_error_set and kind == TokenKind.LBrace:
                        complex_error_set <- true if error_set_brace_depth == 0
                        error_set_brace_depth <- error_set_brace_depth + 1
                    if inside_error_set and kind == TokenKind.RBrace:
                        error_set_brace_depth <- error_set_brace_depth - 1 if error_set_brace_depth > 0
                        if error_set_brace_depth == 0:
                            # Preserve the explicitly empty brace group for recovery and
                            # semantic diagnostics. Its marker has no allow rows, so consumers
                            # can distinguish it from a signature with no subset restriction.
                            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__error_variant_family", name: restricted_family, line: function_line, offset: function_offset, identity_id: identity_id, occurrence_offset: error_set_occurrence_offset}) if inside_variant_set and not restricted_family_has_variant
                            inside_variant_set <- false
                            restricted_family <- ""
                            restricted_family_has_variant <- false
                    if inside_error_set and kind == TokenKind.LBracket and previous_kind != TokenKind.Error:
                        error_set_bracket_depth <- error_set_bracket_depth + 1
                    if inside_error_set and kind == TokenKind.RBracket:
                        if error_set_bracket_depth > 0:
                            error_set_bracket_depth <- error_set_bracket_depth - 1
                        elif error_set_brace_depth == 0:
                            if complex_error_set:
                                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__error_set_key", name: parser.span_view(error_set_key_start, token.start.usize()), line: function_line, offset: function_offset, identity_id: identity_id, occurrence_offset: error_set_occurrence_offset})
                                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__error_set_module", name: parser.current_module, line: function_line, offset: function_offset, identity_id: identity_id, occurrence_offset: error_set_occurrence_offset})
                            inside_error_set <- false
                            dot_variant_family <- ""
                    scan <- scan + 1
