# Stage1 parser — named payload patterns (docs/122 §5.7): `Enum.Variant(field: p, _)`.
# The labeled form is lowered to the positional one at parse time, so every consumer of
# Pattern.Variant keeps reading fields by position. A form that cannot be lowered
# (positional and named mixed, an unknown or repeated field, missing fields without the
# final `_`) is left labeled; check_named_payload_patterns reports it with stage0's
# sentence. `-emit fmt` (preserve_parens) keeps what was written.

extend Parser:
    private:
        def record_pattern_variant(parser: lmut Parser, enum_name: sview @source, variant_name: sview @source, field_names: darray[sview @source]&, common_count: usize) -> void:
            can Memory.Allocate, Abort.Panic:
                parser.pattern_variant_enums <- parser.pattern_variant_enums.push(enum_name)
                parser.pattern_variant_names <- parser.pattern_variant_names.push(variant_name)
                parser.pattern_variant_field_starts <- parser.pattern_variant_field_starts.push(parser.pattern_variant_field_names.count)
                own_count: usize = field_names.count - common_count if field_names.count > common_count else 0
                parser.pattern_variant_field_counts <- parser.pattern_variant_field_counts.push(own_count)
                for field_index in common_count..<field_names.count |parser, field_names|:
                    parser.pattern_variant_field_names <- parser.pattern_variant_field_names.push(field_names[field_index])

        # Whether `path[from..to]` spells `name`.
        def pattern_path_span_is(path: sview, span_start: usize, span_end: usize, name: sview) -> bool:
            can Abort.Panic:
                return false if name.len < 0 or span_end < span_start or (span_end - span_start).i64() != name.len
                for offset in 0..<(span_end - span_start) |path, span_start, name|:
                    return false if path[span_start + offset] != name[offset]
                return true

        # The row of `path`'s variant: `Enum.Variant` (module prefix ignored) or a bare
        # `Variant` when exactly one enum declares it. Returns the row count when unknown.
        def pattern_variant_row(parser: Parser&, path: sview) -> usize:
            can Abort.Panic:
                path_count: usize = path.len.usize() if path.len > 0 else 0
                last_scope: mutable usize = 0
                last_dot: mutable usize = path_count
                for index in 0..<path_count |last_scope, last_dot, path, path_count|:
                    if index + 1 < path_count and path[index] == ':' and path[index + 1] == ':':
                        last_scope <- index + 2
                    elif path[index] == '.':
                        last_dot <- index
                rows: usize = parser.pattern_variant_names.count
                if last_dot < path_count and last_dot >= last_scope:
                    for row in 0..<rows |parser, path, last_scope, last_dot, path_count|:
                        return row if pattern_path_span_is(path, last_scope, last_dot, parser.pattern_variant_enums[row]) and pattern_path_span_is(path, last_dot + 1, path_count, parser.pattern_variant_names[row])
                    return rows
                found: mutable usize = rows
                for row in 0..<rows |parser, path, last_scope, path_count, found, rows|:
                    if pattern_path_span_is(path, last_scope, path_count, parser.pattern_variant_names[row]):
                        return rows if found != rows
                        found <- row
                return found

        # Lower labeled variant fields to declaration order, `_` for omitted ones.
        def lower_named_variant_fields(parser: lmut Parser, path: sview, fields: darray[Ast::Pattern] @source) -> darray[Ast::Pattern] @source:
            can Memory.Allocate, Abort.Panic:
                return fields if parser.preserve_parens
                return fields if not (any field in fields where field is Ast::Pattern.Field)
                named_count: mutable usize = fields.count
                rest: mutable bool = false
                if fields.count > 0 and fields[fields.count - 1] is Ast::Pattern.Wildcard:
                    rest <- true
                    named_count <- fields.count - 1
                for index in 0..<named_count |fields|:
                    return fields if not (fields[index] is Ast::Pattern.Field)
                row: usize = pattern_variant_row(parser, path)
                if row >= parser.pattern_variant_names.count:
                    parser.named_pattern_unresolved <- true if not parser.named_pattern_seeded
                    return fields
                start: usize = parser.pattern_variant_field_starts[row]
                count: usize = parser.pattern_variant_field_counts[row]
                positional: mutable darray[Ast::Pattern] @source = []
                matched: mutable usize = 0
                for field_index in 0..<count |parser, positional, matched, fields, named_count, start|:
                    declared: sview = parser.pattern_variant_field_names[start + field_index]
                    hits: mutable usize = 0
                    chosen: mutable Ast::Pattern = Ast::Pattern.Wildcard
                    for index in 0..<named_count |hits, chosen, fields, declared|:
                        match fields[index]:
                            Ast::Pattern.Field(selector, inner):
                                if selector == declared and inner.count == 1:
                                    hits <- hits + 1
                                    chosen <- inner[0]
                            _:
                                pass
                    return fields if hits > 1 or (hits == 0 and not rest)
                    matched <- matched + hits
                    positional.push(chosen)
                # A label that names no declared field.
                return fields if matched != named_count
                return positional
