# Value-threading, part 3: the file-wide table of threaded functions and the lookup of a call
# against it. Semantic and the backend build the table from the same declarations with
# value_thread_functions, so they agree on every call.
#
# Calls are matched by NAME and argument count, so a name that is not unique among all the
# file's functions and externs (any module, any arity) is left out of the table: its threaded
# parameter keeps the ordinary by-value meaning, which is always correct, only not in place.
extend Ast:
    public:
        def value_thread_collect_names(declarations: darray[Decl], names: mutable darray[sview]&) -> void:
            for declaration in declarations |names|:
                match declaration:
                    Decl.Func(function_name, _, _, _, _, _, _):
                        names.push(function_name)
                    Decl.Extern(extern_name, _, _, _, _, _, _, _):
                        names.push(extern_name)
                    Decl.Module(_, module_body, _):
                        value_thread_collect_names(module_body, names)
                    Decl.Scoped(scoped_body, _):
                        value_thread_collect_names(scoped_body, names)
                    _:
                        pass

        def value_thread_collect(declarations: darray[Decl], found: mutable darray[ValueThreadFn]&) -> void:
            for declaration in declarations |found|:
                match declaration:
                    Decl.Func(function_name, params, return_type, _, _, _, function_pos):
                        for param_index in 0..<params.count |found|:
                            param: ParamDecl = params[param_index]
                            if param.value_thread:
                                tuple_slot: mutable i64 = -1
                                if return_type is result_type:
                                    tuple_slot <- value_thread_result_slot(result_type, param.type_expression)
                                found.push(ValueThreadFn{name: function_name, arity: params.count, slot: param_index, tuple_slot: tuple_slot, param_name: param.name, param_type: param.type_expression, pos: function_pos})
                    Decl.Module(_, module_body, _):
                        value_thread_collect(module_body, found)
                    Decl.Scoped(scoped_body, _):
                        value_thread_collect(scoped_body, found)
                    _:
                        pass

        # Every threaded function declared in DECLARATIONS whose name is unique there.
        def value_thread_functions(declarations: darray[Decl]) -> darray[ValueThreadFn]:
            candidates: mutable darray[ValueThreadFn] = []
            value_thread_collect(declarations, candidates)
            return candidates if candidates.count == 0
            names: mutable darray[sview] = []
            value_thread_collect_names(declarations, names)
            unique: mutable darray[ValueThreadFn] = []
            for candidate in candidates |unique|:
                uses: mutable usize = 0
                for name in names |uses|:
                    uses <- uses + 1 if name == candidate.name
                unique.push(candidate) if uses == 1
            return unique

        def value_thread_find(functions: darray[ValueThreadFn]&, name: sview, arity: usize) -> i64:
            for function_index in 0..<functions.count:
                return function_index.i64() if functions[function_index].name == name and functions[function_index].arity == arity
            return -1

        # The callee name of CALLEE (`f`, `M::f`, or a method `x.f`), or "".
        def value_thread_callee_name(callee: Expr) -> sview:
            match callee:
                Expr.Ident(callee_name, _):
                    return callee_name
                Expr.Scope(_, scoped_name, _):
                    return scoped_name
                Expr.Field(_, method_name, _):
                    return method_name
                _:
                    return sview("", 0, 0)

        # Whether CALLEE is the method spelling `receiver.f(...)` (the receiver is argument 0).
        def value_thread_is_method_call(callee: Expr) -> bool:
            return callee is Expr.Field(_, _, _)

        # The threaded function a call reaches, or -1. Named arguments are not matched.
        def value_thread_call_index(functions: darray[ValueThreadFn]&, callee: Expr, arguments: darray[Expr], argument_names: darray[sview]) -> i64:
            return -1 if functions.count == 0
            name: sview = value_thread_callee_name(callee)
            return -1 if name == ""
            for argument_name in argument_names:
                return -1 if argument_name != ""
            arity: usize = arguments.count + 1 if value_thread_is_method_call(callee) else arguments.count
            return value_thread_find(functions, name, arity)

        # The argument a call passes in the threaded parameter's slot.
        def value_thread_call_argument(function: ValueThreadFn&, callee: Expr, arguments: darray[Expr]) -> Expr:
            if callee is Expr.Field(receiver, _, _):
                return receiver if function.slot == 0
                return arguments[function.slot - 1]
            return arguments[function.slot]
