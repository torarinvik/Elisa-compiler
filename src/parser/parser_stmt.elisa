# Stage1 parser — statement parsing (`extend Parser: private:`). Covers `statement` dispatch,
# `for`/`if`/`while`/`return`, match statements and patterns. Split out of parser.elisa to
# keep each part file under 600 lines; see parser.elisa for the module overview.

extend Parser:
    private:
        # ============================================================
        # Statement parsing
        # ============================================================

        # The `EXPR as T` value cast was removed (use `expression.cast[T]` / `T(expression)` /
        # `&expression`). By the time a completed statement value expression is followed
        # by `as`, every legitimate `as` (is/catch aliases, expect/lock/using) has
        # been consumed by its own parser — so a trailing `as` here is the removed
        # cast. Emit ONE directed error at the `as` and consume `as TYPE` so the
        # rest of the line does not cascade (matches stage0's recover-as-canonical).
        def consume_removed_as_cast(parser: lmut Parser, value: Ast::Expr) -> Ast::Expr:
            if parser.peek() == TokenKind.As:
                rebind as_token: Token, parser = parser.advance()          # `as`
                parser, _ <- parser.unary_expression()                   # parse + discard the cast target type
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, as_token)
            return value


        # Depth-guarded entry: every statement — including a nested block body
        # (`if:`/`while:`/`for:`/`match` arm), which re-enters via parse_block ->
        # statement -> if_statement -> parse_block — passes through here, so bounding
        # `parser.depth` bounds statement-nesting recursion the same way it bounds
        # expression recursion. Over the limit we emit one diagnostic and return
        # null; parse_block's advance-on-null recovery then guarantees progress
        # (no hang) while the stack stays bounded (no overflow).
        def statement(parser: lmut Parser) -> Ast::Stmt?:
            parser.depth <- parser.depth + 1
            if parser.depth > EXPR_DEPTH_LIMIT:
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, parser.cursor())
                parser.depth <- parser.depth - 1
                return null
            rebind result: Ast::Stmt?, parser = parser.statement_inner()
            parser.depth <- parser.depth - 1
            return result


        def statement_inner(parser: lmut Parser) -> Ast::Stmt?:
            kind: TokenKind = parser.peek()
            token: Token = parser.cursor()

            match kind:
                TokenKind.If:
                    rebind __ret_49: Ast::Stmt?, parser = parser.if_statement()
                    return __ret_49

                TokenKind.While:
                    rebind __ret_52: Ast::Stmt?, parser = parser.while_statement()
                    return __ret_52

                TokenKind.Return:
                    rebind __ret_55: Ast::Stmt?, parser = parser.return_statement()
                    return __ret_55

                TokenKind.Match:
                    rebind __ret_58: Ast::Stmt?, parser = parser.match_statement()
                    return __ret_58

                TokenKind.Break:
                    parser, _ <- parser.advance()
                    # `break if COND` desugars to `if COND: break` (mirrors postfix
                    # `return if`). A real If node is built so the guard's references are
                    # resolved like any other condition.
                    rebind accepted_if: bool, parser = parser.accept(TokenKind.If)
                    if accepted_if:
                        rebind condition: Ast::Expr, parser = get parser.expression()
                        body: mutable darray[Ast::Stmt] = []
                        body.push((Ast::Stmt.Break("", token.line)))
                        no_else: darray[Ast::Stmt] = []
                        return (Ast::Stmt.If(condition, body, no_else, token.line))
                    return (Ast::Stmt.Break("", token.line))

                TokenKind.Continue:
                    parser, _ <- parser.advance()
                    # `continue if COND` desugars to `if COND: continue`.
                    rebind accepted_if_2: bool, parser = parser.accept(TokenKind.If)
                    if accepted_if_2:
                        rebind condition: Ast::Expr, parser = get parser.expression()
                        body: mutable darray[Ast::Stmt] = []
                        body.push((Ast::Stmt.Continue("", token.line)))
                        no_else: darray[Ast::Stmt] = []
                        return (Ast::Stmt.If(condition, body, no_else, token.line))
                    else:
                        return (Ast::Stmt.Continue("", token.line))

                TokenKind.Pass:
                    parser, _ <- parser.advance()
                    return (Ast::Stmt.Expr((Ast::Expr.Invalid), token.line))

                TokenKind.With | TokenKind.Region | TokenKind.In | TokenKind.Error:
                    rebind __ret_92: Ast::Stmt?, parser = parser.prefixed_block_statement()
                    return __ret_92

                TokenKind.Try:
                    # `try:` opens a handler block; a bare `try EXPR` statement is a
                    # fallible call — parse it as an expression statement (get_expression
                    # consumes the `try` head and any `else` recovery tail) so the
                    # call's references resolve instead of being token-skipped.
                    if parser.peek_at(1) == TokenKind.Colon:
                        rebind __ret_100: Ast::Stmt?, parser = parser.prefixed_block_statement()
                        return __ret_100
                    rebind try_value: Ast::Expr, parser = get parser.expression()
                    return (Ast::Stmt.Expr(try_value, token.line))

                TokenKind.Catch:
                    rebind __ret_105: Ast::Stmt?, parser = parser.catch_statement()
                    return __ret_105
                _:
                    # `static if/elif/else COND:` compile-time conditional inside a body —
                    # consumed as a prefix block (the condition is skipped to the colon).
                    if kind == TokenKind.Static:
                        next_kind: TokenKind = parser.peek_at(1)
                        if next_kind == TokenKind.If or next_kind == TokenKind.Elif or next_kind == TokenKind.Else:
                            rebind __ret_112: Ast::Stmt?, parser = parser.prefixed_block_statement()
                            return __ret_112
                        else:    
                            # `static <directive>` (e.g. `static error("…")`): consume the
                            # `static` marker and parse the directive as a statement.
                            parser, _ <- parser.advance()
                            rebind __ret_117: Ast::Stmt?, parser = parser.statement()
                            return __ret_117

                    # Contextual-keyword statements (the lexer emits these as identifiers).
                    if kind == TokenKind.Ident:
                        head: sview = Lexer::text_or_empty(token, parser.source)
                        # Effect/concurrency block openers (`can …:`, `nursery workers(n):`,
                        # `pool …:`, `parallel …:`) — prefix consumed to the block colon.
                        if head == "can" or head == "trusted" or head == "nursery" or head == "pool" or head == "parallel":
                            rebind __ret_125: Ast::Stmt?, parser = parser.prefixed_block_statement()
                            return __ret_125
                        # `lock MUTEX:` / `lock MUTEX as GUARD:` synchronized block. `lock`
                        # is also a legal identifier, so only when a mutex name follows
                        # (`lock = …` / `lock(…)` stay ordinary identifier uses).
                        if head == "lock" and parser.peek_at(1) == TokenKind.Ident:
                            rebind __ret_130: Ast::Stmt?, parser = parser.prefixed_block_statement()
                            return __ret_130
                        # `expect EXPR as PATTERN[:block]` / `expect let PATTERN = EXPR` —
                        # pattern assertion; desugars to a one-arm Match (stage0's own
                        # lowering) so the pattern's bindings resolve inside the block.
                        if head == "expect" and tokenStartsValue(parser.peek_at(1)):
                            rebind __ret_135: Ast::Stmt?, parser = parser.expect_statement()
                            return __ret_135
                        if head == "for":
                            rebind __ret_137: Ast::Stmt?, parser = parser.for_statement()
                            return __ret_137
                        # `machine over INPUT [while COND] [-> YIELD]:` (docs/123) —
                        # contextual: only when the ident `over` immediately follows.
                        if head == "machine" and parser.machine_over_ahead():
                            rebind __ret_machine: Ast::Stmt?, parser = parser.machine_statement()
                            return __ret_machine
                        # `rebind TARGET,… = <block/expression>` (docs/119 §5): explicit mutation
                        # threading. A soft keyword — only when an identifier target follows
                        # (`rebind = …` / `rebind: T` stay ordinary local uses).
                        if head == "rebind" and parser.peek_at(1) == TokenKind.Ident:
                            rebind __ret_142: Ast::Stmt?, parser = parser.rebind_statement()
                            return __ret_142
                        # `region NAME(size):` / `region NAME:` scratch-region block.
                        # `region` is also a legal identifier (a struct field / local named
                        # `region`), so treat it as the block keyword only when a region
                        # name (an ident) immediately follows; `region:`/`region.`/`region =`
                        # stay ordinary identifier uses.
                        if head == "region" and parser.peek_at(1) == TokenKind.Ident:
                            rebind __ret_149: Ast::Stmt?, parser = parser.prefixed_block_statement()
                            return __ret_149
                        # `guard` is a contextual keyword AND a legal identifier (e.g. a
                        # local `guard: MutexGuard = …`). Only treat it as a guard
                        # statement when a top-level `else` follows on the same line.
                        if head == "guard" and parser.looks_like_guard_statement():
                            rebind __ret_154: Ast::Stmt?, parser = parser.guard_statement()
                            return __ret_154
                        # Design-by-contract statements (`requires E` / `ensure E` /
                        # `decreases E` / `invariant E` / `changes PATH`) — contextual
                        # keywords, also legal identifiers, so only when the next token
                        # starts an operand on the same line (Ident or a literal; an
                        # assignment/colon after the name is an ordinary local use).
                        if head == "requires" or head == "ensure" or head == "ensures" or head == "decreases" or head == "invariant" or head == "changes":
                            next_kind: TokenKind = parser.peek_at(1)
                            if next_kind in {TokenKind.Ident, TokenKind.IntLit, TokenKind.FloatLit, TokenKind.StringLit, TokenKind.CharLit, TokenKind.True, TokenKind.False, TokenKind.Not}:
                                rebind __ret_163: Ast::Stmt?, parser = parser.contract_statement()
                                return __ret_163

                    # `IDENT:` immediately followed by a newline is a labeled/arm block
                    # (e.g. a `catch …:` block's `ok:` success arm), not a binding.
                    if kind == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon and parser.peek_at(2) == TokenKind.Newline:
                        rebind __ret_168: Ast::Stmt?, parser = parser.prefixed_block_statement()
                        return __ret_168

                    # `IDENT :` introduces a local binding (`x: T` / `x: T = v`).
                    if kind == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon:
                        rebind __ret_172: Ast::Stmt?, parser = parser.variable_declaration_statement()
                        return __ret_172

                    # Otherwise an expression statement, an assignment/binding
                    # (`target <- value` / `target = value`), or a guarded return.
                    rebind target_raw: Ast::Expr, parser = get parser.expression()
                    rebind target: Ast::Expr, parser = parser.consume_removed_as_cast(target_raw)
                    # Multi-target (tuple-unpack) assignment `a, b = expression` / `a, b <- expression`:
                    # collect the comma-separated targets into an Array target. Bare-ident
                    # targets bind as new locals (see gather_locals).
                    if parser.peek() == TokenKind.Comma:
                        targets: mutable darray[Ast::Expr] = [target]
                        while parser.accept(TokenKind.Comma) |parser|:
                            rebind more_target_option: Ast::Expr?, parser = parser.expression()
                            if more_target_option is more_target:
                                targets.push(more_target)
                        if parser.peek() == TokenKind.LArrow or parser.peek() == TokenKind.Assign or isCompoundAssign(parser.peek()):
                            rebind multi_operator_token: Token, parser = parser.advance()

                            multi_operator: TokenKind = multi_operator_token.kind
                            # docs/119 §2: `a, b =` NEWLINE INDENT … — bare block whose tail
                            # tuple binds the targets.
                            if parser.block_value_rhs_ahead():
                                rebind __v_213: Ast::Expr, parser = parser.parse_block_value_rhs()
                                return (Ast::Stmt.Assign((Ast::Expr.Array(targets, token.line)), multi_operator, __v_213, token.line))
                            rebind first_value: Ast::Expr, parser = get parser.expression()
                            # The RHS may itself be a comma-separated tuple (`a, b <- b, a`),
                            # not just a single multi-valued call/expression — collect it the same
                            # way the LHS targets were collected above.
                            if parser.peek() == TokenKind.Comma:
                                values: mutable darray[Ast::Expr] = [first_value]
                                while parser.accept(TokenKind.Comma) |parser|:
                                    rebind more_value_option: Ast::Expr?, parser = parser.expression()
                                    if more_value_option is more_value:
                                        values.push(more_value)
                                return (Ast::Stmt.Assign((Ast::Expr.Array(targets, token.line)), multi_operator, (Ast::Expr.Array(values, token.line)), token.line))
                            return (Ast::Stmt.Assign((Ast::Expr.Array(targets, token.line)), multi_operator, first_value, token.line))
                        return (Ast::Stmt.Expr(target, token.line))
                    if parser.peek() == TokenKind.LArrow or parser.peek() == TokenKind.Assign or isCompoundAssign(parser.peek()):
                        rebind assign_operator_token: Token, parser = parser.advance()

                        assign_operator: TokenKind = assign_operator_token.kind
                        # docs/119 §2: `target <- ` / `target = ` NEWLINE INDENT … is a bare block.
                        if parser.block_value_rhs_ahead():
                            rebind __v_233: Ast::Expr, parser = parser.parse_block_value_rhs()
                            return (Ast::Stmt.Assign(target, assign_operator, __v_233, token.line))
                        rebind value_raw: Ast::Expr, parser = get parser.expression()
                        rebind value: Ast::Expr, parser = parser.consume_removed_as_cast(value_raw)
                        return (Ast::Stmt.Assign(target, assign_operator, value, token.line))
                    else:
                        # Postfix guarded return `VALUE return if COND` (== `if COND:
                        # return VALUE`). Desugared into a real If node so the guard's
                        # references resolve (and count as uses) like any condition.
                        if parser.peek() == TokenKind.Return:
                            parser, _ <- parser.advance()
                            rebind accepted_if_3: bool, parser = parser.accept(TokenKind.If)
                            if accepted_if_3:
                                rebind guard_condition: Ast::Expr, parser = get parser.expression()
                                guard_body: mutable darray[Ast::Stmt] = []
                                guard_body.push((Ast::Stmt.Return(target, token.line)))
                                guard_no_else: darray[Ast::Stmt] = []
                                return (Ast::Stmt.If(guard_condition, guard_body, guard_no_else, token.line))
                            return (Ast::Stmt.Return(target, token.line))
                        else:
                            return (Ast::Stmt.Expr(target, token.line))


        # `for VAR [, VAR]* in ITER: <block>` (contextual `for`; the lexer emits it as an
        # identifier). Every loop variable is recorded so destructuring loops bind them all.
        def for_statement(parser: lmut Parser) -> Ast::Stmt?:
            rebind for_token: Token, parser = parser.advance()              # consume the `for` identifier

            # Iteration binding intent, before the first variable (mirrors stage0
            # parseIterBindMode): `mutable` = mutate elements in place, nothing = read
            # (the compiler binds by reference under the hood when beneficial or
            # required — affine elements auto-borrow). The mechanism spellings
            # `ref` / `mutable ref` were removed; stage0 rejects them with a directed
            # error, so here a stray `ref` simply fails the variable-name expect.
            rebind accepted_mutable: bool, parser = parser.accept(TokenKind.Mutable)
            bind: sview = "mutable" if accepted_mutable else ""

            variables_buffer: mutable darray[sview] = []
            rebind variable_token: Token, parser = parser.expect(TokenKind.Ident)
            variables_buffer.push(Lexer::text_or_empty(variable_token, parser.source))

            while parser.accept(TokenKind.Comma) |parser|:
                rebind next_variable_token: Token, parser = parser.expect(TokenKind.Ident)
                variables_buffer.push(Lexer::text_or_empty(next_variable_token, parser.source))

            parser, _ <- parser.expect(TokenKind.In)
            # docs/119 §3: binary parsing stops at a header's opening `|` (loop_header_at),
            # so the ordinary iterable parse already yields the pre-header expression; a
            # genuine bitwise `|` in the iterable is consumed normally.
            rebind iterable_expression: Ast::Expr, parser = get parser.expression()
            # Optional `where COND` filter (contextual keyword): `for x in xs where P:`.
            # Consumed so the loop header parses; the condition is parsed (not stored on
            # the For node, which has no filter slot).
            where_token: Token = parser.cursor()
            if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(where_token, parser.source) == "where":
                parser, _ <- parser.advance()                       # `where`
                parser, _ <- parser.expression()                          # filter condition (consumed)
            # docs/119 §3: optional loop-expression header `|acc = init, …| [-> yield]`.
            header_declarations: mutable darray[Ast::Stmt] = []
            header_captures: mutable darray[sview] = []
            header_yield: mutable Ast::Expr = (Ast::Expr.Invalid)
            header_has_yield: mutable bool = false
            header_present: bool = parser.loop_header_at()
            if header_present:
                header_yield, parser <- parser.parse_loop_header(header_declarations, header_captures, header_has_yield)
            # Chained `for a in A for b in B: body` == nested loops: the inner `for`
            # becomes the single body statement of the outer loop.
            chain_token: Token = parser.cursor()
            if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(chain_token, parser.source) == "for":
                nested: mutable darray[Ast::Stmt] = []
                rebind __m_302: Ast::Stmt?, parser = parser.for_statement()
                if __m_302 is inner_for:
                    nested.push(inner_for)
                nested_loop: Ast::Stmt = (Ast::Stmt.For(bind, variables_buffer, iterable_expression, nested, for_token.line))
                if header_present:
                    rebind __ret_287: Ast::Stmt, parser = parser.wrap_loop_header(header_declarations, header_yield, nested_loop, for_token.line, header_captures)
                    return __ret_287
                return nested_loop
            rebind body: darray[Ast::Stmt], parser = parser.parse_block()
            loop_statement: Ast::Stmt = (Ast::Stmt.For(bind, variables_buffer, iterable_expression, body, for_token.line))
            if header_present:
                rebind __ret_292: Ast::Stmt, parser = parser.wrap_loop_header(header_declarations, header_yield, loop_statement, for_token.line, header_captures)
                return __ret_292
            return loop_statement


