# Stage1 parser — statement parsing (`extend Parser: private:`). Covers `statement` dispatch,
# `for`/`if`/`while`/`return`, match statements and patterns. Split out of parser.elisa to
# keep each part file under 600 lines; see parser.elisa for the module overview.

extend Parser:
    private:
        # ============================================================
        # Statement parsing
        # ============================================================

        # The `EXPR as T` value cast was removed (use `expression.cast[T]` / `T(expression)` /
        # `&expression`). By the time a completed statement value expression is followed
        # by `as`, every legitimate `as` (is/catch aliases, expect/lock/using) has
        # been consumed by its own parser — so a trailing `as` here is the removed
        # cast. Emit ONE directed error at the `as` and consume `as TYPE` so the
        # rest of the line does not cascade (matches stage0's recover-as-canonical).
        def consume_removed_as_cast(parser: lmut Parser, value: Ast::Expr) -> Ast::Expr:
            if parser.peek() == TokenKind.As:
                rebind as_token: Token, parser = parser.advance()          # `as`
                parser, _ <- parser.unary_expression()                   # parse + discard the cast target type
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, as_token)
            return value


        # Depth-guarded entry: every statement — including a nested block body
        # (`if:`/`while:`/`for:`/`match` arm), which re-enters via parse_block ->
        # statement -> if_statement -> parse_block — passes through here, so bounding
        # `parser.depth` bounds statement-nesting recursion the same way it bounds
        # expression recursion. Over the limit we emit one diagnostic and return
        # null; parse_block's advance-on-null recovery then guarantees progress
        # (no hang) while the stack stays bounded (no overflow).
        def statement(parser: lmut Parser) -> Ast::Stmt?:
            parser.depth <- parser.depth + 1
            if parser.depth > EXPR_DEPTH_LIMIT:
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, parser.cursor())
                parser.depth <- parser.depth - 1
                return null
            rebind result: Ast::Stmt?, parser = parser.statement_inner()
            parser.depth <- parser.depth - 1
            return result


        def statement_inner(parser: lmut Parser) -> Ast::Stmt?:
            kind: TokenKind = parser.peek()
            token: Token = parser.cursor()

            match kind:
                TokenKind.If:
                    rebind __ret_49: Ast::Stmt?, parser = parser.if_statement()
                    return __ret_49

                TokenKind.While:
                    rebind __ret_52: Ast::Stmt?, parser = parser.while_statement()
                    return __ret_52

                TokenKind.Return:
                    rebind __ret_55: Ast::Stmt?, parser = parser.return_statement()
                    return __ret_55

                TokenKind.Match:
                    rebind __ret_58: Ast::Stmt?, parser = parser.match_statement()
                    return __ret_58

                TokenKind.Break:
                    parser, _ <- parser.advance()
                    # `break if COND` desugars to `if COND: break` (mirrors postfix
                    # `return if`). A real If node is built so the guard's references are
                    # resolved like any other condition.
                    rebind accepted_if: bool, parser = parser.accept(TokenKind.If)
                    if accepted_if:
                        rebind condition: Ast::Expr, parser = get parser.expression()
                        body: mutable darray[Ast::Stmt] = []
                        body.push((Ast::Stmt.Break("", token.line)))
                        no_else: darray[Ast::Stmt] = []
                        return (Ast::Stmt.If(condition, body, no_else, token.line))
                    return (Ast::Stmt.Break("", token.line))

                TokenKind.Continue:
                    parser, _ <- parser.advance()
                    # `continue if COND` desugars to `if COND: continue`.
                    rebind accepted_if_2: bool, parser = parser.accept(TokenKind.If)
                    if accepted_if_2:
                        rebind condition: Ast::Expr, parser = get parser.expression()
                        body: mutable darray[Ast::Stmt] = []
                        body.push((Ast::Stmt.Continue("", token.line)))
                        no_else: darray[Ast::Stmt] = []
                        return (Ast::Stmt.If(condition, body, no_else, token.line))
                    else:
                        return (Ast::Stmt.Continue("", token.line))

                TokenKind.Pass:
                    parser, _ <- parser.advance()
                    return (Ast::Stmt.Expr((Ast::Expr.Invalid), token.line))

                TokenKind.Error if parser.peek_at(1) == TokenKind.LParen:
                    rebind error_call: Ast::Expr, parser = get parser.expression()
                    return (Ast::Stmt.Expr(error_call, token.line))

                TokenKind.With | TokenKind.Region | TokenKind.In | TokenKind.Error:
                    # `region NAME` is unambiguously a region prefix; keep the new
                    # missing-block diagnostic scoped to that form. Other keyword
                    # tokens (`error(...)`, `in`, `with`) have legacy expression/recovery
                    # spellings whose primary-token support is intentionally unchanged.
