                        # return VALUE`). Desugared into a real If node so the guard's
                        # references resolve (and count as uses) like any condition.
                        match parser.peek():
                            TokenKind.Return:
                                parser, _ <- parser.advance()
                                rebind accepted_if_3: bool, parser = parser.accept(TokenKind.If)
                                if accepted_if_3:
