                        # ops guard; a `=` binding must bind unconditionally.
                        if assign_operator != TokenKind.Assign:
                            match value:
                                Expr.If(assign_guard_condition, assign_guarded_value, assign_guard_alternative, assign_guard_line):
                                    match assign_guard_alternative:
                                        Expr.Absent:
                                            assign_guard_body: mutable darray[Ast::Stmt] = []
                                            assign_guard_body.push((Ast::Stmt.Assign(target, assign_operator, assign_guarded_value, token.line)))
                                            assign_guard_no_else: darray[Ast::Stmt] = []
                                            return (Ast::Stmt.If(assign_guard_condition, assign_guard_body, assign_guard_no_else, token.line))
                                        _:
                                            pass
                                _:
                                    pass
