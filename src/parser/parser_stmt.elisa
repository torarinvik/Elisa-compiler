                        rebind __ret_100: Ast::Stmt?, parser = parser.prefixed_block_statement()
                        return __ret_100
                    rebind try_value: Ast::Expr, parser = get parser.expression()
                    return (Ast::Stmt.Expr(try_value, token.line))

                TokenKind.Catch:
                    rebind __ret_105: Ast::Stmt?, parser = parser.catch_statement()
                    return __ret_105
                _:
