                                                stmt_guard_body.push((Ast::Stmt.Expr(stmt_guarded_value, token.line)))
                                                stmt_guard_no_else: darray[Ast::Stmt] = []
                                                return (Ast::Stmt.If(stmt_guard_condition, stmt_guard_body, stmt_guard_no_else, token.line))
                                            _:
                                                pass
                                    _:
                                        pass
