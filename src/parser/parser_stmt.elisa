                            parser, _ <- parser.advance()
                            rebind region_name_token: Token, parser = parser.advance()
                            rebind has_region_capacity: bool, parser = parser.accept(TokenKind.LParen)
                            parser <- parser.expression_when(has_region_capacity)
                            parser <- parser.accept_when(TokenKind.RParen, has_region_capacity)
                            using_token: Token = parser.cursor()
                            has_region_strategy: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(using_token, parser.source) == "using"
                            parser <- parser.advance_when(has_region_strategy)
                            strategy_token: Token = parser.cursor()
                            has_strategy_name: bool = has_region_strategy and parser.peek() == TokenKind.Ident
                            parser <- parser.advance_when(has_strategy_name)
                            region_clause: mutable darray[sview] = []
                            region_clause.push(Lexer::text_or_empty(strategy_token, parser.source)) if has_strategy_name
                            no_body: darray[Ast::Stmt] = []
                            parser.local_region_annotations <- parser.local_region_annotations.push(Ast::LocalRegionAnnotation{name: "__region_local", type_expression: (Ast::Expr.Invalid), region: Lexer::text_or_empty(region_name_token, parser.source), line: token.line})
