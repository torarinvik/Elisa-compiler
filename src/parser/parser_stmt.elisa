                        # an ordinary for-loop. Preserve that structure so loop variables
                        # are scoped and resolved; the scheduling modifier is semantic
                        # metadata that does not alter the body AST.
                        if head == "parallel" and parser.peek_at(1) == TokenKind.Ident and Lexer::text_or_empty(parser.tokens[parser.position + 1], parser.source) == "for":
                            parser, _ <- parser.advance()
                            rebind parallel_for: Ast::Stmt?, parser = parser.for_statement(true)
                            return parallel_for
                        # Effect/concurrency block openers (`can …:`, `nursery workers(n):`,
                        # `pool …:`, `parallel …:`) — prefix consumed to the block colon.
                        if head == "can" or head == "trusted" or head == "nursery" or head == "scope" or head == "defer" or (head == "pool" and parser.peek_at(1) == TokenKind.Ident) or head == "parallel":
