# Stage1 parser — statement parsing (`extend Parser: private:`). Covers `statement` dispatch,
# `for`/`if`/`while`/`return`, match statements and patterns. Split out of parser.elisa to
# keep each part file under 600 lines; see parser.elisa for the module overview.

extend Parser:
    private:
        # ============================================================
        # Statement parsing
        # ============================================================

        # The `EXPR as T` value cast was removed (use `expression.cast[T]` / `T(expression)` /
        # `&expression`). By the time a completed statement value expression is followed
        # by `as`, every legitimate `as` (is/catch aliases, expect/lock/using) has
        # been consumed by its own parser — so a trailing `as` here is the removed
        # cast. Emit ONE directed error at the `as` and consume `as TYPE` so the
        # rest of the line does not cascade (matches stage0's recover-as-canonical).
        def consume_removed_as_cast(parser: lmut Parser, value: Ast::Expr) -> Ast::Expr:
            if parser.peek() == TokenKind.As:
                rebind as_token: Token, parser = parser.advance()          # `as`
                parser, _ <- parser.unary_expression()                   # parse + discard the cast target type
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, as_token)
            return value




        # Depth-guarded entry: every statement — including a nested block body
        # (`if:`/`while:`/`for:`/`match` arm), which re-enters via parse_block ->
        # statement -> if_statement -> parse_block — passes through here, so bounding
        # `parser.depth` bounds statement-nesting recursion the same way it bounds
        # expression recursion. Over the limit we emit one diagnostic and return
        # null; parse_block's advance-on-null recovery then guarantees progress
        # (no hang) while the stack stays bounded (no overflow).
        def statement(parser: lmut Parser) -> Ast::Stmt?:
            parser.depth <- parser.depth + 1
            if parser.depth > EXPR_DEPTH_LIMIT:
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, parser.cursor())
                parser.depth <- parser.depth - 1
                return null
            rebind result: Ast::Stmt?, parser = parser.statement_inner()
            parser.depth <- parser.depth - 1
            return result




        def statement_direct_keyword(parser: lmut Parser, kind: TokenKind, token: Token) -> Ast::Stmt?:
            if kind == TokenKind.If:
                rebind if_stmt: Ast::Stmt?, parser = parser.if_statement()
                return if_stmt
            if kind == TokenKind.While:
                rebind while_stmt: Ast::Stmt?, parser = parser.while_statement()
                return while_stmt
            if kind == TokenKind.Return:
                rebind return_stmt: Ast::Stmt?, parser = parser.return_statement()
                return return_stmt
            if kind == TokenKind.Match:
                rebind match_stmt: Ast::Stmt?, parser = parser.match_statement()
                return match_stmt
            if kind == TokenKind.Break:
                parser, _ <- parser.advance()
                rebind accepted_if: bool, parser = parser.accept(TokenKind.If)
                if accepted_if:
                    rebind condition: Ast::Expr, parser = get parser.expression()
                    return (Ast::Stmt.If(condition, [(Ast::Stmt.Break("", Ast::pos_of_token(token)))], [], Ast::pos_of_token(token)))
                return (Ast::Stmt.Break("", Ast::pos_of_token(token)))
            if kind == TokenKind.Continue:
                parser, _ <- parser.advance()
                rebind accepted_if: bool, parser = parser.accept(TokenKind.If)
                if accepted_if:
                    rebind condition: Ast::Expr, parser = get parser.expression()
                    return (Ast::Stmt.If(condition, [(Ast::Stmt.Continue("", Ast::pos_of_token(token)))], [], Ast::pos_of_token(token)))
                return (Ast::Stmt.Continue("", Ast::pos_of_token(token)))
            if kind == TokenKind.Pass:
                parser, _ <- parser.advance()
                return (Ast::Stmt.Expr((Ast::Expr.Invalid), Ast::pos_of_token(token)))
            if kind == TokenKind.Error and parser.peek_at(1) == TokenKind.LParen:
                rebind error_call: Ast::Expr, parser = get parser.expression()
                return (Ast::Stmt.Expr(error_call, Ast::pos_of_token(token)))
            return null





        def statement_inner(parser: lmut Parser) -> Ast::Stmt?:
            kind: TokenKind = parser.peek()
            token: Token = parser.cursor()

            # A local `state Name(field: Type)` is a parser directive, not executable
            # code. Leave its newline for parse_block's null-statement progress step,
            # exactly as stage0 skips its nil state declaration.
            if kind == TokenKind.Ident and Lexer::text_or_empty(token, parser.source) == "state" and (parser.peek_at(1) == TokenKind.Ident or parser.peek_at(1) == TokenKind.LBrace):
                if parser.peek_at(1) == TokenKind.LBrace:
                    parser <- parser.parse_pending_machine_state_decls()
                else:
                    rebind state_decl: MachineStateAst, parser = parser.parse_machine_state_decl()
                    parser.pending_state_decls <- parser.pending_state_decls.push(state_decl)
                return null

            rebind direct: Ast::Stmt?, parser = parser.statement_direct_keyword(kind, token)
            if direct is direct_result:
                return direct_result
            if (kind == TokenKind.With or kind == TokenKind.Region or kind == TokenKind.In or kind == TokenKind.Error):
                    # `region NAME` is unambiguously a region prefix; keep the new
                    # missing-block diagnostic scoped to that form. Other keyword
                    # tokens (`error(...)`, `in`, `with`) have legacy expression/recovery
                    # spellings whose primary-token support is intentionally unchanged.
                    if kind == TokenKind.Region and parser.peek_at(1) == TokenKind.Ident:
                        rebind __ret_92: Ast::Stmt?, parser = parser.prefixed_block_statement()
                        return __ret_92
                    rebind __ret_93: Ast::Stmt?, parser = parser.prefixed_block_statement()
                    return __ret_93
            if kind == TokenKind.Try:
                    # `try:` opens a handler block; a bare `try EXPR` statement is a
                    # fallible call — parse it as an expression statement (get_expression
                    # consumes the `try` head and any `else` recovery tail) so the
                    # call's references resolve instead of being token-skipped.
                    if parser.peek_at(1) == TokenKind.Colon:
                        rebind __ret_100: Ast::Stmt?, parser = parser.prefixed_block_statement()
                        return __ret_100
                    rebind try_value: Ast::Expr, parser = get parser.expression()
                    return (Ast::Stmt.Expr(try_value, Ast::pos_of_token(token)))
            if kind == TokenKind.Catch:
                    rebind __ret_105: Ast::Stmt?, parser = parser.catch_statement()
                    return __ret_105
            # `static if/elif/else COND:` compile-time conditional inside a body.
            # NOT routed through prefixed_block_statement: that path skips the
            # condition to the colon, and a discarded condition cannot be selected
            # on -- the backend then saw every branch's body (duplicate locals,
            # unresolvable per-target externs) and declined the whole function.
            if kind == TokenKind.Static:
                if parser.peek_at(1) == TokenKind.If or parser.peek_at(1) == TokenKind.Elif or parser.peek_at(1) == TokenKind.Else:
                    static_head: Token = parser.cursor()
                    parser, _ <- parser.advance()
                    static_chain_head: bool = parser.peek() == TokenKind.If
                    static_matched_head: bool = parser.peek() == TokenKind.If or parser.peek() == TokenKind.Elif
                    parser <- parser.advance_if(static_matched_head)
                    parser <- parser.capture_static_if_condition(static_head.line, static_chain_head) if static_matched_head
                    parser <- parser.record_static_else(static_head.line) if not static_matched_head
                    parser <- parser.accept_if(TokenKind.Else, not static_matched_head)
                    rebind static_body: darray[Ast::Stmt], parser = parser.parse_block()
                    static_empty_clause: darray[sview] = []
                    return (Ast::Stmt.Block("static", static_empty_clause, "", static_body, Ast::pos_of_token(static_head)))
                    # `static:` compile-time block — a bare indented body evaluated at
                    # compile time. Parse the body as an ordinary block (the prefix is
                    # just `static` up to the colon); its statements resolve normally.
                if parser.peek_at(1) == TokenKind.Colon:
                    rebind __ret_static_block: Ast::Stmt?, parser = parser.prefixed_block_statement()
                    return __ret_static_block
                else:
                        # `static <directive>` (e.g. `static error("…")`): consume the
                        # `static` marker and parse the directive as a statement.
                        parser, _ <- parser.advance()
                        # Body-level `static assert COND[, "MSG"]` (line form) or
                        # `static assert:` (block form) — record the assertions into the
                        # file's static-assert registry (mirroring the declaration path in
                        # parse_static) so check_static_assert can const-evaluate a false one.
                        directive_token: Token = parser.cursor()
                        if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(directive_token, parser.source) == "assert":
                            parser, _ <- parser.advance()          # `assert`
                            rebind accepted_colon: bool, parser = parser.accept(TokenKind.Colon)
                            parser <- parser.capture_static_assert_block() if accepted_colon
                            parser <- parser.capture_static_assert_line(directive_token.line) if not accepted_colon
                            # A benign, DISTINGUISHABLE no-op — not Stmt.Invalid, which the
                            # backend rightly declines as a parse failure. The assertion
                            # itself lives in the static-assert registry rows captured
                            # above; the statement's only job is to occupy the slot.
                            static_assert_empty_clause: darray[sview] = []
                            return (Ast::Stmt.Block("static_assert", static_assert_empty_clause, "", [], Ast::pos_of_token(directive_token)))
                        # `static <call>` (e.g. `static answer(2)`) is a compile-time
                        # context just like `static:` — wrap the directive in a static
                        # block so the static-call-context check treats it as one.
                        directive_line: u32 = directive_token.line
                        rebind __ret_117: Ast::Stmt?, parser = parser.statement()
                        if __ret_117 is static_directive_stmt:
                            static_directive_body: darray[Ast::Stmt] = [static_directive_stmt]
                            return (Ast::Stmt.Block("static", [], "", static_directive_body, Ast::pos_at_line(directive_line)))
                        return __ret_117

            # Contextual-keyword statements (the lexer emits these as identifiers).
            if kind == TokenKind.Ident:
                head: sview = Lexer::text_or_empty(token, parser.source)
                rebind contextual: Ast::Stmt?, parser = parser.contextual_statement(token, head)
                if contextual is contextual_result:
                    return contextual_result
            # `IDENT:` immediately followed by a newline is a labeled/arm block
            # (e.g. a `catch …:` block's `ok:` success arm), not a binding.
            if kind == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon and parser.peek_at(2) == TokenKind.Newline:
                rebind __ret_168: Ast::Stmt?, parser = parser.prefixed_block_statement()
                return __ret_168

            # `IDENT :` introduces a local binding (`x: T` / `x: T = v`).
            if kind == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon:
                rebind __ret_172: Ast::Stmt?, parser = parser.variable_declaration_statement()
                return __ret_172

            rebind expression_tail: Ast::Stmt?, parser = parser.statement_expression_tail(token)
            return expression_tail

include "./parser_stmt_contextual.elisa"
include "./parser_stmt_expression_tail.elisa"
include "./parser_stmt_manifest.elisa"
