                            let_match: Ast::Stmt = (Ast::Stmt.Match(let_value, let_arms, token.line))
                            let_bindings: mutable darray[sview] = []
                            pattern_binding_names(let_pattern, let_bindings)
                            let_lowered: mutable darray[Ast::Stmt] = [let_match]
                            for let_binding in let_bindings |let_lowered|:
                                let_lowered.push((Ast::Stmt.VarDecl(let_binding, (Ast::Expr.Invalid), (Ast::Expr.Absent), token.line)))
                            return (Ast::Stmt.Block("let", [], "", let_lowered, token.line))
                        if head == "for" and parser.peek_at(1) != TokenKind.LParen:
                            rebind __ret_137: Ast::Stmt?, parser = parser.for_statement(false)
                            return __ret_137
                        # `machine over INPUT [while COND] [-> YIELD]:` (docs/123) —
                        # contextual: only when the ident `over` immediately follows.
                        if head == "machine" and parser.machine_over_ahead():
                            rebind __ret_machine: Ast::Stmt?, parser = parser.machine_statement()
                            return __ret_machine
                        # `when SCRUT[, SCRUT]*:` (docs/125 §4) order-independent decision
                        # table — contextual: only when a scrutinee-starting token follows
                        # (`when = …` / `when(…)` / `when.f` stay ordinary identifier uses).
                        if head == "when" and parser.when_construct_ahead():
                            rebind __ret_when: Ast::Stmt?, parser = parser.when_statement()
                            return __ret_when
                        # `rebind TARGET,… = <block/expression>` (docs/119 §5): explicit mutation
                        # threading. A soft keyword — only when an identifier target follows
                        # (`rebind = …` / `rebind: T` stay ordinary local uses).
                        if head == "rebind" and parser.peek_at(1) == TokenKind.Ident:
                            rebind __ret_142: Ast::Stmt?, parser = parser.rebind_statement()
                            return __ret_142
                        # Manual region declaration (`region r(N) [using strategy]`) is
                        # a scope binding that remains live for subsequent statements,
                        # not a colon-introduced prefix block. Represent it with the
                        # existing binding-carrying Block node and an empty body.
