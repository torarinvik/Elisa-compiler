# Stage1 parser — statement parsing (`extend Parser: private:`). Covers `stmt` dispatch,
# `for`/`if`/`while`/`return`, match statements and patterns. Split out of parser.elisa to
# keep each part file under 600 lines; see parser.elisa for the module overview.

extend Parser:
    private:
        # ============================================================
        # Statement parsing
        # ============================================================

        # The `EXPR as T` value cast was removed (use `expr.cast[T]` / `T(expr)` /
        # `&expr`). By the time a completed statement value expression is followed
        # by `as`, every legitimate `as` (is/catch aliases, expect/lock/using) has
        # been consumed by its own parser — so a trailing `as` here is the removed
        # cast. Emit ONE directed error at the `as` and consume `as TYPE` so the
        # rest of the line does not cascade (matches stage0's recover-as-canonical).
        def consume_removed_as_cast(parser: mutable Parser&, value: Ast::Expr) -> Ast::Expr:
            if parser.peek() == TokenKind.As:
                as_tok: Token = parser.advance()          # `as`
                _ = parser.unary_expr()                   # parse + discard the cast target type
                parser.error_at(Ast::ParseErrorKind.UnexpectedToken, as_tok)
            return value


        # Depth-guarded entry: every statement — including a nested block body
        # (`if:`/`while:`/`for:`/`match` arm), which re-enters via parse_block ->
        # stmt -> if_stmt -> parse_block — passes through here, so bounding
        # `parser.depth` bounds statement-nesting recursion the same way it bounds
        # expression recursion. Over the limit we emit one diagnostic and return
        # null; parse_block's advance-on-null recovery then guarantees progress
        # (no hang) while the stack stays bounded (no overflow).
        def stmt(parser: mutable Parser&) -> Ast::Stmt?:
            parser.depth <- parser.depth + 1
            if parser.depth > EXPR_DEPTH_LIMIT:
                parser.error_at(Ast::ParseErrorKind.UnexpectedToken, parser.cursor())
                parser.depth <- parser.depth - 1
                return null
            result: Ast::Stmt? = parser.stmt_inner()
            parser.depth <- parser.depth - 1
            return result


        def stmt_inner(parser: mutable Parser&) -> Ast::Stmt?:
            kind: TokenKind = parser.peek()
            tok: Token = parser.cursor()

            match kind:
                TokenKind.If:
                    return parser.if_stmt()

                TokenKind.While:
                    return parser.while_stmt()

                TokenKind.Return:
                    return parser.return_stmt()

                TokenKind.Match:
                    return parser.match_stmt()

                TokenKind.Break:
                    parser.advance()
                    # `break if COND` desugars to `if COND: break` (mirrors postfix
                    # `return if`). A real If node is built so the guard's references are
                    # resolved like any other condition.
                    if parser.accept(TokenKind.If):
                        cond: Ast::Expr = get parser.expr()
                        body: mutable darray[Ast::Stmt] = []
                        body.push((Ast::Stmt.Break("", tok.line)))
                        no_else: darray[Ast::Stmt] = []
                        return (Ast::Stmt.If(cond, body, no_else, tok.line))
                    return (Ast::Stmt.Break("", tok.line))

                TokenKind.Continue:
                    parser.advance()
                    # `continue if COND` desugars to `if COND: continue`.
                    if parser.accept(TokenKind.If):
                        cond: Ast::Expr = get parser.expr()
                        body: mutable darray[Ast::Stmt] = []
                        body.push((Ast::Stmt.Continue("", tok.line)))
                        no_else: darray[Ast::Stmt] = []
                        return (Ast::Stmt.If(cond, body, no_else, tok.line))
                    else:
                        return (Ast::Stmt.Continue("", tok.line))

                TokenKind.Pass:
                    parser.advance()
                    return (Ast::Stmt.Expr((Ast::Expr.Invalid), tok.line))

                TokenKind.With | TokenKind.Region | TokenKind.In | TokenKind.Error:
                    return parser.prefixed_block_stmt()

                TokenKind.Try:
                    # `try:` opens a handler block; a bare `try EXPR` statement is a
                    # fallible call — parse it as an expression statement (get_expr
                    # consumes the `try` head and any `else` recovery tail) so the
                    # call's references resolve instead of being token-skipped.
                    if parser.peek_at(1) == TokenKind.Colon:
                        return parser.prefixed_block_stmt()
                    try_value: Ast::Expr = get parser.expr()
                    return (Ast::Stmt.Expr(try_value, tok.line))

                TokenKind.Catch:
                    return parser.catch_stmt()
                _:
                    # `static if/elif/else COND:` compile-time conditional inside a body —
                    # consumed as a prefix block (the condition is skipped to the colon).
                    if kind == TokenKind.Static:
                        n1: TokenKind = parser.peek_at(1)
                        if n1 == TokenKind.If or n1 == TokenKind.Elif or n1 == TokenKind.Else:
                            return parser.prefixed_block_stmt()
                        else:    
                            # `static <directive>` (e.g. `static error("…")`): consume the
                            # `static` marker and parse the directive as a statement.
                            parser.advance()
                            return parser.stmt()

                    # Contextual-keyword statements (the lexer emits these as identifiers).
                    if kind == TokenKind.Ident:
                        head: sview = Lexer::text_or_empty(tok, parser.source)
                        # Effect/concurrency block openers (`can …:`, `nursery workers(n):`,
                        # `pool …:`, `parallel …:`) — prefix consumed to the block colon.
                        if head == "can" or head == "trusted" or head == "nursery" or head == "pool" or head == "parallel":
                            return parser.prefixed_block_stmt()
                        # `lock MUTEX:` / `lock MUTEX as GUARD:` synchronized block. `lock`
                        # is also a legal identifier, so only when a mutex name follows
                        # (`lock = …` / `lock(…)` stay ordinary identifier uses).
                        if head == "lock" and parser.peek_at(1) == TokenKind.Ident:
                            return parser.prefixed_block_stmt()
                        # `expect EXPR as PATTERN[:block]` / `expect let PATTERN = EXPR` —
                        # pattern assertion; desugars to a one-arm Match (stage0's own
                        # lowering) so the pattern's bindings resolve inside the block.
                        if head == "expect" and tokenStartsValue(parser.peek_at(1)):
                            return parser.expect_stmt()
                        if head == "for":
                            return parser.for_stmt()
                        # `region NAME(size):` / `region NAME:` scratch-region block.
                        # `region` is also a legal identifier (a struct field / local named
                        # `region`), so treat it as the block keyword only when a region
                        # name (an ident) immediately follows; `region:`/`region.`/`region =`
                        # stay ordinary identifier uses.
                        if head == "region" and parser.peek_at(1) == TokenKind.Ident:
                            return parser.prefixed_block_stmt()
                        # `guard` is a contextual keyword AND a legal identifier (e.g. a
                        # local `guard: MutexGuard = …`). Only treat it as a guard
                        # statement when a top-level `else` follows on the same line.
                        if head == "guard" and parser.looks_like_guard_stmt():
                            return parser.guard_stmt()
                        # Design-by-contract statements (`requires E` / `ensure E` /
                        # `decreases E` / `invariant E` / `changes PATH`) — contextual
                        # keywords, also legal identifiers, so only when the next token
                        # starts an operand on the same line (Ident or a literal; an
                        # assignment/colon after the name is an ordinary local use).
                        if head == "requires" or head == "ensure" or head == "ensures" or head == "decreases" or head == "invariant" or head == "changes":
                            n1: TokenKind = parser.peek_at(1)
                            if n1 in {TokenKind.Ident, TokenKind.IntLit, TokenKind.FloatLit, TokenKind.StringLit, TokenKind.CharLit, TokenKind.True, TokenKind.False, TokenKind.Not}:
                                return parser.contract_stmt()

                    # `IDENT:` immediately followed by a newline is a labeled/arm block
                    # (e.g. a `catch …:` block's `ok:` success arm), not a binding.
                    if kind == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon and parser.peek_at(2) == TokenKind.Newline:
                        return parser.prefixed_block_stmt()

                    # `IDENT :` introduces a local binding (`x: T` / `x: T = v`).
                    if kind == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon:
                        return parser.var_decl_stmt()

                    # Otherwise an expression statement, an assignment/binding
                    # (`target <- value` / `target = value`), or a guarded return.
                    target: Ast::Expr = parser.consume_removed_as_cast(get parser.expr())
                    # Multi-target (tuple-unpack) assignment `a, b = expr` / `a, b <- expr`:
                    # collect the comma-separated targets into an Array target. Bare-ident
                    # targets bind as new locals (see gather_locals).
                    if parser.peek() == TokenKind.Comma:
                        targets: mutable darray[Ast::Expr] = [target]
                        while parser.accept(TokenKind.Comma):
                            if parser.expr() is more_target:
                                targets.push(more_target)
                        if parser.peek() == TokenKind.LArrow or parser.peek() == TokenKind.Assign or isCompoundAssign(parser.peek()):
                            multi_op: TokenKind = parser.advance().kind
                            first_value: Ast::Expr = get parser.expr()
                            # The RHS may itself be a comma-separated tuple (`a, b <- b, a`),
                            # not just a single multi-valued call/expr — collect it the same
                            # way the LHS targets were collected above.
                            if parser.peek() == TokenKind.Comma:
                                values: mutable darray[Ast::Expr] = [first_value]
                                while parser.accept(TokenKind.Comma):
                                    if parser.expr() is more_value:
                                        values.push(more_value)
                                return (Ast::Stmt.Assign((Ast::Expr.Array(targets, tok.line)), multi_op, (Ast::Expr.Array(values, tok.line)), tok.line))
                            return (Ast::Stmt.Assign((Ast::Expr.Array(targets, tok.line)), multi_op, first_value, tok.line))
                        return (Ast::Stmt.Expr(target, tok.line))
                    if parser.peek() == TokenKind.LArrow or parser.peek() == TokenKind.Assign or isCompoundAssign(parser.peek()):
                        assign_op: TokenKind = parser.advance().kind
                        value: Ast::Expr = parser.consume_removed_as_cast(get parser.expr())
                        return (Ast::Stmt.Assign(target, assign_op, value, tok.line))
                    else:
                        # Postfix guarded return `VALUE return if COND` (== `if COND:
                        # return VALUE`). Desugared into a real If node so the guard's
                        # references resolve (and count as uses) like any condition.
                        if parser.peek() == TokenKind.Return:
                            parser.advance()
                            if parser.accept(TokenKind.If):
                                guard_cond: Ast::Expr = get parser.expr()
                                guard_body: mutable darray[Ast::Stmt] = []
                                guard_body.push((Ast::Stmt.Return(target, tok.line)))
                                guard_no_else: darray[Ast::Stmt] = []
                                return (Ast::Stmt.If(guard_cond, guard_body, guard_no_else, tok.line))
                            return (Ast::Stmt.Return(target, tok.line))
                        else:
                            return (Ast::Stmt.Expr(target, tok.line))


        # `for VAR [, VAR]* in ITER: <block>` (contextual `for`; the lexer emits it as an
        # identifier). Every loop variable is recorded so destructuring loops bind them all.
        def for_stmt(parser: mutable Parser&) -> Ast::Stmt?:
            tok: Token = parser.advance()              # consume the `for` identifier

            # Iteration binding intent, before the first variable (mirrors stage0
            # parseIterBindMode): `mutable` = mutate elements in place, nothing = read
            # (the compiler binds by reference under the hood when beneficial or
            # required — affine elements auto-borrow). The mechanism spellings
            # `ref` / `mutable ref` were removed; stage0 rejects them with a directed
            # error, so here a stray `ref` simply fails the variable-name expect.
            bind: mutable sview = ""
            if parser.accept(TokenKind.Mutable):
                bind <- "mutable"

            vars_buf: mutable darray[sview] = []
            var_tok: Token = parser.expect(TokenKind.Ident)
            vars_buf.push(Lexer::text_or_empty(var_tok, parser.source))

            while parser.accept(TokenKind.Comma):
                next_tok: Token = parser.expect(TokenKind.Ident)
                vars_buf.push(Lexer::text_or_empty(next_tok, parser.source))

            parser.expect(TokenKind.In)
            iter_expr: Ast::Expr = get parser.expr()
            # Optional `where COND` filter (contextual keyword): `for x in xs where P:`.
            # Consumed so the loop header parses; the condition is parsed (not stored on
            # the For node, which has no filter slot).
            where_tok: Token = parser.cursor()
            if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(where_tok, parser.source) == "where":
                parser.advance()                       # `where`
                parser.expr()                          # filter condition (consumed)
            # Chained `for a in A for b in B: body` == nested loops: the inner `for`
            # becomes the single body statement of the outer loop.
            chain_tok: Token = parser.cursor()
            if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(chain_tok, parser.source) == "for":
                nested: mutable darray[Ast::Stmt] = []
                if parser.for_stmt() is inner_for:
                    nested.push(inner_for)
                return (Ast::Stmt.For(bind, vars_buf, iter_expr, nested, tok.line))
            body: darray[Ast::Stmt] = parser.parse_block()
            return (Ast::Stmt.For(bind, vars_buf, iter_expr, body, tok.line))


