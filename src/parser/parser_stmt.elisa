                            return __ret_125
                        # `lock MUTEX:` / `lock MUTEX as GUARD:` synchronized block. `lock`
                        # is also a legal identifier, so only when a mutex name follows
                        # (`lock = …` / `lock(…)` stay ordinary identifier uses).
                        if head == "lock" and parser.peek_at(1) == TokenKind.Ident:
                            rebind __ret_130: Ast::Stmt?, parser = parser.prefixed_block_statement()
                            return __ret_130
                        # `proof COND:` — a proof-tactic block (docs/90). The claimed goal is
                        # skipped to the block colon; the indented body (asserts, lemma calls)
                        # resolves as ordinary statements so its references bind.
                        if head == "proof" and tokenStartsValue(parser.peek_at(1)):
                            rebind __ret_proof: Ast::Stmt?, parser = parser.prefixed_block_statement()
                            return __ret_proof
                        # `expect EXPR as PATTERN[:block]` / `expect let PATTERN = EXPR` —
                        # pattern assertion; desugars to a one-arm Match (stage0's own
                        # lowering) so the pattern's bindings resolve inside the block.
                        if head == "expect" and parser.peek_at(1) != TokenKind.LParen and tokenStartsValue(parser.peek_at(1)):
                            rebind __ret_135: Ast::Stmt?, parser = parser.expect_statement()
                            return __ret_135
                        # Statement-level consuming destructure:
                        # `move PLACE [in STORE] as PATTERN`. Parse PLACE/STORE as unary
