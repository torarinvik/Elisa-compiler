                        # docs/119 §2: `target <- ` / `target = ` NEWLINE INDENT … is a bare block.
                        if parser.block_value_rhs_ahead():
                            rebind __v_233: Ast::Expr, parser = parser.parse_block_value_rhs()
                            return (Ast::Stmt.Assign(target, assign_operator, __v_233, token.line))
