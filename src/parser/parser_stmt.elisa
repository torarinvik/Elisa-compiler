                        if head == "move" and tokenStartsValue(parser.peek_at(1)):
                            parser, _ <- parser.advance()
                            rebind moved_value_opt: Ast::Expr?, parser = parser.unary_expression()
                            moved_value: Ast::Expr = get moved_value_opt else return (Ast::Stmt.Invalid)
                            moved_scrutinee: mutable Ast::Expr = moved_value
                            moved_store_name: mutable sview = ""
                            rebind accepted_store: bool, parser = parser.accept(TokenKind.In)
                            if accepted_store:
