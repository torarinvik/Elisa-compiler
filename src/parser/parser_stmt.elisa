# Stage1 parser — statement parsing (`extend Parser: private:`). Covers `statement` dispatch,
# `for`/`if`/`while`/`return`, match statements and patterns. Split out of parser.elisa to
# keep each part file under 600 lines; see parser.elisa for the module overview.

extend Parser:
    private:
        # ============================================================
        # Statement parsing
        # ============================================================

        # The `EXPR as T` value cast was removed (use `expression.cast[T]` / `T(expression)` /
        # `&expression`). By the time a completed statement value expression is followed
        # by `as`, every legitimate `as` (is/catch aliases, expect/lock/using) has
        # been consumed by its own parser — so a trailing `as` here is the removed
        # cast. Emit ONE directed error at the `as` and consume `as TYPE` so the
        # rest of the line does not cascade (matches stage0's recover-as-canonical).
        def consume_removed_as_cast(parser: lmut Parser, value: Ast::Expr) -> Ast::Expr:
            if parser.peek() == TokenKind.As:
                rebind as_token: Token, parser = parser.advance()          # `as`
                parser, _ <- parser.unary_expression()                   # parse + discard the cast target type
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, as_token)
            return value


        # Depth-guarded entry: every statement — including a nested block body
        # (`if:`/`while:`/`for:`/`match` arm), which re-enters via parse_block ->
        # statement -> if_statement -> parse_block — passes through here, so bounding
        # `parser.depth` bounds statement-nesting recursion the same way it bounds
        # expression recursion. Over the limit we emit one diagnostic and return
        # null; parse_block's advance-on-null recovery then guarantees progress
        # (no hang) while the stack stays bounded (no overflow).
        def statement(parser: lmut Parser) -> Ast::Stmt?:
            parser.depth <- parser.depth + 1
            if parser.depth > EXPR_DEPTH_LIMIT:
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, parser.cursor())
                parser.depth <- parser.depth - 1
                return null
            rebind result: Ast::Stmt?, parser = parser.statement_inner()
            parser.depth <- parser.depth - 1
            return result


        # Parse contextual statement heads. These words remain identifiers in the lexer, so
        # this dispatch is deliberately separate from the token-kind statement dispatcher.
        # Absent means that the identifier belongs to the ordinary declaration/expression path.
        def contextual_statement(parser: lmut Parser, token: Token, head: sview) -> Ast::Stmt?:
            if head == "cascade" and parser.peek_at(1) == TokenKind.Ident:
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token)
                rebind removed_cascade: Ast::Stmt?, parser = parser.prefixed_block_statement()
                return removed_cascade
            if head == "notify" and parser.peek_at(1) == TokenKind.Ident:
                next_text: sview = Lexer::text_or_empty(parser.tokens[parser.position + 1], parser.source)
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if next_text == "one" or next_text == "all"
            if head == "signal" and parser.peek_at(1) == TokenKind.Ident:
                parser, _ <- parser.advance()
                rebind signal_ref: sview, parser = parser.parse_dotted_name()
                return (Ast::Stmt.Block("signal", [signal_ref], sview("", 0, 0), [], Ast::pos_of_token(token)))
            if head == "parallel" and parser.peek_at(1) == TokenKind.Ident and Lexer::text_or_empty(parser.tokens[parser.position + 1], parser.source) == "for":
                parser, _ <- parser.advance()
                rebind parallel_for: Ast::Stmt?, parser = parser.for_statement(true)
                return parallel_for
            # These block prefixes are CONTEXTUAL keywords — ordinary identifiers everywhere
            # else — so a bare name match is not enough to claim the statement.
            #
            # `scope` in particular is a common variable name (`scope.push(x)`,
            # `scope <- other`), and claiming it unconditionally swallowed the receiver: the
            # statement was parsed as a `scope` BLOCK, and Semantic.mark_mutable_locals — whose
            # parameter is named `scope` — silently marked nothing. That surfaced as 319 E10
            # false positives from the stage1-built analyzer, and renaming the parameter made
            # them vanish. `pool` was already guarded this way; `scope` was not.
            #
            # A DOT or an assignment arrow after the name is a use of the value, never a block.
            #
            # The test applies to EVERY name in the list, not just `scope`. Guarding one name
            # left the other four rejecting valid programs outright: with `NAME` declared,
            # rebound, passed to a call and returned, stage0 accepts and stage1 exited 1 for
            # `can`, `trusted`, `defer` and `parallel` (`lock`, `pool`, `signal`, `region`,
            # `machine` and `when` were already fine). `trusted`/`defer`/`parallel` were the
            # worse half — the parse "succeeded" with the declaration silently eaten, which is
            # the same failure mode as the 319 E10 false positives that put the guard here.
            #
            # Colon is deliberately NOT in the test: `defer:` and `trusted:` are real bare
            # block forms. Nothing in src/, elisacore_std/, test/ or stage0's runtime spells a
            # block `name.` / `name(` / `name[` / `name <-`; the only corpus hit is
            # `scope.push(name)`, which is exactly the case this guard was written for.
            # A BRACKET means "use" for `scope` only. `trusted [Unsafe.PointerCast,
            # Unsafe.RawExtern]:` is a real block form — its grant list is bracketed — and
            # treating a bracket as a use across the board turned every one of them into a
            # parse error: 12 of the 574 stage0 semantic-acceptance cases went red, all of
            # them std runtime files (arena, collections, stores, prelude).
            contextual_name_is_use: bool = parser.peek_at(1) == TokenKind.Dot or parser.peek_at(1) == TokenKind.LArrow or parser.peek_at(1) == TokenKind.LParen or (parser.peek_at(1) == TokenKind.LBracket and head == "scope")
            # `NAME: T = v` is a DECLARATION of that name; a block header's colon ENDS the
            # line, so the token after it separates the two with no lookahead beyond 2.
            # `scope` and `nursery` are excluded because stage0 reserves them in statement
            # position — it rejects `scope: mutable i64 = 1` outright, and stage1 must keep
            # rejecting it too. The other four stage0 accepts as ordinary identifiers.
            contextual_declares_local: bool = parser.peek_at(1) == TokenKind.Colon and parser.peek_at(2) != TokenKind.Newline and head != "scope" and head != "nursery"
            if not contextual_name_is_use and not contextual_declares_local and (head == "can" or head == "trusted" or head == "nursery" or head == "scope" or head == "defer" or (head == "pool" and parser.peek_at(1) == TokenKind.Ident) or head == "parallel"):
                rebind prefixed: Ast::Stmt?, parser = parser.prefixed_block_statement()
                return prefixed
            if head == "lock" and parser.peek_at(1) == TokenKind.Ident:
                rebind locked: Ast::Stmt?, parser = parser.prefixed_block_statement()
                return locked
            if head == "proof" and tokenStartsValue(parser.peek_at(1)):
                rebind proof: Ast::Stmt?, parser = parser.proof_block_statement()
                return proof
            if head == "expect" and parser.peek_at(1) != TokenKind.LParen and tokenStartsValue(parser.peek_at(1)):
                rebind expected: Ast::Stmt?, parser = parser.expect_statement()
                return expected
            if head == "move" and tokenStartsValue(parser.peek_at(1)):
                parser, _ <- parser.advance()
                rebind moved_value_opt: Ast::Expr?, parser = parser.unary_expression()
                moved_value: Ast::Expr = get moved_value_opt else return (Ast::Stmt.Invalid)
                moved_scrutinee: mutable Ast::Expr = moved_value
                moved_store_name: mutable sview = ""
                rebind accepted_store: bool, parser = parser.accept(TokenKind.In)
                if accepted_store:
                    rebind moved_store_opt: Ast::Expr?, parser = parser.unary_expression()
                    moved_store: Ast::Expr = get moved_store_opt else return (Ast::Stmt.Invalid)
                    if moved_store is Expr.Ident(store_name, store_line):
                        moved_store_name <- store_name
                    moved_scrutinee <- (Ast::Expr.Refinement(moved_value, moved_store, Ast::pos_of_token(token)))
                parser, _ <- parser.expect(TokenKind.As)
                rebind moved_pattern: Ast::Pattern, parser = parser.parse_pattern()
                moved_bindings: mutable darray[sview] = []
                pattern_binding_names(moved_pattern, moved_bindings)
                moved_body: darray[Ast::Stmt] = []
                moved_arms: darray[Ast::MatchArm] = [Ast::MatchArm{pattern: moved_pattern, body: moved_body, guard: (Ast::Expr.Absent)}, Ast::MatchArm{pattern: (Ast::Pattern.Wildcard), body: moved_body, guard: (Ast::Expr.Absent)}]
                lowered_move: mutable darray[Ast::Stmt] = [(Ast::Stmt.Match(moved_scrutinee, moved_arms, Ast::pos_of_token(token)))]
                lowered_move.extend([(Ast::Stmt.VarDecl(moved_binding, (Ast::Expr.Invalid), (Ast::Expr.Absent), Ast::pos_of_token(token))) for moved_binding in moved_bindings])
                return (Ast::Stmt.Block("move", [move_pattern_head_path(moved_pattern), moved_store_name], "", lowered_move, Ast::pos_of_token(token)))
            if head == "let" and (parser.peek_at(1) == TokenKind.Ident or parser.peek_at(1) == TokenKind.LBrace or parser.peek_at(1) == TokenKind.LParen):
                parser, _ <- parser.advance()
                rebind let_pattern: Ast::Pattern, parser = parser.parse_pattern()
                parser, _ <- parser.expect(TokenKind.Assign)
                rebind let_value: Ast::Expr, parser = get parser.expression()
                let_body: darray[Ast::Stmt] = []
                let_arms: darray[Ast::MatchArm] = [Ast::MatchArm{pattern: let_pattern, body: let_body, guard: (Ast::Expr.Absent)}]
                let_lowered: mutable darray[Ast::Stmt] = [(Ast::Stmt.Match(let_value, let_arms, Ast::pos_of_token(token)))]
                let_bindings: mutable darray[sview] = []
                pattern_binding_names(let_pattern, let_bindings)
                let_lowered.extend([(Ast::Stmt.VarDecl(let_binding, (Ast::Expr.Invalid), (Ast::Expr.Absent), Ast::pos_of_token(token))) for let_binding in let_bindings])
                return (Ast::Stmt.Block("let", [], "", let_lowered, Ast::pos_of_token(token)))
            if head == "for" and parser.peek_at(1) != TokenKind.LParen:
                rebind for_stmt: Ast::Stmt?, parser = parser.for_statement(false)
                return for_stmt
            if head == "machine" and parser.machine_over_ahead():
                rebind machine: Ast::Stmt?, parser = parser.machine_statement()
                return machine
            if head == "when" and parser.when_construct_ahead():
                rebind when_stmt: Ast::Stmt?, parser = parser.when_statement()
                return when_stmt
            if head == "rebind" and parser.peek_at(1) == TokenKind.Ident:
                rebind rebound: Ast::Stmt?, parser = parser.rebind_statement()
                return rebound
            if head == "region" and parser.peek_at(1) == TokenKind.Ident and not parser.region_header_has_block_colon():
                parser, _ <- parser.advance()
                rebind region_name_token: Token, parser = parser.advance()
                # The capacity is captured as a span of the SOURCE text, exactly as the
                # region/with BLOCK form does it (parser_stmt_control_blocks). Without this
                # the statement form dropped its capacity outright and the backend had no
                # size to open the arena with, so `region r(1024)` produced an arena with
                # no backing store where stage0 emits `new_region_backend(1024, 0)`.
                region_capacity_start: usize = parser.cursor().start.usize() + 1
                rebind has_region_capacity: bool, parser = parser.accept(TokenKind.LParen)
                parser <- parser.expression_when(has_region_capacity)
                region_capacity_end: usize = parser.cursor().start.usize()
                parser <- parser.accept_when(TokenKind.RParen, has_region_capacity)
                using_token: Token = parser.cursor()
                has_region_strategy: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(using_token, parser.source) == "using"
                parser <- parser.advance_when(has_region_strategy)
                strategy_token: Token = parser.cursor()
                has_strategy_name: bool = has_region_strategy and parser.peek() == TokenKind.Ident
                parser <- parser.advance_when(has_strategy_name)
                region_clause: mutable darray[sview] = []
                region_clause.push(Lexer::text_or_empty(strategy_token, parser.source)) if has_strategy_name
                region_clause.push(parser.span_view(region_capacity_start, region_capacity_end)) if has_region_capacity
                # Record the `using STRATEGY` name SEPARATELY so the backing check does not
                # have to guess which clause entry is the strategy. It used to decide
                # lexically — "all digits means capacity" — which rejected every non-literal
                # size: `region r(n)` for a `usize` parameter reported
                # `unknown region backing "n"` where stage0 compiles it.
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: Lexer::text_or_empty(strategy_token, parser.source), name: "__region_strategy", line: token.line}) if has_strategy_name
                parser.local_region_annotations <- parser.local_region_annotations.push(Ast::LocalRegionAnnotation{name: "__region_local", type_expression: (Ast::Expr.Invalid), region: Lexer::text_or_empty(region_name_token, parser.source), line: token.line})
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: Lexer::text_or_empty(region_name_token, parser.source), name: "__region_name", line: token.line})
                return (Ast::Stmt.Block("region", region_clause, Lexer::text_or_empty(region_name_token, parser.source), [], Ast::pos_of_token(token)))
            if head == "destroy" and parser.peek_at(1) == TokenKind.Ident:
                parser, _ <- parser.advance()
                rebind destroyed_region_token: Token, parser = parser.advance()
                return (Ast::Stmt.Block("destroy", [Lexer::text_or_empty(destroyed_region_token, parser.source)], "", [], Ast::pos_of_token(token)))
            next_word: sview = Lexer::text_or_empty(parser.tokens[parser.position + 1], parser.source) if parser.peek_at(1) == TokenKind.Ident else ""
            if head == "wait" and next_word == "all" and tokenStartsValue(parser.peek_at(2)):
                parser, _ <- parser.advance()
                parser, _ <- parser.advance()
                rebind waited_group: Ast::Expr, parser = get parser.expression()
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__wait_all", name: "__wait_all", line: token.line})
                return (Ast::Stmt.Expr((Ast::Expr.Block([], waited_group, [], Ast::pos_of_token(token))), Ast::pos_of_token(token)))
            if head == "region" and parser.peek_at(1) == TokenKind.Ident:
                rebind region_block: Ast::Stmt?, parser = parser.prefixed_block_statement()
                return region_block
            if head == "guard" and parser.looks_like_guard_statement():
                rebind guard: Ast::Stmt?, parser = parser.guard_statement()
                return guard
            if head == "ghost" and parser.peek_at(1) == TokenKind.Ident and parser.peek_at(2) == TokenKind.Colon:
                ghost_decl_line: u32 = parser.tokens[parser.position + 1].line
                parser.ghost_local_lines <- parser.ghost_local_lines.push(ghost_decl_line)
                parser, _ <- parser.advance()
                rebind ghost: Ast::Stmt?, parser = parser.variable_declaration_statement()
                return ghost
            if head == "requires" or head == "ensure" or head == "ensures" or head == "uses" or head == "decreases" or head == "invariant" or head == "changes" or head == "preserves" or head == "assert":
                if (parser.peek_at(1) == TokenKind.Ident or parser.peek_at(1) == TokenKind.IntLit or parser.peek_at(1) == TokenKind.FloatLit or parser.peek_at(1) == TokenKind.StringLit or parser.peek_at(1) == TokenKind.CharLit or parser.peek_at(1) == TokenKind.True or parser.peek_at(1) == TokenKind.False or parser.peek_at(1) == TokenKind.Not or parser.peek_at(1) == TokenKind.LParen) or (head == "decreases" and parser.peek_at(1) == TokenKind.Star):
                    rebind contract: Ast::Stmt?, parser = parser.contract_statement()
                    return contract
            return null


        def statement_direct_keyword(parser: lmut Parser, kind: TokenKind, token: Token) -> Ast::Stmt?:
            if kind == TokenKind.If:
                rebind if_stmt: Ast::Stmt?, parser = parser.if_statement()
                return if_stmt
            if kind == TokenKind.While:
                rebind while_stmt: Ast::Stmt?, parser = parser.while_statement()
                return while_stmt
            if kind == TokenKind.Return:
                rebind return_stmt: Ast::Stmt?, parser = parser.return_statement()
                return return_stmt
            if kind == TokenKind.Match:
                rebind match_stmt: Ast::Stmt?, parser = parser.match_statement()
                return match_stmt
            if kind == TokenKind.Break:
                parser, _ <- parser.advance()
                rebind accepted_if: bool, parser = parser.accept(TokenKind.If)
                if accepted_if:
                    rebind condition: Ast::Expr, parser = get parser.expression()
                    return (Ast::Stmt.If(condition, [(Ast::Stmt.Break("", Ast::pos_of_token(token)))], [], Ast::pos_of_token(token)))
                return (Ast::Stmt.Break("", Ast::pos_of_token(token)))
            if kind == TokenKind.Continue:
                parser, _ <- parser.advance()
                rebind accepted_if: bool, parser = parser.accept(TokenKind.If)
                if accepted_if:
                    rebind condition: Ast::Expr, parser = get parser.expression()
                    return (Ast::Stmt.If(condition, [(Ast::Stmt.Continue("", Ast::pos_of_token(token)))], [], Ast::pos_of_token(token)))
                return (Ast::Stmt.Continue("", Ast::pos_of_token(token)))
            if kind == TokenKind.Pass:
                parser, _ <- parser.advance()
                return (Ast::Stmt.Expr((Ast::Expr.Invalid), Ast::pos_of_token(token)))
            if kind == TokenKind.Error and parser.peek_at(1) == TokenKind.LParen:
                rebind error_call: Ast::Expr, parser = get parser.expression()
                return (Ast::Stmt.Expr(error_call, Ast::pos_of_token(token)))
            return null

        # Is `value` the docs/120 §6 manifest shape — a bare block whose whole value is an
        # `if` yielding one tuple per branch, each with exactly one element per place?
        def manifest_desugar_applies(value: Ast::Expr, targets: darray[Ast::Expr]) -> bool:
            false return if targets.count < 2
            if value is Expr.Block(block_statements, block_value, block_captures, block_line):
                false return if block_statements.count > 0
                if block_value is Expr.If(condition, then_value, else_value, if_line):
                    if then_value is Expr.Tuple(then_elements, then_line):
                        if else_value is Expr.Tuple(else_elements, else_line):
                            return then_elements.count == targets.count and else_elements.count == targets.count
            return false

        # One branch of the desugared manifest: `place <- element` per position, skipping a place
        # assigned its own name (`parser, out.push(d)` re-states `parser` only to keep the tuple
        # positional — assigning it to itself would be a redundant self-store).
        def manifest_branch_body(targets: darray[Ast::Expr], elements: darray[Ast::Expr], assign_op: TokenKind, at_line: u32) -> darray[Ast::Stmt]:
            body: mutable darray[Ast::Stmt] = []
            for index in 0..<targets.count |body, targets, elements, assign_op, at_line|:
                is_self_assignment: mutable bool = false
                if targets[index] is Expr.Ident(target_name, target_line):
                    if elements[index] is Expr.Ident(element_name, element_line):
                        is_self_assignment <- element_name == target_name
                continue if is_self_assignment
                body.push((Ast::Stmt.Assign(targets[index], assign_op, elements[index], Ast::pos_at_line(at_line))))
            return body

        def manifest_to_if_statement(parser: lmut Parser, value: Ast::Expr, targets: darray[Ast::Expr], assign_op: TokenKind, at_line: u32) -> Ast::Stmt:
            if value is Expr.Block(block_statements, block_value, block_captures, block_line):
                if block_value is Expr.If(condition, then_value, else_value, if_line):
                    if then_value is Expr.Tuple(then_elements, then_line):
                        if else_value is Expr.Tuple(else_elements, else_line):
                            return (Ast::Stmt.If(condition, manifest_branch_body(targets, then_elements, assign_op, at_line), manifest_branch_body(targets, else_elements, assign_op, at_line), Ast::pos_at_line(at_line)))
            return (Ast::Stmt.Invalid)

        def statement_expression_tail(parser: lmut Parser, token: Token) -> Ast::Stmt?:
            # Otherwise an expression statement, an assignment/binding
            # (`target <- value` / `target = value`), or a guarded return.
            rebind target_raw: Ast::Expr, parser = get parser.expression()
            rebind target: Ast::Expr, parser = parser.consume_removed_as_cast(target_raw)
            # Multi-target (tuple-unpack) assignment `a, b = expression` / `a, b <- expression`:
            # collect the comma-separated targets into an Array target. Bare-ident
            # targets bind as new locals (see gather_locals).
            if parser.peek() == TokenKind.Comma:
                targets: mutable darray[Ast::Expr] = [target]
                while parser.accept(TokenKind.Comma) |parser|:
                    rebind more_target_option: Ast::Expr?, parser = parser.expression()
                    if more_target_option is more_target:
                        targets.push(more_target)
                if parser.peek() == TokenKind.LArrow or parser.peek() == TokenKind.Assign or isCompoundAssign(parser.peek()):
                    rebind multi_operator_token: Token, parser = parser.advance()

                    multi_operator: TokenKind = multi_operator_token.kind
                    # docs/119 §2: `a, b =` NEWLINE INDENT … — bare block whose tail
                    # tuple binds the targets.
                    if parser.block_value_rhs_ahead():
                        rebind __v_213: Ast::Expr, parser = parser.parse_block_value_rhs()
                        # docs/120 §6 dataflow MANIFEST — `A, B <-` NEWLINE `if C: (a, b) else:
                        # (c, d)`: branch mutations are lifted into the place list. DESUGAR it here
                        # into the plain statement `if C: A <- a; B <- b else: A <- c; B <- d`,
                        # which is exactly what it means and which needs no separate multi-place
                        # lowering downstream. A place assigned its own name (`parser` in the arm
                        # that does not advance) is a no-op and is skipped rather than emitted as a
                        # self-assignment.
                        if manifest_desugar_applies(__v_213, targets):
                            rebind manifest_stmt: Ast::Stmt, parser = parser.manifest_to_if_statement(__v_213, targets, multi_operator, token.line)
                            return manifest_stmt
                        return (Ast::Stmt.Assign((Ast::Expr.Array(targets, Ast::pos_of_token(token))), multi_operator, __v_213, Ast::pos_of_token(token)))
                    rebind first_value: Ast::Expr, parser = get parser.expression()
                    # The RHS may itself be a comma-separated tuple (`a, b <- b, a`),
                    # not just a single multi-valued call/expression — collect it the same
                    # way the LHS targets were collected above.
                    if parser.peek() == TokenKind.Comma:
                        values: mutable darray[Ast::Expr] = [first_value]
                        while parser.accept(TokenKind.Comma) |parser|:
                            rebind more_value_option: Ast::Expr?, parser = parser.expression()
                            if more_value_option is more_value:
                                values.push(more_value)
                        # docs/125 §6b again: a trailing `if COND` with NO `else` guards the
                        # whole STATEMENT, but it parses as part of the LAST element, so
                        # `first, second <- second, first if swap` arrives as
                        # `[second, If(swap, first, Absent)]`. Lift it back out: strip the
                        # conditional off the final value and wrap the assignment in `if COND:`.
                        # Without this the last element is an else-less conditional VALUE, which
                        # has no lowering — stage0 accepts the statement, so leaving it would be
                        # a parse divergence, not just a missing feature.
                        if values.count > 0:
                            if values[values.count - 1] is Expr.If(tuple_guard_condition, tuple_guarded_value, Expr.Absent, tuple_guard_line):
                                if multi_operator != TokenKind.Assign:
                                    values[values.count - 1] <- tuple_guarded_value
                                    tuple_guard_body: mutable darray[Ast::Stmt] = []
                                    tuple_guard_body.push((Ast::Stmt.Assign((Ast::Expr.Array(targets, Ast::pos_of_token(token))), multi_operator, (Ast::Expr.Array(values, Ast::pos_of_token(token))), Ast::pos_of_token(token))))
                                    tuple_guard_no_else: darray[Ast::Stmt] = []
                                    return (Ast::Stmt.If(tuple_guard_condition, tuple_guard_body, tuple_guard_no_else, Ast::pos_of_token(token)))
                        return (Ast::Stmt.Assign((Ast::Expr.Array(targets, Ast::pos_of_token(token))), multi_operator, (Ast::Expr.Array(values, Ast::pos_of_token(token))), Ast::pos_of_token(token)))
                    # docs/125 §6b: like the single-place form below, a multi-place
                    # `<-` RHS `call() if COND` with NO `else` is a do-or-skip guard
                    # — desugar to `if COND: a, b <- call()`, mirroring stage0's
                    # tryParseTupleBindStmt guard. `=` bindings stay unconditional.
                    if multi_operator != TokenKind.Assign:
                        if first_value is Expr.If(multi_guard_condition, multi_guarded_value, Expr.Absent, multi_guard_line):
                            multi_guard_body: mutable darray[Ast::Stmt] = []
                            multi_guard_body.push((Ast::Stmt.Assign((Ast::Expr.Array(targets, Ast::pos_of_token(token))), multi_operator, multi_guarded_value, Ast::pos_of_token(token))))
                            multi_guard_no_else: darray[Ast::Stmt] = []
                            return (Ast::Stmt.If(multi_guard_condition, multi_guard_body, multi_guard_no_else, Ast::pos_of_token(token)))
                    return (Ast::Stmt.Assign((Ast::Expr.Array(targets, Ast::pos_of_token(token))), multi_operator, first_value, Ast::pos_of_token(token)))
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if not parser.in_value_block
                # A comma-list with NO assignment operator inside a VALUE BLOCK is a multi-value
