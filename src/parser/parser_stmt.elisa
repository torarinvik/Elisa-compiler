                                    guard_body: mutable darray[Ast::Stmt] = []
                                    guard_body.push((Ast::Stmt.Return(target, token.line)))
                                    guard_no_else: darray[Ast::Stmt] = []
                                    return (Ast::Stmt.If(guard_condition, guard_body, guard_no_else, token.line))
                                return (Ast::Stmt.Return(target, token.line))
                            _:
