# Stage1 parser — statement parsing (`extend Parser: private:`). Covers `statement` dispatch,
# `for`/`if`/`while`/`return`, match statements and patterns. Split out of parser.elisa to
# keep each part file under 600 lines; see parser.elisa for the module overview.

extend Parser:
    private:
        # ============================================================
        # Statement parsing
        # ============================================================

        # The `EXPR as T` value cast was removed (use `expression.cast[T]` / `T(expression)` /
        # `&expression`). By the time a completed statement value expression is followed
        # by `as`, every legitimate `as` (is/catch aliases, expect/lock/using) has
        # been consumed by its own parser — so a trailing `as` here is the removed
        # cast. Emit ONE directed error at the `as` and consume `as TYPE` so the
        # rest of the line does not cascade (matches stage0's recover-as-canonical).
        def consume_removed_as_cast(parser: lmut Parser, value: Ast::Expr) -> Ast::Expr:
            if parser.peek() == TokenKind.As:
                rebind as_token: Token, parser = parser.advance()          # `as`
                parser, _ <- parser.unary_expression() can Global{Read,Write}                   # parse + discard the cast target type
                parser <- parser.error_removed(as_token, "the `expr as T` cast has been removed; use `expr.cast[T]` (reinterpret), a constructor `T(expr)` / `expr.T()` (value conversion), or `&expr` (reference)")
            return value




        # Depth-guarded entry: every statement — including a nested block body
        # (`if:`/`while:`/`for:`/`match` arm), which re-enters via parse_block ->
        # statement -> if_statement -> parse_block — passes through here, so bounding
        # `parser.depth` bounds statement-nesting recursion the same way it bounds
        # expression recursion. Over the limit we emit one diagnostic and return
        # null; parse_block's advance-on-null recovery then guarantees progress
        # (no hang) while the stack stays bounded (no overflow).
        def statement(parser: lmut Parser) -> Ast::Stmt?:
            parser.depth <- parser.depth + 1
            if parser.depth > EXPR_DEPTH_LIMIT:
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, parser.cursor())
                parser.depth <- parser.depth - 1
                return null
            rebind result: Ast::Stmt?, parser = parser.statement_inner() can Global{Read,Write}
            parser.depth <- parser.depth - 1
            return result




        def statement_direct_keyword(parser: lmut Parser, kind: TokenKind, token: Token) -> Ast::Stmt?:
            if kind == TokenKind.If:
                rebind if_stmt: Ast::Stmt?, parser = parser.if_statement() can Global{Read,Write}
                return if_stmt
            if kind == TokenKind.While:
                rebind while_stmt: Ast::Stmt?, parser = parser.while_statement() can Global{Read,Write}
                return while_stmt
            if kind == TokenKind.Return:
                rebind return_stmt: Ast::Stmt?, parser = parser.return_statement() can Global{Read,Write}
                return return_stmt
            if kind == TokenKind.Match:
                rebind match_stmt: Ast::Stmt?, parser = parser.match_statement() can Global{Read,Write}
                return match_stmt
            if kind == TokenKind.Break:
                parser, _ <- parser.advance()
                # `break 'name` leaves the loop labelled `name` (and every loop inside it).
                break_label_token: Token = parser.cursor()
                break_label: sview = Lexer::text_or_empty(break_label_token, parser.source) if parser.peek() == TokenKind.Label else ""
                parser, _ <- parser.advance() if parser.peek() == TokenKind.Label
                if parser.peek() != TokenKind.If and parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Eof and parser.peek() != TokenKind.Dedent:
                    rebind break_value: Ast::Expr, parser = get parser.expression() can Global{Read,Write}
                    break_pos: Ast::Pos = Ast::pos_of_token(token)
                    # docs/125 §6b: `break v if cond` is `if cond: break v`. The lenient ternary
                    # parse leaves an else-less `Expr.If`, as for a guarded `<-` right-hand side.
                    # It is the only spelling of a conditional value-break that survives
                    # -Wflow-strict's block-`if` ban. The guard wraps the WHOLE desugared break,
                    # the error recovery included, as stage0's takeStmtGuard does.
                    break_guard: mutable Ast::Expr = Ast::Expr.Absent
                    guarded_break_value: mutable Ast::Expr = break_value
                    match break_value:
                        Expr.If(break_guard_condition, break_guarded_value, Expr.Absent, break_guard_line):
                            break_guard <- break_guard_condition
                            guarded_break_value <- break_guarded_value
                        _:
                            pass
                    break_statement: mutable Ast::Stmt = (Ast::Stmt.Break(break_label, break_pos))
                    target_name: sview = parser.labelled_break_target(break_label)
                    if target_name == "" and break_label != "":
                        no_target_sentence_pieces: darray[sview] = ["`break '", break_label, " value` needs the loop labelled '", break_label, " to be a loop expression with a simple `-> accumulator` yield (`'", break_label, ": for x in xs |acc: T = init| -> acc:`)"]
                        no_target_sentence: sview = parser.removed_sentence(no_target_sentence_pieces)
                        parser <- parser.error_removed(break_label_token, no_target_sentence)
                    elif target_name == "":
                        parser <- parser.error_removed(token, "`break value` needs a loop with a simple `-> accumulator` yield")
                    else:
                        update: Ast::Stmt = (Ast::Stmt.Assign((Ast::Expr.Ident(target_name, break_pos)), TokenKind.LArrow, guarded_break_value, break_pos))
                        break_statement <- (Ast::Stmt.If((Ast::Expr.BoolLit(true, break_pos)), [update, (Ast::Stmt.Break(break_label, break_pos))], [], break_pos))
                    return break_statement if break_guard is Ast::Expr.Absent
                    return (Ast::Stmt.If(break_guard, [break_statement], [], break_pos))
                rebind accepted_if: bool, parser = parser.accept(TokenKind.If)
                if accepted_if:
                    rebind condition: Ast::Expr, parser = get parser.expression() can Global{Read,Write}
                    return (Ast::Stmt.If(condition, [(Ast::Stmt.Break(break_label, Ast::pos_of_token(token)))], [], Ast::pos_of_token(token)))
                return (Ast::Stmt.Break(break_label, Ast::pos_of_token(token)))
            if kind == TokenKind.Continue:
                parser, _ <- parser.advance()
                continue_label_token: Token = parser.cursor()
                continue_label: sview = Lexer::text_or_empty(continue_label_token, parser.source) if parser.peek() == TokenKind.Label else ""
                parser, _ <- parser.advance() if parser.peek() == TokenKind.Label
                rebind accepted_if: bool, parser = parser.accept(TokenKind.If)
                if accepted_if:
                    rebind condition: Ast::Expr, parser = get parser.expression() can Global{Read,Write}
                    return (Ast::Stmt.If(condition, [(Ast::Stmt.Continue(continue_label, Ast::pos_of_token(token)))], [], Ast::pos_of_token(token)))
                return (Ast::Stmt.Continue(continue_label, Ast::pos_of_token(token)))
            # `'name: for ...` / `'name: while ...` — a loop label. The loop statement takes it
            # from `pending_loop_label`; anything else after a label is an error.
            if kind == TokenKind.Label and parser.peek_at(1) == TokenKind.Colon:
                label_name: sview = Lexer::text_or_empty(token, parser.source)
                parser, _ <- parser.advance()
                parser, _ <- parser.advance()
                next_token: Token = parser.cursor()
                if parser.peek() == TokenKind.While:
                    parser.pending_loop_label <- label_name
                    rebind labelled_while: Ast::Stmt?, parser = parser.while_statement() can Global{Read,Write}
                    return labelled_while
                if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(next_token, parser.source) == "for":
                    parser.pending_loop_label <- label_name
                    rebind labelled_for: Ast::Stmt?, parser = parser.for_statement(false) can Global{Read,Write}
                    return labelled_for
                not_a_loop_sentence_pieces: darray[sview] = ["the label '", label_name, " must be followed by a `for` or `while` loop on the same line (`'", label_name, ": for x in xs:`); only loops can be labelled"]
                not_a_loop_sentence: sview = parser.removed_sentence(not_a_loop_sentence_pieces)
                parser <- parser.error_removed(token, not_a_loop_sentence)
                return (Ast::Stmt.Invalid)
            if kind == TokenKind.Pass:
                parser, _ <- parser.advance()
                return (Ast::Stmt.Expr((Ast::Expr.Invalid), Ast::pos_of_token(token)))
            if kind == TokenKind.Error and parser.peek_at(1) == TokenKind.LParen:
                rebind error_call: Ast::Expr, parser = get parser.expression() can Global{Read,Write}
                return (Ast::Stmt.Expr(error_call, Ast::pos_of_token(token)))
            return null





        def statement_inner(parser: lmut Parser) -> Ast::Stmt?:
            kind: TokenKind = parser.peek()
            token: Token = parser.cursor()

            # Branch-local machine transitions are lowered from this temporary marker
            # after the complete arm has been validated. They are restricted to the
            # branch grammar by machine-arm validation and never reach semantic passes.
            if kind == TokenKind.Arrow and parser.machine_arm_branch_depth > 0:
                parser, _ <- parser.advance()
                rebind target_token: Token, parser = parser.expect(TokenKind.Ident)
                target_name: sview = Lexer::text_or_empty(target_token, parser.source)
                rebind accepted_args: bool, parser = parser.accept(TokenKind.LParen)
                if accepted_args:
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, parser.cursor()) if parser.peek() != TokenKind.RParen
                    parser, _ <- parser.expect(TokenKind.RParen)
                parser, _ <- parser.accept(TokenKind.Newline)
                marker: sview = parser.machine_transition_marker(target_name)
                return (Ast::Stmt.Break(marker, Ast::pos_of_token(token)))

            # A local `state Name(field: Type)` is a parser directive, not executable
            # code. Leave its newline for parse_block's null-statement progress step,
            # exactly as stage0 skips its nil state declaration.
            if kind == TokenKind.Ident and Lexer::text_or_empty(token, parser.source) == "state" and (parser.peek_at(1) == TokenKind.Ident or parser.peek_at(1) == TokenKind.LBrace):
                if parser.peek_at(1) == TokenKind.LBrace:
                    parser <- parser.parse_pending_machine_state_decls()
                else:
                    rebind state_decl: MachineStateAst, parser = parser.parse_machine_state_decl() can Global{Read,Write}
                    parser.pending_state_decls <- parser.pending_state_decls.push(state_decl)
                return null

            if kind == TokenKind.If and parser.machine_arm_body_depth > 0:
                parser.machine_arm_branch_depth <- parser.machine_arm_branch_depth + 1
                rebind branch_if: Ast::Stmt?, parser = parser.statement_direct_keyword(kind, token) can Global{Read,Write}
                parser.machine_arm_branch_depth <- parser.machine_arm_branch_depth - 1
                if branch_if is branch_result:
                    return branch_result
            rebind direct: Ast::Stmt?, parser = parser.statement_direct_keyword(kind, token) can Global{Read,Write}
            if direct is direct_result:
                return direct_result
            # An explicit binding qualifier is orthogonal to the mutability of
            # the declared type: `mutable p: T&` makes the local slot rebindable,
            # while `const p: mutable T&` keeps that slot fixed but permits writes
            # through the reference. The legacy `p: mutable T&` form is unchanged.
            if (kind == TokenKind.Mutable or kind == TokenKind.Const) and parser.peek_at(1) == TokenKind.Ident and parser.peek_at(2) == TokenKind.Colon:
                rebind binding_decl: Ast::Stmt?, parser = parser.binding_qualified_variable_statement() can Global{Read,Write}
                return binding_decl
            if (kind == TokenKind.With or kind == TokenKind.Region or kind == TokenKind.In or kind == TokenKind.Error):
                    # `region NAME` is unambiguously a region prefix; keep the new
                    # missing-block diagnostic scoped to that form. Other keyword
                    # tokens (`error(...)`, `in`, `with`) have legacy expression/recovery
                    # spellings whose primary-token support is intentionally unchanged.
                    if kind == TokenKind.Region and parser.peek_at(1) == TokenKind.Ident:
                        rebind __ret_92: Ast::Stmt?, parser = parser.prefixed_block_statement() can Global{Read,Write}
                        return __ret_92
                    rebind __ret_93: Ast::Stmt?, parser = parser.prefixed_block_statement() can Global{Read,Write}
                    return __ret_93
            if kind == TokenKind.Try:
                    # `try:` opens a handler block; a bare `try EXPR` statement is a
                    # fallible call — parse it as an expression statement (get_expression
                    # consumes the `try` head and any `else` recovery tail) so the
                    # call's references resolve instead of being token-skipped.
                    if parser.peek_at(1) == TokenKind.Colon:
                        rebind __ret_100: Ast::Stmt?, parser = parser.prefixed_block_statement() can Global{Read,Write}
                        return __ret_100
                    rebind try_value: Ast::Expr, parser = get parser.expression() can Global{Read,Write}
                    return (Ast::Stmt.Expr(try_value, Ast::pos_of_token(token)))
            if kind == TokenKind.Catch:
                    rebind __ret_105: Ast::Stmt?, parser = parser.catch_statement() can Global{Read,Write}
                    return __ret_105
            # `static if/elif/else COND:` compile-time conditional inside a body.
            # NOT routed through prefixed_block_statement: that path skips the
            # condition to the colon, and a discarded condition cannot be selected
            # on -- the backend then saw every branch's body (duplicate locals,
            # unresolvable per-target externs) and declined the whole function.
            if kind == TokenKind.Static:
                if parser.peek_at(1) == TokenKind.If or parser.peek_at(1) == TokenKind.Elif or parser.peek_at(1) == TokenKind.Else:
                    static_head: Token = parser.cursor()
                    parser, _ <- parser.advance()
                    static_chain_head: bool = parser.peek() == TokenKind.If
                    static_matched_head: bool = parser.peek() == TokenKind.If or parser.peek() == TokenKind.Elif
                    parser <- parser.advance_if(static_matched_head)
                    parser <- parser.capture_static_if_condition(static_head.line, static_chain_head) can Global{Read,Write} if static_matched_head
                    parser <- parser.record_static_else(static_head.line) if not static_matched_head
                    parser <- parser.accept_if(TokenKind.Else, not static_matched_head)
                    parser.static_if_depth <- parser.static_if_depth + 1
                    rebind static_body: darray[Ast::Stmt], parser = parser.parse_block() can Global{Read,Write}
                    parser.static_if_depth <- parser.static_if_depth - 1
                    static_empty_clause: darray[sview] = []
                    return (Ast::Stmt.Block("static", static_empty_clause, "", static_body, Ast::pos_of_token(static_head)))
                    # `static:` compile-time block — a bare indented body evaluated at
                    # compile time. Parse the body as an ordinary block (the prefix is
                    # just `static` up to the colon); its statements resolve normally.
                if parser.peek_at(1) == TokenKind.Colon:
                    rebind __ret_static_block: Ast::Stmt?, parser = parser.prefixed_block_statement() can Global{Read,Write}
                    return __ret_static_block
                else:
                        # `static <directive>` (e.g. `static error("…")`): consume the
                        # `static` marker and parse the directive as a statement.
                        parser, _ <- parser.advance()
                        # Body-level `static assert COND[, "MSG"]` (line form) or
                        # `static assert:` (block form) — record the assertions into the
                        # file's static-assert registry (mirroring the declaration path in
                        # parse_static) so check_static_assert can const-evaluate a false one.
                        directive_token: Token = parser.cursor()
                        if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(directive_token, parser.source) == "assert":
                            parser, _ <- parser.advance()          # `assert`
                            rebind accepted_colon: bool, parser = parser.accept(TokenKind.Colon)
                            parser <- parser.capture_static_assert_block() can Global{Read,Write} if accepted_colon
                            parser <- parser.capture_static_assert_line(directive_token.line) can Global{Read,Write} if not accepted_colon
                            # A benign, DISTINGUISHABLE no-op — not Stmt.Invalid, which the
                            # backend rightly declines as a parse failure. The assertion
                            # itself lives in the static-assert registry rows captured
                            # above; the statement's only job is to occupy the slot.
                            static_assert_empty_clause: darray[sview] = []
                            return (Ast::Stmt.Block("static_assert", static_assert_empty_clause, "", [], Ast::pos_of_token(directive_token)))
                        # `static <call>` (e.g. `static answer(2)`) is a compile-time
                        # context just like `static:` — wrap the directive in a static
                        # block so the static-call-context check treats it as one.
                        directive_line: u32 = directive_token.line
                        rebind __ret_117: Ast::Stmt?, parser = parser.statement() can Global{Read,Write}
                        if __ret_117 is static_directive_stmt:
                            static_directive_body: mutable darray[Ast::Stmt] = []
                            parser <- parser.push_statement_with_pending(static_directive_body, static_directive_stmt)
                            return (Ast::Stmt.Block("static", [], "", static_directive_body, Ast::pos_at_line(directive_line)))
                        return __ret_117

            # Contextual-keyword statements (the lexer emits these as identifiers).
            if kind == TokenKind.Ident:
                head: sview = Lexer::text_or_empty(token, parser.source)
                rebind contextual: Ast::Stmt?, parser = parser.contextual_statement(token, head) can Global{Read,Write}
                if contextual is contextual_result:
                    return contextual_result
            # `IDENT:` immediately followed by a newline is a labeled/arm block
            # (e.g. a `catch …:` block's `ok:` success arm), not a binding.
            if kind == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon and parser.peek_at(2) == TokenKind.Newline:
                rebind __ret_168: Ast::Stmt?, parser = parser.prefixed_block_statement() can Global{Read,Write}
                return __ret_168

            # `IDENT :` introduces a local binding (`x: T` / `x: T = v`).
            if kind == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon:
                rebind __ret_172: Ast::Stmt?, parser = parser.variable_declaration_statement() can Global{Read,Write}
                return __ret_172

            rebind expression_tail: Ast::Stmt?, parser = parser.statement_expression_tail(token) can Global{Read,Write}
            return expression_tail

include "./parser_stmt_contextual.elisa"
include "./parser_stmt_expression_tail.elisa"
include "./parser_stmt_manifest.elisa"

include "./parser_stmt_state_thread.elisa"
