# Stage1 parser — LOWERING one machine arm: the dispatch condition it denotes (payload pattern
# AND input AND guard), the transition temporaries and payload aliases its body needs, and the
# header locals it opens. Part of `module Parser` (see parser.elisa).

extend Parser:
    public:

        def append_machine_transition_temp_declarations_for_state(declarations: mutable darray[Ast::Stmt]&, arm: MachineArmAst&, target_state: MachineStateAst) -> void:
            machine over declarations for argument_index in 0..<arm.transition_args.count:
                state Scan
                start Scan

                Scan, _ if argument_index >= target_state.field_types.count:
                    -> Scan

                Scan, _:
                    temp_type: Ast::Expr = (Ast::Expr.Unary(TokenKind.Mutable, target_state.field_types[argument_index], Ast::pos_at_line(arm.target_line)))
                    declarations.push((Ast::Stmt.VarDecl(arm.transition_temp_names[argument_index], temp_type, (Ast::Expr.Ident("zeroed", Ast::pos_at_line(arm.target_line))), Ast::pos_at_line(arm.target_line))))
                    -> Scan



        def append_machine_transition_temp_declarations(declarations: mutable darray[Ast::Stmt]&, arm: MachineArmAst&, states: darray[MachineStateAst]) -> void:
            machine over declarations for target_state in states:
                state Scan
                start Scan

                Scan, _ if not arm.has_transition or target_state.name != arm.target:
                    -> Scan

                Scan, _:
                    append_machine_transition_temp_declarations_for_state(declarations, arm, target_state)
                    -> Scan



        def append_machine_payload_aliases(local_names: mutable darray[sview]&, payloads: darray[MachinePayloadPat], state_fields: darray[sview]) -> void:
            machine over local_names for payload_index in 0..<payloads.count:
                state Scan
                start Scan

                Scan, _ if payload_index >= state_fields.count:
                    -> Scan

                Scan, _ if payloads[payload_index].bind == "" or payloads[payload_index].bind == state_fields[payload_index]:
                    -> Scan

                Scan, _:
                    local_names.push(payloads[payload_index].bind)
                    -> Scan



        def append_machine_arm_header_locals(local_names: mutable darray[sview]&, arm: MachineArmAst, states: darray[MachineStateAst]) -> void:
            machine over local_names for state in states:
                state Scan
                start Scan

                Scan, _ if state.name != arm.state_name:
                    -> Scan

                Scan, _:
                    append_machine_payload_aliases(local_names, arm.payloads, state.field_names)
                    -> Scan



        # Lower one arm: payload-pattern conds AND input conds AND guard; body plus the
        # transition's payload assigns + mode rebind. Payload assignments are retained even
        # when both identifiers have the same spelling: an arm-local may shadow the state
        # slot, in which case `-> Next(value)` must copy that local into Next.value.
        def lower_machine_arm_body(arm: MachineArmAst&, states: darray[MachineStateAst], state_fields: darray[sview], enum_name: sview, mode_var: sview, input_var: sview, line: u32) -> darray[Ast::Stmt]:
            lowered: mutable darray[Ast::Stmt] = []
            # Compute this from the source arm before aliases are materialized. The
            # result is reused by the transition emitter below; passing the fact avoids
            # asking a lowered AST to recover lexical binding identity.
            transition_target_shadows: bool = machine_arm_shadows_transition_target(arm, state_fields, states)
            if arm.input_bind != "":
                # Keep the input binder local to the selected arm body. Its guard
                # receives a separate expression-block binding below, so sibling
                # arms cannot observe this name.
                lowered.push((Ast::Stmt.VarDecl(arm.input_bind, (Ast::Expr.Invalid), (Ast::Expr.Ident(input_var, Ast::pos_at_line(arm.line))), Ast::pos_at_line(arm.line))))
            # Payload bind aliases (bind name != field name).
            machine over lowered for index in 0..<arm.payloads.count:
                state Scan
                start Scan

                Scan, _ if index >= state_fields.count:
                    -> Scan

                Scan, _ if arm.payloads[index].is_wild or arm.payloads[index].bind == "" or arm.payloads[index].bind == state_fields[index]:
                    -> Scan

                Scan, _:
                    pat: MachinePayloadPat = arm.payloads[index]
                    lowered.push((Ast::Stmt.VarDecl(pat.bind, (Ast::Expr.Invalid), (Ast::Expr.Ident(state_fields[index], Ast::pos_at_line(arm.line))), Ast::pos_at_line(arm.line))))
                    -> Scan
            machine over lowered for statement in arm.body:
                state Scan
                start Scan

                Scan, _:
                    lowered.push(statement)
                    -> Scan
            lowered.reserve(lowered.count + states.count)
            machine over lowered for target_state in states:
                state Scan
                start Scan

                Scan, _ if not arm.has_transition or target_state.name != arm.target:
                    -> Scan

                Scan, _:
                    append_machine_transition_for_target(lowered, arm, target_state, transition_target_shadows, enum_name, mode_var)
                    -> Scan
            lowered.push((Ast::Stmt.Expr((Ast::Expr.Invalid), Ast::pos_at_line(line)))) if lowered.count == 0
            return lowered



        def append_machine_transition_for_target[@r](lowered: mutable darray[Ast::Stmt]& @r, arm: MachineArmAst&, target_state: MachineStateAst, transition_target_shadows: bool, enum_name: sview, mode_var: sview) -> void:
            if transition_target_shadows:
                captured: mutable darray[Ast::Stmt] @r = []
                captured.extend(lowered)
                values: mutable darray[Ast::Expr] @r = []
                machine over values for argument_index in 0..<arm.transition_args.count:
                    state Capture
                    start Capture

                    Capture, _:
                        append_machine_transition_capture(captured, values, arm, argument_index)
                        -> Capture
                lowered <- [(Ast::Stmt.Block("can", [], "", captured, Ast::pos_at_line(arm.line)))]
                append_machine_transition_for_values(lowered, arm, target_state, enum_name, mode_var, values)
                return
            append_machine_transition_for_state(lowered, arm, target_state, enum_name, mode_var)



        def append_machine_transition_capture(captured: mutable darray[Ast::Stmt]&, values: mutable darray[Ast::Expr]&, arm: MachineArmAst&, argument_index: usize) -> void:
            captured.push((Ast::Stmt.Assign((Ast::Expr.Ident(arm.transition_temp_names[argument_index], Ast::pos_at_line(arm.target_line))), TokenKind.LArrow, arm.transition_args[argument_index], Ast::pos_at_line(arm.target_line))))
            values.push((Ast::Expr.Ident(arm.transition_temp_names[argument_index], Ast::pos_at_line(arm.target_line))))



        def append_machine_transition_for_state(lowered: mutable darray[Ast::Stmt]&, arm: MachineArmAst&, target_state: MachineStateAst, enum_name: sview, mode_var: sview) -> void:
            machine over lowered for argument_index in 0..<arm.transition_args.count:
                state Capture
                start Capture

                Capture, _:
                    lowered.push((Ast::Stmt.VarDecl(arm.transition_temp_names[argument_index], (Ast::Expr.Invalid), arm.transition_args[argument_index], Ast::pos_at_line(arm.target_line))))
                    -> Capture
            machine over lowered for index in 0..<target_state.field_names.count:
                state Scan
                start Scan

                Scan, _ if index >= arm.transition_args.count:
                    -> Scan

                Scan, _:
                    lowered.push((Ast::Stmt.Assign((Ast::Expr.Ident(target_state.field_names[index], Ast::pos_at_line(arm.target_line))), TokenKind.LArrow, (Ast::Expr.Ident(arm.transition_temp_names[index], Ast::pos_at_line(arm.target_line))), Ast::pos_at_line(arm.target_line))))
                    -> Scan
            lowered.push((Ast::Stmt.Assign((Ast::Expr.Ident(mode_var, Ast::pos_at_line(arm.target_line))), TokenKind.LArrow, (Ast::Expr.Field((Ast::Expr.Ident(enum_name, Ast::pos_at_line(arm.target_line))), arm.target, Ast::pos_at_line(arm.target_line))), Ast::pos_at_line(arm.target_line)))) if arm.target != arm.state_name



        def append_machine_transition_for_values(lowered: mutable darray[Ast::Stmt]&, arm: MachineArmAst&, target_state: MachineStateAst, enum_name: sview, mode_var: sview, values: darray[Ast::Expr]) -> void:
            machine over lowered for index in 0..<target_state.field_names.count:
                state Scan
                start Scan

                Scan, _ if index >= values.count:
                    -> Scan

                Scan, _:
                    lowered.push((Ast::Stmt.Assign((Ast::Expr.Ident(target_state.field_names[index], Ast::pos_at_line(arm.target_line))), TokenKind.LArrow, values[index], Ast::pos_at_line(arm.target_line))))
                    -> Scan
            lowered.push((Ast::Stmt.Assign((Ast::Expr.Ident(mode_var, Ast::pos_at_line(arm.target_line))), TokenKind.LArrow, (Ast::Expr.Field((Ast::Expr.Ident(enum_name, Ast::pos_at_line(arm.target_line))), arm.target, Ast::pos_at_line(arm.target_line))), Ast::pos_at_line(arm.target_line)))) if arm.target != arm.state_name



        # Build the arm's dispatch condition (Invalid when irrefutable).
        def machine_arm_condition(arm: MachineArmAst&, state_fields: darray[sview], input_var: sview) -> Ast::Expr:
            condition: mutable Ast::Expr = (Ast::Expr.Invalid)
            machine over condition while true:
                state Scan(index: usize, value: Ast::Expr)
                start Scan(0, (Ast::Expr.Invalid))

                Scan(index, value), _ if index >= arm.payloads.count:
                    condition <- value
                    break

                Scan(index, value), _ if index >= state_fields.count or arm.payloads[index].is_wild or arm.payloads[index].bind != "":
                    -> Scan(index + 1, value)

                Scan(index, value), _:
                    pat: MachinePayloadPat = arm.payloads[index]
                    # Literal payload pattern = equality test; predicate used verbatim.
                    term: Ast::Expr = machine_payload_condition(pat, state_fields[index], arm.line)
                    next_value: Ast::Expr = combine_machine_condition(value, term, TokenKind.And, arm.line)
                    -> Scan(index + 1, next_value)
            if not arm.input_wild:
                input_condition: mutable Ast::Expr = (Ast::Expr.Invalid)
                append_machine_input_condition(input_condition, arm, input_var)
                condition <- input_condition if machine_expr_is_invalid(condition) else (Ast::Expr.Binary(condition, TokenKind.And, input_condition, Ast::pos_at_line(arm.line)))
            guard: mutable Ast::Expr = arm.guard
            if arm.input_bind != "" and not machine_expr_is_invalid(guard):
                guard <- (Ast::Expr.Block([(Ast::Stmt.VarDecl(arm.input_bind, (Ast::Expr.Invalid), (Ast::Expr.Ident(input_var, Ast::pos_at_line(arm.line))), Ast::pos_at_line(arm.line)))], guard, [], Ast::pos_at_line(arm.line)))
            condition <- (guard if machine_expr_is_invalid(condition) else (Ast::Expr.Binary(condition, TokenKind.And, guard, Ast::pos_at_line(arm.line)))) if not machine_expr_is_invalid(guard)
            return condition



        def append_machine_input_condition(input_condition: mutable Ast::Expr&, arm: MachineArmAst&, input_var: sview) -> void:
            machine over input_condition while true:
                state Scan(phase: usize, index: usize, value: Ast::Expr)
                start Scan(0, 0, (Ast::Expr.Invalid))

                Scan(0, index, value), _ if index >= arm.input_literals.count:
                    -> Scan(1, 0, value)

                Scan(1, index, value), _ if index >= arm.input_ranges.count:
                    input_condition <- value
                    break

                Scan(0, index, value), _:
                    literal: Ast::Expr = arm.input_literals[index]
                    comparison: Ast::Expr = (Ast::Expr.Binary((Ast::Expr.Ident(input_var, Ast::pos_at_line(arm.line))), TokenKind.EqEq, literal, Ast::pos_at_line(arm.line)))
                    next_value: Ast::Expr = combine_machine_condition(value, comparison, TokenKind.Or, arm.line)
                    -> Scan(0, index + 1, next_value)

                Scan(1, index, value), _:
                    range: MachineRange = arm.input_ranges[index]
                    lo_test: Ast::Expr = (Ast::Expr.Binary((Ast::Expr.Ident(input_var, Ast::pos_at_line(arm.line))), TokenKind.GtEq, range.lo, Ast::pos_at_line(arm.line)))
                    hi_operator: TokenKind = machine_range_hi_operator(range)
                    hi_test: Ast::Expr = (Ast::Expr.Binary((Ast::Expr.Ident(input_var, Ast::pos_at_line(arm.line))), hi_operator, range.hi, Ast::pos_at_line(arm.line)))
                    range_test: Ast::Expr = (Ast::Expr.Binary(lo_test, TokenKind.And, hi_test, Ast::pos_at_line(arm.line)))
                    next_value: Ast::Expr = combine_machine_condition(value, range_test, TokenKind.Or, arm.line)
                    -> Scan(1, index + 1, next_value)




        def machine_payload_condition(pat: MachinePayloadPat, state_field: sview, line: u32) -> Ast::Expr:
            return (Ast::Expr.Binary((Ast::Expr.Ident(state_field, Ast::pos_at_line(line))), TokenKind.EqEq, pat.condition, Ast::pos_at_line(line))) if machine_expr_is_literal(pat.condition) or not machine_expr_mentions_ident(pat.condition, state_field) else pat.condition



        def combine_machine_condition(existing: Ast::Expr, next: Ast::Expr, operator: TokenKind, line: u32) -> Ast::Expr:
            return next if machine_expr_is_invalid(existing) else (Ast::Expr.Binary(existing, operator, next, Ast::pos_at_line(line)))



        def machine_range_hi_operator(range: MachineRange) -> TokenKind:
            return TokenKind.LtEq if range.inclusive else TokenKind.Lt
