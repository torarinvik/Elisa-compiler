# Stage1 parser — the LICENSED ROOTS of a `machine over ...` header (docs/123). Stage0 licenses
# every named root occurring in the `over` expression and in each arm, so the parser walks both
# and records what it finds. Continues parser_stmt_machine.elisa.

extend Parser:
    public:

        def machine_over_ahead(parser: Parser&) -> bool:
            false return if parser.peek() != TokenKind.Ident
            false return if parser.position + 1 >= parser.tokens.count
            next_token: Token = parser.tokens[parser.position + 1]
            false return if next_token.kind != TokenKind.Ident
            return Lexer::text_or_empty(next_token, parser.source) == "over"



        # Stage0 licenses every named root occurring in the `over` expression and the
        # optional `while` condition. This is necessary for expressions such as
        # `ready and lexer.next()`: both `ready` and `lexer` are driven resources for the
        # value block.
        def machine_add_root(roots: mutable darray[sview]&, name: sview) -> void:
            return if name == ""
            for existing in roots:
                return if existing == name
            roots.push(name)



        # The driven-resource root of the `over` expression (`lexer.current_char()` ->
        # `lexer`). Keep this separate from general expression-root collection: the
        # loop header must capture the resource being advanced, not every identifier
        # mentioned by a classifier call.
        def machine_over_root(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Field(object, _, _):
                    return machine_over_root(object)
                Ast::Expr.Call(callee, arguments, _, _):
                    # A free-function call `f(resource.m())` drives the resource in
                    # its argument; a method call `resource.m()` drives the callee.
                    machine_over_root(arguments[0]) return if machine_expr_ident_name(callee) != "" and arguments.count > 0
                    return machine_over_root(callee)
                Ast::Expr.Index(object, _, _):
                    return machine_over_root(object)
                _:
                    return ""



        # Recovery and handler arms are statement-bearing expression children. They execute
        # conditionally, but their values and calls still belong to the enclosing machine's
        # driven-resource graph and must not disappear from the root walk.
        def machine_collect_statement_roots(statements: darray[Ast::Stmt], roots: mutable darray[sview]&) -> void:
            for statement in statements |roots|:
                match statement:
                    Ast::Stmt.VarDecl(name, type_expression, value, line):
                        machine_collect_roots(value, roots)
                    Ast::Stmt.Assign(target, operator, value, line):
                        machine_collect_roots(target, roots)
                        machine_collect_roots(value, roots)
                    Ast::Stmt.Expr(expression, line):
                        machine_collect_roots(expression, roots)
                    Ast::Stmt.Return(value, line):
                        if value is returned:
                            machine_collect_roots(returned, roots)
                    Ast::Stmt.If(condition, then_body, else_body, line):
                        machine_collect_roots(condition, roots)
                        machine_collect_statement_roots(then_body, roots)
                        machine_collect_statement_roots(else_body, roots)
                    Ast::Stmt.While(condition, body, line):
                        machine_collect_roots(condition, roots)
                        machine_collect_statement_roots(body, roots)
                    Ast::Stmt.For(bind, variables, iterable, body, line):
                        machine_collect_roots(iterable, roots)
                        machine_collect_statement_roots(body, roots)
                    Ast::Stmt.Block(kind, clause, binding, body, line):
                        machine_collect_statement_roots(body, roots)
                    Ast::Stmt.Match(scrutinee, arms, line):
                        machine_collect_roots(scrutinee, roots)
                        for arm in arms |roots|:
                            machine_collect_roots(arm.guard, roots)
                            machine_collect_statement_roots(arm.body, roots)
                    Ast::Stmt.Contract(_, expression, _):
                        machine_collect_roots(expression, roots)
                    _:
                        pass



        def machine_collect_roots(expression: Ast::Expr, roots: mutable darray[sview]&) -> void:
            match expression:
                Ast::Expr.Ident(name, _):
                    machine_add_root(roots, name)
                Ast::Expr.Field(object, _, _):
                    machine_collect_roots(object, roots)
                Ast::Expr.Scope(base, _, _):
                    machine_collect_roots(base, roots)
                Ast::Expr.Call(callee, arguments, _, _):
                    machine_collect_roots(callee, roots) if machine_expr_ident_name(callee) == ""
                    for argument in arguments |roots|:
                        machine_collect_roots(argument, roots)
                Ast::Expr.Index(object, index, _):
                    machine_collect_roots(object, roots)
                    machine_collect_roots(index, roots)
                Ast::Expr.Slice(object, low, high, _):
                    machine_collect_roots(object, roots)
                    machine_collect_roots(low, roots)
                    machine_collect_roots(high, roots)
                Ast::Expr.IndexN(object, arguments, _):
                    machine_collect_roots(object, roots)
                    for argument in arguments |roots|:
                        machine_collect_roots(argument, roots)
                Ast::Expr.Binary(left, _, right, _):
                    machine_collect_roots(left, roots)
                    machine_collect_roots(right, roots)
                Ast::Expr.Unary(_, operand, _):
                    machine_collect_roots(operand, roots)
                Ast::Expr.Move(operand, _):
                    machine_collect_roots(operand, roots)
                Ast::Expr.RegionNew(operand, _, _):
                    machine_collect_roots(operand, roots)
                Ast::Expr.Paren(inner, _):
                    machine_collect_roots(inner, roots)
                Ast::Expr.Refinement(base, predicate, _):
                    machine_collect_roots(base, roots)
                    machine_collect_roots(predicate, roots)
                Ast::Expr.GetElse(guarded, recovery, _):
                    machine_collect_roots(guarded, roots)
                    machine_collect_statement_roots(recovery, roots)
                Ast::Expr.Array(elements, _):
                    for element in elements |roots|:
                        machine_collect_roots(element, roots)
                Ast::Expr.Tuple(elements, _):
                    for element in elements |roots|:
                        machine_collect_roots(element, roots)
                Ast::Expr.SetLit(elements, _):
                    for element in elements |roots|:
                        machine_collect_roots(element, roots)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |roots|:
                        machine_collect_roots(entry.key, roots)
                        machine_collect_roots(entry.value, roots)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |roots|:
                        machine_collect_roots(field.value, roots)
                Ast::Expr.RecordUpdate(base, fields, _):
                    machine_collect_roots(base, roots)
                    for field in fields |roots|:
                        machine_collect_roots(field.value, roots)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    machine_collect_roots(condition, roots)
                    machine_collect_roots(then_expression, roots)
                    machine_collect_roots(else_expression, roots)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    machine_collect_roots(iterable, roots)
                    machine_collect_roots(condition, roots)
                    machine_collect_roots(body, roots)
                Ast::Expr.Lambda(_, body, _):
                    machine_collect_statement_roots(body, roots)
                Ast::Expr.Block(statements, value, _, _):
                    machine_collect_statement_roots(statements, roots)
                    machine_collect_roots(value, roots)
                Ast::Expr.Match(scrutinee, arms, _):
                    machine_collect_roots(scrutinee, roots)
                    for arm in arms |roots|:
                        machine_collect_roots(arm.guard, roots)
                        machine_collect_statement_roots(arm.body, roots)
                Ast::Expr.Catch(scrutinee, arms, _):
                    machine_collect_roots(scrutinee, roots)
                    for arm in arms |roots|:
                        machine_collect_roots(arm.guard, roots)
                        machine_collect_statement_roots(arm.body, roots)
                _:
                    pass
