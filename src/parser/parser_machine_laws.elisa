# Stage1 parser — the MACHINE LAWS (docs/123 §5, docs/125 §9): an arm body is straight-line, no
# arm may shadow its transition target, mutations are validated in source order, and every
# declared state needs arms that cover it without an early irrefutable one.
# Part of `module Parser` (see parser.elisa).

extend Parser:
    public:

        # docs/123 §5 (the machine arm law): an arm body is STRAIGHT-LINE. All discrimination
        # lives in the arm HEADER (`State, input if guard:`), so hidden branching/looping
        # (`if`/`match`/`while`/`for`) inside a body is refused — as is `continue` (every arm
        # ends in `-> State`, `return`, or `break`). `return`/`break` stay legal: they are arm
        # EXITS. Stage1 now OWNS this refusal (docs/125 step 13) rather than deferring to
        # stage0; mirrors stage0's validateMachineArmStmt (parser/machine.go). A `can`/`with`/…
        # wrapper is transparent — its body is retested one level down.
        def machine_over_arm_stmt_illegal(statement: Ast::Stmt) -> bool:
            return match statement:
                Ast::Stmt.If(condition, then_body, else_body, line):
                    true
                Ast::Stmt.While(condition, body, line):
                    true
                Ast::Stmt.For(bind, variables, iterable, body, line):
                    true
                Ast::Stmt.Match(scrutinee, arms, line):
                    true
                Ast::Stmt.Continue(label, line):
                    true
                Ast::Stmt.Block(kind, clause, binding, body, line):
                    any inner in body where machine_over_arm_stmt_illegal(inner)
                Ast::Stmt.Return(value, line):
                    false
                Ast::Stmt.Break(label, line):
                    false
                Ast::Stmt.VarDecl(name, type_expression, value, line):
                    false
                Ast::Stmt.Assign(target, operator, value, line):
                    false
                Ast::Stmt.Expr(expression, line):
                    false
                _:
                    true


        def machine_statement_exits(statement: Ast::Stmt) -> bool:
            return match statement:
                Ast::Stmt.Return(value, line): true
                Ast::Stmt.Break(label, line): true
                _: false



        # Assignment targets have a narrower root grammar than arbitrary expressions: only
        # identifiers, fields, single/multi-indexes, and parentheses are lvalues. Keep calls
        # out of this helper so an invalid `call(...) <- value` cannot be mistaken for a driven
        # resource.
        def machine_assignment_expr_root(expression: Ast::Expr) -> sview:
            return match expression:
                Ast::Expr.Ident(name, _): name
                Ast::Expr.Field(object, _, _): machine_assignment_expr_root(object)
                Ast::Expr.Index(object, _, _): machine_assignment_expr_root(object)
                Ast::Expr.IndexN(object, _, _): machine_assignment_expr_root(object)
                Ast::Expr.Paren(inner, _): machine_assignment_expr_root(inner)
                _:
                    ""



        def collect_machine_statement_calls(statement: Ast::Stmt, over_roots: darray[sview], mutated_roots: mutable darray[sview]&) -> void:
            match statement:
                Ast::Stmt.Expr(expression, _):
                    machine_collect_call_roots(expression, over_roots, mutated_roots)
                Ast::Stmt.VarDecl(_, _, value, _):
                    machine_collect_call_roots(value, over_roots, mutated_roots)
                Ast::Stmt.Assign(target, _, value, _):
                    machine_collect_call_roots(target, over_roots, mutated_roots)
                    machine_collect_call_roots(value, over_roots, mutated_roots)
                Ast::Stmt.Return(value, _):
                    if value is returned:
                        machine_collect_call_roots(returned, over_roots, mutated_roots)
                Ast::Stmt.Block(_, _, _, body, _):
                    for nested in body |over_roots, mutated_roots|:
                        collect_machine_statement_calls(nested, over_roots, mutated_roots)
                _:
                    pass



        def machine_arm_payload_shadows_target(arm: MachineArmAst&, source_fields: darray[sview], target_state: MachineStateAst) -> bool:
            shadowed: mutable bool = false
            machine over shadowed for index in 0..<arm.payloads.count:
                state {Payload, Done}
                start Payload

                Payload, _ if index >= source_fields.count:
                    -> Done

                Payload, _ if machine_arm_payload_shadows_target_at(arm, source_fields, target_state, index):
                    shadowed <- true
                    -> Done

                Payload, _:
                    -> Payload

                Done, _:
                    -> Done
            return shadowed



        def machine_arm_payload_shadows_target_at(arm: MachineArmAst&, source_fields: darray[sview], target_state: MachineStateAst, payload_index: usize) -> bool:
            bind_name: sview = arm.payloads[payload_index].bind
            return bind_name != "" and bind_name != source_fields[payload_index] and any field_name in target_state.field_names where field_name == bind_name



        def machine_arm_shadows_transition_target(arm: MachineArmAst&, source_fields: darray[sview], states: darray[MachineStateAst]) -> bool:
            false return if not arm.has_transition
            shadowed: mutable bool = false
            machine over shadowed for target_state in states:
                state {Scan, Done}
                start Scan

                Scan, _ if target_state.name != arm.target:
                    -> Scan

                Scan, _ if arm.input_bind != "" and any field_name in target_state.field_names where field_name == arm.input_bind:
                    shadowed <- true
                    -> Done

                Scan, _ if machine_arm_payload_shadows_target(arm, source_fields, target_state):
                    shadowed <- true
                    -> Done

                Scan, _ if machine_state_declares_any_name(arm.body, target_state.field_names):
                    shadowed <- true
                    -> Done

                Scan, _:
                    -> Done

                Done, _:
                    -> Done
            return shadowed



        def validate_machine_assignment_root(parser: lmut Parser, target: Ast::Expr, local_names: mutable darray[sview]&, field_names: darray[sview], over_roots: darray[sview], mutated_roots: mutable darray[sview]&, token: Token) -> void:
            root: sview = machine_assignment_expr_root(target)
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if root == ""
            if root != "":
                local: bool = any local_name in local_names where local_name == root
                payload_field: bool = any field_name in field_names where field_name == root
                driven: bool = any driven_name in over_roots where driven_name == root
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if not local and payload_field
                machine_add_root(mutated_roots, root) if not local and not payload_field and driven
                # A machine arm may mutate only an arm-local declaration or a root that
                # appears in `over`/`while`. Do not narrow this to mutable parameters:
                # outer locals and globals are foreign too.
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if not local and not payload_field and not driven



        def validate_machine_assignment_target(parser: lmut Parser, target: Ast::Expr, operator: TokenKind, local_names: mutable darray[sview]&, field_names: darray[sview], over_roots: darray[sview], mutated_roots: mutable darray[sview]&, token: Token) -> void:
            match target:
                # `rebind fresh: T, driven = value` is lowered to one array target by the
                # stage1 parser. The first colon-marked target introduces an arm-local; the
                # remaining targets are existing lvalues and must obey the normal root law.
                Ast::Expr.Array(targets, _):
                    first_target: mutable bool = true
                    for target_part in targets |parser, local_names, first_target|:
                        fresh_name: sview = machine_expr_ident_name(target_part)
                        if operator == TokenKind.Assign and first_target and fresh_name != "":
                            local_names.push(fresh_name)
                        else:
                            parser <- parser.validate_machine_assignment_root(target_part, local_names, field_names, over_roots, mutated_roots, token)
                        first_target <- false
                _:
                    parser <- parser.validate_machine_assignment_root(target, local_names, field_names, over_roots, mutated_roots, token)



        def validate_machine_arm_mutations(parser: lmut Parser, statements: darray[Ast::Stmt], local_names: mutable darray[sview]&, field_names: darray[sview], over_roots: darray[sview], mutated_roots: mutable darray[sview]&, token: Token) -> void:
            for statement in statements |parser, local_names|:
                collect_machine_statement_calls(statement, over_roots, mutated_roots)
                match statement:
                    Ast::Stmt.VarDecl(name, _, _, _):
                        local_names.push(name)
                    Ast::Stmt.Assign(target, operator, _, _):
                        parser <- parser.validate_machine_assignment_target(target, operator, local_names, field_names, over_roots, mutated_roots, token)
                    Ast::Stmt.Block(_, _, _, body, _):
                        parser <- parser.validate_machine_arm_mutations(body, local_names, field_names, over_roots, mutated_roots, token)
                    _:
                        pass



        def validate_machine_transitions(parser: lmut Parser, states: darray[MachineStateAst], arms: darray[MachineArmAst], start_state: sview, start_args: darray[Ast::Expr], input_expression: Ast::Expr, condition: Ast::Expr, token: Token) -> void:
            parser <- parser.validate_machine_state_declarations(states, token)
            start_found: mutable bool = false
            if start_state == "":
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token)
                start_found <- true
            if start_state == "" and states.count > 0:
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if start_args.count != states[0].field_names.count
            for state in states |parser, start_found|:
                if state.name == start_state:
                    start_found <- true
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if start_args.count != state.field_names.count
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if not start_found
            for arm in arms |parser|:
                target_found: mutable bool = not arm.has_transition
                for state in states |parser, target_found|:
                    if arm.has_transition and state.name == arm.target:
                        target_found <- true
                        parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if arm.transition_args.count != state.field_names.count
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if not target_found

            # Preserve stage0's source-level mutation law without re-running the full
            # capture analysis here. The latter depends on the enclosing function's mutable
            # root context, which is not intact after stage0 include flattening; the refusal
            # itself is local to this machine and remains valid in the self-hosted parser.
            field_names: mutable darray[sview] = []
            collect_machine_state_field_names(field_names, states)

            over_roots: mutable darray[sview] = []
            machine_collect_roots(input_expression, over_roots)
            machine_collect_roots(condition, over_roots)
            mutated_roots: mutable darray[sview] = []
            collect_machine_statement_calls((Ast::Stmt.Expr(input_expression, Ast::pos_at_line(token.line))), over_roots, mutated_roots)
            collect_machine_statement_calls((Ast::Stmt.Expr(condition, Ast::pos_at_line(token.line))), over_roots, mutated_roots)
            for arm in arms |parser, over_roots, mutated_roots|:
                local_names: mutable darray[sview] = []
                if arm.input_bind != "":
                    local_names.push(arm.input_bind)
                append_machine_arm_header_locals(local_names, arm, states)

                parser <- parser.validate_machine_arm_mutations(arm.body, local_names, field_names, over_roots, mutated_roots, token)



        # docs/123 §5 per-state coverage, stage1-OWNED (docs/125 step 13). All three
        # refusals are parser-decidable (no types), 0-FP, and faithful to stage0's
        # parser/machine.go (~L518-561) — stage0 already accepts stage1's own machines and
        # runs these same checks, so a faithful port cannot regress self-hostable.

        # A payload list is unconditional when no element is a literal/predicate condition
        # (a condition is a non-wild, non-binding payload — mirrors machine_arm_condition).
        def machine_payloads_unconditional(arm: MachineArmAst&) -> bool:
            return not (any pat in arm.payloads where not pat.is_wild and pat.bind == "")



        # An arm matches EVERY input: an unguarded `_`/bind input with an unconditional
        # payload. Such an arm discharges a state's coverage.
        def machine_arm_irrefutable(arm: MachineArmAst&) -> bool:
            return arm.input_wild and machine_expr_is_invalid(arm.guard) and machine_payloads_unconditional(arm)



        # An open-domain (char/int/float/bool/string) input literal — a state carrying one can
        # never be exhaustive without a final `_`, and the parser proves it without types.
        def machine_expr_open_domain(expression: Ast::Expr) -> bool:
            return match expression:
                Ast::Expr.IntLit(value): true
                Ast::Expr.FloatLit(text): true
                Ast::Expr.CharLit(text): true
                Ast::Expr.BoolLit(value): true
                Ast::Expr.StringLit(text): true
                Ast::Expr.Unary(operator, operand, _): machine_expr_open_domain(operand)
                Ast::Expr.Paren(inner, _): machine_expr_open_domain(inner)
                _: false



        def machine_arm_open_domain(arm: MachineArmAst&) -> bool:
            return not arm.input_wild and (arm.input_ranges.count > 0 or (any literal in arm.input_literals where machine_expr_open_domain(literal)))



        # Exact literal equality for the per-state duplicate-input check (0-FP: fires only
        # when the SAME literal is handled twice, never on possibly-overlapping forms).
        def machine_literal_equal_core(a: Ast::Expr, b: Ast::Expr) -> bool:
            match a:
                Ast::Expr.IntLit(a_value):
                    match b:
                        Ast::Expr.IntLit(b_value):
                            return a_value == b_value
                        _:
                            return false
                Ast::Expr.FloatLit(a_text):
                    match b:
                        Ast::Expr.FloatLit(b_text):
                            return when_text_equal(a_text, b_text)
                        _:
                            return false
                Ast::Expr.CharLit(a_text):
                    match b:
                        Ast::Expr.CharLit(b_text):
                            return when_text_equal(a_text, b_text)
                        _:
                            return false
                Ast::Expr.StringLit(a_text):
                    match b:
                        Ast::Expr.StringLit(b_text):
                            return when_text_equal(a_text, b_text)
                        _:
                            return false
                Ast::Expr.BoolLit(a_value):
                    match b:
                        Ast::Expr.BoolLit(b_value):
                            return a_value == b_value
                        _:
                            return false
                Ast::Expr.Field(a_object, a_field, _):
                    match b:
                        Ast::Expr.Field(b_object, b_field, _):
                            return a_field == b_field and machine_type_expression_equal(a_object, b_object)
                        _:
                            return false
                Ast::Expr.ShorthandMember(a_parts, _):
                    match b:
                        Ast::Expr.ShorthandMember(b_parts, _):
                            return false if a_parts.count != b_parts.count
                            for index in 0..<a_parts.count:
                                return false if a_parts[index] != b_parts[index]
                            return true
                        _:
                            return false
                Ast::Expr.Unary(a_operator, a_operand, _):
                    match b:
                        Ast::Expr.Unary(b_operator, b_operand, _):
                            return a_operator == b_operator and machine_literal_equal_core(a_operand, b_operand)
                        _:
                            return false
                Ast::Expr.Paren(a_inner, _):
                    return match b:
                        Ast::Expr.Paren(b_inner, _): machine_literal_equal_core(a_inner, b_inner)
                        _: false
                _:
                    return false
            return false



        # Grouping parentheses do not change a literal's identity. Strip them before the
        # exact duplicate check so `(1.0)` and `1.0` (and the corresponding negative forms)
        # cannot evade the same unreachable-arm diagnostic.
        def machine_literal_equal(a: Ast::Expr, b: Ast::Expr) -> bool:
            match a:
                Ast::Expr.Paren(inner, _):
                    return machine_literal_equal(inner, b)
                _:
                    match b:
                        Ast::Expr.Paren(inner, _):
                            return machine_literal_equal(a, inner)
                        _:
                            return machine_literal_equal_core(a, b)



        # Per declared state: no arms is an error; an irrefutable arm before the last makes
        # the rest unreachable; an open-domain state with no irrefutable arm cannot be
        # total. Errors anchor at the machine head token.
        def check_machine_coverage(parser: lmut Parser, states: darray[MachineStateAst], arms: darray[MachineArmAst], machine_token: Token) -> void:
            state_index: mutable usize = 0
            while state_index < states.count |parser, state_index|:
                state_name: sview = states[state_index].name
                total_for_state: mutable usize = 0
                counting: mutable usize = 0
                while counting < arms.count |total_for_state, counting|:
                    total_for_state <- total_for_state + 1 if arms[counting].state_name == state_name
                    counting <- counting + 1
                has_wildcard: mutable bool = false
                has_open_domain: mutable bool = false
                seen: mutable usize = 0
                # Literal inputs already handled by an earlier unguarded, payload-
                # unconditional arm of this state — a repeat is unreachable (docs/123 §5).
                seen_literals: mutable darray[Ast::Expr] = []
                arm_index: mutable usize = 0
                while arm_index < arms.count |parser, has_wildcard, has_open_domain, seen, seen_literals, arm_index|:
                    if arms[arm_index].state_name == state_name:
                        seen <- seen + 1
                        if machine_arm_irrefutable(arms[arm_index]):
                            has_wildcard <- true
                            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, machine_token) if seen < total_for_state
                        has_open_domain <- true if machine_arm_open_domain(arms[arm_index])
                        # Only an unguarded, payload-unconditional arm claims exclusive
                        # coverage of a literal, so only those participate in the check.
                        if machine_expr_is_invalid(arms[arm_index].guard) and machine_payloads_unconditional(arms[arm_index]):
                            literal_index: mutable usize = 0
                            while literal_index < arms[arm_index].input_literals.count |parser, seen_literals, literal_index|:
                                literal: Ast::Expr = arms[arm_index].input_literals[literal_index]
                                duplicate: mutable bool = false
                                for previous in seen_literals:
                                    duplicate <- true if machine_literal_equal(previous, literal)
                                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, machine_token) if duplicate
                                seen_literals.push(literal) if not duplicate
                                literal_index <- literal_index + 1
                    arm_index <- arm_index + 1
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, machine_token) if total_for_state == 0
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, machine_token) if has_open_domain and not has_wildcard
                state_index <- state_index + 1



        # docs/125 §9 Tier-2: the classifier function name of a `machine over` input, or "" when
        # the input is not a bare free-function call (a method-call / literal input is open-domain,
        # already handled by the parser's per-state coverage check).
        def machine_input_callee(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, call_line):
                    return machine_expr_ident_name(callee)
                _:
                    return ""



        # The variant name of an enum tag input: either `Enum.Variant` (Field) or `.Variant`
        # (ShorthandMember), or "" for a literal/range/non-tag input.
        def machine_arm_variant_tag(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Field(object, field, field_line):
                    return field
                Ast::Expr.ShorthandMember(parts, _):
                    return parts[parts.count - 1] if parts.count > 0
                    return ""
                _:
                    return ""



        # Record MachineCoverageRow arm-atoms of a classifier-input machine (docs/125 §9 Tier-2):
        # one row per spelled variant tag + one wildcard-marker row per wildcard/bind arm.
        # Non-classifier inputs record nothing — open-domain totality is the parser's job.
        def record_machine_coverage(parser: lmut Parser, arms: darray[MachineArmAst], input_expression: Ast::Expr, line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                input_callee: sview = machine_input_callee(input_expression)
                return if input_callee == ""
                machine over parser.machine_coverage for arm in arms:
                    state Scan
                    start Scan

                    Scan, _ if arm.input_wild:
                        parser.machine_coverage <- parser.machine_coverage.push(Ast::MachineCoverageRow{input_callee: input_callee, state_name: arm.state_name, tag: "", has_wildcard: true, line: line})
                        -> Scan

                    Scan, _:
                        parser <- parser.record_machine_literal_coverage(arm, input_callee, line)
                        -> Scan



        def record_machine_literal_coverage(parser: lmut Parser, arm: MachineArmAst, input_callee: sview, line: u32) -> void:
            machine over parser.machine_coverage for literal in arm.input_literals:
                state Scan
                start Scan

                Scan, _ if machine_arm_variant_tag(literal) == "":
                    -> Scan

                Scan, _:
                    parser.machine_coverage <- parser.machine_coverage.push(Ast::MachineCoverageRow{input_callee: input_callee, state_name: arm.state_name, tag: machine_arm_variant_tag(literal), has_wildcard: false, line: line})
                    -> Scan
