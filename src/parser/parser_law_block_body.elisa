# Stage1 parser — the BLOCK-FORM law body: an indented run of `name = expr` local bindings
# followed by the law's own predicate. The bindings are substituted into that predicate here, so
# the later stages only ever see the flattened form. Continues parser_decl_law.elisa.

extend Parser:
    private:

            # Block-form law body: an indented sequence of `name = expr` local bindings followed by
            # a `return PRED`. Parse each RHS in contract context and inline bindings in declaration
            # order. The AST handles are immutable, so replacements may share their source nodes;
            # a Paren wrapper preserves the binding's precedence at every use site.
        def law_block_substitution_index(names: darray[sview]&, name: sview) -> usize:
            index: mutable usize = 0
            while index < names.count |index, names, name|:
                return index if names[index] == name
                index <- index + 1
            return names.count



        def law_block_name_bound(bound: darray[sview]&, name: sview) -> bool:
            for bound_name in bound:
                return true if bound_name == name
            return false



        def law_block_substitute_stmt(statement: Ast::Stmt, names: darray[sview]&, values: darray[Ast::Expr]&, bound: darray[sview]) -> Ast::Stmt:
            can Abort.Panic, Memory.Allocate:
                match statement:
                    Stmt.VarDecl(name, type_expression, value, line):
                        return (Ast::Stmt.VarDecl(name, law_block_substitute_expr(type_expression, names, values, bound), law_block_substitute_expr(value, names, values, bound), line))
                    Stmt.Assign(target, operator, value, line):
                        return (Ast::Stmt.Assign(target, operator, law_block_substitute_expr(value, names, values, bound), line))
                    Stmt.Return(value, line):
                        if value is returned:
                            return (Ast::Stmt.Return(law_block_substitute_expr(returned, names, values, bound), line))
                        return statement
                    Stmt.Expr(expression, line):
                        return (Ast::Stmt.Expr(law_block_substitute_expr(expression, names, values, bound), line))
                    _:
                        return statement



        def law_block_substitute_expr(expression: Ast::Expr, names: darray[sview]&, values: darray[Ast::Expr]&, bound: darray[sview]) -> Ast::Expr:
            can Abort.Panic, Memory.Allocate:
                match expression:
                    Expr.Ident(name, line):
                        replacement_index: usize = law_block_substitution_index(names, name)
                        return (Ast::Expr.Paren(values[replacement_index], line)) if replacement_index < names.count and not law_block_name_bound(bound, name)
                        return expression
                    Expr.Call(callee, arguments, argument_names, line):
                        substituted_arguments: mutable darray[Ast::Expr] = []
                        for argument in arguments |substituted_arguments, names, values, bound|:
                            substituted_arguments.push(law_block_substitute_expr(argument, names, values, bound))
                        return (Ast::Expr.Call(law_block_substitute_expr(callee, names, values, bound), substituted_arguments, argument_names, line))
                    Expr.Field(object, field, line):
                        return (Ast::Expr.Field(law_block_substitute_expr(object, names, values, bound), field, line))
                    Expr.Scope(base, member, line):
                        return (Ast::Expr.Scope(law_block_substitute_expr(base, names, values, bound), member, line))
                    Expr.Index(object, index, line):
                        return (Ast::Expr.Index(law_block_substitute_expr(object, names, values, bound), law_block_substitute_expr(index, names, values, bound), line))
                    Expr.Slice(object, low, high, line):
                        return (Ast::Expr.Slice(law_block_substitute_expr(object, names, values, bound), law_block_substitute_expr(low, names, values, bound), law_block_substitute_expr(high, names, values, bound), line))
                    Expr.IndexN(object, arguments, line):
                        substituted_index_arguments: mutable darray[Ast::Expr] = []
                        for index_argument in arguments |substituted_index_arguments, names, values, bound|:
                            substituted_index_arguments.push(law_block_substitute_expr(index_argument, names, values, bound))
                        return (Ast::Expr.IndexN(law_block_substitute_expr(object, names, values, bound), substituted_index_arguments, line))
                    Expr.Binary(left, operator, right, line):
                        return (Ast::Expr.Binary(law_block_substitute_expr(left, names, values, bound), operator, law_block_substitute_expr(right, names, values, bound), line))
                    Expr.Unary(operator, operand, line):
                        return (Ast::Expr.Unary(operator, law_block_substitute_expr(operand, names, values, bound), line))
                    Expr.Move(operand, line):
                        return (Ast::Expr.Move(law_block_substitute_expr(operand, names, values, bound), line))
                    Expr.RegionNew(operand, region, line):
                        return (Ast::Expr.RegionNew(law_block_substitute_expr(operand, names, values, bound), region, line))
                    Expr.Paren(inner, line):
                        return (Ast::Expr.Paren(law_block_substitute_expr(inner, names, values, bound), line))
                    Expr.Array(elements, line):
                        substituted_elements: mutable darray[Ast::Expr] = []
                        for element in elements |substituted_elements, names, values, bound|:
                            substituted_elements.push(law_block_substitute_expr(element, names, values, bound))
                        return (Ast::Expr.Array(substituted_elements, line))
                    Expr.Tuple(elements, line):
                        substituted_tuple: mutable darray[Ast::Expr] = []
                        for element_tuple in elements |substituted_tuple, names, values, bound|:
                            substituted_tuple.push(law_block_substitute_expr(element_tuple, names, values, bound))
                        return (Ast::Expr.Tuple(substituted_tuple, line))
                    Expr.SetLit(elements, line):
                        substituted_set: mutable darray[Ast::Expr] = []
                        for element_set in elements |substituted_set, names, values, bound|:
                            substituted_set.push(law_block_substitute_expr(element_set, names, values, bound))
                        return (Ast::Expr.SetLit(substituted_set, line))
                    Expr.DictLit(entries, line):
                        substituted_entries: mutable darray[Ast::DictEntry] = []
                        for entry in entries |substituted_entries, names, values, bound|:
                            substituted_entries.push(Ast::DictEntry{key: law_block_substitute_expr(entry.key, names, values, bound), value: law_block_substitute_expr(entry.value, names, values, bound)})
                        return (Ast::Expr.DictLit(substituted_entries, line))
                    Expr.Construct(type_expression, fields, line):
                        substituted_fields: mutable darray[Ast::FieldInit] = []
                        for field in fields |substituted_fields, names, values, bound|:
                            substituted_fields.push(Ast::FieldInit{name: field.name, value: law_block_substitute_expr(field.value, names, values, bound)})
                        return (Ast::Expr.Construct(law_block_substitute_expr(type_expression, names, values, bound), substituted_fields, line))
                    Expr.RecordUpdate(base, fields, line):
                        substituted_updates: mutable darray[Ast::FieldInit] = []
                        for update in fields |substituted_updates, names, values, bound|:
                            substituted_updates.push(Ast::FieldInit{name: update.name, value: law_block_substitute_expr(update.value, names, values, bound)})
                        return (Ast::Expr.RecordUpdate(law_block_substitute_expr(base, names, values, bound), substituted_updates, line))
                    Expr.If(condition, then_expression, else_expression, line):
                        return (Ast::Expr.If(law_block_substitute_expr(condition, names, values, bound), law_block_substitute_expr(then_expression, names, values, bound), law_block_substitute_expr(else_expression, names, values, bound), line))
                    Expr.Comprehension(variable, iterable, condition, body, line):
                        inner_bound: mutable darray[sview] = [bound_name for bound_name in bound]
                        inner_bound.push(variable)
                        return (Ast::Expr.Comprehension(variable, law_block_substitute_expr(iterable, names, values, bound), law_block_substitute_expr(condition, names, values, inner_bound), law_block_substitute_expr(body, names, values, inner_bound), line))
                    Expr.Refinement(base, predicate, line):
                        return (Ast::Expr.Refinement(law_block_substitute_expr(base, names, values, bound), law_block_substitute_expr(predicate, names, values, bound), line))
                    Expr.Block(statements, value, captures, line):
                        block_bound: mutable darray[sview] = [bound_name for bound_name in bound]
                        substituted_statements: mutable darray[Ast::Stmt] = []
                        for block_statement in statements |substituted_statements, block_bound, names, values|:
                            substituted_statements.push(law_block_substitute_stmt(block_statement, names, values, block_bound))
                            match block_statement:
                                Stmt.VarDecl(local_name, _, _, _):
                                    block_bound.push(local_name)
                                _:
                                    pass
                        return (Ast::Expr.Block(substituted_statements, law_block_substitute_expr(value, names, values, block_bound), captures, line))
                    Expr.Lambda(parameters, body, line):
                        lambda_bound: mutable darray[sview] = [bound_name for bound_name in bound]
                        lambda_bound.extend(parameters)
                        substituted_body: mutable darray[Ast::Stmt] = []
                        for lambda_statement in body |substituted_body, names, values, lambda_bound|:
                            substituted_body.push(law_block_substitute_stmt(lambda_statement, names, values, lambda_bound))
                        return (Ast::Expr.Lambda(parameters, substituted_body, line))
                    _:
                        return expression



        def law_block_binding(parser: lmut Parser, names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&) -> void:
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            name: sview = Lexer::text_or_empty(name_token, parser.source)
            parser, _ <- parser.expect(TokenKind.Assign)
            rebind raw_value: Ast::Expr, parser = parser.contract_expression()
            resolved_value: Ast::Expr = law_block_substitute_expr(raw_value, names, values, [])
            names.push(name)
            values.push(resolved_value)



        def law_block_return(parser: lmut Parser) -> void:
            parser, _ <- parser.advance()
            rebind parsed_return: Ast::Expr, parser = parser.contract_expression()
            parser.captured_law_return <- parsed_return



        def law_block_return_ahead(parser: Parser&) -> bool:
            return true if parser.peek() == TokenKind.Return
            return false if parser.peek() != TokenKind.Ident
            current: Token = parser.cursor()
            return Lexer::text_or_empty(current, parser.source) == "return"



        def law_block_body(parser: lmut Parser) -> Ast::Expr:
            can Abort.Panic, Memory.Allocate:
                parser, _ <- parser.accept(TokenKind.Newline)
                parser, _ <- parser.expect(TokenKind.Indent)
                binding_names: mutable darray[sview] = []
                binding_values: mutable darray[Ast::Expr] = []
                parser.captured_law_return <- (Ast::Expr.Invalid)
                # Keep the block traversal as a machine. The predicate is stored in the
                # parser's threaded state by `law_block_return`; the machine payload remains
                # the expression being threaded between lines. This avoids the old captured
                # mutable local while preserving the machine's explicit data flow.
                machine over parser.position while true:
                    state Line(result: Ast::Expr)
                    state Inspect(result: Ast::Expr)
                    state End(result: Ast::Expr)
                    start Line((Ast::Expr.Invalid))

                    Line(result), _:
                        parser <- parser.skip_newlines()
                        -> Inspect(result)

                    Inspect(result), _ if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof:
                        -> End(result)

                    Inspect(_), _ if parser.law_block_return_ahead():
                        parser <- parser.law_block_return()
                        -> Line(parser.captured_law_return)

                    Inspect(result), _:
                        parser <- parser.law_block_binding(&binding_names, &binding_values)
                        -> Line(result)

                    End(result), _ if parser.peek() == TokenKind.Dedent:
                        parser.position <- parser.position + 1
                        return law_block_substitute_expr(result, binding_names, binding_values, [])

                    End(result), _:
                        return law_block_substitute_expr(result, binding_names, binding_values, [])
                return (Ast::Expr.Invalid)
