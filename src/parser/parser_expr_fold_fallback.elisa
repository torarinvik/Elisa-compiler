# Stage0 falls back to the scalar fold when any transform subtree cannot be
# cloned. Recognize shapes that Stage0's AST cloner deliberately declines.
extend Parser:
    private:
        def fold_stage0_uncloneable(value: Ast::Expr, depth: u32 = 0) -> bool:
            can Abort.Panic:
                return false if depth >= 2048
                match value:
                    Ast::Expr.Construct(_, _, _) | Ast::Expr.RecordUpdate(_, _, _) | Ast::Expr.Match(_, _, _) | Ast::Expr.Block(_, _, _, _) | Ast::Expr.Lambda(_, _, _) | Ast::Expr.Comprehension(_, _, _, _, _, _):
                        return true
                    Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _):
                        return fold_stage0_uncloneable(inner, depth + 1)
                    Ast::Expr.Field(inner, _, _) | Ast::Expr.Scope(inner, _, _):
                        return fold_stage0_uncloneable(inner, depth + 1)
                    Ast::Expr.Binary(left, _, right, _) | Ast::Expr.Index(left, right, _):
                        return fold_stage0_uncloneable(left, depth + 1) or fold_stage0_uncloneable(right, depth + 1)
                    Ast::Expr.If(condition, yes, no, _):
                        return fold_stage0_uncloneable(condition, depth + 1) or fold_stage0_uncloneable(yes, depth + 1) or fold_stage0_uncloneable(no, depth + 1)
                    Ast::Expr.Slice(object, low, high, _):
                        return fold_stage0_uncloneable(object, depth + 1) or fold_stage0_uncloneable(low, depth + 1) or fold_stage0_uncloneable(high, depth + 1)
                    Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                        for element in elements:
                            return true if fold_stage0_uncloneable(element, depth + 1)
                        return false
                    Ast::Expr.DictLit(entries, _):
                        for entry in entries:
                            return true if fold_stage0_uncloneable(entry.key, depth + 1) or fold_stage0_uncloneable(entry.value, depth + 1)
                        return false
                    Ast::Expr.Call(callee, arguments, _, _):
                        return true if fold_stage0_uncloneable(callee, depth + 1)
                        for argument in arguments:
                            return true if fold_stage0_uncloneable(argument, depth + 1)
                        return false
                    Ast::Expr.IndexN(object, arguments, _):
                        return true if fold_stage0_uncloneable(object, depth + 1)
                        for argument in arguments:
                            return true if fold_stage0_uncloneable(argument, depth + 1)
                        return false
                    _:
                        return false
