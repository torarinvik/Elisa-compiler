extend Parser:
    private:
        def primary_expression(parser: lmut Parser) -> Ast::Expr?:
            can Memory.Allocate, Abort.Panic:
                kind: TokenKind = parser.peek()
                token: Token = parser.cursor()
                no_expr: Ast::Expr? = null

                # Dispatch by explicit alternatives so recursive AST-producing parser calls
                # do not have to pass through a value-match lowering path in the stage1 backend.
                if kind == TokenKind.Match:
                        # Expression-form `match EXPR: ...` (e.g. `return match x:` / `y = match x:`).
                        # Statement-position `match` is routed to match_statement by the statement
                        # dispatcher first; this handles `match` nested in an expression. Reuses
                        # the shared arm-block parser; arms carry statement bodies (as in the
                        # statement form), which the resolver's Expr.Match walker already handles.
                        rebind match_token: Token, parser = parser.advance()        # `match`
                        rebind match_scrutinee: Ast::Expr, parser = get parser.expression() can Global{Read,Write}
                        rebind accepted_as: bool, parser = parser.accept(TokenKind.As)
                        parser, _ <- parser.expect(TokenKind.Ident) if accepted_as
                        previous_match_value_block: bool = parser.in_value_block
                        parser.in_value_block <- true
                        rebind match_arms: darray[Ast::MatchArm], parser = parser.parse_arm_block() can Global{Read,Write}
                        parser.in_value_block <- previous_match_value_block
                        return (Ast::Expr.Match(match_scrutinee, match_arms, Ast::pos_of_token(match_token)))

                    # Decode literals in a small dispatch helper so the primary parser's
                    # control-flow body stays within stage1's lowering envelope.
                if kind == TokenKind.IntLit or kind == TokenKind.HexLit or kind == TokenKind.FloatLit or kind == TokenKind.CharLit or kind == TokenKind.StringLit or kind == TokenKind.FString:
                        rebind literal: Ast::Expr?, parser = parser.primary_literal(kind, token) can Global{Read,Write}
                        return literal

                if kind == TokenKind.Ident:
                    rebind identifier: Ast::Expr?, parser = parser.primary_identifier(token) can Global{Read,Write}
                    return identifier
                rebind keyword_expression: Ast::Expr?, parser = parser.primary_keyword_expression(kind, token) can Global{Read,Write}, Memory.Allocate
                return keyword_expression
            # Record a `new`-form construction line (see the TokenKind.New primary arm).
        def record_new_construct(parser: lmut Parser, line: u32) -> void:
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__new_construct", name: "__new_construct", line: line})

        def catch_callee_name(parser: Parser&, expression: Ast::Expr) -> sview:
            can Abort.Panic:
                match expression:
                    Expr.Paren(inner, _):
                        return parser.catch_callee_name(inner)
                    Expr.Call(callee, arguments, argument_names, line):
                        return match callee:
                            Expr.Ident(name, ident_line): name
                            Expr.Scope(scope_base, name, scope_line): name
                            _: ""
                    _:
                        return ""
