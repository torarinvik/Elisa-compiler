# Stage1 parser — `law` and `refine` declarations (`extend Parser: private:`). Covers the
# law header (subject type, params, clause items), the frame and effect law forms, the
# law block body, and refinement declarations. Continues parser_decl_impl.elisa; split
# out to keep each part file under 600 lines.

extend Parser:
    private:
        # `law Name(params) = <predicate>` algebraic/refinement law. Skip the header
        # parameter list to its top-level `=`, then parse the predicate through the normal
        # expression parser so quantifiers and operators remain structured.
        # Capture an effect/composite law's clause (`forbids E1, E2` / `includes A, B`) as
        # per-item annotations keyed by the law name: forbids → sentinel 3900000022,
        # includes → 3900000023. A leading `__effect_law_decl` marker (3900000024) records
        # the law's existence so the fulfillment check can classify it. Returns the Law node.
        # Capture the comma-separated dotted items of a `forbids`/`includes` clause under
        # `sentinel`, keyed by the law name.
        def capture_law_clause_items(parser: lmut Parser, law_name: sview, sentinel: u32) -> void:
            machine over parser.position while true:
                state More
                state Separator
                start More

                More, _ if parser.peek() != TokenKind.Ident:
                    break

                More, _:
                    parser <- parser.capture_law_clause_item(law_name, sentinel)
                    -> Separator

                Separator, _ if parser.peek() == TokenKind.Comma:
                    parser.position <- parser.position + 1
                    -> More

                Separator, _:
                    break

        def capture_law_clause_item(parser: lmut Parser, law_name: sview, sentinel: u32) -> void:
            rebind item_name: sview, parser = parser.parse_dotted_name()
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: law_name, name: item_name, line: sentinel}) if item_name != ""

        # If the cursor is on a law's `(params)` header, consume it (so the following
        # `changes`/`preserves`/`=` can be inspected). Returns whether the params contain a
        # `&` (a reference `self`) — a `changes`/`preserves` frame law needs one.
        # Non-destructive: whether the law's `(params)` header (at the current cursor) names at
        # least one parameter — a `self`/value subject. `()` or a missing header means none.
        def law_header_has_subject(parser: Parser&) -> bool:
            can Abort.Panic:
                offset: mutable usize = 0
                # Skip a leading generic-parameter group `[...]` (`law Name[T](self: T)`), so the
                # `(params)` header is found even on a generic law.
                if parser.peek_at(offset) == TokenKind.LBracket:
                    offset <- 1
                    machine over offset while true:
                        state Scan(depth: int)
                        start Scan(1)

                        Scan(depth), _ if depth <= 0 or parser.peek_at(offset) == TokenKind.Eof:
                            break

                        Scan(depth), _ if parser.peek_at(offset) == TokenKind.LBracket:
                            offset <- offset + 1
                            -> Scan(depth + 1)

                        Scan(depth), _ if parser.peek_at(offset) == TokenKind.RBracket:
                            offset <- offset + 1
                            -> Scan(depth - 1)

                        Scan(depth), _:
                            offset <- offset + 1
                            -> Scan(depth)
                false return if parser.peek_at(offset) != TokenKind.LParen
                offset <- offset + 1
                found: mutable bool = false
                machine over found while true:
                    state Scan(offset: usize, depth: int)
                    start Scan(offset, 1)

                    Scan(offset, depth), _ if depth <= 0 or parser.peek_at(offset) == TokenKind.Eof:
                        break

                    Scan(offset, depth), _ if parser.peek_at(offset) == TokenKind.LParen:
                        -> Scan(offset + 1, depth + 1)

                    Scan(offset, depth), _ if parser.peek_at(offset) == TokenKind.RParen:
                        -> Scan(offset + 1, depth - 1)

                    Scan(offset, depth), _ if parser.peek_at(offset) == TokenKind.Ident and depth >= 1:
                        found <- true
                        -> Scan(offset + 1, depth)

                    Scan(offset, depth), _:
                        -> Scan(offset + 1, depth)
                return found

        # Non-destructive: the SUBJECT type name of a law header — the type of the first parameter
        # (`law N(self: i64, …)` -> "i64"), i.e. the first identifier after the first `:`. "" when
        # there is no header/parameter. Looks through a leading generic `[…]` group.
        def law_header_subject_type(parser: Parser&) -> sview:
            can Abort.Panic:
                offset: mutable usize = 0
                if parser.peek_at(offset) == TokenKind.LBracket:
                    offset <- 1
                    machine over offset while true:
                        state Scan(depth: int)
                        start Scan(1)

                        Scan(depth), _ if depth <= 0 or parser.peek_at(offset) == TokenKind.Eof:
                            break

                        Scan(depth), _ if parser.peek_at(offset) == TokenKind.LBracket:
                            offset <- offset + 1
                            -> Scan(depth + 1)

                        Scan(depth), _ if parser.peek_at(offset) == TokenKind.RBracket:
                            offset <- offset + 1
                            -> Scan(depth - 1)

                        Scan(depth), _:
                            offset <- offset + 1
                            -> Scan(depth)
                sview("", 0, 0) return if parser.peek_at(offset) != TokenKind.LParen
                offset <- offset + 1
                result: mutable sview = sview("", 0, 0)
                machine over result while true:
                    state Scan(offset: usize, saw_colon: bool)
                    start Scan(offset, false)

                    Scan(offset, _), _ if parser.peek_at(offset) == TokenKind.RParen or parser.peek_at(offset) == TokenKind.Eof:
                        break

                    Scan(offset, _), _ if parser.peek_at(offset) == TokenKind.Colon:
                        -> Scan(offset + 1, true)

                    Scan(offset, true), _ if parser.peek_at(offset) == TokenKind.Ident and result == "":
                        result <- Lexer::text_or_empty(parser.tokens[parser.position + offset], parser.source)
                        -> Scan(offset + 1, true)

                    Scan(offset, saw_colon), _:
                        -> Scan(offset + 1, saw_colon)
                return result

        # Capture a value law's `(name: TYPE, ...)` header as ParamDecls. The predicate law
        # IS a callable in stage0 — `law InRange(self: u32, lo: u32, hi: u32) = ...` exports
        # `_InRange` — but stage1 only ever SKIPPED this header, so no signature survived and
        # no function was emitted. Types are captured as bare name Idents, which is what a
        # law's scalar parameters are in practice.
        def capture_law_params(parser: lmut Parser, law_name: sview, out: mutable darray[Ast::ParamDecl]&) -> void:
            return if parser.peek() != TokenKind.LParen
            parser, _ <- parser.advance()                               # `(`
            # The machine must keep executing after a transition lands on `)` so the
            # `Skip -> Store` edge records the final parameter. The loop's boundary is
            # therefore an explicit terminal arm, not the machine guard: a guard is checked
            # before the next state runs and would otherwise stop before `Store`.
            machine over parser.position while true:
                state Scan
                state Colon(name_token: Token, param_name: sview)
                state Type(name_token: Token, param_name: sview)
                state Skip(name_token: Token, param_name: sview, type_name: sview)
                state Store(name_token: Token, param_name: sview, type_name: sview)
                state Separator
                start Scan

                Scan, _ if parser.peek() == TokenKind.RParen or parser.peek() == TokenKind.Eof:
                    break

                Scan, _ if parser.peek() != TokenKind.Ident:
                    parser.position <- parser.position + 1
                    -> Scan

                Scan, _:
                    parsed_name_token: Token = parser.cursor()
                    parser.position <- parser.position + 1
                    -> Colon(parsed_name_token, Lexer::text_or_empty(parsed_name_token, parser.source))

                Colon(name_token, param_name), _ if parser.peek() == TokenKind.Colon:
                    parser.position <- parser.position + 1
                    -> Type(name_token, param_name)

                Colon(name_token, param_name), _:
                    -> Skip(name_token, param_name, sview("", 0, 0))

                Type(name_token, param_name), _ if parser.peek() == TokenKind.Ident:
                    type_token: Token = parser.cursor()
                    parser.position <- parser.position + 1
                    -> Skip(name_token, param_name, Lexer::text_or_empty(type_token, parser.source))

                Type(name_token, param_name), _:
                    -> Skip(name_token, param_name, sview("", 0, 0))

                Skip(name_token, param_name, type_name), _ if parser.peek() == TokenKind.Comma or parser.peek() == TokenKind.RParen or parser.peek() == TokenKind.Eof:
                    -> Store(name_token, param_name, type_name)

                Skip(name_token, param_name, type_name), _:
                    parser.position <- parser.position + 1
                    -> Skip(name_token, param_name, type_name)

                Store(name_token, param_name, type_name), _ if param_name != "" and type_name != "":
                    parser <- parser.append_law_param(out, law_name, name_token, param_name, type_name)
                    -> Separator

                Store(_, _, _), _:
                    -> Separator

                Separator, _ if parser.peek() == TokenKind.Comma:
                    parser.position <- parser.position + 1
                    -> Scan

                Separator, _:
                    break
            parser, _ <- parser.accept(TokenKind.RParen)

        def append_law_param(parser: lmut Parser, out: mutable darray[Ast::ParamDecl]&, law_name: sview, name_token: Token, param_name: sview, type_name: sview) -> void:
            out.push(Ast::ParamDecl{name: param_name, type_expression: (Ast::Expr.Ident(type_name, Ast::pos_of_token(name_token))), is_mutable: false, has_default: false, default_value: (Ast::Expr.Absent)})
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: law_name, name: param_name, line: 3900000034})


        def skip_law_params(parser: lmut Parser) -> bool:
            false return if parser.peek() != TokenKind.LParen
            parser, _ <- parser.advance()                               # `(`
            machine over parser.position while true:
                state Scan(depth: int, saw_ref: bool)
                start Scan(1, false)

                Scan(depth, saw_ref), _ if depth <= 0 or parser.peek() == TokenKind.Eof:
                    return saw_ref

                Scan(depth, _), _ if parser.peek() == TokenKind.Ampersand:
                    parser.position <- parser.position + 1
                    -> Scan(depth, true)

                Scan(depth, saw_ref), _ if parser.peek() == TokenKind.LParen:
                    parser.position <- parser.position + 1
                    -> Scan(depth + 1, saw_ref)

                Scan(depth, saw_ref), _ if parser.peek() == TokenKind.RParen:
                    parser.position <- parser.position + 1
                    -> Scan(depth - 1, saw_ref)

                Scan(depth, saw_ref), _:
                    parser.position <- parser.position + 1
                    -> Scan(depth, saw_ref)
            return false

        # Capture the comma-separated `self.FIELD` items of a frame law's `changes`/`preserves`
        # clause under sentinel 3900000028, keyed by the law name.
        def capture_frame_law_fields(parser: lmut Parser, law_name: sview) -> void:
            machine over parser.position while true:
                state More
                state Separator
                start More

                More, _ if parser.peek() != TokenKind.Ident:
                    break

                More, _:
                    parser <- parser.capture_frame_law_field(law_name)
                    -> Separator

                Separator, _ if parser.peek() == TokenKind.Comma:
                    parser.position <- parser.position + 1
                    -> More

                Separator, _:
                    break

        def capture_frame_law_field(parser: lmut Parser, law_name: sview) -> void:
            parser.position <- parser.position + 1                           # `self`
            rebind had_dot: bool, parser = parser.accept(TokenKind.Dot)
            field_token: Token = parser.cursor()
            parser <- parser.record_frame_law_field(law_name, field_token) if had_dot and parser.peek() == TokenKind.Ident
            parser <- parser.advance_when(had_dot and parser.peek() == TokenKind.Ident)   # `FIELD`

        def record_frame_law_field(parser: lmut Parser, law_name: sview, field_token: Token) -> void:
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: law_name, name: Lexer::text_or_empty(field_token, parser.source), line: 3900000028})

        # A frame law `law N(params) changes|preserves self.F, ...`: record the frame-law kind
        # (sentinel 3900000027) and its field set, entered on the `changes`/`preserves` keyword.
        def law_frame_declaration(parser: lmut Parser, law_name: sview, clause: sview, self_is_ref: bool, line: u32) -> Ast::Decl?:
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: law_name, name: clause, line: 3900000027})
            # A frame law whose `self` is not a reference cannot reach the caller — record it
            # (sentinel 3900000031) so the check can flag `changes`/`preserves` with no effect.
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: law_name, name: clause, line: 3900000031}) if not self_is_ref
            parser, _ <- parser.advance()                               # `changes`/`preserves`
            parser <- parser.capture_frame_law_fields(law_name)
            return (Ast::Decl.Law(law_name, (Ast::Expr.Absent), Ast::pos_at_line(line)))

        def law_effect_declaration(parser: lmut Parser, law_name: sview, clause: sview, line: u32) -> Ast::Decl?:
            sentinel: u32 = 3900000022 if clause == "forbids" else 3900000023
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: law_name, name: clause, line: 3900000024})
            parser, _ <- parser.advance()                               # the clause keyword (`forbids`/`includes`)
            parser <- parser.capture_law_clause_items(law_name, sentinel)
            return (Ast::Decl.Law(law_name, (Ast::Expr.Absent), Ast::pos_at_line(line)))

        def law_declaration(parser: lmut Parser) -> Ast::Decl?:
            can Abort.Panic:
                rebind token: Token, parser = parser.advance()              # consume the `law` identifier
                rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
                # Effect/composite law forms (`law N forbids E` / `law N includes A, B`) have no
                # `=` predicate; capture the clause and return before the predicate scan.
                clause_token: Token = parser.cursor()
                clause_text: sview = Lexer::text_or_empty(clause_token, parser.source) if parser.peek() == TokenKind.Ident else sview("", 0, 0)
                law_name_text: sview = Lexer::text_or_empty(name_token, parser.source)
                # A value/predicate law needs at least one value parameter (a subject); checked here
                # while the cursor still sits at the `(params)` header, recorded for the semantic layer.
                law_has_subject: bool = parser.law_header_has_subject()
                law_subject_type: sview = parser.law_header_subject_type()
                if clause_text == "forbids" or clause_text == "includes":
                    rebind effect_decl: Ast::Decl?, parser = parser.law_effect_declaration(law_name_text, clause_text, token.line)
                    return effect_decl
                # Frame-law form `law N(params) changes|preserves self.F, ...`: look past the
                # `(params)` header (non-destructively) for a `changes`/`preserves` clause.
                frame_saved: usize = parser.position
                rebind self_is_ref: bool, parser = parser.skip_law_params()
                frame_clause_token: Token = parser.cursor()
                frame_clause: sview = Lexer::text_or_empty(frame_clause_token, parser.source) if parser.peek() == TokenKind.Ident else sview("", 0, 0)
                if frame_clause == "changes" or frame_clause == "preserves":
                    rebind frame_decl: Ast::Decl?, parser = parser.law_frame_declaration(law_name_text, frame_clause, self_is_ref, token.line)
                    return frame_decl
                parser.position <- frame_saved
                law_params: mutable darray[Ast::ParamDecl] = []
                law_params_saved: usize = parser.position
                parser <- parser.capture_law_params(law_name_text, &law_params)
                parser.position <- law_params_saved
                # Scan the header (name + optional `(params)`), stopping at the inline `=` or the
                # newline that introduces a block body. A `:` at bracket depth 0 marks the block
                # form `law N(params):` <NEWLINE> <INDENT> bindings... `return PRED`.
                saw_colon: mutable bool = false
                depth: mutable int = 0
                while parser.peek() != TokenKind.Assign and parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Eof |parser, saw_colon, depth|:
                    kind: TokenKind = parser.peek()
                    depth <- depth + 1 if kind == TokenKind.LParen or kind == TokenKind.LBracket or kind == TokenKind.LBrace
                    depth <- depth - 1 if kind == TokenKind.RParen or kind == TokenKind.RBracket or kind == TokenKind.RBrace
                    saw_colon <- true if kind == TokenKind.Colon and depth == 0
                    parser, _ <- parser.advance()
                # A predicate/block law (`law N(...) = pred` or `law N(...):` block) is a VALUE
                # law — mark it (sentinel 3900000025) so the composite-`includes` check can reject
                # composing one.
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: law_name_text, name: "", line: 3900000025})
                # Sentinel 3900000032: a value/predicate law declared with no subject parameter.
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: law_name_text, name: "", line: 3900000032}) if not law_has_subject
                # Sentinel 3900000033: the law's subject (first parameter) type name.
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: law_name_text, name: law_subject_type, line: 3900000033}) if law_subject_type != ""
                if saw_colon:
                    rebind block_predicate: Ast::Expr, parser = parser.law_block_body()
                    # Block laws are callable predicate declarations too. Keep the Law node
                    # for refinement lookup and queue the bool-returning callable, exactly as
                    # the inline `= predicate` form does below.
                    law_body: mutable darray[Ast::Stmt] = []
                    law_effects: mutable darray[sview] = []
                    law_decorators: mutable darray[Ast::Annotation] = []
                    law_body.push((Ast::Stmt.Return(block_predicate, Ast::pos_of_token(token))))
                    parser.pending_decls <- parser.pending_decls.push((Ast::Decl.Func(law_name_text, law_params, (Ast::Expr.Ident("bool", Ast::pos_of_token(token))), law_body, law_effects, law_decorators, Ast::pos_of_token(token)))) if law_params.count > 0
                    return (Ast::Decl.Law(Lexer::text_or_empty(name_token, parser.source), block_predicate, Ast::pos_of_token(token)))
                parser, _ <- parser.accept(TokenKind.Assign)
                # The predicate is a contract expression — it may lead with an unbounded
                # `forall/exists VAR: PRED` quantifier and use the `implies`/`=>` infix, none of
                # which the ordinary expression parser recognizes (`law N(...) = forall k: ...`).
                rebind predicate: Ast::Expr, parser = parser.contract_expression()
                # Synthesize the law's CALLABLE. stage0 emits a predicate law as a real
                # function (`_InRange`); stage1 emitted nothing, so four corpus files were
                # missing that symbol. Routing it through `pending_decls` as an ordinary
                # `Decl.Func` reuses the whole existing declaration/emission/mangling path
                # rather than adding a second way to define a function.
                #
                # The Law node is still returned: refined aliases (`type L = u32 is
                # InRange[0, 3]`) resolve through it, so this ADDS the callable rather than
                # replacing the law.
                law_body: mutable darray[Ast::Stmt] = []
                law_effects: mutable darray[sview] = []
                law_decorators: mutable darray[Ast::Annotation] = []
                law_body.push((Ast::Stmt.Return(predicate, Ast::pos_of_token(token))))
                parser.pending_decls <- parser.pending_decls.push((Ast::Decl.Func(law_name_text, law_params, (Ast::Expr.Ident("bool", Ast::pos_of_token(token))), law_body, law_effects, law_decorators, Ast::pos_of_token(token)))) if law_params.count > 0
                return (Ast::Decl.Law(Lexer::text_or_empty(name_token, parser.source), predicate, Ast::pos_of_token(token)))

            # Block-form law body: an indented sequence of `name = expr` local bindings followed by
            # a `return PRED`. Parse each RHS in contract context and inline bindings in declaration
            # order. The AST handles are immutable, so replacements may share their source nodes;
            # a Paren wrapper preserves the binding's precedence at every use site.
        def law_block_substitution_index(names: darray[sview]&, name: sview) -> usize:
            index: mutable usize = 0
            while index < names.count |index, names, name|:
                return index if names[index] == name
                index <- index + 1
            return names.count

        def law_block_name_bound(bound: darray[sview]&, name: sview) -> bool:
            for bound_name in bound:
                return true if bound_name == name
            return false

        def law_block_substitute_stmt(statement: Ast::Stmt, names: darray[sview]&, values: darray[Ast::Expr]&, bound: darray[sview]) -> Ast::Stmt:
            can Abort.Panic, Memory.Allocate:
                match statement:
                    Stmt.VarDecl(name, type_expression, value, line):
                        return (Ast::Stmt.VarDecl(name, law_block_substitute_expr(type_expression, names, values, bound), law_block_substitute_expr(value, names, values, bound), line))
                    Stmt.Assign(target, operator, value, line):
                        return (Ast::Stmt.Assign(target, operator, law_block_substitute_expr(value, names, values, bound), line))
                    Stmt.Return(value, line):
                        if value is returned:
                            return (Ast::Stmt.Return(law_block_substitute_expr(returned, names, values, bound), line))
                        return statement
                    Stmt.Expr(expression, line):
                        return (Ast::Stmt.Expr(law_block_substitute_expr(expression, names, values, bound), line))
                    _:
                        return statement

        def law_block_substitute_expr(expression: Ast::Expr, names: darray[sview]&, values: darray[Ast::Expr]&, bound: darray[sview]) -> Ast::Expr:
            can Abort.Panic, Memory.Allocate:
                match expression:
                    Expr.Ident(name, line):
                        replacement_index: usize = law_block_substitution_index(names, name)
                        return (Ast::Expr.Paren(values[replacement_index], line)) if replacement_index < names.count and not law_block_name_bound(bound, name)
                        return expression
                    Expr.Call(callee, arguments, argument_names, line):
                        substituted_arguments: mutable darray[Ast::Expr] = []
                        for argument in arguments |substituted_arguments, names, values, bound|:
                            substituted_arguments.push(law_block_substitute_expr(argument, names, values, bound))
                        return (Ast::Expr.Call(law_block_substitute_expr(callee, names, values, bound), substituted_arguments, argument_names, line))
                    Expr.Field(object, field, line):
                        return (Ast::Expr.Field(law_block_substitute_expr(object, names, values, bound), field, line))
                    Expr.Scope(base, member, line):
                        return (Ast::Expr.Scope(law_block_substitute_expr(base, names, values, bound), member, line))
                    Expr.Index(object, index, line):
                        return (Ast::Expr.Index(law_block_substitute_expr(object, names, values, bound), law_block_substitute_expr(index, names, values, bound), line))
                    Expr.Slice(object, low, high, line):
                        return (Ast::Expr.Slice(law_block_substitute_expr(object, names, values, bound), law_block_substitute_expr(low, names, values, bound), law_block_substitute_expr(high, names, values, bound), line))
                    Expr.IndexN(object, arguments, line):
                        substituted_index_arguments: mutable darray[Ast::Expr] = []
                        for index_argument in arguments |substituted_index_arguments, names, values, bound|:
                            substituted_index_arguments.push(law_block_substitute_expr(index_argument, names, values, bound))
                        return (Ast::Expr.IndexN(law_block_substitute_expr(object, names, values, bound), substituted_index_arguments, line))
                    Expr.Binary(left, operator, right, line):
                        return (Ast::Expr.Binary(law_block_substitute_expr(left, names, values, bound), operator, law_block_substitute_expr(right, names, values, bound), line))
                    Expr.Unary(operator, operand, line):
                        return (Ast::Expr.Unary(operator, law_block_substitute_expr(operand, names, values, bound), line))
                    Expr.Move(operand, line):
                        return (Ast::Expr.Move(law_block_substitute_expr(operand, names, values, bound), line))
                    Expr.RegionNew(operand, region, line):
                        return (Ast::Expr.RegionNew(law_block_substitute_expr(operand, names, values, bound), region, line))
                    Expr.Paren(inner, line):
                        return (Ast::Expr.Paren(law_block_substitute_expr(inner, names, values, bound), line))
                    Expr.Array(elements, line):
                        substituted_elements: mutable darray[Ast::Expr] = []
                        for element in elements |substituted_elements, names, values, bound|:
                            substituted_elements.push(law_block_substitute_expr(element, names, values, bound))
                        return (Ast::Expr.Array(substituted_elements, line))
                    Expr.Tuple(elements, line):
                        substituted_tuple: mutable darray[Ast::Expr] = []
                        for element_tuple in elements |substituted_tuple, names, values, bound|:
                            substituted_tuple.push(law_block_substitute_expr(element_tuple, names, values, bound))
                        return (Ast::Expr.Tuple(substituted_tuple, line))
                    Expr.SetLit(elements, line):
                        substituted_set: mutable darray[Ast::Expr] = []
                        for element_set in elements |substituted_set, names, values, bound|:
                            substituted_set.push(law_block_substitute_expr(element_set, names, values, bound))
                        return (Ast::Expr.SetLit(substituted_set, line))
                    Expr.DictLit(entries, line):
                        substituted_entries: mutable darray[Ast::DictEntry] = []
                        for entry in entries |substituted_entries, names, values, bound|:
                            substituted_entries.push(Ast::DictEntry{key: law_block_substitute_expr(entry.key, names, values, bound), value: law_block_substitute_expr(entry.value, names, values, bound)})
                        return (Ast::Expr.DictLit(substituted_entries, line))
                    Expr.Construct(type_expression, fields, line):
                        substituted_fields: mutable darray[Ast::FieldInit] = []
                        for field in fields |substituted_fields, names, values, bound|:
                            substituted_fields.push(Ast::FieldInit{name: field.name, value: law_block_substitute_expr(field.value, names, values, bound)})
                        return (Ast::Expr.Construct(law_block_substitute_expr(type_expression, names, values, bound), substituted_fields, line))
                    Expr.RecordUpdate(base, fields, line):
                        substituted_updates: mutable darray[Ast::FieldInit] = []
                        for update in fields |substituted_updates, names, values, bound|:
                            substituted_updates.push(Ast::FieldInit{name: update.name, value: law_block_substitute_expr(update.value, names, values, bound)})
                        return (Ast::Expr.RecordUpdate(law_block_substitute_expr(base, names, values, bound), substituted_updates, line))
                    Expr.If(condition, then_expression, else_expression, line):
                        return (Ast::Expr.If(law_block_substitute_expr(condition, names, values, bound), law_block_substitute_expr(then_expression, names, values, bound), law_block_substitute_expr(else_expression, names, values, bound), line))
                    Expr.Comprehension(variable, iterable, condition, body, line):
                        inner_bound: mutable darray[sview] = [bound_name for bound_name in bound]
                        inner_bound.push(variable)
                        return (Ast::Expr.Comprehension(variable, law_block_substitute_expr(iterable, names, values, bound), law_block_substitute_expr(condition, names, values, inner_bound), law_block_substitute_expr(body, names, values, inner_bound), line))
                    Expr.Refinement(base, predicate, line):
                        return (Ast::Expr.Refinement(law_block_substitute_expr(base, names, values, bound), law_block_substitute_expr(predicate, names, values, bound), line))
                    Expr.Block(statements, value, captures, line):
                        block_bound: mutable darray[sview] = [bound_name for bound_name in bound]
                        substituted_statements: mutable darray[Ast::Stmt] = []
                        for block_statement in statements |substituted_statements, block_bound, names, values|:
                            substituted_statements.push(law_block_substitute_stmt(block_statement, names, values, block_bound))
                            match block_statement:
                                Stmt.VarDecl(local_name, _, _, _):
                                    block_bound.push(local_name)
                                _:
                                    pass
                        return (Ast::Expr.Block(substituted_statements, law_block_substitute_expr(value, names, values, block_bound), captures, line))
                    Expr.Lambda(parameters, body, line):
                        lambda_bound: mutable darray[sview] = [bound_name for bound_name in bound]
                        lambda_bound.extend(parameters)
                        substituted_body: mutable darray[Ast::Stmt] = []
                        for lambda_statement in body |substituted_body, names, values, lambda_bound|:
                            substituted_body.push(law_block_substitute_stmt(lambda_statement, names, values, lambda_bound))
                        return (Ast::Expr.Lambda(parameters, substituted_body, line))
                    _:
                        return expression

        def law_block_binding(parser: lmut Parser, names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&) -> void:
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            name: sview = Lexer::text_or_empty(name_token, parser.source)
            parser, _ <- parser.expect(TokenKind.Assign)
            rebind raw_value: Ast::Expr, parser = parser.contract_expression()
            resolved_value: Ast::Expr = law_block_substitute_expr(raw_value, names, values, [])
            names.push(name)
            values.push(resolved_value)

        def law_block_return(parser: lmut Parser) -> void:
            parser, _ <- parser.advance()
            rebind parsed_return: Ast::Expr, parser = parser.contract_expression()
            parser.captured_law_return <- parsed_return

        def law_block_return_ahead(parser: Parser&) -> bool:
            return true if parser.peek() == TokenKind.Return
            return false if parser.peek() != TokenKind.Ident
            current: Token = parser.cursor()
            return Lexer::text_or_empty(current, parser.source) == "return"

        def law_block_body(parser: lmut Parser) -> Ast::Expr:
            can Abort.Panic, Memory.Allocate:
                parser, _ <- parser.accept(TokenKind.Newline)
                parser, _ <- parser.expect(TokenKind.Indent)
                binding_names: mutable darray[sview] = []
                binding_values: mutable darray[Ast::Expr] = []
                parser.captured_law_return <- (Ast::Expr.Invalid)
                # Keep the block traversal as a machine. The predicate is stored in the
                # parser's threaded state by `law_block_return`; the machine payload remains
                # the expression being threaded between lines. This avoids the old captured
                # mutable local while preserving the machine's explicit data flow.
                machine over parser.position while true:
                    state Line(result: Ast::Expr)
                    state Inspect(result: Ast::Expr)
                    state End(result: Ast::Expr)
                    start Line((Ast::Expr.Invalid))

                    Line(result), _:
                        parser <- parser.skip_newlines()
                        -> Inspect(result)

                    Inspect(result), _ if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof:
                        -> End(result)

                    Inspect(_), _ if parser.law_block_return_ahead():
                        parser <- parser.law_block_return()
                        -> Line(parser.captured_law_return)

                    Inspect(result), _:
                        parser <- parser.law_block_binding(&binding_names, &binding_values)
                        -> Line(result)

                    End(result), _ if parser.peek() == TokenKind.Dedent:
                        parser.position <- parser.position + 1
                        return law_block_substitute_expr(result, binding_names, binding_values, [])

                    End(result), _:
                        return law_block_substitute_expr(result, binding_names, binding_values, [])
                return (Ast::Expr.Invalid)

        # Named refinement sugar: `refine Name[Ts](params) = Base where predicate`.
        # Stage1 represents it with the same structured Alias+Refinement shape as a
        # `type` refinement while consuming both generic and value parameter headers.
        def refine_declaration(parser: lmut Parser) -> Ast::Decl?:
            rebind token: Token, parser = parser.advance()
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            # Record refine-alias-ness (a `refine X = ...` collapses to Decl.Alias like a plain
            # `type`); the binder-position check needs to tell them apart.
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__refine_alias", name: Lexer::text_or_empty(name_token, parser.source), line: token.line})
            rebind has_generic_params: bool, parser = parser.accept(TokenKind.LBracket)
            parser <- parser.skip_bracketed_group() if has_generic_params
            rebind has_value_params: bool, parser = parser.accept(TokenKind.LParen)
            parser <- parser.skip_refine_value_params() if has_value_params
            parser, _ <- parser.expect(TokenKind.Assign)
            base_start: usize = parser.position
            rebind base_opt: Ast::Expr?, parser = parser.expression()
            base: mutable Ast::Expr = get base_opt else (Ast::Expr.Invalid)
            base_head: mutable sview = ""
            machine over base_head while true:
                state Scan(index: usize)
                start Scan(base_start)

                Scan(index), _ if index >= parser.position:
                    break

                Scan(index), _ if parser.tokens[index].kind == TokenKind.Ident:
                    base_head <- Lexer::text_or_empty(parser.tokens[index], parser.source)
                    -> Scan(index + 1)

                Scan(index), _:
                    -> Scan(index + 1)
            where_token: Token = parser.cursor()
            if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(where_token, parser.source) == "where":
                parser, _ <- parser.advance()
                rebind predicate_opt: Ast::Expr?, parser = parser.expression()
                if predicate_opt is predicate:
                    base <- (Ast::Expr.Refinement(base, predicate, Ast::pos_of_token(where_token)))
            # A `refine X = T where PRED` collapses to a Decl.Alias, but the ALIAS TABLES were
            # never fed — and `resolve_aliases` in the backend reads those tables, not the Decl.
            # So `X` stayed Unmodeled and every function mentioning it declined, while the
            # identical `type X = T where PRED` spelling worked. The refinement erases at
            # runtime either way (stage0 lowers a `RegisterIndex` parameter as a plain i32 and
            # emits no check); the predicate is the semantic layer's business.
            refine_name: sview = Lexer::text_or_empty(name_token, parser.source)
            parser.alias_names <- parser.alias_names.push(refine_name)
            parser.alias_targets <- parser.alias_targets.push(base)
            parser.alias_target_heads <- parser.alias_target_heads.push(base_head)
            return (Ast::Decl.Alias(refine_name, base, Ast::pos_of_token(token)))

        def skip_refine_value_params(parser: lmut Parser) -> void:
            machine over parser.position while parser.peek() != TokenKind.RParen and parser.peek() != TokenKind.Eof:
                state Scan
                start Scan

                Scan, _:
                    parser.position <- parser.position + 1
                    -> Scan
            parser, _ <- parser.expect(TokenKind.RParen)
