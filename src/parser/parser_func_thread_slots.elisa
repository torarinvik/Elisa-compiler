# Stage1 parser — a function's DECLARED THREAD SLOTS (`extend Parser: private:`): the
# `threads(name, ...)` header clause, and the validation that every slot named there is
# distinct and legal. Continues parser_types_function.elisa.

extend Parser:
    private:

        def capture_declared_thread_slots(parser: lmut Parser) -> void:
            return if parser.peek() != TokenKind.LParen
            saved_position: usize = parser.position
            parser.position <- parser.position + 1
            machine over parser.position while true:
                state Scan(depth: int)
                start Scan(1)

                Scan(depth), _ if depth <= 0 or parser.peek() == TokenKind.Eof:
                    break

                Scan(1), _ if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon and parser.peek_at(2) == TokenKind.Lmut:
                    label_token: Token = parser.cursor()
                    parser <- parser.record_declared_thread_slot(label_token)
                    parser.position <- parser.position + 1
                    -> Scan(1)

                Scan(1), _ if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon:
                    parser.position <- parser.position + 1
                    -> Scan(1)

                Scan(depth), _ if parser.peek() == TokenKind.LParen:
                    parser.position <- parser.position + 1
                    -> Scan(depth + 1)

                Scan(depth), _ if parser.peek() == TokenKind.RParen:
                    parser.position <- parser.position + 1
                    -> Scan(depth - 1)

                Scan(depth), _:
                    parser.position <- parser.position + 1
                    -> Scan(depth)
            parser.position <- saved_position



        def record_declared_thread_slot(parser: lmut Parser, label_token: Token) -> void:
            parser.declared_thread_slots <- parser.declared_thread_slots.push(Lexer::text_or_empty(label_token, parser.source))



        def validate_declared_thread_slots(parser: lmut Parser, token: Token) -> void:
            saved_position: usize = parser.position
            parser.position <- 0
            machine over parser.position while parser.position < parser.declared_thread_slots.count:
                state Scan
                start Scan

                Scan, _:
                    slot: sview = parser.declared_thread_slots[parser.position]
                    parser <- parser.validate_declared_thread_slot(slot, token)
                    parser.position <- parser.position + 1
                    -> Scan
            parser.position <- saved_position



        def validate_declared_thread_slot(parser: lmut Parser, slot: sview, token: Token) -> void:
            found: mutable bool = false
            machine over found while true:
                state Scan(index: usize)
                start Scan(0)

                Scan(_), _ if found or parser.lmut_param_names.count == 0:
                    break

                Scan(index), _ if index >= parser.lmut_param_names.count:
                    break

                Scan(index), _ if parser.lmut_param_names[index] == slot:
                    found <- true
                    -> Scan(index + 1)

                Scan(index), _:
                    -> Scan(index + 1)
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if not found
