# Stage1 parser — a `machine`'s STATE DECLARATIONS: one typed or concise payload-less group at
# a time, the refinements they carry, and the scalarised per-field locals a state's payload
# becomes. Part of `module Parser` (see parser.elisa).

extend Parser:
    public:
        def append_machine_state_refinement(field_types: mutable darray[Ast::Expr]&, refinement: Ast::Expr?, where_token: Token) -> void:
            if refinement is predicate and field_types.count > 0:
                base: Ast::Expr = field_types[field_types.count - 1]
                field_types[field_types.count - 1] <- (Ast::Expr.Refinement(base, predicate, Ast::pos_of_token(where_token)))



        def parse_machine_state_decl(parser: lmut Parser) -> MachineStateAst:
            parser, _ <- parser.advance()   # `state`
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            name_text: sview = Lexer::text_or_empty(name_token, parser.source)
            field_names: mutable darray[sview] = []
            field_types: mutable darray[Ast::Expr] = []
            rebind accepted_paren: bool, parser = parser.accept(TokenKind.LParen)
            if accepted_paren:
                machine over parser.position while true:
                    state Field
                    state FieldColon(field_token: Token)
                    state ConsumeColon
                    state FieldType
                    state Refinement
                    state Separator
                    start Field

                    Field, _ if parser.peek() == TokenKind.RParen or parser.peek() == TokenKind.Eof:
                        break

                    Field, _:
                        rebind parsed_field_token: Token, parser = parser.expect(TokenKind.Ident)
                        -> FieldColon(parsed_field_token)

                    FieldColon(field_token), _:
                        field_names.push(Lexer::text_or_empty(field_token, parser.source))
                        -> ConsumeColon

                    ConsumeColon, _:
                        parser.position <- parser.position + 1
                        -> FieldType

                    FieldType, _:
                        rebind field_type: Ast::Expr?, parser = parser.expression()
                        field_type_value: Ast::Expr = get field_type else (Ast::Expr.Invalid)
                        field_types.push(field_type_value)
                        -> Refinement

                    Refinement, _ if parser.peek() == TokenKind.Ident and Lexer::text_or_empty(parser.tokens[parser.position], parser.source) == "where":
                        where_token: Token = parser.tokens[parser.position]
                        parser.position <- parser.position + 1
                        rebind refinement: Ast::Expr?, parser = parser.expression()
                        append_machine_state_refinement(field_types, refinement, where_token)
                        -> Separator

                    Refinement, _:
                        -> Separator

                    Separator, _ if parser.peek() == TokenKind.Comma:
                        parser.position <- parser.position + 1
                        -> Field

                    Separator, _:
                        break
                parser, _ <- parser.expect(TokenKind.RParen)
            # Callers own line progress. Function-local directives return null and let
            # parse_block consume this newline; `machine over` skips it at loop top.
            return MachineStateAst{name: name_text, field_names: field_names, field_types: field_types, line: name_token.line}



        # One typed declaration or concise payload-less declaration group. The
        # grouped spelling is normalized immediately, so every later graph check
        # sees precisely the same MachineStateAst sequence as repeated `state` lines.
        def parse_machine_state_decls(parser: lmut Parser) -> darray[MachineStateAst]:
            declarations: mutable darray[MachineStateAst] = []
            # `parse_machine_state_decl` owns the leading contextual `state`; inspect
            # before consuming so the scalar and grouped paths share one entry point.
            grouped: bool = parser.peek_at(1) == TokenKind.LBrace
            if not grouped:
                rebind declaration: MachineStateAst, parser = parser.parse_machine_state_decl()
                declarations.push(declaration)
                return declarations

            parser, _ <- parser.advance() # `state`
            parser, _ <- parser.expect(TokenKind.LBrace)
            machine over parser.position while parser.peek() != TokenKind.RBrace and parser.peek() != TokenKind.Eof:
                state Parse
                state Separator
                start Parse

                Parse, _:
                    rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
                    empty_names: darray[sview] = []
                    empty_types: darray[Ast::Expr] = []
                    declarations.push(MachineStateAst{name: Lexer::text_or_empty(name_token, parser.source), field_names: empty_names, field_types: empty_types, line: name_token.line})
                    -> Separator

                Separator, _ if parser.peek() == TokenKind.Comma:
                    parser.position <- parser.position + 1
                    -> Parse

                Separator, _:
                    break
            parser, _ <- parser.expect(TokenKind.RBrace)
            return declarations



        # Function-local declarations live in parser state beyond this helper's
        # auto region, so append each normalized declaration directly to the
        # parser-owned array instead of returning a temporary group.
        def parse_pending_machine_state_decls(parser: lmut Parser):
            parser, _ <- parser.advance()
            parser, _ <- parser.expect(TokenKind.LBrace)
            machine over parser.position while parser.peek() != TokenKind.RBrace and parser.peek() != TokenKind.Eof:
                state Parse
                state Separator
                start Parse

                Parse, _:
                    rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
                    parser.pending_state_decls <- parser.pending_state_decls.push(MachineStateAst{name: Lexer::text_or_empty(name_token, parser.source), field_names: [], field_types: [], line: name_token.line})
                    -> Separator

                Separator, _ if parser.peek() == TokenKind.Comma:
                    parser.position <- parser.position + 1
                    -> Parse

                Separator, _:
                    break
            parser, _ <- parser.expect(TokenKind.RBrace)



        # The state dispatch body has the current state's payload locals in scope. An
        # alias, input binder, or ordinary arm-local with a destination-field spelling
        # would hide the state slot while the transition is being emitted. Keep this
        # predicate structural so the repair applies equally to payload aliases and
        # declarations nested in a transparent clause block.
        def machine_state_statement_declares_any_name(statement: Ast::Stmt, field_names: darray[sview]) -> bool:
            return match statement:
                Ast::Stmt.VarDecl(name, type_expression, value, pos): any field_name in field_names where field_name == name
                Ast::Stmt.Block(kind, clause, binding, body, pos): machine_state_declares_any_name(body, field_names)
                _: false



        def machine_state_declares_any_name(statements: darray[Ast::Stmt]&, field_names: darray[sview]) -> bool:
            found: mutable bool = false
            machine over found for statement in statements:
                state {Scan, Done}
                start Scan

                Scan, _ if machine_state_statement_declares_any_name(statement, field_names):
                    found <- true
                    -> Done

                Scan, _:
                    -> Scan

                Done, _:
                    -> Done
            return found



        # Validate mutations in source order, including transparent wrapper blocks. Stage0 keeps
        # arm-local declarations in an arm-wide set while traversing `can`/wrapper bodies; doing
        # the same here avoids both rejecting a local that shadows a mutable parameter and
        # missing a foreign assignment nested inside a wrapper.
        def append_machine_field_names(field_names: mutable darray[sview]&, source_fields: darray[sview]) -> void:
            machine over field_names for field_name in source_fields:
                state Scan
                start Scan

                Scan, _:
                    machine_add_root(field_names, field_name)
                    -> Scan



        def collect_machine_state_field_names(field_names: mutable darray[sview]&, states: darray[MachineStateAst]) -> void:
            machine over field_names for state in states:
                state Scan
                start Scan

                Scan, _:
                    append_machine_field_names(field_names, state.field_names)
                    -> Scan



        # State payloads are scalarized into one local per field name. Reject duplicate state
        # names, repeated fields, and cross-state type disagreement before that scalarization;
        # otherwise a later state could silently inherit the first state's type.
        def machine_type_expression_equal(first: Ast::Expr, second: Ast::Expr) -> bool:
            match first:
                Ast::Expr.IntLit(first_value):
                    match second:
                        Ast::Expr.IntLit(second_value):
                            return first_value == second_value
                        _:
                            return false
                Ast::Expr.FloatLit(first_text):
                    match second:
                        Ast::Expr.FloatLit(second_text):
                            return first_text == second_text
                        _:
                            return false
                Ast::Expr.StringLit(first_text):
                    match second:
                        Ast::Expr.StringLit(second_text):
                            return first_text == second_text
                        _:
                            return false
                Ast::Expr.CharLit(first_text):
                    match second:
                        Ast::Expr.CharLit(second_text):
                            return first_text == second_text
                        _:
                            return false
                Ast::Expr.BoolLit(first_value):
                    match second:
                        Ast::Expr.BoolLit(second_value):
                            return first_value == second_value
                        _:
                            return false
                Ast::Expr.Ident(first_name, _):
                    match second:
                        Ast::Expr.Ident(second_name, _):
                            return first_name == second_name
                        _:
                            return false
                Ast::Expr.Scope(first_base, first_name, _):
                    match second:
                        Ast::Expr.Scope(second_base, second_name, _):
                            return first_name == second_name and machine_type_expression_equal(first_base, second_base)
                        _:
                            return false
                Ast::Expr.Index(first_object, first_index, _):
                    match second:
                        Ast::Expr.Index(second_object, second_index, _):
                            return machine_type_expression_equal(first_object, second_object) and machine_type_expression_equal(first_index, second_index)
                        _:
                            return false
                Ast::Expr.IndexN(first_object, first_arguments, _):
                    match second:
                        Ast::Expr.IndexN(second_object, second_arguments, _):
                            return false if first_arguments.count != second_arguments.count or not machine_type_expression_equal(first_object, second_object)
                            for index in 0..<first_arguments.count:
                                return false if not machine_type_expression_equal(first_arguments[index], second_arguments[index])
                            return true
                        _:
                            return false
                Ast::Expr.Binary(first_left, first_operator, first_right, _):
                    match second:
                        Ast::Expr.Binary(second_left, second_operator, second_right, _):
                            return first_operator == second_operator and machine_type_expression_equal(first_left, second_left) and machine_type_expression_equal(first_right, second_right)
                        _:
                            return false
                Ast::Expr.Unary(first_operator, first_operand, _):
                    match second:
                        Ast::Expr.Unary(second_operator, second_operand, _):
                            return first_operator == second_operator and machine_type_expression_equal(first_operand, second_operand)
                        _:
                            return false
                Ast::Expr.Paren(first_inner, _):
                    match second:
                        Ast::Expr.Paren(second_inner, _):
                            return machine_type_expression_equal(first_inner, second_inner)
                        _:
                            return false
                Ast::Expr.Array(first_elements, _):
                    match second:
                        Ast::Expr.Array(second_elements, _):
                            return false if first_elements.count != second_elements.count
                            for index in 0..<first_elements.count:
                                return false if not machine_type_expression_equal(first_elements[index], second_elements[index])
                            return true
                        _:
                            return false
                Ast::Expr.Tuple(first_elements, _):
                    match second:
                        Ast::Expr.Tuple(second_elements, _):
                            return false if first_elements.count != second_elements.count
                            for index in 0..<first_elements.count:
                                return false if not machine_type_expression_equal(first_elements[index], second_elements[index])
                            return true
                        _:
                            return false
                Ast::Expr.Refinement(first_base, first_predicate, _):
                    match second:
                        Ast::Expr.Refinement(second_base, second_predicate, _):
                            return machine_type_expression_equal(first_base, second_base) and machine_type_expression_equal(first_predicate, second_predicate)
                        _:
                            return false
                _:
                    return false



        def validate_machine_state_declarations(parser: lmut Parser, states: darray[MachineStateAst], token: Token) -> void:
            for state_index in 0..<states.count |parser|:
                for previous_state_index in 0..<state_index |parser|:
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if states[state_index].name == states[previous_state_index].name
                for field_index in 0..<states[state_index].field_names.count |parser|:
                    for previous_field_index in 0..<field_index |parser|:
                        parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if states[state_index].field_names[field_index] == states[state_index].field_names[previous_field_index]
                    for previous_state_index in 0..<state_index |parser|:
                        for previous_field_index in 0..<states[previous_state_index].field_names.count |parser|:
                            if states[state_index].field_names[field_index] == states[previous_state_index].field_names[previous_field_index]:
                                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if not machine_type_expression_equal(states[state_index].field_types[field_index], states[previous_state_index].field_types[previous_field_index])
