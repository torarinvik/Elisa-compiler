# Core types for the Elisa parser
# String fields use `sview` (the lexer's token text type). AST nodes are recursive
# enum values, so child references are opaque compiler-managed handles.

# Frontend bootstrap: the runtime and the lexer module (formerly the 6-line
# elisacore_frontend.elisa facade, inlined here — its only real consumer).
include "../../elisacore_std/elisacore_runtime.elisa"
include "../lexer/lexer.elisa"


module Ast:
    # Allocation-free error classification (no string formatting in the hot path)
    enum ParseErrorKind:
        ExpectedToken
        UnexpectedToken
        ExpectedDeclaration
        ExpectedExpression
        # docs/125 §5 R1 — an or-arm's `with` alternatives bind different constant sets.
        MismatchedWithBindings
        SubmitOutsidePool


    struct ParseError:
        kind: ParseErrorKind
        line: u32
        column: u32
        context: sview


    # Sealed AST hierarchy root: every AST node (Decl/Stmt/Expr) is a refinement of
    # Node, so the whole tree shares ONE region-backed AoS store (docs/76/77). Values are
    # opaque u32 handles into that store; the explicit handle width keeps the ABI compact
    # without exposing the integer. A node's children are reached directly from its payload
    # — a fixed-arity child is a bare handle, a variable-length child list is a `darray`
    # side-table of handles co-located in the node's region (docs/76 "side-tables"). There
    # is no separate flat node store and no NodeRange: you traverse purely by `match`.
    enum Node layout(handle: u32):
        pass


    # Expression AST nodes. Fixed-arity children are bare handles; variable-length child
    # lists (call arguments, array/set elements, match arms) are `darray` side-tables.
    enum Expr is Node:
        # A parse ERROR / recovery placeholder: the parser could not build a well-formed
        # expression here. Distinct from `Absent` (see below) — `Invalid` means "malformed",
        # never "legitimately omitted". A walk treating `Invalid` as an error must NOT also
        # fire on `Absent`, and vice versa.
        Invalid
        # A legitimately OMITTED optional sub-expression: no `else` on a value `if`, no
        # `where` filter on a comprehension, an open-ended slice bound, an absent match/
        # machine arm guard, a plain-enum backing type, a member with no `= VALUE`. Modeled
        # as a distinct variant (not `Invalid`) so "the programmer wrote nothing here" is
        # never conflated with "the parser failed here" (stage0 draws the same line with a
        # nil `ast.Expr` vs its error node). A missing-else on a VALUE `if` is the one case
        # where `Absent` is itself illegal — check_if_value_missing_else flags exactly it.
        Absent
        IntLit(value: i64)
        FloatLit(text: sview)
        StringLit(text: sview)
        CharLit(text: sview)
        BoolLit(value: bool)
        Ident(name: sview, line: u32)
        # A call `f(a, b)` or named/mixed call `f(a, label: b)`; `arg_names` is a
        # side-table parallel to `arguments` where "" marks a positional argument and a
        # non-empty entry is the field/parameter label (paren construction and named
        # function arguments share this node). Labels are selectors, not references.
        Call(callee: Expr, arguments: darray[Expr], argument_names: darray[sview], line: u32)
        # Value member access `object.field` — a struct field, enum-variant selector, or
        # method target. The `.` operator, distinct from the `::` namespace path below.
        Field(object: Expr, field: sview, line: u32)
        # Namespace/type path `base::name` — module member (`Semantic::check`) or
        # qualified type (`Ast::Expr`). The `::` operator. Kept distinct from Field so
        # `::` (module/type resolution) and `.` (value member access) never conflate.
        Scope(base: Expr, name: sview, line: u32)
        # Leading-dot enum shorthand `.Variant` / `.A.B` — an inferred member whose
        # enclosing type comes from context (`operator == .NEGATE`, `{.LT, .GT}`). `parts`
        # holds the dot-separated identifier chain. Parts are selectors, not references.
        ShorthandMember(parts: darray[sview], line: u32)
        Index(object: Expr, index: Expr, line: u32)
        # A slice `object[low:high]` — `low`/`high` are Absent for the open-ended forms
        # (`object[:high]`, `object[low:]`, `object[:]`).
        Slice(object: Expr, low: Expr, high: Expr, line: u32)
        # A multi-argument subscript: multi-dimensional index `m[i, j]` or generic
        # type application `dict[K, V]`. `arguments` is a `darray` side-table.
        IndexN(object: Expr, arguments: darray[Expr], line: u32)
        Binary(left: Expr, operator: TokenKind, right: Expr, line: u32)
        Unary(operator: TokenKind, operand: Expr, line: u32)
        # Contextual `move EXPR` ownership transfer. Distinct from lexical unary
        # operators so TokenKind remains a closed lexical vocabulary.
        Move(operand: Expr, line: u32)
        Paren(inner: Expr, line: u32)
        Array(elements: darray[Expr], line: u32)
        # A tuple `(a, b, …)` — value form (`return (x, y)`) or tuple TYPE in a type
        # position (`-> (x: int, y: int)`). Empty `()` is the unit tuple. A single `(x)`
        # is grouping, not a tuple, and does not build this node.
        #
        # Elisa's tuple TYPE is named-field only; the labels are selectors, not values,
        # so the parser consumes them and keeps just the element types — which is why no
        # label is stored here. Consequence: this node cannot distinguish the canonical
        # `(x: int, y: int)` from the positional `(int, int)` that stage0 rejects
        # everywhere, so stage1 currently ACCEPTS the latter (a missing diagnostic, never
        # a false positive). Closing that needs labels on this node — see the backlog.
        Tuple(elements: darray[Expr], line: u32)
        # Set literal `{a, b, …}` — its elements as a `darray` side-table.
        SetLit(elements: darray[Expr], line: u32)
        # Dict literal `{k: v, …}` (and the empty `{}`) — its key/value pairs (see
        # `DictEntry`) as a `darray` side-table.
        DictLit(entries: darray[DictEntry], line: u32)
        # Brace construction `Type{field: value, …}` (or shorthand `Type{value}`). `type`
        # is the constructed type expression; `fields` are the field initializers (see
        # `FieldInit`) — a `darray` side-table in declaration order.
        Construct(type: Expr, fields: darray[FieldInit], line: u32)
        # Record update `base{field = value, …}` — a copy of `base` with the named
        # fields overridden. Distinguished from construction by the `=` field separator
        # (construction uses `:`); the result has the same type as `base`.
        RecordUpdate(base: Expr, fields: darray[FieldInit], line: u32)
        If(condition: Expr, then_expr: Expr, else_expr: Expr, line: u32)
        Match(scrutinee: Expr, arms: darray[MatchArm], line: u32)
        # `catch EXPR:` fallible-call expression (docs error unions): `guarded` is the
        # fallible call; `arms` are the handler arms — arm 0 is the SUCCESS arm (its
        # pattern binds the success value), later arms match error variants. Backends
        # dispatch on the call's status; consumers that only need the value use
        # `guarded`.
        Catch(guarded: Expr, arms: darray[MatchArm], line: u32)
        # A quantifier (`any`/`all VAR in ITER where COND`) or, in future, a
        # collection comprehension. `var` is the bound variable, in scope for `condition`
        # and `body` but not `iterable`. `condition` is the optional filter (Absent if omitted)
        # and `body` the element/result expression (Absent for quantifiers).
        Comprehension(var: sview, iterable: Expr, condition: Expr, body: Expr, line: u32)
        # A refinement type/value form `T where PRED`; the base and predicate remain
        # structured so alias analysis can inspect the constraint instead of losing it.
        Refinement(base: Expr, predicate: Expr, line: u32)

        # Anonymous function `fn(params) [-> T] => EXPR` / `fn(params): BODY` /
        # `fn shorthand: EXPR` (also spelled with a Unicode lambda letter `λ`/`Λ`).
        # `params` holds the parameter names (scoped to the body). An expression body
        # `=> EXPR` / `: EXPR` is normalized to a single `return EXPR` statement so the
        # body is uniformly a `darray[Stmt]` (as with expression-bodied functions).
        Lambda(params: darray[sview], body: darray[Stmt], line: u32)

        # Block expression (docs/119 §2): the RHS of `x =` / `x: T =` written as an
        # indented block whose leading statements are locals and whose tail expression is
        # the block's value. Also the desugar target for loop-expression headers and the
        # bodies of multi-line `if`/`match` value branches. `stmts` are the leading
        # statements (a `darray` side-table); `value` is the tail expression.
        # `captures` names the outer mutable bindings a `|capture|` header (docs/119 §6)
        # threads through this block: the moved-in shadow's final value is written back to
        # the outer binding by a synthesized tail assignment. E4 (value-block purity)
        # exempts writes to these names — a capture is the sanctioned way a value block
        # updates outer state, sugar over `rebind`. Empty for ordinary blocks.
        Block(stmts: darray[Stmt], value: Expr, captures: darray[sview], line: u32)


    # Statement AST nodes. Fixed-arity children are bare handles; block bodies and match
    # arms are `darray` side-tables.
    enum Stmt is Node:
        Invalid
        Expr(expression: Expr, line: u32)
        # A scoped block introduced by a prefix clause (`can …:`, `trusted …:`,
        # `with …:`, `region …:`, `try:`, `catch …:`, `error e:`, a success arm
        # `slot:`). `kind` names the clause category — the prefix keyword ("region",
        # "can", "try", "catch", "with", "trusted", "nursery", "pool", "parallel",
        # "in", "error", "static") or "arm" for a bare `slot:` success arm — so region
        # and effect passes can dispatch on block type instead of treating it as
        # opaque. `clause` holds the prefix's identifier tokens in order (a `darray`
        # side-table): the granted effect names (`can Mem.Allocate:` → ["Mem",
        # "Allocate"]) or the region name (`region scratch(…):` → ["scratch"]); empty
        # when the prefix carries no identifiers. `binding` is the name the clause
        # brings into scope (`e` / `slot`), or "" if none; `body` holds the block's
        # statements.
        Block(kind: sview, clause: darray[sview], binding: sview, body: darray[Stmt], line: u32)
        VarDecl(name: sview, type_expression: Expr, value: Expr, line: u32)
        # `operator` is the assignment spelling: LArrow (`<-` mutation), Assign (`=` binding
        # definition), or a compound token (`+=`, `-=`, …). `<-`/compounds MUTATE an
        # existing binding (illegal on an immutable one) while `=` DEFINES a new local,
        # so the checker needs the operator, not just the statement shape.
        Assign(target: Expr, operator: TokenKind, value: Expr, line: u32)
        If(condition: Expr, then_body: darray[Stmt], else_body: darray[Stmt], line: u32)
        While(condition: Expr, body: darray[Stmt], line: u32)
        # `for [mutable] v [, v]* in ITER:` — `variables` holds every loop variable in
        # order (a `darray` side-table); destructuring loops (`for k, v in dict`) bind
        # them all. `bind` is the iteration binding intent: "" = read (the compiler
        # binds by value or by reference as needed — affine elements auto-borrow),
        # "mutable" = mutate in place (writes through the variable mutate the
        # element). The mechanism spellings `ref` / `mutable ref` were removed.
        For(bind: sview, variables: darray[sview], iterable: Expr, body: darray[Stmt], line: u32)
        Return(value: Expr?, line: u32)
        Break(label: sview, line: u32)
        Continue(label: sview, line: u32)
        # `match SCRUTINEE:` with arms; each MatchArm carries its pattern text and its
        # body statement list.
        Match(scrutinee: Expr, arms: darray[MatchArm], line: u32)
        # A design-by-contract statement: `requires EXPR` / `ensure EXPR` /
        # `decreases EXPR` / `invariant EXPR` / `changes PATH` / `preserves PATH` — a leading body
        # statement (contextual keyword). `kind` is the contract keyword's text;
        # `expression` the predicate/path. An `ensure` predicate may reference `result`.
        Contract(kind: sview, expression: Expr, line: u32)


    # Declaration AST nodes. Bodies/members/params/variants are `darray` side-tables.
    enum Decl is Node:
        Invalid
        # `effects` holds the declared effect-grant names from the signature line
        # (`can[Abort.Panic, Memory.Allocate]` or the bare `can E1, E2` form), each as its
        # dotted source text (`Abort.Panic`); empty when the function grants no effects.
        # `decorators` preserves each leading annotation name and raw argument spans.
        Func(name: sview, params: darray[ParamDecl], return_type: Expr?, body: darray[Stmt], effects: darray[sview], decorators: darray[Annotation], line: u32)
        # `affinity` is the struct's single-use discipline: "" (unrestricted),
        # "affine" (use-at-most-once, may be silently dropped), or "linear"
        # (use-exactly-once, must be consumed before scope exit). Struct-only —
        # stage0 has no `affine`/`linear` enum or other declaration form.
        # `has_named_states` is set when the header carries a typestate list
        # (`struct X[state A | B]:`); `has_derive` when the body carries a matching
        # `derive state:` block. A struct that declares named states but no derive block
        # is ill-formed (see check_named_states_without_derive). `invariants` holds the
        # struct-body design-by-contract predicates (`invariant EXPR`) in declaration order.
        Struct(name: sview, members: darray[StructMember], affinity: sview, has_named_states: bool, has_derive: bool, invariants: darray[Expr], line: u32)
        # `is_const` marks a `const enum` (a compile-time integer-backed enum); `storage_type`
        # is its declared `of T` backing type (Absent when omitted / for a plain enum).
        Enum(name: sview, variants: darray[EnumVariant], is_const: bool, storage_type: Expr, line: u32)
        Alias(name: sview, target: Expr, line: u32)
        # `law Name(params) = <predicate>` — an algebraic/refinement law. The
        # predicate is parsed as an expression, including structured quantifiers. The
        # parameter list remains represented by the law header/name for now; this node
        # preserves the distinction from `Alias` without retaining an opaque predicate span.
        Law(name: sview, predicate: Expr, line: u32)
        Import(module: sview, line: u32)
        # An isolated nested declaration scope: one `static if/elif/else` branch, or an
        # `impl` body. Holds that scope's declarations. Sibling scopes do NOT share a
        # namespace — a per-backend `mutex_init` across static-if branches, or a
        # `br_remaining` method across two impls, is not a duplicate. Symbol collection
        # and resolution recurse into `body` (like a module) so its decls stay resolvable.
        Scoped(body: darray[Decl], line: u32)
        # An `extern …`/`export …` declaration. Callable signatures retain their
        # fixed arity without structurally reparsing foreign parameter types; opaque
        # extern names/types have `callable == false`. Variadic signatures accept any
        # count at or above `arity`. `return_type_name` is the bare name from the
        # `-> T` clause (empty when absent), matching `ExternParam.type_name`'s
        # unparsed-name representation rather than an `Expr`.
        Extern(name: sview, param_start: u32, arity: u32, variadic: bool, callable: bool, return_type_name: sview, decorators: darray[Annotation], line: u32)
        # `is_mutable` is true for `global`/`global mutable` bindings and false for an
        # immutable `const`. Only immutable consts are protected against `<-` mutation
        # (a `global` may or may not be writable — stage1 conservatively allows it).
        Const(name: sview, type_expression: Expr, value: Expr, is_mutable: bool, line: u32)
        # `module Name:` with an indented body of child declarations (visibility
        # sections are flattened into `body`; their members keep declaration order).
        Module(name: sview, body: darray[Decl], line: u32)


    # Match-arm patterns, structurally decomposed so name resolution can see the
    # bindings a pattern introduces. Variant/tuple/or field subpatterns are `darray`
    # side-tables (docs/76 — reached by `match`, not indexing). Truly exotic forms
    # (e.g. ranges) are preserved losslessly as `Other` so the parser never regresses.
    enum Pattern is Node:
        # `_`
        Wildcard
        # A literal value pattern: `'u'`, `42`, `"s"`, `true`. The raw source text is
        # kept; literal-kind decoding is deferred.
        Literal(text: sview)
        # A bare lowercase name that binds the scrutinee (e.g. `value` in `match x: value:`).
        Binding(name: sview)
        # A pin pattern `^name` compares against an existing binding and introduces no name.
        Pin(name: sview)
        # A (possibly module-qualified) variant pattern: `TokenKind.IntLit` (no fields)
        # or `Decl.Func(name, params, return_type, body, line)`. `path` is the variant's
        # dotted source text; `fields` are the field subpatterns in declaration order.
        Variant(path: sview, fields: darray[Pattern])
        # A struct pattern `Type{a, b: sub}` — `path` is the type, `fields` the field
        # subpatterns (a shorthand `{a}` is a `Binding`; a labeled `{a: sub}` keeps `sub`).
        Struct(path: sview, fields: darray[Pattern])
        # One named field selector inside a struct pattern. `selector` is the declared
        # field being selected; `inner` is a one-element side-table containing the
        # binding/subpattern. Keeping these distinct preserves `{field: binding}`.
        Field(selector: sview, inner: darray[Pattern])
        # A tuple pattern `a, b, …` — top-level comma-separated element subpatterns.
        Tuple(elements: darray[Pattern])
        # A list-pattern tail: `...rest` binds the unmatched tail; bare `...` discards it.
        Rest(name: sview)
        # An or-pattern `A | B | …` — alternative subpatterns; matches if any does.
        Or(options: darray[Pattern])
        # A category arm with a binder `Type s` — binds the scrutinee as `binder` when it
        # is of category/type `type`. `type` is the dotted type name; `binder` the name.
        TypeBind(type: sview, binder: sview)
        # A range pattern (docs/122 §5.2): `'a'..<'z'` / `0..=127`. `lo`/`hi` are the raw
        # literal spans; `inclusive` distinguishes `..=` from `..<`. Introduces no bindings.
        Range(lo: sview, hi: sview, inclusive: bool)
        # An as-binding (docs/122 §5.4): `Enum.V(...) as whole` — `inner` is the wrapped
        # (variant/struct) pattern as a one-element side-table; `name` binds the whole value.
        As(name: sview, inner: darray[Pattern])
        # A pattern form not yet structured; `text` is its raw source span.
        Other(text: sview)


    struct ParamDecl:
        name: sview
        type_expression: Expr
        is_mutable: bool
        # Whether the parameter carries a default value (`p: T = v`) — callers may
        # omit it, so arity checking needs required-vs-total counts.
        has_default: bool


    struct Annotation:
        name: sview
        arg_start: u32
        arg_count: u32


    struct ExternParam:
        name: sview
        type_name: sview
        provenance_bearing: bool


    struct LocalRegionAnnotation:
        name: sview
        type_expression: Expr
        region: sview
        line: u32


    struct EnumAnnotation:
        owner: sview
        name: sview
        line: u32


    # One member of a packed bit group (`flags: bitset:` flags, or a `layout: bitfield:`
    # field). For a `bitset` flag, `type_expression` is `Expr.Invalid` (each flag is an
    # implicit 1-bit member). For a `bitfield` member, `type_expression` is the declared
    # storage type (a bit-int like `u4` or a const-enum). `line` places diagnostics.
    struct BitGroupMember:
        name: sview
        type_expression: Expr
        line: u32


    struct StructMember:
        name: sview
        type_expression: Expr
        # Whether the field may be omitted in a by-label construction — an optional
        # field (`name?: T`) or one with a default value (`name: T = expression`). Required
        # fields (omittable == false) must all appear in a labeled `Name{...}` literal.
        omittable: bool
        # Whether the field is a `ghost` verification-only model field (erased at codegen).
        is_ghost: bool
        # Whether the field carries an explicit default-value initializer (`name: T = expr`).
        # Distinct from `omittable`, which also covers optional `name?: T` fields.
        has_default: bool
        # The `@region` provenance qualifier on the field type (`next: T @owner`), captured
        # verbatim; "" when absent. A region selector, not part of the field type — used by
        # the region-annotation-on-scalar structural check.
        region: sview
        # Packed bit-group kind: "" for an ordinary field, "bitset" for a `flags: bitset:`
        # block, "bitfield" for a `layout: bitfield:` block. When non-empty,
        # `bit_group_members` holds the captured nested members in declaration order.
        bit_group_kind: sview
        bit_group_members: darray[BitGroupMember]


    struct EnumVariant:
        name: sview
        # Payload field TYPE expressions and optional labels, in declaration order.
        # `field_names[i] == ""` means the payload field is positional/unnamed.
        fields: darray[Expr]
        field_names: darray[sview]
        # A const-enum member's explicit `= VALUE` initializer (Absent when omitted). For an
        # `Expr.IntLit` the parser has already decoded its `i64` value.
        value_expr: Expr


    struct MatchArm:
        # The arm pattern, structurally decomposed (see `Pattern`).
        pattern: Pattern
        # The arm body statements.
        body: darray[Stmt]
        # The docs/122 §5.1 arm-header guard (`Pattern if cond:`), or Absent when the
        # arm is unguarded. Pattern bindings are in scope inside the guard.
        guard: Expr


    # One field initializer in a brace construction `Type{name: value, …}`. `name` is the
    # field label, or "" for a positional/shorthand field (`Type{value}`), in which case
    # the value expression carries the reference. The label is a member selector, not a
    # value reference.
    struct FieldInit:
        name: sview
        value: Expr


    # One key/value pair in a dict literal `{key: value, …}`. Both are value references.
    struct DictEntry:
        key: Expr
        value: Expr


    struct MachineCoverageRow:
        # docs/125 §9 Tier-2: ONE arm-atom of a `machine over` whose input is a free-function
        # (classifier) call — either a variant `tag` this state's arm spells, or a wildcard/bind
        # marker (`tag == ""`, `has_wildcard`). Rows sharing a `line` (the machine head) belong
        # to one machine; grouped by (line, state_name) in semantic, they reconstruct each
        # state's tag set + wildcard flag. Semantic resolves the classifier's return type and, if
        # a CLOSED const enum, enforces "spell every variant, reject `_`" (the add-a-variant
        # safety net). A flat row (sviews + scalars only) — the parser->semantic side-table
        # carries no region-allocated containers or node-store handles.
        input_callee: sview
        state_name: sview
        tag: sview
        has_wildcard: bool
        line: u32

    # One clause from a struct's `derive state:` block. Kept as file metadata so the
    # stable Decl.Struct payload need not change while semantic analysis still receives
    # the predicate expression and can derive its field dependencies.
    struct DerivedStateRule:
        owner: sview
        state: sview
        condition: Expr
        line: u32

    # A function signature postcondition `ensures PARAM => STATE`, used as the
    # declared typestate summary at reference-call sites.
    struct TypestatePostcondition:
        function_name: sview
        parameter_name: sview
        position: u32
        state: sview
        line: u32

    struct File:
        # A parsed file is just its top-level declarations plus the accumulated parse
        # errors (a genuine side table). Each Decl is a handle into the one unified Node
        # store, and every child list (block bodies, arguments, params, members, variants, arms)
        # is a `darray` side-table hanging off its node's payload — reached by `match`, not
        # by indexing a flat store. The whole tree's backing is adopted by the caller across
        # parse_file's region-polymorphic return.
        top_decls: darray[Decl]
        errors: darray[ParseError]
        # Source lines of functions whose signature declared an `error[...]` return set.
        # The declared set's structure isn't modeled (consumed as an opaque signature
        # clause), but its presence exempts a raise-bearing function from the
        # RaiseWithoutErrorSet check. Recording is exhaustive over error-set functions, so a
        # line here always reflects a real declared set — never a false exemption in reverse.
        error_set_func_lines: darray[u32]
        # Discouraged explicit numeric literal suffixes, retained as parser metadata
        # because IntLit intentionally stores only its decoded numeric value.
        numeric_suffix_names: darray[sview]
        numeric_suffix_lines: darray[u32]
        # docs/125 §9 Tier-2 machine coverage rows (see MachineCoverageRow), drained from the
        # parser by parse_file. Checked in semantic once the classifier's type is known.
        machine_coverage: darray[MachineCoverageRow]
        derived_state_rules: darray[DerivedStateRule]
        typestate_postconditions: darray[TypestatePostcondition]
        # Function-scoped generic parameters, represented as parallel owner-line/name
        # rows because Decl.Func predates generic metadata and remains ABI-stable.
        generic_param_lines: darray[u32]
        generic_param_names: darray[sview]
        annotation_args: darray[sview]
        extern_params: darray[ExternParam]
        local_region_annotations: darray[LocalRegionAnnotation]
        # Expression provenance rows. Ordinary names are `new[region]` selectors;
        # the reserved `__inline_can` name records a postfix call-grant source line.
        allocation_region_names: darray[sview]
        allocation_region_lines: darray[u32]
        enum_annotations: darray[EnumAnnotation]
        # Names declared with `packed enum`; parallel file metadata because Decl.Enum's
        # stable payload does not carry layout modifiers.
        packed_enum_names: darray[sview]
        # Packed/common enum inherited payload prefix counts, parallel owner/count rows.
        enum_common_owners: darray[sview]
        enum_common_counts: darray[u32]
