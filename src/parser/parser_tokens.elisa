# Core types for the Elisa parser
# String fields use `sview` (the lexer's token text type). AST nodes are recursive
# enum values, so child references are opaque compiler-managed handles.

# Frontend bootstrap: the runtime and the lexer module (formerly the 6-line
# elisacore_frontend.elisa facade, inlined here — its only real consumer).
include "../../elisacore_std/elisacore_runtime.elisa"
include "../lexer/lexer.elisa"


# stage0's parser ALWAYS builds a `ParenExpr` for a grouping `( … )`, and its unparser
# prints that node on top of the pair the inner Binary/Unary/Ternary prints for itself —
# so a REDUNDANT source paren survives into `-emit fmt` output as a second layer.
#
# stage1's compile path has no `Expr.Paren` consumer: the semantic layer and the backend
# match the inner node directly, and an unhandled Paren would fall through hundreds of
# `_:` arms as a silent miscompile. So the parser DROPS the node by default and builds it
# only when a caller asks — the `-emit fmt` path, which returns before the semantic gate
# and before codegen, so no consumer ever sees one. See `parenthesized_expression`.


# stage0's parser ALWAYS builds a `ParenExpr` for a grouping `( … )`, and its unparser
# prints that node on top of the pair the inner Binary/Unary/Ternary prints for itself —
# so a REDUNDANT source paren survives into `-emit fmt` output as a second layer.
#
# stage1's compile path has no `Expr.Paren` consumer: the semantic layer and the backend
# match the inner node directly, and an unhandled Paren would fall through hundreds of
# `_:` arms as a silent miscompile. So the parser DROPS the node by default and builds it
# only when a caller asks — the `-emit fmt` path, which returns before the semantic gate
# and before codegen, so no consumer ever sees one. See `parenthesized_expression`.
global mutable parser_preserve_parens: bool




# Set the flag above. A SETTER rather than a bare `parser_preserve_parens <- on` at the
# call site because the driver lives in another file, and the resolution set the
# assignment-target check works over is per-file — a cross-file write to a global reads
# there as an assignment to an undeclared name.
def parser_set_preserve_parens(on: bool) -> void:
    parser_preserve_parens <- on


module Ast:
    # Allocation-free error classification (no string formatting in the hot path)
    enum ParseErrorKind:
        ExpectedToken
        UnexpectedToken
        ExpectedDeclaration
        ExpectedExpression
        # docs/125 §5 R1 — an or-arm's `with` alternatives bind different constant sets.
        MismatchedWithBindings
        SubmitOutsidePool
        # A REMOVED spelling (§5.2): `context` carries stage0's full sentence verbatim
        # ("the `cascade` statement has been removed") and is printed as the message.
        Removed
        # Sentences that NAME something; each composes from `detail`/`detail2` at render time.
        # `def f[region r]` / `struct B[T, region owner]` -> `@r` / `@owner`.
        RemovedRegionParamSpelling
        # A generic parameter list repeating a name.
        DuplicateGenericParam
        # `struct Holder[?, &]` -- `detail` is the source spelling of the whole bracket list.
        StructStateMarkerList
        # `ensures return COND` whose condition is not the literal `true`/`false`.
        EnsuresReturnNeedsBoolLiteral
        # docs/125 §4 R1 refusals, which quote the ARMS and the line they collide with.
        WhenArmOverlap
        WhenDuplicateDefaultRow
        WhenColumnCount




    struct ParseError:
        kind: ParseErrorKind
        line: u32
        column: u32
        context: sview
        # The token that was found and, for ExpectedToken, the kind that was wanted -- so the
        # driver can print stage0's `expected :, got IDENT("u8")` (§5.2).
        got_kind: TokenKind
        expected_kind: TokenKind
        has_expected: bool
        # NAMES a sentence interpolates, kept as views into the SOURCE buffer (never into a
        # local darray, which dangles the moment it goes out of scope). The sentence itself
        # is composed at RENDER time from these, the way a semantic Diagnostic composes its
        # message from `name`/`expected`/`actual` -- so no parser-side message arena exists.
        detail: sview = ""
        detail2: sview = ""
        # Numbers a sentence interpolates (a source LINE, a column count).
        detail_num: u32 = 0
        detail_num2: u32 = 0




    # A source SPAN, carried by every positioned AST node.
    #
    # It replaced a bare `line: u32` because stage0's diagnostics and its fact reports are
    # both `file:line:col-endcol`, and a line alone cannot render either. The shape mirrors
    # stage0's `lexer.Pos` field for field (minus `File`, which is one per compilation and
    # is recovered from the driver's flat-buffer line map) so the frontend-IR writer can
    # emit stage0's own `Position` nodes without a translation table.
    #
    # `end_line` is stored rather than derived: a multi-line node's span does not end on
    # the line it starts on, and stage0's `EndLine` is load-bearing in exactly those cases.
    struct Pos:
        line: mutable u32
        column: mutable u32
        offset: mutable u32
        end_line: mutable u32
        end_column: mutable u32
        end_offset: mutable u32




    # The line-only Pos. Every construction site that has not yet been widened to carry a
    # real span funnels through here, so `grep pos_at_line` is the exact, shrinking list of
    # places still reporting a bare line.
    def pos_at_line(line: u32) -> Pos:
        return Pos{line: line, column: 0, offset: 0, end_line: line, end_column: 0, end_offset: 0}




    # The span of one token: its own line/column and the half-open end its length implies.
    # stage0 sets EndCol to Col+len for a single-line token, which is every token the lexer
    # produces except a multi-line string, and it is where `2:5-11` for `return` comes from.
    def pos_of_token(token: Lexer::Token&) -> Pos:
        return Pos{line: token.line, column: token.column, offset: token.start, end_line: token.line, end_column: token.column + token.length, end_offset: token.start + token.length}

    # A string/char literal token: its column is the OPENING quote and its length the content
    # between the quotes (that is what `text_or_empty` reads), so the source span is two
    # columns wider. stage0 reports `"s"` as 16-19, not 16-17 (diagnostic_columns, 2026-09-07).
    def pos_of_quoted_token(token: Lexer::Token&) -> Pos:
        return Pos{line: token.line, column: token.column, offset: token.start - 1, end_line: token.line, end_column: token.column + token.length + 2, end_offset: token.start + token.length + 1}




    # The span covering two spans: `start`'s beginning through `end`'s end. Used where a
    # node's extent is wider than its head token (a binary expression, a call).
    def pos_span(start: Pos&, end: Pos&) -> Pos:
        return Pos{line: start.line, column: start.column, offset: start.offset, end_line: end.end_line, end_column: end.end_column, end_offset: end.end_offset}




    struct File:
        # A parsed file is just its top-level declarations plus the accumulated parse
        # errors (a genuine side table). Each Decl is a handle into the one unified Node
        # store, and every child list (block bodies, arguments, params, members, variants, arms)
        # is a `darray` side-table hanging off its node's payload — reached by `match`, not
        # by indexing a flat store. The whole tree's backing is adopted by the caller across
        # parse_file's region-polymorphic return.
        top_decls: darray[Decl]
        effect_type_references: darray[EffectTypeReference]
        # Canonical type spellings synthesized by stage1's Python-module emitter for
        # generic containers whose element/value is a named type (for example
        # `darray[Point]`). The flat byte pool plus span columns keeps returned sviews stable
        # without storing short-lived nested darrays into the adopted file region.
        pymodule_type_name_bytes: darray[u8]
        pymodule_type_name_starts: darray[usize]
        pymodule_type_name_lengths: darray[usize]
        # Protocol default methods (materialized Decl.Func); obligation checks only.
        protocol_default_methods: darray[Decl]
        errors: darray[ParseError]
        # Source lines of functions whose signature declared an `error[...]` return set.
        # The declared set's structure isn't modeled (consumed as an opaque signature
        # clause), but its presence exempts a raise-bearing function from the
        # RaiseWithoutErrorSet check. Recording is exhaustive over error-set functions, so a
        # line here always reflects a real declared set — never a false exemption in reverse.
        error_set_func_lines: darray[u32]
        # The SET NAME for each line above, index-parallel. Empty when the clause was not
        # the plain `error[Ident]` form; the backend then keeps the i32 error ABI.
        error_set_func_names: darray[sview]
        # Names DECLARED as `error Name:` — see the Parser field's note.
        error_set_decl_names: darray[sview]
        # Signature-level `requires`/`ensures` contracts as parallel (owning-function line, kind
        # "requires"/"ensure", predicate) rows. A pure side-channel: signature contracts are NOT
        # lowered into the body (that perturbs body-walking checks), so only the dedicated
        # signature-contract checks read these.
        signature_contract_lines: darray[u32]
        signature_contract_kinds: darray[sview]
        signature_contract_exprs: darray[Expr]
        # Discouraged explicit numeric literal suffixes, retained as parser metadata
        # because IntLit intentionally stores only its decoded numeric value.
        numeric_suffix_names: darray[sview]
        numeric_suffix_lines: darray[u32]
        # docs/125 §9 Tier-2 machine coverage rows (see MachineCoverageRow), drained from the
        # parser by parse_file. Checked in semantic once the classifier's type is known.
        machine_coverage: darray[MachineCoverageRow]
        derived_state_rules: darray[DerivedStateRule]
        typestate_postconditions: darray[TypestatePostcondition]
        # Function-scoped generic parameters, represented as parallel owner-line/name
        # rows because Decl.Func predates generic metadata and remains ABI-stable.
        # Column of each `def`'s keyword, keyed by its line. Decl.Func carries only a line,
        # but stage0's named-CONSTRUCTOR symbol is `N__for__T__L<line>_C<col>` — without the
        # column stage1 cannot spell it.
        func_decl_lines: darray[u32]
        func_decl_columns: darray[u32]
        panic_lines: darray[u32]
        panic_columns: darray[u32]
        generic_param_lines: darray[u32]
        generic_param_names: darray[sview]
        generic_struct_decls: darray[Decl]
        generic_struct_decl_names: darray[sview]
        generic_struct_decl_owners: darray[sview]
        generic_struct_decl_lines: darray[u32]
        generic_func_decls: darray[Decl]
        generic_func_decl_names: darray[sview]
        generic_func_decl_lines: darray[u32]
        generic_func_decl_owners: darray[sview]
        annotation_args: darray[sview]
        extern_params: darray[ExternParam]
        # Full type expressions for typed non-call extern globals. Decl.Extern retains only
        # the bare head (`array`), so these parallel rows preserve nested forms such as
        # `mutable array[array[Objstruct&?, 64], 64]` for backend ABI registration.
        extern_global_type_names: darray[sview]
        extern_global_type_exprs: darray[Expr]
        local_region_annotations: darray[LocalRegionAnnotation]
        # Source lines of `ghost NAME: T = v` local bindings — the ghost marker is dropped from
        # the AST, so this side-table lets the ghost-read check identify verification-only locals.
        ghost_local_lines: darray[u32]
        static_assert_conds: darray[Expr]
        static_if_conds: darray[Expr]
        static_if_lines: darray[u32]
        static_if_kinds: darray[u32]
        static_assert_msgs: darray[sview]
        static_assert_lines: darray[u32]
        # Expression provenance rows. Ordinary names are `new[region]` selectors;
        # the reserved `__inline_can` name records a postfix call-grant source line.
        allocation_region_names: darray[sview]
        allocation_region_lines: darray[u32]
        # Emitters may add derived export metadata (for example `export pymodule` wildcards)
        # after the complete AST has been parsed; keep this side table mutable like Parser's
        # working copy while preserving the surrounding AST layout.
        enum_annotations: mutable darray[EnumAnnotation]
        # Full function-value parameter type expressions, parallel to the owning lambda line.
        fn_type_param_lines: darray[u32]
        fn_type_param_exprs: darray[Expr]
        # The matching RETURN type expressions.
        fn_type_return_lines: darray[u32]
        fn_type_return_exprs: darray[Expr]
        # Named-tuple type payloads flattened into parallel side tables. The backend uses
        # these rows instead of destructuring recursive Expr.Tuple nodes in its self-hosted
        # pass: each row owns one element span and its source line.
        tuple_type_elements: darray[Expr]
        tuple_type_starts: darray[usize]
        tuple_type_counts: darray[usize]
        tuple_type_lines: darray[u32]
        # Names declared with `packed enum`; parallel file metadata because Decl.Enum's
        # stable payload does not carry layout modifiers.
        packed_enum_names: darray[sview]
        alias_names: darray[sview]
        alias_targets: darray[Expr]
        alias_target_heads: darray[sview]
        struct_names: darray[sview]
        # Index-parallel with struct_names: the module each was declared in, "" for a
        # top-level one. See Parser.struct_owners.
        struct_owners: darray[sview]
        struct_member_rows: darray[StructMember]
        struct_member_starts: darray[usize]
        struct_member_counts: darray[usize]
        enum_decl_names: darray[sview]
        # Index-parallel with enum_decl_names: the module each fieldless/const enum was
        # declared in, "" at file scope. See Parser.enum_decl_owners.
        enum_decl_owners: darray[sview]
        enum_decl_storage_heads: darray[sview]
        enum_decl_is_const: darray[bool]
        enum_decl_variant_names: darray[sview]
        # Parallel to enum_decl_variant_names: the member's VALUE, which is what a const
        # enum member compiles to. An omitted `= N` continues from the previous member.
        enum_decl_variant_values: darray[i64]
        enum_decl_variant_starts: darray[usize]
        enum_decl_variant_counts: darray[usize]
        # Payload-bearing enum declarations are flattened here so backend registration
        # need not destructure the recursive Decl.Enum hierarchy during self-hosting.
        payload_enum_names: darray[sview]
        # Index-parallel with payload_enum_names: the module that declared each enum.
        payload_enum_owners: darray[sview]
        payload_enum_is_const: darray[bool]
        payload_enum_variant_starts: darray[usize]
        payload_enum_variant_counts: darray[usize]
        payload_enum_variant_names: darray[sview]
        payload_enum_variant_field_starts: darray[usize]
        payload_enum_variant_field_counts: darray[usize]
        payload_enum_variant_fields: darray[Expr]
        payload_enum_variant_field_names: darray[sview]
        # Packed/common enum inherited payload prefix counts, parallel owner/count rows.
        enum_common_owners: darray[sview]
        # Module owner parallel to enum_common_owners; empty means file scope.
        enum_common_modules: darray[sview]
        enum_common_counts: darray[u32]
        # Full common-field metadata, parallel to the parser's registry. Owner/count rows
        # alone are enough for semantic arity checks, but ABI/codegen also need the field names
        # and declared expressions (especially for a variant-less hierarchy root whose fields
        # never appear in payload-variant metadata).
        enum_common_starts: darray[usize]
        enum_common_fields: darray[Expr]
        enum_common_field_names: darray[sview]

include "./ast_nodes.elisa"
include "./ast_side_tables.elisa"
