# Declaration identity for zero-overhead effects.
#
# Effect rows are written as ordinary source names, but terminal names are not a safe
# identity: `A::Tick` and `B::Tick` may both exist, as may `A::H` and `B::H`.  This file keeps
# that distinction in parser-owned numeric tables.  Nothing here becomes an emitted runtime
# object; the IDs disappear after static lowering.

extend Parser:
    private:
        def effect_identity_for_declaration(parser: lmut Parser, name: sview @source, owner: sview @source) -> u32:
            for index in 0..<parser.effect_identity_names.count:
                return (index + 1.usize()).u32() if parser.effect_identity_names[index] == name and parser.effect_identity_owners[index] == owner
            new_identity_id: u32 = (parser.effect_identity_names.count + 1.usize()).u32()
            parser.effect_identity_names <- parser.effect_identity_names.push(name)
            parser.effect_identity_owners <- parser.effect_identity_owners.push(owner)
            return new_identity_id

        def handler_identity_for_declaration(parser: lmut Parser, name: sview @source, owner: sview @source) -> u32:
            for index in 0..<parser.handler_identity_names.count:
                return (index + 1.usize()).u32() if parser.handler_identity_names[index] == name and parser.handler_identity_owners[index] == owner
            new_identity_id: u32 = (parser.handler_identity_names.count + 1.usize()).u32()
            parser.handler_identity_names <- parser.handler_identity_names.push(name)
            parser.handler_identity_owners <- parser.handler_identity_owners.push(owner)
            return new_identity_id

        def effect_identity_for_current_declaration(parser: lmut Parser, name: sview @source) -> u32:
            for index in 0..<parser.effect_identity_names.count:
                return (index + 1.usize()).u32() if parser.effect_identity_names[index] == name and parser.effect_identity_owners[index] == parser.current_module
            new_identity_id: u32 = (parser.effect_identity_names.count + 1.usize()).u32()
            parser.effect_identity_names <- parser.effect_identity_names.push(name)
            parser.effect_identity_owners <- parser.effect_identity_owners.push(parser.current_module)
            return new_identity_id

        def handler_identity_for_current_declaration(parser: lmut Parser, name: sview @source) -> u32:
            for index in 0..<parser.handler_identity_names.count:
                return (index + 1.usize()).u32() if parser.handler_identity_names[index] == name and parser.handler_identity_owners[index] == parser.current_module
            new_identity_id: u32 = (parser.handler_identity_names.count + 1.usize()).u32()
            parser.handler_identity_names <- parser.handler_identity_names.push(name)
            parser.handler_identity_owners <- parser.handler_identity_owners.push(parser.current_module)
            return new_identity_id

        # The family an effect identity was declared under.
        def effect_identity_family(parser: Parser&, identity_id: u32) -> sview:
            return parser.effect_identity_names[identity_id.usize() - 1.usize()] if identity_id > 0 and identity_id.usize() <= parser.effect_identity_names.count
            return ""

        # The module a handler was declared in, or "" for a top-level handler. The hidden
        # operation function is emitted inside that module, so a call site must qualify with
        # it rather than with whatever module the parser happens to be in — clone bodies are
        # rewritten after parsing, when `current_module` is empty again.
        def handler_identity_owner(parser: Parser&, identity_id: u32) -> sview:
            return parser.handler_identity_owners[identity_id.usize() - 1.usize()] if identity_id > 0 and identity_id.usize() <= parser.handler_identity_owners.count
            return ""

        def handler_identity_is_module_local(parser: Parser&, identity_id: u32) -> bool:
            return parser.handler_identity_owners[identity_id.usize() - 1.usize()] != "" if identity_id > 0 and identity_id.usize() <= parser.handler_identity_owners.count
            return false

        # Return the namespace before the terminal family in `A::Tick[T]` or `A.Tick[T]`.
        # Separators inside generic/tuple arguments are not namespace separators.
        def effect_reference_namespace(abstract: sview) -> sview:
            trusted Unsafe.UncheckedIndex:
                last_separator: mutable usize = abstract.len
                depth: mutable int = 0
                index: mutable usize = 0
                while index < abstract.len |index, last_separator, depth, abstract|:
                    byte: u8 = abstract.data[index]
                    depth <- depth + 1 if byte == 91 or byte == 40 or byte == 123
                    depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41 or byte == 125)
                    if depth == 0 and byte == 58 and index + 1.usize() < abstract.len and abstract.data[index + 1.usize()] == 58:
                        last_separator <- index
                        index <- index + 1.usize()
                    elif depth == 0 and byte == 46:
                        last_separator <- index
                    index <- index + 1.usize()
                return abstract[0:last_separator] if last_separator < abstract.len
                return ""


        def effect_ref_source_offset(parser: Parser&, effect_ref: sview, lexical_owner: sview) -> u32:
            found_offset: mutable u32 = 0
            match_count: mutable usize = 0
            for index in 0..<parser.effect_reference_starts.count |found_offset, match_count, effect_ref, lexical_owner|:
                continue if index >= parser.effect_reference_ends.count or index >= parser.effect_reference_owners.count
                continue if parser.effect_reference_owners[index] != lexical_owner
                first: usize = parser.effect_reference_starts[index]
                finish: usize = parser.effect_reference_ends[index]
                continue if finish <= first or finish > parser.tokens.count
                first_token: Token = parser.tokens[first]
                last_token: Token = parser.tokens[finish - 1.usize()]
                spelling: sview = parser.span_view(first_token.start.usize(), last_token.start.usize() + last_token.length.usize())
                if spelling == effect_ref:
                    found_offset <- first_token.start
                    match_count <- match_count + 1.usize()
            return found_offset if match_count == 1.usize()
            return 0

        def effect_module_is_lexical_ancestor(ancestor: sview, nested: sview) -> bool:
            return true if ancestor == ""
            return false if ancestor == nested or ancestor.len >= nested.len
            for index in 0..<ancestor.len:
                return false if ancestor[index] != nested[index]
            return nested[ancestor.len] == 58 and ancestor.len + 1.usize() < nested.len and nested[ancestor.len + 1.usize()] == 58


        def effect_alias_precedes_requester(alias_module: sview, alias_offset: u32, requester_module: sview, requester_offset: u32) -> (known: bool, precedes: bool):
            return (true, alias_offset < requester_offset) if alias_module == requester_module
            return (true, true) if effect_module_is_lexical_ancestor(alias_module, requester_module)
            return (true, false) if effect_module_is_lexical_ancestor(requester_module, alias_module)
            return (true, alias_offset < requester_offset)


        def effect_alias_precedes_other(left_module: sview, left_offset: u32, right_module: sview, right_offset: u32) -> (known: bool, precedes: bool):
            return (true, false) if left_module == right_module and left_offset == right_offset
            return (true, left_offset < right_offset) if left_module == right_module
            return (true, true) if effect_module_is_lexical_ancestor(left_module, right_module)
            return (true, false) if effect_module_is_lexical_ancestor(right_module, left_module)
            return (true, left_offset < right_offset)


        # Resolve only a unique, previously registered source alias. The parser does not
        # yet have Core's definite/possible import views, so any branch-qualified or
        # same-cutoff candidate is deliberately unresolved here; semantic lookup later
        # uses binding_resolve_module_alias_target with the full position-aware table.
        def effect_alias_target_at(parser: Parser&, alias_name: sview, requester_module: sview, before_offset: u32, depth: u32 = 0) -> (found: bool, known: bool, target: sview, target_module: sview, target_offset: u32):
            can Abort.Panic:
                return (false, false, "", "", 0) if depth >= 64
                selected_module: mutable sview = ""
                selected_line: mutable u32 = 0
                selected_offset: mutable u32 = 0
                best_offset: mutable u32 = 0
                found: mutable bool = false
                ambiguous: mutable bool = false
                for alias in parser.enum_annotations |selected_module, selected_line, selected_offset, best_offset, found, ambiguous, alias_name, requester_module, before_offset|:
                    continue if alias.name != "__using_alias" or alias.owner != alias_name
                    before_requester: (known: bool, precedes: bool) = effect_alias_precedes_requester(alias.module, alias.offset, requester_module, before_offset)
                    continue if not before_requester.known or not before_requester.precedes
                    branch_alias: bool = any marker in parser.enum_annotations where marker.owner == "__static_if_branch" and marker.name == "__using_alias_static_branch" and marker.detail_name == alias_name and marker.module == alias.module and marker.line == alias.line and marker.offset == alias.offset
                    if branch_alias:
                        found <- true
                        ambiguous <- true
                        continue
                    if not found:
                        selected_module <- alias.module
                        selected_line <- alias.line
                        selected_offset <- alias.offset
                        best_offset <- alias.offset
                        found <- true
                        ambiguous <- false
                    else:
                        continue if alias.module == selected_module and alias.line == selected_line and alias.offset == selected_offset
                        candidate_order: (known: bool, precedes: bool) = effect_alias_precedes_other(alias.module, alias.offset, selected_module, selected_offset)
                        selected_order: (known: bool, precedes: bool) = effect_alias_precedes_other(selected_module, selected_offset, alias.module, alias.offset)
                        if not candidate_order.known or not selected_order.known or candidate_order.precedes == selected_order.precedes:
                            ambiguous <- true
                        elif candidate_order.precedes:
                            pass
                        else:
                            selected_module <- alias.module
                            selected_line <- alias.line
                            selected_offset <- alias.offset
                            best_offset <- alias.offset
                return (false, false, "", "", 0) if not found
                return (true, false, "", "", 0) if ambiguous
                # Parser-side identity must not make a choice from either arm of a
                # static branch. Core later retains the definite/possible distinction.
                return (true, false, "", "", 0) if any marker in parser.enum_annotations where marker.owner == "__static_if_branch" and marker.name == "__using_alias_static_branch" and marker.detail_name == alias_name and marker.module == selected_module and marker.line == selected_line and marker.offset == best_offset
                selected_target: mutable sview = ""
                target_count: mutable usize = 0
                for target_row in parser.enum_annotations |selected_target, target_count, alias_name, selected_module, selected_line, selected_offset|:
                    if target_row.name == "__using_alias_target" and target_row.module == selected_module and target_row.line == selected_line and target_row.offset == selected_offset:
                        selected_target <- target_row.owner
                        target_count <- target_count + 1.usize()
                return (true, false, "", "", 0) if target_count != 1.usize() or selected_target == ""
                return (true, true, selected_target, selected_module, selected_offset)


        # Compare a written namespace with one declaration owner after applying a
        # unique prior alias at each path head. Work from the owner's tail so the parser
        # can preserve `Alias::Nested` without allocating a joined module path.
        def effect_alias_path_matches_owner(parser: Parser&, path: sview, module_owner: sview, requester_module: sview, before_offset: u32, depth: u32 = 0) -> (known: bool, matches: bool, used_alias: bool):
            can Abort.Panic:
                return (false, false, false) if depth >= 64
                separator: mutable usize = path.len
                separator_width: mutable usize = 0
                for index in 0..<path.len:
                    if index + 1.usize() < path.len and path[index] == 58 and path[index + 1.usize()] == 58:
                        separator <- index
                        separator_width <- 2
                        break
                    elif path[index] == 46:
                        separator <- index
                        separator_width <- 1
                        break
                alias_name: sview = path[0:separator]
                alias: (found: bool, known: bool, target: sview, target_module: sview, target_offset: u32) = parser.effect_alias_target_at(alias_name, requester_module, before_offset, depth)
                return (true, module_owner == path, false) if not alias.found
                return (false, false, true) if not alias.known
                suffix: sview = path[separator + separator_width:path.len] if separator < path.len else ""
                owner_prefix: mutable sview = module_owner
                if suffix != "":
                    tail_length: usize = suffix.len + 2.usize()
                    return (true, false, true) if module_owner.len <= tail_length
                    tail_start: usize = module_owner.len - tail_length
                    return (true, false, true) if module_owner[tail_start] != 58 or module_owner[tail_start + 1.usize()] != 58
                    for index in 0..<suffix.len:
                        return (true, false, true) if module_owner[tail_start + 2.usize() + index] != suffix[index]
                    owner_prefix <- module_owner[0:tail_start]
                nested: (known: bool, matches: bool, used_alias: bool) = parser.effect_alias_path_matches_owner(alias.target, owner_prefix, alias.target_module, alias.target_offset, depth + 1.u32())
                return (nested.known, nested.matches, true)


        def effect_lexical_module_rank(module_owner: sview, namespace: sview, lexical_owner: sview) -> usize:
            return 0 if lexical_owner == ""
            prefix_length: mutable usize = lexical_owner.len
            while prefix_length > 0 |prefix_length, module_owner, namespace, lexical_owner|:
                at_scope_boundary: bool = prefix_length == lexical_owner.len or (prefix_length + 1.usize() < lexical_owner.len and lexical_owner[prefix_length] == 58 and lexical_owner[prefix_length + 1.usize()] == 58)
                candidate_length: usize = prefix_length + 2.usize() + namespace.len
                if at_scope_boundary and module_owner.len == candidate_length:
                    matches_prefix: mutable bool = true
                    for index in 0..<prefix_length |matches_prefix, module_owner, lexical_owner|:
                        matches_prefix <- false if module_owner[index] != lexical_owner[index]
                    if matches_prefix and module_owner[prefix_length] == 58 and module_owner[prefix_length + 1.usize()] == 58:
                        matches_namespace: mutable bool = true
                        for index in 0..<namespace.len |matches_namespace, module_owner, namespace, prefix_length|:
                            matches_namespace <- false if module_owner[prefix_length + 2.usize() + index] != namespace[index]
                        return prefix_length + 1.usize() if matches_namespace
                prefix_length <- prefix_length - 1.usize()
            return 0


        def effect_identity_for_reference(parser: Parser&, effect_ref: sview, lexical_owner: sview, before_offset: u32 = 0) -> u32:
            abstract: sview = handler_effect_abstract(effect_ref)
            family_start: mutable usize = 0
            family_end: mutable usize = abstract.len
            family_scan: mutable usize = 0
            while family_scan < abstract.len |family_start, family_end, family_scan, abstract|:
                if abstract[family_scan] == 58 and family_scan + 1.usize() < abstract.len and abstract[family_scan + 1.usize()] == 58:
                    family_start <- family_scan + 2.usize()
                    family_scan <- family_scan + 2.usize()
                    continue
                if abstract[family_scan] == 46 or abstract[family_scan] == 91:
                    family_end <- family_scan
                    break
                family_scan <- family_scan + 1.usize()
            family: sview = abstract[family_start:family_end]
            namespace: sview = effect_reference_namespace(abstract)
            return 0 if family == ""
            # Any parser-side reference identity is provisional until the full declaration
            # scan completes: a later declaration can add a nearer qualified candidate,
            # visible alias, or a same-leaf bare collision. Preserve source spellings now
            # and resolve them in the post-parse rewrite/semantic index against complete data.
            return 0 if not parser.effect_declarations_complete
            # A qualified spelling is declaration identity, not merely a family hint.
            if namespace != "":
                # Preserve ordinary lexical qualified lookup before consulting an
                # import alias. Search the nearest lexical module and its ancestors.
                lexical_identity: mutable u32 = 0
                lexical_rank: mutable usize = 0
                lexical_ambiguous: mutable bool = false
                for index in 0..<parser.effect_identity_names.count:
                    continue if parser.effect_identity_names[index] != family
                    rank: usize = effect_lexical_module_rank(parser.effect_identity_owners[index], namespace, lexical_owner)
                    continue if rank == 0
                    if rank > lexical_rank:
                        lexical_identity <- (index + 1.usize()).u32()
                        lexical_rank <- rank
                        lexical_ambiguous <- false
                    elif rank == lexical_rank and lexical_identity != (index + 1.usize()).u32():
                        lexical_ambiguous <- true
                return 0 if lexical_ambiguous
                return lexical_identity if lexical_identity != 0

                # A unique visible alias is the second candidate. Ambiguous/possible
                # aliases fail closed; a valid alias that does not name this effect may
                # still fall through to the explicit root path below.
                alias_identity: mutable u32 = 0
                alias_ambiguous: mutable bool = false
                for index in 0..<parser.effect_identity_names.count:
                    continue if parser.effect_identity_names[index] != family
                    path_match: (known: bool, matches: bool, used_alias: bool) = parser.effect_alias_path_matches_owner(namespace, parser.effect_identity_owners[index], lexical_owner, before_offset)
                    return 0 if not path_match.known
                    if path_match.used_alias and path_match.matches:
                        found_id: u32 = (index + 1.usize()).u32()
                        alias_ambiguous <- true if alias_identity != 0 and alias_identity != found_id
                        alias_identity <- found_id
                return 0 if alias_ambiguous
                return alias_identity if alias_identity != 0

                # Root raw spelling is the last qualified candidate.
                for index in 0..<parser.effect_identity_names.count:
                    return (index + 1.usize()).u32() if parser.effect_identity_names[index] == family and parser.effect_identity_owners[index] == namespace
                return 0
            # Bare rows first prefer the declaration in the current lexical module. Top level
            # is a lexical owner like any other: a bare `Tick` written outside every module
            # names the top-level `effect Tick` when one exists, even though `A::Tick` also
            # exists. Skipping this scan for the empty owner sent that spelling into the
            # global-uniqueness rule below, which reports ambiguity — and an ambiguous row
            # disables identity checking entirely at the call site.
            for index in 0..<parser.effect_identity_names.count:
                return (index + 1.usize()).u32() if parser.effect_identity_names[index] == family and parser.effect_identity_owners[index] == lexical_owner
            # A bare top-level name is safe only when it has one declaration globally. This
            # prevents an ambiguous row from silently selecting whichever module was parsed
            # first; the old terminal-name fallback remains available to legacy callers.
            candidate: mutable u32 = 0
            for index in 0..<parser.effect_identity_names.count |candidate, family|:
                if parser.effect_identity_names[index] == family:
                    return 0 if candidate != 0
                    candidate <- (index + 1.usize()).u32()
            return candidate

        def handler_identity_for_name(parser: Parser&, handler_name: sview, lexical_owner: sview) -> u32:
            # Top level is an owner like any other; see effect_identity_for_reference.
            for index in 0..<parser.handler_identity_names.count:
                return (index + 1.usize()).u32() if parser.handler_identity_names[index] == handler_name and parser.handler_identity_owners[index] == lexical_owner
            # Otherwise only a TOP-LEVEL handler is in scope. A handler declared inside
            # another module is not reachable by its bare name: stage0 answers
            # `can Tick with H:` outside that module with `unknown effect handler "H"`.
            # The previous rule accepted any globally unique name, which silently installed
            # another module's handler.
            for index in 0..<parser.handler_identity_names.count:
                return (index + 1.usize()).u32() if parser.handler_identity_names[index] == handler_name and parser.handler_identity_owners[index] == ""
            return 0

        def annotation_identity_matches(left: Ast::EnumAnnotation, right: Ast::EnumAnnotation) -> bool:
            return left.identity_id == right.identity_id if left.identity_id != 0 and right.identity_id != 0
            return left.owner == right.owner
