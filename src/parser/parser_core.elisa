# Stage1 parser — `module Parser` core: the Parser struct/constructor, token-consumption
# helpers, block parsing, and the `can[...]` trailing-effect-grant scanner. This is the
# canonical `module Parser:` declaration; parser_expr.elisa / parser_stmt.elisa /
# parser_decl.elisa / parser_types.elisa each declare their own `extend Parser:` block
# with its own visibility section — a file's membership is visible in the file itself
# rather than encoded by this facade's include layout (see parser.elisa).
#
# Region-Inferred Allocation: there are no explicit `Arena&` parameters anywhere in the
# parser. Every AST node, side-table darray, and error entry is allocated through idiomatic
# Elisa region inference (docs/75) — the region is inferred from the call site and threaded
# implicitly, all the way out to `parse_file`'s region-polymorphic return.
#
# The `Parser` struct itself intentionally carries almost no state: `source`/`tokens`/
# `position` are the cursor over the token stream, and `errors` is the one accumulated
# side table. AST nodes are NOT held here — each is constructed as a handle into the
# unified Node store (docs/76/77) and wired directly into its parent's payload, so child
# lists live on the nodes themselves rather than in any parser-owned collection.

include "./parser_tokens.elisa"

module Parser:
    public:
        struct Parser:
            source: u8&
            tokens: darray[Token]
            position: mutable usize
            errors: mutable darray[Ast::ParseError]
            # Effect names captured by the most recent `skip_trailing_can` call (dotted
            # source spans). Overwritten on every call so a signature-line reader can pick
            # up the effect grant a return-type `expr()` consumed as a trailing `can`.
            captured_effects: mutable darray[sview]
            # Decorator names captured by the most recent `parse_decorators` call (bare
            # `@name` spans), read by the declaration that immediately follows them.
            pending_decorators: mutable darray[sview]
            # Expression-recursion depth, bounded by EXPR_DEPTH_LIMIT so a pathological
            # deeply-nested expression (`((((…))))`) emits a diagnostic instead of
            # overflowing the stack. Incremented on entry to `expr`, decremented on exit.
            depth: mutable u32
            # docs/119 §3/§6: while parsing a loop iterable/condition that may be followed
            # by a `|header|`, top-level bitwise `|` is suppressed so the expression stops
            # at the header's opening pipe. The loop parser then chains any genuine
            # (non-header) `|` itself. Off everywhere else.
            suppress_pipe: mutable bool


        # ============================================================
        # Region-polymorphic parser constructor
        # No Arena& param; region inferred from allocation site
        # ============================================================

        def Parser(source: u8&, tokens: darray[Token]) -> Parser:
            # Region is implicit; the empty error list is backed by the caller's inferred
            # region, carried through this region-polymorphic builder's return.
            return Parser{
                source: source,
                tokens: tokens,
                position: 0,
                errors: [],           # region inferred
                captured_effects: [],
                pending_decorators: [],
                depth: 0,
                suppress_pipe: false
            }

    private:
        # ============================================================
        # Token consumption helpers
        #
        # Every part file (parser_expr.elisa / parser_stmt.elisa / parser_decl.elisa /
        # parser_types.elisa) reads the token stream exclusively through this small set of
        # helpers — `cursor`/`peek`/`peek_at` for lookahead, `advance`/`accept`/`expect` for
        # consumption, and `error_at` for recording a located parse error without aborting
        # the parse (recovery keeps scanning so one bad token doesn't cascade into losing
        # every declaration after it). Nothing outside this file indexes `parser.tokens`
        # directly, which keeps the EOF/out-of-range sentinel handling in exactly one place.
        # ============================================================

        def cursor(parser: Parser&) -> Token:
            if parser.position >= parser.tokens.count:
                zero: Token = zeroed
                zero.kind <- TokenKind.Eof
                return zero
            else:
                return parser.tokens[parser.position]


        def peek(parser: Parser&) -> TokenKind:
            return parser.cursor().kind


        # Lookahead by `offset` tokens without advancing. Out-of-range reads as Eof,
        # so callers never index past the token stream.
        def peek_at(parser: Parser&, offset: usize) -> TokenKind:
            idx: usize = parser.position + offset
            if idx >= parser.tokens.count:
                return TokenKind.Eof
            else:    
                return parser.tokens[idx].kind


        # Whether the token consumed immediately before the current position was a
        # Dedent — the boundary a multi-line block expression (match arms, an indented
        # value block) leaves behind. A postfix-ternary `if` directly after that
        # boundary belongs to the NEXT statement, not the just-closed expression
        # (mirrors stage0's prevTokenIsDedent).
        def prev_is_dedent(parser: Parser&) -> bool:
            if parser.position == 0 or parser.position > parser.tokens.count:
                return false
            else:
                return parser.tokens[parser.position - 1].kind == TokenKind.Dedent


        # Consume a run of layout Newlines. Blank lines and statement terminators
        # collapse here so block/decl loops only ever see real grammar tokens.
        def skip_newlines(parser: mutable Parser&) -> void:
            while parser.peek() == TokenKind.Newline:
                parser.advance()


        def advance(parser: mutable Parser&) -> Token:
            tok: Token = parser.cursor()
            if parser.position < parser.tokens.count:
                parser.position <- parser.position + 1
            return tok


        def accept(parser: mutable Parser&, kind: TokenKind) -> bool:
            if parser.peek() == kind:
                parser.advance()
                return true
            else:
                return false


        def expect(parser: mutable Parser&, kind: TokenKind) -> Token:
            tok: Token = parser.cursor()
            if tok.kind != kind:
                err: Ast::ParseError = Ast::ParseError{
                    kind: Ast::ParseErrorKind.ExpectedToken,
                    line: tok.line,
                    column: tok.column,
                    context: Lexer::text_or_empty(tok, parser.source)
                }
                parser.errors.push(err)
            return parser.advance()


        def error_at(parser: mutable Parser&, kind: Ast::ParseErrorKind, tok: Token) -> void:
            err: Ast::ParseError = Ast::ParseError{
                kind: kind,
                line: tok.line,
                column: tok.column,
                context: Lexer::text_or_empty(tok, parser.source)
            }
            parser.errors.push(err)


        # Parse a `:`-introduced statement block and return the block's statements as a
        # `darray[Stmt]` — the side-table that hangs directly off the owning node's payload
        # (docs/76). Two layouts are accepted, matching the lexer's token model:
        #   inline    `: <stmt> NEWLINE`
        #   indented  `: NEWLINE INDENT (<stmt> NEWLINE)* DEDENT`
        # The opening Colon and all layout tokens (Newline/Indent/Dedent) are consumed
        # here, so statement parsers never see layout noise.
        # Wrap a single statement into a body darray. A region-poly return (like
        # parse_block's) so the caller adopts the darray into its region — a body
        # darray built inline in func_decl and stored straight into the Decl.Func
        # packed payload does NOT survive the region-polymorphic return.
        def single_stmt_body(parser: mutable Parser&, only: Ast::Stmt) -> darray[Ast::Stmt]:
            items: mutable darray[Ast::Stmt] = []
            items.push(only)
            return items


        def parse_block(parser: mutable Parser&) -> darray[Ast::Stmt]:
            parser.expect(TokenKind.Colon)
            items: mutable darray[Ast::Stmt] = []

            # Inline single-statement block: `if cond: return x`.
            if parser.peek() != TokenKind.Newline:
                if parser.stmt() is inline_stmt:
                    items.push(inline_stmt)
                parser.skip_trailing_can(true)
                parser.accept(TokenKind.Newline)
                return items
            else:
                # Indented block.
                parser.expect(TokenKind.Newline)
                parser.expect(TokenKind.Indent)

                while true:
                    parser.skip_newlines()
                    kind: TokenKind = parser.peek()
                    break if kind in {TokenKind.Dedent, TokenKind.Eof}
        
                    if parser.stmt() is body_stmt:
                        items.push(body_stmt)
                        parser.skip_trailing_can(true)
                        parser.accept(TokenKind.Newline)
                    else:
                        parser.advance()   # error recovery: never spin on a bad token

                parser.expect(TokenKind.Dedent)
                return items


        # docs/119 §2: a bare block expression is the RHS of `x =` / `x: T =` written
        # as NEWLINE INDENT statements whose tail expression is the value (no `:` and
        # no `do` introducer). `bare_block_ahead` is the O(1) lookahead the RHS parsers
        # use to choose this form over an ordinary value expression.
        def bare_block_ahead(parser: Parser&) -> bool:
            return parser.peek() == TokenKind.Newline and parser.peek_at(1) == TokenKind.Indent

        def parse_bare_block_value(parser: mutable Parser&) -> Ast::Expr:
            line: u32 = parser.cursor().line
            parser.expect(TokenKind.Newline)
            parser.expect(TokenKind.Indent)
            items: mutable darray[Ast::Stmt] = []
            while true:
                parser.skip_newlines()
                break if parser.peek() in {TokenKind.Dedent, TokenKind.Eof}
                if parser.stmt() is body_stmt:
                    items.push(body_stmt)
                    parser.skip_trailing_can(true)
                    parser.accept(TokenKind.Newline)
                else:
                    parser.advance()
            parser.expect(TokenKind.Dedent)
            if items.count == 0:
                return (Ast::Expr.Invalid)
            # The tail statement is the block's value; truncating it off leaves `items`
            # as the leading locals — no second darray, no copy.
            last: usize = items.count - 1
            value: Ast::Expr = parser.tail_stmt_to_value(items[last])
            items.truncate(last)
            return (Ast::Expr.Block(items, value, line))

        # docs/119 §4: the block's tail statement is its value. A trailing `if`/`elif`/
        # `else` becomes a nested `Expr.If`; a trailing block-bodied `match` becomes an
        # `Expr.Match` (same arm shape); a bare expression statement is the value itself.
        def tail_stmt_to_value(parser: mutable Parser&, s: Ast::Stmt) -> Ast::Expr:
            match s:
                Stmt.Expr(e, line):
                    return e
                Stmt.If(cond, then_body, else_body, line):
                    then_v: Ast::Expr = parser.branch_to_value(then_body)
                    else_v: Ast::Expr = parser.branch_to_value(else_body)
                    return (Ast::Expr.If(cond, then_v, else_v, line))
                Stmt.Match(scrutinee, arms, line):
                    return (Ast::Expr.Match(scrutinee, arms, line))
                _:
                    return (Ast::Expr.Invalid)

        # Convert one `if`/`else` branch body into its value expression: the branch's
        # own tail statement yields the value; any preceding statements ride a nested
        # block expression.
        def branch_to_value(parser: mutable Parser&, body: darray[Ast::Stmt]) -> Ast::Expr:
            if body.count == 0:
                return (Ast::Expr.Invalid)
            last: Ast::Stmt = body[body.count - 1]
            if body.count == 1:
                return parser.tail_stmt_to_value(last)
            else:
                line: u32 = parser.cursor().line
                # `body` is borrowed, so the leading locals must be copied (unlike
                # parse_bare_block_value, which owns and truncates its items).
                stmts: darray[Ast::Stmt] = [body[i] for i in 0..<body.count - 1]
                return (Ast::Expr.Block(stmts, parser.tail_stmt_to_value(last), line))


        # docs/119 §3/§6: loop-expression headers. `capture_header_ahead` reports whether
        # the current `|` opens a `|item,…|` header whose closing pipe is immediately
        # followed by the loop body `:` or a `-> yield` (a bitwise `a | b | c` never
        # satisfies this — its second top-level pipe is followed by an operand).
        def capture_header_ahead(parser: Parser&) -> bool:
            if parser.peek() != TokenKind.Pipe or parser.peek_at(1) != TokenKind.Ident:
                return false
            depth: mutable int = 0
            i: mutable usize = 1
            while true:
                k: TokenKind = parser.peek_at(i)
                if k == TokenKind.Eof:
                    return false
                if k == TokenKind.LParen or k == TokenKind.LBracket or k == TokenKind.LBrace:
                    depth <- depth + 1
                elif k == TokenKind.RParen or k == TokenKind.RBracket or k == TokenKind.RBrace:
                    if depth > 0:
                        depth <- depth - 1
                    else:
                        return false   # left the enclosing expression: not a header
                elif k == TokenKind.Pipe:
                    if depth == 0:
                        nxt: TokenKind = parser.peek_at(i + 1)
                        return nxt == TokenKind.Colon or nxt == TokenKind.Arrow
                elif k == TokenKind.Newline:
                    # A `:` is NOT a terminator — a typed accumulator (`|n: T = 0|`)
                    # carries a depth-0 `:` before the closing pipe; the NEWLINE bound
                    # keeps the single-line scan from reaching the loop body.
                    if depth == 0:
                        return false
                i <- i + 1
            return false

        # True when positioned at a loop-header opener: a decl-led `| IDENT =` or a
        # capture header. Disambiguates the header `|` from a bitwise `|`.
        def loop_header_at(parser: Parser&) -> bool:
            if parser.peek() != TokenKind.Pipe:
                return false
            if parser.peek_at(1) == TokenKind.Ident and parser.peek_at(2) == TokenKind.Assign:
                return true
            return parser.capture_header_ahead()

        # Parse a loop iterable/condition that may be followed by a `|header|`. binary
        # parsing stops at the header's opening pipe (loop_header_at) but consumes a
        # genuine bitwise `|` normally, so a plain `parser.expr()` already yields the
        # pre-header expression (see for_stmt / while_stmt).

        # Parse `-> yield` (possibly a tuple `-> a, b`).
        def parse_yield_expr(parser: mutable Parser&) -> Ast::Expr:
            line: u32 = parser.cursor().line
            first: mutable Ast::Expr = (Ast::Expr.Invalid)
            if parser.expr() is f:
                first <- f
            if parser.peek() != TokenKind.Comma:
                return first
            elems: mutable darray[Ast::Expr] = []
            elems.push(first)
            while parser.accept(TokenKind.Comma):
                if parser.expr() is more:
                    elems.push(more)
            return (Ast::Expr.Tuple(elems, line))

        # Parse `|name = init, capture, …| [-> yield]`. Accumulator decls (`name = init`)
        # fill `decls`; bare captures are parsed and ignored (they resolve as ordinary
        # outer references — the frontend does not model the move/licensing). Returns the
        # yield expression (Invalid when there is no `->`), setting `has_yield`.
        def parse_loop_header(parser: mutable Parser&, decls: mutable darray[Ast::Stmt]&, has_yield: mutable bool&) -> Ast::Expr:
            parser.expect(TokenKind.Pipe)
            while true:
                name_tok: Token = parser.expect(TokenKind.Ident)
                # Optional `: T` annotation on an accumulator (`|n: u32 = 0|`) — the type
                # is a selector for resolution, not a value reference, so it is parsed and
                # dropped (like var_decl_stmt's type).
                if parser.accept(TokenKind.Colon):
                    parser.expr()
                if parser.accept(TokenKind.Assign):
                    init: mutable Ast::Expr = (Ast::Expr.Invalid)
                    saved: bool = parser.suppress_pipe
                    parser.suppress_pipe <- true
                    if parser.expr() is parsed_init:
                        init <- parsed_init
                    parser.suppress_pipe <- saved
                    decls.push((Ast::Stmt.VarDecl(Lexer::text_or_empty(name_tok, parser.source), (Ast::Expr.Invalid), init, name_tok.line)))
                break if not parser.accept(TokenKind.Comma)
            parser.expect(TokenKind.Pipe)
            if parser.accept(TokenKind.Arrow):
                has_yield <- true
                return parser.parse_yield_expr()
            has_yield <- false
            return (Ast::Expr.Invalid)

        # Wrap a loop that carries a header into a block expression whose leading
        # accumulator decls scope the loop and whose value is the yield (Invalid for the
        # statement form). Emitted as an expression statement so a value-form loop can be
        # the tail value of an enclosing bare block.
        def wrap_loop_header(parser: mutable Parser&, decls: darray[Ast::Stmt], yield_expr: Ast::Expr, loop_stmt: Ast::Stmt, line: u32) -> Ast::Stmt:
            all: mutable darray[Ast::Stmt] = [d for d in decls]
            all.push(loop_stmt)
            return (Ast::Stmt.Expr((Ast::Expr.Block(all, yield_expr, line)), line))


        # Consume a trailing inline effect grant `... can E1, E2` (no block colon) that
        # follows an expression, e.g. `return f() can Memory.Allocate, Abort.Panic` or
        # `print(x can Console.Write)`. The block form `can …:` is a statement handled
        # elsewhere; this is the postfix modifier. The effect list's own commas are part
        # of the grant, so the scan stops only at a depth-0 closing bracket, line break,
        # or block colon — not at a comma.
        # Consume a trailing effect grant (`can[E1, E2]` or the bare `can E1, E2`) after an
        # expression, recording the granted effect names (dotted spans) into
        # `parser.captured_effects`. The buffer is reset on every call, so it always
        # reflects the most recent trailing `can` (empty when there was none) — a signature
        # reader uses this to recover the grant a return-type `expr()` swallowed here.
        # `guard_block_opener` = the call site is a block-body statement boundary (parse_block),
        # where the next token may be a sibling `can …:` BLOCK opener rather than a trailing
        # inline grant — do NOT consume that (it would orphan its `:`). Signature/return-type
        # callers pass false: there a `can[…]:` IS a trailing grant whose `:` is the body colon.
        def skip_trailing_can(parser: mutable Parser&, guard_block_opener: bool) -> void:
            # Clear in place (no fresh alloc — that would escape the parser's region).
            parser.captured_effects.truncate(0)

            return if parser.peek() != TokenKind.Ident

            cur: Token = parser.cursor()
            return if Lexer::text_or_empty(cur, parser.source) != "can"

            # At a block-body boundary, look ahead (non-destructively) from `can`: if the
            # clause terminates at a depth-0 block colon before any line break, it opens a
            # `can …:` statement block — leave it entirely for `stmt()` to parse.
            if guard_block_opener:
                scan: mutable usize = parser.position + 1.usize()
                depth: mutable int = 0
                is_block_opener: mutable bool = false
                while scan < parser.tokens.count:
                    k: TokenKind = parser.tokens[scan].kind
                    if k in {TokenKind.LParen, TokenKind.LBracket, TokenKind.LBrace}:
                        depth <- depth + 1
                    elif k in {TokenKind.RParen, TokenKind.RBracket, TokenKind.RBrace}:
                        break if depth == 0
                        depth <- depth - 1
                    elif depth == 0 and k == TokenKind.Colon:
                        is_block_opener <- true
                        break
                    elif depth == 0 and k in {TokenKind.Newline, TokenKind.Dedent, TokenKind.Eof}:
                        break
                    scan <- scan + 1.usize()
                return if is_block_opener

            parser.advance()                           # consume `can`

            # Bracketed form `can[E1, E2]`: the effect set is delimited by `[...]`, so
            # consume exactly the balanced brackets and stop — the following comma (if any)
            # is a parameter separator, not part of the grant.
            if parser.peek() == TokenKind.LBracket:
                parser.advance()
                while parser.peek() != TokenKind.RBracket and parser.peek() != TokenKind.Eof:
                    if parser.peek() == TokenKind.Ident:
                        parser.captured_effects.push(parser.parse_dotted_name())
                    if not parser.accept(TokenKind.Comma):
                        if parser.peek() != TokenKind.RBracket and parser.peek() != TokenKind.Eof:
                            parser.advance()          # tolerate a stray token
                parser.accept(TokenKind.RBracket)
                return

            # Bare list form `can E1, E2`: the commas belong to the grant, so scan stops
            # only at a depth-0 closing bracket, line break, or block colon.
            while parser.peek() != TokenKind.Eof:
                kind: TokenKind = parser.peek()
                if kind in {TokenKind.RParen, TokenKind.RBracket, TokenKind.RBrace, TokenKind.Newline, TokenKind.Dedent, TokenKind.Colon}:
                    break
                if parser.peek() == TokenKind.Ident:
                    parser.captured_effects.push(parser.parse_dotted_name())
                if not parser.accept(TokenKind.Comma):
                    break
