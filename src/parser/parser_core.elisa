# Stage1 parser — `module Parser` core: the Parser struct/constructor, token-consumption
# helpers, block parsing, and the `can[...]` trailing-effect-grant scanner. This is the
# canonical `module Parser:` declaration; parser_expr.elisa / parser_stmt.elisa /
# parser_decl.elisa / parser_types.elisa each declare their own `extend Parser:` block
# with its own visibility section — a file's membership is visible in the file itself
# rather than encoded by this facade's include layout (see parser.elisa).
#
# Region-Inferred Allocation: there are no explicit `Arena&` parameters anywhere in the
# parser. Every AST node, side-table darray, and error entry is allocated through idiomatic
# Elisa region inference (docs/75) — the region is inferred from the call site and threaded
# implicitly, all the way out to `parse_file`'s region-polymorphic return.
#
# The `Parser` struct itself intentionally carries almost no state: `source`/`tokens`/
# `position` are the cursor over the token stream, and `errors` is the one accumulated
# side table. AST nodes are NOT held here — each is constructed as a handle into the
# unified Node store (docs/76/77) and wired directly into its parent's payload, so child
# lists live on the nodes themselves rather than in any parser-owned collection.

include "./parser_tokens.elisa"

module Parser:
    public:
        struct Parser:
            source: u8&
            tokens: darray[Token]
            position: mutable usize
            errors: mutable darray[Ast::ParseError]
            # Effect names captured by the most recent `skip_trailing_can` call (dotted
            # source spans). Overwritten on every call so a signature-line reader can pick
            # up the effect grant a return-type `expression()` consumed as a trailing `can`.
            captured_effects: mutable darray[sview]
            # Whether the most recent `struct_member_block` saw a `derive state:` block.
            # Read by `struct_declaration` to set `Decl.Struct.has_derive`: the `[state …]`
            # header is already consumed by the time the body is parsed, so the presence of
            # a matching `derive` block must be carried back out of the body parse.
            captured_has_derive: mutable bool
            # Struct-invariant predicate expressions (`invariant EXPR`) captured by the most
            # recent `struct_member_block`, in declaration order. Read by `struct_declaration`
            # to populate `Decl.Struct.invariants`. Reset at the start of each body parse.
            captured_invariants: mutable darray[Ast::Expr]
            # Per-signature capture buffers for `requires`/`ensures` predicates (reset each
            # signature by parse_signature_clauses). function_declaration drains them — with the
            # owning function line — into the file-level signature_contract_* accumulators.
            captured_contract_kinds: mutable darray[sview]
            captured_contract_exprs: mutable darray[Ast::Expr]
            # File-level accumulators (parallel line/kind/predicate), drained into File by
            # parse_file. Signature contracts stay OUT of the body — a pure side-channel.
            signature_contract_lines: mutable darray[u32]
            signature_contract_kinds: mutable darray[sview]
            signature_contract_exprs: mutable darray[Ast::Expr]
            derived_state_rules: mutable darray[Ast::DerivedStateRule]
            typestate_postconditions: mutable darray[Ast::TypestatePostcondition]
            # Decorator names captured by the most recent `parse_decorators` call (bare
            # `@name` spans), read by the declaration that immediately follows them.
            pending_decorators: mutable darray[Ast::Annotation]
            annotation_args: mutable darray[sview]
            extern_params: mutable darray[Ast::ExternParam]
            local_region_annotations: mutable darray[Ast::LocalRegionAnnotation]
            # Source lines of `ghost NAME: T = v` locals (marker dropped from the AST).
            ghost_local_lines: mutable darray[u32]
            static_assert_conds: mutable darray[Ast::Expr]
            # `static if/elif/else COND:` branch selection. The parser keeps EVERY branch
            # (a name declared in two branches is not a duplicate), so the condition has to
            # survive for the backend to pick one -- otherwise a per-target `const` is
            # declared once per branch and everything downstream of it declines.
            # Parallel rows, keyed to the branch's `Decl.Scoped` line.
            static_if_conds: mutable darray[Ast::Expr]
            static_if_lines: mutable darray[u32]
            static_if_kinds: mutable darray[u32]
            static_assert_msgs: mutable darray[sview]
            static_assert_lines: mutable darray[u32]
            # Parallel expression-provenance rows; `__inline_can` is the postfix-grant
            # sentinel alongside ordinary `new[region]` region names.
            allocation_region_names: mutable darray[sview]
            allocation_region_lines: mutable darray[u32]
            enum_annotations: mutable darray[Ast::EnumAnnotation]
            # Full type expressions for typed function-value parameters. The legacy annotation
            # rows retain only a head token; these rows preserve generic applications such as
            # `fn(Slice[T]) -> i64` for backend ABI resolution.
            fn_type_param_lines: mutable darray[u32]
            fn_type_param_exprs: mutable darray[Ast::Expr]
            # Expression-recursion depth, bounded by EXPR_DEPTH_LIMIT so a pathological
            # deeply-nested expression (`((((…))))`) emits a diagnostic instead of
            # overflowing the stack. Incremented on entry to `expression`, decremented on exit.
            depth: mutable u32
            # docs/119 §3/§6: while parsing a loop iterable/condition that may be followed
            # by a `|header|`, top-level bitwise `|` is suppressed so the expression stops
            # at the header's opening pipe. The loop parser then chains any genuine
            # (non-header) `|` itself. Off everywhere else.
            suppress_pipe: mutable bool
            # docs/123: while parsing a `machine` header clause, a top-level `->` is the
            # yield introducer, not the function-type arrow — suppressed like the pipe.
            suppress_arrow: mutable bool
            # While parsing the scrutinee of `expect EXPR as PATTERN`, qualified `as`
            # is the statement delimiter rather than the packed-pattern expression operator.
            suppress_as_pattern: mutable bool
            # True while parsing a design-by-contract / law predicate (`requires`, `ensure`,
            # `invariant`, `law N(...) = <pred>`). Enables the contract-only grammar —
            # unbounded `forall/exists VAR: PRED` quantifiers and the `implies`/`=>`
            # implication infix — inside parenthesized sub-groups, so a nested predicate
            # like `(forall i: A implies B) implies (forall j: C)` parses. Off everywhere
            # else, so ordinary expressions treat `implies` as a plain identifier.
            in_contract: mutable bool
            # True while parsing inside a `can ComplexFlow:` grant (docs/125 §6b) — the
            # documented escape hatch from the flow-strict "no block `if`" rule. Block-ifs
            # under it (transitively, through nested blocks) are NOT tagged `__block_if`,
            # so the flow-strict census does not flag them, matching stage0.
            in_complex_flow: mutable bool
            # docs/123: top-level decls synthesized by a statement-level desugar (the
            # machine's hoisted mode enum), drained into top_decls by parse_file.
            pending_decls: mutable darray[Ast::Decl]
            # Protocol DEFAULT methods materialized as Decl.Func, checked ONLY by the
            # ensure/decreases obligation checks (NOT drained into top_decls, so the full
            # check suite does not over-fire on protocol-scoped methods).
            protocol_default_methods: mutable darray[Ast::Decl]
            # docs/123: per-file machine counter selecting synthesized machine names.
            machine_count: mutable usize
            active_pool_depth: mutable u32
            # Source lines of every function whose signature declares an `error[...]` return
            # set. Drained into `File.error_set_func_lines` by parse_file. A raise-bearing
            # function whose line is here is exempt from RaiseWithoutErrorSet. Recording is
            # exhaustive (every error-set function's line is pushed), so a line collision can
            # only over-exempt (a sound miss), never falsely flag.
            error_set_func_lines: mutable darray[u32]
            numeric_suffix_names: mutable darray[sview]
            numeric_suffix_lines: mutable darray[u32]
            # Set by parse_signature_clauses when it consumes a top-level `error[...]` return
            # set on the current signature line; read (and reset) by function_declaration.
            signature_has_error_set: mutable bool
            # docs/125 §9 Tier-2: machine-over coverage rows (Ast::MachineCoverageRow) accumulated
            # as classifier-input machines are parsed; drained into File.machine_coverage by
            # parse_file, checked in semantic once the classifier's return type is known.
            machine_coverage: mutable darray[Ast::MachineCoverageRow]
            # True only while parsing a bare/captured value block. Such a block may
            # use a bare comma tuple as its final value; ordinary statement blocks may not.
            in_value_block: mutable bool
            # Enables the expression-level `SOURCE where ...` view grammar while
            # parsing an explicitly parenthesized value group.
            in_where_group: mutable bool
            # True while parsing a TYPE annotation (a function RETURN type). A `fn(A)->R` type
            # here is followed by the enclosing `:` (the function body), which a lambda VALUE's
            # block-body branch would otherwise greedily consume — suppress that consumption.
            in_type_annotation: mutable bool
            current_struct_is_guest: mutable bool
            current_struct_has_stride: mutable bool
            current_struct_stride: mutable u32
            declared_thread_slots: mutable darray[sview]
            lmut_param_names: mutable darray[sview]
            mutable_param_names: mutable darray[sview]
            # Per-signature buffer of plain `fulfills LawName` clause names (no `is`
            # subject). Reset at each parse_signature_clauses; drained by
            # function_declaration into a fn-keyed annotation for effect-law checking.
            pending_fulfills: mutable darray[sview]
            # Per-signature `fulfills SUBJECT is LAW` clauses (parallel subject/law rows),
            # drained by function_declaration into fn-keyed annotations for frame-law checking.
            pending_fulfills_is_subject: mutable darray[sview]
            pending_fulfills_is_law: mutable darray[sview]
            # Generic type/value parameters keyed by their owning function's source
            # line. Drained into File so semantic resolution can scope `T`, `K`, `N`,
            # etc. without widening them to file-global symbols.
            generic_param_lines: mutable darray[u32]
            generic_param_names: mutable darray[sview]
            # Packed enum declaration names. `Decl.Enum` predates layout metadata;
            # this file side-table preserves the semantic distinction for Store checks.
            packed_enum_names: mutable darray[sview]
            pending_packed_decl: mutable bool
            enum_common_owners: mutable darray[sview]
            enum_common_counts: mutable darray[u32]
            captured_enum_common_count: mutable u32


        # ============================================================
        # Region-polymorphic parser constructor
        # No Arena& param; region inferred from allocation site
        # ============================================================

        def Parser(source: u8&, tokens: darray[Token]) -> Parser:
            # Region is implicit; the empty error list is backed by the caller's inferred
            # region, carried through this region-polymorphic builder's return.
            return Parser{
                source: source,
                tokens: tokens,
                position: 0,
                errors: [],           # region inferred
                captured_effects: [],
                captured_has_derive: false,
                captured_invariants: [],
                captured_contract_kinds: [],
                captured_contract_exprs: [],
                signature_contract_lines: [],
                signature_contract_kinds: [],
                signature_contract_exprs: [],
                derived_state_rules: [],
                typestate_postconditions: [],
                pending_decorators: [],
                annotation_args: [],
                extern_params: [],
                local_region_annotations: [],
                ghost_local_lines: [],
                static_assert_conds: [],
                static_if_conds: [],
                static_if_lines: [],
                static_if_kinds: [],
                static_assert_msgs: [],
                static_assert_lines: [],
                allocation_region_names: [],
                allocation_region_lines: [],
                enum_annotations: [],
                fn_type_param_lines: [],
                fn_type_param_exprs: [],
                depth: 0,
                suppress_pipe: false,
                suppress_arrow: false,
                suppress_as_pattern: false,
                in_contract: false,
                in_complex_flow: false,
                pending_decls: [],
                protocol_default_methods: [],
                machine_count: 0,
                active_pool_depth: 0,
                error_set_func_lines: [],
                numeric_suffix_names: [],
                numeric_suffix_lines: [],
                signature_has_error_set: false,
                machine_coverage: [],
                in_value_block: false,
                in_where_group: false,
                in_type_annotation: false,
                current_struct_is_guest: false,
                current_struct_has_stride: false,
                current_struct_stride: 0,
                declared_thread_slots: [],
                lmut_param_names: [],
                mutable_param_names: [],
                pending_fulfills: [],
                pending_fulfills_is_subject: [],
                pending_fulfills_is_law: [],
                generic_param_lines: [],
                generic_param_names: [],
                packed_enum_names: [],
                pending_packed_decl: false,
                enum_common_owners: [],
                enum_common_counts: [],
                captured_enum_common_count: 0
            }

    private:
        # ============================================================
        # Token consumption helpers
        #
        # Every part file (parser_expr.elisa / parser_stmt.elisa / parser_decl.elisa /
        # parser_types.elisa) reads the token stream exclusively through this small set of
        # helpers — `cursor`/`peek`/`peek_at` for lookahead, `advance`/`accept`/`expect` for
        # consumption, and `error_at` for recording a located parse error without aborting
        # the parse (recovery keeps scanning so one bad token doesn't cascade into losing
        # every declaration after it). Nothing outside this file indexes `parser.tokens`
        # directly, which keeps the EOF/out-of-range sentinel handling in exactly one place.
        # ============================================================

        def cursor(parser: Parser&) -> Token:
            parser.tokens[parser.position] return if parser.position < parser.tokens.count
            zero: Token = zeroed
            zero.kind <- TokenKind.Eof
            return zero


        def peek(parser: Parser&) -> TokenKind:
            return parser.cursor().kind


        # Lookahead by `offset` tokens without advancing. Out-of-range reads as Eof,
        # so callers never index past the token stream.
        def peek_at(parser: Parser&, offset: usize) -> TokenKind:
            token_index: usize = parser.position + offset
            return TokenKind.Eof if token_index >= parser.tokens.count else parser.tokens[token_index].kind


        # Whether the token consumed immediately before the current position was a
        # Dedent — the boundary a multi-line block expression (match arms, an indented
        # value block) leaves behind. A postfix-ternary `if` directly after that
        # boundary belongs to the NEXT statement, not the just-closed expression
        # (mirrors stage0's prevTokenIsDedent).
        def prev_is_dedent(parser: Parser&) -> bool:
            return parser.position != 0 and parser.position <= parser.tokens.count and parser.tokens[parser.position - 1].kind == TokenKind.Dedent


        # Consume a run of layout Newlines. Blank lines and statement terminators
        # collapse here so block/declaration loops only ever see real grammar tokens.
        def skip_newlines(parser: lmut Parser) -> void:
            while parser.peek() == TokenKind.Newline |parser|:
                parser, _ <- parser.advance()


        def advance(parser: lmut Parser) -> Token:
            token: Token = parser.cursor()
            parser.position <-
                if parser.position < parser.tokens.count:
                   parser.position + 1
                else:
                    parser.position
            return token


        def accept(parser: lmut Parser, kind: TokenKind) -> bool:
            false return if parser.peek() != kind
            parser, _ <- parser.advance()
            return true


        def expect(parser: lmut Parser, kind: TokenKind) -> Token:
            current_token: Token = parser.cursor()
            if current_token.kind != kind:
                parser <- parser.error_at(Ast::ParseErrorKind.ExpectedToken, current_token)
            rebind advanced_token: Token, parser = parser.advance()
            return advanced_token


        def error_at(parser: lmut Parser, kind: Ast::ParseErrorKind, token: Token) -> void:
            parse_error: Ast::ParseError = Ast::ParseError{
                kind: kind,
                line: token.line,
                column: token.column,
                context: Lexer::text_or_empty(token, parser.source)
            }
            parser.errors <- parser.errors.push(parse_error)


        # Parse a `:`-introduced statement block and return the block's statements as a
        # `darray[Stmt]` — the side-table that hangs directly off the owning node's payload
        # (docs/76). Two layouts are accepted, matching the lexer's token model:
        #   inline    `: <statement> NEWLINE`
        #   indented  `: NEWLINE INDENT (<statement> NEWLINE)* DEDENT`
        # The opening Colon and all layout tokens (Newline/Indent/Dedent) are consumed
        # here, so statement parsers never see layout noise.
        # Wrap a single statement into a body darray. A region-poly return (like
        # parse_block's) so the caller adopts the darray into its region — a body
        # darray built inline in function_declaration and stored straight into the Decl.Func
        # packed payload does NOT survive the region-polymorphic return.
        def single_statement_body(parser: lmut Parser, only_statement: Ast::Stmt) -> darray[Ast::Stmt]:
            # A one-element list literal, region-poly like parse_block's return so the
            # caller adopts it into its region.
            return [only_statement]


        def parse_block(parser: lmut Parser) -> darray[Ast::Stmt]:
            parser, _ <- parser.expect(TokenKind.Colon)
            is_inline: bool = parser.peek() != TokenKind.Newline
            # Same tuple-guard-if parse gotcha as `advance_if` / `parse_block_if`
            # (parser_stmt_control.elisa) — a ternary combining two lmut-threading calls
            # mis-parses, so each form is a cond-guarded helper called unconditionally.
            rebind inline_items: darray[Ast::Stmt], parser = parser.parse_inline_block_if(is_inline)
            inline_items return if is_inline
            rebind indented_items: darray[Ast::Stmt], parser = parser.parse_indented_block_if(not is_inline)
            return indented_items

        # Inline single-statement block: `if condition: return x`.
        def parse_inline_block_if(parser: lmut Parser, cond: bool) -> darray[Ast::Stmt]:
            empty_body: darray[Ast::Stmt] = []
            empty_body return if not cond
            items: mutable darray[Ast::Stmt] = []
            rebind __m_179: Ast::Stmt?, parser = parser.statement()
            if __m_179 is inline_statement:
                items.push(inline_statement)
            parser <- parser.skip_trailing_can(true)
            parser, _ <- parser.accept(TokenKind.Newline)
            return items

        # Indented block.
        def parse_indented_block_if(parser: lmut Parser, cond: bool) -> darray[Ast::Stmt]:
            empty_body: darray[Ast::Stmt] = []
            empty_body return if not cond
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)
            items: mutable darray[Ast::Stmt] = []

            while true |parser|:
                parser <- parser.skip_newlines()
                break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof
                rebind __m_192: Ast::Stmt?, parser = parser.statement()
                if __m_192 is body_statement:
                    items.push(body_statement)
                    parser <- parser.skip_trailing_can(true)
                    parser, _ <- parser.accept(TokenKind.Newline)
                else:
                    parser, _ <- parser.advance()   # error recovery: never spin on a bad token

            parser, _ <- parser.expect(TokenKind.Dedent)
            return items


        # docs/119 §2: a bare block expression is the RHS of `x =` / `x: T =` written
        # as NEWLINE INDENT statements whose tail expression is the value (no `:` and
        # no `do` introducer). `bare_block_ahead` is the O(1) lookahead the RHS parsers
        # use to choose this form over an ordinary value expression.
        def bare_block_ahead(parser: Parser&) -> bool:
            return parser.peek() == TokenKind.Newline and parser.peek_at(1) == TokenKind.Indent

        # docs/119 §6 for value blocks: `x = |caps|` NEWLINE INDENT … — a capture
        # header licensing the named outer mutables for mutation inside the block.
        # The header shape is strict (`|IDENT(, IDENT)*|` then NEWLINE INDENT), so a
        # bitwise `|` can never match. Captures are consumed but not modeled (E4
        # enforcement is stage0's job; stage1 resolves the block body normally).
        def value_capture_header_ahead(parser: Parser&) -> bool:
            false return if parser.peek() != TokenKind.Pipe or parser.peek_at(1) != TokenKind.Ident
            # Scan `IDENT (, IDENT)*`; the yielded cursor lands on the closing pipe.
            closing_pipe_index: mutable usize = 1
            while parser.peek_at(closing_pipe_index) == TokenKind.Ident |parser, closing_pipe_index|:
                closing_pipe_index <- closing_pipe_index + 1
                if parser.peek_at(closing_pipe_index) == TokenKind.Comma:
                    closing_pipe_index <- closing_pipe_index + 1
                else:
                    break
            return parser.peek_at(closing_pipe_index) == TokenKind.Pipe and parser.peek_at(closing_pipe_index + 1) == TokenKind.Newline and parser.peek_at(closing_pipe_index + 2) == TokenKind.Indent

        # The two block-expression RHS forms every `=`/`<-` site shares: bare block
        # (§2) and captured block (§6). `block_value_rhs_ahead` is the O(1) lookahead;
        # `parse_block_value_rhs` consumes the optional header then the block.
        def block_value_rhs_ahead(parser: Parser&) -> bool:
            return parser.bare_block_ahead() or parser.value_capture_header_ahead()

        def parse_block_value_rhs(parser: lmut Parser) -> Ast::Expr:
            rebind accepted_pipe: bool, parser = parser.accept(TokenKind.Pipe)
            parser <- parser.consume_capture_names() if accepted_pipe
            rebind __ret_242: Ast::Expr, parser = parser.parse_bare_block_value()
            return __ret_242

        # Consume the `IDENT (, IDENT)*` names of an already-opened capture header,
        # through its closing pipe.
        def consume_capture_names(parser: lmut Parser) -> void:
            while parser.peek() == TokenKind.Ident |parser|:
                parser, _ <- parser.advance()
                rebind accepted_comma_2: bool, parser = parser.accept(TokenKind.Comma)
                break if not accepted_comma_2
            parser, _ <- parser.expect(TokenKind.Pipe)

        def parse_bare_block_value(parser: lmut Parser) -> Ast::Expr:
            line: u32 = parser.cursor().line
            previous_value_block: bool = parser.in_value_block
            parser.in_value_block <- true
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)
            items: mutable darray[Ast::Stmt] = []
            while true |parser|:
                parser <- parser.skip_newlines()
                break if parser.peek() in {TokenKind.Dedent, TokenKind.Eof}
                rebind __m_253: Ast::Stmt?, parser = parser.statement()
                if __m_253 is body_statement:
                    items.push(body_statement)
                    parser <- parser.skip_trailing_can(true)
                    parser, _ <- parser.accept(TokenKind.Newline)
                else:
                    parser, _ <- parser.advance()
            parser, _ <- parser.expect(TokenKind.Dedent)
            parser.in_value_block <- previous_value_block
            (Ast::Expr.Invalid) return if items.count == 0
            # The tail statement is the block's value; truncating it off leaves `items`
            # as the leading locals — no second darray, no copy.
            last_index: usize = items.count - 1
            rebind value: Ast::Expr, parser = parser.tail_statement_to_value(items[last_index])
            items.truncate(last_index)
            return (Ast::Expr.Block(items, value, [], line))

        # docs/119 §4: the block's tail statement is its value. A trailing `if`/`elif`/
        # `else` becomes a nested `Expr.If`; a trailing block-bodied `match` becomes an
        # `Expr.Match` (same arm shape); a bare expression statement is the value itself.
        def tail_statement_to_value(parser: lmut Parser, statement: Ast::Stmt) -> Ast::Expr:
            if statement is Stmt.Expr(expression, line):
                return expression
            if statement is Stmt.If(condition, then_body, else_body, line):
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, parser.cursor()) if else_body.count == 0
                rebind then_value: Ast::Expr, parser = parser.branch_to_value(then_body)
                rebind else_value: Ast::Expr, parser = parser.branch_to_value(else_body)
                return (Ast::Expr.If(condition, then_value, else_value, line))
            if statement is Stmt.Match(scrutinee, arms, line):
                return (Ast::Expr.Match(scrutinee, arms, line))
            return (Ast::Expr.Invalid)

        # Convert one `if`/`else` branch body into its value expression: the branch's
        # own tail statement yields the value; any preceding statements ride a nested
        # block expression.
        def branch_to_value(parser: lmut Parser, body: darray[Ast::Stmt]) -> Ast::Expr:
            # An empty branch has no value expression — a legitimately absent value (an
            # `if` used as a value with no `else` yields this for its alternative). Absent,
            # not Invalid, so check_if_value_missing_else can flag the missing else without
            # a genuine parse error masquerading as one.
            (Ast::Expr.Absent) return if body.count == 0
            last_statement: Ast::Stmt = body[body.count - 1]
            is_single_statement: bool = body.count == 1
            line: u32 = parser.cursor().line
            # `body` is borrowed, so the leading locals must be copied (unlike
            # parse_bare_block_value, which owns and truncates its items). The
            # comprehension must run BEFORE the tail_statement_to_value rebind —
            # hoisting the rebind above it detaches the comprehension from its
            # inferred arena ("darray reserve requires an active in <arena>: scope").
            statements: darray[Ast::Stmt] = [body[statement_index] for statement_index in 0..<body.count - 1]
            rebind tail_value: Ast::Expr, parser = parser.tail_statement_to_value(last_statement)
            tail_value return if is_single_statement
            return (Ast::Expr.Block(statements, tail_value, [], line))


        # docs/119 §3/§6: loop-expression headers. `capture_header_ahead` reports whether
        # the current `|` opens a `|item,…|` header whose closing pipe is immediately
        # followed by the loop body `:` or a `-> yield` (a bitwise `a | b | c` never
        # satisfies this — its second top-level pipe is followed by an operand).
        def capture_header_ahead(parser: Parser&) -> bool:
            false return if parser.peek() != TokenKind.Pipe or parser.peek_at(1) != TokenKind.Ident
            # Scan forward for the closing depth-0 pipe; the token after it decides. Only a
            # top-level pipe or newline (or EOF) ends the scan — a depth-0 `:` does NOT, so
            # a typed accumulator `|n: T = 0|` keeps scanning to its closing pipe.
            depth: mutable int = 0
            lookahead_index: mutable usize = 1
            while true |parser, depth, lookahead_index|:
                kind: TokenKind = parser.peek_at(lookahead_index)
                false return if kind == TokenKind.Eof
                is_opener: bool = kind == TokenKind.LParen or kind == TokenKind.LBracket or kind == TokenKind.LBrace
                is_closer: bool = kind == TokenKind.RParen or kind == TokenKind.RBracket or kind == TokenKind.RBrace
                depth <- depth + 1 if is_opener
                false return if is_closer and depth == 0   # left the enclosing expression: not a header
                depth <- depth - 1 if is_closer
                at_closing_pipe: bool = depth == 0 and kind == TokenKind.Pipe
                next_kind: TokenKind = parser.peek_at(lookahead_index + 1)
                (next_kind == TokenKind.Colon or next_kind == TokenKind.Arrow) return if at_closing_pipe
                false return if depth == 0 and kind == TokenKind.Newline
                lookahead_index <- lookahead_index + 1
            return false

        # True when positioned at a loop-header opener: a declaration-led `| IDENT =` or a
        # capture header. Disambiguates the header `|` from a bitwise `|`.
        def loop_header_at(parser: Parser&) -> bool:
            false return if parser.peek() != TokenKind.Pipe
            true return if parser.peek_at(1) == TokenKind.Ident and parser.peek_at(2) == TokenKind.Assign
            return parser.capture_header_ahead()

        # Parse a loop iterable/condition that may be followed by a `|header|`. binary
        # parsing stops at the header's opening pipe (loop_header_at) but consumes a
        # genuine bitwise `|` normally, so a plain `parser.expression()` already yields the
        # pre-header expression (see for_statement / while_statement).

        # Parse `-> yield` (possibly a tuple `-> a, b`).
        def parse_yield_expression(parser: lmut Parser) -> Ast::Expr:
            line: u32 = parser.cursor().line
            rebind first_opt: Ast::Expr?, parser = parser.expression()
            first: Ast::Expr = get first_opt else (Ast::Expr.Invalid)
            first return if parser.peek() != TokenKind.Comma
            elements: mutable darray[Ast::Expr] = [first]
            while parser.accept(TokenKind.Comma) |parser|:
                rebind next_element_opt: Ast::Expr?, parser = parser.expression()
                if next_element_opt is next_element:
                    elements.push(next_element)
            return (Ast::Expr.Tuple(elements, line))

        # Consume an optional `: T` accumulator-type annotation. The type is a selector
        # for resolution, not a value reference, so it is parsed and dropped (like
        # variable_declaration_statement's type). Extracted because the guarded-tuple-
        # assign form `(parser, _) <- EXPR if COND` does not parse (same gotcha as
        # `advance_if`).
        def skip_type_annotation_if(parser: lmut Parser, cond: bool) -> void:
            return if not cond
            parser, _ <- parser.expression()

        # Either record `name` as a loop-header accumulator declaration (when `=` was
        # accepted) or as a bare capture. Extracted because `when`/`match` cannot
        # scrutinize a bool (docs/125 §6b), and both arms are multi-statement.
        # `name = init` — parse the initializer and record the accumulator declaration.
        #
        # This takes ONE regionless-ref container param (`declarations`) on purpose. The
        # initializer is a region-VALUED result (an `Expr` handle whose payload holds a
        # container — a call's `arguments` darray), so pushing it makes this a "void
        # grower", and the region-adoption that keeps that payload alive in the CALLER's
        # region only fires for a single-container grower (the soundness gate in
        # analyzer_region_param_inference.go: with two containers a value ambient-bound to
        # one could be inserted into the other, an escape the handle-level checker does not
        # catch). Merged with the capture push, this had TWO container params, adoption was
        # skipped, and the payload landed in this function's auto region and was freed on
        # return — leaving `arguments` dangling. `|i = f(n)|` then crashed the resolver with
        # a garbage child handle, while `|i = name|` (no container payload) and `|i = f()|`
        # (empty arg list) were fine. The two containers were never used by one call anyway.
        def consume_loop_header_accumulator(parser: lmut Parser, name_text: sview, name_token: Token, declarations: mutable darray[Ast::Stmt]&) -> void:
            saved_suppress_pipe: bool = parser.suppress_pipe
            parser.suppress_pipe <- true
            rebind initializer_opt: Ast::Expr?, parser = parser.expression()
            initializer: Ast::Expr = get initializer_opt else (Ast::Expr.Invalid)
            parser.suppress_pipe <- saved_suppress_pipe
            declarations.push((Ast::Stmt.VarDecl(name_text, (Ast::Expr.Invalid), initializer, name_token.line)))

        # Parse `|name = init, capture, …| [-> yield]`. Accumulator decls (`name = init`)
        # fill `declarations`; bare captures are collected in `captures` (docs/119 §6). Returns the
        # yield expression (Invalid when there is no `->`), setting `has_yield`.
        def parse_loop_header(parser: lmut Parser, declarations: mutable darray[Ast::Stmt]&, captures: mutable darray[sview]&, has_yield: mutable bool&) -> Ast::Expr:
            parser, _ <- parser.expect(TokenKind.Pipe)
            while true |parser|:
                rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
                name_text: sview = Lexer::text_or_empty(name_token, parser.source)
                # Optional `: T` annotation on an accumulator (`|n: u32 = 0|`) — the type
                # is a selector for resolution, not a value reference, so it is parsed and
                # dropped (like variable_declaration_statement's type).
                rebind accepted_colon: bool, parser = parser.accept(TokenKind.Colon)
                parser <- parser.skip_type_annotation_if(accepted_colon)
                rebind accepted_assign: bool, parser = parser.accept(TokenKind.Assign)
                # Bare name (no `=`) is a capture; `name = init` is an accumulator. Kept
                # apart so the accumulator path is a SINGLE-container grower (see above).
                captures.push(name_text) if not accepted_assign
                parser <- parser.consume_loop_header_accumulator(name_text, name_token, declarations) if accepted_assign
                rebind accepted_comma_3: bool, parser = parser.accept(TokenKind.Comma)
                break if not accepted_comma_3
            parser, _ <- parser.expect(TokenKind.Pipe)
            rebind accepted_arrow: bool, parser = parser.accept(TokenKind.Arrow)
            has_yield <- accepted_arrow
            (Ast::Expr.Invalid) return if not accepted_arrow
            rebind __ret_394: Ast::Expr, parser = parser.parse_yield_expression()
            return __ret_394

        # Wrap a loop that carries a header into a block expression whose leading
        # accumulator decls scope the loop and whose value is the yield (Invalid for the
        # statement form). Emitted as an expression statement so a value-form loop can be
        # the tail value of an enclosing bare block.
        def wrap_loop_header(parser: lmut Parser, declarations: darray[Ast::Stmt], yield_expression: Ast::Expr, loop_statement: Ast::Stmt, line: u32, captures: darray[sview]) -> Ast::Stmt:
            all_statements: mutable darray[Ast::Stmt] = [declaration for declaration in declarations]
            all_statements.push(loop_statement)
            return (Ast::Stmt.Expr((Ast::Expr.Block(all_statements, yield_expression, captures, line)), line))


        # Consume a trailing inline effect grant `... can E1, E2` (no block colon) that
        # follows an expression, e.g. `return f() can Memory.Allocate, Abort.Panic` or
        # `print(x can Console.Write)`. The block form `can …:` is a statement handled
        # elsewhere; this is the postfix modifier. The effect list's own commas are part
        # of the grant, so the scan stops only at a depth-0 closing bracket, line break,
        # or block colon — not at a comma.
        # Consume a trailing effect grant (`can[E1, E2]` or the bare `can E1, E2`) after an
        # expression, recording the granted effect names (dotted spans) into
        # `parser.captured_effects`. The buffer is reset on every call, so it always
        # reflects the most recent trailing `can` (empty when there was none) — a signature
        # reader uses this to recover the grant a return-type `expression()` swallowed here.
        # `guard_block_opener` = the call site is a block-body statement boundary (parse_block),
        # where the next token may be a sibling `can …:` BLOCK opener rather than a trailing
        # inline grant — do NOT consume that (it would orphan its `:`). Signature/return-type
        # callers pass false: there a `can[…]:` IS a trailing grant whose `:` is the body colon.

        # If the current token is an identifier, consume it as a dotted effect name and
        # append it to `captured_effects`; otherwise leave the parser untouched. Extracted
        # so the two `can`-list scan loops below stay single-statement bodies.
        def push_dotted_effect_if_ident(parser: lmut Parser) -> void:
            return if parser.peek() != TokenKind.Ident
            rebind name: sview, parser = parser.parse_dotted_name()
            parser.captured_effects <- parser.captured_effects.push(name)

        # Look ahead (non-destructively) from the current `can` token: true when the
        # clause terminates at a depth-0 block colon before any line break, i.e. it opens
        # a `can …:` statement block rather than a trailing inline grant.
        def block_opener_ahead(parser: Parser&) -> bool:
            scan: mutable usize = parser.position + 1.usize()
            depth: mutable int = 0
            is_block_opener: mutable bool = false
            done: mutable bool = false
            while scan < parser.tokens.count |parser, scan, depth, is_block_opener, done|:
                break if done
                kind: TokenKind = parser.tokens[scan].kind
                is_opener: bool = kind == TokenKind.LParen or kind == TokenKind.LBracket or kind == TokenKind.LBrace
                is_closer: bool = kind == TokenKind.RParen or kind == TokenKind.RBracket or kind == TokenKind.RBrace
                if is_opener:
                    depth <- depth + 1
                elif is_closer:
                    done <- true if depth == 0
                    depth <- depth - 1 if depth > 0
                elif depth == 0 and kind == TokenKind.Colon:
                    is_block_opener <- true
                    done <- true
                elif depth == 0 and (kind == TokenKind.Newline or kind == TokenKind.Dedent or kind == TokenKind.Eof):
                    done <- true
                scan <- scan + 1.usize()
            return is_block_opener

        # Bracketed form `can[E1, E2]`: the effect set is delimited by `[...]`, so consume
        # exactly the balanced brackets and stop — the following comma (if any) is a
        # parameter separator, not part of the grant. Caller has already consumed `can`.

        # Conditionally advance one token, discarding it. Local to this file so it does
        # not collide with any sibling part-file's own `advance_if` helper.
        def advance_effect_token_if(parser: lmut Parser, cond: bool) -> void:
            return if not cond
            parser, _ <- parser.advance()

        def consume_bracket_effect_list(parser: lmut Parser) -> void:
            parser, _ <- parser.advance()                          # consume `[`
            while parser.peek() != TokenKind.RBracket and parser.peek() != TokenKind.Eof |parser|:
                parser <- parser.push_dotted_effect_if_ident()
                rebind accepted_comma: bool, parser = parser.accept(TokenKind.Comma)
                # tolerate a stray token
                parser <- parser.advance_effect_token_if(not accepted_comma and parser.peek() != TokenKind.RBracket and parser.peek() != TokenKind.Eof)
            parser, _ <- parser.accept(TokenKind.RBracket)

        # Bare list form `can E1, E2`: the commas belong to the grant, so scan stops only
        # at a depth-0 closing bracket, line break, or block colon. Caller has already
        # consumed `can`.
        def consume_bare_effect_list(parser: lmut Parser) -> void:
            while parser.peek() != TokenKind.Eof |parser|:
                kind: TokenKind = parser.peek()
                break if kind in {TokenKind.RParen, TokenKind.RBracket, TokenKind.RBrace, TokenKind.Newline, TokenKind.Dedent, TokenKind.Colon}
                parser <- parser.push_dotted_effect_if_ident()
                rebind accepted_comma_4: bool, parser = parser.accept(TokenKind.Comma)
                break if not accepted_comma_4

        # Select bracket-vs-bare effect-list scanning without a ternary over two
        # lmut-Parser-threading calls (that form mis-lowers — docs/125 migration note).
        def consume_effect_list(parser: lmut Parser, is_bracket_form: bool) -> void:
            if is_bracket_form:
                parser <- parser.consume_bracket_effect_list()
            else:
                while parser.peek() != TokenKind.Eof |parser|:
                    kind: TokenKind = parser.peek()
                    break if kind == TokenKind.RParen or kind == TokenKind.RBracket or kind == TokenKind.RBrace or kind == TokenKind.Newline or kind == TokenKind.Dedent or kind == TokenKind.Colon
                    parser <- parser.push_dotted_effect_if_ident()
                    rebind accepted_comma: bool, parser = parser.accept(TokenKind.Comma)
                    break if not accepted_comma

        def skip_trailing_can(parser: lmut Parser, guard_block_opener: bool) -> void:
            # Clear in place (no fresh alloc — that would escape the parser's region).
            parser.captured_effects <- parser.captured_effects.truncate(0)

            return if parser.peek() != TokenKind.Ident

            current_token: Token = parser.cursor()
            return if Lexer::text_or_empty(current_token, parser.source) != "can"

            # At a block-body boundary: if the clause ahead is a `can …:` statement block,
            # leave it entirely for `statement()` to parse.
            return if guard_block_opener and parser.block_opener_ahead()

            parser, _ <- parser.advance()                           # consume `can`

            is_bracket_form: bool = parser.peek() == TokenKind.LBracket
            parser <- parser.consume_effect_list(is_bracket_form)
            parser.allocation_region_names <- parser.allocation_region_names.push("__inline_can") if not is_bracket_form
            parser.allocation_region_lines <- parser.allocation_region_lines.push(current_token.line) if not is_bracket_form
            # Record each granted ref beside the marker so the ungranted-call check
            # can verify FAMILY coverage (stage0 warns when the postfix grant list
            # omits a required family, e.g. arena_free under can Memory.Release only).
            if not is_bracket_form:
                for granted_ref in parser.captured_effects |parser|:
                    parser.allocation_region_names <- parser.allocation_region_names.push(granted_ref)
                    parser.allocation_region_lines <- parser.allocation_region_lines.push(current_token.line)
