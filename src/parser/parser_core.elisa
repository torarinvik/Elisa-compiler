# Stage1 parser — `module Parser` core: the Parser struct and its constructor. This is the
# canonical `module Parser:` declaration; every other part file (parser_core_cursor.elisa,
# parser_expr.elisa, parser_stmt.elisa, parser_decl.elisa, parser_types.elisa, ...) declares
# its own `extend Parser:` block with its own visibility section — a file's membership is
# visible in the file itself rather than encoded by this facade's include layout (see
# parser.elisa). Token consumption and block parsing continue in parser_core_cursor.elisa;
# block values, loop headers, and the `can[...]` scanner in parser_core_blocks.elisa.
#
# Region-Inferred Allocation: there are no explicit `Arena&` parameters anywhere in the
# parser. Every AST node, side-table darray, and error entry is allocated through idiomatic
# Elisa region inference (docs/75) — the region is inferred from the call site and threaded
# implicitly, all the way out to `parse_file`'s region-polymorphic return.
#
# The `Parser` struct itself intentionally carries almost no state: `source`/`tokens`/
# `position` are the cursor over the token stream, and `errors` is the one accumulated
# side table. AST nodes are NOT held here — each is constructed as a handle into the
# unified Node store (docs/76/77) and wired directly into its parent's payload, so child
# lists live on the nodes themselves rather than in any parser-owned collection.

include "./parser_tokens.elisa"

module Parser:
    private:
        # Protocol-bound lookup runs after the complete declaration tree is parsed and can
        # revisit every struct once per protocol-typed parameter. Keep this index deliberately
        # parser-local: it is a transient accelerator, not part of Ast::File's public metadata.
        const PROTOCOL_STRUCT_NAME_BUCKET_COUNT: usize = 1024
        const PROTOCOL_STRUCT_NAME_HASH_OFFSET: u64 = 14695981039346656037
        const PROTOCOL_STRUCT_NAME_HASH_PRIME: u64 = 1099511628211
        const PROTOCOL_STRUCT_NAME_NOT_FOUND: i64 = -1
        # The high bit marks a generic-bound metadata row in the parser's
        # line-parallel side table. Ordinary declaration lines never set it.
        const GENERIC_PARAM_BOUND_FLAG: u32 = 2147483648

    public:
        struct Parser:
            tokens: darray[Token] @source
            errors: mutable darray[Ast::ParseError] @source
            # Effect names captured by the most recent `skip_trailing_can` call (dotted
            # source spans). Overwritten on every call so a signature-line reader can pick
            # up the effect grant a return-type `expression()` consumed as a trailing `can`.
            captured_effects: mutable darray[sview @source] @source
            captured_effect_clause_present: mutable bool
            signature_effect_clause_present: mutable bool
            effect_reference_starts: mutable darray[usize] @source
            effect_reference_ends: mutable darray[usize] @source
            effect_reference_owners: mutable darray[sview @source] @source
            effect_type_references: mutable darray[Ast::EffectTypeReference] @source
            # Declaration-aware identities for abstract effects and static handlers. The
            # source spelling remains in all public metadata; these parallel tables are only
            # used to distinguish equal terminal names in different modules.
            effect_identity_names: mutable darray[sview @source] @source
            # Declaration membership excludes internal lexical-scope identities.
            effect_declaration_names: mutable darray[sview @source] @source
            effect_identity_owners: mutable darray[sview @source] @source
            handler_identity_names: mutable darray[sview @source] @source
            handler_identity_owners: mutable darray[sview @source] @source
            # Active static handler context while parsing a `can Effect with Handler(args):`
            # block. Effect operations are rewritten to ordinary direct calls as their call
            # expression is built, so no handler object or continuation reaches later phases.
            active_effect_name: mutable sview @source
            active_handler_name: mutable sview @source
            active_effect_identity_id: mutable u32
            active_handler_identity_id: mutable u32
            # The active capture slice points into this parser-owned store. Scalar bounds
            # make nested installations restorable without assigning a short-lived darray
            # into the Parser (which would violate region escape checking).
            active_handler_arguments: mutable darray[Ast::Expr] @source
            active_handler_argument_start: mutable usize
            active_handler_argument_count: mutable usize
            # Generated handler, capture, clone and typestate names (see name_store.elisa).
            handler_name_store: mutable NameStore::Store
            # Monotonic frontend-only identity for generated capture bindings.
            # It prevents nested installations from shadowing a parent's capture
            # when an operation is forwarded outward.
            handler_capture_counter: mutable usize
            # Handler capture declarations retained for installation-time default
            # materialization. A default is part of the handler value's construction,
            # not an operation-call fallback, so the static rewrite must evaluate it
            # once when the `can ... with Handler` block is entered.
            handler_capture_owners: mutable darray[sview @source] @source
            handler_capture_identity_ids: mutable darray[u32]
            handler_capture_params: mutable darray[Ast::ParamDecl] @source
            # Handler declaration sites recovered before ordinary parsing, paired with the
            # module that lexically encloses each one. Predeclaration needs the owner to
            # register the same identity the declaration itself will later resolve to, and
            # `current_module` is only meaningful once the real parse reaches that block.
            handler_predecl_sites: mutable darray[usize] @source
            handler_predecl_owners: mutable darray[sview @source] @source
            # Compile-time specializations of effect-polymorphic helper functions. These
            # rows are only a frontend rewrite cache: the generated clone is an ordinary
            # function with handler captures as explicit parameters, never a runtime
            # dictionary or continuation.
            effect_clone_sources: mutable darray[sview @source] @source
            effect_clone_source_lines: mutable darray[u32]
            effect_clone_handlers: mutable darray[sview @source] @source
            effect_clone_effects: mutable darray[sview @source] @source
            effect_clone_names: mutable darray[sview @source] @source
            effect_clone_param_counts: mutable darray[usize] @source
            effect_clone_required_counts: mutable darray[usize] @source
            effect_clone_install_lines: mutable darray[u32]
            effect_install_lines: mutable darray[u32]
            # Source-order rows are usually nondecreasing by line. Keep that fact so
            # specialization can use lower-bound lookup, with a scan fallback if a
            # transformed source ever appends out of order.
            effect_install_lines_monotonic: mutable bool
            effect_install_parents: mutable darray[u32]
            # Sparse installation metadata parallel to effect_install_lines. The old
            # annotation lookups scanned every parser annotation for each active install;
            # these rows keep the same first-match order with installation-local data.
            effect_install_effects: mutable darray[sview @source] @source
            effect_install_handlers: mutable darray[sview @source] @source
            effect_install_effect_identity_ids: mutable darray[u32]
            effect_install_handler_identity_ids: mutable darray[u32]
            effect_install_capture_lines: mutable darray[u32]
            effect_install_capture_lines_monotonic: mutable bool
            effect_install_capture_names: mutable darray[sview @source] @source
            effect_active_install: mutable u32
            effect_clone_source_line: mutable u32
            effect_context_arguments: mutable darray[Ast::Expr] @source
            effect_clone_owners: mutable darray[sview @source] @source
            # Temporary lexical context used while rebuilding a module-local clone. Clones are
            # emitted at file scope, so bare calls to source-module siblings must be qualified
            # before semantic/backend passes see the clone body.
            effect_clone_active_owner: mutable sview @source
            effect_clone_visible_names: mutable darray[sview @source] @source
            # Struct-invariant predicate expressions (`invariant EXPR`) captured by the most
            # recent `struct_member_block`, in declaration order. Read by `struct_declaration`
            # to populate `Decl.Struct.invariants`. Reset at the start of each body parse.
            captured_invariants: mutable darray[Ast::Expr] @source
            # Per-signature capture buffers for `requires`/`ensures` predicates (reset each
            # signature by parse_signature_clauses). function_declaration drains them — with the
            # owning function line — into the file-level signature_contract_* accumulators.
            captured_contract_kinds: mutable darray[sview @source] @source
            captured_contract_exprs: mutable darray[Ast::Expr] @source
            # Predicate captured by the law-block return state machine. Keeping this in the
            # parser's threaded state avoids reading a mutable local through a machine
            # transition, which can otherwise retain the state's initial Invalid payload.
            captured_law_return: mutable Ast::Expr
            # File-level accumulators (parallel line/kind/predicate), drained into File by
            # parse_file. Signature contracts stay OUT of the body — a pure side-channel.
            signature_contract_lines: mutable darray[u32]
            signature_contract_kinds: mutable darray[sview @source] @source
            signature_contract_exprs: mutable darray[Ast::Expr] @source
            derived_state_rules: mutable darray[Ast::DerivedStateRule] @source
            state_families: mutable darray[Ast::StateFamily] @source
            state_transition_edges: mutable darray[Ast::StateTransitionEdge] @source
            typestate_postconditions: mutable darray[Ast::TypestatePostcondition] @source
            # Decorator names captured by the most recent `parse_decorators` call (bare
            # `@name` spans), read by the declaration that immediately follows them.
            pending_decorators: mutable darray[Ast::Annotation] @source
            annotation_args: mutable darray[sview @source] @source
            extern_params: mutable darray[Ast::ExternParam] @source
            # Full type expressions for typed non-call extern globals. Decl.Extern retains only
            # the bare head (`array`), so these parallel rows preserve nested container shapes.
            extern_global_type_names: mutable darray[sview @source] @source
            extern_global_type_exprs: mutable darray[Ast::Expr] @source
            local_region_annotations: mutable darray[Ast::LocalRegionAnnotation] @source
            # Source lines of `ghost NAME: T = v` locals (marker dropped from the AST).
            ghost_local_lines: mutable darray[u32]
            # Spans of `assert ?` explicit proof holes (docs/98).
            assert_hole_positions: mutable darray[Ast::Pos] @source
            static_assert_conds: mutable darray[Ast::Expr] @source
            # `static if/elif/else COND:` branch selection. The parser keeps EVERY branch
            # (a name declared in two branches is not a duplicate), so the condition has to
            # survive for the backend to pick one -- otherwise a per-target `const` is
            # declared once per branch and everything downstream of it declines.
            # Parallel rows, keyed to the branch's `Decl.Scoped` line.
            static_if_conds: mutable darray[Ast::Expr] @source
            static_if_lines: mutable darray[u32]
            static_if_kinds: mutable darray[StaticIfBranch::Kind] @source
            # NESTING DEPTH of each row's chain. A chain's arms are only its own:
            # a nested chain's rows land BETWEEN an outer chain's arms, and without this
            # the outer chain's later `static elif` was skipped as already-satisfied.
            static_if_depths: mutable darray[u32]
            static_if_depth: mutable u32
            static_assert_msgs: mutable darray[sview @source] @source
            static_assert_lines: mutable darray[u32]
            # Parallel expression-provenance rows; `__inline_can` is the postfix-grant
            # sentinel alongside ordinary `new[region]` region names.
            allocation_region_names: mutable darray[sview @source] @source
            allocation_region_lines: mutable darray[u32]
            enum_annotations: mutable darray[Ast::EnumAnnotation] @source
            # Sparse source-order indices for the two annotation classes used by
            # protocol-bound lookup. The full annotation table remains authoritative;
            # these are only accelerators and are safe to fall back from.
            protocol_decl_annotation_indices: mutable darray[usize] @source
            using_annotation_indices: mutable darray[usize] @source
            # Commons registry for sealed hierarchies (docs/77): each already-parsed
            # enum's FULL common-field list (inherited + own), so a child parsed later
            # prepends its ancestors' commons with one lookup. stage0 resolves this in
            # semantic (order-independent); stage1 injects commons into variant payloads
            # at PARSE time, so the parent must be declared before the child — the same
            # parent-first order every docs/76/77 example uses.
            enum_commons_owner: mutable darray[sview @source] @source
            enum_commons_start: mutable darray[usize] @source
            enum_commons_count: mutable darray[usize] @source
            enum_commons_field: mutable darray[Ast::Expr] @source
            enum_commons_name: mutable darray[sview @source] @source
            func_decl_lines: mutable darray[u32]
            func_decl_columns: mutable darray[u32]
            # Column of each `panic` keyword, keyed by its line. The backend renders
            # `panic at FILE:LINE:COL: MESSAGE` and Expr carries only a line, so the
            # column has to travel beside it — the same shape as func_decl_columns.
            panic_lines: mutable darray[u32]
            panic_columns: mutable darray[u32]
            # Full type expressions for typed function-value parameters. The legacy annotation
            # rows retain only a head token; these rows preserve generic applications such as
            # `fn(Slice[T]) -> i64` for backend ABI resolution.
            fn_type_param_lines: mutable darray[u32]
            fn_type_param_offsets: mutable darray[u32]
            fn_type_param_exprs: mutable darray[Ast::Expr] @source
            # The RETURN type expression of a function-type annotation, keyed by the `fn`
            # token offset for same-line disambiguation. The `__lambda_return` annotation keeps only a head STRING, so
            # `-> Task[R, Pending]` lost its type arguments entirely.
            fn_type_return_lines: mutable darray[u32]
            fn_type_return_offsets: mutable darray[u32]
            fn_type_return_exprs: mutable darray[Ast::Expr] @source
            tuple_type_elements: mutable darray[Ast::Expr] @source
            tuple_type_starts: mutable darray[usize] @source
            tuple_type_counts: mutable darray[usize] @source
            tuple_type_lines: mutable darray[u32]
            tuple_type_label_offsets: mutable darray[usize] @source
            # docs/123: top-level decls synthesized by a statement-level desugar (the
            # machine's hoisted mode enum), drained into top_decls by parse_file.
            pending_decls: mutable darray[Ast::Decl] @source
            # docs/127 D9: closed `extern enum` names, so `Name.from_c(raw)` can be rewritten
            # to the synthesized validator at the point of use (Elisa has no static methods).
            foreign_enum_names: mutable darray[sview @source] @source = []
            # The `__tuple_label` rows of enum_annotations, in push order, so
            # tuple_type_label_offset counts them without walking every annotation.
            tuple_label_annotations: mutable darray[Ast::EnumAnnotation] @source = []
            # Function-local typed states, consumed by the next `start State:`.
            pending_state_decls: mutable darray[MachineStateAst] @source
            # Protocol DEFAULT methods materialized as Decl.Func, checked ONLY by the
            # ensure/decreases obligation checks (NOT drained into top_decls, so the full
            # check suite does not over-fire on protocol-scoped methods).
            protocol_default_methods: mutable darray[Ast::Decl] @source
            # Source lines of every function whose signature declares an `error[...]` return
            # set. Drained into `File.error_set_func_lines` by parse_file. A raise-bearing
            # function whose line is here is exempt from RaiseWithoutErrorSet. Recording is
            # exhaustive (every error-set function's line is pushed), so a line collision can
            # only over-exempt (a sound miss), never falsely flag.
            error_set_func_lines: mutable darray[u32]
            # Global source offsets plus one, parallel to error_set_func_lines. `#line` may
            # reuse a line across included declarations; zero stays reserved for old rows.
            error_set_func_offsets: mutable darray[u32]
            # docs/122 §5 arm-level or-pattern rule. The SPAN of every match/catch arm whose
            # top-level pattern is a `Pattern.Or` with a name-binding alternative, as three
            # index-parallel scalar columns (line, column, end column). Recorded HERE, where
            # the arm head token is in hand, because `MatchArm.pos` does not survive into the
            # semantic layer for a match STATEMENT (it does for a match EXPRESSION); scalar
            # columns on the File do survive, the way error_set_func_lines does. The rule is
            # syntactic record is refined by semantic constant resolution before reporting.
            # Drained into the File by parse_file.
            or_arm_binding_lines: mutable darray[u32]
            or_arm_binding_columns: mutable darray[u32]
            or_arm_binding_end_columns: mutable darray[u32]
            or_arm_binding_patterns: mutable darray[Ast::Pattern] @source
            # The SPAN of every non-final `_` arm head in a `match` arm block, as three
            # index-parallel scalar columns. Recorded here for the same reason the
            # or-pattern spans above are: a match STATEMENT's arms reach the semantic
            # layer with `MatchArm.pos` zeroed, so the arm head is only in hand HERE.
            # Recorded by parse_arm_block, which is the `match` wrapper -- a `catch` block
            # calls parse_arm_block_into directly, so catch arms are deliberately excluded
            # (stage0 applies the final-wildcard rule to `match`, not to `catch`).
            # Drained into the File by parse_file and reported by
            # Semantic::check_nonbool_match_guard.
            wildcard_arm_lines: mutable darray[u32]
            wildcard_arm_columns: mutable darray[u32]
            wildcard_arm_end_columns: mutable darray[u32]
            # The SET NAME for each line above, index-parallel (`error[BackendError]` ->
            # "BackendError"), or "" when the clause was not a plain `error[Ident]`. The
            # backend needs it to size an error set's ABI: a set with a PAYLOAD-carrying
            # variant returns a struct, a fieldless one returns i32.
            error_set_func_names: mutable darray[sview @source] @source
            # Names DECLARED as `error Name:`. The `error[...]` CLAUSE is not proof of an
            # error set — the source writes `error[E]`/`error[R]` for generic parameters and
            # `error[Ident]` for names that are something else entirely — so the set-name
            # capture above must be intersected with this before it can drive an ABI choice.
            error_set_decl_names: mutable darray[sview @source] @source
            numeric_suffix_names: mutable darray[sview @source] @source
            numeric_suffix_lines: mutable darray[u32]
            # docs/125 §9 Tier-2: machine-over coverage rows (Ast::MachineCoverageRow) accumulated
            # as classifier-input machines are parsed; drained into File.machine_coverage by
            # parse_file, checked in semantic once the classifier's return type is known.
            machine_coverage: mutable darray[Ast::MachineCoverageRow] @source
            declared_thread_slots: mutable darray[sview @source] @source
            # How many fields the return manifest declares in total, threaded or not. stage0
            # checks the returned tuple against THAT arity, not against the threaded tail.
            declared_return_arity: mutable usize
            lmut_param_names: mutable darray[sview @source] @source
            # Every parameter name, so a bad slot can say whether it named no parameter at
            # all or named one that simply is not `lmut` -- two different stage0 sentences.
            all_param_names: mutable darray[sview @source] @source
            mutable_param_names: mutable darray[sview @source] @source
            # Per-signature buffer of plain `fulfills LawName` clause names (no `is`
            # subject). Reset at each parse_signature_clauses; drained by
            # function_declaration into a fn-keyed annotation for effect-law checking.
            pending_fulfills: mutable darray[sview @source] @source
            # Per-signature `fulfills SUBJECT is LAW` clauses (parallel subject/law rows),
            # drained by function_declaration into fn-keyed annotations for frame-law checking.
            pending_fulfills_is_subject: mutable darray[sview @source] @source
            pending_fulfills_is_law: mutable darray[sview @source] @source
            # Generic type/value parameters keyed by their owning function's source
            # line. Drained into File so semantic resolution can scope `T`, `K`, `N`,
            # etc. without widening them to file-global symbols.
            generic_param_lines: mutable darray[u32]
            generic_param_names: mutable darray[sview @source] @source
            # Parallel generic-scope owner starts. Impl parameters are copied per member,
            # so those rows use the member's `def` offset with its legacy line key.
            generic_param_owner_offsets: mutable darray[u32] @source
            generic_struct_decls: mutable darray[Ast::Decl] @source
            generic_struct_decl_names: mutable darray[sview @source] @source
            # The module each generic TEMPLATE was declared in, "" for a top-level one.
            # Same shape and same reason as struct_owners: a template is recorded under
            # its bare name, and `register_struct_names` skips a struct whose name matches
            # a template -- so a module's own concrete `Task` was skipped because the
            # runtime declares a generic `Task[T, S]`, and every function mentioning it
            # was declined by the backend. Must come from the PARSER: only it knows the
            # enclosing module at the point the header is read.
            generic_struct_decl_owners: mutable darray[sview @source] @source
            generic_struct_decl_lines: mutable darray[u32]
            generic_func_decls: mutable darray[Ast::Decl] @source
            generic_func_decl_names: mutable darray[sview @source] @source
            generic_func_decl_lines: mutable darray[u32]
            # The module each generic template was declared in, "" at top level.
            # Captured HERE because it is lexical: by the time an instantiation's body
            # is emitted the module walk is long over, and a line-matched guess would
            # have to re-derive the nesting the parser already knew.
            generic_func_decl_owners: mutable darray[sview @source] @source
            # Packed enum declaration names. `Decl.Enum` predates layout metadata;
            # this file side-table preserves the semantic distinction for Store checks.
            packed_enum_names: mutable darray[sview @source] @source
            # Alias declarations retained in flat side tables for backend passes that must
            # avoid destructuring the recursive packed Decl hierarchy.
            alias_names: mutable darray[sview @source] @source
            alias_targets: mutable darray[Ast::Expr] @source
            alias_target_heads: mutable darray[sview @source] @source
            struct_names: mutable darray[sview @source] @source
            # The module each struct was declared in, "" for a top-level one. Struct names
            # shared ONE flat table keyed by bare name, so two modules each declaring a
            # `Work` collapsed onto one row and the second silently overwrote the first --
            # `struct literal "Work" is missing field "tally"`, for a program stage0
            # compiles. Same shape as const_owners.
            #
            # It has to come from the PARSER rather than from the backend's module walk,
            # because struct_member_starts/counts are keyed POSITIONALLY by this list's
            # index; recovering the owner separately would not line the two up.
            struct_owners: mutable darray[sview @source] @source
            # Fixed-bucket, source-order-preserving index for protocol-bound struct lookup.
            # `struct_name_next[i]` points to the previous row in the same hash bucket;
            # `struct_name_buckets[b]` stores a row index or the NOT_FOUND sentinel.
            protocol_struct_name_buckets: mutable darray[i64]
            protocol_struct_name_next: mutable darray[i64]
            # The module whose body is being parsed, "" at top level. Saved and restored
            # around a module body, so nesting yields the innermost enclosing name -- which
            # is what the backend's own module walk records for consts, so the two agree.
            current_module: mutable sview @source
            # How many declaration blocks (module / impl / static-if bodies) enclose the
            # cursor: a `public:` / `private:` section is only valid inside one (stage0).
            decl_block_depth: mutable i64
            # The FLAT-LABEL section in force for the rest of the enclosing module body
            # (`public:` on its own line, members at the same indent), "" when none.
            section_visibility: mutable sview @source
            # Set by a `private module M:` prefix and consumed by the module body that
            # immediately follows: EVERY member of such a module is private (stage0 marks
            # the NamespaceDecl itself).
            # Inside a `const module` body, where a member is BARE (`ZERO: f32 = 0.0`, no
            # `const` keyword -- the grouping supplies it). The shared declaration dispatch
            # and `private_name_ahead` both need it: a `public:` section inside a const
            # module routes its members back through the ordinary declaration path, where
            # the leading IDENT is not a keyword and would otherwise spill out of the block.
            in_const_module_body: mutable bool
            struct_member_rows: mutable darray[Ast::StructMember] @source
            struct_member_starts: mutable darray[usize] @source
            struct_member_counts: mutable darray[usize] @source
            # Copy-update literals `Type{..base, ...}` rewritten so far (File.struct_copy_bases).
            struct_copy_bases: mutable darray[Ast::StructCopyBase] @source
            # The complete struct table of a FIRST parse of this same file, seeded into the
            # second parse Parser::parse_file runs when the tokens hold a copy-update
            # literal, so a literal can be expanded even when its struct is declared later
            # in the file. Index-parallel exactly like struct_names/owners/starts/counts.
            copy_base_seed_active: mutable bool
            # Named payload patterns `Enum.Variant(field: p, _)` (docs/122 §5.7) are lowered
            # to the positional form while parsing, so no consumer of Pattern.Variant sees a
            # label. One row per enum variant: the enum's bare name, the variant, and its OWN
            # payload field names (common: fields are not pattern positions). A pattern that
            # names a variant declared later sets named_pattern_unresolved; parse_file then
            # parses again seeded with the complete table (named_pattern_seeded).
            pattern_variant_enums: mutable darray[sview @source] @source = []
            pattern_variant_names: mutable darray[sview @source] @source = []
            pattern_variant_field_starts: mutable darray[usize] @source = []
            pattern_variant_field_counts: mutable darray[usize] @source = []
            pattern_variant_field_names: mutable darray[sview @source] @source = []
            named_pattern_seeded: mutable bool = false
            named_pattern_unresolved: mutable bool = false
            copy_base_seed_names: mutable darray[sview @source] @source
            copy_base_seed_owners: mutable darray[sview @source] @source
            copy_base_seed_rows: mutable darray[Ast::StructMember] @source
            copy_base_seed_starts: mutable darray[usize] @source
            copy_base_seed_counts: mutable darray[usize] @source
            enum_decl_names: mutable darray[sview @source] @source
            # The module each fieldless/const enum was declared in, "" at file scope.
            # enum_decl_names is a flat side table, so the owner must travel beside it;
            # recovering it later from the Decl tree would lose the positional spans.
            enum_decl_owners: mutable darray[sview @source] @source
            enum_decl_storage_heads: mutable darray[sview @source] @source
            enum_decl_is_const: mutable darray[bool] @source
            enum_decl_variant_names: mutable darray[sview @source] @source
            # A const-enum member's VALUE, parallel to enum_decl_variant_names. The flat
            # metadata is the only path a CONST enum reaches the backend by (both decl-based
            # registrations start `return if is_const`), so without this the backend saw only
            # names and order — and compiled every member as its ORDINAL. `Lo = 2, Hi = 5`
            # answered 0 and 1.
            enum_decl_variant_values: mutable darray[i64]
            enum_decl_variant_starts: mutable darray[usize] @source
            enum_decl_variant_counts: mutable darray[usize] @source
            payload_enum_names: mutable darray[sview @source] @source
            # The module each payload-bearing enum was declared in, "" at file scope.
            # This is parallel to payload_enum_names and is needed because payload enums
            # share the same backend name table as inline-hierarchy members.
            payload_enum_owners: mutable darray[sview @source] @source
            payload_enum_is_const: mutable darray[bool] @source
            payload_enum_variant_starts: mutable darray[usize] @source
            payload_enum_variant_counts: mutable darray[usize] @source
            payload_enum_variant_names: mutable darray[sview @source] @source
            payload_enum_variant_field_starts: mutable darray[usize] @source
            payload_enum_variant_field_counts: mutable darray[usize] @source
            payload_enum_variant_fields: mutable darray[Ast::Expr] @source
            payload_enum_variant_field_names: mutable darray[sview @source] @source
            captured_enum_variant_names: mutable darray[sview @source] @source
            captured_enum_variant_field_starts: mutable darray[usize] @source
            captured_enum_variant_field_counts: mutable darray[usize] @source
            captured_enum_variant_fields: mutable darray[Ast::Expr] @source
            captured_enum_variant_field_names: mutable darray[sview @source] @source
            enum_common_owners: mutable darray[sview @source] @source
            # Module owner parallel to enum_common_owners; bare enum names are
            # not globally unique, so common metadata must retain its namespace.
            enum_common_modules: mutable darray[sview @source] @source
            enum_common_counts: mutable darray[u32]
            source: u8& @source
            # Byte extent supplied by the source owner. Token offsets are checked against
            # this independent extent and never establish the backing-buffer length.
            source_length: usize
            position: mutable usize
            # Innermost loop's yielded local, empty for loops without a simple yield.
            loop_break_targets: mutable darray[sview @source] @source
            # The label of each loop in `loop_break_targets` ("" when unlabelled), so
            # `break 'outer value` finds the labelled loop's yielded local.
            loop_labels: mutable darray[sview @source] @source
            # A `'name:` label just parsed, taken by the loop statement that follows it.
            pending_loop_label: mutable sview @source
            # Append-only pool for unbounded synthesized machine names (name_store.elisa).
            machine_name_store: mutable NameStore::Store
            # Append-only pool for the qualified names of body-nested modules
            # (`module Outer:` containing `module Inner:` records `Outer::Inner`) and other
            # parser-built names. Views into these pools live as long as the AST.
            module_name_store: mutable NameStore::Store
            # Shape metadata for the most recently parsed `when` scrutinee.
            when_scrutinee_columns: mutable usize
            # Expression-recursion depth, bounded by EXPR_DEPTH_LIMIT so a pathological
            # deeply-nested expression (`((((…))))`) emits a diagnostic instead of
            # overflowing the stack. Incremented on entry to `expression`, decremented on exit.
            depth: mutable u32
            active_pool_depth: mutable u32
            current_struct_stride: mutable u32
            captured_enum_common_count: mutable u32
            # Whether the most recent `struct_member_block` saw a `derive state:` block.
            # Read by `struct_declaration` to set `Decl.Struct.has_derive`: the `[state …]`
            # header is already consumed by the time the body is parsed, so the presence of
            # a matching `derive` block must be carried back out of the body parse.
            captured_has_derive: mutable bool
            # docs/119 §3/§6: while parsing a loop iterable/condition that may be followed
            # by a `|header|`, top-level bitwise `|` is suppressed so the expression stops
            # at the header's opening pipe. The loop parser then chains any genuine
            # (non-header) `|` itself. Off everywhere else.
            suppress_pipe: mutable bool
            # docs/123: while parsing a `machine` header clause, a top-level `->` is the
            # yield introducer, not the function-type arrow — suppressed like the pipe.
            suppress_arrow: mutable bool
            # Positive only while parsing a machine-over arm body. A transition arrow
            # nested inside an `if` becomes a temporary labeled-break marker, which the
            # machine lowering replaces before semantic analysis.
            machine_arm_body_depth: mutable usize
            machine_arm_branch_depth: mutable usize
            # While parsing the scrutinee of `expect EXPR as PATTERN`, qualified `as`
            # is the statement delimiter rather than the packed-pattern expression operator.
            suppress_as_pattern: mutable bool
            # True while parsing a design-by-contract / law predicate (`requires`, `ensure`,
            # `invariant`, `law N(...) = <pred>`). Enables the contract-only grammar —
            # unbounded `forall/exists VAR: PRED` quantifiers and the `implies`/`=>`
            # implication infix — inside parenthesized sub-groups, so a nested predicate
            # like `(forall i: A implies B) implies (forall j: C)` parses. Off everywhere
            # else, so ordinary expressions treat `implies` as a plain identifier.
            in_contract: mutable bool
            # True while parsing inside a `can ComplexFlow:` grant (docs/125 §6b) — the
            # documented escape hatch from the flow-strict "no block `if`" rule. Block-ifs
            # under it (transitively, through nested blocks) are NOT tagged `__block_if`,
            # so the flow-strict census does not flag them, matching stage0.
            in_complex_flow: mutable bool
            # Set by parse_signature_clauses when it consumes a top-level `error[...]` return
            # set on the current signature line; read (and reset) by function_declaration.
            signature_has_error_set: mutable bool
            # The name inside the current signature's `error[...]`, reset per signature
            # alongside signature_has_error_set.
            signature_error_set_name: mutable sview @source
            # The source occurrence selected by parse_signature_clauses after the return
            # type parser has consumed any function-valued type's own error sets.
            signature_error_set_occurrence_offset: mutable u32
            # True only while parsing a bare/captured value block. Such a block may
            # use a bare comma tuple as its final value; ordinary statement blocks may not.
            in_value_block: mutable bool
            # Enables the expression-level `SOURCE where ...` view grammar while
            # parsing an explicitly parenthesized value group.
            in_where_group: mutable bool
            # Formatting-only parses preserve grouping nodes; ordinary compilation erases them.
            preserve_parens: bool
            # True while parsing a TYPE annotation (a function RETURN type). A `fn(A)->R` type
            # here is followed by the enclosing `:` (the function body), which a lambda VALUE's
            # block-body branch would otherwise greedily consume — suppress that consumption.
            in_type_annotation: mutable bool
            current_struct_is_guest: mutable bool
            current_struct_has_stride: mutable bool
            pending_packed_decl: mutable bool
            # Extra statements one `statement()` call desugared into, drained flat right after
            # it by every statement collector (push_statement_with_pending). A multi-target
            # `rebind` lands its per-target writes here, after the temp-tuple bind (stage0's
            # pendingStmts). `rebind_counter` numbers the `__rb_N_i` temps.
            pending_statements: mutable darray[Ast::Stmt] @source
            rebind_counter: mutable usize


        # ============================================================
        # Region-polymorphic parser constructor
        # No Arena& param; region inferred from allocation site
        # ============================================================

        # Source-compatible entry for callers that already have a lexer-produced token
        # stream. The EOF offset is the strongest extent available from this API; callers
        # must still pair the tokens with the same source buffer used during lexing.
        def Parser(source: u8& @source, tokens: darray[Token], preserve_parens: bool = false) -> Parser:
            return Parser(source, Lexer::token_stream_source_length(tokens), tokens, preserve_parens)

include "./parser_core_member_tables.elisa"
