# Contextual clause words remain ordinary names beside a scope separator.
extend Parser:
    private:
        def header_token_is_qualified(parser: Parser&, offset: usize) -> bool:
            return false if parser.position >= parser.tokens.count
            return false if offset >= parser.tokens.count - parser.position
            return true if parser.peek_at(offset + 1) == TokenKind.Scope
            return parser.peek_at(offset - 1) == TokenKind.Scope if offset > 0
            return parser.position > 0 and parser.tokens[parser.position - 1].kind == TokenKind.Scope
