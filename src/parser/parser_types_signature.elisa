extend Parser:
    private:

        # Skip the clauses between a struct/enum name and its `:` block opener — generic
        # params (`[@owner]`), parent (`is Node`), backing type (`of u8`), and layout
        # (`layout(handle: u32)`, `repr(...)`). Their structure isn't modeled yet; skipping
        # to the block colon (paren/bracket-balanced) lets the body parse cleanly.
        def skip_declaration_header_clauses(parser: lmut Parser) -> void:
            while parser.peek() != TokenKind.Eof |parser, depth: int = 0|:
                kind: TokenKind = parser.peek()
                break if depth == 0 and (kind == TokenKind.Colon or kind == TokenKind.Newline)
                depth <- depth + 1 if kind in {TokenKind.LParen, TokenKind.LBracket}
                depth <- depth - 1 if kind in {TokenKind.RParen, TokenKind.RBracket}
                parser, _ <- parser.advance()


        # Consume one trailing `can` grant clause of a signature and append the captured
        # effect names. Split out of parse_signature_clauses so its scan loop stays a
        # pure guard ladder.
        def consume_signature_can_clause(parser: lmut Parser, effects: mutable darray[sview]&) -> void:
            parser <- parser.skip_trailing_can(false)
            for effect in parser.captured_effects |effects|:
                effects.push(effect)


        # Conditionally advance one token, discarding the consumed token. Extracted so
        # call sites can use a plain single-value guarded assignment (`parser <-
        # parser.advance_if(cond)`) instead of the guarded tuple-assign form
        # `a, b <- EXPR if COND`, which does not parse (the `if` is taken as a ternary
        # demanding `else`). Void: the lmut parameter threads the mutation back.
        def advance_if(parser: lmut Parser, cond: bool) -> void:
            return if not cond
            rebind _consumed: Token, parser = parser.advance()


        # Qualified `const`/`global` head dispatch (`const enum` / `const struct` /
        # `const module`|`const extend`). Routed through a helper because a ternary
        # chain combining lmut-Parser-threading calls mis-lowers (see the
        # `guard_then_body` note in parser_stmt_control.elisa).
        # Guarded single-branch wrappers: each is a no-op (returns null without
        # touching `parser`) unless its own flag is set, so calling all three
        # unconditionally from the dispatcher below is behavior-preserving even
        # though only one flag is ever true (mutually exclusive by construction
        # at the call site). Mirrors the `advance_if` early-guard-then-mutate shape.
        def parse_qualified_enum_decl(parser: lmut Parser, cond: bool) -> Ast::Decl?:
            null return if not cond
            rebind result: Ast::Decl?, parser = parser.enum_declaration(true)
            return result

        def parse_qualified_struct_decl(parser: lmut Parser, cond: bool) -> Ast::Decl?:
            null return if not cond
            rebind result: Ast::Decl?, parser = parser.struct_declaration()
            return result

        def parse_qualified_module_decl(parser: lmut Parser, cond: bool) -> Ast::Decl?:
            null return if not cond
            rebind result: Ast::Decl?, parser = parser.module_declaration()
            return result

        def parse_qualified_const_decl(parser: lmut Parser, is_enum_form: bool, is_struct_form: bool, is_module_form: bool) -> Ast::Decl?:
            rebind enum_result: Ast::Decl?, parser = parser.parse_qualified_enum_decl(is_enum_form)
            enum_result return if is_enum_form
            rebind struct_result: Ast::Decl?, parser = parser.parse_qualified_struct_decl(is_struct_form)
            struct_result return if is_struct_form
            rebind module_result: Ast::Decl?, parser = parser.parse_qualified_module_decl(is_module_form)
            module_result return if is_module_form
            return null

        # Parse an expression when COND holds; same tuple-guard-if workaround as
        # `return_value_expression_if` in parser_stmt_control.elisa.
        def expression_if(parser: lmut Parser, cond: bool) -> Ast::Expr?:
            null return if not cond
            rebind value_option: Ast::Expr?, parser = parser.expression()
            return value_option


        # Consume the trailing signature clauses of a function signature line, capturing
        # effect-grant names and returning them. Effect grants (`can[...]` / bare
        # `can E1, E2`) are structured; error sets (`raises …`) and contracts
        # (`requires`/`ensures`) are consumed without modeling. Bracket/paren depth is
        # tracked so a clause expression's inner `:`/newline never ends the loop early;
        # the loop stops at the top-level block `:` or the line break.
        def parse_signature_clauses(parser: lmut Parser, effects: mutable darray[sview]&) -> void:
            # Reset the per-signature error-set flag; set below if a top-level `error[...]`
            # return set is consumed. function_declaration reads it after this call.
            parser.signature_has_error_set <- false
            while parser.peek() != TokenKind.Eof |parser, depth: int = 0|:
                kind: TokenKind = parser.peek()
                current_token: Token = parser.cursor()
                # Stop at the block `:`, the line break, or a top-level `=` — the
                # `=` opens an expression-bodied function (`-> T = EXPR`), which
                # function_declaration consumes; it must not be eaten as a signature clause.
                break if depth == 0 and kind in {TokenKind.Colon, TokenKind.Newline, TokenKind.Assign}
                # Reuse the canonical trailing-`can` consumer so a bare `can E1, E2`
                # after `)` (no return type) is captured with the same rules.
                is_can_clause: bool = depth == 0 and kind == TokenKind.Ident and Lexer::text_or_empty(current_token, parser.source) == "can"
                parser <- parser.consume_signature_can_clause(effects) if is_can_clause
                continue if is_can_clause
                # `-> T error[E]` (or a bare `error[E]` after `)`): the declared error
                # return set. Its structure isn't modeled, but its PRESENCE exempts the
                # function from RaiseWithoutErrorSet. The following `[...]` is consumed by
                # the depth tracking on subsequent iterations.
                parser.signature_has_error_set <- true if depth == 0 and kind == TokenKind.Error
                depth <- depth + 1 if kind in {TokenKind.LParen, TokenKind.LBracket}
                depth <- depth - 1 if kind in {TokenKind.RParen, TokenKind.RBracket}
                parser, _ <- parser.advance()


        # Read a dotted identifier path (`Family` or `Family.Member`) starting at the
        # current Ident and return its whole-span source text.
        def parse_dotted_name(parser: lmut Parser) -> sview:
            start_token: Token = parser.cursor()
            start: usize = start_token.start.usize()
            parser, _ <- parser.advance()                              # first Ident
            end: usize =
                while parser.peek() == TokenKind.Dot and parser.peek_at(1) == TokenKind.Ident |parser, end: usize = (start_token.start + start_token.length).usize()| -> end:
                    parser, _ <- parser.advance()                          # `.`
                    rebind member: Token, parser = parser.advance()          # member Ident
                    end <- (member.start + member.length).usize()
            return parser.span_view(start, end)


        def struct_declaration(parser: lmut Parser) -> Ast::Decl?:
            token: Token = parser.cursor()
            # Optional single-use discipline modifier (struct-only in stage0): `linear`
            # = must be consumed exactly once before scope exit; `affine` = may be used
            # at most once but silently dropped. Contextual keywords, so matched by
            # text on the leading Ident before the `struct` keyword itself.
            head: Token = parser.cursor()
            head_is_ident: bool = parser.peek() == TokenKind.Ident
            head_text: sview = Lexer::text_or_empty(head, parser.source)
            affinity: mutable sview = ""
            affinity <- "linear" if head_is_ident and head_text == "linear"
            affinity <- "affine" if head_is_ident and head_text == "affine"
            parser <- parser.advance_if(affinity != "")

            parser, _ <- parser.expect(TokenKind.Struct)
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)

            # Typestate header `struct X[state A | B]:` — a `[` immediately followed by the
            # contextual `state` keyword. Detected here (before the header is skipped) so
            # `Decl.Struct.has_named_states` can be paired with the body's `derive` flag.
            # A generic header `[T]` or refinement clause does not open with `state`.
            has_named_states: bool = parser.peek() == TokenKind.LBracket and parser.position + 1 < parser.tokens.count and Lexer::text_or_empty(parser.tokens[parser.position + 1], parser.source) == "state"

            parser <- parser.skip_declaration_header_clauses()

            name_text: sview = Lexer::text_or_empty(name_token, parser.source)
            empty_members: darray[Ast::StructMember] = []
            no_invariants: darray[Ast::Expr] = []
            (Ast::Decl.Struct(name_text, empty_members, affinity, has_named_states, false, no_invariants, token.line)) return if parser.peek() != TokenKind.Colon

            rebind members: darray[Ast::StructMember], parser = parser.struct_member_block()
            # Drain the body-parse capture buffers (mirror of the `captured_effects`
            # read pattern): both were reset at the start of `struct_member_block`.
            has_derive: bool = parser.captured_has_derive
            invariants: mutable darray[Ast::Expr] = []
            for inv in parser.captured_invariants |invariants|:
                invariants.push(inv)

            return (Ast::Decl.Struct(name_text, members, affinity, has_named_states, has_derive, invariants, token.line))


        def enum_declaration(parser: lmut Parser, is_const: bool) -> Ast::Decl?:
            rebind token: Token, parser = parser.expect(TokenKind.Enum)
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            # Optional `of T` storage type (const enums declare an integer backing type).
            # Captured before the generic header skip so the const-enum checks can read it.
            storage_type: mutable Ast::Expr = (Ast::Expr.Invalid)
            of_token: Token = parser.cursor()
            has_of: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(of_token, parser.source) == "of"
            parser <- parser.advance_if(has_of)
            has_storage_name: bool = has_of and parser.peek() == TokenKind.Ident
            storage_name_token: Token = parser.cursor()
            parser <- parser.advance_if(has_storage_name)
            storage_type <- (Ast::Expr.Ident(Lexer::text_or_empty(storage_name_token, parser.source), storage_name_token.line)) if has_storage_name
            parser <- parser.skip_declaration_header_clauses()

            name_text: sview = Lexer::text_or_empty(name_token, parser.source)
            no_variants: darray[Ast::EnumVariant] = []
            (Ast::Decl.Enum(name_text, no_variants, is_const, storage_type, token.line)) return if parser.peek() != TokenKind.Colon

            rebind variants: darray[Ast::EnumVariant], parser = parser.enum_variant_block()
            return (Ast::Decl.Enum(name_text, variants, is_const, storage_type, token.line))


        # Handles `const`/`global` value bindings plus the `const enum`/`const struct`/
        # `const module` qualified forms. Both type and initializer are optional:
        # `const X = 1`, `const X: T = 1`, and `global buf: T` all parse.
        def const_declaration(parser: lmut Parser) -> Ast::Decl?:
            rebind token: Token, parser = parser.advance()          # consume `const` or `global`
            # A plain `const` is immutable; a `global` (with or without `mutable`) may be
            # written. Recorded so the resolver can reject `<-` on an immutable const.
            is_global: bool = Lexer::text_or_empty(token, parser.source) == "global"

            # Qualified declarations: `const enum`, `const struct`, `const module`
            # (and `const extend`, which routes to the same module reader).
            current_token: Token = parser.cursor()
            head_text: sview = Lexer::text_or_empty(current_token, parser.source)
            is_enum_form: bool = parser.peek() == TokenKind.Enum
            is_struct_form: bool = parser.peek() == TokenKind.Struct
            is_module_form: bool = parser.peek() == TokenKind.Ident and (head_text == "module" or head_text == "extend")
            rebind qualified_declaration: Ast::Decl?, parser = parser.parse_qualified_const_decl(is_enum_form, is_struct_form, is_module_form)
            qualified_declaration return if is_enum_form or is_struct_form or is_module_form

            # `global mutable NAME: T = ...` — mutable globals.
            parser, _ <- parser.accept(TokenKind.Mutable)

            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)

            type_expression: mutable Ast::Expr = (Ast::Expr.Absent)
            rebind accepted_colon: bool, parser = parser.accept(TokenKind.Colon)
            rebind parsed_type_opt: Ast::Expr?, parser = parser.expression_if(accepted_colon)
            if parsed_type_opt is parsed_type:
                type_expression <- parsed_type

            initializer: mutable Ast::Expr = (Ast::Expr.Invalid)
            rebind accepted_assign: bool, parser = parser.accept(TokenKind.Assign)
            rebind parsed_value_opt: Ast::Expr?, parser = parser.expression_if(accepted_assign)
            if parsed_value_opt is parsed_value:
                initializer <- parsed_value

            return (Ast::Decl.Const(Lexer::text_or_empty(name_token, parser.source), type_expression, initializer, is_global, token.line))

    public:
        # ============================================================
        # Region-polymorphic file parsing entry point
        # No Arena& param; region inferred from call site
        # Returns owned Ast::File with all AST nodes in inferred region
        # ============================================================

        def parse_file(source: u8&, tokens: darray[Token]) -> Ast::File:
            # Region is fully inferred: the parser's stores are backed by this function's
            # inferred auto-region, threaded into every helper call and adopted by the caller
            # on return (region-polymorphic return). No explicit Arena, no `@r`.
            parser: mutable Parser = Parser(source, tokens)
            top_items: mutable darray[Ast::Decl] = []

            while true |parser|:
                parser <- parser.skip_newlines()
                break if parser.peek() == TokenKind.Eof
                before: usize = parser.position
                parser <- parser.parse_declaration_unit(top_items)
                parser <- parser.advance_if(parser.position == before)      # guarantee forward progress

            # Drain decls synthesized by statement-level desugars (docs/123 machine
            # mode enums) so they resolve like ordinary top-level declarations.
            for pending_decl in parser.pending_decls:
                top_items.push(pending_decl)

            return Ast::File{
                top_decls: top_items,
                errors: parser.errors,
                error_set_func_lines: parser.error_set_func_lines,
                machine_coverage: parser.machine_coverage
            }
