extend Parser:
    private:
        const FULFILLS_WHOLE_FUNCTION_ROW: u32 = 3900000020
        const FULFILLS_SUBJECT_PROTOCOL_ROW: u32 = 3900000026

        # A concrete region argument in a generic type is a lifetime binding just like a
        # trailing `@r`. Preserve visible region arguments on local and parameter bindings so
        # later lifetime checks can track opaque region-parameterized values such as Handle[r].
        def parser_region_type_arguments(parser: Parser&, expression: Ast::Expr, owner_line: u32, owner_offset: u32, has_owner: bool, local_annotation_start: usize, use_offset: u32) -> darray[sview @source] @source:
            can Memory.Allocate, Abort.Panic:
                found: mutable darray[sview @source] @source = []
                match expression:
                    Expr.Index(object, argument, line):
                        match object:
                            Expr.Index(_, _, _) | Expr.IndexN(_, _, _):
                                nested: darray[sview @source] = parser_region_type_arguments(parser, object, owner_line, owner_offset, has_owner, local_annotation_start, use_offset)
                                for region in nested |found|:
                                    found.push(region) if not any existing in found where existing == region
                            _:
                                pass
                        parser_region_type_argument(parser, argument, owner_line, owner_offset, has_owner, local_annotation_start, use_offset, found)
                    Expr.IndexN(object_n, arguments, line):
                        match object_n:
                            Expr.Index(_, _, _) | Expr.IndexN(_, _, _):
                                nested: darray[sview @source] = parser_region_type_arguments(parser, object_n, owner_line, owner_offset, has_owner, local_annotation_start, use_offset)
                                for region in nested |found|:
                                    found.push(region) if not any existing in found where existing == region
                            _:
                                pass
                        for argument in arguments:
                            parser_region_type_argument(parser, argument, owner_line, owner_offset, has_owner, local_annotation_start, use_offset, found)
                    Expr.Unary(operator, operand, line) | Expr.Paren(operand, line) | Expr.Move(operand, line):
                        nested: darray[sview @source] = parser_region_type_arguments(parser, operand, owner_line, owner_offset, has_owner, local_annotation_start, use_offset)
                        for region in nested |found|:
                            found.push(region) if not any existing in found where existing == region
                    _:
                        pass
                return found

        def parser_region_type_argument(parser: Parser&, argument: Ast::Expr, owner_line: u32, owner_offset: u32, has_owner: bool, local_annotation_start: usize, use_offset: u32, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match argument:
                    Expr.Ident(name, line):
                        is_region: mutable bool = false
                        for annotation_index in 0..<parser.local_region_annotations.count |is_region, annotation_index, parser, owner_line, owner_offset, has_owner, local_annotation_start, use_offset, name|:
                            annotation: Ast::LocalRegionAnnotation = parser.local_region_annotations[annotation_index]
                            continue if annotation.region != name
                            if annotation.name == "__region_param":
                                is_region <- true if has_owner and annotation.line == owner_line and annotation.owner_offset == owner_offset
                            elif annotation.name == "__region_local" or annotation.name == "__region_arena_local":
                                continues_in_function: bool = annotation_index >= local_annotation_start and annotation.owner_offset > owner_offset and annotation.owner_offset < use_offset
                                continues_in_scope: bool = annotation.end_offset == 0 or use_offset < annotation.end_offset
                                is_region <- true if has_owner and continues_in_function and continues_in_scope
                            break if is_region
                        out.push(name) if is_region and not any existing in out where existing == name
                    Expr.Index(_, _, _) | Expr.IndexN(_, _, _) | Expr.Unary(_, _, _) | Expr.Paren(_, _) | Expr.Move(_, _):
                        nested: darray[sview @source] = parser_region_type_arguments(parser, argument, owner_line, owner_offset, has_owner, local_annotation_start, use_offset)
                        for region in nested |out|:
                            out.push(region) if not any existing in out where existing == region
                    _:
                        pass

        # Skip the clauses between a struct/enum name and its `:` block opener — generic
        # params (`[@owner]`), parent (`is Node`), backing type (`of u8`), and layout
        # (`layout(handle: u32)`, `repr(...)`). Their structure isn't modeled yet; skipping
        # to the block colon (paren/bracket-balanced) lets the body parse cleanly.
        def skip_declaration_header_clauses(parser: lmut Parser, head_is_enum: bool) -> void:
            machine over parser.position while parser.peek() != TokenKind.Eof:
                state Scan(depth: int)
                start Scan(0)

                Scan(depth), _ if depth == 0 and (parser.peek() == TokenKind.Colon or parser.peek() == TokenKind.Newline):
                    break

                Scan(depth), _ if depth == 0 and parser.peek() == TokenKind.Ident and parser.header_token_text(0) == "layout" and parser.peek_at(1) != TokenKind.LParen:
                    parser <- parser.error_removed(parser.cursor(), "bare `layout soa` has been removed; use the parenthesized clause `layout(soa, ...)`" if head_is_enum else "bare `layout soa` has been removed; use the parenthesized clause `layout(soa)`")
                    parser.position <- parser.position + 1
                    -> Scan(depth)

                Scan(depth), _ if parser.peek() == TokenKind.LParen or parser.peek() == TokenKind.LBracket:
                    parser.position <- parser.position + 1
                    -> Scan(depth + 1)

                Scan(depth), _ if parser.peek() == TokenKind.RParen or parser.peek() == TokenKind.RBracket:
                    parser.position <- parser.position + 1
                    -> Scan(depth - 1)

                Scan(depth), _:
                    parser.position <- parser.position + 1
                    -> Scan(depth)

        # Like skip_declaration_header_clauses, but CAPTURES an extern's `requires`/`require`
        # and `ensure`/`ensures` predicates into the file signature-contract side-channel (paired to
        # `extern_line`) so the precondition-violation check can read the first and the
        # backend can re-check the second at every call site (docs/127 D8 — an extern's
        # postcondition is CHECKED, not assumed, unless the extern is @trusted). Every other
        # trailing clause is skipped exactly as before. The keyword+predicate are consumed in
        # place (contract_expression advances), then the loop continues.
        def capture_extern_header_contracts(parser: lmut Parser, extern_line: u32, extern_offset: u32) -> void:
            can Abort.Panic, Memory.Allocate:
                machine over parser.position while parser.peek() != TokenKind.Eof:
                    state Scan(depth: int)
                    start Scan(0)

                    Scan(depth), _ if depth == 0 and (parser.peek() == TokenKind.Colon or parser.peek() == TokenKind.Newline):
                        break

                    Scan(depth), _ if depth == 0 and parser.peek() == TokenKind.Ident and not parser.header_token_is_qualified(0) and (parser.header_token_text(0) == "requires" or parser.header_token_text(0) == "require" or parser.header_token_text(0) == "ensure" or parser.header_token_text(0) == "ensures") and parser.peek_at(1) != TokenKind.Return:
                        parser <- parser.capture_signature_contract(parser.header_token_text(0)) can Global{Read,Write}
                        -> Scan(depth)

                    Scan(depth), _ if parser.peek() == TokenKind.LParen or parser.peek() == TokenKind.LBracket:
                        parser.position <- parser.position + 1
                        -> Scan(depth + 1)

                    Scan(depth), _ if parser.peek() == TokenKind.RParen or parser.peek() == TokenKind.RBracket:
                        parser.position <- parser.position + 1
                        -> Scan(depth - 1)

                    Scan(depth), _:
                        parser.position <- parser.position + 1
                        -> Scan(depth)
                parser <- parser.drain_signature_contracts(extern_line, extern_offset)

            # Tuple types are named-field only. Detect a parenthesized comma list whose
            # first element is not `name: Type`, without consuming the type expression.
        # stage0 reports a positional tuple type as the named field it wanted: `expected :,
        # got ,` at the first top-level comma, not `unexpected token` at the first element.
        def first_top_level_comma(parser: Parser&, start: usize, finish: usize = 0) -> Token:
            depth: mutable int = 0
            index: mutable usize = start
            scan_end: usize = finish if finish > 0 else parser.tokens.count
            while index < scan_end |depth, index|:
                kind: TokenKind = parser.tokens[index].kind
                return parser.tokens[index] if depth == 1 and kind == TokenKind.Comma
                depth <- depth + 1 if kind == TokenKind.LParen or kind == TokenKind.LBracket
                depth <- depth - 1 if kind == TokenKind.RParen or kind == TokenKind.RBracket
                break if depth <= 0 and index > start
                index <- index + 1.usize()
            return parser.tokens[start]

        def reject_positional_tuple_type_ahead(parser: lmut Parser) -> void:
            saved_position: usize = parser.position
            tuple_position: mutable usize = saved_position
            while tuple_position < parser.tokens.count |tuple_position, parser|:
                prefix_kind: TokenKind = parser.tokens[tuple_position].kind
                prefix_token: Token = parser.tokens[tuple_position]
                owned_prefix: bool = prefix_kind == TokenKind.Ident and Lexer::text_or_empty(&prefix_token, parser.source, parser.source_length) == "owned"
                break if prefix_kind != TokenKind.Mutable and prefix_kind != TokenKind.Lmut and prefix_kind != TokenKind.Ampersand and prefix_kind != TokenKind.Static and prefix_kind != TokenKind.Heap and prefix_kind != TokenKind.Stack and prefix_kind != TokenKind.Tail and not owned_prefix
                tuple_position <- tuple_position + 1.usize()
            return if tuple_position >= parser.tokens.count
            return if parser.tokens[tuple_position].kind != TokenKind.LParen
            # Parenthesized grouping around a type is redundant, so keep looking through
            # adjacent opening parens. This lets `((i64, i64))` report at the inner
            # positional tuple's comma instead of treating it as an opaque grouped type.
            while tuple_position + 1 < parser.tokens.count |tuple_position, parser|:
                break if parser.tokens[tuple_position + 1].kind != TokenKind.LParen
                tuple_position <- tuple_position + 1.usize()
            return if tuple_position + 1 < parser.tokens.count and parser.tokens[tuple_position + 1].kind == TokenKind.RParen
            return if tuple_position + 2 < parser.tokens.count and parser.tokens[tuple_position + 1].kind == TokenKind.Ident and parser.tokens[tuple_position + 2].kind == TokenKind.Colon
            parser.position <- tuple_position + 1.usize()
            machine over parser.position while true:
                state Scan(depth: int, saw_top_comma: bool)
                start Scan(1, false)

                Scan(depth, true), _ if depth <= 0 or parser.peek() == TokenKind.Eof:
                    parser <- parser.error_expected(TokenKind.Colon, parser.first_top_level_comma(tuple_position))
                    break

                Scan(depth, false), _ if depth <= 0 or parser.peek() == TokenKind.Eof:
                    break

                Scan(depth, _), _ if depth == 1 and parser.peek() == TokenKind.Comma:
                    parser.position <- parser.position + 1
                    -> Scan(depth, true)

                Scan(depth, saw_top_comma), _ if parser.peek() == TokenKind.LParen:
                    parser.position <- parser.position + 1
                    -> Scan(depth + 1, saw_top_comma)

                Scan(depth, saw_top_comma), _ if parser.peek() == TokenKind.RParen:
                    parser.position <- parser.position + 1
                    -> Scan(depth - 1, saw_top_comma)

                Scan(depth, saw_top_comma), _:
                    parser.position <- parser.position + 1
                    -> Scan(depth, saw_top_comma)
            parser.position <- saved_position

        # A positional tuple as a TYPE ARGUMENT of a local's annotation, `darray[(i64, i64)]`:
        # stage0 parses the `(` as a grouped type and reports `expected ), got ,` at its first
        # top-level comma. stage1 accepted the type and then had no layout for it (the backend
        # declined the declaration). Tuple types are named (`darray[(a: i64, b: i64)]`); an
        # unannotated `pairs = [(x, x * 2) for x in xs]` still gets stage0's `_0`, `_1` tuple.
        def reject_positional_tuple_type_argument(parser: lmut Parser, finish: usize = 0, stop_at_effect_clause: bool = false, initial_depth: int = 0) -> void:
            index: mutable usize = parser.position
            depth: mutable int = initial_depth
            scan_end: usize = finish if finish > 0 else parser.tokens.count
            while index + 2 < scan_end |index, depth, parser, scan_end|:
                kind: TokenKind = parser.tokens[index].kind
                current_token: Token = parser.tokens[index]
                where_suffix: bool = depth == 0 and kind == TokenKind.Ident and Lexer::text_or_empty(&current_token, parser.source, parser.source_length) == "where"
                previous_is_type_union: bool = index > parser.position and parser.tokens[index - 1.usize()].kind == TokenKind.Pipe
                effect_suffix: bool = stop_at_effect_clause and index > parser.position and not previous_is_type_union and depth == 0 and kind == TokenKind.Ident and Lexer::text_or_empty(&current_token, parser.source, parser.source_length) == "can"
                break if kind == TokenKind.Newline or kind == TokenKind.Eof or (depth == 0 and (kind == TokenKind.Assign or kind == TokenKind.FatArrow)) or where_suffix or effect_suffix
                depth <- depth + 1 if kind == TokenKind.LParen or kind == TokenKind.LBracket
                depth <- depth - 1 if kind == TokenKind.RParen or kind == TokenKind.RBracket
                argument_open: mutable bool = false
                prefix_index: mutable usize = index
                while kind == TokenKind.LParen and prefix_index > parser.position |prefix_index, argument_open|:
                    previous_kind: TokenKind = parser.tokens[prefix_index - 1].kind
                    previous_token: Token = parser.tokens[prefix_index - 1]
                    owned_prefix: bool = previous_kind == TokenKind.Ident and Lexer::text_or_empty(&previous_token, parser.source, parser.source_length) == "owned"
                    if previous_kind == TokenKind.Mutable or previous_kind == TokenKind.Lmut or previous_kind == TokenKind.Ampersand or previous_kind == TokenKind.Static or previous_kind == TokenKind.Heap or previous_kind == TokenKind.Stack or previous_kind == TokenKind.Tail or owned_prefix:
                        prefix_index <- prefix_index - 1.usize()
                    else:
                        argument_open <- previous_kind == TokenKind.LBracket or previous_kind == TokenKind.Comma
                        break
                tuple_open: mutable usize = index
                while argument_open and tuple_open + 1 < scan_end |tuple_open, parser, scan_end|:
                    break if parser.tokens[tuple_open + 1].kind != TokenKind.LParen
                    tuple_open <- tuple_open + 1.usize()
                named: mutable bool = false
                if tuple_open + 2 < scan_end:
                    named <- parser.tokens[tuple_open + 1].kind == TokenKind.Ident and parser.tokens[tuple_open + 2].kind == TokenKind.Colon
                if argument_open and not named and parser.tokens[index + 1].kind != TokenKind.RParen:
                    comma: Token = parser.first_top_level_comma(tuple_open, scan_end)
                    if comma.kind == TokenKind.Comma:
                        parser <- parser.error_expected(TokenKind.RParen, comma)
                        return
                index <- index + 1

        # Extern parameter types are scanned as a compact list before the return head is
        # extracted separately. Validate that return annotation from just after `->` while
        # preserving the cursor for the existing header scanners.
        def reject_extern_return_positional_tuple_type(parser: lmut Parser) -> void:
            return if parser.peek() != TokenKind.Arrow
            saved_position: usize = parser.position
            parser.position <- parser.position + 1.usize()
            parser <- parser.reject_positional_tuple_type_ahead()
            parser <- parser.reject_positional_tuple_type_argument()
            parser.position <- saved_position

        def record_struct_generic_param(parser: lmut Parser, struct_line: u32, owner_offset: u32, parameter_name: sview @source) -> void:
            parser.generic_param_lines <- parser.generic_param_lines.push(struct_line)
            parser.generic_param_names <- parser.generic_param_names.push(parameter_name)
            parser.generic_param_owner_offsets <- parser.generic_param_owner_offsets.push(owner_offset)

        # The source spelling of the header's first bracket group, e.g. `[?, &]` -- stage0
        # quotes the whole list in its state-marker refusal rather than the offending token.
        def header_bracket_span(parser: Parser&, start: usize) -> sview:
            index: mutable usize = start
            open_index: mutable usize = 0
            depth: mutable int = 0
            while index < parser.tokens.count |index, open_index, depth|:
                kind: TokenKind = parser.tokens[index].kind
                break if depth == 0 and (kind == TokenKind.Colon or kind == TokenKind.Newline or kind == TokenKind.Eof)
                open_index <- index if depth == 0 and kind == TokenKind.LBracket
                depth <- depth + 1 if kind == TokenKind.LBracket
                depth <- depth - 1 if kind == TokenKind.RBracket
                return parser.span_view(parser.tokens[open_index].start.usize(), parser.tokens[index].start.usize() + parser.tokens[index].length.usize()) if depth == 0 and kind == TokenKind.RBracket
                index <- index + 1.usize()
            return ""

        # Validate declaration-header options while leaving the cursor untouched for
        # the normal balanced skipper. Also records whether the current struct is a
        # guest overlay so every member can require an explicit `at OFFSET` clause.
        def validate_layout_and_generic_header(parser: lmut Parser, is_struct: bool) -> void:
            parser.current_struct_is_guest <- false if is_struct
            parser.current_struct_has_stride <- false if is_struct
            parser.current_struct_stride <- 0 if is_struct
            saved_position: usize = parser.position
            scan_end: usize = parser.tokens.count
            machine over parser.position while parser.position < scan_end:
                state Scan(depth: int, last_region: sview, struct_mode: bool)
                start Scan(0, "", is_struct)

                Scan(0, _, _), _ if parser.tokens[parser.position].kind == TokenKind.Colon or parser.tokens[parser.position].kind == TokenKind.Newline:
                    break

                Scan(depth, last_region, struct_mode), _ if parser.tokens[parser.position].kind == TokenKind.At and parser.position + 1 < scan_end and parser.tokens[parser.position + 1].kind == TokenKind.Ident and last_region != "" and Lexer::text_or_empty(parser.tokens[parser.position + 1], parser.source, parser.source_length) == last_region:
                    duplicate_region: Token = parser.tokens[parser.position + 1]
                    parser <- parser.error_named(Ast::ParseErrorKind.DuplicateGenericParam, duplicate_region, Lexer::text_or_empty(duplicate_region, parser.source, parser.source_length), "")
                    parser.position <- parser.position + 1
                    -> Scan(depth, Lexer::text_or_empty(parser.tokens[parser.position], parser.source, parser.source_length), struct_mode)

                Scan(depth, _, struct_mode), _ if parser.tokens[parser.position].kind == TokenKind.At and parser.position + 1 < scan_end and parser.tokens[parser.position + 1].kind == TokenKind.Ident:
                    parser.position <- parser.position + 1
                    -> Scan(depth, Lexer::text_or_empty(parser.tokens[parser.position], parser.source, parser.source_length), struct_mode)

                Scan(1, last_region, struct_mode), _ if parser.tokens[parser.position].kind == TokenKind.Ampersand:
                    invalid_ampersand: Token = parser.tokens[parser.position]
                    parser <- parser.error_named(Ast::ParseErrorKind.StructStateMarkerList, invalid_ampersand, parser.header_bracket_span(saved_position), "")
                    parser.position <- parser.position + 1
                    -> Scan(1, last_region, struct_mode)

                Scan(1, last_region, true), _ if parser.tokens[parser.position].kind == TokenKind.Ident and Lexer::text_or_empty(parser.tokens[parser.position], parser.source, parser.source_length) == "sparse":
                    sparse_token: Token = parser.tokens[parser.position]
                    parser <- parser.error_removed(sparse_token, "`sparse` is an enum layout option; it has no meaning on a struct")
                    parser.position <- parser.position + 1
                    -> Scan(1, last_region, true)

                Scan(1, last_region, true), _ if parser.tokens[parser.position].kind == TokenKind.Ident and Lexer::text_or_empty(parser.tokens[parser.position], parser.source, parser.source_length) == "guest":
                    parser.current_struct_is_guest <- true
                    parser.position <- parser.position + 1
                    -> Scan(1, last_region, true)

                Scan(1, last_region, false), _ if parser.tokens[parser.position].kind == TokenKind.Ident and Lexer::text_or_empty(parser.tokens[parser.position], parser.source, parser.source_length) == "guest":
                    invalid_guest: Token = parser.tokens[parser.position]
                    parser <- parser.error_removed(invalid_guest, "`guest` is a struct overlay layout; it has no meaning on an enum")
                    parser.position <- parser.position + 1
                    -> Scan(1, last_region, false)

                # `layout(guest, stride: N)` declares a fixed table stride. `size:` is
                # deliberately not accepted as a synonym.
                Scan(1, last_region, true), _ if parser.position + 2 < scan_end and parser.tokens[parser.position].kind == TokenKind.Ident and Lexer::text_or_empty(parser.tokens[parser.position], parser.source, parser.source_length) == "stride" and parser.tokens[parser.position + 1].kind == TokenKind.Colon and parser.tokens[parser.position + 2].kind == TokenKind.IntLit:
                    parser.current_struct_has_stride <- true
                    parser.current_struct_stride <- parse_layout_number(Lexer::text_or_empty(parser.tokens[parser.position + 2], parser.source, parser.source_length))
                    parser.position <- parser.position + 1
                    -> Scan(1, last_region, true)

                Scan(1, last_region, true), _ if parser.tokens[parser.position].kind == TokenKind.Ident and Lexer::text_or_empty(parser.tokens[parser.position], parser.source, parser.source_length) == "stride":
                    parser.current_struct_has_stride <- true
                    parser.position <- parser.position + 1
                    -> Scan(1, last_region, true)

                Scan(1, last_region, struct_mode), _ if parser.position + 1 < scan_end and parser.tokens[parser.position].kind == TokenKind.Ident and Lexer::text_or_empty(parser.tokens[parser.position], parser.source, parser.source_length) == "region" and parser.tokens[parser.position + 1].kind == TokenKind.Ident:
                    legacy_region: Token = parser.tokens[parser.position]
                    parser <- parser.error_named(Ast::ParseErrorKind.RemovedRegionParamSpelling, legacy_region, Lexer::text_or_empty(parser.tokens[parser.position + 1], parser.source, parser.source_length), "")
                    parser.position <- parser.position + 1
                    -> Scan(1, last_region, struct_mode)

                Scan(depth, last_region, struct_mode), _ if parser.tokens[parser.position].kind == TokenKind.LParen or parser.tokens[parser.position].kind == TokenKind.LBracket:
                    parser.position <- parser.position + 1
                    -> Scan(depth + 1, last_region, struct_mode)

                Scan(depth, last_region, struct_mode), _ if parser.tokens[parser.position].kind == TokenKind.RParen or parser.tokens[parser.position].kind == TokenKind.RBracket:
                    parser.position <- parser.position + 1
                    -> Scan(depth - 1, last_region, struct_mode)

                Scan(depth, last_region, struct_mode), _:
                    parser.position <- parser.position + 1
                    -> Scan(depth, last_region, struct_mode)
            parser.position <- saved_position


        # Capture a struct/enum generic header's type-parameter NAMES without consuming
        # them (the balanced skipper in skip_declaration_header_clauses still does that).
        # Mirrors capture_function_generic_params but scan-based, because the struct
        # header is skipped rather than parsed. Names are recorded by declaration line and
        # owner offset in the generic side table so the backend can monomorphize `Base[args]`.
        # Only the leading `[T, U]` group is a generic header; a `[state ...]` typestate
        # header and any refinement clause are NOT captured (guarded at the call site).
        def capture_struct_generic_params(parser: lmut Parser, struct_line: u32, owner_offset: u32) -> void:
            return if parser.peek() != TokenKind.LBracket
            saved_position: usize = parser.position
            parser.position <- parser.position + 1
            machine over parser.position while true:
                state Scan(depth: int, expect_name: bool)
                start Scan(1, true)

                Scan(depth, _), _ if depth <= 0 or parser.peek() == TokenKind.Eof:
                    break

                Scan(1, true), _ if parser.peek() == TokenKind.Ident:
                    scanned: Token = parser.cursor()
                    parser <- parser.record_struct_generic_param(struct_line, owner_offset, Lexer::text_or_empty(scanned, parser.source, parser.source_length))
                    parser.position <- parser.position + 1
                    -> Scan(1, false)

                Scan(depth, expect_name), _ if depth == 1 and parser.peek() == TokenKind.Comma:
                    parser.position <- parser.position + 1
                    -> Scan(depth, true)

                Scan(depth, expect_name), _ if parser.peek() == TokenKind.LParen or parser.peek() == TokenKind.LBracket:
                    parser.position <- parser.position + 1
                    -> Scan(depth + 1, expect_name)

                Scan(depth, expect_name), _ if parser.peek() == TokenKind.RParen or parser.peek() == TokenKind.RBracket:
                    parser.position <- parser.position + 1
                    -> Scan(depth - 1, expect_name)

                Scan(depth, expect_name), _ if depth == 1 and parser.peek() == TokenKind.Colon:
                    parser.position <- parser.position + 1
                    -> Scan(depth, false)

                Scan(depth, expect_name), _:
                    parser.position <- parser.position + 1
                    -> Scan(depth, expect_name)
            parser.position <- saved_position


        # Entered immediately after a function generic header's opening `[`. Region
        # parameters use `@r`; the legacy `[region r]` spelling is a parser error.
        def reject_legacy_region_params(parser: lmut Parser) -> void:
            saved_position: usize = parser.position
            machine over parser.position while true:
                state Scan(depth: int)
                start Scan(1)

                Scan(depth), _ if depth <= 0 or parser.peek() == TokenKind.Eof:
                    break

                Scan(1), _ if parser.peek() == TokenKind.Ident and parser.header_token_text(0) == "region" and parser.peek_at(1) == TokenKind.Ident:
                    # stage0's directed sentence, not a bare "unexpected token". This scanner is
                    # the ONLY site that reports a function header's legacy region param;
                    # capture_function_generic_params only has to stop recording the keyword as
                    # a generic parameter name, or the one source gets two errors for one token.
                    legacy_region_token: Token = parser.cursor()
                    legacy_region_param_name: sview = Lexer::text_or_empty(parser.tokens[parser.position + 1], parser.source, parser.source_length)
                    parser <- parser.error_named(Ast::ParseErrorKind.RemovedRegionParamSpelling, legacy_region_token, legacy_region_param_name, "")
                    parser.position <- parser.position + 1
                    -> Scan(1)

                Scan(depth), _ if parser.peek() == TokenKind.LBracket:
                    parser.position <- parser.position + 1
                    -> Scan(depth + 1)

                Scan(depth), _ if parser.peek() == TokenKind.RBracket:
                    parser.position <- parser.position + 1
                    -> Scan(depth - 1)

                Scan(depth), _:
                    parser.position <- parser.position + 1
                    -> Scan(depth)
            parser.position <- saved_position


        # Consume one trailing `can` grant clause of a signature and append the captured
        # effect names. Split out of parse_signature_clauses so its scan loop stays a
        # pure guard ladder.
        def consume_signature_can_clause(parser: lmut Parser, effects: mutable darray[sview]&) -> void:
            parser <- parser.skip_trailing_can(false) can Global{Read,Write}
            parser.signature_effect_clause_present <- true
            machine over effects for effect in parser.captured_effects:
                state Scan
                start Scan

                Scan, _:
                    effects.push(effect)
                    -> Scan


        # Conditionally advance one token, discarding the consumed token. Extracted so
        # call sites can use a plain single-value guarded assignment (`parser <-
        # parser.advance_if(cond)`) instead of the guarded tuple-assign form
        # `a, b <- EXPR if COND`, which does not parse (the `if` is taken as a ternary
        # demanding `else`). Void: the lmut parameter threads the mutation back.
        def advance_if(parser: lmut Parser, cond: bool) -> void:
            return if not cond
            rebind _consumed: Token, parser = parser.advance()


        # Qualified `const`/`global` head dispatch (`const enum` / `const struct` /
        # `const module`|`const extend`). Routed through a helper because a ternary
        # chain combining lmut-Parser-threading calls mis-lowers (see the
        # `guard_then_body` note in parser_stmt_control.elisa).
        # Guarded single-branch wrappers: each is a no-op (returns null without
        # touching `parser`) unless its own flag is set, so calling all three
        # unconditionally from the dispatcher below is behavior-preserving even
        # though only one flag is ever true (mutually exclusive by construction
        # at the call site). Mirrors the `advance_if` early-guard-then-mutate shape.
        def parse_qualified_enum_decl(parser: lmut Parser, cond: bool) -> Ast::Decl?:
            return null if not cond
            rebind result: Ast::Decl?, parser = parser.enum_declaration(true) can Global{Read,Write}
            return result

        def parse_qualified_struct_decl(parser: lmut Parser, cond: bool) -> Ast::Decl?:
            return null if not cond
            rebind result: Ast::Decl?, parser = parser.struct_declaration() can Global{Read,Write}
            return result

        # Reached ONLY for `const module M:` (parse_qualified_const_decl is its only caller),
        # so this is where the const-body flag goes on. Saved and restored: a module parsed
        # after this one must not inherit the bare-member shape.
        def parse_qualified_module_decl(parser: lmut Parser, cond: bool) -> Ast::Decl?:
            can Abort.Panic, Memory.Allocate:
                return null if not cond
                saved_const_body: bool = parser.in_const_module_body
                parser.in_const_module_body <- true
                rebind result: Ast::Decl?, parser = parser.module_declaration() can Global{Read,Write}
                parser.in_const_module_body <- saved_const_body
                return result

        def parse_qualified_const_decl(parser: lmut Parser, is_enum_form: bool, is_struct_form: bool, is_module_form: bool) -> Ast::Decl?:
            can Abort.Panic, Memory.Allocate:
                rebind enum_result: Ast::Decl?, parser = parser.parse_qualified_enum_decl(is_enum_form) can Global{Read,Write}
                return enum_result if is_enum_form
                rebind struct_result: Ast::Decl?, parser = parser.parse_qualified_struct_decl(is_struct_form) can Global{Read,Write}
                return struct_result if is_struct_form
                rebind module_result: Ast::Decl?, parser = parser.parse_qualified_module_decl(is_module_form) can Global{Read,Write}
                return module_result if is_module_form
                return null

            # Parse an expression when COND holds; same tuple-guard-if workaround as
            # `return_value_expression_if` in parser_stmt_control.elisa.
        def expression_if(parser: lmut Parser, cond: bool) -> Ast::Expr?:
            return null if not cond
            rebind value_option: Ast::Expr?, parser = parser.expression() can Global{Read,Write}
            return value_option


        # Validate a conditional typestate postcondition before expression parsing can
        # consume the contextual `ensures` clause as part of the return-type tail.
        def validate_conditional_ensures_return(parser: lmut Parser) -> void:
            saved_position: usize = parser.position
            machine over parser.position while parser.peek() != TokenKind.Newline and parser.peek() != TokenKind.Eof:
                state Scan
                start Scan

                Scan, _ if parser.peek() == TokenKind.Ident and parser.header_token_text(0) == "ensures" and parser.peek_at(1) == TokenKind.Return and parser.peek_at(2) != TokenKind.True and parser.peek_at(2) != TokenKind.False:
                    # stage0 reports the OFFENDING token (the non-literal after `return`), not
                    # the `ensures` keyword: `ensures return condition expects true or false,
                    # got IDENT("maybe")`. The renderer already composes that sentence.
                    condition_index: usize = parser.position + 2 if parser.position + 2 < parser.tokens.count else parser.tokens.count - 1
                    parser <- parser.error_named_at(Ast::ParseErrorKind.EnsuresReturnNeedsBoolLiteral, condition_index, "", "")
                    parser.position <- parser.position + 1
                    -> Scan

                Scan, _:
                    parser.position <- parser.position + 1
                    -> Scan
            parser.position <- saved_position


        def typestate_ref_param_name(parser: Parser&, parameter_name: sview, function_line: u32, function_offset: u32) -> bool:
            result: mutable bool = false
            machine over result for annotation in parser.enum_annotations:
                state Scan
                start Scan

                Scan, _ if annotation.owner == parameter_name and annotation.name == "__typestate_ref_param" and annotation.line == function_line and annotation.offset == function_offset:
                    result <- true
                    -> Scan

                Scan, _:
                    -> Scan
            return result

        def append_typestate_transition(parser: lmut Parser, function_name: sview @source, parameter_name: sview @source, state_name: sview @source, position: u32, function_line: u32, function_offset: u32, target_pos: Ast::Pos) -> void:
            parser.typestate_postconditions <- parser.typestate_postconditions.push(Ast::TypestatePostcondition{function_name: function_name, parameter_name: parameter_name, position: position, state: state_name, line: function_line, function_offset: function_offset, target_pos: target_pos})

        # The unresolved `ensures <name> => <state>` target (tag 3900000096). `detail_line`
        # carries the function's line, because `line` IS the tag.
        def append_ensures_unknown_target(parser: lmut Parser, function_name: sview @source, target_name: sview @source, function_line: u32, target_pos: Ast::Pos) -> void:
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: function_name, name: target_name, line: 3900000096, detail_line: function_line, pos: target_pos})

        def append_typestate_consume(parser: lmut Parser, function_name: sview @source, consume_name: sview @source, function_line: u32, function_offset: u32, target_pos: Ast::Pos) -> void:
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: function_name, name: consume_name, line: 3900000076, detail_line: function_line, offset: function_offset, pos: target_pos})

        def append_ensures_return_bool(parser: lmut Parser, function_name: sview @source, function_line: u32) -> void:
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: function_name, name: "__ensures_return_bool", line: function_line, offset: parser.active_function_region_offset})

        def record_typestate_transition(parser: lmut Parser, function_name: sview @source, parameter_name: sview @source, state_name: sview @source, function_line: u32, function_offset: u32, params: darray[Ast::ParamDecl]&, target_pos: Ast::Pos) -> void:
            # An `ensures <name> => <state>` whose <name> is no parameter of this function
            # resolved to nothing and was DROPPED here: the transition table only ever held
            # targets that matched, so stage0's "references unknown parameter" had no input
            # to fire on. Record the unresolved name instead, under its own tag.
            #
            # `self` and `result` are left alone: a method receiver is not always a
            # ParamDecl in stage1's AST, so reporting them would risk a false positive on
            # every `ensures self => …` an impl method declares.
            matched_target: bool = any parameter in params where parameter.name == parameter_name
            if not matched_target and parameter_name != "self" and parameter_name != "result":
                parser <- parser.append_ensures_unknown_target(function_name, parameter_name, function_line, target_pos)
                return
            saved_position: usize = parser.position
            parser.position <- 0
            machine over parser.position while parser.position < params.count:
                state Scan
                start Scan

                Scan, _ if params[parser.position].name == parameter_name:
                    param_position: u32 = parser.position.u32()
                    parser <- parser.append_typestate_transition(function_name, parameter_name, state_name, param_position, function_line, function_offset, target_pos)
                    parser.position <- parser.position + 1
                    -> Scan

                Scan, _:
                    parser.position <- parser.position + 1
                    -> Scan
            parser.position <- saved_position

        def record_typestate_consume(parser: lmut Parser, function_name: sview @source, consume_name: sview @source, function_line: u32, function_offset: u32, params: darray[Ast::ParamDecl]&, target_pos: Ast::Pos) -> void:
            saved_position: usize = parser.position
            parser.position <- 0
            machine over parser.position while parser.position < params.count:
                state Scan
                start Scan

                Scan, _ if params[parser.position].name == consume_name and not parser.typestate_ref_param_name(consume_name, function_line, function_offset):
                    parser <- parser.append_typestate_consume(function_name, consume_name, function_line, function_offset, target_pos)
                    parser.position <- parser.position + 1
                    -> Scan

                Scan, _:
                    parser.position <- parser.position + 1
                    -> Scan
            parser.position <- saved_position
