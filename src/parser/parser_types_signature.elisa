extend Parser:
    private:

        # Skip the clauses between a struct/enum name and its `:` block opener — generic
        # params (`[@owner]`), parent (`is Node`), backing type (`of u8`), and layout
        # (`layout(handle: u32)`, `repr(...)`). Their structure isn't modeled yet; skipping
        # to the block colon (paren/bracket-balanced) lets the body parse cleanly.
        def skip_declaration_header_clauses(parser: lmut Parser) -> void:
            while parser.peek() != TokenKind.Eof |parser, depth: int = 0|:
                kind: TokenKind = parser.peek()
                break if depth == 0 and (kind == TokenKind.Colon or kind == TokenKind.Newline)
                header_token: Token = parser.cursor()
                is_layout_word: bool = depth == 0 and kind == TokenKind.Ident and Lexer::text_or_empty(header_token, parser.source) == "layout"
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, header_token) if is_layout_word and parser.peek_at(1) != TokenKind.LParen
                depth <- depth + 1 if kind in {TokenKind.LParen, TokenKind.LBracket}
                depth <- depth - 1 if kind in {TokenKind.RParen, TokenKind.RBracket}
                parser, _ <- parser.advance()

        # Like skip_declaration_header_clauses, but CAPTURES an extern's `requires` predicate
        # into the file signature-contract side-channel (paired to `extern_line`) so the
        # precondition-violation check can read it — externs otherwise only mark a presence
        # annotation. Only `requires` is captured (the decidable precondition tier); `ensure`
        # and every other trailing clause is skipped exactly as before. The keyword+predicate
        # are consumed in place (contract_expression advances), then the loop continues.
        def capture_extern_header_contracts(parser: lmut Parser, extern_line: u32) -> void:
            while parser.peek() != TokenKind.Eof |parser, depth: int = 0|:
                kind: TokenKind = parser.peek()
                break if depth == 0 and (kind == TokenKind.Colon or kind == TokenKind.Newline)
                header_token: Token = parser.cursor()
                clause_text: sview = Lexer::text_or_empty(header_token, parser.source) if depth == 0 and kind == TokenKind.Ident else sview("", 0, 0)
                is_requires: bool = (clause_text == "requires" or clause_text == "require") and parser.peek_at(1) != TokenKind.Return
                if is_requires:
                    parser <- parser.capture_signature_contract(clause_text)
                    continue
                depth <- depth + 1 if kind in {TokenKind.LParen, TokenKind.LBracket}
                depth <- depth - 1 if kind in {TokenKind.RParen, TokenKind.RBracket}
                parser, _ <- parser.advance()
            parser <- parser.drain_signature_contracts(extern_line)

        # Tuple types are named-field only. Detect a parenthesized comma list whose
        # first element is not `name: Type`, without consuming the type expression.
        def reject_positional_tuple_type_ahead(parser: lmut Parser) -> void:
            return if parser.peek() != TokenKind.LParen
            return if parser.peek_at(1) == TokenKind.RParen
            return if parser.peek_at(1) == TokenKind.Ident and parser.peek_at(2) == TokenKind.Colon
            first: Token = parser.tokens[parser.position + 1]
            scan: mutable usize = 1
            depth: mutable int = 1
            saw_top_comma: mutable bool = false
            while depth > 0 and parser.peek_at(scan) != TokenKind.Eof |scan, depth, saw_top_comma|:
                kind: TokenKind = parser.peek_at(scan)
                saw_top_comma <- true if depth == 1 and kind == TokenKind.Comma
                depth <- depth + 1 if kind == TokenKind.LParen
                depth <- depth - 1 if kind == TokenKind.RParen
                scan <- scan + 1
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, first) if saw_top_comma

        # Validate declaration-header options while leaving the cursor untouched for
        # the normal balanced skipper. Also records whether the current struct is a
        # guest overlay so every member can require an explicit `at OFFSET` clause.
        def validate_layout_and_generic_header(parser: lmut Parser, is_struct: bool) -> void:
            parser.current_struct_is_guest <- false if is_struct
            parser.current_struct_has_stride <- false if is_struct
            parser.current_struct_stride <- 0 if is_struct
            scan: mutable usize = 0
            depth: mutable int = 0
            last_region: mutable sview = ""
            while parser.peek_at(scan) != TokenKind.Eof |parser, scan, depth, last_region|:
                kind: TokenKind = parser.peek_at(scan)
                break if depth == 0 and (kind == TokenKind.Colon or kind == TokenKind.Newline)
                scanned: Token = parser.tokens[parser.position + scan]
                text: sview = Lexer::text_or_empty(scanned, parser.source)
                if kind == TokenKind.At and parser.peek_at(scan + 1) == TokenKind.Ident:
                    region_token: Token = parser.tokens[parser.position + scan + 1]
                    region_name: sview = Lexer::text_or_empty(region_token, parser.source)
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, region_token) if last_region != "" and region_name == last_region
                    last_region <- region_name
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, scanned) if depth == 1 and kind == TokenKind.Ampersand
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, scanned) if depth == 1 and kind == TokenKind.Ident and text == "sparse" and is_struct
                is_guest: bool = depth == 1 and kind == TokenKind.Ident and text == "guest"
                parser.current_struct_is_guest <- true if is_guest and is_struct
                # `layout(guest, stride: N)` declares a fixed table stride — required for a
                # two-operand table read `carrier.field[mem, i]`. `size:` is NOT a stride. The
                # numeric N (two tokens on: `stride` `:` `N`) is captured for the field-fits check.
                is_stride_word: bool = depth == 1 and kind == TokenKind.Ident and text == "stride" and is_struct
                parser.current_struct_has_stride <- true if is_stride_word
                parser.current_struct_stride <- parse_layout_number(Lexer::text_or_empty(parser.tokens[parser.position + scan + 2], parser.source)) if is_stride_word and parser.peek_at(scan + 1) == TokenKind.Colon and parser.peek_at(scan + 2) == TokenKind.IntLit
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, scanned) if is_guest and not is_struct
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, scanned) if depth == 1 and text == "region" and parser.peek_at(scan + 1) == TokenKind.Ident
                depth <- depth + 1 if kind in {TokenKind.LParen, TokenKind.LBracket}
                depth <- depth - 1 if kind in {TokenKind.RParen, TokenKind.RBracket}
                scan <- scan + 1


        # Capture a struct/enum generic header's type-parameter NAMES without consuming
        # them (the balanced skipper in skip_declaration_header_clauses still does that).
        # Mirrors capture_function_generic_params but scan-based, because the struct
        # header is skipped rather than parsed. Names are recorded line-keyed in the
        # proven-stable generic side table so the backend can monomorphize `Base[args]`.
        # Only the leading `[T, U]` group is a generic header; a `[state ...]` typestate
        # header and any refinement clause are NOT captured (guarded at the call site).
        def capture_struct_generic_params(parser: lmut Parser, struct_line: u32) -> void:
            return if parser.peek() != TokenKind.LBracket
            scan: mutable usize = 1
            depth: mutable int = 1
            expect_name: mutable bool = true
            while depth > 0 and parser.peek_at(scan) != TokenKind.Eof |parser, scan, depth, expect_name|:
                kind: TokenKind = parser.peek_at(scan)
                scanned: Token = parser.tokens[parser.position + scan]
                is_generic_name: bool = depth == 1 and expect_name and kind == TokenKind.Ident
                parser.generic_param_lines <- parser.generic_param_lines.push(struct_line) if is_generic_name
                parser.generic_param_names <- parser.generic_param_names.push(Lexer::text_or_empty(scanned, parser.source)) if is_generic_name
                # A constraint (`N: usize`) after `:` is not a fresh param; a `,` at the
                # top level opens the next param slot.
                expect_name <- false if depth == 1 and (is_generic_name or kind == TokenKind.Colon)
                expect_name <- true if depth == 1 and kind == TokenKind.Comma
                depth <- depth + 1 if kind in {TokenKind.LParen, TokenKind.LBracket}
                depth <- depth - 1 if kind in {TokenKind.RParen, TokenKind.RBracket}
                scan <- scan + 1


        # Entered immediately after a function generic header's opening `[`. Region
        # parameters use `@r`; the legacy `[region r]` spelling is a parser error.
        def reject_legacy_region_params(parser: lmut Parser) -> void:
            scan: mutable usize = 0
            depth: mutable int = 1
            while depth > 0 and parser.peek_at(scan) != TokenKind.Eof |parser, scan, depth|:
                kind: TokenKind = parser.peek_at(scan)
                scanned: Token = parser.tokens[parser.position + scan]
                text: sview = Lexer::text_or_empty(scanned, parser.source)
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, scanned) if depth == 1 and text == "region" and parser.peek_at(scan + 1) == TokenKind.Ident
                depth <- depth + 1 if kind == TokenKind.LBracket
                depth <- depth - 1 if kind == TokenKind.RBracket
                scan <- scan + 1


        # Consume one trailing `can` grant clause of a signature and append the captured
        # effect names. Split out of parse_signature_clauses so its scan loop stays a
        # pure guard ladder.
        def consume_signature_can_clause(parser: lmut Parser, effects: mutable darray[sview]&) -> void:
            parser <- parser.skip_trailing_can(false)
            for effect in parser.captured_effects |effects|:
                effects.push(effect)


        # Conditionally advance one token, discarding the consumed token. Extracted so
        # call sites can use a plain single-value guarded assignment (`parser <-
        # parser.advance_if(cond)`) instead of the guarded tuple-assign form
        # `a, b <- EXPR if COND`, which does not parse (the `if` is taken as a ternary
        # demanding `else`). Void: the lmut parameter threads the mutation back.
        def advance_if(parser: lmut Parser, cond: bool) -> void:
            return if not cond
            rebind _consumed: Token, parser = parser.advance()


        # Qualified `const`/`global` head dispatch (`const enum` / `const struct` /
        # `const module`|`const extend`). Routed through a helper because a ternary
        # chain combining lmut-Parser-threading calls mis-lowers (see the
        # `guard_then_body` note in parser_stmt_control.elisa).
        # Guarded single-branch wrappers: each is a no-op (returns null without
        # touching `parser`) unless its own flag is set, so calling all three
        # unconditionally from the dispatcher below is behavior-preserving even
        # though only one flag is ever true (mutually exclusive by construction
        # at the call site). Mirrors the `advance_if` early-guard-then-mutate shape.
        def parse_qualified_enum_decl(parser: lmut Parser, cond: bool) -> Ast::Decl?:
            null return if not cond
            rebind result: Ast::Decl?, parser = parser.enum_declaration(true)
            return result

        def parse_qualified_struct_decl(parser: lmut Parser, cond: bool) -> Ast::Decl?:
            null return if not cond
            rebind result: Ast::Decl?, parser = parser.struct_declaration()
            return result

        def parse_qualified_module_decl(parser: lmut Parser, cond: bool) -> Ast::Decl?:
            null return if not cond
            rebind result: Ast::Decl?, parser = parser.module_declaration()
            return result

        def parse_qualified_const_decl(parser: lmut Parser, is_enum_form: bool, is_struct_form: bool, is_module_form: bool) -> Ast::Decl?:
            rebind enum_result: Ast::Decl?, parser = parser.parse_qualified_enum_decl(is_enum_form)
            enum_result return if is_enum_form
            rebind struct_result: Ast::Decl?, parser = parser.parse_qualified_struct_decl(is_struct_form)
            struct_result return if is_struct_form
            rebind module_result: Ast::Decl?, parser = parser.parse_qualified_module_decl(is_module_form)
            module_result return if is_module_form
            return null

        # Parse an expression when COND holds; same tuple-guard-if workaround as
        # `return_value_expression_if` in parser_stmt_control.elisa.
        def expression_if(parser: lmut Parser, cond: bool) -> Ast::Expr?:
            null return if not cond
            rebind value_option: Ast::Expr?, parser = parser.expression()
            return value_option


        # Validate a conditional typestate postcondition before expression parsing can
        # consume the contextual `ensures` clause as part of the return-type tail.
        def validate_conditional_ensures_return(parser: lmut Parser) -> void:
            while parser.peek_at(scan) not in {TokenKind.Newline, TokenKind.Eof} |parser, scan: usize = 0|:
                token: Token = parser.tokens[parser.position + scan]
                is_ensures: bool = parser.peek_at(scan) == TokenKind.Ident and Lexer::text_or_empty(token, parser.source) == "ensures"
                invalid_condition: bool = is_ensures and parser.peek_at(scan + 1) == TokenKind.Return and parser.peek_at(scan + 2) not in {TokenKind.True, TokenKind.False}
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if invalid_condition
                scan <- scan + 1


        # Whether a parameter's type expression is a reference (`T&`, through wrappers).
        def typestate_param_is_ref(parser: Parser&, type_expression: Ast::Expr) -> bool:
            can Memory.Allocate, Abort.Panic:
                match type_expression:
                    Ast::Expr.Unary(operator, operand, line):
                        true return if operator == TokenKind.Ampersand
                        return parser.typestate_param_is_ref(operand)
                    Ast::Expr.Paren(inner, paren_line):
                        return parser.typestate_param_is_ref(inner)
                    _:
                        return false

        def capture_typestate_postcondition(parser: lmut Parser, function_name: sview, params: darray[Ast::ParamDecl]&, function_line: u32) -> void:
            can Memory.Allocate, Abort.Panic:
                while parser.peek_at(scan) not in {TokenKind.Newline, TokenKind.Eof} |parser, scan: usize = 0|:
                    token: Token = parser.tokens[parser.position + scan]
                    is_ensures: bool = token.kind == TokenKind.Ident and Lexer::text_or_empty(token, parser.source) == "ensures"
                    # A CONDITIONAL ensures `ensures return true => …` predicates on the function's
                    # boolean return value; it requires a `bool` return type. Mark it line-paired
                    # to the function for the semantic return-type check.
                    conditional_return: bool = is_ensures and parser.peek_at(scan + 1) == TokenKind.Return and parser.peek_at(scan + 2) in {TokenKind.True, TokenKind.False}
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: function_name, name: "__ensures_return_bool", line: function_line}) if conditional_return
                    has_transition: bool = is_ensures and parser.peek_at(scan + 1) == TokenKind.Ident and parser.peek_at(scan + 2) == TokenKind.FatArrow and parser.peek_at(scan + 3) == TokenKind.Ident
                    if has_transition:
                        parameter_token: Token = parser.tokens[parser.position + scan + 1]
                        state_token: Token = parser.tokens[parser.position + scan + 3]
                        parameter_name: sview = Lexer::text_or_empty(parameter_token, parser.source)
                        while position < params.count |position: usize = 0|:
                            parser.typestate_postconditions <- parser.typestate_postconditions.push(Ast::TypestatePostcondition{function_name: function_name, parameter_name: parameter_name, position: position.u32(), state: Lexer::text_or_empty(state_token, parser.source), line: function_line}) if params[position].name == parameter_name
                            position <- position + 1
                    # A refstate CONSUME `ensures X => !` requires X to be a ref target. Mark the
                    # function when the named param resolves to a NON-ref (value) type, keyed by
                    # (function, param) for the semantic ref-target check.
                    has_consume: bool = is_ensures and parser.peek_at(scan + 1) == TokenKind.Ident and parser.peek_at(scan + 2) == TokenKind.FatArrow and parser.peek_at(scan + 3) == TokenKind.Bang
                    if has_consume:
                        consume_name: sview = Lexer::text_or_empty(parser.tokens[parser.position + scan + 1], parser.source)
                        while consume_pos < params.count |consume_pos: usize = 0|:
                            if params[consume_pos].name == consume_name and not parser.typestate_param_is_ref(params[consume_pos].type_expression):
                                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: function_name, name: consume_name, line: 3900000076})
                            consume_pos <- consume_pos + 1
                    scan <- scan + 1


        # Consume the trailing signature clauses of a function signature line, capturing
        # effect-grant names and returning them. Effect grants (`can[...]` / bare
        # `can E1, E2`) are structured; error sets (`raises …`) and contracts
        # (`requires`/`ensures`) are consumed without modeling. Bracket/paren depth is
        # tracked so a clause expression's inner `:`/newline never ends the loop early;
        # the loop stops at the top-level block `:` or the line break.
        def parse_signature_clauses(parser: lmut Parser, effects: mutable darray[sview]&) -> void:
            # Reset the per-signature error-set flag; set below if a top-level `error[...]`
            # return set is consumed. function_declaration reads it after this call.
            parser.signature_has_error_set <- false
            parser.captured_contract_kinds <- parser.captured_contract_kinds.truncate(0)
            parser.captured_contract_exprs <- parser.captured_contract_exprs.truncate(0)
            parser.pending_fulfills <- parser.pending_fulfills.truncate(0)
            parser.pending_fulfills_is_subject <- parser.pending_fulfills_is_subject.truncate(0)
            parser.pending_fulfills_is_law <- parser.pending_fulfills_is_law.truncate(0)
            while parser.peek() != TokenKind.Eof |parser, depth: int = 0|:
                kind: TokenKind = parser.peek()
                current_token: Token = parser.cursor()
                # Stop at the block `:`, the line break, or a top-level `=` — the
                # `=` opens an expression-bodied function (`-> T = EXPR`), which
                # function_declaration consumes; it must not be eaten as a signature clause.
                break if depth == 0 and kind in {TokenKind.Colon, TokenKind.Newline, TokenKind.Assign}
                # Reuse the canonical trailing-`can` consumer so a bare `can E1, E2`
                # after `)` (no return type) is captured with the same rules.
                is_can_clause: bool = depth == 0 and kind == TokenKind.Ident and Lexer::text_or_empty(current_token, parser.source) == "can"
                parser <- parser.consume_signature_can_clause(effects) if is_can_clause
                continue if is_can_clause
                # `requires PRED` / `ensures PRED`: capture the predicate into the per-signature
                # buffer (drained to the file side-channel by function_declaration).
                clause_text: sview = Lexer::text_or_empty(current_token, parser.source) if depth == 0 and kind == TokenKind.Ident else sview("", 0, 0)
                clause_keyword: bool = clause_text == "requires" or clause_text == "ensures" or clause_text == "ensure" or clause_text == "require"
                # The conditional-progress form `ensures return COND` is not a plain contract
                # expression — leave it to the token-skip so contract_expression doesn't choke.
                is_contract_clause: bool = clause_keyword and parser.peek_at(1) != TokenKind.Return
                parser <- parser.capture_signature_contract(clause_text) if is_contract_clause
                continue if is_contract_clause
                # `-> T error[E]` (or a bare `error[E]` after `)`): the declared error
                # return set. Its structure isn't modeled, but its PRESENCE exempts the
                # function from RaiseWithoutErrorSet. The following `[...]` is consumed by
                # the depth tracking on subsequent iterations.
                parser.signature_has_error_set <- true if depth == 0 and kind == TokenKind.Error
                # `fulfills SUBJECT is PROTOCOL` where PROTOCOL is a whole-function constraint
                # (NoBoundsChecks/Vectorizes) is malformed — those must be written `fulfills
                # PROTOCOL`. Record (subject, protocol) under sentinel 3900000020 for the check.
                fulfills_shape: bool = depth == 0 and clause_text == "fulfills" and parser.peek_at(1) == TokenKind.Ident and parser.peek_at(2) == TokenKind.Is and parser.peek_at(3) == TokenKind.Ident
                fulfills_protocol: sview = Lexer::text_or_empty(parser.tokens[parser.position + 3], parser.source) if fulfills_shape else sview("", 0, 0)
                fulfills_whole_fn: bool = fulfills_protocol == "NoBoundsChecks" or fulfills_protocol == "Vectorizes"
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: Lexer::text_or_empty(parser.tokens[parser.position + 1], parser.source), name: fulfills_protocol, line: 3900000020}) if fulfills_whole_fn
                # Any `fulfills SUBJECT is PROTOCOL` — recorded under 3900000026 so the
                # effect-law check can flag an effect law wrongly written with a subject.
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: Lexer::text_or_empty(parser.tokens[parser.position + 1], parser.source), name: fulfills_protocol, line: 3900000026}) if fulfills_shape
                # ...and buffered as (subject, law) pairs for the frame-law conformance check
                # (drained by function_declaration with the owning function name).
                parser.pending_fulfills_is_subject <- parser.pending_fulfills_is_subject.push(Lexer::text_or_empty(parser.tokens[parser.position + 1], parser.source)) if fulfills_shape
                parser.pending_fulfills_is_law <- parser.pending_fulfills_is_law.push(fulfills_protocol) if fulfills_shape
                # A plain `fulfills LawName` (a bare law name, not the `SUBJECT is PROTOCOL`
                # frame form) — record the law name for the effect-law fulfillment check.
                plain_fulfills: bool = depth == 0 and clause_text == "fulfills" and parser.peek_at(1) == TokenKind.Ident and parser.peek_at(2) != TokenKind.Is
                parser.pending_fulfills <- parser.pending_fulfills.push(Lexer::text_or_empty(parser.tokens[parser.position + 1], parser.source)) if plain_fulfills
                depth <- depth + 1 if kind in {TokenKind.LParen, TokenKind.LBracket}
                depth <- depth - 1 if kind in {TokenKind.RParen, TokenKind.RBracket}
                parser, _ <- parser.advance()


        # Consume a signature `requires`/`ensures` keyword plus its predicate into the
        # per-signature capture buffer (normalized kind "requires"/"ensure").
        def capture_signature_contract(parser: lmut Parser, clause_text: sview) -> void:
            parser, _ <- parser.advance()                                   # the keyword
            normalized_kind: sview = "requires" if clause_text == "requires" or clause_text == "require" else "ensure"
            rebind predicate: Ast::Expr, parser = parser.contract_expression()
            parser.captured_contract_kinds <- parser.captured_contract_kinds.push(normalized_kind)
            parser.captured_contract_exprs <- parser.captured_contract_exprs.push(predicate)

        # Read a dotted identifier path (`Family` or `Family.Member`) starting at the
        # current Ident and return its whole-span source text.
        def parse_dotted_name(parser: lmut Parser) -> sview:
            start_token: Token = parser.cursor()
            start: usize = start_token.start.usize()
            parser, _ <- parser.advance()                              # first Ident
            end: usize =
                while parser.peek() == TokenKind.Dot and parser.peek_at(1) == TokenKind.Ident |parser, end: usize = (start_token.start + start_token.length).usize()| -> end:
                    parser, _ <- parser.advance()                          # `.`
                    rebind member: Token, parser = parser.advance()          # member Ident
                    end <- (member.start + member.length).usize()
            return parser.span_view(start, end)


        def struct_declaration(parser: lmut Parser) -> Ast::Decl?:
            parser.pending_packed_decl <- false
            token: Token = parser.cursor()
            # Optional single-use discipline modifier (struct-only in stage0): `linear`
            # = must be consumed exactly once before scope exit; `affine` = may be used
            # at most once but silently dropped. Contextual keywords, so matched by
            # text on the leading Ident before the `struct` keyword itself.
            head: Token = parser.cursor()
            head_is_ident: bool = parser.peek() == TokenKind.Ident
            head_text: sview = Lexer::text_or_empty(head, parser.source)
            affinity: mutable sview = ""
            affinity <- "linear" if head_is_ident and head_text == "linear"
            affinity <- "affine" if head_is_ident and head_text == "affine"
            parser <- parser.advance_if(affinity != "")

            parser, _ <- parser.expect(TokenKind.Struct)
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            # Record this struct's decorators (owner=struct name) so the removed-annotation
            # checks (e.g. `@c_bind_prefix`) can see them — mirrors enum_declaration.
            struct_name_text: sview = Lexer::text_or_empty(name_token, parser.source)
            for decorator in parser.pending_decorators |parser|:
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: struct_name_text, name: decorator.name, line: token.line})
                # Keep the concrete alignment value in the compact annotation side table.
                # `EnumAnnotation.line` is otherwise only a source location; for this
                # backend-only metadata it is an intentionally value-bearing slot.
                if decorator.name == "align" and decorator.arg_count > 0 and decorator.arg_start.usize() < parser.annotation_args.count:
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: struct_name_text, name: "__align", line: parse_int_literal_value(parser.annotation_args[decorator.arg_start.usize()]).u32()})
            has_c_layout: bool = parser.header_has_c_layout()
            has_soa_layout: bool = parser.header_has_soa_layout()

            # Typestate header `struct X[state A | B]:` — a `[` immediately followed by the
            # contextual `state` keyword. Detected here (before the header is skipped) so
            # `Decl.Struct.has_named_states` can be paired with the body's `derive` flag.
            # A generic header `[T]` or refinement clause does not open with `state`.
            has_named_states: bool = parser.peek() == TokenKind.LBracket and parser.position + 1 < parser.tokens.count and Lexer::text_or_empty(parser.tokens[parser.position + 1], parser.source) == "state"
            aggregate_arity: u32 = parser.aggregate_state_arity()

            # A leading `[T, U]` (not `[state …]`) is a generic header: capture its param
            # names before the balanced skipper discards the tokens.
            parser <- parser.capture_struct_generic_params(token.line) if parser.peek() == TokenKind.LBracket and not has_named_states
            parser <- parser.validate_layout_and_generic_header(true)
            parser <- parser.skip_declaration_header_clauses()

            name_text: sview = Lexer::text_or_empty(name_token, parser.source)
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name_text, name: "__layout_c", line: token.line}) if has_c_layout
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name_text, name: "__layout_soa", line: token.line}) if has_soa_layout
            while aggregate_index < aggregate_arity |aggregate_index: u32 = 0, parser|:
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name_text, name: "__aggregate_state", line: token.line})
                aggregate_index <- aggregate_index + 1
            empty_members: darray[Ast::StructMember] = []
            no_invariants: darray[Ast::Expr] = []
            (Ast::Decl.Struct(name_text, empty_members, affinity, has_named_states, false, no_invariants, token.line)) return if parser.peek() != TokenKind.Colon

            rebind members: darray[Ast::StructMember], parser = parser.struct_member_block(name_text)
            # Drain the body-parse capture buffers (mirror of the `captured_effects`
            # read pattern): both were reset at the start of `struct_member_block`.
            has_derive: bool = parser.captured_has_derive
            invariants: mutable darray[Ast::Expr] = []
            for inv in parser.captured_invariants |invariants|:
                invariants.push(inv)

            return (Ast::Decl.Struct(name_text, members, affinity, has_named_states, has_derive, invariants, token.line))


        def header_has_c_layout(parser: Parser&) -> bool:
            can Abort.Panic:
                while parser.peek_at(scan) not in {TokenKind.Colon, TokenKind.Newline, TokenKind.Eof} |scan: usize = 0|:
                    token: Token = parser.tokens[parser.position + scan]
                    true return if Lexer::text_or_empty(token, parser.source) == "c" and scan > 0 and parser.peek_at(scan - 1) == TokenKind.LParen
                    scan <- scan + 1
                return false

        # `layout(soa)`: the word `soa` immediately after a `(` in the struct header.
        def header_has_soa_layout(parser: Parser&) -> bool:
            can Abort.Panic:
                while parser.peek_at(scan) not in {TokenKind.Colon, TokenKind.Newline, TokenKind.Eof} |scan: usize = 0|:
                    token: Token = parser.tokens[parser.position + scan]
                    true return if Lexer::text_or_empty(token, parser.source) == "soa" and scan > 0 and parser.peek_at(scan - 1) == TokenKind.LParen
                    scan <- scan + 1
                return false

        # Whether the header carries a `sparse` layout word (`layout(aos, sparse)`) before the
        # block colon — anywhere, since `sparse` is a comma-separated layout flag.
        def header_has_sparse_layout(parser: Parser&) -> bool:
            can Abort.Panic:
                while parser.peek_at(scan) not in {TokenKind.Colon, TokenKind.Newline, TokenKind.Eof} |scan: usize = 0|:
                    true return if Lexer::text_or_empty(parser.tokens[parser.position + scan], parser.source) == "sparse"
                    scan <- scan + 1
                return false

        def aggregate_state_arity(parser: Parser&) -> u32:
            can Abort.Panic:
                0 return if parser.peek() != TokenKind.LBracket
                count: mutable u32 = 0
                depth: mutable u32 = 0
                while parser.position + scan < parser.tokens.count |scan: usize = 0, count, depth|:
                    kind: TokenKind = parser.peek_at(scan)
                    depth <- depth + 1 if kind == TokenKind.LBracket
                    count <- count + 1 if kind == TokenKind.Question and depth == 1
                    depth <- depth - 1 if kind == TokenKind.RBracket
                    break if depth == 0
                    scan <- scan + 1
                return count


        # The parent named by an enum header's `is Parent` clause (`enum Sub is Root`), or "" when
        # absent. Peek-only scan up to the block colon / newline. A qualified `is Mod::Root` keeps
        # only the leaf name (rare); the common single-ident form is the hierarchy parent.
        def header_enum_parent(parser: Parser&) -> sview:
            can Abort.Panic:
                while parser.peek_at(scan) not in {TokenKind.Newline, TokenKind.Eof} |scan: usize = 0|:
                    kind: TokenKind = parser.peek_at(scan)
                    break if kind == TokenKind.Colon
                    Lexer::text_or_empty(parser.tokens[parser.position + scan + 1], parser.source) return if kind == TokenKind.Is and parser.peek_at(scan + 1) == TokenKind.Ident
                    scan <- scan + 1
                return sview("", 0, 0)

        def enum_declaration(parser: lmut Parser, is_const: bool) -> Ast::Decl?:
            rebind token: Token, parser = parser.expect(TokenKind.Enum)
            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            name_text: sview = Lexer::text_or_empty(name_token, parser.source)
            for decorator in parser.pending_decorators |parser|:
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name_text, name: decorator.name, line: token.line})
                if decorator.name == "packed_profile" and decorator.arg_count > 0 and decorator.arg_start < parser.annotation_args.count.u32():
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name_text, name: parser.annotation_args[decorator.arg_start.usize()], line: 3900000041})
            # Record the enum's layout flags (soa/sparse) for the sparse-requires-soa check.
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name_text, name: "__layout_soa", line: token.line}) if parser.header_has_soa_layout()
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name_text, name: "__layout_sparse", line: token.line}) if parser.header_has_sparse_layout()
            parser.packed_enum_names <- parser.packed_enum_names.push(name_text) if parser.pending_packed_decl
            parser.pending_packed_decl <- false
            # Optional `of T` storage type (const enums declare an integer backing type).
            # Captured before the generic header skip so the const-enum checks can read it.
            storage_type: mutable Ast::Expr = (Ast::Expr.Invalid)
            of_token: Token = parser.cursor()
            has_of: bool = parser.peek() == TokenKind.Ident and Lexer::text_or_empty(of_token, parser.source) == "of"
            parser <- parser.advance_if(has_of)
            has_storage_name: bool = has_of and parser.peek() == TokenKind.Ident
            storage_name_token: Token = parser.cursor()
            parser <- parser.advance_if(has_storage_name)
            storage_type <- (Ast::Expr.Ident(Lexer::text_or_empty(storage_name_token, parser.source), storage_name_token.line)) if has_storage_name
            parser <- parser.validate_layout_and_generic_header(false)
            # Capture the `is Parent` hierarchy clause (skipped by the header skipper) so the
            # exhaustiveness check can treat `enum Sub is Root` variants as covering `Root`.
            enum_parent: sview = parser.header_enum_parent()
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: name_text, name: enum_parent, line: 3900000008}) if enum_parent != ""
            parser <- parser.skip_declaration_header_clauses()

            no_variants: darray[Ast::EnumVariant] = []
            (Ast::Decl.Enum(name_text, no_variants, is_const, storage_type, token.line)) return if parser.peek() != TokenKind.Colon

            # Inline empty body `enum Color: pass` — a memberless hierarchy root.
            is_inline_pass: bool = parser.peek_at(1) == TokenKind.Pass
            if is_inline_pass:
                parser, _ <- parser.advance()                       # `:`
                parser, _ <- parser.advance()                       # `pass`
                return (Ast::Decl.Enum(name_text, no_variants, is_const, storage_type, token.line))
            rebind variants: darray[Ast::EnumVariant], parser = parser.enum_variant_block()
            parser.enum_common_owners <- parser.enum_common_owners.push(name_text) if parser.captured_enum_common_count > 0
            parser.enum_common_counts <- parser.enum_common_counts.push(parser.captured_enum_common_count) if parser.captured_enum_common_count > 0
            return (Ast::Decl.Enum(name_text, variants, is_const, storage_type, token.line))


        # Handles `const`/`global` value bindings plus the `const enum`/`const struct`/
        # `const module` qualified forms. Both type and initializer are optional:
        # `const X = 1`, `const X: T = 1`, and `global buf: T` all parse.
        def const_declaration(parser: lmut Parser) -> Ast::Decl?:
            rebind token: Token, parser = parser.advance()          # consume `const` or `global`
            # A plain `const` is immutable; a `global` (with or without `mutable`) may be
            # written. Recorded so the resolver can reject `<-` on an immutable const.
            is_global: bool = Lexer::text_or_empty(token, parser.source) == "global"

            # Qualified declarations: `const enum`, `const struct`, `const module`
            # (and `const extend`, which routes to the same module reader).
            current_token: Token = parser.cursor()
            head_text: sview = Lexer::text_or_empty(current_token, parser.source)
            is_enum_form: bool = parser.peek() == TokenKind.Enum
            is_struct_form: bool = parser.peek() == TokenKind.Struct
            is_module_form: bool = parser.peek() == TokenKind.Ident and (head_text == "module" or head_text == "extend")
            rebind qualified_declaration: Ast::Decl?, parser = parser.parse_qualified_const_decl(is_enum_form, is_struct_form, is_module_form)
            qualified_declaration return if is_enum_form or is_struct_form or is_module_form

            # `global mutable NAME: T = ...` — mutable globals. The `mutable` keyword is otherwise
            # dropped (Decl.Const's 4th field is is_global, not is_mutable), so record mutable-ness
            # in the annotation side-table (`{owner: NAME, name: "__global_mutable"}`) — a mutable
            # global is NOT a compile-time constant (the const-fold prover must not fold it).
            rebind accepted_global_mutable: bool, parser = parser.accept(TokenKind.Mutable)

            rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: Lexer::text_or_empty(name_token, parser.source), name: "__global_mutable", line: token.line}) if accepted_global_mutable

            type_expression: mutable Ast::Expr = (Ast::Expr.Absent)
            rebind accepted_colon: bool, parser = parser.accept(TokenKind.Colon)
            rebind parsed_type_opt: Ast::Expr?, parser = parser.expression_if(accepted_colon)
            if parsed_type_opt is parsed_type:
                type_expression <- parsed_type

            initializer: mutable Ast::Expr = (Ast::Expr.Invalid)
            rebind accepted_assign: bool, parser = parser.accept(TokenKind.Assign)
            rebind parsed_value_opt: Ast::Expr?, parser = parser.expression_if(accepted_assign)
            if parsed_value_opt is parsed_value:
                initializer <- parsed_value

            return (Ast::Decl.Const(Lexer::text_or_empty(name_token, parser.source), type_expression, initializer, is_global, token.line))

        # Recursive plain enums are region-backed packed trees in stage0. The parser
        # already retains hierarchy parents in enum_annotations; after the complete file
        # is known, promote each directly recursive leaf to its hierarchy root in the same
        # packed-name side table used by explicit `packed enum` declarations.
        def recursive_type_mentions(expression: Ast::Expr, wanted: sview) -> bool:
            if expression is Expr.Ident(name, line):
                return name == wanted
            if expression is Expr.Scope(base, name, line):
                return name == wanted or recursive_type_mentions(base, wanted)
            if expression is Expr.Index(head, extent, line):
                return recursive_type_mentions(head, wanted) or recursive_type_mentions(extent, wanted)
            if expression is Expr.IndexN(head, arguments, line):
                if recursive_type_mentions(head, wanted):
                    return true
                return any argument in arguments where recursive_type_mentions(argument, wanted)
            if expression is Expr.Unary(operator, operand, line):
                return recursive_type_mentions(operand, wanted)
            if expression is Expr.Paren(inner, line):
                return recursive_type_mentions(inner, wanted)
            if expression is Expr.Refinement(base, predicate, line):
                return recursive_type_mentions(base, wanted)
            return false


        def enum_parent_name(parser: Parser&, owner: sview) -> sview:
            for annotation in parser.enum_annotations:
                if annotation.owner == owner and annotation.line == 3900000008:
                    return annotation.name
            return ""


        def enum_hierarchy_root(parser: Parser&, owner: sview) -> sview:
            root: mutable sview = owner
            for _step in 0..=32 |root, parser|:
                parent: sview = enum_parent_name(parser, root)
                break if parent == ""
                root <- parent
            return root


        def record_recursive_enum(parser: lmut Parser, owner: sview, variants: darray[Ast::EnumVariant]) -> void:
            recursive: mutable bool = false
            for variant in variants |recursive, owner|:
                for field in variant.fields |recursive, owner|:
                    recursive <- true if recursive_type_mentions(field, owner)
            # AST refinements are part of the sealed Node hierarchy even when a
            # particular declaration has no direct self-typed payload in the parsed
            # field list. Promote them from their `is Node` ancestry as well; otherwise
            # `Ast::Expr` remains an ordinary enum and functions returning `Expr?`
            # (notably Parser.expression) are rejected by the backend's type pass.
            parent: sview = enum_parent_name(parser, owner)
            root: sview = enum_hierarchy_root(parser, owner)
            # The built-in AST declarations live in module Ast, but their declaration
            # names are intentionally unqualified in the AST type expressions. Keep this
            # explicit fallback alongside the ancestry check so promotion does not depend
            # on header metadata surviving parser recovery.
            is_builtin_ast_node: bool = owner == "Node" or owner == "Expr" or owner == "Stmt" or owner == "Decl" or owner == "Pattern"
            is_ast_refinement: bool = is_builtin_ast_node or (parent != "" and root == "Node")
            return if not recursive and not is_ast_refinement
            parser.packed_enum_names <- parser.packed_enum_names.push(root) if not any packed_name in parser.packed_enum_names where packed_name == root
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: root, name: "__aos", line: 3900000042}) if not any annotation in parser.enum_annotations where annotation.owner == root and annotation.name == "__aos"
            # Each refinement is a valid type name at use sites (`Ast.Expr`, `Ast.Stmt`,
            # `Ast.Decl`). Keep the names as well as the canonical root; the backend can
            # then register the refinement declarations into the shared store rather than
            # treating them as ordinary inline enums.
            parser.packed_enum_names <- parser.packed_enum_names.push(owner) if not any packed_name in parser.packed_enum_names where packed_name == owner


        def scan_recursive_enum_packed(parser: lmut Parser, declarations: darray[Ast::Decl]) -> void:
            for declaration in declarations |parser|:
                if declaration is Decl.Enum(name, variants, is_const, storage_type, line):
                    parser <- parser.record_recursive_enum(name, variants)
                elif declaration is Decl.Module(name, body, line):
                    parser <- parser.scan_recursive_enum_packed(body)
                elif declaration is Decl.Scoped(body, line):
                    parser <- parser.scan_recursive_enum_packed(body)


    public:
        # ============================================================
        # Region-polymorphic file parsing entry point
        # No Arena& param; region inferred from call site
        # Returns owned Ast::File with all AST nodes in inferred region
        # ============================================================

        def parse_file(source: u8&, tokens: darray[Token]) -> Ast::File:
            # Region is fully inferred: the parser's stores are backed by this function's
            # inferred auto-region, threaded into every helper call and adopted by the caller
            # on return (region-polymorphic return). No explicit Arena, no `@r`.
            parser: mutable Parser = Parser(source, tokens)
            top_items: mutable darray[Ast::Decl] = []

            while true |parser|:
                parser <- parser.skip_newlines()
                break if parser.peek() == TokenKind.Eof
                before: usize = parser.position
                parser <- parser.parse_declaration_unit(top_items)
                parser <- parser.advance_if(parser.position == before)      # guarantee forward progress

            # Drain decls synthesized by statement-level desugars (docs/123 machine
            # mode enums) so they resolve like ordinary top-level declarations.
            for pending_decl in parser.pending_decls:
                top_items.push(pending_decl)

            parser <- parser.scan_recursive_enum_packed(top_items)

            parser <- parser.scan_legacy_error_syntax()
            parser <- parser.scan_allocation_regions()
            parser <- parser.scan_invalid_console_members()
            parser <- parser.scan_permission_param_members()

            return Ast::File{
                top_decls: top_items,
                protocol_default_methods: parser.protocol_default_methods,
                errors: parser.errors,
                error_set_func_lines: parser.error_set_func_lines,
                signature_contract_lines: parser.signature_contract_lines,
                signature_contract_kinds: parser.signature_contract_kinds,
                signature_contract_exprs: parser.signature_contract_exprs,
                numeric_suffix_names: parser.numeric_suffix_names,
                numeric_suffix_lines: parser.numeric_suffix_lines,
                machine_coverage: parser.machine_coverage,
                derived_state_rules: parser.derived_state_rules,
                typestate_postconditions: parser.typestate_postconditions,
                generic_param_lines: parser.generic_param_lines,
                generic_param_names: parser.generic_param_names,
                annotation_args: parser.annotation_args,
                extern_params: parser.extern_params,
                local_region_annotations: parser.local_region_annotations,
                ghost_local_lines: parser.ghost_local_lines,
                static_assert_conds: parser.static_assert_conds,
                static_if_conds: parser.static_if_conds,
                static_if_lines: parser.static_if_lines,
                static_if_kinds: parser.static_if_kinds,
                static_assert_msgs: parser.static_assert_msgs,
                static_assert_lines: parser.static_assert_lines,
                allocation_region_names: parser.allocation_region_names,
                allocation_region_lines: parser.allocation_region_lines,
                enum_annotations: parser.enum_annotations,
                fn_type_param_lines: parser.fn_type_param_lines,
                fn_type_param_exprs: parser.fn_type_param_exprs,
                packed_enum_names: parser.packed_enum_names,
                enum_common_owners: parser.enum_common_owners,
                enum_common_counts: parser.enum_common_counts
            }


        def scan_allocation_regions(parser: lmut Parser) -> void:
            can Memory.Allocate, Abort.Panic:
                while index + 2 < parser.tokens.count |parser, index: usize = 0|:
                    head: Token = parser.tokens[index]
                    lbracket: Token = parser.tokens[index + 1]
                    region: Token = parser.tokens[index + 2]
                    contextual_new: bool = head.kind == TokenKind.Ident and Lexer::text_or_empty(head, parser.source) == "new"
                    has_region: bool = (head.kind == TokenKind.New or contextual_new) and lbracket.kind == TokenKind.LBracket and region.kind == TokenKind.Ident
                    parser.allocation_region_names <- parser.allocation_region_names.push(Lexer::text_or_empty(region, parser.source)) if has_region
                    parser.allocation_region_lines <- parser.allocation_region_lines.push(head.line) if has_region
                    index <- index + 1


        def scan_invalid_console_members(parser: lmut Parser) -> void:
            can Memory.Allocate, Abort.Panic:
                while index + 2 < parser.tokens.count |parser, index: usize = 0|:
                    family: Token = parser.tokens[index]
                    member: Token = parser.tokens[index + 2]
                    permission_context: bool = parser.previous_token_is_can(index)
                    console_member: bool = permission_context and family.kind == TokenKind.Ident and Lexer::text_or_empty(family, parser.source) == "Console" and parser.tokens[index + 1].kind == TokenKind.Dot and member.kind == TokenKind.Ident
                    member_name: sview = Lexer::text_or_empty(member, parser.source)
                    invalid: bool = console_member and member_name not in {"Format", "Write"}
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__invalid_console", name: member_name, line: family.line}) if invalid
                    index <- index + 1


        # Permission-row parameters stand for a complete permission value. Unlike a
        # concrete permission family (`Console.Write`), they cannot be qualified with a
        # member (`P.Write`). Preserve this source-level distinction for semantic
        # diagnostics; the compact type AST intentionally erases generic-parameter kinds.
        def permission_param_on_line(names: darray[sview]&, lines: darray[u32]&, name: sview, line: u32) -> bool:
            can Abort.Panic:
                while index < names.count |index: usize = 0|:
                    true return if names[index] == name and lines[index] == line
                    index <- index + 1
                return false


        def scan_permission_param_members(parser: lmut Parser) -> void:
            can Memory.Allocate, Abort.Panic:
                permission_params: mutable darray[sview] = []
                permission_param_lines: mutable darray[u32] = []
                while index + 1 < parser.tokens.count |parser, permission_params, permission_param_lines, index: usize = 0|:
                    marker: Token = parser.tokens[index]
                    candidate: Token = parser.tokens[index + 1]
                    is_permission_marker: bool = marker.kind == TokenKind.Ident and Lexer::text_or_empty(marker, parser.source) == "permission"
                    permission_params.push(Lexer::text_or_empty(candidate, parser.source)) if is_permission_marker and candidate.kind == TokenKind.Ident
                    permission_param_lines.push(candidate.line) if is_permission_marker and candidate.kind == TokenKind.Ident
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__permission_param_decl", name: Lexer::text_or_empty(candidate, parser.source), line: candidate.line}) if is_permission_marker and candidate.kind == TokenKind.Ident
                    index <- index + 1

                while index + 2 < parser.tokens.count |parser, index: usize = 0|:
                    family: Token = parser.tokens[index]
                    member: Token = parser.tokens[index + 2]
                    dotted: bool = family.kind == TokenKind.Ident and parser.tokens[index + 1].kind == TokenKind.Dot and member.kind == TokenKind.Ident
                    family_name: sview = Lexer::text_or_empty(family, parser.source)
                    is_permission_param: bool = permission_param_on_line(permission_params, permission_param_lines, family_name, family.line)
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__permission_param_member", name: family_name, line: family.line}) if dotted and is_permission_param
                    index <- index + 1

        def previous_token_is_can(parser: Parser&, index: usize) -> bool:
            can Abort.Panic:
                false return if index == 0
                previous: Token = parser.tokens[index - 1]
                return previous.kind == TokenKind.Ident and Lexer::text_or_empty(previous, parser.source) == "can"


        def scan_legacy_error_syntax(parser: lmut Parser) -> void:
            can Memory.Allocate, Abort.Panic:
                saw_arrow: mutable bool = false
                while token_index < parser.tokens.count |parser, token_index: usize = 0, saw_arrow|:
                    kind: TokenKind = parser.tokens[token_index].kind
                    saw_arrow <- false if kind == TokenKind.Newline
                    saw_arrow <- true if kind == TokenKind.Arrow
                    wildcard_error: bool = kind == TokenKind.Error and token_index + 5 < parser.tokens.count and parser.tokens[token_index + 1].kind == TokenKind.LBracket and parser.tokens[token_index + 2].kind == TokenKind.Ident and parser.tokens[token_index + 3].kind == TokenKind.Dot and parser.tokens[token_index + 4].kind == TokenKind.Star and parser.tokens[token_index + 5].kind == TokenKind.RBracket
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "", name: "__legacy_error_wildcard", line: parser.tokens[token_index].line}) if wildcard_error
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "", name: "__legacy_error_pipe", line: parser.tokens[token_index].line}) if kind == TokenKind.Pipe and saw_arrow
                    # `error[Set, ...]`: a Comma directly followed by `...` inside the set is the
                    # dropped open-suffix form. Detect the `, ...` token pair (deprecated: a bare
                    # set name already means the whole family).
                    comma_ellipsis: bool = saw_arrow and kind == TokenKind.Comma and token_index + 1 < parser.tokens.count and parser.tokens[token_index + 1].kind == TokenKind.Ellipsis
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "", name: "__legacy_error_open", line: parser.tokens[token_index].line}) if comma_ellipsis
                    token_index <- token_index + 1
