# Stage1 parser — recognising an EFFECT OPERATION and rewriting it against the active handler.
# Identity is compared on the effect DECLARATION a `via` row resolved to, not on the spelling,
# so a bare, an indexed and a qualified head all match the same installation; the generated
# locals and callee names are parser-owned. Part of `module Parser` (see parser.elisa).

extend Parser:
    private:

        def append_handler_name_text(buffer: mutable darray[u8]&, text: sview) -> void:
            for handler_name_index in 0..<sview_len(text) |buffer, text|:
                buffer.push(sview_at(text, handler_name_index))



        def handler_effect_family(effect_ref: sview) -> sview:
            abstract_ref: sview = handler_effect_abstract(effect_ref)
            family_start: mutable usize = 0
            while handler_effect_index < sview_len(abstract_ref) |handler_effect_index: usize = 0|:
                # `Effects::Tick` is a qualified abstract family. Keep the
                # terminal component as the row identity while preserving the
                # original spelling for diagnostics and namespace lookup.
                if sview_at(abstract_ref, handler_effect_index) == 58 and handler_effect_index + 1.usize() < sview_len(abstract_ref) and sview_at(abstract_ref, handler_effect_index + 1.usize()) == 58:
                    family_start <- handler_effect_index + 2.usize()
                    handler_effect_index <- handler_effect_index + 2.usize()
                    continue
                abstract_ref[family_start:handler_effect_index] return if sview_at(abstract_ref, handler_effect_index) == 46 or sview_at(abstract_ref, handler_effect_index) == 91
                handler_effect_index <- handler_effect_index + 1
            return abstract_ref[family_start:sview_len(abstract_ref)]



        # The concrete authority named by an abstract effect realization, e.g.
        # `Writer[sview] via Console.Write`. The source spelling is retained as one
        # effect reference; this helper exposes the second semantic dimension to the
        # parser-side handler grant propagation.
        def handler_effect_via(effect_ref: sview) -> sview:
            handler_via_index: mutable usize = 0
            depth: mutable int = 0
            while handler_via_index + 2.usize() < sview_len(effect_ref) |handler_via_index, depth|:
                byte: u8 = sview_at(effect_ref, handler_via_index)
                depth <- depth + 1 if byte == 91 or byte == 40 or byte == 123
                depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41 or byte == 125)
                is_via: bool = depth == 0 and sview_at(effect_ref, handler_via_index) == 118 and sview_at(effect_ref, handler_via_index + 1.usize()) == 105 and sview_at(effect_ref, handler_via_index + 2.usize()) == 97
                before_is_boundary: bool = handler_via_index == 0.usize() or not ((sview_at(effect_ref, handler_via_index - 1.usize()) >= 48 and sview_at(effect_ref, handler_via_index - 1.usize()) <= 57) or (sview_at(effect_ref, handler_via_index - 1.usize()) >= 65 and sview_at(effect_ref, handler_via_index - 1.usize()) <= 90) or (sview_at(effect_ref, handler_via_index - 1.usize()) >= 97 and sview_at(effect_ref, handler_via_index - 1.usize()) <= 122) or sview_at(effect_ref, handler_via_index - 1.usize()) == 95)
                after_index: mutable usize = handler_via_index + 3.usize()
                after_is_boundary: bool = after_index >= sview_len(effect_ref) or not ((sview_at(effect_ref, after_index) >= 48 and sview_at(effect_ref, after_index) <= 57) or (sview_at(effect_ref, after_index) >= 65 and sview_at(effect_ref, after_index) <= 90) or (sview_at(effect_ref, after_index) >= 97 and sview_at(effect_ref, after_index) <= 122) or sview_at(effect_ref, after_index) == 95)
                if is_via and before_is_boundary and after_is_boundary:
                    while after_index < sview_len(effect_ref) and (sview_at(effect_ref, after_index) == 32 or sview_at(effect_ref, after_index) == 9 or sview_at(effect_ref, after_index) == 13) |after_index|:
                        after_index <- after_index + 1.usize()
                    return effect_ref[after_index:sview_len(effect_ref)]
                handler_via_index <- handler_via_index + 1.usize()
            return sview("", 0, 0)



        # The abstract half of a `via` row. Handler selection is based on this row;
        # the concrete permission is authority metadata and must not make an otherwise
        # identical specialization fail to rewrite.
        def handler_effect_abstract(effect_ref: sview) -> sview:
            handler_abstract_index: mutable usize = 0
            depth: mutable int = 0
            while handler_abstract_index + 2.usize() < sview_len(effect_ref) |handler_abstract_index, depth|:
                byte: u8 = sview_at(effect_ref, handler_abstract_index)
                depth <- depth + 1 if byte == 91 or byte == 40 or byte == 123
                depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41 or byte == 125)
                is_via: bool = depth == 0 and sview_at(effect_ref, handler_abstract_index) == 118 and sview_at(effect_ref, handler_abstract_index + 1.usize()) == 105 and sview_at(effect_ref, handler_abstract_index + 2.usize()) == 97
                before_is_boundary: bool = handler_abstract_index == 0.usize() or not ((sview_at(effect_ref, handler_abstract_index - 1.usize()) >= 48 and sview_at(effect_ref, handler_abstract_index - 1.usize()) <= 57) or (sview_at(effect_ref, handler_abstract_index - 1.usize()) >= 65 and sview_at(effect_ref, handler_abstract_index - 1.usize()) <= 90) or (sview_at(effect_ref, handler_abstract_index - 1.usize()) >= 97 and sview_at(effect_ref, handler_abstract_index - 1.usize()) <= 122) or sview_at(effect_ref, handler_abstract_index - 1.usize()) == 95)
                after_index: mutable usize = handler_abstract_index + 3.usize()
                after_is_boundary: bool = after_index >= sview_len(effect_ref) or not ((sview_at(effect_ref, after_index) >= 48 and sview_at(effect_ref, after_index) <= 57) or (sview_at(effect_ref, after_index) >= 65 and sview_at(effect_ref, after_index) <= 90) or (sview_at(effect_ref, after_index) >= 97 and sview_at(effect_ref, after_index) <= 122) or sview_at(effect_ref, after_index) == 95)
                return handler_effect_trim_layout(effect_ref[0:handler_abstract_index]) if is_via and before_is_boundary and after_is_boundary
                handler_abstract_index <- handler_abstract_index + 1.usize()
            return handler_effect_trim_layout(effect_ref)



        # Compare effect references while ignoring layout whitespace. The handler context keeps
        # the installation's full specialization (`Writer[sview]`), while the source may spell
        # an explicitly specialized operation as `Writer[ sview ].write(...)`.
        def handler_effect_ref_equal(left: sview, right: sview) -> bool:
            left_index: mutable usize = 0
            right_index: mutable usize = 0
            while true |left_index, right_index, left, right|:
                while left_index < sview_len(left) and (sview_at(left, left_index) == 32 or sview_at(left, left_index) == 9 or sview_at(left, left_index) == 13) |left_index|:
                    left_index <- left_index + 1.usize()
                while right_index < sview_len(right) and (sview_at(right, right_index) == 32 or sview_at(right, right_index) == 9 or sview_at(right, right_index) == 13) |right_index|:
                    right_index <- right_index + 1.usize()
                return true if left_index >= sview_len(left) and right_index >= sview_len(right)
                return false if left_index >= sview_len(left) or right_index >= sview_len(right)
                return false if sview_at(left, left_index) != sview_at(right, right_index)
                left_index <- left_index + 1.usize()
                right_index <- right_index + 1.usize()
            return false



        # Whether an operation head belongs to the active compile-time specialization. Bare
        # `Writer.write` is the ergonomic spelling and matches by family; an indexed head must
        # match the complete active reference, otherwise a call for another instantiation could
        # be silently routed to the wrong hidden function.
        def handler_effect_head_family(effect_head: Ast::Expr) -> sview:
            match effect_head:
                Expr.Ident(effect_name, effect_name_pos):
                    return effect_name
                # A qualified effect family (`Effects::Tick` or `Effects.Tick`) is
                # still identified by its terminal family component. The module
                # qualifier is namespace information, not a different effect row.
                # Generic qualified heads are deliberately handled by the indexed
                # cases below, where the complete specialization can be compared.
                Expr.Scope(namespace, effect_name, scope_pos):
                    return effect_name
                Expr.Field(namespace_field, effect_name_field, field_pos):
                    return effect_name_field
                Expr.Index(indexed_head, index, index_pos):
                    return handler_effect_head_family(indexed_head)
                Expr.IndexN(indexed_head_n, arguments, index_n_pos):
                    return handler_effect_head_family(indexed_head_n)
                _:
                    return ""



        # Return the source offset of the leftmost component of an effect head. Generic
        # qualified heads are represented as `Index(Scope(...), ...)`, so using the index
        # node's position would lose the namespace prefix when comparing the full source row.
        def handler_effect_head_start(effect_head: Ast::Expr) -> usize:
            match effect_head:
                Expr.Ident(effect_name, effect_name_pos):
                    return effect_name_pos.offset.usize()
                Expr.Scope(namespace, effect_name_scope, scope_pos):
                    return handler_effect_head_start(namespace)
                Expr.Field(namespace_field, effect_name_field, field_pos):
                    return handler_effect_head_start(namespace_field)
                Expr.Index(indexed_head, index, index_pos):
                    return handler_effect_head_start(indexed_head)
                Expr.IndexN(indexed_head_n, arguments, index_n_pos):
                    return handler_effect_head_start(indexed_head_n)
                _:
                    return 0.usize()



        # The effect head exactly as written, without the trailing `.operation`. `call_offset` is
        # the call's opening parenthesis, so the raw slice still carries the operation name. The
        # split is the last `.` outside brackets, which keeps a dotted namespace and any generic
        # arguments inside the head.
        def handler_effect_head_text(parser: Parser&, effect_head: Ast::Expr, call_offset: usize) -> sview:
            head_start: usize = handler_effect_head_start(effect_head)
            return "" if call_offset <= head_start
            source_before_operation: sview = parser.span_view(head_start, call_offset)
            dot_index: mutable usize = sview_len(source_before_operation)
            depth: mutable int = 0
            cursor: mutable usize = 0
            while cursor < sview_len(source_before_operation) |cursor, dot_index, depth, source_before_operation|:
                byte: u8 = sview_at(source_before_operation, cursor)
                dot_index <- cursor if byte == 46 and depth == 0
                depth <- depth + 1 if byte == 91 or byte == 40 or byte == 123
                depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41 or byte == 125)
                cursor <- cursor + 1.usize()
            return "" if dot_index >= sview_len(source_before_operation)
            return source_before_operation[0:dot_index]



        # Compare an explicitly indexed effect head with the active abstract row. The
        # source slice retains both namespace qualification and generic arguments, while
        # `handler_effect_ref_equal` makes layout inside the brackets insignificant.
        def handler_effect_indexed_head_matches(parser: Parser&, effect_head: Ast::Expr, active_effect: sview, call_offset: usize) -> bool:
            source_head: sview = parser.handler_effect_head_text(effect_head, call_offset)
            return false if source_head == ""
            return handler_effect_ref_equal(source_head, handler_effect_abstract(active_effect))



        # A qualified operation head carries namespace identity in addition to its
        # terminal family. If both the source head and the active row are qualified,
        # require the complete path to agree; otherwise an `A::Tick` handler could
        # silently capture `B::Tick`. Bare heads retain the ergonomic family match.
        def handler_effect_ref_has_namespace(effect_ref: sview) -> bool:
            namespace_index: mutable usize = 0
            while namespace_index + 1.usize() < sview_len(effect_ref) |namespace_index|:
                return true if sview_at(effect_ref, namespace_index) == 58 and sview_at(effect_ref, namespace_index + 1.usize()) == 58
                namespace_index <- namespace_index + 1.usize()
            # `A.Tick` is the same qualification written with a dot, and
            # `effect_reference_namespace` already reads it that way. Recognising only `::`
            # here let a dotted head fall through to the terminal-family fallback, which
            # accepts any same-named effect from another module. A dot inside brackets is a
            # generic argument, not a namespace, so track depth — unlike the `::` scan above,
            # which must stay depth-insensitive to keep comparing fully specialized rows.
            depth: mutable int = 0
            dotted_index: mutable usize = 0
            while dotted_index < sview_len(effect_ref) |dotted_index, depth, effect_ref|:
                byte: u8 = sview_at(effect_ref, dotted_index)
                return true if byte == 46 and depth == 0
                depth <- depth + 1 if byte == 91 or byte == 40 or byte == 123
                depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41 or byte == 125)
                dotted_index <- dotted_index + 1.usize()
            return false



        def handler_effect_qualified_head_matches(parser: Parser&, effect_head: Ast::Expr, active_effect: sview, call_offset: usize) -> bool:
            source_head: sview = parser.handler_effect_head_text(effect_head, call_offset)
            return false if source_head == ""
            active_head: sview = handler_effect_abstract(active_effect)
            return handler_effect_ref_equal(source_head, active_head) if handler_effect_ref_has_namespace(source_head) and handler_effect_ref_has_namespace(active_head)
            return handler_effect_head_family(effect_head) == handler_effect_family(active_effect)



        # The effect declaration the active installation resolved to. While a `can` block is
        # being parsed that is the block-scoped field; a clone body is rewritten after the
        # block closed and the field is back to 0, so the installation's own recorded identity
        # stands in. Reading only the field left the clone path with no identity at all, so it
        # fell through to the terminal-family comparison and re-admitted the wrong handler
        # after the parse-time check had already refused it.
        def handler_active_effect_identity(parser: Parser&, active_effect: sview) -> u32:
            return parser.active_effect_identity_id if parser.active_effect_identity_id != 0
            # Resolve the row being matched from its own spelling. `effect_active_install`
            # cannot be used directly: specialization runs inside-out, so the chain is often
            # positioned at a different installation than the effect this pass is matching.
            resolved_identity_id: u32 = parser.effect_identity_for_reference(active_effect, parser.handler_rewrite_owner())
            return resolved_identity_id if resolved_identity_id != 0
            # A bare row that is ambiguous from here still had a known lexical module at its
            # installation site, and that identity was recorded there. Accept it only when it
            # names the same family, which is what makes it the row this pass is matching.
            installed_identity_id: u32 = parser.effect_install_effect_identity_at(parser.effect_active_install) if parser.effect_active_install != 0 else 0
            return installed_identity_id if installed_identity_id != 0 and parser.effect_identity_family(installed_identity_id) == handler_effect_family(handler_effect_abstract(active_effect))
            return 0



        def handler_effect_head_matches(parser: Parser&, effect_head: Ast::Expr, active_effect: sview, call_offset: usize) -> bool:
            # Once the installation has resolved to a declaration, the source head must name that
            # same declaration. This is a necessary condition only: one declaration has many
            # applications, so generic arguments are still compared structurally below. Without
            # it, `A::Tick.ping()` would bind to a handler installed for `B::Tick` purely
            # because both families are spelled `Tick`.
            active_identity_id: u32 = parser.handler_active_effect_identity(active_effect)
            if active_identity_id != 0:
                identity_head: sview = parser.handler_effect_head_text(effect_head, call_offset)
                if identity_head != "":
                    requested_identity_id: u32 = parser.effect_identity_for_reference(identity_head, parser.handler_rewrite_owner())
                    return false if requested_identity_id != 0 and requested_identity_id != active_identity_id
                    # A namespace-qualified head names exactly one declaration. If it does not
                    # resolve to the installed one, the terminal-family fallback below would
                    # silently accept another module's effect.
                    return false if requested_identity_id == 0 and handler_effect_ref_has_namespace(identity_head)
            match effect_head:
                Expr.Ident(effect_name, effect_name_pos):
                    return effect_name == handler_effect_family(active_effect)
                Expr.Index(indexed_head, index, index_pos):
                    return handler_effect_indexed_head_matches(parser, indexed_head, active_effect, call_offset)
                Expr.IndexN(indexed_head_n, arguments, index_n_pos):
                    return handler_effect_indexed_head_matches(parser, indexed_head_n, active_effect, call_offset)
                Expr.Scope(namespace, effect_name_scope, scope_pos):
                    return parser.handler_effect_qualified_head_matches(effect_head, active_effect, call_offset)
                Expr.Field(namespace_field, effect_name_field, field_pos):
                    return parser.handler_effect_qualified_head_matches(effect_head, active_effect, call_offset)
                _:
                    return false



        # Generate a parser-owned source name for a handler operation. The generated name is
        # an ordinary Elisa function name; keeping it in a stable reserved buffer means the
        # rewritten AST can safely retain the view after later names are generated.
        def handler_operation_name_for_identity[@r](parser: mutable Parser& @r, handler: sview, operation: sview, handler_identity_id: u32) -> sview:
            parser.handler_name_storage.reserve(parser.tokens.count * 64) if parser.handler_name_storage.count == 0
            start: usize = parser.handler_name_storage.count
            append_handler_name_text(parser.handler_name_storage, "__handler__")
            append_handler_name_text(parser.handler_name_storage, handler)
            # Top-level handler names retain their historic compact spelling. Module-local
            # handlers carry their stable identity, so `A::H` and `B::H` cannot emit the same
            # LLVM symbol even though their source names are equal.
            if handler_identity_id != 0 and parser.handler_identity_is_module_local(handler_identity_id):
                append_handler_name_text(parser.handler_name_storage, "__")
                append_handler_capture_number(parser.handler_name_storage, handler_identity_id.usize())
            append_handler_name_text(parser.handler_name_storage, "__")
            append_handler_name_text(parser.handler_name_storage, operation)
            return sview(&parser.handler_name_storage[start], 0, parser.handler_name_storage.count - start)



        def handler_operation_name[@r](parser: mutable Parser& @r, handler: sview, operation: sview) -> sview:
            handler_identity_id: u32 = parser.handler_identity_for_name(handler, parser.current_module)
            return parser.handler_operation_name_for_identity(handler, operation, handler_identity_id)



        # The module whose declarations a rewrite is reading. During parsing that is the
        # parser's current module; during clone generation parsing has finished and
        # `current_module` is empty again, so the clone's source owner stands in.
        def handler_rewrite_owner(parser: Parser&) -> sview:
            return parser.effect_clone_active_owner if parser.effect_clone_active_owner != "" else parser.current_module



        def handler_operation_callee(parser: mutable Parser&, handler: sview, operation: sview, position: Ast::Pos) -> Ast::Expr:
            handler_identity_id: u32 = parser.handler_identity_for_name(handler, parser.handler_rewrite_owner())
            hidden_name: sview = parser.handler_operation_name_for_identity(handler, operation, handler_identity_id)
            if handler_identity_id != 0 and parser.handler_identity_is_module_local(handler_identity_id):
                # Qualify with the module that DECLARED the handler. Using the rewriting
                # context instead produced `Scope(Ident(""), ...)` whenever a clone body was
                # rewritten after parsing, which surfaced as `undefined identifier ""`.
                owner_expression: Ast::Expr = Ast::Expr.Ident(parser.handler_identity_owner(handler_identity_id), Ast::pos_at_line(0))
                return Ast::Expr.Scope(owner_expression, hidden_name, position)
            return Ast::Expr.Ident(hidden_name, position)



        def append_handler_capture_number(buffer: mutable darray[u8]&, value: usize) -> void:
            digits: mutable darray[u8] = []
            remaining: mutable usize = value
            if remaining == 0.usize():
                digits.push(48)
            else:
                while remaining > 0.usize() |remaining, digits|:
                    digits.push((48.usize() + (remaining % 10.usize())).u8())
                    remaining <- remaining / 10.usize()
            reverse_index: mutable usize = digits.count
            while reverse_index > 0.usize() |reverse_index, digits, buffer|:
                reverse_index <- reverse_index - 1.usize()
                buffer.push(digits[reverse_index])



        # Generate a lexical local for one handler capture. The source-level
        # handler remains a direct-call construct; these names are only the
        # ordinary locals that carry its evaluated arguments.
        def handler_capture_name[@r](parser: mutable Parser& @r, handler: sview, line: u32) -> sview:
            parser.handler_name_storage.reserve(parser.tokens.count * 64) if parser.handler_name_storage.count == 0
            start: usize = parser.handler_name_storage.count
            append_handler_name_text(parser.handler_name_storage, "__handler_capture__")
            append_handler_name_text(parser.handler_name_storage, handler)
            append_handler_name_text(parser.handler_name_storage, "__")
            append_handler_capture_number(parser.handler_name_storage, line.usize())
            append_handler_name_text(parser.handler_name_storage, "__")
            append_handler_capture_number(parser.handler_name_storage, parser.handler_capture_counter)
            parser.handler_capture_counter <- parser.handler_capture_counter + 1.usize()
            return sview(&parser.handler_name_storage[start], 0, parser.handler_name_storage.count - start)



        # A handler may intentionally implement only part of an effect. If its
        # operation set is known, rewrite only operations it actually provides;
        # the enclosing `can ... with ...` pass can then statically forward the
        # remaining operations to its parent handler. `parse_file` predeclares handler
        # shapes before parsing bodies, so an absent operation is never rewritten to a
        # nonexistent hidden function merely because the declaration appears later.
        def handler_declares_operation(parser: Parser&, handler_name: sview, operation: sview) -> bool:
            handler_identity_id: u32 = parser.handler_identity_for_name(handler_name, parser.current_module)
            return parser.handler_declares_operation_identity(handler_name, operation, handler_identity_id)



        def handler_declares_operation_identity(parser: Parser&, handler_name: sview, operation: sview, handler_identity_id: u32) -> bool:
            known_handler: mutable bool = false
            for annotation in parser.enum_annotations |known_handler|:
                known_handler <- true if (annotation.owner == "__handler_decl" or annotation.owner == "__handler_predecl") and annotation.name == handler_name and (handler_identity_id == 0 or annotation.identity_id == handler_identity_id)
                return true if annotation.owner == handler_name and (annotation.line == 3900000083 or annotation.line == 3900000094) and annotation.name == operation and (handler_identity_id == 0 or annotation.identity_id == handler_identity_id)
            return false



        def handler_is_known(parser: Parser&, handler_name: sview) -> bool:
            handler_identity_id: u32 = parser.handler_identity_for_name(handler_name, parser.current_module)
            return any annotation in parser.enum_annotations where (annotation.owner == "__handler_decl" or annotation.owner == "__handler_predecl") and annotation.name == handler_name and (handler_identity_id == 0 or annotation.identity_id == handler_identity_id)



        # Normalize an effect operation after a block has been parsed. The postfix parser also
        # performs this rewrite while the handler context is active, but keeping this pass at the
        # block boundary makes the invariant explicit and covers parser helpers that temporarily
        # re-enter expression parsing with a copied context. It is still only AST normalization:
        # handler captures become ordinary leading arguments and no runtime handler is built.
        def rewrite_handler_expression(parser: lmut Parser, expression: Ast::Expr, effect_name: sview, handler_name: sview, captures: darray[Ast::Expr]) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        if parser.effect_clone_source_line != 0:
                            match callee:
                                Expr.Field(deferred_head, deferred_operation, deferred_position):
                                    rebind deferred: Ast::Expr?, parser = parser.defer_generic_effect_call(deferred_head, deferred_operation, arguments, argument_names, call_pos, effect_name, handler_name, captures)
                                    return deferred_call if deferred is deferred_call
                                Expr.Scope(deferred_scope_head, deferred_scope_operation, deferred_scope_position):
                                    rebind deferred_scope: Ast::Expr?, parser = parser.defer_generic_effect_call(deferred_scope_head, deferred_scope_operation, arguments, argument_names, call_pos, effect_name, handler_name, captures)
                                    return deferred_scope_call if deferred_scope is deferred_scope_call
                                _:
                                    pass
                        # An effectful helper is a compile-time template. Once the file-wide
                        # specialization pass has registered a clone for this active handler,
                        # rewrite the ordinary helper call to that clone and prepend the
                        # handler captures. Before that pass the lookup is empty, so normal
                        # parsing remains unchanged.
                        effect_template_name: sview = effect_template_callee_name(callee)
                        if effect_template_name != "":
                            lexical_owner: sview = parser.effect_clone_active_owner if (any visible_name in parser.effect_clone_visible_names where visible_name == effect_template_name) else ""
                            source_owner: sview = effect_template_callee_owner(callee, lexical_owner)
                            specialized_name: sview = parser.effect_clone_for_call(effect_template_name, arguments.count, effect_name, handler_name, source_owner)
                            if specialized_name != "":
                                specialized_arguments: mutable darray[Ast::Expr] = []
                                specialized_names: mutable darray[sview] = []
                                for capture in parser.effect_context_arguments |specialized_arguments, specialized_names|:
                                    specialized_arguments.push(capture)
                                    specialized_names.push("")
                                specialized_index: mutable usize = 0
                                while specialized_index < arguments.count |parser, specialized_index, specialized_arguments, specialized_names, argument_names, effect_name, handler_name, captures|:
                                    rebind specialized_argument: Ast::Expr, parser = parser.rewrite_handler_expression(arguments[specialized_index], effect_name, handler_name, captures)
                                    specialized_arguments.push(specialized_argument)
                                    specialized_names.push(argument_names[specialized_index] if specialized_index < argument_names.count else "")
                                    specialized_index <- specialized_index + 1.usize()
