# Keep the escape check and native signature lowering on the same rule. In a
# straight-line factory, a fresh byte array in a local record can back the
# result if its allocation is made in the caller's arena.
extend Ast:
    private:
        def caller_view_type_base(value: Expr) -> Expr:
            can Abort.Panic:
                return match value:
                    Expr.Unary(TokenKind.Mutable, inner, _) | Expr.Paren(inner, _): caller_view_type_base(inner)
                    _: value

        def caller_view_byte_field(file: File&, record: sview, field: sview) -> bool:
            can Abort.Panic:
                matches: mutable usize = 0
                for declaration in file.top_decls |matches|:
                    match declaration:
                        Decl.Struct(name, members, _, _, _, _, _) if name == record:
                            for member in members |matches|:
                                if member.name == field and not member.is_ghost and member.region == "":
                                    if caller_view_type_base(member.type_expression) is Expr.Index(Expr.Ident(head, _), Expr.Ident(element, _), _):
                                        matches <- matches + 1 if head == "darray" and element == "u8"
                        Decl.Alias(name, _, _) if name == record:
                            return false
                        _:
                            pass
                return matches == 1

    public:
        # Only called for top-level declarations. Restrict the proof to a fresh
        # literal followed by a direct return or one unchanged view binding.
        def returns_ambient_byte_view(file: File&, declaration: Decl) -> bool:
            can Abort.Panic:
                if declaration is Decl.Func(_, params, return_type, body, _, decorators, function_pos):
                    return false if params.count != 0 or decorators.count != 0 or body.count < 2 or body.count > 3
                    if return_type is result_type:
                        return false if not (result_type is Expr.Ident(name, _) and name == "sview")
                    else:
                        return false
                    if body[0] is Stmt.VarDecl(local, local_type, initializer, local_pos):
                        if caller_view_type_base(local_type) is Expr.Ident(record, _):
                            if initializer is Expr.Construct(Expr.Ident(constructed, _), fields, construct_pos) and constructed == record:
                                if body[body.count - 1] is Stmt.Return(return_value, result_pos):
                                    result: Expr = get return_value else (Expr.Invalid)
                                    view: mutable Expr = result
                                    if body.count == 3:
                                        if body[1] is Stmt.VarDecl(binding, binding_type, value, _) and binding != local:
                                            return false if not (result is Expr.Ident(result_name, _) and result_name == binding)
                                            return false if not (binding_type is Expr.Ident(view_type, _) and view_type == "sview")
                                            view <- value
                                        else:
                                            return false
                                    if view is Expr.Call(Expr.Field(Expr.Field(Expr.Ident(root, _), field, _), method, _), args, _, _) and root == local and method == "as_sview" and args.count == 0:
                                        return false if not caller_view_byte_field(file, record, field)
                                        return false if any owner_offset in file.generic_param_owner_offsets where owner_offset == function_pos.offset
                                        return false if any annotation in file.local_region_annotations where annotation.owner_offset >= function_pos.offset and annotation.owner_offset <= result_pos.offset
                                        for item in fields:
                                            if item.name == field and item.value is Expr.Array(_, array_pos):
                                                return not (any marker in file.enum_annotations where (marker.name == "__new_construct" or marker.name == "__region_use") and (marker.offset == array_pos.offset or marker.offset == construct_pos.offset))
                return false

        # A plain wrapper can pass the same caller arena to its factory. Calls
        # through parameters or inside explicit region scopes need type/flow facts.
        def ambient_view_forward_target(file: File&, declaration: Decl) -> sview @source:
            can Abort.Panic:
                if declaration is Decl.Func(_, params, return_type, body, _, decorators, function_pos):
                    return "" if params.count != 0 or decorators.count != 0 or body.count < 1 or body.count > 2
                    if return_type is result_type:
                        return "" if not (result_type is Expr.Ident(name, _) and name == "sview")
                    else:
                        return ""
                    if body[body.count - 1] is Stmt.Return(return_value, result_pos):
                        value: mutable Expr = get return_value else (Expr.Invalid)
                        if body.count == 2:
                            if body[0] is Stmt.VarDecl(binding, binding_type, initializer, _):
                                return "" if not (value is Expr.Ident(result_name, _) and result_name == binding)
                                return "" if not (binding_type is Expr.Ident(view_type, _) and view_type == "sview")
                                value <- initializer
                            else:
                                return ""
                        if value is Expr.Call(Expr.Ident(callee, _), args, _, _) and args.count == 0:
                            return "" if any owner_offset in file.generic_param_owner_offsets where owner_offset == function_pos.offset
                            return "" if any annotation in file.local_region_annotations where annotation.owner_offset >= function_pos.offset and annotation.owner_offset <= result_pos.offset
                            return callee
                return ""
