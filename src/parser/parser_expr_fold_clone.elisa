# Rebuild supported transform expressions for each pinned reduction lane so
# later passes see independent AST nodes with the original source positions.
extend Parser:
    private:
        def fold_clone_transform(value: Ast::Expr, depth: u32 = 0) -> Ast::Expr?:
            can Memory.Allocate, Abort.Panic:
                return null if depth >= 2048
                match value:
                    Ast::Expr.Absent:
                        return (Ast::Expr.Absent)
                    Ast::Expr.Ident(name, pos):
                        return (Ast::Expr.Ident(name, pos))
                    Ast::Expr.ShorthandMember(parts, pos):
                        copied_parts: darray[sview @source] @source = [part for part in parts]
                        return (Ast::Expr.ShorthandMember(copied_parts, pos))
                    Ast::Expr.IntLit(number, pos):
                        return (Ast::Expr.IntLit(number, pos))
                    Ast::Expr.FloatLit(number, pos):
                        return (Ast::Expr.FloatLit(number, pos))
                    Ast::Expr.BoolLit(boolean, pos):
                        return (Ast::Expr.BoolLit(boolean, pos))
                    Ast::Expr.StringLit(text, pos):
                        return (Ast::Expr.StringLit(text, pos))
                    Ast::Expr.CharLit(text, pos):
                        return (Ast::Expr.CharLit(text, pos))
                    Ast::Expr.Move(operand, pos):
                        cloned: Ast::Expr? = fold_clone_transform(operand, depth + 1)
                        return (Ast::Expr.Move(child, pos)) if cloned is child
                        return null
                    Ast::Expr.If(condition, yes, no, pos):
                        cloned_condition: Ast::Expr? = fold_clone_transform(condition, depth + 1)
                        cloned_yes: Ast::Expr? = fold_clone_transform(yes, depth + 1)
                        cloned_no: Ast::Expr? = fold_clone_transform(no, depth + 1)
                        if cloned_condition is c and cloned_yes is y and cloned_no is n:
                            return (Ast::Expr.If(c, y, n, pos))
                        return null
                    Ast::Expr.Array(elements, pos):
                        copied: mutable darray[Ast::Expr] @source = []
                        for element in elements |copied|:
                            cloned: Ast::Expr? = fold_clone_transform(element, depth + 1)
                            return null if cloned is null
                            copied.push(get cloned else (Ast::Expr.Invalid))
                        return (Ast::Expr.Array(copied, pos))
                    Ast::Expr.SetLit(elements, pos):
                        copied: mutable darray[Ast::Expr] @source = []
                        for element in elements |copied|:
                            cloned: Ast::Expr? = fold_clone_transform(element, depth + 1)
                            return null if cloned is null
                            copied.push(get cloned else (Ast::Expr.Invalid))
                        return (Ast::Expr.SetLit(copied, pos))
                    Ast::Expr.DictLit(entries, pos):
                        copied: mutable darray[Ast::DictEntry] @source = []
                        for entry in entries |copied|:
                            cloned_key: Ast::Expr? = fold_clone_transform(entry.key, depth + 1)
                            cloned_value: Ast::Expr? = fold_clone_transform(entry.value, depth + 1)
                            return null if cloned_key is null or cloned_value is null
                            copied.push(Ast::DictEntry{key: get cloned_key else (Ast::Expr.Invalid), value: get cloned_value else (Ast::Expr.Invalid)})
                        return (Ast::Expr.DictLit(copied, pos))
                    Ast::Expr.Tuple(elements, pos):
                        copied: mutable darray[Ast::Expr] @source = []
                        for element in elements |copied|:
                            cloned: Ast::Expr? = fold_clone_transform(element, depth + 1)
                            return null if cloned is null
                            copied.push(get cloned else (Ast::Expr.Invalid))
                        return (Ast::Expr.Tuple(copied, pos))
                    Ast::Expr.Slice(object, low, high, pos):
                        cloned_object: Ast::Expr? = fold_clone_transform(object, depth + 1)
                        cloned_low: Ast::Expr? = fold_clone_transform(low, depth + 1)
                        cloned_high: Ast::Expr? = fold_clone_transform(high, depth + 1)
                        if cloned_object is o and cloned_low is l and cloned_high is h:
                            return (Ast::Expr.Slice(o, l, h, pos))
                        return null
                    Ast::Expr.Paren(inner, pos):
                        cloned: Ast::Expr? = fold_clone_transform(inner, depth + 1)
                        return (Ast::Expr.Paren(child, pos)) if cloned is child
                        return null
                    Ast::Expr.Unary(operator, operand, pos):
                        cloned: Ast::Expr? = fold_clone_transform(operand, depth + 1)
                        return (Ast::Expr.Unary(operator, child, pos)) if cloned is child
                        return null
                    Ast::Expr.Binary(left, operator, right, pos):
                        cloned_left: Ast::Expr? = fold_clone_transform(left, depth + 1)
                        cloned_right: Ast::Expr? = fold_clone_transform(right, depth + 1)
                        if cloned_left is left_child and cloned_right is right_child:
                            return (Ast::Expr.Binary(left_child, operator, right_child, pos))
                        return null
                    Ast::Expr.Field(object, field, pos):
                        cloned: Ast::Expr? = fold_clone_transform(object, depth + 1)
                        return (Ast::Expr.Field(child, field, pos)) if cloned is child
                        return null
                    Ast::Expr.Scope(object, field, pos):
                        cloned: Ast::Expr? = fold_clone_transform(object, depth + 1)
                        return (Ast::Expr.Scope(child, field, pos)) if cloned is child
                        return null
                    Ast::Expr.Index(object, index, pos):
                        cloned_object: Ast::Expr? = fold_clone_transform(object, depth + 1)
                        cloned_index: Ast::Expr? = fold_clone_transform(index, depth + 1)
                        if cloned_object is object_child and cloned_index is index_child:
                            return (Ast::Expr.Index(object_child, index_child, pos))
                        return null
                    Ast::Expr.IndexN(object, arguments, pos):
                        cloned_object: Ast::Expr? = fold_clone_transform(object, depth + 1)
                        return null if cloned_object is null
                        copied: mutable darray[Ast::Expr] @source = []
                        for argument in arguments |copied|:
                            cloned_argument: Ast::Expr? = fold_clone_transform(argument, depth + 1)
                            return null if cloned_argument is null
                            copied.push(get cloned_argument else (Ast::Expr.Invalid))
                        return (Ast::Expr.IndexN(get cloned_object else (Ast::Expr.Invalid), copied, pos))
                    Ast::Expr.Call(callee, arguments, names, pos):
                        cloned_callee: Ast::Expr? = fold_clone_transform(callee, depth + 1)
                        return null if cloned_callee is null
                        copied: mutable darray[Ast::Expr] @source = []
                        for argument in arguments |copied|:
                            cloned_argument: Ast::Expr? = fold_clone_transform(argument, depth + 1)
                            return null if cloned_argument is null
                            copied.push(get cloned_argument else (Ast::Expr.Invalid))
                        copied_names: darray[sview @source] @source = [name for name in names]
                        return (Ast::Expr.Call(get cloned_callee else (Ast::Expr.Invalid), copied, copied_names, pos))
                    _:
                        return null
