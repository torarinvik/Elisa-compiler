extend Parser:
    private:
        # Preserve an error-family selector when the compact AST keeps only the payload
        # type expression. The family is carried as a line-keyed annotation for the
        # backend/type registry.
        def record_error_union(parser: lmut Parser, line: u32, owner: sview) -> void:
            return if parser.peek() != TokenKind.Error
            parser, _ <- parser.advance()
            rebind accepted_bracket: bool, parser = parser.accept(TokenKind.LBracket)
            return if not accepted_bracket
            family_token: Token = parser.cursor()
            family: sview = Lexer::text_or_empty(family_token, parser.source) if parser.peek() == TokenKind.Ident else sview("", 0, 0)
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: owner, name: family, line: line}) if family != ""
            parser <- parser.skip_bracketed_group()

        def record_clone_error_union(parser: lmut Parser, line: u32) -> void:
            parser <- parser.record_error_union(line, "__clone_error_union")

        # Parameter type parsing can leave the `error[...]` suffix in the cursor or consume
        # it as part of the broader signature scan. Recover the family from the parameter's
        # source line up to its closing `)` so the backend gets stable metadata in either case.
        def record_parameter_error_union(parser: lmut Parser, line: u32) -> void:
            index: mutable usize = 0
            while index < parser.tokens.count and parser.tokens[index].line < line |parser, index|:
                index <- index + 1
            depth: mutable i32 = 0
            while index < parser.tokens.count and parser.tokens[index].line == line |parser, index, depth|:
                kind: TokenKind = parser.tokens[index].kind
                depth <- depth + 1 if kind == TokenKind.LParen
                if kind == TokenKind.RParen:
                    break if depth == 0
                    depth <- depth - 1
                    break if depth == 0
                if kind == TokenKind.Error and index + 2 < parser.tokens.count and parser.tokens[index + 1].kind == TokenKind.LBracket and parser.tokens[index + 2].kind == TokenKind.Ident:
                    family: sview = Lexer::text_or_empty(parser.tokens[index + 2], parser.source)
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__param_error_union", name: family, line: line})
                    return
                index <- index + 1

        # An `else` that begins a recovery clause — `else return/raise/break/continue`
        # or `else binding:` — belongs to an enclosing `get`/`try`, not to a postfix
        # subscript default `a[i] else <value>`. Mirrors stage0's
        # elseIntroducesRecoveryClause so `x = get a[i] else return -1` parses.
        def else_introduces_recovery_clause(parser: Parser&) -> bool:
            false return if parser.peek() != TokenKind.Else
            after: TokenKind = parser.peek_at(1)
            true return if after == TokenKind.Return or after == TokenKind.Raise or after == TokenKind.Break or after == TokenKind.Continue
            return after == TokenKind.Ident and parser.peek_at(2) == TokenKind.Colon

        # Consume a subscript-default `else` (`a[i] else <value>`) only when the `else`
        # is not an enclosing get/try recovery clause. Returns whether it consumed one.
        def accept_subscript_else(parser: lmut Parser) -> bool:
            false return if parser.peek() != TokenKind.Else
            false return if parser.else_introduces_recovery_clause()
            parser, _ <- parser.advance()
            return true

        # Parse a `[...]` suffix on `active` — a subscript `a[i]`, a slice `a[lo:hi]` (with
        # either bound optional), or a multi-arg subscript / generic application `m[i, j]`.
        # The caller has matched the opening `[`; this consumes through the closing `]` and
        # returns the resulting expression. `@region` type suffixes on bracketed arguments
        # (`p.cast[T& @scratch]`) are consumed and discarded — a selector, not a value.
        def subscript_suffix(parser: lmut Parser, active: Ast::Expr, token: Token) -> Ast::Expr:
            parser, _ <- parser.advance()

            # Optional low bound (absent in `a[:end_bound]` / `a[:]`).
            start_bound: mutable Ast::Expr = (Ast::Expr.Absent)
            if parser.peek() == TokenKind.Question:
                # Aggregate typestate marker `Foo[?]` (and as an element of
                # `Foo[?, !]`) is a leaf selector, not postfix optional syntax.
                rebind state_token: Token, parser = parser.advance()
                start_bound <- (Ast::Expr.Ident(Lexer::text_or_empty(state_token, parser.source), state_token.line))
            elif parser.peek() != TokenKind.Colon and parser.peek() != TokenKind.RBracket:
                rebind bound_expr_opt: Ast::Expr?, parser = parser.expression()
                start_bound <- bound_expr if bound_expr_opt is bound_expr
                rebind accepted_at: bool, parser = parser.accept(TokenKind.At)
                parser, _ <- parser.accept(TokenKind.Ident) if accepted_at

            # `clone[T error[E]]` leaves the error suffix after the payload type
            # expression has been parsed. Preserve it before dispatching on the
            # following comma or closing bracket.
            parser <- parser.record_clone_error_union(token.line) if parser.peek() == TokenKind.Error

            rebind accepted_colon: bool, parser = parser.accept(TokenKind.Colon)
            if accepted_colon:
                # Slice `a[start_bound:end_bound]` (and open-ended variants): optional high bound.
                end_bound: mutable Ast::Expr = (Ast::Expr.Absent)
                if parser.peek() != TokenKind.RBracket:
                    rebind end_bound_opt: Ast::Expr?, parser = parser.expression()
                    end_bound <- get end_bound_opt else end_bound
                parser, _ <- parser.expect(TokenKind.RBracket)
                return (Ast::Expr.Slice(active, start_bound, end_bound, token.line))
            elif parser.peek() == TokenKind.Comma:
                # Multi-arg subscript / generic type application (`m[i, j]`,
                # `dict[K, V]`): the low bound is the first argument.
                index_arguments: mutable darray[Ast::Expr] = [start_bound]
                while parser.accept(TokenKind.Comma) |parser|:
                    break if parser.peek() == TokenKind.RBracket
                    if parser.peek() == TokenKind.Question:
                        rebind state_token_n: Token, parser = parser.advance()
                        index_arguments.push((Ast::Expr.Ident(Lexer::text_or_empty(state_token_n, parser.source), state_token_n.line)))
                    else:
                        rebind index_argument_opt: Ast::Expr?, parser = parser.expression()
                        index_arguments.push(index_argument) if index_argument_opt is index_argument
                    # `@region` suffix on this argument (see the start-bound case).
                    rebind accepted_at_2: bool, parser = parser.accept(TokenKind.At)
                    parser, _ <- parser.accept(TokenKind.Ident) if accepted_at_2
                parser, _ <- parser.expect(TokenKind.RBracket)
                return (Ast::Expr.IndexN(active, index_arguments, token.line))
            else:
                # Single subscript `a[i]`.
                parser, _ <- parser.expect(TokenKind.RBracket)
                rebind accepted_fallback: bool, parser = parser.accept_subscript_else()
                if accepted_fallback:
                    rebind fallback_option: Ast::Expr?, parser = parser.expression()
                    fallback: Ast::Expr = get fallback_option else (Ast::Expr.Invalid)
                    indexed: Ast::Expr = (Ast::Expr.Index(active, start_bound, token.line))
                    # The recursive Node refinement ABI is frozen while stage0 is the
                    # bootstrap compiler. Preserve checked-index syntax losslessly using
                    # the existing operator node: Binary(Index(...), Else, fallback).
                    return (Ast::Expr.Binary(indexed, TokenKind.Else, fallback, token.line))
                return (Ast::Expr.Index(active, start_bound, token.line))

        def postfix_call_suffix(parser: lmut Parser, active: Ast::Expr, token: Token) -> Ast::Expr:
            parser, _ <- parser.advance()
            argument_items: mutable darray[Ast::Expr] = []
            argument_names: mutable darray[sview] = []
            has_arg_forward: mutable bool = false
            saw_explicit_arg: mutable bool = false
            while parser.peek() != TokenKind.RParen and parser.peek() != TokenKind.Eof |parser|:
                is_do_argument: bool = parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon and parser.peek_at(2) == TokenKind.Newline and Lexer::text_or_empty(parser.tokens[parser.position], parser.source) == "do"
                if is_do_argument:
                    saw_explicit_arg <- true
                    rebind do_value_opt: Ast::Expr?, parser = parser.expression()
                    if do_value_opt is do_value:
                        argument_items.push(do_value)
                        argument_names.push("")
                elif parser.peek() == TokenKind.Range:
                    rebind forward_token: Token, parser = parser.advance()
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, forward_token) if has_arg_forward or saw_explicit_arg
                    has_arg_forward <- true
                elif parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon:
                    saw_explicit_arg <- true
                    rebind label_token: Token, parser = parser.advance()
                    parser, _ <- parser.advance()
                    rebind named_value_opt: Ast::Expr?, parser = parser.expression()
                    if named_value_opt is named_value:
                        rebind __a_28: Ast::Expr, parser = parser.consume_removed_as_cast(named_value)
                        argument_items.push(__a_28)
                        argument_names.push(Lexer::text_or_empty(label_token, parser.source))
                else:
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, parser.cursor()) if has_arg_forward
                    saw_explicit_arg <- true
                    rebind positional_value_opt: Ast::Expr?, parser = parser.expression()
                    if positional_value_opt is positional_value:
                        rebind __a_33: Ast::Expr, parser = parser.consume_removed_as_cast(positional_value)
                        argument_items.push(__a_33)
                        argument_names.push("")
                rebind accepted_comma: bool, parser = parser.accept(TokenKind.Comma)
                break if not accepted_comma
            parser, _ <- parser.expect(TokenKind.RParen)
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__arg_forward", name: "__arg_forward", line: token.line}) if has_arg_forward
            return (Ast::Expr.Call(active, argument_items, argument_names, token.line))

        def postfix_brace_suffix(parser: lmut Parser, active: Ast::Expr, token: Token) -> Ast::Expr:
            can ComplexFlow:
                if parser.brace_suffix_is_update():
                    parser, _ <- parser.advance()
                    update_fields: mutable darray[Ast::FieldInit] = []
                    while parser.peek() != TokenKind.RBrace and parser.peek() != TokenKind.Eof |parser|:
                        rebind field_name_token: Token, parser = parser.expect(TokenKind.Ident)
                        field_name: sview = Lexer::text_or_empty(field_name_token, parser.source)
                        field_value: mutable Ast::Expr = (Ast::Expr.Ident(field_name, field_name_token.line))
                        rebind accepted_assign: bool, parser = parser.accept(TokenKind.Assign)
                        if accepted_assign:
                            rebind provided_opt: Ast::Expr?, parser = parser.expression()
                            field_value <- provided if provided_opt is provided
                        update_fields.push(Ast::FieldInit{name: field_name, value: field_value})
                        rebind accepted_comma_2: bool, parser = parser.accept(TokenKind.Comma)
                        break if not accepted_comma_2
                    parser, _ <- parser.expect(TokenKind.RBrace)
                    return (Ast::Expr.RecordUpdate(active, update_fields, token.line))
                parser, _ <- parser.advance()
                field_initializers: mutable darray[Ast::FieldInit] = []
                while parser.peek() != TokenKind.RBrace and parser.peek() != TokenKind.Eof |parser|:
                    if parser.peek() == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon:
                        rebind label_token: Token, parser = parser.advance()
                        parser, _ <- parser.advance()
                        rebind field_value_opt: Ast::Expr?, parser = parser.expression()
                        field_initializers.push(Ast::FieldInit{name: Lexer::text_or_empty(label_token, parser.source), value: field_value}) if field_value_opt is field_value
                    else:
                        rebind bare_field_value_opt: Ast::Expr?, parser = parser.expression()
                        field_initializers.push(Ast::FieldInit{name: "", value: field_value}) if bare_field_value_opt is field_value
                    rebind accepted_comma_3: bool, parser = parser.accept(TokenKind.Comma)
                    break if not accepted_comma_3
                parser, _ <- parser.expect(TokenKind.RBrace)
                return (Ast::Expr.Construct(active, field_initializers, token.line))

        def postfix_expression(parser: lmut Parser) -> Ast::Expr?:
            rebind __d_4: Ast::Expr?, parser = parser.primary_expression()
            active: mutable Ast::Expr = get __d_4 #unwrap or propagate null

            while true |parser, active|:
                kind: TokenKind = parser.peek()
                token: Token = parser.cursor()
                if kind == TokenKind.LParen:
                    rebind call_result: Ast::Expr, parser = parser.postfix_call_suffix(active, token)
                    active <- call_result
                elif kind == TokenKind.Dot:
                        rebind field_result: Ast::Expr, parser = parser.postfix_dot_suffix(active, token)
                        active <- field_result
                elif kind == TokenKind.Scope:
                        rebind scope_result: Ast::Expr, parser = parser.postfix_scope_suffix(active, token)
                        active <- scope_result
                elif kind == TokenKind.Question:
                        rebind question_result: Ast::Expr, parser = parser.postfix_question_suffix(active, token)
                        active <- question_result
                elif kind == TokenKind.Ampersand:
                        break if parser.postfix_amp_is_infix()
                        rebind amp_result: Ast::Expr, parser = parser.postfix_amp_suffix(active, token)
                        active <- amp_result
                elif kind == TokenKind.LBracket:
                        rebind subscripted: Ast::Expr, parser = parser.subscript_suffix(active, token)
                        active <- subscripted
                elif kind == TokenKind.LBrace:
                        rebind brace_result: Ast::Expr, parser = parser.postfix_brace_suffix(active, token)
                        active <- brace_result
                else:
                    break

            return active

        def postfix_dot_suffix(parser: lmut Parser, active: Ast::Expr, token: Token) -> Ast::Expr:
            parser, _ <- parser.advance()
            rebind field_token: Token, parser = parser.expect(TokenKind.Ident)
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, field_token) if Lexer::text_or_empty(field_token, parser.source) == "specialize"
            return (Ast::Expr.Field(active, Lexer::text_or_empty(field_token, parser.source), token.line))

        def postfix_scope_suffix(parser: lmut Parser, active: Ast::Expr, token: Token) -> Ast::Expr:
            parser, _ <- parser.advance()
            rebind scope_token: Token, parser = parser.expect(TokenKind.Ident)
            return (Ast::Expr.Scope(active, Lexer::text_or_empty(scope_token, parser.source), token.line))

        def postfix_question_suffix(parser: lmut Parser, active: Ast::Expr, token: Token) -> Ast::Expr:
            parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, token) if parser.peek_at(1) == TokenKind.Dot
            rebind advanced_operator_token: Token, parser = parser.advance()
            return (Ast::Expr.Unary(advanced_operator_token.kind, active, token.line))

        def postfix_amp_is_infix(parser: Parser&) -> bool:
            amp_run: int = parser.postfix_amp_run()
            after_amps_index: usize = parser.position + amp_run.usize()
            after_amps_text: sview = Lexer::text_or_empty(parser.tokens[after_amps_index], parser.source) if parser.peek_at(amp_run.usize()) == TokenKind.Ident and after_amps_index < parser.tokens.count else ""
            # `where` and `can` are plain identifiers to the lexer, so a REF type followed by
            # a refinement or a trailing effect grant (`-> void& can[Abort.Panic]`) otherwise
            # looks like an infix `&` whose right operand is that keyword — the whole return
            # annotation then resolves to Unmodeled and the function is dropped.
            after_amps_is_clause: bool = after_amps_text == "where" or after_amps_text == "can"
            return tokenStartsValue(parser.peek_at(amp_run)) and not after_amps_is_clause

        def postfix_amp_suffix(parser: lmut Parser, active: Ast::Expr, token: Token) -> Ast::Expr:
            amp_run: int = parser.postfix_amp_run()
            updated: mutable Ast::Expr = active
            for _ in 0..<amp_run |parser, updated|:
                rebind advanced_operator_token: Token, parser = parser.advance()
                updated <- (Ast::Expr.Unary(advanced_operator_token.kind, updated, token.line))
            return updated

        # Count a contiguous postfix reference run without embedding an expression-valued
        # loop inside the suffix dispatcher. The first ampersand is the current token.
        def postfix_amp_run(parser: Parser&) -> int:
            amp_run: mutable int = 1
            while parser.peek_at(amp_run) == TokenKind.Ampersand |amp_run|:
                amp_run <- amp_run + 1
            return amp_run

        def brace_suffix_is_update(parser: Parser&) -> bool:
            scan: mutable usize = 1
            depth: mutable int = 1
            while depth > 0 and parser.peek_at(scan) != TokenKind.Eof |scan, depth|:
                kind: TokenKind = parser.peek_at(scan)
                true return if depth == 1 and kind == TokenKind.Assign
                depth <- depth + 1 if kind == TokenKind.LBrace
                depth <- depth - 1 if kind == TokenKind.RBrace
                scan <- scan + 1
            return false



        # Whether the cursor is the `owned` ownership qualifier in TYPE position. Mirrors
        # stage0's peekOwnedQualifier: the text must be "owned" and a type must plausibly
        # follow.
        def parser_owned_qualifier_ahead(parser: Parser&) -> bool:
            can Abort.Panic:
                false return if parser.peek() != TokenKind.Ident
                owned_cursor: Token = parser.cursor()
                false return if Lexer::text_or_empty(&owned_cursor, parser.source) != "owned"
                return parser.peek_at(1) == TokenKind.Ident or parser.peek_at(1) == TokenKind.Mutable or parser.peek_at(1) == TokenKind.Tail or parser.peek_at(1) == TokenKind.LParen


        def unary_expression(parser: lmut Parser) -> Ast::Expr?:
            kind: TokenKind = parser.peek()
            token: Token = parser.cursor()

            # `owned T` — the ownership qualifier. A CONTEXTUAL keyword (a plain Ident
                # whose text is "owned"), so it only qualifies when a type plausibly follows:
                # IDENT / `mutable` / `tail` / `(`. That guard is stage0's, and it is what
                # keeps a value or type incidentally NAMED "owned" from being misread.
                #
                # Without this, `r: owned Arena = …` parsed `owned` as the type and left
                # `Arena` dangling — "unknown type 'owned'" plus a bogus duplicate-local.
            if kind == TokenKind.Ident and parser_owned_qualifier_ahead(parser):
                rebind owned_token: Token, parser = parser.advance()
                rebind owned_operand_opt: Ast::Expr?, parser = parser.unary_expression()
                if owned_operand_opt is owned_operand:
                    return (Ast::Expr.Unary(TokenKind.Owned, owned_operand, owned_token.line))
                return null
                # Bare `&`/`!` as a type/cast-target leaf (the target in `x as &`, `x as !`):
                # a `&`/`!` not followed by a value is the type marker itself, not a prefix operator.
            if (kind == TokenKind.Ampersand or kind == TokenKind.Bang) and not tokenStartsValue(parser.peek_at(1)):
                parser, _ <- parser.advance()
                return (Ast::Expr.Ident(Lexer::text_or_empty(token, parser.source), token.line))

                # The `not` KEYWORD (distinct from `!`/`~`) is logical negation and binds
                # LOOSER than comparison — `not x > 0` is `not (x > 0)`, not `(not x) > 0`
                # (stage0's dedicated parseNot level, between `and` and comparison). So its
                # operand is parsed at comparison precedence: consume `not`, take a unary
                # atom, then climb every operator at comparison-or-tighter (precedence 3+)
                # into the operand before wrapping. `not in` (the infix compound) is handled
                # in binary_expression_at_level and never reaches this prefix position.
            if kind == TokenKind.Not:
                rebind not_token: Token, parser = parser.advance()
                rebind not_inner_opt: Ast::Expr?, parser = parser.unary_expression()
                if not_inner_opt is not_inner:
                    rebind not_operand: Ast::Expr, parser = parser.binary_expression_at_level(not_inner, 3)
                    return (Ast::Expr.Unary(TokenKind.Not, not_operand, not_token.line))
                return null

                # Prefix operators: bitwise-not (`!`/`~`), sign (`-`/`+`), address-of (`&x`),
                # and type-position qualifiers (`mutable`/`static`/`heap`/`stack`). Parsing
                # them all as tight prefix unary keeps value and type expressions uniform.
            is_prefix: bool = kind == TokenKind.Bang or kind == TokenKind.Tilde or kind == TokenKind.Minus or kind == TokenKind.Plus or kind == TokenKind.Ampersand or kind == TokenKind.Mutable or kind == TokenKind.Lmut or kind == TokenKind.Static or kind == TokenKind.Heap or kind == TokenKind.Stack or kind == TokenKind.Tail
            if is_prefix:
                rebind advanced_operator_token: Token, parser = parser.advance()
                operator_kind: TokenKind = advanced_operator_token.kind
                rebind operand_handle: Ast::Expr?, parser = parser.unary_expression()
                if operand_handle is operand:
                    return (Ast::Expr.Unary(operator_kind, operand, token.line))
                return null
            rebind __ret_207: Ast::Expr?, parser = parser.postfix_expression()
            return __ret_207


        # Compound assignment operators (`+=`, `-=`, `*=`, …, `<<=`, `>>=`, `?=`).
        def isCompoundAssign(kind: TokenKind) -> bool:
            return kind == TokenKind.PlusEq or kind == TokenKind.MinusEq or kind == TokenKind.StarEq or kind == TokenKind.SlashEq or kind == TokenKind.PercentEq or kind == TokenKind.CaretEq or kind == TokenKind.PipeEq or kind == TokenKind.AmpEq or kind == TokenKind.LShiftEq or kind == TokenKind.RShiftEq or kind == TokenKind.QAssign


        # Whether a token can begin a value expression — used to disambiguate a postfix
        # reference `T&` (NOT followed by a value) from infix bitwise-and `a & b` (IS).
        def tokenStartsValue(kind: TokenKind) -> bool:
            true return if kind == TokenKind.Ident or kind == TokenKind.IntLit or kind == TokenKind.FloatLit or kind == TokenKind.HexLit or kind == TokenKind.StringLit or kind == TokenKind.CharLit
            true return if kind == TokenKind.True or kind == TokenKind.False or kind == TokenKind.Null or kind == TokenKind.Zeroed or kind == TokenKind.New
            true return if kind == TokenKind.LParen or kind == TokenKind.LBracket or kind == TokenKind.LBrace
            true return if kind == TokenKind.Sizeof or kind == TokenKind.Alignof or kind == TokenKind.Offsetof or kind == TokenKind.Panic or kind == TokenKind.Raise
            true return if kind == TokenKind.Not or kind == TokenKind.Bang or kind == TokenKind.Tilde or kind == TokenKind.Minus or kind == TokenKind.Plus or kind == TokenKind.Ampersand
            return false


        def precedence(kind: TokenKind) -> int:
            return when kind:
                # Function-type/result arrow `A -> B` (in type-position expressions like
                # `fn(usize) -> i64`); binds loosest.
                TokenKind.Arrow | TokenKind.Or -> 1
                TokenKind.And -> 2
                # Membership (`x in coll`), refinement-test/binding (`v is Pattern`,
                # `expression is name`), and the reinterpret-target form (`field as & <- v`)
                # bind like a comparison. NOTE: the general `expression as T` cast was removed
                # in stage0 (use `.cast[T]` / `T(expression)`) — binary_expression_at_level only
                # consumes `as` before a bare `&`/`!` target leaf; every other `as` is
                # left for its statement parser (expect-as, using-as, lock-as, …).
                TokenKind.EqEq | TokenKind.BangEq | TokenKind.Lt | TokenKind.Gt | TokenKind.LtEq | TokenKind.GtEq | TokenKind.In | TokenKind.Is | TokenKind.As -> 3
                # Range constructors (`a..b`, `a..<b`, `a..>b`, `a..=b`) bind tighter than
                # membership/comparison but looser than arithmetic, so `i in 0..<n+1` groups
                # as `i in (0 ..< (n+1))`.
                TokenKind.Range | TokenKind.RangeLt | TokenKind.RangeGt | TokenKind.RangeLe -> 4
                # Bitwise or/xor/and: pipe, caret, and ampersand. (Infix `&` is disambiguated
                # from postfix `T&` ref by the value-start lookahead in postfix_expression.)
                TokenKind.Pipe | TokenKind.Caret | TokenKind.Ampersand -> 5
                TokenKind.Plus | TokenKind.Minus -> 6
                TokenKind.Star | TokenKind.Slash | TokenKind.Percent -> 7
                # Shifts bind tightest among the binaries.
                TokenKind.LShift | TokenKind.RShift -> 8
                _ -> 0

        # Parse one binary-expression continuation. Keeping the loop driver separate is
        # important for stage1: the old all-in-one routine combined recursive descent,
        # token lookahead, and several packed-AST constructions in a single body and was
        # omitted from the self-hosted object even though stage0 emitted it.
        def binary_expression_step(parser: lmut Parser, active: mutable Ast::Expr, minimum_precedence: int) -> Ast::Expr?:
                kind: TokenKind = parser.peek()

                # `as` is an expression operator for either a packed-enum pattern test
                # (`node as Expr.Add(lhs, rhs)`) or the reinterpret-target form
                # `field as & <- v` / `x as !`. Packed variant targets are qualified;
                # an unqualified `value as Type` remains the removed value-cast syntax
                # and is deliberately left for consume_removed_as_cast.
                if kind == TokenKind.As:
                    after_as_kind: TokenKind = parser.peek_at(1)
                    reinterpret_target: bool = (after_as_kind == TokenKind.Ampersand or after_as_kind == TokenKind.Bang) and not tokenStartsValue(parser.peek_at(2))
                    packed_pattern_target: mutable bool = not parser.suppress_as_pattern and after_as_kind == TokenKind.Ident and parser.peek_at(2) == TokenKind.Dot
                    # Removed store-binder spelling: `value in store as Pattern` must
                    # not be reinterpreted as `(value in store) as Pattern`; stage0
                    # requires `value in store is Pattern` instead.
                    null return if not reinterpret_target and not packed_pattern_target
                    # `value in store as Pattern` is the REMOVED store-binder spelling
                    # (stage0 rejects it; `value in store is Pattern` replaced it). Parsing
                    # it as `(value in store) as Pattern` silently accepted the dead form.
                    store_as_removed: mutable bool = false
                    if active is Expr.Binary(store_as_left, store_as_operator, store_as_right, store_as_line):
                        store_as_removed <- store_as_operator == TokenKind.In and packed_pattern_target
                    # Record the removed form but keep parsing it as a pattern test, so one
                    # diagnostic is reported instead of a cascade of recovery errors.
                    parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, parser.cursor()) if store_as_removed

                # docs/119 §3: a `|` that opens a loop-expression header is never a
                # bitwise operator — stop so the loop parser can take the header. Inside a
                # header's own accumulator initializer, `suppress_pipe` additionally stops
                # at the closing pipe. A bitwise `a | b` in an iterable/condition matches
                # neither and is consumed normally (loop_header_at's scan is bounded by
                # brackets/`:`/newline, so it never false-matches).
                null return if kind == TokenKind.Pipe and (parser.suppress_pipe or parser.loop_header_at())

                # docs/123: inside a `machine` header clause, a top-level `->` introduces
                # the yield expression — never the function-type arrow.
                null return if kind == TokenKind.Arrow and parser.suppress_arrow

                # Compound `not in` — negated membership `x not in S` desugars to
                # `not (x in S)` and binds like a comparison (precedence 3). `not` is
                # otherwise prefix-only, so it is recognized here via one-token lookahead.
                if kind == TokenKind.Not and parser.peek_at(1) == TokenKind.In:
                    null return if 3 < minimum_precedence
                    parser, _ <- parser.advance()                       # `not`
                    rebind in_token: Token, parser = parser.advance()       # `in`
                    rebind __d_288: Ast::Expr?, parser = parser.unary_expression()
                    membership_right: mutable Ast::Expr = get __d_288 else return active
                    if 3 < precedence(parser.peek()):
                        rebind __t_294: Ast::Expr, parser = parser.binary_expression_at_level(membership_right, 4)
                        membership_right <- __t_294
                    membership_expr: Ast::Expr = (Ast::Expr.Binary(active, TokenKind.In, membership_right, in_token.line))
                    active <- (Ast::Expr.Unary(TokenKind.Not, membership_expr, in_token.line))
                    return active

                current_precedence: int = precedence(kind)
                null return if current_precedence < minimum_precedence

                rebind advanced_operator_token: Token, parser = parser.advance()

                operator_kind: TokenKind = advanced_operator_token.kind
                # Compound `is not` — `EXPR is not TARGET` desugars to `not (EXPR is TARGET)`,
                # mirroring `not in`. Without this the `not` glued onto the RHS (`is Unary(Not,
                # TARGET)`) reaches the backend's is-emitter, which matches only a bare variant RHS
                # and declines (materialize_mutable_globals' `global_value is not Expr.Invalid`).
                is_negated_is: bool = operator_kind == TokenKind.Is and parser.peek() == TokenKind.Not
                parser, _ <- parser.advance() if is_negated_is                  # consume `not`
                token: Token = parser.cursor()

                rebind __d_302: Ast::Expr?, parser = parser.unary_expression()
                right: mutable Ast::Expr = get __d_302 else return active

                next_precedence: int = precedence(parser.peek())
                if current_precedence < next_precedence:
                    rebind __t_311: Ast::Expr, parser = parser.binary_expression_at_level(right, current_precedence + 1)
                    right <- __t_311

                # `EXPR is TARGET as NAME` — the explicit refinement-alias binder
                # (docs/80 §2; `is TARGET s` is the bare-binder sugar). Model the
                # `is` RHS as the alias ident so resolution binds NAME (the target
                # itself is never a value reference — walk_expression skips the is-RHS).
                if operator_kind == TokenKind.Is and parser.peek() == TokenKind.As and parser.peek_at(1) == TokenKind.Ident:
                    parser, _ <- parser.advance()                              # `as`
                    rebind alias_token: Token, parser = parser.advance()           # NAME
                    right <- (Ast::Expr.Ident(Lexer::text_or_empty(alias_token, parser.source), alias_token.line))

                active <- (Ast::Expr.Binary(active, operator_kind, right, token.line))
                active <- (Ast::Expr.Unary(TokenKind.Not, active, token.line)) if is_negated_is
                return active


        def binary_expression_at_level(parser: lmut Parser, left: Ast::Expr, minimum_precedence: int) -> Ast::Expr:
            active: mutable Ast::Expr = left
            while true |parser, active|:
                rebind next: Ast::Expr?, parser = parser.binary_expression_step(active, minimum_precedence)
                if next is updated:
                    active <- updated
                else:
                    return active
            return active
