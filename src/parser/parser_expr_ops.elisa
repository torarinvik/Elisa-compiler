extend Parser:
    private:
        # Preserve an error-family selector when the compact AST keeps only the payload
        # type expression. The family is carried as a line-keyed annotation for the
        # backend/type registry.
        def record_error_union(parser: lmut Parser, line: u32, owner: sview) -> void:
            return if parser.peek() != TokenKind.Error
            parser, _ <- parser.advance()
            rebind accepted_bracket: bool, parser = parser.accept(TokenKind.LBracket)
            return if not accepted_bracket
            family_token: Token = parser.cursor()
            family: sview = Lexer::text_or_empty(family_token, parser.source) if parser.peek() == TokenKind.Ident else sview("", 0, 0)
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: owner, name: family, line: line}) if family != ""
            parser <- parser.skip_bracketed_group()

        def record_clone_error_union(parser: lmut Parser, line: u32) -> void:
            parser <- parser.record_error_union(line, "__clone_error_union")

        # Preserve the error-family selector on a first-class function type. The compact
        # AST stores `fn(...) -> T` as Expr.Lambda, so the `error[R]` suffix would otherwise
        # be consumed and lost before the backend can give the function value its fallible
        # ABI. The line is the Expr.Lambda line used by the fn-type side tables.
        def record_fn_type_error_union(parser: lmut Parser, line: u32) -> void:
            parser <- parser.record_error_union(line, "__fn_error_union")

        # Parameter type parsing leaves an ordinary parameter's `error[...]` suffix at the
        # cursor. Record only the suffix belonging to THIS parameter. The previous recovery
        # scanned backward over the whole source line; with `f: fn(...) error[R], value: i64`
        # on one line, the second parameter rediscovered the callback's suffix and was
        # incorrectly wrapped as `i64 error[R]`, producing an invalid generic ABI. Function
        # type parameters are handled separately by `__fn_error_union` metadata.
        def record_parameter_error_union(parser: lmut Parser, line: u32) -> void:
            return if parser.peek() != TokenKind.Error
            return if parser.peek_at(1) != TokenKind.LBracket or parser.peek_at(2) != TokenKind.Ident
            family: sview = Lexer::text_or_empty(parser.tokens[parser.position + 2], parser.source)
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__param_error_union", name: family, line: line}) if family != ""

        # An `else` that begins a recovery clause — `else return/raise/break/continue`
        # or `else binding:` — belongs to an enclosing `get`/`try`, not to a postfix
        # subscript default `a[i] else <value>`. Mirrors stage0's
        # elseIntroducesRecoveryClause so `x = get a[i] else return -1` parses.
        def else_introduces_recovery_clause(parser: Parser&) -> bool:
            false return if parser.peek() != TokenKind.Else
            after: TokenKind = parser.peek_at(1)
            true return if after == TokenKind.Return or after == TokenKind.Raise or after == TokenKind.Break or after == TokenKind.Continue
            return after == TokenKind.Ident and parser.peek_at(2) == TokenKind.Colon

        # Consume a subscript-default `else` (`a[i] else <value>`) only when the `else`
        # is not an enclosing get/try recovery clause. Returns whether it consumed one.
        def accept_subscript_else(parser: lmut Parser) -> bool:
            false return if parser.peek() != TokenKind.Else
            false return if parser.else_introduces_recovery_clause()
            parser, _ <- parser.advance()
            return true

        # Whether a `[...]` suffix on `active` is a TYPE-argument bracket rather than an index.
        # Only the reinterpret spellings qualify: `p.cast[T]` and `p.call_as[fn(A) -> R]`. Kept
        # to this closed set deliberately — a generic CALL's bracket (`f[K, V](x)`) shares the
        # syntax but its arguments are ordinary type expressions that already parse.
        def subscript_base_is_type_argument(active: Ast::Expr) -> bool:
            match active:
                Expr.Field(base_object, base_method, base_method_line):
                    return when base_method:
                        "cast" | "call_as" -> true
                        _ -> false
                _:
                    return false

        # Parse a `[...]` suffix on `active` — a subscript `a[i]`, a slice `a[lo:hi]` (with
        # either bound optional), or a multi-arg subscript / generic application `m[i, j]`.
        # The caller has matched the opening `[`; this consumes through the closing `]` and
        # returns the resulting expression. `@region` type suffixes on bracketed arguments
        # (`p.cast[T& @scratch]`) are consumed and discarded — a selector, not a value.
        def subscript_suffix(parser: lmut Parser, active: Ast::Expr, token: Token) -> Ast::Expr:
            parser, _ <- parser.advance()

            # A reinterpret's bracket holds a TYPE, so mark the context: looks_like_lambda only
            # accepts a `fn(A) -> R` with no `:`/`=>` body inside a type annotation, and without
            # that the signature read as a CALL plus a trailing binary `->` and never became an
            # Expr.Lambda for annotation_value_type to resolve.
            saved_type_annotation: bool = parser.in_type_annotation
            parser.in_type_annotation <- true if subscript_base_is_type_argument(active)

            # Optional low bound (absent in `a[:end_bound]` / `a[:]`).
            start_bound: mutable Ast::Expr = (Ast::Expr.Absent)
            if parser.peek() == TokenKind.Question:
                # Aggregate typestate marker `Foo[?]` (and as an element of
                # `Foo[?, !]`) is a leaf selector, not postfix optional syntax.
                rebind state_token: Token, parser = parser.advance()
                start_bound <- (Ast::Expr.Ident(Lexer::text_or_empty(state_token, parser.source), Ast::pos_of_token(state_token)))
            elif parser.peek() != TokenKind.Colon and parser.peek() != TokenKind.RBracket:
                rebind bound_expr_opt: Ast::Expr?, parser = parser.expression()
                start_bound <- bound_expr if bound_expr_opt is bound_expr
                rebind accepted_at: bool, parser = parser.accept(TokenKind.At)
                parser, _ <- parser.accept(TokenKind.Ident) if accepted_at

            # `clone[T error[E]]` leaves the error suffix after the payload type
            # expression has been parsed. Preserve it before dispatching on the
            # following comma or closing bracket.
            parser <- parser.record_clone_error_union(token.line) if parser.peek() == TokenKind.Error

            rebind accepted_colon: bool, parser = parser.accept(TokenKind.Colon)
            if accepted_colon:
                # Slice `a[start_bound:end_bound]` (and open-ended variants): optional high bound.
                end_bound: mutable Ast::Expr = (Ast::Expr.Absent)
                if parser.peek() != TokenKind.RBracket:
                    rebind end_bound_opt: Ast::Expr?, parser = parser.expression()
                    end_bound <- get end_bound_opt else end_bound
                parser, _ <- parser.expect(TokenKind.RBracket)
                parser.in_type_annotation <- saved_type_annotation
                return (Ast::Expr.Slice(active, start_bound, end_bound, Ast::pos_of_token(token)))
            elif parser.peek() == TokenKind.Comma:
                # Multi-arg subscript / generic type application (`m[i, j]`,
                # `dict[K, V]`): the low bound is the first argument.
                index_arguments: mutable darray[Ast::Expr] = [start_bound]
                while parser.accept(TokenKind.Comma) |parser|:
                    break if parser.peek() == TokenKind.RBracket
                    if parser.peek() == TokenKind.Question:
                        rebind state_token_n: Token, parser = parser.advance()
                        index_arguments.push((Ast::Expr.Ident(Lexer::text_or_empty(state_token_n, parser.source), Ast::pos_of_token(state_token_n))))
                    else:
                        rebind index_argument_opt: Ast::Expr?, parser = parser.expression()
                        index_arguments.push(index_argument) if index_argument_opt is index_argument
                    # `@region` suffix on this argument (see the start-bound case).
                    rebind accepted_at_2: bool, parser = parser.accept(TokenKind.At)
                    parser, _ <- parser.accept(TokenKind.Ident) if accepted_at_2
                parser, _ <- parser.expect(TokenKind.RBracket)
                parser.in_type_annotation <- saved_type_annotation
                return (Ast::Expr.IndexN(active, index_arguments, Ast::pos_of_token(token)))
            else:
                # Single subscript `a[i]`.
                parser, _ <- parser.expect(TokenKind.RBracket)
                parser.in_type_annotation <- saved_type_annotation
                rebind accepted_fallback: bool, parser = parser.accept_subscript_else()
                if accepted_fallback:
                    rebind fallback_option: Ast::Expr?, parser = parser.expression()
                    fallback: Ast::Expr = get fallback_option else (Ast::Expr.Invalid)
                    indexed: Ast::Expr = (Ast::Expr.Index(active, start_bound, Ast::pos_of_token(token)))
                    # The recursive Node refinement ABI is frozen while stage0 is the
                    # bootstrap compiler. Preserve checked-index syntax losslessly using
                    # the existing operator node: Binary(Index(...), Else, fallback).
                    return (Ast::Expr.Binary(indexed, TokenKind.Else, fallback, Ast::pos_of_token(token)))
                return (Ast::Expr.Index(active, start_bound, Ast::pos_of_token(token)))

        def append_handler_name_text(buffer: mutable darray[u8]&, text: sview) -> void:
            for handler_name_index in 0..<sview_len(text) |buffer, text|:
                buffer.push(sview_at(text, handler_name_index))

        def handler_effect_family(effect_ref: sview) -> sview:
            while handler_effect_index < sview_len(effect_ref) |handler_effect_index: usize = 0|:
                effect_ref[0:handler_effect_index] return if sview_at(effect_ref, handler_effect_index) == 46 or sview_at(effect_ref, handler_effect_index) == 91
                handler_effect_index <- handler_effect_index + 1
            return effect_ref

        # The concrete authority named by an abstract effect realization, e.g.
        # `Writer[sview] via Console.Write`. The source spelling is retained as one
        # effect reference; this helper exposes the second semantic dimension to the
        # parser-side handler grant propagation.
        def handler_effect_via(effect_ref: sview) -> sview:
            while handler_via_index + 4.usize() < sview_len(effect_ref) |handler_via_index: usize = 0|:
                is_via: bool = sview_at(effect_ref, handler_via_index) == 32 and sview_at(effect_ref, handler_via_index + 1.usize()) == 118 and sview_at(effect_ref, handler_via_index + 2.usize()) == 105 and sview_at(effect_ref, handler_via_index + 3.usize()) == 97 and sview_at(effect_ref, handler_via_index + 4.usize()) == 32
                return effect_ref[handler_via_index + 5.usize():sview_len(effect_ref)] if is_via
                handler_via_index <- handler_via_index + 1.usize()
            return sview("", 0, 0)

        # Compare effect references while ignoring layout whitespace. The handler context keeps
        # the installation's full specialization (`Writer[sview]`), while the source may spell
        # an explicitly specialized operation as `Writer[ sview ].write(...)`.
        def handler_effect_ref_equal(left: sview, right: sview) -> bool:
            left_index: mutable usize = 0
            right_index: mutable usize = 0
            while true |left_index, right_index, left, right|:
                while left_index < sview_len(left) and (sview_at(left, left_index) == 32 or sview_at(left, left_index) == 9 or sview_at(left, left_index) == 13) |left_index|:
                    left_index <- left_index + 1.usize()
                while right_index < sview_len(right) and (sview_at(right, right_index) == 32 or sview_at(right, right_index) == 9 or sview_at(right, right_index) == 13) |right_index|:
                    right_index <- right_index + 1.usize()
                return true if left_index >= sview_len(left) and right_index >= sview_len(right)
                return false if left_index >= sview_len(left) or right_index >= sview_len(right)
                return false if sview_at(left, left_index) != sview_at(right, right_index)
                left_index <- left_index + 1.usize()
                right_index <- right_index + 1.usize()
            return false

        # Whether an operation head belongs to the active compile-time specialization. Bare
        # `Writer.write` is the ergonomic spelling and matches by family; an indexed head must
        # match the complete active reference, otherwise a call for another instantiation could
        # be silently routed to the wrong hidden function.
        def handler_effect_head_family(effect_head: Ast::Expr) -> sview:
            match effect_head:
                Expr.Ident(effect_name, effect_name_pos):
                    return effect_name
                Expr.Index(Expr.Ident(effect_name, effect_name_pos), index, index_pos):
                    return effect_name
                Expr.IndexN(Expr.Ident(effect_name, effect_name_pos_n), arguments, index_n_pos):
                    return effect_name
                _:
                    return ""

        def handler_effect_head_matches(parser: Parser&, effect_head: Ast::Expr, active_effect: sview, call_offset: usize) -> bool:
            match effect_head:
                Expr.Ident(effect_name, effect_name_pos):
                    return effect_name == handler_effect_family(active_effect)
                Expr.Index(Expr.Ident(effect_name, effect_name_pos), index, index_pos):
                    head_start: usize = effect_name_pos.offset.usize()
                    return false if call_offset <= head_start
                    source_before_operation: sview = parser.span_view(head_start, call_offset)
                    dot_index: mutable usize = sview_len(source_before_operation)
                    depth: mutable int = 0
                    cursor: mutable usize = 0
                    while cursor < sview_len(source_before_operation) |cursor, dot_index, depth, source_before_operation|:
                        byte: u8 = sview_at(source_before_operation, cursor)
                        if byte == 46 and depth == 0:
                            dot_index <- cursor
                            break
                        depth <- depth + 1 if byte == 91 or byte == 40 or byte == 123
                        depth <- depth - 1 if depth > 0 and (byte == 93 or byte == 41 or byte == 125)
                        cursor <- cursor + 1.usize()
                    return false if dot_index >= sview_len(source_before_operation)
                    return handler_effect_ref_equal(source_before_operation[0:dot_index], active_effect)
                Expr.IndexN(Expr.Ident(effect_name, effect_name_pos_n), arguments, index_n_pos):
                    head_start_n: usize = effect_name_pos_n.offset.usize()
                    return false if call_offset <= head_start_n
                    source_before_operation_n: sview = parser.span_view(head_start_n, call_offset)
                    dot_index_n: mutable usize = sview_len(source_before_operation_n)
                    depth_n: mutable int = 0
                    cursor_n: mutable usize = 0
                    while cursor_n < sview_len(source_before_operation_n) |cursor_n, dot_index_n, depth_n, source_before_operation_n|:
                        byte_n: u8 = sview_at(source_before_operation_n, cursor_n)
                        if byte_n == 46 and depth_n == 0:
                            dot_index_n <- cursor_n
                            break
                        depth_n <- depth_n + 1 if byte_n == 91 or byte_n == 40 or byte_n == 123
                        depth_n <- depth_n - 1 if depth_n > 0 and (byte_n == 93 or byte_n == 41 or byte_n == 125)
                        cursor_n <- cursor_n + 1.usize()
                    return false if dot_index_n >= sview_len(source_before_operation_n)
                    return handler_effect_ref_equal(source_before_operation_n[0:dot_index_n], active_effect)
                _:
                    return false

        # Generate a parser-owned source name for a handler operation. The generated name is
        # an ordinary Elisa function name; keeping it in a stable reserved buffer means the
        # rewritten AST can safely retain the view after later names are generated.
        def handler_operation_name[@r](parser: mutable Parser& @r, handler: sview, operation: sview) -> sview:
            parser.handler_name_storage.reserve(parser.tokens.count * 64) if parser.handler_name_storage.count == 0
            start: usize = parser.handler_name_storage.count
            append_handler_name_text(parser.handler_name_storage, "__handler__")
            append_handler_name_text(parser.handler_name_storage, handler)
            append_handler_name_text(parser.handler_name_storage, "__")
            append_handler_name_text(parser.handler_name_storage, operation)
            return sview(&parser.handler_name_storage[start], 0, parser.handler_name_storage.count - start)

        def append_handler_capture_number(buffer: mutable darray[u8]&, value: usize) -> void:
            digits: mutable darray[u8] = []
            remaining: mutable usize = value
            if remaining == 0.usize():
                digits.push(48)
            else:
                while remaining > 0.usize() |remaining, digits|:
                    digits.push((48.usize() + (remaining % 10.usize())).u8())
                    remaining <- remaining / 10.usize()
            reverse_index: mutable usize = digits.count
            while reverse_index > 0.usize() |reverse_index, digits, buffer|:
                reverse_index <- reverse_index - 1.usize()
                buffer.push(digits[reverse_index])

        # Generate a lexical local for one handler capture. The source-level
        # handler remains a direct-call construct; these names are only the
        # ordinary locals that carry its evaluated arguments.
        def handler_capture_name[@r](parser: mutable Parser& @r, handler: sview, line: u32) -> sview:
            parser.handler_name_storage.reserve(parser.tokens.count * 64) if parser.handler_name_storage.count == 0
            start: usize = parser.handler_name_storage.count
            append_handler_name_text(parser.handler_name_storage, "__handler_capture__")
            append_handler_name_text(parser.handler_name_storage, handler)
            append_handler_name_text(parser.handler_name_storage, "__")
            append_handler_capture_number(parser.handler_name_storage, line.usize())
            append_handler_name_text(parser.handler_name_storage, "__")
            append_handler_capture_number(parser.handler_name_storage, parser.handler_capture_counter)
            parser.handler_capture_counter <- parser.handler_capture_counter + 1.usize()
            return sview(&parser.handler_name_storage[start], 0, parser.handler_name_storage.count - start)

        # A handler may intentionally implement only part of an effect. If its
        # operation set is known, rewrite only operations it actually provides;
        # the enclosing `can ... with ...` pass can then statically forward the
        # remaining operations to its parent handler. Unknown forward references
        # stay optimistic so declarations remain order-independent.
        def handler_declares_operation(parser: Parser&, handler_name: sview, operation: sview) -> bool:
            known_handler: mutable bool = false
            for annotation in parser.enum_annotations |known_handler|:
                known_handler <- true if annotation.owner == "__handler_decl" and annotation.name == handler_name
                return true if annotation.owner == handler_name and annotation.line == 3900000083 and annotation.name == operation
            return not known_handler

        # Normalize an effect operation after a block has been parsed. The postfix parser also
        # performs this rewrite while the handler context is active, but keeping this pass at the
        # block boundary makes the invariant explicit and covers parser helpers that temporarily
        # re-enter expression parsing with a copied context. It is still only AST normalization:
        # handler captures become ordinary leading arguments and no runtime handler is built.
        def rewrite_handler_expression(parser: lmut Parser, expression: Ast::Expr, effect_name: sview, handler_name: sview, captures: darray[Ast::Expr]) -> Ast::Expr:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_pos):
                        match callee:
                            Expr.Field(effect_head, operation, field_pos):
                                if parser.handler_effect_head_matches(effect_head, effect_name, call_pos.offset.usize()) and parser.handler_declares_operation(handler_name, operation):
                                    hidden_name: sview = parser.handler_operation_name(handler_name, operation)
                                    rewritten_arguments: mutable darray[Ast::Expr] = []
                                    rewritten_names: mutable darray[sview] = []
                                    for capture in captures |rewritten_arguments, rewritten_names|:
                                        rewritten_arguments.push(capture)
                                        rewritten_names.push("")
                                    argument_index: mutable usize = 0
                                    while argument_index < arguments.count |parser, argument_index, rewritten_arguments, rewritten_names, argument_names|:
                                        rebind rewritten_argument: Ast::Expr, parser = parser.rewrite_handler_expression(arguments[argument_index], effect_name, handler_name, captures)
                                        rewritten_arguments.push(rewritten_argument)
                                        rewritten_names.push(argument_names[argument_index] if argument_index < argument_names.count else "")
                                        argument_index <- argument_index + 1
                                    return (Ast::Expr.Call(Ast::Expr.Ident(hidden_name, field_pos), rewritten_arguments, rewritten_names, call_pos))
                            Expr.Scope(effect_head, operation, scope_pos):
                                if parser.handler_effect_head_matches(effect_head, effect_name, call_pos.offset.usize()) and parser.handler_declares_operation(handler_name, operation):
                                    hidden_name: sview = parser.handler_operation_name(handler_name, operation)
                                    rewritten_arguments: mutable darray[Ast::Expr] = []
                                    rewritten_names: mutable darray[sview] = []
                                    for capture in captures |rewritten_arguments, rewritten_names|:
                                        rewritten_arguments.push(capture)
                                        rewritten_names.push("")
                                    argument_index_scope: mutable usize = 0
                                    while argument_index_scope < arguments.count |parser, argument_index_scope, rewritten_arguments, rewritten_names, argument_names|:
                                        rebind rewritten_argument_scope: Ast::Expr, parser = parser.rewrite_handler_expression(arguments[argument_index_scope], effect_name, handler_name, captures)
                                        rewritten_arguments.push(rewritten_argument_scope)
                                        rewritten_names.push(argument_names[argument_index_scope] if argument_index_scope < argument_names.count else "")
                                        argument_index_scope <- argument_index_scope + 1
                                    return (Ast::Expr.Call(Ast::Expr.Ident(hidden_name, scope_pos), rewritten_arguments, rewritten_names, call_pos))
                            _:
                                pass
                        rebind rewritten_callee: Ast::Expr, parser = parser.rewrite_handler_expression(callee, effect_name, handler_name, captures)
                        rewritten_arguments: mutable darray[Ast::Expr] = []
                        rewritten_names: mutable darray[sview] = []
                        argument_index: mutable usize = 0
                        while argument_index < arguments.count |parser, argument_index, rewritten_arguments, rewritten_names, argument_names|:
                            rebind rewritten_argument: Ast::Expr, parser = parser.rewrite_handler_expression(arguments[argument_index], effect_name, handler_name, captures)
                            rewritten_arguments.push(rewritten_argument)
                            rewritten_names.push(argument_names[argument_index] if argument_index < argument_names.count else "")
                            argument_index <- argument_index + 1
                        return (Ast::Expr.Call(rewritten_callee, rewritten_arguments, rewritten_names, call_pos))
                    Expr.Field(object, field, field_pos):
                        rebind rewritten_object: Ast::Expr, parser = parser.rewrite_handler_expression(object, effect_name, handler_name, captures)
                        return (Ast::Expr.Field(rewritten_object, field, field_pos))
                    Expr.Scope(object, field, field_pos):
                        rebind rewritten_object: Ast::Expr, parser = parser.rewrite_handler_expression(object, effect_name, handler_name, captures)
                        return (Ast::Expr.Scope(rewritten_object, field, field_pos))
                    Expr.Index(object, index, index_pos):
                        rebind rewritten_object: Ast::Expr, parser = parser.rewrite_handler_expression(object, effect_name, handler_name, captures)
                        rebind rewritten_index: Ast::Expr, parser = parser.rewrite_handler_expression(index, effect_name, handler_name, captures)
                        return (Ast::Expr.Index(rewritten_object, rewritten_index, index_pos))
                    Expr.Slice(object, low, high, slice_pos):
                        rebind rewritten_object: Ast::Expr, parser = parser.rewrite_handler_expression(object, effect_name, handler_name, captures)
                        rebind rewritten_low: Ast::Expr, parser = parser.rewrite_handler_expression(low, effect_name, handler_name, captures)
                        rebind rewritten_high: Ast::Expr, parser = parser.rewrite_handler_expression(high, effect_name, handler_name, captures)
                        return (Ast::Expr.Slice(rewritten_object, rewritten_low, rewritten_high, slice_pos))
                    Expr.IndexN(object, arguments, index_pos):
                        rebind rewritten_object: Ast::Expr, parser = parser.rewrite_handler_expression(object, effect_name, handler_name, captures)
                        rewritten_arguments: mutable darray[Ast::Expr] = []
                        for argument in arguments |rewritten_arguments, parser|:
                            rebind rewritten_argument: Ast::Expr, parser = parser.rewrite_handler_expression(argument, effect_name, handler_name, captures)
                            rewritten_arguments.push(rewritten_argument)
                        return (Ast::Expr.IndexN(rewritten_object, rewritten_arguments, index_pos))
                    Expr.Binary(left, operator, right, binary_pos):
                        rebind rewritten_left: Ast::Expr, parser = parser.rewrite_handler_expression(left, effect_name, handler_name, captures)
                        rebind rewritten_right: Ast::Expr, parser = parser.rewrite_handler_expression(right, effect_name, handler_name, captures)
                        return (Ast::Expr.Binary(rewritten_left, operator, rewritten_right, binary_pos))
                    Expr.Unary(operator, operand, unary_pos):
                        rebind rewritten_operand: Ast::Expr, parser = parser.rewrite_handler_expression(operand, effect_name, handler_name, captures)
                        return (Ast::Expr.Unary(operator, rewritten_operand, unary_pos))
                    Expr.Move(operand, move_pos):
                        rebind rewritten_operand: Ast::Expr, parser = parser.rewrite_handler_expression(operand, effect_name, handler_name, captures)
                        return (Ast::Expr.Move(rewritten_operand, move_pos))
                    Expr.RegionNew(operand, region, new_pos):
                        rebind rewritten_operand: Ast::Expr, parser = parser.rewrite_handler_expression(operand, effect_name, handler_name, captures)
                        return (Ast::Expr.RegionNew(rewritten_operand, region, new_pos))
                    Expr.Paren(inner, paren_pos):
                        rebind rewritten_inner: Ast::Expr, parser = parser.rewrite_handler_expression(inner, effect_name, handler_name, captures)
                        return (Ast::Expr.Paren(rewritten_inner, paren_pos))
                    Expr.Array(elements, array_pos):
                        rewritten_elements: mutable darray[Ast::Expr] = []
                        for element in elements |rewritten_elements, parser|:
                            rebind rewritten_element: Ast::Expr, parser = parser.rewrite_handler_expression(element, effect_name, handler_name, captures)
                            rewritten_elements.push(rewritten_element)
                        return (Ast::Expr.Array(rewritten_elements, array_pos))
                    Expr.Tuple(elements, tuple_pos):
                        rewritten_elements: mutable darray[Ast::Expr] = []
                        for element in elements |rewritten_elements, parser|:
                            rebind rewritten_element: Ast::Expr, parser = parser.rewrite_handler_expression(element, effect_name, handler_name, captures)
                            rewritten_elements.push(rewritten_element)
                        return (Ast::Expr.Tuple(rewritten_elements, tuple_pos))
