extend Parser:
    private:
        # Error-union VALUE types currently carry one family in the compact AST/backend
        # metadata. Find a comma separating top-level families while ignoring commas in a
        # selected-variant block (`error[Family{A, B}]`). The selector starts at the `error`
        # token, before its opening bracket is consumed.
        def error_union_family_comma_index(parser: Parser&) -> usize:
            return parser.tokens.count if parser.peek() != TokenKind.Error or parser.peek_at(1) != TokenKind.LBracket
            remaining: usize = parser.tokens.count - parser.position
            offset: mutable usize = 1
            bracket_depth: mutable u32 = 0
            brace_depth: mutable u32 = 0
            while offset < remaining |offset, bracket_depth, brace_depth, parser|:
                kind: TokenKind = parser.peek_at(offset)
                if kind == TokenKind.LBracket:
                    bracket_depth <- bracket_depth + 1
                elif kind == TokenKind.RBracket:
                    return parser.tokens.count if bracket_depth <= 1
                    bracket_depth <- bracket_depth - 1
                elif kind == TokenKind.LBrace:
                    brace_depth <- brace_depth + 1
                elif kind == TokenKind.RBrace:
                    brace_depth <- brace_depth - 1 if brace_depth > 0
                elif kind == TokenKind.Comma and bracket_depth == 1 and brace_depth == 0:
                    return parser.position + offset
                offset <- offset + 1
            return parser.tokens.count

        def error_unsupported_value_error_union_families(parser: lmut Parser, comma: Token) -> void:
            message: sview @source = "error-union value types currently support exactly one family"
            parse_error: Ast::ParseError = Ast::ParseError{kind: Ast::ParseErrorKind.UnsupportedValueErrorUnionFamilies, line: comma.line, column: comma.column, context: message, got_kind: comma.kind, expected_kind: TokenKind.Eof, has_expected: false, detail_num2: comma.column + comma.length}
            parser.errors <- parser.errors.push(parse_error)

        # Preserve an error-family selector when the compact AST keeps only the payload
        # type expression. The family is carried as a line-keyed annotation for the
        # backend/type registry.
        def record_error_union(parser: lmut Parser, line: u32, owner: sview @source, offset: u32 = 0) -> void:
            return if parser.peek() != TokenKind.Error
            comma_index: usize = parser.error_union_family_comma_index()
            if comma_index < parser.tokens.count:
                comma: Token = parser.tokens[comma_index]
                parser <- parser.error_unsupported_value_error_union_families(comma)
            parser, _ <- parser.advance()
            rebind accepted_bracket: bool, parser = parser.accept(TokenKind.LBracket)
            return if not accepted_bracket
            family_token: Token = parser.cursor()
            family: sview = Lexer::text_or_empty(family_token, parser.source, parser.source_length) if parser.peek() == TokenKind.Ident else sview("", 0, 0)
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: owner, name: family, line: line, offset: offset}) if family != "" and comma_index >= parser.tokens.count
            parser <- parser.skip_bracketed_group()



        def record_clone_error_union(parser: lmut Parser, line: u32) -> void:
            parser <- parser.record_error_union(line, "__clone_error_union")



        # Preserve the error-family selector on a first-class function type. The compact
        # AST stores `fn(...) -> T` as Expr.Lambda, so the `error[R]` suffix would otherwise
        # be consumed and lost before the backend can give the function value its fallible
        # ABI. The line is the Expr.Lambda line used by the fn-type side tables.
        def record_fn_type_error_union(parser: lmut Parser, line: u32, offset: u32) -> void:
            parser <- parser.record_error_union(line, "__fn_error_union", offset)



        # Parameter type parsing leaves an ordinary parameter's `error[...]` suffix at the
        # cursor. Record only the suffix belonging to THIS parameter. The previous recovery
        # scanned backward over the whole source line; with `f: fn(...) error[R], value: i64`
        # on one line, the second parameter rediscovered the callback's suffix and was
        # incorrectly wrapped as `i64 error[R]`, producing an invalid generic ABI. Function
        # type parameters are handled separately by `__fn_error_union` metadata.
        def record_parameter_error_union(parser: lmut Parser, line: u32, offset: u32 = 0) -> void:
            return if:
                parser.peek() != TokenKind.Error
                parser.peek_at(1) != TokenKind.LBracket or parser.peek_at(2) != TokenKind.Ident
            comma_index: usize = parser.error_union_family_comma_index()
            if comma_index < parser.tokens.count:
                comma: Token = parser.tokens[comma_index]
                parser <- parser.error_unsupported_value_error_union_families(comma)
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__param_error_union_invalid", name: "", line: line, offset: offset})
            else:
                family: sview = Lexer::text_or_empty(parser.tokens[parser.position + 2], parser.source, parser.source_length)
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__param_error_union", name: family, line: line, offset: offset}) if family != ""

include "./parser_effect_handler_rewrite.elisa"
include "./parser_expr_postfix.elisa"
include "./parser_expr_binary.elisa"
