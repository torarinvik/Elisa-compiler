extend Parser:
    private:
        # Preserve an error-family selector when the compact AST keeps only the payload
        # type expression. The family is carried as a line-keyed annotation for the
        # backend/type registry.
        def record_error_union(parser: lmut Parser, line: u32, owner: sview) -> void:
            return if parser.peek() != TokenKind.Error
            parser, _ <- parser.advance()
            rebind accepted_bracket: bool, parser = parser.accept(TokenKind.LBracket)
            return if not accepted_bracket
            family_token: Token = parser.cursor()
            family: sview = Lexer::text_or_empty(family_token, parser.source) if parser.peek() == TokenKind.Ident else sview("", 0, 0)
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: owner, name: family, line: line}) if family != ""
            parser <- parser.skip_bracketed_group()



        def record_clone_error_union(parser: lmut Parser, line: u32) -> void:
            parser <- parser.record_error_union(line, "__clone_error_union")



        # Preserve the error-family selector on a first-class function type. The compact
        # AST stores `fn(...) -> T` as Expr.Lambda, so the `error[R]` suffix would otherwise
        # be consumed and lost before the backend can give the function value its fallible
        # ABI. The line is the Expr.Lambda line used by the fn-type side tables.
        def record_fn_type_error_union(parser: lmut Parser, line: u32) -> void:
            parser <- parser.record_error_union(line, "__fn_error_union")



        # Parameter type parsing leaves an ordinary parameter's `error[...]` suffix at the
        # cursor. Record only the suffix belonging to THIS parameter. The previous recovery
        # scanned backward over the whole source line; with `f: fn(...) error[R], value: i64`
        # on one line, the second parameter rediscovered the callback's suffix and was
        # incorrectly wrapped as `i64 error[R]`, producing an invalid generic ABI. Function
        # type parameters are handled separately by `__fn_error_union` metadata.
        def record_parameter_error_union(parser: lmut Parser, line: u32) -> void:
            return if parser.peek() != TokenKind.Error
            return if parser.peek_at(1) != TokenKind.LBracket or parser.peek_at(2) != TokenKind.Ident
            family: sview = Lexer::text_or_empty(parser.tokens[parser.position + 2], parser.source)
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__param_error_union", name: family, line: line}) if family != ""

include "./parser_effect_handler_rewrite.elisa"
include "./parser_expr_postfix.elisa"
include "./parser_expr_binary.elisa"
