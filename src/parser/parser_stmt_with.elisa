extend Parser:
    public:
        # docs/125 §5 — `with NAME = LITERAL[, NAME = LITERAL]*` or-alternative discriminators.
        # Port of stage0's match_with.go. An or-arm whose alternatives share a body but differ
        # in shape gives each alternative a distinguishing COMPILE-TIME CONSTANT, so the body
        # is written once and reads the constant uniformly:
        #
        #   Expr.IntLit(magnitude) with negated = false
        #   | Expr.Unary(TokenKind.Minus, Expr.IntLit(magnitude), _) with negated = true:
        #       ...uses `magnitude` and `negated`...
        #
        # Like `machine`/`when`, this is a PARSER-LEVEL desugar and stage1 owns no codegen: the
        # arm is FANNED OUT into one sibling MatchArm per alternative, each carrying a fresh copy
        # of the shared body with its `with` bindings prepended as ordinary immutable locals. No
        # AST/semantic/backend change — the constant is a normal local the body already reads.
        #
        # `with` binds at the arm-ALTERNATIVE (top) level; nested `with` inside a payload's
        # or-group is not supported (lift the or to the arm level). Because stage1's normal arm
        # header parses `|` with LOWER precedence than `,` (parse_pattern), this fan-out path is
        # taken ONLY when a top-level `with` is actually present (arm_header_has_with), leaving
        # every `with`-less arm on the existing path byte-for-byte unchanged.

        struct WithArmAlternative:
            pattern: Ast::Pattern
            with_decls: darray[Ast::Stmt]
            line: u32
            token: Token   # alternative's start token, for the R1 parity diagnostic

        # Does the current arm header carry a top-level `with`? Scans from the cursor to the
        # arm's block colon at bracket-depth 0, skipping grouped sub-spans; `|` doesn't nest.
        def arm_header_has_with(parser: Parser&) -> bool:
            machine over parser.position:
                state Scan(index: usize, depth: i64)
                start Scan(parser.position, 0)

                Scan(index, _), _ if index >= parser.tokens.count:
                    return false

                Scan(index, 0), _ if parser.tokens[index].kind == TokenKind.Colon or parser.tokens[index].kind == TokenKind.Newline or parser.tokens[index].kind == TokenKind.Eof:
                    return false

                Scan(index, 0), _ if parser.tokens[index].kind == TokenKind.With:
                    return true

                Scan(index, depth), _ if parser.tokens[index].kind == TokenKind.LParen or parser.tokens[index].kind == TokenKind.LBracket or parser.tokens[index].kind == TokenKind.LBrace:
                    -> Scan(index + 1, depth + 1)

                Scan(index, depth), _ if parser.tokens[index].kind == TokenKind.RParen or parser.tokens[index].kind == TokenKind.RBracket or parser.tokens[index].kind == TokenKind.RBrace:
                    -> Scan(index + 1, depth - 1)

                Scan(index, depth), _:
                    -> Scan(index + 1, depth)
            return false

        # Is the next non-Newline token a `|` (alternative separator on a continuation line)?
        def next_nonnewline_is_pipe(parser: Parser&) -> bool:
            machine over parser.position:
                state Scan(index: usize)
                start Scan(parser.position)

                Scan(index), _ if index >= parser.tokens.count:
                    return false

                Scan(index), _ if parser.tokens[index].kind == TokenKind.Newline:
                    -> Scan(index + 1)

                Scan(index), _:
                    return parser.tokens[index].kind == TokenKind.Pipe
            return false

        # Parse a full `with`-bearing arm and fan it out into one MatchArm per alternative.
        def parse_with_arm(parser: lmut Parser) -> darray[Ast::MatchArm]:
            alternatives: mutable darray[WithArmAlternative] = []
            rebind first_alt: WithArmAlternative, parser = parser.parse_with_alternative()
            alternatives.push(first_alt)
            # A `|` separating alternatives may sit on a continuation line, so a layout
            # Newline can precede it (unlike inside an expression). Skip newlines only when a
            # `|` actually follows, so a header that ends at `if`/`:` isn't over-consumed.
            machine over parser.position while parser.next_nonnewline_is_pipe():
                state More
                start More

                More, _:
                    parser <- parser.skip_newlines()
                    parser.position <- parser.position + 1                       # `|`
                    rebind alt: WithArmAlternative, parser = parser.parse_with_alternative()
                    alternatives.push(alt)
                    -> More

            # docs/125 §5 R1 — every alternative of a `with`-arm must bind the IDENTICAL set
            # of constant names, so the shared body reads a discriminator uniformly. A name
            # only some alternatives bind would resolve for those siblings and fail late as
            # `undefined identifier` on the others. Report the mismatch here, once, at the
            # offending alternative. Inert unless some alternative carries a `with`, so plain
            # or-arms are untouched.
            parser <- parser.check_with_binding_parity(alternatives)

            # Optional arm-header guard, shared by every fanned-out alternative.
            rebind guard: Ast::Expr, parser = parser.parse_optional_arm_guard()

            arms: mutable darray[Ast::MatchArm] = []
            # Halt safety: if an exotic tail left us off the block colon, drop it losslessly.
            rebind malformed: bool, parser = parser.align_with_arm_colon()
            arms return if malformed

            rebind body: darray[Ast::Stmt], parser = parser.parse_block()
            machine over arms for alt in alternatives:
                state Scan
                start Scan

                Scan, _:
                    append_with_alternative_arm(alt, body, guard, arms)
                    -> Scan
            return arms

        def append_with_alternative_arm(alt: WithArmAlternative, body: darray[Ast::Stmt], guard: Ast::Expr, arms: mutable darray[Ast::MatchArm]&) -> void:
            combined: mutable darray[Ast::Stmt] = []
            machine over combined for decl in alt.with_decls:
                state Scan
                start Scan

                Scan, _:
                    combined.push(decl)
                    -> Scan
            combined.extend(body)
            arms.push(Ast::MatchArm{pattern: alt.pattern, body: combined, guard: guard})

        # Land the cursor on the arm's block colon: drop an exotic tail span losslessly,
        # then report `true` (malformed; caller bails) if we're still off the colon,
        # advancing one token so the arm loop doesn't spin.
        def align_with_arm_colon(parser: lmut Parser) -> bool:
            false return if parser.peek() == TokenKind.Colon
            parser, _ <- parser.capture_pattern_span()
            false return if parser.peek() == TokenKind.Colon
            parser, _ <- parser.advance()   # malformed arm; don't spin
            return true

        # Optional arm-header guard: `if EXPR` before the block colon, or Absent when missing.
        def parse_optional_arm_guard(parser: lmut Parser) -> Ast::Expr:
            (Ast::Expr.Absent) return if parser.peek() != TokenKind.If
            parser, _ <- parser.advance()
            rebind guard_opt: Ast::Expr?, parser = parser.expression()
            if guard_opt is guard_value:
                return guard_value
            return (Ast::Expr.Absent)

        # One alternative: a primary/comma-tuple pattern (no top-level `|`) plus its `with`.
        def parse_with_alternative(parser: lmut Parser) -> WithArmAlternative:
            alt_token: Token = parser.cursor()
            rebind pattern: Ast::Pattern, parser = parser.parse_with_alternative_pattern()
            rebind decls: darray[Ast::Stmt], parser = parser.parse_optional_with_bindings()
            return WithArmAlternative{pattern: pattern, with_decls: decls, line: alt_token.line, token: alt_token}

        # A pattern for one alternative: a primary, or a comma-tuple of primaries. Unlike the
        # normal path this never consumes a top-level `|` (that separates alternatives).
        def parse_with_alternative_pattern(parser: lmut Parser) -> Ast::Pattern:
            rebind first: Ast::Pattern, parser = parser.parse_pattern_primary()
            first return if parser.peek() != TokenKind.Comma
            elements: mutable darray[Ast::Pattern] = [first]
            machine over parser.position while parser.peek() == TokenKind.Comma:
                state More
                state Element
                start More

                More, _:
                    parser.position <- parser.position + 1
                    -> Element

                Element, _ if parser.peek() == TokenKind.Colon or parser.peek() == TokenKind.Newline:
                    break

                Element, _:
                    rebind next_pattern: Ast::Pattern, parser = parser.parse_pattern_primary()
                    elements.push(next_pattern)
                    -> More
            return (Ast::Pattern.Tuple(elements))

        # Trailing `with NAME = LITERAL[, NAME = LITERAL]*` into immutable, inferred VarDecls,
        # or an empty list when absent. Values are parsed leniently (a `with` constant is a
        # literal; the frontend need not re-check that — stage0 owns the constant-ness rule).
        def parse_optional_with_bindings(parser: lmut Parser) -> darray[Ast::Stmt]:
            decls: mutable darray[Ast::Stmt] = []
            decls return if parser.peek() != TokenKind.With
            parser, _ <- parser.advance()   # with
            machine over parser.position while true:
                state Item
                state Separator
                start Item

                Item, _:
                    name_token: Token = parser.cursor()
                    name: sview = Lexer::text_or_empty(name_token, parser.source)
                    line: u32 = name_token.line
                    rebind ignored_name: Token, parser = parser.expect(TokenKind.Ident)
                    rebind ignored_assign: Token, parser = parser.expect(TokenKind.Assign)
                    rebind value_opt: Ast::Expr?, parser = parser.unary_expression()
                    value: Ast::Expr = get value_opt else (Ast::Expr.Invalid)
                    decls.push((Ast::Stmt.VarDecl(name, (Ast::Expr.Invalid), value, Ast::pos_at_line(line))))
                    -> Separator

                Separator, _ if parser.peek() == TokenKind.Comma:
                    parser.position <- parser.position + 1
                    -> Item

                Separator, _:
                    break
            return decls

        # docs/125 §5 R1 (see parse_with_arm). Emits SyntaxMismatchedWithBindings once per
        # alternative whose `with` name-set differs from the first alternative's. Inert
        # unless some alternative binds a `with`, so plain or-arms never trip it.
        def check_with_binding_parity(parser: lmut Parser, alternatives: darray[WithArmAlternative]) -> void:
            return if alternatives.count < 2
            any_with: mutable bool = false
            for alt in alternatives:
                any_with <- true if alt.with_decls.count > 0
                break if any_with
            return if not any_with
            base: darray[Ast::Stmt] = alternatives[0].with_decls
            for idx in 1..<alternatives.count |parser|:
                other: WithArmAlternative = alternatives[idx]
                parser <- parser.error_at(Ast::ParseErrorKind.MismatchedWithBindings, other.token) if not with_name_sets_match(base, other.with_decls)


# The `with` name of one prepended VarDecl statement, or "" for any other statement shape.
def with_decl_name(statement: Ast::Stmt) -> sview:
    match statement:
        Ast::Stmt.VarDecl(name, type_expression, value, line):
            return name
        _:
            return ""


# True iff every `with` name in `a` also appears in `b` (a ⊆ b by name).
def with_names_subset(a: darray[Ast::Stmt], b: darray[Ast::Stmt]) -> bool:
    result: mutable bool = true
    machine over result while true:
        state Scan(index: usize, all_found: bool)
        start Scan(0, true)

        Scan(index, all_found), _ if index >= a.count:
            result <- all_found
            break

        Scan(_, false), _:
            result <- false
            break

        Scan(index, true), _:
            needle: sview = with_decl_name(a[index])
            found: bool = any db in b where with_decl_name(db) == needle
            -> Scan(index + 1, found)
    return result


# True iff `a` and `b` bind the identical SET of `with` names (order/values irrelevant).
def with_name_sets_match(a: darray[Ast::Stmt], b: darray[Ast::Stmt]) -> bool:
    return with_names_subset(a, b) and with_names_subset(b, a)
