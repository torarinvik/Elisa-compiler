extend Parser:
    private:
        def prefixed_block_statement(parser: lmut Parser) -> Ast::Stmt?:
            line: u32 = parser.cursor().line

            # Classify the clause category from the leading token so region/effect
            # passes can dispatch structurally. Keyword-token prefixes map to their
            # spelling; contextual-keyword prefixes (`can`, `region`, …) are Idents
            # and carry their text directly; a bare `slot:` success arm is "arm".
            first_kind: TokenKind = parser.peek()
            first_token: Token = parser.cursor()
            is_arm: bool = first_kind == TokenKind.Ident and parser.peek_at(1) == TokenKind.Colon and parser.peek_at(2) == TokenKind.Newline
            # `region NAME(...)`: register NAME so type-position uses of the region
            # (`Box[i64, scratch]`, `@scratch` bindings) resolve.
            is_region_block: bool = first_kind == TokenKind.Ident and Lexer::text_or_empty(first_token, parser.source, parser.source_length) == "region" and parser.peek_at(1) == TokenKind.Ident
            region_named_token: Token = parser.tokens[parser.position + 1] if is_region_block else first_token
            parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: Lexer::text_or_empty(region_named_token, parser.source, parser.source_length), name: "__region_name", line: line}) if is_region_block
            # is_arm requires Ident, so the arm guard lives inside the Ident arm.
            block_kind: sview = match first_kind:
                TokenKind.With:    "with"
                TokenKind.Region:  "region"
                TokenKind.Try:     "try"
                TokenKind.Catch:   "catch"
                TokenKind.In:      "in"
                TokenKind.Error:   "error"
                TokenKind.Static:  "static"
                TokenKind.Ident:   "arm" if is_arm else Lexer::text_or_empty(first_token, parser.source, parser.source_length)
                _:                 ""

            # Capture the name a binding-introducing prefix brings into scope:
            # `error IDENT:` binds the error value; a success arm `IDENT:` binds the
            # result. Everything else binds nothing.
            binding: mutable sview = ""
            match first_kind:
                TokenKind.Error:
                    parser, _ <- parser.advance()                       # `error`
                    if parser.peek() == TokenKind.Ident:
                        error_token: Token = parser.cursor()
                        binding <- Lexer::text_or_empty(error_token, parser.source, parser.source_length)
                _:
                    binding <- Lexer::text_or_empty(first_token, parser.source, parser.source_length) if is_arm

            # Collect the prefix's identifier tokens (in order) up to the block colon:
            # granted effect names (`can Mem.Allocate:`) or a region name
            # (`region scratch(…):`). The leading clause keyword and the arm binding are
            # already captured above, so skip identifiers at position 0.
            clause: mutable darray[sview @source] @source = []
            installed_effect: mutable sview = ""
            installed_handler: mutable sview = ""
            installed_arguments: mutable darray[Ast::Expr] @source = []
            is_handler_install: mutable bool = false
            if block_kind == "can":
                rebind consumed_handler_clause: bool, parser = parser.consume_can_handler_clause(clause, installed_effect, installed_handler, installed_arguments) can Global{Read,Write}
                is_handler_install <- consumed_handler_clause
                parser <- parser.consume_unbracketed_via_effect(clause) if not is_handler_install and parser.can_via_clause_ahead()
            region_capacity_start: mutable usize = 0
            pool_capacity_start: mutable usize = 0
            shared_nursery_pool_requested: mutable bool = false
            shared_nursery_pool_paren_seen: mutable bool = false
            shared_nursery_pool_is_identifier: mutable bool = false
            # Whether the bracket currently open is a block's EFFECT LIST (`can [A, B]:`,
            # `trusted [Unsafe.PointerCast]:`) rather than a type argument. Clause identifiers
            # are otherwise collected at depth 0 only, so the bracketed spelling reached the
            # AST with an EMPTY clause and every consumer read it as granting nothing — which
            # is why `trusted [Global.Read]:` could not be told from `trusted:`. The
            # discriminator is position, not spelling: an effect list opens immediately after
            # the block keyword, before any clause entry, so `can Writer[sview]:` (where
            # `Writer` is already collected) keeps its type argument out of the clause.
            effect_list: mutable bool = false
            # Contextual block keywords are themselves Ident tokens. Detect the bracket
            # immediately after that leading token before the general scanner skips it.
            if first_kind == TokenKind.Ident and (block_kind == "can" or block_kind == "trusted") and parser.peek_at(1) == TokenKind.LBracket:
                parser, _ <- parser.advance()
            if parser.peek() == TokenKind.LBracket and clause.count == 0 and (block_kind == "can" or block_kind == "trusted"):
                parser <- parser.consume_block_effect_list(clause)
            while not is_handler_install and parser.peek() != TokenKind.Eof |parser, effect_list, depth: int = 0, first: bool = true|:
                kind: TokenKind = parser.peek()
                match kind:
                    TokenKind.LParen | TokenKind.LBracket:
                        # `with arena scratch(4096) as owner:` carries its capacity exactly like
                        # `region scratch(4096)`, so it is captured the same way -- without this
                        # the clause held only the names and the backend had no size to open an
                        # arena with.
                        region_capacity_start <- parser.cursor().start.usize() + 1 if (block_kind == "region" or block_kind == "with") and kind == TokenKind.LParen and depth == 0
                        pool_capacity_start <- parser.cursor().start.usize() + 1 if (block_kind == "pool" or block_kind == "nursery" or block_kind == "scope") and kind == TokenKind.LParen and depth == 0
                        if block_kind == "nursery" and shared_nursery_pool_requested and kind == TokenKind.LParen and depth == 0:
                            shared_nursery_pool_paren_seen <- true
                            shared_nursery_pool_is_identifier <- parser.peek_at(1) == TokenKind.Ident and parser.peek_at(2) == TokenKind.RParen
                        effect_list <- true if kind == TokenKind.LBracket and depth == 0 and clause.count == 0 and (block_kind == "can" or block_kind == "trusted")
                        depth <- depth + 1
                        parser, _ <- parser.advance()
                    TokenKind.RParen | TokenKind.RBracket:
                        if (block_kind == "region" or block_kind == "with") and kind == TokenKind.RParen and depth == 1 and region_capacity_start > 0:
                            capacity_end: usize = parser.cursor().start.usize()
                            clause.push(parser.span_view(region_capacity_start, capacity_end))
                            region_capacity_start <- 0
                        if (block_kind == "pool" or block_kind == "nursery" or block_kind == "scope") and kind == TokenKind.RParen and depth == 1 and pool_capacity_start > 0:
                            pool_capacity_end: usize = parser.cursor().start.usize()
                            clause.push(parser.span_view(pool_capacity_start, pool_capacity_end))
                            pool_capacity_start <- 0
                        if block_kind == "nursery" and shared_nursery_pool_requested and kind == TokenKind.RParen and depth == 1:
                            shared_nursery_pool_is_identifier <- false if parser.peek_at(1) != TokenKind.Colon and parser.peek_at(1) != TokenKind.Newline
                        depth <- depth - 1
                        effect_list <- false if kind == TokenKind.RBracket and depth == 0
                        parser, _ <- parser.advance()
                    TokenKind.Colon | TokenKind.Newline if depth == 0:
                        break
                    TokenKind.As if depth == 0 and (block_kind == "can" or block_kind == "lock" or block_kind == "with"):
                        # `can Effects as Family:` records the effect-family cast
                        # target; `lock mutex as guard:` records the guard binding;
                        # `with arena scratch(N) as owner:` binds the resource handle.
                        parser, _ <- parser.advance()
                        rebind binding_token: Token, parser = parser.expect(TokenKind.Ident)
                        binding <- Lexer::text_or_empty(binding_token, parser.source, parser.source_length)
                    TokenKind.Ident if (depth == 0 and not first) or (depth == 1 and effect_list):
                        # Preserve region's contextual `using` marker separately so the
                        # clause side-table retains allocator intent; qualified effect
                        # paths remain one entry.
                        clause_token: Token = parser.cursor()
                        if block_kind == "region" and Lexer::text_or_empty(clause_token, parser.source, parser.source_length) == "using":
                            clause.push("using")
                            parser, _ <- parser.advance()
                        else:
                            rebind dotted_clause_name: sview, parser = parser.parse_dotted_name(block_kind == "in")
                            if parser.peek() == TokenKind.LBrace and (block_kind == "can" or block_kind == "trusted"):
                                parser <- parser.consume_block_effect_members(dotted_clause_name, clause)
                            else:
                                clause.push(dotted_clause_name)
                            shared_nursery_pool_requested <- true if block_kind == "nursery" and clause.count == 1 and dotted_clause_name == "on"
                            # `pool workers(N):` binds the named pool handle in its
                            # body. Preserve it in the generic block binding slot.
                            binding <- dotted_clause_name if block_kind == "pool" and binding == ""
                    _:
                        first <- false
                        parser, _ <- parser.advance()

            if parser.peek() != TokenKind.Colon:
                # Region declarations are the only currently recognized prefix whose
                # no-block form is unambiguously invalid at this frontend layer. Keep
                # legacy recovery for other keyword-shaped expression forms until their
                # dedicated AST nodes are ported.
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, first_token) if block_kind == "region"
                # Keep the existing recovery node shape after recording the error;
                # downstream walkers already treat this expression as non-executable.
                return (Ast::Stmt.Expr((Ast::Expr.Invalid), Ast::pos_at_line(line)))

            # `nursery on(pool):` borrows a caller-owned pool. Keep the selected pool
            # name in the compact block clause (`on`, `pool`) and attach an exact
            # annotation so the semantic boundary pass can check its type and mutability.
            if shared_nursery_pool_requested and (not shared_nursery_pool_paren_seen or not shared_nursery_pool_is_identifier or clause.count != 2):
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, first_token)
            if shared_nursery_pool_requested and shared_nursery_pool_paren_seen and shared_nursery_pool_is_identifier and clause.count == 2 and clause[0] == "on":
                parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: clause[1], name: "__nursery_pool", line: line, offset: first_token.start})

            pool_scope: bool = block_kind == "pool" or block_kind == "nursery"
            parser.active_pool_depth <- parser.active_pool_depth + 1 if pool_scope
            # Remember this row so the block's EXTENT can be written back once the body has
            # been parsed. The row is pushed BEFORE the body so that `@r` annotations written
            # inside the block still resolve against a table that already contains it.
            region_row_index: usize = parser.local_region_annotations.count
            parser.local_region_annotations <- parser.local_region_annotations.push(Ast::LocalRegionAnnotation{name: "__region_local", type_expression: (Ast::Expr.Invalid), region: clause[0], line: line, owner_offset: first_token.start, end_line: 0}) if block_kind == "region" and clause.count > 0
            # A `can ComplexFlow:` grant exempts every block-`if` in its body (transitively)
            # from the flow-strict census. OR into the flag so nested non-ComplexFlow blocks
            # keep the exemption; restore afterwards.
            is_complex_flow: bool = block_kind == "can" and any grant in clause where grant == "ComplexFlow"
            saved_complex_flow: bool = parser.in_complex_flow
            parser.in_complex_flow <- parser.in_complex_flow or is_complex_flow
            saved_effect_name: sview = parser.active_effect_name
            saved_handler_name: sview = parser.active_handler_name
            saved_effect_identity_id: u32 = parser.active_effect_identity_id
            saved_handler_identity_id: u32 = parser.active_handler_identity_id
            installed_effect_value: sview = clause[0] if is_handler_install and clause.count > 0 else ""
            # Materialize handler captures as ordinary block locals before the
            # handler context becomes active. Every operation call then receives
            # an identifier, so a capture expression is evaluated exactly once
            # per installation rather than once per operation.
            installed_effect_identity_id: mutable u32 = 0
            installed_handler_identity_id: mutable u32 = 0
            if is_handler_install:
                installed_effect_identity_id <- parser.effect_identity_for_reference(installed_effect_value, parser.current_module)
                installed_handler_identity_id <- parser.handler_identity_for_name(installed_handler, parser.current_module)
            handler_capture_bindings: mutable darray[Ast::Stmt] @source = []
            handler_capture_arguments: mutable darray[Ast::Expr] @source = []
            if is_handler_install:
                for installed_argument in installed_arguments |parser, handler_capture_bindings, handler_capture_arguments|:
                    capture_name: sview @source = parser.handler_capture_name(installed_handler, line)
                    if parser.effect_install_capture_lines.count > 0:
                        last_capture_line: u32 = parser.effect_install_capture_lines[parser.effect_install_capture_lines.count - 1.usize()]
                        parser.effect_install_capture_lines_monotonic <- false if line < last_capture_line
                    # Retain the lexical capture name beside the installation. Later
                    # compile-time specialization of an effectful helper needs to pass the
                    # already-materialized capture into the helper clone; recovering it from
                    # declaration order would be fragile in nested blocks.
                    parser.effect_install_capture_lines <- parser.effect_install_capture_lines.push(line)
                    parser.effect_install_capture_names <- parser.effect_install_capture_names.push(capture_name)
                    parser.enum_annotations <- parser.enum_annotations.push(Ast::EnumAnnotation{owner: "__effect_install_capture", name: capture_name, line: line, identity_id: installed_handler_identity_id})
                    handler_capture_bindings.push(Ast::Stmt.VarDecl(capture_name, (Ast::Expr.Invalid), installed_argument, Ast::pos_at_line(line)))
                    handler_capture_arguments.push(Ast::Expr.Ident(capture_name, Ast::pos_at_line(line)))
            parser.active_effect_name <- installed_effect_value if is_handler_install
            parser.active_handler_name <- installed_handler if is_handler_install
            parser.active_effect_identity_id <- installed_effect_identity_id if is_handler_install
            parser.active_handler_identity_id <- installed_handler_identity_id if is_handler_install
            saved_handler_argument_start: usize = parser.active_handler_argument_start
            saved_handler_argument_count: usize = parser.active_handler_argument_count
            installed_handler_argument_start: usize = parser.active_handler_arguments.count
            if is_handler_install:
                for capture_argument in handler_capture_arguments |parser|:
                    parser.active_handler_arguments <- parser.active_handler_arguments.push(capture_argument)
            parser.active_handler_argument_start <- installed_handler_argument_start if is_handler_install
            parser.active_handler_argument_count <- handler_capture_arguments.count if is_handler_install
            saved_effect_install: u32 = parser.effect_active_install
            if is_handler_install:
                if parser.effect_install_lines.count > 0:
                    last_install_line: u32 = parser.effect_install_lines[parser.effect_install_lines.count - 1.usize()]
                    parser.effect_install_lines_monotonic <- false if line < last_install_line
                parser.effect_install_lines <- parser.effect_install_lines.push(line)
                parser.effect_install_parents <- parser.effect_install_parents.push(saved_effect_install)
                parser.effect_install_effects <- parser.effect_install_effects.push(installed_effect_value)
                parser.effect_install_handlers <- parser.effect_install_handlers.push(installed_handler)
                parser.effect_install_effect_identity_ids <- parser.effect_install_effect_identity_ids.push(parser.active_effect_identity_id)
                parser.effect_install_handler_identity_ids <- parser.effect_install_handler_identity_ids.push(parser.active_handler_identity_id)
                parser.effect_active_install <- line
            rebind parsed_body: darray[Ast::Stmt] @source, parser = parser.parse_block() can Global{Read,Write}
            parser.effect_active_install <- saved_effect_install
            # Write the block's closed extent back to its binder. Dedent may be located at the
            # next sibling's line; lexical_block_end_line derives the inclusive last in-scope
            # line and clamps uncertain/empty extents to the opening line rather than leaving
            # an accidentally unbounded proof scope.
            if block_kind == "region" and clause.count > 0 and region_row_index < parser.local_region_annotations.count:
                region_end_line: u32 = parser.lexical_block_end_line(line)
                region_end_offset: u32 = parser.lexical_block_end_offset(first_token.start)
                parser.local_region_annotations[region_row_index] <- Ast::LocalRegionAnnotation{name: "__region_local", type_expression: (Ast::Expr.Invalid), region: clause[0], line: line, owner_offset: first_token.start, end_line: region_end_line, end_offset: region_end_offset}
            body: mutable darray[Ast::Stmt] @source = parsed_body
            if is_handler_install:
                rebind normalized_body: darray[Ast::Stmt] @source, parser = parser.rewrite_handler_statements(body, installed_effect_value, installed_handler, handler_capture_arguments) can Global{Read,Write}
                body <- normalized_body
                # If the inner handler is partial, a second normalization pass
                # resolves still-abstract operations against the enclosing
                # handler. This is compile-time forwarding: the final AST has
                # one direct hidden call and no runtime handler chain.
                if saved_handler_name != "" and saved_effect_name != "":
                    fallback_arguments: mutable darray[Ast::Expr] @source = []
                    fallback_index: mutable usize = saved_handler_argument_start
                    fallback_end: usize = fallback_index + saved_handler_argument_count
                    while fallback_index < fallback_end |parser, fallback_index, fallback_arguments|:
                        fallback_arguments.push(parser.active_handler_arguments[fallback_index])
                        fallback_index <- fallback_index + 1.usize()
                    rebind forwarded_body: darray[Ast::Stmt] @source, parser = parser.rewrite_handler_statements(body, saved_effect_name, saved_handler_name, fallback_arguments) can Global{Read,Write}
                    body <- forwarded_body
                if handler_capture_bindings.count > 0.usize():
                    handler_capture_bindings.extend(body)
                    body <- handler_capture_bindings
            parser.active_effect_name <- saved_effect_name
            parser.active_handler_name <- saved_handler_name
            parser.active_effect_identity_id <- saved_effect_identity_id
            parser.active_handler_identity_id <- saved_handler_identity_id
            parser.active_handler_argument_start <- saved_handler_argument_start
            parser.active_handler_argument_count <- saved_handler_argument_count
            parser.in_complex_flow <- saved_complex_flow
            parser.active_pool_depth <- parser.active_pool_depth - 1 if pool_scope
            return (Ast::Stmt.Block(block_kind, clause, binding, body, Ast::pos_of_token(first_token)))
