# Convert a token's half-open source span into the AST position used by parser
# nodes. The postconditions document the diagnostic-coordinate contract.
extend Ast:
    public:
        # Fallback position for parser nodes that only know their start line.
        def pos_at_line(line: u32) -> Pos:
            ensure result.line == line
            ensure result.column == 0
            ensure result.offset == 0
            ensure result.end_line == line
            ensure result.end_column == 0
            ensure result.end_offset == 0
            return Pos{line: line, column: 0, offset: 0, end_line: line, end_column: 0, end_offset: 0}

        def pos_of_token(token: Lexer::Token&) -> Pos:
            ensure result.line == token.line
            ensure result.column == token.column
            ensure result.offset == token.start
            ensure result.end_line == token.line
            ensure result.end_column == token.column + token.length
            ensure result.end_offset == token.start + token.length
            return Pos{
                line: token.line,
                column: token.column,
                offset: token.start,
                end_line: token.line,
                end_column: token.column + token.length,
                end_offset: token.start + token.length
            }

        # Literal token text excludes its opening and closing quotes. Restore
        # those two delimiter columns in the diagnostic span.
        def pos_of_quoted_token(token: Lexer::Token&) -> Pos:
            ensure result.line == token.line
            ensure result.column == token.column
            ensure result.offset == token.start - 1
            ensure result.end_line == token.line
            ensure result.end_column == token.column + token.length + 2
            ensure result.end_offset == token.start + token.length + 1
            return Pos{
                line: token.line,
                column: token.column,
                offset: token.start - 1,
                end_line: token.line,
                end_column: token.column + token.length + 2,
                end_offset: token.start + token.length + 1
            }

        # Compose the half-open extent of two AST spans. This is the source
        # invariant used for expression, call, and declaration ranges.
        def pos_span(start: Pos&, end: Pos&) -> Pos:
            ensure result.line == start.line
            ensure result.column == start.column
            ensure result.offset == start.offset
            ensure result.end_line == end.end_line
            ensure result.end_column == end.end_column
            ensure result.end_offset == end.end_offset
            return Pos{
                line: start.line,
                column: start.column,
                offset: start.offset,
                end_line: end.end_line,
                end_column: end.end_column,
                end_offset: end.end_offset
            }
