# Parallel folds use the same transform and associative-combine lambdas as
# Stage0's map_reduce lowering, with the input split into independent bands.
extend Parser:
    private:
        def parallel_fold_expression(source: Ast::Expr, item: sview @source, seed: Ast::Expr, transform: Ast::Expr, operator: TokenKind, pos: Ast::Pos) -> Ast::Expr:
            address: Ast::Expr = (Ast::Expr.Unary(TokenKind.Ampersand, source, pos))
            slice: Ast::Expr = (Ast::Expr.Call((Ast::Expr.Ident("slice", pos)), [address], [""], pos))
            transform_lambda: Ast::Expr = (Ast::Expr.Lambda([item], [(Ast::Stmt.Return(transform, pos))], pos))
            left: Ast::Expr = (Ast::Expr.Ident("__par_l", pos))
            right: Ast::Expr = (Ast::Expr.Ident("__par_r", pos))
            combine: Ast::Expr = (Ast::Expr.Binary(left, operator, right, pos))
            combine_lambda: Ast::Expr = (Ast::Expr.Lambda(["__par_l", "__par_r"], [(Ast::Stmt.Return(combine, pos))], pos))
            return (Ast::Expr.Call((Ast::Expr.Ident("map_reduce", pos)), [slice, seed, transform_lambda, combine_lambda], ["", "", "", ""], pos))
