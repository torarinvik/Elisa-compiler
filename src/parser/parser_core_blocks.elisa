# Stage1 parser — block values, loop headers, and effect lists (`extend Parser:
# private:`). Covers bare-block values and their capture headers, `yield`, the
# accumulator loop header, and the `can[...]` trailing-effect-grant scanner.
# Continues parser_core_cursor.elisa; split out to keep each part under 600 lines.

extend Parser:
    private:
        # docs/119 §2: a bare block expression is the RHS of `x =` / `x: T =` written
        # as NEWLINE INDENT statements whose tail expression is the value (no `:` and
        # no `do` introducer). `bare_block_ahead` is the O(1) lookahead the RHS parsers
        # use to choose this form over an ordinary value expression.
        def bare_block_ahead(parser: Parser&) -> bool:
            return parser.peek() == TokenKind.Newline and parser.peek_at(1) == TokenKind.Indent

        # docs/119 §6 for value blocks: `x = |caps|` NEWLINE INDENT … — a capture
        # header licensing the named outer mutables for mutation inside the block.
        # The header shape is strict (`|IDENT(, IDENT)*|` then NEWLINE INDENT), so a
        # bitwise `|` can never match. Captures are consumed but not modeled (E4
        # enforcement is stage0's job; stage1 resolves the block body normally).
        def value_capture_header_ahead(parser: Parser&) -> bool:
            false return if parser.peek() != TokenKind.Pipe or parser.peek_at(1) != TokenKind.Ident
            # Scan `IDENT (, IDENT)*`; the yielded cursor lands on the closing pipe.
            closing_pipe_index: mutable usize = 1
            while parser.peek_at(closing_pipe_index) == TokenKind.Ident |parser, closing_pipe_index|:
                closing_pipe_index <- closing_pipe_index + 1
                if parser.peek_at(closing_pipe_index) == TokenKind.Comma:
                    closing_pipe_index <- closing_pipe_index + 1
                else:
                    break
            return parser.peek_at(closing_pipe_index) == TokenKind.Pipe and parser.peek_at(closing_pipe_index + 1) == TokenKind.Newline and parser.peek_at(closing_pipe_index + 2) == TokenKind.Indent

        # The two block-expression RHS forms every `=`/`<-` site shares: bare block
        # (§2) and captured block (§6). `block_value_rhs_ahead` is the O(1) lookahead;
        # `parse_block_value_rhs` consumes the optional header then the block.
        def block_value_rhs_ahead(parser: Parser&) -> bool:
            return parser.bare_block_ahead() or parser.value_capture_header_ahead()

        def parse_block_value_rhs(parser: lmut Parser) -> Ast::Expr:
            rebind accepted_pipe: bool, parser = parser.accept(TokenKind.Pipe)
            parser <- parser.consume_capture_names() if accepted_pipe
            rebind __ret_242: Ast::Expr, parser = parser.parse_bare_block_value()
            return __ret_242

        # Consume the `IDENT (, IDENT)*` names of an already-opened capture header,
        # through its closing pipe.
        def consume_capture_names(parser: lmut Parser) -> void:
            while parser.peek() == TokenKind.Ident |parser|:
                parser, _ <- parser.advance()
                rebind accepted_comma_2: bool, parser = parser.accept(TokenKind.Comma)
                break if not accepted_comma_2
            parser, _ <- parser.expect(TokenKind.Pipe)

        def parse_bare_block_value(parser: lmut Parser) -> Ast::Expr:
            line: u32 = parser.cursor().line
            previous_value_block: bool = parser.in_value_block
            parser.in_value_block <- true
            parser, _ <- parser.expect(TokenKind.Newline)
            parser, _ <- parser.expect(TokenKind.Indent)
            items: mutable darray[Ast::Stmt] = []
            while true |parser|:
                parser <- parser.skip_newlines()
                break if parser.peek() == TokenKind.Dedent or parser.peek() == TokenKind.Eof
                rebind __m_253: Ast::Stmt?, parser = parser.statement()
                if __m_253 is body_statement:
                    items.push(body_statement)
                    parser <- parser.skip_trailing_can(true)
                    parser, _ <- parser.accept(TokenKind.Newline)
                else:
                    parser, _ <- parser.advance()
            parser, _ <- parser.expect(TokenKind.Dedent)
            parser.in_value_block <- previous_value_block
            (Ast::Expr.Invalid) return if items.count == 0
            # The tail statement is the block's value; truncating it off leaves `items`
            # as the leading locals — no second darray, no copy.
            last_index: usize = items.count - 1
            value: mutable Ast::Expr = Ast::Expr.Invalid
            if items[last_index] is Stmt.Expr(expression, expression_line):
                value <- expression
            elif items[last_index] is Stmt.If(condition, then_body, else_body, if_line):
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, parser.cursor()) if else_body.count == 0
                rebind then_value: Ast::Expr, parser = parser.branch_to_value(then_body)
                rebind else_value: Ast::Expr, parser = parser.branch_to_value(else_body)
                value <- Ast::Expr.If(condition, then_value, else_value, if_line)
            elif items[last_index] is Stmt.Match(scrutinee, arms, match_line):
                value <- Ast::Expr.Match(scrutinee, arms, match_line)
            items.truncate(last_index)
            return (Ast::Expr.Block(items, value, [], Ast::pos_at_line(line)))

        # Convert one `if`/`else` branch body into its value expression: the branch's
        # own tail statement yields the value; any preceding statements ride a nested
        # block expression.
        def branch_to_value(parser: lmut Parser, body: darray[Ast::Stmt]) -> Ast::Expr:
            # An empty branch has no value expression — a legitimately absent value (an
            # `if` used as a value with no `else` yields this for its alternative). Absent,
            # not Invalid, so check_if_value_missing_else can flag the missing else without
            # a genuine parse error masquerading as one.
            (Ast::Expr.Absent) return if body.count == 0
            last_statement: Ast::Stmt = body[body.count - 1]
            is_single_statement: bool = body.count == 1
            line: u32 = parser.cursor().line
            # `body` is borrowed, so the leading locals must be copied (unlike
            # parse_bare_block_value, which owns and truncates its items). The
            # comprehension must run BEFORE the tail_statement_to_value rebind —
            # hoisting the rebind above it detaches the comprehension from its
            # inferred arena ("darray reserve requires an active in <arena>: scope").
            statements: darray[Ast::Stmt] = [body[statement_index] for statement_index in 0..<body.count - 1]
            tail_value: mutable Ast::Expr = Ast::Expr.Invalid
            if last_statement is Stmt.Expr(expression, expression_line):
                tail_value <- expression
            elif last_statement is Stmt.If(condition, nested_then_body, nested_else_body, nested_line):
                parser <- parser.error_at(Ast::ParseErrorKind.UnexpectedToken, parser.cursor()) if nested_else_body.count == 0
                rebind nested_then_value: Ast::Expr, parser = parser.branch_to_value(nested_then_body)
                rebind nested_else_value: Ast::Expr, parser = parser.branch_to_value(nested_else_body)
                tail_value <- Ast::Expr.If(condition, nested_then_value, nested_else_value, nested_line)
            elif last_statement is Stmt.Match(nested_scrutinee, nested_arms, nested_line):
                tail_value <- Ast::Expr.Match(nested_scrutinee, nested_arms, nested_line)
            tail_value return if is_single_statement
            return (Ast::Expr.Block(statements, tail_value, [], Ast::pos_at_line(line)))


        # docs/119 §3/§6: loop-expression headers. `capture_header_ahead` reports whether
        # the current `|` opens a `|item,…|` header whose closing pipe is immediately
        # followed by the loop body `:` or a `-> yield` (a bitwise `a | b | c` never
        # satisfies this — its second top-level pipe is followed by an operand).
        def capture_header_ahead(parser: Parser&) -> bool:
            false return if parser.peek() != TokenKind.Pipe or parser.peek_at(1) != TokenKind.Ident
            # Scan forward for the closing depth-0 pipe; the token after it decides. Only a
            # top-level pipe or newline (or EOF) ends the scan — a depth-0 `:` does NOT, so
            # a typed accumulator `|n: T = 0|` keeps scanning to its closing pipe.
            depth: mutable int = 0
            lookahead_index: mutable usize = 1
            while true |parser, depth, lookahead_index|:
                kind: TokenKind = parser.peek_at(lookahead_index)
                false return if kind == TokenKind.Eof
                is_opener: bool = kind == TokenKind.LParen or kind == TokenKind.LBracket or kind == TokenKind.LBrace
                is_closer: bool = kind == TokenKind.RParen or kind == TokenKind.RBracket or kind == TokenKind.RBrace
                depth <- depth + 1 if is_opener
                false return if is_closer and depth == 0   # left the enclosing expression: not a header
                depth <- depth - 1 if is_closer
                at_closing_pipe: bool = depth == 0 and kind == TokenKind.Pipe
                next_kind: TokenKind = parser.peek_at(lookahead_index + 1)
                (next_kind == TokenKind.Colon or next_kind == TokenKind.Arrow) return if at_closing_pipe
                false return if depth == 0 and kind == TokenKind.Newline
                lookahead_index <- lookahead_index + 1
            return false

        # True when positioned at a loop-header opener: a declaration-led `| IDENT =` or a
        # capture header. Disambiguates the header `|` from a bitwise `|`.
        def loop_header_at(parser: Parser&) -> bool:
            false return if parser.peek() != TokenKind.Pipe
            true return if parser.peek_at(1) == TokenKind.Ident and parser.peek_at(2) == TokenKind.Assign
            return parser.capture_header_ahead()

        # Parse a loop iterable/condition that may be followed by a `|header|`. binary
        # parsing stops at the header's opening pipe (loop_header_at) but consumes a
        # genuine bitwise `|` normally, so a plain `parser.expression()` already yields the
        # pre-header expression (see for_statement / while_statement).

        # Parse `-> yield` (possibly a tuple `-> a, b`).
        def parse_yield_expression(parser: lmut Parser) -> Ast::Expr:
            line: u32 = parser.cursor().line
            rebind first_opt: Ast::Expr?, parser = parser.expression()
            first: Ast::Expr = get first_opt else (Ast::Expr.Invalid)
            first return if parser.peek() != TokenKind.Comma
            elements: mutable darray[Ast::Expr] = [first]
            while parser.accept(TokenKind.Comma) |parser|:
                rebind next_element_opt: Ast::Expr?, parser = parser.expression()
                if next_element_opt is next_element:
                    elements.push(next_element)
            return (Ast::Expr.Tuple(elements, Ast::pos_at_line(line)))

        # Either record `name` as a loop-header accumulator declaration (when `=` was
        # accepted) or as a bare capture. Extracted because `when`/`match` cannot
        # scrutinize a bool (docs/125 §6b), and both arms are multi-statement.
        # `name = init` — parse the initializer and record the accumulator declaration.
        #
        # This takes ONE regionless-ref container param (`declarations`) on purpose. The
        # initializer is a region-VALUED result (an `Expr` handle whose payload holds a
        # container — a call's `arguments` darray), so pushing it makes this a "void
        # grower", and the region-adoption that keeps that payload alive in the CALLER's
        # region only fires for a single-container grower (the soundness gate in
        # analyzer_region_param_inference.go: with two containers a value ambient-bound to
        # one could be inserted into the other, an escape the handle-level checker does not
        # catch). Merged with the capture push, this had TWO container params, adoption was
        # skipped, and the payload landed in this function's auto region and was freed on
        # return — leaving `arguments` dangling. `|i = f(n)|` then crashed the resolver with
        # a garbage child handle, while `|i = name|` (no container payload) and `|i = f()|`
        # (empty arg list) were fine. The two containers were never used by one call anyway.
        def consume_loop_header_accumulator(parser: lmut Parser, name_text: sview, name_token: Token, accumulator_type: Ast::Expr, declarations: mutable darray[Ast::Stmt]&) -> void:
            saved_suppress_pipe: bool = parser.suppress_pipe
            parser.suppress_pipe <- true
            rebind initializer_opt: Ast::Expr?, parser = parser.expression()
            initializer: Ast::Expr = get initializer_opt else (Ast::Expr.Invalid)
            parser.suppress_pipe <- saved_suppress_pipe
            # PRESERVE the `: T` annotation (was dropped → Invalid): stage0 could infer an
            # accumulator's type, but the stage1 backend needs it to resolve a bare-literal
            # initializer (`|depth: int = 0|` — an IntLit has no type context on its own).
            declarations.push((Ast::Stmt.VarDecl(name_text, accumulator_type, initializer, Ast::pos_at_line(name_token.line))))

        # Parse `|name = init, capture, …| [-> yield]`. Accumulator decls (`name = init`)
        # fill `declarations`; bare captures are collected in `captures` (docs/119 §6). Returns the
        # yield expression (Invalid when there is no `->`), setting `has_yield`.
        def parse_loop_header(parser: lmut Parser, declarations: mutable darray[Ast::Stmt]&, captures: mutable darray[sview]&, has_yield: mutable bool&) -> Ast::Expr:
            parser, _ <- parser.expect(TokenKind.Pipe)
            while true |parser|:
                rebind name_token: Token, parser = parser.expect(TokenKind.Ident)
                name_text: sview = Lexer::text_or_empty(name_token, parser.source)
                # Optional `: T` annotation on an accumulator (`|n: u32 = 0|`) — the type
                # is a selector for resolution, not a value reference, so it is parsed and
                # dropped (like variable_declaration_statement's type).
                rebind accepted_colon: bool, parser = parser.accept(TokenKind.Colon)
                # CAPTURE the accumulator's `: T` type (was skipped) so the backend can resolve a
                # bare-literal initializer. Parsed in type-annotation context, pipe suppressed so a
                # `|` closing the header is not read as bitwise-or.
                accumulator_type: mutable Ast::Expr = (Ast::Expr.Invalid)
                if accepted_colon:
                    saved_suppress_pipe_type: bool = parser.suppress_pipe
                    parser.suppress_pipe <- true
                    parser.in_type_annotation <- true
                    rebind accumulator_type_opt: Ast::Expr?, parser = parser.expression()
                    parser.in_type_annotation <- false
                    parser.suppress_pipe <- saved_suppress_pipe_type
                    accumulator_type <- get accumulator_type_opt else (Ast::Expr.Invalid)
                rebind accepted_assign: bool, parser = parser.accept(TokenKind.Assign)
                # Bare name (no `=`) is a capture; `name = init` is an accumulator. Kept
                # apart so the accumulator path is a SINGLE-container grower (see above).
                captures.push(name_text) if not accepted_assign
                parser <- parser.consume_loop_header_accumulator(name_text, name_token, accumulator_type, declarations) if accepted_assign
                rebind accepted_comma_3: bool, parser = parser.accept(TokenKind.Comma)
                break if not accepted_comma_3
            parser, _ <- parser.expect(TokenKind.Pipe)
            rebind accepted_arrow: bool, parser = parser.accept(TokenKind.Arrow)
            has_yield <- accepted_arrow
            (Ast::Expr.Invalid) return if not accepted_arrow
            rebind __ret_394: Ast::Expr, parser = parser.parse_yield_expression()
            return __ret_394

        # Wrap a loop that carries a header into a block expression whose leading
        # accumulator decls scope the loop and whose value is the yield (Invalid for the
        # statement form). Emitted as an expression statement so a value-form loop can be
        # the tail value of an enclosing bare block.
        def wrap_loop_header(parser: lmut Parser, declarations: darray[Ast::Stmt], yield_expression: Ast::Expr, loop_statement: Ast::Stmt, line: u32, captures: darray[sview]) -> Ast::Stmt:
            all_statements: mutable darray[Ast::Stmt] = [declaration for declaration in declarations]
            all_statements.push(loop_statement)
            return (Ast::Stmt.Expr((Ast::Expr.Block(all_statements, yield_expression, captures, Ast::pos_at_line(line))), Ast::pos_at_line(line)))


        # Consume a trailing inline effect grant `... can E1, E2` (no block colon) that
        # follows an expression, e.g. `return f() can Memory.Allocate, Abort.Panic` or
        # `print(x can Console.Write)`. The block form `can …:` is a statement handled
        # elsewhere; this is the postfix modifier. The effect list's own commas are part
        # of the grant, so the scan stops only at a depth-0 closing bracket, line break,
        # or block colon — not at a comma.
        # Consume a trailing effect grant (`can[E1, E2]` or the bare `can E1, E2`) after an
        # expression, recording the granted effect names (dotted spans) into
        # `parser.captured_effects`. The buffer is reset on every call, so it always
        # reflects the most recent trailing `can` (empty when there was none) — a signature
        # reader uses this to recover the grant a return-type `expression()` swallowed here.
        # `guard_block_opener` = the call site is a block-body statement boundary (parse_block),
        # where the next token may be a sibling `can …:` BLOCK opener rather than a trailing
        # inline grant — do NOT consume that (it would orphan its `:`). Signature/return-type
        # callers pass false: there a `can[…]:` IS a trailing grant whose `:` is the body colon.

        # If the current token is an identifier, consume it as a dotted effect name and
        # append it to `captured_effects`; otherwise leave the parser untouched. Extracted
        # so the two `can`-list scan loops below stay single-statement bodies.
        def push_dotted_effect_if_ident(parser: lmut Parser) -> void:
            return if parser.peek() != TokenKind.Ident
            rebind name: sview, parser = parser.parse_dotted_name()
            parser.captured_effects <- parser.captured_effects.push(name)

        # Look ahead (non-destructively) from the current `can` token: true when the
        # clause terminates at a depth-0 block colon before any line break, i.e. it opens
        # a `can …:` statement block rather than a trailing inline grant.
        def block_opener_ahead(parser: Parser&) -> bool:
            scan: mutable usize = parser.position + 1.usize()
            depth: mutable int = 0
            is_block_opener: mutable bool = false
            done: mutable bool = false
            while scan < parser.tokens.count |parser, scan, depth, is_block_opener, done|:
                break if done
                kind: TokenKind = parser.tokens[scan].kind
                is_opener: bool = kind == TokenKind.LParen or kind == TokenKind.LBracket or kind == TokenKind.LBrace
                is_closer: bool = kind == TokenKind.RParen or kind == TokenKind.RBracket or kind == TokenKind.RBrace
                if is_opener:
                    depth <- depth + 1
                elif is_closer:
                    done <- true if depth == 0
                    depth <- depth - 1 if depth > 0
                elif depth == 0 and kind == TokenKind.Colon:
                    is_block_opener <- true
                    done <- true
                elif depth == 0 and (kind == TokenKind.Newline or kind == TokenKind.Dedent or kind == TokenKind.Eof):
                    done <- true
                scan <- scan + 1.usize()
            return is_block_opener

        # Bracketed form `can[E1, E2]`: the effect set is delimited by `[...]`, so consume
        # exactly the balanced brackets and stop — the following comma (if any) is a
        # parameter separator, not part of the grant. Caller has already consumed `can`.

        # Conditionally advance one token, discarding it. Local to this file so it does
        # not collide with any sibling part-file's own `advance_if` helper.
        def advance_effect_token_if(parser: lmut Parser, cond: bool) -> void:
            return if not cond
            parser, _ <- parser.advance()

        def consume_bracket_effect_list(parser: lmut Parser) -> void:
            parser, _ <- parser.advance()                          # consume `[`
            while parser.peek() != TokenKind.RBracket and parser.peek() != TokenKind.Eof |parser|:
                parser <- parser.push_dotted_effect_if_ident()
                rebind accepted_comma: bool, parser = parser.accept(TokenKind.Comma)
                # tolerate a stray token
                parser <- parser.advance_effect_token_if(not accepted_comma and parser.peek() != TokenKind.RBracket and parser.peek() != TokenKind.Eof)
            parser, _ <- parser.accept(TokenKind.RBracket)

        # Select bracket-vs-bare effect-list scanning without a ternary over two
        # lmut-Parser-threading calls (that form mis-lowers — docs/125 migration note).
        def consume_effect_list(parser: lmut Parser, is_bracket_form: bool) -> void:
            if is_bracket_form:
                parser <- parser.consume_bracket_effect_list()
            else:
                while parser.peek() != TokenKind.Eof |parser|:
                    kind: TokenKind = parser.peek()
                    break if kind == TokenKind.RParen or kind == TokenKind.RBracket or kind == TokenKind.RBrace or kind == TokenKind.Newline or kind == TokenKind.Dedent or kind == TokenKind.Colon
                    parser <- parser.push_dotted_effect_if_ident()
                    rebind accepted_comma: bool, parser = parser.accept(TokenKind.Comma)
                    break if not accepted_comma

        def skip_trailing_can(parser: lmut Parser, guard_block_opener: bool) -> void:
            # Clear in place (no fresh alloc — that would escape the parser's region).
            parser.captured_effects <- parser.captured_effects.truncate(0)

            return if parser.peek() != TokenKind.Ident

            current_token: Token = parser.cursor()
            return if Lexer::text_or_empty(current_token, parser.source) != "can"

            # At a block-body boundary: if the clause ahead is a `can …:` statement block,
            # leave it entirely for `statement()` to parse.
            return if guard_block_opener and parser.block_opener_ahead()

            parser, _ <- parser.advance()                           # consume `can`

            is_bracket_form: bool = parser.peek() == TokenKind.LBracket
            parser <- parser.consume_effect_list(is_bracket_form)
            parser.allocation_region_names <- parser.allocation_region_names.push("__inline_can") if not is_bracket_form
            parser.allocation_region_lines <- parser.allocation_region_lines.push(current_token.line) if not is_bracket_form
            # Record each granted ref beside the marker so the ungranted-call check
            # can verify FAMILY coverage (stage0 warns when the postfix grant list
            # omits a required family, e.g. arena_free under can Memory.Release only).
            if not is_bracket_form:
                for granted_ref in parser.captured_effects |parser|:
                    parser.allocation_region_names <- parser.allocation_region_names.push(granted_ref)
                    parser.allocation_region_lines <- parser.allocation_region_lines.push(current_token.line)
