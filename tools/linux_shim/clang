#!/usr/bin/env bash
# Linux `clang`/`cc` shim for the gate (Phase T.5). The suite's link lines are written for
# Apple ld (`-Wl,-dead_strip`, `-Wl,-stack_size,N`, `-lLLVM`); GNU ld rejects them. Rather than
# a `uname` branch in 40 scripts, the gate host puts this directory FIRST on PATH
# (tools/remote_env.sh) and the real clang is found by ELISA_REAL_CLANG or llvm-config.
#   -Wl,-dead_strip        -> -Wl,--gc-sections
#   -Wl,-stack_size,N      -> dropped (main-thread stack is `ulimit -s` on Linux)
#   -lLLVM                 -> -lLLVM-<major> (the single shared library Debian ships)
#   link steps             -> -no-pie (stage0/stage1 objects use absolute relocations) and
#                             --unresolved-symbols=ignore-all (the runtime references
#                             optional elisa_native_callback_* entry points that -dead_strip
#                             drops on macOS; a Linux twin of pymodule_runtime_fallback.c is
#                             the proper fix, plan §T.5)
real="${ELISA_REAL_CLANG:-}"
if [[ -z "$real" ]]; then
  bindir="$("${LLVM_CONFIG:-llvm-config}" --bindir 2>/dev/null)"
  real="$bindir/clang"; [[ -x "$real" ]] || real="$(command -v clang-21 || command -v clang-20 || command -v clang-19)"
fi
[[ "$(basename "$0")" == clang++ ]] && real="${real}++"
major="$("${LLVM_CONFIG:-llvm-config}" --version 2>/dev/null | cut -d. -f1)"
# -lLLVM: the single shared library when the installation has one (Debian/apt); otherwise the
# static component archives in one link group (the upstream release tarballs ship no
# libLLVM*.so), plus the system libraries they need.
llvm_libs=("-lLLVM${major:+-$major}")
llvm_libdir="$("${LLVM_CONFIG:-llvm-config}" --libdir 2>/dev/null)"
if [[ -n "$llvm_libdir" ]] && ! compgen -G "$llvm_libdir/libLLVM*.so*" >/dev/null; then
  read -r -a llvm_static <<<"$("${LLVM_CONFIG:-llvm-config}" --libs --link-static)"
  read -r -a llvm_system <<<"$("${LLVM_CONFIG:-llvm-config}" --system-libs --link-static)"
  llvm_libs=("-L$llvm_libdir" -Wl,--start-group "${llvm_static[@]}" -Wl,--end-group "${llvm_system[@]}" -lstdc++ -lm)
fi
args=(); compile_only=0
for a in "$@"; do
  case "$a" in
    -c|-E|-S|-fsyntax-only) compile_only=1; args+=("$a") ;;
    -Wl,-dead_strip) args+=("-Wl,--gc-sections") ;;
    -Wl,-stack_size,*) ;;
    -Wl,-undefined,dynamic_lookup) ;;
    -bundle) args+=("-shared") ;;
    -undefined) skip_next=1 ;;
    -lLLVM) args+=("${llvm_libs[@]}") ;;
    *) if [[ -n "${skip_next:-}" ]]; then skip_next=""; else args+=("$a"); fi ;;
  esac
done
extra=()
[[ "$compile_only" == 0 ]] && extra=(-no-pie -Wl,--unresolved-symbols=ignore-all)
exec "$real" "${extra[@]}" "${args[@]}"
