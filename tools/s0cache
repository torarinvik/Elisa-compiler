def is_native_tool_image(path):
    descriptor = None
    try:
        nonblocking = getattr(os, "O_NONBLOCK", None)
        if nonblocking is None:
            return False
        flags = os.O_RDONLY | nonblocking
        descriptor = os.open(path, flags)
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            return False
        with os.fdopen(descriptor, "rb") as executable:
            descriptor = None
            return executable.read(4) in NATIVE_TOOL_MAGICS
    except OSError:
        return False
    finally:
        if descriptor is not None:
            try:
                os.close(descriptor)
            except OSError:
                pass


def stat_line(kind, mode="-", why="-"):
    p = os.environ.get("ELISA_S0_CACHE_STATS")
    if p:
        try:
            with open(p, "a") as f:
                f.write("%s\t%s\t%s\n" % (kind, mode or "-", why))
        except OSError:
            pass


def passthrough(real, argv, mode="-", why="-"):
    stat_line("bypass", mode, why)
    os.execv(real, [real] + argv)


def _write_spool(spool, data):
    view = memoryview(data)
    total = 0
    while view:
        try:
            written = spool.write(view)
        except (OSError, ValueError, TypeError):
            return total, False
        if written is None or written <= 0:
            return total, False
        total += written
        view = view[written:]
    return total, True


def _mark_capture_reason(state, reason, *, replace=False):
    if state[0] is None or replace:
        state[0] = reason


def _write_sink(sink, data):
    view = memoryview(data)
    total = 0
    while view:
        try:
            written = sink.write(view)
        except (OSError, ValueError, TypeError):
            return total, False
        if written is None or written <= 0:
            return total, False
        total += written
        view = view[written:]
    return total, True


def _copy_spool_to_sink(spool, sink, limit=CACHE_TEXT_MAX_BYTES, expected=None):
    """Copy a bounded spool and return the number of bytes delivered."""
    sent = 0
    try:
        size = min(os.fstat(spool.fileno()).st_size, limit)
        spool.seek(0)
        while sent < size:
            chunk = spool.read(min(1024 * 1024, size - sent))
            if not chunk:
                return sent, False
            if expected is not None and chunk != bytes(expected[sent:sent + len(chunk)]):
                return sent, False
            written, complete = _write_sink(sink, chunk)
            sent += written
            if not complete:
                return sent, False
        return sent, True
    except (OSError, ValueError, TypeError):
        return sent, False


def _recover_spool_to_sink(spool, sink, sent=0, limit=CACHE_TEXT_MAX_BYTES):
    """Retry a failed spool replay with positioned reads, if available."""
    try:
        size = min(os.fstat(spool.fileno()).st_size, limit)
        if sent > size:
            return False
        if hasattr(os, "pread"):
            while sent < size:
                chunk = os.pread(spool.fileno(), min(1024 * 1024, size - sent), sent)
                if not chunk:
                    return False
                written, complete = _write_sink(sink, chunk)
                sent += written
                if not complete:
                    return False
            return True
        spool.seek(sent)
        while sent < size:
            chunk = spool.read(min(1024 * 1024, size - sent))
            if not chunk:
                return False
            written, complete = _write_sink(sink, chunk)
            sent += written
            if not complete:
                return False
        return True
    except (OSError, ValueError, TypeError):
        return False


def _fallback_spool_to_sink(spool, sink, captured_data, sent=0):
    if captured_data is not None:
        if sent > len(captured_data):
            return False
        written, complete = _write_sink(sink, captured_data[sent:])
        return complete and sent + written == len(captured_data)
    return _recover_spool_to_sink(spool, sink, sent)


def _drain_child_stream(source, spool, sink, capture_state, already_replayed,
                        spooled_size, captured_prefix):
    """Spool child output while retaining only a cache-sized replay prefix in RAM."""
    try:
        while True:
            # read1() maps to one underlying read on the subprocess pipe; plain
            # read(n) may wait for n bytes and let a small-output child block.
            chunk = source.read1(1024 * 1024)
            if not chunk:
                break
            if already_replayed[0]:
                written, complete = _write_sink(sink, chunk)
                if not complete or written != len(chunk):
                    _mark_capture_reason(capture_state, "output-write", replace=True)
                try:
                    sink.flush()
                except (OSError, ValueError):
                    _mark_capture_reason(capture_state, "output-write", replace=True)
                continue
            remaining = CACHE_TEXT_MAX_BYTES - spooled_size[0]
            stored = chunk[:remaining]
            overflow = chunk[remaining:]
            written, stored_all = _write_spool(spool, stored)
            spooled_size[0] += written
            # Keep a bounded memory copy as an emergency replay source. The disk
            # spool normally handles output; this preserves the compiler's bytes
            # if a later spool read fails after the child has exited.
            captured_prefix.extend(stored[:written])
            if not stored_all:
                # If scratch storage fails, replay the saved prefix and stream
                # the rest. The compiler's status and output survive; this call
                # is not eligible for cache publication.
                _mark_capture_reason(capture_state, "spool-write")
                overflow = chunk[written:]
            elif overflow:
                # Output beyond the cache bound is never a candidate. Replay the
                # bounded prefix and pass subsequent bytes through without using
                # more temporary storage.
                _mark_capture_reason(capture_state, "output-limit")
            else:
                continue
            sent, replayed = _copy_spool_to_sink(spool, sink, expected=captured_prefix)
            if not replayed or sent != len(captured_prefix):
                _mark_capture_reason(capture_state, "spool-replay", replace=True)
                _fallback_spool_to_sink(spool, sink, captured_prefix, sent)
            already_replayed[0] = True
            written, complete = _write_sink(sink, overflow)
            if not complete or written != len(overflow):
                _mark_capture_reason(capture_state, "output-write", replace=True)
            try:
                sink.flush()
            except (OSError, ValueError):
                _mark_capture_reason(capture_state, "output-write", replace=True)
    except (OSError, ValueError):
        # A broken capture pipe is a cache decline. Closing it lets the child see
        # the same write failure it would see if the caller closed its output.
        _mark_capture_reason(capture_state, "pipe-read", replace=True)
    finally:
        try:
            source.close()
        except (OSError, ValueError):
            _mark_capture_reason(capture_state, "pipe-close", replace=True)


def _abort_spooled_child(proc, readers):
    """Reap a child and join any readers if capture setup or waiting fails."""
    try:
        if proc.poll() is None:
            proc.kill()
    except (OSError, ValueError):
        pass
    try:
        proc.wait()
    except BaseException:
        pass
    streams = (getattr(proc, "stdout", None), getattr(proc, "stderr", None))
    for index, stream in enumerate(streams):
        if stream is None:
            continue
        reader = readers[index] if index < len(readers) else None
        if reader is None or reader.ident is None:
            try:
                stream.close()
            except (OSError, ValueError):
                pass
    for reader in readers:
        if reader.ident is not None:
            try:
                reader.join()
            except RuntimeError:
                pass


def run_spooled(real, argv, env):
    """Run with communicate()-like capture semantics and bounded in-memory output."""
    stdout_spool = stderr_spool = None
    try:
        stdout_spool = tempfile.TemporaryFile(mode="w+b", buffering=0)
        stderr_spool = tempfile.TemporaryFile(mode="w+b", buffering=0)
    except OSError:
        if stdout_spool is not None:
            try:
                stdout_spool.close()
            except Exception:
                pass
        if stderr_spool is not None:
            try:
                stderr_spool.close()
            except Exception:
                pass
        # If temporary storage is unavailable, preserve compiler output by letting
        # it inherit the caller's descriptors. This result cannot be admitted to cache.
        proc = subprocess.Popen([real] + argv, stdin=subprocess.DEVNULL, env=env)
        proc.wait()
        proc.stdout_data = proc.stderr_data = None
        proc.output_spools = None
        proc.output_capture_complete = False
        proc.output_capture_reason = "spool-create"
        return proc

    proc = None
    readers = []
    try:
        proc = subprocess.Popen([real] + argv, stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
        capture_state = [None]
        already_replayed = [[False], [False]]
        spooled_sizes = [[0], [0]]
        captured_prefixes = [bytearray(), bytearray()]
        readers = [
            threading.Thread(target=_drain_child_stream,
                             args=(proc.stdout, stdout_spool, sys.stdout.buffer,
                                   capture_state, already_replayed[0], spooled_sizes[0],
                                   captured_prefixes[0])),
            threading.Thread(target=_drain_child_stream,
                             args=(proc.stderr, stderr_spool, sys.stderr.buffer,
                                   capture_state, already_replayed[1], spooled_sizes[1],
                                   captured_prefixes[1])),
        ]
        for reader in readers:
            reader.start()
        proc.wait()
        for reader in readers:
            reader.join()
        # The bounded bytearrays are exact copies of everything admitted to the
        # spool. Keep them as the cache/replay source so a later disk read failure
        # cannot discard output after the compiler has already exited.
        proc.stdout_data, proc.stderr_data = captured_prefixes
        proc.output_capture_reason = capture_state[0]
        proc.output_capture_complete = capture_state[0] is None
        proc.output_spools = (stdout_spool, stderr_spool,
                              [flag[0] for flag in already_replayed])
        return proc
    except BaseException:
        if proc is not None:
            _abort_spooled_child(proc, readers)
        for spool in (stdout_spool, stderr_spool):
            try:
                spool.close()
            except Exception:
                pass
        raise


def replay_spooled_output(proc):
    spools = getattr(proc, "output_spools", None)
    if spools is None:
        return
    stdout_spool, stderr_spool, already_replayed = spools
    try:
        # Under-bound streams retain the wrapper's original stdout-then-stderr
        # replay after the child exits. Over-bound streams already replayed their
        # prefix and passed the remainder through live.
        for index, (spool, sink, data) in enumerate((
            (stdout_spool, sys.stdout.buffer, getattr(proc, "stdout_data", None)),
            (stderr_spool, sys.stderr.buffer, getattr(proc, "stderr_data", None)),
        )):
            if already_replayed[index]:
                continue
            sent, replayed = _copy_spool_to_sink(spool, sink, expected=data)
            if not replayed or (data is not None and sent != len(data)):
                proc.output_capture_complete = False
                proc.output_capture_reason = "spool-replay"
                _fallback_spool_to_sink(spool, sink, data, sent)
            try:
                sink.flush()
            except (OSError, ValueError):
                proc.output_capture_complete = False
                proc.output_capture_reason = "output-write"
    finally:
        for spool in (stdout_spool, stderr_spool):
            try:
                spool.close()
            except Exception:
                proc.output_capture_complete = False
                if proc.output_capture_reason is None:
                    proc.output_capture_reason = "spool-close"
        proc.output_spools = None


def repo_root():
    return os.path.abspath(os.environ.get("REPO_ROOT")
                           or os.path.dirname(os.path.dirname(os.path.abspath(__file__))))


def key_name(path, base, repo):
    """A path as it enters the KEY: relative to the input's dir, else to the repo, else itself."""
    for prefix, tag in ((base, "@in/"), (repo, "@root/")):
        if prefix and len(prefix) > 1 and (path == prefix or path.startswith(prefix + os.sep)):
            return tag + os.path.relpath(path, prefix)
    return path


def mask(data, inpath, base):
    """Replace the caller's source path with placeholders (store); see unmask (serve)."""
    if len(inpath) > 8:
        data = data.replace(inpath.encode(), IN_MARK)
    if len(base) > 8:
        data = data.replace(base.encode(), DIR_MARK)
    return data


def unmask(data, inpath, base):
    return data.replace(IN_MARK, inpath.encode()).replace(DIR_MARK, base.encode())


def include_closure(root):
    """Ordered (abspath, bytes, identity) triples for source and includes, or None."""
    out, seen, stack = [], set(), [os.path.abspath(root)]
    total_bytes = 0
    while stack:
        path = stack.pop()
        if path in seen:
            continue
        if len(seen) >= MAX_INCLUDE_FILES:
            return None
        seen.add(path)
        try:
            flags = (os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
                     | getattr(os, "O_NONBLOCK", 0))
            descriptor = os.open(path, flags)
            with os.fdopen(descriptor, "rb") as f:
                before = os.fstat(f.fileno())
                if not stat.S_ISREG(before.st_mode):
                    return None
                remaining = MAX_INCLUDE_CLOSURE_BYTES - total_bytes
                if before.st_size > MAX_INCLUDE_FILE_BYTES or before.st_size > remaining:
                    return None
                data = f.read(min(MAX_INCLUDE_FILE_BYTES, remaining) + 1)
                after = os.fstat(f.fileno())
            identity = lambda info: (info.st_dev, info.st_ino, info.st_size,
                                     info.st_mtime_ns, info.st_ctime_ns)
            if (identity(before) != identity(after)
                    or len(data) != after.st_size
                    or len(data) > MAX_INCLUDE_FILE_BYTES
                    or len(data) > remaining
                    or regular_file_identity(path) != identity(after)):
                return None
        except OSError:
            return None
        total_bytes += len(data)
        out.append((path, data, identity(after)))
        base = os.path.dirname(path)
        for raw in data.split(b"\n"):
            line = raw.strip()
            if line.startswith(b"#"):
                line = line[1:].strip()
            inc = None
            if line.startswith(b"include "):
                rest = line[8:].strip()
                if len(rest) >= 2 and rest[:1] == b'"' and rest[-1:] == b'"':
                    inc = rest[1:-1]
                # An UNQUOTED rest is not an include: `parseIncludeDirective` returns false and
                # the oracle ignores the line. Prose does reach here — a `#` comment is stripped
                # of its marker first, so `# include flattening, so gen2 …` looks like a
                # directive. Treating that as uncacheable made 93 of this repo's 1470 sources
                # (and 352 gate calls) bypass the memo for no reason.
            elif line.startswith(b"{$") and line.endswith(b"}") and len(line) >= 4:
                body = line[2:-1].strip().split(None, 1)
                if body and body[0].lower() in (b"i", b"include") and len(body) > 1:
                    arg = body[1].strip()
                    if len(arg) >= 2 and arg[:1] in (b"'", b'"') and arg[-1:] == arg[:1]:
                        arg = arg[1:-1]
                    elif arg.split() != [arg]:
                        arg = b""  # unquoted WITH whitespace: the oracle rejects it, so skip
                    inc = arg or None
            if inc is None:
                continue
            try:
                inc_s = inc.decode()
            except UnicodeDecodeError:
                return None
            target = inc_s if os.path.isabs(inc_s) else os.path.join(base, inc_s)
            if not os.path.exists(target):
                return None
            stack.append(os.path.abspath(target))
    return out


def include_closure_unchanged(closure):
    """Reject reuse if any source/include inode changed since key construction."""
    try:
        return all(regular_file_identity(path) == identity
                   for path, _, identity in closure)
    except OSError:
        return False


def binary_hash(real, *, require_native=False):
    """Hash one stable regular tool file, optionally requiring a native image."""
    identity = lambda info: (info.st_dev, info.st_ino, info.st_size,
                             info.st_mtime_ns, info.st_ctime_ns)
    before = os.stat(real)
    if not stat.S_ISREG(before.st_mode):
        raise OSError("tool is not a regular file")
    flags = os.O_RDONLY | getattr(os, "O_NONBLOCK", 0)
    descriptor = os.open(real, flags)
    try:
        source = os.fdopen(descriptor, "rb")
        descriptor = None
        with source as f:
            st = os.fstat(f.fileno())
            if not stat.S_ISREG(st.st_mode) or identity(before) != identity(st):
                raise OSError("tool changed while opening")
            first_bytes = f.read(4)
            if require_native and first_bytes not in NATIVE_TOOL_MAGICS:
                raise OSError("tool is not a native image")
            f.seek(0)
            return _binary_hash_open_file(real, f, st, identity)
    finally:
        if descriptor is not None:
            try:
                os.close(descriptor)
            except OSError:
                pass


def _binary_hash_open_file(real, source, st, identity):
    root = cache_root()
    # mtime and size alone are not enough: replacing a same-size compiler binary
    # and restoring its mtime would otherwise keep returning the old content hash.
    # ctime changes on content updates, while device/inode catch atomic replacement.
    tag = (f"{os.path.abspath(real)}|{st.st_dev}|{st.st_ino}|{st.st_size}|"
           f"{st.st_mtime_ns}|{st.st_ctime_ns}")
    memo = os.path.join(root, "bin." + hashlib.sha256(tag.encode()).hexdigest()[:24])
    try:
        cached = read_cache_file_bounded(memo, 65).decode("ascii").strip()
        if (len(cached) == 64 and all(char in "0123456789abcdef" for char in cached)
                and identity(os.fstat(source.fileno())) == identity(st)
                and identity(os.stat(real)) == identity(st)):
            return cached
    except (OSError, ValueError, UnicodeDecodeError):
        pass
    h = hashlib.sha256()
    for chunk in iter(lambda: source.read(1 << 20), b""):
        h.update(chunk)
    if identity(os.fstat(source.fileno())) != identity(st):
        raise OSError("tool changed while hashing")
    if identity(os.stat(real)) != identity(st):
        raise OSError("tool changed after hashing")
    digest = h.hexdigest()
    os.makedirs(root, exist_ok=True)
    tmp = None
    try:
        with tempfile.NamedTemporaryFile("w", dir=root, prefix="bin-hash.", delete=False) as f:
            tmp = f.name
            f.write(digest)
        os.replace(tmp, memo)
        tmp = None
    finally:
        if tmp is not None:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    return digest


def regular_file_identity(path):
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return None
    if not stat.S_ISREG(st.st_mode):
        return None
    return (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns)


def read_cache_file_bounded(path, maximum):
    """Read one stable regular cache file without trusting its recorded size."""
    flags = (os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
             | getattr(os, "O_NONBLOCK", 0))
    descriptor = os.open(path, flags)
    with os.fdopen(descriptor, "rb") as source:
        before = os.fstat(source.fileno())
        if not stat.S_ISREG(before.st_mode) or before.st_size > maximum:
            raise ValueError("invalid or oversized cache payload")
        data = source.read(maximum + 1)
        after = os.fstat(source.fileno())
    current = os.lstat(path)
    identity = lambda info: (info.st_dev, info.st_ino, info.st_size,
                             info.st_mtime_ns, info.st_ctime_ns)
    if (len(data) != before.st_size or len(data) > maximum or not stat.S_ISREG(current.st_mode)
            or identity(before) != identity(after) or identity(after) != identity(current)):
        raise ValueError("cache payload changed while reading")
    return data


def cache_root():
    path = os.environ.get("ELISA_S0_CACHE_DIR") or os.path.join(
        os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache"),
        "elisa-s0cache")
    return os.path.realpath(path)


def cache_entry_paths_are_regular(entry):
    root = os.path.dirname(os.path.dirname(entry))
    shard = os.path.dirname(entry)
    files = [os.path.join(entry, name) for name in ("rc", "out", "err", "path", "obj", "certificate")]
    for path in (root, shard, entry):
        try:
            mode = os.lstat(path).st_mode
        except FileNotFoundError:
            continue
        except OSError:
            return False
        if not stat.S_ISDIR(mode):
            return False
    for path in files:
        try:
            mode = os.lstat(path).st_mode
        except FileNotFoundError:
            continue
        except OSError:
            return False
        if not stat.S_ISREG(mode):
            return False
    return True


def valid_certificate(data, pid=None):
    try:
        certificate = json.loads(data)
        if certificate.get("version") != 3:
            return False
        certificate_pid = certificate.get("pid")
        # bool is an int subclass in Python and JSON true decodes to True.
        if type(certificate_pid) is not int:
            return False
        if certificate_pid <= 0 or (pid is not None and certificate_pid != pid):
            return False
        dependencies = certificate.get("dependencies")
        if not isinstance(dependencies, list) or not 1 <= len(dependencies) <= 16:
            return False
        for dependency in dependencies:
            path, digest = dependency["path"], dependency["sha256"]
            selector = dependency.get("selector", "")
            if not isinstance(path, str) or not os.path.isabs(path) or not isinstance(digest, str) or len(digest) != 64:
                return False
            if selector:
                if selector == "@llc":
                    selected = shutil.which("llc")
                    if selected is None:
                        selected = next((p for p in ("/opt/homebrew/opt/llvm/bin/llc", "/usr/local/opt/llvm/bin/llc")
                                         if os.path.isfile(p) and os.access(p, os.X_OK)), None)
                elif selector == "@merger":
                    fields = os.environ.get("ELISA_LD", "").split()
                    selected = shutil.which(fields[0] if fields else "ld")
                    if not fields and sys.platform == "darwin" and selected == "/usr/bin/ld":
                        try:
                            probe = subprocess.run(["/usr/bin/xcrun", "--find", "ld"],
                                                   capture_output=True, text=True, timeout=5, check=False)
                            candidate = probe.stdout.strip()
                            if (probe.returncode == 0 and os.path.isabs(candidate)
                                    and os.path.isfile(candidate) and os.access(candidate, os.X_OK)):
                                selected = candidate
                        except (OSError, subprocess.TimeoutExpired):
                            pass
                    if selected:
                        selected = os.path.realpath(selected)
                else:
                    selected = shutil.which(selector)
                if not selected or os.path.abspath(selected) != path:
                    return False
            if binary_hash(path, require_native=bool(selector)) != digest:
                # Hashing a script launcher cannot identify the executable it
                # delegates to. Such tool selectors are not certifiable here.
                return False
        return True
    except (OSError, ValueError, TypeError, KeyError, AttributeError, UnicodeError):
        return False


def explicit_codegen_jobs_setting():
    """Whether Core will use the keyed worker setting instead of its host default."""
    text = os.environ.get("ELISACORE_CODEGEN_JOBS", "").strip()
    if not text:
        return False
    digits = text[1:] if text[:1] in ("+", "-") else text
    if not digits or any(char < "0" or char > "9" for char in digits):
        return False
    try:
        value = int(text, 10)
    except ValueError:
        return False
    # Go's strconv.Atoi uses the compiler binary's int width. The wrapper may
    # run under a different architecture (for example under translation), so
    # admit only values valid on both 32-bit and 64-bit hosts; larger explicit
    # values safely fall back to Core instead of guessing.
    return -(1 << 31) <= value <= (1 << 31) - 1


def default_linker_command_is_cacheable():
    """Accept only a native linker from the platform's system tool directory."""
    selected = shutil.which("ld")
    if selected is None:
        return False
    resolved = os.path.realpath(selected)
    if sys.platform == "darwin":
        if resolved != "/usr/bin/ld":
            return False
    elif sys.platform.startswith("linux"):
        if not any(resolved == root or resolved.startswith(root + os.sep)
                   for root in ("/usr/bin", "/bin")):
            return False
    else:
        return False
    name = os.path.basename(selected).lower()
    if name != "ld":
        return False
    return is_native_tool_image(selected)


def main():
    real = os.environ.get("ELISA_S0_REAL")
    if not real or not os.access(real, os.X_OK):
        sys.stderr.write("s0cache: ELISA_S0_REAL must point at the real stage0 binary\n")
        sys.exit(2)
    argv = sys.argv[1:]
    if os.environ.get("ELISA_S0_CACHE", "1") == "0":
        passthrough(real, argv)
    mode, output, inputs, keyed = None, None, [], []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "-emit" and i + 1 < len(argv):
            mode = argv[i + 1]; keyed += [a, mode]; i += 2; continue
        if a == "-o" and i + 1 < len(argv):
            output = argv[i + 1]; i += 2; continue
        if a.startswith("-o="):
            output = a[3:]; i += 1; continue
        if a in PASS_THROUGH_FLAGS or a.startswith("-l") and len(a) > 2 or a.startswith("-L") and len(a) > 2:
            passthrough(real, argv)
        if a.startswith("-"):
            keyed.append(a); i += 1; continue
        inputs.append(a); keyed.append("<input>"); i += 1
    if mode not in SAFE_MODES or len(inputs) != 1 or not inputs[0].endswith(".elisa") or inputs[0] == "-":
        passthrough(real, argv, mode, "mode" if len(inputs) == 1 else "inputs")
    if mode in {"c-bind-check", "c-bind-check-json"}:
        # These modes depend on the selected C compiler and host SDK/header tree,
        # neither of which is represented by the Elisa source closure.
        passthrough(real, argv, mode, "external-headers")
    if output == "":
        output = None
    if mode in BINARY_MODES and output is None:
        suffix = ".o" if mode == "obj" else ".bc"
        base = os.path.splitext(inputs[0])[0]
        output = (base or inputs[0]) + suffix
    if mode == "obj" and not explicit_codegen_jobs_setting():
        # Core's default worker count comes from runtime.NumCPU(). The outer
        # cache cannot safely infer that value on a shared cache root, so let
        # Core resolve it and use its own count-aware object-cache identity.
        passthrough(real, argv, mode, "implicit-codegen-jobs")
    if mode == "obj" and os.environ.get("ELISA_LD", "").split():
        # Explicit command strings may launch wrappers or consume untracked
        # scripts, plugins, and response files. The certificate only identifies
        # the first executable, so keep overrides out of the outer object cache.
        passthrough(real, argv, mode, "elisa-ld-override")
    if mode == "obj" and not default_linker_command_is_cacheable():
        # A script launcher selected as the default ld can delegate to a linker
        # that the certificate does not identify. Let Core handle it.
        passthrough(real, argv, mode, "linker-wrapper")
    for name in BYPASS_ENV:
        if os.environ.get(name):
            passthrough(real, argv, mode, "env:" + name)
    for name in BYPASS_PRESENT_ENV:
        if name in os.environ:
            # Presence, including an empty value, changes retained-server routing.
            # A cache hit would skip the local/daemon request and its state effects.
            passthrough(real, argv, mode, "env-present:" + name)
    if os.environ.get("ELISACORE_RETAINED_FAST_PREPARE") == "shadow":
        # Shadow mode performs a comparison whose diagnostics are not cache artifacts.
        passthrough(real, argv, mode, "env:ELISACORE_RETAINED_FAST_PREPARE=shadow")
    closure = include_closure(inputs[0])
    if closure is None:
        passthrough(real, argv, mode, "include")
    inpath = os.path.abspath(inputs[0])
    base, repo = os.path.dirname(inpath), repo_root()
    h = hashlib.sha256()
    # Answers can contain absolute paths from the caller's checkout (not just the input
    # path). Keep the cache local to the repository root so a result produced in the main
    # compiler worktree cannot be replayed in a sibling worktree with different std paths.
    # The old path-independent key silently served those answers and corrupted byte-parity
    # checks such as deps/iface/fmt.
    # Older entries were written without a certificate for transient SMT failures.
    h.update(b"s0cache-v9-certified-dependencies\0")
    h.update(repo.encode() + b"\0")
    try:
        compiler_hash = binary_hash(real)
    except OSError:
        # A broken or read-only cache root must not stop the real oracle from
        # answering the request.
        passthrough(real, argv, mode, "cache-root")
    h.update(compiler_hash.encode() + b"\0")
    h.update(("\0".join(keyed) + ("\0-o" if output is not None else "")).encode() + b"\0\0")
    if mode in BINARY_MODES:
        # Binary artifacts keep their original bytes. Include exact source paths
        # in their key so debug paths never need a length-changing placeholder.
        h.update(b"binary-path\0" + inpath.encode() + b"\0" + base.encode() + b"\0")
    elif any(inpath.encode() in data or base.encode() in data for _, data, _ in closure):
        # User text that literally names its source directory must not be
        # normalized as if it were a compiler-generated diagnostic path.
        h.update(b"text-literal-path\0" + inpath.encode() + b"\0" + base.encode() + b"\0")
    for name in KEYED_ENV:
        if name in os.environ:
            h.update(name.encode() + b"=" + os.environ[name].encode() + b"\0")
    h.update(b"\0closure\0")
    for path, data, _ in closure:
        h.update(key_name(path, base, repo).encode() + b"\0" + str(len(data)).encode() + b"\0")
        h.update(data)
    key = h.hexdigest()
    entry = os.path.join(cache_root(), key[:2], key[2:])
    rc_file = os.path.join(entry, "rc")
    if cache_entry_paths_are_regular(entry) and os.path.isfile(rc_file):
        try:
            certificate_data = read_cache_file_bounded(os.path.join(entry, "certificate"), 16384)
            if not valid_certificate(certificate_data):
                raise ValueError("solver certificate is missing or stale")
            rc = int(read_cache_file_bounded(rc_file, CACHE_RC_MAX_BYTES).decode("ascii").strip())
            if rc not in (0, 1):
                raise ValueError("invalid cached exit status")
            # A failed `-o` invocation may leave an older artifact in place.
            # Since the output path is intentionally excluded from the key, a
            # rejection with an output target cannot safely replay file state.
            if output is not None and rc != 0:
                raise ValueError("uncacheable output-mode rejection")
            out = unmask(read_cache_file_bounded(
                os.path.join(entry, "out"), CACHE_TEXT_MAX_BYTES), inpath, base)
            err = unmask(read_cache_file_bounded(
                os.path.join(entry, "err"), CACHE_TEXT_MAX_BYTES), inpath, base)
            if len(out) > CACHE_TEXT_MAX_BYTES or len(err) > CACHE_TEXT_MAX_BYTES:
                raise ValueError("expanded cache output exceeds size limit")
            art, art_path = None, os.path.join(entry, "obj")
            if output is not None:
                if not os.path.isfile(art_path):
                    raise ValueError("cached output-mode entry has no artifact")
                art = read_cache_file_bounded(art_path, CACHE_OBJECT_MAX_BYTES)
                if mode not in BINARY_MODES:
                    art = unmask(art, inpath, base)
                    if len(art) > CACHE_OBJECT_MAX_BYTES:
                        raise ValueError("expanded cache artifact exceeds size limit")
            if not include_closure_unchanged(closure):
                raise ValueError("source/include changed during cache lookup")
            if art is not None:
                with open(output, "wb") as f:
                    f.write(art)
            sys.stdout.buffer.write(out)
            sys.stderr.buffer.write(err)
            sys.stdout.flush(); sys.stderr.flush()
            stat_line("hit", mode)
            sys.exit(rc)
        except (OSError, ValueError):
            pass  # a torn entry, or an unpatchable artifact: fall through and recompute
    output_tracking = output is not None
    output_before = None
    if output_tracking:
        try:
            output_before = regular_file_identity(output)
        except OSError:
            output_tracking = False
    certified = False
    certificate_data = b""
    try:
        cert_context = tempfile.TemporaryDirectory(prefix="elisa-s0-cert-")
    except OSError:
        cert_context = None
    if cert_context is not None:
        with cert_context as cert_dir:
            certificate = os.path.join(cert_dir, "certificate")
            child_env = os.environ.copy()
            child_env["ELISACORE_CACHE_CERTIFICATE"] = certificate
            proc = run_spooled(real, argv, child_env)
            try:
                try:
                    certificate_data = read_cache_file_bounded(certificate, 16384)
                    certified = valid_certificate(certificate_data, proc.pid)
                except (OSError, ValueError):
                    pass
            finally:
                replay_spooled_output(proc)
    else:
        # If the private certificate directory cannot be created, execute the
        # compiler normally but do not publish its result. Spool capture keeps
        # memory bounded while retaining the usual post-exit output replay.
        child_env = os.environ.copy()
        child_env.pop("ELISACORE_CACHE_CERTIFICATE", None)
        proc = run_spooled(real, argv, child_env)
        replay_spooled_output(proc)
    stat_line("miss", mode, proc.output_capture_reason or "-")
    have_art = False
    output_after = None
    produced_artifact = None
    if output_tracking:
        try:
            output_after = regular_file_identity(output)
            have_art = output_after is not None and (output_before is None or output_after != output_before)
            if have_art:
                if os.path.getsize(output) >= CACHE_OBJECT_MAX_BYTES:
                    have_art = False
                else:
                    with open(output, "rb") as artifact_file:
                        produced_artifact = artifact_file.read(CACHE_OBJECT_MAX_BYTES + 1)
                    have_art = (len(produced_artifact) < CACHE_OBJECT_MAX_BYTES
                                and regular_file_identity(output) == output_after)
                    if not have_art:
                        produced_artifact = None
        except OSError:
            have_art = False
            produced_artifact = None
    has_placeholder_marker = lambda data: IN_MARK in data or DIR_MARK in data
    capture_complete = (proc.output_capture_complete
                        and proc.stdout_data is not None and proc.stderr_data is not None)
    placeholder_safe = (capture_complete
                        and not has_placeholder_marker(proc.stdout_data)
                        and not has_placeholder_marker(proc.stderr_data))
    if have_art and mode not in BINARY_MODES and has_placeholder_marker(produced_artifact):
        placeholder_safe = False
    cacheable_return = (output is None and proc.returncode in (0, 1)
                        or output is not None and proc.returncode == 0 and have_art) and placeholder_safe
    # Incomplete analysis checkpoints carry resumable work. Core currently uses
    # a dedicated non-cacheable exit status, but keep the marker check defensive
    # in case a wrapper or future status change makes the response look cacheable.
    resumable_analysis = (capture_complete
                          and (RESUMABLE_ANALYSIS_MARKER in proc.stdout_data
                               or RESUMABLE_ANALYSIS_MARKER in proc.stderr_data))
    cacheable_return = (cacheable_return and capture_complete and not resumable_analysis
                        and certified and include_closure_unchanged(closure))
    cacheable_return = (cacheable_return
                        and len(proc.stdout_data) <= CACHE_TEXT_MAX_BYTES
                        and len(proc.stderr_data) <= CACHE_TEXT_MAX_BYTES)
    cached_out = cached_err = cached_art = None
    if cacheable_return:
        cached_out = mask(proc.stdout_data, inpath, base)
        cached_err = mask(proc.stderr_data, inpath, base)
        if have_art:
            cached_art = (produced_artifact if mode in BINARY_MODES
                          else mask(produced_artifact, inpath, base))
        cacheable_return = (len(cached_out) <= CACHE_TEXT_MAX_BYTES
                            and len(cached_err) <= CACHE_TEXT_MAX_BYTES
                            and (cached_art is None or len(cached_art) < CACHE_OBJECT_MAX_BYTES))
    if cacheable_return:
        tmp = None
        try:
            shard = os.path.dirname(entry)
            if os.path.islink(shard) or os.path.islink(entry):
                raise OSError("symlinked cache shard or entry")
            os.makedirs(shard, exist_ok=True)
            if os.path.islink(shard) or os.path.islink(entry):
                raise OSError("symlinked cache shard or entry")
            tmp = tempfile.mkdtemp(prefix="w.", dir=shard)
            with open(os.path.join(tmp, "out"), "wb") as f:
                f.write(cached_out)
            with open(os.path.join(tmp, "err"), "wb") as f:
                f.write(cached_err)
            with open(os.path.join(tmp, "certificate"), "wb") as f:
                f.write(certificate_data)
            with open(os.path.join(tmp, "path"), "wb") as f:
                f.write(inpath.encode() + b"\n" + base.encode())
            if have_art:
                with open(os.path.join(tmp, "obj"), "wb") as f:
                    f.write(cached_art)
            with open(os.path.join(tmp, "rc"), "w") as f:
                f.write(str(proc.returncode))
            try:
                if not include_closure_unchanged(closure):
                    raise OSError("source/include changed before cache publication")
                os.rename(tmp, entry)
                tmp = None
            except OSError:
                pass  # a concurrent writer won
        except OSError:
            pass
        finally:
            if tmp is not None:
                shutil.rmtree(tmp, ignore_errors=True)
    sys.exit(proc.returncode)


if __name__ == "__main__":
    main()
