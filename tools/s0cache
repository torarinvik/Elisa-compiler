def stat_line(kind, mode="-", why="-"):
    p = os.environ.get("ELISA_S0_CACHE_STATS")
    if p:
        try:
            with open(p, "a") as f:
                f.write("%s\t%s\t%s\n" % (kind, mode or "-", why))
        except OSError:
            pass


def passthrough(real, argv, mode="-", why="-"):
    stat_line("bypass", mode, why)
    os.execv(real, [real] + argv)


def repo_root():
    return os.path.abspath(os.environ.get("REPO_ROOT")
                           or os.path.dirname(os.path.dirname(os.path.abspath(__file__))))


def key_name(path, base, repo):
    """A path as it enters the KEY: relative to the input's dir, else to the repo, else itself."""
    for prefix, tag in ((base, "@in/"), (repo, "@root/")):
        if prefix and len(prefix) > 1 and (path == prefix or path.startswith(prefix + os.sep)):
            return tag + os.path.relpath(path, prefix)
    return path


def mask(data, inpath, base):
    """Replace the caller's source path with placeholders (store); see unmask (serve)."""
    if len(inpath) > 8:
        data = data.replace(inpath.encode(), IN_MARK)
    if len(base) > 8:
        data = data.replace(base.encode(), DIR_MARK)
    return data


def unmask(data, inpath, base):
    return data.replace(IN_MARK, inpath.encode()).replace(DIR_MARK, base.encode())


def cache_entry_paths_are_regular(entry):
    root = os.path.dirname(os.path.dirname(entry))
    shard = os.path.dirname(entry)
    files = [os.path.join(entry, name) for name in ("rc", "out", "err", "path", "obj", "certificate")]
    for path in (root, shard, entry):
        try:
            mode = os.lstat(path).st_mode
        except FileNotFoundError:
            continue
        except OSError:
            return False
        if not stat.S_ISDIR(mode):
            return False
    for path in files:
        try:
            mode = os.lstat(path).st_mode
        except FileNotFoundError:
            continue
        except OSError:
            return False
        if not stat.S_ISREG(mode):
            return False
    return True


def explicit_codegen_jobs_setting():
    """Whether Core will use the keyed worker setting instead of its host default."""
    text = os.environ.get("ELISACORE_CODEGEN_JOBS", "").strip()
    if not text:
        return False
    digits = text[1:] if text[:1] in ("+", "-") else text
    if not digits or any(char < "0" or char > "9" for char in digits):
        return False
    try:
        value = int(text, 10)
    except ValueError:
        return False
    # Go's strconv.Atoi uses the compiler binary's int width. The wrapper may
    # run under a different architecture (for example under translation), so
    # admit only values valid on both 32-bit and 64-bit hosts; larger explicit
    # values safely fall back to Core instead of guessing.
    return -(1 << 31) <= value <= (1 << 31) - 1


def default_linker_command_is_cacheable():
    """Accept only a native linker from the platform's system tool directory."""
    selected = shutil.which("ld")
    if selected is None:
        return False
    resolved = os.path.realpath(selected)
    if sys.platform == "darwin":
        if resolved != "/usr/bin/ld":
            return False
    elif sys.platform.startswith("linux"):
        if not any(resolved == root or resolved.startswith(root + os.sep)
                   for root in ("/usr/bin", "/bin")):
            return False
    else:
        return False
    name = os.path.basename(selected).lower()
    if name != "ld":
        return False
    return is_native_tool_image(selected)


def main():
    real = os.environ.get("ELISA_S0_REAL")
    if not real or not os.access(real, os.X_OK):
        sys.stderr.write("s0cache: ELISA_S0_REAL must point at the real stage0 binary\n")
        sys.exit(2)
    argv = sys.argv[1:]
    if os.environ.get("ELISA_S0_CACHE", "1") == "0":
        passthrough(real, argv)
    mode, output, inputs, keyed = None, None, [], []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "-emit" and i + 1 < len(argv):
            mode = argv[i + 1]; keyed += [a, mode]; i += 2; continue
        if a == "-o" and i + 1 < len(argv):
            output = argv[i + 1]; i += 2; continue
        if a.startswith("-o="):
            output = a[3:]; i += 1; continue
        if a in PASS_THROUGH_FLAGS or a.startswith("-l") and len(a) > 2 or a.startswith("-L") and len(a) > 2:
            passthrough(real, argv)
        if a.startswith("-"):
            keyed.append(a); i += 1; continue
        inputs.append(a); keyed.append("<input>"); i += 1
    if mode not in SAFE_MODES or len(inputs) != 1 or not inputs[0].endswith(".elisa") or inputs[0] == "-":
        passthrough(real, argv, mode, "mode" if len(inputs) == 1 else "inputs")
    if mode in {"c-bind-check", "c-bind-check-json"}:
        # These modes depend on the selected C compiler and host SDK/header tree,
        # neither of which is represented by the Elisa source closure.
        passthrough(real, argv, mode, "external-headers")
    if output == "":
        output = None
    if mode in BINARY_MODES and output is None:
        suffix = ".o" if mode == "obj" else ".bc"
        base = os.path.splitext(inputs[0])[0]
        output = (base or inputs[0]) + suffix
    if mode == "obj" and not explicit_codegen_jobs_setting():
        # Core's default worker count comes from runtime.NumCPU(). The outer
        # cache cannot safely infer that value on a shared cache root, so let
        # Core resolve it and use its own count-aware object-cache identity.
        passthrough(real, argv, mode, "implicit-codegen-jobs")
    if mode == "obj" and os.environ.get("ELISA_LD", "").split():
        # Explicit command strings may launch wrappers or consume untracked
        # scripts, plugins, and response files. The certificate only identifies
        # the first executable, so keep overrides out of the outer object cache.
        passthrough(real, argv, mode, "elisa-ld-override")
    if mode == "obj" and not default_linker_command_is_cacheable():
        # A script launcher selected as the default ld can delegate to a linker
        # that the certificate does not identify. Let Core handle it.
        passthrough(real, argv, mode, "linker-wrapper")
    for name in BYPASS_ENV:
        if os.environ.get(name):
            passthrough(real, argv, mode, "env:" + name)
    for name in BYPASS_PRESENT_ENV:
        if name in os.environ:
            # Presence, including an empty value, changes retained-server routing.
            # A cache hit would skip the local/daemon request and its state effects.
            passthrough(real, argv, mode, "env-present:" + name)
    if os.environ.get("ELISACORE_RETAINED_FAST_PREPARE") == "shadow":
        # Shadow mode performs a comparison whose diagnostics are not cache artifacts.
        passthrough(real, argv, mode, "env:ELISACORE_RETAINED_FAST_PREPARE=shadow")
    closure = include_closure(inputs[0])
    if closure is None:
        passthrough(real, argv, mode, "include")
    inpath = os.path.abspath(inputs[0])
    base, repo = os.path.dirname(inpath), repo_root()
    h = hashlib.sha256()
    # Answers can contain absolute paths from the caller's checkout (not just the input
    # path). Keep the cache local to the repository root so a result produced in the main
    # compiler worktree cannot be replayed in a sibling worktree with different std paths.
    # The old path-independent key silently served those answers and corrupted byte-parity
    # checks such as deps/iface/fmt.
    # Older entries were written without a certificate for transient SMT failures.
    h.update(b"s0cache-v9-certified-dependencies\0")
    h.update(repo.encode() + b"\0")
    try:
        compiler_hash = binary_hash(real)
    except OSError:
        # A broken or read-only cache root must not stop the real oracle from
        # answering the request.
        passthrough(real, argv, mode, "cache-root")
    h.update(compiler_hash.encode() + b"\0")
    h.update(("\0".join(keyed) + ("\0-o" if output is not None else "")).encode() + b"\0\0")
    if mode in BINARY_MODES:
        # Binary artifacts keep their original bytes. Include exact source paths
        # in their key so debug paths never need a length-changing placeholder.
        h.update(b"binary-path\0" + inpath.encode() + b"\0" + base.encode() + b"\0")
    elif any(inpath.encode() in data or base.encode() in data for _, data, _ in closure):
        # User text that literally names its source directory must not be
        # normalized as if it were a compiler-generated diagnostic path.
        h.update(b"text-literal-path\0" + inpath.encode() + b"\0" + base.encode() + b"\0")
    for name in KEYED_ENV:
        if name in os.environ:
            h.update(name.encode() + b"=" + os.environ[name].encode() + b"\0")
    h.update(b"\0closure\0")
    for path, data, _ in closure:
        h.update(key_name(path, base, repo).encode() + b"\0" + str(len(data)).encode() + b"\0")
        h.update(data)
    key = h.hexdigest()
    entry = os.path.join(cache_root(), key[:2], key[2:])
    rc_file = os.path.join(entry, "rc")
    if cache_entry_paths_are_regular(entry) and os.path.isfile(rc_file):
        try:
            certificate_data = read_cache_file_bounded(os.path.join(entry, "certificate"), 16384)
            if not valid_certificate(certificate_data):
                raise ValueError("solver certificate is missing or stale")
            rc = int(read_cache_file_bounded(rc_file, CACHE_RC_MAX_BYTES).decode("ascii").strip())
            if rc not in (0, 1):
                raise ValueError("invalid cached exit status")
            # A failed `-o` invocation may leave an older artifact in place.
            # Since the output path is intentionally excluded from the key, a
            # rejection with an output target cannot safely replay file state.
            if output is not None and rc != 0:
                raise ValueError("uncacheable output-mode rejection")
            out = unmask(read_cache_file_bounded(
                os.path.join(entry, "out"), CACHE_TEXT_MAX_BYTES), inpath, base)
            err = unmask(read_cache_file_bounded(
                os.path.join(entry, "err"), CACHE_TEXT_MAX_BYTES), inpath, base)
            if len(out) > CACHE_TEXT_MAX_BYTES or len(err) > CACHE_TEXT_MAX_BYTES:
                raise ValueError("expanded cache output exceeds size limit")
            art, art_path = None, os.path.join(entry, "obj")
            if output is not None:
                if not os.path.isfile(art_path):
                    raise ValueError("cached output-mode entry has no artifact")
                art = read_cache_file_bounded(art_path, CACHE_OBJECT_MAX_BYTES)
                if mode not in BINARY_MODES:
                    art = unmask(art, inpath, base)
                    if len(art) > CACHE_OBJECT_MAX_BYTES:
                        raise ValueError("expanded cache artifact exceeds size limit")
            if not include_closure_unchanged(closure):
                raise ValueError("source/include changed during cache lookup")
            if art is not None:
                with open(output, "wb") as f:
                    f.write(art)
            sys.stdout.buffer.write(out)
            sys.stderr.buffer.write(err)
            sys.stdout.flush(); sys.stderr.flush()
            stat_line("hit", mode)
            sys.exit(rc)
        except (OSError, ValueError):
            pass  # a torn entry, or an unpatchable artifact: fall through and recompute
    output_tracking = output is not None
    output_before = None
    if output_tracking:
        try:
            output_before = regular_file_identity(output)
        except OSError:
            output_tracking = False
    certified = False
    certificate_data = b""
    try:
        cert_context = tempfile.TemporaryDirectory(prefix="elisa-s0-cert-")
    except OSError:
        cert_context = None
    if cert_context is not None:
        with cert_context as cert_dir:
            certificate = os.path.join(cert_dir, "certificate")
            child_env = os.environ.copy()
            child_env["ELISACORE_CACHE_CERTIFICATE"] = certificate
            proc = run_spooled(real, argv, child_env)
            try:
                try:
                    certificate_data = read_cache_file_bounded(certificate, 16384)
                    certified = valid_certificate(certificate_data, proc.pid)
                except (OSError, ValueError):
                    pass
            finally:
                replay_spooled_output(proc)
    else:
        # If the private certificate directory cannot be created, execute the
        # compiler normally but do not publish its result. Spool capture keeps
        # memory bounded while retaining the usual post-exit output replay.
        child_env = os.environ.copy()
        child_env.pop("ELISACORE_CACHE_CERTIFICATE", None)
        proc = run_spooled(real, argv, child_env)
        replay_spooled_output(proc)
    stat_line("miss", mode, proc.output_capture_reason or "-")
    have_art = False
    output_after = None
    produced_artifact = None
    if output_tracking:
        try:
            output_after = regular_file_identity(output)
            have_art = output_after is not None and (output_before is None or output_after != output_before)
            if have_art:
                if os.path.getsize(output) >= CACHE_OBJECT_MAX_BYTES:
                    have_art = False
                else:
                    with open(output, "rb") as artifact_file:
                        produced_artifact = artifact_file.read(CACHE_OBJECT_MAX_BYTES + 1)
                    have_art = (len(produced_artifact) < CACHE_OBJECT_MAX_BYTES
                                and regular_file_identity(output) == output_after)
                    if not have_art:
                        produced_artifact = None
        except OSError:
            have_art = False
            produced_artifact = None
    has_placeholder_marker = lambda data: IN_MARK in data or DIR_MARK in data
    capture_complete = (proc.output_capture_complete
                        and proc.stdout_data is not None and proc.stderr_data is not None)
    placeholder_safe = (capture_complete
                        and not has_placeholder_marker(proc.stdout_data)
                        and not has_placeholder_marker(proc.stderr_data))
    if have_art and mode not in BINARY_MODES and has_placeholder_marker(produced_artifact):
        placeholder_safe = False
    cacheable_return = (output is None and proc.returncode in (0, 1)
                        or output is not None and proc.returncode == 0 and have_art) and placeholder_safe
    # Incomplete analysis checkpoints carry resumable work. Core currently uses
    # a dedicated non-cacheable exit status, but keep the marker check defensive
    # in case a wrapper or future status change makes the response look cacheable.
    resumable_analysis = (capture_complete
                          and (RESUMABLE_ANALYSIS_MARKER in proc.stdout_data
                               or RESUMABLE_ANALYSIS_MARKER in proc.stderr_data))
    cacheable_return = (cacheable_return and capture_complete and not resumable_analysis
                        and certified and include_closure_unchanged(closure))
    cacheable_return = (cacheable_return
                        and len(proc.stdout_data) <= CACHE_TEXT_MAX_BYTES
                        and len(proc.stderr_data) <= CACHE_TEXT_MAX_BYTES)
    cached_out = cached_err = cached_art = None
    if cacheable_return:
        cached_out = mask(proc.stdout_data, inpath, base)
        cached_err = mask(proc.stderr_data, inpath, base)
        if have_art:
            cached_art = (produced_artifact if mode in BINARY_MODES
                          else mask(produced_artifact, inpath, base))
        cacheable_return = (len(cached_out) <= CACHE_TEXT_MAX_BYTES
                            and len(cached_err) <= CACHE_TEXT_MAX_BYTES
                            and (cached_art is None or len(cached_art) < CACHE_OBJECT_MAX_BYTES))
    if cacheable_return:
        tmp = None
        try:
            shard = os.path.dirname(entry)
            if os.path.islink(shard) or os.path.islink(entry):
                raise OSError("symlinked cache shard or entry")
            os.makedirs(shard, exist_ok=True)
            if os.path.islink(shard) or os.path.islink(entry):
                raise OSError("symlinked cache shard or entry")
            tmp = tempfile.mkdtemp(prefix="w.", dir=shard)
            with open(os.path.join(tmp, "out"), "wb") as f:
                f.write(cached_out)
            with open(os.path.join(tmp, "err"), "wb") as f:
                f.write(cached_err)
            with open(os.path.join(tmp, "certificate"), "wb") as f:
                f.write(certificate_data)
            with open(os.path.join(tmp, "path"), "wb") as f:
                f.write(inpath.encode() + b"\n" + base.encode())
            if have_art:
                with open(os.path.join(tmp, "obj"), "wb") as f:
                    f.write(cached_art)
            with open(os.path.join(tmp, "rc"), "w") as f:
                f.write(str(proc.returncode))
            try:
                if not include_closure_unchanged(closure):
                    raise OSError("source/include changed before cache publication")
                os.rename(tmp, entry)
                tmp = None
            except OSError:
                pass  # a concurrent writer won
        except OSError:
            pass
        finally:
            if tmp is not None:
                shutil.rmtree(tmp, ignore_errors=True)
    sys.exit(proc.returncode)


if __name__ == "__main__":
    main()
