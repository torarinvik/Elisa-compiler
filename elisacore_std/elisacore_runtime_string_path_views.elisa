# Path-component views are defined through the shared last-byte search contract.
def sview_basename(view: sview, sep: u8) -> sview:
    ensure (
        ((view.len < 0 or view.len.usize().i64() != view.len) implies result.len == 0)
        and ((view.len >= 0 and view.len.usize().i64() == view.len and sview_find_last_byte(view, sep) >= 0) implies result.len == view.len - (sview_find_last_byte(view, sep) + 1))
        and ((view.len >= 0 and view.len.usize().i64() == view.len and sview_find_last_byte(view, sep) == -1) implies result.len == view.len)
    )
    ensure (view.len >= 0 and view.len.usize().i64() == view.len and sview_find_last_byte(view, sep) >= 0 and result.len > 0) implies result.data == view.data + (sview_find_last_byte(view, sep) + 1).usize()
    ensure (view.len >= 0 and view.len.usize().i64() == view.len and sview_find_last_byte(view, sep) == -1 and result.len > 0) implies result.data == view.data
    ensure (view.len >= 0 and view.len.usize().i64() == view.len and sview_find_last_byte(view, sep) >= 0) implies (forall offset in 0..<result.len: string_view_index(result, offset) == string_view_index(view, sview_find_last_byte(view, sep) + 1 + offset))
    ensure (view.len >= 0 and view.len.usize().i64() == view.len and sview_find_last_byte(view, sep) == -1) implies (forall offset in 0..<result.len: string_view_index(result, offset) == string_view_index(view, offset))
    can Unsafe{PointerArithmetic,RawExtern,UncheckedIndex}:
        return sview("", 0, 0) if view.len < 0 or view.len.usize().i64() != view.len
        last: i64 = sview_find_last_byte(view, sep)
        if last >= 0:
            base: sview = string_view_slice(view, last + 1, view.len)
            assert last == sview_find_last_byte(view, sep)
            assert base.len == view.len - (last + 1)
            assert base.len == view.len - (sview_find_last_byte(view, sep) + 1)
            assert base.len == 0 or base.data == view.data + (last + 1).usize()
            assert base.len == 0 or base.data == view.data + (sview_find_last_byte(view, sep) + 1).usize()
            assert forall offset in 0..<base.len: string_view_index(base, offset) == string_view_index(view, last + 1 + offset)
            assert forall offset in 0..<base.len: string_view_index(base, offset) == string_view_index(view, sview_find_last_byte(view, sep) + 1 + offset)
            return base
        assert last == sview_find_last_byte(view, sep)
        assert last == -1
        return view

def sview_dirname(view: sview, sep: u8) -> sview:
    ensure (
        ((view.len < 0 or view.len.usize().i64() != view.len) implies result.len == 0)
        and ((view.len >= 0 and view.len.usize().i64() == view.len and sview_find_last_byte(view, sep) >= 0) implies result.len == sview_find_last_byte(view, sep))
        and ((view.len >= 0 and view.len.usize().i64() == view.len and sview_find_last_byte(view, sep) == -1) implies result.len == 0)
    )
    ensure (view.len >= 0 and view.len.usize().i64() == view.len and sview_find_last_byte(view, sep) >= 0 and result.len > 0) implies result.data == view.data
    ensure (view.len >= 0 and view.len.usize().i64() == view.len) implies (forall offset in 0..<result.len: string_view_index(result, offset) == string_view_index(view, offset))
    can Unsafe{PointerArithmetic,RawExtern,UncheckedIndex}:
        return sview("", 0, 0) if view.len < 0 or view.len.usize().i64() != view.len
        last: i64 = sview_find_last_byte(view, sep)
        if last >= 0:
            parent: sview = string_view_prefix(view, last)
            assert last == sview_find_last_byte(view, sep)
            assert parent.len == last
            assert parent.len == sview_find_last_byte(view, sep)
            assert parent.len == 0 or parent.data == view.data
            assert forall offset in 0..<parent.len: string_view_index(parent, offset) == string_view_index(view, offset)
            return parent
        assert last == sview_find_last_byte(view, sep)
        assert last == -1
        return string_view_prefix(view, 0)
