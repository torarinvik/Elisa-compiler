# Shared FNV-1a model used to specify the implementation below.
include "./elisacore_fnv1a_spec.elisa"

# Hash every byte in order, returning the offset basis for an invalid extent.
def hash_sview(value: sview) -> u64:
    ensure result == sview_fnv1a_model(value)
    ensure (value.len <= 0 or value.len.usize().i64() != value.len) implies result == SVIEW_FNV1A_OFFSET_BASIS
    h: mutable u64 = SVIEW_FNV1A_OFFSET_BASIS
    return h if value.len <= 0
    view_len: usize = value.len.usize()
    return h if view_len.i64() != value.len
    i: mutable usize = 0
    while i < view_len:
        decreases view_len - i
        invariant i <= view_len
        invariant i.i64().usize() == i
        invariant view_len == sview_len(value)
        invariant sview_fnv1a_fold_from(value, i, h) == sview_fnv1a_fold_from(value, 0.usize(), SVIEW_FNV1A_OFFSET_BASIS)
        ch: u8 = value[i].u8()
        h <- h ^ ch.u64()
        h <- h * SVIEW_FNV1A_PRIME
        i <- i + 1.usize()
    return h
