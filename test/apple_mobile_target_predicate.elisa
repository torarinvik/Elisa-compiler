# The backend's Darwin compatibility family includes explicit mobile triples.
# Compile with arm64-apple-ios17.0 and arm64-apple-ios17.0-simulator; the
# exported object must use the POSIX path, matching native_runtime_support.
def apple_mobile_posix_probe() -> i32:
    static if ELISA_TARGET_OS_POSIX:
        return 1
    static else:
        return 0

export fn elisa_apple_mobile_posix_probe() -> i32 = apple_mobile_posix_probe
