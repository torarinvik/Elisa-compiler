include "../../src/semantic/index_type_application_policy.elisa"

def field_operator_name_set_is_exact(field_name: sview) -> bool:
    ensure result == true
    return SemanticIndexTypeApplicationPolicy::field_name_is_type_argument(field_name) == (
        field_name == "cast" or field_name == "ref" or
        field_name == "specialize" or field_name == "call_as"
    )

def all_four_type_argument_operators_are_recognized() -> bool:
    ensure result == true
    return SemanticIndexTypeApplicationPolicy::field_name_is_type_argument("cast") and
        SemanticIndexTypeApplicationPolicy::field_name_is_type_argument("ref") and
        SemanticIndexTypeApplicationPolicy::field_name_is_type_argument("specialize") and
        SemanticIndexTypeApplicationPolicy::field_name_is_type_argument("call_as")

def ordinary_value_index_fields_are_not_type_argument_operators() -> bool:
    ensure result == true
    return not SemanticIndexTypeApplicationPolicy::field_name_is_type_argument("index") and
        not SemanticIndexTypeApplicationPolicy::field_name_is_type_argument("length") and
        not SemanticIndexTypeApplicationPolicy::field_name_is_type_argument("items")

def candidate_declaration_classifier_is_exact(name_matches: bool, is_function: bool, is_struct: bool, is_enum: bool, is_alias: bool) -> bool:
    ensure result == true
    return SemanticIndexTypeApplicationPolicy::candidate_declaration_matches(name_matches, is_function, is_struct, is_enum, is_alias) ==
        (name_matches and (is_function or is_struct or is_enum or is_alias))

def each_supported_declaration_kind_can_supply_type_arguments() -> bool:
    ensure result == true
    return SemanticIndexTypeApplicationPolicy::candidate_declaration_matches(true, true, false, false, false) and
        SemanticIndexTypeApplicationPolicy::candidate_declaration_matches(true, false, true, false, false) and
        SemanticIndexTypeApplicationPolicy::candidate_declaration_matches(true, false, false, true, false) and
        SemanticIndexTypeApplicationPolicy::candidate_declaration_matches(true, false, false, false, true)

def wrong_name_and_ineligible_declaration_kinds_are_rejected() -> bool:
    ensure result == true
    return not SemanticIndexTypeApplicationPolicy::candidate_declaration_matches(false, true, false, false, false) and
        not SemanticIndexTypeApplicationPolicy::candidate_declaration_matches(true, false, false, false, false)
