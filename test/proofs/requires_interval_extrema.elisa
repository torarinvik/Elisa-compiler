# Arithmetic proof models for the interval analyzer's endpoint meet and join.
# The checker pins these exact branch expressions to the production helpers.
def proof_rc_max(a: i64, b: i64) -> i64:
    ensure result >= a and result >= b
    ensure result == a or result == b
    return a if a > b else b

def proof_rc_min(a: i64, b: i64) -> i64:
    ensure result <= a and result <= b
    ensure result == a or result == b
    return a if a < b else b

def rc_min_is_lower_bound(a: i64, b: i64) -> bool:
    ensure result == true
    return proof_rc_min(a, b) <= a and proof_rc_min(a, b) <= b

def rc_max_is_upper_bound(a: i64, b: i64) -> bool:
    ensure result == true
    return proof_rc_max(a, b) >= a and proof_rc_max(a, b) >= b

def rc_min_selects_an_operand(a: i64, b: i64) -> bool:
    ensure result == true
    return proof_rc_min(a, b) == a or proof_rc_min(a, b) == b

def rc_max_selects_an_operand(a: i64, b: i64) -> bool:
    ensure result == true
    return proof_rc_max(a, b) == a or proof_rc_max(a, b) == b

def rc_min_is_commutative(a: i64, b: i64) -> bool:
    ensure result == true
    return proof_rc_min(a, b) == proof_rc_min(b, a)

def rc_max_is_commutative(a: i64, b: i64) -> bool:
    ensure result == true
    return proof_rc_max(a, b) == proof_rc_max(b, a)

def rc_min_is_idempotent(a: i64) -> bool:
    ensure result == true
    return proof_rc_min(a, a) == a

def rc_max_is_idempotent(a: i64) -> bool:
    ensure result == true
    return proof_rc_max(a, a) == a

def rc_min_precedes_rc_max(a: i64, b: i64) -> bool:
    ensure result == true
    return proof_rc_min(a, b) <= proof_rc_max(a, b)

def rc_min_is_monotone_in_each_operand(a: i64, b: i64, c: i64) -> bool:
    requires a <= b
    ensure result == true
    return proof_rc_min(a, c) <= proof_rc_min(b, c)

def rc_max_is_monotone_in_each_operand(a: i64, b: i64, c: i64) -> bool:
    requires a <= b
    ensure result == true
    return proof_rc_max(a, c) <= proof_rc_max(b, c)
