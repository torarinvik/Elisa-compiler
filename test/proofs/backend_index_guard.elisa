# Boolean refinement of the backend bounds guard. The source checker binds
# index_nonnegative to LLVM SGE and unsigned_in_bounds to LLVM ULT, then checks
# that their conjunction dominates every checked read/write GEP.
def signed_index_guard(index_nonnegative: bool, unsigned_in_bounds: bool) -> bool:
    ensure result == (index_nonnegative and unsigned_in_bounds)
    return index_nonnegative and unsigned_in_bounds

def negative_signed_index_is_rejected(unsigned_in_bounds: bool) -> bool:
    ensure result == true
    return not signed_index_guard(false, unsigned_in_bounds)

def nonnegative_signed_index_keeps_the_count_check(unsigned_in_bounds: bool) -> bool:
    ensure result == true
    return signed_index_guard(true, unsigned_in_bounds) == unsigned_in_bounds

def unsigned_index_guard_is_exact(unsigned_in_bounds: bool) -> bool:
    ensure result == true
    return unsigned_in_bounds == unsigned_in_bounds

# Model the source-signedness choice made before conversion to the GEP index.
# A typed expression keeps its own signedness; an untyped negative literal must
# keep a signed representation even when the destination index type is unsigned.
def index_source_is_signed(actual_is_modeled: bool, actual_is_signed: bool, expected_is_signed: bool, negative_untyped_literal: bool) -> bool:
    ensure result == (actual_is_signed if actual_is_modeled else (negative_untyped_literal or expected_is_signed))
    return actual_is_signed if actual_is_modeled else (negative_untyped_literal or expected_is_signed)

def negative_untyped_literal_forces_signed_index(actual_is_signed: bool, expected_is_signed: bool) -> bool:
    requires not actual_is_signed
    requires not expected_is_signed
    ensure result == true
    return index_source_is_signed(false, actual_is_signed, expected_is_signed, true)

def untyped_nonnegative_literal_uses_expected_signedness(expected_is_signed: bool) -> bool:
    ensure result == true
    return index_source_is_signed(false, false, expected_is_signed, false) == expected_is_signed

def modeled_index_keeps_source_signedness(actual_is_signed: bool, expected_is_signed: bool, negative_untyped_literal: bool) -> bool:
    ensure result == true
    return index_source_is_signed(true, actual_is_signed, expected_is_signed, negative_untyped_literal) == actual_is_signed

def soa_row_membership_guard(index_nonnegative: bool, unsigned_in_bounds: bool) -> bool:
    ensure result == (index_nonnegative and unsigned_in_bounds)
    return index_nonnegative and unsigned_in_bounds

def negative_signed_row_id_is_not_valid(unsigned_in_bounds: bool) -> bool:
    ensure result == true
    return not soa_row_membership_guard(false, unsigned_in_bounds)
