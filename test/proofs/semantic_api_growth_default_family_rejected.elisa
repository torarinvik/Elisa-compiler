# Nearby false claims ensure the source-linked mapping cannot be weakened silently.
include "../../src/semantic/semantic_api_growth_default_family.elisa"

def add_is_not_a_dictionary_growth_method() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return SemanticApiGrowthDefaultFamily::growth_default_family("add") == "dict"

def unknown_methods_do_not_become_sets() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return SemanticApiGrowthDefaultFamily::growth_default_family("push") == "set"
