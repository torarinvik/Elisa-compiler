# False control: an older cached segment suppresses a field absent from the current segment.
include "./param_growth_summary_field_segment.elisa"

def pgs_older_segment_match_suppresses_current_field(found_in_older_segment: bool, found_in_current_segment: bool) -> bool:
    requires found_in_older_segment
    requires not found_in_current_segment
    ensure result == false
    return pgs_should_append_current_field(found_in_current_segment)
