# Source-linked transfer laws for blocks, matches, and catch expressions.

def block_handle_transfer_is_exact(explicit_value_present: bool,
    explicit_value_carries_handle: bool,
    body_is_empty: bool,
    last_statement_is_expression: bool,
    last_expression_carries_handle: bool) -> bool:
    ensure result == ((explicit_value_present and explicit_value_carries_handle) or
        (not explicit_value_present and
            (body_is_empty or not last_statement_is_expression or last_expression_carries_handle)))
    return ((explicit_value_present and explicit_value_carries_handle) or
        (not explicit_value_present and
            (body_is_empty or not last_statement_is_expression or last_expression_carries_handle)))

def explicit_block_value_overrides_body(explicit_value_carries_handle: bool,
    body_is_empty: bool,
    last_statement_is_expression: bool,
    last_expression_carries_handle: bool) -> bool:
    requires not explicit_value_carries_handle
    ensure result == false
    return block_handle_transfer_is_exact(true, explicit_value_carries_handle, body_is_empty,
        last_statement_is_expression, last_expression_carries_handle)

def implicit_empty_block_is_conservative() -> bool:
    ensure result == true
    return block_handle_transfer_is_exact(false, false, true, false, false)

def block_trailing_expression_preserves_handle_status(last_expression_carries_handle: bool) -> bool:
    ensure result == last_expression_carries_handle
    return block_handle_transfer_is_exact(false, false, false, true, last_expression_carries_handle)

def block_trailing_non_expression_is_conservative() -> bool:
    ensure result == true
    return block_handle_transfer_is_exact(false, false, false, false, false)

def match_handle_transfer_is_exact(any_arm_carries_handle: bool) -> bool:
    ensure result == any_arm_carries_handle
    return any_arm_carries_handle

def match_with_no_arms_carries_no_region_handle() -> bool:
    ensure result == false
    return match_handle_transfer_is_exact(false)

def catch_handle_transfer_is_exact(guarded_value_carries_handle: bool,
    any_handler_is_conservative_or_carries_handle: bool) -> bool:
    ensure result == (guarded_value_carries_handle or any_handler_is_conservative_or_carries_handle)
    return guarded_value_carries_handle or any_handler_is_conservative_or_carries_handle

def catch_without_handler_arms_preserves_guarded_value(guarded_value_carries_handle: bool) -> bool:
    ensure result == guarded_value_carries_handle
    return catch_handle_transfer_is_exact(guarded_value_carries_handle, false)

def conservative_catch_arm_can_carry_a_region_handle() -> bool:
    ensure result == true
    return catch_handle_transfer_is_exact(false, true)
