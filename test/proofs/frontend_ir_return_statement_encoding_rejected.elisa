include "./frontend_ir_return_statement_encoding.elisa"

def return_statement_tag_cannot_equal_the_proved_tag() -> bool:
    ensure result == true
    return FrontendIrReturnStatementEncoding::node_type_id() != EXPECTED_RETURN_STMT_NODE_TYPE_ID

def return_value_field_cannot_equal_the_proved_field() -> bool:
    ensure result == true
    return FrontendIrReturnStatementEncoding::field_id(
        FrontendIrReturnStatementEncoding::ReturnStatementField.Value
    ) != EXPECTED_RETURN_VALUE_FIELD_ID
