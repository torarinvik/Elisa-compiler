# Proof claims for the EASM control-flow opcode classes used by CFG traversals.
include "../../src/backend/easm_model.elisa"

def each_unconditional_transfer_is_a_terminator() -> bool:
    ensure result == true
    return Easm::easm_is_terminator("jmp")
        and Easm::easm_is_terminator("jmpq")
        and Easm::easm_is_terminator("ret")
        and Easm::easm_is_terminator("retq")

def conditional_branch_mnemonics_are_classified() -> bool:
    ensure result == true
    return Easm::easm_is_conditional_jump("je")
        and Easm::easm_is_conditional_jump("jne")
        and Easm::easm_is_conditional_jump("jz")
        and Easm::easm_is_conditional_jump("jnz")

def ordinary_instruction_is_neither_a_terminator_nor_a_conditional_jump() -> bool:
    ensure result == true
    return not Easm::easm_is_terminator("add")
        and not Easm::easm_is_conditional_jump("add")

def unconditional_jump_is_not_conditional() -> bool:
    ensure result == true
    return not Easm::easm_is_conditional_jump("jmp")
        and not Easm::easm_is_conditional_jump("jmpq")

def conditional_jump_is_not_a_terminator(op: sview) -> bool:
    requires Easm::easm_is_conditional_jump(op)
    ensure result == true
    return not Easm::easm_is_terminator(op)

def terminators_are_never_conditional_branches(op: sview) -> bool:
    requires Easm::easm_is_terminator(op)
    ensure result == true
    return not Easm::easm_is_conditional_jump(op)
