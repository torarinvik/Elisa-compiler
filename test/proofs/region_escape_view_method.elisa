# Source-linked proof of the exact method set that propagates receiver region provenance.
include "../../src/semantic/region_escape_view_method.elisa"

def source_classifier_has_exact_view_method_set(method: sview) -> bool:
    ensure result == (
        when method:
            "as_sview" | "as_cstr" | "as_view" | "as_slice" | "as_str" -> true
            _ -> false
    )
    return SemanticRegionEscapeViewMethod::is_view_method(method)

def every_region_view_method_is_recognized() -> bool:
    ensure result == true
    return (
        SemanticRegionEscapeViewMethod::is_view_method("as_sview")
        and SemanticRegionEscapeViewMethod::is_view_method("as_cstr")
        and SemanticRegionEscapeViewMethod::is_view_method("as_view")
        and SemanticRegionEscapeViewMethod::is_view_method("as_slice")
        and SemanticRegionEscapeViewMethod::is_view_method("as_str")
    )

def ordinary_or_unlisted_methods_do_not_propagate_receiver_region() -> bool:
    ensure result == true
    return (
        not SemanticRegionEscapeViewMethod::is_view_method("count")
        and not SemanticRegionEscapeViewMethod::is_view_method("len")
        and not SemanticRegionEscapeViewMethod::is_view_method("view")
        and not SemanticRegionEscapeViewMethod::is_view_method("as_bytes")
    )
