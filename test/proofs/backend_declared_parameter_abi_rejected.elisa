include "./backend_declared_parameter_abi.elisa"

def false_source_parameters_start_at_zero(source_count: i64) -> i64:
    requires source_count >= 0
    ensure result == source_count
    return source_parameter_start(true) + source_count

def false_store_index_ignores_sret(source_count: i64) -> i64:
    requires source_count >= 0
    ensure result == source_count
    return packed_store_parameter_index(source_count, true)

def false_count_omits_sret(source_count: i64, arena_count: i64) -> i64:
    requires source_count >= 0 and arena_count >= 0
    ensure result == source_count + arena_count
    return declared_parameter_count(source_count, arena_count, false, true)
