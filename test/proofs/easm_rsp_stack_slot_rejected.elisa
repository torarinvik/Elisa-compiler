include "./easm_rsp_stack_slot.elisa"

def false_unknown_stack_state_is_accepted(stack_known: bool, memory_operand: bool, rsp_base: bool, no_index: bool, displacement_valid: bool, added_valid: bool) -> bool:
    requires not stack_known
    ensure result == true
    return stack_known and memory_operand and rsp_base and no_index and displacement_valid and added_valid

def false_nonmemory_operand_is_accepted(stack_known: bool, memory_operand: bool, rsp_base: bool, no_index: bool, displacement_valid: bool, added_valid: bool) -> bool:
    requires not memory_operand
    ensure result == true
    return stack_known and memory_operand and rsp_base and no_index and displacement_valid and added_valid

def false_non_rsp_base_is_accepted(stack_known: bool, memory_operand: bool, rsp_base: bool, no_index: bool, displacement_valid: bool, added_valid: bool) -> bool:
    requires not rsp_base
    ensure result == true
    return stack_known and memory_operand and rsp_base and no_index and displacement_valid and added_valid

def false_indexed_operand_is_accepted(stack_known: bool, memory_operand: bool, rsp_base: bool, no_index: bool, displacement_valid: bool, added_valid: bool) -> bool:
    requires not no_index
    ensure result == true
    return stack_known and memory_operand and rsp_base and no_index and displacement_valid and added_valid

def false_invalid_displacement_is_accepted(stack_known: bool, memory_operand: bool, rsp_base: bool, no_index: bool, displacement_valid: bool, added_valid: bool) -> bool:
    requires not displacement_valid
    ensure result == true
    return stack_known and memory_operand and rsp_base and no_index and displacement_valid and added_valid

def false_overflowed_stack_offset_is_accepted(stack_known: bool, memory_operand: bool, rsp_base: bool, no_index: bool, displacement_valid: bool, added_valid: bool) -> bool:
    requires not added_valid
    ensure result == true
    return stack_known and memory_operand and rsp_base and no_index and displacement_valid and added_valid
