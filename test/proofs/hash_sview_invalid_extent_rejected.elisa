# False claims about rejected FNV input extents must remain unproved.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"
include "../../elisacore_std/collections.elisa"

def an_invalid_hash_extent_can_change_the_fnv_seed(view: sview) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len <= 0 or view.len.usize().i64() != view.len
    ensure result == true
    return hash_sview(view) != 0xcbf29ce484222325

def a_nonpositive_hash_extent_can_change_the_fnv_seed(view: sview) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len <= 0
    ensure result == true
    return hash_sview(view) != 0xcbf29ce484222325

def a_valid_empty_view_hash_can_be_zero(view: sview) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len == 0
    ensure result == true
    return hash_sview(view) == 0

def a_nonempty_view_hash_can_return_the_offset_basis(view: sview) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len > 0 and view.len.usize().i64() == view.len
    ensure result == true
    return hash_sview(view) == SVIEW_FNV1A_OFFSET_BASIS

def collection_and_runtime_hashes_can_disagree(view: sview) -> bool can[Unsafe.UncheckedIndex]:
    ensure result == true
    return ctx_hash_sview(view) != hash_sview(view)
