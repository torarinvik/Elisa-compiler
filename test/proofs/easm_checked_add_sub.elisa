# Accepted arithmetic branches of Easm.easm_i64_add_checked and _sub_checked.
const I64_MIN: i64 = -9223372036854775807 - 1
const I64_MAX: i64 = 9223372036854775807

def safe_positive_add(left: i64, right: i64) -> i64:
    requires right > 0
    requires left <= I64_MAX - right
    ensure result == left + right
    return left + right

def safe_negative_add(left: i64, right: i64) -> i64:
    requires right < 0
    requires left >= I64_MIN - right
    ensure result == left + right
    return left + right

def safe_positive_sub(left: i64, right: i64) -> i64:
    requires right > 0
    requires left >= I64_MIN + right
    ensure result == left - right
    return left - right

def safe_negative_sub(left: i64, right: i64) -> i64:
    requires right < 0
    requires left <= I64_MAX + right
    ensure result == left - right
    return left - right
