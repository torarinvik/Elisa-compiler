# Source-linked exact classifier used by semantic lexical-scope resolution.
include "../../src/semantic/block_kind_scope.elisa"

def source_classifier_matches_the_exact_scope_block_set(kind: sview) -> bool:
    ensure result == (
        when kind:
            "region" | "in" | "can" | "trusted" | "with" | "pool" | "nursery" | "scope" | "lock" -> true
            _ -> false
    )
    return SemanticBlockKindScope::block_kind_is_scope(kind)

def every_scope_block_kind_is_recognized() -> bool:
    ensure result == true
    return (
        SemanticBlockKindScope::block_kind_is_scope("region")
        and SemanticBlockKindScope::block_kind_is_scope("in")
        and SemanticBlockKindScope::block_kind_is_scope("can")
        and SemanticBlockKindScope::block_kind_is_scope("trusted")
        and SemanticBlockKindScope::block_kind_is_scope("with")
        and SemanticBlockKindScope::block_kind_is_scope("pool")
        and SemanticBlockKindScope::block_kind_is_scope("nursery")
        and SemanticBlockKindScope::block_kind_is_scope("scope")
        and SemanticBlockKindScope::block_kind_is_scope("lock")
    )

def ordinary_control_blocks_are_not_scope_prefixes() -> bool:
    ensure result == true
    return (
        not SemanticBlockKindScope::block_kind_is_scope("if")
        and not SemanticBlockKindScope::block_kind_is_scope("while")
        and not SemanticBlockKindScope::block_kind_is_scope("for")
        and not SemanticBlockKindScope::block_kind_is_scope("match")
    )
