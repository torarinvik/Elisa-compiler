# Child-preservation facts for the conservative store-through fallback.
# The source checker binds each Boolean input to a direct production-walker edge.

def proof_sts_match_names_reach_fallback(scrutinee: bool, guard: bool, body: bool) -> bool:
    ensure result == (scrutinee or guard or body)
    return scrutinee or guard or body

def proof_sts_catch_names_reach_fallback(guarded: bool, guard: bool, body: bool) -> bool:
    ensure result == (guarded or guard or body)
    return guarded or guard or body

def proof_sts_block_names_reach_fallback(capture: bool, statement: bool, value: bool) -> bool:
    ensure result == (capture or statement or value)
    return capture or statement or value

def proof_sts_dict_names_reach_fallback(key: bool, value: bool) -> bool:
    ensure result == (key or value)
    return key or value

def proof_sts_effect_names_reach_fallback(capture: bool, argument: bool) -> bool:
    ensure result == (capture or argument)
    return capture or argument

def proof_sts_match_statement_names_reach_fallback(scrutinee: bool, guard: bool, body: bool) -> bool:
    ensure result == (scrutinee or guard or body)
    return scrutinee or guard or body

def proof_sts_contract_expression_reaches_fallback(expression: bool) -> bool:
    ensure result == expression
    return expression

def proof_sts_hidden_names_are_unified(names_found: bool) -> bool:
    ensure result == names_found
    return names_found
