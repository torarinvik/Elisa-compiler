# Child-preservation facts for the conservative store-through fallback.
# The source checker binds each Boolean input to a direct production-walker edge.

def proof_sts_match_names_reach_fallback(scrutinee: bool, guard: bool, body: bool) -> bool:
    ensure result == (scrutinee or guard or body)
    return scrutinee or guard or body

def proof_sts_catch_names_reach_fallback(guarded: bool, guard: bool, body: bool) -> bool:
    ensure result == (guarded or guard or body)
    return guarded or guard or body

def proof_sts_block_names_reach_fallback(capture: bool, statement: bool, value: bool) -> bool:
    ensure result == (capture or statement or value)
    return capture or statement or value

def proof_sts_dict_names_reach_fallback(key: bool, value: bool) -> bool:
    ensure result == (key or value)
    return key or value

def proof_sts_effect_names_reach_fallback(capture: bool, argument: bool) -> bool:
    ensure result == (capture or argument)
    return capture or argument

def proof_sts_match_statement_names_reach_fallback(scrutinee: bool, guard: bool, body: bool) -> bool:
    ensure result == (scrutinee or guard or body)
    return scrutinee or guard or body

def proof_sts_contract_expression_reaches_fallback(expression: bool) -> bool:
    ensure result == expression
    return expression

def proof_sts_hidden_names_are_unified(names_found: bool) -> bool:
    ensure result == names_found
    return names_found

def proof_sts_nested_callee_calls_reach_unifier(callee_call: bool) -> bool:
    ensure result == callee_call
    return callee_call

def proof_chv_static_effect_candidates_check_captures_and_arguments(captures_checked: bool, arguments_checked: bool) -> bool:
    ensure result == (captures_checked and arguments_checked)
    return captures_checked and arguments_checked

def proof_chv_comprehension_scope_masks_shadowed_reference(reference_parameter: bool, binder_shadows_reference: bool) -> bool:
    ensure result == (reference_parameter and not binder_shadows_reference)
    return reference_parameter and not binder_shadows_reference

def proof_chv_view_alias_join_preserves_owned_fact(left_branch_may_own: bool, right_branch_may_own: bool) -> bool:
    ensure result == (left_branch_may_own or right_branch_may_own)
    return left_branch_may_own or right_branch_may_own

# Aggregate construction keeps possible view provenance from its initialized fields.
def proof_chv_aggregate_construct_keeps_field_view_taint(field_walked: bool, field_taint_joined: bool, aggregate_taint_set: bool) -> bool:
    ensure result == (field_walked and field_taint_joined and aggregate_taint_set)
    return field_walked and field_taint_joined and aggregate_taint_set

# Record updates retain the base aggregate's view taint and add taint from replacement fields.
def proof_chv_record_update_keeps_base_and_field_view_taint(base_taint_kept: bool, field_walked: bool, field_taint_joined: bool, aggregate_taint_set: bool) -> bool:
    ensure result == (base_taint_kept and field_walked and field_taint_joined and aggregate_taint_set)
    return base_taint_kept and field_walked and field_taint_joined and aggregate_taint_set

# Updating one projected field cannot clear aggregate taint from other fields or elements.
def proof_chv_projection_assignment_preserves_aggregate_taint(rhs_may_be_view: bool, previous_root_may_be_view: bool, compound_assignment: bool, target_is_projection: bool) -> bool:
    ensure result == (rhs_may_be_view or ((compound_assignment or target_is_projection) and previous_root_may_be_view))
    return rhs_may_be_view or ((compound_assignment or target_is_projection) and previous_root_may_be_view)

# A loop element can be a borrowed view even when the iterable itself is an aggregate.
def proof_chv_for_iterator_inherits_iterable_view_taint(iterable_may_be_owned_view: bool) -> bool:
    ensure result == (iterable_may_be_owned_view)
    return iterable_may_be_owned_view

def proof_chv_for_iterator_inherits_iterable_reference_alias(yielded_element_alias: bool, mutable_slot_alias: bool, binder_bound: bool) -> bool:
    ensure result == (binder_bound and (yielded_element_alias or mutable_slot_alias))
    return binder_bound and (yielded_element_alias or mutable_slot_alias)

# A comprehension's possible view taint follows its yielded expression.
def proof_chv_comprehension_result_tracks_yielded_view(body_may_be_owned_view: bool) -> bool:
    ensure result == (body_may_be_owned_view)
    return body_may_be_owned_view

# Element taint flows from a collection binding through the comprehension binder to its result.
def proof_chv_comprehension_element_view_reaches_yielded_result(collection_taint_reaches_iterable_binding: bool, iterable_taint_reaches_binder: bool, binder_taint_reaches_result: bool) -> bool:
    ensure result == (collection_taint_reaches_iterable_binding and iterable_taint_reaches_binder and binder_taint_reaches_result)
    return collection_taint_reaches_iterable_binding and iterable_taint_reaches_binder and binder_taint_reaches_result

# Unknown calls on owned containers or views may return a view from their receiver or arguments.
def proof_chv_method_result_tracks_receiver_or_arguments(receiver_may_be_owned: bool, arguments_may_be_owned: bool) -> bool:
    ensure result == (receiver_may_be_owned or arguments_may_be_owned)
    return receiver_may_be_owned or arguments_may_be_owned

# A direct call result may preserve a view passed to the callee.
def proof_chv_callable_result_tracks_argument_view(argument_may_be_owned: bool) -> bool:
    ensure result == (argument_may_be_owned)
    return argument_may_be_owned

# Named calls preserve possible view provenance from arguments in their result.
def proof_chv_call_result_tracks_argument_view(direct_result_may_be_owned: bool, argument_may_be_owned: bool) -> bool:
    ensure result == (direct_result_may_be_owned or argument_may_be_owned)
    return direct_result_may_be_owned or argument_may_be_owned

# Deferred static-effect calls preserve possible view provenance from runtime children.
def proof_chv_static_effect_result_tracks_runtime_views(runtime_child_may_be_owned: bool) -> bool:
    ensure result == (runtime_child_may_be_owned)
    return runtime_child_may_be_owned

# Without field types, any projection from a tainted aggregate may be view-backed.
def proof_chv_aggregate_field_projection_requires_tainted_root(root_is_known: bool, aggregate_may_contain_view: bool) -> bool:
    ensure result == (root_is_known and aggregate_may_contain_view)
    return root_is_known and aggregate_may_contain_view

def proof_chv_reference_alias_join_preserves_either_path(left_path_may_alias: bool, right_path_may_alias: bool) -> bool:
    ensure result == (left_path_may_alias or right_path_may_alias)
    return left_path_may_alias or right_path_may_alias

# Covers inner(id_holder(out), owned_view): a call result can hide the writable caller reference.
def proof_chv_reference_targets_cover_alias_routes(direct_parameter: bool, local_alias: bool, call_result: bool, projection_fallback: bool, aggregate_alias: bool) -> bool:
    ensure result == (direct_parameter and local_alias and call_result and projection_fallback and aggregate_alias)
    return direct_parameter and local_alias and call_result and projection_fallback and aggregate_alias

# Comprehension yielded-element alias facts reach a temporary binder before the body is checked.
def proof_chv_comprehension_result_tracks_yielded_alias(yielded_element_alias_checked: bool, binder_alias_bound: bool, body_alias_checked: bool) -> bool:
    ensure result == (yielded_element_alias_checked and binder_alias_bound and body_alias_checked)
    return yielded_element_alias_checked and binder_alias_bound and body_alias_checked

def proof_chv_getelse_recovery_termination_excludes_recovery_state(guarded_path_joined: bool, recovery_terminates: bool, recovery_path_joined: bool, recovery_path_excluded: bool, recovery_value_joined: bool) -> bool:
    ensure result == (guarded_path_joined and ((recovery_terminates and recovery_path_excluded and not recovery_path_joined and not recovery_value_joined) or (not recovery_terminates and recovery_path_joined and recovery_value_joined)))
    return guarded_path_joined and ((recovery_terminates and recovery_path_excluded and not recovery_path_joined and not recovery_value_joined) or (not recovery_terminates and recovery_path_joined and recovery_value_joined))

def proof_chv_scalar_sview_rebinding_prefers_latest_fact(flow_row_found: bool, flow_scalar: bool, initializer_scalar: bool) -> bool:
    ensure result == ((flow_row_found and flow_scalar) or (not flow_row_found and initializer_scalar))
    return (flow_row_found and flow_scalar) or (not flow_row_found and initializer_scalar)

# An address of a local, such as &local_holder, follows its operand; logical Not clears provenance.
def proof_chv_address_of_uses_operand_reference_provenance(boolean_not: bool, operand_alias_checked: bool) -> bool:
    ensure result == (not boolean_not and operand_alias_checked)
    return not boolean_not and operand_alias_checked

# Runtime binary operands are both checked through the unknown-call fallback for overloaded operators.
def proof_chv_binary_operator_checks_both_operands(receiver_checked: bool, operand_checked: bool, fallback_checked: bool) -> bool:
    ensure result == (receiver_checked and operand_checked and fallback_checked)
    return receiver_checked and operand_checked and fallback_checked

# `is` and packed-pattern `as` targets do not flow through runtime operand or unknown-call checks.
def proof_chv_binary_target_operators_skip_runtime_value_path(target_operator: bool, target_classified: bool, right_walk_guarded: bool, fallback_guarded: bool) -> bool:
    ensure result == (target_operator and target_classified and right_walk_guarded and fallback_guarded)
    return target_operator and target_classified and right_walk_guarded and fallback_guarded

# A non-boolean ref-returning operator result is caller-backed when one of its operands is.
def proof_chv_binary_operator_result_tracks_reference_operands(boolean_result: bool, left_alias: bool, right_alias: bool) -> bool:
    ensure result == (not boolean_result and (left_alias or right_alias))
    return not boolean_result and (left_alias or right_alias)

# Non-boolean binary results retain possible provenance from either operand.
def proof_chv_binary_operator_result_tracks_view_operands(boolean_result: bool, left_may_be_view: bool, right_may_be_view: bool) -> bool:
    ensure result == (not boolean_result and (left_may_be_view or right_may_be_view))
    return not boolean_result and (left_may_be_view or right_may_be_view)

# Comparisons and logical operators produce scalar boolean results.
def proof_chv_binary_boolean_result_clears_view_taint(boolean_result_classified: bool, result_taint_cleared: bool) -> bool:
    ensure result == (boolean_result_classified and result_taint_cleared)
    return boolean_result_classified and result_taint_cleared

# Covers overloaded `target[key]`: __index__ receives both receiver and key provenance.
def proof_chv_index_overloads_check_receiver_and_keys(receiver_checked: bool, key_checked: bool, call_checked: bool, type_application_skipped: bool) -> bool:
    ensure result == (receiver_checked and key_checked and call_checked and type_application_skipped)
    return receiver_checked and key_checked and call_checked and type_application_skipped

# Single-key Index can call __index__, so the returned reference may come from receiver or key.
def proof_chv_index_result_tracks_receiver_view(receiver_may_be_view: bool, index_key_may_be_view: bool, runtime_index_guarded: bool) -> bool:
    ensure result == (receiver_may_be_view or (runtime_index_guarded and index_key_may_be_view))
    return receiver_may_be_view or (runtime_index_guarded and index_key_may_be_view)

# IndexN selects from its receiver; its multi-index/type arguments do not become result storage.
def proof_chv_indexn_result_tracks_receiver_only(receiver_may_be_view: bool) -> bool:
    ensure result == (receiver_may_be_view)
    return receiver_may_be_view

# Struct unary negation lowers to __neg__; logical Not clears reference provenance.
def proof_chv_unary_negation_tracks_reference_operand(boolean_not: bool, operand_alias_checked: bool) -> bool:
    ensure result == (not boolean_not and operand_alias_checked)
    return not boolean_not and operand_alias_checked

def proof_chv_unary_negation_visits_operand(operand_checked: bool) -> bool:
    ensure result == (operand_checked)
    return operand_checked

# Unary operators carry possible owned-view provenance, except logical Not which returns bool.
def proof_chv_unary_negation_tracks_view_operand(boolean_not: bool, operand_may_be_view: bool) -> bool:
    ensure result == (not boolean_not and operand_may_be_view)
    return not boolean_not and operand_may_be_view

# A local_holder.slot projection with no caller reference stays safe; with one, the untyped fallback may overapproximate.
def proof_chv_projection_fallback_requires_caller_reference(caller_reference_exists: bool) -> bool:
    ensure result == (caller_reference_exists)
    return caller_reference_exists

def proof_chv_overload_bodies_contribute_store_rows(overload_body_checked: bool) -> bool:
    ensure result == overload_body_checked
    return overload_body_checked

def proof_chv_method_calls_check_receiver_and_arguments(receiver_checked: bool, arguments_checked: bool) -> bool:
    ensure result == (receiver_checked and arguments_checked)
    return receiver_checked and arguments_checked

def proof_chv_indirect_calls_fail_closed(reference_target_checked: bool, owned_view_checked: bool) -> bool:
    ensure result == (reference_target_checked and owned_view_checked)
    return reference_target_checked and owned_view_checked

def proof_chv_summary_calls_check_reference_aliases(reference_alias_checked: bool, owned_view_checked: bool) -> bool:
    ensure result == (reference_alias_checked and owned_view_checked)
    return reference_alias_checked and owned_view_checked

def proof_chv_named_callees_cover_dispatch_routes(direct_call_checked: bool) -> bool:
    ensure result == direct_call_checked
    return direct_call_checked

def proof_chv_named_arguments_use_unknown_call_fallback(named_arguments_present: bool) -> bool:
    ensure result == named_arguments_present
    return named_arguments_present

def proof_sts_named_argument_calls_use_conservative_fallback(named_arguments_present: bool) -> bool:
    ensure result == named_arguments_present
    return named_arguments_present

def proof_chv_field_calls_use_unknown_fallback(field_call_present: bool) -> bool:
    ensure result == field_call_present
    return field_call_present
