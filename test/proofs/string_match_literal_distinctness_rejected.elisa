include "./string_match_literal_distinctness.elisa"

# For value == "1", the second arm returns false. The verifier must not collapse it
# with the first arm merely because both spellings parse as integer one.
def false_claim_string_1_selects_the_true_arm(value: sview) -> bool:
    requires value == "1"
    ensure result == true
    match value:
        "01":
            return true
        "1":
            return false
        _:
            return true
    return true
