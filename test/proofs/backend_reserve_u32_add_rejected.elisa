include "./backend_reserve_u32_add.elisa"

def false_maximum_u32_operands_sum_fits_target(left: u64, right: u64) -> u64:
    requires left == 4294967295
    requires right == 4294967295
    ensure result <= 4294967295
    return left + right

def false_maximum_u32_operands_overflow_signed_i64() -> u64:
    ensure RESERVE_U32_MAX + RESERVE_U32_MAX > RESERVE_I64_MAX
    return RESERVE_U32_MAX + RESERVE_U32_MAX
