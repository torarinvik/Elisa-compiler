include "../../src/semantic/protocol_owner_domain.elisa"

def peer_module_has_authority() -> bool:
    ensure result == true
    return ProtocolOwner::authority(true, true, false, true, false)

def root_owns_every_module() -> bool:
    ensure result == true
    return ProtocolOwner::authority(true, true, false, false, true)

def one_legal_state_is_enough() -> bool:
    ensure result == true
    return ProtocolOwner::all_paths(true, false)
