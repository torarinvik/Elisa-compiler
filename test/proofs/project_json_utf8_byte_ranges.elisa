# Every byte formula used by ProjectSystem's UTF-8 encoder stays in its canonical range.
def one_byte_fits(code: i64) -> i64:
    requires code >= 0 and code < 128
    ensure result >= 0
    ensure result <= 127
    return code

def two_byte_lead_fits(code: i64) -> i64:
    requires code >= 128 and code < 2048
    ensure result >= 194
    ensure result <= 223
    return 192 + code / 64

def two_byte_tail_fits(code: i64) -> i64:
    requires code >= 128 and code < 2048
    ensure result >= 128
    ensure result <= 191
    return 128 + code % 64

def three_byte_lead_fits(code: i64) -> i64:
    requires code >= 2048 and code < 65536
    ensure result >= 224
    ensure result <= 239
    return 224 + code / 4096

def three_byte_middle_fits(code: i64) -> i64:
    requires code >= 2048 and code < 65536
    ensure result >= 128
    ensure result <= 191
    return 128 + (code / 64) % 64

def three_byte_tail_fits(code: i64) -> i64:
    requires code >= 2048 and code < 65536
    ensure result >= 128
    ensure result <= 191
    return 128 + code % 64

def four_byte_lead_fits(code: i64) -> i64:
    requires code >= 65536 and code <= 1114111
    ensure result >= 240
    ensure result <= 244
    return 240 + code / 262144

def four_byte_second_fits(code: i64) -> i64:
    requires code >= 65536 and code <= 1114111
    ensure result >= 128
    ensure result <= 191
    return 128 + (code / 4096) % 64

def four_byte_third_fits(code: i64) -> i64:
    requires code >= 65536 and code <= 1114111
    ensure result >= 128
    ensure result <= 191
    return 128 + (code / 64) % 64

def four_byte_tail_fits(code: i64) -> i64:
    requires code >= 65536 and code <= 1114111
    ensure result >= 128
    ensure result <= 191
    return 128 + code % 64
