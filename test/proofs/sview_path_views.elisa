# Generic path components refine the last-separator view contracts.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

def basename_has_the_last_separator_extent_and_offset(view: sview, sep: u8) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    ensure result == true
    last: i64 = sview_find_last_byte(view, sep)
    base: sview = sview_basename(view, sep)
    return (
        (last == -1 and base.len == view.len and base.data == view.data)
        or (last >= 0 and base.len == view.len - (last + 1)
            and base.data == view.data + (last + 1).usize())
    )

def basename_preserves_the_component_bytes(view: sview, sep: u8) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    ensure result == true
    last: i64 = sview_find_last_byte(view, sep)
    base: sview = sview_basename(view, sep)
    return (last == -1 and base.data == view.data)
        or (last >= 0 and base.data == view.data + (last + 1).usize())

def dirname_has_the_prefix_extent_and_offset(view: sview, sep: u8) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    ensure result == true
    last: i64 = sview_find_last_byte(view, sep)
    parent: sview = sview_dirname(view, sep)
    return (
        (last == -1 and parent.len == 0 and parent.data == view.data)
        or (last >= 0 and parent.len == last
            and parent.data == view.data)
    )

def dirname_preserves_the_prefix_bytes(view: sview, sep: u8) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    ensure result == true
    parent: sview = sview_dirname(view, sep)
    return parent.data == view.data

def malformed_view_components_have_zero_extent(view: sview, sep: u8) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires view.len < 0 or view.len.usize().i64() != view.len
    ensure result == true
    return sview_basename(view, sep).len == 0 and sview_dirname(view, sep).len == 0
