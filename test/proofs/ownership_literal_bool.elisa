# One-step proof model for the conservative literal-boolean recognizer consumed
# by ownership and derived-state branch reachability.
module OwnershipLiteralBoolSpecification:
    public:
        const OWNERSHIP_LITERAL_BOOL_PROOF_DEPTH_LIMIT: usize = 128

        def fact_is_known_at_node(depth: usize, is_boolean_literal: bool,
            is_parenthesized: bool, inner_known: bool) -> bool:
            requires not (is_boolean_literal and is_parenthesized)
            ensure result == (depth < OWNERSHIP_LITERAL_BOOL_PROOF_DEPTH_LIMIT and
                (is_boolean_literal or (not is_boolean_literal and is_parenthesized and inner_known)))
            false return if depth >= OWNERSHIP_LITERAL_BOOL_PROOF_DEPTH_LIMIT
            true return if is_boolean_literal
            return inner_known if is_parenthesized
            return false

        def fact_value_at_node(depth: usize, is_boolean_literal: bool,
            is_parenthesized: bool, literal_value: bool, inner_known: bool,
            inner_value: bool) -> bool:
            requires not (is_boolean_literal and is_parenthesized)
            requires is_boolean_literal or not is_parenthesized or inner_known or not inner_value
            ensure result == (depth < OWNERSHIP_LITERAL_BOOL_PROOF_DEPTH_LIMIT and
                ((is_boolean_literal and literal_value) or (not is_boolean_literal and is_parenthesized and inner_value)))
            false return if depth >= OWNERSHIP_LITERAL_BOOL_PROOF_DEPTH_LIMIT
            return literal_value if is_boolean_literal
            return inner_value if is_parenthesized
            return false

def boolean_literals_are_known_and_keep_their_value(depth: usize, value: bool) -> bool:
    requires depth < OwnershipLiteralBoolSpecification::OWNERSHIP_LITERAL_BOOL_PROOF_DEPTH_LIMIT
    ensure result == true
    return (
        OwnershipLiteralBoolSpecification::fact_is_known_at_node(depth, true, false, false)
        and OwnershipLiteralBoolSpecification::fact_value_at_node(depth, true, false, value, false, false) == value
    )

def parentheses_preserve_the_inner_fact(depth: usize, inner_known: bool, inner_value: bool) -> bool:
    requires depth < OwnershipLiteralBoolSpecification::OWNERSHIP_LITERAL_BOOL_PROOF_DEPTH_LIMIT
        and depth + 1 < OwnershipLiteralBoolSpecification::OWNERSHIP_LITERAL_BOOL_PROOF_DEPTH_LIMIT
        and (inner_known or not inner_value)
    ensure result == true
    return (
        OwnershipLiteralBoolSpecification::fact_is_known_at_node(depth, false, true, inner_known) == inner_known
        and OwnershipLiteralBoolSpecification::fact_value_at_node(depth, false, true, false, inner_known, inner_value) == inner_value
    )

def parenthesis_at_the_depth_boundary_is_unknown_and_false() -> bool:
    ensure result == true
    limit: usize = OwnershipLiteralBoolSpecification::OWNERSHIP_LITERAL_BOOL_PROOF_DEPTH_LIMIT
    child_known: bool = OwnershipLiteralBoolSpecification::fact_is_known_at_node(limit, true, false, true)
    child_value: bool = OwnershipLiteralBoolSpecification::fact_value_at_node(limit, true, false, true, false, true)
    parent_depth: usize = limit - 1.usize()
    return (
        not child_known
        and not child_value
        and not OwnershipLiteralBoolSpecification::fact_is_known_at_node(parent_depth, false, true, child_known)
        and not OwnershipLiteralBoolSpecification::fact_value_at_node(parent_depth, false, true, false, child_known, child_value)
    )

def unknown_facts_never_carry_a_true_value(depth: usize, is_boolean_literal: bool,
    is_parenthesized: bool, literal_value: bool, inner_known: bool,
    inner_value: bool) -> bool:
    requires not (is_boolean_literal and is_parenthesized)
    requires is_boolean_literal or not is_parenthesized or inner_known or not inner_value
    ensure result == true
    return (
        OwnershipLiteralBoolSpecification::fact_is_known_at_node(depth, is_boolean_literal,
            is_parenthesized, inner_known)
        or not OwnershipLiteralBoolSpecification::fact_value_at_node(depth, is_boolean_literal,
            is_parenthesized, literal_value, inner_known, inner_value)
    )

def the_depth_cutoff_discards_literal_facts() -> bool:
    ensure result == true
    limit: usize = OwnershipLiteralBoolSpecification::OWNERSHIP_LITERAL_BOOL_PROOF_DEPTH_LIMIT
    return (
        not OwnershipLiteralBoolSpecification::fact_is_known_at_node(limit, true, false, true)
        and not OwnershipLiteralBoolSpecification::fact_value_at_node(limit, true, false, true, false, true)
    )

def an_unsupported_expression_is_conservatively_unknown(value: bool) -> bool:
    ensure result == true
    return (
        not OwnershipLiteralBoolSpecification::fact_is_known_at_node(0, false, false, true)
        and not OwnershipLiteralBoolSpecification::fact_value_at_node(0, false, false, value, false, true)
    )

def a_parenthesized_unknown_stays_unknown_and_false() -> bool:
    ensure result == true
    return (
        not OwnershipLiteralBoolSpecification::fact_is_known_at_node(0, false, true, false)
        and not OwnershipLiteralBoolSpecification::fact_value_at_node(0, false, true, false, false, false)
    )
