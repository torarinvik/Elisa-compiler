# ED A0 80 normalizes to payloads that decode to U+D800. The production ED
# second-byte guard excludes this surrogate encoding.
include "../../src/lexer/lexer_utf8_codepoint_constants.elisa"
include "../../src/lexer/lexer_utf8_codepoint_wide.elisa"

def an_unchecked_ed_a0_sequence_decodes_to_a_surrogate() -> bool:
    decoded: i64 = lexer_decode_utf8_three(UTF8_SURROGATE_LEAD - UTF8_THREE_BYTE_LEAD_MIN, 32, 0)
    ensure result == true
    return decoded >= UNICODE_SURROGATE_MIN and decoded <= UNICODE_SURROGATE_MAX
