include "./const_enum_storage_range_u32.elisa"

def false_const_enum_u32_accepts_below(value: i64) -> bool:
    requires value < 0
    ensure result == true
    return proof_const_enum_u32_fits(value)

def false_const_enum_u32_accepts_above(value: i64) -> bool:
    requires value > 4294967295
    ensure result == true
    return proof_const_enum_u32_fits(value)
