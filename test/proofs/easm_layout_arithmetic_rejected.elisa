include "../../src/backend/easm_memstate_domain.elisa"
include "../../src/backend/easm_layout_arithmetic.elisa"

def stride_overrides_a_positive_explicit_size() -> bool:
    ensure result == true
    return EasmLayoutArithmetic::declared_size(8, 4) == 4

def overflowing_field_extent_is_accepted() -> bool:
    ensure result == true
    extent: (valid: bool, value: i64) = EasmLayoutArithmetic::field_extent_checked(EasmLayoutArithmetic::I64_MAX, 8)
    return extent.valid

def first_unrepresentable_field_extent_is_accepted() -> bool:
    ensure result == true
    extent: (valid: bool, value: i64) = EasmLayoutArithmetic::field_extent_checked(EasmLayoutArithmetic::I64_MAX, 1)
    return extent.valid

def a_valid_small_field_can_shrink_the_existing_layout_bound() -> bool:
    ensure result == true
    step: (valid: bool, value: i64) = EasmLayoutArithmetic::include_field_extent(EasmLayoutArithmetic::I64_MAX, 0, 1)
    return step.valid and step.value < EasmLayoutArithmetic::I64_MAX

def a_common_upper_bound_can_be_smaller_than_a_successful_field_accumulation(current: i64, offset: i64, width: i64, upper: i64) -> bool:
    requires offset >= 0 and width >= 0 and width <= EasmLayoutArithmetic::I64_MAX - offset
    requires current <= upper and offset + width <= upper
    ensure result == true
    step: (valid: bool, value: i64) = EasmLayoutArithmetic::include_field_extent(current, offset, width)
    return step.valid and step.value > upper
