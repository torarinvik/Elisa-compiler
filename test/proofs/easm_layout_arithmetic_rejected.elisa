include "../../src/backend/easm_layout_arithmetic.elisa"

def stride_overrides_a_positive_explicit_size() -> bool:
    ensure result == true
    return EasmLayoutArithmetic::declared_size(8, 4) == 4

def overflowing_field_extent_is_accepted() -> bool:
    ensure result == true
    extent: (valid: bool, value: i64) = EasmLayoutArithmetic::field_extent_checked(EasmLayoutArithmetic::I64_MAX, 8)
    return extent.valid
