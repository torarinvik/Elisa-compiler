# Source-linked properties for the project system's production suffix matcher.
include "../../src/driver/project.elisa"

def empty_suffix_matches_every_path(path: darray[u8]&) -> bool:
    ensure result == true
    return ProjectSystem::bytes_ends_with_view(path, "")

def a_path_shorter_than_elisa_cannot_match(path: darray[u8]&) -> bool:
    requires path.count < sview_len(".elisa")
    ensure result == false
    return ProjectSystem::bytes_ends_with_view(path, ".elisa")

def any_leading_byte_before_elisa_is_accepted(prefix: u8) -> bool can[Memory.Allocate, Abort.Panic]:
    ensure result == true
    path: mutable darray[u8] = [prefix]
    ProjectSystem::bytes_extend_view(&path, ".elisa")
    return ProjectSystem::bytes_ends_with_view(path, ".elisa")

def elisa_suffix_match_depends_on_its_final_byte(prefix: u8, final_byte: u8) -> bool can[Memory.Allocate, Abort.Panic]:
    ensure result == (final_byte == "a"[0])
    path: mutable darray[u8] = [prefix]
    ProjectSystem::bytes_extend_view(&path, ".elis")
    path.push(final_byte)
    return ProjectSystem::bytes_ends_with_view(path, ".elisa")

def elisai_suffix_match_depends_on_its_final_byte(prefix: u8, final_byte: u8) -> bool can[Memory.Allocate, Abort.Panic]:
    ensure result == (final_byte == "i"[0])
    path: mutable darray[u8] = [prefix]
    ProjectSystem::bytes_extend_view(&path, ".elisa")
    path.push(final_byte)
    return ProjectSystem::bytes_ends_with_view(path, ".elisai")

def an_earlier_suffix_byte_mismatch_is_rejected(prefix: u8, changed_byte: u8) -> bool can[Memory.Allocate, Abort.Panic]:
    requires changed_byte != "e"[0]
    ensure result == false
    path: mutable darray[u8] = [prefix]
    ProjectSystem::bytes_extend_view(&path, ".")
    path.push(changed_byte)
    ProjectSystem::bytes_extend_view(&path, "lisa")
    return ProjectSystem::bytes_ends_with_view(path, ".elisa")

def negative_length_suffix_views_never_match(path: darray[u8]&, suffix: sview) -> bool:
    ensure result == true
    return sview_len(suffix).i64() >= 0 or not ProjectSystem::bytes_ends_with_view(path, suffix)
