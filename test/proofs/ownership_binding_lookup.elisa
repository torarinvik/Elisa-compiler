# Source-linked fail-closed laws for exact-span ownership binding lookup.
# The table record below is the lookup's six-field projection; the proof covers the
# imported production algorithm over this interface, while the admission script checks
# that these fields retain their production SymbolTable types.
module Ast:
    struct Pos:
        line: mutable u32
        column: mutable u32
        offset: mutable u32
        end_line: mutable u32
        end_column: mutable u32
        end_offset: mutable u32

include "../../src/semantic/binding_identity_types.elisa"
include "../../src/semantic/ownership_flow_domain.elisa"
include "../../src/semantic/ownership_binding_flow.elisa"

extend Semantic:
    public:
        # ownership_binding_at_position reads only `symbols.count`; keeping this
        # opaque element avoids importing the compiler's much larger Symbol graph.
        struct Symbol:
            projection_marker: u8

extend Semantic:
    public:
        # Only fields read by ownership_binding_at_position are represented here.
        # The source-structure gate binds each field to semantic_types.elisa.
        struct SymbolTable:
            symbols: mutable darray[Symbol] = []
            ref_pos: mutable darray[Ast::Pos] = []
            ref_binding_ids: mutable darray[BindingId] = []
            ref_owner_index_valid: mutable bool = true
            ref_owner_next: mutable darray[u32] = []
            ref_owner_heads: mutable darray[u32] = []

extend Semantic:
    private:
        const SYMBOL_INDEX_ROW_NONE: u32 = Semantic::INVALID_DECL_ID_VALUE

include "../../src/semantic/ownership_binding_lookup.elisa"

def exact_reference_at_owner_bucket_head_is_found(table: Semantic::SymbolTable&,
    owner: u32,
    offset: u32,
    end_offset: u32,
    row: usize) -> bool:
    requires (
        owner != Semantic::INVALID_DECL_ID_VALUE
        and owner.usize() < table.symbols.count
        and owner.usize() < table.ref_owner_heads.count
    )
    requires (
        table.ref_pos.count == table.ref_binding_ids.count
        and table.ref_owner_index_valid
        and table.ref_owner_next.count == table.ref_pos.count
    )
    requires row < table.ref_pos.count and row < Semantic::INVALID_DECL_ID_VALUE.usize()
    requires table.ref_owner_heads[owner.usize()].usize() == row and table.ref_owner_next[row] == Semantic::INVALID_DECL_ID_VALUE
    requires (
        table.ref_binding_ids[row].owner.value == owner
        and table.ref_pos[row].offset == offset
        and table.ref_pos[row].end_offset == end_offset
        and end_offset > offset
    )
    ensure result == true
    can Abort.Panic:
        position: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: offset, end_line: 1, end_column: 2, end_offset: end_offset}
        found, identity = Semantic::ownership_binding_at_position(table, Semantic::DeclId{value: owner}, position)
        return found and Semantic::ownership_binding_ids_equal(identity, table.ref_binding_ids[row])

def fallback_scan_finds_single_exact_reference(table: Semantic::SymbolTable&, owner: u32, offset: u32, end_offset: u32) -> bool:
    requires owner != Semantic::INVALID_DECL_ID_VALUE and owner.usize() < table.symbols.count and not table.ref_owner_index_valid
    requires table.ref_pos.count == 1 and table.ref_binding_ids.count == 1 and table.ref_binding_ids[0].owner.value == owner
    requires table.ref_pos[0].offset == offset and table.ref_pos[0].end_offset == end_offset and end_offset > offset
    ensure result == true
    can Abort.Panic:
        position: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: offset, end_line: 1, end_column: 2, end_offset: end_offset}
        found, identity = Semantic::ownership_binding_at_position(table, Semantic::DeclId{value: owner}, position)
        return found and Semantic::ownership_binding_ids_equal(identity, table.ref_binding_ids[0])

def conflicting_exact_rows_are_rejected(table: Semantic::SymbolTable&,
    owner: u32,
    offset: u32,
    end_offset: u32,
    first: usize,
    second: usize) -> bool:
    requires (
        owner != Semantic::INVALID_DECL_ID_VALUE
        and owner.usize() < table.symbols.count
        and owner.usize() < table.ref_owner_heads.count
    )
    requires (
        table.ref_pos.count == table.ref_binding_ids.count
        and table.ref_owner_index_valid
        and table.ref_owner_next.count == table.ref_pos.count
    )
    requires first < table.ref_pos.count and second < table.ref_pos.count and first != second
    requires first < Semantic::INVALID_DECL_ID_VALUE.usize() and second < Semantic::INVALID_DECL_ID_VALUE.usize()
    requires (
        table.ref_owner_heads[owner.usize()].usize() == first
        and table.ref_owner_next[first] == second.u32()
        and table.ref_owner_next[second] == Semantic::INVALID_DECL_ID_VALUE
    )
    requires table.ref_binding_ids[first].owner.value == owner and table.ref_binding_ids[second].owner.value == owner
    requires table.ref_pos[first].offset == offset and table.ref_pos[first].end_offset == end_offset
    requires table.ref_pos[second].offset == offset and table.ref_pos[second].end_offset == end_offset
    requires not Semantic::ownership_binding_ids_equal(table.ref_binding_ids[first], table.ref_binding_ids[second]) and end_offset > offset
    ensure result == true
    can Abort.Panic:
        position: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: offset, end_line: 1, end_column: 2, end_offset: end_offset}
        found, identity = Semantic::ownership_binding_at_position(table, Semantic::DeclId{value: owner}, position)
        return not found and identity.owner.value == Semantic::INVALID_DECL_ID_VALUE and identity.serial == Semantic::FIRST_BINDING_SERIAL

def matching_row_in_a_malformed_self_loop_is_rejected(table: Semantic::SymbolTable&, owner: u32, offset: u32, end_offset: u32) -> bool:
    requires (
        owner != Semantic::INVALID_DECL_ID_VALUE
        and owner.usize() < table.symbols.count
        and owner.usize() < table.ref_owner_heads.count
    )
    requires (
        table.ref_pos.count == 1
        and table.ref_binding_ids.count == 1
        and table.ref_owner_index_valid
        and table.ref_owner_next.count == 1
    )
    requires table.ref_owner_heads[owner.usize()] == 0 and table.ref_owner_next[0] == 0
    requires (
        table.ref_binding_ids[0].owner.value == owner
        and table.ref_pos[0].offset == offset
        and table.ref_pos[0].end_offset == end_offset
        and end_offset > offset
    )
    ensure result == true
    can Abort.Panic:
        position: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: offset, end_line: 1, end_column: 2, end_offset: end_offset}
        found, identity = Semantic::ownership_binding_at_position(table, Semantic::DeclId{value: owner}, position)
        return not found and identity.owner.value == Semantic::INVALID_DECL_ID_VALUE and identity.serial == Semantic::FIRST_BINDING_SERIAL

def a_different_span_is_rejected(table: Semantic::SymbolTable&, owner: u32, offset: u32, end_offset: u32, row: usize) -> bool:
    requires (
        owner != Semantic::INVALID_DECL_ID_VALUE
        and owner.usize() < table.symbols.count
        and owner.usize() < table.ref_owner_heads.count
    )
    requires (
        table.ref_pos.count == table.ref_binding_ids.count
        and table.ref_owner_index_valid
        and table.ref_owner_next.count == table.ref_pos.count
    )
    requires row < table.ref_pos.count and row < Semantic::INVALID_DECL_ID_VALUE.usize()
    requires table.ref_owner_heads[owner.usize()].usize() == row and table.ref_owner_next[row] == Semantic::INVALID_DECL_ID_VALUE
    requires (
        table.ref_binding_ids[row].owner.value == owner
        and (table.ref_pos[row].offset != offset
            or table.ref_pos[row].end_offset != end_offset)
    )
    requires end_offset > offset
    ensure result == true
    can Abort.Panic:
        position: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: offset, end_line: 1, end_column: 2, end_offset: end_offset}
        found, identity = Semantic::ownership_binding_at_position(table, Semantic::DeclId{value: owner}, position)
        return not found and identity.owner.value == Semantic::INVALID_DECL_ID_VALUE and identity.serial == Semantic::FIRST_BINDING_SERIAL

def zero_width_span_is_rejected(table: Semantic::SymbolTable&, owner: u32, offset: u32) -> bool:
    requires owner.usize() < table.symbols.count
    ensure result == true
    can Abort.Panic:
        position: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: offset, end_line: 1, end_column: 1, end_offset: offset}
        found, identity = Semantic::ownership_binding_at_position(table, Semantic::DeclId{value: owner}, position)
        return not found and identity.owner.value == Semantic::INVALID_DECL_ID_VALUE and identity.serial == Semantic::FIRST_BINDING_SERIAL

def invalid_owner_is_rejected(table: Semantic::SymbolTable&, offset: u32, end_offset: u32) -> bool:
    requires end_offset > offset
    ensure result == true
    can Abort.Panic:
        position: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: offset, end_line: 1, end_column: 2, end_offset: end_offset}
        found, identity = Semantic::ownership_binding_at_position(table, Semantic::DeclId{value: Semantic::INVALID_DECL_ID_VALUE}, position)
        return not found and identity.owner.value == Semantic::INVALID_DECL_ID_VALUE and identity.serial == Semantic::FIRST_BINDING_SERIAL

def out_of_range_owner_is_rejected(table: Semantic::SymbolTable&, owner: u32, offset: u32, end_offset: u32) -> bool:
    requires owner != Semantic::INVALID_DECL_ID_VALUE and owner.usize() >= table.symbols.count and end_offset > offset
    ensure result == true
    can Abort.Panic:
        position: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: offset, end_line: 1, end_column: 2, end_offset: end_offset}
        found, identity = Semantic::ownership_binding_at_position(table, Semantic::DeclId{value: owner}, position)
        return not found and identity.owner.value == Semantic::INVALID_DECL_ID_VALUE and identity.serial == Semantic::FIRST_BINDING_SERIAL

def misaligned_reference_arrays_are_rejected(table: Semantic::SymbolTable&, owner: u32, offset: u32, end_offset: u32) -> bool:
    requires owner.usize() < table.symbols.count and table.ref_pos.count != table.ref_binding_ids.count
    requires end_offset > offset
    ensure result == true
    can Abort.Panic:
        position: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: offset, end_line: 1, end_column: 2, end_offset: end_offset}
        found, identity = Semantic::ownership_binding_at_position(table, Semantic::DeclId{value: owner}, position)
        return not found and identity.owner.value == Semantic::INVALID_DECL_ID_VALUE and identity.serial == Semantic::FIRST_BINDING_SERIAL

def stale_index_links_are_rejected(table: Semantic::SymbolTable&, owner: u32, offset: u32, end_offset: u32) -> bool:
    requires (
        owner.usize() < table.symbols.count
        and table.ref_pos.count == table.ref_binding_ids.count
        and table.ref_owner_index_valid
        and table.ref_owner_next.count != table.ref_pos.count
    )
    requires end_offset > offset
    ensure result == true
    can Abort.Panic:
        position: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: offset, end_line: 1, end_column: 2, end_offset: end_offset}
        found, identity = Semantic::ownership_binding_at_position(table, Semantic::DeclId{value: owner}, position)
        return not found and identity.owner.value == Semantic::INVALID_DECL_ID_VALUE and identity.serial == Semantic::FIRST_BINDING_SERIAL

def missing_owner_bucket_is_rejected(table: Semantic::SymbolTable&, owner: u32, offset: u32, end_offset: u32) -> bool:
    requires (
        owner.usize() < table.symbols.count
        and table.ref_pos.count == table.ref_binding_ids.count
        and table.ref_owner_index_valid
        and table.ref_owner_next.count == table.ref_pos.count
        and owner.usize() >= table.ref_owner_heads.count
    )
    requires end_offset > offset
    ensure result == true
    can Abort.Panic:
        position: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: offset, end_line: 1, end_column: 2, end_offset: end_offset}
        found, identity = Semantic::ownership_binding_at_position(table, Semantic::DeclId{value: owner}, position)
        return not found and identity.owner.value == Semantic::INVALID_DECL_ID_VALUE and identity.serial == Semantic::FIRST_BINDING_SERIAL
