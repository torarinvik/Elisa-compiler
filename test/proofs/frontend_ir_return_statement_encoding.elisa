# Source-linked laws for ReturnStmt wire encoding and its absent-value sentinel.
include "../../src/driver/frontend_ir_return_statement_encoding.elisa"

const EXPECTED_RETURN_STMT_NODE_TYPE_ID: u32 = 228
const EXPECTED_RETURN_POSITION_FIELD_ID: u32 = 1
const EXPECTED_RETURN_VALUE_FIELD_ID: u32 = 2
const EXPECTED_RETURN_NO_VALUE_NODE_ID: u32 = 0

def return_statement_node_type_id_is_exact() -> u32:
    ensure result == EXPECTED_RETURN_STMT_NODE_TYPE_ID
    return FrontendIrReturnStatementEncoding::node_type_id()

def absent_return_value_uses_no_node_sentinel() -> u32:
    ensure result == EXPECTED_RETURN_NO_VALUE_NODE_ID
    return FrontendIrReturnStatementEncoding::no_value_node_id()

def return_statement_field_mapping_is_exact(field: FrontendIrReturnStatementEncoding::ReturnStatementField) -> u32:
    ensure field != FrontendIrReturnStatementEncoding::ReturnStatementField.Position or result == EXPECTED_RETURN_POSITION_FIELD_ID
    ensure field != FrontendIrReturnStatementEncoding::ReturnStatementField.Value or result == EXPECTED_RETURN_VALUE_FIELD_ID
    return FrontendIrReturnStatementEncoding::field_id(field)

def return_statement_field_ids_are_distinct() -> bool:
    ensure result == true
    return (
        FrontendIrReturnStatementEncoding::field_id(FrontendIrReturnStatementEncoding::ReturnStatementField.Position)
        != FrontendIrReturnStatementEncoding::field_id(FrontendIrReturnStatementEncoding::ReturnStatementField.Value)
    )
