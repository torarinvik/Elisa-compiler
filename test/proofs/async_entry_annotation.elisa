# Source-linked proof of the decorator obligations for async-entry functions.
module AsyncEntryAnnotationRule:
    public:
        def needs_segment_diagnostic(async_entry: bool, segment_agnostic: bool, segment_establishing: bool) -> bool:
            ensure result == (async_entry and not (segment_agnostic or segment_establishing))
            return async_entry and not (segment_agnostic or segment_establishing)

        def needs_reentrant_diagnostic(async_entry: bool, reentrant_safe: bool) -> bool:
            ensure result == (async_entry and not reentrant_safe)
            return async_entry and not reentrant_safe

def source_rules_are_exact(async_entry: bool, segment_agnostic: bool, segment_establishing: bool, reentrant_safe: bool) -> bool:
    ensure result == true
    return AsyncEntryAnnotationRule::needs_segment_diagnostic(async_entry, segment_agnostic, segment_establishing) ==
            (async_entry and not (segment_agnostic or segment_establishing)) and
        AsyncEntryAnnotationRule::needs_reentrant_diagnostic(async_entry, reentrant_safe) ==
            (async_entry and not reentrant_safe)

def either_segment_policy_satisfies_the_obligation() -> bool:
    ensure result == true
    return not AsyncEntryAnnotationRule::needs_segment_diagnostic(true, true, false) and
        not AsyncEntryAnnotationRule::needs_segment_diagnostic(true, false, true)

def async_entry_requires_both_obligations() -> bool:
    ensure result == true
    return AsyncEntryAnnotationRule::needs_segment_diagnostic(true, false, false) and
        AsyncEntryAnnotationRule::needs_reentrant_diagnostic(true, false)

def compliant_async_entry_has_no_missing_obligations() -> bool:
    ensure result == true
    return not AsyncEntryAnnotationRule::needs_segment_diagnostic(true, true, false) and
        not AsyncEntryAnnotationRule::needs_reentrant_diagnostic(true, true)

def non_async_function_needs_no_async_entry_annotations(segment_agnostic: bool, segment_establishing: bool, reentrant_safe: bool) -> bool:
    ensure result == true
    return not AsyncEntryAnnotationRule::needs_segment_diagnostic(false, segment_agnostic, segment_establishing) and
        not AsyncEntryAnnotationRule::needs_reentrant_diagnostic(false, reentrant_safe)
