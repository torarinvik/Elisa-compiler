# False endpoint claims must remain unprovable; these are negative proof controls.
def proof_rc_min(a: i64, b: i64) -> i64:
    ensure result <= a and result <= b
    ensure result == a or result == b
    return a if a < b else b

def proof_rc_max(a: i64, b: i64) -> i64:
    ensure result >= a and result >= b
    ensure result == a or result == b
    return a if a > b else b

def min_strictly_exceeds_left_is_refused() -> bool:
    ensure result == true
    return proof_rc_min(0, 1) > 0

def max_strictly_precedes_right_is_refused() -> bool:
    ensure result == true
    return proof_rc_max(0, 1) < 1
