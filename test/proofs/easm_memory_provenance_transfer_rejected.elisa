include "easm_memory_provenance_transfer.elisa"

def false_claim_move_invents_provenance_from_an_untracked_source(old_destination: bool) -> bool:
    requires old_destination
    ensure result == true
    return provenance_destination_after(PROV_MOVE, false, true, true, false, false, old_destination, false)

def false_claim_unknown_write_preserves_stale_provenance(old_destination: bool) -> bool:
    requires old_destination
    ensure result == true
    return provenance_destination_after(PROV_CLOBBER, false, false, true, false, false, old_destination, false)

def false_claim_arithmetic_destroys_valid_pointer_provenance(old_destination: bool) -> bool:
    requires old_destination
    ensure result == false
    return provenance_destination_after(PROV_ADD, false, false, true, false, false, old_destination, false)

def false_claim_xchg_without_destination_preserves_the_source(old_source: bool) -> bool:
    requires old_source
    ensure result == true
    return provenance_source_after(PROV_XCHG, false, true, false, old_source, false)

def false_claim_call_preserves_caller_saved_provenance(old_provenance: bool) -> bool:
    requires old_provenance
    ensure result == true
    return provenance_after_implicit_clobber(true, old_provenance)

def false_claim_defined_implicit_result_preserves_old_provenance(old_provenance: bool) -> bool:
    requires old_provenance
    ensure result == true
    return provenance_after_implicit_clobber(true, old_provenance)

def false_claim_partial_move_copies_pointer_provenance(old_source: bool, old_destination: bool) -> bool:
    requires old_source and old_destination
    ensure result == true
    return provenance_destination_after(PROV_PARTIAL_MOVE, false, true, true, false, old_source, old_destination, false)

def false_claim_partial_exchange_preserves_source(old_source: bool, old_destination: bool) -> bool:
    requires old_source and old_destination
    ensure result == true
    return provenance_source_after(PROV_PARTIAL_XCHG, false, true, true, old_source, old_destination)

def false_claim_partial_exchange_preserves_destination(old_source: bool, old_destination: bool) -> bool:
    requires old_source and old_destination
    ensure result == true
    return provenance_destination_after(PROV_PARTIAL_XCHG, false, true, true, false, old_source, old_destination, false)
