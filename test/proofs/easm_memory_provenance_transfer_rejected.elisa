include "easm_memory_provenance_transfer.elisa"

def false_claim_move_invents_provenance_from_an_untracked_source(old_destination: bool) -> bool:
    requires old_destination
    ensure result == true
    return provenance_destination_after(PROV_MOVE, false, true, true, false, false, old_destination, false)

def false_claim_unknown_write_preserves_stale_provenance(old_destination: bool) -> bool:
    requires old_destination
    ensure result == true
    return provenance_destination_after(PROV_CLOBBER, false, false, true, false, false, old_destination, false)

def false_claim_arithmetic_destroys_valid_pointer_provenance(old_destination: bool) -> bool:
    requires old_destination
    ensure result == false
    return provenance_destination_after(PROV_ADD, false, false, true, false, false, old_destination, false)

def false_claim_xchg_without_destination_preserves_the_source(old_source: bool) -> bool:
    requires old_source
    ensure result == true
    return provenance_source_after(PROV_XCHG, false, true, false, old_source, false)
