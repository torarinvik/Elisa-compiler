# Boundary proofs complement the ordinary examples in parser_integer_literal.elisa.
module Parser:
    private:
        const INTEGER_LITERAL_BOUNDARY_PROOF_SCOPE: bool = true

include "../../src/parser/parser_integer_literal.elisa"

extend Parser:
    public:
        def proof_decode_integer_literal_boundary(text: sview) -> i64:
            return parse_int_literal_value(text)

def decimal_i64_max_is_preserved() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal_boundary("9223372036854775807") == 9223372036854775807

def decimal_above_i64_max_reinterprets_as_i64_min() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal_boundary("9223372036854775808") == (-9223372036854775807 - 1)

def hexadecimal_u64_max_reinterprets_as_i64_minus_one() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal_boundary("0xffffffffffffffff") == -1

def hexadecimal_u64_overflow_saturates_to_i64_minus_one() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal_boundary("0x10000000000000000") == -1

def hexadecimal_separators_preserve_the_value() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal_boundary("0xFF_FF") == 65535
