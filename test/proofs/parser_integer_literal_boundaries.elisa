# Boundary proofs complement the ordinary examples in parser_integer_literal.elisa.
module Parser:
    private:
        const INTEGER_LITERAL_BOUNDARY_PROOF_SCOPE: bool = true

include "../../src/parser/parser_integer_literal.elisa"

extend Parser:
    public:
        def proof_decode_integer_literal_boundary(text: sview) -> i64:
            return parse_int_literal_value(text)

        ghost def proof_decode_integer_literal_reference(text: sview) -> i64:
            return parse_int_literal_reference(text)

        # Once the unsigned accumulator reaches its cap, any suffix composed only
        # of valid digits and separators keeps it at the cap. This inductively checks
        # the overflow defense independently of the production loop refinement.
        ghost def proof_saturated_suffix_from(text: sview, index: usize, is_hex: bool) -> bool:
            requires index <= text.len
            requires (forall suffix_index in index..<text.len:
                text[suffix_index] == 95
                or (text[suffix_index] >= 48 and text[suffix_index] <= 57)
                or (is_hex and text[suffix_index] >= 97 and text[suffix_index] <= 102)
                or (is_hex and text[suffix_index] >= 65 and text[suffix_index] <= 70)
            )
            decreases text.len - index
            ensure result == true
            ensure parse_int_literal_reference_from(text, index, is_hex, 18446744073709551615u64) == 18446744073709551615u64
            return true if index == text.len
            byte: u8 = text[index]
            return proof_saturated_suffix_from(text, index + 1, is_hex) if byte == 95
            digit: i64 = (byte - 48).i64() if byte >= 48 and byte <= 57 else (byte - 97 + 10).i64() if byte >= 97 and byte <= 102 else (byte - 65 + 10).i64()
            base: u64 = 16 if is_hex else 10
            maximum: u64 = 18446744073709551615u64
            assert maximum >= digit.u64()
            assert base >= 2
            assert maximum > (maximum - digit.u64()) / base
            return proof_saturated_suffix_from(text, index + 1, is_hex)

def production_integer_decoder_matches_recursive_reference_for_every_text(text: sview) -> bool:
    ensure result == true
    ensure Parser::proof_decode_integer_literal_boundary(text) == Parser::proof_decode_integer_literal_reference(text)
    return true

def decimal_i64_max_is_preserved() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal_boundary("9223372036854775807") == 9223372036854775807

def decimal_above_i64_max_reinterprets_as_i64_min() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal_boundary("9223372036854775808") == (-9223372036854775807 - 1)

def hexadecimal_u64_max_reinterprets_as_i64_minus_one() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal_boundary("0xffffffffffffffff") == -1

def hexadecimal_u64_overflow_saturates_to_i64_minus_one() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal_boundary("0x10000000000000000") == -1

def decimal_u64_overflow_saturates_to_i64_minus_one() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal_boundary("18446744073709551616") == -1

def hexadecimal_separators_preserve_the_value() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal_boundary("0xFF_FF") == 65535

def every_single_ascii_decimal_digit_decodes_exactly(text: sview) -> bool:
    requires text.len == 1 and text[0] >= 48 and text[0] <= 57
    ensure result == true
    ensure Parser::proof_decode_integer_literal_boundary(text) == (text[0] - 48).i64()
    return true

def every_two_ascii_decimal_digits_decode_exactly(text: sview) -> bool:
    requires text.len == 2 and text[0] >= 48 and text[0] <= 57 and text[1] >= 48 and text[1] <= 57
    ensure result == true
    ensure Parser::proof_decode_integer_literal_boundary(text) == ((text[0] - 48).i64() * 10 + (text[1] - 48).i64())
    return true

def every_three_ascii_decimal_digits_decode_exactly(text: sview) -> bool:
    requires text.len == 3 and text[0] >= 48 and text[0] <= 57 and text[1] >= 48 and text[1] <= 57 and text[2] >= 48 and text[2] <= 57
    ensure result == true
    ensure Parser::proof_decode_integer_literal_boundary(text) == ((text[0] - 48).i64() * 100 + (text[1] - 48).i64() * 10 + (text[2] - 48).i64())
    return true

def proof_hex_digit_value(byte: u8) -> i64:
    requires (byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 102) or (byte >= 65 and byte <= 70)
    ensure result == ((byte - 48).i64() if byte >= 48 and byte <= 57 else (byte - 87).i64() if byte >= 97 and byte <= 102 else (byte - 55).i64())
    return (byte - 48).i64() if byte >= 48 and byte <= 57 else (byte - 87).i64() if byte >= 97 and byte <= 102 else (byte - 55).i64()

def every_two_ascii_hex_digits_decode_exactly(text: sview) -> bool:
    requires text.len == 4 and text[0] == 48 and (text[1] == 120 or text[1] == 88) and ((text[2] >= 48 and text[2] <= 57) or (text[2] >= 97 and text[2] <= 102) or (text[2] >= 65 and text[2] <= 70)) and ((text[3] >= 48 and text[3] <= 57) or (text[3] >= 97 and text[3] <= 102) or (text[3] >= 65 and text[3] <= 70))
    ensure result == true
    ensure Parser::proof_decode_integer_literal_boundary(text) == (proof_hex_digit_value(text[2]) * 16 + proof_hex_digit_value(text[3]))
    return true

def every_hex_decimal_digit_decodes_exactly(text: sview) -> bool:
    requires text.len == 3 and text[0] == 48 and (text[1] == 120 or text[1] == 88) and text[2] >= 48 and text[2] <= 57
    ensure result == true
    ensure Parser::proof_decode_integer_literal_boundary(text) == (text[2] - 48).i64()
    return true

def every_lowercase_hex_letter_decodes_exactly(text: sview) -> bool:
    requires text.len == 3 and text[0] == 48 and (text[1] == 120 or text[1] == 88) and text[2] >= 97 and text[2] <= 102
    ensure result == true
    ensure Parser::proof_decode_integer_literal_boundary(text) == (text[2] - 87).i64()
    return true

def every_uppercase_hex_letter_decodes_exactly(text: sview) -> bool:
    requires text.len == 3 and text[0] == 48 and (text[1] == 120 or text[1] == 88) and text[2] >= 65 and text[2] <= 70
    ensure result == true
    ensure Parser::proof_decode_integer_literal_boundary(text) == (text[2] - 55).i64()
    return true
