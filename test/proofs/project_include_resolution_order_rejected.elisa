# These false claims guard candidate precedence and the not-found result.
include "./project_include_resolution_order.elisa"

def a_configured_directory_beats_the_including_directory(configured_available: darray[bool]&) -> bool:
    requires configured_available.count > 0.usize() and configured_available[0.usize()]
    ensures result == true
    selected: (found: bool, index: usize) = choose_include_candidate(true, configured_available)
    return selected.index == 1.usize()

def a_later_configured_directory_beats_the_first(configured_available: darray[bool]&) -> bool:
    requires configured_available.count > 1.usize()
    requires not configured_available[0.usize()] and configured_available[1.usize()]
    ensures result == true
    selected: (found: bool, index: usize) = choose_include_candidate(false, configured_available)
    return selected.index == 1.usize()

def absent_include_candidates_produce_a_path(configured_available: darray[bool]&) -> bool:
    requires forall candidate in 0..<configured_available.count: not configured_available[candidate]
    ensures result == true
    selected: (found: bool, index: usize) = choose_include_candidate(false, configured_available)
    return selected.found
