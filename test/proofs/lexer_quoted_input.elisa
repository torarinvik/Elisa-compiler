# Kernel-checked classification laws for quoted string and character scanning.
include "../../src/lexer/lexer_quoted_input_policy.elisa"

def quoted_terminator_has_priority(character: char, terminator: char, at_source_end: bool, next_is_newline: bool) -> bool:
    requires character == terminator
    ensure result == true
    return LexerQuotedInputPolicy::classify(character, terminator, at_source_end, next_is_newline) == LexerQuotedInputPolicy::QuotedClass.Terminator

def newline_stops_quoted_scanning(character: char, terminator: char, at_source_end: bool, next_is_newline: bool) -> bool:
    requires character == '\n' and character != terminator
    ensure result == true
    return LexerQuotedInputPolicy::classify(character, terminator, at_source_end, next_is_newline) == LexerQuotedInputPolicy::QuotedClass.Newline

def trailing_backslash_is_escape_terminator(character: char, terminator: char, at_source_end: bool, next_is_newline: bool) -> bool:
    requires character == '\\' and character != terminator
    requires at_source_end or next_is_newline
    ensure result == true
    return LexerQuotedInputPolicy::classify(character, terminator, at_source_end, next_is_newline) == LexerQuotedInputPolicy::QuotedClass.EscapeTerm

def ordinary_backslash_skips_next_character(character: char, terminator: char, at_source_end: bool, next_is_newline: bool) -> bool:
    requires character == '\\' and character != terminator
    requires not at_source_end and not next_is_newline
    ensure result == true
    return LexerQuotedInputPolicy::classify(character, terminator, at_source_end, next_is_newline) == LexerQuotedInputPolicy::QuotedClass.Escape

def ordinary_quoted_character_is_other(character: char, terminator: char, at_source_end: bool, next_is_newline: bool) -> bool:
    requires character != terminator and character != '\n' and character != '\\'
    ensure result == true
    return LexerQuotedInputPolicy::classify(character, terminator, at_source_end, next_is_newline) == LexerQuotedInputPolicy::QuotedClass.Other

def quoted_classifier_is_total(character: char, terminator: char, at_source_end: bool, next_is_newline: bool) -> bool:
    ensure result == true
    classification: LexerQuotedInputPolicy::QuotedClass = LexerQuotedInputPolicy::classify(character, terminator, at_source_end, next_is_newline)
    return (
        classification == LexerQuotedInputPolicy::QuotedClass.Terminator
        or classification == LexerQuotedInputPolicy::QuotedClass.Newline
        or classification == LexerQuotedInputPolicy::QuotedClass.EscapeTerm
        or classification == LexerQuotedInputPolicy::QuotedClass.Escape
        or classification == LexerQuotedInputPolicy::QuotedClass.Other
    )

def unclosed_identifier_prefix_is_loop_label(next_is_identifier_start: bool, closes_character_literal: bool) -> bool:
    requires next_is_identifier_start and not closes_character_literal
    ensure result == true
    return LexerQuotedInputPolicy::char_prefix_is_loop_label(next_is_identifier_start, closes_character_literal)

def closed_single_character_prefix_is_not_loop_label(next_is_identifier_start: bool, closes_character_literal: bool) -> bool:
    requires next_is_identifier_start and closes_character_literal
    ensure result == false
    return LexerQuotedInputPolicy::char_prefix_is_loop_label(next_is_identifier_start, closes_character_literal)

def non_identifier_prefix_is_not_loop_label(next_is_identifier_start: bool, closes_character_literal: bool) -> bool:
    requires not next_is_identifier_start
    ensure result == false
    return LexerQuotedInputPolicy::char_prefix_is_loop_label(next_is_identifier_start, closes_character_literal)
