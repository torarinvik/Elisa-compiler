# `FmtUnparse.fmt_expr` narrows this computed digit to u8 in its positive-value loop.
def decimal_digit_value_is_ascii(remaining: i64) -> i64:
    requires remaining > 0
    ensure result >= 48
    ensure result <= 57
    return 48 + (remaining % 10)

def positive_remainder_is_digit(remaining: i64) -> i64:
    requires remaining > 0
    ensure result >= 0
    ensure result < 10
    return remaining % 10

def decimal_quotient_decreases(remaining: i64) -> i64:
    requires remaining > 0
    ensure result >= 0
    ensure result < remaining
    return remaining / 10
