include "../../src/semantic/ownership_flow_domain.elisa"

# Exit-edge laws, not a proof of the Go/Elisa AST traversal or jump resolver.
# The zero-iteration entry and every reachable body/jump predecessor contribute.
def loop_exit_possible(entry: bool, body_live: bool, body: bool, jump_live: bool, jump: bool) -> bool:
    ensure result == (entry or ((body_live and body) or (jump_live and jump)))
    return OwnershipFlow::join_possible(entry, OwnershipFlow::join_reachable_possible(body_live, body, jump_live, jump))

def jump_state_survives(entry: bool, body_live: bool, body: bool) -> bool:
    ensure result == true
    return loop_exit_possible(entry, body_live, body, true, true)

def dead_jump_does_not_add_state(entry: bool, body_live: bool, body: bool, jump: bool) -> bool:
    ensure result == (entry or (body_live and body))
    return loop_exit_possible(entry, body_live, body, false, jump)

def entry_survives_jump_exit(body_live: bool, body: bool, jump_live: bool, jump: bool) -> bool:
    ensure result == true
    return loop_exit_possible(true, body_live, body, jump_live, jump)

def loop_exit_known(entry: bool, body_live: bool, body: bool, jump_live: bool, jump: bool) -> bool:
    ensure result == (entry and ((not body_live or body) and (not jump_live or jump)))
    return OwnershipFlow::join_known(entry, OwnershipFlow::join_known(not body_live or body, not jump_live or jump))

def unknown_jump_blocks_exit_knowledge(entry: bool, body_live: bool, body: bool) -> bool:
    ensure result == false
    return loop_exit_known(entry, body_live, body, true, false)

def dead_jump_preserves_exit_knowledge(entry: bool, body_live: bool, body: bool, jump: bool) -> bool:
    ensure result == (entry and (not body_live or body))
    return loop_exit_known(entry, body_live, body, false, jump)
