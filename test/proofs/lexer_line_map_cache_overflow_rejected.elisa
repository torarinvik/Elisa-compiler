# False control: a non-ready state must not select the partial cache.
include "./lexer_line_map_cache_overflow.elisa"

def nonready_state_uses_partial_cache(state: i64, cached_result: i64, parsed_result: i64) -> bool:
    requires state != LINE_MAP_CACHE_READY
    ensure result == true
    return (cached_result if state == LINE_MAP_CACHE_READY else parsed_result) == cached_result
