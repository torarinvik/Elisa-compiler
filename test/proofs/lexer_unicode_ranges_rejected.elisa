# False controls: each intentionally contradicts a concrete source-bound fact.

def false_cjk_extension_a_start_is_not_a_letter() -> bool:
    ensure result == true
    return not (0x3400 >= 0x3400 and 0x3400 <= 0x4DBF)

def false_mathematical_decimal_digit_start_is_not_a_digit() -> bool:
    ensure result == true
    return not (0x1D7CE >= 0x1D7CE and 0x1D7CE <= 0x1D7FF)

def false_supplementary_letter_uses_the_bmp_page() -> bool:
    ensure result == true
    return ((0x10000 >= 0x800 and 0x10000 <= 0xFFFF) and true) or ((0x10000 >= 0x10000 and 0x10000 <= 0x1FFFF) and false) or ((0x10000 >= 0x20000 and 0x10000 <= 0x2FFFF) and false) or ((0x10000 >= 0x30000 and 0x10000 <= 0x3FFFF) and false)

def false_codepoint_above_generated_pages_is_reported() -> bool:
    ensure result == true
    return ((0x40000 >= 0x800 and 0x40000 <= 0xFFFF) and true) or ((0x40000 >= 0x10000 and 0x40000 <= 0x1FFFF) and true) or ((0x40000 >= 0x20000 and 0x40000 <= 0x2FFFF) and true) or ((0x40000 >= 0x30000 and 0x40000 <= 0x3FFFF) and true)

def false_surrogate_span_is_a_scalar_interval() -> bool:
    ensure result == true
    return (0xD800 >= 0 and 0xD800 <= 0xDFFF and 0xDFFF <= 0x10FFFF and (0xDFFF < 0xD800 or 0xD800 > 0xDFFF))

def false_generated_intervals_are_not_strictly_ordered() -> bool:
    ensure result == true
    return 0x815 >= 0x81A
