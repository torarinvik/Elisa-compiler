# Arithmetic contracts for the literal-bound cases in Semantic.is_empty_range.
# The source checker pins these three formulas to the compiler's TokenKind branches.
def proof_empty_lt(a: i64, b: i64) -> bool:
    ensure result == (a >= b)
    return a >= b

def lt_empty_if_reversed(a: i64, b: i64) -> bool:
    requires a >= b
    ensure result == true
    return proof_empty_lt(a, b)

def lt_nonempty_if_ordered(a: i64, b: i64) -> bool:
    requires a < b
    ensure result == true
    return not proof_empty_lt(a, b)

def proof_empty_le(a: i64, b: i64) -> bool:
    ensure result == (a > b)
    return a > b

def le_empty_if_reversed(a: i64, b: i64) -> bool:
    requires a > b
    ensure result == true
    return proof_empty_le(a, b)

def le_nonempty_if_ordered_or_equal(a: i64, b: i64) -> bool:
    requires a <= b
    ensure result == true
    return not proof_empty_le(a, b)

def proof_empty_gt(a: i64, b: i64) -> bool:
    ensure result == (a <= b)
    return a <= b

def gt_empty_if_forward_or_equal(a: i64, b: i64) -> bool:
    requires a <= b
    ensure result == true
    return proof_empty_gt(a, b)

def gt_nonempty_if_reversed(a: i64, b: i64) -> bool:
    requires a > b
    ensure result == true
    return not proof_empty_gt(a, b)
