# False controls for the name-index exemption, marker owner, and nonempty-name guard.
include "../../src/semantic/default_param_ref_policy.elisa"

def a_globally_indexed_default_reference_is_reported() -> bool:
    ensure result == true
    return DefaultParamRefPolicy::should_report("__default_param_ref", "global_value", true)

def an_ordinary_annotation_owner_is_reported() -> bool:
    ensure result == true
    return DefaultParamRefPolicy::should_report("ordinary_annotation", "x", false)

def an_empty_default_reference_name_is_reported() -> bool:
    ensure result == true
    return DefaultParamRefPolicy::should_report("__default_param_ref", "", false)
