# Deliberately false range claims must remain unproved.
include "./const_float_cast_range.elisa"

def false_claim_negative_i8_overflow_is_in_range() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not ConstFloatCastRange::cast_out_of_range("i8", true, "129.0", 64)

def false_claim_negative_i64_overflow_is_in_range() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not ConstFloatCastRange::cast_out_of_range("i64", true, "9223372036854777856.0", 64)

def false_claim_negative_unsigned_cast_is_in_range() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not ConstFloatCastRange::cast_out_of_range("u32", true, "1.0", 64)

def false_claim_negative_unsigned_fraction_is_out_of_range() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return ConstFloatCastRange::cast_out_of_range("u32", true, "0.9", 64)

def false_claim_wasm32_usize_overflow_is_in_range() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not ConstFloatCastRange::cast_out_of_range("usize", false, "4294967296.0", 32)

def false_claim_double_minus_is_negative() -> bool:
    ensure result == true
    return ConstFloatCastRange::negative_after_unary(true, ConstFloatCastRange::negative_after_unary(true, false))

def false_claim_exponent_overflow_is_in_range() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not ConstFloatCastRange::cast_out_of_range("i8", false, "1e100", 64)

def false_claim_positive_rounding_adjacent_cast_is_safe() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not ConstFloatCastRange::cast_out_of_range("i8", false, "127.999999999999999", 64)

def false_claim_negative_rounding_adjacent_cast_is_safe() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not ConstFloatCastRange::cast_out_of_range("i8", true, "128.99999999999999", 64)
