include "../../src/backend/codegen_const_capacity_precedence.elisa"

def equal_precedence_operator_is_admitted_into_right_operand() -> bool:
    ensure result == true
    return 5 >= 6

def unsupported_operator_is_admitted_at_top_level() -> bool:
    ensure result == true
    return -1 >= 0

def unconsumed_capacity_suffix_is_accepted(cursor: i64, length: i64) -> bool:
    requires cursor >= 0 and cursor < length
    ensure result == true
    return cursor == length
