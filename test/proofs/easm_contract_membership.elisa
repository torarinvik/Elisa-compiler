# Model exact contract membership and the raw-memory-base guard.
def model_raw_memory_base_rejected(raw_scalar: bool, exact_untyped_opt_out: bool) -> bool:
    ensure result == (raw_scalar and not exact_untyped_opt_out)
    return raw_scalar and not exact_untyped_opt_out

def exact_contract_member_is_recognized(exact_member: bool) -> bool:
    requires exact_member == true
    ensure result == true
    return exact_member

def substring_only_is_not_an_exact_contract_member(exact_member: bool, substring_only: bool) -> bool:
    requires substring_only == true and exact_member == false
    ensure result == false
    return exact_member

def raw_memory_base_requires_exact_opt_out(raw_scalar: bool, exact_untyped_opt_out: bool) -> bool:
    requires raw_scalar and not exact_untyped_opt_out
    ensure result == true
    return model_raw_memory_base_rejected(raw_scalar, exact_untyped_opt_out)

def substring_decoy_does_not_exempt_raw_memory_base(raw_scalar: bool, exact_untyped_opt_out: bool, substring_decoy: bool) -> bool:
    requires raw_scalar and not exact_untyped_opt_out and substring_decoy
    ensure result == true
    return model_raw_memory_base_rejected(raw_scalar, exact_untyped_opt_out)

def exact_opt_out_exempts_raw_memory_base(raw_scalar: bool, exact_untyped_opt_out: bool) -> bool:
    requires raw_scalar and exact_untyped_opt_out
    ensure result == false
    return model_raw_memory_base_rejected(raw_scalar, exact_untyped_opt_out)

def typed_pointer_is_not_rejected_by_raw_guard(raw_scalar: bool, exact_untyped_opt_out: bool) -> bool:
    requires not raw_scalar
    ensure result == false
    return model_raw_memory_base_rejected(raw_scalar, exact_untyped_opt_out)

def model_register_contract_member(exact_token: bool, exact_binding: bool) -> bool:
    ensure result == (exact_token or exact_binding)
    return exact_token or exact_binding

def exact_register_token_is_recognized(exact_token: bool) -> bool:
    requires exact_token
    ensure result == true
    return model_register_contract_member(exact_token, false)

def named_register_binding_is_recognized(exact_binding: bool) -> bool:
    requires exact_binding
    ensure result == true
    return model_register_contract_member(false, exact_binding)

def substring_register_decoy_is_not_recognized(exact_token: bool, exact_binding: bool, substring_decoy: bool) -> bool:
    requires not exact_token and not exact_binding and substring_decoy
    ensure result == false
    return model_register_contract_member(exact_token, exact_binding)

def delimiter_successor_stays_within_view(end: usize, length: usize) -> bool:
    requires end < length
    ensure result == true
    return end + 1 <= length
