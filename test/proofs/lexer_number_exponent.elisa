# The numeric scanner accepts an exponent tail only after a digit, optionally signed.
include "../../src/lexer/lexer_number_exponent.elisa"

def every_decimal_digit_starts_a_valid_exponent_tail(character: char) -> bool:
    requires character in '0'..='9'
    ensure result == true
    return LexerNumberExponent::follows(character, 'x')

def signed_exponent_tail_matches_the_following_digit(sign: char, following: char) -> bool:
    requires sign == '+' or sign == '-'
    ensure result == (following in '0'..='9')
    return LexerNumberExponent::follows(sign, following)

def plus_sign_followed_by_digit_is_valid() -> bool:
    ensure result == true
    return LexerNumberExponent::follows('+', '9')

def minus_sign_followed_by_digit_is_valid() -> bool:
    ensure result == true
    return LexerNumberExponent::follows('-', '0')

def either_sign_without_a_digit_is_invalid(sign: char) -> bool:
    requires sign == '+' or sign == '-'
    ensure result == true
    return not LexerNumberExponent::follows(sign, 'x')

def a_non_digit_non_sign_cannot_start_an_exponent_tail(first: char, second: char) -> bool:
    requires not (first in '0'..='9') and first != '+' and first != '-'
    ensure result == true
    return not LexerNumberExponent::follows(first, second)

def exponent_marker_letter_is_not_a_digit_tail() -> bool:
    ensure result == true
    return not LexerNumberExponent::follows('e', '5')

def non_ascii_decimal_digit_is_not_an_exponent_digit() -> bool:
    ensure result == true
    return not LexerNumberExponent::follows('١', 'x')
