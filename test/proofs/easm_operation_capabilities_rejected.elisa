# False capability classifications must remain unproved.
include "./easm_operation_capabilities.elisa"

def ordinary_move_requires_atomic_rmw() -> bool:
    ensure result == true
    return OP_ORDINARY == OP_XCHG and CAP_ATOMIC_RMW == 1

def xchg_does_not_require_an_atomic_capability() -> bool:
    ensure result == true
    return CAP_ATOMIC_RMW == CAP_NONE

def yield_requires_the_x86_counter_capability() -> bool:
    ensure result == true
    return OP_YIELD == OP_RDTSC and CAP_COUNTER == CAP_RDTSC
