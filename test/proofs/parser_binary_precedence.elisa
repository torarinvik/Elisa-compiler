# Source-linked arithmetic laws for the production parser's binding powers.

def precedence_levels_are_strictly_ordered(arrow_or: i64, logical_and: i64, comparison: i64, range: i64, bitwise_or: i64, bitwise_xor: i64, bitwise_and: i64, shift: i64, additive: i64, multiplicative: i64) -> bool:
    requires arrow_or == 1 and logical_and == 2 and comparison == 3 and range == 4 and bitwise_or == 5 and bitwise_xor == 6 and bitwise_and == 7 and shift == 8 and additive == 9 and multiplicative == 10
    ensure result == true
    return arrow_or < logical_and and logical_and < comparison and comparison < range and range < bitwise_or and bitwise_or < bitwise_xor and bitwise_xor < bitwise_and and bitwise_and < shift and shift < additive and additive < multiplicative

def comparison_is_tighter_than_boolean_connectives(logical_or: i64, logical_and: i64, comparison: i64) -> bool:
    requires logical_or == 1 and logical_and == 2 and comparison == 3
    ensure result == true
    return logical_or < logical_and and logical_and < comparison

def range_binds_inside_membership_rhs(comparison: i64, range: i64) -> bool:
    requires comparison == 3 and range == 4
    ensure result == true
    return comparison < range

def bitwise_levels_are_distinct_and_ordered(bitwise_or: i64, bitwise_xor: i64, bitwise_and: i64, shift: i64) -> bool:
    requires bitwise_or == 5 and bitwise_xor == 6 and bitwise_and == 7 and shift == 8
    ensure result == true
    return bitwise_or < bitwise_xor and bitwise_xor < bitwise_and and bitwise_and < shift

def arithmetic_levels_match_expected_order(shift: i64, additive: i64, multiplicative: i64) -> bool:
    requires shift == 8 and additive == 9 and multiplicative == 10
    ensure result == true
    return shift < additive and additive < multiplicative

def unrecognized_tokens_stop_at_precedence_zero(unknown: i64, minimum: i64) -> bool:
    requires unknown == 0 and minimum == 1
    ensure result == true
    return unknown < minimum

def equal_precedence_operator_is_excluded_from_right_operand(level: i64) -> bool:
    requires level >= 1 and level <= 10
    ensure result == true
    return level < level + 1

def tighter_operator_is_consumed_by_right_operand(outer: i64, inner: i64) -> bool:
    requires outer >= 1 and outer <= 10
    requires inner > outer and inner <= 10
    ensure result == true
    return inner >= outer + 1

def weaker_operator_is_excluded_from_right_operand(outer: i64, inner: i64) -> bool:
    requires outer >= 1 and outer <= 10
    requires inner >= 0 and inner < outer
    ensure result == true
    return inner < outer + 1

def prefix_not_uses_comparison_threshold(logical_and: i64, comparison: i64, threshold: i64) -> bool:
    requires logical_and == 2 and comparison == 3 and threshold == 3
    ensure result == true
    return comparison >= threshold and logical_and < threshold
