include "./lexer_line_map_path_classifier_model.elisa"

def a_full_marker_with_exact_bytes_after_separator_is_a_component() -> bool:
    ensure result == true
    return component_candidate_matches_exact_runtime_marker(101, 108, 105, 115, 97, 99, 111, 114, 101, 95, 115, 116, 100, 47, true, true)

def a_marker_with_one_mismatched_byte_is_rejected() -> bool:
    ensure result == false
    return component_candidate_matches_exact_runtime_marker(101, 108, 105, 115, 97, 99, 111, 114, 101, 95, 115, 116, 100, 46, true, true)

def a_marker_at_the_path_start_is_rejected() -> bool:
    ensure result == false
    return component_candidate_matches_exact_runtime_marker(101, 108, 105, 115, 97, 99, 111, 114, 101, 95, 115, 116, 100, 47, false, true)

def a_marker_without_a_preceding_separator_is_rejected() -> bool:
    ensure result == false
    return component_candidate_matches_exact_runtime_marker(101, 108, 105, 115, 97, 99, 111, 114, 101, 95, 115, 116, 100, 47, true, false)
