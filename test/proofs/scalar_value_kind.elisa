# Source-linked proof of the closed scalar value-kind set used by semantic diagnostics.
include "../../src/semantic/scalar_value_kind.elisa"

def source_classifier_has_exact_scalar_set(kind: sview) -> bool can[Abort.Panic]:
    ensure result == (
        when kind:
            "int" | "float" | "bool" | "char" | "string" -> true
            _ -> false
    )
    can Abort.Panic:
        return ScalarValueKind::is_scalar_value_kind(kind)

def every_scalar_value_kind_is_recognized() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            ScalarValueKind::is_scalar_value_kind("int")
            and ScalarValueKind::is_scalar_value_kind("float")
            and ScalarValueKind::is_scalar_value_kind("bool")
            and ScalarValueKind::is_scalar_value_kind("char")
            and ScalarValueKind::is_scalar_value_kind("string")
        )

def non_scalar_types_remain_unclassified() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            not ScalarValueKind::is_scalar_value_kind("i64")
            and not ScalarValueKind::is_scalar_value_kind("darray")
            and not ScalarValueKind::is_scalar_value_kind("void")
        )
