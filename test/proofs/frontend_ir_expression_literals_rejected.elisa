# False schema claims for scalar expression literal encodings.
include "../../src/driver/frontend_ir_expression_literal_encoding.elisa"

def boolean_literal_cannot_use_the_integer_node_type() -> bool:
    ensure result == true
    return FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.BoolLit) == FrontendIrExpressionLiteralEncoding::INT_LIT_NODE_TYPE_ID

def integer_literal_cannot_use_the_boolean_payload_field() -> bool:
    ensure result == true
    return FrontendIrExpressionLiteralEncoding::value_field_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.IntLit) == FrontendIrExpressionLiteralEncoding::BOOL_LIT_VALUE_FIELD_ID

def shared_payload_slot_does_not_identify_the_literal_node() -> bool:
    ensure result == true
    return (
        FrontendIrExpressionLiteralEncoding::value_field_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.StringLit)
            == FrontendIrExpressionLiteralEncoding::value_field_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.CharLit)
        and FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.StringLit)
            == FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.CharLit)
    )

def string_literal_cannot_use_boolean_payload_wire_type() -> bool:
    ensure result == true
    return FrontendIrExpressionLiteralEncoding::value_wire_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.StringLit)
        == FrontendIrExpressionLiteralEncoding::BOOL_VALUE_WIRE_TYPE_ID
