# Source-linked proof of the exact contextual `where` keyword classifier.
include "../../src/parser/parser_where_suffix_keyword.elisa"

def source_where_keyword_classification_is_exact(text: sview) -> bool:
    ensure result == (
        when text:
            "where" -> true
            _ -> false
    )
    return ParserWhereSuffixKeyword::is_where_keyword(text)

def lowercase_where_is_recognized() -> bool:
    ensure result == true
    return ParserWhereSuffixKeyword::is_where_keyword("where")

def another_keyword_is_not_recognized() -> bool:
    ensure result == false
    return ParserWhereSuffixKeyword::is_where_keyword("when")

def keyword_prefix_is_not_recognized() -> bool:
    ensure result == false
    return ParserWhereSuffixKeyword::is_where_keyword("whereish")
