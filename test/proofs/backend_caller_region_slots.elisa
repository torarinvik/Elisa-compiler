# A caller cannot emit a region-bearing parameter without a non-null arena.
def caller_region_call_is_admitted(parameter_requires_region: bool, selected_arena_is_nonnull: bool) -> bool:
    ensure result == (not parameter_requires_region or selected_arena_is_nonnull)
    return not parameter_requires_region or selected_arena_is_nonnull

def missing_required_arena_rejects_call(parameter_requires_region: bool, selected_arena_is_nonnull: bool) -> bool:
    requires parameter_requires_region and not selected_arena_is_nonnull
    ensure result == false
    return not parameter_requires_region or selected_arena_is_nonnull

