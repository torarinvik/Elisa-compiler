# Deliberately false claims about the source-linked guard formulas.
include "./codegen_const_checked_arithmetic.elisa"

def positive_add_overflow_is_accepted(left: i64, right: i64) -> bool:
    requires right > 0 and left > BackendConstArithmetic::I64_MAX - right
    ensure result == true
    return BackendConstArithmetic::add_is_safe(left, right)

def negative_add_underflow_is_accepted(left: i64, right: i64) -> bool:
    requires right < 0 and left < BackendConstArithmetic::I64_MIN - right
    ensure result == true
    return BackendConstArithmetic::add_is_safe(left, right)

def positive_subtract_overflow_is_accepted(left: i64, right: i64) -> bool:
    requires right < 0 and left > BackendConstArithmetic::I64_MAX + right
    ensure result == true
    return BackendConstArithmetic::subtract_is_safe(left, right)

def negative_subtract_underflow_is_accepted(left: i64, right: i64) -> bool:
    requires right > 0 and left < BackendConstArithmetic::I64_MIN + right
    ensure result == true
    return BackendConstArithmetic::subtract_is_safe(left, right)

def multiplication_overflow_is_accepted(left: i64, right: i64) -> bool:
    requires left > 0 and right > 0 and left > BackendConstArithmetic::I64_MAX / right
    ensure result == true
    return BackendConstArithmetic::multiply_is_safe(left, right)

def positive_negative_product_overflow_is_accepted(left: i64, right: i64) -> bool:
    requires left > 0 and right < 0 and right < BackendConstArithmetic::I64_MIN / left
    ensure result == true
    return BackendConstArithmetic::multiply_is_safe(left, right)

def negative_positive_product_overflow_is_accepted(left: i64, right: i64) -> bool:
    requires left < 0 and right > 0 and left < BackendConstArithmetic::I64_MIN / right
    ensure result == true
    return BackendConstArithmetic::multiply_is_safe(left, right)

def negative_negative_product_overflow_is_accepted(left: i64, right: i64) -> bool:
    requires left < 0 and right < 0 and left < BackendConstArithmetic::I64_MAX / right
    ensure result == true
    return BackendConstArithmetic::multiply_is_safe(left, right)

def minimum_times_negative_one_is_accepted() -> bool:
    ensure result == true
    return BackendConstArithmetic::multiply_is_safe(BackendConstArithmetic::I64_MIN, -1)

def negative_one_times_minimum_is_accepted() -> bool:
    ensure result == true
    return BackendConstArithmetic::multiply_is_safe(-1, BackendConstArithmetic::I64_MIN)

def zero_division_is_accepted(left: i64) -> bool:
    ensure result == true
    return BackendConstArithmetic::division_is_safe(left, 0)

def minimum_divided_by_negative_one_is_accepted() -> bool:
    ensure result == true
    return BackendConstArithmetic::division_is_safe(BackendConstArithmetic::I64_MIN, -1)

def minimum_remainder_negative_one_is_accepted() -> bool:
    ensure result == true
    return BackendConstArithmetic::remainder_is_safe(BackendConstArithmetic::I64_MIN, -1)

def minimum_negation_is_accepted() -> bool:
    ensure result == true
    return BackendConstArithmetic::negation_is_safe(BackendConstArithmetic::I64_MIN)

def negative_shift_count_is_accepted() -> bool:
    ensure result == true
    return BackendConstArithmetic::shift_count_is_safe(-1)

def shift_count_equal_to_width_is_accepted() -> bool:
    ensure result == true
    return BackendConstArithmetic::shift_count_is_safe(BackendConstArithmetic::I64_SHIFT_WIDTH)
