# Deliberately false claims about predecessor selection and fallback cases.
include "./try_enclosing_function_index.elisa"

def false_claim_duplicate_offsets_select_the_first_position() -> bool:
    offsets: darray[u32] = [TRY_ENCLOSING_DUPLICATE_OFFSET, TRY_ENCLOSING_DUPLICATE_OFFSET]
    indexed: (found: bool, index: usize) = try_binary_predecessor(offsets, TRY_ENCLOSING_DUPLICATE_OFFSET)
    ensure result == true
    return indexed.found and indexed.index == TRY_ENCLOSING_FIRST_POSITION

def false_claim_duplicate_offsets_keep_the_first_line() -> bool:
    offsets: darray[u32] = [TRY_ENCLOSING_DUPLICATE_OFFSET, TRY_ENCLOSING_DUPLICATE_OFFSET]
    lines: darray[u32] = [TRY_ENCLOSING_FIRST_LINE, TRY_ENCLOSING_SECOND_LINE]
    indexed: (found: bool, index: usize) = try_binary_predecessor(offsets, TRY_ENCLOSING_DUPLICATE_OFFSET)
    ensure result == true
    return indexed.found and lines[indexed.index] == lines[TRY_ENCLOSING_FIRST_POSITION]

def false_claim_empty_index_has_a_predecessor() -> bool:
    offsets: darray[u32] = []
    indexed: (found: bool, index: usize) = try_binary_predecessor(offsets, TRY_ENCLOSING_NO_OFFSET)
    ensure result == true
    return indexed.found

def false_claim_no_predecessor_has_a_position(offsets: darray[u32], query: u32) -> bool:
    requires try_offsets_are_nonzero(offsets)
    requires try_offsets_are_nondecreasing(offsets)
    requires offsets.count == TRY_ENCLOSING_FIRST_POSITION or offsets[TRY_ENCLOSING_FIRST_POSITION] > query
    indexed: (found: bool, index: usize) = try_binary_predecessor(offsets, query)
    ensure result == true
    return indexed.found
