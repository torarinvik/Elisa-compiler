include "../../src/semantic/protocol_owner_domain.elisa"

def owned_protocol_value_is_eligible() -> bool:
    ensure result == true
    return ProtocolOwner::eligible(true, false, false, false, true, true, true, true)

def borrowed_alias_is_ineligible() -> bool:
    ensure result == false
    return ProtocolOwner::eligible(true, true, false, false, true, true, true, true)

def explicit_reference_is_ineligible() -> bool:
    ensure result == false
    return ProtocolOwner::eligible(true, false, true, false, true, true, true, true)

def linear_mutable_is_ineligible() -> bool:
    ensure result == false
    return ProtocolOwner::eligible(true, false, false, true, true, true, true, true)

def unknown_type_is_ineligible() -> bool:
    ensure result == false
    return ProtocolOwner::eligible(false, false, false, false, true, true, true, true)

def unknown_state_is_ineligible() -> bool:
    ensure result == false
    return ProtocolOwner::eligible(true, false, false, false, false, true, true, true)

def derived_state_is_ineligible() -> bool:
    ensure result == false
    return ProtocolOwner::eligible(true, false, false, false, true, false, true, true)

def different_family_is_ineligible() -> bool:
    ensure result == false
    return ProtocolOwner::eligible(true, false, false, false, true, true, false, true)

def copyable_value_is_ineligible() -> bool:
    ensure result == false
    return ProtocolOwner::eligible(true, false, false, false, true, true, true, false)

def every_borrowed_shape_is_ineligible(known_type: bool, explicit_borrow: bool, linear_mutable: bool, known_state: bool, protocol: bool, same_family: bool, affine: bool) -> bool:
    ensure result == false
    return ProtocolOwner::eligible(known_type, true, explicit_borrow, linear_mutable, known_state, protocol, same_family, affine)

def every_cross_family_shape_is_ineligible(known_type: bool, borrowed: bool, explicit_borrow: bool, linear_mutable: bool, known_state: bool, protocol: bool, affine: bool) -> bool:
    ensure result == false
    return ProtocolOwner::eligible(known_type, borrowed, explicit_borrow, linear_mutable, known_state, protocol, false, affine)
