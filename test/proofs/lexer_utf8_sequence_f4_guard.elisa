# Source-linked contracts for every canonical UTF-8 acceptance arm in starts_valid_utf8_sequence.
# The companion checker derives each predicate from the exact production return guard.
include "../../src/lexer/lexer_utf8_codepoint_constants.elisa"

def proof_valid_four_byte_f4_start(remaining: i64, first: i64, second: i64, third: i64, fourth: i64) -> bool:
    ensure result implies remaining > 3
    ensure result implies first == UTF8_FOUR_BYTE_LEAD_MAX
    ensure result implies second >= UTF8_CONTINUATION_MIN
    ensure result implies second <= UTF8_F4_SECOND_MAX
    ensure result implies third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX
    ensure result implies fourth >= UTF8_CONTINUATION_MIN and fourth <= UTF8_CONTINUATION_MAX
    ensure result == (remaining > 3 and second >= UTF8_CONTINUATION_MIN and second <= UTF8_F4_SECOND_MAX and (third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX) and (fourth >= UTF8_CONTINUATION_MIN and fourth <= UTF8_CONTINUATION_MAX) and (first == UTF8_FOUR_BYTE_LEAD_MAX))
    return remaining > 3 and second >= UTF8_CONTINUATION_MIN and second <= UTF8_F4_SECOND_MAX and (third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX) and (fourth >= UTF8_CONTINUATION_MIN and fourth <= UTF8_CONTINUATION_MAX) and (first == UTF8_FOUR_BYTE_LEAD_MAX)
