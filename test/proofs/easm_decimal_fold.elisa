# Prove range safety and specification refinement for repeated production decimal steps.
include "../../src/backend/easm_checked_decimal.elisa"

def positive_decimal_fold_spec(
    digits: darray[i64],
    position: usize,
    value: i64
) -> (valid: bool, value: i64):
    requires position <= digits.count and value >= 0
    decreases digits.count - position
    ensure result.valid implies result.value >= 0
    ensure result.valid implies result.value <= EasmCheckedDecimal::I64_MAX
    ensure not result.valid implies result.value == 0
    return (true, value) if position == digits.count
    digit: i64 = digits[position]
    return (false, 0) if digit < 0 or digit > EasmCheckedDecimal::MAX_DECIMAL_DIGIT
    limit: i64 = EasmCheckedDecimal::I64_MAX / EasmCheckedDecimal::DECIMAL_RADIX
    final_digit_limit: i64 = EasmCheckedDecimal::I64_MAX % EasmCheckedDecimal::DECIMAL_RADIX
    return (false, 0) if value > limit
    return (false, 0) if value == limit and digit > final_digit_limit
    next_value: i64 = value * EasmCheckedDecimal::DECIMAL_RADIX + digit
    return positive_decimal_fold_spec(digits, position + 1, next_value)

def negative_decimal_fold_spec(
    digits: darray[i64],
    position: usize,
    value: i64
) -> (valid: bool, value: i64):
    requires position <= digits.count and value <= 0
    decreases digits.count - position
    ensure result.valid implies result.value >= EasmCheckedDecimal::I64_MIN
    ensure result.valid implies result.value <= 0
    ensure not result.valid implies result.value == 0
    return (true, value) if position == digits.count
    digit: i64 = digits[position]
    return (false, 0) if digit < 0 or digit > EasmCheckedDecimal::MAX_DECIMAL_DIGIT
    limit: i64 = EasmCheckedDecimal::I64_MIN / EasmCheckedDecimal::DECIMAL_RADIX
    final_digit_limit: i64 = 0 - (EasmCheckedDecimal::I64_MIN % EasmCheckedDecimal::DECIMAL_RADIX)
    return (false, 0) if value < limit
    return (false, 0) if value == limit and digit > final_digit_limit
    next_value: i64 = value * EasmCheckedDecimal::DECIMAL_RADIX - digit
    return negative_decimal_fold_spec(digits, position + 1, next_value)

def fold_positive_decimal_digits(
    digits: darray[i64],
    position: usize,
    value: i64
) -> (valid: bool, value: i64):
    requires position <= digits.count and value >= 0
    decreases digits.count - position
    ensure result.valid implies result.value >= 0
    ensure result.valid implies result.value <= EasmCheckedDecimal::I64_MAX
    ensure not result.valid implies result.value == 0
    ensure result.valid == positive_decimal_fold_spec(digits, position, value).valid
    ensure result.value == positive_decimal_fold_spec(digits, position, value).value
    return (true, value) if position == digits.count
    digit: i64 = digits[position]
    return (false, 0) if digit < 0 or digit > EasmCheckedDecimal::MAX_DECIMAL_DIGIT
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_positive_digit(value, digit)
    return (false, 0) if not step.valid
    return fold_positive_decimal_digits(digits, position + 1, step.value)

def fold_negative_decimal_digits(
    digits: darray[i64],
    position: usize,
    value: i64
) -> (valid: bool, value: i64):
    requires position <= digits.count and value <= 0
    decreases digits.count - position
    ensure result.valid implies result.value >= EasmCheckedDecimal::I64_MIN
    ensure result.valid implies result.value <= 0
    ensure not result.valid implies result.value == 0
    ensure result.valid == negative_decimal_fold_spec(digits, position, value).valid
    ensure result.value == negative_decimal_fold_spec(digits, position, value).value
    return (true, value) if position == digits.count
    digit: i64 = digits[position]
    return (false, 0) if digit < 0 or digit > EasmCheckedDecimal::MAX_DECIMAL_DIGIT
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_negative_digit(value, digit)
    return (false, 0) if not step.valid
    return fold_negative_decimal_digits(digits, position + 1, step.value)

def positive_decimal_fold_accepts_exact_i64_max() -> bool:
    ensure result == true
    digits: darray[i64] = [9, 2, 2, 3, 3, 7, 2, 0, 3, 6, 8, 5, 4, 7, 7, 5, 8, 0, 7]
    folded: (valid: bool, value: i64) = fold_positive_decimal_digits(digits, 0, 0)
    return folded.valid and folded.value == EasmCheckedDecimal::I64_MAX

def negative_decimal_fold_accepts_exact_i64_min() -> bool:
    ensure result == true
    digits: darray[i64] = [9, 2, 2, 3, 3, 7, 2, 0, 3, 6, 8, 5, 4, 7, 7, 5, 8, 0, 8]
    folded: (valid: bool, value: i64) = fold_negative_decimal_digits(digits, 0, 0)
    return folded.valid and folded.value == EasmCheckedDecimal::I64_MIN

def positive_decimal_fold_rejects_one_past_i64_max() -> bool:
    ensure result == true
    digits: darray[i64] = [9, 2, 2, 3, 3, 7, 2, 0, 3, 6, 8, 5, 4, 7, 7, 5, 8, 0, 8]
    folded: (valid: bool, value: i64) = fold_positive_decimal_digits(digits, 0, 0)
    return not folded.valid and folded.value == 0

def negative_decimal_fold_rejects_one_below_i64_min() -> bool:
    ensure result == true
    digits: darray[i64] = [9, 2, 2, 3, 3, 7, 2, 0, 3, 6, 8, 5, 4, 7, 7, 5, 8, 0, 9]
    folded: (valid: bool, value: i64) = fold_negative_decimal_digits(digits, 0, 0)
    return not folded.valid and folded.value == 0

def positive_decimal_fold_rejects_digit_above_nine() -> bool:
    ensure result == true
    digits: darray[i64] = [10]
    folded: (valid: bool, value: i64) = fold_positive_decimal_digits(digits, 0, 0)
    return not folded.valid and folded.value == 0

def negative_decimal_fold_rejects_negative_digit() -> bool:
    ensure result == true
    digits: darray[i64] = [-1]
    folded: (valid: bool, value: i64) = fold_negative_decimal_digits(digits, 0, 0)
    return not folded.valid and folded.value == 0
