# The x86-64 eightbyte class priority is integer, double, two-float vector, float.
def x86_eightbyte_class(integer_leaves: i64, float32_leaves: i64, float64_leaves: i64) -> i64:
    requires integer_leaves >= 0 and float32_leaves >= 0 and float64_leaves >= 0
    ensure result == (0 if integer_leaves + float32_leaves + float64_leaves == 0 else 1 if integer_leaves > 0 else 2 if float64_leaves > 0 else 3 if float32_leaves >= 2 else 4)
    return 0 if integer_leaves + float32_leaves + float64_leaves == 0 else 1 if integer_leaves > 0 else 2 if float64_leaves > 0 else 3 if float32_leaves >= 2 else 4

def integer_class_dominates_mixed_leaves(integer_leaves: i64, float32_leaves: i64, float64_leaves: i64) -> i64:
    requires integer_leaves > 0 and float32_leaves >= 0 and float64_leaves >= 0
    ensure result == 1
    return 1

def double_class_dominates_float32_leaves(integer_leaves: i64, float32_leaves: i64, float64_leaves: i64) -> i64:
    requires integer_leaves == 0 and float64_leaves > 0 and float32_leaves >= 0
    ensure result == 2
    return 2

def two_float32_leaves_form_vector(integer_leaves: i64, float32_leaves: i64, float64_leaves: i64) -> i64:
    requires integer_leaves == 0 and float64_leaves == 0 and float32_leaves >= 2
    ensure result == 3
    return 3
