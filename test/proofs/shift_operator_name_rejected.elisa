include "./shift_operator_name.elisa"

def addition_must_not_be_a_shift_operator() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return ShiftOperatorName::is_shift_operator(Lexer::TokenKind.Plus)

def compound_left_shift_must_not_be_a_plain_shift_operator() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return ShiftOperatorName::is_shift_operator(Lexer::TokenKind.LShiftEq)

def modulo_must_not_be_a_shift_operator() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return ShiftOperatorName::is_shift_operator(Lexer::TokenKind.Percent)
