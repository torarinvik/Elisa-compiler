# Cursor-variant and delimiter-step facts for production comment scanning.
include "../../src/lexer/lexer_comment_scan.elisa"

def remaining_input_is_nonnegative(position: usize, source_length: usize) -> bool:
    requires position <= source_length
    ensure result == true
    return LexerCommentScan::remaining(source_length, position) <= source_length

def line_comment_step_advances_by_one(position: usize, source_length: usize) -> bool:
    requires position < source_length
    ensure result == true
    return LexerCommentScan::after_one(position, source_length) == position + 1

def line_comment_step_stays_within_input(position: usize, source_length: usize) -> bool:
    requires position < source_length
    ensure result == true
    return LexerCommentScan::after_one(position, source_length) <= source_length

def line_comment_step_decreases_remaining_input(position: usize, source_length: usize) -> bool:
    requires position < source_length
    ensure result == true
    return LexerCommentScan::remaining(source_length, LexerCommentScan::after_one(position, source_length)) < LexerCommentScan::remaining(source_length, position)

def block_comment_single_step_decreases_remaining_input(position: usize, source_length: usize) -> bool:
    requires position < source_length
    ensure result == true
    return LexerCommentScan::remaining(source_length, LexerPositionStep::advanced_offset(position, source_length)) < LexerCommentScan::remaining(source_length, position)

def three_present_delimiter_steps_match_offset_plus_three(position: usize, source_length: usize) -> bool:
    requires position <= source_length
    requires source_length - position >= 3
    ensure result == true
    return LexerCommentScan::after_three(position, source_length) == position + 3

def three_present_delimiter_steps_stay_within_input(position: usize, source_length: usize) -> bool:
    requires position <= source_length
    requires source_length - position >= 3
    ensure result == true
    return LexerCommentScan::after_three(position, source_length) <= source_length

def delimiter_column_advances_by_three(column: int) -> bool:
    ensure result == true
    return LexerCommentScan::column_after_three(column) == column + 3

def three_present_delimiter_steps_decrease_remaining_input(position: usize, source_length: usize) -> bool:
    requires position <= source_length
    requires source_length - position >= 3
    ensure result == true
    return LexerCommentScan::remaining(source_length, LexerCommentScan::after_three(position, source_length)) < LexerCommentScan::remaining(source_length, position)
