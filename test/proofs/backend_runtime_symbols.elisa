            and BackendRuntimeSymbols::is_runtime_provided("ctx_hash_u64")
            and BackendRuntimeSymbols::is_runtime_provided("ctx_strlen")
            and BackendRuntimeSymbols::is_runtime_provided("ctx_streq")
            and BackendRuntimeSymbols::is_runtime_provided("ctx_string_index")
            and BackendRuntimeSymbols::is_runtime_provided("ctx_string_slice")
            and BackendRuntimeSymbols::is_runtime_provided("ctx_string_slice_eq")
            and BackendRuntimeSymbols::is_runtime_provided("ctx_string_slices_eq")
            and BackendRuntimeSymbols::is_runtime_provided("ctx_string_view")
            and BackendRuntimeSymbols::is_runtime_provided("ctx_string_view_len")
            and BackendRuntimeSymbols::is_runtime_provided("ctx_string_view_slice")
            and BackendRuntimeSymbols::is_runtime_provided("ctx_string_view_index")
