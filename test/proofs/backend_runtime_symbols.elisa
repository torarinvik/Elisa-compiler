            and BackendRuntimeSymbols::is_runtime_provided("arena_rewind")
            and BackendRuntimeSymbols::is_runtime_provided("arena_free")
            and BackendRuntimeSymbols::is_runtime_provided("arena_adopt")
            and BackendRuntimeSymbols::is_runtime_provided("arena_trim")
            and BackendRuntimeSymbols::is_runtime_provided("alloc_perm")
