# Source-linked proof of the backend's exact runtime symbol and callback sets.
include "../../src/backend/codegen_runtime_symbols.elisa"

# The pattern arms and their contracts have the same closed set. These universal theorems
# expose the production contracts as proof obligations so replay checks the source classifier.
def allocator_symbols_match_the_exact_set(name: sview) -> bool can[Abort.Panic]:
    ensure result == (
        name == "new_region" or name == "new_region_backend"
        or name == "free_region" or name == "free_region_backend"
        or name == "arena_alloc" or name == "arena_realloc"
        or name == "arena_memcpy" or name == "arena_memeq"
        or name == "arena_strdup" or name == "arena_memdup"
        or name == "arena_snapshot" or name == "arena_reset"
        or name == "arena_rewind" or name == "arena_free"
        or name == "arena_adopt" or name == "arena_trim"
        or name == "alloc_perm" or name == "alloc_scratch" or name == "reset_scratch"
    )
    can Abort.Panic:
        return BackendRuntimeSymbols::is_allocator_symbol(name)

def string_runtime_symbols_match_the_exact_set(name: sview) -> bool can[Abort.Panic]:
    ensure result == (
        name == "ctx_hash_cstr" or name == "ctx_hash_u64"
        or name == "ctx_strlen" or name == "ctx_streq"
        or name == "ctx_string_index" or name == "ctx_string_slice"
        or name == "ctx_string_slice_eq" or name == "ctx_string_slices_eq"
        or name == "ctx_string_view" or name == "ctx_string_view_len"
        or name == "ctx_string_view_slice" or name == "ctx_string_view_index"
        or name == "ctx_string_view_prefix" or name == "ctx_string_view_suffix"
        or name == "ctx_string_view_eq" or name == "ctx_string_views_eq"
        or name == "ctx_string_from_view"
        or name == "ctx_fstr_alloc" or name == "ctx_fstr_append"
        or name == "ctx_llvm_codegen_fatal"
    )
    can Abort.Panic:
        return BackendRuntimeSymbols::is_string_runtime_symbol(name)

def trace_runtime_symbols_match_the_exact_set(name: sview) -> bool can[Abort.Panic]:
    ensure result == (
        name == "elisa_trace_record"
        or name == "elisa_trace_function_entry"
        or name == "elisa_trace_function_exit"
        or name == "elisa_trace_record_value"
        or name == "elisa_trace_record_id"
        or name == "elisa_trace_function_entry_id"
        or name == "elisa_trace_function_exit_id"
        or name == "elisa_trace_record_value_id"
        or name == "elisa_trace_count" or name == "elisa_trace_dump"
        or name == "elisa_trace_install_fault_handler"
    )
    can Abort.Panic:
        return BackendRuntimeSymbols::is_trace_runtime_symbol(name)

def aos_store_runtime_symbols_match_the_exact_set(name: sview) -> bool can[Abort.Panic]:
    ensure result == (
        name == "ctx_aos_store_new_sized" or name == "ctx_aos_store_alloc_sized"
        or name == "ctx_aos_store_sized_record" or name == "ctx_aos_store_side_slot"
        or name == "ctx_aos_store_new_with_side_words"
        or name == "ctx_aos_store_read_side_word"
        or name == "ctx_aos_store_record_side_words_at"
    )
    can Abort.Panic:
        return BackendRuntimeSymbols::is_aos_store_runtime_symbol(name)

