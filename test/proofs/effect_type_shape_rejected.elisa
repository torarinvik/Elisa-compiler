include "./effect_type_shape.elisa"

def same_effect_path_with_different_positions_is_not_equal() -> bool:
    left_pos: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
    right_pos: Ast::Pos = Ast::Pos{line: 9, column: 7, offset: 40, end_line: 9, end_column: 8, end_offset: 41}
    ensure result == true
    return not Ast::effect_path_equal(
        Ast::Expr.Ident("Effects", left_pos),
        Ast::Expr.Ident("Effects", right_pos)
    )

def different_effect_roots_with_same_member_are_equal() -> bool:
    pos: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
    left: Ast::Expr = Ast::Expr.Scope(Ast::Expr.Ident("Alpha", pos), "Choice", pos)
    right: Ast::Expr = Ast::Expr.Scope(Ast::Expr.Ident("Beta", pos), "Choice", pos)
    ensure result == true
    return Ast::effect_path_equal(left, right)

def captures_are_not_part_of_static_effect_runtime_children() -> bool:
    pos: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
    captured: Ast::Expr = Ast::Expr.Ident("captured", pos)
    captures: darray[Ast::Expr] = [captured]
    candidate: Ast::StaticEffectCandidate = Ast::StaticEffectCandidate{captures: captures}
    candidates: darray[Ast::StaticEffectCandidate] = [candidate]
    children: darray[Ast::Expr] = Ast::effect_runtime_children(candidates, [])
    ensure result == true
    return children.count == 0
