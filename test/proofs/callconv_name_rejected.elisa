# False claims against stage0-compatible calling-convention classification.
include "../../src/semantic/callconv_name.elisa"

def fastcc_is_supported() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return CallConvName::is_supported("fastcc")

def case_changed_windows_suffix_is_supported() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return CallConvName::is_supported("Windows64")

def fastcall_is_c_abi() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return CallConvName::is_c_abi("FastCall")
