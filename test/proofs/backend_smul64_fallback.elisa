# Safety lemmas for the signed-i64 multiply fallback used on 32-bit targets.
const I64_MAX: i64 = 9223372036854775807
const I64_MIN: i64 = 0 - I64_MAX - 1

# The divisor selected for the back-test cannot be zero, for any input pair.
def signed64_mul_fallback_divisor_is_nonzero(left: i64, right: i64) -> i64:
    ensure result != 0
    return 1 if left == 0 else (1 if left == (0 - 1) and right == I64_MIN else left)

# LLVM sdiv is also undefined for MIN / -1. The exact input corner that can
# create that denominator is redirected to 1 before the back-test division.
def signed64_mul_min_neg_one_corner_divisor(left: i64, right: i64) -> i64:
    requires left == (0 - 1) and right == I64_MIN
    ensure result == 1
    return 1 if left == 0 else (1 if left == (0 - 1) and right == I64_MIN else left)
