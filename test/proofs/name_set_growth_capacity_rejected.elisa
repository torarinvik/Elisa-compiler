# This false boundary claim asks for one extra empty slot at the exact threshold.
def exact_growth_threshold_leaves_an_extra_empty_slot(name_count: usize) -> bool:
    ensure result == true
    capacity: usize = (name_count + 1) * 2
    return capacity - (name_count + 1) > name_count + 1

def false_thirty_two_slots_cover_the_seventeenth_entry(name_count: usize) -> bool:
    requires name_count == 16
    ensure result == true
    return 32 >= (name_count + 1) * 2

def false_sixty_four_slots_cover_the_thirty_third_entry(name_count: usize) -> bool:
    requires name_count == 32
    ensure result == true
    return 64 >= (name_count + 1) * 2

def false_one_twenty_eight_slots_cover_the_sixty_fifth_entry(name_count: usize) -> bool:
    requires name_count == 64
    ensure result == true
    return 128 >= (name_count + 1) * 2

def false_five_hundred_twelve_slots_cover_the_two_hundred_fifty_seventh_entry(name_count: usize) -> bool:
    requires name_count == 256
    ensure result == true
    return 512 >= (name_count + 1) * 2

def false_one_thousand_twenty_four_slots_cover_the_five_hundred_thirteenth_entry(name_count: usize) -> bool:
    requires name_count == 512
    ensure result == true
    return 1024 >= (name_count + 1) * 2
