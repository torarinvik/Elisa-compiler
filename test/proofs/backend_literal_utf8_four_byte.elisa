# Range proof for the four bytes emitted for a supplementary Unicode scalar.
def supplementary_utf8_lead_byte_is_valid(codepoint: i64) -> i64:
    requires codepoint >= 65536 and codepoint <= 1114111
    ensure result >= 240
    ensure result <= 244
    return 240 + (codepoint / 262144)

def supplementary_utf8_second_byte_is_continuation(codepoint: i64) -> i64:
    requires codepoint >= 65536 and codepoint <= 1114111
    ensure result >= 128
    ensure result <= 191
    return 128 + ((codepoint / 4096) % 64)

def supplementary_utf8_third_byte_is_continuation(codepoint: i64) -> i64:
    requires codepoint >= 65536 and codepoint <= 1114111
    ensure result >= 128
    ensure result <= 191
    return 128 + ((codepoint / 64) % 64)

def supplementary_utf8_fourth_byte_is_continuation(codepoint: i64) -> i64:
    requires codepoint >= 65536 and codepoint <= 1114111
    ensure result >= 128
    ensure result <= 191
    return 128 + (codepoint % 64)
