# Universal exact-language proof for the suffix table used by the production lexer.
include "../../src/lexer/lexer_type_suffix.elisa"

def type_suffix_predicate_is_exact(suffix: sview) -> bool:
    ensure result == (
        suffix == "u" or suffix == "u8" or suffix == "u16" or suffix == "u32" or suffix == "u64" or suffix == "usize" or
        suffix == "i8" or suffix == "i16" or suffix == "i32" or suffix == "i64" or suffix == "isize" or
        suffix == "f32" or suffix == "f64"
    )
    return LexerTypeSuffix::is_valid_type_suffix(suffix)

def every_supported_type_suffix_is_accepted() -> bool:
    ensure result == true
    return LexerTypeSuffix::is_valid_type_suffix("u") and LexerTypeSuffix::is_valid_type_suffix("u8") and LexerTypeSuffix::is_valid_type_suffix("u16") and LexerTypeSuffix::is_valid_type_suffix("u32") and LexerTypeSuffix::is_valid_type_suffix("u64") and LexerTypeSuffix::is_valid_type_suffix("usize") and LexerTypeSuffix::is_valid_type_suffix("i8") and LexerTypeSuffix::is_valid_type_suffix("i16") and LexerTypeSuffix::is_valid_type_suffix("i32") and LexerTypeSuffix::is_valid_type_suffix("i64") and LexerTypeSuffix::is_valid_type_suffix("isize") and LexerTypeSuffix::is_valid_type_suffix("f32") and LexerTypeSuffix::is_valid_type_suffix("f64")
