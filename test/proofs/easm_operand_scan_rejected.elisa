# False claims must remain unprovable under the production operand scanner.
include "./easm_operand_scan.elisa"

def indexed_address_has_four_operands() -> bool:
    ensure result == true
    scan: EasmOperandScan::InstructionScanResult = EasmOperandScan::scan_instruction("movq (%rax,%rcx,8), %rbx")
    return scan.count == 4

def three_top_level_operands_are_supported() -> bool:
    ensure result == true
    scan: EasmOperandScan::InstructionScanResult = EasmOperandScan::scan_instruction("shld %cl, %rbx, (%rax)")
    return scan.valid and not EasmOperandScan::needs_arity_rejection(scan.count)

def unmatched_address_parenthesis_is_valid() -> bool:
    ensure result == true
    scan: EasmOperandScan::InstructionScanResult = EasmOperandScan::scan_instruction("movq (%rax,%rcx,8, %rbx")
    return scan.valid

def invalid_scan_preserves_address_group_metadata() -> bool:
    ensure result == true
    scan: EasmOperandScan::InstructionScanResult = EasmOperandScan::scan_instruction("movq (%rax")
    return not scan.valid and scan.has_address_group

def zero_operand_scan_has_non_sentinel_separator() -> bool:
    ensure result == true
    scan: EasmOperandScan::InstructionScanResult = EasmOperandScan::scan_instruction("ret")
    return scan.valid and scan.count == 0 and scan.first_separator < ("ret").len

def single_operand_scan_has_an_empty_operand() -> bool:
    ensure result == true
    text: sview = "callq *(%rax)"
    scan: EasmOperandScan::InstructionScanResult = EasmOperandScan::scan_instruction(text)
    operand: sview = text[scan.start:text.len]
    return scan.valid and scan.count == 1 and EasmOperandScan::first_operand_byte(operand, 0.usize()) == operand.len

def next_separator_selects_a_comma_inside_address() -> bool:
    ensure result == true
    text: sview = "(%rax,%rcx),%rbx"
    separator: usize = EasmOperandScan::next_top_level_separator(text, 0.usize(), true, 0.usize(), 10.usize())
    return separator < text.len and separator <= 10.usize()

def cpuid_is_not_a_zero_operand_instruction() -> bool:
    ensure result == true
    return not EasmOperandScan::is_zero_operand_instruction("cpuid")

def movq_is_a_zero_operand_instruction() -> bool:
    ensure result == true
    return EasmOperandScan::is_zero_operand_instruction("movq")

def movq_with_one_operand_is_accepted() -> bool:
    ensure result == true
    return EasmOperandScan::operand_arity_supported("movq", 1.usize())

def incq_with_two_operands_is_accepted() -> bool:
    ensure result == true
    return EasmOperandScan::operand_arity_supported("incq", 2.usize())

def mrs_with_one_operand_is_accepted() -> bool:
    ensure result == true
    return EasmOperandScan::operand_arity_supported("mrs", 1.usize())

def register_suffix_is_accepted_as_the_exact_register() -> bool:
    ensure result == true
    return EasmOperandScan::exact_register_form("%rax_extra", "rax")

def bare_register_name_is_accepted_as_att_syntax() -> bool:
    ensure result == true
    return EasmOperandScan::exact_register_form("rax", "rax")

def register_operand_is_classified_as_a_direct_target() -> bool:
    ensure result == true
    return EasmOperandScan::is_direct_control_target("callq", "%rax", true)

def immediate_operand_is_classified_as_a_direct_target() -> bool:
    ensure result == true
    return EasmOperandScan::is_direct_control_target("callq", "$runtime_helper", true)

def nonfinal_symbol_is_classified_as_a_direct_target() -> bool:
    ensure result == true
    return EasmOperandScan::is_direct_control_target("callq", "runtime_helper", false)

def mrs_accepts_x31() -> bool:
    ensure result == true
    return EasmOperandScan::is_aarch64_mrs_form("x31", "cntvct_el0")

def mrs_accepts_zero_padded_x09() -> bool:
    ensure result == true
    return EasmOperandScan::is_aarch64_mrs_form("x09", "cntvct_el0")

def mrs_accepts_general_purpose_w_register() -> bool:
    ensure result == true
    return EasmOperandScan::is_aarch64_mrs_form("w0", "cntvct_el0")

def mrs_accepts_unsupported_system_register() -> bool:
    ensure result == true
    return EasmOperandScan::is_aarch64_mrs_form("x0", "cntfrq_el0")

def nested_address_parentheses_are_valid() -> bool:
    ensure result == true
    scan: EasmOperandScan::InstructionScanResult = EasmOperandScan::scan_instruction("movq ((%rax)), %rbx")
    return scan.valid

def bare_data_symbol_is_accepted(operand_present: bool, memory_address: bool, register_operand: bool, immediate_operand: bool, direct_target: bool) -> bool:
    requires operand_present and not memory_address and not register_operand and not immediate_operand and not direct_target
    ensure result == true
    return not (operand_present and not memory_address and not register_operand and not immediate_operand and not direct_target)

def immediate_return_is_stack_neutral(op: sview, immediate_operand: bool) -> bool:
    requires immediate_operand and (op == "ret" or op == "retq")
    ensure result == true
    return not (immediate_operand and (op == "ret" or op == "retq"))

def unresolved_conditional_target_is_always_accepted() -> bool:
    ensure result == true
    return not EasmOperandScan::rejects_unresolved_conditional_target(true, false, false, false)
