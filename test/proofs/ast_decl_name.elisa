# Declaration-name lookup returns the declared identifier, while recovery,
# import, and scoped-container nodes have no declaration name.
include "../../src/parser/parser_tokens.elisa"
using Ast

def decl_name_matches_the_owned_name_for_every_variant(declaration: Decl) -> bool:
    ensure result == true
    actual: sview = Ast::decl_name(declaration)
    match declaration:
        Decl.Invalid:
            return actual == sview("", 0, 0)
        Decl.Func(source_name, _, _, _, _, _, _):
            return actual == source_name
        Decl.Struct(source_name, _, _, _, _, _, _):
            return actual == source_name
        Decl.Enum(source_name, _, _, _, _):
            return actual == source_name
        Decl.Alias(source_name, _, _):
            return actual == source_name
        Decl.Law(source_name, _, _):
            return actual == source_name
        Decl.Import(_, _):
            return actual == sview("", 0, 0)
        Decl.Scoped(_, _):
            return actual == sview("", 0, 0)
        Decl.Extern(source_name, _, _, _, _, _, _, _):
            return actual == source_name
        Decl.Const(source_name, _, _, _, _):
            return actual == source_name
        Decl.Module(source_name, _, _):
            return actual == source_name
