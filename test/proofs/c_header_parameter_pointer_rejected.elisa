# Incorrect C ABI parameter pointer counts must be rejected.
include "../../src/backend/c_header_parameter_pointer.elisa"
include "../../src/backend/c_header_prototype_marker.elisa"
include "../../src/backend/c_header_return_pointer.elisa"

def reference_parameter_must_not_use_source_depth() -> bool:
    ensure result == true
    return CHeaderParameterPointer::star_count(true, 3) == 3

def value_parameter_must_not_gain_a_pointer() -> bool:
    ensure result == true
    return CHeaderParameterPointer::star_count(false, 0) == 1

def value_parameter_must_not_lose_a_pointer_level() -> bool:
    ensure result == true
    return CHeaderParameterPointer::star_count(false, 3) == 2

def zero_arity_must_not_omit_the_c_void_marker() -> bool:
    ensure result == true
    return not CHeaderPrototypeMarker::needs_void_parameter_marker(0)

def positive_arity_must_not_emit_the_c_void_marker() -> bool:
    ensure result == true
    return CHeaderPrototypeMarker::needs_void_parameter_marker(1)

def other_annotation_owner_must_not_select_a_pointer_return() -> bool:
    ensure result == true
    return CHeaderReturnPointer::matches_marker("__export_fn", "f", "f")

def pointer_return_marker_must_not_match_every_function() -> bool:
    ensure result == true
    return CHeaderReturnPointer::matches_marker("__extern_return_ptr", "f", "g")
