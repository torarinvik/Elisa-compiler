include "./type_path_collect_policy.elisa"

def field_separator_is_a_namespace_separator() -> bool can[Memory.Allocate, Abort.Panic]:
    pos: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
    expression: Ast::Expr = Ast::Expr.Field(Ast::Expr.Ident("Pack", pos), "Item", pos)
    names: mutable darray[sview] = []
    dotted: mutable darray[bool] = []
    ensure result == true
    return SemanticTypePathCollectPolicy::collect(expression, names, dotted) and not dotted[0]

def scope_separator_is_a_value_separator() -> bool can[Memory.Allocate, Abort.Panic]:
    pos: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
    expression: Ast::Expr = Ast::Expr.Scope(Ast::Expr.Ident("Pack", pos), "Item", pos)
    names: mutable darray[sview] = []
    dotted: mutable darray[bool] = []
    ensure result == true
    return SemanticTypePathCollectPolicy::collect(expression, names, dotted) and dotted[0]
