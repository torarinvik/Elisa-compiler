# Source-linked proofs for the static character classes consumed by the numeric FSM.
include "../../src/lexer/lexer_number_classification.elisa"

def every_character_uses_its_exact_closed_class(character: char) -> bool:
    ensure result == true
    return match character:
        '0'..='9': LexerNumberClassification::classify_char(character) == LexerNumberClassification::NumberClass.Digit
        'e' | 'E': LexerNumberClassification::classify_char(character) == LexerNumberClassification::NumberClass.ExpMarkOther
        'a'..='d' | 'f' | 'A'..='D' | 'F': LexerNumberClassification::classify_char(character) == LexerNumberClassification::NumberClass.HexAlpha
        '.': LexerNumberClassification::classify_char(character) == LexerNumberClassification::NumberClass.OtherDot
        '+' | '-': LexerNumberClassification::classify_char(character) == LexerNumberClassification::NumberClass.Sign
        _: LexerNumberClassification::classify_char(character) == LexerNumberClassification::NumberClass.Other

def decimal_digit_predicate_agrees_with_the_digit_class(character: char) -> bool:
    ensure result == true
    return LexerNumberClassification::is_decimal_digit(character) == (LexerNumberClassification::classify_char(character) == LexerNumberClassification::NumberClass.Digit)

def decimal_digit_predicate_is_exact(character: char) -> bool:
    ensure result == true
    return LexerNumberClassification::is_decimal_digit(character) == (character in '0'..='9')

def hexadecimal_digit_predicate_is_exact(character: char) -> bool:
    ensure result == true
    return LexerNumberClassification::is_hex_digit(character) == (character in '0'..='9' or character in 'a'..='f' or character in 'A'..='F')

def exponent_mark_is_hex_digit_but_not_hex_alpha() -> bool:
    ensure result == true
    return LexerNumberClassification::is_hex_digit('e') and LexerNumberClassification::classify_char('e') == LexerNumberClassification::NumberClass.ExpMarkOther

def non_ascii_decimal_digit_is_outside_ascii_number_classes() -> bool:
    ensure result == true
    return not LexerNumberClassification::is_decimal_digit('١') and LexerNumberClassification::classify_char('١') == LexerNumberClassification::NumberClass.Other

def contextual_classes_are_not_static_character_classes(character: char) -> bool:
    ensure result == true
    return LexerNumberClassification::classify_char(character) != LexerNumberClassification::NumberClass.ExpMarkValid and LexerNumberClassification::classify_char(character) != LexerNumberClassification::NumberClass.FractionDot and LexerNumberClassification::classify_char(character) != LexerNumberClassification::NumberClass.HexPrefix and LexerNumberClassification::classify_char(character) != LexerNumberClassification::NumberClass.DecimalSeparator and LexerNumberClassification::classify_char(character) != LexerNumberClassification::NumberClass.HexSeparator
