include "./region_escape_store_guards.elisa"

def region_parameter_stored_in_global_takes_local_escape_guard() -> bool:
    requires true
    ensure result == true
    return global_store_guard_is_exact(true, false)

def non_auto_target_takes_auto_escape_guard() -> bool:
    requires true
    ensure result == true
    return auto_store_guard_is_exact(false, true)
