# The lexer probes one initial suffix byte and at most five following bytes.
# This bound keeps the Token suffix_length narrowing cast in range.
def suffix_probe_span_is_at_most_six(additional_bytes: i64) -> bool:
    requires additional_bytes >= 0 and additional_bytes <= 5
    ensure result == true
    return 1 + additional_bytes <= 6

def suffix_probe_span_fits_u16(additional_bytes: i64) -> bool:
    requires additional_bytes >= 0 and additional_bytes <= 5
    ensure result == true
    return 1 + additional_bytes <= 65535

def first_u16_overflow_exceeds_the_suffix_probe(additional_bytes: i64) -> bool:
    requires additional_bytes >= 0 and additional_bytes <= 5
    ensure result == true
    return 65536 > 1 + additional_bytes
