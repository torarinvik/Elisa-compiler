include "./backend_darray_push_bounds.elisa"

def false_full_capacity_has_a_spare_slot(count: u64, capacity: u64) -> bool:
    requires count == capacity
    ensure result == true
    return count < capacity

def false_guarded_increment_exceeds_target_capacity(count: u64, capacity: u64, target_max: u64) -> bool:
    requires count < capacity
    requires capacity <= target_max
    ensure result == true
    return count + 1 > capacity
