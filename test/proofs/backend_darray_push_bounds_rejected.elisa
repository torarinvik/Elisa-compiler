include "./backend_darray_push_bounds.elisa"

def false_full_capacity_has_a_spare_slot(count: u64, capacity: u64) -> bool:
    requires count == capacity
    ensure result == true
    return count < capacity

def false_guarded_increment_exceeds_target_capacity(count: u64, capacity: u64, target_max: u64) -> bool:
    requires count < capacity
    requires capacity <= target_max
    ensure result == true
    return count + 1 > capacity

def false_guarded_increment_exceeds_target_limit(count: u64, capacity: u64, target_max: u64) -> u64:
    requires count < capacity
    requires capacity <= target_max
    ensure result > target_max
    return count + 1


def false_push_growth_capacity_may_fall_short(capacity: u64, needed: u64) -> u64:
    requires capacity == 0
    requires needed > 8
    ensure result >= needed
    return 8 if capacity == 0 else needed

def false_push_growth_overflow_keeps_wrapped_double(capacity: u64, needed: u64, doubled: u64, overflow: bool) -> u64:
    requires capacity > 0
    requires overflow
    ensure result == needed
    return doubled


def false_empty_push_growth_seed_is_not_eight(capacity: u64, needed: u64) -> u64:
    requires capacity == 0
    requires needed <= 8
    ensure result == 8
    return 4 if capacity == 0 else needed
