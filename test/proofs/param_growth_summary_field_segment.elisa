# Each memoized (callee, tag) result owns a field segment. Deduplication for a
# new result must inspect only that segment, never fields cached for older keys.
def pgs_should_append_current_field(found_in_current_segment: bool) -> bool:
    ensure result == not found_in_current_segment
    return not found_in_current_segment

def pgs_current_segment_duplicate_is_suppressed(found_in_current_segment: bool) -> bool:
    requires found_in_current_segment
    ensure result == false
    return pgs_should_append_current_field(found_in_current_segment)

def pgs_older_segment_match_does_not_suppress_current_field(found_in_older_segment: bool, found_in_current_segment: bool) -> bool:
    requires found_in_older_segment
    requires not found_in_current_segment
    ensure result == true
    return pgs_should_append_current_field(found_in_current_segment)

def pgs_current_segment_match_suppresses_after_older_match(found_in_older_segment: bool, found_in_current_segment: bool) -> bool:
    requires found_in_older_segment and found_in_current_segment
    ensure result == false
    return pgs_should_append_current_field(found_in_current_segment)
