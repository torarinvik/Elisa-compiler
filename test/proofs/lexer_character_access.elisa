# Source-linked proof for both bounded byte-selection branches used by char_at.
include "../../src/lexer/lexer_character_access.elisa"

def exactly_at_source_end_returns_the_sentinel(sentinel: u8, source_length: usize) -> bool:
    ensure result == true
    return lexer_sentinel_if_out_of_range(sentinel, source_length, source_length) == sentinel

def past_source_end_returns_the_sentinel(sentinel: u8, source_length: usize, index: usize) -> bool:
    requires index > source_length
    ensure result == true
    return lexer_sentinel_if_out_of_range(sentinel, source_length, index) == sentinel

def in_range_access_preserves_the_selected_byte(byte: u8, source_length: usize, index: usize) -> bool:
    requires index < source_length
    ensure result == true
    return lexer_byte_if_in_range(byte, source_length, index) == byte
