# Source-linked proof for the lexer’s bounded byte-to-character accessor.
include "../../src/lexer/lexer_character_access.elisa"

def exactly_at_source_end_returns_the_sentinel(byte: u8, source_length: usize, sentinel: u8) -> bool:
    ensure result == true
    return lexer_byte_or_sentinel(byte, source_length, source_length, sentinel) == sentinel

def beyond_source_end_returns_the_sentinel(byte: u8, source_length: usize, index: usize, sentinel: u8) -> bool:
    requires index >= source_length
    ensure result == true
    return lexer_byte_or_sentinel(byte, source_length, index, sentinel) == sentinel

def in_range_access_preserves_the_selected_byte(byte: u8, source_length: usize, index: usize, sentinel: u8) -> bool:
    requires index < source_length
    ensure result == true
    return lexer_byte_or_sentinel(byte, source_length, index, sentinel) == byte
