# False claims against the negative-index sequence type classifier.
include "../../src/semantic/negative_index_sequence_type.elisa"

def dictionary_keys_are_sequence_negative_indices() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return NegativeIndexSequenceType::is_sequence_type_name("dict")

def ordinary_integer_values_are_sequences() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return NegativeIndexSequenceType::is_sequence_type_name("i64")
