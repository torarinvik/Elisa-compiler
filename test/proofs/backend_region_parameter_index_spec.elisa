# Proof-only functional model of Backend::region_parameter_index. The source
# checker binds this model's executable loop to the production helper.
module BackendRegionParameterIndexSpec:
    public:
        def region_parameter_index(lines: darray[u32], names: darray[sview], line: u32, name: sview) -> i64:
            ensure result == -1 or (result >= 0 and result < lines.count.i64())
            slot: mutable i64 = 0
            for row in 0..<lines.count |slot, row, line, name, lines, names|:
                invariant slot >= 0
                invariant slot <= row.i64()
                continue if lines[row] != line
                if row < names.count and names[row] == name:
                    return slot
                slot <- slot + 1
            return -1
