# The extern signature rewrite is reached only when preflight validation did
# not fail and at least one pointer/length pair was accepted.
def bounds_rewrite_gate_is_exact(failed: bool, no_valid_pairs: bool) -> bool:
    ensure result == not (failed or no_valid_pairs)
    return not (failed or no_valid_pairs)

def failed_validation_never_rewrites(failed: bool, no_valid_pairs: bool) -> bool:
    requires failed
    ensure result == false
    return not (failed or no_valid_pairs)

def empty_pair_set_never_rewrites(failed: bool, no_valid_pairs: bool) -> bool:
    requires not failed and no_valid_pairs
    ensure result == false
    return not (failed or no_valid_pairs)

def valid_pairs_enter_rewrite(failed: bool, no_valid_pairs: bool) -> bool:
    requires not failed and not no_valid_pairs
    ensure result == true
    return not (failed or no_valid_pairs)

def malformed_arity_is_rejected(no_arguments: bool, is_odd: bool) -> bool:
    ensure result == (no_arguments or is_odd)
    return no_arguments or is_odd

def both_parameter_names_must_exist(pointer_found: bool, length_found: bool) -> bool:
    ensure result == (pointer_found and length_found)
    return pointer_found and length_found

def pair_indices_must_be_distinct_and_unused(same_index: bool, pointer_reused: bool, length_reused: bool) -> bool:
    ensure result == not (same_index or pointer_reused or length_reused)
    return not (same_index or pointer_reused or length_reused)

def pointer_parameter_must_be_required_reference(is_ref: bool, is_optional: bool) -> bool:
    ensure result == (is_ref and not is_optional)
    return is_ref and not is_optional

def length_parameter_must_be_nonreference_integer(is_ref: bool, is_integer_type: bool) -> bool:
    ensure result == (not is_ref and is_integer_type)
    return not is_ref and is_integer_type
