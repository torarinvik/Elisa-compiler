# Source-linked proof that ProjectSystem decodes UTF-16 escapes only to Unicode scalars.
include "../../src/driver/project.elisa"

def production_hex4_result_is_invalid_or_within_u16(data: darray[u8]&, position: usize) -> bool:
    ensure result == true
    decoded: i64 = ProjectSystem::json_hex4(data, position)
    return decoded == -1 or (decoded >= 0 and decoded <= 65535)

def every_production_escape_result_is_a_unicode_scalar(data: darray[u8]&, first: i64) -> bool:
    requires first >= 0 and first <= 65535
    ensure result == true
    cursor: mutable ProjectSystem::JsonCursor = ProjectSystem::JsonCursor{
        position: 0.usize(), ok: true, bad_key_start: 0.usize(), bad_key_length: 0.usize()
    }
    scalar: i64 = ProjectSystem::json_unicode_escape_scalar(data, &cursor, first)
    return (
        scalar >= 0 and scalar <= 1114111 and
        (scalar < 55296 or scalar > 57343)
    )

def the_maximum_surrogate_pair_decodes_to_the_maximum_scalar() -> bool can[Memory.Allocate, Abort.Panic]:
    ensure result == true
    data: darray[u8] = [92, 117, 68, 66, 70, 70, 92, 117, 68, 70, 70, 70]
    cursor: mutable ProjectSystem::JsonCursor = ProjectSystem::JsonCursor{
        position: 6.usize(), ok: true, bad_key_start: 0.usize(), bad_key_length: 0.usize()
    }
    scalar: i64 = ProjectSystem::json_unicode_escape_scalar(data, &cursor, 56319)
    return scalar == 1114111 and cursor.position == 12.usize()

def an_isolated_high_surrogate_decodes_to_replacement() -> bool can[Memory.Allocate, Abort.Panic]:
    ensure result == true
    data: darray[u8] = []
    cursor: mutable ProjectSystem::JsonCursor = ProjectSystem::JsonCursor{
        position: 0.usize(), ok: true, bad_key_start: 0.usize(), bad_key_length: 0.usize()
    }
    scalar: i64 = ProjectSystem::json_unicode_escape_scalar(data, &cursor, 55296)
    return scalar == 65533 and cursor.position == 0.usize()
