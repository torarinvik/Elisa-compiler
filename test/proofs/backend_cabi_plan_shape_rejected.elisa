include "./backend_cabi_plan_shape.elisa"

def false_view_split_accepts_one_field(source_fields: i64) -> bool:
    requires source_fields == 1
    ensure result
    return source_fields >= 2

def false_resource_extract_accepts_zero_fields(source_fields: i64) -> bool:
    requires source_fields == 0
    ensure result
    return source_fields >= 1

def false_pointer_load_accepts_aggregate(source_is_pointer: bool) -> bool:
    requires not source_is_pointer
    ensure result
    return source_is_pointer
