include "./region_escape_handle_transfer.elisa"

def empty_tuple_can_carry_region_handle() -> bool:
    ensure result == true
    return tuple_handle_transfer_is_exact(false)

def length_field_may_carry_region_handle() -> bool:
    requires true
    ensure result == true
    return length_and_count_fields_carry_no_region_handle(true, false)
