# Abstract one boolean provenance component through the production EASM register transfer.
# The admission checker binds these cases to easm_update_memory_provenance and instantiates
# the same equations for both the carrier type and its source-parameter origin.
const PROV_CLOBBER: i64 = 0
const PROV_MOVE: i64 = 1
const PROV_LEA: i64 = 2
const PROV_ADD: i64 = 3
const PROV_SUB: i64 = 4
const PROV_INC: i64 = 5
const PROV_DEC: i64 = 6
const PROV_XCHG: i64 = 7

def provenance_destination_after(
    kind: i64,
    pseudo: bool,
    has_source_register: bool,
    has_destination_register: bool,
    has_base_register: bool,
    old_source: bool,
    old_destination: bool,
    old_base: bool,
) -> bool:
    requires kind >= PROV_CLOBBER and kind <= PROV_XCHG
    if pseudo or not has_destination_register:
        return old_destination
    if kind == PROV_MOVE or kind == PROV_XCHG:
        return old_source if has_source_register else false
    if kind == PROV_LEA:
        return old_base if has_base_register else false
    if kind == PROV_ADD or kind == PROV_SUB or kind == PROV_INC or kind == PROV_DEC:
        return old_destination
    return false

def provenance_source_after(
    kind: i64,
    pseudo: bool,
    has_source_register: bool,
    has_destination_register: bool,
    old_source: bool,
    old_destination: bool,
) -> bool:
    requires kind >= PROV_CLOBBER and kind <= PROV_XCHG
    if pseudo or kind != PROV_XCHG or not has_source_register:
        return old_source
    return old_destination if has_destination_register else false

def pseudo_instruction_preserves_destination_provenance(
    kind: i64, has_source: bool, has_destination: bool, has_base: bool,
    old_source: bool, old_destination: bool, old_base: bool,
) -> bool:
    requires kind >= PROV_CLOBBER and kind <= PROV_XCHG
    ensure result == old_destination
    return provenance_destination_after(kind, true, has_source, has_destination, has_base, old_source, old_destination, old_base)

def pseudo_instruction_preserves_source_provenance(
    kind: i64, has_source: bool, has_destination: bool, old_source: bool, old_destination: bool,
) -> bool:
    requires kind >= PROV_CLOBBER and kind <= PROV_XCHG
    ensure result == old_source
    return provenance_source_after(kind, true, has_source, has_destination, old_source, old_destination)

def non_exchange_without_a_destination_is_a_state_noop(
    kind: i64, pseudo: bool, has_source: bool, has_base: bool,
    old_source: bool, old_destination: bool, old_base: bool,
) -> bool:
    requires kind >= PROV_CLOBBER and kind < PROV_XCHG
    ensure result == true
    return (
        provenance_destination_after(kind, pseudo, has_source, false, has_base, old_source, old_destination, old_base) == old_destination and
        provenance_source_after(kind, pseudo, has_source, false, old_source, old_destination) == old_source
    )

def move_cannot_create_provenance_from_an_untracked_source(
    pseudo: bool, has_source: bool, old_source: bool,
) -> bool:
    requires not pseudo and has_source and not old_source
    ensure result == false
    return provenance_destination_after(PROV_MOVE, pseudo, has_source, true, false, old_source, true, false)

def move_copies_a_tracked_source_provenance_component(
    pseudo: bool, has_source: bool, old_source: bool,
) -> bool:
    requires not pseudo and has_source and old_source
    ensure result == true
    return provenance_destination_after(PROV_MOVE, pseudo, has_source, true, false, old_source, false, false)

def move_from_a_nonregister_clears_the_old_destination_provenance(
    pseudo: bool, old_destination: bool,
) -> bool:
    requires not pseudo
    ensure result == false
    return provenance_destination_after(PROV_MOVE, pseudo, false, true, false, true, old_destination, false)

def lea_cannot_create_provenance_from_an_untracked_base(
    pseudo: bool, has_base: bool, old_base: bool,
) -> bool:
    requires not pseudo and has_base and not old_base
    ensure result == false
    return provenance_destination_after(PROV_LEA, pseudo, false, true, has_base, false, true, old_base)

def lea_copies_a_tracked_base_provenance_component(
    pseudo: bool, has_base: bool, old_base: bool,
) -> bool:
    requires not pseudo and has_base and old_base
    ensure result == true
    return provenance_destination_after(PROV_LEA, pseudo, false, true, has_base, false, false, old_base)

def lea_without_a_parsed_base_clears_old_destination_provenance(
    pseudo: bool, old_destination: bool,
) -> bool:
    requires not pseudo
    ensure result == false
    return provenance_destination_after(PROV_LEA, pseudo, false, true, false, false, old_destination, true)

def pointer_arithmetic_preserves_destination_provenance(
    kind: i64, old_destination: bool,
) -> bool:
    requires (kind == PROV_ADD or kind == PROV_SUB or kind == PROV_INC or kind == PROV_DEC)
    ensure result == old_destination
    return provenance_destination_after(kind, false, false, true, false, false, old_destination, false)

def every_other_register_write_kills_stale_destination_provenance(
    kind: i64, old_destination: bool,
) -> bool:
    requires kind == PROV_CLOBBER
    ensure result == false
    return provenance_destination_after(kind, false, false, true, false, false, old_destination, false)

def xchg_swaps_destination_provenance(
    old_source: bool, old_destination: bool,
) -> bool:
    ensure result == old_source
    return provenance_destination_after(PROV_XCHG, false, true, true, false, old_source, old_destination, false)

def xchg_swaps_source_provenance(
    old_source: bool, old_destination: bool,
) -> bool:
    ensure result == old_destination
    return provenance_source_after(PROV_XCHG, false, true, true, old_source, old_destination)

def xchg_with_one_unparsed_operand_clears_the_surviving_register(
    source_is_register: bool, destination_is_register: bool, old_source: bool, old_destination: bool,
) -> bool:
    requires source_is_register != destination_is_register
    ensure result == false
    source_after: bool = provenance_source_after(PROV_XCHG, false, source_is_register, destination_is_register, old_source, old_destination)
    destination_after: bool = provenance_destination_after(PROV_XCHG, false, source_is_register, destination_is_register, false, old_source, old_destination, false)
    return source_after if source_is_register else destination_after
