# Proofs of the production decimal accumulator guard used by backend pattern parsing.
include "./backend_decimal_accumulator_model.elisa"

def every_admitted_decimal_step_fits_u64(accumulated: u64, digit: u64) -> bool:
    requires BackendDecimalLiteral::decimal_step_allowed(accumulated, digit)
    ensure result == true
    return BackendDecimalLiteral::decimal_step_value(accumulated, digit) <= BackendDecimalLiteral::U64_MAX

def inline_overflow_test_matches_the_decimal_model(accumulated: u64, digit: u64) -> bool:
    requires digit <= 9.u64()
    ensure result == true
    return (not (accumulated > BackendDecimalLiteral::MAX_PREFIX_BEFORE_DECIMAL_DIGIT or (accumulated == BackendDecimalLiteral::MAX_PREFIX_BEFORE_DECIMAL_DIGIT and digit > 5.u64()))) == BackendDecimalLiteral::decimal_step_allowed(accumulated, digit)

def final_allowed_digit_reaches_u64_max() -> bool:
    ensure result == true
    return BackendDecimalLiteral::decimal_step_allowed(BackendDecimalLiteral::MAX_PREFIX_BEFORE_DECIMAL_DIGIT, 5.u64()) and BackendDecimalLiteral::decimal_step_value(BackendDecimalLiteral::MAX_PREFIX_BEFORE_DECIMAL_DIGIT, 5.u64()) == BackendDecimalLiteral::U64_MAX

def every_lower_prefix_accepts_a_decimal_nine(accumulated: u64) -> bool:
    requires accumulated < BackendDecimalLiteral::MAX_PREFIX_BEFORE_DECIMAL_DIGIT
    ensure result == true
    return BackendDecimalLiteral::decimal_step_allowed(accumulated, 9.u64())

def nondecimal_digit_is_rejected(accumulated: u64) -> bool:
    ensure result == true
    return not BackendDecimalLiteral::decimal_step_allowed(accumulated, 10.u64())

def prefix_above_the_limit_is_rejected(accumulated: u64) -> bool:
    requires accumulated > BackendDecimalLiteral::MAX_PREFIX_BEFORE_DECIMAL_DIGIT
    ensure result == true
    return not BackendDecimalLiteral::decimal_step_allowed(accumulated, 0.u64())

def max_prefix_plus_six_is_rejected() -> bool:
    ensure result == true
    return not BackendDecimalLiteral::decimal_step_allowed(BackendDecimalLiteral::MAX_PREFIX_BEFORE_DECIMAL_DIGIT, 6.u64())

def overflow_after_valid_separator_is_rejected() -> bool:
    ensure result == true
    prefix_after_separator: u64 = BackendDecimalLiteral::MAX_PREFIX_BEFORE_DECIMAL_DIGIT
    return prefix_after_separator == BackendDecimalLiteral::MAX_PREFIX_BEFORE_DECIMAL_DIGIT and not BackendDecimalLiteral::decimal_step_allowed(prefix_after_separator, 6.u64())

def one_below_max_prefix_with_nine_stays_below_u64_max() -> bool:
    ensure result == true
    return BackendDecimalLiteral::decimal_step_allowed(BackendDecimalLiteral::MAX_PREFIX_BEFORE_DECIMAL_DIGIT - 1.u64(), 9.u64()) and BackendDecimalLiteral::decimal_step_value(BackendDecimalLiteral::MAX_PREFIX_BEFORE_DECIMAL_DIGIT - 1.u64(), 9.u64()) == BackendDecimalLiteral::U64_MAX - 6.u64()
