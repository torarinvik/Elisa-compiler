# Deliberately false claims at the signed-i64 and divide-by-zero boundaries.
include "../../src/ir/core_ir_scalar_safety.elisa"

def maximum_plus_one_is_admitted() -> bool:
    ensure result == true
    return ElisaCoreIRScalarSafety::binary_is_defined(ElisaCoreIRArithmetic::ADD_GUARD_CODE, ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM, 1)

def maximum_times_two_is_admitted() -> bool:
    ensure result == true
    return ElisaCoreIRScalarSafety::binary_is_defined(ElisaCoreIRArithmetic::MULTIPLY_GUARD_CODE, ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM, 2)

def zero_divisor_is_admitted() -> bool:
    ensure result == true
    return ElisaCoreIRScalarSafety::binary_is_defined(ElisaCoreIRArithmetic::DIVIDE_GUARD_CODE, 7, 0)

def negative_scalar_operand_is_admitted() -> bool:
    ensure result == true
    return ElisaCoreIRScalarSafety::binary_is_defined(ElisaCoreIRArithmetic::SUBTRACT_GUARD_CODE, 0 - 1, 0)
