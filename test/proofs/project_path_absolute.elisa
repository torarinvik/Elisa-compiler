# Source-linked proof of the project system's lexical absolute-path predicate.
include "../../src/driver/project.elisa"

def production_predicate_matches_the_leading_separator_rule(path: darray[u8]&) -> bool:
    ensure result == (path.count > 0.usize() and path[0.usize()] == ProjectSystemPathByte::ASCII_FORWARD_SLASH)
    return ProjectSystem::path_is_absolute(path)

def empty_path_is_relative(path: darray[u8]&) -> bool:
    requires path.count == 0.usize()
    ensure result == false
    return ProjectSystem::path_is_absolute(path)

def slash_prefixed_path_is_absolute(path: darray[u8]&) -> bool:
    requires path.count > 0.usize() and path[0.usize()] == ProjectSystemPathByte::ASCII_FORWARD_SLASH
    ensure result == true
    return ProjectSystem::path_is_absolute(path)

def non_slash_prefixed_path_is_relative(path: darray[u8]&) -> bool:
    requires path.count > 0.usize() and path[0.usize()] != ProjectSystemPathByte::ASCII_FORWARD_SLASH
    ensure result == false
    return ProjectSystem::path_is_absolute(path)
