include "../../src/semantic/module_symbol_path_matcher.elisa"

def absolute_module_path_matches_all_segments() -> bool can[Abort.Panic]:
    names: darray[sview] = ["Outer", "Inner"]
    ensure result == true
    return SemanticModuleSymbolPathMatcher::absolute("Outer::Inner", "", names, 0, 2)

def prefixed_match_uses_only_the_selected_segment_range() -> bool can[Abort.Panic]:
    names: darray[sview] = ["Unused", "Inner", "Type"]
    ensure result == true
    return SemanticModuleSymbolPathMatcher::absolute("Alias::Inner::Type", "Alias", names, 1, 3)

def delimiter_and_full_length_are_both_required() -> bool can[Abort.Panic]:
    names: darray[sview] = ["Outer", "Inner"]
    ensure result == true
    return not SemanticModuleSymbolPathMatcher::absolute("Outer.Inner", "", names, 0, 2) and
        not SemanticModuleSymbolPathMatcher::absolute("Outer::Inner::Tail", "", names, 0, 2)

def invalid_absolute_segment_ranges_fail_closed() -> bool can[Abort.Panic]:
    names: darray[sview] = ["Only"]
    ensure result == true
    return not SemanticModuleSymbolPathMatcher::absolute("Only", "", names, 2, 1) and
        not SemanticModuleSymbolPathMatcher::absolute("Only::More", "", names, 0, 2)

def relative_child_matches_the_current_module() -> bool can[Abort.Panic]:
    names: darray[sview] = ["Type"]
    ensure result == true
    return SemanticModuleSymbolPathMatcher::relative("Outer::Inner::Type", "Outer::Inner", names, 1)

def relative_child_matches_an_enclosing_ancestor_boundary() -> bool can[Abort.Panic]:
    names: darray[sview] = ["Type"]
    ensure result == true
    return SemanticModuleSymbolPathMatcher::relative("Outer::Inner::Type", "Outer::Inner::Nested", names, 1)

def relative_multi_segment_suffix_matches_exactly() -> bool can[Abort.Panic]:
    names: darray[sview] = ["Inner", "Type"]
    ensure result == true
    return SemanticModuleSymbolPathMatcher::relative("Outer::Inner::Type", "Outer", names, 2)

def short_candidate_and_empty_relative_paths_fail_closed() -> bool can[Abort.Panic]:
    names: darray[sview] = ["Long"]
    empty: darray[sview] = []
    ensure result == true
    return not SemanticModuleSymbolPathMatcher::relative("A::X", "A", names, 1) and
        not SemanticModuleSymbolPathMatcher::relative("A::", "A", empty, 0)
