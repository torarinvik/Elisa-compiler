include "./backend_fn_return_pool_bounds.elisa"

def false_claim_non_function_reads_fn_return_pool(is_fn: bool, index_in_bounds: bool) -> bool:
    requires not is_fn
    ensure result == true
    return is_fn and index_in_bounds

def false_claim_out_of_range_function_reads_fn_return_pool(is_fn: bool, index_in_bounds: bool) -> bool:
    requires is_fn and not index_in_bounds
    ensure result == true
    return is_fn and index_in_bounds
