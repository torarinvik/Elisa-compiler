# Prove the accepted range-token set and its strict/inclusive upper comparison.
include "../../src/parser/parser_tokens.elisa"
include "../../src/backend/codegen_range_membership_policy.elisa"

def supported_range_operator_classifier_is_exact(operator: TokenKind) -> bool:
    ensure result == true
    return BackendRangeMembershipPolicy::is_range_operator(operator) == (
        operator == TokenKind.Range or
        operator == TokenKind.RangeLt or
        operator == TokenKind.RangeLe
    )

def upper_comparison_classifier_is_exact(operator: TokenKind) -> bool:
    ensure result == true
    expected: TokenKind = match operator:
        TokenKind.Range | TokenKind.RangeLe: TokenKind.LtEq
        TokenKind.RangeLt: TokenKind.Lt
        _: TokenKind.Error
    return BackendRangeMembershipPolicy::upper_operator(operator) == expected

def all_three_range_forms_have_their_intended_upper_operator() -> bool:
    ensure result == true
    return BackendRangeMembershipPolicy::is_range_operator(TokenKind.Range) and
        BackendRangeMembershipPolicy::upper_operator(TokenKind.Range) == TokenKind.LtEq and
        BackendRangeMembershipPolicy::is_range_operator(TokenKind.RangeLe) and
        BackendRangeMembershipPolicy::upper_operator(TokenKind.RangeLe) == TokenKind.LtEq and
        BackendRangeMembershipPolicy::is_range_operator(TokenKind.RangeLt) and
        BackendRangeMembershipPolicy::upper_operator(TokenKind.RangeLt) == TokenKind.Lt

def greater_than_range_operator_is_not_modeled_for_membership() -> bool:
    ensure result == true
    return not BackendRangeMembershipPolicy::is_range_operator(TokenKind.RangeGt) and
        BackendRangeMembershipPolicy::upper_operator(TokenKind.RangeGt) == TokenKind.Error
