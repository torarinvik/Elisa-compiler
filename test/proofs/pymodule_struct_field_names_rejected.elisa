# False C field-name claims must not enter the admitted proof set.
include "../../src/driver/pymodule_struct_field_names.elisa"

def c_keyword_must_not_keep_its_source_spelling() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return PymoduleStructFieldNames::c_field_name("while") == "while"

def ordinary_name_must_not_be_mangled() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return PymoduleStructFieldNames::c_field_name("customer_id") == "elisa_pymodule_field_customer_id"
