# False controls for C-bind eligibility and owner-scoped C-layout marker recognition.
include "../../src/semantic/cbind_layout_policy.elisa"

def an_unrelated_decorator_is_a_c_bind() -> bool:
    ensure result == true
    return CBindLayoutPolicy::is_named_c_bind("align", "Point")

def an_ownerless_c_bind_is_eligible() -> bool:
    ensure result == true
    return CBindLayoutPolicy::is_named_c_bind("c_bind", "")

def an_soa_marker_is_a_c_layout_marker() -> bool:
    ensure result == true
    return CBindLayoutPolicy::marker_belongs_to_owner("__layout_soa", "Point", "Point")

def a_layout_marker_for_another_owner_matches() -> bool:
    ensure result == true
    return CBindLayoutPolicy::marker_belongs_to_owner("__layout_c", "Other", "Point")

def a_present_c_layout_still_needs_a_diagnostic() -> bool:
    ensure result == true
    return CBindLayoutPolicy::should_report_missing_layout(true)
