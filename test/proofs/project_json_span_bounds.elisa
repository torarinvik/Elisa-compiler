# The JSON key/value span uses subtraction before any potentially wrapping addition.
include "./frontend_ir_decode_bounds.elisa"

def json_span_index_is_inside_data(start: usize, length: usize, total: usize, index: usize) -> bool:
    requires start <= total
    requires length <= total - start
    requires index < length
    ensure result == true
    return start + index < total
