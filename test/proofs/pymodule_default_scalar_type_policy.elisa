# Source-linked proofs of the closed scalar type-name groups used by PyModule defaults.
include "../../src/driver/elisac_pymodule_default_scalar_type_policy.elisa"
include "../../src/driver/elisac_pymodule_default_hashable_policy.elisa"

def text_type_name_classifier_is_exact(type_name: sview) -> bool:
    ensure result == true
    return PymoduleDefaultScalarTypePolicy::is_text_type_name(type_name) == (when type_name:
        "cstr" | "sview" -> true
        _ -> false
    )

def float_type_name_classifier_is_exact(type_name: sview) -> bool:
    ensure result == true
    return PymoduleDefaultScalarTypePolicy::is_float_type_name(type_name) == (when type_name:
        "f32" | "f64" -> true
        _ -> false
    )

def signed_integer_type_name_classifier_is_exact(type_name: sview) -> bool:
    ensure result == true
    return PymoduleDefaultScalarTypePolicy::is_signed_integer_type_name(type_name) == (when type_name:
        "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "char" -> true
        _ -> false
    )

def unsigned_integer_type_name_classifier_is_exact(type_name: sview) -> bool:
    ensure result == true
    return PymoduleDefaultScalarTypePolicy::is_unsigned_integer_type_name(type_name) == (when type_name:
        "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" -> true
        _ -> false
    )

def scalar_type_groups_are_pairwise_disjoint(type_name: sview) -> bool:
    ensure result == true
    return (
        not (PymoduleDefaultScalarTypePolicy::is_text_type_name(type_name) and PymoduleDefaultScalarTypePolicy::is_float_type_name(type_name))
        and not (PymoduleDefaultScalarTypePolicy::is_text_type_name(type_name) and PymoduleDefaultScalarTypePolicy::is_signed_integer_type_name(type_name))
        and not (PymoduleDefaultScalarTypePolicy::is_text_type_name(type_name) and PymoduleDefaultScalarTypePolicy::is_unsigned_integer_type_name(type_name))
        and not (PymoduleDefaultScalarTypePolicy::is_float_type_name(type_name) and PymoduleDefaultScalarTypePolicy::is_signed_integer_type_name(type_name))
        and not (PymoduleDefaultScalarTypePolicy::is_float_type_name(type_name) and PymoduleDefaultScalarTypePolicy::is_unsigned_integer_type_name(type_name))
        and not (PymoduleDefaultScalarTypePolicy::is_signed_integer_type_name(type_name) and PymoduleDefaultScalarTypePolicy::is_unsigned_integer_type_name(type_name))
    )

def scalar_type_groups_plus_bool_equal_hashable_policy(type_name: sview) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            (
                PymoduleDefaultScalarTypePolicy::is_text_type_name(type_name)
                or PymoduleDefaultScalarTypePolicy::is_float_type_name(type_name)
                or PymoduleDefaultScalarTypePolicy::is_signed_integer_type_name(type_name)
                or PymoduleDefaultScalarTypePolicy::is_unsigned_integer_type_name(type_name)
                or type_name == "bool"
            )
            == PymoduleDefaultHashablePolicy::is_python_hashable_type(type_name)
        )
