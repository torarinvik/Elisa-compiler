def ordinary_field_names_are_preserved() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            PymoduleStructFieldNames::c_field_name("field") == "field"
            and PymoduleStructFieldNames::c_field_name("customer_id") == "customer_id"
            and PymoduleStructFieldNames::c_field_name("_Align") == "_Align"
            and PymoduleStructFieldNames::c_field_name("elisa_pymodule_field_int") == "elisa_pymodule_field_int"
            and PymoduleStructFieldNames::c_field_name("") == ""
        )
