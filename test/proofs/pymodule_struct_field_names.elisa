# Source-linked proof of safe C identifiers for generated Python struct fields.
include "../../src/driver/pymodule_struct_field_names.elisa"

def every_field_name_uses_the_exact_closed_mapping(field_name: sview) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        expected_name: sview = when field_name:
            "auto" -> "elisa_pymodule_field_auto"
            "break" -> "elisa_pymodule_field_break"
            "case" -> "elisa_pymodule_field_case"
            "char" -> "elisa_pymodule_field_char"
            "const" -> "elisa_pymodule_field_const"
            "continue" -> "elisa_pymodule_field_continue"
            "default" -> "elisa_pymodule_field_default"
            "do" -> "elisa_pymodule_field_do"
            "double" -> "elisa_pymodule_field_double"
            "else" -> "elisa_pymodule_field_else"
            "enum" -> "elisa_pymodule_field_enum"
            "extern" -> "elisa_pymodule_field_extern"
            "float" -> "elisa_pymodule_field_float"
            "for" -> "elisa_pymodule_field_for"
            "goto" -> "elisa_pymodule_field_goto"
            "if" -> "elisa_pymodule_field_if"
            "inline" -> "elisa_pymodule_field_inline"
            "int" -> "elisa_pymodule_field_int"
            "long" -> "elisa_pymodule_field_long"
            "register" -> "elisa_pymodule_field_register"
            "restrict" -> "elisa_pymodule_field_restrict"
            "return" -> "elisa_pymodule_field_return"
            "short" -> "elisa_pymodule_field_short"
            "signed" -> "elisa_pymodule_field_signed"
            "sizeof" -> "elisa_pymodule_field_sizeof"
            "static" -> "elisa_pymodule_field_static"
            "struct" -> "elisa_pymodule_field_struct"
            "switch" -> "elisa_pymodule_field_switch"
            "typedef" -> "elisa_pymodule_field_typedef"
            "union" -> "elisa_pymodule_field_union"
            "unsigned" -> "elisa_pymodule_field_unsigned"
            "void" -> "elisa_pymodule_field_void"
            "volatile" -> "elisa_pymodule_field_volatile"
            "while" -> "elisa_pymodule_field_while"
            "bool" -> "elisa_pymodule_field_bool"
            "true" -> "elisa_pymodule_field_true"
            "false" -> "elisa_pymodule_field_false"
            "nullptr" -> "elisa_pymodule_field_nullptr"
            "_Alignas" -> "elisa_pymodule_field_Alignas"
            "_Alignof" -> "elisa_pymodule_field_Alignof"
            "_Atomic" -> "elisa_pymodule_field_Atomic"
            "_Bool" -> "elisa_pymodule_field_Bool"
            "_Complex" -> "elisa_pymodule_field_Complex"
            "_Generic" -> "elisa_pymodule_field_Generic"
            "_Imaginary" -> "elisa_pymodule_field_Imaginary"
            "_Noreturn" -> "elisa_pymodule_field_Noreturn"
            "_Static_assert" -> "elisa_pymodule_field_Static_assert"
            "_Thread_local" -> "elisa_pymodule_field_Thread_local"
            "asm" -> "elisa_pymodule_field_asm"
            "typeof" -> "elisa_pymodule_field_typeof"
            "typeof_unqual" -> "elisa_pymodule_field_typeof_unqual"
            _ -> field_name
        return PymoduleStructFieldNames::c_field_name(field_name) == expected_name

def reserved_field_names_are_mangled_group_1() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            PymoduleStructFieldNames::c_field_name("auto") == "elisa_pymodule_field_auto"
            and PymoduleStructFieldNames::c_field_name("break") == "elisa_pymodule_field_break"
            and PymoduleStructFieldNames::c_field_name("case") == "elisa_pymodule_field_case"
            and PymoduleStructFieldNames::c_field_name("char") == "elisa_pymodule_field_char"
            and PymoduleStructFieldNames::c_field_name("const") == "elisa_pymodule_field_const"
            and PymoduleStructFieldNames::c_field_name("continue") == "elisa_pymodule_field_continue"
            and PymoduleStructFieldNames::c_field_name("default") == "elisa_pymodule_field_default"
            and PymoduleStructFieldNames::c_field_name("do") == "elisa_pymodule_field_do"
            and PymoduleStructFieldNames::c_field_name("double") == "elisa_pymodule_field_double"
            and PymoduleStructFieldNames::c_field_name("else") == "elisa_pymodule_field_else"
            and PymoduleStructFieldNames::c_field_name("enum") == "elisa_pymodule_field_enum"
            and PymoduleStructFieldNames::c_field_name("extern") == "elisa_pymodule_field_extern"
            and PymoduleStructFieldNames::c_field_name("float") == "elisa_pymodule_field_float"
            and PymoduleStructFieldNames::c_field_name("for") == "elisa_pymodule_field_for"
            and PymoduleStructFieldNames::c_field_name("goto") == "elisa_pymodule_field_goto"
            and PymoduleStructFieldNames::c_field_name("if") == "elisa_pymodule_field_if"
            and PymoduleStructFieldNames::c_field_name("inline") == "elisa_pymodule_field_inline"
            and PymoduleStructFieldNames::c_field_name("int") == "elisa_pymodule_field_int"
        )

