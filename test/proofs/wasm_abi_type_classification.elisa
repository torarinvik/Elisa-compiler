# Source-linked proof of the WASM binding class and core scalar for every type spelling.
include "../../src/driver/wasm_scalar_wasm_type.elisa"
include "../../src/driver/wasm_abi_type_classification.elisa"

def cstr_uses_the_string_i32_binding() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        actual: (binding: sview, wasm_type: sview) = WasmAbiTypeClassification::classify("cstr", false)
        return actual.binding == "string" and actual.wasm_type == "i32"

def pointer_types_use_the_i32_pointer_binding() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        actual: (binding: sview, wasm_type: sview) = WasmAbiTypeClassification::classify("Record&", false)
        return actual.binding == "pointer" and actual.wasm_type == "i32"

def scalar_types_preserve_the_canonical_wasm_type() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        narrow: (binding: sview, wasm_type: sview) = WasmAbiTypeClassification::classify("u16", false)
        wide: (binding: sview, wasm_type: sview) = WasmAbiTypeClassification::classify("i64", false)
        return narrow.binding == "scalar" and narrow.wasm_type == "i32" and wide.binding == "scalar" and wide.wasm_type == "i64"

def component_named_types_use_the_core_enum_representation() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        actual: (binding: sview, wasm_type: sview) = WasmAbiTypeClassification::classify("Color", true)
        return actual.binding == "scalar" and actual.wasm_type == "i32"

def unsupported_and_nullable_types_have_no_binding() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        unknown: (binding: sview, wasm_type: sview) = WasmAbiTypeClassification::classify("Color", false)
        nullable: (binding: sview, wasm_type: sview) = WasmAbiTypeClassification::classify("i32?", true)
        return unknown.binding == "" and unknown.wasm_type == "" and nullable.binding == "" and nullable.wasm_type == ""
