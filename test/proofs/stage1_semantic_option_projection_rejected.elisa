include "./stage1_semantic_option_projection.elisa"

def a_source_smt_header_can_be_ignored_when_the_environment_is_off() -> bool:
    requires_smt_header: bool = true
    options: Semantic::IncrementalSemanticOptions = stage1_semantic_options_from_observations(
        false, false, false, requires_smt_header, false, false,
        false, false, false, false, false
    )
    ensure result == true
    return not options.enable_smt

def permissive_mode_can_keep_mutable_global_grants_enforced() -> bool:
    permissive: bool = true
    options: Semantic::IncrementalSemanticOptions = stage1_semantic_options_from_observations(
        false, false, false, false, false, false,
        false, false, false, permissive, false
    )
    ensure result == true
    return options.enforce_mutable_global_grants
