# Prove the production x86 address-register width partition exactly.
include "../../src/backend/easm_address_width_policy.elisa"

def address_register_width_matches_its_exact_partition(register: sview) -> bool:
    ensure result == true
    return EasmAddressWidthPolicy::address_register_width(register) == (when register:
        "rax" | "rcx" | "rdx" | "rbx" | "rsi" | "rdi" | "rbp" | "rsp" | "r8" | "r9" | "r10" | "r11" | "r12" | "r13" | "r14" | "r15" -> EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_64
        "eax" | "ecx" | "edx" | "ebx" | "esi" | "edi" | "ebp" | "esp" | "r8d" | "r9d" | "r10d" | "r11d" | "r12d" | "r13d" | "r14d" | "r15d" -> EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_32
        _ -> EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_UNKNOWN
    )

def r15_is_a_64_bit_address_register() -> bool:
    ensure result == true
    return EasmAddressWidthPolicy::address_register_width("r15") == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_64

def r15d_is_a_32_bit_address_register() -> bool:
    ensure result == true
    return EasmAddressWidthPolicy::address_register_width("r15d") == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_32

def partial_and_instruction_pointer_registers_are_not_address_widths() -> bool:
    ensure result == true
    return (
        EasmAddressWidthPolicy::address_register_width("al") == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_UNKNOWN and
        EasmAddressWidthPolicy::address_register_width("rip") == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_UNKNOWN
    )
