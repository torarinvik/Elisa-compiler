# False schema claims for the two extern type nodes.
include "../../src/driver/frontend_ir_extern_type_encoding.elisa"

def reference_type_cannot_use_named_type_tag() -> bool:
    ensure result == true
    return (
        FrontendIrExternTypeEncoding::node_type_id(FrontendIrExternTypeEncoding::ExternTypeShape.ProvenanceRef)
        == FrontendIrExternTypeEncoding::NAMED_TYPE_NODE_TYPE_ID
    )

def shared_primary_field_slot_does_not_force_shared_node_tag() -> bool:
    ensure result == true
    return (
        FrontendIrExternTypeEncoding::primary_field_id(FrontendIrExternTypeEncoding::ExternTypeShape.Named)
            == FrontendIrExternTypeEncoding::primary_field_id(FrontendIrExternTypeEncoding::ExternTypeShape.ProvenanceRef)
        and FrontendIrExternTypeEncoding::node_type_id(FrontendIrExternTypeEncoding::ExternTypeShape.Named)
            == FrontendIrExternTypeEncoding::node_type_id(FrontendIrExternTypeEncoding::ExternTypeShape.ProvenanceRef)
    )

def named_type_cannot_use_reference_position_field() -> bool:
    ensure result == true
    return (
        FrontendIrExternTypeEncoding::position_field_id(FrontendIrExternTypeEncoding::ExternTypeShape.Named)
        == FrontendIrExternTypeEncoding::REF_TYPE_POSITION_FIELD_ID
    )
