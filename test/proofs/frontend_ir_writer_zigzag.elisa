# Arithmetic obligations for the writer's overflow-safe negative zigzag magnitude.
# The admission checker binds this expression to frontend_ir_write.elisa::ir_varint_out.

def writer_negative_zigzag_roundtrips(value: i64) -> bool:
    requires value < 0
    ensure result == true
    magnitude: i64 = 0 - (value + 1)
    return (0 - magnitude) - 1 == value

def writer_minimum_safe_negation_is_maximum() -> bool:
    ensure result == true
    return 0 - (((0 - 9223372036854775807) - 1) + 1) == 9223372036854775807
