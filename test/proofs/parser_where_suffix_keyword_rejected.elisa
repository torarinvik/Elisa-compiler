# These false source claims must remain unproved by the exact keyword classifier.
include "../../src/parser/parser_where_suffix_keyword.elisa"

def capitalized_where_is_recognized() -> bool:
    ensure result == true
    return ParserWhereSuffixKeyword::is_where_keyword("Where")

def a_keyword_prefix_is_recognized() -> bool:
    ensure result == true
    return ParserWhereSuffixKeyword::is_where_keyword("whereish")
