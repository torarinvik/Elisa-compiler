include "./backend_region_parameter_index_spec.elisa"

def a_region_parameter_slot_is_always_nonnegative(lines: darray[u32], names: darray[sview], line: u32, name: sview) -> bool:
    ensure result == true
    slot: i64 = BackendRegionParameterIndexSpec::region_parameter_index(lines, names, line, name)
    return slot >= 0
