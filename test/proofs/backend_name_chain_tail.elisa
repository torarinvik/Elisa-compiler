# The indexed name lookup's unindexed suffix must preserve the old first-match scan.
include "../../src/backend/codegen_name_chain_tail_policy.elisa"

extend BackendNameChainTailPolicy:
    public:
        def duplicate_names_select_the_first_row() -> bool:
            ensure result == true
            names: darray[sview] = ["Same", "Other", "Same"]
            can Abort.Panic:
                return first_match_index(names, "Same", 0) == 0

        def a_start_position_skips_earlier_matches() -> bool:
            ensure result == true
            names: darray[sview] = ["Same", "Other", "Same"]
            can Abort.Panic:
                return first_match_index(names, "Same", 1) == 2

        def a_missing_name_returns_the_absent_sentinel() -> bool:
            ensure result == true
            names: darray[sview] = ["Same", "Other"]
            can Abort.Panic:
                return first_match_index(names, "Missing", 0) == -1

        def starting_at_the_end_returns_the_absent_sentinel() -> bool:
            ensure result == true
            names: darray[sview] = ["Same", "Other"]
            can Abort.Panic:
                return first_match_index(names, "Other", names.count) == -1

        def starting_past_the_end_returns_the_absent_sentinel() -> bool:
            ensure result == true
            names: darray[sview] = ["Same", "Other"]
            can Abort.Panic:
                return first_match_index(names, "Other", names.count + 1.usize()) == -1
