include "./const_enum_storage_range_i32.elisa"

def false_const_enum_i32_accepts_below(value: i64) -> bool:
    requires value < (0 - 2147483648)
    ensure result == true
    return proof_const_enum_i32_fits(value)

def false_const_enum_i32_accepts_above(value: i64) -> bool:
    requires value > 2147483647
    ensure result == true
    return proof_const_enum_i32_fits(value)
