include "./backend_slice_bounds.elisa"

def false_claim_clamped_start_can_exceed_extent() -> bool:
    ensure result == true
    start: u64 = 9
    length: u64 = 4
    clamped_start: u64 = slice_start_clamp(start, length)
    return clamped_start > length

def false_claim_inverted_slice_has_positive_count() -> bool:
    ensure result == true
    start: u64 = 4
    end: u64 = 3
    length: u64 = 6
    count: u64 = slice_count_from_clamped_start(start, end, length)
    return count > 0

def false_claim_negative_string_start_is_nonzero() -> bool:
    ensure result == true
    start: i64 = -1
    normalised_start: u64 = string_slice_normalise_start(start)
    return normalised_start > 0

def false_claim_negative_string_end_becomes_zero() -> bool:
    ensure result == true
    end: i64 = -1
    length: u64 = 2
    normalised_end: u64 = string_slice_normalise_end(end, length)
    return normalised_end == 0

def false_claim_clamped_slice_window_crosses_extent() -> bool:
    ensure result == true
    start: u64 = 4
    end: u64 = 9
    length: u64 = 6
    count: u64 = slice_count_from_clamped_start(start, end, length)
    return start + count > length

def false_claim_slice_count_fits_undersized_target() -> bool:
    ensure result == true
    count: u64 = 4294967296
    source_length: u64 = 4294967296
    target_max: u64 = 4294967295
    return count <= target_max
