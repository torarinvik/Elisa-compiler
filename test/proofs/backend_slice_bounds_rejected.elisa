include "./backend_slice_bounds.elisa"

def false_claim_clamped_start_can_exceed_extent() -> bool:
    ensure result == true
    start: u64 = 9
    length: u64 = 4
    clamped_start: u64 = 4
    return clamped_start > length

def false_claim_inverted_slice_has_positive_count() -> bool:
    ensure result == true
    start: u64 = 4
    end: u64 = 3
    length: u64 = 6
    count: u64 = 0
    return count > 0

def false_claim_negative_string_start_is_nonzero() -> bool:
    ensure result == true
    start: i64 = -1
    normalised_start: u64 = 0
    return normalised_start > 0

def false_claim_negative_string_end_becomes_zero() -> bool:
    ensure result == true
    end: i64 = -1
    length: u64 = 2
    normalised_end: u64 = 2
    return normalised_end == 0
