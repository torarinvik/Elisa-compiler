# False claims that exercise comparator direction and equality.
include "./view_return_origin_order.elisa"

extend Semantic:
    public:
        def a_smaller_first_difference_is_reported_as_greater() -> bool can[Abort.Panic]:
            ensure result == false
            can Abort.Panic:
                return vro_text_compare("a", "b") > VRO_COMPARE_EQUAL

        def identical_keys_are_claimed_unequal() -> bool can[Abort.Panic]:
            ensure result == false
            can Abort.Panic:
                return vro_text_compare("same", "same") != VRO_COMPARE_EQUAL

        def a_shorter_prefix_is_claimed_greater() -> bool can[Abort.Panic]:
            ensure result == false
            can Abort.Panic:
                return vro_text_compare("key", "key-tail") > VRO_COMPARE_EQUAL

        def opposite_text_orders_are_claimed_equal() -> bool can[Abort.Panic]:
            ensure result == false
            can Abort.Panic:
                return vro_text_compare("a", "b") == vro_text_compare("b", "a")
