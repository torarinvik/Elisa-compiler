include "../../src/backend/codegen_const_checked_arithmetic.elisa"

def positive_add_boundary_is_accepted(left: i64, right: i64) -> bool:
    requires right > 0 and left <= BackendConstArithmetic::I64_MAX - right
    ensure result == true
    return BackendConstArithmetic::add_is_safe(left, right)

def negative_add_boundary_is_accepted(left: i64, right: i64) -> bool:
    requires right < 0 and left >= BackendConstArithmetic::I64_MIN - right
    ensure result == true
    return BackendConstArithmetic::add_is_safe(left, right)

def zero_add_is_accepted(left: i64) -> bool:
    ensure result == true
    return BackendConstArithmetic::add_is_safe(left, 0)

def accepted_addition_stays_within_i64(left: i64, right: i64) -> bool:
    requires right == 0 or (right > 0 and left <= BackendConstArithmetic::I64_MAX - right) or (right < 0 and left >= BackendConstArithmetic::I64_MIN - right)
    ensure result == true
    return left + right >= BackendConstArithmetic::I64_MIN and left + right <= BackendConstArithmetic::I64_MAX

def positive_add_overflow_is_rejected(left: i64, right: i64) -> bool:
    requires right > 0 and left > BackendConstArithmetic::I64_MAX - right
    ensure result == true
    return not BackendConstArithmetic::add_is_safe(left, right)

def negative_add_underflow_is_rejected(left: i64, right: i64) -> bool:
    requires right < 0 and left < BackendConstArithmetic::I64_MIN - right
    ensure result == true
    return not BackendConstArithmetic::add_is_safe(left, right)

def positive_subtract_boundary_is_accepted(left: i64, right: i64) -> bool:
    requires right > 0 and left >= BackendConstArithmetic::I64_MIN + right
    ensure result == true
    return BackendConstArithmetic::subtract_is_safe(left, right)

def negative_subtract_boundary_is_accepted(left: i64, right: i64) -> bool:
    requires right < 0 and left <= BackendConstArithmetic::I64_MAX + right
    ensure result == true
    return BackendConstArithmetic::subtract_is_safe(left, right)

def zero_subtract_is_accepted(left: i64) -> bool:
    ensure result == true
    return BackendConstArithmetic::subtract_is_safe(left, 0)

def accepted_subtraction_stays_within_i64(left: i64, right: i64) -> bool:
    requires right == 0 or (right > 0 and left >= BackendConstArithmetic::I64_MIN + right) or (right < 0 and left <= BackendConstArithmetic::I64_MAX + right)
    ensure result == true
    return left - right >= BackendConstArithmetic::I64_MIN and left - right <= BackendConstArithmetic::I64_MAX

# These obligations consume the production predicates as call preconditions. Their
# postconditions are the facts used by the folder before it evaluates the arithmetic.
def guarded_addition_result_is_i64(left: i64, right: i64) -> bool:
    requires BackendConstArithmetic::add_is_safe(left, right)
    ensure result == true
    return left + right >= BackendConstArithmetic::I64_MIN and left + right <= BackendConstArithmetic::I64_MAX

def guarded_subtraction_result_is_i64(left: i64, right: i64) -> bool:
    requires BackendConstArithmetic::subtract_is_safe(left, right)
    ensure result == true
    return left - right >= BackendConstArithmetic::I64_MIN and left - right <= BackendConstArithmetic::I64_MAX

def positive_subtract_overflow_is_rejected(left: i64, right: i64) -> bool:
    requires right < 0 and left > BackendConstArithmetic::I64_MAX + right
    ensure result == true
    return not BackendConstArithmetic::subtract_is_safe(left, right)

def negative_subtract_underflow_is_rejected(left: i64, right: i64) -> bool:
    requires right > 0 and left < BackendConstArithmetic::I64_MIN + right
    ensure result == true
    return not BackendConstArithmetic::subtract_is_safe(left, right)

def positive_positive_product_boundary_is_accepted(left: i64, right: i64) -> bool:
    requires left > 0 and right > 0 and left <= BackendConstArithmetic::I64_MAX / right
    ensure result == true
    return BackendConstArithmetic::multiply_is_safe(left, right)

def positive_negative_product_boundary_is_accepted(left: i64, right: i64) -> bool:
    requires left > 0 and right < 0 and right >= BackendConstArithmetic::I64_MIN / left
    ensure result == true
    return BackendConstArithmetic::multiply_is_safe(left, right)

def negative_positive_product_boundary_is_accepted(left: i64, right: i64) -> bool:
    requires left < 0 and right > 0 and left >= BackendConstArithmetic::I64_MIN / right
    ensure result == true
    return BackendConstArithmetic::multiply_is_safe(left, right)

def negative_negative_product_boundary_is_accepted(left: i64, right: i64) -> bool:
    requires left < 0 and right < 0 and left >= BackendConstArithmetic::I64_MAX / right
    ensure result == true
    return BackendConstArithmetic::multiply_is_safe(left, right)

def accepted_positive_positive_product_stays_within_i64(left: i64, right: i64) -> bool:
    requires left > 0 and right > 0 and left <= BackendConstArithmetic::I64_MAX / right
    ensure result == true
    return left * right >= 0 and left * right <= BackendConstArithmetic::I64_MAX

def accepted_positive_negative_product_stays_within_i64(left: i64, right: i64) -> bool:
    requires left > 0 and right < 0 and right >= BackendConstArithmetic::I64_MIN / left
    ensure result == true
    return left * right >= BackendConstArithmetic::I64_MIN and left * right <= 0

def accepted_negative_positive_product_stays_within_i64(left: i64, right: i64) -> bool:
    requires left < 0 and right > 0 and left >= BackendConstArithmetic::I64_MIN / right
    ensure result == true
    return left * right >= BackendConstArithmetic::I64_MIN and left * right <= 0

def accepted_negative_negative_product_stays_within_i64(left: i64, right: i64) -> bool:
    requires left < 0 and right < 0 and left >= BackendConstArithmetic::I64_MAX / right
    ensure result == true
    return left * right >= 0 and left * right <= BackendConstArithmetic::I64_MAX

def guarded_zero_product_is_exact(left: i64, right: i64) -> bool:
    requires BackendConstArithmetic::multiply_is_safe(left, right) and (left == 0 or right == 0)
    ensure result == true
    return left * right == 0

def guarded_positive_positive_product_is_i64(left: i64, right: i64) -> bool:
    requires BackendConstArithmetic::multiply_is_safe(left, right) and left > 0 and right > 0
    ensure result == true
    return left * right >= 0 and left * right <= BackendConstArithmetic::I64_MAX

def guarded_positive_negative_product_is_i64(left: i64, right: i64) -> bool:
    requires BackendConstArithmetic::multiply_is_safe(left, right) and left > 0 and right < 0
    ensure result == true
    return left * right >= BackendConstArithmetic::I64_MIN and left * right <= 0

def guarded_negative_positive_product_is_i64(left: i64, right: i64) -> bool:
    requires BackendConstArithmetic::multiply_is_safe(left, right) and left < 0 and right > 0
    ensure result == true
    return left * right >= BackendConstArithmetic::I64_MIN and left * right <= 0

def guarded_negative_negative_product_is_i64(left: i64, right: i64) -> bool:
    requires BackendConstArithmetic::multiply_is_safe(left, right) and left < 0 and right < 0
    ensure result == true
    return left * right >= 0 and left * right <= BackendConstArithmetic::I64_MAX

def positive_positive_product_overflow_is_rejected(left: i64, right: i64) -> bool:
    requires left > 0 and right > 0 and left > BackendConstArithmetic::I64_MAX / right
    ensure result == true
    return not BackendConstArithmetic::multiply_is_safe(left, right)

def positive_negative_product_overflow_is_rejected(left: i64, right: i64) -> bool:
    requires left > 0 and right < 0 and right < BackendConstArithmetic::I64_MIN / left
    ensure result == true
    return not BackendConstArithmetic::multiply_is_safe(left, right)

def negative_positive_product_overflow_is_rejected(left: i64, right: i64) -> bool:
    requires left < 0 and right > 0 and left < BackendConstArithmetic::I64_MIN / right
    ensure result == true
    return not BackendConstArithmetic::multiply_is_safe(left, right)

def negative_negative_product_overflow_is_rejected(left: i64, right: i64) -> bool:
    requires left < 0 and right < 0 and left < BackendConstArithmetic::I64_MAX / right
    ensure result == true
    return not BackendConstArithmetic::multiply_is_safe(left, right)

def zero_product_is_accepted(left: i64, right: i64) -> bool:
    requires left == 0 or right == 0
    ensure result == true
    return BackendConstArithmetic::multiply_is_safe(left, right)

def minimum_by_negative_one_is_rejected() -> bool:
    ensure result == true
    return not BackendConstArithmetic::multiply_is_safe(BackendConstArithmetic::I64_MIN, -1) and not BackendConstArithmetic::multiply_is_safe(-1, BackendConstArithmetic::I64_MIN)

def defined_division_operands_are_accepted(left: i64, right: i64) -> bool:
    requires right != 0 and (left != BackendConstArithmetic::I64_MIN or right != -1)
    ensure result == true
    return BackendConstArithmetic::division_is_safe(left, right)

def accepted_quotient_stays_within_i64(left: i64, right: i64) -> bool:
    requires right != 0 and (left != BackendConstArithmetic::I64_MIN or right != -1)
    ensure result == true
    return left / right >= BackendConstArithmetic::I64_MIN and left / right <= BackendConstArithmetic::I64_MAX

def guarded_quotient_stays_within_i64(left: i64, right: i64) -> bool:
    requires BackendConstArithmetic::division_is_safe(left, right)
    ensure result == true
    return left / right >= BackendConstArithmetic::I64_MIN and left / right <= BackendConstArithmetic::I64_MAX

def defined_remainder_operands_are_accepted(left: i64, right: i64) -> bool:
    requires right != 0 and (left != BackendConstArithmetic::I64_MIN or right != -1)
    ensure result == true
    return BackendConstArithmetic::remainder_is_safe(left, right)

def accepted_remainder_stays_within_i64(left: i64, right: i64) -> bool:
    requires right != 0 and (left != BackendConstArithmetic::I64_MIN or right != -1)
    ensure result == true
    return left % right >= BackendConstArithmetic::I64_MIN and left % right <= BackendConstArithmetic::I64_MAX

def guarded_remainder_stays_within_i64(left: i64, right: i64) -> bool:
    requires BackendConstArithmetic::remainder_is_safe(left, right)
    ensure result == true
    return left % right >= BackendConstArithmetic::I64_MIN and left % right <= BackendConstArithmetic::I64_MAX

def zero_divisor_is_rejected(left: i64) -> bool:
    ensure result == true
    return not BackendConstArithmetic::division_is_safe(left, 0) and not BackendConstArithmetic::remainder_is_safe(left, 0)

def minimum_division_pair_is_rejected() -> bool:
    ensure result == true
    return not BackendConstArithmetic::division_is_safe(BackendConstArithmetic::I64_MIN, -1) and not BackendConstArithmetic::remainder_is_safe(BackendConstArithmetic::I64_MIN, -1)

def nonminimum_negation_is_accepted(value: i64) -> bool:
    requires value != BackendConstArithmetic::I64_MIN
    ensure result == true
    return BackendConstArithmetic::negation_is_safe(value)

def accepted_negation_stays_within_i64(value: i64) -> bool:
    requires value != BackendConstArithmetic::I64_MIN
    ensure result == true
    return 0 - value >= BackendConstArithmetic::I64_MIN and 0 - value <= BackendConstArithmetic::I64_MAX

def guarded_negation_result_is_i64(value: i64) -> bool:
    requires BackendConstArithmetic::negation_is_safe(value)
    ensure result == true
    return 0 - value >= BackendConstArithmetic::I64_MIN and 0 - value <= BackendConstArithmetic::I64_MAX

def minimum_negation_is_rejected() -> bool:
    ensure result == true
    return not BackendConstArithmetic::negation_is_safe(BackendConstArithmetic::I64_MIN)

def zero_shift_count_is_accepted() -> bool:
    ensure result == true
    return BackendConstArithmetic::shift_count_is_safe(0)

def last_i64_shift_count_is_accepted() -> bool:
    ensure result == true
    return BackendConstArithmetic::shift_count_is_safe(BackendConstArithmetic::I64_SHIFT_WIDTH - 1)

def in_range_shift_count_is_accepted(count: i64) -> bool:
    requires count >= 0 and count < BackendConstArithmetic::I64_SHIFT_WIDTH
    ensure result == true
    return BackendConstArithmetic::shift_count_is_safe(count)

def guarded_shift_count_is_within_width(count: i64) -> bool:
    requires BackendConstArithmetic::shift_count_is_safe(count)
    ensure result == true
    return count >= 0 and count < BackendConstArithmetic::I64_SHIFT_WIDTH

def negative_shift_count_is_rejected(count: i64) -> bool:
    requires count < 0
    ensure result == true
    return not BackendConstArithmetic::shift_count_is_safe(count)

def oversized_shift_count_is_rejected(count: i64) -> bool:
    requires count >= BackendConstArithmetic::I64_SHIFT_WIDTH
    ensure result == true
    return not BackendConstArithmetic::shift_count_is_safe(count)
