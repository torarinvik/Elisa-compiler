# Direct proof of the production parser's token-to-precedence function.
include "./parser_token_kind_projection.elisa"
include "../../src/parser/parser_binary_precedence.elisa"

def production_precedence_matches_exact_decision_table(kind: Lexer::TokenKind) -> int:
    ensure result == (
        ParserBinaryPrecedence::ARROW_OR if kind == Lexer::TokenKind.Arrow or kind == Lexer::TokenKind.Or else
        ParserBinaryPrecedence::AND if kind == Lexer::TokenKind.And else
        ParserBinaryPrecedence::COMPARISON if kind == Lexer::TokenKind.EqEq or kind == Lexer::TokenKind.BangEq or kind == Lexer::TokenKind.Lt or kind == Lexer::TokenKind.Gt or kind == Lexer::TokenKind.LtEq or kind == Lexer::TokenKind.GtEq or kind == Lexer::TokenKind.In or kind == Lexer::TokenKind.Is or kind == Lexer::TokenKind.As else
        ParserBinaryPrecedence::RANGE if kind == Lexer::TokenKind.Range or kind == Lexer::TokenKind.RangeLt or kind == Lexer::TokenKind.RangeGt or kind == Lexer::TokenKind.RangeLe else
        ParserBinaryPrecedence::BITWISE_OR if kind == Lexer::TokenKind.Pipe else
        ParserBinaryPrecedence::BITWISE_XOR if kind == Lexer::TokenKind.Caret else
        ParserBinaryPrecedence::BITWISE_AND if kind == Lexer::TokenKind.Ampersand else
        ParserBinaryPrecedence::SHIFT if kind == Lexer::TokenKind.LShift or kind == Lexer::TokenKind.RShift else
        ParserBinaryPrecedence::ADDITIVE if kind == Lexer::TokenKind.Plus or kind == Lexer::TokenKind.Minus else
        ParserBinaryPrecedence::MULTIPLICATIVE if kind == Lexer::TokenKind.Star or kind == Lexer::TokenKind.Slash or kind == Lexer::TokenKind.Percent else
        0
    )
    return ParserBinaryPrecedence::precedence(kind)

def every_binary_operator_uses_its_named_precedence_level() -> bool:
    ensure result == true
    return (
        ParserBinaryPrecedence::precedence(Lexer::TokenKind.Arrow) == ParserBinaryPrecedence::ARROW_OR
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.Or) == ParserBinaryPrecedence::ARROW_OR
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.And) == ParserBinaryPrecedence::AND
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.EqEq) == ParserBinaryPrecedence::COMPARISON
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.BangEq) == ParserBinaryPrecedence::COMPARISON
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.Lt) == ParserBinaryPrecedence::COMPARISON
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.Gt) == ParserBinaryPrecedence::COMPARISON
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.LtEq) == ParserBinaryPrecedence::COMPARISON
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.GtEq) == ParserBinaryPrecedence::COMPARISON
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.In) == ParserBinaryPrecedence::COMPARISON
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.Is) == ParserBinaryPrecedence::COMPARISON
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.As) == ParserBinaryPrecedence::COMPARISON
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.Range) == ParserBinaryPrecedence::RANGE
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.RangeLt) == ParserBinaryPrecedence::RANGE
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.RangeGt) == ParserBinaryPrecedence::RANGE
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.RangeLe) == ParserBinaryPrecedence::RANGE
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.Pipe) == ParserBinaryPrecedence::BITWISE_OR
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.Caret) == ParserBinaryPrecedence::BITWISE_XOR
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.Ampersand) == ParserBinaryPrecedence::BITWISE_AND
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.LShift) == ParserBinaryPrecedence::SHIFT
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.RShift) == ParserBinaryPrecedence::SHIFT
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.Plus) == ParserBinaryPrecedence::ADDITIVE
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.Minus) == ParserBinaryPrecedence::ADDITIVE
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.Star) == ParserBinaryPrecedence::MULTIPLICATIVE
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.Slash) == ParserBinaryPrecedence::MULTIPLICATIVE
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.Percent) == ParserBinaryPrecedence::MULTIPLICATIVE
    )

def non_operator_tokens_keep_zero_precedence() -> bool:
    ensure result == true
    return (
        ParserBinaryPrecedence::precedence(Lexer::TokenKind.Eof) == 0
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.LShiftEq) == 0
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.RShiftEq) == 0
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.IntLit) == 0
        and ParserBinaryPrecedence::precedence(Lexer::TokenKind.Bang) == 0
    )
