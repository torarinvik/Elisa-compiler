# Scalar transition model for json_unicode_escape_scalar. `first` and `low` are
# the signed results of json_hex4; -1 denotes a malformed or truncated low unit.
def json_unicode_scalar_transition(first: i64, follows_unicode_escape: bool, low: i64) -> i64:
    requires first >= 0 and first <= 65535
    requires low >= -1 and low <= 65535
    ensure result == (
        65536 + (first - 55296) * 1024 + (low - 56320)
        if first >= 55296 and first <= 56319 and follows_unicode_escape and low >= 56320 and low <= 57343
        else (65533 if first >= 55296 and first <= 57343 else first)
    )
    ensure result >= 0
    ensure result <= 1114111
    ensure result < 55296 or result > 57343
    ensure (first >= 55296 and first <= 57343 and not (first >= 55296 and first <= 56319 and follows_unicode_escape and low >= 56320 and low <= 57343)) implies result == 65533
    return 65536 + (first - 55296) * 1024 + (low - 56320) if first >= 55296 and first <= 56319 and follows_unicode_escape and low >= 56320 and low <= 57343 else (65533 if first >= 55296 and first <= 57343 else first)

def json_unicode_cursor_delta(first: i64, follows_unicode_escape: bool, low: i64) -> i64:
    requires first >= 0 and first <= 65535
    requires low >= -1 and low <= 65535
    ensure result == (6 if first >= 55296 and first <= 56319 and follows_unicode_escape and low >= 56320 and low <= 57343 else 0)
    ensure result >= 0 and result <= 6
    return 6 if first >= 55296 and first <= 56319 and follows_unicode_escape and low >= 56320 and low <= 57343 else 0

def json_unicode_escape_total_delta(first: i64, follows_unicode_escape: bool, low: i64) -> i64:
    requires first >= 0 and first <= 65535
    requires low >= -1 and low <= 65535
    ensure result == (12 if first >= 55296 and first <= 56319 and follows_unicode_escape and low >= 56320 and low <= 57343 else 6)
    ensure result >= 6 and result <= 12
    return 12 if first >= 55296 and first <= 56319 and follows_unicode_escape and low >= 56320 and low <= 57343 else 6

# Every Unicode scalar selects exactly one of the ordered UTF-8 width ranges.
# The source checker below ties these limits to both production encoder paths.
def json_unicode_scalar_utf8_width(code: i64) -> i64:
    requires code >= 0 and code <= 1114111
    ensure result == (1 if code < 128 else (2 if code < 2048 else (3 if code < 65536 else 4)))
    ensure result >= 1 and result <= 4
    return 1 if code < 128 else (2 if code < 2048 else (3 if code < 65536 else 4))
