include "./sview_index_bounds.elisa"

def false_claim_accepts_a_negative_index(length: i64, index: i64, length_fits_usize: bool, index_fits_usize: bool) -> bool:
    requires index < 0
    ensure result == true
    return sview_index_guard(length, index, length_fits_usize, index_fits_usize)

def false_claim_accepts_the_one_past_end_index(length: i64, length_fits_usize: bool, index_fits_usize: bool) -> bool:
    requires length >= 0
    ensure result == true
    return sview_index_guard(length, length, length_fits_usize, index_fits_usize)

def false_claim_accepts_an_unrepresentable_length(length: i64, index: i64, length_fits_usize: bool, index_fits_usize: bool) -> bool:
    requires not length_fits_usize
    ensure result == true
    return sview_index_guard(length, index, length_fits_usize, index_fits_usize)

def false_claim_accepts_an_unrepresentable_index(length: i64, index: i64, length_fits_usize: bool, index_fits_usize: bool) -> bool:
    requires not index_fits_usize
    ensure result == true
    return sview_index_guard(length, index, length_fits_usize, index_fits_usize)
