include "./sview_index_bounds.elisa"

def false_claim_accepts_a_negative_length(length: i64, index: i64, length_usize: usize, index_usize: usize) -> bool:
    requires length < 0
    ensure result == true
    return sview_index_guard(length, index, length_usize, index_usize)

def false_claim_accepts_a_negative_index(length: i64, index: i64, length_usize: usize, index_usize: usize) -> bool:
    requires length >= 0 and length_usize.i64() == length and index < 0
    ensure result == true
    return sview_index_guard(length, index, length_usize, index_usize)

def false_claim_accepts_the_one_past_end_index(length: i64, length_usize: usize) -> bool:
    requires length >= 0 and length_usize.i64() == length
    ensure result == true
    return sview_index_guard(length, length, length_usize, length_usize)

def false_claim_accepts_an_unrepresentable_length(length: i64, index: i64, length_usize: usize, index_usize: usize) -> bool:
    requires length >= 0 and length_usize.i64() != length
    requires index >= 0 and index < length and index_usize.i64() == index
    ensure result == true
    return sview_index_guard(length, index, length_usize, index_usize)

def false_claim_accepts_an_unrepresentable_index(length: i64, index: i64, length_usize: usize, index_usize: usize) -> bool:
    requires length >= 0 and length_usize.i64() == length
    requires index >= 0 and index < length and index_usize.i64() != index
    ensure result == true
    return sview_index_guard(length, index, length_usize, index_usize)
