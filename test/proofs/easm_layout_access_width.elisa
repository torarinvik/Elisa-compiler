# EASM layout policy: zero width means unknown, negative means absent, and a
# positive declared width must match the machine access width.
def layout_access_width_is_valid(declared_width: i64, access_width: i64) -> bool:
    ensure result == (declared_width >= 0 and (declared_width == 0 or declared_width == access_width))
    return declared_width >= 0 and (declared_width == 0 or declared_width == access_width)

def unknown_layout_width_allows_access(declared_width: i64, access_width: i64) -> bool:
    requires declared_width == 0
    ensure result == true
    return declared_width >= 0 and (declared_width == 0 or declared_width == access_width)

def missing_layout_width_rejects_access(declared_width: i64, access_width: i64) -> bool:
    requires declared_width < 0
    ensure result == true
    return not layout_access_width_is_valid(declared_width, access_width)

def matching_layout_width_allows_access(width: i64) -> bool:
    requires width > 0
    ensure result == true
    return layout_access_width_is_valid(width, width)

def four_byte_field_rejects_eight_byte_access(declared_width: i64, access_width: i64) -> bool:
    requires declared_width == 4 and access_width == 8
    ensure result == true
    return not layout_access_width_is_valid(declared_width, access_width)

def eight_byte_field_rejects_four_byte_access(declared_width: i64, access_width: i64) -> bool:
    requires declared_width == 8 and access_width == 4
    ensure result == true
    return not layout_access_width_is_valid(declared_width, access_width)
