# These false claims make sure the recursive first-match specification stays active.
include "./backend_name_chain_tail.elisa"

extend BackendNameChainTailPolicy:
    public:
        def a_duplicate_name_does_not_select_the_last_row() -> bool:
            ensure result == true
            names: darray[sview] = ["Same", "Other", "Same"]
            can Abort.Panic:
                return first_match_index(names, "Same", 0) == 2

        def a_missing_name_does_not_return_a_row() -> bool:
            ensure result == false
            names: darray[sview] = ["Same", "Other"]
            can Abort.Panic:
                return first_match_index(names, "Missing", 0) >= 0
