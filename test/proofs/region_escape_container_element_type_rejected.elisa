def explicit_scalar_annotation_falls_back_to_nested_inferred_type(annotation_is_scalar: bool,
    inferred_type_has_container_elements: bool) -> bool:
    requires annotation_is_scalar and inferred_type_has_container_elements
    ensure result == true
    return annotation_is_scalar

def unsupported_container_head_is_treated_as_darray_or_dict(head_is_darray_or_dict: bool,
    element_annotation_is_container: bool) -> bool:
    requires not head_is_darray_or_dict
    ensure result == true
    return head_is_darray_or_dict and element_annotation_is_container
