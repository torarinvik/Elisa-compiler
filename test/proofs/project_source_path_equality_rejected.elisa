# These false claims would let a path prefix or unequal byte span alias a graph node.
include "./project_source_path_equality.elisa"

def a_valid_span_copy_can_have_the_wrong_length(source: darray[u8]&, start: usize, length: usize) -> bool can[Memory.Allocate, Abort.Panic]:
    requires start <= source.count and length <= source.count - start
    requires length > 0.usize()
    ensures result == true
    copied: darray[u8] = bytes_span_copy_model(source, start, length)
    return copied.count != length

def different_lengths_can_compare_equal(left: darray[u8]&, left_start: usize, length: usize, right: darray[u8]&) -> bool:
    requires left_start <= left.count and length <= left.count - left_start
    requires length != right.count
    ensures result == true
    return bytes_span_equal_model(left, left_start, length, right)

def a_different_byte_can_compare_equal(left: darray[u8]&, left_start: usize, length: usize, right: darray[u8]&, mismatch: usize) -> bool:
    requires left_start <= left.count and length <= left.count - left_start
    requires length == right.count and mismatch < length
    requires left[left_start + mismatch] != right[mismatch]
    ensures result == true
    return bytes_span_equal_model(left, left_start, length, right)

def a_short_prefix_can_match_the_full_path(first: u8, second: u8, suffix: u8) -> bool:
    ensures result == true
    stored: darray[u8] = [first, second, suffix]
    requested: darray[u8] = [first, second]
    return bytes_span_equal_model(stored, 0.usize(), stored.count, requested)
