const PROOF_NO_REGION_BINDING: u32 = 0
const PROOF_DESTROYED_REGION_ALL: u32 = 0
const PROOF_UNKNOWN_REGION_DEPENDENCY: u32 = 4294967293

ghost def proof_destroyed_region_member_from(regions: darray[u32], candidate: u32, index: usize) -> bool:
    requires index <= regions.count
    decreases regions.count - index
    return false if index == regions.count
    return true if regions[index] == candidate or regions[index] == PROOF_DESTROYED_REGION_ALL
    return proof_destroyed_region_member_from(regions, candidate, index + 1)

ghost def proof_destroyed_region_id_reference(regions: darray[u32], candidate: u32) -> bool:
    return false if candidate == PROOF_NO_REGION_BINDING
    return true if candidate == PROOF_UNKNOWN_REGION_DEPENDENCY and regions.count > 0
    return proof_destroyed_region_member_from(regions, candidate, 0)

def proof_destroyed_region_id_model(regions: darray[u32], candidate: u32) -> bool:
    ensure result == proof_destroyed_region_id_reference(regions, candidate)
    return false if candidate == PROOF_NO_REGION_BINDING
    return true if candidate == PROOF_UNKNOWN_REGION_DEPENDENCY and regions.count > 0
    index: mutable usize = 0
    while index < regions.count |index, regions, candidate|:
        decreases regions.count - index
        invariant index <= regions.count
        invariant proof_destroyed_region_member_from(regions, candidate, index) == proof_destroyed_region_member_from(regions, candidate, 0)
        return true if regions[index] == candidate or regions[index] == PROOF_DESTROYED_REGION_ALL
        index <- index + 1
    return false

def no_region_binding_is_reported_destroyed(regions: darray[u32]) -> bool:
    ensure result == true
    ensure proof_destroyed_region_id_model(regions, PROOF_NO_REGION_BINDING) == true
    return true

def empty_unknown_dependency_is_reported_destroyed() -> bool:
    regions: darray[u32] = []
    ensure result == true
    ensure proof_destroyed_region_id_model(regions, PROOF_UNKNOWN_REGION_DEPENDENCY) == true
    return true

def unmatched_nonzero_binding_is_reported_destroyed() -> bool:
    regions: darray[u32] = [4, 8, 12]
    ensure result == true
    ensure proof_destroyed_region_id_model(regions, 19) == true
    return true
