# Source-linked proofs for the finite token sets used by AST and doc rendering.
include "./parser_token_kind_projection.elisa"
include "../../src/driver/driver_token_classification.elisa"

def source_ast_spacing_token_match_is_exact(kind: Lexer::TokenKind) -> bool can[Abort.Panic]:
    ensure result == (kind == Lexer::TokenKind.Heap or kind == Lexer::TokenKind.Stack or kind == Lexer::TokenKind.Static or kind == Lexer::TokenKind.Mutable or kind == Lexer::TokenKind.Tail)
    can Abort.Panic:
        return DriverTokenClassification::needs_ast_token_space(kind)

def all_ast_spacing_tokens_are_recognized() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            DriverTokenClassification::needs_ast_token_space(Lexer::TokenKind.Heap)
            and DriverTokenClassification::needs_ast_token_space(Lexer::TokenKind.Stack)
            and DriverTokenClassification::needs_ast_token_space(Lexer::TokenKind.Static)
            and DriverTokenClassification::needs_ast_token_space(Lexer::TokenKind.Mutable)
            and DriverTokenClassification::needs_ast_token_space(Lexer::TokenKind.Tail)
        )

def nearby_ast_tokens_need_no_extra_space() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            not DriverTokenClassification::needs_ast_token_space(Lexer::TokenKind.Ident)
            and not DriverTokenClassification::needs_ast_token_space(Lexer::TokenKind.Is)
            and not DriverTokenClassification::needs_ast_token_space(Lexer::TokenKind.Ampersand)
            and not DriverTokenClassification::needs_ast_token_space(Lexer::TokenKind.Arrow)
        )

def source_doc_operator_token_match_is_exact(kind: Lexer::TokenKind) -> bool can[Abort.Panic]:
    ensure result == (kind == Lexer::TokenKind.EqEq or kind == Lexer::TokenKind.BangEq or kind == Lexer::TokenKind.Lt or kind == Lexer::TokenKind.Gt or kind == Lexer::TokenKind.LtEq or kind == Lexer::TokenKind.GtEq or kind == Lexer::TokenKind.And or kind == Lexer::TokenKind.Or or kind == Lexer::TokenKind.Plus or kind == Lexer::TokenKind.Minus or kind == Lexer::TokenKind.Star or kind == Lexer::TokenKind.Slash)
    can Abort.Panic:
        return DriverTokenClassification::is_doc_binary_operator(kind)

def every_binary_operator_is_recognized() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            DriverTokenClassification::is_doc_binary_operator(Lexer::TokenKind.EqEq)
            and DriverTokenClassification::is_doc_binary_operator(Lexer::TokenKind.BangEq)
            and DriverTokenClassification::is_doc_binary_operator(Lexer::TokenKind.Lt)
            and DriverTokenClassification::is_doc_binary_operator(Lexer::TokenKind.Gt)
            and DriverTokenClassification::is_doc_binary_operator(Lexer::TokenKind.LtEq)
            and DriverTokenClassification::is_doc_binary_operator(Lexer::TokenKind.GtEq)
            and DriverTokenClassification::is_doc_binary_operator(Lexer::TokenKind.And)
            and DriverTokenClassification::is_doc_binary_operator(Lexer::TokenKind.Or)
            and DriverTokenClassification::is_doc_binary_operator(Lexer::TokenKind.Plus)
            and DriverTokenClassification::is_doc_binary_operator(Lexer::TokenKind.Minus)
            and DriverTokenClassification::is_doc_binary_operator(Lexer::TokenKind.Star)
            and DriverTokenClassification::is_doc_binary_operator(Lexer::TokenKind.Slash)
        )

def nearby_doc_tokens_are_not_binary_operators() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            not DriverTokenClassification::is_doc_binary_operator(Lexer::TokenKind.Assign)
            and not DriverTokenClassification::is_doc_binary_operator(Lexer::TokenKind.Dot)
            and not DriverTokenClassification::is_doc_binary_operator(Lexer::TokenKind.Range)
            and not DriverTokenClassification::is_doc_binary_operator(Lexer::TokenKind.Ellipsis)
        )
