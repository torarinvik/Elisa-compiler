# Source-linked step laws for the lexical region-stack lookup loop.

def stack_scan_found_update_is_exact(previously_found: bool, current_probe_matches: bool) -> bool:
    ensure result == (previously_found or current_probe_matches)
    return previously_found or current_probe_matches

def a_match_sets_stack_scan_found() -> bool:
    ensure result == true
    return stack_scan_found_update_is_exact(false, true)

def a_nonmatch_preserves_an_earlier_stack_match() -> bool:
    ensure result == true
    return stack_scan_found_update_is_exact(true, false)

def stack_scan_position_update_is_exact(previous_position: usize,
    current_probe: usize,
    current_probe_matches: bool) -> usize:
    ensure result == (current_probe if current_probe_matches else previous_position)
    return current_probe if current_probe_matches else previous_position

def a_matching_probe_becomes_the_recorded_position(previous_position: usize,
    current_probe: usize) -> bool:
    ensure result == true
    return stack_scan_position_update_is_exact(previous_position, current_probe, true) == current_probe

def a_nonmatching_probe_preserves_the_recorded_position(previous_position: usize,
    current_probe: usize) -> bool:
    ensure result == true
    return stack_scan_position_update_is_exact(previous_position, current_probe, false) == previous_position

def a_later_matching_probe_overwrites_an_earlier_match(previous_position: usize,
    current_probe: usize) -> bool:
    requires previous_position < current_probe
    ensure result == true
    return stack_scan_position_update_is_exact(previous_position, current_probe, true) > previous_position

def an_unmatched_empty_scan_keeps_the_zero_position() -> bool:
    ensure result == true
    return stack_scan_position_update_is_exact(0, 0, false) == 0
