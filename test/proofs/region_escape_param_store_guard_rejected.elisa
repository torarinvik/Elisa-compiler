include "./region_escape_param_store_guard.elisa"

def storing_between_distinct_region_parameters_is_safe() -> bool:
    ensure result == false
    return distinct_region_parameter_store_guard_is_exact(true, true, true)

def storing_within_the_same_region_parameter_is_an_escape() -> bool:
    ensure result == true
    return distinct_region_parameter_store_guard_is_exact(true, true, false)
