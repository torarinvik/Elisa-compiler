# Declaration positions are exhaustive too: every concrete declaration keeps
# its stored span, while the invalid recovery node uses the zero-line sentinel.
include "../../src/parser/parser_tokens.elisa"
using Ast

def decl_pos_matches_the_owned_span_for_every_variant(declaration: Decl) -> bool:
    ensure result == true
    actual: Pos = Ast::decl_pos(declaration)
    match declaration:
        Decl.Invalid:
            return Ast::pos_equal(actual, Ast::pos_at_line(0))
        Decl.Func(_, _, _, _, _, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Decl.Struct(_, _, _, _, _, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Decl.Enum(_, _, _, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Decl.Alias(_, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Decl.Law(_, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Decl.Import(_, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Decl.Scoped(_, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Decl.Extern(_, _, _, _, _, _, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Decl.Const(_, _, _, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Decl.Module(_, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
