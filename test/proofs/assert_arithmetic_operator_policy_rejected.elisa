include "./assert_arithmetic_operator_policy.elisa"

def equality_is_an_arithmetic_operator() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return AssertArithmeticOperatorPolicy::is_arithmetic(Lexer::TokenKind.EqEq)

def logical_and_is_an_arithmetic_operator() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return AssertArithmeticOperatorPolicy::is_arithmetic(Lexer::TokenKind.And)
