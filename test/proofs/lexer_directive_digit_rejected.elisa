# False claims challenge the ASCII digit table used by #line parsing.
include "../../src/lexer/lexer_directive_digit.elisa"

def ascii_nine_maps_to_eight() -> bool:
    ensure result == true
    return LexerDirectiveDigit::decimal_digit_value(57) == 8

def punctuation_maps_to_a_nonzero_value() -> bool:
    ensure result == true
    return LexerDirectiveDigit::decimal_digit_value(46) != 0

def byte_below_digit_range_maps_to_one() -> bool:
    ensure result == true
    return LexerDirectiveDigit::decimal_digit_value(47) == 1

def byte_above_digit_range_maps_to_one() -> bool:
    ensure result == true
    return LexerDirectiveDigit::decimal_digit_value(58) == 1
