include "./backend_generic_call_slice_bounds.elisa"

def false_claim_one_past_offset_is_inside_the_slice(total: u64, start: u64, count: u64, offset: u64) -> bool:
    requires offset == count
    ensure result == true
    return offset < count

def false_claim_narrowed_row_still_identifies_the_original(row: i64, converted_row: i64) -> bool:
    requires row >= 0 and converted_row != row
    ensure result == true
    return converted_row == row

def false_claim_narrowed_generic_slot_keeps_its_name(slot: i64, converted_slot: i64) -> bool:
    requires slot >= 0 and converted_slot != slot
    ensure result == true
    return converted_slot == slot
