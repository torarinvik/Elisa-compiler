include "./backend_chunks_exact_validation.elisa"

def false_claim_zero_chunk_size_is_accepted(remainder_is_zero: bool) -> bool:
    ensure result == true
    return chunks_exact_guard(chunks_exact_size_is_valid(0, true), remainder_is_zero)

def false_claim_negative_signed_chunk_size_is_accepted(chunk_size: i64, remainder_is_zero: bool) -> bool:
    requires chunk_size < 0
    ensure result == true
    return chunks_exact_guard(chunks_exact_size_is_valid(chunk_size, true), remainder_is_zero)

def false_claim_nondivisible_input_is_accepted(size_valid: bool) -> bool:
    ensure result == true
    return chunks_exact_guard(size_valid, false)
