include "./backend_chunks_exact_validation.elisa"

def false_claim_zero_chunk_size_is_accepted(remainder_is_zero: bool) -> bool:
    ensure result == true
    return chunks_exact_guard(chunks_exact_size_is_valid(0, 0, true, true), remainder_is_zero)

def false_claim_negative_signed_chunk_size_is_accepted(source_size: i64, target_size: usize, fits_target: bool, remainder_is_zero: bool) -> bool:
    requires source_size < 0
    ensure result == true
    return chunks_exact_guard(chunks_exact_size_is_valid(source_size, target_size, true, fits_target), remainder_is_zero)

def false_claim_nondivisible_input_is_accepted(size_valid: bool) -> bool:
    ensure result == true
    return chunks_exact_guard(size_valid, false)

def false_claim_wasm32_high_source_roundtrips(source_size: i64, roundtrip: i64) -> bool:
    requires source_size > 4294967295
    requires roundtrip >= 0 and roundtrip <= 4294967295
    ensure result == true
    return roundtrip == source_size

def false_claim_one_past_chunk_is_in_bounds(total: usize, chunk_size: usize, index: usize) -> bool:
    requires chunk_size > 0
    requires index == total / chunk_size
    ensure result == true
    return index * chunk_size + chunk_size <= total
