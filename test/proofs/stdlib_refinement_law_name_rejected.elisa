include "./stdlib_refinement_law_name.elisa"

def string_type_is_a_stdlib_refinement_law() -> bool:
    ensure result == true
    return StdlibRefinementLawName::is_stdlib_refinement_law("String")

def nonempty_is_not_a_stdlib_refinement_law() -> bool:
    ensure result == true
    return not StdlibRefinementLawName::is_stdlib_refinement_law("NonEmpty")
