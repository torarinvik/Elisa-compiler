include "./frontend_ir_for_statement_encoding.elisa"

def parallel_loop_binding_must_be_serializable() -> bool:
    ensure result == true
    return FrontendIrForStatementEncoding::binding_and_source_are_supported(
        FrontendIrForStatementEncoding::binding_mode("parallel"), false
    )

def mutable_move_source_must_be_serializable() -> bool:
    ensure result == true
    return FrontendIrForStatementEncoding::binding_and_source_are_supported(
        FrontendIrForStatementEncoding::binding_mode("mutable"), true
    )
