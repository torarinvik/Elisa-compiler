# The #line scanner maps each ASCII decimal character to its numeric value.
include "../../src/lexer/lexer_directive_digit.elisa"

def every_ascii_decimal_digit_byte_maps_to_its_offset(character: u8) -> bool:
    requires character >= 48 and character <= 57
    ensure result == true
    ensure LexerDirectiveDigit::decimal_digit_value(character) == (character - 48).int()
    return true

def every_ascii_decimal_digit_byte_maps_into_zero_through_nine(character: u8) -> bool:
    requires character >= 48 and character <= 57
    ensure result == true
    return LexerDirectiveDigit::decimal_digit_value(character) >= 0 and LexerDirectiveDigit::decimal_digit_value(character) <= 9

def ascii_zero_maps_to_zero() -> bool:
    ensure result == true
    return LexerDirectiveDigit::decimal_digit_value(48) == 0

def ascii_nine_maps_to_nine() -> bool:
    ensure result == true
    return LexerDirectiveDigit::decimal_digit_value(57) == 9

def byte_below_digit_range_maps_to_zero() -> bool:
    ensure result == true
    return LexerDirectiveDigit::decimal_digit_value(47) == 0

def byte_above_digit_range_maps_to_zero() -> bool:
    ensure result == true
    return LexerDirectiveDigit::decimal_digit_value(58) == 0

def every_byte_below_digit_range_maps_to_zero(character: u8) -> bool:
    requires character < 48
    ensure result == true
    ensure LexerDirectiveDigit::decimal_digit_value(character) == 0
    return true

def every_byte_above_digit_range_maps_to_zero(character: u8) -> bool:
    requires character > 57
    ensure result == true
    ensure LexerDirectiveDigit::decimal_digit_value(character) == 0
    return true

def punctuation_maps_to_zero() -> bool:
    ensure result == true
    return LexerDirectiveDigit::decimal_digit_value(46) == 0
