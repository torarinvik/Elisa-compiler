include "./backend_smul64_fallback.elisa"

# These false claims model the two unsafe simplifications the implementation
# must avoid: using the original zero divisor and leaving MIN * -1 at -1.
def false_claim_unchecked_left_is_always_nonzero(left: i64, right: i64) -> bool:
    ensure result == true
    divisor: i64 = left
    return divisor != 0

def false_claim_min_neg_one_corner_keeps_minus_one(left: i64, right: i64) -> bool:
    requires left == (0 - 1) and right == I64_MIN
    ensure result == true
    divisor: i64 = left
    return divisor == 1
