# Arithmetic model for SourceIdentity::path_for_line once its upper-bound search
# selects an entry at or before the requested line. The checker binds the
# conditional offset guard to the production search and its monotone line-map input.
const SOURCE_LINE_U32_MAX: i64 = 4294967295

def source_line_offset_fits(selected_flat_line: i64, requested_flat_line: i64, original_line: i64) -> bool:
    requires 0 <= selected_flat_line and selected_flat_line <= requested_flat_line and requested_flat_line <= SOURCE_LINE_U32_MAX and 0 <= original_line and original_line <= SOURCE_LINE_U32_MAX
    ensure result == (original_line <= SOURCE_LINE_U32_MAX - (requested_flat_line - selected_flat_line))
    delta: i64 = requested_flat_line - selected_flat_line
    return original_line <= SOURCE_LINE_U32_MAX - delta

def accepted_source_line_cannot_overflow(selected_flat_line: i64, requested_flat_line: i64, original_line: i64) -> bool:
    requires 0 <= selected_flat_line and selected_flat_line <= requested_flat_line and requested_flat_line <= SOURCE_LINE_U32_MAX and 0 <= original_line and original_line <= SOURCE_LINE_U32_MAX and original_line <= SOURCE_LINE_U32_MAX - (requested_flat_line - selected_flat_line)
    ensure result == true
    delta: i64 = requested_flat_line - selected_flat_line
    return source_line_offset_fits(selected_flat_line, requested_flat_line, original_line) and original_line + delta <= SOURCE_LINE_U32_MAX

def overflowing_source_line_is_rejected(selected_flat_line: i64, requested_flat_line: i64, original_line: i64) -> bool:
    requires 0 <= selected_flat_line and selected_flat_line <= requested_flat_line and requested_flat_line <= SOURCE_LINE_U32_MAX and 0 <= original_line and original_line <= SOURCE_LINE_U32_MAX and original_line > SOURCE_LINE_U32_MAX - (requested_flat_line - selected_flat_line)
    ensure result == true
    delta: i64 = requested_flat_line - selected_flat_line
    return original_line > SOURCE_LINE_U32_MAX - delta

def exact_u32_limit_is_accepted() -> bool:
    ensure result == true
    delta: i64 = 11 - 10
    return 4294967294 <= SOURCE_LINE_U32_MAX - delta and 4294967294 + delta == SOURCE_LINE_U32_MAX

def one_past_u32_limit_is_rejected() -> bool:
    ensure result == true
    delta: i64 = 11 - 10
    return SOURCE_LINE_U32_MAX > SOURCE_LINE_U32_MAX - delta

def selected_line_offset_stays_in_u32(selected_flat_line: i64, requested_flat_line: i64) -> bool:
    requires 0 <= selected_flat_line and selected_flat_line <= requested_flat_line and requested_flat_line <= SOURCE_LINE_U32_MAX
    ensure result == true
    return 0 <= requested_flat_line - selected_flat_line and requested_flat_line - selected_flat_line <= SOURCE_LINE_U32_MAX
