# The backend switches aggregate values to pointer passing at 1024 bytes.
def aggregate_uses_indirect_abi(is_aggregate: bool, llvm_abi_size: i64) -> bool:
    requires llvm_abi_size >= 0
    ensure result == (is_aggregate and llvm_abi_size >= 1024)
    return is_aggregate and llvm_abi_size >= 1024

def aggregate_at_threshold_is_indirect(size: i64) -> bool:
    requires size == 1024
    ensure result
    return size >= 1024

def aggregate_below_threshold_is_direct(size: i64) -> bool:
    requires size >= 0 and size < 1024
    ensure not result
    return size >= 1024

def scalar_never_uses_indirect_aggregate_abi(size: i64) -> bool:
    requires size >= 0
    ensure not result
    return false
