# Primitive byte-order laws used at the first differing byte of an error-family name.
ghost def byte_less_is_asymmetric(left: u8, right: u8) -> bool:
    ensure result == true
    return not (left < right and right < left)

ghost def byte_less_is_transitive(left: u8, middle: u8, right: u8) -> bool:
    ensure result == true
    return not (left < middle and middle < right) or left < right

ghost def byte_order_is_total(left: u8, right: u8) -> bool:
    ensure result == true
    return left < right or right < left or left == right
