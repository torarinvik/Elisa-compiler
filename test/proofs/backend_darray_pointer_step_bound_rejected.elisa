include "./backend_darray_pointer_step_bound.elisa"

def false_cursor_step_exceeds_snapshot(count: u64, cursor: u64) -> bool:
    requires cursor < count
    ensure result == true
    return cursor + 1 > count

def false_cursor_step_does_not_advance(count: u64, cursor: u64) -> bool:
    requires cursor < count
    ensure result == true
    return cursor + 1 <= cursor

def false_remaining_is_positive_at_the_end(count: u64, cursor: u64) -> bool:
    requires cursor == count
    ensure result == true
    return count - cursor > 0

def false_remaining_does_not_decrease_with_cursor(count: u64, cursor: u64) -> bool:
    requires cursor < count
    ensure result == true
    return count - (cursor + 1) >= count - cursor

def false_zero_count_has_positive_next_count() -> bool:
    ensure result == true
    return 0.u64() - 1.u64() > 0.u64()

def false_positive_countdown_step_wraps_below_zero(remaining: u64) -> bool:
    requires remaining > 0
    ensure result == true
    return remaining - 1 < 0
