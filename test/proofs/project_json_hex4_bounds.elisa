# Scalar models for the JSON reader's bounded byte access, nibble classifier,
# and four-digit escape accumulator. The checker binds each law to ProjectSystem.
def json_at_model(data_length: i64, position: i64, stored_byte: i64) -> i64:
    requires data_length >= 0 and position >= 0 and stored_byte >= 0 and stored_byte <= 255
    ensure result == (0 if position >= data_length else stored_byte)
    return 0 if position >= data_length else stored_byte

def json_hex_digit_model(byte: i64) -> i64:
    requires byte >= 0 and byte <= 255
    ensure result == (byte - 48 if byte >= 48 and byte <= 57 else (byte - 87 if byte >= 97 and byte <= 102 else (byte - 55 if byte >= 65 and byte <= 70 else -1)))
    return byte - 48 if byte >= 48 and byte <= 57 else (byte - 87 if byte >= 97 and byte <= 102 else (byte - 55 if byte >= 65 and byte <= 70 else -1))

def out_of_bounds_json_byte_is_zero(data_length: i64, position: i64, stored_byte: i64) -> i64:
    requires data_length >= 0 and position >= data_length and stored_byte >= 0 and stored_byte <= 255
    ensure result == 0
    return 0 if position >= data_length else stored_byte

def json_hex4_model(a: i64, b: i64, c: i64, d: i64) -> i64:
    requires a >= -1 and a <= 15
    requires b >= -1 and b <= 15
    requires c >= -1 and c <= 15
    requires d >= -1 and d <= 15
    ensure result == (-1 if a < 0 or b < 0 or c < 0 or d < 0 else ((a * 16 + b) * 16 + c) * 16 + d)
    ensure (a < 0 or b < 0 or c < 0 or d < 0) implies result == -1
    ensure (a >= 0 and b >= 0 and c >= 0 and d >= 0) implies result == ((a * 16 + b) * 16 + c) * 16 + d
    ensure (a >= 0 and a <= 15 and b >= 0 and b <= 15 and c >= 0 and c <= 15 and d >= 0 and d <= 15) implies (result >= 0 and result <= 65535)
    return -1 if a < 0 or b < 0 or c < 0 or d < 0 else ((a * 16 + b) * 16 + c) * 16 + d
