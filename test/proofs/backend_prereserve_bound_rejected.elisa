include "./backend_prereserve_bound.elisa"

def false_old_trip_push_stride_product_exceeds_byte_budget() -> bool:
    requires 16777216 * 64 * 8 == 8589934592
    ensure result == true
    return 16777216 * 64 * 8 <= 67108864

def false_over_cap_bound_is_not_clamped(bound: i64, pushes: i64, element_stride_bytes: i64) -> i64:
    requires bound > 4194304 and pushes == 2 and element_stride_bytes == 8
    ensure result == bound * pushes * element_stride_bytes
    return (prereserve_trip_cap_model(pushes, element_stride_bytes) if bound > prereserve_trip_cap_model(pushes, element_stride_bytes) else bound) * pushes * element_stride_bytes
