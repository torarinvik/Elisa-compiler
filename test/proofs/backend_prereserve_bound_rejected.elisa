include "./backend_prereserve_bound.elisa"

def false_prereserve_product_below_actual_maximum(pushes: i64) -> i64:
    requires pushes == 64
    ensure result <= 1000000000
    return 16777216 * pushes

def false_over_cap_bound_is_not_clamped(bound: i64, pushes: i64) -> i64:
    requires bound > 16777216
    requires pushes == 1
    ensure result == bound * pushes
    return (0 if bound <= 0 else (16777216 if bound > 16777216 else bound)) * pushes
