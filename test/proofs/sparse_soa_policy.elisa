# Source-linked proof of the sparse-enum requires-SoA layout invariant.
include "../../src/semantic/sparse_soa_policy.elisa"

def sparse_enum_eligibility_is_exact(annotation_name: sview, owner: sview) -> bool:
    ensure result == (annotation_name == "__layout_sparse" and owner != "")
    return SparseSoaPolicy::is_named_sparse_enum(annotation_name, owner)

def soa_marker_recognition_is_owner_scoped(annotation_name: sview, annotation_owner: sview, owner: sview) -> bool:
    ensure result == (annotation_name == "__layout_soa" and annotation_owner == owner)
    return SparseSoaPolicy::soa_marker_belongs_to_owner(annotation_name, annotation_owner, owner)

def missing_soa_marker_is_reported() -> bool:
    ensure result == true
    return SparseSoaPolicy::should_report_missing_soa(false)

def present_soa_marker_is_accepted() -> bool:
    ensure result == true
    return not SparseSoaPolicy::should_report_missing_soa(true)

def soa_marker_on_same_enum_is_recognized() -> bool:
    ensure result == true
    return SparseSoaPolicy::soa_marker_belongs_to_owner("__layout_soa", "Payload", "Payload")

def ordinary_layout_marker_is_not_sparse() -> bool:
    ensure result == true
    return not SparseSoaPolicy::is_named_sparse_enum("__layout_aos", "Payload")

def marker_for_another_enum_does_not_satisfy_the_requirement() -> bool:
    ensure result == true
    return not SparseSoaPolicy::soa_marker_belongs_to_owner("__layout_soa", "Other", "Payload")
