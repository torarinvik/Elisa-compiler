# Source-linked examples for the compiler's production integer-literal decoder.
module Parser:
    private:
        const INTEGER_LITERAL_PROOF_SCOPE: bool = true

include "../../src/parser/parser_integer_literal.elisa"

extend Parser:
    public:
        # Public proof projection; the production decoder remains private in its module.
        def proof_decode_integer_literal(text: sview) -> i64:
            return parse_int_literal_value(text)

def decimal_digits_decode() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal("123") == 123

def decimal_separators_are_ignored() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal("12_345") == 12345

def lowercase_hex_decodes() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal("0x2a") == 42

def uppercase_hex_prefix_and_digits_decode() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal("0XFF") == 255

def full_width_u64_is_reinterpreted_as_i64() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal("18446744073709551615") == -1

def overflow_saturates_instead_of_wrapping() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal("18446744073709551616") == -1

def malformed_decimal_resets_to_zero() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal("12g") == 0

def malformed_hex_resets_to_zero() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal("0x2g") == 0
