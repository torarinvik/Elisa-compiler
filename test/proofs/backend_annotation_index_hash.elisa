# The dummy declaration establishes Backend for the production helper's extension. Its hash
# implementation is isolated from the annotation-table types and imported directly below.
module Backend:
    private:
        const ANNOTATION_INDEX_HASH_PROOF_NAMESPACE: i64 = 0

include "../../src/backend/codegen_annotation_row_hash.elisa"

extend Backend:
    public:
        ghost def annotation_hash_matches_recursive_spec(text: sview) -> bool:
            ensure result == true
            return annotation_index_hash(text) == annotation_index_hash_prefix(text, text.len, ANNOTATION_INDEX_HASH_OFFSET)

        def empty_text_returns_offset_basis() -> bool:
            ensure result == true
            return annotation_index_hash("") == ANNOTATION_INDEX_HASH_OFFSET

        def ascii_a_matches_fnv1a64() -> bool:
            ensure result == true
            return annotation_index_hash("a") == 12638187200555641996.u64()

        def equal_owner_strings_share_a_bucket(left: sview, right: sview) -> bool:
            requires left == right
            ensure result == true
            return annotation_index_hash(left) == annotation_index_hash(right)
