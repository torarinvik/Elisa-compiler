include "./lexer_quoted_input.elisa"

def false_claim_trailing_backslash_is_other(character: char, terminator: char, at_source_end: bool, next_is_newline: bool) -> bool:
    requires character == '\\' and character != terminator and at_source_end
    ensure result == true
    return LexerQuotedInputPolicy::classify(character, terminator, at_source_end, next_is_newline) == LexerQuotedInputPolicy::QuotedClass.Other

def false_claim_nonterminal_escape_is_escape_terminator(character: char, terminator: char, at_source_end: bool, next_is_newline: bool) -> bool:
    requires character == '\\' and character != terminator
    requires not at_source_end and not next_is_newline
    ensure result == true
    return LexerQuotedInputPolicy::classify(character, terminator, at_source_end, next_is_newline) == LexerQuotedInputPolicy::QuotedClass.EscapeTerm

def false_claim_terminator_is_other(character: char, terminator: char, at_source_end: bool, next_is_newline: bool) -> bool:
    requires character == terminator
    ensure result == true
    return LexerQuotedInputPolicy::classify(character, terminator, at_source_end, next_is_newline) == LexerQuotedInputPolicy::QuotedClass.Other

def false_claim_closed_character_is_loop_label(next_is_identifier_start: bool, closes_character_literal: bool) -> bool:
    requires next_is_identifier_start and closes_character_literal
    ensure result == true
    return LexerQuotedInputPolicy::char_prefix_is_loop_label(next_is_identifier_start, closes_character_literal)

def false_claim_non_identifier_prefix_is_loop_label(next_is_identifier_start: bool, closes_character_literal: bool) -> bool:
    requires not next_is_identifier_start
    ensure result == true
    return LexerQuotedInputPolicy::char_prefix_is_loop_label(next_is_identifier_start, closes_character_literal)
