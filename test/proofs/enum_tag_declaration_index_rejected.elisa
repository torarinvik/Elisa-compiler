# This false claim rejects the production first-match behavior on duplicates.
module Semantic:
    private:
        const ENUM_TAG_INDEX_PROOF_NAMESPACE: i64 = 0

include "../../src/semantic/enum_tag_lookup_index.elisa"

extend Semantic:
    public:
        def a_duplicate_enum_name_returns_the_last_count() -> bool:
            ensure result == true
            names: darray[sview] = ["Same", "Other", "Same"]
            counts: darray[i64] = [2, 5, 9]
            can Abort.Panic:
                return indexed_enum_tag_count(names, counts, "Same") == 9

