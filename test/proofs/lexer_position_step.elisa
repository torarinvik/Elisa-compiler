# Prove the exact pure cursor transition called by Lexer.advance_char.
include "../../src/lexer/lexer_cursor_domain.elisa"
include "../../src/lexer/lexer_position_step.elisa"

def end_boundary_predicate_matches_unsigned_order(position: usize, source_length: usize) -> bool:
    ensure result == true
    return LexerCursorDomain::cursor_at_or_past_source_end(position, source_length) == (position >= source_length)

def newline_step_advances_line_and_resets_column(line: int, column: int) -> bool:
    ensure result == true
    return LexerPositionStep::advanced_line(line, true) == line + 1 and LexerPositionStep::column_after_newline(true) == 1

def ordinary_step_preserves_line_and_advances_column(line: int, column: int) -> bool:
    ensure result == true
    return LexerPositionStep::advanced_line(line, false) == line and LexerPositionStep::advanced_column(column) == column + 1

def cursor_step_stays_inside_source(offset: usize, source_length: usize) -> bool:
    requires offset <= source_length
    ensure result == true
    return LexerPositionStep::advanced_offset(offset, source_length) <= source_length

def cursor_step_makes_strict_progress(offset: usize, source_length: usize) -> bool:
    requires offset < source_length
    ensure result == true
    return LexerPositionStep::advanced_offset(offset, source_length) > offset

def cursor_step_preserves_offset_at_source_end(offset: usize, source_length: usize) -> bool:
    requires offset == source_length
    ensure result == true
    return LexerPositionStep::advanced_offset(offset, source_length) == offset
