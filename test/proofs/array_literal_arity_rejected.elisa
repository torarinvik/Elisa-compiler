include "./array_literal_arity.elisa"

def false_equal_positive_arity_is_rejected(expected_size: i64, actual_size: i64) -> bool:
    requires expected_size >= MIN_FIXED_ARRAY_EXTENT and actual_size == expected_size
    ensure result == true
    proof_array_literal_arity_mismatch(expected_size, actual_size)

def false_shorter_literal_is_accepted(expected_size: i64, actual_size: i64) -> bool:
    requires expected_size >= MIN_FIXED_ARRAY_EXTENT and actual_size >= EMPTY_ARRAY_LITERAL_COUNT and actual_size < expected_size
    ensure result == true
    not proof_array_literal_arity_mismatch(expected_size, actual_size)

def false_longer_literal_is_accepted(expected_size: i64, actual_size: i64) -> bool:
    requires expected_size >= MIN_FIXED_ARRAY_EXTENT and actual_size > expected_size
    ensure result == true
    not proof_array_literal_arity_mismatch(expected_size, actual_size)

def false_zero_extent_reports_mismatch(actual_size: i64) -> bool:
    requires actual_size > EMPTY_ARRAY_LITERAL_COUNT
    ensure result == true
    proof_array_literal_arity_mismatch(EMPTY_ARRAY_LITERAL_COUNT, actual_size)

def false_negative_extent_reports_mismatch(actual_size: i64) -> bool:
    requires actual_size >= EMPTY_ARRAY_LITERAL_COUNT
    ensure result == true
    proof_array_literal_arity_mismatch(ARRAY_SIZE_UNKNOWN, actual_size)

def false_empty_literal_is_accepted_for_positive_extent(expected_size: i64) -> bool:
    requires expected_size >= MIN_FIXED_ARRAY_EXTENT
    ensure result == true
    not proof_array_literal_arity_mismatch(expected_size, EMPTY_ARRAY_LITERAL_COUNT)

def false_fixed_extent_type_is_not_a_sequence() -> bool:
    ensure result == true
    not proof_single_index_type_is_sequence(false, true)

def false_container_type_is_not_a_sequence() -> bool:
    ensure result == true
    not proof_single_index_type_is_sequence(true, false)

def false_scalar_indexed_type_is_a_sequence() -> bool:
    ensure result == true
    proof_single_index_type_is_sequence(false, false)

def false_multi_index_scalar_type_is_a_sequence() -> bool:
    ensure result == true
    proof_multi_index_type_is_sequence(false)

def false_empty_assignment_without_context_is_suppressed() -> bool:
    ensure result == true
    not proof_empty_assignment_needs_context(true, true, false, false, false)

def false_later_growth_fails_to_supply_context() -> bool:
    ensure result == true
    proof_empty_assignment_needs_context(true, true, true, false, false)

def false_returned_sequence_fails_to_supply_context() -> bool:
    ensure result == true
    proof_empty_assignment_needs_context(true, true, false, true, true)

def false_returned_nonsequence_suppresses_context_error() -> bool:
    ensure result == true
    not proof_empty_assignment_needs_context(true, true, false, true, false)

def false_nonassignment_triggers_empty_context_error() -> bool:
    ensure result == true
    proof_empty_assignment_needs_context(false, true, false, false, false)

def false_nonempty_assignment_triggers_empty_context_error() -> bool:
    ensure result == true
    proof_empty_assignment_needs_context(true, false, false, false, false)

def false_parentheses_change_empty_array_classification(parentheses_remaining: usize) -> bool:
    ensure result == true
    not parenthesized_empty_array_value(parentheses_remaining, EMPTY_ARRAY_ELEMENT_COUNT)

def false_nonempty_array_is_classified_empty(parentheses_remaining: usize) -> bool:
    requires parentheses_remaining > EMPTY_ARRAY_ELEMENT_COUNT
    ensure result == true
    parenthesized_empty_array_value(parentheses_remaining, ONE_ELEMENT_ARRAY_COUNT)

def false_empty_final_match_expression_is_ignored(return_type_is_sequence: bool) -> bool:
    ensure result == true
    not proof_match_arm_requires_empty_context(true, true, true, return_type_is_sequence)

def false_nonempty_final_match_expression_is_reported(return_type_is_sequence: bool) -> bool:
    ensure result == true
    proof_match_arm_requires_empty_context(true, true, false, return_type_is_sequence)

def false_nonexpression_match_arm_tail_is_reported(return_type_is_sequence: bool) -> bool:
    ensure result == true
    proof_match_arm_requires_empty_context(true, false, true, return_type_is_sequence)

def false_empty_match_arm_body_is_reported(return_type_is_sequence: bool) -> bool:
    ensure result == true
    proof_match_arm_requires_empty_context(false, true, true, return_type_is_sequence)

def false_sequence_return_context_suppresses_match_arm_error() -> bool:
    ensure result == true
    not proof_match_arm_requires_empty_context(true, true, true, true)
