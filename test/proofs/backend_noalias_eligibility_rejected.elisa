include "./backend_noalias_eligibility.elisa"

def false_aggregate_reference_gets_noalias(opted_in: bool, is_reference: bool, is_mutable_reference: bool, is_heap_reference: bool) -> bool:
    requires opted_in and is_reference and is_mutable_reference and not is_heap_reference
    ensure result == true
    return mutable_scalar_parameter_receives_noalias(opted_in, is_reference, is_mutable_reference, is_heap_reference, false)

def false_immutable_reference_gets_noalias(opted_in: bool, is_reference: bool, is_heap_reference: bool, is_numeric_pointee: bool) -> bool:
    requires opted_in and is_reference and not is_heap_reference and is_numeric_pointee
    ensure result == true
    return mutable_scalar_parameter_receives_noalias(opted_in, is_reference, false, is_heap_reference, is_numeric_pointee)

def false_heap_reference_gets_noalias(opted_in: bool, is_reference: bool, is_mutable_reference: bool, is_numeric_pointee: bool) -> bool:
    requires opted_in and is_reference and is_mutable_reference and is_numeric_pointee
    ensure result == true
    return mutable_scalar_parameter_receives_noalias(opted_in, is_reference, is_mutable_reference, true, is_numeric_pointee)

