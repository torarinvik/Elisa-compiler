include "./internal_runtime_carrier_policy.elisa"

def string_view_has_no_replacement() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return InternalRuntimeCarrierPolicy::runtime_carrier_replacement("StringView") == ""

def dynamic_array_uses_a_view_replacement() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return InternalRuntimeCarrierPolicy::runtime_carrier_replacement("DynArray") == "view[T]"

def an_unmapped_name_can_emit_a_carrier_finding(type_name: sview) -> bool can[Abort.Panic]:
    requires type_name != "StringView" and type_name != "DynArray" and type_name != "DynArrayView" and type_name != "DynDict" and type_name != "Arena" and type_name != "ArenaMark"
    ensure result == true
    can Abort.Panic:
        return InternalRuntimeCarrierPolicy::runtime_carrier_replacement(type_name) != ""

def arena_mark_is_not_a_warning() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not InternalRuntimeCarrierPolicy::is_warning("ArenaMark")

def an_unmapped_name_is_a_warning(type_name: sview) -> bool can[Abort.Panic]:
    requires type_name != "StringView" and type_name != "DynArray" and type_name != "DynArrayView" and type_name != "DynDict" and type_name != "Arena" and type_name != "ArenaMark"
    ensure result == true
    can Abort.Panic:
        return InternalRuntimeCarrierPolicy::is_warning(type_name)
