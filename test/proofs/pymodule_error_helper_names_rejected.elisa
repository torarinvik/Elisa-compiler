include "./pymodule_error_helper_names.elisa"

def optional_text_name_must_not_keep_its_source_spelling() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return PymoduleErrorHelperNames::nested_darray_helper_suffix("cstr?") == "cstr?"

def unsupported_type_must_not_receive_a_helper() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return PymoduleErrorHelperNames::nested_darray_helper_suffix("String") != ""
