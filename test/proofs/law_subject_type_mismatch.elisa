# Source-linked proof model for the diagnostic predicate in check_law_subject_type.
module LawSubjectTypeMismatchRule:
    public:
        def should_report(value_type: sview, subject_type: sview) -> bool:
            ensure result == (value_type != "" and subject_type != "" and value_type != subject_type)
            return value_type != "" and subject_type != "" and value_type != subject_type

def source_mismatch_rule_is_exact(value_type: sview, subject_type: sview) -> bool:
    ensure result == true
    return LawSubjectTypeMismatchRule::should_report(value_type, subject_type) ==
        (value_type != "" and subject_type != "" and value_type != subject_type)

def distinct_nonempty_types_are_reported() -> bool:
    ensure result == true
    return LawSubjectTypeMismatchRule::should_report("i64", "bool")

def equal_types_are_ignored() -> bool:
    ensure result == true
    return not LawSubjectTypeMismatchRule::should_report("i64", "i64")

def missing_value_type_is_ignored() -> bool:
    ensure result == true
    return not LawSubjectTypeMismatchRule::should_report("", "i64")

def missing_subject_type_is_ignored() -> bool:
    ensure result == true
    return not LawSubjectTypeMismatchRule::should_report("i64", "")
