# Source-linked proof of stage0-compatible @callconv normalization.
include "../../src/semantic/callconv_name.elisa"

def stage0_callconv_requires_one_argument() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return CallConvName::SINGLE_ARGUMENT_COUNT == 1

def ascii_case_insensitive_comparison_matches_spec(value: sview, expected: sview) -> bool can[Abort.Panic]:
    ensure result == (
        value.len == expected.len
        and (forall index in 0..<expected.len: index >= value.len or CallConvName::ascii_lower(sview_at(value, index)) == sview_at(expected, index))
    )
    can Abort.Panic:
        return CallConvName::equals_ascii_case_insensitive(value, expected)

def supported_casefold_fallback_matches_aliases(name: sview) -> bool can[Abort.Panic]:
    ensure result == (
        CallConvName::equals_ascii_case_insensitive(name, "c")
        or CallConvName::equals_ascii_case_insensitive(name, "cdecl")
        or CallConvName::equals_ascii_case_insensitive(name, "default")
        or CallConvName::equals_ascii_case_insensitive(name, "fast")
        or CallConvName::equals_ascii_case_insensitive(name, "fastcall")
        or CallConvName::equals_ascii_case_insensitive(name, "cold")
        or CallConvName::equals_ascii_case_insensitive(name, "coldcc")
        or CallConvName::equals_ascii_case_insensitive(name, "stdcall")
        or CallConvName::equals_ascii_case_insensitive(name, "x86_stdcall")
        or CallConvName::equals_ascii_case_insensitive(name, "x86-stdcall")
        or CallConvName::equals_ascii_case_insensitive(name, "winapi")
        or CallConvName::equals_ascii_case_insensitive(name, "windows")
    )
    can Abort.Panic:
        return CallConvName::matches_supported_ascii_case(name)

def exact_lowercase_alias_match_is_complete(name: sview) -> bool can[Abort.Panic]:
    ensure result == (
        when name:
            "c" | "cdecl" | "default" | "fast" | "fastcall" | "cold" | "coldcc" | "stdcall" | "x86_stdcall" | "x86-stdcall" | "winapi" | "windows" -> true
            _ -> false
    )
    can Abort.Panic:
        return CallConvName::is_exact_lowercase_supported(name)

def source_classifier_matches_stage0_aliases(name: sview) -> bool can[Abort.Panic]:
    ensure result == (CallConvName::matches_supported_ascii_case(name) or CallConvName::is_exact_lowercase_supported(name))
    can Abort.Panic:
        return CallConvName::is_supported(name)

def every_stage0_callconv_alias_is_accepted() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            CallConvName::is_supported("c")
            and CallConvName::is_supported("cdecl")
            and CallConvName::is_supported("default")
            and CallConvName::is_supported("fast")
            and CallConvName::is_supported("fastcall")
            and CallConvName::is_supported("cold")
            and CallConvName::is_supported("coldcc")
            and CallConvName::is_supported("stdcall")
            and CallConvName::is_supported("x86_stdcall")
            and CallConvName::is_supported("x86-stdcall")
            and CallConvName::is_supported("winapi")
            and CallConvName::is_supported("windows")
        )

def callconv_case_is_ignored() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            CallConvName::is_supported("C")
            and CallConvName::is_supported("CDECL")
            and CallConvName::is_supported("DeFaUlT")
            and CallConvName::is_supported("FAST")
            and CallConvName::is_supported("FastCall")
            and CallConvName::is_supported("COLD")
            and CallConvName::is_supported("ColdCc")
            and CallConvName::is_supported("STDCall")
            and CallConvName::is_supported("X86_STDCALL")
            and CallConvName::is_supported("X86-StdCall")
            and CallConvName::is_supported("WinApi")
            and CallConvName::is_supported("WINDOWS")
        )

def c_abi_casefold_fallback_matches_aliases(name: sview) -> bool can[Abort.Panic]:
    ensure result == (
        CallConvName::equals_ascii_case_insensitive(name, "c")
        or CallConvName::equals_ascii_case_insensitive(name, "cdecl")
        or CallConvName::equals_ascii_case_insensitive(name, "default")
    )
    can Abort.Panic:
        return CallConvName::matches_c_abi_ascii_case(name)

def exact_lowercase_c_abi_match_is_complete(name: sview) -> bool can[Abort.Panic]:
    ensure result == (
        when name:
            "c" | "cdecl" | "default" -> true
            _ -> false
    )
    can Abort.Panic:
        return CallConvName::is_exact_lowercase_c_abi(name)

def source_c_abi_classifier_matches_aliases(name: sview) -> bool can[Abort.Panic]:
    ensure result == (CallConvName::matches_c_abi_ascii_case(name) or CallConvName::is_exact_lowercase_c_abi(name))
    can Abort.Panic:
        return CallConvName::is_c_abi(name)

def stage0_c_family_is_classified_as_c_abi() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            CallConvName::is_c_abi("C")
            and CallConvName::is_c_abi("CDECL")
            and CallConvName::is_c_abi("DeFaUlT")
            and not CallConvName::is_c_abi("FAST")
        )

def unsupported_callconv_names_are_rejected() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            not CallConvName::is_supported("")
            and not CallConvName::is_supported("fastcc")
            and not CallConvName::is_supported("x86stdcall")
            and not CallConvName::is_supported("Windows64")
        )
