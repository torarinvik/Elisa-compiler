# Postcondition checks for normalization of signed StringView lengths.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

def sview_len_obeys_its_piecewise_normalization_contract(view: sview) -> bool:
    ensure result == true
    normalized: usize = sview_len(view)
    return (
        ((view.len <= 0 or view.len.usize().i64() != view.len) implies normalized == 0.usize())
        and ((view.len > 0 and view.len.usize().i64() == view.len) implies normalized.i64() == view.len)
    )

def a_positive_representable_length_is_preserved(view: sview) -> bool:
    requires view.len > 0 and view.len.usize().i64() == view.len
    ensure result == true
    return sview_len(view).i64() == view.len

def a_nonpositive_length_is_normalized_to_zero(view: sview) -> bool:
    requires view.len <= 0
    ensure result == true
    return sview_len(view) == 0.usize()

def a_nonroundtripping_length_is_normalized_to_zero(view: sview) -> bool:
    requires view.len.usize().i64() != view.len
    ensure result == true
    return sview_len(view) == 0.usize()
