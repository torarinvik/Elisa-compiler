# Direct signed StringView length access.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"

def a_positive_length_remains_positive(view: sview) -> bool:
    requires view.len > 0
    ensure result == true
    length: i64 = view.len
    return length > 0

def a_nonpositive_length_remains_nonpositive(view: sview) -> bool:
    requires view.len <= 0
    ensure result == true
    length: i64 = view.len
    return length <= 0

def a_representable_length_survives_unsigned_conversion(view: sview) -> bool:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    ensure result == true
    length: usize = view.len.usize()
    return length.i64() == view.len
