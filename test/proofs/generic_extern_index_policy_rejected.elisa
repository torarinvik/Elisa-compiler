include "./generic_extern_index_policy.elisa"

def false_claim_present_generic_extern_is_absent() -> bool:
    ensure result == true
    names: darray[sview] = ["va_arg", "type_id"]
    return not SemanticGenericExternIndexPolicy::contains(names, "va_arg")

def false_claim_absent_name_is_registered() -> bool:
    ensure result == true
    names: darray[sview] = ["type_id", "va_list"]
    return SemanticGenericExternIndexPolicy::contains(names, "va_arg")
