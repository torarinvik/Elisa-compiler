include "./backend_literal_hex_valid_bytes.elisa"
# False claims at accepted hexadecimal byte boundaries.

def uppercase_A_must_map_to_zero(byte: i64) -> i64:
    requires byte == 65
    ensure result == 0
    return byte - 55

def lowercase_f_must_map_to_sixteen(byte: i64) -> i64:
    requires byte == 102
    ensure result == 16
    return byte - 87

def lowercase_a_must_be_distinct_from_uppercase_A(byte: i64) -> bool:
    requires byte == 65
    ensure result == true
    upper: i64 = byte - 55
    lower: i64 = byte + 32 - 87
    return upper != lower
