# False claims about the boundary and removed suffix must remain unproved.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

def trimming_can_leave_the_selected_byte_at_the_prefix_end(view: sview, byte: u8) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    ensure result == true
    trimmed: sview = sview_trim_trailing(view, byte)
    return trimmed.len > 0 and string_view_index(view, trimmed.len - 1) == byte.i64()

def trimming_can_drop_a_nonmatching_byte(view: sview, byte: u8) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    ensure result == true
    trimmed: sview = sview_trim_trailing(view, byte)
    return trimmed.len < view.len and string_view_index(view, trimmed.len) != byte.i64()
