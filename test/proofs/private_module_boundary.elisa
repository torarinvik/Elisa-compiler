# Source-bound proofs for private-member module containment and delimiter handling.
include "../../src/semantic/private_module_boundary.elisa"

def prefix_classifier_matches_its_bytewise_spec(text: sview, prefix: sview) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return SemanticPrivateModuleBoundary::prefix_matches(text, prefix) == (
            text.len >= prefix.len and
            (forall index in 0..<text.len:
                index >= prefix.len or text[index] == prefix[index]
            )
        )

def module_containment_classifier_matches_exact_separator_spec(current_module: sview, owner: sview) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return SemanticPrivateModuleBoundary::within_module(current_module, owner) == (
            current_module == owner or (
                owner.len > 0 and
                current_module.len > owner.len and
                current_module.len - owner.len > SemanticPrivateModuleBoundary::MODULE_SEPARATOR_LENGTH and
                SemanticPrivateModuleBoundary::prefix_matches(current_module, owner) and
                current_module[owner.len] == SemanticPrivateModuleBoundary::ASCII_COLON and
                current_module[owner.len + 1.usize()] == SemanticPrivateModuleBoundary::ASCII_COLON
            )
        )

def owner_and_descendant_are_inside_private_boundary() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return SemanticPrivateModuleBoundary::within_module("A::Paint", "A::Paint") and
            SemanticPrivateModuleBoundary::within_module("A::Paint::Brush", "A::Paint") and
            SemanticPrivateModuleBoundary::within_module("A::Paint::Brush::Wet", "A::Paint")

def similar_prefix_and_parent_are_outside_private_boundary() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not SemanticPrivateModuleBoundary::within_module("A::Painter::Brush", "A::Paint") and
            not SemanticPrivateModuleBoundary::within_module("A", "A::Paint") and
            not SemanticPrivateModuleBoundary::within_module("A::Paint::", "A::Paint")

def empty_owner_only_contains_the_identical_empty_path() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return SemanticPrivateModuleBoundary::within_module("", "") and
            not SemanticPrivateModuleBoundary::within_module("A", "")
