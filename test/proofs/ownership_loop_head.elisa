include "../../src/semantic/ownership_flow_domain.elisa"

def entry_path_remains_possible(entry: bool, back: bool) -> bool:
    requires entry
    ensure result == true
    return OwnershipFlow::join_reachable_possible(true, entry, true, back)

def consumed_back_edge_is_retained(entry: bool, back: bool) -> bool:
    requires back
    ensure result == true
    return OwnershipFlow::join_reachable_possible(true, entry, true, back)

def dead_back_edge_preserves_entry(entry: bool, back: bool) -> bool:
    ensure result == entry
    return OwnershipFlow::join_reachable_possible(true, entry, false, back)

def dead_back_edge_preserves_knowledge(entry: bool, back: bool) -> bool:
    ensure result == entry
    return OwnershipFlow::join_reachable_known(true, entry, false, back)

def unknown_back_edge_loses_knowledge(entry: bool) -> bool:
    ensure result == false
    return OwnershipFlow::join_reachable_known(true, entry, true, false)
