# False claims must remain unproved for the production, case-sensitive suffix matcher.
include "../../src/driver/project.elisa"

def uppercase_elisa_suffix_is_accepted() -> bool can[Memory.Allocate, Abort.Panic]:
    ensure result == true
    path: darray[u8] = ProjectSystem::bytes_from_view("x.ELISA")
    return ProjectSystem::bytes_ends_with_view(path, ".elisa")

def a_byte_after_elisa_does_not_prevent_a_match() -> bool can[Memory.Allocate, Abort.Panic]:
    ensure result == true
    path: darray[u8] = ProjectSystem::bytes_from_view("x.elisax")
    return ProjectSystem::bytes_ends_with_view(path, ".elisa")

def a_short_path_matches_elisa(path: darray[u8]&) -> bool:
    requires path.count < sview_len(".elisa")
    ensure result == true
    return ProjectSystem::bytes_ends_with_view(path, ".elisa")
