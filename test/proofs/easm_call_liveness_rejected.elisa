# False call-transfer register-class claims must remain unproved.
include "./easm_call_liveness.elisa"

def call_invalidates_rax_slot() -> bool:
    ensure result == true
    return REG_RAX == 1 or REG_RAX == 2 or REG_RAX == 4 or REG_RAX == 5 or REG_RAX == 8 or REG_RAX == 9 or REG_RAX == 10 or REG_RAX == 11

def call_preserves_rcx_slot() -> bool:
    ensure result == true
    return REG_RCX == 0 or REG_RCX == 3 or REG_RCX == 6 or REG_RCX == 7 or REG_RCX == 12 or REG_RCX == 13 or REG_RCX == 14 or REG_RCX == 15

def call_invalidates_callee_saved_slot() -> bool:
    ensure result == true
    return REG_RBX == 1 or REG_RBX == 2 or REG_RBX == 4 or REG_RBX == 5 or REG_RBX == 8 or REG_RBX == 9 or REG_RBX == 10 or REG_RBX == 11

def out_of_range_register_index_is_invalidated() -> bool:
    requires REG_R15 + 1 == 16
    ensure result == true
    return model_call_invalidates_register_index(REG_R15 + 1)

def call_preserves_live_flags(was_live: bool) -> bool:
    requires was_live == true
    ensure result == was_live
    return false

def xchg_can_omit_its_source_register_write() -> bool:
    ensure result == true
    instruction: Easm::Instruction = Easm::Instruction{
        op: "xchgq",
        text: "%rax, %rcx",
        line: 1,
        pseudo: false,
        substitution_count: 0,
        substitution0: Easm::Substitution{from: "", replacement: ""},
        substitution1: Easm::Substitution{from: "", replacement: ""},
        substitution2: Easm::Substitution{from: "", replacement: ""},
        substitution3: Easm::Substitution{from: "", replacement: ""}
    }
    written: i64 = Easm::easm_written_mask(instruction)
    return (written & EasmRegisterMasks::RAX) == 0

def xchg_flow_transfer_can_drop_both_new_live_registers(incoming: Easm::FlowState) -> bool:
    ensure result == true
    instruction: Easm::Instruction = Easm::Instruction{
        op: "xchgq",
        text: "%rax, %rcx",
        line: 1,
        pseudo: false,
        substitution_count: 0,
        substitution0: Easm::Substitution{from: "", replacement: ""},
        substitution1: Easm::Substitution{from: "", replacement: ""},
        substitution2: Easm::Substitution{from: "", replacement: ""},
        substitution3: Easm::Substitution{from: "", replacement: ""}
    }
    out: Easm::FlowState = Easm::easm_flow_transfer(instruction, incoming)
    return out.live == incoming.live

def xchg_rsp_can_preserve_stack_knownness(incoming: Easm::FlowState) -> bool:
    requires incoming.stack_known == true
    ensure result == true
    instruction: Easm::Instruction = Easm::Instruction{
        op: "xchgq",
        text: "%rsp, %rax",
        line: 1,
        pseudo: false,
        substitution_count: 0,
        substitution0: Easm::Substitution{from: "", replacement: ""},
        substitution1: Easm::Substitution{from: "", replacement: ""},
        substitution2: Easm::Substitution{from: "", replacement: ""},
        substitution3: Easm::Substitution{from: "", replacement: ""}
    }
    out: Easm::FlowState = Easm::easm_flow_transfer(instruction, incoming)
    return out.stack_known

def xchg_rsp_destination_can_preserve_stack_knownness(incoming: Easm::FlowState) -> bool:
    requires incoming.stack_known == true
    ensure result == true
    instruction: Easm::Instruction = Easm::Instruction{
        op: "xchgq",
        text: "%rax, %rsp",
        line: 1,
        pseudo: false,
        substitution_count: 0,
        substitution0: Easm::Substitution{from: "", replacement: ""},
        substitution1: Easm::Substitution{from: "", replacement: ""},
        substitution2: Easm::Substitution{from: "", replacement: ""},
        substitution3: Easm::Substitution{from: "", replacement: ""}
    }
    out: Easm::FlowState = Easm::easm_flow_transfer(instruction, incoming)
    return out.stack_known

def pushq_can_leave_stack_delta_unchanged(incoming: Easm::FlowState) -> bool:
    requires incoming.stack_known == true
    requires incoming.stack_delta >= -9223372036854775800
    requires incoming.stack_mod16 >= 0 and incoming.stack_mod16 < 16
    ensure result == true
    instruction: Easm::Instruction = Easm::Instruction{
        op: "pushq",
        text: "$0",
        line: 1,
        pseudo: false,
        substitution_count: 0,
        substitution0: Easm::Substitution{from: "", replacement: ""},
        substitution1: Easm::Substitution{from: "", replacement: ""},
        substitution2: Easm::Substitution{from: "", replacement: ""},
        substitution3: Easm::Substitution{from: "", replacement: ""}
    }
    out: Easm::FlowState = Easm::easm_flow_transfer(instruction, incoming)
    return out.stack_delta == incoming.stack_delta

def popq_register_destination_can_invalidate_stack_alignment(incoming: Easm::FlowState) -> bool:
    requires incoming.stack_known == true
    requires incoming.stack_delta <= 9223372036854775799
    requires incoming.stack_mod16 >= 0 and incoming.stack_mod16 < 16
    ensure result == true
    instruction: Easm::Instruction = Easm::Instruction{
        op: "popq",
        text: "%rax",
        line: 1,
        pseudo: false,
        substitution_count: 0,
        substitution0: Easm::Substitution{from: "", replacement: ""},
        substitution1: Easm::Substitution{from: "", replacement: ""},
        substitution2: Easm::Substitution{from: "", replacement: ""},
        substitution3: Easm::Substitution{from: "", replacement: ""}
    }
    out: Easm::FlowState = Easm::easm_flow_transfer(instruction, incoming)
    return not out.stack_known
