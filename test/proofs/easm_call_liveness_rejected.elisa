# False call-transfer register-class claims must remain unproved.
include "./easm_call_liveness.elisa"

def call_invalidates_rax_slot() -> bool:
    ensure result == true
    return REG_RAX == 1 or REG_RAX == 2 or REG_RAX == 4 or REG_RAX == 5 or REG_RAX == 8 or REG_RAX == 9 or REG_RAX == 10 or REG_RAX == 11

def call_preserves_rcx_slot() -> bool:
    ensure result == true
    return REG_RCX == 0 or REG_RCX == 3 or REG_RCX == 6 or REG_RCX == 7 or REG_RCX == 12 or REG_RCX == 13 or REG_RCX == 14 or REG_RCX == 15

def call_invalidates_callee_saved_slot() -> bool:
    ensure result == true
    return REG_RBX == 1 or REG_RBX == 2 or REG_RBX == 4 or REG_RBX == 5 or REG_RBX == 8 or REG_RBX == 9 or REG_RBX == 10 or REG_RBX == 11

def call_preserves_live_flags(was_live: bool) -> bool:
    requires was_live == true
    ensure result == was_live
    return false
