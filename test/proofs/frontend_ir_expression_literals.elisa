# Source-linked proof for scalar expression literal nodes and payload encodings.
include "../../src/driver/frontend_ir_expression_literal_encoding.elisa"

const EXPECTED_INT_LIT_NODE_TYPE_ID: u32 = 139
const EXPECTED_FLOAT_LIT_NODE_TYPE_ID: u32 = 67
const EXPECTED_STRING_LIT_NODE_TYPE_ID: u32 = 253
const EXPECTED_CHAR_LIT_NODE_TYPE_ID: u32 = 28
const EXPECTED_BOOL_LIT_NODE_TYPE_ID: u32 = 18

const EXPECTED_INT_LIT_VALUE_FIELD_ID: u32 = 4
const EXPECTED_FLOAT_LIT_VALUE_FIELD_ID: u32 = 3
const EXPECTED_STRING_LIT_VALUE_FIELD_ID: u32 = 2
const EXPECTED_CHAR_LIT_VALUE_FIELD_ID: u32 = 2
const EXPECTED_BOOL_LIT_VALUE_FIELD_ID: u32 = 2

const EXPECTED_STRING_VALUE_WIRE_TYPE_ID: u8 = 3
const EXPECTED_BOOL_VALUE_WIRE_TYPE_ID: u8 = 1

def source_literal_node_type_id_is_exact(kind: FrontendIrExpressionLiteralEncoding::ScalarLiteralKind) -> u32:
    ensure kind != FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.IntLit or result == EXPECTED_INT_LIT_NODE_TYPE_ID
    ensure kind != FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.FloatLit or result == EXPECTED_FLOAT_LIT_NODE_TYPE_ID
    ensure kind != FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.StringLit or result == EXPECTED_STRING_LIT_NODE_TYPE_ID
    ensure kind != FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.CharLit or result == EXPECTED_CHAR_LIT_NODE_TYPE_ID
    ensure kind != FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.BoolLit or result == EXPECTED_BOOL_LIT_NODE_TYPE_ID
    return FrontendIrExpressionLiteralEncoding::node_type_id(kind)

def source_literal_value_field_id_is_exact(kind: FrontendIrExpressionLiteralEncoding::ScalarLiteralKind) -> u32:
    ensure kind != FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.IntLit or result == EXPECTED_INT_LIT_VALUE_FIELD_ID
    ensure kind != FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.FloatLit or result == EXPECTED_FLOAT_LIT_VALUE_FIELD_ID
    ensure kind != FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.StringLit or result == EXPECTED_STRING_LIT_VALUE_FIELD_ID
    ensure kind != FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.CharLit or result == EXPECTED_CHAR_LIT_VALUE_FIELD_ID
    ensure kind != FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.BoolLit or result == EXPECTED_BOOL_LIT_VALUE_FIELD_ID
    return FrontendIrExpressionLiteralEncoding::value_field_id(kind)

def source_literal_value_wire_type_id_is_exact(kind: FrontendIrExpressionLiteralEncoding::ScalarLiteralKind) -> u8:
    ensure kind == FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.BoolLit or result == EXPECTED_STRING_VALUE_WIRE_TYPE_ID
    ensure kind != FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.BoolLit or result == EXPECTED_BOOL_VALUE_WIRE_TYPE_ID
    return FrontendIrExpressionLiteralEncoding::value_wire_type_id(kind)

def scalar_literal_node_type_ids_are_distinct() -> bool:
    ensure result == true
    return (
        FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.IntLit) != FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.FloatLit)
        and FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.IntLit) != FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.StringLit)
        and FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.IntLit) != FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.CharLit)
        and FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.IntLit) != FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.BoolLit)
        and FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.FloatLit) != FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.StringLit)
        and FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.FloatLit) != FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.CharLit)
        and FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.FloatLit) != FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.BoolLit)
        and FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.StringLit) != FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.CharLit)
        and FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.StringLit) != FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.BoolLit)
        and FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.CharLit) != FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.BoolLit)
    )

def shared_payload_slot_is_distinguished_by_literal_node_type() -> bool:
    ensure result == true
    string_field: u32 = FrontendIrExpressionLiteralEncoding::value_field_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.StringLit)
    char_field: u32 = FrontendIrExpressionLiteralEncoding::value_field_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.CharLit)
    bool_field: u32 = FrontendIrExpressionLiteralEncoding::value_field_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.BoolLit)
    string_node: u32 = FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.StringLit)
    char_node: u32 = FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.CharLit)
    bool_node: u32 = FrontendIrExpressionLiteralEncoding::node_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.BoolLit)
    return (
        string_field == char_field
        and char_field == bool_field
        and string_field == EXPECTED_STRING_LIT_VALUE_FIELD_ID
        and char_field == EXPECTED_CHAR_LIT_VALUE_FIELD_ID
        and bool_field == EXPECTED_BOOL_LIT_VALUE_FIELD_ID
        and string_node != char_node
        and char_node != bool_node
        and string_node != bool_node
    )

def scalar_literal_payload_wire_types_are_exact() -> bool:
    ensure result == true
    return (
        FrontendIrExpressionLiteralEncoding::value_wire_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.IntLit) == EXPECTED_STRING_VALUE_WIRE_TYPE_ID
        and FrontendIrExpressionLiteralEncoding::value_wire_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.FloatLit) == EXPECTED_STRING_VALUE_WIRE_TYPE_ID
        and FrontendIrExpressionLiteralEncoding::value_wire_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.StringLit) == EXPECTED_STRING_VALUE_WIRE_TYPE_ID
        and FrontendIrExpressionLiteralEncoding::value_wire_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.CharLit) == EXPECTED_STRING_VALUE_WIRE_TYPE_ID
        and FrontendIrExpressionLiteralEncoding::value_wire_type_id(FrontendIrExpressionLiteralEncoding::ScalarLiteralKind.BoolLit) == EXPECTED_BOOL_VALUE_WIRE_TYPE_ID
    )
