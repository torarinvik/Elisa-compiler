# Source-linked laws for the lexical lifetime ordering used by region-store checks.
# Lower nesting positions outlive greater positions; missing positions cannot establish an escape.

def production_store_escape_condition_is_exact(target_found: bool,
    value_found: bool,
    target_position: usize,
    value_position: usize) -> bool:
    ensure result == (target_found and value_found and target_position < value_position)
    return target_found and value_found and target_position < value_position

def outer_target_receiving_inner_value_is_an_escape(target_position: usize,
    value_position: usize) -> bool:
    requires target_position < value_position
    ensure result == true
    return target_position < value_position

def equal_region_positions_do_not_escape(position: usize) -> bool:
    ensure result == false
    return position < position

def inner_target_receiving_outer_value_does_not_escape(target_position: usize,
    value_position: usize) -> bool:
    requires target_position > value_position
    ensure result == false
    return target_position < value_position

def missing_region_position_does_not_establish_escape(target_found: bool,
    value_found: bool,
    target_position: usize,
    value_position: usize) -> bool:
    requires not target_found or not value_found
    ensure result == false
    return target_found and value_found and target_position < value_position
