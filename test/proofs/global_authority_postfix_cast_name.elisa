# Source-linked proof of the postfix cast-name classifier used by global authority checks.
include "../../src/semantic/global_authority_postfix_cast_name.elisa"

def source_classifier_has_exact_lexical_rule(name: sview) -> bool can[Abort.Panic]:
    ensure result == (
        when name:
            "void" | "bool" | "char" | "int" | "i8" | "i16" | "i32" | "i64" | "isize" | "s8" | "s16" | "s32" | "s64" | "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" | "f32" | "f64" | "sview" | "cstr" -> true
            _ -> sview_len(name) > 0 and sview_at(name, 0) >= GlobalAuthorityPostfixCastName::GA_ASCII_UPPER_A and sview_at(name, 0) <= GlobalAuthorityPostfixCastName::GA_ASCII_UPPER_Z
    )
    can Abort.Panic:
        return GlobalAuthorityPostfixCastName::is_postfix_cast_name(name)

def every_builtin_postfix_cast_name_is_accepted() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            GlobalAuthorityPostfixCastName::is_postfix_cast_name("void")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("bool")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("char")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("int")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("i8")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("i16")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("i32")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("i64")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("isize")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("s8")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("s16")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("s32")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("s64")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("u8")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("u16")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("u32")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("u64")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("usize")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("uintptr")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("f32")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("f64")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("sview")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("cstr")
        )

def uppercase_named_types_remain_cast_names() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            GlobalAuthorityPostfixCastName::is_postfix_cast_name("String")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("NodeKey")
            and GlobalAuthorityPostfixCastName::is_postfix_cast_name("Z")
        )

def empty_and_lowercase_unknown_names_are_not_casts() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            not GlobalAuthorityPostfixCastName::is_postfix_cast_name("")
            and not GlobalAuthorityPostfixCastName::is_postfix_cast_name("dstr")
            and not GlobalAuthorityPostfixCastName::is_postfix_cast_name("string")
            and not GlobalAuthorityPostfixCastName::is_postfix_cast_name("u128")
        )
