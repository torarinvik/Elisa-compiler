include "./backend_error_family_conflict.elisa"

def false_claim_unmatched_row_conflicts(line_matches: bool, offset_matches: bool, found_nonempty: bool, same_family: bool) -> bool:
    requires (not line_matches or not offset_matches) and found_nonempty and not same_family
    ensure result == true
    return line_matches and offset_matches and found_nonempty and not same_family

def false_claim_consistent_duplicate_conflicts(line_matches: bool, offset_matches: bool, found_nonempty: bool, same_family: bool) -> bool:
    requires line_matches and offset_matches and found_nonempty and same_family
    ensure result == true
    return line_matches and offset_matches and found_nonempty and not same_family

def false_claim_first_match_conflicts(line_matches: bool, offset_matches: bool, found_nonempty: bool, same_family: bool) -> bool:
    requires line_matches and offset_matches and not found_nonempty
    ensure result == true
    return line_matches and offset_matches and found_nonempty and not same_family

def false_claim_conflict_is_accepted(line_matches: bool, offset_matches: bool, found_nonempty: bool, same_family: bool) -> bool:
    requires line_matches and offset_matches and found_nonempty and not same_family
    ensure result == false
    return line_matches and offset_matches and found_nonempty and not same_family
