# Source-linked laws for the subset of IterForStmt that the frontend IR writer emits.
include "../../src/driver/frontend_ir_for_statement_encoding.elisa"

const EXPECTED_ITER_FOR_STMT_NODE_TYPE_ID: u32 = 143
const EXPECTED_MOVE_BIND_NAME_PATTERN_NODE_TYPE_ID: u32 = 187

const EXPECTED_ITER_FOR_BODY_FIELD_ID: u32 = 1
const EXPECTED_ITER_FOR_MODE_FIELD_ID: u32 = 3
const EXPECTED_ITER_FOR_MOVED_SOURCE_FIELD_ID: u32 = 4
const EXPECTED_ITER_FOR_PATTERN_FIELD_ID: u32 = 5
const EXPECTED_ITER_FOR_POSITION_FIELD_ID: u32 = 8
const EXPECTED_ITER_FOR_SOURCE_FIELD_ID: u32 = 12
const EXPECTED_MOVE_BIND_NAME_PATTERN_NAME_FIELD_ID: u32 = 1

const EXPECTED_ITER_BIND_VALUE_MODE_VALUE: i64 = 0
const EXPECTED_ITER_BIND_MUTABLE_REFERENCE_MODE_VALUE: i64 = 2
const EXPECTED_FOR_LOOP_NAME_BINDER_COUNT: usize = 1

def for_bind_mode_uses_the_closed_string_match(bind: sview) -> FrontendIrForStatementEncoding::ForBindingMode:
    ensure result == (when bind:
        "" -> FrontendIrForStatementEncoding::ForBindingMode.Value
        "mutable" -> FrontendIrForStatementEncoding::ForBindingMode.MutableReference
        _ -> FrontendIrForStatementEncoding::ForBindingMode.Unsupported
    )
    return FrontendIrForStatementEncoding::binding_mode(bind)

def for_bind_mode_value_matches_stage0_modes(mode: FrontendIrForStatementEncoding::ForBindingMode) -> i64:
    ensure mode != FrontendIrForStatementEncoding::ForBindingMode.Value or result == EXPECTED_ITER_BIND_VALUE_MODE_VALUE
    ensure mode != FrontendIrForStatementEncoding::ForBindingMode.MutableReference or result == EXPECTED_ITER_BIND_MUTABLE_REFERENCE_MODE_VALUE
    ensure mode != FrontendIrForStatementEncoding::ForBindingMode.Unsupported or result == EXPECTED_ITER_BIND_VALUE_MODE_VALUE
    return FrontendIrForStatementEncoding::binding_mode_value(mode)

def supported_for_binding_and_move_combinations_are_exact(mode: FrontendIrForStatementEncoding::ForBindingMode, moved_source: bool) -> bool:
    ensure result == (when mode:
        FrontendIrForStatementEncoding::ForBindingMode.Value -> true
        FrontendIrForStatementEncoding::ForBindingMode.MutableReference -> not moved_source
        FrontendIrForStatementEncoding::ForBindingMode.Unsupported -> false
    )
    return FrontendIrForStatementEncoding::binding_and_source_are_supported(mode, moved_source)

def explicit_move_source_is_recognized_by_constructor(expression: Ast::Expr) -> bool:
    ensure result == (when expression:
        Ast::Expr.Move(_, _) -> true
        _ -> false
    )
    return FrontendIrForStatementEncoding::is_explicit_move_source(expression)

def for_statement_node_tags_are_exact() -> bool:
    ensure result == true
    return (
        FrontendIrForStatementEncoding::node_type_id() == EXPECTED_ITER_FOR_STMT_NODE_TYPE_ID
        and FrontendIrForStatementEncoding::pattern_node_type_id() == EXPECTED_MOVE_BIND_NAME_PATTERN_NODE_TYPE_ID
    )

def for_pattern_name_field_id_is_exact() -> u32:
    ensure result == EXPECTED_MOVE_BIND_NAME_PATTERN_NAME_FIELD_ID
    return FrontendIrForStatementEncoding::pattern_name_field_id()

def for_loop_name_binder_count_is_exact() -> usize:
    ensure result == EXPECTED_FOR_LOOP_NAME_BINDER_COUNT
    return FrontendIrForStatementEncoding::FOR_LOOP_NAME_BINDER_COUNT

def for_statement_field_mapping_is_exact(field: FrontendIrForStatementEncoding::ForStatementField) -> u32:
    ensure field != FrontendIrForStatementEncoding::ForStatementField.Body or result == EXPECTED_ITER_FOR_BODY_FIELD_ID
    ensure field != FrontendIrForStatementEncoding::ForStatementField.Mode or result == EXPECTED_ITER_FOR_MODE_FIELD_ID
    ensure field != FrontendIrForStatementEncoding::ForStatementField.MovedSource or result == EXPECTED_ITER_FOR_MOVED_SOURCE_FIELD_ID
    ensure field != FrontendIrForStatementEncoding::ForStatementField.Pattern or result == EXPECTED_ITER_FOR_PATTERN_FIELD_ID
    ensure field != FrontendIrForStatementEncoding::ForStatementField.Position or result == EXPECTED_ITER_FOR_POSITION_FIELD_ID
    ensure field != FrontendIrForStatementEncoding::ForStatementField.Source or result == EXPECTED_ITER_FOR_SOURCE_FIELD_ID
    return FrontendIrForStatementEncoding::field_id(field)

def for_statement_field_ids_are_distinct() -> bool:
    ensure result == true
    body_id: u32 = FrontendIrForStatementEncoding::field_id(FrontendIrForStatementEncoding::ForStatementField.Body)
    mode_id: u32 = FrontendIrForStatementEncoding::field_id(FrontendIrForStatementEncoding::ForStatementField.Mode)
    moved_source_id: u32 = FrontendIrForStatementEncoding::field_id(FrontendIrForStatementEncoding::ForStatementField.MovedSource)
    pattern_id: u32 = FrontendIrForStatementEncoding::field_id(FrontendIrForStatementEncoding::ForStatementField.Pattern)
    position_id: u32 = FrontendIrForStatementEncoding::field_id(FrontendIrForStatementEncoding::ForStatementField.Position)
    source_id: u32 = FrontendIrForStatementEncoding::field_id(FrontendIrForStatementEncoding::ForStatementField.Source)
    return (
        body_id != mode_id and body_id != moved_source_id and body_id != pattern_id and body_id != position_id and body_id != source_id
        and mode_id != moved_source_id and mode_id != pattern_id and mode_id != position_id and mode_id != source_id
        and moved_source_id != pattern_id and moved_source_id != position_id and moved_source_id != source_id
        and pattern_id != position_id and pattern_id != source_id
        and position_id != source_id
    )
