# Source-linked proof of the closed builtin and stdlib refinement-law name set.
include "../../src/semantic/stdlib_refinement_law_name.elisa"

def source_classifier_has_exact_law_set(name: sview) -> bool:
    ensure result == (
        when name:
            "Aligned" | "Divides" | "Fits" | "MaskedZero" | "Nat" | "Positive" | "StrictlyPositive" | "NonNeg" -> true
            "Negative" | "NonPositive" | "Bounded" | "InRange" | "Even" | "Odd" | "NonZero" | "UpperBound" -> true
            "LowerBound" | "AtMost" | "AtLeast" | "Finite" | "Sorted" | "Unique" | "NonEmpty" -> true
            _ -> false
    )
    return StdlibRefinementLawName::is_stdlib_refinement_law(name)

def every_builtin_and_stdlib_law_is_recognized() -> bool:
    ensure result == true
    return (
        StdlibRefinementLawName::is_stdlib_refinement_law("Aligned")
        and StdlibRefinementLawName::is_stdlib_refinement_law("Divides")
        and StdlibRefinementLawName::is_stdlib_refinement_law("Fits")
        and StdlibRefinementLawName::is_stdlib_refinement_law("MaskedZero")
        and StdlibRefinementLawName::is_stdlib_refinement_law("Nat")
        and StdlibRefinementLawName::is_stdlib_refinement_law("Positive")
        and StdlibRefinementLawName::is_stdlib_refinement_law("StrictlyPositive")
        and StdlibRefinementLawName::is_stdlib_refinement_law("NonNeg")
        and StdlibRefinementLawName::is_stdlib_refinement_law("Negative")
        and StdlibRefinementLawName::is_stdlib_refinement_law("NonPositive")
        and StdlibRefinementLawName::is_stdlib_refinement_law("Bounded")
        and StdlibRefinementLawName::is_stdlib_refinement_law("InRange")
        and StdlibRefinementLawName::is_stdlib_refinement_law("Even")
        and StdlibRefinementLawName::is_stdlib_refinement_law("Odd")
        and StdlibRefinementLawName::is_stdlib_refinement_law("NonZero")
        and StdlibRefinementLawName::is_stdlib_refinement_law("UpperBound")
        and StdlibRefinementLawName::is_stdlib_refinement_law("LowerBound")
        and StdlibRefinementLawName::is_stdlib_refinement_law("AtMost")
        and StdlibRefinementLawName::is_stdlib_refinement_law("AtLeast")
        and StdlibRefinementLawName::is_stdlib_refinement_law("Finite")
        and StdlibRefinementLawName::is_stdlib_refinement_law("Sorted")
        and StdlibRefinementLawName::is_stdlib_refinement_law("Unique")
        and StdlibRefinementLawName::is_stdlib_refinement_law("NonEmpty")
    )

def ordinary_type_names_are_not_stdlib_laws() -> bool:
    ensure result == true
    return (
        not StdlibRefinementLawName::is_stdlib_refinement_law("String")
        and not StdlibRefinementLawName::is_stdlib_refinement_law("i64")
        and not StdlibRefinementLawName::is_stdlib_refinement_law("Positive?")
        and not StdlibRefinementLawName::is_stdlib_refinement_law("")
    )
