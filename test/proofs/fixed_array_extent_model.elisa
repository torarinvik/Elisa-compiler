# Model for inferred fixed-array const arguments: a positive observed extent binds
# the generic value, and every repeated use must equal that original binding.
def accepts_inferred_extent(bound: u32, actual: u32) -> bool:
    requires bound > 0 and actual > 0
    ensure result == (bound == actual)
    bound == actual

def same_extent_is_accepted(extent: u32) -> bool:
    requires extent > 0
    ensure result == true
    accepts_inferred_extent(extent, extent)

def conflicting_extent_is_rejected(first: u32, second: u32) -> bool:
    requires first > 0 and second > 0 and first != second
    ensure result == false
    accepts_inferred_extent(first, second)
