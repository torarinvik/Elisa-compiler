include "./literal_comparison_range.elisa"

def a_u8_maximum_is_outside() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return LiteralComparisonRange::is_outside("u8", LiteralComparisonRange::U8_MAX)

def an_i8_minimum_is_outside() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return LiteralComparisonRange::is_outside("i8", LiteralComparisonRange::I8_MIN)

def i64_is_a_supported_target_type() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return LiteralComparisonRange::is_supported_integer_type("i64")

# A value at the maximum of a type interval cannot be greater than the first
# integer immediately above that interval.
def an_u8_maximum_can_exceed_the_first_outside_value() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return LiteralComparisonRange::U8_MAX > LiteralComparisonRange::U8_MAX + 1

# A value at the minimum cannot be less than the first integer below the interval.
def an_i8_minimum_can_be_less_than_the_first_outside_value() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return LiteralComparisonRange::I8_MIN < LiteralComparisonRange::I8_MIN - 1
