# False bounds and storage claims about dictionary/set probes must remain unproved.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"

def a_dictionary_probe_can_escape_positive_capacity(m: dict[u64, u64]&, key: u64) -> bool:
    requires m.capacity > 0
    ensure result == true
    probe: DictProbeResult = arena_dict_find_index(m, key)
    return probe.index >= m.capacity

def a_set_probe_can_escape_positive_capacity(s: set[u64]&, key: u64) -> bool:
    requires s.capacity > 0
    ensure result == true
    probe: DictProbeResult = arena_set_find_index(s, key)
    return probe.index >= s.capacity

def a_cstr_view_probe_can_escape_positive_capacity(m: dict[cstr, u64]&, key: sview) -> bool:
    requires m.capacity > 0
    ensure result == true
    probe: DictProbeResult = arena_dict_find_cstr_view_index(m, key)
    return probe.index >= m.capacity

def a_probe_without_backing_storage_can_claim_a_match(m: dict[u64, u64]&, key: u64) -> bool:
    requires m.items == null
    ensure result == true
    probe: DictProbeResult = arena_dict_find_index(m, key)
    return probe.found
