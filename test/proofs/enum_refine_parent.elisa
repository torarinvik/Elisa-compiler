# Source-linked proof for enum inheritance rejecting a resolved struct parent.
module EnumRefineParentRule:
    public:
        const ENUM_REFINE_PARENT_ROW: u32 = 3900000008
        const ORDINARY_ANNOTATION_ROW: u32 = 3900000007

        def should_report(annotation_row: u32, enum_name: sview, parent_name: sview, parent_found: bool, parent_is_struct: bool) -> bool:
            ensure result == (annotation_row == ENUM_REFINE_PARENT_ROW and enum_name != "" and parent_name != "" and parent_found and parent_is_struct)
            return annotation_row == ENUM_REFINE_PARENT_ROW and enum_name != "" and parent_name != "" and parent_found and parent_is_struct

def source_rule_is_exact(annotation_row: u32, enum_name: sview, parent_name: sview, parent_found: bool, parent_is_struct: bool) -> bool:
    ensure result == true
    return EnumRefineParentRule::should_report(annotation_row, enum_name, parent_name, parent_found, parent_is_struct) ==
        (annotation_row == EnumRefineParentRule::ENUM_REFINE_PARENT_ROW and enum_name != "" and parent_name != "" and parent_found and parent_is_struct)

def a_resolved_struct_parent_is_rejected() -> bool:
    ensure result == true
    return EnumRefineParentRule::should_report(EnumRefineParentRule::ENUM_REFINE_PARENT_ROW, "BadEnum", "PlainStruct", true, true)

def an_enum_parent_is_allowed() -> bool:
    ensure result == true
    return not EnumRefineParentRule::should_report(EnumRefineParentRule::ENUM_REFINE_PARENT_ROW, "ChildEnum", "BaseEnum", true, false)

def an_unknown_parent_is_left_to_unknown_type_checking() -> bool:
    ensure result == true
    return not EnumRefineParentRule::should_report(EnumRefineParentRule::ENUM_REFINE_PARENT_ROW, "ChildEnum", "MissingType", false, false)

def empty_names_are_ignored() -> bool:
    ensure result == true
    return not EnumRefineParentRule::should_report(EnumRefineParentRule::ENUM_REFINE_PARENT_ROW, "", "PlainStruct", true, true) and
        not EnumRefineParentRule::should_report(EnumRefineParentRule::ENUM_REFINE_PARENT_ROW, "BadEnum", "", true, true)

def unrelated_annotation_rows_are_ignored() -> bool:
    ensure result == true
    return not EnumRefineParentRule::should_report(EnumRefineParentRule::ORDINARY_ANNOTATION_ROW, "BadEnum", "PlainStruct", true, true)
