# Exact proof for the three-byte marker prefix used to encode machine transitions.
include "../../src/parser/parser_machine_marker.elisa"

def production_machine_marker_prefix_is_exact(marker: sview) -> bool:
    ensure result == (marker.len >= 3 and marker[0] == 35 and marker[1] == 45 and marker[2] == 62)
    return ParserMachineMarker::has_prefix(marker)

def bare_transition_marker_has_the_prefix() -> bool:
    ensure result == true
    return ParserMachineMarker::has_prefix("#->")

def payload_transition_marker_has_the_prefix() -> bool:
    ensure result == true
    return ParserMachineMarker::has_prefix("#->NextState")

def short_transition_marker_lacks_the_prefix() -> bool:
    ensure result == true
    return not ParserMachineMarker::has_prefix("#-")

def wrong_transition_marker_lacks_the_prefix() -> bool:
    ensure result == true
    return not ParserMachineMarker::has_prefix("##->NextState")

def bare_transition_marker_matches_empty_target() -> bool:
    ensure result == true
    return ParserMachineMarker::matches("#->", "")

def one_byte_transition_marker_matches_target() -> bool:
    ensure result == true
    return ParserMachineMarker::matches("#->x", "x")

def multi_byte_transition_marker_matches_exact_target() -> bool:
    ensure result == true
    return ParserMachineMarker::matches("#->NextState", "NextState")

def different_payload_is_rejected() -> bool:
    ensure result == true
    return not ParserMachineMarker::matches("#->NextState", "OtherState")

def trailing_marker_bytes_are_rejected() -> bool:
    ensure result == true
    return not ParserMachineMarker::matches("#->NextState!", "NextState")

def missing_prefix_is_rejected_by_matcher() -> bool:
    ensure result == true
    return not ParserMachineMarker::matches("##->NextState", "NextState")
