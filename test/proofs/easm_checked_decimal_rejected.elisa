include "./easm_checked_decimal.elisa"

def positive_i64_overflow_is_accepted() -> bool:
    ensure result == true
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_positive_digit(
        EasmCheckedDecimal::I64_MAX / EasmCheckedDecimal::DECIMAL_RADIX,
        EasmCheckedDecimal::I64_MAX % EasmCheckedDecimal::DECIMAL_RADIX + 1)
    return step.valid

def negative_i64_underflow_is_accepted() -> bool:
    ensure result == true
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_negative_digit(
        EasmCheckedDecimal::I64_MIN / EasmCheckedDecimal::DECIMAL_RADIX,
        0 - (EasmCheckedDecimal::I64_MIN % EasmCheckedDecimal::DECIMAL_RADIX) + 1)
    return step.valid

def signed_parser_accepts_a_nondigit() -> bool:
    ensure result == true
    parsed: (valid: bool, value: i64) = EasmCheckedDecimal::parse_signed("7x")
    return parsed.valid

def signed_parser_accepts_positive_overflow() -> bool:
    ensure result == true
    parsed: (valid: bool, value: i64) = EasmCheckedDecimal::parse_signed("9223372036854775808")
    return parsed.valid

def signed_parser_accepts_negative_underflow() -> bool:
    ensure result == true
    parsed: (valid: bool, value: i64) = EasmCheckedDecimal::parse_signed("-9223372036854775809")
    return parsed.valid

def signed_parser_returns_positive_for_negative_input() -> bool:
    ensure result == true
    parsed: (valid: bool, value: i64) = EasmCheckedDecimal::parse_signed("-1")
    return parsed.valid and parsed.value > 0

def signed_parser_returns_negative_for_positive_input() -> bool:
    ensure result == true
    parsed: (valid: bool, value: i64) = EasmCheckedDecimal::parse_signed("1")
    return parsed.valid and parsed.value < 0
