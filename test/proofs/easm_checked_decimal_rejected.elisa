include "./easm_checked_decimal.elisa"

def positive_i64_overflow_is_accepted() -> bool:
    ensure result == true
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_positive_digit(
        EasmCheckedDecimal::I64_MAX / EasmCheckedDecimal::DECIMAL_RADIX,
        EasmCheckedDecimal::I64_MAX % EasmCheckedDecimal::DECIMAL_RADIX + 1)
    return step.valid

def negative_i64_underflow_is_accepted() -> bool:
    ensure result == true
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_negative_digit(
        EasmCheckedDecimal::I64_MIN / EasmCheckedDecimal::DECIMAL_RADIX,
        0 - (EasmCheckedDecimal::I64_MIN % EasmCheckedDecimal::DECIMAL_RADIX) + 1)
    return step.valid
