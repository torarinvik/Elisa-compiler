# The admission checker binds this Boolean model to Not's lexer, parser, and LLVM branch.
include "./codegen_unary_boolean_model.elisa"

def i1_xor_one_matches_logical_not(value: bool) -> bool:
    ensure result == true
    if value:
        return (false if value else true) == (not value)
    else:
        return (false if value else true) == (not value)

def lowering_not_false_produces_true() -> bool:
    ensure result == true
    return false if false else true

def lowering_not_true_produces_false() -> bool:
    ensure result == false
    return false if true else true
