# The contract model is source-checked against Semantic.int_fits_storage's i32 branch.
def proof_const_enum_i32_fits(value: i64) -> bool:
    ensure result == (value >= (0 - 2147483648) and value <= 2147483647)
    return value >= (0 - 2147483648) and value <= 2147483647

def const_enum_i32_accepts_in_range(value: i64) -> bool:
    requires value >= (0 - 2147483648) and value <= 2147483647
    ensure result == true
    return proof_const_enum_i32_fits(value)

def const_enum_i32_rejects_below_range(value: i64) -> bool:
    requires value < (0 - 2147483648)
    ensure result == true
    return not proof_const_enum_i32_fits(value)

def const_enum_i32_rejects_above_range(value: i64) -> bool:
    requires value > 2147483647
    ensure result == true
    return not proof_const_enum_i32_fits(value)
