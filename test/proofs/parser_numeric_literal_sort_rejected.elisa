include "../../src/parser/parser_numeric_literal_sort_model.elisa"

def float_token_is_accepted() -> bool:
    ensure result == true
    return ParserNumericLiteralSort::accepts_integer_token(false, false)

def unsupported_u128_suffix_is_accepted() -> bool:
    ensure result == true
    return ParserNumericLiteralSort::accepts_suffix("u128")

def signed_i8_suffix_is_rejected() -> bool:
    ensure result == true
    return not ParserNumericLiteralSort::accepts_suffix("i8")

def out_of_source_span_is_accepted(start: usize, length: usize, source_length: usize) -> bool:
    requires start < source_length
    requires length > source_length - start
    ensure result == true
    return ParserNumericLiteralSort::span_fits(start, length, source_length)

def integer_gate_accepts_neither_kind() -> bool:
    ensure result == true
    return ParserNumericLiteralSort::accepts_integer_token(false, false) == true
