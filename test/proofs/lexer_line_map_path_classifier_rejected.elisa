# False controls for the source-span, realpath, strict-prefix, and byte-match guards.
include "./lexer_line_map_path_classifier_model.elisa"

def false_accepts_a_source_span_one_byte_too_long() -> bool:
    ensure result == true
    return true and 8192 > 0 and 8192 <= SOURCE_LINE_MAP_PATH_LIMIT_MODEL and true and true and 15 < SOURCE_LINE_MAP_REALPATH_CAPACITY_MODEL and 15 > 14 and true

def false_accepts_the_trusted_root_itself() -> bool:
    ensure result == true
    return true and 1 > 0 and 1 <= SOURCE_LINE_MAP_PATH_LIMIT_MODEL and true and true and 14 < SOURCE_LINE_MAP_REALPATH_CAPACITY_MODEL and 14 > 14 and true

def false_accepts_a_resolved_path_shorter_than_the_trusted_root() -> bool:
    ensure result == true
    return true and 1 > 0 and 1 <= SOURCE_LINE_MAP_PATH_LIMIT_MODEL and true and true and 13 < SOURCE_LINE_MAP_REALPATH_CAPACITY_MODEL and 13 > 14 and true

def false_accepts_a_prefix_byte_mismatch() -> bool:
    ensure result == true
    return true and 1 > 0 and 1 <= SOURCE_LINE_MAP_PATH_LIMIT_MODEL and true and true and 15 < SOURCE_LINE_MAP_REALPATH_CAPACITY_MODEL and 15 > 14 and false

def false_accepts_a_failed_realpath() -> bool:
    ensure result == true
    return true and 1 > 0 and 1 <= SOURCE_LINE_MAP_PATH_LIMIT_MODEL and true and false and 15 < SOURCE_LINE_MAP_REALPATH_CAPACITY_MODEL and 15 > 14 and true

def false_accepts_a_path_without_the_std_component() -> bool:
    ensure result == true
    return true and 1 > 0 and 1 <= SOURCE_LINE_MAP_PATH_LIMIT_MODEL and false and true and 15 < SOURCE_LINE_MAP_REALPATH_CAPACITY_MODEL and 15 > 14 and true

def false_accepts_an_unsupported_platform() -> bool:
    ensure result == true
    return false and 1 > 0 and 1 <= SOURCE_LINE_MAP_PATH_LIMIT_MODEL and true and true and 15 < SOURCE_LINE_MAP_REALPATH_CAPACITY_MODEL and 15 > 14 and true

def false_accepts_a_realpath_buffer_without_a_terminator() -> bool:
    ensure result == true
    return true and 1 > 0 and 1 <= SOURCE_LINE_MAP_PATH_LIMIT_MODEL and true and true and 8192 < SOURCE_LINE_MAP_REALPATH_CAPACITY_MODEL and 8192 > 14 and true

def false_accepts_a_marker_with_a_mismatched_byte() -> bool:
    ensure result == true
    return component_candidate_matches_exact_runtime_marker(101, 108, 105, 115, 97, 99, 111, 114, 101, 95, 115, 116, 100, 46, true, true)

def false_accepts_a_marker_at_the_path_start() -> bool:
    ensure result == true
    return component_candidate_matches_exact_runtime_marker(101, 108, 105, 115, 97, 99, 111, 114, 101, 95, 115, 116, 100, 47, false, true)

def false_accepts_a_marker_without_a_preceding_separator() -> bool:
    ensure result == true
    return component_candidate_matches_exact_runtime_marker(101, 108, 105, 115, 97, 99, 111, 114, 101, 95, 115, 116, 100, 47, true, false)

