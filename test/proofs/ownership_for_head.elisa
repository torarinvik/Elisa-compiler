include "../../src/semantic/ownership_flow_domain.elisa"

# A potentially repeated consume contributes a consumed path at the loop head.
def repeated_consume_blocks_move(entry_consumed: bool, known: bool, live: bool) -> bool:
    ensure result == false
    consumed: bool = OwnershipFlow::join_reachable_possible(true, entry_consumed, true, true)
    return OwnershipFlow::can_move(known, live, consumed)

# A body which returns contributes no back edge. The entry owner stays available.
def returning_body_preserves_move(back_consumed: bool) -> bool:
    ensure result == true
    consumed: bool = OwnershipFlow::join_reachable_possible(true, false, false, back_consumed)
    return OwnershipFlow::can_move(true, true, consumed)
