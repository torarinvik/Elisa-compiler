include "./comparison_operator_policy.elisa"

def logical_and_is_a_comparison_operator() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return ComparisonOperatorPolicy::is_comparison(Lexer::TokenKind.And)

def assignment_is_a_comparison_operator() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return ComparisonOperatorPolicy::is_comparison(Lexer::TokenKind.Assign)
