# Payload range lemmas for each canonical three- and four-byte UTF-8 lead class.
# The source checker relates these linear forms to the production constants and decoders.

def three_byte_e0_boundary_range(second_payload: i64, third_payload: i64) -> i64:
    requires second_payload >= 32 and second_payload <= 63
    requires third_payload >= 0 and third_payload <= 63
    ensure result >= 2048
    ensure result <= 65535
    return second_payload * 64 + third_payload

def three_byte_below_surrogate_range(lead_payload: i64, second_payload: i64, third_payload: i64) -> i64:
    requires lead_payload >= 1 and lead_payload <= 12
    requires second_payload >= 0 and second_payload <= 63
    requires third_payload >= 0 and third_payload <= 63
    ensure result >= 2048
    ensure result < 55296
    return lead_payload * 4096 + second_payload * 64 + third_payload

def three_byte_ed_boundary_range(second_payload: i64, third_payload: i64) -> i64:
    requires second_payload >= 0 and second_payload <= 31
    requires third_payload >= 0 and third_payload <= 63
    ensure result < 55296
    return 13 * 4096 + second_payload * 64 + third_payload

def three_byte_above_surrogate_range(lead_payload: i64, second_payload: i64, third_payload: i64) -> i64:
    requires lead_payload >= 14 and lead_payload <= 15
    requires second_payload >= 0 and second_payload <= 63
    requires third_payload >= 0 and third_payload <= 63
    ensure result > 57343
    ensure result <= 65535
    return lead_payload * 4096 + second_payload * 64 + third_payload

def four_byte_f0_prefix_range(second_payload: i64) -> i64:
    requires second_payload >= 16 and second_payload <= 63
    ensure result >= 65536
    ensure result <= 258048
    return second_payload * 4096

def four_byte_middle_prefix_range(lead_payload: i64, second_payload: i64) -> i64:
    requires lead_payload >= 1 and lead_payload <= 3
    requires second_payload >= 0 and second_payload <= 63
    ensure result >= 262144
    ensure result <= 1044480
    return lead_payload * 262144 + second_payload * 4096

def four_byte_f4_prefix_range(second_payload: i64) -> i64:
    requires second_payload >= 0 and second_payload <= 15
    ensure result >= 1048576
    ensure result <= 1110016
    return 4 * 262144 + second_payload * 4096

def four_byte_suffix_range(third_payload: i64, fourth_payload: i64) -> i64:
    requires third_payload >= 0 and third_payload <= 63
    requires fourth_payload >= 0 and fourth_payload <= 63
    ensure result >= 0
    ensure result <= 4095
    return third_payload * 64 + fourth_payload

def four_byte_f0_combined_scalar_range(prefix: i64, suffix: i64) -> i64:
    requires prefix >= 65536 and prefix <= 258048
    requires suffix >= 0 and suffix <= 4095
    ensure result >= 65536
    ensure result <= 262143
    return prefix + suffix

def four_byte_middle_combined_scalar_range(prefix: i64, suffix: i64) -> i64:
    requires prefix >= 262144 and prefix <= 1044480
    requires suffix >= 0 and suffix <= 4095
    ensure result >= 65536
    ensure result <= 1048575
    return prefix + suffix

def four_byte_f4_combined_scalar_range(prefix: i64, suffix: i64) -> i64:
    requires prefix >= 1048576 and prefix <= 1110016
    requires suffix >= 0 and suffix <= 4095
    ensure result >= 1048576
    ensure result <= 1114111
    return prefix + suffix
