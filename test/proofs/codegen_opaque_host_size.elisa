# Source-linked proof of the boolean model used by the backend's inline C ABI size table.
include "../../src/backend/codegen_opaque_host_size.elisa"

const EXPECTED_PTHREAD_MUTEX_HOST_BYTES: i64 = 64
const EXPECTED_PTHREAD_COND_HOST_BYTES: i64 = 48
const EXPECTED_PTHREAD_ONCE_HOST_BYTES: i64 = 16
const EXPECTED_UNKNOWN_OPAQUE_HOST_BYTES: i64 = -1

def every_boolean_flag_tuple_uses_the_exact_size_rule(is_mutex: bool, is_cond: bool, is_once: bool) -> i64:
    ensure (
        (not is_mutex or result == EXPECTED_PTHREAD_MUTEX_HOST_BYTES)
        and (is_mutex or not is_cond or result == EXPECTED_PTHREAD_COND_HOST_BYTES)
        and (is_mutex or is_cond or not is_once or result == EXPECTED_PTHREAD_ONCE_HOST_BYTES)
        and (is_mutex or is_cond or is_once or result == EXPECTED_UNKNOWN_OPAQUE_HOST_BYTES)
    )
    return BackendOpaqueHostSize::c_opaque_host_size_from_flags(is_mutex, is_cond, is_once)

def supported_inline_opaque_types_have_exact_sizes() -> bool:
    ensure result == true
    return (
        BackendOpaqueHostSize::c_opaque_host_size_from_flags(true, false, false) == EXPECTED_PTHREAD_MUTEX_HOST_BYTES
        and BackendOpaqueHostSize::c_opaque_host_size_from_flags(false, true, false) == EXPECTED_PTHREAD_COND_HOST_BYTES
        and BackendOpaqueHostSize::c_opaque_host_size_from_flags(false, false, true) == EXPECTED_PTHREAD_ONCE_HOST_BYTES
    )

def no_supported_type_flag_uses_the_unknown_sentinel() -> bool:
    ensure result == true
    return BackendOpaqueHostSize::c_opaque_host_size_from_flags(false, false, false) == EXPECTED_UNKNOWN_OPAQUE_HOST_BYTES
