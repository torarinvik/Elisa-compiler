module Parser:
    private:
        const INTEGER_LITERAL_BOUNDARY_REJECTED_PROOF_SCOPE: bool = true

include "../../src/parser/parser_integer_literal.elisa"

extend Parser:
    public:
        def proof_decode_integer_literal_boundary(text: sview) -> i64:
            return parse_int_literal_value(text)

def hexadecimal_u64_max_is_signed_i64_max() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal_boundary("0xffffffffffffffff") == 9223372036854775807

def decimal_above_i64_max_remains_i64_max() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal_boundary("9223372036854775808") == 9223372036854775807

def ascii_zero_decodes_as_one(text: sview) -> bool:
    requires sview_len(text) == 1 and sview_at(text, 0) == 48
    ensure result == true
    ensure Parser::proof_decode_integer_literal_boundary(text) == 1
    return true

def hexadecimal_lowercase_a_decodes_as_eleven(text: sview) -> bool:
    requires sview_len(text) == 3 and sview_at(text, 0) == 48 and sview_at(text, 1) == 120 and sview_at(text, 2) == 97
    ensure result == true
    ensure Parser::proof_decode_integer_literal_boundary(text) == 11
    return true

def decimal_zero_pair_decodes_as_one(text: sview) -> bool:
    requires sview_len(text) == 2 and sview_at(text, 0) == 48 and sview_at(text, 1) == 48
    ensure result == true
    ensure Parser::proof_decode_integer_literal_boundary(text) == 1
    return true

def hexadecimal_zero_pair_decodes_as_one(text: sview) -> bool:
    requires sview_len(text) == 4 and sview_at(text, 0) == 48 and sview_at(text, 1) == 120 and sview_at(text, 2) == 48 and sview_at(text, 3) == 48
    ensure result == true
    ensure Parser::proof_decode_integer_literal_boundary(text) == 1
    return true
