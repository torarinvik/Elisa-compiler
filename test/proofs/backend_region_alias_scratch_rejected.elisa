include "./backend_region_alias_scratch.elisa"

def false_fallback_scratch_reuses_a_fact_slot(fact_count: usize, fact_slot: usize, scratch_slot: usize) -> bool:
    requires fact_count == 4 and fact_slot == 3 and scratch_slot == fact_count
    ensure result == true
    return fact_slot == scratch_slot

def false_fallback_changes_the_previous_graph_slot(previous_slot: usize, restored_slot: usize) -> bool:
    requires previous_slot == 2 and restored_slot == 3
    ensure result == true
    return restored_slot == previous_slot

