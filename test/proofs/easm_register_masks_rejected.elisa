include "../../src/backend/easm_register_masks.elisa"

def call_preserves_rcx() -> bool:
    ensure result == true
    return (EasmRegisterMasks::call_clobber_mask() & EasmRegisterMasks::RCX) == 0

def live_invalidation_equals_full_clobber_mask() -> bool:
    ensure result == true
    return EasmRegisterMasks::call_invalidates_live_mask() == EasmRegisterMasks::call_clobber_mask()

def rax_and_rcx_masks_overlap() -> bool:
    ensure result == true
    return (EasmRegisterMasks::RAX & EasmRegisterMasks::RCX) != 0

def rip_is_the_rsp_register() -> bool:
    ensure result == true
    return EasmRegisterMasks::register_bit("rip") == EasmRegisterMasks::RSP

def uppercase_rax_is_a_register_alias() -> bool:
    ensure result == true
    return EasmRegisterMasks::register_bit("RAX") == EasmRegisterMasks::RAX

def r16_is_a_supported_register_alias() -> bool:
    ensure result == true
    return EasmRegisterMasks::register_bit("r16") == EasmRegisterMasks::R15

def high_byte_alias_is_supported() -> bool:
    ensure result == true
    return EasmRegisterMasks::register_bit("ah") == EasmRegisterMasks::RAX

def byte_alias_has_a_distinct_register_bit() -> bool:
    ensure result == true
    return EasmRegisterMasks::register_bit("al") == 65536

def r14_and_r15_masks_overlap() -> bool:
    ensure result == true
    return (EasmRegisterMasks::R14 & EasmRegisterMasks::R15) != 0i64
