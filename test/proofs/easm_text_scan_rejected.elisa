# A whitespace after the first separator cannot be reported as the first one.
include "./easm_text_scan.elisa"

def false_claim_scanner_skips_the_first_separator() -> bool:
    ensure result == true
    position: i64 = EasmTextScan::first_space("a b")
    return position == 3

def false_claim_nonprefix_matches() -> bool:
    ensure result == true
    return EasmTextScan::starts_with("add", "mov")

def false_claim_longer_prefix_matches() -> bool:
    ensure result == true
    return EasmTextScan::starts_with("x", "xyz")

def false_claim_late_prefix_mismatch_is_ignored() -> bool:
    ensure result == true
    return EasmTextScan::starts_with("movq", "movx")

def false_claim_empty_prefix_does_not_match() -> bool:
    ensure result == true
    return EasmTextScan::starts_with("ret", "") == false

def false_claim_different_mnemonics_are_equal() -> bool:
    ensure result == true
    return EasmTextScan::equal("movq", "addq")

def false_claim_a_proper_prefix_is_equal() -> bool:
    ensure result == true
    return EasmTextScan::equal("mov", "movq")

def false_claim_equal_length_text_ignores_the_last_byte() -> bool:
    ensure result == true
    return EasmTextScan::equal("movq", "movx")

def false_claim_find_returns_a_later_duplicate_match() -> bool:
    ensure result == true
    return EasmTextScan::find("ababa", "ba") == 3

def false_claim_missing_needle_returns_zero() -> bool:
    ensure result == true
    return EasmTextScan::find("abc", "z") == 0

def false_claim_empty_needle_returns_zero() -> bool:
    ensure result == true
    return EasmTextScan::find("abc", "") == 0

def false_claim_delimiter_free_operand_is_memory() -> bool:
    ensure result == true
    return EasmTextScan::contains_memory_address_delimiter(false, false)

def false_claim_trim_keeps_a_leading_space() -> bool:
    ensure result == true
    trimmed: sview = EasmTextScan::trim(" x ")
    return trimmed.len > 0 and trimmed[0] == EasmTextScan::ASCII_SPACE

def false_claim_trim_keeps_a_trailing_tab() -> bool:
    ensure result == true
    trimmed: sview = EasmTextScan::trim("x\t")
    return trimmed.len > 0 and trimmed[trimmed.len - 1.usize()] == EasmTextScan::ASCII_TAB

def false_claim_trim_discards_internal_whitespace() -> bool:
    ensure result == true
    return EasmTextScan::trim("left right") == "leftright"

def false_claim_trim_all_whitespace_returns_start() -> bool:
    ensure result == true
    bounds: EasmTextScan::TrimBounds = EasmTextScan::trim_bounds(" \t ")
    return bounds.start == 0 and bounds.end == 0
