include "./backend_noalias_abi_boundary.elisa"

def false_external_linkage_keeps_noalias(linkage: u32) -> bool:
    requires linkage == 0
    ensure result == true
    return not (linkage != LLVM_INTERNAL_LINKAGE and linkage != LLVM_PRIVATE_LINKAGE)

def false_internal_linkage_strips_noalias(linkage: u32) -> bool:
    requires linkage == LLVM_INTERNAL_LINKAGE
    ensure result == true
    return linkage != LLVM_INTERNAL_LINKAGE and linkage != LLVM_PRIVATE_LINKAGE

def false_first_parameter_uses_function_attribute_index(offset: u64, parameter_count: u64) -> bool:
    requires offset == 0 and parameter_count > 0
    ensure result == true
    return offset + 1 == 0

