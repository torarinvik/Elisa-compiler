include "../../src/semantic/ownership_flow_domain.elisa"

def dead_paths_have_no_possible_owner(a: bool, b: bool) -> bool:
    ensure result == false
    return OwnershipFlow::join_reachable_possible(false, a, false, b)

def dead_paths_cannot_grant_knowledge(a: bool, b: bool) -> bool:
    ensure result == false
    return OwnershipFlow::join_reachable_known(false, a, false, b)

def live_known_predecessors() -> bool:
    ensure result == true
    return OwnershipFlow::join_reachable_known(true, true, true, true)
