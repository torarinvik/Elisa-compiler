# The call emitter compares its target's declared LLVM parameter count with the
# fixed signature slots, plus hidden ABI slots and any C view splits.
def call_declared_llvm_parameter_count(fixed_arguments: i64, total_arguments: i64, arena_count: i64, wants_store: bool, sret_return: bool, error_return: bool, extern_error_sret: bool, split_view_params: i64, variadic_call: bool, uses_defaults: bool) -> i64:
    requires fixed_arguments >= 0 and total_arguments >= 0 and arena_count >= 0 and split_view_params >= 0
    ensure result == (fixed_arguments if variadic_call or uses_defaults else total_arguments) + arena_count + (1 if wants_store else 0) + (1 if sret_return else 0) + (1 if error_return else 0) + (1 if extern_error_sret else 0) + split_view_params
    explicit_count: i64 = fixed_arguments if variadic_call or uses_defaults else total_arguments
    return explicit_count + arena_count + (1 if wants_store else 0) + (1 if sret_return else 0) + (1 if error_return else 0) + (1 if extern_error_sret else 0) + split_view_params

def defaulted_call_uses_fixed_signature_count(fixed_arguments: i64, supplied_arguments: i64) -> i64:
    requires fixed_arguments >= 0 and supplied_arguments >= 0 and supplied_arguments < fixed_arguments
    ensure result == fixed_arguments
    return fixed_arguments

def variadic_call_uses_fixed_signature_count(fixed_arguments: i64, supplied_arguments: i64) -> i64:
    requires fixed_arguments >= 0 and supplied_arguments >= fixed_arguments
    ensure result == fixed_arguments
    return fixed_arguments

def nondefaulted_fixed_call_uses_supplied_count(total_arguments: i64) -> i64:
    requires total_arguments >= 0
    ensure result == total_arguments
    return total_arguments
