# False claims about supported range forms and upper-bound comparisons.
include "./codegen_range_membership.elisa"

def false_claim_exclusive_range_uses_inclusive_upper_operator() -> bool:
    ensure result == true
    return BackendRangeMembershipPolicy::upper_operator(TokenKind.RangeLt) == TokenKind.LtEq

def false_claim_greater_than_range_is_supported() -> bool:
    ensure result == true
    return BackendRangeMembershipPolicy::is_range_operator(TokenKind.RangeGt)

def false_claim_inclusive_range_uses_strict_upper_operator() -> bool:
    ensure result == true
    return BackendRangeMembershipPolicy::upper_operator(TokenKind.RangeLe) == TokenKind.Lt
