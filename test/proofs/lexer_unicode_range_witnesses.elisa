# Concrete endpoint witnesses rendered from the generated classifier.

def unicode_letter_cjk_extension_a_lower_boundary_is_in_table() -> bool:
    ensure result == true
    return (0x3400 >= 0x3131 and 0x3400 <= 0x318E) or (0x3400 >= 0x31A0 and 0x3400 <= 0x31BF) or (0x3400 >= 0x31F0 and 0x3400 <= 0x31FF) or (0x3400 >= 0x3400 and 0x3400 <= 0x4DBF) or (0x3400 >= 0x4E00 and 0x3400 <= 0xA48C) or (0x3400 >= 0xA4D0 and 0x3400 <= 0xA4FD) or (0x3400 >= 0xA500 and 0x3400 <= 0xA60C) or (0x3400 >= 0xA610 and 0x3400 <= 0xA61F) or (0x3400 >= 0xA62A and 0x3400 <= 0xA62B) or (0x3400 >= 0xA640 and 0x3400 <= 0xA66E) or (0x3400 >= 0xA67F and 0x3400 <= 0xA69D) or (0x3400 >= 0xA6A0 and 0x3400 <= 0xA6E5)

