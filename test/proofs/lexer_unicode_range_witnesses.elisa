    ensure result == false
    return (0x1D800 >= 0x16AC0 and 0x1D800 <= 0x16AC9) or (0x1D800 >= 0x16B50 and 0x1D800 <= 0x16B59) or (0x1D800 >= 0x16D70 and 0x1D800 <= 0x16D79) or (0x1D800 >= 0x1CCF0 and 0x1D800 <= 0x1CCF9) or (0x1D800 >= 0x1D7CE and 0x1D800 <= 0x1D7FF) or (0x1D800 >= 0x1E140 and 0x1D800 <= 0x1E149) or (0x1D800 >= 0x1E2F0 and 0x1D800 <= 0x1E2F9) or (0x1D800 >= 0x1E4F0 and 0x1D800 <= 0x1E4F9) or (0x1D800 >= 0x1E5F1 and 0x1D800 <= 0x1E5FA) or (0x1D800 >= 0x1E950 and 0x1D800 <= 0x1E959) or (0x1D800 >= 0x1FBF0 and 0x1D800 <= 0x1FBF9)

def unicode_letter_first_generated_lower_boundary_is_in_table() -> bool:
    ensure result == true
    return (0x800 >= 0x800 and 0x800 <= 0x815) or 0x800 == 0x81A or 0x800 == 0x824 or 0x800 == 0x828 or (0x800 >= 0x840 and 0x800 <= 0x858) or (0x800 >= 0x860 and 0x800 <= 0x86A) or (0x800 >= 0x870 and 0x800 <= 0x887) or (0x800 >= 0x889 and 0x800 <= 0x88F) or (0x800 >= 0x8A0 and 0x800 <= 0x8C9) or (0x800 >= 0x904 and 0x800 <= 0x939) or 0x800 == 0x93D or 0x800 == 0x950

def unicode_letter_final_generated_upper_boundary_is_in_table() -> bool:
    ensure result == true
    return (0x33479 >= 0x30000 and 0x33479 <= 0x3134A) or (0x33479 >= 0x31350 and 0x33479 <= 0x33479)

def unicode_letter_scalar_after_final_generated_range_is_outside_table() -> bool:
    ensure result == false
    return (0x3347A >= 0x30000 and 0x3347A <= 0x3134A) or (0x3347A >= 0x31350 and 0x3347A <= 0x33479)

def unicode_letter_supplementary_boundary_routes_to_page_one() -> bool:
    ensure result == true
    return ((0x10000 >= 0x800 and 0x10000 <= 0xFFFF) and false) or ((0x10000 >= 0x10000 and 0x10000 <= 0x1FFFF) and true) or ((0x10000 >= 0x20000 and 0x10000 <= 0x2FFFF) and false) or ((0x10000 >= 0x30000 and 0x10000 <= 0x3FFFF) and false)

def unicode_letter_scalar_after_last_dispatch_page_is_unrouted() -> bool:
    ensure result == false
    return ((0x40000 >= 0x800 and 0x40000 <= 0xFFFF) and true) or ((0x40000 >= 0x10000 and 0x40000 <= 0x1FFFF) and true) or ((0x40000 >= 0x20000 and 0x40000 <= 0x2FFFF) and true) or ((0x40000 >= 0x30000 and 0x40000 <= 0x3FFFF) and true)

def unicode_surrogate_interval_is_not_a_scalar_interval() -> bool:
    ensure result == false
    return (0xD800 >= 0 and 0xD800 <= 0xDFFF and 0xDFFF <= 0x10FFFF and (0xDFFF < 0xD800 or 0xD800 > 0xDFFF))
