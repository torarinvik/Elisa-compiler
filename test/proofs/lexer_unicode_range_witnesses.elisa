def unicode_digit_mathematical_digit_lower_boundary_is_in_table() -> bool:
    ensure result == true
    return (0x1D7CE >= 0x16AC0 and 0x1D7CE <= 0x16AC9) or (0x1D7CE >= 0x16B50 and 0x1D7CE <= 0x16B59) or (0x1D7CE >= 0x16D70 and 0x1D7CE <= 0x16D79) or (0x1D7CE >= 0x1CCF0 and 0x1D7CE <= 0x1CCF9) or (0x1D7CE >= 0x1D7CE and 0x1D7CE <= 0x1D7FF) or (0x1D7CE >= 0x1E140 and 0x1D7CE <= 0x1E149) or (0x1D7CE >= 0x1E2F0 and 0x1D7CE <= 0x1E2F9) or (0x1D7CE >= 0x1E4F0 and 0x1D7CE <= 0x1E4F9) or (0x1D7CE >= 0x1E5F1 and 0x1D7CE <= 0x1E5FA) or (0x1D7CE >= 0x1E950 and 0x1D7CE <= 0x1E959) or (0x1D7CE >= 0x1FBF0 and 0x1D7CE <= 0x1FBF9)

