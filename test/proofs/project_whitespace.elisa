# Source-linked proof of the byte set accepted by the project-system whitespace predicate.
include "../../src/driver/project.elisa"
include "./project_whitespace_control_bytes.elisa"

def production_predicate_matches_its_exact_byte_set(byte: u8) -> bool:
    ensure result == (
        byte == ProjectSystemWhitespaceByte::ASCII_SPACE or
        byte == ProjectSystemWhitespaceByte::ASCII_HORIZONTAL_TAB or
        byte == ProjectSystemWhitespaceByte::ASCII_LINE_FEED or
        byte == ProjectSystemWhitespaceByte::ASCII_CARRIAGE_RETURN
    )
    return ProjectSystem::bytes_is_space(byte)

def all_project_whitespace_bytes_are_recognized() -> bool:
    ensure result == true
    return (
        ProjectSystem::bytes_is_space(ProjectSystemWhitespaceByte::ASCII_SPACE) and
        ProjectSystem::bytes_is_space(ProjectSystemWhitespaceByte::ASCII_HORIZONTAL_TAB) and
        ProjectSystem::bytes_is_space(ProjectSystemWhitespaceByte::ASCII_LINE_FEED) and
        ProjectSystem::bytes_is_space(ProjectSystemWhitespaceByte::ASCII_CARRIAGE_RETURN)
    )

def nearby_ascii_controls_are_not_project_whitespace() -> bool:
    ensure result == true
    return (
        not ProjectSystem::bytes_is_space(ProjectWhitespaceControlByte::ASCII_VERTICAL_TAB) and
        not ProjectSystem::bytes_is_space(ProjectWhitespaceControlByte::ASCII_FORM_FEED) and
        not ProjectSystem::bytes_is_space(ProjectWhitespaceControlByte::ASCII_EXCLAMATION_MARK)
    )

def non_space_singleton_is_preserved_by_project_trimming(byte: u8) -> bool:
    requires not ProjectSystem::bytes_is_space(byte)
    ensure result == true
    value: darray[u8] = [byte]
    return (
        ProjectSystem::bytes_trim_start(value) == 0 and
        ProjectSystem::bytes_trim_end(value) == 1 and
        not ProjectSystem::bytes_is_blank(value)
    )

def whitespace_singleton_trims_to_blank(byte: u8) -> bool can[Memory.Allocate, Abort.Panic]:
    requires ProjectSystem::bytes_is_space(byte)
    ensure result == true
    value: darray[u8] = [byte]
    trimmed: darray[u8] = ProjectSystem::bytes_trimmed(value)
    return (
        ProjectSystem::bytes_trim_start(value) == 1 and
        ProjectSystem::bytes_trim_end(value) == 1 and
        ProjectSystem::bytes_is_blank(value) and
        trimmed.count == 0
    )

def surrounding_project_whitespace_preserves_the_middle_byte(byte: u8) -> bool can[Memory.Allocate, Abort.Panic]:
    requires not ProjectSystem::bytes_is_space(byte)
    ensure result == true
    value: darray[u8] = [ProjectSystemWhitespaceByte::ASCII_SPACE, byte, ProjectSystemWhitespaceByte::ASCII_HORIZONTAL_TAB]
    trimmed: darray[u8] = ProjectSystem::bytes_trimmed(value)
    return (
        ProjectSystem::bytes_trim_start(value) == 1 and
        ProjectSystem::bytes_trim_end(value) == 2 and
        not ProjectSystem::bytes_is_blank(value) and
        trimmed.count == 1 and
        trimmed[0] == byte
    )

def blank_project_value_uses_the_fallback(byte: u8) -> bool can[Memory.Allocate, Abort.Panic]:
    requires ProjectSystem::bytes_is_space(byte)
    ensure result == true
    value: darray[u8] = [byte]
    fallback: sview = "default"
    resolved: darray[u8] = ProjectSystem::bytes_or_default(value, fallback)
    return ProjectSystem::bytes_equal_view(resolved, fallback)

def nonblank_project_value_is_preserved(byte: u8) -> bool can[Memory.Allocate, Abort.Panic]:
    requires not ProjectSystem::bytes_is_space(byte)
    ensure result == true
    value: darray[u8] = [byte]
    resolved: darray[u8] = ProjectSystem::bytes_or_default(value, "default")
    return resolved.count == 1 and resolved[0] == byte
