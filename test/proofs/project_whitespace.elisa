# Source-linked proof of the byte set accepted by the project-system whitespace predicate.
include "../../src/driver/project.elisa"
include "./project_whitespace_control_bytes.elisa"

def production_predicate_matches_its_exact_byte_set(byte: u8) -> bool:
    ensure result == (
        byte == ProjectSystemWhitespaceByte::ASCII_SPACE or
        byte == ProjectSystemWhitespaceByte::ASCII_HORIZONTAL_TAB or
        byte == ProjectSystemWhitespaceByte::ASCII_LINE_FEED or
        byte == ProjectSystemWhitespaceByte::ASCII_CARRIAGE_RETURN
    )
    return ProjectSystem::bytes_is_space(byte)

def all_project_whitespace_bytes_are_recognized() -> bool:
    ensure result == true
    return (
        ProjectSystem::bytes_is_space(ProjectSystemWhitespaceByte::ASCII_SPACE) and
        ProjectSystem::bytes_is_space(ProjectSystemWhitespaceByte::ASCII_HORIZONTAL_TAB) and
        ProjectSystem::bytes_is_space(ProjectSystemWhitespaceByte::ASCII_LINE_FEED) and
        ProjectSystem::bytes_is_space(ProjectSystemWhitespaceByte::ASCII_CARRIAGE_RETURN)
    )

def nearby_ascii_controls_are_not_project_whitespace() -> bool:
    ensure result == true
    return (
        not ProjectSystem::bytes_is_space(ProjectWhitespaceControlByte::ASCII_VERTICAL_TAB) and
        not ProjectSystem::bytes_is_space(ProjectWhitespaceControlByte::ASCII_FORM_FEED) and
        not ProjectSystem::bytes_is_space(ProjectWhitespaceControlByte::ASCII_EXCLAMATION_MARK)
    )
