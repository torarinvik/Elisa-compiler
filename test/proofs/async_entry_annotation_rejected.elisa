include "./async_entry_annotation.elisa"

def segment_agnostic_alone_is_insufficient() -> bool:
    ensure result == true
    return AsyncEntryAnnotationRule::needs_segment_diagnostic(true, true, false)

def segment_establishing_alone_is_insufficient() -> bool:
    ensure result == true
    return AsyncEntryAnnotationRule::needs_segment_diagnostic(true, false, true)

def reentrant_safe_satisfies_segment_policy() -> bool:
    ensure result == true
    return not AsyncEntryAnnotationRule::needs_segment_diagnostic(true, false, false)

def non_async_function_requires_segment_policy() -> bool:
    ensure result == true
    return AsyncEntryAnnotationRule::needs_segment_diagnostic(false, false, false)

def compliant_async_entry_still_has_missing_annotations() -> bool:
    ensure result == true
    return AsyncEntryAnnotationRule::needs_segment_diagnostic(true, false, true) or
        AsyncEntryAnnotationRule::needs_reentrant_diagnostic(true, true)
