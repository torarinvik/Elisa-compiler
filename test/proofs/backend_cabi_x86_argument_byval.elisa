# x86-64 SysV passes flattened aggregates larger than two eightbytes by value
# through a pointer; smaller nonempty aggregates use direct register pieces.
def x86_aggregate_argument_uses_byval(is_aggregate: bool, size: i64, flat_ok: bool) -> bool:
    requires size >= 0
    ensure result == (is_aggregate and size > 0 and (not flat_ok or size > 16))
    return is_aggregate and size > 0 and (not flat_ok or size > 16)

def two_eightbyte_aggregate_argument_is_direct(size: i64) -> bool:
    requires size == 16
    ensure not result
    return size > 16

def aggregate_over_two_eightbytes_argument_uses_byval(size: i64) -> bool:
    requires size == 17
    ensure result
    return size > 16

def unflattenable_aggregate_argument_uses_byval(size: i64, flat_ok: bool) -> bool:
    requires size > 0 and not flat_ok
    ensure result
    return not flat_ok or size > 16
