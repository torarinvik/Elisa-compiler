# Exported C globals use the public alias when present and the target as fallback.
include "../../src/backend/c_header_export_alias.elisa"

def explicit_alias_takes_precedence() -> bool:
    ensure result == true
    return CHeaderExportAlias::public_name("internal_seed", "public_seed") == "public_seed"

def empty_alias_preserves_target() -> bool:
    ensure result == true
    return CHeaderExportAlias::public_name("internal_seed", "") == "internal_seed"

def distinct_alias_is_not_replaced_by_target(owner: sview, detail_name: sview) -> bool:
    requires detail_name != ""
    requires detail_name != owner
    ensure result == true
    return CHeaderExportAlias::public_name(owner, detail_name) != owner

def public_name_matches_the_alias_or_fallback_equation(owner: sview, detail_name: sview) -> bool:
    ensure result == true
    return CHeaderExportAlias::public_name(owner, detail_name) == (detail_name if detail_name != "" else owner)

def empty_alias_and_target_remain_empty() -> bool:
    ensure result == true
    return CHeaderExportAlias::public_name("", "") == ""
