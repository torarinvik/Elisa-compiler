include "./function_annotation_name.elisa"

def stage1_only_c_variadic_must_not_be_accepted() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return FunctionAnnotationName::is_function_annotation("c_variadic")

def extern_only_annotation_must_not_be_ordinary() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return FunctionAnnotationName::is_function_annotation("wasm_import_module")

def ordinary_only_annotation_must_not_be_extern() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return FunctionAnnotationName::is_extern_function_annotation("test")
