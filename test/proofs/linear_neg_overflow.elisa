# Checked i64 arithmetic contracts below are the production helpers used by semantic folding.
module Semantic:
    private:
        const LINEAR_CHECKED_ARITHMETIC_PROOF_SCOPE: bool = true

include "./parser_token_kind_projection.elisa"
type TokenKind = Lexer::TokenKind
include "../../src/semantic/linear_checked_arithmetic.elisa"

extend Semantic:
    public:
        def proof_linear_add_safe(left: i64, right: i64) -> (known: bool, value: i64):
            ensure result.known == linear_add_safe(left, right).known
            ensure result.value == linear_add_safe(left, right).value
            return linear_add_safe(left, right)

        def proof_linear_sub_safe(left: i64, right: i64) -> (known: bool, value: i64):
            ensure result.known == linear_sub_safe(left, right).known
            ensure result.value == linear_sub_safe(left, right).value
            return linear_sub_safe(left, right)

        def proof_linear_mul_safe(left: i64, right: i64) -> (known: bool, value: i64):
            ensure result.known == linear_mul_safe(left, right).known
            ensure result.value == linear_mul_safe(left, right).value
            return linear_mul_safe(left, right)

        def proof_linear_neg_safe(operand: i64) -> (known: bool, value: i64):
            ensure result.known == linear_neg_safe(operand).known
            ensure result.value == linear_neg_safe(operand).value
            return linear_neg_safe(operand)

        def proof_linear_arith_safe(left: i64, operator: TokenKind, right: i64) -> (known: bool, value: i64):
            ensure result.known == linear_arith_safe(left, operator, right).known
            ensure result.value == linear_arith_safe(left, operator, right).value
            return linear_arith_safe(left, operator, right)

def negate_nonminimum(operand: i64) -> i64:
    requires operand != (0 - 9223372036854775807 - 1)
    ensure result == (0 - operand)
    checked: (known: bool, value: i64) = Semantic::proof_linear_neg_safe(operand)
    return checked.value

def linear_negation_known_exactly_away_from_minimum(operand: i64) -> bool:
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_neg_safe(operand)
    return checked.known == (operand != (0 - 9223372036854775807 - 1))

def known_addition_returns_exact_sum(left: i64, right: i64) -> bool:
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_add_safe(left, right)
    return not checked.known or checked.value == left + right

def checked_addition_has_a_right_zero_identity(left: i64) -> bool:
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_add_safe(left, 0)
    return checked.known and checked.value == left

def checked_addition_is_commutative(left: i64, right: i64) -> bool:
    ensure result == true
    forward: (known: bool, value: i64) = Semantic::proof_linear_add_safe(left, right)
    reverse: (known: bool, value: i64) = Semantic::proof_linear_add_safe(right, left)
    return forward.known == reverse.known and forward.value == reverse.value

def known_subtraction_returns_exact_difference(left: i64, right: i64) -> bool:
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_sub_safe(left, right)
    return not checked.known or checked.value == left - right

def checked_subtraction_has_a_right_zero_identity(left: i64) -> bool:
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_sub_safe(left, 0)
    return checked.known and checked.value == left

def known_multiplication_returns_exact_product(left: i64, right: i64) -> bool:
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(left, right)
    return not checked.known or checked.value == left * right

def checked_multiplication_has_zero_as_an_annihilator(operand: i64) -> bool:
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(0, operand)
    return checked.known and checked.value == 0

def checked_multiplication_has_left_one_as_an_identity(operand: i64) -> bool:
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(1, operand)
    return checked.known and checked.value == operand

def checked_multiplication_has_right_one_as_an_identity(operand: i64) -> bool:
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(operand, 1)
    return checked.known and checked.value == operand

def checked_multiplication_by_negative_one_matches_negation(operand: i64) -> bool:
    ensure result == true
    product: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(0 - 1, operand)
    negation: (known: bool, value: i64) = Semantic::proof_linear_neg_safe(operand)
    return product.known == negation.known and product.value == negation.value

def checked_multiplication_is_commutative(left: i64, right: i64) -> bool:
    ensure result == true
    forward: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(left, right)
    reverse: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(right, left)
    return forward.known == reverse.known and forward.value == reverse.value

def checked_subtraction_has_an_order_sensitive_result() -> bool:
    ensure result == true
    forward: (known: bool, value: i64) = Semantic::proof_linear_sub_safe(9, 4)
    reverse: (known: bool, value: i64) = Semantic::proof_linear_sub_safe(4, 9)
    return forward.known and reverse.known and forward.value == 5 and reverse.value == (0 - 5)

def known_negation_returns_exact_difference(operand: i64) -> bool:
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_neg_safe(operand)
    return not checked.known or checked.value == 0 - operand

def checked_negation_maps_zero_to_zero() -> bool:
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_neg_safe(0)
    return checked.known and checked.value == 0

def failed_addition_returns_zero(left: i64, right: i64) -> bool:
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_add_safe(left, right)
    return checked.known or checked.value == 0

def failed_subtraction_returns_zero(left: i64, right: i64) -> bool:
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_sub_safe(left, right)
    return checked.known or checked.value == 0

def failed_multiplication_returns_zero(left: i64, right: i64) -> bool:
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(left, right)
    return checked.known or checked.value == 0

def failed_negation_returns_zero(operand: i64) -> bool:
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_neg_safe(operand)
    return checked.known or checked.value == 0

def semantic_addition_guard_is_exact(left: i64, right: i64) -> bool:
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_add_safe(left, right)
    return checked.known == (right == 0 or
        (right > 0 and left <= 9223372036854775807 - right) or
        (right < 0 and left >= (0 - 9223372036854775807 - 1) - right))

def semantic_subtraction_guard_is_exact(left: i64, right: i64) -> bool:
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_sub_safe(left, right)
    return checked.known == (right == 0 or
        (right > 0 and left >= (0 - 9223372036854775807 - 1) + right) or
        (right < 0 and left <= 9223372036854775807 + right))

def semantic_multiplication_guard_is_exact(left: i64, right: i64) -> bool:
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(left, right)
    return checked.known == (
        left == 0 or right == 0 or left == 1 or right == 1
        or (left == -1 and right != (0 - 9223372036854775807 - 1))
        or (right == -1 and left != (0 - 9223372036854775807 - 1))
        or (left > 0 and right > 0 and left <= 9223372036854775807 / right)
        or (left > 0 and right < 0 and right >= (0 - 9223372036854775807 - 1) / left)
        or (left < 0 and right > 0 and left >= (0 - 9223372036854775807 - 1) / right)
        or (left < 0 and right < 0 and left >= 9223372036854775807 / right)
    )

def semantic_add_dispatch_matches_checked_add(left: i64, right: i64) -> bool:
    ensure result == true
    dispatched: (known: bool, value: i64) = Semantic::proof_linear_arith_safe(left, TokenKind.Plus, right)
    checked: (known: bool, value: i64) = Semantic::proof_linear_add_safe(left, right)
    return dispatched.known == checked.known and dispatched.value == checked.value

def semantic_sub_dispatch_matches_checked_sub(left: i64, right: i64) -> bool:
    ensure result == true
    dispatched: (known: bool, value: i64) = Semantic::proof_linear_arith_safe(left, TokenKind.Minus, right)
    checked: (known: bool, value: i64) = Semantic::proof_linear_sub_safe(left, right)
    return dispatched.known == checked.known and dispatched.value == checked.value

def semantic_mul_dispatch_matches_checked_mul(left: i64, right: i64) -> bool:
    ensure result == true
    dispatched: (known: bool, value: i64) = Semantic::proof_linear_arith_safe(left, TokenKind.Star, right)
    checked: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(left, right)
    return dispatched.known == checked.known and dispatched.value == checked.value

def semantic_dispatch_rejects_division(left: i64, right: i64) -> bool:
    ensure result == true
    dispatched: (known: bool, value: i64) = Semantic::proof_linear_arith_safe(left, TokenKind.Slash, right)
    return not dispatched.known and dispatched.value == 0

def semantic_dispatch_rejects_remainder(left: i64, right: i64) -> bool:
    ensure result == true
    dispatched: (known: bool, value: i64) = Semantic::proof_linear_arith_safe(left, TokenKind.Percent, right)
    return not dispatched.known and dispatched.value == 0

def unsupported_arithmetic_operators_fail_closed(left: i64, operator: TokenKind, right: i64) -> bool:
    requires operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Star
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_arith_safe(left, operator, right)
    return not checked.known and checked.value == 0

def signed_arithmetic_overflow_extremes_fail_closed() -> bool:
    ensure result == true
    minimum: i64 = 0 - 9223372036854775807 - 1
    add_upper: (known: bool, value: i64) = Semantic::proof_linear_add_safe(9223372036854775807, 1)
    add_lower: (known: bool, value: i64) = Semantic::proof_linear_add_safe(minimum, 0 - 1)
    sub_upper: (known: bool, value: i64) = Semantic::proof_linear_sub_safe(9223372036854775807, 0 - 1)
    sub_lower: (known: bool, value: i64) = Semantic::proof_linear_sub_safe(minimum, 1)
    mul_positive: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(9223372036854775807, 2)
    mul_positive_negative: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(2, minimum)
    mul_negative_positive: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(minimum, 2)
    mul_negative: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(minimum, 0 - 2)
    mul_minimum_by_negative_one: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(minimum, 0 - 1)
    mul_negative_one_by_minimum: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(0 - 1, minimum)
    neg_minimum: (known: bool, value: i64) = Semantic::proof_linear_neg_safe(minimum)
    divide: (known: bool, value: i64) = Semantic::proof_linear_arith_safe(1, TokenKind.Slash, 1)
    remainder: (known: bool, value: i64) = Semantic::proof_linear_arith_safe(1, TokenKind.Percent, 1)
    return (
        not add_upper.known and add_upper.value == 0
        and not add_lower.known and add_lower.value == 0
        and not sub_upper.known and sub_upper.value == 0
        and not sub_lower.known and sub_lower.value == 0
        and not mul_positive.known and mul_positive.value == 0
        and not mul_positive_negative.known and mul_positive_negative.value == 0
        and not mul_negative_positive.known and mul_negative_positive.value == 0
        and not mul_negative.known and mul_negative.value == 0
        and not mul_minimum_by_negative_one.known and mul_minimum_by_negative_one.value == 0
        and not mul_negative_one_by_minimum.known and mul_negative_one_by_minimum.value == 0
        and not neg_minimum.known and neg_minimum.value == 0
        and not divide.known and divide.value == 0
        and not remainder.known and remainder.value == 0
    )

def signed_arithmetic_safe_boundaries_are_admitted() -> bool:
    ensure result == true
    minimum: i64 = 0 - 9223372036854775807 - 1
    add_upper: (known: bool, value: i64) = Semantic::proof_linear_add_safe(9223372036854775807 - 1, 1)
    add_lower: (known: bool, value: i64) = Semantic::proof_linear_add_safe(minimum + 1, 0 - 1)
    sub_lower: (known: bool, value: i64) = Semantic::proof_linear_sub_safe(minimum + 1, 1)
    sub_upper: (known: bool, value: i64) = Semantic::proof_linear_sub_safe(9223372036854775807 - 1, 0 - 1)
    mul_positive: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(4611686018427387903, 2)
    mul_positive_negative: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(2, 0 - 4611686018427387904)
    mul_negative_positive: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(0 - 4611686018427387904, 2)
    mul_negative: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(0 - 4611686018427387903, 0 - 2)
    mul_minimum_by_one: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(minimum, 1)
    mul_one_by_minimum: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(1, minimum)
    mul_near_minimum_by_negative_one: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(minimum + 1, 0 - 1)
    mul_negative_one_by_near_minimum: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(0 - 1, minimum + 1)
    neg_near_minimum: (known: bool, value: i64) = Semantic::proof_linear_neg_safe(minimum + 1)
    return (
        add_upper.known and add_upper.value == 9223372036854775807
        and add_lower.known and add_lower.value == minimum
        and sub_lower.known and sub_lower.value == minimum
        and sub_upper.known and sub_upper.value == 9223372036854775807
        and mul_positive.known and mul_positive.value == 9223372036854775806
        and mul_positive_negative.known and mul_positive_negative.value == minimum
        and mul_negative_positive.known and mul_negative_positive.value == minimum
        and mul_negative.known and mul_negative.value == 9223372036854775806
        and mul_minimum_by_one.known and mul_minimum_by_one.value == minimum
        and mul_one_by_minimum.known and mul_one_by_minimum.value == minimum
        and mul_near_minimum_by_negative_one.known and mul_near_minimum_by_negative_one.value == 9223372036854775807
        and mul_negative_one_by_near_minimum.known and mul_negative_one_by_near_minimum.value == 9223372036854775807
        and neg_near_minimum.known and neg_near_minimum.value == 9223372036854775807
    )
