include "./backend_runtime_symbols.elisa"

def unrecognized_symbol_must_not_be_runtime_provided() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return BackendRuntimeSymbols::is_runtime_provided("ordinary_user_function")

def trace_counter_must_not_be_a_trace_callback() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return BackendRuntimeSymbols::is_trace_callback("elisa_trace_count")

def unrelated_helper_must_not_be_runtime_external_only() -> bool:
    ensure result == true
    return BackendRuntimeSymbols::is_runtime_external_only("ctx_aos_store_side_slot")
