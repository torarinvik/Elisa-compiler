include "./backend_cabi_target.elisa"

def false_wasm_not_selected_when_x86_enabled(is_wasm: bool, x86_environment_enabled: bool) -> bool:
    requires is_wasm and x86_environment_enabled
    ensure result
    return not is_wasm

def false_x86_not_selected_without_wasm(is_wasm: bool, x86_environment_enabled: bool) -> bool:
    requires not is_wasm and x86_environment_enabled
    ensure result
    return not x86_environment_enabled
