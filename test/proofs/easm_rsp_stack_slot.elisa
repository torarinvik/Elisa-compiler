# EASM stack-relative slots either have a checked offset or fail closed to zero.
def rsp_stack_slot_result(stack_known: bool, memory_operand: bool, rsp_base: bool, no_index: bool, displacement_valid: bool, added_valid: bool, added_offset: i64) -> (valid: bool, offset: i64):
    ensure result.valid or result.offset == 0
    ensure result.valid implies result.offset == added_offset
    if not stack_known or not memory_operand or not rsp_base or not no_index:
        return (false, 0)
    if not displacement_valid:
        return (false, 0)
    if not added_valid:
        return (false, 0)
    return (true, added_offset)
