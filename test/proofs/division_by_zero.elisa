# Exact abstract guard implemented by the semantic constant-division checker.
const DIVISION_ZERO_LITERAL: i64 = 0

def proof_division_by_zero_reported(is_slash: bool, right_is_integer_literal: bool, divisor: i64) -> bool:
    ensure result == (is_slash and right_is_integer_literal and divisor == DIVISION_ZERO_LITERAL)
    return is_slash and right_is_integer_literal and divisor == DIVISION_ZERO_LITERAL

def proof_catch_division_children_reported(scrutinee_reported: bool, arm_guard_reported: bool, arm_body_reported: bool) -> bool:
    ensure result == (scrutinee_reported or arm_guard_reported or arm_body_reported)
    return scrutinee_reported or arm_guard_reported or arm_body_reported

def proof_static_effect_division_children_reported(capture_reported: bool, argument_reported: bool) -> bool:
    ensure result == (capture_reported or argument_reported)
    return capture_reported or argument_reported

def proof_unary_division_child_reported(child_reported: bool) -> bool:
    ensure result == child_reported
    return child_reported

def proof_refinement_division_children_reported(base_reported: bool, predicate_reported: bool) -> bool:
    ensure result == (base_reported or predicate_reported)
    return base_reported or predicate_reported

def proof_get_else_division_children_reported(guarded_reported: bool, recovery_reported: bool) -> bool:
    ensure result == (guarded_reported or recovery_reported)
    return guarded_reported or recovery_reported

def integer_zero_divisor_is_reported() -> bool:
    ensure result == true
    return true and true and 0 == 0

def catch_scrutinee_zero_divisor_is_reported() -> bool:
    ensure result == true
    return (true and true and 0 == 0) or false or false

def catch_arm_guard_zero_divisor_is_reported() -> bool:
    ensure result == true
    return false or (true and true and 0 == 0) or false

def catch_arm_body_zero_divisor_is_reported() -> bool:
    ensure result == true
    return false or false or (true and true and 0 == 0)

def static_effect_capture_zero_divisor_is_reported() -> bool:
    ensure result == true
    return (true and true and 0 == 0) or false

def static_effect_argument_zero_divisor_is_reported() -> bool:
    ensure result == true
    return false or (true and true and 0 == 0)

def move_operand_zero_divisor_is_reported() -> bool:
    ensure result == true
    return true and true and 0 == 0

def region_new_operand_zero_divisor_is_reported() -> bool:
    ensure result == true
    return true and true and 0 == 0

def refinement_base_zero_divisor_is_reported() -> bool:
    ensure result == true
    return (true and true and 0 == 0) or false

def refinement_predicate_zero_divisor_is_reported() -> bool:
    ensure result == true
    return false or (true and true and 0 == 0)

def get_else_guarded_zero_divisor_is_reported() -> bool:
    ensure result == true
    return (true and true and 0 == 0) or false

def get_else_recovery_zero_divisor_is_reported() -> bool:
    ensure result == true
    return false or (true and true and 0 == 0)

def proof_match_children_reported(expression_scrutinee: bool,
    expression_guard: bool,
    expression_body: bool,
    statement_scrutinee: bool,
    statement_guard: bool,
    statement_body: bool) -> bool:
    ensure result == (expression_scrutinee or expression_guard or expression_body or
        statement_scrutinee or statement_guard or statement_body)
    return (expression_scrutinee or expression_guard or expression_body or
        statement_scrutinee or statement_guard or statement_body)

def proof_statement_children_reported(expression: bool,
    variable_type: bool,
    variable_value: bool,
    assignment_target: bool,
    assignment_value: bool,
    if_condition: bool,
    if_then_body: bool,
    if_else_body: bool,
    while_condition: bool,
    while_body: bool,
    for_iterable: bool,
    for_body: bool,
    return_value: bool,
    block_body: bool,
    match_scrutinee: bool,
    match_guard: bool,
    match_body: bool,
    contract_expression: bool) -> bool:
    ensure result == (expression or variable_type or variable_value or assignment_target or assignment_value or
        if_condition or if_then_body or if_else_body or while_condition or while_body or for_iterable or for_body or
        return_value or block_body or match_scrutinee or match_guard or match_body or contract_expression)
    return (expression or variable_type or variable_value or assignment_target or assignment_value or
        if_condition or if_then_body or if_else_body or while_condition or while_body or for_iterable or for_body or
        return_value or block_body or match_scrutinee or match_guard or match_body or contract_expression)

def proof_declaration_children_reported(parameter_type: bool,
    parameter_default: bool,
    return_type: bool,
    function_body: bool,
    member_type: bool,
    member_default: bool,
    bit_member_type: bool,
    invariant: bool,
    enum_storage_type: bool,
    enum_payload_type: bool,
    enum_variant_value: bool,
    alias_target: bool,
    law_predicate: bool,
    const_type: bool,
    const_value: bool,
    module_body: bool,
    scoped_body: bool) -> bool:
    ensure result == (parameter_type or parameter_default or return_type or function_body or member_type or
        member_default or bit_member_type or invariant or enum_storage_type or enum_payload_type or enum_variant_value or
        alias_target or law_predicate or const_type or const_value or module_body or scoped_body)
    return (parameter_type or parameter_default or return_type or function_body or member_type or
        member_default or bit_member_type or invariant or enum_storage_type or enum_payload_type or enum_variant_value or
        alias_target or law_predicate or const_type or const_value or module_body or scoped_body)

def nonzero_integer_divisor_is_not_reported(divisor: i64) -> bool:
    requires divisor != 0
    ensure result == true
    return not (true and true and divisor == 0)

def zero_under_another_operator_is_not_reported() -> bool:
    ensure result == true
    return not (false and true and 0 == 0)

def zero_noninteger_literal_is_not_reported() -> bool:
    ensure result == true
    return not (true and false and 0 == 0)
