# Arithmetic contract for the fixed-array literal arity diagnostic.
const ARRAY_SIZE_UNKNOWN: i64 = 0 - 1
const MIN_FIXED_ARRAY_EXTENT: i64 = 1
const EMPTY_ARRAY_LITERAL_COUNT: i64 = 0
const TWO_ELEMENT_EXTENT: i64 = 2
const EMPTY_ARRAY_ELEMENT_COUNT: usize = 0
const ONE_ELEMENT_ARRAY_COUNT: usize = 1
const ARRAY_LAST_INDEX_OFFSET: usize = 1

def proof_single_index_type_is_sequence(base_is_container: bool, index_is_integer_literal: bool) -> bool:
    ensure result == (base_is_container or index_is_integer_literal)
    return base_is_container or index_is_integer_literal

def proof_multi_index_type_is_sequence(base_is_container: bool) -> bool:
    ensure result == base_is_container
    return base_is_container

def proof_array_literal_arity_mismatch(expected_size: i64, actual_size: i64) -> bool:
    ensure result == (expected_size >= MIN_FIXED_ARRAY_EXTENT and actual_size != expected_size)
    return expected_size >= MIN_FIXED_ARRAY_EXTENT and actual_size != expected_size

def equal_positive_arity_is_accepted(expected_size: i64, actual_size: i64) -> bool:
    requires expected_size >= MIN_FIXED_ARRAY_EXTENT and actual_size == expected_size
    ensure result == true
    return not proof_array_literal_arity_mismatch(expected_size, actual_size)

def shorter_literal_is_rejected(expected_size: i64, actual_size: i64) -> bool:
    requires expected_size >= MIN_FIXED_ARRAY_EXTENT and actual_size >= EMPTY_ARRAY_LITERAL_COUNT and actual_size < expected_size
    ensure result == true
    return proof_array_literal_arity_mismatch(expected_size, actual_size)

def longer_literal_is_rejected(expected_size: i64, actual_size: i64) -> bool:
    requires expected_size >= MIN_FIXED_ARRAY_EXTENT and actual_size > expected_size
    ensure result == true
    return proof_array_literal_arity_mismatch(expected_size, actual_size)

def empty_literal_is_rejected_for_positive_extent(expected_size: i64) -> bool:
    requires expected_size >= MIN_FIXED_ARRAY_EXTENT
    ensure result == true
    return proof_array_literal_arity_mismatch(expected_size, EMPTY_ARRAY_LITERAL_COUNT)

def zero_extent_is_not_an_arity_diagnostic(actual_size: i64) -> bool:
    requires actual_size >= EMPTY_ARRAY_LITERAL_COUNT
    ensure result == true
    return not proof_array_literal_arity_mismatch(EMPTY_ARRAY_LITERAL_COUNT, actual_size)

def negative_unmodeled_extent_is_not_an_arity_diagnostic(actual_size: i64) -> bool:
    requires actual_size >= EMPTY_ARRAY_LITERAL_COUNT
    ensure result == true
    return not proof_array_literal_arity_mismatch(ARRAY_SIZE_UNKNOWN, actual_size)

def one_element_literal_matches_one_element_extent() -> bool:
    ensure result == true
    return not proof_array_literal_arity_mismatch(MIN_FIXED_ARRAY_EXTENT, MIN_FIXED_ARRAY_EXTENT)

def one_element_literal_mismatches_two_element_extent() -> bool:
    ensure result == true
    return proof_array_literal_arity_mismatch(TWO_ELEMENT_EXTENT, MIN_FIXED_ARRAY_EXTENT)

def fixed_extent_type_is_a_sequence() -> bool:
    ensure result == true
    return proof_single_index_type_is_sequence(false, true)

def container_type_is_a_sequence() -> bool:
    ensure result == true
    return proof_single_index_type_is_sequence(true, false)

def scalar_indexed_type_is_not_a_sequence() -> bool:
    ensure result == false
    return proof_single_index_type_is_sequence(false, false)

def multi_index_container_type_is_a_sequence() -> bool:
    ensure result == true
    return proof_multi_index_type_is_sequence(true)

def multi_index_scalar_type_is_not_a_sequence() -> bool:
    ensure result == false
    return proof_multi_index_type_is_sequence(false)

def proof_empty_assignment_needs_context(
    is_assignment: bool,
    is_empty: bool,
    has_later_growth: bool,
    is_returned: bool,
    return_type_is_sequence: bool
) -> bool:
    ensure result == (is_assignment and is_empty and not (has_later_growth or (is_returned and return_type_is_sequence)))
    return is_assignment and is_empty and not (has_later_growth or (is_returned and return_type_is_sequence))

def empty_assignment_without_context_is_reported() -> bool:
    ensure result == true
    return proof_empty_assignment_needs_context(true, true, false, false, false)

def later_push_or_extend_supplies_context() -> bool:
    ensure result == true
    return not proof_empty_assignment_needs_context(true, true, true, false, false)

def returning_empty_binding_with_sequence_type_supplies_context() -> bool:
    ensure result == true
    return not proof_empty_assignment_needs_context(true, true, false, true, true)

def returning_empty_binding_with_nonsequence_type_needs_context() -> bool:
    ensure result == true
    return proof_empty_assignment_needs_context(true, true, false, true, false)

def a_nonassignment_empty_literal_does_not_trigger_this_rule() -> bool:
    ensure result == true
    return not proof_empty_assignment_needs_context(false, true, false, false, false)

def a_nonempty_assignment_does_not_trigger_this_rule() -> bool:
    ensure result == true
    return not proof_empty_assignment_needs_context(true, false, false, false, false)

def parenthesized_empty_array_value(parentheses_remaining: usize, element_count: usize) -> bool:
    decreases parentheses_remaining
    ensure result == (element_count == EMPTY_ARRAY_ELEMENT_COUNT)
    if parentheses_remaining == EMPTY_ARRAY_ELEMENT_COUNT:
        return element_count == EMPTY_ARRAY_ELEMENT_COUNT
    else:
        assert(parentheses_remaining > EMPTY_ARRAY_ELEMENT_COUNT)
        return parenthesized_empty_array_value(parentheses_remaining - ARRAY_LAST_INDEX_OFFSET, element_count)

def proof_match_arm_requires_empty_context(
    body_is_nonempty: bool,
    final_statement_is_expression: bool,
    final_expression_is_empty: bool,
    return_type_is_sequence: bool
) -> bool:
    ensure result == (body_is_nonempty and final_statement_is_expression and final_expression_is_empty)
    return body_is_nonempty and final_statement_is_expression and final_expression_is_empty

def arbitrary_parentheses_preserve_array_emptiness(parentheses_remaining: usize, element_count: usize) -> bool:
    ensure result == true
    parsed: bool = parenthesized_empty_array_value(parentheses_remaining, element_count)
    return parsed == (element_count == EMPTY_ARRAY_ELEMENT_COUNT)

def several_parentheses_preserve_an_empty_array() -> bool:
    ensure result == true
    return parenthesized_empty_array_value(5, EMPTY_ARRAY_ELEMENT_COUNT)

def several_parentheses_preserve_a_nonempty_array() -> bool:
    ensure result == false
    return parenthesized_empty_array_value(5, ONE_ELEMENT_ARRAY_COUNT)

def empty_final_match_expression_is_reported_for_any_return_context(return_type_is_sequence: bool) -> bool:
    ensure result == true
    return proof_match_arm_requires_empty_context(true, true, true, return_type_is_sequence)

def nonempty_final_match_expression_is_not_reported(return_type_is_sequence: bool) -> bool:
    ensure result == false
    return proof_match_arm_requires_empty_context(true, true, false, return_type_is_sequence)

def nonexpression_match_arm_tail_is_not_reported(return_type_is_sequence: bool) -> bool:
    ensure result == false
    return proof_match_arm_requires_empty_context(true, false, true, return_type_is_sequence)

def empty_match_arm_body_is_not_reported(return_type_is_sequence: bool) -> bool:
    ensure result == false
    return proof_match_arm_requires_empty_context(false, true, true, return_type_is_sequence)
