# Prove the production EASM explicit-memory-destination opcode policy.
include "../../src/backend/easm_memory_effect_policy.elisa"

def read_modify_write_opcodes_consume_and_update_the_old_memory_value(op: sview) -> bool can[Abort.Panic]:
    requires (
        op == "add" or op == "addq" or op == "sub" or op == "subq" or
        op == "and" or op == "andq" or op == "or" or op == "orq" or
        op == "xor" or op == "xorq" or op == "inc" or op == "incq" or
        op == "dec" or op == "decq" or op == "neg" or op == "negq" or
        op == "not" or op == "notq" or op == "shl" or op == "shlq" or
        op == "sal" or op == "salq" or op == "shr" or op == "shrq" or
        op == "sar" or op == "sarq" or op == "xchg" or op == "xchgl" or op == "xchgq"
    )
    ensure result == true
    can Abort.Panic:
        return EasmMemoryEffectPolicy::destination_reads_memory(op) and EasmMemoryEffectPolicy::destination_writes_memory(op)

def compare_and_test_destinations_are_read_only(op: sview) -> bool can[Abort.Panic]:
    requires op == "cmp" or op == "cmpq" or op == "test" or op == "testq"
    ensure result == true
    can Abort.Panic:
        return EasmMemoryEffectPolicy::destination_reads_memory(op) and not EasmMemoryEffectPolicy::destination_writes_memory(op)

def indirect_control_destinations_are_read_only(op: sview) -> bool can[Abort.Panic]:
    requires op == "call" or op == "callq" or op == "jmp" or op == "jmpq"
    ensure result == true
    can Abort.Panic:
        return EasmMemoryEffectPolicy::destination_reads_memory(op) and not EasmMemoryEffectPolicy::destination_writes_memory(op)

def ordinary_store_destinations_do_not_read_the_old_value() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not EasmMemoryEffectPolicy::destination_reads_memory("movq") and EasmMemoryEffectPolicy::destination_writes_memory("movq")

def status_save_destinations_write_without_reading() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            not EasmMemoryEffectPolicy::destination_reads_memory("fnstcw") and
            EasmMemoryEffectPolicy::destination_writes_memory("fnstcw") and
            not EasmMemoryEffectPolicy::destination_reads_memory("stmxcsr") and
            EasmMemoryEffectPolicy::destination_writes_memory("stmxcsr")
        )

def status_save_memory_effects_ignore_sources_and_follow_destination_shape(op: sview, source_memory: bool, destination_memory: bool) -> bool can[Abort.Panic]:
    requires op == "fnstcw" or op == "stmxcsr"
    ensure result == true
    can Abort.Panic:
        return (
            not EasmMemoryEffectPolicy::memory_reads(op, false, source_memory, destination_memory) and
            EasmMemoryEffectPolicy::memory_writes(op, false, destination_memory) == destination_memory
        )

def control_state_loads_read_sources_without_writing_destinations(op: sview, source_memory: bool, destination_memory: bool) -> bool can[Abort.Panic]:
    requires op == "fldcw" or op == "ldmxcsr"
    ensure result == true
    can Abort.Panic:
        return (
            EasmMemoryEffectPolicy::memory_reads(op, false, source_memory, destination_memory) == source_memory and
            not EasmMemoryEffectPolicy::memory_writes(op, false, destination_memory)
        )

def control_state_loads_do_not_write_a_memory_destination() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            not EasmMemoryEffectPolicy::destination_reads_memory("fldcw") and
            not EasmMemoryEffectPolicy::destination_writes_memory("fldcw") and
            not EasmMemoryEffectPolicy::destination_reads_memory("ldmxcsr") and
            not EasmMemoryEffectPolicy::destination_writes_memory("ldmxcsr")
        )

def pseudo_and_address_calculation_instructions_have_no_explicit_memory_effect(op: sview, pseudo: bool, source_memory: bool, destination_memory: bool) -> bool can[Abort.Panic]:
    requires pseudo or op == "lea" or op == "leaq"
    ensure result == true
    can Abort.Panic:
        return (
            not EasmMemoryEffectPolicy::memory_reads(op, pseudo, source_memory, destination_memory) and
            not EasmMemoryEffectPolicy::memory_writes(op, pseudo, destination_memory)
        )

def source_memory_is_read_outside_the_explicit_suppression_cases(op: sview, source_memory: bool) -> bool can[Abort.Panic]:
    requires op != "lea" and op != "leaq" and op != "fnstcw" and op != "stmxcsr" and op != "pop" and op != "popq"
    ensure result == true
    can Abort.Panic:
        return EasmMemoryEffectPolicy::memory_reads(op, false, source_memory, false) == source_memory

def pop_memory_destination_is_written_without_counting_its_implicit_stack_read(op: sview) -> bool can[Abort.Panic]:
    requires op == "pop" or op == "popq"
    ensure result == true
    can Abort.Panic:
        return (
            not EasmMemoryEffectPolicy::memory_reads(op, false, true, true) and
            EasmMemoryEffectPolicy::memory_writes(op, false, true)
        )

def destination_read_matches_the_opcode_effect(op: sview) -> bool can[Abort.Panic]:
    requires op != "lea" and op != "leaq" and op != "fnstcw" and op != "stmxcsr"
    ensure result == true
    can Abort.Panic:
        return EasmMemoryEffectPolicy::memory_reads(op, false, false, true) == EasmMemoryEffectPolicy::destination_reads_memory(op)

def no_explicit_memory_destination_cannot_be_written(op: sview, pseudo: bool) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not EasmMemoryEffectPolicy::memory_writes(op, pseudo, false)

def explicit_memory_destination_uses_the_opcode_write_policy(op: sview) -> bool can[Abort.Panic]:
    requires op != "lea" and op != "leaq"
    ensure result == true
    can Abort.Panic:
        return EasmMemoryEffectPolicy::memory_writes(op, false, true) == EasmMemoryEffectPolicy::destination_writes_memory(op)
