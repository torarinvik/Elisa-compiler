include "./region_escape_forwarded_ref_guards.elisa"

def reference_to_non_global_value_takes_global_escape_guard() -> bool:
    ensure result == true
    return forwarded_reference_escape_guard_is_exact(false, false, false, true, false)

def container_call_into_non_ref_field_takes_caller_field_guard() -> bool:
    ensure result == true
    return forwarded_reference_escape_guard_is_exact(false, true, false, false, true)
