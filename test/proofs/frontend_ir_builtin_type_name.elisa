# Source-linked proof of the closed builtin-type set used by the frontend IR writer.
include "../../src/driver/frontend_ir_builtin_type_name.elisa"

def source_classifier_has_exact_builtin_set(name: sview) -> bool can[Abort.Panic]:
    ensure result == (
        when name:
            "darray" | "view" | "sview" | "dict" | "set" | "deque" | "array" | "slice" | "optional" -> true
            _ -> false
    )
    can Abort.Panic:
        return FrontendIrBuiltinTypeName::is_builtin_type_name(name)

def every_builtin_type_head_is_recognized() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            FrontendIrBuiltinTypeName::is_builtin_type_name("darray")
            and FrontendIrBuiltinTypeName::is_builtin_type_name("view")
            and FrontendIrBuiltinTypeName::is_builtin_type_name("sview")
            and FrontendIrBuiltinTypeName::is_builtin_type_name("dict")
            and FrontendIrBuiltinTypeName::is_builtin_type_name("set")
            and FrontendIrBuiltinTypeName::is_builtin_type_name("deque")
            and FrontendIrBuiltinTypeName::is_builtin_type_name("array")
            and FrontendIrBuiltinTypeName::is_builtin_type_name("slice")
            and FrontendIrBuiltinTypeName::is_builtin_type_name("optional")
        )

def nearby_named_types_remain_generic() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            not FrontendIrBuiltinTypeName::is_builtin_type_name("i64")
            and not FrontendIrBuiltinTypeName::is_builtin_type_name("String")
            and not FrontendIrBuiltinTypeName::is_builtin_type_name("HashMap")
        )
