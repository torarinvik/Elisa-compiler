include "./pymodule_type_classification.elisa"

def nearby_type_must_not_be_scalar() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return PymoduleTypeClassification::is_scalar_field_type("String")

def integer_type_must_not_map_to_float() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return PymoduleTypeClassification::known_python_expected_type("i8") == "float"

def unknown_type_must_not_get_sequence_label() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return PymoduleTypeClassification::known_python_expected_type("Widget") == "sequence"
