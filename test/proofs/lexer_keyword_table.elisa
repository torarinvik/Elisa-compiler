# Exhaustive proof calls for the production lexer keyword table. The admission
# checker requires a matching proof case for every branch and fallback spelling.
include "./parser_token_kind_projection.elisa"
include "../../src/lexer/lexer_identifiers.elisa"

def length_two_keywords_keep_their_token_kinds() -> bool:
    ensure result == true
    return (
        Lexer::frontend_lookup_keyword("as") == Lexer::TokenKind.As
        and Lexer::frontend_lookup_keyword("if") == Lexer::TokenKind.If
        and Lexer::frontend_lookup_keyword("in") == Lexer::TokenKind.In
        and Lexer::frontend_lookup_keyword("or") == Lexer::TokenKind.Or
        and Lexer::frontend_lookup_keyword("is") == Lexer::TokenKind.Is
        and Lexer::frontend_lookup_keyword("to") == Lexer::TokenKind.To
    )

def length_three_keywords_keep_their_token_kinds() -> bool:
    ensure result == true
    return (
        Lexer::frontend_lookup_keyword("and") == Lexer::TokenKind.And
        and Lexer::frontend_lookup_keyword("def") == Lexer::TokenKind.Def
        and Lexer::frontend_lookup_keyword("not") == Lexer::TokenKind.Not
        and Lexer::frontend_lookup_keyword("try") == Lexer::TokenKind.Try
    )

def length_four_keywords_keep_their_token_kinds() -> bool:
    ensure result == true
    return (
        Lexer::frontend_lookup_keyword("elif") == Lexer::TokenKind.Elif
        and Lexer::frontend_lookup_keyword("else") == Lexer::TokenKind.Else
        and Lexer::frontend_lookup_keyword("enum") == Lexer::TokenKind.Enum
        and Lexer::frontend_lookup_keyword("heap") == Lexer::TokenKind.Heap
        and Lexer::frontend_lookup_keyword("null") == Lexer::TokenKind.Null
        and Lexer::frontend_lookup_keyword("pass") == Lexer::TokenKind.Pass
        and Lexer::frontend_lookup_keyword("repr") == Lexer::TokenKind.Repr
        and Lexer::frontend_lookup_keyword("tail") == Lexer::TokenKind.Tail
        and Lexer::frontend_lookup_keyword("true") == Lexer::TokenKind.True
        and Lexer::frontend_lookup_keyword("with") == Lexer::TokenKind.With
        and Lexer::frontend_lookup_keyword("lmut") == Lexer::TokenKind.Lmut
    )

def length_five_keywords_keep_their_token_kinds() -> bool:
    ensure result == true
    return (
        Lexer::frontend_lookup_keyword("break") == Lexer::TokenKind.Break
        and Lexer::frontend_lookup_keyword("catch") == Lexer::TokenKind.Catch
        and Lexer::frontend_lookup_keyword("const") == Lexer::TokenKind.Const
        and Lexer::frontend_lookup_keyword("error") == Lexer::TokenKind.Error
        and Lexer::frontend_lookup_keyword("false") == Lexer::TokenKind.False
        and Lexer::frontend_lookup_keyword("match") == Lexer::TokenKind.Match
        and Lexer::frontend_lookup_keyword("panic") == Lexer::TokenKind.Panic
        and Lexer::frontend_lookup_keyword("raise") == Lexer::TokenKind.Raise
        and Lexer::frontend_lookup_keyword("stack") == Lexer::TokenKind.Stack
        and Lexer::frontend_lookup_keyword("while") == Lexer::TokenKind.While
    )

def length_six_keywords_keep_their_token_kinds() -> bool:
    ensure result == true
    return (
        Lexer::frontend_lookup_keyword("export") == Lexer::TokenKind.Export
        and Lexer::frontend_lookup_keyword("extern") == Lexer::TokenKind.Extern
        and Lexer::frontend_lookup_keyword("global") == Lexer::TokenKind.Global
        and Lexer::frontend_lookup_keyword("packed") == Lexer::TokenKind.Packed
        and Lexer::frontend_lookup_keyword("return") == Lexer::TokenKind.Return
        and Lexer::frontend_lookup_keyword("sizeof") == Lexer::TokenKind.Sizeof
        and Lexer::frontend_lookup_keyword("static") == Lexer::TokenKind.Static
        and Lexer::frontend_lookup_keyword("struct") == Lexer::TokenKind.Struct
        and Lexer::frontend_lookup_keyword("zeroed") == Lexer::TokenKind.Zeroed
    )

def length_seven_keywords_keep_their_token_kinds() -> bool:
    ensure result == true
    return (
        Lexer::frontend_lookup_keyword("size_of") == Lexer::TokenKind.Sizeof
        and Lexer::frontend_lookup_keyword("alignof") == Lexer::TokenKind.Alignof
        and Lexer::frontend_lookup_keyword("mutable") == Lexer::TokenKind.Mutable
    )

def length_eight_keywords_keep_their_token_kinds() -> bool:
    ensure result == true
    return (
        Lexer::frontend_lookup_keyword("align_of") == Lexer::TokenKind.Alignof
        and Lexer::frontend_lookup_keyword("continue") == Lexer::TokenKind.Continue
        and Lexer::frontend_lookup_keyword("offsetof") == Lexer::TokenKind.Offsetof
    )

def length_nine_keyword_keeps_its_token_kind() -> bool:
    ensure result == true
    return Lexer::frontend_lookup_keyword("offset_of") == Lexer::TokenKind.Offsetof

def keyword_near_misses_remain_identifiers() -> bool:
    ensure result == true
    return (
        Lexer::frontend_lookup_keyword("iff") == Lexer::TokenKind.Ident
        and Lexer::frontend_lookup_keyword("defn") == Lexer::TokenKind.Ident
        and Lexer::frontend_lookup_keyword("mutabl") == Lexer::TokenKind.Ident
        and Lexer::frontend_lookup_keyword("align_ofx") == Lexer::TokenKind.Ident
        and Lexer::frontend_lookup_keyword("offset_ofx") == Lexer::TokenKind.Ident
        and Lexer::frontend_lookup_keyword("aligned") == Lexer::TokenKind.Ident
        and Lexer::frontend_lookup_keyword("DEF") == Lexer::TokenKind.Ident
        and Lexer::frontend_lookup_keyword("As") == Lexer::TokenKind.Ident
    )

def lengths_outside_the_keyword_table_remain_identifiers() -> bool:
    ensure result == true
    return (
        Lexer::frontend_lookup_keyword("x") == Lexer::TokenKind.Ident
        and Lexer::frontend_lookup_keyword("abcdefghij") == Lexer::TokenKind.Ident
    )
