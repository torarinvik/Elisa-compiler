# Source-linked law for storing between caller-owned region parameters.
# Distinct parameters have unrelated lifetimes, so neither is assumed to outlive the other.

def distinct_region_parameter_store_guard_is_exact(value_is_region_parameter: bool,
    target_is_region_parameter: bool,
    region_names_differ: bool) -> bool:
    ensure result == (value_is_region_parameter and target_is_region_parameter and region_names_differ)
    return value_is_region_parameter and target_is_region_parameter and region_names_differ

def storing_between_distinct_region_parameters_is_an_escape() -> bool:
    ensure result == true
    return distinct_region_parameter_store_guard_is_exact(true, true, true)

def storing_within_the_same_region_parameter_skips_this_guard() -> bool:
    ensure result == false
    return distinct_region_parameter_store_guard_is_exact(true, true, false)

def local_region_value_skips_the_parameter_mismatch_guard() -> bool:
    ensure result == false
    return distinct_region_parameter_store_guard_is_exact(false, true, true)

def local_region_target_skips_the_parameter_mismatch_guard() -> bool:
    ensure result == false
    return distinct_region_parameter_store_guard_is_exact(true, false, true)
