# False arity claims for the production EASM instruction classifier.
include "../../src/backend/easm_text_scan.elisa"
include "../../src/backend/easm_operand_scan.elisa"

def ret_accepts_one_operand() -> bool:
    ensure result == true
    return EasmOperandScan::operand_arity_supported("ret", 1.usize())

def call_accepts_zero_operands() -> bool:
    ensure result == true
    return EasmOperandScan::operand_arity_supported("callq", 0.usize())

def movq_accepts_one_operand() -> bool:
    ensure result == true
    return EasmOperandScan::operand_arity_supported("movq", 1.usize())

def incq_accepts_two_operands() -> bool:
    ensure result == true
    return EasmOperandScan::operand_arity_supported("incq", 2.usize())

def shift_accepts_three_operands() -> bool:
    ensure result == true
    return EasmOperandScan::operand_arity_supported("shlq", 3.usize())

def unknown_opcode_accepts_two_operands() -> bool:
    ensure result == true
    return EasmOperandScan::operand_arity_supported("movgarbage", 2.usize())
