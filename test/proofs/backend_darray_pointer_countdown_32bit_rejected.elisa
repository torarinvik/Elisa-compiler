include "./backend_darray_pointer_countdown_32bit.elisa"

def false_one_past_cursor_is_inside_snapshot(count: i64, cursor: i64) -> bool:
    requires count == U32_MAX
    requires cursor == count
    ensure result == true
    return cursor < count

def false_zero_count_has_a_positive_next_count() -> bool:
    ensure result == true
    return 0 - 1 > 0
