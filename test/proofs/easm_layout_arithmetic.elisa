# Prove the exact scalar rules used by Easm.layout_size for guest-overlay bounds.
include "../../src/backend/easm_memstate_domain.elisa"
include "../../src/backend/easm_layout_arithmetic.elisa"

def positive_explicit_size_precedes_stride(size: i64, stride: i64) -> bool:
    requires size > 0
    ensure result == true
    return EasmLayoutArithmetic::declared_size(size, stride) == size

def positive_stride_is_used_when_size_is_not_positive(size: i64, stride: i64) -> bool:
    requires size <= 0 and stride > 0
    ensure result == true
    return EasmLayoutArithmetic::declared_size(size, stride) == stride

def nonpositive_size_and_stride_have_no_declared_extent(size: i64, stride: i64) -> bool:
    requires size <= 0 and stride <= 0
    ensure result == true
    return EasmLayoutArithmetic::declared_size(size, stride) == 0

def max_extent_keeps_a_bound_at_least_as_large_as_each_input(current: i64, candidate: i64) -> bool:
    ensure result == true
    next: i64 = EasmLayoutArithmetic::keep_larger(current, candidate)
    return next >= current and next >= candidate

def max_extent_is_one_of_the_two_inputs(current: i64, candidate: i64) -> bool:
    ensure result == true
    next: i64 = EasmLayoutArithmetic::keep_larger(current, candidate)
    return next == current or next == candidate

def layout_max_uses_the_proved_greatest_bound(current: i64, candidate: i64) -> bool:
    ensure result == true
    return EasmLayoutArithmetic::keep_larger(current, candidate) == EasmMemStateDomain::greatest_bound(current, candidate)

def valid_field_extent_is_nonnegative(offset: i64, width: i64) -> bool:
    ensure result == true
    extent: (valid: bool, value: i64) = EasmLayoutArithmetic::field_extent_checked(offset, width)
    return not extent.valid or (extent.value >= 0 and offset >= 0 and width >= 0 and extent.value >= offset)

def ordinary_field_extent_is_exact() -> bool:
    ensure result == true
    extent: (valid: bool, value: i64) = EasmLayoutArithmetic::field_extent_checked(12, 8)
    return extent.valid and extent.value == 20

def exact_i64_max_field_extent_is_valid() -> bool:
    ensure result == true
    extent: (valid: bool, value: i64) = EasmLayoutArithmetic::field_extent_checked(EasmLayoutArithmetic::I64_MAX - 8, 8)
    return extent.valid and extent.value == EasmLayoutArithmetic::I64_MAX

def nonnegative_field_extent_matches_i64_representability(offset: i64, width: i64) -> bool:
    requires offset >= 0 and width >= 0
    ensure result == true
    extent: (valid: bool, value: i64) = EasmLayoutArithmetic::field_extent_checked(offset, width)
    return extent.valid == (width <= EasmLayoutArithmetic::I64_MAX - offset) and (
        (extent.valid and extent.value == offset + width)
        or (not extent.valid and extent.value == 0)
    )

def negative_field_extent_inputs_are_rejected(offset: i64, width: i64) -> bool:
    requires offset < 0 or width < 0
    ensure result == true
    extent: (valid: bool, value: i64) = EasmLayoutArithmetic::field_extent_checked(offset, width)
    return not extent.valid and extent.value == 0

def i64_max_offset_plus_u64_width_is_rejected() -> bool:
    ensure result == true
    extent: (valid: bool, value: i64) = EasmLayoutArithmetic::field_extent_checked(EasmLayoutArithmetic::I64_MAX, 8)
    return not extent.valid and extent.value == 0

def i64_max_minus_three_offset_plus_u64_width_is_rejected() -> bool:
    ensure result == true
    extent: (valid: bool, value: i64) = EasmLayoutArithmetic::field_extent_checked(EasmLayoutArithmetic::I64_MAX - 3, 8)
    return not extent.valid and extent.value == 0

def successful_field_accumulation_dominates_both_inputs(current: i64, offset: i64, width: i64) -> bool:
    ensure result == true
    step: (valid: bool, value: i64) = EasmLayoutArithmetic::include_field_extent(current, offset, width)
    extent: (valid: bool, value: i64) = EasmLayoutArithmetic::field_extent_checked(offset, width)
    return not step.valid or (step.value >= current and step.value >= extent.value)

def successful_field_accumulation_is_the_least_common_upper_bound(current: i64, offset: i64, width: i64, upper: i64) -> bool:
    requires offset >= 0 and width >= 0 and width <= EasmLayoutArithmetic::I64_MAX - offset
    requires current <= upper and offset + width <= upper
    ensure result == true
    step: (valid: bool, value: i64) = EasmLayoutArithmetic::include_field_extent(current, offset, width)
    extent: (valid: bool, value: i64) = EasmLayoutArithmetic::field_extent_checked(offset, width)
    return (
        extent.valid and extent.value == offset + width and step.valid and
        step.value == EasmLayoutArithmetic::keep_larger(current, extent.value) and
        step.value <= upper and
        EasmMemStateDomain::greatest_bound_obeys_least_upper_bound_law(current, extent.value, upper)
    )

def maximum_offset_overflow_is_rejected_by_accumulation() -> bool:
    ensure result == true
    step: (valid: bool, value: i64) = EasmLayoutArithmetic::include_field_extent(0, EasmLayoutArithmetic::I64_MAX, 1)
    return not step.valid and step.value == 0
