# The next power-of-two threshold after the 513th insertion.
def name_set_capacity_two_thousand_forty_eight_covers_next_five_hundred_twelve_insertions(name_count: usize) -> bool:
    requires name_count >= 512 and name_count <= 1023
    ensure result == true
    return 2048 >= (name_count + 1) * 2

def name_set_one_thousand_twenty_fifth_entry_doubles_capacity(name_count: usize) -> usize:
    requires name_count == 1024
    ensure result == 4096
    return 4096 if 2048 < (name_count + 1) * 2 else 2048

def one_thousand_twenty_fifth_name_rehash_keeps_three_thousand_seventy_one_slots_empty(name_count: usize) -> usize:
    requires name_count == 1024
    ensure result == 3071
    return (4096 if 2048 < (name_count + 1) * 2 else 2048) - (name_count + 1)
