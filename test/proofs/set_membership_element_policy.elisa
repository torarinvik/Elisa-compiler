# Source-bound proofs for the runtime set element rejection and diagnostic spelling rules.
include "../../src/semantic/set_membership_element_policy.elisa"

def unsupported_element_classifier_is_exact(spelling: sview) -> bool:
    ensure result == true
    return SemanticSetMembershipElementPolicy::is_unsupported_spelling(spelling) == (
        spelling == "sview" or spelling == "dstr" or spelling == "f32" or spelling == "f64"
    )

def diagnostic_spelling_is_exact_for_every_input(spelling: sview) -> bool:
    ensure result == true
    return SemanticSetMembershipElementPolicy::diagnostic_spelling(spelling) == (
        "darray[u8]" if spelling == "dstr" else spelling
    )

def measured_rejected_and_accepted_element_spellings_are_distinguished() -> bool:
    ensure result == true
    return SemanticSetMembershipElementPolicy::is_unsupported_spelling("sview") and
        SemanticSetMembershipElementPolicy::is_unsupported_spelling("dstr") and
        SemanticSetMembershipElementPolicy::is_unsupported_spelling("f32") and
        SemanticSetMembershipElementPolicy::is_unsupported_spelling("f64") and
        not SemanticSetMembershipElementPolicy::is_unsupported_spelling("cstr") and
        not SemanticSetMembershipElementPolicy::is_unsupported_spelling("i64") and
        not SemanticSetMembershipElementPolicy::is_unsupported_spelling("bool") and
        not SemanticSetMembershipElementPolicy::is_unsupported_spelling("char")

def dstr_uses_its_lowered_type_in_the_diagnostic() -> bool:
    ensure result == true
    return SemanticSetMembershipElementPolicy::diagnostic_spelling("dstr") == "darray[u8]" and
        SemanticSetMembershipElementPolicy::diagnostic_spelling("sview") == "sview" and
        SemanticSetMembershipElementPolicy::diagnostic_spelling("f64") == "f64"
