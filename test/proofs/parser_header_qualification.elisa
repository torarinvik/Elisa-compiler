# Prove token bounds and the neighbor priority used for contextual header words.
include "../../src/parser/parser_header_qualification_model.elisa"

def cursor_has_token_matches_unsigned_order(position: usize, token_count: usize) -> bool:
    ensure result == true
    return ParserHeaderQualification::has_token(position, token_count) == (position < token_count)

def cursor_at_token_end_has_no_token(token_count: usize) -> bool:
    ensure result == true
    return not ParserHeaderQualification::has_token(token_count, token_count)

def offset_before_remaining_end_is_in_range(position: usize, token_count: usize, offset: usize) -> bool:
    requires position < token_count
    requires offset < token_count - position
    ensure result == true
    return ParserHeaderQualification::offset_is_in_range(position, token_count, offset)

def offset_at_remaining_end_is_rejected(position: usize, token_count: usize, offset: usize) -> bool:
    requires position < token_count
    requires offset == token_count - position
    ensure result == true
    return not ParserHeaderQualification::offset_is_in_range(position, token_count, offset)

def offset_after_remaining_end_is_rejected(position: usize, token_count: usize, offset: usize) -> bool:
    requires position < token_count
    requires offset > token_count - position
    ensure result == true
    return not ParserHeaderQualification::offset_is_in_range(position, token_count, offset)

def following_peek_index_is_at_or_before_token_end(position: usize, token_count: usize, offset: usize) -> bool:
    requires position < token_count
    requires offset < token_count - position
    ensure result == true
    return position + offset + 1 <= token_count

def preceding_peek_index_is_inside_token_stream(position: usize, token_count: usize, offset: usize) -> bool:
    requires position < token_count
    requires offset > 0
    requires offset < token_count - position
    ensure result == true
    return position + (offset - 1) < token_count

def cursor_predecessor_index_is_inside_token_stream(position: usize, token_count: usize) -> bool:
    requires position > 0
    requires position < token_count
    ensure result == true
    return position - 1 < token_count

def following_scope_qualifies_even_at_offset_zero() -> bool:
    ensure result == true
    return ParserHeaderQualification::qualified_by_neighbors(0, true, false, false)

def qualification_matches_the_exact_neighbor_policy(offset: usize, following_is_scope: bool, previous_is_scope: bool, previous_token_is_scope: bool) -> bool:
    ensure result == true
    return ParserHeaderQualification::qualified_by_neighbors(offset, following_is_scope, previous_is_scope, previous_token_is_scope) == (following_is_scope or (offset > 0 and previous_is_scope) or (offset == 0 and previous_token_is_scope))

def relative_previous_scope_qualifies_after_offset_zero(offset: usize) -> bool:
    requires offset > 0
    ensure result == true
    return ParserHeaderQualification::qualified_by_neighbors(offset, false, true, false)

def cursor_predecessor_is_fallback_at_offset_zero() -> bool:
    ensure result == true
    return ParserHeaderQualification::qualified_by_neighbors(0, false, false, true)

def prior_token_does_not_override_a_nonzero_offset(offset: usize) -> bool:
    requires offset > 0
    ensure result == true
    return not ParserHeaderQualification::qualified_by_neighbors(offset, false, false, true)

def no_scope_neighbor_leaves_word_unqualified(offset: usize) -> bool:
    ensure result == true
    return not ParserHeaderQualification::qualified_by_neighbors(offset, false, false, false)
