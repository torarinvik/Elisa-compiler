include "./wasm_storage_keyword.elisa"

def identifier_must_not_be_a_storage_qualifier() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return WasmStorageKeyword::is_storage_keyword(Lexer::TokenKind.Ident)

def compound_shift_must_not_be_a_storage_qualifier() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return WasmStorageKeyword::is_storage_keyword(Lexer::TokenKind.LShiftEq)
