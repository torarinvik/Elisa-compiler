# Source-linked proof of the whole-function fulfills protocol and marker rules.
module FulfillsWholeFunctionRule:
    public:
        const FULFILLS_WHOLE_FUNCTION_ROW: u32 = 3900000020
        const NEIGHBORING_ANNOTATION_ROW: u32 = 3900000019

        def is_whole_function_protocol(protocol: sview) -> bool:
            ensure result == (
                when protocol:
                    "NoBoundsChecks" | "Vectorizes" -> true
                    _ -> false
            )
            return when protocol:
                "NoBoundsChecks" | "Vectorizes" -> true
                _ -> false

        def should_mark_subject_fulfills(is_subject_form: bool, protocol: sview) -> bool:
            ensure result == (is_subject_form and is_whole_function_protocol(protocol))
            return is_subject_form and is_whole_function_protocol(protocol)

        def should_report_annotation_row(annotation_row: u32) -> bool:
            ensure result == (annotation_row == FULFILLS_WHOLE_FUNCTION_ROW)
            return annotation_row == FULFILLS_WHOLE_FUNCTION_ROW

def source_protocol_match_is_exact(protocol: sview) -> bool:
    ensure result == true
    return FulfillsWholeFunctionRule::is_whole_function_protocol(protocol) ==
        (when protocol:
            "NoBoundsChecks" | "Vectorizes" -> true
            _ -> false
        )

def both_whole_function_protocols_are_classified() -> bool:
    ensure result == true
    return FulfillsWholeFunctionRule::is_whole_function_protocol("NoBoundsChecks") and
        FulfillsWholeFunctionRule::is_whole_function_protocol("Vectorizes")

def other_protocol_names_are_not_classified() -> bool:
    ensure result == true
    return not FulfillsWholeFunctionRule::is_whole_function_protocol("Positive") and
        not FulfillsWholeFunctionRule::is_whole_function_protocol("NoAlloc") and
        not FulfillsWholeFunctionRule::is_whole_function_protocol("")

def only_subject_forms_with_whole_function_protocols_are_marked(is_subject_form: bool, protocol: sview) -> bool:
    ensure result == true
    return FulfillsWholeFunctionRule::should_mark_subject_fulfills(is_subject_form, protocol) ==
        (is_subject_form and FulfillsWholeFunctionRule::is_whole_function_protocol(protocol))

def malformed_subject_forms_are_not_marked() -> bool:
    ensure result == true
    return not FulfillsWholeFunctionRule::should_mark_subject_fulfills(false, "NoBoundsChecks")

def the_parser_marker_is_reported() -> bool:
    ensure result == true
    return FulfillsWholeFunctionRule::should_report_annotation_row(FulfillsWholeFunctionRule::FULFILLS_WHOLE_FUNCTION_ROW)

def other_annotation_rows_are_not_reported(annotation_row: u32) -> bool:
    requires annotation_row != FulfillsWholeFunctionRule::FULFILLS_WHOLE_FUNCTION_ROW
    ensure result == true
    return not FulfillsWholeFunctionRule::should_report_annotation_row(annotation_row)
