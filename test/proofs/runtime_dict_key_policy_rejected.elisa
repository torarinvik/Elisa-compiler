# Deliberately false claims control the rejected key boundary and dstr diagnostic mapping.
include "./runtime_dict_key_policy.elisa"

def false_claim_cstr_is_an_unhashable_resolved_key() -> bool:
    ensure result == true
    return SemanticRuntimeDictKeyPolicy::is_unhashable_resolved_key_spelling("cstr")

def false_claim_f64_requires_a_declared_spelling_check() -> bool:
    ensure result == true
    return SemanticRuntimeDictKeyPolicy::requires_declared_key_spelling_check("f64")

def false_claim_dstr_keeps_its_declared_diagnostic_spelling() -> bool:
    ensure result == true
    return SemanticRuntimeDictKeyPolicy::diagnostic_spelling("dstr") == "dstr"
