include "../../src/semantic/binding_identity_types.elisa"
include "../../src/semantic/ownership_flow_domain.elisa"
include "../../src/semantic/ownership_binding_flow.elisa"

const EXAMPLE_DECL_ID: u32 = 7
const OTHER_EXAMPLE_DECL_ID: u32 = 8
const FIRST_BINDING_SERIAL: u64 = Semantic::FIRST_BINDING_SERIAL
const NEXT_BINDING_SERIAL: u64 = 1

def invalid_owner_is_valid() -> bool:
    ensure result == true
    return Semantic::ownership_binding_id_valid(Semantic::BindingId{owner: Semantic::DeclId{value: Semantic::INVALID_DECL_ID_VALUE},
        serial: FIRST_BINDING_SERIAL})

def different_serials_are_equal() -> bool:
    ensure result == true
    return Semantic::ownership_binding_ids_equal(Semantic::BindingId{owner: Semantic::DeclId{value: EXAMPLE_DECL_ID},
        serial: FIRST_BINDING_SERIAL},
        Semantic::BindingId{owner: Semantic::DeclId{value: EXAMPLE_DECL_ID},
        serial: NEXT_BINDING_SERIAL})

def different_functions_are_equal() -> bool:
    ensure result == true
    return Semantic::ownership_binding_ids_equal(Semantic::BindingId{owner: Semantic::DeclId{value: EXAMPLE_DECL_ID},
        serial: FIRST_BINDING_SERIAL},
        Semantic::BindingId{owner: Semantic::DeclId{value: OTHER_EXAMPLE_DECL_ID},
        serial: FIRST_BINDING_SERIAL})

def distinct_serials_are_equal(left: u64, right: u64) -> bool:
    requires left != right
    ensure result == true
    return Semantic::ownership_binding_ids_equal(Semantic::BindingId{owner: Semantic::DeclId{value: EXAMPLE_DECL_ID},
        serial: left},
        Semantic::BindingId{owner: Semantic::DeclId{value: EXAMPLE_DECL_ID},
        serial: right})

def distinct_functions_are_equal(left: u32, right: u32) -> bool:
    requires left != right
    ensure result == true
    return Semantic::ownership_binding_ids_equal(Semantic::BindingId{owner: Semantic::DeclId{value: left},
        serial: FIRST_BINDING_SERIAL},
        Semantic::BindingId{owner: Semantic::DeclId{value: right},
        serial: FIRST_BINDING_SERIAL})
