include "../../src/semantic/binding_identity_types.elisa"
include "../../src/semantic/ownership_flow_domain.elisa"
include "../../src/semantic/ownership_binding_flow.elisa"

def invalid_owner_is_valid() -> bool:
    ensure result == true
    return Semantic::ownership_binding_id_valid(Semantic::BindingId{owner: Semantic::DeclId{value: 4294967295}, serial: 0})

def different_serials_are_equal() -> bool:
    ensure result == true
    return Semantic::ownership_binding_ids_equal(Semantic::BindingId{owner: Semantic::DeclId{value: 7}, serial: 0}, Semantic::BindingId{owner: Semantic::DeclId{value: 7}, serial: 1})

def different_functions_are_equal() -> bool:
    ensure result == true
    return Semantic::ownership_binding_ids_equal(Semantic::BindingId{owner: Semantic::DeclId{value: 7}, serial: 0}, Semantic::BindingId{owner: Semantic::DeclId{value: 8}, serial: 0})
