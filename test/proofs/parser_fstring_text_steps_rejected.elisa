include "./parser_fstring_text_steps.elisa"

def false_claim_text_backslash_advances_one(state: i64, depth: i64, character: i64) -> (state: i64, depth: i64, advance: i64):
    requires state == FS_TEXT and character == F_BACKSLASH
    ensure result.advance == 1
    return (state: FS_TEXT, depth: depth, advance: 2)

def false_claim_double_open_advances_one(state: i64, depth: i64, character: i64, next_character: i64, has_next: bool) -> (state: i64, depth: i64, advance: i64):
    requires state == FS_TEXT and character == F_LBRACE and has_next and next_character == F_LBRACE
    ensure result.advance == 1
    return (state: FS_TEXT, depth: depth, advance: 2)

def false_claim_lone_open_stays_text(state: i64, depth: i64, character: i64, next_character: i64, has_next: bool) -> (state: i64, depth: i64, advance: i64):
    requires state == FS_TEXT and character == F_LBRACE
    requires not (has_next and next_character == F_LBRACE)
    ensure result.state == FS_TEXT
    return (state: FS_EXPR, depth: 1, advance: 1)
