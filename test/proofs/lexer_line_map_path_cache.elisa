# The path hash is only a probe accelerator: a cached classification may be
# reused only after exact path equality. Probe transitions remain bounded, and
# misses always compute the classification directly.
const LINE_MAP_PATH_CACHE_CAPACITY_MODEL: i64 = 8192

def cache_hit_requires_occupied_hash_and_equal_path(
    occupied: bool,
    hashes_match: bool,
    paths_equal: bool
) -> bool:
    ensure result == (occupied and hashes_match and paths_equal)
    return occupied and hashes_match and paths_equal

def matching_exact_path_reuses_cached_classification(
    occupied: bool,
    hashes_match: bool,
    paths_equal: bool,
    cached_is_std: bool,
    direct_is_std: bool
) -> bool:
    requires occupied and hashes_match and paths_equal
    ensure result == cached_is_std
    return cached_is_std if occupied and hashes_match and paths_equal else direct_is_std

def hash_collision_uses_direct_classification(
    occupied: bool,
    hashes_match: bool,
    paths_equal: bool,
    cached_is_std: bool,
    direct_is_std: bool
) -> bool:
    requires occupied and hashes_match and not paths_equal
    ensure result == direct_is_std
    return cached_is_std if occupied and hashes_match and paths_equal else direct_is_std

def empty_slot_uses_direct_classification(
    occupied: bool,
    hashes_match: bool,
    paths_equal: bool,
    cached_is_std: bool,
    direct_is_std: bool
) -> bool:
    requires not occupied
    ensure result == direct_is_std
    return cached_is_std if occupied and hashes_match and paths_equal else direct_is_std

def cache_miss_uses_direct_classification(found: bool, cached_is_std: bool, direct_is_std: bool) -> bool:
    requires not found
    ensure result == direct_is_std
    return cached_is_std if found else direct_is_std

def wrapped_probe_slot_stays_in_range(slot: i64) -> bool:
    requires slot >= 0 and slot < LINE_MAP_PATH_CACHE_CAPACITY_MODEL
    ensure result == true
    next_slot: i64 = 0 if slot + 1 >= LINE_MAP_PATH_CACHE_CAPACITY_MODEL else slot + 1
    return next_slot >= 0 and next_slot < LINE_MAP_PATH_CACHE_CAPACITY_MODEL

def probe_counter_advances_no_farther_than_capacity(probes: i64) -> bool:
    requires probes >= 0 and probes < LINE_MAP_PATH_CACHE_CAPACITY_MODEL
    ensure result == true
    next_probes: i64 = probes + 1
    return next_probes > probes and next_probes <= LINE_MAP_PATH_CACHE_CAPACITY_MODEL
