# Source-linked laws for the early region-store escape guards.
# Locally tracked region values cannot escape through mutable globals or inferred auto storage.

def global_store_guard_is_exact(target_is_global_mutable: bool,
    value_region_is_on_stack: bool) -> bool:
    ensure result == (target_is_global_mutable and value_region_is_on_stack)
    return target_is_global_mutable and value_region_is_on_stack

def local_region_value_to_mutable_global_is_an_escape(value_region_is_on_stack: bool) -> bool:
    requires value_region_is_on_stack
    ensure result == true
    return global_store_guard_is_exact(true, value_region_is_on_stack)

def region_parameter_does_not_take_the_local_global_escape_guard(target_is_global_mutable: bool) -> bool:
    requires target_is_global_mutable
    ensure result == false
    return global_store_guard_is_exact(target_is_global_mutable, false)

def auto_store_guard_is_exact(target_is_auto: bool,
    value_region_is_on_stack: bool) -> bool:
    ensure result == (target_is_auto and value_region_is_on_stack)
    return target_is_auto and value_region_is_on_stack

def local_region_value_to_auto_storage_is_an_escape(value_region_is_on_stack: bool) -> bool:
    requires value_region_is_on_stack
    ensure result == true
    return auto_store_guard_is_exact(true, value_region_is_on_stack)

def non_auto_target_does_not_take_the_auto_escape_guard(value_region_is_on_stack: bool) -> bool:
    requires value_region_is_on_stack
    ensure result == false
    return auto_store_guard_is_exact(false, value_region_is_on_stack)
