# Guarded sign-quadrant products plus the special zero, one, and negative-one cases from
# Semantic.linear_mul_safe. The source checker ties these contracts to its branch order.
const I64_MAX: i64 = 9223372036854775807
const I64_MIN: i64 = 0 - I64_MAX - 1

def safe_mul_positive_positive(left: i64, right: i64) -> i64:
    requires left > 0 and right > 0
    requires left <= I64_MAX / right
    ensure result == left * right
    return left * right

def safe_mul_positive_negative(left: i64, right: i64) -> i64:
    requires left > 0 and right < 0
    requires right >= I64_MIN / left
    ensure result == left * right
    return left * right

def safe_mul_negative_positive(left: i64, right: i64) -> i64:
    requires left < 0 and right > 0
    requires left >= I64_MIN / right
    ensure result == left * right
    return left * right

def safe_mul_negative_negative(left: i64, right: i64) -> i64:
    requires left < 0 and right < 0
    requires left >= I64_MAX / right
    ensure result == left * right
    return left * right

def zero_product_case(left: i64, right: i64) -> i64:
    requires left == 0 or right == 0
    ensure result == 0
    return 0

def left_one_product_case(left: i64, right: i64) -> i64:
    requires left == 1
    ensure result == right
    return right

def right_one_product_case(left: i64, right: i64) -> i64:
    requires right == 1
    ensure result == left
    return left

def left_negative_one_product_case(left: i64, right: i64) -> i64:
    requires left == (0 - 1) and right != I64_MIN
    ensure result == (0 - right)
    return 0 - right

def right_negative_one_product_case(left: i64, right: i64) -> i64:
    requires right == (0 - 1) and left != I64_MIN
    ensure result == (0 - left)
    return 0 - left

def minimum_left_times_negative_one_is_rejected(left: i64, right: i64) -> bool:
    requires left == (0 - I64_MAX - 1) and right == (0 - 1)
    ensure result == false
    return left != (0 - I64_MAX - 1)

def negative_one_times_minimum_right_is_rejected(left: i64, right: i64) -> bool:
    requires left == (0 - 1) and right == (0 - I64_MAX - 1)
    ensure result == false
    return right != (0 - I64_MAX - 1)
