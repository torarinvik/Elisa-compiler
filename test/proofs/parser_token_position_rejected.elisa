include "./parser_token_position_proof_model.elisa"

def token_position_line_is_column(line: u32, column: u32, offset: u32, end_line: u32, end_column: u32, end_offset: u32) -> bool:
    ensure result == true
    position: Ast::Pos = Ast::Pos{
        line: line,
        column: column,
        offset: offset,
        end_line: end_line,
        end_column: end_column,
        end_offset: end_offset
    }
    return position.line == column
