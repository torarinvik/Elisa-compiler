include "./index_constant_division_guards.elisa"

def false_zero_divisor_passes_guard(right: i64) -> bool:
    requires right == 0
    ensure result == true
    return proof_divisor_is_nonzero(right)

def false_nonzero_divisor_is_rejected(right: i64) -> bool:
    requires right != 0
    ensure result == true
    return not proof_divisor_is_nonzero(right)

def false_min_overflow_pair_is_safe(left: i64, right: i64, minimum: i64) -> bool:
    requires left == minimum and right == (0 - 1)
    ensure result == true
    return not proof_min_div_negative_one_pair(left, right, minimum)
