# These claims would be unsound if aph_provable weakened its integer thresholds.
# check_assert_proof_hole_interval_soundness.py requires each claim to remain unproved.

def lower_zero_does_not_prove_strict_gt(value: i64, lower: i64) -> bool:
    requires value >= lower and lower == 0 and value == 0
    ensure result == true
    return value > 0

def negative_lower_does_not_prove_ge(value: i64, lower: i64) -> bool:
    requires value >= lower and lower == -1 and value == -1
    ensure result == true
    return value >= 0

def upper_zero_does_not_prove_strict_lt(value: i64, upper: i64) -> bool:
    requires value <= upper and upper == 0 and value == 0
    ensure result == true
    return value < 0

def positive_upper_does_not_prove_le(value: i64, upper: i64) -> bool:
    requires value <= upper and upper == 1 and value == 1
    ensure result == true
    return value <= 0

def nonsingleton_interval_does_not_prove_eq(value: i64, lower: i64, upper: i64) -> bool:
    requires value >= lower and value <= upper and lower == 0 and upper == 1 and value == 1
    ensure result == true
    return value == 0

def interval_containing_zero_does_not_prove_neq(value: i64, lower: i64, upper: i64) -> bool:
    requires value >= lower and value <= upper and lower == -1 and upper == 1 and value == 0
    ensure result == true
    return value != 0
