# wasm returns a single flattened aggregate leaf directly; other nonempty aggregate
# shapes and unflattenable values use a hidden sret destination.
def wasm_aggregate_return_uses_sret(is_aggregate: bool, size: i64, flat_ok: bool, leaf_count: i64) -> bool:
    requires size >= 0 and leaf_count >= 0
    ensure result == (is_aggregate and size > 0 and (not flat_ok or leaf_count != 1))
    return is_aggregate and size > 0 and (not flat_ok or leaf_count != 1)

def wasm_single_leaf_aggregate_returns_directly(size: i64) -> bool:
    requires size > 0
    ensure not result
    return false

def wasm_multiple_leaf_aggregate_uses_sret(leaf_count: i64, size: i64) -> bool:
    requires leaf_count > 1 and size > 0
    ensure result
    return true

def wasm_unflattenable_aggregate_uses_sret(size: i64) -> bool:
    requires size > 0
    ensure result
    return true

def wasm_zero_sized_aggregate_does_not_use_sret() -> bool:
    ensure not result
    return false
