# Model the one-row conflict decision in fn_error_family_at_offset. The companion checker
# binds this gate to the source branch that returns the empty family before updating `found`.
def duplicate_conflict_gate_is_exact(line_matches: bool, offset_matches: bool, found_nonempty: bool, same_family: bool) -> bool:
    ensure result == (line_matches and offset_matches and found_nonempty and not same_family)
    return line_matches and offset_matches and found_nonempty and not same_family

def unmatched_row_cannot_conflict(line_matches: bool, offset_matches: bool, found_nonempty: bool, same_family: bool) -> bool:
    requires not line_matches or not offset_matches
    ensure result == false
    return line_matches and offset_matches and found_nonempty and not same_family

def first_matching_row_cannot_conflict(line_matches: bool, offset_matches: bool, found_nonempty: bool, same_family: bool) -> bool:
    requires line_matches and offset_matches and not found_nonempty
    ensure result == false
    return line_matches and offset_matches and found_nonempty and not same_family

def consistent_matching_duplicate_cannot_conflict(line_matches: bool, offset_matches: bool, found_nonempty: bool, same_family: bool) -> bool:
    requires line_matches and offset_matches and found_nonempty and same_family
    ensure result == false
    return line_matches and offset_matches and found_nonempty and not same_family

def conflicting_matching_duplicate_must_conflict(line_matches: bool, offset_matches: bool, found_nonempty: bool, same_family: bool) -> bool:
    requires line_matches and offset_matches and found_nonempty and not same_family
    ensure result == true
    return line_matches and offset_matches and found_nonempty and not same_family

def mismatch_without_prior_family_cannot_conflict(line_matches: bool, offset_matches: bool, found_nonempty: bool, same_family: bool) -> bool:
    requires line_matches and offset_matches and not found_nonempty and not same_family
    ensure result == false
    return line_matches and offset_matches and found_nonempty and not same_family
