# Source-linked laws for the closed never-leak CLI flag classifier.
include "../../src/driver/never_leak_cli_flags.elisa"

def warning_aliases_select_warning_mode() -> bool:
    ensure result == true
    return (
        NeverLeakCliFlags::classify("-Wnever-leak") == NeverLeakCliFlags::Action.Warn
        and NeverLeakCliFlags::classify("never-leak") == NeverLeakCliFlags::Action.Warn
        and NeverLeakCliFlags::classify("-Wnever-leak=gentle") == NeverLeakCliFlags::Action.WarnGentle
        and NeverLeakCliFlags::classify("never-leak=gentle") == NeverLeakCliFlags::Action.WarnGentle
        and NeverLeakCliFlags::classify("-Wnever-leak=strict") == NeverLeakCliFlags::Action.WarnStrict
        and NeverLeakCliFlags::classify("never-leak=strict") == NeverLeakCliFlags::Action.WarnStrict
    )

def error_aliases_select_error_mode() -> bool:
    ensure result == true
    return (
        NeverLeakCliFlags::classify("-Werror=never-leak") == NeverLeakCliFlags::Action.Error
        and NeverLeakCliFlags::classify("error=never-leak") == NeverLeakCliFlags::Action.Error
        and NeverLeakCliFlags::classify("-Werror=never-leak=gentle") == NeverLeakCliFlags::Action.ErrorGentle
        and NeverLeakCliFlags::classify("error=never-leak=gentle") == NeverLeakCliFlags::Action.ErrorGentle
        and NeverLeakCliFlags::classify("-Werror=never-leak=strict") == NeverLeakCliFlags::Action.ErrorStrict
        and NeverLeakCliFlags::classify("error=never-leak=strict") == NeverLeakCliFlags::Action.ErrorStrict
    )

def unknown_flags_are_unrecognized() -> bool:
    ensure result == true
    return (
        NeverLeakCliFlags::classify("-Wnever-leak=unknown") == NeverLeakCliFlags::Action.Unrecognized
        and NeverLeakCliFlags::classify("never-leakage") == NeverLeakCliFlags::Action.Unrecognized
        and NeverLeakCliFlags::classify("") == NeverLeakCliFlags::Action.Unrecognized
    )
