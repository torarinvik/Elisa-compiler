# False claims challenge the exponent sign and first-character guards.
include "../../src/lexer/lexer_number_exponent.elisa"

def a_sign_without_a_digit_is_valid() -> bool:
    ensure result == true
    return LexerNumberExponent::follows('+', 'x')

def an_exponent_marker_is_a_valid_unsigned_tail() -> bool:
    ensure result == true
    return LexerNumberExponent::follows('e', '5')

def a_non_ascii_decimal_digit_is_valid_as_a_tail() -> bool:
    ensure result == true
    return LexerNumberExponent::follows('١', 'x')
