# Source-linked proofs for the C binding layout guard and its enum marker lookup.
include "../../src/semantic/cbind_layout_policy.elisa"

def c_bind_requires_a_named_owner(annotation_name: sview, owner: sview) -> bool:
    ensure result == (annotation_name == "c_bind" and owner != "")
    return CBindLayoutPolicy::is_named_c_bind(annotation_name, owner)

def c_layout_marker_requires_exact_name_and_owner(annotation_name: sview, annotation_owner: sview, owner: sview) -> bool:
    ensure result == (annotation_name == "__layout_c" and annotation_owner == owner)
    return CBindLayoutPolicy::marker_belongs_to_owner(annotation_name, annotation_owner, owner)

def missing_c_layout_is_reported() -> bool:
    ensure result == true
    return CBindLayoutPolicy::should_report_missing_layout(false)

def present_c_layout_is_accepted() -> bool:
    ensure result == true
    return not CBindLayoutPolicy::should_report_missing_layout(true)

def c_layout_marker_on_same_owner_is_recognized() -> bool:
    ensure result == true
    return CBindLayoutPolicy::marker_belongs_to_owner("__layout_c", "Point", "Point")

def different_layout_marker_is_not_c_layout() -> bool:
    ensure result == true
    return not CBindLayoutPolicy::marker_belongs_to_owner("__layout_soa", "Point", "Point")

def marker_for_another_owner_is_not_a_match() -> bool:
    ensure result == true
    return not CBindLayoutPolicy::marker_belongs_to_owner("__layout_c", "Other", "Point")
