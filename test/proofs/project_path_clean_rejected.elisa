# A rooted path cannot become empty or lose its leading separator during cleaning.
include "../../src/driver/project.elisa"

def a_cleaned_absolute_path_can_lose_its_root(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    requires ProjectSystem::path_is_absolute(path)
    ensure result == true
    cleaned: darray[u8] = ProjectSystem::path_clean(path)
    return (
        cleaned.count == 0.usize() or
        cleaned[0.usize()] != ProjectSystemPathByte::ASCII_FORWARD_SLASH
    )

def an_empty_relative_path_can_clean_to_empty(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    requires path.count == 0.usize()
    ensure result == true
    cleaned: darray[u8] = ProjectSystem::path_clean(path)
    return cleaned.count == 0.usize()

def a_single_root_separator_can_clean_to_dot(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    requires path.count == 1.usize() and path[0.usize()] == ProjectSystemPathByte::ASCII_FORWARD_SLASH
    ensure result == true
    cleaned: darray[u8] = ProjectSystem::path_clean(path)
    return cleaned.count == 1.usize() and cleaned[0.usize()] == 46
