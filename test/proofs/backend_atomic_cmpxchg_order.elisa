# Source-bound valid compare-exchange order-pair cases.

def cmpxchg_relaxed_relaxed_is_valid(success: i64, failure: i64) -> bool:
    requires success == 0 and failure == 0
    ensure result == true
    return failure == 0

def cmpxchg_acquire_relaxed_is_valid(success: i64, failure: i64) -> bool:
    requires success == 1 and failure == 0
    ensure result == true
    return failure == 0 or failure == 1

def cmpxchg_acquire_acquire_is_valid(success: i64, failure: i64) -> bool:
    requires success == 1 and failure == 1
    ensure result == true
    return failure == 0 or failure == 1

def cmpxchg_release_relaxed_is_valid(success: i64, failure: i64) -> bool:
    requires success == 2 and failure == 0
    ensure result == true
    return failure == 0

def cmpxchg_acqrel_relaxed_is_valid(success: i64, failure: i64) -> bool:
    requires success == 3 and failure == 0
    ensure result == true
    return failure == 0 or failure == 1

def cmpxchg_acqrel_acquire_is_valid(success: i64, failure: i64) -> bool:
    requires success == 3 and failure == 1
    ensure result == true
    return failure == 0 or failure == 1

def cmpxchg_seqcst_relaxed_is_valid(success: i64, failure: i64) -> bool:
    requires success == 4 and failure == 0
    ensure result == true
    return failure == 0 or failure == 1 or failure == 4

def cmpxchg_seqcst_acquire_is_valid(success: i64, failure: i64) -> bool:
    requires success == 4 and failure == 1
    ensure result == true
    return failure == 0 or failure == 1 or failure == 4

def cmpxchg_seqcst_seqcst_is_valid(success: i64, failure: i64) -> bool:
    requires success == 4 and failure == 4
    ensure result == true
    return failure == 0 or failure == 1 or failure == 4

def cmpxchg_dynamic_success_acquire_failure_is_valid(success: i64, failure: i64) -> bool:
    requires success == -1 and failure == 1
    ensure result == true
    return success == -1 or failure == -1

def cmpxchg_release_success_dynamic_failure_is_valid(success: i64, failure: i64) -> bool:
    requires success == 2 and failure == -1
    ensure result == true
    return success == -1 or failure == -1

def cmpxchg_both_dynamic_is_valid(success: i64, failure: i64) -> bool:
    requires success == -1 and failure == -1
    ensure result == true
    return success == -1 or failure == -1
