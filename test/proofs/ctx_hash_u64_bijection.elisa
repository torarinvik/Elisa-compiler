# The scalar-key finalizer is a permutation of the full 64-bit word space.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"

def inverse_multipliers_are_units_modulo_64_bits() -> bool:
    ensure result == true
    return (
        0xbf58476d1ce4e5b9 * CTX_HASH_U64_INV_MUL_1 == 1
        and 0x94d049bb133111eb * CTX_HASH_U64_INV_MUL_2 == 1
    )

def scalar_hash_finalizer_roundtrips_every_word(value: u64) -> bool:
    ensure result == true
    return ctx_unhash_u64(ctx_hash_u64(value)) == value

def equal_scalar_hashes_imply_equal_words(left: u64, right: u64) -> bool:
    requires ctx_hash_u64(left) == ctx_hash_u64(right)
    ensure result == true
    return left == right
