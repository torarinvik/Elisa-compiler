# False width claims must remain open under the exact production address-register policy.
include "./easm_address_width_policy.elisa"

def a_64_bit_register_has_32_bit_address_width() -> bool:
    ensure result == true
    return EasmAddressWidthPolicy::address_register_width("rax") == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_32

def a_32_bit_register_has_64_bit_address_width() -> bool:
    ensure result == true
    return EasmAddressWidthPolicy::address_register_width("eax") == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_64

def an_unmodeled_partial_register_has_a_valid_address_width() -> bool:
    ensure result == true
    return EasmAddressWidthPolicy::address_register_width("al") != EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_UNKNOWN

def instruction_pointer_is_a_general_address_base() -> bool:
    ensure result == true
    return EasmAddressWidthPolicy::address_register_width("rip") == EasmAddressWidthPolicy::ADDRESS_REGISTER_WIDTH_64
