# Verify the exact compiler implementation of position construction.
module Lexer:
    public:
        const LEXER_POSITION_PROOF_SCOPE: bool = true

include "../../src/lexer/lexer_position.elisa"

def position_preserves_line(line: int, column: int, offset: usize) -> bool:
    ensure result == true
    position: Lexer::LexerPosition = Lexer::LexerPosition(line, column, offset)
    return position.line == line

def position_preserves_column(line: int, column: int, offset: usize) -> bool:
    ensure result == true
    position: Lexer::LexerPosition = Lexer::LexerPosition(line, column, offset)
    return position.column == column

def position_preserves_offset(line: int, column: int, offset: usize) -> bool:
    ensure result == true
    position: Lexer::LexerPosition = Lexer::LexerPosition(line, column, offset)
    return position.offset == offset
