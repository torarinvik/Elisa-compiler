# Source-linked laws for BindingId-indexed ownership facts and one-shot consume.
# This proves the operations in the semantic implementation, not CFG discovery,
# borrow exclusivity, affine eligibility, or native effect legality.
include "../../src/semantic/binding_identity_types.elisa"
include "../../src/semantic/ownership_flow_domain.elisa"
include "../../src/semantic/ownership_binding_flow.elisa"

def matching_binding_join_is_componentwise(owner: u32,
    serial: u64,
    left_reachable: bool,
    left_known: bool,
    left_live: bool,
    left_consumed: bool,
    right_reachable: bool,
    right_known: bool,
    right_live: bool,
    right_consumed: bool) -> bool:
    requires owner != Semantic::INVALID_DECL_ID_VALUE
    ensure result == true
    identifier: Semantic::BindingId = Semantic::BindingId{owner: Semantic::DeclId{value: owner}, serial: serial}
    left: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: identifier,
        reachable: left_reachable,
        known: left_known,
        may_live: left_live,
        may_consumed: left_consumed}
    right: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: identifier,
        reachable: right_reachable,
        known: right_known,
        may_live: right_live,
        may_consumed: right_consumed}
    joined: Semantic::OwnershipBindingFact = Semantic::ownership_binding_join(identifier, left, right)
    return (
        joined.binding_id.owner.value == owner
        and joined.binding_id.serial == serial
        and joined.reachable == (left_reachable
            or right_reachable)
        and joined.known == ((left_reachable
                or right_reachable)
            and (not left_reachable
                or left_known)
            and (not right_reachable
                or right_known))
        and joined.may_live == ((left_reachable
                and left_live)
            or (right_reachable
                and right_live))
        and joined.may_consumed == ((left_reachable
                and left_consumed)
            or (right_reachable
                and right_consumed))
    )

def foreign_left_binding_is_rejected(owner: u32, foreign_owner: u32, serial: u64, left_reachable: bool, right_reachable: bool) -> bool:
    requires owner != Semantic::INVALID_DECL_ID_VALUE and foreign_owner != Semantic::INVALID_DECL_ID_VALUE and owner != foreign_owner
    ensure result == true
    identifier: Semantic::BindingId = Semantic::BindingId{owner: Semantic::DeclId{value: owner}, serial: serial}
    foreign: Semantic::BindingId = Semantic::BindingId{owner: Semantic::DeclId{value: foreign_owner}, serial: serial}
    left: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: foreign,
        reachable: left_reachable,
        known: true,
        may_live: false,
        may_consumed: false}
    right: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: identifier,
        reachable: right_reachable,
        known: true,
        may_live: false,
        may_consumed: false}
    joined: Semantic::OwnershipBindingFact = Semantic::ownership_binding_join(identifier, left, right)
    reachable: bool = left_reachable or right_reachable
    return (
        joined.binding_id.owner.value == owner
        and joined.binding_id.serial == serial
        and not joined.known
        and joined.reachable == reachable
        and joined.may_live == reachable
        and joined.may_consumed == reachable
    )

