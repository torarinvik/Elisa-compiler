def invalid_identity_join_is_rejected(serial: u64, left_reachable: bool, right_reachable: bool) -> bool:
    ensure result == true
    identifier: Semantic::BindingId = Semantic::BindingId{owner: Semantic::DeclId{value: Semantic::INVALID_DECL_ID_VALUE}, serial: serial}
    left: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: identifier,
        reachable: left_reachable,
        known: true,
        may_live: false,
        may_consumed: false}
    right: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: identifier,
        reachable: right_reachable,
        known: true,
        may_live: false,
        may_consumed: false}
    joined: Semantic::OwnershipBindingFact = Semantic::ownership_binding_join(identifier, left, right)
    reachable: bool = left_reachable or right_reachable
    return (
        joined.binding_id.owner.value == Semantic::INVALID_DECL_ID_VALUE
        and joined.binding_id.serial == serial
        and not joined.known
        and joined.reachable == reachable
        and joined.may_live == reachable
        and joined.may_consumed == reachable
    )

def eligible_binding_is_consumed_once(owner: u32, serial: u64) -> bool:
    requires owner != Semantic::INVALID_DECL_ID_VALUE
    ensure result == true
    identifier: Semantic::BindingId = Semantic::BindingId{owner: Semantic::DeclId{value: owner}, serial: serial}
    live: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: identifier,
        reachable: true,
        known: true,
        may_live: true,
        may_consumed: false}
    accepted, consumed = Semantic::ownership_binding_consume(live)
    accepted_again, unchanged = Semantic::ownership_binding_consume(consumed)
    return (
        accepted
        and not accepted_again
        and consumed.binding_id.owner.value == owner
        and consumed.binding_id.serial == serial
        and consumed.reachable
        and consumed.known
        and not consumed.may_live
        and consumed.may_consumed
        and unchanged.reachable == consumed.reachable
        and unchanged.known == consumed.known
        and unchanged.may_live == consumed.may_live
        and unchanged.may_consumed == consumed.may_consumed
        and Semantic::ownership_binding_ids_equal(unchanged.binding_id, identifier)
    )

def arbitrary_binding_fact_cannot_be_accepted_twice(owner: u32,
    serial: u64,
    reachable: bool,
    known: bool,
    may_live: bool,
    may_consumed: bool) -> bool:
    requires owner != Semantic::INVALID_DECL_ID_VALUE
    ensure result == true
    fact: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: Semantic::BindingId{owner: Semantic::DeclId{value: owner},
        serial: serial},
        reachable: reachable,
        known: known,
        may_live: may_live,
        may_consumed: may_consumed}
    accepted, after_first = Semantic::ownership_binding_consume(fact)
    accepted_again, _after_second = Semantic::ownership_binding_consume(after_first)
    return not (accepted and accepted_again)

def failed_consumption_preserves_every_fact(owner: u32,
    serial: u64,
    reachable: bool,
    known: bool,
    may_live: bool,
    may_consumed: bool) -> bool:
    requires not (owner != Semantic::INVALID_DECL_ID_VALUE and reachable and known and may_live and not may_consumed)
    ensure result == true
    identifier: Semantic::BindingId = Semantic::BindingId{owner: Semantic::DeclId{value: owner}, serial: serial}
    fact: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: identifier,
        reachable: reachable,
        known: known,
        may_live: may_live,
        may_consumed: may_consumed}
    accepted, next = Semantic::ownership_binding_consume(fact)
    return (
        not accepted
        and Semantic::ownership_binding_ids_equal(next.binding_id, identifier)
        and next.reachable == reachable
        and next.known == known
        and next.may_live == may_live
        and next.may_consumed == may_consumed
    )

def unreachable_binding_cannot_be_consumed(owner: u32, serial: u64) -> bool:
    requires owner != Semantic::INVALID_DECL_ID_VALUE
    ensure result == false
    fact: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: Semantic::BindingId{owner: Semantic::DeclId{value: owner},
        serial: serial},
        reachable: false,
        known: true,
        may_live: true,
        may_consumed: false}
    accepted, _next = Semantic::ownership_binding_consume(fact)
    return accepted

def unknown_binding_cannot_be_consumed(owner: u32, serial: u64) -> bool:
    requires owner != Semantic::INVALID_DECL_ID_VALUE
    ensure result == false
    fact: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: Semantic::BindingId{owner: Semantic::DeclId{value: owner},
        serial: serial},
        reachable: true,
        known: false,
        may_live: true,
        may_consumed: false}
    accepted, _next = Semantic::ownership_binding_consume(fact)
    return accepted

def invalid_owner_cannot_be_consumed(serial: u64) -> bool:
    ensure result == false
    fact: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: Semantic::BindingId{owner: Semantic::DeclId{value: Semantic::INVALID_DECL_ID_VALUE},
        serial: serial},
        reachable: true,
        known: true,
        may_live: true,
        may_consumed: false}
    accepted, _next = Semantic::ownership_binding_consume(fact)
    return accepted
