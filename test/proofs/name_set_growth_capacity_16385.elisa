# The next power-of-two threshold after the 8,193rd insertion.
def name_set_capacity_thirty_two_thousand_seven_hundred_sixty_eight_covers_next_eight_thousand_one_hundred_ninety_two_insertions(name_count: usize) -> bool:
    requires name_count >= 8192 and name_count <= 16383
    ensure result == true
    return 32768 >= (name_count + 1) * 2

def name_set_sixteen_thousand_three_hundred_eighty_fifth_entry_doubles_capacity(name_count: usize) -> usize:
    requires name_count == 16384
    ensure result == 65536
    return 65536 if 32768 < (name_count + 1) * 2 else 32768

def sixteen_thousand_three_hundred_eighty_fifth_name_rehash_keeps_forty_nine_thousand_one_hundred_fifty_one_slots_empty(name_count: usize) -> usize:
    requires name_count == 16384
    ensure result == 49151
    return (65536 if 32768 < (name_count + 1) * 2 else 32768) - (name_count + 1)
