# Boolean model for the meet used when EASM control-flow predecessors merge.
def model_join_fact(left: bool, right: bool) -> bool:
    ensure result == (left and right)
    return left and right

def both_predecessors_keep_a_fact(left: bool, right: bool) -> bool:
    requires left and right
    ensure result == true
    return left and right

def a_missing_left_fact_is_dropped(left: bool, right: bool) -> bool:
    requires not left
    ensure result == true
    return not (left and right)

def a_missing_right_fact_is_dropped(left: bool, right: bool) -> bool:
    requires not right
    ensure result == true
    return not (left and right)

def the_join_is_exactly_the_common_fact(left: bool, right: bool) -> bool:
    ensure result == true
    return (left and right) == (not (not left or not right))

def the_join_is_commutative(left: bool, right: bool) -> bool:
    ensure result == true
    return (left and right) == (right and left)

def a_true_right_predecessor_reduces_the_join_to_left(left: bool, right: bool) -> bool:
    requires right
    ensure result == true
    return (not left or (left and right)) and (not (left and right) or left)

def a_true_left_predecessor_reduces_the_join_to_right(left: bool, right: bool) -> bool:
    requires left
    ensure result == true
    return (not right or (left and right)) and (not (left and right) or right)

def the_join_is_associative(first: bool, second: bool, third: bool) -> bool:
    ensure result == true
    return ((first and second) and third) == (first and (second and third))

def the_join_is_idempotent(fact: bool) -> bool:
    ensure result == true
    return model_join_fact(fact, fact) == fact

def a_join_is_below_its_left_predecessor(left: bool, right: bool) -> bool:
    ensure result == true
    return not (left and right) or left

def a_join_is_below_its_right_predecessor(left: bool, right: bool) -> bool:
    ensure result == true
    return not (left and right) or right

def every_common_lower_fact_is_below_the_join(lower: bool, left: bool, right: bool) -> bool:
    requires (not lower or left) and (not lower or right)
    ensure result == true
    return not lower or (left and right)

def the_join_is_monotone(first: bool, larger_first: bool, second: bool, larger_second: bool) -> bool:
    requires (not first or larger_first) and (not second or larger_second)
    ensure result == true
    return not (first and second) or (larger_first and larger_second)

def flag_facts_merge_by_the_same_common_fact_rule(left: bool, right: bool) -> bool:
    ensure result == (left and right)
    return left and right

def stack_alignment_is_known_only_when_both_predecessors_agree(left_known: bool, right_known: bool, same_alignment: bool) -> bool:
    ensure result == (left_known and right_known and same_alignment)
    return left_known and right_known and same_alignment

def an_unknown_or_conflicting_alignment_is_dropped(left_known: bool, right_known: bool, same_alignment: bool) -> bool:
    requires not left_known or not right_known or not same_alignment
    ensure result == true
    return not (left_known and right_known and same_alignment)

def equal_stack_deltas_are_preserved(left: i64, right: i64) -> bool:
    requires left == right
    ensure result == true
    return (left if left == right else 0) == left

def unequal_stack_deltas_reset_to_zero(left: i64, right: i64) -> bool:
    requires left != right
    ensure result == true
    return (left if left == right else 0) == 0
