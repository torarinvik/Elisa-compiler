# Soundness laws for the integer interval shortcuts in aph_provable.
# The companion checker pins these conclusions to the production branches.

def interval_lower_strict_gt_sound(value: i64, lower: i64) -> bool:
    requires value >= lower
    requires lower >= 1
    ensure result == true
    return value > 0

def interval_lower_ge_sound(value: i64, lower: i64) -> bool:
    requires value >= lower
    requires lower >= 0
    ensure result == true
    return value >= 0

def interval_upper_strict_lt_sound(value: i64, upper: i64) -> bool:
    requires value <= upper
    requires upper <= -1
    ensure result == true
    return value < 0

def interval_upper_le_sound(value: i64, upper: i64) -> bool:
    requires value <= upper
    requires upper <= 0
    ensure result == true
    return value <= 0

def singleton_zero_interval_eq_sound(value: i64, lower: i64, upper: i64) -> bool:
    requires value >= lower and value <= upper
    requires lower == 0 and upper == 0
    ensure result == true
    return value == 0

def separated_interval_neq_sound(value: i64, lower: i64, upper: i64) -> bool:
    requires value >= lower and value <= upper
    requires lower >= 1 or upper <= -1
    ensure result == true
    return value != 0
