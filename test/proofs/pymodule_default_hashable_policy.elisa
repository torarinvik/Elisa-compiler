# Source-linked proof for the hashable type allowlist used by PyModule dict/set defaults.
include "../../src/driver/elisac_pymodule_default_hashable_policy.elisa"

def hashable_classifier_matches_the_closed_type_set(type_name: sview) -> bool can[Abort.Panic]:
    ensure when type_name:
        "cstr" | "sview" | "bool" | "f32" | "f64" | "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "char" | "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" -> result == true
        _ -> result == false
    return PymoduleDefaultHashablePolicy::is_python_hashable_type(type_name)

def all_declared_hashable_types_are_accepted() -> bool can[Abort.Panic]:
    ensure result == true
    return (
        PymoduleDefaultHashablePolicy::is_python_hashable_type("cstr")
        and PymoduleDefaultHashablePolicy::is_python_hashable_type("sview")
        and PymoduleDefaultHashablePolicy::is_python_hashable_type("bool")
        and PymoduleDefaultHashablePolicy::is_python_hashable_type("f32")
        and PymoduleDefaultHashablePolicy::is_python_hashable_type("f64")
        and PymoduleDefaultHashablePolicy::is_python_hashable_type("i8")
        and PymoduleDefaultHashablePolicy::is_python_hashable_type("i16")
        and PymoduleDefaultHashablePolicy::is_python_hashable_type("i32")
        and PymoduleDefaultHashablePolicy::is_python_hashable_type("i64")
        and PymoduleDefaultHashablePolicy::is_python_hashable_type("int")
        and PymoduleDefaultHashablePolicy::is_python_hashable_type("isize")
        and PymoduleDefaultHashablePolicy::is_python_hashable_type("char")
        and PymoduleDefaultHashablePolicy::is_python_hashable_type("u8")
        and PymoduleDefaultHashablePolicy::is_python_hashable_type("u16")
        and PymoduleDefaultHashablePolicy::is_python_hashable_type("u32")
        and PymoduleDefaultHashablePolicy::is_python_hashable_type("u64")
        and PymoduleDefaultHashablePolicy::is_python_hashable_type("usize")
        and PymoduleDefaultHashablePolicy::is_python_hashable_type("uintptr")
    )

def nearby_non_hashable_types_are_rejected() -> bool can[Abort.Panic]:
    ensure result == true
    return (
        not PymoduleDefaultHashablePolicy::is_python_hashable_type("dstr")
        and not PymoduleDefaultHashablePolicy::is_python_hashable_type("void")
        and not PymoduleDefaultHashablePolicy::is_python_hashable_type("py::Object")
        and not PymoduleDefaultHashablePolicy::is_python_hashable_type("i128")
    )
