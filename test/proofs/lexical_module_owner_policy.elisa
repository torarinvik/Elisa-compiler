include "../../src/semantic/lexical_module_owner_policy.elisa"

def implementation_matches_the_lexical_prefix_contract(owner: sview, current: sview) -> bool can[Abort.Panic]:
    ensure result == true
    return SemanticLexicalModuleOwnerPolicy::is_lexical(owner, current) == (
        owner == "" or owner == current or (
            current.len >= 2 and
            owner.len <= current.len - 2 and
            current[owner.len] == 58 and
            current[owner.len + 1.usize()] == 58 and
            (forall index in 0..<owner.len:
                owner[index] == current[index]
            )
        )
    )

def empty_owner_is_visible_in_every_scope() -> bool can[Abort.Panic]:
    ensure result == true
    return SemanticLexicalModuleOwnerPolicy::is_lexical("", "Outer::Inner") and
        SemanticLexicalModuleOwnerPolicy::is_lexical("", "")

def exact_and_nested_module_owners_are_visible() -> bool can[Abort.Panic]:
    ensure result == true
    return SemanticLexicalModuleOwnerPolicy::is_lexical("Outer::Inner", "Outer::Inner") and
        SemanticLexicalModuleOwnerPolicy::is_lexical("Outer", "Outer::Inner") and
        SemanticLexicalModuleOwnerPolicy::is_lexical("Outer::Inner", "Outer::Inner::Leaf")

def only_a_two_colon_boundary_extends_a_module_owner() -> bool can[Abort.Panic]:
    ensure result == true
    return not SemanticLexicalModuleOwnerPolicy::is_lexical("Ui", "UiKit::Widgets") and
        not SemanticLexicalModuleOwnerPolicy::is_lexical("Outer", "Outer:Inner") and
        not SemanticLexicalModuleOwnerPolicy::is_lexical("Outer::Inner", "Outer::Inners")

def short_current_namespaces_are_rejected_without_indexing_past_them() -> bool can[Abort.Panic]:
    ensure result == true
    return not SemanticLexicalModuleOwnerPolicy::is_lexical("Outer", "X") and
        not SemanticLexicalModuleOwnerPolicy::is_lexical("Outer", "")
