# Prove the SMT observation pair changes only enable_smt in the Stage1 policy projection.
include "../../src/lexer/tokens.elisa"
include "../../src/lexer/source_view.elisa"
module Semantic:
    private:
        const STAGE1_OPTION_NONINTERFERENCE_PROOF_SCOPE: bool = true

include "../../src/driver/stage1_semantic_option_projection.elisa"

def same_non_smt_options(
    left: Semantic::IncrementalSemanticOptions,
    right: Semantic::IncrementalSemanticOptions
) -> bool:
    ensure result == (
        left.enforce_unsafe_permissions == right.enforce_unsafe_permissions
        and left.flow_strict == right.flow_strict
        and left.runtime_std == right.runtime_std
        and left.flow_warn == right.flow_warn
        and left.warn_discarded == right.warn_discarded
        and left.enforce_progress == right.enforce_progress
        and left.enforce_extern_contracts == right.enforce_extern_contracts
        and left.enforce_raw_unsafe == right.enforce_raw_unsafe
        and left.emit_proof_hole == right.emit_proof_hole
        and left.region_stack_cap == right.region_stack_cap
        and left.enforce_global_permissions == right.enforce_global_permissions
        and left.enforce_mutable_global_grants == right.enforce_mutable_global_grants
        and left.carrier_surface == right.carrier_surface
    )
    return (
        left.enforce_unsafe_permissions == right.enforce_unsafe_permissions
        and left.flow_strict == right.flow_strict
        and left.runtime_std == right.runtime_std
        and left.flow_warn == right.flow_warn
        and left.warn_discarded == right.warn_discarded
        and left.enforce_progress == right.enforce_progress
        and left.enforce_extern_contracts == right.enforce_extern_contracts
        and left.enforce_raw_unsafe == right.enforce_raw_unsafe
        and left.emit_proof_hole == right.emit_proof_hole
        and left.region_stack_cap == right.region_stack_cap
        and left.enforce_global_permissions == right.enforce_global_permissions
        and left.enforce_mutable_global_grants == right.enforce_mutable_global_grants
        and left.carrier_surface == right.carrier_surface
    )

def smt_sources_change_only_the_smt_option(
    strict_header: bool,
    runtime_std_detected: bool,
    strict_externs_environment_enabled: bool,
    strict_externs_header: bool,
    unsafe_header: bool,
    proofhole_header: bool,
    globals_header: bool,
    permissive_environment_enabled: bool,
    carrier_surface_enabled: bool
) -> bool:
    ensure result == true
    no_smt: Semantic::IncrementalSemanticOptions = stage1_semantic_options_from_observations(
        strict_header, runtime_std_detected, false, false,
        strict_externs_environment_enabled, strict_externs_header,
        unsafe_header, proofhole_header, globals_header,
        permissive_environment_enabled, carrier_surface_enabled
    )
    environment_smt: Semantic::IncrementalSemanticOptions = stage1_semantic_options_from_observations(
        strict_header, runtime_std_detected, true, false,
        strict_externs_environment_enabled, strict_externs_header,
        unsafe_header, proofhole_header, globals_header,
        permissive_environment_enabled, carrier_surface_enabled
    )
    header_smt: Semantic::IncrementalSemanticOptions = stage1_semantic_options_from_observations(
        strict_header, runtime_std_detected, false, true,
        strict_externs_environment_enabled, strict_externs_header,
        unsafe_header, proofhole_header, globals_header,
        permissive_environment_enabled, carrier_surface_enabled
    )
    both_smt: Semantic::IncrementalSemanticOptions = stage1_semantic_options_from_observations(
        strict_header, runtime_std_detected, true, true,
        strict_externs_environment_enabled, strict_externs_header,
        unsafe_header, proofhole_header, globals_header,
        permissive_environment_enabled, carrier_surface_enabled
    )
    return (
        not no_smt.enable_smt
        and environment_smt.enable_smt
        and header_smt.enable_smt
        and both_smt.enable_smt
        and same_non_smt_options(no_smt, environment_smt)
        and same_non_smt_options(no_smt, header_smt)
        and same_non_smt_options(no_smt, both_smt)
    )
