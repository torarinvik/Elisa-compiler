# False raw-base and unsupported-address acceptance claims must stay unprovable.
include "./easm_memory_base_policy.elisa"

def raw_integer_base_is_accepted_without_capability() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not EasmMemoryBasePolicy::rejects_direct_raw_base("rax", "i64", false)

def stack_base_is_rejected_by_the_direct_raw_carrier_gate() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return EasmMemoryBasePolicy::rejects_direct_raw_base("rsp", "i64", false)

def pointer_sized_integer_is_treated_as_a_typed_pointer_without_opt_in() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not EasmMemoryBasePolicy::rejects_raw_address_type_without_opt_in("uintptr", false)

def raw_integer_base_is_rejected_even_with_explicit_capability() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return EasmMemoryBasePolicy::rejects_direct_raw_base("rax", "i64", true)

def bracketed_raw_address_is_accepted_as_a_supported_base() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        has_bracket: bool = EasmTextScan::find("[rax+8]", "[") == 0
        return not EasmMemoryBasePolicy::rejects_bracket_address_form(has_bracket)

def unresolved_non_bracket_memory_base_is_accepted() -> bool:
    ensure result == true
    return not EasmMemoryBasePolicy::rejects_unresolved_memory_base(true, true)

def immediate_created_untraced_base_is_allowed_without_capability() -> bool:
    ensure result == true
    return not EasmMemoryBasePolicy::rejects_untraced_raw_base(false, false)
