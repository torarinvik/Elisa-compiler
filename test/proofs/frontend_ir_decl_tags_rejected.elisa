# False node-tag assignments must remain unprovable.
include "../../src/driver/frontend_ir_decl_tags.elisa"

def function_tag_is_the_struct_tag() -> bool:
    ensure result == true
    return FrontendIrDeclarationNodeTags::node_tag(FrontendIrDeclarationNodeTags::NodeKind.FuncDecl) == FrontendIrDeclarationNodeTags::STRUCT_DECL_NODE_TAG

def constant_declaration_uses_global_tag() -> bool:
    ensure result == true
    return FrontendIrDeclarationNodeTags::node_tag(FrontendIrDeclarationNodeTags::NodeKind.ConstDecl) == FrontendIrDeclarationNodeTags::GLOBAL_DECL_NODE_TAG

def function_body_and_name_share_field_id() -> bool:
    ensure result == true
    return FrontendIrDeclarationNodeTags::FUNC_DECL_BODY_FIELD_ID == FrontendIrDeclarationNodeTags::FUNC_DECL_NAME_FIELD_ID
