include "../../src/parser/parser_header_qualification_model.elisa"

def token_at_end_is_present(token_count: usize) -> bool:
    ensure result == true
    return ParserHeaderQualification::has_token(token_count, token_count)

def offset_at_remaining_end_is_accepted(position: usize, token_count: usize) -> bool:
    requires position < token_count
    ensure result == true
    return ParserHeaderQualification::offset_is_in_range(position, token_count, token_count - position)

def prior_token_qualifies_a_nonzero_offset_without_neighbor(offset: usize) -> bool:
    requires offset > 0
    ensure result == true
    return ParserHeaderQualification::qualified_by_neighbors(offset, false, false, true)

def relative_previous_scope_qualifies_at_offset_zero() -> bool:
    ensure result == true
    return ParserHeaderQualification::qualified_by_neighbors(0, false, true, false)
