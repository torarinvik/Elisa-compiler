# Interning a function type uses the pre-append return-pool count as its slot,
# then stores that slot in ValueType.bits (u32). The source guard bounds the
# count by MAX_FN_TYPE_SLOT before either pool append.
const MAX_FN_TYPE_SLOT: i64 = 4294967295

def appended_function_type_slot_is_representable(previous_count: i64) -> bool:
    requires previous_count >= 0 and previous_count <= MAX_FN_TYPE_SLOT
    ensure result == true
    next_count: i64 = previous_count + 1
    new_slot: i64 = next_count - 1
    return next_count == previous_count + 1 and new_slot == previous_count and new_slot <= MAX_FN_TYPE_SLOT and new_slot < next_count

def final_representable_slot_is_admitted(previous_count: i64) -> bool:
    requires previous_count == MAX_FN_TYPE_SLOT
    ensure result == true
    next_count: i64 = previous_count + 1
    new_slot: i64 = next_count - 1
    return new_slot == MAX_FN_TYPE_SLOT and new_slot < next_count

def first_unrepresentable_slot_is_rejected(previous_count: i64) -> bool:
    requires previous_count == MAX_FN_TYPE_SLOT + 1
    ensure result == true
    return not (previous_count <= MAX_FN_TYPE_SLOT)
