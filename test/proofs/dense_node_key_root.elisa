# Source-bound decision rules for checking that a recorded dense key indexes
# the same syntactic frozen-store root and member from which it was constructed.
def dense_node_key_root_mismatch(key_root: sview, key_member: sview, store_root: sview, store_member: sview, store_root_is_node_table: bool) -> bool:
    ensure result == (store_root != "" and (store_root != key_root or store_member != key_member) and not (store_root_is_node_table and store_member == ""))
    return store_root != "" and (store_root != key_root or store_member != key_member) and not (store_root_is_node_table and store_member == "")

def same_dense_key_store_path_is_accepted(key_root: sview, key_member: sview, store_root: sview, store_member: sview, store_root_is_node_table: bool) -> bool:
    requires key_root == store_root and key_member == store_member and store_root != ""
    ensure result == false
    return dense_node_key_root_mismatch(key_root, key_member, store_root, store_member, store_root_is_node_table)

def a_different_store_root_is_rejected(key_root: sview, key_member: sview, store_root: sview, store_member: sview, store_root_is_node_table: bool) -> bool:
    requires key_root != "" and store_root != "" and key_root != store_root
    requires not (store_root_is_node_table and store_member == "")
    ensure result == true
    return dense_node_key_root_mismatch(key_root, key_member, store_root, store_member, store_root_is_node_table)

def a_different_member_on_the_same_root_is_rejected(key_root: sview, key_member: sview, store_root: sview, store_member: sview, store_root_is_node_table: bool) -> bool:
    requires key_root == store_root and key_root != "" and key_member != store_member
    requires not (store_root_is_node_table and store_member == "")
    ensure result == true
    return dense_node_key_root_mismatch(key_root, key_member, store_root, store_member, store_root_is_node_table)

def root_node_table_handle_is_exempt(key_root: sview, key_member: sview, store_root: sview) -> bool:
    requires key_root != store_root and store_root != ""
    ensure result == false
    return dense_node_key_root_mismatch(key_root, key_member, store_root, "", true)

def dense_key_origin_counts_remain_aligned_after_one_append(key_count: u64, root_count: u64, member_count: u64) -> bool:
    requires key_count == root_count and root_count == member_count
    requires key_count < 18446744073709551615.u64()
    ensure result == true
    key_after: u64 = key_count + 1.u64()
    root_after: u64 = root_count + 1.u64()
    member_after: u64 = member_count + 1.u64()
    return key_after == root_after and root_after == member_after

def found_dense_key_slot_is_in_bounds_for_both_origin_rows(slot: u64, key_count: u64, root_count: u64, member_count: u64) -> bool:
    requires slot < key_count
    requires key_count == root_count and root_count == member_count
    ensure result == true
    return slot < root_count and slot < member_count

def latest_dense_key_slot_model(names: darray[sview]&, wanted: sview) -> (found: bool, index: usize):
    ensures result.found implies result.index < names.count
    ensures result.found implies names[result.index] == wanted
    ensures result.found implies (forall later in result.index + 1.usize()..<names.count: names[later] != wanted)
    ensures not result.found implies (forall candidate in 0..<names.count: names[candidate] != wanted)
    index: mutable usize = names.count
    while index > 0.usize() |index, names, wanted|:
        decreases index
        invariant index <= names.count
        invariant forall later in index..<names.count: names[later] != wanted
        index <- index - 1.usize()
        return (true, index) if names[index] == wanted
    return (false, 0.usize())

def newest_recorded_dense_key_origin_wins(old_root: sview, new_root: sview) -> bool:
    requires old_root != new_root
    ensures result == true
    names: darray[sview] = ["key", "key"]
    roots: darray[sview] = [old_root, new_root]
    selected: (found: bool, index: usize) = latest_dense_key_slot_model(names, "key")
    return false if:
        not selected.found
        selected.index >= roots.count
    return selected.index == 1.usize() and roots[selected.index] == new_root
