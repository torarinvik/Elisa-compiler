# OPEN: source summary Boolean conjunction needs disequality transport.
# Do not count these laws as admitted until producer and replay both prove them.
include "../../src/semantic/binding_identity_types.elisa"
include "../../src/semantic/ownership_flow_domain.elisa"
include "../../src/semantic/ownership_binding_flow.elisa"

def distinct_serials_remain_distinct(left: u64, right: u64) -> bool:
    requires left != right
    ensure result == false
    return Semantic::ownership_binding_ids_equal(Semantic::BindingId{owner: Semantic::DeclId{value: 7}, serial: left}, Semantic::BindingId{owner: Semantic::DeclId{value: 7}, serial: right})

def distinct_functions_remain_distinct(left: u32, right: u32) -> bool:
    requires left != right
    ensure result == false
    return Semantic::ownership_binding_ids_equal(Semantic::BindingId{owner: Semantic::DeclId{value: left}, serial: 0}, Semantic::BindingId{owner: Semantic::DeclId{value: right}, serial: 0})

def distinct_serials_renamed(first: u64, second: u64) -> bool:
    requires first != second
    ensure result == false
    return Semantic::ownership_binding_ids_equal(Semantic::BindingId{owner: Semantic::DeclId{value: 7}, serial: first}, Semantic::BindingId{owner: Semantic::DeclId{value: 7}, serial: second})
