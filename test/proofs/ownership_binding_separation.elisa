# Admitted by check_ownership_binding_identity.py with independent replay.
# The renamed counterpart detects caller/callee substitution capture regressions.
include "../../src/semantic/binding_identity_types.elisa"
include "../../src/semantic/ownership_flow_domain.elisa"
include "../../src/semantic/ownership_binding_flow.elisa"

const EXAMPLE_DECL_ID: u32 = 7
const FIRST_BINDING_SERIAL: u64 = Semantic::FIRST_BINDING_SERIAL

def distinct_serials_remain_distinct(left: u64, right: u64) -> bool:
    requires left != right
    ensure result == false
    return Semantic::ownership_binding_ids_equal(Semantic::BindingId{owner: Semantic::DeclId{value: EXAMPLE_DECL_ID},
        serial: left},
        Semantic::BindingId{owner: Semantic::DeclId{value: EXAMPLE_DECL_ID},
        serial: right})

def distinct_functions_remain_distinct(left: u32, right: u32) -> bool:
    requires left != right
    ensure result == false
    return Semantic::ownership_binding_ids_equal(Semantic::BindingId{owner: Semantic::DeclId{value: left},
        serial: FIRST_BINDING_SERIAL},
        Semantic::BindingId{owner: Semantic::DeclId{value: right},
        serial: FIRST_BINDING_SERIAL})

def distinct_serials_renamed(first: u64, second: u64) -> bool:
    requires first != second
    ensure result == false
    return Semantic::ownership_binding_ids_equal(Semantic::BindingId{owner: Semantic::DeclId{value: EXAMPLE_DECL_ID},
        serial: first},
        Semantic::BindingId{owner: Semantic::DeclId{value: EXAMPLE_DECL_ID},
        serial: second})
