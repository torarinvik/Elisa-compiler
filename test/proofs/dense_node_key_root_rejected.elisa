# False claims about dense NodeKey roots must remain unprovable.
include "./dense_node_key_root.elisa"

def a_different_store_root_is_accepted() -> bool:
    ensure result == true
    return not dense_node_key_root_mismatch("left", "", "right", "", false)

def an_exact_store_path_is_rejected() -> bool:
    ensure result == true
    return dense_node_key_root_mismatch("left", "field", "left", "field", false)

def a_root_node_table_key_is_reported_as_mismatched() -> bool:
    ensure result == true
    return dense_node_key_root_mismatch("left", "", "node_table", "", true)

def synchronized_origin_appends_can_diverge(key_count: u64, root_count: u64, member_count: u64) -> bool:
    requires key_count == root_count and root_count == member_count
    requires key_count < 18446744073709551615.u64()
    ensure result == true
    key_after: u64 = key_count + 1.u64()
    root_after: u64 = root_count + 1.u64()
    member_after: u64 = member_count + 1.u64()
    return key_after != root_after or root_after != member_after

def a_found_dense_key_slot_can_exceed_an_origin_row(slot: u64, key_count: u64, root_count: u64, member_count: u64) -> bool:
    requires slot < key_count
    requires key_count == root_count and root_count == member_count
    ensure result == true
    return slot >= root_count or slot >= member_count

def an_older_dense_key_origin_wins_over_the_latest() -> bool:
    ensure result == true
    names: darray[sview] = ["key", "key"]
    selected: (found: bool, index: usize) = latest_dense_key_slot_model(names, "key")
    return selected.found and selected.index == 0.usize()

def a_present_dense_key_origin_is_reported_missing() -> bool:
    ensure result == true
    names: darray[sview] = ["key"]
    selected: (found: bool, index: usize) = latest_dense_key_slot_model(names, "key")
    return not selected.found
