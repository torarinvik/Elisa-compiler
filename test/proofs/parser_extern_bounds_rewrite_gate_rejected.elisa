include "./parser_extern_bounds_rewrite_gate.elisa"

def false_claim_failed_validation_can_rewrite(failed: bool, no_valid_pairs: bool) -> bool:
    requires failed
    ensure result == true
    return not (failed or no_valid_pairs)

def false_claim_reference_length_parameter_is_valid(is_ref: bool, is_integer_type: bool) -> bool:
    requires is_ref
    ensure result == true
    return not is_ref and is_integer_type
