# Source-linked lemmas for the capacity expression parser's precedence-climbing loop.
include "../../src/backend/codegen_const_capacity_precedence.elisa"

def capacity_precedence_levels_are_strictly_ordered(comparison: i64, bitwise_or: i64, bitwise_xor: i64, bitwise_and: i64, shift: i64, additive: i64, multiplicative: i64) -> bool:
    requires comparison == 0 and bitwise_or == 1 and bitwise_xor == 2 and bitwise_and == 3 and shift == 4 and additive == 5 and multiplicative == 6
    ensure result == true
    return comparison < bitwise_or and bitwise_or < bitwise_xor and bitwise_xor < bitwise_and and bitwise_and < shift and shift < additive and additive < multiplicative

def capacity_levels_match_main_parser_offset(precedence: i64) -> bool:
    requires precedence >= 0 and precedence <= 6
    ensure result == true
    main_precedence: i64 = precedence + 3
    return (
        main_precedence == precedence + 3
        and main_precedence >= 3
        and main_precedence <= 9
    )

def translated_capacity_order_matches_main_parser(lower: i64, higher: i64) -> bool:
    requires lower >= 0 and lower <= 6
    requires higher > lower and higher <= 6
    ensure result == true
    lower_main: i64 = lower + 3
    higher_main: i64 = higher + 3
    return lower_main < higher_main

def equal_precedence_operator_is_excluded_from_right_operand(precedence: i64) -> bool:
    requires precedence >= 0 and precedence <= 6
    ensure result == true
    return precedence < precedence + 1

def tighter_operator_is_admitted_inside_right_operand(outer: i64, inner: i64) -> bool:
    requires outer >= 0 and outer <= 6
    requires inner > outer and inner <= 6
    ensure result == true
    return inner >= outer + 1

def weaker_operator_is_stopped_by_right_operand(outer: i64, inner: i64) -> bool:
    requires outer >= 0 and outer <= 6
    requires inner < outer
    ensure result == true
    return inner < outer + 1

def unsupported_operator_stops_before_cursor_advance(minimum: i64) -> bool:
    requires minimum >= 0
    ensure result == true
    return -1 < minimum

def unconsumed_capacity_suffix_has_positive_length(cursor: i64, length: i64) -> bool:
    requires cursor >= 0 and cursor < length
    ensure result == true
    return length - cursor > 0
