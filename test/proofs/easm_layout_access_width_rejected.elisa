include "./easm_layout_access_width.elisa"

def false_mismatched_positive_width_allows_access(declared_width: i64, access_width: i64) -> bool:
    requires declared_width > 0 and access_width >= 0 and declared_width != access_width
    ensure result == true
    return layout_access_width_is_valid(declared_width, access_width)
