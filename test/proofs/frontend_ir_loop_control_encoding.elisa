# Source-linked proofs for representable loop-control statement encodings.
include "../../src/driver/frontend_ir_loop_control_encoding.elisa"

const EXPECTED_BREAK_STMT_NODE_TYPE_ID: u32 = 19
const EXPECTED_CONTINUE_STMT_NODE_TYPE_ID: u32 = 34
const EXPECTED_LOOP_CONTROL_POSITION_FIELD_ID: u32 = 1

def source_loop_control_node_type_id_is_exact(kind: FrontendIrLoopControlEncoding::LoopControlKind) -> u32:
    ensure kind != FrontendIrLoopControlEncoding::LoopControlKind.Break or result == EXPECTED_BREAK_STMT_NODE_TYPE_ID
    ensure kind != FrontendIrLoopControlEncoding::LoopControlKind.Continue or result == EXPECTED_CONTINUE_STMT_NODE_TYPE_ID
    return FrontendIrLoopControlEncoding::node_type_id(kind)

def source_loop_control_position_field_id_is_exact(kind: FrontendIrLoopControlEncoding::LoopControlKind) -> u32:
    ensure kind != FrontendIrLoopControlEncoding::LoopControlKind.Break or result == EXPECTED_LOOP_CONTROL_POSITION_FIELD_ID
    ensure kind != FrontendIrLoopControlEncoding::LoopControlKind.Continue or result == EXPECTED_LOOP_CONTROL_POSITION_FIELD_ID
    return FrontendIrLoopControlEncoding::position_field_id(kind)

def source_loop_control_label_is_unlabeled_exact(label: sview) -> bool:
    ensure result == (label.len == 0)
    return FrontendIrLoopControlEncoding::label_is_unlabeled(label)

def every_nonempty_loop_control_label_is_rejected(label: sview) -> bool:
    requires label.len > 0
    ensure result == true
    return not FrontendIrLoopControlEncoding::label_is_unlabeled(label)

def break_and_continue_node_tags_are_distinct() -> bool:
    ensure result == true
    return (
        FrontendIrLoopControlEncoding::node_type_id(FrontendIrLoopControlEncoding::LoopControlKind.Break)
        != FrontendIrLoopControlEncoding::node_type_id(FrontendIrLoopControlEncoding::LoopControlKind.Continue)
    )

def shared_position_slot_keeps_distinct_loop_control_nodes() -> bool:
    ensure result == true
    return (
        FrontendIrLoopControlEncoding::position_field_id(FrontendIrLoopControlEncoding::LoopControlKind.Break)
            == EXPECTED_LOOP_CONTROL_POSITION_FIELD_ID
        and FrontendIrLoopControlEncoding::position_field_id(FrontendIrLoopControlEncoding::LoopControlKind.Continue)
            == EXPECTED_LOOP_CONTROL_POSITION_FIELD_ID
        and FrontendIrLoopControlEncoding::node_type_id(FrontendIrLoopControlEncoding::LoopControlKind.Break)
            != FrontendIrLoopControlEncoding::node_type_id(FrontendIrLoopControlEncoding::LoopControlKind.Continue)
    )
