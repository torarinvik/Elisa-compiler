# Noalias is an optimization contract only for compiler-controlled internal calls.
const LLVM_INTERNAL_LINKAGE: u32 = 8
const LLVM_PRIVATE_LINKAGE: u32 = 9

def external_linkage_requires_noalias_removal(linkage: u32) -> bool:
    ensure result == (linkage != LLVM_INTERNAL_LINKAGE and linkage != LLVM_PRIVATE_LINKAGE)
    return linkage != LLVM_INTERNAL_LINKAGE and linkage != LLVM_PRIVATE_LINKAGE

def internal_linkage_keeps_the_noalias_contract(linkage: u32) -> bool:
    requires linkage == LLVM_INTERNAL_LINKAGE or linkage == LLVM_PRIVATE_LINKAGE
    ensure result == true
    return not (linkage != LLVM_INTERNAL_LINKAGE and linkage != LLVM_PRIVATE_LINKAGE)

def parameter_enum_attribute_index_is_one_based(offset: u64, parameter_count: u64) -> bool:
    requires parameter_count <= 4294967295
    requires offset < parameter_count
    ensure result == true
    return offset + 1 > 0 and offset + 1 <= parameter_count

def removal_index_never_names_the_function_attribute(offset: u64, parameter_count: u64) -> bool:
    requires parameter_count <= 4294967295
    requires offset < parameter_count
    ensure result == true
    return offset + 1 != 0

