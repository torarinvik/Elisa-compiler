include "./pymodule_default_scalar_type_policy.elisa"

def i128_must_be_a_signed_integer_type() -> bool:
    ensure result == true
    return PymoduleDefaultScalarTypePolicy::is_signed_integer_type_name("i128")

def f16_must_be_a_float_type() -> bool:
    ensure result == true
    return PymoduleDefaultScalarTypePolicy::is_float_type_name("f16")

def cstr_optional_must_be_a_text_type() -> bool:
    ensure result == true
    return PymoduleDefaultScalarTypePolicy::is_text_type_name("cstr?")

def i8_must_be_an_unsigned_integer_type() -> bool:
    ensure result == true
    return PymoduleDefaultScalarTypePolicy::is_unsigned_integer_type_name("i8")
