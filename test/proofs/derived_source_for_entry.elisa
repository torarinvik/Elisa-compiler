include "../../src/semantic/ownership_flow_domain.elisa"

# Entry-path admission laws only. The range recognizer and AST transfer are not proved.
def for_state_possible(proven_nonempty: bool, entry: bool, body: bool, jump: bool) -> bool:
    ensure result == (((not proven_nonempty and entry) or body) or jump)
    return OwnershipFlow::join_possible(OwnershipFlow::join_reachable_possible(not proven_nonempty, entry, true, body), jump)

def unknown_count_retains_entry(body: bool, jump: bool) -> bool:
    ensure result == true
    return for_state_possible(false, true, body, jump)

def nonempty_excludes_zero_entry(entry: bool, body: bool, jump: bool) -> bool:
    ensure result == (body or jump)
    return for_state_possible(true, entry, body, jump)

def singleton_uses_transferred_state(body: bool) -> bool:
    ensure result == body
    return for_state_possible(true, false, body, false)

def reachable_break_state_survives(proven_nonempty: bool, entry: bool, body: bool) -> bool:
    ensure result == true
    return for_state_possible(proven_nonempty, entry, body, true)

def zero_iteration_only_preserves_entry(entry: bool) -> bool:
    ensure result == entry
    return for_state_possible(false, entry, false, false)

def absent_state_is_not_created(proven_nonempty: bool) -> bool:
    ensure result == false
    return for_state_possible(proven_nonempty, false, false, false)
