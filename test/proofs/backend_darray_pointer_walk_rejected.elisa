# These controls must not prove: pointer-walk dispatch excludes these cases.
include "./backend_darray_pointer_walk.elisa"

def fixed_array_source_can_use_pointer_walk() -> bool:
    ensure result == true
    return pointer_walk_eligible(true, true, false, false, false, true, true)

def mutable_binding_can_use_pointer_walk() -> bool:
    ensure result == true
    return pointer_walk_eligible(true, true, true, false, false, false, true)

def reversed_iteration_can_use_pointer_walk() -> bool:
    ensure result == true
    return pointer_walk_eligible(true, true, false, true, false, false, true)

def draining_source_can_use_pointer_walk() -> bool:
    ensure result == true
    return pointer_walk_eligible(true, true, false, false, true, false, true)

def aggregate_element_can_use_pointer_walk() -> bool:
    ensure result == true
    return pointer_walk_eligible(true, true, false, false, false, false, false)

def temporary_source_can_use_pointer_walk() -> bool:
    ensure result == true
    return pointer_walk_eligible(true, false, false, false, false, false, true)
