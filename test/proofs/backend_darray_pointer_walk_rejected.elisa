# These controls must not prove: pointer-walk dispatch excludes these cases.
include "./backend_darray_pointer_walk.elisa"

def borrowed_ref_to_non_darray_is_eligible() -> bool:
    ensure result == true
    return named_darray_binding_source_accepts_local_or_borrowed_darray(true, false, true, false)

def temporary_ref_source_is_eligible() -> bool:
    ensure result == true
    return named_darray_binding_source_accepts_local_or_borrowed_darray(false, false, true, true)

def fixed_array_source_can_use_pointer_walk() -> bool:
    ensure result == true
    return pointer_walk_eligible(true, true, true, false, false, false, true, true)

def mutable_binding_can_use_pointer_walk() -> bool:
    ensure result == true
    return pointer_walk_eligible(true, true, true, true, false, false, false, true)

def reversed_iteration_can_use_pointer_walk() -> bool:
    ensure result == true
    return pointer_walk_eligible(true, true, true, false, true, false, false, true)

def draining_source_can_use_pointer_walk() -> bool:
    ensure result == true
    return pointer_walk_eligible(true, true, true, false, false, true, false, true)

def aggregate_element_can_use_pointer_walk() -> bool:
    ensure result == true
    return pointer_walk_eligible(true, true, true, false, false, false, false, false)

def temporary_source_can_use_pointer_walk() -> bool:
    ensure result == true
    return pointer_walk_eligible(true, false, true, false, false, false, false, true)

def helper_call_body_can_use_pointer_walk() -> bool:
    ensure result == true
    return pointer_walk_eligible(true, true, false, false, false, false, false, true)

def direct_source_write_body_can_use_pointer_walk() -> bool:
    ensure result == true
    return pointer_walk_eligible(true, true, false, false, false, false, false, true)

def multi_statement_body_can_use_pointer_walk() -> bool:
    ensure result == true
    return pointer_walk_eligible(true, true, false, false, false, false, false, true)
