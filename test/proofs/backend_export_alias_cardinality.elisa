def one_ready_instance_is_resolved(match_count: i64, found_index: i64) -> bool:
    requires match_count == 1 and found_index >= 0
    ensure result == true
    return match_count == 1 and found_index >= 0

def zero_matching_instances_are_declined(match_count: i64, found_index: i64) -> bool:
    requires match_count == 0
    ensure result == false
    return match_count == 1 and found_index >= 0

def multiple_matching_instances_are_declined(match_count: i64, found_index: i64) -> bool:
    requires match_count > 1
    ensure result == false
    return match_count == 1 and found_index >= 0

def invalid_instance_index_is_declined(match_count: i64, found_index: i64) -> bool:
    requires match_count == 1 and found_index < 0
    ensure result == false
    return match_count == 1 and found_index >= 0
