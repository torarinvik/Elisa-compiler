include "./backend_cabi_leaf_kind.elisa"

def false_llvm_half_is_supported_leaf(llvm_kind: i64) -> bool:
    requires llvm_kind == 1
    ensure result
    return llvm_kind == 2 or llvm_kind == 3 or llvm_kind == 8 or llvm_kind == 12

def false_x86_fp80_is_supported_leaf(llvm_kind: i64) -> bool:
    requires llvm_kind == 4
    ensure result
    return llvm_kind == 2 or llvm_kind == 3 or llvm_kind == 8 or llvm_kind == 12

def false_struct_kind_is_supported_scalar_leaf(llvm_kind: i64) -> bool:
    requires llvm_kind == 10
    ensure result
    return llvm_kind == 2 or llvm_kind == 3 or llvm_kind == 8 or llvm_kind == 12
