# Source-linked proof of the exact builtin mutator set used by value threading.
include "../../src/parser/ast_value_thread_mutating_method.elisa"

def source_mutating_method_matches_exact_set(method: sview) -> bool:
    ensure result == (
        when method:
            "push" | "pop" | "insert" | "remove" | "clear" | "extend" | "resize" -> true
            "truncate" | "put" | "reserve" | "append" | "add" | "discard" -> true
            "sort" | "reverse" | "swap" | "fill" | "push_front" | "pop_front" -> true
            "retain" | "drain" -> true
            _ -> false
    )
    return AstValueThreadMutatingMethod::is_mutating_method(method)

def known_mutating_method_is_recognized() -> bool:
    ensure result == true
    return AstValueThreadMutatingMethod::is_mutating_method("push")
