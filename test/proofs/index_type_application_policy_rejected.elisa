include "./index_type_application_policy.elisa"

def ordinary_index_is_a_type_argument_operator() -> bool:
    ensure result == true
    return SemanticIndexTypeApplicationPolicy::field_name_is_type_argument("index")

def specialize_is_a_value_index_operator() -> bool:
    ensure result == true
    return not SemanticIndexTypeApplicationPolicy::field_name_is_type_argument("specialize")

def constant_declaration_can_supply_type_arguments() -> bool:
    ensure result == true
    return SemanticIndexTypeApplicationPolicy::candidate_declaration_matches(true, false, false, false, false)

def differently_named_function_can_supply_type_arguments() -> bool:
    ensure result == true
    return SemanticIndexTypeApplicationPolicy::candidate_declaration_matches(false, true, false, false, false)
