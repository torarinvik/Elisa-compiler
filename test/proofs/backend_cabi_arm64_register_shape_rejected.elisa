include "./backend_cabi_arm64_register_shape.elisa"

def false_seventeen_bytes_use_two_registers(size: i64, hfa_count: i64) -> i64:
    requires size == 17 and hfa_count == 0
    ensure result == 2
    return hfa_count

def false_large_hfa_uses_indirect_shape(size: i64, hfa_count: i64) -> i64:
    requires size == 24 and hfa_count == 3
    ensure result == 3
    return size

def false_sixteen_bytes_use_sret(size: i64, hfa_count: i64) -> i64:
    requires size == 16 and hfa_count == 0
    ensure result == 3
    return hfa_count
