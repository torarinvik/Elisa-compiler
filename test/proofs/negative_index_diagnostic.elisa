# Source-linked numeric laws for the NegativeIndex diagnostic payload.
include "../../src/semantic/negative_index_diagnostic.elisa"

def unary_minus_zero_is_not_a_negative_index() -> bool:
    ensure result == true
    return not NegativeIndexDiagnostic::unary_minus_has_negative_index(0)

def unary_minus_positive_literal_is_a_negative_index(value: i64) -> bool:
    requires value > 0
    ensure result == true
    return NegativeIndexDiagnostic::unary_minus_has_negative_index(value)

def every_representable_negative_magnitude_is_exact(index: i64) -> bool:
    requires index < 0 and index >= (0 - 4294967295)
    ensure result == true
    return NegativeIndexDiagnostic::reported_magnitude(index).i64() == (0 - index)

def every_unrepresentable_negative_magnitude_saturates(index: i64) -> bool:
    requires index < (0 - 4294967295)
    ensure result == true
    return NegativeIndexDiagnostic::reported_magnitude(index).i64() == 4294967295

def exact_u32_max_magnitude_is_not_marked_as_saturated() -> bool:
    ensure result == true
    return not NegativeIndexDiagnostic::magnitude_exceeds_reported_range(0 - 4294967295)

def unrepresentable_magnitude_is_marked_for_the_renderer(index: i64) -> bool:
    requires index < (0 - 4294967295)
    ensure result == true
    return NegativeIndexDiagnostic::magnitude_exceeds_reported_range(index)

def u32_max_negative_index_is_reported_exactly() -> bool:
    ensure result == true
    return NegativeIndexDiagnostic::reported_magnitude(0 - 4294967295).i64() == 4294967295

def one_beyond_u32_negative_index_saturates() -> bool:
    ensure result == true
    return NegativeIndexDiagnostic::reported_magnitude(0 - 4294967296).i64() == 4294967295

def i64_min_negative_index_saturates_without_negation() -> bool:
    ensure result == true
    return NegativeIndexDiagnostic::reported_magnitude(0 - 9223372036854775807 - 1).i64() == 4294967295

def i64_min_negative_index_is_marked_for_the_renderer() -> bool:
    ensure result == true
    return NegativeIndexDiagnostic::magnitude_exceeds_reported_range(0 - 9223372036854775807 - 1)
