# Deliberately false label claims must be rejected by the source-linked proof checker.
include "../../src/semantic/binding_identity_types.elisa"
include "../../src/semantic/never_leak_codes.elisa"
include "../../src/driver/never_leak_report_names.elisa"

def chain_category_is_plain() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return NeverLeakReportNames::category_name(Semantic::NEVER_LEAK_CHAIN) == "plain"

def accumulator_escape_is_written_after() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return NeverLeakReportNames::accumulator_reason_name(Semantic::NEVER_LEAK_ACC_ESCAPES) == "-written-after"

def borrowed_field_is_global() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return NeverLeakReportNames::value_thread_reason_name(Semantic::NEVER_LEAK_VT_BORROWED_FIELD) == "-global"
