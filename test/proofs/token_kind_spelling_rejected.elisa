include "./token_kind_spelling.elisa"

def rangele_is_reported_as_semicolon() -> bool:
    ensure result == true
    return token_kind_display_name(emit_tokens_kind_code(TokenKind.RangeLe) - 1) == ";"

def owned_shares_the_rangele_code() -> bool:
    ensure result == true
    return emit_tokens_kind_code(TokenKind.Owned) == emit_tokens_kind_code(TokenKind.RangeLe)
