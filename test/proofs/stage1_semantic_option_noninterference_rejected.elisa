include "./stage1_semantic_option_noninterference.elisa"

def an_environment_smt_switch_also_enables_strict_flow() -> bool:
    ensure result == true
    options: Semantic::IncrementalSemanticOptions = stage1_semantic_options_from_observations(
        false, false, true, false,
        false, false, false, false, false, false, false
    )
    return options.enable_smt and options.flow_strict

def a_header_smt_switch_is_ignored() -> bool:
    ensure result == true
    options: Semantic::IncrementalSemanticOptions = stage1_semantic_options_from_observations(
        false, false, false, true,
        false, false, false, false, false, false, false
    )
    return not options.enable_smt
