include "./linear_mul_overflow.elisa"

def false_positive_product_passes_bound(left: i64, right: i64) -> bool:
    requires left > 0 and right > 0 and left > I64_MAX / right
    ensure result == true
    return left <= I64_MAX / right

def false_positive_negative_product_passes_bound(left: i64, right: i64) -> bool:
    requires left > 0 and right < 0 and right < I64_MIN / left
    ensure result == true
    return right >= I64_MIN / left

def false_negative_positive_product_passes_bound(left: i64, right: i64) -> bool:
    requires left < 0 and right > 0 and left < I64_MIN / right
    ensure result == true
    return left >= I64_MIN / right

def false_negative_product_passes_bound(left: i64, right: i64) -> bool:
    requires left < 0 and right < 0 and left < I64_MAX / right
    ensure result == true
    return left >= I64_MAX / right

def false_claim_minimum_left_product_is_safe(left: i64, right: i64) -> bool:
    requires left == (0 - I64_MAX - 1) and right == (0 - 1)
    ensure result == true
    return left != (0 - I64_MAX - 1)

def false_claim_minimum_right_product_is_safe(left: i64, right: i64) -> bool:
    requires left == (0 - 1) and right == (0 - I64_MAX - 1)
    ensure result == true
    return right != (0 - I64_MAX - 1)
