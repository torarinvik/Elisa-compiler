# The production three-byte decoder's raw-byte guards imply scalar bounds and
# exclude the UTF-16 surrogate interval before returning a decoded codepoint.
include "../../src/lexer/lexer_utf8_codepoint_constants.elisa"
include "../../src/lexer/lexer_utf8_codepoint_wide.elisa"

def valid_three_byte_sequence_decodes_to_non_surrogate_scalar(first: i64, second: i64, third: i64) -> bool:
    requires first >= UTF8_THREE_BYTE_LEAD_MIN and first <= UTF8_THREE_BYTE_LEAD_MAX
    requires second >= UTF8_CONTINUATION_MIN and second <= UTF8_CONTINUATION_MAX
    requires third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX
    requires first > UTF8_THREE_BYTE_LEAD_MIN or second >= UTF8_E0_SECOND_MIN
    requires first != UTF8_SURROGATE_LEAD or second <= UTF8_ED_SECOND_MAX
    decoded: i64 = lexer_decode_utf8_three(first - UTF8_THREE_BYTE_LEAD_MIN, second - UTF8_CONTINUATION_MIN, third - UTF8_CONTINUATION_MIN)
    ensure result == (decoded >= UTF8_THREE_BYTE_SCALAR_MIN and decoded <= UTF8_THREE_BYTE_SCALAR_MAX and (decoded < UNICODE_SURROGATE_MIN or decoded > UNICODE_SURROGATE_MAX))
    ensure result implies decoded >= UTF8_THREE_BYTE_SCALAR_MIN
    ensure result implies decoded <= UTF8_THREE_BYTE_SCALAR_MAX
    ensure result implies (decoded < UNICODE_SURROGATE_MIN or decoded > UNICODE_SURROGATE_MAX)
    return decoded >= UTF8_THREE_BYTE_SCALAR_MIN and decoded <= UTF8_THREE_BYTE_SCALAR_MAX and (decoded < UNICODE_SURROGATE_MIN or decoded > UNICODE_SURROGATE_MAX)
