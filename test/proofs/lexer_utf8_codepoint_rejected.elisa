include "../../src/lexer/lexer_utf8_codepoint_constants.elisa"
include "../../src/lexer/lexer_utf8_codepoint_wide.elisa"

# E0 A0 80 decodes to U+0800; the strict-below-minimum claim is false.
def a_valid_three_byte_sequence_cannot_decode_below_minimum() -> bool:
    ensure result == false
    return 32 * 64 < 2048

# F4 8F BF BF decodes to U+10FFFF; the above-maximum claim is false.
def a_valid_four_byte_sequence_cannot_decode_above_maximum() -> bool:
    ensure result == false
    return 4 * 262144 + 15 * 4096 + 63 * 64 + 63 > 1114111
