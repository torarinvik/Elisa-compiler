include "./backend_call_declared_arity.elisa"

def false_defaulted_call_uses_supplied_count(fixed_arguments: i64, supplied_arguments: i64) -> i64:
    requires fixed_arguments >= 0 and supplied_arguments >= 0 and supplied_arguments < fixed_arguments
    ensure result == fixed_arguments
    return supplied_arguments

def false_error_call_omits_hidden_parameter(fixed_arguments: i64) -> i64:
    requires fixed_arguments >= 0
    ensure result == fixed_arguments + 1
    return fixed_arguments

def false_c_view_split_omitted(fixed_arguments: i64, split_views: i64) -> i64:
    requires fixed_arguments >= 0 and split_views >= 1
    ensure result == fixed_arguments + split_views
    return fixed_arguments
