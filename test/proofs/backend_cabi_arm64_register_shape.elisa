# Arm64 aggregate ABI representation: HFA, one integer register, two integer
# registers, or indirect result/argument, in that priority order.
def arm64_aggregate_register_shape(size: i64, hfa_count: i64) -> i64:
    requires size >= 0 and hfa_count >= 0
    ensure result == (0 if hfa_count > 0 else 1 if size <= 8 else 2 if size <= 16 else 3)
    return 0 if hfa_count > 0 else 1 if size <= 8 else 2 if size <= 16 else 3

def arm64_eight_byte_nonhfa_shape(size: i64, hfa_count: i64) -> i64:
    requires size == 8 and hfa_count == 0
    ensure result == 1
    return 0 if hfa_count > 0 else 1 if size <= 8 else 2 if size <= 16 else 3

def arm64_sixteen_byte_nonhfa_shape(size: i64, hfa_count: i64) -> i64:
    requires size == 16 and hfa_count == 0
    ensure result == 2
    return 0 if hfa_count > 0 else 1 if size <= 8 else 2 if size <= 16 else 3

def arm64_seventeen_byte_nonhfa_shape(size: i64, hfa_count: i64) -> i64:
    requires size == 17 and hfa_count == 0
    ensure result == 3
    return 0 if hfa_count > 0 else 1 if size <= 8 else 2 if size <= 16 else 3

def arm64_large_hfa_shape(size: i64, hfa_count: i64) -> i64:
    requires size > 16 and hfa_count > 0
    ensure result == 0
    return 0 if hfa_count > 0 else 1 if size <= 8 else 2 if size <= 16 else 3
