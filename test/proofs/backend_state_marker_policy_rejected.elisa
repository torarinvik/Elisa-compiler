include "../../src/backend/codegen_state_marker_policy.elisa"

def local_marker_must_not_use_frozen_tag() -> bool:
    ensure result == true
    return BackendStateMarkerPolicy::tag_for_name("Local") == BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_FROZEN_TAG

def frozen_tag_must_not_name_local() -> bool:
    ensure result == true
    return BackendStateMarkerPolicy::name_for_tag(BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_FROZEN_TAG) == "Local"

def unknown_name_must_not_use_known_tag() -> bool:
    ensure result == true
    return BackendStateMarkerPolicy::tag_for_name("Other") == BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_LOCAL_TAG
