# Arithmetic laws for the signed-value inverse used by frontend IR varints.

def even_zigzag_payload_decodes_nonnegative(magnitude: i64, odd: bool) -> bool:
    requires magnitude >= 0 and not odd
    ensure result == true
    decoded: i64 = (0 - magnitude) - 1 if odd else magnitude
    return decoded == magnitude

def odd_zigzag_payload_decodes_negative(magnitude: i64, odd: bool) -> bool:
    requires magnitude >= 0 and odd
    ensure result == true
    decoded: i64 = (0 - magnitude) - 1 if odd else magnitude
    return decoded < 0

def zigzag_decode_is_in_i64_range(magnitude: i64, odd: bool) -> bool:
    requires magnitude >= 0 and magnitude <= 9223372036854775807
    ensure result == true
    decoded: i64 = (0 - magnitude) - 1 if odd else magnitude
    return decoded >= (0 - 9223372036854775807) - 1 and decoded <= 9223372036854775807

def negative_value_roundtrips_through_zigzag_inverse(value: i64) -> bool:
    requires value < 0
    ensure result == true
    magnitude: i64 = 0 - (value + 1)
    return (0 - magnitude) - 1 == value

def maximum_odd_zigzag_payload_decodes_to_i64_min(magnitude: i64) -> bool:
    requires magnitude == 9223372036854775807
    ensure result == true
    return (0 - magnitude) - 1 == (0 - 9223372036854775807) - 1
