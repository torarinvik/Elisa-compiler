include "./fulfills_whole_function.elisa"

def ordinary_protocol_is_marked() -> bool:
    ensure result == true
    return FulfillsWholeFunctionRule::should_mark_subject_fulfills(true, "Positive")

def malformed_subject_form_is_marked() -> bool:
    ensure result == true
    return FulfillsWholeFunctionRule::should_mark_subject_fulfills(false, "Vectorizes")

def non_whole_function_protocol_is_classified() -> bool:
    ensure result == true
    return FulfillsWholeFunctionRule::is_whole_function_protocol("NoAlloc")

def neighboring_marker_row_is_reported() -> bool:
    ensure result == true
    return FulfillsWholeFunctionRule::should_report_annotation_row(FulfillsWholeFunctionRule::NEIGHBORING_ANNOTATION_ROW)

def parser_marker_row_is_ignored() -> bool:
    ensure result == true
    return not FulfillsWholeFunctionRule::should_report_annotation_row(FulfillsWholeFunctionRule::FULFILLS_WHOLE_FUNCTION_ROW)
