# Source-linked proof model for the parser/semantic missing-subject annotation protocol.
module LawSubjectSentinelSpecification:
    public:
        const LAW_MISSING_SUBJECT_ANNOTATION_ROW: u32 = 3900000032

        def should_report_missing_subject(row: u32, owner: sview) -> bool:
            ensure result == (row == LAW_MISSING_SUBJECT_ANNOTATION_ROW and owner != "")
            return row == LAW_MISSING_SUBJECT_ANNOTATION_ROW and owner != ""

def source_law_subject_rule_is_exact(row: u32, owner: sview) -> bool:
    ensure result == true
    return LawSubjectSentinelSpecification::should_report_missing_subject(row, owner) ==
        (row == LawSubjectSentinelSpecification::LAW_MISSING_SUBJECT_ANNOTATION_ROW and owner != "")

def missing_subject_sentinel_with_owner_is_reported() -> bool:
    ensure result == true
    return LawSubjectSentinelSpecification::should_report_missing_subject(
        LawSubjectSentinelSpecification::LAW_MISSING_SUBJECT_ANNOTATION_ROW, "InRange")

def empty_owner_does_not_trigger_diagnostic() -> bool:
    ensure result == true
    return not LawSubjectSentinelSpecification::should_report_missing_subject(
        LawSubjectSentinelSpecification::LAW_MISSING_SUBJECT_ANNOTATION_ROW, "")

def nonmatching_rows_are_ignored(other_row: u32, owner: sview) -> bool:
    requires other_row != LawSubjectSentinelSpecification::LAW_MISSING_SUBJECT_ANNOTATION_ROW
    ensure result == true
    return not LawSubjectSentinelSpecification::should_report_missing_subject(other_row, owner)
