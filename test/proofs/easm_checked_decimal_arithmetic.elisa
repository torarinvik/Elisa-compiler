# Scalar arithmetic proofs for the exact guards used by EasmCheckedDecimal.
# The checker links these reduced i64 bounds to the production constants and
# tuple-returning digit helpers.
const I64_DECIMAL_BOUNDARY_PREFIX: i64 = 922337203685477580
const I64_MAX_VALUE: i64 = 9223372036854775807
const DECIMAL_RADIX: i64 = 10
const MAX_POSITIVE_FINAL_DIGIT: i64 = 7
const MAX_NEGATIVE_FINAL_DIGIT: i64 = 8
const FIRST_POSITIVE_OVERFLOW_DIGIT: i64 = 8
const FIRST_NEGATIVE_UNDERFLOW_DIGIT: i64 = 9

def positive_digit_guard(value: i64, digit: i64) -> bool:
    requires value >= 0 and digit >= 0 and digit <= 9
    ensure result == (value < 922337203685477580 or (value == 922337203685477580 and digit <= 7))
    return value < 922337203685477580 or (value == 922337203685477580 and digit <= 7)

def positive_digit_accumulation_stays_below_max(value: i64, digit: i64) -> bool:
    requires value >= 0 and digit >= 0 and digit <= 9 and (value < 922337203685477580 or (value == 922337203685477580 and digit <= 7))
    ensure result == true
    return value * 10 + digit >= 0 and value * 10 + digit <= 9223372036854775807

def negative_digit_guard(value: i64, digit: i64) -> bool:
    requires value <= 0 and digit >= 0 and digit <= 9
    ensure result == (value > 0 - 922337203685477580 or (value == 0 - 922337203685477580 and digit <= 8))
    return value > 0 - 922337203685477580 or (value == 0 - 922337203685477580 and digit <= 8)

def negative_digit_accumulation_stays_above_min(value: i64, digit: i64) -> bool:
    requires value <= 0 and digit >= 0 and digit <= 9 and (value > 0 - 922337203685477580 or (value == 0 - 922337203685477580 and digit <= 8))
    ensure result == true
    return value * 10 - digit >= 0 - 9223372036854775807 - 1 and value * 10 - digit <= 0

def positive_final_digit_reaches_i64_max() -> bool:
    ensure result == true
    return 922337203685477580 * 10 + 7 == 9223372036854775807

def negative_final_digit_reaches_i64_min() -> bool:
    ensure result == true
    return (0 - 922337203685477580) * 10 - 8 == 0 - 9223372036854775807 - 1

def ascii_digit_byte_offset_is_in_range(byte: u8) -> bool:
    requires byte >= 48 and byte <= 57
    ensure result == true
    return byte - 48 >= 0 and byte - 48 <= 9

def positive_accumulator_accepts_first_digit(digit: i64) -> bool:
    requires digit >= 0 and digit <= 9
    ensure result == true
    return 0 < 922337203685477580 or (0 == 922337203685477580 and digit <= 7)

def negative_accumulator_accepts_first_digit(digit: i64) -> bool:
    requires digit >= 0 and digit <= 9
    ensure result == true
    return 0 > -922337203685477580 or (0 == -922337203685477580 and digit <= 8)

def positive_boundary_digit_seven_is_safe() -> bool:
    ensure result == true
    return (I64_DECIMAL_BOUNDARY_PREFIX < I64_DECIMAL_BOUNDARY_PREFIX or (I64_DECIMAL_BOUNDARY_PREFIX == I64_DECIMAL_BOUNDARY_PREFIX and MAX_POSITIVE_FINAL_DIGIT <= MAX_POSITIVE_FINAL_DIGIT)) and I64_DECIMAL_BOUNDARY_PREFIX * DECIMAL_RADIX + MAX_POSITIVE_FINAL_DIGIT == I64_MAX_VALUE

def positive_boundary_digit_eight_is_rejected() -> bool:
    ensure result == true
    return not (I64_DECIMAL_BOUNDARY_PREFIX < I64_DECIMAL_BOUNDARY_PREFIX or (I64_DECIMAL_BOUNDARY_PREFIX == I64_DECIMAL_BOUNDARY_PREFIX and FIRST_POSITIVE_OVERFLOW_DIGIT <= MAX_POSITIVE_FINAL_DIGIT))

def negative_boundary_digit_eight_is_safe() -> bool:
    ensure result == true
    return (0 - I64_DECIMAL_BOUNDARY_PREFIX > 0 - I64_DECIMAL_BOUNDARY_PREFIX or (0 - I64_DECIMAL_BOUNDARY_PREFIX == 0 - I64_DECIMAL_BOUNDARY_PREFIX and MAX_NEGATIVE_FINAL_DIGIT <= MAX_NEGATIVE_FINAL_DIGIT)) and (0 - I64_DECIMAL_BOUNDARY_PREFIX) * DECIMAL_RADIX - MAX_NEGATIVE_FINAL_DIGIT == 0 - I64_MAX_VALUE - 1

def negative_boundary_digit_nine_is_rejected() -> bool:
    ensure result == true
    return not (0 - I64_DECIMAL_BOUNDARY_PREFIX > 0 - I64_DECIMAL_BOUNDARY_PREFIX or (0 - I64_DECIMAL_BOUNDARY_PREFIX == 0 - I64_DECIMAL_BOUNDARY_PREFIX and FIRST_NEGATIVE_UNDERFLOW_DIGIT <= MAX_NEGATIVE_FINAL_DIGIT))

def positive_final_digit_classification_is_exact(digit: i64) -> bool:
    requires digit >= 0 and digit <= 9
    ensure result == true
    guard: bool = I64_DECIMAL_BOUNDARY_PREFIX < I64_DECIMAL_BOUNDARY_PREFIX or (I64_DECIMAL_BOUNDARY_PREFIX == I64_DECIMAL_BOUNDARY_PREFIX and digit <= MAX_POSITIVE_FINAL_DIGIT)
    return guard if digit <= MAX_POSITIVE_FINAL_DIGIT else not guard

def positive_boundary_accumulation_stays_representable(digit: i64) -> bool:
    requires digit >= 0 and digit <= 7
    ensure result == true
    return 922337203685477580 * 10 + digit >= 0 and 922337203685477580 * 10 + digit <= 9223372036854775807

def negative_boundary_accumulation_stays_representable(digit: i64) -> bool:
    requires digit >= 0 and digit <= 8
    ensure result == true
    return (0 - 922337203685477580) * 10 - digit >= 0 - 9223372036854775807 - 1 and (0 - 922337203685477580) * 10 - digit <= 0

def negative_final_digit_classification_is_exact(digit: i64) -> bool:
    requires digit >= 0 and digit <= 9
    ensure result == true
    guard: bool = 0 - I64_DECIMAL_BOUNDARY_PREFIX > 0 - I64_DECIMAL_BOUNDARY_PREFIX or (0 - I64_DECIMAL_BOUNDARY_PREFIX == 0 - I64_DECIMAL_BOUNDARY_PREFIX and digit <= MAX_NEGATIVE_FINAL_DIGIT)
    return guard if digit <= MAX_NEGATIVE_FINAL_DIGIT else not guard
