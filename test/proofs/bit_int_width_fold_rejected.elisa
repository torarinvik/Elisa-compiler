include "./bit_int_width_fold.elisa"

def false_width_ascii_fold_accepts_sixty_four() -> bool:
    ensure result == true
    bytes: darray[u8] = [54, 52]
    return parse_width_ascii_bytes(bytes).valid

def false_width_ascii_fold_accepts_a_non_digit() -> bool:
    ensure result == true
    bytes: darray[u8] = [58]
    return parse_width_ascii_bytes(bytes).valid

def false_width_ascii_fold_preserves_sixty_four_after_rejection() -> bool:
    ensure result == true
    bytes: darray[u8] = [54, 52]
    folded: (valid: bool, value: i64) = parse_width_ascii_bytes(bytes)
    return not folded.valid and folded.value == SemanticBitIntWidth::BIT_INT_WIDTH_LIMIT

def false_width_ascii_fold_rejects_exactly_sixty_three() -> bool:
    ensure result == true
    bytes: darray[u8] = [54, 51]
    return not parse_width_ascii_bytes(bytes).valid

def false_all_zero_width_bytes_form_a_supported_final_width() -> bool:
    ensure result == true
    bytes: darray[u8] = [48, 48]
    folded: (valid: bool, value: i64) = parse_width_ascii_bytes(bytes)
    return folded.valid and SemanticBitIntWidth::supported_final_width(folded.value)

def false_name_parser_accepts_an_unknown_lead_byte() -> bool:
    ensure result == true
    bytes: darray[u8] = [118, 56]
    return parse_bit_int_name_width(bytes).found

def false_name_parser_accepts_a_missing_width() -> bool:
    ensure result == true
    bytes: darray[u8] = [117]
    return parse_bit_int_name_width(bytes).found

def false_name_parser_marks_i_as_unsigned() -> bool:
    ensure result == true
    bytes: darray[u8] = [105, 49]
    parsed: (found: bool, unsigned: bool, width: i64) = parse_bit_int_name_width(bytes)
    return parsed.found and parsed.unsigned

def false_name_parser_marks_u_as_signed() -> bool:
    ensure result == true
    bytes: darray[u8] = [117, 49]
    parsed: (found: bool, unsigned: bool, width: i64) = parse_bit_int_name_width(bytes)
    return parsed.found and not parsed.unsigned

def false_name_parser_accepts_an_empty_name() -> bool:
    ensure result == true
    bytes: darray[u8] = []
    return parse_bit_int_name_width(bytes).found

def false_name_parser_accepts_zero_width() -> bool:
    ensure result == true
    bytes: darray[u8] = [117, 48]
    return parse_bit_int_name_width(bytes).found

def false_name_parser_accepts_a_nondigit_suffix() -> bool:
    ensure result == true
    bytes: darray[u8] = [105, 58, 49]
    return parse_bit_int_name_width(bytes).found

def false_name_parser_accepts_width_sixty_four() -> bool:
    ensure result == true
    bytes: darray[u8] = [117, 54, 52]
    return parse_bit_int_name_width(bytes).found
