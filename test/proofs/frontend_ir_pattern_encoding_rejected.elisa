# Deliberately false schema claims must remain unproved.
include "../../src/driver/frontend_ir_pattern_encoding.elisa"

def binding_pattern_must_use_wildcard_node_type() -> bool:
    ensure result == true
    return FrontendIrPatternEncoding::BINDING_PATTERN_NODE_TYPE_ID == FrontendIrPatternEncoding::WILDCARD_PATTERN_NODE_TYPE_ID

def variant_name_field_must_be_the_args_field() -> bool:
    ensure result == true
    return FrontendIrPatternEncoding::VARIANT_PATTERN_VARIANT_FIELD_ID == FrontendIrPatternEncoding::VARIANT_PATTERN_ARGS_FIELD_ID
