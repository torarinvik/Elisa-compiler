include "./progress_direction.elisa"

def less_than_must_not_mean_decrease() -> bool:
    ensure result == true
    return ProgressDirection::from_comparison_operator(Lexer::TokenKind.Lt) == ProgressDirection::Direction.Decrease

def addition_must_not_advance_a_decreasing_bound() -> bool:
    ensure result == true
    return ProgressDirection::advances(ProgressDirection::Direction.Decrease, Lexer::TokenKind.Plus, Lexer::TokenKind.Plus, Lexer::TokenKind.Minus)

def zero_step_must_not_advance() -> bool:
    ensure result == true
    return ProgressDirection::advances_by_step(ProgressDirection::Direction.Increase, Lexer::TokenKind.PlusEq, ProgressDirection::Direction.NoDirection, Lexer::TokenKind.PlusEq, Lexer::TokenKind.MinusEq)

def negative_step_must_not_advance_an_increasing_bound() -> bool:
    ensure result == true
    return ProgressDirection::advances_by_step(ProgressDirection::Direction.Increase, Lexer::TokenKind.PlusEq, ProgressDirection::Direction.Decrease, Lexer::TokenKind.PlusEq, Lexer::TokenKind.MinusEq)
