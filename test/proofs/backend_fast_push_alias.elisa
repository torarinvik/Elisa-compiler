# Regression witness for counted-fill pre-reservation with copied DArray headers.
# Ordinary pushes write shared spare capacity before a later push grows and detaches.
include "../../elisacore_std/elisacore_runtime.elisa"

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        # Non-empty literals start at capacity 256. The 300 counted pushes
        # cross that capacity only after writing into shared spare slots.
        xs: mutable darray[i64] = [10, 11, 12, 13]
        alias: mutable darray[i64] = xs
        # Move xs off the arena tail so reserve-before-loop and the later
        # ordinary growth both relocate instead of extending the shared block.
        blocker: mutable darray[i64] = []
        blocker.reserve(1)
        alias.push(99)
        alias.count <- 4
        xs <- for i in 0..<300 |xs| -> xs:
            xs.push(100 + i)
        alias.count <- 5
        return 1 if alias[4] != 100
        return 0
