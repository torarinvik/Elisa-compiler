# Regression witness for counted-fill pre-reservation with copied DArray headers.
# Ordinary pushes write shared spare capacity before a later push grows and detaches.
include "../../elisacore_std/elisacore_runtime.elisa"

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        xs: mutable darray[i64] = []
        xs.reserve(8)
        xs.push(10)
        xs.push(11)
        xs.push(12)
        xs.push(13)
        alias: mutable darray[i64] = xs
        alias.push(99)
        alias.count <- 4
        xs <- for i in 0..<8 |xs| -> xs:
            xs.push(100 + i)
        alias.count <- 5
        return 1 if alias[4] != 100
        return 0
