include "./ghost_field_default_policy.elisa"

def non_ghost_default_is_reported() -> bool:
    ensure result == true
    return GhostFieldDefaultPolicy::should_report(false, true)

def ghost_without_default_is_reported() -> bool:
    ensure result == true
    return GhostFieldDefaultPolicy::should_report(true, false)

def struct_location_wins_when_field_location_exists() -> bool:
    ensure result == true
    return GhostFieldDefaultPolicy::diagnostic_line(EXAMPLE_STRUCT_LINE, EXAMPLE_FIELD_LINE) == EXAMPLE_STRUCT_LINE

def missing_field_location_returns_the_sentinel() -> bool:
    ensure result == true
    return GhostFieldDefaultPolicy::diagnostic_line(
        EXAMPLE_STRUCT_LINE, GhostFieldDefaultPolicy::MISSING_FIELD_SOURCE_LINE
    ) == GhostFieldDefaultPolicy::MISSING_FIELD_SOURCE_LINE
