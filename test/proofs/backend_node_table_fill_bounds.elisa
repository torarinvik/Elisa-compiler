# Arithmetic and control-flow obligations for the backend node_table_fill lowering.
include "../../src/backend/codegen_cstr_terminator_policy.elisa"

def wasm32_count_guard_rejects_first_unrepresentable_count() -> bool:
    ensure result == true
    count: u64 = BackendCStrTerminatorPolicy::U32_MAX + 1
    return not (count <= BackendCStrTerminatorPolicy::target_size_max(BackendCStrTerminatorPolicy::POINTER_BITS_32))

def admitted_node_count_fits_target_usize(count: u64, pointer_bits: u32) -> bool:
    requires pointer_bits == BackendCStrTerminatorPolicy::POINTER_BITS_32 or pointer_bits == BackendCStrTerminatorPolicy::POINTER_BITS_64
    requires count <= BackendCStrTerminatorPolicy::target_size_max(pointer_bits)
    ensure result == true
    return count <= BackendCStrTerminatorPolicy::target_size_max(pointer_bits)

def zero_stride_allocation_size_is_zero(count: u64, pointer_bits: u32) -> bool:
    requires pointer_bits == BackendCStrTerminatorPolicy::POINTER_BITS_32 or pointer_bits == BackendCStrTerminatorPolicy::POINTER_BITS_64
    requires count <= BackendCStrTerminatorPolicy::target_size_max(pointer_bits)
    ensure result == true
    return count * 0 <= BackendCStrTerminatorPolicy::target_size_max(pointer_bits)

def positive_stride_allocation_size_fits_target(count: u64, stride: u64, pointer_bits: u32) -> bool:
    requires pointer_bits == BackendCStrTerminatorPolicy::POINTER_BITS_32 or pointer_bits == BackendCStrTerminatorPolicy::POINTER_BITS_64
    requires count <= BackendCStrTerminatorPolicy::target_size_max(pointer_bits)
    requires stride > 0 and stride <= BackendCStrTerminatorPolicy::target_size_max(pointer_bits)
    requires count <= BackendCStrTerminatorPolicy::target_size_max(pointer_bits) / stride
    ensure result == true
    return count * stride <= BackendCStrTerminatorPolicy::target_size_max(pointer_bits)

def empty_node_table_skips_the_fill_branch(count: u64) -> bool:
    requires count == 0
    ensure result == true
    return not (count != 0)

def nonempty_node_table_has_the_requested_view_length(count: u64, view_length: u64) -> bool:
    requires count > 0 and view_length == count
    ensure result == true
    return view_length > 0 and view_length == count
