# EASM immediate operands must fit the signed 32-bit encoding range.
def immediate_checked_result(has_dollar: bool, parsed_valid: bool, value: i64) -> (valid: bool, value: i64):
    ensure result.valid implies result.value == value
    ensure result.valid or result.value == 0
    if not has_dollar:
        return (false, 0)
    if not parsed_valid or value < -2147483648 or value > 2147483647:
        return (false, 0)
    return (true, value)

def immediate_min_i32_is_accepted(parsed_valid: bool, value: i64) -> bool:
    requires parsed_valid and value == -2147483648
    ensure result == true
    return parsed_valid and value >= -2147483648 and value <= 2147483647

def immediate_max_i32_is_accepted(parsed_valid: bool, value: i64) -> bool:
    requires parsed_valid and value == 2147483647
    ensure result == true
    return parsed_valid and value >= -2147483648 and value <= 2147483647

def valid_immediate_compatibility_value_preserves_parse(parsed_valid: bool, parsed_value: i64) -> i64:
    requires parsed_valid
    ensure result == parsed_value
    return parsed_value if parsed_valid else 0

def invalid_immediate_compatibility_value_is_zero(parsed_valid: bool, parsed_value: i64) -> i64:
    requires not parsed_valid
    ensure result == 0
    return parsed_value if parsed_valid else 0
