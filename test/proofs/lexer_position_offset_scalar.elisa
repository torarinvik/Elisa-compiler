# Scalar proof of the exact offset transition used by Lexer.advance_char.
# The source checker binds this expression to LexerPositionStep::advanced_offset.
def bounded_advance_offset(offset: usize, source_length: usize) -> usize:
    ensure result == (offset + 1 if offset < source_length else offset)
    return offset + 1 if offset < source_length else offset

def cursor_step_stays_inside_source(offset: usize, source_length: usize) -> bool:
    requires offset <= source_length
    ensure result == true
    return bounded_advance_offset(offset, source_length) <= source_length

def cursor_step_makes_strict_progress(offset: usize, source_length: usize) -> bool:
    requires offset < source_length
    ensure result == true
    return bounded_advance_offset(offset, source_length) > offset

def cursor_step_preserves_offset_at_source_end(offset: usize, source_length: usize) -> bool:
    requires offset == source_length
    ensure result == true
    return bounded_advance_offset(offset, source_length) == offset

def cursor_step_preserves_offset_beyond_source_end(offset: usize, source_length: usize) -> bool:
    requires offset > source_length
    ensure result == true
    return bounded_advance_offset(offset, source_length) == offset
