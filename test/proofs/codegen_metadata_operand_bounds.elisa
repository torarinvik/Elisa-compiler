# Prove the index bound used after the target metadata node's nonempty guard.

def metadata_operand_zero_is_in_bounds(count: usize) -> bool:
    requires count > 0
    ensure result == true
    return 0 < count

def empty_metadata_node_has_no_valid_operand_zero(count: usize) -> bool:
    requires count == 0
    ensure result == false
    return 0 < count
