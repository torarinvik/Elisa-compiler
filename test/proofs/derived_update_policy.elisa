# Decision-policy model, not a proof of the Go AST dependency walker or evaluator.
def may_preserve_input(dependencies_known: bool, predicates_unchanged: bool) -> bool:
    ensure result == (dependencies_known and predicates_unchanged)
    return dependencies_known and predicates_unchanged

def may_narrow_result(predicates_decided: bool, exactly_one_holds: bool) -> bool:
    ensure result == (predicates_decided and exactly_one_holds)
    return predicates_decided and exactly_one_holds

def unknown_dependency_blocks_preservation(unchanged: bool) -> bool:
    ensure result == false
    return may_preserve_input(false, unchanged)

def changed_predicate_blocks_preservation(known: bool) -> bool:
    ensure result == false
    return may_preserve_input(known, false)

def unknown_predicate_blocks_narrowing(unique: bool) -> bool:
    ensure result == false
    return may_narrow_result(false, unique)

def unknown_singleton_is_not_proof() -> bool:
    ensure result == false
    return may_narrow_result(false, true)

def gap_or_overlap_blocks_narrowing(decided: bool) -> bool:
    ensure result == false
    return may_narrow_result(decided, false)

def proven_unique_result_can_narrow() -> bool:
    ensure result == true
    return may_narrow_result(true, true)
