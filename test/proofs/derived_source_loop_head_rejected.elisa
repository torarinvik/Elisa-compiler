include "./derived_source_loop_head.elisa"

def zero_iteration_entry_can_be_dropped() -> bool:
    ensure result == false
    return loop_has_state(true, true, false)

def known_entry_hides_unknown_back_edge() -> bool:
    ensure result == true
    return loop_state_known(true, true, false)

def later_iteration_state_can_be_dropped() -> bool:
    ensure result == false
    return loop_has_state(false, true, true)
