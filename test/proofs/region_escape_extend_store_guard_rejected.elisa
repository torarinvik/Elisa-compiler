def extending_scalar_elements_runs_reference_store_check(is_extend: bool,
    receiver_elements_are_containers: bool) -> bool:
    requires is_extend and not receiver_elements_are_containers
    ensure result == true
    return not (is_extend and not receiver_elements_are_containers)

def ordinary_scalar_growth_skips_reference_store_check(is_extend: bool,
    receiver_elements_are_containers: bool) -> bool:
    requires not is_extend and not receiver_elements_are_containers
    ensure result == false
    return not (is_extend and not receiver_elements_are_containers)
