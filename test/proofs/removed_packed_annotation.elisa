# Source-linked specification for diagnostics emitted by the removed packed annotations pass.
module RemovedPackedAnnotationSpecification:
    public:
        const PACKED_ABI_ANNOTATION_NAME: sview = "packed_abi"
        const PACKED_PREFIX_ANNOTATION_NAME: sview = "packed_prefix"
        const CBIND_PREFIX_ANNOTATION_NAME: sview = "c_bind_prefix"
        const PACKED_ABI_DIAGNOSTIC_NAME: sview = "RemovedPackedAbiAnnotation"
        const PACKED_PREFIX_DIAGNOSTIC_NAME: sview = "RemovedPackedPrefixAnnotation"
        const CBIND_PREFIX_DIAGNOSTIC_NAME: sview = "RemovedCbindPrefixAnnotation"

        def diagnostic_name(annotation_name: sview) -> sview:
            ensure result == (
                when annotation_name:
                    "packed_abi" -> PACKED_ABI_DIAGNOSTIC_NAME
                    "packed_prefix" -> PACKED_PREFIX_DIAGNOSTIC_NAME
                    "c_bind_prefix" -> CBIND_PREFIX_DIAGNOSTIC_NAME
                    _ -> ""
            )
            return when annotation_name:
                "packed_abi" -> PACKED_ABI_DIAGNOSTIC_NAME
                "packed_prefix" -> PACKED_PREFIX_DIAGNOSTIC_NAME
                "c_bind_prefix" -> CBIND_PREFIX_DIAGNOSTIC_NAME
                _ -> ""

def source_removed_annotation_mapping_is_exact(annotation_name: sview) -> sview:
    ensure result == (
        when annotation_name:
            "packed_abi" -> RemovedPackedAnnotationSpecification::PACKED_ABI_DIAGNOSTIC_NAME
            "packed_prefix" -> RemovedPackedAnnotationSpecification::PACKED_PREFIX_DIAGNOSTIC_NAME
            "c_bind_prefix" -> RemovedPackedAnnotationSpecification::CBIND_PREFIX_DIAGNOSTIC_NAME
            _ -> ""
    )
    return RemovedPackedAnnotationSpecification::diagnostic_name(annotation_name)

def each_removed_annotation_has_its_diagnostic() -> bool:
    ensure result == true
    return (
        RemovedPackedAnnotationSpecification::diagnostic_name(RemovedPackedAnnotationSpecification::PACKED_ABI_ANNOTATION_NAME) == RemovedPackedAnnotationSpecification::PACKED_ABI_DIAGNOSTIC_NAME
        and RemovedPackedAnnotationSpecification::diagnostic_name(RemovedPackedAnnotationSpecification::PACKED_PREFIX_ANNOTATION_NAME) == RemovedPackedAnnotationSpecification::PACKED_PREFIX_DIAGNOSTIC_NAME
        and RemovedPackedAnnotationSpecification::diagnostic_name(RemovedPackedAnnotationSpecification::CBIND_PREFIX_ANNOTATION_NAME) == RemovedPackedAnnotationSpecification::CBIND_PREFIX_DIAGNOSTIC_NAME
    )

def nearby_annotation_names_are_not_removed() -> bool:
    ensure result == true
    return (
        RemovedPackedAnnotationSpecification::diagnostic_name("packed") == ""
        and RemovedPackedAnnotationSpecification::diagnostic_name("packed_abi_v2") == ""
        and RemovedPackedAnnotationSpecification::diagnostic_name("c_bind_prefix_v2") == ""
    )

def removed_annotation_diagnostic_names_are_distinct() -> bool:
    ensure result == true
    abi: sview = RemovedPackedAnnotationSpecification::diagnostic_name("packed_abi")
    packed: sview = RemovedPackedAnnotationSpecification::diagnostic_name("packed_prefix")
    cbind: sview = RemovedPackedAnnotationSpecification::diagnostic_name("c_bind_prefix")
    return abi != packed and abi != cbind and packed != cbind
