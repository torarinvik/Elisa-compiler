# False controls: the midpoint is strictly below high and both branches shrink.
include "./lexer_line_map_best_bounds.elisa"

def false_midpoint_can_reach_high(low: i64, high: i64, count: i64) -> bool:
    requires low >= 0 and low < high and high <= count and count <= LINE_MAP_BEST_MAX_COUNT
    ensure result == true
    middle: i64 = low + (high - low) / 2
    return middle >= high

def false_right_branch_keeps_old_high(low: i64, high: i64, middle: i64) -> bool:
    requires low >= 0 and low <= middle and middle < high
    ensure result == true
    next_high: i64 = middle
    return next_high == high

def false_accepting_branch_can_skip_boundary(low: i64, high: i64, middle: i64, boundary: i64) -> bool:
    requires low >= 0 and low <= middle and middle < high and low <= boundary and boundary <= high and middle < boundary
    ensure result == true
    next_low: i64 = middle + 1
    return next_low > boundary

def false_rejecting_branch_can_discard_boundary(low: i64, high: i64, middle: i64, boundary: i64) -> bool:
    requires low >= 0 and low <= boundary and boundary <= middle and middle < high
    ensure result == true
    next_high: i64 = middle
    return next_high < boundary

def false_accepting_branch_does_not_reduce_width(low: i64, high: i64, middle: i64) -> bool:
    requires low >= 0 and low <= middle and middle < high
    ensure result == true
    next_low: i64 = middle + 1
    return high - next_low >= high - low

def false_rejecting_branch_does_not_reduce_width(low: i64, high: i64, middle: i64) -> bool:
    requires low >= 0 and low <= middle and middle < high
    ensure result == true
    next_high: i64 = middle
    return next_high - low >= high - low
