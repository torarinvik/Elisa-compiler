# Source-linked proofs for unary borrow, write, and linear-mutable propagation.
include "../../src/semantic/binding_capability_unary_policy.elisa"

def exact_flags_for_every_unary_input(original_borrowed: bool, original_writable: bool,
    original_linear_mutable: bool, is_ampersand: bool, is_lmut: bool,
    is_mutable: bool, inner_type_is_mutable: bool) -> bool:
    ensure result == true
    flags: BindingCapabilityUnaryPolicy::Flags = BindingCapabilityUnaryPolicy::derive(
        original_borrowed, original_writable, original_linear_mutable,
        is_ampersand, is_lmut, is_mutable, inner_type_is_mutable)
    return (
        flags.borrowed == (original_borrowed or is_ampersand or is_lmut)
        and flags.writable == (original_writable or is_lmut or (is_mutable and (original_borrowed or is_ampersand or is_lmut)) or (is_ampersand and inner_type_is_mutable))
        and flags.linear_mutable == (original_linear_mutable or is_lmut)
    )

def mutable_preserves_an_unborrowed_nonwritable_value(writable: bool, linear_mutable: bool,
    inner_type_is_mutable: bool) -> bool:
    ensure result == true
    flags: BindingCapabilityUnaryPolicy::Flags = BindingCapabilityUnaryPolicy::derive(
        false, writable, linear_mutable, false, false, true, inner_type_is_mutable)
    return not flags.borrowed and flags.writable == writable

def lmut_always_adds_borrow_write_and_linear_flags(borrowed: bool, writable: bool,
    linear_mutable: bool, inner_type_is_mutable: bool) -> bool:
    ensure result == true
    flags: BindingCapabilityUnaryPolicy::Flags = BindingCapabilityUnaryPolicy::derive(
        borrowed, writable, linear_mutable, false, true, false, inner_type_is_mutable)
    return flags.borrowed and flags.writable and flags.linear_mutable

def ampersand_write_permission_tracks_inner_mutability(borrowed: bool, writable: bool,
    linear_mutable: bool, inner_type_is_mutable: bool) -> bool:
    ensure result == true
    flags: BindingCapabilityUnaryPolicy::Flags = BindingCapabilityUnaryPolicy::derive(
        borrowed, writable, linear_mutable, true, false, false, inner_type_is_mutable)
    return flags.borrowed and flags.writable == (writable or inner_type_is_mutable)
