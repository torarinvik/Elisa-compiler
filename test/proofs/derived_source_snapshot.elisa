include "./protocol_family_identity.elisa"

# Current-state evidence policy, not a proof that the compiler establishes it.
def source_snapshot_matches(known: bool, current: bool, source_family: u32, source_state: u32, target_family: u32, target_state: u32) -> bool:
    ensure result == (known and current and source_family == target_family and source_state == target_state)
    return known and current and same_state_key(source_family, source_state, target_family, target_state)

def annotation_does_not_refresh_snapshot(family: u32, state: u32) -> bool:
    ensure result == false
    return source_snapshot_matches(true, false, family, state, family, state)

def unknown_source_is_not_state_evidence(family: u32, state: u32) -> bool:
    ensure result == false
    return source_snapshot_matches(false, true, family, state, family, state)

def same_family_wrong_current_state(family: u32, source: u32, target: u32) -> bool:
    requires source != target
    ensure result == false
    return source_snapshot_matches(true, true, family, source, family, target)

def fresh_recomputed_state_can_match(family: u32, state: u32) -> bool:
    ensure result == true
    return source_snapshot_matches(true, true, family, state, family, state)
