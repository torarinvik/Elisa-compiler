# The contract model is source-checked against Semantic.int_fits_storage's u8 branch.
def proof_const_enum_u8_fits(value: i64) -> bool:
    ensure result == (value >= 0 and value <= 255)
    return value >= 0 and value <= 255

def const_enum_u8_accepts_in_range(value: i64) -> bool:
    requires value >= 0 and value <= 255
    ensure result == true
    return proof_const_enum_u8_fits(value)

def const_enum_u8_rejects_below_range(value: i64) -> bool:
    requires value < 0
    ensure result == true
    return not proof_const_enum_u8_fits(value)

def const_enum_u8_rejects_above_range(value: i64) -> bool:
    requires value > 255
    ensure result == true
    return not proof_const_enum_u8_fits(value)
