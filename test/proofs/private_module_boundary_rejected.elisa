# False claims that must not be admitted by the private-member boundary policy.
include "./private_module_boundary.elisa"

def false_claim_similar_textual_prefix_is_a_child() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return SemanticPrivateModuleBoundary::within_module("A::Painter", "A::Paint")

def false_claim_parent_module_is_inside_child_boundary() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return SemanticPrivateModuleBoundary::within_module("A", "A::Paint")

def false_claim_separator_without_child_is_a_descendant() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return SemanticPrivateModuleBoundary::within_module("A::Paint::", "A::Paint")
