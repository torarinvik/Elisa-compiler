# The contract model is source-checked against Semantic.int_fits_storage's i16 branch.
def proof_const_enum_i16_fits(value: i64) -> bool:
    ensure result == (value >= (0 - 32768) and value <= 32767)
    return value >= (0 - 32768) and value <= 32767

def const_enum_i16_accepts_in_range(value: i64) -> bool:
    requires value >= (0 - 32768) and value <= 32767
    ensure result == true
    return proof_const_enum_i16_fits(value)

def const_enum_i16_rejects_below_range(value: i64) -> bool:
    requires value < (0 - 32768)
    ensure result == true
    return not proof_const_enum_i16_fits(value)

def const_enum_i16_rejects_above_range(value: i64) -> bool:
    requires value > 32767
    ensure result == true
    return not proof_const_enum_i16_fits(value)
