# Prove the exact type-kind classifier used to reject float and bool match scrutinees.
include "../../src/semantic/semantic_types.elisa"
include "../../src/semantic/match_scrutinee_policy.elisa"

def unmatchable_kind_classifier_is_exact(kind: Semantic::SemTypeKind) -> bool:
    ensure result == true
    return SemanticMatchScrutineePolicy::kind_is_unmatchable(kind) == (
        kind == Semantic::SemTypeKind.Float or kind == Semantic::SemTypeKind.Bool
    )

def float_and_bool_kinds_are_unmatchable() -> bool:
    ensure result == true
    return SemanticMatchScrutineePolicy::kind_is_unmatchable(Semantic::SemTypeKind.Float) and
        SemanticMatchScrutineePolicy::kind_is_unmatchable(Semantic::SemTypeKind.Bool)

def integer_string_char_and_named_kinds_are_not_in_this_classifier() -> bool:
    ensure result == true
    return not SemanticMatchScrutineePolicy::kind_is_unmatchable(Semantic::SemTypeKind.Int) and
        not SemanticMatchScrutineePolicy::kind_is_unmatchable(Semantic::SemTypeKind.String) and
        not SemanticMatchScrutineePolicy::kind_is_unmatchable(Semantic::SemTypeKind.Char) and
        not SemanticMatchScrutineePolicy::kind_is_unmatchable(Semantic::SemTypeKind.Named)

def void_stays_with_its_separate_scrutinee_diagnostic() -> bool:
    ensure result == true
    return not SemanticMatchScrutineePolicy::kind_is_unmatchable(Semantic::SemTypeKind.Void)
