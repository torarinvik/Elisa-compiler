include "./backend_fast_push_cursor.elisa"

def false_fast_push_cursor_starts_at_zero(initial: u64, cursor: u64) -> bool:
    requires initial == 3 and cursor == initial
    ensure result == true
    return cursor == 0

def false_fast_push_public_count_advances_each_push(initial: u64, public_count: u64, cursor: u64) -> bool:
    requires initial == 4 and public_count == initial and cursor == initial + 2
    ensure result == true
    return public_count == cursor

def false_fast_push_final_count_omits_existing_count(initial: u64, pushes: u64, final_count: u64) -> bool:
    requires initial == 5 and pushes == 2 and final_count == initial + pushes
    ensure result == true
    return final_count == pushes

def false_fast_push_biased_pointer_omits_base(base_count: u64, ordinal: u64, absolute_index: u64) -> bool:
    requires base_count == 4 and ordinal == 2 and absolute_index == base_count + ordinal
    ensure result == true
    return ordinal == absolute_index

def false_fast_push_at_reserved_end_has_room(cursor: u64, reserved_end: u64) -> bool:
    requires cursor == reserved_end
    ensure result == true
    return cursor + 1 <= reserved_end

def false_fast_push_byte_budget_allows_one_extra_element(reserved_extra_elements: u64) -> bool:
    requires reserved_extra_elements == 67108865
    ensure result == true
    return reserved_extra_elements <= 67108864

def false_fast_push_old_trip_cap_fits_byte_budget() -> bool:
    requires 16777216 * 64 * 8 == 8589934592
    ensure result == true
    return 16777216 * 64 * 8 <= 67108864
