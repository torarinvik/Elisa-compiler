def large_bytewise_value_uses_memset(value_size: i64, bytewise_safe: bool) -> bool:
    requires value_size >= 256 and bytewise_safe
    ensure result == true
    return value_size >= 256 and bytewise_safe

def small_bytewise_value_uses_store(value_size: i64, bytewise_safe: bool) -> bool:
    requires value_size < 256 and bytewise_safe
    ensure result == false
    return value_size >= 256 and bytewise_safe

def large_nonbytewise_value_uses_store(value_size: i64, bytewise_safe: bool) -> bool:
    requires value_size >= 256 and not bytewise_safe
    ensure result == false
    return value_size >= 256 and bytewise_safe
