# Arithmetic model for the StringView index guard used by the runtime helper and
# the 64-bit inline LLVM path. The source checker binds these laws to both paths.
# The fit flags model the runtime's usize-to-i64 round-trip checks on narrower targets.
def sview_index_guard(length: i64, index: i64, length_fits_usize: bool, index_fits_usize: bool) -> bool:
    ensure result == (length >= 0 and length_fits_usize and index >= 0 and index_fits_usize and index < length)
    return length >= 0 and length_fits_usize and index >= 0 and index_fits_usize and index < length

def index_zero_is_guarded_by_a_positive_length(length: i64, index: i64, length_fits_usize: bool, index_fits_usize: bool) -> bool:
    requires length > 0 and index == 0 and length_fits_usize and index_fits_usize
    ensure result == true
    return length >= 0 and length_fits_usize and index >= 0 and index_fits_usize and index < length

def parser_first_byte_is_within_a_nonempty_view(length: i64, index: i64) -> bool:
    requires length > 0 and index == 0
    ensure result == true
    return index >= 0 and index < length

def negative_index_never_passes_the_guard(length: i64, index: i64, length_fits_usize: bool, index_fits_usize: bool) -> bool:
    requires index < 0
    ensure result == true
    return not sview_index_guard(length, index, length_fits_usize, index_fits_usize)

def index_at_end_never_passes_the_guard(length: i64, length_fits_usize: bool, index_fits_usize: bool) -> bool:
    requires length >= 0
    ensure result == true
    return not sview_index_guard(length, length, length_fits_usize, index_fits_usize)

def an_unrepresentable_length_never_passes_the_guard(length: i64, index: i64, length_fits_usize: bool, index_fits_usize: bool) -> bool:
    requires not length_fits_usize
    ensure result == true
    return not sview_index_guard(length, index, length_fits_usize, index_fits_usize)

def an_unrepresentable_index_never_passes_the_guard(length: i64, index: i64, length_fits_usize: bool, index_fits_usize: bool) -> bool:
    requires not index_fits_usize
    ensure result == true
    return not sview_index_guard(length, index, length_fits_usize, index_fits_usize)

def accepted_index_is_strictly_inside_the_view(length: i64, index: i64, length_fits_usize: bool, index_fits_usize: bool) -> bool:
    requires sview_index_guard(length, index, length_fits_usize, index_fits_usize)
    ensure result == true
    return length >= 0 and length_fits_usize and index >= 0 and index_fits_usize and index < length

