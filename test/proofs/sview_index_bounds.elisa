# Arithmetic model for the StringView index guard used by the runtime helper and
# the 64-bit inline LLVM path. The source checker binds these laws to both paths.
# Concrete usize values model the runtime's i64/usize round-trip checks.
def sview_index_guard(length: i64, index: i64, length_usize: usize, index_usize: usize) -> bool:
    ensure result == (length >= 0 and length_usize.i64() == length and index >= 0 and index < length and index_usize.i64() == index)
    return length >= 0 and length_usize.i64() == length and index >= 0 and index < length and index_usize.i64() == index

def index_zero_is_guarded_by_a_positive_length(length: i64, index: i64, length_usize: usize, index_usize: usize) -> bool:
    requires length > 0 and index == 0 and length_usize.i64() == length and index_usize.i64() == index
    ensure result == true
    return sview_index_guard(length, index, length_usize, index_usize)

def parser_first_byte_is_within_a_nonempty_view(length: i64, index: i64) -> bool:
    requires length > 0 and index == 0
    ensure result == true
    return index >= 0 and index < length

def negative_index_never_passes_the_guard(length: i64, index: i64, length_usize: usize, index_usize: usize) -> bool:
    requires length >= 0 and length_usize.i64() == length and index < 0
    ensure result == true
    return not sview_index_guard(length, index, length_usize, index_usize)

def index_at_end_never_passes_the_guard(length: i64, length_usize: usize) -> bool:
    requires length >= 0 and length_usize.i64() == length
    ensure result == true
    return not sview_index_guard(length, length, length_usize, length_usize)

def an_unrepresentable_length_never_passes_the_guard(length: i64, index: i64, length_usize: usize, index_usize: usize) -> bool:
    requires length >= 0 and length_usize.i64() != length
    requires index >= 0 and index < length and index_usize.i64() == index
    ensure result == true
    return not sview_index_guard(length, index, length_usize, index_usize)

def an_unrepresentable_index_never_passes_the_guard(length: i64, index: i64, length_usize: usize, index_usize: usize) -> bool:
    requires length >= 0 and length_usize.i64() == length
    requires index >= 0 and index < length
    requires index_usize.i64() != index
    ensure result == true
    return not sview_index_guard(length, index, length_usize, index_usize)

def accepted_index_is_strictly_inside_the_view(length: i64, index: i64, length_usize: usize, index_usize: usize) -> bool:
    requires sview_index_guard(length, index, length_usize, index_usize)
    ensure result == true
    return length >= 0 and length_usize.i64() == length and index >= 0 and index < length and index_usize.i64() == index
