# False controls: ordinary text and incomplete marker spellings are rejected.
include "../../src/parser/parser_machine_marker.elisa"

def ordinary_text_is_a_transition_marker() -> bool:
    ensure result == true
    return ParserMachineMarker::has_prefix("NextState")

def incomplete_transition_prefix_is_accepted() -> bool:
    ensure result == true
    return ParserMachineMarker::has_prefix("#-")

def different_transition_payload_is_accepted() -> bool:
    ensure result == true
    return ParserMachineMarker::matches("#->NextState", "OtherState")

def trailing_transition_payload_is_accepted() -> bool:
    ensure result == true
    return ParserMachineMarker::matches("#->NextState!", "NextState")
