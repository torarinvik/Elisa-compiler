include "./project_json_unicode_bounds.elisa"

def false_digit_nine_is_at_most_eight(byte: i64) -> bool:
    requires byte == 57
    ensure result == true
    return byte - 48 <= 8

def false_max_hex_is_below_u16(a: i64, b: i64, c: i64, d: i64) -> bool:
    requires a == 15 and b == 15 and c == 15 and d == 15
    ensure result == true
    return ((a * 16 + b) * 16 + c) * 16 + d <= 65534

def false_max_scalar_is_smaller(high: i64, low: i64) -> bool:
    requires high == 56319 and low == 57343
    ensure result == true
    return 65536 + (high - 55296) * 1024 + (low - 56320) <= 1114110
