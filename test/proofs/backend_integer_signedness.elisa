# Source-bound contracts for the signedness arms of integer LLVM lowering.
const TOKEN_SLASH: i64 = 95
const TOKEN_PERCENT: i64 = 96
const TOKEN_RSHIFT: i64 = 100
const TOKEN_LSHIFT: i64 = 99

const OP_SDIV: i64 = 1
const OP_UDIV: i64 = 2
const OP_SREM: i64 = 3
const OP_UREM: i64 = 4
const OP_ASHR: i64 = 5
const OP_LSHR: i64 = 6
const OP_SHL: i64 = 7

def signed_division_selects_sdiv(operator: i64, unsigned: bool) -> i64:
    requires operator == TOKEN_SLASH and not unsigned
    ensure result == OP_SDIV
    return OP_UDIV if operator == TOKEN_SLASH and unsigned else (OP_SDIV if operator == TOKEN_SLASH else 0)

def unsigned_division_selects_udiv(operator: i64, unsigned: bool) -> i64:
    requires operator == TOKEN_SLASH and unsigned
    ensure result == OP_UDIV
    return OP_UDIV if operator == TOKEN_SLASH and unsigned else (OP_SDIV if operator == TOKEN_SLASH else 0)

def signed_remainder_selects_srem(operator: i64, unsigned: bool) -> i64:
    requires operator == TOKEN_PERCENT and not unsigned
    ensure result == OP_SREM
    return OP_UREM if operator == TOKEN_PERCENT and unsigned else (OP_SREM if operator == TOKEN_PERCENT else 0)

def unsigned_remainder_selects_urem(operator: i64, unsigned: bool) -> i64:
    requires operator == TOKEN_PERCENT and unsigned
    ensure result == OP_UREM
    return OP_UREM if operator == TOKEN_PERCENT and unsigned else (OP_SREM if operator == TOKEN_PERCENT else 0)

def signed_right_shift_selects_ashr(operator: i64, unsigned: bool) -> i64:
    requires operator == TOKEN_RSHIFT and not unsigned
    ensure result == OP_ASHR
    return OP_LSHR if operator == TOKEN_RSHIFT and unsigned else (OP_ASHR if operator == TOKEN_RSHIFT else 0)

def unsigned_right_shift_selects_lshr(operator: i64, unsigned: bool) -> i64:
    requires operator == TOKEN_RSHIFT and unsigned
    ensure result == OP_LSHR
    return OP_LSHR if operator == TOKEN_RSHIFT and unsigned else (OP_ASHR if operator == TOKEN_RSHIFT else 0)

def left_shift_uses_shl_for_both_signednesses(operator: i64, unsigned: bool) -> i64:
    requires operator == TOKEN_LSHIFT
    ensure result == OP_SHL
    return OP_SHL if operator == TOKEN_LSHIFT else 0
