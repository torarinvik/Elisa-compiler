# Scalar arithmetic proof for the capacity threshold used by Semantic.NameSet.
# The source checker binds these assumptions to name_set_grow and name_set_add.
# The initial table has room for the first eight entries at the production
# half-full threshold; name_set_add grows it before the ninth entry.
def initial_capacity_covers_small_sets(name_count: usize) -> bool:
    requires name_count <= 7
    ensure result == true
    return 16 >= (name_count + 1) * 2

def add_preserves_count_for_duplicate_name(name_count: usize, already_present: bool) -> usize:
    ensure result == (name_count if already_present else name_count + 1)
    return name_count if already_present else name_count + 1

def a_fresh_name_increments_the_count_once(name_count: usize) -> bool:
    ensure result == true
    return add_preserves_count_for_duplicate_name(name_count, false) == name_count + 1

def name_set_capacity_stays_initial_through_eighth_entry(name_count: usize) -> usize:
    requires name_count == 7
    ensure result == 16
    return 32 if 16 < (name_count + 1) * 2 else 16

def name_set_ninth_entry_doubles_initial_capacity(name_count: usize) -> usize:
    requires name_count == 8
    ensure result == 32
    return 32 if 16 < (name_count + 1) * 2 else 16

def name_set_probe_step_stays_in_initial_table(slot: usize) -> usize:
    requires slot < 16
    ensure result < 16
    return (slot + 1) & 15

def ninth_name_rehash_keeps_twenty_three_slots_empty(name_count: usize) -> usize:
    requires name_count == 8
    ensure result == 23
    return (32 if 16 < (name_count + 1) * 2 else 16) - (name_count + 1)

def name_set_capacity_thirty_two_covers_next_eight_insertions(name_count: usize) -> bool:
    requires name_count >= 8 and name_count <= 15
    ensure result == true
    return 32 >= (name_count + 1) * 2

def name_set_seventeenth_entry_doubles_capacity(name_count: usize) -> usize:
    requires name_count == 16
    ensure result == 64
    return 64 if 32 < (name_count + 1) * 2 else 32

def name_set_capacity_sixty_four_covers_next_sixteen_insertions(name_count: usize) -> bool:
    requires name_count >= 16 and name_count <= 31
    ensure result == true
    return 64 >= (name_count + 1) * 2

def name_set_thirty_third_entry_doubles_capacity(name_count: usize) -> usize:
    requires name_count == 32
    ensure result == 128
    return 128 if 64 < (name_count + 1) * 2 else 64

def name_set_capacity_one_twenty_eight_covers_next_thirty_two_insertions(name_count: usize) -> bool:
    requires name_count >= 32 and name_count <= 63
    ensure result == true
    return 128 >= (name_count + 1) * 2

def name_set_sixty_fifth_entry_doubles_capacity(name_count: usize) -> usize:
    requires name_count == 64
    ensure result == 256
    return 256 if 128 < (name_count + 1) * 2 else 128

def seventeenth_name_rehash_keeps_forty_seven_slots_empty(name_count: usize) -> usize:
    requires name_count == 16
    ensure result == 47
    return (64 if 32 < (name_count + 1) * 2 else 32) - (name_count + 1)

def thirty_third_name_rehash_keeps_ninety_five_slots_empty(name_count: usize) -> usize:
    requires name_count == 32
    ensure result == 95
    return (128 if 64 < (name_count + 1) * 2 else 64) - (name_count + 1)

def sixty_fifth_name_rehash_keeps_one_hundred_ninety_one_slots_empty(name_count: usize) -> usize:
    requires name_count == 64
    ensure result == 191
    return (256 if 128 < (name_count + 1) * 2 else 128) - (name_count + 1)

def name_set_one_hundred_twenty_ninth_entry_doubles_capacity(name_count: usize) -> usize:
    requires name_count == 128
    ensure result == 512
    return 512 if 256 < (name_count + 1) * 2 else 256

def one_hundred_twenty_ninth_name_rehash_keeps_three_hundred_eighty_three_slots_empty(name_count: usize) -> usize:
    requires name_count == 128
    ensure result == 383
    return (512 if 256 < (name_count + 1) * 2 else 256) - (name_count + 1)

def name_set_two_hundred_fifty_seventh_entry_doubles_capacity(name_count: usize) -> usize:
    requires name_count == 256
    ensure result == 1024
    return 1024 if 512 < (name_count + 1) * 2 else 512

def two_hundred_fifty_seventh_name_rehash_keeps_seven_hundred_sixty_seven_slots_empty(name_count: usize) -> usize:
    requires name_count == 256
    ensure result == 767
    return (1024 if 512 < (name_count + 1) * 2 else 512) - (name_count + 1)

def name_set_five_hundred_thirteenth_entry_doubles_capacity(name_count: usize) -> usize:
    requires name_count == 512
    ensure result == 2048
    return 2048 if 1024 < (name_count + 1) * 2 else 1024

def five_hundred_thirteenth_name_rehash_keeps_one_thousand_five_hundred_thirty_five_slots_empty(name_count: usize) -> usize:
    requires name_count == 512
    ensure result == 1535
    return (2048 if 1024 < (name_count + 1) * 2 else 1024) - (name_count + 1)
