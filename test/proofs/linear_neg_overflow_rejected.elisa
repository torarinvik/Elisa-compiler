include "./linear_neg_overflow.elisa"

def false_minimum_negation_is_safe(operand: i64) -> bool:
    requires operand == (0 - 9223372036854775807 - 1)
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_neg_safe(operand)
    return checked.known

def positive_add_overflow_is_known(left: i64, right: i64) -> bool:
    requires right > 0 and left > 9223372036854775807 - right
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_add_safe(left, right)
    return checked.known

def positive_multiply_overflow_is_known(left: i64, right: i64) -> bool:
    requires left > 0 and right > 0 and left > 9223372036854775807 / right
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(left, right)
    return checked.known

def checked_multiplication_can_reject_the_reversed_safe_order(left: i64, right: i64) -> bool:
    ensure result == true
    forward: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(left, right)
    reverse: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(right, left)
    return forward.known and not reverse.known

def checked_subtraction_is_commutative_for_every_pair(left: i64, right: i64) -> bool:
    ensure result == true
    forward: (known: bool, value: i64) = Semantic::proof_linear_sub_safe(left, right)
    reverse: (known: bool, value: i64) = Semantic::proof_linear_sub_safe(right, left)
    return forward.known == reverse.known and forward.value == reverse.value

def checked_multiplication_by_negative_one_always_disagrees_with_negation(operand: i64) -> bool:
    ensure result == true
    product: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(0 - 1, operand)
    negation: (known: bool, value: i64) = Semantic::proof_linear_neg_safe(operand)
    return product.known != negation.known or product.value != negation.value

def negative_add_overflow_is_known(left: i64, right: i64) -> bool:
    requires right < 0 and left < (0 - 9223372036854775807 - 1) - right
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_add_safe(left, right)
    return checked.known

def subtraction_overflow_with_negative_subtrahend_is_known(left: i64, right: i64) -> bool:
    requires right < 0 and left > 9223372036854775807 + right
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_sub_safe(left, right)
    return checked.known

def subtraction_underflow_with_positive_subtrahend_is_known(left: i64, right: i64) -> bool:
    requires right > 0 and left < (0 - 9223372036854775807 - 1) + right
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_sub_safe(left, right)
    return checked.known

def positive_times_negative_multiply_overflow_is_known(left: i64, right: i64) -> bool:
    requires left > 0 and right < 0 and right < (0 - 9223372036854775807 - 1) / left
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(left, right)
    return checked.known

def negative_times_positive_multiply_overflow_is_known(left: i64, right: i64) -> bool:
    requires left < 0 and right > 0 and left < (0 - 9223372036854775807 - 1) / right
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(left, right)
    return checked.known

def negative_times_negative_multiply_overflow_is_known(left: i64, right: i64) -> bool:
    requires left < 0 and right < 0 and left < 9223372036854775807 / right
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_mul_safe(left, right)
    return checked.known

def division_is_admitted_by_linear_constant_folding(left: i64, right: i64) -> bool:
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_arith_safe(left, TokenKind.Slash, right)
    return checked.known

def remainder_is_admitted_by_linear_constant_folding(left: i64, right: i64) -> bool:
    ensure result == true
    checked: (known: bool, value: i64) = Semantic::proof_linear_arith_safe(left, TokenKind.Percent, right)
    return checked.known
