# False register-destination claims must remain unprovable.
include "./easm_register_effect_policy.elisa"

def ordinary_move_reads_its_old_register_destination() -> bool:
    ensure result == true
    return EasmRegisterEffectPolicy::destination_reads_register("movq")

def self_zeroing_xor_reads_its_old_destination() -> bool:
    ensure result == true
    return EasmRegisterEffectPolicy::reads_register_destination("xorq", true, true)

def distinct_xor_operands_are_self_zeroing() -> bool:
    ensure result == true
    return EasmRegisterEffectPolicy::is_self_zeroing("xorq", "rax", "rbx")

def indirect_call_reads_an_old_register_destination() -> bool:
    ensure result == true
    return EasmRegisterEffectPolicy::destination_reads_register("callq")
