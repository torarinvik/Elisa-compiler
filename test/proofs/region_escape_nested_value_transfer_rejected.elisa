include "./region_escape_nested_value_transfer.elisa"

def implicit_empty_block_carries_no_region_handle() -> bool:
    ensure result == false
    return block_handle_transfer_is_exact(false, false, true, false, false)

def match_with_a_carrying_arm_carries_no_region_handle() -> bool:
    ensure result == false
    return match_handle_transfer_is_exact(true)
