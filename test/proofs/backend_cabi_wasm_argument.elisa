# wasm aggregate argument classification passes zero-sized values or one flattened leaf
# directly; all other nonempty aggregate shapes are indirect.
def wasm_aggregate_argument_is_byval(is_aggregate: bool, size: i64, flat_ok: bool, leaf_count: i64) -> bool:
    requires size >= 0 and leaf_count >= 0
    ensure result == (is_aggregate and size > 0 and (not flat_ok or leaf_count != 1))
    return is_aggregate and size > 0 and (not flat_ok or leaf_count != 1)

def wasm_one_leaf_aggregate_is_direct(size: i64) -> bool:
    requires size > 0
    ensure not result
    return false

def wasm_multileaf_aggregate_is_indirect(leaf_count: i64, size: i64) -> bool:
    requires leaf_count > 1 and size > 0
    ensure result
    return true

def wasm_unflattenable_aggregate_is_indirect(size: i64) -> bool:
    requires size > 0
    ensure result
    return true

def wasm_zero_sized_aggregate_is_not_byval() -> bool:
    ensure not result
    return false
