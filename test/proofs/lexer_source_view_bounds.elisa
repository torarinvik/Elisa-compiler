# The source-view constructor accepts a span only when it is nonempty and
# contained by the caller-supplied byte extent. The companion checker ties this
# model to the ordered null returns before the trusted pointer slice.
# The arithmetic model assumes source points to at least source_length readable bytes.
# Token.text and Token.suffix now pass this caller-supplied extent to the same
# checked constructor; token-derived ends are only requested slice boundaries.
def source_view_guard_accepts(start: usize, end: usize, source_length: usize) -> bool:
    ensure result implies start < end and end <= source_length
    ensure (start < end and end <= source_length) implies result
    accepted: bool = not (start > end or end > source_length) and not (end <= start)
    return accepted

def valid_nonempty_source_span_is_admitted(start: usize, end: usize, source_length: usize) -> bool:
    requires start < end and end <= source_length
    ensure result == true
    return not (start > end or end > source_length) and not (end <= start)

def accepted_source_span_extent_fits_remaining_bytes(start: usize, end: usize, source_length: usize) -> bool:
    requires source_view_guard_accepts(start, end, source_length)
    ensure result == true
    return start < source_length and end - start > 0 and end - start <= source_length - start

def token_text_end_within_source(start: usize, length: usize, source_length: usize) -> usize:
    requires start <= source_length
    requires length <= source_length - start
    ensure result <= source_length
    return start + length

def token_suffix_end_within_source(start: usize, length: usize, suffix_length: usize, source_length: usize) -> usize:
    requires start <= source_length
    requires length <= source_length - start
    requires suffix_length <= source_length - (start + length)
    ensure result <= source_length
    return start + length + suffix_length

# Incremental semantic snapshots copy these bounded source spans into owned
# storage. Their helper validates subtraction before forming the half-open end.
def incremental_byte_span_nonempty_range_is_admitted(start: usize, length: usize, source_length: usize) -> bool:
    requires start <= source_length
    requires length > 0
    requires length <= source_length - start
    ensure result == true
    return source_view_guard_accepts(start, start + length, source_length)

def incremental_byte_span_empty_range_is_rejected(start: usize, source_length: usize) -> bool:
    requires start <= source_length
    ensure result == true
    return not source_view_guard_accepts(start, start, source_length)

def incremental_nonempty_byte_span_has_index_zero(start: usize, length: usize, source_length: usize) -> bool:
    requires start <= source_length
    requires length > 0
    requires length <= source_length - start
    ensure result == true
    return source_length > 0

def token_self_bound_does_not_prove_backing_extent(requested_end: usize, token_end: usize, backing_length: usize) -> bool:
    requires requested_end == token_end and token_end > backing_length
    ensure result == false
    return requested_end <= backing_length

def empty_source_span_is_rejected(start: usize, source_length: usize) -> bool:
    ensure result == false
    return not (start > start or start > source_length) and not (start <= start)

def reversed_source_span_is_rejected(start: usize, end: usize, source_length: usize) -> bool:
    requires start > end
    ensure result == false
    return not (start > end or end > source_length) and not (end <= start)

def source_span_past_end_is_rejected(start: usize, end: usize, source_length: usize) -> bool:
    requires end > source_length
    ensure result == false
    return not (start > end or end > source_length) and not (end <= start)
