include "./lexer_keyword_table.elisa"

def a_keyword_must_not_be_returned_as_an_identifier() -> bool:
    ensure result == true
    return Lexer::frontend_lookup_keyword("def") == Lexer::TokenKind.Ident

def a_near_miss_must_not_be_returned_as_a_keyword() -> bool:
    ensure result == true
    return Lexer::frontend_lookup_keyword("defn") == Lexer::TokenKind.Def

def the_reserved_aligned_spelling_must_remain_an_identifier() -> bool:
    ensure result == true
    return Lexer::frontend_lookup_keyword("aligned") != Lexer::TokenKind.Ident

def uppercase_keyword_spelling_must_remain_an_identifier() -> bool:
    ensure result == true
    return Lexer::frontend_lookup_keyword("DEF") != Lexer::TokenKind.Ident
