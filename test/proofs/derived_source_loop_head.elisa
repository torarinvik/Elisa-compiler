include "../../src/semantic/ownership_flow_domain.elisa"

# Loop-head state-set domain, not a proof of AST transfer or range recognition.
def loop_has_state(entry: bool, back_reachable: bool, back: bool) -> bool:
    ensure result == (entry or (back_reachable and back))
    return OwnershipFlow::join_reachable_possible(true, entry, back_reachable, back)

def entry_state_survives(back_reachable: bool, back: bool) -> bool:
    ensure result == true
    return loop_has_state(true, back_reachable, back)

def back_edge_state_survives(entry: bool) -> bool:
    ensure result == true
    return loop_has_state(entry, true, true)

def dead_back_edge_does_not_add_state(entry: bool, back: bool) -> bool:
    ensure result == entry
    return loop_has_state(entry, false, back)

def loop_state_known(entry: bool, back_reachable: bool, back: bool) -> bool:
    ensure result == (entry and (not back_reachable or back))
    return OwnershipFlow::join_reachable_known(true, entry, back_reachable, back)

def unknown_back_edge_blocks_knowledge(entry: bool) -> bool:
    ensure result == false
    return loop_state_known(entry, true, false)

def dead_back_edge_preserves_knowledge(entry: bool, back: bool) -> bool:
    ensure result == entry
    return loop_state_known(entry, false, back)

def repeated_back_edge_is_idempotent(entry: bool, back: bool) -> bool:
    ensure result == (entry or back)
    return OwnershipFlow::join_possible(OwnershipFlow::join_possible(entry, back), back)
