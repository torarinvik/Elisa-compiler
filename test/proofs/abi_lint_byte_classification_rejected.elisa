# False claims must remain unproved for ABI lint's exact ASCII token rules.
include "../../src/driver/project.elisa"
include "../../src/driver/abi_lint.elisa"

def ascii_exclamation_mark_is_an_assembly_word_byte() -> bool:
    ensure result == true
    return ProjectSystem::abi_is_word_byte("!"[0])

def lowercase_ascii_a_is_changed_by_casefolding() -> bool:
    ensure result == true
    return ProjectSystem::abi_lower("a"[0]) != "a"[0]

def asm_after_an_ascii_word_prefix_is_a_whole_token() -> bool can[Memory.Allocate, Abort.Panic]:
    ensure result == true
    text: darray[u8] = ProjectSystem::bytes_from_view("xasm ")
    return ProjectSystem::abi_word_in_span(text, 0.usize(), text.count, "asm")

def asm_before_an_underscore_is_a_whole_token() -> bool can[Memory.Allocate, Abort.Panic]:
    ensure result == true
    text: darray[u8] = ProjectSystem::bytes_from_view(" asm_")
    return ProjectSystem::abi_word_in_span(text, 0.usize(), text.count, "asm")

def a_span_start_past_end_can_match(text: darray[u8]&, start: usize, needle: sview) -> bool:
    requires start > text.count
    ensure result == true
    return ProjectSystem::abi_span_is(text, start, needle)

def a_word_span_start_past_end_can_match(text: darray[u8]&, span_start: usize, needle: sview) -> bool:
    requires span_start > text.count
    ensure result == true
    return ProjectSystem::abi_word_in_span(text, span_start, text.count, needle)

def a_keyword_longer_than_the_text_can_be_an_indirect_call(text: darray[u8]&, keyword: sview) -> bool:
    requires sview_len(keyword) > text.count
    ensure result == true
    return ProjectSystem::abi_has_indirect(text, keyword)

def a_rust_source_is_a_native_abi_input() -> bool can[Memory.Allocate, Abort.Panic]:
    ensure result == true
    path: darray[u8] = ProjectSystem::bytes_from_view("module.rs")
    return ProjectSystem::abi_is_native_source(path)

def a_c_suffix_before_a_later_extension_is_native() -> bool can[Memory.Allocate, Abort.Panic]:
    ensure result == true
    path: darray[u8] = ProjectSystem::bytes_from_view("module.c.backup")
    return ProjectSystem::abi_is_native_source(path)

def a_dotless_path_is_a_native_abi_input() -> bool can[Memory.Allocate, Abort.Panic]:
    ensure result == true
    path: darray[u8] = ProjectSystem::bytes_from_view("module")
    return ProjectSystem::abi_is_native_source(path)
