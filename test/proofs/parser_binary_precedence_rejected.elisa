# Each declaration is a deliberately false precedence claim; admission must reject it.

def false_claim_shifts_bind_tighter_than_addition(shift: i64, additive: i64) -> bool:
    requires shift == 8 and additive == 9
    ensure result == true
    return shift > additive

def false_claim_all_bitwise_levels_are_equal(bitwise_or: i64, bitwise_xor: i64) -> bool:
    requires bitwise_or == 5 and bitwise_xor == 6
    ensure result == true
    return bitwise_or == bitwise_xor
