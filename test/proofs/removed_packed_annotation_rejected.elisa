include "./removed_packed_annotation.elisa"

def false_packed_abi_has_no_diagnostic() -> bool:
    ensure result == true
    return RemovedPackedAnnotationSpecification::diagnostic_name("packed_abi") == ""

def false_prefix_uses_abi_diagnostic() -> bool:
    ensure result == true
    return RemovedPackedAnnotationSpecification::diagnostic_name("packed_prefix") == "RemovedPackedAbiAnnotation"

def false_unknown_annotation_has_a_diagnostic() -> bool:
    ensure result == true
    return RemovedPackedAnnotationSpecification::diagnostic_name("packed_abi_v2") != ""
