# Contradictory contains/search claims must remain unproved.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

def a_found_byte_can_be_reported_absent(view: sview, byte: u8) -> bool:
    requires sview_find_byte(view, byte) >= 0
    ensure result == true
    return not sview_contains_byte(view, byte)

def a_missing_byte_can_be_reported_present(view: sview, byte: u8) -> bool:
    requires sview_find_byte(view, byte) == -1
    ensure result == true
    return sview_contains_byte(view, byte)
