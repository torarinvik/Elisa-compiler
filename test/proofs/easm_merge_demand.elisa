# Per-register transfer laws for EASM label-block demand analysis.
def demanded_read_before_prior_write(defined_before: bool, reads_now: bool) -> bool:
    ensure result == (reads_now and not defined_before)
    return reads_now and not defined_before

def prior_definition_after_instruction(defined_before: bool, writes_now: bool) -> bool:
    ensure result == (defined_before or writes_now)
    return defined_before or writes_now

def read_modify_write_demands_before_its_write(defined_before: bool, reads_now: bool, writes_now: bool) -> bool:
    requires not defined_before and reads_now and writes_now
    ensure result == true
    return reads_now and not defined_before

def a_write_only_destination_does_not_demand_its_old_value(defined_before: bool, reads_now: bool, writes_now: bool) -> bool:
    requires not defined_before and not reads_now and writes_now
    ensure result == false
    return reads_now and not defined_before

def a_memory_destination_demands_its_address_register(defined_before: bool, source_reads: bool, destination_is_register: bool, destination_address_reads: bool) -> bool:
    requires not defined_before and not destination_is_register and destination_address_reads
    ensure result == true
    return (source_reads or (not destination_is_register and destination_address_reads)) and not defined_before

def a_register_move_destination_does_not_read_its_old_value(defined_before: bool, source_reads: bool, destination_is_register: bool, destination_address_reads: bool, destination_writes: bool) -> bool:
    requires not defined_before and not source_reads and destination_is_register and destination_writes
    ensure result == false
    return (source_reads or (not destination_is_register and destination_address_reads)) and not defined_before

def a_self_zeroing_alu_operation_suppresses_old_value_demand(defined_before: bool, source_reads: bool, destination_address_reads: bool, operands_are_same_register: bool, opcode_is_xor_or_sub: bool) -> bool:
    requires not defined_before and operands_are_same_register and opcode_is_xor_or_sub
    ensure result == false
    return ((source_reads or destination_address_reads) and not (operands_are_same_register and opcode_is_xor_or_sub)) and not defined_before

def aliased_move_source_survives_destination_write(defined_before: bool, all_reads: bool, source_alias: bool, destination_writes: bool) -> bool:
    requires not defined_before and source_alias and destination_writes
    ensure result == true
    return ((all_reads and not destination_writes) or (source_alias and destination_writes)) and not defined_before

def later_read_survives_an_unrelated_write(defined_before: bool, read_before: bool, write_target_before: bool, write_other_before: bool, read_now: bool) -> bool:
    requires not defined_before and not write_target_before and write_other_before and read_now
    ensure result == true
    return (read_before and not defined_before) or (read_now and not (defined_before or write_target_before))

def an_earlier_target_write_kills_later_live_in_demand(defined_before: bool, read_before: bool, write_target_before: bool, read_now: bool) -> bool:
    requires not defined_before and not read_before and write_target_before and read_now
    ensure result == false
    return (read_before and not defined_before) or (read_now and not (defined_before or write_target_before))

def a_read_before_a_later_write_stays_demanded(defined_before: bool, read_before: bool, write_target_before: bool, read_now: bool) -> bool:
    requires not defined_before and read_before and write_target_before
    ensure result == true
    return (read_before and not defined_before) or (read_now and not (defined_before or write_target_before))

def two_step_scan_matches_closed_demand_form(demanded_before: bool, defined_before: bool, reads_first: bool, writes_first: bool, reads_second: bool) -> bool:
    ensure result == true
    demanded_after_first: bool = demanded_before or (reads_first and not defined_before)
    defined_after_first: bool = defined_before or writes_first
    demanded_after_second: bool = demanded_after_first or (reads_second and not defined_after_first)
    return demanded_after_second == (demanded_before or (reads_first and not defined_before) or (reads_second and not (defined_before or writes_first)))

def three_step_scan_matches_closed_demand_form(demanded_before: bool, defined_before: bool, reads_first: bool, writes_first: bool, reads_second: bool, writes_second: bool, reads_third: bool) -> bool:
    ensure result == true
    demanded_after_first: bool = demanded_before or (reads_first and not defined_before)
    defined_after_first: bool = defined_before or writes_first
    demanded_after_second: bool = demanded_after_first or (reads_second and not defined_after_first)
    defined_after_second: bool = defined_after_first or writes_second
    demanded_after_third: bool = demanded_after_second or (reads_third and not defined_after_second)
    return demanded_after_third == (demanded_before or (reads_first and not defined_before) or (reads_second and not (defined_before or writes_first)) or (reads_third and not (defined_before or writes_first or writes_second)))

def a_past_demand_survives_every_later_instruction(demanded_before: bool, reads_now: bool, defined_before: bool) -> bool:
    requires demanded_before
    ensure result == true
    return demanded_before or (reads_now and not defined_before)

def a_prior_definition_survives_every_later_instruction(defined_before: bool, writes_now: bool) -> bool:
    requires defined_before
    ensure result == true
    return defined_before or writes_now
