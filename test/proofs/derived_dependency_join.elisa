include "./derived_update_policy.elisa"

# Structural dependency join policy; not a proof of AST dependency discovery.
def joined_dependencies_preserve(left_known: bool, right_known: bool, left_changed: bool, right_changed: bool) -> bool:
    ensure result == (left_known and right_known and not left_changed and not right_changed)
    return may_preserve_input(left_known and right_known, not (left_changed or right_changed))

def unknown_left_blocks_preservation(right_known: bool, left_changed: bool, right_changed: bool) -> bool:
    ensure result == false
    return joined_dependencies_preserve(false, right_known, left_changed, right_changed)

def unknown_right_blocks_preservation(left_known: bool, left_changed: bool, right_changed: bool) -> bool:
    ensure result == false
    return joined_dependencies_preserve(left_known, false, left_changed, right_changed)

def changed_right_blocks_preservation(left_known: bool, right_known: bool, left_changed: bool) -> bool:
    ensure result == false
    return joined_dependencies_preserve(left_known, right_known, left_changed, true)

def unrelated_known_dependencies_preserve() -> bool:
    ensure result == true
    return joined_dependencies_preserve(true, true, false, false)
