include "incremental_semantic_options_key.elisa"

def distinct_valid_option_keys_compare_equal() -> bool can[Memory.Allocate, Abort.Panic]:
    ensure result == true
    original: darray[u8] = sample_options_key(false)
    changed: darray[u8] = sample_options_key(true)
    return Semantic::incremental_semantic_options_key_equal(original, changed)

def changed_exact_key_is_accepted_with_same_prefilter() -> bool can[Memory.Allocate, Abort.Panic]:
    ensure result == true
    original: darray[u8] = sample_options_key(false)
    changed: darray[u8] = sample_options_key(true)
    snapshot: Semantic::IncrementalSemanticSnapshot = snapshot_for_option_key(original)
    encoded: Semantic::IncrementalSnapshotEncodeResult = Semantic::incremental_encode_snapshot(snapshot)
    if not encoded.valid:
        return false
    decoded: Semantic::IncrementalSnapshotDecodeResult = Semantic::incremental_decode_snapshot(encoded.bytes, 17, snapshot.options_fingerprint, changed)
    return decoded.valid
