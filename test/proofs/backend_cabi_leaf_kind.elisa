# LLVM scalar leaf kinds used by the C ABI flattener: float, double, integer/pointer.
def cabi_scalar_leaf_class(llvm_kind: i64) -> i64:
    ensure result == (1 if llvm_kind == 2 else 2 if llvm_kind == 3 else 0 if llvm_kind == 8 or llvm_kind == 12 else -1)
    return 1 if llvm_kind == 2 else 2 if llvm_kind == 3 else 0 if llvm_kind == 8 or llvm_kind == 12 else -1

def llvm_float_leaf_maps_to_float_class(llvm_kind: i64) -> i64:
    requires llvm_kind == 2
    ensure result == 1
    return 1

def llvm_double_leaf_maps_to_double_class(llvm_kind: i64) -> i64:
    requires llvm_kind == 3
    ensure result == 2
    return 2

def integer_or_pointer_leaf_maps_to_integer_class(llvm_kind: i64) -> i64:
    requires llvm_kind == 8 or llvm_kind == 12
    ensure result == 0
    return 0

def unsupported_scalar_kind_is_rejected(llvm_kind: i64) -> i64:
    requires llvm_kind != 2 and llvm_kind != 3 and llvm_kind != 8 and llvm_kind != 12
    ensure result == -1
    return -1
