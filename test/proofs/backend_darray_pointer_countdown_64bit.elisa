# A 64-bit DArray length is an unsigned usize. The backend carries the same
# 64-bit bit pattern in its i64 slot, checks it against zero, and decrements
# until zero. These u64 obligations model the complete 64-bit count domain.

def pointer_walk_cursor_step_stays_within_count_u64(count: u64, cursor: u64) -> bool:
    requires cursor < count
    ensure result == true
    return cursor + 1 <= count

def pointer_walk_countdown_step_decreases_u64(remaining: u64) -> bool:
    requires remaining > 0
    ensure result == true
    return remaining - 1 < remaining

def pointer_walk_countdown_step_stays_nonnegative_u64(remaining: u64) -> bool:
    requires remaining > 0
    ensure result == true
    return remaining - 1 >= 0
