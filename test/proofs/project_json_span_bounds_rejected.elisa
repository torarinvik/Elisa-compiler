# The two false guards would admit either an invalid start or an oversized span.
include "./project_json_span_bounds.elisa"

def false_claim_start_past_data_is_accepted(start: usize, total: usize) -> bool:
    requires start > total
    ensure result == true
    return start <= total

def false_claim_length_past_remaining_data_is_accepted(start: usize, length: usize, total: usize) -> bool:
    requires start <= total and length > total - start
    ensure result == true
    return length <= total - start
