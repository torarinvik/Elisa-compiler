# The interval checker must refuse each comparison when the bound it needs is unknown.
# Elisa integers are discrete, so x < 0 is equivalent to x <= 0 - 1.

def unknown_min_gt_rejected(min_known: bool, min_value: i64) -> bool:
    requires not min_known
    ensure result == false
    return min_known and min_value >= 1

def unknown_min_ge_rejected(min_known: bool, min_value: i64) -> bool:
    requires not min_known
    ensure result == false
    return min_known and min_value >= 0

def unknown_max_lt_rejected(max_known: bool, max_value: i64) -> bool:
    requires not max_known
    ensure result == false
    return max_known and max_value < 0

def unknown_max_le_rejected(max_known: bool, max_value: i64) -> bool:
    requires not max_known
    ensure result == false
    return max_known and max_value <= 0

def unknown_min_eq_rejected(min_known: bool, max_known: bool, min_value: i64, max_value: i64) -> bool:
    requires not min_known
    ensure result == false
    return min_known and max_known and min_value == 0 and max_value == 0

def unknown_max_eq_rejected(min_known: bool, max_known: bool, min_value: i64, max_value: i64) -> bool:
    requires not max_known
    ensure result == false
    return min_known and max_known and min_value == 0 and max_value == 0

def unknown_both_neq_rejected(min_known: bool, max_known: bool, min_value: i64, max_value: i64) -> bool:
    requires not min_known and not max_known
    ensure result == false
    return (min_known and min_value >= 1) or (max_known and max_value < 0)

def strict_negativity_is_at_most_minus_one(value: i64) -> bool:
    requires value < 0
    ensure result == true
    return value <= (0 - 1)

def at_most_minus_one_is_strictly_negative(value: i64) -> bool:
    requires value <= (0 - 1)
    ensure result == true
    return value < 0
