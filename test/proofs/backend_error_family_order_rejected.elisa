# Reverse-order claims must be rejected by the verified lexicographic comparator.
include "./backend_error_family_order.elisa"

extend BackendErrorFamilyOrderProof:
    public:
        def a_proper_extension_does_not_precede_its_prefix() -> bool:
            ensure result == true
            return error_family_precedes("error[IO]", "error")

        def a_greater_first_byte_does_not_precede_a_smaller_one() -> bool:
            ensure result == true
            return error_family_precedes("beta[a]", "alpha[z]")

        def a_smaller_byte_is_not_preceded_by_a_larger_byte(left: u8, right: u8) -> bool:
            requires left < right
            ensure result == true
            return right < left

        def a_concrete_byte_order_chain_can_break_transitivity() -> bool:
            ensure result == true
            return error_family_precedes("a", "b") and error_family_precedes("b", "c") and not error_family_precedes("a", "c")
