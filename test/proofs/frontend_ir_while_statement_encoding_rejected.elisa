# False schema claims for statement-form WhileStmt encoding.
include "../../src/driver/frontend_ir_while_statement_encoding.elisa"

def while_statement_cannot_use_its_stage0_node_tag() -> bool:
    ensure result == true
    return FrontendIrWhileStatementEncoding::node_type_id() == 133

def while_body_and_condition_cannot_use_distinct_fields() -> bool:
    ensure result == true
    return (
        FrontendIrWhileStatementEncoding::field_id(FrontendIrWhileStatementEncoding::WhileStmtField.Body)
        == FrontendIrWhileStatementEncoding::field_id(FrontendIrWhileStatementEncoding::WhileStmtField.Condition)
    )
