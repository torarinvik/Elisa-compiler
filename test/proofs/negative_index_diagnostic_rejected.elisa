# Deliberately false claims challenge the zero and u32 saturation boundaries.
include "../../src/semantic/negative_index_diagnostic.elisa"

def unary_minus_zero_is_reported_as_negative() -> bool:
    ensure result == true
    return NegativeIndexDiagnostic::unary_minus_has_negative_index(0)

def magnitude_above_u32_is_never_saturated() -> bool:
    ensure result == true
    return NegativeIndexDiagnostic::reported_magnitude(0 - 4294967296).i64() == 4294967296

def one_magnitude_is_always_marked_as_saturated() -> bool:
    ensure result == true
    return NegativeIndexDiagnostic::magnitude_exceeds_reported_range(0 - 1)
