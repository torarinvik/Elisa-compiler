# Source-linked proof of the ghost-field diagnostic predicate and line selection.
include "../../src/semantic/ghost_field_default_policy.elisa"

const EXAMPLE_STRUCT_LINE: u32 = 12
const EXAMPLE_FIELD_LINE: u32 = 15

def source_predicate_matches_the_boolean_cases(is_ghost: bool, has_default: bool) -> bool:
    ensure result == true
    return GhostFieldDefaultPolicy::should_report(is_ghost, has_default) == (is_ghost and has_default)

def source_location_uses_the_field_or_struct_fallback(struct_line: u32, field_type_line: u32) -> bool:
    ensure result == true
    return GhostFieldDefaultPolicy::diagnostic_line(struct_line, field_type_line) == (
        struct_line if field_type_line == GhostFieldDefaultPolicy::MISSING_FIELD_SOURCE_LINE else field_type_line
    )

def ghost_field_with_default_is_reported() -> bool:
    ensure result == true
    return GhostFieldDefaultPolicy::should_report(true, true)

def non_ghost_field_with_default_is_not_reported() -> bool:
    ensure result == true
    return not GhostFieldDefaultPolicy::should_report(false, true)

def ghost_field_without_default_is_not_reported() -> bool:
    ensure result == true
    return not GhostFieldDefaultPolicy::should_report(true, false)

def field_type_location_is_preferred() -> bool:
    ensure result == true
    return GhostFieldDefaultPolicy::diagnostic_line(EXAMPLE_STRUCT_LINE, EXAMPLE_FIELD_LINE) == EXAMPLE_FIELD_LINE

def missing_field_type_location_uses_the_struct() -> bool:
    ensure result == true
    return GhostFieldDefaultPolicy::diagnostic_line(
        EXAMPLE_STRUCT_LINE, GhostFieldDefaultPolicy::MISSING_FIELD_SOURCE_LINE
    ) == EXAMPLE_STRUCT_LINE
