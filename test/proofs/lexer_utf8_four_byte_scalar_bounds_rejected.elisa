# The generic four-byte arithmetic helper accepts normalized F4 90 BF BF payloads,
# but that byte sequence is above the Unicode scalar maximum and the production guard rejects it.
include "../../src/lexer/lexer_utf8_codepoint_constants.elisa"
include "../../src/lexer/lexer_utf8_codepoint_wide.elisa"

def an_out_of_range_f4_sequence_is_not_a_unicode_scalar() -> bool:
    decoded: i64 = lexer_decode_utf8_four(UTF8_FOUR_BYTE_LEAD_MAX - UTF8_FOUR_BYTE_LEAD_MIN, 16, 63, 63)
    ensure result == false
    return decoded <= UNICODE_SCALAR_MAX
