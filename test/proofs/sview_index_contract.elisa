# Runtime postcondition checks for StringView byte indexing.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

def an_in_range_view_index_reads_its_backing_byte(view: sview, index: usize) -> bool can[Unsafe.UncheckedIndex]:
    requires string_view_index_request_valid(view, index.i64())
    ensure result == true
    return view[index] == view.data[index]

def every_rejected_view_index_reads_zero(view: sview, index: usize) -> bool can[Unsafe.UncheckedIndex]:
    requires not string_view_index_request_valid(view, index.i64())
    ensure result == true
    return view[index] == 0

def a_found_byte_is_the_first_matching_offset(view: sview, byte: u8) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    requires sview_find_byte(view, byte) >= 0
    ensure result == true
    found: i64 = sview_find_byte(view, byte)
    return found < view.len and string_view_index(view, found) == byte.i64() and (
        forall prior in 0..<found: string_view_index(view, prior) != byte.i64()
    )

def an_absent_byte_returns_the_missing_sentinel(view: sview, byte: u8) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    requires forall candidate in 0..<view.len: string_view_index(view, candidate) != byte.i64()
    ensure result == true
    return sview_find_byte(view, byte) == -1

def an_unrepresentable_view_length_returns_the_missing_sentinel(view: sview, byte: u8) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len < 0 or view.len.usize().i64() != view.len
    ensure result == true
    return sview_find_byte(view, byte) == -1

def len_field_matches_its_signed_value_on_valid_views(view: sview) -> bool:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    ensure result == true
    return view.len == view.len.i64()

def positive_length_guard_makes_the_first_index_valid(view: sview) -> bool:
    requires view.len > 0 and view.len.usize().i64() == view.len
    ensure result == true
    return string_view_index_request_valid(view, 0)

def guarded_first_byte_syntax_matches_the_safe_helper(view: sview) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len > 0 and view.len.usize().i64() == view.len
    ensure result == true
    return view[0] == view[0.usize()].i64()
