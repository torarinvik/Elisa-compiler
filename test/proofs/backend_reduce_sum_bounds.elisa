# reduce_sum walks a view using its length as an unsigned loop bound. The source
# checker binds this boolean guard to the normalized view count and the element GEP.
def reduce_sum_loop_body_requires_index_below_count(index: u64, count: u64) -> bool:
    requires index < count
    ensure result == true
    return index < count

def reduce_sum_initial_index_satisfies_count_bound(count: u64) -> bool:
    ensure result == true
    return 0 <= count

def reduce_sum_loop_step_preserves_count_bound(index: u64, count: u64) -> bool:
    requires index < count
    ensure result == true
    return index + 1 <= count

def empty_reduce_sum_view_skips_the_body(index: u64, count: u64) -> bool:
    requires index == 0 and count == 0
    ensure result == true
    return not (index < count)

def one_past_reduce_sum_index_is_rejected(index: u64, count: u64) -> bool:
    requires index == count
    ensure result == true
    return not (index < count)
