# Deliberately false claims about unary binding-capability propagation.
include "../../src/semantic/binding_capability_unary_policy.elisa"

def mutable_alone_creates_a_borrow() -> bool:
    ensure result == true
    flags: BindingCapabilityUnaryPolicy::Flags = BindingCapabilityUnaryPolicy::derive(
        false, false, false, false, false, true, false)
    return flags.borrowed

def immutable_ampersand_grants_writability() -> bool:
    ensure result == true
    flags: BindingCapabilityUnaryPolicy::Flags = BindingCapabilityUnaryPolicy::derive(
        false, false, false, true, false, false, false)
    return flags.writable

def ordinary_mutable_wrapper_is_linear_mutable() -> bool:
    ensure result == true
    flags: BindingCapabilityUnaryPolicy::Flags = BindingCapabilityUnaryPolicy::derive(
        false, false, false, false, false, true, false)
    return flags.linear_mutable
