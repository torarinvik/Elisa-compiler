include "../../src/driver/wasm_typescript_type.elisa"
include "../../src/driver/wasm_scalar_wasm_type.elisa"

def u32_must_not_use_bigint() -> bool:
    ensure result == true
    return WasmTypeScriptType::wasm_ts_type("u32", true) == "bigint"

def cstr_return_must_not_accept_a_numeric_address() -> bool:
    ensure result == true
    return WasmTypeScriptType::wasm_ts_type("cstr", false) == "string | number"

def wasm_i32_abi_values_must_be_typescript_bigints(type_text: sview) -> bool can[Abort.Panic]:
    requires WasmScalarWasmType::wasm_scalar_wasm_type(type_text) == "i32"
    ensure result == true
    return WasmTypeScriptType::wasm_ts_type(type_text, true) == "bigint"

def u32_input_must_use_bigint() -> bool:
    ensure result == true
    return WasmTypeScriptType::wasm_ts_input_requires_bigint("u32")
