# False controls for the explicit loop phrase, plain fallback, and severity prefix.
include "./never_leak_report_labels.elisa"

def the_loop_category_uses_the_plain_phrase() -> bool:
    ensure result == true
    return NeverLeakReportNames::category_phrase(Semantic::NEVER_LEAK_LOOP, false) == "plain (its last use is a statement with no value to bind)"

def an_unrecognized_category_uses_the_loop_phrase() -> bool:
    ensure result == true
    return NeverLeakReportNames::category_phrase(Semantic::NEVER_LEAK_CATEGORY_UNKNOWN, true) == "loop (its last use is a loop it feeds: a counter, accumulator or loop input)"

def warning_mode_uses_error_prefix() -> bool:
    ensure result == true
    return NeverLeakReportNames::severity_prefix(NeverLeakEnvValues::NL_ENV_MODE_WARN) == ": error: "

def error_mode_uses_warning_prefix() -> bool:
    ensure result == true
    return NeverLeakReportNames::severity_prefix(NeverLeakEnvValues::NL_ENV_MODE_ERROR) == ": warning: "
