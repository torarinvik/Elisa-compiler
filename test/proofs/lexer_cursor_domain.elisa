include "../../src/lexer/lexer_cursor_domain.elisa"

def position_before_end_is_not_at_end(position: usize, source_length: usize) -> bool:
    requires position < source_length
    ensure result == false
    return LexerCursorDomain::cursor_at_or_past_source_end(position, source_length)

def position_at_end_is_at_end(position: usize, source_length: usize) -> bool:
    requires position == source_length
    ensure result == true
    return LexerCursorDomain::cursor_at_or_past_source_end(position, source_length)

def position_after_end_is_at_end(position: usize, source_length: usize) -> bool:
    requires position > source_length
    ensure result == true
    return LexerCursorDomain::cursor_at_or_past_source_end(position, source_length)

def end_predicate_matches_the_boundary_order(position: usize, source_length: usize) -> bool:
    ensure result == true
    return LexerCursorDomain::cursor_at_or_past_source_end(position, source_length) == (position >= source_length)
