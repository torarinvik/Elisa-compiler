# The contract model is source-checked against Semantic.int_fits_storage's u16 branch.
def proof_const_enum_u16_fits(value: i64) -> bool:
    ensure result == (value >= 0 and value <= 65535)
    return value >= 0 and value <= 65535

def const_enum_u16_accepts_in_range(value: i64) -> bool:
    requires value >= 0 and value <= 65535
    ensure result == true
    return proof_const_enum_u16_fits(value)

def const_enum_u16_rejects_below_range(value: i64) -> bool:
    requires value < 0
    ensure result == true
    return not proof_const_enum_u16_fits(value)

def const_enum_u16_rejects_above_range(value: i64) -> bool:
    requires value > 65535
    ensure result == true
    return not proof_const_enum_u16_fits(value)
