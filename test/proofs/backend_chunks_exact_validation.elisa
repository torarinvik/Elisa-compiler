# Boolean refinement of the Stage1 chunks_exact guard. The source checker binds
# size_valid to the source-signedness, target-nonzero, and round-trip-fit checks;
# remainder_is_zero is URem == 0, and both checks dominate target-width UDiv.
def chunks_exact_guard(size_valid: bool, remainder_is_zero: bool) -> bool:
    ensure result == (size_valid and remainder_is_zero)
    return size_valid and remainder_is_zero

def chunks_exact_size_is_valid(source_size: i64, target_size: usize, is_signed: bool, fits_target: bool) -> bool:
    ensure result == ((not is_signed or source_size > 0) and target_size != 0 and fits_target)
    return (not is_signed or source_size > 0) and target_size != 0 and fits_target

def zero_chunk_size_is_rejected(remainder_is_zero: bool) -> bool:
    ensure result == true
    return not chunks_exact_guard(chunks_exact_size_is_valid(0, 0, true, true), remainder_is_zero)

def nonpositive_signed_chunk_size_is_rejected(source_size: i64, target_size: usize, fits_target: bool, remainder_is_zero: bool) -> bool:
    requires source_size <= 0
    ensure result == true
    return not chunks_exact_guard(chunks_exact_size_is_valid(source_size, target_size, true, fits_target), remainder_is_zero)

def positive_signed_chunk_size_is_accepted(source_size: i64, target_size: usize, fits_target: bool) -> bool:
    requires source_size > 0 and target_size > 0 and fits_target
    ensure result == true
    return chunks_exact_size_is_valid(source_size, target_size, true, fits_target)

def nonzero_unsigned_chunk_size_is_accepted(target_size: usize, fits_target: bool) -> bool:
    requires target_size != 0 and fits_target
    ensure result == true
    return chunks_exact_size_is_valid(0, target_size, false, fits_target)

def wasm32_roundtrip_rejects_high_source_bits(source_size: i64, roundtrip: i64) -> bool:
    requires source_size > 4294967295
    requires roundtrip >= 0 and roundtrip <= 4294967295
    ensure result == true
    return roundtrip != source_size

def nondivisible_view_length_is_rejected(size_valid: bool) -> bool:
    ensure result == true
    return not chunks_exact_guard(size_valid, false)

def accepted_input_has_both_preconditions(size_valid: bool, remainder_is_zero: bool) -> bool:
    ensure result == true
    return chunks_exact_guard(size_valid, remainder_is_zero) == (size_valid and remainder_is_zero)

def every_exact_chunk_window_stays_within_length(total: usize, chunk_size: usize, count: usize, index: usize) -> bool:
    requires chunk_size > 0
    requires count == total / chunk_size
    requires index < count
    ensure result == true
    return index * chunk_size + chunk_size <= total

def unsigned_counted_loop_condition_preserves_bound(index: usize, count: usize) -> bool:
    ensure result == (index < count)
    return index < count
