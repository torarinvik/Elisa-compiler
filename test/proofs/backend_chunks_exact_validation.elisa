# Boolean refinement of the Stage1 chunks_exact guard. The source checker binds
# size_valid to the signed-positive/unsigned-nonzero LLVM comparison and
# remainder_is_zero to URem == 0, then checks both branches dominate UDiv.
def chunks_exact_guard(size_valid: bool, remainder_is_zero: bool) -> bool:
    ensure result == (size_valid and remainder_is_zero)
    return size_valid and remainder_is_zero

def chunks_exact_size_is_valid(chunk_size: i64, is_signed: bool) -> bool:
    ensure result == ((is_signed and chunk_size > 0) or (not is_signed and chunk_size != 0))
    return (is_signed and chunk_size > 0) or (not is_signed and chunk_size != 0)

def zero_chunk_size_is_rejected(remainder_is_zero: bool) -> bool:
    ensure result == true
    return not chunks_exact_guard(chunks_exact_size_is_valid(0, true), remainder_is_zero)

def nonpositive_signed_chunk_size_is_rejected(chunk_size: i64, remainder_is_zero: bool) -> bool:
    requires chunk_size <= 0
    ensure result == true
    return not chunks_exact_guard(chunks_exact_size_is_valid(chunk_size, true), remainder_is_zero)

def positive_signed_chunk_size_is_accepted(chunk_size: i64) -> bool:
    requires chunk_size > 0
    ensure result == true
    return chunks_exact_size_is_valid(chunk_size, true)

def nonzero_unsigned_chunk_size_is_accepted(chunk_size: i64) -> bool:
    requires chunk_size != 0
    ensure result == true
    return chunks_exact_size_is_valid(chunk_size, false)

def nondivisible_view_length_is_rejected(size_valid: bool) -> bool:
    ensure result == true
    return not chunks_exact_guard(size_valid, false)

def accepted_input_has_both_preconditions(size_valid: bool, remainder_is_zero: bool) -> bool:
    ensure result == true
    return chunks_exact_guard(size_valid, remainder_is_zero) == (size_valid and remainder_is_zero)

def exact_unsigned_chunk_count_reconstructs_length(total: usize, chunk_size: usize) -> bool:
    requires total >= 0 and chunk_size > 0 and total % chunk_size == 0
    ensure result == true
    return (total / chunk_size) * chunk_size == total

def every_exact_chunk_window_stays_within_length(total: usize, chunk_size: usize, index: usize) -> bool:
    requires chunk_size > 0 and total % chunk_size == 0
    requires index < total / chunk_size
    ensure result == true
    return index * chunk_size + chunk_size <= total

def unsigned_counted_loop_condition_preserves_bound(index: usize, count: usize) -> bool:
    ensure result == (index < count)
    return index < count
