def absent_handle_is_null(zeroed_handle: bool, llvm_null: bool) -> bool:
    requires zeroed_handle
    ensure result == true
    return zeroed_handle or llvm_null

def live_llvm_null_is_null(zeroed_handle: bool, llvm_null: bool) -> bool:
    requires not zeroed_handle and llvm_null
    ensure result == true
    return zeroed_handle or llvm_null

def live_nonnull_handle_is_not_null(zeroed_handle: bool, llvm_null: bool) -> bool:
    requires not zeroed_handle and not llvm_null
    ensure result == false
    return zeroed_handle or llvm_null
