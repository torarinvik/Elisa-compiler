include "./backend_region_abi_policy.elisa"

def false_claim_read_only_method_grows(is_push: bool, is_extend: bool, is_insert: bool, is_resize: bool, is_reserve: bool, is_put: bool, is_add: bool, is_append: bool) -> bool:
    requires not is_push and not is_extend and not is_insert and not is_resize and not is_reserve and not is_put and not is_add and not is_append
    ensure result == true
    return is_push or is_extend or is_insert or is_resize or is_reserve or is_put or is_add or is_append

def false_claim_append_does_not_grow(is_push: bool, is_extend: bool, is_insert: bool, is_resize: bool, is_reserve: bool, is_put: bool, is_add: bool, is_append: bool) -> bool:
    requires not is_push and not is_extend and not is_insert and not is_resize and not is_reserve and not is_put and not is_add and is_append
    ensure result == false
    return is_push or is_extend or is_insert or is_resize or is_reserve or is_put or is_add or is_append

def false_claim_ordinary_helper_has_explicit_allocator(has_dict_prefix: bool, has_set_prefix: bool) -> bool:
    requires not has_dict_prefix and not has_set_prefix
    ensure result == true
    return has_dict_prefix or has_set_prefix

def false_claim_dictionary_helper_lacks_explicit_allocator(has_dict_prefix: bool, has_set_prefix: bool) -> bool:
    requires has_dict_prefix and not has_set_prefix
    ensure result == false
    return has_dict_prefix or has_set_prefix
