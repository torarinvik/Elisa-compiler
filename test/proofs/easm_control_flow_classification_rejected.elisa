# False classification claims must be rejected by the EASM control-flow contracts.
include "../../src/backend/easm_model.elisa"

def ordinary_instruction_can_be_a_terminator() -> bool:
    ensure result == true
    return Easm::easm_is_terminator("add")

def conditional_branch_can_be_a_terminator() -> bool:
    ensure result == true
    return Easm::easm_is_terminator("je")

def unconditional_jump_can_be_a_conditional_branch() -> bool:
    ensure result == true
    return Easm::easm_is_conditional_jump("jmp")

def return_can_be_a_conditional_branch() -> bool:
    ensure result == true
    return Easm::easm_is_conditional_jump("ret")

def conditional_branch_can_also_terminate(op: sview) -> bool:
    requires Easm::easm_is_conditional_jump(op)
    ensure result == true
    return Easm::easm_is_terminator(op)

def a_terminator_can_be_a_conditional_branch(op: sview) -> bool:
    requires Easm::easm_is_terminator(op)
    ensure result == true
    return Easm::easm_is_conditional_jump(op)
