# False controls for the scalar replacement and cursor-consumption boundary.
include "./project_json_scalar_transition.elisa"

def false_claim_isolated_high_surrogate_is_preserved(first: i64, follows_unicode_escape: bool, low: i64) -> bool:
    requires first == 55296 and not follows_unicode_escape and low >= -1 and low <= 65535
    ensure result == true
    return (65536 + (first - 55296) * 1024 + (low - 56320)
        if first >= 55296 and first <= 56319 and follows_unicode_escape and low >= 56320 and low <= 57343
        else (65533 if first >= 55296 and first <= 57343 else first)) == first

def false_claim_unpaired_surrogate_consumes_pair_bytes(first: i64, follows_unicode_escape: bool, low: i64) -> bool:
    requires first == 55296 and not follows_unicode_escape and low >= -1 and low <= 65535
    ensure result == true
    return (6 if first >= 55296 and first <= 56319 and follows_unicode_escape and low >= 56320 and low <= 57343 else 0) == 6

def false_claim_max_scalar_uses_three_byte_branch(code: i64) -> bool:
    requires code == 1114111
    ensure result == true
    return code < 65536
