include "../../src/semantic/ownership_flow_domain.elisa"

def possible_commutative(a: bool, b: bool) -> void:
    ensure OwnershipFlow::join_possible(a, b) == OwnershipFlow::join_possible(b, a)
    _ = OwnershipFlow::join_possible(a, b)
    _ = OwnershipFlow::join_possible(b, a)
    return

def possible_idempotent(a: bool) -> bool:
    ensure result == a
    return (OwnershipFlow::join_possible(a, a))

def possible_associative(a: bool, b: bool, c: bool) -> void:
    ensure OwnershipFlow::join_possible(OwnershipFlow::join_possible(a, b), c) == OwnershipFlow::join_possible(a, OwnershipFlow::join_possible(b, c))
    _ = OwnershipFlow::join_possible(a, b)
    _ = OwnershipFlow::join_possible(OwnershipFlow::join_possible(a, b), c)
    _ = OwnershipFlow::join_possible(b, c)
    _ = OwnershipFlow::join_possible(a, OwnershipFlow::join_possible(b, c))
    return

def possible_preserves_consumed(a: bool, b: bool) -> bool:
    requires a
    ensure result == true
    return OwnershipFlow::join_possible(a, b)

def possible_empty_identity(a: bool) -> bool:
    ensure result == a
    return OwnershipFlow::join_possible(a, false)

def known_commutative(a: bool, b: bool) -> void:
    ensure OwnershipFlow::join_known(a, b) == OwnershipFlow::join_known(b, a)
    _ = OwnershipFlow::join_known(a, b)
    _ = OwnershipFlow::join_known(b, a)
    return

def known_idempotent(a: bool) -> bool:
    ensure result == a
    return OwnershipFlow::join_known(a, a)

def known_associative(a: bool, b: bool, c: bool) -> void:
    ensure OwnershipFlow::join_known(OwnershipFlow::join_known(a, b), c) == OwnershipFlow::join_known(a, OwnershipFlow::join_known(b, c))
    _ = OwnershipFlow::join_known(a, b)
    _ = OwnershipFlow::join_known(OwnershipFlow::join_known(a, b), c)
    _ = OwnershipFlow::join_known(b, c)
    _ = OwnershipFlow::join_known(a, OwnershipFlow::join_known(b, c))
    return

def unknown_stays_unknown(a: bool) -> bool:
    ensure result == false
    return OwnershipFlow::join_known(a, false)

def consumed_blocks_move(known: bool, live: bool) -> bool:
    ensure result == false
    return OwnershipFlow::can_move(known, live, true)

def unknown_blocks_move(live: bool, consumed: bool) -> bool:
    ensure result == false
    return OwnershipFlow::can_move(false, live, consumed)

def unreachable_blocks_move(known: bool, consumed: bool) -> bool:
    ensure result == false
    return OwnershipFlow::can_move(known, false, consumed)

def live_owner_can_move() -> bool:
    ensure result == true
    return OwnershipFlow::can_move(true, true, false)
