# Deliberately false claims for the `not` Boolean truth table.
include "./codegen_unary_boolean_model.elisa"

def lowering_not_false_stays_false() -> bool:
    ensure result == false
    return false if false else true

def lowering_not_true_stays_true() -> bool:
    ensure result == true
    return false if true else true

def lowered_not_is_identity(value: bool) -> bool:
    ensure result == value
    return false if value else true
