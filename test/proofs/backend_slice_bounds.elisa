# Unsigned slice arithmetic used by the backend's known-length view and sview paths.
# LLVM UGT treats a negative i64 bit pattern as a large unsigned bound, so the
# generic clamp model takes u64 values. The string-view path first applies its
# signed negative-start/negative-end rules, then uses the same unsigned clamp.
def slice_start_clamp(start: u64, length: u64) -> u64:
    ensure result == (length if start > length else start)
    ensure result <= length
    return length if start > length else start

def slice_end_clamp(end: u64, length: u64) -> u64:
    ensure result == (length if end > length else end)
    ensure result <= length
    return length if end > length else end

def slice_count_from_clamped_start(start: u64, end: u64, length: u64) -> u64:
    requires start <= length
    ensure result == ((length if end > length else end) - start if (length if end > length else end) >= start else 0)
    ensure result <= length - start
    return (length if end > length else end) - start if (length if end > length else end) >= start else 0

def clamped_slice_window_fits_source(start: u64, end: u64, length: u64) -> bool:
    requires start <= length
    ensure result == true
    count: u64 = slice_count_from_clamped_start(start, end, length)
    return count <= length - start and start + count <= length

def bounded_slice_count_fits_target_size(count: u64, source_length: u64, target_max: u64) -> bool:
    requires source_length <= target_max
    requires count <= source_length
    ensure result == true
    return count <= target_max

def high_select_subtraction_matches_empty_or_difference(start: u64, end_clamped: u64) -> bool:
    ensure result == true
    return (end_clamped if end_clamped >= start else start) - start == (end_clamped - start if end_clamped >= start else 0)

def inverted_slice_is_empty(start: u64, end: u64, length: u64) -> bool:
    requires start <= length and end < start
    ensure result == true
    return slice_count_from_clamped_start(start, end, length) == 0

def slice_start_at_extent_has_no_remaining_count(end: u64, length: u64) -> bool:
    ensure result == true
    return slice_count_from_clamped_start(length, end, length) == 0

def string_slice_normalise_start(start: i64) -> u64:
    ensure result == (start.u64() if start > 0 else 0)
    return start.u64() if start > 0 else 0

def string_slice_normalise_end(end: i64, length: u64) -> u64:
    ensure result == (end.u64() if end >= 0 else length)
    return end.u64() if end >= 0 else length
