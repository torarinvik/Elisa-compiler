include "./backend_region_parameter_index_spec.elisa"

def region_parameter_slot_is_within_the_source_row_bounds(lines: darray[u32], names: darray[sview], line: u32, name: sview) -> bool:
    ensure result == true
    slot: i64 = BackendRegionParameterIndexSpec::region_parameter_index(lines, names, line, name)
    return slot == -1 or (slot >= 0 and slot < lines.count.i64())
