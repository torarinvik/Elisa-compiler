# The literal-text arms of Parser.fstring_expression preserve scanner state,
# consume escaped brace pairs together, and enter interpolation only on a lone {.
const FS_TEXT: i64 = 0
const FS_EXPR: i64 = 1
const FS_STRING: i64 = 2
const F_LBRACE: i64 = 123
const F_RBRACE: i64 = 125
const F_BACKSLASH: i64 = 92
const F_QUOTE: i64 = 34

def text_double_open_stays_text(state: i64, depth: i64, character: i64, next_character: i64, has_next: bool) -> (state: i64, depth: i64, advance: i64):
    requires state == FS_TEXT and character == F_LBRACE and has_next and next_character == F_LBRACE
    ensure result.state == FS_TEXT
    ensure result.depth == depth
    ensure result.advance == 2
    return (state: FS_TEXT, depth: depth, advance: 2)

def text_double_close_stays_text(state: i64, depth: i64, character: i64, next_character: i64, has_next: bool) -> (state: i64, depth: i64, advance: i64):
    requires state == FS_TEXT and character == F_RBRACE and has_next and next_character == F_RBRACE
    ensure result.state == FS_TEXT
    ensure result.depth == depth
    ensure result.advance == 2
    return (state: FS_TEXT, depth: depth, advance: 2)

def text_backslash_skips_two(state: i64, depth: i64, character: i64) -> (state: i64, depth: i64, advance: i64):
    requires state == FS_TEXT and character == F_BACKSLASH
    ensure result.state == FS_TEXT
    ensure result.depth == depth
    ensure result.advance == 2
    return (state: FS_TEXT, depth: depth, advance: 2)

def text_lone_open_enters_expression(state: i64, depth: i64, character: i64, next_character: i64, has_next: bool) -> (state: i64, depth: i64, advance: i64):
    requires state == FS_TEXT and character == F_LBRACE
    requires not (has_next and next_character == F_LBRACE)
    ensure result.state == FS_EXPR
    ensure result.depth == 1
    ensure result.advance == 1
    return (state: FS_EXPR, depth: 1, advance: 1)

def text_double_open_retains_first_brace_span(index: usize, chunk_start: usize, end: usize) -> (literal_end: usize, reopened: usize, next_index: usize):
    requires chunk_start <= index and index + 1 < end
    ensure result.literal_end == index + 1
    ensure result.literal_end < end
    ensure result.reopened == index + 2
    ensure result.next_index == result.reopened
    return (literal_end: index + 1, reopened: index + 2, next_index: index + 2)

def text_double_close_retains_first_brace_span(index: usize, chunk_start: usize, end: usize) -> (literal_end: usize, reopened: usize, next_index: usize):
    requires chunk_start <= index and index + 1 < end
    ensure result.literal_end == index + 1
    ensure result.literal_end < end
    ensure result.reopened == index + 2
    ensure result.next_index == result.reopened
    return (literal_end: index + 1, reopened: index + 2, next_index: index + 2)
