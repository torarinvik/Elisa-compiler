# Source-bound invalid compare-exchange order-pair cases.

def cmpxchg_relaxed_acquire_is_rejected(success: i64, failure: i64) -> bool:
    requires success == 0 and failure == 1
    ensure result == false
    return failure == 0

def cmpxchg_relaxed_release_is_rejected(success: i64, failure: i64) -> bool:
    requires success == 0 and failure == 2
    ensure result == false
    return failure == 0

def cmpxchg_relaxed_acqrel_is_rejected(success: i64, failure: i64) -> bool:
    requires success == 0 and failure == 3
    ensure result == false
    return failure == 0

def cmpxchg_relaxed_seqcst_is_rejected(success: i64, failure: i64) -> bool:
    requires success == 0 and failure == 4
    ensure result == false
    return failure == 0

def cmpxchg_acquire_release_is_rejected(success: i64, failure: i64) -> bool:
    requires success == 1 and failure == 2
    ensure result == false
    return failure == 0 or failure == 1

def cmpxchg_acquire_acqrel_is_rejected(success: i64, failure: i64) -> bool:
    requires success == 1 and failure == 3
    ensure result == false
    return failure == 0 or failure == 1

def cmpxchg_acquire_seqcst_is_rejected(success: i64, failure: i64) -> bool:
    requires success == 1 and failure == 4
    ensure result == false
    return failure == 0 or failure == 1

def cmpxchg_release_acquire_is_rejected(success: i64, failure: i64) -> bool:
    requires success == 2 and failure == 1
    ensure result == false
    return failure == 0

def cmpxchg_release_release_is_rejected(success: i64, failure: i64) -> bool:
    requires success == 2 and failure == 2
    ensure result == false
    return failure == 0

def cmpxchg_release_acqrel_is_rejected(success: i64, failure: i64) -> bool:
    requires success == 2 and failure == 3
    ensure result == false
    return failure == 0

def cmpxchg_release_seqcst_is_rejected(success: i64, failure: i64) -> bool:
    requires success == 2 and failure == 4
    ensure result == false
    return failure == 0

def cmpxchg_acqrel_release_is_rejected(success: i64, failure: i64) -> bool:
    requires success == 3 and failure == 2
    ensure result == false
    return failure == 0 or failure == 1

def cmpxchg_acqrel_acqrel_is_rejected(success: i64, failure: i64) -> bool:
    requires success == 3 and failure == 3
    ensure result == false
    return failure == 0 or failure == 1

def cmpxchg_acqrel_seqcst_is_rejected(success: i64, failure: i64) -> bool:
    requires success == 3 and failure == 4
    ensure result == false
    return failure == 0 or failure == 1

def cmpxchg_seqcst_release_is_rejected(success: i64, failure: i64) -> bool:
    requires success == 4 and failure == 2
    ensure result == false
    return failure == 0 or failure == 1 or failure == 4

def cmpxchg_seqcst_acqrel_is_rejected(success: i64, failure: i64) -> bool:
    requires success == 4 and failure == 3
    ensure result == false
    return failure == 0 or failure == 1 or failure == 4
