include "./module_symbol_path_matcher.elisa"

def dotted_separator_is_an_absolute_module_path() -> bool can[Abort.Panic]:
    names: darray[sview] = ["Outer", "Inner"]
    ensure result == true
    return SemanticModuleSymbolPathMatcher::absolute("Outer.Inner", "", names, 0, 2)

def one_byte_enclosing_suffix_is_a_scope_boundary() -> bool can[Abort.Panic]:
    names: darray[sview] = ["Leaf"]
    ensure result == true
    return SemanticModuleSymbolPathMatcher::relative("A::Leaf", "A:", names, 1)

def empty_relative_path_matches_a_module() -> bool can[Abort.Panic]:
    names: darray[sview] = []
    ensure result == true
    return SemanticModuleSymbolPathMatcher::relative("A::", "A", names, 0)
