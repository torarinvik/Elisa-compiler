include "./backend_literal_utf8_boundaries.elisa"

def false_utf8_two_byte_min_is_c180() -> bool:
    ensure result == true
    return 194 * 256 + 128 == 49408

def false_utf8_d7ff_is_ee9fbf() -> bool:
    ensure result == true
    return 237 * 65536 + 159 * 256 + 191 == 15638463

def false_utf8_e000_is_ed8080() -> bool:
    ensure result == true
    return 238 * 65536 + 128 * 256 + 128 == 15564928

def false_utf8_minimum_supplementary_scalar_has_f1_lead() -> bool:
    ensure result == true
    return 241 * 16777216 + 144 * 65536 + 128 * 256 + 128 == 4036001920

def false_utf8_maximum_scalar_has_f5_lead() -> bool:
    ensure result == true
    return 245 * 16777216 + 143 * 65536 + 191 * 256 + 191 == 4103061439
