# The safe membership helper agrees with first-match search and its byte witness.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

def contains_byte_agrees_with_search_result(view: sview, byte: u8) -> bool:
    ensure result == true
    return sview_contains_byte(view, byte) == (sview_find_byte(view, byte) >= 0)

def a_true_contains_result_has_a_first_matching_offset(view: sview, byte: u8) -> bool:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    requires sview_contains_byte(view, byte)
    ensure result == true
    found: i64 = sview_find_byte(view, byte)
    return (
        found >= 0 and found < view.len
        and string_view_index(view, found) == byte.i64()
        and (forall prior in 0..<found: string_view_index(view, prior) != byte.i64())
    )

def a_false_contains_result_means_no_matching_offset(view: sview, byte: u8) -> bool:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    requires not sview_contains_byte(view, byte)
    ensure result == true
    return forall candidate in 0..<view.len: string_view_index(view, candidate) != byte.i64()
