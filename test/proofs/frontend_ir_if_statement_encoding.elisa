# Source-linked laws for the statement-form IfStmt schema mapping.
include "../../src/driver/frontend_ir_if_statement_encoding.elisa"

const EXPECTED_IF_STMT_NODE_TYPE_ID: u32 = 133
const EXPECTED_IF_CONDITION_FIELD_ID: u32 = 1
const EXPECTED_IF_ELSE_BODY_FIELD_ID: u32 = 3
const EXPECTED_IF_FROM_SOURCE_FIELD_ID: u32 = 4
const EXPECTED_IF_POSITION_FIELD_ID: u32 = 6
const EXPECTED_IF_THEN_BODY_FIELD_ID: u32 = 7

def source_if_statement_node_type_id_is_exact() -> u32:
    ensure result == EXPECTED_IF_STMT_NODE_TYPE_ID
    return FrontendIrIfStatementEncoding::node_type_id()

def source_if_statement_field_id_is_exact(field: FrontendIrIfStatementEncoding::IfStmtField) -> u32:
    ensure field != FrontendIrIfStatementEncoding::IfStmtField.Condition or result == EXPECTED_IF_CONDITION_FIELD_ID
    ensure field != FrontendIrIfStatementEncoding::IfStmtField.ElseBody or result == EXPECTED_IF_ELSE_BODY_FIELD_ID
    ensure field != FrontendIrIfStatementEncoding::IfStmtField.FromSource or result == EXPECTED_IF_FROM_SOURCE_FIELD_ID
    ensure field != FrontendIrIfStatementEncoding::IfStmtField.Position or result == EXPECTED_IF_POSITION_FIELD_ID
    ensure field != FrontendIrIfStatementEncoding::IfStmtField.ThenBody or result == EXPECTED_IF_THEN_BODY_FIELD_ID
    return FrontendIrIfStatementEncoding::field_id(field)

def if_statement_field_ids_are_distinct() -> bool:
    ensure result == true
    return (
        FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.Condition)
            != FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.ElseBody)
        and FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.Condition)
            != FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.FromSource)
        and FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.Condition)
            != FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.Position)
        and FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.Condition)
            != FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.ThenBody)
        and FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.ElseBody)
            != FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.FromSource)
        and FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.ElseBody)
            != FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.Position)
        and FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.ElseBody)
            != FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.ThenBody)
        and FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.FromSource)
            != FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.Position)
        and FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.FromSource)
            != FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.ThenBody)
        and FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.Position)
            != FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.ThenBody)
    )
