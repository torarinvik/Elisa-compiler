# The contract model is source-checked against Semantic.int_fits_storage's i8 branch.
def proof_const_enum_i8_fits(value: i64) -> bool:
    ensure result == (value >= (0 - 128) and value <= 127)
    return value >= (0 - 128) and value <= 127

def const_enum_i8_accepts_in_range(value: i64) -> bool:
    requires value >= (0 - 128) and value <= 127
    ensure result == true
    return proof_const_enum_i8_fits(value)

def const_enum_i8_rejects_below_range(value: i64) -> bool:
    requires value < (0 - 128)
    ensure result == true
    return not proof_const_enum_i8_fits(value)

def const_enum_i8_rejects_above_range(value: i64) -> bool:
    requires value > 127
    ensure result == true
    return not proof_const_enum_i8_fits(value)
