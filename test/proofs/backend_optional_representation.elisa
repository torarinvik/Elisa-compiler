# Proofs for the backend's niche/tagged optional representation decisions.
include "../../src/backend/codegen_optional_representation_policy.elisa"

def pointer_payload_partition_is_exact(is_ref: bool, is_cstr: bool, is_fn: bool, is_pyobject: bool) -> bool:
    ensure result == true
    return (
        BackendOptionalRepresentationPolicy::pointer_payload_uses_niche(is_ref, is_cstr, is_fn, is_pyobject)
        == (is_ref or is_cstr or is_fn or is_pyobject)
    )

def tagged_null_test_partition_is_exact(force_null_test: bool, is_cstr: bool, is_heap_ref: bool) -> bool:
    ensure result == true
    return (
        BackendOptionalRepresentationPolicy::tagged_payload_needs_null_test(force_null_test, is_cstr, is_heap_ref)
        == (force_null_test or is_cstr or is_heap_ref)
    )

def reference_payload_uses_the_null_niche() -> bool:
    ensure result == true
    return BackendOptionalRepresentationPolicy::pointer_payload_uses_niche(true, false, false, false)

def c_string_payload_uses_the_null_niche() -> bool:
    ensure result == true
    return BackendOptionalRepresentationPolicy::pointer_payload_uses_niche(false, true, false, false)

def function_payload_uses_the_null_niche() -> bool:
    ensure result == true
    return BackendOptionalRepresentationPolicy::pointer_payload_uses_niche(false, false, true, false)

def python_object_payload_uses_the_null_niche() -> bool:
    ensure result == true
    return BackendOptionalRepresentationPolicy::pointer_payload_uses_niche(false, false, false, true)

def scalar_payload_uses_the_tagged_representation() -> bool:
    ensure result == false
    return BackendOptionalRepresentationPolicy::pointer_payload_uses_niche(false, false, false, false)

def ordinary_nonnull_tagged_payload_keeps_constant_presence() -> bool:
    ensure result == false
    return BackendOptionalRepresentationPolicy::tagged_payload_needs_null_test(false, false, false)

def c_string_tagged_payload_tests_for_null() -> bool:
    ensure result == true
    return BackendOptionalRepresentationPolicy::tagged_payload_needs_null_test(false, true, false)

def heap_reference_tagged_payload_tests_for_null() -> bool:
    ensure result == true
    return BackendOptionalRepresentationPolicy::tagged_payload_needs_null_test(false, false, true)

def forced_tagged_payload_tests_for_null() -> bool:
    ensure result == true
    return BackendOptionalRepresentationPolicy::tagged_payload_needs_null_test(true, false, false)
