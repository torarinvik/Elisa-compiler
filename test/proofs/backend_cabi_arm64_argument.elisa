# On arm64, nonempty aggregates use direct C parts when they are HFA or at most
# sixteen bytes; larger non-HFAs and unflattenable aggregates use a pointer.
def arm64_aggregate_argument_is_indirect(size: i64, flat_ok: bool, hfa_count: i64) -> bool:
    requires size >= 0 and hfa_count >= 0
    ensure result == (size > 0 and (not flat_ok or (hfa_count == 0 and size > 16)))
    return size > 0 and (not flat_ok or (hfa_count == 0 and size > 16))

def arm64_eight_byte_nonhfa_is_direct(size: i64, flat_ok: bool) -> bool:
    requires size == 8 and flat_ok
    ensure not result
    return false

def arm64_sixteen_byte_nonhfa_is_direct(size: i64, flat_ok: bool) -> bool:
    requires size == 16 and flat_ok
    ensure not result
    return false

def arm64_over_sixteen_nonhfa_is_indirect(size: i64, flat_ok: bool) -> bool:
    requires size > 16 and flat_ok
    ensure result
    return true

def arm64_large_hfa_is_still_direct(size: i64, flat_ok: bool, hfa_count: i64) -> bool:
    requires size > 16 and flat_ok and hfa_count > 0
    ensure not result
    return false

def arm64_empty_aggregate_is_not_indirect(size: i64) -> bool:
    requires size == 0
    ensure not result
    return false
