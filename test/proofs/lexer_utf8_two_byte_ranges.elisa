# Prove the scalar intervals generated by the two-byte UTF-8 classes used by identifier scans.
# check_lexer_utf8_codepoint.py ties this normalized arithmetic to the production decoder formula.
include "../../src/lexer/lexer_utf8_codepoint_constants.elisa"

def latin1_byte_pair_decode_range(first: i64, second: i64) -> bool:
    requires first >= UTF8_TWO_BYTE_LEAD_MIN and first <= UTF8_TWO_BYTE_LATIN1_LEAD_MAX
    requires second >= UTF8_CONTINUATION_MIN and second <= UTF8_CONTINUATION_MAX
    ensure result == true
    decoded: i64 = (first - UTF8_TWO_BYTE_LEAD_PAYLOAD_OFFSET) * UTF8_TWO_BYTE_LEAD_PLACE_VALUE + second - UTF8_CONTINUATION_MIN
    return decoded >= UTF8_TWO_BYTE_SCALAR_MIN and decoded <= 255

def unicode2_byte_pair_decode_range(first: i64, second: i64) -> bool:
    requires first >= UTF8_TWO_BYTE_UNICODE2_LEAD_MIN and first <= UTF8_TWO_BYTE_LEAD_MAX
    requires second >= UTF8_CONTINUATION_MIN and second <= UTF8_CONTINUATION_MAX
    ensure result == true
    decoded: i64 = (first - UTF8_TWO_BYTE_LEAD_PAYLOAD_OFFSET) * UTF8_TWO_BYTE_LEAD_PLACE_VALUE + second - UTF8_CONTINUATION_MIN
    return decoded >= 256 and decoded <= UTF8_TWO_BYTE_SCALAR_MAX

def arabic_indic_digit_byte_pair_decode_range(first: i64, second: i64) -> bool:
    requires first == 217 and second >= 160 and second <= 169
    ensure result == true
    decoded: i64 = (first - UTF8_TWO_BYTE_LEAD_PAYLOAD_OFFSET) * UTF8_TWO_BYTE_LEAD_PLACE_VALUE + second - UTF8_CONTINUATION_MIN
    return decoded >= 1632 and decoded <= 1641

def extended_arabic_indic_digit_byte_pair_decode_range(first: i64, second: i64) -> bool:
    requires first == 219 and second >= 176 and second <= 185
    ensure result == true
    decoded: i64 = (first - UTF8_TWO_BYTE_LEAD_PAYLOAD_OFFSET) * UTF8_TWO_BYTE_LEAD_PLACE_VALUE + second - UTF8_CONTINUATION_MIN
    return decoded >= 1776 and decoded <= 1785

def nko_digit_byte_pair_decode_range(first: i64, second: i64) -> bool:
    requires first == 223 and second >= 128 and second <= 137
    ensure result == true
    decoded: i64 = (first - UTF8_TWO_BYTE_LEAD_PAYLOAD_OFFSET) * UTF8_TWO_BYTE_LEAD_PLACE_VALUE + second - UTF8_CONTINUATION_MIN
    return decoded >= 1984 and decoded <= 1993
