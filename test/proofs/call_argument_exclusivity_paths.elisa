# Source-bound laws for same-call alias path overlap. The production helper
# returns overlap unless a common-prefix step proves different fields or
# distinct literal indices.
include "../../src/semantic/check_call_argument_exclusivity_paths.elisa"

def production_path_scan_matches_recursive_model(kinds: darray[u8]&, names: darray[sview]&, values: darray[i64]&, a_start: usize, a_count: usize, b_start: usize, b_count: usize) -> bool:
    ensure result == true
    actual: bool = CallArgumentExclusivityPaths::paths_overlap(kinds, names, values, a_start, a_count, b_start, b_count)
    expected: bool = CallArgumentExclusivityPaths::overlap_reference(kinds, names, values, a_start, a_count, b_start, b_count)
    return actual == expected

def different_sibling_fields_are_disjoint() -> bool:
    ensure result == true
    kinds: darray[u8] = [0, 0]
    names: darray[sview] = ["left", "right"]
    values: darray[i64] = [0, 0]
    return not CallArgumentExclusivityPaths::paths_overlap(kinds, names, values, 0, 1, 1, 1)

def different_literal_indices_are_disjoint() -> bool:
    ensure result == true
    kinds: darray[u8] = [1, 1]
    names: darray[sview] = ["", ""]
    values: darray[i64] = [4, 9]
    return not CallArgumentExclusivityPaths::paths_overlap(kinds, names, values, 0, 1, 1, 1)

def equal_literal_indices_overlap() -> bool:
    ensure result == true
    kinds: darray[u8] = [1, 1]
    names: darray[sview] = ["", ""]
    values: darray[i64] = [7, 7]
    return CallArgumentExclusivityPaths::paths_overlap(kinds, names, values, 0, 1, 1, 1)

def unknown_index_may_alias_a_literal_index() -> bool:
    ensure result == true
    kinds: darray[u8] = [1, 2]
    names: darray[sview] = ["", ""]
    values: darray[i64] = [4, 99]
    return CallArgumentExclusivityPaths::paths_overlap(kinds, names, values, 0, 1, 1, 1)

def a_path_prefix_overlaps_its_extension() -> bool:
    ensure result == true
    kinds: darray[u8] = [0, 0]
    names: darray[sview] = ["payload", "field"]
    values: darray[i64] = [0, 0]
    return CallArgumentExclusivityPaths::paths_overlap(kinds, names, values, 0, 1, 0, 2)

def an_empty_path_overlaps_every_nonempty_path() -> bool:
    ensure result == true
    kinds: darray[u8] = [0]
    names: darray[sview] = ["field"]
    values: darray[i64] = [0]
    return CallArgumentExclusivityPaths::paths_overlap(kinds, names, values, 0, 0, 0, 1)

def later_disjoint_steps_make_paths_disjoint() -> bool:
    ensure result == true
    kinds: darray[u8] = [0, 1, 0, 1]
    names: darray[sview] = ["payload", "", "payload", ""]
    values: darray[i64] = [0, 3, 0, 8]
    return not CallArgumentExclusivityPaths::paths_overlap(kinds, names, values, 0, 2, 2, 2)

def two_empty_paths_overlap() -> bool:
    ensure result == true
    kinds: darray[u8] = []
    names: darray[sview] = []
    values: darray[i64] = []
    return CallArgumentExclusivityPaths::paths_overlap(kinds, names, values, 0, 0, 0, 0)

def malformed_path_ranges_cannot_prove_disjointness() -> bool:
    ensure result == true
    kinds: darray[u8] = [0]
    names: darray[sview] = ["field"]
    values: darray[i64] = [0]
    return CallArgumentExclusivityPaths::paths_overlap(kinds, names, values, 1, 1, 0, 1)
