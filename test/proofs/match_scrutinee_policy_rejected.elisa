# False claims against the float/bool match-scrutinee rejection boundary.
include "./match_scrutinee_policy.elisa"

def false_claim_float_scrutinee_is_matchable() -> bool:
    ensure result == true
    return not SemanticMatchScrutineePolicy::kind_is_unmatchable(Semantic::SemTypeKind.Float)

def false_claim_bool_scrutinee_is_matchable() -> bool:
    ensure result == true
    return not SemanticMatchScrutineePolicy::kind_is_unmatchable(Semantic::SemTypeKind.Bool)

def false_claim_integer_scrutinee_is_unmatchable() -> bool:
    ensure result == true
    return SemanticMatchScrutineePolicy::kind_is_unmatchable(Semantic::SemTypeKind.Int)
