# Source-linked closed-set proof for static-string spellings used by branch joins.
include "../../src/semantic/static_string_spelling.elisa"

def source_predicate_has_exact_spelling_set(spelling: sview) -> bool:
    ensure when spelling:
        "lit" | "mixed" | "static u8&" -> result == true
        _ -> result == false
    return StaticStringSpelling::participates_in_static_join(spelling)

def every_join_spelling_is_recognized() -> bool:
    ensure result == true
    return (
        StaticStringSpelling::participates_in_static_join("lit")
        and StaticStringSpelling::participates_in_static_join("mixed")
        and StaticStringSpelling::participates_in_static_join("static u8&")
    )

def nearby_spellings_do_not_join() -> bool:
    ensure result == true
    return (
        not StaticStringSpelling::participates_in_static_join("")
        and not StaticStringSpelling::participates_in_static_join("static mutable u8&")
        and not StaticStringSpelling::participates_in_static_join("sview")
    )
