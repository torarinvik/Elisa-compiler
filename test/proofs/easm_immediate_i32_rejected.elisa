include "./easm_immediate_i32.elisa"

def false_below_i32_immediate_is_accepted(parsed_valid: bool, value: i64) -> bool:
    requires parsed_valid and value == -2147483649
    ensure result == true
    return parsed_valid and value >= -2147483648 and value <= 2147483647

def false_above_i32_immediate_is_accepted(parsed_valid: bool, value: i64) -> bool:
    requires parsed_valid and value == 2147483648
    ensure result == true
    return parsed_valid and value >= -2147483648 and value <= 2147483647

def false_invalid_immediate_compatibility_value_is_nonzero(parsed_valid: bool, parsed_value: i64) -> i64:
    requires not parsed_valid
    ensure result == 7
    return parsed_value if parsed_valid else 0
