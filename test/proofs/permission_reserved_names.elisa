# Source-linked laws for the sealed alias-family and reserved top-permission name rules.
include "../../src/semantic/permission_reserved_names.elisa"

def sealed_alias_family_set_is_exact(name: sview) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return PermissionReservedNames::is_sealed_alias_family(name) == (when name:
            "Segment" | "Unsafe" | "Memory" | "Abort" | "Sync" | "Atomics" | "Console" | "Blocking" | "Global" -> true
            _ -> false
        )

def reserved_top_permission_declaration_is_exact(owner: sview, name: sview) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return PermissionReservedNames::is_reserved_top_permission_declaration(owner, name) == (owner == "__permission_decl" and name == "any")

def abstract_effect_family_remains_aliasable() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not PermissionReservedNames::is_sealed_alias_family("IO")

def only_the_permission_declaration_marker_reserves_any() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not PermissionReservedNames::is_reserved_top_permission_declaration("__permission_alias", "any")
