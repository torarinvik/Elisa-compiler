# On 32-bit targets, DArray usize counts are zero-extended into the backend's
# i64 loop slots. The full u32 range is therefore nonnegative and safely below
# i64 overflow for the cursor increment and remaining-count decrement.
const U32_MAX: i64 = 4294967295

def pointer_walk_countdown_step_decreases(remaining: i64) -> bool:
    requires remaining > 0 and remaining <= U32_MAX
    ensure result == true
    return remaining - 1 < remaining

def pointer_walk_countdown_next_stays_in_range(remaining: i64) -> bool:
    requires remaining > 0 and remaining <= U32_MAX
    ensure result == true
    return remaining - 1 >= 0 and remaining - 1 <= U32_MAX

def pointer_walk_cursor_step_stays_within_count(count: i64, cursor: i64) -> bool:
    requires count >= 0 and count <= U32_MAX
    requires cursor >= 0 and cursor < count
    ensure result == true
    return cursor + 1 <= count

def maximum_u32_cursor_step_reaches_one_past_end() -> bool:
    ensure result == true
    return (U32_MAX - 1) + 1 == U32_MAX

def final_positive_remaining_step_reaches_zero() -> bool:
    ensure result == true
    return 1 - 1 == 0
