# The caller allocates and stores exactly when the ABI requires an indirect argument.
def indirect_aggregate_argument_allocates_slot(indirect: bool) -> bool:
    ensure result == indirect
    return indirect

def indirect_aggregate_argument_stores_value(indirect: bool) -> bool:
    ensure result == indirect
    return indirect

def direct_aggregate_argument_uses_original_value(indirect: bool) -> bool:
    ensure result == not indirect
    return not indirect
