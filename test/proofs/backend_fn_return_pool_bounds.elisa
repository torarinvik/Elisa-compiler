# A first-class function return-type pool is read only after the type-kind and
# pool-index guards have both accepted the lookup.
def fn_return_pool_read_is_selected(is_fn: bool, index_in_bounds: bool) -> bool:
    ensure result == (is_fn and index_in_bounds)
    return is_fn and index_in_bounds

def non_function_never_reads_fn_return_pool(is_fn: bool, index_in_bounds: bool) -> bool:
    requires not is_fn
    ensure result == false
    return is_fn and index_in_bounds

def out_of_range_function_never_reads_fn_return_pool(is_fn: bool, index_in_bounds: bool) -> bool:
    requires is_fn and not index_in_bounds
    ensure result == false
    return is_fn and index_in_bounds

def in_range_function_reads_fn_return_pool(is_fn: bool, index_in_bounds: bool) -> bool:
    requires is_fn and index_in_bounds
    ensure result == true
    return is_fn and index_in_bounds
