# Arithmetic model for the fixed-array diagnostic guard. Its source checker pins this exact
# i64 predicate to the diagnostic path before the actual index is narrowed for display.
def proof_reports_index_out_of_bounds(index: i64, size: i64, checked: bool) -> bool:
    ensure result == ((index >= size or index < 0) and not checked)
    return (index >= size or index < 0) and not checked

def in_range_index_is_not_reported(index: i64, size: i64) -> bool:
    requires index >= 0 and index < size
    ensure result == true
    return not proof_reports_index_out_of_bounds(index, size, false)

def negative_index_is_reported(index: i64, size: i64) -> bool:
    requires index < 0
    ensure result == true
    return proof_reports_index_out_of_bounds(index, size, false)

def index_at_or_above_extent_is_reported(index: i64, size: i64) -> bool:
    requires index >= size
    ensure result == true
    return proof_reports_index_out_of_bounds(index, size, false)

def checked_get_suppresses_bounds_diagnostic(index: i64, size: i64, checked: bool) -> bool:
    requires checked
    ensure result == true
    return not proof_reports_index_out_of_bounds(index, size, checked)

def wide_index_is_checked_before_display_narrowing(index: i64, size: i64) -> bool:
    requires index > 4294967295 and size <= 4294967295
    ensure result == true
    return proof_reports_index_out_of_bounds(index, size, false)
