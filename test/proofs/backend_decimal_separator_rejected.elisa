# Deliberately false: a separator on the final byte has a following byte in range.
def final_byte_separator_has_an_in_range_successor(index: usize, length: usize) -> bool:
    requires index < length
    requires length - index <= 1
    ensure result == true
    return index + 1 < length

def leading_separator_is_accepted() -> bool:
    ensure result == true
    return 0 < 0 and 0 < 5 and 5 - 0 > 1 and 0 >= 48 and 0 <= 57 and 49 >= 48 and 49 <= 57

def trailing_separator_is_accepted() -> bool:
    ensure result == true
    return 0 < 4 and 4 < 5 and 5 - 4 > 1 and 48 >= 48 and 48 <= 57 and 0 >= 48 and 0 <= 57

def doubled_separator_is_accepted() -> bool:
    ensure result == true
    return 0 < 1 and 1 < 6 and 6 - 1 > 1 and 49 >= 48 and 49 <= 57 and 95 >= 48 and 95 <= 57
