include "./backend_cabi_hfa.elisa"

def false_fifth_leaf_is_hfa(leaf_count: i64) -> bool:
    requires leaf_count == 5
    ensure result
    return leaf_count <= 4

def false_integer_first_leaf_is_hfa(first_leaf_is_float: bool) -> bool:
    requires not first_leaf_is_float
    ensure result
    return first_leaf_is_float

def false_gap_in_hfa_is_accepted(offsets_are_contiguous: bool) -> bool:
    requires not offsets_are_contiguous
    ensure result
    return offsets_are_contiguous
