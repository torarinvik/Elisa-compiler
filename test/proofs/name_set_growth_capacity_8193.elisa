# The next power-of-two threshold after the 4,097th insertion.
def name_set_capacity_sixteen_thousand_three_hundred_eighty_four_covers_next_four_thousand_ninety_six_insertions(name_count: usize) -> bool:
    requires name_count >= 4096 and name_count <= 8191
    ensure result == true
    return 16384 >= (name_count + 1) * 2

def name_set_eight_thousand_one_hundred_ninety_third_entry_doubles_capacity(name_count: usize) -> usize:
    requires name_count == 8192
    ensure result == 32768
    return 32768 if 16384 < (name_count + 1) * 2 else 16384

def eight_thousand_one_hundred_ninety_third_name_rehash_keeps_twenty_four_thousand_five_hundred_seventy_five_slots_empty(name_count: usize) -> usize:
    requires name_count == 8192
    ensure result == 24575
    return (32768 if 16384 < (name_count + 1) * 2 else 16384) - (name_count + 1)
