# False controls for sparse eligibility, SoA marker identity, owner scope, and present layouts.
include "../../src/semantic/sparse_soa_policy.elisa"

def an_aos_enum_is_sparse() -> bool:
    ensure result == true
    return SparseSoaPolicy::is_named_sparse_enum("__layout_aos", "Payload")

def an_ownerless_sparse_annotation_is_eligible() -> bool:
    ensure result == true
    return SparseSoaPolicy::is_named_sparse_enum("__layout_sparse", "")

def a_c_layout_marker_satisfies_the_soa_requirement() -> bool:
    ensure result == true
    return SparseSoaPolicy::soa_marker_belongs_to_owner("__layout_c", "Payload", "Payload")

def a_marker_for_another_enum_satisfies_the_requirement() -> bool:
    ensure result == true
    return SparseSoaPolicy::soa_marker_belongs_to_owner("__layout_soa", "Other", "Payload")

def a_present_soa_marker_should_be_reported_missing() -> bool:
    ensure result == true
    return SparseSoaPolicy::should_report_missing_soa(true)
