# The proof projection pins the production TokenKind order through the checker,
# while these functions directly include the production code and display maps.
include "./lexer_token_proof_model.elisa"
type TokenKind = Lexer::TokenKind
include "../../src/parser/token_kind_spelling.elisa"

def rangele_uses_its_stage0_spelling() -> bool:
    ensure result == true
    code: u64 = emit_tokens_kind_code(TokenKind.RangeLe)
    return code == TOKEN_KIND_CODE_RANGE_LE and token_kind_display_name(code - 1) == "..="

def owned_has_a_distinct_stage1_code_and_spelling() -> bool:
    ensure result == true
    owned_code: u64 = emit_tokens_kind_code(TokenKind.Owned)
    rangele_code: u64 = emit_tokens_kind_code(TokenKind.RangeLe)
    return owned_code == TOKEN_KIND_CODE_OWNED and owned_code != rangele_code and token_kind_display_name(owned_code - 1) == "owned"

def fstring_uses_its_stage1_spelling() -> bool:
    ensure result == true
    return token_kind_display_name(emit_tokens_kind_code(TokenKind.FString) - 1) == "FSTRING"

def loop_label_uses_its_stage1_spelling() -> bool:
    ensure result == true
    return token_kind_display_name(emit_tokens_kind_code(TokenKind.Label) - 1) == "LABEL"

def token_kind_code_is_injective(left: TokenKind, right: TokenKind) -> bool:
    requires left != right
    ensure result == true
    return emit_tokens_kind_code(left) != emit_tokens_kind_code(right)
