# Source-linked proof of nested Python error-payload helper suffix selection.
include "../../src/driver/pymodule_error_helper_names.elisa"

def every_nonoptional_helper_name_is_preserved() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            PymoduleErrorHelperNames::nested_darray_helper_suffix("i8") == "i8"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("i16") == "i16"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("i32") == "i32"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("i64") == "i64"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("int") == "int"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("isize") == "isize"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("char") == "char"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("u8") == "u8"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("u16") == "u16"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("u32") == "u32"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("u64") == "u64"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("usize") == "usize"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("uintptr") == "uintptr"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("f32") == "f32"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("f64") == "f64"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("bool") == "bool"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("cstr") == "cstr"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("sview") == "sview"
        )

def optional_and_object_helper_names_are_distinct() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            PymoduleErrorHelperNames::nested_darray_helper_suffix("cstr?") == "cstr_optional"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("sview?") == "sview_optional"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("py::Object") == "object"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("py::Object?") == "object_optional"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("i8?") == "i8_optional"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("i16?") == "i16_optional"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("i32?") == "i32_optional"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("i64?") == "i64_optional"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("int?") == "int_optional"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("isize?") == "isize_optional"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("char?") == "char_optional"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("u8?") == "u8_optional"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("u16?") == "u16_optional"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("u32?") == "u32_optional"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("u64?") == "u64_optional"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("usize?") == "usize_optional"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("uintptr?") == "uintptr_optional"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("bool?") == "bool_optional"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("f32?") == "f32_optional"
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("f64?") == "f64_optional"
        )

def nearby_unhandled_names_have_no_helper() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            PymoduleErrorHelperNames::nested_darray_helper_suffix("") == ""
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("String") == ""
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("py::Object??") == ""
            and PymoduleErrorHelperNames::nested_darray_helper_suffix("u128?") == ""
        )
