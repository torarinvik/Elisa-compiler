# Source-linked laws for merging region provenance from alternative value paths.
# A stack-local region is shorter-lived than a parameter or untracked region, and
# when both alternatives are local the deeper (greater-position) region must win.

def right_region_is_selected(left_nonempty: bool,
    left_found: bool,
    left_position: usize,
    right_found: bool,
    right_position: usize) -> bool:
    ensure result == ((right_found and (not left_found or right_position > left_position)) or not left_nonempty)
    return (right_found and (not left_found or right_position > left_position)) or not left_nonempty

def inner_right_region_dominates_outer_left(left_nonempty: bool,
    left_position: usize,
    right_position: usize) -> bool:
    requires left_nonempty and right_position > left_position
    ensure result == true
    return right_region_is_selected(left_nonempty, true, left_position, true, right_position)

def local_right_region_dominates_untracked_left(left_nonempty: bool,
    left_position: usize,
    right_position: usize) -> bool:
    requires left_nonempty
    ensure result == true
    return right_region_is_selected(left_nonempty, false, left_position, true, right_position)

def local_left_region_survives_untracked_right(left_position: usize,
    right_position: usize) -> bool:
    ensure result == false
    return right_region_is_selected(true, true, left_position, false, right_position)

def empty_left_region_is_filled_from_right(left_position: usize,
    right_found: bool,
    right_position: usize) -> bool:
    ensure result == true
    return right_region_is_selected(false, false, left_position, right_found, right_position)
