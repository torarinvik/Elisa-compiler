include "../../src/driver/never_leak_cli_flags.elisa"

def strict_warning_alias_is_unrecognized() -> bool:
    ensure result == true
    return NeverLeakCliFlags::classify("-Wnever-leak=strict") == NeverLeakCliFlags::Action.Unrecognized

def error_alias_selects_warning_mode() -> bool:
    ensure result == true
    return NeverLeakCliFlags::classify("error=never-leak") == NeverLeakCliFlags::Action.Warn

def unrelated_flag_is_accepted() -> bool:
    ensure result == true
    return NeverLeakCliFlags::classify("-Wbounds") != NeverLeakCliFlags::Action.Unrecognized
