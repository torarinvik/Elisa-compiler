# These formulas model the source-level distinction between a packed-store
# allocation ordinal and a NodeKey. NodeKey is erased to i32, so type alone
# cannot select the runtime path; the checker binds these predicates to codegen.
def packed_store_index_is_direct_handle(is_packed_store: bool, packed_mode: i64, is_integer_literal: bool, is_signed_i32: bool) -> bool:
    ensure result == (is_packed_store and packed_mode != 2 and is_signed_i32 and not is_integer_literal)
    return is_packed_store and packed_mode != 2 and is_signed_i32 and not is_integer_literal

def packed_store_index_is_ordinal_lookup(is_packed_store: bool, packed_mode: i64, is_integer_literal: bool, is_signed_i32: bool) -> bool:
    ensure result == (is_packed_store and packed_mode != 2 and is_integer_literal)
    return is_packed_store and packed_mode != 2 and is_integer_literal

def packed_store_index_is_declined(is_packed_store: bool, packed_mode: i64, is_integer_literal: bool, is_signed_i32: bool) -> bool:
    ensure result == (not (is_packed_store and packed_mode != 2 and is_signed_i32 and not is_integer_literal) and not (is_packed_store and packed_mode != 2 and is_integer_literal))
    return not (is_packed_store and packed_mode != 2 and is_signed_i32 and not is_integer_literal) and not (is_packed_store and packed_mode != 2 and is_integer_literal)

def integer_literal_i32_uses_ordinal_lookup() -> bool:
    ensure result == true
    return true and 0 != 2 and true

def integer_literal_i32_does_not_use_direct_handle() -> bool:
    ensure result == true
    return not (true and 0 != 2 and true and not true)

def nonliteral_signed_i32_uses_direct_handle() -> bool:
    ensure result == true
    return true and 0 != 2 and true and not false

def node_key_uses_direct_handle_route() -> bool:
    ensure result == true
    return packed_store_index_is_direct_handle(true, 0, false, true)

def nonliteral_other_width_declines() -> bool:
    ensure result == true
    return not true or 0 == 2 or (not false and not false)

def packed_aos_mode_declines() -> bool:
    ensure result == true
    return not true or 2 == 2 or (not true and not true)

def nonpacked_receiver_declines() -> bool:
    ensure result == true
    return not false or 0 == 2 or (not true and not true)

def no_input_can_take_both_packed_store_routes(is_packed_store: bool, packed_mode: i64, is_integer_literal: bool, is_signed_i32: bool) -> bool:
    ensure result == true
    return not ((is_packed_store and packed_mode != 2 and is_signed_i32 and not is_integer_literal) and (is_packed_store and packed_mode != 2 and is_integer_literal))

def every_index_is_routed_or_declined(is_packed_store: bool, packed_mode: i64, is_integer_literal: bool, is_signed_i32: bool) -> bool:
    ensure result == true
    direct: bool = is_packed_store and packed_mode != 2 and is_signed_i32 and not is_integer_literal
    ordinal: bool = is_packed_store and packed_mode != 2 and is_integer_literal
    return direct or ordinal or (not direct and not ordinal)

# The runtime ordinal helper accepts only a nonnegative ordinal below count.
# Its usize parameters supply nonnegativity; the source checker binds this model
# to the helper's `index < state.indices.count` assertion before table access.
def packed_store_ordinal_in_bounds(index: i64, count: i64) -> bool:
    requires index >= 0 and count >= 0 and index < count
    ensure result == true
    return index >= 0 and index < count

def ordinal_equal_to_count_is_out_of_bounds(index: i64, count: i64) -> bool:
    requires index == count
    ensure result == false
    return index < count

def empty_store_has_no_nonnegative_ordinal(index: i64) -> bool:
    requires index >= 0
    ensure result == false
    return index < 0

# Allocation appends one handle and one index-table entry. Starting both counts
# at zero and preserving this one-step invariant keeps each new global handle
# stored at its matching allocation ordinal.
def packed_store_empty_columns_are_aligned() -> bool:
    ensure result == true
    return 0 == 0

def packed_store_global_index_cast_fits_u32(handle_count: i64) -> bool:
    requires handle_count >= 0 and handle_count < 4294967295
    ensure result == true
    return handle_count <= 4294967294

def packed_store_next_metadata_count_fits_u32_limit(handle_count: i64) -> bool:
    requires handle_count >= 0 and handle_count < 4294967295
    ensure result == true
    return handle_count + 1 <= 4294967295

def packed_store_append_preserves_index_alignment(handle_count: i64, index_count: i64, global_index: i64, append_ordinal: i64) -> bool:
    requires handle_count == index_count
    requires global_index == handle_count
    requires append_ordinal == index_count
    requires handle_count >= 0 and handle_count < 4294967295
    ensure result == true
    return global_index == append_ordinal and handle_count + 1 == index_count + 1
