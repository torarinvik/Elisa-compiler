# One-step preservation cases for the f-string interpolation invariant:
# depth >= 1 and depth <= consumed + 1, where consumed counts bytes since expr_start.
# The source-bound checker ties these transitions to the u32-bounded token scanner.
def interpolation_open_establishes_cursor_depth_bound() -> (depth: i64, consumed: i64):
    ensure result.depth == 1
    ensure result.consumed == 0
    ensure result.depth >= 1 and result.depth <= result.consumed + 1
    return (depth: 1, consumed: 0)

def expression_open_preserves_cursor_depth_bound(depth: i64, consumed: i64) -> (depth: i64, consumed: i64):
    requires depth >= 1 and consumed >= 0 and depth <= consumed + 1
    requires consumed < 9223372036854775805
    ensure result.depth >= 1
    ensure result.depth <= result.consumed + 1
    return (depth: depth + 1, consumed: consumed + 1)

def expression_nested_close_preserves_cursor_depth_bound(depth: i64, consumed: i64) -> (depth: i64, consumed: i64):
    requires depth > 1 and consumed >= 0 and depth <= consumed + 1
    requires consumed < 9223372036854775805
    ensure result.depth >= 1
    ensure result.depth <= result.consumed + 1
    return (depth: depth - 1, consumed: consumed + 1)

def expression_other_preserves_cursor_depth_bound(depth: i64, consumed: i64) -> (depth: i64, consumed: i64):
    requires depth >= 1 and consumed >= 0 and depth <= consumed + 1
    requires consumed < 9223372036854775805
    ensure result.depth >= 1
    ensure result.depth <= result.consumed + 1
    return (depth: depth, consumed: consumed + 1)

def inner_string_escape_preserves_cursor_depth_bound(depth: i64, consumed: i64) -> (depth: i64, consumed: i64):
    requires depth >= 1 and consumed >= 0 and depth <= consumed + 1
    requires consumed < 9223372036854775804
    ensure result.depth >= 1
    ensure result.depth <= result.consumed + 1
    return (depth: depth, consumed: consumed + 2)

def inner_string_other_preserves_cursor_depth_bound(depth: i64, consumed: i64) -> (depth: i64, consumed: i64):
    requires depth >= 1 and consumed >= 0 and depth <= consumed + 1
    requires consumed < 9223372036854775805
    ensure result.depth >= 1
    ensure result.depth <= result.consumed + 1
    return (depth: depth, consumed: consumed + 1)
