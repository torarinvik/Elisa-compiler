include "../../src/semantic/integer_literal_window.elisa"

def lower_endpoint_is_excluded(low: i64, high: i64) -> bool:
    requires low <= high
    ensure result == false
    return SemanticIntegerLiteral::value_fits_signed_window(low, low, high)

def upper_endpoint_is_excluded(low: i64, high: i64) -> bool:
    requires low <= high
    ensure result == false
    return SemanticIntegerLiteral::value_fits_signed_window(high, low, high)

def a_value_below_the_window_fits(value: i64, low: i64, high: i64) -> bool:
    requires value < low and low <= high
    ensure result == true
    return SemanticIntegerLiteral::value_fits_signed_window(value, low, high)

def a_value_above_the_window_fits(value: i64, low: i64, high: i64) -> bool:
    requires high < value and low <= high
    ensure result == true
    return SemanticIntegerLiteral::value_fits_signed_window(value, low, high)

def false_missing_window_reports_overflow(window_found: bool, value_found: bool, value: i64, low: i64, high: i64) -> bool:
    requires not window_found
    ensure result == true
    return SemanticIntegerLiteral::value_is_outside_window_if_known(window_found, value_found, value, low, high)

def false_missing_literal_reports_overflow(window_found: bool, value_found: bool, value: i64, low: i64, high: i64) -> bool:
    requires window_found and not value_found
    ensure result == true
    return SemanticIntegerLiteral::value_is_outside_window_if_known(window_found, value_found, value, low, high)

def false_below_value_is_ignored(value: i64, low: i64, high: i64) -> bool:
    requires value < low and low <= high
    ensure result == true
    return not SemanticIntegerLiteral::value_is_outside_window_if_known(true, true, value, low, high)

def false_lower_endpoint_reports_overflow(low: i64, high: i64) -> bool:
    requires low <= high
    ensure result == true
    return SemanticIntegerLiteral::value_is_outside_window_if_known(true, true, low, low, high)

def false_interior_value_reports_overflow(value: i64, low: i64, high: i64) -> bool:
    requires low <= value and value <= high
    ensure result == true
    return SemanticIntegerLiteral::value_is_outside_window_if_known(true, true, value, low, high)

def false_upper_endpoint_reports_overflow(low: i64, high: i64) -> bool:
    requires low <= high
    ensure result == true
    return SemanticIntegerLiteral::value_is_outside_window_if_known(true, true, high, low, high)

def false_above_value_is_ignored(value: i64, low: i64, high: i64) -> bool:
    requires high < value and low <= high
    ensure result == true
    return not SemanticIntegerLiteral::value_is_outside_window_if_known(true, true, value, low, high)
