include "../../src/semantic/integer_literal_window.elisa"

def lower_endpoint_is_excluded(low: i64, high: i64) -> bool:
    requires low <= high
    ensure result == false
    return SemanticIntegerLiteral::value_fits_signed_window(low, low, high)

def upper_endpoint_is_excluded(low: i64, high: i64) -> bool:
    requires low <= high
    ensure result == false
    return SemanticIntegerLiteral::value_fits_signed_window(high, low, high)

def a_value_below_the_window_fits(value: i64, low: i64, high: i64) -> bool:
    requires value < low and low <= high
    ensure result == true
    return SemanticIntegerLiteral::value_fits_signed_window(value, low, high)

def a_value_above_the_window_fits(value: i64, low: i64, high: i64) -> bool:
    requires high < value and low <= high
    ensure result == true
    return SemanticIntegerLiteral::value_fits_signed_window(value, low, high)
