# The negative-pattern conversion is called only for a nonnegative i64 magnitude;
# the i64 minimum takes the dedicated construction path in the backend parser.

def nonnegative_magnitude_cannot_be_i64_min(magnitude: i64) -> bool:
    requires magnitude >= 0
    ensure result == true
    return magnitude != (0 - 9223372036854775807 - 1)

def nonnegative_magnitude_is_negated_exactly(magnitude: i64) -> i64:
    requires magnitude >= 0
    ensure result == (0 - magnitude)
    return 0 - magnitude

def negative_i64_maximum_is_above_the_minimum() -> bool:
    ensure result == true
    return (0 - 9223372036854775807) > (0 - 9223372036854775807 - 1)
