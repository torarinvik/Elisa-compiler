# Incorrect exported-name claims must be rejected by proof replay.
include "../../src/backend/c_header_export_alias.elisa"

def explicit_alias_must_not_lose_to_target() -> bool:
    ensure result == true
    return CHeaderExportAlias::public_name("internal_seed", "public_seed") == "internal_seed"

def empty_alias_must_not_replace_target() -> bool:
    ensure result == true
    return CHeaderExportAlias::public_name("internal_seed", "") == ""

def empty_alias_must_not_invent_a_different_public_name() -> bool:
    ensure result == true
    return CHeaderExportAlias::public_name("internal_seed", "") == "public_seed"
