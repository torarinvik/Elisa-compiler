include "./backend_cabi_wasm_return.elisa"

def false_multiple_leaf_aggregate_returns_directly(leaf_count: i64) -> bool:
    requires leaf_count == 2
    ensure not result
    return leaf_count != 1

def false_unflattenable_aggregate_returns_directly(flat_ok: bool) -> bool:
    requires not flat_ok
    ensure not result
    return not flat_ok

def false_zero_sized_aggregate_uses_sret(size: i64) -> bool:
    requires size == 0
    ensure result
    return size > 0
