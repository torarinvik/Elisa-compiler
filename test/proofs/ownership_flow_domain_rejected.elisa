include "../../src/semantic/ownership_flow_domain.elisa"

def false_join_discards_consumed(other: bool) -> bool:
    ensure result == false
    return OwnershipFlow::join_possible(true, other)

def false_unknown_is_known(other: bool) -> bool:
    ensure result == true
    return OwnershipFlow::join_known(false, other)

def false_consumed_can_move() -> bool:
    ensure result == true
    return OwnershipFlow::can_move(true, true, true)

def false_unknown_can_move() -> bool:
    ensure result == true
    return OwnershipFlow::can_move(false, true, false)

def false_join_drops_peer(a: bool, b: bool) -> bool:
    ensure result == a
    return OwnershipFlow::join_possible(a, b)

def false_join_changes_operator(a: bool, b: bool) -> void:
    ensure OwnershipFlow::join_possible(a, b) == OwnershipFlow::join_known(a, b)
    _ = OwnershipFlow::join_possible(a, b)
    _ = OwnershipFlow::join_known(a, b)
    return

def false_known_uses_or(a: bool, b: bool) -> bool:
    ensure result == (a or b)
    return OwnershipFlow::join_known(a, b)
