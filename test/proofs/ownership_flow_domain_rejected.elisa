include "../../src/semantic/ownership_flow_domain.elisa"

def false_join_discards_consumed(other: bool) -> bool:
    ensure result == false
    return OwnershipFlow::join_possible(true, other)

def false_unknown_is_known(other: bool) -> bool:
    ensure result == true
    return OwnershipFlow::join_known(false, other)

def false_consumed_can_move() -> bool:
    ensure result == true
    return OwnershipFlow::can_move(true, true, true)

def false_unknown_can_move() -> bool:
    ensure result == true
    return OwnershipFlow::can_move(false, true, false)
