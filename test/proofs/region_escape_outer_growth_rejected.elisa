def growing_in_the_active_region_is_an_escape(owner_is_active_region: bool) -> bool:
    requires owner_is_active_region
    ensure result == true
    return not owner_is_active_region

def unknown_sibling_owner_is_an_ancestor_escape(owner_is_on_region_stack: bool,
    owner_is_region_parameter: bool) -> bool:
    requires not owner_is_on_region_stack and not owner_is_region_parameter
    ensure result == true
    return owner_is_on_region_stack or owner_is_region_parameter

def region_arena_value_receiver_still_gets_growth_diagnostic(receiver_is_region_arena_value: bool) -> bool:
    requires receiver_is_region_arena_value
    ensure result == true
    return not receiver_is_region_arena_value
