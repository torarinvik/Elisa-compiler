include "./self_assignment_policy.elisa"

def a_new_binding_of_the_same_name_is_reported() -> bool:
    ensure result == true
    return SelfAssignmentPolicy::should_report(Lexer::TokenKind.Assign, "value", "value")

def mutation_of_a_different_name_is_reported() -> bool:
    ensure result == true
    return SelfAssignmentPolicy::should_report(Lexer::TokenKind.LArrow, "left", "right")

def another_operator_on_the_same_name_is_reported() -> bool:
    ensure result == true
    return SelfAssignmentPolicy::should_report(Lexer::TokenKind.Plus, "value", "value")
