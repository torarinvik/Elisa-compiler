include "../../src/semantic/ownership_flow_domain.elisa"

def dead_back_edge_can_flip_entry(entry: bool, back: bool) -> bool:
    ensure result == (not entry)
    return OwnershipFlow::join_reachable_possible(true, entry, false, back)

def unknown_back_edge_grants_knowledge(entry: bool) -> bool:
    requires entry
    ensure result == true
    return OwnershipFlow::join_reachable_known(true, entry, true, false)
