# Prove the register bit allocation and ABI masks consumed by the EASM verifier.
include "../../src/backend/easm_register_masks.elisa"

def register_bit_matches_its_exhaustive_alias_spec(register: sview) -> bool:
    ensure result == true
    return EasmRegisterMasks::register_bit(register) == (when register:
        "rax" | "eax" | "ax" | "al" -> EasmRegisterMasks::RAX
        "rcx" | "ecx" | "cx" | "cl" -> EasmRegisterMasks::RCX
        "rdx" | "edx" | "dx" | "dl" -> EasmRegisterMasks::RDX
        "rbx" | "ebx" | "bx" | "bl" -> EasmRegisterMasks::RBX
        "rsi" | "esi" | "si" | "sil" -> EasmRegisterMasks::RSI
        "rdi" | "edi" | "di" | "dil" -> EasmRegisterMasks::RDI
        "rbp" | "ebp" | "bp" | "bpl" -> EasmRegisterMasks::RBP
        "rsp" | "esp" | "sp" | "spl" -> EasmRegisterMasks::RSP
        "r8" | "r8d" | "r8w" | "r8b" -> EasmRegisterMasks::R8
        "r9" | "r9d" | "r9w" | "r9b" -> EasmRegisterMasks::R9
        "r10" | "r10d" | "r10w" | "r10b" -> EasmRegisterMasks::R10
        "r11" | "r11d" | "r11w" | "r11b" -> EasmRegisterMasks::R11
        "r12" | "r12d" | "r12w" | "r12b" -> EasmRegisterMasks::R12
        "r13" | "r13d" | "r13w" | "r13b" -> EasmRegisterMasks::R13
        "r14" | "r14d" | "r14w" | "r14b" -> EasmRegisterMasks::R14
        "r15" | "r15d" | "r15w" | "r15b" -> EasmRegisterMasks::R15
        _ -> 0
    )

def every_supported_register_alias_selects_its_canonical_bit() -> bool:
    ensure result == true
    return (
        EasmRegisterMasks::register_bit("rax") == EasmRegisterMasks::RAX
        and EasmRegisterMasks::register_bit("eax") == EasmRegisterMasks::RAX
        and EasmRegisterMasks::register_bit("ax") == EasmRegisterMasks::RAX
        and EasmRegisterMasks::register_bit("al") == EasmRegisterMasks::RAX
        and EasmRegisterMasks::register_bit("rcx") == EasmRegisterMasks::RCX
        and EasmRegisterMasks::register_bit("ecx") == EasmRegisterMasks::RCX
        and EasmRegisterMasks::register_bit("cx") == EasmRegisterMasks::RCX
        and EasmRegisterMasks::register_bit("cl") == EasmRegisterMasks::RCX
        and EasmRegisterMasks::register_bit("rdx") == EasmRegisterMasks::RDX
        and EasmRegisterMasks::register_bit("edx") == EasmRegisterMasks::RDX
        and EasmRegisterMasks::register_bit("dx") == EasmRegisterMasks::RDX
        and EasmRegisterMasks::register_bit("dl") == EasmRegisterMasks::RDX
        and EasmRegisterMasks::register_bit("rbx") == EasmRegisterMasks::RBX
        and EasmRegisterMasks::register_bit("ebx") == EasmRegisterMasks::RBX
        and EasmRegisterMasks::register_bit("bx") == EasmRegisterMasks::RBX
        and EasmRegisterMasks::register_bit("bl") == EasmRegisterMasks::RBX
        and EasmRegisterMasks::register_bit("rsi") == EasmRegisterMasks::RSI
        and EasmRegisterMasks::register_bit("esi") == EasmRegisterMasks::RSI
        and EasmRegisterMasks::register_bit("si") == EasmRegisterMasks::RSI
        and EasmRegisterMasks::register_bit("sil") == EasmRegisterMasks::RSI
        and EasmRegisterMasks::register_bit("rdi") == EasmRegisterMasks::RDI
        and EasmRegisterMasks::register_bit("edi") == EasmRegisterMasks::RDI
        and EasmRegisterMasks::register_bit("di") == EasmRegisterMasks::RDI
        and EasmRegisterMasks::register_bit("dil") == EasmRegisterMasks::RDI
        and EasmRegisterMasks::register_bit("rbp") == EasmRegisterMasks::RBP
        and EasmRegisterMasks::register_bit("ebp") == EasmRegisterMasks::RBP
        and EasmRegisterMasks::register_bit("bp") == EasmRegisterMasks::RBP
        and EasmRegisterMasks::register_bit("bpl") == EasmRegisterMasks::RBP
        and EasmRegisterMasks::register_bit("rsp") == EasmRegisterMasks::RSP
        and EasmRegisterMasks::register_bit("esp") == EasmRegisterMasks::RSP
        and EasmRegisterMasks::register_bit("sp") == EasmRegisterMasks::RSP
        and EasmRegisterMasks::register_bit("spl") == EasmRegisterMasks::RSP
        and EasmRegisterMasks::register_bit("r8") == EasmRegisterMasks::R8
        and EasmRegisterMasks::register_bit("r8d") == EasmRegisterMasks::R8
        and EasmRegisterMasks::register_bit("r8w") == EasmRegisterMasks::R8
        and EasmRegisterMasks::register_bit("r8b") == EasmRegisterMasks::R8
        and EasmRegisterMasks::register_bit("r9") == EasmRegisterMasks::R9
        and EasmRegisterMasks::register_bit("r9d") == EasmRegisterMasks::R9
        and EasmRegisterMasks::register_bit("r9w") == EasmRegisterMasks::R9
        and EasmRegisterMasks::register_bit("r9b") == EasmRegisterMasks::R9
        and EasmRegisterMasks::register_bit("r10") == EasmRegisterMasks::R10
        and EasmRegisterMasks::register_bit("r10d") == EasmRegisterMasks::R10
        and EasmRegisterMasks::register_bit("r10w") == EasmRegisterMasks::R10
        and EasmRegisterMasks::register_bit("r10b") == EasmRegisterMasks::R10
        and EasmRegisterMasks::register_bit("r11") == EasmRegisterMasks::R11
        and EasmRegisterMasks::register_bit("r11d") == EasmRegisterMasks::R11
        and EasmRegisterMasks::register_bit("r11w") == EasmRegisterMasks::R11
        and EasmRegisterMasks::register_bit("r11b") == EasmRegisterMasks::R11
        and EasmRegisterMasks::register_bit("r12") == EasmRegisterMasks::R12
        and EasmRegisterMasks::register_bit("r12d") == EasmRegisterMasks::R12
