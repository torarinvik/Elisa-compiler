# Prove the register bit allocation and ABI masks consumed by the EASM verifier.
include "../../src/backend/easm_register_masks.elisa"

def every_register_has_its_canonical_one_hot_bit() -> bool:
    ensure result == true
    return (
        EasmRegisterMasks::RAX == 1
        and EasmRegisterMasks::RCX == 2
        and EasmRegisterMasks::RDX == 4
        and EasmRegisterMasks::RBX == 8
        and EasmRegisterMasks::RSI == 16
        and EasmRegisterMasks::RDI == 32
        and EasmRegisterMasks::RBP == 64
        and EasmRegisterMasks::RSP == 128
        and EasmRegisterMasks::R8 == 256
        and EasmRegisterMasks::R9 == 512
        and EasmRegisterMasks::R10 == 1024
        and EasmRegisterMasks::R11 == 2048
        and EasmRegisterMasks::R12 == 4096
        and EasmRegisterMasks::R13 == 8192
        and EasmRegisterMasks::R14 == 16384
        and EasmRegisterMasks::R15 == 32768
    )

# These low seven masks fit the prover's width-independent [0, 127] constant
# fragment. The higher register bits need a typed-width replay rule before we
# can claim their pairwise disjointness through `&`.
def low_seven_register_masks_are_pairwise_disjoint() -> bool:
    ensure result == true
    return (
        (EasmRegisterMasks::RAX & EasmRegisterMasks::RCX) == 0
        and (EasmRegisterMasks::RAX & EasmRegisterMasks::RDX) == 0
        and (EasmRegisterMasks::RAX & EasmRegisterMasks::RBX) == 0
        and (EasmRegisterMasks::RAX & EasmRegisterMasks::RSI) == 0
        and (EasmRegisterMasks::RAX & EasmRegisterMasks::RDI) == 0
        and (EasmRegisterMasks::RAX & EasmRegisterMasks::RBP) == 0
        and (EasmRegisterMasks::RCX & EasmRegisterMasks::RDX) == 0
        and (EasmRegisterMasks::RCX & EasmRegisterMasks::RBX) == 0
        and (EasmRegisterMasks::RCX & EasmRegisterMasks::RSI) == 0
        and (EasmRegisterMasks::RCX & EasmRegisterMasks::RDI) == 0
        and (EasmRegisterMasks::RCX & EasmRegisterMasks::RBP) == 0
        and (EasmRegisterMasks::RDX & EasmRegisterMasks::RBX) == 0
        and (EasmRegisterMasks::RDX & EasmRegisterMasks::RSI) == 0
        and (EasmRegisterMasks::RDX & EasmRegisterMasks::RDI) == 0
        and (EasmRegisterMasks::RDX & EasmRegisterMasks::RBP) == 0
        and (EasmRegisterMasks::RBX & EasmRegisterMasks::RSI) == 0
        and (EasmRegisterMasks::RBX & EasmRegisterMasks::RDI) == 0
        and (EasmRegisterMasks::RBX & EasmRegisterMasks::RBP) == 0
        and (EasmRegisterMasks::RSI & EasmRegisterMasks::RDI) == 0
        and (EasmRegisterMasks::RSI & EasmRegisterMasks::RBP) == 0
        and (EasmRegisterMasks::RDI & EasmRegisterMasks::RBP) == 0
    )

def call_clobber_mask_is_exactly_the_caller_saved_union() -> bool:
    ensure result == true
    return EasmRegisterMasks::call_clobber_mask() == (
        EasmRegisterMasks::RAX | EasmRegisterMasks::RCX | EasmRegisterMasks::RDX
        | EasmRegisterMasks::RSI | EasmRegisterMasks::RDI | EasmRegisterMasks::R8
        | EasmRegisterMasks::R9 | EasmRegisterMasks::R10 | EasmRegisterMasks::R11
    )

def call_invalidation_mask_is_exactly_the_non_result_caller_saved_union() -> bool:
    ensure result == true
    return EasmRegisterMasks::call_invalidates_live_mask() == (
        EasmRegisterMasks::RCX | EasmRegisterMasks::RDX | EasmRegisterMasks::RSI
        | EasmRegisterMasks::RDI | EasmRegisterMasks::R8 | EasmRegisterMasks::R9
        | EasmRegisterMasks::R10 | EasmRegisterMasks::R11
    )

def callee_saved_gpr_mask_is_exactly_the_callee_saved_register_union() -> bool:
    ensure result == true
    return EasmRegisterMasks::callee_saved_gpr_mask() == (
        EasmRegisterMasks::RBX | EasmRegisterMasks::RBP | EasmRegisterMasks::R12
        | EasmRegisterMasks::R13 | EasmRegisterMasks::R14 | EasmRegisterMasks::R15
    )

def cpuid_and_rdtsc_implicit_masks_match_their_register_effects() -> bool:
    ensure result == true
    return (
        EasmRegisterMasks::cpuid_read_mask() == (EasmRegisterMasks::RAX | EasmRegisterMasks::RCX)
        and EasmRegisterMasks::cpuid_write_mask() == (
            EasmRegisterMasks::RAX | EasmRegisterMasks::RBX
            | EasmRegisterMasks::RCX | EasmRegisterMasks::RDX
        )
        and EasmRegisterMasks::rdtsc_write_mask() == (EasmRegisterMasks::RAX | EasmRegisterMasks::RDX)
    )
