        and EasmRegisterMasks::register_bit("r13") == EasmRegisterMasks::R13
        and EasmRegisterMasks::register_bit("r13d") == EasmRegisterMasks::R13
        and EasmRegisterMasks::register_bit("r13w") == EasmRegisterMasks::R13
        and EasmRegisterMasks::register_bit("r13b") == EasmRegisterMasks::R13
        and EasmRegisterMasks::register_bit("r14") == EasmRegisterMasks::R14
