def signed_i8_branch_is_exact(kind: i64, bits: i64) -> i64:
    requires kind == 1 and bits == 8
    ensure result == 1
    return 1 if kind == 1 and bits == 8 else 0

def signed_i16_branch_is_exact(kind: i64, bits: i64) -> i64:
    requires kind == 1 and bits == 16
    ensure result == 2
    return 2 if kind == 1 and bits == 16 else 0

def signed_i32_branch_is_exact(kind: i64, bits: i64) -> i64:
    requires kind == 1 and bits == 32
    ensure result == 3
    return 3 if kind == 1 and bits == 32 else 0

def signed_i64_branch_is_exact(kind: i64, bits: i64) -> i64:
    requires kind == 1 and bits == 64
    ensure result == 4
    return 4 if kind == 1 and bits == 64 else 0

def unsigned_u8_branch_is_exact(kind: i64, bits: i64) -> i64:
    requires kind == 2 and bits == 8
    ensure result == 5
    return 5 if kind == 2 and bits == 8 else 0

def unsigned_u16_branch_is_exact(kind: i64, bits: i64) -> i64:
    requires kind == 2 and bits == 16
    ensure result == 6
    return 6 if kind == 2 and bits == 16 else 0

def unsigned_u32_branch_is_exact(kind: i64, bits: i64) -> i64:
    requires kind == 2 and bits == 32
    ensure result == 7
    return 7 if kind == 2 and bits == 32 else 0

def unsigned_u64_branch_is_exact(kind: i64, bits: i64) -> i64:
    requires kind == 2 and bits == 64
    ensure result == 8
    return 8 if kind == 2 and bits == 64 else 0

def float_f32_branch_is_exact(kind: i64, bits: i64) -> i64:
    requires kind == 3 and bits == 32
    ensure result == 9
    return 9 if kind == 3 and bits == 32 else 0

def float_f64_branch_is_exact(kind: i64, bits: i64) -> i64:
    requires kind == 3 and bits == 64
    ensure result == 10
    return 10 if kind == 3 and bits == 64 else 0

def bool_branch_is_exact(kind: i64, bits: i64) -> i64:
    requires kind == 4
    ensure result == 11
    return 11 if kind == 4 else 0

