# Source-span bounds for EASM fragment arguments.
include "../../src/backend/easm_model.elisa"
include "../../src/backend/easm_text_scan.elisa"
include "../../src/backend/easm_compose_text.elisa"

def a_bare_colon_line_is_not_a_label() -> bool:
    ensure result == true
    instruction: Easm::Instruction = Easm::easm_parse_instruction(":", 0)
    return instruction.op != "label"

def a_whitespace_only_colon_line_is_not_a_label() -> bool:
    ensure result == true
    instruction: Easm::Instruction = Easm::easm_parse_instruction(" \t :", 0)
    return instruction.op != "label"

def compose_argument_count_matches_the_recursive_comma_model(text: sview) -> bool:
    ensure result == true
    count: i64 = Easm::easm_compose_argument_count(text)
    trimmed: sview = EasmTextScan::trim(text)
    return (trimmed.len == 0 and count == 0) or (
        trimmed.len > 0
        and count == Easm::easm_compose_comma_count_from(trimmed, 0.usize()) + 1
    )

def compose_parser_count_matches_the_span_argument_count(text: sview) -> bool:
    ensure result == true
    info: Easm::ComposeInfo = Easm::easm_parse_compose(text)
    return not info.valid or info.argument_count == Easm::easm_compose_span_argument_count(text)

def implementation_matches_the_recursive_span_spec(text: sview, wanted: i64) -> bool:
    ensure result == true
    actual: Easm::ComposeSpan = Easm::easm_compose_span(text, wanted)
    expected: Easm::ComposeSpan = Easm::easm_compose_span_reference(text, wanted)
    return actual.valid == expected.valid and actual.start == expected.start and actual.end == expected.end

def every_valid_compose_span_is_bounded(text: sview, wanted: i64) -> bool:
    ensure result == true
    span: Easm::ComposeSpan = Easm::easm_compose_span(text, wanted)
    return not span.valid or (span.start <= span.end and span.end <= text.len)

def every_in_range_argument_index_has_a_valid_span(text: sview, wanted: i64) -> bool:
    requires wanted >= 0 and wanted < Easm::easm_compose_span_argument_count(text)
    ensure result == true
    span: Easm::ComposeSpan = Easm::easm_compose_span(text, wanted)
    return span.valid

def every_invalid_compose_span_has_the_zero_sentinel(text: sview, wanted: i64) -> bool:
    ensure result == true
    span: Easm::ComposeSpan = Easm::easm_compose_span(text, wanted)
    return span.valid or (span.start == 0 and span.end == 0)

def first_argument_span_excludes_outer_spaces() -> bool:
    ensure result == true
    instruction: sview = "compose copy(  dst , src\t)"
    span: Easm::ComposeSpan = Easm::easm_compose_span(instruction, 0)
    return span.valid and instruction[span.start:span.end] == "dst"

def later_argument_span_selects_the_requested_segment() -> bool:
    ensure result == true
    instruction: sview = "compose copy(dst, \tsrc  , end)"
    span: Easm::ComposeSpan = Easm::easm_compose_span(instruction, 1)
    return span.valid and instruction[span.start:span.end] == "src"

def final_argument_span_reaches_the_closing_boundary() -> bool:
    ensure result == true
    instruction: sview = "compose copy(dst, end)"
    span: Easm::ComposeSpan = Easm::easm_compose_span(instruction, 1)
    return span.valid and instruction[span.start:span.end] == "end"

def absent_argument_span_uses_the_invalid_sentinel() -> bool:
    ensure result == true
    span: Easm::ComposeSpan = Easm::easm_compose_span("compose copy(dst)", 1)
    return not span.valid and span.start == 0 and span.end == 0

def missing_open_paren_uses_the_invalid_sentinel() -> bool:
    ensure result == true
    span: Easm::ComposeSpan = Easm::easm_compose_span("compose copy", 0)
    return not span.valid and span.start == 0 and span.end == 0
