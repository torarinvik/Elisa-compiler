# The production four-byte decoder's raw-byte guard bounds its normalized payloads
# to the Unicode scalar interval, including the special F0 and F4 boundary checks.
include "../../src/lexer/lexer_utf8_codepoint_constants.elisa"
include "../../src/lexer/lexer_utf8_codepoint_wide.elisa"

def valid_four_byte_sequence_decodes_to_unicode_scalar(first: i64, second: i64, third: i64, fourth: i64) -> bool:
    requires first >= UTF8_FOUR_BYTE_LEAD_MIN and first <= UTF8_FOUR_BYTE_LEAD_MAX
    requires second >= UTF8_CONTINUATION_MIN and second <= UTF8_CONTINUATION_MAX
    requires third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX
    requires fourth >= UTF8_CONTINUATION_MIN and fourth <= UTF8_CONTINUATION_MAX
    requires first > UTF8_FOUR_BYTE_LEAD_MIN or second >= UTF8_F0_SECOND_MIN
    requires first < UTF8_FOUR_BYTE_LEAD_MAX or second <= UTF8_F4_SECOND_MAX
    decoded: i64 = lexer_decode_utf8_four(first - UTF8_FOUR_BYTE_LEAD_MIN, second - UTF8_CONTINUATION_MIN, third - UTF8_CONTINUATION_MIN, fourth - UTF8_CONTINUATION_MIN)
    ensure result == (decoded >= UTF8_FOUR_BYTE_SCALAR_MIN and decoded <= UNICODE_SCALAR_MAX)
    ensure result implies decoded >= UTF8_FOUR_BYTE_SCALAR_MIN
    ensure result implies decoded <= UNICODE_SCALAR_MAX
    return decoded >= UTF8_FOUR_BYTE_SCALAR_MIN and decoded <= UNICODE_SCALAR_MAX
