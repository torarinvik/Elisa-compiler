# Source-linked proof for the container-family fallback used by semantic diagnostics.
include "../../src/semantic/semantic_api_growth_default_family.elisa"

def source_mapping_is_exact(method: sview) -> sview can[Abort.Panic]:
    ensure (result == "set") == (method == "add")
    ensure (result == "dict") == (method == "put" or method == "get_or_insert")
    ensure (result == "darray") == (method != "add" and method != "put" and method != "get_or_insert")
    can Abort.Panic:
        return SemanticApiGrowthDefaultFamily::growth_default_family(method)

def known_growth_methods_map_to_their_families() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            SemanticApiGrowthDefaultFamily::growth_default_family("add") == "set"
            and SemanticApiGrowthDefaultFamily::growth_default_family("put") == "dict"
            and SemanticApiGrowthDefaultFamily::growth_default_family("get_or_insert") == "dict"
        )

def other_methods_use_the_darray_fallback() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            SemanticApiGrowthDefaultFamily::growth_default_family("push") == "darray"
            and SemanticApiGrowthDefaultFamily::growth_default_family("") == "darray"
        )
