# Deliberately false: the span constructor stores the line input as line.
include "./lexer_token_proof_model.elisa"

def token_line_is_column(line: u32, column: u32, start: u32, length: u32, suffix_length: u16) -> bool:
    ensure result == true
    span: Lexer::TokenSpan = Lexer::token_span_fields(line, column, start, length, suffix_length)
    return span.line == column
