include "../../src/driver/frontend_ir_bounds.elisa"

def positive_schema_budget_has_a_smaller_recursive_budget(depth: u64) -> bool:
    requires depth > 0
    ensure result == true
    return frontend_ir_schema_budget_step_fits(depth) and depth - 1 < depth

def zero_schema_budget_is_rejected(depth: u64) -> bool:
    requires depth == 0
    ensure result == false
    return frontend_ir_schema_budget_step_fits(depth)
