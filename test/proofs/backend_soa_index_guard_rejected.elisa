include "./backend_soa_index_guard.elisa"

def false_claim_signed_negative_row_can_be_valid(unsigned_in_bounds: bool) -> bool:
    requires unsigned_in_bounds
    ensure result == true
    return soa_valid_guard(true, false, unsigned_in_bounds)

def false_claim_nonnegative_out_of_range_row_can_be_valid() -> bool:
    ensure result == true
    return soa_valid_guard(true, true, false)
