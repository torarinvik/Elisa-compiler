def region_growth_method_policy_is_exact(is_push: bool, is_extend: bool, is_insert: bool, is_resize: bool, is_reserve: bool, is_put: bool, is_add: bool, is_append: bool) -> bool:
    ensure result == (is_push or is_extend or is_insert or is_resize or is_reserve or is_put or is_add or is_append)
    return is_push or is_extend or is_insert or is_resize or is_reserve or is_put or is_add or is_append

def no_named_mutator_means_no_region_growth(is_push: bool, is_extend: bool, is_insert: bool, is_resize: bool, is_reserve: bool, is_put: bool, is_add: bool, is_append: bool) -> bool:
    requires not is_push and not is_extend and not is_insert and not is_resize and not is_reserve and not is_put and not is_add and not is_append
    ensure result == false
    return is_push or is_extend or is_insert or is_resize or is_reserve or is_put or is_add or is_append

def appending_is_classified_as_region_growth(is_push: bool, is_extend: bool, is_insert: bool, is_resize: bool, is_reserve: bool, is_put: bool, is_add: bool, is_append: bool) -> bool:
    requires not is_push and not is_extend and not is_insert and not is_resize and not is_reserve and not is_put and not is_add and is_append
    ensure result == true
    return is_push or is_extend or is_insert or is_resize or is_reserve or is_put or is_add or is_append

def explicit_allocator_helper_policy_is_exact(has_dict_prefix: bool, has_set_prefix: bool) -> bool:
    ensure result == (has_dict_prefix or has_set_prefix)
    return has_dict_prefix or has_set_prefix

def dictionary_helpers_keep_their_explicit_allocator(has_dict_prefix: bool, has_set_prefix: bool) -> bool:
    requires has_dict_prefix and not has_set_prefix
    ensure result == true
    return has_dict_prefix or has_set_prefix

def set_helpers_keep_their_explicit_allocator(has_dict_prefix: bool, has_set_prefix: bool) -> bool:
    requires not has_dict_prefix and has_set_prefix
    ensure result == true
    return has_dict_prefix or has_set_prefix

def ordinary_helpers_do_not_keep_an_explicit_allocator(has_dict_prefix: bool, has_set_prefix: bool) -> bool:
    requires not has_dict_prefix and not has_set_prefix
    ensure result == false
    return has_dict_prefix or has_set_prefix
