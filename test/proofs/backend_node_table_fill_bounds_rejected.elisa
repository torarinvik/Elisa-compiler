include "./backend_node_table_fill_bounds.elisa"

def false_claim_wasm32_accepts_first_unrepresentable_count() -> bool:
    ensure result == true
    count: u64 = BackendCStrTerminatorPolicy::U32_MAX + 1
    return count <= BackendCStrTerminatorPolicy::target_size_max(BackendCStrTerminatorPolicy::POINTER_BITS_32)

def false_claim_u32_allocation_product_fits() -> bool:
    ensure result == true
    count: u64 = 65536
    stride: u64 = 65536
    return count * stride <= BackendCStrTerminatorPolicy::U32_MAX

def false_claim_empty_node_table_takes_the_fill_branch() -> bool:
    ensure result == true
    count: u64 = 0
    return count != 0
