# The source-facing proof checker binds these selector facts to error_callee_owner's ordered
# declarations: written owner, lexical owner, top-level declaration, then unique error fallback.
def unique_error_fallback_gate_is_exact(explicit_declared: bool, current_declared: bool, top_declared: bool, unique_error: bool) -> bool:
    ensure result == (not explicit_declared and not current_declared and not top_declared and unique_error)
    return not explicit_declared and not current_declared and not top_declared and unique_error

def explicit_owner_blocks_fallback(explicit_declared: bool, current_declared: bool, top_declared: bool, unique_error: bool) -> bool:
    requires explicit_declared and unique_error
    ensure result == false
    return not explicit_declared and not current_declared and not top_declared and unique_error

def ordinary_lexical_declaration_shields_unrelated_error(explicit_declared: bool, current_declared: bool, current_is_error: bool, top_declared: bool, unique_error: bool) -> bool:
    requires not explicit_declared and current_declared and not current_is_error and unique_error
    ensure result == true
    return not (not explicit_declared and not current_declared and not top_declared and unique_error)

def top_level_declaration_shields_unique_error(explicit_declared: bool, current_declared: bool, top_declared: bool, unique_error: bool) -> bool:
    requires not explicit_declared and not current_declared and top_declared and unique_error
    ensure result == true
    return not (not explicit_declared and not current_declared and not top_declared and unique_error)

def unique_error_is_used_only_after_all_declaration_misses(explicit_declared: bool, current_declared: bool, top_declared: bool, unique_error: bool) -> bool:
    requires not explicit_declared and not current_declared and not top_declared and unique_error
    ensure result == true
    return not explicit_declared and not current_declared and not top_declared and unique_error

def exactly_one_fallible_owner_enables_fallback(owner_hits: i64) -> bool:
    ensure result == (owner_hits == 1)
    return owner_hits == 1
