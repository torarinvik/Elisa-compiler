# Direct signed StringView length access.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"

def a_positive_length_cannot_become_zero(view: sview) -> bool:
    requires view.len > 0
    ensure result == true
    return view.len == 0

def a_negative_length_cannot_become_zero(view: sview) -> bool:
    requires view.len < 0
    ensure result == true
    return view.len == 0
