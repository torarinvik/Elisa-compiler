# False claims about StringView length normalization must remain unproved.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

def a_positive_representable_length_can_become_zero(view: sview) -> bool:
    requires view.len > 0 and view.len.usize().i64() == view.len
    ensure result == true
    return sview_len(view) == 0.usize()

def a_nonpositive_length_can_produce_a_nonzero_result(view: sview) -> bool:
    requires view.len <= 0
    ensure result == true
    return sview_len(view) != 0.usize()
