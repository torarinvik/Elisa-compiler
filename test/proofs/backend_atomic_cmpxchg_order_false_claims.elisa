# False claims about compare-exchange order-pair validity.

def cmpxchg_falsely_accepts_release_acquire(success: i64, failure: i64) -> bool:
    requires success == 2 and failure == 1
    ensure result == true
    return failure == 0

def cmpxchg_falsely_accepts_relaxed_acquire(success: i64, failure: i64) -> bool:
    requires success == 0 and failure == 1
    ensure result == true
    return failure == 0

def cmpxchg_falsely_accepts_acquire_seqcst(success: i64, failure: i64) -> bool:
    requires success == 1 and failure == 4
    ensure result == true
    return failure == 0 or failure == 1

def cmpxchg_falsely_accepts_seqcst_acqrel(success: i64, failure: i64) -> bool:
    requires success == 4 and failure == 3
    ensure result == true
    return failure == 0 or failure == 1 or failure == 4
