# Concrete malformed UTF-8 controls evaluated against every production acceptance arm.
# check_lexer_utf8_codepoint.py derives this predicate from starts_valid_utf8_sequence.
include "../../src/lexer/lexer_utf8_codepoint_constants.elisa"

def reject_overlong_two_byte_lead() -> bool:
    ensure result == false
    return (2 > 1 and (128 >= UTF8_CONTINUATION_MIN and 128 <= UTF8_CONTINUATION_MAX) and (192 >= UTF8_TWO_BYTE_LEAD_MIN and 192 <= UTF8_TWO_BYTE_LEAD_MAX)) or (2 > 2 and 128 >= UTF8_E0_SECOND_MIN and 128 <= UTF8_CONTINUATION_MAX and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (192 == UTF8_THREE_BYTE_LEAD_MIN)) or (2 > 2 and (128 >= UTF8_CONTINUATION_MIN and 128 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and ((192 > UTF8_THREE_BYTE_LEAD_MIN and 192 < UTF8_SURROGATE_LEAD) or (192 > UTF8_SURROGATE_LEAD and 192 <= UTF8_THREE_BYTE_LEAD_MAX))) or (2 > 2 and 128 >= UTF8_CONTINUATION_MIN and 128 <= UTF8_ED_SECOND_MAX and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (192 == UTF8_SURROGATE_LEAD)) or (2 > 3 and 128 >= UTF8_F0_SECOND_MIN and 128 <= UTF8_CONTINUATION_MAX and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (192 == UTF8_FOUR_BYTE_LEAD_MIN)) or (2 > 3 and (128 >= UTF8_CONTINUATION_MIN and 128 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (192 > UTF8_FOUR_BYTE_LEAD_MIN and 192 < UTF8_FOUR_BYTE_LEAD_MAX)) or (2 > 3 and 128 >= UTF8_CONTINUATION_MIN and 128 <= UTF8_F4_SECOND_MAX and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (192 == UTF8_FOUR_BYTE_LEAD_MAX))


def reject_c1_overlong_two_byte_lead() -> bool:
    ensure result == false
    return (2 > 1 and (128 >= UTF8_CONTINUATION_MIN and 128 <= UTF8_CONTINUATION_MAX) and (193 >= UTF8_TWO_BYTE_LEAD_MIN and 193 <= UTF8_TWO_BYTE_LEAD_MAX)) or (2 > 2 and 128 >= UTF8_E0_SECOND_MIN and 128 <= UTF8_CONTINUATION_MAX and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (193 == UTF8_THREE_BYTE_LEAD_MIN)) or (2 > 2 and (128 >= UTF8_CONTINUATION_MIN and 128 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and ((193 > UTF8_THREE_BYTE_LEAD_MIN and 193 < UTF8_SURROGATE_LEAD) or (193 > UTF8_SURROGATE_LEAD and 193 <= UTF8_THREE_BYTE_LEAD_MAX))) or (2 > 2 and 128 >= UTF8_CONTINUATION_MIN and 128 <= UTF8_ED_SECOND_MAX and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (193 == UTF8_SURROGATE_LEAD)) or (2 > 3 and 128 >= UTF8_F0_SECOND_MIN and 128 <= UTF8_CONTINUATION_MAX and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (193 == UTF8_FOUR_BYTE_LEAD_MIN)) or (2 > 3 and (128 >= UTF8_CONTINUATION_MIN and 128 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (193 > UTF8_FOUR_BYTE_LEAD_MIN and 193 < UTF8_FOUR_BYTE_LEAD_MAX)) or (2 > 3 and 128 >= UTF8_CONTINUATION_MIN and 128 <= UTF8_F4_SECOND_MAX and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (193 == UTF8_FOUR_BYTE_LEAD_MAX))

def reject_overlong_e0_sequence() -> bool:
    ensure result == false
    return (3 > 1 and (159 >= UTF8_CONTINUATION_MIN and 159 <= UTF8_CONTINUATION_MAX) and (224 >= UTF8_TWO_BYTE_LEAD_MIN and 224 <= UTF8_TWO_BYTE_LEAD_MAX)) or (3 > 2 and 159 >= UTF8_E0_SECOND_MIN and 159 <= UTF8_CONTINUATION_MAX and (128 >= UTF8_CONTINUATION_MIN and 128 <= UTF8_CONTINUATION_MAX) and (224 == UTF8_THREE_BYTE_LEAD_MIN)) or (3 > 2 and (159 >= UTF8_CONTINUATION_MIN and 159 <= UTF8_CONTINUATION_MAX) and (128 >= UTF8_CONTINUATION_MIN and 128 <= UTF8_CONTINUATION_MAX) and ((224 > UTF8_THREE_BYTE_LEAD_MIN and 224 < UTF8_SURROGATE_LEAD) or (224 > UTF8_SURROGATE_LEAD and 224 <= UTF8_THREE_BYTE_LEAD_MAX))) or (3 > 2 and 159 >= UTF8_CONTINUATION_MIN and 159 <= UTF8_ED_SECOND_MAX and (128 >= UTF8_CONTINUATION_MIN and 128 <= UTF8_CONTINUATION_MAX) and (224 == UTF8_SURROGATE_LEAD)) or (3 > 3 and 159 >= UTF8_F0_SECOND_MIN and 159 <= UTF8_CONTINUATION_MAX and (128 >= UTF8_CONTINUATION_MIN and 128 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (224 == UTF8_FOUR_BYTE_LEAD_MIN)) or (3 > 3 and (159 >= UTF8_CONTINUATION_MIN and 159 <= UTF8_CONTINUATION_MAX) and (128 >= UTF8_CONTINUATION_MIN and 128 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (224 > UTF8_FOUR_BYTE_LEAD_MIN and 224 < UTF8_FOUR_BYTE_LEAD_MAX)) or (3 > 3 and 159 >= UTF8_CONTINUATION_MIN and 159 <= UTF8_F4_SECOND_MAX and (128 >= UTF8_CONTINUATION_MIN and 128 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (224 == UTF8_FOUR_BYTE_LEAD_MAX))

