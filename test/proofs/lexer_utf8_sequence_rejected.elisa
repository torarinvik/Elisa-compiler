    return (1 > 1 and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (128 >= UTF8_TWO_BYTE_LEAD_MIN and 128 <= UTF8_TWO_BYTE_LEAD_MAX)) or (1 > 2 and 0 >= UTF8_E0_SECOND_MIN and 0 <= UTF8_CONTINUATION_MAX and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (128 == UTF8_THREE_BYTE_LEAD_MIN)) or (1 > 2 and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and ((128 > UTF8_THREE_BYTE_LEAD_MIN and 128 < UTF8_SURROGATE_LEAD) or (128 > UTF8_SURROGATE_LEAD and 128 <= UTF8_THREE_BYTE_LEAD_MAX))) or (1 > 2 and 0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_ED_SECOND_MAX and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (128 == UTF8_SURROGATE_LEAD)) or (1 > 3 and 0 >= UTF8_F0_SECOND_MIN and 0 <= UTF8_CONTINUATION_MAX and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (128 == UTF8_FOUR_BYTE_LEAD_MIN)) or (1 > 3 and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (128 > UTF8_FOUR_BYTE_LEAD_MIN and 128 < UTF8_FOUR_BYTE_LEAD_MAX)) or (1 > 3 and 0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_F4_SECOND_MAX and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (128 == UTF8_FOUR_BYTE_LEAD_MAX))
