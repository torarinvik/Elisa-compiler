# Source-linked transfer laws for deciding whether an expression can carry region-backed handles.

def tuple_handle_transfer_is_exact(any_element_carries_handle: bool) -> bool:
    ensure result == any_element_carries_handle
    return any_element_carries_handle

def empty_tuple_carries_no_region_handle() -> bool:
    ensure result == false
    return tuple_handle_transfer_is_exact(false)

def record_update_handle_transfer_is_exact(base_carries_handle: bool,
    any_updated_field_carries_handle: bool) -> bool:
    ensure result == (base_carries_handle or any_updated_field_carries_handle)
    return base_carries_handle or any_updated_field_carries_handle

def conditional_handle_transfer_is_exact(then_carries_handle: bool,
    else_carries_handle: bool) -> bool:
    ensure result == (then_carries_handle or else_carries_handle)
    return then_carries_handle or else_carries_handle

def array_literal_is_conservatively_treated_as_handle_carrying() -> bool:
    ensure result == true
    return true

def scalar_literal_carries_no_region_handle() -> bool:
    ensure result == false
    return false

def unknown_index_is_conservatively_treated_as_handle_carrying() -> bool:
    ensure result == true
    return true

def length_and_count_fields_carry_no_region_handle(is_length: bool,
    is_count: bool) -> bool:
    requires is_length or is_count
    ensure result == false
    return false
