# Scalar invariants for the stage1 counted-fill DArray cursor.
# Source binding in check_backend_fast_push_cursor.py connects these equations to
# cursor initialization, push advancement, body read rejection, and exit commit.

def fast_push_cursor_starts_at_existing_count(initial: u64, cursor: u64) -> bool:
    requires cursor == initial
    ensure result == true
    return cursor == initial

def fast_push_cursor_advances_by_one(current: u64, needed: u64) -> bool:
    requires current < 18446744073709551615u64
    requires needed == current + 1
    ensure result == true
    return needed == current + 1

def fast_push_cursor_update_stays_within_reserved_end(cursor: u64, reserved_end: u64) -> bool:
    requires cursor < reserved_end
    ensure result == true
    return cursor + 1 <= reserved_end

def fast_push_cursor_update_strictly_progresses(cursor: u64, reserved_end: u64) -> u64:
    requires cursor < reserved_end
    ensure result > cursor
    ensure reserved_end - result < reserved_end - cursor
    return cursor + 1

def fast_push_cursor_final_count_is_exact(initial: u64, iterations: u64, pushes_per_iteration: u64, final_count: u64) -> bool:
    requires pushes_per_iteration > 0
    requires iterations <= 16777216
    requires final_count == initial + iterations * pushes_per_iteration
    ensure result == true
    return final_count == initial + iterations * pushes_per_iteration

def fast_push_keeps_public_count_until_exit(initial: u64, public_count: u64, cursor: u64) -> bool:
    requires public_count == initial
    requires cursor >= initial
    ensure result == true
    return public_count == initial

def fast_push_count_observation_disables_cursor(reads_count: bool, cursor_enabled: bool) -> bool:
    requires cursor_enabled == not reads_count
    ensure result == true
    return cursor_enabled == not reads_count


