# Scalar invariants for the stage1 counted-fill DArray cursor.
# Source binding in check_backend_fast_push_cursor.py connects these equations to
# cursor initialization, push advancement, body read rejection, and exit commit.

def fast_push_cursor_starts_at_existing_count(initial: u64, cursor: u64) -> bool:
    requires cursor == initial
    ensure result == true
    return cursor == initial

def fast_push_cursor_advances_by_one(current: u64, needed: u64) -> bool:
    requires current < 18446744073709551615u64
    requires needed == current + 1
    ensure result == true
    return needed == current + 1

def fast_push_cursor_update_stays_within_reserved_end(cursor: u64, reserved_end: u64) -> bool:
    requires cursor < reserved_end
    ensure result == true
    return cursor + 1 <= reserved_end

def fast_push_cursor_update_strictly_progresses(cursor: u64, reserved_end: u64) -> u64:
    requires cursor < reserved_end
    ensure result > cursor
    ensure reserved_end - result < reserved_end - cursor
    return cursor + 1

# Inductive budget step for a fill: if at least `pushes` calls remain and no more
# calls remain than reserved slots, consuming this admitted batch preserves that
# relation for the next iteration.
def fast_push_remaining_work_stays_within_remaining_reservation(remaining_pushes: u64, available_slots: u64, pushes: u64) -> bool:
    requires pushes <= remaining_pushes
    requires remaining_pushes <= available_slots
    ensure result == true
    return remaining_pushes - pushes <= available_slots - pushes

def fast_push_reserved_extra_fits_u32(reserved_extra_elements: u64) -> bool:
    requires reserved_extra_elements <= 67108864
    ensure result == true
    return reserved_extra_elements <= 4294967295

def fast_push_two_i64_fill_stays_within_byte_cap(trips: u64, pushes_per_trip: u64, element_stride_bytes: u64) -> bool:
    requires trips <= 4194304
    requires pushes_per_trip == 2
    requires element_stride_bytes == 8
    ensure result == true
    return trips * pushes_per_trip * element_stride_bytes <= 67108864

def fast_push_cursor_final_count_is_exact(initial: u64, iterations: u64, pushes_per_iteration: u64, final_count: u64) -> bool:
    requires pushes_per_iteration > 0
    requires pushes_per_iteration <= 64
    requires iterations <= 67108864
    requires iterations * pushes_per_iteration <= 67108864
    requires initial <= 4294967295
    requires final_count == initial + iterations * pushes_per_iteration
    ensure result == true
    return final_count == initial + iterations * pushes_per_iteration

def fast_push_biased_index_stays_reserved(base_count: u64, ordinal: u64, reserved_end: u64) -> bool:
    requires base_count < reserved_end
    requires ordinal < reserved_end - base_count
    ensure result == true
    return base_count + ordinal < reserved_end

def fast_push_keeps_public_count_until_exit(initial: u64, public_count: u64, cursor: u64) -> bool:
    requires public_count == initial
    requires cursor >= initial
    ensure result == true
    return public_count == initial

def fast_push_count_observation_disables_cursor(reads_count: bool, cursor_enabled: bool) -> bool:
    requires cursor_enabled == not reads_count
    ensure result == true
    return cursor_enabled == not reads_count


