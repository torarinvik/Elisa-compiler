# Guard-policy model, not a proof of nominal lookup or the AST traversal.
def qualified_type_argument_context(pure_path: bool, shadowed_head: bool, unique_nominal: bool) -> bool:
    ensure result == (pure_path and not shadowed_head and unique_nominal)
    return pure_path and not shadowed_head and unique_nominal

def shadowed_head_keeps_value_resolution(pure_path: bool, unique_nominal: bool) -> bool:
    ensure result == false
    return qualified_type_argument_context(pure_path, true, unique_nominal)

def missing_or_ambiguous_nominal_keeps_value_resolution(pure_path: bool, shadowed_head: bool) -> bool:
    ensure result == false
    return qualified_type_argument_context(pure_path, shadowed_head, false)

def dotted_value_path_is_not_nominal_context(shadowed_head: bool, unique_nominal: bool) -> bool:
    ensure result == false
    return qualified_type_argument_context(false, shadowed_head, unique_nominal)

def unique_unshadowed_path_is_type_context() -> bool:
    ensure result == true
    return qualified_type_argument_context(true, false, true)
