# The prefilter must not scan a source span its classifier will always reject.
include "./lexer_line_map_path_cache_prefilter.elisa"

def false_accepts_a_cache_prefilter_span_one_byte_too_long() -> bool:
    ensure result == true
    return true and 8192 > 0 and 8192 <= SOURCE_LINE_MAP_PATH_LIMIT_MODEL
