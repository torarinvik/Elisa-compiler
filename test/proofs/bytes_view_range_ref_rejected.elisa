# False claims about bounded borrowed byte-range views must remain unproved.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

def zero_width_request_can_return_nonempty_view() -> bool can[Unsafe{PointerArithmetic, RawExtern}]:
    ensure result == true
    bytes: darray[u8] = [11, 23]
    view: sview = bytes_view_range_ref(bytes, bytes.count, 0.usize())
    return view.len > 0

def range_crossing_buffer_end_can_return_nonempty_view() -> bool can[Unsafe{PointerArithmetic, RawExtern}]:
    ensure result == true
    bytes: darray[u8] = [11, 23]
    view: sview = bytes_view_range_ref(bytes, bytes.count, 1.usize())
    return view.len > 0

def start_past_buffer_end_can_return_nonempty_view() -> bool can[Unsafe{PointerArithmetic, RawExtern}]:
    ensure result == true
    bytes: darray[u8] = [11, 23]
    view: sview = bytes_view_range_ref(bytes, bytes.count + 1.usize(), 0.usize())
    return view.len > 0

def valid_range_can_start_at_the_wrong_byte() -> bool can[Unsafe{PointerArithmetic, RawExtern}]:
    ensure result == true
    bytes: darray[u8] = [11, 23]
    view: sview = bytes_view_range_ref(bytes, 1.usize(), 1.usize())
    return view.data == &bytes[0.usize()]

def valid_request_can_return_the_wrong_length(
    bytes: darray[u8]&,
    start: usize,
    count: usize
) -> bool can[Unsafe{PointerArithmetic, RawExtern}]:
    requires bytes_view_range_ref_request_valid(bytes, start, count)
    ensure result == true
    view: sview = bytes_view_range_ref(bytes, start, count)
    return view.len != count.i64()

def invalid_request_can_return_nonempty_view(
    bytes: darray[u8]&,
    start: usize,
    count: usize
) -> bool can[Unsafe{PointerArithmetic, RawExtern}]:
    requires not bytes_view_range_ref_request_valid(bytes, start, count)
    ensure result == true
    view: sview = bytes_view_range_ref(bytes, start, count)
    return view.len > 0

def a_bounded_range_view_can_expose_the_byte_after_its_extent() -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    ensure result == true
    bytes: darray[u8] = [11, 23, 37, 41]
    view: sview = bytes_view_range_ref(bytes, 1.usize(), 2.usize())
    return view[2.usize()] == 41

def a_by_value_range_can_expose_the_byte_after_its_extent() -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    ensure result == true
    bytes: darray[u8] = [11, 23, 37, 41]
    view: sview = bytes_view_range(bytes, 1.usize(), 2.usize())
    return view[2.usize()] == 41

def a_valid_by_value_range_can_return_the_wrong_extent(
    bytes: darray[u8],
    start: usize,
    count: usize
) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires bytes.count > 0 and bytes.items != null and bytes.count <= bytes.capacity
    requires bytes.count.i64() >= 0 and bytes.count.i64().usize() == bytes.count
    requires start <= bytes.count and count <= bytes.count - start
    requires start.i64() >= 0 and start.i64().usize() == start
    requires count.i64() > 0 and count.i64().usize() == count
    ensure result == true
    view: sview = bytes_view_range(bytes, start, count)
    return view.len != count.i64() or view.data != &bytes[start]

def a_well_formed_nonempty_buffer_can_return_the_wrong_full_view(
    bytes: darray[u8],
) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires bytes.count > 0 and bytes.items != null and bytes.count <= bytes.capacity
    requires bytes.count.i64() >= 0 and bytes.count.i64().usize() == bytes.count
    ensure result == true
    view: sview = bytes_view(bytes)
    return view.len != bytes.count.i64() or view.data != &bytes[0.usize()]
