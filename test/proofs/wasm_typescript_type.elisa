# Source-linked proof of the TypeScript type projection used by WASM exports.
include "../../src/driver/wasm_typescript_type.elisa"
include "../../src/driver/wasm_scalar_wasm_type.elisa"

def source_typescript_mapping_is_exact(type_text: sview, parameter: bool) -> sview:
    ensure (result == "string | number") == (type_text == "cstr" and parameter)
    ensure (result == "string") == (type_text == "cstr" and not parameter)
    ensure (result == "bigint") == (
        when type_text:
            "i64" | "u64" | "char" -> true
            _ -> false
    )
    ensure (result == "boolean") == (type_text == "bool")
    ensure (result == "void") == (type_text == "void")
    ensure (result == "number") == (
        when type_text:
            "cstr" | "i64" | "u64" | "char" | "bool" | "void" -> false
            _ -> true
    )
    return WasmTypeScriptType::wasm_ts_type(type_text, parameter)

def cstr_parameter_and_return_types_are_distinct() -> bool:
    ensure result == true
    return (
        WasmTypeScriptType::wasm_ts_type("cstr", true) == "string | number"
        and WasmTypeScriptType::wasm_ts_type("cstr", false) == "string"
    )

def scalar_integer_bool_and_void_types_are_exact() -> bool:
    ensure result == true
    return (
        WasmTypeScriptType::wasm_ts_type("i64", true) == "bigint"
        and WasmTypeScriptType::wasm_ts_type("u64", false) == "bigint"
        and WasmTypeScriptType::wasm_ts_type("char", true) == "bigint"
        and WasmTypeScriptType::wasm_ts_type("bool", false) == "boolean"
        and WasmTypeScriptType::wasm_ts_type("void", false) == "void"
    )

def other_scalar_types_default_to_number() -> bool:
    ensure result == true
    return (
        WasmTypeScriptType::wasm_ts_type("i32", true) == "number"
        and WasmTypeScriptType::wasm_ts_type("f32", false) == "number"
        and WasmTypeScriptType::wasm_ts_type("Named", false) == "number"
    )

def wasm_i64_abi_types_are_typescript_bigints(type_text: sview) -> bool can[Abort.Panic]:
    requires WasmScalarWasmType::wasm_scalar_wasm_type(type_text) == "i64"
    ensure result == true
    return WasmTypeScriptType::wasm_ts_type(type_text, true) == "bigint"

def typescript_bigints_use_the_wasm_i64_abi(type_text: sview) -> bool can[Abort.Panic]:
    requires WasmTypeScriptType::wasm_ts_type(type_text, true) == "bigint"
    ensure result == true
    return WasmScalarWasmType::wasm_scalar_wasm_type(type_text) == "i64"

def bigint_input_conversion_matches_the_typescript_parameter_type(type_text: sview) -> bool:
    ensure result == true
    return (
        WasmTypeScriptType::wasm_ts_input_requires_bigint(type_text) ==
        (WasmTypeScriptType::wasm_ts_type(type_text, true) == "bigint")
    )
