include "./backend_aggregate_abi_threshold.elisa"

def false_1023_byte_aggregate_is_indirect(size: i64) -> bool:
    requires size == 1023
    ensure result
    return aggregate_uses_indirect_abi(true, size)

def false_scalar_is_indirect(size: i64) -> bool:
    requires size >= 1024
    ensure result
    return aggregate_uses_indirect_abi(false, size)
