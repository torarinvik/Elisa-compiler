# These intentionally false claims guard the sentinel and duplicate-suppression cases.
include "../../src/semantic/linear_exit_leak_policy.elisa"

def first_scan_slot_predecessor_is_one() -> bool:
    ensure result == true
    return SemanticLinearExitLeakPolicy::previous_scan_index(1.usize(), 1.usize()) == 1.usize()

def final_scope_predecessor_reaches_count() -> bool:
    requires count > 0
    ensure result == true
    return SemanticLinearExitLeakPolicy::previous_scan_index(count, count) >= count

def loop_sentinel_does_not_stop_scan() -> bool:
    ensure result == true
    can Abort.Panic:
        step: (stopped: bool, report: bool) = SemanticLinearExitLeakPolicy::scan_step("", false, true, [], [])
        return not step.stopped

def stopped_state_is_cleared() -> bool:
    ensure result == true
    can Abort.Panic:
        step: (stopped: bool, report: bool) = SemanticLinearExitLeakPolicy::scan_step("outer", true, true, [], [])
        return not step.stopped

def consumed_scope_is_reported() -> bool:
    ensure result == true
    can Abort.Panic:
        step: (stopped: bool, report: bool) = SemanticLinearExitLeakPolicy::scan_step("resource", false, false, ["resource"], [])
        return step.report

def previously_reported_scope_is_reported_again() -> bool:
    ensure result == true
    can Abort.Panic:
        step: (stopped: bool, report: bool) = SemanticLinearExitLeakPolicy::scan_step("resource", false, false, [], ["resource"])
        return step.report

def loop_sentinel_is_reported_as_a_resource() -> bool:
    ensure result == true
    can Abort.Panic:
        step: (stopped: bool, report: bool) = SemanticLinearExitLeakPolicy::scan_step("", false, true, [], [])
        return step.report
