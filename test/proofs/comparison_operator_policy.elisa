# Source-linked proof of the comparison-token set used by semantic checks.
include "./parser_token_kind_projection.elisa"
include "../../src/semantic/comparison_operator_policy.elisa"

def source_classifier_has_exact_comparison_set(operator: Lexer::TokenKind) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return ComparisonOperatorPolicy::is_comparison(operator) == (
            when operator:
                Lexer::TokenKind.EqEq | Lexer::TokenKind.BangEq | Lexer::TokenKind.Lt | Lexer::TokenKind.Gt | Lexer::TokenKind.LtEq | Lexer::TokenKind.GtEq -> true
                _ -> false
        )

def every_comparison_operator_is_classified() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            ComparisonOperatorPolicy::is_comparison(Lexer::TokenKind.EqEq)
            and ComparisonOperatorPolicy::is_comparison(Lexer::TokenKind.BangEq)
            and ComparisonOperatorPolicy::is_comparison(Lexer::TokenKind.Lt)
            and ComparisonOperatorPolicy::is_comparison(Lexer::TokenKind.Gt)
            and ComparisonOperatorPolicy::is_comparison(Lexer::TokenKind.LtEq)
            and ComparisonOperatorPolicy::is_comparison(Lexer::TokenKind.GtEq)
        )

def non_comparison_operators_remain_unclassified() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            not ComparisonOperatorPolicy::is_comparison(Lexer::TokenKind.And)
            and not ComparisonOperatorPolicy::is_comparison(Lexer::TokenKind.Or)
            and not ComparisonOperatorPolicy::is_comparison(Lexer::TokenKind.Is)
            and not ComparisonOperatorPolicy::is_comparison(Lexer::TokenKind.Plus)
            and not ComparisonOperatorPolicy::is_comparison(Lexer::TokenKind.Assign)
        )
