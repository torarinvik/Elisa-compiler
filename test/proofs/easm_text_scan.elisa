# Verify the production EASM scanner's first-separator loop and postconditions.
include "../../src/backend/easm_text_scan.elisa"

def first_space_contract_holds(text: sview) -> bool:
    ensure result == true
    position: i64 = EasmTextScan::first_space(text)
    return (
        position >= 0
        and (text.length < 0 or position == 0)
        and (text.length < 0 or position <= text.length)
        and (text.length < 0 or position == text.length or (
            position < text.length
            and (text[position] == 32 or text[position] == 9)
        ))
        and (forall prefix_index in 0..<position: text.length < 0 or prefix_index >= text.length or (text[prefix_index] != 32 and text[prefix_index] != 9)
        )
    )
