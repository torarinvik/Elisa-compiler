# Verify the production EASM scanner's first-separator loop and postconditions.
include "../../src/backend/easm_text_scan.elisa"

def memory_operand_classification_matches_delimiter_presence(has_parenthesis: bool, has_square_bracket: bool) -> bool:
    ensure result == true
    return EasmTextScan::contains_memory_address_delimiter(has_parenthesis, has_square_bracket) ==
        (has_parenthesis or has_square_bracket)

def parenthesized_memory_operand_delimiter_is_found() -> bool:
    ensure result == true
    return EasmTextScan::find("8(%rax)", "(") == 1

def bracketed_memory_operand_delimiter_is_found() -> bool:
    ensure result == true
    return EasmTextScan::find("[rax+8]", "[") == 0

def find_contract_holds(text: sview, needle: sview) -> bool:
    ensure result == true
    position: usize = EasmTextScan::find(text, needle)
    text_length: usize = text.len
    needle_length: usize = needle.len
    return (
        position <= text_length
        and ((needle_length == 0 or text_length < needle_length) implies position == text_length)
        and (position == text_length or (
            needle_length > 0
            and needle_length <= text_length
            and position <= text_length - needle_length
            and text[position:position + needle_length] == needle
        ))
        and (forall candidate in 0..<position:
            needle_length == 0 or
            needle_length > text_length - candidate or
            text[candidate:candidate + needle_length] != needle
        )
    )

def find_returns_the_first_duplicate_match() -> bool:
    ensure result == true
    return EasmTextScan::find("ababa", "ba") == 1

def find_returns_text_length_when_absent() -> bool:
    ensure result == true
    return EasmTextScan::find("abc", "z") == 3

def find_returns_text_length_for_an_empty_needle() -> bool:
    ensure result == true
    return EasmTextScan::find("abc", "") == 3

def find_accepts_a_match_at_the_last_legal_start() -> bool:
    ensure result == true
    return EasmTextScan::find("ab", "b") == 1

def starts_with_contract_holds(text: sview, prefix: sview) -> bool:
    ensure result == true
    matches: bool = EasmTextScan::starts_with(text, prefix)
    text_length: usize = text.len
    prefix_length: usize = prefix.len
    return (
        (matches implies prefix_length <= text_length)
        and (matches implies (forall prefix_index in 0..<prefix_length:
            prefix_index >= text_length or text[prefix_index] == prefix[prefix_index]
        ))
        and ((prefix_length <= text_length and (forall prefix_index in 0..<prefix_length:
            prefix_index >= text_length or text[prefix_index] == prefix[prefix_index]
        )) implies matches)
    )

def starts_with_accepts_an_exact_prefix() -> bool:
    ensure result == true
    return EasmTextScan::starts_with("movq %rax, %rbx", "mov")

def starts_with_accepts_an_exact_full_view() -> bool:
    ensure result == true
    return EasmTextScan::starts_with("ret", "ret")

def starts_with_accepts_the_empty_prefix() -> bool:
    ensure result == true
    return EasmTextScan::starts_with("ret", "")

def starts_with_rejects_a_longer_prefix() -> bool:
    ensure result == true
    return not EasmTextScan::starts_with("x", "xyz")

def starts_with_rejects_a_late_byte_mismatch() -> bool:
    ensure result == true
    return not EasmTextScan::starts_with("movq", "movx")

def equal_contract_holds(a: sview, b: sview) -> bool:
    ensure result == true
    matches: bool = EasmTextScan::equal(a, b)
    a_length: usize = a.len
    b_length: usize = b.len
    return (
        (matches implies a_length == b_length)
        and (matches implies (forall index in 0..<a_length:
            index >= b_length or a[index] == b[index]
        ))
        and ((a_length == b_length and (forall index in 0..<a_length:
            index >= b_length or a[index] == b[index]
        )) implies matches)
    )

def equal_accepts_identical_instruction_text() -> bool:
    ensure result == true
    return EasmTextScan::equal("movq %rax, %rbx", "movq %rax, %rbx")

def equal_accepts_two_empty_views() -> bool:
    ensure result == true
    return EasmTextScan::equal("", "")

def equal_rejects_a_different_same_length_mnemonic() -> bool:
    ensure result == true
    return not EasmTextScan::equal("movq", "addq")

def equal_rejects_a_shared_prefix_with_different_tail() -> bool:
    ensure result == true
    return not EasmTextScan::equal("movq", "movx")

def equal_rejects_a_proper_prefix() -> bool:
    ensure result == true
    return not EasmTextScan::equal("mov", "movq")

def first_space_contract_holds(text: sview) -> bool:
    ensure result == true
    position: i64 = EasmTextScan::first_space(text)
    return (
        position >= 0
        and (text.len < 0 or position == 0)
        and (text.len < 0 or position <= text.len)
        and (text.len < 0 or position == text.len or (
            position < text.len
            and (text[position] == EasmTextScan::ASCII_SPACE or text[position] == EasmTextScan::ASCII_TAB)
        ))
        and (forall prefix_index in 0..<position: text.len < 0 or prefix_index >= text.len or (text[prefix_index] != EasmTextScan::ASCII_SPACE and text[prefix_index] != EasmTextScan::ASCII_TAB)
        )
    )

def trim_bounds_contract_holds(text: sview) -> bool:
    ensure result == true
    bounds: EasmTextScan::TrimBounds = EasmTextScan::trim_bounds(text)
    text_length: usize = text.len
    return (
        bounds.start <= bounds.end
        and bounds.end <= text_length
        and (forall prefix_index in 0..<bounds.start:
            text[prefix_index] == EasmTextScan::ASCII_SPACE or text[prefix_index] == EasmTextScan::ASCII_TAB
        )
        and (forall suffix_index in bounds.end..<text_length:
            text[suffix_index] == EasmTextScan::ASCII_SPACE or text[suffix_index] == EasmTextScan::ASCII_TAB
        )
        and (bounds.start == bounds.end or (
            text[bounds.start] != EasmTextScan::ASCII_SPACE
            and text[bounds.start] != EasmTextScan::ASCII_TAB
            and text[bounds.end - 1.usize()] != EasmTextScan::ASCII_SPACE
            and text[bounds.end - 1.usize()] != EasmTextScan::ASCII_TAB
        ))
        and (bounds.start != bounds.end or bounds.start == text_length)
    )

def trim_returns_the_exact_maximal_source_span(text: sview) -> bool:
    ensure result == true
    bounds: EasmTextScan::TrimBounds = EasmTextScan::trim_bounds(text)
    trimmed: sview = EasmTextScan::trim(text)
    return trimmed == text[bounds.start:bounds.end]

def trim_removes_only_outer_spaces_and_tabs() -> bool:
    ensure result == true
    text: sview = " \tleft right\t "
    bounds: EasmTextScan::TrimBounds = EasmTextScan::trim_bounds(text)
    trimmed: sview = EasmTextScan::trim(text)
    return bounds.start == 2 and bounds.end == 12 and trimmed == "left right"

def trimming_all_whitespace_returns_the_empty_end_span() -> bool:
    ensure result == true
    text: sview = " \t \t"
    bounds: EasmTextScan::TrimBounds = EasmTextScan::trim_bounds(text)
    return bounds.start == text.len and bounds.end == text.len and EasmTextScan::trim(text) == ""

def trimming_a_clean_view_preserves_the_whole_span() -> bool:
    ensure result == true
    text: sview = "left right"
    bounds: EasmTextScan::TrimBounds = EasmTextScan::trim_bounds(text)
    return bounds.start == 0 and bounds.end == text.len and EasmTextScan::trim(text) == text
