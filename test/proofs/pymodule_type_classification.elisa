# Source-linked proof of the closed type tables used by Python binding generation.
include "../../src/driver/pymodule_type_classification.elisa"

def scalar_field_membership_matches_the_closed_source_table(type_name: sview) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        expected: bool = when type_name:
            "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "char" -> true
            "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" -> true
            "f32" | "f64" | "bool" | "cstr" | "sview" | "py::Object" -> true
            "cstr?" | "py::Object?" -> true
            "i8?" | "i16?" | "i32?" | "i64?" | "int?" | "isize?" | "char?" -> true
            "u8?" | "u16?" | "u32?" | "u64?" | "usize?" | "uintptr?" -> true
            "bool?" | "f32?" | "f64?" | "sview?" -> true
            _ -> false
        return PymoduleTypeClassification::is_scalar_field_type(type_name) == expected

def python_expected_type_matches_the_closed_source_table(type_name: sview) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        expected: sview = when type_name:
            "py::Object" -> "object"
            "py::Object?" -> "object | None"
            "cstr" | "sview" -> "str | bytes"
            "cstr?" | "sview?" -> "str | bytes | None"
            "bool" -> "bool"
            "f32" | "f64" -> "float"
            "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "char" | "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" -> "int"
            _ -> ""
        return PymoduleTypeClassification::known_python_expected_type(type_name) == expected

def nearby_named_types_stay_outside_the_scalar_set() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            not PymoduleTypeClassification::is_scalar_field_type("String")
            and not PymoduleTypeClassification::is_scalar_field_type("u128")
            and not PymoduleTypeClassification::is_scalar_field_type("sview??")
        )

def unsupported_type_names_have_no_static_python_expectation() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            PymoduleTypeClassification::known_python_expected_type("Widget") == ""
            and PymoduleTypeClassification::known_python_expected_type("darray[i64]") == ""
            and PymoduleTypeClassification::known_python_expected_type("i128") == ""
        )
