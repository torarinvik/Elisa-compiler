# Integer-class eightbytes use only the bytes that remain in a partial final slot.
def x86_integer_eightbyte_width_bits(remaining_bytes: i64) -> i64:
    requires remaining_bytes > 0
    ensure result == (remaining_bytes * 8 if remaining_bytes < 8 else 64)
    used_bytes: i64 = remaining_bytes if remaining_bytes < 8 else 8
    return used_bytes * 8

def one_byte_integer_slot_has_eight_bits(remaining_bytes: i64) -> i64:
    requires remaining_bytes == 1
    ensure result == 8
    return remaining_bytes * 8

def eight_byte_integer_slot_has_sixty_four_bits(remaining_bytes: i64) -> i64:
    requires remaining_bytes == 8
    ensure result == 64
    return remaining_bytes * 8

def larger_integer_slot_is_capped_at_sixty_four_bits(remaining_bytes: i64) -> i64:
    requires remaining_bytes > 8
    ensure result == 64
    return 64
