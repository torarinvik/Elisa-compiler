# Source-linked proof of the exact synthetic foreign-enum validator name predicate.
include "../../src/semantic/foreign_enum_validator_name.elisa"

def validator_name_predicate_matches_prefix_and_suffix_spec(
    function_name: sview,
    enum_name: sview
) -> bool can[Abort.Panic]:
    ensure result == (
        function_name.len == enum_name.len + "__from_c".len
        and (forall prefix_index in 0..<enum_name.len: prefix_index >= function_name.len or function_name[prefix_index] == enum_name[prefix_index])
        and (forall suffix_index in 0..<"__from_c".len: enum_name.len + suffix_index >= function_name.len or function_name[enum_name.len + suffix_index] == "__from_c"[suffix_index])
    )
    can Abort.Panic:
        return ForeignEnumName::is_validator_of(function_name, enum_name)

def synthesized_validator_name_is_recognized() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return ForeignEnumName::is_validator_of("Color__from_c", "Color")

def validator_suffix_is_recognized_for_empty_prefix() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return ForeignEnumName::is_validator_of("__from_c", "")
