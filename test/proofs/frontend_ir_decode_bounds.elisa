# Arithmetic models for frontend IR spans, varints, IDs, counts, root references, and cursor
# progress. Only the span-fit predicate below is directly linked to a production helper contract;
# the checker audits the surrounding reader guards and their source order.
include "../../src/driver/frontend_ir_bounds.elisa"

def bounded_sum_fits_data(start: usize, length: usize, total: usize) -> bool:
    requires start <= total and length <= total - start
    ensure result == true
    return start + length <= total

def span_length_beyond_remaining_fails(start: usize, length: usize, total: usize) -> bool:
    requires start <= total and length > total - start
    ensure result == false
    return length <= total - start

def span_start_beyond_data_fails(start: usize, total: usize) -> bool:
    requires start > total
    ensure result == false
    return start <= total

def last_varint_group_accepts_only_one_payload_bit(payload: u8) -> bool:
    ensure result == (payload <= 1)
    return payload <= 1

def high_last_group_payload_is_rejected(payload: u8) -> bool:
    requires payload > 1
    ensure result == false
    return payload <= 1

def a_continued_tenth_varint_byte_is_rejected(payload: u8, continuation: bool) -> bool:
    requires payload <= 1 and continuation
    ensure result == false
    return not continuation and payload <= 1

def u32_identifier_in_range_satisfies_guard(identifier: u64) -> bool:
    requires identifier <= 4294967295
    ensure result == true
    return identifier <= 4294967295

def oversized_u32_identifier_fails_the_guard(identifier: u64) -> bool:
    requires identifier > 4294967295
    ensure result == false
    return identifier <= 4294967295

def table_count_within_input_bytes_is_admissible(count: u64, input_bytes: u64) -> bool:
    requires count <= input_bytes
    ensure result == true
    return count <= input_bytes

def table_count_larger_than_input_bytes_is_rejected(count: u64, input_bytes: u64) -> bool:
    requires count > input_bytes
    ensure result == false
    return count <= input_bytes

def nonzero_root_within_node_table_is_admissible(root: u64, node_count: u64) -> bool:
    requires root > 0 and root <= node_count and root <= 4294967295
    ensure result == true
    return root > 0 and root <= node_count and root <= 4294967295

def zero_root_is_rejected(root: u64) -> bool:
    requires root == 0
    ensure result == false
    return root > 0

def root_after_node_table_is_rejected(root: u64, node_count: u64) -> bool:
    requires root > node_count
    ensure result == false
    return root <= node_count

def root_larger_than_u32_is_rejected(root: u64) -> bool:
    requires root > 4294967295
    ensure result == false
    return root <= 4294967295

def supported_ir_version_is_admitted(version: u64) -> bool:
    requires version == 2
    ensure result == true
    return version == 2

def unsupported_ir_version_is_rejected(version: u64) -> bool:
    requires version != 2
    ensure result == false
    return version == 2

def guarded_cursor_step_stays_in_input(offset: usize, total: usize) -> bool:
    requires offset < total
    ensure result == true
    return offset + 1 <= total

def guarded_cursor_step_strictly_reduces_remaining_input(offset: usize, total: usize) -> bool:
    requires offset < total
    ensure result == true
    return total - (offset + 1) < total - offset

def list_child_tag_is_rejected_when_only_one_byte_remains(offset: usize, total: usize) -> bool:
    requires offset <= total and total - offset == 1
    ensure result == false
    return total - offset > 1

def map_child_is_rejected_when_only_two_bytes_remain(offset: usize, total: usize) -> bool:
    requires offset <= total and total - offset == 2
    ensure result == false
    return total - offset >= 3

def continued_tenth_varint_group_exceeds_shift_limit(shift: u32) -> bool:
    requires shift == 63
    ensure result == true
    return shift + 7 > 63

def continuation_before_tenth_group_stays_within_shift_limit(shift: u32) -> bool:
    requires shift <= 56
    ensure result == true
    return shift + 7 <= 63
