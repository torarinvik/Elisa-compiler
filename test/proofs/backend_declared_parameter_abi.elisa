# The declared LLVM ABI places hidden parameters around source parameters.
def declared_parameter_count(source_count: i64, arena_count: i64, wants_store: bool, sret_return: bool) -> i64:
    requires source_count >= 0 and arena_count >= 0
    ensure result == source_count + arena_count + (1 if wants_store else 0) + (1 if sret_return else 0)
    return source_count + arena_count + (1 if wants_store else 0) + (1 if sret_return else 0)

def source_parameter_start(sret_return: bool) -> i64:
    ensure result == (1 if sret_return else 0)
    return 1 if sret_return else 0

def packed_store_parameter_index(source_count: i64, sret_return: bool) -> i64:
    requires source_count >= 0
    ensure result == source_count + (1 if sret_return else 0)
    return source_count + (1 if sret_return else 0)

def arena_parameter_start(source_count: i64, wants_store: bool, sret_return: bool) -> i64:
    requires source_count >= 0
    ensure result == source_count + (1 if wants_store else 0) + (1 if sret_return else 0)
    return source_count + (1 if wants_store else 0) + (1 if sret_return else 0)
