# Ordered-choice contract for the project source include resolver.

def first_configured_include_hit(available: darray[bool]&) -> usize:
    ensures result <= available.count
    ensures result < available.count implies available[result]
    ensures forall prior in 0..<result: not available[prior]
    position: mutable usize = 0.usize()
    while position < available.count |position, available|:
        decreases available.count - position
        invariant position <= available.count
        invariant forall prior in 0..<position: not available[prior]
        return position if available[position]
        position <- position + 1.usize()
    return available.count

def choose_include_candidate(direct_available: bool, configured_available: darray[bool]&)
    -> (found: bool, index: usize):
    ensures direct_available implies result.found and result.index == 0.usize()
    ensures not direct_available implies (
        result.found == not (forall candidate in 0..<configured_available.count:
            not configured_available[candidate])
    )
    ensures not direct_available and result.found implies (
        result.index > 0.usize()
        and result.index - 1.usize() < configured_available.count
        and configured_available[result.index - 1.usize()]
        and (forall prior in 0..<result.index - 1.usize(): not configured_available[prior])
    )
    if direct_available:
        return (true, 0.usize())
    configured_index: usize = first_configured_include_hit(configured_available)
    return (false, 0.usize()) if configured_index == configured_available.count
    return (true, configured_index + 1.usize())

def the_including_directory_wins_when_available(configured_available: darray[bool]&) -> bool:
    ensures result == true
    selected: (found: bool, index: usize) = choose_include_candidate(true, configured_available)
    return selected.found and selected.index == 0.usize()

def first_configured_directory_is_selected(configured_available: darray[bool]&) -> bool:
    requires configured_available.count > 0.usize() and configured_available[0.usize()]
    ensures result == true
    selected: (found: bool, index: usize) = choose_include_candidate(false, configured_available)
    return selected.found and selected.index == 1.usize()

def no_candidate_means_not_found(configured_available: darray[bool]&) -> bool:
    requires forall candidate in 0..<configured_available.count: not configured_available[candidate]
    ensures result == true
    selected: (found: bool, index: usize) = choose_include_candidate(false, configured_available)
    return not selected.found
