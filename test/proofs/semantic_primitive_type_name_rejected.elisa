# Deliberately false classification claims must not be admitted.
include "./semantic_primitive_type_name.elisa"

def ordinary_named_type_is_primitive() -> bool:
    ensure result == true
    can Abort.Panic:
        return SemanticPrimitiveTypeName::is_primitive_type("String")

def malformed_bit_width_suffix_is_accepted() -> bool:
    ensure result == true
    can Abort.Panic:
        return SemanticPrimitiveTypeName::is_bit_width_int("u8x")

def single_prefix_is_a_complete_bit_width_name() -> bool:
    ensure result == true
    can Abort.Panic:
        return SemanticPrimitiveTypeName::is_bit_width_int("i")

def fixed_integer_head_is_not_primitive() -> bool:
    ensure result == true
    can Abort.Panic:
        return not SemanticPrimitiveTypeName::is_primitive_type("u64")

def non_scalar_primitive_is_a_builtin_scalar() -> bool:
    ensure result == true
    can Abort.Panic:
        return SemanticPrimitiveTypeName::is_builtin_scalar_type_name("void")

def unsigned_alias_is_a_builtin_scalar() -> bool:
    ensure result == true
    can Abort.Panic:
        return SemanticPrimitiveTypeName::is_builtin_scalar_type_name("uint")

def malformed_builtin_width_is_accepted() -> bool:
    ensure result == true
    can Abort.Panic:
        return SemanticPrimitiveTypeName::is_builtin_scalar_type_name("u8x")
