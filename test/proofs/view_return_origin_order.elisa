# Source-linked proof of the bytewise key ordering used by view-return-origin binary search.
include "../../src/semantic/binding_identity_types.elisa"
include "../../src/semantic/view_return_origin_constants.elisa"
include "../../src/semantic/view_return_origins_sorted.elisa"

extend Semantic:
    private:
        ghost def vro_text_compare_reference_swap(left: sview, right: sview, position: usize) -> bool:
            requires position <= left.len and position <= right.len
            decreases (left.len if left.len < right.len else right.len) - position
            ensure result == true
            ensure vro_text_compare_reference_from(left, right, position) == -vro_text_compare_reference_from(right, left, position)
            return true if position == left.len or position == right.len
            return true if left[position] < right[position]
            return true if left[position] > right[position]
            return vro_text_compare_reference_swap(left, right, position + VRO_BYTE_STEP)

extend Semantic:
    public:
        def production_comparator_refines_recursive_lexicographic_spec(left: sview, right: sview) -> i32 can[Abort.Panic]:
            ensure result == vro_text_compare_reference_from(left, right, VRO_FIRST_BYTE_POSITION)
            can Abort.Panic:
                return vro_text_compare(left, right)

        def production_comparator_returns_only_three_way_results(left: sview, right: sview) -> bool can[Abort.Panic]:
            ensure result == true
            can Abort.Panic:
                comparison: i32 = vro_text_compare(left, right)
                return comparison >= VRO_COMPARE_LESS and comparison <= VRO_COMPARE_GREATER

        ghost def production_comparison_is_antisymmetric(left: sview, right: sview) -> bool:
            ensure result == true
            can Abort.Panic:
                _ = vro_text_compare_reference_swap(left, right, VRO_FIRST_BYTE_POSITION)
                left_right: i32 = vro_text_compare(left, right)
                right_left: i32 = vro_text_compare(right, left)
                return left_right == -right_left

        def identical_text_keys_compare_equal(text: sview) -> bool can[Abort.Panic]:
            ensure result == true
            can Abort.Panic:
                return vro_text_compare(text, text) == VRO_COMPARE_EQUAL

        def a_text_prefix_sorts_before_its_extension() -> bool can[Abort.Panic]:
            ensure result == true
            can Abort.Panic:
                return vro_text_compare("state", "state2") == VRO_COMPARE_LESS
