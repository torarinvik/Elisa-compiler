# Exact stored-span equality used to deduplicate source graph paths.

def source_span_overlap_length(left_length: usize, right_length: usize) -> usize:
    ensures result <= left_length and result <= right_length
    return left_length if left_length < right_length else right_length

def bytes_span_copy_model(source: darray[u8]&, start: usize, length: usize) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    requires start <= source.count
    requires length <= source.count - start
    ensures result.count == length
    ensures forall index in 0..<length: result[index] == source[start + index]
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[u8] = []
        index: mutable usize = 0.usize()
        while index < length |index, out, source, start|:
            decreases length - index
            invariant index <= length
            invariant out.count == index
            invariant forall prior in 0..<index: out[prior] == source[start + prior]
            out.push(source[start + index])
            index <- index + 1.usize()
        return out

def span_copy_preserves_the_selected_bytes(source: darray[u8]&, start: usize, length: usize) -> bool can[Memory.Allocate, Abort.Panic]:
    requires start <= source.count and length <= source.count - start
    ensures result == true
    copied: darray[u8] = bytes_span_copy_model(source, start, length)
    return copied.count == length and (forall index in 0..<length: copied[index] == source[start + index])

def bytes_span_equal_model(left: darray[u8]&, left_start: usize, length: usize, right: darray[u8]&) -> bool:
    requires left_start <= left.count
    requires length <= left.count - left_start
    ensures result == (
        length == right.count
        and (forall index in 0..<source_span_overlap_length(length, right.count):
            left[left_start + index] == right[index])
    )
    false return if length != right.count
    index: mutable usize = 0.usize()
    while index < length |index, left, left_start, right|:
        decreases length - index
        invariant index <= length
        invariant forall prior in 0..<index: left[left_start + prior] == right[prior]
        false return if left[left_start + index] != right[index]
        index <- index + 1.usize()
    return true

def an_exact_stored_path_span_matches(left: darray[u8]&, left_start: usize, length: usize, right: darray[u8]&) -> bool:
    requires left_start <= left.count and length <= left.count - left_start
    requires length == right.count
    requires forall index in 0..<length: left[left_start + index] == right[index]
    ensures result == true
    return bytes_span_equal_model(left, left_start, length, right)

def a_different_path_length_is_not_equal(left: darray[u8]&, left_start: usize, length: usize, right: darray[u8]&) -> bool:
    requires left_start <= left.count and length <= left.count - left_start
    requires length != right.count
    ensures result == false
    return bytes_span_equal_model(left, left_start, length, right)

def a_different_byte_inside_the_span_is_not_equal(left: darray[u8]&, left_start: usize, length: usize, right: darray[u8]&, mismatch: usize) -> bool:
    requires left_start <= left.count and length <= left.count - left_start
    requires length == right.count and mismatch < length
    requires left[left_start + mismatch] != right[mismatch]
    ensures result == false
    return bytes_span_equal_model(left, left_start, length, right)

def a_valid_span_copy_has_the_requested_length(source: darray[u8]&, start: usize, length: usize) -> bool can[Memory.Allocate, Abort.Panic]:
    requires start <= source.count and length <= source.count - start
    requires length > 0.usize()
    ensures result == true
    copied: darray[u8] = bytes_span_copy_model(source, start, length)
    return copied.count == length

def a_matching_prefix_does_not_match_a_longer_path(first: u8, second: u8, suffix: u8) -> bool:
    ensures result == false
    stored: darray[u8] = [first, second, suffix]
    requested: darray[u8] = [first, second]
    return bytes_span_equal_model(stored, 0.usize(), stored.count, requested)
