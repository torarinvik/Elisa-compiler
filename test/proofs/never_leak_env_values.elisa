# Source-linked laws for exact never-leak mode and level environment values.
include "../../src/driver/never_leak_env_values.elisa"

def empty_and_zero_mode_values_disable() -> bool:
    ensure result == true
    return (
        NeverLeakEnvValues::mode("") == NeverLeakEnvValues::NL_ENV_MODE_OFF
        and NeverLeakEnvValues::mode("0") == NeverLeakEnvValues::NL_ENV_MODE_OFF
    )

def error_mode_requires_exact_spelling() -> bool:
    ensure result == true
    return (
        NeverLeakEnvValues::mode("error") == NeverLeakEnvValues::NL_ENV_MODE_ERROR
        and NeverLeakEnvValues::mode("erratic") == NeverLeakEnvValues::NL_ENV_MODE_WARN
        and NeverLeakEnvValues::mode("errorish") == NeverLeakEnvValues::NL_ENV_MODE_WARN
    )

def other_nonempty_modes_are_warnings() -> bool:
    ensure result == true
    return (
        NeverLeakEnvValues::mode("warn") == NeverLeakEnvValues::NL_ENV_MODE_WARN
        and NeverLeakEnvValues::mode("unexpected") == NeverLeakEnvValues::NL_ENV_MODE_WARN
    )

def strict_level_requires_exact_spelling() -> bool:
    ensure result == true
    return (
        NeverLeakEnvValues::is_strict("strict")
        and not NeverLeakEnvValues::is_strict("staged")
        and not NeverLeakEnvValues::is_strict("strictly")
        and not NeverLeakEnvValues::is_strict("gentle")
    )
