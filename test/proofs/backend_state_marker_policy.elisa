# Prove that codegen's typestate marker tags form a closed, reversible mapping.
include "../../src/backend/codegen_state_marker_policy.elisa"

def marker_name_to_tag_contract_is_exact(name: sview) -> bool:
    ensure result == true
    return BackendStateMarkerPolicy::tag_for_name(name) == (when name:
        "Local" -> BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_LOCAL_TAG
        "Frozen" -> BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_FROZEN_TAG
        "Joinable" -> BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_JOINABLE_TAG
        "Pending" -> BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_PENDING_TAG
        "Held" -> BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_HELD_TAG
        _ -> BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_UNKNOWN_TAG
    )

def marker_tag_to_name_contract_is_exact(tag: u32) -> bool:
    ensure result == true
    return BackendStateMarkerPolicy::name_for_tag(tag) == (match tag:
        BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_LOCAL_TAG: "Local"
        BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_FROZEN_TAG: "Frozen"
        BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_JOINABLE_TAG: "Joinable"
        BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_PENDING_TAG: "Pending"
        BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_HELD_TAG: "Held"
        _: "unknown"
    )

def every_marker_name_round_trips() -> bool:
    ensure result == true
    return (
        BackendStateMarkerPolicy::name_for_tag(BackendStateMarkerPolicy::tag_for_name("Local")) == "Local"
        and BackendStateMarkerPolicy::name_for_tag(BackendStateMarkerPolicy::tag_for_name("Frozen")) == "Frozen"
        and BackendStateMarkerPolicy::name_for_tag(BackendStateMarkerPolicy::tag_for_name("Joinable")) == "Joinable"
        and BackendStateMarkerPolicy::name_for_tag(BackendStateMarkerPolicy::tag_for_name("Pending")) == "Pending"
        and BackendStateMarkerPolicy::name_for_tag(BackendStateMarkerPolicy::tag_for_name("Held")) == "Held"
    )

def every_marker_tag_round_trips() -> bool:
    ensure result == true
    local_tag: u32 = BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_LOCAL_TAG
    frozen_tag: u32 = BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_FROZEN_TAG
    joinable_tag: u32 = BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_JOINABLE_TAG
    pending_tag: u32 = BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_PENDING_TAG
    held_tag: u32 = BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_HELD_TAG
    return (
        BackendStateMarkerPolicy::tag_for_name(BackendStateMarkerPolicy::name_for_tag(local_tag)) == local_tag
        and BackendStateMarkerPolicy::tag_for_name(BackendStateMarkerPolicy::name_for_tag(frozen_tag)) == frozen_tag
        and BackendStateMarkerPolicy::tag_for_name(BackendStateMarkerPolicy::name_for_tag(joinable_tag)) == joinable_tag
        and BackendStateMarkerPolicy::tag_for_name(BackendStateMarkerPolicy::name_for_tag(pending_tag)) == pending_tag
        and BackendStateMarkerPolicy::tag_for_name(BackendStateMarkerPolicy::name_for_tag(held_tag)) == held_tag
    )

def unknown_marker_values_use_the_sentinel() -> bool:
    ensure result == true
    return (
        BackendStateMarkerPolicy::tag_for_name("Other") == BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_UNKNOWN_TAG
        and BackendStateMarkerPolicy::name_for_tag(BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_UNKNOWN_TAG) == "unknown"
    )

def marker_tags_are_nonzero_and_distinct() -> bool:
    ensure result == true
    local: u32 = BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_LOCAL_TAG
    frozen: u32 = BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_FROZEN_TAG
    joinable: u32 = BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_JOINABLE_TAG
    pending: u32 = BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_PENDING_TAG
    held: u32 = BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_HELD_TAG
    return (
        local != BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_UNKNOWN_TAG
        and frozen != BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_UNKNOWN_TAG
        and joinable != BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_UNKNOWN_TAG
        and pending != BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_UNKNOWN_TAG
        and held != BackendStateMarkerPolicy::BUILTIN_STATE_MARKER_UNKNOWN_TAG
        and local != frozen and local != joinable and local != pending and local != held
        and frozen != joinable and frozen != pending and frozen != held
        and joinable != pending and joinable != held
        and pending != held
    )
