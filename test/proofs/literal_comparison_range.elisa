# Source-linked proof of supported integer types and literal range endpoints.
include "./parser_token_kind_projection.elisa"
include "../../src/semantic/comparison_operator_policy.elisa"
include "../../src/semantic/literal_comparison_range.elisa"

def source_supported_types_match_the_closed_set(type_name: sview) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return LiteralComparisonRange::is_supported_integer_type(type_name) == (
            when type_name:
                "u8" | "u16" | "u32" | "i8" | "i16" | "i32" -> true
                _ -> false
        )

def source_range_rule_matches_each_type(type_name: sview, value: i64) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return LiteralComparisonRange::is_outside(type_name, value) == (
            when type_name:
                "u8" -> value < LiteralComparisonRange::U8_MIN or value > LiteralComparisonRange::U8_MAX
                "u16" -> value < LiteralComparisonRange::U16_MIN or value > LiteralComparisonRange::U16_MAX
                "u32" -> value < LiteralComparisonRange::U32_MIN or value > LiteralComparisonRange::U32_MAX
                "i8" -> value < LiteralComparisonRange::I8_MIN or value > LiteralComparisonRange::I8_MAX
                "i16" -> value < LiteralComparisonRange::I16_MIN or value > LiteralComparisonRange::I16_MAX
                "i32" -> value < LiteralComparisonRange::I32_MIN or value > LiteralComparisonRange::I32_MAX
                _ -> false
        )

def all_integer_type_endpoints_are_inside() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            not LiteralComparisonRange::is_outside("u8", LiteralComparisonRange::U8_MIN)
            and not LiteralComparisonRange::is_outside("u8", LiteralComparisonRange::U8_MAX)
            and not LiteralComparisonRange::is_outside("u16", LiteralComparisonRange::U16_MIN)
            and not LiteralComparisonRange::is_outside("u16", LiteralComparisonRange::U16_MAX)
            and not LiteralComparisonRange::is_outside("u32", LiteralComparisonRange::U32_MIN)
            and not LiteralComparisonRange::is_outside("u32", LiteralComparisonRange::U32_MAX)
            and not LiteralComparisonRange::is_outside("i8", LiteralComparisonRange::I8_MIN)
            and not LiteralComparisonRange::is_outside("i8", LiteralComparisonRange::I8_MAX)
            and not LiteralComparisonRange::is_outside("i16", LiteralComparisonRange::I16_MIN)
            and not LiteralComparisonRange::is_outside("i16", LiteralComparisonRange::I16_MAX)
            and not LiteralComparisonRange::is_outside("i32", LiteralComparisonRange::I32_MIN)
            and not LiteralComparisonRange::is_outside("i32", LiteralComparisonRange::I32_MAX)
        )

def adjacent_values_outside_each_range_are_rejected() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            LiteralComparisonRange::is_outside("u8", LiteralComparisonRange::U8_MIN - 1)
            and LiteralComparisonRange::is_outside("u8", LiteralComparisonRange::U8_MAX + 1)
            and LiteralComparisonRange::is_outside("u16", LiteralComparisonRange::U16_MIN - 1)
            and LiteralComparisonRange::is_outside("u16", LiteralComparisonRange::U16_MAX + 1)
            and LiteralComparisonRange::is_outside("u32", LiteralComparisonRange::U32_MIN - 1)
            and LiteralComparisonRange::is_outside("u32", LiteralComparisonRange::U32_MAX + 1)
            and LiteralComparisonRange::is_outside("i8", LiteralComparisonRange::I8_MIN - 1)
            and LiteralComparisonRange::is_outside("i8", LiteralComparisonRange::I8_MAX + 1)
            and LiteralComparisonRange::is_outside("i16", LiteralComparisonRange::I16_MIN - 1)
            and LiteralComparisonRange::is_outside("i16", LiteralComparisonRange::I16_MAX + 1)
            and LiteralComparisonRange::is_outside("i32", LiteralComparisonRange::I32_MIN - 1)
            and LiteralComparisonRange::is_outside("i32", LiteralComparisonRange::I32_MAX + 1)
        )

def unsupported_type_names_are_never_outside(type_name: sview, value: i64) -> bool can[Abort.Panic]:
    requires not LiteralComparisonRange::is_supported_integer_type(type_name)
    ensure result == true
    can Abort.Panic:
        return not LiteralComparisonRange::is_outside(type_name, value)

# Any value inside a target's interval has a fixed comparison result against an
# integer above that interval. This is the semantic reason the range checker can
# report the comparison as vacuous for every supported comparison operator.
def upper_range_comparisons_are_constant(operator: Lexer::TokenKind, value: i64, literal: i64, minimum: i64, maximum: i64) -> bool can[Abort.Panic]:
    requires value >= minimum
    requires value <= maximum
    requires literal > maximum
    requires ComparisonOperatorPolicy::is_comparison(operator)
    ensure result == true
    can Abort.Panic:
        return when operator:
            Lexer::TokenKind.EqEq -> not (value == literal)
            Lexer::TokenKind.BangEq -> value != literal
            Lexer::TokenKind.Lt -> value < literal
            Lexer::TokenKind.Gt -> not (value > literal)
            Lexer::TokenKind.LtEq -> value <= literal
            Lexer::TokenKind.GtEq -> not (value >= literal)
            _ -> false

# The corresponding result is fixed for a literal below the target's interval.
def lower_range_comparisons_are_constant(operator: Lexer::TokenKind, value: i64, literal: i64, minimum: i64, maximum: i64) -> bool can[Abort.Panic]:
    requires value >= minimum
    requires value <= maximum
    requires literal < minimum
    requires ComparisonOperatorPolicy::is_comparison(operator)
    ensure result == true
    can Abort.Panic:
        return when operator:
            Lexer::TokenKind.EqEq -> not (value == literal)
            Lexer::TokenKind.BangEq -> value != literal
            Lexer::TokenKind.Lt -> not (value < literal)
            Lexer::TokenKind.Gt -> value > literal
            Lexer::TokenKind.LtEq -> not (value <= literal)
            Lexer::TokenKind.GtEq -> value >= literal
            _ -> false

# Instantiate all six comparison outcomes at the u8 upper endpoint and the
# first representable i64 literal outside that endpoint.
def u8_upper_boundary_comparisons_are_fixed() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            not (LiteralComparisonRange::U8_MAX == LiteralComparisonRange::U8_MAX + 1)
            and LiteralComparisonRange::U8_MAX != LiteralComparisonRange::U8_MAX + 1
            and LiteralComparisonRange::U8_MAX < LiteralComparisonRange::U8_MAX + 1
            and not (LiteralComparisonRange::U8_MAX > LiteralComparisonRange::U8_MAX + 1)
            and LiteralComparisonRange::U8_MAX <= LiteralComparisonRange::U8_MAX + 1
            and not (LiteralComparisonRange::U8_MAX >= LiteralComparisonRange::U8_MAX + 1)
        )

# Instantiate the lower-range formulas at the i8 minimum and immediately below it.
def i8_lower_boundary_comparisons_are_fixed() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            not (LiteralComparisonRange::I8_MIN == LiteralComparisonRange::I8_MIN - 1)
            and LiteralComparisonRange::I8_MIN != LiteralComparisonRange::I8_MIN - 1
            and not (LiteralComparisonRange::I8_MIN < LiteralComparisonRange::I8_MIN - 1)
            and LiteralComparisonRange::I8_MIN > LiteralComparisonRange::I8_MIN - 1
            and not (LiteralComparisonRange::I8_MIN <= LiteralComparisonRange::I8_MIN - 1)
            and LiteralComparisonRange::I8_MIN >= LiteralComparisonRange::I8_MIN - 1
        )

# These OR laws model whether a literal-comparison report is present after
# recursively visiting every child of the corresponding AST node. The checker
# binds each Boolean input to a direct production-walker edge.
def proof_literal_comparison_match_children_reported(scrutinee_reported: bool, guard_reported: bool, body_reported: bool) -> bool:
    ensure result == (scrutinee_reported or guard_reported or body_reported)
    return scrutinee_reported or guard_reported or body_reported

def proof_literal_comparison_catch_children_reported(guarded_reported: bool, arm_guard_reported: bool, arm_body_reported: bool) -> bool:
    ensure result == (guarded_reported or arm_guard_reported or arm_body_reported)
    return guarded_reported or arm_guard_reported or arm_body_reported

def proof_literal_comparison_static_effect_children_reported(capture_reported: bool, argument_reported: bool) -> bool:
    ensure result == (capture_reported or argument_reported)
    return capture_reported or argument_reported

def proof_literal_comparison_unary_child_reported(child_reported: bool) -> bool:
    ensure result == child_reported
    return child_reported

def proof_literal_comparison_refinement_children_reported(base_reported: bool, predicate_reported: bool) -> bool:
    ensure result == (base_reported or predicate_reported)
    return base_reported or predicate_reported

def proof_literal_comparison_get_else_children_reported(guarded_reported: bool, recovery_reported: bool) -> bool:
    ensure result == (guarded_reported or recovery_reported)
    return guarded_reported or recovery_reported

def proof_literal_comparison_statement_children_reported(expression: bool,
    variable_type: bool,
    variable_value: bool,
    assignment_target: bool,
    assignment_value: bool,
    if_condition: bool,
    if_then_body: bool,
    if_else_body: bool,
    while_condition: bool,
    while_body: bool,
    for_iterable: bool,
    for_body: bool,
    return_value: bool,
    block_body: bool,
    match_scrutinee: bool,
    match_guard: bool,
    match_body: bool,
    contract_expression: bool) -> bool:
    ensure result == (expression or variable_type or variable_value or assignment_target or assignment_value or
        if_condition or if_then_body or if_else_body or while_condition or while_body or for_iterable or for_body or
        return_value or block_body or match_scrutinee or match_guard or match_body or contract_expression)
    return (expression or variable_type or variable_value or assignment_target or assignment_value or
        if_condition or if_then_body or if_else_body or while_condition or while_body or for_iterable or for_body or
        return_value or block_body or match_scrutinee or match_guard or match_body or contract_expression)

def proof_literal_comparison_declaration_children_reported(parameter_type: bool,
    parameter_default: bool,
    return_type: bool,
    function_body: bool,
    member_type: bool,
    member_default: bool,
    bit_member_type: bool,
    invariant: bool,
    enum_storage_type: bool,
    enum_payload_type: bool,
    enum_variant_value: bool,
    alias_target: bool,
    law_predicate: bool,
    const_type: bool,
    const_value: bool,
    module_body: bool,
    scoped_body: bool) -> bool:
    ensure result == (parameter_type or parameter_default or return_type or function_body or member_type or
        member_default or bit_member_type or invariant or enum_storage_type or enum_payload_type or enum_variant_value or
        alias_target or law_predicate or const_type or const_value or module_body or scoped_body)
    return (parameter_type or parameter_default or return_type or function_body or member_type or
        member_default or bit_member_type or invariant or enum_storage_type or enum_payload_type or enum_variant_value or
        alias_target or law_predicate or const_type or const_value or module_body or scoped_body)
