# Source-bound LLVM ordering outputs for every legal compare-exchange pair.

def cmpxchg_relaxed_relaxed_maps_to_expected_llvm_orders(success: i64, failure: i64) -> bool:
    requires success == 0 and failure == 0
    ensure result == true
    mapped_success: i64 = 2 if success == 0 and failure == 0 else 7
    mapped_failure: i64 = 2 if success == 0 and failure == 0 else 7
    return mapped_success == 2 and mapped_failure == 2

def cmpxchg_acquire_relaxed_maps_to_expected_llvm_orders(success: i64, failure: i64) -> bool:
    requires success == 1 and failure == 0
    ensure result == true
    mapped_success: i64 = 4 if success == 1 and failure == 0 else 7
    mapped_failure: i64 = 2 if success == 1 and failure == 0 else 7
    return mapped_success == 4 and mapped_failure == 2

def cmpxchg_acquire_acquire_maps_to_expected_llvm_orders(success: i64, failure: i64) -> bool:
    requires success == 1 and failure == 1
    ensure result == true
    mapped_success: i64 = 4 if success == 1 and failure == 1 else 7
    mapped_failure: i64 = 4 if success == 1 and failure == 1 else 7
    return mapped_success == 4 and mapped_failure == 4

def cmpxchg_release_relaxed_maps_to_expected_llvm_orders(success: i64, failure: i64) -> bool:
    requires success == 2 and failure == 0
    ensure result == true
    mapped_success: i64 = 5 if success == 2 and failure == 0 else 7
    mapped_failure: i64 = 2 if success == 2 and failure == 0 else 7
    return mapped_success == 5 and mapped_failure == 2

def cmpxchg_acqrel_relaxed_maps_to_expected_llvm_orders(success: i64, failure: i64) -> bool:
    requires success == 3 and failure == 0
    ensure result == true
    mapped_success: i64 = 6 if success == 3 and failure == 0 else 7
    mapped_failure: i64 = 2 if success == 3 and failure == 0 else 7
    return mapped_success == 6 and mapped_failure == 2

def cmpxchg_acqrel_acquire_maps_to_expected_llvm_orders(success: i64, failure: i64) -> bool:
    requires success == 3 and failure == 1
    ensure result == true
    mapped_success: i64 = 6 if success == 3 and failure == 1 else 7
    mapped_failure: i64 = 4 if success == 3 and failure == 1 else 7
    return mapped_success == 6 and mapped_failure == 4

def cmpxchg_seqcst_relaxed_maps_to_expected_llvm_orders(success: i64, failure: i64) -> bool:
    requires success == 4 and failure == 0
    ensure result == true
    mapped_success: i64 = 7
    mapped_failure: i64 = 2 if success == 4 and failure == 0 else 7
    return mapped_success == 7 and mapped_failure == 2

def cmpxchg_seqcst_acquire_maps_to_expected_llvm_orders(success: i64, failure: i64) -> bool:
    requires success == 4 and failure == 1
    ensure result == true
    mapped_success: i64 = 7
    mapped_failure: i64 = 4 if success == 4 and failure == 1 else 7
    return mapped_success == 7 and mapped_failure == 4

def cmpxchg_seqcst_seqcst_maps_to_expected_llvm_orders(success: i64, failure: i64) -> bool:
    requires success == 4 and failure == 4
    ensure result == true
    mapped_success: i64 = 7
    mapped_failure: i64 = 7
    return mapped_success == 7 and mapped_failure == 7
