# zip_map uses the destination length as its loop bound. Require each source length
# to cover that entire prefix before any source element is loaded.
def zip_index_is_inside_every_view(index: u64, destination_count: u64, source1_count: u64, source2_count: u64) -> bool:
    requires index < destination_count
    requires destination_count <= source1_count and destination_count <= source2_count
    ensure result == true
    return index < source1_count and index < source2_count

def source_count_guard_accepts_a_covering_view(required_count: u64, available_count: u64) -> bool:
    requires required_count <= available_count
    ensure result == true
    return available_count >= required_count

def source_count_guard_rejects_a_short_view(required_count: u64, available_count: u64) -> bool:
    requires available_count < required_count
    ensure result == true
    return not (available_count >= required_count)

def zero_destination_has_no_loop_index(index: u64, destination_count: u64) -> bool:
    requires destination_count == 0
    ensure result == true
    return not (index < destination_count)
