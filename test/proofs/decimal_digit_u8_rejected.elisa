include "./decimal_digit_u8.elisa"

def false_digit_is_at_most_eight(remaining: i64) -> bool:
    requires remaining > 0
    ensure result == true
    return 48 + (remaining % 10) <= 56

def false_digit_is_at_least_one(remaining: i64) -> bool:
    requires remaining > 0
    ensure result == true
    return 48 + (remaining % 10) >= 49
