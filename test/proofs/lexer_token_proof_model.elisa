# This projection duplicates the production TokenKind, Token, TokenSpan, and
# LexerPosition declarations. check_lexer_token.py verifies the exact layouts
# and enum order before replaying any theorem.
module Lexer:
    public:
        struct LexerPosition:
            line: mutable int
            column: mutable int
            offset: mutable usize

        const enum TokenKind of u8:
            Eof
            Newline
            Indent
            Dedent
            Ident
            IntLit
            FloatLit
            HexLit
            StringLit
            Def
            Error
            Enum
            Struct
            Const
            Global
            Extern
            Export
            If
            Match
            Elif
            Else
            While
            Break
            Continue
            Return
            Heap
            Stack
            Owned
            Static
            Mutable
            Repr
            Packed
            Aligned
            Pass
            Panic
            Not
            And
            Or
            Null
            True
            False
            Zeroed
            Sizeof
            Alignof
            Offsetof
            Tail
            Try
            Catch
            Raise
            Region
            New
            As
            In
            With
            Colon
            Scope
            Arrow
            Dot
            Range
            RangeLt
            RangeGt
            RangeLe
            Comma
            LParen
            RParen
            LBracket
            RBracket
            Hash
            Ampersand
            Question
            QAssign
            Bang
            At
            Ellipsis
            LArrow
            PlusEq
            MinusEq
            StarEq
            SlashEq
            PercentEq
            CaretEq
            PipeEq
            AmpEq
            LShiftEq
            RShiftEq
            Assign
            EqEq
            BangEq
            Lt
            Gt
            LtEq
            GtEq
            Plus
            Minus
            Star
            Slash
            Percent
            Pipe
            Caret
            LShift
            RShift
            Tilde
            CharLit
            Is
            FatArrow
            To
            LBrace
            RBrace
            PipeGt
            Semicolon
            Comment
            FString
            Lmut
            Label

        struct Token:
            line: mutable u32
            column: mutable u32
            start: mutable u32
            length: mutable u32
            suffix_length: mutable u16
            kind: mutable TokenKind
            flags: bitset:
                has_suffix

        struct TokenSpan:
            line: u32
            column: u32
            start: u32
            length: u32
            suffix_length: u16

# The kernel proves TokenSpan's field-preservation contract. The admission
# script ties those fields to Token's mutable constructor with an exact body
# check. It also pins the packed flag assignment because current proposition
# formation does not yet admit bitset-member expressions; promote that relation
# to a kernel theorem when the proof assistant supports those propositions.

include "../../src/lexer/lexer_token_span.elisa"
