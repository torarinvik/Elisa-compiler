# The target machine accepts only LLVM's four code-generation optimization levels.

def every_requested_level_clamps_to_enum_domain(level: i64) -> bool:
    ensure result == true
    chosen: i64 = level if level >= 0 and level <= 3 else 0
    return chosen >= 0 and chosen <= 3

def supported_requested_level_is_preserved(level: i64) -> bool:
    requires level >= 0 and level <= 3
    ensure result == true
    chosen: i64 = level if level >= 0 and level <= 3 else 0
    return chosen == level

def unsupported_requested_level_becomes_zero(level: i64) -> bool:
    requires level < 0 or level > 3
    ensure result == true
    chosen: i64 = level if level >= 0 and level <= 3 else 0
    return chosen == 0
