include "./frontend_ir_decl_refusal.elisa"

def false_claim_plain_function_needs_refusal(needs_stage0_auto_region: bool) -> bool:
    requires not needs_stage0_auto_region
    ensure result == true
    return FrontendIrDeclPolicy::function_requires_refusal(needs_stage0_auto_region)

def false_claim_ordinary_struct_needs_refusal(has_named_states: bool, has_derive: bool) -> bool:
    requires not has_named_states and not has_derive
    ensure result == true
    return FrontendIrDeclPolicy::struct_requires_refusal(has_named_states, has_derive)

def false_claim_typestate_struct_is_admitted(has_named_states: bool, has_derive: bool) -> bool:
    requires has_named_states or has_derive
    ensure result == true
    return not FrontendIrDeclPolicy::struct_requires_refusal(has_named_states, has_derive)

def false_claim_scoped_declaration_is_admitted() -> bool:
    ensure result == true
    return not FrontendIrDeclPolicy::scoped_declaration_requires_refusal()

def false_claim_law_has_direct_encoder() -> bool:
    ensure result == true
    return declaration_constructor_route(FrontendIrDeclConstructor.Law) == FrontendIrDeclRoute.DirectEncoding

def false_claim_invalid_has_direct_encoder() -> bool:
    ensure result == true
    return declaration_constructor_route(FrontendIrDeclConstructor.Invalid) == FrontendIrDeclRoute.DirectEncoding
