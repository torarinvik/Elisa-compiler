# The generic-call matcher walks two parameter slices in parallel. Its source
# guards use `start <= total` followed by `count <= total - start`; this unsigned
# model proves every offset selected by `0..<count` stays inside that slice.
def subtraction_guard_bounds_each_slice_index(total: u64, start: u64, count: u64, offset: u64) -> bool:
    requires start <= total and count <= total - start
    requires offset < count
    ensure result == true
    return start + offset >= start and start + offset < total

def one_past_slice_length_is_rejected(total: u64, start: u64, count: u64, offset: u64) -> bool:
    requires start <= total and count <= total - start
    requires offset == count
    ensure result == true
    return not (offset < count)

def empty_slice_at_pool_end_has_no_valid_offset(total: u64, start: u64, offset: u64) -> bool:
    requires start == total and offset == 0
    ensure result == true
    return not (offset < 0)

def row_round_trip_preserves_a_bounded_signed_index(row: i64, converted_row: i64, row_count: i64) -> bool:
    requires row >= 0 and converted_row == row
    requires row_count >= 0 and converted_row < row_count
    ensure result == true
    return row < row_count

def mismatched_row_round_trip_is_rejected(row: i64, converted_row: i64) -> bool:
    requires row >= 0 and converted_row != row
    ensure result == true
    return converted_row != row

def generic_slot_round_trip_preserves_selected_entry(slot: i64, converted_slot: i64, names_count: i64, owners_count: i64) -> bool:
    requires slot >= 0 and converted_slot == slot
    requires names_count >= 0 and owners_count >= 0
    requires converted_slot < names_count and converted_slot < owners_count
    ensure result == true
    return slot < names_count and slot < owners_count
