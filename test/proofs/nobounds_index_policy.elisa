# Universal and concrete claims about the policy used by NoBoundsChecks index auditing.
include "../../src/semantic/nobounds_index_policy.elisa"

def range_evidence_decision_matches_its_spec(is_darray_parameter: bool, receiver: sview, index_name: sview, evidence_receiver: sview, evidence_index: sview) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return SemanticNoBoundsIndexPolicy::matching_range_evidence(is_darray_parameter, receiver, index_name, evidence_receiver, evidence_index) == SemanticNoBoundsIndexPolicy::matching_range_evidence_spec(is_darray_parameter, receiver, index_name, evidence_receiver, evidence_index)

def report_decision_matches_its_spec(is_darray_parameter: bool, has_evidence: bool) -> bool:
    ensure result == true
    return SemanticNoBoundsIndexPolicy::should_report_unproven(is_darray_parameter, has_evidence) == SemanticNoBoundsIndexPolicy::should_report_unproven_spec(is_darray_parameter, has_evidence)

def exact_read_only_range_evidence_accepts_index() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return SemanticNoBoundsIndexPolicy::matching_range_evidence(true, "items", "i", "items", "i")

def different_receiver_does_not_match_range_evidence() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not SemanticNoBoundsIndexPolicy::matching_range_evidence(true, "other", "i", "items", "i")

def different_index_does_not_match_range_evidence() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not SemanticNoBoundsIndexPolicy::matching_range_evidence(true, "items", "j", "items", "i")

def non_parameter_does_not_match_range_evidence() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not SemanticNoBoundsIndexPolicy::matching_range_evidence(false, "items", "i", "items", "i")

def unproven_parameter_index_is_reported() -> bool:
    ensure result == true
    return SemanticNoBoundsIndexPolicy::should_report_unproven(true, false)

def proven_parameter_index_is_not_reported() -> bool:
    ensure result == true
    return not SemanticNoBoundsIndexPolicy::should_report_unproven(true, true)

def non_parameter_index_is_not_reported() -> bool:
    ensure result == true
    return not SemanticNoBoundsIndexPolicy::should_report_unproven(false, false)
