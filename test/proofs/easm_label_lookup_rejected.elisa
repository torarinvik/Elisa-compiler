# False claims exercise EASM label lookup bounds, empty-target behavior, and
# duplicate ordering.
include "../../src/backend/easm_model.elisa"

def a_found_label_index_can_be_out_of_range(instructions: darray[Easm::Instruction], target: sview) -> bool:
    requires Easm::easm_label_index(instructions, target) >= 0
    ensure result == true
    found: i64 = Easm::easm_label_index(instructions, target)
    return found >= instructions.count.i64()

def an_absent_label_can_be_reported_as_found(instructions: darray[Easm::Instruction], target: sview) -> bool can[Unsafe.UncheckedIndex]:
    requires instructions.count.i64() >= 0 and instructions.count.i64().usize() == instructions.count
    requires target.len > 0
    requires forall candidate in 0..<instructions.count.i64():
        Easm::easm_label_name(instructions[candidate.usize()]) != target
    ensure result == true
    return Easm::easm_label_index(instructions, target) >= 0

def an_unrepresentable_instruction_count_can_return_a_label(instructions: darray[Easm::Instruction], target: sview) -> bool:
    requires instructions.count.i64() < 0 or instructions.count.i64().usize() != instructions.count
    ensure result == true
    return Easm::easm_label_index(instructions, target) >= 0

def a_later_duplicate_label_can_be_selected(
    instructions: darray[Easm::Instruction],
    target: sview,
    first: usize,
    later: usize
) -> bool can[Unsafe.UncheckedIndex]:
    requires instructions.count.i64() >= 0 and instructions.count.i64().usize() == instructions.count
    requires target.len > 0
    requires first < later and later < instructions.count
    requires instructions[first].op == "label" and instructions[later].op == "label"
    requires forall prior in 0..<first:
        Easm::easm_label_name(instructions[prior]) != target
    requires Easm::easm_label_name(instructions[first]) == target
    requires Easm::easm_label_name(instructions[later]) == target
    ensure result == true
    return Easm::easm_label_index(instructions, target) == later.i64()

def an_empty_instruction_list_can_have_a_label_index(target: sview) -> bool:
    ensure result == true
    instructions: darray[Easm::Instruction] = []
    return Easm::easm_label_index(instructions, target) >= 0

def an_empty_lookup_target_can_find_a_label(instructions: darray[Easm::Instruction]) -> bool:
    ensure result == true
    return Easm::easm_label_index(instructions, "") >= 0

def a_non_label_instruction_can_have_a_label_name(instruction: Easm::Instruction) -> bool:
    requires instruction.op != "label"
    ensure result == true
    return Easm::easm_label_name(instruction).len != 0

def a_label_without_a_terminal_colon_can_change_its_trimmed_name(instruction: Easm::Instruction) -> bool can[Unsafe.UncheckedIndex]:
    requires instruction.op == "label"
    requires Easm::easm_trim(instruction.text).len == 0 or Easm::easm_trim(instruction.text)[Easm::easm_trim(instruction.text).len - 1.usize()] != 58
    ensure result == true
    return Easm::easm_label_name(instruction) != Easm::easm_trim(instruction.text)

def a_label_with_a_terminal_colon_can_keep_the_colon(instruction: Easm::Instruction) -> bool can[Unsafe.UncheckedIndex]:
    requires instruction.op == "label"
    requires Easm::easm_trim(instruction.text).len > 0
    requires Easm::easm_trim(instruction.text)[Easm::easm_trim(instruction.text).len - 1.usize()] == 58
    ensure result == true
    return Easm::easm_label_name(instruction) == Easm::easm_trim(instruction.text)
