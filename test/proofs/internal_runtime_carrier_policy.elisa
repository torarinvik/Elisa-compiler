# Prove the closed replacement table and warning set used by the semantic producer and
# diagnostic consumers. The source module is included directly so these are not a duplicate
# test model.
include "../../src/semantic/internal_runtime_carrier_policy.elisa"

def source_replacement_policy_is_the_exact_closed_table(type_name: sview) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return when type_name:
            "StringView" -> (InternalRuntimeCarrierPolicy::runtime_carrier_replacement(type_name)) == ("sview[...]")
            "DynArray" -> (InternalRuntimeCarrierPolicy::runtime_carrier_replacement(type_name)) == ("darray[T, shape]")
            "DynArrayView" -> (InternalRuntimeCarrierPolicy::runtime_carrier_replacement(type_name)) == ("view[T]")
            "DynDict" -> (InternalRuntimeCarrierPolicy::runtime_carrier_replacement(type_name)) == ("dict[K, V]")
            "Arena" -> (InternalRuntimeCarrierPolicy::runtime_carrier_replacement(type_name)) == ("region scopes and inferred container regions")
            "ArenaMark" -> (InternalRuntimeCarrierPolicy::runtime_carrier_replacement(type_name)) == ("region scopes/checkpoints")
            _ -> (InternalRuntimeCarrierPolicy::runtime_carrier_replacement(type_name)) == ("")

def all_carrier_replacement_rows_are_exact() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            InternalRuntimeCarrierPolicy::runtime_carrier_replacement("StringView") == "sview[...]"
            and InternalRuntimeCarrierPolicy::runtime_carrier_replacement("DynArray") == "darray[T, shape]"
            and InternalRuntimeCarrierPolicy::runtime_carrier_replacement("DynArrayView") == "view[T]"
            and InternalRuntimeCarrierPolicy::runtime_carrier_replacement("DynDict") == "dict[K, V]"
            and InternalRuntimeCarrierPolicy::runtime_carrier_replacement("Arena") == "region scopes and inferred container regions"
            and InternalRuntimeCarrierPolicy::runtime_carrier_replacement("ArenaMark") == "region scopes/checkpoints"
        )

def emission_gate_matches_the_closed_carrier_set(type_name: sview) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return when type_name:
            "StringView" | "DynArray" | "DynArrayView" | "DynDict" | "Arena" | "ArenaMark" -> ((InternalRuntimeCarrierPolicy::runtime_carrier_replacement(type_name) != "")) == (true)
            _ -> ((InternalRuntimeCarrierPolicy::runtime_carrier_replacement(type_name) != "")) == (false)

def unmapped_names_use_the_empty_fallback(type_name: sview) -> bool can[Abort.Panic]:
    requires type_name != "StringView" and type_name != "DynArray" and type_name != "DynArrayView" and type_name != "DynDict" and type_name != "Arena" and type_name != "ArenaMark"
    ensure result == true
    can Abort.Panic:
        return InternalRuntimeCarrierPolicy::runtime_carrier_replacement(type_name) == ""

def source_warning_policy_is_exactly_the_arena_pair(type_name: sview) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return InternalRuntimeCarrierPolicy::is_warning(type_name) == (type_name == "Arena" or type_name == "ArenaMark")

def both_arena_carriers_are_warnings() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return InternalRuntimeCarrierPolicy::is_warning("Arena") and InternalRuntimeCarrierPolicy::is_warning("ArenaMark")

def error_carriers_and_unmapped_names_are_not_warnings(type_name: sview) -> bool can[Abort.Panic]:
    requires type_name != "StringView" and type_name != "DynArray" and type_name != "DynArrayView" and type_name != "DynDict" and type_name != "Arena" and type_name != "ArenaMark"
    ensure result == true
    can Abort.Panic:
        return (
            not InternalRuntimeCarrierPolicy::is_warning("StringView")
            and not InternalRuntimeCarrierPolicy::is_warning("DynArray")
            and not InternalRuntimeCarrierPolicy::is_warning("DynArrayView")
            and not InternalRuntimeCarrierPolicy::is_warning("DynDict")
            and not InternalRuntimeCarrierPolicy::is_warning(type_name)
        )
