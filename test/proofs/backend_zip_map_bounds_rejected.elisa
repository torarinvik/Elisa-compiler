include "./backend_zip_map_bounds.elisa"

def false_claim_short_source_covers_destination(index: u64, destination_count: u64, source_count: u64) -> bool:
    requires index < destination_count
    requires source_count < destination_count and index == source_count
    ensure result == true
    return index < source_count

def false_claim_source_guard_accepts_short_view(required_count: u64, available_count: u64) -> bool:
    requires available_count < required_count
    ensure result == true
    return available_count >= required_count
