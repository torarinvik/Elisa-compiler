# Invalid include spans must not satisfy the scanner's bounds contract.
include "./project_include_span_bounds.elisa"

def a_quote_at_the_line_limit_is_strictly_inside(opening_quote: u64, closing_quote: u64, line_limit: u64) -> bool:
    requires opening_quote < line_limit and closing_quote == line_limit
    ensure result == true
    return closing_quote < line_limit

def a_parsed_include_payload_can_overrun_the_file(line_start: u64, line_limit: u64, contents_length: u64, payload_start: u64, closing_quote: u64, payload_length: u64) -> bool:
    requires line_limit <= contents_length
    requires line_start <= payload_start and payload_start <= closing_quote
    requires closing_quote < line_limit
    requires payload_length == closing_quote - payload_start
    ensure result == true
    return payload_length > contents_length - payload_start

def the_eof_scan_position_can_index_the_contents(position: u64, contents_length: u64) -> bool:
    requires position == contents_length
    ensure result == true
    return position < contents_length
