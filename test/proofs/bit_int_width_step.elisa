# Source-linked safety and boundary facts for the bit-int width accumulator.
include "../../src/semantic/bit_int_width.elisa"

def bounded_width_step_matches_the_decimal_transition(width: i64, digit: i64) -> bool:
    requires width >= SemanticBitIntWidth::BIT_INT_PREFIX_MIN and width <= SemanticBitIntWidth::BIT_INT_MAX_WIDTH
    requires digit >= SemanticBitIntWidth::DECIMAL_DIGIT_MIN and digit <= SemanticBitIntWidth::DECIMAL_DIGIT_MAX
    ensure result == true
    candidate: i64 = width * SemanticBitIntWidth::DECIMAL_RADIX + digit
    step: (valid: bool, value: i64) = SemanticBitIntWidth::append_digit(width, digit)
    return step.valid == (candidate <= SemanticBitIntWidth::BIT_INT_MAX_WIDTH) and (step.value == candidate if step.valid else step.value == SemanticBitIntWidth::BIT_INT_PREFIX_MIN)

def accepted_width_step_stays_below_sixty_four(width: i64, digit: i64) -> bool:
    requires width >= SemanticBitIntWidth::BIT_INT_PREFIX_MIN and width <= SemanticBitIntWidth::BIT_INT_MAX_WIDTH
    requires digit >= SemanticBitIntWidth::DECIMAL_DIGIT_MIN and digit <= SemanticBitIntWidth::DECIMAL_DIGIT_MAX
    ensure result == true
    step: (valid: bool, value: i64) = SemanticBitIntWidth::append_digit(width, digit)
    return not step.valid or (step.value >= SemanticBitIntWidth::BIT_INT_PREFIX_MIN and step.value <= SemanticBitIntWidth::BIT_INT_MAX_WIDTH)

def every_guarded_decimal_candidate_fits_i64(width: i64, digit: i64) -> bool:
    requires width >= SemanticBitIntWidth::BIT_INT_PREFIX_MIN and width <= SemanticBitIntWidth::BIT_INT_MAX_WIDTH
    requires digit >= SemanticBitIntWidth::DECIMAL_DIGIT_MIN and digit <= SemanticBitIntWidth::DECIMAL_DIGIT_MAX
    ensure result == true
    candidate: i64 = width * SemanticBitIntWidth::DECIMAL_RADIX + digit
    step: (valid: bool, value: i64) = SemanticBitIntWidth::append_digit(width, digit)
    return candidate >= SemanticBitIntWidth::BIT_INT_PREFIX_MIN and candidate <= SemanticBitIntWidth::MAX_WIDTH_CANDIDATE and SemanticBitIntWidth::MAX_WIDTH_CANDIDATE <= SemanticBitIntWidth::I64_MAX and (not step.valid or step.value <= SemanticBitIntWidth::BIT_INT_MAX_WIDTH)

def every_two_digit_decimal_suffix_matches_the_width_bound(first_digit: i64, second_digit: i64) -> bool:
    requires first_digit >= SemanticBitIntWidth::DECIMAL_DIGIT_MIN and first_digit <= SemanticBitIntWidth::DECIMAL_DIGIT_MAX
    requires second_digit >= SemanticBitIntWidth::DECIMAL_DIGIT_MIN and second_digit <= SemanticBitIntWidth::DECIMAL_DIGIT_MAX
    ensure result == true
    first: (valid: bool, value: i64) = SemanticBitIntWidth::append_digit(SemanticBitIntWidth::BIT_INT_PREFIX_MIN, first_digit)
    candidate: i64 = first_digit * SemanticBitIntWidth::DECIMAL_RADIX + second_digit
    step: (valid: bool, value: i64) = SemanticBitIntWidth::append_digit(first.value, second_digit)
    return first.valid and step.valid == (candidate <= SemanticBitIntWidth::BIT_INT_MAX_WIDTH) and (step.value == candidate if step.valid else step.value == SemanticBitIntWidth::BIT_INT_PREFIX_MIN)

def width_sixty_three_is_accepted() -> bool:
    ensure result == true
    width_prefix: i64 = SemanticBitIntWidth::BIT_INT_MAX_WIDTH / SemanticBitIntWidth::DECIMAL_RADIX
    final_digit: i64 = SemanticBitIntWidth::BIT_INT_MAX_WIDTH % SemanticBitIntWidth::DECIMAL_RADIX
    step: (valid: bool, value: i64) = SemanticBitIntWidth::append_digit(width_prefix, final_digit)
    return step.valid and step.value == SemanticBitIntWidth::BIT_INT_MAX_WIDTH

def width_sixty_four_is_rejected() -> bool:
    ensure result == true
    width_prefix: i64 = SemanticBitIntWidth::BIT_INT_WIDTH_LIMIT / SemanticBitIntWidth::DECIMAL_RADIX
    final_digit: i64 = SemanticBitIntWidth::BIT_INT_WIDTH_LIMIT % SemanticBitIntWidth::DECIMAL_RADIX
    step: (valid: bool, value: i64) = SemanticBitIntWidth::append_digit(width_prefix, final_digit)
    return not step.valid and step.value == SemanticBitIntWidth::BIT_INT_PREFIX_MIN

def a_prefix_already_outside_the_window_is_rejected(width: i64, digit: i64) -> bool:
    requires width >= SemanticBitIntWidth::BIT_INT_WIDTH_LIMIT
    requires digit >= SemanticBitIntWidth::DECIMAL_DIGIT_MIN and digit <= SemanticBitIntWidth::DECIMAL_DIGIT_MAX
    ensure result == true
    step: (valid: bool, value: i64) = SemanticBitIntWidth::append_digit(width, digit)
    return not step.valid and step.value == SemanticBitIntWidth::BIT_INT_PREFIX_MIN

def negative_prefix_is_rejected(width: i64, digit: i64) -> bool:
    requires width < SemanticBitIntWidth::BIT_INT_PREFIX_MIN
    requires digit >= SemanticBitIntWidth::DECIMAL_DIGIT_MIN and digit <= SemanticBitIntWidth::DECIMAL_DIGIT_MAX
    ensure result == true
    step: (valid: bool, value: i64) = SemanticBitIntWidth::append_digit(width, digit)
    return not step.valid and step.value == SemanticBitIntWidth::BIT_INT_PREFIX_MIN

def non_decimal_digit_is_rejected(width: i64, digit: i64) -> bool:
    requires width >= SemanticBitIntWidth::BIT_INT_PREFIX_MIN and width <= SemanticBitIntWidth::BIT_INT_MAX_WIDTH
    requires digit < SemanticBitIntWidth::DECIMAL_DIGIT_MIN or digit > SemanticBitIntWidth::DECIMAL_DIGIT_MAX
    ensure result == true
    step: (valid: bool, value: i64) = SemanticBitIntWidth::append_digit(width, digit)
    return not step.valid and step.value == SemanticBitIntWidth::BIT_INT_PREFIX_MIN

def ascii_digit_byte_maps_to_a_decimal_digit(byte: u8) -> bool:
    requires byte >= SemanticBitIntWidth::ASCII_DIGIT_ZERO and byte <= SemanticBitIntWidth::ASCII_DIGIT_NINE
    ensure result == true
    digit: i64 = (byte - SemanticBitIntWidth::ASCII_DIGIT_ZERO).i64()
    step: (valid: bool, value: i64) = SemanticBitIntWidth::append_digit(SemanticBitIntWidth::BIT_INT_PREFIX_MIN, digit)
    return digit >= SemanticBitIntWidth::DECIMAL_DIGIT_MIN and digit <= SemanticBitIntWidth::DECIMAL_DIGIT_MAX and step.valid and step.value == digit

def unsigned_63_high_endpoint_is_i64_max() -> bool:
    ensure result == true
    high: i64 = SemanticBitIntWidth::unsigned_63_high_endpoint()
    return high == SemanticBitIntWidth::I64_MAX

def unsigned_62_high_endpoint_is_i64_max_over_two() -> bool:
    ensure result == true
    span: i64 = 1 << (SemanticBitIntWidth::BIT_INT_MAX_WIDTH - SemanticBitIntWidth::BIT_INT_MIN_WIDTH).usize()
    high: i64 = span - SemanticBitIntWidth::BIT_INT_MIN_WIDTH
    return high == SemanticBitIntWidth::I64_MAX / 2

def final_width_predicate_matches_the_supported_interval(width: i64) -> bool:
    ensure result == true
    return SemanticBitIntWidth::supported_final_width(width) == (width >= SemanticBitIntWidth::BIT_INT_MIN_WIDTH and width <= SemanticBitIntWidth::BIT_INT_MAX_WIDTH)

def minimum_final_width_is_supported() -> bool:
    ensure result == true
    return SemanticBitIntWidth::supported_final_width(SemanticBitIntWidth::BIT_INT_MIN_WIDTH)

def maximum_final_width_is_supported() -> bool:
    ensure result == true
    return SemanticBitIntWidth::supported_final_width(SemanticBitIntWidth::BIT_INT_MAX_WIDTH)

def zero_final_width_is_rejected() -> bool:
    ensure result == true
    return not SemanticBitIntWidth::supported_final_width(SemanticBitIntWidth::BIT_INT_PREFIX_MIN)

def width_above_the_limit_is_rejected() -> bool:
    ensure result == true
    return not SemanticBitIntWidth::supported_final_width(SemanticBitIntWidth::BIT_INT_WIDTH_LIMIT)

def every_out_of_range_final_width_is_rejected(width: i64) -> bool:
    requires width < SemanticBitIntWidth::BIT_INT_MIN_WIDTH or width > SemanticBitIntWidth::BIT_INT_MAX_WIDTH
    ensure result == true
    return not SemanticBitIntWidth::supported_final_width(width)
