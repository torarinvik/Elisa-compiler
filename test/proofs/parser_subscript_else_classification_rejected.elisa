include "./parser_subscript_else_classification.elisa"

def false_claim_identifier_without_colon_is_recovery(current_is_else: bool, is_transfer: bool, is_identifier: bool, after_identifier_is_colon: bool) -> bool:
    requires current_is_else and not is_transfer and is_identifier and not after_identifier_is_colon
    ensure result == true
    return current_is_else and (is_transfer or (is_identifier and after_identifier_is_colon))

def false_claim_generic_field_uses_type_argument_context(receiver_is_field: bool, is_cast: bool, is_call_as: bool) -> bool:
    requires receiver_is_field and not is_cast and not is_call_as
    ensure result == true
    return receiver_is_field and (is_cast or is_call_as)
