# Path extensions and stems follow the final dot inside the final path component.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

def extension_preserves_the_last_dot_suffix(path: sview) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires path.len >= 0 and path.len.usize().i64() == path.len
    requires sview_find_last_byte(path, 46) > sview_find_last_byte(path, 47) + 1
    ensure result == true
    dot: i64 = sview_find_last_byte(path, 46)
    extension: sview = Fs::extension(path)
    return (
        extension.len == path.len - dot
        and extension.data == path.data + dot.usize()
        and (forall offset in 0..<extension.len:
            string_view_index(extension, offset) == string_view_index(path, dot + offset))
    )

def extension_is_empty_without_a_dot_after_the_basename_start(path: sview) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires path.len >= 0 and path.len.usize().i64() == path.len
    requires sview_find_last_byte(path, 46) <= sview_find_last_byte(path, 47) + 1
    ensure result == true
    return Fs::extension(path).len == 0

def stem_preserves_the_prefix_before_the_last_dot(path: sview) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires path.len >= 0 and path.len.usize().i64() == path.len
    requires sview_find_last_byte(path, 46) > sview_find_last_byte(path, 47) + 1
    ensure result == true
    slash: i64 = sview_find_last_byte(path, 47)
    dot: i64 = sview_find_last_byte(path, 46)
    stem: sview = Fs::stem(path)
    return (
        stem.len == dot - (slash + 1)
        and stem.data == path.data + (slash + 1).usize()
        and (forall offset in 0..<stem.len:
            string_view_index(stem, offset) == string_view_index(path, slash + 1 + offset))
    )

def stem_is_the_full_basename_without_a_qualifying_dot(path: sview) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires path.len >= 0 and path.len.usize().i64() == path.len
    requires sview_find_last_byte(path, 46) <= sview_find_last_byte(path, 47) + 1
    ensure result == true
    slash: i64 = sview_find_last_byte(path, 47)
    stem: sview = Fs::stem(path)
    return (
        stem.len == path.len - (slash + 1)
        and (stem.len == 0 or stem.data == path.data + (slash + 1).usize())
        and (forall offset in 0..<stem.len:
            string_view_index(stem, offset) == string_view_index(path, slash + 1 + offset))
    )

def malformed_path_extension_and_stem_are_empty(path: sview) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires path.len < 0 or path.len.usize().i64() != path.len
    ensure result == true
    return Fs::extension(path).len == 0 and Fs::stem(path).len == 0

def a_leading_dot_is_part_of_a_hidden_file_stem() -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    ensure result == true
    path: sview = ".env"
    extension: sview = Fs::extension(path)
    stem: sview = Fs::stem(path)
    return extension.len == 0 and stem.len == 4 and string_view_index(stem, 0) == 46

def a_trailing_dot_is_a_one_byte_extension() -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    ensure result == true
    path: sview = "file."
    extension: sview = Fs::extension(path)
    stem: sview = Fs::stem(path)
    return extension.len == 1 and string_view_index(extension, 0) == 46 and stem.len == 4

def a_directory_dot_does_not_define_the_file_extension() -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    ensure result == true
    path: sview = "dir.name/file"
    extension: sview = Fs::extension(path)
    stem: sview = Fs::stem(path)
    return extension.len == 0 and stem.len == 4
