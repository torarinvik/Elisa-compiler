# `else` belongs to a checked subscript fallback unless its following tokens
# begin a control-flow or error-binding recovery clause.
def recovery_classifier_is_exact(current_is_else: bool, is_transfer: bool, is_identifier: bool, after_identifier_is_colon: bool) -> bool:
    ensure result == (current_is_else and (is_transfer or (is_identifier and after_identifier_is_colon)))
    return current_is_else and (is_transfer or (is_identifier and after_identifier_is_colon))

def transfer_after_else_is_recovery(current_is_else: bool, is_transfer: bool, is_identifier: bool, after_identifier_is_colon: bool) -> bool:
    requires current_is_else and is_transfer
    ensure result == true
    return current_is_else and (is_transfer or (is_identifier and after_identifier_is_colon))

def identifier_colon_after_else_is_recovery(current_is_else: bool, is_transfer: bool, is_identifier: bool, after_identifier_is_colon: bool) -> bool:
    requires current_is_else and not is_transfer and is_identifier and after_identifier_is_colon
    ensure result == true
    return current_is_else and (is_transfer or (is_identifier and after_identifier_is_colon))

def identifier_without_colon_after_else_is_subscript_fallback(current_is_else: bool, is_transfer: bool, is_identifier: bool, after_identifier_is_colon: bool) -> bool:
    requires current_is_else and not is_transfer and is_identifier and not after_identifier_is_colon
    ensure result == false
    return current_is_else and (is_transfer or (is_identifier and after_identifier_is_colon))

def non_else_is_never_recovery(current_is_else: bool, is_transfer: bool, is_identifier: bool, after_identifier_is_colon: bool) -> bool:
    requires not current_is_else
    ensure result == false
    return current_is_else and (is_transfer or (is_identifier and after_identifier_is_colon))

# Brackets are parsed as type arguments only on the two reinterpret spellings.
def subscript_type_argument_classifier_is_exact(receiver_is_field: bool, is_cast: bool, is_call_as: bool) -> bool:
    ensure result == (receiver_is_field and (is_cast or is_call_as))
    return receiver_is_field and (is_cast or is_call_as)

def cast_field_uses_type_argument_context(receiver_is_field: bool, is_cast: bool, is_call_as: bool) -> bool:
    requires receiver_is_field and is_cast
    ensure result == true
    return receiver_is_field and (is_cast or is_call_as)

def call_as_field_uses_type_argument_context(receiver_is_field: bool, is_cast: bool, is_call_as: bool) -> bool:
    requires receiver_is_field and not is_cast and is_call_as
    ensure result == true
    return receiver_is_field and (is_cast or is_call_as)

def ordinary_field_stays_in_value_context(receiver_is_field: bool, is_cast: bool, is_call_as: bool) -> bool:
    requires receiver_is_field and not is_cast and not is_call_as
    ensure result == false
    return receiver_is_field and (is_cast or is_call_as)

def non_field_receiver_stays_in_value_context(receiver_is_field: bool, is_cast: bool, is_call_as: bool) -> bool:
    requires not receiver_is_field
    ensure result == false
    return receiver_is_field and (is_cast or is_call_as)
