include "./pymodule_default_hashable_policy.elisa"

def dstr_must_not_be_hashable() -> bool can[Abort.Panic]:
    ensure result == false
    return PymoduleDefaultHashablePolicy::is_python_hashable_type("dstr")

def wide_integer_must_not_be_hashable() -> bool can[Abort.Panic]:
    ensure result == false
    return PymoduleDefaultHashablePolicy::is_python_hashable_type("i128")
