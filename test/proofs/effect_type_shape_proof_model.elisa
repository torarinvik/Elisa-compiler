# Minimal AST projection consumed by the production effect-shape helpers.
# The checker pins every modeled constructor and field to the production AST.
module Ast:
    public:
        enum Node layout(handle: u32):
            pass

        struct Pos:
            line: mutable u32
            column: mutable u32
            offset: mutable u32
            end_line: mutable u32
            end_column: mutable u32
            end_offset: mutable u32

        enum Expr is Node:
            Absent
            Ident(name: sview, pos: Pos)
            Scope(base: Expr, name: sview, pos: Pos)
            Index(object: Expr, index: Expr, pos: Pos)
            IndexN(object: Expr, arguments: darray[Expr], pos: Pos)

        struct StaticEffectCandidate:
            captures: darray[Expr]

include "../../src/parser/effect_type_shape.elisa"
