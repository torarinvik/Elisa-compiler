# Source-linked proof of the separate Stage0 function-annotation allowlists.
include "../../src/semantic/function_annotation_name.elisa"

def source_function_annotation_match_is_exact(name: sview) -> bool can[Abort.Panic]:
    ensure result == (
        when name:
            "test" | "bench" | "property" | "differential" | "lockstep" | "fixture" | "skip" | "inline" | "fast_math" | "norecurse" | "hot" | "cold" | "callconv" | "guard_nonnull" | "guard_variant" | "internal" | "main_thread" | "init" | "async_entry" | "segment_agnostic" | "segment_establishing" | "segment_transition" | "reentrant_safe" | "deprecated" | "noalloc" | "inbounds" | "nolock" | "link_name" | "boundary_pointer_args" -> true
            _ -> false
    )
    can Abort.Panic:
        return FunctionAnnotationName::is_function_annotation(name)

def source_extern_function_annotation_match_is_exact(name: sview) -> bool can[Abort.Panic]:
    ensure result == (
        when name:
            "borrows_return" | "link_name" | "intrinsic" | "wasm_import_module" | "callconv" | "internal" | "blocking" | "nonblocking" | "segment_transition" | "reentrant_safe" | "deprecated" | "trusted" | "bounds" -> true
            _ -> false
    )
    can Abort.Panic:
        return FunctionAnnotationName::is_extern_function_annotation(name)

def every_stage0_function_annotation_is_accepted() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            FunctionAnnotationName::is_function_annotation("test")
            and FunctionAnnotationName::is_function_annotation("bench")
            and FunctionAnnotationName::is_function_annotation("property")
            and FunctionAnnotationName::is_function_annotation("differential")
            and FunctionAnnotationName::is_function_annotation("lockstep")
            and FunctionAnnotationName::is_function_annotation("fixture")
            and FunctionAnnotationName::is_function_annotation("skip")
            and FunctionAnnotationName::is_function_annotation("inline")
            and FunctionAnnotationName::is_function_annotation("fast_math")
            and FunctionAnnotationName::is_function_annotation("norecurse")
            and FunctionAnnotationName::is_function_annotation("hot")
            and FunctionAnnotationName::is_function_annotation("cold")
            and FunctionAnnotationName::is_function_annotation("callconv")
            and FunctionAnnotationName::is_function_annotation("guard_nonnull")
            and FunctionAnnotationName::is_function_annotation("guard_variant")
            and FunctionAnnotationName::is_function_annotation("internal")
            and FunctionAnnotationName::is_function_annotation("main_thread")
            and FunctionAnnotationName::is_function_annotation("init")
            and FunctionAnnotationName::is_function_annotation("async_entry")
            and FunctionAnnotationName::is_function_annotation("segment_agnostic")
            and FunctionAnnotationName::is_function_annotation("segment_establishing")
            and FunctionAnnotationName::is_function_annotation("segment_transition")
            and FunctionAnnotationName::is_function_annotation("reentrant_safe")
            and FunctionAnnotationName::is_function_annotation("deprecated")
            and FunctionAnnotationName::is_function_annotation("noalloc")
            and FunctionAnnotationName::is_function_annotation("inbounds")
            and FunctionAnnotationName::is_function_annotation("nolock")
            and FunctionAnnotationName::is_function_annotation("link_name")
            and FunctionAnnotationName::is_function_annotation("boundary_pointer_args")
        )

def every_stage0_extern_function_annotation_is_accepted() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            FunctionAnnotationName::is_extern_function_annotation("borrows_return")
            and FunctionAnnotationName::is_extern_function_annotation("link_name")
            and FunctionAnnotationName::is_extern_function_annotation("intrinsic")
            and FunctionAnnotationName::is_extern_function_annotation("wasm_import_module")
            and FunctionAnnotationName::is_extern_function_annotation("callconv")
            and FunctionAnnotationName::is_extern_function_annotation("internal")
            and FunctionAnnotationName::is_extern_function_annotation("blocking")
            and FunctionAnnotationName::is_extern_function_annotation("nonblocking")
            and FunctionAnnotationName::is_extern_function_annotation("segment_transition")
            and FunctionAnnotationName::is_extern_function_annotation("reentrant_safe")
            and FunctionAnnotationName::is_extern_function_annotation("deprecated")
            and FunctionAnnotationName::is_extern_function_annotation("trusted")
            and FunctionAnnotationName::is_extern_function_annotation("bounds")
        )

def unrelated_annotation_names_stay_rejected() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            not FunctionAnnotationName::is_function_annotation("")
            and not FunctionAnnotationName::is_function_annotation("testx")
            and not FunctionAnnotationName::is_function_annotation("wasm_import_module")
            and not FunctionAnnotationName::is_extern_function_annotation("")
            and not FunctionAnnotationName::is_extern_function_annotation("boundsx")
            and not FunctionAnnotationName::is_extern_function_annotation("test")
        )
