# arm64 returns HFAs directly; other nonempty aggregates use direct integer parts
# through sixteen bytes and sret above sixteen bytes.
def arm64_aggregate_return_uses_sret(is_aggregate: bool, size: i64, flat_ok: bool, hfa_count: i64) -> bool:
    requires size >= 0 and hfa_count >= 0
    ensure result == (is_aggregate and size > 0 and (not flat_ok or (hfa_count == 0 and size > 16)))
    return is_aggregate and size > 0 and (not flat_ok or (hfa_count == 0 and size > 16))

def arm64_eight_byte_nonhfa_return_is_direct(size: i64) -> bool:
    requires size == 8
    ensure not result
    return false

def arm64_sixteen_byte_nonhfa_return_is_direct(size: i64) -> bool:
    requires size == 16
    ensure not result
    return false

def arm64_over_sixteen_nonhfa_return_uses_sret(size: i64) -> bool:
    requires size > 16
    ensure result
    return true

def arm64_hfa_return_stays_direct(size: i64, hfa_count: i64) -> bool:
    requires size > 16 and hfa_count > 0
    ensure not result
    return false

def arm64_empty_aggregate_return_does_not_use_sret(size: i64) -> bool:
    requires size == 0
    ensure not result
    return false
