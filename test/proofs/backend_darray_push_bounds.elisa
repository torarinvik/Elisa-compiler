# Arithmetic model for the ordinary DArray push store path. A strict capacity
# guard gives one additional slot without evaluating an overflowing increment.

def guarded_count_increment_fits_capacity(count: u64, capacity: u64, target_max: u64) -> bool:
    requires count < capacity
    requires capacity <= target_max
    ensure result == true
    return count + 1 <= capacity

def full_capacity_guard_rejects_the_store_path(count: u64, capacity: u64) -> bool:
    requires count == capacity
    ensure result == true
    return not (count < capacity)

