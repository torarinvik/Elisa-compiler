# Arithmetic model for the ordinary DArray push store path. A strict capacity
# guard gives one additional slot without evaluating an overflowing increment.

def guarded_count_increment_fits_capacity(count: u64, capacity: u64, target_max: u64) -> bool:
    requires count < capacity
    requires capacity <= target_max
    ensure result == true
    return count + 1 <= capacity

def full_capacity_guard_rejects_the_store_path(count: u64, capacity: u64) -> bool:
    requires count == capacity
    ensure result == true
    return not (count < capacity)


def guarded_count_increment_fits_target_limit(count: u64, capacity: u64, target_max: u64) -> u64:
    requires count < capacity
    requires capacity <= target_max
    ensure result <= target_max
    return count + 1

def push_growth_capacity_covers_needed(capacity: u64, needed: u64, doubled: u64, overflow: bool) -> u64:
    ensure result >= needed
    return needed if (8 if capacity == 0 else (needed if overflow else doubled)) < needed else (8 if capacity == 0 else (needed if overflow else doubled))

def push_growth_overflow_fallback_selects_needed(capacity: u64, needed: u64, doubled: u64, overflow: bool) -> u64:
    requires capacity > 0
    requires overflow
    ensure result == needed
    return needed if (8 if capacity == 0 else (needed if overflow else doubled)) < needed else (8 if capacity == 0 else (needed if overflow else doubled))

def empty_push_growth_keeps_seed_when_it_fits(capacity: u64, needed: u64, doubled: u64, overflow: bool) -> u64:
    requires capacity == 0
    requires needed <= 8
    ensure result == 8
    return needed if (8 if capacity == 0 else (needed if overflow else doubled)) < needed else (8 if capacity == 0 else (needed if overflow else doubled))

def empty_push_growth_uses_needed_above_seed(capacity: u64, needed: u64, doubled: u64, overflow: bool) -> u64:
    requires capacity == 0
    requires needed > 8
    ensure result == needed
    return needed if (8 if capacity == 0 else (needed if overflow else doubled)) < needed else (8 if capacity == 0 else (needed if overflow else doubled))

def append_growth_step_increases_capacity(capacity: u64, needed: u64, doubled: u64, overflow: bool) -> u64:
    requires capacity < needed
    requires capacity == 0 or overflow or doubled > capacity
    ensure result > capacity
    return 8 if capacity == 0 else (needed if overflow else doubled)

def append_growth_overflow_step_meets_bound(capacity: u64, needed: u64, doubled: u64, overflow: bool) -> u64:
    requires capacity > 0
    requires capacity < needed
    requires overflow
    ensure result == needed
    ensure result >= needed
    return needed if (8 if capacity == 0 else (needed if overflow else doubled)) < needed else (8 if capacity == 0 else (needed if overflow else doubled))

def normal_growth_selects_double_when_it_covers_needed(capacity: u64, needed: u64, doubled: u64) -> u64:
    requires capacity > 0
    requires doubled >= needed
    ensure result == doubled
    return needed if (8 if capacity == 0 else doubled) < needed else (8 if capacity == 0 else doubled)

def normal_growth_selects_needed_when_double_is_too_small(capacity: u64, needed: u64, doubled: u64) -> u64:
    requires capacity > 0
    requires doubled < needed
    ensure result == needed
    return needed if (8 if capacity == 0 else doubled) < needed else (8 if capacity == 0 else doubled)
