# Finite register-index model for EASM's call liveness transfer. The admission checker
# derives these classes from the canonical masks and pins the model to easm_flow_transfer.
const REG_RAX: i64 = 0
const REG_RCX: i64 = 1
const REG_RDX: i64 = 2
const REG_RBX: i64 = 3
const REG_RSI: i64 = 4
const REG_RDI: i64 = 5
const REG_RBP: i64 = 6
const REG_RSP: i64 = 7
const REG_R8: i64 = 8
const REG_R9: i64 = 9
const REG_R10: i64 = 10
const REG_R11: i64 = 11
const REG_R12: i64 = 12
const REG_R13: i64 = 13
const REG_R14: i64 = 14
const REG_R15: i64 = 15

def model_call_preserves_register_index(register_index: i64) -> bool:
    ensure result == (register_index == REG_RAX or register_index == REG_RSP or register_index == REG_RBX or register_index == REG_RBP or register_index == REG_R12 or register_index == REG_R13 or register_index == REG_R14 or register_index == REG_R15)
    return register_index == REG_RAX or register_index == REG_RSP or register_index == REG_RBX or register_index == REG_RBP or register_index == REG_R12 or register_index == REG_R13 or register_index == REG_R14 or register_index == REG_R15

def model_call_invalidates_register_index(register_index: i64) -> bool:
    ensure result == (register_index == REG_RCX or register_index == REG_RDX or register_index == REG_RSI or register_index == REG_RDI or register_index == REG_R8 or register_index == REG_R9 or register_index == REG_R10 or register_index == REG_R11)
    return register_index == REG_RCX or register_index == REG_RDX or register_index == REG_RSI or register_index == REG_RDI or register_index == REG_R8 or register_index == REG_R9 or register_index == REG_R10 or register_index == REG_R11

def call_transfer_clears_live_flags(was_live: bool) -> bool:
    ensure result == false
    return false

def every_register_slot_has_its_exact_call_effect_class() -> bool:
    ensure result == true
    return (
        REG_RAX == 0 and REG_RCX == 1 and REG_RDX == 2 and REG_RBX == 3 and
        REG_RSI == 4 and REG_RDI == 5 and REG_RBP == 6 and REG_RSP == 7 and
        REG_R8 == 8 and REG_R9 == 9 and REG_R10 == 10 and REG_R11 == 11 and
        REG_R12 == 12 and REG_R13 == 13 and REG_R14 == 14 and REG_R15 == 15 and
        (REG_RAX == 0 or REG_RAX == 3 or REG_RAX == 6 or REG_RAX == 7 or REG_RAX == 12 or REG_RAX == 13 or REG_RAX == 14 or REG_RAX == 15) and
        (REG_RCX == 1 or REG_RCX == 2 or REG_RCX == 4 or REG_RCX == 5 or REG_RCX == 8 or REG_RCX == 9 or REG_RCX == 10 or REG_RCX == 11) and
        (REG_RDX == 1 or REG_RDX == 2 or REG_RDX == 4 or REG_RDX == 5 or REG_RDX == 8 or REG_RDX == 9 or REG_RDX == 10 or REG_RDX == 11) and
        (REG_RBX == 0 or REG_RBX == 3 or REG_RBX == 6 or REG_RBX == 7 or REG_RBX == 12 or REG_RBX == 13 or REG_RBX == 14 or REG_RBX == 15) and
        (REG_RSI == 1 or REG_RSI == 2 or REG_RSI == 4 or REG_RSI == 5 or REG_RSI == 8 or REG_RSI == 9 or REG_RSI == 10 or REG_RSI == 11) and
        (REG_RDI == 1 or REG_RDI == 2 or REG_RDI == 4 or REG_RDI == 5 or REG_RDI == 8 or REG_RDI == 9 or REG_RDI == 10 or REG_RDI == 11) and
        (REG_RBP == 0 or REG_RBP == 3 or REG_RBP == 6 or REG_RBP == 7 or REG_RBP == 12 or REG_RBP == 13 or REG_RBP == 14 or REG_RBP == 15) and
        (REG_RSP == 0 or REG_RSP == 3 or REG_RSP == 6 or REG_RSP == 7 or REG_RSP == 12 or REG_RSP == 13 or REG_RSP == 14 or REG_RSP == 15) and
        (REG_R8 == 1 or REG_R8 == 2 or REG_R8 == 4 or REG_R8 == 5 or REG_R8 == 8 or REG_R8 == 9 or REG_R8 == 10 or REG_R8 == 11) and
        (REG_R9 == 1 or REG_R9 == 2 or REG_R9 == 4 or REG_R9 == 5 or REG_R9 == 8 or REG_R9 == 9 or REG_R9 == 10 or REG_R9 == 11) and
        (REG_R10 == 1 or REG_R10 == 2 or REG_R10 == 4 or REG_R10 == 5 or REG_R10 == 8 or REG_R10 == 9 or REG_R10 == 10 or REG_R10 == 11) and
        (REG_R11 == 1 or REG_R11 == 2 or REG_R11 == 4 or REG_R11 == 5 or REG_R11 == 8 or REG_R11 == 9 or REG_R11 == 10 or REG_R11 == 11) and
        (REG_R12 == 0 or REG_R12 == 3 or REG_R12 == 6 or REG_R12 == 7 or REG_R12 == 12 or REG_R12 == 13 or REG_R12 == 14 or REG_R12 == 15) and
        (REG_R13 == 0 or REG_R13 == 3 or REG_R13 == 6 or REG_R13 == 7 or REG_R13 == 12 or REG_R13 == 13 or REG_R13 == 14 or REG_R13 == 15) and
        (REG_R14 == 0 or REG_R14 == 3 or REG_R14 == 6 or REG_R14 == 7 or REG_R14 == 12 or REG_R14 == 13 or REG_R14 == 14 or REG_R14 == 15) and
        (REG_R15 == 0 or REG_R15 == 3 or REG_R15 == 6 or REG_R15 == 7 or REG_R15 == 12 or REG_R15 == 13 or REG_R15 == 14 or REG_R15 == 15)
    )

def rax_is_disjoint_from_the_invalidated_class() -> bool:
    ensure result == true
    return REG_RAX != REG_RCX and REG_RAX != REG_RDX and REG_RAX != REG_RSI and REG_RAX != REG_RDI and REG_RAX != REG_R8 and REG_RAX != REG_R9 and REG_RAX != REG_R10 and REG_RAX != REG_R11

def rsp_is_disjoint_from_the_invalidated_class() -> bool:
    ensure result == true
    return REG_RSP != REG_RCX and REG_RSP != REG_RDX and REG_RSP != REG_RSI and REG_RSP != REG_RDI and REG_RSP != REG_R8 and REG_RSP != REG_R9 and REG_RSP != REG_R10 and REG_RSP != REG_R11

def rbx_is_disjoint_from_the_invalidated_class() -> bool:
    ensure result == true
    return REG_RBX != REG_RCX and REG_RBX != REG_RDX and REG_RBX != REG_RSI and REG_RBX != REG_RDI and REG_RBX != REG_R8 and REG_RBX != REG_R9 and REG_RBX != REG_R10 and REG_RBX != REG_R11

def rbp_is_disjoint_from_the_invalidated_class() -> bool:
    ensure result == true
    return REG_RBP != REG_RCX and REG_RBP != REG_RDX and REG_RBP != REG_RSI and REG_RBP != REG_RDI and REG_RBP != REG_R8 and REG_RBP != REG_R9 and REG_RBP != REG_R10 and REG_RBP != REG_R11

def r12_is_disjoint_from_the_invalidated_class() -> bool:
    ensure result == true
    return REG_R12 != REG_RCX and REG_R12 != REG_RDX and REG_R12 != REG_RSI and REG_R12 != REG_RDI and REG_R12 != REG_R8 and REG_R12 != REG_R9 and REG_R12 != REG_R10 and REG_R12 != REG_R11

def r13_is_disjoint_from_the_invalidated_class() -> bool:
    ensure result == true
    return REG_R13 != REG_RCX and REG_R13 != REG_RDX and REG_R13 != REG_RSI and REG_R13 != REG_RDI and REG_R13 != REG_R8 and REG_R13 != REG_R9 and REG_R13 != REG_R10 and REG_R13 != REG_R11

def r14_is_disjoint_from_the_invalidated_class() -> bool:
    ensure result == true
    return REG_R14 != REG_RCX and REG_R14 != REG_RDX and REG_R14 != REG_RSI and REG_R14 != REG_RDI and REG_R14 != REG_R8 and REG_R14 != REG_R9 and REG_R14 != REG_R10 and REG_R14 != REG_R11

def r15_is_disjoint_from_the_invalidated_class() -> bool:
    ensure result == true
    return REG_R15 != REG_RCX and REG_R15 != REG_RDX and REG_R15 != REG_RSI and REG_R15 != REG_RDI and REG_R15 != REG_R8 and REG_R15 != REG_R9 and REG_R15 != REG_R10 and REG_R15 != REG_R11
