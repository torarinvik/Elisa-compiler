include "./ownership_binding_fact_flow.elisa"

const TARGET_DECL_ID: u32 = 8
const FOREIGN_DECL_ID: u32 = 9

def foreign_binding_can_join_as_known(serial: u64) -> bool:
    ensure result == true
    expected: Semantic::BindingId = Semantic::BindingId{owner: Semantic::DeclId{value: TARGET_DECL_ID}, serial: serial}
    foreign: Semantic::BindingId = Semantic::BindingId{owner: Semantic::DeclId{value: FOREIGN_DECL_ID}, serial: serial}
    left: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: foreign,
        reachable: true,
        known: true,
        may_live: true,
        may_consumed: false}
    right: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: expected,
        reachable: false,
        known: true,
        may_live: false,
        may_consumed: false}
    joined: Semantic::OwnershipBindingFact = Semantic::ownership_binding_join(expected, left, right)
    return joined.known

def foreign_serial_binding_can_join_as_known(owner: u32, serial: u64, foreign_serial: u64) -> bool:
    requires owner != Semantic::INVALID_DECL_ID_VALUE and serial != foreign_serial
    ensure result == true
    expected: Semantic::BindingId = Semantic::BindingId{owner: Semantic::DeclId{value: owner}, serial: serial}
    foreign: Semantic::BindingId = Semantic::BindingId{owner: Semantic::DeclId{value: owner}, serial: foreign_serial}
    left: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: foreign,
        reachable: true,
        known: true,
        may_live: true,
        may_consumed: false}
    right: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: expected,
        reachable: false,
        known: true,
        may_live: false,
        may_consumed: false}
    joined: Semantic::OwnershipBindingFact = Semantic::ownership_binding_join(expected, left, right)
    return joined.known

def foreign_right_serial_binding_can_join_as_known(owner: u32, serial: u64, foreign_serial: u64) -> bool:
    requires owner != Semantic::INVALID_DECL_ID_VALUE and serial != foreign_serial
    ensure result == true
    expected: Semantic::BindingId = Semantic::BindingId{owner: Semantic::DeclId{value: owner}, serial: serial}
    foreign: Semantic::BindingId = Semantic::BindingId{owner: Semantic::DeclId{value: owner}, serial: foreign_serial}
    left: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: expected,
        reachable: false,
        known: true,
        may_live: false,
        may_consumed: false}
    right: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: foreign,
        reachable: true,
        known: true,
        may_live: true,
        may_consumed: false}
    joined: Semantic::OwnershipBindingFact = Semantic::ownership_binding_join(expected, left, right)
    return joined.known

def foreign_fact_can_replace_join_target(owner: u32, foreign_owner: u32, serial: u64) -> bool:
    requires owner != Semantic::INVALID_DECL_ID_VALUE and foreign_owner != Semantic::INVALID_DECL_ID_VALUE and owner != foreign_owner
    ensure result == true
    expected: Semantic::BindingId = Semantic::BindingId{owner: Semantic::DeclId{value: owner}, serial: serial}
    foreign: Semantic::BindingId = Semantic::BindingId{owner: Semantic::DeclId{value: foreign_owner}, serial: serial}
    left: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: foreign,
        reachable: true,
        known: true,
        may_live: true,
        may_consumed: false}
    right: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: expected,
        reachable: false,
        known: true,
        may_live: false,
        may_consumed: false}
    joined: Semantic::OwnershipBindingFact = Semantic::ownership_binding_join(expected, left, right)
    return joined.binding_id.owner.value != owner or joined.binding_id.serial != serial

def consumed_binding_can_be_consumed_again(owner: u32, serial: u64) -> bool:
    requires owner != Semantic::INVALID_DECL_ID_VALUE
    ensure result == true
    fact: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: Semantic::BindingId{owner: Semantic::DeclId{value: owner},
        serial: serial},
        reachable: true,
        known: true,
        may_live: false,
        may_consumed: true}
    accepted, _next = Semantic::ownership_binding_consume(fact)
    return accepted

def arbitrary_binding_fact_can_be_accepted_twice(owner: u32,
    serial: u64,
    reachable: bool,
    known: bool,
    may_live: bool,
    may_consumed: bool) -> bool:
    requires owner != Semantic::INVALID_DECL_ID_VALUE
    ensure result == true
    fact: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: Semantic::BindingId{owner: Semantic::DeclId{value: owner},
        serial: serial},
        reachable: reachable,
        known: known,
        may_live: may_live,
        may_consumed: may_consumed}
    accepted, after_first = Semantic::ownership_binding_consume(fact)
    accepted_again, _after_second = Semantic::ownership_binding_consume(after_first)
    return accepted and accepted_again
