# False destination-effect claims must stay unprovable.
include "./easm_memory_effect_policy.elisa"

def compare_is_a_memory_destination_write() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return EasmMemoryEffectPolicy::destination_writes_memory("cmp")

def ordinary_move_reads_its_old_memory_destination() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return EasmMemoryEffectPolicy::destination_reads_memory("movq")

def indirect_call_writes_its_explicit_memory_destination() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return EasmMemoryEffectPolicy::destination_writes_memory("call")

def pseudo_move_writes_its_memory_destination() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return EasmMemoryEffectPolicy::memory_writes("movq", true, true)

def lea_reads_its_memory_source() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return EasmMemoryEffectPolicy::memory_reads("lea", false, true, false)

def absent_memory_destination_is_written() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return EasmMemoryEffectPolicy::memory_writes("movq", false, false)

def status_save_reads_an_explicit_memory_source() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return EasmMemoryEffectPolicy::memory_reads("fnstcw", false, true, false)

def control_state_load_writes_a_memory_destination() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return EasmMemoryEffectPolicy::memory_writes("fldcw", false, true)

def pop_explicit_memory_destination_is_read() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return EasmMemoryEffectPolicy::memory_reads("pop", false, true, true)
