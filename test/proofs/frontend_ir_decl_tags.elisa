# Proofs of the exact stage0 schema IDs used for frontend-IR declaration nodes.
include "../../src/driver/frontend_ir_decl_tags.elisa"

def every_declaration_kind_uses_its_schema_id(kind: FrontendIrDeclarationNodeTags::NodeKind) -> bool:
    ensure result == true
    return match kind:
        FrontendIrDeclarationNodeTags::NodeKind.FuncDecl: FrontendIrDeclarationNodeTags::node_tag(kind) == FrontendIrDeclarationNodeTags::FUNC_DECL_NODE_TAG
        FrontendIrDeclarationNodeTags::NodeKind.StructDecl: FrontendIrDeclarationNodeTags::node_tag(kind) == FrontendIrDeclarationNodeTags::STRUCT_DECL_NODE_TAG
        FrontendIrDeclarationNodeTags::NodeKind.EnumDecl: FrontendIrDeclarationNodeTags::node_tag(kind) == FrontendIrDeclarationNodeTags::ENUM_DECL_NODE_TAG
        FrontendIrDeclarationNodeTags::NodeKind.ConstEnumDecl: FrontendIrDeclarationNodeTags::node_tag(kind) == FrontendIrDeclarationNodeTags::CONST_ENUM_DECL_NODE_TAG
        FrontendIrDeclarationNodeTags::NodeKind.TypeAliasDecl: FrontendIrDeclarationNodeTags::node_tag(kind) == FrontendIrDeclarationNodeTags::TYPE_ALIAS_DECL_NODE_TAG
        FrontendIrDeclarationNodeTags::NodeKind.ImportDecl: FrontendIrDeclarationNodeTags::node_tag(kind) == FrontendIrDeclarationNodeTags::IMPORT_DECL_NODE_TAG
        FrontendIrDeclarationNodeTags::NodeKind.NamespaceDecl: FrontendIrDeclarationNodeTags::node_tag(kind) == FrontendIrDeclarationNodeTags::NAMESPACE_DECL_NODE_TAG
        FrontendIrDeclarationNodeTags::NodeKind.GlobalDecl: FrontendIrDeclarationNodeTags::node_tag(kind) == FrontendIrDeclarationNodeTags::GLOBAL_DECL_NODE_TAG
        FrontendIrDeclarationNodeTags::NodeKind.ConstDecl: FrontendIrDeclarationNodeTags::node_tag(kind) == FrontendIrDeclarationNodeTags::CONST_DECL_NODE_TAG

def distinct_declaration_kinds_have_distinct_node_tags(left: FrontendIrDeclarationNodeTags::NodeKind, right: FrontendIrDeclarationNodeTags::NodeKind) -> bool:
    requires left != right
    ensure result == true
    return FrontendIrDeclarationNodeTags::node_tag(left) != FrontendIrDeclarationNodeTags::node_tag(right)

def every_declaration_kind_uses_pairwise_distinct_field_ids(kind: FrontendIrDeclarationNodeTags::NodeKind) -> bool:
    ensure result == true
    return FrontendIrDeclarationNodeTags::field_ids_are_pairwise_distinct(kind)

def declaration_node_tags_are_pairwise_distinct() -> bool:
    ensure result == true
    return (
        FrontendIrDeclarationNodeTags::FUNC_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::STRUCT_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::FUNC_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::ENUM_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::FUNC_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::CONST_ENUM_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::FUNC_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::TYPE_ALIAS_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::FUNC_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::IMPORT_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::FUNC_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::NAMESPACE_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::FUNC_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::GLOBAL_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::FUNC_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::CONST_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::STRUCT_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::ENUM_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::STRUCT_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::CONST_ENUM_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::STRUCT_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::TYPE_ALIAS_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::STRUCT_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::IMPORT_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::STRUCT_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::NAMESPACE_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::STRUCT_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::GLOBAL_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::STRUCT_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::CONST_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::ENUM_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::CONST_ENUM_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::ENUM_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::TYPE_ALIAS_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::ENUM_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::IMPORT_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::ENUM_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::NAMESPACE_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::ENUM_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::GLOBAL_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::ENUM_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::CONST_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::CONST_ENUM_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::TYPE_ALIAS_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::CONST_ENUM_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::IMPORT_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::CONST_ENUM_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::NAMESPACE_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::CONST_ENUM_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::GLOBAL_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::CONST_ENUM_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::CONST_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::TYPE_ALIAS_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::IMPORT_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::TYPE_ALIAS_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::NAMESPACE_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::TYPE_ALIAS_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::GLOBAL_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::TYPE_ALIAS_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::CONST_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::IMPORT_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::NAMESPACE_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::IMPORT_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::GLOBAL_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::IMPORT_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::CONST_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::NAMESPACE_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::GLOBAL_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::NAMESPACE_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::CONST_DECL_NODE_TAG
        and FrontendIrDeclarationNodeTags::GLOBAL_DECL_NODE_TAG != FrontendIrDeclarationNodeTags::CONST_DECL_NODE_TAG
    )
