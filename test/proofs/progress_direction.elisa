# Source-linked proof of the finite comparison and update direction rules in -emit progress.
include "./parser_token_kind_projection.elisa"
include "../../src/driver/progress_direction.elisa"

def source_comparison_operator_mapping_is_exact(operator: Lexer::TokenKind) -> ProgressDirection::Direction:
    ensure when operator:
        Lexer::TokenKind.Lt | Lexer::TokenKind.LtEq -> result == (ProgressDirection::Direction.Increase)
        Lexer::TokenKind.Gt | Lexer::TokenKind.GtEq -> result == (ProgressDirection::Direction.Decrease)
        _ -> result == (ProgressDirection::Direction.NoDirection)
    return ProgressDirection::from_comparison_operator(operator)

def all_loop_bound_comparisons_have_the_expected_direction() -> bool:
    ensure result == true
    return (
        ProgressDirection::from_comparison_operator(Lexer::TokenKind.Lt) == ProgressDirection::Direction.Increase
        and ProgressDirection::from_comparison_operator(Lexer::TokenKind.LtEq) == ProgressDirection::Direction.Increase
        and ProgressDirection::from_comparison_operator(Lexer::TokenKind.Gt) == ProgressDirection::Direction.Decrease
        and ProgressDirection::from_comparison_operator(Lexer::TokenKind.GtEq) == ProgressDirection::Direction.Decrease
    )

def unrelated_comparisons_have_no_progress_direction() -> bool:
    ensure result == true
    return (
        ProgressDirection::from_comparison_operator(Lexer::TokenKind.EqEq) == ProgressDirection::Direction.NoDirection
        and ProgressDirection::from_comparison_operator(Lexer::TokenKind.BangEq) == ProgressDirection::Direction.NoDirection
        and ProgressDirection::from_comparison_operator(Lexer::TokenKind.Plus) == ProgressDirection::Direction.NoDirection
    )

def source_directional_update_rule_is_exact(direction: ProgressDirection::Direction, operator: Lexer::TokenKind, increase_operator: Lexer::TokenKind, decrease_operator: Lexer::TokenKind) -> bool:
    ensure when direction:
        ProgressDirection::Direction.Increase -> result == (operator == increase_operator)
        ProgressDirection::Direction.Decrease -> result == (operator == decrease_operator)
        _ -> result == (false)
    return ProgressDirection::advances(direction, operator, increase_operator, decrease_operator)

def source_signed_step_update_rule_is_exact(direction: ProgressDirection::Direction, operator: Lexer::TokenKind, step_direction: ProgressDirection::Direction, increase_operator: Lexer::TokenKind, decrease_operator: Lexer::TokenKind) -> bool:
    ensure result == (
        (direction == ProgressDirection::Direction.Increase and operator == increase_operator and step_direction == ProgressDirection::Direction.Increase) or
        (direction == ProgressDirection::Direction.Decrease and operator == decrease_operator and step_direction == ProgressDirection::Direction.Increase)
    )
    return ProgressDirection::advances_by_step(direction, operator, step_direction, increase_operator, decrease_operator)

def accepted_updates_match_their_bound_direction() -> bool:
    ensure result == true
    return (
        ProgressDirection::advances(ProgressDirection::Direction.Increase, Lexer::TokenKind.PlusEq, Lexer::TokenKind.PlusEq, Lexer::TokenKind.MinusEq)
        and ProgressDirection::advances(ProgressDirection::Direction.Decrease, Lexer::TokenKind.Minus, Lexer::TokenKind.Plus, Lexer::TokenKind.Minus)
        and not ProgressDirection::advances(ProgressDirection::Direction.Increase, Lexer::TokenKind.MinusEq, Lexer::TokenKind.PlusEq, Lexer::TokenKind.MinusEq)
        and not ProgressDirection::advances(ProgressDirection::Direction.Decrease, Lexer::TokenKind.Plus, Lexer::TokenKind.Plus, Lexer::TokenKind.Minus)
        and not ProgressDirection::advances(ProgressDirection::Direction.NoDirection, Lexer::TokenKind.PlusEq, Lexer::TokenKind.PlusEq, Lexer::TokenKind.MinusEq)
    )

def signed_steps_match_the_canonical_rule() -> bool:
    ensure result == true
    return (
        ProgressDirection::advances_by_step(ProgressDirection::Direction.Increase, Lexer::TokenKind.PlusEq, ProgressDirection::Direction.Increase, Lexer::TokenKind.PlusEq, Lexer::TokenKind.MinusEq)
        and ProgressDirection::advances_by_step(ProgressDirection::Direction.Decrease, Lexer::TokenKind.PlusEq, ProgressDirection::Direction.Decrease, Lexer::TokenKind.PlusEq, Lexer::TokenKind.MinusEq)
        and ProgressDirection::advances_by_step(ProgressDirection::Direction.Decrease, Lexer::TokenKind.Minus, ProgressDirection::Direction.Increase, Lexer::TokenKind.Plus, Lexer::TokenKind.Minus)
        and not ProgressDirection::advances_by_step(ProgressDirection::Direction.Increase, Lexer::TokenKind.PlusEq, ProgressDirection::Direction.NoDirection, Lexer::TokenKind.PlusEq, Lexer::TokenKind.MinusEq)
        and not ProgressDirection::advances_by_step(ProgressDirection::Direction.NoDirection, Lexer::TokenKind.PlusEq, ProgressDirection::Direction.NoDirection, Lexer::TokenKind.PlusEq, Lexer::TokenKind.MinusEq)
        and not ProgressDirection::advances_by_step(ProgressDirection::Direction.Increase, Lexer::TokenKind.PlusEq, ProgressDirection::Direction.Decrease, Lexer::TokenKind.PlusEq, Lexer::TokenKind.MinusEq)
        and not ProgressDirection::advances_by_step(ProgressDirection::Direction.Decrease, Lexer::TokenKind.PlusEq, ProgressDirection::Direction.Increase, Lexer::TokenKind.PlusEq, Lexer::TokenKind.MinusEq)
        and not ProgressDirection::advances_by_step(ProgressDirection::Direction.Increase, Lexer::TokenKind.Minus, ProgressDirection::Direction.Decrease, Lexer::TokenKind.Plus, Lexer::TokenKind.Minus)
    )
