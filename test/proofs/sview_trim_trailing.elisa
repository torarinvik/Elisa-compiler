# Maximal-prefix contract for the runtime's trailing-byte trim loop.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

def a_trimmed_view_keeps_the_maximal_prefix(view: sview, byte: u8) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    ensure result == true
    trimmed: sview = sview_trim_trailing(view, byte)
    return trimmed.len >= 0 and trimmed.len <= view.len
        and (trimmed.len == 0 or string_view_index(view, trimmed.len - 1) != byte.i64())
        and (forall suffix_index in trimmed.len..<view.len: string_view_index(view, suffix_index) == byte.i64())
        and (trimmed.len == 0 or trimmed.data == view.data)
