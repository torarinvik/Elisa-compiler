# Every concrete statement preserves its own source span. Invalid parser-recovery
# statements have no span and use Ast's all-zero sentinel.
include "../../src/parser/parser_tokens.elisa"
include "../../src/parser/ast_nodes.elisa"
using Ast

def stmt_pos_matches_the_owned_span_for_every_variant(statement: Stmt) -> bool:
    ensure result == true
    actual: Pos = Ast::stmt_pos(statement)
    match statement:
        Stmt.Invalid:
            return Ast::pos_equal(actual, Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0})
        Stmt.Expr(_, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Stmt.Block(_, _, _, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Stmt.VarDecl(_, _, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Stmt.Assign(_, _, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Stmt.If(_, _, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Stmt.While(_, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Stmt.For(_, _, _, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Stmt.Return(_, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Stmt.Break(_, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Stmt.Continue(_, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Stmt.Match(_, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Stmt.Contract(_, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
