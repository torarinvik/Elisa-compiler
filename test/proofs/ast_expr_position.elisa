# Every expression carries its own source position except the two explicit
# absence/error sentinels, which use the all-zero position. The checker binds this
# case analysis to Ast.expr_pos and the sealed Expr constructor list.
include "../../src/parser/parser_tokens.elisa"
include "../../src/parser/ast_nodes.elisa"
using Ast

def expr_pos_matches_the_owned_span_for_every_variant(expression: Expr) -> bool:
    ensure result == true
    actual: Pos = Ast::expr_pos(expression)
    match expression:
        Expr.Invalid:
            return Ast::pos_equal(actual, Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0})
        Expr.Absent:
            return Ast::pos_equal(actual, Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0})
        Expr.IntLit(_, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.FloatLit(_, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.StringLit(_, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.CharLit(_, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.BoolLit(_, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.Ident(_, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.Call(_, _, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.StaticEffectCall(_, _, _, _, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.Field(_, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.Scope(_, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.ShorthandMember(_, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.Index(_, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.Slice(_, _, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.IndexN(_, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.Binary(_, _, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.Unary(_, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.Move(_, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.RegionNew(_, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.Paren(_, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.Array(_, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.Tuple(_, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.SetLit(_, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.DictLit(_, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.Construct(_, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.RecordUpdate(_, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.If(_, _, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.Match(_, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.Catch(_, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.Comprehension(_, _, _, _, node_pos, _):
            return Ast::pos_equal(actual, node_pos)
        Expr.Refinement(_, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.GetElse(_, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.Lambda(_, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
        Expr.Block(_, _, _, node_pos):
            return Ast::pos_equal(actual, node_pos)
