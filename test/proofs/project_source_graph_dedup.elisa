# The source graph reuses an existing file slot and appends only for a new path.

def first_matching_source_row(matches: darray[bool]&) -> usize:
    ensures result <= matches.count
    ensures result < matches.count implies matches[result]
    ensures forall prior in 0..<result: not matches[prior]
    index: mutable usize = 0.usize()
    while index < matches.count |index, matches|:
        decreases matches.count - index
        invariant index <= matches.count
        invariant forall prior in 0..<index: not matches[prior]
        return index if matches[index]
        index <- index + 1.usize()
    return matches.count

def target_registration_after_lookup(file_count: usize, slot: usize)
    -> (files_after: usize, edge_target: usize):
    requires slot <= file_count
    requires file_count < 18446744073709551615.usize()
    ensures result.edge_target == slot
    ensures result.edge_target < result.files_after
    ensures result.files_after == file_count if slot < file_count
    ensures result.files_after == file_count + 1.usize() if slot == file_count
    if slot == file_count:
        return (file_count + 1.usize(), slot)
    return (file_count, slot)

def an_existing_path_reuses_its_first_slot(matches: darray[bool]&) -> bool:
    requires matches.count > 0.usize() and matches[0.usize()]
    requires matches.count < 18446744073709551615.usize()
    ensures result == true
    slot: usize = first_matching_source_row(matches)
    registration: (files_after: usize, edge_target: usize) = target_registration_after_lookup(matches.count, slot)
    return slot == 0.usize() and registration.files_after == matches.count and registration.edge_target < registration.files_after

def a_missing_path_appends_a_valid_edge_slot(matches: darray[bool]&) -> bool:
    requires forall candidate in 0..<matches.count: not matches[candidate]
    requires matches.count < 18446744073709551615.usize()
    ensures result == true
    slot: usize = first_matching_source_row(matches)
    registration: (files_after: usize, edge_target: usize) = target_registration_after_lookup(matches.count, slot)
    return slot == matches.count and registration.files_after == matches.count + 1.usize() and registration.edge_target < registration.files_after
