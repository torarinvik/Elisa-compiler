# Proofs for the arithmetic preflight shared by CoreIR's native and managed backends.
include "../../src/ir/core_ir_scalar_safety.elisa"

def negative_scalar_operand_is_rejected(operator: i64, left: i64, right: i64) -> bool:
    requires left < 0 or right < 0
    ensure result == true
    return not ElisaCoreIRScalarSafety::binary_is_defined(operator, left, right)

def unknown_scalar_operator_is_rejected(operator: i64, left: i64, right: i64) -> bool:
    requires operator != ElisaCoreIRArithmetic::ADD_GUARD_CODE
    requires operator != ElisaCoreIRArithmetic::SUBTRACT_GUARD_CODE
    requires operator != ElisaCoreIRArithmetic::MULTIPLY_GUARD_CODE
    requires operator != ElisaCoreIRArithmetic::DIVIDE_GUARD_CODE
    ensure result == true
    return not ElisaCoreIRScalarSafety::binary_is_defined(operator, left, right)

def scalar_safety_constants_match_the_i64_domain() -> bool:
    ensure result == true
    return ElisaCoreIRArithmetic::ZERO == 0 and ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM == 9223372036854775807 and ElisaCoreIRArithmetic::ADD_GUARD_CODE == 0 and ElisaCoreIRArithmetic::SUBTRACT_GUARD_CODE == 1 and ElisaCoreIRArithmetic::MULTIPLY_GUARD_CODE == 2 and ElisaCoreIRArithmetic::DIVIDE_GUARD_CODE == 3

def nonnegative_addition_guard_is_exact(left: i64, right: i64) -> bool:
    requires left >= 0 and right >= 0
    ensure result == (left <= ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM - right)
    return ElisaCoreIRScalarSafety::binary_is_defined(ElisaCoreIRArithmetic::ADD_GUARD_CODE, left, right)

def nonnegative_subtraction_is_always_defined(left: i64, right: i64) -> bool:
    requires left >= 0 and right >= 0
    ensure result == true
    return ElisaCoreIRScalarSafety::binary_is_defined(ElisaCoreIRArithmetic::SUBTRACT_GUARD_CODE, left, right)

def nonnegative_multiplication_guard_is_exact(left: i64, right: i64) -> bool:
    requires left >= 0 and right >= 0
    ensure result == (right == 0 or left <= (ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM / right if right > 0 else ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM))
    return ElisaCoreIRScalarSafety::binary_is_defined(ElisaCoreIRArithmetic::MULTIPLY_GUARD_CODE, left, right)

def nonnegative_division_guard_is_exact(left: i64, right: i64) -> bool:
    requires left >= 0 and right >= 0
    ensure result == (right != 0)
    return ElisaCoreIRScalarSafety::binary_is_defined(ElisaCoreIRArithmetic::DIVIDE_GUARD_CODE, left, right)

def maximum_plus_zero_is_admitted() -> bool:
    ensure result == true
    return ElisaCoreIRScalarSafety::binary_is_defined(ElisaCoreIRArithmetic::ADD_GUARD_CODE, ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM, 0)

def maximum_plus_one_is_rejected() -> bool:
    ensure result == true
    return not ElisaCoreIRScalarSafety::binary_is_defined(ElisaCoreIRArithmetic::ADD_GUARD_CODE, ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM, 1)

def zero_minus_maximum_is_admitted() -> bool:
    ensure result == true
    return ElisaCoreIRScalarSafety::binary_is_defined(ElisaCoreIRArithmetic::SUBTRACT_GUARD_CODE, 0, ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM)

def maximum_times_one_is_admitted() -> bool:
    ensure result == true
    return ElisaCoreIRScalarSafety::binary_is_defined(ElisaCoreIRArithmetic::MULTIPLY_GUARD_CODE, ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM, 1)

def zero_times_maximum_is_admitted() -> bool:
    ensure result == true
    return ElisaCoreIRScalarSafety::binary_is_defined(ElisaCoreIRArithmetic::MULTIPLY_GUARD_CODE, ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM, 0)

def maximum_times_two_is_rejected() -> bool:
    ensure result == true
    return not ElisaCoreIRScalarSafety::binary_is_defined(ElisaCoreIRArithmetic::MULTIPLY_GUARD_CODE, ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM, 2)

def positive_divisor_is_admitted() -> bool:
    ensure result == true
    return ElisaCoreIRScalarSafety::binary_is_defined(ElisaCoreIRArithmetic::DIVIDE_GUARD_CODE, 7, 2)

def zero_divisor_is_rejected() -> bool:
    ensure result == true
    return not ElisaCoreIRScalarSafety::binary_is_defined(ElisaCoreIRArithmetic::DIVIDE_GUARD_CODE, 7, 0)

def guarded_addition_has_an_exact_i64_result(left: i64, right: i64) -> i64:
    requires left >= 0 and right >= 0
    requires left <= ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM
    requires right <= ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM
    requires left <= ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM - right
    ensure result == left + right
    return left + right

def guarded_subtraction_has_an_exact_i64_result(left: i64, right: i64) -> i64:
    requires left >= 0 and right >= 0
    requires left <= ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM
    requires right <= ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM
    ensure result == left - right
    return left - right

def guarded_zero_multiplication_has_an_exact_i64_result(left: i64) -> i64:
    requires left >= 0 and left <= ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM
    ensure result == 0
    return left * 0

def guarded_positive_multiplication_has_an_exact_i64_result(left: i64, right: i64) -> i64:
    requires left >= 0 and right > 0
    requires left <= ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM
    requires right <= ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM
    requires left <= ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM / right
    ensure result == left * right
    return left * right

def guarded_division_has_an_exact_i64_result(left: i64, right: i64) -> i64:
    requires left >= 0 and right > 0
    requires left <= ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM
    requires right <= ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM
    ensure result == left / right
    return left / right

# These obligations connect acceptance by the production preflight to the signed
# result range consumed by LLVM and EDIR. The helper is the same predicate called
# before either backend emits the corresponding operation.
def accepted_addition_result_is_bounded(left: i64, right: i64) -> bool:
    requires left >= 0 and right >= 0
    requires ElisaCoreIRScalarSafety::binary_is_defined(ElisaCoreIRArithmetic::ADD_GUARD_CODE, left, right)
    ensure result == true
    return left + right >= 0 and left + right <= ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM

def accepted_subtraction_result_is_bounded(left: i64, right: i64) -> bool:
    requires left >= 0 and right >= 0
    requires ElisaCoreIRScalarSafety::binary_is_defined(ElisaCoreIRArithmetic::SUBTRACT_GUARD_CODE, left, right)
    ensure result == true
    return left - right >= 0 - ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM and left - right <= ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM

def accepted_multiplication_result_is_bounded(left: i64, right: i64) -> bool:
    requires left >= 0 and right >= 0
    requires ElisaCoreIRScalarSafety::binary_is_defined(ElisaCoreIRArithmetic::MULTIPLY_GUARD_CODE, left, right)
    ensure result == true
    return left * right >= 0 and left * right <= ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM

def accepted_division_result_is_bounded(left: i64, right: i64) -> bool:
    requires left >= 0 and right > 0
    requires ElisaCoreIRScalarSafety::binary_is_defined(ElisaCoreIRArithmetic::DIVIDE_GUARD_CODE, left, right)
    ensure result == true
    return left / right >= 0 and left / right <= ElisaCoreIRArithmetic::SIGNED_I64_MAXIMUM
