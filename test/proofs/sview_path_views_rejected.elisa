# These incorrect component claims must remain unproved.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

def basename_can_end_with_the_last_separator(view: sview, sep: u8) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    requires sview_find_last_byte(view, sep) >= 0
    requires sview_find_last_byte(view, sep) + 1 < view.len
    ensure result == true
    base: sview = sview_basename(view, sep)
    return string_view_index(base, base.len - 1) == sep.i64()

def dirname_can_extend_through_the_last_separator(view: sview, sep: u8) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    requires sview_find_last_byte(view, sep) >= 0
    ensure result == true
    return sview_dirname(view, sep).len > sview_find_last_byte(view, sep)

def malformed_view_can_have_a_nonempty_basename(view: sview, sep: u8) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires view.len < 0 or view.len.usize().i64() != view.len
    ensure result == true
    return sview_basename(view, sep).len != 0

def malformed_view_can_have_a_nonempty_dirname(view: sview, sep: u8) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires view.len < 0 or view.len.usize().i64() != view.len
    ensure result == true
    return sview_dirname(view, sep).len != 0
