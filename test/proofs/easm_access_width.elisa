# Source-backed proof of the exact EASM opcode-token memory-width table.
include "../../src/backend/easm_access_width.elisa"

def access_width_matches_the_exact_opcode_partition(op: sview) -> bool:
    ensure result == true
    if op == "movb":
        return EasmAccessWidth::access_width(op) == 1
    if op == "xchgb":
        return EasmAccessWidth::access_width(op) == 1
    if op == "movw":
        return EasmAccessWidth::access_width(op) == 2
    if op == "xchgw":
        return EasmAccessWidth::access_width(op) == 2
    if op == "movl":
        return EasmAccessWidth::access_width(op) == 4
    if op == "xchgl":
        return EasmAccessWidth::access_width(op) == 4
    if op == "movq":
        return EasmAccessWidth::access_width(op) == 8
    if op == "xchgq":
        return EasmAccessWidth::access_width(op) == 8
    return EasmAccessWidth::access_width(op) == 0

def byte_access_opcodes_have_width_one() -> bool:
    ensure result == true
    return EasmAccessWidth::access_width("movb") == 1 and EasmAccessWidth::access_width("xchgb") == 1

def word_access_opcodes_have_width_two() -> bool:
    ensure result == true
    return EasmAccessWidth::access_width("movw") == 2 and EasmAccessWidth::access_width("xchgw") == 2

def dword_access_opcodes_have_width_four() -> bool:
    ensure result == true
    return EasmAccessWidth::access_width("movl") == 4 and EasmAccessWidth::access_width("xchgl") == 4

def qword_access_opcodes_have_width_eight() -> bool:
    ensure result == true
    return EasmAccessWidth::access_width("movq") == 8 and EasmAccessWidth::access_width("xchgq") == 8

def nonsized_opcodes_and_prefix_lookalikes_have_no_memory_access_width() -> bool:
    ensure result == true
    return (
        EasmAccessWidth::access_width("xchg") == 0 and
        EasmAccessWidth::access_width("movsbl") == 0 and
        EasmAccessWidth::access_width("movbgarbage") == 0 and
        EasmAccessWidth::access_width("addq") == 0
    )
