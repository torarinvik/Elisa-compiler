# Source-backed proof of the exact EASM opcode-token memory-width table.
include "../../src/backend/easm_access_width.elisa"

def access_width_matches_the_exact_opcode_partition(op: sview) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return match op:
            "movb" | "xchgb": EasmAccessWidth::access_width(op) == 1
            "movw" | "xchgw": EasmAccessWidth::access_width(op) == 2
            "movl" | "xchgl": EasmAccessWidth::access_width(op) == 4
            "movq" | "xchgq": EasmAccessWidth::access_width(op) == 8
            _: EasmAccessWidth::access_width(op) == 0

def byte_access_opcodes_have_width_one() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return EasmAccessWidth::access_width("movb") == 1 and EasmAccessWidth::access_width("xchgb") == 1

def word_access_opcodes_have_width_two() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return EasmAccessWidth::access_width("movw") == 2 and EasmAccessWidth::access_width("xchgw") == 2

def dword_access_opcodes_have_width_four() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return EasmAccessWidth::access_width("movl") == 4 and EasmAccessWidth::access_width("xchgl") == 4

def qword_access_opcodes_have_width_eight() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return EasmAccessWidth::access_width("movq") == 8 and EasmAccessWidth::access_width("xchgq") == 8

def nonsized_opcodes_and_prefix_lookalikes_have_no_memory_access_width() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            EasmAccessWidth::access_width("xchg") == 0 and
            EasmAccessWidth::access_width("movsbl") == 0 and
            EasmAccessWidth::access_width("movbgarbage") == 0 and
            EasmAccessWidth::access_width("addq") == 0
        )
