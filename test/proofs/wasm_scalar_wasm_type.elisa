# Source-linked proof of the exact scalar type table used by the WASM export builder.
include "../../src/driver/wasm_scalar_wasm_type.elisa"

def source_scalar_name_membership_is_exact(type_text: sview) -> bool:
    ensure result == true
    return WasmScalarWasmType::is_scalar_type_name(type_text) == (
        when type_text:
            "i8" | "u8" | "i16" | "u16" | "i32" | "u32" | "int" | "isize" | "usize" | "uintptr" | "bool" | "i64" | "u64" | "char" | "f32" | "f64" | "void" -> true
            _ -> false
    )

def source_scalar_mapping_is_exact(type_text: sview) -> sview can[Abort.Panic]:
    ensure (result == "i32") == (
        when type_text:
            "i8" | "u8" | "i16" | "u16" | "i32" | "u32" | "int" | "isize" | "usize" | "uintptr" | "bool" -> true
            _ -> false
    )
    ensure (result == "i64") == (
        when type_text:
            "i64" | "u64" | "char" -> true
            _ -> false
    )
    ensure (result == "f32") == (type_text == "f32")
    ensure (result == "f64") == (type_text == "f64")
    ensure (result == "void") == (type_text == "void")
    ensure (result == "") == (not WasmScalarWasmType::is_scalar_type_name(type_text))
    can Abort.Panic:
        return WasmScalarWasmType::wasm_scalar_wasm_type(type_text)

def integer_scalar_names_use_i32() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            WasmScalarWasmType::wasm_scalar_wasm_type("i8") == "i32"
            and WasmScalarWasmType::wasm_scalar_wasm_type("u16") == "i32"
            and WasmScalarWasmType::wasm_scalar_wasm_type("i32") == "i32"
            and WasmScalarWasmType::wasm_scalar_wasm_type("uintptr") == "i32"
            and WasmScalarWasmType::wasm_scalar_wasm_type("bool") == "i32"
        )

def wider_and_non_integer_scalars_keep_their_wasm_types() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            WasmScalarWasmType::wasm_scalar_wasm_type("i64") == "i64"
            and WasmScalarWasmType::wasm_scalar_wasm_type("char") == "i64"
            and WasmScalarWasmType::wasm_scalar_wasm_type("f32") == "f32"
            and WasmScalarWasmType::wasm_scalar_wasm_type("f64") == "f64"
            and WasmScalarWasmType::wasm_scalar_wasm_type("void") == "void"
        )

def unknown_scalar_names_have_no_wasm_type() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return WasmScalarWasmType::wasm_scalar_wasm_type("f128") == ""
