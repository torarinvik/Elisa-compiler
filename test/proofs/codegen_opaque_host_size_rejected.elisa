# False claims against the source type-name adapter and backend C opaque size model.
include "../../src/backend/codegen_opaque_host_size.elisa"
include "../../src/backend/codegen_opaque_type_size.elisa"

const PROOF_POINTER_SIZE_BYTES: i64 = 8

def mutex_flag_cannot_claim_pointer_size() -> bool:
    ensure result == true
    return BackendOpaqueHostSize::c_opaque_host_size_from_flags(true, false, false) == PROOF_POINTER_SIZE_BYTES

def no_type_flags_cannot_guess_an_inline_size() -> bool:
    ensure result == true
    return BackendOpaqueHostSize::c_opaque_host_size_from_flags(false, false, false) == PROOF_POINTER_SIZE_BYTES

def condition_type_cannot_claim_mutex_host_size() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return BackendOpaqueTypeSize::c_opaque_host_size_for_type("pthread_cond_t") == BackendOpaqueHostSize::PTHREAD_MUTEX_HOST_BYTES

def unknown_type_cannot_claim_mutex_host_size() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return BackendOpaqueTypeSize::c_opaque_host_size_for_type("pthread_rwlock_t") == BackendOpaqueHostSize::PTHREAD_MUTEX_HOST_BYTES
