# False claims against the boolean size model used by the backend's C opaque table.
include "../../src/backend/codegen_opaque_host_size.elisa"

const PROOF_POINTER_SIZE_BYTES: i64 = 8

def mutex_flag_cannot_claim_pointer_size() -> bool:
    ensure result == true
    return BackendOpaqueHostSize::c_opaque_host_size_from_flags(true, false, false) == PROOF_POINTER_SIZE_BYTES

def no_type_flags_cannot_guess_an_inline_size() -> bool:
    ensure result == true
    return BackendOpaqueHostSize::c_opaque_host_size_from_flags(false, false, false) == PROOF_POINTER_SIZE_BYTES
