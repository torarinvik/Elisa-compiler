# Scalar proofs for newline and ordinary-character line/column transitions.
# The checker binds these formulas to LexerPositionStep and Lexer.advance_char.
def stepped_line(line: int, is_newline: bool) -> int:
    ensure result == (line + 1 if is_newline else line)
    return line + 1 if is_newline else line

def column_after_line_step(is_newline: bool) -> int:
    ensure result == (1 if is_newline else 0)
    return 1 if is_newline else 0

def advanced_column(column: int) -> int:
    ensure result == column + 1
    return column + 1

def newline_step_updates_line_and_resets_column(line: int) -> bool:
    ensure result == true
    return stepped_line(line, true) == line + 1 and column_after_line_step(true) == 1

def ordinary_step_preserves_line_and_advances_column(line: int, column: int) -> bool:
    ensure result == true
    return stepped_line(line, false) == line and advanced_column(column) == column + 1
