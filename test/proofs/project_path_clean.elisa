# Source-linked root-preservation proof for ProjectSystem's lexical path cleaner.
include "../../src/driver/project.elisa"

def cleaning_an_absolute_path_preserves_its_root_separator(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    requires ProjectSystem::path_is_absolute(path)
    ensure result == true
    cleaned: darray[u8] = ProjectSystem::path_clean(path)
    return (
        cleaned.count > 0.usize() and
        cleaned[0.usize()] == ProjectSystemPathByte::ASCII_FORWARD_SLASH
    )

def the_cleaned_absolute_path_remains_absolute(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    requires ProjectSystem::path_is_absolute(path)
    ensure result == true
    cleaned: darray[u8] = ProjectSystem::path_clean(path)
    return ProjectSystem::path_is_absolute(cleaned)

def an_empty_relative_path_cleans_to_a_single_dot(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    requires path.count == 0.usize()
    ensure result == true
    cleaned: darray[u8] = ProjectSystem::path_clean(path)
    return cleaned.count == 1.usize() and cleaned[0.usize()] == 46

def a_single_root_separator_cleans_to_itself(path: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    requires path.count == 1.usize() and path[0.usize()] == ProjectSystemPathByte::ASCII_FORWARD_SLASH
    ensure result == true
    cleaned: darray[u8] = ProjectSystem::path_clean(path)
    return cleaned.count == 1.usize() and cleaned[0.usize()] == ProjectSystemPathByte::ASCII_FORWARD_SLASH
