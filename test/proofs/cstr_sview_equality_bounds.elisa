# C-string/StringView comparison rejects invalid extents before bounded scanning.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"

def malformed_view_never_matches_a_cstr(text: cstr, expected_length: i64, view: sview) -> bool:
    requires expected_length == text.len and (view.len < 0 or view.len.usize().i64() != view.len)
    ensure result == true
    return not ctx_cstr_eq_sview(text, expected_length, view)

def unequal_lengths_never_match(text: cstr, expected_length: i64, view: sview) -> bool:
    requires expected_length == text.len and expected_length != view.len
    ensure result == true
    return not ctx_cstr_eq_sview(text, expected_length, view)

def a_reported_match_has_a_valid_equal_extent(text: cstr, expected_length: i64, view: sview) -> bool:
    requires expected_length == text.len
    ensure result == true
    return not ctx_cstr_eq_sview(text, expected_length, view) or (
        view.len >= 0 and view.len.usize().i64() == view.len and expected_length == view.len
    )

def equal_empty_cstr_and_view_match(view: sview) -> bool:
    requires view.len == 0
    ensure result == true
    empty_text: cstr = ""
    return ctx_cstr_eq_sview(empty_text, 0, view)
