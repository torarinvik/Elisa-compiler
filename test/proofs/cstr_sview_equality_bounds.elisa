# C-string/StringView comparison rejects invalid extents before bounded scanning.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"

def malformed_view_never_matches_a_cstr(text: cstr, view: sview) -> bool:
    requires view.len < 0 or view.len.usize().i64() != view.len
    ensure result == true
    return not ctx_cstr_eq_sview(text, view)

def unequal_lengths_never_match(text: cstr, view: sview) -> bool:
    requires text.len != view.len
    ensure result == true
    return not ctx_cstr_eq_sview(text, view)

def a_reported_match_has_a_valid_equal_extent(text: cstr, view: sview) -> bool:
    ensure result == true
    return not ctx_cstr_eq_sview(text, view) or (
        view.len >= 0 and view.len.usize().i64() == view.len and text.len == view.len
    )

def equal_empty_cstr_and_view_match(text: cstr, view: sview) -> bool:
    requires text.len == 0 and view.len == 0
    ensure result == true
    return ctx_cstr_eq_sview(text, view)
