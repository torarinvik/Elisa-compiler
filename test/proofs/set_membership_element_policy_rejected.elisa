# False claims about set-element rejection and type spelling.
include "./set_membership_element_policy.elisa"

def false_claim_cstr_is_an_unsupported_set_element() -> bool:
    ensure result == true
    return SemanticSetMembershipElementPolicy::is_unsupported_spelling("cstr")

def false_claim_i64_is_an_unsupported_set_element() -> bool:
    ensure result == true
    return SemanticSetMembershipElementPolicy::is_unsupported_spelling("i64")

def false_claim_dstr_keeps_its_declared_diagnostic_spelling() -> bool:
    ensure result == true
    return SemanticSetMembershipElementPolicy::diagnostic_spelling("dstr") == "dstr"
