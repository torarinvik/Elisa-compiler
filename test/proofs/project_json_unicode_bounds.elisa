# Arithmetic facts used by ProjectSystem's JSON \u escape decoder.
def decimal_hex_nibble(byte: i64) -> i64:
    requires byte >= 48 and byte <= 57
    ensure result >= 0
    ensure result <= 9
    return byte - 48

def lower_hex_nibble(byte: i64) -> i64:
    requires byte >= 97 and byte <= 102
    ensure result >= 10
    ensure result <= 15
    return byte - 97 + 10

def upper_hex_nibble(byte: i64) -> i64:
    requires byte >= 65 and byte <= 70
    ensure result >= 10
    ensure result <= 15
    return byte - 65 + 10

def four_hex_digits_fit_u16(a: i64, b: i64, c: i64, d: i64) -> i64:
    requires a >= 0 and a <= 15
    requires b >= 0 and b <= 15
    requires c >= 0 and c <= 15
    requires d >= 0 and d <= 15
    ensure result >= 0
    ensure result <= 65535
    return ((a * 16 + b) * 16 + c) * 16 + d

def surrogate_pair_is_unicode_scalar(high: i64, low: i64) -> i64:
    requires high >= 55296 and high <= 56319
    requires low >= 56320 and low <= 57343
    ensure result >= 65536
    ensure result <= 1114111
    return 65536 + (high - 55296) * 1024 + (low - 56320)

def replacement_character_uses_three_byte_encoding(code: i64) -> bool:
    requires code == 65533
    ensure result == true
    return code >= 2048 and code < 65536

def isolated_surrogate_selects_replacement(first: i64, paired: bool) -> i64:
    requires first >= 55296 and first <= 57343
    requires not paired
    ensure result == 65533
    return 0 if paired else (65533 if first >= 55296 and first <= 57343 else first)
