include "./project_json_hex4_bounds.elisa"

def false_claim_zero_byte_is_a_decimal_hex_digit(byte: i64) -> bool:
    requires byte == 0
    ensure result == true
    return byte >= 48 and byte <= 57

def false_claim_invalid_nibble_decodes_to_a_value(nibble: i64) -> bool:
    requires nibble == -1
    ensure result == true
    return nibble >= 0 and ((1 * 16 + nibble) * 16 + 2) * 16 + 3 >= 0

def false_claim_maximum_hex_quad_is_below_65535() -> bool:
    ensure result == true
    return ((15 * 16 + 15) * 16 + 15) * 16 + 15 <= 65534
