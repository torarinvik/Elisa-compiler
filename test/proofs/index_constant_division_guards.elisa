# Pure arithmetic facts for the invalid operands rejected before constant folding / or %.
# The source checker pins `minimum` to Semantic.linear_i64_min().
def proof_divisor_is_nonzero(right: i64) -> bool:
    ensure result == (right != 0)
    return right != 0

def zero_divisor_is_rejected(right: i64) -> bool:
    requires right == 0
    ensure result == true
    return not proof_divisor_is_nonzero(right)

def nonzero_divisor_passes_first_guard(right: i64) -> bool:
    requires right != 0
    ensure result == true
    return proof_divisor_is_nonzero(right)

def proof_min_div_negative_one_pair(left: i64, right: i64, minimum: i64) -> bool:
    ensure result == (left == minimum and right == (0 - 1))
    return left == minimum and right == (0 - 1)

def min_divided_by_negative_one_is_rejected(left: i64, right: i64, minimum: i64) -> bool:
    requires left == minimum and right == (0 - 1)
    ensure result == true
    return proof_min_div_negative_one_pair(left, right, minimum)

def different_left_excludes_overflow_pair(left: i64, right: i64, minimum: i64) -> bool:
    requires left != minimum
    ensure result == true
    return not proof_min_div_negative_one_pair(left, right, minimum)

def different_right_excludes_overflow_pair(left: i64, right: i64, minimum: i64) -> bool:
    requires right != (0 - 1)
    ensure result == true
    return not proof_min_div_negative_one_pair(left, right, minimum)

def safe_division_pair_does_not_match_overflow(left: i64, right: i64, minimum: i64) -> bool:
    requires left != minimum or right != (0 - 1)
    ensure result == true
    return not proof_min_div_negative_one_pair(left, right, minimum)
