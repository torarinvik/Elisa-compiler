# Model the control-flow conditions in Lexer::source_line_map_path_is_runtime_std.
# The proof covers the classifier's guards and prefix-scan bounds. The OS realpath
# implementation is an explicit input to the model, not a proved property here.
const SOURCE_LINE_MAP_PATH_LIMIT_MODEL: i64 = 8191
const SOURCE_LINE_MAP_REALPATH_CAPACITY_MODEL: i64 = 8192

def classifier_accepts_exactly_the_guard_conjunction(
    supported_platform: bool,
    path_length: i64,
    has_runtime_std_component: bool,
    realpath_succeeded: bool,
    resolved_length: i64,
    trusted_prefix_length: i64,
    prefix_bytes_equal: bool
) -> bool:
    requires path_length >= 0 and resolved_length >= 0 and resolved_length <= SOURCE_LINE_MAP_REALPATH_CAPACITY_MODEL and trusted_prefix_length > 0
    ensure result == (supported_platform and path_length > 0 and path_length <= SOURCE_LINE_MAP_PATH_LIMIT_MODEL and has_runtime_std_component and realpath_succeeded and resolved_length < SOURCE_LINE_MAP_REALPATH_CAPACITY_MODEL and resolved_length > trusted_prefix_length and prefix_bytes_equal)
    return supported_platform and path_length > 0 and path_length <= SOURCE_LINE_MAP_PATH_LIMIT_MODEL and has_runtime_std_component and realpath_succeeded and resolved_length < SOURCE_LINE_MAP_REALPATH_CAPACITY_MODEL and resolved_length > trusted_prefix_length and prefix_bytes_equal

def classifier_accepts_the_maximum_source_span() -> bool:
    ensure result == true
    return true and 8191 > 0 and 8191 <= SOURCE_LINE_MAP_PATH_LIMIT_MODEL and true and true and 15 < SOURCE_LINE_MAP_REALPATH_CAPACITY_MODEL and 15 > 14 and true

def classifier_accepts_a_strict_child_of_the_trusted_prefix() -> bool:
    ensure result == true
    return true and 15 > 0 and 15 <= SOURCE_LINE_MAP_PATH_LIMIT_MODEL and true and true and 15 < SOURCE_LINE_MAP_REALPATH_CAPACITY_MODEL and 15 > 14 and true

def maximum_accepted_prefix_still_has_room_for_a_child_byte() -> bool:
    ensure result == true
    return 8190 < 8191 and 8191 < SOURCE_LINE_MAP_REALPATH_CAPACITY_MODEL and 8191 > 8190

def accepted_prefix_scan_index_is_inside_both_spans(
    resolved_length: i64,
    trusted_prefix_length: i64,
    prefix_index: i64
) -> bool:
    requires resolved_length >= 0 and resolved_length < SOURCE_LINE_MAP_REALPATH_CAPACITY_MODEL and resolved_length > trusted_prefix_length and trusted_prefix_length > 0 and prefix_index >= 0 and prefix_index < trusted_prefix_length
    ensure result == true
    return prefix_index < resolved_length and prefix_index < SOURCE_LINE_MAP_REALPATH_CAPACITY_MODEL and prefix_index < trusted_prefix_length

def accepted_resolved_path_has_a_strict_extension_byte(
    resolved_length: i64,
    trusted_prefix_length: i64
) -> bool:
    requires resolved_length > trusted_prefix_length and trusted_prefix_length > 0
    ensure result == true
    return resolved_length - trusted_prefix_length >= 1

# The checker binds these fourteen scalar bytes to every iteration of the
# production 0..<marker_length loop, and ties the spelling to the marker literal.
def component_candidate_matches_exact_runtime_marker(
    byte0: u8, byte1: u8, byte2: u8, byte3: u8, byte4: u8, byte5: u8, byte6: u8,
    byte7: u8, byte8: u8, byte9: u8, byte10: u8, byte11: u8, byte12: u8, byte13: u8,
    starts_after_path_start: bool,
    preceding_byte_is_separator: bool
) -> bool:
    ensure result == (byte0 == 101 and byte1 == 108 and byte2 == 105 and byte3 == 115 and byte4 == 97 and byte5 == 99 and byte6 == 111 and byte7 == 114 and byte8 == 101 and byte9 == 95 and byte10 == 115 and byte11 == 116 and byte12 == 100 and byte13 == 47 and starts_after_path_start and preceding_byte_is_separator)
    return byte0 == 101 and byte1 == 108 and byte2 == 105 and byte3 == 115 and byte4 == 97 and byte5 == 99 and byte6 == 111 and byte7 == 114 and byte8 == 101 and byte9 == 95 and byte10 == 115 and byte11 == 116 and byte12 == 100 and byte13 == 47 and starts_after_path_start and preceding_byte_is_separator
