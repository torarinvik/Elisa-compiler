# Bounds contracts for the driver's quoted include-path scanner.
def caller_line_slice_is_inside_file(line_start: u64, line_limit: u64, contents_length: u64) -> bool:
    requires line_start <= line_limit and line_limit <= contents_length
    ensure result == true
    return line_limit - line_start <= contents_length - line_start

def parsed_include_payload_is_inside_line(line_start: u64, line_limit: u64, contents_length: u64, payload_start: u64, closing_quote: u64, payload_length: u64) -> bool:
    requires line_limit <= contents_length
    requires line_start <= payload_start and payload_start <= closing_quote
    requires closing_quote < line_limit
    requires payload_length == closing_quote - payload_start
    ensure result == true
    return payload_start <= contents_length and payload_length <= contents_length - payload_start

def include_payload_does_not_include_its_opening_quote(opening_quote: u64, payload_start: u64) -> bool:
    requires opening_quote < 18446744073709551615.u64()
    requires payload_start == opening_quote + 1.u64()
    ensure result == true
    return payload_start > opening_quote

def project_source_scan_uses_a_synthetic_newline_at_eof(position: u64, contents_length: u64) -> bool:
    requires position <= contents_length
    ensure result == true
    return position == contents_length or position < contents_length
