# False claims must stay unproved for the production lexicographic comparator.
include "../../src/driver/project.elisa"

def a_greater_single_byte_sorts_before_a_smaller_byte(left_byte: u8, right_byte: u8) -> bool:
    requires left_byte > right_byte
    ensure result == true
    left: darray[u8] = [left_byte]
    right: darray[u8] = [right_byte]
    return ProjectSystem::bytes_less(left, right)

def a_proper_byte_extension_sorts_before_its_prefix(prefix: u8, extension: u8) -> bool:
    ensure result == true
    shorter: darray[u8] = [prefix]
    longer: darray[u8] = [prefix, extension]
    return ProjectSystem::bytes_less(longer, shorter)
