# One pointer-walk step cannot move beyond the snapshot's one-past-end cursor.
# The cursor bound makes the u64 increment nonwrapping; the source checker ties
# the step to the guarded DArray pointer-walk lowering.
const U64_MAX: u64 = 18446744073709551615.u64()

def cursor_step_stays_within_snapshot(count: u64, cursor: u64) -> bool:
    requires cursor < count
    requires cursor < U64_MAX
    ensure result == true
    return cursor + 1 <= count
