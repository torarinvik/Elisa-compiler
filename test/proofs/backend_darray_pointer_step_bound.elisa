# One pointer-walk step cannot move beyond the snapshot's one-past-end cursor.
# The source checker ties the unsigned step to the guarded DArray pointer-walk lowering.

def cursor_step_stays_within_snapshot(count: u64, cursor: u64) -> bool:
    requires cursor < count
    ensure result == true
    return cursor + 1 <= count

def cursor_step_strictly_advances(count: u64, cursor: u64) -> bool:
    requires cursor < count
    ensure result == true
    return cursor < cursor + 1

def remaining_is_positive_before_the_end(count: u64, cursor: u64) -> bool:
    requires cursor < count
    ensure result == true
    return count - cursor > 0

def remaining_decreases_with_the_cursor_step(count: u64, cursor: u64) -> bool:
    requires cursor < count
    ensure result == true
    return count - (cursor + 1) < count - cursor

def countdown_value_is_positive_before_the_end(remaining: u64) -> bool:
    requires remaining > 0
    ensure result == true
    return remaining - 1 < remaining

def countdown_step_stays_nonnegative(remaining: u64) -> bool:
    requires remaining > 0
    ensure result == true
    return remaining - 1 >= 0
