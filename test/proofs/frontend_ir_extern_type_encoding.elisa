# Source-linked laws for the extern type shapes reconstructed by the frontend IR writer.
include "../../src/driver/frontend_ir_extern_type_encoding.elisa"

const EXPECTED_NAMED_TYPE_NODE_TYPE_ID: u32 = 194
const EXPECTED_REF_TYPE_NODE_TYPE_ID: u32 = 220

const EXPECTED_NAMED_TYPE_NAME_FIELD_ID: u32 = 1
const EXPECTED_NAMED_TYPE_POSITION_FIELD_ID: u32 = 2
const EXPECTED_REF_TYPE_ELEM_FIELD_ID: u32 = 1
const EXPECTED_REF_TYPE_POSITION_FIELD_ID: u32 = 3

def source_extern_node_type_id_is_exact(shape: FrontendIrExternTypeEncoding::ExternTypeShape) -> u32:
    ensure shape != FrontendIrExternTypeEncoding::ExternTypeShape.Named or result == EXPECTED_NAMED_TYPE_NODE_TYPE_ID
    ensure shape != FrontendIrExternTypeEncoding::ExternTypeShape.ProvenanceRef or result == EXPECTED_REF_TYPE_NODE_TYPE_ID
    return FrontendIrExternTypeEncoding::node_type_id(shape)

def source_extern_primary_field_id_is_exact(shape: FrontendIrExternTypeEncoding::ExternTypeShape) -> u32:
    ensure shape != FrontendIrExternTypeEncoding::ExternTypeShape.Named or result == EXPECTED_NAMED_TYPE_NAME_FIELD_ID
    ensure shape != FrontendIrExternTypeEncoding::ExternTypeShape.ProvenanceRef or result == EXPECTED_REF_TYPE_ELEM_FIELD_ID
    return FrontendIrExternTypeEncoding::primary_field_id(shape)

def source_extern_position_field_id_is_exact(shape: FrontendIrExternTypeEncoding::ExternTypeShape) -> u32:
    ensure shape != FrontendIrExternTypeEncoding::ExternTypeShape.Named or result == EXPECTED_NAMED_TYPE_POSITION_FIELD_ID
    ensure shape != FrontendIrExternTypeEncoding::ExternTypeShape.ProvenanceRef or result == EXPECTED_REF_TYPE_POSITION_FIELD_ID
    return FrontendIrExternTypeEncoding::position_field_id(shape)

def extern_type_node_tags_are_distinct() -> bool:
    ensure result == true
    return (
        FrontendIrExternTypeEncoding::node_type_id(FrontendIrExternTypeEncoding::ExternTypeShape.Named)
            != FrontendIrExternTypeEncoding::node_type_id(FrontendIrExternTypeEncoding::ExternTypeShape.ProvenanceRef)
    )

def extern_type_position_fields_are_distinct() -> bool:
    ensure result == true
    return (
        FrontendIrExternTypeEncoding::position_field_id(FrontendIrExternTypeEncoding::ExternTypeShape.Named)
        != FrontendIrExternTypeEncoding::position_field_id(FrontendIrExternTypeEncoding::ExternTypeShape.ProvenanceRef)
    )

def shared_primary_field_slot_is_type_local() -> bool:
    ensure result == true
    return (
        FrontendIrExternTypeEncoding::primary_field_id(FrontendIrExternTypeEncoding::ExternTypeShape.Named)
            == EXPECTED_NAMED_TYPE_NAME_FIELD_ID
        and FrontendIrExternTypeEncoding::primary_field_id(FrontendIrExternTypeEncoding::ExternTypeShape.ProvenanceRef)
            == EXPECTED_REF_TYPE_ELEM_FIELD_ID
        and EXPECTED_NAMED_TYPE_NAME_FIELD_ID == EXPECTED_REF_TYPE_ELEM_FIELD_ID
        and FrontendIrExternTypeEncoding::node_type_id(FrontendIrExternTypeEncoding::ExternTypeShape.Named)
            != FrontendIrExternTypeEncoding::node_type_id(FrontendIrExternTypeEncoding::ExternTypeShape.ProvenanceRef)
    )
