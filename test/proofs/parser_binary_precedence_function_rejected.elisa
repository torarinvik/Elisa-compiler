include "./parser_binary_precedence_function.elisa"

def a_left_shift_has_bitwise_and_precedence() -> bool:
    ensure result == true
    return ParserBinaryPrecedence::precedence(Lexer::TokenKind.LShift) == ParserBinaryPrecedence::BITWISE_AND

def compound_shift_has_binary_shift_precedence() -> bool:
    ensure result == true
    return ParserBinaryPrecedence::precedence(Lexer::TokenKind.LShiftEq) == ParserBinaryPrecedence::SHIFT

def unknown_token_has_comparison_precedence() -> bool:
    ensure result == true
    return ParserBinaryPrecedence::precedence(Lexer::TokenKind.Eof) == ParserBinaryPrecedence::COMPARISON
