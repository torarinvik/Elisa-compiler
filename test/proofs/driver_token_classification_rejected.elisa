include "./parser_token_kind_projection.elisa"
include "../../src/driver/driver_token_classification.elisa"

def identifier_must_not_need_ast_spacing() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return DriverTokenClassification::needs_ast_token_space(Lexer::TokenKind.Ident)

def assignment_must_not_be_a_doc_binary_operator() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return DriverTokenClassification::is_doc_binary_operator(Lexer::TokenKind.Assign)
