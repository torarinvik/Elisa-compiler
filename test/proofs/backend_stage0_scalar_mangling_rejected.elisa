def unknown_kind_declines(kind: i64, bits: i64) -> bool:
    requires kind == 5
    ensure result == false
    return (kind == 1 and bits == 8) or (kind == 1 and bits == 16) or (kind == 1 and bits == 32) or (kind == 1 and bits == 64) or (kind == 2 and bits == 8) or (kind == 2 and bits == 16) or (kind == 2 and bits == 32) or (kind == 2 and bits == 64) or (kind == 3 and bits == 32) or (kind == 3 and bits == 64) or kind == 4

def unsupported_signed_width_declines(kind: i64, bits: i64) -> bool:
    requires kind == 1 and bits == 7
    ensure result == false
    return (kind == 1 and bits == 8) or (kind == 1 and bits == 16) or (kind == 1 and bits == 32) or (kind == 1 and bits == 64) or (kind == 2 and bits == 8) or (kind == 2 and bits == 16) or (kind == 2 and bits == 32) or (kind == 2 and bits == 64) or (kind == 3 and bits == 32) or (kind == 3 and bits == 64) or kind == 4

def unsupported_unsigned_width_declines(kind: i64, bits: i64) -> bool:
    requires kind == 2 and bits == 7
    ensure result == false
    return (kind == 1 and bits == 8) or (kind == 1 and bits == 16) or (kind == 1 and bits == 32) or (kind == 1 and bits == 64) or (kind == 2 and bits == 8) or (kind == 2 and bits == 16) or (kind == 2 and bits == 32) or (kind == 2 and bits == 64) or (kind == 3 and bits == 32) or (kind == 3 and bits == 64) or kind == 4

def unsupported_float_width_declines(kind: i64, bits: i64) -> bool:
    requires kind == 3 and bits == 16
    ensure result == false
    return (kind == 1 and bits == 8) or (kind == 1 and bits == 16) or (kind == 1 and bits == 32) or (kind == 1 and bits == 64) or (kind == 2 and bits == 8) or (kind == 2 and bits == 16) or (kind == 2 and bits == 32) or (kind == 2 and bits == 64) or (kind == 3 and bits == 32) or (kind == 3 and bits == 64) or kind == 4

