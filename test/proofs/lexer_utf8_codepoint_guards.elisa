# Prove that acceptance by the production decoder byte guards implies each canonical UTF-8
# byte and lead-specific boundary condition. The companion source checker pins these predicates
# to the early returns in lexer_core.elisa.
include "../../src/lexer/lexer_utf8_codepoint_constants.elisa"

def proof_three_byte_guard_contract(first: i64, second: i64, third: i64) -> bool:
    ensure result implies first >= UTF8_THREE_BYTE_LEAD_MIN
    ensure result implies first <= UTF8_THREE_BYTE_LEAD_MAX
    ensure result implies second >= UTF8_CONTINUATION_MIN
    ensure result implies second <= UTF8_CONTINUATION_MAX
    ensure result implies third >= UTF8_CONTINUATION_MIN
    ensure result implies third <= UTF8_CONTINUATION_MAX
    ensure result implies (first > UTF8_THREE_BYTE_LEAD_MIN or second >= UTF8_E0_SECOND_MIN)
    ensure result implies (first != UTF8_SURROGATE_LEAD or second <= UTF8_ED_SECOND_MAX)
    ensure result == (first >= UTF8_THREE_BYTE_LEAD_MIN and first <= UTF8_THREE_BYTE_LEAD_MAX and second >= UTF8_CONTINUATION_MIN and second <= UTF8_CONTINUATION_MAX and third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX and (first > UTF8_THREE_BYTE_LEAD_MIN or second >= UTF8_E0_SECOND_MIN) and (first != UTF8_SURROGATE_LEAD or second <= UTF8_ED_SECOND_MAX))
    return first >= UTF8_THREE_BYTE_LEAD_MIN and first <= UTF8_THREE_BYTE_LEAD_MAX and second >= UTF8_CONTINUATION_MIN and second <= UTF8_CONTINUATION_MAX and third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX and (first > UTF8_THREE_BYTE_LEAD_MIN or second >= UTF8_E0_SECOND_MIN) and (first != UTF8_SURROGATE_LEAD or second <= UTF8_ED_SECOND_MAX)

def proof_four_byte_guard_contract(first: i64, second: i64, third: i64, fourth: i64) -> bool:
    ensure result implies first >= UTF8_FOUR_BYTE_LEAD_MIN
    ensure result implies first <= UTF8_FOUR_BYTE_LEAD_MAX
    ensure result implies second >= UTF8_CONTINUATION_MIN
    ensure result implies second <= UTF8_CONTINUATION_MAX
    ensure result implies third >= UTF8_CONTINUATION_MIN
    ensure result implies third <= UTF8_CONTINUATION_MAX
    ensure result implies fourth >= UTF8_CONTINUATION_MIN
    ensure result implies fourth <= UTF8_CONTINUATION_MAX
    ensure result implies (first > UTF8_FOUR_BYTE_LEAD_MIN or second >= UTF8_F0_SECOND_MIN)
    ensure result implies (first < UTF8_FOUR_BYTE_LEAD_MAX or second <= UTF8_F4_SECOND_MAX)
    ensure result == (first >= UTF8_FOUR_BYTE_LEAD_MIN and first <= UTF8_FOUR_BYTE_LEAD_MAX and second >= UTF8_CONTINUATION_MIN and second <= UTF8_CONTINUATION_MAX and third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX and fourth >= UTF8_CONTINUATION_MIN and fourth <= UTF8_CONTINUATION_MAX and (first > UTF8_FOUR_BYTE_LEAD_MIN or second >= UTF8_F0_SECOND_MIN) and (first < UTF8_FOUR_BYTE_LEAD_MAX or second <= UTF8_F4_SECOND_MAX))
    return first >= UTF8_FOUR_BYTE_LEAD_MIN and first <= UTF8_FOUR_BYTE_LEAD_MAX and second >= UTF8_CONTINUATION_MIN and second <= UTF8_CONTINUATION_MAX and third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX and fourth >= UTF8_CONTINUATION_MIN and fourth <= UTF8_CONTINUATION_MAX and (first > UTF8_FOUR_BYTE_LEAD_MIN or second >= UTF8_F0_SECOND_MIN) and (first < UTF8_FOUR_BYTE_LEAD_MAX or second <= UTF8_F4_SECOND_MAX)
