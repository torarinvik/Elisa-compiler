# Source-linked proofs for static-effect path identity and call-shape preservation.
include "./effect_type_shape_proof_model.elisa"

def effect_path_form(expression: Ast::Expr) -> bool:
    match expression:
        Ast::Expr.Ident(name, pos):
            return true
        Ast::Expr.Scope(base, name, pos):
            return effect_path_form(base)
        _:
            return false

def self_comparison_matches_the_recursive_effect_path_form(expression: Ast::Expr) -> bool:
    ensure result == (
        Ast::effect_path_equal(expression, expression) == effect_path_form(expression)
    )
    match expression:
        Ast::Expr.Ident(name, pos):
            return true
        Ast::Expr.Scope(base, name, pos):
            return self_comparison_matches_the_recursive_effect_path_form(base)
        _:
            return true

def effect_path_equality_is_symmetric(left: Ast::Expr, right: Ast::Expr) -> bool:
    ensure result == true
    ensure Ast::effect_path_equal(left, right) == Ast::effect_path_equal(right, left)
    match left:
        Ast::Expr.Ident(left_name, left_pos):
            if right is Ast::Expr.Ident(right_name, right_pos):
                return (left_name == right_name) == (right_name == left_name)
            return true
        Ast::Expr.Scope(left_head, left_name, left_pos):
            if right is Ast::Expr.Scope(right_head, right_name, right_pos):
                recursive_symmetry: bool = effect_path_equality_is_symmetric(left_head, right_head)
                return recursive_symmetry
            return true
        _:
            return true

def identifier_path_equality_ignores_positions_and_compares_names_exactly(
    left_name: sview,
    right_name: sview,
    left_pos: Ast::Pos,
    right_pos: Ast::Pos
) -> bool:
    ensure result == (left_name == right_name)
    return Ast::effect_path_equal(
        Ast::Expr.Ident(left_name, left_pos),
        Ast::Expr.Ident(right_name, right_pos)
    )

def one_level_effect_paths_compare_each_segment(
    left_module: sview,
    left_member: sview,
    right_module: sview,
    right_member: sview,
    left_module_pos: Ast::Pos,
    left_path_pos: Ast::Pos,
    right_module_pos: Ast::Pos,
    right_path_pos: Ast::Pos
) -> bool:
    ensure result == (left_module == right_module and left_member == right_member)
    left: Ast::Expr = Ast::Expr.Scope(
        Ast::Expr.Ident(left_module, left_module_pos), left_member, left_path_pos
    )
    right: Ast::Expr = Ast::Expr.Scope(
        Ast::Expr.Ident(right_module, right_module_pos), right_member, right_path_pos
    )
    return Ast::effect_path_equal(left, right)

def two_level_effect_paths_compare_all_segments(
    left_root: sview,
    left_module: sview,
    left_member: sview,
    right_root: sview,
    right_module: sview,
    right_member: sview,
    p0: Ast::Pos,
    p1: Ast::Pos,
    p2: Ast::Pos,
    q0: Ast::Pos,
    q1: Ast::Pos,
    q2: Ast::Pos
) -> bool:
    ensure result == (
        left_root == right_root
        and left_module == right_module
        and left_member == right_member
    )
    left: Ast::Expr = Ast::Expr.Scope(
        Ast::Expr.Scope(Ast::Expr.Ident(left_root, p0), left_module, p1),
        left_member,
        p2
    )
    right: Ast::Expr = Ast::Expr.Scope(
        Ast::Expr.Scope(Ast::Expr.Ident(right_root, q0), right_module, q1),
        right_member,
        q2
    )
    return Ast::effect_path_equal(left, right)

def index_application_decomposes_to_its_head_and_single_argument(
    head: Ast::Expr,
    argument: Ast::Expr,
    pos: Ast::Pos
) -> bool:
    ensure result == true
    application: Ast::Expr = Ast::Expr.Index(head, argument, pos)
    arguments: darray[Ast::Expr] = Ast::effect_application_arguments(application)
    return (
        Ast::effect_application_head(application) == head
        and arguments.count == 1
        and arguments[0] == argument
    )

def multi_index_application_preserves_argument_order(
    head: Ast::Expr,
    first: Ast::Expr,
    second: Ast::Expr,
    pos: Ast::Pos
) -> bool:
    ensure result == true
    source_arguments: darray[Ast::Expr] = [first, second]
    application: Ast::Expr = Ast::Expr.IndexN(head, source_arguments, pos)
    arguments: darray[Ast::Expr] = Ast::effect_application_arguments(application)
    return (
        Ast::effect_application_head(application) == head
        and arguments.count == 2
        and arguments[0] == first
        and arguments[1] == second
    )

def unapplied_identifier_has_itself_as_head_and_no_arguments(
    name: sview,
    pos: Ast::Pos
) -> bool:
    ensure result == true
    expression: Ast::Expr = Ast::Expr.Ident(name, pos)
    arguments: darray[Ast::Expr] = Ast::effect_application_arguments(expression)
    return Ast::effect_application_head(expression) == expression and arguments.count == 0

def one_candidate_runtime_children_keep_captures_before_call_arguments(
    captures: darray[Ast::Expr],
    arguments: darray[Ast::Expr]
) -> bool:
    requires captures.count + arguments.count >= captures.count
    ensure result == true
    candidate: Ast::StaticEffectCandidate = Ast::StaticEffectCandidate{captures: captures}
    candidates: darray[Ast::StaticEffectCandidate] = [candidate]
    children: darray[Ast::Expr] = Ast::effect_runtime_children(candidates, arguments)
    same: mutable bool = children.count == captures.count + arguments.count
    for index in 0..<captures.count |same, children, captures|:
        same <- false if children[index] != captures[index]
    for index in 0..<arguments.count |same, children, captures, arguments|:
        same <- false if children[captures.count + index] != arguments[index]
    return same
