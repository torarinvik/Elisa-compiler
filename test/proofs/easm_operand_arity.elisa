# Prove the production EASM machine-op arity partition as a reusable contract.
include "../../src/backend/easm_text_scan.elisa"
include "../../src/backend/easm_operand_scan.elisa"

def zero_arity_classifier_is_exact(op: sview) -> bool:
    ensure result == true
    return EasmOperandScan::is_zero_operand_instruction(op) == (
        op == "ret" or op == "retq" or op == "cpuid" or op == "cld" or op == "std" or
        op == "lfence" or op == "rdtsc" or op == "pause" or op == "yield" or op == "isb" or
        op == "emms" or op == "vzeroall" or op == "trap"
    )

def unary_arity_classifier_is_exact(op: sview) -> bool:
    ensure result == true
    return EasmOperandScan::is_one_operand_instruction(op) == (
        op == "push" or op == "pushq" or op == "pop" or op == "popq" or
        op == "inc" or op == "incq" or op == "dec" or op == "decq" or
        op == "neg" or op == "negq" or op == "not" or op == "notq" or
        op == "call" or op == "callq" or op == "jmp" or op == "jmpq" or
        op == "je" or op == "jz" or op == "jne" or op == "jnz" or
        op == "jl" or op == "jle" or op == "jg" or op == "jge" or
        op == "jb" or op == "jbe" or op == "ja" or op == "jae" or
        op == "fldcw" or op == "fnstcw" or op == "stmxcsr" or op == "ldmxcsr"
    )

def binary_arity_classifier_is_exact(op: sview) -> bool:
    ensure result == true
    return EasmOperandScan::is_two_operand_instruction(op) == (
        op == "mov" or op == "movq" or op == "movb" or op == "movw" or op == "movl" or
        op == "movsx" or op == "movsxd" or op == "movsbw" or op == "movsbl" or op == "movsbq" or
        op == "movswl" or op == "movswq" or op == "movslq" or op == "movzx" or op == "movzbw" or
        op == "movzbl" or op == "movzbq" or op == "movzwl" or op == "movzwq" or
        op == "lea" or op == "leaq" or op == "xchg" or op == "xchgl" or op == "xchgq" or
        op == "add" or op == "addq" or op == "sub" or op == "subq" or
        op == "and" or op == "andq" or op == "or" or op == "orq" or op == "xor" or op == "xorq" or
        op == "cmp" or op == "cmpq" or op == "test" or op == "testq" or op == "mrs"
    )

def shift_arity_classifier_is_exact(op: sview) -> bool:
    ensure result == true
    return EasmOperandScan::is_shift_instruction(op) == (
        op == "shl" or op == "shlq" or op == "sal" or op == "salq" or
        op == "shr" or op == "shrq" or op == "sar" or op == "sarq"
    )

def machine_opcode_arity_classes_are_disjoint(op: sview) -> bool:
    ensure result == true
    return not (
        (EasmOperandScan::is_zero_operand_instruction(op) and EasmOperandScan::is_one_operand_instruction(op)) or
        (EasmOperandScan::is_zero_operand_instruction(op) and EasmOperandScan::is_two_operand_instruction(op)) or
        (EasmOperandScan::is_zero_operand_instruction(op) and EasmOperandScan::is_shift_instruction(op)) or
        (EasmOperandScan::is_one_operand_instruction(op) and EasmOperandScan::is_two_operand_instruction(op)) or
        (EasmOperandScan::is_one_operand_instruction(op) and EasmOperandScan::is_shift_instruction(op)) or
        (EasmOperandScan::is_two_operand_instruction(op) and EasmOperandScan::is_shift_instruction(op))
    )

def machine_opcode_arity_classes_cover_exact_inventory(op: sview) -> bool:
    ensure result == true
    return (
        EasmOperandScan::is_zero_operand_instruction(op) or
        EasmOperandScan::is_one_operand_instruction(op) or
        EasmOperandScan::is_two_operand_instruction(op) or
        EasmOperandScan::is_shift_instruction(op)
    ) == (
        op == "add" or op == "addq" or op == "and" or op == "andq" or op == "call" or op == "callq" or op == "cld" or op == "cmp" or op == "cmpq" or op == "cpuid" or op == "dec" or op == "decq" or op == "emms" or op == "fldcw" or op == "fnstcw" or op == "inc" or op == "incq" or op == "isb" or op == "ja" or op == "jae" or op == "jb" or op == "jbe" or op == "je" or op == "jg" or op == "jge" or op == "jl" or op == "jle" or op == "jmp" or op == "jmpq" or op == "jne" or op == "jnz" or op == "jz" or op == "ldmxcsr" or op == "lea" or op == "leaq" or op == "lfence" or op == "mov" or op == "movb" or op == "movl" or op == "movq" or op == "movsbl" or op == "movsbq" or op == "movsbw" or op == "movslq" or op == "movswl" or op == "movswq" or op == "movsx" or op == "movsxd" or op == "movw" or op == "movzbl" or op == "movzbq" or op == "movzbw" or op == "movzwl" or op == "movzwq" or op == "movzx" or op == "mrs" or op == "neg" or op == "negq" or op == "not" or op == "notq" or op == "or" or op == "orq" or op == "pause" or op == "pop" or op == "popq" or op == "push" or op == "pushq" or op == "rdtsc" or op == "ret" or op == "retq" or op == "sal" or op == "salq" or op == "sar" or op == "sarq" or op == "shl" or op == "shlq" or op == "shr" or op == "shrq" or op == "std" or op == "stmxcsr" or op == "sub" or op == "subq" or op == "test" or op == "testq" or op == "trap" or op == "vzeroall" or op == "xchg" or op == "xchgl" or op == "xchgq" or op == "xor" or op == "xorq" or op == "yield"
    )

def supported_arity_matches_precedence_partition(op: sview, count: usize) -> bool:
    ensure result == true
    return EasmOperandScan::operand_arity_supported(op, count) == (
        (EasmOperandScan::is_zero_operand_instruction(op) and count == 0) or
        (not EasmOperandScan::is_zero_operand_instruction(op) and EasmOperandScan::is_one_operand_instruction(op) and count == 1) or
        (not EasmOperandScan::is_zero_operand_instruction(op) and not EasmOperandScan::is_one_operand_instruction(op) and EasmOperandScan::is_two_operand_instruction(op) and count == 2) or
        (not EasmOperandScan::is_zero_operand_instruction(op) and not EasmOperandScan::is_one_operand_instruction(op) and not EasmOperandScan::is_two_operand_instruction(op) and EasmOperandScan::is_shift_instruction(op) and (count == 1 or count == 2))
    )

def supported_machine_arity_never_exceeds_model(op: sview, count: usize) -> bool:
    requires EasmOperandScan::operand_arity_supported(op, count)
    ensure result == true
    return not EasmOperandScan::needs_arity_rejection(count)

def unknown_opcode_has_no_supported_arity(count: usize) -> bool:
    ensure result == true
    return not EasmOperandScan::operand_arity_supported("movgarbage", count)
