# The production hash index may chain collisions, so cache acceptance must
# check both components of the (callee, parameter-tag) key.
def pgs_exact_pair_match(hash_bucket_matches: bool, callee_matches: bool, tag_matches: bool) -> bool:
    ensure result == (hash_bucket_matches and callee_matches and tag_matches)
    return hash_bucket_matches and callee_matches and tag_matches

def pgs_hash_collision_on_callee_is_rejected(hash_bucket_matches: bool, callee_matches: bool, tag_matches: bool) -> bool:
    requires not callee_matches
    ensure result == false
    return pgs_exact_pair_match(hash_bucket_matches, callee_matches, tag_matches)

def pgs_hash_collision_on_tag_is_rejected(hash_bucket_matches: bool, callee_matches: bool, tag_matches: bool) -> bool:
    requires not tag_matches
    ensure result == false
    return pgs_exact_pair_match(hash_bucket_matches, callee_matches, tag_matches)

def pgs_matching_pair_is_accepted_from_its_bucket(hash_bucket_matches: bool) -> bool:
    requires hash_bucket_matches
    ensure result == true
    return pgs_exact_pair_match(hash_bucket_matches, true, true)

def pgs_key_is_eligible(callee_is_present: bool, tag_is_present: bool) -> bool:
    ensure result == (callee_is_present and tag_is_present)
    return callee_is_present and tag_is_present

def pgs_empty_key_component_disables_lookup(callee_is_present: bool, tag_is_present: bool) -> bool:
    requires not callee_is_present or not tag_is_present
    ensure result == false
    return pgs_key_is_eligible(callee_is_present, tag_is_present)

def pgs_present_key_components_allow_lookup(callee_is_present: bool, tag_is_present: bool) -> bool:
    requires callee_is_present and tag_is_present
    ensure result == true
    return pgs_key_is_eligible(callee_is_present, tag_is_present)
