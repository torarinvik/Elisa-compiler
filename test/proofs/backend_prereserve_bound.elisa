# The backend caps trips and per-trip pushes before computing the one-shot reserve size.
def prereserve_extra_capacity_is_i64_safe(bound: i64, pushes: i64) -> i64:
    requires pushes >= 1 and pushes <= 64
    ensure result >= 0
    ensure result <= 1073741824
    return (0 if bound <= 0 else (16777216 if bound > 16777216 else bound)) * pushes

def prereserve_negative_bound_reserves_nothing(bound: i64, pushes: i64) -> i64:
    requires bound < 0
    requires pushes >= 1 and pushes <= 64
    ensure result == 0
    return (0 if bound <= 0 else (16777216 if bound > 16777216 else bound)) * pushes

def prereserve_over_cap_bound_is_clamped(bound: i64, pushes: i64) -> i64:
    requires bound > 16777216
    requires pushes >= 1 and pushes <= 64
    ensure result == 16777216 * pushes
    return (0 if bound <= 0 else (16777216 if bound > 16777216 else bound)) * pushes

def prereserve_in_range_bound_is_preserved(bound: i64, pushes: i64) -> i64:
    requires bound > 0 and bound <= 16777216
    requires pushes >= 1 and pushes <= 64
    ensure result == bound * pushes
    return (0 if bound <= 0 else (16777216 if bound > 16777216 else bound)) * pushes

def prereserve_zero_bound_reserves_nothing(bound: i64, pushes: i64) -> i64:
    requires bound == 0
    requires pushes >= 1 and pushes <= 64
    ensure result == 0
    return (0 if bound <= 0 else (16777216 if bound > 16777216 else bound)) * pushes
