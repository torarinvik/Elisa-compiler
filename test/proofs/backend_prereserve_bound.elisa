# Model the backend's sequential ABI-stride byte cap for one-shot DArray reserve.
# The implementation divides the byte budget by stride, then by pushes per trip,
# so the intermediate product cannot overflow.
def prereserve_trip_cap_model(pushes: i64, element_stride_bytes: i64) -> i64:
    ensure result >= 0
    ensure result <= 67108864
    return 0 if pushes <= 0 or pushes > 64 or element_stride_bytes <= 0 else (67108864 / element_stride_bytes) / pushes

def prereserve_single_i64_trip_cap(pushes: i64, element_stride_bytes: i64) -> i64:
    requires pushes == 1 and element_stride_bytes == 8
    ensure result == 8388608
    return prereserve_trip_cap_model(pushes, element_stride_bytes)

def prereserve_two_i64_trip_cap(pushes: i64, element_stride_bytes: i64) -> i64:
    requires pushes == 2 and element_stride_bytes == 8
    ensure result == 4194304
    return prereserve_trip_cap_model(pushes, element_stride_bytes)

def prereserve_zero_stride_reserves_nothing(pushes: i64, element_stride_bytes: i64) -> i64:
    requires pushes >= 1 and pushes <= 64 and element_stride_bytes == 0
    ensure result == 0
    return prereserve_trip_cap_model(pushes, element_stride_bytes)

def prereserve_too_many_pushes_disable_reservation(pushes: i64, element_stride_bytes: i64) -> i64:
    requires pushes > 64 and element_stride_bytes > 0
    ensure result == 0
    return prereserve_trip_cap_model(pushes, element_stride_bytes)

def prereserve_extra_capacity_is_i64_safe(bound: i64, pushes: i64, element_stride_bytes: i64) -> i64:
    requires bound >= 0 and pushes == 2 and element_stride_bytes == 8
    ensure result >= 0
    ensure result <= 67108864
    return (prereserve_trip_cap_model(pushes, element_stride_bytes) if bound > prereserve_trip_cap_model(pushes, element_stride_bytes) else bound) * pushes * element_stride_bytes

def prereserve_negative_bound_reserves_nothing(bound: i64, pushes: i64, element_stride_bytes: i64) -> i64:
    requires bound < 0 and pushes == 2 and element_stride_bytes == 8
    ensure result == 0
    return (0 if bound <= 0 else (prereserve_trip_cap_model(pushes, element_stride_bytes) if bound > prereserve_trip_cap_model(pushes, element_stride_bytes) else bound)) * pushes * element_stride_bytes

def prereserve_over_cap_bound_is_clamped(bound: i64, pushes: i64, element_stride_bytes: i64) -> i64:
    requires bound > 4194304 and pushes == 2 and element_stride_bytes == 8
    ensure result == 67108864
    return (prereserve_trip_cap_model(pushes, element_stride_bytes) if bound > prereserve_trip_cap_model(pushes, element_stride_bytes) else bound) * pushes * element_stride_bytes

def prereserve_in_range_bound_is_preserved(bound: i64, pushes: i64, element_stride_bytes: i64) -> i64:
    requires bound > 0 and bound <= 4194304 and pushes == 2 and element_stride_bytes == 8
    ensure result == bound * pushes * element_stride_bytes
    return (prereserve_trip_cap_model(pushes, element_stride_bytes) if bound > prereserve_trip_cap_model(pushes, element_stride_bytes) else bound) * pushes * element_stride_bytes

def prereserve_zero_bound_reserves_nothing(bound: i64, pushes: i64, element_stride_bytes: i64) -> i64:
    requires bound == 0 and pushes == 2 and element_stride_bytes == 8
    ensure result == 0
    return (0 if bound <= 0 else (prereserve_trip_cap_model(pushes, element_stride_bytes) if bound > prereserve_trip_cap_model(pushes, element_stride_bytes) else bound)) * pushes * element_stride_bytes
