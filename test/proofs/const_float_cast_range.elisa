# Source-linked boundary proofs for the shared constant float-cast range rule.
include "../../src/semantic/const_float_cast_range.elisa"

def signed_negative_limit_table_refines_its_spec(target: sview, pointer_bits: u32) -> bool can[Abort.Panic]:
    requires target in {"i8", "i16", "i32", "i64", "int", "isize"} and pointer_bits == 64
    ensure result == true
    can Abort.Panic:
        return when target:
            "i8" -> ConstFloatCastRange::integer_magnitude_limit(target, true, pointer_bits) == "128"
            "i16" -> ConstFloatCastRange::integer_magnitude_limit(target, true, pointer_bits) == "32768"
            "i32" -> ConstFloatCastRange::integer_magnitude_limit(target, true, pointer_bits) == "2147483648"
            "i64" | "int" | "isize" -> ConstFloatCastRange::integer_magnitude_limit(target, true, pointer_bits) == "9223372036854775808"
            _ -> false

def signed_positive_limit_table_refines_its_spec(target: sview, pointer_bits: u32) -> bool can[Abort.Panic]:
    requires target in {"i8", "i16", "i32", "i64", "int", "isize"} and pointer_bits == 64
    ensure result == true
    can Abort.Panic:
        return when target:
            "i8" -> ConstFloatCastRange::integer_magnitude_limit(target, false, pointer_bits) == "127"
            "i16" -> ConstFloatCastRange::integer_magnitude_limit(target, false, pointer_bits) == "32767"
            "i32" -> ConstFloatCastRange::integer_magnitude_limit(target, false, pointer_bits) == "2147483647"
            "i64" | "int" | "isize" -> ConstFloatCastRange::integer_magnitude_limit(target, false, pointer_bits) == "9223372036854775807"
            _ -> false

def target_signed_32_limit_table_refines_its_spec(target: sview) -> bool can[Abort.Panic]:
    requires target in {"int", "isize"}
    ensure result == true
    can Abort.Panic:
        return ConstFloatCastRange::integer_magnitude_limit(target, true, 32) == "2147483648" and ConstFloatCastRange::integer_magnitude_limit(target, false, 32) == "2147483647"

def target_unsigned_32_limit_table_refines_its_spec(target: sview) -> bool can[Abort.Panic]:
    requires target in {"usize", "uintptr"}
    ensure result == true
    can Abort.Panic:
        return ConstFloatCastRange::integer_magnitude_limit(target, false, 32) == "4294967295"

def one_unary_minus_flips_sign() -> bool:
    ensure result == true
    return ConstFloatCastRange::negative_after_unary(true, false)

def double_unary_minus_restores_positive_sign() -> bool:
    ensure result == true
    inner_sign: bool = ConstFloatCastRange::negative_after_unary(true, false)
    return not ConstFloatCastRange::negative_after_unary(true, inner_sign)

def unary_plus_preserves_negative_sign() -> bool:
    ensure result == true
    return ConstFloatCastRange::negative_after_unary(false, true)

def negative_i8_minimum_is_in_range() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not ConstFloatCastRange::cast_out_of_range("i8", true, "128.0", 64)

def negative_i8_one_past_minimum_is_out_of_range() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return ConstFloatCastRange::cast_out_of_range("i8", true, "129.0", 64)

