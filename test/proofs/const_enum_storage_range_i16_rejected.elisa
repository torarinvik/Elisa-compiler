include "./const_enum_storage_range_i16.elisa"

def false_const_enum_i16_accepts_below(value: i64) -> bool:
    requires value < (0 - 32768)
    ensure result == true
    return proof_const_enum_i16_fits(value)

def false_const_enum_i16_accepts_above(value: i64) -> bool:
    requires value > 32767
    ensure result == true
    return proof_const_enum_i16_fits(value)
