# EASM label lookup ignores non-label instructions and returns -1 for an empty
# target. Embedded whitespace in otherwise nonempty labels remains a separate
# parser-parity question.
include "../../src/backend/easm_model.elisa"

def a_found_label_index_is_in_range(instructions: darray[Easm::Instruction], target: sview) -> bool:
    requires Easm::easm_label_index(instructions, target) >= 0
    ensure result == true
    found: i64 = Easm::easm_label_index(instructions, target)
    return found < instructions.count.i64()

def a_found_label_index_roundtrips_to_usize(instructions: darray[Easm::Instruction], target: sview) -> bool:
    requires Easm::easm_label_index(instructions, target) >= 0
    ensure result == true
    found: i64 = Easm::easm_label_index(instructions, target)
    return found.usize().i64() == found

def an_absent_label_returns_the_missing_sentinel(instructions: darray[Easm::Instruction], target: sview) -> bool can[Unsafe.UncheckedIndex]:
    requires instructions.count.i64() >= 0 and instructions.count.i64().usize() == instructions.count
    requires target.len > 0
    requires forall candidate in 0..<instructions.count.i64():
        Easm::easm_label_name(instructions[candidate.usize()]) != target
    ensure result == true
    return Easm::easm_label_index(instructions, target) == -1

def an_unrepresentable_instruction_count_returns_the_missing_sentinel(instructions: darray[Easm::Instruction], target: sview) -> bool:
    requires instructions.count.i64() < 0 or instructions.count.i64().usize() != instructions.count
    ensure result == true
    return Easm::easm_label_index(instructions, target) == -1

def the_first_matching_label_is_selected(
    instructions: darray[Easm::Instruction],
    target: sview,
    first: usize,
    later: usize
) -> bool can[Unsafe.UncheckedIndex]:
    requires instructions.count.i64() >= 0 and instructions.count.i64().usize() == instructions.count
    requires target.len > 0
    requires first < later and later < instructions.count
    requires instructions[first].op == "label" and instructions[later].op == "label"
    requires forall prior in 0..<first:
        Easm::easm_label_name(instructions[prior]) != target
    requires Easm::easm_label_name(instructions[first]) == target
    requires Easm::easm_label_name(instructions[later]) == target
    ensure result == true
    return Easm::easm_label_index(instructions, target) == first.i64()

def an_empty_instruction_list_has_no_label_index(target: sview) -> bool:
    ensure result == true
    instructions: darray[Easm::Instruction] = []
    return Easm::easm_label_index(instructions, target) == -1

def an_empty_lookup_target_returns_the_missing_sentinel(instructions: darray[Easm::Instruction]) -> bool:
    ensure result == true
    return Easm::easm_label_index(instructions, "") == -1

def a_non_label_instruction_has_no_label_name(instruction: Easm::Instruction) -> bool:
    requires instruction.op != "label"
    ensure result == true
    return Easm::easm_label_name(instruction).len == 0

def a_label_without_a_terminal_colon_keeps_its_trimmed_name(instruction: Easm::Instruction) -> bool can[Unsafe.UncheckedIndex]:
    requires instruction.op == "label"
    requires Easm::easm_trim(instruction.text).len == 0 or Easm::easm_trim(instruction.text)[Easm::easm_trim(instruction.text).len - 1.usize()] != 58
    ensure result == true
    return Easm::easm_label_name(instruction) == Easm::easm_trim(instruction.text)

def a_label_with_a_terminal_colon_drops_exactly_one(instruction: Easm::Instruction) -> bool can[Unsafe.UncheckedIndex]:
    requires instruction.op == "label"
    requires Easm::easm_trim(instruction.text).len > 0
    requires Easm::easm_trim(instruction.text)[Easm::easm_trim(instruction.text).len - 1.usize()] == 58
    ensure result == true
    trimmed: sview = Easm::easm_trim(instruction.text)
    return Easm::easm_label_name(instruction) == Easm::easm_trim(trimmed[0:trimmed.len - 1.usize()])
