include "./char_classifier_guard.elisa"

def extra_parameter_char_function_is_misdiagnosed() -> bool:
    ensure result == true
    return CharClassifierGuardSpecification::should_report(false, true, true, true, true, true)

def guardless_classifier_is_misdiagnosed() -> bool:
    ensure result == true
    return CharClassifierGuardSpecification::should_report(true, true, true, true, true, false)

def classifier_for_non_enum_return_is_misdiagnosed() -> bool:
    ensure result == true
    return CharClassifierGuardSpecification::should_report(true, true, false, true, true, true)
