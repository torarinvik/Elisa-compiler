# False controls: hash equality is not key equality, wraparound stays in range,
# and a bounded miss uses the direct classification.
include "./lexer_line_map_path_cache.elisa"

def false_hash_match_alone_reuses_cached_classification(
    occupied: bool,
    hashes_match: bool,
    paths_equal: bool,
    cached_is_std: bool,
    direct_is_std: bool
) -> bool:
    requires occupied and hashes_match and not paths_equal
    ensure result == cached_is_std
    return cached_is_std if cache_hit_requires_occupied_hash_and_equal_path(occupied, hashes_match, true) else direct_is_std

def false_in_range_slot_reaches_capacity(slot_is_in_range: bool) -> bool:
    requires slot_is_in_range
    ensure result == true
    return not slot_is_in_range

def false_in_range_probe_count_reaches_capacity(probe_is_below_limit: bool) -> bool:
    requires probe_is_below_limit
    ensure result == true
    return not probe_is_below_limit

def false_cache_miss_uses_cached_classification(found: bool, cached_is_std: bool, direct_is_std: bool) -> bool:
    requires not found
    ensure result == cached_is_std
    return cached_is_std if found else direct_is_std
