include "./law_subject_type_mismatch.elisa"

def false_equal_subject_types_are_reported() -> bool:
    ensure result == true
    return LawSubjectTypeMismatchRule::should_report("i64", "i64")

def false_missing_value_type_is_reported() -> bool:
    ensure result == true
    return LawSubjectTypeMismatchRule::should_report("", "i64")

def false_missing_subject_type_is_reported() -> bool:
    ensure result == true
    return LawSubjectTypeMismatchRule::should_report("i64", "")

def false_distinct_types_are_ignored() -> bool:
    ensure result == true
    return not LawSubjectTypeMismatchRule::should_report("i64", "bool")
