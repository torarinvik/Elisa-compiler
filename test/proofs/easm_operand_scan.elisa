# Prove the production scanner's top-level operand grouping and fail-closed arity model.
include "../../src/backend/easm_text_scan.elisa"
include "../../src/backend/easm_operand_scan.elisa"

def indexed_address_commas_stay_inside_one_operand() -> bool:
    ensure result == true
    text: sview = "movq (%rax,%rcx,8), %rbx"
    scan: (start: usize, count: usize, first_separator: usize, last_separator: usize, has_address_group: bool, address_open: usize, address_close: usize, valid: bool) = EasmOperandScan::scan_instruction(text)
    return (
        scan.valid and scan.count == 2 and
        text[scan.start:scan.first_separator] == "(%rax,%rcx,8)" and
        text[scan.last_separator + 1.usize():sview_len(text)] == "%rbx"
    )

def three_top_level_operands_exceed_the_modeled_limit() -> bool:
    ensure result == true
    text: sview = "shld %cl, %rbx, (%rax)"
    scan: (start: usize, count: usize, first_separator: usize, last_separator: usize, has_address_group: bool, address_open: usize, address_close: usize, valid: bool) = EasmOperandScan::scan_instruction(text)
    return scan.valid and scan.count == 3 and EasmOperandScan::needs_arity_rejection(scan.count)

def a_single_indexed_memory_operand_has_arity_one() -> bool:
    ensure result == true
    text: sview = "callq *(%rax,%rcx,8)"
    scan: (start: usize, count: usize, first_separator: usize, last_separator: usize, has_address_group: bool, address_open: usize, address_close: usize, valid: bool) = EasmOperandScan::scan_instruction(text)
    return scan.valid and scan.count == 1 and not EasmOperandScan::needs_arity_rejection(scan.count)

def unmatched_address_parenthesis_fails_closed() -> bool:
    ensure result == true
    text: sview = "movq (%rax,%rcx,8, %rbx"
    scan: (start: usize, count: usize, first_separator: usize, last_separator: usize, has_address_group: bool, address_open: usize, address_close: usize, valid: bool) = EasmOperandScan::scan_instruction(text)
    return not scan.valid

def unmatched_closing_parenthesis_fails_closed() -> bool:
    ensure result == true
    text: sview = "movq %rax), %rbx"
    scan: (start: usize, count: usize, first_separator: usize, last_separator: usize, has_address_group: bool, address_open: usize, address_close: usize, valid: bool) = EasmOperandScan::scan_instruction(text)
    return not scan.valid

def nested_address_parentheses_fail_closed() -> bool:
    ensure result == true
    text: sview = "movq ((%rax)), %rbx"
    scan: (start: usize, count: usize, first_separator: usize, last_separator: usize, has_address_group: bool, address_open: usize, address_close: usize, valid: bool) = EasmOperandScan::scan_instruction(text)
    return not scan.valid

def no_operand_instruction_has_zero_operands() -> bool:
    ensure result == true
    scan: (start: usize, count: usize, first_separator: usize, last_separator: usize, has_address_group: bool, address_open: usize, address_close: usize, valid: bool) = EasmOperandScan::scan_instruction("ret")
    return scan.valid and scan.count == 0

def scan_records_exact_top_level_separator_prefix(text: sview) -> bool:
    ensure result == true
    scan: (start: usize, count: usize, first_separator: usize, last_separator: usize, has_address_group: bool, address_open: usize, address_close: usize, valid: bool) = EasmOperandScan::scan_instruction(text)
    if not scan.valid:
        return scan.count == 0 and scan.first_separator == sview_len(text) and scan.last_separator == sview_len(text) and not scan.has_address_group
    if scan.count == 0:
        return (scan.start == sview_len(text) and scan.first_separator == sview_len(text) and scan.last_separator == sview_len(text) and
            not scan.has_address_group and scan.address_open == sview_len(text) and scan.address_close == sview_len(text)
        )
    if scan.count == 1:
        return (scan.first_separator == sview_len(text) and scan.last_separator == sview_len(text) and scan.start < sview_len(text) and
            EasmOperandScan::first_operand_byte(text[scan.start:sview_len(text)], 0.usize()) < sview_len(text[scan.start:sview_len(text)]) and
            EasmOperandScan::next_top_level_separator(text, scan.start, scan.has_address_group, scan.address_open, scan.address_close) == sview_len(text)
        )
    first: usize = EasmOperandScan::next_top_level_separator(text, scan.start, scan.has_address_group, scan.address_open, scan.address_close)
    if scan.count == 2:
        return (scan.first_separator == first and scan.last_separator == first and
            EasmOperandScan::next_top_level_separator(text, first + 1.usize(), scan.has_address_group, scan.address_open, scan.address_close) == sview_len(text)
        )
    second: usize = EasmOperandScan::next_top_level_separator(text, first + 1.usize(), scan.has_address_group, scan.address_open, scan.address_close)
    return scan.count == EasmOperandScan::TOO_MANY_OPERANDS_SENTINEL and scan.first_separator == first and scan.last_separator == second

def valid_scan_exposes_only_its_delimited_address_pair(text: sview) -> bool:
    ensure result == true
    scan: (start: usize, count: usize, first_separator: usize, last_separator: usize, has_address_group: bool, address_open: usize, address_close: usize, valid: bool) = EasmOperandScan::scan_instruction(text)
    if not scan.valid:
        return true
    if scan.has_address_group:
        return (scan.start <= scan.address_open and scan.address_open < scan.address_close and scan.address_close < sview_len(text) and
            sview_at(text, scan.address_open) == EasmOperandScan::ASCII_LEFT_PAREN and
            sview_at(text, scan.address_close) == EasmOperandScan::ASCII_RIGHT_PAREN and
            (forall candidate in scan.start..<scan.address_open:
                sview_at(text, candidate) != EasmOperandScan::ASCII_LEFT_PAREN and sview_at(text, candidate) != EasmOperandScan::ASCII_RIGHT_PAREN) and
            (forall candidate in scan.address_open + 1.usize()..<scan.address_close:
                sview_at(text, candidate) != EasmOperandScan::ASCII_LEFT_PAREN and sview_at(text, candidate) != EasmOperandScan::ASCII_RIGHT_PAREN) and
            (forall candidate in scan.address_close + 1.usize()..<sview_len(text):
                sview_at(text, candidate) != EasmOperandScan::ASCII_LEFT_PAREN and sview_at(text, candidate) != EasmOperandScan::ASCII_RIGHT_PAREN)
        )
    return (scan.address_open == sview_len(text) and scan.address_close == sview_len(text) and
        (forall candidate in scan.start..<sview_len(text):
            sview_at(text, candidate) != EasmOperandScan::ASCII_LEFT_PAREN and sview_at(text, candidate) != EasmOperandScan::ASCII_RIGHT_PAREN)
    )

def first_operand_byte_is_the_least_non_whitespace(text: sview, from: usize) -> bool:
    requires from <= sview_len(text)
    ensure result == true
    index: usize = EasmOperandScan::first_operand_byte(text, from)
    return ((index == sview_len(text) and
            (forall candidate in from..<sview_len(text):
                sview_at(text, candidate) == EasmOperandScan::ASCII_SPACE or sview_at(text, candidate) == EasmOperandScan::ASCII_TAB)) or
        (index < sview_len(text) and
            sview_at(text, index) != EasmOperandScan::ASCII_SPACE and sview_at(text, index) != EasmOperandScan::ASCII_TAB and
            (forall candidate in from..<index:
                sview_at(text, candidate) == EasmOperandScan::ASCII_SPACE or sview_at(text, candidate) == EasmOperandScan::ASCII_TAB)))

def next_separator_is_the_first_comma_outside_address(text: sview, from: usize, has_address: bool, open: usize, close: usize) -> bool:
    requires from <= sview_len(text) and open <= sview_len(text) and close <= sview_len(text)
    ensure result == true
    separator: usize = EasmOperandScan::next_top_level_separator(text, from, has_address, open, close)
    return ((separator == sview_len(text) or
            (separator >= from and sview_at(text, separator) == EasmOperandScan::ASCII_COMMA and
                (not has_address or separator < open or separator > close))) and
        (forall candidate in from..<separator:
            sview_at(text, candidate) != EasmOperandScan::ASCII_COMMA or
            (has_address and candidate >= open and candidate <= close)))

def zero_operand_opcode_classifier_matches_its_exact_set(op: sview) -> bool:
    ensure result == true
    return EasmOperandScan::is_zero_operand_instruction(op) == (
        op == "ret" or op == "retq" or op == "cpuid" or op == "cld" or op == "std" or
        op == "lfence" or op == "rdtsc" or op == "pause" or op == "yield" or op == "isb" or
        op == "emms" or op == "vzeroall" or op == "trap"
    )

def modeled_arity_matches_zero_operand_opcode_class(count: usize, zero_operand_opcode: bool) -> bool:
    ensure result == true
    rejected: bool = (
        EasmOperandScan::needs_arity_rejection(count) or
        (count == 0 and not zero_operand_opcode) or (count != 0 and zero_operand_opcode)
    )
    return (not rejected) == (
        count <= EasmOperandScan::MAX_MODELED_OPERAND_COUNT and ((count == 0) == zero_operand_opcode)
    )

def zero_operand_ret_arity_is_accepted() -> bool:
    ensure result == true
    return EasmOperandScan::operand_arity_supported("ret", 0.usize())

def unary_push_arity_is_accepted() -> bool:
    ensure result == true
    return EasmOperandScan::operand_arity_supported("pushq", 1.usize())

def binary_move_arity_is_accepted() -> bool:
    ensure result == true
    return EasmOperandScan::operand_arity_supported("movq", 2.usize())

def one_operand_shift_arity_is_accepted() -> bool:
    ensure result == true
    return EasmOperandScan::operand_arity_supported("shlq", 1.usize())

def two_operand_shift_arity_is_accepted() -> bool:
    ensure result == true
    return EasmOperandScan::operand_arity_supported("shlq", 2.usize())

def mrs_arity_is_binary() -> bool:
    ensure result == true
    return EasmOperandScan::operand_arity_supported("mrs", 2.usize())

def direct_register_token_is_recognized_exactly() -> bool:
    ensure result == true
    return EasmOperandScan::exact_register_form("%rax", "rax")

def indirect_register_token_is_recognized_exactly() -> bool:
    ensure result == true
    return EasmOperandScan::exact_register_form("*%rax", "rax")

def segment_address_is_not_a_register_token() -> bool:
    ensure result == true
    return not EasmOperandScan::exact_register_form("%fs:0x28", "fs")

def exact_register_form_matches_its_complete_token_equation(operand: sview, register_name: sview) -> bool:
    ensure result == true
    return EasmOperandScan::exact_register_form(operand, register_name) == (
        (sview_len(operand) == sview_len(register_name) + EasmOperandScan::SCAN_STEP and
            sview_len(operand) > 0 and sview_at(operand, 0) == EasmOperandScan::ASCII_PERCENT and
            operand[EasmOperandScan::SCAN_STEP:sview_len(operand)] == register_name) or
        (sview_len(operand) == sview_len(register_name) + EasmOperandScan::INDIRECT_REGISTER_PREFIX_LENGTH and
            sview_len(operand) >= EasmOperandScan::INDIRECT_REGISTER_PREFIX_LENGTH and sview_at(operand, 0) == EasmOperandScan::ASCII_STAR and
            sview_at(operand, 1) == EasmOperandScan::ASCII_PERCENT and
            operand[EasmOperandScan::INDIRECT_REGISTER_PREFIX_LENGTH:sview_len(operand)] == register_name)
    )

def direct_control_target_classifier_matches_its_exact_set(op: sview, operand: sview, is_final_operand: bool) -> bool:
    ensure result == true
    return EasmOperandScan::is_direct_control_target(op, operand, is_final_operand) == (
        is_final_operand and sview_len(operand) > 0 and
        sview_at(operand, 0) != EasmOperandScan::ASCII_PERCENT and sview_at(operand, 0) != EasmOperandScan::ASCII_DOLLAR and
        sview_at(operand, 0) != EasmOperandScan::ASCII_STAR and sview_at(operand, 0) != EasmOperandScan::ASCII_LEFT_PAREN and
        sview_at(operand, 0) != EasmOperandScan::ASCII_LEFT_BRACKET and
        EasmTextScan::find(operand, ":") == sview_len(operand) and
        (op == "call" or op == "callq" or op == "jmp" or op == "jmpq" or
            op == "je" or op == "jz" or op == "jne" or op == "jnz" or
            op == "jl" or op == "jle" or op == "jg" or op == "jge" or
            op == "jb" or op == "jbe" or op == "ja" or op == "jae")
    )

def aarch64_mrs_form_classifier_matches_x0_through_x30_and_xzr(result_register: sview, system_register: sview) -> bool:
    ensure result == true
    return EasmOperandScan::is_aarch64_mrs_form(result_register, system_register) == (
        system_register == "cntvct_el0" and
        (result_register == "xzr" or
            (sview_len(result_register) == 2 and sview_at(result_register, 0) == EasmOperandScan::ASCII_X and
                sview_at(result_register, 1) >= EasmOperandScan::ASCII_ZERO and sview_at(result_register, 1) <= EasmOperandScan::ASCII_NINE) or
            (sview_len(result_register) == 3 and sview_at(result_register, 0) == EasmOperandScan::ASCII_X and
                (((sview_at(result_register, 1) == EasmOperandScan::ASCII_ONE or sview_at(result_register, 1) == EasmOperandScan::ASCII_TWO) and
                    sview_at(result_register, 2) >= EasmOperandScan::ASCII_ZERO and sview_at(result_register, 2) <= EasmOperandScan::ASCII_NINE) or
                    (sview_at(result_register, 1) == EasmOperandScan::ASCII_THREE and sview_at(result_register, 2) == EasmOperandScan::ASCII_ZERO)))
        )
    )

def direct_call_symbol_target_is_classified_as_control() -> bool:
    ensure result == true
    return EasmOperandScan::is_direct_control_target("callq", "runtime_helper", true)

def conditional_symbol_target_is_classified_as_control() -> bool:
    ensure result == true
    return EasmOperandScan::is_direct_control_target("jz", "local_done", true)

def mrs_accepts_low_x_register() -> bool:
    ensure result == true
    return EasmOperandScan::is_aarch64_mrs_form("x0", "cntvct_el0")

def mrs_accepts_high_x_register() -> bool:
    ensure result == true
    return EasmOperandScan::is_aarch64_mrs_form("x30", "cntvct_el0")

def mrs_accepts_zero_register() -> bool:
    ensure result == true
    return EasmOperandScan::is_aarch64_mrs_form("xzr", "cntvct_el0")

def bare_symbol_data_operands_are_rejected(operand_present: bool, memory_address: bool, register_operand: bool, immediate_operand: bool, direct_target: bool) -> bool:
    requires operand_present and not memory_address and not register_operand and not immediate_operand and not direct_target
    ensure result == true
    return operand_present and not memory_address and not register_operand and not immediate_operand and not direct_target

def direct_call_symbol_targets_are_exempt_from_data_operand_rejection(operand_present: bool, memory_address: bool, register_operand: bool, immediate_operand: bool, direct_target: bool) -> bool:
    requires operand_present and not memory_address and not register_operand and not immediate_operand and direct_target
    ensure result == false
    return operand_present and not memory_address and not register_operand and not immediate_operand and not direct_target

def register_immediate_and_address_operands_are_modeled(operand_present: bool, memory_address: bool, register_operand: bool, immediate_operand: bool, direct_target: bool) -> bool:
    requires operand_present and (memory_address or register_operand or immediate_operand)
    ensure result == false
    return operand_present and not memory_address and not register_operand and not immediate_operand and not direct_target

def immediate_return_operands_are_rejected(op: sview, immediate_operand: bool) -> bool:
    requires immediate_operand and (op == "ret" or op == "retq")
    ensure result == true
    return immediate_operand and (op == "ret" or op == "retq")

def conditional_jump_targets_require_local_labels_or_explicit_authorization(is_conditional_jump: bool, target_is_local: bool, direct_control_capability: bool, relocation_symbol_capability: bool) -> bool:
    ensure result == true
    return EasmOperandScan::rejects_unresolved_conditional_target(
        is_conditional_jump, target_is_local, direct_control_capability, relocation_symbol_capability
    ) == (
        is_conditional_jump and not target_is_local and
        not direct_control_capability and not relocation_symbol_capability
    )

def segment_address_is_not_an_exact_register_operand() -> bool:
    ensure result == true
    operand: sview = "%fs:0x28"
    register_name: sview = "fs"
    return not (
        (sview_len(operand) == sview_len(register_name) + EasmOperandScan::SCAN_STEP and
            sview_len(operand) > 0 and sview_at(operand, 0) == EasmOperandScan::ASCII_PERCENT and
            operand[EasmOperandScan::SCAN_STEP:sview_len(operand)] == register_name) or
        (sview_len(operand) == sview_len(register_name) + EasmOperandScan::INDIRECT_REGISTER_PREFIX_LENGTH and
            sview_len(operand) >= EasmOperandScan::INDIRECT_REGISTER_PREFIX_LENGTH and sview_at(operand, 0) == EasmOperandScan::ASCII_STAR and
            sview_at(operand, 1) == EasmOperandScan::ASCII_PERCENT and
            operand[EasmOperandScan::INDIRECT_REGISTER_PREFIX_LENGTH:sview_len(operand)] == register_name)
    )
