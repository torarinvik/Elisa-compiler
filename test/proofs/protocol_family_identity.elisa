# Model of a resolved family/state key. These laws assume canonical family IDs;
# they do not prove that Go's source-name qualification assigns those IDs correctly.
def same_state_key(left_family: u32, left_state: u32, right_family: u32, right_state: u32) -> bool:
    ensure result == (left_family == right_family and left_state == right_state)
    return left_family == right_family and left_state == right_state

def distinct_families_separate_states(left: u32, right: u32, left_state: u32, right_state: u32) -> bool:
    requires left != right
    ensure result == false
    return same_state_key(left, left_state, right, right_state)

def equal_state_ordinal_does_not_erase_family(left: u32, right: u32, state: u32) -> bool:
    requires left != right
    ensure result == false
    return same_state_key(left, state, right, state)

def distinct_states_in_one_family(family: u32, left: u32, right: u32) -> bool:
    requires left != right
    ensure result == false
    return same_state_key(family, left, family, right)

def identical_key_is_reflexive(family: u32, state: u32) -> bool:
    ensure result == true
    return same_state_key(family, state, family, state)
