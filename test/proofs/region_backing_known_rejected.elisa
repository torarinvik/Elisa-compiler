include "../../src/semantic/region_backing_known.elisa"

def arbitrary_strategy_is_known() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return RegionBackingKnown::is_known("bogus")

def supported_strategy_is_unknown() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not RegionBackingKnown::is_known("malloc")

def classifier_ignores_case() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return RegionBackingKnown::is_known("Malloc")
