include "./easm_checked_add_sub.elisa"

def false_positive_add_overflow_is_accepted(left: i64, right: i64) -> bool:
    requires left == I64_MAX and right == 1
    ensure result == true
    return not (right > 0 and left > I64_MAX - right)

def false_negative_add_overflow_is_accepted(left: i64, right: i64) -> bool:
    requires left == I64_MIN and right == (0 - 1)
    ensure result == true
    return not (right < 0 and left < I64_MIN - right)

def false_positive_sub_overflow_is_accepted(left: i64, right: i64) -> bool:
    requires left == I64_MIN and right == 1
    ensure result == true
    return not (right > 0 and left < I64_MIN + right)

def false_negative_sub_overflow_is_accepted(left: i64, right: i64) -> bool:
    requires left == I64_MAX and right == (0 - 1)
    ensure result == true
    return not (right < 0 and left > I64_MAX + right)
