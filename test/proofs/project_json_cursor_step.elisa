# Signed scalar model of one JSON whitespace scan step. The source checker binds
# this transition to json_skip_ws; usize-wide proof arithmetic is not yet admitted.
def json_skip_ws_step(length: i64, position: i64, is_space: bool) -> i64:
    requires length >= 0 and position >= 0 and position <= length
    ensure result == (position + 1 if position < length and is_space else position)
    ensure result >= 0
    ensure result <= length
    ensure result >= position
    ensure (position < length and is_space) implies result > position
    ensure (position < length and is_space) implies length - result == length - position - 1
    ensure (position == length or not is_space) implies result == position
    return position + 1 if position < length and is_space else position
