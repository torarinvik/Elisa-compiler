# False claims at adjacent byte values must remain unprovable.
include "../../src/driver/project.elisa"
include "./project_whitespace_control_bytes.elisa"

def vertical_tab_is_project_whitespace() -> bool:
    ensure result == true
    return ProjectSystem::bytes_is_space(ProjectWhitespaceControlByte::ASCII_VERTICAL_TAB)

def form_feed_is_project_whitespace() -> bool:
    ensure result == true
    return ProjectSystem::bytes_is_space(ProjectWhitespaceControlByte::ASCII_FORM_FEED)

def exclamation_mark_is_project_whitespace() -> bool:
    ensure result == true
    return ProjectSystem::bytes_is_space(ProjectWhitespaceControlByte::ASCII_EXCLAMATION_MARK)

def a_non_space_singleton_can_be_blank(byte: u8) -> bool:
    requires not ProjectSystem::bytes_is_space(byte)
    ensure result == true
    value: darray[u8] = [byte]
    return ProjectSystem::bytes_is_blank(value)

def blank_project_value_can_ignore_fallback(byte: u8) -> bool can[Memory.Allocate, Abort.Panic]:
    requires ProjectSystem::bytes_is_space(byte)
    ensure result == true
    value: darray[u8] = [byte]
    resolved: darray[u8] = ProjectSystem::bytes_or_default(value, "default")
    return resolved.count == 0

def trim_start_can_exceed_the_source_length(value: darray[u8]&) -> bool:
    ensure result == true
    return ProjectSystem::bytes_trim_start(value) > value.count

def trim_end_can_exceed_the_source_length(value: darray[u8]&) -> bool:
    ensure result == true
    return ProjectSystem::bytes_trim_end(value) > value.count

def trim_end_can_precede_trim_start(value: darray[u8]&) -> bool:
    ensure result == true
    return ProjectSystem::bytes_trim_end(value) < ProjectSystem::bytes_trim_start(value)

def trim_start_can_skip_a_non_whitespace_first_byte(value: darray[u8]&) -> bool:
    requires value.count > 0.usize() and not ProjectSystem::bytes_is_space(value[0.usize()])
    ensure result == true
    return ProjectSystem::bytes_trim_start(value) > 0.usize()

def trim_end_can_leave_a_non_whitespace_last_byte(value: darray[u8]&) -> bool:
    requires value.count > 0.usize() and not ProjectSystem::bytes_is_space(value[value.count - 1.usize()])
    ensure result == true
    return ProjectSystem::bytes_trim_end(value) < value.count

def a_nonblank_trimmed_value_can_lose_all_bytes(value: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    requires not ProjectSystem::bytes_is_blank(value)
    ensure result == true
    trimmed: darray[u8] = ProjectSystem::bytes_trimmed(value)
    return trimmed.count == 0.usize()
