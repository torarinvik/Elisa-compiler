# False claims at adjacent byte values must remain unprovable.
include "../../src/driver/project.elisa"
include "./project_whitespace_control_bytes.elisa"

def vertical_tab_is_project_whitespace() -> bool:
    ensure result == true
    return ProjectSystem::bytes_is_space(ProjectWhitespaceControlByte::ASCII_VERTICAL_TAB)

def form_feed_is_project_whitespace() -> bool:
    ensure result == true
    return ProjectSystem::bytes_is_space(ProjectWhitespaceControlByte::ASCII_FORM_FEED)

def exclamation_mark_is_project_whitespace() -> bool:
    ensure result == true
    return ProjectSystem::bytes_is_space(ProjectWhitespaceControlByte::ASCII_EXCLAMATION_MARK)

def a_non_space_singleton_can_be_blank(byte: u8) -> bool:
    requires not ProjectSystem::bytes_is_space(byte)
    ensure result == true
    value: darray[u8] = [byte]
    return ProjectSystem::bytes_is_blank(value)

def blank_project_value_can_ignore_fallback(byte: u8) -> bool can[Memory.Allocate, Abort.Panic]:
    requires ProjectSystem::bytes_is_space(byte)
    ensure result == true
    value: darray[u8] = [byte]
    resolved: darray[u8] = ProjectSystem::bytes_or_default(value, "default")
    return resolved.count == 0
