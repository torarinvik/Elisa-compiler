include "./foreign_enum_validator_name.elisa"

def capitalization_change_in_the_validator_suffix_is_accepted() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return ForeignEnumName::is_validator_of("Color__from_C", "Color")

def a_different_enum_prefix_is_accepted() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return ForeignEnumName::is_validator_of("Other__from_c", "Color")

def an_extra_suffix_byte_is_accepted() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return ForeignEnumName::is_validator_of("Color__from_cx", "Color")
