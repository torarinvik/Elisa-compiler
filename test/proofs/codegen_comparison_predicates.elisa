# Source-bound case proofs for backend comparison predicate selection.
const TOKEN_EQ_EQ: i64 = 86
const TOKEN_BANG_EQ: i64 = 87
const TOKEN_LT: i64 = 88
const TOKEN_LT_EQ: i64 = 90
const TOKEN_GT: i64 = 89
const TOKEN_GT_EQ: i64 = 91
def signed_eqeq_uses_llvm_32() -> bool:
    ensure result == true
    operator: i64 = TOKEN_EQ_EQ
    predicate: i64 = 32 if operator == TOKEN_EQ_EQ else -1
    return predicate == 32

def signed_bangeq_uses_llvm_33() -> bool:
    ensure result == true
    operator: i64 = TOKEN_BANG_EQ
    predicate: i64 = 33 if operator == TOKEN_BANG_EQ else -1
    return predicate == 33

def signed_lt_uses_llvm_40() -> bool:
    ensure result == true
    operator: i64 = TOKEN_LT
    predicate: i64 = 40 if operator == TOKEN_LT else -1
    return predicate == 40

def signed_lteq_uses_llvm_41() -> bool:
    ensure result == true
    operator: i64 = TOKEN_LT_EQ
    predicate: i64 = 41 if operator == TOKEN_LT_EQ else -1
    return predicate == 41

def signed_gt_uses_llvm_38() -> bool:
    ensure result == true
    operator: i64 = TOKEN_GT
    predicate: i64 = 38 if operator == TOKEN_GT else -1
    return predicate == 38

def signed_gteq_uses_llvm_39() -> bool:
    ensure result == true
    operator: i64 = TOKEN_GT_EQ
    predicate: i64 = 39 if operator == TOKEN_GT_EQ else -1
    return predicate == 39

def unsupported_integer_operator_has_no_predicate(operator: i64) -> bool:
    requires operator != TOKEN_EQ_EQ and operator != TOKEN_BANG_EQ and operator != TOKEN_LT and operator != TOKEN_LT_EQ and operator != TOKEN_GT and operator != TOKEN_GT_EQ
    ensure result == true
    predicate: i64 = -1 if operator != TOKEN_EQ_EQ and operator != TOKEN_BANG_EQ and operator != TOKEN_LT and operator != TOKEN_LT_EQ and operator != TOKEN_GT and operator != TOKEN_GT_EQ else 0
    return predicate == -1

def unsigned_predicate_40_maps_to_36() -> bool:
    ensure result == true
    predicate: i64 = 40
    resolved: i64 = 36 if predicate == 40 else (37 if predicate == 41 else (34 if predicate == 38 else (35 if predicate == 39 else predicate)))
    return resolved == 36

def unsigned_predicate_41_maps_to_37() -> bool:
    ensure result == true
    predicate: i64 = 41
    resolved: i64 = 36 if predicate == 40 else (37 if predicate == 41 else (34 if predicate == 38 else (35 if predicate == 39 else predicate)))
    return resolved == 37

def unsigned_predicate_38_maps_to_34() -> bool:
    ensure result == true
    predicate: i64 = 38
    resolved: i64 = 36 if predicate == 40 else (37 if predicate == 41 else (34 if predicate == 38 else (35 if predicate == 39 else predicate)))
    return resolved == 34

def unsigned_predicate_39_maps_to_35() -> bool:
    ensure result == true
    predicate: i64 = 39
    resolved: i64 = 36 if predicate == 40 else (37 if predicate == 41 else (34 if predicate == 38 else (35 if predicate == 39 else predicate)))
    return resolved == 35

def unsigned_predicate_32_passes_through() -> bool:
    ensure result == true
    predicate: i64 = 32
    resolved: i64 = 36 if predicate == 40 else (37 if predicate == 41 else (34 if predicate == 38 else (35 if predicate == 39 else predicate)))
    return resolved == 32

def unsigned_predicate_33_passes_through() -> bool:
    ensure result == true
    predicate: i64 = 33
    resolved: i64 = 36 if predicate == 40 else (37 if predicate == 41 else (34 if predicate == 38 else (35 if predicate == 39 else predicate)))
    return resolved == 33

def unsigned_predicate_negative_one_passes_through() -> bool:
    ensure result == true
    predicate: i64 = -1
    resolved: i64 = 36 if predicate == 40 else (37 if predicate == 41 else (34 if predicate == 38 else (35 if predicate == 39 else predicate)))
    return resolved == -1

def float_eqeq_uses_llvm_1() -> bool:
    ensure result == true
    operator: i64 = TOKEN_EQ_EQ
    predicate: i64 = 1 if operator == TOKEN_EQ_EQ else -1
    return predicate == 1

def float_bangeq_uses_llvm_14() -> bool:
    ensure result == true
    operator: i64 = TOKEN_BANG_EQ
    predicate: i64 = 14 if operator == TOKEN_BANG_EQ else -1
    return predicate == 14

def float_lt_uses_llvm_4() -> bool:
    ensure result == true
    operator: i64 = TOKEN_LT
    predicate: i64 = 4 if operator == TOKEN_LT else -1
    return predicate == 4

def float_lteq_uses_llvm_5() -> bool:
    ensure result == true
    operator: i64 = TOKEN_LT_EQ
    predicate: i64 = 5 if operator == TOKEN_LT_EQ else -1
    return predicate == 5

def float_gt_uses_llvm_2() -> bool:
    ensure result == true
    operator: i64 = TOKEN_GT
    predicate: i64 = 2 if operator == TOKEN_GT else -1
    return predicate == 2

def float_gteq_uses_llvm_3() -> bool:
    ensure result == true
    operator: i64 = TOKEN_GT_EQ
    predicate: i64 = 3 if operator == TOKEN_GT_EQ else -1
    return predicate == 3

def unsupported_float_operator_has_no_predicate(operator: i64) -> bool:
    requires operator != TOKEN_EQ_EQ and operator != TOKEN_BANG_EQ and operator != TOKEN_LT and operator != TOKEN_LT_EQ and operator != TOKEN_GT and operator != TOKEN_GT_EQ
    ensure result == true
    predicate: i64 = -1 if operator != TOKEN_EQ_EQ and operator != TOKEN_BANG_EQ and operator != TOKEN_LT and operator != TOKEN_LT_EQ and operator != TOKEN_GT and operator != TOKEN_GT_EQ else 0
    return predicate == -1
