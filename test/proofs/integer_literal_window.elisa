include "../../src/semantic/integer_literal_window.elisa"

def signed_value_fits_exactly_the_inclusive_window(value: i64, low: i64, high: i64) -> bool:
    ensure result == true
    return SemanticIntegerLiteral::value_fits_signed_window(value, low, high) == (value >= low and value <= high)

def lower_endpoint_is_included(low: i64, high: i64) -> bool:
    requires low <= high
    ensure result == true
    return SemanticIntegerLiteral::value_fits_signed_window(low, low, high)

def upper_endpoint_is_included(low: i64, high: i64) -> bool:
    requires low <= high
    ensure result == true
    return SemanticIntegerLiteral::value_fits_signed_window(high, low, high)

def every_interior_value_is_included(value: i64, low: i64, high: i64) -> bool:
    requires low <= value and value <= high
    ensure result == true
    return SemanticIntegerLiteral::value_fits_signed_window(value, low, high)

def every_value_below_the_window_is_rejected(value: i64, low: i64, high: i64) -> bool:
    requires value < low and low <= high
    ensure result == false
    return SemanticIntegerLiteral::value_fits_signed_window(value, low, high)

def every_value_above_the_window_is_rejected(value: i64, low: i64, high: i64) -> bool:
    requires high < value and low <= high
    ensure result == false
    return SemanticIntegerLiteral::value_fits_signed_window(value, low, high)
