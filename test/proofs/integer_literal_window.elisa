include "../../src/semantic/integer_literal_window.elisa"

def signed_value_fits_exactly_the_inclusive_window(value: i64, low: i64, high: i64) -> bool:
    ensure result == true
    return SemanticIntegerLiteral::value_fits_signed_window(value, low, high) == (value >= low and value <= high)

def lower_endpoint_is_included(low: i64, high: i64) -> bool:
    requires low <= high
    ensure result == true
    return SemanticIntegerLiteral::value_fits_signed_window(low, low, high)

def upper_endpoint_is_included(low: i64, high: i64) -> bool:
    requires low <= high
    ensure result == true
    return SemanticIntegerLiteral::value_fits_signed_window(high, low, high)

def every_interior_value_is_included(value: i64, low: i64, high: i64) -> bool:
    requires low <= value and value <= high
    ensure result == true
    return SemanticIntegerLiteral::value_fits_signed_window(value, low, high)

def every_value_below_the_window_is_rejected(value: i64, low: i64, high: i64) -> bool:
    requires value < low and low <= high
    ensure result == false
    return SemanticIntegerLiteral::value_fits_signed_window(value, low, high)

def every_value_above_the_window_is_rejected(value: i64, low: i64, high: i64) -> bool:
    requires high < value and low <= high
    ensure result == false
    return SemanticIntegerLiteral::value_fits_signed_window(value, low, high)

def a_missing_window_never_reports_overflow(window_found: bool, value_found: bool, value: i64, low: i64, high: i64) -> bool:
    requires not window_found
    ensure result == false
    return SemanticIntegerLiteral::value_is_outside_window_if_known(window_found, value_found, value, low, high)

def a_missing_literal_never_reports_overflow(window_found: bool, value_found: bool, value: i64, low: i64, high: i64) -> bool:
    requires window_found and not value_found
    ensure result == false
    return SemanticIntegerLiteral::value_is_outside_window_if_known(window_found, value_found, value, low, high)

def a_known_value_below_the_window_reports_overflow(value: i64, low: i64, high: i64) -> bool:
    requires value < low and low <= high
    ensure result == true
    return SemanticIntegerLiteral::value_is_outside_window_if_known(true, true, value, low, high)

def a_known_lower_endpoint_does_not_report_overflow(low: i64, high: i64) -> bool:
    requires low <= high
    ensure result == false
    return SemanticIntegerLiteral::value_is_outside_window_if_known(true, true, low, low, high)

def every_known_interior_value_does_not_report_overflow(value: i64, low: i64, high: i64) -> bool:
    requires low <= value and value <= high
    ensure result == false
    return SemanticIntegerLiteral::value_is_outside_window_if_known(true, true, value, low, high)

def a_known_upper_endpoint_does_not_report_overflow(low: i64, high: i64) -> bool:
    requires low <= high
    ensure result == false
    return SemanticIntegerLiteral::value_is_outside_window_if_known(true, true, high, low, high)

def a_known_value_above_the_window_reports_overflow(value: i64, low: i64, high: i64) -> bool:
    requires high < value and low <= high
    ensure result == true
    return SemanticIntegerLiteral::value_is_outside_window_if_known(true, true, value, low, high)
