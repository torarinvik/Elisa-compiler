include "./lexical_module_owner_policy.elisa"

def lookalike_prefix_is_a_lexical_ancestor() -> bool can[Abort.Panic]:
    ensure result == true
    return SemanticLexicalModuleOwnerPolicy::is_lexical("Ui", "UiKit::Widgets")

def one_colon_is_a_module_boundary() -> bool can[Abort.Panic]:
    ensure result == true
    return SemanticLexicalModuleOwnerPolicy::is_lexical("Outer", "Outer:Inner")

def empty_owner_is_not_lexically_visible() -> bool can[Abort.Panic]:
    ensure result == true
    return not SemanticLexicalModuleOwnerPolicy::is_lexical("", "Outer::Inner")
