# These final digits exceed the positive and negative i64 bounds.
include "./easm_checked_decimal_arithmetic.elisa"

def false_claim_positive_overflow_digit_is_guarded() -> bool:
    ensure result == true
    return 922337203685477580 < 922337203685477580 or (922337203685477580 == 922337203685477580 and 8 <= 7)

def false_claim_negative_underflow_digit_is_guarded() -> bool:
    ensure result == true
    return 0 - 922337203685477580 > 0 - 922337203685477580 or ((0 - 922337203685477580 == 0 - 922337203685477580) and 9 <= 8)
