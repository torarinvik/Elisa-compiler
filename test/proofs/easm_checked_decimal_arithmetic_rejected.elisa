# These final digits exceed the positive and negative i64 bounds.
include "./easm_checked_decimal_arithmetic.elisa"

def false_claim_positive_overflow_digit_is_guarded() -> bool:
    ensure result == true
    return I64_DECIMAL_BOUNDARY_PREFIX < I64_DECIMAL_BOUNDARY_PREFIX or (I64_DECIMAL_BOUNDARY_PREFIX == I64_DECIMAL_BOUNDARY_PREFIX and FIRST_POSITIVE_OVERFLOW_DIGIT <= MAX_POSITIVE_FINAL_DIGIT)

def false_claim_negative_underflow_digit_is_guarded() -> bool:
    ensure result == true
    return 0 - I64_DECIMAL_BOUNDARY_PREFIX > 0 - I64_DECIMAL_BOUNDARY_PREFIX or ((0 - I64_DECIMAL_BOUNDARY_PREFIX == 0 - I64_DECIMAL_BOUNDARY_PREFIX) and FIRST_NEGATIVE_UNDERFLOW_DIGIT <= MAX_NEGATIVE_FINAL_DIGIT)

def false_claim_positive_boundary_digit_eight_is_safe() -> bool:
    ensure result == true
    return I64_DECIMAL_BOUNDARY_PREFIX < I64_DECIMAL_BOUNDARY_PREFIX or (I64_DECIMAL_BOUNDARY_PREFIX == I64_DECIMAL_BOUNDARY_PREFIX and FIRST_POSITIVE_OVERFLOW_DIGIT <= MAX_POSITIVE_FINAL_DIGIT)

def false_claim_negative_boundary_digit_nine_is_safe() -> bool:
    ensure result == true
    return 0 - I64_DECIMAL_BOUNDARY_PREFIX > 0 - I64_DECIMAL_BOUNDARY_PREFIX or ((0 - I64_DECIMAL_BOUNDARY_PREFIX == 0 - I64_DECIMAL_BOUNDARY_PREFIX) and FIRST_NEGATIVE_UNDERFLOW_DIGIT <= MAX_NEGATIVE_FINAL_DIGIT)
