# Source-linked specification of the negative-index checker's closed type set.
include "../../src/semantic/negative_index_sequence_type.elisa"

def source_classifier_has_exact_sequence_set(type_name: sview) -> bool can[Abort.Panic]:
    ensure result == (
        when type_name:
            "darray" | "view" | "sview" -> true
            _ -> false
    )
    can Abort.Panic:
        return NegativeIndexSequenceType::is_sequence_type_name(type_name)

def all_supported_sequence_names_are_classified_as_sequences() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            NegativeIndexSequenceType::is_sequence_type_name("darray")
            and NegativeIndexSequenceType::is_sequence_type_name("view")
            and NegativeIndexSequenceType::is_sequence_type_name("sview")
        )

def dictionary_keys_remain_outside_sequence_negative_index_check() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not NegativeIndexSequenceType::is_sequence_type_name("dict")

def unrelated_named_types_remain_outside_sequence_negative_index_check() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            not NegativeIndexSequenceType::is_sequence_type_name("array")
            and not NegativeIndexSequenceType::is_sequence_type_name("set")
            and not NegativeIndexSequenceType::is_sequence_type_name("sviewx")
        )
