# This deliberately claims a substring decoy grants the raw-base exemption.
def substring_decoy_exempts_raw_memory_base(raw_scalar: bool, exact_untyped_opt_out: bool, substring_decoy: bool) -> bool:
    requires raw_scalar and not exact_untyped_opt_out and substring_decoy
    ensure result == false
    return raw_scalar and not exact_untyped_opt_out

def substring_register_decoy_is_a_declaration(exact_token: bool, exact_binding: bool, substring_decoy: bool) -> bool:
    requires not exact_token and not exact_binding and substring_decoy
    ensure result == true
    return exact_token or exact_binding

def terminal_scan_cursor_can_advance_within_view(index: usize) -> bool:
    requires index == 8
    ensure result == true
    return index + 1 <= 8
