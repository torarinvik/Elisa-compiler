# False path-extension and stem claims must remain unproved.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

def a_path_without_a_qualifying_dot_can_have_a_nonempty_extension(path: sview) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires path.len >= 0 and path.len.usize().i64() == path.len
    requires sview_find_last_byte(path, 46) <= sview_find_last_byte(path, 47) + 1
    ensure result == true
    return Fs::extension(path).len != 0

def a_qualifying_extension_can_omit_the_dot(path: sview) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires path.len >= 0 and path.len.usize().i64() == path.len
    requires sview_find_last_byte(path, 46) > sview_find_last_byte(path, 47) + 1
    ensure result == true
    return Fs::extension(path).len == path.len - sview_find_last_byte(path, 46) - 1

def a_stem_can_include_the_final_dot(path: sview) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires path.len >= 0 and path.len.usize().i64() == path.len
    requires sview_find_last_byte(path, 46) > sview_find_last_byte(path, 47) + 1
    ensure result == true
    return Fs::stem(path).len > sview_find_last_byte(path, 46) - (sview_find_last_byte(path, 47) + 1)

def a_malformed_path_can_have_a_nonempty_stem_or_extension(path: sview) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires path.len < 0 or path.len.usize().i64() != path.len
    ensure result == true
    return Fs::stem(path).len != 0 or Fs::extension(path).len != 0
