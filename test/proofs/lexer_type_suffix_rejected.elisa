# Each claim asks the production suffix grammar to accept an unsupported spelling.
include "../../src/lexer/lexer_type_suffix.elisa"

def unsupported_i_width_is_accepted() -> bool:
    ensure result == true
    return LexerTypeSuffix::is_valid_type_suffix("i34")

def unsupported_u_width_is_accepted() -> bool:
    ensure result == true
    return LexerTypeSuffix::is_valid_type_suffix("u128")

def uppercase_float_suffix_is_accepted() -> bool:
    ensure result == true
    return LexerTypeSuffix::is_valid_type_suffix("F32")

def suffixed_float_name_is_accepted() -> bool:
    ensure result == true
    return LexerTypeSuffix::is_valid_type_suffix("f32x")
