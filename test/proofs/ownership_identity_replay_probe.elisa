include "../../src/semantic/binding_identity_types.elisa"

def direct_unsigned_disequality(owner: u32) -> bool:
    requires owner != Semantic::INVALID_DECL_ID_VALUE
    ensure result == true
    return owner != Semantic::INVALID_DECL_ID_VALUE

def summarized_unsigned_disequality(owner: u32) -> bool:
    ensure result == (owner != Semantic::INVALID_DECL_ID_VALUE)
    return owner != Semantic::INVALID_DECL_ID_VALUE

def client_unsigned_disequality(owner: u32) -> bool:
    requires owner != Semantic::INVALID_DECL_ID_VALUE
    ensure result == true
    return summarized_unsigned_disequality(owner)
