def direct_unsigned_disequality(owner: u32) -> bool:
    requires owner != 4294967295
    ensure result == true
    return owner != 4294967295

def summarized_unsigned_disequality(owner: u32) -> bool:
    ensure result == (owner != 4294967295)
    return owner != 4294967295

def client_unsigned_disequality(owner: u32) -> bool:
    requires owner != 4294967295
    ensure result == true
    return summarized_unsigned_disequality(owner)
