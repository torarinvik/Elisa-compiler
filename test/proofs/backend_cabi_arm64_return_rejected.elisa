include "./backend_cabi_arm64_return.elisa"

def false_large_nonhfa_return_is_direct(size: i64, flat_ok: bool, hfa_count: i64) -> bool:
    requires size == 17 and flat_ok and hfa_count == 0
    ensure not result
    return size > 0 and (not flat_ok or (hfa_count == 0 and size > 16))

def false_large_hfa_return_uses_sret(size: i64, flat_ok: bool, hfa_count: i64) -> bool:
    requires size == 24 and flat_ok and hfa_count == 3
    ensure result
    return size > 0 and (not flat_ok or (hfa_count == 0 and size > 16))

def false_unflattenable_return_is_direct(flat_ok: bool) -> bool:
    requires not flat_ok
    ensure not result
    return not flat_ok
