# Out-of-domain declaration indices must remain inadmissible.
include "../../src/backend/easm_model.elisa"
include "../../src/backend/easm_parse_state_policy.elisa"

def function_index_equal_to_count_is_accepted() -> bool:
    ensure result == true
    return Easm::easm_declaration_index_valid(Easm::EasmDeclarationKind.Function, 2, 2, 0, 0, 0)

def fragment_negative_index_is_accepted() -> bool:
    ensure result == true
    return Easm::easm_declaration_index_valid(Easm::EasmDeclarationKind.Fragment, -1, 0, 2, 0, 0)

def protocol_index_equal_to_count_is_accepted() -> bool:
    ensure result == true
    return Easm::easm_declaration_index_valid(Easm::EasmDeclarationKind.Protocol, 1, 0, 0, 1, 0)

def template_index_in_empty_collection_is_accepted() -> bool:
    ensure result == true
    return Easm::easm_declaration_index_valid(Easm::EasmDeclarationKind.Template, 0, 0, 0, 0, 0)

def target_mode_without_active_target_is_valid() -> bool:
    ensure result == true
    return Easm::easm_body_routing_valid(Easm::EasmBodyMode.Target, Easm::EasmDeclarationKind.Function, -1)

def reference_mode_with_protocol_owner_is_valid() -> bool:
    ensure result == true
    return Easm::easm_body_routing_valid(Easm::EasmBodyMode.Reference, Easm::EasmDeclarationKind.Protocol, -1)

def target_mode_with_fragment_owner_is_valid() -> bool:
    ensure result == true
    return Easm::easm_body_routing_valid(Easm::EasmBodyMode.Target, Easm::EasmDeclarationKind.Fragment, 0)

def reversed_source_span_is_valid() -> bool:
    ensure result == true
    return Easm::easm_source_span_valid(2.usize(), 1.usize(), 2.usize(), 2.usize())

def source_span_past_end_is_valid() -> bool:
    ensure result == true
    return Easm::easm_source_span_valid(0.usize(), 3.usize(), 2.usize(), 3.usize())
