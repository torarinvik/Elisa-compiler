# Selection-policy model: assumes the resolver supplied canonical IDs. It does
# not prove parser resolution, predicate evaluation or constructor traversal.
def rule_applies(known: bool, protocol: bool, same_family: bool, same_state: bool) -> bool:
    ensure result == (known and not protocol and same_family and same_state)
    return known and not protocol and same_family and same_state

def unknown_family_blocks_rule(protocol: bool, same_family: bool, same_state: bool) -> bool:
    ensure result == false
    return rule_applies(false, protocol, same_family, same_state)

def protocol_cannot_borrow_predicate(known: bool, same_family: bool, same_state: bool) -> bool:
    ensure result == false
    return rule_applies(known, true, same_family, same_state)

def same_spelling_cannot_merge_families(known: bool, protocol: bool) -> bool:
    ensure result == false
    return rule_applies(known, protocol, false, true)

def other_state_cannot_supply_predicate(known: bool, protocol: bool, same_family: bool) -> bool:
    ensure result == false
    return rule_applies(known, protocol, same_family, false)

def exact_derived_key_selects_rule() -> bool:
    ensure result == true
    return rule_applies(true, false, true, true)
