# Abstract proof model for the indexed predecessor used by check_try_fallible.
# The checker binds the filtered sorted array, binary-search branches, and fallback
# to the production implementation; this model proves the predecessor-selection law.
const TRY_ENCLOSING_NO_OFFSET: u32 = 0
const TRY_ENCLOSING_FIRST_POSITION: usize = 0
const TRY_ENCLOSING_POSITION_STEP: usize = 1
const TRY_ENCLOSING_BINARY_DIVISOR: usize = 2
const TRY_ENCLOSING_SECOND_POSITION: usize = TRY_ENCLOSING_FIRST_POSITION + TRY_ENCLOSING_POSITION_STEP
const TRY_ENCLOSING_DUPLICATE_OFFSET: u32 = 9
const TRY_ENCLOSING_FIRST_LINE: u32 = 11
const TRY_ENCLOSING_SECOND_LINE: u32 = 22

def try_offsets_are_nonzero(offsets: darray[u32]) -> bool:
    ensure result == (forall position in TRY_ENCLOSING_FIRST_POSITION..<offsets.count:
        offsets[position] != TRY_ENCLOSING_NO_OFFSET)
    return forall position in TRY_ENCLOSING_FIRST_POSITION..<offsets.count: offsets[position] != TRY_ENCLOSING_NO_OFFSET

def try_offsets_are_nondecreasing(offsets: darray[u32]) -> bool:
    ensure result == (forall left in TRY_ENCLOSING_FIRST_POSITION..<offsets.count:
        forall right in left..<offsets.count: offsets[left] <= offsets[right])
    return forall left in TRY_ENCLOSING_FIRST_POSITION..<offsets.count: forall right in left..<offsets.count: offsets[left] <= offsets[right]

def try_predecessor_is_last(offsets: darray[u32], query: u32, found: bool, index: usize) -> bool:
    ensure result == (
        (found
            and index < offsets.count
            and offsets[index] != TRY_ENCLOSING_NO_OFFSET
            and offsets[index] <= query
            and (forall later in index + TRY_ENCLOSING_POSITION_STEP..<offsets.count:
                offsets[later] == TRY_ENCLOSING_NO_OFFSET or offsets[later] > query))
        or
        (not found
            and index == TRY_ENCLOSING_FIRST_POSITION
            and (forall candidate in TRY_ENCLOSING_FIRST_POSITION..<offsets.count:
                offsets[candidate] == TRY_ENCLOSING_NO_OFFSET or offsets[candidate] > query))
    )
    return (
        (found
            and index < offsets.count
            and offsets[index] != TRY_ENCLOSING_NO_OFFSET
            and offsets[index] <= query
            and (forall later in index + TRY_ENCLOSING_POSITION_STEP..<offsets.count:
                offsets[later] == TRY_ENCLOSING_NO_OFFSET or offsets[later] > query))
        or
        (not found
            and index == TRY_ENCLOSING_FIRST_POSITION
            and (forall candidate in TRY_ENCLOSING_FIRST_POSITION..<offsets.count:
                offsets[candidate] == TRY_ENCLOSING_NO_OFFSET or offsets[candidate] > query))
    )

def try_linear_predecessor(offsets: darray[u32], query: u32) -> (found: bool, index: usize):
    ensure try_predecessor_is_last(offsets, query, result.found, result.index)
    index: mutable usize = TRY_ENCLOSING_FIRST_POSITION
    found: mutable bool = false
    selected: mutable usize = TRY_ENCLOSING_FIRST_POSITION
    while index < offsets.count |index, found, selected, offsets, query|:
        decreases offsets.count - index
        invariant index <= offsets.count
        invariant found implies (
            selected < index
            and offsets[selected] != TRY_ENCLOSING_NO_OFFSET
            and offsets[selected] <= query
            and (forall later in selected + TRY_ENCLOSING_POSITION_STEP..<index:
                offsets[later] == TRY_ENCLOSING_NO_OFFSET or offsets[later] > query)
        )
        invariant found or (
            forall prior in TRY_ENCLOSING_FIRST_POSITION..<index:
                offsets[prior] == TRY_ENCLOSING_NO_OFFSET or offsets[prior] > query
        )
        if offsets[index] != TRY_ENCLOSING_NO_OFFSET and offsets[index] <= query:
            found <- true
            selected <- index
        index <- index + TRY_ENCLOSING_POSITION_STEP
    return (found, selected)

def try_binary_predecessor(offsets: darray[u32], query: u32) -> (found: bool, index: usize):
    requires try_offsets_are_nonzero(offsets)
    requires try_offsets_are_nondecreasing(offsets)
    ensure try_predecessor_is_last(offsets, query, result.found, result.index)
    low: mutable usize = TRY_ENCLOSING_FIRST_POSITION
    high: mutable usize = offsets.count
    while low < high |low, high, offsets, query|:
        decreases high - low
        invariant low <= high
        invariant high <= offsets.count
        invariant forall prior in TRY_ENCLOSING_FIRST_POSITION..<low: offsets[prior] <= query
        invariant forall later in high..<offsets.count: offsets[later] > query
        middle: usize = low + (high - low) / TRY_ENCLOSING_BINARY_DIVISOR
        if offsets[middle] <= query:
            low <- middle + TRY_ENCLOSING_POSITION_STEP
        else:
            high <- middle
    if low > TRY_ENCLOSING_FIRST_POSITION:
        return (true, low - TRY_ENCLOSING_POSITION_STEP)
    return (false, TRY_ENCLOSING_FIRST_POSITION)

def last_predecessor_results_are_unique(
    offsets: darray[u32],
    query: u32,
    left_found: bool,
    left_index: usize,
    right_found: bool,
    right_index: usize
) -> bool:
    requires try_predecessor_is_last(offsets, query, left_found, left_index)
    requires try_predecessor_is_last(offsets, query, right_found, right_index)
    ensure result == true
    ensure left_found == right_found and left_index == right_index
    return left_found == right_found and left_index == right_index

def sorted_binary_predecessor_equals_linear_reference(offsets: darray[u32], query: u32) -> bool:
    requires try_offsets_are_nonzero(offsets)
    requires try_offsets_are_nondecreasing(offsets)
    ensure result == true
    ensure try_binary_predecessor(offsets, query) == try_linear_predecessor(offsets, query)
    linear: (found: bool, index: usize) = try_linear_predecessor(offsets, query)
    indexed: (found: bool, index: usize) = try_binary_predecessor(offsets, query)
    return last_predecessor_results_are_unique(offsets, query, linear.found, linear.index, indexed.found, indexed.index)

def duplicate_offsets_select_the_last_qualifying_position() -> bool:
    ensure result == true
    offsets: darray[u32] = [TRY_ENCLOSING_DUPLICATE_OFFSET, TRY_ENCLOSING_DUPLICATE_OFFSET]
    indexed: (found: bool, index: usize) = try_binary_predecessor(offsets, TRY_ENCLOSING_DUPLICATE_OFFSET)
    return indexed.found and indexed.index == TRY_ENCLOSING_SECOND_POSITION

def sorted_binary_predecessor_preserves_parallel_line_mapping(offsets: darray[u32], lines: darray[u32], query: u32) -> bool:
    requires offsets.count == lines.count
    requires try_offsets_are_nonzero(offsets)
    requires try_offsets_are_nondecreasing(offsets)
    ensure result == true
    ensure sorted_binary_predecessor_equals_linear_reference(offsets, query)
    linear: (found: bool, index: usize) = try_linear_predecessor(offsets, query)
    indexed: (found: bool, index: usize) = try_binary_predecessor(offsets, query)
    if indexed.found:
        return indexed == linear and lines[indexed.index] == lines[linear.index] and offsets[indexed.index] == offsets[linear.index]
    return not linear.found and indexed.index == linear.index

def empty_index_reports_no_predecessor() -> bool:
    ensure result == true
    offsets: darray[u32] = []
    indexed: (found: bool, index: usize) = try_binary_predecessor(offsets, TRY_ENCLOSING_NO_OFFSET)
    return not indexed.found and indexed.index == TRY_ENCLOSING_FIRST_POSITION

def sorted_index_without_a_predecessor_reports_fallback_case(offsets: darray[u32], query: u32) -> bool:
    requires try_offsets_are_nonzero(offsets)
    requires try_offsets_are_nondecreasing(offsets)
    requires offsets.count == TRY_ENCLOSING_FIRST_POSITION or offsets[TRY_ENCLOSING_FIRST_POSITION] > query
    ensure result == true
    indexed: (found: bool, index: usize) = try_binary_predecessor(offsets, query)
    linear: (found: bool, index: usize) = try_linear_predecessor(offsets, query)
    return not indexed.found and indexed.index == TRY_ENCLOSING_FIRST_POSITION and indexed == linear
