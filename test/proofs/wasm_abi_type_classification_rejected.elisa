include "./wasm_abi_type_classification.elisa"

def nullable_scalar_must_not_receive_an_abi_type() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        actual: (binding: sview, wasm_type: sview) = WasmAbiTypeClassification::classify("i32?", false)
        return actual.binding == "scalar" and actual.wasm_type == "i32"

def unknown_non_component_type_must_not_become_scalar() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        actual: (binding: sview, wasm_type: sview) = WasmAbiTypeClassification::classify("Widget", false)
        return actual.binding == "scalar" and actual.wasm_type == "i32"

def cstr_must_not_use_the_pointer_binding() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        actual: (binding: sview, wasm_type: sview) = WasmAbiTypeClassification::classify("cstr", false)
        return actual.binding == "pointer" and actual.wasm_type == "i32"
