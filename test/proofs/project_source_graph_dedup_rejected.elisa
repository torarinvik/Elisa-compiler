# These false claims would either duplicate a known path or store an invalid edge.
include "./project_source_graph_dedup.elisa"

def a_found_path_returns_the_append_sentinel(matches: darray[bool]&) -> bool:
    requires matches.count > 0.usize() and matches[0.usize()]
    ensures result == true
    return first_matching_source_row(matches) == matches.count

def a_missing_path_does_not_grow_the_file_table(matches: darray[bool]&) -> bool:
    requires forall candidate in 0..<matches.count: not matches[candidate]
    requires matches.count < 18446744073709551615.usize()
    ensures result == true
    slot: usize = first_matching_source_row(matches)
    registration: (files_after: usize, edge_target: usize) = target_registration_after_lookup(matches.count, slot)
    return registration.files_after == matches.count

def an_edge_to_a_new_path_is_out_of_bounds(matches: darray[bool]&) -> bool:
    requires forall candidate in 0..<matches.count: not matches[candidate]
    requires matches.count < 18446744073709551615.usize()
    ensures result == true
    slot: usize = first_matching_source_row(matches)
    registration: (files_after: usize, edge_target: usize) = target_registration_after_lookup(matches.count, slot)
    return registration.edge_target >= registration.files_after
