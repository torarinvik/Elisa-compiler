# False claims that exercise every rejection guard at the raw-pointer boundary.
def accepted_source_span_can_exceed_remaining_bytes(start: usize, end: usize, source_length: usize) -> bool:
    requires source_view_guard_accepts(start, end, source_length)
    ensure result == true
    return end - start > source_length - start

def bounded_token_text_end_can_exceed_source(start: usize, length: usize, source_length: usize) -> bool:
    requires start <= source_length
    requires length <= source_length - start
    ensure result == true
    return start + length > source_length

def bounded_token_suffix_end_can_exceed_source(start: usize, length: usize, suffix_length: usize, source_length: usize) -> bool:
    requires start <= source_length
    requires length <= source_length - start
    requires suffix_length <= source_length - (start + length)
    ensure result == true
    return start + length + suffix_length > source_length

def incremental_byte_span_nonempty_range_can_be_rejected(start: usize, length: usize, source_length: usize) -> bool:
    requires start <= source_length
    requires length > 0
    requires length <= source_length - start
    ensure result == true
    return not source_view_guard_accepts(start, start + length, source_length)

def incremental_byte_span_empty_range_can_be_admitted(start: usize, source_length: usize) -> bool:
    requires start <= source_length
    ensure result == true
    return source_view_guard_accepts(start, start, source_length)

def incremental_nonempty_byte_span_can_have_no_index_zero(start: usize, length: usize, source_length: usize) -> bool:
    requires start <= source_length
    requires length > 0
    requires length <= source_length - start
    ensure result == true
    return source_length == 0

def token_self_bound_guarantees_backing_extent(requested_end: usize, token_end: usize, backing_length: usize) -> bool:
    requires requested_end == token_end and token_end > backing_length
    ensure result == true
    return requested_end <= backing_length

def empty_source_span_can_be_admitted(start: usize, source_length: usize) -> bool:
    ensure result == true
    return not (start > start or start > source_length) and not (start <= start)

def reversed_source_span_can_be_admitted(start: usize, end: usize, source_length: usize) -> bool:
    requires start > end
    ensure result == true
    return not (start > end or end > source_length) and not (end <= start)

def source_span_past_end_can_be_admitted(start: usize, end: usize, source_length: usize) -> bool:
    requires end > source_length
    ensure result == true
    return not (start > end or end > source_length) and not (end <= start)
