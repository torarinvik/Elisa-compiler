include "../../src/semantic/generic_extern_index_policy.elisa"

def production_scan_matches_recursive_specification(names: darray[sview]&, target_name: sview) -> bool:
    ensure result == true
    return SemanticGenericExternIndexPolicy::contains(names, target_name) ==
        SemanticGenericExternIndexPolicy::contains_from(names, target_name, 0)

def empty_registry_has_no_generic_extern() -> bool:
    ensure result == true
    names: darray[sview] = []
    return not SemanticGenericExternIndexPolicy::contains(names, "va_arg")

def generic_extern_at_the_last_position_is_found() -> bool:
    ensure result == true
    names: darray[sview] = ["type_id", "va_list", "va_arg"]
    return SemanticGenericExternIndexPolicy::contains(names, "va_arg")

def absent_name_is_not_a_generic_extern() -> bool:
    ensure result == true
    names: darray[sview] = ["type_id", "va_list"]
    return not SemanticGenericExternIndexPolicy::contains(names, "va_arg")

def duplicate_registry_rows_preserve_membership() -> bool:
    ensure result == true
    names: darray[sview] = ["va_arg", "va_arg"]
    return SemanticGenericExternIndexPolicy::contains(names, "va_arg")
