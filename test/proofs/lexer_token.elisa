include "./lexer_token_proof_model.elisa"

def token_span_preserves_line(line: u32, column: u32, start: u32, length: u32, suffix_length: u16) -> bool:
    ensure result == true
    span: Lexer::TokenSpan = Lexer::token_span_fields(line, column, start, length, suffix_length)
    return span.line == line

def token_span_preserves_column(line: u32, column: u32, start: u32, length: u32, suffix_length: u16) -> bool:
    ensure result == true
    span: Lexer::TokenSpan = Lexer::token_span_fields(line, column, start, length, suffix_length)
    return span.column == column

def token_span_preserves_start(line: u32, column: u32, start: u32, length: u32, suffix_length: u16) -> bool:
    ensure result == true
    span: Lexer::TokenSpan = Lexer::token_span_fields(line, column, start, length, suffix_length)
    return span.start == start

def token_span_preserves_text_length(line: u32, column: u32, start: u32, length: u32, suffix_length: u16) -> bool:
    ensure result == true
    span: Lexer::TokenSpan = Lexer::token_span_fields(line, column, start, length, suffix_length)
    return span.length == length

def token_span_preserves_suffix_length(line: u32, column: u32, start: u32, length: u32, suffix_length: u16) -> bool:
    ensure result == true
    span: Lexer::TokenSpan = Lexer::token_span_fields(line, column, start, length, suffix_length)
    return span.suffix_length == suffix_length
