# False control: a hash-bucket collision with another callee is not a cache hit.
include "./param_growth_summary_key_identity.elisa"

def pgs_hash_alone_is_enough_for_cache_hit(hash_bucket_matches: bool, callee_matches: bool, tag_matches: bool) -> bool:
    requires hash_bucket_matches
    requires not callee_matches
    ensure result == true
    return pgs_exact_pair_match(hash_bucket_matches, callee_matches, tag_matches)

def pgs_empty_callee_still_has_a_queryable_key(callee_is_present: bool, tag_is_present: bool) -> bool:
    requires not callee_is_present
    ensure result == true
    return pgs_key_is_eligible(callee_is_present, tag_is_present)
