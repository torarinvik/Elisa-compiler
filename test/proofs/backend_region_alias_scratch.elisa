# The fallback region-analysis graph occupies the first slot after recorded facts
# and restores the caller's selected graph slot after the body scan.

def fallback_graph_slot_is_disjoint_from_every_fact(fact_count: usize, fact_slot: usize, scratch_slot: usize) -> bool:
    requires fact_slot < fact_count
    requires scratch_slot == fact_count
    ensure result == true
    return fact_slot < scratch_slot

def fallback_restores_the_previous_graph_slot(previous_slot: usize, restored_slot: usize) -> bool:
    requires restored_slot == previous_slot
    ensure result == true
    return restored_slot == previous_slot

