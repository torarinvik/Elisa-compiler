# Source-linked proof of the exact self-assignment operator and identifier rule.
include "./parser_token_kind_projection.elisa"
include "../../src/semantic/self_assignment_policy.elisa"

def source_operator_match_is_exact(operator: Lexer::TokenKind) -> bool:
    ensure result == (operator == Lexer::TokenKind.LArrow)
    return SelfAssignmentPolicy::is_mutation_operator(operator)

def source_policy_matches_the_operator_and_name_condition(
    operator: Lexer::TokenKind,
    target_name: sview,
    value_name: sview
) -> bool:
    ensure result == true
    return SelfAssignmentPolicy::should_report(operator, target_name, value_name) == (
        operator == Lexer::TokenKind.LArrow and target_name == value_name
    )

def mutation_of_the_same_name_is_reported() -> bool:
    ensure result == true
    return SelfAssignmentPolicy::should_report(Lexer::TokenKind.LArrow, "value", "value")

def mutation_of_a_different_name_is_not_reported() -> bool:
    ensure result == true
    return not SelfAssignmentPolicy::should_report(Lexer::TokenKind.LArrow, "left", "right")

def a_new_binding_of_the_same_name_is_not_reported() -> bool:
    ensure result == true
    return not SelfAssignmentPolicy::should_report(Lexer::TokenKind.Assign, "value", "value")

def another_operator_on_the_same_name_is_not_reported() -> bool:
    ensure result == true
    return not SelfAssignmentPolicy::should_report(Lexer::TokenKind.Plus, "value", "value")
