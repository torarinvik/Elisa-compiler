def an_unmatched_probe_clears_a_previous_match(previously_found: bool) -> bool:
    requires previously_found
    ensure result == false
    return previously_found or false

def a_matching_probe_preserves_the_earlier_position(previous_position: usize,
    current_probe: usize) -> bool:
    requires previous_position < current_probe
    ensure result == true
    return current_probe == previous_position
