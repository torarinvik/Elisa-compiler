# Source-linked proof of the exact default-parameter reference diagnostic predicate.
include "../../src/semantic/default_param_ref_policy.elisa"

def default_param_ref_report_predicate_is_exact(owner: sview, name: sview, name_is_indexed: bool) -> bool:
    ensure result == (owner == "__default_param_ref" and name != "" and not name_is_indexed)
    return DefaultParamRefPolicy::should_report(owner, name, name_is_indexed)

def unresolved_default_parameter_name_is_reported() -> bool:
    ensure result == true
    return DefaultParamRefPolicy::should_report("__default_param_ref", "x", false)

def globally_indexed_name_is_not_reported() -> bool:
    ensure result == true
    return not DefaultParamRefPolicy::should_report("__default_param_ref", "global_value", true)

def empty_reference_name_is_not_reported() -> bool:
    ensure result == true
    return not DefaultParamRefPolicy::should_report("__default_param_ref", "", false)

def other_annotation_owner_is_not_reported() -> bool:
    ensure result == true
    return not DefaultParamRefPolicy::should_report("ordinary_annotation", "x", false)
