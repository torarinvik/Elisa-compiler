# Source-linked result law for growing a container during a nested local-region allocation.

def outer_growth_escape_result_is_exact(growth_found: bool,
    receiver_is_named: bool,
    active_local_region_exists: bool,
    owner_region_is_known: bool,
    owner_is_active_region: bool,
    owner_is_on_region_stack: bool,
    owner_is_region_parameter: bool,
    receiver_is_outer_local: bool,
    receiver_is_mutable_global: bool) -> bool:
    ensure result == (growth_found and receiver_is_named and active_local_region_exists and
        ((owner_region_is_known and not owner_is_active_region and
            (owner_is_on_region_stack or owner_is_region_parameter)) or
         (not owner_region_is_known and (receiver_is_outer_local or receiver_is_mutable_global))))
    return (growth_found and receiver_is_named and active_local_region_exists and
        ((owner_region_is_known and not owner_is_active_region and
            (owner_is_on_region_stack or owner_is_region_parameter)) or
         (not owner_region_is_known and (receiver_is_outer_local or receiver_is_mutable_global))))

def growing_a_container_in_its_active_region_is_safe() -> bool:
    ensure result == false
    return outer_growth_escape_result_is_exact(true, true, true, true, true, true, false, false, false)

def growth_through_an_enclosing_region_owner_is_an_escape() -> bool:
    ensure result == true
    return outer_growth_escape_result_is_exact(true, true, true, true, false, true, false, false, false)

def growth_through_a_caller_region_parameter_is_an_escape() -> bool:
    ensure result == true
    return outer_growth_escape_result_is_exact(true, true, true, true, false, false, true, false, false)

def unknown_sibling_owner_is_not_misreported_as_an_ancestor_escape() -> bool:
    ensure result == false
    return outer_growth_escape_result_is_exact(true, true, true, true, false, false, false, false, false)

def unannotated_outer_local_growth_is_an_escape() -> bool:
    ensure result == true
    return outer_growth_escape_result_is_exact(true, true, true, false, false, false, false, true, false)

def unannotated_mutable_global_growth_is_an_escape() -> bool:
    ensure result == true
    return outer_growth_escape_result_is_exact(true, true, true, false, false, false, false, false, true)

def unannotated_local_container_growth_is_not_an_outer_escape() -> bool:
    ensure result == false
    return outer_growth_escape_result_is_exact(true, true, true, false, false, false, false, false, false)

def growth_without_an_active_region_is_not_an_outer_growth_escape() -> bool:
    ensure result == false
    return outer_growth_escape_result_is_exact(true, true, false, true, false, true, false, true, false)

def outer_growth_diagnostic_gate_is_exact(outer_growth_found: bool,
    receiver_is_region_arena_value: bool) -> bool:
    ensure result == (outer_growth_found and not receiver_is_region_arena_value)
    return outer_growth_found and not receiver_is_region_arena_value

def detected_outer_growth_on_non_arena_receiver_emits_diagnostic() -> bool:
    ensure result == true
    return outer_growth_diagnostic_gate_is_exact(true, false)

def arena_value_receiver_skips_outer_growth_diagnostic() -> bool:
    ensure result == false
    return outer_growth_diagnostic_gate_is_exact(true, true)

def missing_outer_growth_skips_growth_diagnostic() -> bool:
    ensure result == false
    return outer_growth_diagnostic_gate_is_exact(false, false)
