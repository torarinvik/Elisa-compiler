# Source-linked laws for the early forwarded-reference escape paths.

def forwarded_reference_escape_guard_is_exact(target_is_global_mutable: bool,
    target_is_field: bool,
    target_root_is_ref_param: bool,
    value_is_ref_param: bool,
    value_is_container_call: bool) -> bool:
    ensure result == ((target_is_global_mutable and value_is_ref_param) or
        (target_is_field and target_root_is_ref_param and value_is_ref_param) or
        (target_is_field and target_root_is_ref_param and value_is_container_call))
    return ((target_is_global_mutable and value_is_ref_param) or
        (target_is_field and target_root_is_ref_param and value_is_ref_param) or
        (target_is_field and target_root_is_ref_param and value_is_container_call))

def forwarded_reference_to_mutable_global_is_an_escape() -> bool:
    ensure result == true
    return forwarded_reference_escape_guard_is_exact(true, false, false, true, false)

def forwarded_reference_to_caller_owned_field_is_an_escape() -> bool:
    ensure result == true
    return forwarded_reference_escape_guard_is_exact(false, true, true, true, false)

def owned_container_call_to_caller_owned_field_is_an_escape() -> bool:
    ensure result == true
    return forwarded_reference_escape_guard_is_exact(false, true, true, false, true)

def whole_binding_store_does_not_take_caller_field_guard() -> bool:
    ensure result == false
    return forwarded_reference_escape_guard_is_exact(false, false, true, true, true)

def unrelated_field_store_does_not_take_caller_field_guard() -> bool:
    ensure result == false
    return forwarded_reference_escape_guard_is_exact(false, true, false, true, true)
