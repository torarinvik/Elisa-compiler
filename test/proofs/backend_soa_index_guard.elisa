# Row membership uses the signed source index plus an unsigned count comparison.
# The source checker binds this model to rows.valid and the SoA element GEP paths.
def soa_valid_guard(source_is_signed: bool, index_nonnegative: bool, unsigned_in_bounds: bool) -> bool:
    ensure result == (unsigned_in_bounds and (not source_is_signed or index_nonnegative))
    return unsigned_in_bounds and (not source_is_signed or index_nonnegative)

def signed_negative_row_is_rejected(unsigned_in_bounds: bool) -> bool:
    ensure result == true
    return not soa_valid_guard(true, false, unsigned_in_bounds)

def nonnegative_signed_row_keeps_count_result(unsigned_in_bounds: bool) -> bool:
    ensure result == true
    return soa_valid_guard(true, true, unsigned_in_bounds) == unsigned_in_bounds

def unsigned_row_uses_count_result(index_nonnegative: bool, unsigned_in_bounds: bool) -> bool:
    ensure result == true
    return soa_valid_guard(false, index_nonnegative, unsigned_in_bounds) == unsigned_in_bounds
