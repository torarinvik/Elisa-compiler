# Source-linked proof of the semantic primitive-name and bit-width spelling policy.
include "../../src/semantic/primitive_type_name_policy.elisa"

def bit_width_spelling_matches_the_exact_lexical_spec(name: sview) -> bool:
    ensure result == true
    can Abort.Panic:
        return SemanticPrimitiveTypeName::is_bit_width_int(name) == (
            name.len >= SemanticPrimitiveTypeName::MIN_INT_NAME_LENGTH and
            (name[SemanticPrimitiveTypeName::INT_LEAD_INDEX] == SemanticPrimitiveTypeName::ASCII_LOWER_I or
                name[SemanticPrimitiveTypeName::INT_LEAD_INDEX] == SemanticPrimitiveTypeName::ASCII_LOWER_U) and
            (forall digit_index in 0..<name.len:
                digit_index < SemanticPrimitiveTypeName::INT_PREFIX_LENGTH or
                    SemanticPrimitiveTypeName::is_ascii_digit(name[digit_index]))
        )

def primitive_classifier_matches_its_closed_match_contract(name: sview) -> bool:
    ensure result == true
    can Abort.Panic:
        return SemanticPrimitiveTypeName::is_primitive_type(name) == (when name:
            "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" | "f32" | "f64" | "bool" | "char" | "void" | "cstr" | "dstr" | "sview" | "bitset" | "bitfield" -> true
            _ -> SemanticPrimitiveTypeName::is_bit_width_int(name)
        )

def builtin_scalar_name_classifier_matches_closed_match_contract(name: sview) -> bool:
    ensure result == true
    can Abort.Panic:
        return SemanticPrimitiveTypeName::is_builtin_scalar_type_name(name) == (when name:
            "i8" | "i16" | "i32" | "i64" | "int" | "isize" | "u8" | "u16" | "u32" | "u64" | "usize" | "uintptr" | "f16" | "f32" | "f64" | "bool" | "char" -> true
            _ -> SemanticPrimitiveTypeName::is_bit_width_int(name)
        )

def every_fixed_builtin_scalar_head_is_recognized() -> bool:
    ensure result == true
    can Abort.Panic:
        return (
            SemanticPrimitiveTypeName::is_builtin_scalar_type_name("i8") and
            SemanticPrimitiveTypeName::is_builtin_scalar_type_name("i16") and
            SemanticPrimitiveTypeName::is_builtin_scalar_type_name("i32") and
            SemanticPrimitiveTypeName::is_builtin_scalar_type_name("i64") and
            SemanticPrimitiveTypeName::is_builtin_scalar_type_name("int") and
            SemanticPrimitiveTypeName::is_builtin_scalar_type_name("isize") and
            SemanticPrimitiveTypeName::is_builtin_scalar_type_name("u8") and
            SemanticPrimitiveTypeName::is_builtin_scalar_type_name("u16") and
            SemanticPrimitiveTypeName::is_builtin_scalar_type_name("u32") and
            SemanticPrimitiveTypeName::is_builtin_scalar_type_name("u64") and
            SemanticPrimitiveTypeName::is_builtin_scalar_type_name("usize") and
            SemanticPrimitiveTypeName::is_builtin_scalar_type_name("uintptr") and
            SemanticPrimitiveTypeName::is_builtin_scalar_type_name("f16") and
            SemanticPrimitiveTypeName::is_builtin_scalar_type_name("f32") and
            SemanticPrimitiveTypeName::is_builtin_scalar_type_name("f64") and
            SemanticPrimitiveTypeName::is_builtin_scalar_type_name("bool") and
            SemanticPrimitiveTypeName::is_builtin_scalar_type_name("char")
        )

def arbitrary_width_builtin_scalar_function_names_are_recognized() -> bool:
    ensure result == true
    can Abort.Panic:
        return (
            SemanticPrimitiveTypeName::is_builtin_scalar_type_name("i1") and
            SemanticPrimitiveTypeName::is_builtin_scalar_type_name("u0") and
            SemanticPrimitiveTypeName::is_builtin_scalar_type_name("i999") and
            SemanticPrimitiveTypeName::is_builtin_scalar_type_name("u0007")
        )

def every_fixed_primitive_head_is_recognized() -> bool:
    ensure result == true
    can Abort.Panic:
        return (
            SemanticPrimitiveTypeName::is_primitive_type("i8") and
            SemanticPrimitiveTypeName::is_primitive_type("i16") and
            SemanticPrimitiveTypeName::is_primitive_type("i32") and
            SemanticPrimitiveTypeName::is_primitive_type("i64") and
            SemanticPrimitiveTypeName::is_primitive_type("int") and
            SemanticPrimitiveTypeName::is_primitive_type("isize") and
            SemanticPrimitiveTypeName::is_primitive_type("u8") and
            SemanticPrimitiveTypeName::is_primitive_type("u16") and
            SemanticPrimitiveTypeName::is_primitive_type("u32") and
            SemanticPrimitiveTypeName::is_primitive_type("u64") and
            SemanticPrimitiveTypeName::is_primitive_type("usize") and
            SemanticPrimitiveTypeName::is_primitive_type("uintptr") and
            SemanticPrimitiveTypeName::is_primitive_type("f32") and
            SemanticPrimitiveTypeName::is_primitive_type("f64") and
            SemanticPrimitiveTypeName::is_primitive_type("bool") and
            SemanticPrimitiveTypeName::is_primitive_type("char") and
            SemanticPrimitiveTypeName::is_primitive_type("void") and
            SemanticPrimitiveTypeName::is_primitive_type("cstr") and
            SemanticPrimitiveTypeName::is_primitive_type("dstr") and
            SemanticPrimitiveTypeName::is_primitive_type("sview") and
            SemanticPrimitiveTypeName::is_primitive_type("bitset") and
            SemanticPrimitiveTypeName::is_primitive_type("bitfield")
        )

def decimal_width_spellings_are_syntactically_recognized() -> bool:
    ensure result == true
    can Abort.Panic:
        return (
            SemanticPrimitiveTypeName::is_bit_width_int("u1") and
            SemanticPrimitiveTypeName::is_bit_width_int("i4") and
            SemanticPrimitiveTypeName::is_bit_width_int("u63") and
            SemanticPrimitiveTypeName::is_bit_width_int("i999")
        )

def malformed_or_unrelated_names_are_not_primitive() -> bool:
    ensure result == true
    can Abort.Panic:
        return (
            not SemanticPrimitiveTypeName::is_primitive_type("") and
            not SemanticPrimitiveTypeName::is_primitive_type("u") and
            not SemanticPrimitiveTypeName::is_primitive_type("i") and
            not SemanticPrimitiveTypeName::is_primitive_type("u8x") and
            not SemanticPrimitiveTypeName::is_primitive_type("s8") and
            not SemanticPrimitiveTypeName::is_primitive_type("String") and
            not SemanticPrimitiveTypeName::is_primitive_type("HashMap")
        )
