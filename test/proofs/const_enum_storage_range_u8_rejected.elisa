include "./const_enum_storage_range_u8.elisa"

def false_const_enum_u8_accepts_below(value: i64) -> bool:
    requires value < 0
    ensure result == true
    return proof_const_enum_u8_fits(value)

def false_const_enum_u8_accepts_above(value: i64) -> bool:
    requires value > 255
    ensure result == true
    return proof_const_enum_u8_fits(value)
