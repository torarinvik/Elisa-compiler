    ensure result == false
    return reference_and_view_are_present

def named_arguments_are_treated_as_positional(named_argument_is_present: bool) -> bool:
    requires named_argument_is_present
    ensure result == false
    return named_argument_is_present

def callable_field_is_assumed_ufcs(ufcs_candidate_is_missing: bool) -> bool:
