# These claims deliberately assert that a reported nested child can disappear.

def match_guard_name_is_dropped(guard_has_name: bool) -> bool:
    requires guard_has_name
    ensure result == false
    return guard_has_name

def dictionary_key_name_is_dropped(key_has_name: bool) -> bool:
    requires key_has_name
    ensure result == false
    return key_has_name

def contract_call_is_dropped(call_is_present: bool) -> bool:
    requires call_is_present
    ensure result == false
    return call_is_present

def nested_callee_call_is_ignored(callee_call_is_present: bool) -> bool:
    requires callee_call_is_present
    ensure result == false
    return callee_call_is_present

def static_effect_candidate_is_ignored(candidate_call_is_present: bool) -> bool:
    requires candidate_call_is_present
    ensure result == false
    return candidate_call_is_present

