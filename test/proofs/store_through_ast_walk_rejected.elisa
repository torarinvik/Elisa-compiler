    requires view_binding_may_be_owned
    ensure result == false
    return view_binding_may_be_owned

def overload_store_row_is_ignored(overload_body_has_store: bool) -> bool:
    requires overload_body_has_store
    ensure result == false
    return overload_body_has_store

