# Source-linked proof of EASM raw-address memory-base rejection.
include "../../src/backend/easm_memory_base_policy.elisa"
include "../../src/backend/easm_text_scan.elisa"

def raw_scalar_classification_matches_the_closed_type_set(type_name: sview) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return EasmMemoryBasePolicy::raw_scalar_type(type_name) == (
            type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or
            type_name == "i8" or type_name == "i16" or type_name == "i32" or type_name == "i64" or
            type_name == "usize" or type_name == "uintptr"
        )

def raw_address_classification_includes_pointer_sized_unsigned_values(type_name: sview) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return EasmMemoryBasePolicy::raw_address_type(type_name) == (
            type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or
            type_name == "i8" or type_name == "i16" or type_name == "i32" or type_name == "i64" or
            type_name == "usize" or type_name == "uintptr"
        )

def stack_instruction_pointer_and_absent_bases_are_special(register: sview) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return EasmMemoryBasePolicy::special_memory_base(register) == (
            register == "" or register == "rsp" or register == "rip"
        )

def raw_scalar_carriers_are_rejected_as_ordinary_memory_bases(register: sview, type_name: sview) -> bool can[Abort.Panic]:
    requires register != "" and register != "rsp" and register != "rip" and (
        type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or
        type_name == "i8" or type_name == "i16" or type_name == "i32" or type_name == "i64" or
        type_name == "usize" or type_name == "uintptr"
    )
    ensure result == true
    can Abort.Panic:
        return EasmMemoryBasePolicy::rejects_direct_raw_base(register, type_name, false)

def explicit_untyped_memory_capability_is_the_only_direct_base_escape(register: sview, type_name: sview, untyped_capability: bool) -> bool can[Abort.Panic]:
    requires register != "" and register != "rsp" and register != "rip" and (
        type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or
        type_name == "i8" or type_name == "i16" or type_name == "i32" or type_name == "i64" or
        type_name == "usize" or type_name == "uintptr"
    )
    ensure result == true
    can Abort.Panic:
        return EasmMemoryBasePolicy::rejects_direct_raw_base(register, type_name, untyped_capability) == not untyped_capability

def untraced_base_rejection_matches_provenance_and_opt_in(provenance_established: bool, untyped_capability: bool) -> bool:
    requires not provenance_established
    ensure result == true
    return EasmMemoryBasePolicy::rejects_untraced_raw_base(provenance_established, untyped_capability) == not untyped_capability

def raw_address_carriers_need_the_explicit_untyped_capability(type_name: sview, untyped_capability: bool) -> bool can[Abort.Panic]:
    requires (
        type_name == "u8" or type_name == "u16" or type_name == "u32" or type_name == "u64" or
        type_name == "i8" or type_name == "i16" or type_name == "i32" or type_name == "i64" or
        type_name == "usize" or type_name == "uintptr"
    )
    ensure result == true
    can Abort.Panic:
        return EasmMemoryBasePolicy::rejects_raw_address_type_without_opt_in(type_name, untyped_capability) == not untyped_capability

def typed_non_address_carriers_are_not_rejected_as_raw_address_types(type_name: sview) -> bool can[Abort.Panic]:
    requires (
        type_name != "u8" and type_name != "u16" and type_name != "u32" and type_name != "u64" and
        type_name != "i8" and type_name != "i16" and type_name != "i32" and type_name != "i64" and
        type_name != "usize" and type_name != "uintptr"
    )
    ensure result == true
    can Abort.Panic:
        return not EasmMemoryBasePolicy::rejects_raw_address_type_without_opt_in(type_name, false)

def bracketed_memory_address_is_detected_as_memory_syntax() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        has_bracket: bool = EasmTextScan::find("[rax+8]", "[") == 0
        return has_bracket and EasmTextScan::contains_memory_address_delimiter(false, has_bracket)

def bracketed_raw_address_is_rejected_by_the_bracket_gate() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        has_bracket: bool = EasmTextScan::find("[rax+8]", "[") == 0
        return (
            has_bracket and EasmTextScan::contains_memory_address_delimiter(false, has_bracket) and
            EasmMemoryBasePolicy::rejects_bracket_address_form(has_bracket)
        )

def unresolved_non_bracket_memory_base_is_rejected() -> bool:
    ensure result == true
    return EasmMemoryBasePolicy::rejects_unresolved_memory_base(true, true)

def unresolved_base_gate_matches_the_memory_and_parse_facts(is_memory_operand: bool, base_unparsed: bool) -> bool:
    ensure result == true
    return EasmMemoryBasePolicy::rejects_unresolved_memory_base(is_memory_operand, base_unparsed) == (is_memory_operand and base_unparsed)
