include "./region_annotation_window.elisa"

def false_midpoint_can_reach_high() -> bool:
    ensure result == true
    low: usize = 0
    high: usize = 1
    middle: usize = low + (high - low) / 2
    return middle == high

def false_advance_can_cross_the_boundary() -> bool:
    ensure result == true
    low: usize = 0
    high: usize = 8
    middle: usize = 3
    cut: usize = 4
    next_low: usize = middle + 1
    return next_low > cut

def false_retreat_can_discard_the_boundary() -> bool:
    ensure result == true
    low: usize = 0
    high: usize = 8
    middle: usize = 3
    cut: usize = 4
    next_high: usize = middle
    return cut <= next_high

def false_advance_does_not_shrink_the_interval() -> bool:
    ensure result == true
    low: usize = 0
    high: usize = 8
    middle: usize = 3
    next_low: usize = low
    return high - next_low < high - low

def false_retreat_does_not_shrink_the_interval() -> bool:
    ensure result == true
    low: usize = 0
    high: usize = 8
    next_high: usize = high
    return next_high - low < high - low

def false_same_cache_identity_preserves_sort_order(address: i64) -> bool:
    ensure result == true
    old_base: i64 = address
    new_base: i64 = address
    old_count: i64 = 3
    new_count: i64 = 3
    old_first: i64 = 10
    old_middle: i64 = 11
    old_last: i64 = 12
    new_first: i64 = 10
    new_middle: i64 = 9
    new_last: i64 = 12
    old_sorted: bool = old_first <= old_middle and old_middle <= old_last
    new_sorted: bool = new_first <= new_middle and new_middle <= new_last
    return old_base == new_base and old_count == new_count and old_first == new_first and old_last == new_last and old_sorted == new_sorted
