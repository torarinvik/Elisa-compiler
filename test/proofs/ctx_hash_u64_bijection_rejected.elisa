# The bijective scalar-key finalizer must reject collision claims.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"

def distinct_words_can_share_a_scalar_hash(left: u64, right: u64) -> bool:
    requires left != right
    ensure result == true
    return ctx_hash_u64(left) == ctx_hash_u64(right)

def the_inverse_can_miss_a_scalar_hash_input(value: u64) -> bool:
    ensure result == true
    return ctx_unhash_u64(ctx_hash_u64(value)) != value
