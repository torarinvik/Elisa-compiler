# False schema claim for loop-control statement node tags.
include "../../src/driver/frontend_ir_loop_control_encoding.elisa"

def break_and_continue_cannot_have_distinct_node_tags() -> bool:
    ensure result == true
    return (
        FrontendIrLoopControlEncoding::node_type_id(FrontendIrLoopControlEncoding::LoopControlKind.Break)
        == FrontendIrLoopControlEncoding::node_type_id(FrontendIrLoopControlEncoding::LoopControlKind.Continue)
    )

def continue_cannot_use_the_position_field() -> bool:
    ensure result == true
    return (
        FrontendIrLoopControlEncoding::position_field_id(FrontendIrLoopControlEncoding::LoopControlKind.Continue)
        != FrontendIrLoopControlEncoding::LOOP_CONTROL_POSITION_FIELD_ID
    )
