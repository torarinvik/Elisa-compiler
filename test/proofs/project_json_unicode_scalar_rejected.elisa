# False claims against the production UTF-16 escape decoder's scalar boundary.
include "./project_json_unicode_scalar.elisa"

def an_isolated_surrogate_can_escape_unchanged() -> bool can[Memory.Allocate, Abort.Panic]:
    ensure result == true
    data: darray[u8] = []
    cursor: mutable ProjectSystem::JsonCursor = ProjectSystem::JsonCursor{
        position: 0.usize(), ok: true, bad_key_start: 0.usize(), bad_key_length: 0.usize()
    }
    scalar: i64 = ProjectSystem::json_unicode_escape_scalar(data, &cursor, 56320)
    return scalar == 56320
