# Source-linked contracts and boundary properties for ABI lint's assembly token matcher.
include "../../src/driver/project.elisa"
include "../../src/driver/abi_lint.elisa"

def word_byte_predicate_matches_ascii_definition(value: u8) -> bool:
    ensure result == true
    return ProjectSystem::abi_is_word_byte(value) == (
        (value >= ProjectSystemAbiAscii::ASCII_DIGIT_ZERO and value <= ProjectSystemAbiAscii::ASCII_DIGIT_NINE) or
        (value >= ProjectSystemAbiAscii::ASCII_UPPER_A and value <= ProjectSystemAbiAscii::ASCII_UPPER_Z) or
        (value >= ProjectSystemAbiAscii::ASCII_LOWER_A and value <= ProjectSystemAbiAscii::ASCII_LOWER_Z) or
        value == ProjectSystemAbiAscii::ASCII_UNDERSCORE
    )

def lowercase_matches_ascii_casefold_definition(value: u8) -> bool:
    ensure result == true
    return ProjectSystem::abi_lower(value) == (value + ProjectSystemAbiAscii::ASCII_CASE_FOLD_DELTA if value >= ProjectSystemAbiAscii::ASCII_UPPER_A and value <= ProjectSystemAbiAscii::ASCII_UPPER_Z else value)

def ascii_casefold_preserves_word_byte_membership(value: u8) -> bool:
    ensure result == true
    return ProjectSystem::abi_is_word_byte(value) == ProjectSystem::abi_is_word_byte(ProjectSystem::abi_lower(value))

def asm_token_match_obeys_both_word_boundaries(left: u8, right: u8) -> bool can[Memory.Allocate, Abort.Panic]:
    ensure result == (not ProjectSystem::abi_is_word_byte(left) and not ProjectSystem::abi_is_word_byte(right))
    text: mutable darray[u8] = [left]
    ProjectSystem::bytes_extend_view(&text, "asm")
    text.push(right)
    return ProjectSystem::abi_word_in_span(text, 0.usize(), text.count, "asm")

def extended_asm_token_obeys_both_word_boundaries(left: u8, right: u8) -> bool can[Memory.Allocate, Abort.Panic]:
    ensure result == (not ProjectSystem::abi_is_word_byte(left) and not ProjectSystem::abi_is_word_byte(right))
    text: mutable darray[u8] = [left]
    ProjectSystem::bytes_extend_view(&text, "__asm__")
    text.push(right)
    return ProjectSystem::abi_word_in_span(text, 0.usize(), text.count, "__asm__")

def byte_span_rejects_a_start_past_the_text(text: darray[u8]&, start: usize, needle: sview) -> bool:
    requires start > text.count
    ensure result == false
    return ProjectSystem::abi_span_is(text, start, needle)

def case_insensitive_span_rejects_a_start_past_the_text(text: darray[u8]&, start: usize, needle: sview) -> bool:
    requires start > text.count
    ensure result == false
    return ProjectSystem::abi_span_is_ci(text, start, needle)

def byte_span_rejects_a_needle_beyond_the_remaining_text(text: darray[u8]&, start: usize, needle: sview) -> bool:
    requires start <= text.count and sview_len(needle) > text.count - start
    ensure result == false
    return ProjectSystem::abi_span_is(text, start, needle)

def case_insensitive_span_rejects_a_needle_beyond_the_remaining_text(text: darray[u8]&, start: usize, needle: sview) -> bool:
    requires start <= text.count and sview_len(needle) > text.count - start
    ensure result == false
    return ProjectSystem::abi_span_is_ci(text, start, needle)

def word_span_rejects_a_start_past_the_text(text: darray[u8]&, span_start: usize, needle: sview) -> bool:
    requires span_start > text.count
    ensure result == false
    return ProjectSystem::abi_word_in_span(text, span_start, text.count, needle)

def register_span_rejects_a_start_past_the_text(text: darray[u8]&, span_start: usize, spelling: sview) -> bool:
    requires span_start > text.count
    ensure result == false
    return ProjectSystem::abi_register_in_span(text, span_start, text.count, spelling)

def word_span_rejects_a_needle_beyond_the_remaining_text(text: darray[u8]&, span_start: usize, needle: sview) -> bool:
    requires span_start <= text.count and sview_len(needle) > text.count - span_start
    ensure result == false
    return ProjectSystem::abi_word_in_span(text, span_start, text.count, needle)

def register_span_rejects_a_spelling_beyond_the_remaining_text(text: darray[u8]&, span_start: usize, spelling: sview) -> bool:
    requires span_start <= text.count and sview_len(spelling) > text.count - span_start
    ensure result == false
    return ProjectSystem::abi_register_in_span(text, span_start, text.count, spelling)

def indirect_call_match_rejects_a_keyword_longer_than_the_text(text: darray[u8]&, keyword: sview) -> bool:
    requires sview_len(keyword) > text.count
    ensure result == false
    return ProjectSystem::abi_has_indirect(text, keyword)

def all_c_and_cpp_source_extensions_are_accepted() -> bool can[Memory.Allocate, Abort.Panic]:
    ensure result == true
    c_source: darray[u8] = ProjectSystem::bytes_from_view("module.c")
    cc_source: darray[u8] = ProjectSystem::bytes_from_view("module.cc")
    cpp_source: darray[u8] = ProjectSystem::bytes_from_view("module.cpp")
    cxx_source: darray[u8] = ProjectSystem::bytes_from_view("module.cxx")
    return (
        ProjectSystem::abi_is_native_source(c_source) and
        ProjectSystem::abi_is_native_source(cc_source) and
        ProjectSystem::abi_is_native_source(cpp_source) and
        ProjectSystem::abi_is_native_source(cxx_source)
    )

def all_c_and_cpp_header_extensions_are_accepted() -> bool can[Memory.Allocate, Abort.Panic]:
    ensure result == true
    h_header: darray[u8] = ProjectSystem::bytes_from_view("module.h")
    hpp_header: darray[u8] = ProjectSystem::bytes_from_view("module.hpp")
    hh_header: darray[u8] = ProjectSystem::bytes_from_view("module.hh")
    return (
        ProjectSystem::abi_is_native_source(h_header) and
        ProjectSystem::abi_is_native_source(hpp_header) and
        ProjectSystem::abi_is_native_source(hh_header)
    )

def native_extension_matching_is_ascii_case_insensitive() -> bool can[Memory.Allocate, Abort.Panic]:
    ensure result == true
    uppercase_source: darray[u8] = ProjectSystem::bytes_from_view("module.CPP")
    uppercase_header: darray[u8] = ProjectSystem::bytes_from_view("module.HPP")
    return ProjectSystem::abi_is_native_source(uppercase_source) and ProjectSystem::abi_is_native_source(uppercase_header)
