# The next power-of-two threshold after the 2,049th insertion.
def name_set_capacity_eight_thousand_one_hundred_ninety_two_covers_next_four_thousand_ninety_six_insertions(name_count: usize) -> bool:
    requires name_count >= 2048 and name_count <= 4095
    ensure result == true
    return 8192 >= (name_count + 1) * 2

def name_set_four_thousand_ninety_seventh_entry_doubles_capacity(name_count: usize) -> usize:
    requires name_count == 4096
    ensure result == 16384
    return 16384 if 8192 < (name_count + 1) * 2 else 8192

def four_thousand_ninety_seventh_name_rehash_keeps_twelve_thousand_two_hundred_eighty_seven_slots_empty(name_count: usize) -> usize:
    requires name_count == 4096
    ensure result == 12287
    return (16384 if 8192 < (name_count + 1) * 2 else 8192) - (name_count + 1)
