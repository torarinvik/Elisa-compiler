# Deliberately false signed-varint claims; the verifier must leave them open.

def odd_zigzag_payload_can_decode_nonnegative(magnitude: i64) -> bool:
    requires magnitude >= 0
    ensure result == true
    return (0 - magnitude) - 1 >= 0

def negative_zigzag_inverse_roundtrip_can_be_off_by_one(value: i64) -> bool:
    requires value < 0
    ensure result == true
    magnitude: i64 = 0 - (value + 1)
    return (0 - magnitude) - 2 == value

def maximum_odd_zigzag_payload_can_underflow(magnitude: i64) -> bool:
    requires magnitude == 9223372036854775807
    ensure result == true
    return (0 - magnitude) - 1 < (0 - 9223372036854775807) - 1
