include "./modulo_by_zero.elisa"

def false_integer_zero_modulo_divisor_is_ignored() -> bool:
    ensure result == true
    return not (true and true and 0 == 0)

def false_nonzero_modulo_divisor_is_reported(divisor: i64) -> bool:
    requires divisor != 0
    ensure result == true
    return true and true and divisor == 0

def false_other_operator_zero_is_a_modulo_error() -> bool:
    ensure result == true
    return false and true and 0 == 0

def false_noninteger_zero_is_a_modulo_error() -> bool:
    ensure result == true
    return true and false and 0 == 0

def false_expression_match_guard_is_dropped_for_modulo() -> bool:
    ensure result == true
    return not (false or true or false or false or false or false)

def false_statement_variable_type_is_dropped_for_modulo() -> bool:
    ensure result == true
    return not (false or true or false or false or false or false or false or false or false or false or false or false or false or false or false or false or false or false)

def false_declaration_parameter_default_is_dropped_for_modulo() -> bool:
    ensure result == true
    return not (false or true or false or false or false or false or false or false or false or false or false or false or false or false or false or false or false)
