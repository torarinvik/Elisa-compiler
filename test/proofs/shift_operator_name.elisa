# Source-linked proof of the exact enum cases diagnosed as shift operators.
include "./parser_token_kind_projection.elisa"
include "../../src/semantic/shift_operator_name.elisa"

def source_shift_operator_match_is_exact(operator: Lexer::TokenKind) -> bool can[Abort.Panic]:
    ensure result == (operator == Lexer::TokenKind.LShift or operator == Lexer::TokenKind.RShift)
    can Abort.Panic:
        return ShiftOperatorName::is_shift_operator(operator)

def both_shift_directions_are_recognized() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            ShiftOperatorName::is_shift_operator(Lexer::TokenKind.LShift)
            and ShiftOperatorName::is_shift_operator(Lexer::TokenKind.RShift)
        )

def nearby_non_shift_tokens_are_excluded() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            not ShiftOperatorName::is_shift_operator(Lexer::TokenKind.Plus)
            and not ShiftOperatorName::is_shift_operator(Lexer::TokenKind.Percent)
            and not ShiftOperatorName::is_shift_operator(Lexer::TokenKind.LShiftEq)
            and not ShiftOperatorName::is_shift_operator(Lexer::TokenKind.RShiftEq)
        )
