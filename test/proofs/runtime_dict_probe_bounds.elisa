# Linear-probe results stay inside available table capacity.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"

def dictionary_find_index_stays_within_positive_capacity(m: dict[u64, u64]&, key: u64) -> bool:
    requires m.capacity > 0
    ensure result == true
    probe: DictProbeResult = arena_dict_find_index(m, key)
    return probe.index < m.capacity

def set_find_index_stays_within_positive_capacity(s: set[u64]&, key: u64) -> bool:
    requires s.capacity > 0
    ensure result == true
    probe: DictProbeResult = arena_set_find_index(s, key)
    return probe.index < s.capacity

def cstr_view_find_index_stays_within_positive_capacity(m: dict[cstr, u64]&, key: sview) -> bool:
    requires m.capacity > 0
    ensure result == true
    probe: DictProbeResult = arena_dict_find_cstr_view_index(m, key)
    return probe.index < m.capacity

def dictionary_probe_match_requires_backing_storage(m: dict[u64, u64]&, key: u64) -> bool:
    ensure result == true
    probe: DictProbeResult = arena_dict_find_index(m, key)
    return not probe.found or m.items != null

def set_probe_match_requires_backing_storage(s: set[u64]&, key: u64) -> bool:
    ensure result == true
    probe: DictProbeResult = arena_set_find_index(s, key)
    return not probe.found or s.items != null

def cstr_view_probe_match_requires_backing_storage(m: dict[cstr, u64]&, key: sview) -> bool:
    ensure result == true
    probe: DictProbeResult = arena_dict_find_cstr_view_index(m, key)
    return not probe.found or m.items != null

def unavailable_dictionary_probe_uses_the_empty_sentinel(m: dict[u64, u64]&, key: u64) -> bool:
    requires m.capacity == 0 or m.items == null
    ensure result == true
    probe: DictProbeResult = arena_dict_find_index(m, key)
    return probe.index == 0 and not probe.found

def unavailable_set_probe_uses_the_empty_sentinel(s: set[u64]&, key: u64) -> bool:
    requires s.capacity == 0 or s.items == null
    ensure result == true
    probe: DictProbeResult = arena_set_find_index(s, key)
    return probe.index == 0 and not probe.found

def unavailable_cstr_view_probe_uses_the_empty_sentinel(m: dict[cstr, u64]&, key: sview) -> bool:
    requires m.capacity == 0 or m.items == null
    ensure result == true
    probe: DictProbeResult = arena_dict_find_cstr_view_index(m, key)
    return probe.index == 0 and not probe.found
