# Source-linked laws for the production never-leak category phrase and severity prefix.
include "../../src/semantic/binding_identity_types.elisa"
include "../../src/semantic/never_leak_codes.elisa"
include "../../src/driver/never_leak_env_values.elisa"
include "../../src/driver/never_leak_report_names.elisa"

module NeverLeakReportPolicyModel:
    public:
        def category_phrase_is_exact_for_all_categories(category: u8, escapes: bool) -> bool:
            ensure result == true
            return (
                (category == Semantic::NEVER_LEAK_CHAIN and escapes and NeverLeakReportNames::category_phrase(category, escapes) == "chain with a loop jump (its last use binds another local, and a `break`/`continue` for an enclosing loop lies in between)")
                or (category == Semantic::NEVER_LEAK_CHAIN and not escapes and NeverLeakReportNames::category_phrase(category, escapes) == "chain (its last use binds another local, so that binding can take the statements as a block expression)")
                or (category == Semantic::NEVER_LEAK_OVERLAP and NeverLeakReportNames::category_phrase(category, escapes) == "overlap (a local declared after it is still needed after its last use)")
                or (category == Semantic::NEVER_LEAK_LOOP and NeverLeakReportNames::category_phrase(category, escapes) == "loop (its last use is a loop it feeds: a counter, accumulator or loop input)")
                or (
                    category != Semantic::NEVER_LEAK_CHAIN
                    and category != Semantic::NEVER_LEAK_OVERLAP
                    and category != Semantic::NEVER_LEAK_LOOP
                    and NeverLeakReportNames::category_phrase(category, escapes) == "plain (its last use is a statement with no value to bind)"
                )
            )

        def severity_prefix_is_exact_for_all_modes(mode: u8) -> bool:
            ensure result == true
            return (
                (mode == NeverLeakEnvValues::NL_ENV_MODE_ERROR and NeverLeakReportNames::severity_prefix(mode) == ": error: ")
                or (mode != NeverLeakEnvValues::NL_ENV_MODE_ERROR and NeverLeakReportNames::severity_prefix(mode) == ": warning: ")
            )

def explicit_loop_category_has_loop_phrase() -> bool:
    ensure result == true
    return NeverLeakReportNames::category_phrase(Semantic::NEVER_LEAK_LOOP, false) == "loop (its last use is a loop it feeds: a counter, accumulator or loop input)"

def unrecognized_category_uses_plain_phrase() -> bool:
    ensure result == true
    return NeverLeakReportNames::category_phrase(Semantic::NEVER_LEAK_CATEGORY_UNKNOWN, true) == "plain (its last use is a statement with no value to bind)"

def every_non_error_mode_uses_warning_prefix() -> bool:
    ensure result == true
    return NeverLeakReportNames::severity_prefix(NeverLeakEnvValues::NL_ENV_MODE_OFF) == ": warning: "
