include "./backend_cabi_x86_argument_byval.elisa"

def false_two_eightbyte_aggregate_argument_uses_byval(size: i64) -> bool:
    requires size == 16
    ensure result
    return size > 16

def false_large_x86_aggregate_argument_is_direct(size: i64) -> bool:
    requires size == 17
    ensure not result
    return size > 16

def false_unflattenable_aggregate_argument_is_direct(size: i64) -> bool:
    requires size > 0
    ensure not result
    return true
