# Source-linked properties for the project system's unsigned byte-lexicographic ordering.
include "./backend_error_family_byte_order.elisa"

ghost def project_bytes_less_from(left: darray[u8]&, right: darray[u8]&, index: usize) -> bool:
    requires index <= left.count and index <= right.count
    decreases (left.count if left.count < right.count else right.count) - index
    if index < left.count and index < right.count:
        return left[index] < right[index] if left[index] != right[index]
        return project_bytes_less_from(left, right, index + 1)
    return left.count < right.count

ghost def project_bytes_equal_from(left: darray[u8]&, right: darray[u8]&, index: usize) -> bool:
    requires index <= left.count and index <= right.count
    decreases (left.count if left.count < right.count else right.count) - index
    if index < left.count and index < right.count:
        return false if left[index] != right[index]
        return project_bytes_equal_from(left, right, index + 1)
    return left.count == right.count

ghost def project_bytes_less_at(left: darray[u8]&, right: darray[u8]&, index: usize) -> bool:
    return left.count < right.count if index > left.count or index > right.count
    return project_bytes_less_from(left, right, index)

ghost def project_bytes_equal_at(left: darray[u8]&, right: darray[u8]&, index: usize) -> bool:
    return left.count == right.count if index > left.count or index > right.count
    return project_bytes_equal_from(left, right, index)

def project_bytes_less_model(left: darray[u8]&, right: darray[u8]&) -> bool:
    ensure result == project_bytes_less_at(left, right, 0)
    limit: usize = left.count if left.count < right.count else right.count
    index: mutable usize = 0
    while index < limit |index, left, right|:
        decreases limit - index
        invariant index <= limit
        invariant project_bytes_less_at(left, right, index) == project_bytes_less_at(left, right, 0)
        if index < left.count and index < right.count:
            return true if left[index] < right[index]
            return false if left[index] > right[index]
            index <- index + 1
        else:
            return left.count < right.count
    return left.count < right.count

ghost def project_bytes_not_both_from(left: darray[u8]&, right: darray[u8]&, index: usize) -> bool:
    requires index <= left.count and index <= right.count
    decreases (left.count if left.count < right.count else right.count) - index
    ensures result == not (project_bytes_less_at(left, right, index) and project_bytes_less_at(right, left, index))
    ensures result == true
    if index < left.count and index < right.count:
        return byte_less_is_asymmetric(left[index], right[index]) if left[index] != right[index]
        return project_bytes_not_both_from(left, right, index + 1)
    return not (left.count < right.count and right.count < left.count)

ghost def project_bytes_total_from(left: darray[u8]&, right: darray[u8]&, index: usize) -> bool:
    requires index <= left.count and index <= right.count
    decreases (left.count if left.count < right.count else right.count) - index
    ensures result == (project_bytes_less_at(left, right, index) or project_bytes_less_at(right, left, index) or project_bytes_equal_at(left, right, index))
    ensures result == true
    if index < left.count and index < right.count:
        return byte_order_is_total(left[index], right[index]) if left[index] != right[index]
        return project_bytes_total_from(left, right, index + 1)
    return left.count < right.count or right.count < left.count or left.count == right.count

ghost def project_bytes_transitive_from(left: darray[u8]&, middle: darray[u8]&, right: darray[u8]&, index: usize) -> bool:
    requires index <= left.count and index <= middle.count and index <= right.count
    decreases ((left.count if left.count < middle.count else middle.count) if (left.count if left.count < middle.count else middle.count) < right.count else right.count) - index
    ensures result == (not (project_bytes_less_at(left, middle, index) and project_bytes_less_at(middle, right, index)) or project_bytes_less_at(left, right, index))
    ensures result == true
    return true if not project_bytes_less_at(left, middle, index) or not project_bytes_less_at(middle, right, index)
    if index < left.count and index < middle.count and index < right.count:
        left_byte: u8 = left[index]
        middle_byte: u8 = middle[index]
        right_byte: u8 = right[index]
        if left_byte < middle_byte:
            if middle_byte < right_byte:
                return byte_less_is_transitive(left_byte, middle_byte, right_byte)
            return true
        if left_byte == middle_byte:
            return true if middle_byte < right_byte
            return project_bytes_transitive_from(left, middle, right, index + 1) if middle_byte == right_byte
        return true
    return left.count < right.count

ghost def project_bytes_order_is_asymmetric(left: darray[u8]&, right: darray[u8]&) -> bool:
    ensures result == not (project_bytes_less_at(left, right, 0) and project_bytes_less_at(right, left, 0))
    ensures result == true
    return project_bytes_not_both_from(left, right, 0)

ghost def project_bytes_order_is_total(left: darray[u8]&, right: darray[u8]&) -> bool:
    ensures result == (project_bytes_less_at(left, right, 0) or project_bytes_less_at(right, left, 0) or project_bytes_equal_at(left, right, 0))
    ensures result == true
    return project_bytes_total_from(left, right, 0)

ghost def project_bytes_order_is_transitive(left: darray[u8]&, middle: darray[u8]&, right: darray[u8]&) -> bool:
    ensures result == (not (project_bytes_less_at(left, middle, 0) and project_bytes_less_at(middle, right, 0)) or project_bytes_less_at(left, right, 0))
    ensures result == true
    return project_bytes_transitive_from(left, middle, right, 0)

def singleton_bytes_use_unsigned_order(left_byte: u8, right_byte: u8) -> bool:
    ensure result == true
    left: darray[u8] = [left_byte]
    right: darray[u8] = [right_byte]
    return project_bytes_less_model(left, right) == (left_byte < right_byte)

def first_differing_byte_decides_before_the_suffix(
    left_first: u8,
    left_last: u8,
    right_first: u8,
    right_last: u8
) -> bool:
    requires left_first != right_first
    ensure result == true
    left: darray[u8] = [left_first, left_last]
    right: darray[u8] = [right_first, right_last]
    return project_bytes_less_model(left, right) == (left_first < right_first)

def equal_prefixes_compare_the_next_byte(
    prefix: u8,
    left_last: u8,
    right_last: u8
) -> bool:
    ensure result == true
    left: darray[u8] = [prefix, left_last]
    right: darray[u8] = [prefix, right_last]
    return project_bytes_less_model(left, right) == (left_last < right_last)

def a_proper_byte_prefix_sorts_first(prefix: u8, extension: u8) -> bool:
    ensure result == true
    shorter: darray[u8] = [prefix]
    longer: darray[u8] = [prefix, extension]
    return project_bytes_less_model(shorter, longer)

def equal_two_byte_strings_are_not_less(first: u8, second: u8) -> bool:
    ensure result == true
    left: darray[u8] = [first, second]
    right: darray[u8] = [first, second]
    return not project_bytes_less_model(left, right)
