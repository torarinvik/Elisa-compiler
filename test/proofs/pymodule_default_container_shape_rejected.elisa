include "./pymodule_default_container_shape.elisa"

def a_nonempty_array_is_an_empty_literal() -> bool can[Abort.Panic]:
    ensure result == true
    pos: Ast::Pos = Ast::Pos{line: NO_SOURCE_COORDINATE, column: NO_SOURCE_COORDINATE, offset: NO_SOURCE_COORDINATE,
        end_line: NO_SOURCE_COORDINATE, end_column: NO_SOURCE_COORDINATE, end_offset: NO_SOURCE_COORDINATE}
    elements: darray[Ast::Expr] = [Ast::Expr.IntLit(TEST_INTEGER, pos)]
    expression: Ast::Expr = Ast::Expr.Array(elements, pos)
    can Abort.Panic:
        return PymoduleDefaultContainerShapePolicy::is_empty_container(expression)

def a_construct_is_not_a_container() -> bool can[Abort.Panic]:
    ensure result == true
    pos: Ast::Pos = Ast::Pos{line: NO_SOURCE_COORDINATE, column: NO_SOURCE_COORDINATE, offset: NO_SOURCE_COORDINATE,
        end_line: NO_SOURCE_COORDINATE, end_column: NO_SOURCE_COORDINATE, end_offset: NO_SOURCE_COORDINATE}
    type_expression: Ast::Expr = Ast::Expr.Ident("Widget", pos)
    fields: darray[Ast::FieldInit] = []
    expression: Ast::Expr = Ast::Expr.Construct(type_expression, fields, pos)
    can Abort.Panic:
        return not PymoduleDefaultContainerShapePolicy::is_container(expression)

def an_integer_literal_is_an_empty_container() -> bool can[Abort.Panic]:
    ensure result == true
    pos: Ast::Pos = Ast::Pos{line: NO_SOURCE_COORDINATE, column: NO_SOURCE_COORDINATE, offset: NO_SOURCE_COORDINATE,
        end_line: NO_SOURCE_COORDINATE, end_column: NO_SOURCE_COORDINATE, end_offset: NO_SOURCE_COORDINATE}
    expression: Ast::Expr = Ast::Expr.IntLit(TEST_INTEGER, pos)
    can Abort.Panic:
        return PymoduleDefaultContainerShapePolicy::is_empty_container(expression)
