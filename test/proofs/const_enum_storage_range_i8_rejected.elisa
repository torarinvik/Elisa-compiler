include "./const_enum_storage_range_i8.elisa"

def false_const_enum_i8_accepts_below(value: i64) -> bool:
    requires value < (0 - 128)
    ensure result == true
    return proof_const_enum_i8_fits(value)

def false_const_enum_i8_accepts_above(value: i64) -> bool:
    requires value > 127
    ensure result == true
    return proof_const_enum_i8_fits(value)
