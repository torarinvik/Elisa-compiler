# Deliberately false boundary claim: the first value beyond u64's final decimal digit fits.
include "./backend_decimal_accumulator_model.elisa"

def max_prefix_plus_six_is_admitted() -> bool:
    ensure result == true
    return BackendDecimalLiteral::decimal_step_allowed(BackendDecimalLiteral::MAX_PREFIX_BEFORE_DECIMAL_DIGIT, 6.u64())
