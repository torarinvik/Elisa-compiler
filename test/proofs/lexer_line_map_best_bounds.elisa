# Integer model of the cache's lower-bound search. The source checker binds these
# interval laws to line_map_cache_best and its checked cache capacity.
const LINE_MAP_BEST_MAX_COUNT: i64 = 65536

def lower_bound_midpoint_stays_inside(low: i64, high: i64, count: i64) -> bool:
    requires low >= 0 and low < high and high <= count and count <= LINE_MAP_BEST_MAX_COUNT
    ensure result == true
    middle: i64 = low + (high - low) / 2
    return middle >= low and middle < high and middle < count

def advancing_low_stays_bounded_and_shrinks(low: i64, high: i64, middle: i64) -> bool:
    requires low >= 0 and low <= middle and middle < high
    ensure result == true
    next_low: i64 = middle + 1
    return next_low > low and next_low <= high

def retreating_high_stays_bounded_and_shrinks(low: i64, high: i64, middle: i64) -> bool:
    requires low >= 0 and low <= middle and middle < high
    ensure result == true
    next_high: i64 = middle
    return next_high >= low and next_high < high

def accepting_branch_strictly_reduces_interval_width(low: i64, high: i64, middle: i64) -> bool:
    requires low >= 0 and low <= middle and middle < high
    ensure result == true
    next_low: i64 = middle + 1
    return high - next_low < high - low

def rejecting_branch_strictly_reduces_interval_width(low: i64, high: i64, middle: i64) -> bool:
    requires low >= 0 and low <= middle and middle < high
    ensure result == true
    next_high: i64 = middle
    return next_high - low < high - low

def zero_lower_bound_produces_the_negative_one_sentinel() -> bool:
    ensure result == true
    low: i64 = 0
    best: i64 = low - 1
    return best == (0 - 1)

def positive_lower_bound_produces_a_valid_predecessor(low: i64, count: i64) -> bool:
    requires low > 0 and low <= count and count <= LINE_MAP_BEST_MAX_COUNT
    ensure result == true
    best: i64 = low - 1
    return best >= 0 and best < count

# For a nondecreasing table, boundary is the first entry strictly greater than
# the query (or count when every entry is <= it). These lemmas prove each branch
# retains that cut point; the source checker binds the comparison and updates.
def accepting_midpoint_preserves_first_greater_boundary(
    low: i64,
    high: i64,
    middle: i64,
    boundary: i64
) -> bool:
    requires low >= 0 and low <= middle and middle < high and low <= boundary and boundary <= high and middle < boundary
    ensure result == true
    next_low: i64 = middle + 1
    return next_low > low and next_low <= boundary and boundary <= high

def rejecting_midpoint_preserves_first_greater_boundary(
    low: i64,
    high: i64,
    middle: i64,
    boundary: i64
) -> bool:
    requires low >= 0 and low <= boundary and boundary <= middle and middle < high
    ensure result == true
    next_high: i64 = middle
    return low <= boundary and boundary <= next_high and next_high < high
