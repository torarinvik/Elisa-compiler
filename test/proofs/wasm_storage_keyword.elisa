# Source-linked proof of the exact token-kind set stripped as WASM storage qualifiers.
include "./parser_token_kind_projection.elisa"
include "../../src/driver/wasm_storage_keyword.elisa"

def source_storage_keyword_match_is_exact(kind: Lexer::TokenKind) -> bool can[Abort.Panic]:
    ensure result == (kind == Lexer::TokenKind.Mutable or kind == Lexer::TokenKind.Lmut or kind == Lexer::TokenKind.Heap or kind == Lexer::TokenKind.Stack or kind == Lexer::TokenKind.Static)
    can Abort.Panic:
        return WasmStorageKeyword::is_storage_keyword(kind)

def all_storage_qualifiers_are_recognized() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            WasmStorageKeyword::is_storage_keyword(Lexer::TokenKind.Mutable)
            and WasmStorageKeyword::is_storage_keyword(Lexer::TokenKind.Lmut)
            and WasmStorageKeyword::is_storage_keyword(Lexer::TokenKind.Heap)
            and WasmStorageKeyword::is_storage_keyword(Lexer::TokenKind.Stack)
            and WasmStorageKeyword::is_storage_keyword(Lexer::TokenKind.Static)
        )

def nearby_non_storage_tokens_are_excluded() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            not WasmStorageKeyword::is_storage_keyword(Lexer::TokenKind.Ident)
            and not WasmStorageKeyword::is_storage_keyword(Lexer::TokenKind.Const)
            and not WasmStorageKeyword::is_storage_keyword(Lexer::TokenKind.Ampersand)
            and not WasmStorageKeyword::is_storage_keyword(Lexer::TokenKind.LShiftEq)
        )
