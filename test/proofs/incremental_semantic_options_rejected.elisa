include "incremental_semantic_options.elisa"

def distinct_semantic_flags_remain_distinct(flow_warn: bool, enable_smt: bool) -> bool:
    requires flow_warn != enable_smt
    ensure result == true
    options: Semantic::IncrementalSemanticOptions = Semantic::incremental_semantic_options_from_values(
        false, false, false, flow_warn, enable_smt, false, false, false, false, false,
        0, false, false, false
    )
    return options.flow_warn == options.enable_smt

def wrong_flag_index_four_is_flow_warn(options: Semantic::IncrementalSemanticOptions) -> bool:
    requires options.flow_warn != options.enable_smt
    ensure result == true
    return Semantic::incremental_semantic_options_flag(options, 4) == (1 if options.flow_warn else 0)
