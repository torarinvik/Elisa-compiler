# Finite AST-discriminant projection for the production container-shape policies.
# Payloads for unrelated expression variants are omitted; the source checker requires the
# complete constructor-name set and pins the four payload-bearing shapes used by the policy.
module Ast:
    public:
        struct Pos:
            line: u32
            column: u32
            offset: u32
            end_line: u32
            end_column: u32
            end_offset: u32

        enum Node layout(handle: u32):
            pass

        enum Expr is Node:
            Invalid
            Absent
            IntLit(value: i64, pos: Pos)
            FloatLit
            StringLit
            CharLit
            BoolLit
            Ident(name: sview, pos: Pos)
            Call
            StaticEffectCall
            Field
            Scope
            ShorthandMember
            Index
            Slice
            IndexN
            Binary
            Unary
            Move
            RegionNew
            Paren
            Array(elements: darray[Expr], pos: Pos)
            Tuple
            SetLit(elements: darray[Expr], pos: Pos)
            DictLit(entries: darray[DictEntry], pos: Pos)
            Construct(type: Expr, fields: darray[FieldInit], pos: Pos)
            RecordUpdate
            If
            Match
            Catch
            Comprehension
            Refinement
            GetElse
            Lambda
            Block

        struct DictEntry:
            key: Expr
            value: Expr

        struct FieldInit:
            name: sview
            value: Expr

include "../../src/driver/pymodule/default_container_shape_policy.elisa"

const NO_SOURCE_COORDINATE: u32 = 0
const TEST_INTEGER: i64 = 1

def empty_container_classifier_matches_ast_shape(expression: Ast::Expr) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return PymoduleDefaultContainerShapePolicy::is_empty_container(expression) == (when expression:
            Ast::Expr.Array(elements, _) -> elements.count == 0
            Ast::Expr.DictLit(entries, _) -> entries.count == 0
            Ast::Expr.SetLit(elements, _) -> elements.count == 0
            _ -> false
        )

def container_classifier_matches_ast_shape(expression: Ast::Expr) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return PymoduleDefaultContainerShapePolicy::is_container(expression) == (when expression:
            Ast::Expr.Array(_, _) | Ast::Expr.DictLit(_, _) | Ast::Expr.SetLit(_, _) | Ast::Expr.Construct(_, _, _) -> true
            _ -> false
        )

def an_empty_container_literal_is_a_container(expression: Ast::Expr) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not PymoduleDefaultContainerShapePolicy::is_empty_container(expression) or PymoduleDefaultContainerShapePolicy::is_container(expression)

def empty_array_is_empty_and_is_a_container() -> bool can[Abort.Panic]:
    ensure result == true
    pos: Ast::Pos = Ast::Pos{line: NO_SOURCE_COORDINATE, column: NO_SOURCE_COORDINATE, offset: NO_SOURCE_COORDINATE,
        end_line: NO_SOURCE_COORDINATE, end_column: NO_SOURCE_COORDINATE, end_offset: NO_SOURCE_COORDINATE}
    elements: darray[Ast::Expr] = []
    expression: Ast::Expr = Ast::Expr.Array(elements, pos)
    can Abort.Panic:
        return PymoduleDefaultContainerShapePolicy::is_empty_container(expression) and PymoduleDefaultContainerShapePolicy::is_container(expression)

def empty_dictionary_is_empty_and_is_a_container() -> bool can[Abort.Panic]:
    ensure result == true
    pos: Ast::Pos = Ast::Pos{line: NO_SOURCE_COORDINATE, column: NO_SOURCE_COORDINATE, offset: NO_SOURCE_COORDINATE,
        end_line: NO_SOURCE_COORDINATE, end_column: NO_SOURCE_COORDINATE, end_offset: NO_SOURCE_COORDINATE}
    entries: darray[Ast::DictEntry] = []
    expression: Ast::Expr = Ast::Expr.DictLit(entries, pos)
    can Abort.Panic:
        return PymoduleDefaultContainerShapePolicy::is_empty_container(expression) and PymoduleDefaultContainerShapePolicy::is_container(expression)

def empty_set_is_empty_and_is_a_container() -> bool can[Abort.Panic]:
    ensure result == true
    pos: Ast::Pos = Ast::Pos{line: NO_SOURCE_COORDINATE, column: NO_SOURCE_COORDINATE, offset: NO_SOURCE_COORDINATE,
        end_line: NO_SOURCE_COORDINATE, end_column: NO_SOURCE_COORDINATE, end_offset: NO_SOURCE_COORDINATE}
    elements: darray[Ast::Expr] = []
    expression: Ast::Expr = Ast::Expr.SetLit(elements, pos)
    can Abort.Panic:
        return PymoduleDefaultContainerShapePolicy::is_empty_container(expression) and PymoduleDefaultContainerShapePolicy::is_container(expression)

def a_construct_is_a_container_but_not_an_empty_literal() -> bool can[Abort.Panic]:
    ensure result == true
    pos: Ast::Pos = Ast::Pos{line: NO_SOURCE_COORDINATE, column: NO_SOURCE_COORDINATE, offset: NO_SOURCE_COORDINATE,
        end_line: NO_SOURCE_COORDINATE, end_column: NO_SOURCE_COORDINATE, end_offset: NO_SOURCE_COORDINATE}
    type_expression: Ast::Expr = Ast::Expr.Ident("Widget", pos)
    fields: darray[Ast::FieldInit] = []
    expression: Ast::Expr = Ast::Expr.Construct(type_expression, fields, pos)
    can Abort.Panic:
        return PymoduleDefaultContainerShapePolicy::is_container(expression) and not PymoduleDefaultContainerShapePolicy::is_empty_container(expression)

def an_integer_literal_is_not_a_container() -> bool can[Abort.Panic]:
    ensure result == true
    pos: Ast::Pos = Ast::Pos{line: NO_SOURCE_COORDINATE, column: NO_SOURCE_COORDINATE, offset: NO_SOURCE_COORDINATE,
        end_line: NO_SOURCE_COORDINATE, end_column: NO_SOURCE_COORDINATE, end_offset: NO_SOURCE_COORDINATE}
    expression: Ast::Expr = Ast::Expr.IntLit(TEST_INTEGER, pos)
    can Abort.Panic:
        return not PymoduleDefaultContainerShapePolicy::is_container(expression) and not PymoduleDefaultContainerShapePolicy::is_empty_container(expression)
