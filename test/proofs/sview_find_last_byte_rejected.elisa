# False claims about reverse byte search must remain unproved.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

def reverse_search_can_return_an_earlier_match(
    view: sview,
    byte: u8,
    earlier: i64,
    later: i64
) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    requires earlier >= 0 and earlier < later and later < view.len
    requires string_view_index(view, earlier) == byte.i64()
    requires string_view_index(view, later) == byte.i64()
    ensure result == true
    return sview_find_last_byte(view, byte) == earlier

def reverse_search_can_miss_a_known_matching_offset(
    view: sview,
    byte: u8,
    candidate: i64
) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    requires candidate >= 0 and candidate < view.len
    requires string_view_index(view, candidate) == byte.i64()
    ensure result == true
    return sview_find_last_byte(view, byte) == -1

def filename_can_keep_a_slash_in_its_extent(path: sview) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires path.len >= 0 and path.len.usize().i64() == path.len
    requires sview_find_last_byte(path, 47) >= 0
    ensure result == true
    return Fs::filename(path).len == path.len

def parent_can_extend_past_the_last_slash(path: sview) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires path.len >= 0 and path.len.usize().i64() == path.len
    requires sview_find_last_byte(path, 47) >= 0
    ensure result == true
    return Fs::parent(path).len > sview_find_last_byte(path, 47)
