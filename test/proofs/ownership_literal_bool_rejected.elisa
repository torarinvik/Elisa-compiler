include "./ownership_literal_bool.elisa"

def depth_limited_boolean_may_remain_known() -> bool:
    ensure result == true
    return OwnershipLiteralBoolSpecification::fact_is_known_at_node(
        OwnershipLiteralBoolSpecification::OWNERSHIP_LITERAL_BOOL_PROOF_DEPTH_LIMIT, true, false, true)

def unsupported_expression_may_supply_a_truth_value() -> bool:
    ensure result == true
    return OwnershipLiteralBoolSpecification::fact_value_at_node(0, false, false, true, false, false)

def parentheses_may_invent_knownness() -> bool:
    ensure result == true
    return OwnershipLiteralBoolSpecification::fact_is_known_at_node(0, false, true, false)

def parenthesized_unknown_may_be_true() -> bool:
    ensure result == true
    return OwnershipLiteralBoolSpecification::fact_value_at_node(0, false, true, false, false, false)

def a_known_false_guard_may_reach_the_loop_body() -> bool:
    ensure result == true
    return OwnershipLiteralBoolSpecification::loop_backedge_reachability_tracks_condition(true, true, false)

def a_complete_known_true_loop_may_fall_through() -> bool:
    ensure result == true
    return not OwnershipLiteralBoolSpecification::stable_complete_true_loop_marks_exit_unreachable(true, true, true, true)
