include "./noalloc_argument_policy.elisa"

def noalloc_with_an_argument_is_allowed() -> bool:
    ensure result == true
    return not NoallocArgumentPolicy::rejects_decorator("noalloc", NOALLOC_ARGUMENTS_ONE)

def bare_noalloc_is_rejected() -> bool:
    ensure result == true
    return NoallocArgumentPolicy::rejects_decorator("noalloc", NOALLOC_ARGUMENTS_NONE)

def another_decorator_is_rejected_for_arguments() -> bool:
    ensure result == true
    return NoallocArgumentPolicy::rejects_decorator("inline", NOALLOC_ARGUMENTS_ONE)
