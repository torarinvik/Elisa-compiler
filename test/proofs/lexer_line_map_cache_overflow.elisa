# Only the ready state may select cached values; overflow and every other
# non-ready state must use the per-call map parser.
const LINE_MAP_CACHE_READY: i64 = 1
const LINE_MAP_CACHE_NOT_READY: i64 = 2

def line_map_cache_usable_only_in_ready_state(state: i64) -> bool:
    ensure result == (state == LINE_MAP_CACHE_READY)
    return state == LINE_MAP_CACHE_READY

def choose_line_map_result(state: i64, cached_result: i64, parsed_result: i64) -> i64:
    ensure result == (cached_result if state == LINE_MAP_CACHE_READY else parsed_result)
    return cached_result if state == LINE_MAP_CACHE_READY else parsed_result

def overflow_uses_per_call_map(cached_result: i64, parsed_result: i64) -> bool:
    ensure result == true
    return (cached_result if LINE_MAP_CACHE_NOT_READY == LINE_MAP_CACHE_READY else parsed_result) == parsed_result

def every_nonready_state_uses_per_call_map(state: i64, cached_result: i64, parsed_result: i64) -> bool:
    requires state != LINE_MAP_CACHE_READY
    ensure result == true
    return (cached_result if state == LINE_MAP_CACHE_READY else parsed_result) == parsed_result

def ready_state_uses_cache(state: i64, cached_result: i64, parsed_result: i64) -> bool:
    requires state == LINE_MAP_CACHE_READY
    ensure result == true
    return (cached_result if state == LINE_MAP_CACHE_READY else parsed_result) == cached_result
