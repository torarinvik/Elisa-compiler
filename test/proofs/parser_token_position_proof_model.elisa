# Projection of the production fields consumed by Ast::pos_of_token. The proof
# runner checks the exact field types against Lexer::Token and Ast::Pos.
module Lexer:
    public:
        struct Token:
            line: mutable u32
            column: mutable u32
            start: mutable u32
            length: mutable u32

module Ast:
    public:
        struct Pos:
            line: mutable u32
            column: mutable u32
            offset: mutable u32
            end_line: mutable u32
            end_column: mutable u32
            end_offset: mutable u32

include "../../src/parser/parser_token_position.elisa"
