# Refinement properties for the runtime StringView slice operation.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

ghost def string_view_slice_bounds(length: i64, start: i64, end: i64) -> (low: i64, high: i64):
    requires length >= 0
    ensure result.low == (start if start > 0 and start <= length else length if start > length else 0)
    ensure result.high == (length if end < 0 else result.low if end < result.low else end if end <= length else length)
    ensure result.low >= 0 and result.low <= length
    ensure result.high >= result.low and result.high <= length
    low: mutable i64 = start if start > 0 else 0
    high: mutable i64 = end if end >= 0 else length
    low <- length if low > length
    high <- length if high > length
    high <- low if high < low
    return (low, high)

def a_runtime_slice_has_the_specified_clamped_extent(view: sview, start: i64, end: i64) -> bool can[Unsafe{PointerArithmetic, RawExtern}]:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    ensure result == true
    bounds: (low: i64, high: i64) = string_view_slice_bounds(view.len, start, end)
    sliced: sview = string_view_slice(view, start, end)
    return sliced.len == bounds.high - bounds.low and (
        sliced.len == 0 or sliced.data == view.data + bounds.low.usize()
    )

def a_runtime_prefix_has_the_specified_clamped_extent(view: sview, end: i64) -> bool can[Unsafe{PointerArithmetic, RawExtern}]:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    ensure result == true
    bounds: (low: i64, high: i64) = string_view_slice_bounds(view.len, 0, end)
    prefix: sview = string_view_prefix(view, end)
    return prefix.len == bounds.high - bounds.low and (
        prefix.len == 0 or prefix.data == view.data
    )

def a_runtime_suffix_has_the_specified_clamped_extent(view: sview, start: i64) -> bool can[Unsafe{PointerArithmetic, RawExtern}]:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    ensure result == true
    bounds: (low: i64, high: i64) = string_view_slice_bounds(view.len, start, view.len)
    suffix: sview = string_view_suffix(view, start)
    return suffix.len == bounds.high - bounds.low and (
        suffix.len == 0 or suffix.data == view.data + bounds.low.usize()
    )
