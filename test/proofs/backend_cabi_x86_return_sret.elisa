# The x86-64 C ABI uses an sret pointer for aggregates larger than two eightbytes,
# and also for aggregates the backend cannot flatten into register classes.
def x86_aggregate_return_uses_sret(is_aggregate: bool, size: i64, flat_ok: bool) -> bool:
    requires size >= 0
    ensure result == (is_aggregate and size > 0 and (not flat_ok or size > 16))
    return is_aggregate and size > 0 and (not flat_ok or size > 16)

def two_eightbyte_aggregate_returns_directly(size: i64) -> bool:
    requires size == 16
    ensure not result
    return size > 16

def aggregate_over_two_eightbytes_uses_sret(size: i64) -> bool:
    requires size == 17
    ensure result
    return size > 16

def unflattenable_aggregate_uses_sret(size: i64, flat_ok: bool) -> bool:
    requires size > 0 and not flat_ok
    ensure result
    return not flat_ok or size > 16
