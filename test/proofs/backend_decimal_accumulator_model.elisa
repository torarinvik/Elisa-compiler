# Arithmetic model for the inline guard and multiply-add in codegen_binary_ops.elisa.
# The admission checker binds these expressions to that production branch.
module BackendDecimalLiteral:
    public:
        const U64_MAX: u64 = 18446744073709551615.u64()
        const MAX_PREFIX_BEFORE_DECIMAL_DIGIT: u64 = 1844674407370955161.u64()

        def decimal_step_allowed(accumulated: u64, digit: u64) -> bool:
            ensure result == (digit <= 9.u64() and (accumulated < MAX_PREFIX_BEFORE_DECIMAL_DIGIT or (accumulated == MAX_PREFIX_BEFORE_DECIMAL_DIGIT and digit <= 5.u64())))
            false return if digit > 9.u64()
            true return if accumulated < MAX_PREFIX_BEFORE_DECIMAL_DIGIT
            return digit <= 5.u64() if accumulated == MAX_PREFIX_BEFORE_DECIMAL_DIGIT
            false

        def decimal_step_value(accumulated: u64, digit: u64) -> u64:
            requires decimal_step_allowed(accumulated, digit)
            ensure result <= U64_MAX
            return accumulated * 10.u64() + digit
