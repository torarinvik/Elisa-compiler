include "../../src/parser/parser_tokens.elisa"
include "../../src/parser/ast_nodes.elisa"
include "../../src/semantic/type_path_collect_policy.elisa"

def identifier_path_has_one_name_and_no_separators() -> bool can[Memory.Allocate, Abort.Panic]:
    pos: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
    names: mutable darray[sview] = []
    dotted: mutable darray[bool] = []
    collected: bool = SemanticTypePathCollectPolicy::collect(Ast::Expr.Ident("Root", pos), names, dotted)
    ensure result == true
    return collected and names.count == 1 and names[0] == "Root" and dotted.count == 0

def field_path_marks_the_value_separator() -> bool can[Memory.Allocate, Abort.Panic]:
    pos: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
    root: Ast::Expr = Ast::Expr.Ident("Pack", pos)
    expression: Ast::Expr = Ast::Expr.Field(root, "Item", pos)
    names: mutable darray[sview] = []
    dotted: mutable darray[bool] = []
    collected: bool = SemanticTypePathCollectPolicy::collect(expression, names, dotted)
    ensure result == true
    return collected and names.count == 2 and names[0] == "Pack" and names[1] == "Item" and
        dotted.count == 1 and dotted[0]

def scope_path_marks_the_namespace_separator() -> bool can[Memory.Allocate, Abort.Panic]:
    pos: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
    root: Ast::Expr = Ast::Expr.Ident("Pack", pos)
    expression: Ast::Expr = Ast::Expr.Scope(root, "Item", pos)
    names: mutable darray[sview] = []
    dotted: mutable darray[bool] = []
    collected: bool = SemanticTypePathCollectPolicy::collect(expression, names, dotted)
    ensure result == true
    return collected and names.count == 2 and names[0] == "Pack" and names[1] == "Item" and
        dotted.count == 1 and not dotted[0]

def mixed_path_preserves_segment_and_separator_order() -> bool can[Memory.Allocate, Abort.Panic]:
    pos: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
    root: Ast::Expr = Ast::Expr.Ident("Root", pos)
    module: Ast::Expr = Ast::Expr.Scope(root, "Inner", pos)
    value: Ast::Expr = Ast::Expr.Field(module, "Value", pos)
    expression: Ast::Expr = Ast::Expr.Scope(value, "Type", pos)
    names: mutable darray[sview] = []
    dotted: mutable darray[bool] = []
    collected: bool = SemanticTypePathCollectPolicy::collect(expression, names, dotted)
    ensure result == true
    return collected and names.count == 4 and names[0] == "Root" and names[1] == "Inner" and
        names[2] == "Value" and names[3] == "Type" and dotted.count == 3 and
        not dotted[0] and dotted[1] and not dotted[2]

def unsupported_leaf_preserves_existing_output() -> bool can[Memory.Allocate, Abort.Panic]:
    pos: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
    unsupported: Ast::Expr = Ast::Expr.Tuple([], pos)
    expression: Ast::Expr = Ast::Expr.Field(unsupported, "Tail", pos)
    names: mutable darray[sview] = ["Existing"]
    dotted: mutable darray[bool] = [true]
    ensure result == true
    return not SemanticTypePathCollectPolicy::collect(expression, names, dotted) and
        names.count == 1 and names[0] == "Existing" and dotted.count == 1 and dotted[0]
