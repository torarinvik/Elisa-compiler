# Source-linked arithmetic facts for the signed and unsigned bit-int windows.
include "../../src/semantic/bit_int_endpoints.elisa"

def signed_low_endpoint_is_representable(span: i64) -> bool:
    requires span >= 1 and span <= SemanticBitIntEndpoints::SIGNED_SPAN_MAX
    ensure result == true
    low: i64 = SemanticBitIntEndpoints::signed_low_from_span(span)
    return low >= SemanticBitIntEndpoints::SIGNED_LOW_MIN and low >= (0 - 9223372036854775807 - 1) and low < 0

def signed_high_endpoint_is_representable(span: i64) -> bool:
    requires span >= 1 and span <= SemanticBitIntEndpoints::SIGNED_SPAN_MAX
    ensure result == true
    high: i64 = SemanticBitIntEndpoints::signed_high_from_span(span)
    return high >= 0 and high <= SemanticBitIntEndpoints::I64_MAX

def every_signed_window_is_ordered(span: i64) -> bool:
    requires span >= 1 and span <= SemanticBitIntEndpoints::SIGNED_SPAN_MAX
    ensure result == true
    low: i64 = SemanticBitIntEndpoints::signed_low_from_span(span)
    high: i64 = SemanticBitIntEndpoints::signed_high_from_span(span)
    return low <= high

def every_signed_window_contains_zero(span: i64) -> bool:
    requires span >= 1 and span <= SemanticBitIntEndpoints::SIGNED_SPAN_MAX
    ensure result == true
    low: i64 = SemanticBitIntEndpoints::signed_low_from_span(span)
    high: i64 = SemanticBitIntEndpoints::signed_high_from_span(span)
    return low <= 0 and 0 <= high

def signed_one_bit_window_is_minus_one_through_zero() -> bool:
    ensure result == true
    low: i64 = SemanticBitIntEndpoints::signed_low_from_span(1)
    high: i64 = SemanticBitIntEndpoints::signed_high_from_span(1)
    return low == (0 - 1) and high == 0

def signed_sixty_three_bit_window_has_exact_endpoints() -> bool:
    ensure result == true
    low: i64 = SemanticBitIntEndpoints::signed_low_from_span(SemanticBitIntEndpoints::SIGNED_SPAN_MAX)
    high: i64 = SemanticBitIntEndpoints::signed_high_from_span(SemanticBitIntEndpoints::SIGNED_SPAN_MAX)
    return low == (0 - 4611686018427387904) and high == 4611686018427387903

def every_unsigned_window_is_ordered(span: i64) -> bool:
    requires span >= 1 and span <= SemanticBitIntEndpoints::I64_MAX
    ensure result == true
    high: i64 = SemanticBitIntEndpoints::unsigned_high_from_span(span)
    return 0 <= high and high <= SemanticBitIntEndpoints::I64_MAX

def unsigned_one_bit_window_has_zero_high() -> bool:
    ensure result == true
    high: i64 = SemanticBitIntEndpoints::unsigned_high_from_span(1)
    return high == 0

def largest_unsigned_span_has_representable_high() -> bool:
    ensure result == true
    high: i64 = SemanticBitIntEndpoints::unsigned_high_from_span(SemanticBitIntEndpoints::I64_MAX)
    return high == SemanticBitIntEndpoints::I64_MAX - 1
