include "../../src/driver/never_leak_env_values.elisa"

def error_prefix_selects_error_mode() -> bool:
    ensure result == true
    return NeverLeakEnvValues::mode("erratic") == NeverLeakEnvValues::NL_ENV_MODE_ERROR

def strict_prefix_selects_strict_level() -> bool:
    ensure result == true
    return NeverLeakEnvValues::is_strict("staged")

def unknown_mode_disables_lint() -> bool:
    ensure result == true
    return NeverLeakEnvValues::mode("unexpected") == NeverLeakEnvValues::NL_ENV_MODE_OFF
