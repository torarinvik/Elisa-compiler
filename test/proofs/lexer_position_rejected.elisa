module Lexer:
    public:
        const LEXER_POSITION_PROOF_SCOPE: bool = true

include "../../src/lexer/lexer_position.elisa"

def position_does_not_swap_line_and_column(line: int, column: int, offset: usize) -> bool:
    requires line != column
    ensure result == true
    position: Lexer::LexerPosition = Lexer::LexerPosition(line, column, offset)
    return position.line == column
