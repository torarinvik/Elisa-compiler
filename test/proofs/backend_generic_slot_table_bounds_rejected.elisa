include "./backend_generic_slot_table_bounds.elisa"

def false_claim_name_row_implies_declaration_row(slot: usize, name_rows: usize, declaration_rows: usize) -> bool:
    requires slot < name_rows and slot >= declaration_rows
    ensure result == true
    return slot < declaration_rows

def false_claim_name_row_implies_parameter_count_row(slot: usize, name_rows: usize, parameter_count_rows: usize) -> bool:
    requires slot < name_rows and slot >= parameter_count_rows
    ensure result == true
    return slot < parameter_count_rows

def false_claim_name_row_implies_error_metadata_row(slot: usize, name_rows: usize, error_rows: usize) -> bool:
    requires slot < name_rows and slot >= error_rows
    ensure result == true
    return slot < error_rows

def false_claim_one_past_parameter_is_in_pool(total: usize, start: usize, count: usize, offset: usize) -> bool:
    requires start <= total and count <= total - start and offset == count
    ensure result == true
    return offset < count

def false_claim_one_past_type_argument_is_accessible(argument_count: usize, offset: usize) -> bool:
    requires offset == argument_count
    ensure result == true
    return offset < argument_count

def false_claim_generic_callable_one_past_parameter_is_inside_pool(total: usize, start: usize, count: usize, offset: usize) -> bool:
    requires start <= total and count <= total - start and offset == count
    ensure result == true
    return offset < count and start + offset < total

def false_claim_i64_generic_registration_keeps_rows_aligned_without_error_parameter_append(names: i64, declarations: i64, parameter_starts: i64, parameter_counts: i64, error_flags: i64, error_parameters: i64, owners: i64) -> bool:
    requires names >= 0 and names < 9223372036854775807
    requires names == declarations and names == parameter_starts and names == parameter_counts
    requires names == error_flags and names == error_parameters and names == owners
    ensure result == true
    return names + 1 == declarations + 1 and names + 1 == parameter_starts + 1 and names + 1 == parameter_counts + 1 and names + 1 == error_flags + 1 and names + 1 == error_parameters and names + 1 == owners + 1
