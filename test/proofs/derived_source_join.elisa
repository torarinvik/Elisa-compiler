include "../../src/semantic/ownership_flow_domain.elisa"

# Current-state join policy. The AST traversal/binding resolver is not proved here.
def all_reachable_sources_known(left_reachable: bool, left_known: bool, right_reachable: bool, right_known: bool) -> bool:
    ensure result == ((left_reachable or right_reachable) and (not left_reachable or left_known) and (not right_reachable or right_known))
    return OwnershipFlow::join_reachable_known(left_reachable, left_known, right_reachable, right_known)

def unknown_live_source_blocks_join(right_reachable: bool, right_known: bool) -> bool:
    ensure result == false
    return all_reachable_sources_known(true, false, right_reachable, right_known)

def dead_source_does_not_destroy_knowledge(left_known: bool, right_known: bool) -> bool:
    ensure result == left_known
    return all_reachable_sources_known(true, left_known, false, right_known)

def dead_sources_do_not_grant_knowledge(left_known: bool, right_known: bool) -> bool:
    ensure result == false
    return all_reachable_sources_known(false, left_known, false, right_known)

def current_state_possible(left_reachable: bool, left_state: bool, right_reachable: bool, right_state: bool) -> bool:
    ensure result == ((left_reachable and left_state) or (right_reachable and right_state))
    return OwnershipFlow::join_reachable_possible(left_reachable, left_state, right_reachable, right_state)

def live_state_cannot_be_dropped(peer_reachable: bool, peer_state: bool) -> bool:
    ensure result == true
    return current_state_possible(true, true, peer_reachable, peer_state)
