include "./linear_add_sub_overflow.elisa"

def false_positive_add_guard_accepts_overflow(left: i64, right: i64) -> bool:
    requires right > 0 and left > 9223372036854775807 - right
    ensure result == true
    return left <= 9223372036854775807 - right

def false_negative_add_guard_accepts_underflow(left: i64, right: i64) -> bool:
    requires right < 0 and left < (0 - 9223372036854775807 - 1) - right
    ensure result == true
    return left >= (0 - 9223372036854775807 - 1) - right

def false_positive_sub_guard_accepts_underflow(left: i64, right: i64) -> bool:
    requires right > 0 and left < (0 - 9223372036854775807 - 1) + right
    ensure result == true
    return left >= (0 - 9223372036854775807 - 1) + right

def false_negative_sub_guard_accepts_overflow(left: i64, right: i64) -> bool:
    requires right < 0 and left > 9223372036854775807 + right
    ensure result == true
    return left <= 9223372036854775807 + right
