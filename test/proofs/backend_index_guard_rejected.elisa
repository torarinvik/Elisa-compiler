include "./backend_index_guard.elisa"

def false_claim_negative_signed_index_can_pass(unsigned_in_bounds: bool) -> bool:
    requires unsigned_in_bounds
    ensure result == true
    return signed_index_guard(false, unsigned_in_bounds)

def false_claim_negative_untyped_literal_is_unsigned(expected_is_signed: bool) -> bool:
    requires not expected_is_signed
    ensure result == true
    return not index_source_is_signed(false, false, expected_is_signed, true)

def false_claim_out_of_bounds_unsigned_index_is_accepted(index_nonnegative: bool) -> bool:
    requires index_nonnegative
    ensure result == true
    return signed_index_guard(index_nonnegative, false)

def false_claim_negative_untyped_literal_can_pass_index_guard(untyped_integer_literal: bool, expected_is_signed: bool, unsigned_in_bounds: bool) -> bool:
    requires untyped_integer_literal
    ensure result == true
    source_is_signed: bool = untyped_integer_literal or expected_is_signed
    return signed_index_guard(not source_is_signed, unsigned_in_bounds)
