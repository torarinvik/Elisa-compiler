include "./backend_index_guard.elisa"

def false_claim_negative_signed_index_can_pass(unsigned_in_bounds: bool) -> bool:
    requires unsigned_in_bounds
    ensure result == true
    return signed_index_guard(false, unsigned_in_bounds)

def false_claim_negative_untyped_literal_is_unsigned(expected_is_signed: bool) -> bool:
    requires not expected_is_signed
    ensure result == true
    return not index_source_is_signed(false, false, expected_is_signed, true)
