include "../../src/semantic/binding_identity_types.elisa"
include "../../src/semantic/ownership_flow_domain.elisa"
include "../../src/semantic/ownership_binding_flow.elisa"

def binding_identity_reflexive(id: Semantic::BindingId) -> bool:
    ensure result == true
    return Semantic::ownership_binding_ids_equal(id, id)

def serial_zero_is_valid(owner: u32) -> bool:
    requires owner != 4294967295
    ensure result == true
    return Semantic::ownership_binding_id_valid(Semantic::BindingId{owner: Semantic::DeclId{value: owner}, serial: 0})
