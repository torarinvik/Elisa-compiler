include "../../src/semantic/binding_identity_types.elisa"
include "../../src/semantic/ownership_flow_domain.elisa"
include "../../src/semantic/ownership_binding_flow.elisa"

const FIRST_BINDING_SERIAL: u64 = Semantic::FIRST_BINDING_SERIAL

def binding_identity_reflexive(id: Semantic::BindingId) -> bool:
    ensure result == true
    return Semantic::ownership_binding_ids_equal(id, id)

def serial_zero_is_valid(owner: u32) -> bool:
    requires owner != Semantic::INVALID_DECL_ID_VALUE
    ensure result == true
    return Semantic::ownership_binding_id_valid(Semantic::BindingId{owner: Semantic::DeclId{value: owner}, serial: FIRST_BINDING_SERIAL})

def missing_declaration_is_invalid(serial: u64) -> bool:
    ensure result == false
    return Semantic::ownership_binding_id_valid(Semantic::BindingId{owner: Semantic::DeclId{value: Semantic::INVALID_DECL_ID_VALUE},
        serial: serial})
