include "./region_escape_view_method.elisa"

def ordinary_count_method_is_view() -> bool:
    ensure result == true
    return SemanticRegionEscapeViewMethod::is_view_method("count")

def unlisted_view_method_is_borrowed() -> bool:
    ensure result == true
    return SemanticRegionEscapeViewMethod::is_view_method("as_bytes")
