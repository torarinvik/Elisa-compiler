# Integer encoding of the exact operation-to-capability table in easm_required_capability.
# The admission checker binds each row to its production opcode spellings and consumer.
const OP_XCHG: i64 = 0
const OP_CPUID: i64 = 1
const OP_RDTSC: i64 = 2
const OP_LFENCE: i64 = 3
const OP_PAUSE: i64 = 4
const OP_YIELD: i64 = 5
const OP_MRS: i64 = 6
const OP_ISB: i64 = 7
const OP_FLDCW: i64 = 8
const OP_FNSTCW: i64 = 9
const OP_STMXCSR: i64 = 10
const OP_LDMXCSR: i64 = 11
const OP_EMMS: i64 = 12
const OP_VZEROALL: i64 = 13
const OP_TRAP: i64 = 14
const OP_ORDINARY: i64 = 15
const OP_UNKNOWN: i64 = 16

const CAP_NONE: i64 = 0
const CAP_ATOMIC_RMW: i64 = 1
const CAP_CPUID: i64 = 2
const CAP_RDTSC: i64 = 3
const CAP_LFENCE: i64 = 4
const CAP_PAUSE: i64 = 5
const CAP_YIELD: i64 = 6
const CAP_COUNTER: i64 = 7
const CAP_FPU_CONTROL: i64 = 8
const CAP_SIMD_STATE: i64 = 9
const CAP_DEBUG_TRAP: i64 = 10

def all_opcode_and_capability_codes_are_canonical() -> bool:
    ensure result == true
    return (
        OP_XCHG == 0 and OP_CPUID == 1 and OP_RDTSC == 2 and OP_LFENCE == 3 and
        OP_PAUSE == 4 and OP_YIELD == 5 and OP_MRS == 6 and OP_ISB == 7 and
        OP_FLDCW == 8 and OP_FNSTCW == 9 and OP_STMXCSR == 10 and OP_LDMXCSR == 11 and
        OP_EMMS == 12 and OP_VZEROALL == 13 and OP_TRAP == 14 and OP_ORDINARY == 15 and
        OP_UNKNOWN == 16 and CAP_NONE == 0 and CAP_ATOMIC_RMW == 1 and CAP_CPUID == 2 and
        CAP_RDTSC == 3 and CAP_LFENCE == 4 and CAP_PAUSE == 5 and CAP_YIELD == 6 and
        CAP_COUNTER == 7 and CAP_FPU_CONTROL == 8 and CAP_SIMD_STATE == 9 and CAP_DEBUG_TRAP == 10
    )

def xchg_family_requires_atomic_rmw() -> bool:
    ensure result == true
    return OP_XCHG == 0 and CAP_ATOMIC_RMW == 1

def cpuid_requires_cpuid_capability() -> bool:
    ensure result == true
    return OP_CPUID == 1 and CAP_CPUID == 2

def rdtsc_requires_counter_capability() -> bool:
    ensure result == true
    return OP_RDTSC == 2 and CAP_RDTSC == 3

def lfence_requires_fence_capability() -> bool:
    ensure result == true
    return OP_LFENCE == 3 and CAP_LFENCE == 4

def pause_requires_pause_capability() -> bool:
    ensure result == true
    return OP_PAUSE == 4 and CAP_PAUSE == 5

def yield_requires_aarch64_capability() -> bool:
    ensure result == true
    return OP_YIELD == 5 and CAP_YIELD == 6

def counter_instructions_share_the_counter_capability() -> bool:
    ensure result == true
    return OP_MRS == 6 and OP_ISB == 7 and CAP_COUNTER == 7

def floating_point_control_instructions_share_one_capability() -> bool:
    ensure result == true
    return (
        OP_FLDCW == 8 and OP_FNSTCW == 9 and OP_STMXCSR == 10 and
        OP_LDMXCSR == 11 and OP_EMMS == 12 and CAP_FPU_CONTROL == 8
    )

def zero_all_requires_simd_state_capability() -> bool:
    ensure result == true
    return OP_VZEROALL == 13 and CAP_SIMD_STATE == 9

def trap_requires_debug_capability() -> bool:
    ensure result == true
    return OP_TRAP == 14 and CAP_DEBUG_TRAP == 10

def ordinary_operation_has_no_special_capability() -> bool:
    ensure result == true
    return OP_ORDINARY == 15 and CAP_NONE == 0

def unknown_operation_has_no_special_capability() -> bool:
    ensure result == true
    return OP_UNKNOWN == 16 and CAP_NONE == 0
