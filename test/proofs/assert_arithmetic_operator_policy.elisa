# Source-linked proof of the arithmetic-token set used by assert condition checking.
include "./parser_token_kind_projection.elisa"
include "../../src/semantic/assert_arithmetic_operator_policy.elisa"

def source_classifier_has_exact_arithmetic_set(operator: Lexer::TokenKind) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return AssertArithmeticOperatorPolicy::is_arithmetic(operator) == (
            when operator:
                Lexer::TokenKind.Plus | Lexer::TokenKind.Minus | Lexer::TokenKind.Star | Lexer::TokenKind.Slash | Lexer::TokenKind.Percent -> true
                _ -> false
        )

def every_arithmetic_operator_is_classified() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            AssertArithmeticOperatorPolicy::is_arithmetic(Lexer::TokenKind.Plus)
            and AssertArithmeticOperatorPolicy::is_arithmetic(Lexer::TokenKind.Minus)
            and AssertArithmeticOperatorPolicy::is_arithmetic(Lexer::TokenKind.Star)
            and AssertArithmeticOperatorPolicy::is_arithmetic(Lexer::TokenKind.Slash)
            and AssertArithmeticOperatorPolicy::is_arithmetic(Lexer::TokenKind.Percent)
        )

def non_arithmetic_operators_remain_unclassified() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            not AssertArithmeticOperatorPolicy::is_arithmetic(Lexer::TokenKind.EqEq)
            and not AssertArithmeticOperatorPolicy::is_arithmetic(Lexer::TokenKind.And)
            and not AssertArithmeticOperatorPolicy::is_arithmetic(Lexer::TokenKind.Assign)
            and not AssertArithmeticOperatorPolicy::is_arithmetic(Lexer::TokenKind.LShift)
        )
