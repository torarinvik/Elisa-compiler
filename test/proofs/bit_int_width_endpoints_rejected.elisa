include "./bit_int_width_endpoints.elisa"

def false_signed_low_is_nonnegative(span: i64) -> bool:
    requires span >= 1 and span <= SemanticBitIntEndpoints::SIGNED_SPAN_MAX
    ensure result == true
    return SemanticBitIntEndpoints::signed_low_from_span(span) >= 0

def false_signed_high_reaches_the_span(span: i64) -> bool:
    requires span >= 1 and span <= SemanticBitIntEndpoints::SIGNED_SPAN_MAX
    ensure result == true
    return SemanticBitIntEndpoints::signed_high_from_span(span) >= span

def false_unsigned_high_reaches_the_span(span: i64) -> bool:
    requires span >= 1 and span <= SemanticBitIntEndpoints::I64_MAX
    ensure result == true
    return SemanticBitIntEndpoints::unsigned_high_from_span(span) >= span

def false_signed_sixty_three_high_is_i64_max() -> bool:
    ensure result == true
    return SemanticBitIntEndpoints::signed_high_from_span(SemanticBitIntEndpoints::SIGNED_SPAN_MAX) == SemanticBitIntEndpoints::I64_MAX

def false_unsigned_one_bit_high_is_one() -> bool:
    ensure result == true
    return SemanticBitIntEndpoints::unsigned_high_from_span(1) == 1
