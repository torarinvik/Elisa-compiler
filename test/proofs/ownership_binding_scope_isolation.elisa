# General binding separation: neither arbitrary serials nor a shared spelling
# can erase function-owner identity. This is an identity law, not proof of the
# legacy name-keyed nominal type checker.
include "../../src/semantic/binding_identity_types.elisa"
include "../../src/semantic/ownership_flow_domain.elisa"
include "../../src/semantic/ownership_binding_flow.elisa"

def distinct_owners_arbitrary_serials(first_owner: u32, second_owner: u32, first_serial: u64, second_serial: u64) -> bool:
    requires first_owner != second_owner
    ensure result == false
    return Semantic::ownership_binding_ids_equal(Semantic::BindingId{owner: Semantic::DeclId{value: first_owner}, serial: first_serial}, Semantic::BindingId{owner: Semantic::DeclId{value: second_owner}, serial: second_serial})

def distinct_serials_arbitrary_owner(owner: u32, first_serial: u64, second_serial: u64) -> bool:
    requires first_serial != second_serial
    ensure result == false
    return Semantic::ownership_binding_ids_equal(Semantic::BindingId{owner: Semantic::DeclId{value: owner}, serial: first_serial}, Semantic::BindingId{owner: Semantic::DeclId{value: owner}, serial: second_serial})
