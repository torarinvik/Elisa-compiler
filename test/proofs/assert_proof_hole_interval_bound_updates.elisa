# Arithmetic laws for comparison flipping and interval intersection in
# aph_apply_bound. The companion checker binds these lemmas to the source map.

def flipped_gt_to_lt(left: i64, right: i64) -> bool:
    requires left > right
    ensure result == true
    return right < left

def flipped_lt_to_gt(left: i64, right: i64) -> bool:
    requires left < right
    ensure result == true
    return right > left

def flipped_ge_to_le(left: i64, right: i64) -> bool:
    requires left >= right
    ensure result == true
    return right <= left

def flipped_le_to_ge(left: i64, right: i64) -> bool:
    requires left <= right
    ensure result == true
    return right >= left

def flipped_eq_to_eq(left: i64, right: i64) -> bool:
    requires left == right
    ensure result == true
    return right == left

def flipped_neq_to_neq(left: i64, right: i64) -> bool:
    requires left != right
    ensure result == true
    return right != left

def flipped_lt_to_gt_back(left: i64, right: i64) -> bool:
    requires right < left
    ensure result == true
    return left > right

def flipped_gt_to_lt_back(left: i64, right: i64) -> bool:
    requires right > left
    ensure result == true
    return left < right

def flipped_le_to_ge_back(left: i64, right: i64) -> bool:
    requires right <= left
    ensure result == true
    return left >= right

def flipped_ge_to_le_back(left: i64, right: i64) -> bool:
    requires right >= left
    ensure result == true
    return left <= right

def flipped_eq_to_eq_back(left: i64, right: i64) -> bool:
    requires right == left
    ensure result == true
    return left == right

def flipped_neq_to_neq_back(left: i64, right: i64) -> bool:
    requires right != left
    ensure result == true
    return left != right

# Tightening a lower bound keeps every value satisfying both bounds inside the
# intersection. Retaining the stronger old bound also preserves soundness.
def stronger_lower_bound_sound(value: i64, previous: i64, candidate: i64) -> bool:
    requires value >= previous and value >= candidate
    ensure result == true
    return value >= (previous if previous > candidate else candidate)

def weaker_lower_bound_preserves_soundness(value: i64, previous: i64, candidate: i64) -> bool:
    requires value >= previous and candidate <= previous
    ensure result == true
    return value >= candidate

def stronger_upper_bound_sound(value: i64, previous: i64, candidate: i64) -> bool:
    requires value <= previous and value <= candidate
    ensure result == true
    return value <= (previous if previous < candidate else candidate)

def weaker_upper_bound_preserves_soundness(value: i64, previous: i64, candidate: i64) -> bool:
    requires value <= previous and candidate >= previous
    ensure result == true
    return value <= candidate

# Strict comparisons become closed bounds only when the adjacent i64 value is
# representable. These preconditions are the guards used by the safe helpers.
def strict_lower_threshold_forward(value: i64, bound: i64) -> bool:
    requires bound < 9223372036854775807 and value > bound
    ensure result == true
    return value >= bound + 1

def strict_lower_threshold_reverse(value: i64, bound: i64) -> bool:
    requires bound < 9223372036854775807 and value >= bound + 1
    ensure result == true
    return value > bound

def strict_upper_threshold_forward(value: i64, bound: i64) -> bool:
    requires bound > (0 - 9223372036854775807 - 1) and value < bound
    ensure result == true
    return value <= bound - 1

def strict_upper_threshold_reverse(value: i64, bound: i64) -> bool:
    requires bound > (0 - 9223372036854775807 - 1) and value <= bound - 1
    ensure result == true
    return value < bound
