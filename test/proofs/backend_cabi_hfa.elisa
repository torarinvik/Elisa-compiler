# HFA recognition requires one through four contiguous leaves of one float kind.
def cabi_hfa_count_policy(leaf_count: i64, first_leaf_is_float: bool, all_leaf_kinds_match: bool, offsets_are_contiguous: bool) -> i64:
    requires leaf_count >= 0
    ensure result == (leaf_count if leaf_count >= 1 and leaf_count <= 4 and first_leaf_is_float and all_leaf_kinds_match and offsets_are_contiguous else 0)
    return leaf_count if leaf_count >= 1 and leaf_count <= 4 and first_leaf_is_float and all_leaf_kinds_match and offsets_are_contiguous else 0

def one_float_leaf_is_an_hfa(first_leaf_is_float: bool, all_leaf_kinds_match: bool, offsets_are_contiguous: bool) -> i64:
    requires first_leaf_is_float and all_leaf_kinds_match and offsets_are_contiguous
    ensure result == 1
    return 1

def four_float_leaves_are_the_maximum_hfa(all_leaf_kinds_match: bool, offsets_are_contiguous: bool) -> i64:
    requires all_leaf_kinds_match and offsets_are_contiguous
    ensure result == 4
    return 4

def a_fifth_float_leaf_is_not_an_hfa(all_leaf_kinds_match: bool, offsets_are_contiguous: bool) -> i64:
    requires all_leaf_kinds_match and offsets_are_contiguous
    ensure result == 0
    return 0
