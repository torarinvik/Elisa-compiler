include "./backend_reduce_sum_bounds.elisa"

def false_claim_one_past_reduce_sum_index_is_bounded(index: u64, count: u64) -> bool:
    requires index == count
    ensure result == true
    return index < count

def false_claim_reduce_sum_step_stays_strictly_below_count(index: u64, count: u64) -> bool:
    requires index < count
    requires index + 1 == count
    ensure result == true
    return index + 1 < count
