include "./derived_source_snapshot.elisa"

def declaration_is_current_state() -> bool:
    ensure result == true
    return source_snapshot_matches(true, false, 1, 0, 1, 0)

def unchanged_field_change_can_relabel_state() -> bool:
    ensure result == true
    return source_snapshot_matches(true, true, 1, 0, 1, 1)
