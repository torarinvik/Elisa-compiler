include "./frontend_ir_builtin_type_name.elisa"

def array_must_remain_generic() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not FrontendIrBuiltinTypeName::is_builtin_type_name("array")

def ordinary_type_must_be_builtin() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return FrontendIrBuiltinTypeName::is_builtin_type_name("i64")
