include "../../src/driver/wasm_scalar_wasm_type.elisa"

def f64_must_not_be_narrowed_to_f32() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return WasmScalarWasmType::wasm_scalar_wasm_type("f64") == "f32"

def unlisted_scalar_must_not_receive_an_abi_type() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return WasmScalarWasmType::wasm_scalar_wasm_type("f128") == "i32"
