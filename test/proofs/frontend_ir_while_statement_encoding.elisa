# Source-linked laws for statement-form WhileStmt schema encoding.
include "../../src/driver/frontend_ir_while_statement_encoding.elisa"

const EXPECTED_WHILE_STMT_NODE_TYPE_ID: u32 = 276
const EXPECTED_WHILE_BODY_FIELD_ID: u32 = 1
const EXPECTED_WHILE_CONDITION_FIELD_ID: u32 = 3
const EXPECTED_WHILE_POSITION_FIELD_ID: u32 = 5

def source_while_statement_node_type_id_is_exact() -> u32:
    ensure result == EXPECTED_WHILE_STMT_NODE_TYPE_ID
    return FrontendIrWhileStatementEncoding::node_type_id()

def source_while_statement_field_id_is_exact(field: FrontendIrWhileStatementEncoding::WhileStmtField) -> u32:
    ensure field != FrontendIrWhileStatementEncoding::WhileStmtField.Body or result == EXPECTED_WHILE_BODY_FIELD_ID
    ensure field != FrontendIrWhileStatementEncoding::WhileStmtField.Condition or result == EXPECTED_WHILE_CONDITION_FIELD_ID
    ensure field != FrontendIrWhileStatementEncoding::WhileStmtField.Position or result == EXPECTED_WHILE_POSITION_FIELD_ID
    return FrontendIrWhileStatementEncoding::field_id(field)

def while_statement_field_ids_are_distinct() -> bool:
    ensure result == true
    return (
        FrontendIrWhileStatementEncoding::field_id(FrontendIrWhileStatementEncoding::WhileStmtField.Body)
            != FrontendIrWhileStatementEncoding::field_id(FrontendIrWhileStatementEncoding::WhileStmtField.Condition)
        and FrontendIrWhileStatementEncoding::field_id(FrontendIrWhileStatementEncoding::WhileStmtField.Body)
            != FrontendIrWhileStatementEncoding::field_id(FrontendIrWhileStatementEncoding::WhileStmtField.Position)
        and FrontendIrWhileStatementEncoding::field_id(FrontendIrWhileStatementEncoding::WhileStmtField.Condition)
            != FrontendIrWhileStatementEncoding::field_id(FrontendIrWhileStatementEncoding::WhileStmtField.Position)
    )
