# Regression proof: distinct numeric-looking strings must select distinct match arms.

def string_01_selects_its_exact_arm(value: sview) -> bool:
    requires value == "01"
    ensure result == true
    match value:
        "01":
            return true
        "1":
            return false
        _:
            return false
    return false

def string_01_selects_its_exact_arm_when_second(value: sview) -> bool:
    requires value == "01"
    ensure result == true
    match value:
        "1":
            return false
        "01":
            return true
        _:
            return false
    return false

def string_1_selects_its_exact_arm(value: sview) -> bool:
    requires value == "1"
    ensure result == true
    match value:
        "01":
            return false
        "1":
            return true
        _:
            return false
    return false

def boolean_true_selects_its_exact_arm(value: bool) -> bool:
    requires value == true
    ensure result == true
    match value:
        true:
            return true
        false:
            return false
    return false

def integer_one_selects_its_exact_arm(value: i64) -> bool:
    requires value == 1
    ensure result == true
    match value:
        1:
            return true
        0:
            return false
        _:
            return false
    return false
