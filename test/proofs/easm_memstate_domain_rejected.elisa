include "../../src/backend/easm_memstate_domain.elisa"

def join_guard_accepts_a_read_missing_from_one_branch() -> bool:
    ensure result == true
    return EasmMemStateDomain::guard_join(4, 12, 8)

def greatest_bound_discards_the_stronger_fact(left: i64, right: i64) -> bool:
    requires left < right
    ensure result == true
    return EasmMemStateDomain::greatest_bound(left, right) == left

def joined_path_accepts_without_a_covering_fact_on_the_right() -> bool:
    ensure result == true
    left_bound: i64 = EasmMemStateDomain::greatest_bound(8, 2)
    right_bound: i64 = EasmMemStateDomain::greatest_bound(4, 3)
    return EasmMemStateDomain::guard_join(left_bound, right_bound, 8)
