# Arithmetic refinement for the sorted line-window binary searches used by semantic checks.
# The source checker binds each comparator and interval update to region_annotation_order.elisa.

def lower_bound_midpoint_stays_inside(low: usize, high: usize, count: usize) -> bool:
    requires low < high and high <= count
    ensure result == true
    middle: usize = low + (high - low) / 2
    return middle >= low and middle < high and middle < count

def upper_bound_midpoint_stays_inside(low: usize, high: usize, count: usize) -> bool:
    requires low < high and high <= count
    ensure result == true
    middle: usize = low + (high - low) / 2
    return middle >= low and middle < high and middle < count

# On a nondecreasing line array, the lower-bound branch is sound because a midpoint
# below LOW must be strictly before the first row whose line is at least LOW.
def lower_bound_advance_preserves_first_ge_cut(low: usize, high: usize, middle: usize, cut: usize) -> bool:
    requires low <= middle and middle < high and middle < cut and cut <= high
    ensure result == true
    next_low: usize = middle + 1
    return next_low > low and next_low <= cut and cut <= high and high - next_low < high - low

def lower_bound_retreat_preserves_first_ge_cut(low: usize, high: usize, middle: usize, cut: usize) -> bool:
    requires low <= cut and cut <= middle and middle < high
    ensure result == true
    next_high: usize = middle
    return low <= cut and cut <= next_high and next_high < high and next_high - low < high - low

# The upper-bound search uses the same interval updates with the cut defined as the
# first row whose line is strictly greater than HIGH.
def upper_bound_advance_preserves_first_gt_cut(low: usize, high: usize, middle: usize, cut: usize) -> bool:
    requires low <= middle and middle < high and middle < cut and cut <= high
    ensure result == true
    next_low: usize = middle + 1
    return next_low > low and next_low <= cut and cut <= high and high - next_low < high - low

def upper_bound_retreat_preserves_first_gt_cut(low: usize, high: usize, middle: usize, cut: usize) -> bool:
    requires low <= cut and cut <= middle and middle < high
    ensure result == true
    next_high: usize = middle
    return low <= cut and cut <= next_high and next_high < high and next_high - low < high - low

def the_initial_full_interval_contains_any_valid_cut(count: usize, cut: usize) -> bool:
    requires cut <= count
    ensure result == true
    low: usize = 0
    high: usize = count
    return low <= cut and cut <= high

def unsorted_fallback_window_covers_every_row(count: usize) -> bool:
    ensure result == true
    start: usize = 0
    stop: usize = count
    return start == 0 and stop == count

# The address/count/endpoint memo key does not establish that the interior rows are
# unchanged. This low-valued witness uses only integer equality and line ordering; all
# values fit in u32/usize/uintptr, while `address` stands for the reused buffer identity.
def same_cache_identity_can_hide_interior_reordering(address: i64) -> bool:
    ensure result == true
    old_base: i64 = address
    new_base: i64 = address
    old_count: i64 = 3
    new_count: i64 = 3
    old_first: i64 = 10
    old_middle: i64 = 11
    old_last: i64 = 12
    new_first: i64 = 10
    new_middle: i64 = 9
    new_last: i64 = 12
    old_sorted: bool = old_first <= old_middle and old_middle <= old_last
    new_sorted: bool = new_first <= new_middle and new_middle <= new_last
    return old_base == new_base and old_count == new_count and old_first == new_first and old_last == new_last and old_sorted and not new_sorted
