# These false claims must remain unproved: the parser must reject oversized spans and u64 overflow.

def oversized_span_is_admitted(start: usize, length: usize, total: usize) -> bool:
    requires start <= total and length > total - start
    ensure result == true
    return length <= total - start

def high_tenth_byte_payload_is_admitted(payload: u8) -> bool:
    requires payload > 1
    ensure result == true
    return payload <= 1

def continued_tenth_byte_is_admitted(payload: u8, continuation: bool) -> bool:
    requires payload <= 1 and continuation
    ensure result == true
    return not continuation and payload <= 1

def oversized_u32_identifier_is_accepted(identifier: u64) -> bool:
    requires identifier > 4294967295
    ensure result == true
    return identifier <= 4294967295

def oversized_table_count_is_accepted(count: u64, input_bytes: u64) -> bool:
    requires count > input_bytes
    ensure result == true
    return count <= input_bytes

def zero_root_is_accepted(root: u64) -> bool:
    requires root == 0
    ensure result == true
    return root > 0

def root_after_node_table_is_accepted(root: u64, node_count: u64) -> bool:
    requires root > node_count
    ensure result == true
    return root <= node_count

def unsupported_ir_version_is_admitted(version: u64) -> bool:
    requires version != 2
    ensure result == true
    return version == 2

def schema_tag_cursor_can_advance_past_input(offset: usize, total: usize) -> bool:
    requires offset < total
    ensure result == true
    return offset + 1 > total

def truncated_list_with_no_child_is_admitted(offset: usize, total: usize) -> bool:
    requires offset <= total and total - offset == 1
    ensure result == true
    return total - offset > 1

def truncated_map_with_one_child_tag_is_admitted(offset: usize, total: usize) -> bool:
    requires offset <= total and total - offset == 2
    ensure result == true
    return total - offset >= 3

def continued_tenth_varint_group_stays_within_shift_limit(shift: u32) -> bool:
    requires shift == 63
    ensure result == true
    return shift + 7 <= 63

def continuation_before_tenth_group_can_exceed_shift_limit(shift: u32) -> bool:
    requires shift <= 56
    ensure result == true
    return shift + 7 > 63
