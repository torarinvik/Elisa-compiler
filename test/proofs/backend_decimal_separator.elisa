# The backend accepts `_` only after and before digits. These bounds prove both
# neighboring byte reads stay inside the literal span.
def separator_neighbor_indices_are_inside_the_literal(start: usize, index: usize, length: usize) -> bool:
    requires start < index
    requires index < length
    requires length - index > 1
    ensure result == true
    return index - 1 >= start and index + 1 < length

def separator_in_one_thousand_is_valid() -> bool:
    ensure result == true
    return 0 < 1 and 1 < 5 and 5 - 1 > 1 and 49 >= 48 and 49 <= 57 and 48 >= 48 and 48 <= 57

def one_thousand_with_a_separator_folds_to_one_thousand() -> bool:
    ensure result == true
    after_first_digit: i64 = 1
    after_separator: i64 = after_first_digit
    after_first_zero: i64 = after_separator * 10 + 0
    after_second_zero: i64 = after_first_zero * 10 + 0
    after_third_zero: i64 = after_second_zero * 10 + 0
    return 0 < 1 and 1 < 5 and 5 - 1 > 1 and 49 >= 48 and 49 <= 57 and 48 >= 48 and 48 <= 57 and after_separator == 1 and after_third_zero == 1000

def overflowing_literal_separator_is_between_digits() -> bool:
    ensure result == true
    return 0 < 19 and 19 < 21 and 21 - 19 > 1 and 49 >= 48 and 49 <= 57 and 54 >= 48 and 54 <= 57
