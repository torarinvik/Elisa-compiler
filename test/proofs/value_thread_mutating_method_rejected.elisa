include "./value_thread_mutating_method.elisa"

def read_only_method_must_not_be_mutating() -> bool:
    ensure result == true
    return AstValueThreadMutatingMethod::is_mutating_method("get")

def unrelated_method_must_not_be_mutating() -> bool:
    ensure result == true
    return AstValueThreadMutatingMethod::is_mutating_method("refresh")
