include "./backend_literal_utf8_four_byte.elisa"

def false_supplementary_lead_byte_accepts_bmp(codepoint: i64) -> i64:
    requires codepoint >= 0 and codepoint <= 65535
    ensure result >= 241
    return 240 + (codepoint / 262144)

def false_utf8_lead_byte_accepts_above_unicode_max(codepoint: i64) -> i64:
    requires codepoint >= 1310720 and codepoint <= 1310720
    ensure result <= 244
    return 240 + (codepoint / 262144)
