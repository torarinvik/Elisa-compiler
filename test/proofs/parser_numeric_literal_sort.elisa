# Prove the whitelist and source-span gates for numeric literal sort annotations.
include "../../src/parser/parser_numeric_literal_sort_model.elisa"

def integer_token_is_accepted() -> bool:
    ensure result == true
    return ParserNumericLiteralSort::accepts_integer_token(true, false)

def hexadecimal_integer_token_is_accepted() -> bool:
    ensure result == true
    return ParserNumericLiteralSort::accepts_integer_token(false, true)

def float_token_is_not_accepted() -> bool:
    ensure result == true
    return not ParserNumericLiteralSort::accepts_integer_token(false, false)

def identifier_token_is_not_accepted() -> bool:
    ensure result == true
    return not ParserNumericLiteralSort::accepts_integer_token(false, false)

def token_kind_gate_matches_exact_integer_set(is_integer: bool, is_hex: bool) -> bool:
    ensure result == true
    return ParserNumericLiteralSort::accepts_integer_token(is_integer, is_hex) == (is_integer or is_hex)

def every_supported_signed_or_unsigned_suffix_is_accepted(suffix: sview) -> bool:
    requires suffix == "u8" or suffix == "u16" or suffix == "u32" or suffix == "u64" or suffix == "usize" or suffix == "i8" or suffix == "i16" or suffix == "i32" or suffix == "i64" or suffix == "isize"
    ensure result == true
    return ParserNumericLiteralSort::accepts_suffix(suffix)

def suffix_gate_matches_exact_width_whitelist(suffix: sview) -> bool:
    ensure result == true
    return ParserNumericLiteralSort::accepts_suffix(suffix) == (
        when suffix:
            "u8" | "u16" | "u32" | "u64" | "usize" | "i8" | "i16" | "i32" | "i64" | "isize" -> true
            _ -> false
    )

def u8_suffix_is_accepted() -> bool:
    ensure result == true
    return ParserNumericLiteralSort::accepts_suffix("u8")

def isize_suffix_is_accepted() -> bool:
    ensure result == true
    return ParserNumericLiteralSort::accepts_suffix("isize")

def span_strictly_inside_source_fits(start: usize, length: usize, source_length: usize) -> bool:
    requires start < source_length
    requires length <= source_length - start
    ensure result == true
    return ParserNumericLiteralSort::span_fits(start, length, source_length)

def admitted_text_span_end_does_not_exceed_source(start: usize, length: usize, source_length: usize) -> bool:
    requires start < source_length
    requires length <= source_length - start
    ensure result == true
    return start + length <= source_length

def proved_span_end_equals_start_plus_length(start: usize, length: usize, source_length: usize) -> bool:
    requires start < source_length
    requires length <= source_length - start
    ensure result == true
    return ParserNumericLiteralSort::span_end(start, length, source_length) == start + length

def proved_span_end_stays_inside_source(start: usize, length: usize, source_length: usize) -> bool:
    requires start < source_length
    requires length <= source_length - start
    ensure result == true
    return ParserNumericLiteralSort::span_end(start, length, source_length) <= source_length

def span_ending_at_source_end_fits(start: usize, source_length: usize) -> bool:
    requires start < source_length
    ensure result == true
    return ParserNumericLiteralSort::span_fits(start, source_length - start, source_length)

def adjacent_admitted_text_and_suffix_stay_in_source(start: usize, text_length: usize, suffix_length: usize, source_length: usize) -> bool:
    requires start < source_length
    requires text_length <= source_length - start
    requires start + text_length < source_length
    requires suffix_length <= source_length - (start + text_length)
    ensure result == true
    return start + text_length + suffix_length <= source_length

def span_beyond_source_does_not_fit(start: usize, length: usize, source_length: usize) -> bool:
    requires start < source_length
    requires length > source_length - start
    ensure result == true
    return not ParserNumericLiteralSort::span_fits(start, length, source_length)
