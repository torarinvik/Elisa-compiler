# Accepted branches of Semantic.linear_add_safe and linear_sub_safe.
# The source checker binds these exact guards and results to the production helpers.
def safe_positive_add(left: i64, right: i64) -> i64:
    requires right > 0
    requires left <= 9223372036854775807 - right
    ensure result == left + right
    return left + right

def safe_negative_add(left: i64, right: i64) -> i64:
    requires right < 0
    requires left >= (0 - 9223372036854775807 - 1) - right
    ensure result == left + right
    return left + right

def safe_zero_add(left: i64, right: i64) -> i64:
    requires right == 0
    ensure result == left
    return left + right

def safe_positive_sub(left: i64, right: i64) -> i64:
    requires right > 0
    requires left >= (0 - 9223372036854775807 - 1) + right
    ensure result == left - right
    return left - right

def safe_negative_sub(left: i64, right: i64) -> i64:
    requires right < 0
    requires left <= 9223372036854775807 + right
    ensure result == left - right
    return left - right

def safe_zero_sub(left: i64, right: i64) -> i64:
    requires right == 0
    ensure result == left
    return left - right
