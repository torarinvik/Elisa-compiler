# Concrete UTF-8 truncation controls against every production acceptance arm.
# The complete source-derived predicate is isolated here to keep certificates small.
include "../../src/lexer/lexer_utf8_codepoint_constants.elisa"

def reject_truncated_two_byte_sequence() -> bool:
    ensure result == false
    accepted: bool = (1 > 1 and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (194 >= UTF8_TWO_BYTE_LEAD_MIN and 194 <= UTF8_TWO_BYTE_LEAD_MAX)) or (1 > 2 and 0 >= UTF8_E0_SECOND_MIN and 0 <= UTF8_CONTINUATION_MAX and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (194 == UTF8_THREE_BYTE_LEAD_MIN)) or (1 > 2 and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and ((194 > UTF8_THREE_BYTE_LEAD_MIN and 194 < UTF8_SURROGATE_LEAD) or (194 > UTF8_SURROGATE_LEAD and 194 <= UTF8_THREE_BYTE_LEAD_MAX))) or (1 > 2 and 0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_ED_SECOND_MAX and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (194 == UTF8_SURROGATE_LEAD)) or (1 > 3 and 0 >= UTF8_F0_SECOND_MIN and 0 <= UTF8_CONTINUATION_MAX and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (194 == UTF8_FOUR_BYTE_LEAD_MIN)) or (1 > 3 and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (194 > UTF8_FOUR_BYTE_LEAD_MIN and 194 < UTF8_FOUR_BYTE_LEAD_MAX)) or (1 > 3 and 0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_F4_SECOND_MAX and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (194 == UTF8_FOUR_BYTE_LEAD_MAX))
    return accepted

def reject_truncated_three_byte_sequence() -> bool:
    ensure result == false
    accepted: bool = (2 > 1 and (160 >= UTF8_CONTINUATION_MIN and 160 <= UTF8_CONTINUATION_MAX) and (224 >= UTF8_TWO_BYTE_LEAD_MIN and 224 <= UTF8_TWO_BYTE_LEAD_MAX)) or (2 > 2 and 160 >= UTF8_E0_SECOND_MIN and 160 <= UTF8_CONTINUATION_MAX and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (224 == UTF8_THREE_BYTE_LEAD_MIN)) or (2 > 2 and (160 >= UTF8_CONTINUATION_MIN and 160 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and ((224 > UTF8_THREE_BYTE_LEAD_MIN and 224 < UTF8_SURROGATE_LEAD) or (224 > UTF8_SURROGATE_LEAD and 224 <= UTF8_THREE_BYTE_LEAD_MAX))) or (2 > 2 and 160 >= UTF8_CONTINUATION_MIN and 160 <= UTF8_ED_SECOND_MAX and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (224 == UTF8_SURROGATE_LEAD)) or (2 > 3 and 160 >= UTF8_F0_SECOND_MIN and 160 <= UTF8_CONTINUATION_MAX and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (224 == UTF8_FOUR_BYTE_LEAD_MIN)) or (2 > 3 and (160 >= UTF8_CONTINUATION_MIN and 160 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (224 > UTF8_FOUR_BYTE_LEAD_MIN and 224 < UTF8_FOUR_BYTE_LEAD_MAX)) or (2 > 3 and 160 >= UTF8_CONTINUATION_MIN and 160 <= UTF8_F4_SECOND_MAX and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (0 >= UTF8_CONTINUATION_MIN and 0 <= UTF8_CONTINUATION_MAX) and (224 == UTF8_FOUR_BYTE_LEAD_MAX))
    return accepted
