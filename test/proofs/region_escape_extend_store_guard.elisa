# Source-linked control-flow law for the special scalar/container `extend` rule.

def element_store_check_reached_is_exact(is_extend: bool,
    receiver_elements_are_containers: bool) -> bool:
    ensure result == (not is_extend or receiver_elements_are_containers)
    return not (is_extend and not receiver_elements_are_containers)

def extending_scalar_elements_skips_reference_store_check() -> bool:
    ensure result == false
    return element_store_check_reached_is_exact(true, false)

def extending_container_elements_reaches_reference_store_check() -> bool:
    ensure result == true
    return element_store_check_reached_is_exact(true, true)

def ordinary_growth_method_reaches_reference_store_check() -> bool:
    ensure result == true
    return element_store_check_reached_is_exact(false, false)
