# Prove the EASM memory-size bounds domain and read guard.
include "../../src/backend/easm_memstate_domain.elisa"

def minimum_join_never_exceeds_left_bound(left: i64, right: i64) -> bool:
    ensure result == true
    return EasmMemStateDomain::join_min(left, right) <= left

def minimum_join_never_exceeds_right_bound(left: i64, right: i64) -> bool:
    ensure result == true
    return EasmMemStateDomain::join_min(left, right) <= right

def minimum_join_selects_an_incoming_bound(left: i64, right: i64) -> bool:
    ensure result == true
    value: i64 = EasmMemStateDomain::join_min(left, right)
    return value == left or value == right

def minimum_join_is_idempotent(bound: i64) -> bool:
    ensure result == true
    return EasmMemStateDomain::join_min(bound, bound) == bound

def greatest_bound_never_falls_below_left_fact(left: i64, right: i64) -> bool:
    ensure result == true
    return EasmMemStateDomain::greatest_bound(left, right) >= left

def greatest_bound_never_falls_below_right_fact(left: i64, right: i64) -> bool:
    ensure result == true
    return EasmMemStateDomain::greatest_bound(left, right) >= right

def greatest_bound_selects_an_incoming_fact(left: i64, right: i64) -> bool:
    ensure result == true
    value: i64 = EasmMemStateDomain::greatest_bound(left, right)
    return value == left or value == right

def greatest_bound_is_idempotent(bound: i64) -> bool:
    ensure result == true
    return EasmMemStateDomain::greatest_bound(bound, bound) == bound

def greatest_bound_is_commutative(left: i64, right: i64) -> bool:
    ensure result == true
    return EasmMemStateDomain::greatest_bound(left, right) == EasmMemStateDomain::greatest_bound(right, left)

def greatest_bound_is_associative(first: i64, second: i64, third: i64) -> bool:
    ensure result == true
    return (
        EasmMemStateDomain::greatest_bound(EasmMemStateDomain::greatest_bound(first, second), third) ==
        EasmMemStateDomain::greatest_bound(first, EasmMemStateDomain::greatest_bound(second, third))
    )

def greatest_bound_is_monotone_in_both_facts(left: i64, larger_left: i64, right: i64, larger_right: i64) -> bool:
    requires left <= larger_left and right <= larger_right
    ensure result == true
    return EasmMemStateDomain::greatest_bound(left, right) <= EasmMemStateDomain::greatest_bound(larger_left, larger_right)

def joined_path_read_accepts_exactly_when_each_path_has_a_covering_fact(left_first: i64, left_second: i64, right_first: i64, right_second: i64, need: i64) -> bool:
    ensure result == true
    left_bound: i64 = EasmMemStateDomain::greatest_bound(left_first, left_second)
    right_bound: i64 = EasmMemStateDomain::greatest_bound(right_first, right_second)
    return EasmMemStateDomain::guard_join(left_bound, right_bound, need) == (
        (need <= left_first or need <= left_second) and
        (need <= right_first or need <= right_second)
    )

def joined_read_guard_is_the_minimum_bound_read(left: i64, right: i64, need: i64) -> bool:
    ensure result == true
    return EasmMemStateDomain::guard_join(left, right, need) == (need <= (left if left < right else right))

def minimum_read_acceptance_implies_each_predecessor(left: i64, right: i64, need: i64) -> bool:
    requires need <= EasmMemStateDomain::join_min(left, right)
    ensure result == true
    return need <= left and need <= right

def each_predecessor_bound_implies_minimum_read_acceptance(left: i64, right: i64, need: i64) -> bool:
    requires need <= left and need <= right
    ensure result == true
    return need <= EasmMemStateDomain::join_min(left, right)

def minimum_join_is_commutative(left: i64, right: i64) -> bool:
    ensure result == true
    return EasmMemStateDomain::join_min(left, right) == EasmMemStateDomain::join_min(right, left)

def both_predecessors_satisfy_bound_then_join_accepts(left: i64, right: i64, need: i64) -> bool:
    requires need <= left and need <= right
    ensure result == true
    return EasmMemStateDomain::guard_join(left, right, need)

def joined_guard_rejects_a_read_oversized_for_either_predecessor(left: i64, right: i64, need: i64) -> bool:
    ensure result == true
    if need > left:
        return not EasmMemStateDomain::guard_join(left, right, need)
    if need > right:
        return not EasmMemStateDomain::guard_join(left, right, need)
    return true

def minimum_join_is_associative(first: i64, second: i64, third: i64) -> bool:
    ensure result == true
    return (
        EasmMemStateDomain::join_min(EasmMemStateDomain::join_min(first, second), third) ==
        EasmMemStateDomain::join_min(first, EasmMemStateDomain::join_min(second, third))
    )

def minimum_join_is_monotone_in_both_predecessors(left: i64, larger_left: i64, right: i64, larger_right: i64) -> bool:
    requires left <= larger_left and right <= larger_right
    ensure result == true
    return EasmMemStateDomain::join_min(left, right) <= EasmMemStateDomain::join_min(larger_left, larger_right)

def any_shared_lower_bound_is_below_the_minimum_join(lower: i64, left: i64, right: i64) -> bool:
    requires lower <= left and lower <= right
    ensure result == true
    return lower <= EasmMemStateDomain::join_min(left, right)

def joined_read_guard_accepts_exactly_when_both_predecessors_cover_the_read(left: i64, right: i64, need: i64) -> bool:
    ensure result == true
    return EasmMemStateDomain::guard_join(left, right, need) == (need <= left and need <= right)

def joined_read_guard_rejects_exactly_when_a_predecessor_is_too_small(left: i64, right: i64, need: i64) -> bool:
    ensure result == true
    return (EasmMemStateDomain::guard_join(left, right, need) == false) == (need > left or need > right)
