# Refutation-policy model, not a proof of contextual AST traversal or inference.
def result_is_refuted(canonical_derived_target: bool, exact_rule_key: bool, predicate_decided: bool, predicate_holds: bool) -> bool:
    ensure result == (canonical_derived_target and exact_rule_key and predicate_decided and not predicate_holds)
    return canonical_derived_target and exact_rule_key and predicate_decided and not predicate_holds

def undecided_replacement_is_not_a_contradiction(target: bool, key: bool, holds: bool) -> bool:
    ensure result == false
    return result_is_refuted(target, key, false, holds)

def unrelated_predicate_cannot_refute_target(target: bool, decided: bool, holds: bool) -> bool:
    ensure result == false
    return result_is_refuted(target, false, decided, holds)

def unresolved_or_protocol_target_is_not_derived_evidence(key: bool, decided: bool, holds: bool) -> bool:
    ensure result == false
    return result_is_refuted(false, key, decided, holds)

def satisfied_predicate_is_not_refuted(target: bool, key: bool, decided: bool) -> bool:
    ensure result == false
    return result_is_refuted(target, key, decided, true)

def proven_false_target_is_refuted() -> bool:
    ensure result == true
    return result_is_refuted(true, true, true, false)
