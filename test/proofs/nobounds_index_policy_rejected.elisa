# Each declaration is a deliberate false claim checked against the production policy.
include "../../src/semantic/nobounds_index_policy.elisa"

def wrong_receiver_is_accepted_as_evidence() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return SemanticNoBoundsIndexPolicy::matching_range_evidence(true, "other", "i", "items", "i")

def wrong_index_is_accepted_as_evidence() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return SemanticNoBoundsIndexPolicy::matching_range_evidence(true, "items", "j", "items", "i")

def arbitrary_loop_permission_suppresses_diagnostic() -> bool:
    ensure result == true
    return not SemanticNoBoundsIndexPolicy::should_report_unproven(true, false)

def unproven_parameter_index_is_silently_accepted() -> bool:
    ensure result == true
    return not SemanticNoBoundsIndexPolicy::should_report_unproven(true, false)
