# The cache identity input constructor preserves the exact options supplied to semantic analysis.
include "../../src/lexer/tokens.elisa"
include "../../src/lexer/source_view.elisa"

module Semantic:
    public:
        const SEMANTIC_OPTIONS_PROOF_SCOPE: bool = true

include "../../src/semantic/incremental_semantic_options.elisa"

def semantic_options_constructor_preserves_every_field(
    enforce_unsafe_permissions: bool,
    flow_strict: bool,
    runtime_std: bool,
    flow_warn: bool,
    enable_smt: bool,
    warn_discarded: bool,
    enforce_progress: bool,
    enforce_extern_contracts: bool,
    enforce_raw_unsafe: bool,
    emit_proof_hole: bool,
    region_stack_cap: i64,
    enforce_global_permissions: bool,
    enforce_mutable_global_grants: bool,
    carrier_surface: bool
) -> bool:
    ensure result == true
    options: Semantic::IncrementalSemanticOptions = Semantic::incremental_semantic_options_from_values(
        enforce_unsafe_permissions, flow_strict, runtime_std, flow_warn, enable_smt,
        warn_discarded, enforce_progress, enforce_extern_contracts, enforce_raw_unsafe,
        emit_proof_hole, region_stack_cap, enforce_global_permissions,
        enforce_mutable_global_grants, carrier_surface
    )
    return false if options.enforce_unsafe_permissions != enforce_unsafe_permissions
    return false if options.flow_strict != flow_strict
    return false if options.runtime_std != runtime_std
    return false if options.flow_warn != flow_warn
    return false if options.enable_smt != enable_smt
    return false if options.warn_discarded != warn_discarded
    return false if options.enforce_progress != enforce_progress
    return false if options.enforce_extern_contracts != enforce_extern_contracts
    return false if options.enforce_raw_unsafe != enforce_raw_unsafe
    return false if options.emit_proof_hole != emit_proof_hole
    return false if options.region_stack_cap != region_stack_cap
    return false if options.enforce_global_permissions != enforce_global_permissions
    return false if options.enforce_mutable_global_grants != enforce_mutable_global_grants
    return false if options.carrier_surface != carrier_surface
    return true

def semantic_options_flag_indices_preserve_all_boolean_fields(options: Semantic::IncrementalSemanticOptions) -> bool:
    ensure result == true
    return false if Semantic::incremental_semantic_options_flag(options, 0) != (1 if options.enforce_unsafe_permissions else 0)
    return false if Semantic::incremental_semantic_options_flag(options, 1) != (1 if options.flow_strict else 0)
    return false if Semantic::incremental_semantic_options_flag(options, 2) != (1 if options.runtime_std else 0)
    return false if Semantic::incremental_semantic_options_flag(options, 3) != (1 if options.flow_warn else 0)
    return false if Semantic::incremental_semantic_options_flag(options, 4) != (1 if options.enable_smt else 0)
    return false if Semantic::incremental_semantic_options_flag(options, 5) != (1 if options.warn_discarded else 0)
    return false if Semantic::incremental_semantic_options_flag(options, 6) != (1 if options.enforce_progress else 0)
    return false if Semantic::incremental_semantic_options_flag(options, 7) != (1 if options.enforce_extern_contracts else 0)
    return false if Semantic::incremental_semantic_options_flag(options, 8) != (1 if options.enforce_raw_unsafe else 0)
    return false if Semantic::incremental_semantic_options_flag(options, 9) != (1 if options.emit_proof_hole else 0)
    return false if Semantic::incremental_semantic_options_flag(options, 10) != (1 if options.enforce_global_permissions else 0)
    return false if Semantic::incremental_semantic_options_flag(options, 11) != (1 if options.enforce_mutable_global_grants else 0)
    return false if Semantic::incremental_semantic_options_flag(options, 12) != (1 if options.carrier_surface else 0)
    return false if Semantic::incremental_semantic_options_flag(options, 13) != 0
    return true
