# False claims must remain unprovable under the same source-linked policy.
include "../../src/parser/static_if_branch.elisa"
include "../../src/backend/codegen_static_if_policy.elisa"

def false_claim_chain_head_is_suppressed_by_a_prior_selection(previously_satisfied: bool) -> bool:
    ensure result == true
    return StaticIfPolicy::row_action(StaticIfBranch::Kind::ChainHead, previously_satisfied) == StaticIfPolicy::Action::Skip

def false_claim_unsatisfied_continuation_is_skipped() -> bool:
    ensure result == true
    return StaticIfPolicy::row_action(StaticIfBranch::Kind::ChainContinuation, false) == StaticIfPolicy::Action::Skip

def false_claim_unsatisfied_fallback_is_skipped() -> bool:
    ensure result == true
    return StaticIfPolicy::row_action(StaticIfBranch::Kind::Fallback, false) == StaticIfPolicy::Action::Skip

def false_claim_satisfied_fallback_is_selected() -> bool:
    ensure result == true
    return StaticIfPolicy::row_action(StaticIfBranch::Kind::Fallback, true) == StaticIfPolicy::Action::SelectFallback

