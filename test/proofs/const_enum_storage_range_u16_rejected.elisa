include "./const_enum_storage_range_u16.elisa"

def false_const_enum_u16_accepts_below(value: i64) -> bool:
    requires value < 0
    ensure result == true
    return proof_const_enum_u16_fits(value)

def false_const_enum_u16_accepts_above(value: i64) -> bool:
    requires value > 65535
    ensure result == true
    return proof_const_enum_u16_fits(value)
