module Parser:
    private:
        const INTEGER_LITERAL_REJECTED_PROOF_SCOPE: bool = true

include "../../src/parser/parser_integer_literal.elisa"

extend Parser:
    public:
        def proof_decode_integer_literal(text: sview) -> i64:
            return parse_int_literal_value(text)

def hex_is_not_decimal() -> bool:
    ensure result == true
    return Parser::proof_decode_integer_literal("0x2a") == 43
