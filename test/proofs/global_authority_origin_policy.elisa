# Prove the origin lattice used for references and reference-containing aggregates.
include "../../src/semantic/global_authority_origin_policy.elisa"

def pattern_binding_origin_matches_its_exact_spec(contains_reference: bool, source_origin: usize) -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::pattern_binding_origin(contains_reference, source_origin) == (
        SemanticGlobalAuthorityOrigin::NO_ORIGIN if not contains_reference else
        (source_origin if source_origin != SemanticGlobalAuthorityOrigin::NO_ORIGIN else SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS)
    )

def values_without_references_have_no_origin() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::pattern_binding_origin(false, 17.usize()) == SemanticGlobalAuthorityOrigin::NO_ORIGIN

def known_global_origins_survive_binding_and_projection() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::pattern_binding_origin(true, 17.usize()) == 17.usize()

def known_local_origins_survive_binding_and_projection() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::pattern_binding_origin(true, SemanticGlobalAuthorityOrigin::LOCAL_ALIAS) == SemanticGlobalAuthorityOrigin::LOCAL_ALIAS

def unknown_reference_origins_fail_closed() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::pattern_binding_origin(true, SemanticGlobalAuthorityOrigin::NO_ORIGIN) == SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS

def reference_origin_join_matches_its_exact_spec(left: usize, right: usize) -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::join_reference_origins(left, right) == (
        right if left == SemanticGlobalAuthorityOrigin::NO_ORIGIN else
        (left if right == SemanticGlobalAuthorityOrigin::NO_ORIGIN else
            (left if left == right else SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS))
    )

def no_origin_is_a_left_join_identity() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::join_reference_origins(SemanticGlobalAuthorityOrigin::NO_ORIGIN, 17.usize()) == 17.usize()

def no_origin_is_a_right_join_identity() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::join_reference_origins(17.usize(), SemanticGlobalAuthorityOrigin::NO_ORIGIN) == 17.usize()

def matching_local_origins_join_to_local() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::join_reference_origins(SemanticGlobalAuthorityOrigin::LOCAL_ALIAS, SemanticGlobalAuthorityOrigin::LOCAL_ALIAS) == SemanticGlobalAuthorityOrigin::LOCAL_ALIAS

def conflicting_local_and_global_origins_join_to_unknown() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::join_reference_origins(SemanticGlobalAuthorityOrigin::LOCAL_ALIAS, 17.usize()) == SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS

def reference_origin_join_is_commutative(left: usize, right: usize) -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::join_reference_origins(left, right) == SemanticGlobalAuthorityOrigin::join_reference_origins(right, left)

def reference_origin_join_is_associative(first: usize, second: usize, third: usize) -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::join_reference_origins(SemanticGlobalAuthorityOrigin::join_reference_origins(first, second), third) == SemanticGlobalAuthorityOrigin::join_reference_origins(first, SemanticGlobalAuthorityOrigin::join_reference_origins(second, third))

def reference_origin_join_is_idempotent(origin: usize) -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::join_reference_origins(origin, origin) == origin

def unknown_origin_absorbs_every_joined_origin(origin: usize) -> bool:
    ensure result == true
    return (
        SemanticGlobalAuthorityOrigin::join_reference_origins(SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS, origin) == SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS
        and SemanticGlobalAuthorityOrigin::join_reference_origins(origin, SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS) == SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS
    )

def opaque_expression_origin_matches_its_exact_spec(type_known: bool, contains_reference: bool) -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::opaque_expression_origin(type_known, contains_reference) == (SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS if not type_known or contains_reference else SemanticGlobalAuthorityOrigin::NO_ORIGIN)

def opaque_expression_without_type_fails_closed() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::opaque_expression_origin(false, false) == SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS

def opaque_reference_bearing_expression_fails_closed() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::opaque_expression_origin(true, true) == SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS

def known_reference_free_opaque_expression_has_no_origin() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::opaque_expression_origin(true, false) == SemanticGlobalAuthorityOrigin::NO_ORIGIN

def constructor_origin_matches_reference_field_coverage(summary: usize, reference_fields_complete: bool) -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::constructor_origin(summary, reference_fields_complete) == (summary if reference_fields_complete else SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS)

def incomplete_constructor_reference_fields_fail_closed() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::constructor_origin(SemanticGlobalAuthorityOrigin::LOCAL_ALIAS, false) == SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS

def complete_constructor_reference_fields_keep_summary() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::constructor_origin(SemanticGlobalAuthorityOrigin::LOCAL_ALIAS, true) == SemanticGlobalAuthorityOrigin::LOCAL_ALIAS

def unknown_alias_permission_matches_its_exact_spec(write: bool) -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::unknown_alias_permission(write) == ("Global.Write" if write else "Global.Read")

def writing_through_an_unknown_alias_requires_global_write() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::unknown_alias_permission(true) == "Global.Write"

def reading_through_an_unknown_alias_requires_global_read() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::unknown_alias_permission(false) == "Global.Read"

def conservative_alias_policy_matches_its_exact_spec(origin: usize) -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::requires_unknown_alias_permission(origin) == (
        origin == SemanticGlobalAuthorityOrigin::NO_ORIGIN
        or origin == SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS
    )

def missing_origin_requires_conservative_access() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::requires_unknown_alias_permission(SemanticGlobalAuthorityOrigin::NO_ORIGIN)

def unknown_origin_requires_conservative_access() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::requires_unknown_alias_permission(SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS)

def detached_storage_skips_conservative_access() -> bool:
    ensure result == true
    return not SemanticGlobalAuthorityOrigin::requires_unknown_alias_permission(SemanticGlobalAuthorityOrigin::LOCAL_ALIAS)

def encoded_local_origins_bypass_unknown_alias_policy(global_count: usize, identity: usize) -> bool:
    requires global_count < SemanticGlobalAuthorityOrigin::LOCAL_ALIAS
    requires identity < SemanticGlobalAuthorityOrigin::LOCAL_ALIAS - global_count
    ensure result == true
    return not SemanticGlobalAuthorityOrigin::requires_unknown_alias_permission(global_count + identity)
