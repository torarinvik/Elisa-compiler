# Noalias metadata is emitted only under the explicit opt-in and for a mutable
# reference to a numeric, non-heap pointee.

def noalias_pointee_is_eligible(is_reference: bool, is_heap_reference: bool, is_numeric_pointee: bool) -> bool:
    ensure result == (is_reference and not is_heap_reference and is_numeric_pointee)
    return is_reference and not is_heap_reference and is_numeric_pointee

def mutable_scalar_parameter_receives_noalias(opted_in: bool, is_reference: bool, is_mutable_reference: bool, is_heap_reference: bool, is_numeric_pointee: bool) -> bool:
    ensure result == (opted_in and is_reference and is_mutable_reference and not is_heap_reference and is_numeric_pointee)
    return opted_in and is_reference and is_mutable_reference and noalias_pointee_is_eligible(is_reference, is_heap_reference, is_numeric_pointee)

def noalias_is_disabled_without_explicit_opt_in(opted_in: bool, eligible: bool) -> bool:
    requires not opted_in
    ensure result == false
    return opted_in and eligible

