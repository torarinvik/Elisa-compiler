# Knowledge-policy model. AST evaluation and checked arithmetic are covered by
# native controls, not proved by these Boolean admission laws.
def predicate_is_decided(within_budget: bool, supported: bool, left_known: bool, right_known: bool) -> bool:
    ensure result == (within_budget and supported and left_known and right_known)
    return within_budget and supported and left_known and right_known

def exhausted_budget_is_unknown(supported: bool, left_known: bool, right_known: bool) -> bool:
    ensure result == false
    return predicate_is_decided(false, supported, left_known, right_known)

def unsupported_operator_is_unknown(within_budget: bool, left_known: bool, right_known: bool) -> bool:
    ensure result == false
    return predicate_is_decided(within_budget, false, left_known, right_known)

def unknown_right_is_not_erased_by_boolean_constant(within_budget: bool, supported: bool, left_known: bool) -> bool:
    ensure result == false
    return predicate_is_decided(within_budget, supported, left_known, false)

def unknown_left_is_not_erased_by_boolean_constant(within_budget: bool, supported: bool, right_known: bool) -> bool:
    ensure result == false
    return predicate_is_decided(within_budget, supported, false, right_known)

def complete_supported_evidence_is_decided() -> bool:
    ensure result == true
    return predicate_is_decided(true, true, true, true)
