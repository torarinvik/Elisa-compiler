# False claims against the legacy error-pattern marker classifier.
include "../../src/semantic/legacy_error_syntax_name.elisa"

def unknown_marker_is_reported_as_wildcard() -> bool:
    ensure result == true
    return LegacyErrorSyntaxName::diagnostic_name("__legacy_error_other") == "wildcard"

def pipe_marker_is_reported_as_open() -> bool:
    ensure result == true
    return LegacyErrorSyntaxName::diagnostic_name("__legacy_error_pipe") == "open"
