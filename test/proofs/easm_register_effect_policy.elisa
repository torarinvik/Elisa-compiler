# Prove the production EASM register-destination read and self-zeroing policy.
include "../../src/backend/easm_memory_effect_policy.elisa"
include "../../src/backend/easm_register_effect_policy.elisa"

def read_modify_write_opcodes_read_the_old_register_destination(op: sview) -> bool:
    requires EasmMemoryEffectPolicy::read_modify_write(op)
    ensure result == true
    return EasmRegisterEffectPolicy::destination_reads_register(op)

def compare_and_test_opcodes_read_the_old_register_destination(op: sview) -> bool:
    requires op == "cmp" or op == "cmpq" or op == "test" or op == "testq"
    ensure result == true
    return EasmRegisterEffectPolicy::destination_reads_register(op)

def ordinary_move_has_no_old_register_destination_read() -> bool:
    ensure result == true
    return not EasmRegisterEffectPolicy::destination_reads_register("movq")

def indirect_control_has_no_old_register_destination_read() -> bool:
    ensure result == true
    return not EasmRegisterEffectPolicy::destination_reads_register("callq") and
        not EasmRegisterEffectPolicy::destination_reads_register("jmpq")

def self_zeroing_recognizes_equal_nonempty_xor_and_sub_registers(op: sview, source_register: sview, destination_register: sview) -> bool:
    requires (op == "xor" or op == "xorq" or op == "sub" or op == "subq") and
        source_register != "" and source_register == destination_register
    ensure result == true
    return EasmRegisterEffectPolicy::is_self_zeroing(op, source_register, destination_register)

def empty_or_distinct_operands_are_not_self_zeroing(op: sview, source_register: sview, destination_register: sview) -> bool:
    requires source_register == "" or source_register != destination_register
    ensure result == false
    return EasmRegisterEffectPolicy::is_self_zeroing(op, source_register, destination_register)

def another_opcode_does_not_become_self_zeroing_for_equal_registers(op: sview, source_register: sview, destination_register: sview) -> bool:
    requires not EasmRegisterEffectPolicy::zeroing_alu_opcode(op) and
        source_register != "" and source_register == destination_register
    ensure result == false
    return EasmRegisterEffectPolicy::is_self_zeroing(op, source_register, destination_register)

def self_zeroing_suppresses_old_destination_reads(op: sview) -> bool:
    requires EasmRegisterEffectPolicy::destination_reads_register(op)
    ensure result == false
    return EasmRegisterEffectPolicy::reads_register_destination(op, true, true)

def a_present_nonzeroing_destination_uses_the_opcode_read_class(op: sview) -> bool:
    requires EasmRegisterEffectPolicy::destination_reads_register(op)
    ensure result == true
    return EasmRegisterEffectPolicy::reads_register_destination(op, true, false)

def absent_register_destinations_are_not_read(op: sview, self_zeroing: bool) -> bool:
    ensure result == false
    return EasmRegisterEffectPolicy::reads_register_destination(op, false, self_zeroing)
