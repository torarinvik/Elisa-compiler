# False wildcard matcher claims must remain unprovable under the production policy.
include "./borrow_field_path_policy.elisa"

def mismatched_parent_is_accepted() -> bool:
    ensure result == true
    can Abort.Panic:
        return SemanticBorrowFieldPath::wildcard_matches("root.child.*", "root.other.leaf", 10.usize())

def nonwildcard_suffix_is_accepted() -> bool:
    ensure result == true
    can Abort.Panic:
        return SemanticBorrowFieldPath::wildcard_matches("a.x", "a.child", 1.usize())

def extra_suffix_byte_is_accepted() -> bool:
    ensure result == true
    can Abort.Panic:
        return SemanticBorrowFieldPath::wildcard_matches("a.**", "a.child", 1.usize())

def out_of_range_prefix_is_accepted() -> bool:
    ensure result == true
    can Abort.Panic:
        return SemanticBorrowFieldPath::wildcard_matches("a.*", "a", 1.usize())

def candidate_prefix_past_end_is_accepted() -> bool:
    ensure result == true
    can Abort.Panic:
        return SemanticBorrowFieldPath::wildcard_matches("a.*", "a..child", 3.usize())
