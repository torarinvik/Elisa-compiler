# First-order specification and loop-level consequences of reverse byte search.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

def reverse_search_obeys_its_last_match_contract(view: sview, byte: u8) -> bool can[Unsafe.UncheckedIndex]:
    ensure result == true
    found: i64 = sview_find_last_byte(view, byte)
    return (
        ((view.len < 0 or view.len.usize().i64() != view.len) implies found == -1)
        and found >= -1
        and (found >= 0 implies (
            found < view.len
            and string_view_index(view, found) == byte.i64()
            and (forall later in found + 1..<view.len: string_view_index(view, later) != byte.i64())
        ))
        and ((view.len >= 0 and view.len.usize().i64() == view.len and found == -1) implies (
            forall candidate in 0..<view.len: string_view_index(view, candidate) != byte.i64()
        ))
    )

def a_found_reverse_search_result_is_the_last_matching_offset(view: sview, byte: u8) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    requires sview_find_last_byte(view, byte) >= 0
    ensure result == true
    found: i64 = sview_find_last_byte(view, byte)
    return (
        found < view.len
        and string_view_index(view, found) == byte.i64()
        and (forall later in found + 1..<view.len: string_view_index(view, later) != byte.i64())
    )

def an_absent_reverse_search_result_means_no_match(view: sview, byte: u8) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    requires sview_find_last_byte(view, byte) == -1
    ensure result == true
    return forall candidate in 0..<view.len: string_view_index(view, candidate) != byte.i64()

def an_unrepresentable_reverse_search_length_returns_minus_one(view: sview, byte: u8) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len < 0 or view.len.usize().i64() != view.len
    ensure result == true
    return sview_find_last_byte(view, byte) == -1

def filename_is_the_suffix_after_the_last_slash(path: sview) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires path.len >= 0 and path.len.usize().i64() == path.len
    ensure result == true
    slash: i64 = sview_find_last_byte(path, 47)
    name: sview = Fs::filename(path)
    start: i64 = slash + 1
    return (
        slash >= -1 and slash < path.len and name.len == path.len - start
        and (name.len == 0 or name.data == path.data + start.usize())
    )

def parent_is_the_prefix_before_the_last_slash(path: sview) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires path.len >= 0 and path.len.usize().i64() == path.len
    ensure result == true
    slash: i64 = sview_find_last_byte(path, 47)
    parent: sview = Fs::parent(path)
    return (
        (slash >= 0 and parent.len == slash and (parent.len == 0 or parent.data == path.data))
        or (slash == -1 and parent.len == 0)
    )
