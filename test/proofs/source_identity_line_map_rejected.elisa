include "./source_identity_line_map.elisa"

def overflowing_source_line_is_accepted(selected_flat_line: i64, requested_flat_line: i64, original_line: i64) -> bool:
    requires 0 <= selected_flat_line and selected_flat_line <= requested_flat_line and requested_flat_line <= SOURCE_LINE_U32_MAX and 0 <= original_line and original_line <= SOURCE_LINE_U32_MAX and original_line > SOURCE_LINE_U32_MAX - (requested_flat_line - selected_flat_line)
    ensure result == true
    delta: i64 = requested_flat_line - selected_flat_line
    return original_line <= SOURCE_LINE_U32_MAX - delta

def exact_u32_limit_is_rejected() -> bool:
    ensure result == true
    delta: i64 = 11 - 10
    return 4294967294 > SOURCE_LINE_U32_MAX - delta

def a_line_after_the_selected_entry_has_a_negative_offset(selected_flat_line: i64, requested_flat_line: i64) -> bool:
    requires 0 <= selected_flat_line and selected_flat_line <= requested_flat_line and requested_flat_line <= SOURCE_LINE_U32_MAX
    ensure result == true
    return requested_flat_line < selected_flat_line
