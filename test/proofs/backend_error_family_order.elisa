# Source-bound proof model for the backend's lexicographic error-family ordering.
include "./backend_error_family_byte_order.elisa"

module BackendErrorFamilyOrderProof:
    private:
        ghost def error_family_precedes_from(left: sview, right: sview, index: usize) -> bool:
            requires index <= left.len and index <= right.len
            decreases (left.len if left.len < right.len else right.len) - index
            left_length: usize = left.len
            right_length: usize = right.len
            shared_length: usize = left_length if left_length < right_length else right_length
            return left_length < right_length if index == shared_length
            return left[index] < right[index] if left[index] != right[index]
            return error_family_precedes_from(left, right, index + 1)

        ghost def error_family_equal_from(left: sview, right: sview, index: usize) -> bool:
            requires index <= left.len and index <= right.len
            decreases (left.len if left.len < right.len else right.len) - index
            left_length: usize = left.len
            right_length: usize = right.len
            if index < left_length and index < right_length:
                return false if left[index] != right[index]
                return error_family_equal_from(left, right, index + 1)
            return left_length == right_length

        ghost def error_family_precedes_at(left: sview, right: sview, index: usize) -> bool:
            left_length: usize = left.len
            right_length: usize = right.len
            if index <= left.len and index <= right.len:
                return error_family_precedes_from(left, right, index)
            return left_length < right_length

        ghost def error_family_equal_at(left: sview, right: sview, index: usize) -> bool:
            left_length: usize = left.len
            right_length: usize = right.len
            if index <= left.len and index <= right.len:
                return error_family_equal_from(left, right, index)
            return left_length == right_length

        ghost def error_family_order_pair_not_both_from(left: sview, right: sview, index: usize) -> bool:
            requires index <= left.len and index <= right.len
            decreases (left.len if left.len < right.len else right.len) - index
            ensures result == not (
                error_family_precedes_at(left, right, index)
                and error_family_precedes_at(right, left, index)
            )
            ensures result == true
            left_length: usize = left.len
            right_length: usize = right.len
            if index < left_length and index < right_length:
                return byte_less_is_asymmetric(left[index], right[index]) if left[index] != right[index]
                return error_family_order_pair_not_both_from(left, right, index + 1)
            return not (left_length < right_length and right_length < left_length)

        ghost def error_family_order_total_from(left: sview, right: sview, index: usize) -> bool:
            requires index <= left.len and index <= right.len
            decreases (left.len if left.len < right.len else right.len) - index
            ensures result == (error_family_precedes_at(left, right, index) or error_family_precedes_at(right, left, index) or error_family_equal_at(left, right, index))
            ensures result == true
            left_length: usize = left.len
            right_length: usize = right.len
            if index < left_length and index < right_length:
                return byte_order_is_total(left[index], right[index]) if left[index] != right[index]
                return error_family_order_total_from(left, right, index + 1)
            return left_length < right_length or right_length < left_length or left_length == right_length

        ghost def error_family_order_transitive_from(left: sview, middle: sview, right: sview, index: usize) -> bool:
            requires index <= left.len and index <= middle.len and index <= right.len
            decreases ((left.len if left.len < middle.len else middle.len) if (left.len if left.len < middle.len else middle.len) < right.len else right.len) - index
            ensures result == (not (error_family_precedes_at(left, middle, index) and error_family_precedes_at(middle, right, index)) or error_family_precedes_at(left, right, index))
            ensures result == true
            return true if not error_family_precedes_at(left, middle, index) or not error_family_precedes_at(middle, right, index)
            if index < left.len and index < middle.len and index < right.len:
                left_byte: u8 = left[index]
                middle_byte: u8 = middle[index]
                right_byte: u8 = right[index]
                if left_byte < middle_byte:
                    if middle_byte < right_byte:
                        return byte_less_is_transitive(left_byte, middle_byte, right_byte)
                    return true
                if left_byte == middle_byte:
                    return true if middle_byte < right_byte
                    return error_family_order_transitive_from(left, middle, right, index + 1) if middle_byte == right_byte
                return true
            return left.len < right.len

        def error_family_precedes(left: sview, right: sview) -> bool:
            ensure result == error_family_precedes_at(left, right, 0)
            left_length: usize = left.len
            right_length: usize = right.len
            shared_length: usize = left_length if left_length < right_length else right_length
            index: mutable usize = 0
            while index < shared_length |index, left, right|:
                decreases shared_length - index
                invariant index <= shared_length
                invariant error_family_precedes_at(left, right, index) == error_family_precedes_at(left, right, 0)
                if index < left_length and index < right_length:
                    return left[index] < right[index] if left[index] != right[index]
                    index <- index + 1
                else:
                    return left_length < right_length
            return left_length < right_length

        ghost def error_family_order_is_asymmetric(left: sview, right: sview) -> bool:
            ensure result == not (error_family_precedes_at(left, right, 0) and error_family_precedes_at(right, left, 0))
            ensure result == true
            return error_family_order_pair_not_both_from(left, right, 0)

        ghost def error_family_order_is_total(left: sview, right: sview) -> bool:
            ensure result == (error_family_precedes_at(left, right, 0) or error_family_precedes_at(right, left, 0) or error_family_equal_at(left, right, 0))
            ensure result == true
            return error_family_order_total_from(left, right, 0)

        ghost def error_family_order_is_transitive(left: sview, middle: sview, right: sview) -> bool:
            ensure result == (not (error_family_precedes_at(left, middle, 0) and error_family_precedes_at(middle, right, 0)) or error_family_precedes_at(left, right, 0))
            ensure result == true
            return error_family_order_transitive_from(left, middle, right, 0)

        def equal_names_are_not_ordered_before_themselves() -> bool:
            ensure result == true
            return not error_family_precedes("error[IO]", "error[IO]")

        def the_first_differing_byte_decides_before_the_suffix() -> bool:
            ensure result == true
            return error_family_precedes("alpha[z]", "beta[a]")

        def a_later_differing_byte_decides_after_an_equal_prefix() -> bool:
            ensure result == true
            return error_family_precedes("error[IO]", "error[OS]")

        def a_proper_prefix_precedes_its_extension() -> bool:
            ensure result == true
            return error_family_precedes("error", "error[IO]")

        def empty_name_precedes_a_nonempty_name() -> bool:
            ensure result == true
            return error_family_precedes("", "error")
