include "./fixed_array_index_bounds.elisa"

def false_in_range_index_is_reported(index: i64, size: i64) -> bool:
    requires index >= 0 and index < size
    ensure result == true
    return proof_reports_index_out_of_bounds(index, size, false)

def false_checked_access_reports_oob(index: i64, size: i64, checked: bool) -> bool:
    requires checked
    ensure result == true
    return proof_reports_index_out_of_bounds(index, size, checked)

def false_wide_index_is_not_reported(index: i64, size: i64) -> bool:
    requires index > 4294967295 and size <= 4294967295
    ensure result == true
    return not proof_reports_index_out_of_bounds(index, size, false)
