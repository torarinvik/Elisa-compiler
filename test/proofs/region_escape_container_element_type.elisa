# Source-linked type-shape laws used to decide whether extend copies region handles.

def receiver_element_classification_is_exact(annotation_is_present: bool,
    annotated_type_has_container_elements: bool,
    local_type_is_present: bool,
    inferred_type_has_container_elements: bool) -> bool:
    ensure result == ((annotation_is_present and annotated_type_has_container_elements) or
        (not annotation_is_present and local_type_is_present and inferred_type_has_container_elements))
    return ((annotation_is_present and annotated_type_has_container_elements) or
        (not annotation_is_present and local_type_is_present and inferred_type_has_container_elements))

def explicit_annotation_takes_precedence_over_inferred_type(annotated_type_has_container_elements: bool,
    inferred_type_has_container_elements: bool) -> bool:
    ensure result == annotated_type_has_container_elements
    return receiver_element_classification_is_exact(true, annotated_type_has_container_elements,
        true, inferred_type_has_container_elements)

def inferred_local_type_is_used_when_annotation_is_absent(inferred_type_has_container_elements: bool) -> bool:
    ensure result == inferred_type_has_container_elements
    return receiver_element_classification_is_exact(false, false, true, inferred_type_has_container_elements)

def missing_annotation_and_local_type_is_conservatively_false() -> bool:
    ensure result == false
    return receiver_element_classification_is_exact(false, true, false, true)

def container_type_head_classification_is_exact(head_is_darray_or_dict: bool) -> bool:
    ensure result == head_is_darray_or_dict
    return head_is_darray_or_dict

def one_argument_container_element_classification_is_exact(head_is_darray_or_dict: bool,
    element_annotation_is_container: bool) -> bool:
    ensure result == (head_is_darray_or_dict and element_annotation_is_container)
    return head_is_darray_or_dict and element_annotation_is_container

def multiple_argument_container_element_classification_is_exact(head_is_darray_or_dict: bool,
    any_argument_annotation_is_container: bool) -> bool:
    ensure result == (head_is_darray_or_dict and any_argument_annotation_is_container)
    return head_is_darray_or_dict and any_argument_annotation_is_container

def unary_and_parenthesized_type_wrappers_preserve_container_classification(inner_is_container: bool) -> bool:
    ensure result == inner_is_container
    return inner_is_container

def unsupported_type_shape_is_conservatively_false() -> bool:
    ensure result == false
    return false
