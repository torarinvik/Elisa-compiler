include "./backend_error_callee_resolution.elisa"

def false_claim_explicit_owner_allows_fallback(explicit_declared: bool, current_declared: bool, top_declared: bool, unique_error: bool) -> bool:
    requires explicit_declared and unique_error
    ensure result == true
    return not explicit_declared and not current_declared and not top_declared and unique_error

def false_claim_ordinary_lexical_allows_fallback(explicit_declared: bool, current_declared: bool, current_is_error: bool, top_declared: bool, unique_error: bool) -> bool:
    requires not explicit_declared and current_declared and not current_is_error and unique_error
    ensure result == true
    return not explicit_declared and not current_declared and not top_declared and unique_error

def false_claim_top_level_declared_allows_fallback(explicit_declared: bool, current_declared: bool, top_declared: bool, unique_error: bool) -> bool:
    requires not explicit_declared and not current_declared and top_declared and unique_error
    ensure result == true
    return not explicit_declared and not current_declared and not top_declared and unique_error

def false_claim_multiple_error_owners_are_unique(owner_hits: i64) -> bool:
    requires owner_hits == 2
    ensure result == true
    return owner_hits == 1
