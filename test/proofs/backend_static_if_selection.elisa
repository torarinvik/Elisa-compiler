# Proofs include and verify the exact branch policy consumed by the backend.
include "../../src/parser/static_if_branch.elisa"
include "../../src/backend/codegen_static_if_policy.elisa"

def every_branch_kind_has_its_exact_action(kind: StaticIfBranch::Kind, previously_satisfied: bool) -> bool:
    ensure result == true
    action: StaticIfPolicy::Action = StaticIfPolicy::row_action(kind, previously_satisfied)
    return match kind:
        StaticIfBranch::Kind::ChainHead: action == StaticIfPolicy::Action::EvaluateCondition
        StaticIfBranch::Kind::ChainContinuation:
            previously_satisfied and action == StaticIfPolicy::Action::Skip or not previously_satisfied and action == StaticIfPolicy::Action::EvaluateCondition
        StaticIfBranch::Kind::Fallback:
            previously_satisfied and action == StaticIfPolicy::Action::Skip or not previously_satisfied and action == StaticIfPolicy::Action::SelectFallback

def a_chain_head_starts_fresh_even_after_a_selected_outer_arm(previously_satisfied: bool) -> bool:
    ensure result == true
    return StaticIfPolicy::row_action(StaticIfBranch::Kind::ChainHead, previously_satisfied) == StaticIfPolicy::Action::EvaluateCondition

def an_unsatisfied_chain_continuation_evaluates_its_condition() -> bool:
    ensure result == true
    return StaticIfPolicy::row_action(StaticIfBranch::Kind::ChainContinuation, false) == StaticIfPolicy::Action::EvaluateCondition

def an_unsatisfied_fallback_is_selected_without_folding_a_condition() -> bool:
    ensure result == true
    return StaticIfPolicy::row_action(StaticIfBranch::Kind::Fallback, false) == StaticIfPolicy::Action::SelectFallback

def a_satisfied_chain_skips_a_continuation() -> bool:
    ensure result == true
    return StaticIfPolicy::row_action(StaticIfBranch::Kind::ChainContinuation, true) == StaticIfPolicy::Action::Skip

def a_satisfied_chain_skips_its_fallback() -> bool:
    ensure result == true
    return StaticIfPolicy::row_action(StaticIfBranch::Kind::Fallback, true) == StaticIfPolicy::Action::Skip

def condition_selection_matches_foldability_and_truth(condition_ok: bool, condition_value: i64) -> bool:
    ensure result == true
    return StaticIfPolicy::condition_selects_branch(condition_ok, condition_value) == (condition_ok and condition_value != StaticIfBranch::CONDITION_FALSE_VALUE)

def an_unfoldable_condition_is_not_selected(condition_value: i64) -> bool:
    ensure result == true
    return StaticIfPolicy::condition_selects_branch(false, condition_value) == false

def a_zero_condition_is_not_selected(condition_ok: bool) -> bool:
    ensure result == true
    return StaticIfPolicy::condition_selects_branch(condition_ok, StaticIfBranch::CONDITION_FALSE_VALUE) == false
