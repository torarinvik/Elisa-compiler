# Source-linked proof of the exact @noalloc argument rejection rule.
include "../../src/semantic/noalloc_argument_policy.elisa"

const NOALLOC_ARGUMENTS_NONE: usize = 0
const NOALLOC_ARGUMENTS_ONE: usize = 1

def source_rule_matches_the_closed_pattern(name: sview, argument_count: usize) -> bool:
    ensure result == true
    return NoallocArgumentPolicy::rejects_decorator(name, argument_count) == (
        when name:
            "noalloc" -> argument_count >= NoallocArgumentPolicy::NOALLOC_ARGUMENT_MINIMUM_ARGUMENTS
            _ -> false
    )

def an_argument_on_noalloc_is_rejected() -> bool:
    ensure result == true
    return NoallocArgumentPolicy::rejects_decorator("noalloc", NOALLOC_ARGUMENTS_ONE)

def bare_noalloc_is_allowed() -> bool:
    ensure result == true
    return not NoallocArgumentPolicy::rejects_decorator("noalloc", NOALLOC_ARGUMENTS_NONE)

def other_decorators_are_not_rejected_for_arguments() -> bool:
    ensure result == true
    return (
        not NoallocArgumentPolicy::rejects_decorator("inline", NOALLOC_ARGUMENTS_ONE)
        and not NoallocArgumentPolicy::rejects_decorator("Noalloc", NOALLOC_ARGUMENTS_ONE)
    )
