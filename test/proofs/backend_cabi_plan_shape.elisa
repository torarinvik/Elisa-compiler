# C ABI conversion codes may only extract fields supported by the source LLVM value.
# Codes 1/2 split a view, 3 extracts a resource aggregate, and 4 loads a pointer.
def cabi_plan_operation_shape_is_safe(code: i64, source_fields: i64, source_is_pointer: bool) -> bool:
    requires source_fields >= 0
    ensure result == (((code != 1 and code != 2) or source_fields >= 2) and (code != 3 or source_fields >= 1) and (code != 4 or source_is_pointer))
    return ((code != 1 and code != 2) or source_fields >= 2) and (code != 3 or source_fields >= 1) and (code != 4 or source_is_pointer)

def view_pointer_split_requires_two_fields(source_fields: i64) -> bool:
    requires source_fields >= 2
    ensure result
    return source_fields >= 2

def view_length_split_requires_two_fields(source_fields: i64) -> bool:
    requires source_fields >= 2
    ensure result
    return source_fields >= 2

def resource_handle_extract_requires_one_field(source_fields: i64) -> bool:
    requires source_fields >= 1
    ensure result
    return source_fields >= 1

def resource_handle_load_requires_pointer(source_is_pointer: bool) -> bool:
    requires source_is_pointer
    ensure result
    return source_is_pointer
