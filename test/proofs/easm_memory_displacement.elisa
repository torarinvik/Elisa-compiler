# Fail-closed result shape for EASM memory displacement parsing.
def memory_displacement_result(has_parenthesis: bool, prefix_empty: bool, parsed_valid: bool, parsed_value: i64) -> (valid: bool, value: i64):
    ensure result.valid or result.value == 0
    if not has_parenthesis:
        return (true, 0)
    if prefix_empty:
        return (true, 0)
    if parsed_valid:
        return (true, parsed_value)
    return (false, 0)

def invalid_displacement_compatibility_value_is_zero(parsed_valid: bool, parsed_value: i64) -> i64:
    requires not parsed_valid
    ensure result == 0
    return parsed_value if parsed_valid else 0
