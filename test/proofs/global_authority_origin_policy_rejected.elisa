# Unsafe origin joins and permission mappings must not be provable.
include "./global_authority_origin_policy.elisa"

def value_without_references_can_be_an_unknown_alias() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::pattern_binding_origin(false, 17.usize()) == SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS

def unknown_reference_can_be_treated_as_origin_free() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::pattern_binding_origin(true, SemanticGlobalAuthorityOrigin::NO_ORIGIN) == SemanticGlobalAuthorityOrigin::NO_ORIGIN

def known_local_reference_can_be_reclassified_as_unknown() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::pattern_binding_origin(true, SemanticGlobalAuthorityOrigin::LOCAL_ALIAS) == SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS

def conflicting_local_and_global_origins_can_be_called_local() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::join_reference_origins(SemanticGlobalAuthorityOrigin::LOCAL_ALIAS, 17.usize()) == SemanticGlobalAuthorityOrigin::LOCAL_ALIAS

def distinct_global_origins_can_keep_the_first_root() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::join_reference_origins(17.usize(), 19.usize()) == 17.usize()

def unknown_and_local_origins_can_join_to_local() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::join_reference_origins(SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS, SemanticGlobalAuthorityOrigin::LOCAL_ALIAS) == SemanticGlobalAuthorityOrigin::LOCAL_ALIAS

def unknown_origin_can_be_erased_by_an_arbitrary_joined_origin(origin: usize) -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::join_reference_origins(SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS, origin) == origin

def opaque_expression_without_type_can_have_no_origin() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::opaque_expression_origin(false, false) == SemanticGlobalAuthorityOrigin::NO_ORIGIN

def opaque_reference_bearing_expression_can_have_no_origin() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::opaque_expression_origin(true, true) == SemanticGlobalAuthorityOrigin::NO_ORIGIN

def known_reference_free_expression_must_be_unknown() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::opaque_expression_origin(true, false) == SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS

def incomplete_constructor_can_keep_a_known_local_summary() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::constructor_origin(SemanticGlobalAuthorityOrigin::LOCAL_ALIAS, false) == SemanticGlobalAuthorityOrigin::LOCAL_ALIAS

def complete_constructor_must_be_unknown() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::constructor_origin(SemanticGlobalAuthorityOrigin::LOCAL_ALIAS, true) == SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS

def unknown_alias_write_can_require_only_global_read() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::unknown_alias_permission(true) == "Global.Read"

def unknown_alias_read_can_require_global_write() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::unknown_alias_permission(false) == "Global.Write"

def unknown_alias_can_skip_conservative_access() -> bool:
    ensure result == true
    return not SemanticGlobalAuthorityOrigin::requires_unknown_alias_permission(SemanticGlobalAuthorityOrigin::UNKNOWN_ALIAS)

def missing_origin_can_skip_conservative_access() -> bool:
    ensure result == true
    return not SemanticGlobalAuthorityOrigin::requires_unknown_alias_permission(SemanticGlobalAuthorityOrigin::NO_ORIGIN)

def detached_storage_can_require_conservative_access() -> bool:
    ensure result == true
    return SemanticGlobalAuthorityOrigin::requires_unknown_alias_permission(SemanticGlobalAuthorityOrigin::LOCAL_ALIAS)

def encoded_local_origin_can_require_unknown_alias_access(global_count: usize, identity: usize) -> bool:
    requires global_count < SemanticGlobalAuthorityOrigin::LOCAL_ALIAS
    requires identity < SemanticGlobalAuthorityOrigin::LOCAL_ALIAS - global_count
    ensure result == true
    return SemanticGlobalAuthorityOrigin::requires_unknown_alias_permission(global_count + identity)
