# These false claims must remain unproved against the actual StringView helpers.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

def invalid_view_index_can_read_a_nonzero_byte(view: sview, index: usize) -> bool can[Unsafe.UncheckedIndex]:
    requires not string_view_index_request_valid(view, index.i64())
    ensure result == true
    return sview_at(view, index) != 0

def valid_view_index_can_read_a_different_byte(view: sview, index: usize) -> bool can[Unsafe.UncheckedIndex]:
    requires string_view_index_request_valid(view, index.i64())
    ensure result == true
    return sview_at(view, index) != view.data[index]

def search_can_skip_an_earlier_matching_byte(
    view: sview,
    byte: u8,
    earlier: i64,
    later: i64
) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len >= 0 and view.len.usize().i64() == view.len
    requires earlier >= 0 and earlier < later and later < view.len
    requires string_view_index(view, earlier) == byte.i64()
    requires string_view_index(view, later) == byte.i64()
    ensure result == true
    return sview_find_byte(view, byte) == later

def invalid_view_length_can_return_a_found_offset(view: sview, byte: u8) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len < 0 or view.len.usize().i64() != view.len
    ensure result == true
    return sview_find_byte(view, byte) >= 0

def a_negative_length_property_can_equal_the_normalized_helper(view: sview) -> bool:
    requires view.length < 0
    ensure result == true
    return view.length == sview_len(view).i64()

def an_out_of_range_index_can_disagree_with_the_safe_helper(view: sview, index: usize) -> bool can[Unsafe.UncheckedIndex]:
    requires not string_view_index_request_valid(view, index.i64())
    ensure result == true
    return view[index] != sview_at(view, index).i64()
