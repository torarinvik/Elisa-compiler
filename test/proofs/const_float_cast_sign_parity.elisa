# Boolean proof of unary sign composition, source-linked by the strict checker
# to ConstFloatCastRange::negative_after_unary.
def negative_after_unary_boolean_spec(is_minus: bool, operand_is_negative: bool) -> bool:
    ensure result == ((is_minus and not operand_is_negative) or (not is_minus and operand_is_negative))
    return (is_minus and not operand_is_negative) or (not is_minus and operand_is_negative)

def one_unary_minus_flips_sign(operand_is_negative: bool) -> bool:
    ensure result == not operand_is_negative
    return negative_after_unary_boolean_spec(true, operand_is_negative)

def double_unary_minus_restores_sign(operand_is_negative: bool) -> bool:
    ensure result == operand_is_negative
    inner_sign: bool = negative_after_unary_boolean_spec(true, operand_is_negative)
    return negative_after_unary_boolean_spec(true, inner_sign)

def unary_plus_preserves_sign(operand_is_negative: bool) -> bool:
    ensure result == operand_is_negative
    return negative_after_unary_boolean_spec(false, operand_is_negative)
