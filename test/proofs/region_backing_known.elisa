# Direct source proof of the finite backing-strategy classifier used by semantic validation.
include "../../src/semantic/region_backing_known.elisa"

def region_strategy_classifier_matches_its_complete_specification(name: sview) -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return RegionBackingKnown::is_known(name) == (when name: "malloc" -> true "reserve_commit" -> true "fixed" -> true "chained" -> true "scratch" -> true _ -> false)

def every_supported_region_strategy_is_recognized() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            RegionBackingKnown::is_known("malloc")
            and RegionBackingKnown::is_known("reserve_commit")
            and RegionBackingKnown::is_known("fixed")
            and RegionBackingKnown::is_known("chained")
            and RegionBackingKnown::is_known("scratch")
        )

def unsupported_examples_are_rejected() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            not RegionBackingKnown::is_known("")
            and not RegionBackingKnown::is_known("bogus")
            and not RegionBackingKnown::is_known("fixedx")
        )

def classifier_is_case_sensitive() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return (
            not RegionBackingKnown::is_known("Malloc")
            and not RegionBackingKnown::is_known("RESERVE_COMMIT")
        )
