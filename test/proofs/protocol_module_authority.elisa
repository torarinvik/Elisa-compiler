include "../../src/semantic/protocol_owner_domain.elisa"

def owner_module_has_authority() -> bool:
    ensure result == true
    return ProtocolOwner::authority(true, true, true, true, false)

def descendant_has_authority() -> bool:
    ensure result == true
    return ProtocolOwner::authority(true, true, false, true, true)

def peer_has_no_authority() -> bool:
    ensure result == false
    return ProtocolOwner::authority(true, true, false, true, false)

def root_module_has_authority() -> bool:
    ensure result == true
    return ProtocolOwner::authority(true, true, true, false, false)

def root_is_not_blanket_authority(descendant: bool) -> bool:
    ensure result == false
    return ProtocolOwner::authority(true, true, false, false, descendant)

def unknown_family_has_no_authority(same: bool, nonroot: bool, descendant: bool) -> bool:
    ensure result == false
    return ProtocolOwner::authority(false, true, same, nonroot, descendant)

def unknown_caller_has_no_authority(same: bool, nonroot: bool, descendant: bool) -> bool:
    ensure result == false
    return ProtocolOwner::authority(true, false, same, nonroot, descendant)

def illegal_peer_blocks_transition(left: bool) -> bool:
    ensure result == false
    return ProtocolOwner::all_paths(left, false)

def illegal_entry_blocks_transition(right: bool) -> bool:
    ensure result == false
    return ProtocolOwner::all_paths(false, right)

def every_legal_path_allows_edge_check() -> bool:
    ensure result == true
    return ProtocolOwner::all_paths(true, true)
