# Small proof model for the adjacent-character underscore decision in the numeric lexer.
include "../../src/lexer/lexer_number_classification.elisa"

def numeric_separator_model(previous: char, following: char) -> LexerNumberClassification::NumberClass:
    ensure result == (LexerNumberClassification::NumberClass.DecimalSeparator if LexerNumberClassification::is_decimal_digit(previous) and LexerNumberClassification::is_decimal_digit(following) else LexerNumberClassification::NumberClass.HexSeparator if LexerNumberClassification::is_hex_digit(previous) and LexerNumberClassification::is_hex_digit(following) else LexerNumberClassification::NumberClass.Other)
    return LexerNumberClassification::NumberClass.DecimalSeparator if LexerNumberClassification::is_decimal_digit(previous) and LexerNumberClassification::is_decimal_digit(following) else LexerNumberClassification::NumberClass.HexSeparator if LexerNumberClassification::is_hex_digit(previous) and LexerNumberClassification::is_hex_digit(following) else LexerNumberClassification::NumberClass.Other
