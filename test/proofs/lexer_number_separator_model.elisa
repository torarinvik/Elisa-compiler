# Small proof model for the adjacent-character underscore decision in the numeric lexer.
include "../../src/lexer/lexer_number_classification.elisa"

def numeric_separator_model(previous: char, following: char) -> LexerNumberClassification::NumberClass:
    ensure (LexerNumberClassification::is_decimal_digit(previous) and LexerNumberClassification::is_decimal_digit(following)) implies result == LexerNumberClassification::NumberClass.DecimalSeparator
    ensure (not (LexerNumberClassification::is_decimal_digit(previous) and LexerNumberClassification::is_decimal_digit(following)) and LexerNumberClassification::is_hex_digit(previous) and LexerNumberClassification::is_hex_digit(following)) implies result == LexerNumberClassification::NumberClass.HexSeparator
    ensure (not (LexerNumberClassification::is_decimal_digit(previous) and LexerNumberClassification::is_decimal_digit(following)) and not (LexerNumberClassification::is_hex_digit(previous) and LexerNumberClassification::is_hex_digit(following))) implies result == LexerNumberClassification::NumberClass.Other
    if LexerNumberClassification::is_decimal_digit(previous) and LexerNumberClassification::is_decimal_digit(following):
        return LexerNumberClassification::NumberClass.DecimalSeparator
    if LexerNumberClassification::is_hex_digit(previous) and LexerNumberClassification::is_hex_digit(following):
        return LexerNumberClassification::NumberClass.HexSeparator
    return LexerNumberClassification::NumberClass.Other
