include "./global_authority_postfix_cast_name.elisa"

def lowercase_dstr_is_a_postfix_cast() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return GlobalAuthorityPostfixCastName::is_postfix_cast_name("dstr")

def unsupported_u128_is_a_postfix_cast() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return GlobalAuthorityPostfixCastName::is_postfix_cast_name("u128")

def empty_name_is_a_postfix_cast() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return GlobalAuthorityPostfixCastName::is_postfix_cast_name("")
