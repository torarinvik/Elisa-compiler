# The source lookup must reject empty spans. This intentionally false claim
# checks that the proof kernel does not accept a returned identity here.
include "ownership_binding_lookup.elisa"

def zero_width_span_is_known(table: Semantic::SymbolTable&, owner: u32, offset: u32) -> bool:
    requires owner.usize() < table.symbols.count
    ensure result == true
    can Abort.Panic:
        position: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: offset, end_line: 1, end_column: 1, end_offset: offset}
        lookup_result: Semantic::OwnershipBindingLookupResult = Semantic::ownership_binding_at_position(table, Semantic::DeclId{value: owner}, position)
        return lookup_result.known

def unrecorded_span_is_known(table: Semantic::SymbolTable&, owner: u32, offset: u32, end_offset: u32) -> bool:
    requires (
        owner != Semantic::INVALID_DECL_ID_VALUE
        and owner.usize() < table.symbols.count
    )
    requires table.ref_pos.count == 0 and table.ref_binding_ids.count == 0
    requires end_offset > offset
    ensure result == true
    can Abort.Panic:
        position: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: offset, end_line: 1, end_column: 2, end_offset: end_offset}
        lookup_result: Semantic::OwnershipBindingLookupResult = Semantic::ownership_binding_at_position(table, Semantic::DeclId{value: owner}, position)
        return lookup_result.known
