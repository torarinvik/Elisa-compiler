# False claims for the source-linked static character classes must be rejected.
include "./lexer_number_separator_model.elisa"

def false_claim_unicode_digit_is_ascii_digit() -> bool:
    ensure result == true
    return LexerNumberClassification::is_decimal_digit('١')

def false_claim_exponent_marker_is_plain_hex_alpha() -> bool:
    ensure result == true
    return LexerNumberClassification::classify_char('e') == LexerNumberClassification::NumberClass.HexAlpha

def false_claim_decimal_point_is_a_fraction_opening_class() -> bool:
    ensure result == true
    return LexerNumberClassification::classify_char('.') == LexerNumberClassification::NumberClass.FractionDot

def false_claim_plus_sign_is_a_valid_exponent_marker_class() -> bool:
    ensure result == true
    return LexerNumberClassification::classify_char('+') == LexerNumberClassification::NumberClass.ExpMarkValid

def false_claim_decimal_digit_pair_is_a_hex_separator() -> bool:
    ensure result == true
    return numeric_separator_model('1', '9') == LexerNumberClassification::NumberClass.HexSeparator

def false_claim_mixed_decimal_hex_pair_is_a_decimal_separator() -> bool:
    ensure result == true
    return numeric_separator_model('1', 'a') == LexerNumberClassification::NumberClass.DecimalSeparator
