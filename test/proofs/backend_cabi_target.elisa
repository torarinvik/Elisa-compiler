# Target selection uses wasm target-triple detection first, then the explicit
# x86-64 build flag, and otherwise the arm64 classifier.
def cabi_target_policy(is_wasm: bool, x86_environment_enabled: bool) -> i64:
    ensure result == (2 if is_wasm else 1 if x86_environment_enabled else 0)
    return 2 if is_wasm else 1 if x86_environment_enabled else 0

def wasm_target_takes_priority_over_x86_flag(is_wasm: bool, x86_environment_enabled: bool) -> i64:
    requires is_wasm
    ensure result == 2
    return 2 if is_wasm else 1 if x86_environment_enabled else 0

def x86_flag_selects_x86_when_not_wasm(is_wasm: bool, x86_environment_enabled: bool) -> i64:
    requires not is_wasm and x86_environment_enabled
    ensure result == 1
    return 2 if is_wasm else 1 if x86_environment_enabled else 0

def no_wasm_or_x86_flag_selects_arm64(is_wasm: bool, x86_environment_enabled: bool) -> i64:
    requires not is_wasm and not x86_environment_enabled
    ensure result == 0
    return 0
