include "../../src/lexer/lexer_comment_scan.elisa"

def line_comment_step_keeps_the_same_offset(position: usize, source_length: usize) -> bool:
    requires position < source_length
    ensure result == true
    return LexerCommentScan::after_one(position, source_length) == position

def one_comment_step_increases_remaining_input(position: usize, source_length: usize) -> bool:
    requires position < source_length
    ensure result == true
    return LexerCommentScan::remaining(source_length, LexerCommentScan::after_one(position, source_length)) > LexerCommentScan::remaining(source_length, position)

def a_three_character_delimiter_advances_by_two(position: usize, source_length: usize) -> bool:
    requires position <= source_length
    requires source_length - position >= 3
    ensure result == true
    return LexerCommentScan::after_three(position, source_length) == position + 2

def a_three_character_delimiter_advances_column_by_two(column: int) -> bool:
    ensure result == true
    return LexerCommentScan::column_after_three(column) == column + 2
