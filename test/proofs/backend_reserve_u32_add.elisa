# On 32-bit targets, reserve arithmetic is carried in i64 and each operand
# and the resulting value is checked against the u32 target maximum.
const RESERVE_U32_MAX: u64 = 4294967295
const RESERVE_U32_SUM_MAX: u64 = 8589934590

def reserve_u32_add_operands_bound_the_wide_sum(left: u64, right: u64) -> u64:
    requires left <= RESERVE_U32_MAX
    requires right <= RESERVE_U32_MAX
    ensure result <= RESERVE_U32_SUM_MAX
    return left + right

def reserve_u32_add_accepted_result_fits_target(left: u64, right: u64) -> u64:
    requires left <= RESERVE_U32_MAX
    requires right <= RESERVE_U32_MAX
    requires left + right <= RESERVE_U32_MAX
    ensure result <= RESERVE_U32_MAX
    return left + right
