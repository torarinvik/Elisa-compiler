module Semantic:
    private:
        const ENUM_TAG_INDEX_PROOF_NAMESPACE: i64 = 0

include "../../src/semantic/enum_tag_lookup_index.elisa"

extend Semantic:
    public:
        def duplicate_enum_names_keep_the_first_count() -> bool:
            ensure result == true
            names: darray[sview] = ["Same", "Other", "Same"]
            counts: darray[i64] = [2, 5, 9]
            can Abort.Panic:
                return indexed_enum_tag_count(names, counts, "Same") == 2

        def absent_enum_names_return_zero() -> bool:
            ensure result == true
            names: darray[sview] = ["Same", "Other"]
            counts: darray[i64] = [2, 5]
            can Abort.Panic:
                return indexed_enum_tag_count(names, counts, "Missing") == 0

        # The production helper stays memory-safe even if an internal caller supplies
        # malformed parallel arrays; the collector itself produces aligned rows.
        def a_short_count_array_fails_closed() -> bool:
            ensure result == true
            names: darray[sview] = ["Same", "Other"]
            counts: darray[i64] = [2]
            can Abort.Panic:
                return indexed_enum_tag_count(names, counts, "Other") == 0

