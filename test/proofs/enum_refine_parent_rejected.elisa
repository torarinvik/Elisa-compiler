include "./enum_refine_parent.elisa"

def ordinary_annotation_row_is_reported() -> bool:
    ensure result == true
    return EnumRefineParentRule::should_report(EnumRefineParentRule::ORDINARY_ANNOTATION_ROW, "BadEnum", "PlainStruct", true, true)

def empty_parent_name_is_reported() -> bool:
    ensure result == true
    return EnumRefineParentRule::should_report(EnumRefineParentRule::ENUM_REFINE_PARENT_ROW, "BadEnum", "", true, true)

def empty_enum_name_is_reported() -> bool:
    ensure result == true
    return EnumRefineParentRule::should_report(EnumRefineParentRule::ENUM_REFINE_PARENT_ROW, "", "PlainStruct", true, true)

def unresolved_parent_is_rejected_as_a_struct() -> bool:
    ensure result == true
    return EnumRefineParentRule::should_report(EnumRefineParentRule::ENUM_REFINE_PARENT_ROW, "BadEnum", "MissingType", false, true)

def enum_parent_is_rejected_as_a_struct() -> bool:
    ensure result == true
    return EnumRefineParentRule::should_report(EnumRefineParentRule::ENUM_REFINE_PARENT_ROW, "ChildEnum", "BaseEnum", true, false)
