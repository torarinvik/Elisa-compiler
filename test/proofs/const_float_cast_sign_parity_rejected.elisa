# The double-minus function restores the operand sign; it cannot always flip it.
include "./const_float_cast_sign_parity.elisa"

def false_claim_double_minus_flips_sign(operand_is_negative: bool) -> bool:
    ensure result == not operand_is_negative
    inner_sign: bool = negative_after_unary_boolean_spec(true, operand_is_negative)
    return negative_after_unary_boolean_spec(true, inner_sign)
