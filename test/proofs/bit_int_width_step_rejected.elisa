include "./bit_int_width_step.elisa"

def false_width_sixty_four_is_accepted() -> bool:
    ensure result == true
    width_prefix: i64 = SemanticBitIntWidth::BIT_INT_WIDTH_LIMIT / SemanticBitIntWidth::DECIMAL_RADIX
    final_digit: i64 = SemanticBitIntWidth::BIT_INT_WIDTH_LIMIT % SemanticBitIntWidth::DECIMAL_RADIX
    step: (valid: bool, value: i64) = SemanticBitIntWidth::append_digit(width_prefix, final_digit)
    return step.valid

def false_overwide_prefix_is_accepted(width: i64, digit: i64) -> bool:
    requires width >= SemanticBitIntWidth::BIT_INT_WIDTH_LIMIT
    requires digit >= SemanticBitIntWidth::DECIMAL_DIGIT_MIN and digit <= SemanticBitIntWidth::DECIMAL_DIGIT_MAX
    ensure result == true
    step: (valid: bool, value: i64) = SemanticBitIntWidth::append_digit(width, digit)
    return step.valid

def false_invalid_digit_is_accepted(width: i64, digit: i64) -> bool:
    requires width >= SemanticBitIntWidth::BIT_INT_PREFIX_MIN and width <= SemanticBitIntWidth::BIT_INT_MAX_WIDTH
    requires digit < SemanticBitIntWidth::DECIMAL_DIGIT_MIN or digit > SemanticBitIntWidth::DECIMAL_DIGIT_MAX
    ensure result == true
    step: (valid: bool, value: i64) = SemanticBitIntWidth::append_digit(width, digit)
    return step.valid

def false_maximum_candidate_is_below_its_bound() -> bool:
    ensure result == true
    width_prefix: i64 = SemanticBitIntWidth::BIT_INT_MAX_WIDTH / SemanticBitIntWidth::DECIMAL_RADIX
    step: (valid: bool, value: i64) = SemanticBitIntWidth::append_digit(width_prefix, SemanticBitIntWidth::DECIMAL_DIGIT_MAX)
    return step.valid or SemanticBitIntWidth::MAX_WIDTH_CANDIDATE < SemanticBitIntWidth::BIT_INT_MAX_WIDTH * SemanticBitIntWidth::DECIMAL_RADIX + SemanticBitIntWidth::DECIMAL_DIGIT_MAX

def false_every_two_digit_decimal_suffix_is_accepted(first_digit: i64, second_digit: i64) -> bool:
    requires first_digit >= SemanticBitIntWidth::DECIMAL_DIGIT_MIN and first_digit <= SemanticBitIntWidth::DECIMAL_DIGIT_MAX
    requires second_digit >= SemanticBitIntWidth::DECIMAL_DIGIT_MIN and second_digit <= SemanticBitIntWidth::DECIMAL_DIGIT_MAX
    ensure result == true
    first: (valid: bool, value: i64) = SemanticBitIntWidth::append_digit(SemanticBitIntWidth::BIT_INT_PREFIX_MIN, first_digit)
    step: (valid: bool, value: i64) = SemanticBitIntWidth::append_digit(first.value, second_digit)
    return first.valid and step.valid

def false_unsigned_63_high_is_the_i63_maximum() -> bool:
    ensure result == true
    high: i64 = SemanticBitIntWidth::unsigned_63_high_endpoint()
    return high == SemanticBitIntWidth::I64_MAX / 2

def false_zero_final_width_is_supported() -> bool:
    ensure result == true
    return SemanticBitIntWidth::supported_final_width(SemanticBitIntWidth::BIT_INT_PREFIX_MIN)

def false_width_above_limit_is_supported() -> bool:
    ensure result == true
    return SemanticBitIntWidth::supported_final_width(SemanticBitIntWidth::BIT_INT_WIDTH_LIMIT)

def false_minimum_final_width_is_rejected() -> bool:
    ensure result == true
    return not SemanticBitIntWidth::supported_final_width(SemanticBitIntWidth::BIT_INT_MIN_WIDTH)

def false_maximum_final_width_is_rejected() -> bool:
    ensure result == true
    return not SemanticBitIntWidth::supported_final_width(SemanticBitIntWidth::BIT_INT_MAX_WIDTH)
