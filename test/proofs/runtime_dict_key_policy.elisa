# Source-bound proofs for runtime-backed dictionary key spellings and diagnostics.
include "../../src/semantic/runtime_dict_key_policy.elisa"

def resolved_key_classifier_is_exact(spelling: sview) -> bool:
    ensure result == true
    return SemanticRuntimeDictKeyPolicy::is_unhashable_resolved_key_spelling(spelling) == (
        spelling == "sview" or spelling == "dstr" or spelling == "f32" or spelling == "f64"
    )

def declared_spelling_check_is_exact(spelling: sview) -> bool:
    ensure result == true
    return SemanticRuntimeDictKeyPolicy::requires_declared_key_spelling_check(spelling) == (
        spelling == "sview" or spelling == "dstr"
    )

def diagnostic_spelling_is_exact_for_every_input(spelling: sview) -> bool:
    ensure result == true
    return SemanticRuntimeDictKeyPolicy::diagnostic_spelling(spelling) == (
        "darray[u8]" if spelling == "dstr" else spelling
    )

def resolved_and_declared_checks_cover_distinct_normalization_cases() -> bool:
    ensure result == true
    return SemanticRuntimeDictKeyPolicy::is_unhashable_resolved_key_spelling("sview") and
        SemanticRuntimeDictKeyPolicy::is_unhashable_resolved_key_spelling("dstr") and
        SemanticRuntimeDictKeyPolicy::is_unhashable_resolved_key_spelling("f32") and
        SemanticRuntimeDictKeyPolicy::is_unhashable_resolved_key_spelling("f64") and
        SemanticRuntimeDictKeyPolicy::requires_declared_key_spelling_check("sview") and
        SemanticRuntimeDictKeyPolicy::requires_declared_key_spelling_check("dstr") and
        not SemanticRuntimeDictKeyPolicy::requires_declared_key_spelling_check("f32") and
        not SemanticRuntimeDictKeyPolicy::requires_declared_key_spelling_check("f64") and
        not SemanticRuntimeDictKeyPolicy::is_unhashable_resolved_key_spelling("cstr") and
        not SemanticRuntimeDictKeyPolicy::is_unhashable_resolved_key_spelling("i64")

def dstr_uses_its_lowered_type_in_both_diagnostic_slots() -> bool:
    ensure result == true
    return SemanticRuntimeDictKeyPolicy::diagnostic_spelling("dstr") == "darray[u8]" and
        SemanticRuntimeDictKeyPolicy::diagnostic_spelling("sview") == "sview" and
        SemanticRuntimeDictKeyPolicy::diagnostic_spelling("cstr") == "cstr" and
        SemanticRuntimeDictKeyPolicy::diagnostic_spelling("i64") == "i64"
