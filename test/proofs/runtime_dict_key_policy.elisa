# Source-bound proofs for runtime-backed dictionary key spellings and diagnostics.
include "../../src/semantic/runtime_dict_key_policy.elisa"

def resolved_key_classifier_is_exact(spelling: sview) -> bool:
    ensure result == true
    return SemanticRuntimeDictKeyPolicy::is_unhashable_resolved_key_spelling(spelling) == (when spelling:
        "sview" | "dstr" | "f32" | "f64" -> true
        _ -> false
    )

def declared_spelling_check_is_exact(spelling: sview) -> bool:
    ensure result == true
    return SemanticRuntimeDictKeyPolicy::requires_declared_key_spelling_check(spelling) == (when spelling:
        "sview" | "dstr" -> true
        _ -> false
    )

def diagnostic_spelling_is_exact_for_every_input(spelling: sview) -> bool:
    ensure result == true
    return SemanticRuntimeDictKeyPolicy::diagnostic_spelling(spelling) == (when spelling:
        "dstr" -> "darray[u8]"
        _ -> spelling
    )

