# False source-span bounds and sentinels must remain unprovable.
include "../../src/backend/easm_model.elisa"
include "../../src/backend/easm_text_scan.elisa"
include "../../src/backend/easm_compose_text.elisa"

def comma_separated_arguments_can_be_counted_as_empty() -> bool:
    ensure result == true
    return Easm::easm_compose_argument_count("dst, src") == 0

def in_range_argument_index_can_have_an_invalid_span(text: sview, wanted: i64) -> bool:
    requires wanted >= 0 and wanted < Easm::easm_compose_span_argument_count(text)
    ensure result == true
    span: Easm::ComposeSpan = Easm::easm_compose_span(text, wanted)
    return not span.valid

def valid_span_can_end_past_its_source(text: sview, wanted: i64) -> bool:
    ensure result == true
    span: Easm::ComposeSpan = Easm::easm_compose_span(text, wanted)
    return span.valid implies span.end > text.len

def valid_span_can_reverse_its_bounds(text: sview, wanted: i64) -> bool:
    ensure result == true
    span: Easm::ComposeSpan = Easm::easm_compose_span(text, wanted)
    return span.valid implies span.start > span.end

def invalid_span_can_return_nonzero_bounds(text: sview, wanted: i64) -> bool:
    ensure result == true
    span: Easm::ComposeSpan = Easm::easm_compose_span(text, wanted)
    return not span.valid and (span.start != 0 or span.end != 0)
