# Source-linked proof for overflow-safe signed decimal digit accumulation in EASM facts.
include "../../src/backend/easm_checked_decimal.elisa"
include "../../src/backend/easm_memstate_domain.elisa"

def positive_digit_step_obeys_its_exact_i64_boundary(value: i64, digit: i64) -> bool:
    requires value >= 0 and digit >= 0 and digit <= EasmCheckedDecimal::MAX_DECIMAL_DIGIT
    ensure result == true
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_positive_digit(value, digit)
    return (
        step.valid == (value < EasmCheckedDecimal::I64_MAX / EasmCheckedDecimal::DECIMAL_RADIX
            or (value == EasmCheckedDecimal::I64_MAX / EasmCheckedDecimal::DECIMAL_RADIX
                and digit <= EasmCheckedDecimal::I64_MAX % EasmCheckedDecimal::DECIMAL_RADIX))
        and (not step.valid or step.value == value * EasmCheckedDecimal::DECIMAL_RADIX + digit)
        and (step.valid or step.value == 0)
    )

def negative_digit_step_obeys_its_exact_i64_boundary(value: i64, digit: i64) -> bool:
    requires value <= 0 and digit >= 0 and digit <= EasmCheckedDecimal::MAX_DECIMAL_DIGIT
    ensure result == true
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_negative_digit(value, digit)
    return (
        step.valid == (value > EasmCheckedDecimal::I64_MIN / EasmCheckedDecimal::DECIMAL_RADIX
            or (value == EasmCheckedDecimal::I64_MIN / EasmCheckedDecimal::DECIMAL_RADIX
                and digit <= 0 - (EasmCheckedDecimal::I64_MIN % EasmCheckedDecimal::DECIMAL_RADIX)))
        and (not step.valid or step.value == value * EasmCheckedDecimal::DECIMAL_RADIX - digit)
        and (step.valid or step.value == 0)
    )

def positive_digit_step_preserves_the_i64_range(value: i64, digit: i64) -> bool:
    requires value >= 0 and digit >= 0 and digit <= EasmCheckedDecimal::MAX_DECIMAL_DIGIT
    ensure result == true
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_positive_digit(value, digit)
    return not step.valid or (step.value >= 0 and step.value <= EasmCheckedDecimal::I64_MAX)

def negative_digit_step_preserves_the_i64_range(value: i64, digit: i64) -> bool:
    requires value <= 0 and digit >= 0 and digit <= EasmCheckedDecimal::MAX_DECIMAL_DIGIT
    ensure result == true
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_negative_digit(value, digit)
    return not step.valid or (step.value >= EasmCheckedDecimal::I64_MIN and step.value <= 0)

def positive_ascii_digit_byte_step_preserves_the_i64_range(value: i64, byte: u8) -> bool:
    requires value >= 0 and byte >= EasmCheckedDecimal::ASCII_DIGIT_ZERO and byte <= EasmCheckedDecimal::ASCII_DIGIT_NINE
    ensure result == true
    digit: i64 = (byte - EasmCheckedDecimal::ASCII_DIGIT_ZERO).i64()
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_positive_digit(value, digit)
    return not step.valid or (step.value >= 0 and step.value <= EasmCheckedDecimal::I64_MAX)

def negative_ascii_digit_byte_step_preserves_the_i64_range(value: i64, byte: u8) -> bool:
    requires value <= 0 and byte >= EasmCheckedDecimal::ASCII_DIGIT_ZERO and byte <= EasmCheckedDecimal::ASCII_DIGIT_NINE
    ensure result == true
    digit: i64 = (byte - EasmCheckedDecimal::ASCII_DIGIT_ZERO).i64()
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_negative_digit(value, digit)
    return not step.valid or (step.value >= EasmCheckedDecimal::I64_MIN and step.value <= 0)

def positive_i64_max_is_reached_without_overflow() -> bool:
    ensure result == true
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_positive_digit(
        EasmCheckedDecimal::I64_MAX / EasmCheckedDecimal::DECIMAL_RADIX,
        EasmCheckedDecimal::I64_MAX % EasmCheckedDecimal::DECIMAL_RADIX)
    return step.valid and step.value == EasmCheckedDecimal::I64_MAX

def negative_i64_min_is_reached_without_overflow() -> bool:
    ensure result == true
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_negative_digit(
        EasmCheckedDecimal::I64_MIN / EasmCheckedDecimal::DECIMAL_RADIX,
        0 - (EasmCheckedDecimal::I64_MIN % EasmCheckedDecimal::DECIMAL_RADIX))
    return step.valid and step.value == EasmCheckedDecimal::I64_MIN

def signed_parser_accepts_only_well_formed_decimal_bytes(text: sview) -> bool:
    ensure result == true
    parsed: (valid: bool, value: i64) = EasmCheckedDecimal::parse_signed(text)
    return not parsed.valid or (
        text.length > 0
        and (text[0] != EasmCheckedDecimal::ASCII_MINUS or text.length > 1)
        and (forall digit_index in 0..<text.length:
            (digit_index == 0 and text[digit_index] == EasmCheckedDecimal::ASCII_MINUS)
            or (text[digit_index] >= EasmCheckedDecimal::ASCII_DIGIT_ZERO
                and text[digit_index] <= EasmCheckedDecimal::ASCII_DIGIT_NINE)
        )
    )

def signed_parser_returns_zero_on_every_rejection(text: sview) -> bool:
    ensure result == true
    parsed: (valid: bool, value: i64) = EasmCheckedDecimal::parse_signed(text)
    return parsed.valid or parsed.value == 0

def nonpositive_decimal_size_fact_does_not_strengthen_an_existing_bound(current: i64, text: sview) -> bool:
    requires current >= 0
    ensure result == true
    parsed: (valid: bool, value: i64) = EasmCheckedDecimal::parse_signed(text)
    return parsed.value > 0 or EasmMemStateDomain::greatest_bound(current, parsed.value) == current

def signed_parser_preserves_the_sign_of_every_valid_result(text: sview) -> bool:
    ensure result == true
    parsed: (valid: bool, value: i64) = EasmCheckedDecimal::parse_signed(text)
    return not parsed.valid or (
        text.length > 0
        and (
            (text[0] == EasmCheckedDecimal::ASCII_MINUS and parsed.value <= 0)
            or (text[0] != EasmCheckedDecimal::ASCII_MINUS and parsed.value >= 0)
        )
    )

def signed_parser_rejects_empty_or_incomplete_signs() -> bool:
    ensure result == true
    empty: (valid: bool, value: i64) = EasmCheckedDecimal::parse_signed("")
    sign_only: (valid: bool, value: i64) = EasmCheckedDecimal::parse_signed("-")
    plus_sign: (valid: bool, value: i64) = EasmCheckedDecimal::parse_signed("+1")
    return (
        not empty.valid and empty.value == 0
        and not sign_only.valid and sign_only.value == 0
        and not plus_sign.valid and plus_sign.value == 0
    )

def signed_parser_computes_both_i64_extremes() -> bool:
    ensure result == true
    positive: (valid: bool, value: i64) = EasmCheckedDecimal::parse_signed("9223372036854775807")
    negative: (valid: bool, value: i64) = EasmCheckedDecimal::parse_signed("-9223372036854775808")
    return (
        positive.valid and positive.value == EasmCheckedDecimal::I64_MAX
        and negative.valid and negative.value == EasmCheckedDecimal::I64_MIN
    )

def signed_parser_rejects_both_i64_overflows() -> bool:
    ensure result == true
    positive: (valid: bool, value: i64) = EasmCheckedDecimal::parse_signed("9223372036854775808")
    negative: (valid: bool, value: i64) = EasmCheckedDecimal::parse_signed("-9223372036854775809")
    return not positive.valid and positive.value == 0 and not negative.valid and negative.value == 0
