# Source-linked proof for overflow-safe signed decimal digit accumulation in EASM facts.
include "../../src/backend/easm_checked_decimal.elisa"

def positive_digit_step_obeys_its_exact_i64_boundary(value: i64, digit: i64) -> bool:
    requires value >= 0 and digit >= 0 and digit <= EasmCheckedDecimal::MAX_DECIMAL_DIGIT
    ensure result == true
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_positive_digit(value, digit)
    return (
        step.valid == (value < EasmCheckedDecimal::I64_MAX / EasmCheckedDecimal::DECIMAL_RADIX
            or (value == EasmCheckedDecimal::I64_MAX / EasmCheckedDecimal::DECIMAL_RADIX
                and digit <= EasmCheckedDecimal::I64_MAX % EasmCheckedDecimal::DECIMAL_RADIX))
        and (not step.valid or step.value == value * EasmCheckedDecimal::DECIMAL_RADIX + digit)
        and (step.valid or step.value == 0)
    )

def negative_digit_step_obeys_its_exact_i64_boundary(value: i64, digit: i64) -> bool:
    requires value <= 0 and digit >= 0 and digit <= EasmCheckedDecimal::MAX_DECIMAL_DIGIT
    ensure result == true
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_negative_digit(value, digit)
    return (
        step.valid == (value > EasmCheckedDecimal::I64_MIN / EasmCheckedDecimal::DECIMAL_RADIX
            or (value == EasmCheckedDecimal::I64_MIN / EasmCheckedDecimal::DECIMAL_RADIX
                and digit <= 0 - (EasmCheckedDecimal::I64_MIN % EasmCheckedDecimal::DECIMAL_RADIX)))
        and (not step.valid or step.value == value * EasmCheckedDecimal::DECIMAL_RADIX - digit)
        and (step.valid or step.value == 0)
    )

def positive_digit_step_preserves_the_i64_range(value: i64, digit: i64) -> bool:
    requires value >= 0 and digit >= 0 and digit <= EasmCheckedDecimal::MAX_DECIMAL_DIGIT
    ensure result == true
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_positive_digit(value, digit)
    return not step.valid or (step.value >= 0 and step.value <= EasmCheckedDecimal::I64_MAX)

def negative_digit_step_preserves_the_i64_range(value: i64, digit: i64) -> bool:
    requires value <= 0 and digit >= 0 and digit <= EasmCheckedDecimal::MAX_DECIMAL_DIGIT
    ensure result == true
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_negative_digit(value, digit)
    return not step.valid or (step.value >= EasmCheckedDecimal::I64_MIN and step.value <= 0)

def positive_ascii_digit_byte_step_preserves_the_i64_range(value: i64, byte: u8) -> bool:
    requires value >= 0 and byte >= EasmCheckedDecimal::ASCII_DIGIT_ZERO and byte <= EasmCheckedDecimal::ASCII_DIGIT_NINE
    ensure result == true
    digit: i64 = (byte - EasmCheckedDecimal::ASCII_DIGIT_ZERO).i64()
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_positive_digit(value, digit)
    return not step.valid or (step.value >= 0 and step.value <= EasmCheckedDecimal::I64_MAX)

def negative_ascii_digit_byte_step_preserves_the_i64_range(value: i64, byte: u8) -> bool:
    requires value <= 0 and byte >= EasmCheckedDecimal::ASCII_DIGIT_ZERO and byte <= EasmCheckedDecimal::ASCII_DIGIT_NINE
    ensure result == true
    digit: i64 = (byte - EasmCheckedDecimal::ASCII_DIGIT_ZERO).i64()
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_negative_digit(value, digit)
    return not step.valid or (step.value >= EasmCheckedDecimal::I64_MIN and step.value <= 0)

def positive_i64_max_is_reached_without_overflow() -> bool:
    ensure result == true
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_positive_digit(
        EasmCheckedDecimal::I64_MAX / EasmCheckedDecimal::DECIMAL_RADIX,
        EasmCheckedDecimal::I64_MAX % EasmCheckedDecimal::DECIMAL_RADIX)
    return step.valid and step.value == EasmCheckedDecimal::I64_MAX

def negative_i64_min_is_reached_without_overflow() -> bool:
    ensure result == true
    step: (valid: bool, value: i64) = EasmCheckedDecimal::append_negative_digit(
        EasmCheckedDecimal::I64_MIN / EasmCheckedDecimal::DECIMAL_RADIX,
        0 - (EasmCheckedDecimal::I64_MIN % EasmCheckedDecimal::DECIMAL_RADIX))
    return step.valid and step.value == EasmCheckedDecimal::I64_MIN
