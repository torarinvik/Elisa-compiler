# Arithmetic invariant for the production parser's left-associative chain guard.
const BINARY_CHAIN_LIMIT: u32 = 2000

def successful_continuation_stays_within_limit(count: u32) -> bool:
    requires count < BINARY_CHAIN_LIMIT
    ensure result == true
    return count + 1 <= BINARY_CHAIN_LIMIT and count < count + 1

def limit_guard_blocks_another_continuation(count: u32) -> bool:
    requires count >= BINARY_CHAIN_LIMIT
    ensure result == false
    return count < BINARY_CHAIN_LIMIT
