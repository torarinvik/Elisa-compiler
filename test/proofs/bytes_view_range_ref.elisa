# Proof cases for the standard library's checked borrowed byte-range view.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

def valid_nonempty_range_preserves_length_and_start_address() -> bool can[Unsafe{PointerArithmetic, RawExtern}]:
    ensure result == true
    bytes: darray[u8] = [11, 23, 37, 41]
    view: sview = bytes_view_range_ref(bytes, 1.usize(), 2.usize())
    return view.len == 2 and view.data == &bytes[1.usize()]

def every_representable_valid_request_returns_its_exact_range(
    bytes: darray[u8]&,
    start: usize,
    count: usize
) -> bool can[Unsafe{PointerArithmetic, RawExtern}]:
    requires bytes_view_range_ref_request_valid(bytes, start, count)
    ensure result == true
    view: sview = bytes_view_range_ref(bytes, start, count)
    return view.len == count.i64() and view.data == &bytes[start]

def every_invalid_request_fails_closed(
    bytes: darray[u8]&,
    start: usize,
    count: usize
) -> bool can[Unsafe{PointerArithmetic, RawExtern}]:
    requires not bytes_view_range_ref_request_valid(bytes, start, count)
    ensure result == true
    view: sview = bytes_view_range_ref(bytes, start, count)
    return view.len == 0

def zero_width_range_at_end_is_empty() -> bool can[Unsafe{PointerArithmetic, RawExtern}]:
    ensure result == true
    bytes: darray[u8] = [11, 23, 37]
    view: sview = bytes_view_range_ref(bytes, bytes.count, 0.usize())
    return view.len == 0

def range_crossing_the_buffer_end_fails_closed() -> bool can[Unsafe{PointerArithmetic, RawExtern}]:
    ensure result == true
    bytes: darray[u8] = [11, 23, 37]
    view: sview = bytes_view_range_ref(bytes, bytes.count, 1.usize())
    return view.len == 0

def empty_buffer_produces_an_empty_view() -> bool can[Unsafe{PointerArithmetic, RawExtern}]:
    ensure result == true
    bytes: darray[u8] = []
    view: sview = bytes_view_range_ref(bytes, 0.usize(), 1.usize())
    return view.len == 0

def a_bounded_range_view_reads_only_the_selected_bytes() -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    ensure result == true
    bytes: darray[u8] = [11, 23, 37, 41]
    view: sview = bytes_view_range_ref(bytes, 1.usize(), 2.usize())
    return sview_at(view, 0.usize()) == 23 and sview_at(view, 1.usize()) == 37 and sview_at(view, 2.usize()) == 0

def a_by_value_bounded_range_reads_only_the_selected_bytes() -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    ensure result == true
    bytes: darray[u8] = [11, 23, 37, 41]
    view: sview = bytes_view_range(bytes, 1.usize(), 2.usize())
    return sview_at(view, 0.usize()) == 23 and sview_at(view, 1.usize()) == 37 and sview_at(view, 2.usize()) == 0

def every_valid_nonempty_by_value_range_returns_its_exact_extent(
    bytes: darray[u8],
    start: usize,
    count: usize
) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires bytes.count > 0 and bytes.items != null and bytes.count <= bytes.capacity
    requires bytes.count.i64() >= 0 and bytes.count.i64().usize() == bytes.count
    requires start <= bytes.count and count <= bytes.count - start
    requires start.i64() >= 0 and start.i64().usize() == start
    requires count.i64() > 0 and count.i64().usize() == count
    ensure result == true
    view: sview = bytes_view_range(bytes, start, count)
    return view.len == count.i64() and view.data == &bytes[start]

def every_well_formed_nonempty_buffer_produces_its_full_view(
    bytes: darray[u8],
) -> bool can[Unsafe{PointerArithmetic, RawExtern, UncheckedIndex}]:
    requires bytes.count > 0 and bytes.items != null and bytes.count <= bytes.capacity
    requires bytes.count.i64() >= 0 and bytes.count.i64().usize() == bytes.count
    ensure result == true
    view: sview = bytes_view(bytes)
    return view.len == bytes.count.i64() and view.data == &bytes[0.usize()]
