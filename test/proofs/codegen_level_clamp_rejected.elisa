# False claims against the target machine's optimization-level clamp.

def clamped_level_can_escape_enum_domain(level: i64) -> bool:
    ensure result == true
    chosen: i64 = level if level >= 0 and level <= 3 else 0
    return chosen < 0 or chosen > 3

def unsupported_level_is_not_reset(level: i64) -> bool:
    requires level < 0 or level > 3
    ensure result == true
    chosen: i64 = level if level >= 0 and level <= 3 else 0
    return chosen != 0
