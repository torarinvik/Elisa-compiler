# Mutation controls: each claim conflicts with the modeled scan transition.
include "./project_json_cursor_step.elisa"

def false_claim_whitespace_at_end_advances(length: i64, position: i64, is_space: bool) -> bool:
    requires length >= 0 and position == length and is_space
    ensure result == true
    return (position + 1 if position < length and is_space else position) == position + 1

def false_claim_non_whitespace_byte_is_consumed(length: i64, position: i64, is_space: bool) -> bool:
    requires length > 0 and position >= 0 and position < length and not is_space
    ensure result == true
    return (position + 1 if position < length and is_space else position) == position + 1
