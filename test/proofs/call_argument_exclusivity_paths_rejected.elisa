include "./call_argument_exclusivity_paths.elisa"

def sibling_fields_may_overlap() -> bool:
    ensure result == true
    kinds: darray[u8] = [0, 0]
    names: darray[sview] = ["left", "right"]
    values: darray[i64] = [0, 0]
    return CallArgumentExclusivityPaths::paths_overlap(kinds, names, values, 0, 1, 1, 1)

def distinct_literal_indices_may_overlap() -> bool:
    ensure result == true
    kinds: darray[u8] = [1, 1]
    names: darray[sview] = ["", ""]
    values: darray[i64] = [1, 2]
    return CallArgumentExclusivityPaths::paths_overlap(kinds, names, values, 0, 1, 1, 1)

def unknown_index_is_provably_disjoint() -> bool:
    ensure result == true
    kinds: darray[u8] = [1, 2]
    names: darray[sview] = ["", ""]
    values: darray[i64] = [1, 2]
    return not CallArgumentExclusivityPaths::paths_overlap(kinds, names, values, 0, 1, 1, 1)

def empty_path_is_disjoint_from_a_nonempty_path() -> bool:
    ensure result == true
    kinds: darray[u8] = [0]
    names: darray[sview] = ["field"]
    values: darray[i64] = [0]
    return not CallArgumentExclusivityPaths::paths_overlap(kinds, names, values, 0, 0, 0, 1)
