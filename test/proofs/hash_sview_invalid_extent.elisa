# Invalid StringView extents must fail closed before FNV reads a byte.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"
include "../../elisacore_std/collections.elisa"

def every_rejected_hash_extent_returns_the_initial_fnv_state(view: sview) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len <= 0 or view.len.usize().i64() != view.len
    ensure result == true
    return hash_sview(view) == 0xcbf29ce484222325

def a_nonpositive_hash_extent_returns_the_initial_fnv_state(view: sview) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len <= 0
    ensure result == true
    return hash_sview(view) == 0xcbf29ce484222325

def every_view_hash_matches_the_recursive_fnv1a_fold(view: sview) -> bool can[Unsafe.UncheckedIndex]:
    ensure result == true
    return hash_sview(view) == sview_fnv1a_model(view)

def collection_and_runtime_view_hashes_agree(view: sview) -> bool can[Unsafe.UncheckedIndex]:
    ensure result == true
    return ctx_hash_sview(view) == hash_sview(view)

def an_empty_view_hash_is_the_fnv1a_offset_basis(view: sview) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len == 0
    ensure result == true
    return hash_sview(view) == SVIEW_FNV1A_OFFSET_BASIS

def a_one_byte_view_hash_applies_one_fnv1a_step(view: sview) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len == 1 and view.len.usize().i64() == view.len
    ensure result == true
    byte: u64 = string_view_index(view, 0).u8().u64()
    return hash_sview(view) == (SVIEW_FNV1A_OFFSET_BASIS ^ byte) * SVIEW_FNV1A_PRIME

def a_two_byte_view_hash_preserves_byte_order(view: sview) -> bool can[Unsafe.UncheckedIndex]:
    requires view.len == 2 and view.len.usize().i64() == view.len
    ensure result == true
    first: u64 = string_view_index(view, 0).u8().u64()
    second: u64 = string_view_index(view, 1).u8().u64()
    after_first: u64 = (SVIEW_FNV1A_OFFSET_BASIS ^ first) * SVIEW_FNV1A_PRIME
    expected: u64 = (after_first ^ second) * SVIEW_FNV1A_PRIME
    return hash_sview(view) == expected
