# The next power-of-two threshold after the 1,025th insertion.
def name_set_capacity_four_thousand_ninety_six_covers_next_one_thousand_twenty_four_insertions(name_count: usize) -> bool:
    requires name_count >= 1024 and name_count <= 2047
    ensure result == true
    return 4096 >= (name_count + 1) * 2

def name_set_two_thousand_forty_ninth_entry_doubles_capacity(name_count: usize) -> usize:
    requires name_count == 2048
    ensure result == 8192
    return 8192 if 4096 < (name_count + 1) * 2 else 4096

def two_thousand_forty_ninth_name_rehash_keeps_six_thousand_one_hundred_forty_three_slots_empty(name_count: usize) -> usize:
    requires name_count == 2048
    ensure result == 6143
    return (8192 if 4096 < (name_count + 1) * 2 else 4096) - (name_count + 1)
