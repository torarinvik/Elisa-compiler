# The parser's declaration tag selects the only collection its index may address.
include "../../src/backend/easm_model.elisa"
include "../../src/backend/easm_parse_state_policy.elisa"

def declaration_index_policy_matches_its_collection_domain(
    kind: Easm::EasmDeclarationKind,
    index: i64,
    function_count: usize,
    fragment_count: usize,
    protocol_count: usize,
    template_count: usize
) -> bool:
    ensure result == true
    valid: bool = Easm::easm_declaration_index_valid(kind, index, function_count, fragment_count, protocol_count, template_count)
    expected: bool = match kind:
        Easm::EasmDeclarationKind.Function -> index >= 0 and index.usize() < function_count
        Easm::EasmDeclarationKind.Fragment -> index >= 0 and index.usize() < fragment_count
        Easm::EasmDeclarationKind.Protocol -> index >= 0 and index.usize() < protocol_count
        Easm::EasmDeclarationKind.Template -> index >= 0 and index.usize() < template_count
        _ -> true
    return valid == expected

def first_and_last_function_slots_are_valid() -> bool:
    ensure result == true
    return Easm::easm_declaration_index_valid(Easm::EasmDeclarationKind.Function, 0, 1, 0, 0, 0)
        and Easm::easm_declaration_index_valid(Easm::EasmDeclarationKind.Function, 2, 3, 0, 0, 0)

def stale_none_and_layout_indices_are_ignored() -> bool:
    ensure result == true
    return Easm::easm_declaration_index_valid(Easm::EasmDeclarationKind.None, -9, 0, 0, 0, 0)
        and Easm::easm_declaration_index_valid(Easm::EasmDeclarationKind.Layout, 900, 0, 0, 0, 0)

def empty_collection_has_no_valid_declaration_slot(kind: Easm::EasmDeclarationKind) -> bool:
    requires kind == Easm::EasmDeclarationKind.Function
        or kind == Easm::EasmDeclarationKind.Fragment
        or kind == Easm::EasmDeclarationKind.Protocol
        or kind == Easm::EasmDeclarationKind.Template
    ensure result == true
    return not Easm::easm_declaration_index_valid(kind, 0, 0, 0, 0, 0)

def target_mode_requires_a_function_with_active_target(kind: Easm::EasmDeclarationKind, active_target: i64) -> bool:
    ensure result == true
    return Easm::easm_body_routing_valid(Easm::EasmBodyMode.Target, kind, active_target) implies (
        kind == Easm::EasmDeclarationKind.Function and active_target >= 0
    )

def reference_mode_requires_a_function_or_fragment(kind: Easm::EasmDeclarationKind) -> bool:
    ensure result == true
    return Easm::easm_body_routing_valid(Easm::EasmBodyMode.Reference, kind, -1)
        implies (kind == Easm::EasmDeclarationKind.Function or kind == Easm::EasmDeclarationKind.Fragment)

def empty_body_mode_allows_no_active_target(kind: Easm::EasmDeclarationKind) -> bool:
    ensure result == true
    return Easm::easm_body_routing_valid(Easm::EasmBodyMode.None, kind, -1)

def valid_source_spans_have_ordered_bounded_endpoints(start: usize, end: usize, source_length: usize, buffer_count: usize) -> bool:
    requires source_length <= buffer_count
    ensure result == true
    return Easm::easm_source_span_valid(start, end, source_length, buffer_count)
        implies (start <= end and end <= source_length and end <= buffer_count)

def empty_source_span_at_end_is_valid(source_length: usize) -> bool:
    ensure result == true
    return Easm::easm_source_span_valid(source_length, source_length, source_length, source_length)
