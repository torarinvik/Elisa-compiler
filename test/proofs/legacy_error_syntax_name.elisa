# Source-linked proof of the exact deprecated error-pattern marker mapping.
include "../../src/semantic/legacy_error_syntax_name.elisa"

def source_marker_map_matches_spec(marker: sview) -> bool:
    ensure result == (
        when marker:
            "__legacy_error_wildcard" -> "wildcard"
            "__legacy_error_pipe" -> "pipe"
            "__legacy_error_open" -> "open"
            _ -> ""
    )
    return LegacyErrorSyntaxName::diagnostic_name(marker)

def every_legacy_pattern_gets_its_diagnostic_name() -> bool:
    ensure result == true
    return (
        LegacyErrorSyntaxName::diagnostic_name("__legacy_error_wildcard") == "wildcard"
        and LegacyErrorSyntaxName::diagnostic_name("__legacy_error_pipe") == "pipe"
        and LegacyErrorSyntaxName::diagnostic_name("__legacy_error_open") == "open"
    )

def unrelated_markers_have_no_legacy_diagnostic_name() -> bool:
    ensure result == true
    return (
        LegacyErrorSyntaxName::diagnostic_name("") == ""
        and LegacyErrorSyntaxName::diagnostic_name("__legacy_error_other") == ""
        and LegacyErrorSyntaxName::diagnostic_name("wildcard") == ""
    )
