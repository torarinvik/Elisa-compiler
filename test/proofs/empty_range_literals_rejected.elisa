include "./empty_range_literals.elisa"

def false_lt_nonempty_is_empty(a: i64, b: i64) -> bool:
    requires a < b
    ensure result == true
    return proof_empty_lt(a, b)

def false_le_equality_is_empty(a: i64, b: i64) -> bool:
    requires a == b
    ensure result == true
    return proof_empty_le(a, b)

def false_gt_reverse_is_empty(a: i64, b: i64) -> bool:
    requires a > b
    ensure result == true
    return proof_empty_gt(a, b)
