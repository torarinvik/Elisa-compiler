# Source-linked proof of stage1's pure observation-to-option policy.
include "../../src/lexer/tokens.elisa"
include "../../src/lexer/source_view.elisa"
include "../../src/driver/stage1_semantic_option_projection.elisa"

def stage1_projection_preserves_each_observation_and_default(
    strict_header: bool,
    runtime_std_detected: bool,
    smt_environment_enabled: bool,
    smt_header: bool,
    strict_externs_environment_enabled: bool,
    strict_externs_header: bool,
    unsafe_header: bool,
    proofhole_header: bool,
    globals_header: bool,
    permissive_environment_enabled: bool,
    carrier_surface_enabled: bool
) -> bool:
    ensure result == true
    options: Semantic::IncrementalSemanticOptions = stage1_semantic_options_from_observations(
        strict_header,
        runtime_std_detected,
        smt_environment_enabled,
        smt_header,
        strict_externs_environment_enabled,
        strict_externs_header,
        unsafe_header,
        proofhole_header,
        globals_header,
        permissive_environment_enabled,
        carrier_surface_enabled
    )
    return (
        options.enforce_unsafe_permissions == strict_header
        and options.flow_strict == false
        and options.runtime_std == runtime_std_detected
        and options.flow_warn == false
        and options.enable_smt == (smt_environment_enabled or smt_header)
        and options.warn_discarded == false
        and options.enforce_progress == false
        and options.enforce_extern_contracts == (strict_externs_environment_enabled or strict_externs_header)
        and options.enforce_raw_unsafe == unsafe_header
        and options.emit_proof_hole == proofhole_header
        and options.region_stack_cap == STAGE1_REGION_STACK_CAP
        and options.enforce_global_permissions == globals_header
        and options.enforce_mutable_global_grants == not permissive_environment_enabled
        and options.carrier_surface == carrier_surface_enabled
    )

def source_and_environment_switches_are_combined_exactly(
    smt_environment_enabled: bool,
    smt_header: bool,
    strict_externs_environment_enabled: bool,
    strict_externs_header: bool
) -> bool:
    ensure result == true
    options: Semantic::IncrementalSemanticOptions = stage1_semantic_options_from_observations(
        false,
        false,
        smt_environment_enabled,
        smt_header,
        strict_externs_environment_enabled,
        strict_externs_header,
        false,
        false,
        false,
        false,
        false
    )
    return (
        options.enable_smt == (smt_environment_enabled or smt_header)
        and options.enforce_extern_contracts == (strict_externs_environment_enabled or strict_externs_header)
    )
