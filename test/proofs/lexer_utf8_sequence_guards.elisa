# Source-linked contracts for every canonical UTF-8 acceptance arm in starts_valid_utf8_sequence.
# The companion checker derives each predicate from the exact production return guard.
include "../../src/lexer/lexer_utf8_codepoint_constants.elisa"

def proof_valid_two_byte_start(remaining: i64, first: i64, second: i64) -> bool:
    ensure result implies remaining > 1
    ensure result implies first >= UTF8_TWO_BYTE_LEAD_MIN and first <= UTF8_TWO_BYTE_LEAD_MAX
    ensure result implies second >= UTF8_CONTINUATION_MIN
    ensure result implies second <= UTF8_CONTINUATION_MAX
    ensure result == (remaining > 1 and (second >= UTF8_CONTINUATION_MIN and second <= UTF8_CONTINUATION_MAX) and (first >= UTF8_TWO_BYTE_LEAD_MIN and first <= UTF8_TWO_BYTE_LEAD_MAX))
    return remaining > 1 and (second >= UTF8_CONTINUATION_MIN and second <= UTF8_CONTINUATION_MAX) and (first >= UTF8_TWO_BYTE_LEAD_MIN and first <= UTF8_TWO_BYTE_LEAD_MAX)

def proof_valid_three_byte_e0_start(remaining: i64, first: i64, second: i64, third: i64) -> bool:
    ensure result implies remaining > 2
    ensure result implies first == UTF8_THREE_BYTE_LEAD_MIN
    ensure result implies second >= UTF8_E0_SECOND_MIN
    ensure result implies second <= UTF8_CONTINUATION_MAX
    ensure result implies third >= UTF8_CONTINUATION_MIN
    ensure result implies third <= UTF8_CONTINUATION_MAX
    ensure result == (remaining > 2 and second >= UTF8_E0_SECOND_MIN and second <= UTF8_CONTINUATION_MAX and (third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX) and (first == UTF8_THREE_BYTE_LEAD_MIN))
    return remaining > 2 and second >= UTF8_E0_SECOND_MIN and second <= UTF8_CONTINUATION_MAX and (third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX) and (first == UTF8_THREE_BYTE_LEAD_MIN)

def proof_valid_three_byte_middle_start(remaining: i64, first: i64, second: i64, third: i64) -> bool:
    ensure result implies remaining > 2
    ensure result implies (first > UTF8_THREE_BYTE_LEAD_MIN and first < UTF8_SURROGATE_LEAD) or (first > UTF8_SURROGATE_LEAD and first <= UTF8_THREE_BYTE_LEAD_MAX)
    ensure result implies second >= UTF8_CONTINUATION_MIN and second <= UTF8_CONTINUATION_MAX
    ensure result implies third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX
    ensure result == (remaining > 2 and (second >= UTF8_CONTINUATION_MIN and second <= UTF8_CONTINUATION_MAX) and (third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX) and ((first > UTF8_THREE_BYTE_LEAD_MIN and first < UTF8_SURROGATE_LEAD) or (first > UTF8_SURROGATE_LEAD and first <= UTF8_THREE_BYTE_LEAD_MAX)))
    return remaining > 2 and (second >= UTF8_CONTINUATION_MIN and second <= UTF8_CONTINUATION_MAX) and (third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX) and ((first > UTF8_THREE_BYTE_LEAD_MIN and first < UTF8_SURROGATE_LEAD) or (first > UTF8_SURROGATE_LEAD and first <= UTF8_THREE_BYTE_LEAD_MAX))

def proof_valid_three_byte_ed_start(remaining: i64, first: i64, second: i64, third: i64) -> bool:
    ensure result implies remaining > 2
    ensure result implies first == UTF8_SURROGATE_LEAD
    ensure result implies second >= UTF8_CONTINUATION_MIN
    ensure result implies second <= UTF8_ED_SECOND_MAX
    ensure result implies third >= UTF8_CONTINUATION_MIN
    ensure result implies third <= UTF8_CONTINUATION_MAX
    ensure result == (remaining > 2 and second >= UTF8_CONTINUATION_MIN and second <= UTF8_ED_SECOND_MAX and (third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX) and (first == UTF8_SURROGATE_LEAD))
    return remaining > 2 and second >= UTF8_CONTINUATION_MIN and second <= UTF8_ED_SECOND_MAX and (third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX) and (first == UTF8_SURROGATE_LEAD)

def proof_valid_four_byte_f0_start(remaining: i64, first: i64, second: i64, third: i64, fourth: i64) -> bool:
    ensure result implies remaining > 3
    ensure result implies first == UTF8_FOUR_BYTE_LEAD_MIN
    ensure result implies second >= UTF8_F0_SECOND_MIN
    ensure result implies second <= UTF8_CONTINUATION_MAX
    ensure result implies third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX
    ensure result implies fourth >= UTF8_CONTINUATION_MIN and fourth <= UTF8_CONTINUATION_MAX
    ensure result == (remaining > 3 and second >= UTF8_F0_SECOND_MIN and second <= UTF8_CONTINUATION_MAX and (third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX) and (fourth >= UTF8_CONTINUATION_MIN and fourth <= UTF8_CONTINUATION_MAX) and (first == UTF8_FOUR_BYTE_LEAD_MIN))
    return remaining > 3 and second >= UTF8_F0_SECOND_MIN and second <= UTF8_CONTINUATION_MAX and (third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX) and (fourth >= UTF8_CONTINUATION_MIN and fourth <= UTF8_CONTINUATION_MAX) and (first == UTF8_FOUR_BYTE_LEAD_MIN)

def proof_valid_four_byte_middle_start(remaining: i64, first: i64, second: i64, third: i64, fourth: i64) -> bool:
    ensure result implies remaining > 3
    ensure result implies first > UTF8_FOUR_BYTE_LEAD_MIN and first < UTF8_FOUR_BYTE_LEAD_MAX
    ensure result implies second >= UTF8_CONTINUATION_MIN and second <= UTF8_CONTINUATION_MAX
    ensure result implies third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX
    ensure result implies fourth >= UTF8_CONTINUATION_MIN and fourth <= UTF8_CONTINUATION_MAX
    ensure result == (remaining > 3 and (second >= UTF8_CONTINUATION_MIN and second <= UTF8_CONTINUATION_MAX) and (third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX) and (fourth >= UTF8_CONTINUATION_MIN and fourth <= UTF8_CONTINUATION_MAX) and (first > UTF8_FOUR_BYTE_LEAD_MIN and first < UTF8_FOUR_BYTE_LEAD_MAX))
    return remaining > 3 and (second >= UTF8_CONTINUATION_MIN and second <= UTF8_CONTINUATION_MAX) and (third >= UTF8_CONTINUATION_MIN and third <= UTF8_CONTINUATION_MAX) and (fourth >= UTF8_CONTINUATION_MIN and fourth <= UTF8_CONTINUATION_MAX) and (first > UTF8_FOUR_BYTE_LEAD_MIN and first < UTF8_FOUR_BYTE_LEAD_MAX)
