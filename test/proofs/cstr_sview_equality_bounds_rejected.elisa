# C-string/StringView comparison must reject false malformed/length claims.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"

def a_malformed_view_can_match_a_cstr(text: cstr, expected_length: i64, view: sview) -> bool:
    requires expected_length == text.len and (view.len < 0 or view.len.usize().i64() != view.len)
    ensure result == true
    return ctx_cstr_eq_sview(text, expected_length, view)

def unequal_lengths_can_match(text: cstr, expected_length: i64, view: sview) -> bool:
    requires expected_length == text.len and expected_length != view.len
    ensure result == true
    return ctx_cstr_eq_sview(text, expected_length, view)
