# C-string/StringView comparison must reject false malformed/length claims.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"

def a_malformed_view_can_match_a_cstr(text: cstr, view: sview) -> bool:
    requires view.len < 0 or view.len.usize().i64() != view.len
    ensure result == true
    return ctx_cstr_eq_sview(text, view)

def unequal_lengths_can_match(text: cstr, view: sview) -> bool:
    requires text.len != view.len
    ensure result == true
    return ctx_cstr_eq_sview(text, view)
