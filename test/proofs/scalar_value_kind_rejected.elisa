include "./scalar_value_kind.elisa"

def an_integer_type_is_a_scalar_value_kind() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return ScalarValueKind::is_scalar_value_kind("i64")

def a_container_is_a_scalar_value_kind() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return ScalarValueKind::is_scalar_value_kind("darray")
