# Source-linked proof of declaration shapes the frontend IR writer must refuse.
include "../../src/driver/frontend_ir_decl_policy.elisa"

enum FrontendIrDeclConstructor:
    Invalid
    Func
    Struct
    Enum
    Alias
    Law
    Import
    Scoped
    Extern
    Const
    Module

enum FrontendIrDeclRoute:
    ConditionalRefusal
    DirectEncoding
    DelegatedEncoding
    UnconditionalRefusal
    FallbackRefusal

def declaration_constructor_route(kind: FrontendIrDeclConstructor) -> FrontendIrDeclRoute:
    ensure kind != FrontendIrDeclConstructor.Invalid or result == FrontendIrDeclRoute.FallbackRefusal
    ensure kind != FrontendIrDeclConstructor.Func or result == FrontendIrDeclRoute.ConditionalRefusal
    ensure kind != FrontendIrDeclConstructor.Struct or result == FrontendIrDeclRoute.ConditionalRefusal
    ensure kind != FrontendIrDeclConstructor.Enum or result == FrontendIrDeclRoute.DirectEncoding
    ensure kind != FrontendIrDeclConstructor.Alias or result == FrontendIrDeclRoute.DirectEncoding
    ensure kind != FrontendIrDeclConstructor.Law or result == FrontendIrDeclRoute.FallbackRefusal
    ensure kind != FrontendIrDeclConstructor.Import or result == FrontendIrDeclRoute.DirectEncoding
    ensure kind != FrontendIrDeclConstructor.Scoped or result == FrontendIrDeclRoute.UnconditionalRefusal
    ensure kind != FrontendIrDeclConstructor.Extern or result == FrontendIrDeclRoute.DelegatedEncoding
    ensure kind != FrontendIrDeclConstructor.Const or result == FrontendIrDeclRoute.DirectEncoding
    ensure kind != FrontendIrDeclConstructor.Module or result == FrontendIrDeclRoute.DirectEncoding
    return match kind:
        FrontendIrDeclConstructor.Invalid: FrontendIrDeclRoute.FallbackRefusal
        FrontendIrDeclConstructor.Func: FrontendIrDeclRoute.ConditionalRefusal
        FrontendIrDeclConstructor.Struct: FrontendIrDeclRoute.ConditionalRefusal
        FrontendIrDeclConstructor.Enum: FrontendIrDeclRoute.DirectEncoding
        FrontendIrDeclConstructor.Alias: FrontendIrDeclRoute.DirectEncoding
        FrontendIrDeclConstructor.Law: FrontendIrDeclRoute.FallbackRefusal
        FrontendIrDeclConstructor.Import: FrontendIrDeclRoute.DirectEncoding
        FrontendIrDeclConstructor.Scoped: FrontendIrDeclRoute.UnconditionalRefusal
        FrontendIrDeclConstructor.Extern: FrontendIrDeclRoute.DelegatedEncoding
        FrontendIrDeclConstructor.Const: FrontendIrDeclRoute.DirectEncoding
        FrontendIrDeclConstructor.Module: FrontendIrDeclRoute.DirectEncoding

def regionless_function_body_is_refused(needs_stage0_auto_region: bool) -> bool:
    requires needs_stage0_auto_region
    ensure result == true
    return FrontendIrDeclPolicy::function_requires_refusal(needs_stage0_auto_region)

def ordinary_function_body_is_not_refused(needs_stage0_auto_region: bool) -> bool:
    requires not needs_stage0_auto_region
    ensure result == false
    return FrontendIrDeclPolicy::function_requires_refusal(needs_stage0_auto_region)

def typestate_struct_is_refused(has_named_states: bool, has_derive: bool) -> bool:
    requires has_named_states or has_derive
    ensure result == true
    return FrontendIrDeclPolicy::struct_requires_refusal(has_named_states, has_derive)

def ordinary_struct_is_not_refused(has_named_states: bool, has_derive: bool) -> bool:
    requires not has_named_states and not has_derive
    ensure result == false
    return FrontendIrDeclPolicy::struct_requires_refusal(has_named_states, has_derive)

def scoped_declaration_is_always_refused() -> bool:
    ensure result == true
    return FrontendIrDeclPolicy::scoped_declaration_requires_refusal()
