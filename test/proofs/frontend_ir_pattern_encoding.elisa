# The frontend IR pattern writer uses these stage0 schema IDs directly.
include "../../src/driver/frontend_ir_pattern_encoding.elisa"

def pattern_node_type_ids_match_schema() -> bool:
    ensure result == true
    return (
        FrontendIrPatternEncoding::WILDCARD_PATTERN_NODE_TYPE_ID == 184
        and FrontendIrPatternEncoding::BINDING_PATTERN_NODE_TYPE_ID == 171
        and FrontendIrPatternEncoding::LITERAL_PATTERN_NODE_TYPE_ID == 174
        and FrontendIrPatternEncoding::STRING_LITERAL_PATTERN_NODE_TYPE_ID == 180
        and FrontendIrPatternEncoding::VARIANT_PATTERN_NODE_TYPE_ID == 183
        and FrontendIrPatternEncoding::STRUCT_PATTERN_NODE_TYPE_ID == 181
        and FrontendIrPatternEncoding::TUPLE_PATTERN_NODE_TYPE_ID == 182
        and FrontendIrPatternEncoding::BOOL_LITERAL_NODE_TYPE_ID == 18
        and FrontendIrPatternEncoding::CHAR_LITERAL_NODE_TYPE_ID == 28
        and FrontendIrPatternEncoding::INT_LITERAL_NODE_TYPE_ID == 139
        and FrontendIrPatternEncoding::PATTERN_ARG_NODE_TYPE_ID == 176
        and FrontendIrPatternEncoding::MATCH_ARM_NODE_TYPE_ID == 170
    )

def pattern_field_ids_match_schema() -> bool:
    ensure result == true
    return (
        FrontendIrPatternEncoding::BINDING_PATTERN_NAME_FIELD_ID == 2
        and FrontendIrPatternEncoding::LITERAL_PATTERN_VALUE_FIELD_ID == 3
        and FrontendIrPatternEncoding::STRING_LITERAL_PATTERN_VALUE_FIELD_ID == 2
        and FrontendIrPatternEncoding::VARIANT_PATTERN_ARGS_FIELD_ID == 1
        and FrontendIrPatternEncoding::VARIANT_PATTERN_ENUM_NAME_FIELD_ID == 3
        and FrontendIrPatternEncoding::VARIANT_PATTERN_VARIANT_FIELD_ID == 7
        and FrontendIrPatternEncoding::STRUCT_PATTERN_ARGS_FIELD_ID == 1
        and FrontendIrPatternEncoding::STRUCT_PATTERN_BRACE_FIELD_ID == 3
        and FrontendIrPatternEncoding::STRUCT_PATTERN_TYPE_NAME_FIELD_ID == 7
        and FrontendIrPatternEncoding::TUPLE_PATTERN_ELEMENTS_FIELD_ID == 1
        and FrontendIrPatternEncoding::BOOL_LITERAL_VALUE_FIELD_ID == 2
        and FrontendIrPatternEncoding::CHAR_LITERAL_VALUE_FIELD_ID == 2
        and FrontendIrPatternEncoding::INT_LITERAL_VALUE_FIELD_ID == 4
        and FrontendIrPatternEncoding::PATTERN_ARG_NAME_FIELD_ID == 1
        and FrontendIrPatternEncoding::PATTERN_ARG_PATTERN_FIELD_ID == 2
        and FrontendIrPatternEncoding::MATCH_ARM_BODY_FIELD_ID == 1
        and FrontendIrPatternEncoding::MATCH_ARM_GUARD_FIELD_ID == 2
        and FrontendIrPatternEncoding::MATCH_ARM_PATTERN_FIELD_ID == 3
    )

def pattern_layout_field_ids_are_pairwise_distinct() -> bool:
    ensure result == true
    return (
        FrontendIrPatternEncoding::VARIANT_PATTERN_ARGS_FIELD_ID != FrontendIrPatternEncoding::VARIANT_PATTERN_ENUM_NAME_FIELD_ID
        and FrontendIrPatternEncoding::VARIANT_PATTERN_ARGS_FIELD_ID != FrontendIrPatternEncoding::VARIANT_PATTERN_VARIANT_FIELD_ID
        and FrontendIrPatternEncoding::VARIANT_PATTERN_ENUM_NAME_FIELD_ID != FrontendIrPatternEncoding::VARIANT_PATTERN_VARIANT_FIELD_ID
        and FrontendIrPatternEncoding::STRUCT_PATTERN_ARGS_FIELD_ID != FrontendIrPatternEncoding::STRUCT_PATTERN_BRACE_FIELD_ID
        and FrontendIrPatternEncoding::STRUCT_PATTERN_ARGS_FIELD_ID != FrontendIrPatternEncoding::STRUCT_PATTERN_TYPE_NAME_FIELD_ID
        and FrontendIrPatternEncoding::STRUCT_PATTERN_BRACE_FIELD_ID != FrontendIrPatternEncoding::STRUCT_PATTERN_TYPE_NAME_FIELD_ID
        and FrontendIrPatternEncoding::PATTERN_ARG_NAME_FIELD_ID != FrontendIrPatternEncoding::PATTERN_ARG_PATTERN_FIELD_ID
        and FrontendIrPatternEncoding::MATCH_ARM_BODY_FIELD_ID != FrontendIrPatternEncoding::MATCH_ARM_GUARD_FIELD_ID
        and FrontendIrPatternEncoding::MATCH_ARM_BODY_FIELD_ID != FrontendIrPatternEncoding::MATCH_ARM_PATTERN_FIELD_ID
        and FrontendIrPatternEncoding::MATCH_ARM_GUARD_FIELD_ID != FrontendIrPatternEncoding::MATCH_ARM_PATTERN_FIELD_ID
    )

def pattern_text_discriminators_match_ascii() -> bool:
    ensure result == true
    return (
        FrontendIrPatternEncoding::QUALIFIED_PATTERN_PATH_SEPARATOR_BYTE == 46
        and FrontendIrPatternEncoding::STRING_PATTERN_QUOTE_BYTE == 34
        and FrontendIrPatternEncoding::CHAR_PATTERN_QUOTE_BYTE == 39
        and FrontendIrPatternEncoding::ASCII_DIGIT_ZERO_BYTE == 48
        and FrontendIrPatternEncoding::ASCII_DIGIT_NINE_BYTE == 57
    )
