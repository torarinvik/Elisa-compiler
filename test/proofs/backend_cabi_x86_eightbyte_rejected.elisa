include "./backend_cabi_x86_eightbyte.elisa"

def false_integer_loses_to_double(integer_leaves: i64, float64_leaves: i64) -> i64:
    requires integer_leaves == 1 and float64_leaves == 1
    ensure result == 2
    return integer_leaves

def false_double_loses_to_float_vector(float32_leaves: i64, float64_leaves: i64) -> i64:
    requires float32_leaves == 2 and float64_leaves == 1
    ensure result == 3
    return float32_leaves

def false_two_float32_leaves_are_scalar(integer_leaves: i64, float32_leaves: i64, float64_leaves: i64) -> i64:
    requires integer_leaves == 0 and float64_leaves == 0 and float32_leaves == 2
    ensure result == 4
    return float32_leaves
