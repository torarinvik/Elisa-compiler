# Boolean specification of the exact source shape rejected by the char-classifier guard.
# The admission checker pins each input predicate to its production AST walk.
module CharClassifierGuardSpecification:
    public:
        def should_report(exactly_one_parameter: bool, parameter_is_char: bool,
            return_type_is_closed_const_enum: bool, body_is_single_return_match: bool,
            match_scrutinee_is_parameter: bool, has_guarded_arm: bool) -> bool:
            ensure result == (exactly_one_parameter and parameter_is_char and
                return_type_is_closed_const_enum and body_is_single_return_match and
                match_scrutinee_is_parameter and has_guarded_arm)
            return exactly_one_parameter and parameter_is_char and
                return_type_is_closed_const_enum and body_is_single_return_match and
                match_scrutinee_is_parameter and has_guarded_arm

def exact_guarded_char_classifier_is_rejected() -> bool:
    ensure result == true
    return CharClassifierGuardSpecification::should_report(true, true, true, true, true, true)

def every_source_shape_requirement_is_part_of_the_guard(parameter_count_ok: bool,
    char_type_ok: bool, closed_enum_ok: bool, single_match_body_ok: bool,
    matching_scrutinee_ok: bool, guarded_arm_ok: bool) -> bool:
    ensure result == true
    return CharClassifierGuardSpecification::should_report(parameter_count_ok, char_type_ok,
        closed_enum_ok, single_match_body_ok, matching_scrutinee_ok, guarded_arm_ok) ==
        (parameter_count_ok and char_type_ok and closed_enum_ok and single_match_body_ok and
            matching_scrutinee_ok and guarded_arm_ok)

def each_failed_shape_suppresses_the_diagnostic() -> bool:
    ensure result == true
    return (
        not CharClassifierGuardSpecification::should_report(false, true, true, true, true, true)
        and not CharClassifierGuardSpecification::should_report(true, false, true, true, true, true)
        and not CharClassifierGuardSpecification::should_report(true, true, false, true, true, true)
        and not CharClassifierGuardSpecification::should_report(true, true, true, false, true, true)
        and not CharClassifierGuardSpecification::should_report(true, true, true, true, false, true)
        and not CharClassifierGuardSpecification::should_report(true, true, true, true, true, false)
    )
