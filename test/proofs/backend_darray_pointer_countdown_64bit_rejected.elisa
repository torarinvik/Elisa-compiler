include "./backend_darray_pointer_countdown_64bit.elisa"

def false_zero_remaining_decrements_to_positive_u64() -> bool:
    ensure result == true
    return 0.u64() - 1.u64() > 0.u64()

def false_cursor_at_end_is_inside_snapshot_u64(count: u64) -> bool:
    requires count > 0
    ensure result == true
    return count < count
