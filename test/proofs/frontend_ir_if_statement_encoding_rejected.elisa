# False schema claims for the statement-form IfStmt encoding.
include "../../src/driver/frontend_ir_if_statement_encoding.elisa"

def if_statement_cannot_use_its_stage0_node_tag() -> bool:
    ensure result == true
    return FrontendIrIfStatementEncoding::node_type_id() == 276

def condition_and_else_cannot_use_distinct_fields() -> bool:
    ensure result == true
    return (
        FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.Condition)
        == FrontendIrIfStatementEncoding::field_id(FrontendIrIfStatementEncoding::IfStmtField.ElseBody)
    )
