# Prove the C ABI pointer count selected for exported function parameters.
include "../../src/backend/c_header_parameter_pointer.elisa"
include "../../src/backend/c_header_prototype_marker.elisa"
include "../../src/backend/c_header_return_pointer.elisa"

def provenance_parameter_always_uses_one_pointer(depth: i64) -> bool:
    ensure result == true
    return CHeaderParameterPointer::star_count(true, depth) == 1

def value_parameter_preserves_resolved_type_depth(depth: i64) -> bool:
    ensure result == true
    return CHeaderParameterPointer::star_count(false, depth) == depth

def value_parameter_with_no_pointer_depth_stays_by_value() -> bool:
    ensure result == true
    return CHeaderParameterPointer::star_count(false, 0) == 0

def provenance_parameter_ignores_even_nested_source_depth() -> bool:
    ensure result == true
    return CHeaderParameterPointer::star_count(true, 3) == 1

def selected_pointer_count_matches_the_exact_abi_rule(provenance_bearing: bool, depth: i64) -> bool:
    ensure result == true
    return CHeaderParameterPointer::star_count(provenance_bearing, depth) == (1 if provenance_bearing else depth)

def zero_arity_requires_the_c_void_marker() -> bool:
    ensure result == true
    return CHeaderPrototypeMarker::needs_void_parameter_marker(0) == true

def nonzero_arity_omits_the_c_void_marker(arity: usize) -> bool:
    requires arity > 0
    ensure result == true
    return not CHeaderPrototypeMarker::needs_void_parameter_marker(arity)

def void_marker_predicate_matches_exact_zero_arity(arity: usize) -> bool:
    ensure result == true
    return CHeaderPrototypeMarker::needs_void_parameter_marker(arity) == (arity == 0)

def return_pointer_marker_matches_exact_owner_and_function(annotation_owner: sview, annotation_name: sview, function_name: sview) -> bool:
    ensure result == true
    return CHeaderReturnPointer::matches_marker(annotation_owner, annotation_name, function_name) == (annotation_owner == "__extern_return_ptr" and annotation_name == function_name)

def exact_return_pointer_marker_is_recognized(function_name: sview) -> bool:
    ensure result == true
    return CHeaderReturnPointer::matches_marker("__extern_return_ptr", function_name, function_name)

def different_return_pointer_annotation_owner_is_ignored(annotation_owner: sview, annotation_name: sview, function_name: sview) -> bool:
    requires annotation_owner != "__extern_return_ptr"
    ensure result == true
    return not CHeaderReturnPointer::matches_marker(annotation_owner, annotation_name, function_name)

def return_pointer_marker_for_another_function_is_ignored(annotation_name: sview, function_name: sview) -> bool:
    requires annotation_name != function_name
    ensure result == true
    return not CHeaderReturnPointer::matches_marker("__extern_return_ptr", annotation_name, function_name)
