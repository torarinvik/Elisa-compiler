# Prove the production wildcard matcher used to propagate borrow ownership through fields.
include "../../src/semantic/borrow_field_path_policy.elisa"

def wildcard_matches_its_exact_byte_path_spec(candidate: sview, field: sview, prefix_end: usize) -> bool:
    ensure result == true
    can Abort.Panic:
        return SemanticBorrowFieldPath::wildcard_matches(candidate, field, prefix_end) == (
            sview_len(candidate) > prefix_end and
            sview_len(candidate) - prefix_end == SemanticBorrowFieldPath::WILDCARD_SUFFIX_LENGTH and
            prefix_end < sview_len(field) and
            sview_at(field, prefix_end) == SemanticBorrowFieldPath::ASCII_FIELD_SEPARATOR and
            sview_at(candidate, prefix_end) == SemanticBorrowFieldPath::ASCII_FIELD_SEPARATOR and
            sview_at(candidate, sview_len(candidate) - SemanticBorrowFieldPath::INDEX_STEP) == SemanticBorrowFieldPath::ASCII_WILDCARD and
            (forall prefix_index in 0..<prefix_end:
                sview_at(candidate, prefix_index) == sview_at(field, prefix_index))
        )

def root_field_wildcard_matches_descendant() -> bool:
    ensure result == true
    can Abort.Panic:
        return SemanticBorrowFieldPath::wildcard_matches("a.*", "a.member", 1.usize())

def nested_field_wildcard_matches_descendant() -> bool:
    ensure result == true
    can Abort.Panic:
        return SemanticBorrowFieldPath::wildcard_matches("root.child.*", "root.child.leaf", 10.usize())

def field_path_prefix_must_match_exactly() -> bool:
    ensure result == false
    can Abort.Panic:
        return SemanticBorrowFieldPath::wildcard_matches("root.child.*", "root.other.leaf", 10.usize())

def wildcard_suffix_requires_dot_then_star() -> bool:
    ensure result == false
    can Abort.Panic:
        return SemanticBorrowFieldPath::wildcard_matches("a.x", "a.child", 1.usize())

def wildcard_suffix_must_end_at_candidate_boundary() -> bool:
    ensure result == false
    can Abort.Panic:
        return SemanticBorrowFieldPath::wildcard_matches("a.**", "a.child", 1.usize())

def prefix_end_must_be_inside_the_field() -> bool:
    ensure result == false
    can Abort.Panic:
        return SemanticBorrowFieldPath::wildcard_matches("a.*", "a", 1.usize())
