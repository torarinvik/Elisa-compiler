# Deliberately false controls for the sealed family set and declaration marker.
include "../../src/semantic/permission_reserved_names.elisa"

def io_is_a_sealed_alias_family() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return PermissionReservedNames::is_sealed_alias_family("IO")

def global_is_not_sealed_for_aliases() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return not PermissionReservedNames::is_sealed_alias_family("Global")

def an_alias_marker_reserves_the_top_permission() -> bool can[Abort.Panic]:
    ensure result == true
    can Abort.Panic:
        return PermissionReservedNames::is_reserved_top_permission_declaration("__permission_alias", "any")
