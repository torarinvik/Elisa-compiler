# A darray indexed by an ELEMENT OF ANOTHER darray, then a field projected off the
# result -- `box.rows[heads[row]].field`, read through an `lmut` receiver with by-VALUE
# darray parameters, hoisted above a loop that mutates the receiver.
#
# Kept as coverage for the shape. It was written while chasing a wrong line number in the
# `when`-arm refusals, which looked like this read returning the neighbouring element; the
# real cause was that token lines are BUFFER lines and the interpolated number was printed
# without the buffer-to-source mapping. Both compilers have always answered this correctly.
struct Row:
	line: u32

struct Box:
	rows: darray[Row]
	seen: mutable darray[u32]

# Mirrors check_when_overlap_row: an `lmut` receiver, by-VALUE darray parameters, the
# element read hoisted before a loop that mutates the receiver.
def scan(box: lmut Box, heads: darray[usize], row: usize) -> void:
	can Memory.Allocate, Abort.Panic:
		row_head: Row = box.rows[heads[row]]
		row_line: u32 = row_head.line
		for index in (row + 1)..<heads.count |box|:
			box.seen <- box.seen.push(row_line)

def main() -> i64:
	can Memory.Allocate, Abort.Panic:
		box: mutable Box = Box{rows: [Row{line: 10}, Row{line: 20}, Row{line: 30}, Row{line: 40}], seen: []}
		heads: darray[usize] = [0, 1, 2, 3]
		box <- box.scan(heads, 0)
		1 return if box.seen.count != 3
		2 return if box.seen[0] != 10
		3 return if box.seen[1] != 10
		4 return if box.seen[2] != 10
		return 0
