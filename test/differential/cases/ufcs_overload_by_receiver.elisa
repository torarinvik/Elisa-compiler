# A UFCS call over same-named, same-arity overloads picks by RECEIVER TYPE.
#
# `c.area()` against `impl Shape for Circle` and `impl Shape for Square` --
# both declare a one-parameter `area` -- resolved in stage1 by ARITY alone, so
# every receiver dispatched to whichever impl was declared first. Only the
# protocol-through-bound-type path (`P.area()` inside `def f[P: Shape]`) was
# typed. The value-receiver spelling now resolves over the full argument list,
# receiver first. The module-nested impl is here because that is how it was
# found; the bug never depended on it.
protocol Shape:
    def area(self: Self) -> f32

struct Circle:
    r: f32

impl Shape for Circle:
    def area(self: Circle) -> f32:
        return 3.0 * self.r * self.r

module Geometry:
    public:
        struct Square:
            side: f32

        impl Shape for Square:
            def area(self: Self) -> f32:
                return self.side * self.side

struct Triangle:
    base: f32
    height: f32

impl Shape for Triangle:
    def area(self: Triangle) -> f32:
        return 0.5 * self.base * self.height

def main() -> i64:
    c: Circle = Circle{r: 2.0}
    return 1 if c.area() != 12.0
    s: Geometry::Square = Geometry::Square{side: 3.0}
    return 2 if s.area() != 9.0
    t: Triangle = Triangle{base: 4.0, height: 5.0}
    return 3 if t.area() != 10.0
    return 0
