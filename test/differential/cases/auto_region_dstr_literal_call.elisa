# A string literal passed to dstr adapts by allocating into the caller's inferred
# arena. The caller has no explicit region, so demand analysis must create a local
# carrier before the contextual dstr conversion is emitted.
def byte_count(value: dstr) -> usize:
    return value.count

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return 1 if byte_count("text") != 4
    return 0
