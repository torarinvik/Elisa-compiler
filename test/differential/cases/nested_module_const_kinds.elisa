# Consts reached through a nested module path in the three places the self-host needed
# them: a `sview` const in a comparison (self-hosting the EDIR producer's MAIN_NAME),
# a const INITIALIZER that reads `A::B::C`, and a fixed-array EXTENT `u8[A::B::N]`.
# Exit 0 on both compilers.
module E:
    public:
        module Function:
            public:
                const MAIN_NAME: sview = "main"
        module Integer:
            public:
                const I64_MAX: i64 = 9223372036854775807
        module Loop:
            public:
                const TOTAL_MAX: i64 = E::Integer::I64_MAX / 4
        module Path:
            public:
                const CAPACITY: usize = 8

struct Ident:
    path_bytes: mutable u8[E::Path::CAPACITY]

def check(name: sview) -> i64:
    return 1 if name != E::Function::MAIN_NAME
    return 0

def main() -> i64:
    s: mutable Ident = zeroed
    s.path_bytes[1] <- 7
    return 2 if E::Loop::TOTAL_MAX <= 0
    return check("main") + s.path_bytes[1].i64() - 7
