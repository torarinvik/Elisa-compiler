# Binary searches whose midpoint bounds check is versioned on the search's
# upper end: with `end <= len` on entry the midpoint can never reach `len`,
# so the check leaves the common loop, and searches that start past the
# view's end must still reach the same results through the checked loop.
@inline(never)
def lower_bound(values: view[usize], begin_input: usize, end_input: usize, target: usize) -> usize:
    begin: mutable usize = begin_input
    end: mutable usize = end_input
    while begin < end:
        middle: usize = begin + (end - begin) / 2
        if values[middle] < target:
            begin <- middle + 1
        else:
            end <- middle
    begin

@inline(never)
def count_in_range(values: view[usize], begin: usize, end: usize, low: usize, high: usize) -> usize:
    lower_bound(values, begin, end, high) - lower_bound(values, begin, end, low)

def main() -> i32:
    sorted: mutable usize[16] = zeroed
    i: mutable usize = 0
    while i < 16:
        sorted[i] <- 3 * i + 1
        i <- i + 1
    return 10 if lower_bound(sorted[0:16], 0, 16, 0) != 0
    return 11 if lower_bound(sorted[0:16], 0, 16, 46) != 15
    return 12 if lower_bound(sorted[0:16], 0, 16, 47) != 16
    return 13 if lower_bound(sorted[0:16], 0, 16, 1000) != 16
    return 14 if lower_bound(sorted[0:16], 4, 9, 20) != 7
    return 15 if count_in_range(sorted[0:16], 0, 16, 10, 31) != 7
    return 16 if count_in_range(sorted[0:16], 3, 12, 0, 100) != 9
    # An upper end past the view: the search still finishes in bounds when
    # every midpoint it visits is below the length.
    return 17 if lower_bound(sorted[0:16], 0, 17, 0) != 0
    return 18 if lower_bound(sorted[0:16], 5, 5, 0) != 5
    0
