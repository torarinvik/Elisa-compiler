# `move` hands the obligation to the receiver, so exactly one drop must run: the
# caller suppresses its own, and the callee releases the parameter it received.
#
# XFAIL: stage1 registers drops for locals but not yet for by-value parameters,
# so the moved value is never released -- a leak, not a double free. Wiring the
# parameter site is a one-line change (codegen_declare.elisa, the parameter
# loop), but it makes stage0 and stage1 compile the compiler differently and
# breaks the gen3 byte-identical fixpoint, so the parity divergence has to be
# understood first. Promote out of .xfail once that is fixed.
global mutable log: i64 = 0

struct Tracked:
    mark: i64

def __drop__(self: Tracked) -> void:
    log <- log * 10 + self.mark

def consume(v: Tracked) -> i64:
    return v.mark

def moved_away() -> i64:
    t: Tracked = Tracked{mark: 5}
    return consume(move t)

def main() -> i64:
    n: i64 = moved_away()
    return 1 if n != 5
    # The obligation moved to the callee, so it must have released it exactly once.
    return 2 if log != 5
    return 0
