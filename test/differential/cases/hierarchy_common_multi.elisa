# Several `common:` fields on a sealed hierarchy, exercising both the multi-field
# prefix and non-i64 types. This also protects root propagation from iterating a
# mutable array while appending inherited common metadata.
enum Widget:
    common:
        x: f32
        y: f32
        width: f32
        height: f32
        grow: f32
    pass

enum Container is Widget:
    Box(axis: i32, first_child: Widget?, next_sibling: Widget?)

enum Control is Widget:
    Label(text: sview, next_sibling: Widget?)

enum Button is Control:
    Push(label: sview, next_sibling: Widget?)


def build() -> Widget:
    return Button.Push(x: 1.0, y: 2.0, width: 30.0, height: 10.0, grow: 1.0, label: "ok", next_sibling: null)

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        w: Widget = build()
        return 1 if w.x.i64() != 1
        return 2 if w.width.i64() != 30
        return 3 if w.grow.i64() != 1
        return 0
