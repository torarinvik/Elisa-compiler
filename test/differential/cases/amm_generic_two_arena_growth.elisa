# A generic growing TWO references needs one arena per reference, each the arena of the
# storage its argument names: `zs` is inner's local, `ys` is main's (forwarded through
# `inner`). `inner` itself must take main's arena for `ys` -- the region-forwarding pass
# could not see through the `fill2[i64]` callee, so `ys` grew in inner's auto region.
# Named arguments in swapped order must map to the same slots.
# 4 + 5 + 5 + 4 + 100 * 80 = 8018 = 82 mod 256.
def fill2[T](a: mutable darray[i64]&, b: mutable darray[i64]&, value: T, n: i64):
    for i in 0..<n:
        a.push(4)
        b.push(5)

def clobber() -> i64:
    junk: mutable darray[i64] = []
    for i in 0..<4096:
        junk.push(99)
    return junk.count.i64()

def inner(ys: mutable darray[i64]&) -> i64:
    zs: mutable darray[i64] = []
    fill2[i64](&zs, ys, 4, 40)
    return zs[3]

def inner_named(ys: mutable darray[i64]&) -> i64:
    zs: mutable darray[i64] = []
    fill2[i64](b: ys, a: &zs, value: 4, n: 40)
    return zs[3]

def main() -> i64:
    ys: mutable darray[i64] = []
    z: i64 = inner(&ys)
    zn: i64 = inner_named(&ys)
    k: i64 = clobber()
    return z + ys[3] + ys[50] + zn + 100 * ys.count.i64()
