# An opaque LLVM-C handle compared against `zeroed` is POINTER IDENTITY, never a content
# compare of whatever it points at.
#
# stage1 lowered `handle == zeroed` to `ctx_streq(handle, null)`: the untyped literal has
# no type of its own, so the both-sides pointer-like test failed, and the `cstr == cstr`
# branch under it accepted the handle's CStr kind without looking at the bits-1 opaque
# marker. The runtime call was emitted with only two argument registers set, so the answer
# depended on what was left in the others -- about one run in ten disagreed with the last.
#
# The compiler registers every struct with exactly this test
# (`handle <- LLVMStructCreateNamed(...) if handle == zeroed`), so a wrong answer left that
# struct's LLVM type null, which silently dropped the `sret` attribute from every function
# returning it. The result was a different but self-consistent ABI, and a gen3 fixpoint that
# failed about one run in ten. stage0 lowers the same source to `cmp x0, #0`.
extern LLVMTypeRef


# calloc gives a NON-null handle whose pointee is a zero byte -- i.e. the empty C string.
# A content compare answers "equal" for exactly that shape, which is the wrong answer for
# a handle that is plainly not null.
@link_name("calloc")
extern zeroed_handle(count: usize, size: usize) -> LLVMTypeRef


@link_name("free")
extern release_handle(handle: LLVMTypeRef) -> void


def main() -> i64:
    empty: LLVMTypeRef = zeroed
    return 1 if not (empty == zeroed)
    return 2 if empty != zeroed
    live: LLVMTypeRef = zeroed_handle(8, 1)
    return 3 if live == zeroed
    return 4 if not (live != zeroed)
    release_handle(live)
    return 0
