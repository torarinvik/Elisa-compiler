# A bounded view crossing to C (docs/127 §3.3). `strnlen(const char*, size_t)` is exactly a
# `view[u8]`: it sees the view's bytes and its bound. `scale_samples` pins the mutable form
# and a trailing scalar; `take_elisa` has no explicit C convention and keeps %DynArrayView.
# Exit 0 on both compilers.
@callconv(c)
extern strnlen(text: view[u8]) -> usize

@callconv(c)
extern scale_samples(samples: mutable view[f32], gain: f32) -> void

extern take_elisa(xs: view[f32]) -> usize

def main() -> i64:
    text: mutable darray[u8] = []
    text.push(104)
    text.push(105)
    text.push(10)
    text.push(0)
    bounded: usize = strnlen(text[0:2])
    unbounded: usize = strnlen(text[0:4])
    return bounded.i64() * 10 + unbounded.i64() - 23
