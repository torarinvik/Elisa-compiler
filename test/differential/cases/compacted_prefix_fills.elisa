# A zero-filled array written over its first `count` elements, sorted,
# compacted in place to its `distinct` values and then binary-searched over
# [0, distinct) reads only written elements: `distinct` starts at zero and
# rises by at most one per element, so it never passes `count`, and it is
# nonzero once the first element is kept, so the search's first midpoint is
# below it (ElisaIndexBounds' rising count and join ranges). The fill is
# dead. The negative searches one element past `distinct`, with no
# duplicates, for keys above every value: it reads the fill's zero there.
const CAPACITY: usize = 128

def lower_bound(sorted: view[i64], count: usize, x: i64) -> usize:
    low: mutable usize = 0
    high: mutable usize = count
    while low < high:
        middle: usize = low + (high - low) / 2
        if sorted[middle] < x:
            low <- middle + 1
        else:
            high <- middle
    low

# Ranks of the values among their distinct values, folded.
@inline(never)
def rank_fold(values: view[i64], count: usize, past: usize, shift: i64) -> i64:
    return -1 if count == 0 or count > CAPACITY or count > values.len
    sorted: mutable i64[128] = zeroed
    i: mutable usize = 0
    while i < count:
        sorted[i] <- values[i]
        i <- i + 1
    i <- 1
    while i < count:
        x: i64 = sorted[i]
        j: mutable usize = i
        while j != 0 and sorted[j - 1] > x:
            sorted[j] <- sorted[j - 1]
            j <- j - 1
        sorted[j] <- x
        i <- i + 1
    distinct: mutable usize = 0
    i <- 0
    while i < count:
        if distinct == 0 or sorted[i] != sorted[distinct - 1]:
            sorted[distinct] <- sorted[i]
            distinct <- distinct + 1
        i <- i + 1
    fold: mutable i64 = distinct.i64()
    i <- 0
    while i < count:
        fold <- (fold * 131 + lower_bound(sorted[0:CAPACITY], distinct + past, values[i] + shift).i64()) % 1000003
        i <- i + 1
    fold

def main() -> i32:
    values: mutable i64[96] = zeroed
    k: mutable usize = 0
    while k < 96:
        values[k] <- (k * k * 7 % 23).i64() + 1
        k <- k + 1
    count: mutable usize = 1
    while count <= 96:
        # Reference: a value's rank is the number of distinct smaller values.
        distinct: mutable i64 = 0
        a: mutable usize = 0
        while a < count:
            first: mutable bool = true
            b: mutable usize = 0
            while b < a:
                if values[b] == values[a]:
                    first <- false
                b <- b + 1
            if first:
                distinct <- distinct + 1
            a <- a + 1
        fold: mutable i64 = distinct
        i: mutable usize = 0
        while i < count:
            rank: mutable i64 = 0
            candidate: mutable i64 = 1
            while candidate < values[i]:
                seen: mutable bool = false
                b: mutable usize = 0
                while b < count:
                    if values[b] == candidate:
                        seen <- true
                    b <- b + 1
                if seen:
                    rank <- rank + 1
                candidate <- candidate + 1
            fold <- (fold * 131 + rank) % 1000003
            i <- i + 1
        return 10 if rank_fold(values[0:96], count, 0, 0) != fold
        count <- count + 5
    # 2, 5, 9 have no duplicates: the zero at element 3 is below every key
    # 1002, 1005, 1009, so each search lands past it, at 4.
    values[0] <- 2
    values[1] <- 5
    values[2] <- 9
    return 11 if rank_fold(values[0:3], 3, 1, 1000) != ((3 * 131 + 4) * 131 + 4) * 131 % 1000003 + 4
    0
