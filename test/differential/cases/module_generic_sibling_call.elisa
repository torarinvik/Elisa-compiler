# A generic declared INSIDE a module resolves its bare calls to that module's own
# members -- even when a top-level function of the same name is in scope.
#
# An instantiation's body is emitted from a pending queue, long after the walk
# that found the template, so the emission context no longer knows which module
# the template was written in. stage1 emitted every instantiation as if it were
# top-level, so `value_at(index)` below bound to the TOP-LEVEL `value_at` rather
# than `M::value_at`. Nothing failed to compile: the program built and returned
# the wrong numbers, which is how it was found -- a UI test recorded zeroes for
# every control kind because the recording backend's own helper had the same name
# as the module member the generic meant.
#
# The non-generic sibling call was always right (`sum_direct`), which is what made
# the generic path worth a case of its own.
permission Ui:
    Controls

module M:
    private:
        global mutable values: i32[4] = zeroed

    public:
        protocol Sink:
            def take(index: i32, v: i32) -> void can[Ui.Controls]

        def seed() -> void:
            values[0] <- 11
            values[1] <- 22

        def value_at(index: usize) -> i32:
            return values[index]

        # Not generic: this call was never mis-resolved.
        def sum_direct() -> i32:
            return value_at(0) + value_at(1)

        # Generic: the body is emitted from the queue, and this is the call that
        # bound to the wrong function.
        def drain[S: Sink]() -> void can[Ui.Controls]:
            for index in 0..<2:
                S.take(index.i32(), value_at(index))

using M

global mutable seen: i32[4] = zeroed

# The shadow: same name, same arity, top level.
def value_at(index: usize) -> i32:
    return 0

struct Recorder:
    unused: i32

impl Sink for Recorder:
    def take(index: i32, v: i32) -> void can[Ui.Controls]:
        seen[index.usize()] <- v

def main() -> i64:
    can Ui.Controls:
        M::seed()
        return 1 if M::sum_direct() != 33
        return 2 if value_at(0) != 0
        M::drain[Recorder]()
        return 3 if seen[0] != 11
        return 4 if seen[1] != 22
        return 0
