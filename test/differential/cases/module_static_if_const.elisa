# A `static if` inside a MODULE body leaves a Scoped node in the body. The backend
# walk that registers consts reads a module body positionally, so it saw the Scoped
# node instead of the Const the branch guards: the const was never registered and
# every use of it DECLINED ("backend could not produce a linkable unit"). Only the
# module form was affected -- the same `static if` at top level was already flattened.
#
# This is the shape `-emit edir` uses for its platform open(2) flags, and it kept the
# whole driver from self-hosting.
module Probe:
    private:
        static if ELISA_TARGET_OS_LINUX:
            const OPEN_FLAGS: i64 = 577
            const PLATFORM_TAG: i64 = 1
        static else:
            const OPEN_FLAGS: i64 = 1537
            const PLATFORM_TAG: i64 = 2

        # A const DERIVED from the branch-selected one folds through the same table.
        const OPEN_FLAGS_PLUS_ONE: i64 = OPEN_FLAGS + 1

    public:
        def flags() -> i64:
            return OPEN_FLAGS

        def derived() -> i64:
            return OPEN_FLAGS_PLUS_ONE

        def tag() -> i64:
            return PLATFORM_TAG

def main() -> i64:
    # Exactly one branch is live, so the pair is either (577, 1) or (1537, 2).
    linux_branch: bool = Probe::flags() == 577 and Probe::tag() == 1
    other_branch: bool = Probe::flags() == 1537 and Probe::tag() == 2
    return 1 if not linux_branch and not other_branch
    return 2 if Probe::derived() != Probe::flags() + 1
    return 0
