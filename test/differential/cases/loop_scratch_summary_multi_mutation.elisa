# An additional reference argument cannot be classified as a copied scalar.
def mutate(xs: darray[i64]&, out: mutable i64&) -> i64:
    out <- xs[0]
    return xs[0]
def main() -> i64:
    total: mutable i64 = 0
    other: mutable i64 = 0
    for i in 0..<4 |total, other|:
        xs: mutable darray[i64] = []
        xs.push(i)
        total <- total + mutate(&xs, &other)
    return 0 if total == 6 and other == 3 else 1
