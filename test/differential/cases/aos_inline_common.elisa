# An explicitly `@storage(inline)` common under `@packed_profile(build_heavy)`.
#
# stage0 read these back wrong. The constructor's row GEP was right all along;
# the READ took the single-word fast path, which pulls the field's bits out of
# the row word and then handed them to coerceValue -- a NUMERIC conversion. For a
# float that emits `uitofp`, so the stored 7.0f (bits 0x40E00000) came back as
# 1088421888.0. The multi-word path beside it always reinterpreted correctly, via
# a memcpy through allocas, which is why only the widths taking the fast path
# were affected.
#
# The float commons are the regression; the integer beside them pins the other
# half of that branch, and reading through a later block forces the word path
# rather than a row GEP.
@packed_profile(build_heavy)
enum Widget:
    common:
        @storage(inline)
        tag: mutable i32
        @storage(inline)
        x: mutable f32
        @storage(inline)
        wide: mutable f64
    pass

enum Control is Widget:
    Label(size: f32, next_sibling: Widget?)

def label(size: f32) -> Widget can[Memory.Allocate, Abort.Panic]:
    return Control.Label(tag: 3, x: 7.0, wide: 2.5, size: size, next_sibling: null)

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        region ui(65536):
            leaf: Widget = label(14.0)
            return 1 if leaf.tag != 3
            return 2 if leaf.x != 7.0
            return 3 if leaf.wide != 2.5
            return 0
