# A zero-filled array written over its first `count` elements and then
# handed to helpers only as a view of at most those elements never shows a
# zero to them, so the fill is dead (ElisaIndexedPrefix with ElisaViewBounds):
# union-find parents passed as `parents[0:count]`, and a view shorter than
# the written prefix. The negative hands over one element past the prefix,
# which is the fill's zero and must stay.
const LIMIT_NODES: usize = 128

@inline(never)
def find_root(parents: mutable view[i32], start: usize) -> usize:
    root: mutable usize = start
    while parents[root].usize() != root:
        root <- parents[root].usize()
    node: mutable usize = start
    while parents[node].usize() != node:
        next: usize = parents[node].usize()
        parents[node] <- root.i32()
        node <- next
    root

# Sums the view's elements, so every element it covers is observed.
@inline(never)
def total(values: view[i32]) -> i64:
    sum: mutable i64 = 0
    index: mutable usize = 0
    while index < values.len:
        sum <- sum + values[index].i64()
        index <- index + 1
    sum

# Unions pairs of nodes below `count` and counts the merges that closed a cycle.
@inline(never)
def cycles(pairs: view[i64], count: usize) -> i64:
    return -1 if count == 0 or count > LIMIT_NODES
    parents: mutable i32[128] = zeroed
    node: mutable usize = 0
    while node < count:
        parents[node] <- node.i32()
        node <- node + 1
    closed: mutable i64 = 0
    index: mutable usize = 0
    while index + 1 < pairs.len:
        left: usize = pairs[index].usize() % count
        right: usize = pairs[index + 1].usize() % count
        left_root: usize = find_root(parents[0:count], left)
        right_root: usize = find_root(parents[0:count], right)
        if left_root == right_root:
            closed <- closed + 1
        else:
            parents[left_root] <- right_root.i32()
        index <- index + 2
    closed * 100000 + total(parents[0:count])

# The same unions over a buffer it first reads whole, which keeps its fill.
def cycles_reference(pairs: view[i64], count: usize) -> i64:
    return -1 if count == 0 or count > LIMIT_NODES
    parents: mutable i32[128] = zeroed
    seen: i64 = total(parents[0:LIMIT_NODES])
    node: mutable usize = 0
    while node < count:
        parents[node] <- node.i32()
        node <- node + 1
    closed: mutable i64 = 0
    index: mutable usize = 0
    while index + 1 < pairs.len:
        left: usize = pairs[index].usize() % count
        right: usize = pairs[index + 1].usize() % count
        left_root: usize = find_root(parents[0:count], left)
        right_root: usize = find_root(parents[0:count], right)
        if left_root == right_root:
            closed <- closed + 1
        else:
            parents[left_root] <- right_root.i32()
        index <- index + 2
    closed * 100000 + total(parents[0:count]) + seen

# A view of the first half of the written prefix.
@inline(never)
def half_total(count: usize) -> i64:
    return -1 if count == 0 or count > LIMIT_NODES
    values: mutable i32[128] = zeroed
    node: mutable usize = 0
    while node < count:
        values[node] <- (node * 3 + 1).i32()
        node <- node + 1
    total(values[0:count / 2])

# One element past the written prefix: the fill's zero.
@inline(never)
def past_total(count: usize) -> i64:
    return -1 if count == 0 or count >= LIMIT_NODES
    values: mutable i32[128] = zeroed
    node: mutable usize = 0
    while node < count:
        values[node] <- (node * 3 + 1).i32()
        node <- node + 1
    total(values[0:count + 1])

def main() -> i32:
    pairs: mutable i64[64] = zeroed
    fill: mutable usize = 0
    while fill < 64:
        pairs[fill] <- (fill * 37 % 23).i64()
        fill <- fill + 1
    count: mutable usize = 1
    while count <= 40:
        expected_half: i64 = ((count / 2) * (3 * (count / 2) - 1) / 2).i64()
        return 10 if half_total(count) != expected_half
        return 11 if past_total(count) != (count * (3 * count - 1) / 2).i64()
        merged: i64 = cycles(pairs[0:64], count)
        return 12 if merged < 0 or merged != cycles_reference(pairs[0:64], count)
        count <- count + 1
    0
