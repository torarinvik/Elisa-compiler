# docs/119 §5 `rebind` and tuple-valued `if`/`match`/block destructuring. A bare rebind
# target is a reassignment of an existing mutable, a `name: T` target a fresh binding in
# the ENCLOSING scope (not the block's) — observable inside a loop body, where a shadow
# would die with the iteration. Owned values move through the destructuring temps.
global mutable observed: i64 = 0

def record(digit: i64) -> void:
    observed <- observed * 10 + digit

enum Shape:
    Square(side: i64)
    Rect(w: i64, h: i64)

def single_block(n: i64) -> i64:
    total: mutable i64 = n
    rebind total =
        doubled = total * 2
        doubled + 2
    rebind fresh: i64 =
        t = total + 1
        t
    return fresh

def mixed_in_loop(xs: darray[i64]) -> i64:
    hi: mutable i64 = 0
    total: mutable i64 = 0
    for x in xs:
        rebind hi, gained: i64 =
            if x > hi:
                x, x - hi
            else:
                hi, 0
        total <- total + gained
    return total * 100 + hi

def in_loop_expression(xs: darray[i64]) -> i64:
    r: i64 = for x in xs |acc = 0, hi = 0| -> acc * 100 + hi:
        rebind hi, gained: i64 =
            if x > hi:
                x, x - hi
            else:
                hi, 0
        acc <- acc + gained
    return r

def match_payload_tuple(s: Shape) -> i64:
    area, perimeter =
        match s:
            Shape.Square(side):
                side * side, 4 * side
            Shape.Rect(w, h):
                w * h, 2 * (w + h)
    return area * 100 + perimeter

def owned_multi(n: i64) -> i64:
    xs: mutable darray[i64] = [1, 2]
    count: mutable i64 = 0
    rebind xs, count =
        ys: mutable darray[i64] = [n, n, n]
        ys.push(n)
        ys, ys.count.i64()
    return xs[0] + count + xs.count.i64()

def owned_tuple_branches(n: i64) -> i64:
    xs, count =
        if n > 0:
            ys: mutable darray[i64] = [n]
            ys.push(n)
            ys, 2
        else:
            zs: darray[i64] = []
            zs, 0
    return xs[0] + xs[1] + count if count == 2 else -1

def elif_tuple(n: i64) -> i64:
    a, b =
        if n < 0:
            0, 0
        elif n < 10:
            n, 1
        else:
            n, 2
    return a * 10 + b

def cleanup_order(n: i64) -> i64:
    x: mutable i64 = 0
    rebind x, y: i64 =
        defer block:
            record(3)
        match n:
            1:
                defer block:
                    record(1)
                n + 10, observed
            _:
                n, 7
    return x * 100 + y

def main() -> i64:
    can Abort.Panic, Memory.Allocate:
        return 1 if single_block(20) != 43
        xs: darray[i64] = [3, 1, 18]
        return 2 if mixed_in_loop(xs) != 1818
        return 3 if in_loop_expression(xs) != 1818
        return 4 if match_payload_tuple(Shape.Rect(2, 3)) != 610 or match_payload_tuple(Shape.Square(4)) != 1616
        return 5 if owned_multi(34) != 42
        return 6 if owned_tuple_branches(20) != 42
        return 7 if elif_tuple(-4) != 0 or elif_tuple(4) != 41 or elif_tuple(40) != 402
        return 8 if cleanup_order(1) != 1100 or observed != 13
        return 0
