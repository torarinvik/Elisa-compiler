# Whole darray assignments that stay valid: both compilers must accept these and agree on
# the answer (71 + 70 + 70 + 1 + 70 = 282, exit code 26).

def copied_before() -> i64:
    mutable xs: darray[i64] = [70, 2]
    r: i64& = &xs[0]
    t: i64 = r
    xs <- [1, 2, 3]
    r2: i64& = &xs[0]
    return r2 + t

def copied_then_pushed() -> i64:
    mutable xs: darray[i64] = [70, 2]
    r: i64& = &xs[0]
    t: i64 = r
    xs.push(3)
    return t

def element_read() -> i64:
    mutable xs: darray[i64] = [70, 2]
    s: i64 = xs[0]
    xs <- [1, 2, 3]
    return s

def whole_reference() -> i64:
    mutable xs: darray[i64] = [70, 2]
    r: darray[i64]& = &xs
    xs <- [1]
    return r[0]

def rebuilt_from_itself() -> i64:
    mutable xs: darray[i64] = [70, -2, 3]
    xs <- [v for v in xs if v > 0]
    r: i64& = &xs[0]
    return r

# The runner treats a nonzero exit as agreed failure, so success must be 0.
def main() -> i32:
    total: i64 = copied_before() + copied_then_pushed() + element_read() + whole_reference() + rebuilt_from_itself()
    return 0 if total == 282 else 1
