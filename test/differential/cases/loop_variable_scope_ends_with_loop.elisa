# A `for` loop variable must END with its loop. stage1 left it in the backend scope, so a
# later function-scope `counter <- …` meant for the GLOBAL stored into the dead loop slot.
# No modules involved: this is the scope defect on its own. stage0 returns 0.
global mutable counter: i64 = 11

def churn() -> i64:
    total: mutable i64 = 0
    for counter in 0..<3:
        total <- total + counter
    counter <- counter + 100
    return total

def main() -> i64:
    1 return if churn() != 3
    2 return if counter != 111
    return 0
