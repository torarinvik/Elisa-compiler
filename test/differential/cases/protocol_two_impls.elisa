# A protocol may have MORE THAN ONE implementation in a compilation unit.
#
# stage1 declined this outright: one impl compiled, two impls of the same
# protocol made EVERY instantiation fail. stage0 accepted both. A protocol that
# supports exactly one implementation per unit defeats the point of having one.
#
# The decline was not an oversight, and the fix is not to remove it. Name-based
# resolution genuinely cannot separate two impls whose methods share a signature,
# and the comment at that site records what guessing cost: taking the first
# candidate made `print(42)` print "*", because stage1 models char, int, i64 and
# isize as ONE ValueType, so `impl Str for char` and `impl Str for i64` are
# indistinguishable there.
#
# So dispatch got a better answer to consult FIRST rather than a weaker guard:
# the BOUND TYPE. impl_member_types names the receiver, impl_member_lines gives
# that member's own line, and function_index_of_line keys the exact FnTable row.
# Unambiguous by construction. The name-based fallbacks stay for the cases the
# tables cannot answer -- including scalar receivers, which is why this fix is
# gated on a STRUCT receiver and cannot resurrect the char/i64 confusion.
#
# elisa-ui escaped this only by accident: Painter has an SDL3 and a wasm impl,
# Controls has an AppKit and a recording impl, and neither pair shares a
# compilation unit. A runtime presenter switch -- one binary choosing native or
# painted at startup -- needs exactly this.

protocol Painter:
    def stroke(value: i32) -> i32
    def dot() -> i32

struct PenA:
    tag: i32

struct PenB:
    tag: i32

struct PenC:
    tag: i32

impl Painter for PenA:
    def stroke(value: i32) -> i32:
        return value * 3

    def dot() -> i32:
        return 1

impl Painter for PenB:
    def stroke(value: i32) -> i32:
        return value * 7

    def dot() -> i32:
        return 2

impl Painter for PenC:
    def stroke(value: i32) -> i32:
        return value * 11

    def dot() -> i32:
        return 3

def paint[P: Painter](value: i32) -> i32:
    return P.stroke(value)

def mark[P: Painter]() -> i32:
    return P.dot()

# SCALAR receivers too. Matching is by ValueType rather than source spelling, so
# `bool` and `cstr` -- genuinely distinct types -- each resolve, while `char` and
# `int` (one ValueType in stage1) would BOTH match, making the count 2 and falling
# through to the name-based fallbacks exactly as before. That is what preserves
# the guard whose comment records `print(42)` once printing "*".
protocol Tag:
    def mark(value: i32) -> i32

impl Tag for bool:
    def mark(value: i32) -> i32:
        return value + 1

impl Tag for cstr:
    def mark(value: i32) -> i32:
        return value + 2

def tag_with[T: Tag](value: i32) -> i32:
    return T.mark(value)

def main() -> i32:
    # Each instantiation reaches ITS OWN impl, not merely the first registered.
    return 1 if paint[PenA](5) != 15 else 2 if paint[PenB](5) != 35 else 3 if paint[PenC](5) != 55 else marks()

# A zero-argument method too: with no arguments there is nothing for an
# argument-type overload probe to discriminate on, so this is the shape that
# most needs the bound type.
def marks() -> i32:
    return 4 if mark[PenA]() != 1 else 5 if mark[PenB]() != 2 else 6 if mark[PenC]() != 3 else scalars()

def scalars() -> i32:
    return 7 if tag_with[bool](10) != 11 else 8 if tag_with[cstr](10) != 12 else 0
