# A generic that pushes into a `darray&` parameter must grow it in the CALLER's arena.
# Explicit `fill_fixed[i64](&a...)` crashed the compiler (no arena slot was laid out);
# inferred `fill(&b...)` and UFCS `c.fill(...)` on `darray[T]&` were a silent
# use-after-free: the template's region facts were computed with `T` unbound, so the
# parameter looked non-growable and each instantiation grew `b`/`c` in its own auto
# region, freed on return. clobber() reuses that memory; the right answer is
# 4 + 4 + 4 + 3 * 40 = 132.
def fill_fixed[T](out: mutable darray[i64]&, value: T, n: i64):
    for i in 0..<n:
        out.push(4)

def fill[T](out: mutable darray[T]&, value: T, n: i64):
    for i in 0..<n:
        out.push(value)

def clobber() -> i64:
    junk: mutable darray[i64] = []
    for i in 0..<4096:
        junk.push(99)
    return junk.count.i64()

def main() -> i64:
    a: mutable darray[i64] = []
    b: mutable darray[i64] = []
    c: mutable darray[i64] = []
    fill_fixed[i64](&a, 4, 40)
    fill(&b, 4, 40)
    c.fill(4, 40)
    k: i64 = clobber()
    return a[3] + b[3] + c[3] + a.count.i64() + b.count.i64() + c.count.i64()
