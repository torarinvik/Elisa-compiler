# A loop `invariant` is a per-iteration obligation the FRONTEND discharges; stage0 erases it
# (`-emit lowered` shows the loop without it and its object carries no check). stage1
# declined the whole function body ("contract statement"), so the annotation the verifier
# asks for could not appear in any source this project compiles. The decline was easy to
# miss: a declined body that nothing calls is dropped and the compile still exits 0.
def scan(n: i64) -> i64:
	total: mutable i64 = 0
	i: mutable i64 = 0
	while i < n:
		invariant total >= 0
		total <- total + i
		i <- i + 1
	return total

def gather(limit: i64) -> i64:
	seen: mutable i64 = 0
	for value in 0..<limit:
		invariant seen >= 0
		seen <- seen + value
	return seen

def main() -> i64:
	1 return if scan(4) != 6
	2 return if scan(0) != 0
	3 return if gather(4) != 6
	4 return if gather(1) != 0
	return 0
