def fill(out: mutable darray[i64]&) -> void:
    out <- [41, 42]
def main() -> i64:
    values: mutable darray[i64] = []
    fill(&values)
    for i in 0..<20:
        noise: mutable darray[i64] = []
        noise.reserve(8192)
        noise.push(i)
    return 0 if values.count == 2 and values[0] == 41 and values[1] == 42 else 1
