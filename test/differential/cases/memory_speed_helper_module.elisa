module Measurements:
    public:
        def sum_values(input_size: i64) -> i64:
            scratch_values: mutable darray[i64] = []
            for item_index in 0..<input_size |scratch_values|:
                scratch_values.push(item_index + 1)
            subtotal: mutable i64 = 0
            for element in scratch_values |subtotal|:
                subtotal <- subtotal + element
            return subtotal

def main() -> i64:
    total: mutable i64 = 0
    for round in 0..<5 |total|:
        measured: i64 = Measurements::sum_values(round + 1)
        continue if round == 2
        total <- total + measured
        break if round == 3
    return 0 if total == 14 else 1
