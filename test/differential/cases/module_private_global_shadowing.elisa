# Parameters, block locals and loop variables SHADOWING the private global, and an
# identically named helper in each module. Shadowing must bind to the local; the global
# must still be the module's own.
module A:
    private:
        global mutable counter: i64 = 11
        def bump(counter: i64) -> i64:
            return counter + 1
    public:
        def read() -> i64:
            return counter
        def churn() -> i64:
            total: mutable i64 = 0
            for counter in 0..<3:
                total <- total + counter
            if true:
                counter: i64 = 500
                total <- total + counter
            counter <- counter + bump(1)
            return total

module B:
    private:
        global mutable counter: i64 = 73
        def bump(counter: i64) -> i64:
            return counter + 2
    public:
        def read() -> i64:
            return counter
        def churn() -> i64:
            total: mutable i64 = 0
            for counter in 0..<3:
                total <- total + counter
            if true:
                counter: i64 = 500
                total <- total + counter
            counter <- counter + bump(1)
            return total

def main() -> i64:
    1 return if A::churn() != 503
    2 return if A::read() != 13
    3 return if B::read() != 73
    4 return if B::churn() != 503
    5 return if B::read() != 76
    6 return if A::read() != 13
    return 0
