# Query bounds validated before they are stored (`return -1 if r > n`),
# reordered by an insertion sort that moves them within their arrays, then
# walked by two pointers that step toward each query's bounds and read a
# zero-filled array written over [0, n): every value the bound arrays hold
# is at most n (ElisaElementBounds: checks before the store, values moved
# within the array), the pointers stay at most n, and a countdown that
# continues only while above its target never wraps. The fill is dead. The
# negative accepts r = n + 1 and must read the fill's zero at element n.
const CAPACITY: usize = 128

@inline(never)
def window_sums(input: view[i64]) -> i64:
    return -1 if input.len < 2
    n64: i64 = input[0]
    q64: i64 = input[1]
    return -1 if n64 < 1 or n64 > 100 or q64 < 1 or q64 > 16
    n: usize = n64.usize()
    q: usize = q64.usize()
    return -1 if input.len != 2 + n + 2 * q
    weight: mutable i64[128] = zeroed
    i: mutable usize = 0
    while i < n:
        weight[i] <- input[2 + i] * 3 + 1
        i <- i + 1
    low: mutable usize[16] = zeroed
    high: mutable usize[16] = zeroed
    k: mutable usize = 0
    while k < q:
        l: i64 = input[2 + n + 2 * k]
        r: i64 = input[3 + n + 2 * k]
        return -1 if l < 0 or l > r or r > n64
        low[k] <- l.usize()
        high[k] <- r.usize()
        k <- k + 1
    i <- 1
    while i < q:
        x_low: usize = low[i]
        x_high: usize = high[i]
        j: mutable usize = i
        while j != 0 and low[j - 1] > x_low:
            low[j] <- low[j - 1]
            high[j] <- high[j - 1]
            j <- j - 1
        low[j] <- x_low
        high[j] <- x_high
        i <- i + 1
    left: mutable usize = 0
    right: mutable usize = 0
    window: mutable i64 = 0
    fold: mutable i64 = 0
    k <- 0
    while k < q:
        while right < high[k]:
            window <- window + weight[right]
            right <- right + 1
        while left > low[k]:
            left <- left - 1
            window <- window + weight[left]
        while left < low[k]:
            window <- window - weight[left]
            left <- left + 1
        while right > high[k]:
            right <- right - 1
            window <- window - weight[right]
        fold <- (fold * 31 + window) % 1000003
        k <- k + 1
    fold

@inline(never)
def window_sums_past(input: view[i64]) -> i64:
    return -1 if input.len < 2
    n64: i64 = input[0]
    q64: i64 = input[1]
    return -1 if n64 < 1 or n64 > 100 or q64 < 1 or q64 > 16
    n: usize = n64.usize()
    q: usize = q64.usize()
    return -1 if input.len != 2 + n + 2 * q
    weight: mutable i64[128] = zeroed
    i: mutable usize = 0
    while i < n:
        weight[i] <- input[2 + i] * 3 + 1
        i <- i + 1
    low: mutable usize[16] = zeroed
    high: mutable usize[16] = zeroed
    k: mutable usize = 0
    while k < q:
        l: i64 = input[2 + n + 2 * k]
        r: i64 = input[3 + n + 2 * k]
        return -1 if l < 0 or l > r or r > n64 + 1
        low[k] <- l.usize()
        high[k] <- r.usize()
        k <- k + 1
    i <- 1
    while i < q:
        x_low: usize = low[i]
        x_high: usize = high[i]
        j: mutable usize = i
        while j != 0 and low[j - 1] > x_low:
            low[j] <- low[j - 1]
            high[j] <- high[j - 1]
            j <- j - 1
        low[j] <- x_low
        high[j] <- x_high
        i <- i + 1
    left: mutable usize = 0
    right: mutable usize = 0
    window: mutable i64 = 0
    fold: mutable i64 = 0
    k <- 0
    while k < q:
        while right < high[k]:
            window <- window + weight[right]
            right <- right + 1
        while left > low[k]:
            left <- left - 1
            window <- window + weight[left]
        while left < low[k]:
            window <- window - weight[left]
            left <- left + 1
        while right > high[k]:
            right <- right - 1
            window <- window - weight[right]
        fold <- (fold * 31 + window) % 1000003
        k <- k + 1
    fold

def reference(input: view[i64], extra: usize) -> i64:
    n: usize = input[0].usize()
    q: usize = input[1].usize()
    order: mutable usize[16] = zeroed
    k: mutable usize = 0
    while k < q:
        order[k] <- k
        k <- k + 1
    i: mutable usize = 1
    while i < q:
        x: usize = order[i]
        j: mutable usize = i
        while j != 0 and input[2 + n + 2 * order[j - 1]] > input[2 + n + 2 * x]:
            order[j] <- order[j - 1]
            j <- j - 1
        order[j] <- x
        i <- i + 1
    fold: mutable i64 = 0
    k <- 0
    while k < q:
        l: usize = input[2 + n + 2 * order[k]].usize()
        r: usize = input[3 + n + 2 * order[k]].usize()
        window: mutable i64 = 0
        p: mutable usize = l
        while p < r:
            window <- window + (input[2 + p] * 3 + 1 if p < n else 0)
            p <- p + 1
        fold <- (fold * 31 + window) % 1000003
        k <- k + 1
    fold

def main() -> i32:
    input: mutable i64[64] = zeroed
    n: usize = 20
    q: usize = 6
    input[0] <- 20
    input[1] <- 6
    i: mutable usize = 0
    while i < n:
        input[2 + i] <- (i * 7 % 13).i64()
        i <- i + 1
    bounds: i64[12] = [5, 12, 0, 20, 9, 9, 3, 17, 14, 19, 1, 4]
    i <- 0
    while i < 12:
        input[22 + i] <- bounds[i]
        i <- i + 1
    return 10 if window_sums(input[0:34]) != reference(input[0:34], 0)
    # One past n: the walk reads weight[20], the fill's zero.
    input[25] <- 21
    return 11 if window_sums(input[0:34]) != -1
    return 12 if window_sums_past(input[0:34]) != reference(input[0:34], 1)
    0
