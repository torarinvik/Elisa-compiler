global mutable total: i64 = 0

struct Charge:
    amount: i64

def __drop__(self: Charge) -> void:
    total <- total + self.amount

def scoped(n: i64) -> void:
    h: Charge = Charge{amount: n}
    _ = h.amount

def main() -> i64:
    scoped(10)
    scoped(32)
    return 1 if total != 42
    return 0
