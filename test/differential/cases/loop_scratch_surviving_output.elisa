# Scratch dies each iteration; copied results remain valid through repeated growth.
def main() -> i64:
    out: mutable darray[i64] = []
    for i in 0..<200 |out|:
        xs: mutable darray[i64] = [i, 2]
        xs.reserve(4096)
        out.push(sum_values(&xs))
    return 1 if out.count != 200
    for i in 0..<200 |out|:
        return 2 if out[i] != i + 2
    return 0

def sum_values(xs: darray[i64]&) -> i64:
    total: mutable i64 = 0
    for value in xs |total|:
        total <- total + value
    return total
