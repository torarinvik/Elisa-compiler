# docs/127 D8 — a native extern's `ensure` is CHECKED at every call boundary in a checked
# build, not assumed. `@trusted("reason")` is what buys the assumption, and the only thing
# that does. The bounded form reads the view's own length, which is `.len`.
@callconv(c)
extern strnlen(s: view[u8], n: usize) -> usize ensure result <= s.len

@callconv(c)
@trusted("the platform test suite validates libc strlen")
extern strlen(s: cstr) -> usize ensure result < 4096

def main() -> i64:
    buf: darray[u8] = [104, 105, 0]
    bounded: usize = strnlen(buf[0:3], 3)
    trusted_length: usize = strlen("hi")
    return bounded.i64() + trusted_length.i64() - 4
