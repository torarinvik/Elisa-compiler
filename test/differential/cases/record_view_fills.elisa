# A zero-filled array of records written over its first `count` elements
# and handed to a helper as `runs[0:count]` is read only below `count`: the
# helper reads each record's fields, and a field access (element i's offset
# plus a residue that leaves room for the field) touches element i alone
# (ElisaViewBounds). The fill is dead. The negative hands the helper one
# record more than was written and must see the fill's zeros in it.
const CAPACITY: usize = 64

struct Run:
    direction: i64
    count: i64

def fold_runs(runs: view[Run]) -> i64:
    fold: mutable i64 = 7
    index: mutable usize = 0
    while index < runs.len:
        fold <- (fold * 31 + runs[index].direction * 1000 + runs[index].count) % 1000003
        index <- index + 1
    fold

@inline(never)
def decode(input: view[i64], count: usize, extra: usize) -> i64:
    return -1 if count + extra > CAPACITY or 2 * count > input.len
    runs: mutable Run[64] = zeroed
    index: mutable usize = 0
    while index < count:
        runs[index] <- Run{direction: input[2 * index], count: input[2 * index + 1]}
        index <- index + 1
    fold_runs(runs[0:count + extra])

def main() -> i32:
    input: mutable i64[120] = zeroed
    k: mutable usize = 0
    while k < 120:
        input[k] <- (k * 29 % 61).i64() + 1
        k <- k + 1
    count: mutable usize = 0
    while count <= 60:
        expected: mutable i64 = 7
        i: mutable usize = 0
        while i < count:
            expected <- (expected * 31 + input[2 * i] * 1000 + input[2 * i + 1]) % 1000003
            i <- i + 1
        return 10 if decode(input[0:120], count, 0) != expected
        if count < 60:
            return 11 if decode(input[0:120], count, 1) != expected * 31 % 1000003
        count <- count + 1
    0
