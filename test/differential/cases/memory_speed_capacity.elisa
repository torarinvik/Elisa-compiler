def counted(input_count: i64) -> i64:
    return 0 if input_count < 0
    values: mutable darray[i64] = []
    for index in 0..<input_count |values|:
        values.push(index + 1)
    total: mutable i64 = 0
    for value in values |total|:
        total <- total + value
    return total

def main() -> i64:
    return 1 if counted(-3) != 0
    return 2 if counted(0) != 0
    return 3 if counted(1) != 1
    return 4 if counted(4097) != 8394753
    return 0
