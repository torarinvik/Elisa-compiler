# A large success payload uses an out pointer, but an error-returning function
# must still return its status code. The old fast path emitted `ret void` from an
# i32 function when the payload was constructed directly.
error BuildError:
    Failed

struct LargeResult:
    values: i64[256]

def make_large() -> LargeResult error[BuildError]:
    LargeResult{values: zeroed}

def main() -> i32:
    result: LargeResult =
        catch make_large():
            value: value
            error failure: LargeResult{values: zeroed}
    0 if result.values[0] == 0 else 1
