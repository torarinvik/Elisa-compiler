# The SAME binder name bound twice by `is` in one function.
#
# The slot is deliberately shared across every bind of a name -- that is what lets
# a binding outlive the match that made it. But bind_is_slot returned that shared
# slot WITHOUT declaring the name again, so the second `if x is held:` left `held`
# resolving to nothing: the first bind's declare_local had gone into a scope that
# closed. The body was then emitted against an Unmodeled type, and a write through
# the binding declined.
#
# It read as a per-ARM problem (two match arms, one binder) and is really a
# per-NAME one: renaming the second binder made it compile. Both shapes are below.
enum Widget:
    common:
        @storage(inline)
        pressed: mutable bool
    pass

enum Control is Widget:
    Button(size: f32)

enum Step:
    Down
    Up
    Leave

global mutable active: Widget? = null

def make(size: f32) -> Widget can[Memory.Allocate, Abort.Panic]:
    return Control.Button(pressed: true, size: size)

# Two ARMS, one binder name.
def feed(root: Widget, step: Step) -> i64:
    match step:
        Step.Down:
            active <- root
            return 1
        Step.Up:
            if active is held:
                held.pressed <- false
            return 2
        Step.Leave:
            if active is held:
                held.pressed <- false
            return 3

# Two binds of one name in a SINGLE block, no match involved.
def twice(root: Widget) -> bool:
    active <- root
    if active is held:
        held.pressed <- true
    if active is held:
        held.pressed <- false
    if active is held:
        return held.pressed
    return true

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        region ui(65536):
            w: Widget = make(1.0)
            return 1 if feed(w, (Step.Down)) != 1
            return 2 if feed(w, (Step.Up)) != 2
            return 3 if w.pressed
            w.pressed <- true
            return 4 if feed(w, (Step.Leave)) != 3
            return 5 if w.pressed
            return 6 if twice(w)
            return 0
