# Mutation is outside the summary proof, even when the result is scalar.
def change(xs: mutable darray[i64]&) -> i64:
    xs[0] <- 7
    return xs[0]
def main() -> i64:
    total: mutable i64 = 0
    for i in 0..<4 |total|:
        xs: mutable darray[i64] = []
        xs.push(i)
        total <- total + change(&xs)
    return 0 if total == 28 else 1
