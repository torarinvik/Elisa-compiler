# A module-qualified GLOBAL is readable from outside the module.
#
# stage0 compiled `M::counter`; stage1 declined it as a "field expression" --
# while `M::LIMIT`, a const in the same module, compiled fine. The asymmetry had
# no reason behind it: codegen_expr_idents_binary's Scope path resolved consts by
# rewriting to a bare Ident with current_owner set to the module, and simply had
# no branch for a global.
#
# Globals are registered under their BARE name (codegen_struct_reg pushes
# const_name with no owner at all), so the very same rewrite resolves one.
#
# The practical cost of the gap: a module that owned state had to expose a public
# accessor for every field just to be read from outside, which is what elisa-ui's
# backends were doing.

module Counters:
    public:
        const LIMIT: i32 = 9
        global mutable hits: i32 = 7
        global seed: i32 = 3

        def bump() -> void:
            hits <- hits + 1

def main() -> i32:
    # A const and a global, read through the same qualifier.
    return 1 if Counters::LIMIT != 9 else mutable_read() + immutable_read() + after_write()

def mutable_read() -> i32:
    return 2 if Counters::hits != 7 else 0

def immutable_read() -> i32:
    return 3 if Counters::seed != 3 else 0

# The read sees writes made INSIDE the module, so it is the real global and not a
# folded copy of its initializer.
def after_write() -> i32:
    Counters::bump()
    Counters::bump()
    return 4 if Counters::hits != 9 else 0
