# docs/127 D9 — a C enum's value set is open at the ABI, so `match` exhaustiveness over one
# is only sound for a value that was VALIDATED on the way in. `extern enum` declares the
# mirror; `Name.from_c(raw)` is the only way to build one from a foreign integer.
#
# The members are deliberately SPARSE (3, 27, 65): a range check would admit 4, which names
# nothing. The raw values come through libc `strlen` so neither compiler can fold them away
# and reason about the result at compile time.
#
# Exit 0 on both compilers.

@callconv(c)
extern strlen(s: cstr) -> usize

extern enum Token of i32:
    Space = 3
    Escape = 27
    Letter = 65

# The same C API, declared @open: values outside the member list are expected, so there is
# nothing to validate and the obligation moves to the match instead.
@open
extern enum Event of i32:
    Quit = 3
    Redraw = 27

def name_of(token: Token) -> i64:
    match token:
        Token.Space:
            return 1
        Token.Escape:
            return 2
        Token.Letter:
            return 3

def handle(event: Event) -> i64:
    match event:
        Event.Quit:
            return 10
        Event.Redraw:
            return 20
        _:
            return 99

def main() -> i64:
    # 3 is a member: validation passes and the exhaustive match is sound.
    good: Token = try Token.from_c(strlen("abc").i32()) else Token.Letter
    return 1 if name_of(good) != 1

    # 4 is inside 3..65 but names nothing. A range check would have let it through, and the
    # exhaustive match would then have run off the end of its switch.
    bad: Token = try Token.from_c(strlen("abcd").i32()) else Token.Letter
    return 2 if name_of(bad) != 3

    # 27 is a member.
    escape: Token = try Token.from_c(strlen("abcdefghijklmnopqrstuvwxyz0").i32()) else Token.Space
    return 3 if name_of(escape) != 2

    # The @open enum converts directly; its unknown values are the default arm's business.
    return 4 if handle(strlen("abc").i32().Event()) != 10
    return 5 if handle(strlen("abcd").i32().Event()) != 99
    return 0
