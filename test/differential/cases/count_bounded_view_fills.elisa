# A zero-filled stack handed to a helper as a whole-buffer view together
# with its count (`sort(items[0:capacity], count)`) never shows a zero to
# the helper when the helper reads only below the count, so the fill is
# dead (ElisaViewBounds callBound with ElisaStackWatermark). The negatives
# read one element past the count, or pass a count past the pushed top;
# those elements are the fill's zeros and must stay.
const CAPACITY: usize = 64

@inline(never)
def sort_ascending(items: mutable view[i64], count: usize) -> void:
    index: mutable usize = 1
    while index < count:
        value: i64 = items[index]
        position: mutable usize = index
        while position > 0 and items[position - 1] > value:
            items[position] <- items[position - 1]
            position <- position - 1
        items[position] <- value
        index <- index + 1

# Passes the view and its count on, so the bound is checked one call deeper.
@inline(never)
def sort_twice(items: mutable view[i64], count: usize) -> void:
    sort_ascending(items, count)
    sort_ascending(items, count)

# The first index whose value is at least `value`; the length is read
# inside the loop, which the view proof must match to the bounds check.
@inline(never)
def lower_bound(items: view[i64], value: i64) -> usize:
    low: mutable usize = 0
    high: mutable usize = items.len
    while low < high:
        middle: usize = low + (high - low) / 2
        if items[middle] < value:
            low <- middle + 1
        else:
            high <- middle
    low

# Pushes the values above `pivot`, sorts them, and counts those below
# `pivot + 10` by a binary search over a view of the pushed elements.
@inline(never)
def sorted_rank(values: view[i64], pivot: i64) -> i64:
    return -1 if values.len > CAPACITY
    kept: mutable i64[64] = zeroed
    count: mutable usize = 0
    index: mutable usize = 0
    while index < values.len:
        if values[index] > pivot:
            kept[count] <- values[index]
            count <- count + 1
        index <- index + 1
    sort_ascending(kept[0:CAPACITY], count)
    lower_bound(kept[0:count], pivot + 10).i64()

# Reads elements [0, count], one past the count.
@inline(never)
def through_total(items: view[i64], count: usize) -> i64:
    sum: mutable i64 = 0
    index: mutable usize = 0
    while index <= count:
        sum <- sum + items[index] * (index.i64() + 1)
        index <- index + 1
    sum

# Pushes the values above `pivot`, sorts them, and folds them high to low.
@inline(never)
def sorted_fold(values: view[i64], pivot: i64) -> i64:
    return -1 if values.len > CAPACITY
    kept: mutable i64[64] = zeroed
    count: mutable usize = 0
    index: mutable usize = 0
    while index < values.len:
        if values[index] > pivot:
            kept[count] <- values[index]
            count <- count + 1
        index <- index + 1
    sort_twice(kept[0:CAPACITY], count)
    fold: mutable i64 = 0
    index <- count
    while index > 0:
        fold <- (fold * 3 + kept[index - 1]) % 1000003
        index <- index - 1
    fold

# Sorts the same values, then reads them one past the count.
@inline(never)
def through_fold(values: view[i64], pivot: i64) -> i64:
    return -1 if values.len >= CAPACITY
    kept: mutable i64[64] = zeroed
    count: mutable usize = 0
    index: mutable usize = 0
    while index < values.len:
        if values[index] > pivot:
            kept[count] <- values[index]
            count <- count + 1
        index <- index + 1
    sort_ascending(kept[0:CAPACITY], count)
    through_total(kept[0:CAPACITY], count)

# Sorts one element more than it pushed: the zero past the top joins in.
@inline(never)
def overcount_first(values: view[i64], pivot: i64) -> i64:
    return -1 if values.len >= CAPACITY
    kept: mutable i64[64] = zeroed
    count: mutable usize = 0
    index: mutable usize = 0
    while index < values.len:
        if values[index] > pivot:
            kept[count] <- values[index]
            count <- count + 1
        index <- index + 1
    sort_ascending(kept[0:CAPACITY], count + 1)
    kept[0]

def main() -> i32:
    values: mutable i64[40] = zeroed
    fill: mutable usize = 0
    while fill < 40:
        values[fill] <- (fill * 29 % 41).i64() + 1
        fill <- fill + 1
    pivot: mutable i64 = 0
    while pivot <= 42:
        # Reference: the values above pivot, ascending, folded high to low.
        fold: mutable i64 = 0
        through: mutable i64 = 0
        rank: mutable i64 = 0
        candidate: mutable i64 = 42
        while candidate > pivot:
            seen: mutable usize = 0
            while seen < 40:
                if values[seen] == candidate:
                    fold <- (fold * 3 + candidate) % 1000003
                seen <- seen + 1
            candidate <- candidate - 1
        rank_below: mutable i64 = 0
        candidate <- pivot + 1
        while candidate <= 42:
            seen: mutable usize = 0
            while seen < 40:
                if values[seen] == candidate:
                    rank <- rank + 1
                    if candidate < pivot + 10:
                        rank_below <- rank_below + 1
                    through <- through + candidate * rank
                seen <- seen + 1
            candidate <- candidate + 1
        return 10 if sorted_fold(values[0:40], pivot) != fold
        return 11 if through_fold(values[0:40], pivot) != through
        return 12 if overcount_first(values[0:40], pivot) != 0
        return 13 if sorted_rank(values[0:40], pivot) != rank_below
        pivot <- pivot + 1
    0
