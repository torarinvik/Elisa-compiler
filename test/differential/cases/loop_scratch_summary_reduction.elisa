def main() -> i64:
    total: mutable i64 = 0
    for i in 0..<4 |total|:
        xs: mutable darray[i64] = [i, 2, -1]
        total <- total + positive_sum(&xs) + range_sum(&xs) + while_sum(&xs)
    return 0 if total == 34 else 1

def positive_sum(xs: darray[i64]&) -> i64:
    total: mutable i64 = 0
    for value in xs |total|:
        continue if value < 0
        if value > 0:
            adjusted: i64 = value
            total <- total + adjusted
    return total

def range_sum(xs: darray[i64]&) -> i64:
    total: mutable i64 = 0
    for index in 0..<xs.count |total, xs|:
        total <- total + xs[index]
    return total

def while_sum(xs: darray[i64]&) -> i64:
    total: mutable i64 = 0
    index: mutable usize = 0
    while index < xs.count |total, index, xs|:
        total <- total + xs[index]
        index <- index + 1
    return total
