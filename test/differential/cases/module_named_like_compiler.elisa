# A user program whose module is named `Backend` -- the same name the compiler
# gives its own.
#
# The note that used to sit here blamed the module-qualified enum constructor in
# the argument position, and said binding it to a local first was a workaround.
# Both were wrong: neither the constructor nor the enum was involved, and the
# declining call was `Backend::replay()`. Two modules, one function each and no
# enum anywhere, reproduce it as long as the second is called `Backend`.
#
# function_needs_ast_store matched the bare owner name `Parser`/`Backend`, so a
# USER module by that name had every function declared with the compiler's hidden
# AST store parameter -- which no caller passes, so every call to one declined. It
# is now gated on the program actually declaring the compiler's own sealed `Node`
# hierarchy.
#
# The names below are deliberate: `Core` is fine, `Backend` is the collision.
module Core:
    public:
        struct Color:
            r: u8
        enum Command:
            Clear(color: Color)
            Line(ax: f32, bx: f32)
    private:
        global mutable buffer: Command[4] = zeroed
        global mutable total: usize = 0
    public:
        def push(c: Command) -> void:
            buffer[total] <- c
            total <- total + 1
        def count() -> usize:
            return total
        def at(index: usize) -> Command:
            return buffer[index]

module Backend:
    public:
        def replay() -> i64:
            sum: mutable i64 = 0
            for index in 0..<Core::count():
                match Core::at(index):
                    Core::Command.Clear(color):
                        sum <- sum + color.r.i64()
                    Core::Command.Line(ax, bx):
                        sum <- sum + 100
            return sum

def main() -> i64:
    Core::push(Core::Command.Clear(Core::Color{r: 5}))
    Core::push(Core::Command.Line(1.0, 2.0))
    return 1 if Backend::replay() != 105
    return 0
