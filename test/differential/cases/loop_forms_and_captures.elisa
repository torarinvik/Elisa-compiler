# The loop forms that stage1 d00ebe2c withdrew a divergence claim against. A
# rewrite away from these was once credited with restoring the gen3 fixpoint;
# it was not the cause, and the concise forms are what the compiler's own
# registration code uses again. This pins the semantics both generations owe:
#
#   * `for _ in local..<ref.field.count |captures|:` -- a `_` binder over a range
#     whose bound is a field expression, mutating a DIFFERENT field through a
#     captured reference
#   * that same bound RE-READ while the body grows it: evaluated once, at entry
#   * a postfix VALUE return out of `for x in darray[struct] |captures|:`
#   * `continue if` and `true return if` in one loop body
#   * `break if` inside a `while ... |captures|:`
#   * a short-circuit `and` whose earlier conjunct guards a later index into a
#     SHORTER parallel array

struct Table:
    variants: mutable darray[i64]
    owners: mutable darray[i64]

struct Note:
    line: i64
    owner: sview
    name: sview

# `_` binder, field-expression bound, mutation through the captured reference.
def fill_owners(t: mutable Table&, tag: i64) -> void can[Memory.Allocate]:
    before: usize = t.owners.count
    for _ in before..<t.variants.count |t, tag|:
        t.owners <- t.owners.push(tag)

# The body grows the very array the bound reads. Evaluated once => 5 ticks.
def grow_while_walking(t: mutable Table&) -> i64 can[Memory.Allocate]:
    ticks: mutable i64 = 0
    for _ in 0..<t.variants.count |t, ticks|:
        ticks <- ticks + 1
        t.variants <- t.variants.push(0) if ticks < 3
    return ticks

def parent_of(notes: darray[Note]&, who: sview) -> sview can[Abort.Panic]:
    for note in notes |who|:
        note.name return if note.line == 39 and note.owner == who
    return ""

def forces(notes: darray[Note]&, who: sview) -> bool can[Abort.Panic]:
    for note in notes |who|:
        continue if note.owner != who
        true return if note.name == "recursive"
    return false

def root_of(notes: darray[Note]&, who: sview) -> sview can[Abort.Panic]:
    cursor: mutable sview = who
    steps: mutable usize = 0
    while steps < notes.count |cursor, steps, notes|:
        parent: sview = parent_of(notes, cursor)
        break if parent == ""
        cursor <- parent
        steps <- steps + 1
    return cursor

# `counts` is SHORTER than `owners`: the bounds test must run before the index.
def guarded(owners: darray[sview]&, counts: darray[usize]&, name: sview) -> bool can[Abort.Panic]:
    for index in 0..<owners.count |owners, counts, name|:
        true return if owners[index] == name and index < counts.count and counts[index] > 0
    return false

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        t: mutable Table = Table{variants: [], owners: []}
        for i in 0..<5 |t|:
            t.variants <- t.variants.push(i.i64())
        fill_owners(t, 7)
        return 1 if t.owners.count != 5
        for j in 0..<5 |t|:
            return 2 if t.owners[j] != 7
        return 3 if grow_while_walking(t) != 5
        return 4 if t.variants.count != 7

        notes: mutable darray[Note] = []
        notes <- notes.push(Note{line: 7, owner: "x", name: "noise"})
        notes <- notes.push(Note{line: 39, owner: "Mouse", name: "Input"})
        notes <- notes.push(Note{line: 39, owner: "Input", name: "Event"})
        notes <- notes.push(Note{line: 1, owner: "Rec", name: "recursive"})
        return 5 if parent_of(notes, "Mouse") != "Input"
        return 6 if parent_of(notes, "Event") != ""
        return 7 if root_of(notes, "Mouse") != "Event"
        return 8 if root_of(notes, "Nobody") != "Nobody"
        return 9 if not forces(notes, "Rec")
        return 10 if forces(notes, "Mouse")

        owners: mutable darray[sview] = []
        counts: mutable darray[usize] = []
        owners <- owners.push("A")
        counts <- counts.push(0)
        owners <- owners.push("B")
        counts <- counts.push(3)
        owners <- owners.push("C")
        owners <- owners.push("D")
        return 11 if guarded(owners, counts, "A")
        return 12 if not guarded(owners, counts, "B")
        return 13 if guarded(owners, counts, "C")
        return 14 if guarded(owners, counts, "D")
        return 0
