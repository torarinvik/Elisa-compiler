# `_ = get f(x) else return N` discards an OPTIONAL call's payload and returns N when it
# is absent. stage1 routed every guarded call in this statement form through the
# error-propagation (`try`) lowering, which declines a callee that is not
# error-returning, so the whole unit failed to emit.
def doubled_if_positive(value: i64) -> i64?:
    return null if value < 0
    value * 2

def check(value: i64) -> i64:
    _ = get doubled_if_positive(value) else return 1
    0

def main() -> i64:
    return 2 if check(5) != 0
    return 3 if check(-5) != 1
    0
