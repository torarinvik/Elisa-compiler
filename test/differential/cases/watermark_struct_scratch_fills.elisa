# Zero-filled arrays of structs used as stacks, declared inside a query loop
# so the loop zeroes them again for every query (ElisaStackWatermark). Each
# pair is stored one field at a time; a count comes back as -1 on failure, is
# clamped by slicing to the capacity, or bounds a merge of two stacks. Reads
# below the pushes never see the fill, so it is dead. The negatives read one
# run past the pushes, where an earlier query may have left a run, or a field
# that only some pushes store: those must still see the fill's zero.
const MAX_RUNS: usize = 64
const MODULUS: i64 = 1000003

struct Stretch:
    kind: mutable i64
    size: mutable i64

# The runs of Euclid's algorithm on a fraction, or -1 past `room` runs.
@inline(always)
def encode_runs(numerator_value: i64, denominator_value: i64, runs: mutable view[Stretch], room: usize) -> i64:
    numerator: mutable i64 = numerator_value
    denominator: mutable i64 = denominator_value
    used: mutable usize = 0
    while numerator != denominator:
        if used >= room: return -1
        if numerator < denominator:
            size: i64 = (denominator - 1) / numerator
            runs[used] <- Stretch{kind: 0, size: size}
            denominator <- denominator - size * numerator
        else:
            size: i64 = (numerator - 1) / denominator
            runs[used] <- Stretch{kind: 1, size: size}
            numerator <- numerator - size * denominator
        used <- used + 1
    used.i64()

# The runs two encodings share from the start.
@inline(always)
def common_runs(left: view[Stretch], right: view[Stretch], prefix: mutable view[Stretch]) -> usize:
    left_index: mutable usize = 0
    right_index: mutable usize = 0
    left_used: mutable i64 = 0
    right_used: mutable i64 = 0
    count: mutable usize = 0
    while left_index < left.len and right_index < right.len and
        left[left_index].kind == right[right_index].kind:
        left_left: i64 = left[left_index].size - left_used
        right_left: i64 = right[right_index].size - right_used
        shared: i64 = left_left if left_left < right_left else right_left
        prefix[count] <- Stretch{kind: left[left_index].kind, size: shared}
        count <- count + 1
        left_used <- left_used + shared
        right_used <- right_used + shared
        if left_used == left[left_index].size:
            left_index <- left_index + 1
            left_used <- 0
        if right_used == right[right_index].size:
            right_index <- right_index + 1
            right_used <- 0
    count

def fold(total: i64, run: Stretch) -> i64:
    (total * 3 + run.kind * 7 + run.size) % MODULUS

# Reads the whole buffer, so a reference's fill is observed and stays.
@inline(never)
def observe(runs: view[Stretch]) -> i64:
    runs[runs.len - 1].size

# Folds each query's runs.
@inline(never)
def sum_runs(fractions: view[i64], queries: usize, room: usize) -> i64:
    total: mutable i64 = 0
    query: mutable usize = 0
    while query < queries:
        runs: mutable Stretch[MAX_RUNS] = zeroed
        used: i64 = encode_runs(fractions[2 * query], fractions[2 * query + 1], runs[0:MAX_RUNS], room)
        if used < 0:
            total <- (total * 5 + 3) % MODULUS
        else:
            limit: usize = used.usize()
            index: mutable usize = 0
            while index < limit:
                total <- fold(total, runs[index])
                index <- index + 1
        query <- query + 1
    total

# One run past the pushes: the fill's zero, never an earlier query's run.
@inline(never)
def sum_runs_past(fractions: view[i64], queries: usize, room: usize) -> i64:
    total: mutable i64 = 0
    query: mutable usize = 0
    while query < queries:
        runs: mutable Stretch[MAX_RUNS] = zeroed
        used: i64 = encode_runs(fractions[2 * query], fractions[2 * query + 1], runs[0:MAX_RUNS], room)
        if used < 0:
            total <- (total * 5 + 3) % MODULUS
        else:
            limit: usize = used.usize() + 1 if used.usize() < MAX_RUNS else used.usize()
            index: mutable usize = 0
            while index < limit:
                total <- fold(total, runs[index])
                index <- index + 1
        query <- query + 1
    total

def sum_runs_reference(fractions: view[i64], queries: usize, extra: bool, room: usize) -> i64:
    total: mutable i64 = 0
    query: mutable usize = 0
    while query < queries:
        runs: mutable Stretch[MAX_RUNS] = zeroed
        total <- total + observe(runs[0:MAX_RUNS])
        used: i64 = encode_runs(fractions[2 * query], fractions[2 * query + 1], runs[0:MAX_RUNS], room)
        if used < 0:
            total <- (total * 5 + 3) % MODULUS
        else:
            limit: usize = used.usize() + 1 if extra and used.usize() < MAX_RUNS else used.usize()
            index: mutable usize = 0
            while index < limit:
                total <- fold(total, runs[index])
                index <- index + 1
        query <- query + 1
    total

# Folds the runs two fractions share.
@inline(never)
def shared_runs(fractions: view[i64], queries: usize, room: usize) -> i64:
    total: mutable i64 = 0
    query: mutable usize = 0
    while query + 1 < queries:
        left: mutable Stretch[MAX_RUNS] = zeroed
        right: mutable Stretch[MAX_RUNS] = zeroed
        prefix: mutable Stretch[MAX_RUNS] = zeroed
        left_count: i64 = encode_runs(fractions[2 * query], fractions[2 * query + 1], left[0:MAX_RUNS], room)
        right_count: i64 = encode_runs(fractions[2 * query + 2], fractions[2 * query + 3], right[0:MAX_RUNS], room)
        if left_count >= 0 and right_count >= 0:
            count: usize = common_runs(left[0:left_count.usize()], right[0:right_count.usize()], prefix[0:MAX_RUNS])
            limit: usize = count
            index: mutable usize = 0
            while index < limit:
                total <- fold(total, prefix[index])
                index <- index + 1
        query <- query + 1
    total

# One run past the pushes: the fill's zero, never an earlier query's run.
@inline(never)
def shared_runs_past(fractions: view[i64], queries: usize, room: usize) -> i64:
    total: mutable i64 = 0
    query: mutable usize = 0
    while query + 1 < queries:
        left: mutable Stretch[MAX_RUNS] = zeroed
        right: mutable Stretch[MAX_RUNS] = zeroed
        prefix: mutable Stretch[MAX_RUNS] = zeroed
        left_count: i64 = encode_runs(fractions[2 * query], fractions[2 * query + 1], left[0:MAX_RUNS], room)
        right_count: i64 = encode_runs(fractions[2 * query + 2], fractions[2 * query + 3], right[0:MAX_RUNS], room)
        if left_count >= 0 and right_count >= 0:
            count: usize = common_runs(left[0:left_count.usize()], right[0:right_count.usize()], prefix[0:MAX_RUNS])
            limit: usize = count + 1 if count < MAX_RUNS else count
            index: mutable usize = 0
            while index < limit:
                total <- fold(total, prefix[index])
                index <- index + 1
        query <- query + 1
    total

def shared_runs_reference(fractions: view[i64], queries: usize, extra: bool, room: usize) -> i64:
    total: mutable i64 = 0
    query: mutable usize = 0
    while query + 1 < queries:
        left: mutable Stretch[MAX_RUNS] = zeroed
        right: mutable Stretch[MAX_RUNS] = zeroed
        prefix: mutable Stretch[MAX_RUNS] = zeroed
        total <- total + observe(left[0:MAX_RUNS]) + observe(right[0:MAX_RUNS]) + observe(prefix[0:MAX_RUNS])
        left_count: i64 = encode_runs(fractions[2 * query], fractions[2 * query + 1], left[0:MAX_RUNS], room)
        right_count: i64 = encode_runs(fractions[2 * query + 2], fractions[2 * query + 3], right[0:MAX_RUNS], room)
        if left_count >= 0 and right_count >= 0:
            count: usize = common_runs(left[0:left_count.usize()], right[0:right_count.usize()], prefix[0:MAX_RUNS])
            limit: usize = count + 1 if extra and count < MAX_RUNS else count
            index: mutable usize = 0
            while index < limit:
                total <- fold(total, prefix[index])
                index <- index + 1
        query <- query + 1
    total

# Pushes store `size` only for odd values: an even value's run keeps the
# fill's zero there, inside the pushed prefix.
@inline(never)
def half_runs(fractions: view[i64], queries: usize) -> i64:
    total: mutable i64 = 0
    query: mutable usize = 0
    while query < queries:
        runs: mutable Stretch[MAX_RUNS] = zeroed
        used: mutable usize = 0
        while used < MAX_RUNS and used < query % 5 + 1:
            value: i64 = fractions[(query + used) % (2 * queries)]
            runs[used].kind <- value
            if value % 2 == 1:
                runs[used].size <- value * 11
            used <- used + 1
        index: mutable usize = 0
        while index < used:
            total <- fold(total, runs[index])
            index <- index + 1
        query <- query + 1
    total

def half_runs_reference(fractions: view[i64], queries: usize) -> i64:
    total: mutable i64 = 0
    query: mutable usize = 0
    while query < queries:
        runs: mutable Stretch[MAX_RUNS] = zeroed
        total <- total + observe(runs[0:MAX_RUNS])
        used: mutable usize = 0
        while used < MAX_RUNS and used < query % 5 + 1:
            value: i64 = fractions[(query + used) % (2 * queries)]
            runs[used].kind <- value
            if value % 2 == 1:
                runs[used].size <- value * 11
            used <- used + 1
        index: mutable usize = 0
        while index < used:
            total <- fold(total, runs[index])
            index <- index + 1
        query <- query + 1
    total

def main() -> i32:
    fractions: mutable i64[80] = zeroed
    fill: mutable usize = 0
    while fill < 80:
        fractions[fill] <- (fill * 37 % 89 + 1).i64() if fill % 6 != 0 else (fill * 13 % 55 + 34).i64()
        fill <- fill + 1
    # Fibonacci-like pairs need more runs than `room` and fail with -1. Two
    # rooms keep it a variable in the queries rather than a folded constant.
    room: mutable usize = 3
    while room <= 6:
        queries: mutable usize = 0
        while queries <= 40:
            variant: mutable usize = 0
            while variant < 2:
                extra: bool = variant == 1
                sum: i64 = sum_runs_past(fractions[0:80], queries, room) if extra else sum_runs(fractions[0:80], queries, room)
                return 10 if sum != sum_runs_reference(fractions[0:80], queries, extra, room)
                shared: i64 = shared_runs_past(fractions[0:80], queries, room) if extra else shared_runs(fractions[0:80], queries, room)
                return 20 if shared != shared_runs_reference(fractions[0:80], queries, extra, room)
                variant <- variant + 1
            return 30 if half_runs(fractions[0:80], queries) != half_runs_reference(fractions[0:80], queries)
            queries <- queries + 1
        room <- room + 3
    0
