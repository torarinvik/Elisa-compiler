# `xs.push([..])` splits a list literal into one push per element ONLY when the element
# type is not itself a list. For `darray[darray[i64]]` stage1 split `push([])` into zero
# pushes (a silently wrong count) and declined `push([7])`; the literal is ONE element.
def main() -> i64:
    rows: mutable darray[darray[i64]] = []
    rows.push([])
    rows.push([7])
    rows.push([1, 2, 3])
    return 1 if rows.count != 3
    return 2 if rows[0].count != 0
    return 3 if rows[1][0] != 7
    return 4 if rows[2].count != 3 or rows[2][2] != 3
    flat: mutable darray[i64] = []
    flat.push([4, 5])
    return 5 if flat.count != 2 or flat[1] != 5
    return 0
