# A parent array holds -1 for "no parent" or a node below the count, so a
# walk whose index passed its bounds check reads below the count, inside the
# prefix the -1 loop wrote: the array's zero fill is dead (the sentinel
# bound in ElisaIndexBounds). The walks must still see every stored parent.
@inline(never)
def depth_of(edges: i64&, count: usize, start: usize) -> i64:
    return -1 if count < 2 or count > 64 or start >= count
    parent: mutable i64[64] = zeroed
    for node in 0..<count |parent|:
        parent[node] <- -1
    for node in 1..<count |edges, parent|:
        above: i64 = edges[node]
        return -1 if above < 0 or above >= i64(node)
        parent[node] <- above
    depth: mutable i64 = 0
    current: mutable usize = start
    while current != 0 |current, parent, depth|:
        current <- usize(parent[current])
        depth <- depth + 1
    depth

def main() -> i32:
    edges: mutable i64[8] = zeroed
    edges[1] <- 0
    edges[2] <- 1
    edges[3] <- 1
    edges[4] <- 3
    edges[5] <- 4
    edges[6] <- 0
    edges[7] <- 6
    return 10 if depth_of(&edges[0], 8, 0) != 0
    return 11 if depth_of(&edges[0], 8, 5) != 4
    return 12 if depth_of(&edges[0], 8, 7) != 2
    return 13 if depth_of(&edges[0], 8, 2) != 2
    return 14 if depth_of(&edges[0], 9, 2) != -1
    edges[4] <- 9
    return 15 if depth_of(&edges[0], 8, 5) != -1
    0
