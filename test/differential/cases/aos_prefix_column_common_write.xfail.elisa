# KNOWN DIVERGENCE, and stage0 is the one that is wrong.
#
# A MUTABLE `@storage(inline)` common that falls inside the store's PREFIX WINDOW
# is written to one place and read from another, so an assignment after
# construction is invisible.
#
# The constructor allocates a row, fills it, and calls
# `ctx_packed_store_record_prefix_words`, which COPIES the first `prefix_words`
# words of that row out into parallel column arrays. A later `leaf.wide <- v`
# stores straight into the row through a decoded pointer and never touches the
# columns. `ctx_packed_store_read_index_word` then serves any word below
# `prefix_words` from the column, so the read still answers the value the
# CONSTRUCTOR stored.
#
# It needs the read to take the word path rather than a row GEP, which is what
# the branch between the write and the read below arranges -- a read in the same
# block reuses the decoded row pointer and happens to answer correctly. Here
# prefix_words is 3 and `wide` sits at word 2, inside the window.
#
# stage1 answers 0. Fixing this means either re-recording the prefix words after
# a common write, or not serving mutable commons from the columns at all; that is
# an ABI decision, so it is recorded rather than guessed at.
@packed_profile(build_heavy)
enum Widget:
    common:
        @storage(inline)
        tag: mutable i32
        @storage(inline)
        x: mutable f32
        @storage(inline)
        wide: mutable f64
    pass

enum Control is Widget:
    Label(size: f32, next_sibling: Widget?)

def label(size: f32) -> Widget can[Memory.Allocate, Abort.Panic]:
    return Control.Label(tag: 3, x: 7.0, wide: 2.5, size: size, next_sibling: null)

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        region ui(65536):
            leaf: Widget = label(14.0)
            leaf.x <- 0.5
            leaf.wide <- -1.25
            leaf.tag <- 9
            return 1 if leaf.x != 0.5
            return 2 if leaf.wide != -1.25
            return 3 if leaf.tag != 9
            return 0
