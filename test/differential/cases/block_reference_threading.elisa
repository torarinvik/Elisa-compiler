# A large mutable value stays behind its reference when a block yields that reference.
# The function body must move only the pointer through the block, not load/store the
# 2 KiB aggregate itself.
struct LargeState:
    buffer: i64[256]
    generation: mutable i64

def forward(state: mutable LargeState&) -> mutable LargeState&:
    forwarded: mutable LargeState& =
        scope_marker: i64 = 1
        state
    return forwarded

def main() -> i64:
    state: mutable LargeState = zeroed
    forwarded: mutable LargeState& = forward(&state)
    forwarded.generation <- 41
    return 1 if state.generation != 41
    return 0
