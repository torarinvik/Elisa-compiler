# Mixed-width multi-field payloads read back through a statement `match` under the
# variant-sparse profile.
#
# The constructor stores the payload as ONE aggregate (natural LLVM layout) at the row's
# payload offset. The statement-match reader used to map field `i` to payload word `i`
# (or `i/2` when every field was 32-bit), so `A(p: i64, q: i32, r: i32)` read `r` from a
# word nothing wrote: stage0 returned 0, stage1 returned 1, silently, at -O0 and -O2.
# The reader now loads the same aggregate and extracts, so every field mix -- bytes,
# shorts around an i64, bool/i32/f64 -- round-trips.
#
# Keep this unit NON-recursive: a recursive enum used to switch the whole unit to the AoS
# profile, which reads the aggregate correctly and hid the bug (the first version of this
# fixture passed on the broken compiler).

packed enum E:
    A(p: i64, q: i32, r: i32)
    B(s: u8, t: u8, u: i64)

def f(e: E, store: E.Store[Local]) -> i64:
    match e in store:
        E.A(p, q, r):
            return p * 10000 + q.i64() * 100 + r.i64()
        E.B(s, t, u):
            return s.i64() * 10000 + t.i64() * 100 + u
    return -1

packed enum T:
    Bytes(a: u8, b: u8, c: u8)
    Shorts(a: u16, b: i64, c: u16)
    Flag(on: bool, n: i32, x: f64)
    Last(a: i32, b: i32, c: i32)

def val(n: T, store: T.Store[Local]) -> i64:
    match n in store:
        T.Bytes(a, b, c):
            return a.i64() * 10000 + b.i64() * 100 + c.i64()
        T.Shorts(a, b, c):
            return a.i64() * 10000 + b * 100 + c.i64()
        T.Flag(on, n2, x):
            base: i64 = 1000 if on else 0
            return base + n2.i64() + x.i64()
        T.Last(a, b, c):
            return a.i64() * 10000 + b.i64() * 100 + c.i64()
    return -1

def build(owner: Arena) -> i64 can[Memory.Allocate, Abort.Panic]:
    es: E.Store[Local] = E.Store(owner)
    a: E = E.A(p: 7, q: 5, r: 3)
    b: E = E.B(s: 9, t: 4, u: 2)
    return 1 if f(a, es) != 70503
    return 2 if f(b, es) != 90402
    store: T.Store[Local] = T.Store(owner)
    x1: T = T.Bytes(a: 1, b: 2, c: 3)
    x2: T = T.Shorts(a: 4, b: 5, c: 6)
    x3: T = T.Flag(on: true, n: 7, x: 8.0)
    x5: T = T.Last(a: 9, b: 10, c: 11)
    return 11 if val(x1, store) != 10203
    return 12 if val(x2, store) != 40506
    return 13 if val(x3, store) != 1015
    return 14 if val(x5, store) != 91011
    return 0

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        region r(65536):
            return build(r)
    return 99
