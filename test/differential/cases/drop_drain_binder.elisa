# A `for x in move xs` drain moves each element into the binder, which then owns it
# for one iteration: an unconsumed binder is dropped at the iteration's end, a moved
# one is dropped by its new owner. Every element is dropped exactly once.
global mutable drops: i64 = 0

struct Tracked:
    mark: i64

def __drop__(self: Tracked) -> void:
    drops <- drops + 1

def sink(t: Tracked) -> void:
    _ = t.mark

# Body never consumes the binder: two drops at iteration ends.
def unconsumed() -> void:
    xs: mutable darray[Tracked] = []
    xs.push(Tracked{mark: 1})
    xs.push(Tracked{mark: 2})
    for x in move xs:
        pass

# Conditional move: mark 2 goes to sink, the others drop at iteration end.
def conditional() -> void:
    xs: mutable darray[Tracked] = []
    xs.push(Tracked{mark: 1})
    xs.push(Tracked{mark: 2})
    xs.push(Tracked{mark: 3})
    for x in rev(move xs):
        if x.mark == 2:
            sink(move x)

# Filtered drain: mark 2 is filtered out and dropped by the loop, the rest go to sink.
def filtered() -> void:
    xs: mutable darray[Tracked] = []
    xs.push(Tracked{mark: 1})
    xs.push(Tracked{mark: 2})
    xs.push(Tracked{mark: 3})
    for x in move xs if x.mark != 2:
        sink(move x)

def main() -> i64:
    unconsumed()
    conditional()
    filtered()
    if drops != 8:
        return 10 + drops
    return 0
