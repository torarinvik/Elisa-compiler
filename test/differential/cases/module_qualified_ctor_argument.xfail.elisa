# A module-qualified enum constructor written INLINE as the argument of a
# module-qualified call (`Core::push(Core::Command.Line(1.0, 2.0))`), in a
# program where ANOTHER module also matches over that enum. stage0 runs it;
# stage1's backend declines the call. Bound to a local first, or without the
# second module, the same call compiles. The backend has no decline trace
# (ELISA_STAGE1_DEBUG segfaults), so the cause is still open.
module Core:
    public:
        struct Color:
            r: u8
        enum Command:
            Clear(color: Color)
            Line(ax: f32, bx: f32)
    private:
        global mutable buffer: Command[4] = zeroed
        global mutable total: usize = 0
    public:
        def push(c: Command) -> void:
            buffer[total] <- c
            total <- total + 1
        def count() -> usize:
            return total
        def at(index: usize) -> Command:
            return buffer[index]

module Backend:
    public:
        def replay() -> i64:
            sum: mutable i64 = 0
            for index in 0..<Core::count():
                match Core::at(index):
                    Core::Command.Clear(color):
                        sum <- sum + color.r.i64()
                    Core::Command.Line(ax, bx):
                        sum <- sum + 100
            return sum

def main() -> i64:
    Core::push(Core::Command.Clear(Core::Color{r: 5}))
    Core::push(Core::Command.Line(1.0, 2.0))
    return 1 if Backend::replay() != 105
    return 0
