# Two rules a sealed hierarchy needs to model an event kind:
#
#  1. WIDENING IS FREE (docs/77), so `when`/`match` EXPRESSION arms naming
#     different refinements of one hierarchy unify at their lowest common
#     ancestor -- `MouseEvent.Move` and `Event.Quit` yield `Event`.
#  2. A `__cast__` hook works in BOTH directions and in both spellings: the
#     postfix `x.T()` and the prefix `T(x)`. The prefix form on a non-struct
#     target used to report "type Event is not a struct" because the parser
#     reads any `Name(arg)` as a struct literal.
#
# The hook is EXACT, so an untyped literal needs `5.i32()` first; that is the
# documented rule, not a gap, and it is pinned here too.
enum Event:
    None
    Quit

enum InputEvent is Event:
    pass

enum MouseEvent is InputEvent:
    Move
    Down

def __cast__(event: Event) -> i32:
    return when event:
        Event.None -> 0
        Event.Quit -> 1
        MouseEvent.Move -> 2
        MouseEvent.Down -> 3

def __cast__(code: i32) -> Event:
    return when code:
        1 -> Event.Quit
        2 -> MouseEvent.Move
        3 -> MouseEvent.Down
        _ -> Event.None

struct Frame:
    kind: mutable Event
    x: mutable f32

def main() -> i64:
    typed: i32 = 2
    # postfix and prefix spellings of the same hook
    lifted: Event = typed.Event()
    return 1 if lifted.i32() != 2
    prefixed: Event = Event(typed)
    return 2 if prefixed.i32() != 2
    # an untyped literal takes the documented `5.i32()` step first
    literal: Event = 5.i32().Event()
    return 3 if literal.i32() != 0
    # a hierarchy value as a struct field, written and read back
    frame: mutable Frame = Frame{kind: lifted, x: 1.5}
    return 4 if frame.kind.i32() != 2
    frame.kind <- Event.Quit
    return 5 if frame.kind.i32() != 1
    return 0
