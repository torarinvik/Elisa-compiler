def measure(input_count: i64) -> i64:
    work_buffer: mutable darray[i64] = []
    for item_index in 0..<input_count |work_buffer|:
        work_buffer.push(item_index + 1)
    subtotal: mutable i64 = 0
    for item in work_buffer |subtotal|:
        subtotal <- subtotal + item
    return subtotal

def main() -> i64:
    total: mutable i64 = 0
    for round in 0..<100 |total|:
        measured: i64 = measure(1000 + round % 4)
        total <- total + measured
    return 0 if total == 50200250 else 1
