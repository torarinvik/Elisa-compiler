# docs/119 §4.1: a diverging branch or arm (`return`, `raise`, `panic`) unifies with any
# value type — it never reaches the join, so it contributes nothing to the result.
error Bad:
    Neg
    Zero

def if_else_return(n: i64) -> i64:
    v: i64 =
        if n > 0:
            n * 2
        else:
            return -1
    return v + 1

def elif_return(n: i64) -> i64:
    v: i64 =
        k: i64 = n + 1
        if k > 3:
            k * 2
        elif k == 0:
            return 99
        else:
            k
    return v

def match_arm_return(n: i64) -> i64:
    w: i64 =
        match n:
            0:
                return 7
            _:
                n + 3
    return w

def nested_all_diverge(n: i64) -> i64:
    v: i64 =
        if n > 10:
            n
        else:
            if n < 0:
                return 1
            else:
                return 2
    return v

def assign_diverge(n: i64) -> i64:
    v: mutable i64 = 0
    v <-
        if n > 0:
            n + 1
        else:
            return 0
    w =
        if v > 5:
            v
        else:
            return 1
    return w

def return_value_diverge(n: i64) -> i64:
    return
        if n > 0:
            n
        else:
            return 2

def raise_tail(n: i64) -> i64 error[Bad]:
    v: i64 =
        if n > 0:
            n * 2
        else:
            raise Bad.Neg
    return v + 1

def raise_match_arm(n: i64) -> i64 error[Bad]:
    v: i64 =
        match n:
            0:
                raise Bad.Zero
            _:
                n + 1
    return v

def raise_inline_else(n: i64) -> i64 error[Bad]:
    v: i64 = n * 2 if n > 0 else raise Bad.Neg
    return v + 1

def raise_inline_then(n: i64) -> i64 error[Bad]:
    v: i64 = raise Bad.Neg if n < 0 else n + 2
    return v

def panic_tail(n: i64) -> i64:
    v: i64 =
        if n > 0:
            n + 2
        else:
            panic("unreachable in this test")
    return v

def main() -> i64:
    can Abort.Panic:
        return 1 if if_else_return(5) != 11
        return 2 if if_else_return(-3) != -1
        return 3 if elif_return(5) != 12 or elif_return(-1) != 99 or elif_return(1) != 2
        return 4 if match_arm_return(0) != 7 or match_arm_return(4) != 7
        return 5 if nested_all_diverge(39) != 39 or nested_all_diverge(-5) != 1 or nested_all_diverge(5) != 2
        return 6 if assign_diverge(40) != 41 or assign_diverge(-1) != 0 or assign_diverge(2) != 1
        return 7 if return_value_diverge(40) != 40 or return_value_diverge(-1) != 2
        a: i64 = try raise_tail(20) else 0
        b: i64 = try raise_tail(-1) else 5
        return 8 if a != 41 or b != 5
        c: i64 = try raise_match_arm(40) else 0
        d: i64 = try raise_match_arm(0) else 6
        return 9 if c != 41 or d != 6
        e: i64 = try raise_inline_else(20) else 0
        f: i64 = try raise_inline_else(-1) else 8
        return 10 if e != 41 or f != 8
        g: i64 = try raise_inline_then(40) else 0
        h: i64 = try raise_inline_then(-1) else 9
        return 11 if g != 42 or h != 9
        return 12 if panic_tail(40) != 42
        return 0
