# A proof for one overload must not be reused for another call target.
def first(xs: darray[i64]&) -> i64:
    return xs[0]
def first(xs: darray[i32]&) -> i64:
    return 99
def main() -> i64:
    total: mutable i64 = 0
    for i in 0..<4 |total|:
        xs: mutable darray[i64] = []
        xs.push(i)
        total <- total + first(&xs)
    return 0 if total == 6 else 1
