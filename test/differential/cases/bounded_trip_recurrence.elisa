# A second-order recurrence over validated inputs in a loop of at most 30
# trips (`2 * current - previous + a`), the shape ElisaBoundedTripRanges
# proves free of overflow by iterating interval ranges once per possible
# trip. The values must stay exact at the largest inputs the guards admit,
# and an input outside them must still be rejected.
@inline(never)
def stormer_last(input: i64&, length: usize) -> i64:
    return -1 if length < 3
    count64: i64 = input[0]
    return -1 if count64 < 2
    return -1 if count64 > 32
    count: usize = count64.usize()
    return -1 if length != count + 1
    return -1 if input[1] < -1024
    return -1 if input[1] > 1024
    return -1 if input[2] < -1024
    return -1 if input[2] > 1024
    step: mutable usize = 0
    while step < count - 2:
        return -1 if input[3 + step] < -64
        return -1 if input[3 + step] > 64
        step <- step + 1
    previous: mutable i64 = input[1]
    current: mutable i64 = input[2]
    index: mutable usize = 2
    while index < count:
        next: i64 = 2 * current - previous + input[index + 1]
        previous <- current
        current <- next
        index <- index + 1
    current

def main() -> i32:
    input: mutable i64[33] = zeroed
    input[0] <- 32
    input[1] <- -1024
    input[2] <- 1024
    i: mutable usize = 3
    while i < 33:
        input[i] <- 64
        i <- i + 1
    previous: mutable i64 = -1024
    current: mutable i64 = 1024
    k: mutable usize = 2
    while k < 32:
        next: i64 = 2 * current - previous + 64
        previous <- current
        current <- next
        k <- k + 1
    return 10 if stormer_last(&input[0], 33) != current
    input[5] <- 65
    return 11 if stormer_last(&input[0], 33) != -1
    0
