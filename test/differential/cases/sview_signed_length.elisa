# Direct len access preserves the signed field, and bracket reads keep the
# runtime's zero fallback for malformed/empty views.
struct StringView:
    data: u8&
    len: i64

def main() -> i64:
    text: sview = "AB"
    return 1 if text.len != 2
    empty: sview = ""
    return 2 if empty.len != 0 or empty[0] != 0
    trusted Unsafe.PointerCast:
        negative: sview = StringView{data: text.data, len: -1}
        return 3 if negative.len != -1
        return 4 if negative[0] != 0 or negative[-1] != 0
    return 5 if text[0] != 65 or text[1] != 66
    return 6 if text[2] != 0 or text[-1] != 0
    return 0
