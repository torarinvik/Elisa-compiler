# `place with { field <- value ... }` assigns several fields of one place. The
# place is evaluated once, fields are assigned in written order, and a bare
# field name puns to the local of the same name -- in `with` blocks and in
# struct literals alike. Each return code names the assertion that moved.
global mutable evaluations: i64 = 0
struct Widget:
    kind: mutable i64
    parent: mutable i64
    x: mutable f32
    hovered: mutable bool
global mutable widgets: array[Widget, 4]
def slot(index: usize) -> usize:
    evaluations <- evaluations + 1
    return index
def main() -> i64:
    kind: i64 = 7
    parent: i64 = 3
    widgets[slot(2)] with Widget{
        kind <- kind
        parent <- 1
        x <- 2.5
        hovered <- true
    }
    return 1 if evaluations != 1
    return 2 if widgets[2].kind != 7 or widgets[2].parent != 1 or widgets[2].hovered != true
    # Untyped form with punning.
    widgets[1] with { kind, parent, hovered <- false }
    return 3 if widgets[1].kind != 7 or widgets[1].parent != 3 or widgets[1].hovered != false
    # Struct-literal punning, whole-record reset.
    widgets[0] <- Widget{ kind, parent, x: 1.0, hovered: true }
    return 4 if widgets[0].kind != 7 or widgets[0].parent != 3 or widgets[0].x != 1.0
    return 0
