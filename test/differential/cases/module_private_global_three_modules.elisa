# Three modules; scalar, array and STRUCT globals under one name; different sizes and
# element types per module.
struct Box:
    x: mutable i64
    y: mutable i64

module A:
    private:
        global mutable counter: i64 = 11
        global mutable values: i64[3] = [1, 2, 3]
        global mutable box: Box = Box{x: 1, y: 2}
    public:
        def read() -> i64:
            return counter + values[2] + box.y
        def poke() -> void:
            counter <- counter + 1
            values[2] <- values[2] + 10
            box.y <- box.y + 100

module B:
    private:
        global mutable counter: i32 = 73
        global mutable values: i32[5] = [7, 8, 9, 10, 11]
        global mutable box: Box = Box{x: 5, y: 6}
    public:
        def read() -> i64:
            return counter.i64() + values[4].i64() + box.y
        def poke() -> void:
            counter <- counter + 1
            values[4] <- values[4] + 10
            box.y <- box.y + 100

module C:
    private:
        global mutable counter: i64 = 1000
        global mutable values: i64[2] = [20, 30]
        global mutable box: Box = Box{x: 9, y: 9}
    public:
        def read() -> i64:
            return counter + values[1] + box.y
        def poke() -> void:
            counter <- counter + 1
            values[1] <- values[1] + 10
            box.y <- box.y + 100

def main() -> i64:
    return 1 if A::read() != 11 + 3 + 2
    return 2 if B::read() != 73 + 11 + 6
    return 3 if C::read() != 1000 + 30 + 9
    B::poke()
    return 4 if A::read() != 16
    return 5 if B::read() != 90 + 111
    return 6 if C::read() != 1039
    A::poke()
    C::poke()
    return 7 if A::read() != 127
    return 8 if B::read() != 201
    return 9 if C::read() != 1150
    return 0
