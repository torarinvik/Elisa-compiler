# A protocol method may share a name with a BUILTIN collection method.
#
# stage0's builtin chain in analyzeCallExpr keys on the field NAME alone -- push,
# clear, reserve, rows, truncate, valid, and the dict/set insert rewrite -- with no
# check that the receiver is a collection. So `S.clear(...)` on a protocol-bound type
# parameter was claimed by the builtin path, which then evaluated S as a VALUE and
# reported `undefined identifier "S"`: a name plainly in scope, and an error naming
# the wrong thing entirely. stage1 always dispatched these correctly.
#
# This matters for any protocol built on a collection-shaped vocabulary -- a drawing
# Surface wants `clear`, a command buffer wants `push`, a control tree wants `insert`.
#
# The case also pins the half that must NOT change: a real collection receiver keeps
# the builtin meaning, in the same function whose type parameter is bound to a
# protocol declaring the same names.

global mutable witness: int = 0

struct Painter:
    tag: int

protocol Surface:
    def clear(value: int) -> void
    def push(value: int) -> void
    def insert(value: int) -> void

impl Surface for Painter:
    def clear(value: int) -> void:
        witness <- witness + value

    def push(value: int) -> void:
        witness <- witness + value * 10

    def insert(value: int) -> void:
        witness <- witness + value * 100

def drive[S: Surface]() -> int:
    # Protocol dispatch on every colliding name.
    S.clear(7)
    S.push(3)
    S.insert(2)

    # ...and a REAL collection receiver in the same function still means the builtin.
    xs: mutable darray[int] = []
    xs.push(1)
    xs.push(2)
    xs.push(3)
    counted: int = xs.count.int()
    xs.clear()
    return counted + xs.count.int()

def main() -> i32:
    produced: int = drive[Painter]()
    # 7 + 30 + 200 = 237 from the protocol impls.
    return 1 if witness != 237 else 0 if produced == 3 else 2
