# Region reset must follow user defers, including continue/break/return edges.
global mutable observed: i64 = 0

def early_return(flag: bool) -> i64:
    for i in 0..<4:
        region scratch:
            xs: mutable darray[i64] = []
            xs.push(i + 10)
            defer block:
                observed <- observed + xs[0]
            if flag:
                return xs[0]
    return 0

def fallthrough() -> void:
    for i in 0..<2:
        region scratch:
            xs: mutable darray[i64] = []
            xs.push(i)

def main() -> i64:
    for i in 0..<5:
        region scratch:
            xs: mutable darray[i64] = []
            xs.push(i + 1)
            defer block:
                observed <- observed + xs[0]
            continue if i == 0
            break if i == 2
    return 1 if observed != 6
    return 2 if early_return(true) != 10
    return 3 if observed != 16
    return 4 if early_return(false) != 0
    return 5 if observed != 62
    # A skipped loop/branch must leave a valid empty carrier for function cleanup.
    for i in 0..<0:
        region skipped:
            xs: mutable darray[i64] = []
            xs.push(i)
    fallthrough()
    region outer:
        for i in 0..<2:
            region inner:
                xs: mutable darray[i64] = []
                xs.push(i)
                for j in 0..<2:
                    region nested:
                        ys: mutable darray[i64] = []
                        ys.push(j)
                        observed <- observed + xs[0] + ys[0]
    return 6 if observed != 66
    defer block:
        for i in 0..<2:
            region deferred:
                zs: mutable darray[i64] = []
                zs.push(i)
    return 0
