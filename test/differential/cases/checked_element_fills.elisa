# Range bounds stored first and validated afterwards (`right[k] <- input;
# return -1 if right[k] > n`) bound every value the array holds: each path
# from the store returns or decides the value at most n before reading the
# array again (ElisaElementBounds). Reads of a zero-filled array written
# over [0, n) at indices below such a bound read only written elements, so
# its fill is dead. The negatives validate against n + 1 and must see the
# fill's zero at element n, so their fill stays.
const CAPACITY: usize = 64

@inline(never)
def range_sums(input: view[i64]) -> i64:
    return -1 if input.len < 2
    n64: i64 = input[0]
    q64: i64 = input[1]
    return -1 if n64 < 1 or n64 > 32 or q64 < 1 or q64 > 8
    n: usize = n64.usize()
    q: usize = q64.usize()
    return -1 if input.len != 2 + n + 2 * q
    values: mutable i64[64] = zeroed
    left: mutable i64[8] = zeroed
    right: mutable i64[8] = zeroed
    i: mutable usize = 0
    while i < n:
        values[i] <- input[2 + i] + 100
        i <- i + 1
    k: mutable usize = 0
    while k < q:
        left[k] <- input[2 + n + 2 * k]
        right[k] <- input[3 + n + 2 * k]
        if left[k] < 0 or left[k] > right[k] or right[k] > n64:
            return -1
        k <- k + 1
    total: mutable i64 = 0
    k <- 0
    while k < q:
        i <- left[k].usize()
        while i < right[k].usize():
            total <- total * 7 % 1000003 + values[i]
            i <- i + 1
        k <- k + 1
    total

@inline(never)
def range_sums_past(input: view[i64]) -> i64:
    return -1 if input.len < 2
    n64: i64 = input[0]
    q64: i64 = input[1]
    return -1 if n64 < 1 or n64 > 32 or q64 < 1 or q64 > 8
    n: usize = n64.usize()
    q: usize = q64.usize()
    return -1 if input.len != 2 + n + 2 * q
    values: mutable i64[64] = zeroed
    left: mutable i64[8] = zeroed
    right: mutable i64[8] = zeroed
    i: mutable usize = 0
    while i < n:
        values[i] <- input[2 + i] + 100
        i <- i + 1
    k: mutable usize = 0
    while k < q:
        left[k] <- input[2 + n + 2 * k]
        right[k] <- input[3 + n + 2 * k]
        if left[k] < 0 or left[k] > right[k] or right[k] > n64 + 1:
            return -1
        k <- k + 1
    total: mutable i64 = 0
    k <- 0
    while k < q:
        i <- left[k].usize()
        while i < right[k].usize():
            total <- total * 7 % 1000003 + values[i]
            i <- i + 1
        k <- k + 1
    total

def main() -> i32:
    input: mutable i64[64] = zeroed
    n: usize = 9
    input[0] <- 9
    input[1] <- 3
    i: mutable usize = 0
    while i < n:
        input[2 + i] <- (i * 5 % 11).i64()
        i <- i + 1
    input[11] <- 0
    input[12] <- 9
    input[13] <- 2
    input[14] <- 5
    input[15] <- 4
    input[16] <- 4
    expected: mutable i64 = 0
    i <- 0
    while i < 9:
        expected <- expected * 7 % 1000003 + (i * 5 % 11).i64() + 100
        i <- i + 1
    i <- 2
    while i < 5:
        expected <- expected * 7 % 1000003 + (i * 5 % 11).i64() + 100
        i <- i + 1
    return 10 if range_sums(input[0:17]) != expected
    # One past n: the read at element 9 sees the fill's zero.
    input[12] <- 10
    expected2: mutable i64 = 0
    i <- 0
    while i < 10:
        value: i64 = (i * 5 % 11).i64() + 100 if i < 9 else 0
        expected2 <- expected2 * 7 % 1000003 + value
        i <- i + 1
    i <- 2
    while i < 5:
        expected2 <- expected2 * 7 % 1000003 + (i * 5 % 11).i64() + 100
        i <- i + 1
    return 11 if range_sums(input[0:17]) != -1
    return 12 if range_sums_past(input[0:17]) != expected2
    0
