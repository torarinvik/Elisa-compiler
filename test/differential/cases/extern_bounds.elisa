# `@bounds(ptr, len)` binds a legacy C prototype's pointer and length into one bounded view
# (docs/127 §3.3): the caller passes `view[u8]`, the compiler supplies the length in the C
# position the prototype declares. Exit 0 on both compilers.
@callconv(c)
@bounds(text, cap)
extern strnlen(text: u8&, cap: usize) -> usize

def main() -> i64:
    t: mutable darray[u8] = []
    t.push(104)
    t.push(105)
    t.push(10)
    t.push(0)
    bounded: usize = strnlen(t[0:2])
    unbounded: usize = strnlen(t[0:4])
    return bounded.i64() * 10 + unbounded.i64() - 23
