# An explicit module qualifier must keep its owner when another module has a
# same-named error-returning function. Otherwise the local-initializer lowering
# strips `Application::` and mistakes the ordinary enum-returning call for the
# unrelated fallible `RenderScene::initialize`.
module Application:
    public:
        enum InitializeStatus:
            Ready
            Failed

        def initialize() -> InitializeStatus:
            InitializeStatus.Ready

module RenderScene:
    public:
        error RenderSceneError:
            InvalidValue

        def initialize() -> void error[RenderSceneError]:
            return

def main() -> i32:
    status: Application::InitializeStatus = Application::initialize()
    caught: i32 = catch RenderScene::initialize():
        ok: 0
        RenderScene::RenderSceneError.InvalidValue: 1
        error failure: 2
    return 1 if status != Application::InitializeStatus.Ready or caught != 0
    0
