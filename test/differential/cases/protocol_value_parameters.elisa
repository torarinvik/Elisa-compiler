# Protocol annotations infer independent concrete receiver types.
protocol Painter:
    def paint(self: Self) -> i32
    def clear(self: Self, color: i32) -> void
struct Red:
    value: i32
struct Blue:
    value: i32
impl Painter for Red:
    def clear(self: Self, color: i32) -> void:
        pass
    def paint(self: Self) -> i32:
        return self.value
impl Painter for Blue:
    def clear(self: Self, color: i32) -> void:
        pass
    def paint(self: Self) -> i32:
        return self.value * 2
def draw(painter: Painter) -> i32:
    painter.clear(0)
    return painter.paint()
def pair(left: Painter, right: Painter) -> i32:
    return left.paint() + right.paint()
def explicit[P: Painter](painter: P) -> i32:
    return draw(painter)
def main() -> i32:
    a: Red = Red{value: 17}
    b: Red = Red{value: 25}
    c: Blue = Blue{value: 6}
    return 1 if draw(a) != 17 else 0 if draw(b) == 25 and pair(a, c) == 29 and explicit(b) == 25 else 2
