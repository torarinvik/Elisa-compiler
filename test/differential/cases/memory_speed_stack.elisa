def sum_small(seed: i64) -> i64:
    small: darray[i64] = [seed, seed + 1, seed + 2, seed + 3]
    sum: mutable i64 = 0
    for entry in small |sum|:
        sum <- sum + entry
    return sum

def main() -> i64:
    surviving: darray[i64] = [41, 42]
    for turn in 0..<10000:
        return 1 if sum_small(turn) != turn * 4 + 6
    return 0 if surviving[0] == 41 and surviving[1] == 42 else 2
