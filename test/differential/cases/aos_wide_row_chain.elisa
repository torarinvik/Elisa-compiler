# A 15-common (wide-row) AoS store must keep every node of a 20k chain. About
# half of them vanished -- next_sibling links corrupted mid-chain -- while every
# user program's store was created at the AST's fixed 132-byte stride (the
# reserved `Node` header made the AST branch fire for user roots too); rows past
# 132 bytes overran their neighbours. The stride is now the widest member row.

# Variant B: geometry lives in the node's own row as mutable commons.
enum Widget:
    common:
        @storage(inline)
        x: mutable f32
        @storage(inline)
        y: mutable f32
        @storage(inline)
        w: mutable f32
        @storage(inline)
        h: mutable f32
        @storage(inline)
        min_w: mutable f32
        @storage(inline)
        min_h: mutable f32
        @storage(inline)
        grow: mutable f32
        @storage(inline)
        pad0: mutable f32
        @storage(inline)
        pad1: mutable f32
        @storage(inline)
        pad2: mutable f32
        @storage(inline)
        pad3: mutable f32
        @storage(inline)
        pad4: mutable f32
        @storage(inline)
        pad5: mutable f32
        @storage(inline)
        pad6: mutable f32
        @storage(inline)
        pad7: mutable f32
    pass

enum Container is Widget:
    Box(axis: i32, spacing: f32, first_child: Widget?, next_sibling: Widget?)

enum Control is Widget:
    Label(size: f32, next_sibling: Widget?)

def next_of(node: Widget) -> Widget?:
    match node:
        Container.Box(axis, spacing, first_child, next_sibling):
            return next_sibling
        Control.Label(size, next_sibling):
            return next_sibling

def child_of(node: Widget) -> Widget?:
    match node:
        Container.Box(axis, spacing, first_child, next_sibling):
            return first_child
        Control.Label(size, next_sibling):
            return null

# Bottom-up measure: a leaf reports its own minimum, a box sums its children.
def measure(node: Widget) -> void:
    child: mutable Widget? = child_of(node)
    total: mutable f32 = 0.0
    widest: mutable f32 = 0.0
    while child is c:
        measure(c)
        total <- total + c.min_h
        widest <- c.min_w if c.min_w > widest else widest
        child <- next_of(c)
    if widest > 0.0:
        node.min_w <- widest
        node.min_h <- total

# Top-down arrange: hand each child its box.
def arrange(node: Widget, at_x: f32, at_y: f32, avail_w: f32) -> void:
    node.x <- at_x
    node.y <- at_y
    node.w <- avail_w
    cursor: mutable f32 = at_y
    child: mutable Widget? = child_of(node)
    while child is c:
        arrange(c, at_x, cursor, avail_w)
        cursor <- cursor + c.min_h
        child <- next_of(c)
    node.h <- cursor - at_y

# Hit test: the pass that reads geometry back.
def hit(node: Widget, px: f32, py: f32) -> i32:
    found: mutable i32 = 0
    if px >= node.x and px < node.x + node.w and py >= node.y and py < node.y + node.h:
        found <- 1
    child: mutable Widget? = child_of(node)
    while child is c:
        found <- found + hit(c, px, py)
        child <- next_of(c)
    return found

def make_label(size: f32, next: Widget?) -> Widget can[Memory.Allocate, Abort.Panic]:
    return Control.Label(x: 0.0, y: 0.0, w: 0.0, h: 0.0, min_w: size * 4.0, min_h: size, grow: 0.0, pad0: 0.0, pad1: 0.0, pad2: 0.0, pad3: 0.0, pad4: 0.0, pad5: 0.0, pad6: 0.0, pad7: 0.0, size: size, next_sibling: next)

def make_box(first: Widget?, next: Widget?) -> Widget can[Memory.Allocate, Abort.Panic]:
    return Container.Box(x: 0.0, y: 0.0, w: 0.0, h: 0.0, min_w: 0.0, min_h: 0.0, grow: 1.0, pad0: 0.0, pad1: 0.0, pad2: 0.0, pad3: 0.0, pad4: 0.0, pad5: 0.0, pad6: 0.0, pad7: 0.0, axis: 0, spacing: 2.0, first_child: first, next_sibling: next)

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        region ui(67108864):
            want: i64 = 20000
            chain: mutable Widget? = null
            for i in 0..<20000 |chain|:
                chain <- make_label(12.0, chain)
            got: mutable i64 = 0
            cur: mutable Widget? = chain
            while cur is c:
                got <- got + 1
                cur <- next_of(c)
            # 0 when every node is still linked; otherwise how many thousand survived
            return 0 if got == want
            return 1 + got / 1000
