# A struct literal evaluates its field initializers in the order they are
# WRITTEN, not the order the fields are declared. stage0 used declared order and
# stage1 written order, which made the compiler's own `Runtime{...}` literal
# declare runtime symbols in a generation-dependent order and broke the gen3
# fixpoint. Both return 0 when the written order (2 then 1 -> 21) is observed.
global mutable trace: i64 = 0
def mark(step: i64) -> i64:
    trace <- trace * 10 + step
    return step
struct Pair:
    first: i64
    second: i64
struct Triple:
    a: i64
    b: i64
    c: i64
def main() -> i64:
    p: Pair = Pair{second: mark(2), first: mark(1)}
    return 1 if trace != 21
    return 2 if p.first != 1 or p.second != 2
    trace <- 0
    t: Triple = Triple{c: mark(3), a: mark(1), b: mark(2)}
    return 3 if trace != 312
    return 4 if t.a != 1 or t.b != 2 or t.c != 3
    return 0
