# `^NAME` in a scalar match compares against the pinned name's VALUE instead of
# binding it. Only a LOCAL resolved: all three match emitters looked the name up
# with lookup_slot alone, so a pin over a module-level `const` declined outright
# in stage1 while stage0 compiled and ran it. elisa-ui's wire decoder is the
# motivating case -- `match record.kind: ^WIRE_QUIT:` over `const WIRE_*: i32`,
# named so the ordinal mapping is stated exactly once.
#
# Covers all three emitters (statement match, value match, and a pin inside a
# condition) in BOTH resolutions -- const and local -- because the fix routes the
# local half through the same new helper and must not regress it.

const WIRE_QUIT: i32 = 1
const WIRE_RESIZE: i32 = 8
const WIRE_SCROLL: i32 = 9

# Statement form, const pin.
def classify_stmt(kind: i32) -> i32:
    match kind:
        ^WIRE_QUIT:
            return 100
        ^WIRE_RESIZE:
            return 108
        _:
            return 0

# Value form, const pin -- mixed with a literal arm to prove the two coexist.
def classify_value(kind: i32) -> i32:
    return match kind:
        ^WIRE_QUIT:
            200
        ^WIRE_SCROLL:
            209
        3:
            203
        _:
            0

# The LOCAL resolution the fix must not regress: the pinned name is a parameter,
# so the arm compares against a runtime value, not a folded constant.
def matches_local(kind: i32, target: i32) -> i32:
    match kind:
        ^target:
            return 1
        _:
            return 0

def main() -> i32:
    if classify_stmt(1) != 100:
        return 1
    if classify_stmt(8) != 108:
        return 2
    if classify_stmt(5) != 0:
        return 3
    if classify_value(1) != 200:
        return 4
    if classify_value(9) != 209:
        return 5
    if classify_value(3) != 203:
        return 6
    if classify_value(7) != 0:
        return 7
    if matches_local(4, 4) != 1:
        return 8
    if matches_local(4, 5) != 0:
        return 9
    return 0
