# Metadata is copied by value; it does not retain a reference to container backing.
def main() -> i64:
    count: mutable usize = 0
    capacity: mutable usize = 0
    region scratch(4096):
        xs: mutable darray[i64] = []
        xs.push(42)
        count <- xs.count
        capacity <- xs.capacity
    return 0 if count == 1 and capacity >= count else 1
