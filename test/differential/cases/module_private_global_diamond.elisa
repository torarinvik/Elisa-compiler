# DIAMOND include graph: main -> left -> {A, B}; main -> right -> {B, A}. Each module is
# reached twice by two paths in opposite orders; it must exist once and keep its own state.
include "./module_private_global_diamond/d_left.elisa"
include "./module_private_global_diamond/d_right.elisa"

def main() -> i64:
    return 1 if A::read() != 11
    return 2 if B::read() != 73
    A::write(5)
    return 3 if B::read() != 73
    return 4 if A::read() != 5
    return 0
