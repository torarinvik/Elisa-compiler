# An explicit packed STORE whose hierarchy is named through its MODULE.
#
# `Ast::Node.Store[Local] = Ast::Node.Store(r)` is the same construct as the bare
# `Node.Store[Local] = Node.Store(owner)` that test/repro/hierarchy_is_narrow.elisa
# already covers -- only the spelling of the hierarchy differs. stage1 matched a
# bare Ident at all three places that recognize a store (the type annotation, the
# constructor call, and the scope-path type), so the qualified spelling resolved
# to nothing: the variable declaration declined, and every caller of the function
# holding it declined with it. stage0 compiles and runs both spellings.
#
# Found in elisa-proof, which reuses the compiler's own `module Ast` as a library
# and could not be built by stage1 for this reason alone.
module Ast:
    public:
        enum Node layout(handle: u32):
            common:
                x: f32
            pass

        enum Leaf is Node:
            Value(v: i64)

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        region r(65536):
            store: Ast::Node.Store[Local] = Ast::Node.Store(r)
            seen: mutable i64 = 0
            in store:
                n: Ast::Node = new Ast::Leaf.Value(x: 1.5, v: 42)
                seen <- 1 if n is Ast::Leaf.Value
                seen <- seen + 1 if n.x == 1.5
            return 1 if seen != 2
            return 0
