# Builtin numeric conversion on a loop index remains pure and can still participate in
# the stack-placement proof when it is the fill value.
def main() -> i64:
    values: darray[i64] = []
    for index in 0..<16:
        values.push(index.i64())
    total: mutable i64 = 0
    for value in values |total|:
        total <- total + value
    return 1 if total != 120
    return 0
