# A readonly reference reinterpreted with `.cast[mutable T&]` may be passed to a
# mutable-ref parameter. The cast is the explicit, capability-gated escape hatch, and
# stage0 accepts it -- its own vendored runtime (elisacore_std/stores_core.elisa) is
# written exactly this way.
#
# stage1's readonly-ref check walked THROUGH the cast to the binding it came from, so
# the argument reported as the readonly `uintptr&` the binding was declared with, and
# stage1 refused the call. That made stage1 unable to compile the canonical runtime,
# which is how it surfaced: the seed built, and then the runtime object it is supposed
# to produce did not.
def store_through(target: mutable void&, value: uintptr) -> uintptr can[Abort.Panic, Unsafe.PointerCast]:
    slot: mutable uintptr& = target.cast[mutable uintptr&] can Unsafe.PointerCast
    slot <- value
    return slot

def main() -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    cell: mutable darray[uintptr] = [0.uintptr()]
    # A READONLY ref binding, exactly the shape the runtime uses.
    current: heap uintptr& = (&cell[0]).cast[heap uintptr&] can Unsafe.PointerCast
    written: uintptr = store_through(current.cast[mutable void&], 7.uintptr()) can Unsafe.PointerCast
    return 1 if written != 7.uintptr()
    return 0
