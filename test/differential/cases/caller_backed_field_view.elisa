# A scalar binding after a view must preserve caller-backed byte storage.
struct HU:
    bytes: mutable darray[u8]

def mk() -> sview:
    h: mutable HU = HU{bytes: [65.u8(), 65.u8()]}
    v: sview = h.bytes.as_sview()
    marker: i64 = 1
    return v

def main() -> i64:
    w: sview = mk()
    return w[0].i64() - 65
