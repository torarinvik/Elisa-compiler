# Reading a `common:` field through an `is` binding whose source is an optional
# PARAMETER used to decline in stage1 while the identical read through an optional
# LOCAL compiled.
#
# The receiver type was never the problem, despite the note that used to sit here.
# body_store_root_index scanned the signature for a bare PackedEnum parameter and
# did not look through `?`, so the root index went unrecorded and the common-read
# path's ambient-store gate stayed shut -- with the hidden store parameter it would
# have used sitting right there. A LOCAL declaration gave the body scan something to
# find, which is what made this look like a parameter-vs-local difference.
#
# Both shapes are kept: they exercise the two ways the ambient store gets recorded.
enum Widget:
    common:
        @storage(inline)
        pressed: mutable bool
        @storage(inline)
        next_sibling: mutable Widget?
    pass

enum Leaf is Widget:
    Button(size: f32)

def make(size: f32) -> Widget can[Memory.Allocate, Abort.Panic]:
    return Leaf.Button(pressed: false, next_sibling: null, size: size)

# read a common through an is-bound optional PARAMETER
def read_param(target: Widget?) -> bool:
    got: mutable bool = false
    if target is node:
        got <- node.pressed
    return got

# read a common through an is-bound optional LOCAL
def read_local(source: Widget) -> bool:
    target: Widget? = source
    got: mutable bool = false
    if target is node:
        got <- node.pressed
    return got

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        region ui(65536):
            w: Widget = make(1.0)
            w.pressed <- true
            return 1 if not read_local(w)
            return 2 if not read_param(w)
            return 0
