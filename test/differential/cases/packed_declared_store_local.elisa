# A packed store DECLARED as a local (`store: Shape.Store[Local] = Shape.Store(owner)`)
# and then used implicitly by a constructor in the same statement list.
#
# stage1 aborted at runtime on this: the declaration never became the ACTIVE store, so
# the constructor allocated its row out of a SYNTHETIC per-function store while the
# handle was decoded against the declared one. `ctx_packed_store_read_variant_sparse_tag`
# asserted `index < tags.count` and the program died (exit 134) where stage0 returns 223.
#
# A store declaration now activates that store for the rest of its statement list, the
# same way an `in store:` block does for its body. The common field is read back as well
# as the payload, so a row-layout or store-identity regression changes the exit code.
packed enum Shape:
    common:
        a: u32
    Circle(r: i64)
    Rect(w: i64, h: i64)

def area(s: Shape, store: Shape.Store[Local]) -> i64:
    match s in store:
        Shape.Circle(r):
            return r
        Shape.Rect(w, h):
            return w * h
    return -1

def build(owner: Arena) -> i64 can[Memory.Allocate, Abort.Panic]:
    store: Shape.Store[Local] = Shape.Store(owner)
    c: Shape = Shape.Circle(a: 7, r: 35)
    d: Shape = Shape.Rect(a: 9, w: 3, h: 4)
    # One distinct code per assertion. The common and the payload are read for BOTH
    # rows, so a store-identity or row-stride regression cannot pass by luck.
    return 1 if area(c, store) != 35
    return 2 if area(d, store) != 12
    return 3 if c.a != 7.u32()
    return 4 if d.a != 9.u32()
    return 0

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        region r(65536):
            return build(r)
    return 5
