global mutable log: i64 = 0

struct Tracked:
    mark: i64

def __drop__(self: Tracked) -> void:
    log <- log * 10 + self.mark

def consume(v: Tracked) -> i64:
    return v.mark

def moved_away() -> i64:
    t: Tracked = Tracked{mark: 5}
    return consume(move t)

def kept() -> void:
    t: Tracked = Tracked{mark: 7}
    _ = t.mark

def main() -> i64:
    # The callee's parameter is itself droppable, so the move relocates the
    # obligation rather than cancelling it: exactly one drop must run.
    n: i64 = moved_away()
    return 1 if n != 5
    before: i64 = log
    kept()
    return 2 if log != before * 10 + 7
    return 0
