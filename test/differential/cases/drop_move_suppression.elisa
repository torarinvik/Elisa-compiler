# `move` hands the obligation to the receiver, so exactly one drop must run: the
# caller suppresses its own, and the callee releases the parameter it received.
#
# stage1 used to register drops for locals only, so a moved-in value was never
# released -- a leak, not a double free. Fixed by arming the cleanup at the
# parameter site too (codegen_declare.elisa), with stage0's isOwnDropReceiver
# guard: a destructor must not drop its own receiver, or `__drop__` recurses
# until the stack dies.
#
# The earlier note here blamed the gen3 fixpoint for blocking the fix. That was
# the same unisolated claim withdrawn in d00ebe2c; the fixpoint is byte-identical
# with the parameter site wired.
global mutable log: i64 = 0

struct Tracked:
    mark: i64

def __drop__(self: Tracked) -> void:
    log <- log * 10 + self.mark

def consume(v: Tracked) -> i64:
    return v.mark

def moved_away() -> i64:
    t: Tracked = Tracked{mark: 5}
    return consume(move t)

def main() -> i64:
    n: i64 = moved_away()
    return 1 if n != 5
    # The obligation moved to the callee, so it must have released it exactly once.
    return 2 if log != 5
    return 0
