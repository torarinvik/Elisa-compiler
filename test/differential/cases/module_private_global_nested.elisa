# A nested module with the same private name as its parent and as a sibling.
module Outer:
    private:
        global mutable counter: i64 = 1
    public:
        def read() -> i64:
            return counter
        def write(v: i64) -> void:
            counter <- v
    module Inner:
        private:
            global mutable counter: i64 = 2
        public:
            def read() -> i64:
                return counter
            def write(v: i64) -> void:
                counter <- v

module Other:
    private:
        global mutable counter: i64 = 3
    public:
        def read() -> i64:
            return counter

def main() -> i64:
    1 return if Outer::read() != 1
    2 return if Outer::Inner::read() != 2
    3 return if Other::read() != 3
    Outer::Inner::write(20)
    4 return if Outer::read() != 1
    5 return if Outer::Inner::read() != 20
    Outer::write(10)
    6 return if Outer::Inner::read() != 20
    7 return if Other::read() != 3
    return 0
