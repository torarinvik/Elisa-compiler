# A nested module with the same private name as its parent and as a sibling.
module Outer:
    private:
        global mutable counter: i64 = 1
    public:
        def read() -> i64:
            return counter
        def write(v: i64) -> void:
            counter <- v
    module Inner:
        private:
            global mutable counter: i64 = 2
        public:
            def read() -> i64:
                return counter
            def write(v: i64) -> void:
                counter <- v

module Other:
    private:
        global mutable counter: i64 = 3
    public:
        def read() -> i64:
            return counter

def main() -> i64:
    return 1 if Outer::read() != 1
    return 2 if Outer::Inner::read() != 2
    return 3 if Other::read() != 3
    Outer::Inner::write(20)
    return 4 if Outer::read() != 1
    return 5 if Outer::Inner::read() != 20
    Outer::write(10)
    return 6 if Outer::Inner::read() != 20
    return 7 if Other::read() != 3
    return 0
