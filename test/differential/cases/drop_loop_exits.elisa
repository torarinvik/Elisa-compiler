global mutable log: i64 = 0

struct Tracked:
    mark: i64

def __drop__(self: Tracked) -> void:
    log <- log + self.mark

def loops() -> void:
    for i in 0..<5:
        t: Tracked = Tracked{mark: 1}
        continue if i % 2 == 0
        break if i > 2
        _ = t.mark

def main() -> i64:
    loops()
    return 1 if log != 4
    return 0
