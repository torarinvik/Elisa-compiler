def at_limit() -> i64:
    values: mutable darray[i64] = []
    for index in 0..<256 |values|:
        values.push(index)
    return values[255]

def over_limit() -> i64:
    values: mutable darray[i64] = []
    for index in 0..<257 |values|:
        values.push(index)
    return values[256]

def main() -> i64:
    return 1 if at_limit() != 255
    return 2 if over_limit() != 256
    return 0
