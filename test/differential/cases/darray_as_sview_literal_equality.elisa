# `bytes.as_sview() == "text"` compares the darray's bytes as a view. stage1 typed the
# `as_sview()` call as unknown, took the literal's cstr type for the comparison and
# called ctx_streq with an sview: invalid IR. Both operand orders and `!=` must agree
# with stage0, for a match, a different length and a different byte.
def view_equals(bytes: darray[u8]&) -> bool:
    return bytes.as_sview() == "ab"

def view_differs(bytes: darray[u8]&) -> bool:
    return bytes.as_sview() != "ab"

def literal_left(bytes: darray[u8]&) -> bool:
    return "ab" == bytes.as_sview()

def main() -> i64:
    same: mutable darray[u8] = []
    same.push(97)
    same.push(98)
    shorter: mutable darray[u8] = []
    shorter.push(97)
    changed: mutable darray[u8] = []
    changed.push(97)
    changed.push(99)
    return 1 if not view_equals(&same)
    return 2 if view_differs(&same)
    return 3 if not literal_left(&same)
    return 4 if view_equals(&shorter) or not view_differs(&shorter)
    return 5 if view_equals(&changed) or literal_left(&changed)
    return 0
