def main() -> i64:
    total: mutable i64 = 0
    for i in 0..<200 |total|:
        xs: mutable darray[i64] = []
        xs.reserve(4096)
        xs.push(i)
        total <- total + xs[0]
    return 1 if total != 19900
    i: mutable i64 = 0
    while i < 10 |i, total|:
        xs: mutable darray[i64] = []
        xs.push(i)
        i <- i + 1
        continue if i == 1
        total <- total + xs[0]
        break if i == 4
    return 0 if total == 19906 else 2
