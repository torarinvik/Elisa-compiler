# Scalar return is insufficient: a helper can also mutate a nonlocal value.
global mutable state: i64 = 0
def read_and_count(xs: darray[i64]&) -> i64:
    state <- state + 1
    return xs[0]
def main() -> i64:
    total: mutable i64 = 0
    for i in 0..<4 |total|:
        xs: mutable darray[i64] = [i]
        total <- total + read_and_count(&xs)
    return 0 if total == 6 and state == 4 else 1
