# A MUTABLE `@storage(inline)` common that falls inside the store's PREFIX WINDOW
# used to be written to one place and read from another, so an assignment after
# construction was invisible.
#
# The constructor allocates a row, fills it, and calls
# `ctx_packed_store_record_prefix_words`, which COPIES the first `prefix_words`
# words of that row out into parallel column arrays. A later `leaf.wide <- v`
# stores straight into the row through a decoded pointer and never touches the
# columns, and `ctx_packed_store_read_index_word` serves any word below
# `prefix_words` from the column -- so the read still answered the value the
# CONSTRUCTOR stored. Here prefix_words is 3 and `wide` sits at word 2, inside
# the window.
#
# Fixed by reading a mutable inline common from the ROW, which is the only place
# a write goes; immutable commons keep the column fast path, where row and column
# cannot disagree. The branch between the writes and the reads matters: a read in
# the same block reuses the decoded row pointer and answered correctly either
# way, which is what made this look intermittent.

@packed_profile(build_heavy)
enum Widget:
    common:
        @storage(inline)
        tag: mutable i32
        @storage(inline)
        x: mutable f32
        @storage(inline)
        wide: mutable f64
    pass

enum Control is Widget:
    Label(size: f32, next_sibling: Widget?)

def label(size: f32) -> Widget can[Memory.Allocate, Abort.Panic]:
    return Control.Label(tag: 3, x: 7.0, wide: 2.5, size: size, next_sibling: null)

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        region ui(65536):
            leaf: Widget = label(14.0)
            leaf.x <- 0.5
            leaf.wide <- -1.25
            leaf.tag <- 9
            return 1 if leaf.x != 0.5
            return 2 if leaf.wide != -1.25
            return 3 if leaf.tag != 9
            return 0
