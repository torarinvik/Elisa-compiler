# `sv[i]` is lowered inline on 64-bit targets. It must keep the runtime's
# string_view_index contract exactly: an index at or past the end, a negative index
# and any index into an empty view read 0; in range it is the byte, zero-extended.
def at(s: sview, i: i64) -> i64:
    return s[i]

def main() -> i64:
    s: sview = "hello"
    return 1 if at(s, 0) != 104
    return 2 if at(s, 4) != 111
    return 3 if at(s, 5) != 0
    return 4 if at(s, -1) != 0
    return 5 if at(s, 9223372036854775807) != 0
    e: sview = ""
    return 6 if at(e, 0) != 0
    t: sview = s[1:3]
    return 7 if at(t, 1) != 108
    return 8 if at(t, 2) != 0
    hi: sview = "\xff"
    return 9 if at(hi, 0) != 255
    total: mutable i64 = 0
    for i in 0..<s.len |total, s|:
        total <- total + s[i]
    return 10 if total != 532
    return 0
