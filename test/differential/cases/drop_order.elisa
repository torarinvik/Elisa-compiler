global mutable log: i64 = 0

struct Tracked:
    mark: i64

def __drop__(self: Tracked) -> void:
    log <- log * 10 + self.mark

def three() -> void:
    a: Tracked = Tracked{mark: 1}
    b: Tracked = Tracked{mark: 2}
    c: Tracked = Tracked{mark: 3}
    _ = a.mark + b.mark + c.mark

def main() -> i64:
    three()
    return 1 if log != 321
    return 0
