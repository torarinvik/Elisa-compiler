# A local named `guard` or `require` initialized by `get … else` is a binding. Both
# parsers took the `else` on the line as a `guard COND else …` statement and reported
# "unexpected token : in expression".
def positive(value: i64) -> i64?:
    return null if value <= 0
    value

def doubled(value: i64) -> i64?:
    guard: i64 = get positive(value) else return null
    guard * 2

def tripled(value: i64) -> i64?:
    require: mutable i64 = 0
    require <- get positive(value) else return null
    require * 3

def or_zero(value: i64?) -> i64:
    present: i64 = get value else return 0
    present

def main() -> i64:
    return 2 if or_zero(doubled(4)) != 8
    return 3 if or_zero(doubled(-1)) != 0
    return 4 if or_zero(tripled(2)) != 6
    guard 1 > 0 else return 5
    0
