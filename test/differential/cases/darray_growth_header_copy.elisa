# `b = a` copies the darray header and shares the buffer. Once `d` takes the arena tail, `a`'s
# growth MOVES it while `b` still reads the old block; arena_realloc used to put that block on
# the free list, so `c` was carved out of it and `b[0]` read 9 instead of 42.
def main() -> i32:
    a: mutable darray[i64] = []
    for i in 0 ..< 4 |a|:
        a <- a.push(42)
    b: darray[i64] = a
    d: mutable darray[i64] = []
    d <- d.push(5)
    for i in 0 ..< 100 |a|:
        a <- a.push(7)
    c: mutable darray[i64] = []
    for i in 0 ..< 4 |c|:
        c <- c.push(9)
    if b[0] + b[1] + b[2] + b[3] != 168:
        return 1
    if c[3] != 9 or d[0] != 5 or a[103] != 7:
        return 2
    return 0
