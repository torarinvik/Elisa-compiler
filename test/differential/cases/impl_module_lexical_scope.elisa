# Impl dispatch is global after module-body flattening, but Self, bare types,
# and sibling calls must still resolve in the impl's lexical module.
protocol Scored:
    def score(self: Self, extra: i32) -> i32

module Earlier:
    public:
        struct Item:
            value: i32

module Inner:
    public:
        struct Item:
            first: i32
            second: i32

        def combine(a: i32, b: i32) -> i32:
            return a * 10 + b

        impl Scored for Item:
            def score(self: Self, extra: i32) -> i32:
                return combine(self.first, self.second) + extra

def main() -> i32:
    item: Inner::Item = Inner::Item{first: 4, second: 2}
    return 1 if item.score(3) != 45 else 0
