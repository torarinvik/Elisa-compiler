def choose[T](input_size: T) -> i64:
    scratch: mutable darray[i64] = []
    for position in 0..<2 |scratch|:
        scratch.push(position + 1)
    return scratch[0] + 10

def choose(input_size: i64) -> i64:
    scratch: mutable darray[i64] = []
    for position in 0..<input_size |scratch|:
        scratch.push(position + 1)
    return scratch[0]

def main() -> i64:
    for round in 0..<3:
        measured: i64 = choose(2)
        return 1 if measured != 1
    return 0
