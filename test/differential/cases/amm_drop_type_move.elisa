# `move` transfers the drop obligation: exactly one drop.
global mutable drops: i64 = 0

struct Tracked:
    mark: i64

def __drop__(self: Tracked) -> void can[Global{Read,Write}]:
    can Global{Read,Write}:
        drops <- drops + 1

def f() -> void can[Global{Read,Write}]:
    can Global{Read,Write}:
        t: Tracked = Tracked{mark: 1}
        u: Tracked = move t
        _ = u.mark

def main() -> i64 can[Global{Read,Write}]:
    can Global{Read,Write}:
        f()
        return drops
