# The inline loop-value expression in RETURN position: `return for x in xs |acc=0| -> acc:`.
# Every `=` site accepted it; the return site fell into the ordinary expression parser and
# rejected the capture header (`unexpected token near "|"`). stage0 accepts and runs it.
def total(xs: darray[i64]) -> i64:
	return for x in xs |acc=0| -> acc:
		acc <- acc + x

def biggest(xs: darray[i64]) -> i64:
	return for x in xs |best=-1| -> best:
		best <- x if x > best

def main() -> i64:
	xs: darray[i64] = [3, 9, 4]
	return 1 if total(xs) != 16
	return 2 if biggest(xs) != 9
	return 3 if total([]) != 0
	return 0
