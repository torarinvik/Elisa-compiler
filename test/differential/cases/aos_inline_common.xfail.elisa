# KNOWN DIVERGENCE, and stage0 is the one that is wrong.
#
# Under `@packed_profile(build_heavy)` an explicitly `@storage(inline)` common
# reads back 0 instead of the value the constructor stored. stage1 answers 7
# (correct); stage0 answers 1 here because its read sees 0.
#
# It is specifically the EXPLICIT annotation: the same enum with no @storage
# annotation round-trips on both, and so does @storage(inline) without
# build_heavy. So default-inline and explicit-inline take different paths under
# AoS, and one of them is broken.
#
# This shape is not otherwise exercised -- a recursive plain enum is already AoS
# without the annotation, which is why nothing caught it. Drop the .xfail suffix
# once stage0 agrees.
@packed_profile(build_heavy)
enum Widget:
    common:
        @storage(inline)
        x: mutable f32
    pass

enum Control is Widget:
    Label(size: f32, next_sibling: Widget?)

def label(size: f32) -> Widget can[Memory.Allocate, Abort.Panic]:
    return Control.Label(x: 7.0, size: size, next_sibling: null)

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        region ui(65536):
            leaf: Widget = label(14.0)
            return 0 if leaf.x == 7.0
            return 1
