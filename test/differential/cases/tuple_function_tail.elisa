# Tuple tails use the same return path and cleanup as explicit returns.
global mutable exits: i64 = 0
global mutable calls: i64 = 0

def note_exit() -> void:
    exits <- exits + 1

def direct(n: i64) -> (first: i64, second: i64):
    n, n + 1

def branch(n: i64) -> (first: i64, second: i64):
    if n < 0:
        -n, 0
    else:
        local: i64 = n + 1
        n, local

def matched(n: i64) -> (first: i64, second: i64):
    match n:
        0:
            10, 20
        _:
            n, n + 2

def scoped(n: i64) -> (first: i64, second: i64):
    a, b =
        hidden: i64 = n * 2
        hidden, hidden + 1
    a, b

def folded(n: i64) -> (first: i64, second: i64):
    for index in 0..<n |sum: i64 = 0, count: i64 = 0| -> sum, count:
        sum <- sum + index
        count <- count + 1

def cleanup(n: i64) -> (first: i64, second: i64):
    defer block:
        note_exit()
    n, exits

def mixed(n: i64) -> (count: i64, ready: bool, weight: f32):
    n, n > 0, 1.5

def counted(n: i64) -> (first: i64, second: i64):
    calls <- calls + 1
    n, n + 1

def main() -> i64:
    a, b = direct(20)
    return 1 if a != 20 or b != 21
    c, d = branch(-3)
    return 2 if c != 3 or d != 0
    e, f = branch(3)
    return 3 if e != 3 or f != 4
    g, h = matched(0)
    return 4 if g != 10 or h != 20
    i, j = matched(7)
    return 5 if i != 7 or j != 9
    k, l = scoped(8)
    return 6 if k != 16 or l != 17
    m, n = folded(4)
    return 7 if m != 6 or n != 4
    o, p = folded(0)
    return 8 if o != 0 or p != 0
    q, r = cleanup(42)
    return 9 if q != 42 or r != 0 or exits != 1
    mixed_count, ready, weight = mixed(3)
    return 10 if mixed_count != 3 or not ready or weight != 1.5
    left: mutable i64 = 0
    right: mutable i64 = 0
    left, right <- counted(8)
    return 11 if left != 8 or right != 9 or calls != 1
    kept, _ = counted(10)
    return 12 if kept != 10 or calls != 2
    nested_left, nested_right =
        hidden: i64 = 12
        counted(hidden)
    return 13 if nested_left != 12 or nested_right != 13 or calls != 3
    0
