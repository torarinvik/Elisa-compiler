# A match over a sealed hierarchy written OUTSIDE the declaring module, with
# module-qualified variant paths (`Ui::Container.Box`), is exhaustive. stage1
# registered enum owners bare but compared the pattern's source spelling, so
# such a match read as non-exhaustive and the function "must return a value".
# Module constants are read through `::` as well.
module UiConst:
    public:
        const AXIS_COLUMN: i32 = 0
        const AXIS_ROW: i32 = 1

module Ui:
    public:
        enum Widget:
            common:
                @storage(inline)
                x: mutable f32
            pass

        enum Container is Widget:
            Box(axis: i32)
            Grid(columns: i32)

        enum Control is Widget:
            Label(size: f32)

        def inside(w: Widget) -> i32:
            match w:
                Container.Box(axis):
                    return axis
                Container.Grid(columns):
                    return columns
                Control.Label(size):
                    return UiConst::AXIS_COLUMN

        def label(size: f32) -> Widget can[Memory.Allocate, Abort.Panic]:
            return Control.Label(x: 0.0, size: size)

        def box() -> Widget can[Memory.Allocate, Abort.Panic]:
            return Container.Box(x: 0.0, axis: UiConst::AXIS_ROW)

    private:
        def hidden() -> i32:
            return 7

def outside(w: Ui::Widget) -> i32:
    match w:
        Ui::Container.Box(axis):
            return axis
        Ui::Container.Grid(columns):
            return columns
        Ui::Control.Label(size):
            return 5

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        region ui(65536):
            a: Ui::Widget = Ui::label(1.0)
            b: Ui::Widget = Ui::box()
            return 1 if Ui::inside(b) != UiConst::AXIS_ROW
            return 2 if outside(a) != 5
            return 3 if outside(b) != 1
            a.x <- 2.0
            return 4 if a.x != 2.0
            return 0
