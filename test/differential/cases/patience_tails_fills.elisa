# Patience sorting keeps a zero-filled `tails` array whose first `count`
# elements hold values: each value replaces the first tail not below it,
# found by binary search over [0, count), and extends the stack only when
# that position is `count` itself. The search's midpoint lo + (hi - lo) / 2
# stays below hi <= count, and `count + [at == count]` after the store at
# `at` pushes exactly when the store wrote element `count`
# (ElisaStackWatermark, ElisaIndexShapes), so the fill is dead. The
# negatives search one element past the count, or extend the count when the
# store landed one below it; both read the fill's zeros.
const CAPACITY: usize = 128

def lower_bound(tails: view[i64], count: usize, x: i64) -> usize:
    lo: mutable usize = 0
    hi: mutable usize = count
    while lo < hi:
        mid: usize = lo + (hi - lo) / 2
        if tails[mid] < x:
            lo <- mid + 1
        else:
            hi <- mid
    lo

# Longest strictly increasing subsequence of each window, folded.
@inline(never)
def windowed_lis(values: view[i64], width: usize) -> i64:
    return -1 if values.len > CAPACITY
    tails: mutable i64[128] = zeroed
    fold: mutable i64 = 0
    start: mutable usize = 0
    while start + width <= values.len:
        count: mutable usize = 0
        i: mutable usize = start
        while i < start + width:
            at: usize = lower_bound(tails[0:CAPACITY], count, values[i])
            tails[at] <- values[i]
            if at == count:
                count <- count + 1
            i <- i + 1
        fold <- (fold * 31 + count.i64() * 1000 + tails[count - 1]) % 1000003 if count > 0 else fold
        start <- start + 1
    fold

# Searches one element past the count: the zero there sorts below every
# positive value, so the insertion point is past it.
@inline(never)
def search_past_count(values: view[i64]) -> i64:
    return -1 if values.len >= CAPACITY
    tails: mutable i64[128] = zeroed
    count: mutable usize = 0
    i: mutable usize = 0
    while i < values.len:
        at: usize = lower_bound(tails[0:CAPACITY], count + 1, values[i])
        tails[at] <- values[i]
        if at >= count:
            count <- at + 1
        i <- i + 1
    count.i64()

# Extends the count when the store landed just below it, leaving a zero
# inside the counted prefix.
@inline(never)
def extend_below_count(values: view[i64]) -> i64:
    return -1 if values.len >= CAPACITY
    tails: mutable i64[128] = zeroed
    count: mutable usize = 1
    i: mutable usize = 0
    while i < values.len:
        at: usize = lower_bound(tails[0:CAPACITY], count - 1, values[i])
        tails[at] <- values[i]
        if at + 1 == count:
            count <- count + 1
        i <- i + 1
    tails[count - 1]

def main() -> i32:
    values: mutable i64[100] = zeroed
    k: mutable usize = 0
    while k < 100:
        values[k] <- (k * 37 % 101).i64() + 1
        k <- k + 1
    width: mutable usize = 1
    while width <= 100:
        # Reference: quadratic LIS of each window.
        expected: mutable i64 = 0
        start: mutable usize = 0
        while start + width <= 100:
            best: mutable i64[100] = zeroed
            longest: mutable i64 = 0
            top: mutable i64 = 0
            a: mutable usize = start
            while a < start + width:
                best[a] <- 1
                b: mutable usize = start
                while b < a:
                    if values[b] < values[a] and best[b] + 1 > best[a]:
                        best[a] <- best[b] + 1
                    b <- b + 1
                if best[a] > longest:
                    longest <- best[a]
                    top <- values[a]
                elif best[a] == longest and values[a] < top:
                    top <- values[a]
                a <- a + 1
            expected <- (expected * 31 + longest * 1000 + top) % 1000003
            start <- start + 1
        return 10 if windowed_lis(values[0:100], width) != expected
        width <- width + 7
    # Values 1, 38, 75 each sort past the zeros the wider search reads
    # (elements 0, 2 and 4), landing at 1, 3 and 5.
    return 11 if search_past_count(values[0:3]) != 6
    # The first value fills element 0 and the count reaches 2, leaving
    # element 1 a zero that every later search sorts below.
    return 12 if extend_below_count(values[0:2]) != 0
    0
