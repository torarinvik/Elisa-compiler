include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/collections.elisa"

# A user-defined cast has priority over the builtin numeric `.u8()` conversion.
def __cast__(value: i64) -> u8:
    return 88

def append_custom_bytes(out: mutable darray[u8]&, text: sview) -> void:
    for index in 0..<text.len |out, text|:
        out.push(text[index].u8())

def main() -> i64:
    out: mutable darray[u8] = []
    append_custom_bytes(&out, "A")
    return 1 if out.count != 1
    return 2 if out[0] != 88
    return 0
