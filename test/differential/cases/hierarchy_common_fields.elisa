# `common:` fields on a sealed hierarchy, with a type that is not i64.
#
# Both compiler generations must preserve the declared common-field type through
# registration, construction, the shared hierarchy row, and root-typed reads.
enum Widget:
    common:
        w: f32
    pass

enum Control is Widget:
    Label(text: sview)

enum Button is Control:
    Push(label: sview)

def make() -> Widget:
    return Button.Push(w: 42.0, label: "go")

def width_of(x: Widget) -> f32:
    return x.w

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        node: Widget = make()
        return width_of(node).i64() - 42
