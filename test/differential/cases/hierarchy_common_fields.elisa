# `common:` fields on a sealed hierarchy, with a type that is not i64.
#
# The backend recorded common field NAMES but never their TYPES, defaulting every
# common to a hardcoded i64 word -- so an f32 common could not be emitted at all
# and the constructor declined. The compiler's own AST declares only `int`
# commons, which IS i64, so self-hosting never exercised the other case.
#
# Both compilers now agree.
enum Widget:
    common:
        w: f32
    pass

enum Control is Widget:
    Label(text: sview)

enum Button is Control:
    Push(label: sview)

def make() -> Widget:
    return Button.Push(w: 42.0, label: "go")

def width_of(x: Widget) -> f32:
    return x.w

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        node: Widget = make()
        return width_of(node).i64() - 42
