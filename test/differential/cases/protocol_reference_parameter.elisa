protocol Painter:
    def paint(self: Self&) -> i32
struct Red:
    value: i32
impl Painter for Red:
    def paint(self: Self&) -> i32:
        return self.value
def draw(painter: Painter&) -> i32:
    return painter.paint()
def main() -> i32:
    red: Red = Red{value: 42}
    return 0 if draw(&red) == 42 else 1
