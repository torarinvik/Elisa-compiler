def observed(size: i64) -> i64:
    values: mutable darray[i64] = []
    for index in 0..<size |values|:
        values.push(index)
    return values.capacity

def escaped() -> darray[i64]:
    saved: mutable darray[i64] = [41, 42]
    return saved

def aliased() -> i64:
    first: mutable darray[i64] = [40, 42]
    second: darray[i64] = first
    return second[1]

def main() -> i64:
    result: darray[i64] = escaped()
    return 1 if result[0] != 41 or result[1] != 42
    return 2 if aliased() != 42
    # No capacity-changing optimization is permitted when it is observed.
    return 3 if observed(5) != 8
    return 0
