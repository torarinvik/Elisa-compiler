# A packed enum's `common:` fields, declared `mutable`, are written through the
# handle and read back. Covers the three shapes that were broken independently:
# a write at all, a non-i64 common (the row slot is i64, the field is f32), and
# a common read as an operand of a binary expression rather than as a `let`
# initializer -- which typed as i64 and declined while the initializer compiled.
enum Widget:
    common:
        @storage(inline)
        x: mutable f32
        @storage(inline)
        y: mutable f32
        kind: i32
    pass

enum Container is Widget:
    Box(spacing: f32, first_child: Widget?, next_sibling: Widget?)

enum Control is Widget:
    Label(size: f32, next_sibling: Widget?)

def label(size: f32) -> Widget can[Memory.Allocate, Abort.Panic]:
    return Control.Label(x: 0.0, y: 0.0, kind: 2, size: size, next_sibling: null)

def box(first: Widget?) -> Widget can[Memory.Allocate, Abort.Panic]:
    return Container.Box(x: 0.0, y: 0.0, kind: 1, spacing: 4.0, first_child: first, next_sibling: null)

def place(node: Widget, at_x: f32, at_y: f32) -> void:
    node.x <- at_x
    node.y <- at_y

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        region ui(65536):
            leaf: Widget = label(14.0)
            root: Widget = box(leaf)
            # constructor values survive before any write
            return 1 if leaf.kind != 2
            return 2 if root.kind != 1
            place(leaf, 12.5, 4.25)
            place(root, 1.5, 2.5)
            # read back as a binary operand
            return 3 if leaf.x != 12.5
            return 4 if leaf.y != 4.25
            return 5 if root.x != 1.5
            return 6 if root.y != 2.5
            # a second write overwrites rather than accumulating
            place(leaf, 99.0, 0.5)
            return 7 if leaf.x != 99.0
            return 8 if leaf.y != 0.5
            # writing one node must not disturb its sibling's row
            return 9 if root.x != 1.5
            # the immutable common is untouched by all of it
            return 10 if leaf.kind != 2
            # a common read into a local agrees with the same read inline
            got: f32 = leaf.x
            return 11 if got != leaf.x
            return 0
