# An error-returning generic that grows its `darray&` parameter, called through `try`:
# the instantiation's arena slots must be laid out on the error-call path too (this
# crashed the compiler). 4 + 100 * 40 = 4004 = 164 mod 256.
error E:
    Bad

def gfill[T](out: mutable darray[i64]&, v: T, n: i64) -> i64 error[E]:
    raise E.Bad if n < 0
    for i in 0..<n:
        out.push(4)
    return n

def clobber() -> i64:
    junk: mutable darray[i64] = []
    for i in 0..<4096:
        junk.push(99)
    return junk.count.i64()

def main() -> i64:
    xs: mutable darray[i64] = []
    k: i64 = try gfill[i64](&xs, 4, 40) else 0
    c: i64 = clobber()
    return xs[3] + 100 * k
