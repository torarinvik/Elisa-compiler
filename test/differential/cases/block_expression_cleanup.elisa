# Evaluate each tail before block cleanup, then run each cleanup exactly once.
global mutable observed: i64 = 0

def record(digit: i64) -> void:
    can Global{Read,Write}:
        observed <- observed * 10 + digit

def compute() -> i64:
    defer function:
        record(3) can Global{Read,Write}
    value: i64 =
        defer block:
            record(2) can Global{Read,Write}
        inner: i64 =
            defer block:
                record(1) can Global{Read,Write}
            observed + 42 can Global.Read
        inner + observed can Global.Read
    can Global.Read:
        return 1000 if value != 43 or observed != 12
    return value

def main() -> i64:
    can Global{Read,Write}:
        return 1 if compute() != 43
    can Global.Read:
        return 2 if observed != 123
    inferred =
        defer block:
            record(4) can Global{Read,Write}
        before: i64 = observed can Global.Read
        before
    can Global.Read:
        return 3 if inferred != 123 or observed != 1234
    updated: mutable i64 = 0
    updated <-
        defer block:
            record(5) can Global{Read,Write}
        observed can Global.Read
    can Global.Read:
        return 4 if updated != 1234 or observed != 12345
    return 0
