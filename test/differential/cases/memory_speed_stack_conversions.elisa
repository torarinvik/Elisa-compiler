# A counted fill whose pushed value spells the loop index through a numeric conversion
# (`i.i64()`, `x.u8().i64()`) is still a scalar fill: the buffer gets the memory-speed
# placement (stack for a literal bound <= 256, one reserve otherwise). Values, order and
# count must be unchanged, including a wrapping-free narrowing and the 256/257 edge.
def small(seed: i64) -> i64:
    xs: mutable darray[i64] = []
    for i in 0..<16 |xs, seed|:
        xs.push(seed + i.i64())
    total: mutable i64 = 0
    for x in xs |total|:
        total <- total + x
    return total

def narrowed(seed: i64) -> i64:
    xs: mutable darray[i64] = []
    for i in 0..<256 |xs, seed|:
        xs.push((seed + i.i64()).u8().i64())
    total: mutable i64 = 0
    for x in xs |total|:
        total <- total + x
    return total + xs[255] * 100000

def wide(seed: i64) -> i64:
    xs: mutable darray[i64] = []
    for i in 0..<257 |xs, seed|:
        xs.push(seed - i.i64())
    total: mutable i64 = 0
    for x in xs |total|:
        total <- total + x
    return total

def main() -> i64:
    for turn in 0..<2000:
        return 1 if small(turn.i64()) != turn.i64() * 16 + 120
    return 2 if narrowed(0) != 32640 + 255 * 100000
    return 3 if narrowed(10) != 32640 + 9 * 100000
    return 4 if wide(1000) != 257000 - 32896
    return 0
