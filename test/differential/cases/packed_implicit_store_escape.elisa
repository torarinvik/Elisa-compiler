# An auto-promoted recursive enum built in a helper and RETURNED. This is the
# ordinary algebraic-data-type spelling -- no `new`, no `in Store:` clause, no
# `Store[Local]` declaration -- and it is the form the language is meant to make
# ergonomic.
#
# stage1 used to REJECT it: "packed enum constructor Tree.Leaf requires an active
# in Tree.Store: scope or explicit new[Tree.Store]". The store requirement was
# waived only for AST refinements, on a measurement that had actually probed the
# NON-ESCAPING shape -- which stage0 rejects with a REGION error, a different
# diagnostic that reads the same in a pass/fail table.
#
# The rule stage0 actually applies: a value whose type appears in the SIGNATURE can
# leave the function, so the caller's region is threaded in and no store is needed.
# Each arm below returns a distinct value, so a wrong tag or a wrong payload changes
# the exit code rather than merely failing to compile.
enum Tree:
    Leaf(v: i64)
    Branch(child: Tree)

def leaf(v: i64) -> Tree can[Memory.Allocate, Abort.Panic]:
    return Tree.Leaf(v: v)

def branch(child: Tree) -> Tree can[Memory.Allocate, Abort.Panic]:
    return Tree.Branch(child: child)

# The enum is named only in a PARAMETER here, never in the return type: an
# out-parameter escapes too, which is why the rule tests the whole signature.
def depth_of(t: Tree) -> i64:
    match t:
        Tree.Leaf(v):
            return v
        Tree.Branch(child):
            return 100
    return -1

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        region r(65536):
            a: Tree = leaf(7)
            b: Tree = branch(leaf(9))
            # One distinct code per assertion, so a divergence names the failure.
            return 1 if depth_of(a) != 7
            return 2 if depth_of(b) != 100
            # The payload must survive a second construction of the same variant.
            c: Tree = leaf(41)
            return 3 if depth_of(c) != 41
            return 4 if depth_of(a) != 7
            return 0
    return 5
