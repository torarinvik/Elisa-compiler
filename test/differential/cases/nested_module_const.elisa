# A const read through a NESTED module path: `Outer::Inner::V` from outside and from
# inside `module Outer`, and a module declared once per static-if branch. (The relative
# `Inner::V` inside Outer is rejected by stage0 at lowering, so it is not used.) stage1's
# backend declined all three as a "field expression" (every stage1 binary up to
# 2026-09-15); stage0 resolves them. Exit code is the checksum: stage0 prints 0.
module Outer:
    public:
        module Inner:
            public:
                const V: i64 = 5
        static if ELISA_TARGET_OS_POSIX:
            module Gate:
                public:
                    const OPEN: i64 = 2
        static else:
            module Gate:
                public:
                    const OPEN: i64 = 9
        def relative() -> i64:
            return Outer::Inner::V + Outer::Gate::OPEN

def main() -> i64:
    outside: i64 = Outer::Inner::V + Outer::Gate::OPEN
    return outside - Outer::relative() + (outside - 7)
