global mutable tuple_log: i64 = 0

def record_tuple_exit() -> void:
    tuple_log <- 7

def main() -> i64:
    outer: i64 = 100
    first, second =
        outer: i64 = 20
        outer + 1, outer + 2
    return 1 if first != 21 or second != 22
    return 2 if outer != 100
    a: mutable i64 = 1
    b: mutable i64 = 2
    a, b <-
        temporary: i64 = a
        b, temporary
    return 3 if a != 2 or b != 1
    folded_a, folded_b =
        for item in 0..<4 |left: i64 = 0, right: i64 = 1| -> left, right:
            left <- left + item
            right <- right * 2
    return 4 if folded_a != 6 or folded_b != 16
    before, after =
        defer block:
            record_tuple_exit()
        local: i64 = tuple_log
        local, local + 1
    return 5 if before != 0 or after != 1 or tuple_log != 7
    left, right =
        left: i64 = 10
        right: i64 = 20
        right, left
    return 6 if left != 20 or right != 10
    return 0
