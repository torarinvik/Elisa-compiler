# A BARE call to a sibling inside `module M:` took its RETURN TYPE from the first
# same-named function across ALL modules, not from M. `initial()` inside Ops was typed as
# Del's status, the declaration failed its type check, and the whole body was declined --
# with the winner decided by PARSE ORDER, so adding an unrelated module could make a
# function start or stop compiling. The WasmBrowser SDK hit this between
# WasmBrowser::Delivery and WasmBrowser::Operations.
error OpsError:
	Bad

enum Phase:
	Idle
	Queued

struct DelStatus:
	tag: i64

struct OpsStatus:
	tag: i64
	phase: Phase

module Top::Del:
	public:
		# Declared FIRST and same-named: this is the one that used to win.
		def initial() -> DelStatus:
			return DelStatus{tag: 1}

module Top::Ops:
	public:
		def initial() -> OpsStatus:
			return OpsStatus{tag: 2, phase: Phase.Idle}

		def advance(status: OpsStatus) -> OpsStatus error[OpsError]:
			raise OpsError.Bad if status.tag < 0
			return OpsStatus{tag: status.tag + 1, phase: Phase.Queued}

		def probe() -> bool error[OpsError]:
			status: mutable OpsStatus = initial()
			moved: OpsStatus = try Top::Ops::advance(status)
			status <- moved
			return status.phase is Phase.Queued

		def identify(raw: i64) -> i64:
			# A QUALIFIED try-else with a CONTROL-FLOW recovery, in a declaration.
			value: OpsStatus = try Top::Ops::advance(OpsStatus{tag: raw, phase: Phase.Idle}) else return -1
			return value.tag

def main() -> i64:
	1 return if Top::Del::initial().tag != 1
	2 return if Top::Ops::initial().tag != 2
	3 return if not (try Top::Ops::probe() else false)
	4 return if Top::Ops::identify(5) != 6
	5 return if Top::Ops::identify(-3) != -1
	return 0
