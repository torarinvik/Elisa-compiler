# A copy loop becomes a memcpy or memmove whose length is a variable. When the
# comparisons before it bound the length to a few dozen bytes, the backend expands
# it into two overlapping fixed-size pieces (llvm_bounded_copies.cpp). Every length
# from zero to the bound must copy exactly its bytes: no byte past the end, none
# missing in the middle of an overlap, and a shifting move within one array must
# read every source byte before writing over it.
const WORD_LIMIT: usize = 8
const BYTE_LIMIT: usize = 32

@inline(never)
def copy_words(source: i32[8]&, length: usize) -> i32:
    return 100 if length > WORD_LIMIT
    target: mutable i32[8] = zeroed
    index: mutable usize = 0
    while index < length:
        target[index] <- source[index]
        index <- index + 1
    check: mutable usize = 0
    while check < WORD_LIMIT:
        expected: i32 = source[check] if check < length else 0
        return 101 if target[check] != expected
        check <- check + 1
    0

@inline(never)
def copy_bytes(source: u8[32]&, length: usize) -> i32:
    return 102 if length > BYTE_LIMIT
    target: mutable u8[32] = zeroed
    index: mutable usize = 0
    while index < length:
        target[index] <- source[index]
        index <- index + 1
    check: mutable usize = 0
    while check < BYTE_LIMIT:
        expected: u8 = source[check] if check < length else 0
        return 103 if target[check] != expected
        check <- check + 1
    0

# Moves `length` bytes down by `shift` within one array: an overlapping memmove.
@inline(never)
def shift_bytes(length: usize, shift: usize) -> i32:
    return 104 if length + shift > BYTE_LIMIT or shift > 8
    buffer: mutable u8[32] = zeroed
    fill: mutable usize = 0
    while fill < BYTE_LIMIT:
        buffer[fill] <- (fill * 7 + 1).u8()
        fill <- fill + 1
    index: mutable usize = 0
    while index < length:
        buffer[index] <- buffer[index + shift]
        index <- index + 1
    check: mutable usize = 0
    while check < BYTE_LIMIT:
        moved: usize = check + shift if check < length else check
        return 105 if buffer[check] != (moved * 7 + 1).u8()
        check <- check + 1
    0

def main() -> i32:
    words: i32[8] = [-1, 2, -3, 4, -5, 6, -7, 8]
    bytes: mutable u8[32] = zeroed
    fill: mutable usize = 0
    while fill < BYTE_LIMIT:
        bytes[fill] <- (fill * 13 + 5).u8()
        fill <- fill + 1
    length: mutable usize = 0
    while length <= BYTE_LIMIT:
        if length <= WORD_LIMIT:
            status: i32 = copy_words(&words, length)
            return status if status != 0
        status: i32 = copy_bytes(&bytes, length)
        return status if status != 0
        shift: mutable usize = 1
        while shift <= 8 and length + shift <= BYTE_LIMIT:
            moved: i32 = shift_bytes(length, shift)
            return moved if moved != 0
            shift <- shift + 1
        length <- length + 1
    0
