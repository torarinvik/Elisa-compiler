# A zero-filled array pushed as a stack and then copied out by a loop the
# vectorizer splits into a main loop of whole vectors and a scalar tail
# reads only below its count: the main loop stops at the count rounded down
# (`count & ~3`, or `count - r` with r in [1, 4] so the tail always runs)
# and the tail starts there (ElisaRoundedTrips). The fills are dead. The
# negatives copy one element past the count, which is the fill's zero.
const CAPACITY: usize = 128

struct Run:
    direction: i64
    count: i64

# Euclid's quotients as runs, pushed by a loop scalar evolution cannot
# count, into a buffer zeroed for each query.
def encode_path(numerator_value: i64, denominator_value: i64, runs: mutable view[Run]) -> i64:
    numerator: mutable i64 = numerator_value
    denominator: mutable i64 = denominator_value
    run_count: mutable usize = 0
    while numerator != denominator:
        return -1 if run_count >= 64
        if numerator < denominator:
            count: i64 = (denominator - 1) / numerator
            runs[run_count] <- Run{direction: 0, count: count}
            denominator <- denominator - count * numerator
        else:
            count: i64 = (numerator - 1) / denominator
            runs[run_count] <- Run{direction: 1, count: count}
            numerator <- numerator - count * denominator
        run_count <- run_count + 1
    run_count.i64()

def append(words: mutable view[i64], count: mutable usize&, value: i64) -> bool:
    return false if count >= words.len
    words[count] <- value
    count <- count + 1
    true

# Appends each fraction's run count and runs: the copy reads the runs below
# the count with a capacity check per word (the vectorized count is a
# minimum, its tail starts where the vector loop stopped).
@inline(never)
def encode_all(fractions: view[i64], out: mutable view[i64]) -> i64:
    written: mutable usize = 0
    pair: mutable usize = 0
    while pair + 1 < fractions.len:
        runs: mutable Run[64] = zeroed
        run_count: i64 = encode_path(fractions[pair], fractions[pair + 1], runs[0:64])
        return -1 if run_count < 0 or not append(out, written, run_count)
        index: mutable usize = 0
        while index < run_count.usize():
            return -1 if not append(out, written, runs[index].direction) or
                not append(out, written, runs[index].count)
            index <- index + 1
        pair <- pair + 2
    written.i64()

# Records pushed by a dispatch loop, copied out after it.
@inline(never)
def record_stack(input: view[i64], out: mutable view[i64]) -> i64:
    tags: mutable i64[128] = zeroed
    values: mutable i64[128] = zeroed
    count: mutable usize = 0
    position: mutable usize = 0
    while position < input.len:
        return -1 if count >= CAPACITY
        value: i64 = input[position]
        if value % 3 == 0:
            tags[count] <- 1
            values[count] <- value / 3
            count <- count + 1
        elif value % 3 == 1:
            tags[count] <- 2
            values[count] <- value * 2
            count <- count + 1
        position <- position + 1
    return -1 if count > out.len
    i: mutable usize = 0
    while i < count:
        out[i] <- tags[i] * 1000 + values[i]
        i <- i + 1
    count.i64()

# Copies one record past the count: the last is the fill's zero.
@inline(never)
def record_overcopy(input: view[i64], out: mutable view[i64]) -> i64:
    tags: mutable i64[128] = zeroed
    count: mutable usize = 0
    position: mutable usize = 0
    while position < input.len:
        return -1 if count >= CAPACITY - 1
        if input[position] % 2 == 0:
            tags[count] <- input[position] + 1
            count <- count + 1
        position <- position + 1
    return -1 if count + 1 > out.len
    i: mutable usize = 0
    while i <= count:
        out[i] <- tags[i]
        i <- i + 1
    count.i64()

def main() -> i32:
    out: mutable i64[256] = zeroed
    fractions: mutable i64[2] = zeroed
    numerator: mutable i64 = 1
    while numerator < 60:
        denominator: mutable i64 = 1
        while denominator < 60:
            fractions[0] <- numerator
            fractions[1] <- denominator
            return 9 if encode_all(fractions[0:2], out[0:256]) < 1
            # Decoding the runs from 1/1 gives back the fraction in lowest terms.
            lower_num: mutable i64 = 0
            lower_den: mutable i64 = 1
            upper_num: mutable i64 = 1
            upper_den: mutable i64 = 0
            k: mutable usize = 0
            while k < out[0].usize():
                if out[2 * k + 1] == 0:
                    upper_num <- upper_num + out[2 * k + 2] * lower_num
                    upper_den <- upper_den + out[2 * k + 2] * lower_den
                else:
                    lower_num <- lower_num + out[2 * k + 2] * upper_num
                    lower_den <- lower_den + out[2 * k + 2] * upper_den
                k <- k + 1
            got_num: i64 = lower_num + upper_num
            got_den: i64 = lower_den + upper_den
            return 10 if got_num * denominator != got_den * numerator
            denominator <- denominator + 1
        numerator <- numerator + 1
    input: mutable i64[120] = zeroed
    length: mutable usize = 0
    while length <= 120:
        fill: mutable usize = 0
        while fill < length:
            input[fill] <- (fill * 37 % 101).i64() + 1
            fill <- fill + 1
        count: i64 = record_stack(input[0:length], out[0:256])
        expected: mutable usize = 0
        j: mutable usize = 0
        while j < length:
            value: i64 = input[j]
            if value % 3 == 0:
                return 11 if out[expected] != 1000 + value / 3
                expected <- expected + 1
            elif value % 3 == 1:
                return 12 if out[expected] != 2000 + value * 2
                expected <- expected + 1
            j <- j + 1
        return 13 if count != expected.i64()
        over: i64 = record_overcopy(input[0:length], out[0:256])
        return 14 if over < 0 or out[over.usize()] != 0
        length <- length + 1
    0
