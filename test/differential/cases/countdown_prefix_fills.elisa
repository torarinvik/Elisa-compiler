# A zero-filled array written over its first `count` elements and then
# insertion-sorted in place reads only below `count`: the sort's countdown
# `j` starts at `i < count` and steps down only while it is nonzero, so it
# never wraps, and the fill is dead (ElisaIndexBounds on a countdown whose
# exit SCEV cannot count). The negatives start the countdown at `count`, or
# sort one element more than was written; those elements are the fill's
# zeros and must stay.
const CAPACITY: usize = 96

# Sorts the first `count` values ascending, then folds them low to high.
@inline(never)
def sorted_fold(input: view[i64], count: usize) -> i64:
    return -1 if count > CAPACITY or count > input.len
    values: mutable i64[96] = zeroed
    i: mutable usize = 0
    while i < count:
        values[i] <- input[i]
        i <- i + 1
    i <- 1
    while i < count:
        x: i64 = values[i]
        j: mutable usize = i
        while j != 0 and values[j - 1] > x:
            values[j] <- values[j - 1]
            j <- j - 1
        values[j] <- x
        i <- i + 1
    fold: mutable i64 = 0
    i <- 0
    while i < count:
        fold <- (fold * 7 + values[i]) % 1000003
        i <- i + 1
    fold

# Sorts one element more than it wrote: the zero past the prefix sorts first.
@inline(never)
def overcount_smallest(input: view[i64], count: usize) -> i64:
    return -1 if count >= CAPACITY or count > input.len
    values: mutable i64[96] = zeroed
    i: mutable usize = 0
    while i < count:
        values[i] <- input[i]
        i <- i + 1
    i <- 1
    while i <= count:
        x: i64 = values[i]
        j: mutable usize = i
        while j != 0 and values[j - 1] > x:
            values[j] <- values[j - 1]
            j <- j - 1
        values[j] <- x
        i <- i + 1
    values[0]

# Counts down from `count` itself, so the first read is the fill's zero.
@inline(never)
def countdown_from_count(input: view[i64], count: usize) -> i64:
    return -1 if count >= CAPACITY or count > input.len
    values: mutable i64[96] = zeroed
    i: mutable usize = 0
    while i < count:
        values[i] <- input[i]
        i <- i + 1
    sum: mutable i64 = 0
    j: mutable usize = count
    while j != 0:
        sum <- (sum * 3 + values[j] + 1) % 1000003
        j <- j - 1
    sum

def main() -> i32:
    input: mutable i64[90] = zeroed
    fill: mutable usize = 0
    while fill < 90:
        input[fill] <- (fill * 53 % 89).i64() + 1
        fill <- fill + 1
    count: mutable usize = 0
    while count <= 90:
        # Reference fold of the first `count` values in ascending order.
        fold: mutable i64 = 0
        candidate: mutable i64 = 1
        while candidate <= 89:
            seen: mutable usize = 0
            while seen < count:
                if input[seen] == candidate:
                    fold <- (fold * 7 + candidate) % 1000003
                seen <- seen + 1
            candidate <- candidate + 1
        return 10 if sorted_fold(input[0:90], count) != fold
        if count < 90:
            return 11 if overcount_smallest(input[0:90], count) != 0
            # values[count] is 0 and the others are read top down.
            expected: mutable i64 = 1
            k: mutable usize = count
            while k > 1:
                k <- k - 1
                expected <- (expected * 3 + input[k] + 1) % 1000003
            if count == 0:
                expected <- 0
            return 12 if countdown_from_count(input[0:90], count) != expected
        count <- count + 1
    0
