# A prefix conversion `usize(r)` of a reference to a scalar converts the POINTEE, exactly like the
# postfix `r.usize()`. stage1 converted the address instead, so indexing with it trapped (the
# self-hosted compiler crashed in imc_build_index on a `dict.get` binder). `uintptr(r)` alone
# means the address.
def pick(values: u32[4]&, slot: u32&) -> u32:
    values[usize(slot)]

def widen(slot: u8&) -> i64:
    i64(slot) + slot.i64()

def main() -> i32:
    values: u32[4] = [10, 20, 30, 40]
    slot: u32 = 2
    return 1 if pick(&values, &slot) != 30
    small: u8 = 7
    return 2 if widen(&small) != 14
    ref_local: u32& = &slot
    return 3 if u64(ref_local) != 2
    0
