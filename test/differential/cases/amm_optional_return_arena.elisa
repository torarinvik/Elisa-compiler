# A darray returned inside an Optional must come from the CALLER's arena (hidden
# arena parameter). From the callee's scratch arena, burn() reuses it: answer 0, not 4.
def mk(n: i64) -> darray[i64]?:
    xs: mutable darray[i64] = []
    for i in 0..<n:
        xs.push(i + 1)
    return xs

def burn() -> i64:
    t: mutable i64 = 0
    for j in 0..<50:
        ys: mutable darray[i64] = []
        for i in 0..<64:
            ys.push(99)
        t = t + ys[0]
    return t

def main() -> i64:
    o: darray[i64]? = mk(40)
    b: i64 = burn()
    if o is v:
        return v[3] + b - b
    return 1
