# A string literal branch or arm beside an sview one: stage0 types the value as sview, so an
# inferred binding of it lowers. stage1 typed the literal cstr and declined the function.
def pick_if(n: i64, v: sview) -> sview:
    s = "zero" if n == 0 else v
    return s

def pick_if_rev(n: i64, v: sview) -> sview:
    s = v if n == 0 else "many"
    return s

def pick_match(n: i64, v: sview) -> sview:
    s = match n:
        0: "zero"
        1: v
        _: "many!"
    return s

def pick_match_first(n: i64, v: sview) -> sview:
    s = match n:
        0: v
        _: "x"
    return s

def main() -> i32:
    return 1 if pick_if(0, "other").len != 4
    return 2 if pick_if(1, "other").len != 5
    return 3 if pick_if_rev(0, "vv").len != 2
    return 4 if pick_if_rev(1, "vv").len != 4
    return 5 if pick_match(0, "ab").len != 4
    return 6 if pick_match(1, "ab").len != 2
    return 7 if pick_match(2, "ab").len != 5
    return 8 if pick_match_first(0, "abc").len != 3
    return 9 if pick_match_first(5, "abc").len != 1
    0
