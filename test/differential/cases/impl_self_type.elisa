# `Self` as a TYPE inside an impl member -- parameter and return -- for a struct
# receiver and a scalar receiver.
#
# stage1 declined every one of them: the parser leaves the name alone, and the
# backend resolved it as an unknown type name. It is now bound to the impl's
# receiver for the member's declaration and body, the way a generic binds `T`
# (record_impl_member_lines keys each member's line to its receiver). The
# conformance checker also accepted `Self` only in the PROTOCOL's return and
# reported the impl's `-> Self` as a mismatch against the concrete type.
protocol Shape:
    def area(self: Self) -> f32

protocol Doubled:
    def doubled(self: Self) -> Self

struct Circle:
    r: f32

impl Shape for Circle:
    def area(self: Self) -> f32:
        return 3.0 * self.r * self.r

impl Doubled for i64:
    def doubled(self: Self) -> Self:
        return self * 2

def main() -> i64:
    c: Circle = Circle{r: 2.0}
    return 1 if c.area() != 12.0
    x: i64 = 21
    return 2 if x.doubled() != 42
    return 0
