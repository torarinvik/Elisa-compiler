# A zero-filled scratch array declared inside a loop is filled again on
# every trip, then written over its first `count` elements and handed to a
# helper as `runs[0:count]` in the same trip: the helper reads only written
# elements, so the repeated fill is dead (ElisaIndexedPrefix: a fill loop
# proves reads that cannot reach the fill without leaving that loop in the
# fill's own trip). The negatives hand the helper one element more than was
# written, or read the array after a trip that wrote fewer elements, and
# must see the fill's zeros.
const CAPACITY: usize = 64

def fold(values: view[i64]) -> i64:
    total: mutable i64 = 7
    index: mutable usize = 0
    while index < values.len:
        total <- (total * 31 + values[index]) % 1000003
        index <- index + 1
    total

@inline(never)
def process(input: view[i64], extra: usize) -> i64:
    position: mutable usize = 0
    result: mutable i64 = 0
    while position < input.len:
        count: usize = input[position].usize()
        return -1 if count > CAPACITY or position + 1 + count > input.len
        scratch: mutable i64[64] = zeroed
        index: mutable usize = 0
        while index < count:
            scratch[index] <- input[position + 1 + index]
            index <- index + 1
        end: usize = count + extra
        result <- (result * 131 + fold(scratch[0:end])) % 1000003
        position <- position + 1 + count
    result

def reference(input: view[i64], extra: usize) -> i64:
    position: mutable usize = 0
    result: mutable i64 = 0
    while position < input.len:
        count: usize = input[position].usize()
        total: mutable i64 = 7
        index: mutable usize = 0
        while index < count + extra and index < CAPACITY:
            value: i64 = input[position + 1 + index] if index < count else 0
            total <- (total * 31 + value) % 1000003
            index <- index + 1
        result <- (result * 131 + total) % 1000003
        position <- position + 1 + count
    result

def main() -> i32:
    input: mutable i64[200] = zeroed
    length: mutable usize = 0
    count: mutable usize = 9
    while length + 1 + count <= 200:
        input[length] <- count.i64()
        k: mutable usize = 0
        while k < count:
            input[length + 1 + k] <- ((length + k) * 37 % 101).i64() + 1
            k <- k + 1
        length <- length + 1 + count
        count <- (count * 7 + 3) % 23
    return 10 if process(input[0:length], 0) != reference(input[0:length], 0)
    return 11 if process(input[0:length], 1) != reference(input[0:length], 1)
    0
