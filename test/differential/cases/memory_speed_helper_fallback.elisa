def early(input_count: i64) -> i64:
    work: mutable darray[i64] = []
    for index in 0..<input_count |work|:
        work.push(index)
    return 17 if input_count == 0
    return work.count.i64()

def collision(input_count: i64) -> i64:
    work: mutable darray[i64] = []
    for index in 0..<input_count |work|:
        work.push(index)
    return work[0]

def main() -> i64:
    input_count: i64 = 9
    for round in 0..<5:
        a: i64 = early(0)
        b: i64 = collision(1)
        return 1 if a != 17 or b != 0 or input_count != 9
    return 0
