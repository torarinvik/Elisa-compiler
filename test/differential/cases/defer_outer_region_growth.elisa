# A deferred body captures the declaration-time arena for a container. The outer array must not
# grow from the nested region merely because the defer runs while that region is active: the
# nested arena is freed immediately after the defer body finishes.
def main() -> i64:
    outer: mutable darray[i64] = []
    region scratch(4096):
        defer block:
            outer.push(40)
    if outer[0] != 40:
        return 1
    return 0
