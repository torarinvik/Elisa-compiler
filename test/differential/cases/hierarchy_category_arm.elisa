# A CATEGORY ARM (docs/77 §2): an `InputEvent input:` arm covers every leaf of
# that sub-category, so a match over the root discharges the whole subtree with
# one arm. Dispatch is the docs/81 range primitive over the category's leaf-tag
# span -- leaves are numbered in pre-order, so a category's are contiguous.
#
# A NESTED category must beat its ancestor when it comes first, and an ancestor
# arm must still catch the leaves the narrower arm left, so the two below are
# ordered narrow-then-wide on purpose.
enum Event:
    None
    Quit

enum InputEvent is Event:
    pass

enum MouseEvent is InputEvent:
    Move
    Down

enum KeyEvent is InputEvent:
    Press(code: i32)

def classify(event: Event) -> i64:
    match event:
        InputEvent input:
            return 1
        Event.Quit:
            return 2
        Event.None:
            return 3

# The narrow category is listed FIRST, so it must win over the ancestor arm that
# would otherwise swallow it.
def narrow_first(event: Event) -> i64:
    match event:
        MouseEvent mouse:
            return 10
        InputEvent input:
            return 20
        Event.Quit:
            return 30
        Event.None:
            return 40

# A category arm sits beside ordinary leaf arms, including one carrying a payload.
def mixed(event: Event) -> i64:
    match event:
        KeyEvent.Press(code):
            return code.i64()
        InputEvent input:
            return 7
        Event.None:
            return 8
        Event.Quit:
            return 9

def main() -> i64:
    return 1 if classify(MouseEvent.Move) != 1
    return 2 if classify(MouseEvent.Down) != 1
    return 3 if classify(KeyEvent.Press(code: 4)) != 1
    return 4 if classify(Event.Quit) != 2
    return 5 if classify(Event.None) != 3

    return 6 if narrow_first(MouseEvent.Move) != 10
    return 7 if narrow_first(MouseEvent.Down) != 10
    return 8 if narrow_first(KeyEvent.Press(code: 1)) != 20
    return 9 if narrow_first(Event.Quit) != 30
    return 10 if narrow_first(Event.None) != 40

    return 11 if mixed(KeyEvent.Press(code: 5)) != 5
    return 12 if mixed(MouseEvent.Move) != 7
    return 13 if mixed(Event.None) != 8
    return 14 if mixed(Event.Quit) != 9
    return 0
