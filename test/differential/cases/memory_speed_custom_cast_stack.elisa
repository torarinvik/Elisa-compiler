# A user hook for an otherwise builtin scalar conversion can have effects. The stack
# placement proof must honor the same exact __cast__ lookup as direct-call lowering.
global mutable cast_calls: i64 = 0

def __cast__(value: i64) -> i64 can[Global.Write]:
    cast_calls <- cast_calls + 1
    return value + 1

def main() -> i64:
    values: darray[i64] = []
    for index in 0..<4:
        values.push(index.i64())
    total: mutable i64 = 0
    for value in values |total|:
        total <- total + value
    return 1 if total != 10 or cast_calls != 4
    return 0
