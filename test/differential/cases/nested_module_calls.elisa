# A module declared INSIDE another module's body. stage0 names its members
# `Outer.Inner.run`; stage1 used to declare them under a bare `Inner` at one nesting level
# and every call into them declined (plan §3.1.5). Three call spellings are exercised: the
# fully qualified `Outer::Inner::run()`, the bare `Inner::run()` from inside `Outer`, and a
# sibling function of `Outer` reached from `main`.
module Outer:
    public:
        module Inner:
            public:
                def run() -> i64:
                    return 6
                def twice(v: i64) -> i64:
                    return v * 2
        def go() -> i64:
            return Inner::run() + Inner::twice(2)

def main() -> i64:
    1 return if Outer::go() != 10
    2 return if Outer::Inner::run() != 6
    3 return if Outer::Inner::twice(5) != 10
    return 0
