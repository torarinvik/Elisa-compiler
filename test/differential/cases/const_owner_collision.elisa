# Two modules declare the same const NAME with different values; each module's
# derived consts and array extents must fold with ITS OWN. stage1 once resolved
# the bare name through whichever owner was current, so B's SIZE folded with A's
# CAP -- and a global sized by the wrong extent is a silent out-of-bounds store
# waiting for the first index past the smaller size.
extern atoi(text: cstr) -> i32

module A:
    public:
        const CAP: usize = 256
        const SIZE: usize = CAP * 2
        global mutable buf: u8[SIZE] = zeroed

module B:
    public:
        const CAP: usize = 1024
        const SIZE: usize = CAP * 2
        global mutable buf: u8[SIZE] = zeroed
        global mutable direct: u8[CAP] = zeroed

        def poke(index: usize) -> void:
            # A runtime index: with the extent folded to 256 this traps.
            direct[index] <- 1
            buf[index * 2 + 1] <- 2

def main() -> i64:
    B::poke(atoi("1023").usize())
    return 1 if B::SIZE != 2048 or A::SIZE != 512 or B::CAP != 1024
    return 0
