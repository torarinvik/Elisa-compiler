# A user sealed hierarchy two levels deep (`Button is Control is Widget`, docs/77).
#
# XFAIL: the SEMANTIC layer accepts this today (the deep-chain, mismatch, and
# exhaustiveness fixes landed with this case), but the BACKEND still lowers sealed
# hierarchies only for the compiler's own AST: ~14 sites resolve a hierarchy to the
# literal name "Node", and neither representation is built for a user hierarchy —
# the non-recursive form needs the inline union merged across the tree (stage0:
# `%Widget = {i32, [3 x i64]}`, hierarchy-global tags), and the recursive form needs
# the unified AoS store threaded through the ABI (stage0: `count_widgets(i32 handle,
# %Widget__Store)`). Promoting hierarchies to the store path WITHOUT those two pieces
# compiles, passes every answer gate, and breaks the gen3 fixpoint — measured, then
# reverted. test/repro/hierarchy_recursive_store.elisa is the recursive counterpart.
#
# Promote out of .xfail once the backend lowers user hierarchies.
enum Widget layout(handle: u32):
    pass

enum Container is Widget:
    Panel(axis: i32)

enum Control is Widget:
    Label(text: sview)

enum Button is Control:
    Push(label: sview)
    Check(label: sview, checked: bool)

def widget_kind(w: Widget) -> i64:
    match w:
        Container.Panel(axis):
            return 1
        Control.Label(text):
            return 2
        Button.Push(label):
            return 3
        Button.Check(label, checked):
            return 4

def control_text(c: Control) -> sview:
    match c:
        Control.Label(text):
            return text
        Button.Push(label):
            return label
        Button.Check(label, checked):
            return label

def main() -> i64:
    b: Widget = Button.Check("ok", true)
    return widget_kind(b) - 4
