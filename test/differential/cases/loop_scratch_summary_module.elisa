# Module-qualified helpers and scalar parameters on both sides of the borrow.
module Reading:
    public:
        def scaled(scale: i64, xs: darray[i64]&, bias: i64) -> i64:
            return selected(scale, xs, bias)
        def selected(scale: i64, xs: darray[i64]&, bias: i64) -> i64:
            return xs[0] * scale + bias

def main() -> i64:
    total: mutable i64 = 0
    for i in 0..<4 |total|:
        xs: mutable darray[i64] = []
        xs.push(i)
        total <- total + Reading::scaled(2, &xs, 3)
    return 0 if total == 24 else 1
