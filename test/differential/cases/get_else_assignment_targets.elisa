# `get <expr> else <control-flow>` in ASSIGNMENT position. The construct carries control
# flow, so emit_expression has no case for it and every assignment form declined the
# enclosing function -- `x = get xs[i] else …`, the rebind `x <- …`, and a field target --
# while stage0 compiled and ran all three. Only a case that RUNS shows it: the decline was
# reported as "backend could not produce a linkable unit", never as a wrong answer.

struct Box:
    v: mutable i64

def find(xs: darray[i64]&, index: usize) -> i64?:
    return xs[index] if index < xs.count else null

# `=` introduces a new local from a checked index.
def pick(xs: darray[i64]&, index: usize) -> i64:
    value = get xs[index] else return -1
    return value

# Two of them in one function: both synthetic declarations carry the same name.
def sum_two(xs: darray[i64]&, first: usize, second: usize) -> i64:
    a = get xs[first] else return -2
    b = get xs[second] else return -3
    return a + b

# `<-` rebinds an existing mutable local, from a checked index.
def pick_rebind(xs: darray[i64]&, index: usize) -> i64:
    value: mutable i64 = 0
    value <- get xs[index] else return -4
    return value

# `<-` from an OPTIONAL-returning call, the other guarded shape.
def pick_optional(xs: darray[i64]&, index: usize) -> i64:
    value: mutable i64 = 0
    value <- get find(xs, index) else return -5
    return value

# A struct FIELD as the target.
def fill(box: mutable Box&, xs: darray[i64]&, index: usize) -> void:
    box.v <- get xs[index] else return
    return

def main() -> i64:
    xs: mutable darray[i64] = [10, 20, 30]
    return 1 if pick(&xs, 0) != 10
    return 2 if pick(&xs, 99) != -1
    return 3 if sum_two(&xs, 0, 2) != 40
    return 4 if sum_two(&xs, 0, 99) != -3
    return 5 if pick_rebind(&xs, 1) != 20
    return 6 if pick_rebind(&xs, 99) != -4
    return 7 if pick_optional(&xs, 2) != 30
    return 8 if pick_optional(&xs, 99) != -5
    box: mutable Box = Box{v: 7}
    fill(&box, &xs, 1)
    return 9 if box.v != 20
    fill(&box, &xs, 99)
    return 10 if box.v != 20
    return 0
