include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/collections.elisa"
include "../../../elisacore_std/elisacore_runtime_strings.elisa"

# The receiver depends on the loop binder, so the original loop must evaluate
# its target for each byte instead of hoisting one receiver for a bulk append.
def main() -> i64:
    text: sview = "ab"
    outputs: mutable darray[darray[u8]] = [[], []]
    index: usize = 0
    for index in 0..<sview_len(text) |outputs, text|:
        can Unsafe.UncheckedIndex:
            outputs[index].push(sview_at(text, index))
    return 1 if outputs[0].count != 1 or outputs[1].count != 1
    return 2 if outputs[0][0] != 97 or outputs[1][0] != 98
    return 0
