# A local annotated `T&` (no `mutable`) initialised from a `-> mutable T&` call is a
# WRITE-THROUGH binding: `r <- v` stores into the referent (stage0 exit 99 here). stage1's
# semantic layer used to reject it as "cannot assign to immutable local" (memory:
# write-through-ref-gap). A `mutable T&` local is a REBIND target instead; a `&x` or
# field initializer keeps the strict classification.
global mutable g: i64 = 42
global mutable h: i64 = 7

def get_ref() -> mutable i64&:
    return &g

module M:
    public:
        def other_ref() -> mutable i64&:
            return &h

def main() -> i64:
    r: i64& = get_ref()
    r <- 99
    1 return if g != 99
    s: i64& = M::other_ref()
    s <- s + 1
    2 return if h != 8
    return 0
