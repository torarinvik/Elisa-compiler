# A sealed hierarchy that is NOT store-backed -- no `packed`, no recursive member,
# no `common:` -- is an INLINE tagged union (docs/76/77): no region, no store,
# no allocation per value. Tags are numbered in pre-order across the tree, a
# refinement is the same type as its root (an upcast is a typed no-op), and a
# leaf may carry a payload. stage0 has always lowered it this way; stage1 put
# every `is` edge on the AoS store, so an event kind allocated a row per value.
enum Event:
    None
    Quit

enum InputEvent is Event:
    pass

enum MouseEvent is InputEvent:
    Move(x: f32, y: f32)
    Scroll(dy: f32)

enum KeyboardEvent is InputEvent:
    KeyDown(code: i32)
    KeyUp(code: i32)

# A second hierarchy whose leaf shares a NAME with one above: owner-qualified
# lookup must keep them apart.
enum Gesture:
    Idle

enum Swipe is Gesture:
    Move(direction: i32)

def __cast__(event: Event) -> i32:
    match event:
        Event.None:
            return 0
        Event.Quit:
            return 1
        MouseEvent.Move(x, y):
            return 2
        MouseEvent.Scroll(dy):
            return 9
        KeyboardEvent.KeyDown(code):
            return 6
        KeyboardEvent.KeyUp(code):
            return 7

def widen(m: MouseEvent) -> Event:
    return m

struct Frame:
    kind: mutable Event
    ticks: mutable i64

def payload_sum(event: Event) -> f32:
    match event:
        MouseEvent.Move(x, y):
            return x + y
        MouseEvent.Scroll(dy):
            return dy
        KeyboardEvent.KeyDown(code):
            return code.f32()
        KeyboardEvent.KeyUp(code):
            return 0.0 - code.f32()
        Event.None:
            return 0.0
        Event.Quit:
            return -1.0

def main() -> i64:
    # no region anywhere: values are inline
    a: Event = MouseEvent.Move(x: 1.5, y: 2.5)
    return 1 if a.i32() != 2
    return 2 if payload_sum(a) != 4.0
    b: Event = widen(MouseEvent.Scroll(dy: 3.0))
    return 3 if b.i32() != 9 or payload_sum(b) != 3.0
    k: KeyboardEvent = KeyboardEvent.KeyUp(code: 5)
    return 4 if payload_sum(k) != -5.0
    frame: mutable Frame = Frame{kind: Event.Quit, ticks: 0}
    return 5 if frame.kind.i32() != 1
    for step in 0..<1000 |frame|:
        frame.kind <- KeyboardEvent.KeyDown(code: step.i32())
        frame.ticks <- frame.ticks + 1
    return 6 if frame.kind.i32() != 6 or payload_sum(frame.kind) != 999.0
    g: Gesture = Swipe.Move(direction: 4)
    match g:
        Swipe.Move(direction):
            return 7 if direction != 4
        Gesture.Idle:
            return 8
    return 0
