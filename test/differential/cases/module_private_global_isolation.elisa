# Two modules, identically spelled PRIVATE globals. Each module's functions must see
# only their own storage. Returns 0 when every assertion holds; a distinct nonzero
# code names the first assertion that failed.

module A:
    private:
        global mutable counter: i64 = 11
        global mutable values: i64[3] = [1, 2, 3]

    public:
        def read() -> i64:
            return counter

        def read_at(index: usize) -> i64:
            return values[index]

        def write(v: i64) -> void:
            counter <- v

        def write_at(index: usize, v: i64) -> void:
            values[index] <- v

        def reset() -> void:
            counter <- 11
            values[0] <- 1
            values[1] <- 2
            values[2] <- 3

module B:
    private:
        global mutable counter: i64 = 73
        global mutable values: i64[3] = [7, 8, 9]

    public:
        def read() -> i64:
            return counter

        def read_at(index: usize) -> i64:
            return values[index]

        def write(v: i64) -> void:
            counter <- v

        def write_at(index: usize, v: i64) -> void:
            values[index] <- v

        def reset() -> void:
            counter <- 73
            values[0] <- 7
            values[1] <- 8
            values[2] <- 9

def main() -> i64:
    # initial values are each module's own
    1 return if A::read() != 11
    return check2()

def check2() -> i64:
    2 return if B::read() != 73
    3 return if A::read_at(0) != 1 or A::read_at(2) != 3
    4 return if B::read_at(0) != 7 or B::read_at(2) != 9
    # writing A must not move B
    A::write(100)
    5 return if A::read() != 100
    6 return if B::read() != 73
    # writing B must not move A
    B::write(200)
    7 return if B::read() != 200
    8 return if A::read() != 100
    # arrays, interleaved
    A::write_at(1, 50)
    9 return if A::read_at(1) != 50
    10 return if B::read_at(1) != 8
    B::write_at(1, 60)
    11 return if B::read_at(1) != 60
    12 return if A::read_at(1) != 50
    # reset one, the other keeps its mutation
    A::reset()
    13 return if A::read() != 11 or A::read_at(1) != 2
    14 return if B::read() != 200 or B::read_at(1) != 60
    B::reset()
    15 return if B::read() != 73 or B::read_at(1) != 8
    16 return if A::read() != 11
    return 0
