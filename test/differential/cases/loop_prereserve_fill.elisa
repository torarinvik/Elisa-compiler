# Counted fills of an outer local darray reserve their growth once before the loop
# (codegen_loop_prereserve). Capacity is only a hint: every shape below must still
# produce exactly the elements the loop pushes, including a zero trip count,
# two pushes per iteration, a receiver that already holds elements, a conditional push
# (not counted), a struct element, a `for x in src` fill and an unsigned bound.
# (A NEGATIVE bound is left out on purpose: stage0's own auto-reserve multiplies it as
# unsigned and traps, e.g. `for i in 0..<n` with n = -5 and two pushes per iteration.)
struct Pair:
    a: i64
    b: i64

def fill(n: i64) -> i64:
    xs: mutable darray[i64] = []
    for i in 0..<n |xs|:
        xs.push(i)
        xs.push(i * 2)
    total: mutable i64 = 0
    for x in xs |total|:
        total <- total + x
    return total * 1000 + xs.count.i64()

def main() -> i64:
    return 2 if fill(0) != 0
    return 3 if fill(1) != 2
    return 4 if fill(10) != 135020
    ys: mutable darray[i64] = [7, 8, 9]
    for i in 0..<5 |ys|:
        ys.push(i)
        if i % 2 == 0:
            ys.push(100)
    return 5 if ys.count != 11 or ys[3] != 0 or ys[4] != 100 or ys[10] != 100
    ps: mutable darray[Pair] = []
    for i in 0..<300 |ps|:
        ps.push(Pair{a: i, b: -i})
    return 6 if ps.count != 300 or ps[299].a != 299 or ps[299].b != -299
    zs: mutable darray[i64] = []
    for y in ys |zs|:
        zs.push(y + 1)
    return 7 if zs.count != ys.count or zs[0] != 8 or zs[10] != 101
    n: usize = 70
    us: mutable darray[u8] = []
    for i in 0..<n |us|:
        us.push(i.u8())
    return 8 if us.count != 70 or us[69] != 69
    return 0
