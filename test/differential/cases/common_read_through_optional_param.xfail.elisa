# Reading a `common:` field through an `is` binding whose source is an optional
# PARAMETER declines in stage1's backend; the identical read through an optional
# LOCAL compiles. The receiver type of the binding does not resolve to the packed
# enum when the optional came in as a parameter, so the common-read path's
# `pcf_receiver.kind == TypeKind.PackedEnum` gate never opens.
#
# The workaround is one line -- copy the parameter into a local first -- which is
# what elisa-ui's widget layer does. stage0 compiles neither shape (it drops the
# `?` from an optional-typed common, see optional_common_links.xfail), so this
# case is recorded against stage1 alone and skips on stage0.
enum Widget:
    common:
        @storage(inline)
        pressed: mutable bool
        @storage(inline)
        next_sibling: mutable Widget?
    pass

enum Leaf is Widget:
    Button(size: f32)

def make(size: f32) -> Widget can[Memory.Allocate, Abort.Panic]:
    return Leaf.Button(pressed: false, next_sibling: null, size: size)

# read a common through an is-bound optional PARAMETER
def read_param(target: Widget?) -> bool:
    got: mutable bool = false
    if target is node:
        got <- node.pressed
    return got

# read a common through an is-bound optional LOCAL
def read_local(source: Widget) -> bool:
    target: Widget? = source
    got: mutable bool = false
    if target is node:
        got <- node.pressed
    return got

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        region ui(65536):
            w: Widget = make(1.0)
            w.pressed <- true
            return 1 if not read_local(w)
            return 2 if not read_param(w)
            return 0
