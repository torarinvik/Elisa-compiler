def fill[@left_region, @right_region](left: mutable darray[i64]& @left_region, right: mutable darray[i64]& @right_region) -> void:
    region scratch(4096):
        in left_region:
            left.push(17)
        in right_region:
            right.push(25)
def main() -> i64:
    left: mutable darray[i64] = []
    right: mutable darray[i64] = []
    fill(&left, &right)
    return 0 if left[0] + right[0] == 42 else 1
