include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/collections.elisa"

# Same-shaped user helpers are not the runtime's string-view operations. The
# optimized byte-copy loop must preserve these implementations' semantics.
def sview_len(text: sview) -> usize:
    return 1

def sview_at(text: sview, index: usize) -> u8:
    return 88

def append_custom_bytes(out: mutable darray[u8]&, text: sview) -> void:
    for index in 0..<sview_len(text) |out, text|:
        can Unsafe.UncheckedIndex:
            out.push(sview_at(text, index))

def main() -> i64:
    out: mutable darray[u8] = []
    append_custom_bytes(&out, "A")
    return 1 if out.count != 1
    return 2 if out[0] != 88
    return 0
