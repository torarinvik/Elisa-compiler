# stage1 accepts __drop__ and never emits the call; stage0 runs it. Promote out
# of .xfail once stage1 lowers destructors.
global mutable log: i64 = 0

struct Tracked:
    mark: i64

def __drop__(self: Tracked) -> void:
    log <- log * 10 + self.mark

def scoped() -> void:
    t: Tracked = Tracked{mark: 2}
    _ = t.mark

def early(bail: bool) -> i64:
    t: Tracked = Tracked{mark: 3}
    return 1 if bail
    return 0

def main() -> i64:
    scoped()
    return 1 if log != 2
    _ = early(true)
    return 2 if log != 23
    return 0
