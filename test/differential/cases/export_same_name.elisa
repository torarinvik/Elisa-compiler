# Same-name exports: `export fn foo(...) = foo`, `export type T as T`,
# `export global G as G`. The export is the implementation when the lowering
# already matches the C ABI, and a wrapper over `foo.impl` when it does not
# (an 8-byte aggregate crosses as an integer). Internal callers must be
# unaffected by either. Both compilers return 0.
struct Vec2 layout(c):
    x: i32
    y: i32
export type Vec2 as Vec2

global MAGIC: i32 = 1337
export global MAGIC as MAGIC

def add(a: i32, b: i32) -> i32:
    return a + b
export fn add(a: i32, b: i32) -> i32 = add

def vec2_sum(v: Vec2) -> i32:
    return v.x + v.y
export fn vec2_sum(v: Vec2) -> i32 = vec2_sum

def mul_impl(a: i32, b: i32) -> i32:
    return a * b
export fn mul(a: i32, b: i32) -> i32 = mul_impl

def main() -> i64:
    v: Vec2 = Vec2{x: 3, y: 4}
    return 1 if add(1, 2) != 3
    return 2 if vec2_sum(v) != 7
    return 3 if mul_impl(6, 7) != 42
    return 4 if MAGIC != 1337
    return 5 if add(vec2_sum(v), MAGIC) != 1344
    return 0
