# Forward references require summaries to reach a fixed point.
def read_twice(xs: darray[i64]&) -> i64:
    return read_first(xs) + read_first(xs)
def read_first(xs: darray[i64]&) -> i64:
    return xs[0]
def main() -> i64:
    total: mutable i64 = 0
    for i in 0..<4 |total|:
        xs: mutable darray[i64] = []
        xs.push(i)
        total <- total + read_twice(&xs)
    return 0 if total == 12 else 1
