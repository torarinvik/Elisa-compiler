# Initializers and updates share lexical block scope; the tail sees local shadows.
def main() -> i64:
    outer: i64 = 100
    typed: i64 =
        outer: i64 = 40
        outer + 2
    return 1 if typed != 42
    return 2 if outer != 100
    inferred =
        outer: i64 = 6
        outer * 7
    return 3 if inferred != 42
    return 4 if outer != 100
    literal =
        40 + 2
    return 5 if literal != 42
    changed: mutable i64 = 2
    changed <-
        outer: i64 = changed + 5
        outer * 6
    return 6 if changed != 42
    return 7 if outer != 100
    nested: i64 =
        local: i64 =
            outer: i64 = 20
            outer + 1
        local * 2
    return 8 if nested != 42
    decision: i64 =
        threshold: i64 = 40
        if typed > threshold:
            extra: i64 = 2
            threshold + extra
        else:
            0
    return 9 if decision != 42
    folded: i64 =
        for item in 0..<7 |sum: i64 = 0| -> sum:
            sum <- sum + item
    return 10 if folded != 21
    captured: mutable i64 = 1
    result: i64 = |captured|
        captured <- captured + 2
        captured * 14
    return 11 if result != 42 or captured != 3
    inferred_choice =
        if typed == 42:
            local: i64 = 21
            local * 2
        else:
            0
    return 12 if inferred_choice != 42
    inferred_fold =
        for item in 0..<7 |sum: i64 = 0| -> sum:
            sum <- sum + item
    return 13 if inferred_fold != 21
    return 0
