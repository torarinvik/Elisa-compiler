# A user sealed hierarchy two levels deep (`Button is Control is Widget`, docs/77).
#
# Regression coverage for a user sealed hierarchy two levels deep
# (`Button is Control is Widget`). The backend now uses the hierarchy's canonical
# root layout and tags for construction, matching, and reads through each base type.
enum Widget layout(handle: u32):
    pass

enum Container is Widget:
    Panel(axis: i32)

enum Control is Widget:
    Label(text: sview)

enum Button is Control:
    Push(label: sview)
    Check(label: sview, checked: bool)

def widget_kind(w: Widget) -> i64:
    match w:
        Container.Panel(axis):
            return 1
        Control.Label(text):
            return 2
        Button.Push(label):
            return 3
        Button.Check(label, checked):
            return 4

def control_text(c: Control) -> sview:
    match c:
        Control.Label(text):
            return text
        Button.Push(label):
            return label
        Button.Check(label, checked):
            return label

def main() -> i64:
    b: Widget = Button.Check("ok", true)
    return widget_kind(b) - 4
