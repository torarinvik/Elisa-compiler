# A RECURSIVE `packed enum` (with an `@storage(inline)` common) built and walked through
# its store. stage0 keeps a declared `packed enum` on the canonical variant-sparse row even
# when it is recursive -- only a plain `enum` promoted by recursion takes the dynamic AoS row
# (packedModeForPackedEnum's RecursivePlain) -- and stage1 now makes the same choice. The
# handles sit side by side in one payload word, so a reader that assumed one word per
# field would bind `right` to node 0.

packed enum Node:
    common:
        @storage(inline)
        t: u32
    Leaf(v: i64)
    Pair(left: Node, right: Node)

def sum(n: Node, store: Node.Store[Local]) -> i64:
    match n in store:
        Node.Leaf(v):
            return v
        Node.Pair(l, r):
            return sum(l, store) + sum(r, store)
    return -1

def build(owner: Arena) -> i64 can[Memory.Allocate, Abort.Panic]:
    store: Node.Store[Local] = Node.Store(owner)
    a: Node = Node.Leaf(t: 1, v: 30)
    b: Node = Node.Leaf(t: 2, v: 12)
    c: Node = Node.Pair(t: 3, left: a, right: b)
    d: Node = Node.Pair(t: 4, left: c, right: a)
    return 1 if sum(d, store) != 72
    return 2 if d.t != 4.u32()
    return 3 if b.t != 2.u32()
    return 0

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        region r(65536):
            return build(r)
    return 5
