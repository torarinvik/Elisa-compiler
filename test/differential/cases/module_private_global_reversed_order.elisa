# Same program as two_modules, B declared FIRST. Order must not change behaviour.
module B:
    private:
        global mutable counter: i64 = 73
        global mutable values: i64[3] = [7, 8, 9]
    public:
        def read() -> i64:
            return counter
        def read_at(index: usize) -> i64:
            return values[index]
        def write(v: i64) -> void:
            counter <- v
        def write_at(index: usize, v: i64) -> void:
            values[index] <- v

module A:
    private:
        global mutable counter: i64 = 11
        global mutable values: i64[3] = [1, 2, 3]
    public:
        def read() -> i64:
            return counter
        def read_at(index: usize) -> i64:
            return values[index]
        def write(v: i64) -> void:
            counter <- v
        def write_at(index: usize, v: i64) -> void:
            values[index] <- v

def main() -> i64:
    return 1 if A::read() != 11
    return 2 if B::read() != 73
    A::write(100)
    return 3 if B::read() != 73
    B::write_at(2, 99)
    return 4 if A::read_at(2) != 3
    return 5 if B::read_at(2) != 99
    return 0
