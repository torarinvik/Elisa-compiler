# A GENERIC helper inside each module reads that module's own private state; instantiation
# bodies are emitted from a queue long after the walk, which is where the owner was once
# lost for calls (module_generic_sibling_call). Here it is the global that must not drift.
module A:
    private:
        global mutable counter: i64 = 11
    public:
        def read_as[T](seed: T) -> i64:
            return counter
        def read() -> i64:
            return read_as(1) + read_as(2) - read_as(3)
        def bump() -> void:
            counter <- counter + 1

module B:
    private:
        global mutable counter: i64 = 73
    public:
        def read_as[T](seed: T) -> i64:
            return counter
        def read() -> i64:
            return read_as(1) + read_as(2) - read_as(3)
        def bump() -> void:
            counter <- counter + 1

# Unrelated declarations, which must change nothing.
global mutable unrelated: i64 = 5
const LIMIT: i64 = 9
def helper() -> i64:
    return unrelated + LIMIT

def main() -> i64:
    1 return if A::read() != 11
    2 return if B::read() != 73
    A::bump()
    3 return if A::read() != 12
    4 return if B::read() != 73
    B::bump()
    B::bump()
    5 return if B::read() != 75
    6 return if A::read() != 12
    7 return if helper() != 14
    return 0
