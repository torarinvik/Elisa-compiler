# A stack-promoted buffer must not escape through a value block's tail expression.
# The clobber() frame overwrites it: 160/255, not 4.
def make(flag: bool) -> darray[i64]:
    x: darray[i64] =
        if flag:
            buf: darray[i64] = [1, 2, 3]
            buf
        else:
            [4]
    return x

def clobber(a: i64, b: i64, c: i64) -> i64:
    arr: i64[16] = [a, b, c, a, b, c, a, b, a, b, c, a, b, c, a, b]
    return arr[3] + arr[7]

def main() -> i64:
    y: darray[i64] = make(true)
    k: i64 = clobber(70, 80, 90)
    return y[0] + y[2] + k - k
