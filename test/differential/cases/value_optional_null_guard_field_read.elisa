# `v.value` on a VALUE optional (`Box?`) after an early-return null guard -- the smart-cast
# shape. stage0 narrows `v` for the rest of the function and reads the field off the
# payload; stage1 declined the whole function ("field expression") and, because the caller
# still referenced it, exited 2 with no object. The guard is what makes the payload read
# sound: only a path in the backend's proof set reads through.
struct Box:
	value: i32
	weight: i64

def maybe_box(flag: bool) -> Box?:
	if flag:
		return Box{value: 7, weight: 30}
	return null

def unwrap_or(flag: bool) -> i32:
	value: Box? = maybe_box(flag)
	if value == null:
		return 11
	return value.value

def weigh(flag: bool) -> i64:
	box: Box? = maybe_box(flag)
	return 0 if box == null
	return box.weight + 1

def main() -> i64:
	return 1 if unwrap_or(true) != 7
	return 2 if unwrap_or(false) != 11
	return 3 if weigh(true) != 31
	return 4 if weigh(false) != 0
	return 0
