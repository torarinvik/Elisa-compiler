# Two modules that each declare `step` and `probe` with DIFFERENT error families. The
# fallible-callee lookup matched by NAME alone, so the second module's `try step(...)` was
# told it propagated the FIRST module's family ("cannot propagate AErr from a function
# returning BErr"). The whole WasmBrowser SDK model build failed on exactly this shape,
# between WasmBrowser::Delivery and WasmBrowser::Permissions.
error AErr:
	ABad

error BErr:
	BBad

module Mods::A:
	public:
		def step(n: i64) -> i64 error[AErr]:
			raise AErr.ABad if n < 0
			return n + 1

		def probe_a(n: i64) -> i64 error[AErr]:
			value: i64 = try step(n)
			return value + 10

module Mods::B:
	public:
		def step(n: i64) -> i64 error[BErr]:
			raise BErr.BBad if n < 0
			return n + 2

		def probe_b(n: i64) -> i64 error[BErr]:
			value: i64 = try step(n)
			return value + 20

def main() -> i64:
	a: i64 = try Mods::A::probe_a(1) else -1
	1 return if a != 12
	b: i64 = try Mods::B::probe_b(1) else -1
	2 return if b != 23
	# Each module's own failure recovers through its own family.
	a_failed: i64 = try Mods::A::probe_a(-1) else 7
	3 return if a_failed != 7
	b_failed: i64 = try Mods::B::probe_b(-1) else 8
	4 return if b_failed != 8
	return 0
