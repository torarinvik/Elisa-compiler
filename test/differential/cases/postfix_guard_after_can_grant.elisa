# `STMT can Effect if COND` -- a postfix guard AFTER a trailing effect grant. stage1's parser
# consumed the grant and then let the `if COND` tokens fall through as nothing: the guarded
# statement ran UNCONDITIONALLY (stage1's LLVM had no compare where stage0's has one). Found
# through fmt parity on the runtime's fault handler (`write(...) can Console if fw > 0`).
global mutable hits: mutable i64 = 0

def bump() -> void:
    can Global.Write:
        hits <- hits + 1

def poke(n: i64) -> void:
    can Global.Write:
        bump() can Global.Write if n > 0
        bump() can Global.Write if n > 10

def main() -> i64:
    poke(0)                       # neither guard fires
    1 return if hits != 0
    poke(5)                       # only the first fires
    2 return if hits != 1
    poke(50)                      # both fire
    3 return if hits != 3
    return 0
