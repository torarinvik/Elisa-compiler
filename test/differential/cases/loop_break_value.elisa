# A value-bearing break writes the scoped loop accumulator before exiting.
# Exhaustion leaves the initializer unchanged. A nested statement loop does not
# steal the outer value-form loop's break target.
def contains(needle: i64) -> bool:
    for index in 0..<4 |condition=false| -> condition:
        if index == needle:
            break true

def nested() -> bool:
    for index in 0..<2 |found=false| -> found:
        for inner in 0..<2:
            break
        if index == 1:
            break true

def main() -> i32:
    return 1 if not contains(2)
    return 2 if contains(9)
    return 3 if not nested()
    0
