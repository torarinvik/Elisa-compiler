# A GENERIC over a store-backed hierarchy handle, walking the tree recursively
# and dispatching to a protocol per node.
#
# stage1 gave the instantiation no hidden store parameter: a template is never
# declared into the function table, so every store-ABI fact it looked up by
# (name, line) came back false. The body then either declined its common-field
# reads outright (the non-recursive shape) or -- when its own constructors
# handed it an implicit LOCAL store -- read the caller's handles against an
# empty store and segfaulted (this shape). The instantiation now carries the
# store slot exactly like an ordinary function taking the handle, and every
# generic call site hands over the ambient store ahead of the arena.
@packed_profile(build_heavy)
enum Widget:
    common:
        @storage(inline)
        width: mutable f32
        @storage(inline)
        first_child: mutable Widget?
        @storage(inline)
        next_sibling: mutable Widget?
    pass

enum Control is Widget:
    Label(size: f32)
    Box(padding: f32)

global mutable visited: i32 = 0
global mutable total_width: f32 = 0.0

protocol Visitor:
    def note(width: f32) -> void

struct Counter:
    unused: i32

impl Visitor for Counter:
    def note(width: f32) -> void:
        visited <- visited + 1
        total_width <- total_width + width

def walk[V: Visitor](w: Widget) -> void:
    V.note(w.width)
    cursor: mutable Widget? = w.first_child
    while cursor is node |cursor|:
        walk[V](node)
        cursor <- node.next_sibling

def label(width: f32) -> Widget can[Memory.Allocate, Abort.Panic]:
    return Control.Label(width: width, first_child: null, next_sibling: null, size: 12.0)

def box(width: f32, child: Widget) -> Widget can[Memory.Allocate, Abort.Panic]:
    return Control.Box(width: width, first_child: child, next_sibling: null, padding: 4.0)

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        region ui(65536):
            leaf_a: Widget = label(40.0)
            leaf_b: Widget = label(60.0)
            leaf_a.next_sibling <- leaf_b
            root: Widget = box(200.0, leaf_a)
            walk[Counter](root)
            return 1 if visited != 3
            return 2 if total_width != 300.0
            return 0
