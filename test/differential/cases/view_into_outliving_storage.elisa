# Borrowed views into storage that OUTLIVES them. Every expected value fixed by hand.
global mutable pool: mutable i64[16] = zeroed
global mutable other: mutable i64[8] = zeroed

struct Holder:
    window: mutable view[i64]
    tag: mutable i64

def fill() -> void:
    for i in 0..<16:
        pool[i] <- (i * 10).i64()
    for i in 0..<8:
        other[i] <- (100 + i).i64()

def window_of_global(lo: usize, hi: usize) -> view[i64]:
    return pool[lo:hi]

def through_helper(lo: usize, hi: usize) -> view[i64]:
    return window_of_global(lo, hi)

def through_two(lo: usize, hi: usize) -> view[i64]:
    return through_helper(lo, hi)

def other_window() -> view[i64]:
    return other[2:5]

def churn_stack(depth: i64) -> i64:
    scratch: mutable i64[64] = zeroed
    for i in 0..<64:
        scratch[i] <- depth + i.i64()
    return scratch[63] if depth <= 0 else churn_stack(depth - 1) + scratch[0]

def sum_view(v: view[i64]) -> i64:
    total: mutable i64 = 0
    for x in v:
        total <- total + x
    return total

def main() -> i64:
    fill()
    a: view[i64] = through_two(2, 5)            # 20 30 40
    b: view[i64] = other_window()               # 102 103 104
    _ = churn_stack(20)                         # unrelated stack traffic between creation and use
    1 return if a.len != 3 or sum_view(a) != 90
    2 return if b.len != 3 or sum_view(b) != 309
    h: Holder = Holder{window: window_of_global(0, 16), tag: 7}
    _ = churn_stack(20)
    3 return if h.window.len != 16 or sum_view(h.window) != 1200
    pool[15] <- 5000                            # a view SEES later writes to its backing store
    4 return if sum_view(h.window) != 1200 - 150 + 5000
    e: view[i64] = pool[4:4]
    5 return if e.len != 0
    f: view[i64] = pool[0:16]
    6 return if f.len != 16
    g: view[i64] = pool[15:16]
    7 return if g.len != 1 or sum_view(g) != 5000
    8 return if sum_view(a) != 90                # a is unaffected by b or h
    return 0
