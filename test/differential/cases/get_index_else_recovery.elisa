# `get xs[i] else <control-flow>` is a CHECKED access: its whole point is that the caller
# never has to prove the index in range, because an out-of-range one takes the recovery
# instead of reading an element. stage1 DECLINED every function containing one -- the
# guarded expression types as the ELEMENT type, not as an optional -- so a program using
# this form emitted no code at all while stage0 compiled and ran it.

def pick(xs: darray[i64], index: usize) -> i64:
    value: i64 = get xs[index] else return -1
    return value

# Through the synthetic `__return_get` declaration: `return get ...` is lowered as a
# variable declaration, which is why a RETURN was reported as one when this declined.
def first_or(xs: darray[i64]) -> i64:
    return get xs[0] else return -7

def main() -> i64:
    xs: mutable darray[i64] = [10, 20, 30]
    return 1 if pick(xs, 0) != 10
    return 2 if pick(xs, 2) != 30
    return 3 if pick(xs, 3) != -1
    return 4 if pick(xs, 99) != -1
    return 5 if first_or(xs) != 10
    empty: mutable darray[i64] = []
    return 6 if first_or(empty) != -7
    return 0
