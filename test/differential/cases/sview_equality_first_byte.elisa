# `sview == sview` checks the first byte inline before calling memcmp. Equality must
# be unchanged for every shape: a first-byte miss, a later-byte miss, a full match in
# different storage, the same storage, empty views, unequal lengths and a 0xff byte.
def same(a: sview, b: sview) -> bool:
    return a == b

def main() -> i64:
    text: sview = "alpha beta alphx alpha"
    a1: sview = text[0:5]
    a2: sview = text[17:22]
    ax: sview = text[11:16]
    b: sview = text[6:10]
    return 1 if not same(a1, a2)
    return 2 if same(a1, ax)
    return 3 if same(a1, b)
    return 4 if not same(a1, a1)
    return 5 if same(b, text[0:4])
    e1: sview = text[3:3]
    e2: sview = ""
    return 6 if not same(e1, e2)
    return 7 if same(a1, text[0:4])
    hi: sview = "\xffz"
    lo: sview = "\x7fz"
    return 8 if same(hi, lo)
    return 9 if not same(hi, "\xffz")
    return 0
