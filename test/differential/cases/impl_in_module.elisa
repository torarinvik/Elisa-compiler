# A module-nested impl must remain available to generic protocol dispatch after
# module-body flattening erases its Scoped wrapper. Record membership by method
# line before flattening, then use the empty dispatch owner in declaration and
# body lookup while retaining the lexical module for name/type resolution.
# Keep a top-level impl alongside it to guard the existing path too.

protocol Painter:
    def stroke(value: i32) -> i32

protocol Measurer:
    def span(value: i32) -> i32

def paint_with[P: Painter](value: i32) -> i32:
    return P.stroke(value)

def measure_with[M: Measurer](value: i32) -> i32:
    return M.span(value)

struct TopLevelRule:
    tag: i32

# The impl this case exists for: inside a module, on a type also inside it.
module Studio:
    public:
        struct ModulePen:
            tag: i32

        impl Painter for ModulePen:
            def stroke(value: i32) -> i32:
                return value * 2

# ...and the path that already worked, unchanged.
impl Measurer for TopLevelRule:
    def span(value: i32) -> i32:
        return value * 3

def main() -> i32:
    from_module: i32 = paint_with[Studio::ModulePen](5)
    from_top: i32 = measure_with[TopLevelRule](5)
    return 1 if from_module != 10 else 2 if from_top != 15 else 0
