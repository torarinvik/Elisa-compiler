# An `impl P for T:` written INSIDE a module provides its methods.
#
# stage1 declined every generic that dispatched through such an impl, while
# stage0 compiled and ran it. The cause is a FOUR-part invariant, and fixing any
# single part changed nothing observable -- which is what made the first attempt
# look like a dead end rather than an incomplete one:
#
#   1. record_impl_member_lines gives the method its `__impl__P__T__m` symbol
#   2. declare_module_functions creates the function
#   3. the body-emission walk emits its body
#   4. all three use an EMPTY owner, because an impl member's identity is that
#      mangled symbol and not the module it happens to be written in
#
# Parts 1-3 each skip a nameless declaration, and an impl block is a Decl.Scoped
# with no name. A TOP-LEVEL impl is immune only because flatten_static_branches
# erases Scoped nodes from file.top_decls before those passes run; a module body
# is never flattened, so the members stayed nested and invisible.
#
# The descent is gated on the `__impl_scope` annotation rather than covering every
# Scoped: a static-if block is also Scoped, and declaring the functions of an
# untaken branch is exactly what flattening exists to prevent.
#
# The second protocol keeps a TOP-LEVEL impl in the same program, so the case also
# pins that the fix did not disturb the path that already worked. They are
# separate protocols on purpose: stage1 declines two impls of ONE protocol in a
# single unit (stage0 accepts), which is a different, pre-existing bug and not
# what this case is for.

protocol Painter:
    def stroke(value: i32) -> i32

protocol Measurer:
    def span(value: i32) -> i32

def paint_with[P: Painter](value: i32) -> i32:
    return P.stroke(value)

def measure_with[M: Measurer](value: i32) -> i32:
    return M.span(value)

struct TopLevelRule:
    tag: i32

# The impl this case exists for: inside a module, on a type also inside it.
module Studio:
    public:
        struct ModulePen:
            tag: i32

        impl Painter for ModulePen:
            def stroke(value: i32) -> i32:
                return value * 2

# ...and the path that already worked, unchanged.
impl Measurer for TopLevelRule:
    def span(value: i32) -> i32:
        return value * 3

def main() -> i32:
    from_module: i32 = paint_with[Studio::ModulePen](5)
    from_top: i32 = measure_with[TopLevelRule](5)
    return 1 if from_module != 10 else 2 if from_top != 15 else 0
