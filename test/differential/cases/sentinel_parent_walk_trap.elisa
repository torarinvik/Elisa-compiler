# The negative side of sentinel_parent_walk: a walk that does not stop at
# the root reads the root's -1 as an index, and its bounds check must still
# trap; the -1 reaching the check is what the sentinel bound relies on.
@inline(never)
def walk_past_root(edges: i64&, count: usize, start: usize) -> i64:
    return -1 if count < 2 or count > 64 or start >= count
    parent: mutable i64[64] = zeroed
    for node in 0..<count |parent|:
        parent[node] <- -1
    for node in 1..<count |edges, parent|:
        above: i64 = edges[node]
        return -1 if above < 0 or above >= i64(node)
        parent[node] <- above
    steps: mutable i64 = 0
    current: mutable usize = start
    while steps < 100 |current, parent, steps|:
        current <- usize(parent[current])
        steps <- steps + 1
    steps

def main() -> i32:
    edges: mutable i64[4] = zeroed
    edges[1] <- 0
    edges[2] <- 1
    edges[3] <- 2
    # Reaches the root after three steps, then indexes parent[-1]: traps.
    i32(walk_past_root(&edges[0], 4, 3))
