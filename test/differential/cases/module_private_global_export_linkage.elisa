# FFI: a top-level global exported under its own name must keep that EXACT external symbol,
# while a module-private global spelled the same stays internal and separate.
global mutable MAGIC: i32 = 1337
export global MAGIC as MAGIC

module A:
    private:
        global mutable MAGIC: i32 = 7
    public:
        def read() -> i32:
            return MAGIC
        def write(v: i32) -> void:
            MAGIC <- v

def main() -> i64:
    1 return if A::read() != 7
    2 return if MAGIC != 1337
    A::write(8)
    3 return if MAGIC != 1337
    4 return if A::read() != 8
    MAGIC <- 1338
    5 return if A::read() != 8
    return 0
