# A zero-filled buffer that is only appended to and then copied out up to its
# count never shows a zero, so the fill is dead (ElisaStackWatermark): pairs
# pushed by `count + 2`, pairs copied as vectors, pushes of different sizes on
# separate branches, and records of three words. When a copy reads one element past
# the pushes, or the second element of a pair is stored on only one branch,
# the zero is observed and the fill must stay.
const CAPACITY: usize = 256

@inline(never)
def push_pairs(values: view[i64], count: usize, out: mutable view[i64]) -> usize:
    words: mutable i64[256] = zeroed
    used: mutable usize = 0
    index: mutable usize = 0
    while index < count:
        if used + 2 > CAPACITY - 1:
            return 0
        words[used] <- values[index]
        words[used + 1] <- values[index] * 3 + 1
        used <- used + 2
        index <- index + 1
    position: mutable usize = 0
    while position < used:
        out[position] <- words[position]
        position <- position + 1
    used

# Copies one element past the pushes: that element is the fill's zero.
@inline(never)
def push_pairs_past(values: view[i64], count: usize, out: mutable view[i64]) -> usize:
    words: mutable i64[256] = zeroed
    used: mutable usize = 0
    index: mutable usize = 0
    while index < count:
        if used + 2 > CAPACITY - 1:
            return 0
        words[used] <- values[index]
        words[used + 1] <- values[index] * 3 + 1
        used <- used + 2
        index <- index + 1
    position: mutable usize = 0
    while position <= used:
        out[position] <- words[position]
        position <- position + 1
    used + 1

# A header pair, then pairs copied straight from the source, which the
# optimizer turns into one vector store per pair.
@inline(never)
def push_copied(values: view[i64], count: usize, out: mutable view[i64]) -> usize:
    words: mutable i64[256] = zeroed
    return 0 if count % 2 == 1 or count + 2 > values.len or count + 2 > CAPACITY
    words[0] <- 9
    words[1] <- count.i64()
    used: mutable usize = 2
    index: mutable usize = 0
    while index < count:
        words[used] <- values[index]
        words[used + 1] <- values[index + 1]
        used <- used + 2
        index <- index + 2
    position: mutable usize = 0
    while position < used:
        out[position] <- words[position]
        position <- position + 1
    used

@inline(never)
def push_threaded(values: view[i64], count: usize, out: mutable view[i64]) -> usize:
    words: mutable i64[256] = zeroed
    used: mutable usize = 0
    index: mutable usize = 0
    while index < count and used + 3 < CAPACITY:
        value: i64 = values[index]
        if value % 3 == 0:
            words[used] <- 100
            words[used + 1] <- value
            used <- used + 2
        elif value % 3 == 1:
            words[used] <- 200
            words[used + 1] <- value + 7
            used <- used + 2
        else:
            words[used] <- -1
            used <- used + 1
        index <- index + 1
    position: mutable usize = 0
    while position < used:
        out[position] <- words[position]
        position <- position + 1
    used

# The second element of a pair is stored only for odd values: an even value
# leaves a zero inside the copied prefix.
@inline(never)
def push_half_pairs(values: view[i64], count: usize, out: mutable view[i64]) -> usize:
    words: mutable i64[256] = zeroed
    used: mutable usize = 0
    index: mutable usize = 0
    while index < count and used + 2 < CAPACITY:
        value: i64 = values[index]
        words[used] <- value + 1000
        if value % 2 == 1:
            words[used + 1] <- value
        used <- used + 2
        index <- index + 1
    position: mutable usize = 0
    while position < used:
        out[position] <- words[position]
        position <- position + 1
    used

# A stack driven by opcodes: push, pop, peek (`&entries[top] - 1`), then a scan
# of the live entries. `past` scans one entry beyond the top, which is the
# fill's zero (or a popped value) and must stay observable.
@inline(never)
def run_stack(codes: view[i64], count: usize, past: bool) -> i64:
    entries: mutable i64[64] = zeroed
    top: mutable usize = 0
    total: mutable i64 = 0
    index: mutable usize = 0
    while index < count:
        code: i64 = codes[index]
        if code % 4 != 3:
            return -1 if top == 64
            entries[top] <- code * 5 + 1
            top <- top + 1
        elif top > 0:
            total <- total + entries[top - 1]
            top <- top - 1 if code % 8 == 3 else top
        index <- index + 1
    limit: usize = top + 1 if past and top < 64 else top
    scan: mutable usize = 0
    while scan < limit:
        total <- (total * 3 + entries[scan]) % 1000003
        scan <- scan + 1
    total

# Reads the whole buffer, so the reference's fill is observed and stays.
@inline(never)
def observe(entries: view[i64]) -> i64:
    entries[entries.len - 1]

# The same entries with its buffer escaping to `observe`: its fill cannot be elided.
def stack_reference(codes: view[i64], count: usize, past: bool) -> i64:
    entries: mutable i64[64] = zeroed
    seen: i64 = observe(entries[0:64])
    top: mutable usize = 0
    total: mutable i64 = 0
    index: mutable usize = 0
    while index < count:
        code: i64 = codes[index]
        if code % 4 != 3:
            return -1 if top == 64
            entries[top] <- code * 5 + 1
            top <- top + 1
        elif top > 0:
            total <- total + entries[top - 1]
            top <- top - 1 if code % 8 == 3 else top
        index <- index + 1
    limit: usize = top + 1 if past and top < 64 else top
    scan: mutable usize = 0
    while scan < limit:
        total <- (total * 3 + entries[scan]) % 1000003
        scan <- scan + 1
    total + seen

# Records of three words per value, counted with the loop and copied out
# whole: seen as an array of triples, its fill is dead. `partial` stores the
# third word only for odd values, leaving the fill's zero for even ones.
@inline(always)
def push_triples(values: view[i64], count: usize, out: mutable view[i64], partial: bool) -> usize:
    records: mutable i64[192] = zeroed
    record_count: mutable usize = 0
    index: mutable usize = 0
    while index < count:
        return 0 if record_count >= 64
        records[record_count * 3] <- values[index]
        records[record_count * 3 + 1] <- values[index] * 2
        if not partial or values[index] % 2 != 0:
            records[record_count * 3 + 2] <- index.i64() + 1
        record_count <- record_count + 1
        index <- index + 1
    used: usize = record_count * 3
    position: mutable usize = 0
    while position < used:
        out[position] <- records[position]
        position <- position + 1
    used

@inline(never)
def push_whole_triples(values: view[i64], count: usize, out: mutable view[i64]) -> usize:
    push_triples(values, count, out, false)

@inline(never)
def push_partial_triples(values: view[i64], count: usize, out: mutable view[i64]) -> usize:
    push_triples(values, count, out, true)

def check_triples(values: view[i64], count: usize, out: view[i64], used: usize, partial: bool) -> i32:
    return 60 if used != (0 if count > 64 else 3 * count)
    index: mutable usize = 0
    while index < used / 3:
        third: i64 = index.i64() + 1 if not partial or values[index] % 2 != 0 else 0
        return 61 if out[3 * index] != values[index] or out[3 * index + 1] != values[index] * 2 or out[3 * index + 2] != third
        index <- index + 1
    0

def check_pairs(values: view[i64], count: usize, out: view[i64], extra: usize, copied: usize) -> i32:
    return 10 if copied != 2 * count + extra
    index: mutable usize = 0
    while index < count:
        return 11 if out[2 * index] != values[index] or out[2 * index + 1] != values[index] * 3 + 1
        index <- index + 1
    return 12 if extra == 1 and out[2 * count] != 0
    0

def check_threaded(values: view[i64], count: usize, out: view[i64], used: usize) -> i32:
    at: mutable usize = 0
    index: mutable usize = 0
    while index < count:
        value: i64 = values[index]
        if value % 3 == 0:
            return 20 if out[at] != 100 or out[at + 1] != value
            at <- at + 2
        elif value % 3 == 1:
            return 21 if out[at] != 200 or out[at + 1] != value + 7
            at <- at + 2
        else:
            return 22 if out[at] != -1
            at <- at + 1
        index <- index + 1
    return 23 if at != used
    0

def check_half(values: view[i64], count: usize, out: view[i64], used: usize) -> i32:
    return 30 if used != 2 * count
    index: mutable usize = 0
    while index < count:
        expected: i64 = values[index] if values[index] % 2 == 1 else 0
        return 31 if out[2 * index] != values[index] + 1000 or out[2 * index + 1] != expected
        index <- index + 1
    0

def main() -> i32:
    values: mutable i64[100] = zeroed
    fill: mutable usize = 0
    while fill < 100:
        values[fill] <- (fill * 37 % 101).i64() - 20
        fill <- fill + 1
    count: mutable usize = 0
    while count <= 100:
        out: mutable i64[256] = zeroed
        # Poison the output so a copy that skipped an element shows.
        poison: mutable usize = 0
        while poison < 256:
            out[poison] <- 77
            poison <- poison + 1
        copied: usize = push_pairs(values[0:100], count, out[0:256])
        status: i32 = check_pairs(values[0:100], count, out[0:256], 0, copied)
        return status if status != 0
        past: mutable i64[256] = zeroed
        past_copied: usize = push_pairs_past(values[0:100], count, past[0:256])
        past_status: i32 = check_pairs(values[0:100], count, past[0:256], 1, past_copied)
        return past_status if past_status != 0
        straight: mutable i64[256] = zeroed
        straight_used: usize = push_copied(values[0:100], count, straight[0:256])
        if count % 2 == 0 and count + 2 <= 100:
            return 40 if straight_used != count + 2 or straight[0] != 9 or straight[1] != count.i64()
            at: mutable usize = 0
            while at < count:
                return 41 if straight[at + 2] != values[at]
                at <- at + 1
        threaded: mutable i64[256] = zeroed
        used: usize = push_threaded(values[0:100], count, threaded[0:256])
        threaded_status: i32 = check_threaded(values[0:100], count, threaded[0:256], used)
        return threaded_status if threaded_status != 0
        half: mutable i64[256] = zeroed
        half_used: usize = push_half_pairs(values[0:100], count, half[0:256])
        half_status: i32 = check_half(values[0:100], count, half[0:256], half_used)
        return half_status if half_status != 0
        whole: mutable i64[192] = zeroed
        whole_used: usize = push_whole_triples(values[0:100], count, whole[0:192])
        whole_status: i32 = check_triples(values[0:100], count, whole[0:192], whole_used, false)
        return whole_status if whole_status != 0
        part: mutable i64[192] = zeroed
        part_used: usize = push_partial_triples(values[0:100], count, part[0:192])
        part_status: i32 = check_triples(values[0:100], count, part[0:192], part_used, true)
        return part_status + 5 if part_status != 0
        return 50 if run_stack(values[0:100], count, false) != stack_reference(values[0:100], count, false)
        return 51 if run_stack(values[0:100], count, true) != stack_reference(values[0:100], count, true)
        count <- count + 1
    0
