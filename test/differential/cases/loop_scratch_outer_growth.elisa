# An outer container keeps its owning arena even when a loop has fresh scratch.
def main() -> i64:
    out: mutable darray[i64] = []
    for i in 0..<20 |out|:
        xs: mutable darray[i64] = []
        xs.push(i)
        out.push(xs[0])
    return 1 if out.count != 20
    return 0 if out[0] == 0 and out[19] == 19 else 2
