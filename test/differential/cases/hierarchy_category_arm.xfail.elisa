# A CATEGORY ARM (docs/77 §2): a bare `InputEvent input:` arm covers every leaf
# of that sub-category, so a match over the root discharges the whole subtree
# with one arm. stage0 implements it (enumCategoryArm marks the category's leaf
# range covered); stage1's backend has no category-arm case and declines the
# match statement. Promote when stage1 grows one.
enum Event:
    None
    Quit

enum InputEvent is Event:
    pass

enum MouseEvent is InputEvent:
    Move
    Down

def classify(event: Event) -> i64:
    match event:
        InputEvent input:
            return 1
        Event.Quit:
            return 2
        Event.None:
            return 3

def main() -> i64:
    return 1 if classify(MouseEvent.Move) != 1
    return 2 if classify(MouseEvent.Down) != 1
    return 3 if classify(Event.Quit) != 2
    return 4 if classify(Event.None) != 3
    return 0
