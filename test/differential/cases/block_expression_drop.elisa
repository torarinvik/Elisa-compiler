global mutable log: i64 = 0
struct Tracked:
    mark: i64

def __drop__(self: Tracked) -> void:
    can Global{Read,Write}:
        log <- log * 10 + self.mark

def run() -> i64:
    can Global{Read,Write}:
        selected =
            local: Tracked = Tracked{mark: 4}
            (move local)
        return 1 if log != 0
        return selected.mark

def main() -> i64:
    can Global{Read,Write}:
        return 1 if run() != 4
        return 2 if log != 4
        return 0
