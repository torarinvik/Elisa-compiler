include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/collections.elisa"
include "../../../elisacore_std/elisacore_runtime_strings.elisa"

# `extend` from a string view, a string literal and a numeric darray, and the
# `for i in 0..<sview_len(s): out.push(sview_at(s, i))` byte-copy idiom, all lower to
# one growth check plus a memmove. The contents, the count and the CAPACITY the
# per-element push loop would have reached must all be unchanged.

def append_text(out: mutable darray[u8]&, text: sview) -> void:
    for index in 0..<sview_len(text) |out, text|:
        out.push(sview_at(text, index))

def bytes_equal(left: darray[u8]&, text: sview) -> bool:
    false return if left.count != sview_len(text)
    for index in 0..<left.count |left, text|:
        false return if left[index] != sview_at(text, index)
    return true

def main() -> i64:
    # The idiom, through a reference, growing from empty: 8 -> 16 -> 32.
    built: mutable darray[u8] = []
    append_text(&built, "hello, ")
    append_text(&built, "world")
    return 1 if not bytes_equal(&built, "hello, world")
    return 2 if built.capacity != 16
    append_text(&built, "")
    return 3 if built.count != 12
    append_text(&built, " -- and a much longer tail")
    return 4 if not bytes_equal(&built, "hello, world -- and a much longer tail")
    return 5 if built.capacity != 64

    # `extend` from an sview and from a literal.
    joined: mutable darray[u8] = []
    piece: sview = "abc"
    joined.extend(piece)
    joined.extend("defghij")
    return 10 if not bytes_equal(&joined, "abcdefghij")
    return 11 if joined.capacity != 16

    # A numeric darray source, and a self-extend (reads the grown backing).
    numbers: mutable darray[i64] = [1, 2, 3]
    more: darray[i64] = [4, 5, 6, 7, 8, 9]
    numbers.extend(more)
    return 20 if numbers.count != 9 or numbers[0] != 1 or numbers[8] != 9
    numbers.extend(numbers)
    return 22 if numbers.count != 18 or numbers[9] != 1 or numbers[17] != 9

    # Empty sources leave an empty array unallocated.
    nothing: mutable darray[u8] = []
    nothing.extend("")
    return 30 if nothing.count != 0 or nothing.capacity != 0
    return 0
