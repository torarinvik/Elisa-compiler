# An optional handle as an @storage(inline) mutable common (`next_sibling:
# mutable Widget?`) -- how elisa-ui links its tree.
#
# stage0 used to reject this, and the note here blamed the common: "types the
# common as Widget, drops the ?". The truth was general and had nothing to do
# with commons -- `x: mutable i64? = null` then `x <- 5` narrowed x to i64 for
# the rest of the scope, and both `x == null` and `if x is v:` were then refused
# on the narrowed type. The narrowing is a useful fact and is kept; it just no
# longer takes away the ability to ASK about absence, since the storage still
# carries its present flag either way.
enum Widget:
    common:
        @storage(inline)
        x: mutable f32
        @storage(inline)
        hovered: mutable bool
        @storage(inline)
        first_child: mutable Widget?
        @storage(inline)
        next_sibling: mutable Widget?
    pass

enum Container is Widget:
    Box(axis: i32)

enum Control is Widget:
    Label(size: f32)

def label(size: f32) -> Widget can[Memory.Allocate, Abort.Panic]:
    return Control.Label(x: 0.0, hovered: false, first_child: null, next_sibling: null, size: size)

def box() -> Widget can[Memory.Allocate, Abort.Panic]:
    return Container.Box(x: 0.0, hovered: false, first_child: null, next_sibling: null, axis: 1)

def count_children(w: Widget) -> i64:
    total: mutable i64 = 0
    cursor: mutable Widget? = w.first_child
    while cursor is node |total, cursor|:
        total <- total + 1
        node.x <- node.x + 1.0
        cursor <- node.next_sibling
    return total

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        region ui(65536):
            a: Widget = label(1.0)
            b: Widget = label(2.0)
            root: Widget = box()
            a.next_sibling <- b
            root.first_child <- a
            return 1 if root.first_child == null
            return 2 if count_children(root) != 2
            return 3 if a.x != 1.0 or b.x != 1.0
            a.hovered <- true
            return 4 if not a.hovered
            hot: mutable Widget? = null
            hot <- a
            if hot is h:
                h.hovered <- false
            return 5 if a.hovered
            return 0
