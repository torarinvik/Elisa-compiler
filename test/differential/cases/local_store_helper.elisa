# A helper that OPENS ITS OWN packed store needs no store from its caller.
#
# Constructing a node of a sealed hierarchy forces the hidden AST-store parameter,
# because the handles being built are rows in the CALLER's store. A function that
# declares a store of its own is the opposite case: it owns the rows and nothing
# crosses the boundary. stage1 forced the parameter anyway, so `run` was emitted
# as `@run(i64, {ptr, i64, ptr})` while stage0 emitted `@run(i64)` -- and an
# ordinary `main`, which has no store to pass, declined the CALL. The error named
# main, not the helper, which is what made it hard to see.
#
# Found in elisa-proof, whose `main` is one line: `return proof_main(argc, argv)`.
module Ast:
    public:
        enum Node layout(handle: u32):
            common:
                x: f32
            pass

        enum Leaf is Node:
            Value(v: i64)

def run(bias: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
    region r(65536):
        store: Ast::Node.Store[Local] = Ast::Node.Store(r)
        seen: mutable i64 = 0
        in store:
            n: Ast::Node = new Ast::Leaf.Value(x: 1.5, v: 42)
            seen <- 1 if n is Ast::Leaf.Value
            seen <- seen + 1 if n.x == 1.5
        return seen + bias

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return 1 if run(0) != 2
    return 2 if run(3) != 5
    return 0
