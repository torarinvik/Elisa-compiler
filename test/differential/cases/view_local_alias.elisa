# A slice of a LOCAL fixed array must alias the array, not a copy of it: a later write to the
# array is visible through the view. stage1 used to spill the array into an "arrayslice.storage"
# temp, so the view saw a stale snapshot (and, past the function's return, dead stack).
def sum_view(v: view[i64]) -> i64:
    total: mutable i64 = 0
    for x in v:
        total <- total + x
    return total

def main() -> i64:
    local: mutable i64[8] = zeroed
    for i in 0..<8:
        local[i] <- i.i64()
    w: view[i64] = local[2:6]                   # 2 3 4 5
    1 return if w.len != 4 or sum_view(w) != 14
    local[3] <- 30                              # the view SEES the write
    2 return if sum_view(w) != 41
    e: view[i64] = local[5:5]
    3 return if e.len != 0
    f: view[i64] = (local)[0:8]
    4 return if f.len != 8 or sum_view(f) != 28 + 27
    return 0
