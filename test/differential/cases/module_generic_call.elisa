# A generic declared inside `module M:` is callable.
#
# stage1 DECLINED every such call -- `M::identity[i32](0)` and the inferred
# `M::identity(x)` alike -- while stage0 compiled and ran both. The callee of a
# module-qualified call parses to Expr.Scope, and the generic paths in
# codegen_call matched only Expr.Ident, so nothing resolved and the call fell
# through to a direct call, which has no template to instantiate.
#
# A generic is registered under its BARE name (parser_types_function records no
# owner for one), so the member half of the scope is what resolves it.
#
# Not a corner: this is why a protocol driver could not live in a module, which
# shaped elisa-ui's painting and controls layers into top-level functions.

module M:
    public:
        def identity[T](value: T) -> T:
            return value

        def pair_first[K, V](left: K, right: V) -> K:
            return left

def main() -> i32:
    # EXPLICIT single type argument.
    a: i32 = M::identity[i32](7)
    return 1 if a != 7 else explicit_multi() + inferred()

def explicit_multi() -> i32:
    # EXPLICIT multi-argument type application.
    b: i32 = M::pair_first[i32, i64](3, 9)
    return 2 if b != 3 else 0

def inferred() -> i32:
    # INFERRED from a typed argument.
    seed: i32 = 5
    c: i32 = M::identity(seed)
    return 3 if c != 5 else 0
