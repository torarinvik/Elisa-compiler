struct Pair:
    left: i64
    right: i64

def make_values(seed: i64) -> darray[i64]:
    values: darray[i64] =
        local: mutable darray[i64] = []
        local.push(seed)
        local.push(seed + 1)
        local
    return values

def main() -> i64:
    pair: Pair =
        half: i64 = 21
        Pair{left: half, right: half * 2}
    return 1 if pair.left != 21 or pair.right != 42
    fraction =
        numerator: f64 = 21.0
        numerator / 2.0
    return 2 if fraction != 10.5
    literal_fraction =
        10.5
    return 6 if literal_fraction != fraction
    valid =
        value: i64 = pair.right
        value > 40
    return 3 if not valid
    values: darray[i64] = make_values(41)
    # Churn the allocator after returning the block-produced buffer.
    for i in 0..<100:
        temporary: darray[i64] = make_values(i)
        return 4 if temporary[1] != i + 1
    return 5 if values[0] != 41 or values[1] != 42
    return 0
