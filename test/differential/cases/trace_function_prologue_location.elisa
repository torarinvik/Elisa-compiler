# A traced loop prologue must not inherit the preceding helper debug scope.
def first(xs: darray[i64]&) -> i64:
    return xs[0]
def main() -> i64:
    total: mutable i64 = 0
    for i in 0..<200 |total|:
        xs: mutable darray[i64] = []
        xs.reserve(4096)
        xs.push(i)
        total <- total + first(&xs)
    return 0 if total == 19900 else 1
