# The proof must preserve a scalar local's declared type while checking later reads.
# Otherwise this f64-to-i64 hook is mistaken for an i64 identity cast and the buffer
# may be stack-placed across an effectful user conversion.
global mutable local_cast_calls: i64 = 0

def __cast__(value: f64) -> i64 can[Global.Write]:
    local_cast_calls <- local_cast_calls + 1
    return 41

def convert_after_buffer() -> i64:
    values: mutable darray[i64] = [1, 2, 3]
    fraction: f64 = 3.9
    converted: i64 = fraction.i64()
    return converted

def main() -> i64:
    result: i64 = convert_after_buffer()
    return 1 if result != 41 or local_cast_calls != 1
    return 0
