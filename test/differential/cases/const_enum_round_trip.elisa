# A const enum in BOTH directions, and as a payload field type.
#
# `key.i32()` always worked -- a const enum erases to its backing. The reverse,
# `raw.UiKey()`, fell through to the UFCS lookup in stage1, found no function of
# that name and declined, so a backend could not turn a host's raw key code into
# a named one. stage0 accepts it. The target is the backing, so it is the
# ordinary integer conversion.
const enum Key of i32:
    Escape = 27
    Space = 32
    A = 65

enum Event:
    None

enum KeyEvent is Event:
    Down(code: Key)
    Up(code: Key)

def code_of(event: Event) -> i32:
    match event:
        KeyEvent.Down(down_code):
            return down_code.i32()
        KeyEvent.Up(up_code):
            return 0 - up_code.i32()
        Event.None:
            return -1000

# The shape a backend needs: a raw host code in, a named one out.
def from_host(raw: i32, pressed: bool) -> Event:
    return (KeyEvent.Down(code: raw.Key())) if pressed
    return (KeyEvent.Up(code: raw.Key()))

def main() -> i64:
    return 1 if Key.Escape.i32() != 27
    return 2 if Key.A.i32() != 65
    named: Key = 32.i32().Key()
    return 3 if named.i32() != 32
    return 4 if code_of((KeyEvent.Down(code: Key.Escape))) != 27
    return 5 if code_of((KeyEvent.Up(code: Key.Space))) != -32
    return 6 if code_of((Event.None)) != -1000
    return 7 if code_of(from_host(65, true)) != 65
    return 8 if code_of(from_host(65, false)) != -65
    # A value the enum does not name still converts: it is an i32 underneath, and
    # a host is free to send a code this list has not caught up with.
    return 9 if code_of(from_host(999, true)) != 999
    return 0
