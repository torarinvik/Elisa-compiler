# A loop that validates every input element below n + m (returning on a bad
# one) lets ElisaValidatedReads bound later reads of those elements. These
# cases pin its soundness: the validated reads must give exact sums, a
# write to the input after validation must be seen, and the element just
# past the validated ones holds a value far outside the validated range.
@inline(never)
def slope_sum(input: i64&, length: usize) -> i64:
    return -1 if length < 2
    n64: i64 = input[0]
    m64: i64 = input[1]
    return -1 if n64 < 1
    return -1 if n64 > 16
    return -1 if m64 < 1
    return -1 if m64 > 16
    n: usize = n64.usize()
    m: usize = m64.usize()
    return -1 if length < 3 + n + m
    i: mutable usize = 0
    while i < n + m:
        value: i64 = input[2 + i]
        return -1 if value < 0 or value > 1000000000
        i <- i + 1
    total: mutable i64 = 0
    i <- 0
    while i + 1 < n:
        total <- total + (input[3 + i] - input[2 + i])
        i <- i + 1
    i <- 0
    while i + 1 < m:
        total <- total + (input[3 + n + i] - input[2 + n + i]) * 3
        i <- i + 1
    total

@inline(never)
def rewritten_sum(input: mutable view[i64]) -> i64:
    return -1 if input.len < 4
    n64: i64 = input[0]
    return -1 if n64 < 2 or n64 > 16
    n: usize = n64.usize()
    return -1 if input.len < 2 + n
    i: mutable usize = 0
    while i < n:
        value: i64 = input[2 + i]
        return -1 if value < 0 or value > 1000000000
        i <- i + 1
    input[2] <- input[1]
    input[3] - input[2]

@inline(never)
def past_sum(input: i64&, length: usize) -> i64:
    return -1 if length < 2
    n64: i64 = input[0]
    return -1 if n64 < 1 or n64 > 16
    n: usize = n64.usize()
    return -1 if length < 3 + n
    i: mutable usize = 0
    while i < n:
        value: i64 = input[2 + i]
        return -1 if value < 0 or value > 1000000000
        i <- i + 1
    input[2 + n] - input[2]

def main() -> i32:
    input: mutable i64[40] = zeroed
    input[0] <- 5
    input[1] <- 4
    i: mutable usize = 0
    while i < 9:
        input[2 + i] <- (i * i * 7919 % 1000).i64() * 1000000
        i <- i + 1
    input[11] <- -9000000000000000000
    expected: mutable i64 = 0
    i <- 0
    while i < 4:
        expected <- expected + input[3 + i] - input[2 + i]
        i <- i + 1
    i <- 0
    while i < 3:
        expected <- expected + (input[8 + i] - input[7 + i]) * 3
        i <- i + 1
    return 10 if slope_sum(&input[0], 12) != expected
    input[2 + 3] <- 2000000000
    return 11 if slope_sum(&input[0], 12) != -1
    input[2 + 3] <- (9 * 7919 % 1000).i64() * 1000000

    input[0] <- 4
    input[1] <- -8000000000000000000
    return 12 if rewritten_sum(input[0:12]) != input[3] - -8000000000000000000
    return 13 if input[2] != -8000000000000000000
    input[2] <- 0

    input[0] <- 9
    return 14 if past_sum(&input[0], 12) != -9000000000000000000
    0
