# The bare H is outside B, so it has no declaration identity even though B::H exists.
effect Tick:
    def ping() -> i64

module B:
    effect Tick:
        def ping() -> i64

    handler H() for Tick:
        def ping() -> i64:
            return 2

def main() -> i64:
    can Tick with H:
        return Tick.ping()
