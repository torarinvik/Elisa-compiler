error Failure:
    Bad(code: i64)

def make(value: bool) -> i64 error[Failure]:
    if value:
        return 40
    raise Failure.Bad(7)

def exercise(value: bool) -> i64 error[Failure]:
#line 80 inferred-try-site.elisa
    captured = make(value)
#line 80 inferred-try-site.elisa
    propagated = try make(value)
    captured_payload: i64 = catch captured:
        value:
            value
        Failure.Bad(code):
            code
    return captured_payload + propagated

def main() -> i64:
    success: i64 = try exercise(true) else 0
    failed: i64 = try exercise(false) else 50
    return success + failed
