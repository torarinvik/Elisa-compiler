module A:
    effect Tick:
        def ping() -> i64

module B:
    effect Tick:
        def pong() -> i64

module Util:
    def emit_tick() -> i64 can[A::Tick]:
        return Tick.ping()

handler AHandler() for A::Tick:
    def ping() -> i64:
        return 42

def main() -> i64:
    can A::Tick with AHandler:
        return Util::emit_tick()
