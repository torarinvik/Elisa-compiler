effect Tick:
    def ping() -> i64

effect Tock:
    def pong() -> i64

handler static Sink(value: i64) for Tick:
    def ping() -> i64:
        return value

handler static Other(value: i64) for Tock:
    def pong() -> i64:
        return value

def emit() -> i64 can[Tick, Tock]:
    return Tick.ping() + Tock.pong()

def wrapper() -> i64 can[Tick, Tock]:
    return emit()

def main() -> i64:
    can Tick with Sink(11):
        can Tock with Other(22):
            return wrapper()
