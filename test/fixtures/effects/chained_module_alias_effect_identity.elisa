# Effect identity must follow a chained module alias through a namespace suffix.
module Backend:
    module Effects:
        effect Tick:
            def ping() -> i64

using Backend as BackendRoot
using BackendRoot as First
using First as Fx

module Client:
    handler Noop() for Fx::Effects::Tick:
        def ping() -> i64:
            return 42

    def run() -> i64:
        can Fx::Effects::Tick with Noop:
            return Fx::Effects::Tick.ping()

def main() -> i64:
    return Client::run()
