error FirstFault:
    Wrong(code: i64)

error SecondFault:
    Chosen(code: i64)

def choose(value: i64, code: i64 = 2) -> i64 error[FirstFault]:
    raise FirstFault.Wrong(99)

def choose(value: bool, code: i64 = 2) -> i64 error[SecondFault]:
    if value:
        return 40 + code
    raise SecondFault.Chosen(code + 5)

def main() -> i64:
    success = choose(code: 2, value: true)
    failure = choose(value: false)
    success_payload: i64 = catch success:
        value:
            value
        SecondFault.Chosen(_):
            -2
    failure_tag: i64 = catch failure:
        value:
            -3
        SecondFault.Chosen(code):
            code
    return 42 if success_payload == 42 and failure_tag == 7 else 1
