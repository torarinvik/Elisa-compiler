module A:
    effect Tick:
        def ping() -> i64

    handler H() for Tick:
        def ping() -> i64:
            return 1

    def run() -> i64:
        can Tick with H:
            return Tick.ping()

module B:
    effect Tick:
        def ping() -> i64

    handler H() for Tick:
        def ping() -> i64:
            return 2

def main() -> i64:
    return A::run()
