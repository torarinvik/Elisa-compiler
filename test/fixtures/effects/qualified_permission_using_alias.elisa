# A qualified permission grant through a chained module alias covers the same
# declaration when the callee's effect row uses its canonical module path.
module Backend:
    module Parent:
        public:
            permission Cap:
                Read

            def needs_read() -> void can[Backend::Parent::Cap.Read]:
                return

    module Alternate:
        public:
            permission Cap:
                Read

using Backend::Parent as ParentAlias
using ParentAlias as CapabilityScope

def caller() -> void:
    can CapabilityScope::Cap.Read:
        Backend::Parent::needs_read()

def main() -> i64:
    can Backend::Parent::Cap.Read:
        caller()
    return 0

# This later alias must not change the resolution of the earlier grant in caller.
using Backend::Alternate as CapabilityScope
