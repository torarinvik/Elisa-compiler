error Fault:
    Available(enabled: bool, count: i64)
    Busy(code: i64)

global mutable cleanup_count: i64 = 0
global mutable argument_count: i64 = 0

def evaluate_fail(fail: bool) -> bool:
    can Global{Read,Write}:
        argument_count <- argument_count + 1
        return fail

def produce(fail: bool) -> i64 error[Fault{Busy}]:
    raise Fault.Busy(9) if fail
    return 22

def forward_local(fail: bool) -> i64 error[Fault] can[Global{Read,Write}]:
    can Global{Read,Write}:
        defer block:
            cleanup_count <- cleanup_count + 1
        source: i64 error[Fault] = produce(evaluate_fail(fail))
        return source

def inspect_local(fail: bool) -> i64 can[Global{Read,Write}]:
    can Global{Read,Write}:
        forwarded: i64 error[Fault] = forward_local(fail)
        return catch forwarded:
            value: value
            Fault.Available(enabled, count): -1
            Fault.Busy(code): code

def main() -> i64 can[Global{Read,Write}]:
    can Global{Read,Write}:
        success: i64 = inspect_local(false)
        failed: i64 = inspect_local(true)
        return success + failed + cleanup_count + argument_count
