# The clone is emitted from Util, but the installed handler is A::H. Callee lowering must
# retain the exact install identity instead of resolving H again in the helper's module.
module A:
    effect Tick:
        def ping() -> i64

    handler H(value: i64) for Tick:
        def ping() -> i64:
            return value

    def run() -> i64:
        can Tick with H(42):
            return Util::emit_tick()

module Util:
    def emit_tick() -> i64 can[Tick]:
        return Tick.ping()

def main() -> i64:
    return A::run()
