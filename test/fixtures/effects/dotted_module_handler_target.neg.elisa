# The same rule for a handler's target row: `for A.Tick` names no interface, it is
# `for A::Tick` written with the value-member separator. Deliberately no installation --
# the dotted target alone is the error under test.
module A:
    effect Tick:
        def ping() -> i64

handler H() for A.Tick:
    def ping() -> i64:
        return 2

def main() -> i64:
    return 0
