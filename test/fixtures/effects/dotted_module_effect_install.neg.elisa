# A module is reached with `::`, never `.`. Inside an effect row a dot is the concrete
# permission path (`Console.Write`), so the row cannot be judged by spelling alone -- but
# when the leading segment names a module, the diagnostic must say which rule applies.
module A:
    effect Tick:
        def ping() -> i64

handler H() for A::Tick:
    def ping() -> i64:
        return 2

def main() -> i64:
    can A.Tick with H:
        return A::Tick.ping()
