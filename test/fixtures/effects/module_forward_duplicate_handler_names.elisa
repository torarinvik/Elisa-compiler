# A forward installation must select the handler declared in its own module even when an
# equally named handler exists elsewhere. Returning 2 would mean predeclaration resolved
# `H` by terminal name instead of by declaration identity.
module A:
    effect Tick:
        def ping() -> i64

    def run() -> i64:
        can Tick with H:
            return Tick.ping()

    handler H() for Tick:
        def ping() -> i64:
            return 1

module B:
    effect Tick:
        def ping() -> i64

    handler H() for Tick:
        def ping() -> i64:
            return 2

def main() -> i64:
    return A::run()
