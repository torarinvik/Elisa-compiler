const enum SignedTag of u8:
    One = 1

const enum UnsignedTag of u8:
    One = 1

effect Pick[T]:
    def value() -> i64

handler static SignedAnswer() for Pick[SignedTag]:
    def value() -> i64:
        return 11

handler static UnsignedAnswer() for Pick[UnsignedTag]:
    def value() -> i64:
        return 23

def pick[T]() -> i64 can[Pick[T]]:
    return Pick[T].value()

def main() -> i64:
    can Pick[SignedTag] with SignedAnswer:
        can Pick[UnsignedTag] with UnsignedAnswer:
            return pick[SignedTag]() + pick[UnsignedTag]()
