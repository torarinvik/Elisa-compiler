effect Writer[T]:
    def write(value: T) -> void

handler Sink(prefix: i64) for Writer[sview]:
    def write(value: sview) -> void can[Console.Write]:
        return

def emit(value: sview) -> void can[Writer[sview] via Console.Write]:
    return

def main() -> i64:
    can Writer[sview] with Sink(5):
        Writer.write("hello")
        emit("world")
    return 42
