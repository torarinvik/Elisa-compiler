effect Tick:
    def ping() -> void

handler static Sink() for Tick:
    def ping() -> void:
        return

module A:
    def emit() -> i64 can[Tick]:
        Tick.ping()
        return 11

module B:
    def emit() -> i64 can[Tick]:
        Tick.ping()
        return 22

def main() -> i64:
    can Tick with Sink:
        return B::emit()
