# The nested alias binds Parent's permission independently of the root alias.
module Parent:
    using NestedTarget as Shared

    module NestedTarget:
        public:
            permission slot:
                Read

    public:
        def needs_read() -> void can[Shared::slot.Read]:
            return

        def call_with_nested_grant() -> void:
            can NestedTarget::slot.Read:
                needs_read()

module RootTarget:
    public:
        permission slot:
            Read

        def needs_read() -> void can[RootTarget::slot.Read]:
            return

using RootTarget as Shared

def caller() -> void:
    can Shared::slot.Read:
        RootTarget::needs_read()

def main() -> i64:
    Parent::call_with_nested_grant()
    caller()
    return 0
