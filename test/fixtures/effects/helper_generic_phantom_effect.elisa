effect Pick[T]:
    def value() -> i64

handler static Signed() for Pick[i64]:
    def value() -> i64:
        return 11

handler static Unsigned() for Pick[u64]:
    def value() -> i64:
        return 23

def pick[T]() -> i64 can[Pick[T]]:
    return Pick[T].value()

def main() -> i64:
    can Pick[i64] with Signed:
        can Pick[u64] with Unsigned:
            return pick[i64]() + pick[u64]()
