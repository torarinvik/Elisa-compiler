# A qualified authority name resolves against the complete lexical module path
# before considering the same child name in a parent or at the root.
module Cap:
    public:
        permission slot:
            Write

module Outer:
    public:
        module Cap:
            public:
                permission slot:
                    Write

        module Inner:
            public:
                module Cap:
                    public:
                        permission slot:
                            Read

                        def needs_read() -> void can[Outer::Inner::Cap::slot.Read]:
                            return

                def caller() -> void:
                    can Cap::slot.Read:
                        Outer::Inner::Cap::needs_read()

def main() -> i64:
    can Outer::Inner::Cap::slot.Read:
        Outer::Inner::caller()
    return 0
