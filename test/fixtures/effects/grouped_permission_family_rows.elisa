# Grouped permission families in function effect rows must resolve like their dotted members.
def global_permissions() -> void can[Global{Read, Write}]:
    return

def memory_permissions() -> void can[Memory{Allocate, Release}]:
    return

def main() -> i64:
    can Global{Read, Write}:
        global_permissions()
    can Memory{Allocate, Release}:
        memory_permissions()
    return 0
