effect Tick:
    def ping() -> void

handler static Sink() for Tick:
    def ping() -> void:
        return

handler static Other() for Tick:
    def ping() -> void:
        return

def emit() -> void can[Tick]:
    Tick.ping()

def main() -> void:
    can Tick with Sink:
        can Tick with Other:
            emit()
