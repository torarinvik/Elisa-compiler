# The same mismatch with the installation at top level. A bare `Tick` written outside
# every module names the top-level declaration; reading it as ambiguous with `A::Tick`
# would leave the installation without an identity and re-enable the family fallback.
module A:
    effect Tick:
        def ping() -> i64

effect Tick:
    def ping() -> i64

handler H() for Tick:
    def ping() -> i64:
        return 2

def run() -> i64:
    can Tick with H:
        return A::Tick.ping()

def main() -> i64:
    return run()
