module A:
    effect Tick:
        def ping() -> i64

module Client:
    handler H() for A::Tick:
        def ping() -> i64:
            return 42

    def run() -> i64:
        can A::Tick with H:
            return Tick.ping()

module B:
    effect Tick:
        def ping() -> i64

def main() -> i64:
    return Client::run()
