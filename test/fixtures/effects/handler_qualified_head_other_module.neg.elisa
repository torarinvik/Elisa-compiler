# Both effects declare `ping`, so the operation exists under either family and the
# terminal-name comparison cannot separate them. The installation resolved to B's
# `Tick`; a head naming A's must not bind to B's handler.
module A:
    effect Tick:
        def ping() -> i64

module B:
    effect Tick:
        def ping() -> i64

    handler H() for Tick:
        def ping() -> i64:
            return 2

    def run() -> i64:
        can Tick with H:
            return A::Tick.ping()

def main() -> i64:
    return B::run()
