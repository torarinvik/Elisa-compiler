effect Tick:
    def ping() -> void

struct Counter:
    value: mutable i64

handler static Sink(counter: mutable Counter&) for Tick:
    def ping() -> void:
        counter.value <- counter.value + 1

module Helpers:
    def first(remaining: i64) -> void can[Tick]:
        if remaining == 0:
            Tick.ping()
        else:
            second(remaining - 1)

    def second(remaining: i64) -> void can[Tick]:
        if remaining == 0:
            Tick.ping()
        else:
            first(remaining - 1)

    def run() -> void:
        counter: mutable Counter = Counter{value: 0}
        can Tick with Sink(&counter):
            first(4)
        can Tick with Sink(&counter):
            second(5)
        assert counter.value == 2 can Abort.Panic

def main() -> void:
    Helpers::run()
