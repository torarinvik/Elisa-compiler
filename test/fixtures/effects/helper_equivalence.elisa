effect First:
    def get() -> i64

effect Second:
    def get() -> i64

handler static GetFirst(value: i64) for First:
    def get() -> i64:
        return value

handler static GetSecond(value: i64) for Second:
    def get() -> i64:
        return value

def sum_values() -> i64 can[First, Second]:
    return First.get() + Second.get()

def wrapper() -> i64 can[First, Second]:
    return sum_values()

def calculate_impl(first: i64, second: i64) -> i64:
    can First with GetFirst(first):
        can Second with GetSecond(second):
            return wrapper()

export fn calculate(first: i64, second: i64) -> i64 = calculate_impl

def main() -> i64:
    return calculate_impl(11, 22)
