effect Tick:
    def ping() -> void

handler static Sink(prefix: i64) for Tick:
    def ping() -> void:
        return

module Util:
    def leaf() -> void:
        return
    def emit() -> void can[Tick]:
        leaf()
        Tick.ping()

def main() -> void:
    can Tick with Sink(7):
        Util::emit()
