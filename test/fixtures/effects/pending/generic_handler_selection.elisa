# Pending typed-instantiation acceptance case: must return 17. The same generic
# helper is instantiated twice under one lexical environment, selecting different
# handlers. A parser-time substitution of the nearest handler cannot implement it.
effect Ask[T]:
    def get() -> T

handler static IntAnswer() for Ask[i64]:
    def get() -> i64:
        return 17

handler static BoolAnswer() for Ask[bool]:
    def get() -> bool:
        return true

def ask[T]() -> T can[Ask[T]]:
    return Ask[T].get()

def main() -> i64:
    can Ask[i64] with IntAnswer:
        can Ask[bool] with BoolAnswer:
            if ask[bool]():
                return ask[i64]()
    return 0
