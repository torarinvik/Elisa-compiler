effect Tick:
    def ping() -> i64

handler static Sink(value: i64) for Tick:
    def ping() -> i64:
        return value

module Util:
    def emit[T](value: T) -> i64 can[Tick]:
        return Tick.ping()

def wrapper() -> i64 can[Tick]:
    return Util::emit[i64](7)

def main() -> i64:
    can Tick with Sink(47):
        return wrapper()
