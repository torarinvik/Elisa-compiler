# Direct aliases register before aliases in an active static-if branch, even when
# the static branch appears first in source. RootTarget remains the canonical target.
module NestedTarget:
    public:
        permission slot:
            Read

module RootTarget:
    public:
        permission slot:
            Read

        def needs_read() -> void can[RootTarget::slot.Read]:
            return

static if true:
    using NestedTarget as Shared

using RootTarget as Shared

def caller() -> void:
    can Shared::slot.Read:
        RootTarget::needs_read()

def main() -> i64:
    caller()
    return 0
