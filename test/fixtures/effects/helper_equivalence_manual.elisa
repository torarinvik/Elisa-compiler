# Hand-written reference for helper_equivalence.elisa. The public calculate
# function accepts runtime values: equivalence cannot rely on constant folding.
def calculate_impl(first: i64, second: i64) -> i64:
    return first + second

export fn calculate(first: i64, second: i64) -> i64 = calculate_impl

def main() -> i64:
    return calculate_impl(11, 22)
