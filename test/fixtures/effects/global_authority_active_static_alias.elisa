# Only the selected static-if arm registers a module alias. The inactive first arm
# must not shadow the active else-arm's permission target.
module InactiveTarget:
    public:
        permission slot:
            Read

module ActiveTarget:
    public:
        permission slot:
            Read

        def needs_read() -> void can[ActiveTarget::slot.Read]:
            return

static if false:
    using InactiveTarget as Shared
static else:
    using ActiveTarget as Shared

def caller() -> void:
    can Shared::slot.Read:
        ActiveTarget::needs_read()

def main() -> i64:
    caller()
    return 0
