permission Local:
    Read
    Write

alias Deep16 = Local.Read
alias Deep15 = Deep16
alias Deep14 = Deep15
alias Deep13 = Deep14
alias Deep12 = Deep13
alias Deep11 = Deep12
alias Deep10 = Deep11
alias Deep09 = Deep10
alias Deep08 = Deep09
alias Deep07 = Deep08
alias Deep06 = Deep07
alias Deep05 = Deep06
alias Deep04 = Deep05
alias Deep03 = Deep04
alias Deep02 = Deep03
alias Deep01 = Deep02
alias Deep00 = Deep01

def requires_read() -> void can[Deep00]:
    return

def main() -> void:
    can Local.Write:
        requires_read()
