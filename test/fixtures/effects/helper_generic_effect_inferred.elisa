effect Identity[T]:
    def transform(value: T) -> T

handler static Increment() for Identity[i64]:
    def transform(value: i64) -> i64:
        return value + 1

def apply[T](value: T) -> T can[Identity[T]]:
    return Identity[T].transform(value)

def main() -> i64:
    can Identity[i64] with Increment:
        return apply(41)
