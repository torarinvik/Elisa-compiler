effect Tick:
    def ping() -> void

effect Other:
    def flush() -> void

def require_tick() -> void can[Tick]:
    return

def require_other() -> void can[Other]:
    return

def emit(value: sview) -> void can[Console.Write]:
    return

def main() -> void:
    can Tick via Console.Write, Other via Console.Write:
        require_tick()
        require_other()
        emit("hello")
