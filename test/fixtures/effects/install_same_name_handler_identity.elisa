# Same-spelled handlers in different modules have distinct targets, operation signatures,
# and capture lists. The installations must validate and lower using each exact identity.
module A:
    effect LeftTick:
        def ping() -> i64

    handler H(value: i64) for LeftTick:
        def ping() -> i64:
            return value

    def run() -> i64:
        can LeftTick with H(10):
            return LeftTick.ping()

module B:
    effect RightTick:
        def ping(flag: bool) -> i64

    handler H() for RightTick:
        def ping(flag: bool) -> i64:
            return 32

    def run() -> i64:
        can RightTick with H:
            return RightTick.ping(true)

def main() -> i64:
    return A::run() + B::run()
