module A:
    effect Tick:
        def ping() -> i64

module B:
    effect Tick:
        def ping() -> i64

    handler MissingTarget() for Missing::Tick:
        def ping() -> i64:
            return 42

    def run() -> i64:
        can Tick with MissingTarget:
            return Tick.ping()

def main() -> i64:
    return B::run()
