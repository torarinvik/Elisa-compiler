# The installation precedes the handler declaration inside the same module. Predeclaration
# must register the handler under its enclosing module, or the install site generates a
# top-level hidden operation name the declaration never defines.
module A:
    effect Tick:
        def ping() -> i64

    def run() -> i64:
        can Tick with H:
            return Tick.ping()

    handler H() for Tick:
        def ping() -> i64:
            return 7

def main() -> i64:
    return A::run()
