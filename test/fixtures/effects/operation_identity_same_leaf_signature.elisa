module A:
    effect Tick[Left, Right]:
        def ping(left: Left, right: Right) -> Left

module B:
    effect Tick[Value]:
        def ping(value: Value) -> Value

    handler BHandler(value: i64) for Tick[i64] via Global.Read:
        def ping(value: i64) -> i64:
            return value + 1

    def run() -> i64:
        can Tick[i64] with BHandler(41):
            return B::Tick[i64].ping(41)

def main() -> i64:
    can B::Tick[i64], Global.Read:
        return B::run()
