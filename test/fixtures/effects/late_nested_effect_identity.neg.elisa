module A:
    effect Tick:
        def ping() -> i64

module Client:
    handler H() for A::Tick:
        def ping() -> i64:
            return 42

    def run() -> i64:
        can A::Tick with H:
            return A::Tick.ping()

    module A:
        effect Tick:
            def ping() -> bool

def main() -> i64:
    return Client::run()
