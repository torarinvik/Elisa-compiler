effect Ask[T]:
    def get() -> T

handler static IntAnswer(value: i64) for Ask[i64]:
    def get() -> i64:
        return value

handler static BoolAnswer(value: bool) for Ask[bool]:
    def get() -> bool:
        return value

def ask[T]() -> T can[Ask[T]]:
    return Ask[T].get()

def calculate_impl(value: i64, enabled: bool) -> i64:
    can Ask[i64] with IntAnswer(value):
        can Ask[bool] with BoolAnswer(enabled):
            if ask[bool]():
                return ask[i64]()
    return 0

export fn calculate(value: i64, enabled: bool) -> i64 = calculate_impl

def main() -> i64:
    return calculate_impl(17, true)
