effect Tick:
    def ping() -> i64

handler static Sink(value: i64) for Tick:
    def ping() -> i64:
        return value

def emit[T](value: T) -> i64 can[Tick]:
    return Tick.ping()

def wrapper[T](value: T) -> i64 can[Tick]:
    return emit[T](value)

def main() -> i64:
    can Tick with Sink(31):
        return wrapper[i64](7)
