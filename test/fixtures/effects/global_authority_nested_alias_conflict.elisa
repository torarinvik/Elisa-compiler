# Core registers direct aliases in the current block before descending into nested modules.
# Although the nested alias appears first in the source, the top-level alias is registered
# first and remains the canonical target for `Shared`.
module Parent:
    using NestedTarget as Shared

    module NestedTarget:
        public:
            permission slot:
                Read

    public:
        def needs_read() -> void can[Shared::slot.Read]:
            return

module RootTarget:
    public:
        permission slot:
            Read

        def needs_read() -> void can[RootTarget::slot.Read]:
            return

using RootTarget as Shared

def caller() -> void:
    can Shared::slot.Read:
        RootTarget::needs_read()

def main() -> i64:
    caller()
    return 0
