error CaptureError:
    Failed

effect Tick:
    def ping() -> i64 error[CaptureError]

handler static Sink(token: i64, value: i64 error[CaptureError]) for Tick:
    def ping() -> i64 error[CaptureError]:
        payload: i64 = try value
        return token + payload

def make_value() -> i64 error[CaptureError]:
    return 22

def make_failure() -> i64 error[CaptureError]:
    raise CaptureError.Failed

def emit() -> i64 error[CaptureError] can[Tick]:
    return Tick.ping()

def success_case() -> i64:
    can Tick with Sink(20, make_value()):
        catch emit():
            value:
                return value
            error failure:
                return -1

def failure_case() -> i64:
    can Tick with Sink(20, make_failure()):
        catch emit():
            value:
                return -2
            error failure:
                return 0

def bool_error_caller(value: i64 error[CaptureError]) -> bool error[CaptureError]:
    payload: i64 = try value
    return payload == 22

def bool_success_case() -> i64:
    result: bool = try bool_error_caller(make_value()) else false
    if result:
        return 0
    return -3

def bool_failure_case() -> i64:
    result: bool = try bool_error_caller(make_failure()) else true
    if result:
        return 0
    return -4

def main() -> i64:
    return success_case() + failure_case() + bool_success_case() + bool_failure_case()
