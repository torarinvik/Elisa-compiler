effect Tick:
    def ping() -> void
    def flush() -> void

handler Outer(prefix: i64) for Tick:
    def flush() -> void:
        return

handler Inner(suffix: i64) for Tick:
    def ping() -> void:
        return

def main() -> void:
    can Tick with Outer(1):
        can Tick with Inner(2):
            Tick.ping()
            Tick.flush()
