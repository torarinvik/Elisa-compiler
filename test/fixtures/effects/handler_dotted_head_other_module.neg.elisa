# `A.Tick` is the same namespace qualification written with a dot. It must be rejected
# for the same reason as `A::Tick`, not fall through to the terminal-family fallback.
module A:
    effect Tick:
        def ping() -> i64

module B:
    effect Tick:
        def ping() -> i64

    handler H() for Tick:
        def ping() -> i64:
            return 2

    def run() -> i64:
        can Tick with H:
            return A.Tick.ping()

def main() -> i64:
    return B::run()
