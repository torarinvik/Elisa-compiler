effect Tick:
    def ping() -> void

handler static Sink() for Tick:
    def ping() -> void:
        return

module Util:
    def leaf() -> void:
        return

    def emit_tick() -> void can[Tick]:
        leaf()
        Tick.ping()

def main() -> void:
    can Tick with Sink:
        Util::emit_tick()
