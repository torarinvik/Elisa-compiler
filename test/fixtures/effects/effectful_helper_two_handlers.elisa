effect Tick:
    def ping() -> void

handler static First() for Tick:
    def ping() -> void:
        return

handler static Second() for Tick:
    def ping() -> void:
        return

def emit_tick() -> void can[Tick]:
    Tick.ping()

def main() -> void:
    can Tick with First:
        emit_tick()
    can Tick with Second:
        emit_tick()
