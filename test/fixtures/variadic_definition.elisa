extern va_list

@intrinsic("llvm.va_start")
extern llvm_va_start(storage: mutable void&) -> void

@intrinsic("llvm.va_end")
extern llvm_va_end(storage: mutable void&) -> void

extern vprintf(format: cstr, args: va_list) -> int

def print_values(format: cstr, ...) -> void:
    arguments: mutable va_list = zeroed
    llvm_va_start((&arguments).cast[mutable void&])
    _ = vprintf(format, arguments)
    llvm_va_end((&arguments).cast[mutable void&])

def main() -> i64:
    print_values("value=%d word=%s\n", 42, "hello")
    return 0
