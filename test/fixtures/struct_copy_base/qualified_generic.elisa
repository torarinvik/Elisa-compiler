# Copy-update literal through a module-qualified struct, a reference parameter base, and a
# generic struct instantiation. Exits 42 on success.
module Geo:
    public:
        struct Pt:
            x: i64
            y: i64

        def shift(p: Pt&) -> Pt:
            return Pt{..p, x: p.x + 1}

struct Pair[T]:
    a: T
    b: T

def bump(p: Geo::Pt&) -> Geo::Pt:
    return Geo::Pt{..p, y: 30}

def main() -> i64:
    p: Geo::Pt = Geo::Pt{x: 1, y: 2}
    q: Geo::Pt = Geo::shift(&p)
    r: Geo::Pt = bump(&q)
    g: Pair[i64] = Pair[i64]{a: 4, b: 5}
    h: Pair[i64] = Pair[i64]{..g, b: 6}
    return 1 if q.x != 2 or q.y != 2
    return 2 if r.x != 2 or r.y != 30
    return 3 if h.a != 4 or h.b != 6 or g.b != 5
    return 42
