# Copy-update literal: overridden fields take new values, the rest come from the base
# (including a field with a default, which never applies), the base is unchanged, darray
# and sview fields copy, `T{..b}` copies, and a field-path base works. `Outer` is declared
# AFTER its literals to exercise the seeded second parse. Exits 42 on success.
struct Inner:
    tag: i64
    names: darray[sview]

def make() -> Outer:
    names: mutable darray[sview] = []
    names.push("a")
    names.push("b")
    return Outer{inner: Inner{tag: 7, names: names}, x: 1, y: 2, label: "base", scale: 9}

def main() -> i64:
    base: Outer = make()
    moved: Outer = Outer{..base, x: 10}
    copy: Outer = Outer{..base}
    path: Inner = Inner{..base.inner, tag: 99,}
    return 1 if moved.x != 10 or moved.y != 2 or moved.scale != 9 or moved.inner.tag != 7
    return 2 if moved.label != "base" or moved.inner.names.count != 2
    return 3 if copy.x != 1 or copy.scale != 9 or copy.label != "base"
    return 4 if path.tag != 99 or path.names.count != 2 or path.names[1] != "b"
    return 5 if base.x != 1 or base.inner.tag != 7 or base.scale != 9
    return 42

struct Outer:
    inner: Inner
    x: i64
    y: i64
    label: sview
    scale: i64 = 5
