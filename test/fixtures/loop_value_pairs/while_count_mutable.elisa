# loop-value pair: the scoped and mutable forms must compile to identical machine code.
@inline(never)
def seed() -> i64:
    return 3

@inline(never)
def steps(limit: i64) -> i64:
    n: mutable i64 = 0
    while n * n < limit:
        n <- n + 1
    return n

def main() -> i64:
    return 0 if steps(seed() * 10) == 6 else 1
