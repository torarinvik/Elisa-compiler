# loop-value pair: the scoped and mutable forms must compile to identical machine code.
@inline(never)
def seed() -> i64:
    return 3

@inline(never)
def total(numbers: darray[usize]&) -> usize:
    sum: mutable usize = 0
    for num in numbers:
        sum <- sum + num
    return sum

def main() -> i64:
    numbers: mutable darray[usize] = []
    for i in 0..<seed().usize():
        numbers.push(i)
    empty: darray[usize] = []
    return 0 if total(numbers) == 3 and total(empty) == 0 else 1
