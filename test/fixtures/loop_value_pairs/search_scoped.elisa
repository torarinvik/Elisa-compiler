# loop-value pair: the scoped and mutable forms must compile to identical machine code.
@inline(never)
def seed() -> i64:
    return 3

@inline(never)
def find(values: darray[i64]&, target: i64) -> usize?:
    hit: usize? =
        for i in 0..<values.count |hit: usize? = null| -> hit:
            if values[i] == target:
                hit <- i
                break
    return hit

def code(found: usize?) -> i64:
    if found is index:
        return index.i64()
    return 99

def main() -> i64:
    values: mutable darray[i64] = []
    for i in 0..<seed().usize():
        values.push(i.i64() + 4)
    return 0 if code(find(values, 5)) == 1 and code(find(values, 70)) == 99 else 1
