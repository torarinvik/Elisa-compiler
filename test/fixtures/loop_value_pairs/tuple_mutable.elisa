# loop-value pair: the scoped and mutable forms must compile to identical machine code.
@inline(never)
def seed() -> i64:
    return 3

@inline(never)
def stats(xs: darray[i64]&) -> i64:
    total: mutable i64 = 0
    count: mutable usize = 0
    for x in xs:
        total <- total + x
        count <- count + 1
    return total * 10 + count.i64()

def main() -> i64:
    xs: mutable darray[i64] = []
    for i in 0..<seed().usize():
        xs.push(i.i64() + 5)
    return 0 if stats(xs) == 183 else 1
