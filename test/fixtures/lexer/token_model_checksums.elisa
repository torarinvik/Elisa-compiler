# Lexer model — the CHECKSUMS. One FNV-1a fold over the token stream, mixing each token's kind,
# its text (through stage0's byte-string fallback where that applies), its suffix and its line,
# so a stage0/stage1 divergence anywhere in the stream shows up as one differing number.
# Included by token_model_cases.elisa.


def frontend_token_hash_mix(hash: u64, value: u64) -> u64:
    return (hash ^ value) * TokenHash::PRIME




def frontend_hash_sview(hash: u64, value: sview) -> u64:
    active: mutable u64 = frontend_token_hash_mix(hash, value.len.u64())
    for i in 0..<value.len:
        active <- frontend_token_hash_mix(active, value[i].u64())
    return active




def frontend_hash_source_span(hash: u64, source: u8&, start: usize, length: usize) -> u64:
    active: mutable u64 = frontend_token_hash_mix(hash, length.u64())
    for i in 0..<length:
        active <- frontend_token_hash_mix(active, source[start + i].u64())
    return active




def frontend_stage0_latin1_ident_start(byte: u8) -> bool:
    return byte in {0xAA, 0xB5, 0xBA} or byte in 0xC0..0xD6 or byte in 0xD8..0xF6 or byte in 0xF8..0xFF



def frontend_utf8_continuation(byte: u8) -> bool:
    return byte in 0x80..0xBF




def frontend_starts_valid_utf8_sequence(source: u8&, start: usize) -> bool:
    byte: u8 = source[start]
    if byte in 0xC2..0xDF:
        return frontend_utf8_continuation(source[start + 1])
    elif byte == 0xE0:
        return source[start + 1] in 0xA0..0xBF and frontend_utf8_continuation(source[start + 2])
    elif byte in 0xE1..0xEC or byte in 0xEE..0xEF:
        return frontend_utf8_continuation(source[start + 1]) and frontend_utf8_continuation(source[start + 2])
    elif byte == 0xED:
        return source[start + 1] in 0x80..0x9F and frontend_utf8_continuation(source[start + 2])
    elif byte == 0xF0:
        return source[start + 1] in 0x90..0xBF and frontend_utf8_continuation(source[start + 2]) and frontend_utf8_continuation(source[start + 3])
    elif byte in 0xF1..0xF3:
        return frontend_utf8_continuation(source[start + 1]) and frontend_utf8_continuation(source[start + 2]) and frontend_utf8_continuation(source[start + 3])
    elif byte == 0xF4:
        return source[start + 1] in 0x80..0x8F and frontend_utf8_continuation(source[start + 2]) and frontend_utf8_continuation(source[start + 3])
    else:
        return false




def frontend_stage0_uses_byte_string_fallback(source: u8&, start: usize, length: usize) -> bool:
    if length != 1 or source[start] < 0x80:
        return false
    return not frontend_stage0_latin1_ident_start(source[start]) or frontend_starts_valid_utf8_sequence(source, start)




def frontend_hash_stage0_byte_string(hash: u64, byte: u8) -> u64:
    active: mutable u64 = frontend_token_hash_mix(hash, 2)
    active <- frontend_token_hash_mix(active, (0xC0 | (byte / 64)).u64())
    return frontend_token_hash_mix(active, (0x80 | (byte % 64)).u64())




def frontend_hash_stage0_regular_token_text(hash: u64, source: u8&, start: usize, length: usize) -> u64:
    if frontend_stage0_uses_byte_string_fallback(source, start, length):
        return frontend_hash_stage0_byte_string(hash, source[start])
    else:
        return frontend_hash_source_span(hash, source, start, length)




def frontend_hash_token(hash: u64, token: Token) -> u64:
    return frontend_token_hash_mix(hash, frontend_token_kind_code(token.kind))




def frontend_hash_token_text(hash: u64, token: Token, source: u8&) -> u64:
    text: sview = Lexer::text_or_empty(token, source)
    match token.kind:
        TokenKind.StringLit:
            return frontend_hash_decoded_literal(hash, text, false)
        TokenKind.CharLit:
            return frontend_hash_decoded_literal(hash, text, true)
        _:
            return frontend_hash_stage0_regular_token_text(hash, source, token.start.usize(), token.length.usize())




def frontend_hash_token_suffix(hash: u64, token: Token, source: u8&) -> u64:
    start: usize = token.start.usize() + token.length.usize()
    return frontend_hash_source_span(hash, source, start, token.suffix_length.usize())




def frontend_hash_token_full_with_line(hash: u64, token: Token, source: u8&, line_value: u64) -> u64:
    active: mutable u64 = frontend_token_hash_mix(hash, frontend_token_kind_code(token.kind))
    active <- frontend_token_hash_mix(active, line_value)
    active <- frontend_token_hash_mix(active, token.column.u64())
    active <- frontend_hash_token_text(active, token, source)
    active <- frontend_hash_token_suffix(active, token, source)
    return active




def frontend_hash_token_full(hash: u64, token: Token, source: u8&) -> u64:
    return frontend_hash_token_full_with_line(hash, token, source, token.line.u64())




def frontend_collapsed_newline_line_value(token: Token, source: u8&) -> u64:
    start: usize = token.start.usize()
    line_value: mutable u64 = 0
    while source[start + line_value.usize()] == '\n':
        line_value <- line_value + 1
    if line_value == 0:
        return 1
    return line_value




def frontend_token_line_value(token: Token, source: u8&) -> u64:
    if token.kind == TokenKind.Newline and token.line == 0:
        return frontend_collapsed_newline_line_value(token, source)
    return token.line.u64()




def frontend_token_checksum(tokens: darray[Token]) -> u64:
    hash: mutable u64 = frontend_token_hash_mix(TokenHash::OFFSET, tokens.count.u64())
    for token in tokens:
        hash <- frontend_hash_token(hash, token)
    return hash




def frontend_token_full_checksum(source: u8&, tokens: darray[Token]) -> u64:
    hash: mutable u64 = frontend_token_hash_mix(TokenHash::OFFSET, tokens.count.u64())
    i: mutable usize = 0
    while i < tokens.count:
        token: Token = tokens[i]
        hash <- frontend_hash_token_full_with_line(hash, token, source, frontend_token_line_value(token, source))
        i <- i + 1
    return hash




struct FrontendLexerChecksums:
    kind: mutable u64
    full: mutable u64




def frontend_lexer_stream_checksums_with_len(source: u8&, source_length: usize) -> FrontendLexerChecksums:
    can Memory.Allocate, Abort.Panic:
        lexer: mutable Lexer = Lexer::Lexer("frontend_lexer_bench.elisa", source, source_length)
        kind_hash: mutable u64 = TokenHash::OFFSET
        full_hash: mutable u64 = TokenHash::OFFSET

        while true:
            rebind token: Token, lexer = Lexer::next_token(lexer)
            kind_hash <- frontend_hash_token(kind_hash, token)
            full_hash <- frontend_hash_token_full_with_line(full_hash, token, source, frontend_token_line_value(token, source))
            if token.kind == TokenKind.Eof:
                return FrontendLexerChecksums{kind: kind_hash, full: full_hash}

        return FrontendLexerChecksums{kind: kind_hash, full: full_hash}




def frontend_tokenize_test_source(source: u8&) -> darray[Token]:
    can Memory.Allocate, Abort.Panic:
        lexer: mutable Lexer = Lexer::Lexer("frontend_lexer_test.elisa", source)
        tokens: mutable darray[Token] = []

        while true:
            rebind token: Token, lexer = Lexer::next_token(lexer)
            tokens.push(token)
            match token.kind:
                TokenKind.Eof:
                    return tokens
                _:
                    pass

        return tokens




def frontend_tokenize_literal(source: static u8&) -> darray[Token]:
    can Memory.Allocate, Abort.Panic:
        return frontend_tokenize_test_source(source)




def frontend_keyword_view(text: cstr) -> sview:
    return text[0:text.len]
