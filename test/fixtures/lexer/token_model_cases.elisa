include "../../../elisacore_std/elisacore_runtime.elisa"
include "../../../src/lexer/lexer.elisa"

module TokenHash:
    const OFFSET = 1469598103934665603


    const PRIME = 1099511628211




def frontend_expect_token_count(tokens: darray[Token], expected: usize) -> bool:
    return tokens.count == expected




def frontend_expect_kind(tokens: darray[Token], index: usize, expected: TokenKind) -> bool:
    if index >= tokens.count:
        return false
    return tokens[index].kind == expected




def frontend_expect_kinds(tokens: darray[Token], expected: TokenKind&, count: usize) -> bool:
    if not frontend_expect_token_count(tokens, count):
        return false
    for i in 0..<count:
        if not frontend_expect_kind(tokens, i, expected[i]):
            return false
    return true




def frontend_expect_text(source: u8&, tokens: darray[Token], index: usize, expected: static u8&) -> bool:
    false return if index >= tokens.count
    actual: sview = get Lexer::text(tokens[index], source) else return false
    return actual == expected




def frontend_expect_suffix(source: u8&, tokens: darray[Token], index: usize, expected: static u8&) -> bool:
    false return if index >= tokens.count
    actual: sview = get Lexer::suffix(tokens[index], source) else return false
    return actual == expected




def frontend_token_kind_code(kind: TokenKind) -> u64:
    match kind:
        TokenKind.Eof:
            return 1
        TokenKind.Newline:
            return 2
        TokenKind.Indent:
            return 3
        TokenKind.Dedent:
            return 4
        TokenKind.Ident:
            return 5
        TokenKind.IntLit:
            return 6
        TokenKind.FloatLit:
            return 7
        TokenKind.HexLit:
            return 8
        TokenKind.StringLit:
            return 9
        TokenKind.Def:
            return 10
        TokenKind.Error:
            return 11
        TokenKind.Enum:
            return 12
        TokenKind.Struct:
            return 13
        TokenKind.Const:
            return 14
        TokenKind.Global:
            return 15
        TokenKind.Extern:
            return 16
        TokenKind.Export:
            return 17
        TokenKind.If:
            return 18
        TokenKind.Match:
            return 19
        TokenKind.Elif:
            return 20
        TokenKind.Else:
            return 21
        TokenKind.While:
            return 22
        TokenKind.Break:
            return 23
        TokenKind.Continue:
            return 24
        TokenKind.Return:
            return 25
        TokenKind.Heap:
            return 26
        TokenKind.Stack:
            return 27
        # `Owned` is reserved in the stage1 enum but not currently emitted as a keyword
        # (stage0 has no TOKEN_OWNED). Keep a stable unused code so matches stay exhaustive
        # without shifting the stage0-aligned codes for Static/Mutable/…
        TokenKind.Owned:
            return 110
        TokenKind.Static:
            return 28
        TokenKind.Mutable:
            return 29
        TokenKind.Repr:
            return 31
        TokenKind.Packed:
            return 32
        TokenKind.Aligned:
            return 33
        TokenKind.Pass:
            return 34
        TokenKind.Panic:
            return 35
        TokenKind.Not:
            return 36
        TokenKind.And:
            return 37
        TokenKind.Or:
            return 38
        TokenKind.Null:
            return 39
        TokenKind.True:
            return 40
        TokenKind.False:
            return 41
        TokenKind.Zeroed:
            return 42
        TokenKind.Sizeof:
            return 43
        TokenKind.Alignof:
            return 44
        TokenKind.Offsetof:
            return 45
        TokenKind.Tail:
            return 46
        TokenKind.Try:
            return 47
        TokenKind.Catch:
            return 48
        TokenKind.Raise:
            return 49
        TokenKind.Region:
            return 50
        TokenKind.New:
            return 51
        TokenKind.As:
