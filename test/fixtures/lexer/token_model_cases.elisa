        TokenKind.RangeLt:
            return 60
        TokenKind.RangeGt:
            return 61
        TokenKind.RangeLe:
            return 109
        TokenKind.Comma:
            return 62
        TokenKind.LParen:
            return 63
        TokenKind.RParen:
            return 64
        TokenKind.LBracket:
            return 65
        TokenKind.RBracket:
            return 66
        TokenKind.Hash:
            return 67
        TokenKind.Ampersand:
            return 68
        TokenKind.Question:
            return 69
        TokenKind.QAssign:
            return 70
        TokenKind.Bang:
            return 71
        TokenKind.At:
            return 72
        TokenKind.Ellipsis:
