struct CounterView:
    count: sview
def fill(out: mutable darray[sview]&) -> void:
    can Memory.Allocate, Abort.Panic:
        bytes: mutable darray[u8] = [65.u8()]
        counter: CounterView = CounterView{count: bytes.as_sview()}
        out.push(counter.count)
def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[sview] = []
        fill(&out)
        return out.count.i64()
