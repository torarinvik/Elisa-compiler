def eb(out: mutable darray[i64&]&, r: i64&, n: i64) -> i64:
    if n > 0:
        return ea(out, r, n - 1)
    return 0

def ea(out: mutable darray[i64&]&, r: i64&, n: i64) -> i64:
    if n > 0:
        return r + eb(out, r, n - 1)
    return out.count.i64()

def fill(out: mutable darray[i64&]&) -> i64:
    x: i64 = 7
    return eb(out, &x, 3)

def main() -> i64:
    out: mutable darray[i64&] = []
    return fill(&out) - 7
