struct ViewHolder:
    view: mutable sview
def byte_count(text: sview) -> i64:
    can Abort.Panic:
        return text.len.i64()
def remember(holder: mutable ViewHolder&, text: sview) -> sview:
    holder.view <- text
    return text
def fill(out: mutable darray[i64]&, holder: mutable ViewHolder&) -> void:
    can Memory.Allocate, Abort.Panic:
        bytes: mutable darray[u8] = [65.u8()]
        out.push(byte_count(remember(holder, bytes.as_sview())))
def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[i64] = []
        holder: mutable ViewHolder = ViewHolder{view: ""}
        fill(&out, &holder)
        return out[0]
