def main() -> i32:
    can Memory.Allocate:
        base: mutable darray[i64] = [0]
        v: mutable view[i64] = base[0:0]
        in auto:
            xs: mutable darray[i64] = [1, 2, 3]
            v <- xs[0:2]
        ys: mutable darray[i64] = [9, 9, 9, 9, 9]
        return v[1].i32() + ys[0].i32()
