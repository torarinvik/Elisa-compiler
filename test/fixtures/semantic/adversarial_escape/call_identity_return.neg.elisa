include "../../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../../elisacore_std/collections.elisa"
include "../../../../elisacore_std/elisacore_runtime_strings.elisa"
def id(x: sview) -> sview:
    return x

def leak() -> sview:
    buf: darray[u8] = [65.u8(), 66.u8()]
    return id(bytes_view_range(buf, 0, buf.count))

def main() -> i64:
    v: sview = leak()
    return v[0].i64()
