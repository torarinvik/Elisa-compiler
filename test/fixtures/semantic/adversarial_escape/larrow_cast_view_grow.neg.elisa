def big() -> i64:
    return 4096

def main() -> i64 can[Unsafe.PointerCast]:
    buf: mutable darray[u8] = []
    for i in 0..<300 |buf|:
        buf.push(65.u8())
    buf.push(0.u8())
    c: mutable cstr = ""
    c <- (&buf[0]).cast[cstr] can Unsafe.PointerCast
    for i in 0..<big() |buf|:
        buf.push(1.u8())
    buf[0] <- 66.u8()
    return c[0].i64()
