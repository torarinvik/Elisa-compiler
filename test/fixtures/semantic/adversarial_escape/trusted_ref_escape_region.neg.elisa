include "../../../../elisacore_std/elisacore_runtime.elisa"
def scribble() -> i64:
    total: mutable i64 = 0
    for k in 0..<8:
        region junk(4096):
            fill: mutable darray[u8] @junk = []
            for i in 0..<512:
                fill.push(90.u8())
            total <- total + fill[0].i64()
    return total

def mk(n: i64) -> darray[u8]:
    b: mutable darray[u8] = []
    for i in 0..<n:
        b.push(65.u8())
    return b

def main() -> i64:
    r: mutable i64&? = null
    region rr(4096):
        b: mutable darray[i64] @rr = []
        for i in 0..<64:
            b.push(7)
        trusted Unsafe.PointerCast:
            r <- (&b[0]).cast[i64&?]
    _ = scribble()
    if r is v:
        return v - 7
    return 1
