def zero() -> i64:
    region scratch(4096):
        return 0

def main() -> i64:
    region scratch(4096):
        f: mutable fn() -> i64 = fn() => zero()
        region scratch(4096):
            buf: mutable darray[u8] = [65.u8()]
            s: sview = buf.as_sview()
            f <- fn() => s[0].i64()
        return f()
