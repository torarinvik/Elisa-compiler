include "../../../../elisacore_std/elisacore_runtime_concurrency.elisa"
include "../../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../../elisacore_std/collections.elisa"

def first(s: sview) -> i64:
    return s[0].i64()

def main() -> i64:
    can Parallel, Memory.Allocate, Abort.Panic:
        buf: mutable darray[u8] = [65.u8()]
        v: sview = buf.as_sview()
        nursery workers(2):
            submit first(v)
        buf.push(1.u8())
        return 0
