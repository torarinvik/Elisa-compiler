include "../../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../../elisacore_std/collections.elisa"
def f(xs: mutable darray[u64]&) -> i64:
    xs.push(1.u64())
    return xs.count.i64()

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        b: mutable darray[u8] = [200.u8()]
        return f(b)
