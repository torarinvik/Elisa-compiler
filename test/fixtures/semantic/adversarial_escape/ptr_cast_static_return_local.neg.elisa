include "../../../../elisacore_std/elisacore_runtime.elisa"
def scribble() -> i64:
    total: mutable i64 = 0
    for k in 0..<8:
        region junk(4096):
            fill: mutable darray[u8] @junk = []
            for i in 0..<512:
                fill.push(90.u8())
            total <- total + fill[0].i64()
    return total

def build() -> static u8& can[Unsafe.PointerCast]:
    out: mutable darray[u8] = []
    for i in 0..<64:
        out.push(65)
    return (&out[0]).cast[static u8&]

def main() -> i64 can[Unsafe.PointerCast]:
    p: static u8& = build()
    _ = scribble()
    return p.i64() - 65
