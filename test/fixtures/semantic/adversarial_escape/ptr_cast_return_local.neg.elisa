include "../../../../elisacore_std/elisacore_runtime.elisa"
def scribble() -> i64:
    total: mutable i64 = 0
    for k in 0..<8:
        region junk(4096):
            fill: mutable darray[u8] @junk = []
            for i in 0..<512:
                fill.push(90.u8())
            total <- total + fill[0].i64()
    return total

def mk(n: i64) -> darray[u8]:
    b: mutable darray[u8] = []
    for i in 0..<n:
        b.push(65.u8())
    return b

def leak() -> u8&? can[Unsafe.PointerCast]:
    b: mutable darray[u8] = mk(64)
    return (&b[0]).cast[u8&?]

def main() -> i64 can[Unsafe.PointerCast]:
    p: u8&? = leak()
    _ = scribble()
    if p is q:
        return q.i64() - 65
    return 1
