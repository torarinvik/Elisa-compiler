def scribble() -> i64:
    total: mutable i64 = 0
    for k in 0..<8:
        region junk(4096):
            fill: mutable darray[u8] @junk = []
            for i in 0..<512:
                fill.push(90.u8())
            total <- total + fill[0].i64()
    return total

def mk(n: i64) -> darray[u8]:
    b: mutable darray[u8] = []
    for i in 0..<n:
        b.push(65.u8())
    return b

def first(b: darray[u8]&) -> u8&:
    trusted Unsafe.PointerCast:
        return (&b[0]).cast[u8&]

def main() -> i64:
    b: mutable darray[u8] = mk(4)
    r: u8& = first(b)
    for i in 0..<5000:
        b.push(66.u8())
    _ = scribble()
    return r.i64() - 65
