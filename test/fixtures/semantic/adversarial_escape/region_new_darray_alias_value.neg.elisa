def bad[@r](values: mutable darray[i64]& @r) -> void:
    copy: mutable darray[i64] = values

def pass_through[@r](values: mutable darray[i64]& @r) -> mutable darray[i64]& @r:
    return values

def bad_call[@r](values: mutable darray[i64]& @r) -> void:
    copy: mutable darray[i64] = pass_through(values)
