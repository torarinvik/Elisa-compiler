def big() -> i64:
    return 4096

def main() -> i64:
    buf: mutable darray[u8] = []
    for i in 0..<300 |buf|:
        buf.push(65.u8())
    buf.push(0.u8())
    s: mutable sview = ""
    s <- buf.as_sview()
    for i in 0..<big() |buf|:
        buf.push(1.u8())
    s <- buf.as_sview()
    buf[0] <- 66.u8()
    return s[0].i64()
