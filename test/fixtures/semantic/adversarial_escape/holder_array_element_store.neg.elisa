struct ViewHolder:
    view: sview
def fill(out: mutable darray[sview]&) -> void:
    can Memory.Allocate, Abort.Panic:
        bytes: mutable darray[u8] = [65.u8()]
        views: darray[sview] = [bytes.as_sview()]
        out.push(views[0])
def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[sview] = []
        fill(&out)
        return out.count.i64()
