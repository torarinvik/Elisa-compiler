def big() -> i64:
    return 4096

struct H:
    f: fn() -> i64

def main() -> i64:
    hs: mutable darray[H] = []
    buf: mutable darray[u8] = [65.u8()]
    s: sview = buf.as_sview()
    hs.push(H{f: fn() => s[0].i64()})
    for i in 0..<big() |buf|:
        buf.push(1.u8())
    buf[0] <- 66.u8()
    return hs[0].f()
