struct Inner:
    view: sview
struct Packet:
    value: i64
    inner: Inner
def fill(out: mutable darray[Packet]&) -> void:
    can Memory.Allocate, Abort.Panic:
        bytes: mutable darray[u8] = [65.u8()]
        packet: Packet = Packet{value: 7, inner: Inner{view: bytes.as_sview()}}
        out.push(packet)
def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[Packet] = []
        fill(&out)
        return out.count.i64()
