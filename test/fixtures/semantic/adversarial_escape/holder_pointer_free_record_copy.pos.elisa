const enum Kind of u8:
    Int
    Float
struct Inner:
    bits: u32
struct Packet:
    kind: Kind
    inner: Inner
def describe(bytes: darray[u8]&) -> Packet:
    can Abort.Panic:
        return Packet{kind: Kind.Int, inner: Inner{bits: bytes.count.u32()}}
def fill(out: mutable darray[Packet]&) -> void:
    can Memory.Allocate, Abort.Panic:
        bytes: mutable darray[u8] = [65.u8()]
        packet: Packet = describe(bytes)
        out.push(packet)
def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[Packet] = []
        fill(&out)
        return out[0].inner.bits.i64()
