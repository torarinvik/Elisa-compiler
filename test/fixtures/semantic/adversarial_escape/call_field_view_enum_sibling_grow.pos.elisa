include "../../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../../elisacore_std/collections.elisa"
include "../../../../elisacore_std/elisacore_runtime_strings.elisa"

enum Mark:
    On
    Off

struct Holder:
    buf: mutable darray[u8]
    marks: mutable darray[Mark]

def name(self: mutable Holder&) -> sview:
    return bytes_view_range(self.buf, 0, self.buf.count)

def main() -> i64:
    h: mutable Holder = Holder{buf: [65.u8()], marks: []}
    v: sview = h.name()
    for i in 0..<64:
        h.marks <- h.marks.push(Mark.On)
    return v[0].i64()
