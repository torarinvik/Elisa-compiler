# in auto: view stored into an outer struct field
struct Holder:
    v: mutable sview

def main() -> i64:
    h: mutable Holder = Holder{v: ""}
    in auto:
        b: mutable darray[u8] = [65.u8()]
        h.v <- b.as_sview()
    _ = scribble()
    return h.v[0].i64() - 65
def scribble() -> i64:
    total: mutable i64 = 0
    for k in 0..<8:
        region junk(4096):
            fill: mutable darray[u8] @junk = []
            for i in 0..<512:
                fill.push(90.u8())
            total <- total + fill[0].i64()
    return total
