include "../../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../../elisacore_std/collections.elisa"
include "../../../../elisacore_std/elisacore_runtime_strings.elisa"
enum Tok:
    Word(text: sview)
    Num(n: i64)
    Nil

def mk() -> darray[u8]:
    b: mutable darray[u8] = []
    b.push(65.u8())
    return b

def f() -> i64:
    buf: mutable darray[u8] = mk()
    t: Tok = Tok.Word(buf.as_sview())
    r: mutable i64 = 0
    match t:
        Tok.Word(text): r <- text[0].i64()
        _: r <- 1
    buf.clear()
    u: Tok = Tok.Num(7)
    match u:
        Tok.Num(n):
            buf.clear()
            r <- r + n
        _: pass
    return r

def main() -> i32:
    return f().i32()
