include "../../../../elisacore_std/elisacore_runtime.elisa"
def same(x: i64&) -> i64&? can[Unsafe.PointerCast]:
    return (&x).cast[i64&?]

def main() -> i64 can[Unsafe.PointerCast]:
    keep: mutable i64 = 0
    region r(4096):
        b: mutable darray[u8] @r = []
        b.push(65.u8())
        keep <- b[0].i64()
    seven: i64 = 7
    if same(seven) is v:
        return keep - 65 + v - 7
    return 1
