def eb(out: mutable darray[i64&]&, r: i64&, n: i64) -> void:
    if n > 0:
        ea(out, r, n - 1)

def ea(out: mutable darray[i64&]&, r: i64&, n: i64) -> void:
    if n > 0:
        out.push(r)
        eb(out, r, n - 1)

def fill(out: mutable darray[i64&]&) -> void:
    x: i64 = 77
    eb(out, &x, 2)

def smash() -> i64:
    a: i64 = 1
    b: i64 = 2
    c: i64 = 3
    d: i64 = a * b + c
    return a + b + c + d - d

def main() -> i64:
    out: mutable darray[i64&] = []
    fill(&out)
    s: i64 = smash()
    return out[0] + s - s
