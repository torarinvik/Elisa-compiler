include "../../../../elisacore_std/elisacore_runtime.elisa"
def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    m: mutable dict[i64, i64] = {}
    m <- m.put(1, 7)
    seen: mutable i64 = 0
    r: i64&? = m.get(1)
    if r is v:
        seen <- v
    for i in 2..<3000 |m|:
        m <- m.put(i, i)
    r2: i64&? = m.get(1)
    if r2 is w:
        return w + seen - 14
    return 1
