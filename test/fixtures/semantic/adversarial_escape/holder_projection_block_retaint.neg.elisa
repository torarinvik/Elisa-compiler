# A nested projection write inside a value block must remain visible on the holder root.
# The following assignment writes the local owner's view into holder.view, then the outer
# safe projection assignment to holder.other must not clear that aggregate taint before store.
struct Holder:
    view: mutable sview
    other: i64

def store(out: mutable Holder&, source: Holder) -> void:
    out.view <- source.view

def bad(out: mutable Holder&) -> void:
    owner: mutable darray[u8] = [65.u8()]
    holder: mutable Holder = Holder{view: "", other: 0}
    holder.other <- |holder|
        holder.view <- owner.as_sview()
        0
    store(out, holder)

def main() -> i64:
    output: mutable Holder = Holder{view: "", other: 0}
    bad(&output)
    return output.view.len.i64()
