# A fresh byte field returned as a view uses the caller's arena in both the
# direct and local-binding forms. Read the bytes after each factory returns.
struct HU:
    bytes: mutable darray[u8]

def mk() -> sview:
    h: mutable HU = HU{bytes: [65.u8(), 65.u8()]}
    v: sview = h.bytes.as_sview()
    return v

def mk_direct() -> sview:
    h: mutable HU = HU{bytes: [65.u8(), 65.u8()]}
    return h.bytes.as_sview()

def main() -> i64:
    w: sview = mk()
    x: sview = mk_direct()
    return 0 if w.len == 2 and x.len == 2 and w[0.usize()] == 65.u8() and x[0.usize()] == 65.u8() else 1
