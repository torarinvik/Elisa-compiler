include "../../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../../elisacore_std/collections.elisa"
include "../../../../elisacore_std/elisacore_runtime_strings.elisa"

struct P:
    storage: mutable darray[u8]
    lines: mutable darray[u32]

def main() -> i64:
    p: mutable P = P{storage: [], lines: []}
    p.storage.push(7.u8())
    view: sview = bytes_view_range(p.storage, 0, p.storage.count)
    p.lines.push(3.u32())
    return view[0].i64()
