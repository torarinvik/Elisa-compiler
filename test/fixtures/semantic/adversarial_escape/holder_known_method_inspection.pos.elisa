struct Holder:
    view: mutable sview
def inspect(holder: mutable Holder&, value: sview) -> void:
    pass
def assemble(holder: mutable Holder&) -> void:
    can Memory.Allocate, Abort.Panic:
        bytes: mutable darray[u8] = [65.u8()]
        holder.inspect(bytes.as_sview())
def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        holder: mutable Holder = Holder{view: ""}
        assemble(&holder)
        return 0
