struct ViewHolder:
    view: sview
def byte_count(text: sview) -> i64:
    can Abort.Panic:
        return text.len.i64()
def fill(out: mutable darray[i64]&) -> void:
    can Memory.Allocate, Abort.Panic:
        bytes: mutable darray[u8] = [65.u8()]
        out.push(byte_count(bytes.as_sview()))
def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[i64] = []
        fill(&out)
        return out[0]
