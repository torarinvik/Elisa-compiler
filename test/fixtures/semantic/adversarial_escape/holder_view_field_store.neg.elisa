struct Packet:
    value: i64
    view: sview
def fill(out: mutable darray[sview]&) -> void:
    can Memory.Allocate, Abort.Panic:
        bytes: mutable darray[u8] = [65.u8()]
        packet: Packet = Packet{value: 7, view: bytes.as_sview()}
        out.push(packet.view)
def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[sview] = []
        fill(&out)
        return out.count.i64()
