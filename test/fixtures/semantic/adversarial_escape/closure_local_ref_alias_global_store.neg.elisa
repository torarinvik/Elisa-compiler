global mutable closure_alias_escape_slot: i64&? = zeroed

def bad() -> void:
    x: i64 = 11
    y: i64 = 22
    publish: fn() -> void = fn():
        r: i64& = &x
        closure_alias_escape_slot <- r
        if true:
            r: i64& = &y
            closure_alias_escape_slot <- r
        else:
            r: i64& = &x
            closure_alias_escape_slot <- r
    publish()

def main() -> i64:
    bad()
    return 0
