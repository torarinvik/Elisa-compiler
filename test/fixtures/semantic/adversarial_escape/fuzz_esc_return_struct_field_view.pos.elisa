# F1 twin: a view of a struct PARAMETER's field (caller-owned bytes) may be returned.
struct HU:
    bytes: mutable darray[u8]

def first(h: HU&) -> sview:
    return h.bytes.as_sview()

def main() -> i64:
    h: mutable HU = HU{bytes: [65.u8(), 65.u8()]}
    w: sview = first(&h)
    return w.len.i64()
