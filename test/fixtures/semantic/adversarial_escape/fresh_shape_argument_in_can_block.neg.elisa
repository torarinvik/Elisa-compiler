extern resize(array: darray[i32, shape_in], size: usize) -> darray[i32, shape_out]

def grow(array: darray[i32, row]) -> darray[i32, shape_after]:
    can Abort.Panic:
        return resize(array, 8)

def same(left: darray[i32, pair], right: darray[i32, pair]) -> void:
    pass

def good(array: darray[i32, row]) -> void:
    can Abort.Panic:
        same(grow(array), array)
