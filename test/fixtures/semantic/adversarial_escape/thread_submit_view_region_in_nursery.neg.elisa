include "../../../../elisacore_std/elisacore_runtime_concurrency.elisa"
include "../../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../../elisacore_std/collections.elisa"
include "../../../../elisacore_std/elisacore_runtime_strings.elisa"
def worker(v: sview) -> i64:
    return v[0].i64() - 65
def wint(n: i64) -> i64:
    return n - 1

def main() -> i64:
    can Thread.Spawn, Thread.Join, Parallel, Memory.Allocate, Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange:
        nursery workers(2):
            region r(4096):
                b: mutable darray[u8] = [65.u8()]
                submit worker(b.as_sview())
        return 0
