def scribble() -> i64:
    total: mutable i64 = 0
    for k in 0..<8:
        region junk(4096):
            fill: mutable darray[u8] @junk = []
            for i in 0..<512:
                fill.push(90.u8())
            total <- total + fill[0].i64()
    return total

def mk(n: i64) -> darray[u8]:
    b: mutable darray[u8] = []
    for i in 0..<n:
        b.push(65.u8())
    return b

def mki(n: i64) -> darray[i64]:
    b: mutable darray[i64] = []
    for i in 0..<n:
        b.push(7)
    return b
def maybe(b: darray[i64]&, k: bool) -> i64&:
    if k:
        return &b[0]
    return &b[0]

def run(b: mutable darray[i64]&) -> i64:
    r: i64& = maybe(b, true)
    for i in 0..<5000:
        b.push(9)
    _ = scribble()
    if true:
        return r - 100
    return 1

def main() -> i64:
    b: mutable darray[i64] = mki(1)
    return run(b)
