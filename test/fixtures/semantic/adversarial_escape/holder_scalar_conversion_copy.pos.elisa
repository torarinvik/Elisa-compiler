struct ViewHolder:
    view: sview
struct Store:
    data: mutable darray[u8]
def copy_bytes(store: mutable Store&, bytes: darray[u8]&) -> void:
    can Memory.Allocate, Abort.Panic:
        for i in 0..<bytes.count:
            store.data.push(bytes[i])
def produce(store: mutable Store&) -> void:
    can Memory.Allocate, Abort.Panic:
        digits: mutable darray[u8] = []
        remaining: mutable u32 = 42
        while remaining > 0 |remaining, digits|:
            digits.push((48 + (remaining % 10)).u8())
            remaining <- remaining / 10
        bytes: mutable darray[u8] = []
        index: mutable i64 = digits.count.i64() - 1
        while index >= 0 |index, digits, bytes|:
            bytes.push(digits[index.usize()])
            index <- index - 1
        copy_bytes(store, bytes)
def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        store: mutable Store = Store{data: []}
        produce(&store)
        return store.data.count.i64()
