# in auto: view stored to an outer local
def main() -> i64:
    kept: mutable sview = ""
    in auto:
        b: mutable darray[u8] = [65.u8()]
        kept <- b.as_sview()
    _ = scribble()
    return kept[0].i64() - 65

def scribble() -> i64:
    total: mutable i64 = 0
    for k in 0..<8:
        region junk(4096):
            fill: mutable darray[u8] @junk = []
            for i in 0..<512:
                fill.push(90.u8())
            total <- total + fill[0].i64()
    return total
