include "../../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../../elisacore_std/collections.elisa"
include "../../../../elisacore_std/elisacore_runtime_strings.elisa"

protocol Source:
    def text(data: darray[u8]&) -> sview

struct Plain:
    tag: u8

impl Source for Plain:
    def text(data: darray[u8]&) -> sview:
        return bytes_view_range(data, 0, data.count)

def read[S: Source]() -> sview:
    buf: darray[u8] = [65.u8()]
    return S.text(&buf)

def main() -> i64:
    v: sview = read[Plain]()
    return v[0].i64()
