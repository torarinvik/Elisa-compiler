include "../../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../../elisacore_std/collections.elisa"
include "../../../../elisacore_std/elisacore_runtime_strings.elisa"

def mk(n: i64) -> darray[u8]:
    b: mutable darray[u8] = []
    for i in 0..<n:
        b.push(65.u8())
    return b

enum Tok:
    Word(text: sview)
    Nil

enum Num:
    Val(n: i64)
    Nil

def wrap(b: darray[u8]&) -> Tok:
    return Tok.Word(b.as_sview())

def num(b: darray[u8]&) -> Num:
    return Num.Val(b.count.i64())

def main() -> i64:
    buf: mutable darray[u8] = mk(4)
    t: Tok = wrap(buf)
    first: i64 = match t:
        Tok.Word(text): text[0].i64() - 65
        Tok.Nil: 1
    n: Num = num(buf)
    buf <- mk(1)
    return first + match n:
        Num.Val(k): k - 4
        Num.Nil: 1
