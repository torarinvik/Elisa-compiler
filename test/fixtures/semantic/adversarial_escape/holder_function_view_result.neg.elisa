struct ViewHolder:
    view: sview
def keep(text: sview) -> sview:
    return text
def fill(out: mutable darray[sview]&) -> void:
    can Memory.Allocate, Abort.Panic:
        bytes: mutable darray[u8] = [65.u8()]
        out.push(keep(bytes.as_sview()))
def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[sview] = []
        fill(&out)
        return out.count.i64()
