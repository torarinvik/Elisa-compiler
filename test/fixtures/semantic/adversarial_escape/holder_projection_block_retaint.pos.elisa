# The same nested projection form is safe when the holder receives only a static literal view.
struct Holder:
    view: mutable sview
    other: i64

def store(out: mutable Holder&, source: Holder) -> void:
    out.view <- source.view

def fill(out: mutable Holder&) -> void:
    holder: mutable Holder = Holder{view: "", other: 0}
    holder.other <- |holder|
        holder.view <- "static"
        0
    store(out, holder)

def main() -> i64:
    output: mutable Holder = Holder{view: "", other: 0}
    fill(&output)
    return output.view.len.i64()
