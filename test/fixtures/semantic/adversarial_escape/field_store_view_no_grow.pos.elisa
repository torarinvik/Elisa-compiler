def big() -> i64:
    return 4096

struct Holder:
    s: mutable sview
    n: i64

def main() -> i64:
    buf: mutable darray[u8] = []
    for i in 0..<300 |buf|:
        buf.push(65.u8())
    buf.push(0.u8())
    h: mutable Holder = Holder{s: "", n: 0}
    h.s <- buf.as_sview()
    buf[0] <- 66.u8()
    return h.s[0].i64()
