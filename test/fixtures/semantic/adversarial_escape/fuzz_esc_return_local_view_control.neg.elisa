# F1 control: the same through a plain darray local. stage1 rejects it (no region slot in a
# view-typed result); stage0 accepts it soundly by adopting its caller's arena.
def mk() -> sview:
    bytes: mutable darray[u8] = [65.u8(), 65.u8()]
    v: sview = bytes.as_sview()
    return v

def main() -> i64:
    w: sview = mk()
    return w.len.i64()
