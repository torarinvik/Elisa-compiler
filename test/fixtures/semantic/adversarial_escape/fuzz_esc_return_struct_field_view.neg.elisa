# F1: a view of a by-value struct local's darray field, returned through a binding. stage1's
# view-result ABI has no hidden region slot, so h.bytes is freed before the caller reads it.
# (stage0 accepts: it threads its caller's arena into mk and adopts the buffer -- sound there.)
struct HU:
    bytes: mutable darray[u8]

def mk() -> sview:
    h: mutable HU = HU{bytes: [65.u8(), 65.u8()]}
    v: sview = h.bytes.as_sview()
    return v

def mk_direct() -> sview:
    h: mutable HU = HU{bytes: [65.u8(), 65.u8()]}
    return h.bytes.as_sview()

def main() -> i64:
    w: sview = mk()
    x: sview = mk_direct()
    return w.len.i64() + x.len.i64()
