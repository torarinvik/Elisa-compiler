include "../../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../../elisacore_std/collections.elisa"
include "../../../../elisacore_std/elisacore_runtime_strings.elisa"

struct P:
    storage: mutable darray[u8]
    lines: mutable darray[u8]

def grow(p: lmut P) -> u8:
    p.storage <- p.storage.push(7.u8())
    view: sview = bytes_view_range(p.storage, 0, p.storage.count)
    p.lines <- p.lines.push(3.u8())
    p.lines <- p.lines.push(4.u8())
    return view[0]

def main() -> i64:
    p: mutable P = P{storage: [], lines: []}
    rebind first: u8, p = p.grow()
    return first.i64() + p.lines.count.i64()
