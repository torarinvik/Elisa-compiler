include "../../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../../elisacore_std/collections.elisa"
include "../../../../elisacore_std/elisacore_runtime_strings.elisa"

struct P:
    storage: mutable darray[u8]
    lines: mutable darray[i8]

def main() -> i64:
    shared: darray[u8] = [1.u8(), 2.u8()]
    p: mutable P = P{storage: shared, lines: shared}
    return p.lines.count.i64()
