include "../../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../../elisacore_std/collections.elisa"
include "../../../../elisacore_std/elisacore_runtime_strings.elisa"

protocol Named:
    def name(self: Self&) -> sview can[Unsafe{PointerArithmetic,RawExtern}]

struct Holder:
    buf: mutable darray[u8]

impl Named for Holder:
    def name(self: Self&) -> sview:
        return bytes_view_range(self.buf, 0, self.buf.count) can Unsafe{PointerArithmetic,RawExtern}

def main() -> i64:
    h: mutable Holder = Holder{buf: [65.u8()]}
    v: sview = h.name() can Unsafe{PointerArithmetic,RawExtern}
    first: u8 = v[0]
    h.buf.push(1.u8())
    return first.i64() - 65
