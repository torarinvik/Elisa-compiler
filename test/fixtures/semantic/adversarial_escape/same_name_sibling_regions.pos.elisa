# Sibling regions may reuse a name: only a region reopening the name of one still
# open around it is ambiguous.
def main() -> i64:
    total: mutable i64 = 0
    region scratch(4096):
        a: mutable darray[u8] = [1.u8()]
        total <- total + a[0].i64()
    region scratch(4096):
        b: mutable darray[u8] = [2.u8()]
        total <- total + b[0].i64()
    return total - 3
