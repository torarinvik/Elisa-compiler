def big() -> i64:
    return 4096

def keep(out: mutable darray[sview]&, s: sview) -> void:
    out.push(s)

def main() -> i64:
    vs: mutable darray[sview] = []
    buf: mutable darray[u8] = [65.u8()]
    s: sview = buf.as_sview()
    vs.extend([s])
    for i in 0..<big() |buf|:
        buf.push(1.u8())
    buf[0] <- 66.u8()
    return vs[0][0].i64()
