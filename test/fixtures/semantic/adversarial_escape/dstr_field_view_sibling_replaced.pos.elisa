def scribble() -> i64:
    total: mutable i64 = 0
    for k in 0..<8:
        region junk(4096):
            fill: mutable darray[u8] @junk = []
            for i in 0..<512:
                fill.push(90.u8())
            total <- total + fill[0].i64()
    return total

def mk(n: i64) -> darray[u8]:
    b: mutable darray[u8] = []
    for i in 0..<n:
        b.push(65.u8())
    return b

struct P:
    name: mutable dstr
    tag: mutable dstr

def main() -> i64:
    nm: dstr = "Abcdef"
    p: mutable P = P{name: nm, tag: nm}
    s: sview = p.name.as_sview()
    z: dstr = "Zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
    p.tag <- z
    _ = scribble()
    return s[0].i64() - 65
