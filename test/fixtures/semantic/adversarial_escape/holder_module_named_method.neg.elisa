module Shapes:
    public:
        struct Shapes:
            view: mutable sview
        def inspect(holder: mutable Shapes&, value: sview) -> void:
            holder.view <- value
        def assemble(holder: mutable Shapes&) -> void:
            can Memory.Allocate, Abort.Panic:
                bytes: mutable darray[u8] = [65.u8()]
                holder.inspect(bytes.as_sview())
def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        holder: mutable Shapes::Shapes = Shapes::Shapes{view: ""}
        Shapes::assemble(&holder)
        return 0
