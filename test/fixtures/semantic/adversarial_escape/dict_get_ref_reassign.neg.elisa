include "../../../../elisacore_std/elisacore_runtime.elisa"
def scribble() -> i64:
    total: mutable i64 = 0
    for k in 0..<8:
        region junk(4096):
            fill: mutable darray[u8] @junk = []
            for i in 0..<512:
                fill.push(90.u8())
            total <- total + fill[0].i64()
    return total

def mk(n: i64) -> darray[u8]:
    b: mutable darray[u8] = []
    for i in 0..<n:
        b.push(65.u8())
    return b

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    m: mutable dict[i64, i64] = {}
    m <- m.put(1, 7)
    r: i64&? = m.get(1)
    m <- {}
    for i in 2..<3000 |m|:
        m <- m.put(i, 99)
    _ = scribble()
    if r is v:
        return v - 7
    return 1
