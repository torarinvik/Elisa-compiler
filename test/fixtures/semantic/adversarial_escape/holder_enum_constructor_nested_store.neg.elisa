struct Holder:
    view: mutable sview
enum Pair:
    Data(mutable Holder&, sview)
def save(holder: mutable Holder&, value: sview) -> sview:
    holder.view <- value
    return value
def assemble(holder: mutable Holder&) -> void:
    can Memory.Allocate, Abort.Panic:
        bytes: mutable darray[u8] = [65.u8()]
        value: Pair = Pair.Data(holder, save(holder, bytes.as_sview()))
def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        holder: mutable Holder = Holder{view: ""}
        assemble(&holder)
        return 0
