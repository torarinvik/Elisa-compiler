struct Holder:
    view: sview
enum Pair:
    Data(mutable Holder&, sview)
def assemble(holder: mutable Holder&) -> void:
    can Memory.Allocate, Abort.Panic:
        bytes: mutable darray[u8] = [65.u8()]
        value: Pair = Pair.Data(holder, bytes.as_sview())
def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        holder: mutable Holder = Holder{view: ""}
        assemble(&holder)
        return 0
