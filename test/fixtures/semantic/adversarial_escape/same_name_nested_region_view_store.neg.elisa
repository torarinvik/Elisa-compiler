# A value of the INNER same-named region stored into an outer local dangles.
def main() -> i64:
    region scratch(4096):
        outer_buf: mutable darray[u8] = [65.u8()]
        outer_view: sview = outer_buf.as_sview()
        kept: mutable sview = outer_view
        region scratch(4096):
            inner: mutable darray[u8] = [66.u8()]
            _ = inner
            kept <- inner.as_sview()
        return kept[0].i64() - 65
