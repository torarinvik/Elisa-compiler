include "../../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../../elisacore_std/collections.elisa"
include "../../../../elisacore_std/elisacore_runtime_strings.elisa"

def scribble() -> i64:
    total: mutable i64 = 0
    for k in 0..<8:
        region junk(4096):
            fill: mutable darray[u8] @junk = []
            for i in 0..<512:
                fill.push(90.u8())
            total <- total + fill[0].i64()
    return total

def mk(n: i64) -> darray[u8]:
    b: mutable darray[u8] = []
    for i in 0..<n:
        b.push(65.u8())
    return b

enum Tok:
    Word(text: sview)
    Nil

def wrap(b: darray[u8]&) -> Tok:
    return Tok.Word(b.as_sview())

def main() -> i64:
    buf: mutable darray[u8] = mk(4)
    t: Tok = wrap(buf)
    buf <- mk(1)
    _ = scribble()
    return match t:
        Tok.Word(text): text[0].i64() - 65
        Tok.Nil: 1
