struct ViewHolder:
    view: sview
def fill(out: mutable darray[usize]&) -> void:
    can Memory.Allocate, Abort.Panic:
        bytes: mutable darray[u8] = [65.u8()]
        views: darray[sview] = [bytes.as_sview()]
        out.push(views.count)
def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[usize] = []
        fill(&out)
        return out[0].i64()
