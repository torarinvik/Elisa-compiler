# The backing region must outlive a stored view, including one carried by an enum payload.
enum Slot:
    Empty
    Text(view: sview)
struct Packet:
    value: i64
    slot: Slot
def fill(out: mutable darray[Packet]&) -> void:
    can Memory.Allocate, Abort.Panic:
        bytes: mutable darray[u8] = [65.u8()]
        packet: Packet = Packet{value: 7, slot: Slot.Text(bytes.as_sview())}
        out.push(packet)
def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[Packet] = []
        fill(&out)
        return out.count.i64()
