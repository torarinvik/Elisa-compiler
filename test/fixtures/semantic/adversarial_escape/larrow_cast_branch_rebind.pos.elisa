def fill(out: mutable darray[u8]&) -> cstr:
    can Unsafe.PointerCast:
        for i in 0..<300 |out|:
            out.push(66.u8())
        out.push(0.u8())
        return (&out[0]).cast[cstr] can Unsafe.PointerCast

def pick(flag: bool) -> i64:
    can Unsafe.PointerCast:
        storage: mutable darray[u8] = []
        storage.push(65.u8())
        storage.push(0.u8())
        name: mutable cstr = ""
        if flag:
            name <- (&storage[0]).cast[cstr] can Unsafe.PointerCast
        else:
            name <- fill(storage)
        return name[0].i64()

def main() -> i64:
    return pick(true) + pick(false)
