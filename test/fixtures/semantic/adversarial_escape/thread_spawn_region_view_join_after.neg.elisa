include "../../../../elisacore_std/elisacore_runtime_concurrency.elisa"
include "../../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../../elisacore_std/collections.elisa"
include "../../../../elisacore_std/elisacore_runtime_strings.elisa"
# spawn with a region view, joined after the region closes
def worker(v: sview) -> i64:
    return v[0].i64() - 65

def main() -> i64:
    can Thread.Spawn, Thread.Join, Memory.Allocate, Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange:
        t: mutable Thread[i64, Joinable]? = null
        region r(4096):
            b: mutable darray[u8] @r = [65.u8()]
            t <- spawn1(worker, b.as_sview())
        _ = scribble()
        if t is th:
            return join(move th)
        return 0
def scribble() -> i64:
    total: mutable i64 = 0
    for k in 0..<8:
        region junk(4096):
            fill: mutable darray[u8] @junk = []
            for i in 0..<512:
                fill.push(90.u8())
            total <- total + fill[0].i64()
    return total
