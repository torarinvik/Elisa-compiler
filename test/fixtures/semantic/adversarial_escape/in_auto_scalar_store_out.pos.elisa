# in auto: scalar copies and literal strings may leave the block
def main() -> i64:
    kept: mutable i64 = 0
    label: mutable sview = ""
    in auto:
        d: mutable darray[u8] = []
        d.push(66.u8())
        kept <- d[0].i64()
        label <- "x"
    return kept - 66 + label[0].i64() - 120
