include "../../../../elisacore_std/elisacore_runtime_concurrency.elisa"
include "../../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../../elisacore_std/collections.elisa"
include "../../../../elisacore_std/elisacore_runtime_strings.elisa"
# nursery inside region submits a region view (joined before region ends: safe)
def first(s: sview) -> i64:
    return s[0].i64() - 65

def main() -> i64:
    can Parallel, Memory.Allocate, Abort.Panic:
        region r(4096):
            b: mutable darray[u8] @r = [65.u8()]
            v: sview = b.as_sview()
            nursery workers(2):
                submit first(v)
        return 0
def scribble() -> i64:
    total: mutable i64 = 0
    for k in 0..<8:
        region junk(4096):
            fill: mutable darray[u8] @junk = []
            for i in 0..<512:
                fill.push(90.u8())
            total <- total + fill[0].i64()
    return total
