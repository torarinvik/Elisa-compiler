include "../../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../../elisacore_std/collections.elisa"
include "../../../../elisacore_std/elisacore_runtime_strings.elisa"

module N:
    public:
        struct Note:
            w: i32

module M:
    public:
        struct Q:
            store: mutable darray[u8]
            notes: mutable darray[N::Note]

        def tag[@r](parser: mutable Q& @r) -> sview:
            start: usize = parser.store.count
            parser.store.push(65.u8())
            return bytes_view_range(parser.store, start, 1)

        def drive(parser: mutable Q&) -> i32:
            name: sview = parser.tag()
            parser.notes <- parser.notes.push(N::Note{w: 1})
            return sview_len(name).i32()

def main() -> i32:
    q: mutable M::Q = M::Q{store: [], notes: []}
    return M::drive(&q)
