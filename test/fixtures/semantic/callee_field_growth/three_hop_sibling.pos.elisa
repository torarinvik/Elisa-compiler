include "../../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../../elisacore_std/collections.elisa"
include "../../../../elisacore_std/elisacore_runtime_strings.elisa"

struct P:
    source: mutable darray[u8]
    names: mutable darray[i64]

def grow_leaf(p: mutable P&) -> void:
    p.source.push(67.u8())

def grow_middle(p: mutable P&) -> void:
    grow_leaf(p)

def grow_top(p: mutable P&) -> void:
    grow_middle(p)

def main() -> i32:
    p: mutable P = P{source: [65.u8(), 66.u8()], names: [7]}
    v: view[i64] = darray_view(p.names)
    grow_top(p)
    return i32(v[0])
