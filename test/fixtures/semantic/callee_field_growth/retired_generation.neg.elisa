include "../../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../../elisacore_std/collections.elisa"
include "../../../../elisacore_std/elisacore_runtime_strings.elisa"

struct Note:
    w: sview
struct Q:
    tokens: darray[u8]
    store: mutable darray[u8]
    retired: mutable darray[darray[u8]]
    notes: mutable darray[Note]

def append_text(storage: mutable darray[u8]&, text: sview) -> void:
    for index in 0..<sview_len(text) |storage, text|:
        storage.push(sview_at(text, index))

def make_room[@r](parser: mutable Q& @r, needed: usize) -> void:
    chunk: usize = parser.tokens.count * 64 + 4096
    size: usize = needed if needed > chunk else chunk
    return if parser.store.count + needed <= parser.store.capacity
    parser.retired.push(parser.store) if parser.store.count > 0
    parser.store <- []
    parser.store.reserve(size)

def gen[@r](parser: mutable Q& @r, prefix: sview) -> sview:
    make_room(parser, sview_len(prefix))
    start: usize = parser.store.count
    append_text(parser.store, prefix)
    return bytes_view_range(parser.store, start, parser.store.count - start)

def drive(parser: mutable Q&) -> i32:
    v: sview = parser.gen("aa")
    b: sview = parser.gen("bb")
    n: usize = sview_len(v)
    return 0 if n == 0 else 1
def main() -> i32:
    q: mutable Q = Q{tokens: [], store: [], retired: [], notes: []}
    return drive(&q)
