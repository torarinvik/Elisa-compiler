include "../../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../../elisacore_std/collections.elisa"
include "../../../../elisacore_std/elisacore_runtime_strings.elisa"

struct P:
    source: mutable darray[u8]
    names: mutable darray[i64]

def note(p: mutable P&) -> void:
    p.source.clear()

def main() -> i32:
    p: mutable P = P{source: [65.u8(), 66.u8()], names: []}
    v: sview = bytes_view_range(p.source, 0, 2)
    note(p)
    return i32(v[1])
