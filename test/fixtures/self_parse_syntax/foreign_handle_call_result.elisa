extern ForeignHandle
# The native provider owns the handle and copies the name. Hidden native
# retention is an FFI contract obligation, not an Elisa view carried by this type.
@trusted("The provider copies name into foreign-owned storage")
extern make_foreign_handle(name: cstr) -> ForeignHandle

struct ForeignHandleViewHolder:
    text: sview

def collect_foreign_handles(out: mutable darray[ForeignHandle]&, name: cstr) -> void can[Memory.Allocate, Abort.Panic, Unsafe.RawExtern]:
    can Memory.Allocate, Abort.Panic, Unsafe.RawExtern:
        handle: ForeignHandle = make_foreign_handle(name)
        out.push(handle)
