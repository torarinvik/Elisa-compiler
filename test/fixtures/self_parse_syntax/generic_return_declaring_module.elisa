module Declared:
    public:
        struct Result:
            value: i64
            extra: i64
            third: i64

        def make[T](input: T) -> Result:
            return Result{value: 99, extra: 7, third: 5}

        def read[T](input: Result, tag: T) -> i64:
            return input.value + input.extra + input.third

module Caller:
    struct Result:
        value: i32

    public:
        def check() -> i32:
            result: Declared::Result = Declared::make[i32](1)
            return 1 if result.value != 99
            return 2 if result.extra != 7
            return 3 if result.third != 5
            return 4 if Declared::read[i32](result, 1) != 111
            return 0

def main() -> i32:
    return Caller::check()
