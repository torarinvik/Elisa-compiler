module Narrow:
    public:
        def identity[T](value: T) -> T:
            return value

module Wide:
    public:
        def identity[T](value: T) -> u64:
            return 9

module Pair:
    public:
        def first[A, B](left: A, right: B) -> A:
            return left

def main() -> i32:
    return 1 if Narrow::identity[i32](7) != 7
    return 2 if Wide::identity[i8](1) != 9
    return 3 if Pair::first[i16, u64](5, 99) != 5
    return 0
