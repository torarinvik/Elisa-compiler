const FIRST: u32 = 1
const SECOND: u32 = FIRST + 1

module Selectors:
    public:
        const THIRD: u32 = 3

def classify(value: u32) -> i32:
    return match value:
        FIRST: 10
        SECOND: 20
        _: 30

def classify_slot(value: u32) -> i32:
    result: i32 = match value:
        FIRST: 10
        SECOND: 20
        _: 30
    return result

def classify_statement(value: u32) -> i32:
    result: mutable i32 = 0
    match value:
        FIRST:
            result <- 10
        SECOND:
            result <- 20
        _:
            result <- 30
    return result

def classify_qualified(value: u32) -> i32:
    return match value:
        Selectors::THIRD: 40
        _: 50

def main() -> i32:
    return 1 if classify(1) != 10 or classify(2) != 20 or classify(3) != 30
    return 2 if classify_slot(1) != 10 or classify_slot(2) != 20 or classify_slot(3) != 30
    return 3 if classify_statement(1) != 10 or classify_statement(2) != 20 or classify_statement(3) != 30
    return 4 if classify_qualified(3) != 40 or classify_qualified(2) != 50
    return 0
