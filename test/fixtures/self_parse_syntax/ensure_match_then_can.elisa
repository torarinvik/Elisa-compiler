# A `can` block after an `ensure match` opens a new statement after the DEDENT.
enum E:
    A(v: i64)
    B
def f(e: E) -> i64:
    ensure match e:
        E.A(v): result == v
        E.B: result == 0
    can Abort.Panic:
        match e:
            E.A(v):
                return v
            E.B:
                return 0
def main() -> i32:
    return f(E.A(3)).i32()
