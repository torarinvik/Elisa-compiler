const FIRST: u32 = 1
const SECOND: u32 = 2

module Selectors:
    public:
        const THIRD: u32 = 3

def classify(value: u32) -> i32:
    return match value:
        FIRST or SECOND: 10
        _: 30

def classify_slot(value: u32) -> i32:
    result: i32 = match value:
        FIRST or Selectors::THIRD: 10
        _: 30
    return result

def classify_statement(value: u32) -> i32:
    result: mutable i32 = 0
    match value:
        FIRST or SECOND:
            result <- 10
        _:
            result <- 30
    return result

def main() -> i32:
    return 1 if classify(1) != 10 or classify(2) != 10 or classify(3) != 30
    return 2 if classify_slot(1) != 10 or classify_slot(3) != 10 or classify_slot(2) != 30
    return 3 if classify_statement(1) != 10 or classify_statement(2) != 10 or classify_statement(3) != 30
    return 0
