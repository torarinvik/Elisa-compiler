struct DepthHolder:
    text: sview
    number: mutable i64

def depth_identity(value: i64) -> i64:
    return value

def depth_store_number(holder: mutable DepthHolder&, value: i64) -> void:
    holder.number <- value

def depth_fill(holder: mutable DepthHolder&) -> void:
    depth_store_number(holder, depth_identity(depth_identity(depth_identity(depth_identity(depth_identity(depth_identity(depth_identity(depth_identity(depth_identity(depth_identity(depth_identity(depth_identity(1)))))))))))))
