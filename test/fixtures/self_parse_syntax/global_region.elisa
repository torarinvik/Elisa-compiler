# `global region NAME` declares a region that `@NAME` suffixes on fields, payloads and locals name.
global region source
struct Item:
    name: sview @source = ""
    count: i64 = 0
enum Tok:
    Word(text: sview @source, n: i64)
    End
def keep(text: sview @source) -> Item:
    return Item{name: text, count: 1}
def size(t: Tok) -> i64:
    match t:
        Tok.Word(text, n):
            return text.len + n
        Tok.End:
            return 0
def main() -> i32:
    item: Item = keep("hello")
    label: sview @source = "ab"
    return (item.name.len + item.count + size(Tok.Word(label, 4))).i32()
