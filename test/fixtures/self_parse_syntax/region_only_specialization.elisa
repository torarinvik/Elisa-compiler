global region source

def count_values[@r](values: darray[i64]& @r) -> usize:
    return values.count

module Counters:
    public:
        def count_values[@r](values: darray[i64]& @r) -> usize:
            return values.count

def forwarded_count[@r](values: darray[i64]& @r) -> usize:
    return Counters::count_values[r](values)

def main() -> i32:
    values: mutable darray[i64] @source = [1, 2, 3]
    return 1 if count_values[source](&values) != 3
    return 2 if Counters::count_values[source](&values) != 3
    return 3 if forwarded_count[source](&values) != 3
    return 0
