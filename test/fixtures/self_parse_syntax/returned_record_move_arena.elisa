global region source
struct Entry:
    name: sview @source
    line: u32
struct Report:
    entries: mutable darray[Entry] = []
def Report() -> Report:
    return Report{entries: []}
def fill(report: lmut Report) -> void:
    can Memory.Allocate, Abort.Panic:
        report.entries <- report.entries.push(Entry{name: "live", line: 17})
def produce() -> Report:
    can Memory.Allocate, Abort.Panic:
        report: mutable Report = Report()
        report <- fill(report)
        return move report
def wrapper() -> Report:
    return produce()
def main() -> i32:
    can Memory.Allocate, Abort.Panic:
        report: Report = wrapper()
        junk: mutable darray[u8] = [0 for _ in 0..<8192]
        return 1 if report.entries.count != 1
        return 2 if report.entries[0].line != 17
        return 3 if report.entries[0].name != "live"
        return 4 if junk.count != 8192
        return 0
