def classify_unsigned(value: u32, target: u8) -> i32:
    return match value:
        ^target: 10
        _: 20

def classify_signed(value: i32, target: i8) -> i32:
    result: i32 = match value:
        ^target: 10
        _: 20
    return result

def classify_wide(value: u8, target: u32) -> i32:
    result: mutable i32 = 0
    match value:
        ^target:
            result <- 10
        _:
            result <- 20
    return result

def classify_or(value: i32, first: i8, second: i8) -> i32:
    return match value:
        ^first or ^second: 10
        _: 20

def main() -> i32:
    return 1 if classify_unsigned(255, 255) != 10 or classify_unsigned(256, 0) != 20
    return 2 if classify_signed(-1, -1) != 10 or classify_signed(255, -1) != 20
    # Stage0 converts the pin to the scrutinee's width, including truncation.
    return 3 if classify_wide(7, 263) != 10 or classify_wide(8, 263) != 20
    return 4 if classify_or(-2, -1, -2) != 10 or classify_or(255, -1, -2) != 20
    return 0
