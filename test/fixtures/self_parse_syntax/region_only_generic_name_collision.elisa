global region source

def count_values[@r](values: darray[i64]& @r) -> usize:
    return values.count

module Generic:
    public:
        def count_values[T](value: T) -> T:
            return value

module Concrete:
    public:
        def count_values[@r](values: darray[i64]& @r) -> usize:
            return values.count + 1

        def forwarded[@r](values: darray[i64]& @r) -> usize:
            return count_values[r](values)

def main() -> i32:
    values: mutable darray[i64] @source = [1, 2, 3]
    return 1 if count_values[source](&values) != 3
    return 2 if Concrete::count_values[source](&values) != 4
    return 3 if Concrete::forwarded[source](&values) != 4
    generic_value: i32 = Generic::count_values[i32](7)
    return 4 if generic_value != 7
    return 0
