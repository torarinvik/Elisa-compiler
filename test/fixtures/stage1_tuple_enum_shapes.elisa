const enum Result of u8:
    First
    Second

def flat_enum() -> (ok: bool, op: Result):
    return (true, Result.First)

def nested_scalar_enum() -> (ok: bool, place: (kind: i64, base: i64, field: i64), op: i64):
    return (true, (1, 2, 3), 4)

def nested_enum_outer() -> (ok: bool, place: (kind: i64, base: i64, field: i64), op: Result):
    return (true, (1, 2, 3), Result.First)

def nested_enum_inner() -> (ok: bool, place: (kind: i64, op: Result), value: i64):
    return (true, (1, Result.First), 3)
