# value-threading pair: the value form and the `&` form must compile to identical machine code.
@inline(never)
def seed() -> i64:
    return 4

@inline(never)
def push_one(arr: mutable darray[i64]&, x: i64) -> void:
    arr.push(x)
    return

def main() -> i64:
    arr: mutable darray[i64] = []
    for i in 0..<seed() |arr|:
        push_one(&arr, i)
    return 0 if arr.count == 4 else 1
