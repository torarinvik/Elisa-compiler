# value-threading pair: the value form and the `&` form must compile to identical machine code.
@inline(never)
def push_one(arr: darray[i64], x: i64) -> darray[i64]:
    arr.push(x)
    return arr

def main() -> i64:
    arr: mutable darray[i64] = []
    arr <- push_one(arr, 4)
    arr <- arr.push_one(5)
    return 0 if arr.count == 2 else 1
