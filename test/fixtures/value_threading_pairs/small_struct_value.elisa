# value-threading pair: the value form and the `&` form must compile to identical machine code.
struct Pair:
    a: mutable i64
    b: mutable i64

@inline(never)
def bump(p: Pair, k: i64) -> Pair:
    p.a <- p.a + k
    p.b <- p.b + k
    return p

def main() -> i64:
    s: mutable Pair = Pair{a: 1, b: 2}
    s <- bump(s, 3)
    return 0 if s.a == 4 and s.b == 5 else 1
