# value-threading pair: the value form and the `&` form must compile to identical machine code.
# Big is 72 bytes: passed and returned through memory, so the value form would copy it twice.
struct Big:
    a: mutable i64
    b: mutable i64
    c: mutable i64
    d: mutable i64
    e: mutable i64
    f: mutable i64
    g: mutable i64
    h: mutable i64
    i: mutable i64

@inline(never)
def bump(s: Big, k: i64) -> Big:
    s.a <- s.a + k
    s.i <- s.i + k
    return s

def main() -> i64:
    s: mutable Big = Big{a: 1, b: 0, c: 0, d: 0, e: 0, f: 0, g: 0, h: 0, i: 2}
    s <- bump(s, 3)
    s <- s.bump(1)
    return 0 if s.a == 5 and s.i == 6 else 1
