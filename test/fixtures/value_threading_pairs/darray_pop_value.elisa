# value-threading pair (builtin): the value form and the in-place form must compile to identical machine code.

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    xs: mutable darray[i64] = [1, 2, 3]
    last: mutable i64 = 0
    xs, last <- xs.pop()
    return 0 if last == 3 and xs.count == 2 else 1
