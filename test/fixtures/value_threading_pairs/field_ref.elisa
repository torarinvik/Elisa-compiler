# value-threading pair: the value form and the `&` form must compile to identical machine code.
struct State:
    items: mutable darray[i64]
    n: mutable i64

@inline(never)
def push_one(arr: mutable darray[i64]&, x: i64) -> void:
    arr.push(x)
    return

def main() -> i64:
    s: mutable State = State{items: [], n: 0}
    push_one(&s.items, 7)
    s.items.push_one(8)
    return 0 if s.items.count == 2 else 1
