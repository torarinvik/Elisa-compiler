# value-threading pair: the value form and the `&` form must compile to identical machine code.
@inline(never)
def pop_one(arr: mutable darray[i64]&) -> i64:
    v: i64 = arr.pop()
    return v

def main() -> i64:
    a: mutable darray[i64] = [1, 2, 3]
    last: mutable i64 = 0
    last <- pop_one(&a)
    return 0 if last == 3 and a.count == 2 else 1
