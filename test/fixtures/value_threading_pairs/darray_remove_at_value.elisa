# value-threading pair (builtin, stage1-only: needs the stage1 runtime include, which stage0 rejects): the value form and the in-place form must compile to identical machine code.
include "../../../elisacore_std/elisacore_runtime.elisa"

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    xs: mutable darray[i64] = [1, 2, 3]
    item: mutable i64 = 0
    xs, item <- xs.remove_at(1)
    return 0 if item == 2 and xs.count == 2 and xs[1] == 3 else 1
