# Repeatedly call a function with a local darray. Each call owns an auto arena,
# returns a scalar, and therefore must free its component chunks on return.

def consume(seed: u32) -> u32:
    values: mutable darray[u32] = []
    values.push(seed)
    values.push(seed + 1)
    values.push(seed + 2)
    return values.count.u32()

def guest_run() -> u32:
    total: mutable u32 = 0
    index: mutable u32 = 0
    while index < 4096:
        total <- total + consume(index)
        index <- index + 1
    return total

@link_name("example:arena-reuse/guest@0.1.0#run")
export fn run() -> u32 = guest_run
