# Exercise the counted-view helper supplied by the freestanding component
# runtime. The embedded NUL must remain inside the four-byte view.
extern unsafe_sview_bounded_bytes(data: u8&, count: usize) -> sview can[Unsafe.PointerCast]

def guest_start() -> u32:
    bytes: mutable u8[4] = [65, 0, 66, 67]
    expected_bytes: mutable u8[4] = [65, 0, 66, 67]
    view: mutable sview = ""
    expected: mutable sview = ""
    can Unsafe.PointerCast:
        view <- unsafe_sview_bounded_bytes(&bytes[0], 4)
        expected <- unsafe_sview_bounded_bytes(&expected_bytes[0], 4)
    return view.len.u32() if view == expected else 0

@link_name("example:bounded-sview/guest@0.1.0#start")
export fn start() -> u32 = guest_start
