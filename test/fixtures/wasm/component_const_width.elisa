# An integer const used at a WIDER type than it was declared with. `usize` is 32-bit on
# wasm32 and 64-bit natively, so materialising the constant at its OWN width and handing it
# to an i64 comparison produced `i32.const 1024` under `i64.gt_s` -- invalid wasm the
# component validator rejects ("type mismatch: expected i64, found i32"). Invisible on a
# native build and invisible in LLVM IR text, which prints the instruction's operand type
# either way, so only a componentized build catches it.
module Limits:
    public:
        const MAX_BYTES: usize = 1024

def over_qualified(length: i64) -> bool:
    return length > Limits::MAX_BYTES.i64()

def over_bare(length: i64) -> bool:
    can Abort.Panic:
        return length > Limits::MAX_BYTES.i64()

global mutable seen: mutable i64 = 0

def guest_start() -> void:
    can Global.Write:
        seen <- seen + 1 if over_qualified(2048)
        seen <- seen + 1 if not over_qualified(4)
        seen <- seen + 1 if over_bare(4096)

@link_name("example:component/guest@0.1.0#start")
export fn start() -> void = guest_start
