package example:host-surface@0.1.0;

interface host {
    record audio-buffer {
        sample-rate: u32,
        channels: u32,
        samples: list<f32>,
    }

    log: func(message: string);
    read: func(path: string) -> result<list<u8>, string>;
    lookup: func(key: string) -> result<option<list<u8>>, string>;
    put: func(key: string, value: list<u8>) -> result<_, string>;
    delete: func(key: string) -> result<bool, string>;
    list-values: func(prefix: string) -> result<list<string>, string>;
    text: func() -> result<string, string>;
    owns: func(product-id: string) -> bool;
    play: func(buffer: audio-buffer) -> result<_, string>;
}

interface guest {
    start: func();
}

world app {
    import host;
    export guest;
}
