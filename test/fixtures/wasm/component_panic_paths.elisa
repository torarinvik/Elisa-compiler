# Component panic and contract paths use the freestanding WebAssembly trap
# intrinsic. They must not add libc `printf`, backtrace, or `abort` imports.

def guard_condition(condition: bool) -> void can[Abort.Panic]:
    assert condition

def panic_now() -> void can[Abort.Panic]:
    panic("component panic")

@link_name("example:component/guest@0.1.0#start")
export fn start(condition: bool) -> void = guard_condition

@link_name("example:component/guest@0.1.0#panic-now")
export fn panic_now_export() -> void = panic_now
