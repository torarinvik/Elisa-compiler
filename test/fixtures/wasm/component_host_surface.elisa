# Generic compiler fixture for canonical WIT strings, lists, options, results,
# flattened records, and scalar returns. Product-specific SDK code belongs in
# its product repository; this fixture only protects the generic linker.
# Result-bearing guest imports use the canonical trailing indirect result-area
# pointer after their flattened value parameters.

@wasm_import_module("example:host-surface/host@0.1.0")
@link_name("log")
extern host_log(message: cstr, length: u32) -> void

@wasm_import_module("example:host-surface/host@0.1.0")
@link_name("read")
extern host_read(path: cstr, path_length: u32, result: mutable void&) -> void

@wasm_import_module("example:host-surface/host@0.1.0")
@link_name("lookup")
extern host_lookup(key: cstr, key_length: u32, result: mutable void&) -> void

@wasm_import_module("example:host-surface/host@0.1.0")
@link_name("put")
extern host_put(key: cstr, key_length: u32, value: cstr, value_length: u32, result: mutable void&) -> void

@wasm_import_module("example:host-surface/host@0.1.0")
@link_name("delete")
extern host_delete(key: cstr, key_length: u32, result: mutable void&) -> void

@wasm_import_module("example:host-surface/host@0.1.0")
@link_name("list-values")
extern host_list(prefix: cstr, prefix_length: u32, result: mutable void&) -> void

@wasm_import_module("example:host-surface/host@0.1.0")
@link_name("text")
extern host_text(result: mutable void&) -> void

@wasm_import_module("example:host-surface/host@0.1.0")
@link_name("owns")
extern host_owns(product_id: cstr, product_id_length: u32) -> bool

@wasm_import_module("example:host-surface/host@0.1.0")
@link_name("play")
extern host_play(sample_rate: u32, channels: u32, samples: cstr, sample_count: u32, result: mutable void&) -> void

# Returned WIT lists are guest-owned after canonical lowering. Keep this
# generic fixture honest about the local release path too: component-cabi-realloc
# is a guest export, not another host import.
@link_name("cabi_realloc")
extern component_realloc(old_pointer: u32, old_size: u32, alignment: u32, new_size: u32) -> u32

linear typestate HostBuffer:
    data: u32
    size: u32
    states: Live, Released
    transition release: Live -> Released

def release_host_buffer(buffer: mutable HostBuffer[Live]&) ensures buffer => Released:
    if buffer.data != 0:
        component_realloc(buffer.data, buffer.size, 1, 0)
    buffer.release()

def host_buffer_protocol_probe() -> void:
    buffer: mutable HostBuffer[Live] = HostBuffer.new(data: 0, size: 0)
    release_host_buffer(buffer)

def guest_start() -> void:
    read_result: mutable u8[64] = zeroed
    lookup_result: mutable u8[64] = zeroed
    put_result: mutable u8[64] = zeroed
    delete_result: mutable u8[64] = zeroed
    list_result: mutable u8[64] = zeroed
    text_result: mutable u8[64] = zeroed
    play_result: mutable u8[64] = zeroed
    host_log("surface", 7)
    trusted [Unsafe.PointerCast]:
        host_read("asset", 5, (&read_result[0]).cast[mutable void&])
        host_lookup("key", 3, (&lookup_result[0]).cast[mutable void&])
        host_put("key", 3, "value", 5, (&put_result[0]).cast[mutable void&])
        host_delete("key", 3, (&delete_result[0]).cast[mutable void&])
        host_list("", 0, (&list_result[0]).cast[mutable void&])
        host_text((&text_result[0]).cast[mutable void&])
    owned: bool = host_owns("demo", 4)
    trusted [Unsafe.PointerCast]:
        host_play(48000, 1, "", 0, (&play_result[0]).cast[mutable void&])
    if owned:
        pass

@link_name("example:host-surface/guest@0.1.0#start")
export fn start() -> void = guest_start
