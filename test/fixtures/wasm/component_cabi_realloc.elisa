# Generic compiler fixture for WIT canonical strings and result lowering. For
# guest imports, the canonical indirect result-area pointer is trailing.
# The ABI adapters are explicit pointer/length values; no JavaScript surface is
# involved. The compiler-owned component runtime supplies cabi_realloc.

@wasm_import_module("example:component/host@0.1.0")
@link_name("log")
extern host_log(message: cstr, length: u32) -> void

@wasm_import_module("example:component/host@0.1.0")
@link_name("notify")
extern host_notify(title: cstr, title_length: u32, result: mutable void&) -> void

error NotifyError:
    Rejected

def notify_checked() -> bool error[NotifyError]:
    result_wire: mutable u8[16] = zeroed
    host_notify("Elisa", 5, (&result_wire[0]).cast[mutable void&])
    return result_wire[0] == 0

def guest_start() -> void:
    host_log("component", 9)
    accepted: bool = try notify_checked() else false
    host_notify("Elisa", 5, "".cast[mutable void&])

@link_name("example:component/guest@0.1.0#start")
export fn start() -> void = guest_start
