# The INDEX BOUNDS GUARD's operands, at wasm32's pointer width.
#
# The guard is unconditional at every optimization level, so a runtime index into a
# fixed-size array always emits `icmp ult <index>, <extent>`. The extent used to be
# materialised as a hardcoded i64 while the index is `usize` -- 64-bit natively but
# 32-BIT ON WASM32 -- so the comparison came out as `i32.lt_u` fed an `i64.const`.
# Invalid wasm the component validator rejects, invisible on a native build where both
# operands are already 64 bits, and invisible in LLVM IR text, which prints one operand
# type for an icmp either way. It cost a whole .wapp target, which failed with
# `Compiling function #207:"UiTasks.is_valid" failed: i32.lt_u[1] expected type i32,
# found i64.const of type i64`.
#
# The sibling fixture component_const_width.elisa catches the other direction.
#
# Building IS the assertion: wasm-component-ld validates, so a width regression here
# fails the link. Confirmed against a compiler with the fix reverted -- this file does
# fail there, and builds clean with the fix.
module Limits:
    public:
        const MAX_TASKS: u32 = 128
        global mutable task_active: bool[MAX_TASKS] = zeroed
        def is_valid(slot: u32) -> bool:
            return task_active[slot.usize()]

global mutable seen: mutable i64 = 0

def guest_start() -> void:
    can Global.Write, Global.Read:
        seen <- seen + 1 if Limits::is_valid(4)

@link_name("example:component/guest@0.1.0#start")
export fn start() -> void = guest_start
