# A scalar enum constraint inside packed AST patterns must test its value.
include "../../../src/parser/parser_tokens.elisa"
using Ast

def matches_operator(expression: Expr) -> bool:
    return match expression:
        Expr.Binary(Expr.Ident(_, _), TokenKind.GtEq, Expr.Ident(_, _), _):
            true
        _:
            false

def main() -> i64:
    region r(4096):
        store: Node.Store[Local] = Node.Store(r)
        in store:
            position: Pos = Ast::pos_at_line(1)
            lhs: Expr = new[store] Expr.Ident("index", position)
            rhs: Expr = new[store] Expr.Ident("count", position)
            matching: Expr = new[store] Expr.Binary(lhs, TokenKind.GtEq, rhs, position)
            different: Expr = new[store] Expr.Binary(lhs, TokenKind.Lt, rhs, position)
            return 0 if matches_operator(matching) and not matches_operator(different)
            return 1
