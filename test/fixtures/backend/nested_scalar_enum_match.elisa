# A scalar enum constraint inside packed AST patterns must test its value.
include "../../../src/parser/static_if_branch.elisa"
include "../../../src/parser/parser_tokens.elisa"
include "../../../src/parser/parser_token_position.elisa"
using Ast

def matches_operator(expression: Expr) -> bool:
    return match expression:
        Expr.Binary(Expr.Ident(_, _), TokenKind.GtEq, Expr.Ident(_, _), _):
            true
        _:
            false

def matches_statement(statement: Stmt) -> bool:
    match statement:
        Stmt.If(Expr.Binary(Expr.Ident(_, _), TokenKind.GtEq, Expr.Ident(_, _), _), _, _, _):
            return true
        _:
            return false

def main() -> i64:
    position: Pos = Ast::pos_at_line(1)
    lhs: Expr = Expr.Ident("index", position)
    rhs: Expr = Expr.Ident("count", position)
    matching: Expr = Expr.Binary(lhs, TokenKind.GtEq, rhs, position)
    different: Expr = Expr.Binary(lhs, TokenKind.Lt, rhs, position)
    no_body: darray[Stmt] @source = []
    matching_statement: Stmt = Stmt.If(matching, no_body, no_body, position)
    different_statement: Stmt = Stmt.If(different, no_body, no_body, position)
    return 0 if matches_operator(matching) and not matches_operator(different) and matches_statement(matching_statement) and not matches_statement(different_statement)
    return 1
