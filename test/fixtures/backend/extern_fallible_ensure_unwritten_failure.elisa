error ProbeError:
    Failed

@callconv(c)
extern ensure_result(bad: bool) -> i64 error[ProbeError] ensure result == 42

@callconv(c)
extern ensure_failure(ignored: bool) -> i64 error[ProbeError] ensure result == 42

def main() -> i64:
    result: i64 error[ProbeError] = ensure_failure(true)
    return catch result:
        value: value
        ProbeError.Failed: 7
