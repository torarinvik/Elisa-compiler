# Tail values share the explicit-return path, including nested branches and match.
def scalar() -> i64:
    41 + 1

def choose(x: i64) -> i64:
    if x < 0:
        return 7
    else:
        if x == 0:
            11
        else:
            local: i64 = x + 1
            local

def matched(x: i64) -> i64:
    match x:
        0:
            13
        _:
            17

def discarded(counter: mutable i64&) -> void:
    counter[0] <- counter[0] + 1
    scalar()

def fallthrough(x: i64) -> i64:
    if x == 0:
        scalar()
    19

def main() -> i32:
    if scalar() != 42 or choose(-1) != 7 or choose(0) != 11 or choose(2) != 3:
        return 1
    if matched(0) != 13 or matched(1) != 17 or fallthrough(0) != 19:
        return 2
    counter: mutable i64 = 0
    discarded(&counter)
    if counter != 1:
        return 3
    0
