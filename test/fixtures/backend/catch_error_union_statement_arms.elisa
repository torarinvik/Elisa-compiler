error Problem:
    First
    Second

def maybe(flag: bool) -> i64 error[Problem]:
    raise Problem.Second if flag
    return 42

def inspect(flag: bool) -> i64:
    value: i64 = 100
    failure: i64 = 5
    source: i64 error[Problem] = maybe(flag)
    result: i64 = catch source:
        value:
            incremented: i64 = value + 1
            incremented
        error failure:
            recovered: i64 = value + (10 if failure == Problem.Second else 20)
            recovered
    return result + value + failure

def main() -> i32:
    return 1 if inspect(false) != 148
    return 2 if inspect(true) != 215
    return 0
