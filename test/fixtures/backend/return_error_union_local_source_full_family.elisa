global mutable trace: i64 = 0

error Fault:
    Available(enabled: bool, count: i64)
    Busy(code: i64)

def produce(fail: bool) -> i64 error[Fault]:
    raise Fault.Busy(9) if fail
    return 42

def forward_local(fail: bool) -> i64 error[Fault] can[Global{Read,Write}]:
    can Global{Read,Write}:
        source: i64 error[Fault] = produce(fail)
        defer block:
            trace <- trace + 1
        return source

def inspect_local(fail: bool) -> i64 can[Global{Read,Write}]:
    can Global{Read,Write}:
        forwarded: i64 error[Fault] = forward_local(fail)
        return catch forwarded:
            value:
                value
            Fault.Available(enabled, count):
                -1
            Fault.Busy(code):
                code

def main() -> i32 can[Global{Read,Write}]:
    can Global{Read,Write}:
        trace <- 0
        return 1 if inspect_local(false) != 42
        return 2 if trace != 1
        trace <- 0
        return 3 if inspect_local(true) != 9
        return 4 if trace != 1
        return 0
