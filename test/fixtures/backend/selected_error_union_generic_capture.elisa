error Failure:
    Bad

def produce[T](value: T, fail: bool) -> T error[Failure]:
    raise Failure.Bad if fail
    return value

def inspect(fail: bool) -> i64:
    source: i64 error[Failure] = produce(42, fail)
    return catch source:
        value: value
        Failure.Bad: 7

def main() -> i32:
    return 1 if inspect(false) != 42
    return 2 if inspect(true) != 7
    return 0
