# `Stmt.Return.value` is `Expr?`. Matching an Expr variant directly inside it
# must lower the optional presence test and payload extraction before the packed
# Node-store handle read.
include "../../../src/semantic/semantic.elisa"
using Ast

def inspect_return(statement: Stmt) -> i64:
    match statement:
        Stmt.Return(Expr.IntLit(value, _), _):
            return value
        _:
            return 0

def main() -> i64:
    region r(4096):
        store: Node.Store[Local] = Node.Store(r)
        in store:
            position: Pos = Ast::pos_at_line(1)
            literal: Expr = new[store] Expr.IntLit(17, position)
            value: Expr? = literal
            statement: Stmt = new[store] Stmt.Return(value, position)
            return 0 if inspect_return(statement) == 17
            return 1
