# Matching a packed enum variant nested inside an optional enum payload must
# test the optional tag and extract the payload before reading the packed store.
include "../../../src/parser/parser_tokens.elisa"
using Ast

def inspect_return(statement: Stmt) -> i64:
    match statement:
        Stmt.Return(Expr.IntLit(value, _), _):
            return value
        _:
            return 0

def main() -> i64:
    region r(4096):
        store: Node.Store[Local] = Node.Store(r)
        in store:
            position: Pos = Ast::pos_at_line(1)
            literal: Expr = new[store] Expr.IntLit(17, position)
            value: Expr? = literal
            statement: Stmt = new[store] Stmt.Return(value, position)
            missing: Expr? = null
            missing_statement: Stmt = new[store] Stmt.Return(missing, position)
            return 0 if inspect_return(statement) == 17 and inspect_return(missing_statement) == 0
            return 1
