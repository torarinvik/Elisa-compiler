# Compile-only coverage for the ABI-stride × pushes-per-trip byte cap.
def fill_one_i64_under_cap() -> i64:
    one: mutable darray[i64] = []
    for i in 0..<4000000:
        one.push(i)
    return one.count.i64()

def fill_two_i64_over_cap() -> i64:
    two: mutable darray[i64] = []
    for i in 0..<4194305:
        two.push(i)
        two.push(i + 1)
    return two.count.i64()

def fill_two_i64_dynamic(bound: i64) -> i64:
    dynamic: mutable darray[i64] = []
    for i in 0..<bound:
        dynamic.push(i)
        dynamic.push(i + 1)
    return dynamic.count.i64()

def main() -> i64:
    return fill_one_i64_under_cap() + fill_two_i64_over_cap() + fill_two_i64_dynamic(1)
