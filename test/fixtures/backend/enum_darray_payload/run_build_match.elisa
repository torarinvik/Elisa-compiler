enum Ex:
    Leaf(name: sview, kids: darray[i64])
    Text(tag: i64, body: dstr)
    Empty

def total(e: Ex) -> i64:
    return match e:
        Ex.Leaf(name, kids): name.len.i64() * 1000 + kids.count.i64() * 100 + kids[kids.count - 1]
        Ex.Text(tag, body): tag * 10 + body.count.i64()
        Ex.Empty: 7

def build(n: i64) -> darray[Ex] can[Memory.Allocate, Abort.Panic]:
    out: mutable darray[Ex] = []
    for i in 0..<n |out|:
        ks: mutable darray[i64] = []
        for j in 0..<(i + 1) |ks|:
            ks.push(j * 3)
        out.push(Ex.Leaf("ab", ks))
        bs: mutable dstr = []
        bs.push(104)
        bs.push(105)
        out.push(Ex.Text(i, bs))
        out.push(Ex.Empty)
    return out

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    xs: darray[Ex] = build(40)
    s: mutable i64 = 0
    for x in xs |s|:
        s += total(x)
    e: Ex = xs[3]
    if e is Ex.Leaf(nm, kd):
        s += kd.count.i64()
    return (s % 251).i32()
