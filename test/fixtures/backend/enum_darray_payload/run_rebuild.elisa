enum Ex:
    Leaf(name: sview, kids: darray[i64])
    Empty

def grow(e: Ex) -> Ex can[Memory.Allocate, Abort.Panic]:
    if e is Ex.Leaf(nm, kd):
        more: mutable darray[i64] = []
        for k in kd |more|:
            more.push(k + 1)
        more.push(99)
        return Ex.Leaf(nm, more)
    return Ex.Empty

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    e: mutable Ex = Ex.Leaf("x", [1, 2, 3])
    for _ in 0..<50 |e|:
        e <- grow(e)
    return match e:
        Ex.Leaf(nm, kd): (kd.count.i64() + kd[0] + kd[kd.count - 1]).i32()
        Ex.Empty: 1
