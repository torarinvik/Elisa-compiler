extern Ctx
extern Ty
extern Val
extern PtrTy(ctx: Ctx, space: u32) -> Ty
extern ConstNull(ty: Ty) -> Val

struct Table:
    context: Ctx
    names: mutable darray[sview]
    values: mutable darray[i64]
    globals: mutable darray[Val]

def register(structs: mutable Table&) -> void can[Abort.Panic, Memory.Allocate]:
    names: darray[sview] = ["A", "B"]
    values: mutable darray[i64] = [1, 0]
    for index in 0..<2 |structs|:
        structs.globals <- structs.globals.push(ConstNull(PtrTy(structs.context, 0)))

def main() -> i32:
    return 0
