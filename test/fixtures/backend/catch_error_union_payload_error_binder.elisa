error Payload:
    Bad(code: i64)

def bad() -> i64 error[Payload]:
    raise Payload.Bad(9)

def inspect() -> i64:
    value: i64 = 100
    source: i64 error[Payload] = bad()
    result: i64 = catch source:
        value: value + 1
        error failure:
            return match failure:
                Payload.Bad(code):
                    code
    return result + value

def main() -> i32:
    return 1 if inspect() != 9
    return 0
