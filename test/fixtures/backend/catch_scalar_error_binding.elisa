error Problem:
    First
    Second

def fallible(flag: i32) -> i64 error[Problem]:
    raise Problem.First if flag == 1
    raise Problem.Second if flag == 2
    return 42

def relay(flag: i32) -> i64 error[Problem]:
    catch fallible(flag):
        value:
            return value
        error failure:
            raise failure

def statement_case(flag: i32) -> i32:
    catch relay(flag):
        value:
            return value.i32()
        error failure:
            return 10 if failure == Problem.First else 20

def expression_case(flag: i32) -> i32:
    failure: i32 = 100
    result: i32 = catch fallible(flag):
        value: value.i32()
        error failure: 10 if failure == Problem.First else 20
    return result + failure

def main() -> i32:
    return 1 if statement_case(0) != 42
    return 2 if statement_case(1) != 10
    return 3 if statement_case(2) != 20
    return 4 if expression_case(0) != 142
    return 5 if expression_case(1) != 110
    return 6 if expression_case(2) != 120
    return 0
