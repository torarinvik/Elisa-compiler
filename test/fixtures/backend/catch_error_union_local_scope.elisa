error Problem:
    First
    Second

def maybe(flag: i32) -> i64 error[Problem]:
    raise Problem.Second if flag == 1
    return 42

def scope_case(flag: i32) -> i64:
    value: i64 = 100
    source: i64 error[Problem] = maybe(flag)
    result: i64 = catch source:
        value: value + 1
        error failure: value + (10 if failure == Problem.Second else 20)
    return result + value

def main() -> i32:
    return 1 if scope_case(0) != 143
    return 2 if scope_case(1) != 210
    return 0
