error Problem:
    First
    Second

module FirstService:
    def check() -> void error[Problem]:
        raise Problem.First
    def local_case() -> i32:
        catch check():
            value:
                true
            error failure:
                return 0 if failure == Problem.First else 1
        return 2

module SecondService:
    def check() -> void error[Problem]:
        raise Problem.Second

def main() -> i32:
    return 1 if FirstService::local_case() != 0
    catch SecondService::check():
        value:
            true
        error failure:
            return 0 if failure == Problem.Second else 2
    return 3
