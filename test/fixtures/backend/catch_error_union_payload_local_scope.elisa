error Payload:
    Bad(code: i64)

def bad() -> i64 error[Payload]:
    raise Payload.Bad(9)

def main() -> i32:
    value: i64 = 100
    source: i64 error[Payload] = bad()
    result: i64 = catch source:
        value: value + 1
        Payload.Bad(code): value + code
    return 1 if result != 109
    return 2 if value != 100
    return 0
