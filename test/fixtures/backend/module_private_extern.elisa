# Module externs retain source scope while @link_name selects the C symbol.
# The repeated source spelling exercises owner-aware function lookup.
module Small:
    private:
        @link_name(abs)
        extern magnitude(value: i32) -> i32
    public:
        def apply(value: i32) -> i32:
            return magnitude(value)

module Large:
    private:
        @link_name(labs)
        extern magnitude(value: i64) -> i64
    public:
        def apply(value: i64) -> i64:
            return magnitude(value)

def main() -> i32:
    return 1 if Small::apply(-7) != 7
    return 2 if Large::apply(-9000000000) != 9000000000
    return 0
