include "../../../../elisacore_std/elisacore_runtime.elisa"

def look(m: dict[i64, i64]&, k: i64) -> i64:
    if m.get(k) is v:
        return v + 1
    return 0

def look_tern(m: dict[i64, i64]&, k: i64) -> i64:
    return v * 2 if m.get(k) is v else 5

def fill(m: mutable dict[i64, i64]&, n: i64) -> void can[Memory.Allocate, Abort.Panic]:
    for i in 0..<n |m|:
        m <- m.put(i, i * 3)

def has_key(m: dict[i64, i64]&, k: i64) -> bool:
    return m.contains(k)

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    m: mutable dict[i64, i64] = {}
    fill(m, 200)
    s: mutable i64 = 0
    for k in 0..<210 |s, m|:
        s += look(m, k) + look_tern(m, k)
        s += 1 if has_key(m, k)
    return (s % 251).i32()
