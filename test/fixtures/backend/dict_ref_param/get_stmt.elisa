include "../../../../elisacore_std/elisacore_runtime.elisa"

def look(m: dict[i64, i64]&, k: i64) -> i64:
    if m.get(k) is v:
        return v + 1
    return 0

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    m: mutable dict[i64, i64] = {}
    for i in 0..<200 |m|:
        m <- m.put(i, i * 3)
    s: mutable i64 = 0
    for k in 0..<210 |s, m|:
        s += look(m, k)
    return (s % 251).i32()
