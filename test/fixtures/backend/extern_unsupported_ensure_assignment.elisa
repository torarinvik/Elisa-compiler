error ProbeError:
    Failed

@callconv(c)
extern contract_probe(input: i64) -> i64 error[ProbeError] ensure result == old(input)

def reassign(value: mutable i64 error[ProbeError]) -> i64 error[ProbeError]:
    value <- contract_probe(42)
    return 0

def initial_value() -> i64 error[ProbeError]:
    return 42

def main() -> i64:
    initial: i64 error[ProbeError] = initial_value()
    return try reassign(initial) else 7
