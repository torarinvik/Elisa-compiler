# Value-threading call sites the checker rejects (test/parity/value_threading_smoke.sh pins
# the full text in expected.txt; fixed.elisa applies each suggested rewrite).
struct State:
    items: mutable darray[i64]
    n: mutable i64

global mutable registry: mutable darray[i64] = zeroed

def push_one(arr: darray[i64], x: i64) -> darray[i64]:
    arr.push(x)
    return arr

def dropped() -> usize:
    arr: mutable darray[i64] = []
    push_one(arr, 1)
    return arr.count

def through_borrow(s: State&) -> usize:
    grown: darray[i64] = push_one(s.items, 2)
    return grown.count

def field_moved() -> usize:
    s: mutable State = State{items: [], n: 0}
    grown: darray[i64] = push_one(s.items, 3)
    return grown.count + s.items.count

def global_moved() -> usize:
    grown: darray[i64] = push_one(registry, 4)
    return grown.count

def used_after_move() -> usize:
    arr: mutable darray[i64] = []
    grown: darray[i64] = push_one(arr, 5)
    return arr.count + grown.count

def claimed_into_other() -> i64:
    xs: mutable darray[i64] = [1, 2, 3]
    ys: mutable darray[i64] = []
    last: mutable i64 = 0
    ys, last <- xs.pop()
    return last + ys.count.i64()

def main() -> i64:
    return 0
