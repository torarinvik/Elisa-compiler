# illegal.elisa with each suggested rewrite applied verbatim (it builds and checks itself).
struct State:
    items: mutable darray[i64]
    n: mutable i64

global mutable registry: mutable darray[i64] = zeroed

def push_one(arr: darray[i64], x: i64) -> darray[i64]:
    arr.push(x)
    return arr

def dropped() -> usize:
    arr: mutable darray[i64] = []
    arr <- push_one(arr, 1)
    return arr.count

def through_owned(s: State) -> State:
    s.items <- push_one(s.items, 2)
    return s

def field_moved() -> usize:
    s: mutable State = State{items: [], n: 0}
    s.items <- push_one(s.items, 3)
    return s.items.count

def global_moved() -> usize:
    registry <- push_one(registry, 4)
    return registry.count

def used_after_move() -> usize:
    arr: mutable darray[i64] = []
    arr <- push_one(arr, 5)
    return arr.count

def claimed_into_other() -> i64:
    xs: mutable darray[i64] = [1, 2, 3]
    ys: mutable darray[i64] = []
    last: mutable i64 = 0
    xs, last <- xs.pop()
    return last + ys.count.i64() + xs.count.i64()

def main() -> i64:
    s: mutable State = State{items: [], n: 0}
    s <- through_owned(s)
    total: usize = dropped() + s.items.count + field_moved() + global_moved() + used_after_move()
    return 0 if total == 5 and claimed_into_other() == 5 else 1
