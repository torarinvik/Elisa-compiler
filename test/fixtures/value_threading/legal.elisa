# Value-threading forms the checker accepts; the program checks its own results (exit 0).
struct State:
    items: mutable darray[i64]
    n: mutable i64

def push_one(arr: darray[i64], x: i64) -> darray[i64]:
    arr.push(x)
    return arr

def pop_one(arr: darray[i64]) -> (rest: darray[i64], last: i64):
    last: i64 = arr.pop()
    return arr, last

def bump(s: State, k: i64) -> State:
    s.n <- s.n + k
    s.items <- push_one(s.items, k)
    return s

def fill(arr: darray[i64], n: i64) -> darray[i64]:
    for i in 0..<n |arr|:
        arr <- push_one(arr, i)
    return arr

def total(xs: darray[i64]&) -> i64:
    sum: mutable i64 = 0
    for x in xs:
        sum <- sum + x
    return sum

def fresh_copy(xs: darray[i64]) -> darray[i64]:
    return push_one(xs, 100)

def main() -> i64:
    arr: mutable darray[i64] = []
    arr <- push_one(arr, 1)
    arr <- arr.push_one(2)
    last: mutable i64 = 0
    arr, last <- pop_one(arr)
    arr <- fill(arr, 3)
    arr_total: i64 = total(arr)
    arr_count: usize = arr.count
    copy: darray[i64] = push_one(arr, 7)
    copy_count: usize = copy.count
    s: mutable State = State{items: [], n: 0}
    s <- bump(s, 5)
    s.items <- push_one(s.items, 6)
    tail_copy: darray[i64] = fresh_copy(copy)
    ok: bool = last == 2 and arr_total == 4 and arr_count == 4 and copy_count == 5 and s.n == 5 and total(s.items) == 11 and tail_copy.count == 6
    return 0 if ok else 1
