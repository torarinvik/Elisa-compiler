# early-exit pair: `continue if` inside a value block compiles like the statement form.
@inline(never)
def total(values: darray[i64]&) -> i64:
    sum: mutable i64 = 0
    for value in values:
        doubled: i64 =
            tmp: i64 = value * 2
            continue if tmp < 0
            tmp + 1
        sum += doubled
    return sum

def main() -> i64:
    values: darray[i64] = [3, -1, 4, -5, 6]
    return 0 if total(values) == 29 else 1
