# early-exit pair: `break if` inside a value block, in a loop expression.
@inline(never)
def prefix(values: darray[i64]&) -> i64:
    sum: i64 =
        for value in values |acc: i64 = 0| -> acc:
            scaled: i64 =
                tmp: i64 = value * 3
                break if tmp > 100
                tmp - 1
            acc += scaled
    return sum

def main() -> i64:
    values: darray[i64] = [1, 2, 50, 4]
    return 0 if prefix(values) == 7 else 1
