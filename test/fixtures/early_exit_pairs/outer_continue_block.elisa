# early-exit pair: `continue 'rows` from a value block in an inner loop moves to the next row.
@inline(never)
def rows_without_zero(grid: darray[i64]&, width: i64) -> i64:
    kept: mutable i64 = 0
    'rows: for row in 0..<3:
        for col in 0..<width:
            cell: i64 =
                value: i64 = grid[(row * width + col).usize()]
                continue 'rows if value == 0
                value
            kept += cell
    return kept

def main() -> i64:
    grid: darray[i64] = [1, 2, 3, 4, 0, 6, 7, 8, 9]
    return 0 if rows_without_zero(grid, 3) == 34 else 1
