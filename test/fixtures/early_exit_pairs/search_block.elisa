# early-exit pair: a labelled loop expression yields through `break 'rows`, like the mutable
# local and labelled statement loop it replaces.
@inline(never)
def find(grid: darray[i64]&, width: i64, want: i64) -> i64:
    found: i64 =
        'rows: for row in 0..<3 |hit: i64 = -1| -> hit:
            for col in 0..<width:
                if grid[(row * width + col).usize()] == want:
                    hit <- row * 100 + col
                    break 'rows
    return found

def main() -> i64:
    grid: darray[i64] = [1, 2, 3, 4, 5, 6, 7, 8, 9]
    return 0 if find(grid, 3, 6) == 102 and find(grid, 3, 42) == -1 else 1
