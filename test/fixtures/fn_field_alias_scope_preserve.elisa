struct CallbackBox:
	run: fn(i64, i64) -> i64

def chosen(x: i64, y: i64) -> i64:
	return x - y

def other(first: i64, second: i64) -> i64:
	return first - second

def main() -> i64:
	box: CallbackBox = CallbackBox{run: chosen}
	if true:
		noise: CallbackBox = CallbackBox{run: other}
	return box.run(y: 7, x: 30)
