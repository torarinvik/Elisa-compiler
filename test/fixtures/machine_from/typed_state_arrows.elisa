# Canonical `machine from` graph syntax: local states declare the payload contract,
# `->` constructs the strongly typed successor, and `=>` produces the expression value.
def choose(positive: bool) -> i64:
    state Start
    state Choice(value: i64)
    state Finish(result: i64)
    return start Start:
        Start:
            -> Choice(20) if positive
            -> Choice(21)
        Choice(value):
            adjusted: i64 = value + 1
            -> Finish(adjusted)
        Finish(result):
            => result

def main() -> i64:
    return choose(true) + choose(false)
