enum ChoiceState:
    Start
    Choice(i64)
    Finish(i64)

def choose(positive: bool) -> i64:
    return machine from ChoiceState.Start:
        ChoiceState.Start:
            -> ChoiceState.Choice(20) if positive
            -> ChoiceState.Choice(21)
        ChoiceState.Choice(value):
            adjusted: i64 = value + 1
            -> ChoiceState.Finish(adjusted)
        ChoiceState.Finish(result):
            => result

def main() -> i64:
    return choose(true) + choose(false)
