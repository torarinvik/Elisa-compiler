# An arm-LOCAL (not a payload binder) spelled like a successor state's payload field.
# `-> B(first, …)` must copy the local into the B.first slot; when the slot write sat in
# the local's scope it landed in the local and B saw a zeroed slot (lost enum field names).

def main() -> i64:
    position: mutable usize = 5
    machine over position while true:
        state A
        state B(first: usize, flag: bool)
        state C(first: usize, flag: bool, extra: i64)
        start A

        A, _ if position == 5:
            first: usize = position
            position <- position + 2
            -> B(first, true)

        A, _:
            -> B(99, false)

        B(first, flag), _:
            -> C(first, flag, 3)

        C(first, flag, extra), _:
            position <- first * 10 + extra.usize()
            break
    return position.i64()
