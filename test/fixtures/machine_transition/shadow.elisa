# A payload alias may shadow a field in the successor state. The alias must remain
# visible while the transition argument is evaluated, but not while the destination
# field is assigned.
def main() -> i64:
    ticks: mutable i64 = 0
    machine over ticks while ticks < 2:
        state Run(source: i64)
        state Check(value: i64)
        start Run(1)
        Run(value), _:
            ticks <- ticks + 1
            -> Check(value + 1)
        Check(value), _:
            return value
    return 0
