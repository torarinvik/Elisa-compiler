# docs/123 §5: ERROR HANDLING IS NOT BRANCHING. `catch`/`try`/`get` are EXPRESSIONS, so a
# machine arm may call a fallible function and handle its outcome. What §5 refuses is a
# branching STATEMENT (`if`/`match`/`while`/`for`, and a postfix guard, which desugars to
# an `if`) — all discrimination belongs in the arm header, `State, input if guard:`.
#
# Both spellings are pinned, because stage1 represents them differently:
#   1. `catch` as a VarDecl initialiser — an expression on both sides;
#   2. `catch` in STATEMENT position — an ExprStmt in stage0, but a `Stmt.Match` tagged
#      `__catch_match` in stage1. The arm law must ask the annotation, not the node kind,
#      or it rejects a program stage0 compiles.
#
# Layout note: stage0 misparses a `-> State` written IMMEDIATELY after a multi-line catch
# block as the removed `expr -> T` cast, so each arm puts a plain statement in between.
# Runs to 97: arm one loads 7, arm two takes the failure path and adds 90.

error LoadError:
    Failed

def load(fail: bool) -> i64 error[LoadError]:
    raise LoadError.Failed if fail
    7

def main() -> i64:
    total: mutable i64 = 0
    step: mutable i64 = 0
    machine over step while total < 97:
        state Run
        start Run

        Run, 0:
            value: i64 = catch load(false):
                loaded:
                    loaded
                LoadError.Failed:
                    0 - 1
            total <- total + value
            step <- 1
            -> Run
        Run, _:
            catch load(true):
                loaded:
                    total <- total + loaded
                    true
                error failure:
                    total <- total + 90
                    true
            step <- 2
            break
    return total
