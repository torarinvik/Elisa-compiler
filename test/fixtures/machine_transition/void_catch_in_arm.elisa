# A statement-position catch inside a machine arm is control flow. Its handlers may
# update state without producing values before the enclosing arm transitions.
error LoadError:
    Failed

def load() -> i64 error[LoadError]:
    1

def scan(value: mutable i64) -> i64:
    machine over value while value < 2:
        state Run
        state Done
        start Run
        Run, _:
            if value == 0:
                catch load():
                    loaded:
                        value <- value + loaded
                    LoadError.Failed:
                        value <- value + 1
                -> Run
            else:
                value <- value + 1
                -> Done
        Done, _:
            break
    return value

def main() -> i64:
    return 0 if scan(0) == 2 else 1
