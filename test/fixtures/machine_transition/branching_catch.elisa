error MachineBranchError:
    Failed

def load(fail: bool) -> i64 error[MachineBranchError]:
    raise MachineBranchError.Failed if fail
    7

def main() -> i64:
    result: mutable i64 = 0
    machine over result while result < 1:
        state Run
        start Run

        Run, _:
            value: i64 = catch load(false):
                ok value:
                    value
                error failure:
                    1
            result <- value
            -> Run
    return result
