# Transition arguments are evaluated before the successor payload is installed.
# The result distinguishes Run(b, a) from a sequential overwrite (Run(b, b)).
def main() -> i64:
    ticks: mutable i64 = 0
    machine over ticks while ticks < 2:
        state Run(a: i64, b: i64)
        state Check(a: i64, b: i64)
        start Run(1, 2)
        Run(a, b), _:
            ticks <- ticks + 1
            -> Check(b, a)
        Check(a, b), _:
            return a * 100 + b
    return 0
