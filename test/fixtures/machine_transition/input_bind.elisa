# The input binder is local to one machine arm. It must be available in the guard
# and body without leaking into sibling arms.
def main() -> i64:
    ticks: mutable i64 = 0
    machine over ticks while ticks < 1:
        state Run
        start Run
        Run, current if current == 0:
            ticks <- ticks + 1
            -> Run
        Run, _:
            break
    return ticks
