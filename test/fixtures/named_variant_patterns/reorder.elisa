# docs/122 §5.7: labels may come in any order. Exit code 16.
enum Shape:
    Rect(w: i64, h: i64, depth: i64)
    Dot
def area(s: Shape) -> i64:
    match s:
        Shape.Rect(h: height, depth: d, w: x):
            return height + d + x
        _:
            return 0
def main() -> i32:
    return area(Shape.Rect(3, 4, 9)).i32()
