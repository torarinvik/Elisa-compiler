# A labeled pattern on an enum hierarchy variant, the shape of `Decl.Func(params: p, _)`.
# Exit code 42.
enum Node:
    Leaf
enum Decl is Node:
    Func(name: i64, arity: i64, line: i64)
    Const(value: i64)
def score(d: Decl) -> i64:
    match d:
        Decl.Func(arity: a, line: l, _):
            return a * 10 + l
        Decl.Const(value: v):
            return v
def main() -> i32:
    return score(Decl.Func(7, 4, 2)).i32()
