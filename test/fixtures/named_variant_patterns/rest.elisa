# A final `_` ignores the fields left unnamed. Exit code 13.
enum Shape:
    Rect(w: i64, h: i64, depth: i64)
    Dot
def pick(s: Shape) -> i64:
    match s:
        Shape.Rect(depth: d, _):
            return d
        Shape.Dot:
            return 0
def first(s: Shape) -> i64:
    match s:
        Shape.Rect(w: x, _):
            return x
        Shape.Dot:
            return 0
def main() -> i32:
    s: Shape = Shape.Rect(4, 7, 9)
    return (pick(s) + first(s)).i32()
