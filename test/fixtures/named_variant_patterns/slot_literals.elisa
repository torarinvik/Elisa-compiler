# A value-position match stored into a slot, literal fields on a plain payload enum. Exit 195.
enum Shape:
    Rect(w: i64, h: i64)
    Sq(side: u8)
    Dot
def f(s: Shape) -> i64:
    x: i64 = match s:
        Shape.Rect(9, h): h
        Shape.Rect(w, 1): w * 100
        Shape.Sq(7): 70
        Shape.Sq(_): 71
        _: 0
    return x
def main() -> i32:
    return ((f(Shape.Rect(9, 5)) + f(Shape.Rect(3, 1)) + f(Shape.Rect(3, 2)) + f(Shape.Sq(7)) + f(Shape.Sq(8)) + f(Shape.Dot)) % 251).i32()
