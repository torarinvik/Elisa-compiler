# Literal sub-patterns in payload fields (int, negative, bool, char, string), positional
# and labeled, in statement and value position, with guards and fall-through. Exit 37.
enum Tok:
    Num(v: i32, neg: bool)
    Ch(c: u8)
    Word(text: sview, len: i64)
    Name(text: sview)
    End
def f(t: Tok) -> i64:
    match t:
        Tok.Num(-3, true):
            return 1
        Tok.Num(v, false) if v > 5:
            return 2
        Tok.Num(_, _):
            return 3
        Tok.Ch('x'):
            return 4
        Tok.Ch(c):
            return 5
        Tok.Word("hi", n):
            return 6 + n
        Tok.Word(len: 7, _):
            return 20
        Tok.Word(_, _):
            return 30
        Tok.Name("a"):
            return 40
        Tok.Name(_):
            return 41
        Tok.End:
            return 50
def g(t: Tok) -> i64:
    return match t:
        Tok.Num(-3, true): 1
        Tok.Ch('x'): 4
        Tok.Word("hi", n): 6 + n
        Tok.Word(len: 7, _): 20
        Tok.Name("a"): 40
        _: 99
def both(t: Tok) -> i64:
    return f(t) * 100 + g(t)
def main() -> i32:
    total: mutable i64 = 0
    total <- total + both(Tok.Num(-3, true))
    total <- total * 3 + both(Tok.Num(9, false))
    total <- total * 3 + both(Tok.Num(1, false))
    total <- total * 3 + both(Tok.Ch(120))
    total <- total * 3 + both(Tok.Ch(1))
    total <- total * 3 + both(Tok.Word("hi", 2))
    total <- total * 3 + both(Tok.Word("yo", 7))
    total <- total * 3 + both(Tok.Word("yo", 1))
    total <- total * 3 + both(Tok.Name("a"))
    total <- total * 3 + both(Tok.Name("b"))
    total <- total * 3 + both(Tok.End)
    return (total % 251).i32()
