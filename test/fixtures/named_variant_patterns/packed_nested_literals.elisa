# Literal sub-patterns nested inside packed variants; i8/i32/bool/f64/u8 fields. Exit 213.
# The value-position match once read `T.One(255)` as `T.One(_)` (wrong answer 212).
enum T:
    Leaf(v: i32, ok: bool, f: f64)
    Pair(k: i8, a: T, b: T)
    One(c: u8)
def s(t: T) -> i64:
    match t:
        T.Pair(-1, T.Leaf(-5, true, _), T.One('z')):
            return 1
        T.Pair(_, T.Leaf(_, false, 2.5), _):
            return 2
        T.Pair(-1, _, _):
            return 3
        T.Leaf(-5, true, _):
            return 4
        T.One(255):
            return 5
        _:
            return 6
def v(t: T) -> i64:
    return match t:
        T.Pair(-1, T.Leaf(-5, true, _), T.One('z')): 1
        T.Pair(_, T.Leaf(_, false, 2.5), _): 2
        T.One(255): 5
        _: 6
def main() -> i32:
    region r(4096):
        store: T.Store[Local] = T.Store(r)
        in store:
            a: T = new[store] T.Leaf(-5, true, 0.0)
            b: T = new[store] T.Leaf(1, false, 2.5)
            z: T = new[store] T.One(122)
            ff: T = new[store] T.One(255)
            items: darray[T] = [new[store] T.Pair(-1, a, z), new[store] T.Pair(4, b, z), new[store] T.Pair(-1, b, a), a, ff, z]
            t: mutable i64 = 0
            for e in items |t|:
                t <- t * 7 + s(e) * 10 + v(e)
            return (t % 251).i32()
    return 0
