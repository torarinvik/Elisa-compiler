# Literal sub-patterns on a recursive (packed AoS) enum: single and multi-field, labeled,
# both match forms. Exit 62.
enum Expr:
    Num(v: i64)
    Flag(on: bool)
    Bin(op: u8, left: Expr, right: Expr)
    Name(text: sview, depth: i64)
def ev(e: Expr) -> i64:
    match e:
        Expr.Num(0):
            return 100
        Expr.Num(v):
            return v
        Expr.Flag(true):
            return 1
        Expr.Flag(_):
            return 0
        Expr.Bin('+', l, r):
            return ev(l) + ev(r)
        Expr.Bin(op: '*', left: l, right: r):
            return ev(l) * ev(r)
        Expr.Bin(_, l, _):
            return ev(l)
        Expr.Name("x", -1):
            return 7
        Expr.Name(_, d):
            return d
def tag(e: Expr) -> i64:
    return match e:
        Expr.Num(0): 1
        Expr.Bin('+', _, _): 2
        Expr.Name("x", -1): 3
        _: 4
def main() -> i32:
    region r(4096):
        store: Expr.Store[Local] = Expr.Store(r)
        in store:
            e: Expr = new[store] Expr.Bin(43, new[store] Expr.Num(3), new[store] Expr.Bin(42, new[store] Expr.Num(0), new[store] Expr.Flag(true)))
            nx: Expr = new[store] Expr.Name("x", -1)
            ny: Expr = new[store] Expr.Name("y", 5)
            minus: Expr = new[store] Expr.Bin(45, new[store] Expr.Num(2), new[store] Expr.Num(9))
            zero: Expr = new[store] Expr.Num(0)
            t: i64 = ev(e) * 10 + ev(nx) + ev(ny) + ev(minus)
            return ((t + tag(e) * 3 + tag(zero) + tag(nx) * 5) % 251).i32()
    return 0
