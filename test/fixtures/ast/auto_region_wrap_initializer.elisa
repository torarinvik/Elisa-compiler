# `-emit ast` stmt counts encode stage0's INFERENCE-BY-DEFAULT region wrap, and the wrap
# turns on the INITIALIZER, not the declared type: stage0 requires
# `isRegionlessContainerType(s.Type) && isAllocatingLiteral(s.Value)`. A container local
# assigned from a view, a copy, a call or a conditional does not allocate at that binding
# and leaves the body unwrapped, so its statements print individually.
#
# stage1 used to test the declared type alone and wrapped all four bodies below. That was a
# live `-emit ast` divergence, and because a wrapped body sets stage0's `currentAllocExpr`
# for its whole extent it also silenced every "has no region to allocate in" diagnostic
# inside it -- the two together are why a container-literal rule measured on one-line probe
# bodies over-fired on real code. Parens are NOT stripped for the literal arm: stage0
# switches on the node type directly.

def from_view(src: darray[i64]&) -> i64:
    xs: darray[i64] = src
    zz: i64 = 7
    return xs.count.i64() + zz

def from_literal() -> i64 can[Memory.Allocate, Abort.Panic]:
    ys: darray[i64] = [1, 2, 3]
    zz: i64 = 7
    return ys.count.i64() + zz

def from_conditional(c: bool, src: darray[i64]&) -> i64:
    ws: darray[i64] = src if c else src
    zz: i64 = 7
    return ws.count.i64() + zz

def make_items() -> darray[i64] can[Memory.Allocate, Abort.Panic]:
    return [1, 2, 3]

def from_call() -> i64 can[Memory.Allocate, Abort.Panic]:
    cs: darray[i64] = make_items()
    zz: i64 = 7
    return cs.count.i64() + zz

def from_paren_call() -> i64 can[Memory.Allocate, Abort.Panic]:
    ps: darray[i64] = (make_items())
    zz: i64 = 7
    return ps.count.i64() + zz

def from_comprehension(src: darray[i64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    gs: darray[i64] = [v for v in src]
    zz: i64 = 7
    return gs.count.i64() + zz

def scalar_body(v: i64) -> i64:
    aa: i64 = v
    zz: i64 = 7
    return aa + zz
