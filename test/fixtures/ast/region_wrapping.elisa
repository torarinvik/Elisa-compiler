def pushes(xs: mutable darray[i64]&) -> void:
    xs.push(1)
    xs.push(2)

def scalars() -> i64:
    a: i64 = 1
    b: i64 = 2
    return a + b

def strings() -> i64:
    s: sview = "hi"
    t: sview = "yo"
    return 2

def containers() -> i64:
    xs: mutable darray[i64] = []
    xs.push(1)
    return xs[0]
