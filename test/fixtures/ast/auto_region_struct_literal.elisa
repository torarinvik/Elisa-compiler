# A container literal inside a constructor needs an implicit region, regardless
# of the local's mutable type wrapper. Scalar constructor arguments do not.
struct Bag:
    items: mutable darray[i64]

struct Scalar:
    value: i64

def with_items() -> i64:
    bag: mutable Bag = Bag{items: [41, 42]}
    first: i64 = bag.items[0]
    return first

def with_scalar() -> i64:
    item: mutable Scalar = Scalar{value: 41}
    first: i64 = item.value
    return first
