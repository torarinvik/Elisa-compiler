struct Holder:
    values: mutable darray[i64]

def grow(holder: Holder&, value: i64) -> void:
    holder.values.push(value)

def read(holder: Holder&) -> i64:
    return holder.values.count.i64()

def explicit[@r](holder: Holder& @r, value: i64) -> void:
    holder.values.push(value)

def main() -> i64:
    return 0
