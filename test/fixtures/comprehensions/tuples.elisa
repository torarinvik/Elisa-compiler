# A comprehension whose element is an unlabeled tuple: stage0's fields `_0`, `_1`.
def main() -> i64:
    xs: darray[i64] = [1, 2, 3]
    pairs = [(x, x * 2) for x in xs]
    total: mutable i64 = 0
    for a, b in pairs:
        total += a + b
    return 1 if pairs.count != 3 or total != 18
    return 2 if pairs[2]._1 != 6
    named: darray[(n: i64, twice: i64)] = [(x, x * 2) for x in xs if x > 1]
    return 3 if named.count != 2 or named[1].twice != 6
    grid = [(x, y) for x in 0..<2 for y in 0..<3]
    return 4 if grid.count != 6 or grid[5]._0 != 1 or grid[5]._1 != 2
    return 0
