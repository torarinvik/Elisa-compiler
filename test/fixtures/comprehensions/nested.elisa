# Nested comprehensions: later clauses nest inside earlier ones, each with an optional filter.
def sum_of(xs: darray[i64]&) -> i64:
    total: i64 =
        for x in xs |total: i64 = 0| -> total:
            total += x
    return total

def main() -> i64:
    xs: darray[i64] = [1, 2, 3]
    ys: darray[i64] = [10, 20]
    sums: darray[i64] = [x + y for x in xs for y in ys]
    return 1 if sums.count != 6 or sums[0] != 11 or sums[1] != 21 or sums[5] != 23
    # A filter after each clause; the inner clause reads the outer binder.
    picked: darray[i64] = [x * 100 + y for x in xs if x != 2 for y in 0..<x if y > 0]
    return 2 if picked.count != 2 or picked[0] != 301 or picked[1] != 302
    # Unannotated, three clauses, ranges.
    cube = [a * 100 + b * 10 + c for a in 0..<2 for b in 0..<2 for c in 0..<2]
    return 3 if cube.count != 8 or cube[7] != 111 or sum_of(cube) != 444
    # An inner clause that depends on the outer binder, and an empty inner clause.
    triangle: darray[i64] = [y for x in 0..<4 for y in 0..<x]
    return 4 if triangle.count != 6 or sum_of(triangle) != 4
    # A nested comprehension inside the element of another.
    rows: darray[darray[i64]] = [[x * y for y in ys] for x in xs]
    return 5 if rows.count != 3 or rows[2][1] != 60
    return 0
