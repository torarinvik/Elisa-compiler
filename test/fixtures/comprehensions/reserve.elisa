# An unfiltered comprehension over a darray reserves the source's count up front: the result's
# capacity equals its count (a push loop doubles from 8 and ends with spare capacity).
def main() -> i64:
    xs: mutable darray[i64] = []
    for i in 0..<100:
        xs.push(i)
    doubled: darray[i64] = [x * 2 for x in xs]
    return 1 if doubled.count != 100 or doubled.capacity != 100 or doubled[99] != 198
    kept: darray[i64] = [x for x in xs if x % 2 == 0]
    return 2 if kept.count != 50
    empty_source: darray[i64] = []
    none: darray[i64] = [x for x in empty_source]
    return 3 if none.count != 0
    return 0
