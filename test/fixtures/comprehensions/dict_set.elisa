# Dict and set comprehensions over darrays, ranges and nested clauses (the stage1 runtime holds
# the dict and set helpers).
include "elisacore_std/elisacore_runtime.elisa"

def main() -> i64:
    xs: darray[i64] = [1, 2, 3, 4]
    squares: dict[i64, i64] = {x: x * x for x in xs}
    return 1 if squares.count != 4
    parity: set[i64] = {x % 2 for x in xs}
    return 2 if parity.count != 2
    products: dict[i64, i64] = {x * 10 + y: x * y for x in xs if x > 2 for y in 0..<2}
    return 3 if products.count != 4
    seen: set[i64] = {x + y for x in xs for y in xs}
    return 4 if seen.count != 7
    return 0
