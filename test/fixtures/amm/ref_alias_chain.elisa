# stage1-only: stage0 rejects this. An alias of an alias still reaches the parameter: 164.
def fill(p: mutable darray[i64]&, n: i64):
    r1: mutable darray[i64]& = p
    r2: mutable darray[i64]& = r1
    for i in 0..<n:
        r2.push(i + 1)

def clobber() -> i64:
    junk: mutable darray[i64] = []
    for i in 0..<4096:
        junk.push(99)
    return junk.count.i64()

def main() -> i64:
    xs: mutable darray[i64] = []
    fill(&xs, 40)
    c: i64 = clobber()
    return xs[3] + 100 * xs.count.i64()
