# The reference may point into either of two caller regions after the rebind, so no
# single arena outlives every referent: stage1 must decline loudly (stage0 rejects too).
def fill(p: mutable darray[i64]&, q: mutable darray[i64]&, n: i64):
    r: mutable darray[i64]& = p
    r <- q
    for i in 0..<n:
        r.push(i + 1)

def clobber() -> i64:
    junk: mutable darray[i64] = []
    for i in 0..<4096:
        junk.push(99)
    return junk.count.i64()

def main() -> i64:
    outer: mutable darray[i64] = []
    region scratch:
        inner: mutable darray[i64] = []
        fill(&inner, &outer, 40)
    c: i64 = clobber()
    return outer[3] + 100 * outer.count.i64()
