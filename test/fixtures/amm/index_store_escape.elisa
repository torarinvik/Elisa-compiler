# stage1-only: stage0 rejects this. Storing a locally built darray into an element of a
# parameter's darray escapes it to the caller: build it in the caller's arena. 164, not a trap.
def refill(rows: mutable darray[darray[i64]]&, n: i64):
    fresh: mutable darray[i64] = []
    for i in 0..<n:
        fresh.push(i + 1)
    rows[0] <- fresh

def clobber() -> i64:
    junk: mutable darray[i64] = []
    for i in 0..<4096:
        junk.push(99)
    return junk.count.i64()

def main() -> i64:
    rows: mutable darray[darray[i64]] = []
    empty: darray[i64] = []
    rows.push(empty)
    refill(&rows, 40)
    c: i64 = clobber()
    return rows[0][3] + 100 * rows[0].count.i64()
