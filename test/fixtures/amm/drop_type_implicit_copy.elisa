# REJECT: a struct with `__drop__` is move-only; the implicit copy would drop twice.
global mutable drops: i64 = 0

struct Tracked:
    mark: i64

def __drop__(self: Tracked) -> void:
    drops <- drops + 1

def f() -> void:
    t: Tracked = Tracked{mark: 1}
    u: Tracked = t
    _ = u.mark

def main() -> i64:
    f()
    return drops
