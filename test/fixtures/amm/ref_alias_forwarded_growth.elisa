# stage1-only: stage0 rejects this. Passing a local alias of a parameter to a growing
# callee must forward the caller's arena through the alias: 164, not 160.
def grow(xs: mutable darray[i64]&, n: i64):
    for i in 0..<n:
        xs.push(i + 1)

def fill(p: mutable darray[i64]&, n: i64):
    r: mutable darray[i64]& = p
    grow(r, n)

def clobber() -> i64:
    junk: mutable darray[i64] = []
    for i in 0..<4096:
        junk.push(99)
    return junk.count.i64()

def main() -> i64:
    xs: mutable darray[i64] = []
    fill(&xs, 40)
    c: i64 = clobber()
    return xs[3] + 100 * xs.count.i64()
