# stage1-only: stage0 rejects this. Two aliases of two parameters that live in different
# caller regions must each grow in their own referent's region: 169, not a clobbered value.
def fill(p: mutable darray[i64]&, q: mutable darray[i64]&, n: i64):
    a: mutable darray[i64]& = p
    b: mutable darray[i64]& = q
    for i in 0..<n:
        a.push(i + 1)
        b.push(i + 2)

def clobber() -> i64:
    junk: mutable darray[i64] = []
    for i in 0..<4096:
        junk.push(99)
    return junk.count.i64()

def main() -> i64:
    outer: mutable darray[i64] = []
    total: mutable i64 = 0
    region scratch:
        inner: mutable darray[i64] = []
        fill(&inner, &outer, 40)
        total <- inner[3]
    c: i64 = clobber()
    return total + outer[3] + 100 * outer.count.i64()
