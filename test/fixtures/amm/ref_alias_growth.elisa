# stage1-only: stage0 rejects this ("push has no region to grow into"). A local ref
# aliasing a parameter must grow in the CALLER's arena, not the callee's: 164, not 160.
def fill(p: mutable darray[i64]&, n: i64):
    r: mutable darray[i64]& = p
    for i in 0..<n:
        r.push(i + 1)

def clobber() -> i64:
    junk: mutable darray[i64] = []
    for i in 0..<4096:
        junk.push(99)
    return junk.count.i64()

def main() -> i64:
    xs: mutable darray[i64] = []
    fill(&xs, 40)
    c: i64 = clobber()
    return xs[3] + 100 * xs.count.i64()
