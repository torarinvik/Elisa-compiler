# stage1-only: stage0 rejects this ("cannot infer region parameter"). A LOCAL reference
# has no tracked referent, so growth through it must fail closed to the function's
# outermost arena, not the enclosing scratch region: 164, not 160.
def grow(xs: mutable darray[i64]&, n: i64):
    for i in 0..<n:
        xs.push(i + 1)

def fill() -> i64:
    outer: mutable darray[i64] = []
    r: mutable darray[i64]& = &outer
    region scratch(4096):
        grow(r, 40)
    region scratch2(4096):
        junk: mutable darray[i64] = []
        for i in 0..<64:
            junk.push(99)
    return outer[3] + 100 * outer.count.i64()

def main() -> i64:
    return fill()
