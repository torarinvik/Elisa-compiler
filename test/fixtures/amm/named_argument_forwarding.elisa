# The region-forwarding pre-pass mapped call arguments to callee parameters by POSITION,
# ignoring argument names. `fill(b: ys, a: zs, n: 40)` binds `ys` to parameter 1 (`b`,
# the one `fill` grows), but the pass saw it at position 0 (`a`, read-only), so `inner`
# never took the caller's arena and grew `ys` in its own auto region: use-after-free
# (exit 160). The mixed form (`fill2(zs, n: 40, b: ws)`) covers a positional argument
# before named ones. Expected 4 + 5 + 100*40 = 4009 = 169 mod 256. stage0 rejects named
# arguments into a region-inferred parameter, so the answer is fixed here.
def fill(a: darray[i64]&, b: mutable darray[i64]&, n: i64):
    for i in 0..<n:
        b.push(a[0] + 4)

def fill2(a: darray[i64]&, n: i64, b: mutable darray[i64]&):
    for i in 0..<n:
        b.push(a[0] + 5)

def clobber() -> i64:
    junk: mutable darray[i64] = []
    for i in 0..<4096:
        junk.push(99)
    return junk.count.i64()

def inner(ys: mutable darray[i64]&) -> i64:
    zs: mutable darray[i64] = [0]
    fill(b: ys, a: zs, n: 40)
    return zs[0]

def inner2(ws: mutable darray[i64]&) -> i64:
    zs: mutable darray[i64] = [0]
    fill2(zs, n: 40, b: ws)
    return zs[0]

def main() -> i64:
    ys: mutable darray[i64] = []
    ws: mutable darray[i64] = []
    z: i64 = inner(&ys)
    c: i64 = clobber()
    z2: i64 = inner2(&ws)
    c2: i64 = clobber()
    return ys[3] + ws[3] + z + z2 + 100 * ys.count.i64()
