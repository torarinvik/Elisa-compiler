# A GENERIC effect operation (`Sink[T].put(out, v)`) stays an Expr.StaticEffectCall until
# emit time, when it lowers to a direct call of the selected handler operation. The region
# forwarding pre-pass skipped that node, so `fill` never learned that the handler grows
# `out`: its clone owned no arena and handed the callee the null no-region placeholder
# (segfault, exit 139). Expected 4 + 100*40 = 4004 = 164 mod 256. stage0 has no
# effectful-helper cloning and rejects the program, so the answer is fixed here.
effect Sink[T]:
    def put(out: mutable darray[i64]&, value: T)

handler static IntSink() for Sink[i64]:
    def put(out: mutable darray[i64]&, value: i64):
        out.push(value)

def fill[T](out: mutable darray[i64]&, value: T, n: i64) can[Sink[T]]:
    for i in 0..<n:
        Sink[T].put(out, value)

def clobber() -> i64:
    junk: mutable darray[i64] = []
    for i in 0..<4096:
        junk.push(99)
    return junk.count.i64()

def main() -> i64:
    xs: mutable darray[i64] = []
    can Sink[i64] with IntSink:
        fill[i64](&xs, 4, 40)
    c: i64 = clobber()
    return xs[3] + 100 * xs.count.i64()
