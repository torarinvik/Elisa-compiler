extern va_list

@intrinsic("llvm.va_start")
extern llvm_va_start(storage: mutable void&) -> void

@intrinsic("llvm.va_end")
extern llvm_va_end(storage: mutable void&) -> void

extern vsnprintf(buffer: mutable u8&?, size: u64, format: cstr, args: va_list) -> i32
extern puts(value: cstr) -> i32

global mutable output: array[u8, 80] = zeroed

def set_message(format: cstr, ...) -> void can[Unsafe.PointerCast]:
    arguments: mutable va_list = zeroed
    llvm_va_start((&arguments).cast[mutable void&])
    _ = vsnprintf((&output[0]).cast[mutable u8&?], 80, format, arguments)
    llvm_va_end((&arguments).cast[mutable void&])

def main() -> i64 can[Unsafe.PointerCast]:
    set_message("value=%d", 42)
    _ = puts((&output[0]).cast[cstr])
    return 0
