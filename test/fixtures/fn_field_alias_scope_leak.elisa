struct CallbackBox:
	run: fn(i64, i64) -> i64

def outer(first: i64, second: i64) -> i64:
	return first - second

def inner(x: i64, y: i64) -> i64:
	return x - y

def main() -> i64:
	box: CallbackBox = CallbackBox{run: outer}
	if true:
		box: CallbackBox = CallbackBox{run: inner}
	return box.run(y: 7, x: 30)
