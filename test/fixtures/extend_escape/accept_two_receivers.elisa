# ACCEPTED by both compilers: one receiver per caller region; each call is bound to its
# receiver's region. Exits 0.
def make(name: sview) -> darray[u8]:
    can Memory.Allocate, Abort.Panic:
        made: mutable darray[u8] = []
        made.extend(name)
        made

def fill(buffer: mutable darray[u8]&, other: mutable darray[u8]&, name: sview) -> void:
    can Memory.Allocate, Abort.Panic:
        buffer.extend(make(name))
        other.extend(make(name))

def main() -> i32:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[u8] = []
        more: mutable darray[u8] = []
        fill(&out, &more, "abc")
        return 1 if out.count != 3 or more.count != 3
        0
