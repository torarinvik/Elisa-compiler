# ACCEPTED by both compilers: returned views, built in the parameter's region. Exits 0.
def make(name: sview) -> darray[sview]:
    can Memory.Allocate, Abort.Panic:
        made: mutable darray[sview] = []
        made.push(name)
        made

def fill(buffer: mutable darray[sview]&, name: sview) -> void:
    can Memory.Allocate, Abort.Panic:
        buffer.extend(make(name))

def main() -> i32:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[sview] = []
        fill(&out, "abc")
        return 1 if out.count != 1
        0
