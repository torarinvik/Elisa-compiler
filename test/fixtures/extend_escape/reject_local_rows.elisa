# REJECTED by both compilers: the rows of a LOCAL container live in this function's region,
# and extending a parameter with them stores references that dangle at return.
def fill(buffer: mutable darray[darray[i64]]&, count: i64) -> void:
    can Memory.Allocate, Abort.Panic:
        made: mutable darray[darray[i64]] = []
        row: mutable darray[i64] = []
        row.push(count)
        made.push(row)
        buffer.extend(made)

def main() -> i32:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[darray[i64]] = []
        fill(&out, 3)
        return 1 if out.count != 1
        0
