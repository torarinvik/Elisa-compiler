# ACCEPTED by both compilers: the returned rows are built in the parameter's region (the
# callee takes it as a hidden argument), so extending with them stores nothing that dies at
# return. Exits 0.
def make(count: i64) -> darray[darray[i64]]:
    can Memory.Allocate, Abort.Panic:
        made: mutable darray[darray[i64]] = []
        row: mutable darray[i64] = []
        row.push(count)
        made.push(row)
        made

def fill(buffer: mutable darray[darray[i64]]&, count: i64) -> void:
    can Memory.Allocate, Abort.Panic:
        buffer.extend(make(count))

def main() -> i32:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[darray[i64]] = []
        fill(&out, 3)
        return 1 if out.count != 1
        0
