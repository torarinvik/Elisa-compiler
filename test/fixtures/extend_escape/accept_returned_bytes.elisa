# ACCEPTED by both compilers: extending a parameter with a returned byte darray copies the
# bytes; nothing of the call's region is stored. Stage1 used to reject it as an escape.
# Exits 0.
def make(name: sview) -> darray[u8]:
    can Memory.Allocate, Abort.Panic:
        made: mutable darray[u8] = []
        made.extend(name)
        made

def fill(buffer: mutable darray[u8]&, name: sview) -> void:
    can Memory.Allocate, Abort.Panic:
        buffer.extend(make(name))

def main() -> i32:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[u8] = []
        fill(&out, "abc")
        return 1 if out.count != 3
        0
