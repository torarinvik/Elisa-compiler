# REJECTED by both compilers: a call result with no named root has no referent region.
struct Desk:
    order: mutable darray[i64]

struct Session:
    desk: mutable Desk
    owner: mutable Arena

def raise_window(desk: mutable Desk&, top: i64) -> void:
    can Memory.Allocate, Abort.Panic:
        order: mutable darray[i64] = []
        order.push(top)
        for value in desk.order |order, top|:
            order.push(value) if value != top
        desk.order <- order

def click(session: mutable Session&, top: i64) -> void:
    can Memory.Allocate, Abort.Panic:
        owner: mutable Arena& = &session.owner
        in owner:
            raise_window(&session.desk, top)

def steer(session: mutable Session&, top: i64) -> void:
    can Memory.Allocate, Abort.Panic:
        click(session, top)

global mutable shared_session: Session = zeroed

def lookup() -> mutable Session&:
    can Global{Read,Write}:
        &shared_session

def event(top: i64) -> void:
    can Memory.Allocate, Abort.Panic, Global{Read,Write}:
        run: mutable Session& = lookup()
        steer(run, top)

def main() -> i32:
    0
