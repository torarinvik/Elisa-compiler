# ACCEPTED by both compilers: `in perm:` binds the program-lifetime region. Runs: the
# grown order survives a clobbering allocation and a second event; exit 0.
struct Desk:
    order: mutable darray[i64]

struct Session:
    desk: mutable Desk
    owner: mutable Arena

def raise_window(desk: mutable Desk&, top: i64) -> void:
    can Memory.Allocate, Abort.Panic:
        order: mutable darray[i64] = []
        order.push(top)
        for value in desk.order |order, top|:
            order.push(value) if value != top
        desk.order <- order

def click(session: mutable Session&, top: i64) -> void:
    can Memory.Allocate, Abort.Panic:
        owner: mutable Arena& = &session.owner
        in owner:
            raise_window(&session.desk, top)

def steer(session: mutable Session&, top: i64) -> void:
    can Memory.Allocate, Abort.Panic:
        click(session, top)

def event(address: u64, top: i64) -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        trusted Unsafe.PointerCast:
            run: mutable heap Session& = address.uintptr().cast[mutable heap Session&]
            in perm:
                steer(run, top)

def clobber() -> i64:
    can Memory.Allocate, Abort.Panic:
        junk: mutable darray[i64] = []
        for index in 0..<4096 |junk|:
            junk.push(-1)
        junk.count.i64()

def main() -> i32:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        session: mutable Session = Session{desk: Desk{order: []}, owner: zeroed}
        address: mutable u64 = 0
        trusted Unsafe.PointerCast:
            address <- (&session).cast[uintptr].u64()
        event(address, 7)
        _ = clobber()
        event(address, 9)
        _ = clobber()
        return 1 if session.desk.order.count != 2
        return 2 if session.desk.order[0] != 9 or session.desk.order[1] != 7
        0
