# ACCEPTED by both compilers: a reference parameter forwards the caller's region.
struct Desk:
    order: mutable darray[i64]

struct Session:
    desk: mutable Desk
    owner: mutable Arena

def raise_window(desk: mutable Desk&, top: i64) -> void:
    can Memory.Allocate, Abort.Panic:
        order: mutable darray[i64] = []
        order.push(top)
        for value in desk.order |order, top|:
            order.push(value) if value != top
        desk.order <- order

def click(session: mutable Session&, top: i64) -> void:
    can Memory.Allocate, Abort.Panic:
        owner: mutable Arena& = &session.owner
        in owner:
            raise_window(&session.desk, top)

def steer(session: mutable Session&, top: i64) -> void:
    can Memory.Allocate, Abort.Panic:
        click(session, top)

def event(session: mutable Session&, top: i64) -> void:
    can Memory.Allocate, Abort.Panic:
        steer(session, top)
        raise_window(&session.desk, top)

def main() -> i32:
    0
