# expect: reject / good
# A captured binding passed as & inside a captured loop body together with an alias.
def f(a: mutable i64&, b: mutable i64&) -> i64:
    a <- 1
    b <- 2
    return a

def main() -> i64:
    x: mutable i64 = 0
    r: mutable i64& = &x
    acc: mutable i64 = 0
    for k in 0..<2 |acc, x|:
        acc += f(r, &x)
    return acc
