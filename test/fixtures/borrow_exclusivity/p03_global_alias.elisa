# expect: accept / HOLE
# The callee writes the global through its name while holding a mutable borrow of it.
global mutable g: mutable i64 = 0

def f(a: mutable i64&) -> i64:
    can Global.Write, Global.Read:
        a <- 1
        g <- 2
        return a

def main() -> i64:
    can Global.Write, Global.Read:
        return f(&g)
