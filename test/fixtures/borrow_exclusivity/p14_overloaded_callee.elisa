# expect: reject / n/a
# The check only judges calls resolving to exactly one declaration.
def f(a: mutable i64&, b: mutable i64&) -> i64:
    a <- 1
    b <- 2
    return a

def f(a: mutable i64&, b: mutable i64&, c: i64) -> i64:
    a <- c
    b <- 2
    return a

def main() -> i64:
    x: mutable i64 = 0
    return f(&x, &x)
