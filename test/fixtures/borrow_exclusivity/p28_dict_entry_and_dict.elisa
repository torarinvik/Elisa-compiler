# expect: reject / good
def grow(d: mutable dict[i64, i64]&, e: i64&) -> i64:
    can Memory.Allocate, Abort.Panic:
        for k in 0..<1000 |d|:
            d[k + 10] <- k
        return e

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        d: mutable dict[i64, i64] = {1: 5}
        return grow(&d, &d[1])
