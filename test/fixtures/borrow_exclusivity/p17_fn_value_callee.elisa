# expect: reject
# message: or split the borrows onto disjoint fields.
# Calling through a function value: no declaration to resolve.
def f(a: mutable i64&, b: mutable i64&) -> i64:
    a <- 1
    b <- 2
    return a

def main() -> i64:
    g: fn(mutable i64&, mutable i64&) -> i64 = f
    x: mutable i64 = 0
    return g(&x, &x)
