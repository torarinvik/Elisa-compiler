# expect: run 3
# Lending a global to a callee that never names it, and a shared borrow to a reader.
global mutable g: mutable i64 = 0

def f(a: mutable i64&) -> i64:
    a <- 1
    return a

def r(a: i64&) -> i64:
    can Global.Read:
        return a + g

def main() -> i64:
    can Global.Write, Global.Read:
        g <- 1
        return f(&g) + r(&g)
