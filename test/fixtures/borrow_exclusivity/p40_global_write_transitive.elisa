# expect: reject
# message: pass the value and assign the result
# The callee writes the global through a helper it calls.
global mutable g: mutable i64 = 0

def set_g() -> void:
    can Global.Write:
        g <- 2

def f(a: i64&) -> i64:
    can Global.Write:
        set_g()
        return a

def main() -> i64:
    can Global.Write, Global.Read:
        return f(&g)
