# expect: accept / HOLE
# A borrow handed back by a call, bound to a local, then passed with the original.
def id(a: mutable i64&) -> mutable i64&:
    return a

def f(a: mutable i64&, b: mutable i64&) -> i64:
    a <- 1
    b <- 2
    return a

def main() -> i64:
    x: mutable i64 = 0
    r: mutable i64& = id(&x)
    return f(r, &x)
