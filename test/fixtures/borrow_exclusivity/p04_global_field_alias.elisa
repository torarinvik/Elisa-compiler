# expect: reject
# message: pass the value and assign the result
struct P:
    a: mutable i64
    b: mutable i64

global mutable gp: mutable P = P{a: 0, b: 0}

def f(a: mutable i64&) -> i64:
    can Global.Write, Global.Read:
        a <- 1
        gp.a <- 2
        return a

def main() -> i64:
    can Global.Write, Global.Read:
        return f(&gp.a)
