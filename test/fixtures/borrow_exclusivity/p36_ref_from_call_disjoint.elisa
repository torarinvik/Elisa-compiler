# expect: run 2
# A returned reference to x beside a borrow of a DIFFERENT local is fine.
def id(a: mutable i64&) -> mutable i64&:
    return a

def f(a: mutable i64&, b: mutable i64&) -> i64:
    a <- 1
    b <- 2
    return a + b - 1

def main() -> i64:
    x: mutable i64 = 0
    y: mutable i64 = 0
    r: mutable i64& = id(&x)
    return f(r, &y)
