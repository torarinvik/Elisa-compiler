# expect: reject
# A borrow of an element returned from a call, then the container grows.
def first(v: darray[i64]&) -> i64&:
    can Abort.Panic:
        return &v[0]

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        v: mutable darray[i64] = [1]
        r: i64& = first(&v)
        for k in 0..<1000 |v|:
            v.push(k)
        return r
