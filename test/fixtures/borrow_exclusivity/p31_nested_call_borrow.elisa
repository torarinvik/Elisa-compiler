# expect: accept / sound
# The argument of one call also reads x through a nested call that mutates it.
def bump(a: mutable i64&) -> i64:
    a <- a + 1
    return a

def f(a: mutable i64&, b: i64) -> i64:
    a <- 10
    return b

def main() -> i64:
    x: mutable i64 = 0
    return f(&x, bump(&x))
