# expect: reject
def use(b: mutable dstr&, s: sview) -> i64:
    can Memory.Allocate:
        for k in 0..<1000 |b|:
            b.push('a')
        return s.len().i64()

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        buf: mutable dstr = "abc"
        s: sview = buf.as_sview()
        return use(&buf, s)
