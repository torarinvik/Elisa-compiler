# expect: accept / HOLE
# A container of structs holding a borrow of x, passed beside &x.
struct H:
    r: i64&

def f(hs: darray[H]&, b: mutable i64&) -> i64:
    can Abort.Panic:
        b <- 2
        return hs[0].r

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        x: mutable i64 = 0
        hs: mutable darray[H] = [H{r: &x}]
        return f(&hs, &x)
