# expect: run 3
# Two references allocated from the same Arena do not alias each other or the arena.
struct S:
    v: mutable i64

def take(arena: mutable Arena&, out: mutable S&) -> mutable S&:
    _ = arena
    return out

def f(a: mutable S&, b: mutable S&) -> i64:
    a.v <- 1
    b.v <- 2
    return a.v + b.v

def main() -> i64:
    s: mutable S = S{v: 0}
    t: mutable S = S{v: 0}
    arena: mutable Arena = zeroed
    r: mutable S& = take(&arena, &s)
    q: mutable S& = take(&arena, &t)
    return f(r, q)
