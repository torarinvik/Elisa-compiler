# expect: reject / good
# A typed ref local of a field, then the whole owner (field-path vs ref local).
struct P:
    a: mutable i64
    b: mutable i64

def whole(p: mutable P&, a: i64&) -> i64:
    p.a <- 3
    return a

def main() -> i64:
    p: mutable P = P{a: 1, b: 2}
    r: i64& = &p.a
    return whole(&p, r)
