# expect: accept (out of scope: Unsafe.PointerCast launders the alias; O0=2, O2 -fnoalias=1)
# Two mutable borrows of x laundered through a pointer cast.
def f(a: mutable i64&, b: mutable i64&) -> i64:
    a <- 1
    b <- 2
    return a

def main() -> i64:
    can Unsafe.PointerCast:
        x: mutable i64 = 0
        p: mutable i64& = (&x).cast[mutable i64&]
        return f(p, &x)
