# expect: accept / HOLE
# Through a ref local to the whole struct, then a field of the owner.
struct P:
    a: mutable i64
    b: mutable i64

def f(a: mutable i64&, b: mutable i64&) -> i64:
    a <- 1
    b <- 2
    return a

def main() -> i64:
    p: mutable P = P{a: 1, b: 2}
    r: mutable P& = &p
    return f(&r.a, &p.a)
