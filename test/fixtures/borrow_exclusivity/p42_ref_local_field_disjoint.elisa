# expect: run 3
# &r.a with r = &p beside &p.b: disjoint fields stay accepted.
struct P:
    a: mutable i64
    b: mutable i64

def f(a: mutable i64&, b: mutable i64&) -> i64:
    a <- 1
    b <- 2
    return a + b

def main() -> i64:
    p: mutable P = P{a: 0, b: 0}
    r: mutable P& = &p
    return f(&r.a, &p.b)
