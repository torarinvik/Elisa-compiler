# expect: accept-semantic / HOLE
# An element borrow of a global container while the callee grows it by name (UAF).
global mutable gv: mutable darray[i64] = zeroed

def f(e: i64&) -> i64:
    can Global.Write, Global.Read, Memory.Allocate:
        for k in 0..<10000 |gv|:
            gv.push(k)
        return e

def main() -> i64:
    can Global.Write, Global.Read, Memory.Allocate, Abort.Panic:
        gv.push(41)
        return f(&gv[0])
