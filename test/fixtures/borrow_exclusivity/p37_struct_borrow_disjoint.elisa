# expect: run 2
# A struct holding a borrow of x beside &y, and beside a shared borrow of x.
struct H:
    r: i64&

def f(h: H, b: mutable i64&) -> i64:
    b <- 2
    return h.r + b

def g(h: H, b: i64&) -> i64:
    return h.r + b

def main() -> i64:
    x: mutable i64 = 0
    y: mutable i64 = 0
    h: H = H{r: &x}
    return f(h, &y) + g(h, &x)
