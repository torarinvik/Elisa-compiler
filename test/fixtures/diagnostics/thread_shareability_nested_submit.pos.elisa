# A submit nested in one arm of a ternary still checks its by-reference payload.
def read_ref(value: i64&) -> i64:
    return value

def twice(value: i64) -> i64:
    return value * 2

def main() -> i64:
    can Parallel, Memory.Allocate, Abort.Panic:
        value: i64 = 3
        flag: bool = true
        nursery workers(1):
            submit read_ref(&value) if flag else submit twice(value)
        return 0
