# A loop body is checked like straight-line code: `t.v` after `move t` is a use after move.
affine struct Handle:
    v: i64

def sink(h: Handle) -> i64:
    return h.v

def main() -> i32:
    t: Handle = Handle{v: 1}
    for i in 0..<3:
        a: i64 = sink(move t)
        b: i64 = t.v
    return 0
