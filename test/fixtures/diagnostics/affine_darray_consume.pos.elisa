# A darray whose elements hold linear handles must be drained, moved or returned; dropping
# elements through clear/truncate/indexed assignment leaks them. stage0 counts affine,
# linear and `__drop__` structs, aggregates holding one, optionals and nested darrays.
affine struct Handle:
    v: i64

linear struct Lin:
    v: i64

struct Pair:
    h: Handle
    n: i64

struct Tracked:
    mark: i64

def __drop__(self: Tracked) -> void:
    pass

def release(h: Handle) -> i64:
    return h.v

def take(xs: darray[Handle]) -> i64:
    return 0

def main() -> i32:
    a: mutable darray[Handle] = []
    a.clear()
    a.truncate(0)
    a[0] <- Handle{v: 1}
    for x in move a:
        _ = release(move x)
    d: mutable darray[Handle?] = []
    e: mutable darray[Pair] = []
    e.clear()
    f: mutable darray[darray[Handle]] = []
    g: mutable darray[Lin] = []
    t: mutable darray[Tracked] = []
    t.clear()
    return 0
