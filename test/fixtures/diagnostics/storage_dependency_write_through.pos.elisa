# corpus: deliberate-decline -- a store through a mutable interior reference uses its referent exactly as a read does:
# after a push may have moved the storage, `w <- v` writes into freed memory.

def straight(xs: mutable darray[i64]&, n: i64) -> i64:
    w: mutable i64& = &xs[0]
    xs.push(n)
    w <- 5
    return n

def loop_back_edge(xs: mutable darray[i64]&, n: i64) -> i64:
    w: mutable i64& = &xs[0]
    for i in 0..<n |xs, w|:
        w <- 5
        xs.push(i)
    return n

def store_keeps_tracking(xs: mutable darray[i64]&, n: i64) -> i64:
    w: mutable i64& = &xs[0]
    w <- 5
    xs.push(n)
    return w

def main() -> i32:
    return 0
