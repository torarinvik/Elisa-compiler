# The other half of the same rule: a loop whose header carries a YIELD (`-> total`) does
# produce a value, so it stays the function's tail expression and must still be accepted.
# Pinned because the fix for loop_capture_tail_missing_return.neg keys on the statement
# form's Invalid block value — matching Expr.Block too broadly would silently break this.
def f() -> i64:
    for i in 0..<4 |total: i64 = 0| -> total:
        total <- total + i
