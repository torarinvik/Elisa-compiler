# A named place (a local, a parameter, an element) borrows for a `T&` parameter; `&x` is explicit.
def first(values: i64&) -> i64:
    values[0]

def from_places(input: i64&, offset: i64, table: i64[4]&) -> i64:
    local: i64 = offset + 1
    first(local) + first(input) + first(&local) + first(table[1])
