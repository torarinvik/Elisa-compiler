# Moved dict values and record-update overrides and bases: accepted.
affine struct Handle:
    v: i64

struct Pair:
    a: Handle
    b: Handle

def update(p: Pair) -> Pair:
    t: Handle = Handle{v: 1}
    q: Pair = (move p){a = move t}
    return move q

def main() -> i32:
    can Memory.Allocate:
        t: Handle = Handle{v: 1}
        d: mutable dict[i64, Handle] = {}
        d.put(1, move t)
        return 0
