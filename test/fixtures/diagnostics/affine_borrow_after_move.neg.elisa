affine struct Handle:
    value: mutable i64

struct Holder:
    borrow: Handle&

def finish(owned: Handle) -> i64:
    taken: Handle = move owned
    taken.value

def peek(handle: Handle&) -> i64:
    handle.value

def direct() -> i64:
    owner: Handle = Handle{value: 1}
    borrow: Handle& = &owner
    total: i64 = finish(move owner)
    peek(borrow) + total

def through_field() -> i64:
    owner: Handle = Handle{value: 1}
    held: Holder = Holder{borrow: &owner}
    total: i64 = finish(move owner)
    peek(held.borrow) + total

def into_local() -> i64:
    owner: Handle = Handle{value: 1}
    borrow: Handle& = &owner
    taken: Handle = move owner
    peek(borrow) + finish(move taken)

def after_branch(flag: bool) -> i64:
    owner: mutable Handle = Handle{value: 1}
    borrow: Handle& = &owner
    if flag:
        _ = finish(move owner)
    peek(borrow)
