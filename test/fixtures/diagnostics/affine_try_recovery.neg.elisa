# A recovery that leaves the function consumes nothing on the fall-through path.
error E:
    Bad
affine struct Handle:
    v: i64
def take(h: Handle) -> i64:
    return h.v
def step(n: i64) -> i64 error[E]:
    raise E.Bad if n < 0
    return n
def block_return_then_use(n: i64) -> i64 error[E]:
    h: Handle = Handle{v: 1}
    v: i64 = try step(n) else err:
        return take(move h)
    return v + take(move h)
def main() -> i32:
    return 0
