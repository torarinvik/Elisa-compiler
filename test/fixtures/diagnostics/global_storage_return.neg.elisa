# Global-storage returns that do not share a growable buffer with the caller: a reference
# return, scalar reads, a freshly built container, and a parameter / local that shadows
# the global's name. All must stay silent.
struct Box:
    items: mutable darray[i64]
    n: i64

global store: mutable Box
global mutable gitems: mutable darray[i64] = zeroed

def items_ref() -> darray[i64]&:
    return &gitems

def first() -> i64:
    return store.items[0] + store.n

def count() -> usize:
    return store.items.count

def fresh() -> darray[i64]:
    out: mutable darray[i64] = []
    out.extend([v for v in gitems])
    return out

def shadow_param(gitems: darray[i64]) -> darray[i64]:
    return gitems

def shadow_local() -> darray[i64]:
    store: darray[i64] = []
    return store

def main() -> i32:
    return 0
