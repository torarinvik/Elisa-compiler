# `return &local` where the local is declared inside a clause block: the block's locals are frame
# locals too. stage0 rejects it; stage1's escape walk skipped clause-block declarations.
def leak() -> i64&:
    can Memory.Allocate:
        local: i64 = 5
        return &local

def main() -> i32:
    x: i64 = leak()
    return x.i32()
