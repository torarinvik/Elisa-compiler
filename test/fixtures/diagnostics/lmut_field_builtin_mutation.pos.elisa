# A mutating builtin collection method (push, extend, reserve, resize, clear,
# truncate, set, put, add, ...) on a darray/dict/set place rooted at an `lmut`
# parameter mutates that parameter in place, so it must be written as a
# reassignment of the root (`p.items <- p.items.push(v)`). A `for` capture does
# not license it; only a `while … |p|:` capture does.
struct Q:
    items: mutable darray[i64]
struct P:
    items: mutable darray[i64]
    name: mutable dstr
    q: mutable Q
    d: mutable dict[i64, i64]
    s: mutable set[i64]
    n: mutable i64
def step(p: lmut P, v: i64) -> void:
    p.items.clear()
    if v > 0:
        p.items.push(v)
def deep(p: lmut P) -> void:
    p.q.items.push(1)
def keyed(p: lmut P) -> void:
    p.d.put(1, 2)
    p.s.add(3)
def text(p: lmut P) -> void:
    p.name.push(65)
def discarded(p: lmut P) -> void:
    _ = p.items.push(1)
def nested(p: lmut P) -> usize:
    return p.items.push(1).count
def in_for(p: lmut P, xs: darray[i64]) -> void:
    for x in xs |p|:
        p.items.push(x)
def main() -> i32:
    return 0
