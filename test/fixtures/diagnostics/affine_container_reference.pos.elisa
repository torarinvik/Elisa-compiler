# References to values holding linear handles: stage0 walks the pointee's element types
# (containsAffineHandleValues), so a container, fixed array, optional element or generic
# instance of an affine struct is refused just like the struct itself.
affine struct Handle:
    v: i64

struct Pair:
    h: Handle
    n: i64

struct Box[T]:
    x: T

def by_darray(xs: darray[Handle]&) -> i64:
    return 0

def by_view(xs: view[Handle]&) -> i64:
    return 0

def by_fixed(xs: Handle[2]&) -> i64:
    return 0

def by_dict(xs: dict[i64, Handle]&) -> i64:
    return 0

def by_nested(xs: darray[darray[Handle]]&) -> i64:
    return 0

def by_optional(xs: darray[Handle?]&) -> i64:
    return 0

def by_aggregate(xs: darray[Pair]&) -> i64:
    return 0

def by_generic(xs: Box[Handle]&) -> i64:
    return 0

def by_fixed_aggregate(xs: Pair[2]&) -> i64:
    return 0

def by_mutable(xs: mutable darray[Handle[2]]&) -> i64:
    return 0

def main() -> i32:
    return 0
