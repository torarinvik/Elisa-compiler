# The control: the three spellings that replaced the arrow cast, plus the two arrows that
# are NOT casts -- a function-type parameter and a `when` arm's `->`. All accepted.
def apply_twice(step: fn(i64) -> i64, value: i64) -> i64:
    return step(step(value))

def add_one(value: i64) -> i64:
    return value + 1

def classify(n: i64) -> i64:
    return when n:
        0 -> 10
        _ -> 20

def widen(value: i64) -> i64:
    converted: i64 = i64(value)
    return apply_twice(add_one, converted) + classify(value)
