# A move in only the `then` branch of an if/else still leaves `t` consumed on that path;
# stage0 rejects the later use.
affine struct Handle:
    v: i64

def sink(h: Handle) -> i64:
    return h.v

def main() -> i32:
    t: Handle = Handle{v: 1}
    c: i64 = 2
    if c > 1:
        sink(move t)
    else:
        pass
    return t.v.i32()
