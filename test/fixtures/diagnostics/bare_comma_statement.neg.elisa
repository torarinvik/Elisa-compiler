# `a, b` with no assignment operator is not a statement. stage0 refuses the COMMA itself and
# then names the token after it; stage1 reported one generic `unexpected token near "a"` at
# the statement head -- pointing at the one token on the line that was fine.
def sum() -> i64:
    a: i64 = 1
    b: i64 = 2
    a, b
    return a + b
