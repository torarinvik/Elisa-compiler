error Problem:
    First
    Second

def fallible(flag: i32) -> i64 error[Problem]:
    raise Problem.First if flag == 1
    raise Problem.Second if flag == 2
    return 42

def relay(flag: i32) -> i64:
    catch fallible(flag):
        _:
            return 7
        error failure:
            return 1 if failure == Problem.First else 2
