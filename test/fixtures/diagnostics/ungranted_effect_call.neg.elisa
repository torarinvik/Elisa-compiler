def g() -> void can[Abort.Panic]:
    can Abort.Panic:
        panic("x")

def caller() -> void:
    can Abort.Panic:
        g()


# A parameter shadowing a top-level effect-declaring function: the call resolves to the
# param, not the effectful `g`, so no grant is required (FP guard, agent-found).
def shadowed(g: fn() -> void) -> void:
    g()
