# A bulk copy into a darray whose element holds a linear handle duplicates every
# handle; stage0 rejects `extend` and a bulk `push` (a list literal, or a whole
# container of the element), and names query-expression iteration as such.
# stage0 lines: 23 extend, 25 + 27 + 30 bulk push, 33 extend Pair, 34 + 35 query.
affine struct Handle:
    v: i64
struct Pair:
    a: Handle
def drain(xs: darray[Handle]) -> i64:
    total: mutable i64 = 0
    for x in move xs:
        total <- total + x.v
    return total
def drain_nested(ts: darray[darray[Handle]]) -> i64:
    total: mutable i64 = 0
    for t in move ts:
        total <- total + drain(move t)
    return total
def main() -> i32:
    xs: mutable darray[Handle] = []
    ys: mutable darray[Handle] = []
    h: Handle = Handle{v: 1}
    ys.extend(xs)
    arr: Handle[1] = [Handle{v: 2}]
    ys.push(move arr)
    zs: mutable darray[Handle] = []
    zs.push([move h])
    t: mutable darray[darray[Handle]] = []
    u: darray[darray[Handle]] = []
    t.push(u)
    ps: mutable darray[Pair] = []
    qs: darray[Pair] = []
    ps.extend(qs)
    a: darray[i64] = x.v for each x in xs
    c: bool = any x in xs where x.v > 0
    for p in move ps:
        pass
    for q in move qs:
        pass
    return (drain(move xs) + drain(move ys) + drain(move zs) + drain_nested(move t) + drain_nested(move u)).i32()
