# Valid counterpart: a cstr key, which HAS value equality, read through an index.
# A READ, not a `d[k] <- v` write: stage0 rejects every dict index-assign with
# "cannot assign int to mutable i64&?" (the index yields an optional reference), a
# separate gap stage1 does not yet report — so a write could not serve as the
# "valid program" side of this pair.
def f(k: cstr) -> void:
    d: mutable dict[cstr, i64] = {}
    v: i64 = d[k]
    _ = v
    _ = d
