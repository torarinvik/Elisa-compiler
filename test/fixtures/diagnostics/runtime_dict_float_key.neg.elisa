# Valid counterpart: a cstr key, which HAS value equality, read through an index.
# A READ through `get … else`: `d[k]` yields an optional reference to the value (absent
# for a missing key), so both a plain `v: i64 = d[k]` and a `d[k] <- v` write are
# rejected by both compilers and could not serve as the "valid program" side of this pair.
def f(k: cstr) -> void:
    d: mutable dict[cstr, i64] = {}
    v: i64 = get d[k] else 0
    _ = v
    _ = d
