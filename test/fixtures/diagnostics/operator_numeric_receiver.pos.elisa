# The operator walk descended into a call's ARGUMENTS but never into its CALLEE, so an
# operand error under a method receiver — the common `(a - b).i32()` cast spelling — and
# one inside an array or struct literal reached the backend, which declined the whole
# function instead of naming the operands.
struct B:
    v: i32

def main() -> i32:
    s: sview = "a"
    n: i32 = 1
    ys: array[i32, 2] = [s - n, 0]
    b: B = B{v: (s - n).i32()}
    return ys[0] + b.v + (s - n).i32()
