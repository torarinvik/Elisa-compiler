# MUST fire FlowFlagStateMachine: `flag` is a mutable bool written only inside two
# distinct branch statements and read after the join — the docs/125 flow-flag shape.
def probe(x: i64) -> bool:
    return x > 1


def scan(x: i64) -> i64:
    flag: mutable bool = false
    if probe(x):
        flag <- true
    if probe(x + 1):
        flag <- true
    if flag:
        return 1
    return 0
