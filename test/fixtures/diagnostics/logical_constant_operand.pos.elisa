def f(x: bool) -> bool:
    return x and true

def expression_match_guard(n: i64) -> bool:
    return match n:
        0 if n > 0 and true: n > 0 or false
        _: true

def statement_match_guard(n: i64) -> i64:
    match n:
        0 if n > 0 or false:
            return 1 if n > 0 and true
        _:
            return 0
    return 0

error Problem:
    First
    Second

def fallible(flag: bool) -> i64 error[Problem]:
    raise Problem.First if flag
    return 0

def catch_guard(n: i64) -> i64:
    return catch fallible(n > 0 or false):
        value:
            value
        error failure if n > 0 and true:
            return 1 if n > 0 or false
        error other:
            return 0
