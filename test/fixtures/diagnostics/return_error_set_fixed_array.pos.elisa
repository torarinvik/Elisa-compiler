# The fixed-array shape wall builds its sentence with push_int, so the suffix has its
# own insertion point there.
error Bad:
    Neg

def four() -> i64[4] error[Bad]:
    can Memory.Allocate, Abort.Panic:
        ys: i64[3] = [1, 2, 3]
        return ys

def main() -> i32:
    can Memory.Allocate, Abort.Panic:
        return 0
