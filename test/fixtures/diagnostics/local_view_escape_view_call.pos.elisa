# corpus: deliberate-decline
# DELIBERATE DEVIATION: stage0 accepts this (hidden arena keeps the dstr alive); stage1 gives a
# view-typed return no hidden arena, so the local dstr is freed and the view reads freed memory
# (measured: returns 0 instead of 65). Stage1 rejects it on purpose.
def mk() -> sview:
    can Memory.Allocate:
        d: mutable dstr = [65, 66]
        return d.as_sview()

def main() -> i32:
    s: sview = mk()
    return s[0].i32()
