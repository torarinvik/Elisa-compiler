# `STATEMENT if not:` with indented conditions runs the statement unless every line
# holds, for every postfix guard: return, continue, break, raise and `<-`.
error Bad:
    Odd

def positive_even(x: i64) -> bool:
    return false if not:
        x > 0
        x % 2 == 0
    true

def count_small_even(limit: i64) -> i64:
    found: mutable i64 = 0
    for value in 0..<limit |found|:
        continue if not:
            value % 2 == 0
            value < 6
        found <- found + 1
    found

def first_gap(limit: i64) -> i64:
    seen: mutable i64 = 0
    for value in 0..<limit |seen|:
        break if not:
            value < 3
            value >= 0
        seen <- seen + 1
    seen

def checked(x: i64) -> i64 error[Bad]:
    raise Bad.Odd if not:
        x % 2 == 0
    x

def clamp(x: i64) -> i64:
    result: mutable i64 = x
    result <- 0 if not:
        x >= 0
        x <= 100
    result

def main() -> i32:
    a: i64 = 1 if positive_even(4) else 0
    b: i64 = 1 if positive_even(3) else 0
    c: i64 = 1 if positive_even(-2) else 0
    d: i64 = count_small_even(10)
    e: i64 = first_gap(10)
    f: i64 = try checked(4) else 99
    g: i64 = try checked(5) else 99
    h: i64 = clamp(50) + clamp(500)
    (a * 1000000 + b * 100000 + c * 10000 + d * 1000 + e * 100 + (f + g + h)).i32()
