# A typed `x: i64 = 100` inside a value block DECLARES a block-local shadow; the outer `x` is
# untouched, so this is not an E4 mutation. (An untyped `x = 100` here is rejected as a silent
# shadow; see untyped_nested_shadow.neg.elisa.)
def f(n: i64) -> i64:
    x: i64 = n
    y: i64 =
        x: i64 = 100
        x + 1
    return x + y
