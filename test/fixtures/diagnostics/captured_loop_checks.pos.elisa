# A loop with a `|...|` capture header parses as a statement-position block expression.
# Every statement-level check must still see the statements inside it (stage0 does).
affine struct Handle:
    v: i64

linear struct Ticket:
    v: i64

def sink(h: Handle) -> i64:
    return h.v

def close(t: Ticket) -> i64:
    v: i64 = t.v
    _ = move t
    return v

def move_required() -> i64:
    total: mutable i64 = 0
    while total < 3 |total|:
        t: Handle = Handle{v: 1}
        total <- total + sink(t)
    return total

def mutate_iterated() -> i64:
    xs: mutable darray[i64] = [1, 2, 3]
    n: mutable i64 = 0
    for x in xs |n, xs|:
        xs.push(x)
        n <- n + 1
    return n

def linear_leak() -> i64:
    n: mutable i64 = 0
    while n < 2 |n|:
        k: Ticket = Ticket{v: 1}
        n <- n + 1
    return n

def use_after_move() -> i64:
    n: mutable i64 = 0
    while n < 1 |n|:
        u: Handle = Handle{v: 1}
        a: i64 = sink(move u)
        n <- n + u.v + a
    return n

def main() -> i32:
    return (move_required() + mutate_iterated() + linear_leak() + use_after_move()).i32()
