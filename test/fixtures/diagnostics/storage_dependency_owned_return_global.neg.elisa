# A fresh borrow-free result stays owned when its callee reads only a SCALAR global: a
# `usize` constant holds no buffer the result could share (elisa-proof cli.elisa, where the
# importer's path helper read a scalar buffer-size constant).
const LIMIT: usize = 4

def widen(path: darray[u8]&) -> darray[u8]:
    out: mutable darray[u8] = []
    out.push(path[0]) if path.count < LIMIT
    return out

def load(path: darray[u8]&, files: mutable darray[u8]&) -> darray[u8]:
    files.push(1)
    return widen(path)

def main() -> i32:
    path: darray[u8] = [97, 98]
    files: mutable darray[u8] = []
    got: mutable darray[u8] = load(&path, &files)
    source: mutable darray[u8] = []
    source <- got
    source.push(0)
    return (source.count + files.count).i32() - 3
