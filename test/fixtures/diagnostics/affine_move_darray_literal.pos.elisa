# A darray literal element takes ownership (stage0 says "darray literal element").
affine struct Handle:
    v: i64

struct Pair:
    a: Handle
    b: Handle

def main() -> i32:
    can Memory.Allocate:
        t: Handle = Handle{v: 1}
        xs: darray[Handle] = [t]
        for x in move xs:
            _ = move x
        return t.v.i32()
