# Drains that reach every element: exits that leave only an INNER loop, and a
# reversed drain and a filtered drain that run to completion.
struct Tracked:
    mark: i64

def sink(t: Tracked) -> void:
    _ = t.mark

def inner_exits() -> void:
    xs: mutable darray[Tracked] = []
    xs.push(Tracked{mark: 1})
    for x in move xs:
        for i in 0..<3:
            continue if i == 0
            break
        sink(move x)

def reversed_full() -> void:
    xs: mutable darray[Tracked] = []
    xs.push(Tracked{mark: 1})
    for x in rev(move xs):
        sink(move x)

# A filtered drain drains the whole container: the skipped elements are dropped.
def filtered_full() -> void:
    xs: mutable darray[Tracked] = []
    xs.push(Tracked{mark: 1})
    for x in move xs if x.mark > 0:
        sink(move x)

def main() -> i64:
    inner_exits()
    reversed_full()
    filtered_full()
    return 0
