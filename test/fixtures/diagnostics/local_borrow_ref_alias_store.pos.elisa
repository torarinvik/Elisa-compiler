# A local borrow stored THROUGH a reference local lands in the place that local names; storing
# that owner into a caller's storage then dangles once the function returns.

struct R:
    n: i64

struct A:
    begin: mutable R&?
    k: mutable i64

struct H:
    a: mutable A

def store_through_alias(h: mutable H&, r: R&) -> void:
    loc: R = R{n: 77}
    owner: mutable A = A{begin: r, k: 0}
    al: mutable A& = &owner
    al.begin <- &loc
    h.a <- owner

def store_through_rebound_alias(h: mutable H&, r: R&) -> void:
    loc: R = R{n: 77}
    owner: mutable A = A{begin: r, k: 0}
    other: mutable A = A{begin: r, k: 0}
    al: mutable A& = &owner
    al <- &other
    al.begin <- &loc
    h.a <- other

def store_through_alias_of_alias(h: mutable H&, r: R&) -> void:
    loc: R = R{n: 77}
    owner: mutable A = A{begin: r, k: 0}
    al: mutable A& = &owner
    al2: mutable A& = al
    al2.begin <- &loc
    h.a <- owner

def store_on_next_iteration(h: mutable H&, r: R&) -> void:
    loc: R = R{n: 77}
    owner: mutable A = A{begin: r, k: 0}
    al: mutable A& = &owner
    for i in 0 ..< 2:
        h.a <- owner
        al.begin <- &loc

def main() -> i32:
    return 0
