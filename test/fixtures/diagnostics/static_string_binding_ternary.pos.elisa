# Into an sview, a literal branch takes sview while a `static u8&` binding branch does not.
struct Label:
    text: sview

def take(v: sview) -> i64:
    return 1

def returned(n: i64) -> sview:
    s = "zero"
    return s if n == 0 else "many"

def declared(n: i64) -> i64:
    s = "zero"
    t: sview = "many" if n == 0 else s
    return 0

def argument(n: i64) -> i64:
    s = "zero"
    return take(s if n == 0 else "many")

def field(n: i64) -> Label:
    s = "zero"
    return Label{text: s if n == 0 else "many"}
