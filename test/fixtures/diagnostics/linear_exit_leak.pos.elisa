# A linear local still live when control leaves its scope early -- `continue`,
# `break`, `return` (also from inside a loop or a match arm) -- is dropped
# without being consumed. Both compilers used to accept every one of these.
linear struct Guard:
    v: i64
def make() -> Guard:
    return Guard{v: 1}
def release(g: Guard) -> void:
    _ = move g
def leak_continue(n: i64) -> void:
    for i in 0..<3:
        g: Guard = make()
        if i == n:
            continue
        release(move g)
def leak_break(n: i64) -> void:
    for i in 0..<3:
        g: Guard = make()
        if i == n:
            break
        release(move g)
def leak_return(n: i64) -> void:
    g: Guard = make()
    if n == 0:
        return
    release(move g)
def leak_return_in_loop(n: i64) -> void:
    for i in 0..<3:
        g: Guard = make()
        if i == n:
            return
        release(move g)
def leak_return_in_arm(n: i64) -> i64:
    g: Guard = make()
    match n:
        0:
            return 0
        _:
            release(move g)
    return 1
def main() -> i32:
    return 0
