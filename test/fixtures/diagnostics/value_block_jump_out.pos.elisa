# docs/119 E5: `break` inside a value `if` would leave the value block for the outer loop.
def f(xs: darray[i64]) -> i64:
    total: mutable i64 = 0
    for x in xs:
        v: i64 =
            if x > 3:
                x
            else:
                break
        total <- total + v
    return total
