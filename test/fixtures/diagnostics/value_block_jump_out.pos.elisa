# docs/119 E5: a block with a `|capture|` header writes its captures back only when it ends,
# so `continue` may not leave it for the outer loop.
def f(xs: darray[i64]) -> i64:
    total: mutable i64 = 0
    count: mutable i64 = 0
    for x in xs:
        v: i64 = |count|
            count <- count + 1
            continue if x > 3
            x
        total <- total + v
    return total
