# Comprehensions over plain values, and comprehensions that MAKE fresh handles, are fine.
affine struct Handle:
    v: i64

def make(i: i64) -> Handle:
    return Handle{v: i}

def release(h: Handle) -> i64:
    return h.v

def drain(xs: darray[Handle]) -> i64:
    total: mutable i64 = 0
    for x in move xs:
        total <- total + release(move x)
    return total

def main() -> i32:
    ints: darray[i64] = [1, 2, 3]
    doubled: darray[i64] = [x * 2 for x in ints]
    evens: darray[i64] = [x for x in ints if x > 1]
    made: darray[Handle] = [make(i) for i in 0..<2]
    total: i64 = doubled.count.i64() + evens.count.i64() + drain(move made)
    return total.i32()
