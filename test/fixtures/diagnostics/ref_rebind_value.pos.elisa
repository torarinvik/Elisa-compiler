# Rule R: `mutable r:` makes the SLOT rebindable; only the TYPE's `mutable` writes through.
# `r` is `i64&`, so `r <- 5` is a rebind that needs a reference, and the note says why the
# binding's `mutable` does not help.
def main() -> i32:
    x: mutable i64 = 1
    mutable r: i64& = &x
    r <- 5
    return x.i32()
