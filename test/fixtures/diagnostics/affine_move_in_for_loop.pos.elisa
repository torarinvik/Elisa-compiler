# corpus: deliberate-decline — stage0 accepts this double move (B8).
# `move t` in a loop body consumes the outer `t` again on every iteration.
affine struct Handle:
    v: i64

def sink(h: Handle) -> i64:
    return h.v

def main() -> i32:
    t: Handle = Handle{v: 1}
    total: mutable i64 = 0
    for i in 0..<3 |total|:
        total <- total + sink(move t)
    return total.i32()
