# Borrowing is fine when the pointee holds no linear handle by value: an element REFERENCE,
# a plain container, a declared owner itself, or an owner-free generic instance.
affine struct Handle:
    v: i64

struct Other:
    n: i64

struct Box[T]:
    x: T

def by_element_refs(xs: darray[Handle&]) -> i64:
    return 0

def by_plain(xs: darray[Other]&) -> i64:
    return 0

def by_owner(h: Handle&) -> i64:
    return h.v

def by_plain_generic(b: Box[i64]&) -> i64:
    return 0

def by_fixed_plain(xs: i64[3]&) -> i64:
    return 0

def main() -> i32:
    return 0
