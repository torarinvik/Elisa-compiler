# An explicitly caller-region-backed local may be returned when its lifetime matches `@r`.
def keep[@r](anchor: i64& @r) -> darray[i64] @r:
    values: mutable darray[i64] @r = []
    values.push(7)
    return move values

# A separate function with a same-name local must not poison this @r local's lookup.
def keep_after_shadow[@r](anchor: i64& @r) -> darray[i64] @r:
    values: mutable darray[i64] @r = []
    values.push(7)
    return move values

# Both allocations belong to the same caller region, so moving one is safe.
def keep_moved[@r](anchor: i64& @r) -> darray[i64] @r:
    values: mutable darray[i64] @r = []
    donor: mutable darray[i64] @r = [7]
    values <- move donor
    return move values

# An inferred local shadow must not inherit the enclosing binding's pin.
def keep_shadowed[@r](anchor: i64& @r, choose: bool) -> darray[i64] @r:
    values: mutable darray[i64] @r = []
    if choose:
        values: mutable darray[i64] = []
        donor: mutable darray[i64] = [7]
        values <- move donor
    return move values

# A view with the same caller lifetime as its container remains safe.
def keep_region_view[@r](anchor: i64& @r, view: sview @r) -> darray[sview] @r:
    values: mutable darray[sview] @r = [view]
    return move values
