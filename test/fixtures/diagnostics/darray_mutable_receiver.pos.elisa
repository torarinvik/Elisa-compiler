# A builtin darray method that writes its receiver in place (push, pop, extend,
# reserve, resize, clear, truncate, as_cstr) needs a writable receiver: a plain
# `T&` is readonly, and a field must be `mutable` on a writable path.
struct Bag:
    items: darray[i64]
struct RefHolder:
    r: darray[i64]&
def f_pop(b: mutable Bag&) -> i64:
    v: i64? = b.items.pop()
    return 0
def f_clear(b: mutable Bag&) -> void:
    b.items.clear()
def f_extend(b: mutable Bag&, extra: darray[i64]&) -> void:
    b.items.extend(extra)
def f_reserve(b: mutable Bag&) -> void:
    b.items.reserve(8)
def f_ref_push(xs: darray[i64]&) -> void:
    xs.push(1)
def f_ref_truncate(xs: darray[i64]&) -> void:
    xs.truncate(0)
def f_rebindable(mutable xs: darray[i64]&) -> void:
    xs.push(1)
def f_ref_field(h: RefHolder) -> void:
    h.r.push(1)
def f_cstr(bs: darray[u8]&) -> void:
    c: cstr = bs.as_cstr()
def f_local_ref(xs: mutable darray[i64]&) -> void:
    r: darray[i64]& = xs
    r.clear()
def main() -> i32:
    return 0
