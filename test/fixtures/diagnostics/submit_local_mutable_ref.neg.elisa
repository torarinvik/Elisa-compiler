# Plain values and views are copied into the task's payload.
def twice(x: i64) -> i64:
    return x * 2

def first(s: sview) -> i64:
    return s[0].i64()

def main() -> i64:
    can Parallel, Memory.Allocate, Abort.Panic:
        count: i64 = 3
        buf: mutable darray[u8] = [65.u8()]
        nursery workers(2):
            submit twice(count)
            submit first(buf.as_sview())
        return 0
