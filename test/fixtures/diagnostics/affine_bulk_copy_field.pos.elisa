# Bulk copies whose receiver or source is a struct field: the field's declared type
# resolves like a local's, so `b.items.extend(xs)` and `[...b.items]` are the same bulk
# copies of linear handles as their local spellings. stage0 lines: 23 extend, 24 bulk
# push, 25 spread, 26 nested-field spread.
affine struct Handle:
    v: i64
struct Bag:
    items: mutable darray[Handle]
struct Shelf:
    bag: mutable Bag
def take(h: Handle) -> i64:
    return h.v
def drain(xs: darray[Handle]) -> i64:
    total: mutable i64 = 0
    for x in move xs:
        total <- total + take(move x)
    return total
def main() -> i32:
    b: mutable Bag = Bag{items: []}
    s: mutable Shelf = Shelf{bag: Bag{items: []}}
    more: mutable darray[Handle] = []
    extra: mutable darray[Handle] = []
    b.items.extend(more)
    s.bag.items.push(b.items)
    ys: darray[Handle] = [...b.items]
    zs: darray[Handle] = [...s.bag.items]
    return (drain(move more) + drain(move extra) + drain(move ys) + drain(move zs) + drain(move b.items) + drain(move s.bag.items)).i32()
