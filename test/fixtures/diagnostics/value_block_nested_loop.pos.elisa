# A captured statement loop nested in a value block still may not mutate a binding
# from outside the value block (docs/119 E4); the loop's own header captures do
# not exempt it (stage0 reports `outer` even under `|outer|`).
def plain(xs: darray[i64]) -> i64:
    outer: mutable i64 = 0
    x: i64 =
        n: mutable i64 = 0
        for v in xs |n|:
            outer <- outer + v
        7
    return x + outer

def captured(xs: darray[i64]) -> i64:
    total: mutable i64 = 0
    x: i64 =
        for v in xs |total|:
            total <- total + v
        7
    return x + total

def nested(xs: darray[i64]) -> i64:
    deep: mutable i64 = 0
    x: i64 =
        for v in xs |v|:
            for w in xs |w|:
                deep <- deep + w
        7
    return x + deep

def method(xs: darray[i64]) -> i64:
    ys: mutable darray[i64] = []
    x: i64 =
        for v in xs |v|:
            ys.push(v)
        7
    return x + ys.count.i64()
