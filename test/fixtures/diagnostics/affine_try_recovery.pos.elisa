# A `try ... else` recovery is a branch taken on the error path: a fallback that
# moves makes the value may-consumed, and a recovery that continues is a back edge.
error E:
    Bad
affine struct Handle:
    v: i64
def take(h: Handle) -> i64:
    return h.v
def step(n: i64) -> i64 error[E]:
    raise E.Bad if n < 0
    return n
def block_continue_repeat(n: i64) -> i64 error[E]:
    h: Handle = Handle{v: 1}
    acc: mutable i64 = 0
    for i in 0..<3 |acc|:
        v: i64 = try step(i) else err:
            acc <- take(move h)
            continue
        acc <- acc + v
    return acc
def value_fallback_consumes(n: i64) -> i64 error[E]:
    h: Handle = Handle{v: 1}
    v: i64 = try step(n) else take(move h)
    return v + take(move h)
def main() -> i32:
    return 0
