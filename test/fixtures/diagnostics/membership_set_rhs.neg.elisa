# `set` is the ONE container that IS a valid membership right-hand side — it is what the
# operator is for. stage1 flagged every Container, so it rejected these valid programs.
def f(a: i64, b: cstr, c: bool, d: char) -> void:
    ia: mutable set[i64] = {}
    ib: mutable set[cstr] = {}
    ic: mutable set[bool] = {}
    id: mutable set[char] = {}
    _ = a in ia
    _ = b in ib
    _ = c in ic
    _ = d in id
    _ = ia
    _ = ib
    _ = ic
    _ = id
