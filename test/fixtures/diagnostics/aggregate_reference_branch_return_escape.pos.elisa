struct BorrowedBox:
    value: i64&

global stable: i64 = 2

def escapes_branch(condition: bool) -> BorrowedBox:
    local: i64 = 1
    borrowed: mutable BorrowedBox = BorrowedBox{value: &stable}
    if condition:
        borrowed <- BorrowedBox{value: &local}
    else:
        borrowed <- BorrowedBox{value: &stable}
    borrowed
