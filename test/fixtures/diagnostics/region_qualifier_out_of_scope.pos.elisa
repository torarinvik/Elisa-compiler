# `@a` names a region whose block has already CLOSED. stage0:
#   unknown region qualifier "a"
#
# stage1 used to accept this: its scope test compared LINE ORDER only, so any region
# declared earlier in the FILE counted as in scope -- a closed sibling, or one belonging to
# a different function entirely. The annotation records the block's extent now.
def out_of_scope_region_qualifier() -> void can[Memory.Allocate, Abort.Panic]:
    region a(4096):
        pass
    region b(4096):
        values: mutable darray[i64] @a = []
        values.push(1)
