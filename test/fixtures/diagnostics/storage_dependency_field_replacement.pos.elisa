# corpus: deliberate-decline -- replacing a struct, or its darray field, releases the buffer an
# interior reference into that field points at; each read below would touch freed memory.

struct Bag:
    items: mutable darray[i64]
    n: i64

struct Outer:
    bag: mutable Bag
    k: i64

def whole_struct() -> i64:
    mutable s: Bag = Bag{items: [70, 2], n: 1}
    r: i64& = &s.items[0]
    s <- Bag{items: [1], n: 2}
    return r

def field_target() -> i64:
    mutable s: Bag = Bag{items: [70, 2], n: 1}
    r: i64& = &s.items[0]
    s.items <- [1]
    return r

def copied_view() -> i64:
    mutable s: Bag = Bag{items: [70, 2], n: 1}
    first: i64& = &s.items[0]
    r: i64& = first
    s <- Bag{items: [1], n: 2}
    return r

def nested_field(o: mutable Outer&) -> i64:
    fresh: Bag = Bag{items: [1], n: 2}
    r: i64& = &o.bag.items[0]
    o.bag <- fresh
    return r

def main() -> i32:
    mutable o: Outer = Outer{bag: Bag{items: [70, 2], n: 1}, k: 0}
    return (whole_struct() + field_target() + copied_view() + nested_field(&o)).i32()
