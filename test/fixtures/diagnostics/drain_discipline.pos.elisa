# A `for x in move xs` drain must reach every element: `break`, `continue` and
# `return` at the drain body's top level would skip the rest. `rev(move xs)` is
# the same drain walked backwards, and a filtered drain (`if`/`where`) is still a drain.
struct Tracked:
    mark: i64

def sink(t: Tracked) -> void:
    _ = t.mark

def skip_with_continue() -> void:
    xs: mutable darray[Tracked] = []
    xs.push(Tracked{mark: 1})
    for x in move xs:
        if x.mark == 1:
            sink(move x)
            continue
        sink(move x)

def reversed_break() -> void:
    xs: mutable darray[Tracked] = []
    xs.push(Tracked{mark: 1})
    for x in rev(move xs):
        sink(move x)
        break

def reversed_return() -> void:
    xs: mutable darray[Tracked] = []
    xs.push(Tracked{mark: 1})
    for x in rev(move xs):
        sink(move x)
        return

def filtered_break() -> void:
    xs: mutable darray[Tracked] = []
    xs.push(Tracked{mark: 1})
    for x in move xs if x.mark > 0:
        sink(move x)
        break

def filtered_reversed_continue() -> void:
    xs: mutable darray[Tracked] = []
    xs.push(Tracked{mark: 1})
    for x in rev(move xs) where x.mark > 0:
        continue if x.mark > 5
        sink(move x)

def main() -> i64:
    skip_with_continue()
    reversed_break()
    reversed_return()
    filtered_break()
    filtered_reversed_continue()
    return 0
