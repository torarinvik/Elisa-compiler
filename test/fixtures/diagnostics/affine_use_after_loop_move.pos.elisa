# A value a loop body consumed stays consumed after the loop (stage0 rejects `t.v`).
affine struct Handle:
    v: i64

def sink(h: Handle) -> i64:
    return h.v

def main() -> i32:
    t: Handle = Handle{v: 1}
    total: mutable i64 = 0
    while total < 3 |total|:
        total <- total + sink(move t)
    return t.v.i32()
