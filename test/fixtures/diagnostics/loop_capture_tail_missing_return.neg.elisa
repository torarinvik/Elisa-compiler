# A capture-carrying loop in TAIL position yields nothing, so the function falls through.
# stage1 wrapped it in a synthesized `return` over a NULL value: statement_terminates then
# saw a Return and stayed silent, and codegen handed LLVMTypeOf a null (SIGSEGV). Both
# compilers must reject this.
def f() -> i64:
    total: mutable i64 = 0
    for i in 0..<4 |total|:
        total <- total + i
