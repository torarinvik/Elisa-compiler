# A body local that redeclares a parameter is a duplicate local even when the
# body calls a region-polymorphic helper in a loop. Stage0 wraps such a body
# in a synthesized region block, which used to hide the error (Stage1 always
# reported it).
struct Affine:
    scale: mutable i64

struct Aggregate:
    forward: mutable Affine

def identity() -> Affine:
    result: mutable Affine
    result

def compose(after: Affine, before: Affine) -> Affine:
    after

def range_of(tree: view[Aggregate], low: usize) -> Aggregate:
    tree[low]

def path(tree: view[Aggregate], head: view[usize], to_value: usize) -> Affine:
    right: mutable Affine = identity()
    to_value: mutable usize = to_value
    while head[to_value] != 0:
        part: Aggregate = range_of(tree, to_value)
        right <- compose(right, part.forward)
        to_value <- head[to_value]
    right

def main() -> i32:
    0
