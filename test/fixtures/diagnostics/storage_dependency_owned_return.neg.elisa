# A fresh borrow-free result (only scalar fields, transitively) returned by value owns its
# storage: growing the argument the callee read does not invalidate it, even across a loop
# back edge (the codegen_call_receiver.elisa ufcs_chosen_args shape).
struct Kind:
    bits: u32

struct Scope:
    names: mutable darray[sview]

def infer(slot: i64, sc: mutable Scope&) -> darray[Kind]:
    sc.names.push("x")
    result: mutable darray[Kind] = []
    result.push(Kind{bits: 64}) if slot > 1
    return result

def pick(sc: mutable Scope&, n: i64) -> i64:
    chosen: mutable darray[Kind] = []
    for slot in 0..<n |chosen, sc|:
        candidate: darray[Kind] = infer(slot, sc)
        if candidate.count != 0:
            chosen <- candidate
    return chosen.count.i64()

def main() -> i32:
    sc: mutable Scope = Scope{names: []}
    return pick(&sc, 3).i32() - 1
