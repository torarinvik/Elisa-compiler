# The legal selector shapes must stay silent. A region owner block puts its binding
# into the resolver's scope set, so `new[scratch]` resolves like any identifier and
# no owner rule fires. This is the false-positive guard for the .pos case.
def h() -> i64:
    region scratch(1024):
        q: i64& @scratch = new[scratch] 7
        return q + 0
def k() -> bool:
    region other(256):
        m: i64& @other = new[other] 3
        return m > 0
