# A LEADING decorator on a struct field. The spelling is legal only inside an enum's
# `common:` block, so stage0 parses it and rejects it with one sentence. stage1's struct
# parser used to skip the `@` as an unknown token and then read the decorator NAME as the
# field name, turning one mistake into a four-error parse cascade.
struct P:
    @owner
    x: i32

    @align(8)
    y: i32

def main() -> i32:
    p: P = P{x: 1, y: 2}
    return p.x + p.y
