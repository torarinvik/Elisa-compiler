# difffuzz 2026-10-04: an indexed receiver `rows[i].f0 <- v` was checked only when its
# function was the LAST one some earlier pass walked (stale structural local-type channel),
# so the assignment below -- in a function that is NOT last -- was silently accepted.
struct P:
    f0: i64
    f1: mutable i64

def touch(n: i64) -> i64:
    rows: mutable darray[P] = [P{f0: 1, f1: 2}]
    rows[0].f0 <- n
    return rows[0].f0

def main() -> i64:
    return touch(5)
