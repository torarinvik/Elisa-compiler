# A `mutable T&` parameter must not alias another reference argument of the same call.
# `same` was a silent -fnoalias miscompile in both compilers: `a <- 1; b <- 2; return a`
# folded to 1 because the backend marks `a` noalias.
struct Pair:
    a: mutable i64
    b: mutable i64

def f(a: mutable i64&, b: mutable i64&) -> i64:
    a <- 1
    b <- 2
    return a

def read_write(a: mutable i64&, b: i64&) -> i64:
    a <- 1
    return b

def grow(v: mutable darray[i64]&, first: i64&) -> i64:
    v.push(1)
    return first

def whole(p: mutable Pair&, a: i64&) -> i64:
    p.a <- 3
    return a

def same() -> i64:
    x: mutable i64 = 0
    return f(&x, &x)

def mixed() -> i64:
    y: mutable i64 = 0
    return read_write(&y, &y)

def element() -> i64:
    v: mutable darray[i64] = [1, 2]
    return grow(&v, &v[0])

def field_prefix() -> i64:
    p: mutable Pair = Pair{a: 1, b: 2}
    return whole(&p, &p.a)

def same_field() -> i64:
    q: mutable Pair = Pair{a: 1, b: 2}
    return f(&q.a, &q.a)

def runtime_index(i: i64, j: i64) -> i64:
    w: mutable darray[i64] = [1, 2]
    return f(&w[i], &w[j])

def nested_arg() -> i64:
    z: mutable i64 = 0
    return 1 + f(&z, &z)

def ref_param(r: mutable i64&) -> i64:
    return f(r, r)

# A ref local initialised from `&PLACE` (typed, untyped, or chained through another
# typed ref local) names that place: both compilers emitted `ret 1` for `typed_local`.
def typed_local() -> i64:
    s: mutable i64 = 0
    r: mutable i64& = &s
    return f(r, &s)

def untyped_local() -> i64:
    u: mutable i64 = 0
    r = &u
    return f(r, &u)

def chained() -> i64:
    t: mutable i64 = 0
    r1: mutable i64& = &t
    r2: mutable i64& = r1
    return f(r2, &t)

def element_local() -> i64:
    vv: mutable darray[i64] = [1, 2]
    e: i64& = &vv[0]
    return grow(&vv, e)

# Uniform call syntax passes the receiver as the first argument: `c.poke(&c.v)` returned
# 11 instead of 22 (with `m.f(&m)`) under -O2 -fnoalias in both compilers.
struct Cell:
    v: mutable i64

def poke(self: mutable Cell&, other: mutable i64&) -> i64:
    self.v <- 1
    other <- 2
    return self.v

def method_receiver() -> i64:
    c: mutable Cell = Cell{v: 0}
    m: mutable i64 = 0
    return c.poke(&c.v) * 10 + m.f(&m)

def main() -> i32:
    return (same() + mixed() + element() + field_prefix() + same_field() + runtime_index(0, 1) + nested_arg() + typed_local() + untyped_local() + chained() + element_local() + method_receiver()).i32()
