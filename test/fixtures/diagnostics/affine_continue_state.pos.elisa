# The state at a `continue` is a second back edge: a value consumed there and
# live on loop entry is consumed again by the next iteration, and a
# reinitialization after the `continue` does not happen on that path.
affine struct Handle:
    v: i64
def take(h: Handle) -> i64:
    return h.v
def reinit_skipped_by_continue(n: i64) -> i64:
    h: mutable Handle = Handle{v: 1}
    acc: mutable i64 = 0
    for i in 0..<3 |acc, h|:
        acc <- acc + take(move h)
        if i == n:
            continue
        h <- Handle{v: 2}
    return acc + take(move h)
def main() -> i32:
    return 0
