# `&xs` on a value holding linear handles: stage0 refuses the address wherever it sits.
affine struct Handle:
    v: i64

struct Box[T]:
    item: T

struct Holder:
    xs: darray[Handle]
    d: dict[i64, Handle]

def peek[T](x: T&) -> i64:
    return 0

def release(h: Handle) -> i64:
    return h.v

def main() -> i32:
    xs: mutable darray[Handle] = []
    a = &xs
    n: mutable i64 = peek(&xs)
    _ = a
    for x in move xs:
        _ = release(move x)
    d: mutable dict[i64, Handle] = {}
    n <- n + peek(&d)
    ys: mutable darray[darray[Handle]] = []
    n <- n + peek(&ys)
    oh: mutable Handle? = null
    n <- n + peek(&oh)
    bx: mutable Box[Handle] = Box[Handle]{item: Handle{v: 2}}
    n <- n + peek(&bx)
    o: mutable Holder = Holder{xs: [], d: {}}
    n <- n + peek(&o.xs)
    c = &o.d
    _ = c
    for y in move ys:
        for x in move y:
            _ = release(move x)
    held: mutable darray[Handle] = move o.xs
    for x in move held:
        _ = release(move x)
    return n.i32()
