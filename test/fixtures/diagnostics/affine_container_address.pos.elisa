# `&xs` on a container of linear handles: stage0 refuses the address wherever it sits.
affine struct Handle:
    v: i64

def peek[T](x: T&) -> i64:
    return 0

def release(h: Handle) -> i64:
    return h.v

def main() -> i32:
    xs: mutable darray[Handle] = []
    a = &xs
    n: i64 = peek(&xs)
    _ = a
    for x in move xs:
        _ = release(move x)
    return n.i32()
