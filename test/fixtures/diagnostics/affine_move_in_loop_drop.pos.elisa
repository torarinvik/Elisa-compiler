# corpus: deliberate-decline — stage0 accepts this; built and run it calls __drop__ 3 times
# on one value (exit 31 = 3 drops, total 1), the double-fclose shape of B8.
global mutable drops: i64 = 0

struct Tracked:
    mark: i64

def __drop__(self: Tracked) -> void:
    drops <- drops + 1

def sink(h: Tracked) -> i64:
    return h.mark

def main() -> i64:
    t: Tracked = Tracked{mark: 1}
    total: mutable i64 = 0
    for i in 0..<3 |total|:
        total <- total + sink(move t)
    return drops * 10 + total
