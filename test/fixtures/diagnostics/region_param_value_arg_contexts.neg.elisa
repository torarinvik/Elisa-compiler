# A by-value argument for an explicit `[@r]`-tied ref parameter, in every context
# stage0 reports it: expression, global and const arguments, return and value
# positions, nested expressions, if bodies, struct literals (also module-qualified),
# and caller-bound regions (own `[@r]`, `in perm:`, `region r:`), where stage0
# prints only the argument mismatch. A different caller region (`[@q]`, `region q:`)
# still cannot infer `r`.
struct S:
    n: mutable usize
def get[@r](s: mutable S& @r) -> usize:
    return s.n
def getv[@r](s: S& @r) -> usize:
    return s.n
module M:
    struct T:
        a: usize
    def h[@r](t: T& @r) -> usize:
        return t.a
global mutable g: S = S{n: 0}
const c: S = S{n: 0}
def literal() -> usize:
    return getv(S{n: 0})
def globals() -> usize:
    get(g)
    return getv(c)
def positions() -> usize:
    x: mutable S = S{n: 0}
    k: usize = get(x)
    if k == 0:
        get(x)
    return 1 + get(x)
def module_literal() -> usize:
    return M::h(M::T{a: 1})
def caller_bound[@r](s: mutable S& @r) -> usize:
    q: mutable S = S{n: 0}
    return get(q)
def caller_other[@q](s: mutable S& @q) -> usize:
    q: mutable S = S{n: 0}
    return get(q)
def perm_outer() -> usize:
    x: mutable S = S{n: 0}
    in perm:
        get(x)
    return 0
def region_same() -> usize:
    region r:
        q: mutable S = S{n: 0}
        get(q)
    return 0
def region_other() -> usize:
    region q:
        x: mutable S = S{n: 0}
        get(x)
    return 0
def main() -> i32:
    return 0
