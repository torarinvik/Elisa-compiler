# An explicit region ends before the returned view can be used.
struct HU:
    bytes: mutable darray[u8]

def mk() -> sview:
    region scratch(64):
        h: mutable HU = HU{bytes: [65.u8(), 65.u8()]}
        v: sview = h.bytes.as_sview()
        return v

def main() -> i64:
    w: sview = mk()
    return w[0].i64()
