# stage0 does not read a `bool&` through as a condition: the elisa-proof proof_goal_cached
# shape `return x if exhausted` is "if condition must be bool, got mutable bool&" (as are
# `if`, `while` and a ternary on the bare reference).
def probe(x: i64, exhausted: mutable bool&) -> i64:
    return x

def cached(x: i64, exhausted: mutable bool&) -> i64:
    return probe(x, exhausted) if exhausted
    if exhausted:
        return 1
    while exhausted |exhausted|:
        exhausted <- false
    return 3 if exhausted else 4

def main() -> i32:
    flag: mutable bool = true
    return cached(1, &flag).i32()
