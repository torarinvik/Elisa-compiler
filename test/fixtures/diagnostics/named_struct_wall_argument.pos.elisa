# An ARGUMENT against a struct-typed parameter -- literal and firm. Both walls that own
# arguments used to bail on a non-primitive parameter, so all of these were silent.
struct P:
    a: i64

def sink(v: P) -> void:
    pass

def f() -> void:
    can Memory.Allocate, Abort.Panic:
        u: u8 = 1
        sink(5)
        sink(u)
        sink("s")
