# The states line up: a `Holder[&]` local into a `Holder[&]` parameter, a `Holder[&]` into
# a `Holder[?]` parameter (`?` accepts anything), and a bare local into `Holder[?]`.
struct Holder[?]:
    value: i32

def read(value: Holder[&]) -> i32:
    return value.value

def peek(value: Holder[?]) -> i32:
    return 1

def main() -> i64:
    h: Holder[&] = Holder{value: 41}
    bare: Holder = Holder{value: 2}
    return read(h).i64() + peek(h).i64() + peek(bare).i64()
