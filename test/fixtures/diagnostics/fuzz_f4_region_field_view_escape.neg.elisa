# Control for fuzz F4: reading a region-block struct's field and copying a scalar out is fine.
struct HU:
    bytes: mutable darray[u8]

def main() -> i64:
    kept: mutable i64 = 0
    region rg(4096):
        h: mutable HU = HU{bytes: [65.u8(), 65.u8()]}
        kept <- h.bytes.count.i64()
    return kept
