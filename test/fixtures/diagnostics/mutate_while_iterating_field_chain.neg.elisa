# Mutating a DIFFERENT field, a different owner's field of the same name, or an element in
# place leaves the iterated buffer alone; growing after the loop is fine.
struct Bag:
    items: mutable darray[i64]
    other: mutable darray[i64]
    total: mutable i64

def sibling(b: mutable Bag&, t: Bag&) -> void:
    for v in b.items:
        b.other.push(v)
        b.other += v
        b.other <- t.other
        b.total <- b.total + v

def other_owner(b: Bag&, c: mutable Bag&) -> void:
    for v in b.items:
        c.items.push(v)

def element_store(b: mutable Bag&) -> void:
    for v in b.items:
        b.items[0] <- v

def after_loop(b: mutable Bag&) -> void:
    for v in b.items:
        b.total <- v
    b.items.push(1)

def main() -> i32:
    return 0
