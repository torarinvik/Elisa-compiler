# A same-line generic function must not make this plain struct or its fresh-result helper
# look generic to the region storage dependency analysis.
#line 0 phantom.elisa
def phantom[T](value: T) -> T:
    return value

#line 0 kind.elisa
struct Kind:
    bits: u32

struct Scope:
    names: mutable darray[sview]

#line 0 infer.elisa
def infer(slot: i64, sc: mutable Scope&) -> darray[Kind]:
    sc.names.push("x")
    result: mutable darray[Kind] = []
    result.push(Kind{bits: 64}) if slot > 1
    return result

def pick(sc: mutable Scope&, n: i64) -> i64:
    chosen: mutable darray[Kind] = []
    for slot in 0..<n |chosen, sc|:
        candidate: darray[Kind] = infer(slot, sc)
        if candidate.count != 0:
            chosen <- candidate
    return chosen.count.i64()

def main() -> i32:
    sc: mutable Scope = Scope{names: []}
    return pick(&sc, 3).i32() - 1
