struct Point:
    a: i64

enum Color:
    Red
    Green

def copy_struct(source: Point&) -> i64:
    copied: Point = source
    copied.a

def copy_enum(source: Color&) -> Color:
    source

def copy_view(source: sview&) -> sview:
    source

def copy_list(source: darray[i64]&, target: mutable darray[i64]) -> i64:
    target <- source
    target.count.i64()
