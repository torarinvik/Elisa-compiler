# The adjacent case the write-through fix must NOT loosen: the callee returns a READONLY
# reference, so `r <- 99` is a write through a readonly ref and stays rejected.
global mutable g: i64 = 42

def get_readonly_ref() -> i64&:
    return &g

def main() -> i64:
    r: i64& = get_readonly_ref()
    r <- 99
    return g
