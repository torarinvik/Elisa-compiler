# The control: `=> EXPR` is the expression body that replaced the inline `:` form, in
# argument position and bound to a local. Both accepted.
def apply(step: fn(i64) -> i64, value: i64) -> i64:
    return step(value)

def run(value: i64) -> i64:
    add_two: fn(i64) -> i64 = fn(v: i64) => v + 2
    return apply(fn(v: i64) => v + 1, value) + apply(add_two, value)
