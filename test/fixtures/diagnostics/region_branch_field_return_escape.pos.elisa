struct Box:
    values: darray[i64]
    value: i64

def leak_from_branch(should_return: bool) -> darray[i64] can[Memory.Allocate, Abort.Panic]:
    region scratch(4096):
        values: mutable darray[i64] = []
        values.push(41)
        box: Box = Box{values: values, value: 7}
        if should_return:
            return box.values
        return []
