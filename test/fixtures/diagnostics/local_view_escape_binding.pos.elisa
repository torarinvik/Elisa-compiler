# corpus: deliberate-decline -- stage0 ACCEPTS this and the program reads a dead frame; stage1
# rejects it on purpose (check_local_view_return_escape). Not a stage1 gap.
# A view of a frame-local fixed array returned through a local view binding.
def leak() -> view[i64]:
    a: i64[4] = [1, 2, 3, 4]
    v: view[i64] = a[0:4]
    return v

def main() -> i32:
    return leak()[1].i32()
