def leak_block() -> darray[i64] can[Memory.Allocate, Abort.Panic]:
    region scratch(4096):
        values: mutable darray[i64] = []
        values.push(41)
        copied: darray[i64] =
            alias: darray[i64] = values
            alias
        return copied


def main() -> i64:
    return leak_block().count.i64()
