# Every move site with an explicit `move`, and a borrow stored in a `T&` field: all accepted.
affine struct Handle:
    v: i64

struct Pair:
    a: Handle
    b: Handle

struct Lens:
    h: Handle&

def sink(h: Handle) -> i64:
    return h.v

def view_of(t: Handle&) -> i64:
    l: Lens = Lens{h: t}
    return l.h.v

def main() -> i32:
    can Memory.Allocate:
        t: Handle = Handle{v: 1}
        u: Handle = Handle{v: 2}
        seen: i64 = view_of(&t)
        p: Pair = Pair{a: move t, b: move u}
        q: (p: Pair, n: i64) = (move p, 1)
        w: Handle = Handle{v: 3}
        ws: mutable darray[Handle] = []
        ws.push(move w)
        for x in move ws:
            _ = move x
        z: Handle = Handle{v: 4}
        return (sink(move z) + seen - 5).i32()
