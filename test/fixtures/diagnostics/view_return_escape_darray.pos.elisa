# A view of a local darray returned from a clause block: the buffer lives in the call's inferred
# region, freed on return. stage0 rejects this (`via return` region escape); stage1 accepted it
# and the caller read freed memory.
def leak() -> view[i64]:
    can Memory.Allocate:
        xs: mutable darray[i64] = []
        xs.push(1)
        xs.push(2)
        return xs[0:2]

def main() -> i32:
    return leak()[1].i32()
