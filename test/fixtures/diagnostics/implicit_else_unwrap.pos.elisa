# The control: the explicit spelling that replaced it, plus the two `else`s that are NOT
# the removed unwrap (a ternary's and a subscript default's under `get`). All accepted.
def fallback_value(maybe: i64?, xs: darray[i64], c: bool) -> i64:
    x: i64 = get maybe else return 0
    y: i64 = 1 if c else 2
    z: i64 = get xs[0] else 0
    return x + y + z
