# corpus: deliberate-decline -- each iteration grows `storage` and then stores a view into it
# in `held`. The first iteration's growth precedes the store, so only the NEXT iteration's
# growth makes the held view stale; the back edge must be walked again from the end-of-body
# state. stage0 rejects push_holder but misses call_holder (a view held through a callee push).
def consume(view: sview) -> i64:
    return 1

def keep(holder: mutable darray[sview]&, view: sview) -> void:
    holder.push(view)

def push_holder(n: i64) -> i64:
    storage: mutable darray[u8] = []
    held: mutable darray[sview] = []
    for i in 0..<n |storage, held|:
        storage.push(97)
        held.push(storage.as_sview())
    return consume(held[0])

def call_holder(n: i64) -> i64:
    storage: mutable darray[u8] = []
    held: mutable darray[sview] = []
    for i in 0..<n |storage, held|:
        storage.push(97)
        keep(&held, storage.as_sview())
    return consume(held[0])
