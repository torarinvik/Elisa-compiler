# A `mutable T&` to a caller local handed to a pool task is a stack reference shared across
# threads (stage0: argument to "pool_submit1" is not structurally shareable).
def bump(x: mutable i64&) -> i64:
    x <- x + 1
    return x

def main() -> i64:
    can Parallel, Memory.Allocate, Abort.Panic:
        count: mutable i64 = 0
        nursery workers(2):
            submit bump(&count)
        return count - 1

# A view of an array created inside a nursery cannot outlive that array's scope.
def nursery_local_view() -> i64:
    can Parallel, Memory.Allocate, Abort.Panic:
        nursery workers(2):
            local_bytes: mutable darray[u8] = [65.u8()]
            submit first_local_view(local_bytes.as_sview())
        return 0

def first_local_view(value: sview) -> i64:
    return value[0].i64()
