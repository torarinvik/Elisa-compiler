# A `mutable T&` to a caller local handed to a pool task is a stack reference shared across
# threads (stage0: argument to "pool_submit1" is not structurally shareable).
def bump(x: mutable i64&) -> i64:
    x <- x + 1
    return x

def main() -> i64:
    can Parallel, Memory.Allocate, Abort.Panic:
        count: mutable i64 = 0
        nursery workers(2):
            submit bump(&count)
        return count - 1
