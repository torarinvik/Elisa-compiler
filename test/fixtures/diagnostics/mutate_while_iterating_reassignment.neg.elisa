# Reassigning a DIFFERENT container, or the accumulator, inside the loop leaves the iterated
# buffer alone.

def main() -> i32:
    xs: darray[i64] = [70, 2]
    mutable ys: darray[i64] = []
    mutable total: i64 = 0
    for v in xs:
        total <- total + v
        ys <- [v]
    return (total + ys[0]).i32()
