# A labeled payload is named by its label, whether the argument is named or positional.
affine struct Handle:
    v: i64

enum Box:
    Full(Handle)
    Tagged(h: Handle, n: i64)
    Lent(Handle&)
    Empty

def named() -> i64:
    t: Handle = Handle{v: 1}
    b: Box = Box.Tagged(h: t, n: 2)
    return t.v

def positional() -> i64:
    u: Handle = Handle{v: 1}
    c: Box = Box.Tagged(u, 2)
    return u.v

def main() -> i32:
    return (named() + positional()).i32()
