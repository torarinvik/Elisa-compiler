# The forms stage0 ACCEPTS with a `mutable bool&` operand: a logical operand, an equality,
# and a copy into a bool local used as the condition.
def cached(x: i64, exhausted: mutable bool&, other: bool) -> i64:
    both: bool = exhausted and other
    return x if both
    return 2 if exhausted == true
    already: bool = exhausted
    return 3 if already
    return 4

def main() -> i32:
    flag: mutable bool = true
    return cached(1, &flag, true).i32()
