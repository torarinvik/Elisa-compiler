# Constructing an aggregate moves the affine local into the by-value field.
affine struct Handle:
    v: i64

struct Pair:
    a: Handle
    b: Handle

def build(t: Handle, u: Handle) -> Pair:
    return Pair{a: t, b: move u}

def main() -> i32:
    p: Pair = build(Handle{v: 1}, Handle{v: 2})
    return p.a.v.i32()
