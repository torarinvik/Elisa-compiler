# Spreads of plain-value containers copy nothing linear and stay legal.
struct Point:
    x: i64
def main() -> i32:
    ints: darray[i64] = [1, 2]
    more: darray[i64] = [...ints, 3]
    points: darray[Point] = [Point{x: 1}]
    copies: darray[Point] = [...points, Point{x: 2}]
    fixed: i64[2] = [4, 5]
    joined: darray[i64] = [...fixed, ...more]
    return (joined.count + copies.count).i32()
