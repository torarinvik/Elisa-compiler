# Replacing a struct leaves a reference to its scalar field, its fixed-array field, or the
# darray field slot itself valid (the storage stays in place); a reference taken after the
# replacement is fresh.

struct Bag:
    items: mutable darray[i64]
    other: mutable darray[i64]
    arr: i64[2]
    n: i64

def scalar_field() -> i64:
    mutable s: Bag = Bag{items: [70, 2], other: [3], arr: [1, 2], n: 1}
    r: i64& = &s.n
    s <- Bag{items: [1], other: [3], arr: [3, 4], n: 2}
    return r

def fixed_array_field() -> i64:
    mutable s: Bag = Bag{items: [70, 2], other: [3], arr: [1, 2], n: 1}
    r: i64& = &s.arr[0]
    s <- Bag{items: [1], other: [3], arr: [3, 4], n: 2}
    return r

def field_slot() -> i64:
    mutable s: Bag = Bag{items: [70, 2], other: [3], arr: [1, 2], n: 1}
    r: darray[i64]& = &s.items
    s <- Bag{items: [1], other: [3], arr: [3, 4], n: 2}
    return r[0]

def taken_after() -> i64:
    mutable s: Bag = Bag{items: [70, 2], other: [3], arr: [1, 2], n: 1}
    s <- Bag{items: [1], other: [3], arr: [3, 4], n: 2}
    r: i64& = &s.items[0]
    return r

def main() -> i32:
    return (scalar_field() + fixed_array_field() + field_slot() + taken_after()).i32()
