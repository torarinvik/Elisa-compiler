# stage0 spells a fallible function's return type `T | Set`, so the suffix lands after
# the container bracket and before `, got`.
error Bad:
    Neg

def build(n: i64) -> darray[i64] error[Bad]:
    can Memory.Allocate, Abort.Panic:
        return 5

def main() -> i32:
    can Memory.Allocate, Abort.Panic:
        return 0
