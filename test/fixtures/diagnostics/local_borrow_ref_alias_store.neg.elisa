# A reference local into an owner that is stored out: only the stores through the alias that
# carry no local borrow happen, so nothing dangles.

struct R:
    n: i64

struct A:
    begin: mutable R&?
    k: mutable i64

struct H:
    a: mutable A

def alias_declared_only(h: mutable H&, r: R&) -> void:
    owner: mutable A = A{begin: r, k: 0}
    al: mutable A& = &owner
    h.a <- owner

def alias_writes_scalar(h: mutable H&, r: R&) -> void:
    owner: mutable A = A{begin: r, k: 0}
    al: mutable A& = &owner
    al.k <- 5
    h.a <- owner

def main() -> i32:
    return 0
