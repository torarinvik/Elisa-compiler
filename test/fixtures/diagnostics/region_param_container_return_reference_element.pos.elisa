# The local array lives in @r, but its stored view still points into the shorter-lived region.
def leak_reference_element[@r](anchor: i64& @r) -> darray[sview] @r:
    region inner(4096)
    bytes: mutable darray[u8] @inner = [65.u8()]
    values: mutable darray[sview] @r = [bytes.as_sview()]
    return move values
