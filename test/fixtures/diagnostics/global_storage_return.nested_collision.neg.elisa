module Other:
    module Inner:
        struct Result:
            payload: darray[u8]

module UiDialog:
    module Inner:
        const enum Result of i32:
            None = 0
        alias AliasResult = i32
        global mutable results: Result[4] = zeroed
        global mutable alias_results: AliasResult[2] = zeroed

        def result(slot: usize) -> UiDialog::Inner::Result:
            return results[slot]

        def alias_result(slot: usize) -> UiDialog::Inner::AliasResult:
            return alias_results[slot]
