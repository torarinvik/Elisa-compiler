module Other:
    struct Result:
        payload: darray[u8]
    struct Payload:
        bytes: darray[u8]

struct RootPayload:
    bytes: darray[u8]

global mutable root_stored: mutable RootPayload = zeroed

module Outer:
    struct ParentPayload:
        bytes: darray[u8]
    global mutable parent_stored: mutable ParentPayload = zeroed

    module Inner:
        struct Payload:
            bytes: darray[u8]
        alias HeapPayload = Payload
        type OtherHeapPayload = Other::Payload
        type ParentHeapPayload = Outer::ParentPayload
        const enum Result of i32:
            None = 0
        global mutable nested_stored: mutable Payload = zeroed
        global mutable alias_stored: mutable HeapPayload = zeroed
        global mutable enum_results: Result[2] = zeroed
        global mutable other_alias_stored: mutable OtherHeapPayload = zeroed
        global mutable parent_alias_stored: mutable ParentHeapPayload = zeroed

        def copy_full_path() -> Outer::Inner::Payload:
            return nested_stored

        def copy_owned_alias() -> Outer::Inner::HeapPayload:
            return alias_stored

        def copy_qualified_alias() -> Outer::Inner::OtherHeapPayload:
            return other_alias_stored

        def copy_parent_alias() -> Outer::Inner::ParentHeapPayload:
            return parent_alias_stored

        def copy_root_owner() -> RootPayload:
            return root_stored

        def enum_result() -> Outer::Inner::Result:
            return enum_results[0]

    module Sibling:
        module Inner:
            struct Payload:
                marker: i64
            global mutable scalar_stored: mutable Payload = zeroed

            def copy_scalar() -> Sibling::Inner::Payload:
                return scalar_stored

    global mutable relative_stored: mutable Inner::Payload = zeroed

    def copy_relative_path() -> Inner::Payload:
        return relative_stored
