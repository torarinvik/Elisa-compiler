# A container built in this function's inferred region, stored into caller-owned storage from
# a loop body, a match arm, a nested field, an indexed slot, or through a field-chain receiver:
# the region is freed at return and the caller keeps a dangling buffer.
struct Bag:
    items: mutable darray[i64]

struct Outer:
    bag: mutable Bag

struct Holder:
    rows: mutable darray[darray[i64]]

enum Kind:
    A
    B

def make() -> darray[i64]:
    out: mutable darray[i64] = []
    out.push(1)
    return out

def in_for(b: mutable Bag&) -> void:
    fresh: darray[i64] = []
    for v in 0..<2:
        b.items <- fresh

def decl_in_for(b: mutable Bag&) -> void:
    for v in 0..<2:
        tmp: darray[i64] = []
        b.items <- tmp

def push_in_for(dst: mutable darray[darray[i64]]&) -> void:
    for v in 0..<2:
        dst.push(make())

def in_arm(b: mutable Bag&, k: Kind) -> void:
    fresh: darray[i64] = []
    match k:
        Kind.A:
            b.items <- fresh
        Kind.B:
            pass

def nested_field(o: mutable Outer&) -> void:
    fresh: darray[i64] = []
    o.bag.items <- fresh

def indexed_slot(dst: mutable darray[darray[i64]]&) -> void:
    dst[0] <- make()

def chain_receiver(h: mutable Holder&) -> void:
    h.rows.push(make())

def main() -> i32:
    return 0
