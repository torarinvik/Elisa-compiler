module Outer:
    module Inner:
        def store_text(values: darray[sview]&) -> void:
            pass
        def store_number(values: darray[i64]&) -> void:
            pass

def nested_module_controls(texts: darray[sview]&, numbers: darray[i64]&) -> void:
    Outer::Inner::store_text(texts)
    Outer::Inner::store_number(numbers)
    Outer::Inner::store_text(numbers)
    Outer::Inner::store_number(texts)
