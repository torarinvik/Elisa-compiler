# `get … else continue` and `get … else break` leave the enclosing loop.
def odd(value: i64) -> i64?:
    return null if value % 2 == 0
    value

def main() -> i32:
    total: mutable i64 = 0
    for index in 0..<10 |total|:
        value: i64 = get odd(index) else continue
        total <- total + value
    for index in 1..<10 |total|:
        value: i64 = get odd(index + 1) else break
        total <- total + value
    total.i32()
