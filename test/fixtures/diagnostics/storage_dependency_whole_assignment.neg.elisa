# Whole assignments that leave every live reference valid: a scalar copied out before the
# replacement, a reference retaken afterwards, a plain element read, a whole-container
# reference (it names the slot, not the buffer), and a container rebuilt from itself.

def copied_before() -> i64:
    mutable xs: darray[i64] = [70, 2]
    r: i64& = &xs[0]
    t: i64 = r
    xs <- [1, 2, 3]
    r2: i64& = &xs[0]
    return r2 + t

def copied_then_pushed() -> i64:
    mutable xs: darray[i64] = [70, 2]
    r: i64& = &xs[0]
    t: i64 = r
    xs.push(3)
    return t

def element_read() -> i64:
    mutable xs: darray[i64] = [70, 2]
    s: i64 = xs[0]
    xs <- [1, 2, 3]
    return s

def whole_reference() -> i64:
    mutable xs: darray[i64] = [70, 2]
    r: darray[i64]& = &xs
    xs <- [1]
    return r[0]

def rebuilt_from_itself() -> i64:
    mutable xs: darray[i64] = [70, -2, 3]
    xs <- [v for v in xs if v > 0]
    r: i64& = &xs[0]
    return r

def main() -> i32:
    return (copied_before() + copied_then_pushed() + element_read() + whole_reference() + rebuilt_from_itself()).i32()
