# A straight-line byte-view factory returns a view backed by the caller arena.
# Both direct and named view returns must retain that backing after the factory exits.
struct HU:
    bytes: mutable darray[u8]

def mk() -> sview:
    h: mutable HU = HU{bytes: [65.u8(), 65.u8()]}
    v: sview = h.bytes.as_sview()
    return v

def main() -> i64:
    w: sview = mk()
    return w[0].i64()
