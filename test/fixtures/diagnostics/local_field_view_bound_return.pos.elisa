# fuzz F1: a view of a darray FIELD of a by-value struct local, bound to a name and then
# returned, dangles exactly like the direct `return h.bytes.as_sview()`.
struct HU:
    bytes: mutable darray[u8]

def mk() -> sview:
    h: mutable HU = HU{bytes: [65.u8(), 65.u8()]}
    v: sview = h.bytes.as_sview()
    return v

def main() -> i64:
    w: sview = mk()
    return w[0].i64()
