# Returning an explicitly `@r`-tied parameter through a region-less return type.
struct S:
    n: mutable usize
    m: usize

def plain[@r](n: usize& @r) -> usize:
    return n

def nested[@r](n: usize& @r, k: usize) -> usize:
    if k > 0:
        return n
    return k

def forward[@r](n: usize& @r) -> usize&:
    return n

module M:
    def get[@r](n: usize& @r) -> usize:
        while true:
            return n
        return 0

def main() -> i32:
    return 0
