# A branch-local scalar must not hide the outer by-reference parameter in its sibling.
def read_ref(value: i64&) -> i64:
    return value

def check(borrowed: i64&, flag: bool) -> i64:
    if flag:
        borrowed: i64 = 0
    else:
        can Parallel, Memory.Allocate, Abort.Panic:
            nursery workers(1):
                submit read_ref(borrowed)
    return 0

def main() -> i64:
    value: i64 = 3
    return check(&value, false)
