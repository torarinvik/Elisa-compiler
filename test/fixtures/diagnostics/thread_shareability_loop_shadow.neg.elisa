# The scalar loop binder shadows the reference parameter only inside the loop.
def twice(value: i64) -> i64:
    return value * 2

def check(value: i64&) -> i64:
    can Parallel, Memory.Allocate, Abort.Panic:
        for value in [1, 2]:
            nursery workers(1):
                submit twice(value)
    return 0

def main() -> i64:
    value: i64 = 3
    return check(&value)
