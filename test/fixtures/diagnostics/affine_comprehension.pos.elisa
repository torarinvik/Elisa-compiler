# A list comprehension binds each element BY VALUE and evaluates its element expression
# once per element, so it may neither iterate elements holding linear handles nor take
# an outer handle without `move`. Lines 26 (existing ref rule), 27, 33, 35 and 37 are the stage0 diagnostics.
affine struct Handle:
    v: i64

struct Pair:
    a: Handle
    b: i64

def release(h: Handle) -> i64:
    return h.v

def drain(xs: darray[Handle]) -> i64:
    total: mutable i64 = 0
    for x in move xs:
        total <- total + release(move x)
    return total

def drain_pairs(xs: darray[Pair]) -> i64:
    total: mutable i64 = 0
    for x in move xs:
        total <- total + release(move x.a)
    return total

def peek(xs: darray[Handle]&) -> i64:
    fds: darray[i64] = [x.v for x in xs]
    return fds.count.i64()

def main() -> i32:
    xs: mutable darray[Handle] = []
    xs.push(Handle{v: 1})
    fds: darray[i64] = [x.v for x in xs]
    ps: mutable darray[Pair] = []
    bs: darray[i64] = [p.b for p in ps]
    g: Handle = Handle{v: 2}
    zs: darray[Handle] = [g for i in 0..<1]
    total: i64 = drain(move xs) + drain_pairs(move ps) + drain(move zs)
    return total.i32()
