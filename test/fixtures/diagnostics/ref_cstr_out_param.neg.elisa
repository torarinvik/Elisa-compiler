# Writing a string literal through a `mutable cstr&` out-parameter stores the pointer: a
# `cstr` accepts any byte reference, including a literal's `static u8&`.
def set_out(out: mutable cstr&) -> void:
    out <- "abc"

def main() -> i32:
    value: mutable cstr = ""
    set_out(&value)
    return value[1].i32()
