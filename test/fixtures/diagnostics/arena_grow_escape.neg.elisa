# The same ambient local arena growing a LOCAL darray is fine: the darray's backing lives and
# dies with `arena`, nothing outlives the function. Only the carrier-type warning remains,
# and both compilers emit it.
def grow_local_in_local_arena(n: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
    arena: mutable Arena = zeroed
    total: mutable i64 = 0
    in arena:
        local_xs: mutable darray[i64] = []
        local_xs.push(n)
        total <- local_xs.count.i64()
    return total
