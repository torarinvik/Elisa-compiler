# corpus: deliberate-decline -- each loop reads an interior reference taken before the loop,
# then grows its container later in the body. The first iteration's read is fine; the next
# iteration's read (or `while` condition) sees a relocated buffer. Both compilers check the
# loop's back edge against the first read of every view declared outside it.
def grow(ys: mutable darray[i64]&) -> void:
    ys.push(9)

def range_for(xs: mutable darray[i64]&, n: i64) -> i64:
    r: i64& = &xs[0]
    total: mutable i64 = 0
    for i in 0..<n |total, xs, r|:
        total <- total + r
        xs.push(i)
    return total

def while_body(xs: mutable darray[i64]&, n: i64) -> i64:
    r: i64& = &xs[0]
    total: mutable i64 = 0
    i: mutable i64 = 0
    while i < n:
        total <- total + r
        xs.push(i)
        i <- i + 1
    return total

def while_condition(xs: mutable darray[i64]&) -> i64:
    r: i64& = &xs[0]
    mutable i: i64 = 0
    while i < r:
        xs.push(i)
        i <- i + 1
    return i

def callee_growth(xs: mutable darray[i64]&, n: i64) -> i64:
    r: i64& = &xs[0]
    total: mutable i64 = 0
    for i in 0..<n |total, xs, r|:
        total <- total + r
        grow(xs)
    return total

def continue_path(xs: mutable darray[i64]&, n: i64) -> i64:
    r: i64& = &xs[0]
    total: mutable i64 = 0
    for i in 0..<n |total, xs, r|:
        total <- total + r
        if i > 2:
            xs.push(i)
            continue
        total <- total + 1
    return total

def inner_loop_use(xs: mutable darray[i64]&, n: i64) -> i64:
    r: i64& = &xs[0]
    total: mutable i64 = 0
    for i in 0..<n |total, xs, r|:
        for j in 0..<n |total, r|:
            total <- total + r
        xs.push(i)
    return total

def branch_rebind(xs: mutable darray[i64]&, n: i64) -> i64:
    mutable r: i64& = &xs[0]
    total: mutable i64 = 0
    for i in 0..<n |total, xs, r|:
        if i > 1:
            r <- &xs[0]
        total <- total + r
        xs.push(i)
    return total
