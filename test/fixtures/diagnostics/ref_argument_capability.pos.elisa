# corpus: deliberate-decline -- stage0 lets a readonly string-literal reference satisfy a
# mutable u8& parameter; stage1 correctly rejects granting write capability to readonly bytes.
# Rule R: a string literal's bytes are a `static u8&`, readonly; a `mutable u8&` parameter
# may write through its argument, so the literal cannot be passed.
def poke(r: mutable u8&) -> i32:
    r <- 7
    return 0

def main() -> i32:
    return poke("abc")
