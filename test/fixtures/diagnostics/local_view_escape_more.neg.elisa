# Sound shapes that must stay silent.
struct S:
    buf: u8[4]

def of_dstr(d: dstr&) -> sview:
    return d.as_sview()

def local_use() -> i32:
    s: S = S{buf: [1, 2, 0, 0]}
    v: view[u8] = s.buf[0:2]
    return v[1].i32()

def main() -> i32:
    s: S = S{buf: [1, 2, 0, 0]}
    return local_use() + s.buf[0].i32()
