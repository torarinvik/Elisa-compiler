# Control for ensures_state_target.neg.elisa: the SAME stateless struct, passed to a
# function that declares no state postcondition at all. The check reads the recorded
# `ensures <param> => <State>` targets only, so an ordinary parameter of a stateless
# struct must stay silent — this pins that it is the postcondition, not the type, that
# makes the neg case an error.
struct ParseJob:
    count: i64

def finish(job: ParseJob&) -> bool:
    return job.count > 0
