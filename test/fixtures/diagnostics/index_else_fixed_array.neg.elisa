# `xs[i] else DEFAULT` was the implicit bounds fallback, removed in favour of the explicit
# `get xs[i] else ...`. stage1 refused it for a DARRAY base but not for a FIXED-extent one:
# a fixed array's declared type head is the ELEMENT type's name, not a container keyword.
def read_fixed(a: i64[4]&, i: usize) -> i64:
    return a[i] else 0
