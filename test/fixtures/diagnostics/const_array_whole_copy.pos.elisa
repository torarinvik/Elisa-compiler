# A const array read whole copies the global into a local (Stage1 once declined
# `table: mutable i64[4] = VALUES`).
const VALUES: i64[4] = [5, 6, 7, 8]

def patched(index: usize) -> i64:
    table: mutable i64[4] = VALUES
    table[1] <- 9
    table[index]

def main() -> i32:
    0 if patched(1) == 9 and patched(2) == 7 and VALUES[1] == 6 else 1
