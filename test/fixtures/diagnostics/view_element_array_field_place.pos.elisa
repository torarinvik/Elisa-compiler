# An array field of a view element is an addressable place: `nodes[i].next[j]`
# must lower as both a read and a write (Stage1 once declined the function).
struct TrieNode:
    depth: mutable i64
    next: mutable i64[4]

def link(nodes: mutable view[TrieNode], id: usize, letter: usize, target: i64) -> void:
    nodes[id].next[letter] <- target

def follow(nodes: view[TrieNode], id: usize, letter: usize) -> i64:
    nodes[id].next[letter]

def main() -> i32:
    storage: mutable TrieNode[3] = zeroed
    link(storage[0:3], 1, 2, 7)
    0 if follow(storage[0:3], 1, 2) == 7 else 1
