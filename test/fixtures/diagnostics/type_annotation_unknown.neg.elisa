# The three shapes a naive "is this enum in packed_enum_names?" test reports wrongly.
#
#   * an EXTERN enum: stage0 never runs annotation validation over a foreign declaration,
#     so every decorator name is allowed there;
#   * a hierarchy whose ROOT declares `common(...)` fields: the commons promote the whole
#     hierarchy to the region-backed store, so the root IS packed even though nothing in it
#     is recursive by value;
#   * the supported struct spellings, which must stay silent.
@open
extern enum Event of i32:
    Press
    Release

@packed_profile(build_heavy)
enum Widget:
    common:
        @storage(inline)
        width: mutable f32
    pass

enum Control is Widget:
    Label(size: f32, next: Widget?)

@align(8)
@fixed_layout
struct Point:
    x: i32

def main() -> i32:
    p: Point = Point{x: 1}
    return p.x
