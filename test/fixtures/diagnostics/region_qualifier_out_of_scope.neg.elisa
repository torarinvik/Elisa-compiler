# The SAME annotation while the region is still open must stay silent -- the extent check
# must not start rejecting valid `@r`. Both the innermost block and a use nested deeper
# inside it are covered: the extent is the whole block, not its first statement.
def in_scope_region_qualifier(flag: bool) -> void can[Memory.Allocate, Abort.Panic]:
    region a(4096):
        values: mutable darray[i64] @a = []
        values.push(1)
        if flag:
            nested: mutable darray[i64] @a = []
            nested.push(2)
