struct BorrowedBox:
    value: i64&

enum Choice:
    Local
    Stable

global stable: i64 = 2

def escapes_match(choice: Choice) -> BorrowedBox:
    local: i64 = 1
    borrowed: mutable BorrowedBox = BorrowedBox{value: &stable}
    match choice:
        Choice.Local:
            borrowed <- BorrowedBox{value: &local}
        Choice.Stable:
            borrowed <- BorrowedBox{value: &stable}
    borrowed
