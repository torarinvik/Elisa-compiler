# Appending to a DIFFERENT darray, or `+=` on the accumulator, inside the loop leaves the
# iterated buffer alone.

def main() -> i32:
    mutable xs: darray[i64] = [70, 2]
    mutable ys: darray[i64] = [1]
    mutable n: i64 = 0
    for v in xs:
        ys += v
        n += v
    return (ys.count.i64() + n).i32()
