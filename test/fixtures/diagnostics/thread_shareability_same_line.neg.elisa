# A nested ordinary reference call on the same line does not taint either scalar task.
def read_ref(value: i64&) -> i64:
    return value

def twice(value: i64) -> i64:
    return value * 2

def main() -> i64:
    can Parallel, Memory.Allocate, Abort.Panic:
        value: i64 = 3
        flag: bool = true
        nursery workers(1):
            submit twice(read_ref(&value)) if flag else submit twice(value)
        return 0
