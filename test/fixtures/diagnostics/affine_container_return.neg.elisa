# The builder allocates the backing storage in the caller's arena. Moving the
# result transfers the affine elements, and the caller can still drain them.
affine struct Handle:
    v: i64

def make(i: i64) -> Handle:
    return Handle{v: i}

def forward(xs: darray[Handle]) -> darray[Handle]:
    return move xs

def build() -> darray[Handle]:
    made: mutable darray[Handle] = []
    made.push(make(1))
    return move made

def release(h: Handle) -> i64:
    return h.v

def drain(xs: darray[Handle]) -> i64:
    total: mutable i64 = 0
    for x in move xs:
        total <- total + release(move x)
    return total

def main() -> i32:
    return drain(forward(build())).i32()
