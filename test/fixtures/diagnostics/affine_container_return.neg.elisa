# `return move c` hands a container of handles to the caller; nothing leaks.
# stage0 rejects `return move made` (L14) as an `in auto:` region escape, but it accepts a
# bare `return made` of a darray[i64]. stage1 allocates a returned local in the caller's
# arena in both spellings (checked in IR and at run time), so the stage0 line is its own
# over-rejection and stage1 stays silent here.
affine struct Handle:
    v: i64

def make(i: i64) -> Handle:
    return Handle{v: i}

def forward(xs: darray[Handle]) -> darray[Handle]:
    return move xs

def build() -> darray[Handle]:
    made: mutable darray[Handle] = []
    made.push(make(1))
    return move made

def release(h: Handle) -> i64:
    return h.v

def drain(xs: darray[Handle]) -> i64:
    total: mutable i64 = 0
    for x in move xs:
        total <- total + release(move x)
    return total

def main() -> i32:
    return drain(forward(build())).i32()
