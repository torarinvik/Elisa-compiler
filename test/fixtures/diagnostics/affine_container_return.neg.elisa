# `return move c` must not let a by-value local darray escape the function's inferred
# `in auto:` region. Stage0 rejects `return move made` (L18), and Stage1 must reject the
# same spelling; a move transfers the container value but does not transfer the backing
# region. The parameter-forwarding form remains valid.
affine struct Handle:
    v: i64

def make(i: i64) -> Handle:
    return Handle{v: i}

def forward(xs: darray[Handle]) -> darray[Handle]:
    return move xs

def build() -> darray[Handle]:
    made: mutable darray[Handle] = []
    made.push(make(1))
    return move made

def release(h: Handle) -> i64:
    return h.v

def drain(xs: darray[Handle]) -> i64:
    total: mutable i64 = 0
    for x in move xs:
        total <- total + release(move x)
    return total

def main() -> i32:
    return drain(forward(build())).i32()
