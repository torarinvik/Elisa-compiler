# Accepted by stage0: a ref parameter passed on binds `r`, and a local whose struct owns a container
# gives stage0 a region to bind.
struct S:
    n: mutable usize

struct C:
    xs: mutable darray[usize]

def get[@r](s: mutable S& @r) -> usize:
    return s.n

def getc[@r](c: mutable C& @r) -> usize:
    return c.xs.count

def through(s: mutable S&) -> usize:
    return get(s)

def main() -> i32:
    c: mutable C = C{xs: []}
    getc(c)
    return 0
