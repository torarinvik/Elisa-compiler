# This intentionally malformed probe documents that `;` is not a supported statement separator.
# It is parser-refusal coverage only, not an accepted-program soundness regression.
def same_line_reassign[@r](anchor: i64& @r) -> darray[i64] @r:
    values: mutable darray[i64] @r = []; automatic: mutable darray[i64] = []; values <- move automatic
    return move values
