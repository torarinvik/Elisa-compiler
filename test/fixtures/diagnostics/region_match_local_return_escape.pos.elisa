struct Scalar:
    value: i64

struct Handles:
    value: darray[i64]

def leak_shadow() -> darray[i64] can[Memory.Allocate, Abort.Panic]:
    region scratch(4096):
        values: mutable darray[i64] = []
        values.push(41)
        box: Scalar = Scalar{value: 0}
        return match true:
            _:
                box: Handles = Handles{value: values}
                box.value
