# Names the value block itself declares, including inside a nested captured loop,
# are its own locals: mutating them is not E4.
def local_acc(xs: darray[i64]) -> i64:
    x: i64 =
        acc: mutable i64 = 0
        for v in xs |acc|:
            acc <- acc + v
        acc
    return x

def nested_local(xs: darray[i64]) -> i64:
    x: i64 =
        acc: mutable i64 = 0
        for v in xs |acc|:
            inner: mutable i64 = 0
            for w in xs |inner|:
                inner <- inner + w
            acc <- acc + inner
        acc
    return x
