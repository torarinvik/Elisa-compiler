# The same `defer function` with a FIXED array local (no region-less allocation, so no
# synthesized wrap) and with a darray local in a DIFFERENT function: both accepted by stage0.
global mutable t: mutable i64 = 0

def run() -> i64:
    defer function:
        t <- 9
    xs: i64[3] = [1, 2, 3]
    return xs[0]

def other() -> i64:
    ys: mutable darray[i64] = [4]
    return ys[0]

def main() -> i64:
    return run() + t + other()
