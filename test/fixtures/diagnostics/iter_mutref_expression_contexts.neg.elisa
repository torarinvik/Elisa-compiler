# Read-only calls in the same expression positions do not invalidate the iterator.
def item_count(xs: darray[i64]&) -> i64:
    return xs.count

def item_count_named(note: i64, xs: darray[i64]&) -> i64:
    return xs.count + note

def identity(value: i64) -> i64:
    return value

def if_condition(xs: darray[i64]&) -> void:
    for value in xs:
        if item_count(xs) > 0:
            pass

def nested_condition(xs: darray[i64]&) -> void:
    for value in xs:
        if identity(item_count(xs)) > 0:
            pass

def while_condition(xs: darray[i64]&) -> void:
    for value in xs:
        while item_count(xs) > 0:
            break

def declaration_initializer(xs: darray[i64]&) -> void:
    for value in xs:
        keep_going: i64 = item_count(xs)
        _ = keep_going

def assignment_value(xs: darray[i64]&) -> void:
    mutable keep_going: i64 = 0
    for value in xs:
        keep_going <- item_count(xs)

def match_scrutinee(xs: darray[i64]&) -> void:
    for value in xs:
        outcome: i64 = match item_count(xs):
            1: 1
            _: 0
        _ = outcome

def named_arguments(xs: darray[i64]&) -> void:
    for value in xs:
        if item_count_named(xs: xs, note: 0) > 0:
            pass

def value_block_alias(xs: darray[i64]&) -> void:
    for value in xs:
        count: i64 =
            alias: darray[i64]& = xs
            item_count(alias)
        _ = count

def main() -> i32:
    return 0
