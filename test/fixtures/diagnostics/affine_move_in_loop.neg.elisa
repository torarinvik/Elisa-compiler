# Moves in loops that are sound: the body leaves the loop, re-initializes the value,
# or moves a value it declared itself; draining a darray moves each element once.
affine struct Handle:
    v: i64

def sink(h: Handle) -> i64:
    return h.v

def leave_by_break() -> i64:
    t: Handle = Handle{v: 1}
    total: mutable i64 = 0
    for i in 0..<3 |total|:
        total <- sink(move t)
        break
    return total

def leave_by_return() -> i64:
    t: Handle = Handle{v: 1}
    for i in 0..<3:
        if i == 2:
            return sink(move t)
        else:
            return 0
    return sink(move t)

def reinitialize() -> i64:
    t: mutable Handle = Handle{v: 1}
    total: mutable i64 = 0
    for i in 0..<3 |total, t|:
        total <- total + sink(move t)
        t <- Handle{v: 2}
    return total + sink(move t)

def body_local() -> i64:
    total: mutable i64 = 0
    for i in 0..<3 |total|:
        u: Handle = Handle{v: 1}
        total <- total + sink(move u)
    return total

def drain() -> i64:
    can Memory.Allocate:
        xs: mutable darray[Handle] = []
        xs.push(Handle{v: 1})
        total: mutable i64 = 0
        for x in move xs |total|:
            total <- total + sink(move x)
        return total

def main() -> i32:
    return (leave_by_break() + leave_by_return() + reinitialize() + body_local() + drain()).i32()
