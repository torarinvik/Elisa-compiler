# docs/119 §3: an accumulator loop is an expression. Written as a statement with more
# statements after it, its value is thrown away and the accumulator dies with the loop, so
# this validator always returns true (the elisa-engine shape fixed in 4c81848).
def all_positive_discarded(values: i64[3]) -> bool:
    for i in 0..<3 |valid: bool = true| -> valid:
        valid <- false if values[i] <= 0
    true

# The same drop through a `while` loop expression.
def first_negative_discarded(values: i64[3]) -> i64:
    while index < 3 |index: usize = 0, found: i64 = -1| -> found:
        found <- index.i64() if values[index] < 0 and found < 0
        index <- index + 1
    -1

# Inside a value block, the block's tail value follows every statement.
def all_positive_in_block(values: i64[3]) -> bool:
    ok: bool =
        for i in 0..<3 |valid: bool = true| -> valid:
            valid <- false if values[i] <= 0
        true
    return ok
