# corpus: deliberate-decline -- stage0 accepts a write through a read-only reference;
# stage1 correctly rejects it (the source binding's `mutable` does not grant pointee write access).
# Rule R, legacy spelling: `r: mutable T& = init` writes through only when `init` does.
# `pick` returns a READONLY `i64&`, so `r` is rebindable but not writable.
def pick(p: i64&) -> i64&:
    return p

def main() -> i32:
    x: i64 = 1
    r: mutable i64& = pick(&x)
    r <- 5
    return 0
