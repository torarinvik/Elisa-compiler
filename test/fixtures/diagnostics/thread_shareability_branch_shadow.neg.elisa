# A branch-local reference must not taint the outer scalar after the branch closes.
def twice(value: i64) -> i64:
    return value * 2

def main() -> i64:
    can Parallel, Memory.Allocate, Abort.Panic:
        value: i64 = 3
        if true:
            value: i64& = &value
        nursery workers(1):
            submit twice(value)
        return 0
