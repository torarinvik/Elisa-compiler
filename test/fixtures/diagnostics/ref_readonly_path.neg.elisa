# Rule R: a readonly `S&` can still reach a WRITABLE reference stored in a field; the write
# goes through the field's `mutable In&`, not through `r`.
struct In:
    val: mutable i64

struct S:
    inner: mutable In&

def main() -> i32:
    v: mutable In = In{val: 1}
    s: S = S{inner: &v}
    r: S& = &s
    r.inner.val <- 5
    return v.val.i32()
