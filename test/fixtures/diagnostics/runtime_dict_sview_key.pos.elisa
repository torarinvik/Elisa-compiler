# An sview key has no value equality, so stage0 refuses to build the hash table. This one
# cannot be caught by the resolved key type: the structural type system normalizes an sview
# (and dstr) dict key to `cstr`, so the check reads the DECLARED type instead.
# A READ, not a write — a write would also trip the separate index-assign diagnostic.
def f(k: sview) -> void:
    d: mutable dict[sview, i64] = {}
    v: i64 = d[k]
    _ = v
    _ = d
