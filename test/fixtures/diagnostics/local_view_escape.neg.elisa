# Views into storage that OUTLIVES the function are fine: a global, and a caller-owned ref.
global mutable pool: mutable i64[16] = zeroed

def window(lo: usize, hi: usize) -> view[i64]:
    return pool[lo:hi]

def through_ref(values: mutable i64[4]&) -> view[i64]:
    return values[1:3]

def main() -> i64:
    local: mutable i64[4] = zeroed
    local[1] <- 7
    a: view[i64] = window(2, 5)
    b: view[i64] = through_ref(local)
    return a.len.i64() + b.len.i64()
