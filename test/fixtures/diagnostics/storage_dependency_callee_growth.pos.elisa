# corpus: deliberate-decline -- every use below reads an interior reference after the
# container may have moved or shrunk. Both compilers reject a callee growing it through a
# `mutable T&` parameter and a field container; stage0 accepts after_pop and after_cstr because
# it infers a stable backing for those default locals, which stage1 does not model.
struct Bag:
    items: mutable darray[i64]

def grow(ys: mutable darray[i64]&) -> void:
    ys.push(9)

def grow_count(ys: mutable darray[i64]&) -> i64:
    ys.push(9)
    return ys.count.i64()

def grow_bag(bag: mutable Bag&) -> void:
    bag.items.push(9)

def through_statement() -> i64:
    mutable xs: darray[i64] = [1, 2]
    r: i64& = &xs[1]
    grow(&xs)
    return r

def through_initializer() -> i64:
    mutable xs: darray[i64] = [1, 2]
    r: i64& = &xs[1]
    n: i64 = grow_count(&xs)
    return r + n

def through_struct() -> i64:
    mutable bag: Bag = Bag{items: [1, 2]}
    r: i64& = &bag.items[1]
    grow_bag(&bag)
    return r

def after_pop() -> i64:
    mutable xs: darray[i64] = [1, 2]
    r: i64& = &xs[1]
    xs.pop()
    return r

def field_container(bag: mutable Bag&) -> i64:
    r: i64& = &bag.items[1]
    bag.items.push(9)
    return r

def after_cstr() -> i64:
    mutable xs: darray[u8] = [65, 66]
    r: u8& = &xs[1]
    c: cstr = xs.as_cstr()
    return r.i64()

# An inner redeclaration of the same name ends with its block; the outer binding is still stale.
def shadow_does_not_launder(k: i64) -> i64:
    mutable xs: darray[i64] = [1, 2]
    r: i64& = &xs[1]
    grow(&xs)
    if k == 1:
        ys: mutable darray[i64] = [3]
        r: i64& = &ys[0]
        _ = r
    return r
