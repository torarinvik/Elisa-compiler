# An exhaustive catch over a RESTRICTED error set. `foo` can only raise FooError.Bad1,
# so handling Bad1 (plus both BarError variants) is exhaustive -- FooError.Bad2 is
# excluded by the `{Bad1}` subset and must NOT be demanded. Both compilers stay silent.
# There is no matching .pos: stage0 renders the set itself in the non-exhaustive
# sentence (`non-exhaustive catch over error[BarError, FooError.Bad1]`) and stage1
# writes "the caught call's error set", so a .pos would encode a message gap as a
# passing test. That gap is real and still open.
error FooError:
    Bad1
    Bad2
error BarError:
    Bad3
    Bad4(n: u32)
extern foo() -> i64 error[FooError{Bad1}, BarError{Bad3, Bad4}]

def use() -> i64:
    catch foo():
        n:
            return n
        FooError.Bad1:
            return 1
        BarError.Bad3:
            return 3
        BarError.Bad4(x):
            return x.i64()
    return 0
