# `get … else continue` and `get … else break` need a loop, like the statements.
def odd(value: i64) -> i64?:
    return null if value % 2 == 0
    value

def skipped() -> i64:
    value: i64 = get odd(3) else continue
    value

def stopped() -> i64:
    value: i64 = get odd(3) else break
    value

def main() -> i32:
    (skipped() + stopped()).i32()
