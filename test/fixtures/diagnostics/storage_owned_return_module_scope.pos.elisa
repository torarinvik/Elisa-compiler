# The module-scoped owned-return rule still rejects a REAL borrow: `Tracks::read` returns a
# view of `doc`, so a fresh same-named `Clip::read` elsewhere must not exempt it, and reading
# `source` after growing `doc` reads relocated storage.
module Geo:
    public:
        struct P:
            x: f32
            y: f32

module Clip:
    public:
        struct Clip:
            data: darray[f32]

        def read(clip: Clip&, frame: usize, bone: usize) -> Geo::P:
            at: usize = frame + bone
            return Geo::P{x: clip.data[at], y: clip.data[at + 1]}

module Ops:
    public:
        def run(source: view[i64], scratch: mutable darray[i64]&) -> darray[i64]:
            scratch.push(1)
            out: mutable darray[i64] = []
            out.extend(source)
            return out

module Tracks:
    public:
        struct Doc:
            values: mutable darray[i64]

        def read[@r](doc: Doc& @r, slot: usize, component: usize) -> view[i64] @r:
            return doc.values[0:doc.values.count]

        def grow(doc: mutable Doc&, values: darray[i64]&) -> i64:
            doc.values.extend(values)
            return 1

        def run(doc: mutable Doc&) -> i64:
            changed: mutable i64 = 0
            for component in 0..<2 |doc, changed|:
                source: view[i64] = read(doc, 0, component)
                scratch: mutable darray[i64] = []
                result: darray[i64] = Ops::run(source, &scratch)
                cleaned: mutable darray[i64] = []
                cleaned.extend(result)
                changed <- changed + grow(doc, cleaned)
                changed <- changed + source[0]
            return changed

def main() -> i32:
    can Memory.Allocate, Memory.Release, Abort.Panic:
        doc: mutable Tracks::Doc = Tracks::Doc{values: [1, 2]}
        clip: Clip::Clip = Clip::Clip{data: [1.0, 2.0, 3.0]}
        p: Geo::P = Clip::read(clip, 0, 0)
        return Tracks::run(&doc).i32() + p.x.i32()
