# The canonical narrowings and container tests are bool-typed and must stay silent.
def probe(o: i64?, p: i64?, xs: darray[i64], ys: darray[i64]) -> bool:
    narrowed: bool = o != null and p != null
    counted: bool = xs.count > 0 or ys.count > 0
    negated: bool = not (xs.count > 0)
    return narrowed and counted and negated
