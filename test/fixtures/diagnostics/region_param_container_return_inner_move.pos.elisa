# A later move from a shorter-lived region invalidates the initial @r allocation proof.
def inner_move[@r](anchor: i64& @r) -> darray[i64] @r:
    region inner(4096)
    values: mutable darray[i64] @r = []
    inner_values: mutable darray[i64] @inner = []
    values <- move inner_values
    return move values
