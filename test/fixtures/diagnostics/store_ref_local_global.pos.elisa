# Storing the address of a local into a GLOBAL (an array element here, through a re-typing
# cast) dangles once the function returns; stage0 rejects it with the direct-store sentence.
const NB: usize = 4

struct Entry:
    tag: mutable i64

global mutable cache: heap Entry&?[NB] = zeroed

def peek(bucket: usize) -> i64 can[Abort.Panic]:
    entry: mutable heap Entry&? = cache[bucket]
    if entry == null:
        return 0
    return entry.tag

def main() -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        a: mutable Entry = Entry{tag: 7}
        cache[0] <- (&a).cast[heap Entry&]
        return peek(0.usize()) * 6
