# Storing a global's own address into a global outlives nothing, and a local that shadows
# a global's name is a frame slot, so neither store escapes.
struct Entry:
    tag: mutable i64

global mutable cache: heap Entry&?[4] = zeroed
global mutable stored: Entry = Entry{tag: 7}

def remember() -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        cache[0] <- (&stored).cast[heap Entry&]
        local: mutable Entry = Entry{tag: 1}
        cache_shadow: mutable heap Entry&? = null
        cache_shadow <- (&local).cast[heap Entry&]
        return local.tag

def main() -> i64:
    return remember()
