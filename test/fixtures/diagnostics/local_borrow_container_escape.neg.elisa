# Structurally similar stores that keep every reference inside its owner's lifetime.

struct H:
    r: i64&

struct O:
    h: mutable H
    n: mutable i64

def push_param_ref(out: mutable darray[i64&]&, x: i64&) -> void:
    can Memory.Allocate, Abort.Panic:
        out.push(x)

def push_value(out: mutable darray[i64]&) -> void:
    can Memory.Allocate, Abort.Panic:
        x: i64 = 5
        h: H = H{r: &x}
        out.push(h.r)

def local_only() -> i64:
    can Memory.Allocate, Abort.Panic:
        x: i64 = 5
        out: mutable darray[i64&] = []
        out.push(&x)
        return out[0]

def store_scalar_field(out: mutable O&) -> void:
    x: i64 = 5
    h: H = H{r: &x}
    out.n <- h.r

def local_aggregate_rebind() -> i64:
    x: i64 = 5
    y: i64 = 6
    h: mutable H = H{r: &x}
    h <- H{r: &y}
    return h.r

def main() -> i32:
    return 0
