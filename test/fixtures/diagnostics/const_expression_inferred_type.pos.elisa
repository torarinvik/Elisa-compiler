# An unannotated const takes its type from its initializer even when that is an
# expression over other consts (Stage1 once left it untyped and declined every
# function that read it).
const MAX_POINTS = 8
const MAX_INPUT_LENGTH = 2 + MAX_POINTS * MAX_POINTS
const NEGATED = -MAX_POINTS
const ENABLED = MAX_POINTS > 3

def accepts(length: usize) -> bool:
    length <= MAX_INPUT_LENGTH

def main() -> i32:
    0 if accepts(66) and not accepts(67) and NEGATED == -8 and ENABLED else 1
