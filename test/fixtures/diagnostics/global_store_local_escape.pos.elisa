# A borrow of a function local stored into a global dangles once the function returns,
# whether the global is written whole or through an index, and a cast to `heap` does not
# lengthen what it borrows.
struct Entry:
    tag: mutable i64

global mutable cache: heap Entry&?[4] = zeroed
global mutable latest: heap Entry&? = null

def remember() -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        local: mutable Entry = Entry{tag: 7}
        cache[0] <- (&local).cast[heap Entry&]
        latest <- (&local).cast[heap Entry&]
        return 0

def main() -> i64:
    return remember()
