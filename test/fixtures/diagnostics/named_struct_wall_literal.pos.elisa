# Every literal kind against a declared STRUCT wall. stage0 spells the literal, not its
# family: `static u8&` for a string, `f64` for a float. Measured 2026-09-19.
struct P:
    a: i64

def f() -> void:
    can Memory.Allocate, Abort.Panic:
        q1: P = 5
        q2: P = "s"
        q3: P = 1.5
        q4: P = 'c'
        q5: P = true
