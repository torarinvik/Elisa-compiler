# A call argument may need a SUBSET of what the parameter permits (stage0's
# funcAssignableIgnoringNarrowerPermissions): a plain function into a `can[Memory]` parameter
# is fine, and so is the exact row. Both accepted by stage0.
def grow(n: i64) -> i64 can[Memory.Allocate]:
    xs: darray[i64] = [n]
    return xs[0]

def plain(n: i64) -> i64:
    return n

def apply(h: fn(i64) -> i64 can[Memory], n: i64) -> i64 can[Memory]:
    return h(n)

def main() -> i64:
    return apply(grow, 3) + apply(plain, 4)
