# A `mutable T[N]` local is a writable source: slicing it into a
# `mutable view[T]` must not report a read-only source.
def fill(count: usize) -> usize:
    storage: mutable usize[8] = zeroed
    window: mutable view[usize] = storage[0:count]
    window[0] <- 3
    storage[0]

def main() -> i32:
    0 if fill(4) == 3 else 1
