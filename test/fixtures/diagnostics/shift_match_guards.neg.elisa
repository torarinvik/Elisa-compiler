def oversized_expression_guard(n: i64) -> i64:
    return match n:
        _ if (n << 4) > 0: 1
        _: 0

def oversized_statement_guard(n: i64) -> i64:
    match n:
        _ if (n << 4) > 0:
            return 1
        _:
            return 0
    return 0

def negative_expression_guard(n: i64) -> i64:
    return match n:
        _ if (n << 1) > 0: 1
        _: 0

def negative_statement_guard(n: i64) -> i64:
    match n:
        _ if (n << 1) > 0:
            return 1
        _:
            return 0
    return 0

def zero_expression_guard(n: i64) -> i64:
    return match n:
        _ if (n << 1) > 0: 1
        _: 0

def zero_statement_guard(n: i64) -> i64:
    match n:
        _ if (n << 1) > 0:
            return 1
        _:
            return 0
    return 0

def nonnumeric_expression_guard(n: i64, value: i64) -> i64:
    return match n:
        _ if (value << 2) == 0: 1
        _: 0

def nonnumeric_statement_guard(n: i64, value: i64) -> i64:
    match n:
        _ if (value << 2) == 0:
            return 1
        _:
            return 0
    return 0

def nonintegral_expression_guard(n: i64, value: i64) -> i64:
    return match n:
        _ if (value << 2) == 0: 1
        _: 0

def nonintegral_statement_guard(n: i64, value: i64) -> i64:
    match n:
        _ if (value << 2) == 0:
            return 1
        _:
            return 0
    return 0
