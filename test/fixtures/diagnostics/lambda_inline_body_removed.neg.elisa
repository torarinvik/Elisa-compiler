# `fn(v): EXPR` was the inline lambda body. It is removed, and stage0 refuses it at parse
# time with a sentence naming the replacement. stage1 accepted it, as if the colon opened a
# block, and reported only a cascade (`unexpected token ,`) that never named the construct.
def apply(step: fn(i64) -> i64, value: i64) -> i64:
    return step(value)

def run(value: i64) -> i64:
    return apply(fn(v: i64): v + 1, value)
