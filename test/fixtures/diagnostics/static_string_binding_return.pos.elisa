# stage0 types an unannotated string-literal binding as `static u8&`, which `-> sview` rejects.
def plain(n: i64) -> sview:
    s = "zero"
    return s

def block_tail(n: i64) -> sview:
    s =
        k = n
        "zero"
    return s

def ternary(n: i64) -> sview:
    s = "zero" if n == 0 else "many"
    return s

def matched(n: i64) -> sview:
    s = match n:
        0: "zero"
        _: "many"
    return s

module Names:
    const ZERO = "zero"

    def bare(n: i64) -> sview:
        return ZERO

def scoped(n: i64) -> sview:
    return Names::ZERO

def accumulated(n: i64) -> sview:
    r = for i in 0..<n |acc = "zero"| -> acc:
        pass
    return r

def in_literal_arm(n: i64) -> sview:
    s = "zero"
    match n:
        0 | 1:
            return s
        _:
            return "many"
