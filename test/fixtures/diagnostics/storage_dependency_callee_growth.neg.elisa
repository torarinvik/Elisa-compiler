def bump(value: mutable i64&) -> void:
    value <- value + 1

def total(ys: darray[i64]&) -> i64:
    return ys.count.i64()

def grow(ys: mutable darray[i64]&) -> void:
    ys.push(9)

def scalar_borrow() -> i64:
    mutable xs: darray[i64] = [1, 2]
    r: i64& = &xs[1]
    bump(&xs[0])
    return r

def readonly_borrow() -> i64:
    mutable xs: darray[i64] = [1, 2]
    r: i64& = &xs[1]
    n: i64 = total(&xs)
    return r + n

def other_container() -> i64:
    mutable xs: darray[i64] = [1, 2]
    mutable ys: darray[i64] = [3]
    r: i64& = &xs[1]
    grow(&ys)
    return r

def rebound_after_growth() -> i64:
    mutable xs: darray[i64] = [1, 2]
    grow(&xs)
    r: i64& = &xs[1]
    return r

# Each branch declares a fresh view after its own growth; an earlier branch's invalidation of
# the same name does not carry over to the new binding.
def fresh_per_branch(k: i64) -> i64:
    if k == 1:
        xs: mutable darray[i64] = [1]
        grow(&xs)
        r: i64& = &xs[0]
        return r
    elif k == 2:
        xs: mutable darray[i64] = [2]
        grow(&xs)
        r: i64& = &xs[0]
        return r
    return 0
