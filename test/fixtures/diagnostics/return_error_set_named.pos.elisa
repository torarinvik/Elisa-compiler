# The named-struct wall carries the suffix as well; its row is pushed by a separate
# late pass, so this pins that the set is resolved from the ENCLOSING function.
error Bad:
    Neg

struct P:
    a: i64

def wrap(n: i64) -> P error[Bad]:
    can Abort.Panic:
        x: i64 = 3
        return x

def main() -> i32:
    can Memory.Allocate, Abort.Panic:
        return 0
