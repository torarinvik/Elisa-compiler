# `;` is not a supported statement separator; if parser recovery retains these statements,
# the assignment still must not be mistaken for the declaration's initializer by line number.
def same_line_reassign[@r](anchor: i64& @r) -> darray[i64] @r:
    values: mutable darray[i64] @r = []; automatic: mutable darray[i64] = []; values <- move automatic
    return move values
