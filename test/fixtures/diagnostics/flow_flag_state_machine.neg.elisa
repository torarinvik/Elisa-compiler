# Must stay SILENT for FlowFlagStateMachine — each case breaks one leg of the shape.
def probe(x: i64) -> bool:
    return x > 1


# Only ONE branch statement writes the flag (branch_writers < 2).
def single_branch(x: i64) -> i64:
    flag: mutable bool = false
    if probe(x):
        flag <- true
    if flag:
        return 1
    return 0


# Two branch writes but NO read after the join.
def no_read_after(x: i64) -> i64:
    flag: mutable bool = false
    if probe(x):
        flag <- true
    if probe(x + 1):
        flag <- true
    return x


# A straight-line write at the declaring level disqualifies the flag.
def level_write(x: i64) -> i64:
    flag: mutable bool = false
    if probe(x):
        flag <- true
    flag <- probe(x + 1)
    if probe(x + 2):
        flag <- true
    if flag:
        return 1
    return 0


# Not a bool: an accumulating counter is legitimate straight-line state.
def counter(x: i64) -> i64:
    total: mutable i64 = 0
    if probe(x):
        total <- total + 1
    if probe(x + 1):
        total <- total + 1
    return total
