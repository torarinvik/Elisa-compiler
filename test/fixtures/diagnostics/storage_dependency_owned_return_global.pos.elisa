# A callee that reads a buffer-carrying global stays out of the owned-return exemption: its
# by-value darray result may share the global's buffer, so the call is still treated as a
# view of its arguments. (The scalar-global widening must not reach a darray global.)
const BYTES: darray[u8] = [97, 98]

def pick(src: darray[u8]&) -> darray[u8]:
    if src.count == 0:
        return BYTES
    return []

def main() -> i32:
    buf: mutable darray[u8] = [97]
    got: darray[u8] = pick(&buf)
    for i in 0..<100 |buf|:
        buf.push(98)
    return got.count.i32()
