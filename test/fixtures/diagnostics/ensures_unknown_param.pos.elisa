# The control for ensures_unknown_param.neg: the SAME postcondition naming a real
# parameter. Nothing here may report an unknown parameter -- the check keys on the
# parameter list, and a method receiver (`ensures self => ...`, which the .elisai
# emitter writes for every typestate transition) is not always a ParamDecl, so `self`
# and `result` are deliberately outside it.
struct Job[state Ready | Done]:
    count: i64

    derive state:
        Ready when self.count > 0
        Done when self.count <= 0

def inspect(job: Job&) -> bool:
    return job.count > 0
