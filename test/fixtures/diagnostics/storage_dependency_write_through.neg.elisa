# Stores through an interior reference before any growth, or after rebinding it to the
# grown storage, are sound.

def before_growth(xs: mutable darray[i64]&, n: i64) -> i64:
    w: mutable i64& = &xs[0]
    w <- 5
    xs.push(n)
    return n

def rebound_after_growth(xs: mutable darray[i64]&, n: i64) -> i64:
    w: mutable i64& = &xs[0]
    xs.push(n)
    w <- &xs[0]
    w <- 5
    return w

def main() -> i32:
    return 0
