# Fuzz finding round 1 (test/fuzz_findings/region_block_local_used_after_block.elisa): stage1 accepted this; stage0 rejects it.
def scribble() -> i64:
    total: mutable i64 = 0
    for k in 0..<8:
        region junk(4096):
            fill: mutable darray[u8] @junk = []
            for i in 0..<512:
                fill.push(90.u8())
            total <- total + fill[0].i64()
    return total

def main() -> i64:
    region rg(4096):
        xs: mutable darray[i64] = [41, 42, 43]
    _ = scribble()
    return xs[0]
