# corpus: deliberate-decline -- stage0 ACCEPTS this and the program reads a dead frame; stage1
# rejects it on purpose (check_local_view_return_escape). Not a stage1 gap.
# A view into a frame-local fixed array must not be returned: the caller would read dead stack.
def leak() -> view[i64]:
    scratch: mutable i64[4] = zeroed
    return scratch[0:2]

def main() -> i64:
    v: view[i64] = leak()
    return v.len.i64()
