# Both compilers reject the escaping view; their diagnostic wording differs.
# A view into a frame-local fixed array must not be returned: the caller would read dead stack.
def leak() -> view[i64]:
    scratch: mutable i64[4] = zeroed
    return scratch[0:2]

def main() -> i64:
    v: view[i64] = leak()
    return v.len.i64()
