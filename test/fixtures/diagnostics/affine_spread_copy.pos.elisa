# A spread `[...xs]` is a bulk copy like `extend`: over a container whose element
# holds a linear handle it duplicates every handle, with or without `move`.
# stage0 lines: 22 param, 31 darray, 32 holder struct, 33 fixed array, 34 `move`.
# (stage0 also reports `ws` unconsumed: it does not yet count `[...move ws]` as a move.)
affine struct Handle:
    v: i64
struct Pair:
    a: Handle
def take(h: Handle) -> i64:
    return h.v
def drain(xs: darray[Handle]) -> i64:
    total: mutable i64 = 0
    for x in move xs:
        total <- total + x.v
    return total
def drain_pairs(ps: darray[Pair]) -> i64:
    total: mutable i64 = 0
    for p in move ps:
        total <- total + take(move p.a)
    return total
def copy_param(xs: darray[Handle]) -> i64:
    ys: darray[Handle] = [...xs]
    return drain(move xs) + drain(move ys)
def main() -> i32:
    xs: mutable darray[Handle] = []
    xs.push(Handle{v: 1})
    ps: mutable darray[Pair] = []
    ps.push(Pair{a: Handle{v: 2}})
    arr: Handle[1] = [Handle{v: 3}]
    ws: mutable darray[Handle] = []
    ys: darray[Handle] = [...xs]
    qs: darray[Pair] = [...ps]
    zs: darray[Handle] = [...arr]
    vs: darray[Handle] = [...move ws]
    return (drain(move xs) + drain(move ys) + drain_pairs(move ps) + drain_pairs(move qs) + drain(move zs) + drain(move vs)).i32()
