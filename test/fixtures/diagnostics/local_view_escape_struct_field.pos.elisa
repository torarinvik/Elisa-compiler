# A slice of a fixed-array field of a local struct dangles once the frame is gone (wrong answer:
# main reads a clobbered frame). Rule ported from stage0 q8.
struct S:
    buf: u8[4]

def f1() -> view[u8]:
    s: S = S{buf: [104, 105, 0, 0]}
    return s.buf[0:2]

def main() -> i32:
    v: view[u8] = f1()
    return v[0].i32()
