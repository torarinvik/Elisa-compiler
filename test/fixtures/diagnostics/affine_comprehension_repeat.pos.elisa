# STRICTER THAN stage0 (documented hole): a comprehension evaluates its element once per
# iteration, so `move g` of an outer handle moves it on every iteration. stage0 accepts the
# comprehension (it counts the move once) but rejects the same move in a statement `for`
# ("must be consumed before scope exit"). stage1 applies the loop rule to both: line 20.
affine struct Handle:
    v: i64

def release(h: Handle) -> i64:
    return h.v

def drain(xs: darray[Handle]) -> i64:
    total: mutable i64 = 0
    for x in move xs:
        total <- total + release(move x)
    return total

def main() -> i32:
    g: Handle = Handle{v: 7}
    n: i64 = 2
    zs: darray[Handle] = [move g for i in 0..<n]
    return drain(move zs).i32()
