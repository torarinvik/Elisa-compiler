struct Label:
    text: sview

def take(v: sview) -> i64:
    return 1

def literals(n: i64) -> sview:
    return "zero" if n == 0 else "many"

def annotated(n: i64) -> i64:
    s: sview = "zero"
    t: sview = s if n == 0 else "many"
    return take(s if n == 0 else "many")

def into_cstr(n: i64) -> cstr:
    s = "zero"
    return s if n == 0 else "many"
