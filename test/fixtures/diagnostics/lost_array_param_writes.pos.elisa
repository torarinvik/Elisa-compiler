# Writing through `mutable T[N]&` reaches the caller; a by-value copy that is
# read back (a scratch copy) is fine.
def fill(values: mutable i64[4]&, seed: i64) -> void:
    for index in 0..<4:
        values[index] <- seed + index.i64()

def sorted_middle(values: mutable i64[3]) -> i64:
    if values[0] > values[1]:
        first: i64 = values[0]
        values[0] <- values[1]
        values[1] <- first
    values[1]

def main() -> i32:
    data: mutable i64[4] = zeroed
    fill(&data, 3)
    0 if data[2] == 5 and sorted_middle([3, 1, 2]) == 3 else 1
