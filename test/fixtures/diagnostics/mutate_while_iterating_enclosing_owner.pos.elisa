# Replacing the OWNER of an iterated field (`s <- t` inside `for v in s.items:`, or any
# prefix of a longer chain) releases the field's buffer the iterator walks, exactly like
# replacing the field itself. stage0 7611ee2b names both the iterand and the replaced owner.
struct S:
    items: mutable darray[i64]
    itemsx: mutable darray[i64]
    n: mutable i64

struct O:
    s: mutable S
    k: mutable i64

def owner(s: mutable S&, t: S) -> void:
    for v in s.items:
        s <- t

def middle(o: mutable O&, t: S) -> void:
    for v in o.s.items:
        o.s <- t

def outer(o: mutable O&, t: O) -> void:
    for v in o.s.items:
        o <- t

def local_owner(t: S) -> i64:
    mutable s: S = t
    for v in s.items:
        s <- t
    return s.n

def main() -> i32:
    return 0
