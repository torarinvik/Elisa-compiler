# A named constant as an integer match arm is a BINDING pattern, not a literal, and
# stage0 rejects it in the value form exactly as in the statement form. stage1 once
# accepted this and matched every input on the first arm (elisa-ui's event decoder).
const K: i32 = 3

def classify(x: i32) -> i32:
    return match x:
        K:
            1
        _:
            0

def main() -> i32:
    return classify(3)
