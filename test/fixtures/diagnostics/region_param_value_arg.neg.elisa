# A by-value argument for an explicit `[@r]`-tied ref parameter: stage0 reports the argument
# mismatch and that `r` cannot be inferred (nothing in main binds it).
module M:
    struct S:
        n: mutable usize
    def get[@r](s: mutable S& @r) -> usize:
        return s.n

struct P:
    s: mutable M::S

struct T:
    n: usize

def peek[@r](t: T& @r) -> usize:
    return t.n

def bump[@r](n: mutable usize& @r) -> usize:
    return 0

def main() -> i32:
    p: mutable P = P{s: M::S{n: 0}}
    M::get(p.s)
    t: T = T{n: 1}
    peek(t)
    x: mutable usize = 3
    bump(x)
    return 0
