# Growth BEFORE the submit, or after the join, leaves the submitted view valid; a second nursery
# does not inherit the first one's joined tasks.
def first(s: sview) -> i64:
    return s[0].i64()

def main() -> i64:
    can Parallel, Memory.Allocate, Abort.Panic:
        buf: mutable darray[u8] = [65.u8()]
        nursery workers(2):
            buf.push(2.u8())
            submit first(buf.as_sview())
        buf.push(3.u8())
        nursery workers(2):
            buf.push(4.u8())
            submit first(buf.as_sview())
        return 0
