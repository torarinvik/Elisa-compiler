# A reference to a function-local escaping through a CONTAINER or an aggregate store into a
# caller's storage. Each dangles once the function returns (stage0 and stage1 both reject).

struct H:
    r: i64&

struct O:
    h: mutable H

struct R:
    r: mutable i64&

def push_ref(out: mutable darray[i64&]&) -> void:
    can Memory.Allocate, Abort.Panic:
        x: i64 = 5
        out.push(&x)

def push_bound_struct(out: mutable darray[H]&) -> void:
    can Memory.Allocate, Abort.Panic:
        x: i64 = 5
        h: H = H{r: &x}
        out.push(h)

def return_pushed_local() -> darray[i64&]:
    can Memory.Allocate, Abort.Panic:
        x: i64 = 5
        out: mutable darray[i64&] = []
        out.push(&x)
        return out

def store_struct(out: mutable O&) -> void:
    x: i64 = 5
    out.h <- H{r: &x}

def store_bound_struct(out: mutable O&) -> void:
    x: i64 = 5
    h: H = H{r: &x}
    out.h <- h

def store_ref_alias(out: mutable R&) -> void:
    x: i64 = 5
    r: i64& = &x
    out.r <- r

def main() -> i32:
    return 0
