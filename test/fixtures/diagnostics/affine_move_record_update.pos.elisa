# A record update moves each override in and consumes its base.
affine struct Handle:
    v: i64

struct Pair:
    a: Handle
    b: Handle

def field_site(p: Pair) -> Pair:
    t: Handle = Handle{v: 1}
    q: Pair = (move p){a = t}
    return move q

def base_site(p: Pair) -> Pair:
    t: Handle = Handle{v: 1}
    q: Pair = p{a = move t}
    return move q

def main() -> i32:
    return 0
