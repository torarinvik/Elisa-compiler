# Borrowing one declared owner out of a container or struct, or addressing a plain
# container or field, is fine.
affine struct Handle:
    v: i64

struct Other:
    n: i64

struct Holder:
    h: Handle
    n: i64

def release(h: Handle) -> i64:
    return h.v

def main() -> i32:
    xs: mutable darray[Handle] = []
    xs.push(Handle{v: 1})
    first: Handle& = &xs[0]
    n: i64 = first.v
    os: mutable darray[Other] = []
    b = &os
    _ = b
    for x in move xs:
        _ = release(move x)
    o: mutable Holder = Holder{h: Handle{v: 2}, n: 3}
    oh: Handle& = &o.h
    on: i64& = &o.n
    m: i64 = oh.v + on
    _ = release(move o.h)
    return (n + m).i32()
