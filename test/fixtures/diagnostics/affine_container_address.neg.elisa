# Borrowing one declared owner out of a container, or addressing a plain container, is fine.
affine struct Handle:
    v: i64

struct Other:
    n: i64

def release(h: Handle) -> i64:
    return h.v

def main() -> i32:
    xs: mutable darray[Handle] = []
    xs.push(Handle{v: 1})
    first: Handle& = &xs[0]
    n: i64 = first.v
    os: mutable darray[Other] = []
    b = &os
    _ = b
    for x in move xs:
        _ = release(move x)
    return n.i32()
