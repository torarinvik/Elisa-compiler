# Every fall-through path consumes the linear local; a path that returns early
# after consuming it contributes nothing to the merge.
linear struct Guard:
    active: bool

enum Pick:
    A
    B

def make() -> Guard:
    return Guard{active: true}

def release(g: Guard) -> void:
    _ = move g

def both_branches(c: bool) -> void:
    g: Guard = make()
    if c:
        release(move g)
    else:
        release(move g)

def early_return(c: bool) -> void:
    h: Guard = make()
    if c:
        release(move h)
        return
    release(move h)

def every_arm(p: Pick) -> void:
    m: Guard = make()
    match p:
        Pick.A:
            release(move m)
        Pick.B:
            release(move m)
