affine struct Handle:
    value: mutable i64

def finish(owned: Handle) -> i64:
    taken: Handle = move owned
    taken.value

def peek(handle: Handle&) -> i64:
    handle.value

def borrow_then_move() -> i64:
    owner: Handle = Handle{value: 1}
    borrow: Handle& = &owner
    total: i64 = peek(borrow)
    total + finish(move owner)

def borrow_and_drop() -> i64:
    owner: Handle = Handle{value: 1}
    borrow: Handle& = &owner
    peek(borrow)

def reinitialised() -> i64:
    owner: mutable Handle = Handle{value: 1}
    borrow: Handle& = &owner
    first: i64 = finish(move owner)
    owner <- Handle{value: 2}
    peek(borrow) + first + finish(move owner)
