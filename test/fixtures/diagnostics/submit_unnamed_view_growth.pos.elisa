# An unnamed view handed to a task lives until the nursery joins: growing its backing later in
# the body races the worker's read (stage0 rejects it as view "buf.as_sview()").
def first(s: sview) -> i64:
    return s[0].i64()

def main() -> i64:
    can Parallel, Memory.Allocate, Abort.Panic:
        buf: mutable darray[u8] = [65.u8()]
        nursery workers(2):
            submit first(buf.as_sview())
            for i in 0..<10000 |buf|:
                buf.push(1.u8())
        return 0
