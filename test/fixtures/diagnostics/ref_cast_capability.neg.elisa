# A cast keeps a `mutable` operand's write capability: `(&x).cast[void&]` of a `mutable` x
# is a `mutable void&`, the shape FFI code uses to hand a buffer to C.
def main() -> i32:
    x: mutable i64 = 2
    p: mutable void&? = null
    p <- (&x).cast[void&] can Unsafe.PointerCast
    return 0 if p == null else 1
