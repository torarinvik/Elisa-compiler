# A set element or dict key holding a linear handle is rejected wherever the type is
# written, not only for a bare affine struct: stage0's containsAffineHandleValues covers
# optionals, nested containers and aggregates. Each line below is one stage0 diagnostic.
linear struct Handle:
    fd: i64

struct Pair:
    a: Handle
    b: i64

struct Holder:
    s: set[Handle?]
    d: dict[Pair, i64]

def take(s: set[darray[Handle]]) -> i64:
    return 0

def keyed(d: dict[Handle?, i64]) -> i64:
    return 0

def main() -> i64:
    return 0
