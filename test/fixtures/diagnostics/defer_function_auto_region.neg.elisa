# stage0: `defer function` in a body that region-inference wraps (a region-less darray
# local) sits one scope too deep -> "defer function is currently only supported in the
# outermost function scope". stage1 used to accept this (permissive).
global mutable t: mutable i64 = 0

def run() -> i64:
    defer function:
        t <- 9
    xs: mutable darray[i64] = [1, 2, 3]
    return xs[0]

def main() -> i64:
    return run() + t
