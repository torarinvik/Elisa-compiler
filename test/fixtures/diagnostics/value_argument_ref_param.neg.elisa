# A `T&` parameter borrows a place: a computed scalar has none. stage1 used to pass the address
# of a temporary, so `first(input + offset)` (C pointer arithmetic) read one temporary.
def first(values: i64&) -> i64:
    values[0]

def bump(slot: mutable i64&) -> void:
    slot <- slot + 1

def shifted(input: i64&, offset: i64) -> i64:
    first(input + offset)

def negated(count: i64) -> void:
    bump(-count)
