# Rule R: a field write through a readonly `S&` is rejected, independently of the field's
# own mutability (here `b` is also immutable, which is reported first).
struct S:
    a: mutable i64
    b: i64

def bump(r: S&) -> void:
    r.b <- 7

def main() -> i32:
    s: mutable S = S{a: 1, b: 2}
    bump(&s)
    return s.a.i32()
