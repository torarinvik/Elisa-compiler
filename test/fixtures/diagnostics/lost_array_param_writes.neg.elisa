# A `mutable T[N]` parameter is a by-value COPY: `fill` writes it and never
# reads it back, so the caller's array stays zero. Rejected.
def fill(values: mutable i64[4], seed: i64) -> void:
    for index in 0..<4:
        values[index] <- seed + index.i64()

def main() -> i32:
    data: mutable i64[4] = zeroed
    fill(data, 3)
    data[2].i32()
