# Rule R at a call: casting the address of an immutable `y` to `void&` does not make it
# writable, so it cannot be passed where the callee may write through a `mutable void&`.
def poke(p: mutable void&) -> i32:
    return 0

def main() -> i32:
    y: i64 = 2
    return poke((&y).cast[void&] can Unsafe.PointerCast)
