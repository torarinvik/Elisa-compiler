# The loop as the function's final expression is its return value.
def all_positive(values: i64[3]) -> bool:
    for i in 0..<3 |valid: bool = true| -> valid:
        valid <- false if values[i] <= 0

# Bound to a name, the value is kept.
def all_positive_bound(values: i64[3]) -> bool:
    valid: bool = for i in 0..<3 |ok: bool = true| -> ok:
        ok <- false if values[i] <= 0
    return valid

# The statement form (no `-> name`) has no value to drop.
def scan(values: i64[3]) -> bool:
    for i in 0..<3 |seen: i64 = 0|:
        seen <- seen + values[i]
    true

# A yield of a CAPTURED outer binding loses nothing when dropped: the loop writes that
# binding in place.
def total_positive(values: i64[3]) -> i64:
    total: mutable i64 = 0
    for i in 0..<3 |total| -> total:
        total <- total + values[i] if values[i] > 0
    total
