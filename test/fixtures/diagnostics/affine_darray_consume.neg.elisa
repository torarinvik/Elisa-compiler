# Drained, moved or returned containers of handles are consumed; borrowed and plain
# elements hold nothing to consume.
affine struct Handle:
    v: i64

struct Other:
    n: i64

def release(h: Handle) -> i64:
    return h.v

def drain(xs: darray[Handle]) -> i64:
    total: mutable i64 = 0
    for x in move xs:
        total <- total + release(move x)
    return total

struct Bag:
    items: darray[Handle]

def chained() -> i32:
    # A move in a chained receiver or a record literal consumes (stage0 agrees; a move in
    # a value `if` does not count in stage0, so stage1 does not count it either).
    zs: mutable darray[Handle] = []
    return drain(move zs).i32()

def wrapped() -> i64:
    ys: mutable darray[Handle] = []
    bag: Bag = Bag{items: move ys}
    return drain(move bag.items)

def main() -> i32:
    a: mutable darray[Handle] = []
    a.push(Handle{v: 1})
    n: i64 = drain(move a)
    os: mutable darray[Other] = []
    os.clear()
    h: Handle = Handle{v: 2}
    refs: mutable darray[Handle&] = []
    refs.push(&h)
    refs.clear()
    return (n + release(move h)).i32()
