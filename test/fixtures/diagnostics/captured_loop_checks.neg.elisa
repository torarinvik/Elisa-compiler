# The correct forms of captured_loop_checks.pos: moves, consumes, and a separate
# destination darray inside `|...|` loops are accepted.
affine struct Handle:
    v: i64

linear struct Ticket:
    v: i64

def sink(h: Handle) -> i64:
    return h.v

def close(t: Ticket) -> i64:
    v: i64 = t.v
    _ = move t
    return v

def main() -> i32:
    total: mutable i64 = 0
    while total < 3 |total|:
        t: Handle = Handle{v: 1}
        total <- total + sink(move t)
    xs: darray[i64] = [1, 2, 3]
    ys: mutable darray[i64] = []
    for x in xs |ys|:
        ys.push(x)
    n: mutable i64 = 0
    while n < 2 |n|:
        k: Ticket = Ticket{v: 1}
        n <- n + close(move k)
    return (total + n + ys.count.i64()).i32()
