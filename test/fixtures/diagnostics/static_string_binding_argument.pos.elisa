# A `static u8&` binding passed to an sview parameter, positionally or by name.
def take(v: sview) -> i64:
    return 1

def positional(n: i64) -> i64:
    s = "zero"
    return take(s)

def named(n: i64) -> i64:
    s = "zero"
    return take(v: s)

def shadowed(n: i64) -> i64:
    s = "outer"
    if n == 0:
        s = "inner"
        return take(s)
    return 0

def let_binding(n: i64) -> i64:
    let s = "zero"
    return take(s)
