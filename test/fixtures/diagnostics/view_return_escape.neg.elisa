# Sound shapes that must stay silent: storage the caller owns, and a function that returns its
# container too (the caller's region is adopted, so the view outlives the call).
struct Both:
    items: darray[i64]
    v: view[i64]

def whole() -> darray[i64]:
    can Memory.Allocate:
        xs: mutable darray[i64] = []
        xs.push(1)
        xs.push(2)
        return xs

def of_ref(xs: darray[i64]&) -> view[i64]:
    return xs[0:2]

def of_view(p: view[i64]) -> view[i64]:
    v: view[i64] = p[0:2]
    return v[0:1]

def of_value_param(xs: darray[i64]) -> view[i64]:
    return xs[0:2]

def adopted() -> Both:
    xs: mutable darray[i64] = [1, 2, 3]
    return Both{items: xs, v: xs[0:2]}

def main() -> i32:
    can Memory.Allocate:
        ys: mutable darray[i64] = whole()
        b: Both = adopted()
        return (ys[1] + of_ref(&ys)[0] + of_view(ys[0:2])[0] + of_value_param(ys)[1] + b.v[1]).i32()
