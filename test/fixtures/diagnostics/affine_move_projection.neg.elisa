# Field and element reads that do not copy a handle out: an explicit `move`, a borrow,
# a `T&` field, and scalar reads through the handle. Accepted.
affine struct Handle:
    v: i64

struct Pair:
    h: Handle
    n: i64

struct RefPair:
    h: Handle&
    n: i64

def sink(h: Handle) -> i64:
    return h.v

def peek(h: Handle&) -> i64:
    return h.v

def moved(p: Pair) -> i64:
    return sink(move p.h)

def borrowed(p: Pair) -> i64:
    return peek(&p.h) + p.h.v + p.n

def ref_field(p: RefPair) -> i64:
    u: Handle& = p.h
    return u.v

def element_read(xs: view[Handle]) -> i64:
    return peek(&xs[0]) + xs[0].v

def main() -> i32:
    return 0
