# Rule R, user struct: the same shape as the .neg twin, but `SavedMark` is not a runtime
# builtin, so its source `region` field (not `mutable`) decides: the local is only
# rebindable and the store through it is rejected.
struct Region:
    next: mutable heap Region&?
    count: mutable usize

struct SavedMark:
    region: heap Region&?
    count: usize

def rewind(m: SavedMark):
    if m.region == null:
        return
    region: mutable heap Region& = m.region
    region.count <- m.count

def main() -> i32:
    return 0
