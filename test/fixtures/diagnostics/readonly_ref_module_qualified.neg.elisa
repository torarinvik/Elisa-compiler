# A readonly reference whose referent is a module-qualified struct. The note must spell
# the type the way stage0 does (`mutable M.S&`), not drop it (`mutable &`).
module M:
    struct S:
        n: mutable usize

def bump(s: M::S&) -> usize:
    s.n <- 5
    return s.n

def main() -> i32:
    q: mutable M::S = M::S{n: 0}
    r: M::S& = &q
    r.n <- 7
    bump(q)
    return 0
