struct Scalar:
    value: i64

struct Handles:
    value: darray[i64]

def copy_shadow() -> i64 can[Memory.Allocate, Abort.Panic]:
    region scratch(4096):
        values: mutable darray[i64] = []
        values.push(41)
        box: Handles = Handles{value: values}
        return match true:
            _:
                box: Scalar = Scalar{value: 7}
                box.value
