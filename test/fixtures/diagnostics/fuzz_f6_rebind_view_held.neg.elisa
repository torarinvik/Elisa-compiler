# Control for fuzz F6: a view taken AFTER the threading rebind is valid.
struct P:
    bytes: mutable darray[u8]

def lgrow(p: lmut P) -> i64:
    for i in 0..<4096 |p|:
        p.bytes <- p.bytes.push(1.u8())
    return 0

def main() -> i64:
    p: mutable P = P{bytes: [65.u8()]}
    rebind n: i64, p = lgrow(p)
    v: sview = p.bytes.as_sview()
    return v.len.i64() + n
