# Valid counterpart: a numeric variable as the END bound.
# The receiver is an sview, not a darray, ON PURPOSE — stage1 declines an unannotated
# array/darray slice (it would otherwise miscompile; see the decline in
# codegen_expr_index_fields.elisa), and a diagnostic-parity fixture must not double as
# a codegen probe.
def f(b: i64) -> void:
    s: sview = "hello"
    t = s[0:b]
    _ = t
