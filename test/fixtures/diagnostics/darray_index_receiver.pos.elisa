struct MGrid:
    rows: mutable darray[darray[i64]]

def a_ro(xss: darray[darray[i64]]&) -> void:
    xss[0].clear()

def a_field_rref(g: MGrid&) -> void:
    g.rows[0].clear()

def a_nested(xsss: darray[darray[darray[i64]]]&) -> void:
    xsss[0][1].clear()

def a_paren(xss: darray[darray[i64]]&) -> void:
    (xss[0]).clear()

def a_rebind_only(mutable xss: darray[darray[i64]]&) -> void:
    xss[0].truncate(1)

def a_arity(xss: mutable darray[darray[i64]]&) -> void:
    xss[0].push(1, 2)

def main() -> i32:
    return 0
