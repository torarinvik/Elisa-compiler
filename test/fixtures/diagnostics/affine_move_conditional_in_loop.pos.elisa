# corpus: deliberate-decline — stage0 accepts this double move (B8).
# A CONDITIONAL move in a loop body still moves the outer `t` again on a later iteration.
affine struct Handle:
    v: i64

def sink(h: Handle) -> i64:
    return h.v

def main() -> i32:
    t: Handle = Handle{v: 1}
    total: mutable i64 = 0
    while total < 3 |total|:
        if total > 0:
            total <- total + sink(move t)
        total <- total + 1
    return 0
