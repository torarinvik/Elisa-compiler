# A same-line generic sibling must not hide a concrete nonshareable type.
struct T:
    pointer: i64&

def consume(value: T) -> i64:
    return 0

#line 0 generic_sibling.elisa
def phantom[T]() -> void:
    pass

#line 0 concrete_owner.elisa
def send(value: T) -> void:
    can Parallel, Memory.Allocate, Abort.Panic:
        nursery workers(1):
            submit consume(value)

def main() -> i64:
    return 0
