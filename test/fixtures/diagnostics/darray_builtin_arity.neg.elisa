struct Stack:
    total: i64

impl Stack:
    def push(self: Stack, a: i64, b: i64) -> i64:
        return self.total + a + b

def main() -> i32:
    s: Stack = Stack{total: 0}
    n: i64 = s.push(1, 2)
    mutable ys: darray[i64] = []
    ys.push(n)
    ys.resize(2)
    ys.truncate(1)
    ys.clear()
    return ys.count.i32()
