def f(x: bool, y: bool) -> bool:
    return x and y

def expression_match_guard(n: i64, x: bool) -> bool:
    return match n:
        0 if n > 0 and x: n > 0 or x
        _: true

def statement_match_guard(n: i64, x: bool) -> i64:
    match n:
        0 if n > 0 or x:
            return 1 if n > 0 and x
        _:
            return 0
    return 0

error Problem:
    First
    Second

def fallible(flag: bool) -> i64 error[Problem]:
    raise Problem.First if flag
    return 0

def catch_guard(n: i64, x: bool) -> i64:
    return catch fallible(n > 0 or x):
        value:
            value
        error failure if n > 0 and x:
            return 1 if n > 0 or x
        error other:
            return 0
