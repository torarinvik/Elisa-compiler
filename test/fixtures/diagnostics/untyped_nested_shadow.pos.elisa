# Updating the outer local uses `<-`; a TYPED declaration shadows on purpose;
# a name that is new to the block is an ordinary local; loop binders are not
# declared locals.
def total(values: i64[4]&) -> i64:
    sum: mutable i64 = 0
    for index in 0..<4:
        sum <- sum + values[index]
        if values[index] < 0:
            sum: i64 = -values[index]
            doubled = sum * 2
            return doubled
    sum

def main() -> i32:
    data: i64[4] = [1, 2, 3, 4]
    0 if total(&data) == 10 else 1
