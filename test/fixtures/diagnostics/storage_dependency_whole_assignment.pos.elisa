# corpus: deliberate-decline -- a whole assignment `xs <- [..]` releases the buffer every interior
# reference into `xs` points at; each read below would touch freed memory.

def through_param(xs: mutable darray[i64]&) -> i64:
    r: i64& = &xs[0]
    xs <- [1, 2, 3]
    return r

def local_replace() -> i64:
    mutable xs: darray[i64] = [70, 2]
    r: i64& = &xs[0]
    xs <- [1, 2, 3]
    return r

def branch_replace(c: bool) -> i64:
    mutable xs: darray[i64] = [70, 2]
    r: i64& = &xs[0]
    if c:
        xs <- [1, 2, 3]
    return r

def main() -> i32:
    mutable ys: darray[i64] = [70, 2]
    return (through_param(&ys) + local_replace() + branch_replace(true)).i32()
