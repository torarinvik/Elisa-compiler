module Probe:
    enum Node layout(handle: u32):
        pass

    enum Expr is Node:
        Missing
        Value(value: i64)

    enum Stmt is Node:
        Return(value: Expr, line: u32)

    def consume(value: Expr) -> bool:
        return true

    def extract(statement: Stmt) -> bool:
        match statement:
            Stmt.Return(value, _):
                return consume(value)
