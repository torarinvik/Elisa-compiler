# corpus: deliberate-decline -- stage0 ACCEPTS this and the program segfaults (rc=139, measured
# 2026-09-28); stage1 rejects it on purpose (check_local_view_return_escape). Not a stage1 gap.
# A struct-literal field holding a view of a local darray dangles exactly like the bare slice.
struct Holder:
    v: view[i64]

def leak() -> Holder:
    can Memory.Allocate:
        xs: mutable darray[i64] = []
        xs.push(1)
        xs.push(2)
        return Holder{v: xs[0:2]}

def main() -> i32:
    h: Holder = leak()
    return h.v[1].i32()
