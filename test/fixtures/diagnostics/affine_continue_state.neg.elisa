# A value declared in the body, consumed and then `continue`d, was discharged in
# its own iteration: neither a repeated consume nor a use after consume.
affine struct Handle:
    v: i64
def take(h: Handle) -> i64:
    return h.v
def inner_decl(n: i64) -> i64:
    acc: mutable i64 = 0
    for i in 0..<3 |acc|:
        h: Handle = Handle{v: 1}
        if i == n:
            acc <- take(move h)
            continue
        acc <- acc + take(move h)
    return acc
def main() -> i32:
    return 0
