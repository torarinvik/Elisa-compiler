# corpus: deliberate-decline — stage0 accepts this double move (B8).
# The same double move through a `while` loop.
affine struct Handle:
    v: i64

def sink(h: Handle) -> i64:
    return h.v

def main() -> i32:
    t: Handle = Handle{v: 1}
    total: mutable i64 = 0
    while total < 3 |total|:
        total <- total + sink(move t)
    return total.i32()
