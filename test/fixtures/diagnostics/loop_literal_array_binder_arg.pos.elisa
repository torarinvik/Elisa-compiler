# A loop binder over a string-literal array is `static u8&`, not an sview;
# stage1 used to leave it untyped and emit invalid LLVM IR for the call.
def f(s: sview) -> i64:
    return i64(s.len)

def main() -> i64:
    total: mutable i64 = 0
    for w in ["ab", "cde"]:
        total += f(w)
    return total - 5
