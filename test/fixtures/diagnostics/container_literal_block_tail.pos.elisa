# A multi-line initializer parses as a BLOCK, and a block's tail is a temporary that
# inherits no region from the binding — so stage0 asks the literal to name one, exactly as
# it does for a ternary arm. Every declaration here is the accepted one-line form written
# over two lines.
def drop_one() -> void:
    xs: darray[i64] =
        [1]

def drop_after_statement() -> void:
    ys: darray[i64] =
        seed: i64 = 1
        [seed]

def drop_nested() -> void:
    nested: darray[darray[i64]] =
        [[1]]

def drop_ternary() -> void:
    b: bool = true
    chosen: darray[i64] =
        [1] if b else []
