# Typed bindings supply the allocation region to a block's tail and to each
# conditional arm, including when the literal has nested elements.
def drop_one() -> void:
    xs: darray[i64] =
        [1]

def drop_after_statement() -> void:
    ys: darray[i64] =
        seed: i64 = 1
        [seed]

def drop_nested() -> void:
    nested: darray[darray[i64]] =
        [[1]]

def drop_ternary() -> void:
    b: bool = true
    chosen: darray[i64] =
        [1] if b else []
