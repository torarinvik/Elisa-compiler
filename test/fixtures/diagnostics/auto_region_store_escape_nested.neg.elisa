# Scalars copy, a caller-lived value is already caller-lived, and a store into a LOCAL owner
# dies with the value — in loop bodies and match arms as much as in straight-line code.
struct Bag:
    items: mutable darray[i64]

struct Outer:
    bag: mutable Bag

enum Kind:
    A
    B

def scalar_push(b: mutable Bag&) -> void:
    for v in 0..<2:
        b.items.push(v)

def caller_lived(b: mutable Bag&, t: Bag&, k: Kind) -> void:
    for v in 0..<2:
        b.items <- t.items
    match k:
        Kind.A:
            b.items <- t.items
        Kind.B:
            pass

def local_owner(o: mutable Outer&) -> void:
    for v in 0..<2:
        local: mutable Bag = Bag{items: []}
        tmp: darray[i64] = []
        local.items <- tmp

# Extending from a local darray of SCALARS copies the elements; nothing escapes.
def scalar_extend_in_loop(dst: mutable darray[u32]&, xs: darray[i64]) -> void:
    for x in xs:
        tmp: mutable darray[u32] = []
        tmp.push(1)
        dst.extend(tmp)

def main() -> i32:
    return 0
