# corpus: deliberate-decline -- stage0 accepts the dangling view after default darray growth;
# stage1 rejects it because the backing storage is relocatable. The diagnostic smoke keeps this
# as a positive stage1 safety regression, while driver parity excludes the unsound stage0 case.
def bad() -> i32:
    # A default darray uses relocatable storage too, so an interior view is invalidated by growth.
    values: mutable darray[i32] = []
    values.push(100)
    first: i32& = &values[0]
    values.push(1)
    result: i32 = first[0]
    return result
