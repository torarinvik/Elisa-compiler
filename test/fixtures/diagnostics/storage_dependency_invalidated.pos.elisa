def bad() -> i32:
    # An explicitly chained darray can relocate its backing buffer when it grows.
    region scratch(1024) using chained
    values: mutable darray[i32] @scratch = []
    values.push(100)
    first: i32& = &values[0]
    values.push(1)
    result: i32 = first[0]
    destroy scratch
    return result
