def bad() -> i32:
    # A default darray uses relocatable storage too; this catches the stage1 gap where
    # only explicitly chained regions were invalidated after growth.
    values: mutable darray[i32] = []
    values.push(100)
    first: i32& = &values[0]
    values.push(1)
    result: i32 = first[0]
    return result
