# Mutations of an `lmut` parameter that ARE visible: a reassignment of the root,
# a plain field store, a `while` loop that captures it, a `mutable P&` parameter,
# a local, and a stdlib method (`pop`) that is not a builtin mutator.
struct P:
    items: mutable darray[i64]
    n: mutable i64
def step(p: lmut P, v: i64) -> void:
    p.items <- p.items.push(v)
    p.n <- p.n + v
def looped(p: lmut P) -> void:
    while i < 3 |p, i: i64 = 0|:
        p.items.push(i)
        i <- i + 1
def by_ref(p: mutable P&) -> void:
    p.items.push(1)
def local() -> void:
    q: mutable P = P{items: [], n: 0}
    q.items.push(1)
def popped(p: lmut P) -> void:
    x: i64? = p.items.pop()
def main() -> i32:
    return 0
