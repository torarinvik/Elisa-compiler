# A read-only borrow of the owner, an unrelated struct, an index loop and a call after the
# loop leave the iterated buffer alone.
struct P:
    items: mutable darray[i64]
    n: mutable i64

def step(p: mutable P&, v: i64) -> void:
    can Memory.Allocate, Abort.Panic:
        p.items.push(v)

def peek(p: P&) -> i64:
    return p.n

def read_only(p: mutable P&) -> i64:
    total: mutable i64 = 0
    for v in p.items:
        total <- total + peek(p)
    return total

def other_owner(p: mutable P&, q: mutable P&) -> void:
    for v in p.items:
        step(q, v)

def index_loop(p: mutable P&) -> void:
    for i in 0..<p.items.count:
        step(p, p.items[i])

def after_loop(p: mutable P&) -> void:
    total: mutable i64 = 0
    for v in p.items:
        total <- total + v
    step(p, total)

def main() -> i32:
    return 0
