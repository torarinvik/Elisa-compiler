# A logical operator requires a bool operand outright. An optional / container /
# tuple operand is firmly non-bool, so `and` / `or` / `not` over one is a type
# error (oracle: stage0 "logical operator requires bool operands").
def probe(o: i64?, p: i64?, xs: darray[i64], ys: darray[i64]) -> bool:
    optional_operands: bool = o and p
    container_operands: bool = xs or ys
    negated_optional: bool = not o
    return optional_operands and container_operands and negated_optional
