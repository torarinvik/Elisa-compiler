# Derived values and `@r`-annotated returns keep the tie (stage0 accepts all of these).
struct S:
    n: mutable usize
    m: usize

def field[@r](s: S& @r) -> usize:
    return s.n

def tied[@r](n: usize& @r) -> usize& @r:
    return n

def copied[@r](n: usize& @r) -> usize:
    m: usize = n
    return m

def summed[@r](n: usize& @r) -> usize:
    return n + 1

def plain_field[@r](s: S& @r) -> usize:
    return s.m

def main() -> i32:
    return 0
