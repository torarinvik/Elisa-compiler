# Rule R, runtime struct: stage0 registers ArenaMark as a builtin and skips this source
# declaration, so the builtin field spec decides -- and there `region` is `mutable`. The
# local is therefore writable, as elisacore_std/arena.elisa `arena_rewind` relies on.
struct Region:
    next: mutable heap Region&?
    count: mutable usize

struct ArenaMark:
    region: heap Region&?
    count: usize

def rewind(m: ArenaMark):
    if m.region == null:
        return
    region: mutable heap Region& = m.region
    region.count <- m.count

def main() -> i32:
    return 0
