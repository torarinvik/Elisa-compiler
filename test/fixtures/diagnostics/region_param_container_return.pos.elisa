# Moving an auto-region local out of a non-region-polymorphic function remains unsafe.
def leak() -> darray[i64]:
    values: mutable darray[i64] = []
    values.push(7)
    return move values

# A local explicitly allocated in a different caller region cannot borrow the return contract.
def mismatch[@r, @s](r_anchor: i64& @r, s_anchor: i64& @s) -> darray[i64] @r:
    values: mutable darray[i64] @s = []
    values.push(7)
    return move values

# Flow-insensitive root discovery must not let an outer @r binding authorize a shadow.
def shadow[@r](anchor: i64& @r) -> darray[i64] @r:
    values: mutable darray[i64] @r = []
    if true:
        values: mutable darray[i64] = []
        values.push(7)
        return move values
    return []
