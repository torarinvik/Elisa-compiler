# Not bulk copies: a single element pushed with `move`, a whole container pushed
# into a darray of containers, an empty list literal as one element, and bulk
# copies of plain data. Silent in stage0.
affine struct Handle:
    v: i64
def drain(xs: darray[Handle]) -> i64:
    total: mutable i64 = 0
    for x in move xs:
        total <- total + x.v
    return total
def drain_nested(ts: darray[darray[Handle]]) -> i64:
    total: mutable i64 = 0
    for t in move ts:
        total <- total + drain(move t)
    return total
def main() -> i32:
    ys: mutable darray[Handle] = []
    g: Handle = Handle{v: 1}
    ys.push(move g)
    t: mutable darray[darray[Handle]] = []
    inner: darray[Handle] = []
    t.push(move inner)
    t.push([])
    ns: mutable darray[i64] = []
    ms: darray[i64] = [1, 2]
    ns.extend(ms)
    ns.push([3, 4])
    total: mutable i64 = 0
    for y in ys:
        total <- total + y.v
    return (total + ns.count.i64() + drain(move ys) + drain_nested(move t)).i32()
