# The same binding with the row spelled on the type (`can[Global]` names the family that
# `Global.Write` belongs to), a plain function bound to a plain type, a declared
# `can[Memory.Allocate]` function bound to `can[Memory]`, and a parameter that shadows an
# effectful top-level function (the value is the parameter, not `bump`). All accepted by stage0.
global mutable gacc: i64 = 1

def bump(n: i64) -> i64:
    gacc <- gacc + n
    return n

def plain(n: i64) -> i64:
    return n + 1

def grow(n: i64) -> i64 can[Memory.Allocate]:
    xs: darray[i64] = [n]
    return xs[0]

def through(bump: fn(i64) -> i64, n: i64) -> i64:
    g: fn(i64) -> i64 = bump
    return g(n)

def main() -> i64:
    g: fn(i64) -> i64 can[Global] = bump
    p: fn(i64) -> i64 = plain
    m: fn(i64) -> i64 can[Memory] = grow
    return g(3) + p(1) + m(2) + through(plain, 4) + gacc
