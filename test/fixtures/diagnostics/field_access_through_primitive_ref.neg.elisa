# A reference to a primitive does not provide struct fields.
# Stage0 and Stage1 must both reject this at driver level.

def probe(buf: mutable u8&) -> i64:
    return 1 if buf.count > 0 else 0

# Extern contracts use a separate semantic walk; they must enforce the same rule.
extern probe_contract(buf: mutable u8&) -> i64 requires buf.count > 0
