# Moved payloads, and a borrow stored in a `Handle&` payload: accepted.
affine struct Handle:
    v: i64

enum Box:
    Full(Handle)
    Tagged(h: Handle, n: i64)
    Lent(Handle&)
    Empty

def peek(t: Handle&) -> i64:
    l: Box = Box.Lent(t)
    return 1

def main() -> i32:
    t: Handle = Handle{v: 1}
    seen: i64 = peek(&t)
    b: Box = Box.Full(move t)
    u: Handle = Handle{v: 2}
    c: Box = Box.Tagged(h: move u, n: 2)
    w: Handle = Handle{v: 3}
    _ = move w
    return seen.i32()
