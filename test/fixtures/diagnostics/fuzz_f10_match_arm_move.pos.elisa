# Fuzz finding round 1 (test/fuzz_findings/aff_match_arm_move_then_move.elisa): stage1 accepted this; stage0 rejects it.
affine struct Hd:
    v: i64

def take(h: Hd) -> i64:
    return h.v

def main() -> i64:
    h: Hd = Hd{v: 7}
    k: i64 = 1
    t: i64 = match k:
        1: take(move h)
        _: 0
    return t + take(move h)
