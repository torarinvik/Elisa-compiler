# A function whose inferred effect row includes Global (it writes a global) bound to a plain
# `fn(i64) -> i64`: stage0 compares the rows and rejects (variable "g" expects fn(i64) -> i64,
# got fn(i64) -> i64 can[Global]). stage1 built and ran it (fuzz_findings/fn_value_effect_row_ignored).
global mutable gacc: i64 = 1

def bump(n: i64) -> i64:
    gacc <- gacc + n
    return n

def main() -> i64:
    g: fn(i64) -> i64 = bump
    return g(3) + gacc
