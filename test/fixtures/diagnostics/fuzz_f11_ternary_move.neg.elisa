# Control for fuzz F11: both ternary branches consume, nothing uses the handle after.
affine struct Hd:
    v: i64

def take(h: Hd) -> i64:
    return h.v

def flag() -> bool:
    return true

def main() -> i64:
    h: Hd = Hd{v: 7}
    t: i64 = take(move h) if flag() else take(move h)
    return t
