# Passing an OWNER of the iterated field chain into a writing parameter lets the callee
# push/clear/replace the field through it and relocate the buffer the loop walks: with `step`
# clearing and refilling p.items, `for v in p.items: step(p, v)` read the overwritten buffer
# (exit 151 instead of 10 in both compilers). stage0 names the owner and the iterand.
struct P:
    items: mutable darray[i64]
    n: mutable i64

struct O:
    p: mutable P
    k: mutable i64

def step(p: mutable P&, v: i64) -> void:
    can Memory.Allocate, Abort.Panic:
        if v == 1:
            p.items.clear()
            p.items.push(50)
        p.n <- p.n + v

def thread(p: lmut P) -> void:
    can Memory.Allocate, Abort.Panic:
        p.items <- p.items.push(1)

def count_of(p: mutable P&) -> i64:
    return p.n

def direct(p: mutable P&) -> void:
    for v in p.items:
        step(p, v)

def nested_owner(o: mutable O&) -> void:
    for v in o.p.items:
        step(&o.p, v)

def outer_owner_value(o: mutable O&) -> i64:
    total: mutable i64 = 0
    for v in o.p.items:
        total <- total + count_of(o.p)
    return total

def threaded(p: lmut P) -> void:
    for v in p.items |p|:
        p <- p.thread()

def main() -> i32:
    return 0
