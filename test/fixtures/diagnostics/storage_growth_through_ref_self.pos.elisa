# A view INTO the grown field still dies with the relocation.
struct State:
    depth: mutable i64
    names: mutable darray[i64]

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    rows: mutable State[1] = [State{depth: 0, names: []}]
    rows[0].names += 1
    first: i64& = &rows[0].names[0]
    rows[0].names += 2
    return first
