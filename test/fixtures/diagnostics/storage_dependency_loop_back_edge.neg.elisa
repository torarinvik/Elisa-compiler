# Loops whose interior references are fresh on every iteration: declared in the body, rebound
# before the first read, rebound after the growth, or the growing path leaves the loop.
def declared_in_body(xs: mutable darray[i64]&, n: i64) -> i64:
    total: mutable i64 = 0
    for i in 0..<n |total, xs|:
        r: i64& = &xs[0]
        total <- total + r
        xs.push(i)
    return total

def rebound_first(xs: mutable darray[i64]&, n: i64) -> i64:
    mutable r: i64& = &xs[0]
    total: mutable i64 = 0
    for i in 0..<n |total, xs, r|:
        r <- &xs[0]
        total <- total + r
        xs.push(i)
    return total

def always_breaks(xs: mutable darray[i64]&, n: i64) -> i64:
    r: i64& = &xs[0]
    total: mutable i64 = 0
    for i in 0..<n |total, xs, r|:
        total <- total + r
        xs.push(i)
        break
    return total

def rebound_at_end(xs: mutable darray[i64]&, n: i64) -> i64:
    mutable r: i64& = &xs[0]
    total: mutable i64 = 0
    for i in 0..<n |total, xs, r|:
        total <- total + r
        xs.push(i)
        r <- &xs[0]
    return total

def growth_breaks(xs: mutable darray[i64]&, n: i64) -> i64:
    r: i64& = &xs[0]
    total: mutable i64 = 0
    for i in 0..<n |total, xs, r|:
        total <- total + r
        if i > 2:
            xs.push(i)
            break
    return total
