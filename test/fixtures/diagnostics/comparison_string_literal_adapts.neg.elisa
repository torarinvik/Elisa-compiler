# stage0 ACCEPTS a bare string literal against a numeric operand (it adapts to a byte
# comparison) — verified through -emit obj, not just the analyzer. stage1 used to reject
# these. The f64 case holds too but is left out: it trips the unrelated stage1-only
# float-equality warning, which would make this fixture's count nonzero for another reason.
def f(n: i64, c: char) -> bool:
    return n == "s" or c == "s"
