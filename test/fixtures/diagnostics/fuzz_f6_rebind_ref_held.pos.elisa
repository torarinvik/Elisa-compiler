# Fuzz finding round 1 (test/fuzz_findings/lmut_rebind_ref_held_across_growth.elisa): stage1 accepted this; stage0 rejects it.
struct P:
    items: mutable darray[i64]

def lgrow(p: lmut P) -> i64:
    for i in 0..<4096 |p|:
        p.items <- p.items.push(1)
    return 0

def main() -> i64:
    p: mutable P = P{items: [41]}
    pad: mutable darray[i64] = [7]
    x: i64& = &p.items[0]
    rebind n: i64, p = p.lgrow()
    p.items[0] <- 66
    return x + n
