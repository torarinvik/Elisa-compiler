typestate ProtocolFile:
    id: i64
    states: Closed, Open
    transition open_file: Closed -> Open
    transition read_file: Open -> Open

def invalid(file: mutable ProtocolFile[Closed]&, count: usize) ensures file => Open:
    for index in 0..<count |file|:
        open_file(file)
    read_file(file)
