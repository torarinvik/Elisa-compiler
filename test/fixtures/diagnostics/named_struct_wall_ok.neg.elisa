# The silence side: a struct value fits its own wall, and a non-primitive value against a
# struct wall is unmodelled -- neither may be flagged.
struct P:
    a: i64

def make() -> P:
    can Abort.Panic:
        return P{a: 1}

def sink(v: P) -> void:
    pass

def f() -> void:
    can Memory.Allocate, Abort.Panic:
        q: mutable P = P{a: 1}
        q <- make()
        q <- P{a: 2}
        sink(q)
        sink(make())
