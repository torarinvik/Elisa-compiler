# The same store into a LOCAL array of references stays legal: both die with the frame.
const NB: usize = 4

struct Entry:
    tag: mutable i64

def main() -> i64:
    can Abort.Panic:
        cache: mutable Entry&?[NB] = zeroed
        a: mutable Entry = Entry{tag: 7}
        cache[0] <- &a
        entry: Entry&? = cache[0]
        if entry == null:
            return 0
        return entry.tag * 6
