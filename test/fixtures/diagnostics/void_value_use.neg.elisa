def g() -> i64:
    return 1

def f() -> void:
    y: i64 = g()

# A void pointee is not a void result. Both binding and returning the
# optional opaque pointer must stay outside VoidValueUse diagnostics.
extern opaque_pointer() -> mutable heap void&?

def bind_opaque_pointer() -> void:
    pointer: mutable heap void&? = opaque_pointer()

def return_opaque_pointer() -> mutable heap void&?:
    return opaque_pointer()
