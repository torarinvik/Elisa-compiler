# Fuzz finding round 1 (test/fuzz_findings/lmut_field_grow_in_region_block.elisa): stage1 accepted this; stage0 rejects it.
struct T:
    text: mutable darray[u8]

def f(table: lmut T) -> i64:
    region fzr(4096):
        for index in 0..<4096 |table| -> table:
            table.text.push(65)
    return 0

def scribble() -> i64:
    total: mutable i64 = 0
    for k in 0..<8:
        region junk(4096):
            fill: mutable darray[u8] @junk = []
            for i in 0..<512:
                fill.push(90.u8())
            total <- total + fill[0].i64()
    return total

def main() -> i64:
    t: mutable T = T{text: [66.u8()]}
    rebind n: i64, t = f(t)
    _ = scribble()
    return t.text[4000].i64() + n
