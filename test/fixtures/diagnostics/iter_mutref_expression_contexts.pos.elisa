# Calls that receive the actively iterated darray by mutable reference can relocate its
# backing buffer regardless of which expression position evaluates the call.
def grow(xs: mutable darray[i64]&) -> i64:
    can Memory.Allocate, Abort.Panic:
        xs.push(99)
    return 1

def grow_named(note: i64, xs: mutable darray[i64]&) -> i64:
    can Memory.Allocate, Abort.Panic:
        xs.push(note)
    return 1

def identity(value: i64) -> i64:
    return value

def if_condition(xs: mutable darray[i64]&) -> void:
    can Memory.Allocate, Abort.Panic:
        for value in xs:
            if grow(xs) > 0:
                pass

def nested_condition(xs: mutable darray[i64]&) -> void:
    can Memory.Allocate, Abort.Panic:
        for value in xs:
            if identity(grow(xs)) > 0:
                pass

def while_condition(xs: mutable darray[i64]&) -> void:
    can Memory.Allocate, Abort.Panic:
        for value in xs:
            while grow(xs) > 0:
                break

def declaration_initializer(xs: mutable darray[i64]&) -> void:
    can Memory.Allocate, Abort.Panic:
        for value in xs:
            keep_going: i64 = grow(xs)
            _ = keep_going

def assignment_value(xs: mutable darray[i64]&) -> void:
    mutable keep_going: i64 = 0
    can Memory.Allocate, Abort.Panic:
        for value in xs:
            keep_going <- grow(xs)

def match_scrutinee(xs: mutable darray[i64]&) -> void:
    can Memory.Allocate, Abort.Panic:
        for value in xs:
            outcome: i64 = match grow(xs):
                1: 1
                _: 0
            _ = outcome

def named_arguments(xs: mutable darray[i64]&) -> void:
    can Memory.Allocate, Abort.Panic:
        for value in xs:
            if grow_named(xs: xs, note: 99) > 0:
                pass

def value_block_alias(xs: mutable darray[i64]&) -> void:
    can Memory.Allocate, Abort.Panic:
        for value in xs:
            keep_going: i64 =
                alias: mutable darray[i64]& = xs
                grow(alias)
            _ = keep_going

def main() -> i32:
    return 0
