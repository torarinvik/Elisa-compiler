# `requires`/`ensure` have no prologue inside a nested body: wrapping one in a
# `can`/`region`/`trusted` block, an `if`, a loop or a match arm must not hide it.
def a(x: i64) -> i64:
    can Memory.Allocate:
        ensure result > 0
    return x
def b(x: i64) -> i64:
    if x > 0:
        requires x > 0
    return x
def c(x: i64) -> i64:
    while x < 0:
        ensure result > 0
    return x
def d(x: i64) -> i64:
    match x:
        0:
            requires x == 0
        _:
            pass
    return x
def e(x: i64) -> i64:
    region scratch:
        requires x > 0
    return x

# A proof-carrying contract (`ensure C by scoped:`) is still a contract.
def g(n: i64) -> i64:
    x: i64 = n
    ensure result >= 5 by scoped:
        pass
    return x + 10
