# The optional forms stay silent. Both sites already exclude optionals by SHAPE — the
# darray extractor matches only a bare Ident element, and the struct check gates on
# is_bare_primitive_type — so no optional test was needed in either wall.
struct Q:
    x: i64?

def f() -> void:
    xs: darray[i64?] = [1, null]
    q: Q = Q{x: null}
    _ = xs
    _ = q
