# A module-qualified callee that returns a buffer-carrying global keeps the view treatment:
# the qualified-call exemption must honour the same global taint as a bare call.
const BYTES: darray[u8] = [97, 98]

module Imp:
    public:
        def pick(src: darray[u8]&) -> darray[u8]:
            if src.count == 0:
                return BYTES
            return []

def main() -> i32:
    buf: mutable darray[u8] = [97]
    got: darray[u8] = Imp::pick(&buf)
    for i in 0..<100 |buf|:
        buf.push(98)
    return got.count.i32()
