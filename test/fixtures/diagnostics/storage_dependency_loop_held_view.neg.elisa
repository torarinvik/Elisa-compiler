# Loop shapes that must stay accepted: the backing grows only BEFORE the loop, or each
# iteration takes a fresh local view that does not outlive the pass.
def consume(view: sview) -> i64:
    return 1

def regrown_then_read(n: i64) -> i64:
    storage: mutable darray[u8] = []
    storage.push(97)
    held: mutable darray[sview] = []
    for i in 0..<n |held, storage|:
        held.push(storage.as_sview())
    total: mutable i64 = 0
    for view in held |total|:
        total <- total + consume(view)
    return total

def local_view(n: i64) -> i64:
    storage: mutable darray[u8] = []
    total: mutable i64 = 0
    for i in 0..<n |storage, total|:
        storage.push(97)
        view: sview = storage.as_sview()
        total <- total + consume(view)
    return total

def main() -> i32:
    return (regrown_then_read(2) + local_view(2) - 4).i32()
