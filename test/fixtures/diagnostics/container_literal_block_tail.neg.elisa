# The four shapes that keep their region and must stay silent: the one-line binding (the
# binding IS the destination), a fixed `array` (stack storage, no region to take), an empty
# literal (it allocates nothing), and a returned local (the return auto-region-wraps the
# body, which is the exemption the whole rule turns on).
def keep_inline() -> void:
    xs: darray[i64] = [1]

def keep_fixed() -> void:
    xs: array[i64, 1] =
        [1]

def keep_empty() -> void:
    xs: darray[i64] =
        []

def keep_returned() -> darray[i64]:
    xs: darray[i64] =
        [1]
    return xs
