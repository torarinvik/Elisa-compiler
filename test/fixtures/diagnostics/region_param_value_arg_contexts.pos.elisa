# Arguments that already carry a region are fine in every context: a ref parameter,
# an owning container value, and a ref local passed on through a `region r:` block.
struct S:
    n: mutable usize
struct C:
    xs: mutable darray[usize]
def get[@r](s: mutable S& @r) -> usize:
    return s.n
def getc[@r](c: mutable C& @r) -> usize:
    return c.xs.count
def through_param(s: mutable S&) -> usize:
    k: usize = get(s)
    if k == 0:
        return get(s)
    return 1 + get(s)
def owning() -> usize:
    c: mutable C = C{xs: []}
    return getc(c)
def main() -> i32:
    return 0
