# Leading contracts (in any order) stay legal, and a nested body with no
# `requires`/`ensure` is not flagged.
def f(x: i64) -> i64:
    decreases x
    requires x > 0
    ensure result > 0
    can Memory.Allocate:
        assert x > 0
    return x


lemma weaken(x: i64):
    requires x >= 10
    ensure x >= 5
    pass

def h(n: i64) -> i64:
    ensure result >= 5 by scoped:
        assert(result >= 10)
        weaken(result)
    return n + 10
