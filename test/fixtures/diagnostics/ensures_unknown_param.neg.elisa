# stage0 (analyzer_func_types.go) refuses an `ensures <name> => <State>` whose <name> is
# not a parameter of the function, BEFORE it ever looks at the target's type. stage1
# resolved the name against the parameter list and, finding nothing, dropped the
# postcondition silently -- so this whole file compiled clean.
struct Job[state Ready | Done]:
    count: i64

    derive state:
        Ready when self.count > 0
        Done when self.count <= 0

def finish(job: mutable Job&) -> bool ensures nosuch => Ready:
    return job.count > 0
