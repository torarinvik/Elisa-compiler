# A fresh by-value return owns its storage, resolved by MODULE: an unrelated same-named
# function elsewhere (`Clip::read`, returning a qualified struct) must not take the owned-return
# exemption away from `Tracks::read`, and a qualified callee (`Ops::run`) resolves to the
# module it names. Stage0 accepts this; stage1 rejected `cleaned` as a view of `doc`.
module Geo:
    public:
        struct P:
            x: f32
            y: f32

module Clip:
    public:
        struct Clip:
            data: darray[f32]

        def read(clip: Clip&, frame: usize, bone: usize) -> Geo::P:
            at: usize = frame + bone
            return Geo::P{x: clip.data[at], y: clip.data[at + 1]}

module Ops:
    public:
        def run(source: darray[i64]&, scratch: mutable darray[i64]&) -> darray[i64]:
            scratch.push(1)
            out: mutable darray[i64] = []
            out.extend(source)
            return out

module Tracks:
    public:
        struct Doc:
            values: mutable darray[i64]

        def read(doc: Doc&, slot: usize, component: usize) -> darray[i64]:
            out: mutable darray[i64] = []
            for v in doc.values |out|:
                out.push(v)
            return out

        def grow(doc: mutable Doc&, values: darray[i64]&) -> i64:
            doc.values.extend(values)
            return 1

        def run(doc: mutable Doc&) -> i64:
            changed: mutable i64 = 0
            for component in 0..<2 |doc, changed|:
                source: darray[i64] = read(doc, 0, component)
                scratch: mutable darray[i64] = []
                result: darray[i64] = Ops::run(source, &scratch)
                cleaned: mutable darray[i64] = []
                cleaned.extend(result)
                changed <- changed + grow(doc, cleaned)
            return changed

def main() -> i32:
    can Memory.Allocate, Memory.Release, Abort.Panic:
        doc: mutable Tracks::Doc = Tracks::Doc{values: [1, 2]}
        clip: Clip::Clip = Clip::Clip{data: [1.0, 2.0, 3.0]}
        p: Geo::P = Clip::read(clip, 0, 0)
        return Tracks::run(&doc).i32() + p.x.i32()
