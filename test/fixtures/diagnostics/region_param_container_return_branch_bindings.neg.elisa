# Both branch-local bindings are explicitly tied to @r and returned only in their active scope.
# Same-name declarations in the other branch must not make either return look like an auto root.
def keep_branch[@r](anchor: i64& @r, choose: bool) -> darray[i64] @r:
    if choose:
        values: mutable darray[i64] @r = []
        return move values
    else:
        values: mutable darray[i64] @r = []
        return move values
