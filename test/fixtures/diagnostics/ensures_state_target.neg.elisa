# stage0 (analyzer_func_types.go) refuses an `ensures <param> => <State>` postcondition
# whose target does not resolve to a named-state-bearing type: there is no state to move
# the target into. `ParseJob` is a plain struct, so the postcondition is unsatisfiable.
struct ParseJob:
    count: i64

def finish(job: mutable ParseJob&) -> bool ensures job => Ready:
    return true
