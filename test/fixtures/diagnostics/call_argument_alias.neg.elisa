# Disjoint or read-only argument pairs are not aliasing violations.
struct Pair:
    a: mutable i64
    b: mutable i64

def f(a: mutable i64&, b: mutable i64&) -> i64:
    a <- 1
    b <- 2
    return a

def return_same[@r](source: mutable i64& @r) -> mutable i64& @r:
    return source

def reads(a: i64&, b: i64&) -> i64:
    return a + b

def by_value(a: mutable i64&, b: i64) -> i64:
    a <- b
    return a

def distinct_locals() -> i64:
    x: mutable i64 = 0
    y: mutable i64 = 0
    return f(&x, &y)

def distinct_fields() -> i64:
    p: mutable Pair = Pair{a: 1, b: 2}
    return f(&p.a, &p.b)

def distinct_literal_indices() -> i64:
    v: mutable darray[i64] = [1, 2]
    return f(&v[0], &v[1])

def shared_reads() -> i64:
    x: i64 = 3
    return reads(&x, &x)

def copied_value() -> i64:
    x: mutable i64 = 3
    return by_value(&x, x)

def granted() -> i64:
    z: mutable i64 = 0
    can Unsafe.Alias:
        return f(&z, &z)

def trusted_grant() -> i64:
    w: mutable i64 = 0
    trusted Unsafe.Alias:
        return f(&w, &w)

def returned_ref_explicit_grant(source: mutable i64&) -> i64 can[Unsafe.Alias]:
    alias: mutable i64& = return_same(source)
    can Unsafe.Alias:
        return f(source, alias)

# Two references to the same container HEADER: never noalias-stamped and cannot dangle;
# stage0 accepts this in every mode (its disjointness proof gates the attribute).
def append_both(y: mutable darray[i64]&, x: mutable darray[i64]&) -> i64:
    y.push(1)
    x.push(2)
    return y.count.i64()

def shared_container() -> i64:
    v: mutable darray[i64] = []
    return append_both(&v, &v)

# A ref local of a different place, or one that is ever reassigned, is not resolved.
def distinct_ref_local() -> i64:
    x: mutable i64 = 0
    y: mutable i64 = 0
    r: mutable i64& = &y
    return f(r, &x)

def reassigned_ref_local() -> i64:
    x: mutable i64 = 0
    y: mutable i64 = 0
    mutable r: mutable i64& = &x
    r <- &y
    return f(r, &x)

# A receiver distinct from the arguments, and builtin methods, are not flagged.
struct Cell:
    v: mutable i64

def poke(self: mutable Cell&, other: mutable i64&) -> i64:
    self.v <- 1
    other <- 2
    return self.v

def distinct_receiver() -> i64:
    c: mutable Cell = Cell{v: 0}
    x: mutable i64 = 0
    v: mutable darray[i64] = [1]
    v.push(v[0])
    return c.poke(&x) + x.f(&c.v)

def main() -> i32:
    return (distinct_locals() + distinct_fields() + distinct_literal_indices() + shared_reads() + copied_value() + granted() + trusted_grant() + shared_container() + distinct_ref_local() + reassigned_ref_local() + distinct_receiver()).i32()
