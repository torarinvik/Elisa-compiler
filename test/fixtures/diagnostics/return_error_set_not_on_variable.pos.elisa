# The suffix belongs to the RETURN TYPE, never to a local declaration, even inside a
# fallible function. Both sentences come from the same check.
error Bad:
    Neg

def both(n: i64) -> i64 error[Bad]:
    can Abort.Panic:
        b: bool = 5
        return null

def main() -> i32:
    can Memory.Allocate, Abort.Panic:
        return 0
