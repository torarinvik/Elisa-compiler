# corpus: deliberate-decline -- stage0 accepts the dangling view after default darray growth
# (see storage_dependency_invalidated.pos); stage1 rejects it, including when the only read is
# a ternary condition, which the invalidated-use walker used to skip.
def bad() -> i32:
    values: mutable darray[i32] = []
    values.push(100)
    first: i32& = &values[0]
    values.push(1)
    return 1 if first[0] == 100 else 0
