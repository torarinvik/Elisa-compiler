error AErr:
    ABad

error BErr:
    BBad

module Mods::A:
    public:
        def step(n: i64) -> i64 error[AErr]:
            raise AErr.ABad if n < 0
            return n + 1

module Mods::B:
    public:
        def probe() -> bool error[BErr]:
            value: i64 = try Mods::A::step(1)
            return value > 0

def main() -> i64:
    return 0
