struct BranchBox:
    values: darray[i64]

def leak_branch_tainted_box(copy_value: bool) -> BranchBox can[Memory.Allocate, Abort.Panic]:
    region scratch(4096):
        values: mutable darray[i64] = []
        values.push(41)
        box: mutable BranchBox = BranchBox{values: []}
        if copy_value:
            box <- BranchBox{values: values}
        return box
