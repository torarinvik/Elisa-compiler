# Copying an affine field (`p.h`, `o.p.h`) or element (`xs[i]`) out without `move`: each
# site copies the handle while the original stays reachable through `p` / `xs`.
affine struct Handle:
    v: i64

struct Pair:
    h: Handle
    n: i64

struct Outer:
    p: Pair

enum Box:
    Full(Handle)

def sink(h: Handle) -> i64:
    return h.v

def local_init(p: Pair) -> i64:
    u: Handle = p.h
    return sink(move u)

def untyped_init(p: Pair) -> i64:
    u = p.h
    return sink(move u)

def call_path(o: Outer) -> i64:
    return sink(o.p.h)

def returned(p: Pair) -> Handle:
    return p.h

def assigned(p: Pair, u: mutable Handle) -> Handle:
    u <- p.h
    return move u

def literal_field(p: Pair) -> Pair:
    q: Pair = Pair{h: p.h, n: 1}
    return move q

def payload(p: Pair) -> Box:
    b: Box = Box.Full(p.h)
    return move b

def element(xs: view[Handle]) -> i64:
    return sink(xs[0])

def fixed_element(xs: Handle[2]) -> i64:
    u: Handle = xs[0]
    return sink(move u)

def main() -> i32:
    return 0
