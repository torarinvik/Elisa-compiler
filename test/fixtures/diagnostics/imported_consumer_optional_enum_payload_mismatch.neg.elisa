enum Expr:
    Missing
    Value(value: i64)

enum Stmt:
    Return(value: Expr?, line: u32)

module Consumers:
    public:
        def consume(value: Expr) -> bool:
            return true

using Consumers

def extract(statement: Stmt) -> bool:
    match statement:
        Stmt.Return(value, _):
            return consume(value)
