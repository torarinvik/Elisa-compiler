# A literal typed in place, an annotated binding, and a binding with a non-literal leaf are sview.
def annotated(n: i64) -> sview:
    s: sview = "zero"
    return s

def direct(n: i64) -> sview:
    return "zero" if n == 0 else "many"

def block_literal(n: i64) -> sview:
    return
        k = n
        "zero"

def mixed(n: i64, v: sview) -> sview:
    s = "zero" if n == 0 else v
    return s

def to_cstr(n: i64) -> cstr:
    s = "zero"
    return s

def shadowed(n: i64, xs: darray[sview]) -> sview:
    s = "zero"
    for s in xs:
        return s
    return "none"

enum Shape:
    Circle(radius: i64)
    Empty

def binder_shadows(shape: Shape) -> i64:
    s = "zero"
    match shape:
        Shape.Circle(s):
            return s
        Shape.Empty:
            return 0

module Names:
    const ZERO: sview = "zero"

def typed_const(n: i64) -> sview:
    return Names::ZERO
