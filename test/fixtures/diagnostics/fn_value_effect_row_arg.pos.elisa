# The call-argument form: a `can[Memory.Allocate]` function passed where a plain
# `fn(i64) -> i64` parameter is declared (fuzz_findings/fn_value_effect_row_ignored_arg).
# stage0: argument 1 to "apply" expects fn(i64) -> i64, got fn(i64) -> i64 can[Memory].
def grow(n: i64) -> i64 can[Memory.Allocate]:
    xs: darray[i64] = [n]
    return xs[0]

def apply(h: fn(i64) -> i64, n: i64) -> i64:
    return h(n)

def main() -> i64:
    return apply(grow, 3)
