# A line-zero generic T must not inherit the nonshareable concrete type named T.
struct T:
    pointer: i64&

def consume[U](value: U) -> void:
    pass

#line 0 generic_owner.elisa
def safe_send[T](value: T) -> void:
    can Parallel, Memory.Allocate, Abort.Panic:
        nursery workers(1):
            submit consume(value)

def main() -> i64:
    safe_send[i64](42)
    return 0
