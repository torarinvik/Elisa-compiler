# A linear local consumed on only SOME paths leaks on the others: the scope-exit
# check needs must-consumed, even though a later use sees it as may-consumed.
linear struct Guard:
    active: bool

enum Pick:
    A
    B

def make() -> Guard:
    return Guard{active: true}

def release(g: Guard) -> void:
    _ = move g

def one_branch(c: bool) -> void:
    g: Guard = make()
    if c:
        release(move g)

def else_only(c: bool) -> void:
    h: Guard = make()
    if c:
        pass
    else:
        release(move h)

def one_arm(p: Pick) -> void:
    m: Guard = make()
    match p:
        Pick.A:
            release(move m)
        Pick.B:
            pass
