module Other:
    struct Result:
        payload: darray[u8]

module UiDialog:
    const enum Result of i32:
        None = 0
        Primary = 1

    global mutable results: Result[4] = zeroed

    def result(slot: usize) -> Result:
        return results[slot]


module QualifiedDialog:
    const enum Result of i32:
        None = 0
    global mutable results: Result[2] = zeroed
    def result(slot: usize) -> QualifiedDialog::Result:
        return results[slot]
