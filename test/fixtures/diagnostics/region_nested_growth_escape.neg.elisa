def copy_scalar_from_region() -> i64 can[Memory.Allocate, Abort.Panic]:
    region outer(8192):
        values: mutable darray[i64] @outer = []
        region scratch(4096):
            row: mutable darray[i64] @scratch = []
            row.push(41)
        values.push(7)
        return values[0]

# The region parameter belongs to the caller; it is not a local region block.
def grow_in_caller_region[@r](out: mutable darray[i64]&, value: i64& @r) -> void:
    in r:
        out.push(value[0])
