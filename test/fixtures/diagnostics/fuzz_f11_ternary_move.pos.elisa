# Fuzz finding round 1 (test/fuzz_findings/aff_ternary_move_then_use.elisa): stage1 accepted this; stage0 rejects it.
affine struct Hd:
    v: i64

def take(h: Hd) -> i64:
    return h.v

def flag() -> bool:
    return true

def main() -> i64:
    h: Hd = Hd{v: 7}
    t: i64 = take(move h) if flag() else 0
    return t + h.v
