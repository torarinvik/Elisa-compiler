# `sum = ...` inside the loop DECLARES a second local that shadows the outer
# `sum`, so the function returns 0 whatever the input. Rejected: the writer
# meant `sum <- ...`.
def total(values: i64[4]&) -> i64:
    sum: mutable i64 = 0
    for index in 0..<4:
        sum = sum + values[index]
    sum

def main() -> i32:
    data: i64[4] = [1, 2, 3, 4]
    total(&data).i32()
