# corpus: deliberate-decline -- null narrowing proves non-nullness, not mutability;
# stage0 unsoundly accepts this write-through of a read-only reference.
# Rule R + null narrowing: after `return 1 if entry == null`, `entry` is non-null, so the
# argument is spelled `void&` (not `void&?`); it is still readonly, because `next_entry`
# returns a readonly reference.
def next_entry(i: i64) -> void&?:
    return null

def poke(p: mutable void&) -> void:
    pass

def main() -> i32:
    entry: mutable void&? = next_entry(0)
    return 1 if entry == null
    poke(entry)
    return 0
