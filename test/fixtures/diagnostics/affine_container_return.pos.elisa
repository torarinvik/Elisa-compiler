# A bare `return c` of a container holding handles copies it; stage0 requires
# `return move c` and reports the unconsumed owner at its declaration too.
# stage0 lines: 9 + 8 (param), 12 + 11 (local), 15 + 14 (nested), 18 + 17 (aggregate).
affine struct Handle:
    v: i64
struct Pair:
    a: Handle
def param(xs: darray[Handle]) -> darray[Handle]:
    return xs
def local() -> darray[Handle]:
    made: darray[Handle] = []
    return made
def nested() -> darray[darray[Handle]]:
    t: darray[darray[Handle]] = []
    return t
def pairs() -> darray[Pair]:
    ps: darray[Pair] = []
    return ps
