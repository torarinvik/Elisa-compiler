struct BorrowedBox:
    value: i64&

def returns_branch_reference(condition: bool, first: i64&, second: i64&) -> BorrowedBox:
    borrowed: mutable BorrowedBox = BorrowedBox{value: first}
    if condition:
        borrowed <- BorrowedBox{value: first}
    else:
        borrowed <- BorrowedBox{value: second}
    borrowed
