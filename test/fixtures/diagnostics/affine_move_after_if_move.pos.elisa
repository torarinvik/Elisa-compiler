# A value one branch of an `if` moved is MAY-consumed afterwards: moving it again is a
# double move (two drops) on the path through the branch. stage0 rejects this too.
affine struct Handle:
    v: i64

def sink(h: Handle) -> i64:
    return h.v

def main() -> i32:
    t: Handle = Handle{v: 1}
    c: i64 = 2
    if c > 1:
        sink(move t)
    sink(move t)
    return 0
