# `push` moves its argument into the darray.
affine struct Handle:
    v: i64

struct Pair:
    a: Handle
    b: Handle

def main() -> i32:
    can Memory.Allocate:
        t: Handle = Handle{v: 1}
        xs: mutable darray[Handle] = []
        xs.push(t)
        for x in move xs:
            _ = move x
        return t.v.i32()
