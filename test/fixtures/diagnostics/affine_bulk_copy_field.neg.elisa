# Field-rooted bulk copies of plain values copy nothing linear and stay legal.
struct Bag:
    items: mutable darray[i64]
struct Shelf:
    bag: mutable Bag
def main() -> i32:
    b: mutable Bag = Bag{items: [1]}
    s: mutable Shelf = Shelf{bag: Bag{items: [2]}}
    more: darray[i64] = [3]
    b.items.extend(more)
    s.bag.items.push(b.items)
    ys: darray[i64] = [...b.items, ...s.bag.items]
    return ys.count.i32()
