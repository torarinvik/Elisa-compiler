# A bare `Holder` value is `Holder[?]`; `read` wants `Holder[&]`. stage0 rejects the call;
# stage1 lowered the states (erased) but never checked them (memory: typestate-check-gap).
struct Holder[?]:
    value: i32

def read(value: Holder[&]) -> i32:
    return value.value

def main() -> i64:
    h: Holder = Holder{value: 41}
    return read(h).i64() + 1
