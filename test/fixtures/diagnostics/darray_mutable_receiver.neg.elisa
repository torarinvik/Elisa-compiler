# Writable receivers: a `mutable T&`, a `mutable` field on a writable path, a
# `mutable darray[T]&` field, and wrong-arity calls (stage0 reports arity only).
struct MBag:
    items: mutable darray[i64]
struct RefHolder:
    w: mutable darray[i64]&
def f_w(xs: mutable darray[i64]&) -> void:
    xs.push(1)
    xs.clear()
def f_mfield(b: mutable MBag&) -> void:
    b.items.push(1)
    v: i64? = b.items.pop()
def f_holder(h: RefHolder&) -> void:
    h.w.truncate(0)
    h.w.clear()
def f_local() -> i64:
    xs: mutable darray[i64] = []
    xs.push(1)
    return xs.count.i64()
def main() -> i32:
    return 0
