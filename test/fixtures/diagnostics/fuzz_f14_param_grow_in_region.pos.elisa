# Fuzz F14 companion: growing a `mutable darray&` PARAMETER inside a local region block takes
# the new buffer from that block, which is freed before the caller reads it. stage0 rejects
# this; stage1 used to exempt every parameter.
def build(seed: mutable darray[u8]&) -> i64:
    region fzr(4096):
        seed.push(65)
    return 0

def main() -> i64:
    t: mutable darray[u8] = [66.u8()]
    n: i64 = build(&t)
    return t.count.i64() + n
