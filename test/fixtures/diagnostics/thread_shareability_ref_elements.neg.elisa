# A loop over scalar elements is shareable even when it uses a simple array parameter.
def twice(value: i64) -> i64:
    return value * 2

def check(values: i64[2]) -> i64:
    can Parallel, Memory.Allocate, Abort.Panic:
        for value in values:
            nursery workers(1):
                submit twice(value)
    return 0

def main() -> i64:
    return 0
