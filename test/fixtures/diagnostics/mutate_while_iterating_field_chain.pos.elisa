# The iterated darray is a FIELD (`b.items`, `o.bag.items`): growing, replacing, `+=`-ing or
# passing that same place by `mutable&` inside the loop moves the buffer the iterator walks.
struct Bag:
    items: mutable darray[i64]
    other: mutable darray[i64]

struct Outer:
    bag: mutable Bag

def grow(xs: mutable darray[i64]&) -> void:
    xs.push(1)

def push_same(b: mutable Bag&) -> void:
    for v in b.items:
        b.items.push(v)

def append_same(b: mutable Bag&) -> void:
    for v in b.items:
        b.items += v

def replace_same(b: mutable Bag&, t: Bag&) -> void:
    for v in b.items:
        b.items <- t.other

def nested_chain(o: mutable Outer&) -> void:
    for v in o.bag.items:
        o.bag.items.extend([v])

def callee_grows(b: mutable Bag&) -> void:
    for v in b.items:
        grow(b.items)

def local_owner() -> i64:
    b: mutable Bag = Bag{items: [1], other: [2]}
    for v in b.items:
        if v > 0:
            b.items.push(v)
    return b.items.count.i64()

def main() -> i32:
    return 0
