# Values, not keys, may hold handles; plain sets stay valid.
linear struct Handle:
    fd: i64

struct Pair:
    a: Handle
    b: i64

struct Holder:
    d: dict[i64, Handle?]
    e: dict[i64, darray[Pair]]

def take(s: set[i64], d: dict[i64, Handle]) -> i64:
    return 0

def main() -> i64:
    return 0
