# A global's owning container returned by value shares the global's buffer with the
# caller; the global's next growth frees it under the caller's copy (both compilers ran
# this shape to a stale read before the rule). Every return below must be rejected.
struct Box:
    items: mutable darray[i64]

struct Outer:
    inner: mutable Box

global store: mutable Box
global nested: mutable Outer
global mutable gitems: mutable darray[i64] = zeroed
global mutable name: mutable dstr = zeroed

def field_items() -> darray[i64]:
    return store.items

def bare_items() -> darray[i64]:
    return gitems

def nested_items() -> darray[i64]:
    return nested.inner.items

def tail_items() -> darray[i64]:
    gitems

def via_local() -> darray[i64]:
    x: darray[i64] = gitems
    return x

def via_assign() -> darray[i64]:
    y: mutable darray[i64] = []
    y <- store.items
    return y

def name_of() -> dstr:
    return name

def box_of() -> Box:
    return store

def main() -> i32:
    return 0
