# A module-qualified call to a fresh borrow-free function owns its result, exactly as a bare
# call does: binding it to a named local and then growing the result's new owner must not
# invalidate it (the elisa-proof 7571dfa `proof_import_source_mapped` shape; stage0 accepts).
module Imp:
    public:
        def imp(path: darray[u8]&, failed: mutable bool&, files: mutable darray[u8]&) -> darray[u8]:
            output: mutable darray[u8] = []
            output.push(path[0])
            files.push(1)
            return output

def main() -> i32:
    p: darray[u8] = [7]
    f: mutable bool = false
    files: mutable darray[u8] = []
    source: mutable darray[u8] = []
    imported: mutable darray[u8] = Imp::imp(p, &f, &files)
    source <- imported
    n: usize = source.count
    source.push(0)
    return (n + source.count).i32()
