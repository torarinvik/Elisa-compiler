# Every mutating darray call below has the WRONG argument count and must be rejected.
struct MBag:
    items: mutable darray[i64]

def grow(xs: mutable darray[i64]&, b: mutable MBag&) -> void:
    xs.push(1, 2)  # wrong: push takes one value or one list, e.g. push([1, 2])
    xs.clear(3)  # wrong: clear() takes nothing; it removes every element
    b.items.truncate()  # wrong: truncate takes the new length
    b.items.reserve(1, 2, 3)  # wrong: reserve takes one capacity

def main() -> i32:
    mutable ys: darray[i64] = []
    ys.resize(4, 9)  # wrong: resize takes the new length
    ys.extend()  # wrong: extend takes the darray to append
    return 0
