# corpus: deliberate-decline -- stage0 accepts (no view tracking through a struct element returned by value).
# A darray of a struct with an sview field, returned by value from a plain function, still
# carries a view of its argument: growing the argument afterwards must be reported.
struct Tok:
    text: sview

def toks(src: darray[u8]&) -> darray[Tok]:
    out: mutable darray[Tok] = []
    out.push(Tok{text: src.as_sview()})
    return out

def main() -> i32:
    buf: mutable darray[u8] = [97]
    got: darray[Tok] = toks(&buf)
    for i in 0..<100 |buf|:
        buf.push(98)
    return got.count.i32() - 1
