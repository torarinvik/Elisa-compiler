# Reusing checker scratch must preserve each function's exact annotation owner.
module First:
    def rejected[@r](value: i64& @r, spare: i64) -> i64:
        return value

    def allowed[@r](value: i64& @r, spare: i64) -> i64& @r:
        return value

module Second:
    def plain(value: i64, spare: i64) -> i64:
        return value

    def rejected[@s](value: i64& @s, spare: i64) -> i64:
        return value

def main() -> i32:
    return 0
