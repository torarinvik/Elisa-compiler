# Sibling fields, a name that merely shares a prefix, and replacement after the loop leave
# the iterated buffer alone.
struct S:
    items: mutable darray[i64]
    itemsx: mutable darray[i64]
    n: mutable i64

struct O:
    s: mutable S
    k: mutable i64

def sibling_scalar(s: mutable S&) -> void:
    for v in s.items:
        s.n <- v

def sibling_owner(o: mutable O&) -> void:
    for v in o.s.items:
        o.k <- v

def prefix_name(s: mutable S&, t: S) -> void:
    for v in s.itemsx:
        s.items <- t.items

def after_loop(s: mutable S&, t: S) -> void:
    for v in s.items:
        pass
    s <- t

# An `lmut` threading call mutates the owner in place; it is not a replacement.
def step(s: lmut S) -> void:
    s.n <- s.n + 1

def threaded_step(s: lmut S) -> void:
    for v in s.items |s|:
        s <- s.step()

def main() -> i32:
    return 0
