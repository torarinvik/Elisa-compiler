# Conditional moves stage0 accepts: a moving branch that leaves, a branch that moves then
# reinitialises, one move per match arm, a moving branch that breaks out of a loop, and a
# fresh declaration reusing a name a sibling branch consumed.
affine struct Handle:
    v: i64

def sink(h: Handle) -> i64:
    return h.v

enum Pick:
    A
    B

def exit_branch(c: i64) -> i64:
    t: Handle = Handle{v: 1}
    if c > 1:
        sink(move t)
        return 1
    return t.v

def reinit_branch(c: i64) -> i64:
    t: mutable Handle = Handle{v: 1}
    if c > 1:
        sink(move t)
        t <- Handle{v: 3}
    return t.v

def match_arms(p: Pick) -> i64:
    t: Handle = Handle{v: 1}
    match p:
        Pick.A:
            sink(move t)
        Pick.B:
            sink(move t)
    return 0

def loop_break_branch(c: i64) -> i64:
    t: Handle = Handle{v: 1}
    while c > 1:
        if c > 5:
            sink(move t)
            break
        return 0
    return 0

def sibling_decl(c: i64) -> i64:
    if c > 1:
        h: Handle = Handle{v: 1}
        sink(move h)
    else:
        h: Handle = Handle{v: 2}
        sink(move h)
    return 0

def main() -> i32:
    total: i64 = exit_branch(2) + reinit_branch(2) + match_arms(Pick.A) + loop_break_branch(2) + sibling_decl(2)
    return total.i32()
