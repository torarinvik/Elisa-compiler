# Iterating a borrowed array with a same-named scalar binder must not panic or taint
# that scalar; after the loop, the outer array reference must still be rejected.
def twice(value: i64) -> i64:
    return value * 2

def read_first(values: i64[2]&) -> i64:
    return values[0]

def check(values: i64[2]&) -> i64:
    can Parallel, Memory.Allocate, Abort.Panic:
        for values in values:
            nursery workers(1):
                submit twice(values)
        nursery workers(1):
            submit read_first(values)
    return 0

def main() -> i64:
    values: i64[2] = [1, 2]
    return check(&values)
