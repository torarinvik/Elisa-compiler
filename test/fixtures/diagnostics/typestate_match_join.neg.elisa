typestate ProtocolFile:
    id: i64
    states: Closed, Open
    transition open_file: Closed -> Open
    transition read_file: Open -> Open

def invalid(file: mutable ProtocolFile[Closed]&, flag: i64) ensures file => Open:
    match flag:
        0:
            open_file(file)
        _:
            pass
    read_file(file)
