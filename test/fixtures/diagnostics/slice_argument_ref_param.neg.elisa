# A slice is a view {data, length}, not a place a `T&` parameter can borrow. stage1 used to
# accept it and build the view into a plain pointer, which the backend rejected as invalid IR.
def first(values: i64&) -> i64:
    values[0]

def main() -> i32:
    data: mutable i64[4] = zeroed
    data[1] <- 7
    return 1 if first(data[1:3]) != 7
    0
