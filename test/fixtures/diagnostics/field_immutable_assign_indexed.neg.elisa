# The same shape through a `mutable` field must stay silent, and a later function that
# re-declares `rows` with a different element type must not inherit the earlier binding.
struct P:
    f0: i64
    f1: mutable i64

struct Q:
    f0: mutable i64

def touch(n: i64) -> i64:
    rows: mutable darray[P] = [P{f0: 1, f1: 2}]
    rows[0].f1 <- n
    return rows[0].f1

def other(n: i64) -> i64:
    rows: mutable darray[Q] = [Q{f0: 1}]
    rows[0].f0 <- n
    return rows[0].f0

def main() -> i64:
    return touch(5) + other(2)
