# A parameter NAMED `out` gets no extra capability: writing through a plain
# `u8&` is rejected whatever the name. (Stage0 once made `out` / `*_out`
# params writable, so a callee could write through a reference its caller
# lent read-only.)
def fill(out: u8&, slot: usize) -> void:
    out[slot] <- 7

def main() -> i32:
    bytes: mutable u8[2] = zeroed
    fill(&bytes[0], 1)
    bytes[1].i32()
