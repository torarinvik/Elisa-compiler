struct MGrid:
    rows: mutable darray[darray[i64]]

def a_w(xss: mutable darray[darray[i64]]&) -> void:
    xss[0].clear()
    xss[0].truncate(0)

def a_field_w(g: mutable MGrid&) -> void:
    g.rows[0].clear()

def a_nested_w(xsss: mutable darray[darray[darray[i64]]]&) -> void:
    xsss[0][1].clear()

def a_elem_read(xss: darray[darray[i64]]&) -> i64:
    return xss[0].count.i64()

def main() -> i32:
    return 0
