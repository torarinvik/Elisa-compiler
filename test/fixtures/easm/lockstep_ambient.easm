module lockstep_ambient
target x86_64
export def ambient_ok() -> void abi c:
    clobbers: rax
    stack: unchanged
    control: returns
    reference:
        state direction=fwd
        movq $1, %rax
        ret
    target x86_64 lockstep reference:
        state direction=fwd
        movq $1, %rax
        ret
