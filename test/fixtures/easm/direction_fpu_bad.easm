module direction_fpu_bad
target x86_64
export def load(p: HostPtr[u16]) -> void abi c:
    inputs:
        p = %rdi
    requires:
        x86_64.fpu_control
    clobbers:
        memory.write
    stack:
        unchanged
    control:
        returns
    body:
        fldcw (%rdi)
        ret
export def store(p: HostPtr[u16]) -> void abi c:
    inputs:
        p = %rdi
    requires:
        x86_64.fpu_control
    clobbers:
        memory.read
    stack:
        unchanged
    control:
        returns
    body:
        fnstcw (%rdi)
        ret
