module lockstep_branch_diverged
target x86_64
export def choose(value: i64) -> i64 abi c:
    inputs:
        value = %rdi
    outputs:
        result = %rax
    stack:
        unchanged
    control:
        returns
    reference:
        cmpq $0, %rdi
        je Lzero
        movq $1, %rax
        ret
    Lzero:
        xorq %rax, %rax
        ret
    target x86_64 lockstep reference:
        movq $1, %rax
        ret
