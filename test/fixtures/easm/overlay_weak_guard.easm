module overlay_weak_guard
target x86_64
layout Header size 64:
    40 value: u64 requires size >= 48
export def read(p: HostPtr[Header]) -> void abi c:
    inputs:
        p = %rdi
    facts:
        size >= 32
    clobbers:
        rax, memory
    stack:
        unchanged
    control:
        returns
    body:
        movq 40(%rdi), %rax
        ret
