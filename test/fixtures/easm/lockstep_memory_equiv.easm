module lockstep_memory_equiv
target x86_64
export def load(p: HostPtr[u64]) -> u64 abi c:
    inputs:
        p = rdi
    outputs:
        ret = rax
    clobbers:
        memory
    stack:
        unchanged
    control:
        returns
    body:
        ret
    reference:
        movq (%rdi), %rax
        ret
    target x86_64 lockstep reference:
        movq (%rdi), %rax
        ret
