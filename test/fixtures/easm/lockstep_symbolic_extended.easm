module lockstep_symbolic_extended
target x86_64
export def transform(a: u64) -> u64 abi c:
    inputs:
        a = %rdi
    outputs:
        result = %rax
    clobbers:
        rax, rcx, cc
    stack:
        unchanged
    control:
        returns
    reference:
        movq %rdi, %rax
        leaq 8(%rax), %rcx
        movl %ecx, %eax
        notq %rax
        ret
    target x86_64 lockstep reference:
        movq %rdi, %rax
        addq $8, %rax
        movl %eax, %eax
        notq %rax
        ret
