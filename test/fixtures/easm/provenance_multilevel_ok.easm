module multilevel
target x86_64
export def chain_ok(p: HostPtr[u64]) -> u64 abi c:
    inputs: p = rdi
    outputs: ret = rax
    clobbers: rax, rcx, r8, memory
    stack: unchanged
    control: returns
    body:
        movq %rdi, %r8
        leaq 0(%r8), %rcx
        movq (%rcx), %rax
        ret
