module lockstep_loop
target x86_64
export def counted_loop() -> u64 abi c:
    outputs: ret = rax
    clobbers: rax, rcx, cc
    stack: unchanged
    control: returns
    requires: compare.unsigned, control.direct
    reference:
        movq $4, %rcx
        movq $0, %rax
    loop:
        addq $1, %rax
        decq %rcx
        jnz loop
        ret
    target x86_64 lockstep reference:
        movq $4, %rcx
        movq $0, %rax
    loop2:
        addq $1, %rax
        decq %rcx
        jnz loop2
        ret
