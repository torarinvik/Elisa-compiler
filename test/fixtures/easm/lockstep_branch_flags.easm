module lockstep_flags
target x86_64
export def branchy(flag: u64, a: u64, b: u64) -> u64 abi c:
    inputs: flag = rdi, a = rsi, b = rdx
    outputs: ret = rax
    clobbers: rax, cc
    stack: unchanged
    control: returns
    requires: compare.unsigned, control.direct
    reference:
        movq %rsi, %rax
        cmpq $0, %rdi
        je skip
        movq %rdx, %rax
    skip:
        ret
    target x86_64 lockstep reference:
        movq %rsi, %rax
        cmpq $0, %rdi
        je skip2
        movq %rdx, %rax
    skip2:
        ret
