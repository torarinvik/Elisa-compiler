module lockstep_equiv
target x86_64
export def add_pair(a: u64, b: u64) -> u64 abi c:
    inputs:
        a = rdi
        b = rsi
    outputs:
        ret = rax
    clobbers:
        cc
    body:
        ret
    reference:
        movq %rdi, %rax
        addq %rsi, %rax
        ret
    target x86_64 lockstep reference:
        movq %rsi, %rax
        addq %rdi, %rax
        ret
