module multilevel
target x86_64
export def merge_chain(flag: u64, p: HostPtr[u64], q: GuestVAddr[LayoutB]) -> u64 abi c:
    inputs: flag = rdi, p = rsi, q = rdx
    outputs: ret = rax
    clobbers: rax, rcx, r8, cc, memory
    stack: unchanged
    control: returns
    requires: compare.unsigned, control.direct
    body:
        movq %rsi, %r8
        movq %r8, %rcx
        cmpq $0, %rdi
        je join
        movq %rdx, %rcx
    join:
        movq (%rcx), %rax
        ret
