module frame_propagated_bad
target x86_64
export def write(p: HostPtr[u64], q: HostPtr[u64], value: u64) -> void abi c:
    inputs:
        p = %rdi
        q = %rsi
        value = %rax
    changes:
        p
    clobbers:
        rcx, memory
    stack:
        unchanged
    control:
        returns
    body:
        movq %rsi, %rcx
        movq %rax, (%rcx)
        ret
