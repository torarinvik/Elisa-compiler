# -Wnever-leak: one local per category. never_leak_smoke.sh pins the rows in expected.tsv.
global mutable sunk: i64 = 0

def baz(n: i64) -> i64:
    return n * 2

def sink(n: i64) -> void:
    sunk <- sunk + n

# CHAIN: `bar` stays visible over `sink(lol)`.
def chain(seed: i64) -> void:
    bar: i64 = seed + 1
    lol: i64 = baz(bar)
    sink(lol)

# CHAIN with an outer write: the block needs a `|count|` capture.
def captured(seed: i64) -> i64:
    count: mutable i64 = 0
    step: i64 = seed * 3
    count <- count + 1
    total: i64 = step + count
    sink(total)
    return count

# PLAIN: the last use is a call statement.
def plain(seed: i64) -> void:
    bar: i64 = seed + 1
    sink(baz(bar))
    sink(seed)

# OVERLAP: `first` is used through line 3 of the body, `second` is declared inside that range
# and used after it.
def overlap(seed: i64) -> void:
    first: i64 = seed + 1
    second: i64 = seed + 2
    sink(first)
    sink(second)

# LOOP: `index` is the loop's counter and stays visible after the loop.
def counter(limit: i64) -> void:
    index: mutable i64 = 0
    while index < limit:
        sink(index)
        index <- index + 1
    sink(limit)

def main() -> i64:
    chain(1)
    _ = captured(2)
    plain(3)
    overlap(4)
    counter(2)
    return 0
