# -Wnever-leak: one local per category; pinned by expected-rows.txt, expected-strict.txt, expected-gentle.txt.
global mutable sunk: i64 = 0

def baz(n: i64) -> i64:
    return n * 2

def sink(n: i64) -> void:
    sunk <- sunk + n

# CHAIN: `bar` stays visible over `sink(lol)`.
def chain(seed: i64) -> void:
    bar: i64 = seed + 1
    lol: i64 = baz(bar)
    sink(lol)

# CHAIN with an outer write: the block needs a `|count|` capture.
def captured(seed: i64) -> i64:
    count: mutable i64 = 0
    step: i64 = seed * 3
    count <- count + 1
    total: i64 = step + count
    sink(total)
    return count

# PLAIN: the last use is a call statement.
def plain(seed: i64) -> void:
    bar: i64 = seed + 1
    sink(baz(bar))
    sink(seed)

# OVERLAP: `first` is used through line 3 of the body, `second` is declared inside that range
# and used after it.
def overlap(seed: i64) -> void:
    first: i64 = seed + 1
    second: i64 = seed + 2
    sink(first)
    sink(second)

# LOOP: `index` is the loop's counter and stays visible after the loop.
def counter(limit: i64) -> void:
    index: mutable i64 = 0
    while index < limit:
        sink(index)
        index <- index + 1
    sink(limit)

# ACCUMULATOR: `sum` is written only by the loop and read only after it.
def summed(numbers: darray[i64]&) -> i64:
    sum: mutable i64 = 0
    for num in numbers:
        sum <- sum + num
    return sum * 2

# ACCUMULATOR (tuple): two accumulators of one loop.
def averaged(numbers: darray[i64]&) -> i64:
    total: mutable i64 = 0
    count: mutable i64 = 0
    for num in numbers:
        total <- total + num
        count <- count + 1
    return total + count

# ACCUMULATOR (search): the `break` ends the loop with the hit.
def searched(numbers: darray[i64]&, target: i64) -> usize?:
    hit: mutable usize? = null
    for i in 0..<numbers.count:
        if numbers[i] == target:
            hit <- i
            break
    return hit

# Not rewritable (strict says why): the loop also reads `best` outside its own update.
def maxed(numbers: darray[i64]&) -> i64:
    best: mutable i64 = 0
    for num in numbers:
        if num > best:
            best <- num
    return best

def sample() -> darray[i64]:
    return [3, 5, 7]

def main() -> i64:
    chain(1)
    _ = captured(2)
    plain(3)
    overlap(4)
    counter(2)
    sink(summed(sample()))
    sink(averaged(sample()))
    if searched(sample(), 5) is found:
        sink(found.i64())
    if searched(sample(), 4) is unexpected:
        sink(100)
    sink(maxed(sample()))
    return 0
