# -Wnever-leak: illegal.elisa with each diagnostic's suggested rewrite applied verbatim. It must
# compile under both compilers and draw no finding.
global mutable sunk: i64 = 0

def baz(n: i64) -> i64:
    return n * 2

def sink(n: i64) -> void:
    sunk <- sunk + n

def chain(seed: i64) -> void:
    lol: i64 =
        bar: i64 = seed + 1
        baz(bar)
    sink(lol)

def captured(seed: i64) -> i64:
    count: mutable i64 = 0
    region total_scope:
        total: i64 = |count|
            step: i64 = seed * 3
            count <- count + 1
            step + count
        sink(total)
    return count

def plain(seed: i64) -> void:
    region bar_scope:
        bar: i64 = seed + 1
        sink(baz(bar))
    sink(seed)

def overlap(seed: i64) -> void:
    region first_scope:
        first: i64 = seed + 1
        sink(first)
    second: i64 = seed + 2
    sink(second)

def counter(limit: i64) -> void:
    while index < limit |index: i64 = 0|:
        sink(index)
        index <- index + 1
    sink(limit)

# ACCUMULATOR: `sum` is written only by the loop and read only after it.
def summed(numbers: darray[i64]&) -> i64:
    sum: i64 =
        for num in numbers |sum: i64 = 0| -> sum:
            sum <- sum + num
    return sum * 2

# ACCUMULATOR (tuple): two accumulators of one loop.
def averaged(numbers: darray[i64]&) -> i64:
    total, count =
        for num in numbers |total: i64 = 0, count: i64 = 0| -> (total, count):
            total <- total + num
            count <- count + 1
    return total + count

# ACCUMULATOR (search): the `break` ends the loop with the hit.
def searched(numbers: darray[i64]&, target: i64) -> usize?:
    hit: usize? =
        for i in 0..<numbers.count |hit: usize? = null| -> hit:
            if numbers[i] == target:
                hit <- i
                break
    return hit

# Not rewritable (strict says why): the loop also reads `best` outside its own update.
def maxed(numbers: darray[i64]&) -> i64:
    best: mutable i64 = 0
    for num in numbers:
        if num > best:
            best <- num
    return best

def sample() -> darray[i64]:
    return [3, 5, 7]

def main() -> i64:
    chain(1)
    _ = captured(2)
    plain(3)
    overlap(4)
    counter(2)
    sink(summed(sample()))
    sink(averaged(sample()))
    if searched(sample(), 5) is found:
        sink(found.i64())
    if searched(sample(), 4) is unexpected:
        sink(100)
    sink(maxed(sample()))
    return 0 if sunk == 92 else 1
