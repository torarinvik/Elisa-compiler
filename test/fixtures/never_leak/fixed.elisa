# -Wnever-leak: illegal.elisa with each diagnostic's suggested rewrite applied verbatim. It must
# compile under both compilers and draw no finding.
global mutable sunk: i64 = 0

def baz(n: i64) -> i64:
    return n * 2

def sink(n: i64) -> void:
    sunk <- sunk + n

def chain(seed: i64) -> void:
    lol: i64 =
        bar: i64 = seed + 1
        baz(bar)
    sink(lol)

def captured(seed: i64) -> i64:
    count: mutable i64 = 0
    region total_scope:
        total: i64 = |count|
            step: i64 = seed * 3
            count <- count + 1
            step + count
        sink(total)
    return count

def plain(seed: i64) -> void:
    region bar_scope:
        bar: i64 = seed + 1
        sink(baz(bar))
    sink(seed)

def overlap(seed: i64) -> void:
    region first_scope:
        first: i64 = seed + 1
        sink(first)
    second: i64 = seed + 2
    sink(second)

def counter(limit: i64) -> void:
    while index < limit |index: i64 = 0|:
        sink(index)
        index <- index + 1
    sink(limit)

def main() -> i64:
    chain(1)
    _ = captured(2)
    plain(3)
    overlap(4)
    counter(2)
    return 0 if sunk == 36 else 1
