# -Wnever-leak: every local here is used by the last statement of its block (or is exempt).
global mutable sunk: i64 = 0

def baz(n: i64) -> i64:
    return n * 2

def sink(n: i64) -> void:
    can Global{Read,Write}, Unsafe.MutableGlobal:
        sunk <- sunk + n

def view_of(buffer: darray[u8]&) -> sview:
    return bytes_view_range(buffer, 0, buffer.count)

# The rule's own legal example: `bar` is used by the last statement.
def single(seed: i64) -> void:
    bar: i64 = seed + 1
    sink(baz(bar)) can Global{Read,Write}, Unsafe.MutableGlobal

# The fixed chain: `bar` lives only inside the block expression.
def nested(seed: i64) -> void:
    lol: i64 =
        bar: i64 = seed + 1
        baz(bar)
    sink(lol) can Global{Read,Write}, Unsafe.MutableGlobal

# Borrow exemption: nesting `buffer` would leave `view` dangling.
def borrowed() -> i64:
    buffer: darray[u8] = [104, 105]
    view: sview = view_of(buffer)
    return view.len

# Parameters and `_`-prefixed locals are exempt; a loop header owns its counter.
def exempt(limit: i64) -> void:
    _scratch: i64 = limit * 3
    sink(_scratch) can Global{Read,Write}, Unsafe.MutableGlobal
    while index < limit |index: i64 = 0|:
        sink(index) can Global{Read,Write}, Unsafe.MutableGlobal
        index <- index + 1
    sink(limit) can Global{Read,Write}, Unsafe.MutableGlobal

def main() -> i64:
    single(1) can Global{Read,Write}, Unsafe.MutableGlobal
    nested(2) can Global{Read,Write}, Unsafe.MutableGlobal
    exempt(3) can Global{Read,Write}, Unsafe.MutableGlobal
    return 0 if borrowed() == 2 else 1
