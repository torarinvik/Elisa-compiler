# -Wnever-leak: illegal_stage1.elisa with each diagnostic's suggested rewrite applied verbatim.
# stage1 builds and runs it, and it draws no finding in either mode.
global mutable sunk: i64 = 0

def sink(n: i64) -> void:
    can Unsafe.MutableGlobal:
        sunk <- sunk + n

def sunk_total() -> i64:
    can Unsafe.MutableGlobal:
        return sunk

# CHAIN with a loop jump: the block that takes `tmp` may `continue` the loop.
def positives(xs: darray[i64]&) -> void:
    for x in xs:
        doubled: i64 =
            tmp: i64 = x * 2
            continue if tmp < 0
            tmp + 1
        sink(doubled)

# PUSH LOOP over two clauses, with a filter between them: a nested comprehension.
def pairs(xs: darray[i64]&, ys: darray[i64]&) -> darray[i64]:
    sums: darray[i64] = [x * 10 + y for x in xs if x > 1 for y in ys]
    return sums

def first() -> darray[i64]:
    return [1, -2, 2, 3]

def second() -> darray[i64]:
    return [4, 5]

def check(sums: darray[i64]&) -> i64:
    return 0 if sums.count == 4 and sums[3] == 35 and sunk_total() == 15 else 1

def main() -> i64:
    numbers: darray[i64] = first()
    positives(numbers)
    return check(pairs(numbers, second()))
