include "../../elisacore_std/elisacore_runtime.elisa"

def main() -> i64:
    values: mutable darray[i64] = [1, 2, 3, 4]
    can Global{Read,Write}:
        total: i64 = (acc + value for value in values with acc = 0 by par)
        return 1 if total != 10
        doubled: i64 = (acc + value * 2 for value in values with acc = 0 by par)
        return 2 if doubled != 20
    return 0
