def uncaptured_conditional() -> i32:
    index: mutable usize = 0
    total: mutable usize = 0
    while index < 10:
        byte: usize = 10 if index == 0 else 20
        total <- total + byte
        index <- index + 1
    return 0

def hoisted_conditional() -> i32:
    index: mutable usize = 0
    total: mutable usize = 0
    byte: mutable usize = 0
    while index < 10 |index, total|:
        byte <- 10 if index == 0 else 20
        total <- total + byte
        index <- index + 1
    return 0

def captured_nonconditional() -> i32:
    index: mutable usize = 0
    total: mutable usize = 0
    while index < 10 |index, total|:
        byte: usize = 10
        total <- total + byte
        index <- index + 1
    return 0

def main() -> i32:
    return uncaptured_conditional() + hoisted_conditional() + captured_nonconditional()
