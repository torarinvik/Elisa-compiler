extend Semantic:
    public:
        def region_false_guard_probe() -> i64 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    nodes: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in nodes:
                        at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0}
                        panic_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("panic", at), [], [], at)
                        arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Literal("true"), body: [], guard: Ast::Expr.BoolLit(false, at), pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [Ast::Stmt.Expr(panic_call, at)], guard: Ast::Expr.Absent, pos: at}
                        ]
                        value: Ast::Expr = Ast::Expr.Match(Ast::Expr.BoolLit(true, at), arms, at)
                        context: RegionEscapeCatchContext = RegionEscapeCatchContext{markers: [], lexical_module: ""}
                        return 1 if not region_escape_provenance_expression_terminates(value)
                        return 2 if not region_escape_provenance_expression_terminates_with_metadata(value, context)
                        return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Semantic::region_false_guard_probe() can Global{Read,Write}
