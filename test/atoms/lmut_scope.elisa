extend Semantic:
    public:
        def compiler_lmut_scope_case(body: darray[Ast::Stmt] @source, expected: usize) -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                integer: Ast::Expr = Ast::Expr.Ident("i64", at)
                holder: Ast::Expr = Ast::Expr.Ident("Holder", at)
                declarations: darray[Ast::Decl] @source = [
                    Ast::Decl.Func("bump", [Ast::ParamDecl{name: "value", type_expression: Ast::Expr.Unary(TokenKind.Mutable, Ast::Expr.Unary(TokenKind.Ampersand, integer, at), at), is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}], null, [], [], [], at),
                    Ast::Decl.Func("need_holder", [Ast::ParamDecl{name: "value", type_expression: Ast::Expr.Unary(TokenKind.Mutable, Ast::Expr.Unary(TokenKind.Ampersand, holder, at), at), is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}], null, [], [], [], at),
                    Ast::Decl.Func("caller", [], null, body, [], [], at)
                ]
                table: mutable SymbolTable = SymbolTable(false)
                annotations: darray[Ast::EnumAnnotation] = []
                table <- collect_range(declarations, table, annotations)
                table <- check_lmut_value_arg_walk(declarations, table)
                return false if table.diagnostics.count != expected
                return false if any diagnostic in table.diagnostics where diagnostic.kind != DiagnosticKind.LmutValueArg or diagnostic.expected != "Holder"
                return true

        def compiler_lmut_scope_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    node_store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in node_store:
                        at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                        integer: Ast::Expr = Ast::Expr.Ident("i64", at)
                        holder: Ast::Expr = Ast::Expr.Ident("Holder", at)
                        mutable_integer: Ast::Expr = Ast::Expr.Unary(TokenKind.Mutable, integer, at)
                        local_integer: Ast::Stmt = Ast::Stmt.VarDecl("value", mutable_integer, Ast::Expr.IntLit(0, at), at)
                        local_holder: Ast::Stmt = Ast::Stmt.VarDecl("value", holder, Ast::Expr.Invalid, at)
                        bump: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("bump", at), [Ast::Expr.Ident("value", at)], [""], at)
                        need_holder: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("need_holder", at), [Ast::Expr.Ident("value", at)], [""], at)
                        integer_body: darray[Ast::Stmt] @source = [local_integer, Ast::Stmt.Expr(bump, at)]
                        sibling: darray[Ast::Stmt] @source = [Ast::Stmt.If(Ast::Expr.BoolLit(true, at), integer_body, [local_holder], at)]
                        return 1 if not compiler_lmut_scope_case(sibling, 0)
                        shadow: darray[Ast::Stmt] @source = [local_holder, Ast::Stmt.If(Ast::Expr.BoolLit(true, at), integer_body, [], at), Ast::Stmt.Expr(need_holder, at)]
                        return 2 if not compiler_lmut_scope_case(shadow, 1)
                        ordered: darray[Ast::Stmt] @source = [local_integer, Ast::Stmt.Expr(bump, at), local_holder]
                        return 3 if not compiler_lmut_scope_case(ordered, 0)
                        block_body: darray[Ast::Stmt] @source = [local_holder]
                        block: Ast::Expr = Ast::Expr.Block(block_body, need_holder, [], at)
                        block_call_body: darray[Ast::Stmt] @source = [Ast::Stmt.Expr(block, at)]
                        return 4 if not compiler_lmut_scope_case(block_call_body, 1)
                        immutable_body: darray[Ast::Stmt] @source = [local_holder, Ast::Stmt.Expr(need_holder, at)]
                        return 5 if not compiler_lmut_scope_case(immutable_body, 1)
                        literal_holder: Ast::Expr = Ast::Expr.Construct(holder, [], at)
                        items: Ast::Expr = Ast::Expr.Array([literal_holder], at)
                        plain_loop: Ast::Stmt = Ast::Stmt.For("", ["value"], items, [Ast::Stmt.Expr(need_holder, at)], at)
                        plain_loop_body: darray[Ast::Stmt] @source = [plain_loop]
                        return 6 if not compiler_lmut_scope_case(plain_loop_body, 1)
                        mutable_loop: Ast::Stmt = Ast::Stmt.For("mutable", ["value"], items, [Ast::Stmt.Expr(need_holder, at)], at)
                        mutable_loop_body: darray[Ast::Stmt] @source = [local_holder, mutable_loop, Ast::Stmt.Expr(need_holder, at)]
                        return 7 if not compiler_lmut_scope_case(mutable_loop_body, 1)
                        lambda: Ast::Expr = Ast::Expr.Lambda(["value"], [Ast::Stmt.Expr(need_holder, at)], at)
                        lambda_body: darray[Ast::Stmt] @source = [local_holder, Ast::Stmt.Expr(lambda, at)]
                        return 8 if not compiler_lmut_scope_case(lambda_body, 0)
                        scoped_block: Ast::Stmt = Ast::Stmt.Block("can", [], "", integer_body, at)
                        scoped_body: darray[Ast::Stmt] @source = [local_holder, scoped_block, Ast::Stmt.Expr(need_holder, at)]
                        return 9 if not compiler_lmut_scope_case(scoped_body, 1)
                        splice: Ast::Stmt = Ast::Stmt.Block("static if", [], "", [local_integer], at)
                        splice_body: darray[Ast::Stmt] @source = [local_holder, splice, Ast::Stmt.Expr(bump, at)]
                        return 10 if not compiler_lmut_scope_case(splice_body, 0)
                        block_binding: Ast::Stmt = Ast::Stmt.Block("with", [], "value", [Ast::Stmt.Expr(need_holder, at)], at)
                        binding_body: darray[Ast::Stmt] @source = [local_holder, block_binding]
                        return 11 if not compiler_lmut_scope_case(binding_body, 0)
                        shadow_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("value"), body: [Ast::Stmt.Expr(need_holder, at)], guard: need_holder, pos: at}
                        shadow_arms: darray[Ast::MatchArm] @source = [shadow_arm]
                        matched_body: darray[Ast::Stmt] @source = [local_holder, Ast::Stmt.Match(Ast::Expr.IntLit(0, at), shadow_arms, at)]
                        return 12 if not compiler_lmut_scope_case(matched_body, 0)
                        matched_expression: Ast::Expr = Ast::Expr.Match(Ast::Expr.IntLit(0, at), shadow_arms, at)
                        expression_body: darray[Ast::Stmt] @source = [local_holder, Ast::Stmt.Expr(matched_expression, at)]
                        return 13 if not compiler_lmut_scope_case(expression_body, 0)
                        other_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("other"), body: [Ast::Stmt.Expr(need_holder, at)], guard: need_holder, pos: at}
                        other_arms: darray[Ast::MatchArm] @source = [other_arm]
                        other_body: darray[Ast::Stmt] @source = [local_holder, Ast::Stmt.Match(Ast::Expr.IntLit(0, at), other_arms, at)]
                        return 14 if not compiler_lmut_scope_case(other_body, 2)
                        numbers: Ast::Expr = Ast::Expr.Array([Ast::Expr.IntLit(0, at)], at)
                        comprehension: Ast::Expr = Ast::Expr.Comprehension("value", numbers, need_holder, need_holder, at, 0)
                        comprehension_body: darray[Ast::Stmt] @source = [local_holder, Ast::Stmt.Expr(comprehension, at)]
                        return 15 if not compiler_lmut_scope_case(comprehension_body, 0)
                        invalid_comprehension: Ast::Expr = Ast::Expr.Comprehension("value", items, Expr.Absent, need_holder, at, 0)
                        invalid_comprehension_body: darray[Ast::Stmt] @source = [Ast::Stmt.Expr(invalid_comprehension, at)]
                        return 16 if not compiler_lmut_scope_case(invalid_comprehension_body, 1)
                        condition: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Invalid, TokenKind.Is, Ast::Expr.Ident("value", at), at)
                        conditional_body: darray[Ast::Stmt] @source = [local_holder, Ast::Stmt.If(condition, [Ast::Stmt.Expr(need_holder, at)], [Ast::Stmt.Expr(need_holder, at)], at)]
                        return 17 if not compiler_lmut_scope_case(conditional_body, 1)
                        short_circuit: Ast::Expr = Ast::Expr.Binary(condition, TokenKind.And, need_holder, at)
                        short_circuit_body: darray[Ast::Stmt] @source = [local_holder, Ast::Stmt.Expr(short_circuit, at)]
                        return 18 if not compiler_lmut_scope_case(short_circuit_body, 0)
                        empty_block: Ast::Stmt = Ast::Stmt.Block("with", [], "value", [], at)
                        empty_block_body: darray[Ast::Stmt] @source = [local_holder, empty_block, Ast::Stmt.Expr(need_holder, at)]
                        return 19 if not compiler_lmut_scope_case(empty_block_body, 1)
                        payload_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("need_holder", at), [Ast::Expr.Ident("payload", at)], [""], at)
                        payload_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("payload"), body: [Ast::Stmt.Expr(payload_call, at)], guard: Expr.Absent, pos: at}
                        payload_arms: darray[Ast::MatchArm] @source = [payload_arm]
                        payload_body: darray[Ast::Stmt] @source = [local_holder, Ast::Stmt.Match(Ast::Expr.Ident("value", at), payload_arms, at)]
                        return 20 if not compiler_lmut_scope_case(payload_body, 1)
                        whole_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("need_holder", at), [Ast::Expr.Ident("whole", at)], [""], at)
                        whole_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.As("whole", [Ast::Pattern.Wildcard]), body: [Ast::Stmt.Expr(whole_call, at)], guard: Expr.Absent, pos: at}
                        whole_arms: darray[Ast::MatchArm] @source = [whole_arm]
                        whole_body: darray[Ast::Stmt] @source = [local_holder, Ast::Stmt.Match(Ast::Expr.Ident("value", at), whole_arms, at)]
                        return 21 if not compiler_lmut_scope_case(whole_body, 1)
                        whole_expression: Ast::Expr = Ast::Expr.Match(Ast::Expr.Ident("value", at), whole_arms, at)
                        whole_expression_body: darray[Ast::Stmt] @source = [local_holder, Ast::Stmt.Expr(whole_expression, at)]
                        return 22 if not compiler_lmut_scope_case(whole_expression_body, 1)
                        typed_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("need_holder", at), [Ast::Expr.Ident("typed", at)], [""], at)
                        typed_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.TypeBind("Holder", "typed"), body: [Ast::Stmt.Expr(typed_call, at)], guard: Expr.Absent, pos: at}
                        typed_arms: darray[Ast::MatchArm] @source = [typed_arm]
                        typed_body: darray[Ast::Stmt] @source = [Ast::Stmt.Match(Ast::Expr.IntLit(0, at), typed_arms, at)]
                        return 23 if not compiler_lmut_scope_case(typed_body, 1)
                        typed_expression: Ast::Expr = Ast::Expr.Match(Ast::Expr.IntLit(0, at), typed_arms, at)
                        typed_expression_body: darray[Ast::Stmt] @source = [Ast::Stmt.Expr(typed_expression, at)]
                        return 24 if not compiler_lmut_scope_case(typed_expression_body, 1)
                        tuple_assignment: Ast::Stmt = Ast::Stmt.Assign(Ast::Expr.Array([Ast::Expr.Ident("value", at)], at), TokenKind.Assign, Ast::Expr.Tuple([literal_holder], at), at)
                        tuple_assignment_body: darray[Ast::Stmt] @source = [tuple_assignment, Ast::Stmt.Expr(need_holder, at)]
                        return 25 if not compiler_lmut_scope_case(tuple_assignment_body, 1)
                        tuple_shadow: Ast::Stmt = Ast::Stmt.Assign(Ast::Expr.Array([Ast::Expr.Ident("value", at)], at), TokenKind.Assign, Ast::Expr.Tuple([Ast::Expr.IntLit(0, at)], at), at)
                        tuple_shadow_body: darray[Ast::Stmt] @source = [local_holder, tuple_shadow, Ast::Stmt.Expr(need_holder, at)]
                        return 26 if not compiler_lmut_scope_case(tuple_shadow_body, 0)
                        assigned_holder: Ast::Stmt = Ast::Stmt.Assign(Ast::Expr.Ident("value", at), TokenKind.Assign, literal_holder, at)
                        assigned_holder_body: darray[Ast::Stmt] @source = [assigned_holder, Ast::Stmt.Expr(need_holder, at)]
                        return 27 if not compiler_lmut_scope_case(assigned_holder_body, 1)
                        assigned_integer: Ast::Stmt = Ast::Stmt.Assign(Ast::Expr.Ident("value", at), TokenKind.Assign, Ast::Expr.IntLit(0, at), at)
                        assigned_shadow_body: darray[Ast::Stmt] @source = [local_holder, assigned_integer, Ast::Stmt.Expr(need_holder, at)]
                        return 28 if not compiler_lmut_scope_case(assigned_shadow_body, 0)
                        typed_condition: Ast::Expr = Ast::Expr.Binary(literal_holder, TokenKind.Is, Ast::Expr.Ident("value", at), at)
                        condition_binding_body: darray[Ast::Stmt] @source = [local_integer, Ast::Stmt.If(typed_condition, [Ast::Stmt.Expr(need_holder, at)], [], at)]
                        return 29 if not compiler_lmut_scope_case(condition_binding_body, 1)
                        typed_expression_if: Ast::Expr = Ast::Expr.If(typed_condition, need_holder, Ast::Expr.IntLit(0, at), at)
                        expression_condition_body: darray[Ast::Stmt] @source = [local_integer, Ast::Stmt.Expr(typed_expression_if, at)]
                        return 30 if not compiler_lmut_scope_case(expression_condition_body, 1)
                        swap_targets: Ast::Expr = Ast::Expr.Array([Ast::Expr.Ident("value", at), Ast::Expr.Ident("other", at)], at)
                        swap_values: Ast::Expr = Ast::Expr.Tuple([Ast::Expr.IntLit(0, at), Ast::Expr.Ident("value", at)], at)
                        swap_assignment: Ast::Stmt = Ast::Stmt.Assign(swap_targets, TokenKind.Assign, swap_values, at)
                        swap_body: darray[Ast::Stmt] @source = [local_holder, swap_assignment, Ast::Stmt.Expr(Ast::Expr.Call(Ast::Expr.Ident("need_holder", at), [Ast::Expr.Ident("other", at)], [""], at), at)]
                        return 31 if not compiler_lmut_scope_case(swap_body, 1)
                        and_condition: Ast::Expr = Ast::Expr.Binary(literal_holder, TokenKind.Is, Ast::Expr.Ident("narrowed", at), at)
                        and_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("need_holder", at), [Ast::Expr.Ident("narrowed", at)], [""], at)
                        and_expression: Ast::Expr = Ast::Expr.Binary(and_condition, TokenKind.And, and_call, at)
                        and_body: darray[Ast::Stmt] @source = [Ast::Stmt.Expr(and_expression, at)]
                        return 32 if not compiler_lmut_scope_case(and_body, 1)
                        parenthesized_whole: Ast::Expr = Ast::Expr.Match(Ast::Expr.Paren(Ast::Expr.Ident("value", at), at), whole_arms, at)
                        parenthesized_whole_body: darray[Ast::Stmt] @source = [local_holder, Ast::Stmt.Expr(parenthesized_whole, at)]
                        return 33 if not compiler_lmut_scope_case(parenthesized_whole_body, 1)
                        multi_left_condition: Ast::Expr = Ast::Expr.Binary(literal_holder, TokenKind.Is, Ast::Expr.Ident("left_value", at), at)
                        multi_right_condition: Ast::Expr = Ast::Expr.Binary(literal_holder, TokenKind.Is, Ast::Expr.Ident("right_value", at), at)
                        multi_condition: Ast::Expr = Ast::Expr.Binary(multi_left_condition, TokenKind.And, multi_right_condition, at)
                        multi_then_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("need_holder", at), [Ast::Expr.Ident("right_value", at)], [""], at)
                        multi_condition_body: darray[Ast::Stmt] @source = [Ast::Stmt.If(multi_condition, [Ast::Stmt.Expr(multi_then_call, at)], [], at)]
                        return 34 if not compiler_lmut_scope_case(multi_condition_body, 1)
                        nested_pattern: Ast::Pattern = Ast::Pattern.As("whole", [Ast::Pattern.TypeBind("Holder", "typed")])
                        nested_arm: Ast::MatchArm = Ast::MatchArm{pattern: nested_pattern, body: [Ast::Stmt.Expr(whole_call, at), Ast::Stmt.Expr(typed_call, at)], guard: Expr.Absent, pos: at}
                        nested_arms: darray[Ast::MatchArm] @source = [nested_arm]
                        nested_pattern_body: darray[Ast::Stmt] @source = [local_holder, Ast::Stmt.Match(Ast::Expr.Ident("value", at), nested_arms, at)]
                        return 35 if not compiler_lmut_scope_case(nested_pattern_body, 2)
                        payload_pattern: Ast::Pattern = Ast::Pattern.Variant("Holder.Some", [Ast::Pattern.Binding("payload")])
                        nested_payload_arm: Ast::MatchArm = Ast::MatchArm{pattern: payload_pattern, body: [Ast::Stmt.Expr(payload_call, at)], guard: Expr.Absent, pos: at}
                        nested_payload_arms: darray[Ast::MatchArm] @source = [nested_payload_arm]
                        nested_payload_body: darray[Ast::Stmt] @source = [local_holder, Ast::Stmt.Match(Ast::Expr.Ident("value", at), nested_payload_arms, at)]
                        return 36 if not compiler_lmut_scope_case(nested_payload_body, 0)
                        parenthesized_swap: Ast::Stmt = Ast::Stmt.Assign(swap_targets, TokenKind.Assign, Ast::Expr.Paren(swap_values, at), at)
                        parenthesized_swap_body: darray[Ast::Stmt] @source = [local_holder, parenthesized_swap, Ast::Stmt.Expr(Ast::Expr.Call(Ast::Expr.Ident("need_holder", at), [Ast::Expr.Ident("other", at)], [""], at), at)]
                        return 37 if not compiler_lmut_scope_case(parenthesized_swap_body, 1)
                        duplicate_type_pattern: Ast::Pattern = Ast::Pattern.As("same", [Ast::Pattern.TypeBind("Holder", "same")])
                        duplicate_type_arm: Ast::MatchArm = Ast::MatchArm{pattern: duplicate_type_pattern, body: [Ast::Stmt.Expr(Ast::Expr.Call(Ast::Expr.Ident("need_holder", at), [Ast::Expr.Ident("same", at)], [""], at), at)], guard: Expr.Absent, pos: at}
                        duplicate_type_arms: darray[Ast::MatchArm] @source = [duplicate_type_arm]
                        duplicate_type_body: darray[Ast::Stmt] @source = [Ast::Stmt.Match(Ast::Expr.IntLit(0, at), duplicate_type_arms, at)]
                        return 38 if not compiler_lmut_scope_case(duplicate_type_body, 1)
                        duplicate_unknown_pattern: Ast::Pattern = Ast::Pattern.As("same", [Ast::Pattern.Variant("Holder.Some", [Ast::Pattern.Binding("same")])])
                        duplicate_unknown_arm: Ast::MatchArm = Ast::MatchArm{pattern: duplicate_unknown_pattern, body: [Ast::Stmt.Expr(Ast::Expr.Call(Ast::Expr.Ident("need_holder", at), [Ast::Expr.Ident("same", at)], [""], at), at)], guard: Expr.Absent, pos: at}
                        duplicate_unknown_arms: darray[Ast::MatchArm] @source = [duplicate_unknown_arm]
                        duplicate_unknown_body: darray[Ast::Stmt] @source = [local_holder, Ast::Stmt.Match(Ast::Expr.Ident("value", at), duplicate_unknown_arms, at)]
                        return 39 if not compiler_lmut_scope_case(duplicate_unknown_body, 0)
                        duplicate_whole_pattern: Ast::Pattern = Ast::Pattern.As("same", [Ast::Pattern.Binding("same")])
                        duplicate_whole_arm: Ast::MatchArm = Ast::MatchArm{pattern: duplicate_whole_pattern, body: [Ast::Stmt.Expr(Ast::Expr.Call(Ast::Expr.Ident("need_holder", at), [Ast::Expr.Ident("same", at)], [""], at), at)], guard: Expr.Absent, pos: at}
                        duplicate_whole_arms: darray[Ast::MatchArm] @source = [duplicate_whole_arm]
                        duplicate_whole_body: darray[Ast::Stmt] @source = [local_holder, Ast::Stmt.Match(Ast::Expr.Ident("value", at), duplicate_whole_arms, at)]
                        return 40 if not compiler_lmut_scope_case(duplicate_whole_body, 1)
                        return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_lmut_scope_probe() can Global{Read,Write}
