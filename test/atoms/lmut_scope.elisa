extend Semantic:
    public:
        def compiler_lmut_scope_case(body: darray[Ast::Stmt] @source, expected: usize) -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                integer: Ast::Expr = Ast::Expr.Ident("i64", at)
                holder: Ast::Expr = Ast::Expr.Ident("Holder", at)
                declarations: darray[Ast::Decl] @source = [
                    Ast::Decl.Func("bump", [Ast::ParamDecl{name: "value", type_expression: Ast::Expr.Unary(TokenKind.Mutable, Ast::Expr.Unary(TokenKind.Ampersand, integer, at), at), is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}], null, [], [], [], at),
                    Ast::Decl.Func("need_holder", [Ast::ParamDecl{name: "value", type_expression: Ast::Expr.Unary(TokenKind.Mutable, Ast::Expr.Unary(TokenKind.Ampersand, holder, at), at), is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}], null, [], [], [], at),
                    Ast::Decl.Func("caller", [], null, body, [], [], at)
                ]
                table: mutable SymbolTable = SymbolTable(false)
                annotations: darray[Ast::EnumAnnotation] = []
                table <- collect_range(declarations, table, annotations)
                table <- check_lmut_value_arg_walk(declarations, table)
                return false if table.diagnostics.count != expected
                return false if any diagnostic in table.diagnostics where diagnostic.kind != DiagnosticKind.LmutValueArg or diagnostic.expected != "Holder"
                return true

        def compiler_lmut_scope_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    node_store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in node_store:
                        at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                        integer: Ast::Expr = Ast::Expr.Ident("i64", at)
                        holder: Ast::Expr = Ast::Expr.Ident("Holder", at)
                        mutable_integer: Ast::Expr = Ast::Expr.Unary(TokenKind.Mutable, integer, at)
                        local_integer: Ast::Stmt = Ast::Stmt.VarDecl("value", mutable_integer, Ast::Expr.IntLit(0, at), at)
                        local_holder: Ast::Stmt = Ast::Stmt.VarDecl("value", holder, Ast::Expr.Invalid, at)
                        bump: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("bump", at), [Ast::Expr.Ident("value", at)], [""], at)
                        need_holder: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("need_holder", at), [Ast::Expr.Ident("value", at)], [""], at)
                        integer_body: darray[Ast::Stmt] @source = [local_integer, Ast::Stmt.Expr(bump, at)]
                        sibling: darray[Ast::Stmt] @source = [Ast::Stmt.If(Ast::Expr.BoolLit(true, at), integer_body, [local_holder], at)]
                        return 1 if not compiler_lmut_scope_case(sibling, 0)
                        shadow: darray[Ast::Stmt] @source = [local_holder, Ast::Stmt.If(Ast::Expr.BoolLit(true, at), integer_body, [], at), Ast::Stmt.Expr(need_holder, at)]
                        return 2 if not compiler_lmut_scope_case(shadow, 1)
                        ordered: darray[Ast::Stmt] @source = [local_integer, Ast::Stmt.Expr(bump, at), local_holder]
                        return 3 if not compiler_lmut_scope_case(ordered, 0)
                        block_body: darray[Ast::Stmt] @source = [local_holder]
                        block: Ast::Expr = Ast::Expr.Block(block_body, need_holder, [], at)
                        block_call_body: darray[Ast::Stmt] @source = [Ast::Stmt.Expr(block, at)]
                        return 4 if not compiler_lmut_scope_case(block_call_body, 1)
                        immutable_body: darray[Ast::Stmt] @source = [local_holder, Ast::Stmt.Expr(need_holder, at)]
                        return 5 if not compiler_lmut_scope_case(immutable_body, 1)
                        literal_holder: Ast::Expr = Ast::Expr.Construct(holder, [], at)
                        items: Ast::Expr = Ast::Expr.Array([literal_holder], at)
                        plain_loop: Ast::Stmt = Ast::Stmt.For("", ["value"], items, [Ast::Stmt.Expr(need_holder, at)], at)
                        plain_loop_body: darray[Ast::Stmt] @source = [plain_loop]
                        return 6 if not compiler_lmut_scope_case(plain_loop_body, 1)
                        mutable_loop: Ast::Stmt = Ast::Stmt.For("mutable", ["value"], items, [Ast::Stmt.Expr(need_holder, at)], at)
                        mutable_loop_body: darray[Ast::Stmt] @source = [local_holder, mutable_loop, Ast::Stmt.Expr(need_holder, at)]
                        return 7 if not compiler_lmut_scope_case(mutable_loop_body, 1)
                        return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_lmut_scope_probe() can Global{Read,Write}
