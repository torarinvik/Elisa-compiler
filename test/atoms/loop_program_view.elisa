extend Semantic:
    public:
        def compiler_loop_program_view_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    node_store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in node_store:
                        at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 10, end_line: 1, end_column: 2, end_offset: 11}
                        element: Ast::Expr = Ast::Expr.Ident("sview", at)
                        array_type: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("darray", at), element, at)
                        origin: Ast::Expr = Ast::Expr.Ident("origin", at)
                        other: Ast::Expr = Ast::Expr.Ident("other", at)
                        pending: Ast::Expr = Ast::Expr.Ident("pending", at)
                        read: Ast::Expr = Ast::Expr.Index(pending, Ast::Expr.IntLit(0, at), at)
                        push: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(pending, "push", at), [other], [""], at)
                        body: darray[Ast::Stmt] @source = [
                            Ast::Stmt.VarDecl("pending", array_type, Ast::Expr.Array([origin], at), at),
                            Ast::Stmt.While(Ast::Expr.BoolLit(true, at), [Ast::Stmt.VarDecl("current", element, read, at), Ast::Stmt.Expr(push, at)], at)
                        ]
                        state: mutable ElrState = ElrState{params: ["origin", "other"], scalars: [], row_name: [], row_root: [], known: [], containers: [], as_name: [], as_loop: [], as_line: [], as_reported: [], as_row_index: [], as_row_root: [], loop_id: 0, next_loop: 0, view_structs: [], program_view_offsets: []}
                        table: mutable SymbolTable = SymbolTable(false)
                        table <- elr_walk(body, state, table)
                        return 1 if table.diagnostics.count != 1
                        return 2 if table.diagnostics[0].kind != DiagnosticKind.LoopElementReadWidened
                        annotations: darray[Ast::EnumAnnotation] @source = [
                            Ast::EnumAnnotation{owner: "__global_region", name: "source", line: 1},
                            Ast::EnumAnnotation{owner: "__type_region", name: "source", line: 1, offset: 10},
                            Ast::EnumAnnotation{owner: "__type_region", name: "local", line: 2, offset: 20}
                        ]
                        elr_reset(state)
                        state.params.push("origin")
                        state.params.push("other")
                        regions: darray[Ast::LocalRegionAnnotation] @source = []
                        elr_collect_program_views(annotations, regions, state.program_view_offsets)
                        return 3 if state.program_view_offsets.count != 1
                        return 4 if elr_holds_view(element, state)
                        table <- SymbolTable(false)
                        table <- elr_walk(body, state, table)
                        return 5 if table.diagnostics.count != 0
                        other_at: Ast::Pos = Ast::Pos{line: 2, column: 1, offset: 20, end_line: 2, end_column: 2, end_offset: 21}
                        return 6 if not elr_holds_view(Ast::Expr.Ident("sview", other_at), state)
                        shadow_regions: darray[Ast::LocalRegionAnnotation] @source = [Ast::LocalRegionAnnotation{name: "__region_param", type_expression: Ast::Expr.Invalid, region: "source", line: 1, end_line: 2}]
                        state.program_view_offsets.clear()
                        elr_collect_program_views(annotations, shadow_regions, state.program_view_offsets)
                        return 7 if state.program_view_offsets.count != 0
                        return 8 if not elr_holds_view(element, state)
                        return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_loop_program_view_probe() can Global{Read,Write}
