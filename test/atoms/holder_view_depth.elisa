extend Semantic:
    public:
        def compiler_holder_view_depth_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            region owner(1048576):
                node_store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                in node_store:
                    at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                    flow: mutable CHVViewFlow = CHVViewFlow{}
                    chv_flow_bind(flow, "borrowed", false, true, false)
                    chv_flow_bind(flow, "holder", false, false, true)
                    scalar: mutable Ast::Expr = Ast::Expr.IntLit(1, at)
                    view_value: mutable Ast::Expr = Ast::Expr.Ident("borrowed", at)
                    reference: mutable Ast::Expr = Ast::Expr.Ident("holder", at)
                    for index in 0..<32 |scalar, view_value, reference|:
                        scalar <- Ast::Expr.Paren(scalar, at)
                        view_value <- Ast::Expr.Paren(view_value, at)
                        reference <- Ast::Expr.Paren(reference, at)
                    return 1 if chv_is_owned_view(scalar, flow, 0)
                    return 2 if not chv_is_owned_view(view_value, flow, 0)
                    ref_params: darray[sview] = ["holder"]
                    return 3 if chv_expression_may_alias_ref(scalar, ref_params, flow, 0)
                    return 4 if not chv_expression_may_alias_ref(reference, ref_params, flow, 0)
                    for index in 0..<32 |scalar, view_value|:
                        scalar <- Ast::Expr.Call(Ast::Expr.Ident("identity", at), [scalar], [""], at)
                        view_value <- Ast::Expr.Call(Ast::Expr.Ident("identity", at), [view_value], [""], at)
                    return 5 if chv_is_owned_view(scalar, flow, 0)
                    return 6 if not chv_is_owned_view(view_value, flow, 0)
                    callee: mutable Ast::Expr = Ast::Expr.Field(Ast::Expr.Ident("borrowed", at), "view", at)
                    for index in 0..<32 |callee|:
                        callee <- Ast::Expr.Paren(callee, at)
                    method_info = chv_call_method_info(callee, 0)
                    return 7 if not method_info.found or method_info.method != "view"
                    return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_holder_view_depth_probe()
