extend Semantic:
    public:
        def errorset_param_identity_atom_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                annotations: darray[Ast::EnumAnnotation] @source = [
                    Ast::EnumAnnotation{owner: "__errorset_param", name: "First", line: 42, offset: 100},
                    Ast::EnumAnnotation{owner: "__errorset_param", name: "Second", line: 42, offset: 200},
                    Ast::EnumAnnotation{owner: "__errorset_param", name: "ZeroOffset", line: 43},
                    Ast::EnumAnnotation{owner: "__errorset_param", name: "OtherOffset", line: 43, offset: 200},
                    # A legacy-shaped row defaults to offset 0; it must not wildcard-match other offsets.
                    Ast::EnumAnnotation{owner: "__errorset_param", name: "Legacy", line: 50},
                    Ast::EnumAnnotation{owner: "__errorset_param", name: "OldA", line: 60},
                    Ast::EnumAnnotation{owner: "__errorset_param", name: "OldB", line: 60},
                    Ast::EnumAnnotation{owner: "__errorset_param", name: "ByteZero", module: "ByteZeroModule", line: 44},
                    Ast::EnumAnnotation{owner: "__errorset_param", name: "OtherModuleByteZero", module: "OtherModule", line: 44},
                    Ast::EnumAnnotation{owner: "__errorset_param", name: "OtherModuleZero", module: "OtherModule", line: 45}
                ]
                return 1 if errorset_param_at(annotations, 42, 200, "") != "Second"
                return 2 if errorset_param_at(annotations, 42, 100, "") != "First"
                return 3 if errorset_param_at(annotations, 42, 300, "") != ""
                return 4 if errorset_param_at(annotations, 43, 200, "") != "OtherOffset"
                return 5 if errorset_param_at(annotations, 43, 300, "") != ""
                return 6 if errorset_param_at(annotations, 50, 0, "") != "Legacy"
                return 42 if errorset_param_at(annotations, 50, 500, "") != ""
                return 7 if errorset_param_at(annotations, 60, 600, "") != ""
                return 30 if errorset_param_at(annotations, 44, 0, "ByteZeroModule") != "ByteZero"
                return 31 if errorset_param_at(annotations, 44, 900, "ByteZeroModule") != ""
                return 32 if errorset_param_at(annotations, 45, 900, "ByteZeroModule") != ""
                return 36 if errorset_param_at(annotations, 44, 0, "OtherModule") != "OtherModuleByteZero"
                return 37 if errorset_param_at(annotations, 44, 0, "AbsentModule") != ""

                lines: darray[u32] @source = [42, 42, 43, 43, 50, 60, 60, 44, 44, 45]
                offsets: darray[u32] @source = [100, 200, 0, 200, 0, 0, 0, 0, 0, 0]
                names: darray[sview] @source = ["First", "Second", "ZeroOffset", "OtherOffset", "Legacy", "OldA", "OldB", "ByteZero", "OtherModuleByteZero", "OtherModuleZero"]
                modules: darray[sview] @source = ["", "", "", "", "", "", "", "ByteZeroModule", "OtherModule", "OtherModule"]
                return 8 if cpb_errorset_param(lines, offsets, names, modules, 42, 200, "") != "Second"
                return 9 if cpb_errorset_param(lines, offsets, names, modules, 42, 100, "") != "First"
                return 10 if cpb_errorset_param(lines, offsets, names, modules, 42, 300, "") != ""
                return 11 if cpb_errorset_param(lines, offsets, names, modules, 43, 200, "") != "OtherOffset"
                return 12 if cpb_errorset_param(lines, offsets, names, modules, 43, 300, "") != ""
                return 13 if cpb_errorset_param(lines, offsets, names, modules, 50, 0, "") != "Legacy"
                return 43 if cpb_errorset_param(lines, offsets, names, modules, 50, 500, "") != ""
                return 14 if cpb_errorset_param(lines, offsets, names, modules, 60, 600, "") != ""
                return 33 if cpb_errorset_param(lines, offsets, names, modules, 44, 0, "ByteZeroModule") != "ByteZero"
                return 34 if cpb_errorset_param(lines, offsets, names, modules, 44, 900, "ByteZeroModule") != ""
                return 35 if cpb_errorset_param(lines, offsets, names, modules, 45, 900, "ByteZeroModule") != ""

                candidate_names: darray[sview] @source = ["wrap", "wrap", "wrap", "paint"]
                candidate_params: darray[sview] @source = ["R", "S", "Top", "PaintR"]
                candidate_modules: darray[sview] @source = ["Bad", "Good", "", "A::Paint"]
                good_scope: sview @source = "Good"
                nested_good_scope: sview @source = "Good::Inner"
                bad_scope: sview @source = "Bad"
                unrelated_scope: sview @source = "Other"
                painter_scope: sview @source = "A::Painter"
                paint_child_scope: sview @source = "A::Paint::Inner"
                no_imports: darray[Ast::EnumAnnotation] @source = []
                return 15 if errorset_param_for_scope(candidate_names, candidate_params, candidate_modules, no_imports, "wrap", good_scope, 70, 700, true) != "S"
                return 16 if errorset_param_for_scope(candidate_names, candidate_params, candidate_modules, no_imports, "wrap", nested_good_scope, 70, 700, true) != "S"
                return 17 if errorset_param_for_scope(candidate_names, candidate_params, candidate_modules, no_imports, "wrap", bad_scope, 70, 700, true) != "R"
                return 18 if errorset_param_for_scope(candidate_names, candidate_params, candidate_modules, no_imports, "wrap", unrelated_scope, 70, 700, true) != "Top"
                return 19 if errorset_param_for_scope(candidate_names, candidate_params, candidate_modules, no_imports, "paint", painter_scope, 70, 700, true) != ""
                return 20 if errorset_param_for_scope(candidate_names, candidate_params, candidate_modules, no_imports, "paint", paint_child_scope, 70, 700, true) != "PaintR"

                shadow_names: darray[sview] @source = ["wrap", "wrap"]
                shadow_params: darray[sview] @source = ["", "AncestorR"]
                shadow_modules: darray[sview] @source = ["Good", ""]
                return 21 if errorset_param_for_scope(shadow_names, shadow_params, shadow_modules, no_imports, "wrap", good_scope, 70, 700, true) != ""

                sibling_names: darray[sview] @source = ["wrap"]
                sibling_params: darray[sview] @source = ["R"]
                sibling_modules: darray[sview] @source = ["Bad"]
                return 22 if errorset_param_for_scope(sibling_names, sibling_params, sibling_modules, no_imports, "wrap", good_scope, 70, 700, true) != ""

                import_rows: darray[Ast::EnumAnnotation] @source = [
                    Ast::EnumAnnotation{owner: "Far", name: "__binding_wildcard_import", module: "Good", line: 10, offset: 100},
                    Ast::EnumAnnotation{owner: "__from_member", name: "fetch", module: "Good", line: 11, offset: 110},
                    Ast::EnumAnnotation{owner: "Far", name: "__from_src", module: "Good", line: 11, offset: 110}
                ]
                import_names: darray[sview] @source = ["remote", "fetch"]
                import_params: darray[sview] @source = ["WildR", "SelectiveR"]
                import_modules: darray[sview] @source = ["Far", "Far"]
                return 23 if errorset_param_for_scope(import_names, import_params, import_modules, import_rows, "remote", good_scope, 9, 90, true) != ""
                return 24 if errorset_param_for_scope(import_names, import_params, import_modules, import_rows, "remote", good_scope, 12, 120, true) != "WildR"
                return 25 if errorset_param_for_scope(import_names, import_params, import_modules, import_rows, "fetch", good_scope, 12, 120, true) != "SelectiveR"
                return 26 if errorset_param_for_scope(import_names, import_params, import_modules, import_rows, "fetch", nested_good_scope, 12, 120, true) != "SelectiveR"

                imported_shadow_names: darray[sview] @source = ["remote", "remote"]
                imported_shadow_params: darray[sview] @source = ["", "WildR"]
                imported_shadow_modules: darray[sview] @source = ["Good", "Far"]
                return 27 if errorset_param_for_scope(imported_shadow_names, imported_shadow_params, imported_shadow_modules, import_rows, "remote", good_scope, 12, 120, true) != ""

                bytezero_import_rows: darray[Ast::EnumAnnotation] @source = [
                    Ast::EnumAnnotation{owner: "Far", name: "__binding_wildcard_import", module: "Good", line: 0, offset: 0, pos: Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 3, end_offset: 3}}
                ]
                bytezero_names: darray[sview] @source = ["remote"]
                bytezero_params: darray[sview] @source = ["ByteZeroR"]
                bytezero_modules: darray[sview] @source = ["Far"]
                # `pos` proves this offset-zero import is source-backed; the call's explicit
                # presence bit proves its offset too, so physical order wins over #line.
                return 38 if errorset_param_for_scope(bytezero_names, bytezero_params, bytezero_modules, bytezero_import_rows, "remote", good_scope, 0, 12, true) != "ByteZeroR"
                call_bytezero_after_import_rows: darray[Ast::EnumAnnotation] @source = [
                    Ast::EnumAnnotation{owner: "Far", name: "__binding_wildcard_import", module: "Good", line: 0, offset: 5, pos: Ast::Pos{line: 0, column: 0, offset: 5, end_line: 0, end_column: 3, end_offset: 8}}
                ]
                # At #line 0, a zero call offset is exact when its AST source span is present;
                # a later same-line import must not become visible by line-order fallback.
                return 39 if errorset_param_for_scope(bytezero_names, bytezero_params, bytezero_modules, call_bytezero_after_import_rows, "remote", good_scope, 0, 0, true) != ""

                legacy_import_rows: darray[Ast::EnumAnnotation] @source = [
                    Ast::EnumAnnotation{owner: "Far", name: "__binding_wildcard_import", module: "Good", line: 11}
                ]
                return 40 if errorset_param_for_scope(bytezero_names, bytezero_params, bytezero_modules, legacy_import_rows, "remote", good_scope, 12, 12, true) != "ByteZeroR"
                legacy_same_line_rows: darray[Ast::EnumAnnotation] @source = [
                    Ast::EnumAnnotation{owner: "Far", name: "__binding_wildcard_import", module: "Good", line: 12}
                ]
                return 41 if errorset_param_for_scope(bytezero_names, bytezero_params, bytezero_modules, legacy_same_line_rows, "remote", good_scope, 12, 12, true) != ""

                extern_probe_at: Ast::Pos = Ast::Pos{line: 80, column: 1, offset: 800, end_line: 80, end_column: 2, end_offset: 801}
                extern_declarations: darray[Ast::Decl] @source = [
                    Ast::Decl.Extern("wrap", 0, 0, false, true, "i64", [], extern_probe_at),
                    Ast::Decl.Extern("opaque_value", 0, 0, false, false, "i64", [], extern_probe_at)
                ]
                no_error_set_rows: darray[Ast::EnumAnnotation] @source = []
                extern_names: mutable darray[sview] = []
                extern_params: mutable darray[sview] = []
                extern_modules: mutable darray[sview] = []
                errorset_collect_candidates(extern_declarations, no_error_set_rows, extern_names, extern_params, extern_modules)
                return 28 if extern_names.count != 1.usize() or extern_names[0] != "wrap"
                return 29 if extern_params[0] != "" or extern_modules[0] != ""
                return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::errorset_param_identity_atom_probe() can Global{Read,Write}
