extend Semantic:
    public:
        def errorset_param_identity_atom_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                annotations: darray[Ast::EnumAnnotation] @source = [
                    Ast::EnumAnnotation{owner: "__errorset_param", name: "First", line: 42, offset: 100},
                    Ast::EnumAnnotation{owner: "__errorset_param", name: "Second", line: 42, offset: 200},
                    Ast::EnumAnnotation{owner: "__errorset_param", name: "ZeroOffset", line: 43},
                    Ast::EnumAnnotation{owner: "__errorset_param", name: "OtherOffset", line: 43, offset: 200},
                    Ast::EnumAnnotation{owner: "__errorset_param", name: "Legacy", line: 50},
                    Ast::EnumAnnotation{owner: "__errorset_param", name: "OldA", line: 60},
                    Ast::EnumAnnotation{owner: "__errorset_param", name: "OldB", line: 60}
                ]
                return 1 if errorset_param_at(annotations, 42, 200) != "Second"
                return 2 if errorset_param_at(annotations, 42, 100) != "First"
                return 3 if errorset_param_at(annotations, 42, 300) != ""
                return 4 if errorset_param_at(annotations, 43, 200) != "OtherOffset"
                return 5 if errorset_param_at(annotations, 43, 300) != ""
                return 6 if errorset_param_at(annotations, 50, 500) != "Legacy"
                return 7 if errorset_param_at(annotations, 60, 600) != ""

                lines: darray[u32] @source = [42, 42, 43, 43, 50, 60, 60]
                offsets: darray[u32] @source = [100, 200, 0, 200, 0, 0, 0]
                names: darray[sview] @source = ["First", "Second", "ZeroOffset", "OtherOffset", "Legacy", "OldA", "OldB"]
                return 8 if cpb_errorset_param(lines, offsets, names, 42, 200) != "Second"
                return 9 if cpb_errorset_param(lines, offsets, names, 42, 100) != "First"
                return 10 if cpb_errorset_param(lines, offsets, names, 42, 300) != ""
                return 11 if cpb_errorset_param(lines, offsets, names, 43, 200) != "OtherOffset"
                return 12 if cpb_errorset_param(lines, offsets, names, 43, 300) != ""
                return 13 if cpb_errorset_param(lines, offsets, names, 50, 500) != "Legacy"
                return 14 if cpb_errorset_param(lines, offsets, names, 60, 600) != ""

                candidate_names: darray[sview] @source = ["wrap", "wrap", "wrap", "paint"]
                candidate_params: darray[sview] @source = ["R", "S", "Top", "PaintR"]
                candidate_modules: darray[sview] @source = ["Bad", "Good", "", "A::Paint"]
                good_scope: sview @source = "Good"
                nested_good_scope: sview @source = "Good::Inner"
                bad_scope: sview @source = "Bad"
                unrelated_scope: sview @source = "Other"
                painter_scope: sview @source = "A::Painter"
                paint_child_scope: sview @source = "A::Paint::Inner"
                no_imports: darray[Ast::EnumAnnotation] @source = []
                return 15 if errorset_param_for_scope(candidate_names, candidate_params, candidate_modules, no_imports, "wrap", good_scope, 70, 700) != "S"
                return 16 if errorset_param_for_scope(candidate_names, candidate_params, candidate_modules, no_imports, "wrap", nested_good_scope, 70, 700) != "S"
                return 17 if errorset_param_for_scope(candidate_names, candidate_params, candidate_modules, no_imports, "wrap", bad_scope, 70, 700) != "R"
                return 18 if errorset_param_for_scope(candidate_names, candidate_params, candidate_modules, no_imports, "wrap", unrelated_scope, 70, 700) != "Top"
                return 19 if errorset_param_for_scope(candidate_names, candidate_params, candidate_modules, no_imports, "paint", painter_scope, 70, 700) != ""
                return 20 if errorset_param_for_scope(candidate_names, candidate_params, candidate_modules, no_imports, "paint", paint_child_scope, 70, 700) != "PaintR"

                shadow_names: darray[sview] @source = ["wrap", "wrap"]
                shadow_params: darray[sview] @source = ["", "AncestorR"]
                shadow_modules: darray[sview] @source = ["Good", ""]
                return 21 if errorset_param_for_scope(shadow_names, shadow_params, shadow_modules, no_imports, "wrap", good_scope, 70, 700) != ""

                sibling_names: darray[sview] @source = ["wrap"]
                sibling_params: darray[sview] @source = ["R"]
                sibling_modules: darray[sview] @source = ["Bad"]
                return 22 if errorset_param_for_scope(sibling_names, sibling_params, sibling_modules, no_imports, "wrap", good_scope, 70, 700) != ""

                import_rows: darray[Ast::EnumAnnotation] @source = [
                    Ast::EnumAnnotation{owner: "Far", name: "__binding_wildcard_import", module: "Good", line: 10, offset: 100},
                    Ast::EnumAnnotation{owner: "__from_member", name: "fetch", module: "Good", line: 11, offset: 110},
                    Ast::EnumAnnotation{owner: "Far", name: "__from_src", module: "Good", line: 11, offset: 110}
                ]
                import_names: darray[sview] @source = ["remote", "fetch"]
                import_params: darray[sview] @source = ["WildR", "SelectiveR"]
                import_modules: darray[sview] @source = ["Far", "Far"]
                return 23 if errorset_param_for_scope(import_names, import_params, import_modules, import_rows, "remote", good_scope, 9, 90) != ""
                return 24 if errorset_param_for_scope(import_names, import_params, import_modules, import_rows, "remote", good_scope, 12, 120) != "WildR"
                return 25 if errorset_param_for_scope(import_names, import_params, import_modules, import_rows, "fetch", good_scope, 12, 120) != "SelectiveR"
                return 26 if errorset_param_for_scope(import_names, import_params, import_modules, import_rows, "fetch", nested_good_scope, 12, 120) != "SelectiveR"

                imported_shadow_names: darray[sview] @source = ["remote", "remote"]
                imported_shadow_params: darray[sview] @source = ["", "WildR"]
                imported_shadow_modules: darray[sview] @source = ["Good", "Far"]
                return 27 if errorset_param_for_scope(imported_shadow_names, imported_shadow_params, imported_shadow_modules, import_rows, "remote", good_scope, 12, 120) != ""

                extern_probe_at: Ast::Pos = Ast::Pos{line: 80, column: 1, offset: 800, end_line: 80, end_column: 2, end_offset: 801}
                extern_declarations: darray[Ast::Decl] @source = [
                    Ast::Decl.Extern("wrap", 0, 0, false, true, "i64", [], extern_probe_at),
                    Ast::Decl.Extern("opaque_value", 0, 0, false, false, "i64", [], extern_probe_at)
                ]
                no_error_set_rows: darray[Ast::EnumAnnotation] @source = []
                extern_names: mutable darray[sview] = []
                extern_params: mutable darray[sview] = []
                extern_modules: mutable darray[sview] = []
                errorset_collect_candidates(extern_declarations, no_error_set_rows, extern_names, extern_params, extern_modules)
                return 28 if extern_names.count != 1.usize() or extern_names[0] != "wrap"
                return 29 if extern_params[0] != "" or extern_modules[0] != ""
                return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::errorset_param_identity_atom_probe() can Global{Read,Write}
