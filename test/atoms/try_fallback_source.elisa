                input_parameter: Ast::ParamDecl = Ast::ParamDecl{name: "input", type_expression: Ast::Expr.Ident("i64", at), is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}
                identity_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("identity", at), [Ast::Expr.Ident("input", at)], [""], at)
                identity_payload: (family: sview @source, known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_catch_success_payload_facts(identity_call, [input_parameter], environment, annotations)
