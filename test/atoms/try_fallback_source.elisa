extend Semantic:
    public:
        def compiler_try_fallback_source_probe() -> i64 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    nodes: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in nodes:
                        at: Ast::Pos = zeroed
                        call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("read_value", at), [], [], at)
                        pointer_target: Ast::Expr = Ast::Expr.Unary(TokenKind.Ampersand, Ast::Expr.Ident("u8", at), at)
                        cast_head: Ast::Expr = Ast::Expr.Field(Ast::Expr.IntLit(0, at), "cast", at)
                        pointer_cast: Ast::Expr = Ast::Expr.Index(cast_head, pointer_target, at)
                        array_target: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("darray", at), Ast::Expr.Ident("i32", at), at)
                        array_cast: Ast::Expr = Ast::Expr.Index(cast_head, array_target, at)
                        names: mutable darray[sview @source] = []
                        names.push(try_fallback_callee_name(call))
                        names.push(try_fallback_cast_target_base(pointer_target))
                        names.push(try_fallback_cast_target_spelling(pointer_cast))
                        names.push(try_fallback_cast_target_spelling(array_cast))
                        names.push(try_fallback_cast_target_element(array_cast))
                        return 1 if names[0] != "read_value"
                        return 2 if names[1] != "u8" or names[2] != "u8"
                        return 3 if names[3] != "darray" or names[4] != "i32"
                        return 4 if not try_fallback_cast_target_has_ref(pointer_cast)
                        return 5 if try_fallback_cast_target_has_ref(array_cast)
                        return 6 if try_fallback_callee_name(Ast::Expr.IntLit(0, at)) != ""
                        return 7 if not compiler_try_noncall_facts_probe(at)
                        return 8 if not compiler_try_variant_alias_shadow_case(at)
                        return 9 if not compiler_try_qualified_call_alias_case(at)
                        return 10 if not compiler_try_catch_numeric_alias_case(at)
                        return 11 if not compiler_try_lambda_numeric_shadow_case(at)
                        return 12 if not compiler_try_nested_catch_raise_case(at)
                        return 13 if not compiler_try_generic_named_actual_mapping_case(at)
                        return 14 if not compiler_try_generic_catch_payload_facts_case(at)
                        return 0

        def compiler_try_nested_catch_raise_case(at: Ast::Pos) -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                annotations: darray[Ast::EnumAnnotation] = [
                    Ast::EnumAnnotation{owner: "load", name: "__lsp_func_name", line: 1, offset: 1, identity_id: 1},
                    Ast::EnumAnnotation{owner: "load", name: "__error_return", line: 1, offset: 1, identity_id: 1},
                    Ast::EnumAnnotation{owner: "load", name: "E", line: 1, offset: 1, identity_id: 1}
                ]
                load_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("load", at), [], [], at)
                panic_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("panic", at), [], [], at)
                raise_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("raise", at), [Ast::Expr.Ident("problem", at)], [], at)
                inner_success: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("success"), body: [Ast::Stmt.Expr(panic_call, at)], guard: Ast::Expr.Absent, pos: at}
                inner_error: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.TypeBind("error", "problem"), body: [Ast::Stmt.Expr(raise_call, at)], guard: Ast::Expr.Absent, pos: at}
                inner_catch: Ast::Expr = Ast::Expr.Catch(load_call, [inner_success, inner_error], at)
                outer_success: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("value"), body: [Ast::Stmt.Expr(Ast::Expr.IntLit(1, at), at)], guard: Ast::Expr.Absent, pos: at}
                outer_error: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.TypeBind("error", "problem"), body: [Ast::Stmt.Expr(Ast::Expr.IntLit(2, at), at)], guard: Ast::Expr.Absent, pos: at}
                outer_catch: Ast::Expr = Ast::Expr.Catch(inner_catch, [outer_success, outer_error], at)
                return false if try_noncall_expression_aborts_with_annotations(outer_catch, annotations)
                return false if not try_noncall_expression_may_raise_catchably_with_annotations(load_call, annotations, "")
                statement_catch_success: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("success"), body: [Ast::Stmt.Expr(Ast::Expr.IntLit(1, at), at)], guard: Ast::Expr.Absent, pos: at}
                statement_catch_error: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.TypeBind("error", "problem"), body: [Ast::Stmt.Expr(raise_call, at)], guard: Ast::Expr.Absent, pos: at}
                statement_catch_pos: Ast::Pos = Ast::Pos{line: 501, column: 1, offset: 501, end_line: 501, end_column: 2, end_offset: 502}
                statement_catch: Ast::Stmt = Ast::Stmt.Match(load_call, [statement_catch_success, statement_catch_error], statement_catch_pos)
                statement_catch_annotations: darray[Ast::EnumAnnotation] = [
                    Ast::EnumAnnotation{owner: "load", name: "__lsp_func_name", line: 1, offset: 1, identity_id: 1},
                    Ast::EnumAnnotation{owner: "load", name: "__error_return", line: 1, offset: 1, identity_id: 1},
                    Ast::EnumAnnotation{owner: "load", name: "E", line: 1, offset: 1, identity_id: 1},
                    Ast::EnumAnnotation{owner: "__catch_match", name: "__catch_match", line: 501, offset: 501}
                ]
                return false if not try_noncall_statements_may_raise_catchably_with_annotations([statement_catch], statement_catch_annotations, "")
                ordinary_match_pos: Ast::Pos = Ast::Pos{line: 501, column: 3, offset: 503, end_line: 501, end_column: 4, end_offset: 504}
                ordinary_match: Ast::Stmt = Ast::Stmt.Match(Ast::Expr.IntLit(0, at), [statement_catch_success, statement_catch_error], ordinary_match_pos)
                return false if try_noncall_statements_may_raise_catchably_with_annotations([ordinary_match], statement_catch_annotations, "")
                return false if not compiler_try_module_error_family_identity_case(at)
                method_callee: Ast::Expr = Ast::Expr.Field(Ast::Expr.Ident("reader", at), "load", at)
                method_call: Ast::Expr = Ast::Expr.Call(method_callee, [], [], at)
                method_callee_name: sview @source = try_noncall_error_scan_callable_name(method_callee)
                method_family: (known: bool, family: sview @source) = try_noncall_callable_error_family(method_callee_name, annotations)
                return false if method_callee_name != "" or method_family.known
                return false if not try_noncall_expression_may_raise_catchably_with_annotations(method_call, annotations, "")
                qualified_callee: Ast::Expr = Ast::Expr.Scope(Ast::Expr.Ident("OtherModule", at), "load", at)
                qualified_call: Ast::Expr = Ast::Expr.Call(qualified_callee, [], [], at)
                return false if try_noncall_error_scan_callable_name(qualified_callee) != ""
                return false if not try_noncall_expression_may_raise_catchably_with_annotations(qualified_call, annotations, "")
                nonfallible_success: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("value"), body: [Ast::Stmt.Expr(Ast::Expr.IntLit(1, at), at)], guard: Ast::Expr.Absent, pos: at}
                unreachable_fallible_error: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.TypeBind("error", "problem"), body: [Ast::Stmt.Expr(load_call, at)], guard: Ast::Expr.Absent, pos: at}
                unreachable_error_catch: Ast::Expr = Ast::Expr.Catch(Ast::Expr.IntLit(0, at), [nonfallible_success, unreachable_fallible_error], at)
                catch_environment: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{}
                unreachable_error_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(unreachable_error_catch, [], catch_environment, annotations)
                return false if unreachable_error_facts.family != "" or not unreachable_error_facts.known_nonfallible
                ambiguous_method_annotations: darray[Ast::EnumAnnotation] = [
                    Ast::EnumAnnotation{owner: "load", name: "__lsp_func_name", line: 1, offset: 1, identity_id: 1},
                    Ast::EnumAnnotation{owner: "load", name: "__error_return", line: 1, offset: 1, identity_id: 1},
                    Ast::EnumAnnotation{owner: "load", name: "E", line: 1, offset: 1, identity_id: 1},
                    Ast::EnumAnnotation{owner: "load", name: "__lsp_func_name", line: 2, offset: 2, identity_id: 2}
                ]
                ambiguous_direct_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("load", at), [], [], at)
                ambiguous_family: (known: bool, family: sview @source) = try_noncall_callable_error_family("load", ambiguous_method_annotations)
                return false if ambiguous_family.known or not try_noncall_expression_may_raise_catchably_with_annotations(ambiguous_direct_call, ambiguous_method_annotations, "")
                missing_method_declaration_annotations: darray[Ast::EnumAnnotation] = [
                    Ast::EnumAnnotation{owner: "load", name: "__error_return", line: 1, offset: 1, identity_id: 1},
                    Ast::EnumAnnotation{owner: "load", name: "E", line: 1, offset: 1, identity_id: 1}
                ]
                return false if not try_noncall_expression_may_raise_catchably_with_annotations(method_call, missing_method_declaration_annotations, "")
                extern_annotations: darray[Ast::EnumAnnotation] = [
                    Ast::EnumAnnotation{owner: "__extern_return", name: "i64", line: 4},
                    Ast::EnumAnnotation{owner: "external", name: "__extern_return_text_complete", line: 4},
                    Ast::EnumAnnotation{owner: "external", name: "__error_return", line: 4},
                    Ast::EnumAnnotation{owner: "external", name: "E", line: 4}
                ]
                extern_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("external", at), [], [], at)
                return false if not try_noncall_expression_may_raise_catchably_with_annotations(extern_call, extern_annotations, "")
                nonfallible_inner: Ast::Expr = Ast::Expr.Catch(Ast::Expr.IntLit(0, at), [inner_success, inner_error], at)
                return false if try_noncall_expression_may_raise_catchably_with_annotations(nonfallible_inner, annotations, "")
                return true

        def compiler_try_module_error_family_identity_case(at: Ast::Pos) -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                table: mutable SymbolTable = SymbolTable(false)
                table.enum_variant_owner.push("Fault")
                table.enum_variant_name.push("Available")
                table.enum_variant_module.push("Provider")
                table.enum_variant_owner.push("Fault")
                table.enum_variant_name.push("Busy")
                table.enum_variant_module.push("Peer")
                provider_rows: darray[Ast::EnumAnnotation] = [
                    Ast::EnumAnnotation{owner: "get", name: "__error_return", line: 10, offset: 100, identity_id: 11},
                    Ast::EnumAnnotation{owner: "get", name: "Fault", line: 10, offset: 100, identity_id: 11},
                    Ast::EnumAnnotation{owner: "__fn_module", name: "Provider", line: 10, offset: 100, identity_id: 11},
                    Ast::EnumAnnotation{owner: "__error_set_family", name: "Fault", line: 10, offset: 100, identity_id: 11},
                    Ast::EnumAnnotation{owner: "__error_set_family_path", name: "Provider::Fault", line: 10, offset: 100, identity_id: 11},
                    Ast::EnumAnnotation{owner: "__error_set_decl", name: "Fault", module: "Provider", line: 9, offset: 90}
                ]
                peer_rows: darray[Ast::EnumAnnotation] = [
                    Ast::EnumAnnotation{owner: "get_peer", name: "__error_return", line: 20, offset: 200, identity_id: 22},
                    Ast::EnumAnnotation{owner: "get_peer", name: "Fault", line: 20, offset: 200, identity_id: 22},
                    Ast::EnumAnnotation{owner: "__fn_module", name: "Peer", line: 20, offset: 200, identity_id: 22},
                    Ast::EnumAnnotation{owner: "__error_set_family", name: "Fault", line: 20, offset: 200, identity_id: 22},
                    Ast::EnumAnnotation{owner: "__error_set_family_path", name: "Peer::Fault", line: 20, offset: 200, identity_id: 22},
                    Ast::EnumAnnotation{owner: "__error_set_decl", name: "Fault", module: "Peer", line: 19, offset: 190}
                ]
                provider_family_path: sview @source = try_error_family_path_for_declaration(provider_rows, provider_rows[1].name, 10, 100, 11, 0)
                peer_family_path: sview @source = try_error_family_path_for_declaration(peer_rows, peer_rows[1].name, 20, 200, 22, 0)
                provider_ref: TryErrorFamilyRef = try_error_family_ref_for_annotation(provider_rows, provider_rows[1], provider_family_path, true, "Provider", table)
                peer_ref: TryErrorFamilyRef = try_error_family_ref_for_annotation(peer_rows, peer_rows[1], peer_family_path, true, "Peer", table)
                same_provider_ref: TryErrorFamilyRef = try_error_family_ref_for_annotation(provider_rows, provider_rows[1], provider_family_path, true, "Provider", table)
                return false if not provider_ref.module_known or not peer_ref.module_known
                return false if provider_ref.module != "Provider" or peer_ref.module != "Peer"
                file: Ast::File = zeroed
                return false if try_error_family_refs_match(file, provider_rows, provider_ref, peer_ref, table)
                return false if error_family_covers(file, provider_rows, provider_ref, peer_ref, table)
                return try_error_family_refs_match(file, provider_rows, provider_ref, same_provider_ref, table) and error_family_covers(file, provider_rows, provider_ref, same_provider_ref, table)

        def compiler_try_generic_named_actual_mapping_case(at: Ast::Pos) -> bool can[Abort.Panic]:
            can Global{Read,Write}:
                arguments: darray[Ast::Expr] = [Ast::Expr.IntLit(0, at), Ast::Expr.IntLit(1, at), Ast::Expr.IntLit(2, at)]
                argument_names: darray[sview] = ["", "marker", "value"]
                actual_index: usize = try_noncall_generic_call_argument_index(arguments, argument_names, "value", 1.usize())
                return actual_index == 2.usize()

