                    Ast::EnumAnnotation{owner: "load", name: "E", line: load_pos.line, offset: load_pos.offset, identity_id: 3},
                    Ast::EnumAnnotation{owner: "load_flag", name: "__error_return", line: flag_pos.line, offset: flag_pos.offset, identity_id: 4},
                    Ast::EnumAnnotation{owner: "load_flag", name: "E", line: flag_pos.line, offset: flag_pos.offset, identity_id: 4}
                ]
                environment: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{}
                try_noncall_callable_facts_add(declarations, annotations, environment, "")
                load_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("load", at), [], [], at)
                success_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("success"), body: [Ast::Stmt.Expr(Ast::Expr.Ident("success", at), at)], guard: Ast::Expr.Absent, pos: at}
                error_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.TypeBind("error", "problem"), body: [Ast::Stmt.Expr(Ast::Expr.IntLit(0, at), at)], guard: Ast::Expr.Absent, pos: at}
                catch_value: Ast::Expr = Ast::Expr.Catch(load_call, [success_arm, error_arm], at)
                catch_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(catch_value, [], environment, annotations)
                payload_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_catch_success_payload_facts(load_call, [], environment, annotations)
                returning_error_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.TypeBind("error", "problem"), body: [Ast::Stmt.Return(Ast::Expr.StringLit("different result type", at), at)], guard: Ast::Expr.Absent, pos: at}
                returning_success_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("success"), body: [Ast::Stmt.Return(Ast::Expr.IntLit(1, at), at)], guard: Ast::Expr.Absent, pos: at}
                continuing_catch_facts: (numeric: bool, integer: bool) = try_noncall_catch_result_facts(load_call, [success_arm, returning_error_arm], [], environment)
                returning_catch_facts: (numeric: bool, integer: bool) = try_noncall_catch_result_facts(load_call, [returning_success_arm, returning_error_arm], [], environment)
                arithmetic: Ast::Expr = Ast::Expr.Binary(catch_value, TokenKind.Plus, Ast::Expr.IntLit(1, at), at)
                flag_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("load_flag", at), [], [], at)
                flag_success_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("flag_success"), body: [Ast::Stmt.Expr(Ast::Expr.Ident("flag_success", at), at)], guard: Ast::Expr.Absent, pos: at}
                flag_error_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.TypeBind("error", "problem"), body: [Ast::Stmt.Expr(Ast::Expr.BoolLit(false, at), at)], guard: Ast::Expr.Absent, pos: at}
                flag_catch: Ast::Expr = Ast::Expr.Catch(flag_call, [flag_success_arm, flag_error_arm], at)
                flag_catch_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(flag_catch, [], environment, annotations)
                flag_payload_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_catch_success_payload_facts(flag_call, [], environment, annotations)
                return catch_facts.known_nonfallible and catch_facts.family == "" and payload_facts.known_nonfallible and payload_facts.numeric and payload_facts.integer and try_noncall_numeric_value(catch_value, [], environment) and try_noncall_integer_value(catch_value, [], environment) and continuing_catch_facts.numeric and continuing_catch_facts.integer and not returning_catch_facts.numeric and not returning_catch_facts.integer and try_noncall_expression_is_known_nonfallible(arithmetic, [], environment) and flag_catch_facts.known_nonfallible and flag_catch_facts.family == "" and flag_payload_facts.known_nonfallible and not flag_payload_facts.numeric and not flag_payload_facts.integer and not try_noncall_numeric_value(flag_catch, [], environment)

        def compiler_try_lambda_numeric_shadow_case(at: Ast::Pos) -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                outer_pos: Ast::Pos = Ast::Pos{line: 40, column: 5, offset: 400, end_line: 40, end_column: 10, end_offset: 405}
                lambda_pos: Ast::Pos = Ast::Pos{line: 41, column: 5, offset: 420, end_line: 41, end_column: 50, end_offset: 465}
