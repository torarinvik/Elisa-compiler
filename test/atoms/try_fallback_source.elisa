                try_noncall_callable_facts_add(declarations, annotations, marker_index, environment, "", table)
                load_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("load", at), [], [], at)
                success_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("success"), body: [Ast::Stmt.Expr(Ast::Expr.Ident("success", at), at)], guard: Ast::Expr.Absent, pos: at}
                error_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.TypeBind("error", "problem"), body: [Ast::Stmt.Expr(Ast::Expr.IntLit(0, at), at)], guard: Ast::Expr.Absent, pos: at}
                catch_value: Ast::Expr = Ast::Expr.Catch(load_call, [success_arm, error_arm], at)
                catch_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(catch_value, [], environment, annotations)
                payload_facts: (family: sview @source, known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_catch_success_payload_facts(load_call, [], environment, annotations)
                returning_error_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.TypeBind("error", "problem"), body: [Ast::Stmt.Return(Ast::Expr.StringLit("different result type", at), at)], guard: Ast::Expr.Absent, pos: at}
                returning_success_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("success"), body: [Ast::Stmt.Return(Ast::Expr.IntLit(1, at), at)], guard: Ast::Expr.Absent, pos: at}
                continuing_catch_facts: (numeric: bool, integer: bool) = try_noncall_catch_result_facts(load_call, [success_arm, returning_error_arm], [], environment)
                returning_catch_facts: (numeric: bool, integer: bool) = try_noncall_catch_result_facts(load_call, [returning_success_arm, returning_error_arm], [], environment)
                arithmetic: Ast::Expr = Ast::Expr.Binary(catch_value, TokenKind.Plus, Ast::Expr.IntLit(1, at), at)
                flag_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("load_flag", at), [], [], at)
                flag_success_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("flag_success"), body: [Ast::Stmt.Expr(Ast::Expr.Ident("flag_success", at), at)], guard: Ast::Expr.Absent, pos: at}
                flag_error_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.TypeBind("error", "problem"), body: [Ast::Stmt.Expr(Ast::Expr.BoolLit(false, at), at)], guard: Ast::Expr.Absent, pos: at}
                flag_catch: Ast::Expr = Ast::Expr.Catch(flag_call, [flag_success_arm, flag_error_arm], at)
                flag_catch_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(flag_catch, [], environment, annotations)
                flag_payload_facts: (family: sview @source, known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_catch_success_payload_facts(flag_call, [], environment, annotations)
                return catch_facts.known_nonfallible and catch_facts.family == "" and payload_facts.family == "" and payload_facts.known_nonfallible and payload_facts.numeric and payload_facts.integer and try_noncall_numeric_value(catch_value, [], environment) and try_noncall_integer_value(catch_value, [], environment) and continuing_catch_facts.numeric and continuing_catch_facts.integer and not returning_catch_facts.numeric and not returning_catch_facts.integer and try_noncall_expression_is_known_nonfallible(arithmetic, [], environment) and flag_catch_facts.known_nonfallible and flag_catch_facts.family == "" and flag_payload_facts.family == "" and flag_payload_facts.known_nonfallible and not flag_payload_facts.numeric and not flag_payload_facts.integer and not try_noncall_numeric_value(flag_catch, [], environment)

        def compiler_try_lambda_numeric_shadow_case(at: Ast::Pos) -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                outer_pos: Ast::Pos = Ast::Pos{line: 40, column: 5, offset: 400, end_line: 40, end_column: 10, end_offset: 405}
                lambda_pos: Ast::Pos = Ast::Pos{line: 41, column: 5, offset: 420, end_line: 41, end_column: 50, end_offset: 465}
                operand_pos: Ast::Pos = Ast::Pos{line: 41, column: 43, offset: 458, end_line: 41, end_column: 463, end_offset: 463}
                try_site: Ast::EnumAnnotation = Ast::EnumAnnotation{owner: "__noncall", name: "__try_without_else", line: operand_pos.line, offset: operand_pos.offset, pos: operand_pos}
                lambda_body: darray[Ast::Stmt] @source = [Ast::Stmt.Return(Ast::Expr.Ident("count", operand_pos), operand_pos)]
                lambda_value: Ast::Expr = Ast::Expr.Lambda(["count"], lambda_body, lambda_pos)
                outer_count: Ast::Stmt = Ast::Stmt.VarDecl("count", Ast::Expr.Ident("i64", outer_pos), Ast::Expr.IntLit(1, outer_pos), outer_pos)
                try_annotations: mutable darray[Ast::EnumAnnotation] = [try_site]
                table: mutable SymbolTable = SymbolTable(false)
                file: Ast::File = zeroed
                binding: (found: bool, shadowed: bool, local_error_family: sview @source, lambda_error_family: sview @source, inside_lambda: bool, known_nonfallible: bool) = try_noncall_binding_at_site(file, [outer_count, Ast::Stmt.Expr(lambda_value, lambda_pos)], "count", [], [], try_annotations, try_site, try_site.offset, "", "", table)
                return binding.found and binding.shadowed and binding.inside_lambda and binding.local_error_family == "" and not binding.known_nonfallible

        def compiler_try_variant_alias_shadow_case(at: Ast::Pos) -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                environment: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{}
                try_noncall_family_bind(&environment, "copied", "E")
                condition: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("node", at), TokenKind.Is, Ast::Expr.Field(Ast::Expr.Ident("Expr", at), "Pair", at), at)
                variant_alias: Ast::EnumAnnotation = Ast::EnumAnnotation{owner: "copied", name: "__is_variant_alias", line: at.line, offset: at.offset, identity_id: 1}
                alias_annotations: darray[Ast::EnumAnnotation] = [variant_alias]
                alias_value: Ast::Expr = Ast::Expr.If(condition, Ast::Expr.Ident("copied", at), Ast::Expr.IntLit(0, at), at)
                facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(alias_value, [], environment, alias_annotations)
                return facts.family == ""

include "./try_fallback_noncall_cases.elisa"

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_try_fallback_source_probe() can Global{Read,Write}
