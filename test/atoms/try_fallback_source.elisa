extend Semantic:
    public:
        def compiler_try_fallback_source_probe() -> i64 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    nodes: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in nodes:
                        at: Ast::Pos = zeroed
                        call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("read_value", at), [], [], at)
                        pointer_target: Ast::Expr = Ast::Expr.Unary(TokenKind.Ampersand, Ast::Expr.Ident("u8", at), at)
                        cast_head: Ast::Expr = Ast::Expr.Field(Ast::Expr.IntLit(0, at), "cast", at)
                        pointer_cast: Ast::Expr = Ast::Expr.Index(cast_head, pointer_target, at)
                        array_target: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("darray", at), Ast::Expr.Ident("i32", at), at)
                        array_cast: Ast::Expr = Ast::Expr.Index(cast_head, array_target, at)
                        names: mutable darray[sview @source] = []
                        names.push(try_fallback_callee_name(call))
                        names.push(try_fallback_cast_target_base(pointer_target))
                        names.push(try_fallback_cast_target_spelling(pointer_cast))
                        names.push(try_fallback_cast_target_spelling(array_cast))
                        names.push(try_fallback_cast_target_element(array_cast))
                        return 1 if names[0] != "read_value"
                        return 2 if names[1] != "u8" or names[2] != "u8"
                        return 3 if names[3] != "darray" or names[4] != "i32"
                        return 4 if not try_fallback_cast_target_has_ref(pointer_cast)
                        return 5 if try_fallback_cast_target_has_ref(array_cast)
                        return 6 if try_fallback_callee_name(Ast::Expr.IntLit(0, at)) != ""
                        return 7 if not compiler_try_noncall_facts_probe(at)
                        return 8 if not compiler_try_variant_alias_shadow_case(at)
                        return 9 if not compiler_try_qualified_call_alias_case(at)
                        return 10 if not compiler_try_catch_numeric_alias_case(at)
                        return 11 if not compiler_try_lambda_numeric_shadow_case(at)
                        return 0

        def compiler_try_qualified_call_alias_case(at: Ast::Pos) -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                backend_pos: Ast::Pos = Ast::Pos{line: 10, column: 1, offset: 100, end_line: 10, end_column: 5, end_offset: 104}
                other_pos: Ast::Pos = Ast::Pos{line: 20, column: 1, offset: 200, end_line: 20, end_column: 5, end_offset: 204}
                outer_a_pos: Ast::Pos = Ast::Pos{line: 30, column: 1, offset: 300, end_line: 30, end_column: 5, end_offset: 304}
                outer_b_pos: Ast::Pos = Ast::Pos{line: 40, column: 1, offset: 400, end_line: 40, end_column: 5, end_offset: 404}
                backend_pure: Ast::Decl = Ast::Decl.Func("pure", [], Ast::Expr.Ident("i64", backend_pos), [], [], [], backend_pos)
                other_pure: Ast::Decl = Ast::Decl.Func("pure", [], Ast::Expr.Ident("i64", other_pos), [], [], [], other_pos)
                outer_a_pure: Ast::Decl = Ast::Decl.Func("pure", [], Ast::Expr.Ident("i64", outer_a_pos), [], [], [], outer_a_pos)
                outer_b_pure: Ast::Decl = Ast::Decl.Func("pure", [], Ast::Expr.Ident("i64", outer_b_pos), [], [], [], outer_b_pos)
                outer_a_common: Ast::Decl = Ast::Decl.Module("OuterA::Common", [outer_a_pure], outer_a_pos)
                outer_b_common: Ast::Decl = Ast::Decl.Module("OuterB::Common", [outer_b_pure], outer_b_pos)
                outer_a: Ast::Decl = Ast::Decl.Module("OuterA", [outer_a_common], outer_a_pos)
                outer_b: Ast::Decl = Ast::Decl.Module("OuterB", [outer_b_common], outer_b_pos)
                declarations: darray[Ast::Decl] = [Ast::Decl.Module("Backend", [backend_pure], backend_pos), Ast::Decl.Module("Other", [other_pure], other_pos), outer_a, outer_b]
                annotations: darray[Ast::EnumAnnotation] = [
                    Ast::EnumAnnotation{owner: "pure", name: "__error_return", line: other_pos.line, offset: other_pos.offset, identity_id: 2},
                    Ast::EnumAnnotation{owner: "pure", name: "E", line: other_pos.line, offset: other_pos.offset, identity_id: 2},
                    Ast::EnumAnnotation{owner: "pure", name: "__error_return", line: outer_b_pos.line, offset: outer_b_pos.offset, identity_id: 3},
                    Ast::EnumAnnotation{owner: "pure", name: "E", line: outer_b_pos.line, offset: outer_b_pos.offset, identity_id: 3}
                ]
                environment: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{}
                try_noncall_callable_facts_add(declarations, annotations, environment, "")
                backend_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Scope(Ast::Expr.Ident("Backend", at), "pure", at), [], [], at)
                backend_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(backend_call, [], environment, annotations)
                other_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Scope(Ast::Expr.Ident("Other", at), "pure", at), [], [], at)
                other_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(other_call, [], environment, annotations)
                outer_a_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Scope(Ast::Expr.Scope(Ast::Expr.Ident("OuterA", at), "Common", at), "pure", at), [], [], at)
                outer_a_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(outer_a_call, [], environment, annotations)
                outer_b_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Scope(Ast::Expr.Scope(Ast::Expr.Ident("OuterB", at), "Common", at), "pure", at), [], [], at)
                outer_b_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(outer_b_call, [], environment, annotations)
                bare_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("pure", at), [], [], at)
                bare_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(bare_call, [], environment, annotations)
                return backend_facts.family == "" and backend_facts.known_nonfallible and other_facts.family == "E" and not other_facts.known_nonfallible and outer_a_facts.family == "" and outer_a_facts.known_nonfallible and outer_b_facts.family == "E" and not outer_b_facts.known_nonfallible and bare_facts.family == "" and not bare_facts.known_nonfallible

        def compiler_try_catch_numeric_alias_case(at: Ast::Pos) -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                load_pos: Ast::Pos = Ast::Pos{line: 30, column: 1, offset: 300, end_line: 30, end_column: 5, end_offset: 304}
                flag_pos: Ast::Pos = Ast::Pos{line: 31, column: 1, offset: 310, end_line: 31, end_column: 10, end_offset: 319}
                load_function: Ast::Decl = Ast::Decl.Func("load", [], Ast::Expr.Ident("i64", load_pos), [], [], [], load_pos)
                flag_function: Ast::Decl = Ast::Decl.Func("load_flag", [], Ast::Expr.Ident("bool", flag_pos), [], [], [], flag_pos)
                declarations: darray[Ast::Decl] = [load_function, flag_function]
                annotations: darray[Ast::EnumAnnotation] = [
