extend Semantic:
    public:
        def exclusivity_atom_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    node_store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in node_store:
                        at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                        scalar: Ast::Expr = Ast::Expr.Ident("i64", at)
                        reference: Ast::Expr = Ast::Expr.Unary(TokenKind.Ampersand, scalar, at)
                        writable: Ast::Expr = Ast::Expr.Unary(TokenKind.Mutable, reference, at)
                        parameters: darray[Ast::ParamDecl] @source = [
                            Ast::ParamDecl{name: "left", type_expression: writable, is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid},
                            Ast::ParamDecl{name: "right", type_expression: writable, is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}
                        ]
                        address: Ast::Expr = Ast::Expr.Unary(TokenKind.Ampersand, Ast::Expr.Ident("value", at), at)
                        call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("consume", at), [address, address], [], at)
                        body: darray[Ast::Stmt] @source = [Ast::Stmt.Expr(call, at)]
                        declarations: darray[Ast::Decl] @source = [
                            Ast::Decl.Func("consume", parameters, null, [], [], [], at),
                            Ast::Decl.Func("caller", [], null, body, [], [], at)
                        ]
                        empty_file: Ast::File = zeroed
                        file: Ast::File = empty_file{top_decls = declarations}
                        table: mutable SymbolTable = SymbolTable(false)
                        region scratch(1048576):
                            table <- check_call_argument_exclusivity(&file, table)
                        return 1 if table.diagnostics.count != 1
                        diagnostic: Diagnostic = table.diagnostics[0]
                        return 2 if diagnostic.kind != DiagnosticKind.CallArgumentAlias
                        return 3 if diagnostic.name != "value" or diagnostic.actual != "consume"
                        return 4 if diagnostic.expected != "right" or diagnostic.detail != "left"
                        return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::exclusivity_atom_probe() can Global{Read,Write}
