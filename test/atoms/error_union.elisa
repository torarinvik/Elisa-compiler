extend Semantic:
    public:
        def error_union_atom_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    node_store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in node_store:
                        at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                        handled_at: Ast::Pos = Ast::Pos{line: 2, column: 1, offset: 2, end_line: 2, end_column: 2, end_offset: 3}
                        bare: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("fallible", at), [], [], at)
                        handled: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("fallible", handled_at), [], [], handled_at)
                        harmless: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("ordinary", at), [], [], at)
                        body: darray[Ast::Stmt] @source = [Ast::Stmt.Expr(bare, at), Ast::Stmt.Expr(handled, handled_at), Ast::Stmt.Expr(harmless, at)]
                        declarations: darray[Ast::Decl] @source = [Ast::Decl.Func("caller", [], null, body, [], [], at)]
                        markers: darray[Ast::EnumAnnotation] @source = [
                            Ast::EnumAnnotation{owner: "fallible", name: "__error_return", line: 1},
                            Ast::EnumAnnotation{owner: "", name: "__try_without_else", line: 2}
                        ]
                        empty_file: Ast::File = zeroed
                        file: Ast::File = empty_file{top_decls = declarations, enum_annotations = markers}
                        table: mutable SymbolTable = SymbolTable(false)
                        region scratch(1048576):
                            table <- check_error_union_unhandled(&file, table)
                        return 1 if table.diagnostics.count != 1
                        diagnostic: Diagnostic = table.diagnostics[0]
                        return 2 if diagnostic.kind != DiagnosticKind.ErrorUnionUnhandled
                        return 3 if diagnostic.name != "fallible" or diagnostic.actual != "bare"
                        return 4 if diagnostic.line != 1
                        return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::error_union_atom_probe() can Global{Read,Write}
