extend Semantic:
    public:
        def region_selector_store_atom_probe() -> i64 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    at: Ast::Pos = zeroed
                    annotations: darray[Ast::LocalRegionAnnotation] @source = []
                    view_fns: darray[sview @source] @source = []
                    container_fns: darray[sview @source] @source = []
                    nesting: darray[sview @source] @source = ["outer", "inner"]
                    outer_view: Ast::Expr = Ast::Expr.RegionNew(Ast::Expr.IntLit(1, at), "outer", at)
                    inner_names: darray[sview @source] @source = ["values"]
                    inner_regions: darray[sview @source] @source = ["inner"]
                    selector_target: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("values", at), Ast::Expr.IntLit(0, at), at)
                    selector_write: Ast::Stmt = Ast::Stmt.Assign(selector_target, TokenKind.Assign, outer_view, at)
                    selector_body: darray[Ast::Stmt] @source = [selector_write, Ast::Stmt.Expr(Ast::Expr.Ident("values", at), at)]
                    selector_result: (found: bool, position: usize) = region_escape_body_value_region(selector_body, null, annotations, view_fns, container_fns, nesting, inner_names, inner_regions, 10)
                    return 1 if not selector_result.found or selector_result.position != 1

                    replacement_names: darray[sview @source] @source = ["values"]
                    replacement_regions: darray[sview @source] @source = ["inner"]
                    whole_write: Ast::Stmt = Ast::Stmt.Assign(Ast::Expr.Ident("values", at), TokenKind.Assign, outer_view, at)
                    whole_body: darray[Ast::Stmt] @source = [whole_write, Ast::Stmt.Expr(Ast::Expr.Ident("values", at), at)]
                    whole_result: (found: bool, position: usize) = region_escape_body_value_region(whole_body, null, annotations, view_fns, container_fns, nesting, replacement_names, replacement_regions, 10)
                    return 2 if not whole_result.found or whole_result.position != 0

                    paren_names: darray[sview @source] @source = ["values"]
                    paren_regions: darray[sview @source] @source = ["inner"]
                    paren_write: Ast::Stmt = Ast::Stmt.Assign(Ast::Expr.Paren(Ast::Expr.Ident("values", at), at), TokenKind.Assign, outer_view, at)
                    paren_body: darray[Ast::Stmt] @source = [paren_write, Ast::Stmt.Expr(Ast::Expr.Ident("values", at), at)]
                    paren_result: (found: bool, position: usize) = region_escape_body_value_region(paren_body, null, annotations, view_fns, container_fns, nesting, paren_names, paren_regions, 10)
                    return 3 if not paren_result.found or paren_result.position != 0
                    return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Semantic::region_selector_store_atom_probe() can Global{Read,Write}
