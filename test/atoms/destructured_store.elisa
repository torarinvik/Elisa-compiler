extend Semantic:
    private:
        def compiler_destructured_store_count(target: Ast::Expr, value: Ast::Expr) -> usize can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                table: mutable SymbolTable = SymbolTable(false)
                names: darray[sview @source] = []
                globals: darray[sview @source] = ["first", "second"]
                refs: darray[sview @source] = ["borrowed"]
                annotations: darray[Ast::LocalRegionAnnotation] = []
                types: darray[Ast::Expr] = []
                table <- region_escape_check_assign(target, value, 1, names, annotations, globals, refs, names, names, names, names, names, names, names, names, names, names, types, table)
                return table.diagnostics.count
    public:
        def compiler_destructured_store_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    node_store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in node_store:
                        at: Ast::Pos = zeroed
                        targets: darray[Ast::Expr] @source = [Ast::Expr.Ident("first", at), Ast::Expr.Ident("second", at)]
                        borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                        values: darray[Ast::Expr] @source = [borrowed, borrowed]
                        tuple_target: Ast::Expr = Ast::Expr.Tuple(targets, at)
                        tuple_value: Ast::Expr = Ast::Expr.Tuple(values, at)
                        return 1 if compiler_destructured_store_count(tuple_target, tuple_value) != 2
                        return 2 if compiler_destructured_store_count(Ast::Expr.Paren(tuple_target, at), tuple_value) != 2
                        return 3 if compiler_destructured_store_count(tuple_target, Ast::Expr.Paren(tuple_value, at)) != 2
                        return 4 if compiler_destructured_store_count(Ast::Expr.Array(targets, at), Ast::Expr.Array(values, at)) != 2
                        return 5 if compiler_destructured_store_count(tuple_target, borrowed) != 2
                        safe_values: darray[Ast::Expr] @source = [Ast::Expr.IntLit(1, at), Ast::Expr.IntLit(2, at)]
                        return 6 if compiler_destructured_store_count(tuple_target, Ast::Expr.Tuple(safe_values, at)) != 0
                return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_destructured_store_probe() can Global{Read,Write}
