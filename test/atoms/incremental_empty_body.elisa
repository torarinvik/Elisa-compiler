extend Semantic:
    private:
        def incremental_probe_tokens(source: u8&) -> darray[Lexer::Token] can[Abort.Panic, Memory.Allocate]:
            lexer: mutable Lexer::Lexer = Lexer::Lexer("incremental_probe.elisa", source)
            tokens: mutable darray[Lexer::Token] = []
            while true:
                rebind token: Lexer::Token, lexer = Lexer::next_token(lexer)
                tokens.push(token)
                break if token.kind == Lexer::TokenKind.Eof
            return tokens

    public:
        def compiler_incremental_empty_body_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            literal_source: static u8& = "def helper() -> i64:\n    return 17\n"
            literal_tokens: darray[Lexer::Token] = incremental_probe_tokens(literal_source)
            literal_span: IncrementalFactTokenSpan = ifc_token_span(literal_tokens, 0)
            return 1 if not literal_span.found
            return 2 if literal_tokens[literal_span.body_start].kind != Lexer::TokenKind.Return
            literal_candidate: IncrementalFactCandidate = IncrementalFactCandidate{
                name: "helper",
                parameters: [],
                return_type: null,
                body: [],
                definition_offset: 0,
                definition_token: literal_span.definition_token,
                generic_header: false,
                span_ordered: true,
                body_token_start: literal_span.body_start,
                body_token_end: literal_span.body_end,
                skip_start: literal_span.skip_start,
                skip_end: literal_span.skip_end,
                owner: 0,
                header_supported: true,
                prior_record: 0,
                prior_record_cacheable: false,
                prior_body_matches: false,
                prior_zero_fact_body: false
            }
            return 3 if not ifc_candidate_is_complete_empty_body(literal_candidate, literal_tokens)

            padded_tokens: mutable darray[Lexer::Token] = []
            for index in 0..<literal_span.body_start |padded_tokens|:
                padded_tokens.push(literal_tokens[index])
            padded_tokens.push(Lexer::Token(Lexer::TokenKind.Newline, Lexer::LexerPosition(1, 1, 0), 0, 0))
            padded_body_start: usize = padded_tokens.count
            for index in literal_span.body_start..<literal_span.body_end |padded_tokens|:
                padded_tokens.push(literal_tokens[index])
            for index in literal_span.body_end..<literal_tokens.count |padded_tokens|:
                padded_tokens.push(literal_tokens[index])
            padded_candidate: IncrementalFactCandidate = literal_candidate{
                body_token_start = padded_body_start,
                body_token_end = padded_body_start + literal_span.body_end - literal_span.body_start
            }
            return 4 if not ifc_candidate_is_complete_empty_body(padded_candidate, padded_tokens)

            call_source: static u8& = "def helper() -> i64:\n    return source_leaf()\n"
            call_tokens: darray[Lexer::Token] = incremental_probe_tokens(call_source)
            call_span: IncrementalFactTokenSpan = ifc_token_span(call_tokens, 0)
            call_candidate: IncrementalFactCandidate = literal_candidate{
                body_token_start = call_span.body_start,
                body_token_end = call_span.body_end
            }
            return 5 if ifc_candidate_is_complete_empty_body(call_candidate, call_tokens)

            split_source: static u8& = "def helper() -> i64:\n    return\n    17\n"
            split_tokens: darray[Lexer::Token] = incremental_probe_tokens(split_source)
            split_span: IncrementalFactTokenSpan = ifc_token_span(split_tokens, 0)
            split_candidate: IncrementalFactCandidate = literal_candidate{
                body_token_start = split_span.body_start,
                body_token_end = split_span.body_end
            }
            return 6 if not split_span.found or split_tokens[split_span.body_start + 1].kind != Lexer::TokenKind.Newline
            return 7 if ifc_candidate_is_complete_empty_body(split_candidate, split_tokens)
            return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_incremental_empty_body_probe()
