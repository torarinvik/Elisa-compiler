def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    direct_names: darray[sview] = ["alias"]
    direct_targets: darray[sview] = ["xs"]
    return 1 if SemanticIteratorAliasResolution::resolve(direct_names, direct_targets, "alias") != "xs"
    chain_names: darray[sview] = ["alias2", "alias1"]
    chain_targets: darray[sview] = ["alias1", "xs"]
    return 2 if SemanticIteratorAliasResolution::resolve(chain_names, chain_targets, "alias2") != "xs"
    return 3 if SemanticIteratorAliasResolution::resolve(chain_names, chain_targets, "unrelated") != "unrelated"
    self_names: darray[sview] = ["alias"]
    self_targets: darray[sview] = ["alias"]
    return 4 if SemanticIteratorAliasResolution::resolve(self_names, self_targets, "alias") != ""
    cycle_names: darray[sview] = ["alias", "other"]
    cycle_targets: darray[sview] = ["other", "alias"]
    cycle: sview = SemanticIteratorAliasResolution::resolve(cycle_names, cycle_targets, "alias")
    return 5 if cycle != ""
    return 6 if not SemanticIteratorAliasResolution::may_name(cycle, "xs")
    duplicate_names: darray[sview] = ["alias", "alias"]
    duplicate_targets: darray[sview] = ["ys", "xs"]
    return 7 if SemanticIteratorAliasResolution::resolve(duplicate_names, duplicate_targets, "alias") != ""
    empty: darray[sview] = []
    return 8 if SemanticIteratorAliasResolution::resolve(empty, empty, "xs") != "xs"
    return 0
