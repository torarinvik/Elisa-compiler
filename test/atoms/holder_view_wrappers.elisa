extend Semantic:
    public:
        def compiler_holder_walk_value(expression: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "borrowed", false, true, false)
                summary: StoreThroughSummary = zeroed
                table: mutable SymbolTable = SymbolTable(false)
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                table <- chv_walk_expression(expression, false, names, names, names, names, values, flow, summary, table)
                return flow.last_value_may_be_owned_view

        def compiler_holder_classifies_view(expression: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "borrowed", false, true, false)
                return chv_is_owned_view(expression, flow, 0)

        def compiler_holder_walk_has_no_escape(expression: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "borrowed", false, true, false)
                summary: StoreThroughSummary = zeroed
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder"]
                binders: darray[sview] = []
                owned: darray[sview] = []
                view_names: darray[sview] = []
                view_values: darray[Ast::Expr] = []
                table <- chv_walk_expression(expression, false, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                return table.diagnostics.count == 0

        def compiler_holder_pattern_binder_probe() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "source", false, false, true)
                chv_flow_bind(flow, "borrowed", false, true, false)
                summary: StoreThroughSummary = zeroed
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["source"]
                binders: darray[sview] = []
                owned: darray[sview] = []
                view_names: darray[sview] = []
                view_values: darray[Ast::Expr] = []
                source: Ast::Expr = Ast::Expr.Ident("source", at)
                alias: Ast::Expr = Ast::Expr.Ident("alias", at)
                borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                condition: Ast::Expr = Ast::Expr.Binary(source, TokenKind.Is, alias, at)
                call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [alias, borrowed], ["", ""], at)
                statements: darray[Ast::Stmt] = [Ast::Stmt.Expr(condition, at), Ast::Stmt.Expr(call, at)]
                table <- chv_walk_statements(statements, false, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                return false if table.diagnostics.count != 1

                branch_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(branch_flow, "source", false, false, true)
                chv_flow_bind(branch_flow, "borrowed", false, true, false)
                branch_table: mutable SymbolTable = SymbolTable(false)
                branch_statements: darray[Ast::Stmt] = [Ast::Stmt.If(condition, [Ast::Stmt.Expr(call, at)], [], at)]
                branch_table <- chv_walk_statements(branch_statements, false, ref_params, binders, owned, view_names, view_values, branch_flow, summary, branch_table)
                return false if branch_table.diagnostics.count != 1

                value_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(value_flow, "source", false, false, true)
                chv_flow_bind(value_flow, "borrowed", false, true, false)
                value_table: mutable SymbolTable = SymbolTable(false)
                value_if: Ast::Expr = Ast::Expr.If(condition, call, Ast::Expr.BoolLit(false, at), at)
                value_statements: darray[Ast::Stmt] = [Ast::Stmt.Expr(value_if, at)]
                value_table <- chv_walk_statements(value_statements, false, ref_params, binders, owned, view_names, view_values, value_flow, summary, value_table)
                return false if value_table.diagnostics.count != 1

                conditional_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(conditional_flow, "source", false, false, true)
                chv_flow_bind(conditional_flow, "borrowed", false, true, false)
                conditional_table: mutable SymbolTable = SymbolTable(false)
                conditional_items: Ast::Expr = Ast::Expr.If(condition, Ast::Expr.Array([alias], at), Ast::Expr.Array([], at), at)
                conditional_item: Ast::Expr = Ast::Expr.Ident("conditional_item", at)
                conditional_comprehension: Ast::Expr = Ast::Expr.Comprehension("conditional_item", conditional_items, Ast::Expr.Absent, conditional_item, at, 0)
                conditional_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [conditional_comprehension, borrowed], ["", ""], at)
                conditional_statements: darray[Ast::Stmt] = [Ast::Stmt.Expr(conditional_call, at)]
                conditional_table <- chv_walk_statements(conditional_statements, false, ref_params, binders, owned, view_names, view_values, &conditional_flow, summary, conditional_table)
                return false if conditional_table.diagnostics.count != 1

                and_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(and_flow, "source", false, false, true)
                chv_flow_bind(and_flow, "borrowed", false, true, false)
                and_table: mutable SymbolTable = SymbolTable(false)
                and_expression: Ast::Expr = Ast::Expr.Binary(condition, TokenKind.And, call, at)
                and_statements: darray[Ast::Stmt] = [Ast::Stmt.Expr(and_expression, at)]
                and_table <- chv_walk_statements(and_statements, false, ref_params, binders, owned, view_names, view_values, and_flow, summary, and_table)
                return false if and_table.diagnostics.count != 1

                or_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(or_flow, "source", false, false, true)
                chv_flow_bind(or_flow, "alias", false, true, false)
                or_table: mutable SymbolTable = SymbolTable(false)
                or_expression: Ast::Expr = Ast::Expr.Binary(condition, TokenKind.Or, Ast::Expr.BoolLit(false, at), at)
                or_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [alias, source], ["", ""], at)
                or_statements: darray[Ast::Stmt] = [Ast::Stmt.Expr(or_expression, at), Ast::Stmt.Expr(or_call, at)]
                or_table <- chv_walk_statements(or_statements, false, ref_params, binders, owned, view_names, view_values, or_flow, summary, or_table)
                return false if or_table.diagnostics.count != 1

                nested_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(nested_flow, "source", false, false, true)
                chv_flow_bind(nested_flow, "borrowed", false, true, false)
                nested_table: mutable SymbolTable = SymbolTable(false)
                child: Ast::Expr = Ast::Expr.Ident("child", at)
                inner: Ast::Expr = Ast::Expr.Ident("inner", at)
                first_pattern: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("Pattern", at), "Some", at), [child], [], at)
                second_pattern: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("Pattern", at), "Some", at), [inner], [], at)
                first_test: Ast::Expr = Ast::Expr.Binary(source, TokenKind.Is, first_pattern, at)
                second_test: Ast::Expr = Ast::Expr.Binary(child, TokenKind.Is, second_pattern, at)
                nested_use: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [inner, borrowed], ["", ""], at)
                nested_right: Ast::Expr = Ast::Expr.Binary(second_test, TokenKind.And, nested_use, at)
                nested_expression: Ast::Expr = Ast::Expr.Binary(first_test, TokenKind.And, nested_right, at)
                nested_statements: darray[Ast::Stmt] = [Ast::Stmt.Expr(nested_expression, at)]
                nested_table <- chv_walk_statements(nested_statements, false, ref_params, binders, owned, view_names, view_values, nested_flow, summary, nested_table)
                return nested_table.diagnostics.count == 1

        def compiler_holder_match_pattern_probe() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                source: Ast::Expr = Ast::Expr.Ident("source", at)
                holder: Ast::Expr = Ast::Expr.Ident("holder", at)
                alias: Ast::Expr = Ast::Expr.Ident("alias", at)
                call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [holder, alias], ["", ""], at)
                binders: darray[sview] = []
                owned: darray[sview] = []
                view_names: darray[sview] = []
                view_values: darray[Ast::Expr] = []
                summary: StoreThroughSummary = zeroed

                statement_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(statement_flow, "source", false, true, false)
                chv_flow_bind(statement_flow, "holder", false, false, true)
                statement_table: mutable SymbolTable = SymbolTable(false)
                binding_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("alias"), body: [Ast::Stmt.Expr(call, at)], guard: Ast::Expr.Absent, pos: at}
                statement_match: Ast::Stmt = Ast::Stmt.Match(source, [binding_arm], at)
                statement_table <- chv_walk_statements([statement_match], false, binders, binders, owned, view_names, view_values, &statement_flow, summary, statement_table)
                return false if statement_table.diagnostics.count != 1

                expression_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(expression_flow, "source", false, true, false)
                chv_flow_bind(expression_flow, "holder", false, false, true)
                expression_table: mutable SymbolTable = SymbolTable(false)
                as_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.As("alias", [Ast::Pattern.Wildcard]), body: [Ast::Stmt.Expr(call, at)], guard: Ast::Expr.Absent, pos: at}
                matched_expression: Ast::Expr = Ast::Expr.Match(source, [as_arm], at)
                expression_table <- chv_walk_expression(matched_expression, false, binders, binders, owned, view_names, view_values, &expression_flow, summary, expression_table)
                return false if expression_table.diagnostics.count != 1

                catch_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(catch_flow, "holder", false, false, true)
                chv_flow_bind(catch_flow, "borrowed", false, true, false)
                chv_flow_bind(catch_flow, "safe_borrowed", false, false, false)
                catch_table: mutable SymbolTable = SymbolTable(false)
                safe_borrowed: Ast::Expr = Ast::Expr.Ident("safe_borrowed", at)
                guarded_view: Ast::Expr = Ast::Expr.Block([], safe_borrowed, [], at)
                success_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("alias"), body: [Ast::Stmt.Expr(call, at)], guard: Ast::Expr.Absent, pos: at}
                error_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.TypeBind("Holder", "alias"), body: [Ast::Stmt.Expr(call, at)], guard: Ast::Expr.Absent, pos: at}
                catch_expression: Ast::Expr = Ast::Expr.Catch(guarded_view, [success_arm, error_arm], at)
                catch_table <- chv_walk_expression(catch_expression, false, binders, binders, owned, view_names, view_values, &catch_flow, summary, catch_table)
                return false if catch_table.diagnostics.count != 1

                success_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(success_flow, "holder", false, false, true)
                chv_flow_bind(success_flow, "borrowed", false, true, false)
                success_table: mutable SymbolTable = SymbolTable(false)
                borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                borrowed_guarded_view: Ast::Expr = Ast::Expr.Block([], borrowed, [], at)
                success_only: Ast::Expr = Ast::Expr.Catch(borrowed_guarded_view, [success_arm], at)
                success_table <- chv_walk_expression(success_only, false, binders, binders, owned, view_names, view_values, &success_flow, summary, success_table)
                return success_table.diagnostics.count == 1

        def compiler_holder_expression_binder_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                owned_source: Ast::Expr = Ast::Expr.Ident("owned_source", at)
                safe_source: Ast::Expr = Ast::Expr.Ident("safe_source", at)
                holder: Ast::Expr = Ast::Expr.Ident("holder", at)
                alias: Ast::Expr = Ast::Expr.Ident("alias", at)
                call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [holder, alias], ["", ""], at)
                ref_params: darray[sview] = ["holder"]
                binders: darray[sview] = []
                owned: darray[sview] = []
                view_names: darray[sview] = []
                view_values: darray[Ast::Expr] = []
                summary: StoreThroughSummary = zeroed

                shadow_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(shadow_flow, "owned_source", false, true, false)
                chv_flow_bind(shadow_flow, "safe_source", false, false, false)
                chv_flow_bind(shadow_flow, "holder", false, false, true)
                left_test: Ast::Expr = Ast::Expr.Binary(owned_source, TokenKind.Is, alias, at)
                right_test: Ast::Expr = Ast::Expr.Binary(safe_source, TokenKind.Is, alias, at)
                duplicate_and: Ast::Expr = Ast::Expr.Binary(left_test, TokenKind.And, right_test, at)
                shadow_table: mutable SymbolTable = SymbolTable(false)
                shadow_statements: darray[Ast::Stmt] = [Ast::Stmt.Expr(duplicate_and, at), Ast::Stmt.Expr(call, at)]
                shadow_table <- chv_walk_statements(shadow_statements, false, ref_params, binders, owned, view_names, view_values, &shadow_flow, summary, shadow_table)
                return 1 if shadow_table.diagnostics.count != 0

                or_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(or_flow, "safe_source", false, false, false)
                chv_flow_bind(or_flow, "holder", false, false, true)
                chv_flow_bind(or_flow, "alias", false, true, false)
                or_table: mutable SymbolTable = SymbolTable(false)
                one_sided_or: Ast::Expr = Ast::Expr.Binary(right_test, TokenKind.Or, Ast::Expr.BoolLit(true, at), at)
                or_statements: darray[Ast::Stmt] = [Ast::Stmt.Expr(one_sided_or, at), Ast::Stmt.Expr(call, at)]
                or_table <- chv_walk_statements(or_statements, false, ref_params, binders, owned, view_names, view_values, &or_flow, summary, or_table)
                return 2 if or_table.diagnostics.count != 1

                tuple_shadow_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(tuple_shadow_flow, "owned_source", false, true, false)
                chv_flow_bind(tuple_shadow_flow, "safe_source", false, false, false)
                chv_flow_bind(tuple_shadow_flow, "holder", false, false, true)
                tuple_shadow_table: mutable SymbolTable = SymbolTable(false)
                binder_tuple: Ast::Expr = Ast::Expr.Tuple([left_test, right_test], at)
                tuple_shadow_statements: darray[Ast::Stmt] = [Ast::Stmt.Expr(binder_tuple, at), Ast::Stmt.Expr(call, at)]
                tuple_shadow_table <- chv_walk_statements(tuple_shadow_statements, false, ref_params, binders, owned, view_names, view_values, &tuple_shadow_flow, summary, tuple_shadow_table)
                return 3 if tuple_shadow_table.diagnostics.count != 0

                base_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(base_flow, "safe_source", false, false, false)
                chv_flow_bind(base_flow, "holder", false, false, true)
                base_table: mutable SymbolTable = SymbolTable(false)
                base_test: Ast::Expr = Ast::Expr.Binary(safe_source, TokenKind.Is, alias, at)
                update: Ast::Expr = Ast::Expr.RecordUpdate(base_test, [], at)
                base_statements: darray[Ast::Stmt] = [Ast::Stmt.Expr(update, at), Ast::Stmt.Expr(call, at)]
                base_table <- chv_walk_statements(base_statements, false, ref_params, binders, owned, view_names, view_values, &base_flow, summary, base_table)
                return 4 if base_table.diagnostics.count != 0

                tuple_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(tuple_flow, "borrowed", false, true, false)
                chv_flow_bind(tuple_flow, "holder", false, false, true)
                tuple_table: mutable SymbolTable = SymbolTable(false)
                borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                tuple_source: Ast::Expr = Ast::Expr.Tuple([Ast::Expr.Block([], borrowed, [], at)], at)
                tuple_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("alias"), body: [Ast::Stmt.Expr(call, at)], guard: Ast::Expr.Absent, pos: at}
                tuple_match: Ast::Stmt = Ast::Stmt.Match(tuple_source, [tuple_arm], at)
                tuple_table <- chv_walk_statements([tuple_match], false, ref_params, binders, owned, view_names, view_values, &tuple_flow, summary, tuple_table)
                return 5 if tuple_table.diagnostics.count != 1
                return 0

        def compiler_holder_parallel_rebind_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                holder: Ast::Expr = Ast::Expr.Ident("holder", at)
                buffer: Ast::Expr = Ast::Expr.Ident("buffer", at)
                view: Ast::Expr = Ast::Expr.Ident("view", at)
                scratch: Ast::Expr = Ast::Expr.Ident("scratch", at)
                view_value: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(buffer, "as_sview", at), [], [], at)
                scalar_value: Ast::Expr = Ast::Expr.IntLit(0, at)
                targets: Ast::Expr = Ast::Expr.Array([Ast::Expr.Ident("__rb_1_0", at), Ast::Expr.Ident("__rb_1_1", at)], at)
                tuple: Ast::Expr = Ast::Expr.Paren(Ast::Expr.Tuple([view_value, scalar_value], at), at)
                store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [holder, view], ["", ""], at)
                parallel: Ast::Stmt = Ast::Stmt.Assign(targets, TokenKind.Assign, tuple, at)
                land_view: Ast::Stmt = Ast::Stmt.Assign(view, TokenKind.LArrow, Ast::Expr.Ident("__rb_1_0", at), at)
                land_scratch: Ast::Stmt = Ast::Stmt.Assign(scratch, TokenKind.LArrow, Ast::Expr.Ident("__rb_1_1", at), at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "buffer", true, false, false)
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder"]
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                summary: StoreThroughSummary = zeroed
                table <- chv_walk_statements([parallel, land_view, land_scratch, Ast::Stmt.Expr(store, at)], false, ref_params, names, names, names, values, &flow, summary, table)
                return 1 if table.diagnostics.count != 1
                view_index: usize = chv_flow_latest(flow, "view")
                scratch_index: usize = chv_flow_latest(flow, "scratch")
                return 2 if view_index >= flow.names.count or not flow.may_owned_view[view_index]
                return 3 if scratch_index >= flow.names.count or flow.may_owned_view[scratch_index]
                return 0

        def compiler_holder_for_iterable_taint_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                holder: Ast::Expr = Ast::Expr.Ident("holder", at)
                borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                item: Ast::Expr = Ast::Expr.Ident("item", at)
                alias: Ast::Expr = Ast::Expr.Ident("alias", at)
                safe_view: Ast::Expr = Ast::Expr.Ident("safe_view", at)
                store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [holder, alias], ["", ""], at)
                view_iterable: Ast::Expr = Ast::Expr.Array([borrowed], at)
                loop: Ast::Stmt = Ast::Stmt.For("", ["item", "alias"], view_iterable, [Ast::Stmt.Expr(store, at)], at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "borrowed", false, true, false)
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder"]
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                summary: StoreThroughSummary = zeroed
                table <- chv_walk_statements([loop], false, ref_params, names, names, names, values, &flow, summary, table)
                return 1 if table.diagnostics.count != 1
                return 2 if chv_flow_latest(flow, "item") < flow.names.count
                return 3 if chv_flow_latest(flow, "alias") < flow.names.count

                bytes: Ast::Expr = Ast::Expr.Ident("bytes", at)
                byte: Ast::Expr = Ast::Expr.Ident("byte", at)
                scalar_store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [holder, byte], ["", ""], at)
                scalar_loop: Ast::Stmt = Ast::Stmt.For("", ["byte"], bytes, [Ast::Stmt.Expr(scalar_store, at)], at)
                scalar_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(scalar_flow, "holder", false, false, true)
                chv_flow_bind(scalar_flow, "bytes", true, false, false)
                scalar_table: mutable SymbolTable = SymbolTable(false)
                scalar_summary: StoreThroughSummary = zeroed
                scalar_table <- chv_walk_statements([scalar_loop], false, ref_params, names, names, names, values, &scalar_flow, scalar_summary, scalar_table)
                return 4 if scalar_table.diagnostics.count != 0

                alias_source: Ast::Expr = Ast::Expr.Ident("alias_source", at)
                alias_store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [alias, safe_view], ["", ""], at)
                safe_ref: Ast::Expr = Ast::Expr.Ident("safe_ref", at)
                safe_ref_iterable: Ast::Expr = Ast::Expr.Array([safe_ref], at)
                safe_ref_loop: Ast::Stmt = Ast::Stmt.For("", ["alias"], safe_ref_iterable, [Ast::Stmt.Expr(alias_store, at)], at)
                safe_ref_flow: mutable CHVViewFlow = CHVViewFlow{}
                safe_alias_summary: StoreThroughSummary = zeroed
                chv_flow_bind(safe_ref_flow, "safe_ref", false, false, false)
                chv_flow_bind(safe_ref_flow, "safe_view", false, true, false)
                safe_ref_table: mutable SymbolTable = SymbolTable(false)
                safe_ref_table <- chv_walk_statements([safe_ref_loop], false, ref_params, names, names, names, values, &safe_ref_flow, safe_alias_summary, safe_ref_table)
                return 5 if safe_ref_table.diagnostics.count != 0

                alias_ref_iterable: Ast::Expr = Ast::Expr.Array([alias_source], at)
                alias_ref_loop: Ast::Stmt = Ast::Stmt.For("", ["alias"], alias_ref_iterable, [Ast::Stmt.Expr(alias_store, at)], at)
                alias_ref_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(alias_ref_flow, "alias_source", false, false, true)
                chv_flow_bind(alias_ref_flow, "safe_view", false, true, false)
                alias_ref_table: mutable SymbolTable = SymbolTable(false)
                alias_ref_table <- chv_walk_statements([alias_ref_loop], false, ref_params, names, names, names, values, &alias_ref_flow, safe_alias_summary, alias_ref_table)
                return 6 if alias_ref_table.diagnostics.count != 1

                ref_collection: Ast::Expr = Ast::Expr.Ident("ref_collection", at)
                ref_collection_loop: Ast::Stmt = Ast::Stmt.For("", ["alias"], ref_collection, [Ast::Stmt.Expr(alias_store, at)], at)
                ref_collection_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(ref_collection_flow, "safe_view", false, true, false)
                ref_collection_table: mutable SymbolTable = SymbolTable(false)
                ref_collection_params: darray[sview] = ["holder", "ref_collection"]
                ref_collection_table <- chv_walk_statements([ref_collection_loop], false, ref_collection_params, names, names, names, values, &ref_collection_flow, safe_alias_summary, ref_collection_table)
                return 7 if ref_collection_table.diagnostics.count != 1

                alias_iterable: Ast::Expr = alias_source
                alias_loop: Ast::Stmt = Ast::Stmt.For("", ["item", "alias"], alias_iterable, [Ast::Stmt.Expr(alias_store, at)], at)
                alias_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(alias_flow, "alias_source", false, false, true)
                chv_flow_bind(alias_flow, "safe_view", false, true, false)
                alias_table: mutable SymbolTable = SymbolTable(false)
                alias_summary: StoreThroughSummary = zeroed
                alias_table <- chv_walk_statements([alias_loop], false, ref_params, names, names, names, values, &alias_flow, alias_summary, alias_table)
                return 8 if alias_table.diagnostics.count != 0
                return 9 if chv_flow_latest(alias_flow, "alias") < alias_flow.names.count

                mutable_alias_loop: Ast::Stmt = Ast::Stmt.For("mutable", ["item", "alias"], alias_iterable, [Ast::Stmt.Expr(alias_store, at)], at)
                mutable_alias_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(mutable_alias_flow, "alias_source", false, false, true)
                chv_flow_bind(mutable_alias_flow, "safe_view", false, true, false)
                mutable_alias_table: mutable SymbolTable = SymbolTable(false)
                mutable_alias_table <- chv_walk_statements([mutable_alias_loop], false, ref_params, names, names, names, values, &mutable_alias_flow, alias_summary, mutable_alias_table)
                return 10 if mutable_alias_table.diagnostics.count != 1
                return 11 if chv_flow_latest(mutable_alias_flow, "alias") < mutable_alias_flow.names.count

                alias_result: Ast::Expr = Ast::Expr.Ident("alias_result", at)
                comprehension_item: Ast::Expr = Ast::Expr.Ident("item", at)
                comprehension_iterable: Ast::Expr = Ast::Expr.Array([alias_source], at)
                reference_comprehension: Ast::Expr = Ast::Expr.Comprehension("item", comprehension_iterable, Ast::Expr.Absent, comprehension_item, at, 0)
                comprehension_store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [alias_result, safe_view], ["", ""], at)
                comprehension_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(comprehension_flow, "alias_source", false, false, true)
                chv_flow_bind(comprehension_flow, "safe_view", false, true, false)
                comprehension_table: mutable SymbolTable = SymbolTable(false)
                comprehension_assign: Ast::Stmt = Ast::Stmt.Assign(alias_result, TokenKind.LArrow, reference_comprehension, at)
                comprehension_table <- chv_walk_statements([comprehension_assign, Ast::Stmt.Expr(comprehension_store, at)], false, ref_params, names, names, names, values, &comprehension_flow, alias_summary, comprehension_table)
                return 12 if comprehension_table.diagnostics.count != 1
                alias_result_index: usize = chv_flow_latest(comprehension_flow, "alias_result")
                return 13 if alias_result_index >= comprehension_flow.names.count or not comprehension_flow.may_alias_reference[alias_result_index]
                return 0

        def compiler_holder_view_wrappers_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    node_store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in node_store:
                        at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                        borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                        scalar: Ast::Expr = Ast::Expr.IntLit(1, at)
                        block: Ast::Expr = Ast::Expr.Block([], borrowed, [], at)
                        unary: Ast::Expr = Ast::Expr.Unary(TokenKind.Ampersand, block, at)
                        return 1 if not compiler_holder_walk_value(unary)
                        binary_left: Ast::Expr = Ast::Expr.Binary(block, TokenKind.Plus, scalar, at)
                        return 2 if not compiler_holder_walk_value(binary_left)
                        binary_right: Ast::Expr = Ast::Expr.Binary(scalar, TokenKind.Plus, block, at)
                        return 3 if not compiler_holder_walk_value(binary_right)
                        boolean_binary: Ast::Expr = Ast::Expr.Binary(block, TokenKind.EqEq, scalar, at)
                        return 18 if compiler_holder_walk_value(boolean_binary)
                        logical_binary: Ast::Expr = Ast::Expr.Binary(block, TokenKind.And, scalar, at)
                        return 19 if compiler_holder_walk_value(logical_binary)
                        logical_not: Ast::Expr = Ast::Expr.Unary(TokenKind.Not, block, at)
                        return 20 if compiler_holder_walk_value(logical_not)
                        variant_target: Ast::Expr = Ast::Expr.Field(Ast::Expr.Ident("Expr", at), "Int", at)
                        variant_test: Ast::Expr = Ast::Expr.Binary(block, TokenKind.As, variant_target, at)
                        return 21 if compiler_holder_walk_value(variant_test)
                        return 36 if not compiler_holder_walk_has_no_escape(variant_test)
                        is_target: Ast::Expr = Ast::Expr.Field(Ast::Expr.Ident("Expr", at), "Int", at)
                        is_test: Ast::Expr = Ast::Expr.Binary(block, TokenKind.Is, is_target, at)
                        return 37 if not compiler_holder_walk_has_no_escape(is_test)
                        pattern_source: Ast::Expr = Ast::Expr.Ident("holder", at)
                        payload_target: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("Expr", at), "Add", at), [block], [], at)
                        payload_test: Ast::Expr = Ast::Expr.Binary(pattern_source, TokenKind.As, payload_target, at)
                        return 22 if compiler_holder_walk_value(payload_test)
                        return 38 if not compiler_holder_walk_has_no_escape(payload_test)
                        is_payload_target: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("Expr", at), "Add", at), [block], [], at)
                        is_payload_test: Ast::Expr = Ast::Expr.Binary(pattern_source, TokenKind.Is, is_payload_target, at)
                        return 40 if compiler_holder_walk_value(is_payload_test)
                        return 41 if not compiler_holder_walk_has_no_escape(is_payload_test)
                        reinterpret_target: Ast::Expr = Ast::Expr.Binary(block, TokenKind.As, Ast::Expr.Ident("&", at), at)
                        return 23 if not compiler_holder_walk_value(reinterpret_target)
                        reinterpret_not_target: Ast::Expr = Ast::Expr.Binary(block, TokenKind.As, Ast::Expr.Ident("!", at), at)
                        return 29 if not compiler_holder_walk_value(reinterpret_not_target)
                        scalar_block: Ast::Expr = Ast::Expr.Block([], scalar, [], at)
                        return 4 if compiler_holder_walk_value(Ast::Expr.Unary(TokenKind.Ampersand, scalar_block, at))
                        return 5 if compiler_holder_walk_value(Ast::Expr.Binary(scalar_block, TokenKind.Plus, scalar, at))
                        return 6 if not compiler_holder_walk_value(Ast::Expr.Field(block, "value", at))
                        return 7 if not compiler_holder_walk_value(Ast::Expr.Index(block, scalar, at))
                        return 8 if not compiler_holder_walk_value(Ast::Expr.IndexN(block, [scalar], at))
                        return 9 if not compiler_holder_walk_value(Ast::Expr.Slice(block, scalar, scalar, at))
                        return 10 if compiler_holder_walk_value(Ast::Expr.Field(scalar_block, "value", at))
                        return 11 if compiler_holder_walk_value(Ast::Expr.Index(scalar_block, scalar, at))
                        return 12 if compiler_holder_walk_value(Ast::Expr.IndexN(scalar_block, [scalar], at))
                        return 13 if compiler_holder_walk_value(Ast::Expr.Slice(scalar_block, scalar, scalar, at))
                        return 14 if not compiler_holder_walk_value(Ast::Expr.Index(scalar_block, block, at))
                        return 15 if compiler_holder_walk_value(Ast::Expr.IndexN(scalar_block, [block], at))
                        cast_receiver: Ast::Expr = Ast::Expr.Field(scalar_block, "cast", at)
                        return 16 if compiler_holder_walk_value(Ast::Expr.Index(cast_receiver, block, at))
                        return 17 if compiler_holder_walk_value(Ast::Expr.IndexN(cast_receiver, [block], at))
                        return 24 if not compiler_holder_walk_value(Ast::Expr.Call(Ast::Expr.Index(block, scalar, at), [], [], at))
                        return 25 if not compiler_holder_walk_value(Ast::Expr.Call(Ast::Expr.Index(scalar_block, block, at), [], [], at))
                        return 26 if not compiler_holder_walk_value(Ast::Expr.Call(Ast::Expr.IndexN(block, [scalar], at), [], [], at))
                        return 27 if compiler_holder_walk_value(Ast::Expr.Call(Ast::Expr.IndexN(scalar_block, [block], at), [], [], at))
                        return 28 if compiler_holder_walk_value(Ast::Expr.Call(Ast::Expr.Index(scalar_block, scalar, at), [], [], at))
                        index_key_receiver: Ast::Expr = Ast::Expr.Index(scalar_block, borrowed, at)
                        index_key_method: Ast::Expr = Ast::Expr.Field(index_key_receiver, "project", at)
                        return 32 if not compiler_holder_classifies_view(index_key_receiver)
                        return 29 if not compiler_holder_walk_value(Ast::Expr.Call(index_key_method, [], [], at))
                        index_n_key_receiver: Ast::Expr = Ast::Expr.IndexN(scalar_block, [borrowed], at)
                        index_n_key_method: Ast::Expr = Ast::Expr.Field(index_n_key_receiver, "project", at)
                        return 33 if compiler_holder_classifies_view(index_n_key_receiver)
                        return 30 if compiler_holder_walk_value(Ast::Expr.Call(index_n_key_method, [], [], at))
                        cast_key_receiver: Ast::Expr = Ast::Expr.Index(cast_receiver, block, at)
                        cast_key_method: Ast::Expr = Ast::Expr.Field(cast_key_receiver, "project", at)
                        return 34 if compiler_holder_classifies_view(cast_key_receiver)
                        return 31 if compiler_holder_walk_value(Ast::Expr.Call(cast_key_method, [], [], at))
                        generic_callee: Ast::Expr = Ast::Expr.IndexN(Ast::Expr.Ident("generic", at), [block], at)
                        return 35 if compiler_holder_walk_value(Ast::Expr.Call(generic_callee, [], [], at))
                        return 39 if not compiler_holder_pattern_binder_probe()
                        return 42 if not compiler_holder_match_pattern_probe()
                        expression_binder_status: i32 = compiler_holder_expression_binder_probe()
                        return 43 + expression_binder_status if expression_binder_status != 0
                        parallel_rebind_status: i32 = compiler_holder_parallel_rebind_probe()
                        return 44 + parallel_rebind_status if parallel_rebind_status != 0
                        for_iterable_status: i32 = compiler_holder_for_iterable_taint_probe()
                        return 52 + for_iterable_status if for_iterable_status != 0
                        return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_holder_view_wrappers_probe() can Global{Read,Write}
