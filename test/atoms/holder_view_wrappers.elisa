extend Semantic:
    public:
        def compiler_holder_walk_value(expression: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "borrowed", false, true, false)
                summary: StoreThroughSummary = zeroed
                table: mutable SymbolTable = SymbolTable(false)
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                table <- chv_walk_expression(expression, false, names, names, names, names, values, flow, summary, table)
                return flow.last_value_may_be_owned_view

        def compiler_holder_classifies_view(expression: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "borrowed", false, true, false)
                return chv_is_owned_view(expression, flow, 0)

        def compiler_holder_walk_has_no_escape(expression: Ast::Expr) -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "borrowed", false, true, false)
                summary: StoreThroughSummary = zeroed
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder"]
                binders: darray[sview] = []
                owned: darray[sview] = []
                view_names: darray[sview] = []
                view_values: darray[Ast::Expr] = []
                table <- chv_walk_expression(expression, false, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                return table.diagnostics.count == 0

        def compiler_holder_pattern_binder_probe() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "source", false, false, true)
                chv_flow_bind(flow, "borrowed", false, true, false)
                summary: StoreThroughSummary = zeroed
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["source"]
                binders: darray[sview] = []
                owned: darray[sview] = []
                view_names: darray[sview] = []
                view_values: darray[Ast::Expr] = []
                source: Ast::Expr = Ast::Expr.Ident("source", at)
                alias: Ast::Expr = Ast::Expr.Ident("alias", at)
                borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                condition: Ast::Expr = Ast::Expr.Binary(source, TokenKind.Is, alias, at)
                call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [alias, borrowed], ["", ""], at)
                statements: darray[Ast::Stmt] = [Ast::Stmt.Expr(condition, at), Ast::Stmt.Expr(call, at)]
                table <- chv_walk_statements(statements, false, ref_params, binders, owned, view_names, view_values, flow, summary, table)
                return false if table.diagnostics.count != 1

                branch_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(branch_flow, "source", false, false, true)
                chv_flow_bind(branch_flow, "borrowed", false, true, false)
                branch_table: mutable SymbolTable = SymbolTable(false)
                branch_statements: darray[Ast::Stmt] = [Ast::Stmt.If(condition, [Ast::Stmt.Expr(call, at)], [], at)]
                branch_table <- chv_walk_statements(branch_statements, false, ref_params, binders, owned, view_names, view_values, branch_flow, summary, branch_table)
                return false if branch_table.diagnostics.count != 1

                value_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(value_flow, "source", false, false, true)
                chv_flow_bind(value_flow, "borrowed", false, true, false)
                value_table: mutable SymbolTable = SymbolTable(false)
                value_if: Ast::Expr = Ast::Expr.If(condition, call, Ast::Expr.BoolLit(false, at), at)
                value_statements: darray[Ast::Stmt] = [Ast::Stmt.Expr(value_if, at)]
                value_table <- chv_walk_statements(value_statements, false, ref_params, binders, owned, view_names, view_values, value_flow, summary, value_table)
                return false if value_table.diagnostics.count != 1

                and_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(and_flow, "source", false, false, true)
                chv_flow_bind(and_flow, "borrowed", false, true, false)
                and_table: mutable SymbolTable = SymbolTable(false)
                and_expression: Ast::Expr = Ast::Expr.Binary(condition, TokenKind.And, call, at)
                and_statements: darray[Ast::Stmt] = [Ast::Stmt.Expr(and_expression, at)]
                and_table <- chv_walk_statements(and_statements, false, ref_params, binders, owned, view_names, view_values, and_flow, summary, and_table)
                return false if and_table.diagnostics.count != 1

                or_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(or_flow, "source", false, false, true)
                chv_flow_bind(or_flow, "alias", false, true, false)
                or_table: mutable SymbolTable = SymbolTable(false)
                or_expression: Ast::Expr = Ast::Expr.Binary(condition, TokenKind.Or, Ast::Expr.BoolLit(false, at), at)
                or_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [alias, source], ["", ""], at)
                or_statements: darray[Ast::Stmt] = [Ast::Stmt.Expr(or_expression, at), Ast::Stmt.Expr(or_call, at)]
                or_table <- chv_walk_statements(or_statements, false, ref_params, binders, owned, view_names, view_values, or_flow, summary, or_table)
                return false if or_table.diagnostics.count != 1

                nested_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(nested_flow, "source", false, false, true)
                chv_flow_bind(nested_flow, "borrowed", false, true, false)
                nested_table: mutable SymbolTable = SymbolTable(false)
                child: Ast::Expr = Ast::Expr.Ident("child", at)
                inner: Ast::Expr = Ast::Expr.Ident("inner", at)
                first_pattern: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("Pattern", at), "Some", at), [child], [], at)
                second_pattern: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("Pattern", at), "Some", at), [inner], [], at)
                first_test: Ast::Expr = Ast::Expr.Binary(source, TokenKind.Is, first_pattern, at)
                second_test: Ast::Expr = Ast::Expr.Binary(child, TokenKind.Is, second_pattern, at)
                nested_use: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [inner, borrowed], ["", ""], at)
                nested_right: Ast::Expr = Ast::Expr.Binary(second_test, TokenKind.And, nested_use, at)
                nested_expression: Ast::Expr = Ast::Expr.Binary(first_test, TokenKind.And, nested_right, at)
                nested_statements: darray[Ast::Stmt] = [Ast::Stmt.Expr(nested_expression, at)]
                nested_table <- chv_walk_statements(nested_statements, false, ref_params, binders, owned, view_names, view_values, nested_flow, summary, nested_table)
                return nested_table.diagnostics.count == 1

        def compiler_holder_match_pattern_probe() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                source: Ast::Expr = Ast::Expr.Ident("source", at)
                holder: Ast::Expr = Ast::Expr.Ident("holder", at)
                alias: Ast::Expr = Ast::Expr.Ident("alias", at)
                call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [holder, alias], ["", ""], at)
                binders: darray[sview] = []
                owned: darray[sview] = []
                view_names: darray[sview] = []
                view_values: darray[Ast::Expr] = []
                summary: StoreThroughSummary = zeroed

                statement_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(statement_flow, "source", false, true, false)
                chv_flow_bind(statement_flow, "holder", false, false, true)
                statement_table: mutable SymbolTable = SymbolTable(false)
                binding_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("alias"), body: [Ast::Stmt.Expr(call, at)], guard: Ast::Expr.Absent, pos: at}
                statement_match: Ast::Stmt = Ast::Stmt.Match(source, [binding_arm], at)
                statement_table <- chv_walk_statements([statement_match], false, binders, binders, owned, view_names, view_values, &statement_flow, summary, statement_table)
                return false if statement_table.diagnostics.count != 1

                expression_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(expression_flow, "source", false, true, false)
                chv_flow_bind(expression_flow, "holder", false, false, true)
                expression_table: mutable SymbolTable = SymbolTable(false)
                as_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.As("alias", [Ast::Pattern.Wildcard]), body: [Ast::Stmt.Expr(call, at)], guard: Ast::Expr.Absent, pos: at}
                matched_expression: Ast::Expr = Ast::Expr.Match(source, [as_arm], at)
                expression_table <- chv_walk_expression(matched_expression, false, binders, binders, owned, view_names, view_values, &expression_flow, summary, expression_table)
                return false if expression_table.diagnostics.count != 1

                catch_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(catch_flow, "source", false, true, false)
                chv_flow_bind(catch_flow, "holder", false, false, true)
                catch_table: mutable SymbolTable = SymbolTable(false)
                typed_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.TypeBind("Holder", "alias"), body: [Ast::Stmt.Expr(call, at)], guard: Ast::Expr.Absent, pos: at}
                catch_expression: Ast::Expr = Ast::Expr.Catch(source, [typed_arm], at)
                catch_table <- chv_walk_expression(catch_expression, false, binders, binders, owned, view_names, view_values, &catch_flow, summary, catch_table)
                return catch_table.diagnostics.count == 1

        def compiler_holder_view_wrappers_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    node_store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in node_store:
                        at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                        borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                        scalar: Ast::Expr = Ast::Expr.IntLit(1, at)
                        block: Ast::Expr = Ast::Expr.Block([], borrowed, [], at)
                        unary: Ast::Expr = Ast::Expr.Unary(TokenKind.Ampersand, block, at)
                        return 1 if not compiler_holder_walk_value(unary)
                        binary_left: Ast::Expr = Ast::Expr.Binary(block, TokenKind.Plus, scalar, at)
                        return 2 if not compiler_holder_walk_value(binary_left)
                        binary_right: Ast::Expr = Ast::Expr.Binary(scalar, TokenKind.Plus, block, at)
                        return 3 if not compiler_holder_walk_value(binary_right)
                        boolean_binary: Ast::Expr = Ast::Expr.Binary(block, TokenKind.EqEq, scalar, at)
                        return 18 if compiler_holder_walk_value(boolean_binary)
                        logical_binary: Ast::Expr = Ast::Expr.Binary(block, TokenKind.And, scalar, at)
                        return 19 if compiler_holder_walk_value(logical_binary)
                        logical_not: Ast::Expr = Ast::Expr.Unary(TokenKind.Not, block, at)
                        return 20 if compiler_holder_walk_value(logical_not)
                        variant_target: Ast::Expr = Ast::Expr.Field(Ast::Expr.Ident("Expr", at), "Int", at)
                        variant_test: Ast::Expr = Ast::Expr.Binary(block, TokenKind.As, variant_target, at)
                        return 21 if compiler_holder_walk_value(variant_test)
                        return 36 if not compiler_holder_walk_has_no_escape(variant_test)
                        is_target: Ast::Expr = Ast::Expr.Field(Ast::Expr.Ident("Expr", at), "Int", at)
                        is_test: Ast::Expr = Ast::Expr.Binary(block, TokenKind.Is, is_target, at)
                        return 37 if not compiler_holder_walk_has_no_escape(is_test)
                        pattern_source: Ast::Expr = Ast::Expr.Ident("holder", at)
                        payload_target: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("Expr", at), "Add", at), [block], [], at)
                        payload_test: Ast::Expr = Ast::Expr.Binary(pattern_source, TokenKind.As, payload_target, at)
                        return 22 if compiler_holder_walk_value(payload_test)
                        return 38 if not compiler_holder_walk_has_no_escape(payload_test)
                        is_payload_target: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("Expr", at), "Add", at), [block], [], at)
                        is_payload_test: Ast::Expr = Ast::Expr.Binary(pattern_source, TokenKind.Is, is_payload_target, at)
                        return 40 if compiler_holder_walk_value(is_payload_test)
                        return 41 if not compiler_holder_walk_has_no_escape(is_payload_test)
                        reinterpret_target: Ast::Expr = Ast::Expr.Binary(block, TokenKind.As, Ast::Expr.Ident("&", at), at)
                        return 23 if not compiler_holder_walk_value(reinterpret_target)
                        reinterpret_not_target: Ast::Expr = Ast::Expr.Binary(block, TokenKind.As, Ast::Expr.Ident("!", at), at)
                        return 29 if not compiler_holder_walk_value(reinterpret_not_target)
                        scalar_block: Ast::Expr = Ast::Expr.Block([], scalar, [], at)
                        return 4 if compiler_holder_walk_value(Ast::Expr.Unary(TokenKind.Ampersand, scalar_block, at))
                        return 5 if compiler_holder_walk_value(Ast::Expr.Binary(scalar_block, TokenKind.Plus, scalar, at))
                        return 6 if not compiler_holder_walk_value(Ast::Expr.Field(block, "value", at))
                        return 7 if not compiler_holder_walk_value(Ast::Expr.Index(block, scalar, at))
                        return 8 if not compiler_holder_walk_value(Ast::Expr.IndexN(block, [scalar], at))
                        return 9 if not compiler_holder_walk_value(Ast::Expr.Slice(block, scalar, scalar, at))
                        return 10 if compiler_holder_walk_value(Ast::Expr.Field(scalar_block, "value", at))
                        return 11 if compiler_holder_walk_value(Ast::Expr.Index(scalar_block, scalar, at))
                        return 12 if compiler_holder_walk_value(Ast::Expr.IndexN(scalar_block, [scalar], at))
                        return 13 if compiler_holder_walk_value(Ast::Expr.Slice(scalar_block, scalar, scalar, at))
                        return 14 if not compiler_holder_walk_value(Ast::Expr.Index(scalar_block, block, at))
                        return 15 if compiler_holder_walk_value(Ast::Expr.IndexN(scalar_block, [block], at))
                        cast_receiver: Ast::Expr = Ast::Expr.Field(scalar_block, "cast", at)
                        return 16 if compiler_holder_walk_value(Ast::Expr.Index(cast_receiver, block, at))
                        return 17 if compiler_holder_walk_value(Ast::Expr.IndexN(cast_receiver, [block], at))
                        return 24 if not compiler_holder_walk_value(Ast::Expr.Call(Ast::Expr.Index(block, scalar, at), [], [], at))
                        return 25 if not compiler_holder_walk_value(Ast::Expr.Call(Ast::Expr.Index(scalar_block, block, at), [], [], at))
                        return 26 if not compiler_holder_walk_value(Ast::Expr.Call(Ast::Expr.IndexN(block, [scalar], at), [], [], at))
                        return 27 if compiler_holder_walk_value(Ast::Expr.Call(Ast::Expr.IndexN(scalar_block, [block], at), [], [], at))
                        return 28 if compiler_holder_walk_value(Ast::Expr.Call(Ast::Expr.Index(scalar_block, scalar, at), [], [], at))
                        index_key_receiver: Ast::Expr = Ast::Expr.Index(scalar_block, borrowed, at)
                        index_key_method: Ast::Expr = Ast::Expr.Field(index_key_receiver, "project", at)
                        return 32 if not compiler_holder_classifies_view(index_key_receiver)
                        return 29 if not compiler_holder_walk_value(Ast::Expr.Call(index_key_method, [], [], at))
                        index_n_key_receiver: Ast::Expr = Ast::Expr.IndexN(scalar_block, [borrowed], at)
                        index_n_key_method: Ast::Expr = Ast::Expr.Field(index_n_key_receiver, "project", at)
                        return 33 if compiler_holder_classifies_view(index_n_key_receiver)
                        return 30 if compiler_holder_walk_value(Ast::Expr.Call(index_n_key_method, [], [], at))
                        cast_key_receiver: Ast::Expr = Ast::Expr.Index(cast_receiver, block, at)
                        cast_key_method: Ast::Expr = Ast::Expr.Field(cast_key_receiver, "project", at)
                        return 34 if compiler_holder_classifies_view(cast_key_receiver)
                        return 31 if compiler_holder_walk_value(Ast::Expr.Call(cast_key_method, [], [], at))
                        generic_callee: Ast::Expr = Ast::Expr.IndexN(Ast::Expr.Ident("generic", at), [block], at)
                        return 35 if compiler_holder_walk_value(Ast::Expr.Call(generic_callee, [], [], at))
                        return 39 if not compiler_holder_pattern_binder_probe()
                        return 42 if not compiler_holder_match_pattern_probe()
                        return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_holder_view_wrappers_probe() can Global{Read,Write}
