extend Semantic:
    public:
        def compiler_holder_comprehension_alias_case(source_may_alias_reference: bool, expected_diagnostics: usize) -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                alias_source: Ast::Expr = Ast::Expr.Ident("alias_source", at)
                iterable: Ast::Expr = Ast::Expr.Array([alias_source], at)
                item: Ast::Expr = Ast::Expr.Ident("item", at)
                comprehension: Ast::Expr = Ast::Expr.Comprehension("item", iterable, Ast::Expr.Absent, item, at, 0)
                saved: Ast::Expr = Ast::Expr.Ident("saved", at)
                borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [saved, borrowed], ["", ""], at)
                declaration: Ast::Stmt = Ast::Stmt.VarDecl("saved", Ast::Expr.Absent, comprehension, at)
                use: Ast::Stmt = Ast::Stmt.Expr(store, at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "alias_source", false, false, source_may_alias_reference)
                chv_flow_bind(flow, "borrowed", false, true, false)
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder"]
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                summary: StoreThroughSummary = zeroed
                table <- chv_walk_statements([declaration, use], false, ref_params, names, names, names, values, &flow, summary, table)
                return table.diagnostics.count == expected_diagnostics

        def compiler_holder_comprehension_alias_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                return 1 if not compiler_holder_comprehension_alias_case(true, 1)
                return 2 if not compiler_holder_comprehension_alias_case(false, 0)
                return 3 if not compiler_holder_ref_container_comprehension_alias_case()
                return 4 if not compiler_holder_scalar_view_iteration_case()
                return 5 if not compiler_holder_comprehension_filter_alias_case()
                return 6 if not compiler_holder_getelse_return_flow_case()
                return 7 if not compiler_holder_scalar_view_rebind_case()
                return 8 if not compiler_holder_slice_sview_case()
                return 9 if not compiler_holder_branch_comprehension_assignment_case(false)
                return 10 if not compiler_holder_branch_comprehension_assignment_case(true)
                return 11 if not compiler_holder_branch_comprehension_mutation_case()
                return 12 if not compiler_holder_aggregate_container_call_target_case()
                return 13 if not compiler_holder_branch_comprehension_destructure_mutation_case()
                return 14 if not compiler_holder_rebound_local_iterable_alias_case()
                return 15 if not compiler_holder_mixed_rebind_claim_case()
                return 16 if not compiler_holder_future_local_shape_shadow_case()
                return 17 if not compiler_holder_named_reference_holder_case()
                return 18 if not compiler_holder_named_alias_reference_holder_case()
                return 19 if not compiler_holder_lambda_local_shape_shadow_case()
                return 20 if not compiler_holder_lambda_parameter_unknown_provenance_case()
                return 21 if not compiler_holder_mutating_iterable_shape_case()
                return 22 if not compiler_holder_direct_and_contained_iterator_alias_case()
                return 23 if not compiler_holder_ambiguous_qualified_alias_case()
                return 24 if not compiler_holder_direct_alias_parameter_case()
                return 25 if not compiler_holder_alias_yield_parameter_body_case()
                return 26 if not compiler_holder_unknown_iterator_contained_alias_case()
                return 27 if not compiler_holder_known_scalar_case()
                return 28 if not compiler_holder_enum_constructor_case()
                return 29 if not compiler_holder_direct_method_case()
                return 30 if not compiler_holder_scalar_function_case()
                return 31 if not compiler_holder_scalar_field_case()
                return 32 if not compiler_holder_array_count_case()
                return 0

        def compiler_holder_array_count_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                table: mutable SymbolTable = SymbolTable(false)
                table <- seed_builtins(table)
                mask: u64 = chv_unshadowed_scalar_types(table)
                return false if (mask & CHV_DARRAY_TYPE_BIT) == 0
                array_type: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("darray", at), Ast::Expr.Ident("sview", at), at)
                flow: mutable CHVViewFlow = CHVViewFlow{scalar_type_mask: mask}
                chv_flow_bind(flow, "views", true, true, true)
                row: usize = chv_flow_latest(flow, "views")
                flow.binding_types[row] <- array_type
                flow.binding_type_known[row] <- true
                count: Ast::Expr = Ast::Expr.Field(Ast::Expr.Ident("views", at), "count", at)
                return false if not chv_is_known_scalar(count, flow, 0) or chv_is_owned_view(count, flow, 0)
                names: darray[sview] = ["views"]
                flags: mutable darray[u32] = [4 | 1024]
                masks: darray[u32] = [1]
                facts: VpFacts = VpFacts{filln: [], filli: [], stn: [], sti: [], stj: [], retn: [], retf: []}
                return false if vp_kind(count, names, flags, facts) != 0 or vp_pm(count, names, flags, masks, facts) != 0
                flags[0] <- flags[0] | 512
                return false if vp_kind(count, names, flags, facts) != 2
                aliases: darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "darray", name: "__using_alias", line: 1}]
                return false if (chv_scalar_mask_without_import_aliases(mask, aliases) & CHV_DARRAY_TYPE_BIT) != 0
                table.symbols.push(Symbol{id: DeclId{value: 999}, name: "darray", kind: SymbolKind.Struct, line: 1, arity_min: 0, arity_max: 0, return_type: ""})
                return (chv_unshadowed_scalar_types(table) & CHV_DARRAY_TYPE_BIT) == 0

        def compiler_holder_scalar_field_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                table: mutable SymbolTable = SymbolTable(false)
                table.symbols.push(Symbol{id: DeclId{value: 0}, name: "Packet", kind: SymbolKind.Struct, line: 1, arity_min: 0, arity_max: 0, return_type: ""})
                table <- index_symbol(table, "Packet", 0)
                table.struct_field_owner.push("Packet")
                table.struct_field_name.push("value")
                table.struct_field_type.push("i64")
                table.struct_field_module.push("")
                table.struct_field_owner.push("Packet")
                table.struct_field_name.push("view")
                table.struct_field_type.push("sview")
                table.struct_field_module.push("")
                annotations: darray[Ast::EnumAnnotation] = []
                mask: u64 = chv_scalar_type_bit("i64")
                fields: CHVScalarFields = chv_scalar_fields(mask, table, annotations)
                return false if fields.names.count != 1
                flow: mutable CHVViewFlow = CHVViewFlow{scalar_calls: CHVScalarCalls{fields: fields}}
                chv_flow_bind(flow, "packet", false, true, true)
                row: usize = chv_flow_latest(flow, "packet")
                flow.binding_types[row] <- Ast::Expr.Ident("Packet", at)
                flow.binding_type_known[row] <- true
                scalar: Ast::Expr = Ast::Expr.Field(Ast::Expr.Ident("packet", at), "value", at)
                view: Ast::Expr = Ast::Expr.Field(Ast::Expr.Ident("packet", at), "view", at)
                return false if not chv_is_known_scalar(scalar, flow, 0)
                return false if chv_is_known_scalar(view, flow, 0)
                return false if not chv_is_owned_view(view, flow, 0)
                return false if chv_is_owned_view(scalar, flow, 0)
                aliases: darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "Packet", name: "__using_alias", line: 1}]
                return false if chv_scalar_fields(mask, table, aliases).names.count != 0
                table.symbols.push(Symbol{id: DeclId{value: 1}, name: "Packet", kind: SymbolKind.Struct, line: 2, arity_min: 0, arity_max: 0, return_type: ""})
                table <- index_symbol(table, "Packet", 1)
                return chv_scalar_fields(mask, table, annotations).names.count == 0

        def compiler_holder_scalar_function_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                table: mutable SymbolTable = SymbolTable(false)
                table.symbols.push(Symbol{id: DeclId{value: 0}, name: "count_value", kind: SymbolKind.Func, line: 1, arity_min: 1, arity_max: 1, return_type: "i64"})
                table <- index_symbol(table, "count_value", 0)
                mask: u64 = chv_scalar_type_bit("i64")
                return false if not chv_function_returns_scalar("count_value", mask, table)
                annotations: darray[Ast::EnumAnnotation] = []
                names: darray[sview] = chv_scalar_functions(mask, table, annotations)
                aliases: darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "count_value", name: "__using_alias", line: 1}]
                return false if chv_scalar_functions(mask, table, aliases).count != 0
                numeric_alias: darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "i64", name: "__using_alias", line: 1}]
                return false if chv_scalar_mask_without_import_aliases(mask, numeric_alias) != 0
                unknown_import: darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "__pma_unknown_static_import", name: "", line: 1, detail_name: "opaque"}]
                return false if chv_scalar_functions(mask, table, unknown_import).count != 0
                return false if chv_scalar_mask_without_import_aliases(mask, unknown_import) != 0
                flow: mutable CHVViewFlow = CHVViewFlow{scalar_type_mask: mask, scalar_calls: CHVScalarCalls{names: names, lookup: chv_scalar_call_lookup(names)}}
                call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("count_value", at), [Ast::Expr.Ident("unknown_view", at)], [""], at)
                return false if not chv_is_known_scalar(call, flow, 0)
                forced_lookup: mutable dict[u64, usize] = {}
                forced_lookup <- forced_lookup.put(name_hash("count_value"), 0.usize())
                collision_flow: mutable CHVViewFlow = CHVViewFlow{scalar_calls: CHVScalarCalls{names: ["other", "count_value"], lookup: forced_lookup}}
                return false if chv_is_known_scalar(call, collision_flow, 0)
                forced_lookup <- forced_lookup.put(name_hash("count_value"), 2.usize())
                collision_flow.scalar_calls <- CHVScalarCalls{names: ["other", "count_value"], lookup: forced_lookup}
                return false if not chv_is_known_scalar(call, collision_flow, 0)
                flow.scalar_calls <- CHVScalarCalls{names: names, shadow_names: ["count_value"]}
                return false if chv_is_known_scalar(call, flow, 0)
                flow.scalar_calls <- CHVScalarCalls{names: names}
                chv_flow_bind(flow, "count_value", false, true, true)
                return false if chv_is_known_scalar(call, flow, 0)
                table.symbols.push(Symbol{id: DeclId{value: 1}, name: "count_value", kind: SymbolKind.Func, line: 2, arity_min: 1, arity_max: 1, return_type: "sview"})
                table <- index_symbol(table, "count_value", 1)
                return false if chv_function_returns_scalar("count_value", mask, table)
                return false if chv_function_returns_scalar("count_value", 0, table)
                return true

        def compiler_holder_direct_method_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                table: mutable SymbolTable = SymbolTable(false)
                table.symbols.push(Symbol{id: DeclId{value: 0}, name: "Holder", kind: SymbolKind.Struct, line: 1, arity_min: 0, arity_max: 0, return_type: ""})
                table.symbols.push(Symbol{id: DeclId{value: 1}, name: "inspect", kind: SymbolKind.Func, line: 2, arity_min: 2, arity_max: 2, return_type: ""})
                table <- index_function_param(table, "inspect", 0)
                table.function_param_owner.push("inspect")
                formal_type: u32 = annotation_type_id(Ast::Expr.Unary(TokenKind.Ampersand, Ast::Expr.Ident("Holder", at), at), table)
                table.function_param_type_id.push(formal_type)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                row: usize = chv_flow_latest(flow, "holder")
                flow.binding_types[row] <- Ast::Expr.Ident("Holder", at)
                flow.binding_type_known[row] <- true
                receiver: Ast::Expr = Ast::Expr.Ident("holder", at)
                names: darray[sview] = []
                return false if not chv_has_direct_method_summary(receiver, "inspect", names, flow, table)
                table.symbols.push(Symbol{id: DeclId{value: 2}, name: "Holder", kind: SymbolKind.Module, line: 3, arity_min: 0, arity_max: 0, return_type: ""})
                return false if not chv_has_direct_method_summary(receiver, "inspect", names, flow, table)
                shadowed: darray[sview] = ["inspect"]
                return false if chv_has_direct_method_summary(receiver, "inspect", shadowed, flow, table)
                return false if chv_has_direct_method_summary(Ast::Expr.Ident("unknown", at), "inspect", names, flow, table)
                table.struct_field_name.push("inspect")
                return not chv_has_direct_method_summary(receiver, "inspect", names, flow, table)

        def compiler_holder_enum_constructor_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                table: mutable SymbolTable = SymbolTable(false)
                table.symbols.push(Symbol{id: DeclId{value: 0}, name: "Pair", kind: SymbolKind.Enum, line: 1, arity_min: 0, arity_max: 0, return_type: ""})
                table.enum_variant_owner.push("Pair")
                table.enum_variant_name.push("Data")
                table.enum_variant_module.push("")
                flow: mutable CHVViewFlow = CHVViewFlow{}
                callee: Ast::Expr = Ast::Expr.Field(Ast::Expr.Ident("Pair", at), "Data", at)
                names: darray[sview] = []
                return false if not chv_is_enum_constructor(callee, names, flow, table)
                shadowed: darray[sview] = ["Pair"]
                return false if chv_is_enum_constructor(callee, shadowed, flow, table)
                unknown: Ast::Expr = Ast::Expr.Field(Ast::Expr.Ident("Pair", at), "Other", at)
                return false if chv_is_enum_constructor(unknown, names, flow, table)
                chv_flow_bind(flow, "Pair", false, true, false)
                return false if chv_is_enum_constructor(callee, names, flow, table)
                clean_flow: mutable CHVViewFlow = CHVViewFlow{}
                table.symbols.push(Symbol{id: DeclId{value: 1}, name: "Pair", kind: SymbolKind.Struct, line: 2, arity_min: 0, arity_max: 0, return_type: ""})
                return not chv_is_enum_constructor(callee, names, clean_flow, table)

        def compiler_holder_known_scalar_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                table: mutable SymbolTable = SymbolTable(false)
                table <- seed_builtins(table)
                flow: mutable CHVViewFlow = CHVViewFlow{scalar_type_mask: chv_unshadowed_scalar_types(table)}
                chv_flow_bind(flow, "index", true, true, true)
                row: usize = chv_flow_latest(flow, "index")
                flow.binding_types[row] <- Ast::Expr.Ident("i64", at)
                flow.binding_type_known[row] <- true
                value: Ast::Expr = Ast::Expr.Ident("index", at)
                cast: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(value, "usize", at), [], [], at)
                return false if not chv_is_known_scalar(cast, flow, 0)
                return false if chv_is_owned_view(cast, flow, 0)
                view_cast: Ast::Expr = Ast::Expr.Binary(value, TokenKind.As, Ast::Expr.Ident("sview", at), at)
                return false if chv_is_known_scalar(view_cast, flow, 0)
                unknown_cast: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("unknown", at), "usize", at), [], [], at)
                return false if chv_is_known_scalar(unknown_cast, flow, 0)
                flow.binding_types[row] <- Ast::Expr.Unary(TokenKind.Ampersand, Ast::Expr.Ident("i64", at), at)
                return false if chv_is_known_scalar(cast, flow, 0)
                flow.binding_types[row] <- Ast::Expr.Ident("i64", at)
                unknown_flow: CHVViewFlow = CHVViewFlow{}
                return false if chv_is_known_scalar(cast, unknown_flow, 0)
                numeric_constructor: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("i64", at), [Ast::Expr.IntLit(1, at)], [""], at)
                return false if not chv_is_known_scalar(numeric_constructor, flow, 0)
                chv_flow_bind(flow, "i64", false, true, true)
                return false if chv_is_known_scalar(numeric_constructor, flow, 0)
                table.symbols.push(Symbol{id: DeclId{value: 999}, name: "i64", kind: SymbolKind.Unknown, line: 1, arity_min: 0, arity_max: 0, return_type: ""})
                return false if (chv_unshadowed_scalar_types(table) & chv_scalar_type_bit("i64")) != 0
                table.generic_param_names.push("usize")
                return (chv_unshadowed_scalar_types(table) & chv_scalar_type_bit("usize")) == 0

        def compiler_holder_ref_container_comprehension_alias_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                ref_items: Ast::Expr = Ast::Expr.Ident("ref_items", at)
                item: Ast::Expr = Ast::Expr.Ident("item", at)
                comprehension: Ast::Expr = Ast::Expr.Comprehension("item", ref_items, Ast::Expr.Absent, item, at, 0)
                saved: Ast::Expr = Ast::Expr.Ident("saved", at)
                borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [saved, borrowed], ["", ""], at)
                declaration: Ast::Stmt = Ast::Stmt.VarDecl("saved", Ast::Expr.Absent, comprehension, at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "ref_items", false, false, true)
                ref_items_index: usize = chv_flow_latest(flow, "ref_items")
                nested_reference_collection_type: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("darray", at), Ast::Expr.Unary(TokenKind.Ampersand, Ast::Expr.Ident("i64", at), at), at)
                flow.may_contain_alias_reference[ref_items_index] <- chv_type_may_contain_alias_reference(nested_reference_collection_type, 0) if ref_items_index < flow.names.count
                chv_flow_bind(flow, "borrowed", false, true, false)
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder", "ref_items"]
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                summary: StoreThroughSummary = zeroed
                table <- chv_walk_statements([declaration, Ast::Stmt.Expr(store, at)], false, ref_params, names, names, names, values, &flow, summary, table)
                return false if table.diagnostics.count != 1

                local_items: Ast::Expr = Ast::Expr.Ident("local_items", at)
                local_item: Ast::Expr = Ast::Expr.Ident("local_item", at)
                local_comprehension: Ast::Expr = Ast::Expr.Comprehension("local_item", local_items, Ast::Expr.Absent, local_item, at, 0)
                local_items_declaration: Ast::Stmt = Ast::Stmt.VarDecl("local_items", nested_reference_collection_type, ref_items, at)
                local_saved: Ast::Expr = Ast::Expr.Ident("local_saved", at)
                local_declaration: Ast::Stmt = Ast::Stmt.VarDecl("local_saved", Ast::Expr.Absent, local_comprehension, at)
                local_store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [local_saved, borrowed], ["", ""], at)
                local_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(local_flow, "holder", false, false, true)
                chv_flow_bind(local_flow, "ref_items", false, false, true)
                local_ref_items_index: usize = chv_flow_latest(local_flow, "ref_items")
                local_flow.may_contain_alias_reference[local_ref_items_index] <- chv_type_may_contain_alias_reference(nested_reference_collection_type, 0) if local_ref_items_index < local_flow.names.count
                chv_flow_bind(local_flow, "borrowed", false, true, false)
                local_table: mutable SymbolTable = SymbolTable(false)
                local_ref_params: darray[sview] = ["holder"]
                local_table <- chv_walk_statements([local_items_declaration, local_declaration, Ast::Stmt.Expr(local_store, at)], false, local_ref_params, names, names, names, values, &local_flow, summary, local_table)
                return false if local_table.diagnostics.count != 1
                return false if not compiler_holder_decl_parameter_nested_reference_case()
                return compiler_holder_scalar_borrowed_nested_iteration_case()

        def compiler_holder_decl_parameter_nested_reference_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                byte_type: Ast::Expr = Ast::Expr.Ident("u8", at)
                buffer_type: Ast::Expr = Ast::Expr.Unary(TokenKind.Mutable, Ast::Expr.Index(Ast::Expr.Ident("darray", at), byte_type, at), at)
                ref_items_type: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("darray", at), Ast::Expr.Unary(TokenKind.Ampersand, Ast::Expr.Ident("i64", at), at), at)
                holder_type: Ast::Expr = Ast::Expr.Unary(TokenKind.Mutable, Ast::Expr.Unary(TokenKind.Ampersand, Ast::Expr.Ident("Holder", at), at), at)
                holder_parameter: Ast::ParamDecl = Ast::ParamDecl{name: "holder", type_expression: holder_type, is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}
                items_parameter: Ast::ParamDecl = Ast::ParamDecl{name: "items", type_expression: ref_items_type, is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}
                empty_buffer: Ast::Expr = Ast::Expr.Array([], at)
                buffer_declaration: Ast::Stmt = Ast::Stmt.VarDecl("buffer", buffer_type, empty_buffer, at)
                view_receiver: Ast::Expr = Ast::Expr.Ident("buffer", at)
                view_value: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(view_receiver, "as_sview", at), [], [], at)
                view_declaration: Ast::Stmt = Ast::Stmt.VarDecl("view", Ast::Expr.Ident("sview", at), view_value, at)
                item: Ast::Expr = Ast::Expr.Ident("item", at)
                comprehension: Ast::Expr = Ast::Expr.Comprehension("item", Ast::Expr.Ident("items", at), Ast::Expr.Absent, item, at, 0)
                saved_declaration: Ast::Stmt = Ast::Stmt.VarDecl("saved", Ast::Expr.Absent, comprehension, at)
                sink: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [Ast::Expr.Ident("saved", at), Ast::Expr.Ident("view", at)], ["", ""], at)
                caller: Ast::Decl = Ast::Decl.Func("caller", [holder_parameter, items_parameter], null, [buffer_declaration, view_declaration, saved_declaration, Ast::Stmt.Expr(sink, at)], [], [], at)
                table: mutable SymbolTable = SymbolTable(false)
                summary: StoreThroughSummary = zeroed
                no_rebind_claims: darray[Ast::EnumAnnotation] = []
                table <- chv_walk_declarations([caller], summary, no_rebind_claims, table)
                return table.diagnostics.count == 1

        def compiler_holder_scalar_borrowed_nested_iteration_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                ref_items: Ast::Expr = Ast::Expr.Ident("ref_items", at)
                scalar_collection_type: Ast::Expr = Ast::Expr.Unary(TokenKind.Ampersand, Ast::Expr.Index(Ast::Expr.Ident("darray", at), Ast::Expr.Ident("i64", at), at), at)
                item: Ast::Expr = Ast::Expr.Ident("item", at)
                nested: Ast::Expr = Ast::Expr.Ident("nested", at)
                nested_values: Ast::Expr = Ast::Expr.Array([item], at)
                nested_comprehension: Ast::Expr = Ast::Expr.Comprehension("nested", nested_values, Ast::Expr.Absent, nested, at, 0)
