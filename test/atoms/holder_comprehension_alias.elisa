extend Semantic:
    public:
        def compiler_holder_comprehension_alias_case(source_may_alias_reference: bool, expected_diagnostics: usize) -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                alias_source: Ast::Expr = Ast::Expr.Ident("alias_source", at)
                iterable: Ast::Expr = Ast::Expr.Array([alias_source], at)
                item: Ast::Expr = Ast::Expr.Ident("item", at)
                comprehension: Ast::Expr = Ast::Expr.Comprehension("item", iterable, Ast::Expr.Absent, item, at, 0)
                saved: Ast::Expr = Ast::Expr.Ident("saved", at)
                borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [saved, borrowed], ["", ""], at)
                declaration: Ast::Stmt = Ast::Stmt.VarDecl("saved", Ast::Expr.Absent, comprehension, at)
                use: Ast::Stmt = Ast::Stmt.Expr(store, at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "alias_source", false, false, source_may_alias_reference)
                chv_flow_bind(flow, "borrowed", false, true, false)
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder"]
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                summary: StoreThroughSummary = zeroed
                table <- chv_walk_statements([declaration, use], false, ref_params, names, names, names, values, &flow, summary, table)
                return table.diagnostics.count == expected_diagnostics

        def compiler_holder_comprehension_alias_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                return 1 if not compiler_holder_comprehension_alias_case(true, 1)
                return 2 if not compiler_holder_comprehension_alias_case(false, 0)
                return 3 if not compiler_holder_ref_container_comprehension_alias_case()
                return 4 if not compiler_holder_scalar_view_iteration_case()
                return 5 if not compiler_holder_comprehension_filter_alias_case()
                return 6 if not compiler_holder_getelse_return_flow_case()
                return 7 if not compiler_holder_scalar_view_rebind_case()
                return 8 if not compiler_holder_slice_sview_case()
                return 9 if not compiler_holder_branch_comprehension_assignment_case(false)
                return 10 if not compiler_holder_branch_comprehension_assignment_case(true)
                return 11 if not compiler_holder_branch_comprehension_mutation_case()
                return 12 if not compiler_holder_aggregate_container_call_target_case()
                return 13 if not compiler_holder_branch_comprehension_destructure_mutation_case()
                return 14 if not compiler_holder_rebound_local_iterable_alias_case()
                return 15 if not compiler_holder_mixed_rebind_claim_case()
                return 0

        def compiler_holder_ref_container_comprehension_alias_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                ref_items: Ast::Expr = Ast::Expr.Ident("ref_items", at)
                item: Ast::Expr = Ast::Expr.Ident("item", at)
                comprehension: Ast::Expr = Ast::Expr.Comprehension("item", ref_items, Ast::Expr.Absent, item, at, 0)
                saved: Ast::Expr = Ast::Expr.Ident("saved", at)
                borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [saved, borrowed], ["", ""], at)
                declaration: Ast::Stmt = Ast::Stmt.VarDecl("saved", Ast::Expr.Absent, comprehension, at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "ref_items", false, false, true)
                ref_items_index: usize = chv_flow_latest(flow, "ref_items")
                nested_reference_collection_type: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("darray", at), Ast::Expr.Unary(TokenKind.Ampersand, Ast::Expr.Ident("i64", at), at), at)
                flow.may_contain_alias_reference[ref_items_index] <- chv_type_may_contain_alias_reference(nested_reference_collection_type, 0) if ref_items_index < flow.names.count
                chv_flow_bind(flow, "borrowed", false, true, false)
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder", "ref_items"]
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                summary: StoreThroughSummary = zeroed
                table <- chv_walk_statements([declaration, Ast::Stmt.Expr(store, at)], false, ref_params, names, names, names, values, &flow, summary, table)
                return false if table.diagnostics.count != 1

                local_items: Ast::Expr = Ast::Expr.Ident("local_items", at)
                local_item: Ast::Expr = Ast::Expr.Ident("local_item", at)
                local_comprehension: Ast::Expr = Ast::Expr.Comprehension("local_item", local_items, Ast::Expr.Absent, local_item, at, 0)
                local_items_declaration: Ast::Stmt = Ast::Stmt.VarDecl("local_items", nested_reference_collection_type, ref_items, at)
                local_saved: Ast::Expr = Ast::Expr.Ident("local_saved", at)
                local_declaration: Ast::Stmt = Ast::Stmt.VarDecl("local_saved", Ast::Expr.Absent, local_comprehension, at)
                local_store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [local_saved, borrowed], ["", ""], at)
                local_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(local_flow, "holder", false, false, true)
                chv_flow_bind(local_flow, "ref_items", false, false, true)
                local_ref_items_index: usize = chv_flow_latest(local_flow, "ref_items")
                local_flow.may_contain_alias_reference[local_ref_items_index] <- chv_type_may_contain_alias_reference(nested_reference_collection_type, 0) if local_ref_items_index < local_flow.names.count
                chv_flow_bind(local_flow, "borrowed", false, true, false)
                local_table: mutable SymbolTable = SymbolTable(false)
                local_ref_params: darray[sview] = ["holder"]
                local_table <- chv_walk_statements([local_items_declaration, local_declaration, Ast::Stmt.Expr(local_store, at)], false, local_ref_params, names, names, names, values, &local_flow, summary, local_table)
                return false if local_table.diagnostics.count != 1
                return false if not compiler_holder_decl_parameter_nested_reference_case()
                return compiler_holder_scalar_borrowed_nested_iteration_case()

        def compiler_holder_decl_parameter_nested_reference_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                byte_type: Ast::Expr = Ast::Expr.Ident("u8", at)
                buffer_type: Ast::Expr = Ast::Expr.Unary(TokenKind.Mutable, Ast::Expr.Index(Ast::Expr.Ident("darray", at), byte_type, at), at)
                ref_items_type: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("darray", at), Ast::Expr.Unary(TokenKind.Ampersand, Ast::Expr.Ident("i64", at), at), at)
                holder_type: Ast::Expr = Ast::Expr.Unary(TokenKind.Mutable, Ast::Expr.Unary(TokenKind.Ampersand, Ast::Expr.Ident("Holder", at), at), at)
                holder_parameter: Ast::ParamDecl = Ast::ParamDecl{name: "holder", type_expression: holder_type, is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}
                items_parameter: Ast::ParamDecl = Ast::ParamDecl{name: "items", type_expression: ref_items_type, is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}
                empty_buffer: Ast::Expr = Ast::Expr.Array([], at)
                buffer_declaration: Ast::Stmt = Ast::Stmt.VarDecl("buffer", buffer_type, empty_buffer, at)
                view_receiver: Ast::Expr = Ast::Expr.Ident("buffer", at)
                view_value: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(view_receiver, "as_sview", at), [], [], at)
                view_declaration: Ast::Stmt = Ast::Stmt.VarDecl("view", Ast::Expr.Ident("sview", at), view_value, at)
                item: Ast::Expr = Ast::Expr.Ident("item", at)
                comprehension: Ast::Expr = Ast::Expr.Comprehension("item", Ast::Expr.Ident("items", at), Ast::Expr.Absent, item, at, 0)
                saved_declaration: Ast::Stmt = Ast::Stmt.VarDecl("saved", Ast::Expr.Absent, comprehension, at)
                sink: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [Ast::Expr.Ident("saved", at), Ast::Expr.Ident("view", at)], ["", ""], at)
                caller: Ast::Decl = Ast::Decl.Func("caller", [holder_parameter, items_parameter], null, [buffer_declaration, view_declaration, saved_declaration, Ast::Stmt.Expr(sink, at)], [], [], at)
                table: mutable SymbolTable = SymbolTable(false)
                summary: StoreThroughSummary = zeroed
                no_rebind_claims: darray[Ast::EnumAnnotation] = []
                table <- chv_walk_declarations([caller], summary, no_rebind_claims, table)
                return table.diagnostics.count == 1

        def compiler_holder_scalar_borrowed_nested_iteration_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                ref_items: Ast::Expr = Ast::Expr.Ident("ref_items", at)
                scalar_collection_type: Ast::Expr = Ast::Expr.Unary(TokenKind.Ampersand, Ast::Expr.Index(Ast::Expr.Ident("darray", at), Ast::Expr.Ident("i64", at), at), at)
                item: Ast::Expr = Ast::Expr.Ident("item", at)
                nested: Ast::Expr = Ast::Expr.Ident("nested", at)
                nested_values: Ast::Expr = Ast::Expr.Array([item], at)
                nested_comprehension: Ast::Expr = Ast::Expr.Comprehension("nested", nested_values, Ast::Expr.Absent, nested, at, 0)
                comprehension: Ast::Expr = Ast::Expr.Comprehension("item", ref_items, Ast::Expr.Absent, nested_comprehension, at, 0)
                saved: Ast::Expr = Ast::Expr.Ident("saved", at)
                borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                declaration: Ast::Stmt = Ast::Stmt.VarDecl("saved", Ast::Expr.Absent, comprehension, at)
                store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [saved, borrowed], ["", ""], at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "ref_items", false, false, true)
                ref_items_index: usize = chv_flow_latest(flow, "ref_items")
                flow.may_contain_alias_reference[ref_items_index] <- chv_type_may_contain_alias_reference(scalar_collection_type, 0) if ref_items_index < flow.names.count
                chv_flow_bind(flow, "borrowed", false, true, false)
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder", "ref_items"]
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                summary: StoreThroughSummary = zeroed
                table <- chv_walk_statements([declaration, Ast::Stmt.Expr(store, at)], false, ref_params, names, names, names, values, &flow, summary, table)
                return table.diagnostics.count == 0

        def compiler_holder_aggregate_container_call_target_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                reference_container_type: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("darray", at), Ast::Expr.Unary(TokenKind.Ampersand, Ast::Expr.Ident("i64", at), at), at)
                empty: Ast::Expr = Ast::Expr.Array([], at)
                container_declaration: Ast::Stmt = Ast::Stmt.VarDecl("container", reference_container_type, empty, at)
                container: Ast::Expr = Ast::Expr.Ident("container", at)
                owned_view: Ast::Expr = Ast::Expr.Ident("owned_view", at)
                call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [container, owned_view], ["", ""], at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "owned_view", false, true, false)
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = []
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                summary: StoreThroughSummary = zeroed
                table <- chv_walk_statements([container_declaration, Ast::Stmt.Expr(call, at)], false, ref_params, names, names, names, values, &flow, summary, table)
                return table.diagnostics.count == 1

        def compiler_holder_rebound_local_iterable_alias_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                safe_source: Ast::Expr = Ast::Expr.Ident("safe_source", at)
                unsafe_source: Ast::Expr = Ast::Expr.Ident("unsafe_source", at)
                initial_elements: Ast::Expr = Ast::Expr.Array([safe_source], at)
                initial_rows: Ast::Expr = Ast::Expr.Array([initial_elements], at)
                rows_declaration: Ast::Stmt = Ast::Stmt.VarDecl("rows", Ast::Expr.Absent, initial_rows, at)
                rebound_elements: Ast::Expr = Ast::Expr.Array([unsafe_source], at)
                rebound_rows: Ast::Expr = Ast::Expr.Array([rebound_elements], at)
                rebind: Ast::Stmt = Ast::Stmt.Assign(Ast::Expr.Ident("rows", at), TokenKind.LArrow, rebound_rows, at)
                row: Ast::Expr = Ast::Expr.Ident("row", at)
                item: Ast::Expr = Ast::Expr.Ident("item", at)
                store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [item, Ast::Expr.Ident("borrowed", at)], ["", ""], at)
                inner_loop: Ast::Stmt = Ast::Stmt.For("", ["item"], row, [Ast::Stmt.Expr(store, at)], at)
                outer_loop: Ast::Stmt = Ast::Stmt.For("", ["row"], Ast::Expr.Ident("rows", at), [inner_loop], at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "safe_source", false, false, false)
                chv_flow_bind(flow, "unsafe_source", false, false, true)
                chv_flow_bind(flow, "borrowed", false, true, false)
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder"]
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                view_names: darray[sview] = ["rows"]
                view_values: darray[Ast::Expr] = [initial_rows]
                summary: StoreThroughSummary = zeroed
                table <- chv_walk_statements([rows_declaration, rebind, outer_loop], false, ref_params, names, names, view_names, view_values, &flow, summary, table)
                return false if table.diagnostics.count != 1

                branch_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(branch_flow, "holder", false, false, true)
                chv_flow_bind(branch_flow, "safe_source", false, false, false)
                chv_flow_bind(branch_flow, "unsafe_source", false, false, true)
                chv_flow_bind(branch_flow, "borrowed", false, true, false)
                branch_table: mutable SymbolTable = SymbolTable(false)
                branch: Ast::Stmt = Ast::Stmt.If(Ast::Expr.BoolLit(true, at), [rebind], [], at)
                branch_table <- chv_walk_statements([rows_declaration, branch, outer_loop], false, ref_params, names, names, view_names, view_values, &branch_flow, summary, branch_table)
                return branch_table.diagnostics.count == 1

        def compiler_holder_mixed_rebind_claim_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                fresh: Ast::Expr = Ast::Expr.Ident("fresh", at)
                recv: Ast::Expr = Ast::Expr.Ident("recv", at)
                safe_source: Ast::Expr = Ast::Expr.Ident("safe_source", at)
                alias_source: Ast::Expr = Ast::Expr.Ident("alias_source", at)
                target: Ast::Expr = Ast::Expr.Array([fresh, recv], at)
                value: Ast::Expr = Ast::Expr.Tuple([safe_source, alias_source], at)
                assignment: Ast::Stmt = Ast::Stmt.Assign(target, TokenKind.Assign, value, at)
                borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [recv, borrowed], ["", ""], at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "fresh", false, false, false)
                chv_flow_bind(flow, "recv", false, false, false)
                chv_flow_bind(flow, "safe_source", false, false, false)
                chv_flow_bind(flow, "alias_source", false, false, true)
                chv_flow_bind(flow, "borrowed", false, true, false)
                recv_index: usize = chv_flow_latest(flow, "recv")
                fresh_index: usize = chv_flow_latest(flow, "fresh")
                flow.rebind_claims.push(Ast::EnumAnnotation{owner: "__lmut_rebind_claim", name: "recv", line: at.line})
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder"]
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                summary: StoreThroughSummary = zeroed
                table <- chv_walk_statements([assignment, Ast::Stmt.Expr(store, at)], false, ref_params, names, names, names, values, &flow, summary, table)
                new_fresh_index: usize = chv_flow_latest(flow, "fresh")
                return table.diagnostics.count == 1 and chv_flow_latest(flow, "recv") == recv_index and new_fresh_index > fresh_index and flow.may_alias_reference[recv_index]

        def compiler_holder_scalar_view_iteration_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                bytes: Ast::Expr = Ast::Expr.Ident("bytes", at)
                view_value: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(bytes, "as_sview", at), [], [], at)
                holder: Ast::Expr = Ast::Expr.Ident("holder", at)
                borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                byte: Ast::Expr = Ast::Expr.Ident("byte", at)
                store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [holder, byte], ["", ""], at)
                declaration: Ast::Stmt = Ast::Stmt.VarDecl("view", Ast::Expr.Ident("sview", at), view_value, at)
                loop: Ast::Stmt = Ast::Stmt.For("", ["byte"], Ast::Expr.Ident("view", at), [Ast::Stmt.Expr(store, at)], at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "bytes", true, false, false)
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder"]
                binders: darray[sview] = []
                owned: darray[sview] = []
                view_names: darray[sview] = ["view"]
                view_values: darray[Ast::Expr] = [view_value]
                summary: StoreThroughSummary = zeroed
                table <- chv_walk_statements([declaration, loop], false, ref_params, binders, owned, view_names, view_values, &flow, summary, table)
                return false if table.diagnostics.count != 0

                scalar_byte: Ast::Expr = Ast::Expr.Ident("scalar_byte", at)
                scalar_saved: Ast::Expr = Ast::Expr.Ident("scalar_saved", at)
                scalar_comprehension: Ast::Expr = Ast::Expr.Comprehension("scalar_byte", view_value, Ast::Expr.Absent, scalar_byte, at, 0)
                scalar_declaration: Ast::Stmt = Ast::Stmt.VarDecl("scalar_saved", Ast::Expr.Absent, scalar_comprehension, at)
                scalar_store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [scalar_saved, borrowed], ["", ""], at)
                scalar_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(scalar_flow, "holder", false, false, true)
                chv_flow_bind(scalar_flow, "bytes", true, false, false)
                chv_flow_bind(scalar_flow, "borrowed", false, true, false)
                scalar_table: mutable SymbolTable = SymbolTable(false)
                scalar_summary: StoreThroughSummary = zeroed
                scalar_table <- chv_walk_statements([scalar_declaration, Ast::Stmt.Expr(scalar_store, at)], false, ref_params, binders, owned, view_names, view_values, &scalar_flow, scalar_summary, scalar_table)
                return false if scalar_table.diagnostics.count != 0

                scalar_views: Ast::Expr = Ast::Expr.Array([view_value], at)
                scalar_views_declaration: Ast::Stmt = Ast::Stmt.VarDecl("scalar_views", Ast::Expr.Absent, scalar_views, at)
                nested_view: Ast::Expr = Ast::Expr.Ident("nested_view", at)
                nested_byte: Ast::Expr = Ast::Expr.Ident("nested_byte", at)
                owned_view: Ast::Expr = Ast::Expr.Ident("owned_view", at)
                nested_store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [nested_byte, owned_view], ["", ""], at)
                nested_loop: Ast::Stmt = Ast::Stmt.For("", ["nested_byte"], nested_view, [Ast::Stmt.Expr(nested_store, at)], at)
                outer_loop: Ast::Stmt = Ast::Stmt.For("", ["nested_view"], Ast::Expr.Ident("scalar_views", at), [nested_loop], at)
                nested_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(nested_flow, "holder", false, false, true)
                chv_flow_bind(nested_flow, "bytes", true, false, false)
                chv_flow_bind(nested_flow, "owned_view", false, true, false)
                nested_table: mutable SymbolTable = SymbolTable(false)
                nested_summary: StoreThroughSummary = zeroed
                nested_table <- chv_walk_statements([declaration, scalar_views_declaration, outer_loop], false, ref_params, binders, owned, view_names, view_values, &nested_flow, nested_summary, nested_table)
                return scalar_table.diagnostics.count == 0 and nested_table.diagnostics.count == 0

        def compiler_holder_comprehension_filter_alias_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                alias_source: Ast::Expr = Ast::Expr.Ident("alias_source", at)
                item: Ast::Expr = Ast::Expr.Ident("item", at)
                payload: Ast::Expr = Ast::Expr.Ident("payload", at)
                borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                iterable: Ast::Expr = Ast::Expr.Array([alias_source], at)
                condition: Ast::Expr = Ast::Expr.Binary(item, TokenKind.Is, payload, at)
                comprehension: Ast::Expr = Ast::Expr.Comprehension("item", iterable, condition, payload, at, 0)
                saved: Ast::Expr = Ast::Expr.Ident("saved", at)
                declaration: Ast::Stmt = Ast::Stmt.VarDecl("saved", Ast::Expr.Absent, comprehension, at)
                store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [saved, borrowed], ["", ""], at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "alias_source", false, false, true)
                chv_flow_bind(flow, "borrowed", false, true, false)
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder"]
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                summary: StoreThroughSummary = zeroed
                table <- chv_walk_statements([declaration, Ast::Stmt.Expr(store, at)], false, ref_params, names, names, names, values, &flow, summary, table)
                return table.diagnostics.count == 1

        def compiler_holder_getelse_return_flow_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                holder: Ast::Expr = Ast::Expr.Ident("holder", at)
                safe_target: Ast::Expr = Ast::Expr.Ident("safe_target", at)
                borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                assign_target: Ast::Stmt = Ast::Stmt.Assign(safe_target, TokenKind.Assign, holder, at)
                return_statement: Ast::Stmt = Ast::Stmt.Return(Ast::Expr.Absent, at)
                get_else: Ast::Expr = Ast::Expr.GetElse(safe_target, [assign_target, return_statement], at)
                store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [safe_target, borrowed], ["", ""], at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "safe_target", false, false, false)
                chv_flow_bind(flow, "borrowed", false, true, false)
