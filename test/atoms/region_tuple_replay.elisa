extend Semantic:
    public:
        def region_tuple_replay_atom_probe() -> i64 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    at: Ast::Pos = zeroed
                    annotations: darray[Ast::LocalRegionAnnotation] @source = []
                    view_fns: darray[sview @source] @source = []
                    container_fns: darray[sview @source] @source = []
                    nesting: darray[sview @source] @source = ["outer", "inner"]
                    catch_context: RegionEscapeCatchContext = RegionEscapeCatchContext{markers: [], lexical_module: ""}
                    source_names: darray[sview @source] @source = ["inner_view", "safe_value", "join_left", "join_right"]
                    source_regions: darray[sview @source] @source = ["inner", "", "", ""]
                    tuple_target: Ast::Expr = Ast::Expr.Tuple([Ast::Expr.Ident("left", at), Ast::Expr.Ident("right", at)], at)
                    tuple_value: Ast::Expr = Ast::Expr.Tuple([Ast::Expr.Ident("inner_view", at), Ast::Expr.Ident("safe_value", at)], at)
                    tuple_assign: Ast::Stmt = Ast::Stmt.Assign(tuple_target, TokenKind.Assign, tuple_value, at)
                    left_body: darray[Ast::Stmt] @source = [tuple_assign, Ast::Stmt.Expr(Ast::Expr.Ident("left", at), at)]
                    left_result: (found: bool, position: usize) = region_escape_body_value_region(left_body, null, annotations, view_fns, container_fns, nesting, source_names, source_regions, 10)
                    return 1 if not left_result.found or left_result.position != 1
                    right_body: darray[Ast::Stmt] @source = [tuple_assign, Ast::Stmt.Expr(Ast::Expr.Ident("right", at), at)]
                    right_result: (found: bool, position: usize) = region_escape_body_value_region(right_body, null, annotations, view_fns, container_fns, nesting, source_names, source_regions, 10)
                    return 2 if right_result.found

                    array_target: Ast::Expr = Ast::Expr.Array([Ast::Expr.Ident("array_left", at), Ast::Expr.Ident("array_right", at)], at)
                    array_value: Ast::Expr = Ast::Expr.Array([Ast::Expr.Ident("inner_view", at), Ast::Expr.Ident("safe_value", at)], at)
                    array_assign: Ast::Stmt = Ast::Stmt.Assign(array_target, TokenKind.Assign, array_value, at)
                    array_body: darray[Ast::Stmt] @source = [array_assign, Ast::Stmt.Expr(Ast::Expr.Ident("array_left", at), at)]
                    array_result: (found: bool, position: usize) = region_escape_body_value_region(array_body, null, annotations, view_fns, container_fns, nesting, source_names, source_regions, 10)
                    return 3 if not array_result.found or array_result.position != 1
                    safe_array_body: darray[Ast::Stmt] @source = [array_assign, Ast::Stmt.Expr(Ast::Expr.Ident("array_right", at), at)]
                    safe_array_result: (found: bool, position: usize) = region_escape_body_value_region(safe_array_body, null, annotations, view_fns, container_fns, nesting, source_names, source_regions, 10)
                    return 7 if safe_array_result.found

                    swap_names: darray[sview @source] @source = ["swap_left", "swap_right"]
                    swap_regions: darray[sview @source] @source = ["inner", "outer"]
                    swap_target: Ast::Expr = Ast::Expr.Tuple([Ast::Expr.Ident("swap_left", at), Ast::Expr.Ident("swap_right", at)], at)
                    swap_value: Ast::Expr = Ast::Expr.Tuple([Ast::Expr.Ident("swap_right", at), Ast::Expr.Ident("swap_left", at)], at)
                    swap_assign: Ast::Stmt = Ast::Stmt.Assign(swap_target, TokenKind.Assign, swap_value, at)
                    swap_left_body: darray[Ast::Stmt] @source = [swap_assign, Ast::Stmt.Expr(Ast::Expr.Ident("swap_left", at), at)]
                    swap_left_result: (found: bool, position: usize) = region_escape_body_value_region(swap_left_body, null, annotations, view_fns, container_fns, nesting, swap_names, swap_regions, 10)
                    return 4 if not swap_left_result.found or swap_left_result.position != 0
                    swap_right_body: darray[Ast::Stmt] @source = [swap_assign, Ast::Stmt.Expr(Ast::Expr.Ident("swap_right", at), at)]
                    swap_right_result: (found: bool, position: usize) = region_escape_body_value_region(swap_right_body, null, annotations, view_fns, container_fns, nesting, swap_names, swap_regions, 10)
                    return 5 if not swap_right_result.found or swap_right_result.position != 1

                    arm_target: Ast::Expr = Ast::Expr.Tuple([Ast::Expr.Ident("plain", at), Ast::Expr.Ident("arm_result", at)], at)
                    arm_value: Ast::Expr = Ast::Expr.Tuple([Ast::Expr.Ident("safe_value", at), Ast::Expr.Ident("inner_view", at)], at)
                    arm_assign: Ast::Stmt = Ast::Stmt.Assign(arm_target, TokenKind.Assign, arm_value, at)
                    arm_body: darray[Ast::Stmt] @source = [arm_assign, Ast::Stmt.Expr(Ast::Expr.Ident("arm_result", at), at)]
                    value_arms: darray[Ast::MatchArm] @source = [Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: arm_body, guard: Ast::Expr.Absent, pos: at}]
                    empty_element_names: darray[sview @source] @source = []
                    empty_element_regions: darray[sview @source] @source = []
                    arm_region: sview @source = region_escape_value_arms_region_with_elements(false, Ast::Expr.IntLit(1, at), value_arms, annotations, view_fns, container_fns, nesting, source_names, source_regions, empty_element_names, empty_element_regions, 10, catch_context)
                    return 10 if arm_region != "inner"
                    catch_success_body: darray[Ast::Stmt] @source = [Ast::Stmt.Expr(Ast::Expr.Ident("safe_value", at), at)]
                    catch_error_body: darray[Ast::Stmt] @source = [arm_assign, Ast::Stmt.Expr(Ast::Expr.Ident("arm_result", at), at)]
                    catch_arms: darray[Ast::MatchArm] @source = [
                        Ast::MatchArm{pattern: Ast::Pattern.Binding("success"), body: catch_success_body, guard: Ast::Expr.Absent, pos: at},
                        Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: catch_error_body, guard: Ast::Expr.Absent, pos: at}
                    ]
                    catch_raise: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("raise", at), [Ast::Expr.IntLit(1, at)], [], at)
                    catch_region: sview @source = region_escape_value_arms_region_with_elements(true, catch_raise, catch_arms, annotations, view_fns, container_fns, nesting, source_names, source_regions, empty_element_names, empty_element_regions, 10, catch_context)
                    return 13 if catch_region != "inner"
                    join_target: Ast::Expr = Ast::Expr.Tuple([Ast::Expr.Ident("join_left", at), Ast::Expr.Ident("join_right", at)], at)
                    join_inner_value: Ast::Expr = Ast::Expr.Tuple([Ast::Expr.Ident("inner_view", at), Ast::Expr.Ident("safe_value", at)], at)
                    join_safe_value: Ast::Expr = Ast::Expr.Tuple([Ast::Expr.Ident("safe_value", at), Ast::Expr.Ident("safe_value", at)], at)
                    join_inner_assign: Ast::Stmt = Ast::Stmt.Assign(join_target, TokenKind.Assign, join_inner_value, at)
                    join_safe_assign: Ast::Stmt = Ast::Stmt.Assign(join_target, TokenKind.Assign, join_safe_value, at)
                    join_if: Ast::Stmt = Ast::Stmt.If(Ast::Expr.Ident("condition", at), [join_inner_assign], [join_safe_assign], at)
                    join_left_body: darray[Ast::Stmt] @source = [join_if, Ast::Stmt.Expr(Ast::Expr.Ident("join_left", at), at)]
                    join_left_arms: darray[Ast::MatchArm] @source = [Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: join_left_body, guard: Ast::Expr.Absent, pos: at}]
                    join_left_region: sview @source = region_escape_value_arms_region_with_elements(false, Ast::Expr.IntLit(1, at), join_left_arms, annotations, view_fns, container_fns, nesting, source_names, source_regions, empty_element_names, empty_element_regions, 10, catch_context)
                    return 11 if join_left_region != "inner"
                    join_right_body: darray[Ast::Stmt] @source = [join_if, Ast::Stmt.Expr(Ast::Expr.Ident("join_right", at), at)]
                    join_right_arms: darray[Ast::MatchArm] @source = [Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: join_right_body, guard: Ast::Expr.Absent, pos: at}]
                    join_right_region: sview @source = region_escape_value_arms_region_with_elements(false, Ast::Expr.IntLit(1, at), join_right_arms, annotations, view_fns, container_fns, nesting, source_names, source_regions, empty_element_names, empty_element_regions, 10, catch_context)
                    return 12 if join_right_region != ""

                    collection_names: darray[sview @source] @source = ["view_source", "safe_source"]
                    collection_regions: darray[sview @source] @source = ["outer", "outer"]
                    element_names: darray[sview @source] @source = ["view_source", "safe_source"]
                    element_regions: darray[sview @source] @source = ["inner", ""]
                    element_target: Ast::Expr = Ast::Expr.Tuple([Ast::Expr.Ident("view_bucket", at), Ast::Expr.Ident("safe_bucket", at)], at)
                    element_value: Ast::Expr = Ast::Expr.Tuple([Ast::Expr.Ident("view_source", at), Ast::Expr.Ident("safe_source", at)], at)
                    element_assign: Ast::Stmt = Ast::Stmt.Assign(element_target, TokenKind.Assign, element_value, at)
                    view_index: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("view_bucket", at), Ast::Expr.IntLit(0, at), at)
                    view_body: darray[Ast::Stmt] @source = [element_assign, Ast::Stmt.Expr(view_index, at)]
                    view_result: (found: bool, position: usize) = region_escape_body_value_region_with_elements(view_body, null, annotations, view_fns, container_fns, nesting, collection_names, collection_regions, element_names, element_regions, 10, catch_context)
                    return 6 if not view_result.found or view_result.position != 1
                    safe_index: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("safe_bucket", at), Ast::Expr.IntLit(0, at), at)
                    safe_body: darray[Ast::Stmt] @source = [element_assign, Ast::Stmt.Expr(safe_index, at)]
                    safe_result: (found: bool, position: usize) = region_escape_body_value_region_with_elements(safe_body, null, annotations, view_fns, container_fns, nesting, collection_names, collection_regions, element_names, element_regions, 10, catch_context)
                    return 7 if not safe_result.found or safe_result.position != 0

                    element_swap_names: darray[sview @source] @source = ["element_left", "element_right"]
                    element_swap_regions: darray[sview @source] @source = ["outer", "outer"]
                    element_swap_taint_names: darray[sview @source] @source = ["element_left", "element_right"]
                    element_swap_taint_regions: darray[sview @source] @source = ["inner", ""]
                    element_swap_target: Ast::Expr = Ast::Expr.Tuple([Ast::Expr.Ident("element_left", at), Ast::Expr.Ident("element_right", at)], at)
                    element_swap_value: Ast::Expr = Ast::Expr.Tuple([Ast::Expr.Ident("element_right", at), Ast::Expr.Ident("element_left", at)], at)
                    element_swap_assign: Ast::Stmt = Ast::Stmt.Assign(element_swap_target, TokenKind.Assign, element_swap_value, at)
                    swapped_left_index: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("element_left", at), Ast::Expr.IntLit(0, at), at)
                    swapped_left_body: darray[Ast::Stmt] @source = [element_swap_assign, Ast::Stmt.Expr(swapped_left_index, at)]
                    swapped_left_result: (found: bool, position: usize) = region_escape_body_value_region_with_elements(swapped_left_body, null, annotations, view_fns, container_fns, nesting, element_swap_names, element_swap_regions, element_swap_taint_names, element_swap_taint_regions, 10, catch_context)
                    return 8 if not swapped_left_result.found or swapped_left_result.position != 0
                    swapped_right_index: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("element_right", at), Ast::Expr.IntLit(0, at), at)
                    swapped_right_body: darray[Ast::Stmt] @source = [element_swap_assign, Ast::Stmt.Expr(swapped_right_index, at)]
                    swapped_right_result: (found: bool, position: usize) = region_escape_body_value_region_with_elements(swapped_right_body, null, annotations, view_fns, container_fns, nesting, element_swap_names, element_swap_regions, element_swap_taint_names, element_swap_taint_regions, 10, catch_context)
                    return 9 if not swapped_right_result.found or swapped_right_result.position != 1

                    field_target: Ast::Expr = Ast::Expr.Field(Ast::Expr.Ident("record", at), "items", at)
                    field_assign: Ast::Stmt = Ast::Stmt.Assign(field_target, TokenKind.Assign, Ast::Expr.Ident("view_source", at), at)
                    field_index: Ast::Expr = Ast::Expr.Index(field_target, Ast::Expr.IntLit(0, at), at)
                    field_body: darray[Ast::Stmt] @source = [field_assign, Ast::Stmt.Expr(field_index, at)]
                    field_result: (found: bool, position: usize) = region_escape_body_value_region_with_elements(field_body, null, annotations, view_fns, container_fns, nesting, collection_names, collection_regions, element_names, element_regions, 10, catch_context)
                    return 14 if not field_result.found or field_result.position != 1

                    field_transfer_names: mutable darray[sview @source] = ["record"]
                    field_transfer_regions: mutable darray[sview @source] = ["outer"]
                    field_transfer_element_names: mutable darray[sview @source] = ["record"]
                    field_transfer_element_regions: mutable darray[sview @source] = ["outer"]
                    source_field_element_region: sview @source = region_escape_comprehension_element_region(Ast::Expr.Ident("view_source", at), annotations, view_fns, container_fns, nesting, collection_names, collection_regions, element_names, element_regions, 10)
                    return 16 if source_field_element_region != "inner"
                    region_escape_update_assignment_taints(field_target, Ast::Expr.Ident("view_source", at), TokenKind.Assign, annotations, view_fns, container_fns, nesting, field_transfer_names, field_transfer_regions, field_transfer_element_names, field_transfer_element_regions, collection_names, collection_regions, element_names, element_regions, 10, catch_context)
                    return 15 if region_escape_element_taint_lookup(field_transfer_element_names, field_transfer_element_regions, "record") != "inner"
                    return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Semantic::region_tuple_replay_atom_probe() can Global{Read,Write}
