extend Semantic:
    public:
        def readonly_ref_atom_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    node_store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in node_store:
                        at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                        scalar: Ast::Expr = Ast::Expr.Ident("i64", at)
                        reference: Ast::Expr = Ast::Expr.Unary(TokenKind.Ampersand, scalar, at)
                        writable: Ast::Expr = Ast::Expr.Unary(TokenKind.Mutable, reference, at)
                        parameters: darray[Ast::ParamDecl] @source = [
                            Ast::ParamDecl{name: "value", type_expression: writable, is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}
                        ]
                        caller_parameters: darray[Ast::ParamDecl] @source = [
                            Ast::ParamDecl{name: "value", type_expression: reference, is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}
                        ]
                        call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("consume", at), [Ast::Expr.Ident("value", at)], [""], at)
                        index_pos: Ast::Pos = Ast::Pos{line: 1, column: 6, offset: 5, end_line: 1, end_column: 7, end_offset: 6}
                        index: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("value", at), Ast::Expr.IntLit(0, at), index_pos)
                        body: darray[Ast::Stmt] @source = [Ast::Stmt.Expr(call, at), Ast::Stmt.Assign(index, TokenKind.LArrow, Ast::Expr.IntLit(1, at), at)]
                        return_pos: Ast::Pos = Ast::Pos{line: 2, column: 5, offset: 20, end_line: 2, end_column: 11, end_offset: 26}
                        return_body: darray[Ast::Stmt] @source = [Ast::Stmt.Return(Ast::Expr.Ident("value", at), return_pos)]
                        declarations: darray[Ast::Decl] @source = [
                            Ast::Decl.Func("consume", parameters, null, [], [], [], at),
                            Ast::Decl.Func("caller", caller_parameters, null, body, [], [], at),
                            Ast::Decl.Func("invalid_return", caller_parameters, writable, return_body, [], [], at)
                        ]
                        empty_file: Ast::File = zeroed
                        file: Ast::File = empty_file{top_decls = declarations}
                        table: mutable SymbolTable = SymbolTable(false)
                        region scratch(1048576):
                            table <- check_readonly_refs(declarations, table)
                        return 1 if table.diagnostics.count < 1
                        diagnostic: Diagnostic = table.diagnostics[0]
                        return 2 if diagnostic.kind != DiagnosticKind.ReadonlyRefArgument
                        return 3 if diagnostic.name != "consume"
                        return 4 if diagnostic.expected != "i64" or diagnostic.actual != "i64"
                        matching_note: mutable bool = false
                        matching_return: mutable bool = false
                        for note in table.diagnostics |matching_note, matching_return|:
                            if note.kind == DiagnosticKind.ReadonlyRefMutationNote:
                                matching_note <- note.pos.column == index_pos.column
                            if note.kind == DiagnosticKind.RefAssignMismatch and note.name == "return":
                                matching_return <- note.pos.offset == return_pos.offset and note.pos.end_column == return_pos.end_column
                        return 5 if not matching_note
                        return 6 if not matching_return
                        return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::readonly_ref_atom_probe() can Global{Read,Write}
