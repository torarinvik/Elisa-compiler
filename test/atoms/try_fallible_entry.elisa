extend Semantic:
    public:
        def compiler_try_fallible_entry_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                empty_file: Ast::File = zeroed
                fallback_site: Ast::EnumAnnotation = Ast::EnumAnnotation{owner: "__try_fallback_expression", name: "", line: 1}
                file: Ast::File = empty_file{enum_annotations = [fallback_site]}
                table: mutable SymbolTable = SymbolTable(false)
                table <- check_try_fallible(&file, table)
                return table.diagnostics.count.i32()

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_try_fallible_entry_probe() can Global{Read,Write}
