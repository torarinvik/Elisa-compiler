# The cycle guard retains AST names rather than temporary lookup text. Nested
# dependencies emit first, and repeated requests must not duplicate typedefs.
def compiler_pymodule_struct_typedef_probe() -> i64 can[Abort.Panic, Memory.Allocate]:
    can Global{Read,Write}:
        region owner(1048576):
            nodes: Ast::Node.Store[Local] = Ast::Node.Store(owner)
            in nodes:
                at: Ast::Pos = zeroed
                empty_member: Ast::StructMember = Ast::StructMember{is_private: false, name: "", type_expression: Ast::Expr.Invalid, omittable: false, is_ghost: false, has_default: false, default_value: Ast::Expr.Invalid, region: "", bit_group_kind: "", bit_group_members: []}
                point_member: Ast::StructMember = empty_member{name = "x", type_expression = Ast::Expr.Ident("i64", at)}
                outer_member: Ast::StructMember = empty_member{name = "point", type_expression = Ast::Expr.Ident("Point", at)}
                point_members: darray[Ast::StructMember] @source = [point_member]
                outer_members: darray[Ast::StructMember] @source = [outer_member]
                declarations: darray[Ast::Decl] @source = [
                    Ast::Decl.Struct("Point", point_members, "", false, false, [], at),
                    Ast::Decl.Struct("Outer", outer_members, "", false, false, [], at)
                ]
                empty_file: Ast::File = zeroed
                file: Ast::File = empty_file{top_decls = declarations}
                lookup_storage: mutable darray[u8] = []
                emit_tokens_push_sview(&lookup_storage, "Outer")
                lookup: sview = bytes_view_range(lookup_storage, 0, lookup_storage.count)
                buffer: mutable darray[u8] = []
                names: mutable darray[sview @source] = []
                emit_pymodule_struct_typedef_and_helpers(&buffer, &file, lookup, names)
                return 1 if names.count != 2
                return 2 if names[0] != "Outer" or names[1] != "Point"
                count_before: usize = buffer.count
                emit_pymodule_struct_typedef_and_helpers(&buffer, &file, "Outer", names)
                return 3 if buffer.count != count_before
                lookup_storage[0] <- 88.u8()
                return 4 if names[0] != "Outer" or names[1] != "Point"
                generated: sview = bytes_view_range(buffer, 0, buffer.count)
                dependency_prefix: sview = "typedef struct { int64_t x; } Point;"
                return 5 if generated.len < dependency_prefix.len
                return 6 if generated[0:dependency_prefix.len] != dependency_prefix
                return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return compiler_pymodule_struct_typedef_probe() can Global{Read,Write}
