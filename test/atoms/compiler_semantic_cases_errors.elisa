                            Ast::EnumAnnotation{owner: "__error_set_family", name: "Shared", line: 1, offset: 2, identity_id: 8},
                            Ast::EnumAnnotation{owner: "__error_set_family_path", name: "Shared", line: 1, offset: 2, identity_id: 8}
                        ]
                        qualified_variant_reverse_file: Ast::File = empty_file{enum_annotations = qualified_variant_reverse_annotations}
                        qualified_variant_table.diagnostics <- []
                        qualified_variant_table <- check_ambiguous_error_variant(&qualified_variant_reverse_file, qualified_variant_table)
                        return 9915 if qualified_variant_table.diagnostics.count != 1
                        return 0
