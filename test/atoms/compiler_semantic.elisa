extend Semantic:
    public:
        def compiler_atom_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    node_store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in node_store:
                        at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                        table: mutable SymbolTable = SymbolTable(false)
                        table <- table.add_symbol("region_func", SymbolKind.Func, 1)
                        empty_file: Ast::File = zeroed
                        regions: darray[Ast::LocalRegionAnnotation] @source = [Ast::LocalRegionAnnotation{name: "__region_param", type_expression: Ast::Expr.Invalid, region: "r", line: 1, end_line: 2}]
                        global_regions: darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "__global_region", name: "program_region", line: 1}]
                        file: Ast::File = empty_file{local_region_annotations = regions, enum_annotations = global_regions}
                        register_region_type_names(&file, &table)
                        return 100 if not any region_name in table.region_names where region_name == "program_region"
                        names: darray[sview @source] = []
                        table <- check_non_generic_specialization(Ast::Expr.Ident("region_func", at), 3, table, names)
                        return 1 if table.diagnostics.count != 0
                        table <- table.add_symbol("plain_func", SymbolKind.Func, 4)
                        table <- check_non_generic_specialization(Ast::Expr.Ident("plain_func", at), 5, table, names)
                        return 2 if table.diagnostics.count != 1
                        annotations: darray[Ast::EnumAnnotation] = []
                        other_constants: darray[Ast::Decl] @source = [Ast::Decl.Const("FIRST", Ast::Expr.Ident("u32", at), Ast::Expr.IntLit(23, at), false, at)]
                        constants: darray[Ast::Decl] = [
                            Ast::Decl.Const("FIRST", Ast::Expr.Ident("u32", at), Ast::Expr.IntLit(17, at), false, at),
                            Ast::Decl.Const("WRITABLE", Ast::Expr.Ident("u32", at), Ast::Expr.IntLit(9, at), true, at),
                            Ast::Decl.Const("TEXT", Ast::Expr.Ident("cstr", at), Ast::Expr.StringLit("17", at), false, at),
                            Ast::Decl.Module("Other", other_constants, at)
                        ]
                        table <- collect_range(constants, table, annotations)
                        return 3 if not scalar_named_constant_pattern_valid(Ast::Pattern.Binding("FIRST"), names, table)
                        return 4 if scalar_named_constant_pattern_valid(Ast::Pattern.Binding("missing"), names, table)
                        shadowed: darray[sview] = ["FIRST"]
                        return 5 if scalar_named_constant_pattern_valid(Ast::Pattern.Binding("FIRST"), shadowed, table)
                        state: mutable GlobalAuthority = GlobalAuthority{annotations: [], parents: [0], modules: [""], module_starts: [0], module_lengths: [0]}
                        state.functions.push("scalar_result")
                        state.function_scopes.push(0)
                        state.function_return_types.push(Ast::Expr.Ident("u64", at))
                        return 6 if ga_callback_return_slot(0, at, &state) != GLOBAL_AUTHORITY_NONE
                        return 7 if scalar_named_constant_pattern_valid(Ast::Pattern.Binding("WRITABLE"), names, table)
                        return 8 if scalar_named_constant_pattern_valid(Ast::Pattern.Binding("TEXT"), names, table)
                        return 9 if not scalar_named_constant_pattern_valid(Ast::Pattern.Variant("Other::FIRST", []), names, table)
                        return 10 if scalar_named_constant_pattern_valid(Ast::Pattern.Variant("Missing::FIRST", []), names, table)
                        state.functions.push("callback_factory")
                        state.functions.push("")
                        state.function_scopes.push(0)
                        state.function_return_types.push(Ast::Expr.Lambda([], [], at))
                        state.returned_callees.push(GLOBAL_AUTHORITY_NONE)
                        state.returned_callees.push(2)
                        return 11 if ga_callback_return_slot(1, at, &state) != 2
                        discarded: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("fallible", at), [], [], at)
                        body: darray[Ast::Stmt] @source = [Ast::Stmt.Expr(discarded, at)]
                        decls: darray[Ast::Decl] @source = [Ast::Decl.Func("caller", [], null, body, [], [], at)]
                        markers: darray[Ast::EnumAnnotation] @source = [Ast::EnumAnnotation{owner: "fallible", name: "__error_return", line: 1}]
                        error_file: Ast::File = empty_file{top_decls = decls, enum_annotations = markers}
                        error_table: mutable SymbolTable = SymbolTable(false)
                        error_table <- check_error_union_unhandled(&error_file, error_table)
                        return 12 if error_table.diagnostics.count != 1
                        return 13 if error_table.diagnostics[0].name != "fallible"
                        return 14 if not ga_exact_void_return(Ast::Expr.Ident("void", at))
                        return 15 if ga_exact_void_return(Ast::Expr.Unary(TokenKind.Ampersand, Ast::Expr.Ident("void", at), at))
                        return 16 if ga_exact_void_return(Ast::Expr.Scope(Ast::Expr.Ident("Other", at), "void", at))
                        negative_one: Ast::Expr = Ast::Expr.Unary(TokenKind.Minus, Ast::Expr.IntLit(1, at), at)
                        upper_condition: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("n", at), TokenKind.Lt, Ast::Expr.IntLit(3, at), at)
                        lower_condition: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("n", at), TokenKind.Gt, Ast::Expr.IntLit(0, at), at)
                        decrement_by_negative: darray[Ast::Stmt] = [Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.PlusEq, negative_one, at)]
                        increment_by_negative: darray[Ast::Stmt] = [Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.MinusEq, negative_one, at)]
                        explicit_decrement_by_negative: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("n", at), TokenKind.Plus, negative_one, at)
                        explicit_increment_by_negative: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("n", at), TokenKind.Minus, negative_one, at)
                        explicit_upper_update: darray[Ast::Stmt] = [Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.LArrow, explicit_decrement_by_negative, at)]
                        explicit_lower_update: darray[Ast::Stmt] = [Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.LArrow, explicit_increment_by_negative, at)]
                        return 17 if not progress_moves_wrong_direction(upper_condition, decrement_by_negative, table)
                        return 18 if not progress_moves_wrong_direction(lower_condition, increment_by_negative, table)
                        return 19 if progress_moves_wrong_direction(lower_condition, decrement_by_negative, table)
                        return 20 if not progress_moves_wrong_direction(upper_condition, explicit_upper_update, table)
                        return 21 if not progress_moves_wrong_direction(lower_condition, explicit_lower_update, table)
                        minimum_payload: Ast::Expr = Ast::Expr.IntLit(0 - 9223372036854775807 - 1, at)
                        oversized_positive_payload: Ast::Expr = Ast::Expr.IntLit(0 - 1, at)
                        negative_minimum: Ast::Expr = Ast::Expr.Unary(TokenKind.Minus, minimum_payload, at)
                        minimum_payload_sign: (known: bool, sign: i64) = progress_literal_step_sign(minimum_payload)
                        negative_minimum_sign: (known: bool, sign: i64) = progress_literal_step_sign(negative_minimum)
                        oversized_positive_sign: (known: bool, sign: i64) = progress_literal_step_sign(oversized_positive_payload)
                        negative_one_sign: (known: bool, sign: i64) = progress_literal_step_sign(negative_one)
                        return 22 if minimum_payload_sign.known
                        return 23 if negative_minimum_sign.known
                        return 24 if oversized_positive_sign.known
                        return 25 if not negative_one_sign.known or negative_one_sign.sign != (0 - 1)
                        zero_step: Ast::Expr = Ast::Expr.IntLit(0, at)
                        zero_update: darray[Ast::Stmt] @source = [Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.PlusEq, zero_step, at)]
                        zero_step_result: (known: bool, sign: i64) = progress_literal_step_sign(zero_step)
                        return 26 if not zero_step_result.known or zero_step_result.sign != 0
                        return 27 if not progress_moves_wrong_direction(upper_condition, zero_update, table)
                        condition_names: darray[sview] = ["n"]
                        plain_binding_value: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("n", at), TokenKind.Plus, Ast::Expr.IntLit(1, at), at)
                        plain_binding: darray[Ast::Stmt] @source = [Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.Assign, plain_binding_value, at)]
                        return 28 if progress_body_assigns_any(plain_binding, condition_names, table)
                        shadowed_update: darray[Ast::Stmt] @source = [
                            Ast::Stmt.VarDecl("n", Ast::Expr.Ident("i64", at), Ast::Expr.IntLit(0, at), at),
                            Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.PlusEq, Ast::Expr.IntLit(1, at), at)
                        ]
                        return 29 if progress_body_assigns_any(shadowed_update, condition_names, table)
                        return 30 if progress_moves_wrong_direction(upper_condition, shadowed_update, table)
                        wrong_match_arm_body: darray[Ast::Stmt] @source = [Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.MinusEq, Ast::Expr.IntLit(1, at), at)]
                        wrong_match_arms: darray[Ast::MatchArm] @source = [Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: wrong_match_arm_body, guard: Ast::Expr.Absent, pos: at}]
                        wrong_match_body: darray[Ast::Stmt] @source = [Ast::Stmt.Match(Ast::Expr.Ident("choice", at), wrong_match_arms, at)]
                        return 31 if not progress_body_assigns_any(wrong_match_body, condition_names, table)
                        return 32 if not progress_moves_wrong_direction(upper_condition, wrong_match_body, table)
                        hatch_arm_body: darray[Ast::Stmt] @source = [Ast::Stmt.Block("can", ["Progress.Tick"], "", [], at)]
                        hatch_arms: darray[Ast::MatchArm] @source = [Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: hatch_arm_body, guard: Ast::Expr.Absent, pos: at}]
                        hatch_match_body: darray[Ast::Stmt] @source = [Ast::Stmt.Match(Ast::Expr.Ident("choice", at), hatch_arms, at)]
                        return 33 if not progress_has_evidence_block(hatch_match_body, table)
                        guarded_hatch_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("selected"), body: hatch_arm_body, guard: Ast::Expr.Ident("condition", at), pos: at}
                        no_hatch_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [], guard: Ast::Expr.Absent, pos: at}
                        mixed_hatch_arms: darray[Ast::MatchArm] @source = [guarded_hatch_arm, no_hatch_arm]
                        mixed_hatch_match_body: darray[Ast::Stmt] @source = [Ast::Stmt.Match(Ast::Expr.Ident("choice", at), mixed_hatch_arms, at)]
                        return 34 if progress_has_evidence_block(mixed_hatch_match_body, table)
                        nonempty_for_body: darray[Ast::Stmt] @source = [Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.PlusEq, Ast::Expr.IntLit(1, at), at)]
                        nested_for: darray[Ast::Stmt] @source = [Ast::Stmt.For("", ["j"], Ast::Expr.Array([], at), nonempty_for_body, at)]
                        return 35 if progress_body_assigns_any(nested_for, condition_names, table)
                        return 36 if progress_moves_wrong_direction(upper_condition, nested_for, table)
                        projected_target: Ast::Expr = Ast::Expr.Field(Ast::Expr.Ident("n", at), "field", at)
                        projected_store: darray[Ast::Stmt] @source = [Ast::Stmt.Assign(projected_target, TokenKind.Assign, Ast::Expr.IntLit(1, at), at)]
                        return 37 if progress_body_assigns_any(projected_store, condition_names, table)
                        return 38 if progress_moves_wrong_direction(upper_condition, projected_store, table)
                        mixed_if: darray[Ast::Stmt] @source = [Ast::Stmt.If(Ast::Expr.Ident("condition", at), [Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.PlusEq, Ast::Expr.IntLit(1, at), at)], [Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.PlusEq, negative_one, at)], at)]
                        return 39 if not progress_body_assigns_any(mixed_if, condition_names, table)
                        return 40 if not progress_moves_wrong_direction(upper_condition, mixed_if, table)
                        waiting_branch: darray[Ast::Stmt] @source = [Ast::Stmt.If(Ast::Expr.Ident("condition", at), [Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.PlusEq, Ast::Expr.IntLit(1, at), at)], [], at)]
                        return 55 if not progress_moves_wrong_direction(upper_condition, waiting_branch, table)
                        literal_good_if: darray[Ast::Stmt] @source = [Ast::Stmt.If(Ast::Expr.BoolLit(true, at), [Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.PlusEq, Ast::Expr.IntLit(1, at), at)], [Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.PlusEq, negative_one, at)], at)]
                        return 41 if not progress_body_assigns_any(literal_good_if, condition_names, table)
                        return 42 if progress_moves_wrong_direction(upper_condition, literal_good_if, table)
                        literal_hatch_if: darray[Ast::Stmt] @source = [Ast::Stmt.If(Ast::Expr.BoolLit(true, at), hatch_arm_body, [], at)]
                        return 43 if not progress_has_evidence_block(literal_hatch_if, table)
                        unknown_hatch_if: darray[Ast::Stmt] @source = [Ast::Stmt.If(Ast::Expr.Ident("condition", at), hatch_arm_body, [], at)]
                        return 44 if progress_has_evidence_block(unknown_hatch_if, table)
                        empty_if_then_update: darray[Ast::Stmt] @source = [
                            Ast::Stmt.If(Ast::Expr.Ident("condition", at), [], [], at),
                            Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.PlusEq, Ast::Expr.IntLit(1, at), at)
                        ]
                        return 45 if not progress_body_assigns_any(empty_if_then_update, condition_names, table)
                        return 46 if progress_moves_wrong_direction(upper_condition, empty_if_then_update, table)
                        empty_if_then_hatch: darray[Ast::Stmt] @source = [Ast::Stmt.If(Ast::Expr.Ident("condition", at), [], [], at), Ast::Stmt.Block("can", ["Progress.Tick"], "", [], at)]
                        return 47 if not progress_has_evidence_block(empty_if_then_hatch, table)
                        canceling_updates: darray[Ast::Stmt] @source = [
                            Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.PlusEq, Ast::Expr.IntLit(1, at), at),
                            Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.MinusEq, Ast::Expr.IntLit(1, at), at)
                        ]
                        return 48 if not progress_moves_wrong_direction(upper_condition, canceling_updates, table)
                        return_arm: darray[Ast::Stmt] @source = [Ast::Stmt.Return(Ast::Expr.IntLit(0, at), at)]
                        return_or_increment: darray[Ast::Stmt] @source = [Ast::Stmt.If(Ast::Expr.Ident("condition", at), return_arm, [Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.PlusEq, Ast::Expr.IntLit(1, at), at)], at)]
                        return 49 if progress_moves_wrong_direction(upper_condition, return_or_increment, table)
                        break_or_decrement: darray[Ast::Stmt] @source = [Ast::Stmt.If(Ast::Expr.Ident("condition", at), [Ast::Stmt.Break("", at)], [Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.MinusEq, Ast::Expr.IntLit(1, at), at)], at)]
                        return 50 if not progress_moves_wrong_direction(upper_condition, break_or_decrement, table)
                        return_only: darray[Ast::Stmt] @source = [Ast::Stmt.Return(Ast::Expr.IntLit(0, at), at)]
                        return_only_summary: (all_loop_paths_covered: bool, has_looping_path: bool) = progress_body_evidence_summary(return_only, table)
                        return 51 if not return_only_summary.all_loop_paths_covered or return_only_summary.has_looping_path
                        hatch_after_conditional_exit: darray[Ast::Stmt] @source = [Ast::Stmt.If(Ast::Expr.Ident("condition", at), return_arm, hatch_arm_body, at)]
                        return 52 if not progress_has_evidence_block(hatch_after_conditional_exit, table)
                        continue_then_increment: darray[Ast::Stmt] @source = [
                            Ast::Stmt.Continue("", at),
                            Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.PlusEq, Ast::Expr.IntLit(1, at), at)
                        ]
                        return 53 if progress_body_assigns_any(continue_then_increment, condition_names, table)
                        return 54 if progress_moves_wrong_direction(upper_condition, continue_then_increment, table)
                        return 56 if progress_body_has_decreases(return_only)
                        return_then_unreachable_hatch: darray[Ast::Stmt] @source = [Ast::Stmt.Return(Ast::Expr.IntLit(0, at), at), Ast::Stmt.Block("can", ["Progress.Tick"], "", [], at)]
                        return 57 if progress_body_has_decreases(return_then_unreachable_hatch)
                        return 58 if progress_body_has_decreases(hatch_arm_body)
                        right_bound_condition: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("n", at), TokenKind.Lt, Ast::Expr.Ident("limit", at), at)
                        right_bound_update: darray[Ast::Stmt] @source = [Ast::Stmt.Assign(Ast::Expr.Ident("limit", at), TokenKind.PlusEq, Ast::Expr.IntLit(1, at), at)]
                        right_subject_names: mutable darray[sview] = []
                        right_bound_names: mutable darray[sview] = []
                        right_bound_shape: (supported_subject: bool, supported_bound: bool) = progress_condition_names(right_bound_condition, right_subject_names, right_bound_names)
                        return 59 if not right_bound_shape.supported_subject or not right_bound_shape.supported_bound
                        return 60 if progress_body_assigns_any(right_bound_update, right_subject_names, table)
                        return 61 if not progress_body_assigns_any(right_bound_update, right_bound_names, table)
                        right_bound_only_loop: darray[Ast::Stmt] @source = [Ast::Stmt.While(right_bound_condition, right_bound_update, at)]
                        right_bound_table: mutable SymbolTable = SymbolTable(false)
                        right_bound_table <- progress_safety_statements(right_bound_only_loop, right_bound_table)
                        return 62 if right_bound_table.diagnostics.count != 1
                        safe_subject_update: darray[Ast::Stmt] @source = [Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.PlusEq, Ast::Expr.IntLit(1, at), at)]
                        safe_bound_loop: darray[Ast::Stmt] @source = [Ast::Stmt.While(right_bound_condition, safe_subject_update, at)]
                        safe_bound_table: mutable SymbolTable = SymbolTable(false)
                        safe_bound_table <- progress_safety_statements(safe_bound_loop, safe_bound_table)
                        return 63 if safe_bound_table.diagnostics.count != 0
                        match_nested_loop: darray[Ast::Stmt] @source = [Ast::Stmt.While(Ast::Expr.BoolLit(true, at), [], at)]
                        match_nested_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: match_nested_loop, guard: Ast::Expr.Absent, pos: at}
                        match_nested_body: darray[Ast::Stmt] @source = [Ast::Stmt.Match(Ast::Expr.Ident("choice", at), [match_nested_arm], at)]
                        match_nested_table: mutable SymbolTable = SymbolTable(false)
                        match_nested_table <- progress_safety_statements(match_nested_body, match_nested_table)
                        return 64 if match_nested_table.diagnostics.count != 1
                        dead_nested_body: darray[Ast::Stmt] @source = [Ast::Stmt.If(Ast::Expr.BoolLit(false, at), match_nested_loop, [], at)]
                        dead_nested_table: mutable SymbolTable = SymbolTable(false)
                        dead_nested_table <- progress_safety_statements(dead_nested_body, dead_nested_table)
                        return 65 if dead_nested_table.diagnostics.count != 0
                        recursive_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("cycle", at), [], [], at)
                        recursive_return: darray[Ast::Stmt] @source = [Ast::Stmt.Return(recursive_call, at)]
                        recursive_match_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: recursive_return, guard: Ast::Expr.Absent, pos: at}
                        recursive_match_expr: Ast::Expr = Ast::Expr.Match(Ast::Expr.Ident("choice", at), [recursive_match_arm], at)
                        recursive_match_body: darray[Ast::Stmt] @source = [Ast::Stmt.Expr(recursive_match_expr, at)]
                        recursive_names: mutable darray[sview] = []
                        progress_zero_arg_calls_body(recursive_match_body, recursive_names, table)
                        return 66 if not any callee in recursive_names where callee == "cycle"
                        dead_recursive_if: darray[Ast::Stmt] @source = [Ast::Stmt.If(Ast::Expr.BoolLit(false, at), [Ast::Stmt.Expr(recursive_call, at)], [], at)]
                        dead_recursive_names: mutable darray[sview] = []
                        progress_zero_arg_calls_body(dead_recursive_if, dead_recursive_names, table)
                        return 67 if any callee in dead_recursive_names where callee == "cycle"
                        recursive_after_return: darray[Ast::Stmt] @source = [Ast::Stmt.Return(Ast::Expr.IntLit(0, at), at), Ast::Stmt.Expr(recursive_call, at)]
                        unreachable_recursive_names: mutable darray[sview] = []
                        progress_zero_arg_calls_body(recursive_after_return, unreachable_recursive_names, table)
                        return 68 if any callee in unreachable_recursive_names where callee == "cycle"
                        zero_trip_hatch_cycle_body: darray[Ast::Stmt] @source = [Ast::Stmt.Block("can", ["Progress.Tick"], "", [Ast::Stmt.Expr(recursive_call, at)], at)]
                        zero_trip_hatch_loop: darray[Ast::Stmt] @source = [Ast::Stmt.While(Ast::Expr.BoolLit(false, at), zero_trip_hatch_cycle_body, at)]
                        zero_trip_hatch_loop_names: mutable darray[sview] = []
                        progress_zero_arg_calls_body(zero_trip_hatch_loop, zero_trip_hatch_loop_names, table)
                        return 69 if zero_trip_hatch_loop_names.count != 0
                        zero_trip_hatch_for: darray[Ast::Stmt] @source = [Ast::Stmt.For("", ["item"], Ast::Expr.Array([], at), zero_trip_hatch_cycle_body, at)]
                        zero_trip_hatch_for_names: mutable darray[sview] = []
                        progress_zero_arg_calls_body(zero_trip_hatch_for, zero_trip_hatch_for_names, table)
                        return 70 if zero_trip_hatch_for_names.count != 0
                        return_only_loop: darray[Ast::Stmt] @source = [Ast::Stmt.While(Ast::Expr.Ident("flag", at), return_only, at)]
                        return_only_loop_table: mutable SymbolTable = SymbolTable(false)
                        return_only_loop_table <- progress_safety_statements(return_only_loop, return_only_loop_table)
                        return 71 if return_only_loop_table.diagnostics.count != 0
                        break_only_loop: darray[Ast::Stmt] @source = [Ast::Stmt.While(Ast::Expr.Ident("flag", at), [Ast::Stmt.Break("", at)], at)]
                        break_only_loop_table: mutable SymbolTable = SymbolTable(false)
                        break_only_loop_table <- progress_safety_statements(break_only_loop, break_only_loop_table)
                        return 72 if break_only_loop_table.diagnostics.count != 0
                        continue_only_loop: darray[Ast::Stmt] @source = [Ast::Stmt.While(Ast::Expr.Ident("flag", at), [Ast::Stmt.Continue("", at)], at)]
                        continue_only_loop_table: mutable SymbolTable = SymbolTable(false)
                        continue_only_loop_table <- progress_safety_statements(continue_only_loop, continue_only_loop_table)
                        return 73 if continue_only_loop_table.diagnostics.count != 1
                        branch_hatch_cycle_body: darray[Ast::Stmt] @source = [Ast::Stmt.If(Ast::Expr.Ident("choose", at), hatch_arm_body, [Ast::Stmt.Expr(recursive_call, at)], at)]
                        branch_hatch_cycle_names: mutable darray[sview] = []
                        branch_hatch_cycle_protection: mutable darray[bool] = []
                        branch_hatch_uncovered: mutable bool = true
                        branch_hatch_covered: mutable bool = false
                        progress_collect_zero_arg_calls_body(branch_hatch_cycle_body, branch_hatch_cycle_names, branch_hatch_cycle_protection, branch_hatch_uncovered, branch_hatch_covered, table)
                        return 74 if branch_hatch_cycle_names.count != 1 or branch_hatch_cycle_protection.count != 1
                        return 75 if branch_hatch_cycle_protection[0]
                        branch_hatch_decls: darray[Ast::Decl] @source = [Ast::Decl.Func("cycle", [], null, branch_hatch_cycle_body, [], [], at)]
                        branch_hatch_table: mutable SymbolTable = SymbolTable(false)
                        branch_hatch_table <- progress_recursive_cycles(branch_hatch_decls, branch_hatch_table)
                        return 82 if branch_hatch_table.diagnostics.count != 1
                        return 86 if not any callee in branch_hatch_cycle_names where callee == "cycle"
                        protected_recursive_body: darray[Ast::Stmt] @source = [Ast::Stmt.Block("can", ["Progress.Tick"], "", [Ast::Stmt.Expr(recursive_call, at)], at)]
                        protected_recursive_names: mutable darray[sview] = []
                        protected_recursive_edges: mutable darray[bool] = []
                        protected_recursive_uncovered: mutable bool = true
                        protected_recursive_covered: mutable bool = false
                        progress_collect_zero_arg_calls_body(protected_recursive_body, protected_recursive_names, protected_recursive_edges, protected_recursive_uncovered, protected_recursive_covered, table)
                        return 83 if protected_recursive_names.count != 1 or protected_recursive_edges.count != 1
                        return 84 if not protected_recursive_edges[0]
                        protected_recursive_decls: darray[Ast::Decl] @source = [Ast::Decl.Func("cycle", [], null, protected_recursive_body, [], [], at)]
                        protected_recursive_table: mutable SymbolTable = SymbolTable(false)
                        protected_recursive_table <- progress_recursive_cycles(protected_recursive_decls, protected_recursive_table)
