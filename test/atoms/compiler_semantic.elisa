                            Ast::MatchArm{pattern: Ast::Pattern.Binding("success"), body: [], guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Variant("First::Fault.Busy", []), body: [], guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Variant("Second::Fault.Known", []), body: [], guard: Ast::Expr.Absent, pos: at}
                        ]
                        return 196 if progress_catch_error_arms_total_at(missing_second_allowed_subset_arms, scoped_subset_catch_table, 2)
                        qualified_family_catch_table: mutable SymbolTable = SymbolTable(false)
                        qualified_family_catch_table.enum_variant_owner.push("Fault")
                        qualified_family_catch_table.enum_variant_name.push("Bad")
                        qualified_family_catch_table.enum_variant_module.push("Outer::Caller")
                        qualified_family_catch_table.enum_variant_owner.push("Fault")
                        qualified_family_catch_table.enum_variant_name.push("Good")
                        qualified_family_catch_table.enum_variant_module.push("Outer::Provider")
                        qualified_family_catch_table.protocol_annotations.push(Ast::EnumAnnotation{owner: "load", name: "__lsp_func_name", line: 1, offset: 1})
                        qualified_family_catch_table.protocol_annotations.push(Ast::EnumAnnotation{owner: "load", name: "__error_return", line: 1, offset: 1})
                        qualified_family_catch_table.protocol_annotations.push(Ast::EnumAnnotation{owner: "__fn_module", name: "Outer::Caller", line: 1, offset: 1})
                        qualified_family_catch_table.protocol_annotations.push(Ast::EnumAnnotation{owner: "__error_set_family", name: "Fault", line: 1, offset: 1})
                        qualified_family_catch_table.protocol_annotations.push(Ast::EnumAnnotation{owner: "__error_set_family_path", name: "Outer \"\"\" path trivia \"\"\" :: Provider :: Fault", line: 1, offset: 1})
                        qualified_family_catch_table.protocol_annotations.push(Ast::EnumAnnotation{owner: "load", name: "__catch_expr", line: 2, offset: 2})
                        qualified_family_catch_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Binding("success"), body: [], guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Variant("Peer::Provider::Fault.Good", []), body: [], guard: Ast::Expr.Absent, pos: at}
                        ]
                        return 183 if not progress_catch_error_arms_total_at(qualified_family_catch_arms, qualified_family_catch_table, 2)
                        wrong_declared_family_catch_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Binding("success"), body: [], guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Variant("Peer::Provider::Fault.Bad", []), body: [], guard: Ast::Expr.Absent, pos: at}
                        ]
                        return 184 if progress_catch_error_arms_total_at(wrong_declared_family_catch_arms, qualified_family_catch_table, 2)
                        error_typebind_match_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: error_typebind, body: [], guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [], guard: Ast::Expr.Absent, pos: at}
                        ]
                        return 132 if not progress_match_arm_reachable(Ast::Expr.Ident("value", at), error_typebind_match_arms, 1)
                        integer_total_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Literal("1"), body: [], guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Literal("2"), body: [], guard: Ast::Expr.Absent, pos: at}
                        ]
                        return 160 if not progress_match_is_total(Ast::Expr.IntLit(2, at), integer_total_arms, table)
                        return 161 if progress_match_is_total(Ast::Expr.IntLit(3, at), integer_total_arms, table)
                        integer_guarded_total_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Literal("2"), body: [], guard: Ast::Expr.BoolLit(false, at), pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Literal("2"), body: [], guard: Ast::Expr.Absent, pos: at}
                        ]
                        return 162 if not progress_match_is_total(Ast::Expr.Unary(TokenKind.Minus, Ast::Expr.IntLit(2, at), at), [Ast::MatchArm{pattern: Ast::Pattern.Literal("-2"), body: [], guard: Ast::Expr.Absent, pos: at}], table)
                        return 163 if not progress_match_is_total(Ast::Expr.IntLit(2, at), integer_guarded_total_arms, table)
                        dynamic_both_advance_if: darray[Ast::Stmt] @source = [Ast::Stmt.If(Ast::Expr.Ident("choose", at), [Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.PlusEq, Ast::Expr.IntLit(1, at), at)], [Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.PlusEq, Ast::Expr.IntLit(2, at), at)], at)]
                        dynamic_both_advance_loop: darray[Ast::Stmt] @source = [Ast::Stmt.While(upper_condition, dynamic_both_advance_if, at)]
                        dynamic_both_advance_table: mutable SymbolTable = SymbolTable(false)
                        dynamic_both_advance_table <- progress_safety_statements(dynamic_both_advance_loop, dynamic_both_advance_table)
                        return 133 if any diagnostic in dynamic_both_advance_table.diagnostics where diagnostic.kind == DiagnosticKind.ProgressNoEvidence
                        dynamic_lower_condition: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("n", at), TokenKind.Gt, Ast::Expr.Ident("limit", at), at)
                        dynamic_both_decrement_if: darray[Ast::Stmt] @source = [Ast::Stmt.If(Ast::Expr.Ident("choose", at), [Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.MinusEq, Ast::Expr.IntLit(1, at), at)], [Ast::Stmt.Assign(Ast::Expr.Ident("n", at), TokenKind.MinusEq, Ast::Expr.IntLit(2, at), at)], at)]
                        dynamic_both_decrement_loop: darray[Ast::Stmt] @source = [Ast::Stmt.While(dynamic_lower_condition, dynamic_both_decrement_if, at)]
                        dynamic_both_decrement_table: mutable SymbolTable = SymbolTable(false)
                        dynamic_both_decrement_table <- progress_safety_statements(dynamic_both_decrement_loop, dynamic_both_decrement_table)
                        return 134 if any diagnostic in dynamic_both_decrement_table.diagnostics where diagnostic.kind == DiagnosticKind.ProgressNoEvidence

                        # Distinct error sets with the same leaf owner in separate modules
                        # must keep their identities when a bare variant is diagnosed.
                        ambiguous_variant_table: mutable SymbolTable = SymbolTable(false)
                        ambiguous_variant_table.enum_variant_owner <- ambiguous_variant_table.enum_variant_owner.push("Fault")
                        ambiguous_variant_table.enum_variant_name <- ambiguous_variant_table.enum_variant_name.push("Shared")
                        ambiguous_variant_table.enum_variant_module <- ambiguous_variant_table.enum_variant_module.push("Left")
                        ambiguous_variant_table.enum_variant_owner <- ambiguous_variant_table.enum_variant_owner.push("Fault")
                        ambiguous_variant_table.enum_variant_name <- ambiguous_variant_table.enum_variant_name.push("Shared")
                        ambiguous_variant_table.enum_variant_module <- ambiguous_variant_table.enum_variant_module.push("Right")
                        ambiguous_variant_table.enum_variant_owner <- ambiguous_variant_table.enum_variant_owner.push("Fault")
                        ambiguous_variant_table.enum_variant_name <- ambiguous_variant_table.enum_variant_name.push("Shared")
                        ambiguous_variant_table.enum_variant_module <- ambiguous_variant_table.enum_variant_module.push("Left")
                        ambiguous_variant_annotations: darray[Ast::EnumAnnotation] @source = [
                            Ast::EnumAnnotation{owner: "__error_set_family", name: "Shared", line: 1, offset: 1, identity_id: 7},
                            Ast::EnumAnnotation{owner: "__error_set_family_path", name: "Shared", line: 1, offset: 1, identity_id: 7}
                        ]
                        ambiguous_variant_file: Ast::File = empty_file{enum_annotations = ambiguous_variant_annotations}
                        ambiguous_variant_table <- check_ambiguous_error_variant(&ambiguous_variant_file, ambiguous_variant_table)
                        return 9911 if ambiguous_variant_table.diagnostics.count != 1
                        return 9912 if ambiguous_variant_table.diagnostics[0].kind != DiagnosticKind.AmbiguousErrorVariant
                        return 9913 if ambiguous_variant_table.diagnostics[0].expected != "Left::Fault" or ambiguous_variant_table.diagnostics[0].actual != "Right::Fault"
                        qualified_variant_table: mutable SymbolTable = SymbolTable(false)
                        qualified_variant_table.enum_variant_owner <- qualified_variant_table.enum_variant_owner.push("FirstFault")
                        qualified_variant_table.enum_variant_name <- qualified_variant_table.enum_variant_name.push("Shared")
                        qualified_variant_table.enum_variant_module <- qualified_variant_table.enum_variant_module.push("Left")
                        qualified_variant_table.enum_variant_owner <- qualified_variant_table.enum_variant_owner.push("SecondFault")
                        qualified_variant_table.enum_variant_name <- qualified_variant_table.enum_variant_name.push("Shared")
                        qualified_variant_table.enum_variant_module <- qualified_variant_table.enum_variant_module.push("Right")
                        qualified_variant_annotations: darray[Ast::EnumAnnotation] @source = [
                            Ast::EnumAnnotation{owner: "__error_set_family", name: "Shared", line: 1, offset: 2, identity_id: 8},
                            Ast::EnumAnnotation{owner: "__error_set_family_path", name: "Shared", line: 1, offset: 2, identity_id: 8},
                            Ast::EnumAnnotation{owner: "__error_set_family", name: "Shared", line: 1, offset: 2, identity_id: 8},
                            Ast::EnumAnnotation{owner: "__error_set_family_path", name: "Right::Shared", line: 1, offset: 2, identity_id: 8}
                        ]
                        qualified_variant_file: Ast::File = empty_file{enum_annotations = qualified_variant_annotations}
                        qualified_variant_table <- check_ambiguous_error_variant(&qualified_variant_file, qualified_variant_table)
                        return 9914 if qualified_variant_table.diagnostics.count != 1
                        qualified_variant_reverse_annotations: darray[Ast::EnumAnnotation] @source = [
                            Ast::EnumAnnotation{owner: "__error_set_family", name: "Shared", line: 1, offset: 2, identity_id: 8},
                            Ast::EnumAnnotation{owner: "__error_set_family_path", name: "Right::Shared", line: 1, offset: 2, identity_id: 8},
                            Ast::EnumAnnotation{owner: "__error_set_family", name: "Shared", line: 1, offset: 2, identity_id: 8},
                            Ast::EnumAnnotation{owner: "__error_set_family_path", name: "Shared", line: 1, offset: 2, identity_id: 8}
                        ]
                        qualified_variant_reverse_file: Ast::File = empty_file{enum_annotations = qualified_variant_reverse_annotations}
                        qualified_variant_table.diagnostics <- []
                        qualified_variant_table <- check_ambiguous_error_variant(&qualified_variant_reverse_file, qualified_variant_table)
                        return 9915 if qualified_variant_table.diagnostics.count != 1
                        return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_atom_probe() can Global{Read,Write}
