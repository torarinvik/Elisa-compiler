extend Semantic:
    public:
        def compiler_atom_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    node_store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in node_store:
include "./compiler_semantic_cases_scope.elisa"
include "./compiler_semantic_cases_control.elisa"
include "./compiler_semantic_cases_errors.elisa"

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_atom_probe() can Global{Read,Write}
