extend Semantic:
    public:
        def or_constants_parser_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                # Source-owned bytes exercise the parser's explicit @source contract.
                # const FIRST: u32 = 1; const SECOND: u32 = 2
                # return match value: FIRST or SECOND: 1; _: 0
                source_bytes: darray[u8] @source = [
                    99, 111, 110, 115, 116, 32, 70, 73, 82, 83, 84, 58, 32, 117, 51, 50, 32, 61,
                    32, 49, 10, 99, 111, 110, 115, 116, 32, 83, 69, 67, 79, 78, 68, 58, 32, 117,
                    51, 50, 32, 61, 32, 50, 10, 100, 101, 102, 32, 99, 104, 111, 111, 115, 101, 40,
                    118, 97, 108, 117, 101, 58, 32, 117, 51, 50, 41, 32, 45, 62, 32, 105, 51, 50,
                    58, 10, 32, 32, 32, 32, 114, 101, 116, 117, 114, 110, 32, 109, 97, 116, 99, 104,
                    32, 118, 97, 108, 117, 101, 58, 10, 32, 32, 32, 32, 32, 32, 32, 32, 70, 73,
                    82, 83, 84, 32, 111, 114, 32, 83, 69, 67, 79, 78, 68, 58, 32, 49, 10, 32,
                    32, 32, 32, 32, 32, 32, 32, 95, 58, 32, 48, 10
                ]
                source: u8& @source = &source_bytes[0]
                tokens: darray[Token] = frontend_tokenize_with_length(source, source, source_bytes.count)
                file: Ast::File = frontend_parser_parse_file_with_length(source, source_bytes.count, tokens)
                return 3 if file.errors.count != 0
                return 4 if file.or_arm_binding_lines.count != 1 or file.or_arm_binding_patterns.count != 1
                match file.or_arm_binding_patterns[0]:
                    Pattern.Or(options):
                        return 5 if options.count != 2
                    _:
                        return 6
                return 0

        def or_constants_atom_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    node_store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in node_store:
                        at: Ast::Pos = Ast::Pos{line: 10, column: 9, offset: 0, end_line: 10, end_column: 14, end_offset: 5}
                        declarations: darray[Ast::Decl] @source = [
                            Ast::Decl.Const("FIRST", Ast::Expr.Ident("u32", at), Ast::Expr.IntLit(1, at), false, at),
                            Ast::Decl.Const("SECOND", Ast::Expr.Ident("u32", at), Ast::Expr.IntLit(2, at), false, at)
                        ]
                        annotations: darray[Ast::EnumAnnotation] = []
                        table: mutable SymbolTable = SymbolTable(false)
                        table <- collect_range(declarations, table, annotations)
                        pattern: Ast::Pattern = Ast::Pattern.Or([Ast::Pattern.Binding("FIRST"), Ast::Pattern.Binding("SECOND")])
                        arms: darray[Ast::MatchArm] = [Ast::MatchArm{pattern: pattern, body: [], guard: Ast::Expr.Absent, pos: at}]
                        names: darray[sview] = []
                        types: darray[sview @source] = []
                        table <- check_scalar_match_arm_types(Ast::Expr.IntLit(1, at), arms, 9, names, types, table)
                        empty_file: Ast::File = zeroed
                        file: Ast::File = empty_file{or_arm_binding_lines = [10], or_arm_binding_columns = [9], or_arm_binding_end_columns = [14], or_arm_binding_patterns = [pattern]}
                        table <- report_recorded_or_arm_bindings(&file, table)
                        return 1 if table.diagnostics.count != 0
                        shadow_pattern: Ast::Pattern = Ast::Pattern.Or([Ast::Pattern.Binding("FIRST"), Ast::Pattern.Binding("SECOND")])
                        shadow_arms: darray[Ast::MatchArm] = [Ast::MatchArm{pattern: shadow_pattern, body: [], guard: Ast::Expr.Absent, pos: at}]
                        shadow_names: darray[sview] = ["FIRST"]
                        shadow_types: darray[sview @source] = ["u32"]
                        table <- check_scalar_match_arm_types(Ast::Expr.IntLit(1, at), shadow_arms, 9, shadow_names, shadow_types, table)
                        shadow_file: Ast::File = empty_file{or_arm_binding_lines = [10], or_arm_binding_columns = [9], or_arm_binding_end_columns = [14], or_arm_binding_patterns = [shadow_pattern]}
                        table <- report_recorded_or_arm_bindings(&shadow_file, table)
                        found: mutable bool = false
                        for diagnostic in table.diagnostics |found|:
                            found <- true if diagnostic.kind == DiagnosticKind.TopLevelOrPatternBindsNames and diagnostic.line == 10 and diagnostic.pos.column == 9
                        return 2 if not found
                        legacy_file: Ast::File = empty_file{or_arm_binding_lines = [20], or_arm_binding_columns = [7], or_arm_binding_end_columns = [12]}
                        legacy_table: mutable SymbolTable = SymbolTable(false)
                        legacy_table <- report_recorded_or_arm_bindings(&legacy_file, legacy_table)
                        return 7 if legacy_table.diagnostics.count != 1
                        return 8 if legacy_table.diagnostics[0].kind != DiagnosticKind.TopLevelOrPatternBindsNames
                        return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    parsed: i32 = Semantic::or_constants_parser_probe() can Global{Read,Write}
    return parsed if parsed != 0
    return Semantic::or_constants_atom_probe() can Global{Read,Write}
