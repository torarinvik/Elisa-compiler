extend Semantic:
    public:
        def compiler_holder_scalar_view_iteration_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                bytes: Ast::Expr = Ast::Expr.Ident("bytes", at)
                view_value: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(bytes, "as_sview", at), [], [], at)
                holder: Ast::Expr = Ast::Expr.Ident("holder", at)
                borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                byte: Ast::Expr = Ast::Expr.Ident("byte", at)
                store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [holder, byte], ["", ""], at)
                declaration: Ast::Stmt = Ast::Stmt.VarDecl("view", Ast::Expr.Ident("sview", at), view_value, at)
                loop: Ast::Stmt = Ast::Stmt.For("", ["byte"], Ast::Expr.Ident("view", at), [Ast::Stmt.Expr(store, at)], at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "bytes", true, false, false)
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder"]
                binders: darray[sview] = []
                owned: darray[sview] = []
                view_names: darray[sview] = ["view"]
                view_values: darray[Ast::Expr] = [view_value]
                summary: StoreThroughSummary = zeroed
                table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements([declaration, loop], false, ref_params, binders, owned, view_names, view_values, &flow, summary, table_diagnostics, table)
                return false if table_diagnostics.count != 0

                scalar_byte: Ast::Expr = Ast::Expr.Ident("scalar_byte", at)
                scalar_saved: Ast::Expr = Ast::Expr.Ident("scalar_saved", at)
                scalar_comprehension: Ast::Expr = Ast::Expr.Comprehension("scalar_byte", view_value, Ast::Expr.Absent, scalar_byte, at, 0)
                scalar_declaration: Ast::Stmt = Ast::Stmt.VarDecl("scalar_saved", Ast::Expr.Absent, scalar_comprehension, at)
                scalar_store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [scalar_saved, borrowed], ["", ""], at)
                scalar_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(scalar_flow, "holder", false, false, true)
                chv_flow_bind(scalar_flow, "bytes", true, false, false)
                chv_flow_bind(scalar_flow, "borrowed", false, true, false)
                scalar_table: mutable SymbolTable = SymbolTable(false)
                scalar_summary: StoreThroughSummary = zeroed
                scalar_table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements([scalar_declaration, Ast::Stmt.Expr(scalar_store, at)], false, ref_params, binders, owned, view_names, view_values, &scalar_flow, scalar_summary, scalar_table_diagnostics, scalar_table)
                return false if scalar_table_diagnostics.count != 0

                scalar_views: Ast::Expr = Ast::Expr.Array([view_value], at)
                scalar_views_declaration: Ast::Stmt = Ast::Stmt.VarDecl("scalar_views", Ast::Expr.Absent, scalar_views, at)
                nested_view: Ast::Expr = Ast::Expr.Ident("nested_view", at)
                nested_byte: Ast::Expr = Ast::Expr.Ident("nested_byte", at)
                owned_view: Ast::Expr = Ast::Expr.Ident("owned_view", at)
                nested_store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [nested_byte, owned_view], ["", ""], at)
                nested_loop: Ast::Stmt = Ast::Stmt.For("", ["nested_byte"], nested_view, [Ast::Stmt.Expr(nested_store, at)], at)
                outer_loop: Ast::Stmt = Ast::Stmt.For("", ["nested_view"], Ast::Expr.Ident("scalar_views", at), [nested_loop], at)
                nested_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(nested_flow, "holder", false, false, true)
                chv_flow_bind(nested_flow, "bytes", true, false, false)
                chv_flow_bind(nested_flow, "owned_view", false, true, false)
                nested_table: mutable SymbolTable = SymbolTable(false)
                nested_summary: StoreThroughSummary = zeroed
                nested_table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements([declaration, scalar_views_declaration, outer_loop], false, ref_params, binders, owned, view_names, view_values, &nested_flow, nested_summary, nested_table_diagnostics, nested_table)
                return false if scalar_table_diagnostics.count != 0 or nested_table_diagnostics.count != 0

                text_declaration: Ast::Stmt = Ast::Stmt.VarDecl("text", Ast::Expr.Ident("dstr", at), Ast::Expr.StringLit("abc", at), at)
                text: Ast::Expr = Ast::Expr.Ident("text", at)
                inferred_slice: Ast::Expr = Ast::Expr.Slice(text, Ast::Expr.IntLit(0, at), Ast::Expr.IntLit(1, at), at)
                inferred_view_declaration: Ast::Stmt = Ast::Stmt.VarDecl("inferred_view", Ast::Expr.Absent, inferred_slice, at)
                inferred_byte: Ast::Expr = Ast::Expr.Ident("inferred_byte", at)
                inferred_store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [Ast::Expr.Ident("holder", at), inferred_byte], ["", ""], at)
                inferred_loop: Ast::Stmt = Ast::Stmt.For("", ["inferred_byte"], Ast::Expr.Ident("inferred_view", at), [Ast::Stmt.Expr(inferred_store, at)], at)
                inferred_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(inferred_flow, "holder", false, false, true)
                inferred_table: mutable SymbolTable = SymbolTable(false)
                inferred_summary: StoreThroughSummary = zeroed
                inferred_table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements([text_declaration, inferred_view_declaration, inferred_loop], false, ref_params, binders, owned, view_names, view_values, &inferred_flow, inferred_summary, inferred_table_diagnostics, inferred_table)
                inferred_view_index: usize = chv_flow_latest(inferred_flow, "inferred_view")
                return false if inferred_table_diagnostics.count != 0 or inferred_view_index >= inferred_flow.names.count or not inferred_flow.may_be_scalar_sview[inferred_view_index]

                # A slice of a typed collection keeps its element type. In this
                # case each outer element is an sview, and its inner iteration
                # yields scalar bytes rather than another borrowed view.
                views_type: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("darray", at), Ast::Expr.Ident("sview", at), at)
                views_value: Ast::Expr = Ast::Expr.Array([view_value], at)
                views_declaration: Ast::Stmt = Ast::Stmt.VarDecl("views", views_type, views_value, at)
                views_slice: Ast::Expr = Ast::Expr.Slice(Ast::Expr.Ident("views", at), Ast::Expr.IntLit(0, at), Ast::Expr.IntLit(1, at), at)
                view_slice_declaration: Ast::Stmt = Ast::Stmt.VarDecl("view_slice", Ast::Expr.Absent, views_slice, at)
                slice_view: Ast::Expr = Ast::Expr.Ident("slice_view", at)
                slice_byte: Ast::Expr = Ast::Expr.Ident("slice_byte", at)
                slice_store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [holder, slice_byte], ["", ""], at)
                slice_inner_loop: Ast::Stmt = Ast::Stmt.For("", ["slice_byte"], slice_view, [Ast::Stmt.Expr(slice_store, at)], at)
                slice_outer_loop: Ast::Stmt = Ast::Stmt.For("", ["slice_view"], Ast::Expr.Ident("view_slice", at), [slice_inner_loop], at)
                slice_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(slice_flow, "holder", false, false, true)
                chv_flow_bind(slice_flow, "bytes", true, false, false)
                slice_table: mutable SymbolTable = SymbolTable(false)
                slice_summary: StoreThroughSummary = zeroed
                slice_table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements([declaration, views_declaration, view_slice_declaration, slice_outer_loop], false, ref_params, binders, owned, view_names, view_values, &slice_flow, slice_summary, slice_table_diagnostics, slice_table)
                return slice_table_diagnostics.count == 0

        def compiler_holder_comprehension_filter_alias_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                alias_source: Ast::Expr = Ast::Expr.Ident("alias_source", at)
                item: Ast::Expr = Ast::Expr.Ident("item", at)
                payload: Ast::Expr = Ast::Expr.Ident("payload", at)
                borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                iterable: Ast::Expr = Ast::Expr.Array([alias_source], at)
                condition: Ast::Expr = Ast::Expr.Binary(item, TokenKind.Is, payload, at)
                comprehension: Ast::Expr = Ast::Expr.Comprehension("item", iterable, condition, payload, at, 0)
                saved: Ast::Expr = Ast::Expr.Ident("saved", at)
                declaration: Ast::Stmt = Ast::Stmt.VarDecl("saved", Ast::Expr.Absent, comprehension, at)
                store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [saved, borrowed], ["", ""], at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "alias_source", false, false, true)
                chv_flow_bind(flow, "borrowed", false, true, false)
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder"]
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                summary: StoreThroughSummary = zeroed
                table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements([declaration, Ast::Stmt.Expr(store, at)], false, ref_params, names, names, names, values, &flow, summary, table_diagnostics, table)
                return table_diagnostics.count == 1

        def compiler_holder_getelse_return_flow_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                holder: Ast::Expr = Ast::Expr.Ident("holder", at)
                safe_target: Ast::Expr = Ast::Expr.Ident("safe_target", at)
                borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                assign_target: Ast::Stmt = Ast::Stmt.Assign(safe_target, TokenKind.Assign, holder, at)
                return_statement: Ast::Stmt = Ast::Stmt.Return(Ast::Expr.Absent, at)
                get_else: Ast::Expr = Ast::Expr.GetElse(safe_target, [assign_target, return_statement], at)
                store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [safe_target, borrowed], ["", ""], at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "safe_target", false, false, false)
                chv_flow_bind(flow, "borrowed", false, true, false)
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder"]
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                summary: StoreThroughSummary = zeroed
                table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements([Ast::Stmt.Expr(get_else, at), Ast::Stmt.Expr(store, at)], false, ref_params, names, names, names, values, &flow, summary, table_diagnostics, table)
                return table_diagnostics.count == 0

        def compiler_holder_scalar_view_rebind_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                bytes: Ast::Expr = Ast::Expr.Ident("bytes", at)
                view: Ast::Expr = Ast::Expr.Ident("view", at)
                holder: Ast::Expr = Ast::Expr.Ident("holder", at)
                byte: Ast::Expr = Ast::Expr.Ident("byte", at)
                original_value: Ast::Expr = Ast::Expr.Array([Ast::Expr.IntLit(65, at)], at)
                view_value: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(bytes, "as_sview", at), [], [], at)
                rebind: Ast::Stmt = Ast::Stmt.Assign(view, TokenKind.LArrow, view_value, at)
                store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [holder, byte], ["", ""], at)
                loop: Ast::Stmt = Ast::Stmt.For("", ["byte"], view, [Ast::Stmt.Expr(store, at)], at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "bytes", true, false, false)
                chv_flow_bind(flow, "view", false, true, false)
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder"]
                binders: darray[sview] = []
                owned: darray[sview] = []
                view_names: darray[sview] = ["view"]
                view_values: darray[Ast::Expr] = [original_value]
                summary: StoreThroughSummary = zeroed
                table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements([rebind, loop], false, ref_params, binders, owned, view_names, view_values, &flow, summary, table_diagnostics, table)
                view_index: usize = chv_flow_latest(flow, "view")
                return table_diagnostics.count == 0 and view_index < flow.names.count and flow.may_be_scalar_sview[view_index]

        def compiler_holder_slice_sview_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                bytes: Ast::Expr = Ast::Expr.Ident("bytes", at)
                holder: Ast::Expr = Ast::Expr.Ident("holder", at)
                byte: Ast::Expr = Ast::Expr.Ident("byte", at)
                slice: Ast::Expr = Ast::Expr.Slice(bytes, Ast::Expr.IntLit(0, at), Ast::Expr.IntLit(1, at), at)
                declaration: Ast::Stmt = Ast::Stmt.VarDecl("view", Ast::Expr.Ident("sview", at), slice, at)
                store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [holder, byte], ["", ""], at)
                loop: Ast::Stmt = Ast::Stmt.For("", ["byte"], Ast::Expr.Ident("view", at), [Ast::Stmt.Expr(store, at)], at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "bytes", true, false, false)
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder"]
                binders: darray[sview] = []
                owned: darray[sview] = []
                view_names: darray[sview] = ["view"]
                view_values: darray[Ast::Expr] = [slice]
                summary: StoreThroughSummary = zeroed
                table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements([declaration, loop], false, ref_params, binders, owned, view_names, view_values, &flow, summary, table_diagnostics, table)
                return table_diagnostics.count == 0

        def compiler_holder_branch_comprehension_assignment_case(destructure: bool) -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                alias_source: Ast::Expr = Ast::Expr.Ident("alias_source", at)
                iterable: Ast::Expr = Ast::Expr.Array([alias_source], at)
                item: Ast::Expr = Ast::Expr.Ident("item", at)
                comprehension: Ast::Expr = Ast::Expr.Comprehension("item", iterable, Ast::Expr.Absent, item, at, 0)
                saved: Ast::Expr = Ast::Expr.Ident("saved", at)
                safe_saved: Ast::Expr = Ast::Expr.Ident("safe_saved", at)
                borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                empty: Ast::Expr = Ast::Expr.Array([], at)
                saved_declaration: Ast::Stmt = Ast::Stmt.VarDecl("saved", Ast::Expr.Absent, empty, at)
                safe_declaration: Ast::Stmt = Ast::Stmt.VarDecl("safe_saved", Ast::Expr.Absent, empty, at)
                target: mutable Ast::Expr = saved
                value: mutable Ast::Expr = comprehension
                if destructure:
                    target <- Ast::Expr.Array([saved, safe_saved], at)
                    value <- Ast::Expr.Tuple([comprehension, empty], at)
                assignment: Ast::Stmt = Ast::Stmt.Assign(target, TokenKind.Assign, value, at)
                branch: Ast::Stmt = Ast::Stmt.If(Ast::Expr.BoolLit(true, at), [assignment], [], at)
                store_saved: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [saved, borrowed], ["", ""], at)
                store_safe: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [safe_saved, borrowed], ["", ""], at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "alias_source", false, false, true)
                chv_flow_bind(flow, "borrowed", false, true, false)
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder"]
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                summary: StoreThroughSummary = zeroed
                statements: darray[Ast::Stmt] = [saved_declaration, safe_declaration, branch, Ast::Stmt.Expr(store_saved, at), Ast::Stmt.Expr(store_safe, at)]
                table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements(statements, false, ref_params, names, names, names, values, &flow, summary, table_diagnostics, table)
                return table_diagnostics.count == 0

        def compiler_holder_branch_comprehension_mutation_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                alias_source: Ast::Expr = Ast::Expr.Ident("alias_source", at)
                iterable: Ast::Expr = Ast::Expr.Array([alias_source], at)
                item: Ast::Expr = Ast::Expr.Ident("item", at)
                comprehension: Ast::Expr = Ast::Expr.Comprehension("item", iterable, Ast::Expr.Absent, item, at, 0)
                saved: Ast::Expr = Ast::Expr.Ident("saved", at)
                borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                empty: Ast::Expr = Ast::Expr.Array([], at)
                saved_declaration: Ast::Stmt = Ast::Stmt.VarDecl("saved", Ast::Expr.Absent, empty, at)
                mutation: Ast::Stmt = Ast::Stmt.Assign(saved, TokenKind.LArrow, comprehension, at)
                branch: Ast::Stmt = Ast::Stmt.If(Ast::Expr.BoolLit(true, at), [mutation], [], at)
                store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [saved, borrowed], ["", ""], at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "alias_source", false, false, true)
                chv_flow_bind(flow, "borrowed", false, true, false)
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder"]
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                summary: StoreThroughSummary = zeroed
                table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements([saved_declaration, branch, Ast::Stmt.Expr(store, at)], false, ref_params, names, names, names, values, &flow, summary, table_diagnostics, table)
                saved_index: usize = chv_flow_latest(flow, "saved")
                return table_diagnostics.count == 1 and saved_index < flow.names.count and flow.may_alias_reference[saved_index]

        def compiler_holder_branch_comprehension_destructure_mutation_case() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                alias_source: Ast::Expr = Ast::Expr.Ident("alias_source", at)
                iterable: Ast::Expr = Ast::Expr.Array([alias_source], at)
                item: Ast::Expr = Ast::Expr.Ident("item", at)
                comprehension: Ast::Expr = Ast::Expr.Comprehension("item", iterable, Ast::Expr.Absent, item, at, 0)
                saved: Ast::Expr = Ast::Expr.Ident("saved", at)
                safe_saved: Ast::Expr = Ast::Expr.Ident("safe_saved", at)
                borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                empty: Ast::Expr = Ast::Expr.Array([], at)
                saved_declaration: Ast::Stmt = Ast::Stmt.VarDecl("saved", Ast::Expr.Absent, empty, at)
                safe_declaration: Ast::Stmt = Ast::Stmt.VarDecl("safe_saved", Ast::Expr.Absent, empty, at)
                target: Ast::Expr = Ast::Expr.Array([saved, safe_saved], at)
                value: Ast::Expr = Ast::Expr.Tuple([comprehension, empty], at)
                mutation: Ast::Stmt = Ast::Stmt.Assign(target, TokenKind.LArrow, value, at)
                branch: Ast::Stmt = Ast::Stmt.If(Ast::Expr.BoolLit(true, at), [mutation], [], at)
                store_saved: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [saved, borrowed], ["", ""], at)
                store_safe: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [safe_saved, borrowed], ["", ""], at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "alias_source", false, false, true)
                chv_flow_bind(flow, "borrowed", false, true, false)
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder"]
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                summary: StoreThroughSummary = zeroed
                statements: darray[Ast::Stmt] = [saved_declaration, safe_declaration, branch, Ast::Stmt.Expr(store_saved, at), Ast::Stmt.Expr(store_safe, at)]
                table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements(statements, false, ref_params, names, names, names, values, &flow, summary, table_diagnostics, table)
                saved_index: usize = chv_flow_latest(flow, "saved")
                safe_saved_index: usize = chv_flow_latest(flow, "safe_saved")
                return table_diagnostics.count == 1 and saved_index < flow.names.count and flow.may_alias_reference[saved_index] and safe_saved_index < flow.names.count and not flow.may_alias_reference[safe_saved_index]
