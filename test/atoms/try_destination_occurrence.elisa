extend Semantic:
    public:
        # The callback parameter and enclosing return clause share a declaration
        # position, but only the latter supplies the destination for `try`.
        def compiler_try_destination_occurrence_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                error_sets: darray[Ast::EnumAnnotation] @source = [
                    Ast::EnumAnnotation{owner: "__error_set_family", name: "CallbackFault", line: 7, offset: 100, identity_id: 41, occurrence_offset: 15},
                    Ast::EnumAnnotation{owner: "__error_set_family", name: "ReturnFault", line: 7, offset: 100, identity_id: 41, occurrence_offset: 35},
                    Ast::EnumAnnotation{owner: "__error_set_family", name: "OtherFault", line: 7, offset: 100, identity_id: 41, occurrence_offset: 55}
                ]
                index: mutable TryErrorSetIndex = TryErrorSetIndex{by_offset_heads: {}, by_offset_tails: {}, unknown_offset_line_heads: {}, unknown_offset_line_tails: {}, next: [], ready: false}
                try_error_set_index_build(index, error_sets) can Global{Read,Write}
                indexed: darray[usize] = try_error_set_destinations(index, error_sets, 100, 7, 41, 35) can Global.Read
                return 1 if indexed.count != 1 or error_sets[indexed[0]].name != "ReturnFault"
                linear_return: darray[usize] = try_error_set_destinations(index, error_sets, 4294967295, 7, 41, 35) can Global.Read
                return 2 if linear_return.count != 1 or error_sets[linear_return[0]].name != "ReturnFault"
                linear_callback: darray[usize] = try_error_set_destinations(index, error_sets, 4294967295, 7, 41, 15) can Global.Read
                return 3 if linear_callback.count != 1 or error_sets[linear_callback[0]].name != "CallbackFault"
                return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_try_destination_occurrence_probe() can Global{Read,Write}
