extend Semantic:
    public:
        def borrow_replay_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            output: mutable BorrowReplayFlow = BorrowReplayFlow{}
            region scratch(1048576):
                alternate: mutable BorrowReplayFlow = BorrowReplayFlow{}
                names: mutable darray[sview @source] = ["borrow"]
                fields: mutable darray[sview @source] = [""]
                owners: mutable darray[sview @source] = ["owner"]
                state: BorrowStateSnapshot = bam_borrow_state_snapshot(names, fields, owners)
                bam_replay_flow_add_return(&alternate, state)
                bam_replay_flow_add_break(&alternate, "stop", state)
                bam_replay_flow_add_continue(&alternate, "next", state)
                bam_replay_flow_merge_exits(&output, &alternate)
            return 1 if not output.return_seen
            return 2 if output.returned.names.count != 1
            return 3 if output.returned.owner_values.count != 1
            return 4 if output.returned.owner_values[0] != "owner"
            return 5 if output.breaks.count != 1 or output.continues.count != 1
            return 6 if output.breaks[0].state.owner_values[0] != "owner"
            return 7 if output.continues[0].state.owner_values[0] != "owner"
            bam_replay_snapshot_copy_into(&output.returned, output.returned)
            return 8 if output.returned.names.count != 1 or output.returned.owner_values[0] != "owner"
            return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::borrow_replay_probe()
