extend Semantic:
    public:
        def compiler_authority_coverage_probe() -> i64 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    unrelated: darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "unrelated", name: "ordinary-row", line: 1}]
                    no_includes: mutable GlobalAuthority = GlobalAuthority{parents: [0], modules: [""], annotations: unrelated}
                    ga_index_capabilities(&no_includes)
                    return 1 if no_includes.permission_includes_present
                    return 2 if not ga_ref_covers("Memory", "Memory.Allocate", 0, 0, &no_includes, 0)
                    return 3 if ga_ref_covers("Memory", "Global.Read", 0, 0, &no_includes, 0)
                    rows: darray[Ast::EnumAnnotation] = [
                        Ast::EnumAnnotation{owner: "__permission_decl", name: "Task", line: 1},
                        Ast::EnumAnnotation{owner: "Task", name: "Memory.Allocate", line: COV_PERMISSION_INCLUDE_ROW}
                    ]
                    includes: mutable GlobalAuthority = GlobalAuthority{parents: [0], modules: [""], annotations: rows}
                    # An unindexed state must retain the old fallback, even when the
                    # new presence flag has not been populated yet.
                    return 4 if not ga_ref_covers("Task", "Memory.Allocate", 0, 0, &includes, 0)
                    ga_index_capabilities(&includes)
                    return 5 if not includes.permission_includes_present
                    return 6 if not ga_ref_covers("Task", "Memory.Allocate", 0, 0, &includes, 0)
                    return 7 if ga_ref_covers("Task", "Global.Write", 0, 0, &includes, 0)

                    alias_rows: darray[Ast::EnumAnnotation] = [
                        Ast::EnumAnnotation{owner: "Chain", name: "__using_alias", line: 9, module: "", offset: 9},
                        Ast::EnumAnnotation{owner: "Actual", name: "__using_alias_target", line: 9, module: "", offset: 9},
                        Ast::EnumAnnotation{owner: "Alias", name: "__using_alias", line: 10, module: "", offset: 10},
                        Ast::EnumAnnotation{owner: "Chain", name: "__using_alias_target", line: 10, module: "", offset: 10},
                        Ast::EnumAnnotation{owner: "Forward", name: "__using_alias", line: 20, module: "", offset: 20},
                        Ast::EnumAnnotation{owner: "Future", name: "__using_alias_target", line: 20, module: "", offset: 20},
                        Ast::EnumAnnotation{owner: "Future", name: "__using_alias", line: 21, module: "", offset: 21},
                        Ast::EnumAnnotation{owner: "Actual", name: "__using_alias_target", line: 21, module: "", offset: 21}
                    ]
                    aliases: mutable GlobalAuthority = GlobalAuthority{parents: [0], modules: [""], module_starts: [0], module_lengths: [0], annotations: alias_rows}
                    actual_scope: usize = ga_collect_module(0, "Actual", aliases) can Global{Read,Write}
                    leaf_scope: usize = ga_collect_module(actual_scope, "Leaf", aliases) can Global{Read,Write}
                    return 8 if ga_text_module("Alias::Leaf", 0, aliases) != leaf_scope
                    future_scope: usize = ga_collect_module(0, "Future", aliases) can Global{Read,Write}
                    future_leaf_scope: usize = ga_collect_module(future_scope, "Leaf", aliases) can Global{Read,Write}
                    return 18 if ga_text_module("Forward::Leaf", 0, aliases) != future_leaf_scope
                    alias_decoy_scope: usize = ga_collect_module(0, "Alias", aliases) can Global{Read,Write}
                    decoy_leaf_scope: usize = ga_collect_module(alias_decoy_scope, "Leaf", aliases) can Global{Read,Write}
                    return 9 if ga_text_module("Alias::Leaf", 0, aliases) != leaf_scope
                    client_scope: usize = ga_collect_module(0, "Client", aliases) can Global{Read,Write}
                    client_alias_scope: usize = ga_collect_module(client_scope, "Alias", aliases) can Global{Read,Write}
                    client_leaf_scope: usize = ga_collect_module(client_alias_scope, "Leaf", aliases) can Global{Read,Write}
                    return 10 if ga_text_module("Alias::Leaf", client_scope, aliases) != client_leaf_scope

                    scoped_alias_rows: darray[Ast::EnumAnnotation] @source = [
                        Ast::EnumAnnotation{owner: "X", name: "__using_alias", line: 20, module: "Scope", offset: 20},
                        Ast::EnumAnnotation{owner: "Real", name: "__using_alias_target", line: 20, module: "Scope", offset: 20}
                    ]
                    scoped_aliases: mutable GlobalAuthority = GlobalAuthority{parents: [0], modules: [""], module_starts: [0], module_lengths: [0], annotations: scoped_alias_rows}
                    root_real_scope: usize = ga_collect_module(0, "Real", scoped_aliases) can Global{Read,Write}
                    root_real_leaf: usize = ga_collect_module(root_real_scope, "Leaf", scoped_aliases) can Global{Read,Write}
                    root_x_scope: usize = ga_collect_module(0, "X", scoped_aliases) can Global{Read,Write}
                    root_x_leaf: usize = ga_collect_module(root_x_scope, "Leaf", scoped_aliases) can Global{Read,Write}
                    return 13 if root_real_leaf == root_x_leaf
                    lexical_scope: usize = ga_collect_module(0, "Scope", scoped_aliases) can Global{Read,Write}
                    return 11 if ga_text_module("X::Leaf", lexical_scope, scoped_aliases) != root_x_leaf
                    local_real_scope: usize = ga_collect_module(lexical_scope, "Real", scoped_aliases) can Global{Read,Write}
                    local_real_leaf: usize = ga_collect_module(local_real_scope, "Leaf", scoped_aliases) can Global{Read,Write}
                    return 12 if ga_text_module("X::Leaf", lexical_scope, scoped_aliases) != local_real_leaf
                    local_x_scope: usize = ga_collect_module(lexical_scope, "X", scoped_aliases) can Global{Read,Write}
                    local_x_leaf: usize = ga_collect_module(local_x_scope, "Leaf", scoped_aliases) can Global{Read,Write}
                    return 14 if ga_text_module("X::Leaf", lexical_scope, scoped_aliases) != local_x_leaf
                    nested_client_scope: usize = ga_collect_module(lexical_scope, "Client", scoped_aliases) can Global{Read,Write}
                    nested_inner_scope: usize = ga_collect_module(nested_client_scope, "Inner", scoped_aliases) can Global{Read,Write}
                    nested_parts: mutable darray[sview] = ga_module_path_parts("X::Leaf") can Memory{Allocate}
                    return 25 if ga_module_parts_resolve(nested_parts, nested_inner_scope, scoped_aliases) != local_x_leaf
                    return 24 if ga_text_module("X::Leaf", nested_inner_scope, scoped_aliases) != local_x_leaf
                    module_at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 8, end_offset: 7}
                    nested_module_expression: Ast::Expr = Ast::Expr.Scope(Ast::Expr.Ident("X", module_at), "Leaf", module_at)
                    return 26 if ga_module(nested_module_expression, scoped_aliases, nested_inner_scope) != local_x_leaf
                    return 34 if ga_module_readonly(nested_module_expression, scoped_aliases, nested_inner_scope) != local_x_leaf

                    ancestor_alias_rows: darray[Ast::EnumAnnotation] @source = [
                        Ast::EnumAnnotation{owner: "ParentName", name: "__using_alias", line: 70, module: "Outer::Inner", offset: 70},
                        Ast::EnumAnnotation{owner: "Target", name: "__using_alias_target", line: 70, module: "Outer::Inner", offset: 70}
                    ]
                    ancestor_aliases: mutable GlobalAuthority = GlobalAuthority{parents: [0], modules: [""], module_starts: [0], module_lengths: [0], annotations: ancestor_alias_rows}
                    ancestor_outer: usize = ga_collect_module(0, "Outer", ancestor_aliases) can Global{Read,Write}
                    ancestor_parent: usize = ga_collect_module(ancestor_outer, "ParentName", ancestor_aliases) can Global{Read,Write}
                    ancestor_leaf: usize = ga_collect_module(ancestor_parent, "Leaf", ancestor_aliases) can Global{Read,Write}
                    ancestor_inner: usize = ga_collect_module(ancestor_outer, "Inner", ancestor_aliases) can Global{Read,Write}
                    alias_target: usize = ga_collect_module(ancestor_inner, "Target", ancestor_aliases) can Global{Read,Write}
                    alias_leaf: usize = ga_collect_module(alias_target, "Leaf", ancestor_aliases) can Global{Read,Write}
                    ancestor_parts: mutable darray[sview] = ga_module_path_parts("ParentName::Leaf") can Memory{Allocate}
                    nearest_parent_alias: (found: bool, ambiguous: bool, index: usize, scope: usize) = ga_module_alias_choice("ParentName", ancestor_inner, ancestor_aliases)
                    return 33 if not nearest_parent_alias.found or nearest_parent_alias.ambiguous or nearest_parent_alias.scope != ancestor_inner
                    resolved_parent_alias: usize = ga_module_alias_resolve("ParentName::Leaf", ancestor_inner, ancestor_aliases) can Global{Read,Write}
                    return 31 if resolved_parent_alias != alias_leaf or resolved_parent_alias == ancestor_leaf
                    return 32 if ga_module_parts_resolve(ancestor_parts, ancestor_inner, ancestor_aliases) != ancestor_leaf

                    coalesced_alias_rows: darray[Ast::EnumAnnotation] @source = [
                        Ast::EnumAnnotation{owner: "Prefix", name: "__using_alias", line: 30, module: "", offset: 30},
                        Ast::EnumAnnotation{owner: "Real", name: "__using_alias_target", line: 30, module: "", offset: 30},
                        Ast::EnumAnnotation{owner: "Alias", name: "__using_alias", line: 31, module: "", offset: 31},
                        Ast::EnumAnnotation{owner: "Prefix", name: "__using_alias_target", line: 31, module: "", offset: 31},
                        Ast::EnumAnnotation{owner: "Alias", name: "__using_alias", line: 32, module: "", offset: 32},
                        Ast::EnumAnnotation{owner: "Real", name: "__using_alias_target", line: 32, module: "", offset: 32}
                    ]
                    coalesced_aliases: mutable GlobalAuthority = GlobalAuthority{parents: [0], modules: [""], module_starts: [0], module_lengths: [0], annotations: coalesced_alias_rows}
                    coalesced_real_scope: usize = ga_collect_module(0, "Real", coalesced_aliases) can Global{Read,Write}
                    coalesced_real_leaf: usize = ga_collect_module(coalesced_real_scope, "Leaf", coalesced_aliases) can Global{Read,Write}
                    coalesced_choice: (found: bool, ambiguous: bool, index: usize, scope: usize) = ga_module_alias_choice("Alias", 0.usize(), coalesced_aliases)
                    return 19 if not coalesced_choice.found or coalesced_choice.ambiguous
                    return 20 if ga_text_module("Alias::Leaf", 0.usize(), coalesced_aliases) != coalesced_real_leaf

                    conflicting_alias_rows: darray[Ast::EnumAnnotation] @source = [
                        Ast::EnumAnnotation{owner: "Alias", name: "__using_alias", line: 40, module: "", offset: 40},
                        Ast::EnumAnnotation{owner: "Actual", name: "__using_alias_target", line: 40, module: "", offset: 40},
                        Ast::EnumAnnotation{owner: "Alias", name: "__using_alias", line: 41, module: "", offset: 41},
                        Ast::EnumAnnotation{owner: "Other", name: "__using_alias_target", line: 41, module: "", offset: 41}
                    ]
                    conflicting_aliases: mutable GlobalAuthority = GlobalAuthority{parents: [0], modules: [""], module_starts: [0], module_lengths: [0], annotations: conflicting_alias_rows}
                    conflicting_actual: usize = ga_collect_module(0, "Actual", conflicting_aliases) can Global{Read,Write}
                    conflicting_other: usize = ga_collect_module(0, "Other", conflicting_aliases) can Global{Read,Write}
                    conflicting_choice: (found: bool, ambiguous: bool, index: usize, scope: usize) = ga_module_alias_choice("Alias", 0.usize(), conflicting_aliases)
                    earlier_choice: (found: bool, ambiguous: bool, index: usize, scope: usize) = ga_module_alias_choice("Alias", 0.usize(), conflicting_aliases, 0, 41)
                    return 21 if not conflicting_choice.found or conflicting_choice.ambiguous or conflicting_choice.index != 2
                    return 22 if conflicting_actual == conflicting_other
                    return 35 if not earlier_choice.found or earlier_choice.ambiguous or earlier_choice.index != 0
                    return 36 if ga_module_alias_resolve("Alias", 0.usize(), conflicting_aliases) != conflicting_other
                    return 37 if ga_module_alias_resolve("Alias", 0.usize(), conflicting_aliases, 0, false, 41) != conflicting_actual

                    permission_alias_rows: darray[Ast::EnumAnnotation] = [
                        Ast::EnumAnnotation{owner: "P", name: "__using_alias", line: 100, module: "", offset: 100},
                        Ast::EnumAnnotation{owner: "Old", name: "__using_alias_target", line: 100, module: "", offset: 100},
                        Ast::EnumAnnotation{owner: "__permission_decl", name: "Cap", line: 1, module: "Old", offset: 110},
                        Ast::EnumAnnotation{owner: "__permission_decl", name: "Cap", line: 1, module: "New", offset: 110},
                        Ast::EnumAnnotation{owner: "Choice", name: "P::Cap.Read", line: COV_ALIAS_MEMBER_ROW, module: "", offset: 120},
                        Ast::EnumAnnotation{owner: "P", name: "__using_alias", line: 130, module: "", offset: 130},
                        Ast::EnumAnnotation{owner: "New", name: "__using_alias_target", line: 130, module: "", offset: 130}
                    ]
                    permission_aliases: mutable GlobalAuthority = GlobalAuthority{parents: [0], modules: [""], module_starts: [0], module_lengths: [0], annotations: permission_alias_rows, functions: ["probe"], function_scopes: [0], function_offsets: [150], effect_row_heads: [GLOBAL_AUTHORITY_NONE]}
                    old_permission_scope: usize = ga_collect_module(0, "Old", permission_aliases) can Global{Read,Write}
                    new_permission_scope: usize = ga_collect_module(0, "New", permission_aliases) can Global{Read,Write}
                    old_permission_leaf: usize = ga_collect_module(old_permission_scope, "Leaf", permission_aliases) can Global{Read,Write}
                    new_permission_leaf: usize = ga_collect_module(new_permission_scope, "Leaf", permission_aliases) can Global{Read,Write}
                    ga_index_capabilities(&permission_aliases)
                    return 38 if not ga_ref_covers("P::Cap.Read", "Old::Cap.Read", 0, 0, &permission_aliases, 0, 125, 125)
                    return 39 if ga_ref_covers("P::Cap.Read", "Old::Cap.Read", 0, 0, &permission_aliases, 0, 150, 150)
                    return 40 if not ga_ref_covers("P::Cap.Read", "New::Cap.Read", 0, 0, &permission_aliases, 0, 150, 150)
                    return 41 if ga_text_module("P", 0, permission_aliases, 125) != old_permission_scope
                    return 45 if ga_text_module("P", 0, permission_aliases, 150) != new_permission_scope
                    return 59 if ga_text_module("P::Leaf", 0, permission_aliases, 125) != old_permission_leaf
                    return 60 if ga_text_module("P::Leaf", 0, permission_aliases, 150) != new_permission_leaf
                    return 61 if ga_module_alias_resolve("P::Leaf", 0, permission_aliases, 0, true, 125) != old_permission_leaf
                    return 62 if ga_module_alias_resolve("P::Leaf", 0, permission_aliases, 0, true, 150) != new_permission_leaf
                    _ = ga_row_add(0, "Choice", true, &permission_aliases, 0, 0, 150) can Global{Read,Write}
                    row: usize = permission_aliases.effect_row_heads[0]
                    row_ref: sview = permission_aliases.effect_refs[permission_aliases.effect_row_refs[row]]
                    row_offset: u32 = permission_aliases.effect_row_offsets[row]
                    return 42 if row_ref != "P::Cap.Read" or row_offset != 120
                    return 43 if not ga_ref_covers(row_ref, "Old::Cap.Read", 0, 0, &permission_aliases, 0, row_offset, 125)
                    return 44 if ga_ref_covers(row_ref, "New::Cap.Read", 0, 0, &permission_aliases, 0, row_offset, 150)

                    edge_filter_rows: darray[Ast::EnumAnnotation] = [
                        Ast::EnumAnnotation{owner: "P", name: "__using_alias", line: 100, module: "", offset: 100},
                        Ast::EnumAnnotation{owner: "Old", name: "__using_alias_target", line: 100, module: "", offset: 100},
                        Ast::EnumAnnotation{owner: "__permission_decl", name: "Unsafe", line: 1, module: "Old", offset: 110},
                        Ast::EnumAnnotation{owner: "P", name: "__using_alias", line: 130, module: "", offset: 130},
                        Ast::EnumAnnotation{owner: "New", name: "__using_alias_target", line: 130, module: "", offset: 130},
                        Ast::EnumAnnotation{owner: "__permission_decl", name: "Unsafe", line: 1, module: "New", offset: 110}
                    ]
                    edge_filters: mutable GlobalAuthority = GlobalAuthority{parents: [0], modules: [""], module_starts: [0], module_lengths: [0], annotations: edge_filter_rows, firewalls: ["P::Unsafe"], firewall_scopes: [0], firewall_offsets: [125]}
                    edge_old_scope: usize = ga_collect_module(0, "Old", edge_filters) can Global{Read,Write}
                    edge_new_scope: usize = ga_collect_module(0, "New", edge_filters) can Global{Read,Write}
                    ga_index_capabilities(&edge_filters)
                    return 48 if ga_text_module("P", 0, edge_filters, 125) != edge_old_scope
                    return 49 if ga_text_module("P", 0, edge_filters, 150) != edge_new_scope
                    ga_edge_rows(0, 1, &edge_filters)
                    return 46 if not ga_edge_ref_suppressed(0, "Old::Unsafe", 0, 150, edge_filters)
                    return 47 if ga_edge_ref_suppressed(0, "New::Unsafe", 0, 150, edge_filters)

                    missing_alias_rows: darray[Ast::EnumAnnotation] @source = [
                        Ast::EnumAnnotation{owner: "MissingPrefix", name: "__using_alias", line: 50, module: "", offset: 50},
                        Ast::EnumAnnotation{owner: "MissingTarget", name: "__using_alias_target", line: 50, module: "", offset: 50},
                        Ast::EnumAnnotation{owner: "MissingAlias", name: "__using_alias", line: 51, module: "", offset: 51},
                        Ast::EnumAnnotation{owner: "MissingPrefix", name: "__using_alias_target", line: 51, module: "", offset: 51},
                        Ast::EnumAnnotation{owner: "MissingAlias", name: "__using_alias", line: 52, module: "", offset: 52},
                        Ast::EnumAnnotation{owner: "MissingTarget", name: "__using_alias_target", line: 52, module: "", offset: 52}
                    ]
                    missing_aliases: mutable GlobalAuthority = GlobalAuthority{parents: [0], modules: [""], module_starts: [0], module_lengths: [0], annotations: missing_alias_rows}
                    missing_choice: (found: bool, ambiguous: bool, index: usize, scope: usize) = ga_module_alias_choice("MissingAlias", 0.usize(), missing_aliases)
                    return 23 if not missing_choice.found or missing_choice.ambiguous

                    ambiguous_chain_rows: darray[Ast::EnumAnnotation] @source = [
                        Ast::EnumAnnotation{owner: "Ambiguous", name: "__using_alias", line: 60, module: "", offset: 60},
                        Ast::EnumAnnotation{owner: "Actual", name: "__using_alias_target", line: 60, module: "", offset: 60},
                        Ast::EnumAnnotation{owner: "Ambiguous", name: "__using_alias", line: 61, module: "", offset: 61},
                        Ast::EnumAnnotation{owner: "Other", name: "__using_alias_target", line: 61, module: "", offset: 61},
                        Ast::EnumAnnotation{owner: "A", name: "__using_alias", line: 62, module: "", offset: 62},
                        Ast::EnumAnnotation{owner: "Ambiguous", name: "__using_alias_target", line: 62, module: "", offset: 62}
                    ]
                    ambiguous_chain: mutable GlobalAuthority = GlobalAuthority{parents: [0], modules: [""], module_starts: [0], module_lengths: [0], annotations: ambiguous_chain_rows}
                    _ = ga_collect_module(0, "Actual", ambiguous_chain) can Global{Read,Write}
                    ambiguous_other: usize = ga_collect_module(0, "Other", ambiguous_chain) can Global{Read,Write}
                    ambiguous_decoy: usize = ga_collect_module(0, "A", ambiguous_chain) can Global{Read,Write}
                    ambiguous_decoy_leaf: usize = ga_collect_module(ambiguous_decoy, "Leaf", ambiguous_chain) can Global{Read,Write}
                    ambiguous_other_leaf: usize = ga_collect_module(ambiguous_other, "Leaf", ambiguous_chain) can Global{Read,Write}
                    ambiguous_parts: mutable darray[sview] = ga_module_path_parts("A::Leaf") can Memory{Allocate}
                    return 27 if ga_module_parts_resolve(ambiguous_parts, 0.usize(), ambiguous_chain) != ambiguous_other_leaf
                    return 28 if ga_text_module("A::Leaf", 0.usize(), ambiguous_chain) != ambiguous_other_leaf
                    return 29 if ambiguous_decoy_leaf >= ambiguous_chain.modules.count or ambiguous_decoy_leaf == ambiguous_other_leaf

                    tied_alias_rows: darray[Ast::EnumAnnotation] @source = [
                        Ast::EnumAnnotation{owner: "Tie", name: "__using_alias", line: 70, module: "", offset: 70},
                        Ast::EnumAnnotation{owner: "Actual", name: "__using_alias_target", line: 70, module: "", offset: 70},
                        Ast::EnumAnnotation{owner: "Tie", name: "__using_alias", line: 71, module: "", offset: 70},
                        Ast::EnumAnnotation{owner: "Other", name: "__using_alias_target", line: 71, module: "", offset: 70},
                        Ast::EnumAnnotation{owner: "Same", name: "__using_alias", line: 80, module: "", offset: 80},
                        Ast::EnumAnnotation{owner: "Actual", name: "__using_alias_target", line: 80, module: "", offset: 80},
                        Ast::EnumAnnotation{owner: "Same", name: "__using_alias", line: 81, module: "", offset: 80},
                        Ast::EnumAnnotation{owner: "Actual", name: "__using_alias_target", line: 81, module: "", offset: 80}
                    ]
                    tied_aliases: mutable GlobalAuthority = GlobalAuthority{parents: [0], modules: [""], module_starts: [0], module_lengths: [0], annotations: tied_alias_rows}
                    tied_actual: usize = ga_collect_module(0, "Actual", tied_aliases) can Global{Read,Write}
                    tied_actual_leaf: usize = ga_collect_module(tied_actual, "Leaf", tied_aliases) can Global{Read,Write}
                    tied_other: usize = ga_collect_module(0, "Other", tied_aliases) can Global{Read,Write}
                    _ = ga_collect_module(tied_other, "Leaf", tied_aliases) can Global{Read,Write}
                    tied_decoy: usize = ga_collect_module(0, "Tie", tied_aliases) can Global{Read,Write}
                    tied_decoy_leaf: usize = ga_collect_module(tied_decoy, "Leaf", tied_aliases) can Global{Read,Write}
                    tied_conflict: (found: bool, ambiguous: bool, index: usize, scope: usize) = ga_module_alias_choice("Tie", 0.usize(), tied_aliases)
                    return 53 if not tied_conflict.found or not tied_conflict.ambiguous
                    return 54 if ga_module_alias_resolve("Tie::Leaf", 0.usize(), tied_aliases) != GLOBAL_AUTHORITY_NONE
                    return 55 if ga_text_module("Tie::Leaf", 0.usize(), tied_aliases) != GLOBAL_AUTHORITY_NONE
                    return 56 if tied_decoy_leaf >= tied_aliases.modules.count or tied_actual_leaf == tied_decoy_leaf

                    same_target_tie: (found: bool, ambiguous: bool, index: usize, scope: usize) = ga_module_alias_choice("Same", 0.usize(), tied_aliases)
                    return 57 if not same_target_tie.found or same_target_tie.ambiguous
                    return 58 if ga_module_alias_resolve("Same::Leaf", 0.usize(), tied_aliases) != tied_actual_leaf
                    return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_authority_coverage_probe() can Global{Read,Write}
