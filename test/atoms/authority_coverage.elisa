extend Semantic:
    public:
        def compiler_authority_coverage_probe() -> i64 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    unrelated: darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "unrelated", name: "ordinary-row", line: 1}]
                    no_includes: mutable GlobalAuthority = GlobalAuthority{parents: [0], modules: [""], annotations: unrelated}
                    ga_index_capabilities(&no_includes)
                    return 1 if no_includes.permission_includes_present
                    return 2 if not ga_ref_covers("Memory", "Memory.Allocate", 0, 0, &no_includes, 0)
                    return 3 if ga_ref_covers("Memory", "Global.Read", 0, 0, &no_includes, 0)
                    rows: darray[Ast::EnumAnnotation] = [
                        Ast::EnumAnnotation{owner: "__permission_decl", name: "Task", line: 1},
                        Ast::EnumAnnotation{owner: "Task", name: "Memory.Allocate", line: COV_PERMISSION_INCLUDE_ROW}
                    ]
                    includes: mutable GlobalAuthority = GlobalAuthority{parents: [0], modules: [""], annotations: rows}
                    # An unindexed state must retain the old fallback, even when the
                    # new presence flag has not been populated yet.
                    return 4 if not ga_ref_covers("Task", "Memory.Allocate", 0, 0, &includes, 0)
                    ga_index_capabilities(&includes)
                    return 5 if not includes.permission_includes_present
                    return 6 if not ga_ref_covers("Task", "Memory.Allocate", 0, 0, &includes, 0)
                    return 7 if ga_ref_covers("Task", "Global.Write", 0, 0, &includes, 0)
                    return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_authority_coverage_probe() can Global{Read,Write}
