extend Semantic:
    public:
        def compiler_module_alias_scope_probe() -> i64 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                rows: darray[Ast::EnumAnnotation] = [
                    Ast::EnumAnnotation{owner: "Short", name: "__using_alias", module: "", line: 1, offset: 10},
                    Ast::EnumAnnotation{owner: "RootTarget", name: "__using_alias_target", module: "", line: 1, offset: 10},
                    Ast::EnumAnnotation{owner: "Short", name: "__using_alias", module: "Outer", line: 2, offset: 20},
                    Ast::EnumAnnotation{owner: "LocalTarget", name: "__using_alias_target", module: "Outer", line: 2, offset: 20}
                ]
                inherited = callable_using_alias_visible_target(rows, "Outer::Inner", "Short")
                return 1 if inherited.count != 1 or inherited.target != "LocalTarget" or inherited.scope != "Outer"
                root = callable_using_alias_visible_target(rows, "Other::Inner", "Short")
                return 2 if root.count != 1 or root.target != "RootTarget" or root.scope != ""
                absent = callable_using_alias_visible_target(rows, "Outer::Inner", "Absent")
                return 3 if absent.count != 0 or absent.target != "" or absent.scope != ""
                empty: darray[Ast::EnumAnnotation] = []
                return 4 if callable_using_alias_visible_target(empty, "", "Absent").count != 0
                return 5 if ewr_qualified_module_path_rank("Outer::Target", "Target", "Outer::Inner") != 8
                return 6 if ewr_qualified_module_path_rank("Unrelated::Target", "Target", "Outer::Inner") != 0
                return 7 if ewr_qualified_module_path_rank("Target", "Target", "") != 0
                return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_module_alias_scope_probe() can Global{Read,Write}
