extend Semantic:
    public:
        def compiler_region_empty_iterable_catchability_probe() -> i64 can[Abort.Panic, Memory.Allocate]:
            at: Ast::Pos = zeroed
            catch_context: RegionEscapeCatchContext = RegionEscapeCatchContext{markers: [], lexical_module: ""}
            raised: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("raise", at), [Ast::Expr.IntLit(0, at)], [], at)

            empty_array: Ast::Expr = Ast::Expr.Array([], at)
            empty_array_comprehension: Ast::Expr = Ast::Expr.Comprehension("item", empty_array, raised, raised, at, 0)
            return 1 if region_escape_provenance_catchable_raise(empty_array_comprehension)
            empty_string_comprehension: Ast::Expr = Ast::Expr.Comprehension("item", Ast::Expr.StringLit("", at), raised, raised, at, 0)
            return 2 if region_escape_provenance_catchable_raise(empty_string_comprehension)

            nonempty_comprehension: Ast::Expr = Ast::Expr.Comprehension("item", Ast::Expr.Array([Ast::Expr.IntLit(1, at)], at), Ast::Expr.BoolLit(true, at), raised, at, 0)
            return 3 if not region_escape_provenance_catchable_raise(nonempty_comprehension)
            raising_iterable_comprehension: Ast::Expr = Ast::Expr.Comprehension("item", raised, Ast::Expr.BoolLit(false, at), Ast::Expr.IntLit(1, at), at, 0)
            return 4 if not region_escape_provenance_catchable_raise(raising_iterable_comprehension)

            empty_array_for: Ast::Stmt = Ast::Stmt.For("", ["item"], empty_array, [Ast::Stmt.Expr(raised, at)], at)
            empty_array_statements: darray[Ast::Stmt] @source = [empty_array_for]
            empty_array_facts: (reaches_end: bool, found_raise: bool) = region_escape_provenance_catchable_raise_statements_summary(empty_array_statements, catch_context)
            return 5 if empty_array_facts.found_raise or not empty_array_facts.reaches_end

            empty_string_for: Ast::Stmt = Ast::Stmt.For("", ["item"], Ast::Expr.StringLit("", at), [Ast::Stmt.Expr(raised, at)], at)
            empty_string_statements: darray[Ast::Stmt] @source = [empty_string_for]
            empty_string_facts: (reaches_end: bool, found_raise: bool) = region_escape_provenance_catchable_raise_statements_summary(empty_string_statements, catch_context)
            return 6 if empty_string_facts.found_raise or not empty_string_facts.reaches_end

            nonempty_for: Ast::Stmt = Ast::Stmt.For("", ["item"], Ast::Expr.Array([Ast::Expr.IntLit(1, at)], at), [Ast::Stmt.Expr(raised, at)], at)
            nonempty_statements: darray[Ast::Stmt] @source = [nonempty_for]
            nonempty_facts: (reaches_end: bool, found_raise: bool) = region_escape_provenance_catchable_raise_statements_summary(nonempty_statements, catch_context)
            return 7 if not nonempty_facts.found_raise

            raising_iterable_for: Ast::Stmt = Ast::Stmt.For("", ["item"], raised, [], at)
            raising_iterable_statements: darray[Ast::Stmt] @source = [raising_iterable_for]
            raising_iterable_facts: (reaches_end: bool, found_raise: bool) = region_escape_provenance_catchable_raise_statements_summary(raising_iterable_statements, catch_context)
            return 8 if not raising_iterable_facts.found_raise
            return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_region_empty_iterable_catchability_probe() can[Global{Read,Write}]
