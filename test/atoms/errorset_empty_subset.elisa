extend Semantic:
    public:
        def errorset_empty_subset_atom_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    nodes: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in nodes:
                        table: mutable SymbolTable = SymbolTable(false)
                        table.enum_variant_owner <- table.enum_variant_owner.push("Fault")
                        table.enum_variant_name <- table.enum_variant_name.push("Available")
                        table.enum_variant_module <- table.enum_variant_module.push("Provider")
                        table.enum_variant_owner <- table.enum_variant_owner.push("Fault")
                        table.enum_variant_name <- table.enum_variant_name.push("Busy")
                        table.enum_variant_module <- table.enum_variant_module.push("Provider")

                        empty_source_rows: darray[Ast::EnumAnnotation] @source = [
                            Ast::EnumAnnotation{owner: "__error_set_family", name: "Fault", line: 10, offset: 100, identity_id: 7, occurrence_offset: 110},
                            Ast::EnumAnnotation{owner: "__error_set_family_path", name: "Provider::Fault", line: 10, offset: 100, identity_id: 7, occurrence_offset: 110},
                            Ast::EnumAnnotation{owner: "__error_variant_family", name: "Fault", line: 10, offset: 100, identity_id: 7, occurrence_offset: 110}
                        ]
                        table.protocol_annotations <- empty_source_rows
                        return 1 if not progress_catch_family_row_has_subset(0.usize(), "Fault", 10, 100, 7, 110, table)
                        return 2 if progress_catch_family_row_subset_metadata_valid(0.usize(), "Fault", 10, 100, 7, 110, table)
                        return 3 if progress_catch_family_row_allows_variant(0.usize(), "Fault", "Available", 10, 100, 7, 110, table)
                        subset_test_file: mutable Ast::File = zeroed
                        subset_test_file <- subset_test_file{enum_annotations = empty_source_rows}
                        table <- check_empty_error_set_subset(&subset_test_file, table)
                        return 8 if table.diagnostics.count != 1 or table.diagnostics[0].kind != DiagnosticKind.EmptyErrorSetSubset
                        table.diagnostics <- []

                        malformed_rows: darray[Ast::EnumAnnotation] @source = [
                            Ast::EnumAnnotation{owner: "__error_set_family", name: "Fault", line: 10, offset: 100, identity_id: 7, occurrence_offset: 110},
                            Ast::EnumAnnotation{owner: "__error_set_family_path", name: "Provider::Fault", line: 10, offset: 100, identity_id: 7, occurrence_offset: 110},
                            Ast::EnumAnnotation{owner: "__error_variant_family", name: "Fault", line: 10, offset: 100, identity_id: 7, occurrence_offset: 110},
                            Ast::EnumAnnotation{owner: "__error_variant_allow", name: "Available", line: 10, offset: 100, identity_id: 8, occurrence_offset: 110},
                            Ast::EnumAnnotation{owner: "__error_set_family", name: "Fault", line: 20, offset: 200, identity_id: 8, occurrence_offset: 210},
                            Ast::EnumAnnotation{owner: "__error_set_family_path", name: "Provider::Fault", line: 20, offset: 200, identity_id: 8, occurrence_offset: 210}
                        ]
                        table.protocol_annotations <- malformed_rows
                        return 4 if progress_catch_family_row_subset_metadata_valid(0.usize(), "Fault", 10, 100, 7, 110, table)

                        source: EwrFamilyRef = EwrFamilyRef{family: "Fault", family_path: "Provider::Fault", source_name: "", variant_override: "", module: "Provider", module_known: true, family_row_index: 0.usize(), has_family_row: true, function_name: "source", function_module: "Provider", function_module_known: true, declaration_line: 10, declaration_offset: 100, declaration_identity_id: 7, occurrence_offset: 110}
                        full_destination: EwrFamilyRef = EwrFamilyRef{family: "Fault", family_path: "Provider::Fault", source_name: "", variant_override: "", module: "Provider", module_known: true, family_row_index: 3.usize(), has_family_row: true, function_name: "destination", function_module: "Provider", function_module_known: true, declaration_line: 20, declaration_offset: 200, declaration_identity_id: 8, occurrence_offset: 210}
                        malformed_destination: EwrFamilyRef = full_destination{family_row_index = 4.usize()}
                        empty_source_to_full_rows: darray[Ast::EnumAnnotation] @source = [
                            Ast::EnumAnnotation{owner: "__error_set_family", name: "Fault", line: 10, offset: 100, identity_id: 7, occurrence_offset: 110},
                            Ast::EnumAnnotation{owner: "__error_set_family_path", name: "Provider::Fault", line: 10, offset: 100, identity_id: 7, occurrence_offset: 110},
                            Ast::EnumAnnotation{owner: "__error_variant_family", name: "Fault", line: 10, offset: 100, identity_id: 7, occurrence_offset: 110},
                            Ast::EnumAnnotation{owner: "__error_set_family", name: "Fault", line: 20, offset: 200, identity_id: 8, occurrence_offset: 210},
                            Ast::EnumAnnotation{owner: "__error_set_family_path", name: "Provider::Fault", line: 20, offset: 200, identity_id: 8, occurrence_offset: 210}
                        ]
                        return 5 if not ewr_family_covers(empty_source_to_full_rows, source, full_destination, table)
                        return 6 if not ewr_family_covers(malformed_rows, source, malformed_destination, table)

                        mixed_rows: darray[Ast::EnumAnnotation] @source = [
                            Ast::EnumAnnotation{owner: "__error_set_family", name: "Fault", line: 10, offset: 100, identity_id: 7, occurrence_offset: 110},
                            Ast::EnumAnnotation{owner: "__error_set_family_path", name: "Provider::Fault", line: 10, offset: 100, identity_id: 7, occurrence_offset: 110},
                            Ast::EnumAnnotation{owner: "__error_variant_family", name: "Fault", line: 10, offset: 100, identity_id: 7, occurrence_offset: 110},
                            Ast::EnumAnnotation{owner: "__error_variant_allow", name: "Available", line: 10, offset: 100, identity_id: 7, occurrence_offset: 110},
                            Ast::EnumAnnotation{owner: "__error_set_family", name: "Fault", line: 20, offset: 200, identity_id: 8, occurrence_offset: 210},
                            Ast::EnumAnnotation{owner: "__error_set_family_path", name: "Provider::Fault", line: 20, offset: 200, identity_id: 8, occurrence_offset: 210},
                            Ast::EnumAnnotation{owner: "__error_variant_family", name: "Fault", line: 20, offset: 200, identity_id: 8, occurrence_offset: 210}
                        ]
                        available_source: EwrFamilyRef = source{family_row_index = 0.usize(), declaration_line = 10, declaration_offset = 100, declaration_identity_id = 7, occurrence_offset = 110}
                        empty_destination: EwrFamilyRef = full_destination{family_row_index = 4.usize()}
                        return 7 if not ewr_family_covers(mixed_rows, available_source, empty_destination, table)
                        return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::errorset_empty_subset_atom_probe() can Global{Read,Write}
