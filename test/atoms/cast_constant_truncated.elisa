extend Semantic:
    public:
        def cast_constant_truncated_alias_atom() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                signed_alias_callee: Ast::Expr = Ast::Expr.Field(Ast::Expr.IntLit(257, at), "s8", at)
                signed_alias_call: Ast::Expr = Ast::Expr.Call(signed_alias_callee, [], [], at)
                signed_alias_result: (found: bool, value: i64, type_name: sview) = cast_constant_overflow(signed_alias_call)
                return 1 if not signed_alias_result.found or signed_alias_result.value != 257 or signed_alias_result.type_name != "s8"

                signed_alias_prefix: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("s16", at), [Ast::Expr.IntLit(32768, at)], [], at)
                signed_prefix_result: (found: bool, value: i64, type_name: sview) = cast_constant_overflow(signed_alias_prefix)
                return 2 if not signed_prefix_result.found or signed_prefix_result.value != 32768 or signed_prefix_result.type_name != "s16"

                in_range_alias: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.IntLit(127, at), "s8", at), [], [], at)
                in_range_result: (found: bool, value: i64, type_name: sview) = cast_constant_overflow(in_range_alias)
                return 3 if in_range_result.found
                return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::cast_constant_truncated_alias_atom() can Global{Read,Write}
