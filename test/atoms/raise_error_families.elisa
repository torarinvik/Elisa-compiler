extend Semantic:
    public:
        def compiler_raise_error_families_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    nodes: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in nodes:
                        at: Ast::Pos = Ast::Pos{line: 50, column: 1, offset: 100, end_line: 50, end_column: 2, end_offset: 101}
                        table: mutable SymbolTable = SymbolTable(false)
                        table <- table.add_symbol("First", SymbolKind.Module, 1)
                        table <- table.add_symbol("Second", SymbolKind.Module, 2)
                        table <- table.add_symbol("API", SymbolKind.Module, 3)
                        table.enum_variant_owner <- table.enum_variant_owner.push("Fault")
                        table.enum_variant_name <- table.enum_variant_name.push("Busy")
                        table.enum_variant_module <- table.enum_variant_module.push("First")
                        table.enum_variant_owner <- table.enum_variant_owner.push("Fault")
                        table.enum_variant_name <- table.enum_variant_name.push("Busy")
                        table.enum_variant_module <- table.enum_variant_module.push("Second")
                        table.enum_variant_owner <- table.enum_variant_owner.push("Fault")
                        table.enum_variant_name <- table.enum_variant_name.push("Known")
                        table.enum_variant_module <- table.enum_variant_module.push("Second")
                        annotations: darray[Ast::EnumAnnotation] @source = [
                            Ast::EnumAnnotation{owner: "relay", name: "__error_return", line: 50, offset: 100, identity_id: 7},
                            Ast::EnumAnnotation{owner: "__fn_module", name: "API", line: 50, offset: 100, identity_id: 7},
                            Ast::EnumAnnotation{owner: "__error_set_family", name: "Fault", line: 50, offset: 100, identity_id: 7},
                            Ast::EnumAnnotation{owner: "__error_set_family_path", name: "First::Fault", line: 50, offset: 100, identity_id: 7},
                            Ast::EnumAnnotation{owner: "__error_variant_family", name: "Fault", line: 50, offset: 100, identity_id: 7},
                            Ast::EnumAnnotation{owner: "__error_variant_allow", name: "Busy", line: 50, offset: 100, identity_id: 7},
                            Ast::EnumAnnotation{owner: "__error_set_family", name: "Fault", line: 50, offset: 100, identity_id: 7},
                            Ast::EnumAnnotation{owner: "__error_set_family_path", name: "Second::Fault", line: 50, offset: 100, identity_id: 7},
                            Ast::EnumAnnotation{owner: "__error_variant_family", name: "Fault", line: 50, offset: 100, identity_id: 7},
                            Ast::EnumAnnotation{owner: "__error_variant_allow", name: "Known", line: 50, offset: 100, identity_id: 7}
                        ]
                        busy: Ast::Expr = Ast::Expr.Field(Ast::Expr.Scope(Ast::Expr.Ident("Second", at), "Fault", at), "Busy", at)
                        raise_busy: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("raise", at), [busy], [], at)
                        table <- check_raise_destination(raise_busy, 51, "relay", at, annotations, table)
                        return 1 if table.diagnostics.count != 1 or table.diagnostics[0].kind != DiagnosticKind.RaiseVariantNotAllowed

                        table.diagnostics <- []
                        known: Ast::Expr = Ast::Expr.Field(Ast::Expr.Scope(Ast::Expr.Ident("Second", at), "Fault", at), "Known", at)
                        raise_known: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("raise", at), [known], [], at)
                        table <- check_raise_destination(raise_known, 52, "relay", at, annotations, table)
                        return 2 if table.diagnostics.count != 0

                        stale_identity: darray[Ast::EnumAnnotation] @source = [
                            Ast::EnumAnnotation{owner: "relay", name: "__error_return", line: 50, offset: 100, identity_id: 7},
                            Ast::EnumAnnotation{owner: "__fn_module", name: "API", line: 50, offset: 100, identity_id: 7},
                            Ast::EnumAnnotation{owner: "__error_set_family", name: "Fault", line: 50, offset: 100, identity_id: 7},
                            Ast::EnumAnnotation{owner: "__error_set_family_path", name: "Second::Fault", line: 50, offset: 100, identity_id: 7},
                            Ast::EnumAnnotation{owner: "__error_variant_family", name: "Fault", line: 50, offset: 100, identity_id: 8},
                            Ast::EnumAnnotation{owner: "__error_variant_allow", name: "Known", line: 50, offset: 100, identity_id: 8}
                        ]
                        table.diagnostics <- []
                        table <- check_raise_destination(raise_known, 53, "relay", at, stale_identity, table)
                        return 3 if table.diagnostics.count != 1 or table.diagnostics[0].kind != DiagnosticKind.RaiseVariantNotAllowed

                        selective_imports: darray[Ast::EnumAnnotation] @source = [
                            Ast::EnumAnnotation{owner: "__from_member", name: "Fault", module: "API", line: 10, offset: 30},
                            Ast::EnumAnnotation{owner: "__from_src", name: "Second", module: "API", line: 10, offset: 30}
                        ]
                        imported: (known: bool, module: sview @source) = raise_imported_family_module(selective_imports, at, true, "API", "Fault", table)
                        return 4 if not imported.known
                        return 16 if imported.module != "Second"

                        collision_table: mutable SymbolTable = SymbolTable(false)
                        collision_table.enum_variant_owner <- collision_table.enum_variant_owner.push("Fault")
                        collision_table.enum_variant_name <- collision_table.enum_variant_name.push("Bar")
                        collision_table.enum_variant_module <- collision_table.enum_variant_module.push("")
                        collision_table.enum_variant_owner <- collision_table.enum_variant_owner.push("Bar")
                        collision_table.enum_variant_name <- collision_table.enum_variant_name.push("Empty")
                        collision_table.enum_variant_module <- collision_table.enum_variant_module.push("")
                        collision_annotations: darray[Ast::EnumAnnotation] @source = [
                            Ast::EnumAnnotation{owner: "relay", name: "__error_return", line: 60, offset: 200, identity_id: 9},
                            Ast::EnumAnnotation{owner: "__error_set_family", name: "Bar", line: 60, offset: 200, identity_id: 9},
                            Ast::EnumAnnotation{owner: "__error_set_family_path", name: "Bar", line: 60, offset: 200, identity_id: 9}
                        ]
                        collision_pos: Ast::Pos = Ast::Pos{line: 60, column: 1, offset: 200, end_line: 60, end_column: 2, end_offset: 201}
                        collision_tag: Ast::Expr = Ast::Expr.Field(Ast::Expr.Ident("Fault", at), "Bar", at)
                        raise_collision: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("raise", at), [collision_tag], [], at)
                        collision_table <- check_raise_destination(raise_collision, 61, "relay", collision_pos, collision_annotations, collision_table)
                        return 5 if collision_table.diagnostics.count != 1 or collision_table.diagnostics[0].kind != DiagnosticKind.RaiseDestinationMismatch

                        collision_table.diagnostics <- []
                        nested_raise_value: Ast::Expr = Ast::Expr.Tuple([raise_collision], at)
                        collision_table <- check_raise_expr_recovery(nested_raise_value, true, "relay", collision_pos, collision_annotations, collision_table)
                        return 6 if collision_table.diagnostics.count != 1 or collision_table.diagnostics[0].kind != DiagnosticKind.RaiseDestinationMismatch

                        nested_recovery: Ast::Expr = Ast::Expr.GetElse(Ast::Expr.Ident("optional", at), [Ast::Stmt.Expr(raise_collision, at)], at)
                        nested_tuple: Ast::Expr = Ast::Expr.Tuple([nested_recovery], at)
                        collision_table.diagnostics <- []
                        collision_table <- check_raise_expr_recovery(nested_tuple, true, "relay", collision_pos, collision_annotations, collision_table)
                        return 7 if collision_table.diagnostics.count != 1 or collision_table.diagnostics[0].kind != DiagnosticKind.RaiseDestinationMismatch

                        condition_recovery: Ast::Expr = Ast::Expr.GetElse(Ast::Expr.Ident("optional", at), [Ast::Stmt.Expr(raise_collision, at)], at)
                        recovery_if: darray[Ast::Stmt] @source = [Ast::Stmt.If(condition_recovery, [], [], at)]
                        collision_table.diagnostics <- []
                        collision_table <- check_raise_statements(recovery_if, true, "relay", collision_pos, collision_annotations, collision_table)
                        return 8 if collision_table.diagnostics.count != 1 or collision_table.diagnostics[0].kind != DiagnosticKind.RaiseDestinationMismatch

                        capture_candidate: Ast::StaticEffectCandidate = Ast::StaticEffectCandidate{effect_type: Ast::Expr.Ident("Effect", at), callee: "handler", captures: [nested_recovery]}
                        captured_static_call: Ast::Expr = Ast::Expr.StaticEffectCall(Ast::Expr.Ident("Effect", at), "operation", [capture_candidate], [], [], at)
                        collision_table.diagnostics <- []
                        collision_table <- check_raise_expr_recovery(captured_static_call, true, "relay", collision_pos, collision_annotations, collision_table)
                        return 9 if collision_table.diagnostics.count != 1 or collision_table.diagnostics[0].kind != DiagnosticKind.RaiseDestinationMismatch

                        payload_get_else: Ast::Expr = Ast::Expr.GetElse(Ast::Expr.Ident("optional", at), [Ast::Stmt.Expr(raise_collision, at)], at)
                        payload_variant: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("Fault", at), "Bar", at), [payload_get_else], [], at)
                        payload_raise: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("raise", at), [payload_variant], [], at)
                        collision_table.diagnostics <- []
                        collision_table <- check_raise_expr_recovery(payload_raise, true, "relay", collision_pos, collision_annotations, collision_table)
                        return 10 if collision_table.diagnostics.count != 2 or collision_table.diagnostics[0].kind != DiagnosticKind.RaiseDestinationMismatch or collision_table.diagnostics[1].kind != DiagnosticKind.RaiseDestinationMismatch

                        collision_table.diagnostics <- []
                        no_set_raise_statement: darray[Ast::Stmt] @source = [Ast::Stmt.Return(nested_raise_value, at)]
                        empty_annotations: darray[Ast::EnumAnnotation] @source = []
                        collision_table <- check_raise_statements(no_set_raise_statement, false, "plain", collision_pos, empty_annotations, collision_table)
                        return 11 if collision_table.diagnostics.count != 1 or collision_table.diagnostics[0].kind != DiagnosticKind.RaiseWithoutErrorSet

                        lambda_table: mutable SymbolTable = SymbolTable(false)
                        lambda_table.enum_variant_owner <- lambda_table.enum_variant_owner.push("Fault")
                        lambda_table.enum_variant_name <- lambda_table.enum_variant_name.push("Bad")
                        lambda_table.enum_variant_module <- lambda_table.enum_variant_module.push("Provider")
                        lambda_table.enum_variant_owner <- lambda_table.enum_variant_owner.push("Fault")
                        lambda_table.enum_variant_name <- lambda_table.enum_variant_name.push("Bad")
                        lambda_table.enum_variant_module <- lambda_table.enum_variant_module.push("Peer")
                        lambda_table.enum_variant_owner <- lambda_table.enum_variant_owner.push("Fault")
                        lambda_table.enum_variant_name <- lambda_table.enum_variant_name.push("Good")
                        lambda_table.enum_variant_module <- lambda_table.enum_variant_module.push("Peer")
                        lambda_annotations: darray[Ast::EnumAnnotation] @source = [
                            Ast::EnumAnnotation{owner: "bad", name: "__error_return", line: 40, offset: 400, identity_id: 8, occurrence_offset: 410},
                            Ast::EnumAnnotation{owner: "__fn_module", name: "API", line: 40, offset: 400, identity_id: 8, occurrence_offset: 410},
                            Ast::EnumAnnotation{owner: "callback", name: "__error_return", line: 50, offset: 500, identity_id: 7, occurrence_offset: 550},
                            Ast::EnumAnnotation{owner: "__fn_module", name: "Provider", line: 50, offset: 500, identity_id: 7, occurrence_offset: 550},
                            Ast::EnumAnnotation{owner: "consume", name: "__error_return", line: 50, offset: 500, identity_id: 7, occurrence_offset: 590},
                            Ast::EnumAnnotation{owner: "__fn_module", name: "Peer", line: 50, offset: 500, identity_id: 7, occurrence_offset: 590},
                            Ast::EnumAnnotation{owner: "__error_set_family", name: "Fault", line: 50, offset: 500, identity_id: 7, occurrence_offset: 550},
                            Ast::EnumAnnotation{owner: "__error_set_family_path", name: "Provider::Fault", line: 50, offset: 500, identity_id: 7, occurrence_offset: 550},
                            Ast::EnumAnnotation{owner: "__error_set_family", name: "Fault", line: 50, offset: 500, identity_id: 7, occurrence_offset: 590},
                            Ast::EnumAnnotation{owner: "__error_set_family_path", name: "Peer::Fault", line: 50, offset: 500, identity_id: 7, occurrence_offset: 590},
                            Ast::EnumAnnotation{owner: "__error_variant_family", name: "Fault", line: 50, offset: 500, identity_id: 7, occurrence_offset: 590},
                            Ast::EnumAnnotation{owner: "__error_variant_allow", name: "Good", line: 50, offset: 500, identity_id: 7, occurrence_offset: 590}
                        ]
                        lambda_target: (known: bool, module: sview @source, line: u32, offset: u32, identity_id: u32, function_name: sview @source) = (true, "Peer", 50, 500, 7, "consume")
                        lambda_pos: Ast::Pos = Ast::Pos{line: 40, column: 1, offset: 400, end_line: 40, end_column: 2, end_offset: 401}
                        provider_bad: Ast::Expr = Ast::Expr.Field(Ast::Expr.Scope(Ast::Expr.Ident("Provider", at), "Fault", at), "Bad", at)
                        provider_raise: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("raise", at), [provider_bad], [], at)
                        lambda_table <- lrc_check_raise(provider_raise, 41, lambda_target, "bad", lambda_pos, 8, true, "API", lambda_annotations, lambda_table)
                        return 12 if lambda_table.diagnostics.count != 1 or lambda_table.diagnostics[0].kind != DiagnosticKind.LambdaRaiseMismatch

                        lambda_table.diagnostics <- []
                        peer_bad: Ast::Expr = Ast::Expr.Field(Ast::Expr.Scope(Ast::Expr.Ident("Peer", at), "Fault", at), "Bad", at)
                        peer_raise: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("raise", at), [peer_bad], [], at)
                        lambda_table <- lrc_check_raise(peer_raise, 42, lambda_target, "bad", lambda_pos, 8, true, "Peer", lambda_annotations, lambda_table)
                        return 13 if lambda_table.diagnostics.count != 1 or lambda_table.diagnostics[0].kind != DiagnosticKind.LambdaRaiseMismatch

                        lambda_table.diagnostics <- []
                        peer_good: Ast::Expr = Ast::Expr.Field(Ast::Expr.Scope(Ast::Expr.Ident("Peer", at), "Fault", at), "Good", at)
                        peer_good_raise: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("raise", at), [peer_good], [], at)
                        lambda_table <- lrc_check_raise(peer_good_raise, 43, lambda_target, "bad", lambda_pos, 8, true, "Peer", lambda_annotations, lambda_table)
                        return 14 if lambda_table.diagnostics.count != 0
                        consume_pos: Ast::Pos = Ast::Pos{line: 50, column: 1, offset: 500, end_line: 50, end_column: 2, end_offset: 501}
                        lambda_table.diagnostics <- []
                        lambda_table <- check_raise_destination(provider_raise, 44, "consume", consume_pos, lambda_annotations, lambda_table)
                        return 15 if lambda_table.diagnostics.count != 1 or lambda_table.diagnostics[0].kind != DiagnosticKind.RaiseDestinationMismatch
                        return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_raise_error_families_probe() can Global{Read,Write}
