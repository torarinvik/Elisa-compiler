extend Semantic:
    public:
        def catch_marker_module_identity_probe() -> i64 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    nodes: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in nodes:
                        at: Ast::Pos = Ast::Pos{line: 81, column: 3, offset: 23, end_line: 81, end_column: 8, end_offset: 28}
                        left_marker: Ast::EnumAnnotation = Ast::EnumAnnotation{owner: "__catch_match", name: "__catch_match", line: 81, offset: 23, module: "Left"}
                        right_marker: Ast::EnumAnnotation = Ast::EnumAnnotation{owner: "__catch_match", name: "__catch_match", line: 81, offset: 23, module: "Right"}
                        annotations: mutable darray[Ast::EnumAnnotation] @source = [left_marker]
                        table: mutable SymbolTable = SymbolTable(false)
                        table.current_module <- "Right"
                        table.protocol_annotations <- annotations
                        region_context: mutable RegionEscapeCatchContext = RegionEscapeCatchContext{markers: annotations, lexical_module: "Right"}
                        return 17 if region_escape_catch_marker_matches(at, region_context)
                        return 1 if progress_is_catch_match(table, at)
                        return 2 if statement_match_is_catch(table, at)
                        return 3 if cos_is_catch(table, at.line, at.offset, "Right")
                        return 4 if cpb_is_catch(annotations, at.line, at.offset, "Right")

                        catchall_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [], guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Binding("later"), body: [], guard: Ast::Expr.Absent, pos: at}
                        ]
                        table <- check_unreachable_arms(catchall_arms, table, at)
                        return 5 if table.diagnostics.count != 1

                        scalar_table: mutable SymbolTable = SymbolTable(false)
                        scalar_table.current_module <- "Right"
                        scalar_table.protocol_annotations <- annotations
                        scalar_names: darray[sview] = []
                        scalar_types: darray[sview @source] = []
                        invalid_scalar_arm: darray[Ast::MatchArm] @source = [Ast::MatchArm{pattern: Ast::Pattern.Variant("Choice.Yes", []), body: [], guard: Ast::Expr.Absent, pos: at}]
                        scalar_table <- check_scalar_match_arm_types(Ast::Expr.IntLit(1, at), invalid_scalar_arm, at, scalar_names, scalar_types, scalar_table)
                        return 6 if scalar_table.diagnostics.count != 1

                        raise_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("raise", at), [Ast::Expr.Ident("failure", at)], [], at)
                        catch_shape_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Binding("value"), body: [], guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [], guard: Ast::Expr.Absent, pos: at}
                        ]
                        panic_guard: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("panic", at), [], [], at)
                        aborting_guard_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Binding("value"), body: [], guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [], guard: panic_guard, pos: at}
                        ]
                        aborting_guard_catch: Ast::Expr = Ast::Expr.Catch(raise_call, aborting_guard_arms, at)
                        return 24 if not region_escape_provenance_expression_terminates_with_metadata(aborting_guard_catch, region_context)
                        aborting_guard_match_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Literal("true"), body: [], guard: panic_guard, pos: at}
                        ]
                        aborting_guard_match: Ast::Expr = Ast::Expr.Match(Ast::Expr.BoolLit(true, at), aborting_guard_match_arms, at)
                        return 29 if not region_escape_provenance_expression_terminates_with_metadata(aborting_guard_match, region_context)
                        exhaustive_bool_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Literal("true"), body: [Ast::Stmt.Expr(panic_guard, at)], guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Literal("false"), body: [Ast::Stmt.Expr(panic_guard, at)], guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [], guard: Ast::Expr.Absent, pos: at}
                        ]
                        exhaustive_bool_match: Ast::Expr = Ast::Expr.Match(Ast::Expr.Ident("condition", at), exhaustive_bool_arms, at)
                        return 31 if not region_escape_provenance_expression_terminates_with_metadata(exhaustive_bool_match, region_context)
                        ordinary_match: darray[Ast::Stmt] @source = [Ast::Stmt.Match(raise_call, catch_shape_arms, at)]
                        return 7 if not try_noncall_statements_may_raise_catchably_with_annotations(ordinary_match, annotations, "Right")
                        nested_catch_block: Ast::Expr = Ast::Expr.Block([Ast::Stmt.Match(raise_call, catch_shape_arms, at)], Ast::Expr.IntLit(0, at), [], at)
                        return 19 if not region_escape_provenance_expression_terminates_with_metadata(nested_catch_block, region_context)
                        region_context.markers <- [right_marker]
                        return 20 if region_escape_provenance_expression_terminates_with_metadata(nested_catch_block, region_context)
                        region_value_names: darray[sview @source] @source = ["value"]
                        region_value_regions: darray[sview @source] @source = ["inner"]
                        region_nesting: darray[sview @source] @source = ["outer", "inner"]
                        region_annotations: darray[Ast::LocalRegionAnnotation] @source = []
                        region_view_fns: darray[sview @source] @source = []
                        region_container_fns: darray[sview @source] @source = []
                        nested_catch_value_block: Ast::Expr = Ast::Expr.Block([Ast::Stmt.Match(raise_call, catch_shape_arms, at)], Ast::Expr.Ident("value", at), [], at)
                        region_context.markers <- [left_marker]
                        wrong_owner_region: sview @source = effective_value_region(nested_catch_value_block, region_annotations, region_view_fns, region_nesting, region_value_names, region_value_regions, at.line, region_context)
                        return 22 if wrong_owner_region != ""
                        region_context.markers <- [right_marker]
                        right_owner_region: sview @source = effective_value_region(nested_catch_value_block, region_annotations, region_view_fns, region_nesting, region_value_names, region_value_regions, at.line, region_context)
                        return 23 if right_owner_region != "inner"

                        value_region_annotations: darray[Ast::LocalRegionAnnotation] @source = [
                            Ast::LocalRegionAnnotation{name: "value", type_expression: Ast::Expr.Invalid, region: "outer", line: at.line, end_line: 0},
                            Ast::LocalRegionAnnotation{name: "dead", type_expression: Ast::Expr.Invalid, region: "inner", line: at.line, end_line: 0}
                        ]
                        literal_match_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Literal("true"), body: [Ast::Stmt.Expr(Ast::Expr.Ident("value", at), at)], guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Literal("false"), body: [Ast::Stmt.Expr(Ast::Expr.Ident("dead", at), at)], guard: Ast::Expr.Absent, pos: at}
                        ]
                        literal_match_value: Ast::Expr = Ast::Expr.Match(Ast::Expr.BoolLit(true, at), literal_match_arms, at)
                        stored_literal_match_region: sview @source = stored_value_region(literal_match_value, value_region_annotations, region_view_fns, region_nesting, at.line, region_context)
                        return 25 if stored_literal_match_region != "outer"
                        effective_literal_match_region: sview @source = effective_value_region(literal_match_value, region_annotations, region_view_fns, region_nesting, ["value", "dead"], ["outer", "inner"], at.line, region_context)
                        return 26 if effective_literal_match_region != "outer"

                        literal_catch_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Binding("success"), body: [Ast::Stmt.Expr(Ast::Expr.Ident("dead", at), at)], guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [Ast::Stmt.Expr(Ast::Expr.Ident("value", at), at)], guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Variant("error::Fault", []), body: [Ast::Stmt.Expr(Ast::Expr.Ident("dead", at), at)], guard: Ast::Expr.Absent, pos: at}
                        ]
                        literal_catch_value: Ast::Expr = Ast::Expr.Catch(raise_call, literal_catch_arms, at)
                        stored_literal_catch_region: sview @source = stored_value_region(literal_catch_value, value_region_annotations, region_view_fns, region_nesting, at.line, region_context)
                        return 27 if stored_literal_catch_region != "outer"
                        effective_literal_catch_region: sview @source = effective_value_region(literal_catch_value, region_annotations, region_view_fns, region_nesting, ["value", "dead"], ["outer", "inner"], at.line, region_context)
                        return 28 if effective_literal_catch_region != "outer"

                        guard_mutation_condition: Ast::Expr = Ast::Expr.Block([Ast::Stmt.Match(raise_call, catch_shape_arms, at)], Ast::Expr.BoolLit(true, at), [], at)
                        guard_push: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("xs", at), "push", at), [Ast::Expr.Ident("value", at)], [], at)
                        guard_mutation_value: Ast::Expr = Ast::Expr.If(guard_mutation_condition, guard_push, Ast::Expr.IntLit(0, at), at)
                        guard_mutation_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [Ast::Stmt.Expr(Ast::Expr.Index(Ast::Expr.Ident("xs", at), Ast::Expr.IntLit(0, at), at), at)], guard: guard_mutation_value, pos: at}
                        guard_mutation_match: Ast::Expr = Ast::Expr.Match(Ast::Expr.BoolLit(true, at), [guard_mutation_arm], at)
                        guard_mutation_names: darray[sview @source] @source = ["xs", "value"]
                        guard_mutation_regions: darray[sview @source] @source = ["", "inner"]
                        guarded_mutation_region: sview @source = effective_value_region(guard_mutation_match, region_annotations, region_view_fns, region_nesting, guard_mutation_names, guard_mutation_regions, at.line, region_context)
                        return 35 if guarded_mutation_region != "inner"

                        statement_guard_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [], guard: guard_mutation_value, pos: at}
                        statement_guard_match: Ast::Stmt = Ast::Stmt.Match(Ast::Expr.BoolLit(true, at), [statement_guard_arm], at)
                        statement_guard_body: darray[Ast::Stmt] @source = [statement_guard_match]
                        statement_guard_names: mutable darray[sview @source] @source = ["xs", "value"]
                        statement_guard_regions: mutable darray[sview @source] @source = ["", "inner"]
                        statement_guard_element_names: mutable darray[sview @source] @source = []
                        statement_guard_element_regions: mutable darray[sview @source] @source = []
                        region_escape_body_apply_statements_with_elements(statement_guard_body, region_annotations, region_view_fns, region_container_fns, region_nesting, statement_guard_names, statement_guard_regions, statement_guard_element_names, statement_guard_element_regions, region_context)
                        return 50 if region_escape_element_taint_lookup(statement_guard_element_names, statement_guard_element_regions, "xs") != "inner"

                        catch_array: Ast::Expr = Ast::Expr.Array([nested_catch_value_block], at)
                        catch_array_declaration: Ast::Stmt = Ast::Stmt.VarDecl("items", Ast::Expr.Absent, catch_array, at)
                        catch_array_body: darray[Ast::Stmt] @source = [catch_array_declaration]
                        catch_array_names: mutable darray[sview @source] @source = []
                        catch_array_regions: mutable darray[sview @source] @source = []
                        catch_array_element_names: mutable darray[sview @source] @source = []
                        catch_array_element_regions: mutable darray[sview @source] @source = []
                        region_escape_body_apply_statements_with_elements(catch_array_body, region_annotations, region_view_fns, region_container_fns, region_nesting, catch_array_names, catch_array_regions, catch_array_element_names, catch_array_element_regions, region_context)
                        return 51 if region_escape_element_taint_lookup(catch_array_element_names, catch_array_element_regions, "items") != "inner"

                        both_annotations: darray[Ast::EnumAnnotation] @source = [left_marker, right_marker]
                        table.protocol_annotations <- both_annotations
                        region_context.markers <- both_annotations
                        return 18 if not region_escape_catch_marker_matches(at, region_context)
                        return 8 if not progress_is_catch_match(table, at)
                        return 9 if not statement_match_is_catch(table, at)
                        return 10 if not cos_is_catch(table, at.line, at.offset, "Right")
                        return 11 if not cpb_is_catch(both_annotations, at.line, at.offset, "Right")

                        catch_table: mutable SymbolTable = SymbolTable(false)
                        catch_table.current_module <- "Right"
                        catch_table.protocol_annotations <- both_annotations
                        catch_table <- check_unreachable_arms(catchall_arms, catch_table, at)
                        return 12 if catch_table.diagnostics.count != 0

                        catch_scalar_table: mutable SymbolTable = SymbolTable(false)
                        catch_scalar_table.current_module <- "Right"
                        catch_scalar_table.protocol_annotations <- both_annotations
                        catch_scalar_table <- check_scalar_match_arm_types(Ast::Expr.IntLit(1, at), invalid_scalar_arm, at, scalar_names, scalar_types, catch_scalar_table)
                        return 13 if catch_scalar_table.diagnostics.count != 0
                        return 14 if try_noncall_statements_may_raise_catchably_with_annotations(ordinary_match, both_annotations, "Right")

                        variant_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Variant("Missing.Fault", []), body: [], guard: Ast::Expr.Absent, pos: at}
                        marked_declaration_body: darray[Ast::Stmt] @source = [Ast::Stmt.Match(Ast::Expr.Ident("value", at), [variant_arm], at)]
                        marked_function: darray[Ast::Decl] @source = [Ast::Decl.Func("run", [], null, marked_declaration_body, [], [], at)]
                        marked_module: Ast::Decl = Ast::Decl.Module("Right", marked_function, at)
                        marked_modules: darray[Ast::Decl] @source = [marked_module]
                        left_only_table: mutable SymbolTable = SymbolTable(false)
                        left_only_table.protocol_annotations <- [left_marker]
                        left_only_table <- cav_walk_declarations("", marked_modules, left_only_table)
                        return 15 if left_only_table.diagnostics.count != 0
                        right_only_table: mutable SymbolTable = SymbolTable(false)
                        right_only_table.protocol_annotations <- [right_marker]
                        right_only_table <- cav_walk_declarations("", marked_modules, right_only_table)
                        return 16 if right_only_table.diagnostics.count != 1
                        return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Semantic::catch_marker_module_identity_probe() can Global{Read,Write}
