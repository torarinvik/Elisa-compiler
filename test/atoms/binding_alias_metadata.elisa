extend Semantic:
    public:
        def compiler_binding_alias_metadata_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                table: mutable SymbolTable = SymbolTable(false)
                rows: darray[Ast::EnumAnnotation] @source = [
                    Ast::EnumAnnotation{owner: "First", name: "__using_alias", line: 1, offset: 10},
                    Ast::EnumAnnotation{owner: "Actual", name: "__using_alias_target", line: 1, offset: 10},
                    Ast::EnumAnnotation{owner: "Second", name: "__using_alias", line: 2, offset: 20},
                    Ast::EnumAnnotation{owner: "First::Nested", name: "__using_alias_target", line: 2, offset: 20}
                ]
                table <- binding_import_metadata(rows, table)
                return 1 if table.binding_import_annotations.count != 4
                return 2 if table.binding_import_annotations[3].owner != "Actual::Nested"
                rebind earlier: sview @source, table = binding_resolve_module_alias_target("First::Child", "", 10, table)
                return 3 if earlier != "First::Child"
                rebind later: sview @source, table = binding_resolve_module_alias_target("First::Child", "", 11, table)
                return 4 if later != "Actual::Child"
                rebind chained: sview @source, table = binding_resolve_module_alias_target("Second::Leaf", "", 21, table)
                return 5 if chained != "Actual::Nested::Leaf"
                rebind scoped: sview @source, table = binding_resolve_module_alias_target("Missing", "Client", 21, table)
                return 6 if scoped != "Client::Missing"
                return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_binding_alias_metadata_probe() can Global{Read,Write}
