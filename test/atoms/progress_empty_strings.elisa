extend Semantic:
    public:
        def compiler_progress_empty_strings_probe() -> i64 can[Abort.Panic]:
            at: Ast::Pos = zeroed
            empty: Ast::Expr = Ast::Expr.StringLit("", at)
            one_char: Ast::Expr = Ast::Expr.StringLit("x", at)
            two_chars: Ast::Expr = Ast::Expr.StringLit("ab", at)
            wrapped_empty: Ast::Expr = Ast::Expr.Paren(empty, at)

            return 1 if not progress_empty_iterable(empty)
            return 2 if progress_empty_iterable(one_char) or progress_empty_iterable(two_chars)
            return 3 if not progress_empty_iterable(wrapped_empty)
            return 4 if flow_iterable_is_provably_nonempty(empty) or flow_iterable_is_provably_nonempty(wrapped_empty)
            return 5 if not flow_iterable_is_provably_nonempty(one_char)
            return 6 if not flow_iterable_is_provably_nonempty(two_chars)
            return 0

def main() -> i64 can[Abort.Panic]:
    return Semantic::compiler_progress_empty_strings_probe() can[Global{Read,Write}]
