extend Semantic:
    public:
        def compiler_firm_extern_index_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                declarations: darray[Ast::Decl] @source = [
                    Ast::Decl.Extern("duplicate", 0, 1, false, true, "", [], at),
                    Ast::Decl.Extern("unrelated", 1, 1, false, true, "", [], at),
                    Ast::Decl.Extern("duplicate", 2, 1, false, true, "", [], at)
                ]
                parameters: darray[Ast::ExternParam] @source = [
                    Ast::ExternParam{name: "first", type_name: "cstr", provenance_bearing: false, mutable_ref: false, pos: at, is_ref: false, optional: false},
                    Ast::ExternParam{name: "other", type_name: "i64", provenance_bearing: false, mutable_ref: false, pos: at, is_ref: false, optional: false},
                    Ast::ExternParam{name: "second", type_name: "u8&", provenance_bearing: false, mutable_ref: false, pos: at, is_ref: false, optional: false}
                ]
                table: mutable SymbolTable = SymbolTable(false)
                table <- index_firm_externs(declarations, table)
                duplicate_type: sview = extern_parameter_type_at_firm("duplicate", 0, declarations, parameters, table)
                unrelated_type: sview = extern_parameter_type_at_firm("unrelated", 0, declarations, parameters, table)
                return 1 if duplicate_type != ""
                return 2 if unrelated_type != "i64"
                cstr_argument: InferType = InferType{kind: SemTypeKind.String, name: "cstr"}
                return 3 if not extern_has_compatible_firm_parameter("duplicate", 0, cstr_argument, declarations, parameters, table)
                return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_firm_extern_index_probe() can Global{Read,Write}
