extend Semantic:
    public:
        def compiler_holder_parallel_rebind_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                holder: Ast::Expr = Ast::Expr.Ident("holder", at)
                buffer: Ast::Expr = Ast::Expr.Ident("buffer", at)
                view: Ast::Expr = Ast::Expr.Ident("view", at)
                scratch: Ast::Expr = Ast::Expr.Ident("scratch", at)
                view_value: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(buffer, "as_sview", at), [], [], at)
                scalar_value: Ast::Expr = Ast::Expr.IntLit(0, at)
                targets: Ast::Expr = Ast::Expr.Array([Ast::Expr.Ident("__rb_1_0", at), Ast::Expr.Ident("__rb_1_1", at)], at)
                tuple: Ast::Expr = Ast::Expr.Paren(Ast::Expr.Tuple([view_value, scalar_value], at), at)
                store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [holder, view], ["", ""], at)
                parallel: Ast::Stmt = Ast::Stmt.Assign(targets, TokenKind.Assign, tuple, at)
                land_view: Ast::Stmt = Ast::Stmt.Assign(view, TokenKind.LArrow, Ast::Expr.Ident("__rb_1_0", at), at)
                land_scratch: Ast::Stmt = Ast::Stmt.Assign(scratch, TokenKind.LArrow, Ast::Expr.Ident("__rb_1_1", at), at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "buffer", true, false, false)
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder"]
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                summary: StoreThroughSummary = zeroed
                table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements([parallel, land_view, land_scratch, Ast::Stmt.Expr(store, at)], false, ref_params, names, names, names, values, &flow, summary, table_diagnostics, table)
                table.diagnostics.extend(table_diagnostics)
                return 1 if table.diagnostics.count != 1
                view_index: usize = chv_flow_latest(flow, "view")
                scratch_index: usize = chv_flow_latest(flow, "scratch")
                return 2 if view_index >= flow.names.count or not flow.may_owned_view[view_index]
                return 3 if scratch_index >= flow.names.count or flow.may_owned_view[scratch_index]
                return 0

        def compiler_holder_for_iterable_taint_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                holder: Ast::Expr = Ast::Expr.Ident("holder", at)
                borrowed: Ast::Expr = Ast::Expr.Ident("borrowed", at)
                item: Ast::Expr = Ast::Expr.Ident("item", at)
                alias: Ast::Expr = Ast::Expr.Ident("alias", at)
                safe_view: Ast::Expr = Ast::Expr.Ident("safe_view", at)
                store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [holder, alias], ["", ""], at)
                view_iterable: Ast::Expr = Ast::Expr.Array([borrowed], at)
                loop: Ast::Stmt = Ast::Stmt.For("", ["item", "alias"], view_iterable, [Ast::Stmt.Expr(store, at)], at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "holder", false, false, true)
                chv_flow_bind(flow, "borrowed", false, true, false)
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder"]
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                summary: StoreThroughSummary = zeroed
                table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements([loop], false, ref_params, names, names, names, values, &flow, summary, table_diagnostics, table)
                table.diagnostics.extend(table_diagnostics)
                return 1 if table.diagnostics.count != 1
                return 2 if chv_flow_latest(flow, "item") < flow.names.count
                return 3 if chv_flow_latest(flow, "alias") < flow.names.count

                bytes: Ast::Expr = Ast::Expr.Ident("bytes", at)
                byte: Ast::Expr = Ast::Expr.Ident("byte", at)
                scalar_store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [holder, byte], ["", ""], at)
                scalar_loop: Ast::Stmt = Ast::Stmt.For("", ["byte"], bytes, [Ast::Stmt.Expr(scalar_store, at)], at)
                scalar_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(scalar_flow, "holder", false, false, true)
                chv_flow_bind(scalar_flow, "bytes", true, false, false)
                scalar_table: mutable SymbolTable = SymbolTable(false)
                scalar_summary: StoreThroughSummary = zeroed
                scalar_table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements([scalar_loop], false, ref_params, names, names, names, values, &scalar_flow, scalar_summary, scalar_table_diagnostics, scalar_table)
                scalar_table.diagnostics.extend(scalar_table_diagnostics)
                return 4 if scalar_table.diagnostics.count != 0

                alias_source: Ast::Expr = Ast::Expr.Ident("alias_source", at)
                alias_store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [alias, safe_view], ["", ""], at)
                safe_ref: Ast::Expr = Ast::Expr.Ident("safe_ref", at)
                safe_ref_iterable: Ast::Expr = Ast::Expr.Array([safe_ref], at)
                safe_ref_loop: Ast::Stmt = Ast::Stmt.For("", ["alias"], safe_ref_iterable, [Ast::Stmt.Expr(alias_store, at)], at)
                safe_ref_flow: mutable CHVViewFlow = CHVViewFlow{}
                safe_alias_summary: StoreThroughSummary = zeroed
                chv_flow_bind(safe_ref_flow, "safe_ref", false, false, false)
                chv_flow_bind(safe_ref_flow, "safe_view", false, true, false)
                safe_ref_table: mutable SymbolTable = SymbolTable(false)
                safe_ref_table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements([safe_ref_loop], false, ref_params, names, names, names, values, &safe_ref_flow, safe_alias_summary, safe_ref_table_diagnostics, safe_ref_table)
                safe_ref_table.diagnostics.extend(safe_ref_table_diagnostics)
                return 5 if safe_ref_table.diagnostics.count != 0

                alias_ref_iterable: Ast::Expr = Ast::Expr.Array([alias_source], at)
                alias_ref_loop: Ast::Stmt = Ast::Stmt.For("", ["alias"], alias_ref_iterable, [Ast::Stmt.Expr(alias_store, at)], at)
                alias_ref_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(alias_ref_flow, "alias_source", false, false, true)
                chv_flow_bind(alias_ref_flow, "safe_view", false, true, false)
                alias_ref_table: mutable SymbolTable = SymbolTable(false)
                alias_ref_table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements([alias_ref_loop], false, ref_params, names, names, names, values, &alias_ref_flow, safe_alias_summary, alias_ref_table_diagnostics, alias_ref_table)
                alias_ref_table.diagnostics.extend(alias_ref_table_diagnostics)
                return 6 if alias_ref_table.diagnostics.count != 1

                ref_collection: Ast::Expr = Ast::Expr.Ident("ref_collection", at)
                ref_collection_loop: Ast::Stmt = Ast::Stmt.For("", ["alias"], ref_collection, [Ast::Stmt.Expr(alias_store, at)], at)
                ref_collection_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(ref_collection_flow, "safe_view", false, true, false)
                ref_collection_table: mutable SymbolTable = SymbolTable(false)
                ref_collection_params: darray[sview] = ["holder", "ref_collection"]
                ref_collection_table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements([ref_collection_loop], false, ref_collection_params, names, names, names, values, &ref_collection_flow, safe_alias_summary, ref_collection_table_diagnostics, ref_collection_table)
                ref_collection_table.diagnostics.extend(ref_collection_table_diagnostics)
                return 7 if ref_collection_table.diagnostics.count != 1

                alias_iterable: Ast::Expr = alias_source
                alias_loop: Ast::Stmt = Ast::Stmt.For("", ["item", "alias"], alias_iterable, [Ast::Stmt.Expr(alias_store, at)], at)
                alias_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(alias_flow, "alias_source", false, false, true)
                chv_flow_bind(alias_flow, "safe_view", false, true, false)
                alias_table: mutable SymbolTable = SymbolTable(false)
                alias_summary: StoreThroughSummary = zeroed
                alias_table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements([alias_loop], false, ref_params, names, names, names, values, &alias_flow, alias_summary, alias_table_diagnostics, alias_table)
                alias_table.diagnostics.extend(alias_table_diagnostics)
                return 8 if alias_table.diagnostics.count != 0
                return 9 if chv_flow_latest(alias_flow, "alias") < alias_flow.names.count

                mutable_alias_loop: Ast::Stmt = Ast::Stmt.For("mutable", ["item", "alias"], alias_iterable, [Ast::Stmt.Expr(alias_store, at)], at)
                mutable_alias_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(mutable_alias_flow, "alias_source", false, false, true)
                chv_flow_bind(mutable_alias_flow, "safe_view", false, true, false)
                mutable_alias_table: mutable SymbolTable = SymbolTable(false)
                mutable_alias_table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements([mutable_alias_loop], false, ref_params, names, names, names, values, &mutable_alias_flow, alias_summary, mutable_alias_table_diagnostics, mutable_alias_table)
                mutable_alias_table.diagnostics.extend(mutable_alias_table_diagnostics)
                return 10 if mutable_alias_table.diagnostics.count != 1
                return 11 if chv_flow_latest(mutable_alias_flow, "alias") < mutable_alias_flow.names.count

                alias_result: Ast::Expr = Ast::Expr.Ident("alias_result", at)
                comprehension_item: Ast::Expr = Ast::Expr.Ident("item", at)
                comprehension_iterable: Ast::Expr = Ast::Expr.Array([alias_source], at)
                reference_comprehension: Ast::Expr = Ast::Expr.Comprehension("item", comprehension_iterable, Ast::Expr.Absent, comprehension_item, at, 0)
                comprehension_store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [alias_result, safe_view], ["", ""], at)
                comprehension_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(comprehension_flow, "alias_source", false, false, true)
                chv_flow_bind(comprehension_flow, "safe_view", false, true, false)
                comprehension_table: mutable SymbolTable = SymbolTable(false)
                comprehension_assign: Ast::Stmt = Ast::Stmt.Assign(alias_result, TokenKind.LArrow, reference_comprehension, at)
                comprehension_table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements([comprehension_assign, Ast::Stmt.Expr(comprehension_store, at)], false, ref_params, names, names, names, values, &comprehension_flow, alias_summary, comprehension_table_diagnostics, comprehension_table)
                comprehension_table.diagnostics.extend(comprehension_table_diagnostics)
                return 12 if comprehension_table.diagnostics.count != 1
                alias_result_index: usize = chv_flow_latest(comprehension_flow, "alias_result")
                return 13 if alias_result_index >= comprehension_flow.names.count or not comprehension_flow.may_alias_reference[alias_result_index]
                return 0

        def compiler_holder_conditional_rebind_probe() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                alias: Ast::Expr = Ast::Expr.Ident("alias", at)
                alias_source: Ast::Expr = Ast::Expr.Ident("alias_source", at)
                safe_view: Ast::Expr = Ast::Expr.Ident("safe_view", at)
                condition: Ast::Expr = Ast::Expr.Ident("condition", at)
                assignment: Ast::Stmt = Ast::Stmt.Assign(alias, TokenKind.LArrow, alias_source, at)
                branch: Ast::Stmt = Ast::Stmt.If(condition, [assignment], [], at)
                store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [alias, safe_view], ["", ""], at)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "alias", false, false, false)
                chv_flow_bind(flow, "alias_source", false, false, true)
                chv_flow_bind(flow, "safe_view", false, true, false)
                summary: StoreThroughSummary = zeroed
                table: mutable SymbolTable = SymbolTable(false)
                ref_params: darray[sview] = ["holder"]
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements([branch, Ast::Stmt.Expr(store, at)], false, ref_params, names, names, names, values, &flow, summary, table_diagnostics, table)
                table.diagnostics.extend(table_diagnostics)
                alias_index: usize = chv_flow_latest(flow, "alias")
                return false if alias_index >= flow.names.count or not flow.may_alias_reference[alias_index]
                return false if table.diagnostics.count != 1

                shadow_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(shadow_flow, "alias", false, false, false)
                chv_flow_bind(shadow_flow, "alias_source", false, false, true)
                chv_flow_bind(shadow_flow, "safe_view", false, true, false)
                shadow_table: mutable SymbolTable = SymbolTable(false)
                shadow_assignment: Ast::Stmt = Ast::Stmt.Assign(alias, TokenKind.Assign, alias_source, at)
                shadow_branch: Ast::Stmt = Ast::Stmt.If(condition, [shadow_assignment], [], at)
                shadow_table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_statements([shadow_branch, Ast::Stmt.Expr(store, at)], false, ref_params, names, names, names, values, &shadow_flow, summary, shadow_table_diagnostics, shadow_table)
                shadow_table.diagnostics.extend(shadow_table_diagnostics)
                shadow_index: usize = chv_flow_latest(shadow_flow, "alias")
                return shadow_table.diagnostics.count == 0 and shadow_index < shadow_flow.names.count and not shadow_flow.may_alias_reference[shadow_index]

        def compiler_holder_lambda_parameter_role_probe() -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                binders: darray[sview] = []
                owned: darray[sview] = []
                view_names: darray[sview] = []
                view_values: darray[Ast::Expr] = []
                summary: StoreThroughSummary = zeroed

                # An untyped lambda parameter may be an sview; storing it through a captured
                # mutable Holder reference must retain both possible roles.
                captured_holder_flow: mutable CHVViewFlow = CHVViewFlow{}
                captured_holder_table: mutable SymbolTable = SymbolTable(false)
                holder: Ast::Expr = Ast::Expr.Ident("holder", at)
                view_parameter: Ast::Expr = Ast::Expr.Ident("view_parameter", at)
                captured_holder_store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [holder, view_parameter], ["", ""], at)
                view_parameter_lambda: Ast::Expr = Ast::Expr.Lambda(["view_parameter"], [Ast::Stmt.Expr(captured_holder_store, at)], at)
                captured_holder_refs: darray[sview] = ["holder"]
                captured_holder_table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_expression(view_parameter_lambda, false, captured_holder_refs, binders, owned, view_names, view_values, &captured_holder_flow, summary, captured_holder_table_diagnostics, captured_holder_table)
                captured_holder_table.diagnostics.extend(captured_holder_table_diagnostics)
                return false if captured_holder_table.diagnostics.count != 1

                # Conversely, a lambda parameter may be a mutable Holder reference while the
                # lambda closes over a local view that an opaque call could store through it.
                captured_view_flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(&captured_view_flow, "captured_view", false, true, false)
                captured_view_table: mutable SymbolTable = SymbolTable(false)
                holder_parameter: Ast::Expr = Ast::Expr.Ident("holder_parameter", at)
                captured_view: Ast::Expr = Ast::Expr.Ident("captured_view", at)
                captured_view_store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [holder_parameter, captured_view], ["", ""], at)
                holder_parameter_lambda: Ast::Expr = Ast::Expr.Lambda(["holder_parameter"], [Ast::Stmt.Expr(captured_view_store, at)], at)
                no_outer_refs: darray[sview] = []
                captured_view_table_diagnostics: mutable darray[Diagnostic] = []
                chv_walk_expression(holder_parameter_lambda, false, no_outer_refs, binders, owned, view_names, view_values, &captured_view_flow, summary, captured_view_table_diagnostics, captured_view_table)
                captured_view_table.diagnostics.extend(captured_view_table_diagnostics)
                return false if captured_view_table.diagnostics.count != 1

                # Exercise the declaration walker too: a zero-parameter function can create an
                # owned view locally, then pass a closure to an opaque callback. The closure's
                # untyped parameter may be a mutable Holder reference, so its body still needs
                # the conservative lambda-role analysis even though the enclosing signature has
                # no reference-bearing parameters.
                region owner(1048576):
                    node_store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in node_store:
                        empty_member: Ast::StructMember = Ast::StructMember{is_private: false, name: "", type_expression: Ast::Expr.Invalid, omittable: false, is_ghost: false, has_default: false, default_value: Ast::Expr.Invalid, region: "", bit_group_kind: "", bit_group_members: []}
                        holder_member: Ast::StructMember = empty_member{name = "view", type_expression = Ast::Expr.Ident("sview", at)}
                        holder_decl: Ast::Decl = Ast::Decl.Struct("Holder", [holder_member], "", false, false, [], at)
                        buffer_type: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("darray", at), Ast::Expr.Ident("u8", at), at)
                        buffer_value: Ast::Expr = Ast::Expr.Array([Ast::Expr.IntLit(65, at)], at)
                        local_buffer: Ast::Expr = Ast::Expr.Ident("local_buffer", at)
                        local_view_value: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(local_buffer, "as_sview", at), [], [], at)
                        callback_holder: Ast::Expr = Ast::Expr.Ident("callback_holder", at)
                        captured_local_view: Ast::Expr = Ast::Expr.Ident("local_view", at)
                        callback_store: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [callback_holder, captured_local_view], ["", ""], at)
                        escaping_lambda: Ast::Expr = Ast::Expr.Lambda(["callback_holder"], [Ast::Stmt.Expr(callback_store, at)], at)
                        dispatch: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("dispatch", at), [escaping_lambda], [""], at)
                        declaration_body: darray[Ast::Stmt] @source = [
                            Ast::Stmt.VarDecl("local_buffer", buffer_type, buffer_value, at),
                            Ast::Stmt.VarDecl("local_view", Ast::Expr.Ident("sview", at), local_view_value, at),
                            Ast::Stmt.Expr(dispatch, at)
                        ]
                        declaration_function: Ast::Decl = Ast::Decl.Func("no_parameter_lambda", [], null, declaration_body, [], [], at)
                        empty_file: Ast::File = zeroed
                        declaration_decls: darray[Ast::Decl] @source = [holder_decl, declaration_function]
                        declaration_file: Ast::File = empty_file{top_decls = declaration_decls}
                        declaration_table: mutable SymbolTable = SymbolTable(false)
                        declaration_table <- check_call_holder_view_store(&declaration_file, declaration_table) can Global{Read,Write}
                        return declaration_table.diagnostics.count == 1

