extend Parser:
    public:
        def compiler_type_region_suffix_probe(source: u8& @source) -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                length: mutable usize = 0
                while source[length] != 0 |length|:
                    length <- length + 1
                tokens: darray[Token] @source = frontend_tokenize_with_length(source, source, length)
                parser: mutable Parser = Parser(source, length, tokens)
                region owner(1048576):
                    node_store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in node_store:
                        first_at: Ast::Pos = Ast::Pos{line: 1, column: 6, offset: 5, end_line: 1, end_column: 11, end_offset: 10}
                        second_at: Ast::Pos = Ast::Pos{line: 1, column: 21, offset: 20, end_line: 1, end_column: 26, end_offset: 25}
                        value_at: Ast::Pos = Ast::Pos{line: 1, column: 31, offset: 30, end_line: 1, end_column: 36, end_offset: 35}
                        parser.in_type_annotation <- true
                        parser <- parser.record_type_region_suffix(Ast::Expr.Ident("sview", first_at))
                        parser <- parser.record_type_region_suffix(Ast::Expr.Ident("sview", second_at))
                        parser.in_type_annotation <- false
                        parser <- parser.record_type_region_suffix(Ast::Expr.Ident("sview", value_at))
                return 1 if parser.errors.count != 0 or parser.peek() != TokenKind.Eof
                count: mutable usize = 0
                for annotation in parser.enum_annotations |count|:
                    continue if annotation.owner != "__type_region"
                    return 2 if annotation.name != "source"
                    return 3 if annotation.offset != 5 and annotation.offset != 20
                    count <- count + 1
                return 4 if count != 2
                return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Parser::compiler_type_region_suffix_probe("@source @source @ignored") can Global{Read,Write}
