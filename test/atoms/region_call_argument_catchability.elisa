extend Semantic:
    public:
        def compiler_region_call_argument_catchability_probe() -> i64 can[Abort.Panic, Memory.Allocate]:
            at: Ast::Pos = zeroed
            catch_context: RegionEscapeCatchContext = RegionEscapeCatchContext{markers: [], lexical_module: ""}
            raised: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("raise", at), [Ast::Expr.IntLit(0, at)], [], at)

            nested_raise: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("consume", at), [raised], [""], at)
            return 1 if not region_escape_provenance_catchable_raise_with_metadata(nested_raise, catch_context)

            panic_argument: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("panic", at), [], [], at)
            raise_after_panic: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("consume", at), [panic_argument, raised], ["", ""], at)
            return 2 if region_escape_provenance_catchable_raise_with_metadata(raise_after_panic, catch_context)
            return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_region_call_argument_catchability_probe() can[Global{Read,Write}]
