extend Semantic:
    public:
        def compiler_foreign_handle_case(body: darray[Ast::Stmt] @source, expected: usize, table: SymbolTable) -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                working_table: mutable SymbolTable = table
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "out", false, false, true)
                chv_flow_bind(flow, "bytes", true, false, false)
                summary: StoreThroughSummary = zeroed
                ref_params: darray[sview] = ["out"]
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                working_table <- chv_walk_statements(body, false, ref_params, names, names, names, values, flow, summary, working_table)
                return working_table.diagnostics.count == expected and all diagnostic in working_table.diagnostics where diagnostic.kind == DiagnosticKind.AutoRegionStoreEscape

        def compiler_foreign_handle_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    node_store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in node_store:
                        at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                        declarations: darray[Ast::Decl] @source = [
                            Ast::Decl.Extern("ForeignHandle", 0, 0, false, false, "", [], at),
                            Ast::Decl.Extern("foreign_counter", 0, 0, false, false, "u32", [], at),
                            Ast::Decl.Extern("make_foreign_handle", 0, 1, false, true, "ForeignHandle", [], at)
                        ]
                        annotations: darray[Ast::EnumAnnotation] = []
                        table: mutable SymbolTable = SymbolTable(false)
                        table <- collect_range(declarations, table, annotations)
                        handle_type: Ast::Expr = Ast::Expr.Ident("ForeignHandle", at)
                        qualified_handle_type: Ast::Expr = Ast::Expr.Scope(Ast::Expr.Ident("FFI", at), "ForeignHandle", at)
                        mutable_handle: Ast::Expr = Ast::Expr.Unary(TokenKind.Mutable, handle_type, at)
                        return 1 if not table.symbols[0].opaque_extern_type or table.symbols[1].opaque_extern_type or table.symbols[2].opaque_extern_type
                        return 2 if not chv_type_is_foreign_handle(handle_type, table) or not chv_type_is_foreign_handle(mutable_handle, table) or not chv_type_is_foreign_handle(qualified_handle_type, table)
                        return 3 if chv_type_is_foreign_handle(Ast::Expr.Unary(TokenKind.Ampersand, handle_type, at), table)
                        return 4 if chv_type_is_foreign_handle(Ast::Expr.Ident("foreign_counter", at), table)
                        bytes: Ast::Expr = Ast::Expr.Ident("bytes", at)
                        borrowed: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(bytes, "as_cstr", at), [], [], at)
                        made: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("make_foreign_handle", at), [borrowed], [""], at)
                        handle: Ast::Expr = Ast::Expr.Ident("handle", at)
                        out: Ast::Expr = Ast::Expr.Ident("out", at)
                        push: Ast::Stmt = Ast::Stmt.Expr(Ast::Expr.Call(Ast::Expr.Field(out, "push", at), [handle], [""], at), at)
                        declaration: Ast::Stmt = Ast::Stmt.VarDecl("handle", mutable_handle, made, at)
                        positive: darray[Ast::Stmt] @source = [declaration, push]
                        # The opaque type may hold a borrow; absent an explicit
                        # no-retention contract, its source view must stay tainted.
                        return 5 if not compiler_foreign_handle_case(positive, 1, table)
                        view_body: darray[Ast::Stmt] @source = [Ast::Stmt.VarDecl("handle", Ast::Expr.Ident("cstr", at), borrowed, at), push]
                        return 6 if not compiler_foreign_handle_case(view_body, 1, table)
                        assign: Ast::Stmt = Ast::Stmt.Assign(handle, TokenKind.LArrow, made, at)
                        reassigned: darray[Ast::Stmt] @source = [declaration, assign, push]
                        return 7 if not compiler_foreign_handle_case(reassigned, 1, table)
                        branch: Ast::Stmt = Ast::Stmt.If(Ast::Expr.BoolLit(true, at), [assign], [], at)
                        branched: darray[Ast::Stmt] @source = [declaration, branch, push]
                        return 8 if not compiler_foreign_handle_case(branched, 1, table)
                        shadow: Ast::Stmt = Ast::Stmt.Assign(handle, TokenKind.Assign, borrowed, at)
                        shadow_scope: Ast::Stmt = Ast::Stmt.Block("block", [], "", [shadow, push], at)
                        shadowed: darray[Ast::Stmt] @source = [declaration, shadow_scope]
                        return 9 if not compiler_foreign_handle_case(shadowed, 1, table)
                        storing: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("store_and_make_foreign_handle", at), [out, borrowed], ["", ""], at)
                        stores_argument: darray[Ast::Stmt] @source = [Ast::Stmt.VarDecl("handle", handle_type, storing, at), push]
                        return 10 if not compiler_foreign_handle_case(stores_argument, 1, table)
                        table.generic_param_names <- table.generic_param_names.push("ForeignHandle")
                        return 11 if chv_type_is_foreign_handle(handle_type, table)
                        table.generic_param_names <- []
                        table <- table.add_symbol("ForeignHandle", SymbolKind.Struct, 2)
                        return 12 if chv_type_is_foreign_handle(handle_type, table)
                        return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_foreign_handle_probe() can Global{Read,Write}
