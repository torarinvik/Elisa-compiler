extend Semantic:
    public:
        def compiler_foreign_handle_case(body: darray[Ast::Stmt] @source, expected: usize) -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                declarations: darray[Ast::Decl] @source = [
                    Ast::Decl.Extern("ForeignHandle", 0, 0, false, false, "", [], at),
                    Ast::Decl.Extern("make_foreign_handle", 0, 1, false, true, "ForeignHandle", [], at),
                    Ast::Decl.Extern("make_empty_foreign_handle", 0, 0, false, true, "ForeignHandle", [], at)
                ]
                annotations: darray[Ast::EnumAnnotation] = []
                table: mutable SymbolTable = SymbolTable(false)
                table <- collect_range(declarations, table, annotations)
                flow: mutable CHVViewFlow = CHVViewFlow{}
                chv_flow_bind(flow, "out", false, false, true)
                chv_flow_bind(flow, "bytes", true, false, false)
                summary: StoreThroughSummary = zeroed
                ref_params: darray[sview] = ["out"]
                names: darray[sview] = []
                values: darray[Ast::Expr] = []
                table <- chv_walk_statements(body, false, ref_params, names, names, names, values, flow, summary, table)
                return table.diagnostics.count == expected and all diagnostic in table.diagnostics where diagnostic.kind == DiagnosticKind.AutoRegionStoreEscape

        def compiler_foreign_handle_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    node_store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in node_store:
                        at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                        handle_type: Ast::Expr = Ast::Expr.Ident("ForeignHandle", at)
                        mutable_handle: Ast::Expr = Ast::Expr.Unary(TokenKind.Mutable, handle_type, at)
                        bytes: Ast::Expr = Ast::Expr.Ident("bytes", at)
                        borrowed: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(bytes, "as_cstr", at), [], [], at)
                        made: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("make_foreign_handle", at), [borrowed], [""], at)
                        safe_made: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("make_empty_foreign_handle", at), [], [], at)
                        handle: Ast::Expr = Ast::Expr.Ident("handle", at)
                        out: Ast::Expr = Ast::Expr.Ident("out", at)
                        push: Ast::Stmt = Ast::Stmt.Expr(Ast::Expr.Call(Ast::Expr.Field(out, "push", at), [handle], [""], at), at)
                        declaration: Ast::Stmt = Ast::Stmt.VarDecl("handle", mutable_handle, made, at)
                        positive: darray[Ast::Stmt] @source = [declaration, push]
                        # The opaque type may hold a borrow; absent an explicit
                        # no-retention contract, its source view must stay tainted.
                        return 1 if not compiler_foreign_handle_case(positive, 1)
                        view_body: darray[Ast::Stmt] @source = [Ast::Stmt.VarDecl("handle", Ast::Expr.Ident("cstr", at), borrowed, at), push]
                        return 2 if not compiler_foreign_handle_case(view_body, 1)
                        assign: Ast::Stmt = Ast::Stmt.Assign(handle, TokenKind.LArrow, made, at)
                        safe_declaration: Ast::Stmt = Ast::Stmt.VarDecl("handle", mutable_handle, safe_made, at)
                        safe_only: darray[Ast::Stmt] @source = [safe_declaration, push]
                        return 3 if not compiler_foreign_handle_case(safe_only, 0)
                        reassigned: darray[Ast::Stmt] @source = [safe_declaration, assign, push]
                        return 4 if not compiler_foreign_handle_case(reassigned, 1)
                        flag: Ast::Expr = Ast::Expr.Ident("flag", at)
                        branch: Ast::Stmt = Ast::Stmt.If(flag, [assign], [], at)
                        branched: darray[Ast::Stmt] @source = [safe_declaration, branch, push]
                        return 5 if not compiler_foreign_handle_case(branched, 1)
                        shadow: Ast::Stmt = Ast::Stmt.Assign(handle, TokenKind.Assign, borrowed, at)
                        shadow_scope: Ast::Stmt = Ast::Stmt.Block("block", [], "", [shadow, push], at)
                        shadowed: darray[Ast::Stmt] @source = [safe_declaration, shadow_scope]
                        return 6 if not compiler_foreign_handle_case(shadowed, 1)
                        storing: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("store_and_make_foreign_handle", at), [out, borrowed], ["", ""], at)
                        stores_argument: darray[Ast::Stmt] @source = [Ast::Stmt.Expr(storing, at)]
                        return 7 if not compiler_foreign_handle_case(stores_argument, 1)
                        return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_foreign_handle_probe() can Global{Read,Write}
