extend Semantic:
    public:
        def region_loop_tail_atom_probe() -> i64 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    at: Ast::Pos = zeroed
                    annotations: darray[Ast::LocalRegionAnnotation] @source = []
                    view_fns: darray[sview @source] @source = []
                    container_fns: darray[sview @source] @source = []
                    nesting: darray[sview @source] @source = ["outer", "inner"]
                    source_names: darray[sview @source] @source = ["a", "b", "inner_view"]
                    source_regions: darray[sview @source] @source = ["outer", "outer", "inner"]
                    empty_element_names: darray[sview @source] @source = []
                    empty_element_regions: darray[sview @source] @source = []
                    catch_lines: darray[u32] @source = []
                    copy_to_a: Ast::Stmt = Ast::Stmt.Assign(Ast::Expr.Ident("a", at), TokenKind.Assign, Ast::Expr.Ident("b", at), at)
                    install_inner_in_b: Ast::Stmt = Ast::Stmt.Assign(Ast::Expr.Ident("b", at), TokenKind.Assign, Ast::Expr.Ident("inner_view", at), at)
                    loop_body: darray[Ast::Stmt] @source = [copy_to_a, install_inner_in_b]

                    while_loop: Ast::Stmt = Ast::Stmt.While(Ast::Expr.Ident("condition", at), loop_body, at)
                    while_value_body: darray[Ast::Stmt] @source = [while_loop, Ast::Stmt.Expr(Ast::Expr.Ident("a", at), at)]
                    while_value: (found: bool, position: usize) = region_escape_body_value_region(while_value_body, null, annotations, view_fns, container_fns, nesting, source_names, source_regions, 10)
                    return 1 if not while_value.found or while_value.position != 1

                    for_loop: Ast::Stmt = Ast::Stmt.For("", ["item"], Ast::Expr.Ident("items", at), loop_body, at)
                    for_value_body: darray[Ast::Stmt] @source = [for_loop, Ast::Stmt.Expr(Ast::Expr.Ident("a", at), at)]
                    for_value: (found: bool, position: usize) = region_escape_body_value_region_with_elements(for_value_body, null, annotations, view_fns, container_fns, nesting, source_names, source_regions, empty_element_names, empty_element_regions, 10, catch_lines)
                    return 2 if not for_value.found or for_value.position != 1

                    never_loop: Ast::Stmt = Ast::Stmt.While(Ast::Expr.BoolLit(false, at), [install_inner_in_b], at)
                    never_value_body: darray[Ast::Stmt] @source = [never_loop, Ast::Stmt.Expr(Ast::Expr.Ident("b", at), at)]
                    never_value: (found: bool, position: usize) = region_escape_body_value_region_with_elements(never_value_body, null, annotations, view_fns, container_fns, nesting, source_names, source_regions, empty_element_names, empty_element_regions, 10, catch_lines)
                    return 3 if not never_value.found or never_value.position != 0

                    break_loop: Ast::Stmt = Ast::Stmt.While(Ast::Expr.Ident("condition", at), [install_inner_in_b, Ast::Stmt.Break("", at)], at)
                    break_value_body: darray[Ast::Stmt] @source = [break_loop, Ast::Stmt.Expr(Ast::Expr.Ident("b", at), at)]
                    break_value: (found: bool, position: usize) = region_escape_body_value_region_with_elements(break_value_body, null, annotations, view_fns, container_fns, nesting, source_names, source_regions, empty_element_names, empty_element_regions, 10, catch_lines)
                    return 4 if not break_value.found or break_value.position != 1

                    conditional_break: Ast::Stmt = Ast::Stmt.If(Ast::Expr.Ident("flag", at), [install_inner_in_b, Ast::Stmt.Break("", at)], [Ast::Stmt.Continue("", at)], at)
                    conditional_break_loop: Ast::Stmt = Ast::Stmt.While(Ast::Expr.Ident("condition", at), [conditional_break], at)
                    conditional_break_body: darray[Ast::Stmt] @source = [conditional_break_loop, Ast::Stmt.Expr(Ast::Expr.Ident("b", at), at)]
                    conditional_break_value: (found: bool, position: usize) = region_escape_body_value_region_with_elements(conditional_break_body, null, annotations, view_fns, container_fns, nesting, source_names, source_regions, empty_element_names, empty_element_regions, 10, catch_lines)
                    return 5 if not conditional_break_value.found or conditional_break_value.position != 1

                    values_names: darray[sview @source] @source = ["values"]
                    values_regions: darray[sview @source] @source = ["outer"]
                    values_element_names: darray[sview @source] @source = ["values"]
                    values_element_regions: darray[sview @source] @source = [""]
                    push_inner: Ast::Stmt = Ast::Stmt.Expr(Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("values", at), "push", at), [Ast::Expr.Ident("inner_view", at)], [], at), at)
                    element_exit_if: Ast::Stmt = Ast::Stmt.If(Ast::Expr.Ident("flag", at), [push_inner, Ast::Stmt.Break("", at)], [Ast::Stmt.Continue("", at)], at)
                    element_exit_loop: Ast::Stmt = Ast::Stmt.While(Ast::Expr.Ident("condition", at), [element_exit_if], at)
                    values_tail: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("values", at), Ast::Expr.IntLit(0, at), at)
                    element_exit_block: Ast::Expr = Ast::Expr.Block([element_exit_loop], values_tail, [], at)
                    element_exit_region: sview @source = region_escape_stored_or_call_region_with_elements(element_exit_block, annotations, view_fns, container_fns, nesting, values_names, values_regions, values_element_names, values_element_regions, 10, catch_lines)
                    return 6 if element_exit_region != "inner"

                    infinite_loop: Ast::Stmt = Ast::Stmt.While(Ast::Expr.BoolLit(true, at), [Ast::Stmt.Continue("", at)], at)
                    infinite_tail_body: darray[Ast::Stmt] @source = [infinite_loop, Ast::Stmt.Expr(Ast::Expr.Ident("b", at), at)]
                    infinite_tail: (found: bool, position: usize) = region_escape_body_value_region_with_elements(infinite_tail_body, null, annotations, view_fns, container_fns, nesting, source_names, source_regions, empty_element_names, empty_element_regions, 10, catch_lines)
                    return 7 if infinite_tail.found

                    nested_break_loop: Ast::Stmt = Ast::Stmt.While(Ast::Expr.BoolLit(true, at), [Ast::Stmt.Break("", at)], at)
                    outer_continue: Ast::Stmt = Ast::Stmt.Continue("", at)
                    nested_break_outer_loop: Ast::Stmt = Ast::Stmt.While(Ast::Expr.BoolLit(true, at), [nested_break_loop, outer_continue], at)
                    nested_break_tail_body: darray[Ast::Stmt] @source = [nested_break_outer_loop, Ast::Stmt.Expr(Ast::Expr.Ident("b", at), at)]
                    nested_break_tail: (found: bool, position: usize) = region_escape_body_value_region(nested_break_tail_body, null, annotations, view_fns, container_fns, nesting, source_names, source_regions, 10)
                    return 8 if nested_break_tail.found

                    labeled_continue_loop: Ast::Stmt = Ast::Stmt.While(Ast::Expr.BoolLit(true, at), [install_inner_in_b, Ast::Stmt.Continue("outer", at)], at)
                    install_outer_in_b: Ast::Stmt = Ast::Stmt.Assign(Ast::Expr.Ident("b", at), TokenKind.Assign, Ast::Expr.Ident("a", at), at)
                    labeled_continue_branch: Ast::Stmt = Ast::Stmt.If(Ast::Expr.Ident("flag", at), [labeled_continue_loop, install_outer_in_b, Ast::Stmt.Break("", at)], [Ast::Stmt.Break("", at)], at)
                    labeled_continue_outer_loop: Ast::Stmt = Ast::Stmt.While(Ast::Expr.BoolLit(true, at), [labeled_continue_branch], at)
                    labeled_continue_block: Ast::Stmt = Ast::Stmt.Block("label", ["outer"], "", [labeled_continue_outer_loop], at)
                    labeled_continue_tail_body: darray[Ast::Stmt] @source = [labeled_continue_block, Ast::Stmt.Expr(Ast::Expr.Ident("b", at), at)]
                    labeled_continue_tail: (found: bool, position: usize) = region_escape_body_value_region_with_elements(labeled_continue_tail_body, null, annotations, view_fns, container_fns, nesting, source_names, source_regions, empty_element_names, empty_element_regions, 10, catch_lines)
                    return 9 if not labeled_continue_tail.found or labeled_continue_tail.position != 1

                    only_labeled_continue_loop: Ast::Stmt = Ast::Stmt.While(Ast::Expr.BoolLit(true, at), [Ast::Stmt.Continue("outer", at)], at)
                    only_labeled_continue_block: Ast::Stmt = Ast::Stmt.Block("label", ["outer"], "", [only_labeled_continue_loop], at)
                    only_labeled_continue_body: darray[Ast::Stmt] @source = [only_labeled_continue_block, Ast::Stmt.Expr(Ast::Expr.Ident("b", at), at)]
                    only_labeled_continue_tail: (found: bool, position: usize) = region_escape_body_value_region(only_labeled_continue_body, null, annotations, view_fns, container_fns, nesting, source_names, source_regions, 10)
                    return 15 if only_labeled_continue_tail.found

                    dead_while_continue: Ast::Stmt = Ast::Stmt.While(Ast::Expr.BoolLit(false, at), [Ast::Stmt.Continue("outer", at)], at)
                    dead_while_continue_body: darray[Ast::Stmt] @source = [dead_while_continue]
                    return 13 if region_escape_provenance_statements_have_labeled_continue(dead_while_continue_body, catch_lines)
                    aborting_iterable: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("raise", at), [Ast::Expr.IntLit(0, at)], [], at)
                    dead_for_continue: Ast::Stmt = Ast::Stmt.For("", ["item"], aborting_iterable, [Ast::Stmt.Continue("outer", at)], at)
                    dead_for_continue_body: darray[Ast::Stmt] @source = [dead_for_continue]
                    return 14 if region_escape_provenance_statements_have_labeled_continue(dead_for_continue_body, catch_lines)

                    child_labeled_continue_loop: Ast::Stmt = Ast::Stmt.While(Ast::Expr.BoolLit(true, at), [install_inner_in_b, Ast::Stmt.Continue("inner", at)], at)
                    child_labeled_continue_block: Ast::Stmt = Ast::Stmt.Block("label", ["inner"], "", [child_labeled_continue_loop], at)
                    child_labeled_continue_outer_loop: Ast::Stmt = Ast::Stmt.While(Ast::Expr.Ident("condition", at), [child_labeled_continue_block, Ast::Stmt.Break("", at)], at)
                    child_labeled_continue_body: darray[Ast::Stmt] @source = [child_labeled_continue_outer_loop, Ast::Stmt.Expr(Ast::Expr.Ident("b", at), at)]
                    child_labeled_continue_tail: (found: bool, position: usize) = region_escape_body_value_region(child_labeled_continue_body, null, annotations, view_fns, container_fns, nesting, source_names, source_regions, 10)
                    return 16 if not child_labeled_continue_tail.found or child_labeled_continue_tail.position != 0

                    child_labeled_break_loop: Ast::Stmt = Ast::Stmt.While(Ast::Expr.BoolLit(true, at), [Ast::Stmt.Break("inner", at)], at)
                    child_labeled_break_block: Ast::Stmt = Ast::Stmt.Block("label", ["inner"], "", [child_labeled_break_loop], at)
                    child_labeled_break_outer_loop: Ast::Stmt = Ast::Stmt.While(Ast::Expr.BoolLit(true, at), [child_labeled_break_block, Ast::Stmt.Continue("", at)], at)
                    child_labeled_break_body: darray[Ast::Stmt] @source = [child_labeled_break_outer_loop, Ast::Stmt.Expr(Ast::Expr.Ident("b", at), at)]
                    child_labeled_break_tail: (found: bool, position: usize) = region_escape_body_value_region(child_labeled_break_body, null, annotations, view_fns, container_fns, nesting, source_names, source_regions, 10)
                    return 17 if child_labeled_break_tail.found

                    catch_pos: Ast::Pos = at{line = 100}
                    catch_raise: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("raise", catch_pos), [Ast::Expr.IntLit(1, catch_pos)], [], catch_pos)
                    catch_arms: darray[Ast::MatchArm] @source = [
                        Ast::MatchArm{pattern: Ast::Pattern.Binding("success"), body: [], guard: Ast::Expr.Absent, pos: catch_pos},
                        Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [], guard: Ast::Expr.Absent, pos: catch_pos}
                    ]
                    tagged_catch: Ast::Stmt = Ast::Stmt.Match(catch_raise, catch_arms, catch_pos)
                    tagged_catch_statements: darray[Ast::Stmt] @source = [tagged_catch]
                    catch_tag: darray[u32] @source = [100]
                    tagged_raise_facts: (reaches_end: bool, found_raise: bool) = region_escape_provenance_catchable_raise_statements_summary(tagged_catch_statements, catch_tag)
                    return 10 if tagged_raise_facts.found_raise

                    true_guard_catch_arms: darray[Ast::MatchArm] @source = [
                        Ast::MatchArm{pattern: Ast::Pattern.Binding("success"), body: [], guard: Ast::Expr.Absent, pos: catch_pos},
                        Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [], guard: Ast::Expr.BoolLit(true, catch_pos), pos: catch_pos}
                    ]
                    true_guard_catch: Ast::Expr = Ast::Expr.Catch(catch_raise, true_guard_catch_arms, catch_pos)
                    return 12 if region_escape_provenance_catchable_raise_with_metadata(true_guard_catch, catch_tag)

                    ordinary_match_pos: Ast::Pos = at{line = 101}
                    ordinary_match: Ast::Stmt = Ast::Stmt.Match(catch_raise, catch_arms, ordinary_match_pos)
                    ordinary_match_statements: darray[Ast::Stmt] @source = [ordinary_match]
                    ordinary_raise_facts: (reaches_end: bool, found_raise: bool) = region_escape_provenance_catchable_raise_statements_summary(ordinary_match_statements, catch_tag)
                    return 11 if not ordinary_raise_facts.found_raise
                    return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Semantic::region_loop_tail_atom_probe() can Global{Read,Write}
