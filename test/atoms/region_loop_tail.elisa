extend Semantic:
    public:
        def region_loop_tail_atom_probe() -> i64 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    at: Ast::Pos = zeroed
                    annotations: darray[Ast::LocalRegionAnnotation] @source = []
                    view_fns: darray[sview @source] @source = []
                    container_fns: darray[sview @source] @source = []
                    nesting: darray[sview @source] @source = ["outer", "inner"]
                    source_names: darray[sview @source] @source = ["a", "b", "inner_view"]
                    source_regions: darray[sview @source] @source = ["outer", "outer", "inner"]
                    empty_element_names: darray[sview @source] @source = []
                    empty_element_regions: darray[sview @source] @source = []
                    catch_lines: darray[u32] @source = []
                    copy_to_a: Ast::Stmt = Ast::Stmt.Assign(Ast::Expr.Ident("a", at), TokenKind.Assign, Ast::Expr.Ident("b", at), at)
                    install_inner_in_b: Ast::Stmt = Ast::Stmt.Assign(Ast::Expr.Ident("b", at), TokenKind.Assign, Ast::Expr.Ident("inner_view", at), at)
                    loop_body: darray[Ast::Stmt] @source = [copy_to_a, install_inner_in_b]

                    while_loop: Ast::Stmt = Ast::Stmt.While(Ast::Expr.Ident("condition", at), loop_body, at)
                    while_value_body: darray[Ast::Stmt] @source = [while_loop, Ast::Stmt.Expr(Ast::Expr.Ident("a", at), at)]
                    while_value: (found: bool, position: usize) = region_escape_body_value_region(while_value_body, null, annotations, view_fns, container_fns, nesting, source_names, source_regions, 10)
                    return 1 if not while_value.found or while_value.position != 1

                    for_loop: Ast::Stmt = Ast::Stmt.For("", ["item"], Ast::Expr.Ident("items", at), loop_body, at)
                    for_value_body: darray[Ast::Stmt] @source = [for_loop, Ast::Stmt.Expr(Ast::Expr.Ident("a", at), at)]
                    for_value: (found: bool, position: usize) = region_escape_body_value_region_with_elements(for_value_body, null, annotations, view_fns, container_fns, nesting, source_names, source_regions, empty_element_names, empty_element_regions, 10, catch_lines)
                    return 2 if not for_value.found or for_value.position != 1

                    never_loop: Ast::Stmt = Ast::Stmt.While(Ast::Expr.BoolLit(false, at), [install_inner_in_b], at)
                    never_value_body: darray[Ast::Stmt] @source = [never_loop, Ast::Stmt.Expr(Ast::Expr.Ident("b", at), at)]
                    never_value: (found: bool, position: usize) = region_escape_body_value_region_with_elements(never_value_body, null, annotations, view_fns, container_fns, nesting, source_names, source_regions, empty_element_names, empty_element_regions, 10, catch_lines)
                    return 3 if not never_value.found or never_value.position != 0

                    break_loop: Ast::Stmt = Ast::Stmt.While(Ast::Expr.Ident("condition", at), [install_inner_in_b, Ast::Stmt.Break("", at)], at)
                    break_value_body: darray[Ast::Stmt] @source = [break_loop, Ast::Stmt.Expr(Ast::Expr.Ident("b", at), at)]
                    break_value: (found: bool, position: usize) = region_escape_body_value_region_with_elements(break_value_body, null, annotations, view_fns, container_fns, nesting, source_names, source_regions, empty_element_names, empty_element_regions, 10, catch_lines)
                    return 4 if not break_value.found or break_value.position != 1

                    conditional_break: Ast::Stmt = Ast::Stmt.If(Ast::Expr.Ident("flag", at), [install_inner_in_b, Ast::Stmt.Break("", at)], [Ast::Stmt.Continue("", at)], at)
                    conditional_break_loop: Ast::Stmt = Ast::Stmt.While(Ast::Expr.Ident("condition", at), [conditional_break], at)
                    conditional_break_body: darray[Ast::Stmt] @source = [conditional_break_loop, Ast::Stmt.Expr(Ast::Expr.Ident("b", at), at)]
                    conditional_break_value: (found: bool, position: usize) = region_escape_body_value_region_with_elements(conditional_break_body, null, annotations, view_fns, container_fns, nesting, source_names, source_regions, empty_element_names, empty_element_regions, 10, catch_lines)
                    return 5 if not conditional_break_value.found or conditional_break_value.position != 1

                    values_names: darray[sview @source] @source = ["values"]
                    values_regions: darray[sview @source] @source = ["outer"]
                    values_element_names: darray[sview @source] @source = ["values"]
                    values_element_regions: darray[sview @source] @source = [""]
                    push_inner: Ast::Stmt = Ast::Stmt.Expr(Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("values", at), "push", at), [Ast::Expr.Ident("inner_view", at)], [], at), at)
                    element_exit_if: Ast::Stmt = Ast::Stmt.If(Ast::Expr.Ident("flag", at), [push_inner, Ast::Stmt.Break("", at)], [Ast::Stmt.Continue("", at)], at)
                    element_exit_loop: Ast::Stmt = Ast::Stmt.While(Ast::Expr.Ident("condition", at), [element_exit_if], at)
                    values_tail: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("values", at), Ast::Expr.IntLit(0, at), at)
                    element_exit_block: Ast::Expr = Ast::Expr.Block([element_exit_loop], values_tail, [], at)
                    element_exit_region: sview @source = region_escape_stored_or_call_region_with_elements(element_exit_block, annotations, view_fns, container_fns, nesting, values_names, values_regions, values_element_names, values_element_regions, 10, catch_lines)
                    return 6 if element_exit_region != "inner"

                    infinite_loop: Ast::Stmt = Ast::Stmt.While(Ast::Expr.BoolLit(true, at), [Ast::Stmt.Continue("", at)], at)
                    infinite_tail_body: darray[Ast::Stmt] @source = [infinite_loop, Ast::Stmt.Expr(Ast::Expr.Ident("b", at), at)]
                    infinite_tail: (found: bool, position: usize) = region_escape_body_value_region_with_elements(infinite_tail_body, null, annotations, view_fns, container_fns, nesting, source_names, source_regions, empty_element_names, empty_element_regions, 10, catch_lines)
                    return 7 if infinite_tail.found
                    return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Semantic::region_loop_tail_atom_probe() can Global{Read,Write}
