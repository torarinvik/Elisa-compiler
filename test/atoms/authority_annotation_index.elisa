extend Semantic:
    public:
        def compiler_authority_annotation_index_probe() -> i64 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    annotations: darray[Ast::EnumAnnotation] @source = [
                        Ast::EnumAnnotation{owner: "__invalid_console", name: "Read", line: 7},
                        Ast::EnumAnnotation{owner: "__invalid_console", name: "Write", line: 7},
                        Ast::EnumAnnotation{owner: "__effect_param", name: "Read", line: 7},
                        Ast::EnumAnnotation{owner: "__effect_param", name: "Write", line: 8},
                        Ast::EnumAnnotation{owner: "__invalid_console", name: "Write", line: 9}
                    ]
                    index: mutable ConcreteEffectWrapperIndex = ConcreteEffectWrapperIndex{names: [], lines: [], offsets: [], effect_parameter_lines: [], effect_parameter_offsets: [], permission_parameter_lines: [], permission_parameter_offsets: [], invalid_console_lines: []}
                    table: SymbolTable = SymbolTable(false)
                    build_concrete_effect_wrapper_index(table, annotations, &index)
                    return 1 if index.invalid_console_lines.count != 2
                    return 2 if not concrete_invalid_console_line_index(index, 7)
                    return 3 if concrete_invalid_console_line_index(index, 8)
                    return 4 if not concrete_invalid_console_line_index(index, 9)

                    binding_rows: darray[Ast::EnumAnnotation] @source = [
                        Ast::EnumAnnotation{owner: "Alias", name: "__using_alias", line: 10, module: "", offset: 10},
                        Ast::EnumAnnotation{owner: "Actual", name: "__using_alias_target", line: 10, module: "", offset: 10}
                    ]
                    binding_table: mutable SymbolTable = SymbolTable(false)
                    binding_table <- binding_import_metadata(binding_rows, binding_table) can Global{Read,Write}
                    binding_table.current_module <- ""
                    binding_table <- binding_table.add_symbol("Actual", SymbolKind.Module, 1, 0, 0, sview("", 0, 0), 0, 1) can Global{Read,Write}
                    binding_table.current_module <- "Actual"
                    actual_type_row: u32 = binding_table.symbols.count.u32()
                    binding_table <- binding_table.add_symbol("Thing", SymbolKind.Struct, 2, 0, 0, sview("", 0, 0), 0, 2) can Global{Read,Write}
                    binding_table.current_module <- ""
                    binding_table <- binding_table.add_symbol("Alias", SymbolKind.Module, 10, 0, 0, sview("", 0, 0), 0, 10) can Global{Read,Write}
                    binding_table.current_module <- "Client"
                    binding_table <- binding_table.add_symbol("Alias", SymbolKind.Module, 20, 0, 0, sview("", 0, 0), 0, 20) can Global{Read,Write}
                    binding_table.current_module <- "Client::Alias"
                    local_type_row: u32 = binding_table.symbols.count.u32()
                    binding_table <- binding_table.add_symbol("Thing", SymbolKind.Struct, 21, 0, 0, sview("", 0, 0), 0, 21) can Global{Read,Write}
                    alias_type_path: Ast::Expr = Ast::Expr.Scope(Ast::Expr.Ident("Alias", Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 6, end_offset: 5}), "Thing", Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 6, end_offset: 5})
                    return 5 if binding_nominal_declaration(alias_type_path, "", binding_table) != actual_type_row
                    return 6 if binding_nominal_declaration(alias_type_path, "Client", binding_table) != local_type_row
                    return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_authority_annotation_index_probe() can Global{Read,Write}
