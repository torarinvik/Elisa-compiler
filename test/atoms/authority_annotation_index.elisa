extend Semantic:
    public:
        def compiler_authority_annotation_index_probe() -> i64 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    annotations: darray[Ast::EnumAnnotation] @source = [
                        Ast::EnumAnnotation{owner: "__invalid_console", name: "Read", line: 7},
                        Ast::EnumAnnotation{owner: "__invalid_console", name: "Write", line: 7},
                        Ast::EnumAnnotation{owner: "__effect_param", name: "Read", line: 7},
                        Ast::EnumAnnotation{owner: "__effect_param", name: "Write", line: 8},
                        Ast::EnumAnnotation{owner: "__invalid_console", name: "Write", line: 9}
                    ]
                    index: mutable ConcreteEffectWrapperIndex = ConcreteEffectWrapperIndex{names: [], lines: [], effect_parameter_lines: [], permission_parameter_lines: [], invalid_console_lines: []}
                    table: SymbolTable = SymbolTable(false)
                    build_concrete_effect_wrapper_index(table, annotations, &index)
                    return 1 if index.invalid_console_lines.count != 2
                    return 2 if not concrete_invalid_console_line_index(index, 7)
                    return 3 if concrete_invalid_console_line_index(index, 8)
                    return 4 if not concrete_invalid_console_line_index(index, 9)
                    return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_authority_annotation_index_probe() can Global{Read,Write}
