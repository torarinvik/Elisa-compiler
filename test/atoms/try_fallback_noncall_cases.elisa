extend Semantic:
    public:
        def compiler_try_noncall_facts_probe(at: Ast::Pos) -> bool can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                table: mutable SymbolTable = SymbolTable(false)
                file: Ast::File = zeroed
                load_e: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("load_e", at), [], [], at)
                no_error_rows: darray[Ast::EnumAnnotation] = []
                binding_panic: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("panic", at), [], [], at)
                binding_panic_pattern: Ast::Pattern = Ast::Pattern.As("whole", [Ast::Pattern.Binding("value")])
                binding_panic_arm: Ast::MatchArm = Ast::MatchArm{pattern: binding_panic_pattern, body: [Ast::Stmt.Expr(binding_panic, at)], guard: Ast::Expr.Absent, pos: at}
                binding_panic_match: Ast::Expr = Ast::Expr.Match(Ast::Expr.Ident("subject", at), [binding_panic_arm], at)
                return false if not try_noncall_expression_aborts_with_annotations(binding_panic_match, no_error_rows)
                binding_raise: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("raise", at), [Ast::Expr.Ident("problem", at)], [], at)
                binding_raise_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("value"), body: [Ast::Stmt.Expr(binding_raise, at)], guard: Ast::Expr.Absent, pos: at}
                binding_raise_match: Ast::Expr = Ast::Expr.Match(Ast::Expr.Ident("subject", at), [binding_raise_arm], at)
                return false if not try_noncall_expression_directly_raises(binding_raise_match, no_error_rows, "")
                binding_return_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("value"), body: [Ast::Stmt.Return(Ast::Expr.IntLit(0, at), at)], guard: Ast::Expr.Absent, pos: at}
                binding_return_match: Ast::Stmt = Ast::Stmt.Match(Ast::Expr.Ident("subject", at), [binding_return_arm], at)
                return false if not try_noncall_block_terminates([binding_return_match])
                first_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Literal("true"), body: [Ast::Stmt.Expr(load_e, at)], guard: Ast::Expr.Absent, pos: at}
                second_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [Ast::Stmt.Expr(load_e, at)], guard: Ast::Expr.Absent, pos: at}
                match_value: Ast::Expr = Ast::Expr.Match(Ast::Expr.BoolLit(true, at), [first_arm, second_arm], at)
                error_rows: darray[Ast::EnumAnnotation] = [
                    Ast::EnumAnnotation{owner: "load_e", name: "__lsp_func_name", line: 1, offset: 1, identity_id: 1},
                    Ast::EnumAnnotation{owner: "load_e", name: "__error_return", line: 1, offset: 1, identity_id: 1},
                    Ast::EnumAnnotation{owner: "load_e", name: "E", line: 1, offset: 1, identity_id: 1}
                ]
                duplicate_name_rows: darray[Ast::EnumAnnotation] = [
                    Ast::EnumAnnotation{owner: "same_name", name: "__lsp_func_name", line: 1, offset: 1, identity_id: 1},
                    Ast::EnumAnnotation{owner: "same_name", name: "__error_return", line: 1, offset: 1, identity_id: 1},
                    Ast::EnumAnnotation{owner: "same_name", name: "E", line: 1, offset: 1, identity_id: 1},
                    Ast::EnumAnnotation{owner: "same_name", name: "__lsp_func_name", line: 5, offset: 5, identity_id: 2}
                ]
                duplicate_name_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("same_name", at), [], [], at)
                duplicate_name_environment: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{}
                duplicate_name_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(duplicate_name_call, [], duplicate_name_environment, duplicate_name_rows)
                return false if duplicate_name_facts.family != "" or duplicate_name_facts.known_nonfallible
                pure_rows: darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "pure", name: "__lsp_func_name", line: 3, offset: 3, identity_id: 3}]
                pure_environment: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{}
                pure_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("pure", at), [], [], at)
                pure_call_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(pure_call, [], pure_environment, pure_rows)
                return false if pure_call_facts.family != "" or not pure_call_facts.known_nonfallible
                shadowed_callable_environment: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{}
                try_noncall_family_bind(&shadowed_callable_environment, "load_e", "F")
                shadowed_callable: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("load_e", at), [], [], at)
                shadowed_callable_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(shadowed_callable, [], shadowed_callable_environment, error_rows)
                return false if shadowed_callable_facts.family != "" or shadowed_callable_facts.known_nonfallible
                callable_parameter: Ast::ParamDecl = Ast::ParamDecl{name: "load_e", type_expression: Ast::Expr.Ident("Callable", at), is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}
                callable_parameter_environment: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{}
                shadowed_callable_parameter_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(shadowed_callable, [callable_parameter], callable_parameter_environment, error_rows)
                return false if shadowed_callable_parameter_facts.family != "" or shadowed_callable_parameter_facts.known_nonfallible
                comprehension_site: Ast::Pos = Ast::Pos{line: 20, column: 8, offset: 200, end_line: 20, end_column: 14, end_offset: 206}
                comprehension_call_pos: Ast::Pos = Ast::Pos{line: 19, column: 17, offset: 190, end_line: 19, end_column: 25, end_offset: 198}
                comprehension_block_pos: Ast::Pos = Ast::Pos{line: 19, column: 10, offset: 184, end_line: 20, end_column: 14, end_offset: 206}
                comprehension_pos: Ast::Pos = Ast::Pos{line: 19, column: 1, offset: 175, end_line: 20, end_column: 14, end_offset: 206}
                comprehension_value: Ast::Expr = Ast::Expr.Block([Ast::Stmt.VarDecl("result", Ast::Expr.Absent, Ast::Expr.Call(Ast::Expr.Ident("load_e", comprehension_call_pos), [], [], comprehension_call_pos), comprehension_call_pos)], Ast::Expr.Ident("result", comprehension_site), [], comprehension_block_pos)
                comprehension_shadow: Ast::Expr = Ast::Expr.Comprehension("load_e", Ast::Expr.Array([], comprehension_pos), Ast::Expr.Absent, comprehension_value, comprehension_pos, 0)
                comprehension_try: Ast::EnumAnnotation = Ast::EnumAnnotation{owner: "__noncall", name: "__try_without_else", line: comprehension_site.line, offset: comprehension_site.offset, pos: comprehension_site}
                comprehension_environment: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{}
                comprehension_found: mutable bool = false
                comprehension_shadowed: mutable bool = false
                comprehension_local_family: mutable sview @source = ""
                comprehension_lambda_family: mutable sview @source = ""
                comprehension_inside_lambda: mutable bool = false
                comprehension_known_nonfallible: mutable bool = false
                try_noncall_scan_expression(comprehension_shadow, "result", [], comprehension_environment, error_rows, comprehension_try, comprehension_site.offset, false, "", comprehension_found, comprehension_shadowed, comprehension_local_family, comprehension_lambda_family, comprehension_inside_lambda, comprehension_known_nonfallible)
                return false if not comprehension_found or not comprehension_shadowed or comprehension_local_family != "" or comprehension_known_nonfallible
                legacy_pos: Ast::Pos = Ast::Pos{line: 9, column: 3, offset: 100, end_line: 9, end_column: 8, end_offset: 105}
                legacy_param: Ast::ParamDecl = Ast::ParamDecl{name: "value", name_pos: legacy_pos, type_expression: Ast::Expr.Ident("i64", legacy_pos), is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}
                same_line_param: Ast::ParamDecl = Ast::ParamDecl{name: "other", name_pos: Ast::Pos{line: 9, column: 11, offset: 108, end_line: 9, end_column: 16, end_offset: 113}, type_expression: Ast::Expr.Ident("i64", legacy_pos), is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}
                legacy_family_rows: darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "__param_error_union", name: "E", line: 9, offset: 0, identity_id: 1}]
                legacy_family: (known: bool, family: sview @source) = try_parameter_error_family([legacy_param], "value", legacy_family_rows)
                ambiguous_legacy_family: (known: bool, family: sview @source) = try_parameter_error_family([legacy_param, same_line_param], "value", legacy_family_rows)
                return false if not legacy_family.known or legacy_family.family != "E" or ambiguous_legacy_family.known
                legacy_family_try: Ast::EnumAnnotation = Ast::EnumAnnotation{owner: "__noncall", name: "__try_without_else", line: legacy_pos.line, offset: legacy_pos.offset, pos: legacy_pos}
                legacy_family_binding: (found: bool, shadowed: bool, local_error_family: sview @source, lambda_error_family: sview @source, inside_lambda: bool, known_nonfallible: bool) = try_noncall_binding_at_site(file, [Ast::Stmt.Return(Ast::Expr.Ident("value", legacy_pos), legacy_pos)], "value", [legacy_param], [], legacy_family_rows, legacy_family_try, legacy_pos.offset, legacy_family.family, "", table)
                return false if not legacy_family_binding.found or legacy_family_binding.local_error_family != "E" or legacy_family_binding.known_nonfallible
                family_env: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{}
                match_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(match_value, [], family_env, error_rows)
                return false if match_facts.family != "E" or match_facts.known_nonfallible

                block_first_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Literal("true"), body: [Ast::Stmt.VarDecl("copied", Ast::Expr.Absent, load_e, at), Ast::Stmt.Expr(Ast::Expr.Ident("copied", at), at)], guard: Ast::Expr.Absent, pos: at}
                block_second_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [Ast::Stmt.VarDecl("copied", Ast::Expr.Absent, load_e, at), Ast::Stmt.Expr(Ast::Expr.Ident("copied", at), at)], guard: Ast::Expr.Absent, pos: at}
                block_match: Ast::Expr = Ast::Expr.Match(Ast::Expr.BoolLit(true, at), [block_first_arm, block_second_arm], at)
                block_match_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(block_match, [], family_env, error_rows)
                return false if block_match_facts.family != "E" or block_match_facts.known_nonfallible

                catch_first_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("success"), body: [Ast::Stmt.VarDecl("copied", Ast::Expr.Absent, load_e, at), Ast::Stmt.Expr(Ast::Expr.Ident("copied", at), at)], guard: Ast::Expr.Absent, pos: at}
                catch_error_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.TypeBind("error", "problem"), body: [Ast::Stmt.VarDecl("copied", Ast::Expr.Absent, load_e, at), Ast::Stmt.Expr(Ast::Expr.Ident("copied", at), at)], guard: Ast::Expr.Absent, pos: at}
                catch_value: Ast::Expr = Ast::Expr.Catch(load_e, [catch_first_arm, catch_error_arm], at)
                catch_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(catch_value, [], family_env, error_rows)
                return false if catch_facts.family != "E" or catch_facts.known_nonfallible

                catch_parameter: Ast::ParamDecl = Ast::ParamDecl{name: "input", type_expression: Ast::Expr.Ident("i64", at), is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}
                catch_parameter_environment: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{}
                try_noncall_family_bind(&catch_parameter_environment, "input", "E", false, true, true, "", true, true, true)
                catch_success: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("success"), body: [Ast::Stmt.Expr(Ast::Expr.Ident("success", at), at)], guard: Ast::Expr.Absent, pos: at}
                catch_error: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.TypeBind("error", "problem"), body: [Ast::Stmt.Expr(Ast::Expr.IntLit(0, at), at)], guard: Ast::Expr.Absent, pos: at}
                catch_parameter_value: Ast::Expr = Ast::Expr.Catch(Ast::Expr.Ident("input", at), [catch_success, catch_error], at)
                catch_parameter_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(catch_parameter_value, [catch_parameter], catch_parameter_environment, error_rows)
                return false if catch_parameter_facts.family != "" or not catch_parameter_facts.known_nonfallible
                catch_call_success: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("success"), body: [Ast::Stmt.Expr(Ast::Expr.Ident("success", at), at)], guard: Ast::Expr.Absent, pos: at}
                catch_call_error: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.TypeBind("error", "problem"), body: [Ast::Stmt.Expr(Ast::Expr.IntLit(0, at), at)], guard: Ast::Expr.Absent, pos: at}
                catch_call_value: Ast::Expr = Ast::Expr.Catch(load_e, [catch_call_success, catch_call_error], at)
                catch_call_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(catch_call_value, [], family_env, error_rows)
                return false if catch_call_facts.family != "" or catch_call_facts.known_nonfallible

                primitive_block: Ast::Expr = Ast::Expr.Block([], Ast::Expr.IntLit(1, at), [], at)
                primitive_block_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(primitive_block, [], family_env, error_rows)
                return false if not primitive_block_facts.known_nonfallible
                alias_block: Ast::Expr = Ast::Expr.Block([Ast::Stmt.VarDecl("copied", Ast::Expr.Absent, load_e, at)], Ast::Expr.Ident("copied", at), [], at)
                alias_block_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(alias_block, [], family_env, error_rows)
                return false if alias_block_facts.family != "E" or alias_block_facts.known_nonfallible

                fallback_rows: darray[Ast::EnumAnnotation] = [error_rows[0], error_rows[1], error_rows[2], Ast::EnumAnnotation{owner: "__try_fallback_expression", name: "", line: at.line, offset: at.offset, identity_id: 1}]
                fallback_expression: Ast::Expr = Ast::Expr.Refinement(Ast::Expr.IntLit(0, at), load_e, at)
                fallback_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(fallback_expression, [], family_env, fallback_rows)
                return false if fallback_facts.family != "" or not fallback_facts.known_nonfallible
                get_else_expression: Ast::Expr = Ast::Expr.GetElse(load_e, [Ast::Stmt.Return(Ast::Expr.IntLit(0, at), at)], at)
                get_else_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(get_else_expression, [], family_env, error_rows)
                return false if get_else_facts.family != "" or not get_else_facts.known_nonfallible

                shadow_environment: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{}
                try_noncall_family_bind(&shadow_environment, "copied", "E")
                try_noncall_family_bind(&shadow_environment, "subject", "", true, true, true)
                shadow_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Binding("copied"), body: [Ast::Stmt.Expr(Ast::Expr.Ident("copied", at), at)], guard: Ast::Expr.Absent, pos: at}
                shadow_match: Ast::Expr = Ast::Expr.Match(Ast::Expr.Ident("subject", at), [shadow_arm], at)
                shadow_match_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(shadow_match, [], shadow_environment, error_rows)
                return false if shadow_match_facts.family != "" or not shadow_match_facts.known_nonfallible

                sequence_params: darray[Ast::ParamDecl] = [Ast::ParamDecl{name: "subject", type_expression: Ast::Expr.Index(Ast::Expr.Ident("darray", at), Ast::Expr.Ident("i64", at), at), is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}]
                explicit_pattern_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_pattern_binding_facts(Ast::Pattern.TypeBind("i64", "copied"), "copied")
                return false if not explicit_pattern_facts.known_nonfallible or not explicit_pattern_facts.numeric or not explicit_pattern_facts.integer

                guard_condition: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("subject", at), TokenKind.Is, Ast::Expr.Array([Ast::Expr.Ident("copied", at)], at), at)
                guard_facts: (known_nonfallible: bool, numeric: bool, integer: bool) = try_noncall_condition_binding_facts(guard_condition, "copied", sequence_params, error_rows)
                return false if not guard_facts.known_nonfallible or not guard_facts.numeric or not guard_facts.integer
                fresh_guard_if: Ast::Expr = Ast::Expr.If(guard_condition, Ast::Expr.Ident("copied", at), Ast::Expr.IntLit(0, at), at)
                fresh_guard_if_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(fresh_guard_if, sequence_params, family_env, error_rows)
                return false if fresh_guard_if_facts.family != "" or not fresh_guard_if_facts.known_nonfallible
                guarded_shadow_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [Ast::Stmt.Expr(Ast::Expr.Ident("copied", at), at)], guard: guard_condition, pos: at}
                guard_fallback_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [Ast::Stmt.Expr(Ast::Expr.IntLit(0, at), at)], guard: Ast::Expr.Absent, pos: at}
                guarded_shadow_match: Ast::Expr = Ast::Expr.Match(Ast::Expr.Ident("subject", at), [guarded_shadow_arm, guard_fallback_arm], at)
                sequence_shadow_environment: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{}
                try_noncall_family_bind(&sequence_shadow_environment, "copied", "E")
                guarded_shadow_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(guarded_shadow_match, sequence_params, sequence_shadow_environment, error_rows)
                return false if guarded_shadow_facts.family != "" or not guarded_shadow_facts.known_nonfallible

                guarded_shadow_if: Ast::Expr = Ast::Expr.If(guard_condition, Ast::Expr.Ident("copied", at), Ast::Expr.IntLit(0, at), at)
                guarded_if_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(guarded_shadow_if, sequence_params, sequence_shadow_environment, error_rows)
                return false if guarded_if_facts.family != "" or not guarded_if_facts.known_nonfallible

                local_environment: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{}
                local_declaration: Ast::Stmt = Ast::Stmt.VarDecl("x", Ast::Expr.Ident("i64", at), Ast::Expr.IntLit(1, at), at)
                no_annotations: darray[Ast::EnumAnnotation] = []
                remote_site: Ast::EnumAnnotation = Ast::EnumAnnotation{owner: "", name: "", line: at.line + 100, offset: at.offset + 100}
                found: mutable bool = false
                shadowed_at_site: mutable bool = false
                local_error_at_site: mutable sview @source = ""
                lambda_error_at_site: mutable sview @source = ""
                inside_lambda_at_site: mutable bool = false
                known_nonfallible_at_site: mutable bool = false
                try_noncall_scan_statements([local_declaration], "", [], local_environment, no_annotations, remote_site, remote_site.offset, false, "", found, shadowed_at_site, local_error_at_site, lambda_error_at_site, inside_lambda_at_site, known_nonfallible_at_site)
                numeric_alias: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("x", at), TokenKind.Plus, Ast::Expr.IntLit(1, at), at)
                numeric_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(numeric_alias, [], local_environment, no_annotations)
                return false if not numeric_facts.known_nonfallible or not try_noncall_expression_is_known_nonfallible(numeric_alias, [], local_environment)
                integer_alias: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("x", at), TokenKind.LShift, Ast::Expr.IntLit(1, at), at)
                integer_facts: (family: sview @source, known_nonfallible: bool) = try_noncall_assignment_source_facts(integer_alias, [], local_environment, no_annotations)
                return false if not try_noncall_integer_value(integer_alias, [], local_environment) or not integer_facts.known_nonfallible

                scalar_alias_declarations: darray[Ast::Decl] = [Ast::Decl.Alias("Count", Ast::Expr.Ident("i64", at), at)]
                # type Count = i64
                scalar_alias_file_bytes: darray[u8] @source = [116, 121, 112, 101, 32, 67, 111, 117, 110, 116, 32, 61, 32, 105, 54, 52, 10]
                scalar_alias_file_source: u8& @source = &scalar_alias_file_bytes[0]
                scalar_alias_file_tokens: darray[Lexer::Token] = frontend_tokenize_with_length(scalar_alias_file_source, scalar_alias_file_source, scalar_alias_file_bytes.count)
                scalar_alias_file: Ast::File = frontend_parser_parse_file_with_length(scalar_alias_file_source, scalar_alias_file_bytes.count, scalar_alias_file_tokens)
                scalar_alias_parameter: Ast::ParamDecl = Ast::ParamDecl{name: "value", name_pos: at, type_expression: Ast::Expr.Ident("Count", at), is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}
                scalar_alias_binary: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("value", at), TokenKind.Plus, Ast::Expr.IntLit(1, at), at)
                scalar_alias_site: Ast::EnumAnnotation = Ast::EnumAnnotation{owner: "__noncall", name: "__try_without_else", line: at.line, offset: at.offset, pos: at}
                scalar_alias_parameter_binding: (found: bool, shadowed: bool, local_error_family: sview @source, lambda_error_family: sview @source, inside_lambda: bool, known_nonfallible: bool) = try_noncall_binding_at_site(scalar_alias_file, [Ast::Stmt.Return(scalar_alias_binary, at)], "", [scalar_alias_parameter], scalar_alias_declarations, no_annotations, scalar_alias_site, at.offset, "", "", table)
                return false if not scalar_alias_parameter_binding.found or not scalar_alias_parameter_binding.known_nonfallible

                scalar_alias_chain_declarations: darray[Ast::Decl] = [Ast::Decl.Alias("Count", Ast::Expr.Ident("i64", at), at), Ast::Decl.Alias("SmallCount", Ast::Expr.Unary(TokenKind.Mutable, Ast::Expr.Paren(Ast::Expr.Ident("Count", at), at), at), at)]
                # type Count = i64, type SmallCount = mutable (Count)
                scalar_alias_chain_file_bytes: darray[u8] @source = [116, 121, 112, 101, 32, 67, 111, 117, 110, 116, 32, 61, 32, 105, 54, 52, 10, 116, 121, 112, 101, 32, 83, 109, 97, 108, 108, 67, 111, 117, 110, 116, 32, 61, 32, 109, 117, 116, 97, 98, 108, 101, 32, 40, 67, 111, 117, 110, 116, 41, 10]
                scalar_alias_chain_file_source: u8& @source = &scalar_alias_chain_file_bytes[0]
                scalar_alias_chain_file_tokens: darray[Lexer::Token] = frontend_tokenize_with_length(scalar_alias_chain_file_source, scalar_alias_chain_file_source, scalar_alias_chain_file_bytes.count)
                scalar_alias_chain_file: Ast::File = frontend_parser_parse_file_with_length(scalar_alias_chain_file_source, scalar_alias_chain_file_bytes.count, scalar_alias_chain_file_tokens)
                scalar_alias_chain_parameter: Ast::ParamDecl = Ast::ParamDecl{name: "value", name_pos: at, type_expression: Ast::Expr.Ident("SmallCount", at), is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}
                scalar_alias_chain_binding: (found: bool, shadowed: bool, local_error_family: sview @source, lambda_error_family: sview @source, inside_lambda: bool, known_nonfallible: bool) = try_noncall_binding_at_site(scalar_alias_chain_file, [Ast::Stmt.Return(scalar_alias_binary, at)], "", [scalar_alias_chain_parameter], scalar_alias_chain_declarations, no_annotations, scalar_alias_site, at.offset, "", "", table)
                return false if not scalar_alias_chain_binding.found or not scalar_alias_chain_binding.known_nonfallible

                scalar_alias_local: Ast::Stmt = Ast::Stmt.VarDecl("count", Ast::Expr.Ident("Count", at), Ast::Expr.IntLit(2, at), at)
                scalar_alias_local_binary: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("count", at), TokenKind.Plus, Ast::Expr.IntLit(1, at), at)
                scalar_alias_local_binding: (found: bool, shadowed: bool, local_error_family: sview @source, lambda_error_family: sview @source, inside_lambda: bool, known_nonfallible: bool) = try_noncall_binding_at_site(scalar_alias_file, [scalar_alias_local, Ast::Stmt.Return(scalar_alias_local_binary, at)], "", [], scalar_alias_declarations, no_annotations, scalar_alias_site, at.offset, "", "", table)
                return false if not scalar_alias_local_binding.found or not scalar_alias_local_binding.known_nonfallible
                ambiguous_scalar_aliases: darray[Ast::Decl] = [Ast::Decl.Alias("Count", Ast::Expr.Ident("i64", at), at), Ast::Decl.Alias("Count", Ast::Expr.Ident("f64", at), at)]
                ambiguous_alias_environment: mutable TryNonCallErrorFamilyEnv = TryNonCallErrorFamilyEnv{}
