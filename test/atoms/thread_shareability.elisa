extend Semantic:
    public:
        def thread_shareability_atom_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    node_store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in node_store:
                        table: mutable SymbolTable = SymbolTable(false)
                        at: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
                        empty_file: Ast::File = zeroed
                        call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("spawn1", at), [Ast::Expr.Ident("worker", at), Ast::Expr.IntLit(0, at)], [], at)
                        body: darray[Ast::Stmt] @source = [Ast::Stmt.Expr(call, at)]
                        declarations: darray[Ast::Decl] @source = [
                            Ast::Decl.Func("worker", [], Ast::Expr.Unary(TokenKind.Ampersand, Ast::Expr.Ident("i64", at), at), [], [], [], at),
                            Ast::Decl.Func("caller", [], null, body, [], [], at)
                        ]
                        file: Ast::File = empty_file{top_decls = declarations}
                        annotations: darray[Ast::EnumAnnotation] @source = []
                        region scratch(1048576):
                            table <- check_thread_shareability(declarations, &file, annotations, table)
                        return 1 if table.diagnostics.count != 1
                        return 2 if table.diagnostics[0].kind != DiagnosticKind.ThreadResultNotShareable
                        return 3 if table.diagnostics[0].name != "spawn1"
                        return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::thread_shareability_atom_probe() can Global{Read,Write}
