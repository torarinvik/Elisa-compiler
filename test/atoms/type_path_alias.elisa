extend Semantic:
    public:
        def compiler_type_path_alias_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                table: mutable SymbolTable = SymbolTable(false)
                names: darray[sview] = ["First"]
                targets: darray[sview @source] = ["Outer"]
                rebind canonical: sview @source, table = type_path_canonical_alias_target("First::Right", names, targets, table)
                return 1 if canonical != "Outer::Right"
                rebind nested: sview @source, table = type_path_canonical_alias_target("First::Right::Nested", names, targets, table)
                return 3 if nested != "Outer::Right::Nested"
                chain_names: darray[sview] = ["First", "Second"]
                chain_targets: darray[sview @source] = ["Outer", "First::Right"]
                rebind chained: sview @source, table = type_path_canonical_alias_target("Second::Nested", chain_names, chain_targets, table)
                return 4 if chained != "Outer::Right::Nested"
                file: mutable Ast::File = zeroed
                table <- check_type_path_separator(file, table)
                return 2 if table.diagnostics.count != 0
                return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_type_path_alias_probe() can Global{Read,Write}
