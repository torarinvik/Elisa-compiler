extend Semantic:
    public:
        def compiler_type_path_alias_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                table: mutable SymbolTable = SymbolTable(false)
                names: darray[sview] = ["First"]
                targets: darray[sview @source] = ["Outer"]
                rebind canonical: sview @source, table = type_path_canonical_alias_target("First::Right", names, targets, table)
                return 1 if canonical != "Outer::Right"
                rebind nested: sview @source, table = type_path_canonical_alias_target("First::Right::Nested", names, targets, table)
                return 3 if nested != "Outer::Right::Nested"
                chain_names: darray[sview] = ["First", "Second"]
                chain_targets: darray[sview @source] = ["Outer", "First::Right"]
                rebind chained: sview @source, table = type_path_canonical_alias_target("Second::Nested", chain_names, chain_targets, table)
                return 4 if chained != "Outer::Right::Nested"
                declaration_alias_names: darray[sview] = []
                declaration_alias_targets: darray[sview @source] = []
                rebind declaration_target: sview @source, table = type_path_canonical_alias_target("Library", declaration_alias_names, declaration_alias_targets, table, "App")
                return 5 if declaration_target != "App::Library"
                table <- table.add_symbol("Library::Mode", SymbolKind.Module, 1, 0, 0, sview("", 0, 0), 0, 1) can Global{Read,Write}
                scoped_alias_names: darray[sview] = ["L"]
                scoped_alias_targets: darray[sview @source] = [declaration_target]
                scoped_path: darray[sview] = ["L", "Mode"]
                return 6 if type_path_prefix_is_module(scoped_path, 2, "App", scoped_alias_names, scoped_alias_targets, table)
                table <- table.add_symbol("App::Library::Mode", SymbolKind.Module, 2, 0, 0, sview("", 0, 0), 0, 2) can Global{Read,Write}
                return 7 if not type_path_prefix_is_module(scoped_path, 2, "App", scoped_alias_names, scoped_alias_targets, table)
                file: mutable Ast::File = zeroed
                table <- check_type_path_separator(file, table)
                region owner(1048576):
                    node_store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in node_store:
                        table <- check_is_target_path(Ast::Expr.Absent, false, table)
                return 2 if table.diagnostics.count != 0
                return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::compiler_type_path_alias_probe() can Global{Read,Write}
