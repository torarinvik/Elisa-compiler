extern LLVMCreateTargetData(layout: cstr) -> LLVMTargetDataRef
extend Backend:
    public:
        def compiler_backend_atom_probe() -> i32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Global{Read,Write}:
                region owner(1048576):
                    pattern_store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in pattern_store:
                        local_scope: mutable Scope = Scope{names: [], slots: [], types: [], pool_names: [], group_names: [], deferred: []}
                        structs: mutable StructTable = StructTable{target: BackendTarget{context: LLVMContextCreate(), target_data: LLVMCreateTargetData("e-p:64:64"), target_pointer_bits: 64}}
                        structs.constants.const_names.push("FIRST")
                        structs.constants.const_owners.push("")
                        structs.constants.const_types.push(ValueType{kind: TypeKind.Unsigned, bits: 32})
                        structs.constants.const_values.push(17)
                        structs.constants.const_resolved.push(true)
                        normalized: Pattern = scalar_constant_pattern(Pattern.Binding("FIRST"), &local_scope, &structs)
                        return 1 if not (normalized is Pattern.Pin)
                        return 2 if scalar_pattern_const_index("FIRST", &structs) != 0
                        missing: Pattern = scalar_constant_pattern(Pattern.Binding("missing"), &local_scope, &structs)
                        return 3 if not (missing is Pattern.Binding)
                        structs.constants.const_names.push("FIRST")
                        structs.constants.const_owners.push("Other")
                        structs.constants.const_types.push(ValueType{kind: TypeKind.Unsigned, bits: 32})
                        structs.constants.const_values.push(23)
                        structs.constants.const_resolved.push(true)
                        return 4 if scalar_pattern_const_index("Other::FIRST", &structs) != 1
                        qualified: Pattern = scalar_constant_pattern(Pattern.Variant("Other::FIRST", []), &local_scope, &structs)
                        return 5 if not (qualified is Pattern.Pin)
                        ctx: LLVMContextRef = structs.target.context
                        builder: LLVMBuilderRef = LLVMCreateBuilderInContext(ctx)
                        compare_type: LLVMTypeRef = LLVMInt32TypeInContext(ctx)
                        scalar_type: ValueType = ValueType{kind: TypeKind.Unsigned, bits: 32}
                        options: darray[Pattern] = [normalized, qualified]
                        for value in [17.u64(), 23.u64(), 99.u64()] |local_scope, structs|:
                            if emit_or_pattern_hit(options, LLVMConstInt(compare_type, value, 0), scalar_type, false, compare_type, &local_scope, &structs, ctx, builder) is hit:
                                expected: u64 = 0.u64() if value == 99 else 1.u64()
                                return 7 if LLVMConstIntGetZExtValue(hit) != expected
                            else:
                                return 8
                        local_scope.names.push("FIRST")
                        local_scope.slots.push(LLVMConstNull(LLVMPointerTypeInContext(structs.target.context, 0)))
                        local_scope.types.push(ValueType{kind: TypeKind.Unsigned, bits: 32})
                        shadowed: Pattern = scalar_constant_pattern(Pattern.Binding("FIRST"), &local_scope, &structs)
                        return 6 if not (shadowed is Pattern.Binding)
                        m: LLVMModuleRef = LLVMModuleCreateWithNameInContext("pin_scope_probe", ctx)
                        fn_type: LLVMTypeRef = LLVMFunctionType(LLVMInt1TypeInContext(ctx), null, 0, 0)
                        function: LLVMValueRef = LLVMAddFunction(m, "probe", fn_type)
                        block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, function, "entry")
                        LLVMPositionBuilderAtEnd(builder, block)
                        if emit_simple_pattern_hit(Pattern.Pin("FIRST"), LLVMConstInt(compare_type, 17, 0), scalar_type, false, compare_type, &local_scope, &structs, ctx, builder) is local_hit:
                            # A local pin must load its slot, even when a constant has
                            # the same name. Folding this comparison would use 17.
                            return 9 if LLVMIsAConstantInt(local_hit) != null
                            loaded: LLVMValueRef = LLVMGetOperand(local_hit, 1)
                            return 10 if LLVMGetOperand(loaded, 0) != local_scope.slots[0]
                        else:
                            return 11
                        LLVMDisposeBuilder(builder)
                        LLVMDisposeModule(m)
                        at: Ast::Pos = zeroed
                        structs.records.names.extend(["Result", "Result"])
                        structs.records.owners.extend(["Caller", "Declared"])
                        structs.visibility.current_owner <- "Caller"
                        generics: mutable GenericTable = new_generic_table()
                        generics.names.push("make")
                        generics.owners.push("Declared")
                        generics.params.push("T")
                        generics.param_start.push(0)
                        generics.param_count.push(1)
                        generics.decls.push(Ast::Decl.Func("make", [], Ast::Expr.Ident("Result", at), [], [], [], at))
                        type_args: darray[ValueType] = [scalar_type]
                        declared_return: ValueType = generic_return_type_at(0, type_args, &generics, &structs)
                        return 12 if declared_return.kind != TypeKind.Struct or declared_return.bits != 1
                        return 13 if structs.visibility.current_owner != "Caller"
                        return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    return Backend::compiler_backend_atom_probe() can Global{Read,Write}
