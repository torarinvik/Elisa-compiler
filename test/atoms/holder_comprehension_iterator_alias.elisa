                call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("opaque", at), [Ast::Expr.Ident("target", at), Ast::Expr.Ident("view", at)], ["", ""], at)
                lambda: Ast::Expr = Ast::Expr.Lambda(["target"], [Ast::Stmt.Expr(call, at)], at)
                caller: Ast::Decl = Ast::Decl.Func("caller", [holder_parameter], null, [buffer_declaration, view_declaration, Ast::Stmt.Expr(lambda, at)], [], [], at)
                table: mutable SymbolTable = SymbolTable(false)
                summary: StoreThroughSummary = zeroed
                no_rebind_claims: darray[Ast::EnumAnnotation] = []
                table_walk_diagnostics_12: mutable darray[Diagnostic] = []
                chv_walk_declarations([caller], summary, no_rebind_claims, table_walk_diagnostics_12, table)
                table.diagnostics.extend(table_walk_diagnostics_12)
                return table.diagnostics.count == 1

