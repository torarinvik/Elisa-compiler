extend Semantic:
    public:
        def errorset_wrapper_return_visibility_atom_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                zero_private_pos: Ast::Pos = Ast::Pos{line: 0, column: 1, offset: 0, end_line: 0, end_column: 2, end_offset: 1}
                same_line_public_pos: Ast::Pos = Ast::Pos{line: 0, column: 21, offset: 20, end_line: 0, end_column: 22, end_offset: 21}
                annotations: darray[Ast::EnumAnnotation] @source = [
                    Ast::EnumAnnotation{owner: "__section_private", name: "dispatch", line: 0, module: "Api", pos: zero_private_pos},
                    Ast::EnumAnnotation{owner: "__section_public", name: "dispatch", line: 0, module: "Api", pos: same_line_public_pos},
                    Ast::EnumAnnotation{owner: "__section_private", name: "legacy", line: 0, module: "Api"}
                ]
                return 1 if ewr_callable_name_visible(annotations, "dispatch", "Api", "Client", 0, 0)
                return 2 if not ewr_callable_name_visible(annotations, "dispatch", "Api", "Api", 0, 0)
                return 3 if not ewr_callable_name_visible(annotations, "dispatch", "Api", "Client", 0, 20)
                return 4 if ewr_callable_name_visible(annotations, "legacy", "Api", "Client", 0, 0)
                return 0

return Semantic::errorset_wrapper_return_visibility_atom_probe() can Global{Read,Write}
