extend Semantic:
    public:
        def region_assignment_atom_probe() -> i32 can[Abort.Panic, Memory.Allocate]:
            can Global{Read,Write}:
                region owner(1048576):
                    node_store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in node_store:
                        at: Ast::Pos = zeroed
                        first_pos: Ast::Pos = at{line = 10}
                        second_pos: Ast::Pos = at{line = 20}
                        plain_pos: Ast::Pos = at{line = 30}
                        future_pos: Ast::Pos = at{line = 40}
                        value: Ast::Expr = Ast::Expr.IntLit(7, at)
                        first: Ast::Expr = Ast::Expr.RegionNew(value, "first", first_pos)
                        second: Ast::Expr = Ast::Expr.Paren(Ast::Expr.RegionNew(value, "second", second_pos), second_pos)
                        future: Ast::Expr = Ast::Expr.RegionNew(value, "future", future_pos)
                        statements: darray[Ast::Stmt] = [
                            Ast::Stmt.VarDecl("other", Ast::Expr.Invalid, first, first_pos),
                            Ast::Stmt.VarDecl("value", Ast::Expr.Invalid, first, first_pos),
                            Ast::Stmt.VarDecl("value", Ast::Expr.Invalid, second, second_pos),
                            Ast::Stmt.VarDecl("value", Ast::Expr.Invalid, value, plain_pos),
                            Ast::Stmt.VarDecl("value", Ast::Expr.Invalid, future, future_pos)
                        ]
                        regions: darray[sview] = ["first", "second", "future"]
                        lines: darray[u32] = [10, 20, 40]
                        return 1 if allocated_local_region(statements, regions, lines, "missing", 50) != ""
                        return 2 if allocated_local_region(statements, regions, lines, "value", 9) != ""
                        return 3 if allocated_local_region(statements, regions, lines, "value", 15) != "first"
                        return 4 if allocated_local_region(statements, regions, lines, "value", 25) != "second"
                        return 5 if allocated_local_region(statements, regions, lines, "value", 35) != "second"
                        return 6 if allocated_local_region(statements, regions, lines, "value", 45) != "future"
                        duplicate_regions: darray[sview] = ["first", "second", "different"]
                        duplicate_lines: darray[u32] = [10, 20, 20]
                        # Last allocation metadata on a line wins; the mismatching second
                        # declaration therefore does not replace the earlier direct match.
                        return 7 if allocated_local_region(statements, duplicate_regions, duplicate_lines, "value", 25) != "first"

                        line_collision: SymbolTable = SymbolTable()
                        line_collision.symbols.push(Symbol{id: DeclId{value: 0}, name: "Holder", kind: SymbolKind.Struct, line: 50, arity_min: 0, arity_max: 0, return_type: "", module_owner: "Imported"})
                        line_collision.symbols.push(Symbol{id: DeclId{value: 1}, name: "generic", kind: SymbolKind.Func, line: 50, arity_min: 0, arity_max: 0, return_type: "", module_owner: "Current"})
                        return 8 if region_escape_struct_line("Holder", "Imported", line_collision) != 0
                        unique_line: SymbolTable = SymbolTable()
                        unique_line.symbols.push(Symbol{id: DeclId{value: 0}, name: "Holder", kind: SymbolKind.Struct, line: 60, arity_min: 0, arity_max: 0, return_type: "", module_owner: "Imported"})
                        return 9 if region_escape_struct_line("Holder", "Imported", unique_line) != 60

                        duplicate_owner: SymbolTable = SymbolTable()
                        duplicate_owner.symbols.push(Symbol{id: DeclId{value: 0}, name: "Holder", kind: SymbolKind.Struct, line: 70, arity_min: 0, arity_max: 0, return_type: "", module_owner: "Imported"})
                        duplicate_owner.symbols.push(Symbol{id: DeclId{value: 1}, name: "Holder", kind: SymbolKind.Struct, line: 80, arity_min: 0, arity_max: 0, return_type: "", module_owner: "Other"})
                        return 10 if region_escape_struct_line("Holder", "Imported", duplicate_owner) != 0

                        unknown_projection_table: SymbolTable = SymbolTable()
                        projection_names: darray[sview @source] @source = ["root"]
                        projection_types: darray[Ast::Expr] @source = [Ast::Expr.Absent]
                        projected_container: Ast::Expr = Ast::Expr.Field(Ast::Expr.Ident("root", at), "items", at)
                        projected_push: Ast::Expr = Ast::Expr.Field(projected_container, "push", at)
                        projected_owner: (found: bool, region: sview, binding_id: u32) = region_escape_receiver_storage_region(projected_push, projection_names, projection_types, unknown_projection_table)
                        return 11 if not projected_owner.found or projected_owner.region != "__auto" or projected_owner.binding_id != 0
                        total_return_body_one: darray[Ast::Stmt] @source = [Ast::Stmt.Return(Ast::Expr.StringLit("safe", at), at)]
                        total_return_body_fallback: darray[Ast::Stmt] @source = [Ast::Stmt.Return(Ast::Expr.StringLit("safe", at), at)]
                        total_return_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Literal("1"), body: total_return_body_one, guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: total_return_body_fallback, guard: Ast::Expr.Absent, pos: at}
                        ]
                        terminating_match_statement: Ast::Stmt = Ast::Stmt.Match(Ast::Expr.IntLit(1, at), total_return_arms, at)
                        terminating_match_expression: Ast::Expr = Ast::Expr.Match(Ast::Expr.IntLit(1, at), total_return_arms, at)
                        return 12 if not region_escape_provenance_statement_terminates(terminating_match_statement)
                        return 13 if not region_escape_provenance_expression_terminates(terminating_match_expression)
                        guarded_match_body: darray[Ast::Stmt] @source = [Ast::Stmt.Return(Ast::Expr.StringLit("safe", at), at)]
                        guarded_match_arms: darray[Ast::MatchArm] @source = [Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: guarded_match_body, guard: Ast::Expr.BoolLit(true, at), pos: at}]
                        guarded_match_statement: Ast::Stmt = Ast::Stmt.Match(Ast::Expr.IntLit(1, at), guarded_match_arms, at)
                        return 14 if region_escape_provenance_statement_terminates(guarded_match_statement)
                        literal_if_body: darray[Ast::Stmt] @source = [Ast::Stmt.Return(Ast::Expr.StringLit("safe", at), at)]
                        literal_if_else: darray[Ast::Stmt] @source = []
                        literal_terminating_if: Ast::Stmt = Ast::Stmt.If(Ast::Expr.BoolLit(true, at), literal_if_body, literal_if_else, at)
                        return 15 if not region_escape_provenance_statement_terminates(literal_terminating_if)
                        unknown_if_body: darray[Ast::Stmt] @source = [Ast::Stmt.Return(Ast::Expr.StringLit("safe", at), at)]
                        unknown_if_else: darray[Ast::Stmt] @source = []
                        unknown_terminating_if: Ast::Stmt = Ast::Stmt.If(Ast::Expr.Ident("flag", at), unknown_if_body, unknown_if_else, at)
                        return 16 if region_escape_provenance_statement_terminates(unknown_terminating_if)
                        panic_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("panic", at), [], [], at)
                        panic_statement: Ast::Stmt = Ast::Stmt.Expr(panic_call, at)
                        bare_raise_statement: Ast::Stmt = Ast::Stmt.Expr(Ast::Expr.Ident("raise", at), at)
                        return 17 if not region_escape_provenance_statement_terminates(panic_statement)
                        return 18 if region_escape_provenance_statement_terminates(bare_raise_statement)
                        flow_annotations: darray[Ast::LocalRegionAnnotation] @source = []
                        flow_view_fns: darray[sview @source] @source = []
                        flow_container_fns: darray[sview @source] @source = []
                        flow_nesting: darray[sview @source] @source = ["outer", "inner"]
                        flow_input_names: darray[sview @source] @source = ["value"]
                        flow_input_regions: darray[sview @source] @source = [""]
                        region_value: Ast::Expr = Ast::Expr.RegionNew(Ast::Expr.IntLit(1, at), "inner", at)
                        tuple_global_names: darray[sview @source] @source = ["sink"]
                        tuple_outer_names: darray[sview @source] @source = ["safe_outer"]
                        tuple_empty_names: darray[sview @source] @source = []
                        tuple_empty_types: darray[Ast::Expr] @source = []
                        tuple_escape_target: Ast::Expr = Ast::Expr.Tuple([Ast::Expr.Ident("sink", at), Ast::Expr.Ident("safe_outer", at)], at)
                        tuple_escape_value: Ast::Expr = Ast::Expr.Tuple([Ast::Expr.RegionNew(Ast::Expr.StringLit("inner", at), "inner", at), Ast::Expr.IntLit(7, at)], at)
                        tuple_escape_table: mutable SymbolTable = SymbolTable(false)
                        tuple_escape_table <- region_escape_check_assign(tuple_escape_target, tuple_escape_value, 72, flow_nesting, flow_annotations, tuple_global_names, tuple_empty_names, tuple_outer_names, tuple_empty_names, tuple_empty_names, flow_view_fns, flow_container_fns, tuple_empty_names, tuple_empty_names, tuple_empty_names, tuple_empty_names, tuple_empty_names, tuple_empty_types, tuple_escape_table)
                        return 72 if tuple_escape_table.diagnostics.count != 1
                        return 73 if tuple_escape_table.diagnostics[0].kind != DiagnosticKind.RegionStoreEscape
                        tuple_paren_escape_table: mutable SymbolTable = SymbolTable(false)
                        tuple_paren_escape_table <- region_escape_check_assign(Ast::Expr.Paren(tuple_escape_target, at), tuple_escape_value, 74, flow_nesting, flow_annotations, tuple_global_names, tuple_empty_names, tuple_outer_names, tuple_empty_names, tuple_empty_names, flow_view_fns, flow_container_fns, tuple_empty_names, tuple_empty_names, tuple_empty_names, tuple_empty_names, tuple_empty_names, tuple_empty_types, tuple_paren_escape_table)
                        return 74 if tuple_paren_escape_table.diagnostics.count != 1
                        bare_raise_body: darray[Ast::Stmt] @source = [bare_raise_statement]
                        bare_raise_tail: (found: bool, position: usize) = region_escape_body_value_region(bare_raise_body, region_value, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, flow_input_names, flow_input_regions, 10)
                        return 71 if not bare_raise_tail.found or bare_raise_tail.position != 1
                        branch_assign: Ast::Stmt = Ast::Stmt.Assign(Ast::Expr.Ident("value", at), TokenKind.Assign, region_value, at)
                        if_branch: darray[Ast::Stmt] @source = [Ast::Stmt.If(Ast::Expr.Ident("condition", at), [branch_assign], [], at)]
                        if_result: (found: bool, position: usize) = region_escape_body_value_region(if_branch, Ast::Expr.Ident("value", at), flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, flow_input_names, flow_input_regions, 10)
                        return 19 if not if_result.found or if_result.position != 1
                        match_safe_assign: Ast::Stmt = Ast::Stmt.Assign(Ast::Expr.Ident("value", at), TokenKind.Assign, Ast::Expr.IntLit(0, at), at)
                        match_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Literal("1"), body: [branch_assign], guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [match_safe_assign], guard: Ast::Expr.Absent, pos: at}
                        ]
                        match_branch: darray[Ast::Stmt] @source = [Ast::Stmt.Match(Ast::Expr.IntLit(1, at), match_arms, at)]
                        match_result: (found: bool, position: usize) = region_escape_body_value_region(match_branch, Ast::Expr.Ident("value", at), flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, flow_input_names, flow_input_regions, 10)
                        return 20 if not match_result.found or match_result.position != 1
                        bool_match_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Literal("true"), body: [match_safe_assign], guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Literal("false"), body: [branch_assign], guard: Ast::Expr.Absent, pos: at}
                        ]
                        bool_match_body: darray[Ast::Stmt] @source = [Ast::Stmt.Match(Ast::Expr.BoolLit(true, at), bool_match_arms, at)]
                        clear_input_names: darray[sview @source] @source = ["value"]
                        clear_input_regions: darray[sview @source] @source = ["inner"]
                        true_pattern: (known: bool, matches: bool, catchall: bool) = region_escape_provenance_bool_pattern(Ast::Pattern.Literal("true"), true)
                        return 46 if not true_pattern.known or not true_pattern.matches
                        false_pattern: (known: bool, matches: bool, catchall: bool) = region_escape_provenance_bool_pattern(Ast::Pattern.Literal("false"), true)
                        return 47 if not false_pattern.known or false_pattern.matches
                        bool_match_result: (found: bool, position: usize) = region_escape_body_value_region(bool_match_body, Ast::Expr.Ident("value", at), flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, clear_input_names, clear_input_regions, 10)
                        return 42 if bool_match_result.found
                        safe_reassign: darray[Ast::Stmt] @source = [Ast::Stmt.Assign(Ast::Expr.Ident("value", at), TokenKind.Assign, Ast::Expr.IntLit(0, at), at)]
                        cleared_result: (found: bool, position: usize) = region_escape_body_value_region(safe_reassign, Ast::Expr.Ident("value", at), flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, clear_input_names, clear_input_regions, 10)
                        return 21 if cleared_result.found
                        mutation_taint_names: darray[sview @source] @source = []
                        mutation_taint_regions: darray[sview @source] @source = []
                        mutation_element_names: mutable darray[sview @source] @source = ["values"]
                        mutation_element_regions: mutable darray[sview @source] @source = ["outer"]
                        contains_inner: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("values", at), "contains", at), [region_value], [], at)
                        region_escape_record_collection_element_mutation(contains_inner, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, mutation_taint_names, mutation_taint_regions, mutation_element_names, mutation_element_regions, 10)
                        return 22 if region_escape_element_taint_lookup(mutation_element_names, mutation_element_regions, "values") != "outer"
                        clear_values: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("values", at), "clear", at), [], [], at)
                        region_escape_record_collection_element_mutation(clear_values, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, mutation_taint_names, mutation_taint_regions, mutation_element_names, mutation_element_regions, 10)
                        outer_value: Ast::Expr = Ast::Expr.RegionNew(Ast::Expr.IntLit(2, at), "outer", at)
                        push_outer: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("values", at), "push", at), [outer_value], [], at)
                        region_escape_record_collection_element_mutation(push_outer, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, mutation_taint_names, mutation_taint_regions, mutation_element_names, mutation_element_regions, 10)
                        return 23 if region_escape_element_taint_lookup(mutation_element_names, mutation_element_regions, "values") != "outer"
                        nested_element_names: darray[sview @source] @source = ["matrix"]
                        nested_element_regions: darray[sview @source] @source = ["inner"]
                        indexed_iterable: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("matrix", at), Ast::Expr.IntLit(0, at), at)
                        indexed_element_region: sview @source = region_escape_comprehension_element_region(indexed_iterable, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, mutation_taint_names, mutation_taint_regions, nested_element_names, nested_element_regions, 10)
                        return 24 if indexed_element_region != "inner"
                        indexed_value_region: sview @source = region_escape_stored_or_call_region_with_elements(indexed_iterable, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, mutation_taint_names, mutation_taint_regions, nested_element_names, nested_element_regions, 10)
                        return 25 if indexed_value_region != "inner"
                        row_taint_names: darray[sview @source] @source = ["row"]
                        row_taint_regions: darray[sview @source] @source = ["outer"]
                        matrix_element_names: mutable darray[sview @source] @source = ["row"]
                        matrix_element_regions: mutable darray[sview @source] @source = ["inner"]
                        push_row: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("matrix", at), "push", at), [Ast::Expr.Ident("row", at)], [], at)
                        row_value_region: sview @source = region_escape_stored_or_call_region_with_elements(Ast::Expr.Ident("row", at), flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, row_taint_names, row_taint_regions, matrix_element_names, matrix_element_regions, 10)
                        return 26 if row_value_region != "inner"
                        region_escape_record_collection_element_mutation(push_row, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, row_taint_names, row_taint_regions, matrix_element_names, matrix_element_regions, 10)
                        return 27 if region_escape_element_taint_lookup(matrix_element_names, matrix_element_regions, "matrix") != REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION
                        nested_row_element_region: sview @source = region_escape_comprehension_element_region(Ast::Expr.Ident("matrix", at), flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, row_taint_names, row_taint_regions, matrix_element_names, matrix_element_regions, 10)
                        return 38 if nested_row_element_region != "inner"
                        projected_matrix_names: mutable darray[sview @source] @source = ["matrix"]
                        projected_matrix_regions: mutable darray[sview @source] @source = ["inner"]
                        clear_first_row: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Index(Ast::Expr.Ident("matrix", at), Ast::Expr.IntLit(0, at), at), "clear", at), [], [], at)
                        region_escape_record_collection_element_mutation(clear_first_row, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, mutation_taint_names, mutation_taint_regions, projected_matrix_names, projected_matrix_regions, 10)
                        return 28 if region_escape_element_taint_lookup(projected_matrix_names, projected_matrix_regions, "matrix") != "inner"
                        catch_success_return: darray[Ast::Stmt] @source = [Ast::Stmt.Return(Ast::Expr.StringLit("done", at), at)]
                        catch_error_fallthrough: darray[Ast::Stmt] @source = []
                        catch_raise_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Binding("result"), body: catch_success_return, guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: catch_error_fallthrough, guard: Ast::Expr.Absent, pos: at}
                        ]
                        catch_raise: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("raise", at), [], [], at)
                        continuing_catch: Ast::Expr = Ast::Expr.Catch(catch_raise, catch_raise_arms, at)
                        return 29 if region_escape_provenance_expression_terminates(continuing_catch)
                        catch_error_return: darray[Ast::Stmt] @source = [Ast::Stmt.Return(Ast::Expr.StringLit("handled", at), at)]
                        terminating_catch_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Binding("result"), body: catch_success_return, guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: catch_error_return, guard: Ast::Expr.Absent, pos: at}
                        ]
                        terminating_catch: Ast::Expr = Ast::Expr.Catch(catch_raise, terminating_catch_arms, at)
                        return 30 if not region_escape_provenance_expression_terminates(terminating_catch)
                        named_variant_catch_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Binding("result"), body: catch_success_return, guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Binding("KnownError"), body: catch_error_return, guard: Ast::Expr.Absent, pos: at}
                        ]
                        named_variant_catch: Ast::Expr = Ast::Expr.Catch(catch_raise, named_variant_catch_arms, at)
                        return 33 if region_escape_provenance_expression_terminates(named_variant_catch)
                        typed_error_catch_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Binding("result"), body: catch_success_return, guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.TypeBind("error", "caught"), body: catch_error_return, guard: Ast::Expr.Absent, pos: at}
                        ]
                        typed_error_catch: Ast::Expr = Ast::Expr.Catch(catch_raise, typed_error_catch_arms, at)
                        return 34 if not region_escape_provenance_expression_terminates(typed_error_catch)
                        unreachable_error_catch_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Binding("result"), body: catch_success_return, guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: catch_error_return, guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Binding("LaterError"), body: catch_error_fallthrough, guard: Ast::Expr.Absent, pos: at}
                        ]
                        unreachable_error_catch: Ast::Expr = Ast::Expr.Catch(catch_raise, unreachable_error_catch_arms, at)
                        return 48 if not region_escape_provenance_expression_terminates(unreachable_error_catch)
                        unreachable_match_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: catch_error_return, guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Binding("LaterCase"), body: catch_error_fallthrough, guard: Ast::Expr.Absent, pos: at}
                        ]
                        unreachable_match: Ast::Expr = Ast::Expr.Match(Ast::Expr.IntLit(1, at), unreachable_match_arms, at)
                        return 49 if not region_escape_provenance_expression_terminates(unreachable_match)
                        dict_raise_entry: Ast::DictEntry = Ast::DictEntry{key: Ast::Expr.StringLit("key", at), value: catch_raise}
                        dict_with_raise: Ast::Expr = Ast::Expr.DictLit([dict_raise_entry], at)
                        dict_raise_catch: Ast::Expr = Ast::Expr.Catch(dict_with_raise, catch_raise_arms, at)
                        return 52 if region_escape_provenance_expression_terminates(dict_raise_catch)
                        ordered_panic_argument: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("panic", at), [], [], at)
                        raise_after_panic: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("raise", at), [ordered_panic_argument, catch_raise], ["", ""], at)
                        unreachable_raise_catch: Ast::Expr = Ast::Expr.Catch(raise_after_panic, catch_raise_arms, at)
                        return 53 if not region_escape_provenance_expression_terminates(unreachable_raise_catch)
                        fallthrough_if_then_raise: darray[Ast::Stmt] @source = [
                            Ast::Stmt.If(Ast::Expr.BoolLit(true, at), [], [], at),
                            Ast::Stmt.Expr(catch_raise, at)
                        ]
                        return 54 if not region_escape_provenance_catchable_raise_statements(fallthrough_if_then_raise)
                        panic_guard_raise_arm: Ast::MatchArm = Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [Ast::Stmt.Expr(catch_raise, at)], guard: panic_call, pos: at}
                        guarded_inner_catch: Ast::Expr = Ast::Expr.Catch(Ast::Expr.Call(Ast::Expr.Ident("fallible", at), [], [], at), [catch_raise_arms[0], panic_guard_raise_arm], at)
                        return 55 if region_escape_provenance_catchable_raise(guarded_inner_catch)
                        unknown_and_raise: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("choice", at), TokenKind.And, catch_raise, at)
                        unknown_or_raise: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("choice", at), TokenKind.Or, catch_raise, at)
                        return 56 if not region_escape_provenance_catchable_raise(unknown_and_raise)
                        return 57 if not region_escape_provenance_catchable_raise(unknown_or_raise)
                        catch_table: SymbolTable = SymbolTable()
                        return 31 if region_escape_recovery_expression_terminates(continuing_catch, catch_table)
                        return 32 if not region_escape_recovery_expression_terminates(terminating_catch, catch_table)
                        conditional_input_names: darray[sview @source] @source = ["value"]
                        conditional_input_regions: darray[sview @source] @source = ["outer"]
                        literal_branch: Ast::Expr = Ast::Expr.If(Ast::Expr.BoolLit(true, at), Ast::Expr.Ident("value", at), region_value, at)
                        conditional_region: sview @source = region_escape_stored_or_call_region(literal_branch, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, conditional_input_names, conditional_input_regions, 10)
                        return 33 if conditional_region != "outer"
                        conditional_element_region: sview @source = region_escape_stored_or_call_region_with_elements(literal_branch, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, conditional_input_names, conditional_input_regions, mutation_element_names, mutation_element_regions, 10)
                        return 34 if conditional_element_region != "outer"
                        unknown_element_names: mutable darray[sview @source] @source = []
                        unknown_element_regions: mutable darray[sview @source] @source = []
                        push_inner_to_unknown: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("unknown_values", at), "push", at), [region_value], [], at)
                        region_escape_record_collection_element_mutation(push_inner_to_unknown, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, mutation_taint_names, mutation_taint_regions, unknown_element_names, unknown_element_regions, 10)
                        unknown_with_local_element: sview @source = region_escape_element_taint_lookup(unknown_element_names, unknown_element_regions, "unknown_values")
                        return 35 if unknown_with_local_element != REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION
                        unknown_and_inner_join: sview @source = region_escape_element_region_join(REGION_ESCAPE_UNKNOWN_ELEMENT_REGION, "inner", flow_nesting)
                        return 43 if unknown_and_inner_join != REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION
                        composite_then_unknown_join: sview @source = region_escape_element_region_join(REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION, REGION_ESCAPE_UNKNOWN_ELEMENT_REGION, flow_nesting)
                        return 44 if composite_then_unknown_join != REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION
                        unknown_then_composite_join: sview @source = region_escape_element_region_join(REGION_ESCAPE_UNKNOWN_ELEMENT_REGION, REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION, flow_nesting)
                        return 45 if unknown_then_composite_join != REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION
                        unknown_with_local_then_unknown: sview @source = region_escape_deeper_region(REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION, REGION_ESCAPE_UNKNOWN_ELEMENT_REGION, flow_nesting)
                        return 50 if unknown_with_local_then_unknown != REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION
                        unknown_then_unknown_with_local: sview @source = region_escape_deeper_region(REGION_ESCAPE_UNKNOWN_ELEMENT_REGION, REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION, flow_nesting)
                        return 51 if unknown_then_unknown_with_local != REGION_ESCAPE_UNKNOWN_WITH_LOCAL_ELEMENT_REGION
                        unknown_iterator_element: sview @source = region_escape_comprehension_element_region(Ast::Expr.Ident("unknown_values", at), flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, mutation_taint_names, mutation_taint_regions, unknown_element_names, unknown_element_regions, 10)
                        return 36 if unknown_iterator_element != "inner"
                        dict_input_names: darray[sview @source] @source = ["values"]
                        dict_input_regions: darray[sview @source] @source = ["outer"]
                        dict_element_names: darray[sview @source] @source = ["values"]
                        dict_element_regions: darray[sview @source] @source = ["inner"]
                        dict_get: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("values", at), "get", at), [Ast::Expr.IntLit(0, at)], [], at)
                        dict_get_region: sview @source = region_escape_stored_or_call_region_with_elements(dict_get, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, dict_input_names, dict_input_regions, dict_element_names, dict_element_regions, 10)
                        return 39 if dict_get_region != "inner"
                        dead_mutation_names: mutable darray[sview @source] @source = []
                        dead_mutation_regions: mutable darray[sview @source] @source = []
                        dead_branch_element_names: mutable darray[sview @source] @source = []
                        dead_branch_element_regions: mutable darray[sview @source] @source = []
                        dead_push_inner: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("dead_values", at), "push", at), [region_value], [], at)
                        dead_push_outer: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("dead_values", at), "push", at), [outer_value], [], at)
                        panic_condition: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("panic", at), [], [], at)
                        dead_if_mutation: Ast::Expr = Ast::Expr.If(panic_condition, dead_push_inner, dead_push_outer, at)
                        region_escape_record_collection_element_mutation(dead_if_mutation, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, dead_mutation_names, dead_mutation_regions, dead_branch_element_names, dead_branch_element_regions, 10)
                        return 40 if dead_branch_element_names.count != 0
                        block_element_names: darray[sview @source] @source = ["values"]
                        block_element_regions: darray[sview @source] @source = [""]
                        block_push_inner: Ast::Stmt = Ast::Stmt.Expr(Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("values", at), "push", at), [region_value], [], at), at)
                        block_value_region: sview @source = region_escape_stored_or_call_region_with_elements(Ast::Expr.Block([block_push_inner], Ast::Expr.Ident("values", at), [], at), flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, conditional_input_names, conditional_input_regions, block_element_names, block_element_regions, 10)
                        return 41 if block_value_region != "inner"
                        branch_taint_names: darray[sview @source] @source = ["values"]
                        branch_taint_regions: darray[sview @source] @source = ["outer"]
                        branch_element_names: darray[sview @source] @source = ["values"]
                        branch_element_regions: mutable darray[sview @source] @source = [""]
                        branch_push_inner: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident("values", at), "push", at), [region_value], [], at)
                        branch_push_statement: Ast::Stmt = Ast::Stmt.Expr(branch_push_inner, at)
                        branch_match_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Literal("true"), body: [branch_push_statement], guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Literal("false"), body: [], guard: Ast::Expr.Absent, pos: at}
                        ]
                        branch_match_statement: Ast::Stmt = Ast::Stmt.Match(Ast::Expr.BoolLit(true, at), branch_match_arms, at)
                        branch_index: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("values", at), Ast::Expr.IntLit(0, at), at)
                        branch_match_block: Ast::Expr = Ast::Expr.Block([branch_match_statement], branch_index, [], at)
                        branch_match_region: sview @source = region_escape_stored_or_call_region_with_elements(branch_match_block, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, branch_taint_names, branch_taint_regions, branch_element_names, branch_element_regions, 10)
                        return 58 if branch_match_region != "inner"
                        branch_element_regions <- [""]
                        branch_if_statement: Ast::Stmt = Ast::Stmt.If(Ast::Expr.Ident("flag", at), [branch_push_statement], [], at)
                        branch_if_block: Ast::Expr = Ast::Expr.Block([branch_if_statement], branch_index, [], at)
                        branch_if_region: sview @source = region_escape_stored_or_call_region_with_elements(branch_if_block, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, branch_taint_names, branch_taint_regions, branch_element_names, branch_element_regions, 10)
                        return 59 if branch_if_region != "inner"
                        branch_element_regions <- [""]
                        branch_while_statement: Ast::Stmt = Ast::Stmt.While(Ast::Expr.Ident("flag", at), [branch_push_statement], at)
                        branch_while_block: Ast::Expr = Ast::Expr.Block([branch_while_statement], branch_index, [], at)
                        branch_while_region: sview @source = region_escape_stored_or_call_region_with_elements(branch_while_block, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, branch_taint_names, branch_taint_regions, branch_element_names, branch_element_regions, 10)
                        return 60 if branch_while_region != "inner"
                        branch_element_regions <- [""]
                        branch_for_statement: Ast::Stmt = Ast::Stmt.For("", ["item"], Ast::Expr.Ident("items", at), [branch_push_statement], at)
                        branch_for_block: Ast::Expr = Ast::Expr.Block([branch_for_statement], branch_index, [], at)
                        branch_for_region: sview @source = region_escape_stored_or_call_region_with_elements(branch_for_block, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, branch_taint_names, branch_taint_regions, branch_element_names, branch_element_regions, 10)
                        return 61 if branch_for_region != "inner"
                        branch_element_regions <- [""]
                        branch_break_statement: Ast::Stmt = Ast::Stmt.While(Ast::Expr.Ident("flag", at), [branch_push_statement, Ast::Stmt.Break("", at)], at)
                        branch_break_block: Ast::Expr = Ast::Expr.Block([branch_break_statement], branch_index, [], at)
                        branch_break_region: sview @source = region_escape_stored_or_call_region_with_elements(branch_break_block, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, branch_taint_names, branch_taint_regions, branch_element_names, branch_element_regions, 10)
                        return 68 if branch_break_region != "inner"
                        branch_element_regions <- [""]
                        branch_continue_statement: Ast::Stmt = Ast::Stmt.While(Ast::Expr.Ident("flag", at), [branch_push_statement, Ast::Stmt.Continue("", at)], at)
                        branch_continue_block: Ast::Expr = Ast::Expr.Block([branch_continue_statement], branch_index, [], at)
                        branch_continue_region: sview @source = region_escape_stored_or_call_region_with_elements(branch_continue_block, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, branch_taint_names, branch_taint_regions, branch_element_names, branch_element_regions, 10)
                        return 69 if branch_continue_region != "inner"
                        loop_value_names: darray[sview @source] @source = ["value"]
                        loop_value_regions: mutable darray[sview @source] @source = ["outer"]
                        loop_value_elements: darray[sview @source] @source = []
                        loop_value_element_regions: darray[sview @source] @source = []
                        loop_value_assign: Ast::Stmt = Ast::Stmt.Assign(Ast::Expr.Ident("value", at), TokenKind.Assign, region_value, at)
                        loop_value_statement: Ast::Stmt = Ast::Stmt.While(Ast::Expr.Ident("flag", at), [loop_value_assign, Ast::Stmt.Break("", at)], at)
                        loop_value_block: Ast::Expr = Ast::Expr.Block([loop_value_statement], Ast::Expr.Ident("value", at), [], at)
                        loop_value_region: sview @source = region_escape_stored_or_call_region_with_elements(loop_value_block, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, loop_value_names, loop_value_regions, loop_value_elements, loop_value_element_regions, 10)
                        return 70 if loop_value_region != "inner"
                        match_result_names: darray[sview @source] @source = ["values"]
                        match_result_regions: darray[sview @source] @source = ["outer"]
                        match_result_element_names: darray[sview @source] @source = ["values"]
                        match_result_element_regions: darray[sview @source] @source = ["inner"]
                        match_result_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Literal("true"), body: [Ast::Stmt.Expr(branch_index, at)], guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [Ast::Stmt.Expr(Ast::Expr.RegionNew(Ast::Expr.IntLit(1, at), "outer", at), at)], guard: Ast::Expr.Absent, pos: at}
                        ]
                        match_result_expr: Ast::Expr = Ast::Expr.Match(Ast::Expr.BoolLit(true, at), match_result_arms, at)
                        match_result_region: sview @source = region_escape_stored_or_call_region_with_elements(match_result_expr, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, match_result_names, match_result_regions, match_result_element_names, match_result_element_regions, 10)
                        return 62 if match_result_region != "inner"
                        catch_result_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Binding("result"), body: [Ast::Stmt.Expr(Ast::Expr.RegionNew(Ast::Expr.IntLit(1, at), "outer", at), at)], guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [Ast::Stmt.Expr(branch_index, at)], guard: Ast::Expr.Absent, pos: at}
                        ]
                        catch_result: Ast::Expr = Ast::Expr.Catch(catch_raise, catch_result_arms, at)
                        catch_result_region: sview @source = region_escape_stored_or_call_region_with_elements(catch_result, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, match_result_names, match_result_regions, match_result_element_names, match_result_element_regions, 10)
                        return 63 if catch_result_region != "inner"
                        fallible_catch_result: Ast::Expr = Ast::Expr.Catch(Ast::Expr.Call(Ast::Expr.Ident("fallible", at), [], [], at), catch_result_arms, at)
                        fallible_catch_result_region: sview @source = region_escape_stored_or_call_region_with_elements(fallible_catch_result, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, match_result_names, match_result_regions, match_result_element_names, match_result_element_regions, 10)
                        return 64 if fallible_catch_result_region != "inner"
                        catch_statement_pos: Ast::Pos = at{line = 100}
                        catch_statement_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Binding("success"), body: [Ast::Stmt.Expr(Ast::Expr.RegionNew(Ast::Expr.IntLit(1, at), "outer", at), at)], guard: Ast::Expr.Absent, pos: catch_statement_pos},
                            Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [branch_push_statement], guard: Ast::Expr.Absent, pos: catch_statement_pos}
                        ]
                        catch_statement: Ast::Stmt = Ast::Stmt.Match(catch_raise, catch_statement_arms, catch_statement_pos)
                        catch_statement_block: Ast::Expr = Ast::Expr.Block([catch_statement], branch_index, [], catch_statement_pos)
                        catch_statement_taint_names: darray[sview @source] @source = ["values"]
                        catch_statement_taint_regions: darray[sview @source] @source = ["outer"]
                        catch_statement_element_names: darray[sview @source] @source = ["values"]
                        catch_statement_element_regions: darray[sview @source] @source = [""]
                        catch_statement_lines: darray[u32] @source = [100]
                        catch_statement_region: sview @source = region_escape_stored_or_call_region_with_elements(catch_statement_block, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, catch_statement_taint_names, catch_statement_taint_regions, catch_statement_element_names, catch_statement_element_regions, 10, catch_statement_lines)
                        return 65 if catch_statement_region != "inner"
                        nested_value_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Literal("1"), body: [Ast::Stmt.Expr(Ast::Expr.RegionNew(Ast::Expr.IntLit(1, at), "outer", at), at)], guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [Ast::Stmt.Expr(Ast::Expr.RegionNew(Ast::Expr.IntLit(1, at), "inner", at), at)], guard: Ast::Expr.Absent, pos: at}
                        ]
                        nested_value: Ast::Expr = Ast::Expr.Match(Ast::Expr.IntLit(1, at), nested_value_arms, at)
                        outer_value_arms: darray[Ast::MatchArm] @source = [Ast::MatchArm{pattern: Ast::Pattern.Binding("bound"), body: [Ast::Stmt.Expr(Ast::Expr.Ident("bound", at), at)], guard: Ast::Expr.Absent, pos: at}]
                        outer_match_value: Ast::Expr = Ast::Expr.Match(nested_value, outer_value_arms, at)
                        no_catch_match_lines: darray[u32] @source = []
                        outer_match_region: sview @source = region_escape_stored_or_call_region_with_elements(outer_match_value, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, match_result_names, match_result_regions, match_result_element_names, match_result_element_regions, 10, no_catch_match_lines)
                        return 66 if outer_match_region != "outer"
                        nested_catch_arms: darray[Ast::MatchArm] @source = [
                            Ast::MatchArm{pattern: Ast::Pattern.Binding("success"), body: [Ast::Stmt.Expr(Ast::Expr.RegionNew(Ast::Expr.IntLit(1, at), "inner", at), at)], guard: Ast::Expr.Absent, pos: at},
                            Ast::MatchArm{pattern: Ast::Pattern.Wildcard, body: [Ast::Stmt.Expr(Ast::Expr.RegionNew(Ast::Expr.IntLit(1, at), "outer", at), at)], guard: Ast::Expr.Absent, pos: at}
                        ]
                        nested_catch_value: Ast::Expr = Ast::Expr.Catch(catch_raise, nested_catch_arms, at)
                        outer_catch_value: Ast::Expr = Ast::Expr.Match(nested_catch_value, outer_value_arms, at)
                        outer_catch_region: sview @source = region_escape_stored_or_call_region_with_elements(outer_catch_value, flow_annotations, flow_view_fns, flow_container_fns, flow_nesting, match_result_names, match_result_regions, match_result_element_names, match_result_element_regions, 10, no_catch_match_lines)
                        return 67 if outer_catch_region != "outer"
                        return 0

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return Semantic::region_assignment_atom_probe() can Global{Read,Write}
