def scribble() -> i64:
    total: mutable i64 = 0
    for k in 0..<8:
        region junk(4096):
            fill: mutable darray[u8] @junk = []
            for i in 0..<512:
                fill.push(90.u8())
            total <- total + fill[0].i64()
    return total

def main() -> i64:
    buf: mutable darray[i64] = [41, 42]
    pad: mutable darray[i64] = [7]
    x: i64& = &buf[0]
    t: mutable i64 = 0
    for e in move buf |t|:
        t <- t + e
    _ = scribble()
    return x + t
