def mk() -> sview:
    bytes: mutable darray[u8] = [65.u8(), 65.u8()]
    v: sview = bytes.as_sview()
    return v

def scribble() -> i64:
    total: mutable i64 = 0
    for k in 0..<8:
        region junk(4096):
            fill: mutable darray[u8] @junk = []
            for i in 0..<512:
                fill.push(90.u8())
            total <- total + fill[0].i64()
    return total

def main() -> i64:
    w: sview = mk()
    _ = scribble()
    return w[0].i64()
