def fill(p: mutable darray[i64]&, n: i64) -> void:
    r1: mutable darray[i64]& = p
    r2: mutable darray[i64]& = r1
    for i in 0..<n:
        r2.push(i + 1)

def scribble() -> i64:
    total: mutable i64 = 0
    for k in 0..<8:
        region junk(4096):
            fill: mutable darray[u8] @junk = []
            for i in 0..<512:
                fill.push(90.u8())
            total <- total + fill[0].i64()
    return total

def main() -> i64:
    xs: mutable darray[i64] = [0]
    fill(&xs, 4096)
    _ = scribble()
    return xs[4000]
