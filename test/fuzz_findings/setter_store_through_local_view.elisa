struct Hs:
    s: mutable sview

def set(h: mutable Hs&, s: sview) -> void:
    h.s <- s

def fill(h: mutable Hs&) -> void:
    b: mutable darray[u8] = [65.u8()]
    set(h, b.as_sview())

def scribble() -> i64:
    total: mutable i64 = 0
    for k in 0..<8:
        region junk(4096):
            fill: mutable darray[u8] @junk = []
            for i in 0..<512:
                fill.push(90.u8())
            total <- total + fill[0].i64()
    return total

def main() -> i64:
    h: mutable Hs = Hs{s: ""}
    fill(&h)
    _ = scribble()
    return h.s[0].i64()
