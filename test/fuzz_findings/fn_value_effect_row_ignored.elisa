# difffuzz 2026-10-04, OPEN (PERMISSIVE). stage0 rejects binding a function whose inferred
# effects include Global to a plain `fn(i64) -> i64`:
#   variable "g" expects fn(i64) -> i64, got fn(i64) -> i64 can[Global]
# stage1 has no effect row on function values at all and builds it (exit 7). The same holds
# for a declared `can[Memory.Allocate]`, and for a function passed as an ARGUMENT
# (fn_value_effect_row_ignored_arg.elisa).
global mutable gacc: i64 = 1

def bump(n: i64) -> i64:
    gacc <- gacc + n
    return n

def main() -> i64:
    g: fn(i64) -> i64 = bump
    return g(3) + gacc
