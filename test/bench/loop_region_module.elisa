module Reduction:
    public:
        def sum_scaled(scale: i64, xs: darray[i64]&, bias: i64) -> i64:
            total: mutable i64 = bias
            for value in xs |total|:
                total <- total + value * scale
            return total

def main() -> i64:
    total: mutable i64 = 0
    for i in 0..<200 |total|:
        xs: mutable darray[i64] = []
        xs.reserve(4096)
        xs.push(i)
        total <- total + Reduction::sum_scaled(2, &xs, 1)
    return 0 if total == 40000 else 1
