# Read-only borrowed DArray fold. Prints the repeated full checksum and exits with checksum % 251.
include "../../../elisacore_std/elisacore_runtime.elisa"

def repeated_sum(xs: darray[i64]&, repeats: usize) -> i64:
    total: mutable i64 = 0
    total <- for rep in 0..<repeats |total| -> total:
        total <- for index in 0..<xs.count by interleave(8) |total| -> total:
            total <- total + xs[index]
    return total

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        xs: mutable darray[i64] = []
        xs.reserve(4000000)
        state: mutable u64 = 12345
        xs <- for i in 0..<4000000 |xs, state| -> xs:
            state <- state * 6364136223846793005 + 1442695040888963407
            xs.push((state >> 33).i64())
        total: i64 = repeated_sum(&xs, 200)
        can Console{Format,Write}, Global{Read,Write}, Atomics{Exchange,Store}:
            print(total)
        return total % 251
