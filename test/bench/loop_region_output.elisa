def main() -> i64:
    out: mutable darray[i64] = []
    out.reserve(200)
    for i in 0..<200 |out|:
        xs: mutable darray[i64] = []
        xs.reserve(4096)
        xs.push(i)
        out.push(first(&xs))
    return 0 if out.count == 200 and out[0] == 0 and out[199] == 199 else 1
def first(xs: darray[i64]&) -> i64:
    total: mutable i64 = 0
    for value in xs |total|:
        total <- total + value
    return total
