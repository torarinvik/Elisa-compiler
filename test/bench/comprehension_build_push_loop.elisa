# Timing pair with comprehension_build_comprehension.elisa: one darray built from another, 4096
# elements, 40000 times. The comprehension reserves the source's count up front; the push loop
# grows from 8 by doubling. Same elements, same checks.
@inline(never)
def build(values: darray[i64]&) -> i64:
    scaled: mutable darray[i64] = []
    for value in values:
        scaled.push(value * 3 + 1)
    return scaled[scaled.count - 1]

def main() -> i64:
    values: mutable darray[i64] = []
    for i in 0..<4096:
        values.push(i)
    total: mutable i64 = 0
    for round in 0..<40000:
        total += build(values)
    return 0 if total == 40000 * 12286 else 1
