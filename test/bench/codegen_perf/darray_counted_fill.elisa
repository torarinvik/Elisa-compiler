# Unreserved counted fill: Elisa should reserve the final capacity before this loop.
include "../../../elisacore_std/elisacore_runtime.elisa"

def main() -> i64:
    xs: mutable darray[i64] = []
    seed: i64 = 0
    for i in 0..<4000000:
        xs.push(i)

    total: mutable i64 = seed
    for index in 0..<xs.count:
        total <- total + xs[index]

    can Memory.Allocate, Console{Format,Write}, Abort.Panic, Global{Read,Write}, Atomics{Exchange,Store}:
        print(total)
    return total % 251
