def nested_scan_impl(a: i64&, b: mutable i64&, n: usize, outer: usize, stop: usize) -> i64:
    if n == 0 or outer == 0: return 0
    j: mutable usize = 0
    while j < outer:
        i: mutable usize = 0
        while i < n:
            if i == stop: return i.i64()
            if a[i] > 0:
                if b[i] < 0:
                    b[i] <- a[i] + 1
            i <- i + 1
        j <- j + 1
    j.i64()
export fn scan(a: i64&, b: mutable i64&, n: usize, outer: usize, stop: usize) -> i64 = nested_scan_impl
