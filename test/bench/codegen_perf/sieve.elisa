# Sieve of Eratosthenes over a darray[u8]; repeated. Print the full checksum for validation.
include "../../../elisacore_std/elisacore_runtime.elisa"

def mark_composites(flags: darray[u8], n: usize) -> darray[u8]:
    marked, _ = while p * p < n |marked: darray[u8] = flags, p: usize = 2| -> (marked, p):
        marked <-
            if marked[p] != 0:
                while m < n |marked,m: usize = p * p| -> marked:
                    marked[m] <- 0
                    m <- m + p
            else:
                marked
        p <- p + 1
    marked

def count_primes(flags: darray[u8], n: usize) -> i64:
    for i in 0..<n |count: i64 = 0| -> count:
        count <- count + flags[i].i64()

def sieve(n: usize) -> i64:
    flags: mutable darray[u8] = [1.u8() for i in 0..<n] can Memory.Allocate
    flags[0] <- 0
    flags[1] <- 0
    count_primes(mark_composites(flags, n), n)

def main() -> i64:
    total: i64 = for r in 0..<30 |total: i64 = 0| -> total:
        total <- total + sieve(10000000)
    can Memory.Allocate, Console{Format,Write}, Abort.Panic, Global{Read,Write}, Atomics{Exchange,Store}:
        print(total)
    total % 251
