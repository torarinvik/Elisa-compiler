# Sieve of Eratosthenes over a darray[u8]; repeated. Exit code = prime count % 251.
def sieve(n: usize) -> i64:
    flags: mutable darray[u8] = []
    for i in 0..<n |flags|:
        flags.push(1)
    flags[0] <- 0
    flags[1] <- 0
    p: mutable usize = 2
    while p * p < n |p, flags|:
        if flags[p] != 0:
            m: mutable usize = p * p
            while m < n |m, flags, p|:
                flags[m] <- 0
                m <- m + p
        p <- p + 1
    count: mutable i64 = 0
    for i in 0..<n |count, flags|:
        count <- count + flags[i].i64()
    return count

def main() -> i64:
    total: mutable i64 = 0
    for r in 0..<30 |total|:
        total <- total + sieve(10000000)
    return total % 251
