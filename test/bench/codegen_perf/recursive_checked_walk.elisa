def recursive_checked_walk_visit(labels: view[i64], visited: mutable view[bool], n: usize, stop: usize) -> void:
    if n == 0 or n == stop: return
    node: usize = n - 1
    visited[node] <- true
    if labels[node] > 0:
        recursive_checked_walk_visit(labels, visited, node, stop)
    if labels[node] == 7:
        visited[node] <- false

def recursive_checked_walk_impl(input: i64&, length: usize, stop: usize) -> i64:
    if input == null or length > 128: return -1
    labels: mutable i64[128] = zeroed
    index: mutable usize = 0
    while index < length:
        labels[index] <- input[index]
        index <- index + 1
    visited: mutable bool[128] = zeroed
    recursive_checked_walk_visit(labels[0:length], visited[0:length], length, stop)
    count: mutable i64 = 0
    node: mutable usize = 0
    while node < length:
        if visited[node]: count <- count + 1
        node <- node + 1
    count

export fn recursive_checked_walk(input: i64&, length: usize, stop: usize) -> i64 = recursive_checked_walk_impl
