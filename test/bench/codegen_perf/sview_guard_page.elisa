# C ABI entry used by sview_guard_page.c. Each call constructs views from raw buffers
# placed immediately before a protected page, then exercises generated sview equality.
def sview_equality_guard_impl(left: sview, right: sview) -> bool:
    return left == right

export fn sview_equality_guard_probe(left: sview, right: sview) -> bool = sview_equality_guard_impl
