# Count-loop form of darray_sum: split each traversal into a helper so no loop is nested.
include "../../../elisacore_std/elisacore_runtime.elisa"

def count_xor(xs: darray[i64], r: i64) -> i64:
    subtotal: mutable i64 = 0
    for i in 0..<xs.count:
        subtotal <- subtotal + (xs[i] ^ r)
    return subtotal

def count_shift(xs: darray[i64]) -> i64:
    subtotal: mutable i64 = 0
    for i in 0..<xs.count:
        subtotal <- subtotal - (xs[i] >> 3)
    return subtotal

def main() -> i64:
    total: mutable i64 = 0
    xs: mutable darray[i64] = []
    xs.reserve(4000000)
    s: mutable u64 = 12345
    for i in 0..<4000000:
        s <- s * 6364136223846793005 + 1442695040888963407
        xs.push((s >> 33).i64())

    for r in 0..<200:
        total <- total + count_xor(xs, r.i64())
        total <- total + count_shift(xs)

    can Memory.Allocate, Console{Format,Write}, Abort.Panic, Global{Read,Write}, Atomics{Exchange,Store}:
        print(total)
    return total % 251
