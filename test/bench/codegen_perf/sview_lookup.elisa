include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/elisacore_runtime_strings.elisa"
# Symbol-table style linear lookup: equal-length, non-literal sview == sview compares
# (the compiler's own name-resolution shape). Exit code = checksum % 251.
def main() -> i64:
    n: usize = 4000
    buf: mutable darray[u8] = []
    s: mutable u64 = 4242
    buf <- for i in 0..<n * 8 |buf, s| -> buf:
        s <- s * 6364136223846793005 + 1442695040888963407
        buf.push((97 + (s >> 59)).u8())
    text: sview = bytes_view(buf)
    words: mutable darray[sview] = []
    words <- for w in 0..<n |words| -> words:
        words.push(text[w * 8:w * 8 + 6])
    found: mutable i64 = 0
    found <- for q in 0..<100000 |found| -> found:
        target: sview = words[(q * 7919) % n]
        found <- for j in 0..<words.count |found| -> found:
            if words[j] == target:
                found <- found + j.i64()
                break
    return found % 251
