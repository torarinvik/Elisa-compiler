# DArray growth path: start empty, append to four million, then read twice.
include "../../../elisacore_std/elisacore_runtime.elisa"

def main() -> i64:
    xs: mutable darray[i64] = []
    s: mutable u64 = 12345
    i: mutable usize = 0
    # Keep this as a while loop: the backend's counted-fill optimization would
    # reserve the complete range before the first push and hide geometric growth.
    while i < 4000000 |i, s, xs|:
        s <- s * 6364136223846793005 + 1442695040888963407
        xs.push((s >> 33).i64())
        i <- i + 1

    total: mutable i64 = 0
    for index in 0..<xs.count |total| -> total:
        total <- total + (xs[index] ^ 73)
    for value in xs |total| -> total:
        total <- total - (value >> 3)
    can Memory.Allocate, Console{Format,Write}, Abort.Panic, Global{Read,Write}, Atomics{Exchange,Store}:
        print(total)
    return total % 251
