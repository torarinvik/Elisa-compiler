# Per-call allocation: each call builds a small darray in its own auto region. Exit code = sum % 251.
def small(seed: i64) -> i64:
    xs: mutable darray[i64] = []
    for i in 0..<16 |xs, seed|:
        xs.push(seed + i.i64())
    total: mutable i64 = 0
    for x in xs |total|:
        total <- total + x
    return total

def main() -> i64:
    acc: mutable i64 = 0
    for i in 0..<20000000 |acc|:
        acc <- (acc + small(i.i64())) % 1000000007
    return acc % 251
