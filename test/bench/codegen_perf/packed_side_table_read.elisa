# Construct AoS records with one side-tabled common i64, then read that field
# in 256 full passes. The record count crosses 256-record side chunks.
include "../../../elisacore_std/elisacore_runtime.elisa"

@packed_profile(build_heavy)
packed enum PackedNode:
    common:
        @storage(side_table)
        stamp: i64
    pass

enum PackedCell is PackedNode:
    Cell(payload: i64)

def main() -> i64:
    can Memory.Allocate, Abort.Panic, Console{Format,Write}:
        region packed_side_table(16777216):
            store: PackedNode.Store[Local] = PackedNode.Store(packed_side_table)
            nodes: mutable darray[PackedNode] = []
            nodes.reserve(65536)
            total: mutable i64 = 0
            in store:
                nodes <- for i in 0..<65536 |nodes| -> nodes:
                    stamp: i64 = i.i64() + 1
                    nodes.push(new PackedCell.Cell(stamp: stamp, payload: i.i64()))
                total <- for round in 0..<256 |total| -> total:
                    total <- for node in nodes |total| -> total:
                        total <- total + node.stamp
            print(total)
            return total % 251
