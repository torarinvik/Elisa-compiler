include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/elisacore_runtime_strings.elisa"
# Equal-length views differ at byte zero; this isolates the first-byte rejection path.
def main() -> i64:
    n: usize = 4000
    bytes: mutable darray[u8] = []
    word: mutable darray[u8] = []
    state: mutable u64 = 4242
    bytes <- for w in 0..<n |bytes, word, state| -> bytes:
        word.truncate(0)
        word <- for j in 0..<6 |word, state| -> word:
            state <- state * 6364136223846793005 + 1442695040888963407
            word.push((97 + (state >> 59)).u8())
        bytes <- for j in 0..<6 |bytes| -> bytes:
            bytes.push(word[j])
        bytes.push(0)
        bytes.push(0)
        bytes.push((word[0] + 1).u8())
        bytes <- for j in 1..<6 |bytes| -> bytes:
            bytes.push(word[j])
    text: sview = bytes_view(bytes)
    misses: mutable i64 = 0
    misses <- for q in 0..<50000000 |misses| -> misses:
        index: usize = q % n
        if text[index * 14:index * 14 + 6] != text[index * 14 + 8:index * 14 + 14]:
            misses <- misses + 1
    return misses % 251
