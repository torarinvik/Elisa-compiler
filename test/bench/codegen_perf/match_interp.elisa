# Enum-with-payload interpreter loop: match dispatch over a darray of ops. Exit code = acc % 251.
enum Op:
    Add(v: i64)
    Mul(v: i64)
    Xor(v: i64)
    Neg
    Nop

def step(acc: i64, op: Op) -> i64:
    return match op:
        Op.Add(v): (acc + v) % 1000003
        Op.Mul(v): (acc * v) % 1000003
        Op.Xor(v): acc ^ v
        Op.Neg: 1000003 - acc
        Op.Nop: acc

def main() -> i64:
    ops: mutable darray[Op] = []
    s: mutable u64 = 99
    for i in 0..<1000 |ops, s|:
        s <- s * 6364136223846793005 + 1442695040888963407
        k: u64 = (s >> 33) % 5
        v: i64 = ((s >> 20) % 1000).i64()
        if k == 0:
            ops.push(Op.Add(v))
        elif k == 1:
            ops.push(Op.Mul(v))
        elif k == 2:
            ops.push(Op.Xor(v))
        elif k == 3:
            ops.push(Op.Neg)
        else:
            ops.push(Op.Nop)
    acc: mutable i64 = 1
    for rep in 0..<300000 |acc, ops|:
        for op in ops |acc|:
            acc <- step(acc, op)
    return acc % 251
