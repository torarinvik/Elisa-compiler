# Flat darray[i64] matrix multiply, n=300. Exit code = checksum % 251.
def main() -> i64:
    n: usize = 300
    a: mutable darray[i64] = []
    b: mutable darray[i64] = []
    c: mutable darray[i64] = []
    for i in 0..<n * n |a, b, c|:
        a.push((i % 17).i64())
        b.push((i % 13).i64() - 6)
        c.push(0)
    for rep in 0..<30 |a, b, c, n|:
        for i in 0..<n |a, b, c, n|:
            for k in 0..<n |a, b, c, n, i|:
                aik: i64 = a[i * n + k]
                for j in 0..<n |a, b, c, n, i, k, aik|:
                    c[i * n + j] <- c[i * n + j] + aik * b[k * n + j]
    total: mutable i64 = 0
    for x in c |total|:
        total <- total + x
    return ((total % 251) + 251) % 251
