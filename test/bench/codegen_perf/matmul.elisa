# Flat darray[i64] matrix multiply, n=300. Print the full checksum for cross-language validation.
include "../../../elisacore_std/elisacore_runtime.elisa"

def matmul(a: darray[i64], b: darray[i64], c: mutable darray[i64], n: usize) -> darray[i64]:
    c <- for rep in 0..<30 |c| -> c:
        c <- for i in 0..<n |c| -> c:
            c <- for k in 0..<n |c| -> c:
                c <- |c|
                    aik: i64 = a[i * n + k]
                    for j in 0..<n |c| -> c:
                        c[i * n + j] <- c[i * n + j] + aik * b[k * n + j]
    c

def checksum(c: darray[i64]) -> i64:
    #loop expression returns implicitly as last expression
    for x in c |total: i64 = 0| -> total:
        total <- total + x

def main() -> i64:
    total: i64 = matmul(
        [(i % 17).i64() for i in 0..<300 * 300],
        [(i % 13).i64() - 6 for i in 0..<300 * 300],
        [0.i64() for i in 0..<300 * 300],
        300,
    ).checksum() #use dot notation enabled by uniform call syntax
    can Memory.Allocate, Console{Format,Write}, Abort.Panic, Global{Read,Write}, Atomics{Exchange,Store}:
        print(total)
    ((total % 251) + 251) % 251 #implict return
