include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/elisacore_runtime_strings.elisa"
# Equal six-byte views at distinct addresses: every lookup reaches memcmp after the
# first-byte fast path. The selected pair varies so the optimizer cannot hoist the test.
def main() -> i64:
    n: usize = 4000
    bytes: mutable darray[u8] = []
    word: mutable darray[u8] = []
    state: mutable u64 = 4242
    for w in 0..<n |bytes, word, state|:
        word.truncate(0)
        for j in 0..<6 |word, state|:
            state <- state * 6364136223846793005 + 1442695040888963407
            word.push((97 + (state >> 59)).u8())
        for j in 0..<6 |bytes, word|:
            bytes.push(word[j])
        bytes.push(0)
        bytes.push(0)
        for j in 0..<6 |bytes, word|:
            bytes.push(word[j])
    text: sview = bytes_view(bytes)
    hits: mutable i64 = 0
    for q in 0..<50000000 |text, hits, n|:
        index: usize = q % n
        if text[index * 14:index * 14 + 6] == text[index * 14 + 8:index * 14 + 14]:
            hits <- hits + 1
    return hits % 251
