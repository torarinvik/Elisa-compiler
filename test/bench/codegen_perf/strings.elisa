include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/elisacore_runtime_strings.elisa"
# Byte scanning and word comparison over an sview of a darray[u8]. Exit code = checksum % 251.
def main() -> i64:
    n: usize = 8000000
    buf: mutable darray[u8] = []
    s: mutable u64 = 777
    for i in 0..<n |buf, s|:
        s <- s * 6364136223846793005 + 1442695040888963407
        r: u64 = (s >> 40) % 8
        buf.push(32 if r == 0 else (97 + (s >> 50) % 4).u8())
    text: sview = bytes_view(buf)
    words: mutable i64 = 0
    hash: mutable u64 = 1469598103934665603
    abs: mutable i64 = 0
    for rep in 0..<40 |words, hash, abs, text|:
        start: mutable usize = 0
        for i in 0..<text.len |words, hash, abs, start, text|:
            ch: u8 = text[i]
            hash <- (hash ^ ch.u64()) * 1099511628211
            if ch == 32:
                if i > start:
                    words <- words + 1
                    w: sview = text[start:i]
                    abs <- abs + 1 if w == "ab"
                start <- i + 1
    return (words + abs + (hash % 251).i64()) % 251
