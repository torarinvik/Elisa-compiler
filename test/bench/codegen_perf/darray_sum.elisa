# darray fill + indexed and iterated reads. Print the full checksum for validation.
include "../../../elisacore_std/elisacore_runtime.elisa"

def main() -> i64:
    total: mutable i64 = 0
    xs: mutable darray[i64] = []
    xs.reserve(4000000)
    s: mutable u64 = 12345
    for i in 0..<4000000:
        s <- s * 6364136223846793005 + 1442695040888963407
        xs.push((s >> 33).i64())

    for r in 0..<200:
        total <- for i in 0..<xs.count |total| -> total:
            total <- total + (xs[i] ^ r.i64())
        total <- for x in xs |total| -> total:
            total <- total - (x >> 3)
    can Memory.Allocate, Console{Format,Write}, Abort.Panic, Global{Read,Write}, Atomics{Exchange,Store}:
        print(total)
    return total % 251
