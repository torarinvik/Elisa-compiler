# darray fill + indexed and iterated reads. Exit code = checksum % 251.
def main() -> i64:
    n: usize = 4000000
    xs: mutable darray[i64] = []
    s: mutable u64 = 12345
    for i in 0..<n |xs, s|:
        s <- s * 6364136223846793005 + 1442695040888963407
        xs.push((s >> 33).i64())
    total: mutable i64 = 0
    for r in 0..<200 |total, xs|:
        for i in 0..<xs.count |total, xs, r|:
            total <- total + (xs[i] ^ r.i64())
        for x in xs |total|:
            total <- total - (x >> 3)
    return total % 251
