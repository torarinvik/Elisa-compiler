# darray of structs: field reads and writes through an index, plus a by-ref helper call.
struct P:
    x: mutable i64
    y: mutable i64
    vx: mutable i64
    vy: mutable i64

def energy(p: P&) -> i64:
    return p.vx * p.vx + p.vy * p.vy

def main() -> i64:
    ps: mutable darray[P] = []
    for i in 0..<100000 |ps|:
        k: i64 = i.i64()
        ps.push(P{x: k, y: k * 3, vx: (k % 7) - 3, vy: (k % 5) - 2})
    e: mutable i64 = 0
    for step in 0..<1000 |ps, e|:
        for i in 0..<ps.count |ps, e|:
            ps[i].x <- (ps[i].x + ps[i].vx) % 1000000
            ps[i].y <- (ps[i].y + ps[i].vy) % 1000000
            e <- e + energy(&ps[i])
    total: mutable i64 = e
    for p in ps |total|:
        total <- total + p.x + p.y
    return ((total % 251) + 251) % 251
