def batch() -> i64:
    total: mutable i64 = 0
    total <- for i in 0..<200 |total| -> total:
        xs: mutable darray[i64] = []
        xs.reserve(4096)
        xs.push(i)
        total <- total + xs[0]
    return 0 if total == 19900 else 1

def main() -> i64:
    return for iteration in 0..<200 |status: i64 = 0| -> status:
        break 1 if batch() != 0
