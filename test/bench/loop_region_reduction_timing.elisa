def batch() -> i64:
    total: mutable i64 = 0
    for i in 0..<200 |total|:
        xs: mutable darray[i64] = []
        xs.reserve(4096)
        xs.push(i)
        total <- total + first(&xs)
    return 0 if total == 19900 else 1

def main() -> i64:
    for iteration in 0..<200:
        return 1 if batch() != 0
    return 0

def first(xs: darray[i64]&) -> i64:
    total: mutable i64 = 0
    for value in xs |total|:
        total <- total + value
    return total
