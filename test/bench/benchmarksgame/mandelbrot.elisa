# Portable P4 bitmap using the benchmark's scalar escape-time algorithm.
include "common.elisa"

def mandelbrot_in_set(real: f64, imaginary: f64) -> bool:
    zr: mutable f64 = 0.0
    zi: mutable f64 = 0.0
    iterations: mutable usize = 0
    while iterations < 50 and zr * zr + zi * zi <= 4.0 |zr, zi, iterations|:
        next_real: f64 = zr * zr - zi * zi + real
        zi <- 2.0 * zr * zi + imaginary
        zr <- next_real
        iterations <- iterations + 1
    return iterations == 50

def main(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
    n: mutable usize = benchmark_argument(argc, argv, 200).usize()
    n <- 1 if n == 0
    output: mutable darray[u8] = []
    benchmark_append_view(&output, "P4\n")
    benchmark_append_usize(&output, n)
    output.push(' '.u8())
    benchmark_append_usize(&output, n)
    output.push('\n'.u8())
    for y in 0..<n |output|:
        x: mutable usize = 0
        while x < n |x, output, n, y|:
            packed: mutable u8 = 0
            for _ in 0..<8 |packed, x, output, n, y|:
                packed <- packed * 2
                if x < n:
                    real: f64 = 2.0 * x.f64() / n.f64() - 1.5
                    imaginary: f64 = 2.0 * y.f64() / n.f64() - 1.0
                    if mandelbrot_in_set(real, imaginary):
                        packed <- packed + 1
                    x <- x + 1
            output.push(packed)
    benchmark_write(output)
    return 0
