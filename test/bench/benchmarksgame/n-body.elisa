# Five-planet symplectic integrator matching the Benchmarks Game n-body task.
include "common.elisa"
extern sqrt(value: f64) -> f64
extern printf(format: cstr, ...) -> i32 can[Console, Unsafe.RawExtern]

struct NBody:
    x: f64
    y: f64
    z: f64
    vx: f64
    vy: f64
    vz: f64
    mass: f64

const NBODY_DAYS_PER_YEAR: f64 = 365.24
const NBODY_PI: f64 = 3.141592653589793
const NBODY_SOLAR_MASS: f64 = 4.0 * NBODY_PI * NBODY_PI
const NBODY_DT: f64 = 0.01

def nbody_initial() -> darray[NBody] can[Memory.Allocate, Abort.Panic]:
    return [
        NBody{x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: NBODY_SOLAR_MASS},
        NBody{x: 4.84143144246472090e+00, y: -1.16032004402742839e+00, z: -1.03622044471123109e-01, vx: 1.66007664274403694e-03 * NBODY_DAYS_PER_YEAR, vy: 7.69901118419740425e-03 * NBODY_DAYS_PER_YEAR, vz: -6.90460016972063023e-05 * NBODY_DAYS_PER_YEAR, mass: 9.54791938424326609e-04 * NBODY_SOLAR_MASS},
        NBody{x: 8.34336671824457987e+00, y: 4.12479856412430479e+00, z: -4.03523417114321381e-01, vx: -2.76742510726862411e-03 * NBODY_DAYS_PER_YEAR, vy: 4.99852801234917238e-03 * NBODY_DAYS_PER_YEAR, vz: 2.30417297573763929e-05 * NBODY_DAYS_PER_YEAR, mass: 2.85885980666130812e-04 * NBODY_SOLAR_MASS},
        NBody{x: 1.28943695621391310e+01, y: -1.51111514016986312e+01, z: -2.23307578892655734e-01, vx: 2.96460137564761618e-03 * NBODY_DAYS_PER_YEAR, vy: 2.37847173959480950e-03 * NBODY_DAYS_PER_YEAR, vz: -2.96589568540237556e-05 * NBODY_DAYS_PER_YEAR, mass: 4.36624404335156298e-05 * NBODY_SOLAR_MASS},
        NBody{x: 1.53796971148509165e+01, y: -2.59193146099879641e+01, z: 1.79258772950371181e-01, vx: 2.68067772490389322e-03 * NBODY_DAYS_PER_YEAR, vy: 1.62824170038242295e-03 * NBODY_DAYS_PER_YEAR, vz: -9.51592254519715870e-05 * NBODY_DAYS_PER_YEAR, mass: 5.15138902046611451e-05 * NBODY_SOLAR_MASS}
    ]

def nbody_offset_momentum(bodies: mutable darray[NBody]&) -> void:
    px: mutable f64 = 0.0
    py: mutable f64 = 0.0
    pz: mutable f64 = 0.0
    for body in bodies |px, py, pz| -> px, py, pz:
        px <- px + body.vx * body.mass
        py <- py + body.vy * body.mass
        pz <- pz + body.vz * body.mass
    bodies[0].vx <- -px / NBODY_SOLAR_MASS
    bodies[0].vy <- -py / NBODY_SOLAR_MASS
    bodies[0].vz <- -pz / NBODY_SOLAR_MASS

def nbody_advance(bodies: mutable darray[NBody]&) -> void:
    for i in 0..<bodies.count |bodies| -> bodies:
        start: usize = i + 1
        for j in start..<bodies.count |bodies, i| -> bodies:
            dx: f64 = bodies[i].x - bodies[j].x
            dy: f64 = bodies[i].y - bodies[j].y
            dz: f64 = bodies[i].z - bodies[j].z
            distance_squared: f64 = dx * dx + dy * dy + dz * dz
            distance: f64 = sqrt(distance_squared)
            magnitude: f64 = NBODY_DT / (distance_squared * distance)
            bodies[i].vx <- bodies[i].vx - dx * bodies[j].mass * magnitude
            bodies[i].vy <- bodies[i].vy - dy * bodies[j].mass * magnitude
            bodies[i].vz <- bodies[i].vz - dz * bodies[j].mass * magnitude
            bodies[j].vx <- bodies[j].vx + dx * bodies[i].mass * magnitude
            bodies[j].vy <- bodies[j].vy + dy * bodies[i].mass * magnitude
            bodies[j].vz <- bodies[j].vz + dz * bodies[i].mass * magnitude
    for i in 0..<bodies.count |bodies| -> bodies:
        bodies[i].x <- bodies[i].x + NBODY_DT * bodies[i].vx
        bodies[i].y <- bodies[i].y + NBODY_DT * bodies[i].vy
        bodies[i].z <- bodies[i].z + NBODY_DT * bodies[i].vz

def nbody_energy(bodies: darray[NBody]) -> f64:
    energy: mutable f64 = 0.0
    for i in 0..<bodies.count |energy, bodies| -> energy:
        body: NBody = bodies[i]
        energy <- energy + 0.5 * body.mass * (body.vx * body.vx + body.vy * body.vy + body.vz * body.vz)
        start: usize = i + 1
        for j in start..<bodies.count |energy, bodies, i, body| -> energy:
            dx: f64 = body.x - bodies[j].x
            dy: f64 = body.y - bodies[j].y
            dz: f64 = body.z - bodies[j].z
            distance: f64 = sqrt(dx * dx + dy * dy + dz * dz)
            energy <- energy - body.mass * bodies[j].mass / distance
    return energy

def main(argc: i64, argv: mutable void&) -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Unsafe.RawExtern]:
    steps: usize = benchmark_argument(argc, argv, 1000).usize()
    bodies: mutable darray[NBody] = nbody_initial()
    nbody_offset_momentum(&bodies)
    _ = printf("%.9f\n", nbody_energy(bodies))
    for _ in 0..<steps |bodies| -> bodies:
        nbody_advance(&bodies)
    _ = printf("%.9f\n", nbody_energy(bodies))
    return 0
