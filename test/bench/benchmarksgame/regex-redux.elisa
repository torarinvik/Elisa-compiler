# POSIX extended-regex version of the regex-redux substitutions and DNA scans.
include "common.elisa"

extern regcomp(regex: mutable void&, pattern: cstr, flags: i32) -> i32
extern regexec(regex: void&, text: cstr, match_count: usize, matches: mutable void&, flags: i32) -> i32
extern regfree(regex: mutable void&) -> void
extern malloc(size: usize) -> mutable heap void&? can[Memory.Allocate]
extern free(pointer: mutable heap void&) -> void

struct RegexMatch:
    start: isize
    end: isize

def regex_append_span(output: mutable darray[u8]&, input: darray[u8], start: usize, end: usize) -> void can[Memory.Allocate, Abort.Panic]:
    for index in start..<end |output, input| -> output:
        output.push(input[index])

def regex_compile(pattern: cstr) -> mutable heap void&? can[Memory.Allocate]:
    raw: mutable heap void&? = malloc(2048)
    return null if raw == null
    regex: mutable heap void& = raw
    _ = regcomp(regex, pattern, 1)
    return raw

def regex_count_matches(input: darray[u8], pattern: cstr) -> usize can[Abort.Panic, Memory.Allocate]:
    return 0 if input.count == 0
    regex_opt: mutable heap void&? = regex_compile(pattern)
    return 0 if regex_opt == null
    regex: mutable heap void& = regex_opt
    logical_length: usize = input.count - 1
    cursor: mutable usize = 0
    count: mutable usize = 0
    while cursor < logical_length |cursor, count, input| -> cursor, count:
        text: cstr = (&input[cursor]).cast[cstr] can Unsafe.PointerCast
        match: mutable RegexMatch = zeroed
        match_pointer: mutable void& = (&match).cast[mutable void&] can Unsafe.PointerCast
        status: i32 = regexec(regex, text, 1, match_pointer, 0)
        break if status != 0
        finish: usize = match.end.usize()
        count <- count + 1
        cursor <- cursor + finish
        cursor <- cursor + 1 if finish == 0
    regfree(regex)
    free(regex)
    return count

def regex_replace_all(input: darray[u8], pattern: cstr, replacement: sview) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    return input if input.count == 0
    regex_opt: mutable heap void&? = regex_compile(pattern)
    return input if regex_opt == null
    regex: mutable heap void& = regex_opt
    logical_length: usize = input.count - 1
    output: mutable darray[u8] = []
    cursor: mutable usize = 0
    while cursor < logical_length |cursor, output, input, replacement| -> cursor, output:
        text: cstr = (&input[cursor]).cast[cstr] can Unsafe.PointerCast
        match: mutable RegexMatch = zeroed
        match_pointer: mutable void& = (&match).cast[mutable void&] can Unsafe.PointerCast
        status: i32 = regexec(regex, text, 1, match_pointer, 0)
        break if status != 0
        start: usize = cursor + match.start.usize()
        finish: usize = cursor + match.end.usize()
        regex_append_span(&output, input, cursor, start)
        benchmark_append_view(&output, replacement)
        cursor <- finish
        cursor <- cursor + 1 if finish == start
    regex_append_span(&output, input, cursor, logical_length)
    output.push(0)
    regfree(regex)
    free(regex)
    return output

def regex_emit_count(output: mutable darray[u8]&, pattern: sview, count: usize) -> void can[Abort.Panic, Memory.Allocate]:
    benchmark_append_view(&output, pattern)
    output.push(' '.u8())
    benchmark_append_usize(&output, count)
    output.push('\n'.u8())

def regex_strip_fasta(input: darray[u8]) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    output: mutable darray[u8] = []
    logical_length: usize = input.count - 1
    in_header: mutable bool = false
    at_line_start: mutable bool = true
    for index in 0..<logical_length |output, in_header, at_line_start, input| -> output, in_header, at_line_start:
        byte: u8 = input[index]
        if at_line_start and byte == '>'.u8():
            in_header <- true
        if byte == '\n'.u8():
            in_header <- false
            at_line_start <- true
        else:
            at_line_start <- false
            if not in_header and byte != '\r'.u8():
                output.push(byte)
    output.push(0)
    return output

def main() -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    input: mutable darray[u8] = benchmark_read_all()
    input.push(0)
    output: mutable darray[u8] = []
    raw_length: usize = input.count - 1
    benchmark_append_usize(&output, raw_length)
    output.push('\n'.u8())

    sequence: darray[u8] = regex_strip_fasta(input)
    sequence_length: usize = sequence.count - 1
    benchmark_append_usize(&output, sequence_length)
    output.push('\n'.u8())

    regex_emit_count(&output, "agggtaaa|tttaccct", regex_count_matches(sequence, "agggtaaa|tttaccct"))
    regex_emit_count(&output, "[cgt]gggtaaa|tttaccc[acg]", regex_count_matches(sequence, "[cgt]gggtaaa|tttaccc[acg]"))
    regex_emit_count(&output, "a[act]ggtaaa|tttacc[agt]t", regex_count_matches(sequence, "a[act]ggtaaa|tttacc[agt]t"))
    regex_emit_count(&output, "ag[act]gtaaa|tttac[agt]ct", regex_count_matches(sequence, "ag[act]gtaaa|tttac[agt]ct"))
    regex_emit_count(&output, "agg[act]taaa|ttta[agt]cct", regex_count_matches(sequence, "agg[act]taaa|ttta[agt]cct"))
    regex_emit_count(&output, "aggg[acg]aaa|ttt[cgt]ccct", regex_count_matches(sequence, "aggg[acg]aaa|ttt[cgt]ccct"))
    regex_emit_count(&output, "agggt[cgt]aa|tt[acg]accct", regex_count_matches(sequence, "agggt[cgt]aa|tt[acg]accct"))
    regex_emit_count(&output, "agggta[cgt]a|t[acg]taccct", regex_count_matches(sequence, "agggta[cgt]a|t[acg]taccct"))
    regex_emit_count(&output, "agggtaa[cgt]|[acg]ttaccct", regex_count_matches(sequence, "agggtaa[cgt]|[acg]ttaccct"))

    sequence <- regex_replace_all(sequence, "tHa[Nt]", "<4>")
    sequence <- regex_replace_all(sequence, "aND|caN|Ha[DS]|WaS", "<3>")
    sequence <- regex_replace_all(sequence, "a[NSt]|BY", "<2>")
    sequence <- regex_replace_all(sequence, "<[^>]*>", "|")
    sequence <- regex_replace_all(sequence, "[|][^|][^|]*[|]", "-")
    benchmark_append_usize(&output, sequence.count - 1)
    output.push('\n'.u8())
    benchmark_write(output)
    return 0
