# Unbounded streaming pi spigot from Gibbons, using dynamic base-1e9 integers.
include "common.elisa"

const PI_BIG_BASE: u64 = 1000000000

struct PiBigInt:
    sign: mutable i64
    limbs: mutable darray[u64]

def pi_big_zero() -> PiBigInt:
    return PiBigInt{sign: 0, limbs: []}

def pi_big_from_u64(value: u64) -> PiBigInt can[Abort.Panic, Memory.Allocate]:
    limbs: mutable darray[u64] = []
    remaining: mutable u64 = value
    while remaining > 0 |limbs, remaining|:
        limbs.push(remaining % PI_BIG_BASE)
        remaining <- remaining / PI_BIG_BASE
    return PiBigInt{sign: 1 if limbs.count > 0 else 0, limbs: limbs}

def pi_big_copy_into(destination: mutable PiBigInt&, source: PiBigInt&) -> void can[Abort.Panic, Memory.Allocate]:
    destination.limbs.clear()
    for limb in source.limbs |destination|:
        destination.limbs.push(limb)
    destination.sign <- source.sign

def pi_big_assign_scaled(destination: mutable PiBigInt&, source: PiBigInt&, factor: u64) -> void can[Abort.Panic, Memory.Allocate]:
    pi_big_copy_into(destination, source)
    pi_big_multiply_small(destination, factor)

def pi_big_trim(value: mutable PiBigInt&) -> void can[Abort.Panic]:
    while value.limbs.count > 0 |value|:
        last: usize = value.limbs.count - 1
        break if value.limbs[last] != 0
        value.limbs.resize(last)
    value.sign <- 0 if value.limbs.count == 0

def pi_big_multiply_small(value: mutable PiBigInt&, factor: u64) -> void can[Abort.Panic, Memory.Allocate]:
    if factor == 0 or value.sign == 0:
        value.limbs.clear()
        value.sign <- 0
        return
    carry: mutable u64 = 0
    for index in 0..<value.limbs.count |value, carry, factor|:
        product: u64 = value.limbs[index] * factor + carry
        value.limbs[index] <- product % PI_BIG_BASE
        carry <- product / PI_BIG_BASE
    while carry > 0 |value, carry|:
        value.limbs.push(carry % PI_BIG_BASE)
        carry <- carry / PI_BIG_BASE

def pi_big_compare_abs(left: PiBigInt&, right: PiBigInt&) -> i64:
    return 1 if left.limbs.count > right.limbs.count
    return -1 if left.limbs.count < right.limbs.count
    index: mutable usize = left.limbs.count
    while index > 0 |index, left, right|:
        index <- index - 1
        return 1 if left.limbs[index] > right.limbs[index]
        return -1 if left.limbs[index] < right.limbs[index]
    return 0

def pi_big_add_abs(destination: mutable PiBigInt&, source: PiBigInt&) -> void can[Abort.Panic, Memory.Allocate]:
    old_count: usize = destination.limbs.count
    source_count: usize = source.limbs.count
    count: usize = old_count if old_count > source_count else source_count
    destination.limbs.resize(count)
    carry: mutable u64 = 0
    for index in 0..<count |destination, source, old_count, source_count, carry|:
        left: u64 = destination.limbs[index] if index < old_count else 0
        right: u64 = source.limbs[index] if index < source_count else 0
        sum: u64 = left + right + carry
        destination.limbs[index] <- sum % PI_BIG_BASE
        carry <- sum / PI_BIG_BASE
    destination.limbs.push(carry) if carry > 0

def pi_big_sub_abs(destination: mutable PiBigInt&, source: PiBigInt&) -> void can[Abort.Panic]:
    borrow: mutable u64 = 0
    old_count: usize = destination.limbs.count
    for index in 0..<old_count |destination, source, borrow|:
        left: u64 = destination.limbs[index]
        right: u64 = source.limbs[index] if index < source.limbs.count else 0
        subtrahend: u64 = right + borrow
        if left >= subtrahend:
            destination.limbs[index] <- left - subtrahend
            borrow <- 0
        else:
            destination.limbs[index] <- PI_BIG_BASE + left - subtrahend
            borrow <- 1
    pi_big_trim(destination)

def pi_big_sub_destination_from_source(destination: mutable PiBigInt&, source: PiBigInt&) -> void can[Abort.Panic, Memory.Allocate]:
    old_count: usize = destination.limbs.count
    source_count: usize = source.limbs.count
    destination.limbs.resize(source_count)
    borrow: mutable u64 = 0
    for index in 0..<source_count |destination, source, old_count, borrow|:
        left: u64 = source.limbs[index]
        right: u64 = destination.limbs[index] if index < old_count else 0
        subtrahend: u64 = right + borrow
        if left >= subtrahend:
            destination.limbs[index] <- left - subtrahend
            borrow <- 0
        else:
            destination.limbs[index] <- PI_BIG_BASE + left - subtrahend
            borrow <- 1
    destination.sign <- source.sign
    pi_big_trim(destination)

def pi_big_add_signed(destination: mutable PiBigInt&, source: PiBigInt&) -> void can[Abort.Panic, Memory.Allocate]:
    return if source.sign == 0
    if destination.sign == 0:
        pi_big_copy_into(destination, source)
        return
    if destination.sign == source.sign:
        pi_big_add_abs(destination, source)
        return
    comparison: i64 = pi_big_compare_abs(destination, source)
    if comparison == 0:
        destination.limbs.clear()
        destination.sign <- 0
    elif comparison > 0:
        pi_big_sub_abs(destination, source)
    else:
        pi_big_sub_destination_from_source(destination, source)

def pi_big_div_small_quotient(numerator: PiBigInt&, denominator: PiBigInt&, product: mutable PiBigInt&) -> usize can[Abort.Panic, Memory.Allocate]:
    low: mutable usize = 0
    high: mutable usize = 1000
    while high - low > 1 |low, high, denominator, numerator, product|:
        middle: usize = (low + high) / 2
        pi_big_assign_scaled(product, denominator, middle.u64())
        if pi_big_compare_abs(product, numerator) <= 0:
            low <- middle
        else:
            high <- middle
    return low

def pidigits_generate(count: usize) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    output: mutable darray[u8] = []
    row: mutable darray[u8] = []
    q: mutable PiBigInt = pi_big_from_u64(1)
    r: mutable PiBigInt = pi_big_zero()
    t: mutable PiBigInt = pi_big_from_u64(1)
    numerator: mutable PiBigInt = pi_big_zero()
    threshold: mutable PiBigInt = pi_big_zero()
    temporary: mutable PiBigInt = pi_big_zero()
    quotient_product: mutable PiBigInt = pi_big_zero()
    k: mutable usize = 1
    l: mutable usize = 3
    digit: mutable usize = 3
    produced: mutable usize = 0
    while produced < count |output, row, q, r, t, numerator, threshold, temporary, quotient_product, k, l, digit, produced|:
        pi_big_assign_scaled(&numerator, q, 4)
        pi_big_add_signed(&numerator, r)
        pi_big_assign_scaled(&threshold, t, (digit + 1).u64())
        if pi_big_compare_abs(numerator, threshold) < 0:
            row.push('0'.u8() + digit.u8())
            produced <- produced + 1
            pi_big_assign_scaled(&numerator, q, 3)
            pi_big_add_signed(&numerator, r)
            pi_big_multiply_small(&numerator, 10)
            next_digit: usize = pi_big_div_small_quotient(numerator, t, &quotient_product) - 10 * digit
            pi_big_assign_scaled(&temporary, t, digit.u64())
            temporary.sign <- -temporary.sign
            pi_big_add_signed(&r, temporary)
            pi_big_multiply_small(&q, 10)
            pi_big_multiply_small(&r, 10)
            digit <- next_digit
            if row.count == 10 or produced == count:
                if produced == count:
                    while row.count < 10 |row|:
                        row.push(' '.u8())
                output.extend([byte for byte in row])
                output.push('\t'.u8())
                output.push(':'.u8())
                benchmark_append_usize(&output, produced)
                output.push('\n'.u8())
                row.clear()
        else:
            pi_big_assign_scaled(&numerator, q, (7 * k + 2).u64())
            pi_big_assign_scaled(&temporary, r, l.u64())
            pi_big_add_signed(&numerator, temporary)
            pi_big_assign_scaled(&threshold, t, l.u64())
            next_digit: usize = pi_big_div_small_quotient(numerator, threshold, &quotient_product)
            pi_big_assign_scaled(&temporary, q, 2)
            pi_big_add_signed(&temporary, r)
            pi_big_multiply_small(&temporary, l.u64())
            pi_big_copy_into(&r, temporary)
            pi_big_multiply_small(&q, k.u64())
            pi_big_multiply_small(&t, l.u64())
            k <- k + 1
            l <- l + 2
            digit <- next_digit
    return output

def main(argc: i64, argv: mutable void&) -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    count: usize = benchmark_argument(argc, argv, 27).usize()
    output: darray[u8] = pidigits_generate(count)
    benchmark_write(output)
    return 0
