# Bottom-up allocation of every tree node, with explicit recursive reclamation.
include "common.elisa"
extern malloc(size: usize) -> mutable heap void&? can[Memory.Allocate]
extern free(pointer: mutable heap void&) -> void
extern printf(format: cstr, ...) -> i32 can[Console, Unsafe.RawExtern]

struct BenchTreeNode:
    left: mutable heap BenchTreeNode&?
    right: mutable heap BenchTreeNode&?

def tree_make(depth: usize) -> mutable heap BenchTreeNode& can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    raw: mutable heap void&? = malloc(size_of(BenchTreeNode))
    assert raw != null
    node: mutable heap BenchTreeNode& = raw.cast[mutable heap BenchTreeNode&] can Unsafe.PointerCast
    node[0] <- BenchTreeNode{left: null, right: null}
    if depth > 0:
        child_depth: usize = depth - 1
        node.left <- tree_make(child_depth)
        node.right <- tree_make(child_depth)
    return node

def tree_check(node: mutable heap BenchTreeNode&) -> i64:
    result: mutable i64 = 1
    if node.left != null:
        result <- result + tree_check(node.left)
    if node.right != null:
        result <- result + tree_check(node.right)
    return result

def tree_free(node: mutable heap BenchTreeNode&) -> void:
    if node.left != null:
        tree_free(node.left)
    if node.right != null:
        tree_free(node.right)
    raw: mutable heap void& = node.cast[mutable heap void&] can Unsafe.PointerCast
    free(raw)

def main(argc: i64, argv: mutable void&) -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Unsafe.RawExtern]:
    requested: usize = benchmark_argument(argc, argv, 10).usize()
    max_depth: mutable usize = requested
    max_depth <- 6 if max_depth < 6
    stretch_depth: usize = max_depth + 1
    stretch: mutable heap BenchTreeNode& = tree_make(stretch_depth)
    _ = printf("stretch tree of depth %lld\t check: %lld\n", stretch_depth.i64(), tree_check(stretch))
    tree_free(stretch)

    long_lived: mutable heap BenchTreeNode& = tree_make(max_depth)
    depth: mutable usize = 4
    while depth <= max_depth |depth, max_depth| -> depth:
        iterations: usize = 1.usize() << (max_depth - depth + 4)
        check: mutable i64 = 0
        end_index: usize = iterations + 1
        for index in 1.usize()..<end_index |check, depth| -> check:
            positive: mutable heap BenchTreeNode& = tree_make(depth)
            check <- check + tree_check(positive)
            tree_free(positive)
            negative: mutable heap BenchTreeNode& = tree_make(depth)
            check <- check + tree_check(negative)
            tree_free(negative)
        _ = printf("%lld\t trees of depth %lld\t check: %lld\n", (iterations * 2).i64(), depth.i64(), check)
        depth <- depth + 2
    _ = printf("long lived tree of depth %lld\t check: %lld\n", max_depth.i64(), tree_check(long_lived))
    tree_free(long_lived)
    return 0
