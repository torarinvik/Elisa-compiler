# Canonical count-array permutation order and prefix-reversal checksum.
include "common.elisa"
extern printf(format: cstr, ...) -> i32 can[Console, Unsafe.RawExtern]

def main(argc: i64, argv: mutable void&) -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Unsafe.RawExtern]:
    n: mutable usize = benchmark_argument(argc, argv, 7).usize()
    n <- 1 if n == 0
    perm: mutable darray[usize] = [i for i in 0..<n]
    count: mutable darray[usize] = [0 for _ in 0..<n]
    work: mutable darray[usize] = []
    work.resize(n)
    checksum: mutable i64 = 0
    maximum: mutable usize = 0
    permutation_index: mutable usize = 0
    while true |perm, count, work, checksum, maximum, permutation_index|:
        for index in 0..<n |work, perm|:
            work[index] <- perm[index]
        flips: mutable usize = 0
        while work[0] != 0 |work, flips|:
            last: usize = work[0]
            left: mutable usize = 0
            right: mutable usize = last
            while left < right |work, left, right|:
                saved: usize = work[left]
                work[left] <- work[right]
                work[right] <- saved
                left <- left + 1
                right <- right - 1
            flips <- flips + 1
        if flips > maximum:
            maximum <- flips
        if permutation_index % 2 == 0:
            checksum <- checksum + flips.i64()
        else:
            checksum <- checksum - flips.i64()
        r: mutable usize = 1
        while r < n |r, perm, count|:
            first: usize = perm[0]
            index: mutable usize = 0
            while index < r |index, perm|:
                perm[index] <- perm[index + 1]
                index <- index + 1
            perm[r] <- first
            count[r] <- count[r] + 1
            break if count[r] <= r
            count[r] <- 0
            r <- r + 1
        break if r == n
        permutation_index <- permutation_index + 1
    _ = printf("%lld\nPfannkuchen(%lld) = %lld\n", checksum, n.i64(), maximum.i64())
    return 0
