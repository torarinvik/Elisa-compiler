# Hash-table accumulation of rolling 2-bit nucleotide keys for the THREE record.
include "common.elisa"

extern printf(format: cstr, ...) -> i32 can[Console, Unsafe.RawExtern]

struct KmerFrequency:
    code: u64
    count: usize

def kmer_base(byte: u8) -> u64:
    return 0 if byte == 'A'.u8() or byte == 'a'.u8()
    return 1 if byte == 'C'.u8() or byte == 'c'.u8()
    return 2 if byte == 'G'.u8() or byte == 'g'.u8()
    return 3

def kmer_encode(text: sview) -> u64:
    encoded: mutable u64 = 0
    for index in 0..<text.len |encoded| -> encoded:
        encoded <- (encoded << 2) | kmer_base(text[index].u8())
    return encoded

def kmer_count(sequence: darray[u8], width: usize) -> dict[u64, usize] can[Abort.Panic, Memory.Allocate, Global{Read,Write}]:
    counts: mutable dict[u64, usize] = {}
    return counts if sequence.count < width
    mask: u64 = (1.u64() << (width * 2)) - 1
    encoded: mutable u64 = 0
    valid: mutable usize = 0
    for byte in sequence |counts, encoded, valid, width, mask| -> counts, encoded, valid:
        encoded <- ((encoded << 2) | kmer_base(byte)) & mask
        valid <- valid + 1
        if valid >= width:
            key: u64 = encoded
            next_count: mutable usize = 1
            next_count <- previous + 1 if counts.get(key) is previous
            counts <- counts.put(key, next_count) can Global{Read,Write}
    return counts

def kmer_write_code(output: mutable darray[u8]&, code: u64, width: usize) -> void can[Memory.Allocate, Abort.Panic]:
    alphabet: sview = "ACGT"
    for position in 0..<width |output, code, width| -> output:
        shift: usize = (width - position - 1) * 2
        base: usize = ((code >> shift) & 3).usize()
        output.push(alphabet[base].u8())

def kmer_percent_milli(count: usize, total: usize) -> usize:
    return 0 if total == 0
    return (count * 100000 + total / 2) / total

def kmer_write_frequency_rows(output: mutable darray[u8]&, counts: dict[u64, usize], width: usize, sequence_length: usize) -> void can[Abort.Panic, Memory.Allocate]:
    possible: usize = 1.usize() << (width * 2)
    rows: mutable darray[KmerFrequency] = []
    for code in 0..<possible |rows, counts| -> rows:
        rows.push(KmerFrequency{code: code.u64(), count: amount}) if counts.get(code.u64()) is amount
    for position in 0..<rows.count |rows| -> rows:
        best: mutable usize = position
        for candidate in position + 1..<rows.count |best, rows, position| -> best:
            if rows[candidate].count > rows[best].count or (rows[candidate].count == rows[best].count and rows[candidate].code < rows[best].code):
                best <- candidate
        saved: KmerFrequency = rows[position]
        rows[position] <- rows[best]
        rows[best] <- saved
    total_windows: usize = sequence_length - width + 1
    for row in rows |output, total_windows, width| -> output:
        kmer_write_code(&output, row.code, width)
        output.push(' '.u8())
        milli: usize = kmer_percent_milli(row.count, total_windows)
        benchmark_append_usize(&output, milli / 1000)
        output.push('.'.u8())
        fraction: usize = milli % 1000
        output.push('0'.u8() + (fraction / 100).u8())
        output.push('0'.u8() + ((fraction / 10) % 10).u8())
        output.push('0'.u8() + (fraction % 10).u8())
        output.push('\n'.u8())
    output.push('\n'.u8())

def kmer_extract_three(input: darray[u8]) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
    sequence: mutable darray[u8] = []
    active: mutable bool = false
    line_start: mutable usize = 0
    while line_start < input.count |sequence, active, line_start, input| -> sequence, active, line_start:
        line_end: mutable usize = line_start
        while line_end < input.count and input[line_end] != '\n'.u8() |line_end, input| -> line_end:
            line_end <- line_end + 1
        header: bool = input[line_start] == '>'.u8()
        if header:
            three: bool = line_end - line_start >= 6 and input[line_start + 1] == 'T'.u8() and input[line_start + 2] == 'H'.u8() and input[line_start + 3] == 'R'.u8() and input[line_start + 4] == 'E'.u8() and input[line_start + 5] == 'E'.u8()
            if three:
                active <- true
            else:
                break if active
                active <- false
        elif active:
            for position in line_start..<line_end |sequence, input| -> sequence:
                byte: u8 = input[position]
                sequence.push(byte) if byte != '\r'.u8() and byte != ' '.u8() and byte != '\t'.u8()
        line_start <- line_end + 1
    return sequence

def main() -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Unsafe.RawExtern, Global{Read,Write}]:
    input: darray[u8] = benchmark_read_all()
    sequence: darray[u8] = kmer_extract_three(input)
    output: mutable darray[u8] = []
    one_counts: dict[u64, usize] = kmer_count(sequence, 1)
    two_counts: dict[u64, usize] = kmer_count(sequence, 2)
    kmer_write_frequency_rows(&output, one_counts, 1, sequence.count)
    kmer_write_frequency_rows(&output, two_counts, 2, sequence.count)
    queries: darray[sview] = ["GGT", "GGTA", "GGTATT", "GGTATTTTAATT", "GGTATTTTAATTTATAGT"]
    for query in queries |output, sequence| -> output:
        width: usize = query.len.usize()
        counts: dict[u64, usize] = kmer_count(sequence, width)
        amount: usize = 0
        amount <- count if counts.get(kmer_encode(query)) is count
        benchmark_append_usize(&output, amount)
        output.push('\t'.u8())
        benchmark_append_view(&output, query)
        output.push('\n'.u8())
    benchmark_write(output)
    return 0
