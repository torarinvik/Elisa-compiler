# Spectral norm by the ten-step power method. Keep the four matrix-vector
# operations separate so the generated loops can be inspected independently.
include "common.elisa"
extern sqrt(value: f64) -> f64
extern printf(format: cstr, ...) -> i32 can[Console, Unsafe.RawExtern]

def spectral_a(i: usize, j: usize) -> f64:
    sum: usize = i + j
    denominator: usize = sum * (sum + 1) / 2 + i + 1
    return 1.0 / denominator.f64()

def spectral_times(u: darray[f64], v: mutable darray[f64]&, n: usize) -> void:
    for i in 0..<n |v| -> v:
        sum: mutable f64 = 0.0
        for j in 0..<n |sum| -> sum:
            sum <- sum + spectral_a(i, j) * u[j]
        v[i] <- sum

def spectral_times_transposed(u: darray[f64]&, v: mutable darray[f64]&, n: usize) -> void:
    for i in 0..<n |v| -> v:
        sum: mutable f64 = 0.0
        for j in 0..<n |sum| -> sum:
            sum <- sum + spectral_a(j, i) * u[j]
        v[i] <- sum

def spectral_ata(u: darray[f64], v: mutable darray[f64]&, temporary: mutable darray[f64]&, n: usize) -> void:
    spectral_times(u, temporary, n)
    spectral_times_transposed(temporary, v, n)

def spectral_power(n: usize) -> f64 can[Memory.Allocate, Abort.Panic]:
    u: mutable darray[f64] = [1.0 for _ in 0..<n]
    v: mutable darray[f64] = [0.0 for _ in 0..<n]
    temporary: mutable darray[f64] = [0.0 for _ in 0..<n]
    for _ in 0..<10 |u, v, temporary| -> u, v, temporary:
        spectral_ata(u, &v, &temporary, n)
        spectral_ata(v, &u, &temporary, n)
    uv: mutable f64 = 0.0
    vv: mutable f64 = 0.0
    for i in 0..<n |u, v, uv, vv| -> uv, vv:
        uv <- uv + u[i] * v[i]
        vv <- vv + v[i] * v[i]
    return sqrt(uv / vv)

def main(argc: i64, argv: mutable void&) -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Unsafe.RawExtern]:
    n: usize = benchmark_argument(argc, argv, 1000).usize()
    result: f64 = spectral_power(n)
    _ = printf("%.9f\n", result)
    return 0
