# Streaming FASTA records into one record buffer and emitting IUPAC complements.
include "common.elisa"

def reverse_complement_byte(value: u8) -> u8:
    return when value:
        65 | 85 -> 'T'.u8() # A | U
        67 -> 'G'.u8() # C
        71 -> 'C'.u8() # G
        84 -> 'A'.u8() # T
        77 -> 'K'.u8() # M
        82 -> 'Y'.u8() # R
        87 -> 'W'.u8() # W
        83 -> 'S'.u8() # S
        89 -> 'R'.u8() # Y
        75 -> 'M'.u8() # K
        86 -> 'B'.u8() # V
        72 -> 'D'.u8() # H
        68 -> 'H'.u8() # D
        66 -> 'V'.u8() # B
        78 -> 'N'.u8() # N
        97 | 117 -> 't'.u8() # a | u
        99 -> 'g'.u8() # c
        103 -> 'c'.u8() # g
        116 -> 'a'.u8() # t
        109 -> 'k'.u8() # m
        114 -> 'y'.u8() # r
        119 -> 'w'.u8() # w
        115 -> 's'.u8() # s
        121 -> 'r'.u8() # y
        107 -> 'm'.u8() # k
        118 -> 'b'.u8() # v
        104 -> 'd'.u8() # h
        100 -> 'h'.u8() # d
        98 -> 'v'.u8() # b
        110 -> 'n'.u8() # n
        _ -> value

def reverse_complement_emit_record(output: mutable darray[u8]&, header: darray[u8], sequence: darray[u8]) -> void can[Memory.Allocate, Abort.Panic]:
    return if header.count == 0
    for byte in header |output|:
        output.push(byte)
    end: mutable usize = sequence.count
    while end > 0 |end, output, sequence|:
        line_count: usize = 60
        line_count <- end if end < 60
        for _ in 0..<line_count |end, output, sequence|:
            end <- end - 1
            output.push(reverse_complement_byte(sequence[end]))
        output.push('\n'.u8())

def main() -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    input: darray[u8] = benchmark_read_all()
    output: mutable darray[u8] = []
    header: mutable darray[u8] = []
    sequence: mutable darray[u8] = []
    index: mutable usize = 0
    while index < input.count |input, output, header, sequence, index|:
        byte: u8 = input[index]
        if byte == '>'.u8():
            reverse_complement_emit_record(&output, header, sequence)
            header <- []
            sequence <- []
            while index < input.count |input, header, index|:
                header.push(input[index])
                is_end: bool = input[index] == '\n'.u8()
                index <- index + 1
                break if is_end
        else:
            sequence.push(byte) if byte != '\n'.u8() and byte != '\r'.u8()
            index <- index + 1
    reverse_complement_emit_record(&output, header, sequence)
    benchmark_write(output)
    return 0
