# FASTA with the specified 287-byte ALU repeat and naïve per-base LCG draws.
include "common.elisa"

const FASTA_IM: i64 = 139968
const FASTA_IA: i64 = 3877
const FASTA_IC: i64 = 29573

def fasta_cumulative(probabilities: darray[f64]) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
    cumulative: mutable darray[f64] = []
    total: mutable f64 = 0.0
    for probability in probabilities |cumulative, total|:
        total <- total + probability
        cumulative.push(total)
    return cumulative

def fasta_emit_repeat(output: mutable darray[u8]&, sequence: sview, count: usize) -> void can[Memory.Allocate, Abort.Panic]:
    position: mutable usize = 0
    while position < count |position, output, sequence|:
        line_count: usize = 60
        line_count <- count - position if count - position < 60
        for _ in 0..<line_count |position, output, sequence|:
            output.push(sequence[position % sequence.len].u8())
            position <- position + 1
        output.push('\n'.u8())

def fasta_emit_random(output: mutable darray[u8]&, count: usize, alphabet: sview, cumulative: darray[f64], seed: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
    position: mutable usize = 0
    while position < count |position, output, alphabet, cumulative, seed|:
        line_count: usize = 60
        line_count <- count - position if count - position < 60
        for _ in 0..<line_count |position, output, alphabet, cumulative, seed|:
            seed <- (seed * FASTA_IA + FASTA_IC) % FASTA_IM
            random: f64 = seed.f64() / FASTA_IM.f64()
            choice: mutable usize = 0
            while choice + 1 < cumulative.count and random >= cumulative[choice] |choice, cumulative|:
                choice <- choice + 1
            output.push(alphabet[choice].u8())
            position <- position + 1
        output.push('\n'.u8())

def main(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
    n: usize = benchmark_argument(argc, argv, 1000).usize()
    output: mutable darray[u8] = []
    alu: sview = "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGGGAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGACCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAATACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCAGCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGGAGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCCAGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA"
    benchmark_append_view(&output, ">ONE Homo sapiens alu\n")
    fasta_emit_repeat(&output, alu, n * 2)

    iub_alphabet: sview = "acgtBDHKMNRSVWY"
    iub_cumulative: darray[f64] = fasta_cumulative([0.27, 0.12, 0.12, 0.27, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02])
    seed: mutable i64 = 42
    benchmark_append_view(&output, ">TWO IUB ambiguity codes\n")
    fasta_emit_random(&output, n * 3, iub_alphabet, iub_cumulative, &seed)

    human_alphabet: sview = "acgt"
    human_cumulative: darray[f64] = fasta_cumulative([0.3029549426680, 0.1979883004921, 0.1975473066391, 0.3015094502008])
    benchmark_append_view(&output, ">THREE Homo sapiens frequency\n")
    fasta_emit_random(&output, n * 5, human_alphabet, human_cumulative, &seed)
    benchmark_write(output)
    return 0
