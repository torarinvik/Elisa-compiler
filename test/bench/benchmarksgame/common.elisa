# Shared command-line and byte-stream support for the Benchmarks Game ports.
include "../../../elisacore_std/elisacore_runtime.elisa"

extern atoi(text: cstr) -> i32
extern read(fd: int, buffer: void&, count: usize) -> isize can[Console]
extern write(fd: int, buffer: void&, count: usize) -> isize can[Console]

def benchmark_argument(argc: i64, argv: mutable void&, fallback: i64 = 0) -> i64 can[Unsafe.PointerCast]:
    return fallback if argc < 2
    slots: mutable cstr&& = argv.cast[mutable cstr&&] can Unsafe.PointerCast
    return atoi(slots[1].cast[cstr]).i64()

def benchmark_write(bytes: darray[u8]&) -> void can[Console, Unsafe.PointerCast]:
    offset: mutable usize = 0
    while offset < bytes.count |offset| -> offset:
        buffer: void& = (&bytes[offset]).cast[void&] can Unsafe.PointerCast
        amount: isize = write(1, buffer, bytes.count - offset)
        break if amount <= 0
        offset <- offset + amount.usize()

def benchmark_append_view(bytes: mutable darray[u8]&, text: sview) -> void can[Memory.Allocate, Abort.Panic]:
    for index in 0..<text.len |bytes| -> bytes:
        bytes.push(text[index].u8())

def benchmark_append_usize(bytes: mutable darray[u8]&, value: usize) -> void can[Memory.Allocate, Abort.Panic]:
    digits: mutable darray[u8] = []
    remaining: mutable usize = value
    if remaining == 0:
        bytes.push('0'.u8())
        return
    while remaining > 0 |digits, remaining| -> digits, remaining:
        digits.push('0'.u8() + (remaining % 10).u8())
        remaining <- remaining / 10
    for index in 0..<digits.count |bytes, digits| -> bytes:
        bytes.push(digits[digits.count - index - 1])

def benchmark_append_i64(bytes: mutable darray[u8]&, value: i64) -> void can[Memory.Allocate, Abort.Panic]:
    if value < 0:
        bytes.push('-'.u8())
        benchmark_append_usize(bytes, (-(value + 1) + 1).usize())
        return
    benchmark_append_usize(bytes, value.usize())

def benchmark_read_all() -> darray[u8] can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    contents: mutable darray[u8] = []
    chunk: mutable darray[u8] = []
    chunk.resize(65536)
    while true |contents, chunk| -> contents, chunk:
        buffer: void& = (&chunk[0]).cast[void&] can Unsafe.PointerCast
        amount: isize = read(0, buffer, chunk.count)
        break if amount <= 0
        for index in 0..<amount.usize() |contents, chunk| -> contents:
            contents.push(chunk[index])
    return contents
