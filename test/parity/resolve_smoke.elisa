# Name-resolution smoke: lex + parse + resolve references, returning the count of
# unresolved (undefined) value-position identifiers. Anchors the resolver call graph.
include "../../src/semantic/semantic.elisa"


def resolve_smoke(source: u8&, source_length: usize, unresolved_out: mutable u64&):
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Token] = frontend_tokenize_with_length(source, source, source_length)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        unresolved_out[0] <- Semantic::unresolved_references(file)


export fn resolve_smoke_export(source: u8&, source_length: usize, unresolved_out: mutable u64&) -> void = resolve_smoke


# Run the full semantic check and report the located diagnostics: the total count and
# the source line of the first UndefinedName diagnostic (0 if none). Exercises the
# diagnostics layer's position capture, not just the count.
def diag_probe(source: u8&, source_length: usize, count_out: mutable u64&, first_undef_line_out: mutable u32&):
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Token] = frontend_tokenize_with_length(source, source, source_length)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        table: Semantic::SymbolTable = Semantic::check(file)
        count_out[0] <- table.diagnostics.count.u64()
        first_undef_line_out[0] <- 0
        for d in table.diagnostics:
            if d.kind == Semantic::DiagnosticKind.UndefinedName and first_undef_line_out[0] == 0:
                first_undef_line_out[0] <- d.line


export fn diag_probe_export(source: u8&, source_length: usize, count_out: mutable u64&, first_undef_line_out: mutable u32&) -> void = diag_probe


# Run the full check and report the mutability/signature findings: the count of
# AssignImmutable diagnostics (+ the first one's line) and the count of
# DuplicateParam diagnostics. Guards the checker's mutation analysis end-to-end.
def mutability_probe(source: u8&, source_length: usize, immut_count_out: mutable u64&, first_immut_line_out: mutable u32&, dup_param_count_out: mutable u64&, arity_count_out: mutable u64&, first_arity_line_out: mutable u32&, dup_local_count_out: mutable u64&):
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Token] = frontend_tokenize_with_length(source, source, source_length)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        table: Semantic::SymbolTable = Semantic::check(file)
        immut_count_out[0] <- 0
        first_immut_line_out[0] <- 0
        dup_param_count_out[0] <- 0
        arity_count_out[0] <- 0
        first_arity_line_out[0] <- 0
        dup_local_count_out[0] <- 0
        for d in table.diagnostics:
            if d.kind == Semantic::DiagnosticKind.AssignImmutable:
                immut_count_out[0] <- immut_count_out[0] + 1
                if first_immut_line_out[0] == 0:
                    first_immut_line_out[0] <- d.line
            elif d.kind == Semantic::DiagnosticKind.DuplicateParam:
                dup_param_count_out[0] <- dup_param_count_out[0] + 1
            elif d.kind == Semantic::DiagnosticKind.ArityMismatch:
                arity_count_out[0] <- arity_count_out[0] + 1
                if first_arity_line_out[0] == 0:
                    first_arity_line_out[0] <- d.line
            elif d.kind == Semantic::DiagnosticKind.DuplicateLocal:
                dup_local_count_out[0] <- dup_local_count_out[0] + 1


# Count the unused-binding hints (and the first flagged line of each kind).
def unused_probe(source: u8&, source_length: usize, param_count_out: mutable u64&, first_param_line_out: mutable u32&, local_count_out: mutable u64&, first_local_line_out: mutable u32&):
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Token] = frontend_tokenize_with_length(source, source, source_length)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        table: Semantic::SymbolTable = Semantic::check(file)
        param_count_out[0] <- 0
        first_param_line_out[0] <- 0
        local_count_out[0] <- 0
        first_local_line_out[0] <- 0
        for d in table.diagnostics:
            if d.kind == Semantic::DiagnosticKind.UnusedParam:
                param_count_out[0] <- param_count_out[0] + 1
                if first_param_line_out[0] == 0:
                    first_param_line_out[0] <- d.line
            elif d.kind == Semantic::DiagnosticKind.UnusedLocal:
                local_count_out[0] <- local_count_out[0] + 1
                if first_local_line_out[0] == 0:
                    first_local_line_out[0] <- d.line


export fn unused_probe_export(source: u8&, source_length: usize, param_count_out: mutable u64&, first_param_line_out: mutable u32&, local_count_out: mutable u64&, first_local_line_out: mutable u32&) -> void = unused_probe


# Count return-shape findings (value-in-void / missing-value) + first line.
def returns_probe(source: u8&, source_length: usize, void_count_out: mutable u64&, missing_count_out: mutable u64&, first_line_out: mutable u32&):
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Token] = frontend_tokenize_with_length(source, source, source_length)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        table: Semantic::SymbolTable = Semantic::check(file)
        void_count_out[0] <- 0
        missing_count_out[0] <- 0
        first_line_out[0] <- 0
        for d in table.diagnostics:
            if d.kind == Semantic::DiagnosticKind.ReturnValueInVoid:
                void_count_out[0] <- void_count_out[0] + 1
                if first_line_out[0] == 0:
                    first_line_out[0] <- d.line
            elif d.kind == Semantic::DiagnosticKind.MissingReturnValue:
                missing_count_out[0] <- missing_count_out[0] + 1
                if first_line_out[0] == 0:
                    first_line_out[0] <- d.line


export fn returns_probe_export(source: u8&, source_length: usize, void_count_out: mutable u64&, missing_count_out: mutable u64&, first_line_out: mutable u32&) -> void = returns_probe


# Count unknown-enum-variant findings + the first flagged line.
def variant_probe(source: u8&, source_length: usize, count_out: mutable u64&, first_line_out: mutable u32&):
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Token] = frontend_tokenize_with_length(source, source, source_length)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        table: Semantic::SymbolTable = Semantic::check(file)
        count_out[0] <- 0
        first_line_out[0] <- 0
        for d in table.diagnostics:
            if d.kind == Semantic::DiagnosticKind.UnknownVariant or d.kind == Semantic::DiagnosticKind.VariantArity or d.kind == Semantic::DiagnosticKind.TypeMismatch or d.kind == Semantic::DiagnosticKind.NonBoolCondition:
                count_out[0] <- count_out[0] + 1
                if first_line_out[0] == 0:
                    first_line_out[0] <- d.line


export fn variant_probe_export(source: u8&, source_length: usize, count_out: mutable u64&, first_line_out: mutable u32&) -> void = variant_probe


# Count capture-mutability findings: the number of CaptureImmutable diagnostics and
# the first flagged line. Exercises the value-block capture parity path.
def capture_probe(source: u8&, source_length: usize, immut_count_out: mutable u64&, first_line_out: mutable u32&):
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Token] = frontend_tokenize_with_length(source, source, source_length)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        table: Semantic::SymbolTable = Semantic::check(file)
        immut_count_out[0] <- 0
        first_line_out[0] <- 0
        for d in table.diagnostics:
            if d.kind == Semantic::DiagnosticKind.CaptureImmutable:
                immut_count_out[0] <- immut_count_out[0] + 1
                if first_line_out[0] == 0:
                    first_line_out[0] <- d.line


export fn capture_probe_export(source: u8&, source_length: usize, immut_count_out: mutable u64&, first_line_out: mutable u32&) -> void = capture_probe


# Dump every UndefinedName diagnostic's line into `out_lines` (capped), returning
# the count — the per-line classifier for resolver-change delta triage.
def undef_lines_probe(source: u8&, source_length: usize, out_lines: mutable u32&, cap: usize) -> u64:
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Token] = frontend_tokenize_with_length(source, source, source_length)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        table: Semantic::SymbolTable = Semantic::unresolved_table(file)
        n: mutable usize = 0
        for d in table.diagnostics:
            if d.kind == Semantic::DiagnosticKind.UndefinedName:
                if n < cap:
                    out_lines[n] <- d.line
                n <- n + 1
        return n.u64()


export fn undef_lines_probe_export(source: u8&, source_length: usize, out_lines: mutable u32&, cap: usize) -> u64 = undef_lines_probe


# Dump the offending identifier TEXT (not just the line) for every UndefinedName
# diagnostic, newline-separated, into `out` (capped at `out_cap` bytes). This is the
# actionable counterpart to `undef_lines_probe`: a whole-program self-resolve run
# (see check_self_hostable.sh) that reports "3 unresolved" is useless to a developer
# hunting a runtime-only helper leak (e.g. `sview_dirname` resolving for parse_report
# via the stage0 compiler + linked runtime, but invisible to the self-hosted
# resolver's seed_builtins whitelist) — printing the actual name makes the failure
# fixable in one glance instead of requiring a bisection.
def undef_names_probe(source: u8&, source_length: usize, out: mutable u8&, out_cap: usize) -> u64:
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Token] = frontend_tokenize_with_length(source, source, source_length)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        table: Semantic::SymbolTable = Semantic::unresolved_table(file)
        n: mutable usize = 0
        for d in table.diagnostics:
            if d.kind == Semantic::DiagnosticKind.UndefinedName:
                name_len: usize = sview_len(d.name)
                i: mutable usize = 0
                while i < name_len and n < out_cap:
                    out[n] <- sview_at(d.name, i)
                    n <- n + 1
                    i <- i + 1
                if n < out_cap:
                    out[n] <- 10
                    n <- n + 1
        return n.u64()


export fn undef_names_probe_export(source: u8&, source_length: usize, out: mutable u8&, out_cap: usize) -> u64 = undef_names_probe


export fn mutability_probe_export(source: u8&, source_length: usize, immut_count_out: mutable u64&, first_immut_line_out: mutable u32&, dup_param_count_out: mutable u64&, arity_count_out: mutable u64&, first_arity_line_out: mutable u32&, dup_local_count_out: mutable u64&) -> void = mutability_probe


# Run the full semantic check and report duplicate-declaration findings: the count
# of DuplicateDecl diagnostics and the source line of the first one (0 if none).
# Exercises symbol-collection's duplicate detection (add_symbol / name_indexed),
# which the resolution-focused probes above never touch.
def dup_probe(source: u8&, source_length: usize, dup_count_out: mutable u64&, first_dup_line_out: mutable u32&):
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Token] = frontend_tokenize_with_length(source, source, source_length)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        table: Semantic::SymbolTable = Semantic::check(file)
        c: mutable u64 = 0
        first_dup_line_out[0] <- 0
        for d in table.diagnostics:
            if d.kind == Semantic::DiagnosticKind.DuplicateDecl:
                c <- c + 1
                if first_dup_line_out[0] == 0:
                    first_dup_line_out[0] <- d.line
        dup_count_out[0] <- c


export fn dup_probe_export(source: u8&, source_length: usize, dup_count_out: mutable u64&, first_dup_line_out: mutable u32&) -> void = dup_probe


# Map a stable numeric code to a DiagnosticKind so the C driver can drive the
# wording/severity source-of-truth (`diagnostic_message` / `diagnostic_severity`)
# without depending on the enum's in-memory encoding.
def diag_kind_of_code(code: u32) -> Semantic::DiagnosticKind:
    can Abort.Panic:
        return match code:
            0: Semantic::DiagnosticKind.UndefinedName
            1: Semantic::DiagnosticKind.DuplicateDecl
            6: Semantic::DiagnosticKind.AssignImmutable
            7: Semantic::DiagnosticKind.DuplicateParam
            8: Semantic::DiagnosticKind.ArityMismatch
            9: Semantic::DiagnosticKind.DuplicateLocal
            10: Semantic::DiagnosticKind.UnusedParam
            11: Semantic::DiagnosticKind.UnusedLocal
            12: Semantic::DiagnosticKind.ReturnValueInVoid
            13: Semantic::DiagnosticKind.MissingReturnValue
            14: Semantic::DiagnosticKind.UnknownVariant
            15: Semantic::DiagnosticKind.VariantArity
            16: Semantic::DiagnosticKind.TypeMismatch
            17: Semantic::DiagnosticKind.NonBoolCondition
            40: Semantic::DiagnosticKind.InvalidCast
            42: Semantic::DiagnosticKind.NonTrailingDefaultParam
            43: Semantic::DiagnosticKind.CallArgumentError
            44: Semantic::DiagnosticKind.EnumConstructorArgumentError
            2: Semantic::DiagnosticKind.SyntaxExpectedToken
            3: Semantic::DiagnosticKind.SyntaxUnexpectedToken
            4: Semantic::DiagnosticKind.SyntaxExpectedDeclaration
            5: Semantic::DiagnosticKind.SyntaxExpectedExpression
            _: Semantic::DiagnosticKind.UndefinedName


# Write the canonical message for `code`'s diagnostic kind into `out` (capped at
# `out_cap`), returning the byte length. Guards diagnostic_message's per-kind
# wording (e.g. an arm swap or an empty return), which no end-to-end probe reads.
def diag_message_probe(code: u32, out: mutable u8&, out_cap: usize) -> u64:
    can Memory.Allocate, Abort.Panic:
        d: Semantic::Diagnostic = Semantic::Diagnostic{name: sview("x", 0, -1), line: 0, kind: diag_kind_of_code(code), expected: sview("", 0, 0), actual: sview("", 0, 0)}
        msg: darray[u8] = Semantic::diagnostic_message(d)
        n: mutable usize = msg.count
        if n > out_cap:
            n <- out_cap
        for i in 0..<n:
            out[i] <- msg[i]
        return n.u64()


# Canonical LSP severity for `code`'s diagnostic kind.
def diag_severity_probe(code: u32) -> u32:
    can Abort.Panic:
        d: Semantic::Diagnostic = Semantic::Diagnostic{name: sview("x", 0, -1), line: 0, kind: diag_kind_of_code(code), expected: sview("", 0, 0), actual: sview("", 0, 0)}
        return Semantic::diagnostic_severity(d).u32()


export fn diag_message_probe_export(code: u32, out: mutable u8&, out_cap: usize) -> u64 = diag_message_probe
export fn diag_severity_probe_export(code: u32) -> u32 = diag_severity_probe


# Inverse of diag_kind_of_code: a stable numeric code for a DiagnosticKind, so the
# C driver can assert which kind a syntax finding mapped to.
def code_of_diag_kind(k: Semantic::DiagnosticKind) -> u32:
    can Abort.Panic:
        return match k:
            Semantic::DiagnosticKind.UndefinedName:             0
            Semantic::DiagnosticKind.DuplicateDecl:             1
            Semantic::DiagnosticKind.AssignImmutable:           6
            Semantic::DiagnosticKind.DuplicateParam:            7
            Semantic::DiagnosticKind.ArityMismatch:             8
            Semantic::DiagnosticKind.DuplicateLocal:            9
            Semantic::DiagnosticKind.UnusedParam:               10
            Semantic::DiagnosticKind.UnusedLocal:               11
            Semantic::DiagnosticKind.ReturnValueInVoid:         12
            Semantic::DiagnosticKind.MissingReturnValue:        13
            Semantic::DiagnosticKind.UnknownVariant:            14
            Semantic::DiagnosticKind.VariantArity:              15
            Semantic::DiagnosticKind.TypeMismatch:              16
            Semantic::DiagnosticKind.NonBoolCondition:          17
            Semantic::DiagnosticKind.NonBoolOperand:            31
            Semantic::DiagnosticKind.NonNumericOperand:         32
            Semantic::DiagnosticKind.IncompatibleComparison:    33
            Semantic::DiagnosticKind.BreakOutsideLoop:          18
            Semantic::DiagnosticKind.ContinueOutsideLoop:       19
            Semantic::DiagnosticKind.UnreachableCode:           20
            Semantic::DiagnosticKind.UnreachableMatchArm:       21
            Semantic::DiagnosticKind.DuplicateField:            22
            Semantic::DiagnosticKind.DuplicateVariant:          23
            Semantic::DiagnosticKind.NonExhaustiveMatch:        24
            Semantic::DiagnosticKind.UnknownField:              25
            Semantic::DiagnosticKind.DuplicateFieldInit:        26
            Semantic::DiagnosticKind.MissingField:              27
            Semantic::DiagnosticKind.DuplicateType:             28
            Semantic::DiagnosticKind.AssignUndefinedTarget:     29
            Semantic::DiagnosticKind.InvalidAssignTarget:       30
            Semantic::DiagnosticKind.ValueBlockMutation:        34
            Semantic::DiagnosticKind.CaptureUndefined:          35
            Semantic::DiagnosticKind.CaptureImmutable:          36
            Semantic::DiagnosticKind.UnknownFieldType:          37
            Semantic::DiagnosticKind.RecursiveStruct:           38
            Semantic::DiagnosticKind.NonIterableLoop:           39
            Semantic::DiagnosticKind.InvalidCast:               40
            Semantic::DiagnosticKind.SyntaxExpectedToken:       2
            Semantic::DiagnosticKind.SyntaxUnexpectedToken:     3
            Semantic::DiagnosticKind.SyntaxExpectedDeclaration: 4
            Semantic::DiagnosticKind.SyntaxExpectedExpression:  5
            Semantic::DiagnosticKind.LmutAliasing:              41
            Semantic::DiagnosticKind.NonTrailingDefaultParam:   42
            Semantic::DiagnosticKind.CallArgumentError:         43
            Semantic::DiagnosticKind.EnumConstructorArgumentError: 44
            Semantic::DiagnosticKind.SelfAssignment:            45
            Semantic::DiagnosticKind.SelfComparison:            46
            Semantic::DiagnosticKind.UnusedExpression:          47
            Semantic::DiagnosticKind.ConstantCondition:         48
            Semantic::DiagnosticKind.RedundantBoolCompare:      49
            Semantic::DiagnosticKind.DuplicateImport:           50
            Semantic::DiagnosticKind.DuplicateMatchArm:         51
            Semantic::DiagnosticKind.DivisionByZero:            52
            Semantic::DiagnosticKind.ArrayLiteralArity:         53
            Semantic::DiagnosticKind.UnknownTypeName:           54
            Semantic::DiagnosticKind.DuplicateDictKey:          55
            Semantic::DiagnosticKind.DuplicateSetElement:       56
            Semantic::DiagnosticKind.IndexOutOfBounds:          57
            Semantic::DiagnosticKind.SelfArithmetic:            58
            Semantic::DiagnosticKind.DoubleNegation:            59
            Semantic::DiagnosticKind.InfiniteLoopNoExit:        60
            Semantic::DiagnosticKind.RedundantArithmetic:       61
            Semantic::DiagnosticKind.EmptyRange:                62
            Semantic::DiagnosticKind.AssignToLoopVar:           63
            Semantic::DiagnosticKind.ConstantComparison:        64
            Semantic::DiagnosticKind.DuplicateCondition:        65
            Semantic::DiagnosticKind.DiscardedCallResult:       66
            Semantic::DiagnosticKind.VoidValueUse:              67
            Semantic::DiagnosticKind.LiteralArgTypeMismatch:    68
            Semantic::DiagnosticKind.OversizedShift:            69
            Semantic::DiagnosticKind.NegativeShift:             70
            Semantic::DiagnosticKind.LiteralAssignOutOfRange:   71
            Semantic::DiagnosticKind.LiteralComparisonImpossible: 72
            Semantic::DiagnosticKind.DuplicateVariantField:     73
            Semantic::DiagnosticKind.IdenticalLogicalOperands:  74
            Semantic::DiagnosticKind.IdenticalBranches:         75
            Semantic::DiagnosticKind.EmptyIterable:             76
            Semantic::DiagnosticKind.UnusedImport:              77
            Semantic::DiagnosticKind.FloatEquality:             78
            Semantic::DiagnosticKind.NegativeIndex:             79
            Semantic::DiagnosticKind.DuplicatePatternBinding:   80
            Semantic::DiagnosticKind.ImmediateOverwrite:        81
            Semantic::DiagnosticKind.ModuloByZero:              82
            Semantic::DiagnosticKind.ShiftByZero:               83
            Semantic::DiagnosticKind.LogicalConstantOperand:    84
