            Semantic::DiagnosticKind.NonBoolMatchGuard:         91
            Semantic::DiagnosticKind.RedundantCast:             92
            Semantic::DiagnosticKind.UnknownFieldAccess:        93
            Semantic::DiagnosticKind.ConstructFieldTypeMismatch: 94
            Semantic::DiagnosticKind.NamedTypeMismatch:         95
            Semantic::DiagnosticKind.VoidArgument:              96
            Semantic::DiagnosticKind.NonNumericShiftOperand:    97
            Semantic::DiagnosticKind.CompoundAssignNonNumeric:  98
            Semantic::DiagnosticKind.StringIndexNonNumeric:     99
            Semantic::DiagnosticKind.VoidFieldAccess:           100
            Semantic::DiagnosticKind.VoidIndex:                 101
            Semantic::DiagnosticKind.CallNonFunction:           102
            Semantic::DiagnosticKind.ShiftOperandNonIntegral:   103
            Semantic::DiagnosticKind.VoidOperand:               104
            Semantic::DiagnosticKind.VoidCondition:             105
            Semantic::DiagnosticKind.TernaryBranchMismatch:     106
            Semantic::DiagnosticKind.ArrayLiteralElementTypeMismatch: 107
            Semantic::DiagnosticKind.StringIndexNonIntegral:    108
