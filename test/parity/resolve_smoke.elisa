            Semantic::DiagnosticKind.VoidMatchScrutinee:        111
            Semantic::DiagnosticKind.OrderingNonNumeric:        112
            Semantic::DiagnosticKind.RangeBoundNonIntegral:     113
            Semantic::DiagnosticKind.DArrayElementTypeMismatch: 114
            Semantic::DiagnosticKind.SetElementTypeMismatch:    115
            Semantic::DiagnosticKind.DictValueTypeMismatch:     116
            Semantic::DiagnosticKind.DictKeyTypeMismatch:       117
            Semantic::DiagnosticKind.CallNamedNonFunction:      118
            Semantic::DiagnosticKind.StructPatternTypeMismatch: 119
            Semantic::DiagnosticKind.MatchArmEnumMismatch:      120
            Semantic::DiagnosticKind.InvalidBoolCast:           121
            Semantic::DiagnosticKind.FieldImmutableAssign:      122
