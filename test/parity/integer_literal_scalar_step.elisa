# Runtime boundaries for the scalar-return integer decoder transition.
module Parser:
    private:
        const TEST_SCOPE: bool = true
include "../../src/parser/parser_integer_literal.elisa"
extend Parser:
    public:
        def decode(text: sview) -> i64:
            return parse_int_literal_value(text)

@test def integer_decode_cases() -> void:
    assert Parser::decode("") == 0
    assert Parser::decode("0") == 0
    assert Parser::decode("123") == 123
    assert Parser::decode("12_345") == 12345
    assert Parser::decode("0x2a") == 42
    assert Parser::decode("0XFF") == 255
    assert Parser::decode("0xF_F") == 255
    assert Parser::decode("18446744073709551615") == -1
    assert Parser::decode("18446744073709551616") == -1
    assert Parser::decode("0xFFFFFFFFFFFFFFFF") == -1
    assert Parser::decode("0x10000000000000000") == -1
    assert Parser::decode("9223372036854775807") == 9223372036854775807
    assert Parser::decode("12z") == 0
    assert Parser::decode("0xG") == 0
