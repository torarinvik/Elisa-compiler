@test
def test_extern_composite_error_families_exclude_selected_variants() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& @source = "error FooError:\n    Bad1\n    Bad2\n\nerror BarError:\n    Bad3\n    Bad4(n: u32)\n\nextern foo() -> i64 error[FooError{Bad1}, BarError{Bad3, Bad4}]\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        family_count: mutable usize = 0
        allowed_variant_count: mutable usize = 0
        found_foo: mutable bool = false
        found_bar: mutable bool = false
        found_bad1: mutable bool = false
        found_bad3: mutable bool = false
        found_bad4: mutable bool = false
        unexpected_family: mutable bool = false
        unexpected_allowed_variant: mutable bool = false
        found_composite_key: mutable bool = false
        found_composite_module: mutable bool = false
        found_family_identity: mutable bool = false
        family_identity: mutable u32 = 0
        family_offset: mutable u32 = 0
        family_identity_mismatch: mutable bool = false
        found_composite_key_identity: mutable bool = false
        found_composite_module_identity: mutable bool = false
        for annotation in file.enum_annotations |family_count, allowed_variant_count, found_foo, found_bar, found_bad1, found_bad3, found_bad4, unexpected_family, unexpected_allowed_variant, found_composite_key, found_composite_module, found_family_identity, family_identity, family_offset, family_identity_mismatch, found_composite_key_identity, found_composite_module_identity|:
            if annotation.owner == "__error_set_family":
                family_count <- family_count + 1
                found_foo <- true if annotation.name == "FooError"
                found_bar <- true if annotation.name == "BarError"
                unexpected_family <- true if annotation.name != "FooError" and annotation.name != "BarError"
                if not found_family_identity:
                    family_identity <- annotation.identity_id
                    family_offset <- annotation.offset
                    found_family_identity <- true
                else:
                    family_identity_mismatch <- true if annotation.identity_id != family_identity or annotation.offset != family_offset
            if annotation.owner == "__error_set_key" and annotation.name == "FooError{Bad1}, BarError{Bad3, Bad4}":
                found_composite_key <- true
                found_composite_key_identity <- annotation.identity_id == family_identity and annotation.offset == family_offset if found_family_identity
            if annotation.owner == "__error_set_module" and annotation.name == "":
                found_composite_module <- true
                found_composite_module_identity <- annotation.identity_id == family_identity and annotation.offset == family_offset if found_family_identity
            if annotation.owner == "__error_variant_allow":
                allowed_variant_count <- allowed_variant_count + 1
                found_bad1 <- true if annotation.name == "Bad1"
                found_bad3 <- true if annotation.name == "Bad3"
                found_bad4 <- true if annotation.name == "Bad4"
                unexpected_allowed_variant <- true if annotation.name != "Bad1" and annotation.name != "Bad3" and annotation.name != "Bad4"
        assert family_count == 2
        assert found_foo and found_bar
        assert not unexpected_family
        assert allowed_variant_count == 3
        assert found_bad1 and found_bad3 and found_bad4
        assert not unexpected_allowed_variant
        assert found_composite_key
        assert found_composite_module
        assert found_family_identity and not family_identity_mismatch
        assert found_composite_key_identity and found_composite_module_identity




@test
def test_header_error_sets_keep_parameter_and_return_occurrences_separate() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& @source = "error CallbackError:\n    CallbackBad\n\nerror ReturnError:\n    ReturnBad\n\nerror ExtraError:\n    ExtraBad\n\nextern foo(callback: fn() -> i64 error[CallbackError{CallbackBad}]) -> i64 error[ReturnError{ReturnBad}, ExtraError{ExtraBad}]\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        callback_occurrence: mutable u32 = 0
        return_occurrence: mutable u32 = 0
        return_marker_occurrence: mutable u32 = 0
        callback_key_found: mutable bool = false
        return_key_found: mutable bool = false
        callback_module_found: mutable bool = false
        return_module_found: mutable bool = false
        for annotation in file.enum_annotations |callback_occurrence, return_occurrence, return_marker_occurrence, callback_key_found, return_key_found, callback_module_found, return_module_found|:
            if annotation.owner == "__error_set_family":
                callback_occurrence <- annotation.occurrence_offset if annotation.name == "CallbackError"
                return_occurrence <- annotation.occurrence_offset if annotation.name == "ReturnError"
            if annotation.owner == "foo" and annotation.name == "__error_return":
                return_marker_occurrence <- annotation.occurrence_offset
            if annotation.owner == "__error_set_key" and annotation.name == "CallbackError{CallbackBad}":
                callback_key_found <- annotation.occurrence_offset == callback_occurrence
            if annotation.owner == "__error_set_key" and annotation.name == "ReturnError{ReturnBad}, ExtraError{ExtraBad}":
                return_key_found <- annotation.occurrence_offset == return_occurrence
            if annotation.owner == "__error_set_module" and annotation.name == "":
                callback_module_found <- true if annotation.occurrence_offset == callback_occurrence
                return_module_found <- true if annotation.occurrence_offset == return_occurrence
        assert callback_occurrence != 0 and return_occurrence != 0 and callback_occurrence != return_occurrence
        assert return_marker_occurrence == return_occurrence
        assert callback_key_found and return_key_found
        assert callback_module_found and return_module_found
        callback_only_src: u8& @source = "error CallbackError:\n    CallbackBad\n\nextern callback_only(callback: fn() -> i64 error[CallbackError{CallbackBad}]) -> i64\n"
        callback_only_file: Ast::File = parse_snippet(callback_only_src) can Global{Read,Write}
        assert callback_only_file.errors.count == 0
        callback_only_key_found: mutable bool = false
        callback_only_return_found: mutable bool = false
        for annotation in callback_only_file.enum_annotations |callback_only_key_found, callback_only_return_found|:
            callback_only_key_found <- true if annotation.owner == "__error_set_key" and annotation.name == "CallbackError{CallbackBad}"
            callback_only_return_found <- true if annotation.owner == "callback_only" and annotation.name == "__error_return"
        assert callback_only_key_found and not callback_only_return_found



@test
def test_function_valued_extern_and_export_keep_outer_error_occurrence() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& @source = "error CallbackError:\n    CallbackBad\n\nerror ReturnError:\n    ReturnBad\n\nextern make() -> fn() -> i64 error[CallbackError] error[ReturnError]\nexport fn exported_make() -> fn() -> i64 error[CallbackError] error[ReturnError] = make_impl\nextern returned_callback_only() -> fn() -> i64 error[CallbackError]\nexport fn exported_returned_callback_only() -> fn() -> i64 error[CallbackError] = returned_callback_impl\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        make_occurrence: mutable u32 = 0
        export_occurrence: mutable u32 = 0
        make_declaration_offset: mutable u32 = 0
        export_declaration_offset: mutable u32 = 0
        make_inner_occurrence: mutable u32 = 0
        export_inner_occurrence: mutable u32 = 0
        make_outer_occurrence: mutable u32 = 0
        export_outer_occurrence: mutable u32 = 0
        returned_only_marker_found: mutable bool = false
        exported_returned_only_marker_found: mutable bool = false
        for annotation in file.enum_annotations |make_occurrence, export_occurrence, make_declaration_offset, export_declaration_offset, make_inner_occurrence, export_inner_occurrence, make_outer_occurrence, export_outer_occurrence, returned_only_marker_found, exported_returned_only_marker_found|:
            if annotation.owner == "make" and annotation.name == "__error_return":
                make_occurrence <- annotation.occurrence_offset
                make_declaration_offset <- annotation.offset
            if annotation.owner == "exported_make" and annotation.name == "__error_return":
                export_occurrence <- annotation.occurrence_offset
                export_declaration_offset <- annotation.offset
            if annotation.owner == "__error_set_family":
                if annotation.name == "CallbackError" and annotation.offset == make_declaration_offset:
                    make_inner_occurrence <- annotation.occurrence_offset
                if annotation.name == "CallbackError" and annotation.offset == export_declaration_offset:
                    export_inner_occurrence <- annotation.occurrence_offset
                if annotation.name == "ReturnError":
                    make_outer_occurrence <- annotation.occurrence_offset if annotation.offset == make_declaration_offset
                    export_outer_occurrence <- annotation.occurrence_offset if annotation.offset == export_declaration_offset
            returned_only_marker_found <- true if annotation.owner == "returned_callback_only" and annotation.name == "__error_return"
            exported_returned_only_marker_found <- true if annotation.owner == "exported_returned_callback_only" and annotation.name == "__error_return"
        assert make_occurrence != 0 and export_occurrence != 0
        assert make_outer_occurrence == make_occurrence
        assert export_outer_occurrence == export_occurrence
        assert make_inner_occurrence != make_occurrence
        assert export_inner_occurrence != export_occurrence
        assert not returned_only_marker_found and not exported_returned_only_marker_found



@test
# `parse_snippet` checks parser recovery only; Stage0's semantic resolver rejects an
# empty error set. Keep the marker so recovery metadata still identifies the source span.
def test_empty_error_variant_group_keeps_recovery_marker() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& @source = "error EmptyError:\n    Never\n\nextern empty() -> i64 error[EmptyError{}]\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        occurrence: mutable u32 = 0
        restriction_found: mutable bool = false
        allow_found: mutable bool = false
        for annotation in file.enum_annotations |occurrence, restriction_found, allow_found|:
            occurrence <- annotation.occurrence_offset if annotation.owner == "empty" and annotation.name == "__error_return"
            restriction_found <- true if annotation.owner == "__error_variant_family" and annotation.name == "EmptyError" and annotation.occurrence_offset == occurrence
            allow_found <- true if annotation.owner == "__error_variant_allow" and annotation.occurrence_offset == occurrence
        assert occurrence != 0
        assert restriction_found
        assert not allow_found
        protocol_src: u8& @source = "error EmptyError:\n    Never\n\nprotocol EmptyProtocol:\n    def empty() -> i64 error[EmptyError{}]\n"
        protocol_file: Ast::File = parse_snippet(protocol_src) can Global{Read,Write}
        assert protocol_file.errors.count == 0
        protocol_restriction_found: mutable bool = false
        protocol_allow_found: mutable bool = false
        for annotation in protocol_file.enum_annotations |protocol_restriction_found, protocol_allow_found|:
            protocol_restriction_found <- true if annotation.owner == "__protocol_error_variant_family" and annotation.name == "EmptyError" and annotation.line == 3900000146
            protocol_allow_found <- true if annotation.owner == "EmptyError" and annotation.line == 3900000147
        assert protocol_restriction_found
        assert not protocol_allow_found
        parameter_src: u8& @source = "error EmptyError:\n    Never\n\nprotocol CallbackProtocol:\n    def run(callback: fn() -> i64 error[EmptyError{}]) -> i64\n"
        parameter_file: Ast::File = parse_snippet(parameter_src) can Global{Read,Write}
        assert parameter_file.errors.count == 0
        protocol_method_offset: mutable u32 = 0
        parameter_empty_occurrence: mutable u32 = 0
        parameter_family_found: mutable bool = false
        parameter_path_found: mutable bool = false
        parameter_marker_found: mutable bool = false
        for annotation in parameter_file.enum_annotations |protocol_method_offset, parameter_empty_occurrence, parameter_family_found, parameter_path_found, parameter_marker_found|:
            protocol_method_offset <- annotation.offset if annotation.owner == "CallbackProtocol" and annotation.name == "run" and annotation.line == 3900000060
            if annotation.owner == "__error_set_family" and annotation.name == "EmptyError":
                parameter_empty_occurrence <- annotation.occurrence_offset
                parameter_family_found <- true if annotation.offset == protocol_method_offset
            parameter_path_found <- true if annotation.owner == "__error_set_family_path" and annotation.name == "EmptyError" and annotation.offset == protocol_method_offset and annotation.occurrence_offset == parameter_empty_occurrence
            parameter_marker_found <- true if annotation.owner == "__error_variant_family" and annotation.name == "EmptyError" and annotation.offset == protocol_method_offset and annotation.occurrence_offset == parameter_empty_occurrence
        assert protocol_method_offset != 0 and parameter_empty_occurrence != 0
        assert parameter_family_found and parameter_path_found and parameter_marker_found
        bracket_src: u8& @source = "extern empty_brackets() -> i64 error[]\n"
        bracket_file: Ast::File = parse_snippet(bracket_src) can Global{Read,Write}
        assert bracket_file.errors.count == 0
        empty_bracket_marker_found: mutable bool = false
        for annotation in bracket_file.enum_annotations |empty_bracket_marker_found|:
            empty_bracket_marker_found <- true if annotation.owner == "__empty_error_set" and annotation.line == 1 and annotation.occurrence_offset != 0
        assert empty_bracket_marker_found
        nested_bracket_src: u8& @source = "extern accepts(callback: fn() -> i64 error[]) -> i64\n"
        nested_bracket_file: Ast::File = parse_snippet(nested_bracket_src) can Global{Read,Write}
        assert nested_bracket_file.errors.count == 0
        nested_empty_bracket_count: mutable usize = 0.usize()
        for annotation in nested_bracket_file.enum_annotations |nested_empty_bracket_count|:
            nested_empty_bracket_count <- nested_empty_bracket_count + 1.usize() if annotation.owner == "__empty_error_set"
        assert nested_empty_bracket_count == 1.usize()



@test
def test_dotted_error_subset_keeps_qualified_family_path_and_identity() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& @source = "module First:\n    public:\n        error Fault:\n            Bad\n            Other\n\nextern restricted() -> i64 error[First::Fault.Bad]\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        family_index: mutable usize = file.enum_annotations.count
        family_count: mutable usize = 0.usize()
        for index in 0..<file.enum_annotations.count |family_index, family_count, file|:
            candidate_row: Ast::EnumAnnotation = file.enum_annotations[index]
            if candidate_row.owner == "__error_set_family" and candidate_row.name == "Fault":
                family_index <- index
                family_count <- family_count + 1.usize()
        assert family_count == 1.usize()
        assert family_index + 3.usize() < file.enum_annotations.count
        family_row: Ast::EnumAnnotation = file.enum_annotations[family_index]
        path_row: Ast::EnumAnnotation = file.enum_annotations[family_index + 1.usize()]
        subset_marker: Ast::EnumAnnotation = file.enum_annotations[family_index + 2.usize()]
        allowed_variant: Ast::EnumAnnotation = file.enum_annotations[family_index + 3.usize()]
        assert family_row.owner == "__error_set_family"
        assert family_row.name == "Fault"
        assert family_row.family_order_key == "First.Fault"
        assert path_row.owner == "__error_set_family_path"
        assert path_row.name == "First::Fault"
        assert subset_marker.owner == "__error_variant_family"
        assert subset_marker.name == "Fault"
        assert allowed_variant.owner == "__error_variant_allow"
        assert allowed_variant.name == "Bad"
        assert path_row.line == family_row.line and path_row.offset == family_row.offset and path_row.identity_id == family_row.identity_id and path_row.occurrence_offset == family_row.occurrence_offset
        assert subset_marker.line == family_row.line and subset_marker.offset == family_row.offset and subset_marker.identity_id == family_row.identity_id and subset_marker.occurrence_offset == family_row.occurrence_offset
        assert allowed_variant.line == family_row.line and allowed_variant.offset == family_row.offset and allowed_variant.identity_id == family_row.identity_id and allowed_variant.occurrence_offset == family_row.occurrence_offset



@test
def test_nested_function_effect_clause_does_not_hide_outer_error_set() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& @source = "error FunctionError:\n    FunctionBad\n\nerror ReturnError:\n    ReturnBad\n\nextern can_maker() -> fn() -> i64 can[Abort.Panic] error[FunctionError] error[ReturnError]\nexport fn exported_can_maker() -> fn() -> i64 can[Abort.Panic] error[FunctionError] error[ReturnError] = can_impl\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        can_maker_offset: mutable u32 = 0
        exported_maker_offset: mutable u32 = 0
        can_maker_occurrence: mutable u32 = 0
        exported_maker_occurrence: mutable u32 = 0
        can_maker_family_found: mutable bool = false
        exported_maker_family_found: mutable bool = false
        can_maker_nested_family_found: mutable bool = false
        exported_maker_nested_family_found: mutable bool = false
        for annotation in file.enum_annotations |can_maker_offset, exported_maker_offset, can_maker_occurrence, exported_maker_occurrence, can_maker_family_found, exported_maker_family_found, can_maker_nested_family_found, exported_maker_nested_family_found|:
            if annotation.owner == "can_maker" and annotation.name == "__error_return":
                can_maker_offset <- annotation.offset
                can_maker_occurrence <- annotation.occurrence_offset
            if annotation.owner == "exported_can_maker" and annotation.name == "__error_return":
                exported_maker_offset <- annotation.offset
                exported_maker_occurrence <- annotation.occurrence_offset
            if annotation.owner == "__error_set_family" and annotation.name == "ReturnError":
                can_maker_family_found <- true if annotation.offset == can_maker_offset and annotation.occurrence_offset == can_maker_occurrence
                exported_maker_family_found <- true if annotation.offset == exported_maker_offset and annotation.occurrence_offset == exported_maker_occurrence
            if annotation.owner == "__error_set_family" and annotation.name == "FunctionError":
                can_maker_nested_family_found <- true if annotation.offset == can_maker_offset and annotation.occurrence_offset != can_maker_occurrence
                exported_maker_nested_family_found <- true if annotation.offset == exported_maker_offset and annotation.occurrence_offset != exported_maker_occurrence
        assert can_maker_occurrence != 0 and exported_maker_occurrence != 0
        assert can_maker_family_found and exported_maker_family_found
        assert can_maker_nested_family_found and exported_maker_nested_family_found



@test
def test_returned_function_error_set_is_not_enclosing_function_error_set() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& @source = "error InnerError:\n    InnerBad\n\ndef maker() -> fn() -> i64 error[InnerError]:\n    return fn() -> i64 error[InnerError] => 7\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        found_function_type_family: mutable bool = false
        found_enclosing_return_marker: mutable bool = false
        for annotation in file.enum_annotations |found_function_type_family, found_enclosing_return_marker|:
            found_function_type_family <- true if annotation.owner == "__error_set_family" and annotation.name == "InnerError"
            found_enclosing_return_marker <- true if annotation.owner == "maker" and annotation.name == "__error_return"
        assert found_function_type_family
        assert not found_enclosing_return_marker

        outer_src: u8& @source = "error InnerError:\n    InnerBad\n\nerror OuterError:\n    OuterBad\n\ndef maker() -> fn() -> i64 error[InnerError] error[OuterError]:\n    return fn() -> i64 error[InnerError] => 7\n"
        outer_file: Ast::File = parse_snippet(outer_src) can Global{Read,Write}
        assert outer_file.errors.count == 0
        inner_occurrence: mutable u32 = 0
        outer_occurrence: mutable u32 = 0
        enclosing_occurrence: mutable u32 = 0
        for annotation in outer_file.enum_annotations |inner_occurrence, outer_occurrence, enclosing_occurrence|:
            if annotation.owner == "__error_set_family" and annotation.name == "InnerError":
                inner_occurrence <- annotation.occurrence_offset
            if annotation.owner == "__error_set_family" and annotation.name == "OuterError":
                outer_occurrence <- annotation.occurrence_offset
            if annotation.owner == "maker" and annotation.name == "__error_return":
                enclosing_occurrence <- annotation.occurrence_offset
        assert inner_occurrence != 0 and outer_occurrence != 0
        assert inner_occurrence != outer_occurrence
        assert enclosing_occurrence == outer_occurrence



@test
def test_tuple_pattern_keeps_every_element() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& @source = "def f(node: i64) -> i64:\n    match node:\n        x, y:\n            return x + y\n        _:\n            return 0\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        match body[0]:
            Stmt.Match(scrutinee, arms, line):
                assert arms.count == 2
                match arms[0].pattern:
                    Ast::Pattern.Tuple(elements):
                        assert elements.count == 2
                        match elements[0]:
                            Ast::Pattern.Binding(name):
                                assert name == "x"
                            _:
                                assert false
                        match elements[1]:
                            Ast::Pattern.Binding(name):
                                assert name == "y"
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false



@test
def test_protocol_error_families_keep_method_scope_and_offset() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& @source = "module First:\n    error Fault:\n        Full\n    error CallbackErr:\n        Failed\n    protocol Sink:\n        def push(callback: fn() -> i64 error[CallbackErr]) -> i64 error[First::Fault{Full}]\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        protocol_method_offset: mutable u32 = 0
        protocol_error_offset: mutable u32 = 0
        protocol_error_occurrence_offset: mutable u32 = 0
        protocol_error_module: mutable sview = ""
        protocol_error_path: mutable sview = ""
        saw_callback_error_as_protocol_family: mutable bool = false
        protocol_subset_seen: mutable bool = false
        protocol_subset_variant_seen: mutable bool = false
        for annotation in file.enum_annotations |protocol_method_offset, protocol_error_offset, protocol_error_occurrence_offset, protocol_error_module, protocol_error_path, saw_callback_error_as_protocol_family, protocol_subset_seen, protocol_subset_variant_seen|:
            protocol_method_offset <- annotation.offset if annotation.owner == "Sink" and annotation.name == "push" and annotation.line == 3900000060
            if annotation.owner == "push" and annotation.name == "Fault" and annotation.line == 3900000064:
                protocol_error_offset <- annotation.offset
                protocol_error_occurrence_offset <- annotation.occurrence_offset
                protocol_error_module <- annotation.module
            protocol_error_path <- annotation.name if annotation.owner == "__protocol_error_family_path" and annotation.line == 3900000067
            saw_callback_error_as_protocol_family <- true if annotation.owner == "push" and annotation.name == "CallbackErr" and annotation.line == 3900000064
            protocol_subset_seen <- true if annotation.owner == "__protocol_error_variant_family" and annotation.name == "Fault" and annotation.line == 3900000146 and annotation.module == "First" and annotation.offset == protocol_method_offset and annotation.occurrence_offset == protocol_error_occurrence_offset
            protocol_subset_variant_seen <- true if annotation.owner == "Fault" and annotation.name == "Full" and annotation.line == 3900000147 and annotation.module == "First" and annotation.offset == protocol_method_offset and annotation.occurrence_offset == protocol_error_occurrence_offset
        assert protocol_method_offset > 0
        assert protocol_error_offset == protocol_method_offset
        assert protocol_error_occurrence_offset > 0
        assert protocol_error_module == "First"
        assert protocol_error_path == "First::Fault"
        assert not saw_callback_error_as_protocol_family
        assert protocol_subset_seen and protocol_subset_variant_seen



@test
def test_protocol_function_return_error_selects_method_clause() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& @source = "error CallbackErr:\n    CallbackBad\n\nerror ReturnedFunctionErr:\n    InnerBad\n\nerror MethodErr:\n    MethodBad\n\nprotocol Factory:\n    def make(callback: fn() -> i64 error[CallbackErr]) -> fn() -> i64 error[ReturnedFunctionErr] error[MethodErr]\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        method_offset: mutable u32 = 0
        method_error_occurrence: mutable u32 = 0
        method_error_found: mutable bool = false
        protocol_return_type_name: mutable sview = ""
        protocol_return_type_count: mutable usize = 0.usize()
        callback_error_found: mutable bool = false
        returned_function_error_found: mutable bool = false
        for annotation in file.enum_annotations |method_offset, method_error_occurrence, method_error_found, protocol_return_type_name, protocol_return_type_count, callback_error_found, returned_function_error_found|:
            method_offset <- annotation.offset if annotation.owner == "Factory" and annotation.name == "make" and annotation.line == 3900000060
            if annotation.owner == "make" and annotation.line == 3900000065:
                protocol_return_type_name <- annotation.name
                protocol_return_type_count <- protocol_return_type_count + 1.usize()
            if annotation.owner == "make" and annotation.line == 3900000064:
                method_error_found <- true if annotation.name == "MethodErr"
                callback_error_found <- true if annotation.name == "CallbackErr"
                returned_function_error_found <- true if annotation.name == "ReturnedFunctionErr"
                method_error_occurrence <- annotation.occurrence_offset if annotation.name == "MethodErr"
        assert method_offset != 0
        assert method_error_found and method_error_occurrence != 0
        assert protocol_return_type_name == "fn" and protocol_return_type_count == 1.usize()
        assert not callback_error_found and not returned_function_error_found
        method_path_found: mutable bool = false
        for annotation in file.enum_annotations |method_path_found|:
