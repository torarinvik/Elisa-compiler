include "../../src/semantic/semantic.elisa"

extend Semantic:
    private:
        const RETURN_ID_TEST_FIRST: u32 = 17
        const RETURN_ID_TEST_UPDATED: u32 = 23
        const RETURN_ID_TEST_CHAIN_END: u32 = 4294967295

        def return_id_test_oracle(table: SymbolTable&, name: sview) -> u32 can[Abort.Panic]:
            result: mutable u32 = 0
            seen: mutable bool = false
            for symbol in table.symbols |result, seen, name|:
                if symbol.kind == SymbolKind.Func and symbol.name == name:
                    0 return if seen
                    result <- symbol.return_type_id
                    seen <- true
            return result

        def return_id_test_queries(table: SymbolTable&) -> void can[Abort.Panic, Memory.Allocate]:
            queries: darray[sview] = ["", "unique", "overload", "unknown", "nonfunction", "absent", "collision"]
            for name in queries |table|:
                assert function_return_type_id(table, name) == return_id_test_oracle(table, name)

    public:
        def check_return_type_id_index() -> void can[Abort.Panic, Memory.Allocate]:
            table: mutable SymbolTable = SymbolTable()
            return_id_test_queries(table)
            table <- add_symbol(table, "unique", SymbolKind.Func, 0, 0, 0, "", RETURN_ID_TEST_FIRST)
            table <- add_symbol(table, "unique", SymbolKind.Const, 0, 0, 0, "", RETURN_ID_TEST_UPDATED)
            table <- add_symbol(table, "overload", SymbolKind.Func, 0, 0, 0, "", RETURN_ID_TEST_FIRST)
            table <- add_symbol(table, "unknown", SymbolKind.Func, 0)
            table <- add_symbol(table, "nonfunction", SymbolKind.Struct, 0)
            table <- add_symbol(table, "", SymbolKind.Func, 0, 0, 0, "", RETURN_ID_TEST_UPDATED)
            return_id_test_queries(table)
            table <- add_symbol(table, "overload", SymbolKind.Func, 0, 0, 0, "", RETURN_ID_TEST_FIRST)
            return_id_test_queries(table)
            # Read current metadata, never a cached return type.
            table.symbols[0].return_type_id <- RETURN_ID_TEST_UPDATED
            return_id_test_queries(table)
            # Force all symbols into each queried bucket to exercise true name
            # filtering without relying on a naturally occurring 64-bit collision.
            for row in 0..<table.symbols.count |table|:
                table.symbol_name_next[row] <- (row + 1).u32() if row + 1 < table.symbols.count else RETURN_ID_TEST_CHAIN_END
                table.symbol_name_head <- table.symbol_name_head.put(name_hash(table.symbols[row].name), 0)
            table.symbol_name_head <- table.symbol_name_head.put(name_hash("collision"), 0)
            return_id_test_queries(table)
            # Synthetic callers can still supply symbols without an index.
            table.symbol_name_next <- []
            return_id_test_queries(table)

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    Semantic::check_return_type_id_index()
    return 0
