include "../../src/semantic/semantic.elisa"

extend Semantic:
    public:
        def effect_row_filter_test() -> i64 can[Memory.Allocate, Abort.Panic]:
            SOURCE_LINE: u32 = 7
            rows: darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "__effect_decl", name: "E", line: SOURCE_LINE}, Ast::EnumAnnotation{owner: "__permission_decl", name: "P", line: SOURCE_LINE}, Ast::EnumAnnotation{owner: "__permission_param_decl", name: "Q", line: SOURCE_LINE}, Ast::EnumAnnotation{owner: "__permission_alias", name: "A", line: SOURCE_LINE}, Ast::EnumAnnotation{owner: "__effect_ref_pos", name: "P.missing", line: SOURCE_LINE}, Ast::EnumAnnotation{owner: "E", name: "run", line: AE_EXPRESSION_OPERATION_ROW}, Ast::EnumAnnotation{owner: "P", name: "Read", line: AE_PERMISSION_MEMBER_ROW}]
            retained: mutable darray[Ast::EnumAnnotation] = []
            for row in rows |retained|:
                assert ae_row_annotation(row)
                retained.push(row)
            assert not ae_row_annotation(Ast::EnumAnnotation{owner: "__unrelated", name: "E", line: SOURCE_LINE})
            assert ae_effect_declared(retained, "E")
            assert ae_permission_family_known(retained, "P")
            assert ae_permission_family_known(retained, "Q")
            assert ae_permission_family_known(retained, "A")
            assert ae_operation_declared(retained, "E", "run")
            assert not ae_operation_declared(retained, "E", "missing")
            assert ae_permission_member_known(retained, "P", "Read")
            assert not ae_permission_member_known(retained, "P", "missing")
            return 0

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return Semantic::effect_row_filter_test()
