include "../../src/semantic/semantic.elisa"

extend Semantic:
    public:
        def callable_family_fallback_test() -> i64 can[Abort.Panic, Memory.Allocate]:
            SOURCE_LINE: u32 = 1
            FIRST_OFFSET: u32 = 10
            SECOND_OFFSET: u32 = 20
            rows: darray[Ast::EnumAnnotation] = [
                Ast::EnumAnnotation{owner: "step", name: "__error_return", line: SOURCE_LINE, offset: FIRST_OFFSET},
                Ast::EnumAnnotation{owner: "step", name: "__export_array", line: SOURCE_LINE, offset: FIRST_OFFSET},
                Ast::EnumAnnotation{owner: "step", name: "FirstError", line: SOURCE_LINE, offset: FIRST_OFFSET},
                Ast::EnumAnnotation{owner: "step", name: "SecondError", line: SOURCE_LINE, offset: SECOND_OFFSET},
                Ast::EnumAnnotation{owner: "__fn_module", name: "First", line: SOURCE_LINE, offset: FIRST_OFFSET},
                Ast::EnumAnnotation{owner: "__fn_module", name: "Outer::Second", line: SOURCE_LINE, offset: SECOND_OFFSET}
            ]
            assert callable_error_family(rows, "step", "First", "") == "FirstError"
            assert callable_error_family(rows, "step", "Outer::Second", "") == "SecondError"
            assert callable_error_family(rows, "step", "First", "Second") == "SecondError"
            assert callable_error_family(rows, "step", "Missing", "") == "FirstError"
            assert callable_error_family(rows, "missing", "First", "") == ""
            empty_first: darray[Ast::EnumAnnotation] = [
                Ast::EnumAnnotation{owner: "step", name: "", line: SOURCE_LINE, offset: FIRST_OFFSET},
                Ast::EnumAnnotation{owner: "step", name: "LaterError", line: SOURCE_LINE, offset: SECOND_OFFSET},
                Ast::EnumAnnotation{owner: "__fn_module", name: "First", line: SOURCE_LINE, offset: FIRST_OFFSET},
                Ast::EnumAnnotation{owner: "__fn_module", name: "Second", line: SOURCE_LINE, offset: SECOND_OFFSET}
            ]
            assert callable_error_family(empty_first, "step", "Missing", "") == ""
            assert callable_error_family(empty_first, "step", "Second", "") == "LaterError"
            no_rows: darray[Ast::EnumAnnotation] = []
            assert callable_error_family(no_rows, "step", "", "") == ""
            return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Semantic::callable_family_fallback_test()
