# A wrapper needing an implicit AST store must allocate its arena even when
# its source body contains no explicit allocation.
include "../../src/backend/codegen.elisa"

extend Backend:
    public:
        def packed_store_implicit_arena_test() -> i64 can[Abort.Panic, Memory.Allocate]:
            table: StructTable = new_struct_table(null, null)
            assert table.names.count == 0
            return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Backend::packed_store_implicit_arena_test()
