include "../../src/parser/parser.elisa"

using Ast

def guard_list_wraps_expected_control(source: u8& @source, expected_control: usize) -> bool:
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Lexer::Token] = frontend_tokenize(source, source)
        file: Ast::File = frontend_parser_parse_file(source, tokens) can Global{Read,Write}
        return false if file.errors.count != 0 or file.top_decls.count != 1
        match file.top_decls[0]:
            Ast::Decl.Func(_, _, _, body, _, _, _):
                return false if body.count != 2
                control_body: mutable darray[Ast::Stmt] = body
                if expected_control != 0:
                    match body[0]:
                        Ast::Stmt.For(_, _, _, loop_body, _):
                            control_body <- loop_body
                        _:
                            return false
                else:
                    control_body <- [body[0]]
                return false if control_body.count != 1
                match control_body[0]:
                    Ast::Stmt.If(condition, then_body, alternative, _):
                        return false if then_body.count != 1 or alternative.count != 0
                        match condition:
                            Ast::Expr.Binary(Ast::Expr.Ident(left, _), Lexer::TokenKind.Or, Ast::Expr.Ident(right, _), _):
                                return false if left != "a" or right != "b"
                            _:
                                return false
                        match then_body[0]:
                            Ast::Stmt.Return(value, _):
                                return false if expected_control != 0
                                if value is returned_value:
                                    match returned_value:
                                        Ast::Expr.IntLit(number, _):
                                            return number == 7
                                        _:
                                            return false
                                return false
                            Ast::Stmt.Continue(_, _):
                                return expected_control == 1
                            Ast::Stmt.Break(_, _):
                                return expected_control == 2
                            _:
                                return false
                    _:
                        return false
            _:
                return false

@test
def test_guard_list_control_forms() -> void:
    can Memory.Allocate, Abort.Panic, Global{Read,Write}:
        assert guard_list_wraps_expected_control("def probe(a: bool, b: bool) -> i64:\n    return 7 if:\n        a\n        b\n    return 9\n", 0)
        assert guard_list_wraps_expected_control("def probe(a: bool, b: bool) -> i64:\n    return 7 if:\n        a\n        b\n    return 9\n", 1) == false
        assert guard_list_wraps_expected_control("def probe(a: bool, b: bool) -> i64:\n    for i in 0..<1:\n        continue if:\n            a\n            b\n    return 9\n", 1)
        assert guard_list_wraps_expected_control("def probe(a: bool, b: bool) -> i64:\n    for i in 0..<1:\n        break if:\n            a\n            b\n    return 9\n", 2)

@test
def test_guard_list_rejects_statements() -> void:
    can Memory.Allocate, Abort.Panic, Global{Read,Write}:
        source: u8& @source = "def probe() -> i64:\n    return 7 if:\n        value = true\n    return 9\n"
        tokens: darray[Lexer::Token] = frontend_tokenize(source, source)
        file: Ast::File = frontend_parser_parse_file(source, tokens) can Global{Read,Write}
        assert file.errors.count > 0

@test
def test_guard_list_empty_block_is_error() -> void:
    can Memory.Allocate, Abort.Panic, Global{Read,Write}:
        source: u8& @source = "def probe() -> i64:\n    return 7 if:\n    return 9\n"
        tokens: darray[Lexer::Token] = frontend_tokenize(source, source)
        file: Ast::File = frontend_parser_parse_file(source, tokens) can Global{Read,Write}
        assert file.errors.count > 0
