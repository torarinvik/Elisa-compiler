include "../../src/parser/parser.elisa"

using Ast

def guard_list_is_ordered_or(source: u8&) -> bool:
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Lexer::Token] = frontend_tokenize(source, source)
        file: Ast::File = frontend_parser_parse_file(source, tokens) can Global{Read,Write}
        return false if file.errors.count != 0 or file.top_decls.count != 1
        match file.top_decls[0]:
            Ast::Decl.Func(_, _, _, body, _, _, _):
                return false if body.count != 2
                match body[0]:
                    Ast::Stmt.If(condition, then_body, alternative, _):
                        return false if then_body.count != 1 or alternative.count != 0
                        match condition:
                            Ast::Expr.Binary(Ast::Expr.Ident(left, _), Lexer::TokenKind.Or, Ast::Expr.Ident(right, _), _):
                                return left == "a" and right == "b"
                            _:
                                return false
                    _:
                        return false
            _:
                return false

@test
def test_guard_list_control_forms() -> void:
    can Memory.Allocate, Abort.Panic:
        assert guard_list_is_ordered_or("def probe(a: bool, b: bool) -> i64:\n    return 7 if:\n        a\n        b\n    return 9\n") can Global{Read,Write}
        assert guard_list_is_ordered_or("def probe(a: bool, b: bool) -> i64:\n    return 0 if:\n        a\n        b\n    return 9\n") can Global{Read,Write}
        assert guard_list_is_ordered_or("def probe(a: bool, b: bool) -> i64:\n    continue if:\n        a\n        b\n    return 9\n") can Global{Read,Write}
        assert guard_list_is_ordered_or("def probe(a: bool, b: bool) -> i64:\n    break if:\n        a\n        b\n    return 9\n") can Global{Read,Write}

@test
def test_guard_list_rejects_statements() -> void:
    can Memory.Allocate, Abort.Panic:
        source: u8& = "def probe() -> i64:\n    return 7 if:\n        value = true\n    return 9\n"
        tokens: darray[Lexer::Token] = frontend_tokenize(source, source)
        file: Ast::File = frontend_parser_parse_file(source, tokens) can Global{Read,Write}
        assert file.errors.count > 0

@test
def test_guard_list_empty_block_is_error() -> void:
    can Memory.Allocate, Abort.Panic:
        source: u8& = "def probe() -> i64:\n    return 7 if:\n    return 9\n"
        tokens: darray[Lexer::Token] = frontend_tokenize(source, source)
        file: Ast::File = frontend_parser_parse_file(source, tokens) can Global{Read,Write}
        assert file.errors.count > 0
