# Exercise the invalidation pass directly, before unrelated backend law lowering.
include "../../src/semantic/semantic.elisa"

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    EXPECTED_INVALIDATIONS: usize = 2
    DECLARED_CHANGE_USE_LINE: u32 = 13
    UNCONSTRAINED_USE_LINE: u32 = 17
    source: u8& = "law Positive(self: i64) = self > 0\ndef consume(value: i64 is Positive):\n    pass\ndef changed(value: mutable i64&) changes value:\n    pass\ndef plain(value: mutable i64&):\n    pass\ndef preserved(value: mutable i64&) ensures true:\n    pass\ndef check_changed(value: mutable i64):\n    if value is Positive:\n        changed(&value)\n        consume(value)\ndef check_plain(value: mutable i64):\n    if value is Positive:\n        plain(&value)\n        consume(value)\ndef check_preserved(value: mutable i64):\n    if value is Positive:\n        preserved(&value)\n        consume(value)\n"
    length: mutable usize = 0
    while source[length] != 0 |length|:
        length <- length + 1
    tokens: darray[Token] = frontend_tokenize_with_length(source, source, length)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    assert file.errors.count == 0
    table: mutable Semantic::SymbolTable = Semantic::SymbolTable()
    table <- Semantic::check_refinement_fact_invalidated(file, table)
    assert table.diagnostics.count == EXPECTED_INVALIDATIONS
    assert table.diagnostics[0].line == DECLARED_CHANGE_USE_LINE
    assert table.diagnostics[1].line == UNCONSTRAINED_USE_LINE
    for diagnostic in table.diagnostics:
        assert diagnostic.kind == Semantic::DiagnosticKind.RefinementArgNotProven
        assert diagnostic.name == "consume"
    return 0
