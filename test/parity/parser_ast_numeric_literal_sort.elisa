def numeric_literal_sort_rows_match(source: u8&, sorts: darray[sview], lines: darray[u32], columns: darray[u32], spellings: darray[sview]) -> bool can[Memory.Allocate, Abort.Panic]:
    file: Ast::File = parse_snippet(source)
    return false if file.errors.count != 0 or sorts.count != lines.count or sorts.count != columns.count or sorts.count != spellings.count
    found: mutable usize = 0
    for index in 0..<file.enum_annotations.count |index, file, sorts, lines, columns, spellings, found|:
        row: Ast::EnumAnnotation = file.enum_annotations[index]
        continue if row.owner != "__numeric_literal_sort"
        return false if found >= sorts.count or index + 2 >= file.enum_annotations.count
        column: Ast::EnumAnnotation = file.enum_annotations[index + 1]
        text: Ast::EnumAnnotation = file.enum_annotations[index + 2]
        return false if row.name != sorts[found] or row.line != lines[found]
        return false if column.owner != "__numeric_literal_sort_column" or column.name != sorts[found] or column.line != columns[found]
        return false if text.owner != "__numeric_literal_sort_text" or text.name != spellings[found] or text.line != lines[found]
        found <- found + 1
    return found == sorts.count

@test
def test_numeric_literal_sort_full_width() -> void can[Memory.Allocate, Abort.Panic]:
    sorts: darray[sview] = ["u64", "u64", "u64"]
    lines: darray[u32] = [2, 2, 3]
    columns: darray[u32] = [12, 19, 12]
    spellings: darray[sview] = ["0", "18446744073709551615", "0"]
    assert numeric_literal_sort_rows_match("def probe() -> u64:\n    ensure 0u64 < 18446744073709551615u64\n    return 0u64\n", sorts, lines, columns, spellings)

@test
def test_numeric_literal_sort_mixed_line_and_unary_sign() -> void can[Memory.Allocate, Abort.Panic]:
    sorts: darray[sview] = ["i64", "i64", "u64", "u64"]
    lines: darray[u32] = [2, 3, 3, 3]
    columns: darray[u32] = [19, 21, 29, 36]
    spellings: darray[sview] = ["1", "0", "0", "1"]
    assert numeric_literal_sort_rows_match("def probe() -> i64:\n    value: i64 = -1i64\n    ensure result < 0i64 or 0u64 < 1u64\n    return value\n", sorts, lines, columns, spellings)

@test
def test_numeric_literal_sort_unsuffixed_is_not_invented() -> void can[Memory.Allocate, Abort.Panic]:
    sorts: darray[sview] = []
    positions: darray[u32] = []
    assert numeric_literal_sort_rows_match("def probe() -> i64:\n    ensure 0 < 1\n    return 0\n", sorts, positions, positions, sorts)

def numeric_return_payload_matches(source: u8&, expected: i64) -> bool can[Memory.Allocate, Abort.Panic]:
    file: Ast::File = parse_snippet(source)
    return false if file.errors.count != 0 or file.top_decls.count != 1
    body: darray[Ast::Stmt] = first_func_body(file)
    return false if body.count != 1
    match body[0]:
        Stmt.Return(value, _):
            if value is present:
                match present:
                    Expr.IntLit(payload, _):
                        return payload == expected
                    _:
                        return false
            return false
        _:
            return false

@test
def test_numeric_literal_separator_payload_and_provenance() -> void can[Memory.Allocate, Abort.Panic]:
    source: static u8& = "def probe() -> u64:\n    return 0xffff_ffff_ffff_ffffu64\n"
    assert numeric_return_payload_matches(source, -1)
    sorts: darray[sview] = ["u64"]
    lines: darray[u32] = [2]
    columns: darray[u32] = [12]
    spellings: darray[sview] = ["0xffff_ffff_ffff_ffff"]
    assert numeric_literal_sort_rows_match(source, sorts, lines, columns, spellings)
    assert numeric_return_payload_matches("def probe() -> u64:\n    return 18_446_744_073_709_551_615u64\n", -1)
    assert numeric_return_payload_matches("def probe() -> u64:\n    return 18446744073709551614u64\n", -2)

@test
def test_numeric_literal_overflow_saturates_and_preserves_spelling() -> void can[Memory.Allocate, Abort.Panic]:
    source: static u8& = "def probe() -> u64:\n    return 18446744073709551616u64\n"
    assert numeric_return_payload_matches(source, -1)
    sorts: darray[sview] = ["u64"]
    lines: darray[u32] = [2]
    columns: darray[u32] = [12]
    spellings: darray[sview] = ["18446744073709551616"]
    assert numeric_literal_sort_rows_match(source, sorts, lines, columns, spellings)
    assert numeric_return_payload_matches("def probe() -> u64:\n    return 0x10000000000000000u64\n", -1)
    assert numeric_return_payload_matches("def probe() -> u64:\n    return 999999999999999999999999999999999999999u64\n", -1)
