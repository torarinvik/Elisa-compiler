# Parser AST tests — LAMBDAS, regions and contracts: every lambda spelling (fat arrow, colon
# body, the unicode family, and the call that only looks like one), error-block bindings, a
# region declared without a block, manual region backing, `preserves` contracts, and the
# structured literal patterns. Included by parser_ast_test.elisa.

using Ast


# The value of the first top-level func's first statement, when it's a VarDecl.
def first_vardecl_value(file: Ast::File&) -> Ast::Expr:
    can Memory.Allocate, Abort.Panic:
        for declaration in file.top_decls:
            match declaration:
                Decl.Func(name, params, return_type, body, effects, decorators, line):
                    match body[0]:
                        Stmt.VarDecl(vn, te, val, vl):
                            return val
                        _:
                            pass
                _:
                    pass
        return (Ast::Expr.Invalid)




@test
def test_lambda_fn_fat_arrow() -> void:
    can Memory.Allocate, Abort.Panic:
        # `fn(params) => EXPR` — the canonical anonymous function. Params are captured;
        # the `=> EXPR` body is a single synthesized return.
        src: u8& = "def h() -> void:\n    g: T = fn(a: i64, b: i64) => a + b\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match first_vardecl_value(file):
            Expr.Lambda(params, body, line):
                assert params.count == 2
                assert params[0] == "a"
                assert params[1] == "b"
                assert body.count == 1
            _:
                assert false




@test
def test_lambda_fn_colon_body() -> void:
    can Memory.Allocate, Abort.Panic:
        # `fn(): EXPR` colon-body form (a predicate closure). Zero params.
        src: u8& = "def h() -> void:\n    g: T = fn() => not ready\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match first_vardecl_value(file):
            Expr.Lambda(params, body, line):
                assert params.count == 0
                assert body.count == 1
            _:
                assert false




@test
def test_lambda_unicode_and_shorthand() -> void:
    can Memory.Allocate, Abort.Panic:
        # Unicode lambda letter `λ` with shorthand (unparenthesized) params.
        src: u8& = "def h() -> void:\n    g: T = λ(value, weight) => weight\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match first_vardecl_value(file):
            Expr.Lambda(params, body, line):
                assert params.count == 2
                assert params[0] == "value"
                assert params[1] == "weight"
            _:
                assert false




@test
def test_lambda_unicode_family() -> void:
    can Memory.Allocate, Abort.Panic:
        # The BMP Unicode lambda letters head a lambda: Greek λ/Λ and Latin ƛ.
        greek: Ast::File = parse_snippet("def h() -> void:\n    g: T = λ(x) => x\n")
        assert greek.errors.count == 0
        cap: Ast::File = parse_snippet("def h() -> void:\n    g: T = Λ(x) => x\n")
        assert cap.errors.count == 0
        stroke: Ast::File = parse_snippet("def h() -> void:\n    g: T = ƛ(x) => x\n")
        assert stroke.errors.count == 0
        # Supplementary-plane Mathematical-Alphanumeric lambdas (4-byte UTF-8):
        # italic small 𝜆 (U+1D706) and bold capital 𝚲 (U+1D6B2) head lambdas too.
        math_small: Ast::File = parse_snippet("def h() -> void:\n    g: T = 𝜆(x) => x\n")
        assert math_small.errors.count == 0
        math_cap: Ast::File = parse_snippet("def h() -> void:\n    g: T = 𝚲(x) => x\n")
        assert math_cap.errors.count == 0
        match first_vardecl_value(math_small):
            Expr.Lambda(params, body, line):
                assert params.count == 1
                assert params[0] == "x"
            _:
                assert false
        match first_vardecl_value(stroke):
            Expr.Lambda(params, body, line):
                assert params.count == 1
                assert params[0] == "x"
            _:
                assert false




@test
def test_fn_call_not_a_lambda() -> void:
    can Memory.Allocate, Abort.Panic:
        # `fn` is an ordinary local name: a call `fn(x)` and a bare reference `fn`
        # must NOT be misparsed as a lambda (the signature isn't followed by `:`/`=>`).
        src: u8& = "def h(fn: T) -> i64:\n    return fn(1)\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.Return(value, rline):
                pass
            _:
                assert false




@test
def test_error_block_binding() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f() -> void:\n    error e:\n        pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.Block(kind, clause, binding, inner, line):
                assert kind == "error"
                assert binding == "e"
                assert clause.count == 0
            _:
                assert false




@test
def test_region_declaration_without_block_is_structured() -> void:
    can Memory.Allocate, Abort.Panic:
        # A no-colon region form is a manual region declaration whose binding flows
        # through subsequent statements (stage0 semantic surface), not a malformed
        # prefix block.
        #
        # The clause carries the CAPACITY. This assertion used to demand an empty clause,
        # and it was the assertion that was wrong: dropping the capacity is a bug the
        # parser was fixed for (see parser_stmt.elisa — without it `region r(1024)` opened
        # an arena with no backing store where stage0 emits `new_region_backend(1024, 0)`).
        # A test frozen against the older shape reported the fix as a failure.
        src: u8& = "def f() -> void:\n    region scratch(1024)\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.Block(kind, clause, binding, inner, line):
                assert kind == "region"
                assert binding == "scratch"
                assert clause.count == 1
                assert clause[0] == "1024"
                assert inner.count == 0
            _:
                assert false




@test
def test_manual_region_backing_is_preserved() -> void:
    can Memory.Allocate, Abort.Panic:
        # STRATEGY first, then capacity — both are preserved.
        src: u8& = "def f() -> void:\n    region scratch(1024) using fixed\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        match body[0]:
            Stmt.Block(kind, clause, binding, inner, line):
                assert kind == "region"
                assert binding == "scratch"
                assert clause.count == 2
                assert clause[0] == "fixed"
                assert clause[1] == "1024"
            _:
                assert false




@test
def test_preserves_contract_is_structured() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f(x: mutable Box&) -> void:\n    preserves x.value\n    pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 2
        match body[0]:
            Stmt.Contract(kind, expression, line):
                assert kind == "preserves"
                match expression:
                    Expr.Field(object, field, field_line):
                        assert field == "value"
                    _:
                        assert false
            _:
                assert false




@test
def test_pin_pattern_is_structured() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f(x: i64) -> void:\n    match x:\n        ^x:\n            pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        match body[0]:
            Stmt.Match(scrutinee, arms, line):
                assert arms.count == 1
                match arms[0].pattern:
                    Pattern.Pin(name):
                        assert name == "x"
                    _:
                        assert false
            _:
                assert false




@test
def test_null_pattern_is_structured_literal() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f(x: void?) -> void:\n    match x:\n        null:\n            pass\n        _:\n            pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match first_func_body(file)[0]:
            Stmt.Match(scrutinee, arms, line):
                match arms[0].pattern:
                    Pattern.Literal(text):
                        assert text == "null"
                    _:
                        assert false
            _:
                assert false




@test
def test_signed_literal_pattern_is_structured() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f(x: i64) -> void:\n    match x:\n        -1:\n            pass\n        _:\n            pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match first_func_body(file)[0]:
            Stmt.Match(scrutinee, arms, line):
                match arms[0].pattern:
                    Pattern.Literal(text):
                        assert text == "-1"
                    _:
                        assert false
            _:
                assert false




@test
def test_signed_range_bounds_are_preserved() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f(x: i64) -> void:\n    match x:\n        -5..<-1:\n            pass\n        _:\n            pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match first_func_body(file)[0]:
            Stmt.Match(scrutinee, arms, line):
                match arms[0].pattern:
                    Pattern.Range(lo, hi, inclusive):
                        assert lo == "-5"
                        assert hi == "-1"
                        assert not inclusive
                    _:
                        assert false
            _:
                assert false
