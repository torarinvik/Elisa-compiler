# Parser AST tests — STRUCTS, ranges and membership: layout clauses, guest overlays, ghost
# fields, affinity modifiers, strided range `for`, the membership operators and their
# precedence, expression-bodied functions, and qualified module names.
# Included by parser_ast_test.elisa.

using Ast


@test
def test_for_removed_ref_binder_rejected() -> void:
    can Memory.Allocate, Abort.Panic:
        # The removed `for ref x in xs:` mechanism spelling must NOT silently parse
        # as a mode (stage0 gives the directed error; stage1 reports a parse error).
        src: u8& = "def f(xs: darray[i64]) -> void:\n    for ref x in xs:\n        pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count > 0




@test
def test_struct_layout_clause() -> void:
    can Memory.Allocate, Abort.Panic:
        # Unified postfix layout clause: `struct X layout(soa):` (the prefix
        # `layout soa struct` and bare `layout soa` spellings were removed).
        src: u8& = "struct Store layout(soa):\n    xs: darray[i64]\n    ys: darray[i64]\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Struct(name, members, affinity, _, _, _, line):
                assert name == "Store"
                assert members.count == 2
            _:
                assert false




@test
def test_guest_overlay_struct() -> void:
    can Memory.Allocate, Abort.Panic:
        # Typed guest-memory overlay as a struct: `struct X layout(guest, size: N):`
        # with `field: type at OFFSET [requires size >= N]` members (docs/107).
        src: u8& = "struct ProcParamOverlay layout(guest, size: 72):\n    size: u64 at 0\n    mem_param: u64 at 64 requires size >= 72\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Struct(name, members, affinity, _, _, _, line):
                assert name == "ProcParamOverlay"
                assert members.count == 2
                assert members[0].name == "size"
                assert members[1].name == "mem_param"
            _:
                assert false




@test
def test_ghost_struct_field_is_structured() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "struct Model:\n    ghost proof: bool\n    value: i64\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match file.top_decls[0]:
            Decl.Struct(name, members, _, _, _, _, _):
                assert name == "Model"
                assert members.count == 2
                assert members[0].name == "proof"
                assert members[0].is_ghost
                assert not members[1].is_ghost
            _:
                assert false




@test
def test_range_for_with_stride() -> void:
    can Memory.Allocate, Abort.Panic:
        # The range stride is spelled on the range: `for i in 0..<n..2:` (the
        # `step N` spelling is rejected by stage0 — it was silent truncation).
        src: u8& = "def f(n: usize) -> void:\n    for i in 0..<n..2:\n        pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.For(bind, variables, iterable, inner, line):
                assert variables.count == 1
                assert variables[0] == "i"
            _:
                assert false




@test
def test_membership_expression_precedence() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def keep(value: i64, other: bool) -> bool:\n    return value in [1, 2, 3] and other\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        match body[0]:
            Stmt.Return(value, line):
                match value:
                    Expr.Binary(left, operator, right, binary_line):
                        assert operator == TokenKind.And
                        match left:
                            Expr.Binary(member_left, member_operator, member_right, member_line):
                                assert member_operator == TokenKind.In
                                match member_right:
                                    Expr.Array(elements, array_line):
                                        assert elements.count == 3
                                    _:
                                        assert false
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false




@test
def test_not_in_membership_expression() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def keep(value: i64, other: bool) -> bool:\n    return value not in {1, 2, 3} and other\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        match body[0]:
            Stmt.Return(value, line):
                match value:
                    Expr.Binary(left, operator, right, binary_line):
                        assert operator == TokenKind.And
                        match left:
                            Expr.Unary(unary_operator, operand, unary_line):
                                assert unary_operator == TokenKind.Not
                                match operand:
                                    Expr.Binary(member_left, member_operator, member_right, member_line):
                                        assert member_operator == TokenKind.In
                                        match member_right:
                                            Expr.SetLit(elements, set_line):
                                                assert elements.count == 3
                                            _:
                                                assert false
                                    _:
                                        assert false
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false




@test
def test_membership_range_expression() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def keep(ch: char) -> bool:\n    return ch in 'a'..='z'\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        match body[0]:
            Stmt.Return(value, line):
                match value:
                    Expr.Binary(left, operator, right, binary_line):
                        assert operator == TokenKind.In
                        match right:
                            Expr.Binary(range_left, range_operator, range_right, range_line):
                                assert range_operator == TokenKind.RangeLe
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false




@test
def test_struct_linear_affinity() -> void:
    can Memory.Allocate, Abort.Panic:
        # `linear struct X:` — must-consume-exactly-once discipline.
        src: u8& = "linear struct FsGuard:\n    fd: i32\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Struct(name, members, affinity, _, _, _, line):
                assert name == "FsGuard"
                assert affinity == "linear"
                assert members.count == 1
            _:
                assert false




@test
def test_struct_affine_affinity() -> void:
    can Memory.Allocate, Abort.Panic:
        # `affine struct X:` — use-at-most-once, may be silently dropped.
        src: u8& = "affine struct Pooled:\n    handle: usize\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Struct(name, members, affinity, _, _, _, line):
                assert name == "Pooled"
                assert affinity == "affine"
            _:
                assert false




@test
def test_struct_no_affinity_modifier() -> void:
    can Memory.Allocate, Abort.Panic:
        # A plain struct has no single-use discipline.
        src: u8& = "struct Point:\n    x: i64\n    y: i64\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match file.top_decls[0]:
            Decl.Struct(name, members, affinity, _, _, _, line):
                assert affinity == ""
            _:
                assert false




@test
def test_struct_linear_with_layout_clause() -> void:
    can Memory.Allocate, Abort.Panic:
        # The affinity modifier and a postfix layout(...) clause compose.
        src: u8& = "linear struct Handle layout(c):\n    fd: i32\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match file.top_decls[0]:
            Decl.Struct(name, members, affinity, _, _, _, line):
                assert name == "Handle"
                assert affinity == "linear"
                assert members.count == 1
            _:
                assert false




@test
def test_expression_bodied_function() -> void:
    can Memory.Allocate, Abort.Panic:
        # `def f(...) -> T = EXPR` == a body of a single `return EXPR`. An unused
        # parameter is named `_` (no discard statement needed).
        src: u8& = "def area(w: i64, h: i64) -> i64 = w * h\ndef stub(_: void&?) -> int = 0\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 2
        # The first func's body is a single synthesized `return EXPR`.
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.Return(value, rline):
                pass
            _:
                assert false




@test
def test_removed_shorthand_lambda_rejected() -> void:
    can Memory.Allocate, Abort.Panic:
        # The removed shorthand lambda-param spelling (`fn x: x`, pre-bd208ae) must NOT
        # silently split into two statements (`g: T = fn` + orphaned `x: x`) at 0 errors
        # — params are always parenthesized now (`fn(x) => x`).
        src: u8& = "def h() -> void:\n    g: T = fn x: x\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 1




@test
def test_qualified_module_name_scope() -> void:
    can Memory.Allocate, Abort.Panic:
        # `module A::B::C:` — a `::`-separated namespace chain, recorded verbatim
        # as the module's name.
        src: u8& = "module Common::Log::Class:\n    def f() -> i64 = 1\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Module(name, body, line):
                assert name == "Common::Log::Class"
                assert body.count == 1
            _:
                assert false




@test
def test_qualified_module_name_dot() -> void:
    can Memory.Allocate, Abort.Panic:
        # A `.`-separated chain works the same way.
        src: u8& = "module A.B.C:\n    def f() -> i64 = 1\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match file.top_decls[0]:
            Decl.Module(name, body, line):
                assert name == "A.B.C"
            _:
                assert false




@test
def test_unqualified_module_name_unaffected() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "module Simple:\n    def f() -> i64 = 1\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match file.top_decls[0]:
            Decl.Module(name, body, line):
                assert name == "Simple"
            _:
                assert false




@test
def test_qualified_extend_name() -> void:
    can Memory.Allocate, Abort.Panic:
        # `extend` shares module_declaration's grammar, so the qualified name applies there too.
        src: u8& = "extend Common::Log::Class:\n    def g() -> i64 = 2\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match file.top_decls[0]:
            Decl.Module(name, body, line):
                assert name == "Common::Log::Class"
            _:
                assert false
