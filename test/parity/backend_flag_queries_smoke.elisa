# Exercise value semantics and repeated changes in a single process: these
# queries must remain live environment reads, not cached startup decisions.
include "../../src/backend/codegen.elisa"

extern setenv(name: cstr, value: cstr, overwrite: i32) -> i32
extern unsetenv(name: cstr) -> i32

extend Backend:
    private:
        const FLAG_OVERWRITE: i32 = 1
        const FLAG_SUCCESS: i32 = 0
        const FLAG_TRACE: cstr = "ELISA_STAGE1_TRACE_FUNCTIONS_ONLY"
        const FLAG_ALIAS: cstr = "ELISACORE_NOALIAS_MUTABLE_REFS"
        const FLAG_BOUNDS: cstr = "ELISACORE_FORCE_BOUNDS_CHECK"
        const FLAG_OPT: cstr = "ELISA_STAGE1_OPT"

        def check_flags_present(value: cstr, trace: bool, private_linkage: bool) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            assert setenv(FLAG_TRACE, value, FLAG_OVERWRITE) == FLAG_SUCCESS
            assert setenv(FLAG_ALIAS, value, FLAG_OVERWRITE) == FLAG_SUCCESS
            assert setenv(FLAG_BOUNDS, value, FLAG_OVERWRITE) == FLAG_SUCCESS
            assert setenv(FLAG_OPT, value, FLAG_OVERWRITE) == FLAG_SUCCESS
            assert trace_functions_only_enabled() == trace
            assert noalias_mutable_refs_enabled()
            assert force_bounds_check_enabled()
            assert prefer_private_linkage_enabled() == private_linkage

        def check_flags_absent() -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            assert unsetenv(FLAG_TRACE) == FLAG_SUCCESS
            assert unsetenv(FLAG_ALIAS) == FLAG_SUCCESS
            assert unsetenv(FLAG_BOUNDS) == FLAG_SUCCESS
            assert unsetenv(FLAG_OPT) == FLAG_SUCCESS
            assert not trace_functions_only_enabled()
            assert not noalias_mutable_refs_enabled()
            assert not force_bounds_check_enabled()
            assert not prefer_private_linkage_enabled()

    public:
        def check_backend_flag_queries() -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            check_flags_absent()
            check_flags_present("", false, false)
            check_flags_present("0", false, false)
            check_flags_present("1", true, true)
            check_flags_present("2", false, true)
            check_flags_present("3", false, true)
            check_flags_present("bogus", false, false)
            check_flags_absent()

def main() -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    Backend::check_backend_flag_queries()
    return 0
