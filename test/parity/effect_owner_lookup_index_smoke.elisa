include "../../src/semantic/semantic.elisa"

extend Semantic:
    public:
        # Exercise the actual effect-owner/source readers and builders. Keep this fixture tiny
        # so Stage0 can run it without a Python reimplementation of the hash-chain logic.
        def effect_owner_lookup_index_test() -> i64:
            can Abort.Panic, Memory.Allocate, Global{Read,Write}:
                table: mutable SymbolTable = SymbolTable()

                # Interleave owners so each index must retain a separate, ordered chain.
                table.function_effect_owner <- table.function_effect_owner.push("both")
                table.function_effect_name <- table.function_effect_name.push("Memory.Allocate")
                table.function_effect_owner <- table.function_effect_owner.push("other")
                table.function_effect_name <- table.function_effect_name.push("Abort.Panic")
                table.function_effect_owner <- table.function_effect_owner.push("both")
                table.function_effect_name <- table.function_effect_name.push("Console.Write")
                table.function_effect_owner <- table.function_effect_owner.push("both")
                table.function_effect_name <- table.function_effect_name.push("Console")
                table.function_effect_owner <- table.function_effect_owner.push("other")
                table.function_effect_name <- table.function_effect_name.push("Console.Read")
                table.function_effect_owner <- table.function_effect_owner.push("both")
                table.function_effect_name <- table.function_effect_name.push("Memory.Allocate")

                table.function_effect_source_owner <- table.function_effect_source_owner.push("both")
                table.function_effect_source_ref <- table.function_effect_source_ref.push("Global.Write")
                table.function_effect_source_owner <- table.function_effect_source_owner.push("inferred")
                table.function_effect_source_ref <- table.function_effect_source_ref.push("Abort.Panic")
                table.function_effect_source_owner <- table.function_effect_source_owner.push("both")
                table.function_effect_source_ref <- table.function_effect_source_ref.push("Global.Read")
                table.function_effect_source_owner <- table.function_effect_source_owner.push("both")
                table.function_effect_source_ref <- table.function_effect_source_ref.push("Abort.Panic")
                table.function_effect_source_owner <- table.function_effect_source_owner.push("both")
                table.function_effect_source_ref <- table.function_effect_source_ref.push("Global.Read")
                table.function_effect_source_owner <- table.function_effect_source_owner.push("inferred")
                table.function_effect_source_ref <- table.function_effect_source_ref.push("Global.Write")

                # Incomplete indices take the original linear-scan path.
                assert table.effect_owner_indexed != table.function_effect_owner.count
                assert table.effect_source_indexed != table.function_effect_source_owner.count
                assert function_declares_effect(table, "both")
                assert not function_declares_effect(table, "inferred")
                assert function_body_panics(table, "both")
                assert not function_body_panics(table, "missing")
                assert function_first_effect_ref(table, "both") == "Memory.Allocate"
                assert function_first_effect_ref(table, "inferred") == "Abort.Panic"
                assert function_first_declared_effect_ref(table, "inferred") == ""

                fallback_refs: darray[sview] = function_effect_refs(table, "both")
                assert fallback_refs.count == 4
                assert fallback_refs[0] == "Console"
                assert fallback_refs[1] == "Global.Read"
                assert fallback_refs[2] == "Global.Write"
                assert fallback_refs[3] == "Memory.Allocate"
                inferred_refs: darray[sview] = function_effect_refs(table, "inferred")
                assert inferred_refs.count == 2
                assert inferred_refs[0] == "Abort.Panic"
                assert inferred_refs[1] == "Global.Write"

                annotations: mutable darray[Ast::EnumAnnotation] = []
                no_grants: mutable darray[sview] = []
                assert cov_call_uncovered_ref(table, annotations, "both", no_grants) == "Memory.Allocate"
                memory_grant: mutable darray[sview] = ["Memory.Allocate"]
                assert cov_call_uncovered_ref(table, annotations, "both", memory_grant) == "Console.Write"
                family_grants: mutable darray[sview] = ["Memory.Allocate", "Console"]
                assert cov_call_uncovered_ref(table, annotations, "both", family_grants) == ""
                assert cov_call_uncovered_ref(table, annotations, "inferred", no_grants) == ""

                # Index one registry at a time to exercise each reader's independent
                # completeness check: declared rows are indexed while source rows still scan.
                table <- index_effect_owner_rows(table)
                assert table.effect_owner_indexed == table.function_effect_owner.count
                assert table.effect_source_indexed != table.function_effect_source_owner.count
                assert function_declares_effect(table, "both")
                assert function_first_effect_ref(table, "both") == "Memory.Allocate"
                assert function_body_panics(table, "both")

                table <- index_effect_source_rows(table)
                assert table.effect_source_indexed == table.function_effect_source_owner.count
                assert function_body_panics(table, "both")
                assert function_first_effect_ref(table, "inferred") == "Abort.Panic"

                # Builders append new rows incrementally. A stale index must be bypassed
                # until both registries are caught up.
                table.function_effect_owner <- table.function_effect_owner.push("late")
                table.function_effect_name <- table.function_effect_name.push("Console.Read")
                table.function_effect_source_owner <- table.function_effect_source_owner.push("late")
                table.function_effect_source_ref <- table.function_effect_source_ref.push("Global.Write")
                assert table.effect_owner_indexed != table.function_effect_owner.count
                assert table.effect_source_indexed != table.function_effect_source_owner.count
                assert function_declares_effect(table, "late")
                assert function_body_panics(table, "late")
                assert function_first_effect_ref(table, "late") == "Console.Read"
                assert function_effect_refs(table, "late").count == 2
                assert cov_call_uncovered_ref(table, annotations, "late", no_grants) == "Console.Read"

                table <- index_effect_owner_rows(table)
                table <- index_effect_source_rows(table)
                assert function_declares_effect(table, "late")
                assert function_body_panics(table, "late")
                assert function_first_effect_ref(table, "late") == "Console.Read"

                # Force a foreign row to occupy the probe's hash bucket. Every lookup must
                # compare the stored owner after following the chain rather than treating the
                # hash match as identity. This deterministically covers the collision guard
                # without searching for a 64-bit FNV collision.
                assert name_hash("ghost") != name_hash("both")
                table.effect_owner_heads <- table.effect_owner_heads.put(name_hash("ghost"), 0.u32())
                table.effect_source_heads <- table.effect_source_heads.put(name_hash("ghost"), 0.u32())
                assert not function_declares_effect(table, "ghost")
                assert not function_body_panics(table, "ghost")
                assert function_first_effect_ref(table, "ghost") == ""
                assert function_first_declared_effect_ref(table, "ghost") == ""
                assert function_effect_refs(table, "ghost").count == 0
                assert cov_call_uncovered_ref(table, annotations, "ghost", no_grants) == ""
                return 0

def main() -> i64:
    can Abort.Panic, Memory.Allocate, Global{Read,Write}:
        return Semantic::effect_owner_lookup_index_test()
