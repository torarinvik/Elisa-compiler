include "../../src/parser/parser.elisa"
using Ast

extend Parser:
    private:
        def clone_registration_parse(source: u8& @source) -> Ast::File can[Abort.Panic, Atomics{Exchange, Load, Store}, Global{Read, Write}, Memory.Allocate, Unsafe{Alias, MutableGlobal, PointerArithmetic, PointerCast, RawExtern, UncheckedIndex}]:
            length: mutable usize = 0
            while source[length] != 0 |length|:
                length <- length + 1
            tokens: darray[Token] = frontend_tokenize_with_length(source, source, length) can Global{Read,Write}
            return frontend_parser_parse_file(source, tokens) can Global{Read,Write}

    public:
        def clone_registration_test() -> i64 can[Abort.Panic, Atomics{Exchange, Load, Store}, Global{Read, Write}, Memory.Allocate, Unsafe{Alias, MutableGlobal, PointerArithmetic, PointerCast, RawExtern, UncheckedIndex}]:
            # Direct operations with many installations must not invent helper clones.
            direct: Ast::File = clone_registration_parse("effect Tick:\n    def ping() -> void\nhandler static Sink() for Tick:\n    def ping() -> void:\n        return\ndef main() -> void:\n    can Tick with Sink:\n        Tick.ping()\n    can Tick with Sink:\n        Tick.ping()\n") can Global{Read,Write}
            assert direct.errors.count == 0 can Abort.Panic
            for annotation in direct.enum_annotations:
                assert annotation.owner != "__effect_clone" can Abort.Panic
            # Same-name overloads remain separate source declarations. Two installations
            # must register both overloads before any bodies redirect helper calls.
            helpers: Ast::File = clone_registration_parse("effect Tick:\n    def ping() -> void\nhandler static Sink() for Tick:\n    def ping() -> void:\n        return\nmodule Outer:\n    module Inner:\n        def emit() -> void can[Tick]:\n            Tick.ping()\n        def emit(value: i64) -> void can[Tick]:\n            Tick.ping()\ndef main() -> void:\n    can Tick with Sink:\n        Outer::Inner::emit()\n    can Tick with Sink:\n        Outer::Inner::emit(1)\n") can Global{Read,Write}
            assert helpers.errors.count == 0 can Abort.Panic
            lines: mutable darray[u32] = []
            for annotation in helpers.enum_annotations |lines|:
                if annotation.owner == "__effect_clone":
                    assert annotation.name == "emit" can Abort.Panic
                    lines.push(annotation.line) can Memory.Allocate
            assert lines.count == 4 can Abort.Panic
            assert lines[0] == 8 and lines[1] == 10 can Abort.Panic
            assert lines[2] == 8 and lines[3] == 10 can Abort.Panic
            # Synthesized helper-capture formals must retain the source position used by
            # __param_error_union so backend parameter typing keeps the captured family.
            fallible_capture: Ast::File = clone_registration_parse("error CaptureError:\n    Failed\n\neffect Tick:\n    def ping() -> i64 error[CaptureError]\n\nhandler static Sink(token: i64, value: i64 error[CaptureError]) for Tick:\n    def ping() -> i64 error[CaptureError]:\n        payload: i64 = try value\n        return token + payload\n\ndef make_value() -> i64 error[CaptureError]:\n    return 2\n\ndef emit() -> i64 error[CaptureError] can[Tick]:\n    return Tick.ping()\n\ndef main() -> i64:\n    can Tick with Sink(20, make_value()):\n        catch emit():\n            value:\n                return value\n            error failure:\n                return -1\n") can Global{Read,Write}
            assert fallible_capture.errors.count == 0 can Abort.Panic
            capture_offset: mutable u32 = 0
            for annotation in fallible_capture.enum_annotations |capture_offset|:
                capture_offset <- annotation.offset if annotation.owner == "__param_error_union" and annotation.name == "CaptureError"
            assert capture_offset > 0 can Abort.Panic
            scalar_capture_offset: mutable u32 = 0
            found_capture_clone: mutable bool = false
            for annotation in fallible_capture.enum_annotations |found_capture_clone, fallible_capture, capture_offset, scalar_capture_offset|:
                continue if annotation.owner != "__effect_clone_name"
                for declaration in fallible_capture.top_decls |found_capture_clone, annotation, capture_offset|:
                    match declaration:
                        Decl.Func(clone_name, clone_params, _, _, _, _, _) if clone_name == annotation.name:
                            assert clone_params.count == 2 can Abort.Panic
                            scalar_capture_offset <- clone_params[0].name_pos.offset
                            assert scalar_capture_offset > 0 and scalar_capture_offset != capture_offset can Abort.Panic
                            assert clone_params[1].name_pos.offset == capture_offset can Abort.Panic
                            found_capture_clone <- true
                        _:
                            pass
            assert found_capture_clone can Abort.Panic
            assert scalar_capture_offset > 0 can Abort.Panic
            for annotation in fallible_capture.enum_annotations:
                if annotation.owner == "__param_error_union":
                    assert annotation.offset != scalar_capture_offset can Abort.Panic
            # A scoped declaration wrapper must preserve the nested module owner and
            # source ordering, without admitting generated file-scope clone declarations.
            markers: mutable darray[Ast::EnumAnnotation] = []
            for annotation in helpers.enum_annotations |markers|:
                markers.push(annotation) can Memory.Allocate if annotation.owner == "__effect_template"
            scoped: darray[Ast::Decl] = [Ast::Decl.Scoped(helpers.top_decls, Ast::pos_at_line(0))] can Global{Read,Write}
            selected: mutable darray[Ast::Decl] = []
            owners: mutable darray[sview @source] = []
            effect_collect_template_declarations(scoped, markers, "", selected, owners) can Global{Read,Write}
            assert selected.count == 2 and owners.count == 2 can Abort.Panic
            assert owners[0] == "Outer::Inner" and owners[1] == "Outer::Inner" can Abort.Panic
            return 0

@test
def test_clone_registration_and_capture_error_union_abi() -> void:
    result: i64 = Parser::clone_registration_test() can[Abort.Panic, Atomics{Exchange, Load, Store}, Global{Read, Write}, Memory.Allocate, Unsafe{Alias, MutableGlobal, PointerArithmetic, PointerCast, RawExtern, UncheckedIndex}]
    assert result == 0
