include "../../src/parser/parser.elisa"
using Ast

extend Parser:
    private:
        def clone_registration_parse(source: u8&) -> Ast::File:
            length: mutable usize = 0
            while source[length] != 0 |length|:
                length <- length + 1
            tokens: darray[Token] = frontend_tokenize_with_length(source, source, length) can Global{Read,Write}
            return frontend_parser_parse_file(source, tokens) can Global{Read,Write}

    public:
        def clone_registration_test() -> i64:
            # Direct operations with many installations must not invent helper clones.
            direct: Ast::File = clone_registration_parse("effect Tick:\n    def ping() -> void\nhandler static Sink() for Tick:\n    def ping() -> void:\n        return\ndef main() -> void:\n    can Tick with Sink:\n        Tick.ping()\n    can Tick with Sink:\n        Tick.ping()\n") can Global{Read,Write}
            assert direct.errors.count == 0 can Abort.Panic
            for annotation in direct.enum_annotations:
                assert annotation.owner != "__effect_clone" can Abort.Panic
            # Same-name overloads remain separate source declarations. Two installations
            # must register both overloads before any bodies redirect helper calls.
            helpers: Ast::File = clone_registration_parse("effect Tick:\n    def ping() -> void\nhandler static Sink() for Tick:\n    def ping() -> void:\n        return\nmodule Outer:\n    module Inner:\n        def emit() -> void can[Tick]:\n            Tick.ping()\n        def emit(value: i64) -> void can[Tick]:\n            Tick.ping()\ndef main() -> void:\n    can Tick with Sink:\n        Outer::Inner::emit()\n    can Tick with Sink:\n        Outer::Inner::emit(1)\n") can Global{Read,Write}
            assert helpers.errors.count == 0 can Abort.Panic
            lines: mutable darray[u32] = []
            for annotation in helpers.enum_annotations |lines|:
                if annotation.owner == "__effect_clone":
                    assert annotation.name == "emit" can Abort.Panic
                    lines.push(annotation.line) can Memory.Allocate
            assert lines.count == 4 can Abort.Panic
            assert lines[0] == 8 and lines[1] == 10 can Abort.Panic
            assert lines[2] == 8 and lines[3] == 10 can Abort.Panic
            # A scoped declaration wrapper must preserve the nested module owner and
            # source ordering, without admitting generated file-scope clone declarations.
            markers: mutable darray[Ast::EnumAnnotation] = []
            for annotation in helpers.enum_annotations |markers|:
                markers.push(annotation) can Memory.Allocate if annotation.owner == "__effect_template"
            scoped: darray[Ast::Decl] = [Ast::Decl.Scoped(helpers.top_decls, Ast::pos_at_line(0))] can Global{Read,Write}
            selected: mutable darray[Ast::Decl] = []
            owners: mutable darray[sview] = []
            effect_collect_template_declarations(scoped, markers, "", selected, owners) can Global{Read,Write}
            assert selected.count == 2 and owners.count == 2 can Abort.Panic
            assert owners[0] == "Outer::Inner" and owners[1] == "Outer::Inner" can Abort.Panic
            return 0

def main() -> i64:
    return Parser::clone_registration_test() can Global{Read,Write}
