# Stage in test/parity: real parser implementation, no copied search algorithm.
include "../../src/parser/parser.elisa"
using Ast

extend Parser:
    private:
        def install_lookup_capture_name(value: Ast::Expr) -> sview:
            match value:
                Expr.Ident(name, _):
                    return name
                _:
                    return ""

    public:
        def install_lookup_control() -> i64:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                source: u8& = ""
                tokens: darray[Token] = frontend_tokenize_with_length(source, source, 0) can Unsafe{PointerArithmetic,RawExtern}
                parser: mutable Parser = Parser(source, 0, tokens) can Unsafe{PointerArithmetic,RawExtern}
                # Installation IDs are one-based row identities; zero is reserved even
                # when the source block itself begins at byte offset zero.
                assert parser.effect_install_row_at(10, 0) == 0
                assert parser.effect_install_id_at(10, 0) == 0
                assert parser.effect_install_parent(0) == 0
                assert parser.effect_install_effect_at(0) == ""
                assert parser.effect_install_captures_at(0).count == 0
                # Orphan metadata must not turn the missing-row sentinel into a match.
                parser with {
                    effect_install_parents <- [111],
                    effect_install_effects <- ["orphan"],
                    effect_install_handlers <- ["orphan-handler"],
                    effect_install_effect_identity_ids <- [222],
                    effect_install_handler_identity_ids <- [333]
                }
                assert parser.effect_install_parent(0) == 0
                assert parser.effect_install_effect_at(0) == ""
                assert parser.effect_install_handler_at(0) == ""
                assert parser.effect_install_effect_identity_at(0) == 0
                assert parser.effect_install_handler_identity_at(0) == 0
                parser with {
                    effect_install_lines <- [10, 20, 20, 40],
                    effect_install_offsets <- [100, 200, 201, 400],
                    effect_install_parents <- [0, 1, 2, 3],
                    effect_install_effects <- ["A", "B-first", "B-second", "C"],
                    effect_install_handlers <- ["H1", "H2-first", "H2-second", "H3"],
                    effect_install_effect_identity_ids <- [1, 2, 99, 3],
                    effect_install_handler_identity_ids <- [11, 12, 199, 13]
                }
                assert parser.effect_install_row_at(1, 100) == 4
                assert parser.effect_install_row_at(21, 200) == 4
                assert parser.effect_install_row_at(99, 100) == 4
                assert parser.effect_install_row_at(20, 200) == 1
                assert parser.effect_install_row_at(20, 201) == 2
                assert parser.effect_install_row_at(20, 202) == 4
                assert parser.effect_install_id_at(20, 200) == 2
                assert parser.effect_install_id_at(20, 201) == 3
                assert parser.effect_install_parent(2) == 1
                assert parser.effect_install_parent(3) == 2
                assert parser.effect_install_effect_at(2) == "B-first"
                assert parser.effect_install_effect_at(3) == "B-second"
                assert parser.effect_install_handler_at(2) == "H2-first"
                assert parser.effect_install_effect_identity_at(2) == 2
                assert parser.effect_install_handler_identity_at(2) == 12
                parser with {
                    effect_install_capture_ids <- [1, 2, 2, 3, 4],
                    effect_install_capture_names <- ["other", "first", "second", "third", "last"]
                }
                captures: darray[Ast::Expr] = parser.effect_install_captures_at(2)
                assert captures.count == 3
                assert install_lookup_capture_name(captures[0]) == "first"
                assert install_lookup_capture_name(captures[1]) == "second"
                third_captures: darray[Ast::Expr] = parser.effect_install_captures_at(3)
                assert third_captures.count == 1
                assert install_lookup_capture_name(third_captures[0]) == "third"
                assert parser.effect_install_captures_at(5).count == 0
                # A transformed source can append earlier lines. This deliberately creates
                # that retained-table shape and exercises the real scan fallback; end-to-end
                # installation append bookkeeping is checked by the existing effects suite.
                parser with {
                    effect_install_lines <- parser.effect_install_lines.push(5),
                    effect_install_offsets <- parser.effect_install_offsets.push(50),
                    effect_install_parents <- parser.effect_install_parents.push(4),
                    effect_install_effects <- parser.effect_install_effects.push("D"),
                    effect_install_handlers <- parser.effect_install_handlers.push("H4"),
                    effect_install_effect_identity_ids <- parser.effect_install_effect_identity_ids.push(4),
                    effect_install_handler_identity_ids <- parser.effect_install_handler_identity_ids.push(14),
                    effect_install_lines_monotonic <- false
                }
                assert parser.effect_install_row_at(5, 50) == 4
                assert parser.effect_install_id_at(5, 50) == 5
                assert parser.effect_install_parent(5) == 4
                assert parser.effect_install_row_at(20, 200) == 1
                assert parser.effect_install_row_at(21, 50) == 5
                parser with {
                    effect_install_capture_ids <- parser.effect_install_capture_ids.push(5),
                    effect_install_capture_names <- parser.effect_install_capture_names.push("fourth"),
                    effect_install_capture_ids_monotonic <- false
                }
                fallback: darray[Ast::Expr] = parser.effect_install_captures_at(5)
                assert fallback.count == 1
                assert install_lookup_capture_name(fallback[0]) == "fourth"
                return 0

def main() -> i64:
    can Memory.Allocate, Abort.Panic, Global{Read,Write}:
        return Parser::install_lookup_control() can Unsafe{PointerArithmetic,RawExtern}
