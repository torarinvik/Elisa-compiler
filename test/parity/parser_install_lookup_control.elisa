# Stage in test/parity: real parser implementation, no copied search algorithm.
include "../../src/parser/parser.elisa"
using Ast

extend Parser:
    private:
        def install_lookup_capture_name(value: Ast::Expr) -> sview:
            match value:
                Expr.Ident(name, _):
                    return name
                _:
                    return ""

    public:
        def install_lookup_control() -> i64:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                source: u8& = ""
                tokens: darray[Token] = frontend_tokenize_with_length(source, source, 0) can Unsafe{PointerArithmetic,RawExtern}
                parser: mutable Parser = Parser(source, tokens) can Unsafe{PointerArithmetic,RawExtern}
                # Empty and missing rows use the original sentinel/default values.
                assert parser.effect_install_row_at(10) == 0
                assert parser.effect_install_parent(10) == 0
                assert parser.effect_install_effect_at(10) == ""
                assert parser.effect_install_captures_at(10).count == 0
                parser.effect_install_lines <- [10, 20, 20, 40]
                parser.effect_install_parents <- [0, 10, 999, 20]
                parser.effect_install_effects <- ["A", "B-first", "B-second", "C"]
                parser.effect_install_handlers <- ["H1", "H2-first", "H2-second", "H3"]
                parser.effect_install_effect_identity_ids <- [1, 2, 99, 3]
                parser.effect_install_handler_identity_ids <- [11, 12, 199, 13]
                assert parser.effect_install_row_at(1) == 4
                assert parser.effect_install_row_at(21) == 4
                assert parser.effect_install_row_at(99) == 4
                assert parser.effect_install_row_at(20) == 1
                assert parser.effect_install_parent(20) == 10
                assert parser.effect_install_effect_at(20) == "B-first"
                assert parser.effect_install_handler_at(20) == "H2-first"
                assert parser.effect_install_effect_identity_at(20) == 2
                assert parser.effect_install_handler_identity_at(20) == 12
                parser.effect_install_capture_lines <- [10, 20, 20, 20, 40]
                parser.effect_install_capture_names <- ["other", "first", "second", "third", "last"]
                captures: darray[Ast::Expr] = parser.effect_install_captures_at(20)
                assert captures.count == 3
                assert install_lookup_capture_name(captures[0]) == "first"
                assert install_lookup_capture_name(captures[1]) == "second"
                assert install_lookup_capture_name(captures[2]) == "third"
                assert parser.effect_install_captures_at(21).count == 0
                # A transformed source can append earlier lines. This deliberately creates
                # that retained-table shape and exercises the real scan fallback; end-to-end
                # installation append bookkeeping is checked by the existing effects suite.
                parser.effect_install_lines <- parser.effect_install_lines.push(5)
                parser.effect_install_parents <- parser.effect_install_parents.push(40)
                parser.effect_install_effects <- parser.effect_install_effects.push("D")
                parser.effect_install_handlers <- parser.effect_install_handlers.push("H4")
                parser.effect_install_effect_identity_ids <- parser.effect_install_effect_identity_ids.push(4)
                parser.effect_install_handler_identity_ids <- parser.effect_install_handler_identity_ids.push(14)
                parser.effect_install_lines_monotonic <- false
                assert parser.effect_install_row_at(5) == 4
                assert parser.effect_install_parent(5) == 40
                assert parser.effect_install_row_at(20) == 1
                assert parser.effect_install_row_at(21) == 5
                parser.effect_install_capture_lines <- parser.effect_install_capture_lines.push(20)
                parser.effect_install_capture_names <- parser.effect_install_capture_names.push("fourth")
                parser.effect_install_capture_lines_monotonic <- false
                fallback: darray[Ast::Expr] = parser.effect_install_captures_at(20)
                assert fallback.count == 4
                assert install_lookup_capture_name(fallback[0]) == "first"
                assert install_lookup_capture_name(fallback[1]) == "second"
                assert install_lookup_capture_name(fallback[2]) == "third"
                assert install_lookup_capture_name(fallback[3]) == "fourth"
                return 0

def main() -> i64:
    can Memory.Allocate, Abort.Panic, Global{Read,Write}:
        return Parser::install_lookup_control() can Unsafe{PointerArithmetic,RawExtern}
