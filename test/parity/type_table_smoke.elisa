# Type-table smoke: parse a probe signature, run the registration pass
# (`intern_file_types`), and assert the interned structure — tuple/container/
# optional/ref rows, element round-trips, fixed-array modeling, nesting, and
# dedup (TypeId equality == structural type equality). Anchors Phase C's interned
# type-table foundation (backlog items 92-94/96).
#
# The smoke asserts on TABLE ROWS, never on raw AST matches: AST payload lists
# are only reliably readable from inside the Semantic walk context (matching
# them from an exported smoke entry reads garbled payloads / crashes — observed
# empirically), so all AST consumption happens inside intern_file_types.
include "../../src/semantic/semantic.elisa"


# The TypeId of the unique row with `kind` (0 if absent/ambiguous — scalar rows
# are deduped so at most one exists per scalar kind).
def find_scalar_row(kind: Semantic::TypeKind, table: Semantic::SymbolTable&) -> u32:
    can Abort.Panic:
        found: u32 =
            for row_index in 0..<table.type_row_kind.count |found: u32 = 0| -> found:
                found <- (row_index + 1).u32() if table.type_row_kind[row_index] == kind else found
        return found


def type_table_smoke(source: u8&, source_length: usize, passed_out: mutable u64&, total_out: mutable u64&):
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Token] = frontend_tokenize_with_length(source, source, source_length)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        table: mutable Semantic::SymbolTable = Semantic::SymbolTable()
        Semantic::intern_file_types(file, table)
        passed: mutable u64 = 0
        total: mutable u64 = 0

        # The probe declares LOCALS a..h plus PARAMS p: dict[cstr, i64] and
        # q: (first: i64, second: i64) whose annotations must DEDUP into the same rows as the
        # locals' (guards the param-position payload fix, stage0 da3fb1c6 — the
        # pre-fix aliasing would mint extra wrong rows and break the count).
        # Expected interned rows (deduped):
        # Int, Tuple(Int,Int), darray[Int], Bool, Optional(Bool), Ref(Int),
        # String, dict[String,Int], array[Int], Optional(darray[Int]), Box[Int].
        int_id: u32 = find_scalar_row(Semantic::TypeKind.Int, table)
        bool_id: u32 = find_scalar_row(Semantic::TypeKind.Bool, table)
        string_id: u32 = find_scalar_row(Semantic::TypeKind.String, table)
        tuple_id: u32 = find_scalar_row(Semantic::TypeKind.Tuple, table)
        ref_id: u32 = find_scalar_row(Semantic::TypeKind.Ref, table)

        # Exactly 11 deduped rows (dedup collapses the two i64 tuple elements, and
        # b's darray[i64] row is REUSED by g's optional).
        total <- total + 1
        passed <- passed + 1 if table.type_row_kind.count == 11

        # The scalar rows exist.
        total <- total + 1
        passed <- passed + 1 if int_id != 0 and bool_id != 0 and string_id != 0

        # a: (first: i64, second: i64) — Tuple of the SAME Int row twice.
        total <- total + 1
        passed <- passed + 1 if tuple_id != 0 and Semantic::interned_elem_count(tuple_id, table) == 2
        total <- total + 1
        passed <- passed + 1 if Semantic::interned_elem(tuple_id, 0, table) == int_id and Semantic::interned_elem(tuple_id, 1, table) == int_id

        # d: u8& — Ref over Int.
        total <- total + 1
        passed <- passed + 1 if ref_id != 0 and Semantic::interned_elem(ref_id, 0, table) == int_id

        # Containers: darray[Int], dict[String, Int], array[Int] (fixed i64[3]).
        darray_id: mutable u32 = 0
        dict_id: mutable u32 = 0
        array_id: mutable u32 = 0
        for row_index in 0..<table.type_row_kind.count |darray_id, dict_id, array_id, table|:
            row_id: u32 = (row_index + 1).u32()
            continue if table.type_row_kind[row_index] != Semantic::TypeKind.Container
            darray_id <- row_id if table.type_row_name[row_index] == "darray"
            dict_id <- row_id if table.type_row_name[row_index] == "dict"
            array_id <- row_id if table.type_row_name[row_index] == "array"
        total <- total + 1
        passed <- passed + 1 if darray_id != 0 and Semantic::interned_elem(darray_id, 0, table) == int_id
        total <- total + 1
        passed <- passed + 1 if dict_id != 0 and Semantic::interned_elem_count(dict_id, table) == 2
        total <- total + 1
        passed <- passed + 1 if Semantic::interned_elem(dict_id, 0, table) == string_id and Semantic::interned_elem(dict_id, 1, table) == int_id
        total <- total + 1
        passed <- passed + 1 if array_id != 0 and Semantic::interned_elem(array_id, 0, table) == int_id

        # Optionals: Optional(Bool) from c, Optional(darray[Int]) from g — two
        # DISTINCT rows proving nesting + non-collapse of different bases.
        optional_bool: mutable u32 = 0
        optional_darray: mutable u32 = 0
        for row_index in 0..<table.type_row_kind.count |optional_bool, optional_darray, table|:
            row_id: u32 = (row_index + 1).u32()
            continue if table.type_row_kind[row_index] != Semantic::TypeKind.Optional
            optional_bool <- row_id if Semantic::interned_elem(row_id, 0, table) == bool_id
            optional_darray <- row_id if Semantic::interned_elem(row_id, 0, table) == darray_id
        total <- total + 1
        passed <- passed + 1 if optional_bool != 0
        total <- total + 1
        passed <- passed + 1 if optional_darray != 0 and optional_darray != optional_bool

        # h: Box[i64] — user generic heads use the same canonical Container row
        # representation as built-in collection heads.
        box_id: mutable u32 = 0
        for row_index in 0..<table.type_row_kind.count |box_id, table|:
            row_id: u32 = (row_index + 1).u32()
            box_id <- row_id if table.type_row_kind[row_index] == Semantic::TypeKind.Container and table.type_row_name[row_index] == "Box"
        total <- total + 1
        passed <- passed + 1 if box_id != 0 and Semantic::interned_elem(box_id, 0, table) == int_id

        # Compatibility: exact structure and recursive optional/container structure
        # pass; a different generic head does not; scalar bool/int do not cross walls.
        total <- total + 1
        passed <- passed + 1 if Semantic::type_ids_compatible(darray_id, darray_id, table)
        total <- total + 1
        passed <- passed + 1 if optional_darray != 0 and Semantic::type_ids_compatible(optional_darray, optional_darray, table)
        total <- total + 1
        passed <- passed + 1 if dict_id != 0 and box_id != 0 and not Semantic::type_ids_compatible(dict_id, box_id, table)
        total <- total + 1
        passed <- passed + 1 if not Semantic::type_ids_compatible(int_id, bool_id, table)

        # Substitution: Box[Int] -> Box[Bool] rebuilds and interns a distinct row.
        from_ids: darray[u32] = [int_id]
        to_ids: darray[u32] = [bool_id]
        substituted_box: u32 = Semantic::substitute_type_id(box_id, from_ids, to_ids, table)
        total <- total + 1
        passed <- passed + 1 if substituted_box != 0 and substituted_box != box_id and Semantic::interned_elem(substituted_box, 0, table) == bool_id
        total <- total + 1
        passed <- passed + 1 if Semantic::substitute_type_id(box_id, from_ids, to_ids, table) == substituted_box


        passed_out[0] <- passed
        total_out[0] <- total


export fn type_table_smoke_export(source: u8&, source_length: usize, passed_out: mutable u64&, total_out: mutable u64&) -> void = type_table_smoke
