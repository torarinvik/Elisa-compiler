module Backend:
    public:
        def remainder_probe_placeholder() -> i32:
            0
include "../../src/backend/llvm_c.elisa"
include "../../src/backend/codegen_remainder_reduction.elisa"
extern LLVMParseIRInContext(ctx: LLVMContextRef, buffer: void&, module_out: mutable LLVMModuleRef&, message_out: void&) -> i32

def main() -> i64 can[Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read]:
    context: LLVMContextRef = LLVMContextCreate()
    buffer: mutable void&? = null
    message: mutable void&? = null
    placeholder: LLVMModuleRef = LLVMModuleCreateWithNameInContext("placeholder", context)
    module: mutable LLVMModuleRef = placeholder
    status: mutable i32 = LLVMCreateMemoryBufferWithContentsOfFile("input.ll", (&buffer).cast[void&], (&message).cast[void&]) can Unsafe.PointerCast
    return 80 if status != 0
    if buffer is loaded:
        status <- LLVMParseIRInContext(context, loaded, &module, (&message).cast[void&]) can Unsafe.PointerCast
    LLVMDisposeModule(placeholder)
    return 81 if status != 0
    return 82 if LLVMVerifyModule(module, 2, null) != 0
    return 86 if LLVMPrintModuleToFile(module, "before.ll", null) != 0
    can Global.Read:
        _ = Backend::group_remainder_reductions(module, context) can[Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read]
    return 83 if LLVMVerifyModule(module, 2, null) != 0
    can Global.Read:
        return 84 if (Backend::group_remainder_reductions(module, context) can[Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read]) != 0
    return 85 if LLVMPrintModuleToFile(module, "output.ll", null) != 0
    LLVMDisposeModule(module)
    LLVMContextDispose(context)
    0
