extend Backend:
    public:
        def packed_test_contains(text: sview, needle: sview) -> bool:
            return false if text.len < needle.len
            for start in 0..<(text.len - needle.len + 1) |text, needle|:
                matched: mutable bool = true
                for index in 0..<needle.len |start, text, needle, matched|:
                    matched <- false if text[start + index] != needle[index]
                return true if matched
            return false

        def check_nested_packed_target_width(layout: cstr, pointer_bytes: u32) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe{PointerArithmetic,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}:
                source: u8& @source = "@packed_profile(build_heavy)\npacked enum Node:\n    Ident(name: sview)\n    Call(child: Node)\ndef run(owner: Arena) -> i64:\n    store: Node.Store[Local] = Node.Store(owner)\n    in store:\n        leaf: Node = new Node.Ident(name: \"hello\")\n        root: Node = new Node.Call(child: leaf)\n        result: i64 = match root:\n            Node.Call(Node.Ident(text)): 1 if text == \"hello\" else 0\n            _: 0\n        return result\ndef main() -> i64:\n    region r(4096):\n        return run(r)\n"
                tokens: darray[Lexer::Token] = frontend_tokenize(source, source)
                file: Ast::File = frontend_parser_parse_file(source, tokens)
                assert file.errors.count == 0
                ctx: LLVMContextRef = LLVMContextCreate()
                module_handle: LLVMModuleRef = LLVMModuleCreateWithNameInContext("nested_packed_width", ctx)
                LLVMSetDataLayout(module_handle, layout)
                builder: LLVMBuilderRef = LLVMCreateBuilderInContext(ctx)
                assert emit_module(file, module_handle, ctx, builder, LLVMGetModuleDataLayout(module_handle)) > 0
                assert LLVMVerifyModule(module_handle, 2, null) == 0
                ir: cstr = LLVMPrintModuleToString(module_handle)
                ir_text: sview = sview(ir, 0, ir.len)
                if pointer_bytes == 4:
                    assert packed_test_contains(ir_text, "alloca [4 x i32], align 8")
                    assert packed_test_contains(ir_text, "@ctx_packed_store_read_index_word(ptr, i32, ptr, i32)")
                    assert not packed_test_contains(ir_text, "ptr %mis.state, i64")
                LLVMDisposeMessage(ir)
                LLVMDisposeBuilder(builder)
                LLVMDisposeModule(module_handle)
                LLVMContextDispose(ctx)
