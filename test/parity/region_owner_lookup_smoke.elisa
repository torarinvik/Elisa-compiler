include "../../src/backend/codegen.elisa"

extend Backend:
    public:
        # Exercise the production forwarding scan, including its owner selection,
        # rather than duplicating the lookup in this test.
        def forwarded_region_fact(callee: Expr, table: mutable StructTable&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                position: Ast::Pos = Ast::pos_at_line(1)
                params: darray[Ast::ParamDecl] = [Ast::ParamDecl{name: "argument", type_expression: Expr.Ident("i64", position), is_mutable: false, has_default: false, default_value: Expr.Invalid}]
                arguments: darray[Expr] @source = [Expr.Ident("argument", position)]
                names: darray[sview @source] @source = [""]
                call: Expr = Expr.Call(callee, arguments, names, position)
                caller_row: usize = table.regions.region_fact_names.count - 1.usize()
                caller_slot: usize = table.regions.region_fact_starts[caller_row]
                table.regions.region_fact_params[caller_slot] <- false
                changed: mutable bool = false
                region_scan_forwarding_expression(call, params, table, caller_row, changed)
                return table.regions.region_fact_params[caller_slot]

        def region_owner_lookup_test() -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.UncheckedIndex]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.UncheckedIndex:
                ctx: LLVMContextRef = LLVMContextCreate()
                module_handle: LLVMModuleRef = LLVMModuleCreateWithNameInContext("region_owner_lookup_smoke", ctx)
                machine: void& = configure_module_target(module_handle)
                target_data: LLVMTargetDataRef = LLVMCreateTargetDataLayout(machine)
                table: mutable StructTable = new_struct_table(ctx, target_data)
                table.aliases.module_alias_names <- ["B"]
                table.aliases.module_alias_targets <- ["Box"]
                table.regions.region_fact_names <- ["append", "append", "append", "caller"]
                table.regions.region_fact_owners <- ["Box", "Other", "", ""]
                table.regions.region_fact_starts <- [0, 1, 2, 3]
                table.regions.region_fact_counts <- [1, 1, 1, 1]
                table.regions.region_fact_params <- [true, false, true, false]

                line: Ast::Pos = Ast::pos_at_line(1)
                known_callee: Expr = Expr.Scope(Expr.Ident("Box", line), "append", line)
                known_owner: (owner: sview, resolved: bool) = region_callee_owner(known_callee, 1.usize(), table)
                assert known_owner.resolved and known_owner.owner == "Box"
                assert forwarded_region_fact(known_callee, table)
                other_callee: Expr = Expr.Scope(Expr.Ident("Other", line), "append", line)
                assert not forwarded_region_fact(other_callee, table)

                alias_callee: Expr = Expr.Scope(Expr.Ident("B", line), "append", line)
                alias_owner: (owner: sview, resolved: bool) = region_callee_owner(alias_callee, 1.usize(), table)
                assert alias_owner.resolved and alias_owner.owner == "Box"
                assert forwarded_region_fact(alias_callee, table)

                unknown_callee: Expr = Expr.Scope(Expr.Ident("Alien", line), "append", line)
                unknown_owner: mutable (owner: sview, resolved: bool) = region_callee_owner(unknown_callee, 1.usize(), table)
                assert unknown_owner.owner != "Other"
                assert forwarded_region_fact(unknown_callee, table)

                # With no owner-less row, an unknown explicit qualifier must not match the
                # unrelated module's false fact merely because its function name collides.
                table.regions.region_fact_names <- ["append", "caller"]
                table.regions.region_fact_owners <- ["Other", ""]
                table.regions.region_fact_starts <- [0, 1]
                table.regions.region_fact_counts <- [1, 1]
                table.regions.region_fact_params <- [false, false]
                unknown_owner <- region_callee_owner(unknown_callee, 1.usize(), table)
                assert not forwarded_region_fact(unknown_callee, table)
                LLVMDisposeTargetData(target_data)
                LLVMDisposeModule(module_handle)
                LLVMContextDispose(ctx)
                return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.UncheckedIndex]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.UncheckedIndex:
        return Backend::region_owner_lookup_test()
