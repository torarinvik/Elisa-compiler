include "../../src/backend/codegen.elisa"

extend Backend:
    public:
        def region_owner_lookup_test() -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.UncheckedIndex]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.UncheckedIndex:
                ctx: LLVMContextRef = LLVMContextCreate()
                module_handle: LLVMModuleRef = LLVMModuleCreateWithNameInContext("region_owner_lookup_smoke", ctx)
                machine: void& = configure_module_target(module_handle)
                target_data: LLVMTargetDataRef = LLVMCreateTargetDataLayout(machine)
                table: mutable StructTable = new_struct_table(ctx, target_data)
                table.module_alias_names <- ["B"]
                table.module_alias_targets <- ["Box"]
                table.region_fact_names <- ["append", "append", "append"]
                table.region_fact_owners <- ["Box", "Other", ""]
                table.region_fact_starts <- [0, 1, 2]
                table.region_fact_counts <- [1, 1, 1]
                table.region_fact_params <- [true, false, true]

                line: Ast::Pos = Ast::pos_at_line(1)
                known_callee: Expr = Expr.Scope(Expr.Ident("Box", line), "append", line)
                known_owner: sview = region_callee_owner(known_callee, 1.usize(), table)
                assert known_owner == "Box"
                assert region_fact_parameter_has_region("append", known_owner, 0.usize(), table)
                assert not region_fact_parameter_has_region("append", "Other", 0.usize(), table)

                alias_callee: Expr = Expr.Scope(Expr.Ident("B", line), "append", line)
                alias_owner: sview = region_callee_owner(alias_callee, 1.usize(), table)
                assert alias_owner == "Box"
                assert region_fact_parameter_has_region("append", alias_owner, 0.usize(), table)

                unknown_callee: Expr = Expr.Scope(Expr.Ident("Alien", line), "append", line)
                unknown_owner: mutable sview = region_callee_owner(unknown_callee, 1.usize(), table)
                assert unknown_owner != "Other"
                assert region_fact_parameter_has_region("append", unknown_owner, 0.usize(), table)

                # With no owner-less row, an unknown explicit qualifier must not match the
                # unrelated module's false fact merely because its function name collides.
                table.region_fact_names <- ["append"]
                table.region_fact_owners <- ["Other"]
                table.region_fact_starts <- [0]
                table.region_fact_counts <- [1]
                table.region_fact_params <- [false]
                unknown_owner <- region_callee_owner(unknown_callee, 1.usize(), table)
                assert not region_fact_parameter_has_region("append", unknown_owner, 0.usize(), table)
                LLVMDisposeTargetData(target_data)
                LLVMDisposeModule(module_handle)
                LLVMContextDispose(ctx)
                return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.UncheckedIndex]:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.UncheckedIndex:
        return Backend::region_owner_lookup_test()
