include "../../src/parser/parser.elisa"
using Ast
using Bytes

module Semantic:
    public:
        const INCREMENTAL_ANCHOR_CONTROL_CONTEXT: u32 = 1

include "../../src/semantic/incremental_function_facts.elisa"

extend Semantic:
    public:
        # Preserve the original forward scan as a differential reference.
        def incremental_anchor_forward_control(tokens: darray[Lexer::Token]&, body_start: usize, body_end: usize, offset: u32) -> u32:
            can Abort.Panic:
                return INCREMENTAL_NO_ANCHOR if offset == 0 or body_start >= body_end or body_end > tokens.count
                for index in body_start..<body_end:
                    token: Lexer::Token = tokens[index]
                    if offset < token.start + token.length + token.suffix_length.u32():
                        return (index - body_start).u32()
                return INCREMENTAL_NO_ANCHOR

        def incremental_anchor_control() -> i64:
            can Memory.Allocate, Abort.Panic:
                source: static u8& = "head 1u64 tail"
                tokens: darray[Lexer::Token] = frontend_tokenize_with_length(source, source, 14)
                assert tokens.count >= 4
                # The range starts after `head`; results stay relative to BODY_START.
                assert ifc_anchor(tokens, 1, 3, 0) == INCREMENTAL_NO_ANCHOR
                assert ifc_anchor(tokens, 1, 3, 4) == 0
                assert ifc_anchor(tokens, 1, 3, 5) == 0
                # The suffix remains part of the numeric token; the following space maps
                # to the next token, just like the original forward scan.
                assert ifc_anchor(tokens, 1, 3, 8) == 0
                assert ifc_anchor(tokens, 1, 3, 9) == 1
                assert ifc_anchor(tokens, 1, 3, 10) == 1
                assert ifc_anchor(tokens, 1, 3, 13) == 1
                assert ifc_anchor(tokens, 1, 3, 14) == INCREMENTAL_NO_ANCHOR
                assert ifc_anchor(tokens, 3, 3, 10) == INCREMENTAL_NO_ANCHOR
                assert ifc_anchor(tokens, 1, tokens.count + 1, 10) == INCREMENTAL_NO_ANCHOR
                assert ifc_anchor(tokens, tokens.count, tokens.count, 10) == INCREMENTAL_NO_ANCHOR
                assert ifc_anchor(tokens, 3, 1, 10) == INCREMENTAL_NO_ANCHOR
                # Every body subrange and byte boundary of real lexer output must
                # retain the forward scan's result, including whitespace and EOF.
                for start in 0..<tokens.count:
                    for end in start..=tokens.count:
                        for offset in 0..=15:
                            assert ifc_anchor(tokens, start, end, offset.u32()) == incremental_anchor_forward_control(tokens, start, end, offset.u32())
                # More than 64 tokens exercises deeper searches and later anchors.
                long_source: static u8& = "0u64  1u64 \t2u64  3u64 \t4u64  5u64 \t6u64  7u64 \t8u64  9u64 \t10u64  11u64 \t12u64  13u64 \t14u64  15u64 \t16u64  17u64 \t18u64  19u64 \t20u64  21u64 \t22u64  23u64 \t24u64  25u64 \t26u64  27u64 \t28u64  29u64 \t30u64  31u64 \t32u64  33u64 \t34u64  35u64 \t36u64  37u64 \t38u64  39u64 \t40u64  41u64 \t42u64  43u64 \t44u64  45u64 \t46u64  47u64 \t48u64  49u64 \t50u64  51u64 \t52u64  53u64 \t54u64  55u64 \t56u64  57u64 \t58u64  59u64 \t60u64  61u64 \t62u64  63u64 \t64u64  65u64 \t66u64  67u64 \t68u64  69u64 \t70u64  71u64 \t"
                long_tokens: darray[Lexer::Token] = frontend_tokenize_with_length(long_source, long_source, 494)
                assert long_tokens.count > 64
                for boundary in 0..=long_tokens.count:
                    for offset in 0..=495:
                        assert ifc_anchor(long_tokens, boundary, long_tokens.count, offset.u32()) == incremental_anchor_forward_control(long_tokens, boundary, long_tokens.count, offset.u32())
                        assert ifc_anchor(long_tokens, 0, boundary, offset.u32()) == incremental_anchor_forward_control(long_tokens, 0, boundary, offset.u32())
                return 0

def main() -> i64:
    return Semantic::incremental_anchor_control() can Memory.Allocate, Abort.Panic, Global{Read,Write}
