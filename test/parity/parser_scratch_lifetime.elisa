include "../../src/parser/parser.elisa"
using Ast

def main() -> i64:
    source: u8& = "def answer(x: i64) -> i64:\n    return x + 42\n"
    file: Ast::File = frontend_parse(source)
    # Repeated lexing reuses released token backing. Inspect surviving AST payloads
    # and source views afterwards, rather than merely checking the outer header.
    for i in 0..<50:
        other: Ast::File = frontend_parse("def other() -> i64:\n    return 7\n")
        return 1 if other.errors.count != 0 or other.top_decls.count != 1
    return 2 if file.errors.count != 0 or file.top_decls.count != 1
    match file.top_decls[0]:
        Decl.Func(name, params, return_type, body, effects, decorators, line):
            return 3 if name != "answer" or params.count != 1 or params[0].name != "x" or body.count != 1
            match body[0]:
                Stmt.Return(value, pos):
                    match value:
                        Expr.Binary(left, operator, right, position):
                            if right is Expr.IntLit(number, number_pos):
                                return 0 if number == 42 else 4
                        _:
                            return 6
                _:
                    pass
        _:
            pass
    return 5
