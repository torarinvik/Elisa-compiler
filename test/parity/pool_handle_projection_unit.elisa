include "../../src/backend/codegen.elisa"

extend Backend:
    public:
        def pool_handle_projection_test() -> i64 can[Abort.Panic, Memory.Allocate]:
            pos: Ast::Pos = Ast::pos_at_line(1)
            local_scope: mutable Scope = Scope{names: [], slots: [], types: [], pool_names: [], group_names: [], deferred: []}
            fns: mutable FnTable = zeroed
            structs: mutable StructTable = StructTable{target: BackendTarget{context: null, target_data: null, target_pointer_bits: 64}}
            generics: mutable GenericTable = new_generic_table()
            structs.globals.mutable_global_names <- ["unresolved_word"]
            structs.globals.mutable_global_owners <- [""]
            structs.globals.mutable_global_types <- [ValueType{kind: TypeKind.Unsigned, bits: 64}]
            fields: darray[Ast::FieldInit] @source = [Ast::FieldInit{name: "value", value: Ast::Expr.Ident("unresolved_word", pos)}]
            aggregate: Ast::Expr = Ast::Expr.RecordUpdate(Ast::Expr.Invalid, fields, pos)
            projection: Ast::Expr = Ast::Expr.Field(aggregate, "value", pos)
            return 0 if backend_expression_projects_pool_lifetime_handle(projection, local_scope, fns, structs, generics, 0.usize())
            return 1

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Backend::pool_handle_projection_test()
