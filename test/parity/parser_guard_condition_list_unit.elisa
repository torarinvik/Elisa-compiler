# Compile the actual condition-list parser with a reduced cursor/expression adapter.
# The full-parser structural fixture remains the integration test.
include "../../elisacore_std/elisacore_runtime.elisa"
module Lexer:
    public:
        const enum TokenKind of u8:
            Ident
            Colon
            Newline
            Indent
            Dedent
            Eof
            Or
        struct Token:
            kind: TokenKind
            line: u32
            text: sview
        def text_or_empty(token: Token, source: u8&, length: usize) -> sview:
            return token.text
        def token_stream_source_length(tokens: darray[Token]&) -> usize:
            return 0
using Lexer

module Ast:
    public:
        struct Pos:
            line: u32
        enum Node layout(handle: u32):
            pass
        enum Expr is Node:
            Ident(name: sview, pos: Pos)
            Binary(left: Expr, operator: TokenKind, right: Expr, pos: Pos)
        enum Stmt is Node:
            Return(value: Expr?, pos: Pos)
            Break(label: sview, pos: Pos)
            Continue(label: sview, pos: Pos)
        def pos_of_token(token: Token) -> Pos:
            return Pos{line: token.line}

using Ast

module FmtUnparse:
    public:
        def fmt_push(buffer: mutable darray[u8]&, text: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                for index in 0..<text.len |buffer, text|:
                    buffer.push(text[index])
        def fmt_indent(buffer: mutable darray[u8]&, indent: i64) -> void:
            can Memory.Allocate, Abort.Panic:
                for index in 0..<indent |buffer|:
                    buffer.push(32)
        def fmt_expr(buffer: mutable darray[u8]&, expression: Expr, tokens: darray[Token]&, source: u8&) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Ident(name, _):
                        fmt_push(buffer, name)
                    Expr.Binary(_, _, _, _):
                        fmt_push(buffer, "binary")
        def fmt_stmt_source_line(statement: Stmt) -> u32:
            match statement:
                Stmt.Return(_, position) | Stmt.Break(_, position) | Stmt.Continue(_, position):
                    return position.line

include "../../src/driver/emit_fmt_guard_condition.elisa"

module Parser:
    public:
        struct Parser:
            tokens: darray[Token]
            position: mutable usize
            errors: mutable usize
    private:
        def peek(parser: Parser&) -> TokenKind:
            return TokenKind.Eof if parser.position >= parser.tokens.count
            return parser.tokens[parser.position].kind
        def advance(parser: lmut Parser) -> Token:
            token: Token = parser.tokens[parser.position]
            parser.position <- parser.position + 1
            return token
        def accept(parser: lmut Parser, kind: TokenKind) -> bool:
            return false if parser.peek() != kind
            parser, _ <- parser.advance()
            return true
        def expect(parser: lmut Parser, kind: TokenKind) -> Token:
            parser.errors <- parser.errors + 1 if parser.peek() != kind
            rebind token: Token, parser = parser.advance()
            return token
        def skip_newlines(parser: lmut Parser) -> void:
            while parser.peek() == TokenKind.Newline:
                parser, _ <- parser.advance()
        def prev_is_dedent(parser: Parser&) -> bool:
            return false if parser.position == 0
            return parser.tokens[parser.position - 1].kind == TokenKind.Dedent
        def error_removed(parser: lmut Parser, token: Token, message: sview) -> void:
            parser.errors <- parser.errors + 1
        def expression(parser: lmut Parser) -> Ast::Expr?:
            can Memory.Allocate, Abort.Panic:
                rebind token: Token, parser = parser.advance()
                if token.kind != TokenKind.Ident:
                    parser.errors <- parser.errors + 1
                    return null
                return Ast::Expr.Ident(token.text, Ast::pos_of_token(token))

include "../../src/parser/parser_guard_condition.elisa"

extend Parser:
    public:
        def check_list(valid: bool) -> bool:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                tokens: mutable darray[Token] = [Token{kind: TokenKind.Colon, line: 1, text: ""}, Token{kind: TokenKind.Newline, line: 1, text: ""}, Token{kind: TokenKind.Indent, line: 2, text: ""}, Token{kind: TokenKind.Ident, line: 2, text: "a"}, Token{kind: TokenKind.Newline, line: 2, text: ""}, Token{kind: TokenKind.Ident, line: 3, text: "b"}, Token{kind: TokenKind.Newline, line: 3, text: ""}, Token{kind: TokenKind.Dedent, line: 4, text: ""}, Token{kind: TokenKind.Ident, line: 4, text: "tail"}, Token{kind: TokenKind.Eof, line: 5, text: ""}]
                tokens <- [Token{kind: TokenKind.Colon, line: 1, text: ""}, Token{kind: TokenKind.Newline, line: 1, text: ""}, Token{kind: TokenKind.Ident, line: 2, text: "tail"}, Token{kind: TokenKind.Eof, line: 3, text: ""}] if not valid
                parser: mutable Parser = Parser{tokens: tokens, position: 0, errors: 0}
                rebind condition: Ast::Expr?, parser = parser.guard_condition()
                return parser.errors > 0 if not valid
                return false if parser.errors != 0
                if condition is value:
                    match value:
                        Ast::Expr.Binary(Ast::Expr.Ident(left, _), TokenKind.Or, Ast::Expr.Ident(right, _), _):
                            return left == "a" and right == "b" and parser.peek() == TokenKind.Ident
                        _:
                            return false
                return false

@test
def test_actual_guard_list_fold_and_cursor() -> void:
    can Memory.Allocate, Abort.Panic, Global{Read,Write}:
        assert Parser::check_list(true)

@test
def test_actual_guard_list_rejects_empty() -> void:
    can Memory.Allocate, Abort.Panic, Global{Read,Write}:
        assert Parser::check_list(false)

@test
def test_actual_guard_formatter_canonical_return() -> void:
    can Memory.Allocate, Abort.Panic, Global{Read,Write}:
        region guard_nodes(4096):
            store: Ast::Node.Store[Local] = Ast::Node.Store(guard_nodes)
            in store:
                position: Pos = Pos{line: 1}
                condition: Expr = Expr.Binary(Expr.Ident("a", position), TokenKind.Or, Expr.Ident("b", position), position)
                body: darray[Stmt] = [Stmt.Return(Expr.Ident("7", position), position)]
                tokens: darray[Token] = []
                buffer: mutable darray[u8] = []
                assert FmtUnparse::fmt_control_guard(buffer, condition, body, [], position, 0, tokens, "")
                assert buffer.as_sview() == "return 7 if:\n    a\n    b\n"

@test
def test_actual_guard_formatter_keeps_grant_header_on_original_path() -> void:
    can Memory.Allocate, Abort.Panic, Global{Read,Write}:
        region guard_nodes(4096):
            store: Ast::Node.Store[Local] = Ast::Node.Store(guard_nodes)
            in store:
                position: Pos = Pos{line: 1}
                condition: Expr = Expr.Ident("done", position)
                body: darray[Stmt] = [Stmt.Break("outer", position)]
                tokens: darray[Token] = [Token{kind: TokenKind.Ident, line: 1, text: "can"}]
                buffer: mutable darray[u8] = []
                assert not FmtUnparse::fmt_control_guard(buffer, condition, body, [], position, 0, tokens, "")
                assert buffer.count == 0
