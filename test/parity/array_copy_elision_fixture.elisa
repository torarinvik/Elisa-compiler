def clamp(k: i64) -> usize:
    (k & 255).usize()
def rebind(k: i64) -> i64:
    a: mutable i64[256] = zeroed
    a[clamp(k)] <- k
    a <- for i in 0..<clamp(k) |b: mutable i64[256] = a| -> b:
        b[i] <- b[i] + 1
    a[clamp(k + 1)] + a[clamp(k)]
def reads_original(k: i64) -> i64:
    a: mutable i64[256] = zeroed
    a[clamp(k)] <- k
    a <- for i in 0..<clamp(k) |b: mutable i64[256] = a| -> b:
        b[i] <- a[clamp(k)] + i.i64()
        b[clamp(k)] <- b[clamp(k)] + 1
    a[clamp(k + 1)] + a[clamp(k)]
def early_out(k: i64) -> i64:
    a: mutable i64[256] = zeroed
    a[clamp(k)] <- k
    i: mutable usize = 0
    b: mutable i64[256] = a
    while i < clamp(k):
        b[i] <- b[i] + 7
        if b[clamp(k)] > 5: return a[clamp(k)]
        i <- i + 1
    a <- b
    a[clamp(k)]
def conditional_back(k: i64) -> i64:
    a: mutable i64[256] = zeroed
    a[clamp(k)] <- k
    b: mutable i64[256] = a
    b[clamp(k)] <- b[clamp(k)] + 10
    if k > 3:
        a <- b
    a[clamp(k)]
def scratch_kept(k: i64) -> i64:
    a: mutable i64[256] = zeroed
    a[clamp(k)] <- k
    b: mutable i64[256] = a
    b[clamp(k)] <- 99
    a <- b
    a[clamp(k)] + b[clamp(k)]
def heap_rebind(k: i64) -> i64:
    a: mutable i64[26625] = zeroed
    a[clamp(k)] <- k
    a <- for i in 0..<clamp(k) |b: mutable i64[26625] = a| -> b:
        b[i] <- b[i] + 3
    a[clamp(k + 1)] + a[clamp(k)]
def heap_reads_original(k: i64) -> i64:
    a: mutable i64[26625] = zeroed
    a[clamp(k)] <- k
    a <- for i in 0..<clamp(k) |b: mutable i64[26625] = a| -> b:
        b[i] <- a[clamp(k)] + 1
    a[clamp(k + 1)] + a[clamp(k)]
def heap_written_between(k: i64) -> i64:
    a: mutable i64[26625] = zeroed
    b: mutable i64[26625] = a
    a[clamp(k)] <- k
    if k > 3:
        b[clamp(k)] <- 5
        a <- b
    a[clamp(k)] + b[clamp(k + 1)]
def forward_source_dead(k: i64) -> i64:
    a: mutable i64[256] = zeroed
    a[clamp(k)] <- k
    b: mutable i64[256] = a
    b[clamp(k + 1)] <- 4
    b[clamp(k)] + b[clamp(k + 1)]
def forward_source_live(k: i64) -> i64:
    a: mutable i64[256] = zeroed
    a[clamp(k)] <- k
    b: mutable i64[256] = a
    b[clamp(k)] <- 4
    a[clamp(k)] + b[clamp(k)]
def forward_in_loop(k: i64) -> i64:
    a: mutable i64[256] = zeroed
    total: mutable i64 = 0
    for j in 0..<clamp(k):
        b: mutable i64[256] = a
        b[j] <- k
        total <- total + b[j] + a[j]
        a[j] <- total
    total
export fn t1(k: i64) -> i64 = rebind
export fn t2(k: i64) -> i64 = reads_original
export fn t3(k: i64) -> i64 = early_out
export fn t4(k: i64) -> i64 = conditional_back
export fn t5(k: i64) -> i64 = scratch_kept
export fn t6(k: i64) -> i64 = heap_rebind
export fn t7(k: i64) -> i64 = heap_reads_original
export fn t8(k: i64) -> i64 = heap_written_between
export fn t9(k: i64) -> i64 = forward_source_dead
export fn t10(k: i64) -> i64 = forward_source_live
export fn t11(k: i64) -> i64 = forward_in_loop
