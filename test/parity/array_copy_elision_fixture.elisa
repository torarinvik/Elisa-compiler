def clamp(k: i64) -> usize:
    (k & 255).usize()
def rebind(k: i64) -> i64:
    a: mutable i64[256] = zeroed
    a[clamp(k)] <- k
    a <- for i in 0..<clamp(k) |b: mutable i64[256] = a| -> b:
        b[i] <- b[i] + 1
    a[clamp(k + 1)] + a[clamp(k)]
def reads_original(k: i64) -> i64:
    a: mutable i64[256] = zeroed
    a[clamp(k)] <- k
    a <- for i in 0..<clamp(k) |b: mutable i64[256] = a| -> b:
        b[i] <- a[clamp(k)] + i.i64()
        b[clamp(k)] <- b[clamp(k)] + 1
    a[clamp(k + 1)] + a[clamp(k)]
def early_out(k: i64) -> i64:
    a: mutable i64[256] = zeroed
    a[clamp(k)] <- k
    i: mutable usize = 0
    b: mutable i64[256] = a
    while i < clamp(k):
        b[i] <- b[i] + 7
        if b[clamp(k)] > 5: return a[clamp(k)]
        i <- i + 1
    a <- b
    a[clamp(k)]
def conditional_back(k: i64) -> i64:
    a: mutable i64[256] = zeroed
    a[clamp(k)] <- k
    b: mutable i64[256] = a
    b[clamp(k)] <- b[clamp(k)] + 10
    if k > 3:
        a <- b
    a[clamp(k)]
def scratch_kept(k: i64) -> i64:
    a: mutable i64[256] = zeroed
    a[clamp(k)] <- k
    b: mutable i64[256] = a
    b[clamp(k)] <- 99
    a <- b
    a[clamp(k)] + b[clamp(k)]
export fn t1(k: i64) -> i64 = rebind
export fn t2(k: i64) -> i64 = reads_original
export fn t3(k: i64) -> i64 = early_out
export fn t4(k: i64) -> i64 = conditional_back
export fn t5(k: i64) -> i64 = scratch_kept
