include "../../src/parser/parser.elisa"
using Ast
using Bytes

module Semantic:
    public:
        const PRIOR_KEY_CONTROL_CONTEXT: u32 = 1

include "../../src/semantic/incremental_function_facts.elisa"

extend Semantic:
    public:
        def incremental_prior_key_index_control() -> i64:
            can Memory.Allocate, Abort.Panic:
                previous: mutable IncrementalSemanticSnapshot = incremental_empty_snapshot()
                previous.bytes <- [97, 98, 97, 99]
                for row in 0..<4 |previous|:
                    previous.functions.push(IncrementalFunctionFactRecord{key_start: row, key_length: 1, body_start: 0, body_length: 0, body_hash: 0, direct_fact_start: 0, direct_fact_count: 0, cacheable: false, matched_previous: false, reject_reason: IncrementalRejectReason.None})
                queries: darray[u8] = [97, 98, 99, 100]
                index: mutable IncrementalPriorKeyIndex = ifc_prior_key_index(previous)
                assert ifc_prior_index(previous, queries, 0, 1, index) == 0
                assert ifc_prior_index(previous, queries, 1, 1, index) == 1
                assert ifc_prior_index(previous, queries, 2, 1, index) == 3
                assert ifc_prior_index(previous, queries, 3, 1, index) == 4
                # Force every query into one collision chain, including a missing key.
                index.next <- [1, 2, 3, 4]
                for bucket in 0..<index.heads.count |index|:
                    index.heads[bucket] <- 0
                assert ifc_prior_index(previous, queries, 0, 1, index) == 0
                assert ifc_prior_index(previous, queries, 1, 1, index) == 1
                assert ifc_prior_index(previous, queries, 2, 1, index) == 3
                assert ifc_prior_index(previous, queries, 3, 1, index) == 4
                # Reordering must change row indices without changing key identity.
                previous.functions <- [previous.functions[3], previous.functions[1], previous.functions[2], previous.functions[0]]
                reordered: IncrementalPriorKeyIndex = ifc_prior_key_index(previous)
                assert ifc_prior_index(previous, queries, 0, 1, reordered) == 2
                assert ifc_prior_index(previous, queries, 1, 1, reordered) == 1
                assert ifc_prior_index(previous, queries, 2, 1, reordered) == 0
                assert ifc_prior_index(previous, queries, 3, 1, reordered) == 4
                # Public collection can receive an in-memory snapshot before codec validation.
                previous.functions[0] <- IncrementalFunctionFactRecord{key_start: 999, key_length: 1, body_start: 0, body_length: 0, body_hash: 0, direct_fact_start: 0, direct_fact_count: 0, cacheable: false, matched_previous: false, reject_reason: IncrementalRejectReason.None}
                previous.functions[1] <- IncrementalFunctionFactRecord{key_start: 1, key_length: 999, body_start: 0, body_length: 0, body_hash: 0, direct_fact_start: 0, direct_fact_count: 0, cacheable: false, matched_previous: false, reject_reason: IncrementalRejectReason.None}
                malformed: IncrementalPriorKeyIndex = ifc_prior_key_index(previous)
                assert ifc_prior_index(previous, queries, 0, 1, malformed) == 2
                assert ifc_prior_index(previous, queries, 1, 1, malformed) == 4
                assert ifc_prior_index(previous, queries, 2, 1, malformed) == 4
                assert ifc_prior_index(previous, queries, 999, 1, malformed) == 4
                assert ifc_prior_index(previous, queries, 0, 999, malformed) == 4
                empty: IncrementalSemanticSnapshot = incremental_empty_snapshot()
                empty_index: IncrementalPriorKeyIndex = ifc_prior_key_index(empty)
                assert ifc_prior_index(empty, queries, 0, 1, empty_index) == 0
                return 0

def main() -> i64:
    return Semantic::incremental_prior_key_index_control() can Global{Read,Write}, Memory.Allocate, Abort.Panic
