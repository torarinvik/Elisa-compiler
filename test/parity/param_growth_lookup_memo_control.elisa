include "../../src/semantic/semantic.elisa"

extend Semantic:
    public:
        # Independent test oracle: reproduce the original flat-row scan and append rules.
        def pgs_callee_fields_scan(callee: sview, position: usize, rows: darray[sview]&, fields: mutable darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                tag: sview = vro_tag(position)
                return false if tag == "" or callee == ""
                known: mutable bool = false
                row: mutable usize = 0
                while row + 2 < rows.count:
                    if rows[row] == callee and rows[row + 1] == tag:
                        if rows[row + 2] == "[k]":
                            known <- true
                        else:
                            pgs_push(rows[row + 2], fields)
                    row <- row + pgs_row()
                return known

        def test_pgs_fixpoint_dependency_chain() -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                # Each caller is visited after its callee. Round 0 discovers `leaf`, round 1
                # propagates to `middle`, and round 2 propagates to `top`; the final rows
                # must match the transitive summaries in declaration order.
                source: static u8& = "def leaf[@r](items: mutable darray[i64]& @r) -> void can[Memory.Allocate, Abort.Panic]:\n    items.push(1)\ndef middle[@r](items: mutable darray[i64]& @r) -> void can[Memory.Allocate, Abort.Panic]:\n    leaf(items)\ndef top[@r](items: mutable darray[i64]& @r) -> void can[Memory.Allocate, Abort.Panic]:\n    middle(items)\n"
                tokens: darray[Token] = frontend_tokenize_with_length(source, source, 317)
                file: Ast::File = frontend_parser_parse_file(source, tokens) can Global{Read,Write}
                assert file.errors.count == 0
                table: SymbolTable = Semantic::check(file)
                tag: sview = vro_tag(0)
                expected: darray[sview] = ["leaf", tag, "[k]", "leaf", tag, "", "middle", tag, "[k]", "middle", tag, "", "top", tag, "[k]", "top", tag, ""]
                assert table.param_growth_rows.count == expected.count
                for index in 0..<expected.count:
                    assert table.param_growth_rows[index] == expected[index]

        def test_pgs_fixpoint_preserves_order_during_unrelated_growth() -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                # `middle` first learns `b` from `leaf`, after its direct `a` use, so its
                # cached sequence is [b, a]. On the next wave `leaf` learns `a` before its
                # direct `b` use. At that same wave, `noise_two` learns `z`; `middle` must
                # keep its old sequence because its set did not grow.
                source: static u8& = "struct PgsOrderData:\n    a: mutable darray[i64]\n    b: mutable darray[i64]\n    z: mutable darray[i64]\ndef source(data: mutable PgsOrderData&) -> void can[Memory.Allocate, Abort.Panic]:\n    data.a.push(1)\ndef leaf(data: mutable PgsOrderData&) -> void can[Memory.Allocate, Abort.Panic]:\n    source(data)\n    data.b.push(1)\ndef middle(data: mutable PgsOrderData&) -> void can[Memory.Allocate, Abort.Panic]:\n    leaf(data)\n    data.a.push(1)\ndef noise_seed(data: mutable PgsOrderData&) -> void can[Memory.Allocate, Abort.Panic]:\n    data.z.push(1)\ndef noise_one(data: mutable PgsOrderData&) -> void can[Memory.Allocate, Abort.Panic]:\n    noise_seed(data)\ndef noise_two(data: mutable PgsOrderData&) -> void can[Memory.Allocate, Abort.Panic]:\n    noise_one(data)\n"
                source_length: mutable usize = 0
                while source[source_length] != 0 |source_length|:
                    source_length <- source_length + 1
                tokens: darray[Token] = frontend_tokenize_with_length(source, source, source_length)
                file: Ast::File = frontend_parser_parse_file(source, tokens) can Global{Read,Write}
                assert file.errors.count == 0
                table: SymbolTable = Semantic::check(file)
                tag: sview = vro_tag(0)
                expected: darray[sview] = [
                    "source", tag, "[k]", "source", tag, "a",
                    "leaf", tag, "[k]", "leaf", tag, "a", "leaf", tag, "b",
                    "middle", tag, "[k]", "middle", tag, "b", "middle", tag, "a",
                    "noise_seed", tag, "[k]", "noise_seed", tag, "z",
                    "noise_one", tag, "[k]", "noise_one", tag, "z",
                    "noise_two", tag, "[k]", "noise_two", tag, "z",
                ]
                assert table.param_growth_rows.count == expected.count
                for index in 0..<expected.count:
                    assert table.param_growth_rows[index] == expected[index]

        def test_pgs_memo_complete_result() -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                tag: sview = vro_tag(0)
                rows: mutable darray[sview] = ["callee", tag, "[k]", "callee", tag, "left", "callee", tag, "right", "callee", tag, "left", "other", tag, "[k]", "other", tag, "right", "other", tag, "third"]
                prior: mutable PgsPrior = PgsPrior{}
                prior <- pgs_index(rows, prior) can Global{Read,Write}
                prior.collect_looked_up <- true

                # Warm the memo with an accumulator that already contains one result field.
                # A later fresh accumulator must still receive the complete cached result.
                seeded: mutable darray[sview] = ["left", "unrelated"]
                assert pgs_callee_fields("callee", 0, prior, seeded)
                assert seeded.count == 3
                assert seeded[0] == "left" and seeded[1] == "unrelated" and seeded[2] == "right"

                fresh: mutable darray[sview] = []
                expected: mutable darray[sview] = []
                assert pgs_callee_fields_scan("callee", 0, rows, expected)
                assert pgs_callee_fields("callee", 0, prior, fresh)
                assert fresh.count == expected.count
                for index in 0..<fresh.count:
                    assert fresh[index] == expected[index]
                assert prior.looked_up.count == 2

                # A warmed lookup must merge into a nonempty accumulator with the same
                # first-seen ordering and duplicate suppression as the scan oracle.
                hit_seeded: mutable darray[sview] = ["right", "unrelated"]
                assert pgs_callee_fields("callee", 0, prior, hit_seeded)
                assert hit_seeded.count == 3
                assert hit_seeded[0] == "right" and hit_seeded[1] == "unrelated" and hit_seeded[2] == "left"

                # A cached hash key still checks the exact callee and position tag.
                prior.lookup_heads <- prior.lookup_heads.put(pgs_key("other", tag), 0) can Global{Read,Write}
                other: mutable darray[sview] = []
                other_expected: mutable darray[sview] = []
                assert pgs_callee_fields_scan("other", 0, rows, other_expected)
                assert pgs_callee_fields("other", 0, prior, other)
                # `right` is also in the earlier callee cache segment, so it must still be
                # present in this key's result and not be suppressed by cross-key storage.
                assert other.count == other_expected.count and other.count == 2
                assert other[0] == "right" and other[1] == "third"

                # A later key's cached segment also merges into an existing output in order.
                other_seeded: mutable darray[sview] = ["third", "unrelated"]
                other_seeded_expected: mutable darray[sview] = ["third", "unrelated"]
                assert pgs_callee_fields_scan("other", 0, rows, other_seeded_expected)
                assert pgs_callee_fields("other", 0, prior, other_seeded)
                assert other_seeded.count == other_seeded_expected.count and other_seeded.count == 3
                assert other_seeded[0] == "third" and other_seeded[1] == "unrelated" and other_seeded[2] == "right"
                assert prior.lookup_callees.count == 2

                # Force a two-entry bucket chain: the head has another exact key, and
                # lookup_next must reach the matching callee entry behind it.
                assert prior.lookup_callees.count == 2 and prior.lookup_next.count == 2
                assert prior.lookup_callees[0] == "callee" and prior.lookup_callees[1] == "other"
                prior.lookup_next[1] <- 0
                prior.lookup_heads <- prior.lookup_heads.put(pgs_key("callee", tag), 1) can Global{Read,Write}
                chained: mutable darray[sview] = []
                assert pgs_callee_fields("callee", 0, prior, chained)
                assert chained.count == 2 and chained[0] == "left" and chained[1] == "right"

                second_tag: sview = vro_tag(1)
                prior.lookup_heads <- prior.lookup_heads.put(pgs_key("callee", second_tag), 0) can Global{Read,Write}
                second_position: mutable darray[sview] = []
                assert not pgs_callee_fields("callee", 1, prior, second_position)
                assert second_position.count == 0
                assert not pgs_callee_fields("callee", 1, prior, second_position)
                assert second_position.count == 0

                missing: mutable darray[sview] = []
                assert not pgs_callee_fields("missing", 0, prior, missing)
                assert not pgs_callee_fields("missing", 0, prior, missing)
                assert missing.count == 0

                # Each fixed-point wave gets a fresh memo and sees the new prior rows.
                next_rows: mutable darray[sview] = ["callee", tag, "[k]", "callee", tag, "changed"]
                next_prior: mutable PgsPrior = PgsPrior{}
                next_prior <- pgs_index(next_rows, next_prior) can Global{Read,Write}
                next_fields: mutable darray[sview] = []
                assert pgs_callee_fields("callee", 0, next_prior, next_fields)
                assert next_fields.count == 1 and next_fields[0] == "changed"

        def test_pgs_memo_aliased_output() -> void:
            can Memory.Allocate, Abort.Panic, Global{Read,Write}:
                tag: sview = vro_tag(0)
                rows: mutable darray[sview] = ["aliased", tag, "[k]", "aliased", tag, "left", "aliased", tag, "right"]
                prior: mutable PgsPrior = PgsPrior{}
                prior <- pgs_index(rows, prior) can Global{Read,Write}
                # Explicitly permitted overlap must preserve the baseline's post-memo check.
                known: bool = pgs_callee_fields("aliased", 0, prior, prior.lookup_fields) can Unsafe.Alias
                assert known
                assert prior.lookup_fields.count == 2
                assert prior.lookup_fields[0] == "left" and prior.lookup_fields[1] == "right"
                assert prior.lookup_field_counts.count == 1 and prior.lookup_field_counts[0] == 2

def main() -> i64:
    can Memory.Allocate, Abort.Panic, Global{Read,Write}:
        Semantic::test_pgs_memo_complete_result()
        Semantic::test_pgs_memo_aliased_output() can Unsafe.Alias
        Semantic::test_pgs_fixpoint_dependency_chain()
        Semantic::test_pgs_fixpoint_preserves_order_during_unrelated_growth()
    return 0
