include "../../src/semantic/semantic.elisa"
include "../../src/semantic/incremental_semantic_options.elisa"
using Ast

def incremental_bytes_equal(left: darray[u8]&, right: darray[u8]&) -> bool:
    false return if left.count != right.count
    for index in 0..<left.count:
        false return if left[index] != right[index]
    return true


def incremental_diagnostic_equal(left: Semantic::Diagnostic, right: Semantic::Diagnostic) -> bool:
    false return if Semantic::diagnostic_severity(left) != Semantic::diagnostic_severity(right)
    false return if left.line != right.line or left.kind != right.kind
    false return if left.pos.line != right.pos.line or left.pos.column != right.pos.column or left.pos.end_line != right.pos.end_line or left.pos.end_column != right.pos.end_column
    return incremental_bytes_equal(Semantic::diagnostic_message(left), Semantic::diagnostic_message(right))


def incremental_diagnostics_equal(left: darray[Semantic::Diagnostic]&, right: darray[Semantic::Diagnostic]&) -> bool:
    false return if left.count != right.count
    for index in 0..<left.count |left, right|:
        false return if not incremental_diagnostic_equal(left[index], right[index])
    return true


def incremental_rows_equal(left: Semantic::SymbolTable&, right: Semantic::SymbolTable&) -> bool:
    false return if left.effect_canonical_module_parent.count != right.effect_canonical_module_parent.count
    false return if left.effect_canonical_module_name.count != right.effect_canonical_module_name.count
    false return if left.effect_canonical_function_name.count != right.effect_canonical_function_name.count
    false return if left.effect_canonical_function_scope.count != right.effect_canonical_function_scope.count
    false return if left.effect_canonical_function_offset.count != right.effect_canonical_function_offset.count
    false return if left.effect_canonical_function_row_start.count != right.effect_canonical_function_row_start.count
    false return if left.effect_canonical_function_row_count.count != right.effect_canonical_function_row_count.count
    false return if left.effect_canonical_refs.count != right.effect_canonical_refs.count
    false return if left.effect_canonical_row_function.count != right.effect_canonical_row_function.count
    false return if left.effect_canonical_row_ref.count != right.effect_canonical_row_ref.count
    false return if left.effect_canonical_row_mandatory.count != right.effect_canonical_row_mandatory.count
    false return if left.effect_canonical_row_scope.count != right.effect_canonical_row_scope.count
    for index in 0..<left.effect_canonical_module_parent.count |left, right|:
        false return if left.effect_canonical_module_parent[index] != right.effect_canonical_module_parent[index]
    for index in 0..<left.effect_canonical_module_name.count |left, right|:
        false return if left.effect_canonical_module_name[index] != right.effect_canonical_module_name[index]
    for index in 0..<left.effect_canonical_function_name.count |left, right|:
        false return if left.effect_canonical_function_name[index] != right.effect_canonical_function_name[index]
        false return if left.effect_canonical_function_scope[index] != right.effect_canonical_function_scope[index]
        false return if left.effect_canonical_function_offset[index] != right.effect_canonical_function_offset[index]
        false return if left.effect_canonical_function_row_start[index] != right.effect_canonical_function_row_start[index]
        false return if left.effect_canonical_function_row_count[index] != right.effect_canonical_function_row_count[index]
    for index in 0..<left.effect_canonical_refs.count |left, right|:
        false return if left.effect_canonical_refs[index] != right.effect_canonical_refs[index]
    for index in 0..<left.effect_canonical_row_function.count |left, right|:
        false return if left.effect_canonical_row_function[index] != right.effect_canonical_row_function[index]
        false return if left.effect_canonical_row_ref[index] != right.effect_canonical_row_ref[index]
        false return if left.effect_canonical_row_mandatory[index] != right.effect_canonical_row_mandatory[index]
        false return if left.effect_canonical_row_scope[index] != right.effect_canonical_row_scope[index]
    return true


def incremental_count_matched_empty(snapshot: Semantic::IncrementalSemanticSnapshot&) -> u64:
    count: mutable u64 = 0
    for index in 0..<snapshot.functions.count |count, snapshot|:
        record: Semantic::IncrementalFunctionFactRecord = snapshot.functions[index]
        count <- count + 1 if record.cacheable and record.matched_previous and record.direct_fact_count == 0
    return count


def incremental_ga_reuse_control() -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "global mutable counter: i64 = 0\ndef pure_a() -> i64:\n    return 7\ndef pure_b() -> i64:\n    return 9\ndef read_counter() -> i64:\n    can Global.Read:\n        return counter\ndef write_counter() -> void:\n    can Global.Write:\n        counter <- 8\ndef ungated_read() -> i64:\n    return counter\n"
        source_length: usize = 289
        tokens: darray[Lexer::Token] = frontend_tokenize_with_length(source, source, source_length)
        file: Ast::File = frontend_parser_parse_file(source, tokens) can Global{Read,Write}
        assert file.errors.count == 0
        options: Semantic::IncrementalSemanticOptions = Semantic::incremental_semantic_options_from_values(false, false, false, false, false, false, false, false, false, false, 64, false, true, false)
        options_fingerprint: u64 = Semantic::incremental_semantic_options_fingerprint(options)
        empty: Semantic::IncrementalSemanticSnapshot = Semantic::incremental_empty_snapshot()
        cold_snapshot: Semantic::IncrementalSemanticSnapshot = Semantic::incremental_collect_function_facts(file, source, source_length, tokens, "/incremental/ga-control.elisa", Semantic::INCREMENTAL_SEMANTIC_ENGINE_VERSION, options_fingerprint, empty, false)
        encoded: Semantic::IncrementalSnapshotEncodeResult = Semantic::incremental_encode_snapshot(cold_snapshot)
        assert encoded.valid
        decoded: Semantic::IncrementalSnapshotDecodeResult = Semantic::incremental_decode_snapshot(encoded.bytes, Semantic::INCREMENTAL_SEMANTIC_ENGINE_VERSION, options_fingerprint)
        assert decoded.valid
        warm_snapshot: Semantic::IncrementalSemanticSnapshot = Semantic::incremental_collect_function_facts(file, source, source_length, tokens, "/incremental/ga-control.elisa", Semantic::INCREMENTAL_SEMANTIC_ENGINE_VERSION, options_fingerprint, decoded.snapshot, true)
        assert warm_snapshot.surface_compatible
        assert incremental_count_matched_empty(warm_snapshot) == 2
        assert warm_snapshot.bodies_matched == 5
        assert warm_snapshot.bodies_visited == 5

        cold_diagnostics: mutable darray[Semantic::Diagnostic] = []
        cold_skips: mutable u64 = 0
        Semantic::check_full_diagnostics(file, &cold_diagnostics, false, false, false, false, false, false, false, false, false, false, 64, false, true, false) can Global{Read,Write}
        warm_diagnostics: mutable darray[Semantic::Diagnostic] = []
        warm_skips: mutable u64 = 0
        Semantic::check_full_diagnostics_with_incremental_snapshot(file, &warm_diagnostics, false, false, false, false, false, false, false, false, false, false, 64, false, true, false, &warm_snapshot, &warm_skips) can Global{Read,Write}
        assert cold_skips == 0
        assert warm_skips == 4
        assert incremental_diagnostics_equal(cold_diagnostics, warm_diagnostics)

        cold_rows: Semantic::SymbolTable = Semantic::check_full(file, false, false, false, false, false, false, false, false, false, false, 64, false, true, false) can Global{Read,Write}
        warm_rows: mutable Semantic::SymbolTable = Semantic::SymbolTable()
        rows_skips: mutable u64 = 0
        warm_rows <- Semantic::check_full_into_with_incremental_snapshot(file, warm_rows, false, false, false, false, false, false, false, false, false, false, 64, false, true, false, &warm_snapshot, &rows_skips) can Global{Read,Write}
        assert rows_skips == 4
        assert incremental_rows_equal(cold_rows, warm_rows)
        assert warm_rows.effect_canonical_function_name.count > 0
        assert warm_rows.effect_canonical_row_function.count > 0
        return 0


def main() -> i64:
    return incremental_ga_reuse_control() can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global{Read,Write}
