include "../../src/semantic/semantic.elisa"
using Ast

def incremental_bytes_equal(left: darray[u8]&, right: darray[u8]&) -> bool:
    return false if left.count != right.count
    for index in 0..<left.count:
        return false if left[index] != right[index]
    return true


def incremental_diagnostic_equal(left: Semantic::Diagnostic, right: Semantic::Diagnostic) -> bool:
    return false if:
        Semantic::diagnostic_severity(left) != Semantic::diagnostic_severity(right)
        left.line != right.line or left.kind != right.kind
        left.pos.line != right.pos.line or left.pos.column != right.pos.column or left.pos.end_line != right.pos.end_line or left.pos.end_column != right.pos.end_column
    return incremental_bytes_equal(Semantic::diagnostic_message(left), Semantic::diagnostic_message(right))


def incremental_diagnostics_equal(left: darray[Semantic::Diagnostic]&, right: darray[Semantic::Diagnostic]&) -> bool:
    return false if left.count != right.count
    for index in 0..<left.count |left, right|:
        return false if not incremental_diagnostic_equal(left[index], right[index])
    return true


def incremental_rows_equal(left: Semantic::SymbolTable&, right: Semantic::SymbolTable&) -> bool:
    return false if:
        left.effect_canonical_module_parent.count != right.effect_canonical_module_parent.count
        left.effect_canonical_module_name.count != right.effect_canonical_module_name.count
        left.effect_canonical_function_name.count != right.effect_canonical_function_name.count
        left.effect_canonical_function_scope.count != right.effect_canonical_function_scope.count
        left.effect_canonical_function_offset.count != right.effect_canonical_function_offset.count
        left.effect_canonical_function_row_start.count != right.effect_canonical_function_row_start.count
        left.effect_canonical_function_row_count.count != right.effect_canonical_function_row_count.count
        left.effect_canonical_refs.count != right.effect_canonical_refs.count
        left.effect_canonical_row_function.count != right.effect_canonical_row_function.count
        left.effect_canonical_row_ref.count != right.effect_canonical_row_ref.count
        left.effect_canonical_row_mandatory.count != right.effect_canonical_row_mandatory.count
        left.effect_canonical_row_scope.count != right.effect_canonical_row_scope.count
    for index in 0..<left.effect_canonical_module_parent.count |left, right|:
        return false if left.effect_canonical_module_parent[index] != right.effect_canonical_module_parent[index]
    for index in 0..<left.effect_canonical_module_name.count |left, right|:
        return false if left.effect_canonical_module_name[index] != right.effect_canonical_module_name[index]
    for index in 0..<left.effect_canonical_function_name.count |left, right|:
        return false if:
            left.effect_canonical_function_name[index] != right.effect_canonical_function_name[index]
            left.effect_canonical_function_scope[index] != right.effect_canonical_function_scope[index]
            left.effect_canonical_function_offset[index] != right.effect_canonical_function_offset[index]
            left.effect_canonical_function_row_start[index] != right.effect_canonical_function_row_start[index]
            left.effect_canonical_function_row_count[index] != right.effect_canonical_function_row_count[index]
    for index in 0..<left.effect_canonical_refs.count |left, right|:
        return false if left.effect_canonical_refs[index] != right.effect_canonical_refs[index]
    for index in 0..<left.effect_canonical_row_function.count |left, right|:
        return false if:
            left.effect_canonical_row_function[index] != right.effect_canonical_row_function[index]
            left.effect_canonical_row_ref[index] != right.effect_canonical_row_ref[index]
            left.effect_canonical_row_mandatory[index] != right.effect_canonical_row_mandatory[index]
            left.effect_canonical_row_scope[index] != right.effect_canonical_row_scope[index]
    return true


def incremental_has_effect_ref(table: Semantic::SymbolTable&, function_name: sview, effect_ref: sview) -> bool:
    for function_index in 0..<table.effect_canonical_function_name.count |table|:
        if table.effect_canonical_function_name[function_index] == function_name:
            start: usize = table.effect_canonical_function_row_start[function_index]
            end: usize = start + table.effect_canonical_function_row_count[function_index]
            for row in start..<end |table, effect_ref|:
                ref_index: usize = table.effect_canonical_row_ref[row]
                return true if table.effect_canonical_refs[ref_index] == effect_ref
    return false


def incremental_count_matched_empty(snapshot: Semantic::IncrementalSemanticSnapshot&) -> u64:
    count: mutable u64 = 0
    for index in 0..<snapshot.functions.count |count, snapshot|:
        record: Semantic::IncrementalFunctionFactRecord = snapshot.functions[index]
        count <- count + 1 if record.cacheable and record.matched_previous and record.direct_fact_count == 0
    return count


def incremental_count_direct_call_only(snapshot: Semantic::IncrementalSemanticSnapshot&) -> u64:
    count: mutable u64 = 0
    for record_index in 0..<snapshot.functions.count |count, snapshot|:
        record: Semantic::IncrementalFunctionFactRecord = snapshot.functions[record_index]
        if record.cacheable and record.direct_fact_count > 0 and record.direct_fact_start <= snapshot.direct_facts.count and record.direct_fact_count <= snapshot.direct_facts.count - record.direct_fact_start:
            direct_call_only: mutable bool = true
            for relative in 0..<record.direct_fact_count |direct_call_only, record_index, relative, snapshot|:
                fact: Semantic::IncrementalDirectFact = snapshot.direct_facts[record.direct_fact_start + relative]
                direct_call_only <- false if fact.owner != record_index or fact.kind != Semantic::IncrementalFactKind.DirectCall or fact.active_grant_count != 0
            count <- count + 1 if direct_call_only
    return count


def incremental_ga_reuse_control() -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "global mutable counter: i64 = 0\ndef pure_a() -> i64:\n    return 7\ndef pure_b() -> i64:\n    return 9\ndef call_pure() -> i64:\n    return pure_a()\ndef read_counter() -> i64:\n    can Global.Read:\n        return counter\ndef write_counter() -> void:\n    can Global.Write:\n        counter <- 8\ndef ungated_read() -> i64:\n    return counter\n"
        source_length: usize = 333
        tokens: darray[Lexer::Token] = frontend_tokenize_with_length(source, source, source_length)
        file: Ast::File = frontend_parser_parse_file(source, tokens) can Global{Read,Write}
        assert file.errors.count == 0
        options: Semantic::IncrementalSemanticOptions = Semantic::incremental_semantic_options_from_values(false, false, false, false, false, false, false, false, false, false, 64, true, true, false)
        options_fingerprint: u64 = Semantic::incremental_semantic_options_fingerprint(options)
        options_key: mutable darray[u8] = []
        assert Semantic::incremental_semantic_options_encode(options, &options_key)
        empty: Semantic::IncrementalSemanticSnapshot = Semantic::incremental_empty_snapshot()
        cold_snapshot: Semantic::IncrementalSemanticSnapshot = Semantic::incremental_collect_function_facts(file, source, source_length, tokens, "/incremental/ga-control.elisa", Semantic::INCREMENTAL_SEMANTIC_ENGINE_VERSION, options_fingerprint, options_key, empty, false)
        encoded: Semantic::IncrementalSnapshotEncodeResult = Semantic::incremental_encode_snapshot(cold_snapshot)
        assert encoded.valid
        decoded: Semantic::IncrementalSnapshotDecodeResult = Semantic::incremental_decode_snapshot(encoded.bytes, Semantic::INCREMENTAL_SEMANTIC_ENGINE_VERSION, options_fingerprint, options_key)
        assert decoded.valid
        warm_snapshot: Semantic::IncrementalSemanticSnapshot = Semantic::incremental_collect_function_facts(file, source, source_length, tokens, "/incremental/ga-control.elisa", Semantic::INCREMENTAL_SEMANTIC_ENGINE_VERSION, options_fingerprint, options_key, decoded.snapshot, true)
        assert warm_snapshot.surface_compatible
        assert incremental_count_matched_empty(warm_snapshot) == 2
        assert incremental_count_direct_call_only(warm_snapshot) == 1
        assert warm_snapshot.bodies_matched == 4
        assert warm_snapshot.bodies_visited == 6

        cold_diagnostics: mutable darray[Semantic::Diagnostic] = []
        cold_skips: mutable u64 = 0
        cold_effect_source_skips: mutable u64 = 0
        cold_ungranted_panic_skips: mutable u64 = 0
        cold_global_permission_axis_skips: mutable u64 = 0
        Semantic::check_full_diagnostics_with_incremental_snapshot(file, &cold_diagnostics, false, false, false, false, false, false, false, false, false, false, 64, true, true, false, &empty, &cold_skips, &cold_effect_source_skips, &cold_ungranted_panic_skips, &cold_global_permission_axis_skips) can Global{Read,Write}
        warm_diagnostics: mutable darray[Semantic::Diagnostic] = []
        warm_skips: mutable u64 = 0
        warm_effect_source_skips: mutable u64 = 0
        warm_ungranted_panic_skips: mutable u64 = 0
        warm_global_permission_axis_skips: mutable u64 = 0
        Semantic::check_full_diagnostics_with_incremental_snapshot(file, &warm_diagnostics, false, false, false, false, false, false, false, false, false, false, 64, true, true, false, &warm_snapshot, &warm_skips, &warm_effect_source_skips, &warm_ungranted_panic_skips, &warm_global_permission_axis_skips) can Global{Read,Write}
        assert cold_skips == 0
        assert cold_effect_source_skips == 0
        assert cold_ungranted_panic_skips == 0
        assert cold_global_permission_axis_skips == 0
        # Two empty bodies are skipped in both inference and report passes; the
        # direct-call-only body replays its edge in inference and remains cold for report.
        assert warm_skips == 5
        assert warm_effect_source_skips == 2
        assert warm_ungranted_panic_skips == 2
        # pure_a/pure_b are zero-fact bodies, call_pure projects its DirectCall
        # on both axes, and ungated_read projects Global.Read on both axes.
        assert warm_global_permission_axis_skips == 8
        assert incremental_diagnostics_equal(cold_diagnostics, warm_diagnostics)

        cold_rows: Semantic::SymbolTable = Semantic::check_full(file, false, false, false, false, false, false, false, false, false, false, 64, true, true, false) can Global{Read,Write}
        warm_rows: mutable Semantic::SymbolTable = Semantic::SymbolTable()
        rows_skips: mutable u64 = 0
        rows_effect_source_skips: mutable u64 = 0
        rows_ungranted_panic_skips: mutable u64 = 0
        rows_global_permission_axis_skips: mutable u64 = 0
        warm_rows <- Semantic::check_full_into_with_incremental_snapshot(file, warm_rows, false, false, false, false, false, false, false, false, false, false, 64, true, true, false, &warm_snapshot, &rows_skips, &rows_effect_source_skips, &rows_ungranted_panic_skips, &rows_global_permission_axis_skips) can Global{Read,Write}
        assert rows_skips == 5
        assert rows_effect_source_skips == 2
        assert rows_ungranted_panic_skips == 2
        assert rows_global_permission_axis_skips == 8
        assert incremental_rows_equal(cold_rows, warm_rows)
        assert warm_rows.effect_canonical_function_name.count > 0
        assert warm_rows.effect_canonical_row_function.count > 0
        return 0


def incremental_ga_declared_global_reuse_control() -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "global mutable counter: i64 = 0\ndef declared_reader() -> i64 can[Global.Read]:\n    return 1\ndef through_declared_reader() -> i64:\n    return declared_reader()\ndef declared_writer() -> void can[Global.Write]:\n    return\ndef through_declared_writer() -> void:\n    declared_writer()\nextern foreign_reader() -> i64 can[Global.Read]\ndef through_foreign_reader() -> i64:\n    return foreign_reader()\nextern foreign_writer() -> void can[Global.Write]\ndef through_foreign_writer() -> void:\n    foreign_writer()\n"
        source_length: usize = 502
        tokens: darray[Lexer::Token] = frontend_tokenize_with_length(source, source, source_length)
        file: Ast::File = frontend_parser_parse_file(source, tokens) can Global{Read,Write}
        assert file.errors.count == 0
        options: Semantic::IncrementalSemanticOptions = Semantic::incremental_semantic_options_from_values(false, false, false, false, false, false, false, false, false, false, 64, true, true, false)
        options_fingerprint: u64 = Semantic::incremental_semantic_options_fingerprint(options)
        options_key: mutable darray[u8] = []
        assert Semantic::incremental_semantic_options_encode(options, &options_key)
        empty: Semantic::IncrementalSemanticSnapshot = Semantic::incremental_empty_snapshot()
        cold_snapshot: Semantic::IncrementalSemanticSnapshot = Semantic::incremental_collect_function_facts(file, source, source_length, tokens, "/incremental/ga-declared-row-control.elisa", Semantic::INCREMENTAL_SEMANTIC_ENGINE_VERSION, options_fingerprint, options_key, empty, false)
        encoded: Semantic::IncrementalSnapshotEncodeResult = Semantic::incremental_encode_snapshot(cold_snapshot)
        assert encoded.valid
        decoded: Semantic::IncrementalSnapshotDecodeResult = Semantic::incremental_decode_snapshot(encoded.bytes, Semantic::INCREMENTAL_SEMANTIC_ENGINE_VERSION, options_fingerprint, options_key)
        assert decoded.valid
        warm_snapshot: Semantic::IncrementalSemanticSnapshot = Semantic::incremental_collect_function_facts(file, source, source_length, tokens, "/incremental/ga-declared-row-control.elisa", Semantic::INCREMENTAL_SEMANTIC_ENGINE_VERSION, options_fingerprint, options_key, decoded.snapshot, true)
        assert warm_snapshot.surface_compatible
        # The two in-file wrappers are direct-call-only facts and eligible for replay.
        # Extern declarations do not enter the collector candidate set, so those
        # wrappers stay cold while still exercising their declared Global effects.
        assert incremental_count_direct_call_only(warm_snapshot) == 2

        cold_diagnostics: mutable darray[Semantic::Diagnostic] = []
        cold_skips: mutable u64 = 0
        cold_effect_source_skips: mutable u64 = 0
        cold_ungranted_panic_skips: mutable u64 = 0
        cold_global_permission_axis_skips: mutable u64 = 0
        Semantic::check_full_diagnostics_with_incremental_snapshot(file, &cold_diagnostics, false, false, false, false, false, false, false, false, false, false, 64, true, true, false, &empty, &cold_skips, &cold_effect_source_skips, &cold_ungranted_panic_skips, &cold_global_permission_axis_skips) can Global{Read,Write}
        warm_diagnostics: mutable darray[Semantic::Diagnostic] = []
        warm_skips: mutable u64 = 0
        warm_effect_source_skips: mutable u64 = 0
        warm_ungranted_panic_skips: mutable u64 = 0
        warm_global_permission_axis_skips: mutable u64 = 0
        Semantic::check_full_diagnostics_with_incremental_snapshot(file, &warm_diagnostics, false, false, false, false, false, false, false, false, false, false, 64, true, true, false, &warm_snapshot, &warm_skips, &warm_effect_source_skips, &warm_ungranted_panic_skips, &warm_global_permission_axis_skips) can Global{Read,Write}
        assert cold_skips == 0
        assert cold_effect_source_skips == 0
        assert cold_ungranted_panic_skips == 0
        assert cold_global_permission_axis_skips == 0
        # Two zero-fact declared bodies are skipped twice by authority inference/report;
        # each direct-call-only in-file wrapper replays its edge once during inference.
        assert warm_skips == 6
        assert warm_effect_source_skips == 2
        assert warm_ungranted_panic_skips == 2
        assert warm_global_permission_axis_skips == 8
        assert incremental_diagnostics_equal(cold_diagnostics, warm_diagnostics)

        cold_rows: Semantic::SymbolTable = Semantic::check_full(file, false, false, false, false, false, false, false, false, false, false, 64, true, true, false) can Global{Read,Write}
        warm_rows: mutable Semantic::SymbolTable = Semantic::SymbolTable()
        rows_skips: mutable u64 = 0
        rows_effect_source_skips: mutable u64 = 0
        rows_ungranted_panic_skips: mutable u64 = 0
        rows_global_permission_axis_skips: mutable u64 = 0
        warm_rows <- Semantic::check_full_into_with_incremental_snapshot(file, warm_rows, false, false, false, false, false, false, false, false, false, false, 64, true, true, false, &warm_snapshot, &rows_skips, &rows_effect_source_skips, &rows_ungranted_panic_skips, &rows_global_permission_axis_skips) can Global{Read,Write}
        assert rows_skips == 6
        assert rows_effect_source_skips == 2
        assert rows_ungranted_panic_skips == 2
        assert rows_global_permission_axis_skips == 8
        assert incremental_rows_equal(cold_rows, warm_rows)
        assert incremental_has_effect_ref(warm_rows, "through_declared_reader", "Global.Read")
        assert incremental_has_effect_ref(warm_rows, "through_declared_writer", "Global.Write")
        assert incremental_has_effect_ref(warm_rows, "through_foreign_reader", "Global.Read")
        assert incremental_has_effect_ref(warm_rows, "through_foreign_writer", "Global.Write")
        return 0


def main() -> i64:
    return incremental_ga_reuse_control() + incremental_ga_declared_global_reuse_control() can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global{Read,Write}
