include "../../elisacore_std/native_runtime_support.elisa"

struct ReserveBag:
    values: mutable darray[i64] = []

def reserve_from_inner(values: mutable darray[i64]&, bag: mutable ReserveBag&) -> void:
    can Memory{Allocate,Release}, Abort.Panic:
        callee_scratch: mutable Arena = zeroed
        scratch: mutable Arena& = &callee_scratch
        in scratch:
            values.reserve(128.usize())
            bag.values.reserve(128.usize())
        arena_reset(scratch) can Global{Read,Write}

# The allocation and reallocation must use the destination's declaration arena.
# Qualification must also inspect emitted IR arena operands: reading retired
# region memory can happen to succeed, so native assertions alone are insufficient.
def main() -> i64:
    can Memory{Allocate,Release}, Abort.Panic:
        region owner(4096):
            values: mutable darray[i64] @owner = []
            bag: mutable ReserveBag = ReserveBag{}
            first: mutable Arena = zeroed
            first_ref: mutable Arena& = &first
            in first_ref:
                values.reserve(4.usize())
                bag.values.reserve(4.usize())
                assert values.count == 0.usize()
                assert bag.values.count == 0.usize()
                values.push(19)
                bag.values.push(23)
            arena_reset(first_ref) can Global{Read,Write}
            assert values[0.usize()] == 19
            assert bag.values[0.usize()] == 23

            second: mutable Arena = zeroed
            second_ref: mutable Arena& = &second
            in second_ref:
                # Discarded-result calls take a separate backend path from bare statements.
                _ = values.reserve(64.usize())
                _ = bag.values.reserve(64.usize())
                assert values.count == 1.usize()
                assert bag.values.count == 1.usize()
                assert values.capacity >= 64.usize()
                assert bag.values.capacity >= 64.usize()
                values.push(23)
                bag.values.push(19)
            arena_reset(second_ref) can Global{Read,Write}
            assert values[0.usize()] + values[1.usize()] == 42
            assert bag.values[0.usize()] + bag.values[1.usize()] == 42
            values.reserve(1.usize())
            bag.values.reserve(1.usize())
            assert values.count == 2.usize()
            assert bag.values.count == 2.usize()
            assert values.capacity >= 64.usize()
            assert bag.values.capacity >= 64.usize()
            # The hidden caller arena must also survive a callee-owned scratch region.
            reserve_from_inner(&values, &bag) can Global{Read,Write}
            assert values.capacity >= 128.usize()
            assert bag.values.capacity >= 128.usize()
            assert values[0.usize()] + values[1.usize()] == 42
            assert bag.values[0.usize()] + bag.values[1.usize()] == 42
            return 0
