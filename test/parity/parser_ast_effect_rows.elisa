@test
def test_explicit_empty_function_effect_rows_keep_source_identity() -> void:
    can Memory.Allocate, Abort.Panic, Atomics, Unsafe:
        source: u8& @source = "def omitted() -> i64:\n    return 0\ndef after_result() -> i64 can[]:\n    return 0\ndef after_parameters() can[]:\n    return 0\n"
        file: Ast::File = parse_snippet(source) can Global{Read,Write}
        assert file.errors.count == 0
        effect_marker_count: mutable usize = 0
        omitted_marker_count: mutable usize = 0
        after_result_marker_count: mutable usize = 0
        after_parameters_marker_count: mutable usize = 0
        for annotation in file.enum_annotations |file, effect_marker_count, omitted_marker_count, after_result_marker_count, after_parameters_marker_count|:
            continue if annotation.name != "__function_effect_row_declared"
            continue if annotation.line != 3900000132
            effect_marker_count <- effect_marker_count + 1
            function_marker_count: mutable usize = 0
            for function_marker in file.enum_annotations |file, annotation, function_marker_count|:
                continue if function_marker.name != "__lsp_func_name" or function_marker.owner != annotation.owner
                continue if function_marker.offset != annotation.offset or function_marker.line != annotation.detail_line
                function_marker_count <- function_marker_count + 1
            assert function_marker_count == 1
            if annotation.owner == "omitted":
                omitted_marker_count <- omitted_marker_count + 1
            elif annotation.owner == "after_result":
                after_result_marker_count <- after_result_marker_count + 1
            elif annotation.owner == "after_parameters":
                after_parameters_marker_count <- after_parameters_marker_count + 1
        assert effect_marker_count == 2
        assert omitted_marker_count == 0
        assert after_result_marker_count == 1
        assert after_parameters_marker_count == 1



@test
def test_effect_type_arguments_reject_positional_tuple_types() -> void:
    can Memory.Allocate, Abort.Panic:
        positional: Ast::File = parse_snippet("effect Writer[T]:\n    def write(value: T) -> void\ndef bad() -> void can[Writer[(i64, i64)]]:\n    pass\n") can Global{Read,Write}
        named: Ast::File = parse_snippet("effect Writer[T]:\n    def write(value: T) -> void\ndef good() -> void can[Writer[(left: i64, right: i64)]]:\n    pass\n") can Global{Read,Write}
        bounded: Ast::File = parse_snippet("effect Reader[T]:\n    def read(value: T) -> void\neffect Writer[T]:\n    def write(value: T) -> void\ndef bad() -> void can[Reader[i64], Writer[(i64, i64)]]:\n    pass\n") can Global{Read,Write}
        assert positional.errors.count > 0
        assert named.errors.count == 0
        assert bounded.errors.count == 1



@test
def test_owned_positional_tuple_type_is_rejected() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("def take(value: owned (i64, i64)) -> void:\n    pass\n") can Global{Read,Write}
        assert file.errors.count > 0



@test
def test_tuple_literals_in_where_predicates_are_not_type_arguments() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("def check(value: i64 where accepts(value, (1, 2))) -> void:\n    pass\n") can Global{Read,Write}
        assert file.errors.count == 0
