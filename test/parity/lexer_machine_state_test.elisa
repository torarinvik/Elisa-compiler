include "../fixtures/lexer/frontend_lexer.elisa"

@test
def lexer_number_state_classification() -> void:
    can Memory.Allocate, Abort.Panic:
        source: static u8& = "10x 0x0x1\n"
        tokens: darray[Token] = frontend_tokenize_literal(source)
        expected: TokenKind[6] = [TokenKind.IntLit, TokenKind.Ident, TokenKind.HexLit, TokenKind.Ident, TokenKind.Newline, TokenKind.Eof]
        assert frontend_expect_kinds(tokens, &expected[0], 6)
        assert frontend_expect_text(source, tokens, 0, "10")
        assert frontend_expect_text(source, tokens, 1, "x")
        assert frontend_expect_text(source, tokens, 2, "0x0")
        assert frontend_expect_text(source, tokens, 3, "x1")


@test
def lexer_fstring_excludes_closing_quote() -> void:
    can Memory.Allocate, Abort.Panic:
        source: static u8& = "f\"closed\" f\"prefix {\"inner\"} suffix\"\n"
        tokens: darray[Token] = frontend_tokenize_literal(source)
        expected: TokenKind[4] = [TokenKind.FString, TokenKind.FString, TokenKind.Newline, TokenKind.Eof]
        assert frontend_expect_kinds(tokens, &expected[0], 4)
        assert frontend_expect_text(source, tokens, 0, "closed")
        assert frontend_expect_text(source, tokens, 1, "prefix {\"inner\"} suffix")

@test
def lexer_numeric_separator_boundaries() -> void:
    can Memory.Allocate, Abort.Panic:
        source: static u8& = "1_000u64 0xffff_ffffu64 1_ 1__2 0x_f 0xf_ 1_a\n"
        tokens: darray[Token] = frontend_tokenize_literal(source)
        expected: TokenKind[14] = [TokenKind.IntLit, TokenKind.HexLit, TokenKind.IntLit, TokenKind.Ident, TokenKind.IntLit, TokenKind.Ident, TokenKind.HexLit, TokenKind.Ident, TokenKind.HexLit, TokenKind.Ident, TokenKind.IntLit, TokenKind.Ident, TokenKind.Newline, TokenKind.Eof]
        assert frontend_expect_kinds(tokens, &expected[0], 14)
        assert frontend_expect_text(source, tokens, 0, "1_000")
        assert frontend_expect_text(source, tokens, 1, "0xffff_ffff")
        assert frontend_expect_text(source, tokens, 3, "_")
        assert frontend_expect_text(source, tokens, 5, "__2")
        assert frontend_expect_text(source, tokens, 7, "_f")
        assert frontend_expect_text(source, tokens, 9, "_")
        assert frontend_expect_text(source, tokens, 11, "_a")

@test
def lexer_numeric_suffix_rejects_nonexistent_widths() -> void:
    can Memory.Allocate, Abort.Panic:
        source: static u8& = "0u12 0u14 0u34 0u36 0u62 0u66 0i12 0i14 0i34 0i36 0i62 0i66 0u128 0i 0f16 0f66 0u64name\n"
        tokens: darray[Token] = frontend_tokenize_literal(source)
        assert tokens.count == 36
        for token in tokens |token|:
            assert not token.flags.has_suffix
