include "../../src/backend/codegen.elisa"

extend Backend:
    private:
        const INDEX_TEST_ARITIES: usize = 5
        const INDEX_TEST_LINE_LIMIT: u32 = 170

        def index_test_append(fns: mutable FnTable&, name: sview, owner: sview, arity: usize, line: u32) -> void can[Abort.Panic, Memory.Allocate]:
            fns.names.push(name)
            fns.owners.push(owner)
            fns.param_count.push(arity)
            fns.lines.push(line)
            fns.is_error.push(fns.names.count % 2 == 0)
            fns.returns.push(ValueType{kind: TypeKind.Signed, bits: line})

        def index_test_query(fns: FnTable&, owner: sview, name: sview) -> void can[Abort.Panic]:
            expected: mutable i64 = -1
            cursor: mutable i64 = first_function_named(fns, name)
            for index in 0..<fns.names.count |expected, cursor, fns, owner, name|:
                if fns.names[index] == name:
                    assert cursor == index.i64()
                    cursor <- next_function_named(fns, name, cursor)
                    expected <- index.i64() if expected < 0 and fns.owners[index] == owner
            assert cursor == -1
            assert function_index_of(fns, owner, name) == expected
            if expected >= 0:
                assert function_is_error(fns, owner, name) == fns.is_error[expected.usize()]
                assert lookup_return_type(fns, owner, name).bits == fns.returns[expected.usize()].bits
            else:
                assert not function_is_error(fns, owner, name)
                assert lookup_return_type(fns, owner, name).kind == TypeKind.Unmodeled
            for arity in 0..<INDEX_TEST_ARITIES |fns, owner, name|:
                match_index: mutable i64 = -1
                for index in 0..<fns.names.count |match_index, fns, owner, name, arity|:
                    if fns.names[index] == name and fns.owners[index] == owner and fns.param_count[index] == arity:
                        match_index <- index.i64()
                        break
                assert function_index_of_arity(fns, owner, name, arity) == match_index
            for line in 0..<INDEX_TEST_LINE_LIMIT |fns, owner, name|:
                match_index: mutable i64 = -1
                for index in 0..<fns.names.count |match_index, fns, owner, name, line|:
                    if fns.names[index] == name and fns.owners[index] == owner and fns.lines[index] == line:
                        match_index <- index.i64()
                        break
                assert function_index_of_line(fns, owner, name, line) == match_index

        def index_test_all(fns: FnTable&) -> void can[Abort.Panic, Memory.Allocate]:
            owners: darray[sview] = ["", "A", "B", "Missing"]
            names: darray[sview] = ["", "shared", "filler", "collision_2", "collision_60", "late", "absent"]
            for owner in owners |fns, names|:
                for name in names |fns, owner|:
                    index_test_query(fns, owner, name)

    public:
        def check_function_name_index() -> void can[Abort.Panic, Memory.Allocate]:
            fns: mutable FnTable = zeroed
            build_function_name_index(fns)
            index_test_all(fns)
            index_test_append(fns, "shared", "A", 1, 10)
            index_test_append(fns, "shared", "A", 2, 20)
            index_test_append(fns, "shared", "B", 1, 30)
            index_test_append(fns, "shared", "A", 1, 10)
            index_test_append(fns, "", "", 0, 40)
            index_test_append(fns, "collision_2", "", 1, 50)
            index_test_append(fns, "collision_60", "", 2, 60)
            assert function_name_bucket("collision_2") == function_name_bucket("collision_60")
            build_function_name_index(fns)
            assert fns.name_buckets.count == 0
            index_test_all(fns)
            for index in 0..<FUNCTION_NAME_INDEX_MIN_ROWS |fns|:
                index_test_append(fns, "filler", "", index % INDEX_TEST_ARITIES, 100 + index.u32())
            build_function_name_index(fns)
            assert fns.name_next.count == fns.names.count
            index_test_all(fns)
            # Late generic declarations must not invalidate the indexed prefix
            # or take precedence over older overloads.
            index_test_append(fns, "shared", "A", 1, 10)
            index_test_append(fns, "late", "B", 3, 70)
            index_test_append(fns, "collision_60", "A", 4, 80)
            assert fns.name_next.count < fns.names.count
            index_test_all(fns)
            build_function_name_index(fns)
            index_test_all(fns)
            empty: mutable FnTable = zeroed
            build_function_name_index(empty)
            index_test_all(empty)

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    Backend::check_function_name_index()
    return 0
