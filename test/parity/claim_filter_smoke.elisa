# Compaction preserves multiple false claims and genuine threaded calls.
include "../../src/semantic/semantic.elisa"

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    EXPECTED_DIAGNOSTICS: usize = 2
    FALSE_CLAIM_LINE: u32 = 7
    source: u8& = "def plain(value: i64) -> i64:\n    return value\ndef threaded(value: lmut i64) -> i64:\n    return value\nmodule Cases:\n    def rejected(first: i64, second: i64):\n        rebind result: i64, first, second = plain(first)\n    def accepted(value: lmut i64):\n        rebind result: i64, value = threaded(value)\n    def ordinary(value: i64):\n        result: i64 = plain(value)\n"
    length: mutable usize = 0
    while source[length] != 0 |length|:
        length <- length + 1
    tokens: darray[Token] = frontend_tokenize_with_length(source, source, length)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    assert file.errors.count == 0
    table: mutable Semantic::SymbolTable = Semantic::collect_symbols(file)
    table <- Semantic::check_lmut_rebind_claim(file, table)
    assert table.diagnostics.count == EXPECTED_DIAGNOSTICS
    assert table.diagnostics[0].kind == Semantic::DiagnosticKind.LmutFalseClaim
    assert table.diagnostics[0].name == "first"
    assert table.diagnostics[0].line == FALSE_CLAIM_LINE
    assert table.diagnostics[0].expected == "plain"
    assert table.diagnostics[1].kind == Semantic::DiagnosticKind.LmutFalseClaim
    assert table.diagnostics[1].name == "second"
    assert table.diagnostics[1].line == FALSE_CLAIM_LINE
    assert table.diagnostics[1].expected == "plain"
    return 0
