include "../../src/parser/parser_tokens.elisa"

struct FakeGroupTicket:
    node: Ast::Expr

def fake_group_worker(ticket: FakeGroupTicket) -> i64:
    return match ticket.node:
        Ast::Expr.IntLit(value, _): value
        _: 0

module FakeGroup:
    @internal
    def task_group_new() -> TaskGroup:
        return zeroed

    @internal
    def task_group_add[R](group: mutable TaskGroup&, task: Task[R, Pending]):
        _ = move task
        return

    @internal
    def task_group_wait_all(group: mutable TaskGroup&):
        return

    def main() -> i64:
        can Memory.Allocate, Memory.Release, Abort.Panic, Pool.Create, Pool.Submit, Pool.WaitAll, Pool.Shutdown, Thread.Spawn, Thread.Join, Parallel, Unsafe.PointerCast:
            region nodes(65536):
                store: Ast::Node.Store[Local] = Ast::Node.Store(nodes)
                in store:
                    node: Ast::Expr = new Ast::Expr.IntLit(value: 41, pos: zeroed)
                    shared_workers: mutable ThreadPool = pool_new(2)
                    group: mutable TaskGroup = task_group_new()
                    submit[shared_workers] fake_group_worker(FakeGroupTicket{node: node})
                    task_group_wait_all(&group)
                    pool_shutdown(&shared_workers)
            return 0
