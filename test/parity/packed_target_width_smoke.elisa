# Real module data layouts select 32/64-bit behavior independently of ambient target defaults.
# Explicit 32-bit LLVM layouts are also checked independently of the target environment.
include "../../src/backend/codegen.elisa"

extend Backend:
    public:
        def check_packed_target_width(layout: cstr, pointer_bytes: u32, inline_enabled: bool) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe{PointerArithmetic,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}:
                source: u8& = "extend Ast:\n    struct Pos:\n        line: u32\n        column: u32\n        offset: u32\n        end_line: u32\n        end_column: u32\n        end_offset: u32\n    enum Node layout(handle: u32):\n        pass\n    enum Expr is Node:\n        V0(pos: Pos)\n        V1(pos: Pos)\n        V2(pos: Pos)\n        V3(pos: Pos)\n        V4(pos: Pos)\n        V5(pos: Pos)\n        V6(pos: Pos)\n        V7(pos: Pos)\n        V8(pos: Pos)\n        V9(pos: Pos)\n        V10(pos: Pos)\n        V11(pos: Pos)\n        V12(pos: Pos)\n        V13(pos: Pos)\n        V14(pos: Pos)\n        V15(pos: Pos)\n        V16(pos: Pos)\n        V17(pos: Pos)\n        V18(pos: Pos)\n        V19(pos: Pos)\n        V20(pos: Pos)\n        V21(pos: Pos)\n        V22(pos: Pos)\n        V23(pos: Pos)\n        V24(pos: Pos)\n        V25(pos: Pos)\n        V26(pos: Pos)\n        V27(pos: Pos)\n        V28(pos: Pos)\n        V29(pos: Pos)\n        V30(pos: Pos)\n        V31(pos: Pos)\n        V32(pos: Pos)\n        V33(pos: Pos)\n        V34(pos: Pos)\n        V35(pos: Pos)\n        V36(pos: Pos)\n        V37(pos: Pos)\n        V38(pos: Pos)\n        V39(pos: Pos)\n        V40(pos: Pos)\n        V41(pos: Pos)\n        V42(pos: Pos)\n        V43(pos: Pos)\n        V44(pos: Pos)\n        V45(pos: Pos)\n        V46(pos: Pos)\n        V47(pos: Pos)\n"
                length: mutable usize = 0
                while source[length] != 0 |length|:
                    length <- length + 1
                tokens: darray[Lexer::Token] = frontend_tokenize_with_length(source, source, length)
                file: Ast::File = frontend_parser_parse_file(source, tokens)
                assert (file.errors.count == 0)
                compiler_marker: mutable bool = false
                for annotation in file.enum_annotations |compiler_marker|:
                    compiler_marker <- true if annotation.name == "__compiler_ast_refinement" and annotation.owner == "Expr"
                assert compiler_marker
                ctx: LLVMContextRef = LLVMContextCreate()
                m: LLVMModuleRef = LLVMModuleCreateWithNameInContext("packed_target_width", ctx)
                LLVMSetDataLayout(m, layout)
                target_data: LLVMTargetDataRef = LLVMGetModuleDataLayout(m)
                assert (LLVMPointerSize(target_data) == pointer_bytes)
                table: mutable StructTable = new_struct_table(ctx, target_data)
                top: darray[Decl] = select_module_declarations(file, table)
                register_module_types(file, top, table, m, ctx)
                # Registration must copy exact real parser provenance, in order and
                # including duplicates; no manually fabricated storage eligibility.
                marker_count: mutable usize = 0
                for annotation in file.enum_annotations |marker_count|:
                    if annotation.name == "__compiler_ast_refinement":
                        assert marker_count < table.packed_layouts.ast_refinement_names.count
                        assert table.packed_layouts.ast_refinement_names[marker_count] == annotation.owner
                        marker_count <- marker_count + 1
                assert marker_count == table.packed_layouts.ast_refinement_names.count
                assert packed_ast_variant_total(table) == 48
                root: i64 = program_hierarchy_root_index(table)
                assert (root >= 0 and packed_program_sized_records(table))
                eligible: bool = table.target.target_pointer_bits == 64 and pointer_bytes == 8
                assert (packed_cold_pos_program(table) == eligible)
                assert table.target.target_pointer_bits == pointer_bytes * 8
                # A stale model must not override a real 32-bit LLVM layout.
                if pointer_bytes == 4:
                    mismatched: mutable StructTable = table{target = table.target{target_pointer_bits = 64}}
                    assert not packed_cold_pos_program(mismatched)
                assert (packed_store_side_words(table, root, 2) == (3 if eligible else 0))
                refinement: i64 = packed_index_of(table, "Expr")
                assert (refinement >= 0)
                slot: usize = table.packed_enums.packed_variant_start[refinement.usize()]
                assert (packed_variant_cold_pos(table, slot))
                # Tag + all six u32 Pos fields must remain in a 32-bit record.
                assert (packed_sized_record_bytes(table, slot) == (8 if eligible else 28))
                # Type-only callers have real packed metadata but no target layout yet.
                missing_layout_table: mutable StructTable = table{target = table.target{target_data = null}}
                assert not packed_cold_pos_program(missing_layout_table)
                assert packed_store_side_words(missing_layout_table, root, 2) == 0
                assert packed_sized_record_bytes(missing_layout_table, slot) == 28
                pointer_type: LLVMTypeRef = LLVMPointerTypeInContext(ctx, 0)
                i64_type: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
                params: mutable darray[LLVMTypeRef] = [pointer_type, i64_type]
                signature: LLVMTypeRef = LLVMFunctionType(pointer_type, (&params[0]).cast[void&], 2, 0)
                record_fn: LLVMValueRef = LLVMAddFunction(m, "ctx_aos_store_record", signature)
                side_fn: LLVMValueRef = LLVMAddFunction(m, "ctx_aos_store_side_slot", signature)
                before_ir: cstr = LLVMPrintModuleToString(m)
                # Test direct body entry points, not just the aggregate dispatch guard.
                inline_aos_store_record_body(m, record_fn)
                inline_aos_store_side_slot_body(m, side_fn)
                assert ((LLVMCountBasicBlocks(record_fn) > 0) == eligible)
                assert ((LLVMCountBasicBlocks(side_fn) > 0) == eligible)
                if not eligible:
                    inline_aos_store_record(m)
                    assert (LLVMIsDeclaration(record_fn) != 0 and LLVMIsDeclaration(side_fn) != 0)
                if not eligible:
                    after_ir: cstr = LLVMPrintModuleToString(m)
                    assert sview(before_ir, 0, before_ir.len) == sview(after_ir, 0, after_ir.len)
                    LLVMDisposeMessage(after_ir)
                LLVMDisposeMessage(before_ir)
                # Exercise aggregate dispatch independently with fresh canonical symbols.
                dispatched: LLVMModuleRef = LLVMModuleCreateWithNameInContext("dispatch_target_width", ctx)
                LLVMSetDataLayout(dispatched, layout)
                dispatched_record: LLVMValueRef = LLVMAddFunction(dispatched, "ctx_aos_store_record", signature)
                dispatched_side: LLVMValueRef = LLVMAddFunction(dispatched, "ctx_aos_store_side_slot", signature)
                dispatch_before: cstr = LLVMPrintModuleToString(dispatched)
                inline_aos_store_record(dispatched) if inline_enabled
                assert (LLVMCountBasicBlocks(dispatched_record) > 0) == (eligible and inline_enabled)
                assert (LLVMCountBasicBlocks(dispatched_side) > 0) == (eligible and inline_enabled)
                if not eligible or not inline_enabled:
                    dispatch_after: cstr = LLVMPrintModuleToString(dispatched)
                    assert sview(dispatch_before, 0, dispatch_before.len) == sview(dispatch_after, 0, dispatch_after.len)
                    LLVMDisposeMessage(dispatch_after)
                LLVMDisposeMessage(dispatch_before)
                assert LLVMVerifyModule(dispatched, 2, null) == 0
                LLVMDisposeModule(dispatched)
                assert (LLVMVerifyModule(m, 2, null) == 0)
                LLVMDisposeModule(m)
                LLVMContextDispose(ctx)

extend Backend:
    public:
        def check_missing_target_layout() -> void:
            can Memory.Allocate, Abort.Panic, Unsafe.RawExtern:
                missing: mutable StructTable = StructTable{target: BackendTarget{context: null, target_data: null, target_pointer_bits: 0}}
                assert not packed_cold_pos_program(missing)
                ctx: LLVMContextRef = LLVMContextCreate()
                m: LLVMModuleRef = LLVMModuleCreateWithNameInContext("missing_layout", ctx)
                assert not inline_aos_store_layout_supported(null)
                assert not inline_aos_store_layout_supported(m)
                LLVMDisposeModule(m)
                LLVMContextDispose(ctx)

def main() -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe{PointerArithmetic,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}:
        Backend::check_packed_target_width("e-p:32:32-i64:64-n32", 4, false)
        Backend::check_packed_target_width("e-p:32:32-i64:64-n32", 4, true)
        Backend::check_packed_target_width("e-p:64:64-i64:64-n32:64", 8, false)
        Backend::check_packed_target_width("e-p:64:64-i64:64-n32:64", 8, true)
        # Missing table/module layouts must decline without calling FFI with a null handle.
        Backend::check_missing_target_layout()
    return 0
