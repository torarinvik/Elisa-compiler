include "../../src/parser/parser.elisa"
using Ast

def main() -> i64:
    pos: Ast::Pos = Ast::Pos{line: 1, column: 1, offset: 0, end_line: 1, end_column: 2, end_offset: 1}
    statements: darray[Ast::Stmt] = [
        Ast::Stmt.Contract("assert", Ast::Expr.BoolLit(true, pos), pos),
        Ast::Stmt.Expr(Ast::Expr.Ident("acc", pos), pos)
    ]
    return 1 if not Parser::machine_statement_mentions_ident(statements, "acc")
    return 2 if Parser::machine_statement_mentions_ident(statements, "other")
    candidate: Ast::StaticEffectCandidate = Ast::StaticEffectCandidate{effect_type: Ast::Expr.Ident("Effect", pos), callee: "handler", captures: [Ast::Expr.Ident("acc", pos)]}
    effect_call: Ast::Expr = Ast::Expr.StaticEffectCall(Ast::Expr.Ident("Effect", pos), "invoke", [candidate], [], [], pos)
    return 3 if not Parser::machine_expr_mentions_ident(effect_call, "acc")
    return 4 if Parser::machine_expr_mentions_ident(effect_call, "other")
    block: Ast::Expr = Ast::Expr.Block([], Ast::Expr.IntLit(1, pos), ["acc"], pos)
    return 5 if not Parser::machine_expr_mentions_ident(block, "acc")
    return 6 if Parser::machine_expr_mentions_ident(block, "other")
    return 0
