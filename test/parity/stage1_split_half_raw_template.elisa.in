include "@BACKEND@/llvm_c.elisa"
extern LLVMSetVolatile(value: LLVMValueRef, is_volatile: i32) -> void
extern LLVMSetExact(value: LLVMValueRef, is_exact: i32) -> void
extern LLVMSetNUW(value: LLVMValueRef, is_nuw: i32) -> void
module Backend:
    public:
        def split_probe() -> i64:
            0
include "@BACKEND@/codegen_split_half.elisa"

def main() -> i32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read]:
    ctx: LLVMContextRef = LLVMContextCreate()
    m: LLVMModuleRef = LLVMModuleCreateWithNameInContext("test", ctx)
    ty: LLVMTypeRef = LLVMInt64TypeInContext(ctx)
    params: mutable darray[LLVMTypeRef] = [ty, ty]
    param_ptr: void& = (&params[0]).cast[void&] can Unsafe.PointerCast
    fty: LLVMTypeRef = LLVMFunctionType(ty, param_ptr, 2, 0)
    fn_value: LLVMValueRef = LLVMAddFunction(m, "probe", fty)
    block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(ctx, fn_value, "entry")
    builder: LLVMBuilderRef = LLVMCreateBuilderInContext(ctx)
    LLVMPositionBuilderAtEnd(builder, block)
    a: LLVMValueRef = LLVMGetParam(fn_value, 0)
    b: LLVMValueRef = LLVMGetParam(fn_value, 1)
    mask: LLVMValueRef = LLVMConstInt(ty, 4294967295, 0)
    shift: LLVMValueRef = LLVMConstInt(ty, 32, 0)
    aslot: LLVMValueRef = LLVMBuildAlloca(builder, ty, "a")
    bslot: LLVMValueRef = LLVMBuildAlloca(builder, ty, "b")
@STORE_A@
    _ = LLVMBuildStore(builder, b, bslot)
@LOAD_A@
    bv1: LLVMValueRef = LLVMBuildLoad2(builder, ty, bslot, "b1")
    al: LLVMValueRef = LLVMBuildAnd(builder, av1, mask, "al")
    bl: LLVMValueRef = LLVMBuildAnd(builder, bv1, mask, "bl")
    low: LLVMValueRef = LLVMBuildAdd(builder, al, bl, "low")
    av2: LLVMValueRef = LLVMBuildLoad2(builder, ty, aslot, "a2")
    bv2: LLVMValueRef = LLVMBuildLoad2(builder, ty, bslot, "b2")
@SHIFT_A@
    bh: LLVMValueRef = LLVMBuildLShr(builder, bv2, shift, "bh")
    low_slot: LLVMValueRef = LLVMBuildAlloca(builder, ty, "low_slot")
    _ = LLVMBuildStore(builder, low, low_slot)
    low_copy1: LLVMValueRef = LLVMBuildLoad2(builder, ty, low_slot, "low_copy1")
    carry: LLVMValueRef = LLVMBuildLShr(builder, low_copy1, shift, "carry")
    hs1: LLVMValueRef = LLVMBuildAdd(builder, ah, bh, "hs1")
    hs2: LLVMValueRef = LLVMBuildAdd(builder, hs1, carry, "hs2")
    high_slot: LLVMValueRef = LLVMBuildAlloca(builder, ty, "high_slot")
    _ = LLVMBuildStore(builder, hs2, high_slot)
    high_copy: LLVMValueRef = LLVMBuildLoad2(builder, ty, high_slot, "high_copy")
    hm: LLVMValueRef = LLVMBuildAnd(builder, high_copy, mask, "hm")
@SHIFT_HIGH@
    low_copy2: LLVMValueRef = LLVMBuildLoad2(builder, ty, low_slot, "low_copy2")
    lm: LLVMValueRef = LLVMBuildAnd(builder, low_copy2, mask, "lm")
    result: LLVMValueRef = LLVMBuildOr(builder, shifted, lm, "result")
    _ = LLVMBuildRet(builder, result)
    count: mutable usize = 0
    can Global.Read:
        count <- Backend::split_rewrite_module(m, ctx) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read]
    LLVMDisposeBuilder(builder)
    LLVMDisposeModule(m)
    LLVMContextDispose(ctx)
    return 0 if count == @EXPECTED@
    1
