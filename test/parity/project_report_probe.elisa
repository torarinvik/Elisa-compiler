# `project view` / `project deps` driven through stage1's ProjectSystem module, so the parity
# smoke can diff stage1's bytes against stage0's `elisacore project ...` on the same scaffold.
#
# Usage mirrors stage0's:  project_report_probe <view|deps> [target] [--project DIR] [--json]
#
# The error sites below route through the shared `fail(detail)` helper. They were written out
# INLINE at first because that call made stage1's backend decline the whole unit — zero
# functions emitted, exit 2, no diagnostic — while stage0 compiled it. The cause turned out to
# be overload resolution, not the helper: elisacore_std's test.elisa declares
# `def fail(message: cstr)`, the prelude pulls it into every program, and a `T&` parameter was
# never considered a candidate for a plain `T` argument, so this file's own `fail` lost the
# resolution to it. Fixed in overload_index_for_args; pinned by overload_ref_param_* in
# backend_native_smoke.

include "../../elisacore_std/elisacore_runtime.elisa"
include "../../src/driver/project.elisa"

def emit_stream(descriptor: int, text: darray[u8]&) -> void can[Console, Abort.Panic, Unsafe.PointerCast, Memory.Allocate]:
    return if text.count == 0.usize()
    target: void& = (&text[0.usize()]).cast[void&] can Unsafe.PointerCast
    _ = write(descriptor, target, text.count)

def emit_all(text: darray[u8]&) -> void can[Console, Abort.Panic, Unsafe.PointerCast, Memory.Allocate]:
    emit_stream(1, text)

# stage0 reports resolution failures on STDERR, after whatever it has already printed.
def emit_error(text: darray[u8]&) -> void can[Console, Abort.Panic, Unsafe.PointerCast, Memory.Allocate]:
    emit_stream(2, text)

def fail(detail: darray[u8]&) -> int can[Console, Abort.Panic, Unsafe.PointerCast, Memory.Allocate]:
    message: mutable darray[u8] = ProjectSystem::bytes_from_view("error: ")
    ProjectSystem::bytes_extend(&message, detail)
    message.push(10)
    emit_error(message)
    return 1

def main(argc: i64, argv: mutable void&) -> int can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    slots: mutable cstr&& = argv.cast[mutable cstr&&]
    start: mutable darray[u8] = []
    requested: mutable darray[u8] = []
    command: mutable darray[u8] = []
    want_json: mutable bool = false
    index: mutable i64 = 1
    while index < argc |index, start, requested, command, want_json, slots|:
        piece: mutable darray[u8] = []
        ProjectSystem::bytes_extend_cstr(&piece, slots[index.usize()].cast[cstr])
        if ProjectSystem::bytes_equal_view(piece, "--project"):
            index <- index + 1
            start <- []
            ProjectSystem::bytes_extend_cstr(&start, slots[index.usize()].cast[cstr]) if index < argc
        elif ProjectSystem::bytes_equal_view(piece, "--json"):
            want_json <- true
        elif command.count == 0.usize():
            command <- piece
        else:
            requested <- piece
        index <- index + 1
    project_file: darray[u8] = ProjectSystem::find_project_file(start)
    if project_file.count == 0.usize():
        message: mutable darray[u8] = ProjectSystem::bytes_from_view("could not find project.json from ")
        origin: darray[u8] = ProjectSystem::project_search_origin(start)
        ProjectSystem::bytes_extend(&message, origin)
        return fail(message)
    raw: darray[u8] = ProjectSystem::read_file_bytes(project_file)
    cursor: mutable ProjectSystem::JsonCursor = ProjectSystem::JsonCursor{position: 0.usize(), ok: true}
    project: ProjectSystem::ProjectDef = ProjectSystem::parse_project(raw, &cursor)
    if not cursor.ok:
        return fail(ProjectSystem::json_error_message(raw, &cursor, project_file))
    # The header goes out BEFORE resolution, matching stage0's order.
    # stage0's loadResolvedProject rejects an empty target table at LOAD time, before the
    # view header is printed — so this must come before the header, not at target selection.
    if project.targets.count == 0.usize():
        message: mutable darray[u8] = ProjectSystem::bytes_copy(project_file)
        ProjectSystem::bytes_extend_view(&message, " does not define any targets")
        return fail(message)
    is_view: bool = ProjectSystem::bytes_equal_view(command, "view")
    if is_view:
        header: darray[u8] = ProjectSystem::render_view_header(&project, project_file)
        emit_all(header)
    graph: ProjectSystem::ManifestGraph = ProjectSystem::build_dependency_graph(&project, project_file, requested)
    resolved: ProjectSystem::ResolvedTarget = ProjectSystem::resolve_project_target(&project, project_file, requested, &graph)
    if resolved.failed:
        return fail(resolved.error_text)
    if is_view:
        body: darray[u8] = ProjectSystem::render_view_body(&resolved, &graph)
        emit_all(body)
        return 0
    sources: ProjectSystem::StrList = ProjectSystem::collect_all_sources(&resolved, &graph)
    if want_json:
        json_payload: darray[u8] = ProjectSystem::render_project_deps_json(&resolved, &graph, &sources)
        emit_all(json_payload)
        return 0
    text_payload: darray[u8] = ProjectSystem::render_project_deps_text(&resolved, &graph, &sources)
    emit_all(text_payload)
    return 0
