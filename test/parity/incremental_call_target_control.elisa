include "../../src/parser/parser.elisa"
using Ast
using Bytes
module Semantic:
    public:
        const CANDIDATE_NAME_CONTROL_CONTEXT: u32 = 1
include "../../src/semantic/incremental_function_facts.elisa"
extend Semantic:
    public:
        # Reference admission rule retained from the merged baseline.
        def linear_call_target(candidates: darray[IncrementalFactCandidate]&, name: sview) -> bool:
            can Abort.Panic:
                matches: mutable usize = 0
                for candidate in candidates:
                    continue if candidate.name != name
                    matches <- matches + 1
                    false return if not candidate.header_supported or candidate.parameters.count != 0
                return matches == 1

        def candidate_name_control() -> i64:
            can Memory.Allocate, Abort.Panic:
                candidates: mutable darray[IncrementalFactCandidate] = []
                names: darray[sview] = ["a", "b", "a", "c", ""]
                for name in names |candidates|:
                    candidates.push(IncrementalFactCandidate{name: name, parameters: [], return_type: null, body: [], definition_offset: 0, definition_token: 0, generic_header: false, span_ordered: true, body_token_start: 0, body_token_end: 0, skip_start: 0, skip_end: 0, owner: 0, header_supported: true, prior_body_matches: false, scanned: false})
                index: mutable IncrementalCandidateNameIndex = ifc_candidate_name_index(candidates)
                assert ifc_name_unique(candidates, "a", index) == false
                assert ifc_name_unique(candidates, "b", index) == true
                assert ifc_name_unique(candidates, "c", index) == true
                assert ifc_name_unique(candidates, "", index) == true
                assert ifc_name_unique(candidates, "missing", index) == false
                assert ifc_call_target(candidates, "a", index) == false
                assert ifc_call_target(candidates, "b", index) == true
                assert ifc_call_target(candidates, "missing", index) == false
                candidates[1].header_supported <- false
                assert ifc_call_target(candidates, "b", index) == false
                candidates[1].header_supported <- true
                candidates[3] <- IncrementalFactCandidate{name: "c", parameters: [Ast::ParamDecl{name: "value", type_expression: Ast::Expr.Invalid, is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}], return_type: null, body: [], definition_offset: 0, definition_token: 0, generic_header: false, span_ordered: true, body_token_start: 0, body_token_end: 0, skip_start: 0, skip_end: 0, owner: 0, header_supported: true, prior_body_matches: false, scanned: false}
                assert ifc_call_target(candidates, "c", index) == false
                index.next <- [1, 2, 3, 4, 5]
                for bucket in 0..<index.heads.count |index|:
                    index.heads[bucket] <- 0
                assert ifc_name_unique(candidates, "a", index) == false
                assert ifc_name_unique(candidates, "b", index) == true
                assert ifc_name_unique(candidates, "missing", index) == false
                assert ifc_call_target(candidates, "b", index) == true
                assert ifc_call_target(candidates, "c", index) == false
                assert ifc_call_target(candidates, "a", index) == false
                assert ifc_call_target(candidates, "missing", index) == false
                queries: darray[sview] = ["a", "b", "c", "", "missing", "panic"]
                for name in queries:
                    assert ifc_call_target(candidates, name, index) == linear_call_target(candidates, name)
                empty: darray[IncrementalFactCandidate] = []
                empty_index: IncrementalCandidateNameIndex = ifc_candidate_name_index(empty)
                assert ifc_name_unique(empty, "a", empty_index) == false
                assert ifc_call_target(empty, "a", empty_index) == false
                # Collector admission must still reject every overload sharing a name.
                source: static u8& = "def repeated() -> i64:\n    return 1\ndef repeated(value: i64) -> i64:\n    return value\n"
                tokens: darray[Lexer::Token] = frontend_tokenize_with_length(source, source, 86)
                file: Ast::File = frontend_parser_parse_file(source, tokens) can Global{Read,Write}
                assert file.errors.count == 0
                previous: IncrementalSemanticSnapshot = incremental_empty_snapshot()
                snapshot: IncrementalSemanticSnapshot = incremental_collect_function_facts(file, source, 86, tokens, "/name-unique/control.elisa", 1, 1, previous, false)
                assert snapshot.functions.count == 2
                for record in snapshot.functions:
                    assert not record.cacheable
                    assert record.reject_reason == IncrementalRejectReason.NonUniqueOrGenericFunction
                # Collector boundary: direct.
                fixture_0: static u8& = "def target() -> i64:\n    return 1\ndef caller() -> i64:\n    return target()\n"
                tokens_0: darray[Lexer::Token] = frontend_tokenize_with_length(fixture_0, fixture_0, 75)
                file_0: Ast::File = frontend_parser_parse_file(fixture_0, tokens_0) can Global{Read,Write}
                assert file_0.errors.count == 0
                snapshot_0: IncrementalSemanticSnapshot = incremental_collect_function_facts(file_0, fixture_0, 75, tokens_0, "/call-target/direct.elisa", 1, 1, previous, false)
                record_0: IncrementalFunctionFactRecord = snapshot_0.functions[snapshot_0.functions.count - 1]
                assert record_0.cacheable == true
                assert record_0.direct_fact_count == 1
                assert snapshot_0.direct_facts[record_0.direct_fact_start].kind == IncrementalFactKind.DirectCall
                # Collector boundary: local-shadow.
                fixture_1: static u8& = "def target() -> i64:\n    return 1\ndef caller() -> i64:\n    target = 1\n    return target()\n"
                tokens_1: darray[Lexer::Token] = frontend_tokenize_with_length(fixture_1, fixture_1, 90)
                file_1: Ast::File = frontend_parser_parse_file(fixture_1, tokens_1) can Global{Read,Write}
                assert file_1.errors.count == 0
                snapshot_1: IncrementalSemanticSnapshot = incremental_collect_function_facts(file_1, fixture_1, 90, tokens_1, "/call-target/local-shadow.elisa", 1, 1, previous, false)
                record_1: IncrementalFunctionFactRecord = snapshot_1.functions[snapshot_1.functions.count - 1]
                assert record_1.cacheable == false
                # Collector boundary: global-shadow.
                fixture_2: static u8& = "global mutable target: i64 = 1\ndef target() -> i64:\n    return 1\ndef caller() -> i64:\n    return target()\n"
                tokens_2: darray[Lexer::Token] = frontend_tokenize_with_length(fixture_2, fixture_2, 106)
                file_2: Ast::File = frontend_parser_parse_file(fixture_2, tokens_2) can Global{Read,Write}
                assert file_2.errors.count == 0
                snapshot_2: IncrementalSemanticSnapshot = incremental_collect_function_facts(file_2, fixture_2, 106, tokens_2, "/call-target/global-shadow.elisa", 1, 1, previous, false)
                record_2: IncrementalFunctionFactRecord = snapshot_2.functions[snapshot_2.functions.count - 1]
                assert record_2.cacheable == false
                # Collector boundary: panic.
                fixture_3: static u8& = "def caller() -> void:\n    panic()\n"
                tokens_3: darray[Lexer::Token] = frontend_tokenize_with_length(fixture_3, fixture_3, 34)
                file_3: Ast::File = frontend_parser_parse_file(fixture_3, tokens_3) can Global{Read,Write}
                assert file_3.errors.count == 0
                snapshot_3: IncrementalSemanticSnapshot = incremental_collect_function_facts(file_3, fixture_3, 34, tokens_3, "/call-target/panic.elisa", 1, 1, previous, false)
                record_3: IncrementalFunctionFactRecord = snapshot_3.functions[snapshot_3.functions.count - 1]
                assert record_3.cacheable == true
                assert record_3.direct_fact_count == 1
                assert snapshot_3.direct_facts[record_3.direct_fact_start].kind == IncrementalFactKind.PanicSite
                # Collector boundary: parameter-target.
                fixture_4: static u8& = "def target(value: i64) -> i64:\n    return 1\ndef caller() -> i64:\n    return target()\n"
                tokens_4: darray[Lexer::Token] = frontend_tokenize_with_length(fixture_4, fixture_4, 85)
                file_4: Ast::File = frontend_parser_parse_file(fixture_4, tokens_4) can Global{Read,Write}
                assert file_4.errors.count == 0
                snapshot_4: IncrementalSemanticSnapshot = incremental_collect_function_facts(file_4, fixture_4, 85, tokens_4, "/call-target/parameter-target.elisa", 1, 1, previous, false)
                record_4: IncrementalFunctionFactRecord = snapshot_4.functions[snapshot_4.functions.count - 1]
                assert record_4.cacheable == false
                return 0

def main() -> i64:
    return Semantic::candidate_name_control() can Memory.Allocate, Abort.Panic, Global{Read,Write}
