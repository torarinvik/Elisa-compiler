# Scanner unit controls use the actual lexer and a reduced Parser record. They
# do not replace the actual-parser runtime probe or the Stage1 structural suite.
include "../../elisacore_std/elisacore_runtime.elisa"
include "../../src/lexer/lexer.elisa"
module Ast:
    public:
        struct EnumAnnotation:
            owner: sview
            name: sview
            line: u32
module Parser:
    public:
        struct Parser:
            source: u8&
            source_length: usize
            tokens: darray[Token]
            position: usize
            enum_annotations: mutable darray[Ast::EnumAnnotation]
    private:
        def peek_at(parser: Parser&, offset: usize) -> TokenKind:
            return TokenKind.Eof if parser.position >= parser.tokens.count or offset >= parser.tokens.count - parser.position
            return parser.tokens[parser.position + offset].kind
        def peek(parser: Parser&) -> TokenKind:
            return parser.peek_at(0)
        def header_token_text(parser: Parser&, offset: usize) -> sview:
            return "" if parser.position >= parser.tokens.count or offset >= parser.tokens.count - parser.position
            return Lexer::text_or_empty(parser.tokens[parser.position + offset], parser.source)
include "../../src/parser/parser_extern_return_text.elisa"

extend Parser:
    public:
        def return_text_rejects_short_source() -> bool can[Memory.Allocate, Abort.Panic]:
            source: u8& = "extern probe() -> u8\n"
            tokens: darray[Token] = frontend_tokenize(source, source)
            position: mutable usize = 0
            for offset in 0..<tokens.count |offset, tokens, position|:
                if tokens[offset].kind == TokenKind.Arrow:
                    position <- offset
                    break
            parser: mutable Parser = Parser{source: source, source_length: 1, tokens: tokens, position: position, enum_annotations: []}
            parser <- parser.record_extern_return_text("probe", 1)
            return parser.enum_annotations.count == 0

        def return_text_unit(source: u8&, complete: bool, expected: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            tokens: darray[Token] = frontend_tokenize(source, source)
            return false if tokens.count == 0
            position: mutable usize = 0
            for offset in 0..<tokens.count |offset, tokens, position|:
                if tokens[offset].kind == TokenKind.Arrow:
                    position <- offset
                    break
            parser: mutable Parser = Parser{source: source, source_length: tokens[tokens.count - 1].start.usize(), tokens: tokens, position: position, enum_annotations: []}
            parser <- parser.record_extern_return_text("probe", 1)
            return parser.enum_annotations.count == 0 if not complete
            return parser.enum_annotations.count == 2 and parser.enum_annotations[0].owner == "probe" and parser.enum_annotations[0].name == "__extern_return_text_complete" and parser.enum_annotations[0].line == 1 and parser.enum_annotations[1].owner == "__extern_return_text" and parser.enum_annotations[1].name == expected and parser.enum_annotations[1].line == 1

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return 1 if not Parser::return_text_unit("extern probe() -> u8 can[Unsafe.RawExtern]\n", true, "u8")
    return 2 if not Parser::return_text_unit("extern probe() -> Box::u8 can[Unsafe.RawExtern]\n", true, "Box::u8")
    return 3 if not Parser::return_text_unit("extern probe() -> mutable heap u8&? can[Unsafe.RawExtern]\n", true, "mutable heap u8&?")
    return 4 if not Parser::return_text_unit("extern probe() -> u8 [ 4 ] can[Unsafe.RawExtern]\n", true, "u8 [ 4 ]")
    return 5 if not Parser::return_text_unit("extern probe() -> fn(value: u8) -> u8 can[Unsafe.RawExtern]\n", true, "fn(value: u8) -> u8")
    return 6 if not Parser::return_text_unit("extern probe() -> (x: u8, y: darray[u8]) can[Unsafe.RawExtern]\n", true, "(x: u8, y: darray[u8])")
    return 7 if not Parser::return_text_unit("extern probe() -> u8 requires true ensure true\n", true, "u8")
    return 8 if not Parser::return_text_unit("export fn probe() -> u8 = target\n", true, "u8")
    return 9 if not Parser::return_text_unit("extern probe() -> u8 error[E] can[Unsafe.RawExtern]\n", true, "u8 error[E]")
    return 10 if not Parser::return_text_unit("extern probe() can[Unsafe.RawExtern]\n", false, "")
    return 11 if not Parser::return_text_unit("extern probe() -> u8[4\n", false, "")
    return 12 if not Parser::return_text_unit("extern probe() -> u8]\n", false, "")
    return 13 if not Parser::return_text_unit("extern probe() -> (u8]\n", false, "")
    return 14 if not Parser::return_text_rejects_short_source()
    return 15 if not Parser::return_text_unit("extern probe() ->  u8  ", true, "u8")
    return 16 if not Parser::return_text_unit("extern probe() -> Box::can can[Unsafe.RawExtern]\n", true, "Box::can")
    return 17 if not Parser::return_text_unit("extern probe() -> requires::u8 can[Unsafe.RawExtern]\n", true, "requires::u8")
    return 0
