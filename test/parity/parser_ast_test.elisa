@test
def test_qualified_extend_name() -> void:
    can Memory.Allocate, Abort.Panic:
        # `extend` shares module_declaration's grammar, so the qualified name applies there too.
        src: u8& = "extend Common::Log::Class:\n    def g() -> i64 = 2\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
