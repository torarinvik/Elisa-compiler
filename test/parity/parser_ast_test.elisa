@test
def test_annotation_refinements_are_structured() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "struct Box:\n    value: i64 where value >= 0\n\ndef f(x: i64 where x >= 0) -> i64 where result >= 0:\n    y: i64 where y >= 0 = x\n    pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match file.top_decls[0]:
            Decl.Struct(name, members, affinity, has_states, has_derive, invariants, line):
                match members[0].type_expression:
                    Expr.Refinement(base, predicate, refinement_line):
                        pass
                    _:
                        assert false
            _:
                assert false
        match file.top_decls[1]:
            Decl.Func(name, params, return_type, body, effects, decorators, line):
                match return_type:
                    Expr.Refinement(base, predicate, refinement_line):
                        pass
                    _:
                        assert false
                match params[0].type_expression:
                    Expr.Refinement(base, predicate, refinement_line):
                        pass
                    _:
                        assert false
                match body[0]:
                    Stmt.VarDecl(local_name, local_type, value, local_line):
                        match local_type:
                            Expr.Refinement(base, predicate, refinement_line):
                                pass
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false


@test
def test_when_single_column_or_fans_out() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f(n: i64) -> i64:\n    return when n:\n        1 | 2 -> 10\n        _ -> 20\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        match body[0]:
            Stmt.Return(value, line):
                match value:
                    Expr.Match(scrutinee, arms, match_line):
                        assert arms.count == 3
                        match arms[0].pattern:
                            Pattern.Literal(text):
                                assert text == "1"
                            _:
                                assert false
                        match arms[1].pattern:
                            Pattern.Literal(text):
                                assert text == "2"
                            _:
                                assert false
                        match arms[2].pattern:
                            Pattern.Wildcard:
                                pass
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false


