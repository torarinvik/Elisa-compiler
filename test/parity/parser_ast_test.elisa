@test
def test_anonymous_brace_let_is_struct_pattern() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("def unpack(row: Row) -> void:\n    let {left: first, right} = row\n")
        assert file.errors.count == 0
