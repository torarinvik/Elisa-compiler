# Behavioral tests for the stage1 parser: parse a source snippet and assert on the
# resulting AST. Run with `~/.elisac/elisac -emit test test/parity/parser_ast_test.elisa`.
include "../../src/parser/parser.elisa"

using Ast


def parse_snippet(source: u8&) -> Ast::File:
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Token] = frontend_tokenize(source, source)
        return frontend_parser_parse_file(source, tokens)


@test
def test_parses_single_func() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f(x: i64) -> i64:\n    return x\n"
        file: Ast::File = parse_snippet(src)
        assert file.top_decls.count == 1
        assert file.errors.count == 0


# Return the effects of the first top-level Func decl (empty if none/not a func).
def first_func_effects(file: Ast::File&) -> darray[sview]:
    can Memory.Allocate, Abort.Panic:
        for decl in file.top_decls:
            match decl:
                Decl.Func(name, params, return_type, body, effects, decorators, line):
                    return effects
                _:
                    pass
        empty: darray[sview] = []
        return empty


@test
def test_bracketed_effect_grant() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f() -> i64 can[Abort.Panic, Memory.Allocate]:\n    return 0\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        effects: darray[sview] = first_func_effects(file)
        assert effects.count == 2
        assert effects[0] == "Abort.Panic"
        assert effects[1] == "Memory.Allocate"


@test
def test_bare_effect_grant() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f() -> i64 can Abort.Panic, Memory.Allocate:\n    return 0\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        effects: darray[sview] = first_func_effects(file)
        assert effects.count == 2
        assert effects[0] == "Abort.Panic"
        assert effects[1] == "Memory.Allocate"


@test
def test_no_effect_grant_is_empty() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f() -> i64:\n    return 0\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert first_func_effects(file).count == 0


# Return the decorators of the first top-level Func decl.
def first_func_decorators(file: Ast::File&) -> darray[sview]:
    can Memory.Allocate, Abort.Panic:
        for decl in file.top_decls:
            match decl:
                Decl.Func(name, params, return_type, body, effects, decorators, line):
                    return decorators
                _:
                    pass
        empty: darray[sview] = []
        return empty


@test
def test_decorators_captured() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "@inline(always)\n@hot\ndef f() -> i64:\n    return 0\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        decorators: darray[sview] = first_func_decorators(file)
        assert decorators.count == 2
        assert decorators[0] == "inline"
        assert decorators[1] == "hot"


@test
def test_bracketed_attribute_list() -> void:
    can Memory.Allocate, Abort.Panic:
        # `@[a, b]` attribute-list form == separate `@a`/`@b` lines.
        src: u8& = "@[noalloc, nolock]\ndef f() -> i32:\n    return 0\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        decorators: darray[sview] = first_func_decorators(file)
        assert decorators.count == 2
        assert decorators[0] == "noalloc"
        assert decorators[1] == "nolock"


@test
def test_undecorated_func_has_no_decorators() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f() -> i64:\n    return 0\n"
        file: Ast::File = parse_snippet(src)
        assert first_func_decorators(file).count == 0


# The first top-level func's body, or an empty list if there is none.
def first_func_body(file: Ast::File&) -> darray[Ast::Stmt]:
    can Memory.Allocate, Abort.Panic:
        for decl in file.top_decls:
            match decl:
                Decl.Func(name, params, return_type, body, effects, decorators, line):
                    return body
                _:
                    pass
        empty: darray[Ast::Stmt] = []
        return empty


@test
def test_region_block_kind_and_clause() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f() -> void:\n    region scratch(1024):\n        pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.Block(kind, clause, binding, inner, line):
                assert kind == "region"
                assert clause.count == 1
                assert clause[0] == "scratch"
                assert binding == ""
            _:
                assert false


@test
def test_effect_block_kind_and_clause() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f() -> void:\n    can Mem.Allocate:\n        pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.Block(kind, clause, binding, inner, line):
                assert kind == "can"
                assert clause.count == 2
                assert clause[0] == "Mem"
                assert clause[1] == "Allocate"
            _:
                assert false


@test
def test_contract_stmts_modeled() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f(a: i64) -> i64:\n    requires a >= 0\n    ensure result >= a\n    decreases a\n    return a\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 4                         # was silently split into 7
        match body[0]:
            Stmt.Contract(kind, expr, line):
                assert kind == "requires"
            _:
                assert false
        match body[1]:
            Stmt.Contract(kind, expr, line):
                assert kind == "ensure"
            _:
                assert false


@test
def test_submit_task_call() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f() -> void:\n    submit worker(1)\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1                         # was silently split into 2


@test
def test_contract_name_still_plain_local() -> void:
    can Memory.Allocate, Abort.Panic:
        # A local named `ensure` used in ordinary binding position must NOT
        # be swallowed by the contract-statement dispatch.
        src: u8& = "def f() -> i64:\n    ensure: i64 = 1\n    return ensure\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 2
        match body[0]:
            Stmt.VarDecl(name, type_expr, value, line):
                assert name == "ensure"
            _:
                assert false


@test
def test_const_module_bare_members() -> void:
    can Memory.Allocate, Abort.Panic:
        # `const module` members drop the `const` keyword (zero-overhead constants).
        src: u8& = "const module PROJ:\n    NONE: i32 = 0\n    ROCKET: i32 = 2\n    FIRE = 3\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Module(name, body, line):
                assert name == "PROJ"
                assert body.count == 3
                match body[0]:
                    Decl.Const(cname, ctype, cval, cline):
                        assert cname == "NONE"
                    _:
                        assert false
            _:
                assert false


@test
def test_module_visibility_section_still_parses() -> void:
    can Memory.Allocate, Abort.Panic:
        # Regression guard: `public:`/`private:` sections must NOT be swallowed as
        # bare const members (`IDENT:` followed by a newline is a section, not a const).
        src: u8& = "module M:\n    public:\n        def g() -> i32:\n            return 1\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1


@test
def test_sequential_can_blocks() -> void:
    can Memory.Allocate, Abort.Panic:
        # Two sibling `can …:` blocks: the first block's trailing-can scan must not
        # swallow the second block's opener (which would orphan its colon).
        src: u8& = "def f() -> i32:\n    can A.B:\n        return 1\n    can A.C:\n        return 2\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 2
        match body[0]:
            Stmt.Block(kind, clause, binding, inner, bline):
                assert kind == "can"
            _:
                assert false
        match body[1]:
            Stmt.Block(kind, clause, binding, inner, bline):
                assert kind == "can"
            _:
                assert false


@test
def test_law_decl_captures_predicate() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "law commutes(a, b) = add(a, b) == add(b, a)\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Law(name, predicate, line):
                assert name == "commutes"
                assert predicate == "(a, b) = add(a, b) == add(b, a)"
            _:
                assert false


@test
def test_region_poly_param_annotation() -> void:
    can Memory.Allocate, Abort.Panic:
        # `def f[@r](out: darray[u8]& @r)` — the trailing `@r` region binding on a
        # param type must be consumed (was orphaned → the `)` failed to parse).
        src: u8& = "def f[@r](out: mutable darray[u8]& @r, v: u8) -> void:\n    pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Func(name, params, return_type, body, effects, decorators, line):
                assert name == "f"
                assert params.count == 2
            _:
                assert false


@test
def test_catch_arms_modeled() -> void:
    can Memory.Allocate, Abort.Panic:
        # `catch EXPR:` is a match-like construct: a `n:` success arm, error-variant
        # pattern arms, and a catch-all `error e:` — all parsed as arms, not statements.
        src: u8& = "def f() -> void:\n    catch do_load(path):\n        n:\n            return\n        ModuleError.MapFailed(v):\n            log(v)\n        error e:\n            return\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.Match(scrutinee, arms, line):
                assert arms.count == 3
            _:
                assert false


@test
def test_error_block_binding() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f() -> void:\n    error e:\n        pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.Block(kind, clause, binding, inner, line):
                assert kind == "error"
                assert binding == "e"
                assert clause.count == 0
            _:
                assert false
