@test
def test_expression_bodied_function() -> void:
    can Memory.Allocate, Abort.Panic:
        # `def f(...) -> T = EXPR` == a body of a single `return EXPR`. An unused
        # parameter is named `_` (no discard statement needed).
        src: u8& = "def area(w: i64, h: i64) -> i64 = w * h\ndef stub(_: void&?) -> int = 0\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 2
        # The first func's body is a single synthesized `return EXPR`.
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.Return(value, rline):
                pass
            _:
                assert false


@test
def test_removed_shorthand_lambda_rejected() -> void:
    can Memory.Allocate, Abort.Panic:
        # The removed shorthand lambda-param spelling (`fn x: x`, pre-bd208ae) must NOT
        # silently split into two statements (`g: T = fn` + orphaned `x: x`) at 0 errors
        # — params are always parenthesized now (`fn(x) => x`).
        src: u8& = "def h() -> void:\n    g: T = fn x: x\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 1


@test
def test_qualified_module_name_scope() -> void:
    can Memory.Allocate, Abort.Panic:
        # `module A::B::C:` — a `::`-separated namespace chain, recorded verbatim
