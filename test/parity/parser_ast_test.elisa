# Behavioral tests for the stage1 parser: parse a source snippet and assert on the
# resulting AST. Run with `~/.elisac/elisac -emit test test/parity/parser_ast_test.elisa`.
include "../../src/parser/parser.elisa"

using Ast


def parse_snippet(source: u8&) -> Ast::File:
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Token] = frontend_tokenize(source, source)
        return frontend_parser_parse_file(source, tokens)


@test
def test_parses_single_func() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f(x: i64) -> i64:\n    return x\n"
        file: Ast::File = parse_snippet(src)
        assert file.top_decls.count == 1
        assert file.errors.count == 0


# Return the effects of the first top-level Func declaration (empty if none/not a func).
def first_func_effects(file: Ast::File&) -> darray[sview]:
    can Memory.Allocate, Abort.Panic:
        for declaration in file.top_decls:
            match declaration:
                Decl.Func(name, params, return_type, body, effects, decorators, line):
                    return effects
                _:
                    pass
        empty: darray[sview] = []
        return empty


@test
def test_bracketed_effect_grant() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f() -> i64 can[Abort.Panic, Memory.Allocate]:\n    return 0\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        effects: darray[sview] = first_func_effects(file)
        assert effects.count == 2
        assert effects[0] == "Abort.Panic"
        assert effects[1] == "Memory.Allocate"


@test
def test_bare_effect_grant() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f() -> i64 can Abort.Panic, Memory.Allocate:\n    return 0\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        effects: darray[sview] = first_func_effects(file)
        assert effects.count == 2
        assert effects[0] == "Abort.Panic"
        assert effects[1] == "Memory.Allocate"


@test
def test_no_effect_grant_is_empty() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f() -> i64:\n    return 0\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert first_func_effects(file).count == 0


# Return the decorators of the first top-level Func declaration.
def first_func_decorators(file: Ast::File&) -> darray[sview]:
    can Memory.Allocate, Abort.Panic:
        for declaration in file.top_decls:
            match declaration:
                Decl.Func(name, params, return_type, body, effects, decorators, line):
                    return decorators
                _:
                    pass
        empty: darray[sview] = []
        return empty


@test
def test_decorators_captured() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "@inline(always)\n@hot\ndef f() -> i64:\n    return 0\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        decorators: darray[sview] = first_func_decorators(file)
        assert decorators.count == 2
        assert decorators[0] == "inline"
        assert decorators[1] == "hot"


@test
def test_bracketed_attribute_list() -> void:
    can Memory.Allocate, Abort.Panic:
        # `@[a, b]` attribute-list form == separate `@a`/`@b` lines.
        src: u8& = "@[noalloc, nolock]\ndef f() -> i32:\n    return 0\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        decorators: darray[sview] = first_func_decorators(file)
        assert decorators.count == 2
        assert decorators[0] == "noalloc"
        assert decorators[1] == "nolock"


@test
def test_undecorated_func_has_no_decorators() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f() -> i64:\n    return 0\n"
        file: Ast::File = parse_snippet(src)
        assert first_func_decorators(file).count == 0


# The first top-level func's body, or an empty list if there is none.
def first_func_body(file: Ast::File&) -> darray[Ast::Stmt]:
    can Memory.Allocate, Abort.Panic:
        for declaration in file.top_decls:
            match declaration:
                Decl.Func(name, params, return_type, body, effects, decorators, line):
                    return body
                _:
                    pass
        empty: darray[Ast::Stmt] = []
        return empty


@test
def test_region_block_kind_and_clause() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f() -> void:\n    region scratch(1024):\n        pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.Block(kind, clause, binding, inner, line):
                assert kind == "region"
                assert clause.count == 1
                assert clause[0] == "scratch"
                assert binding == ""
            _:
                assert false


@test
def test_effect_block_kind_and_clause() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f() -> void:\n    can Mem.Allocate:\n        pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.Block(kind, clause, binding, inner, line):
                assert kind == "can"
                assert clause.count == 2
                assert clause[0] == "Mem"
                assert clause[1] == "Allocate"
            _:
                assert false


@test
def test_contract_stmts_modeled() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f(a: i64) -> i64:\n    requires a >= 0\n    ensure result >= a\n    decreases a\n    return a\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 4                         # was silently split into 7
        match body[0]:
            Stmt.Contract(kind, expression, line):
                assert kind == "requires"
            _:
                assert false
        match body[1]:
            Stmt.Contract(kind, expression, line):
                assert kind == "ensure"
            _:
                assert false


@test
def test_submit_task_call() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f() -> void:\n    submit worker(1)\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1                         # was silently split into 2


@test
def test_contract_name_still_plain_local() -> void:
    can Memory.Allocate, Abort.Panic:
        # A local named `ensure` used in ordinary binding position must NOT
        # be swallowed by the contract-statement dispatch.
        src: u8& = "def f() -> i64:\n    ensure: i64 = 1\n    return ensure\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 2
        match body[0]:
            Stmt.VarDecl(name, type_expression, value, line):
                assert name == "ensure"
            _:
                assert false


@test
def test_const_module_bare_members() -> void:
    can Memory.Allocate, Abort.Panic:
        # `const module` members drop the `const` keyword (zero-overhead constants).
        src: u8& = "const module PROJ:\n    NONE: i32 = 0\n    ROCKET: i32 = 2\n    FIRE = 3\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Module(name, body, line):
                assert name == "PROJ"
                assert body.count == 3
                match body[0]:
                    Decl.Const(cname, ctype, cval, cmut, cline):
                        assert cname == "NONE"
                    _:
                        assert false
            _:
                assert false


@test
def test_module_visibility_section_still_parses() -> void:
    can Memory.Allocate, Abort.Panic:
        # Regression guard: `public:`/`private:` sections must NOT be swallowed as
        # bare const members (`IDENT:` followed by a newline is a section, not a const).
        src: u8& = "module M:\n    public:\n        def g() -> i32:\n            return 1\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1


@test
def test_using_decl_list_and_selective_form_parse() -> void:
    can Memory.Allocate, Abort.Panic:
        # `using` lines may carry multiple targets; a selective target with a brace
        # member list must be consumed whole so the next declaration still parses.
        src: u8& = "using Core::fmt, Math.{sin, cos}, Util as U\ndef f() -> i64 = 1\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1


@test
def test_sequential_can_blocks() -> void:
    can Memory.Allocate, Abort.Panic:
        # Two sibling `can …:` blocks: the first block's trailing-can scan must not
        # swallow the second block's opener (which would orphan its colon).
        src: u8& = "def f() -> i32:\n    can A.B:\n        return 1\n    can A.C:\n        return 2\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 2
        match body[0]:
            Stmt.Block(kind, clause, binding, inner, bline):
                assert kind == "can"
            _:
                assert false
        match body[1]:
            Stmt.Block(kind, clause, binding, inner, bline):
                assert kind == "can"
            _:
                assert false


@test
def test_law_decl_captures_predicate() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "law commutes(a, b) = add(a, b) == add(b, a)\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Law(name, predicate, line):
                assert name == "commutes"
                assert predicate == "(a, b) = add(a, b) == add(b, a)"
            _:
                assert false


@test
def test_region_poly_param_annotation() -> void:
    can Memory.Allocate, Abort.Panic:
        # `def f[@r](out: darray[u8]& @r)` — the trailing `@r` region binding on a
        # param type must be consumed (was orphaned → the `)` failed to parse).
        src: u8& = "def f[@r](out: mutable darray[u8]& @r, v: u8) -> void:\n    pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Func(name, params, return_type, body, effects, decorators, line):
                assert name == "f"
                assert params.count == 2
            _:
                assert false


@test
def test_catch_arms_modeled() -> void:
    can Memory.Allocate, Abort.Panic:
        # `catch EXPR:` is a match-like construct: a `n:` success arm, error-variant
        # pattern arms, and a catch-all `error e:` — all parsed as arms, not statements.
        src: u8& = "def f() -> void:\n    catch do_load(path):\n        n:\n            return\n        ModuleError.MapFailed(v):\n            log(v)\n        error e:\n            return\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.Match(scrutinee, arms, line):
                assert arms.count == 3
            _:
                assert false


@test
def test_expect_pattern_block_has_panic_fallback() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f(node: i64) -> i64:\n    expect node as 1:\n        return node\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.Match(scrutinee, arms, line):
                assert arms.count == 2
                match arms[1].body[0]:
                    Stmt.Expr(expression, line_2):
                        match expression:
                            Expr.Call(callee, arguments, argument_names, call_line):
                                match callee:
                                    Expr.Ident(name, ident_line):
                                        assert name == "panic"
                                    _:
                                        assert false
                                assert arguments.count == 1
                                match arguments[0]:
                                    Expr.StringLit(text):
                                        assert text == "expect pattern failed"
                                    _:
                                        assert false
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false


@test
def test_expect_let_has_panic_fallback() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f(node: i64) -> void:\n    expect let value = node\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.Match(scrutinee, arms, line):
                assert arms.count == 2
                match arms[1].pattern:
                    Pattern.Wildcard:
                        pass
                    _:
                        assert false
                match arms[1].body[0]:
                    Stmt.Expr(expression, line_2):
                        match expression:
                            Expr.Call(callee, arguments, argument_names, call_line):
                                match callee:
                                    Expr.Ident(name, ident_line):
                                        assert name == "panic"
                                    _:
                                        assert false
                                assert arguments.count == 1
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false


@test
def test_for_bind_modes() -> void:
    can Memory.Allocate, Abort.Panic:
        # `for mutable x in xs:` mutates elements in place; plain `for x in xs:` reads
        # (mechanism inferred — affine elements auto-borrow). The intent rides on
        # Stmt.For. The removed `ref` / `mutable ref` spellings are stage0 errors.
        src: u8& = "def f(xs: mutable darray[i64]&) -> void:\n    for mutable x in xs:\n        x <- x + 1\n    for z in xs:\n        pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 2
        match body[0]:
            Stmt.For(bind, variables, iterable, inner, line):
                assert bind == "mutable"
                assert variables.count == 1
                assert variables[0] == "x"
            _:
                assert false
        match body[1]:
            Stmt.For(bind, variables, iterable, inner, line):
                assert bind == ""
                assert variables[0] == "z"
            _:
                assert false


@test
def test_for_ref_as_variable_name() -> void:
    can Memory.Allocate, Abort.Panic:
        # With the `ref` binder removed, `ref` is an ordinary identifier — a loop
        # variable named `ref` parses with no special-casing.
        src: u8& = "def f(xs: darray[i64]) -> void:\n    for ref in xs:\n        pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.For(bind, variables, iterable, inner, line):
                assert bind == ""
                assert variables.count == 1
                assert variables[0] == "ref"
            _:
                assert false


@test
def test_for_removed_ref_binder_rejected() -> void:
    can Memory.Allocate, Abort.Panic:
        # The removed `for ref x in xs:` mechanism spelling must NOT silently parse
        # as a mode (stage0 gives the directed error; stage1 reports a parse error).
        src: u8& = "def f(xs: darray[i64]) -> void:\n    for ref x in xs:\n        pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count > 0


@test
def test_struct_layout_clause() -> void:
    can Memory.Allocate, Abort.Panic:
        # Unified postfix layout clause: `struct X layout(soa):` (the prefix
        # `layout soa struct` and bare `layout soa` spellings were removed).
        src: u8& = "struct Store layout(soa):\n    xs: darray[i64]\n    ys: darray[i64]\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Struct(name, members, affinity, line):
                assert name == "Store"
                assert members.count == 2
            _:
                assert false


@test
def test_guest_overlay_struct() -> void:
    can Memory.Allocate, Abort.Panic:
        # Typed guest-memory overlay as a struct: `struct X layout(guest, size: N):`
        # with `field: type at OFFSET [requires size >= N]` members (docs/107).
        src: u8& = "struct ProcParamOverlay layout(guest, size: 72):\n    size: u64 at 0\n    mem_param: u64 at 64 requires size >= 72\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Struct(name, members, affinity, line):
                assert name == "ProcParamOverlay"
                assert members.count == 2
                assert members[0].name == "size"
                assert members[1].name == "mem_param"
            _:
                assert false


@test
def test_range_for_with_stride() -> void:
    can Memory.Allocate, Abort.Panic:
        # The range stride is spelled on the range: `for i in 0..<n..2:` (the
        # `step N` spelling is rejected by stage0 — it was silent truncation).
        src: u8& = "def f(n: usize) -> void:\n    for i in 0..<n..2:\n        pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.For(bind, variables, iterable, inner, line):
                assert variables.count == 1
                assert variables[0] == "i"
            _:
                assert false


@test
def test_struct_linear_affinity() -> void:
    can Memory.Allocate, Abort.Panic:
        # `linear struct X:` — must-consume-exactly-once discipline.
        src: u8& = "linear struct FsGuard:\n    fd: i32\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Struct(name, members, affinity, line):
                assert name == "FsGuard"
                assert affinity == "linear"
                assert members.count == 1
            _:
                assert false


@test
def test_struct_affine_affinity() -> void:
