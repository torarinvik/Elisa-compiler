@test
def test_call_arg_forwarding_surface() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def consume(parser: i64, offset: i64, width: i64 = 0) -> i64:\n    return parser + offset + width\n\ndef build(parser: i64, offset: i64) -> i64:\n    return consume(.., width: 9)\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 2
        match file.top_decls[1]:
            Decl.Func(name, params, return_type, body, effects, decorators, line):
                match body[0]:
                    Stmt.Return(value, return_line):
                        match value:
                            Expr.Call(callee, arguments, argument_names, call_line):
                                assert arguments.count == 1
                                assert argument_names.count == 1
                                assert argument_names[0] == "width"
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false


@test
def test_invalid_call_arg_forwarding_rejected() -> void:
    can Memory.Allocate, Abort.Panic:
        duplicate: u8& = "def consume(x: i64) -> i64:\n    return x\n\ndef build(x: i64) -> i64:\n    return consume(.., ..)\n"
        not_first: u8& = "def consume(x: i64, y: i64) -> i64:\n    return x + y\n\ndef build(x: i64, y: i64) -> i64:\n    return consume(y: y, ..)\n"
        positional_after: u8& = "def consume(x: i64, y: i64) -> i64:\n    return x + y\n\ndef build(x: i64, y: i64) -> i64:\n    return consume(.., y)\n"
        assert parse_snippet(duplicate).errors.count > 0
        assert parse_snippet(not_first).errors.count > 0
        assert parse_snippet(positional_after).errors.count > 0


@test
def test_catch_arms_modeled() -> void:
    can Memory.Allocate, Abort.Panic:
        # `catch EXPR:` is a match-like construct: a `n:` success arm, error-variant
        # pattern arms, and a catch-all `error e:` — all parsed as arms, not statements.
        src: u8& = "def f() -> void:\n    catch do_load(path):\n        n:\n            return\n        ModuleError.MapFailed(v):\n            log(v)\n        error e:\n            return\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.Match(scrutinee, arms, line):
                assert arms.count == 3
            _:
                assert false


@test
def test_expect_pattern_block_has_panic_fallback() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f(node: i64) -> i64:\n    expect node as 1:\n        return node\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.Match(scrutinee, arms, line):
                assert arms.count == 2
                match arms[1].body[0]:
                    Stmt.Expr(expression, line_2):
                        match expression:
                            Expr.Call(callee, arguments, argument_names, call_line):
                                match callee:
                                    Expr.Ident(name, ident_line):
                                        assert name == "panic"
                                    _:
                                        assert false
                                assert arguments.count == 1
                                match arguments[0]:
                                    Expr.StringLit(text):
                                        assert text == "expect pattern failed"
                                    _:
                                        assert false
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false


@test
def test_expect_let_has_panic_fallback() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f(node: i64) -> void:\n    expect let value = node\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.Block(kind, clause, binding, lowered, line):
                assert kind == "expect"
                assert lowered.count == 2
                match lowered[0]:
                    Stmt.Match(scrutinee, arms, match_line):
                        assert arms.count == 2
                        match arms[1].pattern:
                            Pattern.Wildcard:
                                pass
                            _:
                                assert false
                        match arms[1].body[0]:
                            Stmt.Expr(expression, line_2):
                                match expression:
                                    Expr.Call(callee, arguments, argument_names, call_line):
                                        match callee:
                                            Expr.Ident(name, ident_line):
                                                assert name == "panic"
                                            _:
                                                assert false
                                        assert arguments.count == 1
                                    _:
                                        assert false
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false


@test
def test_catch_requires_success_arm() -> void:
    can Memory.Allocate, Abort.Panic:
        # Stage0 rejected a catch block that starts with an error-binding arm; the
        # parser should surface a diagnostic instead of silently accepting it.
        src: u8& = "def f() -> void:\n    catch do_load(path):\n        error e:\n            return\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count > 0


@test
def test_for_bind_modes() -> void:
    can Memory.Allocate, Abort.Panic:
        # `for mutable x in xs:` mutates elements in place; plain `for x in xs:` reads
        # (mechanism inferred — affine elements auto-borrow). The intent rides on
        # Stmt.For. The removed `ref` / `mutable ref` spellings are stage0 errors.
        src: u8& = "def f(xs: mutable darray[i64]&) -> void:\n    for mutable x in xs:\n        x <- x + 1\n    for z in xs:\n        pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 2
        match body[0]:
            Stmt.For(bind, variables, iterable, inner, line):
                assert bind == "mutable"
                assert variables.count == 1
                assert variables[0] == "x"
            _:
                assert false
        match body[1]:
            Stmt.For(bind, variables, iterable, inner, line):
                assert bind == ""
                assert variables[0] == "z"
            _:
                assert false


@test
def test_for_ref_as_variable_name() -> void:
    can Memory.Allocate, Abort.Panic:
        # With the `ref` binder removed, `ref` is an ordinary identifier — a loop
        # variable named `ref` parses with no special-casing.
        src: u8& = "def f(xs: darray[i64]) -> void:\n    for ref in xs:\n        pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.For(bind, variables, iterable, inner, line):
                assert bind == ""
                assert variables.count == 1
                assert variables[0] == "ref"
            _:
                assert false


@test
def test_for_removed_ref_binder_rejected() -> void:
    can Memory.Allocate, Abort.Panic:
        # The removed `for ref x in xs:` mechanism spelling must NOT silently parse
        # as a mode (stage0 gives the directed error; stage1 reports a parse error).
        src: u8& = "def f(xs: darray[i64]) -> void:\n    for ref x in xs:\n        pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count > 0


@test
def test_struct_layout_clause() -> void:
    can Memory.Allocate, Abort.Panic:
        # Unified postfix layout clause: `struct X layout(soa):` (the prefix
        # `layout soa struct` and bare `layout soa` spellings were removed).
        src: u8& = "struct Store layout(soa):\n    xs: darray[i64]\n    ys: darray[i64]\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Struct(name, members, affinity, _, _, _, line):
                assert name == "Store"
                assert members.count == 2
            _:
                assert false


@test
def test_guest_overlay_struct() -> void:
    can Memory.Allocate, Abort.Panic:
        # Typed guest-memory overlay as a struct: `struct X layout(guest, size: N):`
        # with `field: type at OFFSET [requires size >= N]` members (docs/107).
        src: u8& = "struct ProcParamOverlay layout(guest, size: 72):\n    size: u64 at 0\n    mem_param: u64 at 64 requires size >= 72\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Struct(name, members, affinity, _, _, _, line):
                assert name == "ProcParamOverlay"
                assert members.count == 2
                assert members[0].name == "size"
                assert members[1].name == "mem_param"
            _:
                assert false


@test
def test_ghost_struct_field_is_structured() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "struct Model:\n    ghost proof: bool\n    value: i64\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match file.top_decls[0]:
            Decl.Struct(name, members, _, _, _, _, _):
                assert name == "Model"
                assert members.count == 2
                assert members[0].name == "proof"
                assert members[0].is_ghost
                assert not members[1].is_ghost
            _:
                assert false


@test
def test_range_for_with_stride() -> void:
    can Memory.Allocate, Abort.Panic:
        # The range stride is spelled on the range: `for i in 0..<n..2:` (the
        # `step N` spelling is rejected by stage0 — it was silent truncation).
        src: u8& = "def f(n: usize) -> void:\n    for i in 0..<n..2:\n        pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        assert body.count == 1
        match body[0]:
            Stmt.For(bind, variables, iterable, inner, line):
                assert variables.count == 1
                assert variables[0] == "i"
            _:
                assert false


@test
def test_membership_expression_precedence() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def keep(value: i64, other: bool) -> bool:\n    return value in [1, 2, 3] and other\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        match body[0]:
            Stmt.Return(value, line):
                match value:
                    Expr.Binary(left, operator, right, binary_line):
                        assert operator == TokenKind.And
                        match left:
                            Expr.Binary(member_left, member_operator, member_right, member_line):
                                assert member_operator == TokenKind.In
                                match member_right:
                                    Expr.Array(elements, array_line):
                                        assert elements.count == 3
                                    _:
                                        assert false
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false


@test
def test_not_in_membership_expression() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def keep(value: i64, other: bool) -> bool:\n    return value not in {1, 2, 3} and other\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        match body[0]:
            Stmt.Return(value, line):
                match value:
                    Expr.Binary(left, operator, right, binary_line):
                        assert operator == TokenKind.And
                        match left:
                            Expr.Unary(unary_operator, operand, unary_line):
                                assert unary_operator == TokenKind.Not
                                match operand:
                                    Expr.Binary(member_left, member_operator, member_right, member_line):
                                        assert member_operator == TokenKind.In
                                        match member_right:
                                            Expr.SetLit(elements, set_line):
                                                assert elements.count == 3
                                            _:
                                                assert false
                                    _:
                                        assert false
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false


@test
def test_membership_range_expression() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def keep(ch: char) -> bool:\n    return ch in 'a'..='z'\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        match body[0]:
            Stmt.Return(value, line):
                match value:
                    Expr.Binary(left, operator, right, binary_line):
                        assert operator == TokenKind.In
                        match right:
                            Expr.Binary(range_left, range_operator, range_right, range_line):
                                assert range_operator == TokenKind.RangeLe
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false


@test
def test_struct_linear_affinity() -> void:
    can Memory.Allocate, Abort.Panic:
        # `linear struct X:` — must-consume-exactly-once discipline.
        src: u8& = "linear struct FsGuard:\n    fd: i32\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Struct(name, members, affinity, _, _, _, line):
                assert name == "FsGuard"
                assert affinity == "linear"
                assert members.count == 1
            _:
                assert false


