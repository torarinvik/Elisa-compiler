@test
def test_parenthesized_where_view_is_comprehension() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("def keep(items: darray[i64]) -> bool:\n    return all((items where item: item > 0))\n")
        assert file.errors.count == 0
        match first_func_body(file)[0]:
            Stmt.Return(value, line):
                match value:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match arguments[0]:
                            Expr.Comprehension(name, iterable, condition, body, query_line):
                                assert name == "item"
                                match condition:
                                    Expr.Binary(left, operator, right, condition_line):
                                        assert operator == TokenKind.Gt
                                    _:
                                        assert false
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false


@test
def test_return_if_value_has_conditional_blocks() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("def choose(flag: bool) -> i64:\n    return if flag:\n        1\n    else:\n        2\n")
        assert file.errors.count == 0
        match first_func_body(file)[0]:
            Stmt.Return(value, line):
                match value:
                    Expr.If(condition, then_value, else_value, if_line):
                        match then_value:
                            Expr.Block(stmts, tail_value, captures, block_line):
                                match tail_value:
                                    Expr.IntLit(number):
                                        assert number == 1
                                    _:
                                        assert false
                            _:
                                assert false
                        match else_value:
                            Expr.Block(stmts, tail_value, captures, block_line):
                                match tail_value:
                                    Expr.IntLit(number):
                                        assert number == 2
                                    _:
                                        assert false
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false


