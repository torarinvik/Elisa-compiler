@test
def test_struct_linear_with_layout_clause() -> void:
    can Memory.Allocate, Abort.Panic:
        # The affinity modifier and a postfix layout(...) clause compose.
        src: u8& = "linear struct Handle layout(c):\n    fd: i32\n"
        file: Ast::File = parse_snippet(src)
