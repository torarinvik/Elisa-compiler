module Backend:
    public:
        def zero_probe_placeholder() -> i32:
            0

include "../../src/backend/llvm_c.elisa"
include "../../src/driver/elisac_artifact_identity.elisa"
include "../../src/backend/codegen_split_half.elisa"
include "../../src/backend/codegen_zero_forward.elisa"
extern LLVMParseIRInContext(ctx: LLVMContextRef, buffer: void&, module_out: mutable LLVMModuleRef&, message_out: void&) -> i32
extern LLVMGetLastInstruction(block: LLVMBasicBlockRef) -> LLVMValueRef

def zf_probe_expected(module: LLVMModuleRef, name: cstr, should_fold: bool) -> bool:
    if LLVMGetNamedFunction(module, name) is fn:
        if LLVMGetFirstBasicBlock(fn) is block:
            terminator: LLVMValueRef = LLVMGetLastInstruction(block)
            result: LLVMValueRef = LLVMGetOperand(terminator, 0)
            if should_fold:
                return LLVMIsAConstantInt(result) != null and LLVMConstIntGetZExtValue(result) == 0
            return LLVMIsAInstruction(result) != null and LLVMGetInstructionOpcode(result) == 27
    false

def main() -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read]:
    context: LLVMContextRef = LLVMContextCreate()
    buffer: mutable void&? = null
    message: mutable void&? = null
    placeholder: LLVMModuleRef = LLVMModuleCreateWithNameInContext("placeholder", context)
    module: mutable LLVMModuleRef = placeholder
    status: mutable i32 = LLVMCreateMemoryBufferWithContentsOfFile("test/parity/stage1_zero_forward_fixture.ll", (&buffer).cast[void&], (&message).cast[void&]) can Unsafe.PointerCast
    return 80 if status != 0
    if buffer is loaded:
        status <- LLVMParseIRInContext(context, loaded, &module, (&message).cast[void&]) can Unsafe.PointerCast
    LLVMDisposeModule(placeholder)
    return 81 if status != 0
    if module != zeroed:
        return 82 if LLVMVerifyModule(module, 2, null) != 0
        changed: mutable usize = 0
        can Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read:
            changed <- Backend::forward_zeroed_stack_loads(module)
        return 83 if LLVMVerifyModule(module, 2, null) != 0
        return 84 if changed != 4
        return 85 if not zf_probe_expected(module, "covered", true)
        return 86 if not zf_probe_expected(module, "nonzero", false)
        return 87 if not zf_probe_expected(module, "overlap", false)
        return 88 if not zf_probe_expected(module, "partial", false)
        return 89 if not zf_probe_expected(module, "escape", false)
        return 90 if not zf_probe_expected(module, "volatile", false)
        return 91 if not zf_probe_expected(module, "unaligned", false)
        return 92 if not zf_probe_expected(module, "intervening_call", false)
        return 93 if not zf_probe_expected(module, "dynamic_gep", false)
        return 94 if not zf_probe_expected(module, "out_of_range", false)
        return 96 if not zf_probe_expected(module, "covered8", true)
        return 97 if not zf_probe_expected(module, "covered16", true)
        return 98 if not zf_probe_expected(module, "covered32", true)
        return 99 if not zf_probe_expected(module, "atomic_load", false)
        return 100 if not zf_probe_expected(module, "atomic_store", false)
        return 101 if not zf_probe_expected(module, "cast_escape", false)
        return 102 if not zf_probe_expected(module, "volatile_memset", false)
        return 103 if not zf_probe_expected(module, "last_memset_nonzero", false)
        return 104 if not zf_probe_expected(module, "range_metadata", false)
        return 105 if not zf_probe_expected(module, "zero_length", false)
        return 106 if not zf_probe_expected(module, "oversized_length", false)
        return 107 if not zf_probe_expected(module, "negative_gep", false)
        return 108 if not zf_probe_expected(module, "non_inbounds_gep", false)
        return 109 if not zf_probe_expected(module, "pointer_escape_store", false)
        return 110 if not zf_probe_expected(module, "fence_barrier", false)
        return 111 if not zf_probe_expected(module, "debug_location", false)
        if LLVMGetNamedFunction(module, "cross_block") is cross_fn:
            if LLVMGetFirstBasicBlock(cross_fn) is entry_block:
                if LLVMGetNextBasicBlock(entry_block) is next_block:
                    cross_ret: LLVMValueRef = LLVMGetLastInstruction(next_block)
                    cross_load: LLVMValueRef = LLVMGetOperand(cross_ret, 0)
                    return 112 if LLVMIsAInstruction(cross_load) == null or LLVMGetInstructionOpcode(cross_load) != 27
                else:
                    return 113
            else:
                return 114
        else:
            return 115
        LLVMDisposeModule(module)
        LLVMContextDispose(context)
        return 0
    95
