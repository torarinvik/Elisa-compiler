# Filtering annotation metadata must preserve fulfillment order and duplicates.
include "../../src/semantic/semantic.elisa"

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    EXPECTED_DIAGNOSTICS: usize = 3
    source: u8& = "law Quiet forbids Console.Write\nlaw Composite includes Quiet\nstruct Unrelated:\n    value: i64\nmodule Cases:\n    def duplicate() fulfills Quiet fulfills Quiet:\n        can Console.Write:\n            pass\n    module Nested:\n        def composite() fulfills Composite:\n            can Console.Write:\n                pass\n        def accepted() fulfills Quiet:\n            pass\n    def unconstrained():\n        can Console.Write:\n            pass\n"
    length: mutable usize = 0
    while source[length] != 0 |length|:
        length <- length + 1
    tokens: darray[Token] = frontend_tokenize_with_length(source, source, length)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    assert file.errors.count == 0
    table: mutable Semantic::SymbolTable = Semantic::collect_symbols(file)
    table <- Semantic::check_effect_law_fulfillment(file, table)
    assert table.diagnostics.count == EXPECTED_DIAGNOSTICS
    assert table.diagnostics[0].kind == Semantic::DiagnosticKind.EffectLawViolation
    assert table.diagnostics[0].name == "duplicate"
    assert table.diagnostics[0].expected == "Quiet"
    assert table.diagnostics[0].actual == "Console.Write"
    assert table.diagnostics[1].kind == Semantic::DiagnosticKind.EffectLawViolation
    assert table.diagnostics[1].name == "duplicate"
    assert table.diagnostics[1].expected == "Quiet"
    assert table.diagnostics[1].actual == "Console.Write"
    assert table.diagnostics[2].kind == Semantic::DiagnosticKind.EffectLawViolation
    assert table.diagnostics[2].name == "composite"
    assert table.diagnostics[2].expected == "Composite"
    assert table.diagnostics[2].actual == "Console.Write"
    return 0
