# Str dispatch must preserve source type identity, even for equal machine types.
include "../../elisacore_std/elisacore_runtime.elisa"

struct PrintTag:
    text: cstr

impl Str for PrintTag:
    def __cast__(self: PrintTag) -> cstr:
        return self.text

struct OtherPrintTag:
    text: cstr

impl Str for OtherPrintTag:
    def __cast__(self: OtherPrintTag) -> cstr:
        return self.text

def main() -> i64:
    value_0: char = 'A'
    value_1: int = -12345
    value_2: i64 = 751804663071387784
    value_3: i32 = -1234567
    value_4: i16 = -1234
    value_5: i8 = -12
    value_6: u64 = 18446744073709551615
    value_7: u32 = 4000000000
    value_8: u16 = 60000
    value_9: u8 = 240
    value_10: usize = 123456
    value_11: uintptr = 234567
    value_12: f64 = 1.25
    value_13: f32 = 2.5
    value_14: bool = true
    value_15: bool = false
    value_16: cstr = "text"
    value_17: PrintTag = PrintTag{text: "first custom"}
    value_18: OtherPrintTag = OtherPrintTag{text: "second custom"}
    checksum: i64 = -432360
    can Memory.Allocate, Console{Format,Write}, Abort.Panic, Global{Read,Write}, Atomics{Exchange,Store}:
        print(value_0)
        print(value_1)
        print(checksum)
        print(value_2)
        print(value_3)
        print(value_4)
        print(value_5)
