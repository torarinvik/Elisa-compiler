include "../../src/semantic/semantic.elisa"

extend Semantic:
    public:
        def contract_annotation_filter_test() -> i64 can[Memory.Allocate, Abort.Panic]:
            rows: darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "C", name: "__contract_decl", line: 11}, Ast::EnumAnnotation{owner: "C", name: "__other", line: 12}, Ast::EnumAnnotation{owner: "D", name: "__contract_decl", line: 13}, Ast::EnumAnnotation{owner: "C", name: "__contract_decl", line: 11}]
            filtered: mutable darray[Ast::EnumAnnotation] = []
            for annotation in rows |filtered|:
                filtered.push(annotation) if uses_contract_decl_annotation(annotation)
            assert filtered.count == 3
            assert filtered[0].owner == "C"
            assert filtered[1].owner == "D"
            assert filtered[2].line == 11
            assert not uses_contract_decl_annotation(Ast::EnumAnnotation{owner: "C", name: "__other", line: 12})
            return 0

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return Semantic::contract_annotation_filter_test()
