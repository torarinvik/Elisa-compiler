# Real module data layouts select 32/64-bit behavior independently of ambient target defaults.
# Explicit 32-bit LLVM layouts are also checked independently of the target environment.
include "../../src/backend/codegen.elisa"

extend Backend:
    public:
        def check_packed_target_width(source: u8& @source, layout: cstr, pointer_bytes: u32, inline_enabled: bool) -> void:
            can Memory.Allocate, Abort.Panic, Unsafe{PointerArithmetic,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}:
                length: mutable usize = 0
                while source[length] != 0 |length|:
                    length <- length + 1
                tokens: darray[Lexer::Token] = frontend_tokenize_with_length(source, source, length)
                file: Ast::File = frontend_parser_parse_file(source, tokens)
                assert (file.errors.count == 0)
                compiler_marker: mutable bool = false
                for annotation in file.enum_annotations |compiler_marker|:
                    compiler_marker <- true if annotation.name == "__compiler_ast_refinement" and annotation.owner == "Expr"
                assert compiler_marker
                ctx: LLVMContextRef = LLVMContextCreate()
                m: LLVMModuleRef = LLVMModuleCreateWithNameInContext("packed_store_match", ctx)
                LLVMSetDataLayout(m, layout)
                table: mutable StructTable = new_struct_table(ctx, LLVMGetModuleDataLayout(m))
                top: darray[Decl] = select_module_declarations(file, table)
                register_module_types(file, top, table, m, ctx)
                table.visibility with {current_owner <- "Ast"}
                root: i64 = packed_index_of(table, "Node")
                refinement: i64 = packed_index_of(table, "Expr")
                other: i64 = packed_index_of(table, "Other")
                assert root >= 0 and refinement >= 0 and other >= 0
                assert packed_root_index_of(table, refinement) == root
                assert packed_store_matches_hierarchy(table, root, refinement)
                assert packed_store_matches_hierarchy(table, refinement, refinement)
                assert not packed_store_matches_hierarchy(table, other, refinement)
                assert not packed_store_matches_hierarchy(table, -1, refinement)
                assert not packed_store_matches_hierarchy(table, 99999, 99999)
                LLVMDisposeModule(m)
                LLVMContextDispose(ctx)

def main() -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe{PointerArithmetic,PointerCast,RawExtern,UncheckedIndex}, Global{Read,Write}:
        Backend::check_packed_target_width("extend Ast:\n    packed enum Other:\n        Item(value: i64)\n    struct Pos:\n        line: u32\n        column: u32\n        offset: u32\n        end_line: u32\n        end_column: u32\n        end_offset: u32\n    enum Node layout(handle: u32):\n        pass\n    enum Expr is Node:\n        V0(pos: Pos)\n        V1(pos: Pos)\n        V2(pos: Pos)\n        V3(pos: Pos)\n        V4(pos: Pos)\n        V5(pos: Pos)\n        V6(pos: Pos)\n        V7(pos: Pos)\n        V8(pos: Pos)\n        V9(pos: Pos)\n        V10(pos: Pos)\n        V11(pos: Pos)\n        V12(pos: Pos)\n        V13(pos: Pos)\n        V14(pos: Pos)\n        V15(pos: Pos)\n        V16(pos: Pos)\n        V17(pos: Pos)\n        V18(pos: Pos)\n        V19(pos: Pos)\n        V20(pos: Pos)\n        V21(pos: Pos)\n        V22(pos: Pos)\n        V23(pos: Pos)\n        V24(pos: Pos)\n        V25(pos: Pos)\n        V26(pos: Pos)\n        V27(pos: Pos)\n        V28(pos: Pos)\n        V29(pos: Pos)\n        V30(pos: Pos)\n        V31(pos: Pos)\n        V32(pos: Pos)\n        V33(pos: Pos)\n        V34(pos: Pos)\n        V35(pos: Pos)\n        V36(pos: Pos)\n        V37(pos: Pos)\n        V38(pos: Pos)\n        V39(pos: Pos)\n        V40(pos: Pos)\n        V41(pos: Pos)\n        V42(pos: Pos)\n        V43(pos: Pos)\n        V44(pos: Pos)\n        V45(pos: Pos)\n        V46(pos: Pos)\n        V47(pos: Pos)\n", "e-p:64:64", 8, false)
        return 0
