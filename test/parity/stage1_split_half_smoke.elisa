@inline(never)
def split_add(left: u64, right: u64) -> u64:
    low: u64 = (left & 0xFFFFFFFF) + (right & 0xFFFFFFFF)
    high: u64 = (left >> 32) + (right >> 32) + (low >> 32)
    ((high & 0xFFFFFFFF) << 32) | (low & 0xFFFFFFFF)

@inline(never)
def split_near(left: u64, right: u64) -> u64:
    low: u64 = (left & 0xFFFFFFFF) + (right & 0xFFFFFFFF)
    high: u64 = (left >> 32) + (right >> 32) + (low >> 32) + 1
    ((high & 0xFFFFFFFF) << 32) | (low & 0xFFFFFFFF)

export fn split_add(left: u64, right: u64) -> u64 = split_add
export fn split_near(left: u64, right: u64) -> u64 = split_near
