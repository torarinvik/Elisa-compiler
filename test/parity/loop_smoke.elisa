# Semantic checks for loop iterables and while conditions (stage1 port).
# Exercises NonIterableLoop and NonBoolCondition diagnostics.
include "../../src/semantic/semantic.elisa"


# Count loop-related diagnostics: NonIterableLoop and NonBoolCondition (while-only).
def loop_probe(source: u8&, source_length: usize, non_iterable_count_out: mutable u64&, non_bool_while_count_out: mutable u64&):
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Token] = frontend_tokenize_with_length(source, source, source_length)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        table: Semantic::SymbolTable = Semantic::check(file)
        non_iterable_count_out[0] <- 0
        non_bool_while_count_out[0] <- 0
        for d in table.diagnostics:
            if d.kind == Semantic::DiagnosticKind.NonIterableLoop:
                non_iterable_count_out[0] <- non_iterable_count_out[0] + 1
            elif d.kind == Semantic::DiagnosticKind.NonBoolCondition and d.name == "while":
                non_bool_while_count_out[0] <- non_bool_while_count_out[0] + 1


export fn loop_probe_export(source: u8&, source_length: usize, non_iterable_count_out: mutable u64&, non_bool_while_count_out: mutable u64&) -> void = loop_probe

