# Parser AST tests — DECLARATIONS: laws and their predicates, region-polymorphic parameters,
# default arguments, extern decorator retention, enum payload field names, export targets, call
# argument forwarding, catch arms and `expect`'s panic fallback, and the `for` bind modes.
# Included by parser_ast_test.elisa, which holds the parse helper these all call.

using Ast


@test
def test_law_decl_captures_predicate() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& @source = "law commutes(a, b) = add(a, b) == add(b, a)\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Law(name, predicate, line):
                assert name == "commutes"
                match predicate:
                    Expr.Binary(left, operator, right, predicate_line):
                        pass
                    _:
                        assert false
            _:
                assert false




@test
def test_region_poly_param_annotation() -> void:
    can Memory.Allocate, Abort.Panic:
        # `def f[@r](out: darray[u8]& @r)` — the trailing `@r` region binding on a
        # param type must be consumed (was orphaned → the `)` failed to parse).
        src: u8& @source = "def f[@r](out: mutable darray[u8]& @r, v: u8) -> void:\n    pass\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Func(name, params, return_type, body, effects, decorators, line):
                assert name == "f"
                assert params.count == 2
            _:
                assert false




@test
def test_nested_positional_tuple_type_argument_in_param() -> void:
    can Memory.Allocate, Abort.Panic:
        invalid: Ast::File = parse_snippet("def take(values: darray[(i64, i64)]) -> void:\n    pass\n") can Global{Read,Write}
        mutable_invalid: Ast::File = parse_snippet("def take(values: darray[mutable (i64, i64)]) -> void:\n    pass\n") can Global{Read,Write}
        reference_root_invalid: Ast::File = parse_snippet("def take(value: &(i64, i64)) -> void:\n    pass\n") can Global{Read,Write}
        owned_root_invalid: Ast::File = parse_snippet("def take(value: owned (i64, i64)) -> void:\n    pass\n") can Global{Read,Write}
        owned_nested_invalid: Ast::File = parse_snippet("def take(value: darray[owned (i64, i64)]) -> void:\n    pass\n") can Global{Read,Write}
        mutable_local_invalid: Ast::File = parse_snippet("def main() -> void:\n    values: darray[mutable (i64, i64)] = []\n") can Global{Read,Write}
        boxed_local_invalid: Ast::File = parse_snippet("def main() -> void:\n    values: Box[i64, (i64, i64)] = (1, (2, 3))\n") can Global{Read,Write}
        named: Ast::File = parse_snippet("def take(values: darray[(left: i64, right: i64)]) -> void:\n    pass\n") can Global{Read,Write}
        owned_named: Ast::File = parse_snippet("def take(value: owned (left: i64, right: i64)) -> void:\n    pass\n") can Global{Read,Write}
        assert invalid.errors.count > 0
        assert mutable_invalid.errors.count > 0
        assert reference_root_invalid.errors.count > 0
        assert owned_root_invalid.errors.count > 0
        assert owned_nested_invalid.errors.count > 0
        assert mutable_local_invalid.errors.count > 0
        assert boxed_local_invalid.errors.count > 0
        assert named.errors.count == 0
        assert owned_named.errors.count == 0



@test
def test_tuple_literal_in_parameter_where_predicate_is_not_a_type() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("def take(value: i64 where predicate((1, 2))) -> void:\n    pass\n") can Global{Read,Write}
        assert file.errors.count == 0



@test
def test_nested_positional_tuple_type_arguments_in_other_annotations() -> void:
    can Memory.Allocate, Abort.Panic:
        field_invalid: Ast::File = parse_snippet("struct Holder:\n    values: darray[(i64, i64)]\n") can Global{Read,Write}
        alias_invalid: Ast::File = parse_snippet("type Values = darray[(i64, i64)]\n") can Global{Read,Write}
        return_invalid: Ast::File = parse_snippet("def make() -> darray[(i64, i64)]:\n    return []\n") can Global{Read,Write}
        extern_invalid: Ast::File = parse_snippet("extern make(values: darray[(i64, i64)]) -> darray[(i64, i64)]\n") can Global{Read,Write}
        function_param_invalid: Ast::File = parse_snippet("def take(callback: fn(value: (i64, i64)) -> i64) -> void:\n    pass\n") can Global{Read,Write}
        function_return_invalid: Ast::File = parse_snippet("def take(callback: fn() -> (i64, i64)) -> void:\n    pass\n") can Global{Read,Write}
        function_nested_argument_invalid: Ast::File = parse_snippet("def take(callback: fn(value: darray[(i64, i64)]) -> i64) -> void:\n    pass\n") can Global{Read,Write}
        payload_invalid: Ast::File = parse_snippet("enum Payload:\n    Some(value: darray[(i64, i64)])\n    None\n") can Global{Read,Write}
        common_invalid: Ast::File = parse_snippet("enum Common:\n    common:\n        value: darray[(i64, i64)]\n    None\n") can Global{Read,Write}
        global_invalid: Ast::File = parse_snippet("global values: darray[(i64, i64)] = []\n") can Global{Read,Write}
        assert field_invalid.errors.count > 0
        assert alias_invalid.errors.count > 0
        assert return_invalid.errors.count > 0
        assert extern_invalid.errors.count > 0
        assert function_param_invalid.errors.count > 0
        assert function_return_invalid.errors.count > 0
        assert function_nested_argument_invalid.errors.count > 0
        assert payload_invalid.errors.count > 0
        assert common_invalid.errors.count > 0
        assert global_invalid.errors.count > 0




@test
def test_function_default_args() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& @source = "def build(x: i64, ys: darray[u32] = [], cond: i64? = null) -> i64:\n    return x\n\nextern reserve(xs: darray[i64], want: usize = 0) -> void\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        assert file.top_decls.count == 2
        match file.top_decls[0]:
            Decl.Func(name, params, return_type, body, effects, decorators, line):
                assert name == "build"
                assert params.count == 3
                assert not params[0].has_default
                assert params[1].has_default
                assert params[2].has_default
            _:
                assert false
        match file.top_decls[1]:
            Decl.Extern(name, param_start, arity, variadic, callable, _, decorators, line):
                assert name == "reserve"
            _:
                assert false



@test
def test_field_default_type_head_unwraps_wrappers() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& @source = "struct Defaults:\n    paren_bad: (bool) = 1\n    mutable_paren_bad: mutable (bool) = 1\n    mutable_values: mutable darray[i64] = \"text\"\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        paren_offset: mutable u32 = 0
        mutable_paren_offset: mutable u32 = 0
        mutable_values_offset: mutable u32 = 0
        for annotation in file.enum_annotations |paren_offset, mutable_paren_offset, mutable_values_offset|:
            if annotation.owner == "__field_default_name":
                paren_offset <- annotation.offset if annotation.name == "paren_bad"
                mutable_paren_offset <- annotation.offset if annotation.name == "mutable_paren_bad"
                mutable_values_offset <- annotation.offset if annotation.name == "mutable_values"
        assert paren_offset != 0
        assert mutable_paren_offset != 0
        assert mutable_values_offset != 0
        paren_type_found: mutable bool = false
        mutable_paren_type_found: mutable bool = false
        mutable_values_type_found: mutable bool = false
        for annotation in file.enum_annotations |paren_offset, mutable_paren_offset, mutable_values_offset, paren_type_found, mutable_paren_type_found, mutable_values_type_found|:
            if annotation.owner == "__field_default_type":
                paren_type_found <- true if annotation.offset == paren_offset and annotation.name == "bool"
                mutable_paren_type_found <- true if annotation.offset == mutable_paren_offset and annotation.name == "bool"
                mutable_values_type_found <- true if annotation.offset == mutable_values_offset and annotation.name == "darray"
        assert paren_type_found
        assert mutable_paren_type_found
        assert mutable_values_type_found



@test
def test_variadic_marker_uses_function_owner_offset() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& @source = "#line 0 variadic-owner.elisa\ndef takes_tail(value: i64, ...) -> void:\n    pass\n#line 0 variadic-owner.elisa\ndef takes_fixed(value: i64) -> void:\n    pass\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        tail_offset: mutable u32 = 0
        fixed_offset: mutable u32 = 0
        for declaration in file.top_decls |tail_offset, fixed_offset|:
            match declaration:
                Decl.Func(name, _, _, _, _, _, position):
                    tail_offset <- position.offset if name == "takes_tail" and position.line == 0
                    fixed_offset <- position.offset if name == "takes_fixed" and position.line == 0
                _:
                    pass
        assert tail_offset != 0
        assert fixed_offset != 0
        assert tail_offset != fixed_offset
        marker_count: mutable usize = 0.usize()
        for annotation in file.enum_annotations |tail_offset, marker_count|:
            if annotation.owner == "__variadic" and annotation.name == "__variadic" and annotation.line == 0:
                marker_count <- marker_count + 1.usize()
                assert annotation.offset == tail_offset
        assert marker_count == 1.usize()



@test
def test_typestate_ref_param_marker_uses_function_owner_offset() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& @source = "#line 0 typestate-ref-owner.elisa\ndef first(value: i64&) -> void:\n    pass\n#line 0 typestate-ref-owner.elisa\ndef second(value: i64) -> void ensures value => !:\n    pass\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        first_offset: mutable u32 = 0
        second_offset: mutable u32 = 0
        for declaration in file.top_decls |first_offset, second_offset|:
            match declaration:
                Decl.Func(name, _, _, _, _, _, position):
                    first_offset <- position.offset if name == "first" and position.line == 0
                    second_offset <- position.offset if name == "second" and position.line == 0
                _:
                    pass
        assert first_offset != 0
        assert second_offset != 0
        ref_marker_found: mutable bool = false
        nonref_consume_found: mutable bool = false
        for annotation in file.enum_annotations |first_offset, second_offset, ref_marker_found, nonref_consume_found|:
            ref_marker_found <- true if annotation.owner == "value" and annotation.name == "__typestate_ref_param" and annotation.line == 0 and annotation.offset == first_offset
            nonref_consume_found <- true if annotation.owner == "second" and annotation.name == "value" and annotation.line == 3900000076 and annotation.detail_line == 0 and annotation.offset == second_offset
        assert ref_marker_found
        assert nonref_consume_found



@test
def test_using_alias_target_normalizes_scope_trivia() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& @source = "module Root:\n    module Nested:\n        def value() -> i64:\n            return 1\nusing Root :: Nested as Alias\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        alias_target_found: mutable bool = false
        using_target_found: mutable bool = false
        for annotation in file.enum_annotations |alias_target_found, using_target_found|:
            if annotation.name == "__using_alias_target":
                assert annotation.owner == "Root::Nested"
                alias_target_found <- true
            if annotation.name == "__using":
                assert annotation.owner == "Root::Nested"
                using_target_found <- true
        assert alias_target_found
        assert using_target_found




@test
def test_extern_decorator_retention() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("@borrows_return(holder)\nextern borrow_value(holder: i32&) -> i32&\n") can Global{Read,Write}
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                assert name == "borrow_value"
                assert arity == 1
                assert return_type_name == "i32"
                assert file.extern_params[param_start.usize()].name == "holder"
                assert file.extern_params[param_start.usize()].type_name == "i32"
                assert file.extern_params[param_start.usize()].provenance_bearing
                assert decorators.count == 1
                assert decorators[0].name == "borrows_return"
                assert decorators[0].arg_count == 1
                assert file.annotation_args[decorators[0].arg_start.usize()] == "holder"
            _:
                assert false




@test
def test_enum_payload_field_names() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& @source = "enum E:\n    A(x: i64, y?: sview, bool)\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Enum(name, variants, is_const, storage_type, line):
                assert name == "E"
                assert variants.count == 1
                assert variants[0].name == "A"
                assert variants[0].fields.count == 3
                assert variants[0].field_names.count == 3
                assert variants[0].field_names[0] == "x"
                assert variants[0].field_names[1] == "y"
                assert variants[0].field_names[2] == ""
            _:
                assert false




@test
def test_export_qualified_target_parses() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& @source = "export fn probe(seed: u64) -> u32 = Semantic::hash_occupied_probe\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        found_target: mutable bool = false
        for annotation in file.enum_annotations |found_target|:
            found_target <- true if annotation.owner == "probe" and annotation.name == "Semantic::hash_occupied_probe"
        assert found_target
        match file.top_decls[0]:
            Decl.Extern(name, param_start, arity, variadic, callable, _, decorators, line):
                assert name != ""
            _:
                assert false




@test
def test_export_target_rows_use_exact_line_zero_owner() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& @source = "#line 0 export-target-owner.elisa\nexport fn public_first() -> i64 = target_first\n#line 0 export-target-owner.elisa\nexport fn public_second() -> i64 = target_second\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        assert file.top_decls.count == 2
        first_offset: mutable u32 = 0
        second_offset: mutable u32 = 0
        first_declarations: mutable usize = 0.usize()
        second_declarations: mutable usize = 0.usize()
        for declaration in file.top_decls |first_offset, second_offset, first_declarations, second_declarations|:
            match declaration:
                Decl.Extern(name, _, _, _, callable, _, _, position):
                    if name == "public_first":
                        assert callable and position.line == 0
                        first_offset <- position.offset
                        first_declarations <- first_declarations + 1.usize()
                    if name == "public_second":
                        assert callable and position.line == 0
                        second_offset <- position.offset
                        second_declarations <- second_declarations + 1.usize()
                _:
                    pass
        assert first_declarations == 1.usize() and second_declarations == 1.usize()
        assert first_offset != second_offset
        first_export_rows: mutable usize = 0.usize()
        second_export_rows: mutable usize = 0.usize()
        first_target_rows: mutable usize = 0.usize()
        second_target_rows: mutable usize = 0.usize()
        first_ref_rows: mutable usize = 0.usize()
        second_ref_rows: mutable usize = 0.usize()
        for annotation in file.enum_annotations |first_offset, second_offset, first_export_rows, second_export_rows, first_target_rows, second_target_rows, first_ref_rows, second_ref_rows|:
            if annotation.line == 0 and annotation.offset == first_offset:
                first_export_rows <- first_export_rows + 1.usize() if annotation.owner == "public_first" and annotation.name == "__export_fn"
                first_target_rows <- first_target_rows + 1.usize() if annotation.owner == "public_first" and annotation.name == "target_first"
                first_ref_rows <- first_ref_rows + 1.usize() if annotation.owner == "target_first" and annotation.name == "__export_target_ref"
            if annotation.line == 0 and annotation.offset == second_offset:
                second_export_rows <- second_export_rows + 1.usize() if annotation.owner == "public_second" and annotation.name == "__export_fn"
                second_target_rows <- second_target_rows + 1.usize() if annotation.owner == "public_second" and annotation.name == "target_second"
                second_ref_rows <- second_ref_rows + 1.usize() if annotation.owner == "target_second" and annotation.name == "__export_target_ref"
        assert first_export_rows == 1.usize() and second_export_rows == 1.usize()
        assert first_target_rows == 1.usize() and second_target_rows == 1.usize()
        assert first_ref_rows == 1.usize() and second_ref_rows == 1.usize()



