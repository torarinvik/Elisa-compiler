# Parser AST tests — DECLARATIONS: laws and their predicates, region-polymorphic parameters,
# default arguments, extern decorator retention, enum payload field names, export targets, call
# argument forwarding, catch arms and `expect`'s panic fallback, and the `for` bind modes.
# Included by parser_ast_test.elisa, which holds the parse helper these all call.

using Ast


@test
def test_law_decl_captures_predicate() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "law commutes(a, b) = add(a, b) == add(b, a)\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Law(name, predicate, line):
                assert name == "commutes"
                match predicate:
                    Expr.Binary(left, operator, right, predicate_line):
                        pass
                    _:
                        assert false
            _:
                assert false




@test
def test_region_poly_param_annotation() -> void:
    can Memory.Allocate, Abort.Panic:
        # `def f[@r](out: darray[u8]& @r)` — the trailing `@r` region binding on a
        # param type must be consumed (was orphaned → the `)` failed to parse).
        src: u8& = "def f[@r](out: mutable darray[u8]& @r, v: u8) -> void:\n    pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Func(name, params, return_type, body, effects, decorators, line):
                assert name == "f"
                assert params.count == 2
            _:
                assert false




@test
def test_function_default_args() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def build(x: i64, ys: darray[u32] = [], cond: i64? = null) -> i64:\n    return x\n\nextern reserve(xs: darray[i64], want: usize = 0) -> void\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 2
        match file.top_decls[0]:
            Decl.Func(name, params, return_type, body, effects, decorators, line):
                assert name == "build"
                assert params.count == 3
                assert not params[0].has_default
                assert params[1].has_default
                assert params[2].has_default
            _:
                assert false
        match file.top_decls[1]:
            Decl.Extern(name, param_start, arity, variadic, callable, _, decorators, line):
                assert name == "reserve"
            _:
                assert false




@test
def test_extern_decorator_retention() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("@borrows_return(holder)\nextern borrow_value(holder: i32&) -> i32&\n")
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Extern(name, param_start, arity, variadic, callable, return_type_name, decorators, line):
                assert name == "borrow_value"
                assert arity == 1
                assert return_type_name == "i32"
                assert file.extern_params[param_start.usize()].name == "holder"
                assert file.extern_params[param_start.usize()].type_name == "i32"
                assert file.extern_params[param_start.usize()].provenance_bearing
                assert decorators.count == 1
                assert decorators[0].name == "borrows_return"
                assert decorators[0].arg_count == 1
                assert file.annotation_args[decorators[0].arg_start.usize()] == "holder"
            _:
                assert false




@test
def test_enum_payload_field_names() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "enum E:\n    A(x: i64, y?: sview, bool)\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Enum(name, variants, is_const, storage_type, line):
                assert name == "E"
                assert variants.count == 1
                assert variants[0].name == "A"
                assert variants[0].fields.count == 3
                assert variants[0].field_names.count == 3
                assert variants[0].field_names[0] == "x"
                assert variants[0].field_names[1] == "y"
                assert variants[0].field_names[2] == ""
            _:
                assert false




