# Exact diagnostics for the local-row disjointness pass. Keep duplicate-default
# reporting before overlap reporting, with the later row as the error anchor.
include "../../src/parser/parser.elisa"

using Ast

def when_diagnostics_file(source: u8& @source) -> Ast::File:
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Token] = frontend_tokenize(source, source)
        return frontend_parser_parse_file(source, tokens) can Global{Read,Write}

@test
def test_when_disjoint_diagnostic_order_and_spans() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = when_diagnostics_file("def f(n: i64) -> i64:\n    return when n:\n        1 -> 10\n        1 -> 20\n        _ -> 30\n        _ -> 40\n") can Global{Read,Write}
        assert file.errors.count == 2
        assert file.errors[0].kind == ParseErrorKind.WhenDuplicateDefaultRow
        assert file.errors[0].line == 6
        assert file.errors[0].detail_num == 5
        assert file.errors[1].kind == ParseErrorKind.WhenArmOverlap
        assert file.errors[1].line == 4
        assert file.errors[1].detail_num == 3
        assert file.errors[1].detail == "1"
        assert file.errors[1].detail2 == "1"

@test
def test_when_disjoint_reports_every_overlapping_pair() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = when_diagnostics_file("def f(n: i64) -> i64:\n    return when n:\n        0..<4 -> 10\n        2..<6 -> 20\n        3 -> 30\n        _ -> 40\n") can Global{Read,Write}
        assert file.errors.count == 3
        assert file.errors[0].kind == ParseErrorKind.WhenArmOverlap
        assert file.errors[0].line == 4
        assert file.errors[0].detail_num == 3
        assert file.errors[1].kind == ParseErrorKind.WhenArmOverlap
        assert file.errors[1].line == 5
        assert file.errors[1].detail_num == 3
        assert file.errors[2].kind == ParseErrorKind.WhenArmOverlap
        assert file.errors[2].line == 5
        assert file.errors[2].detail_num == 4
