# Keep direct and frame-law-derived writes visible to preserves checking.
include "../../src/semantic/semantic.elisa"

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    EXPECTED_DIAGNOSTICS: usize = 2
    DIRECT_CALL_LINE: u32 = 11
    INHERITED_CALL_LINE: u32 = 13
    source: u8& = "struct State:\n    value: mutable i64\n    other: mutable i64\nlaw ValueOnly(self: State&) changes self.value\ndef direct(state: mutable State&) changes state.value:\n    pass\ndef inherited(state: mutable State&) fulfills state is ValueOnly:\n    pass\nmodule Cases:\n    def rejected_direct(state: mutable State&) preserves state.value:\n        direct(state)\n    def rejected_inherited(state: mutable State&) preserves state.value:\n        inherited(state)\n    def accepted(state: mutable State&) preserves state.other:\n        inherited(state)\n"
    length: mutable usize = 0
    while source[length] != 0 |length|:
        length <- length + 1
    tokens: darray[Token] = frontend_tokenize_with_length(source, source, length)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    assert file.errors.count == 0
    table: mutable Semantic::SymbolTable = Semantic::collect_symbols(file)
    table <- Semantic::check_frame_preserves(file, table)
    assert table.diagnostics.count == EXPECTED_DIAGNOSTICS
    assert table.diagnostics[0].kind == Semantic::DiagnosticKind.PreservesViolation
    assert table.diagnostics[0].line == DIRECT_CALL_LINE
    assert table.diagnostics[0].name == "state"
    assert table.diagnostics[0].detail == "value"
    assert table.diagnostics[1].kind == Semantic::DiagnosticKind.PreservesViolation
    assert table.diagnostics[1].line == INHERITED_CALL_LINE
    assert table.diagnostics[1].name == "state"
    assert table.diagnostics[1].detail == "value"
    return 0
