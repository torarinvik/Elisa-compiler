include "../../src/semantic/semantic.elisa"

extend Semantic:
    public:
        def error_set_family_filter_test() -> i64 can[Memory.Allocate, Abort.Panic]:
            FUNCTION_LINE: u32 = 17
            rows: darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "__error_set_family", name: "IoErr", line: FUNCTION_LINE}, Ast::EnumAnnotation{owner: "__other", name: "IoErr", line: FUNCTION_LINE}, Ast::EnumAnnotation{owner: "__error_set_family", name: "NetErr", line: FUNCTION_LINE}, Ast::EnumAnnotation{owner: "__error_set_family", name: "IoErr", line: FUNCTION_LINE}]
            filtered: mutable darray[Ast::EnumAnnotation] = []
            for annotation in rows |filtered|:
                filtered.push(annotation) if lrc_is_error_set_family(annotation)
            assert filtered.count == 3
            assert filtered[0].name == "IoErr"
            assert filtered[1].name == "NetErr"
            assert filtered[2].owner == "__error_set_family"
            assert not lrc_is_error_set_family(Ast::EnumAnnotation{owner: "__other", name: "IoErr", line: FUNCTION_LINE})
            return 0

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return Semantic::error_set_family_filter_test()
