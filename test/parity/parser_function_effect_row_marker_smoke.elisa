include "../../src/semantic/semantic.elisa"

extend Parser:
    private:
        def function_effect_row_marker_test_parser(source: u8&) -> Parser can[Abort.Panic, Memory.Allocate]:
            length: mutable usize = 0
            while source[length] != 0 |length|:
                length <- length + 1
            tokens: darray[Token] = frontend_tokenize_with_length(source, source, length)
            parser: mutable Parser = Parser(source, length, tokens)
            declarations: mutable darray[Ast::Decl] = []
            while parser.peek() != TokenKind.Eof |parser, declarations|:
                parser <- parser.skip_newlines()
                break if parser.peek() == TokenKind.Eof
                before: usize = parser.position
                parser <- parser.parse_declaration_unit(declarations)
                assert parser.position > before
            assert parser.errors.count == 0
            return parser

    public:
        def function_effect_row_marker_test() -> i64 can[Abort.Panic, Memory.Allocate]:
            parser: Parser = function_effect_row_marker_test_parser("def omitted() -> i64:\n    return 0\ndef after_result() -> i64 can[]:\n    return 0\ndef after_parameters() can[]:\n    return 0\n")
            marker_count: mutable usize = 0
            omitted_row: mutable bool = false
            after_result_row: mutable bool = false
            after_parameters_row: mutable bool = false
            for annotation in parser.enum_annotations |parser, marker_count, omitted_row, after_result_row, after_parameters_row|:
                continue if annotation.name != "__function_effect_row_declared" or annotation.line != 3900000132
                marker_count <- marker_count + 1
                function_marker_count: mutable usize = 0
                for function_marker in parser.enum_annotations |parser, annotation, function_marker_count|:
                    continue if function_marker.name != "__lsp_func_name" or function_marker.owner != annotation.owner
                    continue if function_marker.line != annotation.detail_line or function_marker.offset != annotation.offset
                    function_marker_count <- function_marker_count + 1
                assert function_marker_count == 1
                if annotation.owner == "after_result":
                    after_result_row <- true
                elif annotation.owner == "after_parameters":
                    after_parameters_row <- true
                elif annotation.owner == "omitted":
                    omitted_row <- true
            assert marker_count == 2
            assert after_result_row and after_parameters_row and not omitted_row
            return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Parser::function_effect_row_marker_test()
