# The second region may reuse the first region's larger cached block.
def main() -> i64:
    region first(4096):
        xs: mutable darray[i64] = []
        xs.push(42)
        return 1 if xs[0] != 42
    region second(8):
        ys: mutable darray[i64] = []
        ys.push(7)
        return 2 if ys[0] != 7
    return 0
