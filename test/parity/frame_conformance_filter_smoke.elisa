# Check frame clause subjects, field sets, and value-position diagnostics.
include "../../src/semantic/semantic.elisa"

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    EXPECTED_DIAGNOSTICS: usize = 3
    source: u8& = "struct State:\n    value: mutable i64\n    other: mutable i64\nlaw ValueOnly(self: State&) changes self.value\nlaw KeepValue(self: State&) preserves self.value\nmodule Cases:\n    def outside(left: mutable State&, right: mutable State&) fulfills right is ValueOnly:\n        left.other <- 1\n        right.other <- 2\n    def preserved(state: mutable State&) fulfills state is KeepValue:\n        state.value <- 3\n    def accepted(state: mutable State&) fulfills state is ValueOnly:\n        state.value <- 4\n    def value_test(state: State&) -> bool:\n        return state is ValueOnly\n"
    length: mutable usize = 0
    while source[length] != 0 |length|:
        length <- length + 1
    tokens: darray[Token] = frontend_tokenize_with_length(source, source, length)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    assert file.errors.count == 0
    table: mutable Semantic::SymbolTable = Semantic::collect_symbols(file)
    table <- Semantic::check_effect_law_fulfillment(file, table)
    assert table.diagnostics.count == EXPECTED_DIAGNOSTICS
    assert table.diagnostics[0].kind == Semantic::DiagnosticKind.WritesOutsideChanges
    assert table.diagnostics[0].name == "right"
    assert table.diagnostics[0].actual == "other"
    assert table.diagnostics[1].kind == Semantic::DiagnosticKind.FrameLawPreserveWrite
    assert table.diagnostics[1].name == "state"
    assert table.diagnostics[1].actual == "value"
    assert table.diagnostics[2].kind == Semantic::DiagnosticKind.FrameLawValueIs
    assert table.diagnostics[2].name == "ValueOnly"
    return 0
