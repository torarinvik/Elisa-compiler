# A single explicit arena cleanup must emit one REGION_FREE event for that arena.
# This is kept separate from the general ABI smoke so the target arena can be
# identified exactly without counting compiler-generated scope cleanup events.
include "../../elisacore_std/arena.elisa"

extern profile_watch_region_free(arena: uintptr) -> void
extern profile_region_free_count() -> u64

def profile_arena_free_probe() -> i64:
    backing: mutable heap Region& = new_region_backend(32, ARENA_STRATEGY_CHAINED)
    arena: mutable Arena = Arena{begin: backing, end: backing, end_index: 0, strategy: ARENA_STRATEGY_CHAINED}
    profile_watch_region_free((&arena).cast[uintptr] can Unsafe.PointerCast)
    arena_free(&arena)
    return 42 if profile_region_free_count() == 1 else 0

export fn profile_arena_free_probe_export() -> i64 = profile_arena_free_probe
