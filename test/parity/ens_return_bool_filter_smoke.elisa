include "../../src/semantic/semantic.elisa"

extend Semantic:
    public:
        def ens_return_bool_filter_test() -> i64 can[Memory.Allocate, Abort.Panic]:
            FUNCTION_LINE: u32 = 19
            OTHER_LINE: u32 = 23
            rows: darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "wrong", name: "__ensures_return_bool", line: FUNCTION_LINE}, Ast::EnumAnnotation{owner: "__unrelated", name: "__ensures_return_bool", line: FUNCTION_LINE}, Ast::EnumAnnotation{owner: "wrong", name: "__ensures_return_bool", line: OTHER_LINE}, Ast::EnumAnnotation{owner: "wrong", name: "__other", line: FUNCTION_LINE}, Ast::EnumAnnotation{owner: "wrong", name: "__ensures_return_bool", line: FUNCTION_LINE}]
            filtered: mutable darray[Ast::EnumAnnotation] = []
            for annotation in rows |filtered|:
                filtered.push(annotation) if ens_return_bool_annotation(annotation)
            assert filtered.count == 4
            assert filtered[0].owner == "wrong"
            assert filtered[1].owner == "__unrelated"
            assert filtered[2].line == OTHER_LINE
            assert filtered[3].line == FUNCTION_LINE
            assert not ens_return_bool_annotation(Ast::EnumAnnotation{owner: "wrong", name: "__other", line: FUNCTION_LINE})
            return 0

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return Semantic::ens_return_bool_filter_test()
