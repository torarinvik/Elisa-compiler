# Exercise module-aware readonly lookup, same-named functions, qualified calls,
# address-of field calls, and the readonly-overload exemption.
include "../../src/semantic/semantic.elisa"

@test
def test_readonly_lookup_resolves_module_signatures() -> void can[Memory.Allocate, Abort.Panic]:
    EXPECTED_DIAGNOSTICS: usize = 5
    source: u8& = "def mutate(value: mutable i64&):\n    pass\ndef choose(value: mutable i64&):\n    pass\ndef choose(value: i64&):\n    pass\ndef ordinary(value: i64):\n    mutate(value)\ndef exercise(value: i64&):\n    mutate(value)\n    choose(value)\n    mutate(value: value)\nstruct RefBox:\n    value: i64\nmodule RefProducer:\n    def gap(value: mutable RefBox&):\n        pass\n    def take(value: mutable i64&):\n        pass\n    def select(value: mutable i64&):\n        pass\n    def select(value: i64&):\n        pass\nmodule RefConsumer:\n    def gap(value: i64) -> i64:\n        return value\n    def take(value: mutable i64&):\n        pass\n    def select(value: mutable i64&):\n        pass\n    def select(value: i64&):\n        pass\n    def probe(box: RefBox&, value: i64&) -> i64:\n        take(value)\n        RefProducer::take(value)\n        RefProducer::take(&box.value)\n        RefProducer::select(value)\n        select(value)\n        return gap(box.value)\nmodule RefHidden:\n    def hidden_mutator(value: mutable i64&):\n        pass\nusing RefProducer\ndef imported_probe(value: i64&):\n    take(value)\ndef unimported_probe(value: i64&):\n    hidden_mutator(value)\n"
    length: mutable usize = 0
    while source[length] != 0 |length|:
        length <- length + 1
    tokens: darray[Token] = frontend_tokenize_with_length(source, source, length)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    assert file.errors.count == 0
    table: mutable Semantic::SymbolTable = Semantic::collect_symbols(file)
    # check_readonly_refs is called after semantic_api has populated these import rows.
    # Set the module row here because this unit exercises the pass directly.
    table.imported_modules <- table.imported_modules.push("RefProducer")
    table <- Semantic::check_readonly_refs(file.top_decls, table)
    assert table.diagnostics.count == EXPECTED_DIAGNOSTICS
    assert table.diagnostics[0].kind == Semantic::DiagnosticKind.ReadonlyRefArgument
    assert table.diagnostics[0].name == "mutate"
    assert table.diagnostics[0].line == 10
    assert table.diagnostics[0].expected == "i64"
    assert table.diagnostics[0].actual == "i64"
    assert table.diagnostics[0].expected_count == 1
    assert table.diagnostics[1].kind == Semantic::DiagnosticKind.ReadonlyRefArgument
    assert table.diagnostics[1].name == "take"
    assert table.diagnostics[1].line == 34
    assert table.diagnostics[1].expected == "i64"
    assert table.diagnostics[1].actual == "i64"
    assert table.diagnostics[2].kind == Semantic::DiagnosticKind.ReadonlyRefArgument
    assert table.diagnostics[2].name == "take"
    assert table.diagnostics[2].line == 35
    assert table.diagnostics[2].expected == "i64"
    assert table.diagnostics[2].actual == "i64"
    assert table.diagnostics[3].kind == Semantic::DiagnosticKind.ReadonlyRefArgument
    assert table.diagnostics[3].name == "take"
    assert table.diagnostics[3].line == 45
    assert table.diagnostics[3].expected == "i64"
    assert table.diagnostics[3].actual == "i64"
    assert table.diagnostics[4].kind == Semantic::DiagnosticKind.ReadonlyRefArgument
    assert table.diagnostics[4].name == "take"
    assert table.diagnostics[4].line == 36
    assert table.diagnostics[4].expected == "i64"
    assert table.diagnostics[4].actual == "i64"
