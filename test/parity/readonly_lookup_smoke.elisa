# Exercise the readonly lookup gate and the readonly-overload exemption directly.
include "../../src/semantic/semantic.elisa"

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    EXPECTED_DIAGNOSTICS: usize = 1
    REJECTED_CALL_LINE: u32 = 10
    source: u8& = "def mutate(value: mutable i64&):\n    pass\ndef choose(value: mutable i64&):\n    pass\ndef choose(value: i64&):\n    pass\ndef ordinary(value: i64):\n    mutate(value)\ndef exercise(value: i64&):\n    mutate(value)\n    choose(value)\n    mutate(value: value)\n"
    length: mutable usize = 0
    while source[length] != 0 |length|:
        length <- length + 1
    tokens: darray[Token] = frontend_tokenize_with_length(source, source, length)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    assert file.errors.count == 0
    table: mutable Semantic::SymbolTable = Semantic::collect_symbols(file)
    table <- Semantic::check_readonly_refs(file.top_decls, table)
    assert table.diagnostics.count == EXPECTED_DIAGNOSTICS
    assert table.diagnostics[0].kind == Semantic::DiagnosticKind.ReadonlyRefArgument
    assert table.diagnostics[0].name == "mutate"
    assert table.diagnostics[0].line == REJECTED_CALL_LINE
    assert table.diagnostics[0].expected == "i64"
    assert table.diagnostics[0].actual == "i64"
    assert table.diagnostics[0].expected_count == 1
    return 0
