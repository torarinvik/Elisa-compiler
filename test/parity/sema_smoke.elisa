# Semantic smoke: lex + parse + collect symbols, returning the symbol and
# duplicate counts. Anchors the stage1 semantic (symbol-collection) call graph.
include "../../src/semantic/semantic.elisa"


def sema_smoke(source: u8&, source_length: usize, syms_out: mutable u64&, dups_out: mutable u64&, stmts_out: mutable u64&, identities_out: mutable u64&, bindings_out: mutable u64&):
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Token] = frontend_tokenize_with_length(source, source, source_length)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        table: Semantic::SymbolTable = Semantic::collect_symbols(file)
        syms_out[0] <- table.symbols.count.u64()
        dups_out[0] <- table.duplicates.u64()
        stmts_out[0] <- table.statements.u64()
        identity_table: Semantic::SymbolTable = Semantic::unresolved_table(file)
        identities_valid: mutable bool = true
        for row in 0..<identity_table.symbols.count |identities_valid|:
            identities_valid <- false if identity_table.symbols[row].id.value != row.u32()
        saw_target_reference: mutable bool = false
        for reference in identity_table.definition_references |identities_valid, saw_target_reference|:
            declaration_id: u32 = reference.declaration_id.value
            if declaration_id.usize() >= identity_table.symbols.count:
                identities_valid <- false
            else:
                target_symbol: Semantic::Symbol = identity_table.symbols[declaration_id.usize()]
                identities_valid <- false if target_symbol.id.value != declaration_id
                saw_target_reference <- true if target_symbol.name == "target"
        identities_out[0] <- 1 if identities_valid and saw_target_reference
        bindings_valid: mutable bool = identity_table.ref_binding_ids.count == identity_table.ref_line.count and identity_table.ref_line.count == identity_table.ref_name.count and identity_table.ref_name.count == identity_table.ref_kind.count
        outer_declaration: mutable Semantic::BindingId = Semantic::BindingId{owner: Semantic::DeclId{value: 4294967295}, serial: 0}
        outer_use: mutable Semantic::BindingId = Semantic::BindingId{owner: Semantic::DeclId{value: 4294967295}, serial: 0}
        inner_declaration: mutable Semantic::BindingId = Semantic::BindingId{owner: Semantic::DeclId{value: 4294967295}, serial: 0}
        inner_use: mutable Semantic::BindingId = Semantic::BindingId{owner: Semantic::DeclId{value: 4294967295}, serial: 0}
        parameter_declaration: mutable Semantic::BindingId = Semantic::BindingId{owner: Semantic::DeclId{value: 4294967295}, serial: 0}
        parameter_use: mutable Semantic::BindingId = Semantic::BindingId{owner: Semantic::DeclId{value: 4294967295}, serial: 0}
        saw_outer_declaration: mutable bool = false
        saw_outer_use: mutable bool = false
        saw_inner_declaration: mutable bool = false
        saw_inner_use: mutable bool = false
        saw_parameter_declaration: mutable bool = false
        saw_parameter_use: mutable bool = false
        for occurrence in 0..<identity_table.ref_line.count |bindings_valid, outer_declaration, outer_use, inner_declaration, inner_use, parameter_declaration, parameter_use, saw_outer_declaration, saw_outer_use, saw_inner_declaration, saw_inner_use, saw_parameter_declaration, saw_parameter_use|:
            owner: u32 = identity_table.ref_binding_ids[occurrence].owner.value
            bindings_valid <- false if owner.usize() >= identity_table.symbols.count
            if owner.usize() < identity_table.symbols.count:
                bindings_valid <- false if identity_table.symbols[owner.usize()].kind != Semantic::SymbolKind.Func
                bindings_valid <- false if (identity_table.ref_name[occurrence] == "value" or identity_table.ref_name[occurrence] == "flag") and identity_table.symbols[owner.usize()].name != "shadowed"
            if identity_table.ref_name[occurrence] == "value":
                outer_declaration <- identity_table.ref_binding_ids[occurrence] if identity_table.ref_line[occurrence] == 22
                saw_outer_declaration <- true if identity_table.ref_line[occurrence] == 22
                inner_declaration <- identity_table.ref_binding_ids[occurrence] if identity_table.ref_line[occurrence] == 24
                saw_inner_declaration <- true if identity_table.ref_line[occurrence] == 24
                inner_use <- identity_table.ref_binding_ids[occurrence] if identity_table.ref_line[occurrence] == 25
                saw_inner_use <- true if identity_table.ref_line[occurrence] == 25
                outer_use <- identity_table.ref_binding_ids[occurrence] if identity_table.ref_line[occurrence] == 26
                saw_outer_use <- true if identity_table.ref_line[occurrence] == 26
            if identity_table.ref_name[occurrence] == "flag":
                parameter_declaration <- identity_table.ref_binding_ids[occurrence] if identity_table.ref_line[occurrence] == 21
                saw_parameter_declaration <- true if identity_table.ref_line[occurrence] == 21
                parameter_use <- identity_table.ref_binding_ids[occurrence] if identity_table.ref_line[occurrence] == 23
                saw_parameter_use <- true if identity_table.ref_line[occurrence] == 23
        same_outer: bool = outer_declaration.owner.value == outer_use.owner.value and outer_declaration.serial == outer_use.serial
        same_inner: bool = inner_declaration.owner.value == inner_use.owner.value and inner_declaration.serial == inner_use.serial
        same_parameter: bool = parameter_declaration.owner.value == parameter_use.owner.value and parameter_declaration.serial == parameter_use.serial
        distinct_shadows: bool = outer_declaration.owner.value != inner_declaration.owner.value or outer_declaration.serial != inner_declaration.serial
        bindings_out[0] <- 1 if bindings_valid and saw_outer_declaration and saw_outer_use and saw_inner_declaration and saw_inner_use and saw_parameter_declaration and saw_parameter_use and same_outer and same_inner and same_parameter and distinct_shadows


export fn sema_smoke_export(source: u8&, source_length: usize, syms_out: mutable u64&, dups_out: mutable u64&, stmts_out: mutable u64&, identities_out: mutable u64&, bindings_out: mutable u64&) -> void = sema_smoke
