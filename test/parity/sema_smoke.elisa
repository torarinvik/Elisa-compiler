# Semantic smoke: lex + parse + collect symbols, returning the symbol and
# duplicate counts. Anchors the stage1 semantic (symbol-collection) call graph.
include "../../src/semantic/semantic.elisa"


def sema_smoke(source: u8&, source_length: usize, syms_out: mutable u64&, dups_out: mutable u64&, stmts_out: mutable u64&, identities_out: mutable u64&):
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Token] = frontend_tokenize_with_length(source, source, source_length)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        table: Semantic::SymbolTable = Semantic::collect_symbols(file)
        syms_out[0] <- table.symbols.count.u64()
        dups_out[0] <- table.duplicates.u64()
        stmts_out[0] <- table.statements.u64()
        identity_table: Semantic::SymbolTable = Semantic::unresolved_table(file)
        identities_valid: mutable bool = true
        for row in 0..<identity_table.symbols.count |identities_valid|:
            identities_valid <- false if identity_table.symbols[row].id.value != row.u32()
        saw_target_reference: mutable bool = false
        for reference in identity_table.definition_references |identities_valid, saw_target_reference|:
            declaration_id: u32 = reference.declaration_id.value
            if declaration_id.usize() >= identity_table.symbols.count:
                identities_valid <- false
            else:
                target_symbol: Semantic::Symbol = identity_table.symbols[declaration_id.usize()]
                identities_valid <- false if target_symbol.id.value != declaration_id
                saw_target_reference <- true if target_symbol.name == "target"
        identities_out[0] <- 1 if identities_valid and saw_target_reference


export fn sema_smoke_export(source: u8&, source_length: usize, syms_out: mutable u64&, dups_out: mutable u64&, stmts_out: mutable u64&, identities_out: mutable u64&) -> void = sema_smoke
