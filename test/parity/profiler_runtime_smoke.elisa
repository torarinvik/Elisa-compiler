def profile_probe_aux() -> i64:
    region scratch(256):
        return 0

def profile_probe() -> i64:
    region r(4096):
        values: mutable darray[i64] = []
        for i in 0..<64:
            values.push(i)
        return ((values[63] can Unsafe.UncheckedIndex) - 21) + profile_probe_aux()

export fn profile_probe_export() -> i64 = profile_probe
