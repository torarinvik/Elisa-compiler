# Structural controls for the checker-only captured-loop view.
include "../../src/semantic/semantic.elisa"

using Ast


def parse_loop_view_snippet(source: u8&) -> Ast::File:
    can Memory.Allocate, Abort.Panic, Global{Read,Write}, Atomics{Exchange,Store}, Unsafe{Alias,MutableGlobal,PointerArithmetic,PointerCast,RawExtern,UncheckedIndex}:
        tokens: darray[Token] = frontend_tokenize(source, source)
        return frontend_parser_parse_file(source, tokens)



extend Semantic:
    public:
        # Test-only observation of the visitor's no-change result. The production helper
        # returns the original declaration arrays when these flags are false.
        def loop_view_no_change_control(file: Ast::File&) -> bool:
            can Memory.Allocate, Abort.Panic:
                top: (declarations: darray[Ast::Decl], changed: bool) = loop_view_declarations_result(file.top_decls)
                defaults: (declarations: darray[Ast::Decl], changed: bool) = loop_view_declarations_result(file.protocol_default_methods)
                return not top.changed and not defaults.changed



@test
def test_plain_loops_take_the_no_change_path() -> void:
    can Memory.Allocate, Abort.Panic, Global{Read,Write}, Atomics{Exchange,Store}, Unsafe{Alias,MutableGlobal,PointerArithmetic,PointerCast,RawExtern,UncheckedIndex}:
        source: u8& = "def f(n: i64) -> i64:\n    while n > 0:\n        pass\n    return n\n"
        file: Ast::File = parse_loop_view_snippet(source)
        view: Ast::File = Semantic::semantic_loop_view(file)
        assert file.errors.count == 0
        assert Semantic::loop_view_no_change_control(file)
        assert view.top_decls.count == file.top_decls.count
        match view.top_decls[0]:
            Decl.Func(name, params, return_type, body, effects, decorators, line):
                assert body.count == 2
                match body[0]:
                    Stmt.While(condition, loop_body, loop_line):
                        assert loop_body.count == 1
                    _:
                        assert false
            _:
                assert false



@test
def test_top_level_captured_loop_is_rewritten_without_mutating_source() -> void:
    can Memory.Allocate, Abort.Panic, Global{Read,Write}, Atomics{Exchange,Store}, Unsafe{Alias,MutableGlobal,PointerArithmetic,PointerCast,RawExtern,UncheckedIndex}:
        source: u8& = "def f(n: i64):\n    while n > 0 |n|:\n        pass\n"
        file: Ast::File = parse_loop_view_snippet(source)
        view: Ast::File = Semantic::semantic_loop_view(file)
        assert file.errors.count == 0
        match file.top_decls[0]:
            Decl.Func(name, params, return_type, body, effects, decorators, line):
                match body[0]:
                    Stmt.Expr(expression, position):
                        match expression:
                            Expr.Block(block_body, block_value, captures, block_position):
                                assert captures.count == 1
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false
        match view.top_decls[0]:
            Decl.Func(name, params, return_type, body, effects, decorators, line):
                match body[0]:
                    Stmt.Block(kind, captures, binding, loop_body, position):
                        assert kind == "loop"
                        assert captures.count == 1
                        assert loop_body.count == 1
                    _:
                        assert false
            _:
                assert false



@test
def test_protocol_default_captured_loop_is_rewritten() -> void:
    can Memory.Allocate, Abort.Panic, Global{Read,Write}, Atomics{Exchange,Store}, Unsafe{Alias,MutableGlobal,PointerArithmetic,PointerCast,RawExtern,UncheckedIndex}:
        source: u8& = "protocol Eq:\n    def eq(self: Self, other: Self) -> bool\n    def choose(a: Self, b: Self, n: i64) -> Self:\n        ensure result.eq(a)\n        while n > 0 |n|:\n            return a\n        return b\n"
        file: Ast::File = parse_loop_view_snippet(source)
        view: Ast::File = Semantic::semantic_loop_view(file)
        assert file.errors.count == 0
        assert view.protocol_default_methods.count == file.protocol_default_methods.count
        found_loop: mutable bool = false
        for declaration in view.protocol_default_methods |found_loop|:
            match declaration:
                Decl.Func(name, params, return_type, body, effects, decorators, line):
                    for statement in body |found_loop|:
                        match statement:
                            Stmt.Block(kind, captures, binding, loop_body, position):
                                found_loop <- true if kind == "loop" and captures.count == 1
                            _:
                                pass
                _:
                    pass
        assert found_loop
