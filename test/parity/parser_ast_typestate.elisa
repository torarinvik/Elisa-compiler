# Parser AST tests — TYPESTATE, `can` headers and destructuring: index-else fallbacks, the cast
# target on a `can cast` header, named refinements, typestate declarations and transitions,
# where-view comprehensions, structured `for` binders, brace-let struct patterns, and the packed
# store forms. Included by parser_ast_test.elisa.

using Ast


@test
def test_index_else_fallback_is_preserved() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def read(xs: darray[i64], i: usize) -> i64:\n    return xs[i] else 0\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match first_func_body(file)[0]:
            Stmt.Return(value, line):
                match value:
                    Expr.Binary(indexed, operator, fallback, index_line):
                        assert operator == TokenKind.Else
                        match indexed:
                            Expr.Index(object, index, nested_line):
                                match object:
                                    Expr.Ident(name, object_line):
                                        assert name == "xs"
                                    _:
                                        assert false
                            _:
                                assert false
                        match fallback:
                            Expr.IntLit(number):
                                assert number == 0
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false




@test
def test_can_cast_header_preserves_target() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def build() -> i64:\n    can Disk.Read as IO:\n        return 0\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match first_func_body(file)[0]:
            Stmt.Block(kind, clause, binding, body, line):
                assert kind == "can"
                assert clause.count == 1
                assert clause[0] == "Disk.Read"
                assert binding == "IO"
            _:
                assert false




@test
def test_plain_can_header_has_no_cast_target() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def build() -> i64:\n    can Disk.Read:\n        return 0\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match first_func_body(file)[0]:
            Stmt.Block(kind, clause, binding, body, line):
                assert kind == "can"
                assert clause.count == 1
                assert binding == ""
            _:
                assert false




@test
def test_named_refine_decl_is_structured_alias() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("refine Positive = i64 where self > 0\n")
        assert file.errors.count == 0
        match file.top_decls[0]:
            Decl.Alias(name, target, line):
                assert name == "Positive"
                match target:
                    Expr.Refinement(base, predicate, refinement_line):
                        match base:
                            Expr.Ident(base_name, base_line):
                                assert base_name == "i64"
                            _:
                                assert false
                        match predicate:
                            Expr.Binary(left, operator, right, predicate_line):
                                assert operator == TokenKind.Gt
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false




@test
def test_typestate_decl_and_transition_are_structured() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "typestate Socket:\n    states: Closed, Open\n    transition open: Closed -> Open\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        # Typestate lowering publishes the aggregate, its synthesized constructor, and
        # each declared transition as ordinary top-level declarations.
        assert file.top_decls.count == 3
        match file.top_decls[0]:
            Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, line):
                assert name == "Socket"
                assert has_named_states
                assert has_derive
            _:
                assert false
        match file.top_decls[1]:
            Decl.Func(name, params, return_type, body, effects, decorators, line):
                assert name == "__typestate_Socket_new"
            _:
                assert false
        match file.top_decls[2]:
            Decl.Func(name, params, return_type, body, effects, decorators, line):
                assert name == "open"
            _:
                assert false




@test
def test_linear_typestate_preserves_affinity() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("linear typestate Ticket:\n    states: Fresh, Used\n    transition use_it: Fresh -> Used\n")
        assert file.errors.count == 0
        match file.top_decls[0]:
            Decl.Struct(name, members, affinity, has_named_states, has_derive, invariants, line):
                assert name == "Ticket"
                assert affinity == "linear"
            _:
                assert false




@test
def test_unknown_typestate_target_is_rejected() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("typestate S:\n    states: A, B\n    transition go: A -> C\n")
        assert file.errors.count > 0




@test
def test_parenthesized_where_view_is_comprehension() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("def keep(items: darray[i64]) -> bool:\n    return all((items where item: item > 0))\n")
        assert file.errors.count == 0
        match first_func_body(file)[0]:
            Stmt.Return(value, line):
                match value:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match arguments[0]:
                            Expr.Comprehension(name, iterable, condition, body, query_line):
                                assert name == "item"
                                match condition:
                                    Expr.Binary(left, operator, right, condition_line):
                                        assert operator == TokenKind.Gt
                                    _:
                                        assert false
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false




@test
def test_return_if_value_has_conditional_blocks() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("def choose(flag: bool) -> i64:\n    return if flag:\n        1\n    else:\n        2\n")
        assert file.errors.count == 0
        match first_func_body(file)[0]:
            Stmt.Return(value, line):
                match value:
                    Expr.If(condition, then_value, else_value, if_line):
                        match then_value:
                            Expr.Block(stmts, tail_value, captures, block_line):
                                match tail_value:
                                    Expr.IntLit(number):
                                        assert number == 1
                                    _:
                                        assert false
                            _:
                                assert false
                        match else_value:
                            Expr.Block(stmts, tail_value, captures, block_line):
                                match tail_value:
                                    Expr.IntLit(number):
                                        assert number == 2
                                    _:
                                        assert false
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false




@test
def test_multiline_do_call_argument_is_block() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("def keep() -> i64:\n    value = consume(do:\n        base = 40\n        base + 2\n    )\n")
        assert file.errors.count == 0
        match first_func_body(file)[0]:
            Stmt.Assign(target, operator, value, line):
                match value:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        assert arguments.count == 1
                        match arguments[0]:
                            Expr.Block(stmts, tail_value, captures, block_line):
                                assert stmts.count == 1
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false




@test
def test_structured_for_binder_captures_fields() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("def walk(items: darray[Pair]) -> void:\n    for Pair(left, right) in items:\n        pass\n")
        assert file.errors.count == 0
        match first_func_body(file)[0]:
            Stmt.For(bind, variables, iterable, body, line):
                assert variables.count == 2
                assert variables[0] == "left"
                assert variables[1] == "right"
            _:
                assert false




@test
def test_anonymous_brace_let_is_struct_pattern() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("def unpack(row: Row) -> void:\n    let {left: first, right} = row\n")
        assert file.errors.count == 0
        match first_func_body(file)[0]:
            Stmt.Block(kind, clause, binding, lowered, line):
                assert kind == "let"
                assert lowered.count == 3
                match lowered[0]:
                    Stmt.Match(scrutinee, arms, match_line):
                        match arms[0].pattern:
                            Pattern.Struct(path, fields):
                                assert path == ""
                                assert fields.count == 2
                                match fields[0]:
                                    Pattern.Field(selector, inner):
                                        assert selector == "left"
                                        assert inner.count == 1
                                        match inner[0]:
                                            Pattern.Binding(name):
                                                assert name == "first"
                                            _:
                                                assert false
                                    _:
                                        assert false
                                match fields[1]:
                                    Pattern.Field(selector, inner):
                                        assert selector == "right"
                                        assert inner.count == 1
                                        match inner[0]:
                                            Pattern.Binding(name):
                                                assert name == "right"
                                            _:
                                                assert false
                                    _:
                                        assert false
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false




@test
def test_move_in_store_variant_destructure_is_structured() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("def unpack(node: Expr, store: Expr.Store[Frozen]) -> Expr:\n    move node in store as Expr.Add(lhs, rhs)\n    _ = rhs\n    return lhs\n")
        assert file.errors.count == 0
        match first_func_body(file)[0]:
            Stmt.Block(kind, clause, binding, move_body, line):
                assert kind == "move"
                assert clause.count == 2
                assert clause[0] == "Expr.Add"
                assert clause[1] == "store"
                assert move_body.count == 3
                match move_body[0]:
                    Stmt.Match(scrutinee, arms, match_line):
                        match scrutinee:
                            Expr.Refinement(base, backing_store, refinement_line):
                                pass
                            _:
                                assert false
                        assert arms.count == 2
                        match arms[1].pattern:
                            Pattern.Wildcard:
                                pass
                            _:
                                assert false
                        match arms[0].pattern:
                            Pattern.Variant(path, fields):
                                assert path == "Expr.Add"
                                assert fields.count == 2
                                match fields[0]:
                                    Pattern.Binding(name):
                                        assert name == "lhs"
                                    _:
                                        assert false
                                match fields[1]:
                                    Pattern.Binding(name):
                                        assert name == "rhs"
                                    _:
                                        assert false
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false




@test
def test_in_store_prefix_preserves_store_use() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("def inspect(node: Expr, store: Expr.Store[Local]) -> i64:\n    in store:\n        if node as Expr.Int:\n            return 1\n    return 0\n")
        assert file.errors.count == 0
        match first_func_body(file)[0]:
            Stmt.Block(kind, clause, binding, body, line):
                assert kind == "in"
                assert clause.count == 1
                assert clause[0] == "store"
            _:
                assert false




@test
def test_packed_enum_name_is_preserved_for_semantics() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("packed enum Expr:\n    Int(value: int)\n\nenum Plain:\n    Unit\n")
        assert file.errors.count == 0
        assert file.packed_enum_names.count == 1
        assert file.packed_enum_names[0] == "Expr"




@test
def test_packed_common_fields_prefix_constructor_payloads() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("packed enum Expr:\n    common:\n        @storage(side_table)\n        span: int\n    Int(value: int)\n    End\n")
        assert file.errors.count == 0
        assert file.enum_common_owners.count == 1
        assert file.enum_common_owners[0] == "Expr"
        assert file.enum_common_counts[0] == 1
        match file.top_decls[0]:
            Decl.Enum(name, variants, is_const, storage_type, line):
                assert variants.count == 2
                assert variants[0].fields.count == 2
                assert variants[0].field_names[0] == "span"
                assert variants[0].field_names[1] == "value"
                assert variants[1].fields.count == 1
                assert variants[1].field_names[0] == "span"
            _:
                assert false




@test
def test_legacy_region_generic_spelling_is_rejected() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def old[region r](x: i64) -> i64:\n    return x\n\nstruct Box[T, region owner]:\n    value: T\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 2
