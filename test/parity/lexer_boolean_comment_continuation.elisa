include "../../elisacore_std/elisacore_runtime.elisa"
include "../../src/lexer/lexer.elisa"

global region source

def newline_count(source: u8&) -> usize can[Abort.Panic, Memory.Allocate]:
    tokens: darray[Token] = frontend_tokenize(source, source)
    count: mutable usize = 0
    for token in tokens |count|:
        count <- count + 1 if token.kind == TokenKind.Newline
    return count

def main() -> i32 can[Abort.Panic, Memory.Allocate]:
    return 1 if newline_count("foo and # comment\nbar\n") != 1
    return 2 if newline_count("foo # comment and\nbar\n") != 2
    return 3 if newline_count("foo or # comment\nbar\n") != 1
    return 4 if newline_count("\"#\" and # comment\nbar\n") != 1
    return 5 if newline_count("\"escaped \\\" #\" and # comment\nbar\n") != 1
    return 6 if newline_count("\"and\" # comment\nbar\n") != 2
    return 7 if newline_count("foo candy # comment\nbar\n") != 2
    return 0
