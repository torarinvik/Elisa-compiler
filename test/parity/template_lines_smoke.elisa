include "../../src/backend/codegen.elisa"

extend Backend:
    public:
        def template_lines_test() -> i64 can[Abort.Panic, Memory.Allocate]:
            TYPE_LINE: u32 = 10
            ERRORSET_LINE: u32 = 20
            ORDINARY_LINE: u32 = 30
            BOUND_LINE: u32 = 2147483648
            EXPECTED_ROWS: usize = 3
            source: u8& = ""
            tokens: darray[Token] = frontend_tokenize_with_length(source, source, 0)
            file: mutable Ast::File = frontend_parser_parse_file(source, tokens)
            assert file.errors.count == 0
            file.generic_param_lines <- [TYPE_LINE, BOUND_LINE, TYPE_LINE]
            file.enum_annotations <- [Ast::EnumAnnotation{owner: "__errorset_param", name: "R", line: ERRORSET_LINE}, Ast::EnumAnnotation{owner: "unrelated", name: "T", line: ORDINARY_LINE}]
            lines: darray[u32] = generic_declaration_lines(file)
            assert lines.count == EXPECTED_ROWS
            assert lines[0] == TYPE_LINE and lines[1] == TYPE_LINE and lines[2] == ERRORSET_LINE
            assert generic_declaration_line_present(lines, TYPE_LINE)
            assert generic_declaration_line_present(lines, ERRORSET_LINE)
            assert not generic_declaration_line_present(lines, ORDINARY_LINE)
            assert not generic_declaration_line_present(lines, BOUND_LINE)
            return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Backend::template_lines_test()
