# Native harness for the product formatter; stdin contains one source file.
include "../../src/parser/parser.elisa"
module Semantic:
    def grouped_fmt_harness_module() -> void:
        pass
include "../../src/semantic/region_annotation_order.elisa"
include "../../src/semantic/auto_region_wrap.elisa"
include "../../src/driver/emit_fmt_expr.elisa"
include "../../src/driver/elisac_emit_ast.elisa"
include "../../src/driver/elisac_emit_ast_marks.elisa"
include "../../src/driver/elisac_emit_ast_decl.elisa"
include "../../src/driver/elisac_emit_iface.elisa"
include "../../src/driver/elisac_emit_iface_decl.elisa"
using Bytes
using Ast
extern read(fd: int, buffer: void&, count: usize) -> isize can[Console]
extern write(fd: int, buffer: void&, count: usize) -> isize can[Console]

def emit_tokens_push_sview(buffer: mutable darray[u8]&, text: sview) -> void can[Abort.Panic, Memory.Allocate]:
    for push_index in 0..<sview_len(text) |buffer, text|:
        buffer.push(sview_at(text, push_index))

def emit_tokens_push_u64(buffer: mutable darray[u8]&, value: u64) -> void can[Abort.Panic, Memory.Allocate]:
    digits: mutable darray[u8] = []
    value_left: mutable u64 = value
    digits.push(48) if value_left == 0
    while value_left > 0 |value_left, digits|:
        digits.push((48 + (value_left % 10).i64()).u8())
        value_left <- value_left / 10
    digit_index: mutable i64 = digits.count.i64() - 1
    while digit_index >= 0 |digit_index, digits, buffer|:
        buffer.push(digits[digit_index.usize()])
        digit_index <- digit_index - 1

def emit_tokens_push_source_name(buffer: mutable darray[u8]&) -> void:
    emit_tokens_push_sview(buffer, "<stdin>")

def push_absolute_source_path(buffer: mutable darray[u8]&) -> void:
    emit_tokens_push_sview(buffer, "<stdin>")

def emit_tokens_flush(buffer: darray[u8]&) -> i64:
    return 0 if buffer.count == 0
    raw: void& = (&buffer[0]).cast[void&] can Unsafe.PointerCast
    _ = write(1, raw, buffer.count) can Console
    return 0

def main() -> i64:
    bytes: mutable darray[u8] = []
    chunk: mutable darray[u8] = [0 for _ in 0..<8192]
    while true:
        raw: void& = (&chunk[0]).cast[void&] can Unsafe.PointerCast
        count: isize = read(0, raw, chunk.count) can Console
        break if count <= 0
        for index in 0..<count.usize() |bytes|:
            bytes.push(chunk[index])
    bytes.push(0)
    source: u8& = &bytes[0]
    tokens: darray[Lexer::Token] = frontend_tokenize_with_length(source, source, bytes.count - 1) can Global{Read,Write}
    parser_set_preserve_parens(true) can Global.Write
    file: Ast::File = frontend_parser_parse_file(source, tokens) can Global{Read,Write}
    return 2 if file.errors.count != 0
    output: mutable darray[u8] = []
    FmtUnparse::fmt_file(output, file, tokens, source) can Global{Read,Write}
    return emit_tokens_flush(output) can Console
