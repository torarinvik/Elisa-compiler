include "../../elisacore_std/elisacore_runtime.elisa"
include "../../src/lexer/lexer.elisa"

def churn() -> i64 can[Memory.Allocate, Abort.Panic]:
    total: mutable i64 = 0
    for i in 0..<100 |total|:
        region scratch:
            source: static u8& = "different + 456789\n"
            fresh: darray[Token] = frontend_tokenize_with_length(source, source, 19)
            total <- total + fresh[0].length.i64()
    return total

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    source: static u8& = "alpha + 123\n"
    tokens: darray[Token] = frontend_tokenize_with_length(source, source, 12)
    span_source: static u8& = "xx alpha + 123 yy"
    span: darray[Token] = Lexer::frontend_tokenize_span(span_source, span_source, 3, 14)
    directive: static u8& = "#line 70 \"virtual.elisa\"\nalpha\n"
    normal: darray[Token] = frontend_tokenize(directive, directive)
    expanded: darray[Token] = frontend_tokenize_expanded_unit(directive, directive, 31)
    empty_source: static u8& = ""
    empty: darray[Token] = frontend_tokenize(empty_source, empty_source)
    return 1 if churn() != 900
    return 2 if tokens.count != 5 or tokens[0].kind != TokenKind.Ident or tokens[0].length != 5
    return 3 if tokens[1].kind != TokenKind.Plus or tokens[2].length != 3
    return 4 if tokens[4].kind != TokenKind.Eof
    return 5 if span[0].start != 3 or span[0].length != 5 or span[2].start != 11
    normal_line: mutable u32 = 0
    expanded_line: mutable u32 = 0
    for token in normal |normal_line|:
        normal_line <- token.line if token.kind == TokenKind.Ident
    for token in expanded |expanded_line|:
        expanded_line <- token.line if token.kind == TokenKind.Ident
    return 6 if normal_line != 70 or expanded_line != 2
    return 7 if span[span.count - 1].kind != TokenKind.Eof
    return 8 if empty.count != 1 or empty[0].kind != TokenKind.Eof
    return 0
