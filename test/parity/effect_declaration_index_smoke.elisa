include "../../src/semantic/semantic.elisa"

extend Parser:
    private:
        def declaration_index_test_parser(source: u8&) -> Parser can[Abort.Panic, Memory.Allocate]:
            length: mutable usize = 0
            while source[length] != 0 |length|:
                length <- length + 1
            tokens: darray[Token] = frontend_tokenize_with_length(source, source, length)
            parser: mutable Parser = Parser(source, tokens)
            rebind marker: u32, parser = parser.effect_identity_for_current_declaration("__try_lexical_module")
            assert marker != 0
            assert not parser.effect_template_row_is_abstract("__try_lexical_module")
            declarations: mutable darray[Ast::Decl] = []
            while parser.peek() != TokenKind.Eof |parser, declarations|:
                parser <- parser.skip_newlines()
                break if parser.peek() == TokenKind.Eof
                before: usize = parser.position
                parser <- parser.parse_declaration_unit(declarations)
                assert parser.position > before
            assert parser.errors.count == 0
            return parser

    public:
        def effect_declaration_index_test() -> i64 can[Abort.Panic, Memory.Allocate]:
            parser: Parser = declaration_index_test_parser("effect Writer[T]:\n    def write(value: T) -> void\nmodule Nested:\n    effect Tick:\n        def tick() -> i64\n")
            assert parser.effect_template_row_is_abstract("Writer")
            assert parser.effect_template_row_is_abstract("Writer[sview]")
            assert parser.effect_template_row_is_abstract("Nested::Tick")
            assert not parser.effect_template_row_is_abstract("Missing")
            assert not parser.effect_template_row_is_abstract("__try_lexical_module")
            # A real declaration must not be excluded just for its spelling.
            declared_marker: Parser = declaration_index_test_parser("effect __try_lexical_module:\n    def tick() -> i64\n")
            assert declared_marker.effect_template_row_is_abstract("__try_lexical_module")
            return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Parser::effect_declaration_index_test()
