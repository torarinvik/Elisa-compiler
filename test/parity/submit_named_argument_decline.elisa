# A named worker argument whose label does not exist must not be silently resolved by
# value type while ignoring the label.
def named_submit_worker(value: i64) -> i64:
    return value + 1

def main() -> i64:
    can Memory.Allocate, Memory.Release, Abort.Panic, Parallel, Unsafe.PointerCast, Pool.Create, Pool.Submit, Pool.Await, Pool.WaitAll, Pool.Shutdown, Thread.Spawn, Thread.Join, Atomics.Store, Atomics.Load, Atomics.CompareExchange, Sync{Lock,Wait,Unlock,Notify}:
        pool workers(1):
            task: Task[i64, Pending] = submit[workers] named_submit_worker(other: 41)
            return pool_await(move task)
