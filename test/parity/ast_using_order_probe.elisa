include "../../src/parser/parser.elisa"
using Ast
include "../../src/driver/elisac_emit_ast_using_scope.elisa"

def main() -> i64:
    annotations: darray[Ast::EnumAnnotation] = [
        Ast::EnumAnnotation{owner: "late", name: "__using", line: 2, offset: 40},
        Ast::EnumAnnotation{owner: "first", name: "__using", line: 1, offset: 10},
        Ast::EnumAnnotation{owner: "second", name: "__using", line: 1, offset: 10},
        Ast::EnumAnnotation{owner: "middle", name: "__using", line: 1, offset: 30}
    ]
    rows: darray[EmitAstUsing] = emit_ast_using_rows(annotations)
    return 1 if rows.count != 4
    return 2 if rows[0].target != "first" or rows[1].target != "second"
    return 3 if rows[2].target != "middle" or rows[3].target != "late"
    return 0
