# Bounded bootstrap-native probe; the full Stage1 AST suite remains a separate gate.
include "../../elisacore_std/elisacore_runtime.elisa"
include "../../src/parser/parser.elisa"
using Ast

def parse_snippet(source: u8&) -> Ast::File can[Memory.Allocate, Abort.Panic]:
    tokens: darray[Token] = frontend_tokenize(source, source)
    return frontend_parser_parse_file(source, tokens)

include "./parser_ast_extern_return_text.elisa"

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    test_extern_return_text_scalar_and_qualified()
    test_extern_return_text_array_and_function()
    test_extern_return_text_contract_and_forwarder_boundaries()
    test_extern_return_text_incomplete_and_mismatched()
    return 0
