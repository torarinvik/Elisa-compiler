# Verify side-table receiver claims after the parser collapses rebind/get.
include "../../src/semantic/semantic.elisa"

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    EXPECTED_DIAGNOSTICS: usize = 1
    DROPPED_RECEIVER_LINE: u32 = 8
    source: u8& = "struct Cursor:\n    value: mutable i64\ndef advance(cursor: lmut Cursor) -> i64?:\n    return (42)\ndef claimed(cursor: lmut Cursor):\n    rebind value: i64, cursor = get cursor.advance()\ndef dropped(cursor: lmut Cursor):\n    value: i64? = cursor.advance()\n"
    length: mutable usize = 0
    while source[length] != 0 |length|:
        length <- length + 1
    tokens: darray[Token] = frontend_tokenize_with_length(source, source, length)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    assert file.errors.count == 0
    assert any annotation in file.enum_annotations where annotation.owner == "__lmut_rebind_claim" and annotation.name == "cursor"
    table: mutable Semantic::SymbolTable = Semantic::collect_symbols(file)
    table <- Semantic::check_lmut_mutation_reassignment(file, table)
    assert table.diagnostics.count == EXPECTED_DIAGNOSTICS
    assert table.diagnostics[0].kind == Semantic::DiagnosticKind.LmutMutationNotReassignment
    assert table.diagnostics[0].name == "cursor"
    assert table.diagnostics[0].line == DROPPED_RECEIVER_LINE
    return 0
