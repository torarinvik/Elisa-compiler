# A caller-provided mark is public data; invalid marks must not corrupt the cursor.
include "../../../elisacore_std/heap.elisa"

def main() -> i64:
    can Abort.Panic:
        storage: mutable u8[64] = zeroed
        allocator: mutable FixedBufferAllocator = fixed_buffer_allocator_init(&storage[0], 64)
        fixed_buffer_rewind(&allocator, FixedBufferMark{end_index: 65})
        return 91
