struct PackedStoreAllocResult:
    row: mutable heap void&?
    handle: mutable uintptr

extern ctx_packed_store_state_new(a: mutable Arena&, row_bytes: usize) -> mutable heap void& can[Memory.Allocate, Abort.Panic]
extern ctx_packed_store_alloc_result(a: mutable Arena&, size_bytes: usize, state_bits: mutable void&) -> PackedStoreAllocResult can[Memory.Allocate, Abort.Panic]
extern ctx_packed_store_decode(a: mutable Arena&, handle: uintptr, state_bits: mutable void&) -> mutable void& can[Abort.Panic]
extern ctx_packed_store_read_index_word(a: mutable Arena&, index: u32, state_bits: mutable void&, word_offset: usize) -> uintptr can[Abort.Panic]

def main() -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    region owner(4096):
        alloc: mutable Arena& = (&owner).cast[mutable Arena&] can Unsafe.PointerCast
        state: mutable void& = ctx_packed_store_state_new(alloc, size_of(uintptr))
        first: PackedStoreAllocResult = ctx_packed_store_alloc_result(alloc, size_of(uintptr), state)
        second: PackedStoreAllocResult = ctx_packed_store_alloc_result(alloc, size_of(uintptr), state)
        ctx_packed_store_decode(alloc, first.handle, state).cast[mutable uintptr&][0] <- 41 can Unsafe.PointerCast
        ctx_packed_store_decode(alloc, second.handle, state).cast[mutable uintptr&][0] <- 104 can Unsafe.PointerCast
        return ctx_packed_store_read_index_word(alloc, 0, state, 1).i64() - 104
