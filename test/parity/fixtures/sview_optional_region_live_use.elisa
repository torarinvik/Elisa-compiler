include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/collections.elisa"
include "../../../elisacore_std/elisacore_runtime_strings.elisa"

def consume_optional(value: sview?) -> i64:
    return 0

def main() -> i64:
    region scratch(64):
        bytes: u8&? @scratch = new[scratch] 65
        borrowed: sview = sview(bytes, 0, 1)
        maybe: sview? = borrowed
        result: i64 = consume_optional(maybe)
        destroy scratch
        absent: sview? = null
        return result + consume_optional(absent)
