include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/collections.elisa"
include "../../../elisacore_std/elisacore_runtime_strings.elisa"

def main() -> i64:
	can Abort.Panic, Memory.Allocate, Global{Read,Write}, Atomics{Exchange,Load,Store}, Unsafe{Alias,MutableGlobal,PointerCast,RawExtern}:
		output: mutable dstr = ctx_fstr_alloc(1)
		ctx_fstr_append(&output, "ab", 2)
		return 91
