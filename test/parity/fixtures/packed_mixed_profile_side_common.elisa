@packed_profile(build_heavy)
packed enum Dense:
    common:
        stamp: i64
    A(value: i64)
    B
packed enum Sparse:
    C(value: i64)
    D

def run(owner: Arena) -> i64:
    dense: Dense.Store[Local] = Dense.Store(owner)
    sparse: Sparse.Store[Local] = Sparse.Store(owner)
    first: mutable i64 = 0
    second: mutable i64 = 0
    in dense:
        value: Dense = new Dense.A(stamp: 5, value: 19)
        first <- match value:
            Dense.A(x): x + value.stamp
            Dense.B: 0
    in sparse:
        value: Sparse = new Sparse.C(value: 23)
        second <- match value:
            Sparse.C(x): x
            Sparse.D: 0
    return first + second

def main() -> i64:
    region r(8192):
        return run(r)
