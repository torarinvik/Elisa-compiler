include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/collections.elisa"
include "../../../elisacore_std/elisacore_runtime_strings.elisa"

def main() -> i64:
	can Abort.Panic, Console.Format, Memory.Allocate:
		joined: cstr = concat2("four", "five")
		scratch_joined: cstr = concat2_scratch("one", "two")
		sliced: cstr = string_slice("slice", 1, 4)
		copied: cstr = string_view_copy(sview("view", 0, -1))
		arena: mutable Arena = zeroed
		integer: cstr = int_to_string_into(&arena, 42)

		return 42 if string_view_eq(sview(joined, 0, -1), "fourfive") == 0
		return 42 if string_view_eq(sview(scratch_joined, 0, -1), "onetwo") == 0
		return 42 if string_view_eq(sview(sliced, 0, -1), "lic") == 0
		return 42 if string_view_eq(sview(copied, 0, -1), "view") == 0
		return 42 if string_view_eq(sview(integer, 0, -1), "42") == 0
		return 0
