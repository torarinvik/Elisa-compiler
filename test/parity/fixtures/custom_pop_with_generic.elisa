# An unrelated imported generic pop must not hide an ordinary custom receiver.
include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/collections.elisa"

module Custom:
    public:
        struct Receiver:
            value: i64
        def pop(receiver: Receiver) -> i64:
            return receiver.value

def main() -> i32:
    receiver: Custom::Receiver = Custom::Receiver{value: 42}
    return receiver.pop().i32()
