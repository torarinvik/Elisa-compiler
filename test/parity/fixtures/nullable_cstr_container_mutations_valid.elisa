include "../../../elisacore_std/elisacore_runtime.elisa"

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    text: cstr? = "safe"
    mutable values: dict[cstr, cstr?] = {}
    values.put("put", text)
    values.get_or_insert("get-or-insert", text)
    values.entry("entry-insert").insert(text)
    values.entry("entry-get-or-insert").get_or_insert(text)
    return 1 if not values.contains("put")
    return 2 if not values.contains("get-or-insert")
    return 3 if not values.contains("entry-insert")
    return 4 if not values.contains("entry-get-or-insert")
    return 0
