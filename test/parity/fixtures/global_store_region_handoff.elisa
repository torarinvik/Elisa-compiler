# Passing a region-backed optional aggregate into a no-allocation publisher must
# give the global an independent lifetime before the caller's region is released.
module G:
    public:
        struct T:
            xs: mutable darray[i64]
        global mutable saved: T? = null
        def publish(value: T?) -> void:
            can Global.Write:
                saved <- move value
        def read_back() -> i64:
            can Global.Read:
                if saved is held:
                    return held.xs[1]
            return -1
def main() -> i32:
    can Global.Write:
        region candidate_scope:
            items: darray[i64] = [5, 6, 7]
            candidate: G::T? = G::T{xs: items}
            G::publish(move candidate)
    can Global.Read:
        return 42 if G::read_back() == 6 else 1
