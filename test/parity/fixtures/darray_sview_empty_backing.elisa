def first_byte_of_empty(values: mutable darray[u8]&) -> i64:
    view: sview = values.as_sview()
    if view.len != 0:
        return 1
    # Even an empty view's data reference points at a readable NUL byte.
    return (view.data[0] can Unsafe.UncheckedIndex).i64()

def main() -> i64:
    values: mutable darray[u8] = []
    return 42 if first_byte_of_empty(values) == 0 else 1
