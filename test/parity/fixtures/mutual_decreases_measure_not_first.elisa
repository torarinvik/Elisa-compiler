def left(unused: i32&, remaining: usize) -> bool:
    requires remaining > 0
    decreases remaining
    if remaining <= 1:
        return true
    return right(unused, remaining - 1)

def right(unused: i32&, remaining: usize) -> bool:
    requires remaining > 0
    decreases remaining
    if remaining <= 1:
        return false
    return left(unused, remaining - 1)

def main() -> i32:
    return 0
