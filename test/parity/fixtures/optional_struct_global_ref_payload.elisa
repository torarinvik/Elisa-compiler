# A guarded payload binder has the value type `Ledger`; auto-borrowing that local
# passes its actual storage to a `Ledger&` callee.
struct Ledger:
    count: i64

global mutable ledger: Ledger? = null

def read_ledger(value: Ledger&) -> i64:
    return value.count

def read_optional(value: Ledger&?) -> i64:
    if value != null:
        return read_ledger(value)
    return 0

def borrow_optional_cell(value: Ledger?&) -> i64:
    return 0

def main() -> i64 can[Global.Read]:
    borrowed_cell: i64 = borrow_optional_cell(ledger)
    if ledger is present:
        return read_ledger(present)
    return borrowed_cell
