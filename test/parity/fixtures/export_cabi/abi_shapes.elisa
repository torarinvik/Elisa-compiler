# Aggregates of every C-ABI class crossing an export boundary, both directions.
struct I12 layout(c):
    a: i32
    b: i32
    c: i32
struct F16 layout(c):
    x: f32
    y: f32
    w: f32
    h: f32
struct D16 layout(c):
    x: f64
    y: f64
struct M8 layout(c):
    x: f32
    i: i32
struct L24 layout(c):
    a: i64
    b: i64
    c: i64
struct F32 layout(c):
    x: f32
    y: f32
    w: f32
    h: f32
    e0: f32
    e1: f32
    e2: f32
    e3: f32
export type I12 as I12
export type F16 as F16
export type D16 as D16
export type M8 as M8
export type L24 as L24
export type F32 as F32
def take_i12(v: I12) -> i32:
    return v.a + v.b + v.c
export fn take_i12(v: I12) -> i32 = take_i12
def take_f16(v: F16) -> f32:
    return v.x + v.h
export fn take_f16(v: F16) -> f32 = take_f16
def take_d16(v: D16) -> f64:
    return v.x + v.y
export fn take_d16(v: D16) -> f64 = take_d16
def take_m8(v: M8) -> f32:
    return v.x + v.i.f32()
export fn take_m8(v: M8) -> f32 = take_m8
def take_l24(v: L24) -> i64:
    return v.a + v.c
export fn take_l24(v: L24) -> i64 = take_l24
def ret_i12() -> I12:
    return I12{a: 1, b: 2, c: 3}
export fn ret_i12() -> I12 = ret_i12
def ret_f16() -> F16:
    return F16{x: 1.0, y: 2.0, w: 3.0, h: 4.0}
export fn ret_f16() -> F16 = ret_f16
def ret_d16() -> D16:
    return D16{x: 1.5, y: 2.5}
export fn ret_d16() -> D16 = ret_d16
def ret_l24() -> L24:
    return L24{a: 1, b: 2, c: 3}
export fn ret_l24() -> L24 = ret_l24
def ret_f32() -> F32:
    return F32{x: 1.0, y: 2.0, w: 3.0, h: 4.0, e0: 5.0, e1: 6.0, e2: 7.0, e3: 8.0}
export fn ret_f32() -> F32 = ret_f32
