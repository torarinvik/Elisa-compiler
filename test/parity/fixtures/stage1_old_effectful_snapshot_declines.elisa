# `old(...)` snapshots run in the function prologue. Even a pure user function is
# conservatively rejected here so entry capture never executes arbitrary code.
def identity(value: u64) -> u64:
    return value

def read_with_call(value: mutable u64&) -> u64:
    ensure result == old(identity(value[0]))
    return value[0]

def main() -> i32:
    value: mutable u64 = 7
    return 1 if read_with_call(&value) != 7
    return 0
