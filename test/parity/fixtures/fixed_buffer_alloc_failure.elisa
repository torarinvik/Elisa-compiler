# The panicking allocator must reject an exhausted buffer even in optimized builds.
include "../../../elisacore_std/heap.elisa"

def main() -> i64:
    can Abort.Panic:
        storage: mutable u8[8] = zeroed
        allocator: mutable FixedBufferAllocator = fixed_buffer_allocator_init(&storage[0], 8)
        _ = fixed_buffer_alloc_or_panic(&allocator, 9)
        return 91
