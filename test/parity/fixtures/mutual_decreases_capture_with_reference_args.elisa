def left(nodes: darray[i64]&, children: darray[usize]&, facts: darray[usize], root: usize, depth: usize, budget: usize) -> bool:
    requires budget > 0
    decreases budget
    subscripts: mutable darray[usize] = []
    if budget <= 1:
        return true
    return right(nodes, children, facts, root, &subscripts, depth + 1, budget - 1)

def right(nodes: darray[i64]&, children: darray[usize]&, facts: darray[usize], root: usize, subscripts: mutable darray[usize]&, depth: usize, budget: usize) -> bool:
    requires budget > 0
    decreases budget
    if budget <= 1:
        return false
    return left(nodes, children, facts, root, depth + 1, budget - 1)

def main() -> i32:
    return 0
