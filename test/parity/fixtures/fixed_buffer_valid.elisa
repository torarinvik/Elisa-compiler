# Resizing a non-tail buffer allocation must not overwrite a later live allocation.
include "../../../elisacore_std/heap.elisa"

def main() -> i64:
    can Abort.Panic, Unsafe.PointerCast:
        storage: mutable u8[64] = zeroed
        allocator: mutable FixedBufferAllocator = fixed_buffer_allocator_init(&storage[0], 64)
        first: mutable void& = fixed_buffer_alloc_or_panic(&allocator, 8)
        second: mutable void& = fixed_buffer_alloc_or_panic(&allocator, 8)

        original_end: usize = allocator.end_index
        return 1 if fixed_buffer_resize(&allocator, first, 8, 16)
        return 1 if allocator.end_index != original_end
        return 1 if not fixed_buffer_owns_range(&allocator, second, 8)

        return 1 if not fixed_buffer_resize(&allocator, second, 8, 12)
        return 1 if allocator.end_index != 20
        return 1 if not fixed_buffer_resize(&allocator, second, 12, 4)
        return 1 if allocator.end_index != 12

        aligned: mutable void& = fixed_buffer_alloc_align_or_panic(&allocator, 4, 16)
        trusted Unsafe.PointerCast:
            aligned_address: usize = aligned.cast[uintptr].usize()
            return 1 if aligned_address % 16 != 0

        allocator.end_index <- 65
        rejected: mutable void&? = fixed_buffer_alloc(&allocator, 1)
        return 1 if rejected != null or allocator.end_index != 65
        return 0
