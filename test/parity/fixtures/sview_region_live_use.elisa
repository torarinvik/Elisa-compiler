include "../../../elisacore_std/elisacore_runtime.elisa"

def main() -> i64:
    region scratch(64)
    bytes: mutable darray[u8] @scratch = [65.u8()]
    borrowed: sview = bytes_view_range(bytes, 0, 1.usize())
    alias: sview = borrowed
    result: i64 = alias.len
    destroy scratch
    return result
