include "../../../src/semantic/semantic.elisa"

using Ast

def substitute[@r](expression: Ast::Expr, name: sview, replacement: Ast::Expr) -> Ast::Expr @r:
    match expression:
        Ast::Expr.Invalid or Ast::Expr.Absent or Ast::Expr.IntLit(_) or Ast::Expr.BoolLit(_):
            return expression
        Ast::Expr.Ident(expression_name, _):
            return replacement if expression_name == name
            return expression
        Ast::Expr.Binary(left, operator, right, position):
            return Ast::Expr.Binary(substitute(left, name, replacement), operator, substitute(right, name, replacement), position)
        Ast::Expr.Tuple(elements, position):
            copied: mutable darray[Ast::Expr] @r = []
            for element in elements |copied, name, replacement|:
                copied.push(substitute(element, name, replacement))
            return Ast::Expr.Tuple(copied, position)
        _:
            return Ast::Expr.Invalid

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    position: Ast::Pos = Ast::pos_at_line(1)
    elements: mutable darray[Ast::Expr] = [Ast::Expr.Ident("x", position), Ast::Expr.IntLit(1)]
    match elements[1]:
        Ast::Expr.IntLit(value):
            return 10 if value != 1
        _:
            return 11
    expression: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Tuple(elements, position), TokenKind.EqEq, Ast::Expr.Tuple(elements, position), position)
    rebuilt: Ast::Expr = substitute(expression, "x", Ast::Expr.IntLit(2))
    match rebuilt:
        Ast::Expr.Binary(left, _, _, _):
            match left:
                Ast::Expr.Tuple(values, _):
                    return 1 if values.count != 2
                    match values[0]:
                        Ast::Expr.IntLit(value):
                            return 2 if value != 2
                        _:
                            return 3
                    match values[1]:
                        Ast::Expr.IntLit(value):
                            return 4 if value != 1
                        Ast::Expr.Invalid:
                            return 15
                        _:
                            return 5
                    return 0
                _:
                    return 6
        _:
            return 7
