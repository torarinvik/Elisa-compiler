struct Text:
    value: mutable cstr?

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        text: cstr = "safe"
        nullable_text: cstr? = text
        mutable item: Text = Text{value: null}
        item.value <- nullable_text

        mutable dynamic: darray[cstr?] = [nullable_text]
        dynamic.push(nullable_text)

        matched_text: cstr? =
            match 1:
                1:
                    nullable_text
                _:
                    null

        fixed: cstr?[1] = [nullable_text]
        return 0
