error SafeStorageFailure:
    Failed

struct Text:
    value: mutable cstr?

def nullable_text_source(fail: bool) -> cstr? error[SafeStorageFailure]:
    raise SafeStorageFailure.Failed if fail
    return "safe"

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        text: cstr = "safe"
        nullable_text: cstr? = text
        mutable item: Text = Text{value: null}
        item.value <- nullable_text

        mutable dynamic: darray[cstr?] = [nullable_text]
        dynamic.push(nullable_text)

        matched_text: cstr? =
            match 1:
                1:
                    nullable_text
                _:
                    null

        caught_text: cstr? =
            catch nullable_text_source(false):
                value:
                    value
                SafeStorageFailure.Failed:
                    null

        fixed: cstr?[1] = [nullable_text]
        return 0
