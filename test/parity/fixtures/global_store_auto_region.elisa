# Heap values stored into module globals must outlive the storing function. The
# function's automatic scratch region used to be arena_free'd at return, so every
# global below read back zeroed memory (exit 0 instead of 42).
module G:
    public:
        struct T:
            xs: mutable darray[i64]
        global mutable d: darray[i64] = zeroed
        global mutable s: T = zeroed
        global mutable o: T? = null
        def mk() -> darray[i64]:
            v: darray[i64] = [5, 6, 7]
            return move v
        def fill_d() -> void:
            can Global.Write:
                d <- mk()
        def fill_s() -> void:
            can Global.Write:
                s <- T{xs: mk()}
        def fill_o(flag: bool) -> void:
            if flag:
                can Global.Write:
                    o <- T{xs: mk()}
        def pd() -> i64:
            can Global.Read:
                e: darray[i64] = d
                return e[1]
        def ps() -> i64:
            can Global.Read:
                return s.xs[1]
        def peek() -> i64:
            can Global.Read:
                if o is h:
                    return h.xs[1]
            return -1
        # By-reference growth: the callee grows `r` in the region its caller supplies.
        global mutable r: T = zeroed
        def grow(t: mutable T&) -> void:
            for k in 0..<40 |t|:
                t.xs.push(k + 5)
        def fill_r() -> void:
            can Global{Read,Write}:
                grow(&r)
        def pr() -> i64:
            can Global.Read:
                return r.xs[1]
        def churn() -> i64:
            junk: darray[i64] = [9, 9, 9, 9, 9, 9, 9, 9]
            junk[0]
def main() -> i32:
    can Global{Read,Write}:
        G::fill_d()
        G::fill_s()
        G::fill_o(true)
        G::fill_r()
    _ = G::churn()
    can Global.Read:
        total: i64 = G::pd() * 4 + G::ps() * 2 + G::peek() * 1
        return 0 if G::pr() != 6 else total.i32()
