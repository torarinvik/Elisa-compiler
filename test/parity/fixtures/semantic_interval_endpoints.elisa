def satisfiable_wide(value: i64) -> void:
    requires value >= 5000000000000000000
    return

def impossible_above_max(value: i64) -> void:
    requires value > 9223372036854775807
    return

def impossible_below_min(value: i64) -> void:
    requires value < -9223372036854775807 - 1
    return

def needs_nonnegative(value: i64) -> i64:
    requires value >= 0
    return value

def recursive_underflow(value: i64) -> i64:
    requires value >= -9223372036854775807 - 1
    return needs_nonnegative(value - 1)

def unrepresentable_offset(value: i64) -> i64:
    requires value >= -9223372036854775807 - 1
    return needs_nonnegative(value - (-9223372036854775807 - 1))

def vacuous_guard(value: mutable i64) -> void:
    while value < -9223372036854775807 - 1:
        invariant value <= 9223372036854775807
        value <- value + 1

def checked_endpoint(value: mutable i64) -> void:
    while value <= 9223372036854775807:
        invariant value <= 9223372036854775807
        value <- value + 1

def main() -> i64:
    return 0
