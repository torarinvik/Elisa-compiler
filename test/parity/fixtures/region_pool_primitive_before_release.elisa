include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/heap.elisa"

def good() -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    region scratch(4096):
        pool: mutable RegionPool[i64] = region_pool_new(&scratch)
        handle: Pooled[i64] = pool.acquire()
        handle.ptr[0] <- 65
        ptr: mutable heap i64& = handle.ptr
        value: i64 = ptr[0]
        pool.release(move handle)
        return value

def main() -> i64:
    return good()
