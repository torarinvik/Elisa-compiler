# Reproducer for byte-to-word ceiling overflow in arena_alloc.
include "../../../elisacore_std/arena.elisa"

const MAX_U64_SIZE_BYTES: usize = 18446744073709551615

def main() -> i64:
    can Memory.Allocate, Memory.Release, Abort.Panic:
        arena: mutable Arena = zeroed
        _ = arena_alloc(&arena, MAX_U64_SIZE_BYTES)
        arena_free(&arena)
        return 91
