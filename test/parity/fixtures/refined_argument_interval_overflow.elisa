law InRange(self: i64, lo: i64, hi: i64) = self >= lo and self <= hi

def needs_small(value: i64 is InRange[0, 10]) -> void:
    return

def forward_product(value: i64 is InRange[3037000500, 3037000500]) -> void:
    needs_small(value * value)

def forward_sum(value: i64 is InRange[9223372036854775807, 9223372036854775807]) -> void:
    needs_small(value + 1)

def forward_negation(value: i64 is InRange[-9223372036854775807 - 1, -9223372036854775807 - 1]) -> void:
    needs_small(0 - value)

def main() -> i64:
    return 0
