# Same-leaf names in different modules are distinct declarations. The non-resetting
# qualified callee must not inherit the reset summary of Other::touch.
include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/collections.elisa"

module Other:
    def touch(owner: mutable Arena&) -> void:
        arena_reset(owner)

module Quiet:
    def touch(owner: mutable Arena&) -> void:
        pass

def main() -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    arena: mutable Arena = zeroed
    values: mutable darray[i64] @arena = [65]
    Quiet::touch(&arena)
    return 0 if values[0] == 65 else 1
