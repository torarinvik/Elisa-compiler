include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/collections.elisa"
include "../../../elisacore_std/elisacore_runtime_strings.elisa"

def view_of_literal(value: cstr) -> sview:
    return sview(value, 1, 4)

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return sview_len(view_of_literal("hello")).i64()
