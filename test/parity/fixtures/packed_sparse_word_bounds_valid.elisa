struct PackedStoreIndexAllocResult:
    row: mutable heap void&?
    index: mutable u32

extern ctx_packed_store_state_new_variant_sparse(a: mutable Arena&, row_bytes: usize) -> mutable heap void& can[Memory.Allocate, Abort.Panic]
extern ctx_packed_store_alloc_tagged_variant_sparse_result(a: mutable Arena&, size_bytes: usize, state_bits: mutable void&, tag: u32) -> PackedStoreIndexAllocResult can[Memory.Allocate, Abort.Panic]
extern ctx_packed_store_decode_variant_sparse(index: u32, state_bits: mutable void&) -> mutable void& can[Abort.Panic]
extern ctx_packed_store_read_variant_sparse_word(index: u32, state_bits: mutable void&, word_offset: usize) -> uintptr can[Abort.Panic]

def main() -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    region owner(4096):
        alloc: mutable Arena& = (&owner).cast[mutable Arena&] can Unsafe.PointerCast
        state: mutable void& = ctx_packed_store_state_new_variant_sparse(alloc, size_of(uintptr))
        row: PackedStoreIndexAllocResult = ctx_packed_store_alloc_tagged_variant_sparse_result(alloc, size_of(uintptr) + 1, state, 7)
        ctx_packed_store_decode_variant_sparse(row.index, state).cast[mutable uintptr&][1] <- 42 can Unsafe.PointerCast
        return ctx_packed_store_read_variant_sparse_word(row.index, state, 1).i64() - 42
