# Zero-byte requests remain valid and reserve the allocator's minimum one slot.
include "../../../elisacore_std/arena.elisa"

const ARENA_VALID_ALLOCATION_BYTES: usize = 17

def main() -> i64:
    can Memory.Allocate, Memory.Release, Abort.Panic:
        arena: mutable Arena = zeroed
        _ = arena_alloc(&arena, 0)
        _ = arena_alloc(&arena, ARENA_VALID_ALLOCATION_BYTES)
        arena_free(&arena)
        return 0
