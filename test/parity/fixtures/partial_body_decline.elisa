include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/collections.elisa"
include "../../../elisacore_std/elisacore_runtime_strings.elisa"

# `create` must be a body semantic accepts and the backend still declines, so the driver's
# refusal to write a partial artifact is what gets tested. i128 arithmetic is unlowered; when
# the backend learns it, replace this body with another construct it declines (the previous
# one, an enum payload holding `Arena&`, became supported).
module Probe:
	private:
		def create(x: i128) -> i128:
			return x * x
	public:
		def visible() -> i64:
			return 5

def main() -> i64:
	return Probe::visible()
