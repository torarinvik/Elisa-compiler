include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/collections.elisa"
include "../../../elisacore_std/elisacore_runtime_strings.elisa"

# `create` must DECLINE in the backend. It used to build `Token.Text(bits, owner: Arena&)`,
# which stage1 has since learned to lower; a `deque[i64]` local still has no layout
# (dangling_decline_smoke asserts the same construct declines).
module Probe:
	private:
		def create() -> i64:
			table: mutable deque[i64] = []
			return 3
	public:
		def visible() -> i64:
			return 5

def main() -> i64:
	return Probe::visible()
