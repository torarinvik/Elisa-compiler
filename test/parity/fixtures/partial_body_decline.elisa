include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/collections.elisa"
include "../../../elisacore_std/elisacore_runtime_strings.elisa"

module Probe:
	private:
		enum Token:
			Text(bits: uintptr, owner: Arena&)
		def create(arena: mutable Arena&) -> Token:
			return Token.Text(1.uintptr(), arena)
	public:
		def visible() -> i64:
			return 5

def main() -> i64:
	return Probe::visible()
