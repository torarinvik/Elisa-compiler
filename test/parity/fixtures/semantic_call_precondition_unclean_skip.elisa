# strict

def needs_small(value: i64) -> void:
    requires value <= 10
    return

def needs_limit(value: i64, limit: i64) -> void:
    requires value <= limit
    return

def caller_with_unmodelled_relation(value: i64, limit: i64) -> void:
    requires value <= limit
    needs_limit(value, limit)

def caller_without_unmodelled_relation(value: i64) -> void:
    needs_small(value)

def main() -> i64:
    return 0
