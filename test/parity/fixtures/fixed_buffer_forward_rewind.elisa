# A caller cannot use rewind to advance a forged cursor into unallocated storage.
include "../../../elisacore_std/heap.elisa"

def main() -> i64:
    can Abort.Panic:
        storage: mutable u8[32] = zeroed
        allocator: mutable FixedBufferAllocator = fixed_buffer_allocator_init(&storage[0], 32)
        fixed_buffer_rewind(&allocator, FixedBufferMark{end_index: 1})
        return 91
