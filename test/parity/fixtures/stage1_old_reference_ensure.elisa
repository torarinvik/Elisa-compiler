# Stage1 regression: runtime ensure checks must compare a mutable reference output
# with its value captured at function entry.
def input_sequence_next(current: u64, next: mutable u64&) -> u8:
    ensure current != 18446744073709551615 or next[0] == old(next[0])
    ensure current == 18446744073709551615 or next[0] == old(next[0]) + 1
    if current == 18446744073709551615:
        return 1
    next[0] <- next[0] + 1
    return 0

def main() -> i32:
    values: mutable u64[1] = [10]
    success_status: u8 = input_sequence_next(5, &values[0])
    return 1 if success_status != 0 or values[0] != 11
    exhausted_status: u8 = input_sequence_next(18446744073709551615, &values[0])
    return 2 if exhausted_status != 1 or values[0] != 11
    return 0
