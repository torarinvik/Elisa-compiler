# A mutable reference to a nullable pointer is a scalar pointer update, not a borrow of a
# relocatable container. Calling a function with this parameter must not invalidate the local
# pointer view merely because the parameter is mutable.
def advance(ptr: mutable u8&?&) -> void:
    pass

def main() -> i64:
    bytes: mutable array[u8, 4] = [0, zeroed, zeroed, zeroed]
    ptr: mutable u8&? = (&(bytes)[0]).cast[mutable u8&?]
    advance((&(ptr)).cast[mutable mutable u8&?&])
    advance((&(ptr)).cast[mutable mutable u8&?&])
    return 0
