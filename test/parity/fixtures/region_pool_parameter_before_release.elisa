include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/heap.elisa"

def good(pool: mutable RegionPool[i64]&, handle: Pooled[i64]) -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    ptr: mutable heap i64& = handle.ptr
    ptr[0] <- 65
    value: i64 = ptr[0]
    pool.release(move handle)
    return value

def main() -> i64:
    return 0
