enum Tree:
    Leaf(value: i64)
    Pair(left: Tree, right: Tree)

@packed_profile(build_heavy)
packed enum Dense:
    A(value: i64)
    B
packed enum Sparse:
    C(value: i64)
    D

def run(owner: Arena) -> i64:
    dense: Dense.Store[Local] = Dense.Store(owner)
    sparse: Sparse.Store[Local] = Sparse.Store(owner)
    tree: Tree.Store[Local] = Tree.Store(owner)
    third: mutable i64 = 0
    first: mutable i64 = 0
    second: mutable i64 = 0
    in dense:
        value: Dense = new Dense.A(value: 19)
        first <- match value:
            Dense.A(x): x
            Dense.B: 0
    in sparse:
        value: Sparse = new Sparse.C(value: 23)
        second <- match value:
            Sparse.C(x): x
            Sparse.D: 0
    in tree:
        left: Tree = new Tree.Leaf(value: 19)
        right: Tree = new Tree.Leaf(value: 23)
        root: Tree = new Tree.Pair(left: left, right: right)
        third <- match root:
            Tree.Pair(Tree.Leaf(a), Tree.Leaf(b)): a + b
            _: 0
    return first + second + third

def main() -> i64:
    region r(8192):
        return run(r)
