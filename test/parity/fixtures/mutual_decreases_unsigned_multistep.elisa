def left(remaining: usize) -> bool:
    requires remaining > 0
    decreases remaining
    if remaining <= 2:
        return true
    return right(remaining - 2)

def right(remaining: usize) -> bool:
    requires remaining > 0
    decreases remaining
    if remaining <= 2:
        return false
    return left(remaining - 2)

def main() -> i32:
    return 0
