module Cycle:
    def left(remaining: usize) -> bool:
        requires remaining > 0
        decreases remaining
        if remaining <= 1:
            return true
        return Cycle::right(remaining - 1)

    def right(remaining: usize) -> bool:
        requires remaining > 0
        decreases remaining
        if remaining <= 1:
            return false
        return Cycle::left(remaining - 1)

def main() -> i32:
    return 0
