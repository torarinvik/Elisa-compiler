include "../../../elisacore_std/elisacore_runtime_prelude.elisa"

def main() -> i64:
	can Memory.Allocate, Abort.Panic:
		choose_nullable: bool = true
		maybe_data: u8&? = null
		valid_data: u8& = "safe"
		trusted Unsafe.PointerCast:
			malformed: sview = StringView{data: maybe_data if choose_nullable else valid_data, len: 4}
			return malformed.len
