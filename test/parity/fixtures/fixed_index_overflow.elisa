# strict

law InRange(self: i64, lo: i64, hi: i64) = self >= lo and self <= hi

def overflowing_affine(values: i64[8]&, index: i64 is InRange[9223372036854775806, 9223372036854775807]) -> i64:
    return values[index + 1]

def zero_extent(data: i64[8]&) -> i64:
    empty = data[0:0]
    return empty[0]

def main() -> i64:
    return 0
