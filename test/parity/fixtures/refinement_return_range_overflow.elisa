law InRange(self: i64, lo: i64, hi: i64) = self >= lo and self <= hi

def overflowing_sum(value: i64 is InRange[9223372036854775807, 9223372036854775807]) -> i64 is InRange[0, 10]:
    return value + 1

def overflowing_product(value: i64 is InRange[4611686018427387904, 4611686018427387904]) -> i64 is InRange[0, 10]:
    return value * 2

def negate_min(value: i64 is InRange[-9223372036854775807 - 1, -9223372036854775807 - 1]) -> i64 is InRange[0, 10]:
    return 0 - value

def main() -> i64:
    return 0
