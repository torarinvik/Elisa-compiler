include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/collections.elisa"
include "../../../elisacore_std/elisacore_runtime_strings.elisa"

def main() -> i64:
	can Unsafe.PointerCast, Memory.Allocate, Abort.Panic:
		trusted Unsafe.PointerCast:
			left_data: mutable u8& = 1.uintptr().cast[mutable u8&]
			right_data: mutable u8& = 2.uintptr().cast[mutable u8&]
			left: sview = StringView{data: left_data, len: -1}
			right: sview = StringView{data: right_data, len: -1}

			return 42 if string_views_eq(left, right) != 0
			return 42 if string_view_eq(left, "") != 0
			return 42 if string_view_len(left) != 0
			return 42 if string_view_index(left, 0) != 0
			return 42 if string_view_slice(left, 0, -1).len != 0
			return 42 if sview_len(left) != 0
			return 42 if not sview_is_empty(left)
			return 42 if hash_sview(left) != 0xcbf29ce484222325
			return 42 if sview_starts_with(left, right)
			return 42 if sview_ends_with(left, right)
			return 42 if sview_trim_trailing(left, 47).len != 0
			return 42 if sview_basename(left, 47).len != 0
			return 42 if sview_dirname(left, 47).len != 0

			copied: cstr = string_view_copy(left)
			return 42 if runtime_strlen(copied) != 0

			valid: sview = sview("hello", 1, 4)
			return 42 if string_views_eq(valid, sview("ell", 0, -1)) == 0
			return 42 if string_view_index(valid, 1) != 'l'.i64()
			return 42 if string_view_slice(valid, 1, 2).len != 1
		return 0
