# 1000 overwrites of heap-holding module globals. Each overwrite allocates a 128 KiB
# payload; with re-homing the previous generation is reclaimed, so peak RSS stays a
# few payloads wide instead of growing to ~128 MiB (the never-freed static region).
module G:
    public:
        struct T:
            xs: mutable darray[i64]
            tag: sview
        global mutable d: darray[i64] = zeroed
        global mutable o: T? = null
        def mk(seed: i64) -> darray[i64]:
            v: mutable darray[i64] = []
            for i in 0 ..< 16384 |v, seed|:
                v.push(seed + i)
            return move v
        def fill(seed: i64) -> void:
            d <- mk(seed)
            o <- T{xs: mk(seed * 2), tag: "gen"}
        def check(seed: i64) -> i64:
            e: darray[i64] = d
            if o is h:
                if e[3] == seed + 3 and h.xs[5] == seed * 2 + 5 and h.tag == "gen":
                    return 1
            return 0
def main() -> i32:
    ok: mutable i64 = 0
    for k in 0 ..< 1000 |ok|:
        G::fill(k)
        ok <- ok + G::check(k)
    if ok == 1000:
        return 42
    return 1
