def main() -> i64:
    can Unsafe.PointerCast, Memory.Allocate, Abort.Panic, Global{Read,Write}:
        v: sview = sview("abcdef", 0, -1)
        return 11 if string_view_index(v, 0) != 97
        return 12 if string_view_index(v, 5) != 102
        return 13 if string_view_index(v, -1) != 0
        return 14 if string_view_index(v, 6) != 0
        return 15 if string_view_index(v, 4294967296) != 0
        return 16 if string_view_index(v, 9223372036854775807) != 0
        return 0
