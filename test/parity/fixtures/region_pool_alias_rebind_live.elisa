include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/heap.elisa"

def good() -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    can Global{Read,Write}, Unsafe.PointerCast, Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern}, Unsafe.UncheckedIndex:
        region scratch(4096):
            pool: mutable RegionPool[i64] = region_pool_new((&scratch).cast[mutable Arena&])
            first: Pooled[i64] = pool.acquire()
            second: Pooled[i64] = pool.acquire()
            first.ptr[0] <- 65
            second.ptr[0] <- 66
            ptr: mutable heap i64& = first.ptr
            pool.release(move first)
            ptr as & <- second.ptr
            return ptr[0]

def main() -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    can Global{Read,Write}, Abort.Panic, Atomics{Exchange,Load,Store}, Memory{Allocate,Release}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        return good()
