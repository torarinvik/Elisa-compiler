# Alignment rounding at the maximum usize value must fail before it wraps to address 0.
include "../../../elisacore_std/heap.elisa"

def main() -> i64:
    can Abort.Panic:
        maximum: usize = 18446744073709551615.u64().usize()
        _ = fixed_buffer_align_forward(maximum, 16)
        return 91
