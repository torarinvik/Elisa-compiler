# nopath
include "../../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../elisacore_std/collections.elisa"

def main() -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    outer_owner: mutable Arena = zeroed
    outer_alloc: mutable Arena& = &outer_owner
    outer_values: mutable darray[i64] @outer_alloc = [65]
    inner_owner: mutable Arena = zeroed
    inner_alloc: mutable Arena& = &inner_owner
    inner_alias: mutable Arena& = inner_alloc
    inner_alias_again: mutable Arena& = inner_alias
    inner_values: mutable darray[i64] @inner_alloc = [66]
    arena_reset(inner_alias_again)
    return outer_values[0]
