# strict

struct AbiView:
    size: i64

def read(view: AbiView, offset: i64) -> i64:
    requires offset + 4 <= view.size
    return 0

def struct_precondition_overflow() -> i64:
    view: AbiView = AbiView{size: 9223372036854775807}
    return read(view, 9223372036854775807)

def ordered(left: i64, right: i64 where left < right) -> i64:
    return right

def where_argument_overflow() -> i64:
    return ordered(0, 9223372036854775807 + 1)

struct Meter[state Positive | NonPositive]:
    value: i64

    derive state:
        Positive when self.value > 0
        NonPositive when self.value <= 0

def derived_state_overflow() -> Meter:
    return Meter{value: 9223372036854775807 + 1}

law InRange(self: i64, low: i64, high: i64) = self >= low and self <= high

def exclusive_endpoint_overflow() -> void:
    value: i64 is InRange[-9223372036854775807 - 1..<(-9223372036854775807 - 1)] = 0

def main() -> i64:
    return 0
