include "../../src/backend/codegen.elisa"

extend Backend:
    public:
        def effect_template_filter_test() -> i64 can[Abort.Panic, Memory.Allocate, Global{Read,Write}]:
            TEMPLATE_LINE: u32 = 2
            ORDINARY_LINE: u32 = 4
            EXPECTED_MEMBERS: usize = 1
            ORIGINAL_MEMBERS: usize = 2
            source: u8& = "module Box:\n    def same() -> i64:\n        return 1\n    def same(value: i64) -> i64:\n        return value\n"
            length: mutable usize = 0
            while source[length] != 0 |length|:
                length <- length + 1
            tokens: darray[Token] = frontend_tokenize_with_length(source, source, length)
            file: mutable Ast::File = frontend_parser_parse_file(source, tokens) can Global{Read,Write}
            assert file.errors.count == 0
            annotations: darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "__effect_template", name: "same", line: TEMPLATE_LINE}]
            original: Decl = file.top_decls[0]
            empty_annotations: darray[Ast::EnumAnnotation] = []
            unchanged: Decl = declaration_without_effect_templates(empty_annotations, original)
            assert declaration_module_count(unchanged) == ORIGINAL_MEMBERS
            assert function_line_of(declaration_module_at(unchanged, 0)) == TEMPLATE_LINE
            assert function_line_of(declaration_module_at(unchanged, 1)) == ORDINARY_LINE
            assert declaration_is_effect_template(annotations, declaration_module_at(original, 0))
            assert not declaration_is_effect_template(annotations, declaration_module_at(original, 1))
            filtered: Decl = declaration_without_effect_templates(annotations, original)
            assert declaration_module_count(filtered) == EXPECTED_MEMBERS
            retained: Decl = declaration_module_at(filtered, 0)
            assert function_name_of(retained) == "same"
            assert function_line_of(retained) == ORDINARY_LINE
            ctx: LLVMContextRef = LLVMContextCreate()
            module_handle: LLVMModuleRef = LLVMModuleCreateWithNameInContext("filter_control", ctx)
            machine: void& = configure_module_target(module_handle)
            target_data: LLVMTargetDataRef = LLVMCreateTargetDataLayout(machine)
            structs: mutable StructTable = new_struct_table(ctx, target_data)
            # Exercise the positive filter path through the production selector, preserving
            # the ordinary overload that shares the template's name.
            file.enum_annotations <- file.enum_annotations.push(annotations[0])
            selected: darray[Decl] = select_module_declarations(file, structs)
            assert selected.count == 1
            assert declaration_module_count(selected[0]) == EXPECTED_MEMBERS
            assert function_name_of(declaration_module_at(selected[0], 0)) == "same"
            assert function_line_of(declaration_module_at(selected[0], 0)) == ORDINARY_LINE
            static_source: u8& = "static def hidden() -> i64:\n    return 1\ndef visible() -> i64:\n    return 2\n"
            static_length: mutable usize = 0
            while static_source[static_length] != 0 |static_length|:
                static_length <- static_length + 1
            static_tokens: darray[Token] = frontend_tokenize_with_length(static_source, static_source, static_length)
            static_file: Ast::File = frontend_parser_parse_file(static_source, static_tokens) can Global{Read,Write}
            assert static_file.errors.count == 0
            static_selected: darray[Decl] = select_module_declarations(static_file, structs)
            assert static_selected.count == 1
            assert function_name_of(static_selected[0]) == "visible"
            LLVMDisposeModule(module_handle)
            LLVMContextDispose(ctx)
            return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate, Global{Read,Write}]:
    return Backend::effect_template_filter_test() can Global{Read,Write}
