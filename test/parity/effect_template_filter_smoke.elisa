include "../../src/backend/codegen.elisa"

extend Backend:
    public:
        def effect_template_filter_test() -> i64 can[Abort.Panic, Memory.Allocate]:
            TEMPLATE_LINE: u32 = 2
            ORDINARY_LINE: u32 = 4
            EXPECTED_MEMBERS: usize = 1
            ORIGINAL_MEMBERS: usize = 2
            source: u8& = "module Box:\n    def same() -> i64:\n        return 1\n    def same(value: i64) -> i64:\n        return value\n"
            length: mutable usize = 0
            while source[length] != 0 |length|:
                length <- length + 1
            tokens: darray[Token] = frontend_tokenize_with_length(source, source, length)
            file: Ast::File = frontend_parser_parse_file(source, tokens)
            assert file.errors.count == 0
            annotations: darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "__effect_template", name: "same", line: TEMPLATE_LINE}]
            original: Decl = file.top_decls[0]
            empty_annotations: darray[Ast::EnumAnnotation] = []
            unchanged: Decl = declaration_without_effect_templates(empty_annotations, original)
            assert declaration_module_count(unchanged) == ORIGINAL_MEMBERS
            assert function_line_of(declaration_module_at(unchanged, 0)) == TEMPLATE_LINE
            assert function_line_of(declaration_module_at(unchanged, 1)) == ORDINARY_LINE
            assert declaration_is_effect_template(annotations, declaration_module_at(original, 0))
            assert not declaration_is_effect_template(annotations, declaration_module_at(original, 1))
            filtered: Decl = declaration_without_effect_templates(annotations, original)
            assert declaration_module_count(filtered) == EXPECTED_MEMBERS
            retained: Decl = declaration_module_at(filtered, 0)
            assert function_name_of(retained) == "same"
            assert function_line_of(retained) == ORDINARY_LINE
            return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Backend::effect_template_filter_test()
