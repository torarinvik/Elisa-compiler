# Parser AST tests — PATTERNS and value blocks: leading-dot variants, parenthesized and rest
# patterns, type-alias refinements, struct invariants, block initializers and their captures,
# declared `lmut` returns, variadic ABI markers, annotation refinements, and `when` fan-out.
# Included by parser_ast_test.elisa.

using Ast


@test
def test_leading_dot_variant_pattern_is_structured() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "enum State:\n    Ready\n    Done\ndef f(x: State) -> void:\n    match x:\n        .Ready:\n            pass\n        _:\n            pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match first_func_body(file)[0]:
            Stmt.Match(scrutinee, arms, line):
                match arms[0].pattern:
                    Pattern.Variant(path, fields):
                        assert path == "Ready"
                        assert fields.count == 0
                    _:
                        assert false
            _:
                assert false




@test
def test_parenthesized_pattern_is_structured() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f(x: i64) -> void:\n    match x:\n        (-1):\n            pass\n        _:\n            pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match first_func_body(file)[0]:
            Stmt.Match(scrutinee, arms, line):
                match arms[0].pattern:
                    Pattern.Literal(text):
                        assert text == "-1"
                    _:
                        assert false
            _:
                assert false




@test
def test_rest_pattern_is_structured() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f(xs: darray[i64]) -> void:\n    match xs:\n        [first, ...rest]:\n            pass\n        [...]:\n            pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        match body[0]:
            Stmt.Match(scrutinee, arms, line):
                match arms[0].pattern:
                    Pattern.Tuple(elements):
                        assert elements.count == 2
                        match elements[1]:
                            Pattern.Rest(name):
                                assert name == "rest"
                            _:
                                assert false
                    _:
                        assert false
                match arms[1].pattern:
                    Pattern.Tuple(elements):
                        assert elements.count == 1
                        match elements[0]:
                            Pattern.Rest(name):
                                assert name == ""
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false




@test
def test_type_alias_refinement_is_structured() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "type Percent = i64 where 0 <= self\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match file.top_decls[0]:
            Decl.Alias(name, target, line):
                assert name == "Percent"
                match target:
                    Expr.Refinement(base, predicate, refinement_line):
                        pass
                    _:
                        assert false
            _:
                assert false




@test
def test_struct_invariant_is_structured() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "struct NonNegative:\n    value: i64\n    invariant self.value >= 0\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match file.top_decls[0]:
            Decl.Struct(name, members, affinity, has_states, has_derive, invariants, line):
                assert invariants.count == 1
                match invariants[0]:
                    Expr.Binary(left, operator, right, invariant_line):
                        pass
                    _:
                        assert false
            _:
                assert false




@test
def test_bare_block_initializer_preserves_block_value() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f() -> void:\n    x: darray[i64] =\n        [1]\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match first_func_body(file)[0]:
            Stmt.VarDecl(name, type_expression, value, line):
                match value:
                    Expr.Block(statements, value_expr, captures, block_line):
                        match value_expr:
                            Expr.Array(elements, array_line):
                                assert elements.count == 1
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false




@test
def test_value_block_preserves_multiple_captures() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f(a: mutable i64, b: mutable i64) -> i64:\n    x, y = |a, b|\n        a <- a + 1\n        b <- b + 1\n        a, b\n    return x + y\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match first_func_body(file)[0]:
            Stmt.Assign(target, operator, value, line):
                match target:
                    Expr.Array(targets, target_line):
                        assert targets.count == 2
                    _:
                        assert false
                match value:
                    Expr.Block(statements, block_value, captures, block_line):
                        assert captures.count == 2
                        assert captures[0] == "a"
                        assert captures[1] == "b"
                    _:
                        assert false
            _:
                assert false




@test
def test_declared_lmut_return_shape_and_value_are_retained() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "struct L:\n    p: mutable i64\n\ndef f(lx: lmut L) -> (ch: i64, lx: lmut L):\n    return 1, lx\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert file.top_decls.count == 2
        match file.top_decls[1]:
            Decl.Func(name, params, return_type, body, effects, decorators, line):
                match return_type:
                    Expr.Tuple(elements, tuple_line):
                        assert elements.count == 2
                        match elements[1]:
                            Expr.Unary(operator, operand, element_line):
                                assert operator == TokenKind.Lmut
                            _:
                                assert false
                    _:
                        assert false
                match body[0]:
                    Stmt.Return(value, return_line):
                        match value:
                            Expr.Tuple(elements, tuple_pos):
                                assert elements.count == 2
                            Expr.IntLit(number, _):
                                assert number == 1
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false




@test
def test_source_variadic_function_preserves_abi_marker() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def format_message(format: cstr, ...) -> void:\n    pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        assert any annotation in file.enum_annotations where annotation.owner == "__variadic" and annotation.name == "__variadic"
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Func(name, params, return_type, body, effects, decorators, line):
                assert name == "format_message"
                assert params.count == 1
                assert params[0].name == "format"
            _:
                assert false




@test
def test_annotation_refinements_are_structured() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "struct Box:\n    value: i64 where value >= 0\n\ndef f(x: i64 where x >= 0) -> i64 where result >= 0:\n    y: i64 where y >= 0 = x\n    pass\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        match file.top_decls[0]:
            Decl.Struct(name, members, affinity, has_states, has_derive, invariants, line):
                match members[0].type_expression:
                    Expr.Refinement(base, predicate, refinement_line):
                        pass
                    _:
                        assert false
            _:
                assert false
        match file.top_decls[1]:
            Decl.Func(name, params, return_type, body, effects, decorators, line):
                match return_type:
                    Expr.Refinement(base, predicate, refinement_line):
                        pass
                    _:
                        assert false
                match params[0].type_expression:
                    Expr.Refinement(base, predicate, refinement_line):
                        pass
                    _:
                        assert false
                match body[0]:
                    Stmt.VarDecl(local_name, local_type, value, local_line):
                        match local_type:
                            Expr.Refinement(base, predicate, refinement_line):
                                pass
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false




@test
def test_when_single_column_or_fans_out() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f(n: i64) -> i64:\n    return when n:\n        1 | 2 -> 10\n        _ -> 20\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        match body[0]:
            Stmt.Return(value, line):
                match value:
                    Expr.Match(scrutinee, arms, match_line):
                        assert arms.count == 3
                        match arms[0].pattern:
                            Pattern.Literal(text):
                                assert text == "1"
                            _:
                                assert false
                        match arms[1].pattern:
                            Pattern.Literal(text):
                                assert text == "2"
                            _:
                                assert false
                        match arms[2].pattern:
                            Pattern.Wildcard:
                                pass
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false




@test
def test_when_row_column_count_mismatch_is_rejected() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f(a: i64, b: i64) -> i64:\n    return when a, b:\n        0 -> 1\n        _ -> 2\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count > 0
