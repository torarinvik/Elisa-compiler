include "../../src/parser/parser_tokens.elisa"
include "../../src/parser/parser_token_position.elisa"

struct NestedSubmitTicket:
    node: Ast::Expr
    bias: i64

global mutable nested_group_gate: AtomicSlot[i64] = zeroed
global mutable nested_group_finished: AtomicSlot[i64] = zeroed
global mutable nested_group_observed: AtomicSlot[i64] = zeroed
global mutable nested_group_result: AtomicSlot[i64] = zeroed

def read_nested_submit_ticket(ticket: NestedSubmitTicket) -> i64:
    can Atomics.Load, Atomics.Store, Thread.Sleep, Global{Read,Write}:
        while load(&nested_group_gate, MemoryOrder.Acquire) == 0:
            sleep_usec(1000.u64())
        result: i64 = match ticket.node:
            Ast::Expr.IntLit(value, _): ticket.bias + value
            _: ticket.bias
        store(&nested_group_result, result, MemoryOrder.Release)
        store(&nested_group_finished, 1, MemoryOrder.Release)
        return result

def release_nested_submit_gate(value: i64) -> i64:
    can Atomics.Store, Thread.Sleep, Global{Read,Write}:
        _ = value
        sleep_usec(250_000.u64())
        store(&nested_group_gate, 1, MemoryOrder.Release)
        return 0

def main() -> i64:
    can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Pool.Create, Pool.Submit, Pool.WaitAll, Pool.Shutdown, Thread.Spawn, Thread.Join, Thread.Sleep, Atomics.Store, Atomics.Load, Atomics.CompareExchange, Sync{Lock,Wait,Unlock,Notify}, Global{Read,Write}:
        shared_workers: mutable ThreadPool = pool_new(2)
        outer_group: mutable TaskGroup = task_group_new()
        store(&nested_group_gate, 0, MemoryOrder.Release)
        store(&nested_group_finished, 0, MemoryOrder.Release)
        store(&nested_group_observed, 0, MemoryOrder.Release)
        store(&nested_group_result, 0, MemoryOrder.Release)
        region nodes(65536):
            store: Ast::Node.Store[Local] = Ast::Node.Store(nodes)
            in store:
                node: Ast::Expr = new Ast::Expr.IntLit(value: 37, pos: zeroed)
                inner_group: mutable TaskGroup = task_group_new()
                submit[shared_workers] read_nested_submit_ticket(NestedSubmitTicket{node: node, bias: 5})
                submit[shared_workers] release_nested_submit_gate(0)
                task_group_wait_all(&inner_group)
                store(&nested_group_observed, load(&nested_group_finished, MemoryOrder.Acquire), MemoryOrder.Release)
        # The assertion is deliberately before the outer wait. An inner manual group
        # must join its submissions itself, even when its block is inside an outer group.
        task_group_wait_all(&outer_group)
        observed: i64 = load(&nested_group_observed, MemoryOrder.Acquire)
        result: i64 = load(&nested_group_result, MemoryOrder.Acquire)
        pool_shutdown(&shared_workers)
        return 0 if observed == 1 and result == 42 else 1
