include "../../src/backend/codegen.elisa"

extend Backend:
    private:
        def name_chain_test_rows(names: darray[sview]&, buckets: darray[i64]&, next: darray[i64]&, query: sview) -> void can[Abort.Panic]:
            cursor: mutable i64 = name_chain_first(buckets, next, names, query)
            for row in 0..<names.count |cursor, names, buckets, next, query|:
                if names[row] == query:
                    assert cursor == row.i64()
                    cursor <- name_chain_next(buckets, next, names, query, cursor)
            assert cursor == -1

        def name_chain_test_all(names: darray[sview]&, buckets: darray[i64]&, next: darray[i64]&) -> void can[Abort.Panic, Memory.Allocate]:
            queries: darray[sview] = ["", "same", "middle", "filler", "Item", "late", "chain_collision_3", "chain_collision_5", "chain_collision_9", "chain_collision_10", "chain_collision_13", "chain_collision_19", "chain_collision_20", "chain_collision_30", "chain_collision_40", "chain_collision_49", "chain_collision_70", "chain_collision_100", "missing"]
            for query in queries |names, buckets, next|:
                name_chain_test_rows(names, buckets, next, query)

        def name_chain_test_collision(bucket_count: usize) -> void can[Abort.Panic]:
            if bucket_count == 32:
                assert name_chain_bucket("chain_collision_19", bucket_count) == name_chain_bucket("chain_collision_20", bucket_count)
            elif bucket_count == 64:
                assert name_chain_bucket("chain_collision_9", bucket_count) == name_chain_bucket("chain_collision_30", bucket_count)
            elif bucket_count == 128:
                assert name_chain_bucket("chain_collision_13", bucket_count) == name_chain_bucket("chain_collision_40", bucket_count)
            elif bucket_count == 256:
                assert name_chain_bucket("chain_collision_5", bucket_count) == name_chain_bucket("chain_collision_70", bucket_count)
            elif bucket_count == 512:
                assert name_chain_bucket("chain_collision_49", bucket_count) == name_chain_bucket("chain_collision_100", bucket_count)
            else:
                assert false

        def line_chain_test_rows(keys: darray[u32]&, buckets: darray[i64]&, next: darray[i64]&, query: u32) -> void can[Abort.Panic]:
            cursor: mutable i64 = line_chain_first(buckets, next, keys, query)
            for row in 0..<keys.count |cursor, keys, buckets, next, query|:
                if keys[row] == query:
                    assert cursor == row.i64()
                    cursor <- line_chain_next(buckets, next, keys, query, cursor)
            assert cursor == -1

        def line_chain_test_all(keys: darray[u32]&, buckets: darray[i64]&, next: darray[i64]&) -> void can[Abort.Panic, Memory.Allocate]:
            queries: darray[u32] = [0, 1, 16, 32, 64, 128, 256, 512, 99]
            for query in queries |keys, buckets, next|:
                line_chain_test_rows(keys, buckets, next, query)

        def line_chain_test_collision(bucket_count: usize) -> void can[Abort.Panic]:
            if bucket_count == 32:
                assert line_chain_bucket(0, bucket_count) == line_chain_bucket(32, bucket_count)
            elif bucket_count == 64:
                assert line_chain_bucket(0, bucket_count) == line_chain_bucket(64, bucket_count)
            elif bucket_count == 128:
                assert line_chain_bucket(0, bucket_count) == line_chain_bucket(128, bucket_count)
            elif bucket_count == 256:
                assert line_chain_bucket(0, bucket_count) == line_chain_bucket(256, bucket_count)
            elif bucket_count == 512:
                assert line_chain_bucket(0, bucket_count) == line_chain_bucket(512, bucket_count)
            else:
                assert false

    public:
        def check_dynamic_name_chains() -> void can[Abort.Panic, Memory.Allocate]:
            names: mutable darray[sview] = ["same", "chain_collision_3", "middle", "same", "chain_collision_10", "chain_collision_3", "Item", "pkg::Item", "chain_collision_5", "chain_collision_9", "chain_collision_13", "chain_collision_19", "chain_collision_20", "chain_collision_30", "chain_collision_40", "chain_collision_49", "chain_collision_70", "chain_collision_100"]
            buckets: mutable darray[i64] = []
            tails: mutable darray[i64] = []
            next: mutable darray[i64] = []
            name_chain_test_all(names, buckets, next)

            for _ in 0..<13 |names|:
                names.push("filler")
            name_chain_extend(buckets, tails, next, names)
            assert names.count == 31 and buckets.count == 0 and next.count == 0
            name_chain_test_all(names, buckets, next)

            names.push("filler")
            name_chain_extend(buckets, tails, next, names)
            assert names.count == 32 and buckets.count == name_chain_bucket_count(0, names.count, 0) and next.count == names.count
            name_chain_test_collision(buckets.count)
            name_chain_test_all(names, buckets, next)

            names.push("same")
            name_chain_extend(buckets, tails, next, names)
            assert names.count == 33 and buckets.count == name_chain_bucket_count(0, names.count, 0) and next.count == names.count
            name_chain_test_collision(buckets.count)
            name_chain_test_all(names, buckets, next)

            names.push("late")
            name_chain_test_all(names, buckets, next) # indexed prefix plus an unindexed appended tail
            name_chain_extend(buckets, tails, next, names)
            assert next.count == names.count
            name_chain_test_all(names, buckets, next)

            for _ in 0..<29 |names|:
                names.push("filler")
            name_chain_extend(buckets, tails, next, names)
            assert names.count == 63 and buckets.count == name_chain_bucket_count(0, names.count, 0) and next.count == names.count
            name_chain_test_collision(buckets.count)
            name_chain_test_all(names, buckets, next)
            names.push("filler")
            name_chain_extend(buckets, tails, next, names)
            assert names.count == 64 and buckets.count == name_chain_bucket_count(0, names.count, 0) and next.count == names.count
            name_chain_test_collision(buckets.count)
            names.push("Item")
            name_chain_extend(buckets, tails, next, names)
            assert names.count == 65 and buckets.count == name_chain_bucket_count(0, names.count, 0) and next.count == names.count
            name_chain_test_collision(buckets.count)
            name_chain_test_all(names, buckets, next)

            slice_query: sview = "pkg::Item"
            slice_row: mutable i64 = name_chain_slice_first(buckets, next, names, slice_query, 5, 9)
            assert slice_row == 6
            slice_row <- name_chain_slice_next(buckets, next, names, slice_query, 5, 9, slice_row)
            assert slice_row == 64
            slice_row <- name_chain_slice_next(buckets, next, names, slice_query, 5, 9, slice_row)
            assert slice_row == -1

            names <- names.truncate(5)
            name_chain_test_all(names, buckets, next)
            name_chain_extend(buckets, tails, next, names)
            assert names.count == 5 and buckets.count == 16 and tails.count == 16 and next.count == names.count
            tails <- tails.truncate(0)
            name_chain_extend(buckets, tails, next, names) # mismatched side arrays rebuild
            assert buckets.count == 16 and tails.count == buckets.count and next.count == names.count
            name_chain_test_all(names, buckets, next)

            keys: mutable darray[u32] = [0, 1, 0, 16, 1, 32, 64, 128, 256, 512]
            line_buckets: mutable darray[i64] = []
            line_tails: mutable darray[i64] = []
            line_next: mutable darray[i64] = []
            for _ in 0..<21 |keys|:
                keys.push(0)
            line_chain_extend(line_buckets, line_tails, line_next, keys)
            assert keys.count == 31 and line_buckets.count == 0 and line_next.count == 0
            line_chain_test_all(keys, line_buckets, line_next)

            keys.push(32)
            line_chain_extend(line_buckets, line_tails, line_next, keys)
            assert keys.count == 32 and line_buckets.count == name_chain_bucket_count(0, keys.count, 0) and line_next.count == keys.count
            line_chain_test_collision(line_buckets.count)
            line_chain_test_all(keys, line_buckets, line_next)

            keys.push(32)
            line_chain_extend(line_buckets, line_tails, line_next, keys)
            assert keys.count == 33 and line_buckets.count == name_chain_bucket_count(0, keys.count, 0) and line_next.count == keys.count
            line_chain_test_collision(line_buckets.count)
            line_chain_test_all(keys, line_buckets, line_next)

            keys.push(99)
            line_chain_test_all(keys, line_buckets, line_next) # indexed prefix plus an unindexed appended tail
            line_chain_extend(line_buckets, line_tails, line_next, keys)
            assert line_next.count == keys.count
            line_chain_test_all(keys, line_buckets, line_next)

            for _ in 0..<29 |keys|:
                keys.push(0)
            line_chain_extend(line_buckets, line_tails, line_next, keys)
            assert keys.count == 63 and line_buckets.count == name_chain_bucket_count(0, keys.count, 0) and line_next.count == keys.count
            line_chain_test_collision(line_buckets.count)
            keys.push(1)
            line_chain_extend(line_buckets, line_tails, line_next, keys)
            assert keys.count == 64 and line_buckets.count == name_chain_bucket_count(0, keys.count, 0) and line_next.count == keys.count
            line_chain_test_collision(line_buckets.count)
            keys.push(32)
            line_chain_extend(line_buckets, line_tails, line_next, keys)
            assert keys.count == 65 and line_buckets.count == name_chain_bucket_count(0, keys.count, 0) and line_next.count == keys.count
            line_chain_test_collision(line_buckets.count)
            line_chain_test_all(keys, line_buckets, line_next)

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    Backend::check_dynamic_name_chains()
    return 0
