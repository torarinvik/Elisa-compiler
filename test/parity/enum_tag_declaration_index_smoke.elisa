# Compile as an executable at both -O0 and -O3 and require exit zero.
# This test uses synthetic AST nodes so it also covers duplicate/empty names
# that an earlier semantic pass might reject in ordinary source programs.
include "../../src/parser/parser_tokens.elisa"

module Semantic:
    private:
        const FIRST_COUNT: usize = 2
        const LATER_COUNT: usize = 5

        # Deliberately retain the pre-index algorithm as a differential oracle.
        def original_count(declarations: darray[Ast::Decl], enum_name: sview) -> i64:
            can Memory.Allocate, Abort.Panic:
                result: mutable i64 = 0
                for declaration in declarations |result|:
                    match declaration:
                        Ast::Decl.Enum(name, variants, is_const, storage, line):
                            result <- variants.count.i64() if name == enum_name and result == 0
                        Ast::Decl.Module(name, body, line):
                            nested: i64 = original_count(body, enum_name)
                            result <- nested if nested > 0 and result == 0
                        Ast::Decl.Scoped(body, line):
                            nested: i64 = original_count(body, enum_name)
                            result <- nested if nested > 0 and result == 0
                        _:
                            pass
                return result

        def enum_fixture(name: sview, count: usize) -> Ast::Decl:
            can Memory.Allocate, Abort.Panic:
                variants: mutable darray[Ast::EnumVariant] = []
                for _ in 0..<count |variants|:
                    variants.push(Ast::EnumVariant{name: "V", fields: [], field_names: [], value_expr: Ast::Expr.Absent})
                return Ast::Decl.Enum(name, variants, false, Ast::Expr.Absent, Ast::pos_at_line(1))

    public:
        def index_smoke() -> void:
            can Memory.Allocate, Abort.Panic:
                nested: darray[Ast::Decl] = [enum_fixture("Same", FIRST_COUNT), enum_fixture("Nested", LATER_COUNT)]
                scoped: darray[Ast::Decl] = [Ast::Decl.Module("Inner", nested, Ast::pos_at_line(1)), enum_fixture("Scoped", FIRST_COUNT)]
                declarations: darray[Ast::Decl] = [enum_fixture("Same", 0), Ast::Decl.Scoped(scoped, Ast::pos_at_line(1)), enum_fixture("Same", LATER_COUNT), enum_fixture("Empty", 0), enum_fixture("", FIRST_COUNT)]
                names: mutable darray[sview] = []
                counts: mutable darray[i64] = []
                collect_enum_tag_declarations(declarations, names, counts)
                assert names.count == counts.count
                queries: darray[sview] = ["Same", "Nested", "Scoped", "Empty", "Missing", ""]
                for query in queries:
                    assert indexed_enum_tag_count(names, counts, query) == original_count(declarations, query)
                assert indexed_enum_tag_count(names, counts, "Same") == FIRST_COUNT.i64()
                empty: darray[Ast::Decl] = []
                empty_names: mutable darray[sview] = []
                empty_counts: mutable darray[i64] = []
                collect_enum_tag_declarations(empty, empty_names, empty_counts)
                assert indexed_enum_tag_count(empty_names, empty_counts, "Same") == 0
                # A second pass must not inherit an earlier pass's entries.
                second: darray[Ast::Decl] = [enum_fixture("Same", LATER_COUNT)]
                collect_enum_tag_declarations(second, empty_names, empty_counts)
                assert indexed_enum_tag_count(empty_names, empty_counts, "Same") == LATER_COUNT.i64()
                assert indexed_enum_tag_count(names, counts, "Same") == FIRST_COUNT.i64()

include "../../src/semantic/enum_tag_declaration_index.elisa"

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    Semantic::index_smoke()
    return 0
