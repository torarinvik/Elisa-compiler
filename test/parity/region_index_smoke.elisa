include "../../src/backend/codegen.elisa"

extend Backend:
    public:
        def region_index_test() -> i64 can[Abort.Panic, Memory.Allocate]:
            COLLISION_FIRST: sview = "region_test_9"
            COLLISION_SECOND: sview = "region_test_180"
            table: mutable StructTable = new_struct_table(null, null)
            table.region_fact_names <- [COLLISION_SECOND, COLLISION_FIRST, COLLISION_FIRST, COLLISION_FIRST, COLLISION_FIRST]
            table.region_fact_owners <- ["", "", "Box", "Box", ""]
            table.region_fact_starts <- [0, 1, 2, 3, 5]
            table.region_fact_counts <- [1, 1, 1, 2, 1]
            table.region_fact_params <- [true, false, false, true, true, true]
            assert region_fact_name_bucket(COLLISION_FIRST) == region_fact_name_bucket(COLLISION_SECOND)
            # Missing-index fallback has the same exact-owner and first-row semantics.
            assert not region_fact_parameter_has_region(COLLISION_FIRST, "Box", 0, table)
            assert region_fact_parameter_has_region(COLLISION_FIRST, "Box", 1, table)
            region_build_name_index(table)
            assert region_fact_parameter_has_region(COLLISION_SECOND, "", 0, table)
            assert not region_fact_parameter_has_region(COLLISION_FIRST, "", 0, table)
            assert not region_fact_parameter_has_region(COLLISION_FIRST, "Box", 0, table)
            assert region_fact_parameter_has_region(COLLISION_FIRST, "Box", 1, table)
            assert not region_fact_parameter_has_region(COLLISION_FIRST, "Other", 0, table)
            assert not region_fact_parameter_has_region(COLLISION_FIRST, "Other", 1, table)
            assert not region_fact_parameter_has_region("missing", "Box", 0, table)
            # Index only row identities; facts updated during the fixed point stay live.
            table.region_fact_params[2] <- true
            assert region_fact_parameter_has_region(COLLISION_FIRST, "Box", 0, table)
            return 0

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return Backend::region_index_test()
