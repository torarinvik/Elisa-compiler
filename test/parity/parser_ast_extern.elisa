# Parser AST tests — EXTERNS and error unions: the `-> T` clause that used to be swallowed by the
# header-clause skip, every extern spelling, the error-union suffix wherever it can appear, and
# tuple patterns. Included by parser_ast_test.elisa.

using Ast

@test
def test_extern_complete_effect_row_preserves_every_member() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("extern audit(x: u8) -> u8 can[Unsafe.RawExtern, Abort.Panic]\n") can Global{Read,Write}
        assert file.errors.count == 0
        complete: mutable bool = false
        row: mutable sview = ""
        legacy: mutable sview = ""
        row_offset: mutable u32 = 0
        for annotation in file.enum_annotations:
            if annotation.owner == "audit" and annotation.name == "__extern_effect_row_complete" and annotation.line == 1:
                complete <- true
                row_offset <- annotation.offset
            row <- annotation.name if annotation.owner == "__extern_effect_row_text" and annotation.line == 1 and annotation.offset == row_offset
            legacy <- annotation.name if annotation.owner == "__extern_effect_ref" and annotation.line == 1
        assert complete
        assert row_offset == 0
        assert row == "Unsafe.RawExtern, Abort.Panic"
        assert legacy == "Unsafe.RawExtern"

@test
def test_extern_without_effect_row_has_no_completeness_marker() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("extern audit(x: u8) -> u8\n") can Global{Read,Write}
        assert file.errors.count == 0
        for annotation in file.enum_annotations:
            assert annotation.name != "__extern_effect_row_complete"

@test
def test_extern_empty_effect_row_is_distinct_from_missing_row() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("extern audit(x: u8) -> u8 can[]\n") can Global{Read,Write}
        assert file.errors.count == 0
        complete: mutable bool = false
        text: mutable bool = false
        for annotation in file.enum_annotations:
            complete <- true if annotation.owner == "audit" and annotation.name == "__extern_effect_row_complete" and annotation.offset == 0
            text <- true if annotation.owner == "__extern_effect_row_text" and annotation.name == "" and annotation.offset == 0
        assert complete
        assert text

@test
def test_extern_effect_rows_pair_by_offset_when_logical_lines_match() -> void:
    can Memory.Allocate, Abort.Panic:
        source: sview = "#line 37 same.elisa\nextern first() -> void can[Memory.Allocate, Console.Write]\n#line 37 same.elisa\nextern second() -> void can[Unsafe.Alias, Global.Write]\n"
        file: Ast::File = parse_snippet(source) can Global{Read,Write}
        assert file.errors.count == 0
        first_offset: mutable u32 = 0
        second_offset: mutable u32 = 0
        first_row: mutable sview = ""
        second_row: mutable sview = ""
        for annotation in file.enum_annotations:
            first_offset <- annotation.offset if annotation.owner == "first" and annotation.name == "__extern_effect_row_complete"
            second_offset <- annotation.offset if annotation.owner == "second" and annotation.name == "__extern_effect_row_complete"
            if annotation.owner == "__extern_effect_row_text":
                first_row <- annotation.name if annotation.offset == first_offset
                second_row <- annotation.name if annotation.offset == second_offset
        assert first_offset != 0
        assert second_offset != 0
        assert first_offset != second_offset
        assert first_row == "Memory.Allocate, Console.Write"
        assert second_row == "Unsafe.Alias, Global.Write"

@test
def test_unclosed_extern_effect_row_is_not_complete() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("extern audit(x: u8) -> u8 can[Unsafe.RawExtern, Abort.Panic\n") can Global{Read,Write}
        for annotation in file.enum_annotations:
            assert annotation.name != "__extern_effect_row_complete"


# The `-> T` clause used to be swallowed by `skip_declaration_header_clauses`, leaving
# a backend unable to emit `declare <ret> @name(<params>)`. These pin that the return
# type now reaches the node. `return_type_name` is a bare name (empty == void), matching
# how `ExternParam.type_name` represents parameter types.
def extern_return_type_of(file: Ast::File&, index: usize) -> sview:
    can Abort.Panic:
        match file.top_decls[index]:
            Decl.Extern(_, _, _, _, _, return_type_name, _, _):
                return return_type_name
            _:
                return ""




@test
def test_extern_return_type_reaches_node() -> void:
    can Memory.Allocate, Abort.Panic:
        # The stage0 target: `extern strlen(s: cstr) -> usize`.
        file: Ast::File = parse_snippet("extern strlen(s: cstr) -> usize\n") can Global{Read,Write}
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        assert extern_return_type_of(file, 0) == "usize"




@test
def test_extern_without_return_type_is_empty() -> void:
    can Memory.Allocate, Abort.Panic:
        # No `-> T` clause at all: empty, which a backend reads as void.
        file: Ast::File = parse_snippet("extern side_effect(x: i64)\n") can Global{Read,Write}
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        assert extern_return_type_of(file, 0) == ""




@test
def test_extern_void_return_type_retained() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("extern release(p: ptr) -> void\n") can Global{Read,Write}
        assert file.errors.count == 0
        assert extern_return_type_of(file, 0) == "void"



@test
def test_redundantly_grouped_positional_tuple_type_is_rejected() -> void:
    can Memory.Allocate, Abort.Panic:
        local: Ast::File = parse_snippet("def make() -> void:\n    values: ((i64, i64)) = (1, 2)\n") can Global{Read,Write}
        nested_argument: Ast::File = parse_snippet("def take(values: darray[((i64, i64))]) -> void:\n    pass\n") can Global{Read,Write}
        assert local.errors.count > 0
        assert nested_argument.errors.count > 0



@test
def test_positional_tuple_type_is_rejected_in_typed_extern_globals() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("extern values: darray[(i64, i64)]\n") can Global{Read,Write}
        assert file.errors.count > 0



@test
def test_positional_tuple_type_is_rejected_in_extern_return_annotations() -> void:
    can Memory.Allocate, Abort.Panic:
        generic_return: Ast::File = parse_snippet("extern values() -> darray[(i64, i64)]\n") can Global{Read,Write}
        direct_return: Ast::File = parse_snippet("extern values() -> (i64, i64)\n") can Global{Read,Write}
        reference_return: Ast::File = parse_snippet("extern values() -> &(i64, i64)\n") can Global{Read,Write}
        multiline_return: Ast::File = parse_snippet("extern values(\n    unused: i64\n) -> darray[(i64, i64)]\n") can Global{Read,Write}
        multiline_named_return: Ast::File = parse_snippet("extern values(\n    unused: i64\n) -> darray[(left: i64, right: i64)]\n") can Global{Read,Write}
        assert generic_return.errors.count > 0
        assert direct_return.errors.count > 0
        assert reference_return.errors.count > 0
        assert multiline_return.errors.count > 0
        assert multiline_named_return.errors.count == 0
        assert direct_return.errors[0].kind == ParseErrorKind.ExpectedToken
        assert reference_return.errors[0].kind == ParseErrorKind.ExpectedToken




@test
def test_typed_extern_form_still_parses() -> void:
    can Memory.Allocate, Abort.Panic:
        # `extern name: T` — the non-call form. It has no `-> T`, and the trailing
        # `: T` must not be mistaken for a block colon.
        file: Ast::File = parse_snippet("extern errno: i32\n") can Global{Read,Write}
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Extern(name, _, arity, _, callable, return_type_name, _, _):
                assert name == "errno"
                assert not callable
                assert arity == 0
                # Non-callable typed externs reuse return_type_name for the global's type
                # head (`i32` here); there is no `->` return clause.
                assert return_type_name == "i32"
            _:
                assert false




@test
def test_extern_block_form_still_parses() -> void:
    can Memory.Allocate, Abort.Panic:
        # The `extern:` block form: members carry their own return types.
        file: Ast::File = parse_snippet("extern:\n    malloc(n: usize) -> ptr\n    free(p: ptr) -> void\n") can Global{Read,Write}
        assert file.errors.count == 0




@test
def test_export_global_extern_has_no_return_type() -> void:
    can Memory.Allocate, Abort.Panic:
        # `export global` builds an Extern node too; it has no signature to read.
        file: Ast::File = parse_snippet("export global Mod::counter as counter\n") can Global{Read,Write}
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        assert extern_return_type_of(file, 0) == ""




