@test
def test_parameter_error_union_suffix_is_preserved() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("error E:\n    X\n\ndef take(value: i64 error[E]) -> i64:\n    return 42\n") can Global{Read,Write}
        assert file.errors.count == 0
        found: mutable bool = false
        for annotation in file.enum_annotations |found|:
