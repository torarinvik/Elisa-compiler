@test
def test_same_line_parameter_error_union_offsets_are_exact() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("def take(left: i64 error[E], right: i64 error[F]) -> i64:\n    return 42\n") can Global{Read,Write}
        assert file.errors.count == 0
        first_parameter_offset: mutable u32 = 0
        second_parameter_offset: mutable u32 = 0
        for declaration in file.top_decls |first_parameter_offset, second_parameter_offset|:
            match declaration:
                Decl.Func(_, params, _, _, _, _, _):
                    assert params.count == 2
                    first_parameter_offset <- params[0].name_pos.offset
                    second_parameter_offset <- params[1].name_pos.offset
                _:
                    pass
        assert first_parameter_offset > 0
        assert second_parameter_offset > first_parameter_offset
        found_first: mutable bool = false
        found_second: mutable bool = false
        for annotation in file.enum_annotations |found_first, found_second, first_parameter_offset, second_parameter_offset|:
            if annotation.owner == "__param_error_union" and annotation.name == "E":
                assert annotation.offset == first_parameter_offset
                found_first <- true
            if annotation.owner == "__param_error_union" and annotation.name == "F":
                assert annotation.offset == second_parameter_offset
                found_second <- true
        assert found_first
        assert found_second



@test
def test_multi_family_error_union_value_types_are_rejected() -> void:
    can Memory.Allocate, Abort.Panic:
        parameter: Ast::File = parse_snippet("def take(value: i64 error[E, F]) -> i64:\n    return 42\n") can Global{Read,Write}
        assert parameter.errors.count == 1
        assert parameter.errors[0].kind == ParseErrorKind.UnsupportedValueErrorUnionFamilies
        assert parameter.errors[0].context == "error-union value types currently support exactly one family"

        selected_variants: Ast::File = parse_snippet("def take(value: i64 error[FooError{Bad1, Bad2}]) -> i64:\n    return 42\n") can Global{Read,Write}
        assert selected_variants.errors.count == 0

        expanded_variants: Ast::File = parse_snippet("extern take(callback: fn() -> i64 error[Net::Fault.Bad, Net::Fault.Gone]) -> i64\n") can Global{Read,Write}
        assert expanded_variants.errors.count == 0

        expanded_multiple_families: Ast::File = parse_snippet("extern take(callback: fn() -> i64 error[Net::Fault.Bad, Peer::Fault.Bad]) -> i64\n") can Global{Read,Write}
        assert expanded_multiple_families.errors.count == 1
        assert expanded_multiple_families.errors[0].kind == ParseErrorKind.UnsupportedValueErrorUnionFamilies

        selected_and_multiple: Ast::File = parse_snippet("def take(value: i64 error[FooError{Bad1, Bad2}, BarError]) -> i64:\n    return 42\n") can Global{Read,Write}
        assert selected_and_multiple.errors.count == 1
        assert selected_and_multiple.errors[0].kind == ParseErrorKind.UnsupportedValueErrorUnionFamilies

        local: Ast::File = parse_snippet("def make() -> i64:\n    value: i64 error[E, F] = 42\n    return value\n") can Global{Read,Write}
        assert local.errors.count == 1
        assert local.errors[0].kind == ParseErrorKind.UnsupportedValueErrorUnionFamilies

        field: Ast::File = parse_snippet("struct Box:\n    value: i64 error[E, F]\n") can Global{Read,Write}
        assert field.errors.count == 1
        assert field.errors[0].kind == ParseErrorKind.UnsupportedValueErrorUnionFamilies

        function_value: Ast::File = parse_snippet("def take(callback: fn() -> i64 error[E, F]) -> i64:\n    return 42\n") can Global{Read,Write}
        assert function_value.errors.count == 1
        assert function_value.errors[0].kind == ParseErrorKind.UnsupportedValueErrorUnionFamilies

        function_return: Ast::File = parse_snippet("def merge() -> i64 error[E, F]:\n    return 42\n") can Global{Read,Write}
        assert function_return.errors.count == 0




@test
def test_errorset_generic_and_fn_error_metadata_are_preserved() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("error E:\n    X\n\ndef apply[errorset R](f: fn() -> i64 error[R]) -> i64 error[R]:\n    return 0\n") can Global{Read,Write}
        assert file.errors.count == 0
        assert file.generic_func_decls.count == 1
        found_errorset: mutable bool = false
        found_fn_error: mutable bool = false
        for annotation in file.enum_annotations |found_errorset, found_fn_error|:
            found_errorset <- true if annotation.owner == "__errorset_param" and annotation.name == "R"
            found_fn_error <- true if annotation.owner == "__fn_error_union" and annotation.name == "R"
        assert found_errorset
        assert found_fn_error



@test
def test_same_line_generic_function_metadata_uses_owner_offsets() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& @source = "#line 0 generic-shadow.elisa\ndef shadow[Painter](value: Painter) -> Painter:\n    return value\n#line 0 plain-function.elisa\ndef plain(value: i64) -> i64:\n    return value\nprotocol Painter:\n    def paint(self: Self) -> i64\n#line 0 protocol-parameter.elisa\ndef draw(value: Painter) -> i64:\n    return 1\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        assert file.generic_func_decls.count == 2
        assert file.generic_func_decl_names.count == 2
        assert file.generic_func_decl_lines.count == 2
        found_shadow: mutable bool = false
        found_draw: mutable bool = false
        draw_offset: mutable u32 = 0
        plain_offset: mutable u32 = 0
        for declaration in file.top_decls |draw_offset, plain_offset|:
            match declaration:
                Decl.Func(name, _, _, _, _, _, pos):
                    draw_offset <- pos.offset if name == "draw"
                    plain_offset <- pos.offset if name == "plain"
                _:
                    pass
        assert draw_offset != 0
        assert plain_offset != 0
        for generic_index in 0..<file.generic_func_decls.count |found_shadow, found_draw, file|:
            match file.generic_func_decls[generic_index]:
                Decl.Func(name, _, _, _, _, _, pos):
                    assert file.generic_func_decl_names[generic_index] == name
                    assert file.generic_func_decl_lines[generic_index] == pos.line
                    found_shadow <- true if name == "shadow"
                    found_draw <- true if name == "draw"
                    assert name != "plain"
                _:
                    assert false
        assert found_shadow
        assert found_draw
        has_draw_parameter: mutable bool = false
        for generic_index in 0..<file.generic_param_lines.count |has_draw_parameter, draw_offset, file|:
            has_draw_parameter <- true if:
                generic_index < file.generic_param_names.count
                generic_index < file.generic_param_owner_offsets.count
                file.generic_param_lines[generic_index] == 0
                file.generic_param_owner_offsets[generic_index] == draw_offset
        assert has_draw_parameter



@test
def test_function_parameter_region_rows_keep_function_owner_offsets_at_line_zero() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& @source = "#line 0 first-region-owner.elisa\ndef first[@r](value: darray[u8] @r) -> darray[u8] @r:\n    return value\n#line 0 second-region-owner.elisa\ndef second[@r](value: darray[u8] @r) -> darray[u8] @r:\n    return value\n"
        file: Ast::File = parse_snippet(src) can Global{Read,Write}
        assert file.errors.count == 0
        function_offsets: mutable darray[u32] = []
        for declaration in file.top_decls |function_offsets|:
            match declaration:
                Decl.Func(name, _, _, _, _, _, pos):
                    function_offsets.push(pos.offset) if name == "first" or name == "second"
                _:
                    pass
        assert function_offsets.count == 2
        assert function_offsets[0] != function_offsets[1]
        parameter_rows: mutable u32 = 0
        return_rows: mutable u32 = 0
        for annotation in file.local_region_annotations |parameter_rows, return_rows, function_offsets|:
            if annotation.name == "value" and annotation.region == "r":
                parameter_rows <- parameter_rows + 1
                assert annotation.owner_offset == function_offsets[0] or annotation.owner_offset == function_offsets[1]
            if annotation.name == "__region_return" and annotation.region == "r":
                return_rows <- return_rows + 1
                assert annotation.owner_offset == function_offsets[0] or annotation.owner_offset == function_offsets[1]
        assert parameter_rows == 2
        assert return_rows == 2




extend Parser:
    public:
        def region_type_argument_owner_test() -> i64 can[Abort.Panic, Memory.Allocate, Global{Read,Write}]:
            pos: Ast::Pos = Ast::pos_at_line(0)
            annotations: darray[Ast::LocalRegionAnnotation] = [
                Ast::LocalRegionAnnotation{name: "__region_param", type_expression: (Ast::Expr.Invalid), region: "r", line: 0, owner_offset: 10, end_line: 1, end_offset: 50},
                Ast::LocalRegionAnnotation{name: "__region_param", type_expression: (Ast::Expr.Invalid), region: "r", line: 0, owner_offset: 100, end_line: 0, end_offset: 160},
                Ast::LocalRegionAnnotation{name: "__region_local", type_expression: (Ast::Expr.Invalid), region: "s", line: 0, owner_offset: 110, end_line: 0, end_offset: 130},
            ]
            parser: mutable Parser = Parser{local_region_annotations: annotations}
            region_type: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("Box", pos), Ast::Expr.Ident("r", pos), pos)
            unrelated_owner: darray[sview @source] = parser.parser_region_type_arguments(region_type, 0, 120, true, 3, 140) can Global{Read,Write}
            assert unrelated_owner.count == 0 can Abort.Panic
            local_type: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident("Box", pos), Ast::Expr.Ident("s", pos), pos)
            active_local: darray[sview @source] = parser.parser_region_type_arguments(local_type, 0, 100, true, 2, 120) can Global{Read,Write}
            assert active_local.count == 1 and active_local[0] == "s" can Abort.Panic
            closed_local: darray[sview @source] = parser.parser_region_type_arguments(local_type, 0, 100, true, 2, 130) can Global{Read,Write}
            assert closed_local.count == 0 can Abort.Panic
            active_parameter: darray[sview @source] = parser.parser_region_type_arguments(region_type, 0, 100, true, 2, 120) can Global{Read,Write}
            assert active_parameter.count == 1 and active_parameter[0] == "r" can Abort.Panic
            return 0


@test
def test_region_type_arguments_use_exact_function_and_local_scope() -> void:
    can Abort.Panic, Memory.Allocate, Global{Read,Write}:
        assert Parser::region_type_argument_owner_test() == 0 can Abort.Panic


include "./parser_ast_extern_error_families.elisa"
