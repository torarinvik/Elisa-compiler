# Parser AST tests — EXTERNS and error unions: the `-> T` clause that used to be swallowed by the
# header-clause skip, every extern spelling, the error-union suffix wherever it can appear, and
# tuple patterns. Included by parser_ast_test.elisa.

using Ast


# The `-> T` clause used to be swallowed by `skip_declaration_header_clauses`, leaving
# a backend unable to emit `declare <ret> @name(<params>)`. These pin that the return
# type now reaches the node. `return_type_name` is a bare name (empty == void), matching
# how `ExternParam.type_name` represents parameter types.
def extern_return_type_of(file: Ast::File&, index: usize) -> sview:
    can Abort.Panic:
        match file.top_decls[index]:
            Decl.Extern(_, _, _, _, _, return_type_name, _, _):
                return return_type_name
            _:
                return ""




@test
def test_extern_return_type_reaches_node() -> void:
    can Memory.Allocate, Abort.Panic:
        # The stage0 target: `extern strlen(s: cstr) -> usize`.
        file: Ast::File = parse_snippet("extern strlen(s: cstr) -> usize\n")
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        assert extern_return_type_of(file, 0) == "usize"




@test
def test_extern_without_return_type_is_empty() -> void:
    can Memory.Allocate, Abort.Panic:
        # No `-> T` clause at all: empty, which a backend reads as void.
        file: Ast::File = parse_snippet("extern side_effect(x: i64)\n")
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        assert extern_return_type_of(file, 0) == ""




@test
def test_extern_void_return_type_retained() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("extern release(p: ptr) -> void\n")
        assert file.errors.count == 0
        assert extern_return_type_of(file, 0) == "void"




@test
def test_typed_extern_form_still_parses() -> void:
    can Memory.Allocate, Abort.Panic:
        # `extern name: T` — the non-call form. It has no `-> T`, and the trailing
        # `: T` must not be mistaken for a block colon.
        file: Ast::File = parse_snippet("extern errno: i32\n")
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        match file.top_decls[0]:
            Decl.Extern(name, _, arity, _, callable, return_type_name, _, _):
                assert name == "errno"
                assert not callable
                assert arity == 0
                # Non-callable typed externs reuse return_type_name for the global's type
                # head (`i32` here); there is no `->` return clause.
                assert return_type_name == "i32"
            _:
                assert false




@test
def test_extern_block_form_still_parses() -> void:
    can Memory.Allocate, Abort.Panic:
        # The `extern:` block form: members carry their own return types.
        file: Ast::File = parse_snippet("extern:\n    malloc(n: usize) -> ptr\n    free(p: ptr) -> void\n")
        assert file.errors.count == 0




@test
def test_export_global_extern_has_no_return_type() -> void:
    can Memory.Allocate, Abort.Panic:
        # `export global` builds an Extern node too; it has no signature to read.
        file: Ast::File = parse_snippet("export global Mod::counter as counter\n")
        assert file.errors.count == 0
        assert file.top_decls.count == 1
        assert extern_return_type_of(file, 0) == ""




@test
def test_local_error_union_suffix_is_preserved_for_backend() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("error E:\n    X\n\ndef main() -> i64 error[E]:\n    value: i64 error[E] = 1\n    return 0\n")
        assert file.errors.count == 0
        found: mutable bool = false
        for annotation in file.enum_annotations |found|:
            found <- true if annotation.owner == "__local_error_union" and annotation.name == "E"
        assert found




@test
def test_struct_error_union_field_suffix_is_preserved() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("error E:\n    X\n\nstruct Box:\n    value: i64 error[E]\n")
        assert file.errors.count == 0
        found: mutable bool = false
        for annotation in file.enum_annotations |found|:
            found <- true if annotation.owner == "__field_error_union" and annotation.name == "E"
        assert found




@test
def test_parameter_error_union_suffix_is_preserved() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("error E:\n    X\n\ndef take(value: i64 error[E]) -> i64:\n    return 42\n")
        assert file.errors.count == 0
        found: mutable bool = false
        for annotation in file.enum_annotations |found|:
            found <- true if annotation.owner == "__param_error_union" and annotation.name == "E"
        assert found




@test
def test_errorset_generic_and_fn_error_metadata_are_preserved() -> void:
    can Memory.Allocate, Abort.Panic:
        file: Ast::File = parse_snippet("error E:\n    X\n\ndef apply[errorset R](f: fn() -> i64 error[R]) -> i64 error[R]:\n    return 0\n")
        assert file.errors.count == 0
        assert file.generic_func_decls.count == 1
        found_errorset: mutable bool = false
        found_fn_error: mutable bool = false
        for annotation in file.enum_annotations |found_errorset, found_fn_error|:
            found_errorset <- true if annotation.owner == "__errorset_param" and annotation.name == "R"
            found_fn_error <- true if annotation.owner == "__fn_error_union" and annotation.name == "R"
        assert found_errorset
        assert found_fn_error




@test
def test_tuple_pattern_keeps_every_element() -> void:
    can Memory.Allocate, Abort.Panic:
        src: u8& = "def f(node: i64) -> i64:\n    match node:\n        x, y:\n            return x + y\n        _:\n            return 0\n"
        file: Ast::File = parse_snippet(src)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_func_body(file)
        match body[0]:
            Stmt.Match(scrutinee, arms, line):
                assert arms.count == 2
                match arms[0].pattern:
                    Ast::Pattern.Tuple(elements):
                        assert elements.count == 2
                        match elements[0]:
                            Ast::Pattern.Binding(name):
                                assert name == "x"
                            _:
                                assert false
                        match elements[1]:
                            Ast::Pattern.Binding(name):
                                assert name == "y"
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false
