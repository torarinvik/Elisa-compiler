# Historical v1 encoder from 2f68db2, retained only as a wire-compatibility oracle.
extend Semantic:
    private:
        def legacy_put(bytes: mutable darray[u8]&, value: u64) -> void:
            can Memory.Allocate, Abort.Panic:
                for shift in 0..<8 |bytes|:
                    bytes.push(((value >> (shift * 8)) & 255).u8())

    public:
        def legacy_encode_snapshot(snapshot: IncrementalSemanticSnapshot&) -> IncrementalSnapshotEncodeResult:
            can Memory.Allocate, Abort.Panic:
                return IncrementalSnapshotEncodeResult{valid: false, bytes: []} if not isc_validate(snapshot)
                encoded_size: u64 = 120 + snapshot.bytes.count.u64() + snapshot.functions.count.u64() * 72 + snapshot.direct_facts.count.u64() * 56 + snapshot.active_grants.count.u64() * 24
                return IncrementalSnapshotEncodeResult{valid: false, bytes: []} if encoded_size > INCREMENTAL_SNAPSHOT_CODEC_LIMIT.u64()
                bytes: mutable darray[u8] = []
                legacy_put(bytes, 5786933367658005321)
                legacy_put(bytes, INCREMENTAL_SNAPSHOT_CODEC_VERSION)
                legacy_put(bytes, snapshot.schema_version.u64())
                legacy_put(bytes, snapshot.semantic_fingerprint)
                legacy_put(bytes, snapshot.options_fingerprint)
                legacy_put(bytes, snapshot.bytes.count.u64())
                legacy_put(bytes, snapshot.functions.count.u64())
                legacy_put(bytes, snapshot.direct_facts.count.u64())
                legacy_put(bytes, snapshot.active_grants.count.u64())
                legacy_put(bytes, snapshot.source_path_start.u64())
                legacy_put(bytes, snapshot.source_path_length.u64())
                legacy_put(bytes, snapshot.declaration_surface_start.u64())
                legacy_put(bytes, snapshot.declaration_surface_length.u64())
                legacy_put(bytes, snapshot.declaration_surface_hash)
                for byte in snapshot.bytes |bytes|:
                    bytes.push(byte)
                for record in snapshot.functions |bytes|:
                    legacy_put(bytes, record.key_start.u64())
                    legacy_put(bytes, record.key_length.u64())
                    legacy_put(bytes, record.body_start.u64())
                    legacy_put(bytes, record.body_length.u64())
                    legacy_put(bytes, record.body_hash.u64())
                    legacy_put(bytes, record.direct_fact_start.u64())
                    legacy_put(bytes, record.direct_fact_count.u64())
                    legacy_put(bytes, 1 if record.cacheable else 0)
                    legacy_put(bytes, record.reject_reason.u64())
                for record in snapshot.direct_facts |bytes|:
                    legacy_put(bytes, record.owner.u64())
                    legacy_put(bytes, record.kind.u64())
                    legacy_put(bytes, record.subject_start.u64())
                    legacy_put(bytes, record.subject_length.u64())
                    legacy_put(bytes, record.anchor_token.u64())
                    legacy_put(bytes, record.active_grant_start.u64())
                    legacy_put(bytes, record.active_grant_count.u64())
                for record in snapshot.active_grants |bytes|:
                    legacy_put(bytes, record.kind.u64())
                    legacy_put(bytes, record.name_start.u64())
                    legacy_put(bytes, record.name_length.u64())
                return IncrementalSnapshotEncodeResult{valid: false, bytes: []} if bytes.count > INCREMENTAL_SNAPSHOT_CODEC_LIMIT - 8
                checksum: u64 = ifc_hash(bytes, 0, bytes.count)
                legacy_put(bytes, checksum)
                return IncrementalSnapshotEncodeResult{valid: true, bytes: bytes}
