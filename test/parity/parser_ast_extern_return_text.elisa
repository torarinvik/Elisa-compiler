def extern_return_text_matches(source: u8&, expected_complete: bool, expected: sview) -> bool can[Memory.Allocate, Abort.Panic]:
    file: Ast::File = parse_snippet(source)
    complete: mutable usize = 0
    rows: mutable usize = 0
    text: mutable sview = ""
    for annotation in file.enum_annotations |complete, rows, text|:
        if annotation.owner == "probe" and annotation.name == "__extern_return_text_complete" and annotation.line == 1:
            complete <- complete + 1
        if annotation.owner == "__extern_return_text" and annotation.line == 1:
            rows <- rows + 1
            text <- annotation.name
    return complete == 0 and rows == 0 if not expected_complete
    return file.errors.count == 0 and complete == 1 and rows == 1 and text == expected

def qualified_return_has_no_contract_marker(source: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    file: Ast::File = parse_snippet(source)
    return false if file.errors.count != 0
    for annotation in file.enum_annotations:
        return false if annotation.owner == "probe" and annotation.name == "__extern_contract"
    return true

@test
def test_extern_return_text_scalar_and_qualified() -> void can[Memory.Allocate, Abort.Panic]:
    assert extern_return_text_matches("extern probe() -> u8 can[Unsafe.RawExtern]\n", true, "u8")
    assert extern_return_text_matches("extern probe() -> Box::u8 can[Unsafe.RawExtern]\n", true, "Box::u8")
    assert extern_return_text_matches("extern probe() -> Box::can can[Unsafe.RawExtern]\n", true, "Box::can")
    assert extern_return_text_matches("extern probe() -> requires::u8 can[Unsafe.RawExtern]\n", true, "requires::u8")
    assert extern_return_text_matches("extern probe() -> Box::requires can[Unsafe.RawExtern]\n", true, "Box::requires")
    assert extern_return_text_matches("extern probe() -> ensure::u8 can[Unsafe.RawExtern]\n", true, "ensure::u8")
    assert extern_return_text_matches("extern probe() -> Box::ensures can[Unsafe.RawExtern]\n", true, "Box::ensures")
    assert qualified_return_has_no_contract_marker("extern probe() -> requires::u8 can[Unsafe.RawExtern]\n")
    assert qualified_return_has_no_contract_marker("extern probe() -> Box::requires can[Unsafe.RawExtern]\n")
    assert extern_return_text_matches("extern probe() -> mutable heap u8&? can[Unsafe.RawExtern]\n", true, "mutable heap u8&?")
    assert extern_return_text_matches("extern probe() ->  u8  ", true, "u8")

@test
def test_extern_return_text_array_and_function() -> void can[Memory.Allocate, Abort.Panic]:
    assert extern_return_text_matches("extern probe() -> u8 [ 4 ] can[Unsafe.RawExtern]\n", true, "u8 [ 4 ]")
    assert extern_return_text_matches("extern probe() -> fn(value: u8) -> u8 can[Unsafe.RawExtern]\n", true, "fn(value: u8) -> u8")
    assert extern_return_text_matches("extern probe() -> (x: u8, y: darray[u8]) can[Unsafe.RawExtern]\n", true, "(x: u8, y: darray[u8])")

@test
def test_extern_return_text_contract_and_forwarder_boundaries() -> void can[Memory.Allocate, Abort.Panic]:
    assert extern_return_text_matches("extern probe() -> u8 requires true ensure true\n", true, "u8")
    assert extern_return_text_matches("export fn probe() -> u8 = target\n", true, "u8")
    assert extern_return_text_matches("extern probe() -> u8 error[E] can[Unsafe.RawExtern]\n", true, "u8 error[E]")

@test
def test_extern_return_text_incomplete_and_mismatched() -> void can[Memory.Allocate, Abort.Panic]:
    assert extern_return_text_matches("extern probe() can[Unsafe.RawExtern]\n", false, "")
    assert extern_return_text_matches("extern probe() -> u8[4\n", false, "")
    assert extern_return_text_matches("extern probe() -> u8]\n", false, "")
    assert extern_return_text_matches("extern probe() -> (u8]\n", false, "")
