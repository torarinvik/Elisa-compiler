def extern_return_text_matches(source: u8& @source, expected_complete: bool, expected: sview) -> bool can[Memory.Allocate, Abort.Panic]:
    file: Ast::File = parse_snippet(source) can Global{Read,Write}
    complete: mutable usize = 0
    rows: mutable usize = 0
    text: mutable sview = ""
    for annotation in file.enum_annotations |complete, rows, text|:
        if annotation.owner == "probe" and annotation.name == "__extern_return_text_complete" and annotation.line == 1 and annotation.offset == 0:
            complete <- complete + 1
        if annotation.owner == "__extern_return_text" and annotation.line == 1 and annotation.offset == 0:
            rows <- rows + 1
            text <- annotation.name
    return complete == 0 and rows == 0 if not expected_complete
    return file.errors.count == 0 and complete == 1 and rows == 1 and text == expected

def extern_return_text_owner_offsets_match() -> bool can[Memory.Allocate, Abort.Panic]:
    source: u8& @source = "#line 0 extern-return-owner.elisa\nextern first() -> First\n@borrows_return(field, second, value)\n#line 0 extern-return-owner.elisa\nextern second(value: i64&) -> Second\n"
    file: Ast::File = parse_snippet(source) can Global{Read,Write}
    return false if file.errors.count != 0
    first_offset: mutable u32 = 0
    second_offset: mutable u32 = 0
    declarations: mutable usize = 0
    for declaration in file.top_decls |first_offset, second_offset, declarations|:
        match declaration:
            Decl.Extern(name, _, _, _, callable, _, _, position):
                if name == "first" or name == "second":
                    return false if not callable or position.line != 0
                    first_offset <- position.offset if name == "first"
                    second_offset <- position.offset if name == "second"
                    declarations <- declarations + 1.usize()
            _:
                pass
    return false if declarations != 2.usize() or first_offset == second_offset
    first_complete: mutable usize = 0
    second_complete: mutable usize = 0
    first_return: mutable usize = 0
    second_return: mutable usize = 0
    first_text: mutable usize = 0
    second_text: mutable usize = 0
    for annotation in file.enum_annotations |first_complete, second_complete, first_return, second_return, first_text, second_text, first_offset, second_offset|:
        if annotation.line == 0 and annotation.offset == first_offset:
            first_complete <- first_complete + 1.usize() if annotation.owner == "first" and annotation.name == "__extern_return_text_complete"
            first_return <- first_return + 1.usize() if annotation.owner == "__extern_return" and annotation.name == "First"
            first_text <- first_text + 1.usize() if annotation.owner == "__extern_return_text" and annotation.name == "First"
        if annotation.line == 0 and annotation.offset == second_offset:
            second_complete <- second_complete + 1.usize() if annotation.owner == "second" and annotation.name == "__extern_return_text_complete"
            second_return <- second_return + 1.usize() if annotation.owner == "__extern_return" and annotation.name == "Second"
            second_text <- second_text + 1.usize() if annotation.owner == "__extern_return_text" and annotation.name == "Second"
    return first_complete == 1.usize() and second_complete == 1.usize() and first_return == 1.usize() and second_return == 1.usize() and first_text == 1.usize() and second_text == 1.usize()

def qualified_return_has_no_contract_marker(source: u8& @source) -> bool can[Memory.Allocate, Abort.Panic]:
    file: Ast::File = parse_snippet(source) can Global{Read,Write}
    return false if file.errors.count != 0
    for annotation in file.enum_annotations:
        return false if annotation.owner == "probe" and annotation.name == "__extern_contract"
    return true

@test
def test_extern_return_text_scalar_and_qualified() -> void can[Memory.Allocate, Abort.Panic]:
    assert extern_return_text_matches("extern probe() -> u8 can[Unsafe.RawExtern]\n", true, "u8") can Global{Read,Write}
    assert extern_return_text_matches("extern probe() -> Box::u8 can[Unsafe.RawExtern]\n", true, "Box::u8") can Global{Read,Write}
    assert extern_return_text_matches("extern probe() -> Box::can can[Unsafe.RawExtern]\n", true, "Box::can") can Global{Read,Write}
    assert extern_return_text_matches("extern probe() -> requires::u8 can[Unsafe.RawExtern]\n", true, "requires::u8") can Global{Read,Write}
    assert extern_return_text_matches("extern probe() -> Box::requires can[Unsafe.RawExtern]\n", true, "Box::requires") can Global{Read,Write}
    assert extern_return_text_matches("extern probe() -> ensure::u8 can[Unsafe.RawExtern]\n", true, "ensure::u8") can Global{Read,Write}
    assert extern_return_text_matches("extern probe() -> Box::ensures can[Unsafe.RawExtern]\n", true, "Box::ensures") can Global{Read,Write}
    assert qualified_return_has_no_contract_marker("extern probe() -> requires::u8 can[Unsafe.RawExtern]\n") can Global{Read,Write}
    assert qualified_return_has_no_contract_marker("extern probe() -> Box::requires can[Unsafe.RawExtern]\n") can Global{Read,Write}
    assert extern_return_text_matches("extern probe() -> mutable heap u8&? can[Unsafe.RawExtern]\n", true, "mutable heap u8&?") can Global{Read,Write}
    assert extern_return_text_matches("extern probe() ->  u8  ", true, "u8") can Global{Read,Write}

@test
def test_extern_return_text_array_and_function() -> void can[Memory.Allocate, Abort.Panic]:
    assert extern_return_text_matches("extern probe() -> u8 [ 4 ] can[Unsafe.RawExtern]\n", true, "u8 [ 4 ]") can Global{Read,Write}
    assert extern_return_text_matches("extern probe() -> fn(value: u8) -> u8 can[Unsafe.RawExtern]\n", true, "fn(value: u8) -> u8") can Global{Read,Write}
    assert extern_return_text_matches("extern probe() -> (x: u8, y: darray[u8]) can[Unsafe.RawExtern]\n", true, "(x: u8, y: darray[u8])") can Global{Read,Write}

@test
def test_extern_return_text_contract_and_forwarder_boundaries() -> void can[Memory.Allocate, Abort.Panic]:
    assert extern_return_text_matches("extern probe() -> u8 requires true ensure true\n", true, "u8") can Global{Read,Write}
    assert extern_return_text_matches("export fn probe() -> u8 = target\n", true, "u8") can Global{Read,Write}
    assert extern_return_text_matches("extern probe() -> u8 error[E] can[Unsafe.RawExtern]\n", true, "u8 error[E]") can Global{Read,Write}

@test
def test_extern_return_text_incomplete_and_mismatched() -> void can[Memory.Allocate, Abort.Panic]:
    assert extern_return_text_matches("extern probe() can[Unsafe.RawExtern]\n", false, "") can Global{Read,Write}
    assert extern_return_text_matches("extern probe() -> u8[4\n", false, "") can Global{Read,Write}
    assert extern_return_text_matches("extern probe() -> u8]\n", false, "") can Global{Read,Write}
    assert extern_return_text_matches("extern probe() -> (u8]\n", false, "") can Global{Read,Write}

@test
def test_extern_return_text_uses_exact_declaration_owner() -> void can[Memory.Allocate, Abort.Panic]:
    assert extern_return_text_owner_offsets_match() can Global{Read,Write}
