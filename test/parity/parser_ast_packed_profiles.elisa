# Profile annotations must retain their lexical owner: two modules can declare
# the same packed enum name with different profiles.
@test
def test_packed_profile_annotation_module_identity() -> void:
    can Memory.Allocate, Abort.Panic:
        source: u8& @source = "module First:\n    @packed_profile(build_heavy)\n    packed enum Dense:\n        A(value: i64)\n        B\nmodule Second:\n    @packed_profile(retained_reads)\n    packed enum Dense:\n        A(value: i64)\n        B\n@packed_profile(canonical)\npacked enum Dense:\n    A(value: i64)\n    B\n"
        file: Ast::File = parse_snippet(source) can Global{Read,Write}
        assert file.errors.count == 0
        first: mutable usize = 0
        second: mutable usize = 0
        top: mutable usize = 0
        for annotation in file.enum_annotations |first, second, top|:
            if annotation.line == 3900000041 and annotation.owner == "Dense":
                first <- first + 1 if annotation.module == "First" and annotation.name == "build_heavy"
                second <- second + 1 if annotation.module == "Second" and annotation.name == "retained_reads"
                top <- top + 1 if annotation.module == "" and annotation.name == "canonical"
        assert first == 1
        assert second == 1
        assert top == 1
