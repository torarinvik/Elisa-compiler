# Exercise stage1's `.elisair` reader against a bundle stage0 wrote.
#
# Prints one line per bundle:
#   ok <version> types=<n> nodes=<n> root=<n> source=<filename>
# or `fail <reason>`, so the gate can compare stage1's reading of a bundle
# against the facts stage0 recorded in it.
#
# This is the interoperability claim the v2 schema was for: the reader has no
# access to stage0's Go types, only to the type table the file carries.

include "../../elisacore_std/elisacore_runtime.elisa"
include "../../src/driver/frontend_ir.elisa"

extern open(path: cstr, flags: i64, ...) -> i64
extern close(fd: i64) -> i64
extern read(fd: i64, buf: u8&, count: usize) -> i64

def probe_read_file(path: cstr) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    contents: mutable darray[u8] = []
    descriptor: i64 = open(path, 0, 0)
    contents return if descriptor < 0
    chunk: mutable darray[u8] = []
    chunk.resize(65536)
    while true |contents, chunk, descriptor|:
        amount: i64 = read(descriptor, &chunk[0], 65536)
        break if amount <= 0
        for index in 0..<amount.usize() |contents, chunk|:
            contents.push(chunk[index])
    _ = close(descriptor)
    return contents


def probe_emit(text: darray[u8]&) -> void can[Abort.Panic, Unsafe.PointerCast]:
    return if text.count == 0
    buffer: void& = (&text[0]).cast[void&] can Unsafe.PointerCast
    _ = write(1, buffer, text.count)


def probe_push_text(buffer: mutable darray[u8]&, text: sview) -> void can[Abort.Panic, Memory.Allocate]:
    for index in 0..<sview_len(text) |buffer|:
        buffer.push(sview_at(text, index).u8())


def probe_push_number(buffer: mutable darray[u8]&, value: usize) -> void can[Abort.Panic, Memory.Allocate]:
    if value == 0:
        buffer.push('0'.u8())
        return
    digits: mutable darray[u8] = []
    remaining: mutable usize = value
    while remaining > 0 |digits|:
        digits.push(('0'.u8()) + (remaining % 10).u8())
        remaining <- remaining / 10
    for index in 0..<digits.count |buffer|:
        buffer.push(digits[digits.count - 1 - index])


# Copy a span out of the bundle image. The reader stores spans rather than
# strings, so printing one is an explicit copy.
def probe_push_span(buffer: mutable darray[u8]&, data: darray[u8]&, start: usize, length: usize) -> void can[Abort.Panic, Memory.Allocate]:
    for index in 0..<length |buffer|:
        buffer.push(data[start + index])


def main(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    line: mutable darray[u8] = []
    if argc < 2:
        probe_push_text(&line, "fail no bundle path given\n")
        probe_emit(line)
        return 2
    arguments: mutable cstr&& = argv.cast[mutable cstr&&]
    path: cstr = arguments[1].cast[cstr]
    data: darray[u8] = probe_read_file(path)
    if data.count == 0:
        probe_push_text(&line, "fail unreadable bundle\n")
        probe_emit(line)
        return 2
    bundle: FrontendIr::IrBundle = FrontendIr::ir_bundle_parse(data)
    if not bundle.ok:
        probe_push_text(&line, "fail ")
        probe_push_text(&line, bundle.error_line)
        probe_push_text(&line, "\n")
        probe_emit(line)
        return 1
    probe_push_text(&line, "ok ")
    probe_push_number(&line, bundle.version.usize())
    probe_push_text(&line, " types=")
    probe_push_number(&line, bundle.types.count)
    probe_push_text(&line, " nodes=")
    probe_push_number(&line, bundle.nodes.count)
    probe_push_text(&line, " root=")
    probe_push_number(&line, bundle.root.usize())
    probe_push_text(&line, " source=")
    probe_push_span(&line, data, bundle.source_name_start, bundle.source_name_length)
    probe_push_text(&line, "\n")
    probe_emit(line)
    return 0
