include "../../elisacore_std/elisacore_runtime.elisa"

global mutable conditional_submit_result: AtomicCell[i64] = zeroed

def conditional_submit_worker(value: i64) -> i64:
    can Atomics.Store, Global{Read,Write}:
        atomic_store_release(&conditional_submit_result, value)
        return value

def run_conditional_submit(flag: bool) -> i64:
    can Memory.Allocate, Abort.Panic, Parallel, Atomics.Store, Atomics.Load, Global{Read,Write}:
        atomic_store_release(&conditional_submit_result, 0)
        nursery workers(1):
            submit conditional_submit_worker(11) if flag else submit conditional_submit_worker(23)
        return atomic_load_acquire(&conditional_submit_result)

def main() -> i64:
    can Memory.Allocate, Abort.Panic, Parallel, Atomics.Store, Atomics.Load, Global{Read,Write}:
        return 0 if run_conditional_submit(true) == 11 and run_conditional_submit(false) == 23 else 1
