module Backend:
    public:
        def table_unroll_probe_placeholder() -> i32:
            0
include "../../src/backend/llvm_c.elisa"
include "../../src/driver/elisac_artifact_identity.elisa"
include "../../src/backend/codegen_split_half.elisa"
include "../../src/backend/codegen_zero_forward.elisa"
include "../../src/backend/codegen_table_unroll.elisa"
extern LLVMParseIRInContext(ctx: LLVMContextRef, buffer: void&, module_out: mutable LLVMModuleRef&, message_out: void&) -> i32

extend Backend:
    public:
        def probe_counted_clone_budget_unroll(module: LLVMModuleRef, ctx: LLVMContextRef, attempts: mutable usize&) -> i32 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read]:
            checks: mutable usize = 0
            work: mutable usize = 200000
            can Global.Read:
                return tu_platform(module, ctx, null, attempts, checks, work) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read]

def main() -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read]:
    context: LLVMContextRef = LLVMContextCreate()
    buffer: mutable void&? = null
    message: mutable void&? = null
    placeholder: LLVMModuleRef = LLVMModuleCreateWithNameInContext("placeholder", context)
    module: mutable LLVMModuleRef = placeholder
    status: mutable i32 = LLVMCreateMemoryBufferWithContentsOfFile("test/parity/stage1_table_unroll_clone_budget_fixture.ll", (&buffer).cast[void&], (&message).cast[void&]) can Unsafe.PointerCast
    return 80 if status != 0
    if buffer is loaded:
        status <- LLVMParseIRInContext(context, loaded, &module, (&message).cast[void&]) can Unsafe.PointerCast
    LLVMDisposeModule(placeholder)
    return 81 if status != 0
    return 82 if LLVMVerifyModule(module, 2, null) != 0
    expected_attempts: usize = 1 if LLVMGetNamedFunction(module, "budget_expect_attempt") != null else 0
    attempts: mutable usize = 0
    can Global.Read:
        return 83 if (Backend::probe_counted_clone_budget_unroll(module, context, attempts) can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Unsafe.PointerArithmetic, Global.Read]) != 0
    return 86 if attempts != expected_attempts
    return 84 if LLVMVerifyModule(module, 2, null) != 0
    return 85 if LLVMWriteBitcodeToFile(module, "test/parity/stage1_table_unroll_clone_budget_output.bc") != 0
    LLVMDisposeModule(module)
    LLVMContextDispose(context)
    0
