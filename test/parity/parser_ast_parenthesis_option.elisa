# Parser instances carry their own formatting-only grouping policy. The default and explicit
# false paths must keep compile ASTs free of Expr.Paren, even after a preserving parse.

using Ast


def parse_snippet_with_parentheses(source: u8& @source, preserve_parens: bool) -> Ast::File:
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Token] = frontend_tokenize(source, source)
        return frontend_parser_parse_file(source, tokens, preserve_parens) can Global{Read,Write}


def first_return_is_parenthesized(file: Ast::File&) -> bool:
    return false if file.errors.count != 0 or file.top_decls.count == 0
    match file.top_decls[0]:
        Decl.Func(_, _, _, body, _, _, _):
            return false if body.count == 0
            match body[0]:
                Stmt.Return(value, _):
                    if value is present:
                        match present:
                            Expr.Paren(inner, _):
                                match inner:
                                    Expr.IntLit(number, _):
                                        return number == 1
                                    _:
                                        return false
                            _:
                                return false
                    return false
                _:
                    return false
        _:
            return false


def first_return_is_plain_integer(file: Ast::File&) -> bool:
    return false if file.errors.count != 0 or file.top_decls.count == 0
    match file.top_decls[0]:
        Decl.Func(_, _, _, body, _, _, _):
            return false if body.count == 0
            match body[0]:
                Stmt.Return(value, _):
                    if value is present:
                        match present:
                            Expr.IntLit(number, _):
                                return number == 1
                            _:
                                return false
                    return false
                _:
                    return false
        _:
            return false


@test
def test_parenthesis_preservation_is_per_parser() -> void:
    can Memory.Allocate, Abort.Panic:
        source: u8& @source = "def probe() -> i64:\n    return (1)\n"
        preserved: Ast::File = parse_snippet_with_parentheses(source, true) can Global{Read,Write}
        assert first_return_is_parenthesized(preserved)

        defaulted: Ast::File = parse_snippet(source) can Global{Read,Write}
        assert first_return_is_plain_integer(defaulted)

        explicit_default: Ast::File = parse_snippet_with_parentheses(source, false) can Global{Read,Write}
        assert first_return_is_plain_integer(explicit_default)
