# Run with ELISACORE_NOALIAS_MUTABLE_REFS absent and present. The disabled case
# checks that the analysis itself was skipped, not just its metadata consumer.
include "../../src/backend/codegen.elisa"

extend Backend:
    private:
        const EXPECTED_CANDIDATES: usize = 1
        const BOTH_PARAMETERS: u64 = 3

    public:
        def check_disjoint_opt_in() -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            source: u8& = "def axpy(y: mutable darray[f64]&, x: mutable darray[f64]&) -> void:\n    y[0] <- x[0]\n\ndef main() -> i64:\n    a: mutable darray[f64] = []\n    b: mutable darray[f64] = []\n    axpy(&a, &b)\n    return 0\n"
            length: mutable usize = 0
            while source[length] != 0 |length|:
                length <- length + 1
            tokens: darray[Lexer::Token] = frontend_tokenize_with_length(source, source, length)
            file: Ast::File = frontend_parser_parse_file(source, tokens)
            assert file.errors.count == 0
            ctx: LLVMContextRef = LLVMContextCreate()
            module_handle: LLVMModuleRef = LLVMModuleCreateWithNameInContext("disjoint_opt_in_smoke", ctx)
            machine: LLVMTargetMachineRef = Backend::configure_module_target(module_handle)
            target_data: LLVMTargetDataRef = LLVMCreateTargetDataLayout(machine)
            table: mutable Backend::StructTable = Backend::new_struct_table(ctx, target_data)
            top: darray[Ast::Decl] = Backend::select_module_declarations(file, table)
            Backend::register_module_types(file, top, table, module_handle, ctx)
            if getenv("ELISACORE_NOALIAS_MUTABLE_REFS") is configured:
                assert table.disjoint_function_names.count == EXPECTED_CANDIDATES
                assert table.disjoint_function_names[0] == "axpy"
                assert table.disjoint_candidate_masks[0] == BOTH_PARAMETERS
                assert table.disjoint_function_masks[0] == BOTH_PARAMETERS
            else:
                assert table.disjoint_function_names.count == 0
                assert table.disjoint_candidate_masks.count == 0
                assert table.disjoint_function_masks.count == 0
            LLVMDisposeTargetData(target_data)
            LLVMDisposeModule(module_handle)
            LLVMContextDispose(ctx)

def main() -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    Backend::check_disjoint_opt_in()
    return 0
