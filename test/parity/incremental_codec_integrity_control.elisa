include "../../src/parser/parser.elisa"
using Ast
using Bytes

# The portable codec depends on parsed AST and owned fact records, not checker passes.
module Semantic:
    public:
        const CODEC_CONTROL_CONTEXT: u32 = 1

include "../../src/semantic/incremental_semantic_options.elisa"
include "../../src/semantic/incremental_function_facts.elisa"
include "../../src/semantic/incremental_snapshot_codec.elisa"
include "./incremental_codec_legacy_encoder.elisa"

extend Semantic:
    public:
        def incremental_codec_integrity_control() -> i64:
            can Memory.Allocate, Abort.Panic:
                source: static u8& = "def leaf() -> i64:\n    return 7\ndef value() -> i64:\n    can Global.Read:\n        return leaf()\n"
                tokens: darray[Lexer::Token] = frontend_tokenize_with_length(source, source, 95)
                file: Ast::File = frontend_parser_parse_file(source, tokens) can Global{Read,Write}
                assert file.errors.count == 0
                options: IncrementalSemanticOptions = incremental_semantic_options_from_values(false, false, false, false, false, false, false, false, false, false, 64, false, false, false)
                options_key: mutable darray[u8] = []
                assert incremental_semantic_options_encode(options, &options_key)
                changed_options_key: mutable darray[u8] = []
                changed_options_key.extend(options_key)
                changed_options_key[8] <- 1
                assert incremental_semantic_options_key_valid(options_key)
                assert incremental_semantic_options_key_valid(changed_options_key)
                assert not incremental_semantic_options_key_equal(options_key, changed_options_key)
                previous: IncrementalSemanticSnapshot = isc_empty()
                snapshot: IncrementalSemanticSnapshot = incremental_collect_function_facts(file, source, 95, tokens, "/codec/control.elisa", 17, 29, options_key, previous, false)
                encoded: mutable IncrementalSnapshotEncodeResult = incremental_encode_snapshot(snapshot)
                assert encoded.valid
                assert snapshot.functions.count == 2
                assert snapshot.direct_facts.count >= 2
                assert snapshot.active_grants.count >= 1
                legacy: IncrementalSnapshotEncodeResult = legacy_encode_snapshot(snapshot)
                assert legacy.valid
                assert legacy.bytes[8] == 1
                legacy_decoded: IncrementalSnapshotDecodeResult = incremental_decode_snapshot(legacy.bytes, 17, 29, options_key)
                assert not legacy_decoded.valid
                # Fixed wire bytes independently guard little-endian word emission.
                assert encoded.bytes[0] == 73
                assert encoded.bytes[1] == 67
                assert encoded.bytes[2] == 28
                assert encoded.bytes[3] == 198
                assert encoded.bytes[4] == 60
                assert encoded.bytes[5] == 81
                assert encoded.bytes[6] == 79
                assert encoded.bytes[7] == 80
                assert encoded.bytes[8] == 2
                for key_index in 0..<options_key.count:
                    assert encoded.bytes[112 + key_index] == options_key[key_index]
                assert encoded.bytes.count == 146 + snapshot.bytes.count + snapshot.functions.count * 72 + snapshot.direct_facts.count * 56 + snapshot.active_grants.count * 24
                decoded: IncrementalSnapshotDecodeResult = incremental_decode_snapshot(encoded.bytes, 17, 29, options_key)
                assert decoded.valid
                assert incremental_semantic_options_key_equal(decoded.snapshot.options_key, options_key)
                # Rehydrated records must be usable without persisted AST anchors.
                warm: IncrementalSemanticSnapshot = incremental_collect_function_facts(file, source, 95, tokens, "/codec/control.elisa", 17, 29, options_key, decoded.snapshot, true)
                assert warm.bodies_matched == 2
                assert warm.bodies_visited == 2
                assert warm.direct_facts.count == snapshot.direct_facts.count
                assert warm.active_grants.count == snapshot.active_grants.count
                warm_encoded: IncrementalSnapshotEncodeResult = incremental_encode_snapshot(warm)
                assert warm_encoded.valid and warm_encoded.bytes.count == encoded.bytes.count
                for warm_index in 0..<encoded.bytes.count:
                    assert warm_encoded.bytes[warm_index] == encoded.bytes[warm_index]
                repeated: IncrementalSnapshotEncodeResult = incremental_encode_snapshot(decoded.snapshot)
                assert repeated.valid and repeated.bytes.count == encoded.bytes.count
                for index in 0..<encoded.bytes.count:
                    assert repeated.bytes[index] == encoded.bytes[index]
                edited_source: static u8& = "def leaf() -> i64:\n    return 8\ndef value() -> i64:\n    can Global.Read:\n        return leaf()\n"
                edited_tokens: darray[Lexer::Token] = frontend_tokenize_with_length(edited_source, edited_source, 95)
                edited_file: Ast::File = frontend_parser_parse_file(edited_source, edited_tokens) can Global{Read,Write}
                assert edited_file.errors.count == 0
                edited: IncrementalSemanticSnapshot = incremental_collect_function_facts(edited_file, edited_source, 95, edited_tokens, "/codec/control.elisa", 17, 29, options_key, decoded.snapshot, true)
                assert edited.bodies_matched == 1 and edited.bodies_visited == 2
                edited_cold: IncrementalSemanticSnapshot = incremental_collect_function_facts(edited_file, edited_source, 95, edited_tokens, "/codec/control.elisa", 17, 29, options_key, previous, false)
                edited_encoded: IncrementalSnapshotEncodeResult = incremental_encode_snapshot(edited)
                edited_cold_encoded: IncrementalSnapshotEncodeResult = incremental_encode_snapshot(edited_cold)
                assert edited_encoded.valid and edited_cold_encoded.valid
                assert edited_encoded.bytes.count == edited_cold_encoded.bytes.count
                for edited_index in 0..<edited_encoded.bytes.count:
                    assert edited_encoded.bytes[edited_index] == edited_cold_encoded.bytes[edited_index]
                # Keep the fingerprint identical: only exact key comparison can reject this reuse.
                changed_options: IncrementalSemanticSnapshot = incremental_collect_function_facts(file, source, 95, tokens, "/codec/control.elisa", 17, 29, changed_options_key, decoded.snapshot, true)
                assert not changed_options.surface_compatible
                assert changed_options.bodies_matched == 0 and changed_options.bodies_visited == 2
                # Equal bodies do not bypass declaration-surface invalidation.
                signature_source: static u8& = "def leaf() -> i32:\n    return 7\ndef value() -> i64:\n    can Global.Read:\n        return leaf()\n"
                signature_tokens: darray[Lexer::Token] = frontend_tokenize_with_length(signature_source, signature_source, 95)
                signature_file: Ast::File = frontend_parser_parse_file(signature_source, signature_tokens) can Global{Read,Write}
                assert signature_file.errors.count == 0
                signature_snapshot: IncrementalSemanticSnapshot = incremental_collect_function_facts(signature_file, signature_source, 95, signature_tokens, "/codec/control.elisa", 17, 29, options_key, decoded.snapshot, true)
                assert not signature_snapshot.surface_compatible
                assert signature_snapshot.bodies_matched == 0 and signature_snapshot.bodies_visited == 2
                reordered_source: static u8& = "def value() -> i64:\n    can Global.Read:\n        return leaf()\ndef leaf() -> i64:\n    return 7\n"
                reordered_tokens: darray[Lexer::Token] = frontend_tokenize_with_length(reordered_source, reordered_source, 95)
                reordered_file: Ast::File = frontend_parser_parse_file(reordered_source, reordered_tokens) can Global{Read,Write}
                assert reordered_file.errors.count == 0
                reordered_snapshot: IncrementalSemanticSnapshot = incremental_collect_function_facts(reordered_file, reordered_source, 95, reordered_tokens, "/codec/control.elisa", 17, 29, options_key, decoded.snapshot, true)
                assert not reordered_snapshot.surface_compatible
                assert reordered_snapshot.bodies_matched == 0 and reordered_snapshot.bodies_visited == 2
                wrong_semantic: IncrementalSnapshotDecodeResult = incremental_decode_snapshot(encoded.bytes, 18, 29, options_key)
                wrong_fingerprint: IncrementalSnapshotDecodeResult = incremental_decode_snapshot(encoded.bytes, 17, 30, options_key)
                # Force an equal prefilter while the expected exact key differs.
                wrong_colliding_options: IncrementalSnapshotDecodeResult = incremental_decode_snapshot(encoded.bytes, 17, 29, changed_options_key)
                assert not wrong_semantic.valid and not wrong_fingerprint.valid and not wrong_colliding_options.valid
                # Every boolean participates even if the fingerprint collides.
                for flag_index in 5..<18:
                    differing_key: mutable darray[u8] = []
                    differing_key.extend(options_key)
                    differing_key[flag_index] <- 1
                    assert incremental_semantic_options_key_valid(differing_key)
                    differing_result: IncrementalSnapshotDecodeResult = incremental_decode_snapshot(encoded.bytes, 17, 29, differing_key)
                    assert not differing_result.valid
                truncated: mutable darray[u8] = []
                truncated.extend(encoded.bytes)
                truncated <- truncated.truncate(truncated.count - 1)
                short_result: IncrementalSnapshotDecodeResult = incremental_decode_snapshot(truncated, 17, 29, options_key)
                assert not short_result.valid
                encoded.bytes[0] <- encoded.bytes[0] ^ 1
                corrupt: IncrementalSnapshotDecodeResult = incremental_decode_snapshot(encoded.bytes, 17, 29, options_key)
                assert not corrupt.valid
                return 0

def main() -> i64:
    return Semantic::incremental_codec_integrity_control() can Memory.Allocate, Abort.Panic, Global{Read,Write}
