include "../../src/parser/parser.elisa"
using Ast
using Bytes

# The portable codec depends on parsed AST and owned fact records, not checker passes.
module Semantic:
    public:
        const CODEC_CONTROL_CONTEXT: u32 = 1

include "../../src/semantic/incremental_function_facts.elisa"
include "../../src/semantic/incremental_snapshot_codec.elisa"
include "./incremental_codec_legacy_encoder.elisa"

extend Semantic:
    public:
        def incremental_codec_integrity_control() -> i64:
            can Memory.Allocate, Abort.Panic:
                source: static u8& = "def leaf() -> i64:\n    return 7\ndef value() -> i64:\n    can Global.Read:\n        return leaf()\n"
                tokens: darray[Lexer::Token] = frontend_tokenize_with_length(source, source, 95)
                file: Ast::File = frontend_parser_parse_file(source, tokens) can Global{Read,Write}
                assert file.errors.count == 0
                previous: IncrementalSemanticSnapshot = isc_empty()
                snapshot: IncrementalSemanticSnapshot = incremental_collect_function_facts(file, source, 95, tokens, "/codec/control.elisa", 17, 29, previous, false)
                encoded: mutable IncrementalSnapshotEncodeResult = incremental_encode_snapshot(snapshot)
                assert encoded.valid
                assert snapshot.functions.count == 2
                assert snapshot.direct_facts.count >= 2
                assert snapshot.active_grants.count >= 1
                legacy: IncrementalSnapshotEncodeResult = legacy_encode_snapshot(snapshot)
                assert legacy.valid and legacy.bytes.count == encoded.bytes.count
                for byte_index in 0..<encoded.bytes.count:
                    assert legacy.bytes[byte_index] == encoded.bytes[byte_index]
                # Fixed wire bytes independently guard little-endian word emission.
                assert encoded.bytes[0] == 73
                assert encoded.bytes[1] == 67
                assert encoded.bytes[2] == 28
                assert encoded.bytes[3] == 198
                assert encoded.bytes[4] == 60
                assert encoded.bytes[5] == 81
                assert encoded.bytes[6] == 79
                assert encoded.bytes[7] == 80
                assert encoded.bytes.count == 120 + snapshot.bytes.count + snapshot.functions.count * 72 + snapshot.direct_facts.count * 56 + snapshot.active_grants.count * 24
                decoded: IncrementalSnapshotDecodeResult = incremental_decode_snapshot(encoded.bytes, 17, 29)
                assert decoded.valid
                # Rehydrated records must be usable without persisted AST anchors.
                warm: IncrementalSemanticSnapshot = incremental_collect_function_facts(file, source, 95, tokens, "/codec/control.elisa", 17, 29, decoded.snapshot, true)
                assert warm.bodies_reused == 2
                assert warm.bodies_visited == 0
                assert warm.direct_facts.count == snapshot.direct_facts.count
                assert warm.active_grants.count == snapshot.active_grants.count
                warm_encoded: IncrementalSnapshotEncodeResult = incremental_encode_snapshot(warm)
                assert warm_encoded.valid and warm_encoded.bytes.count == encoded.bytes.count
                for warm_index in 0..<encoded.bytes.count:
                    assert warm_encoded.bytes[warm_index] == encoded.bytes[warm_index]
                repeated: IncrementalSnapshotEncodeResult = incremental_encode_snapshot(decoded.snapshot)
                assert repeated.valid and repeated.bytes.count == encoded.bytes.count
                for index in 0..<encoded.bytes.count:
                    assert repeated.bytes[index] == encoded.bytes[index]
                edited_source: static u8& = "def leaf() -> i64:\n    return 8\ndef value() -> i64:\n    can Global.Read:\n        return leaf()\n"
                edited_tokens: darray[Lexer::Token] = frontend_tokenize_with_length(edited_source, edited_source, 95)
                edited_file: Ast::File = frontend_parser_parse_file(edited_source, edited_tokens) can Global{Read,Write}
                assert edited_file.errors.count == 0
                edited: IncrementalSemanticSnapshot = incremental_collect_function_facts(edited_file, edited_source, 95, edited_tokens, "/codec/control.elisa", 17, 29, decoded.snapshot, true)
                assert edited.bodies_reused == 1 and edited.bodies_visited == 1
                edited_cold: IncrementalSemanticSnapshot = incremental_collect_function_facts(edited_file, edited_source, 95, edited_tokens, "/codec/control.elisa", 17, 29, previous, false)
                edited_encoded: IncrementalSnapshotEncodeResult = incremental_encode_snapshot(edited)
                edited_cold_encoded: IncrementalSnapshotEncodeResult = incremental_encode_snapshot(edited_cold)
                assert edited_encoded.valid and edited_cold_encoded.valid
                assert edited_encoded.bytes.count == edited_cold_encoded.bytes.count
                for edited_index in 0..<edited_encoded.bytes.count:
                    assert edited_encoded.bytes[edited_index] == edited_cold_encoded.bytes[edited_index]
                changed_options: IncrementalSemanticSnapshot = incremental_collect_function_facts(file, source, 95, tokens, "/codec/control.elisa", 17, 30, decoded.snapshot, true)
                assert changed_options.bodies_reused == 0 and changed_options.bodies_visited == 2
                wrong_semantic: IncrementalSnapshotDecodeResult = incremental_decode_snapshot(encoded.bytes, 18, 29)
                wrong_options: IncrementalSnapshotDecodeResult = incremental_decode_snapshot(encoded.bytes, 17, 30)
                assert not wrong_semantic.valid and not wrong_options.valid
                truncated: mutable darray[u8] = []
                truncated.extend(encoded.bytes)
                truncated <- truncated.truncate(truncated.count - 1)
                short_result: IncrementalSnapshotDecodeResult = incremental_decode_snapshot(truncated, 17, 29)
                assert not short_result.valid
                encoded.bytes[0] <- encoded.bytes[0] ^ 1
                corrupt: IncrementalSnapshotDecodeResult = incremental_decode_snapshot(encoded.bytes, 17, 29)
                assert not corrupt.valid
                return 0

def main() -> i64:
    return Semantic::incremental_codec_integrity_control() can Memory.Allocate, Abort.Panic, Global{Read,Write}
