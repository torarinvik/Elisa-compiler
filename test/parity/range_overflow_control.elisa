def ascending_min_stride() -> i64:
    low: i8 = -128
    high: i8 = 1
    stride: i8 = -128
    total: mutable i64 = 0
    for value in low ..< high .. stride:
        total <- total + value.i64()
    return 0 if total == -128 else 1

def descending_min_stride() -> i64:
    low: i8 = 127
    high: i8 = -2
    stride: i8 = -128
    total: mutable i64 = 0
    for value in low ..> high .. stride:
        total <- total + value.i64()
    return 0 if total == 126 else 1

def ordinary_step_overflow() -> i64:
    low: i8 = 126
    high: i8 = 127
    stride: i8 = 4
    total: mutable i64 = 0
    for value in low ..< high .. stride:
        total <- total + value.i64()
    return 0 if total == 126 else 1

def main() -> i64:
    return ascending_min_stride() + descending_min_stride() + ordinary_step_overflow()
