# Preserve byte values, bounds, content equality, and bulk-copy behavior.
def main() -> i64:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        storage: mutable u8[256]
        for index in 0..<256 |storage|:
            storage[index] <- index.u8()
        text: sview = unsafe_sview_bounded_bytes(&storage[0], 256)
        for index in 0..<256:
            assert text[index] == sview_at(text, index).i64()
            byte: u8 = text[index]
            assert byte == index.u8()
        assert text[256] == 0 and text[-1] == 0
        assert sview_at(text, 256) == 0
        duplicate: sview = unsafe_sview_bounded_bytes(&storage[0], 256)
        assert (text == duplicate) == sview_eq(text, duplicate)
        shorter: sview = unsafe_sview_bounded_bytes(&storage[0], 255)
        assert not (text == shorter)
        assert (text == shorter) == sview_eq(text, shorter)
        copied: mutable darray[u8] = []
        for index in 0..<sview_len(text) |copied|:
            copied.push(text[index])
        assert copied.count == 256
        for index in 0..<256:
            assert copied[index] == index.u8()
    return 0
