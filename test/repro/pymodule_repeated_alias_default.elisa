module RepeatAlias:
    module Target:
        public:
            const enum Mode of i64:
                High = 94
    using Target as Alias
    using Target as Alias
    using Target as First
    using First as ChainedAlias
    using Target as ChainedAlias
    def repeated_alias_default(value: i64 = Alias::Mode.High) -> i64:
        return value
    def canonical_alias_default(value: i64 = ChainedAlias::Mode.High) -> i64:
        return value
