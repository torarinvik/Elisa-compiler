# A `raise` in a function whose error-union PAYLOAD is narrower than a word. The callee
# writes a zero payload through its out-param on the error path; stage1 stored an `i64 0`
# regardless of the payload type, i.e. an 8-byte write into the caller's one-byte
# `call.error.out` slot for a `bool error[E]` callee (`i8` for u8, 4 bytes for i32). The
# stack smash happened to be harmless on macOS and segfaulted on Linux (adversarial
# try_operand_short_circuit / try_as_binary_operand, exit -11). stage0 stores a zero OF THE
# PAYLOAD TYPE. Every raise path below is exercised; stage0 exits 92.
error DiskError:
    Missing

def flag(v: i64) -> bool error[DiskError]:
    if v == 0:
        raise DiskError.Missing
    return v > 1

def small(v: i64) -> u8 error[DiskError]:
    if v == 0:
        raise DiskError.Missing
    return 7

def narrow(v: i64) -> i32 error[DiskError]:
    if v == 0:
        raise DiskError.Missing
    return 9

def nothing(v: i64) -> void error[DiskError]:
    if v == 0:
        raise DiskError.Missing

def probe_flag(v: i64) -> i64:
    ok: bool = try flag(v) else return 3
    return 7 if ok else 5

def probe_small(v: i64) -> i64:
    s: u8 = try small(v) else return 3
    return s.i64()

def probe_narrow(v: i64) -> i64:
    n: i32 = try narrow(v) else return 3
    return n.i64()

def probe_nothing(v: i64) -> i64:
    try nothing(v) else return 3
    return 11

def main() -> i64:
    total: mutable i64 = 0
    total <- total + probe_flag(0) + probe_flag(5)
    total <- total + probe_small(0) + probe_small(5)
    total <- total + probe_narrow(0) + probe_narrow(5)
    total <- total + probe_nothing(0) + probe_nothing(5)
    return total * 2
