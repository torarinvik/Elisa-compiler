struct Box[K, T]:
    key: K
    value: mutable T
    capacity: mutable usize

def read[K, T](b: Box[K, T]&) -> usize:
    return b.capacity

def write[K, T](b: mutable Box[K, T]&, n: usize) -> void:
    b.capacity <- n

def main(b: mutable Box[i64, i64]&) -> usize:
    write(b, 2)
    return read(b)
