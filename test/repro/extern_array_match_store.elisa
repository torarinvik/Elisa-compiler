const enum Kind of i32:
    block = 1
    none = 2

struct Objstruct:
    flags: mutable u32

struct Info:
    c_type: mutable Kind

struct Stat:
    visspot: mutable u8&?
    flags: mutable u32

@link_name("actorat")
extern actorat: mutable array[array[mutable Objstruct&?, 64], 64]
@link_name("spotvis")
extern spotvis: mutable array[array[u8, 64], 64]
global mutable statinfo: array[Info, 2] = zeroed
global mutable laststatobj: Stat&? = zeroed

def elisa_nonnull[T](value: mutable T&?) -> mutable T&:
    if value == null:
        return zeroed
    return value

def actor_store(c_type: i32, x: i32, y: i32) -> void:
    elisa_nonnull(laststatobj).visspot <- &spotvis[x][y]
    match statinfo[c_type].c_type:
        Kind.block:
            actorat[x][y] <- (64).cast[mutable Objstruct&?]
        _:
            pass

def main() -> i64:
    actor_store(0, 0, 0)
    return 0
