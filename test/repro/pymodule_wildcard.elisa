# Opt-in wildcard exports keep small Python modules concise while retaining explicit rows for
# curated APIs. Only top-level functions and constants are included.
def add(a: i64, b: i64) -> i64:
    return a + b

def greet(name: sview) -> sview:
    return name

const API_LEVEL: i64 = 3

export pymodule wildcard:
    fn *
    const *
