# A subscript at the end of a value `if`'s condition: the `else` belongs to the conditional.
def pick(values: view[f64], bound: f64) -> f64 can[Abort.Panic]:
    chosen: mutable f64 = 0.0
    chosen <- 1.0 if bound > values[1] else 2.0
    return chosen

def widen(values: mutable view[f64], other: view[f64]) -> i64 can[Abort.Panic]:
    values[0] <- other[0] if other[0] > values[0] else values[0]
    return 0

def main() -> i64:
    numbers: darray[f64] = [4.0, 3.0]
    wider: darray[f64] = [5.0]
    target: mutable darray[f64] = [1.0]
    _ = widen(target[0:1], wider[0:1])
    return 0 if pick(numbers[0:2], 3.5) == 1.0 and pick(numbers[0:2], 2.5) == 2.0 and target[0] == 5.0 else 1
