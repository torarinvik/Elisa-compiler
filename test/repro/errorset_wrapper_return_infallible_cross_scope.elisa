# The bool overload activates Core's free-call receiver-overload rewrite gate.
# Concrete imported choose(i64) outranks the local generic poly wrapper by argument
# zero. EWR must use that selected overload and avoid propagating Fault.
module Provider:
    public:
        error Fault:
            Failed

        def origin() -> i64 error[Provider::Fault]:
            raise Provider::Fault.Failed

        def choose[errorset S](value: i64, callback: fn() -> i64 error[S]) -> i64:
            return value

        def choose[errorset S](value: bool, callback: fn() -> i64 error[S]) -> i64:
            return 3

from Provider import choose

module Consumer:
    public:
        error Expected:
            Rejected

        def choose[T, errorset R](value: T, callback: fn() -> i64 error[R]) -> i64 error[R]:
            return try callback()

        def dispatch_prefers_concrete_infallible(value: i64) -> i64 error[Consumer::Expected]:
            return choose(value, Provider::origin)

def main() -> i64:
    return 0
