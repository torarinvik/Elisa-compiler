include "../../elisacore_std/elisacore_runtime.elisa"

error FooError:
    Bad1
    Bad2
error BarError:
    Bad3
    Bad4(n: u32)

def foo() -> i64 error[FooError{Bad1}, BarError{Bad3, Bad4}]:
    raise BarError.Bad4(42)

def use_statement_catch() -> i64:
    catch foo():
        value:
            return value
        FooError.Bad1:
            return 1
        BarError.Bad3:
            return 3
        BarError.Bad4(payload):
            return payload.i64()
    return 0

def use_expression_catch() -> i64:
    return catch foo():
        value: value
        FooError.Bad1: 1
        BarError.Bad3: 3
        BarError.Bad4(payload): payload.i64()

def main() -> i64:
    if use_statement_catch() != 42:
        return 1
    if use_expression_catch() != 42:
        return 1
    return 0
