# The same permission leaf in different modules denotes distinct authorities.
module A:
    public:
        permission Cap:
            Read
        extern read() -> void can[Cap.Read]

module B:
    public:
        permission Cap:
            Read
        extern read() -> void can[Cap.Read]

def probe() -> void:
    good_a: fn() -> void can[A::Cap] = fn() => A::read()
    bad_a: fn() -> void can[B::Cap] = fn() => A::read()
    good_b: fn() -> void can[B::Cap] = fn() => B::read()
    bad_b: fn() -> void can[A::Cap] = fn() => B::read()
