# Aggregate constants must fold postfix numeric casts and integer bitwise/shift operators.
const MASKS: u32[4] = [
    1.u32() << 1,
    1.u32() << 2 | 1.u32(),
    1.u32() << 9,
    255.u32() & 15.u32()
]

def get_mask(index: u32) -> u32:
    return MASKS[index.usize()]

def has_bit(mask: u32, bit: u32) -> i32:
    return 1 if (mask & (1.u32() << bit)) != 0 else 0

export fn const_bitwise_get_mask(index: u32) -> u32 = get_mask
export fn const_bitwise_has_bit(mask: u32, bit: u32) -> i32 = has_bit
