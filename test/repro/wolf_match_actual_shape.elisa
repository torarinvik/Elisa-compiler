const enum Wl_stat_t of i32:
    block = 1
    none = 2
    bo_cross = 3
    bo_chalice = 4
    bo_bible = 5
    bo_crown = 6
    bo_fullheal = 7
    bo_firstaid = 8
    bo_key1 = 9
    bo_key2 = 10
    bo_clip = 11
    bo_machinegun = 12
    bo_chaingun = 13
    bo_food = 14
    bo_alpo = 15
    bo_gibs = 16
    bo_spear = 17

struct Statstruct:
    tilex: mutable u8
    tiley: mutable u8
    shapenum: mutable i16
    visspot: mutable u8&?
    flags: mutable u32
    itemnumber: mutable u8

struct Info:
    picnum: mutable i16
    c_type: mutable Wl_stat_t
    specialFlags: mutable u32

struct Objstruct:
    flags: mutable u32

global mutable laststatobj: Statstruct&? = zeroed
global mutable statinfo: array[Info, 50] = zeroed
global mutable spotvis: array[array[u8, 64], 64] = zeroed
global mutable actorat: array[array[mutable Objstruct&?, 64], 64] = zeroed

def elisa_nonnull[T](value: mutable T&?) -> mutable T&:
    if value == null:
        return zeroed
    return value

def SpawnStatic(tilex: i32, tiley: i32, c_type: i32) -> void:
    trusted Unsafe.StaleRef:
        elisa_nonnull(laststatobj).shapenum <- statinfo[c_type].picnum
    trusted Unsafe.StaleRef:
        elisa_nonnull(laststatobj).tilex <- tilex
    trusted Unsafe.StaleRef:
        elisa_nonnull(laststatobj).tiley <- tiley
    trusted Unsafe.StaleRef:
        elisa_nonnull(laststatobj).visspot <- &spotvis[tilex][tiley]
    trusted Unsafe.StaleRef:
        match statinfo[c_type].c_type:
            Wl_stat_t.block:
                actorat[tilex][tiley] <- (64).cast[mutable Objstruct&?]
                elisa_nonnull(laststatobj).flags <- 0
            Wl_stat_t.none:
                elisa_nonnull(laststatobj).flags <- 0
            Wl_stat_t.bo_cross | Wl_stat_t.bo_chalice | Wl_stat_t.bo_bible | Wl_stat_t.bo_crown | Wl_stat_t.bo_fullheal:
                elisa_nonnull(laststatobj).flags <- 0
            Wl_stat_t.bo_firstaid | Wl_stat_t.bo_key1 | Wl_stat_t.bo_key2 | Wl_stat_t.bo_clip | Wl_stat_t.bo_machinegun | Wl_stat_t.bo_chaingun | Wl_stat_t.bo_food | Wl_stat_t.bo_alpo | Wl_stat_t.bo_gibs | Wl_stat_t.bo_spear:
                elisa_nonnull(laststatobj).flags <- 0
            _:
                pass
    trusted Unsafe.StaleRef:
        elisa_nonnull(laststatobj).flags <- 0

def actor_store(tilex: i32, tiley: i32) -> void:
    trusted Unsafe.StaleRef:
        actorat[tilex][tiley] <- (64).cast[mutable Objstruct&?]

def main() -> i64:
    SpawnStatic(0, 0, 0)
    return 0
