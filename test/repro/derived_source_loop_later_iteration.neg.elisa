struct Player[state Alive | Dead]:
    health: mutable i64
    tag: i64
    derive state:
        Alive when self.health > 0
        Dead when self.health <= 0

def invalid_later_iteration(player: mutable Player[Alive], again: bool) -> Player[Dead]:
    while again:
        copy: Player[Alive] = player{tag = 1}
        player.health <- 0
    return player{health = 0}
