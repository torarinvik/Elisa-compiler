# Error-returning Python boundary fixture.
error DivideError:
    Zero

def checked_divide(value: i64, divisor: i64) -> i64 error[DivideError]:
    raise DivideError.Zero if divisor == 0
    return value / divisor

def checked_flag(flag: bool) -> bool error[DivideError]:
    raise DivideError.Zero if not flag
    return flag

def checked_float(value: f64) -> f64 error[DivideError]:
    return value

def checked_unsigned(value: u64) -> u64 error[DivideError]:
    return value

def checked_text(text: sview) -> sview error[DivideError]:
    return text

def rejected_text(text: sview) -> sview error[DivideError]:
    raise DivideError.Zero

def checked_object(value: py::Object) -> py::Object error[DivideError]:
    return value

def checked_dict(values: dict[i64, i64]) -> i64 error[DivideError]:
    raise DivideError.Zero if values.count == 0.usize()
    return values.count.i64()

def checked_view(values: view[i64]) -> view[i64] error[DivideError]:
    raise DivideError.Zero if values.len == 0.usize()
    return values

def checked_list(values: darray[i64]) -> i64 error[DivideError]:
    raise DivideError.Zero if values.count == 0.usize()
    return values[0.usize()]

error ListError:
    Empty

error ListPayloadError:
    Empty(count: i64)

error DictResultError:
    Empty

error DictResultPayloadError:
    Empty(count: i64)

def checked_list_result(values: darray[i64]) -> darray[i64] error[ListError]:
    raise ListError.Empty if values.count == 0.usize()
    return values

def checked_list_payload(values: darray[i64]) -> darray[i64] error[ListPayloadError]:
    raise ListPayloadError.Empty(values.count.i64()) if values.count == 0.usize()
    return values

def checked_bytes_result(values: darray[u8]) -> darray[u8] error[ListError]:
    raise ListError.Empty if values.count == 0.usize()
    return values

def checked_dict_list(values: dict[i64, i64], items: darray[i64]) -> darray[i64] error[ListError]:
    raise ListError.Empty if values.count == 0.usize()
    return items

def checked_dict_result(values: dict[i64, i64]) -> dict[i64, i64] error[DictResultError]:
    raise DictResultError.Empty if values.count == 0.usize()
    return values

def checked_dict_payload(values: dict[i64, i64]) -> dict[i64, i64] error[DictResultPayloadError]:
    raise DictResultPayloadError.Empty(values.count.i64()) if values.count == 0.usize()
    return values

def ping() -> void error[DivideError]:
    return

export pymodule errors:
    fn divide = checked_divide
    fn flag = checked_flag
    fn float = checked_float
    fn unsigned = checked_unsigned
    fn text = checked_text
    fn rejected_text
    fn object = checked_object
    fn checked_dict
    fn checked_view
    fn checked_list
    fn checked_list_result
    fn checked_list_payload
    fn checked_bytes_result
    fn checked_dict_list
    fn checked_dict_result
    fn checked_dict_payload
    fn ping
