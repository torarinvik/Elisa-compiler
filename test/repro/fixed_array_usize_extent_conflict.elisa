# Repeated uses of one inferred extent must agree; the backend must refuse this call.
def same_extent[N: usize](first: u8[N]&, second: u8[N]&) -> i64:
    first[0].i64() + second[0].i64()

def main() -> i64:
    short: mutable u8[3] = [41, 0, 0]
    wide: mutable u8[4] = [73, 0, 0, 0]
    same_extent(short, wide)
