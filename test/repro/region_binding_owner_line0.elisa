# Distinct region-parameter binders that share #line 0 must keep declaration identity.
# The semantic atom checks that their same-spelled region selectors resolve to separate IDs.
#line 0 first_region_owner.elisa
def first_region_owner[@r](value: i64& @r) -> i64& @r:
    return value

#line 0 second_region_owner.elisa
def second_region_owner[@r](value: i64& @r) -> i64& @r:
    return value
