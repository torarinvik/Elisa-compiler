# An enum variant whose payload is a STRUCT.
#
# The tagged union is `{ i32 tag, [N x i64] blob }` and N is NOT the variant's field count —
# it is `ceil(sizeof(payload) / 8)` over stage0's C layout, measured from stage0's own
# `-emit llvm`:
#
#   Wrap(i: struct{i64, i64})  ->  [2 x i64]        Wrap(i: struct{u8, u8})  ->  [1 x i64]
#
# so the two rules coincide only when every field is a full word. stage1 registered a
# payload enum only when every payload was a SCALAR, which made an aggregate payload
# unrepresentable: declaring a local of that type declined, and a function taking one was
# dropped at the DECLARE pass, before any body.
#
# Registration cannot size a struct payload — it runs before struct bodies are filled, since
# a struct field may name a payload enum — so the extent is corrected in a later pass. Both
# the wide and the NARROW case are here: a `{u8, u8}` payload proves the extent is computed
# from the C layout and not from the field count, which would over-allocate it to 2 words.
#
# stage0 answers 219.
struct Wide:
    v: i64
    w: i64

struct Narrow:
    a: u8
    b: u8

enum Shape:
    Big(p: Wide)
    Small(p: Narrow)
    Empty

# A struct-payload enum as a PARAMETER — the shape that was dropped at the declare pass, so
# a decline here takes main with it rather than just this function.
def score_of(shape: Shape) -> i64:
    match shape:
        Shape.Big(p):
            return p.v * 10 + p.w
        Shape.Small(p):
            return p.a.i64() * 10 + p.b.i64()
        Shape.Empty:
            return 7
    return 0


def main() -> i64:
    # 34 + 78 + 7 = 119 through the parameter, and the same three through a LOCAL — the two
    # positions failed separately (dropped signature vs declined VarDecl).
    total: mutable i64 = score_of(Shape.Big(Wide{v: 3, w: 4})) + score_of(Shape.Small(Narrow{a: 7, b: 8})) + score_of(Shape.Empty)
    local: Shape = Shape.Big(Wide{v: 5, w: 0})
    match local:
        Shape.Big(p):
            total <- total + p.v * 20
        Shape.Small(p):
            total <- total + 1000
        Shape.Empty:
            total <- total + 2000
    return total
