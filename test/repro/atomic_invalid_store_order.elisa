struct atomic[T]:
    value: mutable T

enum MemoryOrder:
    Relaxed
    Acquire
    Release
    AcqRel
    SeqCst

extern store(slot: mutable atomic[i64]&, value: i64, order: MemoryOrder)

def main() -> i64:
    slot: mutable atomic[i64] = atomic[i64]{value: 0}
    store(&slot, 1, MemoryOrder.Acquire)
    return 0
