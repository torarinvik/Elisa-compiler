# The two functions intentionally reuse logical line zero. Allocation ownership must
# follow the `new` token offset, not whichever allocation row shares the logical line.
#line 0 first_allocation_owner.elisa
def identity(value: i64&) -> i64&:
    return value

def first_allocation_owner() -> i64&:
    region first(64):
        return identity(new[first] 7)

#line 0 second_allocation_owner.elisa
def second_allocation_owner() -> i64&:
    region second(64):
        return identity(new[second] 9)
