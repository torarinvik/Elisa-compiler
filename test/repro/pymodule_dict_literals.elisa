# Python dictionary-return fixture using the same arena-backed insertion shape as the
# standard collection helpers. Keeping the fixture self-contained avoids linking the full
# standard-library runtime twice into a CPython extension.
extern arena_alloc(a: mutable void&, size_bytes: usize) -> mutable void&

struct DictBucket[K, T]:
    key: mutable K
    value: mutable T
    state: mutable u8

struct DynDict[K, T]:
    items: mutable DictBucket[K, T]&?
    count: usize
    used: usize
    capacity: usize
    arena: mutable i64

def dict_items_from_alloc[K, T](raw: mutable void&) -> mutable DictBucket[K, T]&:
    trusted Unsafe.PointerCast:
        return raw.cast[mutable DictBucket[K, T]&]

def arena_dict_put_or_panic[K, T](a: mutable void&, m: mutable dict[K, T]&, key: K, value: T) -> T&?:
    can Memory.Allocate, Abort.Panic:
        if m.items == null:
            items: mutable DictBucket[K, T]& = dict_items_from_alloc[K, T](arena_alloc(a, 8.usize() * size_of(DictBucket[K, T])))
            m.items as & <- items
            m.capacity <- 8
            for index in 0..<m.capacity |items|:
                items[index].state <- 0
        items: mutable DictBucket[K, T]& = m.items
        mask: usize = m.capacity - 1
        slot: mutable usize = ctx_hash_value(key).usize() & mask
        while items[slot].state == 1:
            slot <- (slot + 1) & mask
        items[slot].key <- key
        items[slot].value <- value
        items[slot].state <- 1
        m.count <- m.count + 1
        m.used <- m.used + 1
        return &items[slot].value

def literal_i64() -> dict[i64, i64]:
    return {1: 40, 2: 2}

def comprehension_i64() -> dict[i64, i64]:
    return {key: key * 2 for key in 1..<4}

export pymodule dict_literals:
    fn literal_i64
    fn comprehension_i64
