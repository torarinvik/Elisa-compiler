# A known-inactive import must not choose the provider of a bare raised error family.
module InactiveProvider:
    public:
        error Fault:
            Bad

module ActiveProvider:
    public:
        error Fault:
            Bad

static if false:
    from InactiveProvider import Fault
static else:
    from ActiveProvider import Fault

def relay() -> void error[ActiveProvider::Fault]:
    raise Fault.Bad

def active_statement_raise() -> void:
    static if true:
        raise Fault.Bad

def inactive_statement_raise() -> void:
    static if false:
        raise Fault.Bad

static if false:
    def inactive_declaration_raise() -> void:
        raise Fault.Bad

def main() -> i64:
    return 0
