# A local generic singleton keeps Core's ordinary lexical precedence over one imported
# concrete singleton; the pair is not an overload set for the receiver-rewrite gate.
module Provider:
    public:
        error ProviderFault:
            Failed

        def choose(value: i64) -> i64 error[Provider::ProviderFault]:
            return 1

module Consumer:
    public:
        error LocalFault:
            Local

        def choose[T](value: T) -> i64 error[Consumer::LocalFault]:
            return 2

        def caller(value: i64) -> i64 error[Provider::ProviderFault]:
            return choose(value)

using Provider

def main() -> i64:
    return 0
