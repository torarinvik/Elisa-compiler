# nopath
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

enum Choice:
    First
    Second

def main() -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    region scratch(64):
        values: mutable darray[u8] @scratch = [65.u8(), 0.u8()]
        choose_first: Choice = Choice.First
        borrowed: sview =
            match choose_first:
                Choice.First:
                    sview(&values[0], 0, 1)
                Choice.Second:
                    sview(&values[0], 0, 1)
        destroy scratch
        return sview_at(borrowed, 0).i64()
