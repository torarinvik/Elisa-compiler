module HandleTypes:
    struct Slot:
        value: i64

    type SlotId = id[Slot]
    type NullableSlotId = SlotId?

def empty_handle() -> HandleTypes::NullableSlotId:
    handle: HandleTypes::NullableSlotId = zeroed
    return handle

def main() -> i64:
    return 42 if empty_handle() == null else 1
