# A fixed-array actual argument supplies the value for a declared usize extent.
def first_byte[N: usize](bytes: u8[N]&) -> i64:
    bytes[0].i64()

def main() -> i64:
    short: mutable u8[3] = [41, 0, 0]
    wide: mutable u8[65] = [73, 0, 0]
    first_byte(short) - 41 if first_byte(short) == 41 and first_byte(wide) == 73 else 1
