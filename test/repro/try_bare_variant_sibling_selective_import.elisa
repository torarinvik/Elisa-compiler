# Core's selective import aliases are program-wide, including across sibling modules.
# This must win over Fault.Expected's unique bare-variant interpretation.
error Fault:
    Expected

module Consumer:
    public:
        def origin() -> i64 error[Expected]:
            return 1

        def good_set_destination() -> i64 error[Expected]:
            return try origin()

        def wrong_variant_destination() -> i64 error[Fault]:
            return try origin()

module ImportSite:
    module SetProvider:
        public:
            error Expected:
                SetTag

    from SetProvider import Expected

def main() -> i64:
    return 0
