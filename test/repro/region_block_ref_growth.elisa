# Does growth of a CALLER-OWNED darray inside `region r(N):` come from the caller's
# arena (correct: the darray outlives the block) or from r (use-after-free)?
def fill(out: mutable darray[i64]&) -> void:
    region scratch(4096):
        tmp: mutable darray[i64] @scratch = []
        for i in 0..<200 |tmp|:
            tmp.push(i)
        for i in 0..<200 |out, tmp|:
            out.push(tmp[i.usize()] * 2)

def main() -> i64:
    values: mutable darray[i64] = []
    fill(values)
    total: mutable i64 = 0
    for v in values |total|:
        total <- total + v
    # sum 0..199 * 2 = 199*200 = 39800; mod 251 -> 39800 % 251 = 148
    return total % 251
