error RecoveryStoreFailure:
    Failed

def maybe() -> void error[RecoveryStoreFailure]:
    raise RecoveryStoreFailure.Failed

def consume(value: i64) -> void:
    pass

def good() -> i64:
    can Memory.Allocate, Abort.Panic:
        region outer(4096):
            outer_bytes: mutable darray[u8] @outer = [65.u8()]
            retained: mutable sview @outer = outer_bytes.as_sview()
            region inner(4096):
                inner_bytes: mutable darray[u8] @inner = [66.u8()]
                local: mutable sview = ""
                result: i64 = match true:
                    true:
                        try maybe() else err:
                            local <- inner_bytes.as_sview()
                            consume(panic())
                        0
                    _:
                        0
                retained <- local
                return retained.len
            return retained.len

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        return good()
