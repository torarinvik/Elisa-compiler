struct Player[state Alive | Dead]:
    health: i64
    tag: i64
    derive state:
        Alive when self.health > 0
        Dead when self.health <= 0

def kill(player: Player[Alive]) -> Player[Dead]:
    return player{health = 0}

def revive(player: Player[Dead]) -> Player[Alive]:
    return player{health = 7}

def retag(player: Player[Alive]) -> Player[Alive]:
    return player{tag = 2}

def main() -> i32:
    original: Player[Alive] = Player[Alive]{health: 10, tag: 1}
    dead: Player[Dead] = kill(original)
    alive: Player[Alive] = revive(dead)
    tagged: Player[Alive] = retag(original)
    return 1 if original.health != 10 or original.tag != 1
    return 2 if dead.health != 0 or dead.tag != 1
    return 3 if alive.health != 7 or alive.tag != 1
    return 4 if tagged.health != 10 or tagged.tag != 2
    return 0
