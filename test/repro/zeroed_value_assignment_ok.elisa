# Zero is a valid value at each of these places: a write through a reference parameter
# to a scalar referent, a scalar local, an optional field, and a generic field whose
# argument is a scalar.
struct Holder:
    s: mutable sview?

struct Box[T]:
    v: T

def set(p: mutable i64&) -> void:
    p <- zeroed

def main() -> i64:
    x: mutable i64 = 5
    set(&x)
    y: mutable i64 = 7
    y <- zeroed
    h: mutable Holder = Holder{s: zeroed}
    h.s <- zeroed
    b: Box[i64] = Box[i64]{v: zeroed}
    return x + y + b.v + 42
