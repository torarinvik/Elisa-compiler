module RuntimeSelection:
    def hook() -> void:
        pass

    def selected_runtime_branch() -> i64:
        static if ELISA_TARGET_OS_MACOS:
            hook()
        static elif ELISA_TARGET_OS_LINUX:
            static if ELISA_TARGET_ARCH_X86_64:
                hook()
            static elif ELISA_TARGET_ARCH_ARM64:
                hook()
            static else:
                hook()
        static else:
            hook()
        return 42

def main() -> i64:
    return RuntimeSelection::selected_runtime_branch()
