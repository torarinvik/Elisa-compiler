include "../../src/semantic/semantic.elisa"

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    source: u8& = "affine struct RootFile[state Closed | Open]:\n    handle: i64\ndef root_action() -> void:\n    pass\nmodule Owner:\n    affine struct File[state Closed | Open]:\n        handle: i64\n        transitions:\n            Closed -> Open\n    def arbitrary_operation_name() -> void:\n        pass\n    module Child:\n        def child_action() -> void:\n            pass\nmodule Owner::Child::Deep:\n    def deep_action() -> void:\n        pass\nmodule Owner::Secret:\n    affine struct File[state Closed | Open]:\n        handle: i64\nmodule Owner::Secret::Child:\n    def secret_action() -> void:\n        pass\nmodule OwnerKit:\n    def prefix_collision() -> void:\n        pass\nmodule Peer:\n    affine struct File[state Closed | Open]:\n        handle: i64\n        transitions:\n            Open -> Closed\n    def peer_action() -> void:\n        pass\n"
    tokens: darray[Lexer::Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    return 1 if file.errors.count != 0
    table: Semantic::SymbolTable = Semantic::collect_symbols(&file)
    return 2 if table.resolved_state_families.count != 4
    root: Semantic::DeclId = table.resolved_state_families[0].declaration_id
    owner: Semantic::DeclId = table.resolved_state_families[1].declaration_id
    secret: Semantic::DeclId = table.resolved_state_families[2].declaration_id
    peer: Semantic::DeclId = table.resolved_state_families[3].declaration_id
    callers: mutable usize = 0
    root_caller: mutable Semantic::DeclId = Semantic::DeclId{value: 4294967295}
    for symbol in table.symbols |callers, root_caller|:
        continue if symbol.kind != Semantic::SymbolKind.Func
        same_root: bool = symbol.module_owner == ""
        within_owner: bool = symbol.module_owner == "Owner" or symbol.module_owner == "Owner::Child" or symbol.module_owner == "Owner::Child::Deep" or symbol.module_owner == "Owner::Secret::Child"
        within_secret: bool = symbol.module_owner == "Owner::Secret::Child"
        within_peer: bool = symbol.module_owner == "Peer"
        return 3 if Semantic::protocol_function_has_authority(&table, root, symbol.id) != same_root
        return 4 if Semantic::protocol_function_has_authority(&table, owner, symbol.id) != within_owner
        return 5 if Semantic::protocol_function_has_authority(&table, secret, symbol.id) != within_secret
        return 6 if Semantic::protocol_function_has_authority(&table, peer, symbol.id) != within_peer
        root_caller <- symbol.id if same_root
        callers <- callers + 1
    return 7 if callers != 7 or root_caller.value == 4294967295
    return 8 if Semantic::protocol_function_has_authority(&table, owner, owner) or Semantic::protocol_function_has_authority(&table, owner, Semantic::DeclId{value: 4294967295})
    detached: Semantic::SymbolTable = table{symbols = []}
    return 9 if Semantic::protocol_function_has_authority(&detached, root, root_caller)
    corrupted: mutable Semantic::SymbolTable = table{symbols = [symbol for symbol in table.symbols]}
    original: Semantic::Symbol = corrupted.symbols[root_caller.value.usize()]
    corrupted.symbols[root_caller.value.usize()] <- original{id = owner}
    return 10 if Semantic::protocol_function_has_authority(&corrupted, root, root_caller)
    corrupted.symbols[root_caller.value.usize()] <- original{module_owner = "Owner::"}
    return 11 if Semantic::protocol_function_has_authority(&corrupted, owner, root_caller)
    both: darray[u32] = [0, 1]
    reversed: darray[u32] = [1, 0]
    empty: darray[u32] = []
    malformed: darray[u32] = [0, 4294967295]
    repeated: darray[u32] = [0, 0]
    return 12 if not Semantic::protocol_all_state_edges_allowed(&table, owner, &both, 1) or Semantic::protocol_all_state_edges_allowed(&table, owner, &both, 0)
    return 13 if not Semantic::protocol_all_state_edges_allowed(&table, peer, &both, 0) or Semantic::protocol_all_state_edges_allowed(&table, peer, &both, 1)
    return 14 if Semantic::protocol_all_state_edges_allowed(&table, owner, &reversed, 0) or Semantic::protocol_all_state_edges_allowed(&table, owner, &empty, 1) or Semantic::protocol_all_state_edges_allowed(&table, owner, &malformed, 1)
    return 15 if not Semantic::protocol_all_state_edges_allowed(&table, owner, &repeated, 1)
    return 0
