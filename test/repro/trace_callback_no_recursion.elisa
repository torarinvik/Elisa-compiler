# A custom callback is not the default runtime: preserve its body, but do not
# insert instrumentation into it. Main's entry must call it exactly once.
const TRACE_INITIAL_COUNT: i64 = 0
const TRACE_EXPECTED_COUNT: i64 = 1
const TRACE_SUCCESS_STATUS: i64 = 0
const TRACE_FAILURE_STATUS: i64 = 1
global mutable observed_entries: i64 = TRACE_INITIAL_COUNT

def elisa_trace_function_entry_id(name: cstr, line: u32, identity: u64) -> void:
    observed_entries <- observed_entries + TRACE_EXPECTED_COUNT

def main() -> i64:
    return TRACE_SUCCESS_STATUS if observed_entries == TRACE_EXPECTED_COUNT else TRACE_FAILURE_STATUS
