law NonNegative(self: i64):
    return self >= 0

struct RawPacket:
    value: i64

struct SafePacket:
    value: i64 is NonNegative

# The inner `packet` shadow is valid only inside the branch. After it closes,
# the return again refers to the unrefined by-value parameter and must be flagged.
def restore_after_shadow_scope(packet: RawPacket, safe: SafePacket) -> i64 is NonNegative:
    if true:
        packet: SafePacket = safe
    return packet.value
