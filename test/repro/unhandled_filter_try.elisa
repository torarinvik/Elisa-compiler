error UnhandledFilterFailure:
    Requested

const UNHANDLED_FILTER_VALUE: i64 = 42

module UnhandledFilter:
    private:
        def step() -> i64 error[UnhandledFilterFailure]:
            return UNHANDLED_FILTER_VALUE
    public:
        def handled() -> i64 error[UnhandledFilterFailure]:
            try step()
            value: i64 = try step()
            return value

def main() -> i64:
    return try UnhandledFilter::handled() else 0
