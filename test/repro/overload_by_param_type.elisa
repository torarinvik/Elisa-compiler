# Two overloads of the SAME ARITY are selected by PARAMETER TYPE, not by declaration order.
#
# stage1 answered 11 where stage0 answers 21: `f(true)` called the i64 body. The symbols were
# already distinct (`f` and `f.1` — declared_function_name suffixes by arity), so this was
# purely a RESOLUTION defect: emit_direct_call took the FIRST arity match.
#
# Note the language rule, learned from the oracle rather than from documentation: stage0
# REJECTS arity-based overloads ("duplicate declaration") while ACCEPTING same-arity
# type-based ones. So arity can never disambiguate an overload set — only types can.
struct A:
    v: i64

struct B:
    v: i64

def f(x: i64) -> i64:
    return 1

def f(x: bool) -> i64:
    return 2

def g(a: A) -> i64:
    return 3

def g(b: B) -> i64:
    return 4

def main() -> i64:
    # 1 + 20 = 21 — a bare literal (which types as Unmodeled and adopts its context) and a
    # bool must reach different bodies.
    scalars: i64 = f(1) + f(true) * 10
    # 3 + 40 = 43 — the same, discriminated by struct type.
    structs: i64 = g(A{v: 0}) + g(B{v: 0}) * 10
    return scalars + structs
