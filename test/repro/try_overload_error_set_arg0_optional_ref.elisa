module First:
    public:
        error Fault:
            Bad

module Second:
    public:
        error Fault:
            Other

struct Node:
    value: i64

def choose(first: i64, second: mutable Node&?) -> i64 error[First::Fault]:
    return 1

def choose(first: bool, second: mutable Node&) -> i64 error[Second::Fault]:
    raise Second::Fault.Other

def wrapper(first: i64, node: mutable Node&) -> i64 error[First::Fault]:
    return try choose(first, node)

def wrong_destination(first: i64, node: mutable Node&) -> i64 error[Second::Fault]:
    return try choose(first, node)

def main() -> i64 error[First::Fault]:
    node: mutable Node = Node{value: 0}
    return wrapper(1, &node)
