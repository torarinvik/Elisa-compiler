include "../../elisacore_std/elisacore_runtime.elisa"

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    append_items: mutable darray[i64] = [1, 2]
    values: darray[i64] = [3, 4]
    append_items <- append_items.extend(values)
    return 1 if append_items.count != 4 or append_items[3] != 4
    append_items <- append_items.extend(append_items)
    return 2 if append_items.count != 8 or append_items[7] != 4
    for index in 0..<300 |append_items|:
        append_items <- append_items.push(index.i64())
    return 3 if append_items.count != 308 or append_items[307] != 299
    append_items <- append_items.extend(append_items)
    return 4 if append_items.count != 616
    for index in 0..<308:
        return 5 if append_items[index] != append_items[index + 308]
    return 0
