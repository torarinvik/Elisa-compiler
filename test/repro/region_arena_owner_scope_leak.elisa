# nopath
# Arena& region names and lexical region blocks must stop being visible at their block/function
# boundary; later functions and sibling blocks may not reuse the spelling as a live region.
def first() -> void:
    region owner(4096):
        alloc: mutable Arena& = (&owner).cast[mutable Arena&] can Unsafe.PointerCast

def second() -> void:
    values: mutable darray[i64] @alloc = []

def sibling() -> void:
    if true:
        region owner(4096):
            alloc: mutable Arena& = (&owner).cast[mutable Arena&] can Unsafe.PointerCast
    values: mutable darray[i64] @alloc = []

def closed_region_sibling() -> void:
    if true:
        region inner(4096):
            pass
    values: mutable darray[i64] @inner = []
