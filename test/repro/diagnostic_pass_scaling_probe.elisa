include "../../src/semantic/semantic.elisa"

extend Semantic:
    public:
        def scaling_append_u64(value: u64, output: lmut darray[u8]) -> void:
            can Memory.Allocate, Abort.Panic:
                output <- output.push(((value >> 0) & 255).u8())
                output <- output.push(((value >> 8) & 255).u8())
                output <- output.push(((value >> 16) & 255).u8())
                output <- output.push(((value >> 24) & 255).u8())
                output <- output.push(((value >> 32) & 255).u8())
                output <- output.push(((value >> 40) & 255).u8())
                output <- output.push(((value >> 48) & 255).u8())
                output <- output.push(((value >> 56) & 255).u8())

        def scaling_emit_diagnostics(count: usize, table: SymbolTable&) -> i32:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                output: mutable darray[u8] = []
                output <- scaling_append_u64(count.u64(), output)
                output <- scaling_append_u64(table.symbols.count.u64(), output)
                output <- scaling_append_u64(table.duplicates.u64(), output)
                output <- scaling_append_u64(table.diagnostics.count.u64(), output)
                for diagnostic in table.diagnostics |output|:
                    texts: darray[sview] = [diagnostic.name, diagnostic.expected, diagnostic.actual, diagnostic.detail, diagnostic.const_enum_module_expected, diagnostic.const_enum_module_actual, diagnostic.detail2, diagnostic.detail3, diagnostic.effect_ref_1, diagnostic.effect_ref_2, diagnostic.effect_ref_3, diagnostic.effect_ref_4, diagnostic.effect_ref_5, diagnostic.effect_ref_6, diagnostic.effect_ref_7, diagnostic.effect_ref_8, diagnostic.error_set]
                    for text in texts |output|:
                        output <- scaling_append_u64(text.len.u64(), output)
                        for byte in text |output|:
                            output.push(byte)
                    numbers: darray[u64] = [diagnostic.kind.u64(), diagnostic.line.u64(), diagnostic.expected_count.u64(), diagnostic.actual_count.u64(), diagnostic.state_code.u64(), diagnostic.secondary_line.u64(), diagnostic.secondary_column.u64(), diagnostic.secondary_end_column.u64(), diagnostic.effect_ref_count.u64(), diagnostic.pos.line.u64(), diagnostic.pos.column.u64(), diagnostic.pos.offset.u64(), diagnostic.pos.end_line.u64(), diagnostic.pos.end_column.u64(), diagnostic.pos.end_offset.u64()]
                    for number in numbers |output|:
                        output <- scaling_append_u64(number, output)
                written: mutable usize = 0
                while written < output.count |written|:
                    chunk: isize = runtime_write(FileDescriptor.Output, (&output[written]).cast[void&], output.count - written) can Console.Write, Unsafe.RawExtern
                    return 98 if chunk <= 0
                    written <- written + chunk.usize()
                return 0

