                        PhaseTimer::mark("float_equality") can Global{Read,Write}
                        table <- check_negated_comparison(declarations, table)
                        PhaseTimer::mark("negated_comparison") can Global{Read,Write}
                        return scaling_emit_diagnostics(count, &table) can Console.Write, Unsafe.RawExtern

def main() -> i32:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        count: mutable usize = 0
        if phase_timer_getenv("DIAGNOSTIC_BENCH_COUNT") is bytes:
            first: u8 = bytes
            count <- 256 if first == 50 else 1024 if first == 49 else 4096 if first == 52 else 0
        return 99 if count == 0
        return Semantic::diagnostic_scaling_run(count) can Console.Write, Unsafe.RawExtern, Global{Read,Write}
