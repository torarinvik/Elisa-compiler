# Discarding a successful result must not discard the error channel of `try`.
error DiscardTryError:
    Failed

def fallible(value: i64) -> i64 error[DiscardTryError]:
    raise DiscardTryError.Failed if value < 0
    value

def discard_from_declaration(value: i64) -> void error[DiscardTryError]:
    _ = try fallible(value)

def main() -> i64:
    declaration_success: i64 = catch discard_from_declaration(7):
        ok: 0
        error failure: 1
    return 1 if declaration_success != 0
    declaration_failure: i64 = catch discard_from_declaration(-1):
        ok: 0
        DiscardTryError.Failed: 1
        error failure: 2
    return 2 if declaration_failure != 1
    0
