# Optional scalar returns and Elisa errors should compose at the Python boundary.
error MaybeError:
    Invalid

error MaybePayloadError:
    Invalid(code: i64)

def maybe_value(value: i64) -> i64? error[MaybeError]:
    raise MaybeError.Invalid if value < 0
    null return if value == 0
    return value

def maybe_flag(value: i64) -> bool? error[MaybeError]:
    raise MaybeError.Invalid if value < 0
    null return if value == 0
    return value > 1

def maybe_payload(value: i64) -> i64? error[MaybePayloadError]:
    raise MaybePayloadError.Invalid(value) if value < 0
    null return if value == 0
    return value

export pymodule optional_errors:
    fn value = maybe_value
    fn flag = maybe_flag
    fn payload = maybe_payload
