# Nested dictionary values preserve their complete mapping in structured errors.
error NestedDictPayloadError:
    Bad(values: dict[i64, dict[cstr, i64]])

def fail_nested(values: dict[i64, dict[cstr, i64]]) -> i64 error[NestedDictPayloadError]:
    raise NestedDictPayloadError.Bad(values)

error StructuredNestedDictPayloadError:
    Bad(code: i64, values: dict[i64, dict[cstr, i64]])

def fail_structured(code: i64, values: dict[i64, dict[cstr, i64]]) -> i64 error[StructuredNestedDictPayloadError]:
    raise StructuredNestedDictPayloadError.Bad(code, values)

export pymodule error_payload_nested_dict:
    fn fail_nested
    fn fail_structured
