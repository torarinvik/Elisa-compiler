include "../../src/semantic/semantic.elisa"

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    source: u8& = "affine struct File[state Closed | Open]:\n    handle: i64\ndef dead(owner: File[Closed]) -> void:\n    return\n    _ = move owner\ndef literal(owner: File[Closed]) -> void:\n    if false:\n        _ = move owner\n    _ = move owner\ndef short(owner: File[Closed]) -> void:\n    _ = false and (move owner).handle == 0\n    _ = move owner\n"
    tokens: darray[Lexer::Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    return 1 if file.errors.count != 0
    table: Semantic::SymbolTable = Semantic::check(&file)
    return 2 if table.ownership_function_flows.count != 3
    moves: mutable usize = 0
    for occurrence in table.ownership_occurrences |moves|:
        continue if not occurrence.is_move
        return 3 if not occurrence.known or not occurrence.liveness_available
        return 4 if table.symbols[occurrence.binding_id.owner.value.usize()].name == "dead"
        moves <- moves + 1
    return 5 if moves != 2
    for summary in table.ownership_function_flows:
        return 6 if not summary.coverage_complete
        if table.symbols[summary.owner.value.usize()].name == "dead":
            return 7 if summary.fallthrough_reachable or summary.facts_count != 1
            fact: Semantic::OwnershipBindingFact = table.ownership_exit_facts[summary.facts_start]
            return 8 if fact.reachable or Semantic::ownership_binding_can_consume(fact)
    return 0
