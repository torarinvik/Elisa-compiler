# A private imported enum is not a visible candidate at the root call site.
module Values:
    private:
        const enum Mode of i64:
            High = 11

const enum Mode of i64:
    High = 97

using Values

def root_fallback(value: i64 = Mode.High) -> i64:
    return value

export pymodule private_import_enum_root_fallback:
    fn root_fallback
