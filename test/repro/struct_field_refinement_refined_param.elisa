struct Positive:
    value: mutable i64 where value > 0

struct NonNegative:
    value: mutable i64 where value >= 0

struct NonNegativeHolder:
    inner: NonNegative

def wrap(value: i64 where value > 0) -> Positive:
    return Positive{value: value}

def update(target: mutable Positive&, value: i64 where value > 0) -> void:
    target.value <- value

def accept_nonnegative(value: NonNegative) -> NonNegative:
    return value

def main() -> i64:
    valid: Positive = wrap(42)
    updated: Positive = valid{value = 43}
    zero_valid: NonNegative = zeroed if true else zeroed
    zero_call_valid: NonNegative = accept_nonnegative(zeroed)
    nested_zero_valid: NonNegativeHolder = zeroed
    return updated.value + zero_valid.value + zero_call_valid.value + nested_zero_valid.inner.value
