include "../../elisacore_std/elisacore_runtime.elisa"

def main() -> i64:
    text: cstr = "hello"
    return 1 if runtime_strlen(text) != 5
    return 2 if string_index(text, 1) != 101
    return 3 if string_slice_eq(text, 1, 4, "ell") != 1
    return 4 if string_slices_eq(text, 1, 4, "zelle", 1, 4) != 1

    absent: cstr? = null
    return 5 if runtime_strlen(absent) != 0
    return 6 if string_slice_eq(absent, 0, -1, "") != 1
    return 7 if string_slices_eq(absent, 0, -1, "", 0, -1) != 1
    return 8
