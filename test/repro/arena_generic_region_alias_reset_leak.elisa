# Invalidating one generic arena region must also invalidate every generic region
# binder that could be instantiated to the same actual region.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"

struct Box[@v]:
    value: i64& @v

def reset_then_read[@a, @v](target: mutable Arena& @a, view: Box[v]) -> i64:
    arena_reset(target)
    return view.value[0]

def main() -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    arena: mutable Arena = zeroed
    alloc: mutable Arena& = &arena
    value: i64& @alloc = new[alloc] 65
    view: Box[alloc] = Box{value: value}
    return reset_then_read(alloc, view)
