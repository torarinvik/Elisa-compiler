# The root nominal type wins exact-name lookup before a nested alias of the same name.
struct Clash:
    marker: i64

module Provider:
    public:
        error Actual:
            Tag

module Local:
    type Clash = Provider::Actual
    public:
        def source() -> i64 error[Clash]:
            return 1

        def destination() -> i64 error[Provider::Actual]:
            return try source()

def main() -> i64:
    return 0
