# A copied mutable reference can rebind the descriptor behind an eligible parameter.
# The target must not receive alias scopes based only on the original caller arguments.
def update_pair(first: mutable darray[i64]&, second: mutable darray[i64]&) -> void:
    first_ref: mutable darray[i64]& = first
    first_ref <- second
    first[0] <- 7

def main() -> i64:
    left: mutable darray[i64] = [1]
    right: mutable darray[i64] = [2]
    update_pair(&left, &right)
    return right[0]
