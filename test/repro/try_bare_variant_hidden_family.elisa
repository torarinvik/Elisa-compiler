# A hidden sibling error set named Bad must not suppress the unique Bad variant
# fallback in App. A visible family named Bad must still take precedence.
error Fault:
    Bad
    Other

def leaf_bad() -> i64 error[Fault{Bad}]:
    return 1

def leaf_other() -> i64 error[Fault{Other}]:
    return 1

module Hidden:
    public:
        error Bad:
            Other

module App:
    public:
        def accepts_unique_variant() -> i64 error[Bad]:
            return try leaf_bad()

        def rejects_other_variant() -> i64 error[Bad]:
            return try leaf_other()

module LocalApp:
    public:
        error Bad:
            Other

        def visible_family_precedes_variant() -> i64 error[Bad]:
            return try leaf_bad()

def main() -> i64:
    return 0
