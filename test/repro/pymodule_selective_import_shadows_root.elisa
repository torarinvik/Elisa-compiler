# Selective imports precede the raw root-name fallback in Core type lookup.
module Values:
    public:
        const enum ImportedMode of i64:
            High = 41

const enum ImportedMode of i64:
    High = 47

using Values::ImportedMode

def imported_beats_root(value: ImportedMode = ImportedMode.High) -> ImportedMode:
    return value

export pymodule selective_import_shadows_root:
    fn imported_beats_root
