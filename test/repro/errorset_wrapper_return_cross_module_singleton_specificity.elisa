# With one declaration in each qualified namespace, Core does not activate its
# receiver-overload rewrite. The lexical Consumer.choose therefore wins, and EWR
# must not import the unselected Provider error family.
module Provider:
    public:
        error ProviderFault:
            Failed

        def choose(value: i64) -> i64 error[Provider::ProviderFault]:
            return 1

from Provider import choose

module Consumer:
    public:
        error ConsumerFault:
            Rejected

        def choose[T](value: T) -> i64 error[Consumer::ConsumerFault]:
            return 2

        def wrapper(value: i64) -> i64 error[Consumer::ConsumerFault]:
            return choose(value)

def main() -> i64:
    return 0
