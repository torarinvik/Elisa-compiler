# Regression: float literals in fixed-array constants must lower as LLVM real
# constants so indexing the array remains a backend-supported operation.
const WEIGHTS: f64[4] = [1.0, 2.0, 3.0, 4.0]

def weight(index: usize) -> f64:
    return WEIGHTS[index]

def main() -> i64:
    return weight(2).i64() + 40
