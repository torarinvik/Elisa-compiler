# A module declared with a QUALIFIED name is recorded VERBATIM — the parser captures the
# whole `Outer::Inner` chain as one source span — while a USE of it nests: `Outer::Inner::f`
# parses to Scope(Scope(Ident("Outer"), "Inner"), "f").
#
# Both halves missed that shape. The resolver only treated a BARE Ident base as a module
# qualifier, so it walked `Outer` as a value and reported it undefined; the backend declined
# rather than mangle a symbol. Single-level `M::f` is here too, so recovering the nested form
# cannot break it.
module Outer::Inner:
    public:
        def double(n: i64) -> i64:
            return n * 2


module Single:
    public:
        def triple(n: i64) -> i64:
            return n * 3


def main() -> i64:
    return Outer::Inner::double(9) + Single::triple(8)
