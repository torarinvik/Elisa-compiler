include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"

struct Box[@r]:
    value: i64& @r

def bad() -> i64:
    region r(64)
    outer_value: i64& @r = new[r] 7
    mutable outer: Box[r] = Box{value: outer_value}
    region r(64):
        inner_value: i64& @r = new[r] 8
        inner: Box[r] = Box{value: inner_value}
        outer <- inner
        destroy r
        stale_read: i64 = outer.value[0]
    return 0

def main() -> i64:
    return bad()
