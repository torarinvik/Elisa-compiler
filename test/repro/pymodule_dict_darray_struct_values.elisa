struct Point:
    x: i64
    label: sview

struct Catalog:
    rows: dict[i64, darray[Point]]

def roundtrip(rows: dict[i64, darray[Point]]) -> dict[i64, darray[Point]]:
    return rows

def roundtrip_rows(rows: darray[dict[i64, darray[Point]]]) -> darray[dict[i64, darray[Point]]]:
    return rows

def roundtrip_catalog(catalog: Catalog) -> Catalog:
    return catalog

export pymodule dict_darray_struct_values:
    fn roundtrip
    fn roundtrip_rows
    fn roundtrip_catalog
