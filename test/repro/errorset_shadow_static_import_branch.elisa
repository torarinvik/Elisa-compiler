# An inactive ErrorSet import must not shadow an ErrorSet parameter when the active
# import with the same leaf names an ordinary nominal type.
module InactiveProvider:
    public:
        error Fault:
            Failed

module ActiveProvider:
    public:
        struct Fault:
            code: i64

static if false:
    from InactiveProvider import Fault
static else:
    from ActiveProvider import Fault

def forward[errorset Fault](callback: fn() -> i64 error[Fault]) -> i64 error[Fault]:
    return try callback()

def main() -> i64:
    return 0
