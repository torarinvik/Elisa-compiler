struct Bucket[K, T]:
    key: mutable K
    value: mutable T
    state: mutable u8

struct Map[K, T]:
    items: mutable Bucket[K, T]&?
    count: mutable usize
    used: mutable usize
    capacity: mutable usize

struct Result:
    index: mutable usize
    found: mutable bool

def probe[K, T](m: Map[K, T]&, key: K) -> Result:
    Result{index: 0, found: false} return if m.capacity == 0 or m.items == null
    st: u8 = get_items(m)[0].state
    return Result{index: 0, found: st == 1}

def direct(items: Bucket[i64, i64]&) -> u8:
    i: mutable usize = 0
    while i < 1:
        st: u8 = items[i].state
        return st
    return 0

def from_optional[K, T](source: Bucket[K, T]&?) -> u8:
    assert source != null
    items: Bucket[K, T]& = source
    return items[0].state

def get_items[K, T](m: Map[K, T]&) -> Bucket[K, T]&:
    assert m.items != null
    return m.items

def local(source: Bucket[i64, i64]&) -> u8:
    items: Bucket[i64, i64]& = source
    return items[0].state

def main(items: mutable Bucket[i64, i64]&) -> u8:
    return direct(items)
