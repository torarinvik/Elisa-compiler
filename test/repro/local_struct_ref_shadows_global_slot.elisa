# A local generic struct reference must shadow an unrelated global leaf name.
module Other:
    global mutable slot: i64 = 0

struct Payload:
    value: i64

def read_slot[T](slot: T&) -> T:
    return slot[0]

def main() -> i32:
    payload: Payload = Payload{value: 42}
    copied: Payload = read_slot(&payload)
    return 1 if copied.value != 42
    return 0
