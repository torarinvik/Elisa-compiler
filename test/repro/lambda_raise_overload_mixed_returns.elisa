module API:
    public:
        error A:
            Bad
        error B:
            Bad
        def run(value: i64, callback: fn() -> i64 error[A]) -> i64 error[A]:
            return try callback()
        def run(value: bool, callback: fn() -> i64 error[B]) -> i64:
            return 1
def good() -> i64:
    return API::run(true, fn() => raise API::B.Bad)
def bad() -> i64 error[API::A]:
    return API::run(1, fn() => raise API::B.Bad)
