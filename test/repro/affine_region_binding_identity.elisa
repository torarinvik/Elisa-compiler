linear typestate Ticket:
    id: i64
    states: Fresh, Used
    terminal: Used
    transition redeem: Fresh -> Used

struct RegionPair[@a, @b]:
    left: i64& @a
    right: i64& @b

def consume_same[@r](ticket: Ticket[Fresh], pair: RegionPair[r, r]) -> void ensures ticket => Used:
    redeem(ticket)

def matching[@r](pair: RegionPair[r, r]) -> void:
    matching_ticket: Ticket[Fresh] = Ticket.new(id: 1)
    pair_copy = pair
    consume_same(matching_ticket, pair_copy)

def differing[@a, @b](pair: RegionPair[a, b]) -> void:
    differing_ticket: Ticket[Fresh] = Ticket.new(id: 1)
    pair_copy = pair
    consume_same(differing_ticket, pair_copy)

# A region binder named `a` in another function does not turn this nominal type
# argument into a region, or hide its consuming postcondition.
struct a:
    value: i64

struct NominalBox[Elem]:
    value: Elem

def consume_nominal(ticket: Ticket[Fresh], value: NominalBox[a]) -> void ensures ticket => Used:
    redeem(ticket)

def nominal_collision(value: NominalBox[a]) -> void:
    nominal_ticket: Ticket[Fresh] = Ticket.new(id: 1)
    consume_nominal(nominal_ticket, value)
