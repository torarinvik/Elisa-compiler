struct Pair[state Within | Outside]:
    low: i64
    high: i64
    tag: i64
    derive state:
        Within when self.low < self.high
        Outside when self.low >= self.high

type Ordered = Pair[Within]

def reorder(pair: Pair[Outside], flag: bool) -> Ordered:
    return pair{low = 7, high = 9} if flag else pair{high = 9, low = 7}

def retag(pair: Pair[Within]) -> Ordered:
    return pair{tag = 3}

def main() -> i32:
    original: Pair[Outside] = Pair[Outside]{low: 5, high: 0, tag: 1}
    first: Ordered = reorder(original, true)
    second: Ordered = reorder(original, false)
    tagged: Ordered = retag(first)
    return 1 if first.low != 7 or first.high != 9 or first.tag != 1
    return 2 if second.low != 7 or second.high != 9 or second.tag != 1
    return 3 if tagged.low != 7 or tagged.high != 9 or tagged.tag != 3
    return 4 if original.low != 5 or original.high != 0 or original.tag != 1
    return 0
