# A hidden sibling's error set must not shadow a visible unique bare error variant.
module Hidden:
    public:
        error Expected:
            HiddenTag

error Fault:
    Expected

error Other:
    Trouble

module Visible:
    public:
        def origin() -> i64 error[Expected]:
            return 1

        def good_destination() -> i64 error[Fault]:
            return try origin()

        def wrong_destination() -> i64 error[Other]:
            return try origin()

def main() -> i64:
    return 0
