# nopath

struct Text:
    value: cstr?

def bad_return(raw: u8&?) -> cstr?:
    return raw

def bad_local_assignment() -> i64:
    byte: u8 = 65.u8()
    raw: u8&? = &byte
    text: cstr? = raw
    return 0

def bad_local_rebind() -> i64:
    byte: u8 = 65.u8()
    raw: u8&? = &byte
    mutable text: cstr? = null
    text <- raw
    return 0

def bad_field_construction(raw: u8&?) -> Text:
    return Text{value: raw}

def main() -> i64:
    return 0
