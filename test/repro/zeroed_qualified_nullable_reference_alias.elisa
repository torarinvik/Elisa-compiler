module RefTypes:
    type MutableIntegerReference = mutable i64&
    type IntegerReferenceAlias = MutableIntegerReference

module NullableRefTypes:
    type MutableIntegerReference = mutable i64&?
    type IntegerReferenceAlias = MutableIntegerReference

def main() -> i64:
    pointer: mutable NullableRefTypes::IntegerReferenceAlias = zeroed
    return 42 if pointer == null else 1
