# Conflicting inherited and nested wildcard candidates are ambiguous; Try must not pick either family.
module OuterApi:
    public:
        error OuterFault:
            Outer

        def ping() -> i64 error[OuterApi::OuterFault]:
            return 1

module Consumer:
    public:
        error Destination:
            Other

    module Inner:
        using LocalApi

        module LocalApi:
            public:
                error InnerFault:
                    Inner

                def ping() -> i64 error[Consumer::Inner::LocalApi::InnerFault]:
                    return 2

        public:
            def direct_caller() -> i64 error[Consumer::Destination]:
                return try ping()

            def cached_caller() -> i64 error[Consumer::Destination]:
                payload = ping()
                return try payload

using OuterApi

def main() -> i64:
    return 0
