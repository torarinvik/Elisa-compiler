struct Player[state Alive | Dead]:
    health: mutable i64
    tag: i64
    derive state:
        Alive when self.health > 0
        Dead when self.health <= 0

def maybe_kill(player: mutable Player[Alive], count: i64) -> Player[Dead]:
    for index in 0..<count |player|:
        player.health <- 0
    return player{tag = 1}
