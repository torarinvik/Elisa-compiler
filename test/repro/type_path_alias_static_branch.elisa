module TypePathAliasProvider:
    struct Item:
        value: i64

    module Nested:
        struct Item:
            value: i64

using TypePathAliasProvider as ActiveAlias

static if false:
    using TypePathAliasProvider as InactiveAlias

static if ELISA_TARGET_OS_WASI:
    using TypePathAliasProvider as PossibleAlias

def active_alias(value: ActiveAlias.Item) -> i64:
    return 0

def nested_active_alias(value: ActiveAlias::Nested.Item) -> i64:
    return 0

def inactive_alias(value: InactiveAlias.Item) -> i64:
    return 0

def possible_alias(value: PossibleAlias.Item) -> i64:
    return 0

module AliasShadowing:
    module OuterProvider:
        module Nested:
            struct Item:
                value: i64

    using OuterProvider as Choice

    module Inner:
        module InnerProvider:
            struct Item:
                value: i64

        using InnerProvider as Choice

        def shadowed_alias(value: Choice::Nested.Item) -> i64:
            return 0

    module PossibleInner:
        module OtherProvider:
            struct Item:
                value: i64

        static if ELISA_TARGET_OS_WASI:
            using OtherProvider as Choice

        def possible_shadow(value: Choice::Nested.Item) -> i64:
            return 0
