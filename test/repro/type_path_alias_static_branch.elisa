module TypePathAliasProvider:
    struct Item:
        value: i64

    module Nested:
        struct Item:
            value: i64

using TypePathAliasProvider as ActiveAlias

static if false:
    using TypePathAliasProvider as InactiveAlias

static if ELISA_TARGET_OS_WASI:
    using TypePathAliasProvider as PossibleAlias

using PossibleAlias::Nested as ChainedAlias

def active_alias(value: ActiveAlias.Item) -> i64:
    return 0

def nested_active_alias(value: ActiveAlias::Nested.Item) -> i64:
    return 0

def inactive_alias(value: InactiveAlias.Item) -> i64:
    return 0

def possible_alias(value: PossibleAlias.Item) -> i64:
    return 0

def chained_alias(value: ChainedAlias.Item) -> i64:
    return 0

module AliasOwner:
    module AliasProvider:
        struct Item:
            value: i64

    using AliasProvider as NestedGlobalAlias

def nested_global_alias(value: NestedGlobalAlias.Item) -> i64:
    return 0

# A nested alias is flattened before analysis and may use a root alias registered
# later in source text; resolve its target chain against the complete alias table.
module LateAliasContainer:
    using LaterRootAlias::Nested as LateNestedAlias

using TypePathAliasProvider as LaterRootAlias

def nested_alias_uses_late_parent(value: LateNestedAlias.Item) -> i64:
    return 0

# The root alias is pre-registered before the earlier textual nested branch.
module EarlierNestedPossibleAlias:
    static if ELISA_TARGET_OS_WASI:
        using TypePathAliasProvider as AncestorWins

using TypePathAliasProvider as AncestorWins

def ancestor_alias_precedes_nested_possible(value: AncestorWins::Nested.Item) -> i64:
    return 0

module OtherTypePathAliasProvider:
    module Nested:
        struct Item:
            value: i64

module FlatTypePathAliasProvider:
    struct Item:
        value: i64

module RawFallbackModule:
    module Nested:
        struct Item:
            value: i64

module Inner:
    struct RootItem:
        value: i64

module Outer:
    module Inner:
        module Nested:
            struct Item:
                value: i64

    using Inner as ScopedAlias

def scoped_raw_module_alias_prefers_nearest_scope(value: ScopedAlias::Nested.Item) -> i64:
    return 0

using TypePathAliasProvider as DirectWins
static if ELISA_TARGET_OS_WASI:
    using OtherTypePathAliasProvider as DirectWins

def direct_alias_precedes_same_scope_possible(value: DirectWins::Nested.Item) -> i64:
    return 0

# The later branch alias is outside this target's registration cutoff, so the
# already-declared raw module path remains usable for this alias target.
module RawFallbackAliasContainer:
    using RawFallbackModule::Nested as RawFallbackAlias

    static if true:
        using TypePathAliasProvider as RawFallbackModule

def later_alias_keeps_raw_module_target(value: RawFallbackAlias.Item) -> i64:
    return 0

# A later using-alias is not a raw module declaration. Its module symbol must not
# satisfy the fallback when this alias target is canonicalized at its declaration.
module RawAliasOnlyContainer:
    using RawAliasOnlyName as RawAliasOnlyTarget

    static if true:
        using TypePathAliasProvider as RawAliasOnlyName

def later_alias_does_not_create_raw_module(value: RawAliasOnlyTarget.Item) -> i64:
    return 0

# Unlike a direct parent-block alias, a parent branch alias registers at its traversal
# position. The earlier child alias therefore wins when the branch follows the child.
module ParentBranchAfterChild:
    module ChildAlias:
        using TypePathAliasProvider as BranchAfterChild

    static if true:
        using FlatTypePathAliasProvider as BranchAfterChild

def later_parent_branch_does_not_win(value: BranchAfterChild::Nested.Item) -> i64:
    return 0

# When the same branch is traversed before the child module, its alias registers first.
module ParentBranchBeforeChild:
    static if true:
        using TypePathAliasProvider as BranchBeforeChild

    module ChildAlias:
        using FlatTypePathAliasProvider as BranchBeforeChild

def earlier_parent_branch_wins(value: BranchBeforeChild::Nested.Item) -> i64:
    return 0

# Within one branch block, direct aliases are pre-registered before the nested module,
# even when the source line follows that module.
module BranchBodyPrepass:
    static if true:
        module ChildAlias:
            using FlatTypePathAliasProvider as SharedBranchAlias

        using TypePathAliasProvider as SharedBranchAlias

def branch_body_direct_alias_wins(value: SharedBranchAlias::Nested.Item) -> i64:
    return 0

# Alias-target canonicalization follows the same branch-block cutoff: an alias
# registered before the chain is available, while a later alias in that block is not.
static if true:
    using TypePathAliasProvider as BranchHeadBeforeChain
    using BranchHeadBeforeChain::Nested as BranchChainBeforeHead

static if true:
    using BranchHeadAfterChain::Nested as BranchChainAfterHead
    using TypePathAliasProvider as BranchHeadAfterChain

def branch_alias_target_before_chain(value: BranchChainBeforeHead.Item) -> i64:
    return 0

def branch_alias_target_after_chain(value: BranchChainAfterHead.Item) -> i64:
    return 0
