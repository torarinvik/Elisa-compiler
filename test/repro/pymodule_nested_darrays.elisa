def roundtrip(values: darray[darray[i64]]) -> darray[darray[i64]]:
    return values

def roundtrip_isize(values: darray[darray[isize]]) -> darray[darray[isize]]:
    return values

def roundtrip_usize(values: darray[darray[usize]]) -> darray[darray[usize]]:
    return values

def roundtrip_uintptr(values: darray[darray[uintptr]]) -> darray[darray[uintptr]]:
    return values

def roundtrip_optional_isize(values: darray[darray[isize?]]) -> darray[darray[isize?]]:
    return values

def roundtrip_optional_uintptr(values: darray[darray[uintptr?]]) -> darray[darray[uintptr?]]:
    return values

def roundtrip_optional_isize_scalar(value: isize?) -> isize?:
    return value

def roundtrip_optional_uintptr_scalar(value: uintptr?) -> uintptr?:
    return value

def echo_u8(value: u8) -> u8:
    return value

def echo_u8_after_default(prior: darray[i64] = [7], value: u8 = 0) -> u8:
    return value

def echo_u64(value: u64) -> u64:
    return value

def echo_usize(value: usize) -> usize:
    return value

def echo_uintptr(value: uintptr) -> uintptr:
    return value

def echo_uintptr_and_i64(value: uintptr, count: i64) -> i64:
    return count

def optional_uintptr_defaults(prior: u64? = 7, value: uintptr? = 0) -> uintptr?:
    return value

def count(values: darray[darray[i64]]) -> i64:
    return values.count.i64()

def roundtrip_deep(values: darray[darray[darray[darray[i64]]]]) -> darray[darray[darray[darray[i64]]]]:
    return values

struct Point:
    x: i64
    label: sview

def roundtrip_points(values: darray[darray[Point]]) -> darray[darray[Point]]:
    return values

def roundtrip_points_deep(values: darray[darray[darray[Point]]]) -> darray[darray[darray[Point]]]:
    return values

export pymodule nested_darrays:
    fn roundtrip
    fn roundtrip_isize
    fn roundtrip_usize
    fn roundtrip_uintptr
    fn roundtrip_optional_isize
    fn roundtrip_optional_uintptr
    fn roundtrip_optional_isize_scalar
    fn roundtrip_optional_uintptr_scalar
    fn echo_u8
    fn echo_u8_after_default
    fn echo_u64
    fn echo_usize
    fn echo_uintptr
    fn echo_uintptr_and_i64
    fn optional_uintptr_defaults
    fn count
    fn roundtrip_deep
    fn roundtrip_points
    fn roundtrip_points_deep
