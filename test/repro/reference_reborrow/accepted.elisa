# Regression (reference re-borrow), positive half: every context that
# test/repro/reference_reborrow/rejected/ rejects, written the correct way (a reference is
# forwarded bare), plus the `&ref` shapes stage0 ACCEPTS because the destination
# really is a reference to a reference (`T&&`, a generic `T`, an inferred local), and
# the REBORROW cast `(&ref).cast[U&]`, which reinterprets the referent -- not the
# reference's slot -- in both compilers. Each callee must observe the caller's real
# Counter; `main` returns the number of the first check that fails, 0 when all pass.
module Reref:
    public:
        error CounterError:
            Full

        struct Counter:
            values: mutable i64[4]
            count: mutable usize

        def bump_ok(counter: mutable Counter&) -> bool:
            return false if counter.count >= 4
            counter.values[counter.count] <- 7
            counter.count <- counter.count + 1
            true

        def bump_err(counter: mutable Counter&) -> void error[CounterError]:
            raise CounterError.Full if counter.count >= 4
            counter.count <- counter.count + 1

        def reads(counter: Counter&) -> usize:
            counter.count

        def reads_at(first: usize, counter: Counter&) -> usize:
            counter.count + first

        def reads_opt(counter: Counter&?) -> usize:
            if counter is c:
                return reads(c)
            99

        def takes_rr(counter: Counter&&) -> usize:
            counter[0].count

        def id[T](x: T) -> T:
            x

        def plain_statement(counter: mutable Counter&) -> void:
            bump_ok(counter)

        def discard(counter: mutable Counter&) -> void:
            _ = bump_ok(counter)

        def catch_guard(counter: mutable Counter&) -> i32:
            catch bump_err(counter):
                ok: 0
                error failure: 1

        def raise_if(counter: mutable Counter&) -> void error[CounterError]:
            raise CounterError.Full if not bump_ok(counter)

        def try_form(counter: mutable Counter&) -> void error[CounterError]:
            try bump_err(counter)

        def qualified(counter: mutable Counter&) -> void:
            _ = Reref::bump_ok(counter)

        def immutable_param(counter: Counter&) -> usize:
            reads(counter)

        def mutable_to_immutable(counter: mutable Counter&) -> usize:
            reads(counter)

        def if_condition(counter: mutable Counter&) -> i32:
            if bump_ok(counter):
                return 1
            0

        def nested_call(counter: Counter&) -> usize:
            1 + reads(counter)

        def named_argument(counter: Counter&) -> usize:
            reads_at(counter: counter, first: 1)

        def optional_param(counter: Counter&) -> usize:
            reads_opt(counter)

        def return_ref(counter: Counter&) -> Counter&:
            return counter

        def annotated_local(counter: mutable Counter&) -> usize:
            r: Counter& = counter
            r.count

        def untyped_with(counter: mutable Counter&) -> usize:
            counter with { count <- 3 }
            counter.count

        def ufcs_receiver(counter: Counter&) -> usize:
            counter.reads()

        def field_access(counter: Counter&) -> usize:
            counter.count

        # Accepted `&ref`: the destination is a reference to a reference.
        def to_ref_ref(counter: Counter&) -> usize:
            takes_rr(&counter)

        def inferred_ref_ref(counter: Counter&) -> usize:
            r = &counter
            takes_rr(r)

        def generic_ref_ref(counter: Counter&) -> usize:
            r = id(&counter)
            takes_rr(r)

        # Accepted cast of `&ref`: the reborrow idiom (stage0's `(&self).cast[mutable T&]`).
        def cast_to_void(counter: Counter&) -> bool:
            p: void& = (&counter).cast[void&] can Unsafe.PointerCast
            q: void& = counter.cast[void&] can Unsafe.PointerCast
            p.cast[usize] == q.cast[usize] can Unsafe.PointerCast

        def reborrow_read(counter: Counter&) -> usize:
            reads((&counter).cast[Counter&]) can Unsafe.PointerCast

        def reborrow_forward(counter: mutable Counter&) -> bool:
            bump_ok((&counter).cast[mutable Counter&]) can Unsafe.PointerCast

        def reborrow_field(counter: Counter&) -> usize:
            ((&counter)).cast[Counter&].count can Unsafe.PointerCast

        # ... but a REBINDABLE reference local is a variable in its own right: its `&r` is
        # the slot, cast or not (stage0's emitAddress reads through only a binding that
        # cannot be rebound).
        def rebindable_is_slot(counter: mutable Counter&) -> bool:
            r: mutable Counter& = counter
            p: void& = (&r).cast[void&] can Unsafe.PointerCast
            q: void& = r.cast[void&] can Unsafe.PointerCast
            p.cast[usize] != q.cast[usize] can Unsafe.PointerCast

        # Accepted `&`: the operand is not itself a reference.
        def field_through(counter: mutable Counter&) -> i64:
            values: mutable i64[4]& = &counter.values
            values[0] <- 11
            counter.values[0]

        def loop_elements(xs: darray[Counter]&) -> usize:
            total: mutable usize = 0
            for x in xs |total|:
                total <- total + reads(&x)
            total

def fresh(count: usize) -> Reref::Counter:
    Reref::Counter{values: [0, 0, 0, 0], count: count}

def main() -> i32:
    counter: mutable Reref::Counter = fresh(0)
    Reref::plain_statement(&counter)
    return 1 if counter.count != 1 or counter.values[0] != 7
    Reref::discard(&counter)
    return 2 if counter.count != 2
    return 3 if Reref::catch_guard(&counter) != 0 or counter.count != 3
    raised: i32 = catch Reref::raise_if(&counter):
        ok: 0
        error failure: 1
    return 4 if raised != 0 or counter.count != 4
    raised_full: i32 = catch Reref::raise_if(&counter):
        ok: 0
        error failure: 1
    return 5 if raised_full != 1 or counter.count != 4
    counter <- fresh(1)
    tried: i32 = catch Reref::try_form(&counter):
        ok: 0
        error failure: 1
    return 6 if tried != 0 or counter.count != 2
    Reref::qualified(&counter)
    return 7 if counter.count != 3
    return 8 if Reref::immutable_param(&counter) != 3
    return 9 if Reref::mutable_to_immutable(&counter) != 3
    return 10 if Reref::if_condition(&counter) != 1 or counter.count != 4
    return 11 if Reref::nested_call(&counter) != 5
    return 12 if Reref::named_argument(&counter) != 5
    return 13 if Reref::optional_param(&counter) != 4
    return 14 if Reref::return_ref(&counter).count != 4
    return 15 if Reref::annotated_local(&counter) != 4
    return 16 if Reref::untyped_with(&counter) != 3 or counter.count != 3
    return 17 if Reref::ufcs_receiver(&counter) != 3
    return 18 if Reref::field_access(&counter) != 3
    return 19 if Reref::to_ref_ref(&counter) != 3
    return 20 if Reref::inferred_ref_ref(&counter) != 3
    return 21 if Reref::generic_ref_ref(&counter) != 3
    return 22 if not Reref::cast_to_void(&counter)
    return 23 if Reref::field_through(&counter) != 11
    return 25 if Reref::reborrow_read(&counter) != 3
    return 26 if not Reref::reborrow_forward(&counter) or counter.count != 4 or counter.values[3] != 7
    return 27 if Reref::reborrow_field(&counter) != 4
    return 28 if not Reref::rebindable_is_slot(&counter)
    xs: mutable darray[Reref::Counter] = []
    xs.push(fresh(3))
    xs.push(fresh(4))
    return 24 if Reref::loop_elements(&xs) != 7
    0
