# Regression (reference re-borrow): `&name` where `name` is already a reference is a `T&&`;
# stage0 rejects it here, and stage1 must too instead of passing the reference's own slot.
# Context: a `T&` struct-literal field.
# expect-error-lines: 30
module Reref:
    public:
        error CounterError:
            Full

        struct Counter:
            values: mutable i64[4]
            count: mutable usize

        def bump_ok(counter: mutable Counter&) -> bool:
            return false if counter.count >= 4
            counter.count <- counter.count + 1
            true

        def bump_err(counter: mutable Counter&) -> void error[CounterError]:
            raise CounterError.Full if counter.count >= 4
            counter.count <- counter.count + 1

        def reads(counter: Counter&) -> usize:
            counter.count

        struct Holder:
            c: Counter&

        def struct_field(counter: Counter&) -> usize:
            h: Holder = Holder{c: &counter}
            0

def main() -> i32:
    0
