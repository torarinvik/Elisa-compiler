# Regression (reference re-borrow): `&name` where `name` is already a reference is a `T&&`;
# stage0 rejects it here, and stage1 must too instead of passing the reference's own slot.
# Context: a `void&` extern parameter.
# expect-error-lines: 11
struct Counter:
    count: mutable usize

extern probe_touch(buf: void&, count: usize) -> isize

def extern_void(counter: Counter&) -> isize:
    probe_touch(&counter, 1)

def main() -> i32:
    0
