# Regression (reference re-borrow): the reported repro, verbatim. Every `&counter` here is a
# `Counter&&` passed where a `Counter&` is expected; stage1 used to accept all four and pass
# the parameter's own slot (exit 15). Both compilers must now reject each one.
# expect-error-lines: 24 27 30 33
module Reref:
    public:
        error CounterError:
            Full

        struct Counter:
            values: mutable i64[4]
            count: mutable usize

        def bump_ok(counter: mutable Counter&) -> bool:
            return false if counter.count >= 4
            counter.values[counter.count] <- 7
            counter.count <- counter.count + 1
            true

        def reads(counter: Counter&) -> usize:
            counter.count

        def read_mutable(counter: mutable Counter&) -> usize:
            reads(&counter)

        def read_immutable(counter: Counter&) -> usize:
            reads(&counter)

        def raise_form(counter: mutable Counter&) -> void error[CounterError]:
            raise CounterError.Full if not bump_ok(&counter)

        def discard_form(counter: mutable Counter&) -> void:
            _ = Reref::bump_ok(&counter)

def main() -> i32:
    counter: mutable Reref::Counter = Reref::Counter{values: [0, 0, 0, 0], count: 1}
    status: mutable i32 = 0
    status <- status + 1 if Reref::read_mutable(&counter) != 1
    status <- status + 2 if Reref::read_immutable(&counter) != 1
    raised: i32 = catch Reref::raise_form(&counter):
        ok: 0
        error failure: 1
    status <- status + 4 if raised != 0 or counter.count != 2
    Reref::discard_form(&counter)
    status <- status + 8 if counter.count != 3
    status
