# Same-spelled static/runtime functions are visible only through lexical scope or
# the caller's import. Both module declaration orders exercise exact lookup.
enum GeneratedVariant:
    One

module RuntimeFirst:
    public:
        def build() -> i32:
            return 1

module StaticSecond:
    static def build() -> i32:
        return 2

module UseRuntimeFirst:
    from RuntimeFirst import build
    static generate:
        for variant in variants(GeneratedVariant):
            emit def generated_${build()}() -> i32:
                return 0

module StaticFirst:
    static def build() -> i32:
        return 2

module RuntimeSecond:
    public:
        def build() -> i32:
            return 1

module UseRuntimeSecond:
    from RuntimeSecond import build
    static generate:
        for variant in variants(GeneratedVariant):
            emit def generated_${build()}() -> i32:
                return 0

module LexicalStaticParent:
    static def local_build() -> i32:
        return 2
    module Child:
        def local_build() -> i32:
            return 1
        static generate:
            for variant in variants(GeneratedVariant):
                emit def generated_${local_build()}() -> i32:
                    return 0

module LexicalRuntimeParent:
    def local_build() -> i32:
        return 1
    module Child:
        static def local_build() -> i32:
            return 2
        static generate:
            for variant in variants(GeneratedVariant):
                emit def generated_${local_build()}() -> i32:
                    return 0
