# Rebinding a local mutable reference can make it alias a second descriptor. A later call
# receiving that reference and the second descriptor must not be treated as disjoint.
def update_pair(first: mutable darray[i64]&, second: mutable darray[i64]&) -> void:
    first[0] <- second[0]

def rebind(target: mutable darray[i64]&, source: mutable darray[i64]) -> void:
    target <- source

def route() -> void:
    left: mutable darray[i64] = [1]
    right: mutable darray[i64] = [2]
    rebind(&left, right)
    update_pair(&left, &right)

def main() -> i64:
    route()
    return 0
