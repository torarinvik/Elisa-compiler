@intrinsic("llvm.wasm.memory.grow.i32")
extern memory_grow(memory_index: u32, pages: u32) -> i32

@intrinsic("llvm.wasm.memory.size.i32")
extern memory_size(memory_index: u32) -> u32

global mutable heap_cursor: u32 = 1048576

def align_up(value: u32, alignment: u32) -> u32:
    return ((value + alignment - 1) / alignment) * alignment

def ensure_capacity(end: u32):
    current: u32 = memory_size(0) * 65536
    if end > current:
        needed: u32 = end - current
        pages: u32 = (needed + 65535) / 65536
        result: i32 = memory_grow(0, pages)
        if result < 0:
            pass

def copy_bytes(destination: u32, source: u32, count: u32):
    trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic, Unsafe.UncheckedIndex]:
        dst: mutable u8& = destination.cast[mutable u8&]
        src: u8& = source.cast[u8&]
        for index in 0..<count.usize():
            dst[index] <- src[index]

def cabi_realloc_impl(old_ptr: u32, old_size: u32, alignment: u32, new_size: u32) -> u32:
    return 0 if new_size == 0
    start: u32 = align_up(heap_cursor, alignment) if alignment > 0 else heap_cursor
    end: u32 = start + new_size
    ensure_capacity(end)
    copy_bytes(start, old_ptr, old_size if old_size < new_size else new_size) if old_ptr != 0
    heap_cursor <- end
    return start

export fn cabi_realloc(old_ptr: u32, old_size: u32, alignment: u32, new_size: u32) -> u32 = cabi_realloc_impl
