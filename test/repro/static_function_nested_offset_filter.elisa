# Same-name functions at the same logical line must keep their source identities.
# The helper in Outer::Inner is compile-time only; the one in Kept is a runtime function.
#line 70 static-helper.elisa
module Outer:
    module Inner:
        static def helper() -> i64:
            return 8

#line 70 runtime-helper.elisa
module Kept:
    def helper() -> i64:
        return 7

struct Value:
    amount: i64

impl Value:
    static def compile_only_impl() -> i64:
        return 5

def main() -> i64:
    return Kept::helper()
