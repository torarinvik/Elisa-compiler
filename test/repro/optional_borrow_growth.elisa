# An optional borrow parameter (`edges: mutable darray[usize]&?`) is grown only through the
# name a refinement binds: `if edges is e:` or `e = get edges else return`, typed or not.
# That growth must land in the CALLER's region. stage1 built it in the callee's own region
# and freed it on return; stage0 rejected it ("darray push has no region to grow into").
# A `null` argument grows nothing. Covers both narrowing spellings, a typed reference alias,
# forwarding the optional borrow to another function, and two optional borrows in one call.
# Exits 0 under both compilers.
def enqueue(value: usize, edges: mutable darray[usize]&?) -> void can[Memory.Allocate]:
    if edges is e:
        e.push(value)

def enqueue_get(value: usize, edges: mutable darray[usize]&?) -> void can[Memory.Allocate]:
    e = get edges else return
    e.push(value)

def enqueue_typed(value: usize, edges: mutable darray[usize]&?) -> void can[Memory.Allocate]:
    e: mutable darray[usize]& = get edges else return
    e.push(value)

def push_alias(value: usize, edges: mutable darray[usize]&) -> void can[Memory.Allocate]:
    alias: mutable darray[usize]& = edges
    alias.push(value)

def walk(count: usize, edges: mutable darray[usize]&?) -> void can[Memory.Allocate]:
    for index in 0..<count |edges|:
        enqueue(index, edges)

def split(value: usize, odd: mutable darray[usize]&?, even: mutable darray[usize]&?) -> void can[Memory.Allocate]:
    if value % 2 == 1:
        if odd is o:
            o.push(value)
    elif even is e:
        e.push(value)

# Builds and drops scratch values in this call's own region, so a block freed by an earlier
# call's region is reused and overwritten here: a dangling buffer then reads these values.
def clobber() -> i64 can[Memory.Allocate, Abort.Panic]:
    scratch: mutable darray[usize] = []
    for index in 0..<256 |scratch|:
        scratch.push(9999)
    scratch.count.i64()

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    buffer: mutable darray[usize] = []
    enqueue(3, &buffer)
    enqueue(4, null)
    enqueue_get(5, &buffer)
    enqueue_get(6, null)
    enqueue_typed(7, &buffer)
    enqueue_typed(8, null)
    push_alias(9, &buffer)
    _ = clobber()
    return 1 if buffer.count != 4 or buffer[0] != 3 or buffer[1] != 5 or buffer[2] != 7 or buffer[3] != 9
    walked: mutable darray[usize] = []
    walk(40, &walked)
    walk(5, null)
    _ = clobber()
    return 2 if walked.count != 40 or walked[39] != 39
    odds: mutable darray[usize] = []
    evens: mutable darray[usize] = []
    for index in 0..<10 |odds, evens|:
        split(index, &odds, &evens)
        split(index, null, &evens)
        split(index, &odds, null)
    _ = clobber()
    return 3 if odds.count != 10 or evens.count != 10 or odds[0] != 1 or evens[9] != 8
    0
