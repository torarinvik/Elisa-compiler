# A local ErrorSet is a lexical name candidate and wins over an imported ordinary alias.
module Provider:
    public:
        type Fault = i64

module Consumer:
    error Fault:
        Failed

    def forward[errorset Fault](callback: fn() -> i64 error[Fault]) -> i64 error[Fault]:
        return try callback()

from Provider import Fault

def main() -> i64:
    return 0
