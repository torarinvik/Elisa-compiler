# Packed enum identity includes the declaring module. These stores deliberately
# use the same enum name with different tag layouts, so picking the first row is
# an ABI and correctness error rather than a harmless lookup mismatch.

module Alpha:
    packed enum Result:
        Ok(value: i64)
        Empty(other: i64)

    def read(owner: Arena) -> i64:
        store: Alpha::Result.Store[Local] = Alpha::Result.Store(owner)
        result: mutable i64 = 0
        in store:
            n: Alpha::Result = new Alpha::Result.Ok(value: 11)
            result <- match n:
                Alpha::Result.Ok(v): v
                Alpha::Result.Empty(v): v
        return result

module Beta:
    packed enum Result:
        Failed(other: i64)
        Ok(value: i64)

    def read(owner: Arena) -> i64:
        store: Beta::Result.Store[Local] = Beta::Result.Store(owner)
        result: mutable i64 = 0
        in store:
            n: Beta::Result = new Beta::Result.Ok(value: 22)
            result <- match n:
                Beta::Result.Failed(v): v
                Beta::Result.Ok(v): v
        return result

def main() -> i64:
    region r(4096):
        return 0 if Alpha::read(r) == 11 and Beta::read(r) == 22 else 1
