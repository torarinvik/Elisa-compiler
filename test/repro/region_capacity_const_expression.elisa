# Explicit region capacities are compile-time integer expressions. The source span is
# intentionally not a single decimal literal: this guards named constants, precedence,
# and parentheses at the Stage1 block-lowering boundary.
const BASE_REGION_WORDS: i64 = 1024

module Limits:
    const EXTRA_REGION_WORDS: i64 = 512

def named_capacity() -> i64:
    region named(BASE_REGION_WORDS * 2):
        return 17

def qualified_capacity() -> i64:
    region qualified((Limits::EXTRA_REGION_WORDS + 512) * 2):
        return 25

def main() -> i64:
    return named_capacity() + qualified_capacity()
