# Repeated selections for one family are merged by Elisa Core's error-set resolver.
module First:
    public:
        error Fault:
            Good
            Other
            Missing

module API:
    public:
        extern repeated() -> i64 error[First::Fault{Good}, First::Fault{Other}]

        def same_subset() -> i64 error[First::Fault{Good, Other}]:
            return try repeated()

        def full_family() -> i64 error[First::Fault]:
            return try repeated()

        def missing_variant() -> i64 error[First::Fault{Good}]:
            return try repeated()

def main() -> i64:
    return 0
