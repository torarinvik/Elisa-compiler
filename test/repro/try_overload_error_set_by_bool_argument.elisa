# Intended overload behavior: bool selects Second::Fault, so this destination is too narrow.
module First:
    public:
        error Fault:
            Bad

module Second:
    public:
        error Fault:
            Other

module API:
    def choose(value: i64) -> i64 error[First::Fault]:
        return 1

    def choose(value: bool) -> i64 error[Second::Fault]:
        raise Second::Fault.Other

    def mismatched_bool_destination(value: bool) -> i64 error[First::Fault]:
        return try choose(value)

def main() -> i64:
    return 0
