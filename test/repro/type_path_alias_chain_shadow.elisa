module RootProvider:
    module RootOnly:
        struct Item:
            value: i64
module LocalProvider:
    module LocalOnly:
        module Inner:
            struct Item:
                value: i64
        struct Item:
            value: i64
using RootProvider as Choice
module Scope:
    using LocalProvider as Choice
    using Choice::LocalOnly as Selected
    def local(value: Selected::Inner.Item) -> i64:
        return 0
