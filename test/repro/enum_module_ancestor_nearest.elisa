module Right:
    enum Message:
        Some(a: i64, b: i64, c: i64)
module Outer:
    module Right:
        enum Message:
            Some(a: i64, b: i64)
    module Worker:
        module Right:
            enum Message:
                Empty
                Some(value: i64)
        def answer() -> i64:
            message: Right::Message = Right::Message.Some(42)
            match message:
                Right::Message.Some(value):
                    return value
                Right::Message.Empty:
                    return 0
            return -1
def main() -> i64:
    return Outer::Worker::answer()
