struct ScalarStorage[Element]:
    value: i64

struct ScalarCell[Payload]:
    slot: ScalarStorage[Payload]

def empty_cell[T]() -> ScalarCell[T]:
    cell: ScalarCell[T] = zeroed
    return move cell

def main() -> i64:
    cell: ScalarCell[i32] = empty_cell[i32]()
    return 42 if cell.slot.value == 0 else 1
