# The public import is selected. The same-signature private import in the inactive
# static-else arm must not survive into private call visibility checking. Defining the
# condition in sibling static arms also checks that PMA does not use an unselected
# same-scope const row to guess the later import branch.
static if true:
    const USE_PUBLIC_IMPORT: bool = true
static else:
    const USE_PUBLIC_IMPORT: bool = false

module PrivateProvider:
    private:
        def pick(value: bool) -> i64:
            return 1

module PublicProvider:
    public:
        def pick(value: bool) -> i64:
            return 2

module Flags:
    public:
        const ENABLED: bool = true

module PrivateCharProvider:
    private:
        def choose_char(value: bool) -> i64:
            return 3

module PublicCharProvider:
    public:
        def choose_char(value: bool) -> i64:
            return 4

module PrivateQualifiedProvider:
    private:
        def choose_qualified(value: bool) -> i64:
            return 5

module PublicQualifiedProvider:
    public:
        def choose_qualified(value: bool) -> i64:
            return 6

static if USE_PUBLIC_IMPORT:
    from PublicProvider import pick
static else:
    from PrivateProvider import pick

static if 'A' == 65:
    from PublicCharProvider import choose_char
static else:
    from PrivateCharProvider import choose_char

static if Flags::ENABLED:
    from PublicQualifiedProvider import choose_qualified
static else:
    from PrivateQualifiedProvider import choose_qualified

def main() -> i64:
    return pick(true) + choose_char(true) + choose_qualified(true)
