# The public import is selected. The same-signature private import in the inactive
# static-else arm must not survive into private call visibility checking. Defining the
# condition in sibling static arms also checks that PMA does not use an unselected
# same-scope const row to guess the later import branch.
static if true:
    const USE_PUBLIC_IMPORT: bool = true
static else:
    const USE_PUBLIC_IMPORT: bool = false

module PrivateProvider:
    private:
        def pick(value: bool) -> i64:
            return 1

module PublicProvider:
    public:
        def pick(value: bool) -> i64:
            return 2

static if USE_PUBLIC_IMPORT:
    from PublicProvider import pick
static else:
    from PrivateProvider import pick

def main() -> i64:
    return pick(true)
