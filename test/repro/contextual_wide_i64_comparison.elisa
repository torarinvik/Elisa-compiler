# A suffixless wide integer beside a module-owned mutable i64 field takes the
# field's value type; it must not narrow through the default `int` first.
module Marble:
    struct Run:
        value: mutable i64

    def below_i64_limit(run: mutable Run&) -> i64:
        if run.value < 9223372036854775806:
            return 42
        return 1
