# A compound and plain write through a generic reference-returning call. This keeps the
# backend path generic: the callee is an ordinary Elisa function, not a translator intrinsic.
def pointer[T](value: mutable T&) -> mutable T&:
    return value

def main() -> i64:
    value: mutable i64 = 37
    pointer(&value)[0] += 5
    if value != 42:
        return 1
    pointer(&value)[0] <- 40
    return value + 2
