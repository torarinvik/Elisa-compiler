include "../../elisacore_std/elisacore_runtime.elisa"
include "../../elisacore_std/collections.elisa"

struct Entry[V]:
    value: mutable V

struct Box[V]:
    entries: mutable Entry[V][4]

impl[V] Index for Box[V]:
    type Key = i64
    type Elem = Entry[V]

    def __index__[@r](self: mutable Box[V]& @r, index: i64) -> Entry[V]& @r:
        return &self.entries[index]

def main() -> i64:
    box: mutable Box[i64] = zeroed
    box[1].value <- 42
    return 0 if box[1].value == 42 else 1
