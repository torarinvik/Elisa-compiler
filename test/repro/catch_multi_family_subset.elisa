module First:
    error Fault:
        AllowedFirst
        ForbiddenFirst

module Second:
    error Fault:
        AllowedSecond
        ForbiddenSecond

module API:
    extern restricted() -> i64 error[First::Fault{AllowedFirst}, Second::Fault{AllowedSecond}]

    def wrong_subset_arm() -> i64:
        catch restricted():
            value: 0
            First::Fault.AllowedFirst: 1
            First::Fault.ForbiddenFirst: 2
            Second::Fault.AllowedSecond: 3
        return 0
