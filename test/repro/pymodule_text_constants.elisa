# Text and byte Python-module constants should import as native Python values.
type GreetingText = cstr
type LabelText = sview
type ByteBlob = darray[u8]

const GREETING: GreetingText = "hello\nworld"
const LABEL: LabelText = "label\0tail"
const BYTES: ByteBlob = "A\0B"
const INFERRED_TEXT = "inferred"

export pymodule text_constants:
    const greeting = GREETING
    const label = LABEL
    const bytes = BYTES
    const inferred = INFERRED_TEXT
