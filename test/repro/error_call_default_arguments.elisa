error Failure:
    Bad

def defaulted(seed: i64, extra: i64 = 7) -> i64 error[Failure]:
    raise Failure.Bad if seed < 0
    return seed + extra

def via_try() -> i64 error[Failure]:
    return try defaulted(5)

def via_catch() -> i64:
    return catch defaulted(5):
        value:
            value
        error failure:
            99

def main() -> i64:
    catch via_try():
        value:
            return 0 if value == 12 and via_catch() == 12 else 1
        error failure:
            return 2
