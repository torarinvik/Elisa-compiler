# A root wildcard remains visible inside a nested caller when no nearer target collides.
module OuterApi:
    public:
        error OuterFault:
            Failed

        def source() -> i64 error[OuterApi::OuterFault]:
            return 1

        def wrap(value: i64, callback: fn() -> i64 error[OuterApi::OuterFault]) -> i64 error[OuterApi::OuterFault]:
            return 2

module Consumer:
    public:
        def caller(value: i64) -> i64 error[OuterApi::OuterFault]:
            return wrap(value: value, callback: OuterApi::source)

    module Deep:
        public:
            def caller(value: i64) -> i64 error[OuterApi::OuterFault]:
                return wrap(value: value, callback: OuterApi::source)

using OuterApi

def main() -> i64:
    return 0
