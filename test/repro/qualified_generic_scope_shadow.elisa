module Ints:
    def put(value: i64) -> i64:
        return value + 1

    def get[T](value: T) -> i64:
        return 42

    def pair[A, B](first: A, second: B) -> i64:
        return 42

def put[T](value: T) -> i64:
    return 99

def get[T](value: T) -> i64:
    return 99

def pair[A, B](first: A, second: B) -> i64:
    return 99

def main() -> i64:
    inferred: i64 = Ints::get(1)
    explicit_one: i64 = Ints::get[i64](1)
    explicit_pair: i64 = Ints::pair[i64, i64](1, 2)
    return Ints::put(41) + inferred + explicit_one + explicit_pair
