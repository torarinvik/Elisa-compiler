struct ScopedRow:
    value: i64

def branch_restore(rows: darray[ScopedRow]&, choice: bool) -> ScopedRow can[Memory.Allocate, Abort.Panic]:
    if choice:
        rows: darray[i64] = [9]
        return ScopedRow{value: rows[0]}
    return rows[0]

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    values: darray[ScopedRow] = [ScopedRow{value: 3}]
    first: ScopedRow = branch_restore(&values, false)
    second: ScopedRow = branch_restore(&values, true)
    return 1 if first.value != 3 or second.value != 9
    return 0
