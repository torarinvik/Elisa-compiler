# Single-field payload errors become ElisaError(payload=...) at the Python boundary.
error PayloadError:
    Bad(code: i64)

error BoolPayloadError:
    Bad(flag: bool)

error FloatPayloadError:
    Bad(value: f64)

error DictPayloadError:
    Bad(code: i64)

error RefPayloadError:
    Bad(code: i64)



def fail_with_payload(code: i64) -> i64 error[PayloadError]:
    raise PayloadError.Bad(code)

def maybe_fail_with_payload(code: i64) -> i64 error[PayloadError]:
    raise PayloadError.Bad(code) if code < 0
    return code

def fail_with_bool_payload(flag: bool) -> void error[BoolPayloadError]:
    raise BoolPayloadError.Bad(flag)

def fail_with_float_payload(value: f64) -> void error[FloatPayloadError]:
    raise FloatPayloadError.Bad(value)

def fail_with_dict_payload(values: dict[i64, i64]) -> i64 error[DictPayloadError]:
    raise DictPayloadError.Bad(values.count.i64())

def fail_with_ref_payload(values: darray[i64]&) -> i64 error[RefPayloadError]:
    raise RefPayloadError.Bad(values.count.i64())


export pymodule payload_errors:
    fn fail = fail_with_payload
    fn maybe = maybe_fail_with_payload
    fn fail_bool = fail_with_bool_payload
    fn fail_float = fail_with_float_payload
    fn fail_dict = fail_with_dict_payload
    fn fail_ref = fail_with_ref_payload
