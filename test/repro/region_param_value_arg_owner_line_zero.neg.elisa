# A caller's own line-zero region parameter binds the callee's matching @r.
#line 0 region-put.elisa
def put[@r](value: i64& @r) -> void:
    pass

#line 0 bound-caller.elisa
def good[@r](value: i64) -> void:
    put(value)

# A bare region statement binds through the remainder of its function. The row's
# offset is the region token, not the function declaration offset.
#line 0 local-region-caller.elisa
def local_region(value: i64) -> void:
    region r(128)
    put(value)
