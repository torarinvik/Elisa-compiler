# Core receiver ranking keeps a concrete defaulted candidate even when the call
# has too many positional arguments; EWR must preserve its error family.
module Provider:
    public:
        error ConcreteFault:
            Concrete

        error GenericFault:
            Generic

        def select(value: i64, marker: i64 = 0) -> i64 error[Provider::ConcreteFault]:
            return value + marker

        def select[T](value: T, first: i64, second: i64) -> i64 error[Provider::GenericFault]:
            return 2

from Provider import select

module Consumer:
    public:
        error Expected:
            Rejected

        def wrapper(value: i64) -> i64 error[Consumer::Expected]:
            return select(value, 3, 4)

def main() -> i64:
    return 0
