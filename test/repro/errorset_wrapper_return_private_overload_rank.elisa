# Core ranks registered private overloads before diagnosing the access violation.
module Provider:
    public:
        error GenericFault:
            Generic

        error ConcreteFault:
            Concrete

        def choose[T](value: T) -> i64 error[Provider::GenericFault]:
            return 1

        def choose_infallible[T](value: T) -> i64 error[Provider::GenericFault]:
            return 5

    private:
        def choose(value: i64) -> i64 error[Provider::ConcreteFault]:
            return 2

        def choose_infallible(value: i64) -> i64:
            return 6

        def same_module(value: i64) -> i64 error[Provider::GenericFault]:
            return choose(value)

module BroadProvider:
    public:
        error PublicFault:
            Public

        error PrivateFault:
            Private

        def prefer(value: i64) -> i64 error[BroadProvider::PublicFault]:
            return 3

    private:
        def prefer[T](value: T) -> i64 error[BroadProvider::PrivateFault]:
            return 4

from Provider import choose
from Provider import choose_infallible
from BroadProvider import prefer

module Consumer:
    public:
        error Expected:
            Expected

        def hidden_winner(value: i64) -> i64 error[Consumer::Expected]:
            return choose(value)

        def hidden_infallible_winner(value: i64) -> i64 error[Consumer::Expected]:
            return choose_infallible(value)

        def public_winner(value: i64) -> i64 error[Consumer::Expected]:
            return prefer(value)

        def private_incompatible_fallible_does_not_block_public_generic(value: bool) -> i64 error[Consumer::Expected]:
            return choose(value)

        def private_incompatible_infallible_does_not_block_public_generic(value: bool) -> i64 error[Consumer::Expected]:
            return choose_infallible(value)

def main() -> i64:
    return 0
