# Qualified pymodule targets select module-owned functions and constants without wrappers.
module Math:
    public:
        def add(a: i64, b: i64) -> i64:
            return a + b
        const VERSION: i64 = 7

module Other:
    public:
        def add(a: i64, b: i64) -> i64:
            return a - b

export pymodule qualified_targets:
    fn add = Math::add
    const version = Math::VERSION
