# A module member calling its own sibling by a name a STDLIB GENERIC also uses.
#
# `add` collides with `add[T](items: mutable Flags[T]&, value: T)` from
# collections.elisa. The generic dispatch ran BEFORE the enclosing-module scan,
# so the call was emitted as `add__i64` -- and it TYPE-CHECKED, so the program
# compiled clean and returned 0: the stdlib call left `s.items` untouched.
#
# A silent wrong answer, which is worse than the hard error stage0 gave for the
# same program before its own fix. It survived a session because the repro was
# verified by COMPILING it, not by running it.
#
# Exits 7.

include "../../elisacore_std/elisacore_runtime.elisa"

module Box:
    struct Sack:
        items: mutable darray[i64]

    def add(s: mutable Sack&, v: i64):
        can Memory.Allocate, Abort.Panic:
            s.items.push(v)

    def fill(s: mutable Sack&):
        can Memory.Allocate, Abort.Panic:
            add(s, 7)

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        region w(64 * 1024)
        out: mutable i64 = 0
        in w:
            s: mutable Box::Sack = Box::Sack{items: []}
            Box::fill(&s)
            out <- get s.items[0] else 0
        destroy w
        return out
