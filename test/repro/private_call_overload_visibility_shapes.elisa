# Parenthesized and explicitly instantiated call targets must share overload-aware
# private visibility handling with ordinary calls.
module Provider:
    public:
        def fetch() -> i64:
            return 4

        def dispatch[T](value: T) -> i64:
            return 1

    private:
        def dispatch(value: i64) -> i64:
            return 2

        def sealed(value: i64) -> i64:
            return 3

module BroadProvider:
    public:
        def prefer(value: i64) -> i64:
            return 5

    private:
        def prefer[T](value: T) -> i64:
            return 6

struct UniqueWidget:
    value: i64

module NamedProvider:
    public:
        def inspect(value: UniqueWidget) -> i64:
            return value.value

    private:
        def inspect[T](value: T) -> i64:
            return 14

module QualifiedNamedProvider:
    struct Widget:
        value: i64

    public:
        def inspect(value: Widget) -> i64:
            return value.value

    private:
        def inspect[T](value: T) -> i64:
            return 15

module LiteralProvider:
    public:
        def choose(value: i64) -> i64:
            return 8

    private:
        def choose[T](value: T) -> i64:
            return 9

module Hidden:
    private:
        extern fetch() -> i64

module WildProvider:
    public:
        def retrieve() -> i64:
            return 7

module InactivePrivateProvider:
    private:
        def pick() -> i64:
            return 1

module ActivePublicProvider:
    public:
        def pick() -> i64:
            return 2

module StaticPrivateBranchProvider:
    static if false:
        private:
            def choose() -> i64:
                return 3
    static else:
        public:
            def choose() -> i64:
                return 4

module RootRankProvider:
    public:
        # This declaration makes the imported name an overload set, but cannot
        # accept the one-argument call below.
        def ranked[T](value: T, marker: bool) -> i64:
            return 10

    private:
        def ranked[U](value: U) -> i64:
            return 11

module LocalRankProvider:
    public:
        def locally_ranked[T](value: T, marker: bool) -> i64:
            return 12

    private:
        def locally_ranked[U](value: U) -> i64:
            return 13

module HiddenWild:
    private:
        extern retrieve() -> i64

static if false:
    from InactivePrivateProvider import pick
static else:
    from ActivePublicProvider import pick

using Provider::fetch
using Provider::dispatch
using WildProvider
from RootRankProvider import ranked

def ranked(value: i64) -> i64:
    return value

module Consumer:
    struct Widget:
        value: i64

    using Hidden
    using HiddenWild
    from LocalRankProvider import locally_ranked

    public:
        def locally_ranked(value: i64) -> i64:
            return value

        def root_sibling_wins(value: i64) -> i64:
            return ranked(value)

        def local_sibling_wins(value: i64) -> i64:
            return locally_ranked(value)

        def wrap(callback: fn() -> i64) -> i64:
            return callback()

        def parenthesized_public_winner(value: bool) -> i64:
            return (Provider::dispatch)(value)

        def explicit_generic_public_winner(value: bool) -> i64:
            return Provider::dispatch[bool](value)

        def selective_import_public_winner(value: bool) -> i64:
            return dispatch(value)

        def explicit_generic_selective_winner(value: bool) -> i64:
            return dispatch[bool](value)

        def private_only_incompatible(value: bool) -> i64:
            return Provider::sealed(value)

        def public_concrete_over_private_generic(value: i64) -> i64:
            return BroadProvider::prefer(value)

        def public_named_concrete_over_private_generic(value: UniqueWidget) -> i64:
            return NamedProvider::inspect(value)

        def same_spelling_different_modules_private_generic_winner(value: Widget) -> i64:
            return QualifiedNamedProvider::inspect(value)

        def public_concrete_literal_winner() -> i64:
            return LiteralProvider::choose(7)

        def public_selective_function_value() -> i64:
            return wrap(fetch)

        def public_wildcard_function_value() -> i64:
            return wrap(retrieve)

        def inactive_branch_private_import_does_not_shadow_public() -> i64:
            return pick()

def inactive_branch_private_declaration_does_not_hide_public() -> i64:
    return StaticPrivateBranchProvider::choose()

def main() -> i64:
    return 0
