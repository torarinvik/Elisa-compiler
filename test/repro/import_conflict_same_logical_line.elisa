# Two physical imports can carry the same logical line after #line resets.
module FirstProvider:
    public:
        def choose() -> i64:
            return 1

module SecondProvider:
    public:
        def choose() -> i64:
            return 2

#line 400 imports.elisa
from FirstProvider import choose
#line 400 imports.elisa
from SecondProvider import choose

def main() -> i64:
    return choose()
