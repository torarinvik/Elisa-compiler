# Catch must resolve an alias from the selected static arm, even when the later
# inactive arm reuses the same alias spelling.
error Fault:
    Missing

module ActiveProvider:
    public:
        error Fault:
            Expected
            Missing
        extern load() -> i64 error[ActiveProvider::Fault]

module InactiveProvider:
    public:
        error Fault:
            Expected
            WrongOnly
        extern load() -> i64 error[InactiveProvider::Fault]

module EmptyFamilyProvider:
    public:
        extern load() -> i64 error[EmptyFamilyProvider::Fault]

module Provider:
    public:
        error Fault:
            RootOnly

module RelativeParent:
    module Provider:
        public:
            error Fault:
                Expected
                Missing
    module Consumer:
        extern load() -> i64 error[Provider::Fault]

        def relative_family_path_incomplete() -> i64:
            catch load():
                value: 0
                Provider::Fault.Expected: 1
            return 0

module EmptyScope:
    module Provider:
        error Fault:
    module Consumer:
        extern load() -> i64 error[Provider::Fault]

        def relative_empty_family_does_not_select_root_provider() -> i64:
            catch load():
                value: 0
            return 0

const USE_ACTIVE_PROVIDER: bool = true

using ActiveProvider as DirectWins
using ActiveProvider as ParentWins

static if USE_ACTIVE_PROVIDER:
    using InactiveProvider as DirectWins

static if USE_ACTIVE_PROVIDER:
    using ActiveProvider as Selected
static else:
    using InactiveProvider as Selected

static if UNKNOWN_PROVIDER_CHOICE:
    using InactiveProvider as Later
static else:
    using InactiveProvider as Later
using ActiveProvider as Later

module NestedAliasInstaller:
    static if UNKNOWN_PROVIDER_CHOICE:
        using InactiveProvider as ParentWins

static if USE_ACTIVE_PROVIDER:
    module NestedBranchAlias:
        using InactiveProvider as BranchContextWins
    using ActiveProvider as BranchContextWins

static if USE_ACTIVE_PROVIDER:
    using ActiveProvider as SeparateRootFirstWins
static if USE_ACTIVE_PROVIDER:
    using InactiveProvider as SeparateRootFirstWins

# An unresolved branch candidate and a known-active branch candidate are in separate
# roots, so source offset alone cannot establish the analyzer-wide winner.
static if UNKNOWN_PROVIDER_CHOICE:
    using InactiveProvider as UnknownBranchWinner
static if USE_ACTIVE_PROVIDER:
    using ActiveProvider as UnknownBranchWinner

extern selected_provider_load() -> i64 error[Selected::Fault]

def alias_incomplete() -> i64:
    catch Selected::load():
        value: 0
        ActiveProvider::Fault.Expected: 1
    return 0

def later_alias_incomplete() -> i64:
    catch Later::load():
        value: 0
        ActiveProvider::Fault.Expected: 1
    return 0

def selected_family_incomplete() -> i64:
    catch selected_provider_load():
        value: 0
        ActiveProvider::Fault.Expected: 1
    return 0

def direct_alias_precedes_branch() -> i64:
    catch DirectWins::load():
        value: 0
        ActiveProvider::Fault.Expected: 1
    return 0

def parent_direct_alias_precedes_nested_branch() -> i64:
    catch ParentWins::load():
        value: 0
        ActiveProvider::Fault.Expected: 1
    return 0

def parent_branch_block_precedes_nested_module() -> i64:
    catch BranchContextWins::load():
        value: 0
        ActiveProvider::Fault.Expected: 1
    return 0

def separate_active_branch_roots_select_first_alias() -> i64:
    catch SeparateRootFirstWins::load():
        value: 0
        ActiveProvider::Fault.Expected: 1
    return 0

def unresolved_branch_does_not_guess_alias_winner() -> i64:
    catch UnknownBranchWinner::load():
        value: 0
        ActiveProvider::Fault.Expected: 1
    return 0

# A qualified miss must not fall back to the root-level Fault family.
def qualified_family_miss_does_not_select_root_fault() -> i64:
    catch EmptyFamilyProvider::load():
        value: 0
    return 0

def main() -> i64:
    return 0

error SubsetFault:
    Allowed
    Excluded

const USE_BRANCH_ERROR_SET: bool = true
static if USE_BRANCH_ERROR_SET:
    error BranchFault:
        Expected
        Missing
static else:
    error BranchFault:
        InactiveOnly

extern branch_error_set() -> i64 error[BranchFault]

def inactive_error_set_variant_does_not_join_family() -> i64:
    catch branch_error_set():
        value: 0
        BranchFault.Expected: 1
    return 0

const USE_BRANCH_SUBSET: bool = true
static if USE_BRANCH_SUBSET:
    error BranchSubsetFault:
        Allowed
static else:
    error BranchSubsetFault:
        Allowed
        InactiveOnly

extern restricted_branch_subset() -> i64 error[BranchSubsetFault{Allowed}]

def static_subset_deduplicates_active_variant() -> i64:
    catch restricted_branch_subset():
        value: 0
        BranchSubsetFault.Allowed: 1
    return 0

#line 0 catch-line-zero-subset.elisa
extern restricted_subset() -> i64 error[SubsetFault{Allowed}]

def line_zero_subset_is_exhaustive() -> i64:
    catch restricted_subset():
        value: 0
        SubsetFault.Allowed: 1
    return 0

# ForeignEnum is shared across the file, even when its first extern-enum producer
# sits in an inactive static branch. Its generated family must not inherit that branch.
const DISABLE_FOREIGN_ENUM_SOURCE: bool = false
static if DISABLE_FOREIGN_ENUM_SOURCE:
    extern enum DormantDeviceState of i32:
        Off = 0
        On = 1
extern enum ActiveDeviceState of i32:
    Off = 0
    On = 1

extern foreign_enum_source() -> i64 error[ForeignEnum]

def generated_foreign_enum_family_remains_known() -> i64:
    catch foreign_enum_source():
        value: 0
    return 0
