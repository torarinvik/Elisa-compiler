# Growing the tail consumes only the delta, including at exact capacity.
include "../../elisacore_std/arena.elisa"

module ArenaTailCapacityRegression:
    private:
        const CAPACITY_SLOTS: usize = 16
        const INITIAL_SLOTS: usize = 10
        const GROWN_SLOTS: usize = 12
        const FIRST_REGION: usize = 0
        const SUCCESS_STATUS: i64 = 0
        const FAILURE_STATUS: i64 = 1

        def check(strategy: int) -> bool:
            backing: mutable heap Region& = new_region_backend(CAPACITY_SLOTS, strategy)
            arena: mutable Arena = Arena{begin: backing, end: backing, end_index: FIRST_REGION, strategy: strategy}
            initial: mutable heap void& = arena_alloc(&arena, INITIAL_SLOTS * size_of(uintptr))
            grown: mutable heap void& = arena_realloc(&arena, initial, INITIAL_SLOTS * size_of(uintptr), GROWN_SLOTS * size_of(uintptr))
            partial_correct: bool = initial.cast[uintptr] == grown.cast[uintptr] and backing.count == GROWN_SLOTS
            full: mutable heap void& = arena_realloc(&arena, grown, GROWN_SLOTS * size_of(uintptr), CAPACITY_SLOTS * size_of(uintptr))
            correct: bool = partial_correct and initial.cast[uintptr] == full.cast[uintptr] and backing.count == CAPACITY_SLOTS
            arena_free(&arena)
            return correct

    public:
        def run() -> i64:
            return FAILURE_STATUS if not check(ARENA_STRATEGY_FIXED)
            return FAILURE_STATUS if not check(ARENA_STRATEGY_RESERVE_COMMIT)
            return FAILURE_STATUS if not check(ARENA_STRATEGY_CHAINED)
            return SUCCESS_STATUS

def main() -> i64:
    return ArenaTailCapacityRegression::run()
