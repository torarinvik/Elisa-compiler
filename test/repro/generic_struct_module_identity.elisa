module Wrong:
    struct Box[T]:
        padding: mutable i64
        item: mutable T

module Right:
    struct Box[T]:
        item: mutable T

using Right as R

def main() -> i64:
    left: mutable Wrong::Box[i64] = zeroed
    right: mutable R::Box[i64] = zeroed
    left.padding <- 11
    left.item <- 31
    right.item <- 42
    return 42 if left.padding == 11 and left.item == 31 and right.item == 42 else 1
