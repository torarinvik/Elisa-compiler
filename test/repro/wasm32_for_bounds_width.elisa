struct MixedBounds:
    low: i64
    high: usize

def range_width_score() -> i64:
    bounds: MixedBounds = MixedBounds{low: 1, high: 4}
    score: mutable i64 = 0
    for i in bounds.low..<bounds.high:
        score <- score + i
    return score

export fn wasm32_for_bounds_width() -> i64 = range_width_score
