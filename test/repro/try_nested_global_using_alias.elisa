error E:
    Expected

# Core registers module aliases program-wide, including aliases declared inside a
# nested module. The root-level call therefore resolves Shared::load to AliasHome.
module AliasHome:
    public:
        module Provider:
            public:
                def load() -> i64 error[E]:
                    return 1

    using Provider as Shared

def good() -> i64 error[E]:
    return try Shared::load()
