# The conditional arms are exclusive, but the unconditional import competes with either.
module FirstProvider:
    public:
        def choose() -> i64:
            return 1

module SecondProvider:
    public:
        def choose() -> i64:
            return 2

module UnconditionalProvider:
    public:
        def choose() -> i64:
            return 3

static if ELISA_TARGET_OS_WASI:
    from FirstProvider import choose
static else:
    from SecondProvider import choose
from UnconditionalProvider import choose

def main() -> i64:
    return choose()
