struct ProbeShape:
    left: i64
    right: i64
def aggregate_shape_probe(values: darray[ProbeShape], other: mutable ProbeShape&) -> i64: return other.left
def aggregate_shape_probe_two(values: darray[ProbeShape], other: ProbeShape) -> i64: return other.left
def main() -> i64:
    item: mutable ProbeShape = ProbeShape{left: 1, right: 2}
    aggregate_shape_probe([], item)
    return aggregate_shape_probe_two([], item)
