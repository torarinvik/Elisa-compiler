struct Sample:
    score: f64
    ids: darray[i64]
    rows: darray[darray[f64]]
    label: sview
    payload: py::Object

type SampleAlias = Sample
type MaybeSample = SampleAlias?

def sample(found: bool, label: sview, payload: py::Object) -> MaybeSample can[Memory.Allocate]:
    return null if not found
    return Sample{score: 1.25, ids: [2, 0, 0], rows: [[0.1, 0.2, 0.7], []], label: label, payload: payload}

struct Scalar:
    value: i64

def scalar(found: bool) -> Scalar?:
    return null if not found
    return Scalar{value: 7}

error Failure:
    Invalid(code: i64)

error ScalarFailure:
    Invalid

def fallible(value: i64, payload: py::Object) -> MaybeSample error[Failure] can[Memory.Allocate]:
    raise Failure.Invalid(value) if value < 0
    return sample(value > 0, "fallible", payload)

def scalar_fallible(value: i64) -> Scalar? error[ScalarFailure]:
    raise ScalarFailure.Invalid if value < 0
    return scalar(value > 0)

export pymodule nullable_records:
    fn sample
    fn scalar
    fn fallible
    fn scalar_fallible
