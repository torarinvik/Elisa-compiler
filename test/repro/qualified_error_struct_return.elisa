# Qualified fallible calls whose success payload is an aggregate must preserve
# the explicit source arguments alongside the hidden error out slot.

error NetworkError:
    InvalidPayload

struct RequestStatus:
    state: u32
    length: u32

module WasmBrowser::NetworkOperations:
    public:
        def initial(length: u32) -> RequestStatus error[NetworkError]:
            raise NetworkError.InvalidPayload if length == 0
            return RequestStatus{state: 1, length}

def start() -> u32 error[NetworkError]:
    initial: RequestStatus = try WasmBrowser::NetworkOperations::initial(26) else return 0
    return initial.length

def main() -> i64:
    return 42
