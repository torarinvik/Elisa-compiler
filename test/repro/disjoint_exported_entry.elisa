# An exported wrapper can be called by foreign code with aliasing pointers, so an internal
# source call with distinct local arrays cannot justify LLVM noalias on its target.
def update_pair(first: mutable darray[i64]&, second: mutable darray[i64]&) -> void:
    first[0] <- second[0]

export fn public_update(first: mutable darray[i64]&, second: mutable darray[i64]&) -> void = update_pair

def main() -> i64:
    left: mutable darray[i64] = [1]
    right: mutable darray[i64] = [2]
    update_pair(&left, &right)
    return 0
