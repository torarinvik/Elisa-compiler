include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"

def main() -> i64 can[Abort.Panic]:
    arena: mutable Arena = zeroed
    mark: ArenaMark = arena_snapshot(&arena)
    view: sview @arena = sview("stable", 0, -1)
    arena_rewind(&arena, mark)
    return view[0].i64()
