# Automatic Python str conversion smoke fixture.
def echo_cstr(value: cstr) -> cstr:
    return value

def echo_sview(value: sview) -> sview:
    return value

def accept_cstr(value: cstr) -> i64:
    return 1

def accept_sview(value: sview) -> i64:
    return 1

export pymodule strings:
    fn cstr = echo_cstr
    fn sview = echo_sview
    fn accept_cstr
    fn accept_sview
