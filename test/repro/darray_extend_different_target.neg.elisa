include "../../elisacore_std/elisacore_runtime.elisa"

struct Buffer:
    rows: mutable darray[i64]

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    left: mutable Buffer = Buffer{rows: []}
    right: mutable Buffer = Buffer{rows: [1]}
    values: darray[i64] = [2]
    left.rows <- right.rows.extend(values)
    return 0
