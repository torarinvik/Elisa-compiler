struct Point:
    x: i64
    label: sview

struct NestedCatalog:
    values: dict[i64, dict[cstr, Point]]

def roundtrip(values: dict[i64, dict[cstr, Point]]) -> dict[i64, dict[cstr, Point]]:
    return values

def roundtrip_catalog(catalog: NestedCatalog) -> NestedCatalog:
    return catalog

def roundtrip_rows(values: darray[dict[i64, dict[cstr, Point]]]) -> darray[dict[i64, dict[cstr, Point]]]:
    return values

export pymodule nested_dict_struct_values:
    fn roundtrip
    fn roundtrip_catalog
    fn roundtrip_rows
