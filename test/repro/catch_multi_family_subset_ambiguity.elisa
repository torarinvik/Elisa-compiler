module First:
    error Fault:
        Bad

module Second:
    error Fault:
        Bad
        Good

module API:
    extern restricted() -> i64 error[First::Fault{Bad}, Second::Fault{Good}]

    def included_duplicate_is_unambiguous() -> i64:
        catch restricted():
            value: 0
            Wrong::Fault.Bad: 1
            Second::Fault.Good: 2
        return 0
