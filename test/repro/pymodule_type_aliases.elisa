# Probe transparent type aliases at the Python boundary.
struct AliasPoint:
    label: sview

type UserId = i64
type ByteCount = u8
type DisplayName = sview
type MaybeUserId = i64?
type UserIdList = darray[UserId]
type UserIdMap = dict[cstr, UserId]
type AliasPointList = darray[AliasPoint]
type AliasNestedPointList = darray[darray[AliasPoint]]
type AliasPointMap = dict[cstr, AliasPoint]

def identity_id(value: UserId) -> UserId:
    return value

def identity_count(value: ByteCount) -> ByteCount:
    return value

def identity_name(value: DisplayName) -> DisplayName:
    return value

def identity_optional(value: MaybeUserId) -> MaybeUserId:
    return value

def identity_ids(values: UserIdList) -> UserIdList:
    return values

def identity_map(values: UserIdMap) -> UserIdMap:
    return values

def fail_after_alias_list(values: AliasPointList, narrow_values: darray[u8]) -> u8:
    return 0

def fail_after_nested_alias_list(values: AliasNestedPointList, narrow_values: darray[u8]) -> u8:
    return 0

def fail_after_alias_dict(values: AliasPointMap, invalid_values: dict[cstr, i64]) -> u8:
    return 0

export pymodule type_aliases:
    fn identity_id
    fn identity_count
    fn identity_name
    fn identity_optional
    fn identity_ids
    fn identity_map
    fn fail_after_alias_list
    fn fail_after_nested_alias_list
    fn fail_after_alias_dict
