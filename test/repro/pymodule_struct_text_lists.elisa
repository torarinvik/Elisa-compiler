struct TextBundle:
    names: darray[sview]
    labels: darray[cstr]

def count(bundle: TextBundle) -> usize:
    return bundle.names.count + bundle.labels.count

def make(names: darray[sview], labels: darray[cstr]) -> TextBundle:
    return TextBundle{names: names, labels: labels}

export pymodule struct_text_lists:
    fn count
    fn make
