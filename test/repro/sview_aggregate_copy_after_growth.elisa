include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

struct ViewHolder:
    content: sview

struct ViewBundle:
    inner: ViewHolder

def bad() -> i64 can[Memory.Allocate, Abort.Panic]:
    values: mutable darray[u8] = [65.u8()]
    original: ViewHolder = ViewHolder{content: bytes_view(values)}
    wrapped: ViewBundle = ViewBundle{inner: original}
    copied: ViewBundle = wrapped
    values.push(67.u8())
    return sview_at(copied.inner.content, 0.usize()).i64()

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return bad()
