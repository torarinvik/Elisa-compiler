# The inactive alias has the same spelling, but only the static-else provider's
# ErrorSet may contribute to the qualified Try call.
const USE_INACTIVE_PROVIDER: bool = false

module InactiveProvider:
    public:
        error InactiveFault:
            Inactive

        def origin(value: bool) -> i64 error[InactiveProvider::InactiveFault]:
            return 1

module ActiveProvider:
    public:
        error ActiveFault:
            Active

        def origin(value: bool) -> i64 error[ActiveProvider::ActiveFault]:
            return 2

module RootCollision:
    public:
        error RootFault:
            Root

        def origin(value: bool) -> i64 error[RootCollision::RootFault]:
            return 3

module AliasSafeProvider:
    public:
        error SafeFault:
            Safe

        def origin(value: bool) -> i64 error[AliasSafeProvider::SafeFault]:
            return 4

using ActiveProvider as BaseProvider

static if USE_INACTIVE_PROVIDER:
    using InactiveProvider as Selected
static else:
    using BaseProvider as Selected

module AliasInstallerA:
    static if UNKNOWN_ALIAS_TARGET:
        using AliasSafeProvider as RootCollision

module AliasInstallerB:
    static if UNKNOWN_ALIAS_TARGET:
        using AliasSafeProvider as RootCollision

module Consumer:
    public:
        def caller(value: bool) -> i64 error[ActiveProvider::ActiveFault]:
            return try Selected::origin(value)

        def unresolved_alias_cannot_select_root(value: bool) -> i64:
            return try RootCollision::origin(value)

def main() -> i64:
    return 0
