# A function-value parameter shadows the top-level `update_pair`. The indirect call below
# is not evidence that the top-level function's array arguments are disjoint.
def update_pair(first: mutable darray[i64]&, second: mutable darray[i64]&) -> void:
    first[0] <- second[0]

def driver(update_pair: fn(mutable darray[i64]&, mutable darray[i64]&) -> void) -> void:
    values: mutable darray[i64] = [1]
    other: mutable darray[i64] = [2]
    update_pair(&values, &other)

def callback(first: mutable darray[i64]&, second: mutable darray[i64]&) -> void:
    first[0] <- second[0]

def main() -> i64:
    driver(callback)
    return 0
