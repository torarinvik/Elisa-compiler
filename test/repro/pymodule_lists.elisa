# Typed Python-list boundary fixture.
def i64_count(values: darray[i64]) -> usize:
    return values.count

def i8_count(values: darray[i8]) -> usize:
    return values.count

def i64_first(values: darray[i64]) -> i64:
    return values[0] can Unsafe.UncheckedIndex

def f64_echo(values: darray[f64]) -> darray[f64]:
    return values

def i8_echo(values: darray[i8]) -> darray[i8]:
    return values

def u16_echo(values: darray[u16]) -> darray[u16]:
    return values

def bool_echo(values: darray[bool]) -> darray[bool]:
    return values

def f32_echo(values: darray[f32]) -> darray[f32]:
    return values

def bool_first(values: darray[bool]) -> bool:
    return values[0] can Unsafe.UncheckedIndex

def list_and_text(values: darray[i64], text: sview) -> sview:
    return text

def list_and_object(values: darray[i64], value: py::Object) -> py::Object:
    return value

export pymodule lists:
    fn count = i64_count
    fn count_i8 = i8_count
    fn first = i64_first
    fn echo_f64 = f64_echo
    fn echo_i8 = i8_echo
    fn echo_u16 = u16_echo
    fn echo_bool = bool_echo
    fn echo_f32 = f32_echo
    fn first_bool = bool_first
    fn list_and_text
    fn list_and_object
