module Provider:
    public:
        def call(other: i64, ...) -> i64:
            return other

        def target(value: i64) -> i64:
            return value

        def spread(value: i64) -> i64:
            return value

module Consumer:
    public:
        def call(value: i64) -> i64:
            return value

        def target(required: i64) -> i64:
            return required

        def valid(value: i64) -> i64:
            return call(..)

        def missing(value: i64) -> i64:
            return target(..)

        def spread(value: i64, ...) -> i64:
            return value

        def invalid_forward(value: i64) -> i64:
            return spread(..)

def main() -> i64:
    return 0
