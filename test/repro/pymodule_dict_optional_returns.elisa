# Dictionary parameters should compose with value-optional scalar returns.
struct DictBucket[K, T]:
    key: mutable K
    value: mutable T
    state: mutable u8

struct DynDict[K, T]:
    items: mutable DictBucket[K, T]&?
    count: usize
    used: usize
    capacity: usize
    arena: mutable i64

def maybe_count(values: dict[i64, i64]) -> i64?:
    null return if values.count == 0
    return values.count.i64()

def text_from_dict(values: dict[i64, i64]) -> cstr:
    return "ok"

def view_from_dict(values: dict[i64, i64]) -> sview:
    return "ok"

def object_from_dict(values: dict[i64, i64], value: py::Object) -> py::Object:
    return value

def nullable_text_from_dict(values: dict[i64, i64]) -> cstr?:
    null return if values.count == 0
    return "ok"

def list_from_dict(values: dict[i64, i64], items: darray[i64]) -> darray[i64]:
    return items

export pymodule dict_optional_returns:
    fn maybe_count
    fn text_from_dict
    fn view_from_dict
    fn object_from_dict
    fn nullable_text_from_dict
    fn list_from_dict
