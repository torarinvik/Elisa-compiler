include "../../elisacore_std/wasm_component_runtime.elisa"

def check_frame() -> i32:
    can Global{Read,Write}, Unsafe.PointerCast:
        state: mutable WasmComponentArenaState = zeroed
        block: mutable u64[32] = zeroed
        arena_init_stack_block((&state).cast[mutable void&], (&block[0]).cast[mutable void&], 32.usize())
        first: mutable void& = arena_alloc((&state).cast[mutable void&], 16.usize())
        address: uintptr = first.cast[uintptr]
        base: uintptr = (&block[0]).cast[uintptr]
        return 1 if address != base + 8
        arena_free((&state).cast[mutable void&])
        second: mutable void& = arena_alloc((&state).cast[mutable void&], 16.usize())
        next: uintptr = second.cast[uintptr]
        return 2 if next >= base and next < base + 256
        arena_free((&state).cast[mutable void&])
        return 0
export fn check_frame() -> i32 = check_frame

def overflow_frame() -> i32:
    can Global{Read,Write}, Unsafe.PointerCast:
        state: mutable WasmComponentArenaState = zeroed
        block: mutable u64[32] = zeroed
        arena_init_stack_block((&state).cast[mutable void&], (&block[0]).cast[mutable void&], 32.usize())
        _ = arena_alloc((&state).cast[mutable void&], 136.usize())
        return 0
export fn overflow_frame() -> i32 = overflow_frame
