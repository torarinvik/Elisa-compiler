module Ast:
    public:
        enum Node layout(handle: u32):
            pass
        enum Leaf is Node:
            Value(v: i64)
            Other(v: i64)

def run() -> i64:
    can Memory.Allocate, Abort.Panic:
        region owner(65536):
            store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
            in store:
                value: Ast::Node = new Ast::Leaf.Value(v: 42)
                return 1 if not (value is Ast::Leaf.Value)
                return 2 if value is Ast::Leaf.Other
                other: Ast::Node = new Ast::Leaf.Other(v: 7)
                return 3 if other is Ast::Leaf.Value
                return 4 if not (other is Ast::Leaf.Other)
                return 0

def main() -> i64:
    return run()
