# A qualified module function returning an error union must remain a direct
# callable definition when invoked through `try` from top-level code.
error ServiceError:
    Rejected

module Outer::Service:
    public:
        def load() -> i64 error[ServiceError]:
            return 7

def main() -> i64:
    value: i64 = try Outer::Service::load() else 0
    return value
