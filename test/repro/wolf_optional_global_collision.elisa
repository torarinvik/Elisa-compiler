global mutable pixelangle: i16&? = zeroed
global mutable wallheight: i32&? = zeroed
global mutable screenWidth: u32 = zeroed
extern malloc(size: u64) -> mutable void&?

def allocate_buffers() -> void can[Abort.Panic, Global, Unsafe.PointerCast, Unsafe.BufferReinterpret, Unsafe.StaleRef]:
    can Abort.Panic, Global, Unsafe.PointerCast, Unsafe.BufferReinterpret, Unsafe.StaleRef:
        pixelangle <- (malloc((screenWidth * (size_of[i16]).u32()))).cast[mutable i16&?]
        if not pixelangle != null:
            wallheight <- (malloc((screenWidth * (size_of[i32]).u32()))).cast[mutable i32&?]

def main() -> i64:
    allocate_buffers()
    return 0
