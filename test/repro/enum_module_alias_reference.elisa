struct Cell:
    value: mutable i64

enum Nullable:
    Link(value: Cell&?)
    Empty
enum Direct:
    Link(value: Cell&)
    Empty
enum Pair:
    Link(extra: i64, value: Cell&?)
    Empty

def nullable_score(message: Nullable) -> i64:
    match message:
        Nullable.Link(pointer):
            if pointer is live:
                return live.value
            return 0
        Nullable.Empty:
            return -1
    return -2

def direct_score(message: Direct) -> i64:
    match message:
        Direct.Link(pointer):
            return pointer.value
        Direct.Empty:
            return -1
    return -2

def pair_score(message: Pair) -> i64:
    match message:
        Pair.Link(extra, pointer):
            if pointer is live:
                return extra + live.value
            return extra
        Pair.Empty:
            return -1
    return -2

module Aliased:
    type Link = Cell&?
    enum Message:
        With(value: Link)
        Empty
using Aliased as A

struct Carrier:
    pointer: Cell&?
enum Nested:
    Wrap(value: Carrier)
    Empty

def alias_score(message: A::Message) -> i64:
    match message:
        A::Message.With(pointer):
            if pointer is live:
                return live.value
            return 0
        A::Message.Empty:
            return -1
    return -2

def nested_score(message: Nested) -> i64:
    match message:
        Nested.Wrap(carrier):
            if carrier.pointer is live:
                return live.value
            return 0
        Nested.Empty:
            return -1
    return -2

def main() -> i64:
    cell: mutable Cell = Cell{value: 42}
    absent: Nullable = zeroed
    nullable: Nullable = Nullable.Link(&cell)
    direct: Direct = Direct.Link(&cell)
    pair: Pair = Pair.Link(value: &cell, extra: 7)
    aliased: A::Message = A::Message.With(&cell)
    nested: Nested = Nested.Wrap(Carrier{pointer: &cell})
    if alias_score(aliased) != 42 or nested_score(nested) != 42:
        return 3
    if nullable_score(absent) != 0 or nullable_score(nullable) != 42 or direct_score(direct) != 42 or pair_score(pair) != 49:
        return 1
    cell.value <- 31
    if alias_score(aliased) != 31 or nested_score(nested) != 31:
        return 4
    if nullable_score(nullable) != 31 or direct_score(direct) != 31 or pair_score(pair) != 38:
        return 2
    return 42
