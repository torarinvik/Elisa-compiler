# Capture-listed loops desugar through Expr.Block; the nested-reference check must inspect
# statements inside that expression too, rather than letting this T&& shape reach codegen.
struct Box:
    x: mutable i64

def sink(value: mutable Box&) -> void:
    value.x <- value.x + 1

def wrapper_in_loop(values: darray[usize]&, value: mutable Box&) -> void:
    for item in values |value|:
        sink(&value)
