# Capture-listed loops desugar through Expr.Block; a guarded recursive call adds Unary/If
# expression layers. The checker must traverse the whole shape before codegen.
struct Box:
    x: mutable i64

def walk(values: darray[usize]&, value: mutable Box&, depth: usize) -> bool:
    return false if depth > 16
    for item in values |value|:
        return false if not walk(values, &value, depth + 1)
    return true
