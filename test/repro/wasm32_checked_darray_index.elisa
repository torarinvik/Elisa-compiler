# A checked darray access compares its usize index with the darray header's
# i64 element count. On wasm32 the index is i32 and must be zero-extended only
# for that comparison; the original target-width index remains valid for GEP.
def checked_at(values: darray[i64], pick: i64) -> i64:
    return get values[pick.usize()] else 7
