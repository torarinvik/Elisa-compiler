# Regression: a large source-level aggregate is lowered as `void (ptr sret, ...)`.
# The call instruction itself must be unnamed even though the Elisa expression has a value.
struct LargeResult:
    words: i64[200]

def make_large() -> LargeResult:
    value: LargeResult = zeroed
    value.words[0] <- 7
    return value

def read_large() -> i64:
    value: LargeResult = make_large()
    return value.words[0]

def identity[T](value: T) -> T:
    return value

def read_generic_large() -> i64:
    source: LargeResult = make_large()
    value: LargeResult = identity[LargeResult](source)
    return value.words[0]

def main() -> i64:
    return read_large() + read_generic_large()
