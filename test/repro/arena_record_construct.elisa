# Arena annotations use a dedicated ABI carrier. Literals must still resolve
# fields from the declared runtime struct, both with explicit and empty fields.
include "../../elisacore_std/elisacore_runtime.elisa"

module ArenaRecordConstruction:
    private:
        const EXPECTED_INDEX: usize = 17
        const EMPTY_INDEX: usize = 0
        const SUCCESS_STATUS: i64 = 0
        const FAILURE_STATUS: i64 = 1

    public:
        def verify() -> i64:
            explicit_arena: Arena = Arena{begin: null, end: null, end_index: EXPECTED_INDEX, strategy: ARENA_STRATEGY_CHAINED}
            empty_arena: Arena = Arena{}
            return FAILURE_STATUS if explicit_arena.begin != null or explicit_arena.end != null
            return FAILURE_STATUS if explicit_arena.end_index != EXPECTED_INDEX
            return FAILURE_STATUS if explicit_arena.strategy != ARENA_STRATEGY_CHAINED
            return FAILURE_STATUS if empty_arena.begin != null or empty_arena.end != null
            return FAILURE_STATUS if empty_arena.end_index != EMPTY_INDEX
            return FAILURE_STATUS if empty_arena.strategy != ARENA_STRATEGY_CHAINED
            return SUCCESS_STATUS

def main() -> i64:
    return ArenaRecordConstruction::verify()
