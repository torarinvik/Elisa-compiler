# Positional extras keep the selected variadic callable's family. Core rejects
# named arguments and `..` forwarding for variadic functions after selecting it.
module VariadicProvider:
    public:
        error SelectedFault:
            Selected

        error GenericFault:
            Generic

        def collect(value: i64, ...) -> i64 error[VariadicProvider::SelectedFault]:
            return value

        # The fixed generic candidate matches two positional arguments, but the
        # concrete variadic receiver must outrank it for an i64 first argument.
        def collect[T](value: T, marker: i64) -> i64 error[VariadicProvider::GenericFault]:
            return 2

from VariadicProvider import collect

module Consumer:
    public:
        def positional_extra(value: i64, extra: i64) -> i64 error[VariadicProvider::GenericFault]:
            return collect(value, extra)

        def named_variadic(value: i64) -> i64 error[VariadicProvider::GenericFault]:
            return collect(value: value)

        def forwarded_variadic(value: i64) -> i64 error[VariadicProvider::GenericFault]:
            return collect(..)

def main() -> i64:
    return 0
