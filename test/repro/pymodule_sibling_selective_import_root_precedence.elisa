# Core registers selective imports in a program-wide alias map. ImportSite's Mode is
# therefore a candidate in sibling Consumer before the raw root Mode fallback.
const enum Mode of i64:
    High = 97

module ImportSite:
    module Provider:
        public:
            const enum Mode of i64:
                High = 41
    from Provider import Mode

module Consumer:
    def sibling_import(value: i64 = Mode.High) -> i64:
        return value

export pymodule sibling_selective_import_root_precedence:
    fn sibling_import = Consumer::sibling_import
