include "../../elisacore_std/elisacore_runtime.elisa"

# `[[1, 2], [3, 4]][1][0]` declined. An EARLIER attempt at this returned 2 instead of 3 —
# the FLAT reading of the nested literal — and was reverted; a decline traded for a silent
# wrong answer is strictly worse. Two things were actually missing:
#   1. a literal's shape derived RECURSIVELY from its own elements, since expression_type
#      answers Unmodeled for a literal (it defers to the expected type), so an inner literal
#      had no element type at all;
#   2. an emitter arm for an index whose RECEIVER is itself an index into an inline literal.
#
# The weights make every index pair contribute distinctly, so a flattened read or a swapped
# index changes the answer instead of passing by luck: 3 + 2*8 + 4*32 = 147.
# (Flattened, [1] would be 2 and the whole sum collapses.)
def main() -> i64:
    return [[1, 2], [3, 4]][1][0] + [[1, 2], [3, 4]][0][1] * 8 + [[1, 2], [3, 4]][1][1] * 32
