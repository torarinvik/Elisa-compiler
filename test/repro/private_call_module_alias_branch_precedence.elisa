# Only the definitely-selected private alias should report. A later unconditional
# alias shadows an unknown or inactive alias in the same lexical scope.
module Secret:
    private:
        def hidden() -> i64:
            return 1

module Public:
    public:
        def hidden() -> i64:
            return 2

static if true:
    using Secret as ActivePick

static if false:
    using Secret as InactivePick
using Public as InactivePick

static if UNKNOWN_PICK:
    using Secret as UnknownPick
using Public as UnknownPick

static if UNKNOWN_DUPLICATE_IMPORT:
    using Secret, Secret as UnknownDuplicateAlias

def main() -> i64:
    return ActivePick::hidden() + InactivePick::hidden() + UnknownPick::hidden() + UnknownDuplicateAlias::hidden()
