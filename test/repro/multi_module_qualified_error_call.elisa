# Multiple module-scoped error calls must not make the later caller decline.
error FirstError:
    Failed

error SecondError:
    Failed

module First:
    public:
        def advance() -> i64 error[FirstError]:
            return 1

        def probe() -> i64 error[FirstError]:
            value: i64 = try First::advance()
            return value

module Second:
    public:
        def advance() -> i64 error[SecondError]:
            return 2

        def probe() -> i64 error[SecondError]:
            value: i64 = try Second::advance()
            return value

def main() -> i64:
    first: i64 = try First::probe() else 0
    second: i64 = try Second::probe() else 0
    return first + second
