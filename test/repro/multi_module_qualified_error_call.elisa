# Multiple module-scoped error calls must not make the later caller decline.
error FirstError:
    Failed

error SecondError:
    Failed

enum FirstEvent:
    Start

enum SecondEvent:
    Start

module First::Service:
    public:
        def advance(event: FirstEvent) -> i64 error[FirstError]:
            return 1

        def probe() -> i64 error[FirstError]:
            value: i64 = try First::Service::advance(FirstEvent.Start)
            return value

module Second::Service:
    public:
        def advance(event: SecondEvent) -> i64 error[SecondError]:
            return 2

        def probe() -> i64 error[SecondError]:
            value: i64 = try Second::Service::advance(SecondEvent.Start)
            return value

def main() -> i64:
    first: i64 = try First::Service::probe() else 0
    second: i64 = try Second::Service::probe() else 0
    return first + second
