include "../../elisacore_std/elisacore_runtime.elisa"

enum Lookup:
    Search(sview, sview, usize)
    Done(u32)


def make(value: sview) -> Lookup:
    return Lookup.Search(value, value, 0)


def read(value: Lookup) -> u32:
    match value:
        Lookup.Search(first, second, index):
            return index.u32()
        Lookup.Done(result):
            return result


def main() -> int:
    return read(make("value")).int()
