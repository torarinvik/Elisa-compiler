# Multi-field payload variants map to typed Python dictionaries at the boundary.
error MultiPayloadError:
    Bad(code: i64, detail: sview)
    Other(label: cstr, value: py::Object)

def fail_with_multi_payload(code: i64, detail: sview) -> i64 error[MultiPayloadError]:
    raise MultiPayloadError.Bad(code, detail)

def fail_with_other_payload(label: cstr, value: py::Object) -> i64 error[MultiPayloadError]:
    raise MultiPayloadError.Other(label, value)

export pymodule payload_multi:
    fn fail = fail_with_multi_payload
    fn fail_other = fail_with_other_payload
