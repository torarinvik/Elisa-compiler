# A `trusted E:` block is a grant block like `can E:`, so a function whose body ends in one
# returns the block's tail value. stage0 parses `trusted` as a plain CanStmt and accepts all
# three functions; stage1 promoted only a `can` tail, so `trusted` reported "may fall through
# without returning a value".
def bare_trusted(handle: i64) -> i64:
    trusted Unsafe.PointerCast:
        handle + 1

def trusted_inside_can(handle: i64) -> i64:
    can Abort.Panic:
        return 0 if handle <= 0
        trusted Unsafe.PointerCast:
            handle * 10

def trusted_if_tail(handle: i64) -> i64:
    trusted Unsafe.PointerCast:
        if handle > 2:
            handle
        else:
            100

def main() -> i64:
    can Abort.Panic:
        # 4 + 30 + 100 + 0 = 134
        bare_trusted(3) + trusted_inside_can(3) + trusted_if_tail(1) + trusted_inside_can(-1)
