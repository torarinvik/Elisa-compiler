# A binding introduced by an expression-match arm must not shadow the generic
# parameter after the match expression has ended.
enum Choice:
    Item(i64)
    Empty

def bad[T](value: T, choice: Choice) -> i64:
    selected: i64 = match choice:
        Choice.Item(value): 0
        Choice.Empty: 0
    return value.unknown

def main() -> i64:
    bad(1, Choice.Empty)
