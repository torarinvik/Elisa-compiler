# Valid value catches must emit leading statements before their yielded value.
error Failure:
    Bad

def read_value(fail: bool) -> i64 error[Failure]:
    raise Failure.Bad if fail
    return 42

def select_value(fail: bool) -> i64:
    return catch read_value(fail):
        value:
            _ = value
            7
        error failure:
            _ = failure
            9

def main() -> i64:
    return 0 if select_value(false) == 7 and select_value(true) == 9 else 1
