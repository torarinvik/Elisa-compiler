include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/heap.elisa"

struct Wrapper[@r]:
    value: i64& @r

def main() -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    region scratch(4096):
        pool: mutable RegionPool[Wrapper[scratch]] = region_pool_new(&scratch)
        handle: Pooled[Wrapper[scratch]] = region_pool_acquire(&pool)
        raw: i64& @scratch = new[scratch] 65
        handle.ptr.value as & <- raw
        ptr: mutable heap i64& = handle.ptr.value
        destroy scratch
        return ptr[0]
