# A lambda closing over an AGGREGATE. The env store, the env load and the binding were all
# already type-driven; only the capture FILTER was narrower than the machinery behind it, so a
# lambda that mentioned a struct or an sview in scope declined.
#
# Scalars are captured here too — widening the filter must not disturb them — and the sview
# case pins that a fat value (`{ptr, len}`) survives the round trip through the env — it is
# compared inside the lambda, which reads both of its words.
struct Point:
    x: i64
    y: i64


def apply(f: fn(i64) -> i64, n: i64) -> i64:
    return f(n)


def main() -> i64:
    origin: Point = Point{x: 10, y: 5}
    bump: i64 = 3
    total: i64 = apply(fn(n: i64) => n + origin.x + origin.y + bump, 20)
    # 20 + 10 + 5 + 3 = 38; the sview capture contributes 4 by comparison, not by
    # length (sview_len is not in scope for a bare program).
    label: sview = "abcd"
    with_label: i64 = apply(fn(n: i64) => n + (4 if label == "abcd" else 0), total)
    return with_label
