# The actual resolver must distinguish same-spelled owners across scopes and
# functions. This does not yet claim protocol transition acceptance.
include "../../src/semantic/semantic.elisa"

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    source: u8& = "module Vault:\n    def first(owner: i64) -> i64:\n        if true:\n            owner: bool = false\n            _ = owner\n        return owner\n    def second(owner: i64) -> i64:\n        return owner\n"
    tokens: darray[Lexer::Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    return 1 if file.errors.count != 0
    table: Semantic::SymbolTable = Semantic::check(&file)
    return 2 if table.binding_declared_types.count != 3
    outer: Semantic::BindingDeclaredType = table.binding_declared_types[0]
    inner: Semantic::BindingDeclaredType = table.binding_declared_types[1]
    other: Semantic::BindingDeclaredType = table.binding_declared_types[2]
    return 3 if outer.binding_id.serial == inner.binding_id.serial or outer.binding_id.owner.value != inner.binding_id.owner.value
    return 4 if outer.binding_id.owner.value == other.binding_id.owner.value
    return 5 if outer.module_owner != "Vault" or inner.module_owner != "Vault" or other.module_owner != "Vault"
    return 6 if outer.type_id == 0 or inner.type_id == 0 or outer.type_id != other.type_id or outer.type_id == inner.type_id
    inner_read: mutable bool = false
    outer_read: mutable bool = false
    other_read: mutable bool = false
    for index in 0..<table.ref_binding_ids.count |inner_read, outer_read, other_read, index|:
        continue if table.ref_name[index] != "owner"
        id: Semantic::BindingId = table.ref_binding_ids[index]
        inner_read <- id.owner.value == inner.binding_id.owner.value and id.serial == inner.binding_id.serial if table.ref_pos[index].line == 5
        outer_read <- id.owner.value == outer.binding_id.owner.value and id.serial == outer.binding_id.serial if table.ref_pos[index].line == 6
        other_read <- id.owner.value == other.binding_id.owner.value and id.serial == other.binding_id.serial if table.ref_pos[index].line == 8
    return 7 if not inner_read or not outer_read or not other_read
    protocol_source: u8& = "affine struct File[state Closed | Open]:\n    handle: i64\ndef inspect(closed: File[Closed], opened: File[Open], borrowed: File[Closed]&, linear: lmut File[Closed], writable: mutable File[Closed]&, mutable_owner: mutable File[Closed], container: darray[File[Closed]&]) -> void:\n    pass\n"
    protocol_tokens: darray[Lexer::Token] = frontend_tokenize(protocol_source, protocol_source)
    protocol_file: Ast::File = frontend_parser_parse_file(protocol_source, protocol_tokens)
    return 8 if protocol_file.errors.count != 0
    protocol_table: Semantic::SymbolTable = Semantic::check(&protocol_file)
    # The named-family guard is intentionally still present; these checks only
    # establish that the binding record preserves distinct structural shapes.
    return 9 if protocol_table.binding_declared_types.count != 7
    closed_type: u32 = protocol_table.binding_declared_types[0].type_id
    open_type: u32 = protocol_table.binding_declared_types[1].type_id
    borrowed_type: u32 = protocol_table.binding_declared_types[2].type_id
    return 10 if closed_type == 0 or open_type == 0 or borrowed_type == 0 or closed_type == open_type or closed_type == borrowed_type
    return 11 if protocol_table.type_row_kind[closed_type.usize() - 1] != Semantic::SemTypeKind.Container or protocol_table.type_row_kind[borrowed_type.usize() - 1] != Semantic::SemTypeKind.Ref
    closed: Semantic::BindingDeclaredType = protocol_table.binding_declared_types[0]
    borrowed: Semantic::BindingDeclaredType = protocol_table.binding_declared_types[2]
    linear: Semantic::BindingDeclaredType = protocol_table.binding_declared_types[3]
    writable: Semantic::BindingDeclaredType = protocol_table.binding_declared_types[4]
    mutable_owner: Semantic::BindingDeclaredType = protocol_table.binding_declared_types[5]
    container: Semantic::BindingDeclaredType = protocol_table.binding_declared_types[6]
    return 12 if closed.explicit_borrow or closed.writable_borrow or closed.linear_mutable or closed.binding_mutable
    return 13 if not borrowed.explicit_borrow or borrowed.writable_borrow or borrowed.linear_mutable
    return 14 if not linear.explicit_borrow or not linear.writable_borrow or not linear.linear_mutable or linear.type_id != closed_type
    return 15 if not writable.explicit_borrow or not writable.writable_borrow or writable.linear_mutable
    return 16 if mutable_owner.explicit_borrow or mutable_owner.writable_borrow or not mutable_owner.binding_mutable or mutable_owner.type_id != closed_type
    return 17 if container.explicit_borrow or container.writable_borrow or container.linear_mutable
    alias_source: u8& = "module Left:\n    affine struct File[state Closed | Open]:\n        handle: i64\n    type Handle = File[Closed]&\n    type Again = Handle\nmodule Right:\n    affine struct File[state Closed | Open]:\n        handle: i64\n    type Handle = lmut File[Closed]\n"
    alias_tokens: darray[Lexer::Token] = frontend_tokenize(alias_source, alias_source)
    alias_file: Ast::File = frontend_parser_parse_file(alias_source, alias_tokens)
    return 18 if alias_file.errors.count != 0
    aliases: Semantic::SymbolTable = Semantic::collect_symbols(&alias_file)
    return 19 if aliases.type_alias_declarations.count != 3
    left_alias: Semantic::TypeAliasDeclaration = aliases.type_alias_declarations[0]
    chain_alias: Semantic::TypeAliasDeclaration = aliases.type_alias_declarations[1]
    right_alias: Semantic::TypeAliasDeclaration = aliases.type_alias_declarations[2]
    return 20 if left_alias.declaration_id.value == right_alias.declaration_id.value or left_alias.module_owner != "Left" or right_alias.module_owner != "Right"
    return 21 if aliases.symbols[left_alias.declaration_id.value.usize()].kind != Semantic::SymbolKind.Alias or aliases.symbols[right_alias.declaration_id.value.usize()].module_owner != "Right"
    match left_alias.target:
        Ast::Expr.Unary(Lexer::TokenKind.Ampersand, Ast::Expr.Index(Ast::Expr.Ident(owner, _), Ast::Expr.Ident(state, _), _), _):
            return 22 if owner != "File" or state != "Closed"
        _:
            return 22
    match right_alias.target:
        Ast::Expr.Unary(Lexer::TokenKind.Lmut, Ast::Expr.Index(Ast::Expr.Ident(owner, _), Ast::Expr.Ident(state, _), _), _):
            return 23 if owner != "File" or state != "Closed"
        _:
            return 23
    match chain_alias.target:
        Ast::Expr.Ident(name, _):
            return 24 if name != "Handle"
        _:
            return 24
    resolution_source: u8& = "module Left:\n    affine struct File[state Closed | Open]:\n        handle: i64\n    type Handle = File[Closed]&\n    type Again = Handle\n    def read(value: Again) -> void:\n        pass\nmodule Right:\n    affine struct File[state Closed | Open]:\n        handle: i64\n    type Handle = lmut File[Closed]\n    def write(value: Handle) -> void:\n        pass\ntype CycleA = CycleB\ntype CycleB = CycleA\ndef unresolved(value: CycleA) -> void:\n    pass\ndef qualified(left: Left::Again, right: Right::Handle) -> void:\n    pass\n"
    resolution_tokens: darray[Lexer::Token] = frontend_tokenize(resolution_source, resolution_source)
    resolution_file: Ast::File = frontend_parser_parse_file(resolution_source, resolution_tokens)
    return 25 if resolution_file.errors.count != 0
    resolved: Semantic::SymbolTable = Semantic::check(&resolution_file)
    return 26 if resolved.binding_declared_types.count != 5
    left_cap: Semantic::BindingCapabilities = resolved.binding_declared_types[0].capabilities
    right_cap: Semantic::BindingCapabilities = resolved.binding_declared_types[1].capabilities
    cyclic_cap: Semantic::BindingCapabilities = resolved.binding_declared_types[2].capabilities
    return 27 if not left_cap.known or not left_cap.borrowed or left_cap.writable or left_cap.linear_mutable
    return 28 if not right_cap.known or not right_cap.borrowed or not right_cap.writable or not right_cap.linear_mutable
    return 29 if left_cap.declaration_id.value == right_cap.declaration_id.value or cyclic_cap.known
    return 30 if resolved.binding_declared_types[3].capabilities.declaration_id.value != left_cap.declaration_id.value or not resolved.binding_declared_types[3].capabilities.borrowed
    return 31 if resolved.binding_declared_types[4].capabilities.declaration_id.value != right_cap.declaration_id.value or not resolved.binding_declared_types[4].capabilities.linear_mutable
    ambiguous_source: u8& = "module Clash:\n    type Handle = i64\n    type Handle = u8&\n    def inspect(value: Handle) -> void:\n        pass\n"
    ambiguous_tokens: darray[Lexer::Token] = frontend_tokenize(ambiguous_source, ambiguous_source)
    ambiguous_file: Ast::File = frontend_parser_parse_file(ambiguous_source, ambiguous_tokens)
    return 32 if ambiguous_file.errors.count != 0
    ambiguous_table: Semantic::SymbolTable = Semantic::check(&ambiguous_file)
    return 33 if ambiguous_table.binding_declared_types.count != 1 or ambiguous_table.binding_declared_types[0].capabilities.known
    relative_source: u8& = "module Peer:\n    type Handle = i64\nmodule Outer::Peer:\n    type Handle = u8&\nmodule Outer::Inner::Peer:\n    type Handle = lmut u8\nmodule OuterKit::Peer:\n    type Handle = i64\nmodule Outer::User:\n    def inspect(value: Peer::Handle) -> void:\n        pass\nmodule Outer::Inner::User:\n    def inspect(value: Peer::Handle) -> void:\n        pass\nmodule Peer::Sub:\n    type Handle = i64\nmodule Outer::Peer::Sub:\n    type Handle = u8&\nmodule Outer::Sibling:\n    def inspect(value: Peer::Sub::Handle) -> void:\n        pass\n"
    relative_tokens: darray[Lexer::Token] = frontend_tokenize(relative_source, relative_source)
    relative_file: Ast::File = frontend_parser_parse_file(relative_source, relative_tokens)
    return 34 if relative_file.errors.count != 0
    relative_table: Semantic::SymbolTable = Semantic::check(&relative_file)
    return 35 if relative_table.binding_declared_types.count != 3
    parent_cap: Semantic::BindingCapabilities = relative_table.binding_declared_types[0].capabilities
    nearest_cap: Semantic::BindingCapabilities = relative_table.binding_declared_types[1].capabilities
    return 36 if not parent_cap.known or not parent_cap.borrowed or parent_cap.writable or parent_cap.linear_mutable
    return 37 if not nearest_cap.known or not nearest_cap.borrowed or not nearest_cap.writable or not nearest_cap.linear_mutable
    nested_cap: Semantic::BindingCapabilities = relative_table.binding_declared_types[2].capabilities
    return 38 if not nested_cap.known or not nested_cap.borrowed or nested_cap.writable or nested_cap.linear_mutable
    return 0
