# The outer call has no direct lambda argument, but its inner call does.
const LAMBDA_FILTER_INPUT: i64 = 41

def lambda_filter_apply(body: fn(i64) -> i64, value: i64) -> i64:
    return body(value)

def lambda_filter_outer(value: i64) -> i64:
    return value

def main() -> i64:
    return lambda_filter_outer(lambda_filter_apply(fn(n) => 42, LAMBDA_FILTER_INPUT))
