def long_chained_alias(value: A65::AliasMode = A65::AliasMode.High) -> A65::AliasMode:
    return value

def imported(value: ImportedMode = ImportedMode.High) -> ImportedMode:
    return value

def alias_wins(value: X::Mode = X::Mode.High) -> X::Mode:
    return value

def chained_alias(value: FinalAlias::AliasMode = FinalAlias::AliasMode.High) -> FinalAlias::AliasMode:
    return value

def qualified_target_alias(value: N::QualifiedMode = N::QualifiedMode.Ready) -> N::QualifiedMode:
    return value

export pymodule selective_enum_defaults:
    fn imported
    fn local = LocalShadow::local
    fn nearest = Nested::nearest
    fn parent_beats_import = Parent::Inner::parent_beats_import
    fn nested_qualified = Outer::User::nested_qualified
    fn alias_wins
    fn chained_alias
    fn qualified_target_alias
    fn long_chained_alias
