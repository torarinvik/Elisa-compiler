module Values:
    public:
        const enum ImportedMode of i64:
            High = 41
        const enum Mode of i64:
            High = 45
        const enum RootMode of i64:
            High = 49

module X:
    public:
        const enum Mode of i64:
            High = 11

module Target:
    public:
        const enum Mode of i64:
            High = 66

module LocalShadow:
    public:
        const enum Mode of i64:
            High = 93
    def local(value: Mode = Mode.High) -> Mode:
        return value

module Nested:
    public:
        const enum NestedMode of i64:
            High = 31
    def nearest(value: NestedMode = NestedMode.High) -> NestedMode:
        return value

module Parent:
    public:
        const enum Mode of i64:
            High = 17
    module Inner:
        using Values::Mode
        def parent_beats_import(value: Mode = Mode.High) -> Mode:
            return value

module Outer:
    module Values:
        public:
            const enum RootMode of i64:
                High = 82
    module User:
        def nested_qualified(value: Values::RootMode = Values::RootMode.High) -> Values::RootMode:
            return value

module AliasRoot:
    public:
        const enum AliasMode of i64:
            High = 71

module QualifiedRoot:
    module Nested:
        public:
            const enum QualifiedMode of i64:
                Ready = 83

