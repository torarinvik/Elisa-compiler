def ref_shape_probe(value: mutable i64&, other: mutable i64&) -> i64: return value
def view_shape_probe(values: darray[i64], other: mutable i64&) -> i64: return other
def main() -> i64:
    left: mutable i64 = 1
    right: mutable i64 = 2
    ref_shape_probe(left, right)
    return view_shape_probe([], right)
