# Same-named struct fields in separate modules must keep their own types.
# Dynamic.Run.answer is a dynamic array; Scalar.Run.answer is an integer.
# Expected process exit: 42.

module Dynamic:
    struct Run:
        answer: mutable darray[i64]

module Scalar:
    struct Run:
        answer: mutable i64

    def read() -> i64:
        run: mutable Run = Run{answer: 41}
        if run.answer != 41:
            return 1
        run.answer <- run.answer + 1
        return run.answer

def main() -> i64:
    return Scalar::read()
