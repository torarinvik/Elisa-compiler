law NonNegative(self: i64):
    return self >= 0

struct RawPacket:
    value: i64

struct SafePacket:
    value: i64 is NonNegative

def shadow_block(packet: RawPacket, safe: SafePacket) -> i64 is NonNegative:
    if true:
        packet: SafePacket = safe
        return packet.value
    return 0

def shadow_assignment(packet: RawPacket, safe: SafePacket) -> i64 is NonNegative:
    if true:
        packet = safe
        return packet.value
    return 0

def shadow_loop(packet: RawPacket, packets: darray[SafePacket]) -> i64 is NonNegative:
    for packet in packets:
        return packet.value
    return 0

def shadow_match(packet: RawPacket, safe: SafePacket) -> i64 is NonNegative:
    match safe:
        SafePacket{} as packet:
            return packet.value
    return 0

def main() -> i64:
    safe: SafePacket = SafePacket{value: 1}
    packets: darray[SafePacket] = [safe]
    return shadow_block(RawPacket{value: 0}, safe) + shadow_assignment(RawPacket{value: 0}, safe) + shadow_loop(RawPacket{value: 0}, packets) + shadow_match(RawPacket{value: 0}, safe)
