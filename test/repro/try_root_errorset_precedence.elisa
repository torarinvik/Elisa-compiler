# Core's error-set lookup checks the exact root name before lexical module candidates.
error Clash:
    RootTag

module LocalShadow:
    public:
        error Clash:
            LocalTag

        def source() -> i64 error[Clash]:
            return 1

def wrong_local_destination() -> i64 error[LocalShadow::Clash]:
    return try LocalShadow::source()

def matching_root_destination() -> i64 error[Clash]:
    return try LocalShadow::source()

def main() -> i64:
    return 0
