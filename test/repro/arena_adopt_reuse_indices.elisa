# Adopted reclaimed spans must use their new parent-chain region indices.
include "../../elisacore_std/arena.elisa"

module ArenaAdoptReuseRegression:
    private:
        const CAPACITY: usize = 16
        const INITIAL: usize = 4
        const FILLER: usize = 12
        const GROWN: usize = 20
        const REUSED: usize = 2
        const FIRST_REGION: usize = 0
        const ADOPTED_REGION: usize = 1
        const ADOPTED_TAIL: usize = 2
        const SUCCESS: i64 = 0
        const FAILURE: i64 = 1

    public:
        def run() -> i64:
            parent_backing: mutable heap Region& = new_region_backend(CAPACITY, ARENA_STRATEGY_CHAINED)
            child_backing: mutable heap Region& = new_region_backend(CAPACITY, ARENA_STRATEGY_CHAINED)
            parent: mutable Arena = Arena{begin: parent_backing, end: parent_backing, end_index: FIRST_REGION, strategy: ARENA_STRATEGY_CHAINED}
            child: mutable Arena = Arena{begin: child_backing, end: child_backing, end_index: FIRST_REGION, strategy: ARENA_STRATEGY_CHAINED}
            initial: mutable heap void& = arena_alloc(&child, INITIAL * size_of(uintptr))
            original_address: uintptr = initial.cast[uintptr]
            filler: mutable heap void& = arena_alloc(&child, FILLER * size_of(uintptr))
            grown: mutable heap void& = arena_realloc(&child, initial, INITIAL * size_of(uintptr), GROWN * size_of(uintptr))
            child_tail: heap Region&? = child.end
            arena_adopt(&parent, &child)
            first: mutable heap void& = arena_alloc(&parent, REUSED * size_of(uintptr))
            second: mutable heap void& = arena_alloc(&parent, REUSED * size_of(uintptr))
            correct: bool = child_backing.global_index == ADOPTED_REGION and child_tail != null and child_tail.global_index == ADOPTED_TAIL and first.cast[uintptr] == original_address and second.cast[uintptr] == original_address + (REUSED * size_of(uintptr)).uintptr()
            arena_free(&parent)
            return SUCCESS if correct else FAILURE

def main() -> i64:
    return ArenaAdoptReuseRegression::run()
