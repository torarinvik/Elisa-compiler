# The normal runtime object supplies the stage0 implementation. Stage1 lowers
# calls to this recognized constructor directly; declaring its signature keeps
# the source self-contained without pulling every std runtime body into the IR.
# The public runtime wrapper has a C-compatible non-null cstr parameter.  The
# lower-level `sview(cstr?, ...)` helper is an Elisa-only function and cannot be
# declared as extern because optional cstr has no C representation.
extern ctx_string_view(value: cstr, start: i64, end: i64) -> sview
extern strlen(value: cstr) -> usize

# Exercise all sview clamping branches on wasm32. The constructor must call
# `strlen` with the target C `size_t` ABI (i32) and widen the result before
# comparing it with the backend's i64 clamp arithmetic.
def sview_clamp_score() -> i64 can[Abort.Panic, Memory.Allocate]:
    score: mutable i64 = 0
    text: cstr = "hello"

    # Keep a direct target-sized strlen call in the fixture: the smoke checks
    # that stage1 lowers wasm32 size_t as i32 and widens it before i64 math.
    measured: usize = strlen(text)
    measured_i64: i64 = measured.i64()
    score <- score + measured_i64 - 5

    to_end: sview = ctx_string_view(text, 0, -1)
    score <- score + 1 if to_end.len == 5

    past_end: sview = ctx_string_view(text, 0, 99)
    score <- score + 2 if past_end.len == 5

    past_start: sview = ctx_string_view(text, 99, 99)
    score <- score + 4 if past_start.len == 0

    inverted: sview = ctx_string_view(text, 3, 1)
    score <- score + 8 if inverted.len == 0

    negative_start: sview = ctx_string_view(text, -4, 3)
    score <- score + 16 if negative_start.len == 3

    in_range: sview = ctx_string_view(text, 1, 4)
    score <- score + 32 if in_range.len == 3

    return score

export fn wasm32_sview_strlen() -> i64 = sview_clamp_score
