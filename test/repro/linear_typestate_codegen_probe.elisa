# Regression probe for legacy `linear typestate` lowering in the self-hosted backend.
#
# The declaration carries a phantom state parameter, but its runtime representation is one
# aggregate: the ordinary fields plus a hidden mutable state tag. `Ticket.new(...)` must lower to
# the generated constructor, and a transition must mutate that tag through its mutable receiver.
# The constructor call is deliberately named so this also protects ordinary named-call lowering.
linear typestate Ticket:
    id: i64
    states: Fresh, Used
    terminal: Used
    transition redeem: Fresh -> Used

def make() -> Ticket[Fresh]:
    return Ticket.new(id: 1)

def run() -> void:
    t: mutable Ticket[Fresh] = make()
    redeem(t)
