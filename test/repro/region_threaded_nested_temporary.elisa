# A threaded callee constructs nested backing before adopting it into caller-owned state.
# Every allocation must survive the callee epilogue.
def build_row[@r](out: mutable darray[darray[i64]]& @r, width: i64) -> void:
    row: mutable darray[i64] @r = []
    for i in 0..<width |row|:
        row.push(i)
    out.push(row)


def forward_row[@r](out: mutable darray[darray[i64]]& @r, width: i64) -> void:
    build_row(out, width)


def main() -> i64:
    rows: mutable darray[darray[i64]] = []
    forward_row(rows, 500)
    # Read both ends after two threaded callees have returned. The row has crossed several
    # reallocations, so this catches both direct and forwarded scratch-region retention.
    first: darray[i64] = rows[0] can Unsafe.UncheckedIndex
    return ((first[0] can Unsafe.UncheckedIndex) + (first[499] can Unsafe.UncheckedIndex)) - 457
