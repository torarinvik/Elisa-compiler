type MutableIntegerReference = mutable i64&

struct RefLeaf:
    pointer: MutableIntegerReference

struct RefMiddle:
    leaf: RefLeaf

struct RefRoot:
    middle: RefMiddle

def write_through(pointer: mutable i64&) -> i64:
    pointer <- 42
    return 0

def main() -> i64:
    root: mutable RefRoot = zeroed
    return write_through(root.middle.leaf.pointer)
