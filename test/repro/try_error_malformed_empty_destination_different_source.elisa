module First:
    public:
        error Fault:
            Bad
            Other

module Second:
    public:
        error Fault:
            Gone

module API:
    extern source() -> i64 error[First::Fault.Bad]
    extern malformed_source() -> i64 error[First::Fault{}]

    def malformed_destination() -> i64 error[Second::Fault{}]:
        return try source()

    def malformed_source_to_other_family() -> i64 error[Second::Fault]:
        return try malformed_source()

def main() -> i64:
    return 0
