# Lookup misses must not allocate AST sentinels; actual Absent payloads remain present.
include "../../src/semantic/semantic.elisa"

extend Semantic:
    public:
        def refinement_lookup_presence_probe() -> i32:
            can Memory.Allocate, Abort.Panic:
                position: Ast::Pos = Ast::pos_at_line(7)
                one: Ast::Expr = Ast::Expr.IntLit(1, position)
                two: Ast::Expr = Ast::Expr.IntLit(2, position)
                absent: Ast::Expr = Ast::Expr.Absent
                contract_lines: darray[u32] = [7, 7]
                one_contract_line: darray[u32] = [7]
                requires_kinds: darray[sview] = ["requires", "requires"]
                one_requires_kind: darray[sview] = ["requires"]
                one_ensures_kind: darray[sview] = ["ensures"]
                two_predicates: darray[Ast::Expr] = [one, two]
                one_predicate: darray[Ast::Expr] = [one]
                absent_predicate: darray[Ast::Expr] = [absent]
                duplicate_structs: darray[sview] = ["Box", "Box"]
                one_struct: darray[sview] = ["Box"]
                duplicate_starts: darray[usize] = [0, 2]
                duplicate_counts: darray[usize] = [2, 1]
                one_start: darray[usize] = [0]
                one_count: darray[usize] = [1]
                duplicate_fields: darray[sview] = ["hit", "hit", "hit"]
                one_field: darray[sview] = ["hit"]
                duplicate_annotations: darray[Ast::Expr] = [one, absent, two]
                empty_lines: darray[u32] = []
                empty_names: darray[sview] = []
                empty_exprs: darray[Ast::Expr] = []
                empty_indices: darray[usize] = []
                if signature_requires_of(7, contract_lines, requires_kinds, two_predicates) is predicate:
                    match predicate:
                        Expr.IntLit(value, _):
                            return 1 if value != 2
                        _:
                            return 2
                else:
                    return 3
                if signature_requires_of(7, one_contract_line, one_requires_kind, absent_predicate) is predicate:
                    return 4 if not (predicate is Expr.Absent)
                else:
                    return 5
                if signature_requires_of(8, one_contract_line, one_requires_kind, one_predicate) is present:
                    return 6
                if signature_requires_of(7, one_contract_line, one_ensures_kind, one_predicate) is present:
                    return 7
                if signature_requires_of(7, empty_lines, empty_names, empty_exprs) is present:
                    return 8

                # First matching struct and first matching field win, including duplicates.
                if struct_field_annotation("Box", "hit", duplicate_structs, duplicate_starts, duplicate_counts, duplicate_fields, duplicate_annotations) is annotation:
                    match annotation:
                        Expr.IntLit(value, _):
                            return 9 if value != 1
                        _:
                            return 10
                else:
                    return 11
                if struct_field_annotation("Box", "hit", one_struct, one_start, one_count, one_field, absent_predicate) is annotation:
                    return 12 if not (annotation is Expr.Absent)
                else:
                    return 13
                if struct_field_annotation("Missing", "hit", one_struct, one_start, one_count, one_field, one_predicate) is present:
                    return 14
                if struct_field_annotation("Box", "missing", one_struct, one_start, one_count, one_field, one_predicate) is present:
                    return 15
                if struct_field_annotation("Box", "hit", empty_names, empty_indices, empty_indices, empty_names, empty_exprs) is present:
                    return 16
                return 0

def main() -> i32:
    can Memory.Allocate, Abort.Panic:
        return Semantic::refinement_lookup_presence_probe()
