struct Item:
    value: i32

def callback(item: Item&) -> void:
    return

def callback_pair(first: Item&, second: Item&) -> void:
    return

extern register_callback(handler: fn(Item&) -> void, count: i32) -> i32
extern register_callback_pair(handler: fn(Item&, Item&) -> void) -> i32

def main() -> i64:
    handler: fn(Item&) -> void = callback
    _ = register_callback(handler, 1)
    register_callback_pair(callback_pair)
    return 42
