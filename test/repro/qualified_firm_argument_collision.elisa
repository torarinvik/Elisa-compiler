# A same-named function in another module must not donate its mutable-reference
# parameter type to a bare call resolved inside this module.
struct Paint:
    x: f64

module B:
    struct Run:
        value: f64

    def inspect(run: mutable Run&) -> f64:
        return run.value

module A:
    def inspect(value: f64) -> f64:
        return value

    def value(paint: Paint&) -> f64:
        return inspect(paint.x)

def main() -> i64:
    paint: Paint = Paint{x: 42.0}
    return 42 if A::value(&paint) == 42.0 else 1
