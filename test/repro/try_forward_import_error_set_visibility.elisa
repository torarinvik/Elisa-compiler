# Core registers selective imports before type analysis, even when the import appears
# after the function whose error-set annotation uses the imported name.
module SetProvider:
    public:
        error Expected:
            SetTag

module Consumer:
    public:
        error Fault:
            Expected

        error Other:
            Trouble

        def origin() -> i64 error[Expected]:
            return 1

        def same_family_destination() -> i64 error[Expected]:
            return try origin()

        def wrong_variant_destination() -> i64 error[Fault]:
            return try origin()

from SetProvider import Expected

def main() -> i64:
    return 0
