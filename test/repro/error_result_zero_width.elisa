# Error paths must only zero the caller's declared result storage.
error SmallError:
    Failed

error DetailError:
    Failed(code: i64)

def byte_plain(fail: bool) -> u8 error[SmallError]:
    raise SmallError.Failed if fail
    return 7

def byte_payload(fail: bool) -> u8 error[DetailError]:
    raise DetailError.Failed(9) if fail
    return 7

def short_plain(fail: bool) -> u16 error[SmallError]:
    raise SmallError.Failed if fail
    return 513

def short_payload(fail: bool) -> u16 error[DetailError]:
    raise DetailError.Failed(9) if fail
    return 513

def flag_plain(fail: bool) -> bool error[SmallError]:
    raise SmallError.Failed if fail
    return true

def flag_payload(fail: bool) -> bool error[DetailError]:
    raise DetailError.Failed(9) if fail
    return true

def float_plain(fail: bool) -> f32 error[SmallError]:
    raise SmallError.Failed if fail
    return 1.5

def float_payload(fail: bool) -> f32 error[DetailError]:
    raise DetailError.Failed(9) if fail
    return 1.5

def void_plain(fail: bool) -> void error[SmallError]:
    raise SmallError.Failed if fail
    return

def void_payload(fail: bool) -> void error[DetailError]:
    raise DetailError.Failed(9) if fail
    return

def main() -> i64:
    byte_plain_ok: u8 = try byte_plain(false) else 0
    return 1 if byte_plain_ok != 7
    byte_plain_bad: u8 = try byte_plain(true) else 0
    return 2 if byte_plain_bad != 0
    byte_payload_ok: u8 = try byte_payload(false) else 0
    return 3 if byte_payload_ok != 7
    byte_payload_bad: u8 = try byte_payload(true) else 0
    return 4 if byte_payload_bad != 0
    short_plain_ok: u16 = try short_plain(false) else 0
    return 5 if short_plain_ok != 513
    short_plain_bad: u16 = try short_plain(true) else 0
    return 6 if short_plain_bad != 0
    short_payload_ok: u16 = try short_payload(false) else 0
    return 7 if short_payload_ok != 513
    short_payload_bad: u16 = try short_payload(true) else 0
    return 8 if short_payload_bad != 0
    flag_plain_ok: bool = try flag_plain(false) else false
    return 9 if flag_plain_ok != true
    flag_plain_bad: bool = try flag_plain(true) else false
    return 10 if flag_plain_bad != false
    flag_payload_ok: bool = try flag_payload(false) else false
    return 11 if flag_payload_ok != true
    flag_payload_bad: bool = try flag_payload(true) else false
    return 12 if flag_payload_bad != false
    float_plain_ok: f32 = try float_plain(false) else 0.0
    return 13 if float_plain_ok != 1.5
    float_plain_bad: f32 = try float_plain(true) else 0.0
    return 14 if float_plain_bad != 0.0
    float_payload_ok: f32 = try float_payload(false) else 0.0
    return 15 if float_payload_ok != 1.5
    float_payload_bad: f32 = try float_payload(true) else 0.0
    return 16 if float_payload_bad != 0.0
    return 0

