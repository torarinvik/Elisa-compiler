struct Pair[state Within | Outside]:
    low: i64
    high: i64
    derive state:
        Within when self.low < self.high and self.low >= 0
        Outside when not (self.low < self.high and self.low >= 0)

def invalid() -> i64:
    pair: Pair[Within] = Pair[Within]{low: 5, high: 3}
    return pair.low
