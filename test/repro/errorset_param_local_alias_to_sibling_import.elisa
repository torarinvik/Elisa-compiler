# A local alias target sees Core's program-wide selective import alias even when the
# import was declared in a sibling module.
module Importer:
    public:
        module Provider:
            public:
                error Fault:
                    Failed

        module AliasProvider:
            public:
                type AliasFault = Importer::Provider::Fault

    from AliasProvider import AliasFault

module Consumer:
    type LocalFault = AliasFault

    def forward[errorset LocalFault](callback: fn() -> i64 error[LocalFault]) -> i64 error[LocalFault]:
        return try callback()

def main() -> i64:
    return 0
