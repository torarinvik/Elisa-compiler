# A qualified monomorphic member must not bind to an unrelated top-level generic with
# the same spelling. In particular, `SceneVerdict::put` in the Neural Workshop port
# coexists with the standard library's top-level generic `put`.
def put[T](value: T) -> T:
    return value

module M:
    def put(value: i64) -> i64:
        return value + 10

def main() -> i64:
    return M::put(32)
