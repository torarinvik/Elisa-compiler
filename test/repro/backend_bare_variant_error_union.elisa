error Fault:
    Expected(payload: i64)
    Other(payload: i64)

def produce_expected(fail: bool) -> i64 error[Fault{Expected}]:
    raise Fault.Expected(37) if fail
    return 0

def forward_bare(fail: bool) -> i64 error[Expected]:
    return try produce_expected(fail)

def forward_full(fail: bool) -> i64 error[Fault]:
    return try forward_bare(fail)

def catch_full() -> i64:
    return catch forward_full(true):
        value: value
        Fault.Expected(payload): payload
        Fault.Other(payload): payload

def main() -> i64:
    return 1 if catch_full() != 37
    return 0
