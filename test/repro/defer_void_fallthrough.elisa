# `defer` must run on EVERY exit from a function — including falling off the END of a `-> void`
# function, which is the one exit that has no `return` statement to hang the unwind on.
#
# Only the explicit-`return` paths emitted the deferred blocks, so a void function without a
# trailing `return` silently dropped all of them. Nothing in the compiler's own sources hits
# this (they all return explicitly), and the answer is only visible if the deferred code is
# OBSERVABLE — hence the digit trace: each `note` shifts, so both the SET of blocks that ran
# and their LIFO ORDER are encoded in one number.
global mutable trace: i64 = 0

def note(n: i64) -> void:
    trace <- trace * 10 + n

# Falls off the end. Deferred blocks unwind LIFO: 3, then 2, then 1.
def implicit_exit() -> void:
    defer block:
        note(1)
    defer block:
        note(2)
    note(3)

# The same shape with an explicit `return` — this path always worked, and is here so a fix
# that broke it could not pass.
def explicit_exit() -> void:
    defer block:
        note(4)
    note(5)
    return

def main() -> i64:
    implicit_exit()      # trace = 321
    explicit_exit()      # trace = 32154
    return trace % 251   # 32154 % 251 = 26
