const enum Mode of i64:
    Off = 0
    Ready = 7

enum Plain:
    First
    Second

def mode_roundtrip(mode: Mode) -> Mode:
    return mode

def plain_roundtrip(value: Plain) -> Plain:
    return value

def mode_count(values: darray[Mode]) -> i64:
    return values.count.i64()

export pymodule enums:
    fn mode_roundtrip
    fn plain_roundtrip
    fn mode_count
