# An inactive fallible import and inactive discarded call must not look active.
module FallibleProvider:
    public:
        error Fault:
            Failed

        def perform() -> i64 error[FallibleProvider::Fault]:
            return 1

module SafeProvider:
    public:
        def perform() -> i64:
            return 2

module RootCollision:
    public:
        error Fault:
            Failed

        def load() -> i64 error[RootCollision::Fault]:
            return 3

module AliasSafeProvider:
    public:
        def load() -> i64:
            return 4

module AliasInstallerA:
    static if UNKNOWN_ALIAS_TARGET:
        using AliasSafeProvider as RootCollision

module AliasInstallerB:
    static if UNKNOWN_ALIAS_TARGET:
        using AliasSafeProvider as RootCollision

const USE_FALLIBLE_PROVIDER: bool = false

static if USE_FALLIBLE_PROVIDER:
    from FallibleProvider import perform
static else:
    from SafeProvider import perform

def inactive_static_body() -> i64:
    static if false:
        FallibleProvider::perform()
    return 0

def main() -> i64:
    perform()
    return 0

def unresolved_alias_does_not_fall_back_to_root_module() -> i64:
    RootCollision::load()
    return 0

# A proven-inactive nonfallible overload must not make the active fallible
# overload ambiguous during ErrorUnion call classification.
module OverloadBranch:
    error Fault:
        Failed

    static if false:
        def choose(value: i64) -> i64:
            return value
    static else:
        def choose(value: i64) -> i64 error[OverloadBranch::Fault]:
            return value

    def caller() -> i64:
        choose(1)
        return 0
