include "../../src/semantic/binding_identity_types.elisa"
include "../../src/semantic/ownership_flow_domain.elisa"
include "../../src/semantic/ownership_binding_flow.elisa"

def main() -> i32:
    id: Semantic::BindingId = Semantic::BindingId{owner: Semantic::DeclId{value: 7}, serial: 1}
    live: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: id, reachable: true, known: true, may_live: true, may_consumed: false}
    accepted, consumed = Semantic::ownership_binding_consume(live)
    return 1 if not accepted or Semantic::ownership_binding_can_consume(consumed)
    again, unchanged = Semantic::ownership_binding_consume(consumed)
    return 2 if again or not unchanged.may_consumed or unchanged.may_live
    branch: Semantic::OwnershipBindingFact = Semantic::ownership_binding_join(id, live, consumed)
    return 3 if not branch.known or not branch.may_live or not branch.may_consumed or Semantic::ownership_binding_can_consume(branch)
    dead: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: id, reachable: false, known: false, may_live: true, may_consumed: true}
    restored: Semantic::OwnershipBindingFact = Semantic::ownership_binding_join(id, live, dead)
    return 4 if not Semantic::ownership_binding_can_consume(restored)
    unreachable: Semantic::OwnershipBindingFact = Semantic::ownership_binding_join(id, dead, dead)
    return 5 if unreachable.reachable or unreachable.known or unreachable.may_live or unreachable.may_consumed or Semantic::ownership_binding_can_consume(unreachable)
    shadow: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: Semantic::BindingId{owner: Semantic::DeclId{value: 7}, serial: 2}, reachable: false, known: true, may_live: true, may_consumed: false}
    mismatch: Semantic::OwnershipBindingFact = Semantic::ownership_binding_join(id, live, shadow)
    return 6 if mismatch.known or Semantic::ownership_binding_can_consume(mismatch)
    other_function: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: Semantic::BindingId{owner: Semantic::DeclId{value: 8}, serial: 1}, reachable: true, known: true, may_live: true, may_consumed: false}
    mismatch_function: Semantic::OwnershipBindingFact = Semantic::ownership_binding_join(id, live, other_function)
    return 7 if mismatch_function.known or Semantic::ownership_binding_can_consume(mismatch_function)
    return 8 if Semantic::ownership_binding_id_valid(Semantic::BindingId{owner: Semantic::DeclId{value: 4294967295}, serial: 1})
    return 9 if not Semantic::ownership_binding_id_valid(Semantic::BindingId{owner: Semantic::DeclId{value: 7}, serial: 0})
    for index in 0..<16:
        reachable: bool = index >= 8
        known: bool = index % 8 >= 4
        may_live: bool = index % 4 >= 2
        may_consumed: bool = index % 2 == 1
        input: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: id, reachable: reachable, known: known, may_live: may_live, may_consumed: may_consumed}
        allowed, output = Semantic::ownership_binding_consume(input)
        return 10 if allowed != (index == 14)
        if allowed:
            return 11 if not output.reachable or not output.known or output.may_live or not output.may_consumed
        else:
            return 12 if output.reachable != reachable or output.known != known or output.may_live != may_live or output.may_consumed != may_consumed
        return 13 if not Semantic::ownership_binding_ids_equal(output.binding_id, id)
    for index in 0..<256:
        l: i32 = index / 16
        r: i32 = index % 16
        left: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: id, reachable: l >= 8, known: l % 8 >= 4, may_live: l % 4 >= 2, may_consumed: l % 2 == 1}
        right: Semantic::OwnershipBindingFact = Semantic::OwnershipBindingFact{binding_id: id, reachable: r >= 8, known: r % 8 >= 4, may_live: r % 4 >= 2, may_consumed: r % 2 == 1}
        result: Semantic::OwnershipBindingFact = Semantic::ownership_binding_join(id, left, right)
        expected_known: mutable bool = false
        expected_live: mutable bool = false
        expected_consumed: mutable bool = false
        if left.reachable:
            expected_known <- left.known
            expected_live <- left.may_live
            expected_consumed <- left.may_consumed
        if right.reachable:
            expected_known <- expected_known and right.known if left.reachable else right.known
            expected_live <- expected_live or right.may_live
            expected_consumed <- expected_consumed or right.may_consumed
        return 14 if result.reachable != (left.reachable or right.reachable) or result.known != expected_known or result.may_live != expected_live or result.may_consumed != expected_consumed
        return 15 if not Semantic::ownership_binding_ids_equal(result.binding_id, id)
    return 0
