error A:
    AFail
error B:
    BFail
module API:
    public:
        extern run(callback: fn() -> i64 error[A]) -> i64
        extern pure(callback: fn() -> i64) -> i64
        extern fallible(callback: fn() -> i64 error[A]) -> i64 error[B]
from API import run

def good() -> i64:
    return run(fn() => raise A.AFail)
def bad() -> i64:
    return run(fn() => raise B.BFail)
def bad_pure() -> i64:
    return API::pure(fn() => raise A.AFail)
def good_fallible() -> i64 error[B]:
    return API::fallible(fn() => raise A.AFail)
def bad_fallible() -> i64 error[B]:
    return API::fallible(fn() => raise B.BFail)
