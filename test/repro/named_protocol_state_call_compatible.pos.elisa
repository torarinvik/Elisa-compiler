affine struct Snapshot[state Ready | Running | Observed]:
    payload: u64
    transitions:
        Ready -> Running
        Running -> Observed

def begin(snapshot: Snapshot[Ready]) -> Snapshot[Running]:
    return transition[Running](move snapshot)

def observe(snapshot: Snapshot[Running]) -> Snapshot[Observed]:
    return transition[Observed](move snapshot)

def read_observed(snapshot: Snapshot[Observed]) -> u64:
    return snapshot.payload

def main() -> i32:
    ready: Snapshot[Ready] = Snapshot[Ready]{payload: 78}
    running: Snapshot[Running] = begin(move ready)
    observed: Snapshot[Observed] = observe(move running)
    return read_observed(move observed).i32()
