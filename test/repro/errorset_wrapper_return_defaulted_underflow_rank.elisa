# A defaulted overload can win Core's receiver rank even when another required
# parameter is missing; invalid winners must not fall back to a generic family.
module UnderflowProvider:
    public:
        error ConcreteFault:
            Concrete

        error GenericFault:
            Generic

        def fallible(value: i64, required: bool, optional: bool = false) -> i64 error[UnderflowProvider::ConcreteFault]:
            return value

        def fallible[T](value: T) -> i64 error[UnderflowProvider::GenericFault]:
            return 2

        def infallible(value: i64, required: bool, optional: bool = false) -> i64:
            return value

        def infallible[T](value: T) -> i64 error[UnderflowProvider::GenericFault]:
            return 3

        def fixed(value: i64, required: bool) -> i64 error[UnderflowProvider::ConcreteFault]:
            return value

        def fixed[T](value: T) -> i64 error[UnderflowProvider::GenericFault]:
            return 4

from UnderflowProvider import fallible
from UnderflowProvider import infallible
from UnderflowProvider import fixed

module Consumer:
    public:
        def defaulted_fallible_underflow(value: i64) -> i64 error[UnderflowProvider::ConcreteFault]:
            return fallible(value)

        def defaulted_infallible_underflow(value: i64) -> i64 error[UnderflowProvider::ConcreteFault]:
            return infallible(value)

        # Without a default, the concrete overload is ineligible at receiver ranking;
        # the one-argument generic candidate remains selected.
        def fixed_arity_control(value: i64) -> i64 error[UnderflowProvider::ConcreteFault]:
            return fixed(value)

def main() -> i64:
    return 0
