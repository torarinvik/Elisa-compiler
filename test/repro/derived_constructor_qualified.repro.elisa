# Regression: qualified named-state construction must not resolve its state as a value.
module Owner:
    struct File[state Valid]:
        value: i64
        derive state:
            Valid when self.value < 0

def valid() -> i64:
    file: Owner::File[Valid] = Owner::File[Valid]{value: -1}
    return file.value

def main() -> i32:
    return 1 if valid() != -1
    return 0
