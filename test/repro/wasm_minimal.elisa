# Small scalar-only WASM fixture. Aggregate values stay deliberately behind Elisa-side
# adapters so the generated JavaScript ABI remains obvious and stable.

def add(a: i32, b: i32) -> i32:
    return a + b

export fn add_wasm(a: i32, b: i32) -> i32 = add

def echo_usize(value: usize) -> usize:
    return value

export fn wasm_usize(value: usize) -> usize = echo_usize

def echo_i64(value: i64) -> i64:
    return value

export fn wasm_i64(value: i64) -> i64 = echo_i64

static if ELISA_TARGET_OS_WASM:
    def target_marker() -> i32:
        return 7
static else:
    def target_marker() -> i32:
        return 13

export fn wasm_target_marker() -> i32 = target_marker

extern strlen(text: cstr) -> usize

def text_length(text: cstr) -> usize:
    return strlen(text)

export fn wasm_text_length(text: cstr) -> usize = text_length

def echo_text(text: cstr) -> cstr:
    return text

export fn wasm_echo_text(text: cstr) -> cstr = echo_text

def arena_allocation_probe() -> i32:
    region scratch(4096)
    values: mutable darray[i32] @scratch = []
    values.push(40)
    values.push(2)
    answer: i32 = values[0] + values[1]
    destroy scratch
    return answer

export fn wasm_arena_allocation_probe() -> i32 = arena_allocation_probe
