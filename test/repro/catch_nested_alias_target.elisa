module Outer:
    module Right:
        module Nested:
            error Fault:
                Expected
                Missing
            extern load() -> i64 error[Outer::Right::Nested::Fault]

module Wrong:
    module Right:
        module Nested:
            error Fault:
                Expected
                WrongOnly
            extern load() -> i64 error[Wrong::Right::Nested::Fault]

using Outer as First
using First::Right as Second

def nested_alias_incomplete() -> i64:
    catch Second::Nested::load():
        value: 0
        Outer::Right::Nested::Fault.Expected: 1
    return 0
