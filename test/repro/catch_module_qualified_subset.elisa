module Local:
    error Fault:
        Allowed
        Forbidden
    extern restricted() -> i64 error[Local::Fault{Allowed}]
    def subset() -> i64:
        catch restricted():
            value: 0
            Local::Fault.Forbidden: 2
            Local::Fault.Allowed: 1
        return 0

module Peer:
    error Fault:
        Allowed
        Forbidden
    extern restricted() -> i64 error[Peer::Fault{Forbidden}]
    def subset() -> i64:
        catch restricted():
            value: 0
            Peer::Fault.Forbidden: 1
        return 0
