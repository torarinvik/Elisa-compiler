# Independent worker arenas concurrently exercise the process-wide mmap region
# cache and reclaimed-region hint. The result counter is atomic so the fixture
# itself does not introduce an unrelated data race.
include "../../elisacore_std/arena.elisa"

extern pthread_create(thread: mutable uintptr&, attr: void&?, start_routine: void&, arg: void&?) -> i32 can[Thread.Spawn]
extern pthread_join(thread: uintptr, retval: mutable void&?) -> i32 can[Thread.Join]

global mutable __arena_cache_completed: AtomicCell[i64] = zeroed

def arena_cache_worker(arg: void&?) -> void&? can[Memory.Allocate, Memory.Release, Abort.Panic, Atomics.Rmw]:
    can Memory.Allocate, Memory.Release, Abort.Panic, Atomics.Rmw:
        _ = arg
        for iteration in 0..<256:
            local_arena: mutable Arena = zeroed
            _ = arena_alloc(&local_arena, 64.usize())
            arena_free(&local_arena)
        trusted [Unsafe.MutableGlobal, Global.Read, Global.Write]:
            _ = atomic_fetch_add_acqrel(&__arena_cache_completed, 1)
        return null

def main() -> i64 can[Thread.Spawn, Thread.Join, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Atomics.Load]:
    can Thread.Spawn, Thread.Join, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Atomics.Load:
        handles: mutable uintptr[4] = zeroed
        entry: void& = arena_cache_worker.cast[void&]
        for index in 0..<4:
            _ = pthread_create(&handles[index], null, entry, null)
        for index in 0..<4:
            _ = pthread_join(handles[index], null)
        trusted [Unsafe.MutableGlobal, Global.Read, Global.Write]:
            return atomic_load_acquire(&__arena_cache_completed) - 4
