# Unknown type diagnostics must follow the selected static declaration and statement arms.
static if false:
    type InactiveAlias = InactiveAliasTarget
    type InactiveOnlyAlias = i64

    def inactive_parameter(value: InactiveParameterType) -> void:
        pass
static else:
    type ActiveAlias = ActiveAliasTarget

def active_parameter(value: ActiveParameterType) -> void:
    pass

# An alias declared only in a proven-inactive branch must not make an active type
# annotation appear resolved.
def active_use_of_inactive_alias(value: InactiveOnlyAlias) -> void:
    pass

# A possible alias from an unresolved target branch must not turn this into a
# definite cycle before the target branch is selected.
type PossibleCycleRoot = PossibleCycleBranch
static if PLATFORM_APPLE:
    type PossibleCycleBranch = PossibleCycleRoot

def possible_cycle_use(value: PossibleCycleRoot) -> void:
    pass

def local_types() -> void:
    static if false:
        hidden: InactiveLocalType = zeroed
    static else:
        active: ActiveLocalType = zeroed

def main() -> i64:
    return 0

module Outer:
    module Inner:
        const SELECT_INACTIVE: bool = false
        static if SELECT_INACTIVE:
            type NestedInactiveAlias = NestedInactiveAliasTarget
        static else:
            type NestedActiveAlias = NestedActiveAliasTarget
