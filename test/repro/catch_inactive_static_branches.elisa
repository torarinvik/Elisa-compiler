# Proven-inactive static branches must not contribute Catch diagnostics. This covers
# declaration scopes and statement blocks, with both expression and statement catches.
error Fault:
    Expected
    Other

extern expected_only() -> i64 error[Fault{Expected}]

static if false:
    def inactive_declaration_out_of_set() -> i64:
        catch expected_only():
            value:
                return value
            Fault.Other:
                return 0
            Phantom.Gone:
                return 0

    def inactive_declaration_param[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
        result: mutable i64 = 0
        catch callback():
            value:
                result = value
            plain:
                result = 0
        return result

def inactive_statement_out_of_set() -> i64:
    static if false:
        return catch expected_only():
            value: value
            Fault.Other: 0
            Phantom.Gone: 0
    return 0

def inactive_statement_param[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
    result: mutable i64 = 0
    static if false:
        catch callback():
            value:
                result = value
            plain:
                result = 0
    return result

def main() -> i64:
    return 0
