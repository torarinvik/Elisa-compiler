module Api:
    public:
        error Fault:
            Failed

        error Other:
            Rejected

        def origin() -> i64 error[Api::Fault]:
            raise Api::Fault.Failed

    private module Hidden:
        public:
            def wrap[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
                return try callback()

            def local_wrapper() -> i64 error[Api::Other]:
                return wrap(Api::origin)

module App:
    public:
        error Expected:
            Rejected

        def external_wrapper() -> i64 error[App::Expected]:
            return Api::Hidden::wrap(Api::origin)

def main() -> i64:
    return 0
