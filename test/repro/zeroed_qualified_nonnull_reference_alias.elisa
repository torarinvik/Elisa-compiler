module RefTypes:
    type MutableIntegerReference = mutable i64&
    type IntegerReferenceAlias = MutableIntegerReference

module NullableRefTypes:
    # Deliberately reuse both alias names with a safe nullable target. The checker must
    # resolve the requested module identity instead of whichever bare name it saw last.
    type MutableIntegerReference = mutable i64&?
    type IntegerReferenceAlias = MutableIntegerReference

def main() -> i64:
    pointer: mutable RefTypes::IntegerReferenceAlias = zeroed
    return 0
