# The declaration's Alive annotation is not the current state after this write.
struct Player[state Alive | Dead]:
    health: mutable i64
    tag: i64
    derive state:
        Alive when self.health > 0
        Dead when self.health <= 0

def kill_and_retag(player: mutable Player[Alive]) -> Player[Dead]:
    player.health <- 0
    return player{tag = 1}

def main() -> i32:
    original: Player[Alive] = Player[Alive]{health: 7, tag: 0}
    dead: Player[Dead] = kill_and_retag(original)
    return 1 if dead.health != 0 or dead.tag != 1
    return 2 if original.health != 7 or original.tag != 0
    return 0
