# COMP-010 conservative boundary.
#
# From top level, `A::Run` is an explicitly qualified external type, but the
# current semantic field channel only carries the bare owner `Run`.  `B::Run`
# is deliberately declared first with an incompatible field type.  The
# resolver must therefore return unknown instead of borrowing B's darray type
# while checking A's integer field.  Code generation still has the qualified
# local type and must execute the program correctly.

module B:
    struct Run:
        answer: mutable darray[i64]

module A:
    struct Run:
        answer: mutable i64

def main() -> i64:
    run: mutable A::Run = A::Run{answer: 41}
    if run.answer != 41:
        return 1
    run.answer <- run.answer + 1
    return run.answer - 42
