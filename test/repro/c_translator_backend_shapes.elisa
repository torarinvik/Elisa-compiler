# Small C-translator shapes. Keep these independent of any one translated project.

struct Hooks:
    allocate: mutable (fn(usize) -> mutable void&?)?
    deallocate: mutable (fn(mutable void&?) -> void)?
    reallocate: mutable (fn(mutable void&?, usize) -> mutable void&?)?

struct Item:
    next: mutable Item&?
    value: mutable i32

def elisa_nonnull[T](value: mutable T&?) -> mutable T&:
    if value == null:
        return zeroed
    return value

extern strlen(value: u8&?) -> usize
extern memcpy(destination: mutable void&?, source: void&?, count: usize) -> mutable void&?
extern signal(signum: i32, handler: mutable fn(i32) -> void) -> i32
extern register_callback(handler: mutable fn(i32) -> void) -> i32
@link_name("__error2")
extern __error2() -> mutable i32&?
extern make_item() -> mutable Item&?

def callback_sink(signum: i32) -> void:
    return

def install_callback() -> void:
    signal(1, ((callback_sink).cast[mutable fn(i32) -> void]).cast[fn(i32) -> void])

def install_callback_direct() -> void:
    signal(1, callback_sink)

def install_callback_generic() -> void:
    register_callback(callback_sink)

def install_callback_local() -> void:
    handler: mutable fn(i32) -> void = callback_sink
    register_callback(handler)

def error_store() -> i32:
    elisa_nonnull(__error2())[0] <- 25
    return 0

def direct_field_store() -> i32:
    elisa_nonnull(make_item()).value <- 2
    return 0

def translated_length(string: u8&?) -> mutable u64 can[Abort.Panic, Unsafe.PointerCast, Unsafe.BufferReinterpret, Unsafe.StaleRef]:
    can Abort.Panic, Unsafe.PointerCast, Unsafe.BufferReinterpret, Unsafe.StaleRef:
        length: mutable u64 = 0
        trusted Unsafe.StaleRef:
            if string == null:
                return 0
        trusted Unsafe.StaleRef:
            length <- strlen((string).cast[mutable u8&?]) + size_of[u8] * 1
        trusted Unsafe.StaleRef:
            return length

def allocate_item(hooks: Hooks&?) -> mutable Item&?:
    if hooks == null:
        return null
    assert hooks.allocate != null
    item: mutable Item&? = (hooks.allocate(size_of[Item])).cast[mutable Item&?]
    if item != null:
        trusted Unsafe.StaleRef:
            item.value <- 1
    return item

def walk(item: mutable Item&?) -> i32:
    cursor: mutable Item&? = item
    total: mutable i32 = 0
    while cursor != null:
        total <- total + cursor.value
        cursor <- cursor.next
    return total

def state_machine() -> i32:
    state: mutable i32 = 0
    while true:
        if state == 0:
            state <- 1
        elif state == 1:
            return 7
        else:
            break
    return state

def set_number(item: mutable Item&?, value: f64) -> f64:
    if item == null:
        return 0
    item.value <- value
    return value

def main() -> i64:
    error_store()
    return 0
