# Core prefers a reference overload whose mutability matches the actual reference.
error MutableFault:
    Bad

error ImmutableFault:
    Other

struct Node:
    value: i64

def choose(value: mutable Node&) -> i64 error[MutableFault]:
    return 1

def choose(value: Node&) -> i64 error[ImmutableFault]:
    return 2

def good_mutable(value: mutable Node&) -> i64 error[MutableFault]:
    return try choose(value)

def wrong_mutable(value: mutable Node&) -> i64 error[ImmutableFault]:
    return try choose(value)

def good_immutable(value: Node&) -> i64 error[ImmutableFault]:
    return try choose(value)

def wrong_immutable(value: Node&) -> i64 error[MutableFault]:
    return try choose(value)

def main() -> i64:
    return 0
