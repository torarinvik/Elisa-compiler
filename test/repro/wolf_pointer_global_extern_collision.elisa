struct SDL_Window:
    opaque: u8

@link_name("sdlWindow")
extern sdlWindow: mutable SDL_Window&?
@link_name("fullscreen")
extern fullscreen: mutable i8

global mutable sdlWindow: SDL_Window&? = zeroed
global mutable fullscreen: i8 = zeroed
global mutable screenWidth: u32 = zeroed
global mutable screenHeight: u32 = zeroed
global mutable screenBits: u32 = zeroed
global mutable windowFlags: u64 = zeroed

extern SDL_CreateWindow(title: u8&?, w: i32, h: i32, flags: u64) -> mutable SDL_Window&?

def set_window() -> void can[Abort.Panic, Global, Unsafe.PointerCast, Unsafe.BufferReinterpret, Unsafe.StaleRef]:
    can Abort.Panic, Global, Unsafe.PointerCast, Unsafe.BufferReinterpret, Unsafe.StaleRef:
        screenBits <- 8
        screenHeight <- ((screenWidth * 3) / 4)
        windowFlags: mutable u64 = 2
        if fullscreen != 0:
            windowFlags <- (windowFlags | 1)
        title: mutable u8&? = (&("Wolfenstein 3D")[0])
        sdlWindow <- SDL_CreateWindow(title, screenWidth, screenHeight, windowFlags)
        if not sdlWindow != null:
            windowFlags <- windowFlags | 4

def main() -> i64:
    set_window()
    return 0
