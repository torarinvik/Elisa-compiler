# The private enum is removed by static-if selection. PyModule must still see the
# active public enum from Values instead of falling back to the same-named root type.
module Values:
    static if false:
        private:
            const enum Mode of i64:
                High = 11
    static else:
        public:
            const enum Mode of i64:
                High = 22

const enum Mode of i64:
    High = 97

using Values

def selected_public_enum(value: i64 = Mode.High) -> i64:
    return value

def selected_public_enum_qualified(value: i64 = Values::Mode.High) -> i64:
    return value

export pymodule private_enum_inactive_static_branch:
    fn selected_public_enum
    fn selected_public_enum_qualified
