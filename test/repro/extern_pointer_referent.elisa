# An extern's POINTER RETURN keeps its scalar REFERENT: `-> u8&?` is a ref-to-u8, not an
# erased `heap void&`. With the referent dropped, `b: u8 = bound` after
# `if c_getenv(x) is bound:` found ref_target Void, the auto-deref never fired, and the
# 8-byte POINTER was stored into the 1-byte slot — the program then computed with the
# pointer's low byte (returned 116/124 instead of 47, varying with ASLR). stage0: 47
# ('/' — PATH's first byte on every Unix).
@link_name(getenv)
extern c_getenv(name: cstr) -> u8&?

def main() -> i64:
    name: mutable darray[u8] = []
    name.push(80)
    name.push(65)
    name.push(84)
    name.push(72)
    name.push(0)
    name_c: cstr = (&name[0]).cast[cstr] can Unsafe.PointerCast
    if c_getenv(name_c) is first_byte:
        b: u8 = first_byte
        return b.i64()
    return 3
