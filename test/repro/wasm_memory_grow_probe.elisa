@intrinsic("llvm.wasm.memory.grow.i32")
extern memory_grow(memory_index: u32, pages: u32) -> i32

@intrinsic("llvm.wasm.memory.size.i32")
extern memory_size(memory_index: u32) -> u32

def grow(pages: u32) -> i32:
    return memory_grow(0, pages)

def size() -> u32:
    return memory_size(0)

export fn wasm_memory_grow_probe(pages: u32) -> i32 = grow
export fn wasm_memory_size_probe() -> u32 = size
