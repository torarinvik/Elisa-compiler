# The declaration named Shared is in an unimported sibling module. It must not
# make the bare variant Shared unambiguous in Consumer.
error FirstFault:
    Shared

error SecondFault:
    Shared

module Hidden:
    public:
        error Shared:
            Local

module Consumer:
    def bad() -> i64 error[Shared]:
        return 1

def main() -> i64:
    return 0
