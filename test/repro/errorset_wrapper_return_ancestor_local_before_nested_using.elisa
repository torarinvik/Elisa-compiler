# Lexical declarations across the ancestor chain precede wildcard using imports.
# Consumer::Inner must resolve Consumer.wrap before Api.wrap from its nested `using`.
module Api:
    public:
        error ApiFault:
            Failed

        def source() -> i64 error[Api::ApiFault]:
            return 1

        def wrap(callback: fn() -> i64 error[Api::ApiFault]) -> i64 error[Api::ApiFault]:
            return try callback()

module Consumer:
    public:
        error LocalFault:
            Rejected

        def wrap(callback: fn() -> i64 error[Api::ApiFault]) -> i64 error[Consumer::LocalFault]:
            return 1

    module Inner:
        using Api

        public:
            def caller() -> i64 error[Consumer::LocalFault]:
                return wrap(Api::source)

def main() -> i64:
    return 0
