affine struct ProtocolHandle[state Closed | Open]:
    handle: i64
    transitions:
        Closed -> Open
        Open -> Closed

def acquire(file: ProtocolHandle[Closed]) -> ProtocolHandle[Open]:
    transition[Open](move file)

def independent_acquire(file: ProtocolHandle[Closed]) -> ProtocolHandle[Open]:
    transition[Open](move file)

def release(file: ProtocolHandle[Open]) -> ProtocolHandle[Closed]:
    transition[Closed](move file)

def main() -> i32:
    initial: ProtocolHandle[Closed] = ProtocolHandle[Closed]{handle: 73}
    opened: ProtocolHandle[Open] = acquire(move initial)
    closed: ProtocolHandle[Closed] = release(move opened)
    if closed.handle == 73:
        return 0
    return 1
