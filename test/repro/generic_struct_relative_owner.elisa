module Outer:
    module Wrong:
        struct Box[T]:
            padding: i64
            item: mutable T
    module Right:
        struct Box[T]:
            item: mutable T

    def run() -> i64:
        box: mutable Right::Box[i64] = zeroed
        box.item <- 42
        return box.item

def main() -> i64:
    return Outer::run()
