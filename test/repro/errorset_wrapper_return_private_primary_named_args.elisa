# Named arguments disable Core's free-call receiver rewrite. The first private
# registration remains the ordinary primary and must block EWR's public fallback.
module Provider:
    public:
        error ConcreteFault:
            Concrete

        error GenericFault:
            Generic

    private:
        def choose(value: i64) -> i64 error[Provider::ConcreteFault]:
            return 1

        def plain(value: i64) -> i64:
            return 2

    public:
        def choose[T](value: T) -> i64 error[Provider::GenericFault]:
            return 3

        def plain[T](value: T) -> i64 error[Provider::GenericFault]:
            return 4

from Provider import choose
from Provider import plain

module Consumer:
    public:
        error Expected:
            Rejected

        def private_fallible_primary(value: i64) -> i64 error[Consumer::Expected]:
            return choose(value: value)

        def private_infallible_primary(value: i64) -> i64 error[Consumer::Expected]:
            return plain(value: value)

def main() -> i64:
    return 0
