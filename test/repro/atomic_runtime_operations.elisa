include "../../elisacore_std/elisacore_runtime_atomics.elisa"

const ATOMIC_TEST_WORKER_COUNT: usize = 4
const ATOMIC_TEST_INCREMENT_COUNT: usize = 1024

extern pthread_create(thread: mutable uintptr&, attr: void&?, start_routine: void&, arg: void&?) -> i32 can[Thread.Spawn]
extern pthread_join(thread: uintptr, retval: mutable void&?) -> i32 can[Thread.Join]

global mutable __atomic_test_counter: AtomicCell[i64] = zeroed

def atomic_sequential_probe() -> bool can[Atomics.Load, Atomics.Store, Atomics.Exchange, Atomics.Rmw, Atomics.CompareExchange]:
    can Atomics.Load, Atomics.Store, Atomics.Exchange, Atomics.Rmw, Atomics.CompareExchange:
        cell: mutable AtomicCell[i64] = zeroed
        atomic_store_release(&cell, 4)
        exchanged: i64 = atomic_exchange_acqrel(&cell, 5)
        added: i64 = atomic_fetch_add_acqrel(&cell, 7)
        first_cas: bool = atomic_compare_exchange_acqrel(&cell, 12, 13)
        second_cas: bool = atomic_compare_exchange_acqrel(&cell, 12, 14)
        return exchanged == 4 and added == 5 and first_cas and not second_cas and atomic_load_acquire(&cell) == 13

def atomic_test_worker(arg: void&?) -> void&? can[Atomics.Load, Atomics.CompareExchange]:
    can Atomics.Load, Atomics.CompareExchange:
        _ = arg
        for iteration in 0..<ATOMIC_TEST_INCREMENT_COUNT:
            trusted [Unsafe.MutableGlobal, Global.Read, Global.Write]:
                observed: mutable i64 = atomic_load_acquire(&__atomic_test_counter)
                while not atomic_compare_exchange_acqrel(&__atomic_test_counter, observed, observed + 1):
                    observed <- atomic_load_acquire(&__atomic_test_counter)
        return null

def main() -> i64 can[Thread.Spawn, Thread.Join, Unsafe.PointerCast, Unsafe.UncheckedIndex, Atomics.Load, Atomics.Store, Atomics.Exchange, Atomics.Rmw, Atomics.CompareExchange, Abort.Panic]:
    can Thread.Spawn, Thread.Join, Unsafe.PointerCast, Unsafe.UncheckedIndex, Atomics.Load, Atomics.Store, Atomics.Exchange, Atomics.Rmw, Atomics.CompareExchange, Abort.Panic:
        if not atomic_sequential_probe():
            return 1
        handles: mutable uintptr[ATOMIC_TEST_WORKER_COUNT] = zeroed
        entry: void& = atomic_test_worker.cast[void&]
        for index in 0..<ATOMIC_TEST_WORKER_COUNT:
            status: i32 = pthread_create(&handles[index], null, entry, null)
            if status != 0:
                return 2
        for index in 0..<ATOMIC_TEST_WORKER_COUNT:
            status: i32 = pthread_join(handles[index], null)
            if status != 0:
                return 3
        trusted [Unsafe.MutableGlobal, Global.Read, Global.Write]:
            expected: i64 = ATOMIC_TEST_WORKER_COUNT.i64() * ATOMIC_TEST_INCREMENT_COUNT.i64()
            return 0 if atomic_load_acquire(&__atomic_test_counter) == expected else 4
