error RecoveryStoreFailure:
    Failed

def maybe() -> void error[RecoveryStoreFailure]:
    raise RecoveryStoreFailure.Failed

def good_dead_pattern_arm() -> i64:
    can Memory.Allocate, Abort.Panic:
        region outer(4096):
            outer_bytes: mutable darray[u8] @outer = [65.u8()]
            retained: mutable sview @outer = outer_bytes.as_sview()
            region inner(4096):
                inner_bytes: mutable darray[u8] @inner = [66.u8()]
                result: i64 = match true:
                    true:
                        0
                    false:
                        try maybe() else err:
                            retained <- inner_bytes.as_sview()
                        1
                return result
            return retained.len

def good_false_guard_arm() -> i64:
    can Memory.Allocate, Abort.Panic:
        region outer(4096):
            outer_bytes: mutable darray[u8] @outer = [65.u8()]
            retained: mutable sview @outer = outer_bytes.as_sview()
            region inner(4096):
                inner_bytes: mutable darray[u8] @inner = [66.u8()]
                result: i64 = match true:
                    true if false:
                        try maybe() else err:
                            retained <- inner_bytes.as_sview()
                        1
                    _:
                        0
                return result
            return retained.len

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        return good_dead_pattern_arm() + good_false_guard_arm()
