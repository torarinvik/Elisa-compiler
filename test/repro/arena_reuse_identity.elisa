# Reusing a reclaimed span in an earlier region must retain that region identity.
include "../../elisacore_std/arena.elisa"

module ArenaReuseRegression:
    private:
        const CAPACITY_SLOTS: usize = 16
        const INITIAL_SLOTS: usize = 4
        const REUSE_SLOTS: usize = 2
        const GROWN_SLOTS: usize = 20
        const FIRST_REGION: usize = 0
        const NEXT_REGION: usize = 1
        const SUCCESS_STATUS: i64 = 0
        const FAILURE_STATUS: i64 = 1

    public:
        def run() -> i64:
            backing: mutable heap Region& = new_region_backend(CAPACITY_SLOTS, ARENA_STRATEGY_CHAINED)
            arena: mutable Arena = Arena{begin: backing, end: backing, end_index: FIRST_REGION, strategy: ARENA_STRATEGY_CHAINED}
            initial: mutable heap void& = arena_alloc(&arena, INITIAL_SLOTS * size_of(uintptr))
            _ = arena_alloc(&arena, (CAPACITY_SLOTS - INITIAL_SLOTS) * size_of(uintptr))
            grown: mutable heap void& = arena_realloc(&arena, initial, INITIAL_SLOTS * size_of(uintptr), GROWN_SLOTS * size_of(uintptr))
            reused: mutable heap void& = arena_alloc(&arena, REUSE_SLOTS * size_of(uintptr))
            remainder: mutable heap void& = arena_alloc(&arena, (INITIAL_SLOTS - REUSE_SLOTS) * size_of(uintptr))
            correct: bool = initial.cast[uintptr] == reused.cast[uintptr] and grown.cast[uintptr] != initial.cast[uintptr] and arena.end_index == NEXT_REGION and remainder.cast[uintptr] == initial.cast[uintptr] + (REUSE_SLOTS * size_of(uintptr)).uintptr()
            arena_free(&arena)
            return SUCCESS_STATUS if correct else FAILURE_STATUS

def main() -> i64:
    return ArenaReuseRegression::run()
