def count_i64(values: set[i64]) -> usize:
    return values.count

def count_text(values: set[cstr]) -> usize:
    return values.count

def count_u8(values: set[u8]) -> usize:
    return values.count

def count_bool(values: set[bool]) -> usize:
    return values.count

def roundtrip_i64(values: set[i64]) -> set[i64]:
    return values

def roundtrip_i8(values: set[i8]) -> set[i8]:
    return values

def roundtrip_text(values: set[cstr]) -> set[cstr]:
    return values

def roundtrip_u8(values: set[u8]) -> set[u8]:
    return values

def empty_i64() -> set[i64]:
    return {}

export pymodule sets:
    fn count_i64
    fn count_text
    fn count_u8
    fn count_bool
    fn roundtrip_i64
    fn roundtrip_i8
    fn roundtrip_text
    fn roundtrip_u8
    fn empty_i64
