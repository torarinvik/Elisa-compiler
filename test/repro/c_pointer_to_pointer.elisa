# C-translator backend regression: `memptr *` becomes a pointer to a pointer.
# Both the slot write and the pointer-sized index read must remain raw LLVM ptrs.

def store_pointer_slot(output: mutable void&&?) -> i64 can[Abort.Panic, Unsafe.PointerCast, Unsafe.BufferReinterpret, Unsafe.StaleRef]:
    can Abort.Panic, Unsafe.PointerCast, Unsafe.BufferReinterpret, Unsafe.StaleRef:
        trusted Unsafe.StaleRef:
            output[0] <- null
    return 0

def load_pointer_slot(output: mutable void&&?) -> mutable void&? can[Abort.Panic, Unsafe.PointerCast, Unsafe.BufferReinterpret, Unsafe.StaleRef]:
    can Abort.Panic, Unsafe.PointerCast, Unsafe.BufferReinterpret, Unsafe.StaleRef:
        trusted Unsafe.StaleRef:
            return output[0]
    return null

def main() -> i64:
    value: mutable void&? = null
    slot: mutable void&&? = (&value).cast[mutable void&&?]
    _ = store_pointer_slot(slot)
    return 0 if load_pointer_slot(slot) == null else 1
