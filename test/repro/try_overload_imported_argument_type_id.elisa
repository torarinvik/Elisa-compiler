# The imported direct call supplies a concrete bool TypeId to receiver overload ranking.
module Consumer:
    module Helpers:
        public:
            def make_flag() -> bool:
                return true

    from Helpers import make_flag

    public:
        error BoolFault:
            BoolCase

        error IntegerFault:
            IntegerCase

        def choose(value: bool) -> i64 error[Consumer::BoolFault]:
            raise Consumer::BoolFault.BoolCase

        def choose(value: i64) -> i64 error[Consumer::IntegerFault]:
            raise Consumer::IntegerFault.IntegerCase

        def caller() -> i64 error[Consumer::IntegerFault]:
            return try choose(make_flag())

        def caller_correct_family() -> i64 error[Consumer::BoolFault]:
            return try choose(make_flag())

def main() -> i64:
    return 0
