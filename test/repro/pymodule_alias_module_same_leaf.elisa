# If an alias shares a spelling with a real module, Stage0 resolves the alias target for
# qualified enum defaults even when the real module contains the same enum leaf.
module Mode:
    public:
        const enum Kind of i64:
            Closed = 1

module Other:
    public:
        const enum Kind of i64:
            Ready = 57

using Other as Mode

def alias_wins(value: Mode::Kind = Mode::Kind.Ready) -> Mode::Kind:
    return value

export pymodule alias_module_same_leaf:
    fn alias_wins
