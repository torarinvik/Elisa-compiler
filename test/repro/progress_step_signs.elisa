# The progress report must not claim that zero or wrong-sign updates move a loop
# variable toward its bound. Exercise compound assignments and explicit updates in
# both comparison directions.
def zero_compound_increment() -> void:
    n: mutable i64 = 0
    while n < 3:
        n += 0

def wrong_compound_increment() -> void:
    n: mutable i64 = 0
    while n < 3:
        n -= 1

def zero_explicit_increment() -> void:
    n: mutable i64 = 0
    while n < 3:
        n <- n + 0

def wrong_explicit_increment() -> void:
    n: mutable i64 = 0
    while n < 3:
        n <- n - 1

def wrong_compound_increment_negative_step() -> void:
    n: mutable i64 = 0
    while n < 3:
        n += -1

def wrong_explicit_increment_negative_step() -> void:
    n: mutable i64 = 0
    while n < 3:
        n <- n + -1

def zero_compound_decrement() -> void:
    n: mutable i64 = 3
    while n > 0:
        n -= 0

def wrong_compound_decrement() -> void:
    n: mutable i64 = 3
    while n > 0:
        n += 1

def zero_explicit_decrement() -> void:
    n: mutable i64 = 3
    while n > 0:
        n <- n - 0

def wrong_explicit_decrement() -> void:
    n: mutable i64 = 3
    while n > 0:
        n <- n + 1

def wrong_compound_decrement_negative_step() -> void:
    n: mutable i64 = 3
    while n > 0:
        n -= -1

def wrong_explicit_decrement_negative_step() -> void:
    n: mutable i64 = 3
    while n > 0:
        n <- n - -1

def valid_compound_increment() -> void:
    n: mutable i64 = 0
    while n < 3:
        n += 1

def valid_explicit_increment() -> void:
    n: mutable i64 = 0
    while n < 3:
        n <- n + 1

def valid_compound_decrement() -> void:
    n: mutable i64 = 3
    while n > 0:
        n -= 1

def valid_explicit_decrement() -> void:
    n: mutable i64 = 3
    while n > 0:
        n <- n - 1

def unrecognized_compound_decrement_negative_step() -> void:
    n: mutable i64 = 3
    while n > 0:
        n += -1

def unrecognized_explicit_decrement_negative_step() -> void:
    n: mutable i64 = 3
    while n > 0:
        n <- n + (-1)

def unrecognized_compound_increment_negative_subtract() -> void:
    n: mutable i64 = 0
    while n < 3:
        n -= -1

# Grouping parentheses are erased by the normal parser, leaving the same IntLit
# step as the unparenthesized positive controls.
def valid_compound_increment_parenthesized_positive_step() -> void:
    n: mutable i64 = 0
    while n < 3:
        n += (1)

def compound_decrement_rhs_mimics_explicit_increment() -> void:
    n: mutable i64 = 0
    while n < 3:
        n -= n + 1

def shadow_assignment_mimics_explicit_increment() -> void:
    n: mutable i64 = 0
    while n < 3:
        n = n + 1

def valid_explicit_increment_parenthesized_positive_step() -> void:
    n: mutable i64 = 0
    while n < 3:
        n <- n + (1)

# Stage1 stores integer literals as signed i64. This positive source magnitude
# wraps to the minimum signed value, so subtracting it is not proven to decrease.
def positive_magnitude_parses_as_negative_minimum() -> void:
    n: mutable i64 = 3
    while n > 0:
        n <- n - 9223372036854775808

def unary_negative_minimum_step_is_unproven() -> void:
    n: mutable i64 = 0
    while n < 3:
        n <- n + -9223372036854775808
