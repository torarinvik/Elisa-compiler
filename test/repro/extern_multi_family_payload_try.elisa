# Route the C-returned error set through a named propagating `try` call before catching it.
error FirstError:
    Empty
    # Excluded by the restricted set below; it must not widen the ABI payload.
    Other(values: i64[4])

error SecondError:
    Missing(value: u32)
    Other

extern external_probe(code: i64) -> i64 error[FirstError{Empty}, SecondError]

def relay() -> i64 error[FirstError{Empty}, SecondError]:
    return try external_probe(0)

def use() -> i64:
    return catch relay():
        value: value
        FirstError.Empty: 1
        SecondError.Missing(payload): payload.i64()
        SecondError.Other: 4

def main() -> i64:
    return use() + 1
