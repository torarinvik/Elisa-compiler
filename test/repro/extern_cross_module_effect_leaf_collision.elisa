# Same-leaf externs in separate modules must not share the first declaration's effect row.
module First:
    extern inspect() -> void can[Disk.Read]

module Second:
    extern inspect() -> void can[Console.Write]

def block_grant_call() -> void:
    can Console.Write:
        Second::inspect()

def postfix_grant_call() -> void:
    Second::inspect() can Console.Write
