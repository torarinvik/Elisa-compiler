# Same-leaf externs in separate modules must not share the first declaration's effect row.
effect Writer[T]:
    def write(value: T) -> void

module First:
    extern inspect() -> void can[Unsafe.Alias]
    extern inspect_via() -> void can[Writer[sview] via Memory.Allocate]
    def shared_source_worker() -> void can[Unsafe.Alias]:
        can Unsafe.Alias:
            First::inspect()

module Second:
    extern inspect() -> void can[Console.Write]
    extern inspect_via() -> void can[Writer[sview] via Console.Write]
    extern inspect_value() -> i64 can[Console.Write]
    extern inspect_multi() -> void can[Memory.Allocate, Console.Write]
    def shared_source_worker() -> void can[Console.Write]:
        can Console.Write:
            Second::inspect()

def shared_source_caller() -> void:
    Second::shared_source_worker()

def shared_source_grant_caller() -> void:
    can Unsafe.Alias:
        Second::shared_source_worker()

module NestedFirst:
    module Child:
        def nested_module_worker() -> void can[Unsafe.Alias]:
            pass

module NestedSecond:
    module Child:
        def nested_module_worker() -> void can[Console.Write]:
            pass

def nested_module_caller() -> void:
    NestedSecond::Child::nested_module_worker()

# This call precedes the selective import below. A bare name is unresolved here,
# even though same-leaf extern declarations exist in both modules.
def unresolved_bare_call() -> void:
    can Unsafe.Alias:
        inspect()

from Second import inspect, inspect_value

def block_grant_call() -> void:
    can Console.Write:
        Second::inspect()

def postfix_grant_call() -> void:
    Second::inspect() can Console.Write

def block_wrong_grant_call() -> void:
    can Unsafe.Alias:
        Second::inspect()

def postfix_wrong_grant_call() -> void:
    Second::inspect() can Unsafe.Alias

def imported_wrong_grant_call() -> void:
    can Unsafe.Alias:
        inspect()

def via_wrong_grant_call() -> void:
    can Writer[sview]:
        Second::inspect_via()

# A local callback with the same leaf name shadows only a bare call. Qualified
# module calls must still select Second.inspect's Console.Write row.
def qualified_shadow_outside(inspect: fn() -> void) -> void:
    Second::inspect()

def qualified_shadow_block(inspect: fn() -> void) -> void:
    can Unsafe.Alias:
        Second::inspect()

# The imported bare name is shadowed by the callback parameter. Calling it in a
# grant block must not surface Second.inspect's Console.Write row on this function.
def imported_shadow_call(inspect: fn() -> void) -> void:
    can Unsafe.Alias:
        inspect()

def call_imported_shadow() -> void:
    imported_shadow_call(source_noop)

# Effect sources inside an enclosing function need the selected extern row too;
# otherwise callers of these wrappers lose the propagated Console requirement.
def qualified_source_worker() -> void:
    can Console.Write:
        Second::inspect()

def qualified_source_caller() -> void:
    qualified_source_worker()

def imported_source_worker() -> void:
    can Console.Write:
        inspect()

def imported_source_caller() -> void:
    imported_source_worker()

# A return expression is also an effect source even though it is not a Stmt.Expr.
def imported_return_source_worker() -> i64:
    can Console.Write:
        return inspect_value()

def imported_return_source_caller() -> i64:
    return imported_return_source_worker()

# A local callback shadows the imported inspect and must not inherit its Console row.
def callback_source_shadow(inspect: fn() -> void) -> void:
    inspect()

def callback_source_caller() -> void:
    callback_source_shadow(source_noop)

# The block tail shares names introduced by its statement list. A local callback named
# inspect must shadow the selectively imported extern for that final expression.
def source_noop() -> void:
    pass

def source_int_noop() -> i64:
    return 0

def imported_block_tail_shadow(callback: fn() -> i64) -> void:
    can Unsafe.Alias:
        ignored: i64 =
            inspect, callback_copy = callback, callback
            inspect()

def call_imported_block_tail_shadow() -> void:
    imported_block_tail_shadow(source_int_noop)

# The wrapper's inferred rows must retain both capabilities from the selected extern.
def multi_source_worker() -> void:
    Second::inspect_multi()

def multi_source_caller() -> void:
    multi_source_worker()
