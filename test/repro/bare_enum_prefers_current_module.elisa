# A bare enum name in a match means the current module's enum. Before the fix the
# exhaustiveness check merged variants from every module declaring `Kind` and
# reported "non-exhaustive match over \"Kind\"; missing members: Kind.None".

include "../../elisacore_std/elisacore_runtime.elisa"

module Gestures:
    public:
        const enum Kind of i32:
            None = 0
            Tap = 1

module Ops:
    public:
        enum Kind:
            Smooth
            Median
            Despike

        def code(kind: Kind) -> i32:
            match kind:
                Kind.Smooth:
                    return 10
                Kind.Median:
                    return 20
                Kind.Despike:
                    return 30

def main() -> i32:
    return 1 if Ops::code(Ops::Kind.Despike) != 30
    return 2 if Ops::code(Ops::Kind.Smooth) != 10
    return 0
