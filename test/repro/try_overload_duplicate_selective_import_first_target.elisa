# A conflicting later selective import must not become a receiver candidate.
# Core keeps the first program-level alias for `choose` and reports the conflict.
module First:
    public:
        error FirstError:
            Bad

        def choose[T](receiver: T) -> i64 error[FirstError]:
            return 1

        def choose[T](receiver: T, extra: i64) -> i64 error[FirstError]:
            return 2

module Second:
    public:
        error SecondError:
            Bad

        def choose(receiver: i64) -> i64 error[SecondError]:
            return 3

from First import choose
from Second import choose

module App:
    public:
        def mismatched(receiver: i64) -> i64 error[Second::SecondError]:
            return try choose(receiver)

def main() -> i64:
    return 0
