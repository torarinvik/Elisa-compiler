# A proven-inactive alias must not make the active scalar alias ambiguous.
module Safe:
    type Plain = i64

module Wrong:
    type Plain = sview

using Safe as Pick

static if false:
    using Wrong as Pick

# Repeated aliases of the same target retain one effective registration. Include both
# direct-over-branch and branch-over-branch rows so zeroed lookup cannot count raw rows.
using Safe as DirectBranchPick
static if true:
    using Safe as DirectBranchPick

static if true:
    using Safe as BranchFirstPick
    using Safe as BranchFirstPick

# Separate branch chains in one module are visited in source order. The first
# definite alias remains the analyzer-wide module alias winner.
static if true:
    using Safe as BranchRootPick

static if true:
    using Wrong as BranchRootPick

# The outer branch block pre-registers its direct alias before descending into a nested
# branch, even though the nested alias appears earlier in source order.
static if true:
    static if true:
        using Wrong as NestedBranchPick
    using Safe as NestedBranchPick

def main() -> i64:
    value: Pick::Plain = zeroed
    direct_branch_value: DirectBranchPick::Plain = zeroed
    branch_first_value: BranchFirstPick::Plain = zeroed
    branch_root_value: BranchRootPick::Plain = zeroed
    nested_branch_value: NestedBranchPick::Plain = zeroed
    return value + direct_branch_value + branch_first_value + branch_root_value + nested_branch_value
