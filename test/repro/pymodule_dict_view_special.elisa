# Dictionary values may be any of the ordinary first-class view element families.
def roundtrip_sview(values: dict[i64, view[sview]]) -> dict[i64, view[sview]]:
    return values

def roundtrip_cstr(values: dict[sview, view[cstr]]) -> dict[sview, view[cstr]]:
    return values

def roundtrip_objects(values: dict[i64, view[py::Object]]) -> dict[i64, view[py::Object]]:
    return values

def roundtrip_optional(values: dict[i64, view[i64?]]) -> dict[i64, view[i64?]]:
    return values

def roundtrip_optional_text(values: dict[sview, view[sview?]]) -> dict[sview, view[sview?]]:
    return values

def roundtrip_optional_objects(values: dict[i64, view[py::Object?]]) -> dict[i64, view[py::Object?]]:
    return values

export pymodule dict_view_special:
    fn roundtrip_sview
    fn roundtrip_cstr
    fn roundtrip_objects
    fn roundtrip_optional
    fn roundtrip_optional_text
    fn roundtrip_optional_objects
