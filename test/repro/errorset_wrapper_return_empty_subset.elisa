module Provider:
    public:
        error Fault:
            Available

        def get_empty() -> i64 error[Provider::Fault{}]:
            return 0

        def get_available() -> i64 error[Provider::Fault{Available}]:
            return 0

        def wrap[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
            return try callback()

using Provider::get_empty
using Provider::get_available
using Provider::wrap

def return_empty_subset() -> i64 error[Provider::Fault{Available}]:
    return wrap(get_empty)

def return_empty_destination() -> i64 error[Provider::Fault{}]:
    return wrap(get_available)

def main() -> i64:
    return 0
