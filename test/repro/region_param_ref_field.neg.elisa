struct P:
    names: mutable darray[u8]
    n: i32

def add(p: mutable P&, c: u8) -> void:
    p.names.push(c)

def main() -> i32:
    p: mutable P = P{names: [], n: 1}
    add(&p, 7.u8())
    return p.names.count.i32() - 1

struct Store:
    bytes: mutable darray[u8]

struct Q:
    names: mutable Store&
    n: i32

def put(q: Q&, c: u8) -> void:
    q.names.bytes.push(c)

# A caller that forwards its own ref parameter binds the region (stage0 lookupRegionParam).
def forward(q: Q&) -> i32:
    put(q, 1.u8())
    return q.n
