# A reference to a fixed array points at the array aggregate. Indexing it must
# advance by one element, not by the size of the whole array.
#
# This is a generic wire-decoder shape: read a u32 from a byte buffer at a
# dynamic byte offset through an explicitly trusted cast.
def read_u32(wire: mutable u8[64]&, offset: usize) -> u32:
    trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic, Unsafe.UncheckedIndex]:
        slot: u32& = (&wire[offset]).cast[u32&]
        return slot
