struct UiGeo:
    x: f32
    y: f32
    width: f32
    height: f32
    grow: f32

enum Widget:
    pass

enum Container is Widget:
    Box(geo: UiGeo, axis: i32, child: Widget?)

enum Control is Widget:
    Label(geo: UiGeo, text: sview)

enum Button is Control:
    Push(geo: UiGeo, label: sview)

def widget_geo(w: Widget) -> UiGeo:
    match w:
        Container.Box(geo, axis, child):
            return geo
        Control.Label(geo, text):
            return geo
        Button.Push(geo, label):
            return geo

def main() -> i64:
    return 0
