# Two modules may declare the same enum name without sharing its variant values.
# The module owner is part of enum identity: Beta.Complete is ordinal 2, not the
# Alpha.Complete ordinal 1. A wrong lookup silently changes a comparison result.

include "../../elisacore_std/elisacore_runtime.elisa"

module Alpha:
    enum State:
        Receiving
        Complete

    struct Work:
        state: mutable State

    def make() -> Work:
        value: mutable Work = zeroed
        value.state <- State.Complete
        return value

    def is_complete(value: Work) -> bool:
        return value.state == State.Complete

module Beta:
    enum State:
        Empty
        Receiving
        Complete
        Failed

    struct Work:
        state: mutable State

    def make() -> Work:
        value: mutable Work = zeroed
        value.state <- State.Complete
        return value

    def is_complete(value: Work) -> bool:
        return value.state == State.Complete

def main() -> i64:
    alpha: Alpha::Work = Alpha::make()
    beta: Beta::Work = Beta::make()
    return 0 if alpha.state == Alpha::State.Complete and beta.state == Beta::State.Complete else 1
