# Named structs can carry read-only views. Python sequences are copied into the
# temporary call arena and copied back on return, just like top-level view values.
struct ViewBatch:
    values: view[i64]
    text: view[sview]
    objects: view[py::Object]
    bytes: view[u8]

def roundtrip(batch: ViewBatch) -> ViewBatch:
    return batch

def total(batch: ViewBatch) -> i64:
    result: mutable i64 = 0
    for value in batch.values:
        result <- result + value
    return result

export pymodule struct_views:
    fn roundtrip
    fn total
