# A null callback is a valid null function pointer at an extern boundary.
#
# The compact extern-parameter metadata retains the callable alias but not the
# postfix `?`, so the backend must accept `null` for the resulting Fn-shaped
# parameter just as stage0 does.
type Callback = fn(mutable void&?, mutable void&?, mutable void&?) -> void
extern install(callback: Callback?) -> mutable void&?

def configure(user: mutable void&?) -> void:
    installed: mutable void&? = install(null)
    return

export fn extern_null_callback_smoke(user: mutable void&?) -> void = configure
