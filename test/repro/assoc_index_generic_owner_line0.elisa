protocol IndexKey:
    def slot(self: Self) -> i64

struct Key:
    value: i64

impl IndexKey for Key:
    def slot(self: Self) -> i64:
        return 0

#line 0 bounded-owner.elisa
def bounded[T: IndexKey](values: array[i64, 8], key: T) -> i64:
    can Unsafe.UncheckedIndex:
        return values[T.slot(key)]

#line 0 ordinary-owner.elisa
def ordinary(values: array[i64, 8], T: Key) -> i64:
    return values[T.slot()]

#line 20 actual-bound-owner.elisa
def actual_bound[T: IndexKey](values: array[i64, 8], key: T) -> i64:
    return values[T.slot(key)]
