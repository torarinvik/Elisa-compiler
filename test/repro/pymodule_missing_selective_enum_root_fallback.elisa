# A selective target without Mode is an absent Core candidate. The raw root Mode remains
# available after that single program-wide importAliases entry is checked.
module Provider:
    public:
        const enum OtherMode of i64:
            High = 41

const enum Mode of i64:
    High = 97

from Provider import Mode

def root_fallback(value: i64 = Mode.High) -> i64:
    return value

export pymodule missing_selective_enum_root_fallback:
    fn root_fallback
