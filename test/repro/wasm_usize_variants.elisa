# Bounds from a literal, a named const, a parameter, and a computed expression; zero and
# one iterations; nonzero start; nested; break/continue; while-loop equivalents; loop value
# used for indexing, arithmetic, comparison, argument and return.
const LIMIT: usize = 16
global mutable cells: mutable i32[64] = zeroed

def sum_to(n: usize) -> i32:
    total: mutable i32 = 0
    for i in 0..<n:
        total <- total + i.i32()
    return total

def by_literal() -> i32:
    total: mutable i32 = 0
    for i in 0..<16:
        total <- total + i.i32()
    return total

def by_const() -> i32:
    total: mutable i32 = 0
    for i in 0..<LIMIT:
        total <- total + i.i32()
    return total

def by_computed(n: usize) -> i32:
    total: mutable i32 = 0
    for i in 0..<(n * 2 + 1):
        total <- total + i.i32()
    return total

def zero_iter() -> i32:
    total: mutable i32 = 100
    for i in 0..<0:
        total <- total + 1
    return total

def one_iter() -> i32:
    total: mutable i32 = 0
    for i in 5..<6:
        total <- total + i.i32()
    return total

def nested_break_continue() -> i32:
    total: mutable i32 = 0
    for i in 0..<8:
        continue if i == 2
        for j in 0..<8:
            break if j == 3
            total <- total + (i * 8 + j).i32()
    return total

def while_equiv(n: usize) -> i32:
    total: mutable i32 = 0
    i: mutable usize = 0
    while i < n:
        total <- total + i.i32()
        i <- i + 1
    return total

def index_use() -> i32:
    for i in 0..<64:
        cells[i] <- (i * 3).i32()
    picked: mutable i32 = 0
    for i in 0..<64:
        picked <- picked + cells[i] if i > 60 else picked
    return picked

export fn sum_to(n: usize) -> i32 = sum_to
export fn by_literal() -> i32 = by_literal
export fn by_const() -> i32 = by_const
export fn by_computed(n: usize) -> i32 = by_computed
export fn zero_iter() -> i32 = zero_iter
export fn one_iter() -> i32 = one_iter
export fn nested_break_continue() -> i32 = nested_break_continue
export fn while_equiv(n: usize) -> i32 = while_equiv
export fn index_use() -> i32 = index_use
