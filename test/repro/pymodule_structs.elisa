struct Point:
    x: i64
    small: i32
    y: f64
    ratio: f32
    label: cstr
    text: sview
    flag: bool
    payload: py::Object

def roundtrip(point: Point) -> Point:
    return point

def score(point: Point) -> f64:
    return point.x.f64() + point.y if point.flag else point.y

export pymodule structs:
    fn roundtrip
    fn score
