enum Widget layout(handle: u32):
    common:
        x: f32
        y: f32
        w: f32
        h: f32
    pass

enum Control is Widget:
    Label(text: sview)

enum Button is Control:
    Push(value: f32)

def make_button() -> Widget:
    return Button.Push(x: 1.0, y: 2.0, w: 30.0, h: 10.0, value: 7.0)
