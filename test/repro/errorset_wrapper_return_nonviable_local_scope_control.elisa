# Ordinary free-call lookup binds the lexical name before checking its argument type.
module Provider:
    public:
        error ProviderFault:
            Failed

        def choose(value: i64) -> i64 error[Provider::ProviderFault]:
            return 1

        def plain(value: i64) -> i64 error[Provider::ProviderFault]:
            return 2

from Provider import choose
from Provider import plain

module Consumer:
    public:
        error ConsumerFault:
            Rejected

        def choose(value: bool) -> i64 error[Consumer::ConsumerFault]:
            return 3

        def plain(value: bool) -> i64:
            return 4

        def fallible_local(value: i64) -> i64 error[Consumer::ConsumerFault]:
            return choose(value)

        def infallible_local(value: i64) -> i64 error[Consumer::ConsumerFault]:
            return plain(value)

def main() -> i64:
    return 0
