# An EXTERN parameter typed as a CONST ENUM denotes the enum's backing scalar.
#
# stage1 declined this and emitted nothing (exit 2) while stage0 compiles it. The extern
# parameter resolver tried scalar names, `cstr`, and opaque aliases, but never the const
# enum registry — an asymmetry with ORDINARY functions, which resolve the same annotation
# through annotation_value_type and always worked.
#
# It cost the standard library its console output: `extern runtime_write(fd:
# FileDescriptor, buf: void&, count: usize)` has exactly this shape, so both `printr` and
# `print` overloads declined on `_ = runtime_write(FileDescriptor.Output, …)` and were
# dropped — every program calling `print` failed to link. Invisible until the overload fix,
# because those functions were skipped by NAME and never reached emission.
#
# The const-enum DECLARATION also pins `-emit ast`, which used to omit it entirely: stage0
# prints `const enum FD of int: (2 members)` for a const enum and nothing for a plain one.
const enum FD of int:
    Input = 0
    Output = 1

extern probe_write(fd: FD, buf: void&, count: usize) -> isize

def main() -> i64:
    # Declared, not CALLED: the declaration alone is what declined, and calling write(2)
    # here would make the fixture's answer depend on its environment.
    return FD.Output.i64() + FD.Input.i64()
