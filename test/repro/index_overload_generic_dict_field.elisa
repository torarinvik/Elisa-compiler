include "../../elisacore_std/elisacore_runtime.elisa"
include "../../elisacore_std/collections.elisa"

module cpp:
    struct Entry[V]:
        value: mutable V

    struct Box[K, V]:
        storage: mutable dict[K, Entry[V]]

    def nonnull[T](value: mutable T&?) -> mutable T&:
        if value == null:
            return zeroed
        return value

    impl[K, V] Index for Box[K, V]:
        type Key = K
        type Elem = Entry[V]

        def __index__(self: mutable Box[K, V]&, key: K) -> Entry[V]&:
            entry: mutable Entry[V]& = nonnull(arena_dict_get_or_insert_or_panic(&perm_arena, self.storage, key, zeroed))
            return entry

    def contains[K, V](self: Box[K, V]&, key: K) -> bool:
        return arena_dict_contains(self.storage, key)

global mutable box: cpp::Box[i32, i32] = zeroed

def main() -> i64:
    if box.contains(7):
        return 2
    box[7].value <- 42
    if not arena_dict_contains(box.storage, 7):
        return 5
    if not box.contains(7):
        return 3
    if box[7].value != 42:
        return 4
    return 0
