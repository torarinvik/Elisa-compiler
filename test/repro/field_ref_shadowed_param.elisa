# A loop binding shadows a refined parameter. Its field-construction value is
# unrefined even though the outer parameter carries a `where` fact.
struct Positive:
    value: i64 where value > 0

def check(value: i64 where value > 0, inputs: darray[i64]) -> i64:
    total: mutable i64 = 0
    for value in inputs |total|:
        item: Positive = Positive{value: value}
        total <- total + item.value
    return total

def control_unshadowed(value: i64) -> Positive:
    return Positive{value: value}

def main() -> i64:
    inputs: darray[i64] = [0]
    return check(1, inputs)
