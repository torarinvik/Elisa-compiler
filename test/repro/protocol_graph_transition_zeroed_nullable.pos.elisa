module Owner:
    affine struct Lease[state Open | Closed]:
        value: u64
        transitions:
            Open -> Closed

    module Nested:
        def zeroed_lease() -> Owner::Lease[Open]:
            return zeroed

module Client:
    def absent_lease() -> Owner::Lease[Open]?:
        return zeroed

def main() -> i32:
    return 0
