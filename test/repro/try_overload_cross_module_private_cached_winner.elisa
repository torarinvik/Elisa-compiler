# The receiver-ranked UFCS set can include a hidden row from a different imported module.
module LibA:
    public:
        error GenericFault:
            Generic

        def choose[T](receiver: T) -> i64 error[LibA::GenericFault]:
            return 1

module AliasInstaller:
    from LibB import choose
    public:
        module LibB:
            public:
                error ConcreteFault:
                    Concrete

            private:
                def choose(receiver: i64) -> i64 error[AliasInstaller::LibB::ConcreteFault]:
                    return 2

using LibA

module App:
    public:
        error Destination:
            Other

        def private_winner_direct(value: i64) -> i64 error[App::Destination]:
            return try choose(value)

        def private_winner_cached(value: i64) -> i64 error[App::Destination]:
            payload = choose(value)
            return try payload

        def public_winner_direct(value: bool) -> i64 error[App::Destination]:
            return try choose(value)

        def public_winner_cached(value: bool) -> i64 error[App::Destination]:
            payload = choose(value)
            return try payload

def main() -> i64:
    return 0
