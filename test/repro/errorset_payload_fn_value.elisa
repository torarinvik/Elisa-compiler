error Payload:
    Bad(code: i64)

def ok(value: i64) -> i64 error[Payload]:
    return value

def bad(value: i64) -> i64 error[Payload]:
    raise Payload.Bad(value)

def apply[errorset R](f: fn(i64) -> i64 error[R], value: i64) -> i64 error[R]:
    result: i64 = try f(value)
    return result + 1

def main() -> i64:
    good: i64 = try apply(ok, 6) else 40
    failed: i64 = try apply(bad, 6) else 20
    closed: i64 = try apply(fn(value: i64) -> i64 error[Payload] => value + 2, 6) else 30
    return good + failed + closed
