module First:
    public:
        error Fault:
            Bad

module Second:
    public:
        error Fault:
            Other

def choose[T](value: T) -> i64 error[Second::Fault]:
    return 2

def choose(value: i64) -> i64 error[First::Fault]:
    return 1

def wrapper(value: i64) -> i64 error[First::Fault]:
    return try choose(value)

def wrong_destination(value: i64) -> i64 error[Second::Fault]:
    return try choose(value)

def main() -> i64 error[First::Fault]:
    return wrapper(1)
