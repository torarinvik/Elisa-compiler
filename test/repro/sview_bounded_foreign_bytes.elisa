include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

def main() -> i64 can[Abort.Panic, Unsafe.PointerCast]:
    # This storage deliberately has no NUL terminator. The explicitly supplied extent is
    # the only valid way to construct a view over it.
    bytes: mutable u8[3] = [65, 66, 67]
    first: u8& = &bytes[0]
    bounded: sview = unsafe_sview_bounded_bytes(first, 3.usize())
    if bounded.len != 3 or sview_at(bounded, 2.usize()) != 67.u8():
        return -1
    return bounded.len
