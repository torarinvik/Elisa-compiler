error A:
    Bad
error B:
    Bad
def consume(callback: fn() -> i64 error[A]) -> i64:
    return 1
def good() -> i64:
    return consume(fn() => raise A.Bad)
def bad() -> i64:
    return consume(fn() => raise B.Bad)
def consume_pure(callback: fn() -> i64) -> i64:
    return 1
def bad_pure() -> i64:
    return consume_pure(fn() => raise A.Bad)
module API:
    public:
        def consume(callback: fn() -> i64 error[A]) -> i64:
            return 1

def qualified_good() -> i64:
    return API::consume(fn() => raise A.Bad)
def qualified_bad() -> i64:
    return API::consume(fn() => raise B.Bad)
