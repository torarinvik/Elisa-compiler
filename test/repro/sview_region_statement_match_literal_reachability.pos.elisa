def safe_literal_arm() -> i64:
    can Memory.Allocate, Abort.Panic:
        region outer(4096):
            outer_bytes: mutable darray[u8] @outer = [65.u8()]
            retained: mutable sview @outer = outer_bytes.as_sview()
            region inner(4096):
                inner_bytes: mutable darray[u8] @inner = [66.u8()]
                local: mutable sview = ""
                match 1:
                    0:
                        local <- inner_bytes.as_sview()
                    1:
                        local <- retained
                retained <- local
                return retained.len
            return retained.len

def safe_false_guard() -> i64:
    can Memory.Allocate, Abort.Panic:
        region outer(4096):
            outer_bytes: mutable darray[u8] @outer = [65.u8()]
            retained: mutable sview @outer = outer_bytes.as_sview()
            region inner(4096):
                inner_bytes: mutable darray[u8] @inner = [66.u8()]
                local: mutable sview = ""
                match 1:
                    1 if false:
                        local <- inner_bytes.as_sview()
                    _:
                        local <- retained
                retained <- local
                return retained.len
            return retained.len

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        return safe_literal_arm() + safe_false_guard()
