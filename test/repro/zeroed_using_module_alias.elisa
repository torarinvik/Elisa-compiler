module Views:
    type BorrowedText = sview
    type Pointer = mutable i64&
    struct Slot:
        value: i64
    type SlotId = id[Slot]

using Views as V

def invalid_text() -> i64:
    text: V::BorrowedText = zeroed
    return 0

def invalid_pointer() -> i64:
    pointer: V::Pointer = zeroed
    return 0

def invalid_handle() -> V::SlotId:
    handle: V::SlotId = zeroed
    return handle

def main() -> i64:
    return 42
