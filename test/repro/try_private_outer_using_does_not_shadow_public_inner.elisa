module HiddenApi:
    public:
        error HiddenFault:
            Hidden

    private:
        def ping() -> i64 error[HiddenApi::HiddenFault]:
            raise HiddenApi::HiddenFault.Hidden

using HiddenApi

module Consumer:
    module Inner:
        module VisibleApi:
            public:
                error VisibleFault:
                    Visible

                def ping() -> i64 error[Consumer::Inner::VisibleApi::VisibleFault]:
                    raise Consumer::Inner::VisibleApi::VisibleFault.Visible

        using VisibleApi

        public:
            def direct_caller() -> i64 error[Consumer::Inner::VisibleApi::VisibleFault]:
                return try ping()

            def cached_caller() -> i64 error[Consumer::Inner::VisibleApi::VisibleFault]:
                payload = ping()
                return try payload

def main() -> i64:
    return 0
