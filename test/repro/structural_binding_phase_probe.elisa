include "../../src/semantic/semantic.elisa"

extend Semantic:
    public:
        def isolation_resolve_count(file: Ast::File&) -> usize can[Memory.Allocate, Abort.Panic]:
            table: mutable SymbolTable = collect_symbols(file)
            table <- intern_file_types(file, &table)
            table <- resolve_declarations(file.top_decls, table)
            return table.diagnostics.count

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    source: u8& = "struct IsolationRow:\n    value: i64\ndef first_row(rows: darray[IsolationRow]&) -> IsolationRow can[Abort.Panic]:\n    return rows[0]\ndef last_row(rows: darray[i64]&) -> i64 can[Abort.Panic]:\n    return rows[0]\ndef main() -> i32 can[Memory.Allocate, Abort.Panic]:\n    rows: mutable darray[i64] = [1, 2]\n    return 0\n"
    tokens: darray[Lexer::Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    return 1 if file.errors.count != 0
    return 2 if Semantic::isolation_resolve_count(&file) != 0
    table: Semantic::SymbolTable = Semantic::check(&file)
    for diagnostic in table.diagnostics:
        return 3 if Semantic::diagnostic_severity(diagnostic) == 1
    region diagnostic_scope:
        diagnostics: mutable darray[Semantic::Diagnostic] = []
        Semantic::check_full_diagnostics(&file, &diagnostics, false, false, false, false, false, false, false, false, false, false, 64, false, true, false)
        for diagnostic in diagnostics:
            return 4 if Semantic::diagnostic_severity(diagnostic) == 1
    return 0
