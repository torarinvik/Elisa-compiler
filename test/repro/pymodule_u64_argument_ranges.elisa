# Required and optional u64 scalar inputs must reject values above UINT64_MAX.
struct U64Record:
    value: u64
    optional: u64?
    values: darray[u64]
    optional_values: darray[u64?]
    nested_values: darray[darray[u64]]
    optional_nested_values: darray[darray[u64?]]
    view_values: view[u64]
    optional_view_values: view[u64?]

def required_u64(value: u64) -> u64:
    return value

def optional_u64(value: u64?) -> u64?:
    return value

def roundtrip_u64_list(values: darray[u64]) -> darray[u64]:
    return values

def roundtrip_u64_set(values: set[u64]) -> set[u64]:
    return values

def roundtrip_u64_dict(values: dict[u64, u64]) -> dict[u64, u64]:
    return values

def roundtrip_optional_u64_dict(values: dict[u64, u64?]) -> dict[u64, u64?]:
    return values

def roundtrip_u64_nested_dict(values: dict[u64, darray[u64]]) -> dict[u64, darray[u64]]:
    return values

def roundtrip_u64_view(values: view[u64]) -> view[u64]:
    return values

def roundtrip_u64_view_list(values: darray[view[u64]]) -> darray[view[u64]]:
    return values

def roundtrip_u64_optional_view_list(values: darray[view[u64?]]) -> darray[view[u64?]]:
    return values

def first_u64_fixed(values: array[u64, 2]) -> u64:
    return values[0]

def roundtrip_u64_record(value: U64Record) -> U64Record:
    return value

export pymodule u64_argument_ranges:
    fn required_u64
    fn optional_u64
    fn roundtrip_u64_list
    fn roundtrip_u64_set
    fn roundtrip_u64_dict
    fn roundtrip_optional_u64_dict
    fn roundtrip_u64_nested_dict
    fn roundtrip_u64_view
    fn roundtrip_u64_view_list
    fn roundtrip_u64_optional_view_list
    fn first_u64_fixed
    fn roundtrip_u64_record
