# An Arena-taking function has no hidden caller slot (stage0 funcHasArenaParam), so
# growing a reference parameter outside `in a:` has no region to grow into. stage0
# rejects both; stage1 used to grow into its own auto region and free it (UAF).
def mixed2(a: mutable Arena&, ys: mutable darray[u32]&):
    in a:
        _ = 1
    ys.push(2)

def plain_arena(a: mutable Arena&, ys: mutable darray[u32]&):
    ys.push(2)

def main() -> int:
    return 0
