# A local alias that resolves to an imported ErrorSet still names that ErrorSet.
module Provider:
    public:
        error Fault:
            Failed

module Consumer:
    type AliasFault = Provider::Fault

    def forward[errorset AliasFault](callback: fn() -> i64 error[AliasFault]) -> i64 error[AliasFault]:
        return try callback()

def main() -> i64:
    return 0
