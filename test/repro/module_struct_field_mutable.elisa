# Two modules declaring a struct of the same name, where the SAME field name is
# mutable in one and immutable in the other.
#
# Field rows are keyed by bare struct name, so the first row found decided
# mutability for every module's struct: assigning `Beta::Grade.floor` reported
# `field "floor" is immutable` because Alpha's is. nw-core has four modules each
# declaring a `Grade` with a `floor`, and only maze's is immutable.
#
# Alpha is declared FIRST on purpose: its row is the one a bare `Grade` finds.
#
# Exits 7 = the assigned floor.

include "../../elisacore_std/elisacore_runtime.elisa"

module Alpha:
    struct Grade:
        floor: i64

    def make() -> Grade:
        can Abort.Panic:
            return Grade{floor: 1}

module Beta:
    struct Grade:
        floor: mutable i64

    def make() -> Grade:
        can Abort.Panic:
            g: mutable Grade = Grade{floor: 0}
            g.floor <- 7
            return g

def main() -> i64:
    can Abort.Panic:
        b: Beta::Grade = Beta::make()
        return b.floor
