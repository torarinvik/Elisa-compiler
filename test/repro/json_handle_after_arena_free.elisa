include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"
include "../../elisacore_std/elisacore_json.elisa"

def stale_json_string() -> i64:
    can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        arena: mutable Arena = zeroed
        parsed: JsonParseResult[arena] = json_parse_checked(&arena, sview("\"borrowed\"", 0, -1))
        handle: JsonValueHandle[arena] = json_handle_from_result(parsed)
        arena_free(&arena)
        text: sview = try json_handle_as_string(handle) else sview("", 0, -1)
        return text[0].i64()

def main() -> i64:
    return stale_json_string()
