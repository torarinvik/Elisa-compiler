struct atomic[T]:
    value: mutable T

enum MemoryOrder:
    Relaxed
    Acquire
    Release
    AcqRel
    SeqCst

extern compare_exchange(slot: mutable atomic[i64]&, expected: i64, desired: i64, success: MemoryOrder, failure: MemoryOrder) -> bool

def main() -> i64:
    slot: mutable atomic[i64] = atomic[i64]{value: 0}
    swapped: bool = compare_exchange(&slot, 0, 1, MemoryOrder.Release, MemoryOrder.Acquire)
    return 0 if swapped else 1
