# Generic optional payloads must keep their concrete payload type during narrowing.

def choose[T](value: T?, fallback: T) -> T:
    return present if value is present else fallback

def maybe_value(value: i64) -> i64?:
    return value if value > 0 else null

def main() -> i64:
    return choose[i64](maybe_value(4), 10)
