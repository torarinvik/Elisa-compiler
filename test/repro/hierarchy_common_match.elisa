# User-defined sealed hierarchy with a dynamic AoS row, inherited side-table commons,
# payload matching, and `is` narrowing. The compiler AST's fixed row must not be used here.
enum Widget layout(handle: u32):
    common:
        x: f32
        y: f32
        w: f32
        h: f32
    pass

enum Control is Widget:
    Label(text: sview)

enum Button is Control:
    Push(value: i64)

def make_button() -> Widget:
    return Button.Push(x: 1.0, y: 2.0, w: 30.0, h: 10.0, value: 42)

def match_value(v: Widget) -> i64:
    match v:
        Button.Push(value):
            return value
        Control.Label(text):
            return 0

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        b: Widget = make_button()
        return match_value(b) - 42
