include "../../elisacore_std/elisacore_runtime.elisa"

# `set[T]` end to end, with NO source declaration of the set layout anywhere.
#
# collections.elisa declares DictBucket/DynDict, but `DynSet`/`SetBucket` are stage0 BACKEND
# BUILTINS — there is no template to instantiate, so stage1 declined every set program at its
# DECLARATION, with add / membership / count all unreachable behind it. The layouts are now
# registered directly, in stage0's field order (read from its own `-emit llvm`):
#
#   %SetBucket__i64 = type { i64, i8 }
#   %DynSet__i64    = type { ptr, i64, i64, i64, ptr }
#
# `SetBucket[T]` needs a memo row of its own, not just `set[T]`: the std NAMES it directly
# (arena_set_find_index walks an `items: SetBucket[T]&`), and without it every helper body
# that mentioned it declined — leaving `arena_set_add__T` DECLARED but bodiless while
# `arena_set_add_or_panic__T` still called it. That shape ran and answered 0 for `count`
# while `contains` said true, which is why this fixture reads the count back rather than
# only asking whether a key is present.
#
# The set must GROW: 40 keys rehash several times, so a wrong bucket stride or a wrong
# `items` offset shows up as a lost key rather than a crash.
#
# stage0 answers 127 — every bit.
struct Bag:
    seen: mutable set[u64]
    tag: i64


def note(bag: lmut Bag, key: u64) -> void can[Memory.Allocate, Abort.Panic]:
    bag.seen <- bag.seen.add(key)


def population(seen: set[u64]&) -> i64 can[Abort.Panic]:
    return seen.count.i64()


def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    score: mutable i64 = 0

    # A local: add is idempotent, so the count is 2 and not 3.
    direct: mutable set[i64] = {}
    direct <- direct.add(3)
    direct <- direct.add(5)
    direct <- direct.add(3)
    score <- score + 1 if direct.count == 2.usize()
    score <- score + 2 if 3 in direct
    score <- score + 4 if not (4 in direct)

    # A set LITERAL, which lowers to a zeroed header plus one add per element.
    literal: set[i64] = {2, 4, 6}
    score <- score + 8 if literal.count == 3.usize()
    score <- score + 16 if 4 in literal

    # A set in a STRUCT FIELD, mutated through a callee, grown past its initial capacity.
    bag: mutable Bag = Bag{seen: {}, tag: 5}
    for index in 0..<40 |bag| -> bag:
        bag <- note(bag, index.u64())
    present: mutable i64 = 0
    for index in 0..<40 |bag, present|:
        present <- present + 1 if index.u64() in bag.seen
    score <- score + 32 if present == 40
    # Through a `set[T]&` PARAMETER — the borrowed spelling.
    score <- score + 64 if population(bag.seen) == 40

    return score
