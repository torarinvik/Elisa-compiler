error Failure:
    Bad

def selected(seed: i64, extra: i64 = 7, enabled: bool = false) -> i64 error[Failure]:
    raise Failure.Bad if seed < 0
    return seed + extra + (1 if enabled else 0)

def main() -> i64:
    return catch selected(5, enabled: true):
        value:
            0 if value == 13 and via_statement() == 13 else 1
        error failure:
            2

def via_statement() -> i64:
    catch selected(enabled: true, seed: 5):
        value:
            return value
        error failure:
            return 99
