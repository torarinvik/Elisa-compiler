# A module member's RETURN TYPE is written bare, and two modules declare a struct
# of the same name with different layouts.
#
# The signature was resolved with no owner set, so `Beta::make` was DECLARED as
# returning `%Alpha.Grade` -- three fields where the real one has five. The call
# then stored 24 bytes into a 40-byte local and everything past Alpha's end read
# back 0. Both structs were emitted correctly and every field inside the shorter
# one was right; only the tail was wrong.
#
# A SILENT WRONG ANSWER, not a decline, and one that needs a struct-name
# collision to appear at all -- which is why it only surfaced once nw-core had
# four modules each declaring a `Grade`.
#
# Alpha is declared FIRST on purpose: its row is the one a bare `Grade` finds.
#
# Exits 80 = a.c(3.0)*10 + b.t(25.0)*2.

include "../../elisacore_std/elisacore_runtime.elisa"

module Alpha:
    struct Grade:
        a: i64
        b: i64
        c: f64

    def make() -> Grade:
        can Abort.Panic:
            return Grade{a: 1, b: 2, c: 3.0}

module Beta:
    struct Grade:
        p: i64
        q: i64
        r: i64
        s: i64
        t: f64

    def make() -> Grade:
        can Abort.Panic:
            return Grade{p: 1, q: 2, r: 3, s: 4, t: 25.0}

def main() -> i64:
    can Abort.Panic:
        a: Alpha::Grade = Alpha::make()
        b: Beta::Grade = Beta::make()
        return (a.c * 10.0).i64() + (b.t * 2.0).i64()
