include "../../elisacore_std/elisacore_runtime.elisa"

error FileError:
    NotFound
    Busy

extern read_value(flag: bool) -> i64 error[FileError]

def load(flag: bool) -> i64:
    catch read_value(flag):
        value:
            return value
        FileError.NotFound:
            return 1
        FileError.Busy:
            return 2
    return 0
