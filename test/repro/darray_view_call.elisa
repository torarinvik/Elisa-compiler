def count(xs: view[i64]) -> i64:
    return xs.len.i64()

def first(xs: view[i64]) -> i64 can[Abort.Panic]:
    return xs[0]

def nonempty() -> i64 can[Memory.Allocate, Abort.Panic]:
    xs: darray[i64] = [7, 9]
    return first(xs) + count(xs)

def empty() -> i64 can[Memory.Allocate]:
    xs: darray[i64] = []
    return count(xs)

export pymodule darray_view_call:
    fn nonempty
    fn empty
