# A local type shadows an imported same-named error set during Core's bare-name
# resolution. The error item therefore denotes the unique Fault.Expected variant.
module SetProvider:
    public:
        error Expected:
            SetTag

from SetProvider import Expected

module Imported:
    struct Expected:
        marker: i64

    def origin() -> i64 error[Expected]:
        return 1

error Fault:
    Expected

error Other:
    Trouble

def good_destination() -> i64 error[Fault]:
    return try Imported::origin()

def wrong_destination() -> i64 error[Other]:
    return try Imported::origin()

def main() -> i64:
    return 0
