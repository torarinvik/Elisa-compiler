# Each chain chooses one provider, but the chains can both contribute competing imports.
module FirstProvider:
    public:
        def competing() -> i64:
            return 1

module SecondProvider:
    public:
        def competing() -> i64:
            return 2

module ThirdProvider:
    public:
        def competing() -> i64:
            return 3

module FourthProvider:
    public:
        def competing() -> i64:
            return 4

static if ELISA_TARGET_OS_WASI:
    from FirstProvider import competing
static else:
    from SecondProvider import competing

static if ELISA_TARGET_OS_WASI:
    from ThirdProvider import competing
static else:
    from FourthProvider import competing

def main() -> i64:
    return competing()
