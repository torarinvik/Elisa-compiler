# The identical private signature spelling resolves through two source-offset aliases.
# The payload layouts differ, so the backend must not reuse the first ABI row for the
# later `E::Fault{Bad}` occurrence in the same module.
module First:
    error Fault:
        Bad(value: i64)

module Second:
    error Fault:
        Bad(left: i64, right: i64)

module Rebound:
    using First as E

    extern first_external() -> i64 error[E::Fault{Bad}]

    def first() -> i64 error[E::Fault{Bad}]:
        raise E::Fault.Bad(31)

    using Second as E

    extern second_external() -> i64 error[E::Fault{Bad}]

    def second() -> i64 error[E::Fault{Bad}]:
        raise E::Fault.Bad(41, 43)

    def catch_first() -> i64:
        return catch first():
            value: value
            First::Fault.Bad(payload): payload

    def catch_second() -> i64:
        return catch second():
            value: value
            Second::Fault.Bad(left, right): left + right

def main() -> i64:
    return 1 if Rebound::catch_first() != 31
    return 2 if Rebound::catch_second() != 84
    return 0
