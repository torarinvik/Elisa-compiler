# The identical private signature spelling resolves through aliases in sibling modules.
# The payload layouts differ, so the backend must not reuse the first ABI row for the
# other module’s `E::Fault{Bad}` occurrence.
module First:
    error Fault:
        Bad(value: i64)

module Second:
    error Fault:
        Bad(left: i64, right: i64)

module FirstScope:
    using First as E

    @link_name("first_external")
    extern first_external() -> i64 error[E::Fault{Bad}]

    def catch_first() -> i64:
        return catch first_external():
            value: value
            First::Fault.Bad(payload): payload

module SecondScope:
    using Second as E

    @link_name("second_external")
    extern second_external() -> i64 error[E::Fault{Bad}]

    def catch_second() -> i64:
        return catch second_external():
            value: value
            Second::Fault.Bad(left, right): left + right

def main() -> i64:
    return 1 if FirstScope::catch_first() != 31
    return 2 if SecondScope::catch_second() != 84
    return 0
