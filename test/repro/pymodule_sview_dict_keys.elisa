struct Point:
    x: i64
    label: sview

def roundtrip(values: dict[sview, sview]) -> dict[sview, sview]:
    return values

def roundtrip_points(values: dict[sview, Point]) -> dict[sview, Point]:
    return values

def count(values: dict[sview, i64]) -> usize:
    return values.count

export pymodule sview_dict_keys:
    fn roundtrip
    fn roundtrip_points
    fn count
