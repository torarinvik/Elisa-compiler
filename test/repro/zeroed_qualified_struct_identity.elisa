module Safe:
    struct Carrier:
        value: i64

module Unsafe:
    type BorrowedText = sview
    struct Carrier:
        view: BorrowedText

using Unsafe as U

def invalid_direct() -> i64:
    carrier: Unsafe::Carrier = zeroed
    return 0

def invalid_import() -> i64:
    carrier: U::Carrier = zeroed
    return 0

def main() -> i64:
    return 42
