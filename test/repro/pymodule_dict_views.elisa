def roundtrip(values: dict[i64, view[i64]]) -> dict[i64, view[i64]]:
    return values

def roundtrip_bytes(values: dict[sview, view[u8]]) -> dict[sview, view[u8]]:
    return values

def roundtrip_optional_uintptr(values: dict[i64, view[uintptr?]]) -> dict[i64, view[uintptr?]]:
    return values

export pymodule dict_views:
    fn roundtrip
    fn roundtrip_bytes
    fn roundtrip_optional_uintptr
