# Imports from opposite arms of a known static-if chain do not conflict.
module FirstProvider:
    public:
        def choose() -> i64:
            return 1

module SecondProvider:
    public:
        def choose() -> i64:
            return 2

const USE_FIRST_PROVIDER: bool = true

static if USE_FIRST_PROVIDER:
    from FirstProvider import choose
static else:
    from SecondProvider import choose

def main() -> i64:
    return choose()
