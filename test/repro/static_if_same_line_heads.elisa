# Distinct source heads can share a logical line after #line. The first branch is selected;
# the second chain's false arm must remain out of the emitted module.
#line 40 first-head.elisa
static if true:
    def active_first() -> i64:
        return 1

#line 40 second-head.elisa
static if false:
    def inactive_second() -> i64:
        return 2
static else:
    def active_second() -> i64:
        return 3

def main() -> i64:
    return active_first() + active_second()
