# A local alias to a non-ErrorSet type wins over an imported same-named ErrorSet.
module Provider:
    public:
        error Fault:
            Failed

module Consumer:
    type Fault = i64

    def forward[errorset Fault](callback: fn() -> i64 error[Fault]) -> i64 error[Fault]:
        return try callback()

from Provider import Fault

def main() -> i64:
    return 0
