# Regression: a large sret constructor must accept empty darray fields. The stage1 parser
# constructor has this shape repeatedly, and one declined field used to drop the whole compiler.
struct LargeWithArray:
    words: i64[200]
    items: darray[i64]

def make_large() -> LargeWithArray:
    return LargeWithArray{words: zeroed, items: []}

def main() -> i64:
    value: LargeWithArray = make_large()
    return value.words[0]
