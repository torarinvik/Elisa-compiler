# Same-owner values remain comparable when another module has identically named
# enum and alias declarations.
module North:
    const enum Code of i64:
        Zero = 0
        Seven = 7

    type Token = Code

    def same_bare_owner(value: Code) -> bool:
        return value == Code.Seven

    def same_alias_owner(value: Token) -> bool:
        return value == Code.Seven

module South:
    const enum Code of i64:
        Zero = 0
        Seven = 7

    type Token = Code

    def same_bare_owner(value: Code) -> bool:
        return value == Code.Seven

    def same_alias_owner(value: Token) -> bool:
        return value == Code.Seven

def main() -> i64:
    north_ok: bool = North::same_bare_owner(North::Code.Seven) and North::same_alias_owner(North::Code.Seven)
    south_ok: bool = South::same_bare_owner(South::Code.Seven) and South::same_alias_owner(South::Code.Seven)
    return 0 if north_ok and south_ok else 1
