enum Choice:
    First
    Second
    Other

def match_or_pattern(value: Choice) -> bool:
    match value:
        Choice.First | Choice.Second:
            return true
        _:
            return false

def when_sview_or_pattern(value: sview) -> bool:
    return when value:
        "short" | "longer" -> true
        _ -> false

def when_cstr_or_pattern(value: cstr) -> bool:
    return when value:
        "short" | "longer" -> true
        _ -> false

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    text: cstr = "longer"
    if not match_or_pattern(Choice.Second):
        return 1
    if not when_sview_or_pattern("longer"):
        return 2
    if not when_cstr_or_pattern(text):
        return 3
    return 42
