# A nearer callable extern shadows the parent generic, even though the extern has no
# errorset parameter metadata of its own.
module Parent:
    public:
        def invoke[errorset R]() -> i64 error[R]:
            return 1

        module Child:
            public:
                extern invoke() -> i64

                def call_local_extern() -> i64:
                    return invoke()

def main() -> i64:
    return 0
