# Common-field metadata must be keyed by the declaring module as well as the
# bare enum name. Two module-local packed enums intentionally use different
# common fields and different row layouts.
module Alpha:
    packed enum Result:
        common:
            @storage(inline)
            alpha: i64
        Ok(value: i64)

    def read(owner: Arena) -> i64:
        store: Alpha::Result.Store[Local] = Alpha::Result.Store(owner)
        result: mutable i64 = 0
        in store:
            value: Alpha::Result = new Alpha::Result.Ok(alpha: 11, value: 101)
            result <- match value:
                Alpha::Result.Ok(v): value.alpha + v
        return result

module Beta:
    packed enum Result:
        common:
            @storage(inline)
            beta: f32
        Failed(value: i64)

    def read(owner: Arena) -> i64:
        store: Beta::Result.Store[Local] = Beta::Result.Store(owner)
        result: mutable i64 = 0
        in store:
            value: Beta::Result = new Beta::Result.Failed(beta: 2.5, value: 22)
            result <- 22 if value.beta == 2.5 else 0
        return result

def main() -> i64:
    region r(4096):
        return 0 if Alpha::read(r) == 112 and Beta::read(r) == 22 else 1
