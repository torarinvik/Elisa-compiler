# A relative module alias target is resolved from the alias declaration's module.
module RootProvider:
    public:
        error Fault:
            Expected
            Missing

module Outer:
    module Inner:
        public:
            error Fault:
                Expected
                Missing
            extern load() -> i64 error[Outer::Inner::Fault]

    module Caller:
        using Inner as Local
        using RootProvider as RootLocal

        extern sibling_load() -> i64 error[Local::Fault]
        extern root_load() -> i64 error[RootLocal::Fault]

        def relative_alias_incomplete() -> i64:
            catch Local::load():
                value: 0
                Outer::Inner::Fault.Expected: 1
            return 0

        def sibling_alias_family_incomplete() -> i64:
            catch sibling_load():
                value: 0
                Outer::Inner::Fault.Expected: 1
            return 0

        def root_alias_family_incomplete() -> i64:
            catch root_load():
                value: 0
                RootProvider::Fault.Expected: 1
            return 0

def main() -> i64:
    return 0
