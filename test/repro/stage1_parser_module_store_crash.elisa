# Minimized from readonly_lookup_smoke.elisa. The candidate test runner faults
# while the parser builds AST nodes for this nested module/function shape.
include "../../src/semantic/semantic.elisa"

using Ast

def parse_fixture(source: u8&) -> Ast::File:
    can Memory.Allocate, Abort.Panic:
        length: mutable usize = 0
        while source[length] != 0 |length|:
            length <- length + 1
        tokens: darray[Token] = frontend_tokenize_with_length(source, source, length)
        return frontend_parser_parse_file(source, tokens)

@test
def test_parse_one_module_function() -> void can[Memory.Allocate, Abort.Panic]:
    source: u8& = "module One:\n    def only() -> i64:\n        return 1\n"
    file: Ast::File = parse_fixture(source)
    assert file.errors.count == 0
    assert file.top_decls.count == 1

@test
def test_parse_two_modules_with_same_function_name() -> void can[Memory.Allocate, Abort.Panic]:
    source: u8& = "module First:\n    def same() -> i64:\n        return 1\nmodule Second:\n    def same() -> i64:\n        return 2\n"
    file: Ast::File = parse_fixture(source)
    assert file.errors.count == 0
    assert file.top_decls.count == 2

@test
def test_parse_module_local_same_named_helpers() -> void can[Memory.Allocate, Abort.Panic]:
    source: u8& = "def mutate(value: mutable i64&):\n    pass\ndef choose(value: mutable i64&):\n    pass\ndef choose(value: i64&):\n    pass\ndef ordinary(value: i64):\n    mutate(value)\ndef exercise(value: i64&):\n    mutate(value)\n    choose(value)\n    mutate(value: value)\nstruct RefBox:\n    value: i64\nmodule RefProducer:\n    def gap(value: mutable RefBox&):\n        pass\nmodule RefConsumer:\n    def gap(value: i64) -> i64:\n        return value\n    def probe(box: RefBox&) -> i64:\n        return gap(box.value)\n"
    file: Ast::File = parse_fixture(source)
    assert file.errors.count == 0
    assert file.top_decls.count == 8
