@packed_profile(build_heavy)
packed enum Node:
    Absent
    Invalid
    Number(value: i64)

def run(owner: Arena) -> i64:
    store: Node.Store[Local] = Node.Store(owner)
    result: mutable i64 = 0
    in store:
        a: Node = new Node.Absent
        b: Node = new Node.Invalid
        c: Node = new Node.Number(value: 1)
        match a:
            Node.Absent or Node.Invalid:
                result <- result + 20
            _:
                result <- 1000
        match b:
            Node.Absent or Node.Invalid:
                result <- result + 22
            _:
                result <- 1000
        match c:
            Node.Absent or Node.Invalid:
                result <- 1000
            _:
                pass
    return result

def main() -> i64:
    region r(4096):
        return run(r)
