# Error-union propagation where the SUCCESS value is an AGGREGATE, through a GENERIC.
error ParseFail:
    Empty
    TooLong

struct Pair:
    left: i64
    right: i64

def pick[T](items: darray[T]&, index: i64) -> T error[ParseFail]:
    if items.count == 0:
        raise ParseFail.Empty
    if index.usize() >= items.count:
        raise ParseFail.TooLong
    return items[index.usize()]

def widen(p: Pair) -> Pair error[ParseFail]:
    singleton: mutable darray[Pair] = []
    singleton.push(p)
    q: Pair = try pick(singleton, 0)
    return Pair{left: q.left * 2, right: q.right + 1}

def main() -> i64:
    base: mutable darray[Pair] = []
    base.push(Pair{left: 10, right: 20})
    first: Pair = try pick(base, 0) else Pair{left: 0, right: 0}
    grown: Pair = try widen(first) else Pair{left: -100, right: 0}
    missing: Pair = try pick(base, 5) else Pair{left: 1, right: 0}
    empty: mutable darray[Pair] = []
    absent: Pair = try pick(empty, 0) else Pair{left: 1, right: 0}
    # grown = {20, 21}; missing.left = 1; absent.left = 1 -> 20+21+1+1 = 43
    return grown.left + grown.right + missing.left + absent.left
