# Try's cached non-call type facts must ignore an alias from a known-inactive
# static-if branch when both arms declare the same spelling.
const USE_INTEGER_PAYLOAD: bool = true
const USE_NESTED_INTEGER_PAYLOAD: bool = false
const USE_ALIAS_PAYLOAD: bool = true

static if USE_INTEGER_PAYLOAD:
    static if USE_NESTED_INTEGER_PAYLOAD:
        type Payload = bool
    static else:
        type Payload = i64
static else:
    static if true:
        type Payload = f64

static if USE_ALIAS_PAYLOAD:
    type NumberOrRecord = i64
static else:
    struct NumberOrRecord:
        value: i64

def bad(value: Payload) -> i64:
    return try value

def bad_inactive_record_shadow(value: NumberOrRecord) -> NumberOrRecord:
    return try value

def main() -> i64:
    return 0
