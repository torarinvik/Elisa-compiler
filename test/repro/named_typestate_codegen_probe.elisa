struct ProtocolFile[state Open | Closed]:
    is_open: mutable bool
    derive state:
        Open when self.is_open == true
        Closed when self.is_open == false

def read(file: ProtocolFile[Open]&) -> bool:
    return file.is_open

def make() -> ProtocolFile[Open]:
    return ProtocolFile[Open]{is_open: true}

def main() -> i64:
    file: ProtocolFile[Open] = ProtocolFile[Open]{is_open: true}
    return 0 if read(&file) else 1
