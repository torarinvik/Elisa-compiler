error ProbeError:
    Failed

def maybe_view(value: sview) -> sview error[ProbeError]:
    raise ProbeError.Failed
    return value

def consume_views(values: darray[sview]) -> void:
    pass

def bad(fallback: sview) -> sview:
    can Memory.Allocate, Abort.Panic:
        region inner(4096):
            inner_bytes: mutable darray[u8] @inner = [65.u8()]
            view: sview = inner_bytes.as_sview()
            consume_views([try maybe_view(view) else return view])
        return fallback

def main() -> i64:
    return 0
