struct Prm:
    name: sview
    has_default: bool

struct P:
    source: sview
    params: mutable darray[Prm]

def fill(items: mutable darray[Prm]&, name: sview) -> void:
    can Memory.Allocate, Abort.Panic:
        items.push(Prm{name: name, has_default: false})

def handler(parser: mutable P&) -> void:
    can Memory.Allocate, Abort.Panic:
        buf: mutable darray[u8] = []
        captures: mutable darray[Prm] = []
        fill(captures, parser.source)
        for capture in captures:
            parser.params.push(capture)

def main() -> i32:
    return 0
