struct Prm:
    name: sview
    ok: bool

struct H:
    xs: darray[sview]

def scan(binders: mutable darray[Prm]&, places: mutable darray[H]&) -> void can[Memory.Allocate, Abort.Panic]:
    pass

def collect(out: mutable darray[H]&) -> void can[Memory.Allocate, Abort.Panic]:
    binders: mutable darray[Prm] = []
    binders.push(Prm{name: "a", ok: true})
    places: mutable darray[H] = []
    scan(binders, places)
    for p in places:
        out.push(p)

def main() -> i32:
    return 0
