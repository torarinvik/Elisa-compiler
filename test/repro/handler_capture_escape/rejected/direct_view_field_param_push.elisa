struct T:
    diags: mutable darray[sview]

def report(diags: mutable darray[sview]&, table: mutable T&) -> void:
    can Memory.Allocate, Abort.Panic:
        buf: darray[u8] = [65, 66]
        table.diags.push(buf.as_sview())

def main() -> i32:
    can Memory.Allocate, Abort.Panic:
        diags: mutable darray[sview] = []
        t: mutable T = T{diags: []}
        report(diags, t)
        return diags.count.i32()
