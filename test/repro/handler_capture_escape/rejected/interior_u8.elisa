struct H:
    xs: darray[sview]

def scan(binders: mutable darray[u8]&, places: mutable darray[H]&) -> void can[Memory.Allocate, Abort.Panic]:
    pass

def collect(out: mutable darray[H]&) -> void can[Memory.Allocate, Abort.Panic]:
    binders: mutable darray[u8] = []
    binders.push(1)
    places: mutable darray[H] = []
    scan(binders, places)
    index: mutable usize = 0
    while index < places.count |index|:
        out.push(places[index])
        index <- index + 1

def main() -> i32:
    return 0
