def report(diags: lmut darray[sview]) -> void:
    can Memory.Allocate, Abort.Panic:
        buf: darray[u8] = [65, 66]
        diags.push(buf.as_sview())

def main() -> i32:
    can Memory.Allocate, Abort.Panic:
        diags: mutable darray[sview] = []
        diags <- report(diags)
        return diags.count.i32()
