struct Statstruct:
    tilex: mutable u8
    tiley: mutable u8
    shapenum: mutable i16
    visspot: mutable u8&?
    flags: mutable u32
    itemnumber: mutable u8

struct C_0xadf3d9ec8:
    picnum: mutable i16
    c_type: mutable i32
    specialFlags: mutable u32

global mutable laststatobj: Statstruct&? = zeroed
global mutable statinfo: array[C_0xadf3d9ec8, 50] = zeroed
global mutable spotvis: array[array[u8, 64], 64] = zeroed

def elisa_nonnull[T](value: mutable T&?) -> mutable T&:
    if value == null:
        return zeroed
    return value

def SpawnStatic(c_type: i32) -> void can[Abort.Panic, Global, Unsafe.PointerCast, Unsafe.BufferReinterpret, Unsafe.StaleRef]:
    can Abort.Panic, Global, Unsafe.PointerCast, Unsafe.BufferReinterpret, Unsafe.StaleRef:
        trusted Unsafe.StaleRef:
            elisa_nonnull(laststatobj).shapenum <- statinfo[c_type].picnum
        trusted Unsafe.StaleRef:
            elisa_nonnull(laststatobj).tilex <- 0
        trusted Unsafe.StaleRef:
            elisa_nonnull(laststatobj).tiley <- 0
        trusted Unsafe.StaleRef:
            elisa_nonnull(laststatobj).visspot <- &spotvis[0][0]
        trusted Unsafe.StaleRef:
            elisa_nonnull(laststatobj).flags <- 0
