struct Player[state Alive | Dead]:
    health: mutable i64
    tag: i64
    derive state:
        Alive when self.health > 0
        Dead when self.health <= 0

# The scalar reference may alias the player's predicate field. It is not an
# independent by-value counter, even though both have a primitive referent type.
def alias_write(player: Player[Alive]&, health: mutable i64&, again: bool) -> Player[Alive]:
    while again:
        health <- 0
    return player{tag = 1}
