# Dictionary payload errors preserve the complete mapping as ElisaError.payload.
error DictPayloadError:
    Bad(values: dict[i64, i64])

error TextDictPayloadError:
    Bad(values: dict[sview, sview])

error ObjectDictPayloadError:
    Bad(values: dict[i64, py::Object])

def fail_dict(values: dict[i64, i64]) -> i64 error[DictPayloadError]:
    raise DictPayloadError.Bad(values)

def fail_text(values: dict[sview, sview]) -> i64 error[TextDictPayloadError]:
    raise TextDictPayloadError.Bad(values)

def fail_objects(values: dict[i64, py::Object]) -> i64 error[ObjectDictPayloadError]:
    raise ObjectDictPayloadError.Bad(values)

export pymodule error_payload_dict:
    fn fail_dict
    fn fail_text
    fn fail_objects
