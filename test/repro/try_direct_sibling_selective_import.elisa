# The alias is installed in AliasInstaller but targets its nested Provider namespace.
module AliasInstaller:
    module Provider:
        public:
            error SourceError:
                Bad

            def origin() -> i64 error[SourceError]:
                return 1

    from Provider import origin

module Destination:
    public:
        error WantedError:
            Other

module App:
    public:
        def mismatched() -> i64 error[Destination::WantedError]:
            return try origin()

def main() -> i64:
    return 0
