# The first iteration reaches update_pair before rebind, but the same static call site runs
# again after the descriptor mutation. A one-pass statement walk must not trust fresh facts
# from only the first trip through the loop.
def rebind(first: mutable darray[i64]&, second: mutable darray[i64]&) -> void:
    first <- second

def update_pair(first: mutable darray[i64]&, second: mutable darray[i64]&) -> void:
    first[0] <- second[0]

def route() -> void:
    left: mutable darray[i64] = [1]
    right: mutable darray[i64] = [2]
    iteration: mutable i64 = 0
    while iteration < 2:
        update_pair(&left, &right)
        rebind(&left, &right)
        iteration <- iteration + 1

def main() -> i64:
    route()
    return 0
