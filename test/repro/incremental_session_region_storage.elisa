include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"

struct SessionBytes[@r]:
    bytes: mutable darray[u8] @r

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    region session:
        bytes: mutable darray[u8] @session = []
        retained: mutable SessionBytes[session] = SessionBytes{bytes: bytes}
        for index in 0..<256 |retained|:
            retained.bytes.push(index.u8())
        return retained.bytes.count.i64() - 256
