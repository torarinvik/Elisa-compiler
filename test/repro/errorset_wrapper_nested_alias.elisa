module Outer:
    public:
        module Right:
            public:
                module Nested:
                    public:
                        error Fault:
                            Available
                            Busy

using Outer as First
using First::Right as Second

def get_available() -> i64 error[Second::Nested::Fault{Available}]:
    return 1

def wrap[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
    return try callback()

def same_subset() -> i64 error[Second::Nested::Fault{Available}]:
    return wrap(get_available)

def widened_to_full() -> i64 error[Second::Nested::Fault]:
    return wrap(get_available)

def narrowed_to_wrong_variant() -> i64 error[Second::Nested::Fault{Busy}]:
    return wrap(get_available)

def main() -> i64:
    return 0
