# Python mapping boundary fixture.  The wrapper materializes Python dicts into
# Elisa's five-word DynDict header before calling these native functions.
struct DictBucket[K, T]:
    key: mutable K
    value: mutable T
    state: mutable u8

struct DynDict[K, T]:
    items: mutable DictBucket[K, T]&?
    count: usize
    used: usize
    capacity: usize
    arena: mutable i64

def arena_dict_get[K, T](m: dict[K, T]&, key: K) -> T&?:
    null return if m.count == 0 or m.items == null
    items: DictBucket[K, T]& = m.items
    mask: usize = m.capacity - 1
    slot: mutable usize = ctx_hash_value(key).usize() & mask
    remaining: mutable usize = m.capacity
    while remaining > 0:
        if items[slot].state == 0:
            return null
        if items[slot].state == 1 and items[slot].key == key:
            return &items[slot].value
        slot <- (slot + 1) & mask
        remaining <- remaining - 1
    return null

def count_i64(values: dict[i64, i64]) -> usize:
    return values.count

def count_after_key(key: i64, values: dict[i64, i64]) -> usize:
    return values.count

def count_text(values: dict[cstr, i64]) -> usize:
    return values.count

def count_u64(values: dict[u64, u64]) -> usize:
    return values.count

def count_float(values: dict[i64, f64]) -> usize:
    return values.count

def count_bool(values: dict[cstr, bool]) -> usize:
    return values.count

def count_bool_keys(values: dict[bool, i64]) -> usize:
    return values.count

def get_i64(values: dict[i64, i64], key: i64) -> i64:
    found: i64&? = values.get(key)
    return found[0] if found != null else -1

def pair_count(left: dict[i64, i64], right: dict[cstr, bool]) -> usize:
    return left.count + right.count

def empty_i64() -> dict[i64, i64]:
    return {}

def roundtrip_i64(values: dict[i64, i64]) -> dict[i64, i64]:
    return values

def roundtrip_i32(values: dict[i64, i32]) -> dict[i64, i32]:
