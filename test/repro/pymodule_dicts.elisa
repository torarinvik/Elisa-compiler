def nested_float_count(values: dict[i64, darray[f64]]) -> usize:
    found: darray[f64]&? = values.get(1)
    return found[0].count if found != null else 0

def nested_count(values: dict[i64, darray[i64]]) -> usize:
    found: darray[i64]&? = values.get(1)
    return found[0].count if found != null else 0

def nested_get(values: dict[i64, darray[i64]], key: i64) -> darray[i64]&?:
    return values.get(key)

