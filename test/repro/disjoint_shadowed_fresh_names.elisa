# Inner locals shadow by-reference parameters. Their allocations must not be mistaken for the
# outer parameter values used after the block, which may alias at the route call site.
def update_pair(first: mutable darray[i64]&, second: mutable darray[i64]&) -> void:
    first[0] <- second[0]

def route(first: mutable darray[i64]&, second: mutable darray[i64]&) -> void:
    if true:
        first: mutable darray[i64] = []
        second: mutable darray[i64] = []
        update_pair(&first, &second)
    update_pair(first, second)

def main() -> i64:
    values: mutable darray[i64] = [1]
    route(&values, &values)
    return 0
