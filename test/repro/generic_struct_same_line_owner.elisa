#line 0 generic-struct-box.elisa
struct Box[T]:
    value: mutable T

#line 0 generic-struct-pair.elisa
struct Pair[A, B]:
    first: mutable A
    second: mutable B

#line 0 generic-struct-plain.elisa
struct Plain:
    value: mutable i64

def main() -> i64:
    box: mutable Box[i64] = Box[i64]{value: 11}
    pair: mutable Pair[i64, i32] = Pair[i64, i32]{first: 20, second: 10}
    plain: mutable Plain = Plain{value: 1}
    return box.value + pair.first + pair.second.i64() + plain.value if plain.value == 1 else 1
