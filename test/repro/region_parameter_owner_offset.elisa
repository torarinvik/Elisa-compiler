# Same logical line, distinct owner offsets: the second function must resolve only @s.
#line 0 region-parameter-owner.elisa
def read_r[@r](anchor: i64& @r) -> i64:
    return anchor[0]

#line 0 region-parameter-owner.elisa
def allocate_s[@s](anchor: i64& @s, value: i64) -> i64:
    allocated: i64& @s = new[s] value
    return anchor[0] + allocated[0]

# The explicit-region arena follows both body-derived grown-parameter slots and the
# caller-return slot. The call gives `young` an inner arena and `old` an outer arena;
# selecting slot zero for `r` would leave the result in the inner arena after it ends.
def allocate_after_hidden[@r](young: mutable darray[i64]&, old: mutable darray[i64]&, value: i64) -> mutable darray[i64] @r:
    result: mutable darray[i64] @r = []
    in r:
        allocated: i64& @r = new[r] value
        young.push(value)
        old.push(allocated[0])
        result.push(allocated[0])
    return move result

def main() -> i64:
    region caller(1024)
    anchor: i64& @caller = new[caller] 1
    region outer(4096)
    old: mutable darray[i64] @outer = []
    old.push(1)
    result: mutable darray[i64] @outer = []
    region inner(1024):
        young: mutable darray[i64] @inner = []
        young.push(2)
        result <- allocate_after_hidden[outer](young, old, 41)
    return 0 if read_r[caller](anchor) + allocate_s[caller](anchor, 41) == 43 and result[0] + old[1] == 82 else 1
