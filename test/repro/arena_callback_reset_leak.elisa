# nopath
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"

def reset_arena(target: mutable Arena&) -> void:
    arena_reset(target)

def main() -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    arena: mutable Arena = zeroed
    alloc: mutable Arena& = &arena
    outer_values: mutable darray[i64] @alloc = [65]
    reset_callback: fn(mutable Arena&) -> void = reset_arena
    reset_callback(alloc)
    replacement: mutable darray[i64] @alloc = [7]
    return outer_values[0]
