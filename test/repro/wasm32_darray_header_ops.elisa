def checked_at(values: darray[i64], pick: i64) -> i64:
    return get values[pick.usize()] else 7

def mutate() -> i64:
    values: mutable darray[i64] = [1, 2, 3]
    extra: darray[i64] = [6, 7]
    values.reserve(8.usize())
    values.push(42)
    values.truncate(4.usize())
    values.resize(5.usize())
    values.extend(extra)
    values.clear()
    values.push(9)
    return values.count.i64() + values.capacity.i64()

def map_values(values: darray[i64]) -> darray[i64]:
    return [value + 1 for value in values]

def range_values() -> darray[i64]:
    return [value for value in 0..<8]

def spread_values(values: darray[i64]) -> darray[i64]:
    return [0, ...values]

def sum_values(values: darray[i64]) -> i64:
    total: mutable i64 = 0
    for value in values |total|:
        total <- total + value
    return total

def darray_ops_result() -> i32:
    values: darray[i64] = [1, 2, 3]
    changed: i64 = mutate()
    mapped: darray[i64] = map_values(values)
    ranged: darray[i64] = range_values()
    spread: darray[i64] = spread_values(mapped)
    return checked_at(spread, 9).i32() + sum_values(ranged).i32() + changed.i32()

export fn wasm_darray_header_ops() -> i32 = darray_ops_result

def main() -> i64:
    return darray_ops_result().i64()
