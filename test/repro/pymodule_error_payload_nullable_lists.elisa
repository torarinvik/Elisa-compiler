# Nullable list elements should preserve None in single-field error payloads just like
# ordinary darray returns.  Keep one fixture per nullable family so the generated bridge
# exercises value, text, and opaque-object ownership paths.
error OptionalScalarListPayloadError:
    Bad(items: darray[i64?])

error OptionalTextListPayloadError:
    Bad(items: darray[sview?])

error OptionalObjectListPayloadError:
    Bad(items: darray[py::Object?])

def fail_scalar(values: darray[i64?]) -> i64 error[OptionalScalarListPayloadError]:
    raise OptionalScalarListPayloadError.Bad(values)

def fail_text(values: darray[sview?]) -> i64 error[OptionalTextListPayloadError]:
    raise OptionalTextListPayloadError.Bad(values)

def fail_object(values: darray[py::Object?]) -> i64 error[OptionalObjectListPayloadError]:
    raise OptionalObjectListPayloadError.Bad(values)

export pymodule error_payload_nullable_lists:
    fn fail_scalar
    fn fail_text
    fn fail_object
