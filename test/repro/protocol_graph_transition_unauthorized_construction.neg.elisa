module Owner:
    affine struct Lease[state Open | Closed]:
        value: u64
        transitions:
            Open -> Closed

# Open is the family’s initial state, but construction authority belongs to Owner.
module Client:
    type OpenLease = Owner::Lease[Open]

    def forge_initial() -> Owner::Lease[Open]:
        return Owner::Lease[Open]{value: 41}

    def forge_through_alias() -> Owner::Lease[Open]:
        return OpenLease{value: 42}

def main() -> i32:
    return 0
