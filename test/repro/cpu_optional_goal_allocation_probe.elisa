# Native optional parameter goal parity and allocation oracle.
include "../../src/semantic/semantic.elisa"
extern oracle_store_count(bits: uintptr) -> i64 can[Unsafe.PointerCast]
extern oracle_store_layout_ok(bits: uintptr) -> bool can[Unsafe.PointerCast]
extend Semantic:
    private:
        def cpu_probe_legacy_goal(param_type: Ast::Expr, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&) -> (found: bool, predicate: Ast::Expr):
            can Memory.Allocate, Abort.Panic:
                match param_type:
                    Expr.Binary(base, operator, application, line):
                        (false, (Ast::Expr.Absent)) return if operator != TokenKind.Is
                        law_name: sview = ident_name_of(application)
                        (false, (Ast::Expr.Absent)) return if law_name == ""
                        predicate: Ast::Expr = law_predicate_by_name(law_name, law_names, law_predicates)
                        match predicate:
                            Expr.Binary(pred_left, pred_operator, pred_right, pred_line):
                                left_is_self: bool = ident_name_of(pred_left) == "self"
                                right_literal: (found: bool, value: i64) = where_signed_literal(pred_right)
                                return (left_is_self and is_comparison_operator(pred_operator) and right_literal.found, predicate)
                            _:
                                return (false, (Ast::Expr.Absent))
                    _:
                        return (false, (Ast::Expr.Absent))

        # fn -> (param names, requires-goal predicates + each param's `is Law` refinement as a goal).

        def cpu_probe_legacy_collect(declarations: darray[Ast::Decl], sig_lines: darray[u32]&, sig_kinds: darray[sview]&, sig_exprs: darray[Ast::Expr]&, law_names: darray[sview]&, law_predicates: darray[Ast::Expr]&, fn_names: mutable darray[sview]&, fn_owners: mutable darray[sview]&, fn_param_starts: mutable darray[usize]&, fn_param_counts: mutable darray[usize]&, all_params: mutable darray[sview]&, fn_goal_starts: mutable darray[usize]&, fn_goal_counts: mutable darray[usize]&, all_goals: mutable darray[Ast::Expr]&, all_goal_self: mutable darray[i64]&, current_module: sview) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |current_module, fn_names, fn_owners, fn_param_starts, fn_param_counts, all_params, fn_goal_starts, fn_goal_counts, all_goals, all_goal_self|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, func_line):
                            fn_names.push(function_name)
                            fn_owners.push(current_module)
                            fn_param_starts.push(all_params.count)
                            all_params.extend([parameter.name for parameter in parameters])
                            fn_param_counts.push(parameters.count)
                            fn_goal_starts.push(all_goals.count)
                            goal_count: mutable usize = 0
                            param_index: mutable usize = 0
                            for parameter in parameters |all_goals, all_goal_self, goal_count, law_names, law_predicates, param_index|:
                                ref_goal: (found: bool, predicate: Ast::Expr) = cpu_probe_legacy_goal(parameter.type_expression, law_names, law_predicates)
                                if ref_goal.found:
                                    all_goals.push(ref_goal.predicate)
                                    all_goal_self.push(param_index.i64())
                                    goal_count <- goal_count + 1
                                param_index <- param_index + 1
                            for statement in body |all_goals, all_goal_self, goal_count|:
                                match statement:
                                    Stmt.Contract(kind, expression, contract_line):
                                        if kind == "requires":
                                            all_goals.push(expression)
                                            all_goal_self.push(-1)
                                            goal_count <- goal_count + 1
                                    _:
                                        pass
                            sig_probe: mutable usize = 0
                            while sig_probe < sig_lines.count |sig_probe, all_goals, all_goal_self, goal_count, sig_lines, sig_kinds, sig_exprs, func_line|:
                                if sig_lines[sig_probe] == func_line.line and sig_kinds[sig_probe] == "requires":
                                    all_goals.push(sig_exprs[sig_probe])
                                    all_goal_self.push(-1)
                                    goal_count <- goal_count + 1
                                sig_probe <- sig_probe + 1
                            fn_goal_counts.push(goal_count)
                        Decl.Module(module_name, module_body, module_line):
                            cpu_probe_legacy_collect(module_body, sig_lines, sig_kinds, sig_exprs, law_names, law_predicates, fn_names, fn_owners, fn_param_starts, fn_param_counts, all_params, fn_goal_starts, fn_goal_counts, all_goals, all_goal_self, module_name)
                        Decl.Scoped(scoped_body, scoped_line):
                            cpu_probe_legacy_collect(scoped_body, sig_lines, sig_kinds, sig_exprs, law_names, law_predicates, fn_names, fn_owners, fn_param_starts, fn_param_counts, all_params, fn_goal_starts, fn_goal_counts, all_goals, all_goal_self, current_module)
                        _:
                            pass

        # Resolve a one-level `type` alias name to its target type expression, else unchanged.

        def cpu_probe_legacy_check(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                fn_names: mutable darray[sview] = []
                fn_owners: mutable darray[sview] = []
                fn_param_starts: mutable darray[usize] = []
                fn_param_counts: mutable darray[usize] = []
                all_params: mutable darray[sview] = []
                fn_goal_starts: mutable darray[usize] = []
                fn_goal_counts: mutable darray[usize] = []
                all_goals: mutable darray[Ast::Expr] = []
                all_goal_self: mutable darray[i64] = []
                cpu_law_names: mutable darray[sview] = []
                cpu_law_predicates: mutable darray[Ast::Expr] = []
                collect_laws(file.top_decls, cpu_law_names, cpu_law_predicates)
                cpu_probe_legacy_collect(file.top_decls, file.signature_contract_lines, file.signature_contract_kinds, file.signature_contract_exprs, cpu_law_names, cpu_law_predicates, fn_names, fn_owners, fn_param_starts, fn_param_counts, all_params, fn_goal_starts, fn_goal_counts, all_goals, all_goal_self, "")
                global_names: mutable darray[sview] = []
                global_values: mutable darray[i64] = []
                mut_global_names: mutable darray[sview] = []
                mutable_globals: mutable darray[sview] = []
                for annotation in file.enum_annotations |mutable_globals|:
                    mutable_globals.push(annotation.owner) if annotation.name == "__global_mutable"
                cpu_collect_globals(file.top_decls, mutable_globals, global_names, global_values, mut_global_names)
                cpu_alias_names: mutable darray[sview] = []
                cpu_alias_targets: mutable darray[Ast::Expr] = []
                rau_collect_alias_targets(file.top_decls, cpu_alias_names, cpu_alias_targets)
                cpu_lemma_names: mutable darray[sview] = []
                for lemma_annotation in file.enum_annotations |cpu_lemma_names|:
                    cpu_lemma_names.push(lemma_annotation.name) if lemma_annotation.owner == "__lemma"
                cpu_goal_names: mutable darray[sview] = []
                for goal_fn in 0..<fn_names.count |cpu_goal_names, fn_names, fn_goal_counts|:
                    cpu_goal_names.push(fn_names[goal_fn]) if fn_goal_counts[goal_fn] > 0
                return if cpu_goal_names.count == 0
                table <- cpu_check_declarations(file.top_decls, cpu_goal_names, cpu_lemma_names, global_names, global_values, mut_global_names, fn_names, fn_owners, fn_param_starts, fn_param_counts, all_params, fn_goal_starts, fn_goal_counts, all_goals, all_goal_self, cpu_law_names, cpu_law_predicates, cpu_alias_names, cpu_alias_targets, table)

        def cpu_probe_goal_case(annotation: Ast::Expr, names: darray[sview]&, predicates: darray[Ast::Expr]&, expected: Ast::Expr?, old_allocations: i64, store_bits: uintptr) -> bool:
            can Memory.Allocate, Abort.Panic:
                before: i64 = oracle_store_count(store_bits) can Unsafe.PointerCast
                old = cpu_probe_legacy_goal(annotation, names, predicates)
                after_old: i64 = oracle_store_count(store_bits) can Unsafe.PointerCast
                candidate: Ast::Expr? = cpu_param_ref_goal(annotation, names, predicates)
                after_new: i64 = oracle_store_count(store_bits) can Unsafe.PointerCast
                return false if after_old - before != old_allocations or after_new != after_old
                if candidate is actual:
                    return false if not old.found
                    if expected is wanted:
                        return actual == wanted and actual == old.predicate
                    return false
                return not old.found and expected == null

        def cpu_probe_diagnostic_equal(a: Diagnostic, b: Diagnostic) -> bool:
            return false if a.name != b.name
            return false if a.line != b.line
            return false if a.pos.line != b.pos.line
            return false if a.pos.column != b.pos.column
            return false if a.pos.offset != b.pos.offset
            return false if a.pos.end_line != b.pos.end_line
            return false if a.pos.end_column != b.pos.end_column
            return false if a.pos.end_offset != b.pos.end_offset
            return false if a.kind != b.kind
            return false if a.expected != b.expected
            return false if a.actual != b.actual
            return false if a.expected_count != b.expected_count
            return false if a.actual_count != b.actual_count
            return false if a.detail != b.detail
            return false if a.const_enum_module_expected != b.const_enum_module_expected
            return false if a.const_enum_module_actual != b.const_enum_module_actual
            return false if a.state_code != b.state_code
            return false if a.secondary_line != b.secondary_line
            return false if a.secondary_column != b.secondary_column
            return false if a.secondary_end_column != b.secondary_end_column
            return false if a.detail2 != b.detail2
            return false if a.detail3 != b.detail3
            return false if a.effect_ref_count != b.effect_ref_count
            return false if a.effect_ref_1 != b.effect_ref_1
            return false if a.effect_ref_2 != b.effect_ref_2
            return false if a.effect_ref_3 != b.effect_ref_3
            return false if a.effect_ref_4 != b.effect_ref_4
            return false if a.effect_ref_5 != b.effect_ref_5
            return false if a.effect_ref_6 != b.effect_ref_6
            return false if a.effect_ref_7 != b.effect_ref_7
            return false if a.effect_ref_8 != b.effect_ref_8
            return false if a.error_set != b.error_set
            return true

    public:
        def cpu_optional_goal_probe() -> i32:
            can Memory.Allocate, Abort.Panic:
                region nodes(8388608):
                    store: Ast::Node.Store[Local] = Ast::Node.Store(nodes)
                    in store:
                        store_bits: uintptr = (&store).cast[uintptr] can Unsafe.PointerCast
                        p: Ast::Pos = Ast::pos_at_line(7)
                        plain: Ast::Expr = Ast::Expr.Ident("i64", p)
                        self_name: Ast::Expr = Ast::Expr.Ident("self", p)
                        x_name: Ast::Expr = Ast::Expr.Ident("x", p)
                        zero: Ast::Expr = Ast::Expr.IntLit(0, p)
                        five: Ast::Expr = Ast::Expr.IntLit(5, p)
                        negative: Ast::Expr = Ast::Expr.Unary(TokenKind.Minus, Ast::Expr.IntLit(4, p), p)
                        pos_goal: Ast::Expr = Ast::Expr.Binary(self_name, TokenKind.GtEq, five, p)
                        neg_goal: Ast::Expr = Ast::Expr.Binary(self_name, TokenKind.GtEq, negative, p)
                        nonself: Ast::Expr = Ast::Expr.Binary(x_name, TokenKind.GtEq, zero, p)
                        noncomparison: Ast::Expr = Ast::Expr.Binary(self_name, TokenKind.Plus, zero, p)
                        nonliteral: Ast::Expr = Ast::Expr.Binary(self_name, TokenKind.GtEq, x_name, p)
                        is_pos: Ast::Expr = Ast::Expr.Binary(plain, TokenKind.Is, Ast::Expr.Ident("Pos", p), p)
                        is_neg: Ast::Expr = Ast::Expr.Binary(plain, TokenKind.Is, Ast::Expr.Ident("Neg", p), p)
                        is_missing: Ast::Expr = Ast::Expr.Binary(plain, TokenKind.Is, Ast::Expr.Ident("Missing", p), p)
                        is_empty: Ast::Expr = Ast::Expr.Binary(plain, TokenKind.Is, zero, p)
                        nonis: Ast::Expr = Ast::Expr.Binary(plain, TokenKind.Plus, x_name, p)
                        is_bad: Ast::Expr = Ast::Expr.Binary(plain, TokenKind.Is, Ast::Expr.Ident("Bad", p), p)
                        empty_names: darray[sview] = []
                        empty_predicates: darray[Ast::Expr] = []
                        names: darray[sview] = ["Pos", "Neg", "Bad"]
                        predicates: darray[Ast::Expr] = [pos_goal, neg_goal, zero]
                        duplicate_names: darray[sview] = ["Pos", "Pos"]
                        duplicate_goals: darray[Ast::Expr] = [pos_goal, neg_goal]
                        duplicate_bad: darray[Ast::Expr] = [zero, pos_goal]
                        nonself_goals: darray[Ast::Expr] = [nonself]
                        noncomparison_goals: darray[Ast::Expr] = [noncomparison]
                        nonliteral_goals: darray[Ast::Expr] = [nonliteral]
                        one_name: darray[sview] = ["Pos"]
                        return 1 if size_of(PackedAoSStore) != 96
                        return 1 if not (oracle_store_layout_ok(store_bits) can Unsafe.PointerCast)
                        return 2 if not (cpu_probe_goal_case(plain, names, predicates, null, 1, store_bits) can Unsafe.PointerCast)
                        return 3 if not (cpu_probe_goal_case(nonis, names, predicates, null, 1, store_bits) can Unsafe.PointerCast)
                        return 4 if not (cpu_probe_goal_case(is_empty, names, predicates, null, 1, store_bits) can Unsafe.PointerCast)
                        return 5 if not (cpu_probe_goal_case(is_missing, names, predicates, null, 2, store_bits) can Unsafe.PointerCast)
                        return 6 if not (cpu_probe_goal_case(is_pos, empty_names, empty_predicates, null, 2, store_bits) can Unsafe.PointerCast)
                        return 7 if not (cpu_probe_goal_case(is_bad, names, predicates, null, 1, store_bits) can Unsafe.PointerCast)
                        return 8 if not (cpu_probe_goal_case(is_pos, one_name, nonself_goals, null, 0, store_bits) can Unsafe.PointerCast)
                        return 9 if not (cpu_probe_goal_case(is_pos, one_name, noncomparison_goals, null, 0, store_bits) can Unsafe.PointerCast)
                        return 10 if not (cpu_probe_goal_case(is_pos, one_name, nonliteral_goals, null, 0, store_bits) can Unsafe.PointerCast)
                        return 11 if not (cpu_probe_goal_case(is_pos, names, predicates, pos_goal, 0, store_bits) can Unsafe.PointerCast)
                        return 12 if not (cpu_probe_goal_case(is_neg, names, predicates, neg_goal, 0, store_bits) can Unsafe.PointerCast)
                        return 13 if not (cpu_probe_goal_case(is_pos, duplicate_names, duplicate_goals, pos_goal, 0, store_bits) can Unsafe.PointerCast)
                        return 14 if not (cpu_probe_goal_case(is_pos, duplicate_names, duplicate_bad, null, 1, store_bits) can Unsafe.PointerCast)
                        params: darray[Ast::ParamDecl] = [Ast::ParamDecl{name: "a", type_expression: plain, is_mutable: false, has_default: false, default_value: plain}, Ast::ParamDecl{name: "b", type_expression: is_pos, is_mutable: false, has_default: false, default_value: plain}, Ast::ParamDecl{name: "c", type_expression: is_missing, is_mutable: false, has_default: false, default_value: plain}, Ast::ParamDecl{name: "d", type_expression: is_neg, is_mutable: false, has_default: false, default_value: plain}, Ast::ParamDecl{name: "e", type_expression: is_bad, is_mutable: false, has_default: false, default_value: plain}]
                        body_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("a", p), TokenKind.Gt, zero, p)
                        body_contracts: darray[Ast::Stmt] = [Ast::Stmt.Contract("requires", body_goal, p)]
                        no_effects: darray[sview] = []
                        no_decorators: darray[Ast::Annotation] = []
                        function: Ast::Decl = Ast::Decl.Func("needs", params, plain, body_contracts, no_effects, no_decorators, p)
                        declarations: darray[Ast::Decl] = [function]
                        sig_lines: darray[u32] = [7,7,7]
                        sig_kinds: darray[sview] = ["requires", "ensures", "requires"]
                        sig_goals: darray[Ast::Expr] = [pos_goal, zero, neg_goal]
                        old_names: mutable darray[sview] = []
                        old_owners: mutable darray[sview] = []
                        old_starts: mutable darray[usize] = []
                        old_counts: mutable darray[usize] = []
                        old_params: mutable darray[sview] = []
                        old_goal_starts: mutable darray[usize] = []
                        old_goal_counts: mutable darray[usize] = []
                        old_goals: mutable darray[Ast::Expr] = []
                        old_self: mutable darray[i64] = []
                        new_names: mutable darray[sview] = []
                        new_owners: mutable darray[sview] = []
                        new_starts: mutable darray[usize] = []
                        new_counts: mutable darray[usize] = []
                        new_params: mutable darray[sview] = []
                        new_goal_starts: mutable darray[usize] = []
                        new_goal_counts: mutable darray[usize] = []
                        new_goals: mutable darray[Ast::Expr] = []
                        new_self: mutable darray[i64] = []
                        before_collect: i64 = oracle_store_count(store_bits) can Unsafe.PointerCast
                        cpu_probe_legacy_collect(declarations, sig_lines, sig_kinds, sig_goals, names, predicates, old_names, old_owners, old_starts, old_counts, old_params, old_goal_starts, old_goal_counts, old_goals, old_self, "Box")
                        after_old_collect: i64 = oracle_store_count(store_bits) can Unsafe.PointerCast
                        cpu_collect(declarations, sig_lines, sig_kinds, sig_goals, names, predicates, new_names, new_owners, new_starts, new_counts, new_params, new_goal_starts, new_goal_counts, new_goals, new_self, "Box")
                        after_new_collect: i64 = oracle_store_count(store_bits) can Unsafe.PointerCast
                        return 20 if after_old_collect - before_collect != 4 or after_new_collect != after_old_collect
                        return 21 if old_names.count != new_names.count
                        for index in 0..<old_names.count:
                            return 22 if old_names[index] != new_names[index]
                        return 21 if old_owners.count != new_owners.count
                        for index in 0..<old_owners.count:
                            return 22 if old_owners[index] != new_owners[index]
                        return 21 if old_starts.count != new_starts.count
                        for index in 0..<old_starts.count:
                            return 22 if old_starts[index] != new_starts[index]
                        return 21 if old_counts.count != new_counts.count
                        for index in 0..<old_counts.count:
                            return 22 if old_counts[index] != new_counts[index]
                        return 21 if old_params.count != new_params.count
                        for index in 0..<old_params.count:
                            return 22 if old_params[index] != new_params[index]
                        return 21 if old_goal_starts.count != new_goal_starts.count
                        for index in 0..<old_goal_starts.count:
                            return 22 if old_goal_starts[index] != new_goal_starts[index]
                        return 21 if old_goal_counts.count != new_goal_counts.count
                        for index in 0..<old_goal_counts.count:
                            return 22 if old_goal_counts[index] != new_goal_counts[index]
                        return 21 if old_goals.count != new_goals.count
                        for index in 0..<old_goals.count:
                            return 22 if old_goals[index] != new_goals[index]
                        return 21 if old_self.count != new_self.count
                        for index in 0..<old_self.count:
                            return 22 if old_self[index] != new_self[index]
                        return 23 if new_names.count != 1 or new_names[0] != "needs" or new_owners[0] != "Box"
                        return 24 if new_starts[0] != 0 or new_counts[0] != 5 or new_goal_starts[0] != 0 or new_goal_counts[0] != 5
                        return 25 if new_goals[0] != pos_goal or new_goals[1] != neg_goal or new_goals[2] != body_goal or new_goals[3] != pos_goal or new_goals[4] != neg_goal
                        return 26 if new_self[0] != 1 or new_self[1] != 3 or new_self[2] != -1 or new_self[3] != -1 or new_self[4] != -1
                        caller_params: darray[Ast::ParamDecl] = [Ast::ParamDecl{name: "x", type_expression: plain, is_mutable: false, has_default: false, default_value: plain}]
                        call_args: darray[Ast::Expr] = [x_name,x_name,x_name,x_name,x_name]
                        call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("needs",p),call_args,no_effects,p)
                        caller_body: darray[Ast::Stmt] = [Ast::Stmt.Return(call,p)]
                        caller: Ast::Decl = Ast::Decl.Func("caller",caller_params,plain,caller_body,no_effects,no_decorators,p)
                        laws: darray[Ast::Decl] = [Ast::Decl.Law("Pos",pos_goal,p),Ast::Decl.Law("Neg",neg_goal,p),Ast::Decl.Law("Bad",zero,p),function,caller]
                        file: Ast::File = Ast::File{
                            top_decls: laws,
                            effect_type_references: [],
                            pymodule_type_name_bytes: [],
                            pymodule_type_name_starts: [],
                            pymodule_type_name_lengths: [],
                            protocol_default_methods: [],
                            errors: [],
                            error_set_func_lines: [],
                            or_arm_binding_lines: [],
                            or_arm_binding_columns: [],
                            or_arm_binding_end_columns: [],
                            wildcard_arm_lines: [],
                            wildcard_arm_columns: [],
                            wildcard_arm_end_columns: [],
                            error_set_func_names: [],
                            error_set_decl_names: [],
                            signature_contract_lines: [],
                            signature_contract_kinds: [],
                            signature_contract_exprs: [],
                            numeric_suffix_names: [],
                            numeric_suffix_lines: [],
                            machine_coverage: [],
                            derived_state_rules: [],
                            state_families: [],
                            state_transition_edges: [],
                            typestate_postconditions: [],
                            func_decl_lines: [],
                            func_decl_columns: [],
                            panic_lines: [],
                            panic_columns: [],
                            generic_param_lines: [],
                            generic_param_names: [],
                            generic_struct_decls: [],
                            generic_struct_decl_names: [],
                            generic_struct_decl_owners: [],
                            generic_struct_decl_lines: [],
                            generic_func_decls: [],
                            generic_func_decl_names: [],
                            generic_func_decl_lines: [],
                            generic_func_decl_owners: [],
                            annotation_args: [],
                            extern_params: [],
                            extern_global_type_names: [],
                            extern_global_type_exprs: [],
                            local_region_annotations: [],
                            ghost_local_lines: [],
                            assert_hole_positions: [],
                            static_assert_conds: [],
                            static_if_conds: [],
                            static_if_lines: [],
                            static_if_kinds: [],
                            static_if_depths: [],
                            static_assert_msgs: [],
                            static_assert_lines: [],
                            allocation_region_names: [],
                            allocation_region_lines: [],
                            enum_annotations: [],
                            fn_type_param_lines: [],
                            fn_type_param_exprs: [],
                            fn_type_return_lines: [],
                            fn_type_return_exprs: [],
                            tuple_type_elements: [],
                            tuple_type_starts: [],
                            tuple_type_counts: [],
                            tuple_type_lines: [],
                            tuple_type_label_offsets: [],
                            packed_enum_names: [],
                            alias_names: [],
                            alias_targets: [],
                            alias_target_heads: [],
                            struct_names: [],
                            struct_owners: [],
                            struct_member_rows: [],
                            struct_member_starts: [],
                            struct_member_counts: [],
                            struct_copy_bases: [],
                            enum_decl_names: [],
                            enum_decl_owners: [],
                            enum_decl_storage_heads: [],
                            enum_decl_is_const: [],
                            enum_decl_variant_names: [],
                            enum_decl_variant_values: [],
                            enum_decl_variant_starts: [],
                            enum_decl_variant_counts: [],
                            payload_enum_names: [],
                            payload_enum_owners: [],
                            payload_enum_is_const: [],
                            payload_enum_variant_starts: [],
                            payload_enum_variant_counts: [],
                            payload_enum_variant_names: [],
                            payload_enum_variant_field_starts: [],
                            payload_enum_variant_field_counts: [],
                            payload_enum_variant_fields: [],
                            payload_enum_variant_field_names: [],
                            enum_common_owners: [],
                            enum_common_modules: [],
                            enum_common_counts: [],
                            enum_common_starts: [],
                            enum_common_fields: [],
                            enum_common_field_names: [],
                        }
                        old_table: mutable SymbolTable = SymbolTable()
                        new_table: mutable SymbolTable = SymbolTable()
                        old_table <- cpu_probe_legacy_check(&file,old_table)
                        new_table <- check_call_precondition_unproven(&file,new_table)
                        return 27 if old_table.diagnostics.count != new_table.diagnostics.count or old_table.diagnostics.count == 0
                        for index in 0..<old_table.diagnostics.count:
                            return 28 if not cpu_probe_diagnostic_equal(old_table.diagnostics[index],new_table.diagnostics[index])
                        return 0

def main() -> i32:
    can Memory.Allocate, Abort.Panic:
        return Semantic::cpu_optional_goal_probe() can Unsafe.PointerCast
