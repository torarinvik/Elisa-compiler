packed enum Message:
    A(x: i64)
    B(y: i64, z: i64)

def run(owner: Arena) -> i64:
    store: Message.Store[Local] = Message.Store(owner)
    result: mutable i64 = 0
    in store:
        n: Message = new Message.B(y: 20, z: 22)
        result <- match n:
            Message.A(x): x
            Message.B(y, z): y + z
    return result

def main() -> i64:
    region r(4096):
        return run(r)
