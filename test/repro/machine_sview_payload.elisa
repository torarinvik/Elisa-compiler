include "../../elisacore_std/elisacore_runtime.elisa"

enum Lookup:
    Search(sview, sview, usize)
    Done(u32)


def probe(root: sview, member: sview) -> u32:
    limit: usize = 3
    remaining: mutable usize = limit + 1
    result: u32 = machine from Lookup.Search(root, member, 0) decreases remaining:
        Lookup.Search(module, symbol, steps):
            direct: u32 = 0xffffffff
            reexported: sview = module
            original: sview = symbol
            remaining <- remaining - 1
            next Lookup.Done(direct) if direct != 0xffffffff
            next Lookup.Done(0xffffffff) if steps >= limit
            next Lookup.Done(0xffffffff) if sview_len(reexported) == 0 or sview_len(original) == 0 or reexported == module
            next Lookup.Search(reexported, original, steps + 1)
        Lookup.Done(value):
            done value
    return result


def main() -> int:
    value: u32 = probe("root", "member")
    if value == 0xffffffff:
        return 0
    return 1
