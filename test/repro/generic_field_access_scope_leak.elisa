# A branch-local shadow must not suppress the invalid generic field access after
# the branch. Stage0 rejects `value.unknown`; Stage1's old function-wide shadow
# collection incorrectly treated every use of `value` as shadowed.

def bad[T](value: T) -> i64:
    if true:
        value: i64 = 1
        return value
    return value.unknown

def good() -> i64:
    return 42
