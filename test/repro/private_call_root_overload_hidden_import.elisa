# Root overloads participate in the same unqualified receiver set as imported members.
# A visible root winner must prevent private imported siblings from being diagnosed.
module Provider:
    private:
        def choose(value: i64) -> i64:
            return 2

        def prefer[T](value: T) -> i64:
            return 4

        def local_rank[T](value: T) -> i64:
            return 5

module SelectiveProvider:
    private:
        def choose_selective(value: bool) -> i64:
            return 7

using Provider
from SelectiveProvider import choose_selective

def choose[T](value: T) -> i64:
    return 1

def choose_selective[T](value: T) -> i64:
    return 8

def prefer(value: bool) -> i64:
    return 3

def root_generic_wins_direct(value: bool) -> i64:
    return choose(value)

def root_generic_wins_cached(value: bool) -> i64:
    result = choose(value)
    return result

def selective_root_generic_wins_direct(value: bool) -> i64:
    return choose_selective(value)

def selective_root_generic_wins_cached(value: bool) -> i64:
    result = choose_selective(value)
    return result

def root_concrete_wins_direct(value: bool) -> i64:
    return prefer(value)

def root_concrete_wins_cached(value: bool) -> i64:
    result = prefer(value)
    return result

module LocalConsumer:
    from Provider import local_rank

    public:
        # This local exact overload must outrank the selectively imported private
        # generic candidate during unqualified call resolution.
        def local_rank(value: bool) -> i64:
            return 6

        def local_concrete_wins(value: bool) -> i64:
            return local_rank(value)

def main() -> i64:
    return 0
