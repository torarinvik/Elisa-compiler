# A fixed arena must find its own reclaimed block after another arena displaces the global hint.
include "../../elisacore_std/arena.elisa"

module ArenaFixedReuseAfterHintDisplacementRegression:
    private:
        const CAPACITY_SLOTS: usize = 16
        const RECLAIMED_SLOTS: usize = 4
        const FILLER_SLOTS: usize = CAPACITY_SLOTS - RECLAIMED_SLOTS
        const FIRST_REGION: usize = 0
        const SUCCESS_STATUS: i64 = 0
        const FAILURE_STATUS: i64 = 1

    public:
        def run() -> i64:
            can Global{Read,Write}, Atomics.Load, Unsafe{Alias,PointerCast}:
                first_backing: mutable heap Region& = new_region_backend(CAPACITY_SLOTS, ARENA_STRATEGY_FIXED)
                first: mutable Arena = Arena{begin: first_backing, end: first_backing, end_index: FIRST_REGION, strategy: ARENA_STRATEGY_FIXED}
                first_reclaimed: mutable heap void& = arena_alloc(&first, RECLAIMED_SLOTS * size_of(uintptr))
                _ = arena_alloc(&first, FILLER_SLOTS * size_of(uintptr))
                first_size: usize = RECLAIMED_SLOTS * size_of(uintptr)
                arena_reclaim_allocation(&first, first_reclaimed, arena_size_bytes_to_slots(first_size), first_size)

                second_backing: mutable heap Region& = new_region_backend(CAPACITY_SLOTS, ARENA_STRATEGY_FIXED)
                second: mutable Arena = Arena{begin: second_backing, end: second_backing, end_index: FIRST_REGION, strategy: ARENA_STRATEGY_FIXED}
                second_reclaimed: mutable heap void& = arena_alloc(&second, RECLAIMED_SLOTS * size_of(uintptr))
                _ = arena_alloc(&second, FILLER_SLOTS * size_of(uintptr))
                second_size: usize = RECLAIMED_SLOTS * size_of(uintptr)
                arena_reclaim_allocation(&second, second_reclaimed, arena_size_bytes_to_slots(second_size), second_size)

                reused: mutable heap void& = arena_alloc(&first, RECLAIMED_SLOTS * size_of(uintptr))
                correct: bool = reused.cast[uintptr] == first_reclaimed.cast[uintptr]
                arena_free(&first)
                arena_free(&second)
                return SUCCESS_STATUS if correct else FAILURE_STATUS

def main() -> i64:
    can Global{Read,Write}, Atomics.Load:
        return ArenaFixedReuseAfterHintDisplacementRegression::run()
