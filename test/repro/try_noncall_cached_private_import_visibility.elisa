# Direct and cached `try` lookups must not infer facts from an inaccessible callable.
module Provider:
    public:
        error HiddenFault:
            Failed

    private:
        def origin() -> i64 error[Provider::HiddenFault]:
            raise Provider::HiddenFault.Failed

from Provider import origin

module Consumer:
    public:
        error Destination:
            Rejected

        def cached_private_call() -> i64 error[Consumer::Destination]:
            payload = origin()
            return try payload

        def direct_private_call() -> i64 error[Consumer::Destination]:
            return try origin()

def main() -> i64:
    return 0
