# Stage0 keeps module aliases in a program-wide map, so an alias declared inside a
# module can qualify calls from root when no competing alias uses that spelling.
def catch_via_nested_global_alias() -> i64:
    catch NestedGlobal::load():
        value: 0
        AliasInstaller::NestedProvider::Fault.Expected: 1
    return 0

def main() -> i64:
    return 0

# Stage0 flattens all module aliases before analyzing function bodies, so this later
# nested declaration is visible to the root-level catch above.
module AliasInstaller:
    module NestedProvider:
        public:
            error Fault:
                Expected
                Missing
            extern load() -> i64 error[AliasInstaller::NestedProvider::Fault]
    using NestedProvider as NestedGlobal
