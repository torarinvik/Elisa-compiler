# Missing receiver/annotation bookkeeping must not construct AST placeholder nodes.
include "../../src/semantic/semantic.elisa"

extend Semantic:
    public:
        # The previous packed-AST spelling is an oracle only in this regression probe.
        def projected_origin_matches_old(projection: StorageViewOriginProjection&, root: sview, names: darray[sview]&, sources: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                old: mutable Ast::Expr = projection.value
                if projection.projected:
                    origins: mutable darray[Ast::Expr] = []
                    for index in 0..<projection.into_arguments.count |origins, projection|:
                        argument: Ast::Expr = projection.into_arguments[index]
                        field: sview = projection.into_fields[index]
                        origins.push(Ast::Expr.Field(vro_strip_borrow(argument), field, Ast::expr_pos(argument)) if field != "" else argument)
                    for index in 0..<projection.carry_arguments.count |origins, projection|:
                        argument: Ast::Expr = projection.carry_arguments[index]
                        field: sview = projection.carry_fields[index]
                        origins.push(Ast::Expr.Field(vro_strip_borrow(argument), field, Ast::expr_pos(argument)) if field != "" else argument)
                    empty_names: darray[sview] = []
                    old <- origins[0] if origins.count == 1 else Ast::Expr.Call(Ast::Expr.Ident("", Ast::expr_pos(old)), origins, empty_names, Ast::expr_pos(old))
                expected: mutable darray[sview] = []
                actual: mutable darray[sview] = []
                storage_view_field_origins(old, root, names, sources, expected)
                storage_view_projected_origins(projection, root, names, sources, actual)
                return false if actual.count != expected.count
                for index in 0..<actual.count:
                    return false if actual[index] != expected[index]
                return true

        def hot_pass_sentinel_behavior_probe() -> i32:
            can Memory.Allocate, Abort.Panic:
                pos: Ast::Pos = Ast::pos_at_line(7)
                receiver: Ast::Expr = Ast::Expr.Ident("receiver", pos)
                argument: Ast::Expr = Ast::Expr.Ident("argument", pos)
                method: Ast::Expr = Ast::Expr.Field(receiver, "origin", pos)
                static_method: Ast::Expr = Ast::Expr.Field(Ast::Expr.Ident("Type", pos), "origin", pos)
                direct: Ast::Expr = Ast::Expr.Ident("origin", pos)
                absent: Ast::Expr = Ast::Expr.Absent
                absent_method: Ast::Expr = Ast::Expr.Field(absent, "origin", pos)
                arguments: darray[Ast::Expr] = [argument]
                names: mutable darray[sview] = ["receiver", "argument"]
                sources: mutable darray[sview] = ["receiver-owner", "argument-owner"]
                views: mutable darray[bool] = [true, true]
                out: mutable darray[sview] = []
                receiver_origin: darray[sview] = ["origin", "2", "0", "into", ""]
                shifted_origin: darray[sview] = ["origin", "2", "1", "carry", ""]
                static_origin: darray[sview] = ["origin", "1", "0", "into", ""]
                thread_origin: darray[sview] = ["origin", "2", "0", "thread", ""]
                static_thread: darray[sview] = ["origin", "1", "0", "thread", ""]
                unknown_receiver: darray[sview] = ["origin", "2", "0", "unknown", "", "origin", "1", "0", "into", ""]
                storage_view_call_origin_sources(method, arguments, names, sources, views, receiver_origin, out)
                return 1 if out.count != 1 or out[0] != "receiver-owner"
                out.truncate(0)
                storage_view_call_origin_sources(method, arguments, names, sources, views, shifted_origin, out)
                return 2 if out.count != 1 or out[0] != "argument-owner"
                out.truncate(0)
                storage_view_call_origin_sources(static_method, arguments, names, sources, views, static_origin, out)
                return 3 if out.count != 1 or out[0] != "argument-owner"
                out.truncate(0)
                storage_view_call_origin_sources(direct, arguments, names, sources, views, static_origin, out)
                return 4 if out.count != 1 or out[0] != "argument-owner"
                out.truncate(0)
                storage_view_call_origin_sources(method, arguments, names, sources, views, thread_origin, out)
                return 5 if out.count != 2 or out[0] != "receiver-owner" or out[1] != "argument-owner"
                out.truncate(0)
                storage_view_call_origin_sources(static_method, arguments, names, sources, views, static_thread, out)
                return 6 if out.count != 1 or out[0] != "argument-owner"
                out.truncate(0)
                storage_view_call_origin_sources(method, arguments, names, sources, views, unknown_receiver, out)
                return 7 if out.count != 0
                storage_view_call_origin_sources(absent_method, arguments, names, sources, views, receiver_origin, out)
                return 8 if out.count != 0
                storage_view_call_origin_sources(absent_method, arguments, names, sources, views, thread_origin, out)
                return 9 if out.count != 1 or out[0] != "argument-owner"

                # A summarized field origin contributes a place root only in into mode;
                # carry mode contributes the object's existing backing aliases.
                field_into: darray[sview] = ["origin", "2", "0", "into", "buf"]
                field_carry: darray[sview] = ["origin", "2", "0", "carry", "buf"]
                out.truncate(0)
                storage_view_call_origin_sources(method, arguments, names, sources, views, field_into, out)
                return 19 if out.count != 2 or out[0] != "receiver" or out[1] != "receiver-owner"
                out.truncate(0)
                storage_view_call_origin_sources(method, arguments, names, sources, views, field_carry, out)
                return 20 if out.count != 1 or out[0] != "receiver-owner"
                borrowed_receiver: Ast::Expr = Ast::Expr.Paren(Ast::Expr.Unary(TokenKind.Ampersand, receiver, pos), pos)
                borrowed_method: Ast::Expr = Ast::Expr.Field(borrowed_receiver, "origin", pos)
                out.truncate(0)
                storage_view_call_origin_sources(borrowed_method, arguments, names, sources, views, field_into, out)
                return 21 if out.count != 2 or out[0] != "receiver" or out[1] != "receiver-owner"
                out.truncate(0)
                storage_view_call_origin_sources(absent_method, arguments, names, sources, views, field_into, out)
                return 22 if out.count != 0
                indexed_receiver: Ast::Expr = Ast::Expr.Index(receiver, Ast::Expr.IntLit(0, pos), pos)
                indexed_method: Ast::Expr = Ast::Expr.Field(indexed_receiver, "origin", pos)
                storage_view_call_origin_sources(indexed_method, arguments, names, sources, views, field_into, out)
                return 23 if out.count != 2 or out[0] != "receiver" or out[1] != "receiver-owner"

                mixed_origins: darray[sview] = ["origin", "2", "0", "into", "buf", "origin", "2", "1", "carry", "other"]
                empty_origin_rows: darray[sview] = []
                field_call: Ast::Expr = Ast::Expr.Call(method, arguments, empty_origin_rows, pos)
                single_projection: StorageViewOriginProjection = storage_view_call_field_value(field_call, field_into)
                mixed_projection: StorageViewOriginProjection = storage_view_call_field_value(field_call, mixed_origins)
                fallback_projection: StorageViewOriginProjection = storage_view_call_field_value(field_call, empty_origin_rows)
                return 24 if not single_projection.projected or not mixed_projection.projected or fallback_projection.projected
                unusual_names: darray[sview] = ["[field]", "", "receiver"]
                unusual_sources: darray[sview] = ["buf", "receiver", "argument"]
                roots: darray[sview] = ["receiver", "argument", "", "missing"]
                for root in roots:
                    return 25 if not projected_origin_matches_old(&single_projection, root, names, sources)
                    return 26 if not projected_origin_matches_old(&mixed_projection, root, names, sources)
                    return 27 if not projected_origin_matches_old(&fallback_projection, root, names, sources)
                    return 28 if not projected_origin_matches_old(&mixed_projection, root, unusual_names, unusual_sources)

                owner: Ast::Expr = Ast::Expr.Ident("owner", pos)
                other: Ast::Expr = Ast::Expr.Ident("other", pos)
                owner_ref: Ast::Expr = Ast::Expr.Unary(TokenKind.Ampersand, owner, pos)
                other_ref: Ast::Expr = Ast::Expr.Unary(TokenKind.Ampersand, other, pos)
                ref_name: Ast::Expr = Ast::Expr.Ident("ref", pos)
                target_name: Ast::Expr = Ast::Expr.Ident("target", pos)
                scalar_type: Ast::Expr = Ast::Expr.Ident("i64", pos)
                reference_type: Ast::Expr = Ast::Expr.Unary(TokenKind.Ampersand, scalar_type, pos)
                owners: darray[sview] = ["owner", "other"]
                lends: darray[sview] = []
                lend_positions: darray[usize] = []
                binders: BorrowBinders = BorrowBinders{names: ["ref", "typed", "explicit_ref", "target", "empty"]}
                borrows: mutable darray[sview] = []
                fields: mutable darray[sview] = []
                borrowed_owners: mutable darray[sview] = []
                kinds: mutable darray[u32] = [0, 0]
                details: mutable darray[sview] = ["", ""]
                flow: mutable darray[bool] = [false]
                table: mutable SymbolTable = SymbolTable()
                declarations: darray[Ast::Stmt] = [Ast::Stmt.VarDecl("ref", absent, owner_ref, pos), Ast::Stmt.VarDecl("typed", scalar_type, ref_name, pos), Ast::Stmt.VarDecl("explicit_ref", reference_type, owner_ref, pos), Ast::Stmt.VarDecl("empty", absent, absent, pos)]
                table <- bam_statements(declarations, owners, lends, lend_positions, binders, borrows, fields, borrowed_owners, kinds, details, flow, table)
                return 10 if bam_borrow_owner(borrows, fields, borrowed_owners, "ref", "") != "owner"
                return 11 if bam_borrow_owner(borrows, fields, borrowed_owners, "typed", "") != ""
                return 12 if bam_borrow_owner(borrows, fields, borrowed_owners, "explicit_ref", "") != "owner"
                return 13 if bam_borrow_owner(borrows, fields, borrowed_owners, "empty", "") != ""
                assignment: darray[Ast::Stmt] = [Ast::Stmt.Assign(target_name, TokenKind.Assign, ref_name, pos)]
                table <- bam_statements(assignment, owners, lends, lend_positions, binders, borrows, fields, borrowed_owners, kinds, details, flow, table)
                return 14 if bam_borrow_owner(borrows, fields, borrowed_owners, "target", "") != "owner"
                retarget: darray[Ast::Stmt] = [Ast::Stmt.Assign(target_name, TokenKind.LArrow, other_ref, pos)]
                table <- bam_statements(retarget, owners, lends, lend_positions, binders, borrows, fields, borrowed_owners, kinds, details, flow, table)
                return 15 if bam_borrow_owner(borrows, fields, borrowed_owners, "target", "") != ""
                return 16 if bam_borrow_owner(borrows, fields, borrowed_owners, "ref", "") != "owner"
                bam_set_consumed(owners, kinds, details, "owner", 2, "moved-owner")
                reinitialize: darray[Ast::Stmt] = [Ast::Stmt.Assign(owner, TokenKind.LArrow, Ast::Expr.IntLit(0, pos), pos)]
                table <- bam_statements(reinitialize, owners, lends, lend_positions, binders, borrows, fields, borrowed_owners, kinds, details, flow, table)
                return 17 if kinds[0] != 0
                return 18 if table.diagnostics.count != 0
                return 29 if affine_ref_pointee(scalar_type) is unexpected
                if affine_ref_pointee(reference_type) is pointee:
                    match pointee:
                        Expr.Ident(pointee_name, _):
                            return 30 if pointee_name != "i64"
                        _:
                            return 30
                else:
                    return 31
                return 32 if affine_ref_pointee(absent) is unexpected
                absent_reference: Ast::Expr = Ast::Expr.Unary(TokenKind.Ampersand, absent, pos)
                if affine_ref_pointee(absent_reference) is pointee:
                    return 33 if not (pointee is Expr.Absent)
                else:
                    return 34
                wrapped_reference: Ast::Expr = Ast::Expr.Paren(Ast::Expr.Unary(TokenKind.Mutable, Ast::Expr.Unary(TokenKind.Question, reference_type, pos), pos), pos)
                return 35 if not affine_annotation_is_ref(wrapped_reference)
                return 36 if affine_annotation_is_ref(absent_reference) or affine_annotation_is_ref(scalar_type)
                return 37 if affine_binding_type(scalar_type, &table) != "i64" or affine_binding_type(wrapped_reference, &table) != "i64"
                # A real Absent receiver remains an origin; missing receiver bookkeeping
                # must not create or erase it. Argument/field projections stay aligned.
                absent_origins: darray[Ast::Expr] = vro_origin_arguments(absent_method, arguments, receiver_origin, false)
                absent_fields: darray[sview] = vro_origin_fields(absent_method, arguments, receiver_origin, false)
                return 38 if absent_origins.count != 1 or absent_fields.count != 1
                return 39 if not (absent_origins[0] is Expr.Absent) or absent_fields[0] != ""
                static_origins: darray[Ast::Expr] = vro_origin_arguments(static_method, arguments, static_origin, false)
                return 40 if static_origins.count != 1
                match static_origins[0]:
                    Expr.Ident(origin_name, _):
                        return 41 if origin_name != "argument"
                    _:
                        return 41
                return 42 if rvc_ref_pointee(scalar_type) is unexpected
                return 43 if rvc_ref_pointee(absent) is unexpected
                if rvc_ref_pointee(absent_reference) is pointee:
                    return 44 if not (pointee is Expr.Absent)
                else:
                    return 45
                mutable_reference: Ast::Expr = Ast::Expr.Unary(TokenKind.Mutable, reference_type, pos)
                if rvc_ref_pointee(mutable_reference) is pointee:
                    match pointee:
                        Expr.Ident(pointee_name, _):
                            return 46 if pointee_name != "i64"
                        _:
                            return 46
                else:
                    return 47
                # This helper deliberately does not unwrap optional/parenthesized annotations.
                return 48 if rvc_ref_pointee(Ast::Expr.Paren(reference_type, pos)) is unexpected
                return 49 if rvc_ref_pointee(Ast::Expr.Unary(TokenKind.Question, reference_type, pos)) is unexpected
                return 50 if not lvre_arena_param(Ast::Expr.Ident("Arena", pos))
                return 51 if not lvre_arena_param(Ast::Expr.Unary(TokenKind.Ampersand, Ast::Expr.Ident("Arena", pos), pos))
                return 52 if lvre_arena_param(absent_reference)
                return 0

def main() -> i32:
    can Memory.Allocate, Abort.Panic:
        return Semantic::hot_pass_sentinel_behavior_probe()
