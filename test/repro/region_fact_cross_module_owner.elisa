# Two modules use the same logical line, leaf function name, and arity, but
# only Right::act grows its reference parameter. Their inferred arena facts
# must stay attached to the declaring module.
module Left:
    public:
#line 0 region-fact-cross-module.elisa
        def act(values: darray[i64]&) -> usize:
            return values.count

module Right:
    public:
#line 0 region-fact-cross-module.elisa
        def act(values: mutable darray[i64]&) -> void:
            values.push(41)

def main() -> i64:
    values: mutable darray[i64] = []
    Right::act(&values)
    return 0 if Left::act(values) == 1 and values[0] == 41 else 1
