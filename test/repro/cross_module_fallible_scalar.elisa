# Qualified fallible calls across module boundaries must lower in the generic
# backend even when the caller is itself exported from a module.

error RenderError:
    Rejected

module RenderHost:
    public:
        def checked(value: i64) -> i64 error[RenderError]:
            return value + 1

module WasmBrowser::Graphics:
    public:
        def append(value: i64) -> i64 error[RenderError]:
            return RenderHost::checked(value)

def main() -> i64:
    return try WasmBrowser::Graphics::append(41) else 99
