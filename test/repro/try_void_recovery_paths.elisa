# Guard and recovery are each evaluated exactly when required. Cover an error
# and a success with both explicit no-op and side-effecting recovery.
error VoidRecoveryFailure:
    Requested

const VOID_RECOVERY_GENERIC_STEP: i64 = 1

def void_recovery_generic_guarded[T](count: mutable i64&, step: T, fail: bool) -> void error[VoidRecoveryFailure]:
    count <- count + VOID_RECOVERY_GENERIC_STEP
    if fail:
        raise VoidRecoveryFailure.Requested

module VoidRecoveryPaths:
    private:
        const INITIAL: i64 = 0
        const GUARD_STEP: i64 = 1
        const RECOVERY_STEP: i64 = 10
        const EXPECTED: i64 = 28

        def guarded(count: mutable i64&, fail: bool) -> void error[VoidRecoveryFailure]:
            count <- count + GUARD_STEP
            if fail:
                raise VoidRecoveryFailure.Requested

        def recover(count: mutable i64&) -> void:
            count <- count + RECOVERY_STEP

    public:
        def check() -> i64 can[Abort.Panic]:
            count: mutable i64 = INITIAL
            try guarded(&count, true) else recover(&count)
            try guarded(&count, false) else recover(&count)
            try guarded(&count, true) else void
            try guarded(&count, false) else void
            try void_recovery_generic_guarded[i64](&count, GUARD_STEP, true) else recover(&count)
            try void_recovery_generic_guarded[i64](&count, GUARD_STEP, false) else recover(&count)
            try void_recovery_generic_guarded(&count, GUARD_STEP, true) else void
            try void_recovery_generic_guarded(&count, GUARD_STEP, false) else void
            assert count == EXPECTED
            return INITIAL

def main() -> i64 can[Abort.Panic]:
    can Abort.Panic:
        return VoidRecoveryPaths::check()
