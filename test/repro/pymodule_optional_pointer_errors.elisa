# Pointer-optional returns should compose with Elisa error sets at the Python boundary.
error MaybePointerError:
    Invalid

def maybe_text(value: i64) -> cstr? error[MaybePointerError]:
    raise MaybePointerError.Invalid if value < 0
    null return if value == 0
    return "ready"

def maybe_object(value: py::Object?) -> py::Object? error[MaybePointerError]:
    null return if value == null
    return value

export pymodule optional_pointer_errors:
    fn text = maybe_text
    fn object = maybe_object
