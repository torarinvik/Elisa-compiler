module Right:
    const enum Message of i32:
        Other
        Ready
module Outer:
    module Right:
        const enum Message of i32:
            Ready
            Other
    module Worker:
        def answer() -> i64:
            message: Right::Message = Right::Message.Ready
            return 42 if message.i64() == 0 and message == Right::Message.Ready else 1
def main() -> i64:
    return Outer::Worker::answer()
