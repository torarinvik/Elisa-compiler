module Outer:
    module Wrong:
        enum Message:
            Some(left: i64, right: i64)
            Empty
    module Right:
        enum Message:
            Empty
            Some(value: i64)
using Outer::Right as First
using First as Second
using Second as R

def bad() -> R::Message:
    return Outer::Wrong::Message.Some(20, 22)

def main() -> i64:
    return 42
