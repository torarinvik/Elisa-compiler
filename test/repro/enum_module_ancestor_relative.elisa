module Right:
    enum Message:
        Some(left: i64, right: i64)
module Outer:
    module Right:
        enum Message:
            Empty
            Some(value: i64)
    module Worker:
        def answer() -> i64:
            message: Right::Message = Right::Message.Some(42)
            match message:
                Right::Message.Some(value):
                    return value
                Right::Message.Empty:
                    return 0
            return -1
def main() -> i64:
    return Outer::Worker::answer()
