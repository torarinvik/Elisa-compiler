# Try's callable resolver must ignore an ErrorSet declared by a function in an
# unselected static-if arm and use the function and ErrorSet selected by Stage0.
const USE_INACTIVE_PROVIDER: bool = false

module Provider:
    module Inner:
        public:
            error InactiveFault:
                Inactive

            error ActiveFault:
                Active

        static if USE_INACTIVE_PROVIDER:
            public:
                def origin(value: bool) -> i64 error[Provider::Inner::InactiveFault]:
                    return 1
        static else:
            public:
                def origin(value: bool) -> i64 error[Provider::Inner::ActiveFault]:
                    return 2

module Consumer:
    module Inner:
        public:
            def caller(value: bool) -> i64 error[Provider::Inner::ActiveFault]:
                return try Provider::Inner::origin(value)

def main() -> i64:
    return 0
