# A rank-off named call keeps the resolvable fallible defaulted primary;
# an infallible sibling missing a required parameter must not shadow it.
module Provider:
    public:
        error Fault:
            Failed

        def choose(value: i64, fallback: i64 = 0) -> i64 error[Provider::Fault]:
            return value + fallback

        def choose(value: i64, required: bool) -> i64:
            return value

from Provider import choose

module Consumer:
    public:
        error Expected:
            Rejected

        def wrapper(value: i64) -> i64 error[Consumer::Expected]:
            return choose(value: value)

def main() -> i64:
    return 0
