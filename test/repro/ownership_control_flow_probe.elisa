include "../../src/semantic/semantic.elisa"

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    source: u8& = "affine struct File[state Closed | Open]:\n    handle: i64\ndef twice(owner: File[Closed]) -> void:\n    _ = move owner\n    _ = move owner\ndef branch(owner: File[Closed], choice: bool) -> void:\n    if choice:\n        _ = move owner\n    _ = move owner\ndef both(owner: File[Closed], choice: bool) -> void:\n    if choice:\n        _ = move owner\n    else:\n        _ = move owner\n    _ = move owner\ndef returning(owner: File[Closed], choice: bool) -> void:\n    if choice:\n        _ = move owner\n        return\n    _ = move owner\n    _ = move owner\ndef shadow(owner: File[Closed], choice: bool) -> void:\n    if choice:\n        owner: File[Closed] = File[Closed]{handle: 0}\n        _ = move owner\n    _ = move owner\ndef loop(owner: File[Closed], choice: bool) -> void:\n    while choice:\n        _ = move owner\n    _ = move owner\n"
    tokens: darray[Lexer::Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    return 1 if file.errors.count != 0
    table: Semantic::SymbolTable = Semantic::check(&file)
    return 2 if table.ownership_function_flows.count != 6
    twice_count: mutable usize = 0
    branch_count: mutable usize = 0
    both_count: mutable usize = 0
    returning_count: mutable usize = 0
    shadow_count: mutable usize = 0
    loop_count: mutable usize = 0
    shadow_id: mutable u64 = 0
    for occurrence in table.ownership_occurrences |twice_count, branch_count, both_count, returning_count, shadow_count, loop_count, shadow_id|:
        continue if not occurrence.is_move
        name: sview = table.symbols[occurrence.binding_id.owner.value.usize()].name
        if name == "twice":
            return 3 if not occurrence.known or occurrence.liveness_available != (twice_count == 0)
            twice_count <- twice_count + 1
        elif name == "branch":
            return 4 if not occurrence.known or occurrence.liveness_available != (branch_count == 0)
            branch_count <- branch_count + 1
        elif name == "both":
            return 5 if not occurrence.known or occurrence.liveness_available != (both_count < 2)
            both_count <- both_count + 1
        elif name == "returning":
            return 6 if not occurrence.known or occurrence.liveness_available != (returning_count < 2)
            returning_count <- returning_count + 1
        elif name == "shadow":
            return 7 if not occurrence.known or not occurrence.liveness_available
            shadow_id <- occurrence.binding_id.serial if shadow_count == 0
            return 8 if shadow_count == 1 and occurrence.binding_id.serial == shadow_id
            shadow_count <- shadow_count + 1
        elif name == "loop":
            return 9 if not occurrence.known or occurrence.liveness_available
            loop_count <- loop_count + 1
    return 10 if twice_count != 2 or branch_count != 2 or both_count != 3 or returning_count != 3 or shadow_count != 2 or loop_count != 2
    for summary in table.ownership_function_flows:
        name: sview = table.symbols[summary.owner.value.usize()].name
        return 11 if not summary.coverage_complete
        return 12 if not summary.fallthrough_reachable
        return 13 if summary.facts_start > table.ownership_exit_facts.count or summary.facts_count > table.ownership_exit_facts.count - summary.facts_start
    return 0
