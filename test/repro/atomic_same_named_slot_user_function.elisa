# This source must retain ordinary user-function semantics. The AtomicSlot name alone must
# not grant an LLVM atomic intrinsic to a user-defined struct or to a same-named `load`.
struct AtomicSlot[T]:
    value: mutable T

enum MemoryOrder:
    Relaxed
    Acquire
    Release
    AcqRel
    SeqCst

def load(slot: AtomicSlot[i64]&, order: MemoryOrder) -> i64:
    _ = slot
    _ = order
    return 42

def main() -> i64:
    slot: mutable AtomicSlot[i64] = AtomicSlot[i64]{value: 0}
    return load(&slot, MemoryOrder.Acquire)
