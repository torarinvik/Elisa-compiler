module FirstTarget:
    public:
        const enum Mode of i64:
            High = 41

module SecondTarget:
    public:
        const enum Mode of i64:
            High = 52

module FirstScope:
    using FirstTarget as Shared
    def first_shared_default(value: i64 = Shared::Mode.High) -> i64:
        return value

module SecondScope:
    using SecondTarget as Shared
    def second_shared_default(value: i64 = Shared::Mode.High) -> i64:
        return value

module AliasChainTarget:
    module Nested:
        public:
            def scoped_value() -> i64:
                return 168
            const enum ScopedMode of i64:
                Ready = 84

module AliasChainDecoy:
    module Nested:
        public:
            def scoped_value() -> i64:
                return 252

module AliasCollisionTarget:
    public:
        const enum Kind of i64:
            Ready = 84

module AliasParent:
    module Mode:
        public:
            const enum Kind of i64:
                Ready = 41
    module Inner:
        using AliasCollisionTarget as Mode
        def nested_alias_collision() -> i64:
            return Mode::Kind.Ready

module AliasLocalTarget:
    public:
        const enum Kind of i64:
            Ready = 84

using AliasLocalTarget as LocalMode
module AliasLocalCollision:
    module LocalMode:
        public:
            const enum Kind of i64:
                Ready = 41
    def current_scope_alias_collision() -> i64:
        return LocalMode::Kind.Ready

module NestedAliasScope:
    using AliasChainTarget as ScopedRoot
    using ScopedRoot :: Nested as ScopedNested
    def nested_alias_default(value: i64 = ScopedNested::ScopedMode.Ready) -> i64:
        return value
    def nested_alias_call_default(value: i64 = ScopedNested::scoped_value()) -> i64:
        return value
    def nested_alias_body_call() -> i64:
        return ScopedNested::scoped_value()
    def nested_alias_body_enum() -> i64:
        return ScopedNested::ScopedMode.Ready
    using AliasChainDecoy::Nested as ScopedNested

def main() -> i64:
    if FirstScope::first_shared_default() != 41:
        return 1
    if SecondScope::second_shared_default() != 52:
        return 2
    if NestedAliasScope::nested_alias_default() != 84:
        return 3
    if NestedAliasScope::nested_alias_call_default() != 168:
        return 4
    if NestedAliasScope::nested_alias_body_call() != 168:
        return 5
    if NestedAliasScope::nested_alias_body_enum() != 84:
        return 6
    if AliasParent::Inner::nested_alias_collision() != 84:
        return 7
    if AliasLocalCollision::current_scope_alias_collision() != 41:
        return 8
    return 0
