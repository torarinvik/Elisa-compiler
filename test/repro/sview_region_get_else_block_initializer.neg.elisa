error RecoveryStoreFailure:
    Failed

def maybe() -> i64 error[RecoveryStoreFailure]:
    raise RecoveryStoreFailure.Failed
    return 1

def bad() -> i64:
    can Memory.Allocate, Abort.Panic:
        region outer(4096):
            outer_bytes: mutable darray[u8] @outer = [65.u8()]
            retained: mutable sview @outer = outer_bytes.as_sview()
            region inner(4096):
                inner_bytes: mutable darray[u8] @inner = [66.u8()]
                view: sview = inner_bytes.as_sview()
                fallback: i64 =
                    try maybe() else err:
                        retained <- view
                        return 0
                return fallback
            return retained.len

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        return bad()
