# A by-value aggregate candidate must not hide Core's higher-ranked matching Ref receiver.
error ReferenceFault:
    Ref

error ValueFault:
    Value

struct Node:
    value: i64

def choose(value: mutable Node&) -> i64 error[ReferenceFault]:
    return 1

def choose(value: Node) -> i64 error[ValueFault]:
    return 2

def matching_reference(value: mutable Node&) -> i64 error[ReferenceFault]:
    return try choose(value)

def mismatched_destination(value: mutable Node&) -> i64 error[ValueFault]:
    return try choose(value)

def main() -> i64:
    return 0
