error FirstError:
    Empty
    # Excluded by the restricted set below; it must not widen the ABI payload.
    Other(values: i64[4])

error SecondError:
    Missing(value: u32)
    Other

extern external_probe(code: i64) -> i64 error[FirstError{Empty}, SecondError]

def use() -> i64:
    return catch external_probe(0):
        value: value
        FirstError.Empty: 1
        SecondError.Missing(payload): payload.i64()
        SecondError.Other: 4

def main() -> i64:
    return use() + 1
