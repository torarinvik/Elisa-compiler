# Regression companion: large aggregate parameters must use the same ABI classification
# whether the callee is generic or ordinary.
struct LargeResult:
    words: i64[200]

def pass_large(value: LargeResult) -> LargeResult:
    return value

def main() -> i64:
    source: LargeResult = zeroed
    value: LargeResult = pass_large(source)
    return value.words[0]
