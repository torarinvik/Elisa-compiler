# `common:` fields whose type is not i64. stage0 lowers this and prints 42;
# stage1 REFUSES it at compile time.
#
# ROOT CAUSE (measured by instrumenting every exit in the constructor emitter,
# after four wrong hypotheses -- it is not arity, not the store lookup, not the
# read path, and not the row stride):
#
#   The backend emits and reads a common field as a hardcoded i64 word, and it
#   NEVER RECORDS the common's declared type. Registration strips the commons
#   from each variant's field-type span, and packed_common_names holds names
#   only -- so there is no type to emit the value at. `common: span: int` works
#   because int IS i64, which is why the compiler's own AST never noticed.
#
# THE FIX is a data-model change, not a codegen tweak: record a common-field
# TYPE table parallel to packed_common_names at registration, then have the
# constructor emit at that type and the reader load at it. Both sites are
# already located (codegen_call.elisa's common store loop and
# codegen_expr_index_fields.elisa's common read).
#
# Also note: exit 2 here is the WRAPPER's failure code for a declined compile,
# not a program exit. Two earlier notes misread it, first as a silent wrong
# answer and then as a runtime panic. It is a clean compile-time refusal.
#
# elisa-ui does not need this: geometry lives in a dense side array indexed by a
# node id, which is the better layout for two passes that rewrite every box each
# frame while touching nothing else.
enum Widget:
    common:
        w: f32
    pass

enum Control is Widget:
    Label(text: sview)

enum Button is Control:
    Push(label: sview)

def make() -> Widget:
    return Button.Push(w: 42.0, label: "go")

def width_of(x: Widget) -> f32:
    return x.w

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        node: Widget = make()
        return width_of(node).i64() - 42
