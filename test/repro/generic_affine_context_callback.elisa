# A module-owned executor specializes its callback over two affine context types.
module Executor:
    public:
        error ExecError:
            BadPlan

        struct State:
            value: mutable i64
            trace: mutable i64[4]
            length: mutable usize

        struct Plan:
            order: usize[4]
            count: usize

        def State() -> State:
            State{value: 0, trace: zeroed, length: 0}

        def Plan(order: usize[4], count: usize) -> Plan:
            Plan{order: order, count: count}

        def execute[ContextA, ContextB](state: mutable State&,
            plan: Plan&,
            context_a: mutable ContextA&, context_b: mutable ContextB&,
            callback: fn(mutable State&, usize, mutable ContextA&, mutable ContextB&) -> void) -> void error[ExecError]:
            raise ExecError.BadPlan if plan.count > 4
            for slot in 0..<plan.count |state, plan, context_a, context_b, callback|:
                callback(state, plan.order[slot], context_a, context_b)
                state.trace[state.length] <- plan.order[slot].i64()
                state.length <- state.length + 1

module Probe:
    private:
        affine struct ContextA:
            value: mutable i64

        affine struct ContextB:
            value: mutable i64

        def dispatch(state: mutable Executor::State&, index: usize,
            context_a: mutable ContextA&, context_b: mutable ContextB&) -> void:
            state.value <- state.value + index.i64() + context_a.value + context_b.value

    public:
        def run() -> i64 error[Executor::ExecError]:
            state: mutable Executor::State = Executor::State()
            plan: Executor::Plan = Executor::Plan([0, 1, 0, 0], 2)
            context_a: mutable ContextA = ContextA{value: 7}
            context_b: mutable ContextB = ContextB{value: 11}
            try Executor::execute(&state, plan, &context_a, &context_b, dispatch)
            raise Executor::ExecError.BadPlan if state.value != 37
            state.value

def main() -> i64:
    catch Probe::run():
        value: value
        error failure: -1
