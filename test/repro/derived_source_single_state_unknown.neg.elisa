struct PositiveOnly[state Positive]:
    health: mutable i64
    tag: i64
    derive state:
        Positive when self.health > 0

# Unknown predicate evidence must not become knowledge merely because the
# family's full possible-state set has the same spelling as its single case.
def unknown_write(player: mutable PositiveOnly[Positive], again: bool, value: i64) -> PositiveOnly[Positive]:
    while again:
        player.health <- value
    return player{tag = 1}
