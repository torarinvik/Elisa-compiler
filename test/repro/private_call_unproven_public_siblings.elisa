# Public overload candidates may suppress a private import only when the checker can
# prove their branch is active and their arity accepts this call.
module PrivateProvider:
    private:
        def choose_default[T](value: T, first: i64, second: i64) -> i64:
            return 1

        def choose_float[T](value: T) -> i64:
            return 2

        def choose_string[T](value: T) -> i64:
            return 3

from PrivateProvider import choose_default
from PrivateProvider import choose_float
from PrivateProvider import choose_string

# This direct candidate has a default but rejects three arguments because its
# maximum arity is two. The imported generic remains the only viable overload.
def choose_default(value: bool, optional: i64 = 0) -> i64:
    return 4

static if 1.0 == 0.0:
    def choose_float(value: bool) -> i64:
        return 5
static else:
    def choose_float(value: i64) -> i64:
        return 6

static if "a" == "b":
    def choose_string(value: bool) -> i64:
        return 7
static else:
    def choose_string(value: i64) -> i64:
        return 8

def main() -> i64:
    return choose_default(true, 1, 2) + choose_float(true) + choose_string(true)
