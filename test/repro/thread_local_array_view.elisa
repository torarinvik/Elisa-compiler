packed enum Expr:
	Int(value: int)

struct Box:
	node: Expr

@borrows_return(field, node, node)
extern wrap_node(node: Expr) -> Box

def pool_submit1[A, R](pool: mutable ThreadPool&, fn: fn(A) -> R, arg: A) -> Task[R, Pending]:
	return zeroed

def worker(items: view[Box]) -> i64:
	_ = items
	return 0

def direct(owner: Arena, pool: mutable ThreadPool&) -> Task[i64, Pending] can[Pool.Submit]:
	store: Expr.Store[Local] = Expr.Store(owner)
	node: Expr = new[store] Expr.Int(value: 1)
	items: array[Box, 1] = [wrap_node(node)]
	frozen: Expr.Store[Frozen] = freeze(move store)
	_ = frozen
	return submit[pool] worker(items[0:1])

def alias(owner: Arena, pool: mutable ThreadPool&) -> Task[i64, Pending] can[Pool.Submit]:
	store: Expr.Store[Local] = Expr.Store(owner)
	node: Expr = new[store] Expr.Int(value: 1)
	items: array[Box, 1] = [wrap_node(node)]
	frozen: Expr.Store[Frozen] = freeze(move store)
	_ = frozen
	slice: view[Box] = items[0:1]
	return submit[pool] worker(slice)

def parameter(pool: mutable ThreadPool&, items: array[Box, 1]) -> Task[i64, Pending] can[Pool.Submit]:
	return submit[pool] worker(items[0:1])

def int_worker(items: view[int]) -> i64:
	_ = items
	return 0

def inferred(pool: mutable ThreadPool&) -> Task[i64, Pending] can[Pool.Submit]:
	items = [1]
	return submit[pool] int_worker(items[0:1])
