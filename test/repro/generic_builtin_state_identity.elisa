struct Token[S]:
    value: mutable i64

def identity[T](value: T) -> T:
    return value

def main() -> i64:
    local: mutable Token[Local] = zeroed
    local.value <- 6
    result_local: Token[Local] = identity(local)
    frozen: mutable Token[Frozen] = zeroed
    frozen.value <- 5
    result_frozen: Token[Frozen] = identity(frozen)
    joinable: mutable Token[Joinable] = zeroed
    joinable.value <- 7
    result_joinable: Token[Joinable] = identity(joinable)
    pending: mutable Token[Pending] = zeroed
    pending.value <- 13
    result_pending: Token[Pending] = identity(pending)
    held: mutable Token[Held] = zeroed
    held.value <- 11
    result_held: Token[Held] = identity(held)
    return result_local.value + result_frozen.value + result_joinable.value + result_pending.value + result_held.value
