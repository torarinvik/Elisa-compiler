include "../../elisacore_std/elisacore_runtime.elisa"

# `sview(base, start, end)` CLAMPS, and stage1 inlined it without the clamp.
#
# stage0 emits a real CALL to the std constructor
# (elisacore_std/elisacore_runtime_strings.elisa:203):
#
#   src = value if value != null else ""
#   len = strlen(src)
#   lo  = min(start, len) if start > 0  else 0
#   hi  = min(end,   len) if end  >= 0  else len
#   hi  = lo if hi < lo
#   {src + lo, hi - lo}
#
# stage1 intercepts the name and emitted `{base + start, end - start}` — no strlen, no
# clamp, no null check. Every line below is a position where those two disagree; stage0
# answers 63 and stage1 answered 36.
#
# `end < 0` is not a corner case: `__cast__(value: u8&?) -> sview` IS `sview(value, 0, -1)`,
# so under stage1 every `x.sview()` produced a view of LENGTH -1. See
# test/repro/sview_postfix_cast.elisa for that half, and
# test/repro/nul_sentinel_sview.elisa for the consumer that had to tolerate it.
#
# The strlen is not an optimization loss to be avoided: it is the bound every clamp is
# measured against, and stage0's own lowering pays exactly the same call.
def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    score: mutable i64 = 0
    s: cstr = "hello"

    # end < 0 means "to the end of the string" — the __cast__ shape.
    to_end: sview = sview(s, 0, -1)
    score <- score + 1 if to_end.len == 5

    # end past the end clamps to len.
    past_end: sview = sview(s, 0, 99)
    score <- score + 2 if past_end.len == 5

    # start past the end clamps to len, so the view is empty.
    past_start: sview = sview(s, 99, 99)
    score <- score + 4 if past_start.len == 0

    # hi < lo collapses to empty rather than to a NEGATIVE length.
    inverted: sview = sview(s, 3, 1)
    score <- score + 8 if inverted.len == 0

    # start <= 0 means "from the beginning".
    negative_start: sview = sview(s, -4, 3)
    score <- score + 16 if negative_start.len == 3

    # The ordinary in-range span, which was already right — pinned so the clamp cannot
    # break it.
    in_range: sview = sview(s, 1, 4)
    score <- score + 32 if in_range.len == 3

    return score
