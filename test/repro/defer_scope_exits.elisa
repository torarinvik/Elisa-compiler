# `defer block:` runs when the SCOPE that declared it ends — not once, and not at function
# exit. Every exit is a scope exit: the end of a loop ITERATION, the end of a `region` body,
# the `raise` path of an error function.
#
# Only the pool/nursery block ever unwound scope-exit defers, so each of these ran at the
# wrong time or not at all. The trace digits encode WHICH blocks ran and IN WHAT ORDER, so a
# defer that runs once instead of twice, or after the wrong statement, is a wrong answer.
global mutable trace: i64 = 0

def note(n: i64) -> void:
    trace <- trace * 10 + n

# Per ITERATION: 2,1,2,1 — not 2,2,1 (once, at function exit).
def in_loop_body() -> void:
    for i in 0..<2:
        defer block:
            note(1)
        note(2)

# At the REGION's end, BEFORE the statement that follows it: 2,1,3 — not 2,3,1.
def in_region() -> void:
    region scratch:
        defer block:
            note(1)
        note(2)
    note(3)

# A `defer function:` at the outermost scope (the only place the language allows one) must
# still run at FUNCTION exit — the control that the new scope-exit unwind does not steal it.
def function_scoped() -> void:
    defer function:
        note(4)
    for i in 0..<2:
        note(5)
    note(6)

error Bad:
    Boom

# A `raise` is a function exit, so it unwinds like a `return`.
def raises(x: i64) -> i64 error[Bad]:
    defer block:
        note(7)
    raise Bad.Boom if x < 0
    note(8)
    return x

# `break` and `continue` jump straight past the end-of-iteration unwind, so each has to run
# the loop body's scope-exit defers itself. `break` at i==1 gives 2,1,2,1 — not 2,1,2.
def with_break() -> void:
    for i in 0..<4:
        defer block:
            note(1)
        note(2)
        break if i == 1

def with_continue() -> void:
    for i in 0..<3:
        defer block:
            note(1)
        continue if i == 1
        note(2)

# A `while` body is a scope on the same terms as a `for` body.
def in_while() -> void:
    i: mutable i64 = 0
    while i < 2 |i|:
        defer block:
            note(1)
        note(2)
        i <- i + 1

# NESTED regions: the inner one's defer runs at the inner end, and breaking out of a loop
# inside a region must not reach for the region's own defer.
def nested_regions() -> void:
    region outer:
        defer block:
            note(1)
        region inner:
            defer block:
                note(2)
            note(3)
        note(4)


# A MATCH ARM body is a statement list like any other, so its defer runs at the arm's end —
# stage0 2,1,4, not 2,4,1. Same for an `if` branch.
def in_match_arm(n: i64) -> void:
    match n:
        0:
            defer block:
                note(1)
            note(2)
        _:
            note(3)
    note(4)

def in_if_branch(flag: bool) -> void:
    if flag:
        defer block:
            note(1)
        note(2)
    else:
        note(3)
    note(4)


def run_one(which: i64) -> i64:
    trace <- 0
    in_loop_body() if which == 0        # 2121
    in_region() if which == 1           # 213
    function_scoped() if which == 2     # 5,5,6 then the function defer: 5564
    if which == 3:
        catch raises(-1):
            v:
                note(9)
            error e:
                note(0)                 # 7 then 0 -> 70
    with_break() if which == 4          # 2,1,2,1
    with_continue() if which == 5       # 2,1,1,2,1
    in_while() if which == 6            # 2,1,2,1
    nested_regions() if which == 7      # 3,2,4,1
    in_match_arm(0) if which == 8       # 2,1,4
    in_if_branch(true) if which == 9    # 2,1,4
    return trace

def main() -> i64:
    total: mutable i64 = 0
    for which in 0..<10 |total|:
        total <- total + run_one(which)
    return total % 251
