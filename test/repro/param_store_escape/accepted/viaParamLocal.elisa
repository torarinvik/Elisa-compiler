struct D:
    name: sview

def pick(names: darray[sview]&) -> darray[sview]:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[sview] = []
        out.push(names[0])
        return out

def mk() -> darray[sview]:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[sview] = []
        out.push("x")
        return out

def check(diags: mutable darray[D]&, other: darray[sview]&) -> void:
    can Memory.Allocate, Abort.Panic:
        v: sview = other[0]
        diags.push(D{name: v})

def main() -> i32:
    return 0
