struct D:
    name: sview
    expected: sview

struct T:
    diags: mutable darray[D]

def walk(name: sview, visited: mutable darray[sview]&, diags: mutable darray[D]&) -> void:
    can Memory.Allocate, Abort.Panic:
        diags.push(D{name: visited[0], expected: name})

def check(name: sview, table: lmut T) -> void:
    can Memory.Allocate, Abort.Panic:
        buf: darray[u8] = [65, 66]
        visited: mutable darray[sview] = []
        visited.push("lit")
        diags: mutable darray[D] = []
        walk(name, visited, diags)
        for d in diags |table|:
            table.diags <- table.diags.push(d)

def main() -> i32:
    can Memory.Allocate, Abort.Panic:
        t: mutable T = T{diags: []}
        t <- check("a", t)
        return t.diags.count.i32()
