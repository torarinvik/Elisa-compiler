struct D:
    name: sview

def pick(names: darray[sview]&) -> darray[sview]:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[sview] = []
        out.push(names[0])
        return out

def mk() -> darray[sview]:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[sview] = []
        out.push("x")
        return out

def check(diags: mutable darray[D]&, other: darray[sview]&) -> void:
    can Memory.Allocate, Abort.Panic:
        buf: darray[u8] = [65, 66]
        names: mutable darray[sview] = []
        names.push(buf.as_sview())
        diags[0] <- D{name: other[0]}

def main() -> i32:
    return 0
