# A bare `State` written in `extend Cipher:` names Cipher's plain struct, not the
# view-holding `Sheet::State`.
module Cipher:
    struct State:
        runs: i64
        last_in: darray[i64]
        meta: mutable i64

    def advance(state: State&, given: darray[i64]&) -> State:
        can Abort.Panic, Memory.Allocate:
            copy: mutable darray[i64] = []
            for value in given |copy|:
                copy.push(value)
            return State{runs: state.runs + 1, last_in: copy, meta: state.meta}

module Sheet:
    struct State:
        label: sview

module Other:
    def advance(count: i64) -> i64:
        return count + 1

extend Cipher:
    def check(state: mutable State&, given: darray[i64]&) -> i64:
        can Abort.Panic, Memory.Allocate:
            guess: mutable darray[i64] = []
            for value in given |guess|:
                guess.push(value + 1)
            prior: Cipher::State = Cipher::advance(state, &guess)
            state.meta <- prior.meta
            return state.runs

def main() -> i32:
    can Abort.Panic, Memory.Allocate:
        state: mutable Cipher::State = zeroed
        given: darray[i64] = [1, 2]
        return Cipher::check(&state, &given).i32() + Other::advance(0).i32()
