struct D:
    name: sview

def pick(names: darray[sview]&) -> darray[sview]:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[sview] = []
        out.push(names[0])
        return out

def ident(names: darray[sview]&) -> sview:
    return names[0]

def check(diags: mutable darray[D]&) -> void:
    can Memory.Allocate, Abort.Panic:
        buf: darray[u8] = [65, 66]
        names: mutable darray[sview] = []
        names.push("lit")
        copies: darray[sview] = [n for n in names]
        diags.push(D{name: copies[0]})

def main() -> i32:
    return 0
