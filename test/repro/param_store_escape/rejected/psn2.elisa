struct D:
    name: sview
    line: u32

struct T:
    diags: mutable darray[D]

def cycles(src: sview, table: lmut T) -> void:
    can Memory.Allocate, Abort.Panic:
        buf: darray[u8] = [65, 66]
        names: mutable darray[sview] = []
        names.push(buf.as_sview())
        copies: darray[sview] = [n for n in names]
        index: mutable usize = 0
        while index < names.count |index, names, table|:
            table.diags <- table.diags.push(D{name: copies[index], line: 1})
            index <- index + 1

def main() -> i32:
    can Memory.Allocate, Abort.Panic:
        t: mutable T = T{diags: []}
        t <- cycles("ab", t)
        return t.diags.count.i32()
