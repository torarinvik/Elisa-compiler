struct ObjectBatch:
    values: darray[py::Object]

def count(batch: ObjectBatch) -> usize:
    return batch.values.count

def echo(batch: ObjectBatch) -> ObjectBatch:
    return batch

struct NullableObjectBatch:
    values: darray[py::Object?]

def nullable_echo(batch: NullableObjectBatch) -> NullableObjectBatch:
    return batch

export pymodule struct_object_input:
    fn count
    fn echo
    fn nullable_echo
