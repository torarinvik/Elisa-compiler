# Real collector coverage for adoption, rewind, trim, and address reuse.
include "../../elisacore_std/arena.elisa"
def main() -> i64:
    parent: mutable Arena = zeroed
    child: mutable Arena = zeroed
    _ = arena_alloc(&parent, 32.usize())
    mark: ArenaMark = arena_snapshot(&parent)
    _ = arena_alloc(&child, 2097152.usize())
    arena_adopt(&parent, &child)
    return 1 if child.begin != null
    arena_free(&child)
    arena_rewind(&parent, mark)
    arena_trim(&parent)
    return 2 if parent.begin == null or parent.begin.next != null
    _ = arena_alloc(&parent, 16.usize())
    arena_reset(&parent)
    _ = arena_alloc(&parent, 8.usize())
    arena_free(&parent)
    return 0
