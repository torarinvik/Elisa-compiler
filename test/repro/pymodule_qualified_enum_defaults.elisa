# Same-leaf enum defaults must resolve against the enclosing module.
module Left:
    public:
        const enum Mode of i64:
            Low = 1
            High = 2

module Right:
    public:
        const enum Mode of i64:
            Low = 1
            High = 77

module Unique:
    public:
        const enum Tone of i64:
            Bright = 31
    def local(value: i64 = Tone.Bright) -> i64:
        return value

module Other:
    public:
        const enum Tone of i64:
            Bright = 88

module Outer:
    public:
        const enum Mode of i64:
            High = 91

module Outer::Inner:
    public:
        const enum Tone of i64:
            Bright = 45
        def nested(value: i64 = Tone.Bright) -> i64:
            return value
        def parent(value: i64 = Mode.High) -> i64:
            return value

module Outer::Shadow:
    public:
        const enum Mode of i64:
            High = 53
        def local(value: i64 = Mode.High) -> i64:
            return value

module LeftAlias:
    using Left as X
    def from_left(value: i64 = X::Mode.High) -> i64:
        return value

module RightAlias:
    using Right as X
    def from_right(value: i64 = X::Mode.High) -> i64:
        return value

module NestedAliasChain:
    module Origin:
        public:
            const enum Mode of i64:
                High = 42
    using Origin as First
    using First as Second
    def from_nested_alias_chain(value: i64 = Second::Mode.High) -> i64:
        return value

module NestedModuleWins:
    module Target:
        public:
            const enum Mode of i64:
                High = 82
    module AliasTarget:
        public:
            const enum Mode of i64:
                High = 93
    using AliasTarget as Target
    def nested_module_wins(value: i64 = Target::Mode.High) -> i64:
        return value

module NestedChainModuleWins:
    module First:
        public:
            const enum Mode of i64:
                High = 84
    module Other:
        public:
            const enum Mode of i64:
                High = 95
    using Other as First
    using First as Second
    def nested_chain_module_wins(value: i64 = Second::Mode.High) -> i64:
        return value

module X:
    public:
        const enum Mode of i64:
            High = 58

module NestedAliasSuffixFallback:
    module Real:
        public:
            const enum OtherMode of i64:
                Value = 1
    using Real as X
    def nested_alias_suffix_fallback(value: i64 = X::Mode.High) -> i64:
        return value

const enum Mode of i64:
    High = 2
    Large = 300

using Left as L

def left(value: i64 = Left::Mode.High) -> i64:
    return value

def right(value: i64 = Right::Mode.High) -> i64:
    return value

def top(value: i64 = Mode.High) -> i64:
    return value

def alias(value: i64 = L::Mode.High) -> i64:
    return value

def narrowed(value: u8 = Mode.Large.u8()) -> u8:
    return value

export pymodule qualified_enum_defaults:
    fn left
    fn right
    fn local = Unique::local
    fn top
    fn alias
    fn narrowed
    fn nested = Outer::Inner::nested
    fn parent = Outer::Inner::parent
    fn shadow = Outer::Shadow::local
    fn from_left = LeftAlias::from_left
    fn from_right = RightAlias::from_right
    fn from_nested_alias_chain = NestedAliasChain::from_nested_alias_chain
    fn nested_module_wins = NestedModuleWins::nested_module_wins
    fn nested_chain_module_wins = NestedChainModuleWins::nested_chain_module_wins
    fn nested_alias_suffix_fallback = NestedAliasSuffixFallback::nested_alias_suffix_fallback
