# Same-leaf enum defaults must resolve against the enclosing module.
module Left:
    public:
        const enum Mode of i64:
            Low = 1
            High = 2

module Right:
    public:
        const enum Mode of i64:
            Low = 1
            High = 77


def left(value: i64 = Left::Mode.High) -> i64:
    return value

def right(value: i64 = Right::Mode.High) -> i64:
    return value

export pymodule qualified_enum_defaults:
    fn left
    fn right
