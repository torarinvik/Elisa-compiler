struct Item:
    text: mutable u8&?

extern strlen(value: u8&?) -> usize

def allocate(size: usize) -> mutable void&?:
    return null

struct Hooks:
    allocate: (fn(usize) -> mutable void&?)?

def nonnull[T](value: mutable T&?) -> mutable T&:
    if value == null:
        return zeroed
    return value

def nonnull_item(value: mutable Item&?) -> mutable Item&:
    if value == null:
        return zeroed
    return value

def nonnull_u8(value: mutable u8&?) -> mutable u8&:
    if value == null:
        return zeroed
    return value

def field_from_optional(item: Item&?) -> mutable u8&?:
    return nonnull_item((item).cast[mutable Item&?]).text

def indexed_address(text: mutable u8&?, index: usize) -> mutable u8&:
    return &nonnull_u8(text)[index]

def literal_address() -> mutable u8&:
    return &("text")[0]

def optional_qualifier_cast(text: u8&?) -> usize:
    return strlen((text).cast[mutable u8&?])

def translated_length(text: u8&?) -> u64:
    length: mutable u64 = 0
    length <- strlen((text).cast[mutable u8&?]) + size_of[u8] * 1
    return length

def callback_identity(hooks: Hooks&) -> bool:
    return hooks.allocate == allocate

def optional_pointer_reinterpret(raw: mutable void&?) -> mutable Item&?:
    return raw.cast[mutable Item&?]

def invoke_nested_callback(hooks: Hooks&?) -> mutable void&?:
    assert nonnull((hooks).cast[mutable Hooks&?]).allocate != null
    return nonnull((hooks).cast[mutable Hooks&?]).allocate(1)

def allocate_item(hooks: Hooks&?) -> mutable Item&?:
    assert nonnull((hooks).cast[mutable Hooks&?]).allocate != null
    return (nonnull((hooks).cast[mutable Hooks&?]).allocate(1)).cast[mutable Item&?]

def allocate_item_local(hooks: Hooks&?) -> mutable Item&?:
    assert nonnull((hooks).cast[mutable Hooks&?]).allocate != null
    item: mutable Item&? = (nonnull((hooks).cast[mutable Hooks&?]).allocate(size_of[Item])).cast[mutable Item&?]
    return item

def main() -> i64:
    item: mutable Item = zeroed
    return 0 if field_from_optional(&item) == null else 1
