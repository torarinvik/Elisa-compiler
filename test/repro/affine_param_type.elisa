# `T!` as a PARAMETER type. `!` is not a binary operator, so `expression()` stops before it
# and the parameter loop found `!` where it expected `,` or `)`. A RETURN type `-> P!` works
# only INCIDENTALLY: parse_signature_clauses skips trailing signature tokens on the way to
# the body `:` and swallows the leftover `!`. The parameter list has no such skip.
#
# THIS EXACT FILE MADE stage1 SEGFAULT (exit 139) before the fix — the parse failure did not
# stop cleanly. It now compiles and answers 7, matching stage0.
#
# The body only DISCARDS or null-tests the affine value: `b.v` needs a proven non-null
# reference, which is a separate rule and not what this fixture pins.
struct P:
    v: i64

def discarded(b: P!) -> i64:
    _ = b
    return 1

def null_tested(b: P!, extra: i64) -> i64:
    if b != null:
        return extra
    return 0

def main() -> i64:
    return 7
