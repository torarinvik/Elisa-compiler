# `==` on two OPAQUE HANDLES is POINTER IDENTITY, not a content compare.
#
# LLVM-C handle typedefs (and any bare `extern TypeName`) are modeled as `cstr` because both
# lower to a bare `ptr` — but `cstr == cstr` lowers to ctx_streq, a CONTENT compare. Applied
# to handles, that read the two pointed-at objects as NUL-terminated strings: two distinct
# llvm::Function objects START with the same bytes, so they compared "equal". That skipped
# emit_module_core's library reconciliation ("same handle, nothing to repoint"), the runtime
# object's arena_alloc/arena_free/arena_realloc were emitted under LLVM's renamed
# `arena_alloc.2`-style symbols, and every program linked against a stage1-built runtime
# object failed with undefined _arena_alloc. Handles now carry CStr bits=1 — a MARKER, not a
# width — and `==`/`!=` route through the ref address-identity path.
#
# Here: two fopen() calls on the same path give DIFFERENT FILE* handles whose pointees are
# near-identical bytes. Content compare answers "equal" (matches=1 -> exit 31); pointer
# identity answers "different" (misses=1 -> exit 42). stage0: 42.
extern OpaqueFile

@link_name(fopen)
extern c_fopen(path: cstr, mode: cstr) -> OpaqueFile?

@link_name(fclose)
extern c_fclose(f: OpaqueFile) -> int

def main() -> i64:
    mode: mutable darray[u8] = []
    mode.push(114)
    mode.push(0)
    mode_c: cstr = (&mode[0]).cast[cstr] can Unsafe.PointerCast
    path: mutable darray[u8] = []
    path.push(47)
    path.push(101)
    path.push(116)
    path.push(99)
    path.push(47)
    path.push(104)
    path.push(111)
    path.push(115)
    path.push(116)
    path.push(115)
    path.push(0)
    path_c: cstr = (&path[0]).cast[cstr] can Unsafe.PointerCast

    handles: mutable darray[OpaqueFile] = []
    if c_fopen(path_c, mode_c) is first:
        handles.push(first)
    3 return if handles.count != 1

    matches: mutable i64 = 0
    misses: mutable i64 = 0
    for index in 0..<handles.count |handles, path_c, mode_c, matches, misses|:
        if c_fopen(path_c, mode_c) is again:
            if again == handles[index]:
                matches <- matches + 1
            else:
                misses <- misses + 1
            _ = c_fclose(again)
    return 41 + misses - matches * 10
