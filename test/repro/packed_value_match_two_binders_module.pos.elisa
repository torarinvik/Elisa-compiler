module Right:
    packed enum Message:
        A(x: i64)
        B(y: i64, z: i64)

def run(owner: Arena) -> i64:
    store: Right::Message.Store[Local] = Right::Message.Store(owner)
    result: mutable i64 = 0
    in store:
        n: Right::Message = new Right::Message.B(y: 20, z: 22)
        result <- match n:
            Right::Message.A(x): x
            Right::Message.B(y, z): y + z
    return result

def main() -> i64:
    region r(4096):
        return run(r)
