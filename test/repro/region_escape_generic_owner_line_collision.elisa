# A same-line sibling declaration must not make RegionBuffer's generic storage
# owner ambiguous. The projected push below stores a view in the exact `scratch`
# region supplied to RegionBuffer.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

#line 0 region-buffer-owner.elisa
struct RegionBuffer[@r]:
    views: mutable darray[sview @r] @r

#line 0 sibling-generic-owner.elisa
struct OtherGeneric[@s]:
    value: i64& @s

def main() -> i64 can[Abort.Panic, Memory.Allocate, Unsafe{PointerArithmetic,PointerCast,RawExtern,UncheckedIndex}]:
    region scratch:
        source: mutable darray[u8] @scratch = [65.u8()]
        buffer: RegionBuffer[scratch] = RegionBuffer{views: []}
        buffer.views.push(source.as_sview())
        return buffer.views.count.i64() - 1
