module X:
    module Nested:
        public:
            const enum Mode of i64:
                High = 91

module Scope:
    module X:
        module Nested:
            public:
                const enum Mode of i64:
                    Low = 92
    def nested_missing_variant(value: i64 = X::Nested::Mode.High) -> i64:
        return value

export pymodule nested_alias_missing_variant_scope:
    fn nested_missing_variant = Scope::nested_missing_variant
