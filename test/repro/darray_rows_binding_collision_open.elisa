# OPEN: adding this local spelling changes an included stdlib return diagnostic.
# The append_items counterpart compiles; ownership/type facts must not leak by name.
include "../../elisacore_std/elisacore_runtime.elisa"

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    rows: mutable darray[i64] = [1, 2]
    values: darray[i64] = [3, 4]
    rows <- rows.extend(values)
    return 1 if rows.count != 4 or rows[3] != 4
    rows <- rows.extend(rows)
    return 2 if rows.count != 8 or rows[7] != 4
    return 0
