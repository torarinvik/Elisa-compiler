def roundtrip(values: darray[set[i64]]) -> darray[set[i64]]:
    return values

def count(values: darray[set[i64]]) -> i64:
    return values.count.i64()

struct Bundle:
    values: darray[set[i64]]

def roundtrip_bundle(value: Bundle) -> Bundle:
    return value

def roundtrip_map(value: dict[i64,darray[set[i64]]]) -> dict[i64,darray[set[i64]]]:
    return value

export pymodule list_sets:
    fn roundtrip
    fn count
    fn roundtrip_bundle
    fn roundtrip_map
