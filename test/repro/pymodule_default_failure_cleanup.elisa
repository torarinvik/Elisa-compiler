type MaybeUserId = i64?

def bad_dict_before_optional(mapping: dict[i64, i64] = {}, value: i64? = 1234567890123456789) -> i64?:
    return value

def bad_set_before_optional(values: set[i64] = {}, value: i64? = 1234567890123456789) -> i64?:
    return value

def bad_set_range_before_aliased_optional(values: set[u8] = {}, value: MaybeUserId = 1234567890123456789) -> MaybeUserId:
    return value

export pymodule default_failure_cleanup:
    fn bad_dict_before_optional
    fn bad_set_before_optional
    fn bad_set_range_before_aliased_optional
