error Fault:
    BareTag(payload: i64)

module SetProvider:
    public:
        error Expected:
            Other(payload: i64)

# This unique bare variant deliberately collides with the imported error-set name.
# `error[Expected]` inside Imported must keep resolving to SetProvider::Expected.
error OtherTags:
    Expected(payload: i64)
    AliasExpected(payload: i64)

module Imported:
    public:
        def produce() -> i64 error[Expected]:
            raise Expected.Other(37)

        def bridge(callback: fn() -> i64 error[Expected]) -> i64 error[Expected]:
            return try callback()

module ForwardImported:
    public:
        def produce() -> i64 error[Expected]:
            raise Expected.Other(89)

        def bridge(callback: fn() -> i64 error[Expected]) -> i64 error[Expected]:
            return try callback()

module AliasShadow:
    public:
        type AliasExpected = SetProvider::Expected

        def produce() -> i64 error[AliasExpected]:
            raise SetProvider::Expected.Other(97)

        def bridge(callback: fn() -> i64 error[AliasExpected]) -> i64 error[AliasExpected]:
            return try callback()

module AliasFromImport:
    # This unqualified target resolves through the later root selective import.
    type ImportedExpected = Expected

    public:
        def produce() -> i64 error[ImportedExpected]:
            raise Expected.Other(107)

        def bridge(callback: fn() -> i64 error[ImportedExpected]) -> i64 error[ImportedExpected]:
            return try callback()

module AliasHolder:
    module Inner:
        type NestedExpected = SetProvider::Expected

        public:
            def produce() -> i64 error[NestedExpected]:
                raise SetProvider::Expected.Other(103)

            def bridge(callback: fn() -> i64 error[NestedExpected]) -> i64 error[NestedExpected]:
                return try callback()

module LocalShadow:
    # Local type lookup precedes selective imports. The unrelated Expected tag below
    # remains the unique bare variant after this ordinary type shadows the import.
    struct Expected:
        value: i64

    public:
        def produce() -> i64 error[Expected]:
            raise OtherTags.Expected(61)

        def bridge(callback: fn() -> i64 error[Expected]) -> i64 error[Expected]:
            return try callback()

module LocalAliasShadow:
    # An ordinary alias also wins over the global selective import and leaves the
    # unique Expected tag available to the bare-variant fallback.
    type Expected = i64

    public:
        def produce() -> i64 error[Expected]:
            raise OtherTags.Expected(67)

        def bridge(callback: fn() -> i64 error[Expected]) -> i64 error[Expected]:
            return try callback()

module WildcardImported:
    module SetProvider:
        public:
            error Expected:
                Other(payload: i64)

    using SetProvider

    public:
        def produce() -> i64 error[Expected]:
            raise Expected.Other(53)

        def bridge(callback: fn() -> i64 error[Expected]) -> i64 error[Expected]:
            return try callback()

# Core registers selective imports program-wide, so this later row is visible to the
# earlier Imported and ForwardImported signatures. LocalShadow.Expected still wins
# through lexical type lookup before this alias is considered.
from SetProvider import Expected

module FamilyOwner:
    public:
        error ParentFamily:
            ParentTag(payload: i64)

    module Child:
        public:
            def produce() -> i64 error[ParentFamily]:
                raise ParentFamily.ParentTag(71)

def produce_bare(fail: bool) -> i64 error[Fault{BareTag}]:
    raise Fault.BareTag(79) if fail
    return 7

def bridge_bare(callback: fn(bool) -> i64 error[BareTag], fail: bool) -> i64 error[Fault]:
    return try callback(fail)

def produce_qualified_alias(fail: bool) -> i64 error[AliasShadow::AliasExpected, Fault{BareTag}]:
    raise SetProvider::Expected.Other(109) if fail
    raise Fault.BareTag(110)

def main() -> i64:
    selected: i64 = catch Imported::bridge(Imported::produce):
        value: -1
        SetProvider::Expected.Other(payload): payload
    shadowed: i64 = catch LocalShadow::bridge(LocalShadow::produce):
        value: -4
        OtherTags.Expected(payload): payload
    alias_shadowed: i64 = catch LocalAliasShadow::bridge(LocalAliasShadow::produce):
        value: -9
        OtherTags.Expected(payload): payload
    wildcard: i64 = catch WildcardImported::bridge(WildcardImported::produce):
        value: -2
        WildcardImported::SetProvider::Expected.Other(payload): payload
    forward: i64 = catch ForwardImported::bridge(ForwardImported::produce):
        value: -6
        SetProvider::Expected.Other(payload): payload
    alias: i64 = catch AliasShadow::bridge(AliasShadow::produce):
        value: -7
        SetProvider::Expected.Other(payload): payload
    imported_alias: i64 = catch AliasFromImport::bridge(AliasFromImport::produce):
        value: -10
        SetProvider::Expected.Other(payload): payload
    qualified_alias: i64 = catch produce_qualified_alias(true):
        value: -11
        SetProvider::Expected.Other(payload): payload
    nested_alias: i64 = catch AliasHolder::Inner::bridge(AliasHolder::Inner::produce):
        value: -8
        SetProvider::Expected.Other(payload): payload
    ancestor: i64 = catch FamilyOwner::Child::produce():
        value: -5
        FamilyOwner::ParentFamily.ParentTag(payload): payload
    bare_callback: i64 = catch bridge_bare(produce_bare, true):
        value: -3
        Fault.BareTag(payload): payload
    return 1 if selected != 37
    return 4 if shadowed != 61
    return 9 if alias_shadowed != 67
    return 2 if wildcard != 53
    return 6 if forward != 89
    return 7 if alias != 97
    return 10 if imported_alias != 107
    return 11 if qualified_alias != 109
    return 8 if nested_alias != 103
    return 5 if ancestor != 71
    return 3 if bare_callback != 79
    return 0
