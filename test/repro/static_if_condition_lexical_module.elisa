# The static-if condition is declared in Outer, even though its function marker is
# later inspected while resolving declarations inside Outer::Inner. The inner
# FEATURE deliberately shadows the outer value.
module Outer:
    const FEATURE: bool = true
    static if FEATURE:
        module Inner:
            const FEATURE: bool = false

            static def compile_time_helper() -> i64:
                return 1

            def runtime_call() -> i64:
                return compile_time_helper()
