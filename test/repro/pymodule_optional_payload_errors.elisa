# Optional values are ordinary Python None-or-value payloads at the error boundary.
error OptionalIntPayloadError:
    Invalid(value: i64?)

error OptionalTextPayloadError:
    Invalid(value: sview?)

error OptionalCStrPayloadError:
    Invalid(value: cstr?)

error OptionalObjectPayloadError:
    Invalid(value: py::Object?)

error StructuredOptionalPayloadError:
    Invalid(code: i64, value: i64?, label: sview?, object: py::Object?, text: cstr?)

def fail_int(value: i64?) -> i64 error[OptionalIntPayloadError]:
    raise OptionalIntPayloadError.Invalid(value)

def fail_text(value: sview?) -> i64 error[OptionalTextPayloadError]:
    raise OptionalTextPayloadError.Invalid(value)

def fail_cstr(value: cstr?) -> i64 error[OptionalCStrPayloadError]:
    raise OptionalCStrPayloadError.Invalid(value)

def fail_object(value: py::Object?) -> i64 error[OptionalObjectPayloadError]:
    raise OptionalObjectPayloadError.Invalid(value)

def fail_struct(value: i64?, label: sview?, object: py::Object?, text: cstr?) -> i64 error[StructuredOptionalPayloadError]:
    raise StructuredOptionalPayloadError.Invalid(7, value, label, object, text)

export pymodule optional_payload_errors:
    fn fail_int
    fn fail_text
    fn fail_cstr
    fn fail_object
    fn fail_struct
