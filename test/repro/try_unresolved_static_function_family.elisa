# An unresolved static function remains a possible call target, but its only
# observed ErrorSet family must not be treated as certain at this call site.
error SourceFault:
    SourceOnly

error DestinationFault:
    DestinationOnly

static if UNKNOWN_TARGET:
    def origin() -> i64 error[SourceFault]:
        return 1

def caller() -> i64 error[DestinationFault]:
    return try origin()

def main() -> i64:
    return 0
