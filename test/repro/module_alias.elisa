# `using Mod as M` — the alias was PARSED and then thrown away: skip_using_alias consumed the
# name without recording it, so nothing downstream had heard of `M`. The resolver reported
# `undefined identifier 'M'` and the backend had no owner to look up.
#
# The alias is now recorded as a line-paired annotation, registered as a module symbol so it
# resolves, and mapped back to its target before the FnTable lookup. The un-aliased module is
# used here too, so rewriting the alias cannot break an ordinary qualified call.
module Helpers:
    public:
        def triple(n: i64) -> i64:
            return n * 3


module Other:
    public:
        def negate(n: i64) -> i64:
            return 0 - n


using Helpers as H
using Other

def main() -> i64:
    return H::triple(14) + Other::negate(0) + Helpers::triple(0)
