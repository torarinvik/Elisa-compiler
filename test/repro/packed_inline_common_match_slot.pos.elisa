# An INLINE common sits at row field 1, so the payload is at field 2: the value-slot match
# binder used to read field 1 (the common) and returned 11 + 11 instead of 11 + 101.
module Alpha:
    packed enum Result:
        common:
            @storage(inline)
            alpha: i64
        Ok(value: i64)

    def read(owner: Arena) -> i64:
        store: Alpha::Result.Store[Local] = Alpha::Result.Store(owner)
        in store:
            value: Alpha::Result = new Alpha::Result.Ok(alpha: 11, value: 101)
            result: i64 = match value:
                Alpha::Result.Ok(v): value.alpha + v
            return result
        return 0

def main() -> i64:
    region r(4096):
        return Alpha::read(r) - 100
