# A qualified error-returning call recovered with `else return` must lower in
# a caller's local initializer.

error RenderError:
    Rejected

struct RenderBatch:
    bytes: u8[131072]
    count: u32

enum RenderCommand:
    Clear

module WasmBrowser::Graphics:
    public:
        def append(batch: mutable RenderBatch&, command: RenderCommand) -> bool error[RenderError]:
            raise RenderError.Rejected if batch.count > 0
            return true

def render_frame(batch: mutable RenderBatch&) -> void:
    command: RenderCommand = RenderCommand.Clear
    accepted: bool = try WasmBrowser::Graphics::append(batch, command) else return

def main() -> i64:
    batch: mutable RenderBatch = zeroed
    render_frame(batch)
    return 42
