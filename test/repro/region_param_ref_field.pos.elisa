struct Store:
    bytes: mutable darray[u8]

struct P:
    names: mutable Store&
    n: i32

def add(p: P&, c: u8) -> void:
    p.names.bytes.push(c)

def main() -> i32:
    store: mutable Store = Store{bytes: []}
    p: P = P{names: &store, n: 1}
    add(&p, 7.u8())
    add(&p, 9.u8())
    q: P& = &p
    add(q, 5.u8())
    return store.bytes.count.i32() + store.bytes[1].i32() - 11
