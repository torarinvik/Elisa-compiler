# A module alias identifies the canonical target independently of how many
# fallible overload declarations share the callee name.
module Provider:
    public:
        error IntFault:
            BadInt

        error BoolFault:
            BadBool

        def load(value: i64) -> i64 error[IntFault]:
            raise IntFault.BadInt

        def load(value: bool) -> i64 error[BoolFault]:
            raise BoolFault.BadBool

using Provider as P

def discard_i64(value: i64):
    _ = P::load(value)

def discard_bool(value: bool):
    _ = P::load(value)

def main() -> i64:
    return 0
