def bad() -> i64:
    can Memory.Allocate, Abort.Panic:
        region outer(4096):
            outer_views: mutable darray[sview] @outer = []
            region inner(4096):
                inner_bytes: mutable darray[u8] @inner = [66.u8()]
                view: sview = inner_bytes.as_sview()
                outer_views <- [view for item in [0]]
                return outer_views.count
            return outer_views.count

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        return bad()
