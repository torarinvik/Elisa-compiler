module Types:
    type BorrowedPair = (view: sview, scalar: i64)
    type PointerPair = (pointer: mutable i64&, scalar: i64)
    type BorrowedArray = sview[2]

using Types as T

def invalid_view() -> i64:
    pair: Types::BorrowedPair = zeroed
    return 0

def invalid_ref() -> i64:
    pair: Types::PointerPair = zeroed
    return 0

def invalid_array() -> i64:
    views: Types::BorrowedArray = zeroed
    return 0

def invalid_imported_tuple() -> i64:
    imported_pair: T::BorrowedPair = zeroed
    return 0

def main() -> i64:
    return 42
