error RecoveryStoreFailure:
    Failed

enum Payload:
    View(sview)

def maybe() -> i64 error[RecoveryStoreFailure]:
    raise RecoveryStoreFailure.Failed
    return 1

def opaque() -> sview:
    return "static"

def bad() -> i64:
    can Memory.Allocate, Abort.Panic:
        region outer(4096):
            outer_bytes: mutable darray[u8] @outer = [65.u8()]
            retained: mutable sview @outer = outer_bytes.as_sview()
            region inner(4096):
                source: sview @inner = opaque()
                result: i64 = try maybe() else err:
                    return match Payload.View(source):
                        Payload.View(view):
                            retained <- view
                            0
                return result
            return retained.len

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        return bad()
