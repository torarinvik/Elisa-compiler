struct Diag:
    expected: sview

def pick(names: darray[sview]&) -> darray[sview]:
    can Memory.Allocate, Abort.Panic:
        out: mutable darray[sview] = []
        out.push(names[0])
        return out

def check(names: darray[sview]&, diags: mutable darray[Diag]&) -> void:
    can Memory.Allocate, Abort.Panic:
        buf: darray[u8] = [65, 66]
        local: mutable darray[sview] = []
        local.push(buf.as_sview())
        req: mutable darray[sview] = pick(names)
        for k in 0..<3 |req, diags|:
            diags.push(Diag{expected: req[0]})
            req <- pick(local)

def main() -> i32:
    return 0
