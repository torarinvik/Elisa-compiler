def reaches(origin: sview, target: sview, edge_from: darray[sview]&, edge_to: darray[sview]&) -> bool:
    can Memory.Allocate, Abort.Panic:
        frontier: mutable darray[sview] = [origin]
        found: mutable bool = false
        while frontier.count > 0 and not found |frontier, found, target, edge_from, edge_to|:
            current: sview = frontier[frontier.count - 1]
            frontier <- frontier.truncate(frontier.count - 1)
            found <- true if current == target
            frontier.push(edge_to[0])
        return found

def main() -> i32:
    return 0
