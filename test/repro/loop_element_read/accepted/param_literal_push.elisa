def reach(origin: sview, other: sview, edge_to: darray[sview]&) -> usize:
    can Memory.Allocate, Abort.Panic:
        frontier: mutable darray[sview] = ["a"]
        n: mutable usize = 0
        i: mutable usize = 0
        while i < 3 |i, n, frontier, origin, other, edge_to|:
            current: sview = frontier[0]
            n <- n + 1 if current == "x"
            frontier.push("b")
            i <- i + 1
        return n

def main() -> i32:
    return 0
