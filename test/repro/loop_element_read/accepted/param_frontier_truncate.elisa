def reach(origin: sview, edge_to: darray[sview]&) -> bool:
    can Memory.Allocate, Abort.Panic:
        frontier: mutable darray[sview] = [origin]
        found: mutable bool = false
        while frontier.count > 0 and not found |frontier, found, edge_to|:
            current: sview = frontier[frontier.count - 1]
            frontier <- frontier.truncate(frontier.count - 1)
            i: mutable usize = 0
            while i < edge_to.count |i, frontier, found, current, edge_to|:
                found <- true if edge_to[i] == current
                frontier.push(edge_to[i])
                i <- i + 1
        return found

def main() -> i32:
    return 0
