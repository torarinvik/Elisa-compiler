# A call that OMITS a trailing parameter carrying a DEFAULT.
#
# emit_direct_call has always filled the omitted tail from fns.param_defaults. Neither
# GENERIC path did, and the two failed differently:
#
#   positional  a call one argument SHORT of the instantiated signature. Under opaque
#               pointers that is undefined but verifier-VALID — nothing rejects it — so the
#               callee read the missing parameter out of whatever the ABI slot held.
#               `pick[i64](0)` answered 0 where stage0 answers 5.
#
#   named       `null return if source_index < 0` — a named call that skipped a defaulted
#               parameter declined outright, taking the whole module with it.
#
# A parameter with NO default still declines: that is a genuine arity error, and the
# non-generic path declines it the same way.
#
# stage0 answers 127.
def pick[T](marker: T, weight: i64 = 5) -> i64:
    _ = marker
    return weight


def three[T](marker: T, b: i64 = 2, c: i64 = 4) -> i64:
    _ = marker
    return b * 10 + c


def named[T](marker: T, b: i64 = 2, c: i64 = 4) -> i64:
    _ = marker
    return b * 10 + c


def plain(a: i64, weight: i64 = 5) -> i64:
    return a * 10 + weight


def main() -> i64:
    score: mutable i64 = 0

    # An EXPLICIT type argument, omitted tail — the wrong-answer case.
    score <- score + 1 if pick[i64](0) == 5

    # An INFERRED type argument takes a different route to the same emitter.
    score <- score + 2 if pick(0) == 5

    # TWO defaults, both omitted, then one supplied.
    score <- score + 4 if three[i64](0) == 24
    score <- score + 8 if three[i64](0, 1) == 14

    # A NAMED call that SKIPS a defaulted parameter — the decline case.
    score <- score + 16 if named[i64](0, c: 9) == 29

    # A UFCS receiver, omitted tail: parameter 0 is the receiver, so the default tail
    # starts one past the explicit argument count.
    x: i64 = 0
    score <- score + 32 if x.pick() == 5

    # The NON-generic path, which was always right — pinned so the fill cannot break it.
    score <- score + 64 if plain(1) == 15

    return score
