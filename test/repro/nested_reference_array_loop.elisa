include "../../elisacore_std/elisacore_runtime.elisa"

struct Inner:
    values: darray[i64]
struct Outer:
    inner: Inner&

def sum(outer: Outer&) -> i64:
    total: mutable i64 = 0
    for value in outer.inner.values:
        total <- total + value
    return total

def main() -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    inner: Inner = Inner{values: [3, 7]}
    outer: Outer = Outer{inner: inner}
    return 0 if sum(outer) == 10 else 1
