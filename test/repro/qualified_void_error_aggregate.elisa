# A qualified void error call with a mutable aggregate reference must use the
# error ABI's out slot and preserve its module owner in Stage1.

error ServiceError:
    Rejected

struct Payload:
    value: u32

module WasmBrowser::HostWire:
    public:
        def validate(payload: mutable Payload&) -> void error[ServiceError]:
            raise ServiceError.Rejected if payload.value == 1

def wrapper() -> void error[ServiceError]:
    payload: mutable Payload = Payload{value: 0}
    try WasmBrowser::HostWire::validate(payload)

def main() -> void:
    pass
