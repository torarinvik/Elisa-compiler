# Stage0 treats a mutable aggregate local as an address-backed mutable borrow at a
# by-value call boundary. Stage1 must reject the same invalid conversion.
struct Grade:
    value: i64

def build_one(g: Grade) -> bool:
    return g.value == 0

def deal(g: mutable Grade&) -> bool:
    candidate: mutable Grade = g
    return build_one(candidate)

def main() -> i64:
    grade: mutable Grade = Grade{value: 0}
    return 0 if deal(grade) else 1
