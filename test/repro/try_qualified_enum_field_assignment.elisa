module Codec:
    public:
        const enum Level of u8:
            Low
            High

        error DecodeError:
            Invalid

        struct Record:
            level: mutable Level

    private:
        def decode(raw: i64) -> Level error[DecodeError]:
            raise DecodeError.Invalid if raw < 0
            return Level.High if raw == 1 else Level.Low

    public:
        def update(record: mutable Record&, raw: i64) -> Level error[DecodeError]:
            record.level <- try decode(raw)
            record.level

def main() -> i64:
    record: mutable Codec::Record = Codec::Record{level: Codec::Level.Low}
    success: Codec::Level = try Codec::update(&record, 1) else Codec::Level.Low
    failure: Codec::Level = try Codec::update(&record, -1) else Codec::Level.Low
    return 42 if success == Codec::Level.High and failure == Codec::Level.Low and record.level == Codec::Level.High else 1
