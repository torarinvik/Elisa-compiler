# Short module paths inside an enclosing module resolve to that module's own child.
# Repeated child names must not let stage1 use the first module's constants in both.
module PhysicsRuntime:
    public:
        const module Status:
            WRONG_THREAD: i32 = -3
            CAPACITY: i32 = -4
            INVALID_HANDLE: i32 = -5
            STALE_WORLD: i32 = -7

        def status_checksum() -> i64:
            return Status::WRONG_THREAD.i64() + Status::CAPACITY.i64() + Status::INVALID_HANDLE.i64() + Status::STALE_WORLD.i64()

module AudioRuntime:
    public:
        const module Status:
            WRONG_THREAD: i32 = -3
            CAPACITY: i32 = -6
            INVALID_HANDLE: i32 = -7
            STALE_WORLD: i32 = -9

        def status_checksum() -> i64:
            return Status::WRONG_THREAD.i64() + Status::CAPACITY.i64() + Status::INVALID_HANDLE.i64() + Status::STALE_WORLD.i64()

def main() -> i64:
    return 0 if PhysicsRuntime::status_checksum() == -19 and AudioRuntime::status_checksum() == -25 else 1
