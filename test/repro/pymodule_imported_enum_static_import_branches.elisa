# PyModule must remove statically inactive enum imports before resolving defaults.
module PrivateSelective:
    private:
        const enum SelectiveMode of i64:
            High = 11

module PublicSelective:
    public:
        const enum SelectiveMode of i64:
            High = 22

module PrivateWildcard:
    private:
        const enum WildcardMode of i64:
            High = 31

module PublicWildcard:
    public:
        const enum WildcardMode of i64:
            High = 42

static if false:
    from PrivateSelective import SelectiveMode
static else:
    from PublicSelective import SelectiveMode

static if false:
    using PrivateWildcard
static else:
    using PublicWildcard

# If an inactive private import wins, these distinct root values expose the fallback.
const enum SelectiveMode of i64:
    High = 91

const enum WildcardMode of i64:
    High = 92

def selected_selective(value: i64 = SelectiveMode.High) -> i64:
    return value

def selected_wildcard(value: i64 = WildcardMode.High) -> i64:
    return value

export pymodule pymodule_imported_enum_static_import_branches:
    fn selected_selective
    fn selected_wildcard
