# Indexing a darray through a REFERENCE must address the container's elements,
# not perform C pointer arithmetic over the reference value. The raw-GEP form
# strides over the darray HEADER type and returns the header address itself, so
# reading through it yields the data-pointer bytes instead of element 0.

def fill_and_first(storage: mutable darray[u8]&) -> u8 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    storage.push(109)
    storage.push(97)
    storage.push(105)
    storage.push(110)
    first: mutable u8& = &storage[0]
    return first[0]

def main() -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
    storage: mutable darray[u8] = []
    inner: u8 = fill_and_first(storage)
    outer: mutable u8& = &storage[0]
    return 0 if inner == 109 and outer[0] == 109 and storage.count == 4 else 1
