def good() -> i64:
    can Memory.Allocate, Abort.Panic:
        region outer(4096):
            outer_bytes: mutable darray[u8] @outer = [65.u8()]
            retained: mutable sview @outer = outer_bytes.as_sview()
            region inner(4096):
                views: mutable darray[sview] @inner = []
                views.push(outer_bytes.as_sview())
                for item in views:
                    retained <- item
                return retained.len
            return retained.len

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        return good()
