def good(fallback: sview) -> sview:
    can Memory.Allocate, Abort.Panic:
        region inner(4096):
            inner_bytes: mutable darray[u8] @inner = [66.u8()]
            result: sview = match 1:
                1:
                    return fallback
                    inner_bytes.as_sview()
                _:
                    fallback
            return result

def good_literal_if(fallback: sview) -> sview:
    can Memory.Allocate, Abort.Panic:
        region inner(4096):
            inner_bytes: mutable darray[u8] @inner = [66.u8()]
            result: sview = match 1:
                1:
                    if true:
                        return fallback
                    inner_bytes.as_sview()
                _:
                    fallback
            return result

def good_panic_dead_tail(fallback: sview) -> sview:
    can Memory.Allocate, Abort.Panic:
        region inner(4096):
            inner_bytes: mutable darray[u8] @inner = [66.u8()]
            result: sview = match 1:
                1:
                    panic("dead tail")
                    inner_bytes.as_sview()
                _:
                    fallback
            return result

def main() -> i64:
    return 0
