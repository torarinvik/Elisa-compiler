# A same-module use remains eligible for EWR, while the use from App is private.
module Api:
    public:
        error Fault:
            Failed

        error Other:
            Rejected

        def wrap[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
            return try callback()

        def local_wrapper() -> i64 error[Api::Other]:
            return Api::wrap(Api::hidden)

    private:
        def hidden() -> i64 error[Api::Fault]:
            raise Api::Fault.Failed

module App:
    public:
        error Expected:
            Rejected

        def wrapper() -> i64 error[App::Expected]:
            return Api::wrap(Api::hidden)

def main() -> i64:
    return 0
