include "../../elisacore_std/elisacore_runtime.elisa"

# `sview(literal, 0, -1)` is the std's NUL-TERMINATED sentinel: a NEGATIVE length means "walk
# until the 0 byte", not "walk 2^64 bytes". Bytes.push_str (src/semantic/semantic.elisa)
# builds every diagnostic message this way, so a stage1-compiled reporter died with SIGBUS on
# its first message while the stage0-built one was fine.
#
# The bounded case is here too: fixing the sentinel must not turn an ordinary view into a
# NUL-terminated one.
def count_sentinel(literal: u8&) -> i64 can[Abort.Panic, Memory.Allocate]:
    n: mutable i64 = 0
    for _byte in sview(literal, 0, -1) |n|:
        n <- n + 1
    return n


def count_bounded(literal: u8&) -> i64 can[Abort.Panic, Memory.Allocate]:
    n: mutable i64 = 0
    for _byte in sview(literal, 0, 3) |n|:
        n <- n + 1
    return n


def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return count_sentinel("hello") * 10 + count_bounded("hello")
