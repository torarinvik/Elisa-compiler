error FirstError:
    Empty
    # Excluded by the restricted set below; it must not widen that set's ABI payload.
    Other(values: i64[4])

error SecondError:
    Missing(value: u32)
    Other

extern external_probe(code: i64) -> i64 error[FirstError{Empty}, SecondError]

# Reverse the external signature's family order to exercise canonical tag ordering too.
def foo(code: i64) -> i64 error[SecondError, FirstError{Empty}]:
    if code == 0:
        return 99
    if code == 1:
        raise FirstError.Empty
    if code == 2:
        raise SecondError.Missing(41)
    raise SecondError.Other

def use_expression(code: i64) -> i64:
    return catch foo(code):
        value: value
        FirstError.Empty: 1
        SecondError.Missing(payload): payload.i64()
        SecondError.Other: 4

def use_statement(code: i64) -> i64:
    catch foo(code):
        value:
            return value
        FirstError.Empty:
            return 1
        SecondError.Missing(payload):
            return payload.i64()
        SecondError.Other:
            return 4
    return 0

def main() -> i64:
    if use_expression(0) != 99:
        return 1
    if use_expression(1) != 1:
        return 2
    if use_expression(2) != 41:
        return 3
    if use_expression(3) != 4:
        return 4
    if use_statement(0) != 99:
        return 5
    if use_statement(1) != 1:
        return 6
    if use_statement(2) != 41:
        return 7
    if use_statement(3) != 4:
        return 8
    return 0
