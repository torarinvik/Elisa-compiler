# Every QUERY form whose iterable is an INLINE CONTAINER LITERAL.
#
# A literal has no name for the darray locator and no type of its own for the expression
# typer — the literal emitter takes its shape from the EXPECTED type, and a query head
# supplies none. The `for` header had grown a ladder for exactly this; the folds, the
# min/max extrema and the list comprehension had not, so each declined and took the whole
# function with it. The bool quantifiers had a literal path already, but it fell back to
# CStr for an untyped element — written for the self-host `valid_suffix` shape, whose
# elements are STRING literals — so `all x in [1, 2, 3]` typed `1` as a string and declined
# too, while the same quantifier over a NAMED darray worked.
#
# stage0 answers 255; each bit is one query form.
def main() -> i64:
    score: mutable i64 = 0
    # folds
    score <- score + 1 if (sum x in [1, 2, 3, 4]) == 10
    score <- score + 2 if (count x in [1, 2, 3, 4] where x > 2) == 2
    score <- score + 4 if (product x in [1, 2, 3]) == 6
    # bool quantifiers — `all` and `any` are different quantifiers, so both polarities
    score <- score + 8 if all x in [1, 2, 3] where x > 0
    score <- score + 16 if any x in [1, 0, 3] where x == 0
    # a `where` that fails everywhere: `all` must be FALSE, not vacuously true
    score <- score + 32 if not (all x in [1, 0, 3] where x > 0)
    # extrema — optional-valued, so an absent result is a different answer from a zero one
    smallest: i64? = min x in [4, 2, 9]
    largest: i64? = max x in [4, 2, 9]
    if smallest is low:
        score <- score + 64 if low == 2
    if largest is high:
        score <- score + 128 if high == 9
    return score
