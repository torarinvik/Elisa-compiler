# Once Values::Mode wins the imported-name lookup, its missing High variant must not
# fall through to the unrelated root Mode.High value.
module Values:
    public:
        const enum Mode of i64:
            Available = 41

const enum Mode of i64:
    High = 97

using Values::Mode

def imported_missing_variant(value: i64 = Mode.High) -> i64:
    return value

export pymodule imported_enum_missing_variant_root_present:
    fn imported_missing_variant
