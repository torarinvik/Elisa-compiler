struct Pair[state Within | Outside]:
    low: i64
    high: i64
    derive state:
        Within when self.low < self.high and self.low >= 0
        Outside when not (self.low < self.high and self.low >= 0)

def main() -> i32:
    pair: Pair[Within] = Pair[Within]{low: 1, high: 1 + 2}
    outside: Pair[Outside] = Pair[Outside]{high: 3, low: 5}
    return 1 if pair.high != 3 or outside.low != 5
    return 0
