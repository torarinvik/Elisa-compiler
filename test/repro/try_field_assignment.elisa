error ReadFailure:
    Failed

struct Record:
    value: mutable i64

def read_value(fail: bool) -> i64 error[ReadFailure]:
    raise ReadFailure.Failed if fail
    return 41

def update(record: mutable Record&, fail: bool) -> i64 error[ReadFailure]:
    record.value <- try read_value(fail)
    return record.value

def main() -> i64:
    record: mutable Record = Record{value: 0}
    good: i64 = catch update(&record, false):
        value: value
        error failure: -10
    bad: i64 = catch update(&record, true):
        value: value
        error failure: record.value
    return good + bad + record.value
