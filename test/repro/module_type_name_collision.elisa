module RenderGraph:
    private:
        struct Resource:
            descriptor: ResourceDescriptor

        struct ResourceDescriptor:
            id: i64

    public:
        struct Graph:
            private:
                resources: mutable Resource[4]
                resource_count: mutable usize

        def Graph() -> Graph:
            Graph{resources: zeroed, resource_count: 0}

        def seed() -> Graph:
            graph: mutable Graph = Graph()
            graph.resources[0] <- Resource{descriptor: ResourceDescriptor{id: 41}}
            graph.resource_count <- 1
            graph

        def resource_id(graph: Graph&, index: usize) -> i64:
            graph.resources[index].descriptor.id

module Schedule:
    public:
        enum Resource:
            Transforms
            Bodies

def main() -> i64:
    graph: RenderGraph::Graph = RenderGraph::seed()
    value: i64 = RenderGraph::resource_id(graph, 0)
    return 42 if value == 41 else 1
