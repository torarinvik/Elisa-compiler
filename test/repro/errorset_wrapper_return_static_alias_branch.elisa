# Only the active branch's module alias may contribute an ErrorSet family. The
# inactive alias has the same spelling and would make raw alias lookup ambiguous.
module ActiveProvider:
    public:
        error ActiveFault:
            Active

        def origin() -> i64 error[ActiveProvider::ActiveFault{Active}]:
            raise ActiveProvider::ActiveFault.Active

        def wrap[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
            return try callback()

module InactiveProvider:
    public:
        error InactiveFault:
            Inactive

        def origin() -> i64 error[InactiveProvider::InactiveFault{Inactive}]:
            raise InactiveProvider::InactiveFault.Inactive

        def wrap[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
            return try callback()

const USE_INACTIVE_PROVIDER: bool = false

static if USE_INACTIVE_PROVIDER:
    using InactiveProvider as Selected
static else:
    using ActiveProvider as Selected

module Consumer:
    public:
        error WrongFault:
            Wrong

        def mismatched_static_alias() -> i64 error[Consumer::WrongFault{Wrong}]:
            return Selected::wrap(Selected::origin())

def main() -> i64:
    return 0
