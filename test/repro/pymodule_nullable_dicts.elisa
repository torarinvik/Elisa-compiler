# Probe nullable dictionary values at the Python boundary.
def optional_objects(values: dict[cstr, py::Object?]) -> dict[cstr, py::Object?]:
    return values

def optional_text(values: dict[cstr, cstr?]) -> dict[cstr, cstr?]:
    return values

def optional_view(values: dict[cstr, sview?]) -> dict[cstr, sview?]:
    return values

export pymodule nullable_dicts:
    fn optional_objects
    fn optional_text
    fn optional_view
