# Cyclic local aliases must not recurse forever while resolving a Try destination.
# Since neither alias resolves to a type, the unique bare variant remains available.
error Fault:
    Expected
    Other

module Local:
    type Expected = CycleB
    type CycleB = Expected

    public:
        def source() -> i64 error[Fault{Other}]:
            return 1

        def destination() -> i64 error[Expected]:
            return try source()

def main() -> i64:
    return 0
