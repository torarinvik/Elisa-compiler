# Style-guide proposal: currently rejected by both compilers.
# Stage0: match expression arms are incompatible: null and LLVMValueRef?
# Stage1: validate declines at the match control expression.
# Link with LLVM when this becomes accepted; main checks null, i1, and i64.
extern LLVMValueRef
extern LLVMContextRef
extern LLVMTypeRef
extern LLVMContextCreate() -> LLVMContextRef
extern LLVMContextDispose(ctx: LLVMContextRef) -> void
extern LLVMTypeOf(value: LLVMValueRef) -> LLVMTypeRef
extern LLVMInt1TypeInContext(ctx: LLVMContextRef) -> LLVMTypeRef
extern LLVMInt64TypeInContext(ctx: LLVMContextRef) -> LLVMTypeRef
extern LLVMConstInt(kind: LLVMTypeRef, value: u64, sign_extend: i32) -> LLVMValueRef

def validate(condition_value: LLVMValueRef?, ctx: LLVMContextRef) -> LLVMValueRef?:
    validated_condition: LLVMValueRef? =
        match condition_value:
            emitted_condition if LLVMTypeOf(emitted_condition) != LLVMInt1TypeInContext(ctx):
                null
            _:
                condition_value
    return validated_condition

def main() -> i64:
    ctx: LLVMContextRef = LLVMContextCreate()
    absent: LLVMValueRef? = validate(null, ctx)
    return 1 if absent != null
    value: LLVMValueRef = LLVMConstInt(LLVMInt1TypeInContext(ctx), 1, 0)
    valid: LLVMValueRef? = validate(value, ctx)
    if valid is held:
        return 2 if held != value
    else:
        return 3
    wrong: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(ctx), 42, 0)
    invalid: LLVMValueRef? = validate(wrong, ctx)
    return 4 if invalid != null
    LLVMContextDispose(ctx)
    return 0
