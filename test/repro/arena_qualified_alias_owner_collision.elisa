# A lexical module alias shadows a same-spelled module. The reset summary must
# follow the alias target, never the unrelated module with the same qualifier.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"

module Quiet:
    public:
        def touch(owner: mutable Arena&) -> void:
            pass

module Other:
    public:
        def touch(owner: mutable Arena&) -> void:
            arena_reset(owner)

using Other as Quiet

def main() -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    arena: mutable Arena = zeroed
    values: mutable darray[i64] @arena = [65]
    Quiet::touch(&arena)
    return values[0]
