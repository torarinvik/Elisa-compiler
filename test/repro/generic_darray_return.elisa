def make[T](value: T) -> darray[T]:
    result: mutable darray[T] = []
    result.push(value)
    return result

def wrap[T](value: T) -> darray[darray[T]]:
    inner: mutable darray[T] = []
    inner.push(value)
    result: mutable darray[darray[T]] = []
    result.push(inner)
    return result

def append_one[T](out: mutable darray[T]&, value: T) -> void:
    out.push(value)

struct Packet[T]:
    values: darray[T]

def packet[T](value: T) -> Packet[T]:
    values: mutable darray[T] = []
    values.push(value)
    return Packet[T]{values: values}

def main() -> i64:
    region r(65536):
        one: mutable darray[i64] = make(42)
        append_one(one, 6)
        two: darray[darray[i64]] = wrap(7)
        three: Packet[i64] = packet(8)
        return one[0] + one[1] + two[0][0] + three.values[0]
    return 0
