struct IsolationRow:
    value: i64

def first_row(rows: darray[IsolationRow]&) -> IsolationRow can[Abort.Panic]:
    return rows[0]

def last_row(rows: darray[i64]&) -> i64 can[Abort.Panic]:
    return rows[0]

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    rows: mutable darray[i64] = [1, 2]
    return 0
