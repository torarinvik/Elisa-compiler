# Bare calls made visible by wildcard and selective imports still target the provider module.
module Provider:
    def via_wildcard() -> void:
        pass

    def via_selective() -> void:
        pass

using Provider
from Provider import via_selective

def run() -> void:
    static:
        via_wildcard()
        via_selective()

def main() -> i64:
    run()
    return 0
