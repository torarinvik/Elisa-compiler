# Native error status and an ordinary bound enum have different payload layouts.
error Failure:
    Number(i64)
    Pair(i32, i64)

def source(pair: bool) -> i64 error[Failure]:
    raise Failure.Pair(17i32, 9001) if pair
    raise Failure.Number(123456)

def inspect(pair: bool) -> i64:
    catch source(pair):
        value:
            return value
        error failure:
            match failure:
                Failure.Number(number):
                    return number
                Failure.Pair(small, large):
                    return small.i64() + large

def main() -> i64:
    return 0 if inspect(false) == 123456 and inspect(true) == 9018 else 1
