include "../../elisacore_std/elisacore_runtime.elisa"

# Two bugs, one fixture.
#
# 1. Indexing a `view[T]` had NO arm in the backend's Index emitter, so `v[0]` declined the
#    whole enclosing function — which is why even an ANNOTATED `ys: view[i64] = xs[1:3]`
#    never worked; slice CONSTRUCTION was implemented and slice READING was not.
# 2. An UNANNOTATED `ws = xs[2:4]` was typed SView regardless of receiver, so it declined
#    too (and before that, miscompiled to a byte-GEP of the darray header).
#
# The answer ENCODES which reads happened, so a wrong element, a lost start offset or a
# wrong stride fails rather than coincidentally passing: 20 + 40*2 + 30 + 4 = 134.
def elem(v: view[i64], at: i64) -> i64:
    return v[at]

def main() -> i64:
    xs: mutable darray[i64] = []
    xs <- xs.push(10)
    xs <- xs.push(20)
    xs <- xs.push(30)
    xs <- xs.push(40)
    # ANNOTATED. Offset slice: ys[0] is xs[1], so a dropped offset answers 10, not 20.
    ys: view[i64] = xs[1:4]
    # UNANNOTATED — a bare `=` folds to Stmt.Assign, a different defining site from the
    # `name: T =` VarDecl form, and each needed the receiver-typed view separately.
    ws = xs[2:4]
    # A narrower element type: a wrong stride here reads the wrong byte, and mixing widths
    # in one function is what exposed the missing element conversion.
    bs: mutable darray[u8] = []
    bs <- bs.push(3)
    bs <- bs.push(4)
    zs: view[u8] = bs[1:2]
    return elem(ys, 0) + ys[2] * 2 + ws[0] + zs[0].i64()
