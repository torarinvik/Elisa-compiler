module Right:
    enum Message:
        Some(value: i64)
using Right as RootRight
module Outer:
    module Right:
        enum Message:
            Empty
            Some(left: i64, right: i64)
    module Worker:
        def answer() -> i64:
            message: RootRight::Message = RootRight::Message.Some(42)
            match message:
                RootRight::Message.Some(value):
                    return value
            return -1
def main() -> i64:
    return Outer::Worker::answer()
