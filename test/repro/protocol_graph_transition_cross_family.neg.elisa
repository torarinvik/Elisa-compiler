module North:
    affine struct Lease[state Open | Closed]:
        value: u64
        transitions:
            Open -> Closed

    def cross_family(lease: Lease[Open]) -> South::Lease[Closed]:
        return transition[Closed](move lease)

module South:
    affine struct Lease[state Open | Closed]:
        value: u64
        transitions:
            Open -> Closed

def main() -> i32:
    return 0
