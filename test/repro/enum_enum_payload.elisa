# An enum variant whose payload is ANOTHER PAYLOAD-CARRYING ENUM.
#
# The struct-payload fix admitted TypeKind.Struct as a sole payload field; a payload enum is
# the other aggregate that can sit there. Its size is 8 + N*8, where N is the inner blob's
# word count -- the `{i32 tag, [N x i64] blob}` layout with the tag padded out by the i64
# array's alignment. Measured against stage0's `-emit llvm`:
#
#   Inner{X(i64), Y}        -> outer [2 x i64]
#   Inner{X(i64, i64), Y}   -> outer [3 x i64]
#   Inner payloadless       -> outer [1 x i64]   (an ordinary i32-backed enum; already worked)
#
# The extent pass is ITERATED for this: the outer enum cannot be sized until the inner one
# is, and declaration order does not guarantee the inner was visited first. Both orders are
# exercised here -- `Early` is declared before its user, `Late` after -- so a single-pass
# implementation gets one of the two wrong.
#
# stage0 answers 158.
enum Early:
    Some(v: i64)
    None


enum Holder:
    Wraps(inner: Early)
    Defers(inner: Late)
    Bare


enum Late:
    Pair(a: i64, b: i64)
    Empty


def score_of(held: Holder) -> i64:
    match held:
        Holder.Wraps(inner):
            match inner:
                Early.Some(v):
                    return v
                Early.None:
                    return 2
        Holder.Defers(inner):
            match inner:
                Late.Pair(a, b):
                    return a * 10 + b
                Late.Empty:
                    return 3
        Holder.Bare:
            return 4
    return 0


def main() -> i64:
    # 7 + 2 + 56 + 3 + 4 = 72 through a PARAMETER (the position that was dropped at the
    # declare pass), and a LOCAL adds 86 -- the two failed separately.
    total: mutable i64 = score_of(Holder.Wraps(Early.Some(7))) + score_of(Holder.Wraps(Early.None))
    total <- total + score_of(Holder.Defers(Late.Pair(5, 6))) + score_of(Holder.Defers(Late.Empty))
    total <- total + score_of(Holder.Bare)
    local: Holder = Holder.Defers(Late.Pair(8, 6))
    match local:
        Holder.Wraps(inner):
            total <- total + 1000
        Holder.Defers(inner):
            match inner:
                Late.Pair(a, b):
                    total <- total + a * 10 + b
                Late.Empty:
                    total <- total + 2000
        Holder.Bare:
            total <- total + 3000
    return total
