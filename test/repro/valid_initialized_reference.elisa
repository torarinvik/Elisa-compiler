struct ReferenceHolder:
    pointer: mutable i64&

struct NullableHolder:
    pointer: mutable i64&?

global mutable backing_value: i64 = 0
global mutable global_nullable: mutable i64&? = zeroed

def get_target() -> mutable i64&:
    return &backing_value

def main() -> i64:
    reference: mutable i64& = get_target()
    reference <- 42
    holder: ReferenceHolder = ReferenceHolder{pointer: get_target()}
    holder_pointer: mutable i64& = holder.pointer
    holder_pointer <- 42
    nullable_holder: mutable NullableHolder = zeroed
    return backing_value
