struct Counter[state Small | Large]:
    value: i64
    derive state:
        Small when self.value < 0
        Large when self.value >= 0

#line 0 derived-typestate-ensures-owner.elisa
def advance(value: mutable Counter[Small]&, extra: i64) -> void ensures value => Large:
#line 0 derived-typestate-ensures-owner.elisa
    value.value <- 1
