# Same-spelled nominal types in different modules are not receiver matches. Core
# selects the private generic and rejects it for both direct and cached try calls.
module NamedProvider:
    public:
        error GenericFault:
            Generic

        struct Widget:
            value: i64

        def inspect(value: Widget) -> i64:
            return value.value

    private:
        def inspect[T](value: T) -> i64 error[NamedProvider::GenericFault]:
            return 0

module Consumer:
    struct Widget:
        value: i64

    public:
        def direct(value: Widget) -> i64 error[NamedProvider::GenericFault]:
            return try NamedProvider::inspect(value)

        def cached(value: Widget) -> i64 error[NamedProvider::GenericFault]:
            payload = NamedProvider::inspect(value)
            return try payload

def main() -> i64:
    return 0
