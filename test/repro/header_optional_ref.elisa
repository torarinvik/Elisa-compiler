# A niche optional reference has the C representation of a nullable pointer.
# Keep this in the header-parity corpus: the stage1 header emitter must not reject
# the field or publish Elisa's internal `{tag, payload}` representation.

struct OptionalBytes layout(c):
    size: i32
    data: u8&?

export type OptionalBytes as PublicOptionalBytes

def main() -> i64:
    return 0
