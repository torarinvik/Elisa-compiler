struct Point:
    x: i64
    y: i64

struct Config:
    retries: i64 = 3
    enabled: bool = true
    ratio: f64 = 0.5
    label: cstr = "guest"
    text: sview = "hello"
    tags: darray[i64] = []
    numbers: darray[i64] = [1, 2]
    bytes: darray[u8] = [1, 2, 255]
    mapping: dict[i64, i64] = {1: 2}
    unique: set[i64] = {3, 4}
    view_values: view[i64] = [5, 6]
    nested: darray[darray[i64]] = [[7], [8, 9]]
    origin: Point = Point{x: 10, y: 20}

def roundtrip(config: Config) -> Config:
    return config

def point_roundtrip(point: Point = Point{x: 10, y: 20}) -> Point:
    return point

export pymodule struct_defaults:
    fn roundtrip
    fn point_roundtrip
