# A value-if is a valid postfix numeric-cast receiver. The receiver's type must be
# inferred from its non-literal branch before the cast supplies the target type.
def conditional_rate(bpm: f64) -> i64:
    return (60000000.0 / (bpm if bpm > 0.0 else 120.0)).i64()

export fn conditional_rate_export(bpm: f64) -> i64 = conditional_rate
