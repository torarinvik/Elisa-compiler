# The query FOLDS, which the backend modelled only for `count`. Each is a different
# accumulator over the same loop shape, so a wrong one is a wrong ANSWER, not a decline:
#   sum      seed 0, accumulate +elem      (12 here, and 14 with no `where` at all)
#   product  seed 1, accumulate *elem      (60)
#   min/max  seed ABSENT, an OPTIONAL result — absent over an empty iterable
# stage0 returns 31; every bit is a separate fold.
def main() -> i64:
    xs: darray[i64] = [3, 1, 4, 1, 5]
    empty: darray[i64] = []
    filtered_sum: i64 = sum x in xs where x > 1
    whole_sum: i64 = sum x in xs
    filtered_product: i64 = product x in xs where x > 1
    smallest: i64? = min x in xs where x > 1
    largest: i64? = max x in xs where x > 1
    none_at_all: i64? = min x in empty where x > 1
    score: mutable i64 = 0
    score <- score + 1 if filtered_sum == 12
    score <- score + 2 if whole_sum == 14
    score <- score + 4 if filtered_product == 60
    if smallest is low:
        score <- score + 8 if low == 3
    if largest is high:
        score <- score + 16 if high == 5
    # An empty iterable has no minimum: the optional must be ABSENT, not a seeded 0.
    if none_at_all is spurious:
        score <- score + 32 + spurious
    return score
