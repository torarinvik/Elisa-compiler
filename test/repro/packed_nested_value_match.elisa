@packed_profile(build_heavy)
packed enum Node:
    Ident(name: sview)
    Number(value: i64)
    Call(child: Node)

def run(owner: Arena) -> i64:
    store: Node.Store[Local] = Node.Store(owner)
    result: mutable i64 = 0
    in store:
        named: Node = new Node.Ident(name: "method")
        discard: Node = new Node.Ident(name: "_")
        number: Node = new Node.Number(value: 7)
        a: Node = new Node.Call(child: named)
        b: Node = new Node.Call(child: discard)
        c: Node = new Node.Call(child: number)
        name: sview = match a:
            Node.Call(Node.Ident(text)): text
            _: ""
        literal_hit: i64 = match b:
            Node.Call(Node.Ident("_")): 11
            _: 0
        literal_miss: i64 = match a:
            Node.Call(Node.Ident("_")): 1000
            _: 13
        tag_miss: i64 = match c:
            Node.Call(Node.Ident(text)): 1000
            _: 18
        result <- literal_hit + literal_miss + tag_miss if name == "method" else 1
    return result

def main() -> i64:
    region r(4096):
        return run(r)
