# UFCS overload dispatch ranks the first argument as the receiver. A concrete
# receiver overload wins over a generic receiver even when the generic's later
# parameter types differ. Try propagation must use that same selected overload.
module First:
    public:
        error Fault:
            Bad

module Second:
    public:
        error Fault:
            Other

module API:
    def choose[T](receiver: T, payload: bool) -> i64 error[First::Fault]:
        return 1

    def choose(receiver: i64, payload: i64) -> i64 error[Second::Fault]:
        return 2

    def call(receiver: i64) -> i64 error[Second::Fault]:
        # This literal has unknown argument-type evidence in Stage1. Core still picks
        # by the first receiver, then validates the remaining argument.
        return try choose(receiver, 2)

    def choose_all[T](receiver: T, payload: T) -> i64 error[First::Fault]:
        return 1

    def choose_all(receiver: i64, payload: i64) -> i64 error[Second::Fault]:
        return 2

    def call_all(receiver: i64) -> i64 error[Second::Fault]:
        return try choose_all(receiver, 2)

def main() -> i64:
    return 0
