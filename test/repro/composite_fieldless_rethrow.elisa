error First:
    Bad
error Second:
    Bad

def choose(second: bool) -> i64 error[First, Second]:
    raise Second.Bad if second
    raise First.Bad

def relay(second: bool) -> i64 error[Second, First]:
    catch choose(second):
        value:
            return value
        error failure:
            raise failure

def classify(second: bool) -> i64:
    catch relay(second):
        value:
            return value
        error failure:
            return 22 if failure == Second.Bad
            return 11 if failure == First.Bad
            return 99

def main() -> i64:
    return 1 if classify(false) != 11 or classify(true) != 22
    catch scalar_relay():
        value:
            return 2
        Second.Bad:
            return 3
        First.Bad:
            return 0

def scalar_source() -> i64 error[First]:
    raise First.Bad

def scalar_relay() -> i64 error[Second, First]:
    catch scalar_source():
        value:
            return value
        error failure:
            raise failure
