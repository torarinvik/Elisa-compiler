include "../../elisacore_std/elisacore_runtime.elisa"

global mutable Keyboard: array[i8, 512] = zeroed
global mutable LastScan: i32 = zeroed
global mutable LastASCII: i32 = zeroed

extern c_memset(dest: mutable void&?, val: i32, n: u64) -> mutable void&?

def clear_keys() -> void can[Abort.Panic, Global, Unsafe.PointerCast, Unsafe.BufferReinterpret, Unsafe.StaleRef]:
    can Abort.Panic, Global, Unsafe.PointerCast, Unsafe.BufferReinterpret, Unsafe.StaleRef:
        LastScan <- 0
        LastASCII <- 0
        trusted Unsafe.StaleRef:
            c_memset(((&(Keyboard)[0])).cast[mutable void&?], 0, size_of[i32] * 512)

def main() -> i64:
    clear_keys()
    return 0
