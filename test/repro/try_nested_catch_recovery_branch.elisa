# Both Catch success arms leave the function. Only their error handlers can
# supply the F-valued result that the final Try must reject for an E return.
error E:
    Bad
error F:
    Other
def load_e(flag: bool) -> i64 error[E]:
    raise E.Bad if flag
    return 1
def load_f() -> i64 error[F]:
    return 2
def bad(flag: bool) -> i64 error[E]:
    recovered = catch catch load_e(flag):
        success:
            return 1
        error problem:
            load_f()
    :
        success:
            return 1
        error problem:
            load_f()
    value = recovered if flag else raise E.Bad
    return try value
