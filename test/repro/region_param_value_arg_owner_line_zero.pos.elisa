# Same-line region callees have distinct parameter rows, and a sibling region binder
# must not make the unbound caller appear to own @r.
#line 0 region-put.elisa
def put[@r](value: i64& @r) -> void:
    pass

#line 0 region-sibling.elisa
def sibling[@r](value: i64& @r) -> void:
    pass

# A local region row from a preceding function with the same logical line must not
# make the call below appear bound.
#line 0 unrelated-local-region.elisa
def unrelated_local_region() -> void:
    region r(128)

#line 0 unbound-caller.elisa
def bad(value: i64) -> void:
    region r(128):
        pass
    put(value)

#line 0 unrelated-region-binder.elisa
def unrelated[@r](other: i64& @r) -> void:
    pass
