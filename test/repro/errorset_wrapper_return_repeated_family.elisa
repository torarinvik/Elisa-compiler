module Provider:
    public:
        error Fault:
            Available
            Busy

        def split_tags() -> i64 error[Provider::Fault.Available, Provider::Fault.Busy]:
            raise Provider::Fault.Available

        def get_all() -> i64 error[Provider::Fault]:
            raise Provider::Fault.Available

        def wrap[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
            return try callback()

def repeated_family_to_full() -> i64 error[Provider::Fault]:
    return Provider::wrap(Provider::split_tags)

def repeated_family_missing_busy() -> i64 error[Provider::Fault{Available}]:
    return Provider::wrap(Provider::split_tags)

def full_source_to_repeated_destination_union() -> i64 error[Provider::Fault{Available}, Provider::Fault{Busy}]:
    return Provider::wrap(Provider::get_all)

def main() -> i64:
    return 0
