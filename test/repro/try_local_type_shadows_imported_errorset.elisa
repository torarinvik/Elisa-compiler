# A nearer non-error type shadows an imported error set for a bare error item.
# The bare name then resolves to the unique error variant with that name.
error Fault:
    Expected
    AliasExpected
    QualifiedExpectedAlias

module SetProvider:
    public:
        error Expected:
            SetTag

module AliasProvider:
    public:
        error AliasExpected:
            AliasSetTag

from SetProvider import Expected
from AliasProvider import AliasExpected

module Imported:
    public:
        struct Expected:
            value: i64

        error Other:
            Trouble

        def origin() -> i64 error[Expected]:
            return 1

        def matching_destination() -> i64 error[Fault]:
            return try origin()

        def wrong_destination() -> i64 error[Other]:
            return try origin()

module AliasImported:
    type AliasExpected = i64

    public:
        error Other:
            Trouble

        def origin() -> i64 error[AliasExpected]:
            return 1

        def matching_destination() -> i64 error[Fault]:
            return try origin()

        def wrong_destination() -> i64 error[Other]:
            return try origin()

module QualifiedAliasProvider:
    public:
        error QualifiedExpectedAlias:
            QualifiedTag

module QualifiedAliasImported:
    type QualifiedExpectedBase = QualifiedAliasProvider::QualifiedExpectedAlias
    type QualifiedExpectedAlias = QualifiedExpectedBase

    public:
        error Other:
            Trouble

        def origin() -> i64 error[QualifiedExpectedAlias]:
            return 1

        def matching_destination() -> i64 error[QualifiedAliasProvider::QualifiedExpectedAlias]:
            return try origin()

        def wrong_destination() -> i64 error[Other]:
            return try origin()

def main() -> i64:
    return 0
