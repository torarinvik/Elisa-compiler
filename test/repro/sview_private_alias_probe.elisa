module SViewRuntime:
    struct StringView:
        private:
            data: u8&
            len: i64

    def make(data: u8&, len: i64) -> sview:
        return StringView{data: data, len: len}

using SViewRuntime

def main() -> i64:
    byte: u8 = 65.u8()
    view: sview = make(&byte, 1)
    return view.len
