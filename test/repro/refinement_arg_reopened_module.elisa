law Positive(self: i64) = self > 0

module Target:
    def plain(value: i64) -> bool:
        return value > 0

extend Target:
    def accept(value: i64 is Positive) -> bool:
        return value > 0

extend Target:
    def forward(value: i64) -> bool:
        return Target::accept(value)

def main() -> i64:
    return 0 if Target::forward(1) else 1
