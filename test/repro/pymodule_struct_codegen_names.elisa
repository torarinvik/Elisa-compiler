struct CodegenNames:
    arena: dict[i64, i64]
    result: dict[i64, i64]
    field_value: view[i64]
    field_seq: darray[i64]
    field_view: view[i64]
    payload: set[i64]
    items: darray[i64]
    count: i64
    value: i64
    object: py::Object
    key: sview
    index: i64
    error_type: i64
    error_value: i64
    error_traceback: i64
    owned: i64
    result_index: i64
    nested_index: i64
    list: view[i64]
    view: view[i64]

def roundtrip(value: CodegenNames) -> CodegenNames:
    return value

export pymodule struct_codegen_names:
    fn roundtrip
