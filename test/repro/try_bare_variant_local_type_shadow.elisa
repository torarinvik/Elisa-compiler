# A nearer nominal type shadows an imported error set before Core falls back to the
# unique bare variant. Without the local struct, the imported family still wins.
error TagOwner:
    Expected

module SetProvider:
    public:
        error Expected:
            Other

        def load() -> i64 error[SetProvider::Expected]:
            return 1

from SetProvider import Expected

module Imported:
    public:
        def imported_family_wins() -> i64 error[Expected]:
            return try SetProvider::load()

module LocalShadow:
    struct Expected:
        value: i64

    public:
        def variant_source() -> i64 error[TagOwner{Expected}]:
            return 1

        def unique_variant_fallback() -> i64 error[Expected]:
            return try variant_source()

        def variant_does_not_become_imported_family() -> i64 error[SetProvider::Expected]:
            return try variant_source()

def main() -> i64:
    return 0
