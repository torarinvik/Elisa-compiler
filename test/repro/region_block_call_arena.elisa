def helper(out: mutable darray[i64]&) -> void:
    for i in 0..<200 |out|:
        out.push(i)

def main() -> i64:
    outer: mutable darray[i64] = []
    region scratch(4096):
        helper(outer)
    total: mutable i64 = 0
    for v in outer |total|:
        total <- total + v
    return total % 251
