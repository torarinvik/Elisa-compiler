struct Point:
    x: i64
    label: sview

error PointPayloadError:
    Bad(point: Point)

def fail_point(point: Point) -> i64 error[PointPayloadError]:
    raise PointPayloadError.Bad(point)

error StructuredPointPayloadError:
    Bad(code: i64, point: Point)

def fail_structured(code: i64, point: Point) -> i64 error[StructuredPointPayloadError]:
    raise StructuredPointPayloadError.Bad(code, point)

export pymodule error_payload_named_struct:
    fn fail_point
    fn fail_structured
