module Own:
    struct Box[T]:
        padding: i32
        item: mutable T
    struct Pair[A, B]:
        first: mutable A
        second: mutable B

type CallerItem = i64

def main() -> i64:
    box: mutable Own::Box[CallerItem] = zeroed
    pair: mutable Own::Pair[CallerItem, i32] = zeroed
    box.item <- 42
    pair.first <- 11
    pair.second <- 31
    return box.item if pair.first + pair.second == 42 else 1
