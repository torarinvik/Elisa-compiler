module Own:
    type Padding = i32
    type Item = sview
    struct Box[T]:
        padding: Padding
        item: mutable T
    struct Pair[A, B]:
        first: mutable A
        second: mutable B

type Padding = i64
type Item = i64

def main() -> i64:
    box: mutable Own::Box[Item] = zeroed
    pair: mutable Own::Pair[Item, i32] = zeroed
    box.item <- 42
    pair.first <- 11
    pair.second <- 31
    return box.item if pair.first + pair.second == 42 else 1
