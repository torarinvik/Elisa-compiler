# A fulfills-only callee may write other; an unconstrained callee may write all.
# Both calls must retain frame diagnostics after annotation compaction.
struct FrameFilterRejectedState:
    value: mutable i64
    other: mutable i64

law FrameFilterOther(self: FrameFilterRejectedState&) changes self.other

def frame_filter_wrong_field(state: mutable FrameFilterRejectedState&) fulfills state is FrameFilterOther:
    state.other <- 1

def frame_filter_unconstrained(state: mutable FrameFilterRejectedState&):
    state.other <- 1

def frame_filter_rejected(state: mutable FrameFilterRejectedState&) changes state.value:
    frame_filter_wrong_field(state)
    frame_filter_unconstrained(state)

def main() -> i64:
    return 0
