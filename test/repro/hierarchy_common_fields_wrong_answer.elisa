# `common:` fields reached through a HIERARCHY type. stage0 lowers this and prints
# 42; stage1 REFUSES it at compile time.
#
# It is a runtime PANIC, not a wrong answer: an earlier note here said stage1
# "returned 2 where stage0 returns 0", but 2 is this runtime's abort code and a
# version that prints the value shows stage1 never reaches the print. The refusal
# in codegen_expr_index_fields is what turns that abort into a diagnostic.
#
# Two necessary pieces are in place and were not sufficient: the row stride is
# now measured from the hierarchy ROOT (every refinement's row lives in the
# root's store, so one stride governs them all), and common NAMES are propagated
# to variant-less roots (register_packed_common_names reads them off a variant's
# field list, so a root registers none of its own). The read itself still lands
# outside the row.
#
# elisa-ui works around this by carrying geometry in a dense side array indexed
# by a node id, which is a better layout for the two layout passes anyway.
enum Widget:
    common:
        w: f32
    pass

enum Control is Widget:
    Label(text: sview)

enum Button is Control:
    Push(label: sview)

def make() -> Widget:
    return Button.Push(w: 42.0, label: "go")

def width_of(x: Widget) -> f32:
    return x.w

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        node: Widget = make()
        return width_of(node).i64() - 42
