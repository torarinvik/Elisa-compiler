# A relative selective import inside a nested module resolves from that lexical
# module. A root provider with the same leaf name must not mask the imported target.
module Installer:
    module Child:
        module Provider:
            public:
                error Fault:
                    Bad

                def load() -> i64 error[Fault]:
                    return 1

        from Provider import load

        def discard_imported():
            _ = load()

module Provider:
    public:
        def load() -> i64:
            return 0

def main() -> i64:
    return 0
