module Left:
    public:
        const enum Mode of i64:
            High = 2

module LeftAlias:
    using Left as X
    def nested_root_target(value: i64 = X::Mode.High) -> i64:
        return value

export pymodule nested_alias_root_target_rejection:
    fn nested_root_target = LeftAlias::nested_root_target
