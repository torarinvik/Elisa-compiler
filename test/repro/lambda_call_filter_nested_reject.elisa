# Skipping a declaration scan for the outer call must not skip the inner check.
const LAMBDA_FILTER_INPUT: i64 = 41

def lambda_filter_apply(body: fn(i64) -> i64, value: i64) -> i64:
    return body(value)

def lambda_filter_outer(value: i64) -> i64:
    return value

def main() -> i64:
    return lambda_filter_outer(lambda_filter_apply(fn(n) => "wrong", LAMBDA_FILTER_INPUT))
