# Probe nullable scalar list elements.
def optional_signed(values: darray[i64?]) -> darray[i64?]:
    return values

def optional_unsigned(values: darray[u8?]) -> darray[u8?]:
    return values

def optional_bool(values: darray[bool?]) -> darray[bool?]:
    return values

def optional_float(values: darray[f32?]) -> darray[f32?]:
    return values

export pymodule nullable_scalar_lists:
    fn optional_signed
    fn optional_unsigned
    fn optional_bool
    fn optional_float
