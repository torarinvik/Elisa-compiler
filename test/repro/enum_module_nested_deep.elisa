module Root:
    module Outer:
        module Wrong:
            enum Message:
                Some(left: i64, right: i64)
                Empty
        module Right:
            enum Message:
                Empty
                Some(value: i64)
using Root::Outer::Right as R

def score(message: R::Message) -> i64:
    match message:
        R::Message.Some(value):
            return value
        R::Message.Empty:
            return 0
    return -1

def main() -> i64:
    direct: Root::Outer::Right::Message = Root::Outer::Right::Message.Some(21)
    aliased: R::Message = R::Message.Some(21)
    empty: R::Message = R::Message.Empty
    return score(direct) + score(aliased) + score(empty)
